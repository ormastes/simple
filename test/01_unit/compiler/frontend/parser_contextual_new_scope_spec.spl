# @req REQ-CONTEXTUAL-NEW-INDEX-LOCAL
# Tests first, explicit continuation round 2. All execution UNRUN.
use std.spec.*
use compiler.core.parser.{parser_has_errors, parse_module}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn cni2_hir(source: text, name: text) -> HirFunction:
    val parsed = parse_and_build_module(source, "contextual_new_scope.spl")
    expect(parser_has_errors()).to_equal(false)
    var lowering = HirLowering.with_filename("contextual_new_scope.spl")
    lowering.use_explicit_semantic_policy()
    lowering.declare_module_symbols(parsed)
    val result = lowering.lower_function(parsed.functions[name])
    expect(lowering.errors.len()).to_equal(0)
    expect(result.body.has).to_equal(true)
    result

fn cni2_index_owner(expr: HirExpr) -> i64:
    match expr.kind:
        case HirExprKind.Index(base, _):
            match base.kind:
                case HirExprKind.NamedVar(symbol, name):
                    expect(name).to_equal("new")
                    return symbol.id
                case HirExprKind.Var(symbol): return symbol.id
                case _: fail("index receiver did not resolve to a real value binding")
        case _: fail("expected canonical HIR index")
    -1

fn cni2_mir(source: text, name: text) -> text:
    val parsed = parse_and_build_module(source, "contextual_new_mir.spl")
    expect(parser_has_errors()).to_equal(false)
    var lowering = HirLowering.with_filename("contextual_new_mir.spl")
    lowering.use_explicit_semantic_policy()
    val hir = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    expect(mir_lowering.errors.len()).to_equal(0)
    for function in mir.functions.values():
        if function.name == name or function.name.ends_with("." + name):
            return serialize_mir_function(function)
    panic("missing MIR function " + name)

fn cni2_same_parse_shape(contextual: Expr, ordinary: Expr):
    match (contextual.kind, ordinary.kind):
        case (ExprKind.Binary(left_op, left_a, left_b), ExprKind.Binary(right_op, right_a, right_b)):
            expect(left_op).to_equal(right_op)
            cni2_same_parse_shape(left_a, right_a)
            cni2_same_parse_shape(left_b, right_b)
        case (ExprKind.Unary(left_op, left), ExprKind.Unary(right_op, right)):
            expect(left_op).to_equal(right_op)
            cni2_same_parse_shape(left, right)
        case (ExprKind.Index(left_base, left_key), ExprKind.Index(right_base, right_key)):
            cni2_same_parse_shape(left_base, right_base)
            cni2_same_parse_shape(left_key, right_key)
        case (ExprKind.Ident(left), ExprKind.Ident(right)):
            expect(left).to_equal("new")
            expect(right).to_equal("items")
        case (ExprKind.IntLit(left), ExprKind.IntLit(right)):
            expect(left).to_equal(right)
        case _: fail("contextual and ordinary identifier parses differ structurally")

fn cni2_parsed_tail(source: text, name: text) -> Expr:
    val parsed = parse_and_build_module(source, "contextual_new_counterpart.spl")
    expect(parser_has_errors()).to_equal(false)
    val function = parsed.functions[name]
    match function.body.stmts[function.body.stmts.len() - 1].kind:
        case StmtKind.Expr(expr): expr
        case _: panic("missing parser expression counterpart")

describe "contextual new resolves before ordinary expression precedence":
    it "preserves supported parameter spelling in the production parser":
        step("Inspect the actual bound new[index] expression through the flat bridge")
        val parsed = parse_and_build_module("fn pick(new: [i64], index: i64) -> i64:\n    new[index]\n", "contextual_new_parser.spl")
        expect(parser_has_errors()).to_equal(false)
        val function = parsed.functions["pick"]
        expect(function.params[0].name).to_equal("new")
        match function.body.stmts[0].kind:
            case StmtKind.Expr(expr):
                match expr.kind:
                    case ExprKind.Index(base, _):
                        match base.kind:
                            case ExprKind.Ident(name): expect(name).to_equal("new")
                            case _: fail("lost contextual receiver")
                    case _: fail("bound index still entered allocation parsing")
            case _: fail("missing parsed expression")

    it "resolves the receiver to the actual function parameter symbol":
        step("Lower the original bound spelling using the real function scope")
        val function = cni2_hir("fn pick(new: [i64], index: i64) -> i64:\n    new[index]\n", "pick")
        expect(cni2_index_owner(function.body.value)).to_equal(function.params[0].symbol.id)

    it "matches ordinary identifier precedence including explicit grouping":
        step("Compare actual production ASTs from distinct contextual and ordinary sources")
        val contextual = ["2 * new[0] + 3", "-new[0] + 3", "2 * (new[0] + 3)"]
        val ordinary = ["2 * items[0] + 3", "-items[0] + 3", "2 * (items[0] + 3)"]
        for index in 0..contextual.len():
            val left = cni2_parsed_tail("fn candidate(new: [i64]):\n    " + contextual[index] + "\n", "candidate")
            val right = cni2_parsed_tail("fn ordinary(items: [i64]):\n    " + ordinary[index] + "\n", "ordinary")
            cni2_same_parse_shape(left, right)

    it "keeps multiplication outside the new index and addition outside multiplication":
        step("Reject the withdrawn HIR rewrite counterexample through real lowering")
        val function = cni2_hir("fn weighted(new: [i64]) -> i64:\n    2 * new[0] + 3\n", "weighted")
        match function.body.value.kind:
            case HirExprKind.Binary(HirBinOp.Add, left, _):
                match left.kind:
                    case HirExprKind.Binary(HirBinOp.Mul, _, indexed):
                        expect(cni2_index_owner(indexed)).to_equal(function.params[0].symbol.id)
                    case _: fail("multiplication moved inside allocation operand")
            case _: fail("addition was captured by new allocation")

    it "keeps unary minus separate from following addition":
        step("Require the same precedence as -items[0] + 3")
        val function = cni2_hir("fn negative(new: [i64]) -> i64:\n    -new[0] + 3\n", "negative")
        match function.body.value.kind:
            case HirExprKind.Binary(HirBinOp.Add, left, _):
                match left.kind:
                    case HirExprKind.Unary(HirUnaryOp.Neg, indexed):
                        expect(cni2_index_owner(indexed)).to_equal(function.params[0].symbol.id)
                    case _: fail("unary operand did not remain the bound index")
            case _: fail("addition moved into unary operand")

    it "retains explicit grouping around the index and addition":
        step("Distinguish 2 * (new[0] + 3) from the unparenthesized counterexample")
        val function = cni2_hir("fn grouped(new: [i64]) -> i64:\n    2 * (new[0] + 3)\n", "grouped")
        match function.body.value.kind:
            case HirExprKind.Binary(HirBinOp.Mul, _, right):
                match right.kind:
                    case HirExprKind.Binary(HirBinOp.Add, indexed, _):
                        expect(cni2_index_owner(indexed)).to_equal(function.params[0].symbol.id)
                    case _: fail("explicit grouped addition was reassociated")
            case _: fail("grouped multiplication changed")

    it "binds a supported local only after its initializer":
        step("Require the local tail index to resolve to the real Let symbol")
        val function = cni2_hir("fn local() -> i64:\n    val new: [i64] = new[37]\n    new[0]\n", "local")
        match function.body.stmts[0].kind:
            case HirStmtKind.Let(symbol, _, init):
                match init.kind:
                    case HirExprKind.ArrayLit(elements, _): expect(elements.len()).to_equal(1)
                    case _: fail("local became visible inside its own unbound initializer")
                expect(cni2_index_owner(function.body.value)).to_equal(symbol.id)
            case _: fail("local binding was not lowered")

    it "preserves unbound adjacent and spaced array allocation controls":
        step("Lower both accepted allocation spellings without a value named new")
        for source in ["fn alloc() -> [i64]:\n    new[1]\n", "fn alloc() -> [i64]:\n    new [1]\n"]:
            val function = cni2_hir(source, "alloc")
            match function.body.value.kind:
                case HirExprKind.ArrayLit(elements, _):
                    expect(elements.len()).to_equal(1)
                    match elements[0].kind:
                        case HirExprKind.IntLit(value, _): expect(value).to_equal(1)
                        case _: fail("allocation element changed")
                case _: fail("unbound allocation was reclassified as indexing")

    it "reaches the real MIR array accessor exactly once":
        step("Lower the original parameter spelling through production parser HIR and MIR")
        val mir = cni2_mir("fn pick(new: [i64], index: i64) -> i64:\n    new[index]\n", "pick")
        expect(mir).to_contain("rt_array_get")
        expect(mir.split("rt_array_get").len() - 1).to_equal(1)

    it "restores an outer binding after a nested block shadows it":
        step("Inspect both real SymbolIds after lowering a do block")
        val source = "fn scopes(new: [i64]) -> i64:\n" +
            "    val inner = do:\n        val new: [i64] = [37]\n        new[0]\n" +
            "    new[0]\n"
        val function = cni2_hir(source, "scopes")
        expect(cni2_index_owner(function.body.value)).to_equal(function.params[0].symbol.id)
        match function.body.stmts[0].kind:
            case HirStmtKind.Let(_, _, init):
                match init.kind:
                    case HirExprKind.Block(block):
                        match block.stmts[0].kind:
                            case HirStmtKind.Let(inner, _, _):
                                expect(cni2_index_owner(block.value)).to_equal(inner.id)
                                expect(inner.id == function.params[0].symbol.id).to_equal(false)
                            case _: fail("missing inner lexical value binding")
                    case _: fail("missing nested lexical block")
            case _: fail("missing block-valued local")

    it "does not leak a block-local or another function parameter":
        step("Leave lexical frames before parsing following unbound allocations")
        val source = "fn bound(new: [i64]) -> i64:\n    new[0]\n" +
            "fn alloc() -> [i64]:\n    if true:\n        val new: [i64] = [7]\n    new[1]\n"
        val function = cni2_hir(source, "alloc")
        match function.body.value.kind:
            case HirExprKind.ArrayLit(elements, _): expect(elements.len()).to_equal(1)
            case _: fail("a closed lexical frame leaked its contextual binding")

    it "keeps explicit allocator syntax allocation even with a new parameter":
        step("Explicit new() must not be captured by the contextual bracket gate")
        val function = cni2_hir("fn alloc(new: [i64]) -> [i64]:\n    new() [1]\n", "alloc")
        match function.body.value.kind:
            case HirExprKind.ArrayLit(elements, _): expect(elements.len()).to_equal(1)
            case _: fail("explicit allocation was reclassified by a value binding")

    it "uses the supported parenthesized arrow parameter scope":
        step("Inspect the arrow body while preserving the existing accepted keyword binder")
        val parsed = parse_and_build_module("fn arrow():\n    (new) => new[0]\n", "contextual_new_arrow.spl")
        expect(parser_has_errors()).to_equal(false)
        match parsed.functions["arrow"].body.stmts[0].kind:
            case StmtKind.Expr(expr):
                match expr.kind:
                    case ExprKind.Lambda(_, body):
                        match body.kind:
                            case ExprKind.Index(_, _): ()
                            case _: fail("arrow parameter did not bind the index receiver")
                    case _: fail("supported arrow form stopped being a lambda")
            case _: fail("missing arrow expression")

    it "diagnoses a malformed bound index and resets before the next module":
        step("Use a genuinely malformed counterpart then a separate unbound allocation")
        parse_module("fn bad(new: [i64]):\n    new[0\n", "contextual_new_bad.spl")
        expect(parser_has_errors()).to_equal(true)
        val function = cni2_hir("fn alloc() -> [i64]:\n    new[1]\n", "alloc")
        match function.body.value.kind:
            case HirExprKind.ArrayLit(elements, _): expect(elements.len()).to_equal(1)
            case _: fail("failed parse leaked a lexical binding into the next module")

# Final cycle3 supplemental production-parser transition regressions.
fn cni3_expect_index(expr: Expr):
    match expr.kind:
        case ExprKind.Index(base, _):
            match base.kind:
                case ExprKind.Ident(name): expect(name).to_equal("new")
                case _: fail("index receiver lost the actual contextual name")
        case _: fail("proven value did not enter ordinary index parsing")

fn cni3_expect_allocation(expr: Expr):
    match expr.kind:
        case ExprKind.New(kind, _): expect(kind).to_equal(0)
        case _: fail("unknown binding authority changed the prior allocation path")

fn cni3_statement_expr(statement: Stmt) -> Expr:
    match statement.kind:
        case StmtKind.Expr(expr): expr
        case _: panic("expected actual expression statement")

fn cni3_function(source: text, name: text) -> ParserFunction:
    val parsed = parse_and_build_module(source, "contextual_new_transitions.spl")
    expect(parser_has_errors()).to_equal(false)
    parsed.functions[name]

describe "contextual new lexical transition prevention":
    it "keeps scalar var initialization outside its new binding":
        step("Inspect the actual Var initializer and following index expression")
        val function = cni3_function("fn mutable():\n    var new: [i64] = new[29]\n    new[0]\n", "mutable")
        match function.body.stmts[0].kind:
            case StmtKind.Var(name, _, init):
                expect(name).to_equal("new")
                cni3_expect_allocation(init ?? panic("missing initialized var operand"))
            case _: fail("missing parsed mutable binding")
        cni3_expect_index(cni3_statement_expr(function.body.stmts[1]))

    it "admits the supported typed var without an explicit initializer":
        step("Require the real synthesized-default declaration to bind its following reference")
        val function = cni3_function("fn declared():\n    var new: [i64]\n    new[0]\n", "declared")
        match function.body.stmts[0].kind:
            case StmtKind.Var(name, _, _): expect(name).to_equal("new")
            case _: fail("typed mutable declaration stopped being a Var")
        cni3_expect_index(cni3_statement_expr(function.body.stmts[1]))

    it "binds a scalar for name after the iterable and restores it after the loop":
        step("Inspect allocation iterable, bound body index, and unknown allocation after exit")
        val function = cni3_function("fn loops():\n    for new in new[[1]]:\n        new[0]\n    new[1]\n", "loops")
        match function.body.stmts[0].kind:
            case StmtKind.For(name, iterable, body):
                expect(name).to_equal("new")
                cni3_expect_allocation(iterable)
                cni3_expect_index(cni3_statement_expr(body.stmts[0]))
            case _: fail("missing actual for binding")
        cni3_expect_allocation(cni3_statement_expr(function.body.stmts[1]))

    it "restores authority after custom fn and backslash lambda block bodies":
        step("Create a lambda-local value and inspect the outer unbound allocation")
        for prefix in ["fn():\n", "\\:\n"]:
            val source = "fn closure():\n    val callback = " + prefix +
                "        val new: [i64] = [17]\n        new[0]\n    new[1]\n"
            val function = cni3_function(source, "closure")
            match function.body.stmts[0].kind:
                case StmtKind.Val(_, _, init):
                    match init.kind:
                        case ExprKind.Lambda(_, body):
                            match body.kind:
                                case ExprKind.Block(block):
                                    cni3_expect_index(cni3_statement_expr(block.stmts[1]))
                                case _: fail("custom block lambda lost its actual block")
                        case _: fail("custom lambda syntax was not preserved")
                case _: fail("missing callback declaration")
            cni3_expect_allocation(cni3_statement_expr(function.body.stmts[1]))

    it "preserves captures across every custom expression-lambda frame":
        step("Inspect captured parameter indexing inside and after fn/backslash/pipe/zero-arrow lambdas")
        for prefix in ["fn(): ", "\\: ", "| | ", "() => "]:
            val source = "fn capture(new: [i64]):\n    val callback = " + prefix + "new[0]\n    new[0]\n"
            val function = cni3_function(source, "capture")
            match function.body.stmts[0].kind:
                case StmtKind.Val(_, _, init):
                    match init.kind:
                        case ExprKind.Lambda(_, body): cni3_expect_index(body)
                        case _: fail("missing expression lambda")
                case _: fail("missing capture callback")
            cni3_expect_index(cni3_statement_expr(function.body.stmts[1]))

    it "binds existing multi-parameter arrow names before the body":
        step("Preserve the already accepted (new, index) arrow binder form")
        val function = cni3_function("fn arrow():\n    (new, index) => new[index]\n", "arrow")
        match cni3_statement_expr(function.body.stmts[0]).kind:
            case ExprKind.Lambda(params, body):
                expect(params.len()).to_equal(2)
                expect(params[0].name).to_equal("new")
                cni3_expect_index(body)
            case _: fail("multi-parameter arrow stopped being a lambda")

    it "blocks opaque imported shadow authority inside a block then restores the parameter":
        step("Inspect bound-before, actual alias import, unknown-inside, and bound-after ASTs")
        val source = "fn barrier(new: [i64]):\n    val before = new[0]\n" +
            "    val inside = do:\n        use provider.{items as new}\n        new[0]\n" +
            "    new[0]\n"
        val function = cni3_function(source, "barrier")
        match function.body.stmts[0].kind:
            case StmtKind.Val(_, _, before): cni3_expect_index(before)
            case _: fail("missing pre-import reference")
        match function.body.stmts[1].kind:
            case StmtKind.Val(_, _, init):
                match init.kind:
                    case ExprKind.Block(block):
                        match block.stmts[0].kind:
                            case StmtKind.Import(path, names, _):
                                expect(path).to_equal("provider")
                                expect(names).to_contain("items:new")
                            case _: fail("actual lexical import was not retained")
                        cni3_expect_allocation(cni3_statement_expr(block.stmts[1]))
                    case _: fail("missing import scope block")
            case _: fail("missing block-valued local")
        cni3_expect_index(cni3_statement_expr(function.body.stmts[2]))

    it "preserves the original facet consumer member access after indexing":
        step("Inspect Field(Index(Ident(new), index), stable_entity_id) from the real parser")
        val source = "struct Facet:\n    stable_entity_id: text\n" +
            "fn facet(new: [Facet], index: i64) -> text:\n    new[index].stable_entity_id\n"
        val function = cni3_function(source, "facet")
        match cni3_statement_expr(function.body.stmts[0]).kind:
            case ExprKind.Field(receiver, field):
                expect(field).to_equal("stable_entity_id")
                cni3_expect_index(receiver)
            case _: fail("original consumer postfix was swallowed by allocation parsing")
