"""
## Purpose and audience
Purpose: A retained parse of a file with no @representation block must not
fail transient-owner promotion (nil pending manifest owns nothing).
Audience: frontend and driver engineers.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
Regression for "transient retained parser ownership failed (declaration=false)"
on the seed interpreter, whose rt_transient_heap_promote shim returned false
for nil.
"""
use std.spec
use compiler.frontend.core.representation_declarations_v1.{representation_parser_reset_v1, representation_parser_promote_transient_owner_v1}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

describe "representation parser transient promotion":
    it "promotes a file with no @representation block (nil pending manifest)":
        expect(rt_transient_array_scope_begin()).to_be(true)
        representation_parser_reset_v1("fn main(): 0\n", "plain.spl")
        expect(rt_transient_array_scope_pause()).to_be(true)
        val promoted = representation_parser_promote_transient_owner_v1()
        expect(rt_transient_array_scope_end()).to_be(true)
        expect(promoted).to_be(true)
