use std.spec.{describe, it, expect}
use compiler.frontend.core.lexer_struct.{core_token_slot_state_take, core_token_slot_state_install}

describe "CoreTokenSlotState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = core_token_slot_state_take()
        val fresh = core_token_slot_state_take()
        expect(fresh.core_last_token_text_slot.len()).to_equal(0)
        core_token_slot_state_install(a)
        val again = core_token_slot_state_take()
        expect(again.core_last_token_text_slot.len()).to_equal(a.core_last_token_text_slot.len())
        core_token_slot_state_install(again)
