# Pending callback-value regression for an admitted pure-Simple interpreter
# and native candidate. This fixture is intentionally outside the auto-run
# `*_spec.spl` set until those candidates exist. Run it explicitly with the
# test command so failed expectations produce a nonzero verdict.

use std.spec.*

fn add_one(x): x + 1

fn pmap(items, f):
    var result = []
    var i = 0
    while i < len(items):
        result.push(f(items[i]))
        i = i + 1
    result

describe "placeholder callback values through a pmap-shaped free function":
    it "accepts a named function control":
        expect(pmap([1, 2, 3], add_one)).to_equal([2, 3, 4])

    it "accepts an explicit lambda control":
        expect(pmap([1, 2, 3], \x: x + 1)).to_equal([2, 3, 4])

    it "accepts a placeholder lambda callback":
        expect(pmap([1, 2, 3], _1 + 1)).to_equal([2, 3, 4])
