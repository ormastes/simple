"""
## Purpose and audience
Purpose: Prove that Nested tuple-index access parses (r.0.1).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

# Nested tuple-index access `r.0.1` (lexer maximal-munch defect)
#
# @cover src/compiler/10.frontend/core/parser_expr.spl 2%
#
# The number scanner takes the maximal munch, so the source `.0.1` after a
# member dot lexes as TOK_DOT + TOK_FLOAT_LIT("0.1"), never DOT INT DOT INT.
# Before the fix the parser saw a float in member position and reported
# `expected field name after '.'` (the Rust seed's wording is
# `Unexpected token: expected identifier, found Float(0.1)`), forcing an
# intermediate `val` workaround for every nested tuple read.
#
# Discriminating: buggy parser → the return expression never becomes a Field
# chain, so the shape reads "<none>"; fixed → "r.0.1".
#
# The second describe is the regression guard: the re-split must not have
# taught the parser to treat ordinary float literals as index pairs, so `1.0`,
# `3.14`, `1e5`, `0.0` are pinned by value, and single-level `x.0`, `x.field`,
# `x.method()` and `0..10` are pinned by shape. All nine of those passed before
# the fix as well as after — they are the "did not break anything" half.
#
# Every case rides one of two module parses (`SHAPES` / `FLOATS`); parsing the
# compiler frontend once per example overruns the runner's per-file limit.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*

fn render(e: Expr) -> text:
    match e.kind:
        case ExprKind.Field(recv, name):
            return render(recv) + "." + name
        case ExprKind.Ident(n):
            return n
        case ExprKind.MethodCall(recv, name, args):
            return render(recv) + "." + name + "()"
        case ExprKind.Range(lo, hi, incl, step):
            return "range"
        case ExprKind.IntLit(v):
            return "int"
        case ExprKind.FloatLit(v):
            return "float"
        case _:
            return "<other>"

fn ret_expr(fn_: FnDecl) -> Expr?:
    for s in fn_.body.stmts:
        match s.kind:
            case StmtKind.Return(rv):
                if rv != nil:
                    return rv
            case _:
                pass
    return nil

# One parse, one function per case: name -> rendered shape of its `return`.
fn shapes_of(src: text) -> {text: text}:
    var out: {text: text} = {}
    val m = parse_and_build_module(src, "p.spl")
    for name in m.functions.keys():
        val rv = ret_expr(m.functions[name])
        if rv != nil:
            out[name] = render(rv)
        else:
            out[name] = "<none>"
    out

# One parse, one function per case: name -> f64 value of its `return` literal.
fn floats_of(src: text) -> {text: f64}:
    var out: {text: f64} = {}
    val m = parse_and_build_module(src, "p.spl")
    for name in m.functions.keys():
        val rv = ret_expr(m.functions[name])
        if rv != nil:
            match rv.kind:
                case ExprKind.FloatLit(v):
                    out[name] = v
                case _:
                    out[name] = -1.0
        else:
            out[name] = -1.0
    out

val SHAPE_SRC = (
    "fn nested2(r: i64) -> i64:\n    return r.0.1\n" +
    "fn wide_index(r: i64) -> i64:\n    return r.0.10\n" +
    "fn nested3(r: i64) -> i64:\n    return r.0.1.2\n" +
    "fn nested4(r: i64) -> i64:\n    return r.0.1.2.3\n" +
    "fn single(x: i64) -> i64:\n    return x.0\n" +
    "fn index_then_field(r: i64) -> i64:\n    return r.0.name\n" +
    "fn method(x: i64) -> i64:\n    return x.method()\n" +
    "fn field(x: i64) -> i64:\n    return x.name\n" +
    "fn rng() -> i64:\n    return 0..10\n")

val FLOAT_SRC = (
    "fn one_point_zero() -> f64:\n    return 1.0\n" +
    "fn pi() -> f64:\n    return 3.14\n" +
    "fn exp5() -> f64:\n    return 1e5\n" +
    "fn zero() -> f64:\n    return 0.0\n")

# Memoised so the whole file costs exactly two frontend parses, not one per
# example. (keys().len(), never Dict.len() — see dict_native_pitfalls.md.)
var G_SHAPES: {text: text} = {}
var G_FLOATS: {text: f64} = {}

fn shapes() -> {text: text}:
    if G_SHAPES.keys().len() == 0:
        G_SHAPES = shapes_of(SHAPE_SRC)
    G_SHAPES

fn floats() -> {text: f64}:
    if G_FLOATS.keys().len() == 0:
        G_FLOATS = floats_of(FLOAT_SRC)
    G_FLOATS

use std.spec.step

describe "Nested tuple-index access parses (r.0.1)":
    it "r.0.1 parses as two chained tuple indices, not a float literal":
        step("Verify: r.0.1 parses as two chained tuple indices, not a float literal")
        # @req: REQ-COMPILER-FRONTEND-001
        expect(shapes()["nested2"]).to_equal("r.0.1")

    it "r.0.10 keeps the exact index 10 (an f64 payload could not)":
        step("Verify: r.0.10 keeps the exact index 10 (an f64 payload could not)")
        expect(shapes()["wide_index"]).to_equal("r.0.10")

    it "r.0.1.2 chains three levels":
        step("Verify: r.0.1.2 chains three levels")
        expect(shapes()["nested3"]).to_equal("r.0.1.2")

    it "r.0.1.2.3 chains four levels":
        step("Verify: r.0.1.2.3 chains four levels")
        expect(shapes()["nested4"]).to_equal("r.0.1.2.3")

describe "Regression guard: float literals and single-level access unchanged":
    it "1.0 is still a float literal":
        step("Verify: 1.0 is still a float literal")
        expect(floats()["one_point_zero"]).to_equal(1.0)

    it "3.14 is still a float literal":
        step("Verify: 3.14 is still a float literal")
        expect(floats()["pi"]).to_equal(3.14)

    it "1e5 is still a float literal":
        step("Verify: 1e5 is still a float literal")
        expect(floats()["exp5"]).to_equal(100000.0)

    it "0.0 is still a float literal":
        step("Verify: 0.0 is still a float literal")
        expect(floats()["zero"]).to_equal(0.0)

    it "single-level tuple index x.0 still parses":
        step("Verify: single-level tuple index x.0 still parses")
        expect(shapes()["single"]).to_equal("x.0")

    it "mixed index-then-field r.0.name still parses":
        step("Verify: mixed index-then-field r.0.name still parses")
        expect(shapes()["index_then_field"]).to_equal("r.0.name")

    it "method call x.method() still parses":
        step("Verify: method call x.method() still parses")
        expect(shapes()["method"]).to_equal("x.method()")

    it "field access x.name still parses":
        step("Verify: field access x.name still parses")
        expect(shapes()["field"]).to_equal("x.name")

    it "range 0..10 is still a range, not a tuple index":
        step("Verify: range 0..10 is still a range, not a tuple index")
        expect(shapes()["rng"]).to_equal("range")
