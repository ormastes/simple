"""
# Parser TypeKind Trace Runtime Facade Contract

The parser TypeKind trace gate uses the canonical optional environment facade
while preserving its exact enabled-only-for-`1` predicate.
"""

use std.io_runtime.{read_file_text}
use std.spec.step

describe "parser TypeKind trace runtime facade ownership":
    it "uses exactly one canonical optional environment lookup":
        step("Load the parser expression type source")
        val source = read_file_text("src/compiler/10.frontend/parser_types_expr.spl")

        step("Require the canonical facade and exact trace predicate")
        expect(source).to_contain("use std.nogc_sync_mut.io_runtime.{env_get_opt}")
        expect(source).to_contain("(env_get_opt(\"SIMPLE_TRACE_TYPEKIND\") ?? \"\") == \"1\"")
        expect(source.split("env_get_opt(\"SIMPLE_TRACE_TYPEKIND\")").len()).to_equal(2)

        step("Reject direct environment runtime ownership")
        expect(source).to_not_contain("extern fn rt_env_get")
        expect(source).to_not_contain("rt_env_get(")

    it "retains unrelated parser runtime declarations":
        step("Load the parser expression type source")
        val source = read_file_text("src/compiler/10.frontend/parser_types_expr.spl")

        step("Pin the declarations outside this migration")
        expect(source).to_contain("extern fn rt_enum_payload(value: TypeKind) -> i64")
        expect(source).to_contain("extern fn rt_enum_discriminant(value: TypeKind) -> i64")
        expect(source).to_contain("extern fn rt_tuple_get(tuple: i64, index: i64) -> i64")
        expect(source).to_contain("extern fn rt_println(msg: text)")
