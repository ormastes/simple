# Target cfg decisions are bound to the exact bytes parsed in the full-index route.
use std.spec
use std.spec.step
use std.common.crypto.sha256.sha256_text
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend_target_receipted_v1
use compiler.frontend.frontend_target_cfg_receipt_v1.{
    frontend_cfg_receipt_valid_v1, frontend_cfg_excluded_emit_count_v1}

describe "explicit target cfg decision receipt":
    it "binds stacked cfg exclusions and active declarations to a Linux x86_64 target":
        step("binds stacked cfg exclusions and active declarations to a Linux x86_64 target")
        val source = "@cfg(\"target_arch\", \"arm\")\n" +
            "@cfg(\"target_arch\", \"thumbv7m\")\n" +
            "fn excluded() -> i64:\n    1\n" +
            "@when(linux)\n" +
            "fn included() -> i64:\n    2\n" +
            "@end\n"
        val parsed = parse_full_frontend_target_receipted_v1(source,
            "target_cfg_receipt.spl", "target_cfg_receipt", Logger(level: 0),
            "scv:test:target_cfg_receipt", sha256_text(source),
            "x86_64-unknown-linux-gnu")
        assert_true(parsed.is_ok())
        val receipt = parsed.unwrap()[1]
        assert_true(frontend_cfg_receipt_valid_v1(receipt,
            "scv:test:target_cfg_receipt", sha256_text(source),
            "x86_64-unknown-linux-gnu"))
        assert_equal(receipt.target_os, "linux")
        assert_equal(receipt.target_arch, "x86_64")
        assert_equal(frontend_cfg_excluded_emit_count_v1(receipt), 2)
        assert_equal(receipt.decisions[0].excluded_declaration_kind, "code")
        assert_equal(receipt.decisions[0].excluded_start_line, 3)

    it "rejects an unknown condition key and a triple without an explicit OS":
        step("rejects an unknown condition key and a triple without an explicit OS")
        val source = "@cfg(unknown_feature)\nfn conditional() -> i64:\n    1\n"
        val digest = sha256_text(source)
        val unknown = parse_full_frontend_target_receipted_v1(source,
            "unknown_cfg.spl", "unknown_cfg", Logger(level: 0),
            "scv:test:unknown_cfg", digest, "x86_64-unknown-linux-gnu")
        assert_true(unknown.is_err())
        val unsupported = parse_full_frontend_target_receipted_v1(source,
            "unknown_cfg.spl", "unknown_cfg", Logger(level: 0),
            "scv:test:unknown_cfg", digest, "x86_64-unknown-gnu")
        assert_true(unsupported.is_err())

    it "rejects source digest drift before parsing":
        step("rejects source digest drift before parsing")
        val source = "fn value() -> i64:\n    1\n"
        val parsed = parse_full_frontend_target_receipted_v1(source,
            "drift.spl", "drift", Logger(level: 0),
            "scv:test:drift", sha256_text("different"),
            "x86_64-unknown-linux-gnu")
        assert_true(parsed.is_err())
