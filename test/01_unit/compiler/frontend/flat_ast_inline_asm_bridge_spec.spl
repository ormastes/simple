# Flat AST bridge inline asm fidelity.
#
# Regression guard: EXPR_ASM used to fall through convert_flat_expr and become
# NilLit/identifier-shaped output, making HIR/JIT report "Unknown variable: asm"
# and fall back to the slow interpreter path before native-build created any .o.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir.*
use compiler.backend.{MirToLlvm, MirToC}
use compiler.backend.backend.backend_types.{CodegenTarget}
use std.io_runtime.{read_file_text}

fn first_asm_template(src: text) -> text:
    val m = parse_and_build_module(src, "flat_ast_inline_asm_bridge_spec.spl")
    val fn_ = m.functions["test"] ?? panic("missing test function")
    for stmt in fn_.body.stmts:
        match stmt.kind:
            case StmtKind.Expr(expr):
                match expr.kind:
                    case ExprKind.AsmBlock(asm_node):
                        return asm_node.asm_template
                    case _:
                        pass
            case _:
                pass
    "missing"

fn rv64_named_immediate_score(src: text) -> i64:
    val m = parse_and_build_module(src, "flat_ast_inline_asm_bridge_spec.spl")
    val fn_ = m.functions["test"] ?? panic("missing test function")
    for stmt in fn_.body.stmts:
        match stmt.kind:
            case StmtKind.Expr(expr):
                match expr.kind:
                    case ExprKind.AsmBlock(asm_node):
                        var score = asm_node.constraints.len()
                        for constraint in asm_node.constraints:
                            if constraint.name == "dst": score = score + 10
                            if constraint.name == "src": score = score + 20
                            if constraint.name == "shift": score = score + 40
                            match constraint.location:
                                case AsmLocation.Imm: score = score + 100
                                case _: pass
                        return score
                    case _: pass
            case _: pass
    0

fn asm_metadata_score(src: text) -> i64:
    val m = parse_and_build_module(src, "flat_ast_inline_asm_bridge_spec.spl")
    val fn_ = m.functions["test"] ?? panic("missing test function")
    for stmt in fn_.body.stmts:
        match stmt.kind:
            case StmtKind.Expr(expr):
                match expr.kind:
                    case ExprKind.AsmBlock(asm_node):
                        var score = asm_node.clobbers.len() * 11
                        score = score + asm_node.clobber_abis.len() * 12
                        score = score + asm_node.options.len() * 14
                        for constraint in asm_node.constraints:
                            match constraint.kind:
                                case AsmConstraintKind.InOut:
                                    match constraint.value.kind:
                                        case ExprKind.Ident(name):
                                            if name == "input": score = score + 50
                                        case _: pass
                                    match constraint.output_value:
                                        case Some(output_value):
                                            match output_value.kind:
                                                case ExprKind.Ident(name):
                                                    if name == "output": score = score + 100
                                                case _: pass
                                        case None: pass
                                case _: pass
                        return score
                    case _: pass
            case _: pass
    0

fn lower_inline_asm_mir(src: text) -> MirModule:
    val module = parse_and_build_module(src, "flat_ast_inline_asm_mir_spec.spl")
    var hir_lowering = HirLowering.with_filename("flat_ast_inline_asm_mir_spec.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.lower_module(hir)

fn mir_metadata_score(mir: MirModule) -> i64:
    var score = 0
    var asm_output_local = -1
    var asm_input_local = -1
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.InlineAsm(_, _, inputs, outputs, clobbers, clobber_abis, options):
                        score = clobbers.len() * 11
                        score = score + clobber_abis.len() * 12
                        score = score + options.len() * 14
                        if inputs.len() == 1 and outputs.len() == 1:
                            match inputs[0].operand.kind:
                                case MirOperandKind.Copy(input_local):
                                    asm_input_local = input_local.id
                                    match outputs[0].operand.kind:
                                        case MirOperandKind.Copy(output_local):
                                            asm_output_local = output_local.id
                                            if input_local.id != output_local.id: score = score + 150
                                        case _: pass
                                case _: pass
                    case MirInstKind.Copy(destination, source):
                        if source.id == asm_output_local and destination.id != asm_input_local:
                            for local in function.locals:
                                if local.id.id == destination.id and (local.name ?? "") == "output": score = score + 200
                    case _: pass
    score

fn c_inline_asm_clause_score(c_source: text) -> i64:
    val asm_start = c_source.find("__asm__ volatile")
    if asm_start < 0: return 0
    val tail = c_source[asm_start..]
    val asm_end = tail.find(");")
    if asm_end < 0: return 0
    val clause = tail[..asm_end + 2]
    var score = 0
    if clause.contains("\"add %0, %0, 1\""): score = score + 1
    if clause.contains("\n    : \"=r\" ("): score = score + 2
    if clause.contains("\n    : \"0\" ("): score = score + 4
    if clause.contains("\n    : \"memory\", SIMPLE_INLINE_ASM_C_ABI_CLOBBERS"): score = score + 8
    score

fn mir_pair_identity_score(mir: MirModule) -> i64:
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.InlineAsm(_, _, inputs, outputs, _, _, _):
                        if inputs.len() == 2 and outputs.len() == 2:
                            if inputs[0].constraint_index == outputs[0].constraint_index and inputs[1].constraint_index == outputs[1].constraint_index and inputs[0].constraint_index != inputs[1].constraint_index:
                                return 3
                    case _: pass
    0

describe "Flat AST bridge inline asm fidelity":
    it "keeps the clobber and options dispatch as a canonical multiline if/elif chain":
        val source = read_file_text("src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl")
        expect(source).to_contain(
            "        if item.starts_with(\"clobber_abi:\"):\n" +
            "            clobber_abis.push(item[12..])\n" +
            "        elif item.starts_with(\"options:\"):\n"
        )
        expect(source).to_contain(
            "                if normalized_option != \"\":\n" +
            "                    asm_options.push(normalized_option)\n" +
            "        elif item.starts_with(\"clobber:\"):\n" +
            "            plain_clobbers.push(item[8..])\n"
        )
        expect(source.contains("if item.starts_with(\"clobber_abi:\"): clobber_abis.push")).to_be(false)
        expect(source.contains("elif item.starts_with(\"clobber:\"): plain_clobbers.push")).to_be(false)

    it "preserves inline asm as typed AsmBlock nodes":
        val src = "fn test():\n    asm(\"cli\")\n"
        expect(first_asm_template(src)).to_equal("cli")

    it "preserves volatile asm text":
        val src = "fn test():\n    asm volatile(\"bkpt #0\")\n"
        expect(first_asm_template(src)).to_equal("bkpt #0")

    it "retains named RV64 register and immediate operands in the typed AST":
        val src = "fn test(src: i64):\n    var dst = 0\n    asm volatile(\"addi {dst}, {src}, {shift}\", dst = out(reg) dst, src = in(reg) src, shift = in(imm) 4)\n"
        expect(first_asm_template(src)).to_equal("addi {dst}, {src}, {shift}")
        expect(rv64_named_immediate_score(src)).to_equal(173)

    it "retains clobbers ABI options and inout output through the typed bridge":
        val src = "fn test(input: i64):\n    var output = 0\n    asm volatile(\"add {0}, {0}, 1\", inout(reg) input => output, clobber_abi(\"C\"), options(nostack, readonly))\n"
        expect(asm_metadata_score(src)).to_equal(190)

    it "retains metadata and distinct inout expressions through MIR and LLVM backend":
        val src = "fn test(input: i64):\n    var output = 0\n    asm volatile(\"add {0}, {0}, 1\", inout(reg) input => output, clobber_abi(\"C\"), options(nostack, readonly))\n"
        val mir = lower_inline_asm_mir(src)
        expect(mir_metadata_score(mir)).to_equal(390)
        val llvm = MirToLlvm.create("test.inline.asm.metadata", CodegenTarget.X86_64, nil).translate_module(mir)
        expect(llvm.contains("asm sideeffect \"add $0, $0, 1\", \"=r,0,~{rax}")).to_equal(true)
        expect(llvm.contains(" = call i64 asm sideeffect")).to_equal(true)
        expect(llvm.contains("memory(read)")).to_equal(true)
        expect(llvm.contains("alignstack")).to_equal(false)
        val c_source = MirToC.create("test.inline.asm.metadata").translate_module(mir)
        expect(c_inline_asm_clause_score(c_source)).to_equal(15)

    it "pairs duplicate-named inout operands by stable source index":
        val src = "fn test(left: i64, right: i64):\n    var first = 0\n    var second = 0\n    asm volatile(\"add {0}, {1}, 1\", io = inout(reg) left => first, io = inout(reg) right => second)\n"
        expect(mir_pair_identity_score(lower_inline_asm_mir(src))).to_equal(3)
