use std.spec.{describe, it, expect}
use compiler.frontend.parse_context.{parse_context_take, parse_context_install}
use compiler.frontend.core.parser.{parser_set_had_error, parser_has_errors}
use compiler.frontend.core._Ast.module_state.{lexer_state_get, lexer_state_set}

describe "ParseContext (stage 1)":
    it "swaps every owner between two contexts":
        parser_set_had_error(true)
        lexer_state_set("cur_text2", "alpha")
        val a = parse_context_take()
        expect(parser_has_errors()).to_equal(false)
        expect(lexer_state_get("cur_text2")).to_equal("")

        lexer_state_set("cur_text2", "beta")
        val b = parse_context_take()

        parse_context_install(a)
        expect(parser_has_errors()).to_equal(true)
        expect(lexer_state_get("cur_text2")).to_equal("alpha")

        parse_context_install(b)
        expect(parser_has_errors()).to_equal(false)
        expect(lexer_state_get("cur_text2")).to_equal("beta")
        lexer_state_set("cur_text2", "")
