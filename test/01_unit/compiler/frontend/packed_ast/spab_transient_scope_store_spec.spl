# @tag: unit, compiler, only-compiled

use std.spec.{describe, it, expect}
use std.io_runtime.{file_exists, file_delete}
use std.nogc_sync_mut.io_runtime.{dir_create_all}
use app.io.env_ops.{env_get, env_set}
use std.common.crypto.sha256.{sha256_text, sha256_text_native_or_empty}
use std.nogc_sync_mut.sffi.runtime.{xxh3_128_text}
use compiler.frontend.flat_ast_bridge.{flat_pool_capture_arm, flat_pool_capture_take,
    flat_pool_capture_take_trace, flat_pool_capture_take_refs,
    parse_and_build_module_in_borrowed_scope, flat_pools_clear_chunks_v1}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION, flat_pool_type_trace_arm_v1,
    flat_pool_type_trace_take_v1, flat_pool_type_trace_family_v1, flat_pool_enc_scalar_i64}
use compiler.frontend.core.flat_pool_packed_v1.{SpabDigestV1, flat_packed_encode_v1,
    flat_packed_encode_refs_v1, flat_packed_decode_lines_v1, flat_packed_last_encode_refusal_v1}
use compiler.frontend.frontend_spab_cache_v1.{frontend_spab_store_v1, frontend_spab_load_v1,
    frontend_spab_path_v1, frontend_spab_last_store_refusal_reason_v1}

extern fn rt_file_read_text(path: text) -> text?
extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

val CACHE_DIR: text = "build/spab_transient_scope_store_spec"
val MODULE_A: text = "src/compiler/80.driver/driver_parse_shard_hash.spl"
val MODULE_B: text = "src/lib/sffi/cli_args.spl"

fn capture_and_store_in_scope(path: text) -> (text, text, text, i64):
    val source = rt_file_read_text(path) ?? ""
    val key = xxh3_128_text(source)
    val source_sha = sha256_text_native_or_empty(source)
    expect(rt_transient_array_scope_begin()).to_equal(true)
    val spab_path = frontend_spab_path_v1(key)
    if spab_path != "" and file_exists(spab_path):
        file_delete(spab_path)
    val miss_hit = frontend_spab_load_v1(key, source, source_sha, path)
    expect(miss_hit.is_none()).to_equal(true)
    flat_pool_capture_arm()
    val fresh = parse_and_build_module_in_borrowed_scope(source, path)
    val blob = flat_pool_capture_take()
    val trace = flat_pool_capture_take_trace()
    val refs = flat_pool_capture_take_refs()
    val stored = frontend_spab_store_v1(key, path, blob, trace, refs, source_sha)
    val reason = frontend_spab_last_store_refusal_reason_v1()
    expect(stored).to_equal(true)
    expect(reason).to_equal("")
    expect(file_exists(spab_path)).to_equal(true)
    val import_count = fresh.imports.len()
    expect(rt_transient_array_scope_pause()).to_equal(true)
    expect(rt_transient_array_scope_end()).to_equal(true)
    (key, source_sha, spab_path, import_count)

fn churn_strings():
    var churn: [text] = []
    for i in 0..64:
        churn.push("reclaim-churn-{i}")

describe "packed .spab store across transient parse scopes":
    it "stores and restores non-entry modules including cli_args.spl across scope ends":
        val prev_enabled = env_get("SIMPLE_FRONTEND_CACHE") ?? ""
        val prev_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? ""
        val prev_dir = env_get("SIMPLE_FRONTEND_CACHE_DIR") ?? ""
        val prev_spab = env_get("SIMPLE_FRONTEND_SPAB") ?? ""

        dir_create_all(CACHE_DIR)
        env_set("SIMPLE_FRONTEND_CACHE", "1")
        env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "spab-transient-scope-spec-v1")
        env_set("SIMPLE_FRONTEND_CACHE_DIR", CACHE_DIR)
        env_set("SIMPLE_FRONTEND_SPAB", "1")

        val src_a = rt_file_read_text(MODULE_A) ?? ""
        val src_b = rt_file_read_text(MODULE_B) ?? ""

        # Scope 1: first module initializes _scope_digest() inside a transient scope.
        val (key_a, sha_a, path_a, imports_a) = capture_and_store_in_scope(MODULE_A)
        churn_strings()

        # Scope 2: non-entry module (cli_args.spl) must still store .spab, not refuse.
        val (key_b, sha_b, path_b, imports_b) = capture_and_store_in_scope(MODULE_B)
        churn_strings()

        # Scope 3: warm .spab loads must hit for both modules.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val hit_a = frontend_spab_load_v1(key_a, src_a, sha_a, MODULE_A)
        val hit_b = frontend_spab_load_v1(key_b, src_b, sha_b, MODULE_B)
        expect(hit_a.is_some()).to_equal(true)
        expect(hit_b.is_some()).to_equal(true)
        expect(hit_a.unwrap().imports.len()).to_equal(imports_a)
        expect(hit_b.unwrap().imports.len()).to_equal(imports_b)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)

        if file_exists(path_a):
            file_delete(path_a)
        if file_exists(path_b):
            file_delete(path_b)

        env_set("SIMPLE_FRONTEND_CACHE", prev_enabled)
        env_set("SIMPLE_FRONTEND_CACHE_SCOPE", prev_scope)
        env_set("SIMPLE_FRONTEND_CACHE_DIR", prev_dir)
        env_set("SIMPLE_FRONTEND_SPAB", prev_spab)

    it "round-trips cli_args.spl export-use module byte for byte":
        val source = rt_file_read_text(MODULE_B) ?? ""
        expect(rt_transient_array_scope_begin()).to_equal(true)
        flat_pool_capture_arm()
        val fresh = parse_and_build_module_in_borrowed_scope(source, MODULE_B)
        val blob = flat_pool_capture_take()
        val trace = flat_pool_capture_take_trace()
        val refs = flat_pool_capture_take_refs()
        val digests = [
            SpabDigestV1(subject: 1, algo: 1, hex: sha256_text(source)),
            SpabDigestV1(subject: 2, algo: 1, hex: sha256_text("spec-compiler"))
        ]
        val packed = flat_packed_encode_refs_v1(blob, trace, refs, digests, xxh3_128_text(MODULE_B))
        expect(packed.len() > 0).to_equal(true)
        expect(flat_packed_last_encode_refusal_v1()).to_equal("")
        expect(flat_packed_decode_lines_v1(packed, flat_pools_clear_chunks_v1())).to_equal(blob)
        expect(fresh.imports.len() > 0).to_equal(true)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)

    it "reports specific refusal reasons for invalid packed encodes and stores":
        flat_pool_type_trace_arm_v1()
        flat_pool_type_trace_family_v1(5)
        val lines = FLAT_POOL_CODEC_VERSION + "\n" + flat_pool_enc_scalar_i64(42)
        val trace = flat_pool_type_trace_take_v1()
        val valid_digests = [
            SpabDigestV1(subject: 1, algo: 1, hex: sha256_text("src")),
            SpabDigestV1(subject: 2, algo: 1, hex: sha256_text("cmp"))
        ]
        val module_key = xxh3_128_text("refusal_spec.spl")

        expect(flat_packed_encode_refs_v1(lines, trace, [], valid_digests, "short").len()).to_equal(0)
        expect(flat_packed_last_encode_refusal_v1()).to_equal("bad-module-key")

        val bad_digests = [
            SpabDigestV1(subject: 1, algo: 1, hex: "00"),
            SpabDigestV1(subject: 2, algo: 1, hex: sha256_text("cmp"))
        ]
        expect(flat_packed_encode_refs_v1(lines, trace, [], bad_digests, module_key).len()).to_equal(0)
        expect(flat_packed_last_encode_refusal_v1()).to_equal("bad-identity-digests")

        expect(flat_packed_encode_refs_v1(lines, [999], [], valid_digests, module_key).len()).to_equal(0)
        expect(flat_packed_last_encode_refusal_v1()).to_equal("bad-trace-code")

        expect(flat_packed_encode_refs_v1(lines, [87, 87], [], valid_digests, module_key).len()).to_equal(0)
        expect(flat_packed_last_encode_refusal_v1()).to_equal("walk-mismatch")

        expect(flat_packed_encode_v1(lines, trace, valid_digests, module_key).len() > 0).to_equal(true)
        expect(flat_packed_last_encode_refusal_v1()).to_equal("")

        val prev_enabled = env_get("SIMPLE_FRONTEND_CACHE") ?? ""
        val prev_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? ""
        val prev_dir = env_get("SIMPLE_FRONTEND_CACHE_DIR") ?? ""
        dir_create_all(CACHE_DIR)
        env_set("SIMPLE_FRONTEND_CACHE", "1")
        env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "spab-refusal-spec-v1")
        env_set("SIMPLE_FRONTEND_CACHE_DIR", CACHE_DIR)

        expect(frontend_spab_store_v1("short-key", MODULE_B, lines, trace, [], sha256_text("x"))).to_equal(false)
        expect(frontend_spab_last_store_refusal_reason_v1()).to_equal("bad-key-or-scope")

        val key = xxh3_128_text("refusal_spec.spl")
        expect(frontend_spab_store_v1(key, MODULE_B, "", trace, [], sha256_text("x"))).to_equal(false)
        expect(frontend_spab_last_store_refusal_reason_v1()).to_equal("empty-blob")

        expect(frontend_spab_store_v1(key, MODULE_B, lines, [], [], sha256_text("x"))).to_equal(false)
        expect(frontend_spab_last_store_refusal_reason_v1()).to_equal("empty-trace")

        expect(frontend_spab_store_v1(key, MODULE_B, lines, trace, [], "")).to_equal(false)
        expect(frontend_spab_last_store_refusal_reason_v1()).to_equal("native-digest-unavailable")

        env_set("SIMPLE_FRONTEND_CACHE", prev_enabled)
        env_set("SIMPLE_FRONTEND_CACHE_SCOPE", prev_scope)
        env_set("SIMPLE_FRONTEND_CACHE_DIR", prev_dir)
