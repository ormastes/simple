# @cover src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl 10%
"""
## Purpose and audience
End-to-end proof that a `unit Name: T [as suffix]` declaration is a working
type in an executing program, not only a parsed record: construction with
`Name(value: x)`, `.value` reads, passing a unit to a function, and a unit as a
struct field, same-unit +/-, scaling by an int, comparison, and same-unit
multiply/divide (U * U and U / U yield the plain scalar, not the unit).
## Operator workflow
bin/simple test test/01_unit/compiler/frontend/unit_decl_e2e_spec.spl
## Compatibility and limitations
Cross-unit rejection (SPL-UNIT-002) is asserted in unit_op_matrix_spec.spl.
## Verification guidance and troubleshooting
A failure here with the declaration specs green means the declaration parses
but the unit does not behave as a value at run time.
"""

use std.spec

unit ByteCount: u64 as Bc
unit BitCount: u64

struct Buffer:
    size: ByteCount
    bits: BitCount

fn pass_through(b: ByteCount) -> ByteCount:
    b

describe "unit declaration end to end":
    it "constructs and reads .value":
        val b = ByteCount(value: 7)
        val n = BitCount(value: 56)
        expect(b.value).to_equal(7)
        expect(n.value).to_equal(56)

    it "adds and subtracts the same unit":
        val a = ByteCount(value: 10)
        val b = ByteCount(value: 4)
        expect((a + b).value).to_equal(14)
        expect((a - b).value).to_equal(6)

    it "scales by an int":
        val a = ByteCount(value: 6)
        expect((a * 3).value).to_equal(18)
        expect((3 * a).value).to_equal(18)
        expect((a / 2).value).to_equal(3)

    it "compares the same unit":
        val a = ByteCount(value: 1)
        val b = ByteCount(value: 2)
        expect(a < b).to_equal(true)
        expect(b < a).to_equal(false)
        expect(a == ByteCount(value: 1)).to_equal(true)
        expect(a == b).to_equal(false)

    it "divides the same unit into a plain scalar":
        val q = ByteCount(value: 12) / ByteCount(value: 4)
        expect(q).to_equal(3)

    it "multiplies the same unit into a plain scalar":
        val p = ByteCount(value: 3) * ByteCount(value: 4)
        expect(p).to_equal(12)

    it "passes a unit to a function":
        expect(pass_through(ByteCount(value: 21)).value).to_equal(21)

    it "stores a unit as a struct field":
        val buf = Buffer(size: ByteCount(value: 100), bits: BitCount(value: 800))
        expect(buf.size.value).to_equal(100)
        expect(buf.bits.value).to_equal(800)
