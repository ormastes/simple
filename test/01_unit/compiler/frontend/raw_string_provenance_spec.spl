"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/frontend/raw_string_provenance_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/raw_string_provenance_spec.md
# doc-path: doc/03_plan/sys_test/raw_string_provenance_spec.md
# doc-path: doc/04_architecture/raw_string_provenance_spec.md
# doc-path: doc/05_design/raw_string_provenance_spec_oracles.md
# @manual: primary

"""
# Raw String Provenance Regression

Keeps raw, single-quoted, and triple-quoted source strings out of the ordinary
string interpolation expansion path, including block-DSL examples in docs.
"""
use std.spec.step

use std.spec.step

use compiler.core.parser.{parser_init, parse_expr}
use compiler.core.ast.{EXPR_STRING_LIT, expr_get_tag, expr_get_int, expr_get_str}
use compiler.blocks.builtin_blocks_math.{math_block_def_new, loss_block_def_new, nograd_block_def_new}
use compiler.blocks.builtin_blocks_shell.{shell_block_def_new}


fn expect_non_interpolating(source: text, expected: text):
    parser_init(source)
    val expression = parse_expr()
    expect(expr_get_tag(expression)).to_equal(EXPR_STRING_LIT)
    expect(expr_get_int(expression)).to_equal(1)
    expect(expr_get_str(expression)).to_equal(expected)

describe "Raw String Provenance":
    # @manual scenario evidence
    it "preserves raw triple block examples as literal documentation":
        # @req REQ-SSPEC-UNIT
        step("preserves raw triple block examples as literal documentation")
        val quotes = "\"\"\""
        val content = "loss{{ mse(pred, target) }}"
        expect_non_interpolating("r" + quotes + content + quotes, content)

    it "preserves bare triple strings as non-interpolating literals":
        # @req REQ-SSPEC-UNIT
        step("preserves bare triple strings as non-interpolating literals")
        val quotes = "\"\"\""
        val content = "m{{ x^2 + y^2 }}"
        expect_non_interpolating(quotes + content + quotes, content)

    it "preserves single-quoted strings as non-interpolating literals":
        # @req REQ-SSPEC-UNIT
        step("preserves single-quoted strings as non-interpolating literals")
        expect_non_interpolating("'literal {{name}}'", "literal {{name}}")

    it "decodes doubled braces in canonical block examples":
        # @req REQ-SSPEC-UNIT
        step("decodes doubled braces in canonical block examples")
        expect(math_block_def_new().examples()[0].code).to_equal("m{{ x^2 + y^2 }}")
        expect(loss_block_def_new().examples()[0].code).to_equal("loss{{ mse(pred, target) }}")
        expect(nograd_block_def_new().examples()[0].code).to_equal("nograd{{ model(test_data) }}")
        expect(shell_block_def_new().examples()[0].code).to_equal("sh{{ ls -la }}")
