use std.spec
use compiler.frontend.core.lexer.{lex_init, lex_next_snapshot}
use compiler.core.tokens.{TOK_KW_EXTERN, TOK_KW_FN, TOK_IDENT}

describe "typed lexer snapshot":
    it "preserves mixed token fields without heterogeneous array coercion":
        lex_init("extern fn probe(): i64:\n    7\n")

        val extern_token = lex_next_snapshot()
        expect(extern_token.kind).to_equal(TOK_KW_EXTERN)
        expect(extern_token.token_text).to_equal("extern")
        expect(extern_token.line).to_equal(1)
        expect(extern_token.col).to_equal(1)

        val fn_token = lex_next_snapshot()
        expect(fn_token.kind).to_equal(TOK_KW_FN)
        expect(fn_token.token_text).to_equal("fn")

        val name_token = lex_next_snapshot()
        expect(name_token.kind).to_equal(TOK_IDENT)
        expect(name_token.token_text).to_equal("probe")
