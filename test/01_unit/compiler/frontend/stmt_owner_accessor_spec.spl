use std.spec.{describe, it, expect}
use compiler.core.ast_stmt.{stmt_get_expr, stmt_set_expr, stmt_get_tag}

describe "ast_stmt owner accessors (ParseContext stage 2)":
    it "set_expr ignores out-of-range indices instead of writing":
        stmt_set_expr(-1, 5)
        expect(stmt_get_expr(-1)).to_equal(-1)
        expect(stmt_get_tag(-1)).to_equal(-1)
