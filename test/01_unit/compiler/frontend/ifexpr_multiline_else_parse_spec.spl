# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

# @cover src/compiler/10.frontend/core/parser_stmts.spl
#
# Regression for doc/08_tracking/bug/test_runner_import_parse_error_2026-11-25.md:
# an if-expression whose value and `else: <value>` sit on separate indented
# continuation lines
#     r = if n > 0:
#         1
#         else: 2
# is accepted by the Rust seed and must also parse in compiler.core.parser
# (it was rejected with E0002 "unexpected token ':'").
#
# tag: unit

use std.spec
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*
use compiler.core.parser.{parser_error_count}


describe "if-expression with else on its own continuation line parses":
    it "value line then else line lowers with zero errors":
        # @req REQ-SSPEC-COMPILER
        step("value line then else line lowers with zero errors")
        val src = "fn pick(n: i64) -> i64:\n" +
            "    var r = 0\n" +
            "    r = if n > 0:\n" +
            "        1\n" +
            "        else: 2\n" +
            "    r\n" +
            "fn after() -> i64:\n" +
            "    7\n"
        val parsed = parse_full_frontend(src, "testdata/ifexpr_ml_else.spl", "ifexpr_ml_else", Logger(level: 0))
        expect(parser_error_count()).to_equal(0)
        var hl = HirLowering.with_filename("testdata/ifexpr_ml_else.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        expect(hir.functions.len()).to_equal(2)

    it "val binding with elif and else on their own lines lowers with zero errors":
        # @req REQ-SSPEC-COMPILER
        step("val binding with elif and else on their own lines lowers with zero errors")
        val src = "fn pick(a: bool, b: bool) -> i64:\n" +
            "    val v = if a:\n" +
            "        1\n" +
            "        elif b: 2\n" +
            "        else: 3\n" +
            "    v\n" +
            "fn after() -> i64:\n" +
            "    7\n"
        val parsed = parse_full_frontend(src, "testdata/ifexpr_ml_elif.spl", "ifexpr_ml_elif", Logger(level: 0))
        expect(parser_error_count()).to_equal(0)
        var hl = HirLowering.with_filename("testdata/ifexpr_ml_elif.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        expect(hir.functions.len()).to_equal(2)

    it "one-line form still parses":
        # @req REQ-SSPEC-COMPILER
        step("one-line form still parses")
        val src = "fn pick(n: i64) -> i64:\n" +
            "    val r = if n > 0: 1 else: 2\n" +
            "    r\n"
        val parsed = parse_full_frontend(src, "testdata/ifexpr_ml_one.spl", "ifexpr_ml_one", Logger(level: 0))
        expect(parser_error_count()).to_equal(0)

    it "if statement with dedented else still parses":
        # @req REQ-SSPEC-COMPILER
        step("if statement with dedented else still parses")
        val src = "fn pick(n: i64) -> i64:\n" +
            "    var r = 0\n" +
            "    if n > 0:\n" +
            "        r = 1\n" +
            "    else:\n" +
            "        r = 2\n" +
            "    r\n"
        val parsed = parse_full_frontend(src, "testdata/ifexpr_ml_stmt.spl", "ifexpr_ml_stmt", Logger(level: 0))
        expect(parser_error_count()).to_equal(0)
