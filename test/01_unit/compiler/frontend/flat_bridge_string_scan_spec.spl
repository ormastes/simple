"""
## Purpose
Prove flat-AST string conversion preserves brace semantics while avoiding
quadratic character-by-character text construction.
"""

use compiler.common.diagnostics.span.{Span}
use compiler.frontend.flat_ast_bridge.{
    flat_bridge_build_string_interps, flat_bridge_build_string_regions,
    flat_bridge_decode_brace_escapes, parse_and_build_module}
use compiler.frontend.parser_types_expr.{ExprKind}
use std.spec.step

describe "flat bridge string scan":
    it "decodes doubled braces exactly and preserves unmatched text":
        step("Pin empty ordinary escaped mixed and unmatched values")
        expect(flat_bridge_decode_brace_escapes("")).to_equal("")
        expect(flat_bridge_decode_brace_escapes("ordinary")).to_equal("ordinary")
        expect(flat_bridge_decode_brace_escapes("{{")).to_equal("{")
        expect(flat_bridge_decode_brace_escapes("}}")).to_equal("}")
        expect(flat_bridge_decode_brace_escapes("a{{b}}c")).to_equal("a{{b}}c")
        expect(flat_bridge_decode_brace_escapes("{{{{")).to_equal("{{")
        expect(flat_bridge_decode_brace_escapes("{{{")).to_equal("{{")
        expect(flat_bridge_decode_brace_escapes("}}}")).to_equal("}}")
        expect(flat_bridge_decode_brace_escapes("{")).to_equal("{")
        expect(flat_bridge_decode_brace_escapes("}")).to_equal("}")
        expect(flat_bridge_decode_brace_escapes("}{")).to_equal("}{")
        expect(flat_bridge_decode_brace_escapes("{{x}}")).to_equal("{{x}}")
        expect(flat_bridge_decode_brace_escapes("a{{b}}}c")).to_equal("a{{b}}c")

    it "preserves interpolation payload content order and fallback":
        step("Warm fragment parser state and inspect returned expression order")
        val warm = parse_and_build_module("fn warm() -> i64:\n    1\n", "warm.spl")
        expect(warm.functions.contains("warm")).to_equal(true)
        val span = Span.empty()
        val left = "{"
        val right = "}"
        val ordered = flat_bridge_build_string_interps(
            left + "alpha" + right + "-" + left + "beta" + right, span)
        expect(ordered.len()).to_equal(2)
        var first_name = ""
        var second_name = ""
        match ordered[0].expr.kind:
            case Ident(name): first_name = name
            case _: ()
        match ordered[1].expr.kind:
            case Ident(name): second_name = name
            case _: ()
        expect(first_name).to_equal("alpha")
        expect(second_name).to_equal("beta")

        step("Keep braces inside one valid nested string expression region")
        val nested_value = left + " \"" + left + "\" + \"" + right + "\" " + right
        val nested = flat_bridge_build_string_interps(nested_value, span)
        expect(nested.len()).to_equal(1)
        var nested_is_binary = false
        match nested[0].expr.kind:
            case Binary(_, _, _): nested_is_binary = true
            case _: ()
        expect(nested_is_binary).to_equal(true)

        expect(flat_bridge_build_string_interps(
            left + "," + right, span).len()).to_equal(0)
        expect(flat_bridge_build_string_interps(
            left + "alpha", span).len()).to_equal(0)

        step("Literalize only the invalid region; a valid neighbour still interpolates")
        val mixed = "before " + left + "alpha" + right + " then " + left + " color: red; " + right
        val (mixed_text, mixed_interps) = flat_bridge_build_string_regions(mixed, span)
        expect(mixed_interps.len()).to_equal(1)
        expect(mixed_text).to_equal(
            "before " + left + "alpha" + right + " then " + left + left + " color: red; " + right + right)

    it "keeps ordinary literals unchanged with no interpolations":
        step("A literal without braces passes through both scanners untouched")
        val span = Span.empty()
        val plain = "ordinary text, with punctuation: 1 + 2 = 3"
        val (plain_text, plain_interps) = flat_bridge_build_string_regions(plain, span)
        expect(plain_text).to_equal(plain)
        expect(plain_interps.len()).to_equal(0)
        expect(flat_bridge_decode_brace_escapes(plain)).to_equal(plain)

        step("A literal with only escaped braces decodes but never interpolates")
        val left = "{"
        val right = "}"
        val escaped = left + left + "x" + right + right
        expect(flat_bridge_build_string_interps(escaped, span).len()).to_equal(0)
        expect(flat_bridge_decode_brace_escapes(left + left + right + right)).to_equal(left + right)

    it "handles long inputs in one pass with exact output":
        step("Decode many escape pairs and scan many interpolation regions")
        val span = Span.empty()
        val left = "{"
        val right = "}"
        var escape_parts: [text] = []
        var region_parts: [text] = []
        var single_parts: [text] = []
        var i = 0
        while i < 400:
            escape_parts.push(left + left)
            single_parts.push(left)
            region_parts.push(left + "v" + right + "-")
            i = i + 1
        val escapes = escape_parts.join("")
        val decoded = flat_bridge_decode_brace_escapes(escapes)
        expect(decoded).to_equal(single_parts.join(""))
        val (region_text, region_interps) = flat_bridge_build_string_regions(region_parts.join(""), span)
        expect(region_interps.len()).to_equal(400)
        expect(region_text).to_equal(region_parts.join(""))
