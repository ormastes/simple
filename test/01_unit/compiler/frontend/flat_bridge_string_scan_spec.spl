"""
## Purpose
Prove flat-AST string conversion preserves brace semantics, including on
long inputs.
"""

use compiler.common.diagnostics.span.{Span}
use compiler.frontend.flat_ast_bridge.{
    flat_bridge_build_string_interps, flat_bridge_build_string_regions,
    flat_bridge_decode_brace_escapes, parse_and_build_module}
use compiler.frontend.parser_types_expr.{ExprKind}
use compiler.frontend.parser_types.{StmtKind}
use std.string_core.{char_from_code}
use std.spec.step
use compiler.frontend.flat_ast_bridge.{
    flat_bridge_build_string_interps, flat_bridge_decode_brace_escapes,
    parse_and_build_module}
use std.io_runtime.file_read


fn bridged_string_value(value: text) -> text:
    val source = "fn probe():\n    \"" + value + "\"\n"
    val parsed = parse_and_build_module(source, "literal_brace_probe.spl")
    val function = parsed.functions["probe"] ?? panic("missing probe")
    for statement in function.body.stmts:
        match statement.kind:
            case StmtKind.Expr(expression):
                match expression.kind:
                    case ExprKind.StringLit(decoded, _): return decoded
                    case _: panic("expected string literal")
            case _: ()
    panic("missing string expression")

describe "flat bridge string scan":
    it "decodes doubled braces exactly and preserves unmatched text":
        step("Pin empty ordinary escaped mixed and unmatched values")
        expect(flat_bridge_decode_brace_escapes("")).to_equal("")
        expect(flat_bridge_decode_brace_escapes("ordinary")).to_equal("ordinary")
        expect(flat_bridge_decode_brace_escapes("{{")).to_equal("{")
        expect(flat_bridge_decode_brace_escapes("}}")).to_equal("}")
        expect(flat_bridge_decode_brace_escapes("a{{b}}c")).to_equal("a{{b}}c")
        expect(flat_bridge_decode_brace_escapes("{{{{")).to_equal("{{")
        expect(flat_bridge_decode_brace_escapes("{{{")).to_equal("{{")
        expect(flat_bridge_decode_brace_escapes("}}}")).to_equal("}}")
        expect(flat_bridge_decode_brace_escapes("{")).to_equal("{")
        expect(flat_bridge_decode_brace_escapes("}")).to_equal("}")
        expect(flat_bridge_decode_brace_escapes("}{")).to_equal("}{")
        expect(flat_bridge_decode_brace_escapes("{{x}}")).to_equal("{{x}}")
        expect(flat_bridge_decode_brace_escapes("a{{b}}}c")).to_equal("a{{b}}c")

    it "preserves interpolation payload content order and fallback":
        step("Warm fragment parser state and inspect returned expression order")
        val warm = parse_and_build_module("fn warm() -> i64:\n    1\n", "warm.spl")
        expect(warm.functions.contains("warm")).to_equal(true)
        val span = Span.empty()
        val left = "{"
        val right = "}"
        val ordered = flat_bridge_build_string_interps(
            left + "alpha" + right + "-" + left + "beta" + right, span)
        expect(ordered.len()).to_equal(2)
        var first_name = ""
        var second_name = ""
        match ordered[0].expr.kind:
            case Ident(name): first_name = name
            case _: ()
        match ordered[1].expr.kind:
            case Ident(name): second_name = name
            case _: ()
        expect(first_name).to_equal("alpha")
        expect(second_name).to_equal("beta")

        step("Keep braces inside one valid nested string expression region")
        val nested_value = left + " \"" + left + "\" + \"" + right + "\" " + right
        val nested = flat_bridge_build_string_interps(nested_value, span)
        expect(nested.len()).to_equal(1)
        var nested_is_binary = false
        match nested[0].expr.kind:
            case Binary(_, _, _): nested_is_binary = true
            case _: ()
        expect(nested_is_binary).to_equal(true)

        expect(flat_bridge_build_string_interps(
            left + "," + right, span).len()).to_equal(0)
        expect(flat_bridge_build_string_interps(
            left + "alpha", span).len()).to_equal(0)

        step("Literalize only the invalid region; a valid neighbour still interpolates")
        val mixed = "before " + left + "alpha" + right + " then " + left + " color: red; " + right
        val (mixed_text, mixed_interps) = flat_bridge_build_string_regions(mixed, span)
        expect(mixed_interps.len()).to_equal(1)
        expect(mixed_text).to_equal(
            "before " + left + "alpha" + right + " then " + left + left + " color: red; " + right + right)

    it "keeps ordinary literals unchanged with no interpolations":
        step("A literal without braces passes through both scanners untouched")
        val span = Span.empty()
        val plain = "ordinary text, with punctuation: 1 + 2 = 3"
        val (plain_text, plain_interps) = flat_bridge_build_string_regions(plain, span)
        expect(plain_text).to_equal(plain)
        expect(plain_interps.len()).to_equal(0)
        expect(flat_bridge_decode_brace_escapes(plain)).to_equal(plain)

        step("A literal with only escaped braces decodes but never interpolates")
        val left = "{"
        val right = "}"
        val escaped = left + left + "x" + right + right
        expect(flat_bridge_build_string_interps(escaped, span).len()).to_equal(0)
        expect(flat_bridge_decode_brace_escapes(left + left + right + right)).to_equal(left + right)

    it "keeps long inputs exact":
        step("Decode many escape pairs and scan many interpolation regions")
        val warm = parse_and_build_module("fn warm_long() -> i64:\n    1\n", "warm_long.spl")
        expect(warm.functions.contains("warm_long")).to_equal(true)
        val span = Span.empty()
        val left = "{"
        val right = "}"
        var escape_parts: [text] = []
        var region_parts: [text] = []
        var single_parts: [text] = []
        var i = 0
        while i < 400:
            escape_parts.push(left + left)
            single_parts.push(left)
            region_parts.push(left + "v" + right + "-")
            i = i + 1
        val escapes = escape_parts.join("")
        val decoded = flat_bridge_decode_brace_escapes(escapes)
        expect(decoded).to_equal(single_parts.join(""))
        val (region_text, region_interps) = flat_bridge_build_string_regions(region_parts.join(""), span)
        expect(region_interps.len()).to_equal(400)
        expect(region_text).to_equal(region_parts.join(""))

    it "preserves nested invalid expression regions through actual string conversion":
        step("Inspect converted literal bytes with an independently constructed oracle")
        val left = char_from_code(123)
        val right = char_from_code(125)
        val nested = left + "spec: " + left + "maximumJournalEvents: 10000" + right + right
        val converted = bridged_string_value(nested)
        expect(converted).to_equal(nested)
        expect(converted.len()).to_equal(37)
        expect(converted.byte_at(35)).to_equal(125)
        expect(converted.byte_at(36)).to_equal(125)

    it "still decodes intentional doubled escapes during actual string conversion":
        val left = char_from_code(123)
        val right = char_from_code(125)
        expect(bridged_string_value(left + left + "literal" + right + right)).to_equal(
            left + "literal" + right)

    it "assembles interpolation and decoded content with bounded joins":
        step("Reject growing immutable prefixes in both bridge scanners")
        val source = file_read(
            "src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl")
        val build = source.slice(
            source.index_of("fn flat_bridge_build_string_interps("),
            source.index_of("fn flat_bridge_decode_brace_escapes("))
        val decode = source.slice(
            source.index_of("fn flat_bridge_decode_brace_escapes("),
            source.index_of("fn convert_flat_expr(idx: i64)"))
        expect(build.split("value.substring(region_start + 1, i)").len()).to_equal(2)
        expect(build).to_not_contain("inner_parts")
        expect(build).to_not_contain("inner = inner +")
        expect(decode.split("parts.join(\"\")").len()).to_equal(2)
        expect(decode).to_not_contain("result = result +")

    it "keeps ordinary literals on the allocation-free fast path":
        step("Pin no-brace identity and selective decoder admission")
        val source = file_read(
            "src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl")
        val convert_start = source.index_of("fn convert_flat_expr(idx: i64)")
        val string_start = source.index_of("if tag == EXPR_STRING_LIT:", convert_start)
        val string_end = source.index_of("if tag == EXPR_BOOL_LIT:", string_start)
        val body = source.slice(string_start, string_end)
        expect(body).to_contain(
            "if not str_val.contains(\"{\") and not str_val.contains(\"}\"):")
        expect(body).to_contain(
            "if not str_val.contains(\"{{\") and not str_val.contains(\"}}\"):")
        expect(body.index_of("if not str_val.contains(\"{\")")).to_be_less_than(
            body.index_of("flat_bridge_build_string_interps(str_val, span)"))
        expect(body.index_of("if str_interps.len() > 0:")).to_be_less_than(
            body.index_of("if not str_val.contains(\"{{\")"))
        expect(body.index_of("if not str_val.contains(\"{{\")")).to_be_less_than(
            body.index_of("flat_bridge_decode_brace_escapes(str_val)"))
