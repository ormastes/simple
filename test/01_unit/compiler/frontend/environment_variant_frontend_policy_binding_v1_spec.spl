use std.spec.*
use std.io_runtime.file_read
use compiler.common.structural_contracts.environment_variant_policy_v1.*
use compiler.frontend.frontend_advisory_preprocess_port_v1.*

fn evfb_layer(prefer: text = "", require_value: text = ""
) -> EnvironmentVariantPolicyLayerV1:
    EnvironmentVariantPolicyLayerV1(parser_prefer: prefer,
        parser_require: require_value, host_cpu_max: "",
        frontend_offload: "", frontend_fallback: "")

fn evfb_decision(prefer: text = "", require_value: text = ""
) -> EnvironmentVariantPolicyDecisionInputV1:
    val empty = evfb_layer()
    environment_variant_policy_resolve_v1(EnvironmentVariantPolicyInputsV1(
        cli: evfb_layer(prefer: prefer, require_value: require_value),
        env: empty, project: empty, user: empty,
        admin: environment_variant_admin_restrictions_empty_v1())).unwrap()

describe "environment variant frontend policy binding V1":
    it "maps the typed resolved policy without reconstructing source precedence":
        expect(frontend_advisory_policy_from_environment_decision_v1(
            evfb_decision())).to_equal(FrontendAdvisoryPreprocessPolicyV1.Reference)
        expect(frontend_advisory_policy_from_environment_decision_v1(
            evfb_decision(prefer: "simd"))).to_equal(
                FrontendAdvisoryPreprocessPolicyV1.PreferSimd)
        expect(frontend_advisory_policy_from_environment_decision_v1(
            evfb_decision(require_value: "simd"))).to_equal(
                FrontendAdvisoryPreprocessPolicyV1.RequireSimd)
        expect(frontend_advisory_policy_from_environment_decision_v1(
            evfb_decision(require_value: "scalar"))).to_equal(
                FrontendAdvisoryPreprocessPolicyV1.Reference)

    it "passes the driver-owned typed policy to every production parse site":
        val source = file_read(
            "src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        expect(source).not.to_contain("FrontendAdvisoryPreprocessPolicyV1.Reference")
        expect(source).to_contain("parse_full_frontend_with_advisory_policy_v1(")
        expect(source).to_contain("self.ctx.frontend_advisory_policy")

    it "pins the selected generation across each owner-internal provider attempt":
        val source = file_read(
            "src/compiler/99.loader/environment_variant_startup_binding_v1.spl")
        val acquire = source.index_of(
            "environment_variant_sealed_build_use_acquire_v1(")
        val invoke = source.index_of(
            "_environment_variant_frontend_invoke_authenticated_provider_v1(", acquire)
        val release = source.index_of(
            "environment_variant_sealed_build_use_release_v1(", invoke)
        expect(acquire).to_be_greater_than(0)
        expect(invoke).to_be_greater_than(acquire)
        expect(release).to_be_greater_than(invoke)
        expect(source).not.to_contain("source_factory: fn(text,")
        expect(source).not.to_contain("record.source_factory(")
        expect(source).not.to_contain(
            "pub fn environment_variant_frontend_provider_adapter_register")
        expect(source).to_contain(
            "adapter.interface_handle == build.interface_handle")
        expect(source).to_contain(
            "adapter.provider_context == build.provider_context")
        expect(source).to_contain(
            "frontend-provider-callable-authority-unavailable")
        expect(source).to_contain("FrontendLexicalAdvisoryFactoryTokenV1")
        expect(source).to_contain("environment_variant_frontend_factory_invoke_v1(")
        expect(source).to_contain("root_artifact_authenticated")
        expect(source).to_contain("binding_policy_digest")
        expect(source).not.to_contain("session: ParserStructuralPackageV2SessionV1")

    it "treats numeric scope coordinates as correlation only":
        val generation = frontend_advisory_preprocess_generation_v1() + 1u64
        expect(frontend_advisory_preprocess_correlation_open_v1(
            101u64, 201u64, generation)).to_equal(true)
        expect(frontend_advisory_preprocess_dispatch_checked_scoped_v1(
            "fn main(): pass", FrontendAdvisoryPreprocessPolicyV1.RequireSimd,
            101u64, 202u64, generation)).to_equal(
                Err(FrontendAdvisoryPreprocessDispatchErrorV1.RequiredProviderUnavailable))
        expect(frontend_advisory_preprocess_dispatch_checked_scoped_v1(
            "fn main(): pass", FrontendAdvisoryPreprocessPolicyV1.RequireSimd,
            101u64, 201u64, generation)).to_equal(
                Err(FrontendAdvisoryPreprocessDispatchErrorV1.RequiredProviderUnavailable))
        expect(frontend_advisory_preprocess_correlation_close_v1(
            101u64, 201u64, generation + 1u64)).to_equal(true)

    it "rejects self-issued execution status until typed authority exists":
        expect(frontend_advisory_preprocess_result_issue_v1(
            "fn main(): pass", FrontendAdvisoryPreprocessPolicyV1.RequireSimd,
            FrontendAdvisoryPreprocessStatusV1.AdvisoryExecuted,
            true, true)).to_equal(
                Err(FrontendAdvisoryPreprocessIssueErrorV1.InvalidStatus))
        val source = file_read(
            "src/compiler/10.frontend/frontend_advisory_preprocess_port_v1.spl")
        expect(source).not.to_contain(
            "pub fn frontend_advisory_preprocess_bind_scoped_v1(")
        expect(source).not.to_contain(
            "provider: fn(text, FrontendAdvisoryPreprocessPolicyV1)")
        val valid_at = source.index_of(
            "pub fn frontend_advisory_preprocess_result_valid_v1")
        val reject_at = source.index_of(
            "status == FrontendAdvisoryPreprocessStatusV1.AdvisoryExecuted", valid_at)
        val digest_at = source.index_of("_receipt_identity_fap(", valid_at)
        expect(reject_at).to_be_greater_than(valid_at)
        expect(digest_at).to_be_greater_than(reject_at)

    it "threads scoped authority and startup cache identity through every parse":
        val source = file_read(
            "src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        expect(source).to_contain("self.ctx.environment_variant_frontend_owner_id")
        expect(source).to_contain("self.ctx.environment_variant_frontend_session_id")
        expect(source).to_contain("self.ctx.environment_variant_frontend_generation")
        expect(source).to_contain("self.ctx.environment_variant_frontend_cache_identity")
        val frontend = file_read("src/compiler/10.frontend/frontend.spl")
        expect(frontend).to_contain("frontend-advisory-cache-v1|")
        expect(frontend).to_contain("advisory_cache_identity")
