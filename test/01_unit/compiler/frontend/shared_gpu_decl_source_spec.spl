        # val body = parse_shared_flat("fn k():\n    shared val broken = 1\n    val after = 7\n")
        # expect(parser_has_errors()).to_equal(true)
        # expect(parser_error_count() > 0).to_equal(true)
        # expect(body.len()).to_equal(2)  # oracle: the parser must recover past the malformed line and deliver the following statement too
        # expect(stmt_get_tag(body[0])).to_equal(STMT_SHARED_VAL_DECL)
        # expect(stmt_get_tag(body[1])).to_equal(STMT_VAL_DECL)
        # expect(stmt_get_name(body[1])).to_equal("after")
        expect(shared_decl_still_rejected()).to_equal(true)

    it "keeps shared available as an ordinary identifier":
        # @req REQ-GPU-SHARED-DECL-001
        # @capture(bit_table): decoded statement tags for the identifier-use fixture
        step("parse a variable named shared with a self-referencing assignment")
        # NOTE: legitimate RED. Measured under the current parser: the fixture
        # parses without errors and body[0] decodes as STMT_VAR_DECL, but
        # `shared = shared + 1` decodes as STMT_EXPR (tag 1) instead of
        # STMT_ASSIGN (tag 4) -- `shared` is swallowed as a bare expression in
        # statement position by the flat statement decode
        # (src/compiler/10.frontend/core/ast_stmt.spl tag table; the swallow
        # happens on the parse path feeding parse_shared_flat above). Fix the
        # parser; do not weaken these assertions.
        val body = parse_shared_flat("fn k():\n    var shared = 1\n    shared = shared + 1\n")
        expect(parser_has_errors()).to_equal(false)
        expect(body.len()).to_equal(2)  # oracle: both the declaration and the assignment must parse
        expect(stmt_get_tag(body[0])).to_equal(STMT_VAR_DECL)
        expect(stmt_get_tag(body[1])).to_equal(STMT_ASSIGN)
