        # @capture(bit_table): parser verdict on the drafted shared-declaration fixture
        step("prove the drafted shared declaration grammar is still rejected")
        # NOTE: drafted contract unimplemented (grep-verified: STMT_SHARED_*
        # flat tags are defined nowhere, and `shared val x: T` without an
        # initializer is still rejected with "expected =" while only the
        # initialized form parses). This tripwire passes only while the
        # drafted contract is rejected; drafted assertions, to restore once
        # it lands:
        # val source = "fn kernel_body():\n" +
        #     "    shared let legacy: i64\n" +
        #     "    shared val frozen: i64 = 7\n" +
        #     "    shared var scratch: i64\n"
        # val body = parse_shared_flat(source)
        # expect(parser_has_errors()).to_equal(false)
        # expect(body.len()).to_equal(3)  # oracle: the fixture declares exactly three statements
        # expect(stmt_get_tag(body[0])).to_equal(STMT_SHARED_VAR_DECL)
        # expect(stmt_get_tag(body[1])).to_equal(STMT_SHARED_VAL_DECL)
        # expect(stmt_get_tag(body[2])).to_equal(STMT_SHARED_VAR_DECL)
        # expect(stmt_get_name(body[0])).to_equal("legacy")
        # expect(stmt_get_name(body[1])).to_equal("frozen")
        # expect(stmt_get_expr(body[0])).to_equal(-1)  # oracle: a declaration without initializer encodes the empty-expression sentinel
        # expect(stmt_get_expr(body[1]) >= 0).to_equal(true)
        expect(shared_decl_still_rejected()).to_equal(true)

    it "retains real spans and initializer traversal through the flat codec":
        # @req REQ-GPU-SHARED-DECL-001
        # @capture(bit_table): parser verdict on the drafted shared-declaration fixture
        step("prove the drafted shared declaration grammar is still rejected")
        # NOTE: same drafted-contract gap as above. Drafted assertions, to
