        # expect(span_start(span)).to_equal(12)  # oracle: the statement starts at column 4 of line 2, i.e. flat offset 12 in the fixture
        # expect(span_end(span) > span_start(span)).to_equal(true)
        # val children = flat_stmt_child_exprs(shared)
        # expect(children.len()).to_equal(1)  # oracle: one initializer expression hangs off the declaration
        # expect(children[0]).to_equal(stmt_get_expr(shared))
        # val blob = flat_stmt_pools_dump()
        # stmt_reset()
