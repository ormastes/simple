    it "synchronizes malformed declarations and parses the following statement":
        # @req REQ-GPU-SHARED-DECL-001
        # @capture(bit_table): parser verdict on the drafted shared-declaration fixture
        step("prove the drafted shared declaration grammar is still rejected")
        # NOTE: same drafted-grammar absence as above; error synchronization
        # across a malformed `shared val` cannot be observed until the
