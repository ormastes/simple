use std.spec.{describe, it, expect}
use compiler.frontend.core._ParserDecls.fn_struct_decls.{fn_struct_generic_constraint_state_take, fn_struct_generic_constraint_state_install}

describe "FnStructGenericConstraintState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = fn_struct_generic_constraint_state_take()
        val fresh = fn_struct_generic_constraint_state_take()
        expect(fresh.file_generic_constraints.len()).to_equal(0)
        fn_struct_generic_constraint_state_install(a)
        val again = fn_struct_generic_constraint_state_take()
        expect(again.file_generic_constraints.len()).to_equal(a.file_generic_constraints.len())
        fn_struct_generic_constraint_state_install(again)
