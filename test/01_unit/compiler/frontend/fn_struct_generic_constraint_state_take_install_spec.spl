use std.spec.{describe, it, expect}
use compiler.frontend.core._ParserDecls.fn_struct_decls.{fn_struct_generic_constraint_state_take, fn_struct_generic_constraint_state_install, parser_record_file_generic_constraint}

describe "FnStructGenericConstraintState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = fn_struct_generic_constraint_state_take()
        val fresh = fn_struct_generic_constraint_state_take()
        expect(fresh.file_generic_constraints.len()).to_equal(0)
        fn_struct_generic_constraint_state_install(a)
        val again = fn_struct_generic_constraint_state_take()
        expect(again.file_generic_constraints.len()).to_equal(a.file_generic_constraints.len())
        fn_struct_generic_constraint_state_install(again)

    it "records a file generic constraint into the owning module's state":
        # parser_decls_use.spl records `val generic T limits [...]` through
        # this owner API instead of writing the private dictionaries by import
        # (stage2 run 15: imported non-public module static).
        val saved = fn_struct_generic_constraint_state_take()
        parser_record_file_generic_constraint("T", ["f32", "i32"], "limit")
        val recorded = fn_struct_generic_constraint_state_take()
        expect(recorded.file_generic_constraints.len()).to_equal(1)
        expect(recorded.file_generic_constraints["T"].len()).to_equal(2)
        expect(recorded.file_generic_constraint_modes["T"]).to_equal("limit")
        fn_struct_generic_constraint_state_install(saved)
