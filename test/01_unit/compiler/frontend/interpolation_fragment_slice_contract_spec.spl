"""
Interpolation fragment slice/copy contract.

Completed brace regions must be materialized once from their recorded source
bounds. Growing a fragment one character at a time is quadratic and allocates
one substring plus one accumulator copy per character.
"""

use std.spec.*
use std.io_runtime.{file_read}
use compiler.core.ast.{ast_reset}
use compiler.frontend.core.string_interpolation_expand.{parse_string_interpolation_parts}

val OB: text = "{"
val CB: text = "}"

fn parts_for(inner: text) -> [i64]:
    ast_reset()
    parse_string_interpolation_parts("prefix " + OB + inner + CB + " suffix")

describe "interpolation fragment bounded slicing":
    it "keeps one ordinary region as one parsed expression":
        expect(parts_for("a + b").len()).to_equal(1)

    it "keeps multiple completed regions in source order":
        ast_reset()
        val value = "x " + OB + "a" + CB + " y " + OB + "b + c" + CB
        expect(parse_string_interpolation_parts(value).len()).to_equal(2)

    it "keeps nested braces inside one completed region":
        expect(parts_for("pick(" + OB + "1: 2" + CB + ")").len()).to_equal(1)

    it "still fails closed for an unmatched region":
        ast_reset()
        expect(parse_string_interpolation_parts("prefix " + OB + "a + b").len()).to_equal(0)

    it "materializes each completed fragment once without accumulator growth":
        val source = file_read("src/compiler/10.frontend/core/string_interpolation_expand.spl")
        val begin = source.index_of("fn parse_string_interpolation_parts")
        val finish = source.index_of("fn expand_interpolated_placeholder_call_args")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body.count("value.substring(inner_start, i)")).to_equal(1)
        expect(body.count("inner = inner + ch")).to_equal(0)
        expect(body.count("var inner = \"\"")).to_equal(0)
