# @req REQ-FLAT-POOL-TRUNCATION-001
# A failed pool read must not publish fabricated scalars or partial lists.
use std.spec
use std.spec.step
use compiler.frontend.core.flat_pool_codec.*

describe "flat pool truncation publication":
    it "stops i64 at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n7")
        val decoded = flat_pool_dec_i64(reader)
        expect(decoded).to_equal([])
        expect(reader.ok).to_equal(false)

    it "stops i64_into at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n7")
        val decoded = flat_pool_dec_i64_into([99], reader)
        expect(decoded).to_equal([])
        expect(reader.ok).to_equal(false)

    it "stops bool at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1")
        val decoded = flat_pool_dec_bool(reader)
        expect(decoded).to_equal([])
        expect(reader.ok).to_equal(false)

    it "stops bool_into at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1")
        val decoded = flat_pool_dec_bool_into([false], reader)
        expect(decoded).to_equal([])
        expect(reader.ok).to_equal(false)

    it "stops text at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\nalpha")
        val decoded = flat_pool_dec_text(reader)
        expect(decoded).to_equal([])
        expect(reader.ok).to_equal(false)

    it "stops text_into at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\nalpha")
        val decoded = flat_pool_dec_text_into(["old"], reader)
        expect(decoded).to_equal([])
        expect(reader.ok).to_equal(false)

    it "stops i64_list at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1\n7\n5\n")
        val decoded = flat_pool_dec_i64_list(reader)
        expect(decoded).to_equal([[7]])
        expect(reader.ok).to_equal(false)

    it "stops i64_list_into at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1\n7\n5\n")
        val decoded = flat_pool_dec_i64_list_into([[99]], reader)
        expect(decoded).to_equal([[7]])
        expect(reader.ok).to_equal(false)

    it "stops text_list at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1\nalpha\n5\n")
        val decoded = flat_pool_dec_text_list(reader)
        expect(decoded).to_equal([["alpha"]])
        expect(reader.ok).to_equal(false)

    it "stops text_list_into at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1\nalpha\n5\n")
        val decoded = flat_pool_dec_text_list_into([["old"]], reader)
        expect(decoded).to_equal([["alpha"]])
        expect(reader.ok).to_equal(false)

    it "stops text_list_list at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1\n1\nalpha\n1\n5\n")
        val decoded = flat_pool_dec_text_list_list(reader)
        expect(decoded).to_equal([[["alpha"]]])
        expect(reader.ok).to_equal(false)

    it "stops text_list_list_into at the first failed read":
        step("Decode a valid prefix followed by a truncated entry")
        val reader = FlatPoolReader.new("2\n1\n1\nalpha\n1\n5\n")
        val decoded = flat_pool_dec_text_list_list_into([[["old"]]], reader)
        expect(decoded).to_equal([[["alpha"]]])
        expect(reader.ok).to_equal(false)

    it "keeps complete nested lists and empty lists":
        step("Decode the complete boundary control")
        val reader = FlatPoolReader.new("2\n1\n7\n0\n")
        expect(flat_pool_dec_i64_list(reader)).to_equal([[7], []])
        expect(reader.ok).to_equal(true)
