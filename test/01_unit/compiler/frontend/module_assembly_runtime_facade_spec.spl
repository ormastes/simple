"""
# Flat AST Module Assembly Runtime Facade Contract

The parser bridge routes environment reads and writes through the canonical
no-GC runtime facade while retaining its cached gates and scoped lexer-state
save/restore behavior.
"""

use std.io_runtime.{read_file_text}
use std.spec.*

describe "flat AST module assembly runtime facade ownership":
    it "routes environment access through one canonical facade pair":
        step("Load the flat AST module assembly source")
        val source = read_file_text("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")

        step("Require the no-GC facade and the thin inline adapters")
        expect(source).to_contain("use std.nogc_sync_mut.io_runtime.{env_get_opt, env_set}")
        expect(source).to_contain("fn _sffi_env_get(key: text) -> text?:\n    env_get_opt(key)")
        expect(source).to_contain("fn _sffi_env_set(key: text, value: text) -> bool:\n    env_set(key, value)")

        step("Reject duplicate raw environment ownership")
        expect(source).to_not_contain("extern fn rt_env_get")
        expect(source).to_not_contain("extern fn rt_env_set")
        expect(source).to_not_contain("rt_env_get(")
        expect(source).to_not_contain("rt_env_set(")

        step("Pin the adapter definitions plus every intended call site")
        # Pin refreshed 2026-11-05: call-site count grew 8 -> 14 (get) and
        # 7 -> 8 (set) from intentional refactors, all still routed through
        # the same facade pair:
        #   88aac2ffe28 (rebase transplant) added the SIMPLE_LEX_PHASE_PROFILE
        #     and SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE cached gates,
        #   a4cb095fc8b/d9127debbaf added the env-gated SIMPLE_CAPTURE_TRACE
        #     arm/take/dump-gate reads,
        #   e27c0c6630b added the dangling-text poisoned-refusal restore arm.
        # Counts include the one `fn _sffi_env_get(`/`fn _sffi_env_set(`
        # adapter definition each.
        expect(source.split("_sffi_env_get(").len()).to_equal(15)
        expect(source.split("_sffi_env_set(").len()).to_equal(10)

    it "preserves gates and scoped lexer environment restoration":
        step("Load the flat AST module assembly source")
        val source = read_file_text("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")

        step("Pin both cached opt-in gates")
        expect(source).to_contain("_sffi_env_get(\"SIMPLE_PARSE_PHASE_PROFILE\") ?? \"\"")
        expect(source).to_contain("_sffi_env_get(\"SIMPLE_FLAT_POOL_ROUNDTRIP\") ?? \"\"")

        step("Pin lexer state capture and restoration order")
        expect(source).to_contain("val saved_lex_source = _sffi_env_get(\"SIMPLE_BOOTSTRAP_LEX_SOURCE\") ?? \"\"\n    val saved_lex_path = _sffi_env_get(\"SIMPLE_BOOTSTRAP_LEX_PATH\") ?? \"\"")
        expect(source).to_contain("_sffi_env_set(\n            \"SIMPLE_BOOTSTRAP_LEX_SOURCE\", saved_lex_source)\n        val path_restored = _sffi_env_set(\n            \"SIMPLE_BOOTSTRAP_LEX_PATH\", saved_lex_path)")
        # Pin refreshed 2026-11-05: braces escaped (\{path\}) so the spec
        # string carries the literal source text; same escaped-brace class as
        # ca61588c2b3 (see 4aeccb46899 spec-pin refresh note).
        expect(source).to_contain("if not _sffi_env_set(\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", saved_lex_source):\n            panic(\"failed to restore SIMPLE_BOOTSTRAP_LEX_SOURCE for \{path\}\")\n        if not _sffi_env_set(\"SIMPLE_BOOTSTRAP_LEX_PATH\", saved_lex_path):")

    it "bounds environment work in blob-hit failure and success paths":
        step("Isolate the cache-hit build function")
        val source = read_file_text("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")
        val blob_parts = source.split("pub fn build_module_from_flat_pool_blob")
        expect(blob_parts.len()).to_equal(2)
        val blob_body = blob_parts[1].split("pub fn parse_and_build_module_scoped(source:")[0]

        step("Capture each lexer environment value exactly once")
        expect(blob_body.split("_sffi_env_get(\"SIMPLE_BOOTSTRAP_LEX_SOURCE\")").len()).to_equal(2)
        expect(blob_body.split("_sffi_env_get(\"SIMPLE_BOOTSTRAP_LEX_PATH\")").len()).to_equal(2)
        expect(blob_body.split("_sffi_env_get(").len()).to_equal(3)

        step("Restore source then path exactly once on decode failure")
        # Pin refreshed 2026-11-05: the failure marker moved from
        # `if not flat_pools_restore_all(blob):` to `if not blob_usable:`
        # under 6a0bacef7e9 (.spab packed-view hit path); the restore-once
        # contract is unchanged.
        val failure_arm = blob_body.split("if not blob_usable:")[1].split("val _hp_t2")[0]
        expect(failure_arm.split("_sffi_env_set(").len()).to_equal(3)
        expect(failure_arm.split("\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", saved_lex_source").len()).to_equal(2)
        expect(failure_arm.split("\"SIMPLE_BOOTSTRAP_LEX_PATH\", saved_lex_path").len()).to_equal(2)

        step("Restore source then path exactly once after a successful build")
        # Pin refreshed 2026-11-05: the post-`val _hp_t2` region now also
        # contains the dangling-text poisoned-refusal arm added by e27c0c6630b,
        # so the success arm is bounded at that marker first.
        val success_arm = blob_body.split("val _hp_t2")[1].split("if flat_pool_capture_poisoned_v1():")[0]
        expect(success_arm.split("_sffi_env_set(").len()).to_equal(3)
        expect(success_arm.split("\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", saved_lex_source").len()).to_equal(2)
        expect(success_arm.split("\"SIMPLE_BOOTSTRAP_LEX_PATH\", saved_lex_path").len()).to_equal(2)

        step("Restore source then path exactly once on the poisoned-refusal path")
        # Pin added 2026-11-05: e27c0c6630b refuses cache hits whose restored
        # pool texts dangle; the refusal arm restores lexer state exactly once
        # before returning nil.
        val refusal_arm = blob_body.split("if flat_pool_capture_poisoned_v1():")[1]
        expect(refusal_arm.split("_sffi_env_set(").len()).to_equal(3)
        expect(refusal_arm.split("\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", saved_lex_source").len()).to_equal(2)
        expect(refusal_arm.split("\"SIMPLE_BOOTSTRAP_LEX_PATH\", saved_lex_path").len()).to_equal(2)

    it "bounds environment work in scoped parser paths":
        step("Isolate the scoped parser build function")
        val source = read_file_text("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")
        val scoped_parts = source.split("pub fn parse_and_build_module_scoped(source:")
        expect(scoped_parts.len()).to_equal(2)
        val scoped_body = scoped_parts[1].split("fn parse_and_build_module(")[0]

        step("Capture each lexer environment value exactly once")
        expect(scoped_body.split("_sffi_env_get(\"SIMPLE_BOOTSTRAP_LEX_SOURCE\")").len()).to_equal(2)
        expect(scoped_body.split("_sffi_env_get(\"SIMPLE_BOOTSTRAP_LEX_PATH\")").len()).to_equal(2)
        # Pin refreshed 2026-11-05: total get count 3 -> 5; a4cb095fc8b added
        # the two env-gated SIMPLE_CAPTURE_TRACE reads (dump-gate and
        # blob-built trace) inside the scoped build.
        expect(scoped_body.split("_sffi_env_get(").len()).to_equal(5)

        step("Keep the transient path free of environment restoration")
        val scoped_tail = scoped_body.split("            rt_transient_heap_promote(built_module)\n        if not module_promoted:")[1]
        val scoped_branches = scoped_tail.split("    else:\n")
        expect(scoped_branches.len()).to_equal(2)
        expect(scoped_branches[0].split("_sffi_env_set(").len()).to_equal(1)

        step("Restore source then path exactly once on the non-transient path")
        val restore_arm = scoped_branches[1].split("    frontend_compiler_trace_scope_exit")[0]
        expect(restore_arm.split("_sffi_env_set(").len()).to_equal(3)
        expect(restore_arm.split("\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", saved_lex_source").len()).to_equal(2)
        expect(restore_arm.split("\"SIMPLE_BOOTSTRAP_LEX_PATH\", saved_lex_path").len()).to_equal(2)

    it "retains unrelated low-level parser bridge owners":
        step("Load the flat AST module assembly source")
        val source = read_file_text("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")

        step("Pin the SFFI owners outside this migration")
        expect(source).to_contain("extern fn rt_time_now_unix_micros() -> i64")
        expect(source).to_contain("extern fn rt_transient_array_scope_begin() -> bool")
        expect(source).to_contain("extern fn rt_transient_array_scope_pause() -> bool")
        expect(source).to_contain("extern fn rt_transient_array_scope_end() -> bool")
        expect(source).to_contain("extern fn rt_transient_heap_promote<T>(value: T) -> bool")
