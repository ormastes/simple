use std.spec.{describe, it, expect}
use compiler.frontend.core._Ast.module_state.{lexer_state_get, lexer_state_set, ast_lexer_slot_state_take, ast_lexer_slot_state_install}

describe "AST lexer-slot ParseContext snapshot (stage 1)":
    it "take installs initial slots and install restores the snapshot":
        lexer_state_set("cur_text2", "alpha")
        val a = ast_lexer_slot_state_take()
        expect(lexer_state_get("cur_text2")).to_equal("")

        lexer_state_set("cur_text2", "beta")
        val b = ast_lexer_slot_state_take()

        ast_lexer_slot_state_install(a)
        expect(lexer_state_get("cur_text2")).to_equal("alpha")
        ast_lexer_slot_state_install(b)
        expect(lexer_state_get("cur_text2")).to_equal("beta")
        lexer_state_set("cur_text2", "")
