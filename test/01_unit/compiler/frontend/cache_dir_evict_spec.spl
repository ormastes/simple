"""
# Default cache existence + size-capped LRU eviction

**Category:** Infrastructure
**Brief:** doc/01_research/compiler/hardening/simple_hardening_plan_2026-08-21.md §27

Two defects, one spec.

1. `frontend_parse_cache_scope()` memoized a NEGATIVE result, so any process
   that parsed before the driver published `SIMPLE_FRONTEND_CACHE_SCOPE`
   latched the parse cache OFF for its whole lifetime — the cache dir default
   was never the problem, the scope gate was.
   (doc/08_tracking/bug/frontend_parse_cache_scope_memo_latches_off_2026-08-23.md)

2. Nothing ever bounded the flat entry caches. `build/bootstrap/native_cache/
   <lane>/{frontend,hir}` grew without limit across scopes forever.

Contract:
- a scope published AFTER a first (empty) read is still observed — no latch;
- `cache_dir_max_bytes()` defaults to 512 MiB and honours `SIMPLE_CACHE_MAX_BYTES`;
- eviction under the cap is a no-op;
- eviction over the cap removes least-recently-modified entries until under it;
- `*.tmp` in-flight stores and entries inside the grace window are NEVER
  evicted (crash safety: no live build's entry is pulled out from under it).

Pre-fix this spec fails: `compiler.frontend.cache_dir_evict` does not exist,
and the memo latch keeps the scope empty after a late publish.
"""

use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use std.io.{file_exists}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{
    dir_create_all,
    env_set,
    file_delete,
    file_write_exact,
    getpid
}
use compiler.frontend.cache_dir_evict.{
    CACHE_DEFAULT_MAX_BYTES, CACHE_EVICT_SWEEP_INTERVAL,
    CacheTreeEvictRequestV1,
    _CacheDirEvictPlan,
    cache_dir_max_bytes, cache_dir_evict_due, cache_dir_evict_to_cap,
    cache_dir_evict_tree_to_cap_v1, cache_dir_reap_stale_tmp_v1,
    cache_dir_evict_frontend_to_cap_v1,
    _cache_dir_evict_to_cap_at, _cache_dir_evict_frontend_to_cap_at
}
use compiler.frontend.frontend_parse_cache.{
    frontend_parse_cache_enabled,
    frontend_parse_cache_load,
    frontend_parse_cache_scope,
    frontend_parse_cache_store,
    frontend_parse_cache_store_unit_conflicts,
    frontend_parse_cache_load_unit_conflicts
}

val SCRATCH: text = "/tmp/simple-cache-evict-spec-{getpid()}"

fn write_entry(name: text, bytes: i64):
    var body = ""
    var i: i64 = 0
    while i < bytes:
        body = body + "x"
        i = i + 1
    val _w = file_write_exact(SCRATCH + "/" + name, body)

describe("cache dir default + eviction", fn():

    it("does not latch the frontend cache off when the scope is published late", fn():
        val _clear = env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "")
        assert_equal(frontend_parse_cache_scope(), "", "no scope published yet")
        assert_false(frontend_parse_cache_enabled(), "cache is off without a scope")
        val _set = env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "late-published-scope")
        assert_equal(frontend_parse_cache_scope(), "late-published-scope",
                     "a late publish must be observed, not shadowed by a memoized empty")
        assert_true(frontend_parse_cache_enabled(), "cache is on once a scope exists")
    )

    it("stores and reloads an exact cache payload through the canonical owner", fn():
        val _root = env_set("SIMPLE_FRONTEND_CACHE_DIR", SCRATCH)
        val _made = dir_create_all(SCRATCH)
        val key = "owner-roundtrip"
        assert_true(frontend_parse_cache_store(key, "payload", sha256_text("owner-roundtrip source")), "cache store succeeds")
        assert_equal(frontend_parse_cache_load(key, sha256_text("owner-roundtrip source")), "payload", "cache payload round-trips")
        val _clean = file_delete(SCRATCH + "/" + key + ".fpc")
    )

    it("defaults the cap to 512 MiB and honours SIMPLE_CACHE_MAX_BYTES", fn():
        val _c = env_set("SIMPLE_CACHE_MAX_BYTES", "")
        assert_equal(CACHE_DEFAULT_MAX_BYTES, 536870912, "default constant is 512 MiB")
        assert_equal(cache_dir_max_bytes(), CACHE_DEFAULT_MAX_BYTES, "default cap is 512 MiB")
        val _s = env_set("SIMPLE_CACHE_MAX_BYTES", "12345")
        assert_equal(cache_dir_max_bytes(), 12345, "env override wins")
        val _r = env_set("SIMPLE_CACHE_MAX_BYTES", "")
    )

    it("sweeps only on the interval", fn():
        assert_false(cache_dir_evict_due(0), "no sweep before any store")
        assert_false(cache_dir_evict_due(1), "no sweep on every store")
        assert_true(cache_dir_evict_due(CACHE_EVICT_SWEEP_INTERVAL), "sweep on the interval")
    )

    it("is a no-op under the cap and a no-op for a zero cap", fn():
        val _d = dir_create_all(SCRATCH)
        write_entry("a.fpc", 100)
        assert_equal(cache_dir_evict_to_cap(SCRATCH, ".fpc", 1000000), 0, "under the cap evicts nothing")
        assert_equal(cache_dir_evict_to_cap(SCRATCH, ".fpc", 0), 0, "a zero cap disables eviction")
        assert_true(file_exists(SCRATCH + "/a.fpc"), "entry survives")
    )

    it("never evicts an in-flight .tmp or a fresh entry", fn():
        val _d = dir_create_all(SCRATCH)
        write_entry("b.fpc.4242.tmp", 64)
        write_entry("c.fpc", 64)
        assert_true(file_exists(SCRATCH + "/b.fpc.4242.tmp"), "fixture tmp written")
        assert_true(file_exists(SCRATCH + "/c.fpc"), "fixture entry written")
        # Cap of 1 byte: everything eligible would go. Nothing is eligible,
        # because the .tmp has the wrong suffix and c.fpc is inside the grace
        # window -- this is the crash-safety guarantee.
        assert_equal(cache_dir_evict_to_cap(SCRATCH, ".fpc", 1), 0,
                     "a live build's entries are never evicted")
        assert_true(file_exists(SCRATCH + "/b.fpc.4242.tmp"), "in-flight store survives")
        assert_true(file_exists(SCRATCH + "/c.fpc"), "fresh entry survives")
    )

    it("reports a missing directory as nothing evicted", fn():
        assert_equal(cache_dir_evict_to_cap(SCRATCH + "/absent", ".fpc", 1), 0,
                     "a missing cache dir is not an error")
    )

    it("orders heap candidates by mtime then discovery order", fn():
        val plan = _CacheDirEvictPlan.empty()
        plan.account_entry("first-equal", 10, 100, 1000)
        plan.account_entry("oldest", 10, 50, 1000)
        plan.account_entry("second-equal", 10, 100, 1000)
        plan.prepare()

        assert_equal(plan.oldest_path(), "oldest", "lower mtime is evicted first")
        plan.pop_oldest()
        assert_equal(plan.oldest_path(), "first-equal",
                     "the first discovered equal-mtime entry wins the tie")
        plan.pop_oldest()
        assert_equal(plan.oldest_path(), "second-equal",
                     "the later equal-mtime entry remains second")
    )

    it("accounts protected bytes and admits the exact grace boundary", fn():
        val plan = _CacheDirEvictPlan.empty()
        plan.account_entry("future", 7, 1001, 1000)
        plan.account_entry("inside-grace", 11, 701, 1000)
        plan.account_entry("at-boundary", 13, 700, 1000)

        assert_equal(plan.total_bytes(), 31,
                     "fresh and future entries still count toward the directory cap")
        assert_equal(plan.candidate_count(), 1,
                     "only an entry at least 300 seconds old is eligible")
        plan.prepare()
        assert_equal(plan.oldest_path(), "at-boundary",
                     "the exact grace boundary is eligible, matching the original condition")
    )

    it("does not credit failed deletes and stops exactly at the cap", fn():
        val plan = _CacheDirEvictPlan.empty()
        plan.account_entry("delete-fails", 10, 10, 1000)
        plan.account_entry("delete-succeeds", 10, 20, 1000)
        plan.account_entry("protected", 10, 999, 1000)
        plan.prepare()

        assert_true(plan.over_cap(20), "30 accounted bytes exceed the 20-byte cap")
        val failed_size = plan.oldest_size()
        plan.pop_oldest()
        plan.record_delete(failed_size, false)
        assert_equal(plan.total_bytes(), 30, "a failed unlink frees no accounted bytes")
        assert_equal(plan.removed_count(), 0, "a failed unlink is not reported as removed")
        assert_true(plan.over_cap(20), "eviction continues after a failed unlink")

        val deleted_size = plan.oldest_size()
        plan.pop_oldest()
        plan.record_delete(deleted_size, true)
        assert_equal(plan.total_bytes(), 20, "a confirmed unlink subtracts its exact size")
        assert_equal(plan.removed_count(), 1, "only confirmed unlinks are counted")
        assert_false(plan.over_cap(20), "equality with the cap terminates eviction")
    )

    it("unlinks .spab.seal sidecar with evicted .spab and reaps aged orphan .seal in flat cache", fn():
        val flat_dir = SCRATCH + "/flat-spab"
        val _d = dir_create_all(flat_dir)
        val _w1 = file_write_exact(flat_dir + "/victim.spab", "012345678901234567890123456789")
        val _w2 = file_write_exact(flat_dir + "/victim.spab.seal", "0123456789")
        val _w3 = file_write_exact(flat_dir + "/orphan.spab.seal", "0123456789")
        # Future clock past grace window (now + 1 hour ~ year 2100 epoch bound safe)
        val removed = _cache_dir_evict_to_cap_at(flat_dir, ".spab", 10, 4102444800)
        assert_equal(removed, 1, "evicts primary .spab entry")
        assert_false(file_exists(flat_dir + "/victim.spab"), "evicted .spab removed")
        assert_false(file_exists(flat_dir + "/victim.spab.seal"), "evicted .spab.seal sidecar removed")
        assert_false(file_exists(flat_dir + "/orphan.spab.seal"), "aged orphan .spab.seal reaped")
    )

    it("evicts .spab + .seal sidecar and reaps aged orphan .seal across sharded subdirectories", fn():
        val tree_dir = SCRATCH + "/tree-spab/artifacts/v1/sha256"
        val _da = dir_create_all(tree_dir + "/aa")
        val _db = dir_create_all(tree_dir + "/bb")
        val _w1 = file_write_exact(tree_dir + "/aa/first.spab", "012345678901234567890123456789")
        val _w2 = file_write_exact(tree_dir + "/aa/first.spab.seal", "0123456789")
        val _w3 = file_write_exact(tree_dir + "/bb/orphan.spab.seal", "0123456789")
        val _w4 = file_write_exact(tree_dir + "/bb/inflight.spab.tmp", "0123456789")
        val summary = cache_dir_evict_tree_to_cap_v1(CacheTreeEvictRequestV1(
            root_dir: SCRATCH + "/tree-spab",
            suffix: ".spab",
            max_bytes: 5,
            now_override_secs: 4102444800))
        assert_equal(summary.removed, 1, "evicts sharded .spab entry")
        assert_equal(summary.remaining_bytes, 0, "accounts both .spab and .seal bytes")
        assert_false(file_exists(tree_dir + "/aa/first.spab"), "sharded .spab removed")
        assert_false(file_exists(tree_dir + "/aa/first.spab.seal"), "sharded .spab.seal sidecar removed")
        assert_false(file_exists(tree_dir + "/bb/orphan.spab.seal"), "sharded orphan .spab.seal reaped")
        assert_true(file_exists(tree_dir + "/bb/inflight.spab.tmp"), "in-flight .tmp never touched")
    )

    it("enforces a combined byte cap across flat .fpc and sharded .spab entries", fn():
        val fe_dir = SCRATCH + "/combined-fe"
        val spab_dir = fe_dir + "/artifacts/v1/xxh3/aa"
        val _d = dir_create_all(spab_dir)
        val _w1 = file_write_exact(fe_dir + "/old1.fpc", "01234567890123456789")
        val _w2 = file_write_exact(spab_dir + "/old2.spab", "01234567890123456789")
        val _w3 = file_write_exact(spab_dir + "/old2.spab.seal", "0123456789")
        val _w4 = file_write_exact(fe_dir + "/old1.u006", "conflict")
        val removed = _cache_dir_evict_frontend_to_cap_at(fe_dir, 25, 4102444800)
        assert_true(removed >= 1, "combined sweep evicts across .fpc and .spab")
        val rem = (if file_exists(fe_dir + "/old1.fpc"): 20 else: 0) + (if file_exists(spab_dir + "/old2.spab"): 30 else: 0)
        assert_true(rem <= 25, "remaining frontend bytes fit within shared cap")
        assert_true(file_exists(fe_dir + "/old1.u006"), "u006 preserved when artifacts/v1 exists")
    )

    it("cleans .u006 sidecars on pure .fpc eviction and deletes cleared .u006 files", fn():
        val fpc_only = SCRATCH + "/pure-fpc-u006"
        val _d = dir_create_all(fpc_only)
        val _w1 = file_write_exact(fpc_only + "/k1.fpc", "01234567890123456789")
        val _w2 = file_write_exact(fpc_only + "/k1.u006", "conflict")
        val _w3 = file_write_exact(fpc_only + "/orphan.u006", "stale")
        assert_equal(_cache_dir_evict_to_cap_at(fpc_only, ".fpc", 5, 4102444800), 1, "evicts k1.fpc")
        assert_false(file_exists(fpc_only + "/k1.u006"), "evicted .fpc removes .u006 sidecar")
        assert_false(file_exists(fpc_only + "/orphan.u006"), "aged orphan .u006 reaped")

        val _scope = env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "u006-delete-scope")
        val _root = env_set("SIMPLE_FRONTEND_CACHE_DIR", fpc_only)
        assert_true(frontend_parse_cache_store_unit_conflicts("k2", ["SPL-UNIT-006 test"]), "writes non-empty .u006")
        assert_true(file_exists(fpc_only + "/k2.u006"), "k2.u006 created")
        assert_true(frontend_parse_cache_store_unit_conflicts("k2", []), "clears .u006 on clean parse")
        assert_false(file_exists(fpc_only + "/k2.u006"), "empty .u006 file removed instead of zero-byte residue")
        assert_equal(frontend_parse_cache_load_unit_conflicts("k2").len(), 0, "cleared .u006 loads empty")
    )

    it("reaps aged .tmp files in sharded tree via cache_dir_reap_stale_tmp_v1", fn():
        val tree_dir = SCRATCH + "/reap-tree/artifacts/v1/xxh3/cc"
        val _d = dir_create_all(tree_dir)
        val _w1 = file_write_exact(tree_dir + "/crashed.spab.tmp", "partial")
        assert_equal(cache_dir_reap_stale_tmp_v1(SCRATCH + "/reap-tree"), 0, "fresh .tmp preserved on wall clock")
        assert_true(file_exists(tree_dir + "/crashed.spab.tmp"), "fresh .tmp survives")
        assert_equal(cache_dir_reap_stale_tmp_v1(SCRATCH + "/reap-tree", 4102444800), 1, "aged .tmp reaped")
        assert_false(file_exists(tree_dir + "/crashed.spab.tmp"), "aged .tmp deleted")
    )
)
