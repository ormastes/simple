"""
## Purpose and audience
Purpose: Prove that Parse Declarations.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

# # Parser Unit Tests
#
# **Feature ID:** #COMPILER-FRONTEND-003
# **Category:** Compiler | Frontend | Parser
# **Status:** Implemented

fn check(condition: bool):
    expect(condition).to_equal(true)

extern fn rt_file_read_text(path: text) -> text

fn parser_source(path: text) -> text:
    # Fail closed on a missing/empty file. `rt_file_read_text` yields nil for a
    # path that no longer exists, and the `?? ""` fallback then makes every
    # omission check below pass VACUOUSLY -- reading green forever while
    # guarding nothing. Requiring real content turns a renamed or deleted
    # source file red instead of silently retiring the guard.
    val source = rt_file_read_text(path) ?? ""
    expect(source.len() > 0).to_equal(true)
    source

fn expect_source_omits(path: text, pattern: text):
    val source = parser_source(path)
    expect(source.contains(pattern)).to_equal(false)

fn parser_if_elif_result(x: i64) -> text:
    var result = ""
    if x > 10:
        result = "big"
    elif x > 0:
        result = "small"
    else:
        result = "zero"
    result

trait ParserComparable<T>:
    fn compare(other: T) -> i64

struct ParserReverse<T>:
    inner: T

impl ParserComparable<ParserReverse<T>> for ParserReverse<T>:
    fn compare(other: ParserReverse<T>) -> i64:
        0

fn parser_i64_chunk_size(values: [i64]) -> i64:
    len(values)

fn parser_apply_chunk<T>(values: [T], processor: fn([T]) -> i64) -> i64:
    processor(values)

fn parser_apply_zero_arg(producer: fn() -> i64) -> i64:
    producer()

use std.spec.step

describe "Parse Declarations":
    it "parse generic trait implementation for a generic type":
        step("Verify: parse generic trait implementation for a generic type")
        # @req: REQ-COMPILER-FRONTEND-001
        val left = ParserReverse<i64>(inner: 1)
        val right = ParserReverse<i64>(inner: 2)
        expect(left.compare(right)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps the union keyword out of graph helper calls":
        step("Verify: keeps the union keyword out of graph helper calls")
        val graph_source = parser_source(
            "src/compiler_rust/lib/std/src/core/graph.spl")
        expect(graph_source).to_contain("fn union_components(")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/core/graph.spl", "fn union(")

    it "keeps block doc comments out of trait method slots":
        step("Verify: keeps block doc comments out of trait method slots")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/infra/parallel.spl",
            "trait ParIter<T>:\n    /**")

    it "parses a callable that accepts a generic list":
        step("Verify: parses a callable that accepts a generic list")
        expect(parser_apply_chunk([1, 2, 3], parser_i64_chunk_size)).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val parallel_source = parser_source(
            "src/compiler_rust/lib/std/src/infra/parallel.spl")
        expect(parallel_source).to_contain("processor: fn([T]) -> R")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/infra/parallel.spl", "fn(<T>)")

    it "keeps block doc comments out of synchronization member slots":
        step("Verify: keeps block doc comments out of synchronization member slots")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/infra/synchronization.spl",
            "    /**")

    it "keeps Python compiler implementation signatures terminated":
        step("Verify: keeps Python compiler implementation signatures terminated")
        val python_source = parser_source(
            "src/compiler_rust/lib/std/src/tooling/compiler/python.spl")
        expect(python_source).to_contain(
            "incremental: bool) -> CompilationResult:")
        expect(python_source).to_contain("fn get_language() -> Language:")
        expect(python_source).to_contain("fn supports_incremental() -> bool:")

    it "parses deployment tuple return signatures":
        step("Verify: parses deployment tuple return signatures")
        val deployment_source = parser_source(
            "src/compiler_rust/lib/std/src/tooling/deployment/automation.spl")
        expect(deployment_source).to_contain(
            "pub fn parse_platform(self) -> (text, text):")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/tooling/deployment/automation.spl",
            "parse_platform(self): (text, text):")

    it "keeps escaped quotes out of raw spec generator regexes":
        step("Verify: keeps escaped quotes out of raw spec generator regexes")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/tooling/spec_gen.spl",
            "captures(r\"context")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/tooling/spec_gen.spl",
            "captures(r\"it")

    it "keeps C-style braces out of testing filter loops":
        step("Verify: keeps C-style braces out of testing filter loops")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/tooling/testing/filter.spl",
            "return type_mod_path\n            }")

    it "parses canonical zero-argument lambdas":
        step("Verify: parses canonical zero-argument lambdas")
        expect(parser_apply_zero_arg(\: 42)).to_equal(42)  # oracle: 42 — named expected value from the requirement
        val parallel_source = parser_source(
            "src/compiler_rust/lib/std/src/tooling/testing/parallel.spl")
        expect(parallel_source).to_contain(
            "val work_fn = \\: runner(item.suite)")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/tooling/testing/parallel.spl", "||")

    it "keeps reserved actor out of parameter names":
        step("Verify: keeps reserved actor out of parameter names")
        val parallel_source = parser_source(
            "src/compiler_rust/lib/std/src/tooling/testing/parallel.spl")
        expect(parallel_source).to_contain(
            "fn _rt_actor_send(actor_handle: i64, message: Any)")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/tooling/testing/parallel.spl",
            "fn _rt_actor_send(actor:")

    it "parses tuple-destructuring header filter lambdas":
        step("Verify: parses tuple-destructuring header filter lambdas")
        val http_source = parser_source(
            "src/compiler_rust/lib/std/src/host/common/net/http.spl")
        expect(http_source).to_contain("filter(\\(n, _):")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/host/common/net/http.spl",
            "filter(|(n, _)|")

    it "converts interpolated HTTP header values explicitly":
        step("Verify: converts interpolated HTTP header values explicitly")
        val http_source = parser_source(
            "src/compiler_rust/lib/std/src/host/common/net/http.spl")
        expect(http_source).to_contain("HeaderValue.from_str(")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/host/common/net/http.spl", "}_hval")

    it "uses postfix filesystem staging varargs":
        step("Verify: uses postfix filesystem staging varargs")
        val nogc_file = parser_source(
            "src/compiler_rust/lib/std/src/host/async_nogc_mut/io/fs/file.spl")
        val nogc_process = parser_source(
            "src/compiler_rust/lib/std/src/host/async_nogc_mut/io/fs/process.spl")
        val gc_process = parser_source(
            "src/compiler_rust/lib/std/src/host/async_gc_mut/io/fs/process.spl")
        expect(nogc_file).to_contain("files: FilePath...")
        expect(nogc_process).to_contain("files: FilePath...")
        expect(gc_process).to_contain("files: FilePath...")
        expect(nogc_file.contains("...files:")).to_equal(false)
        expect(nogc_process.contains("...files:")).to_equal(false)
        expect(gc_process.contains("...files:")).to_equal(false)

    it "terminates empty Error implementation headers":
        step("Verify: terminates empty Error implementation headers")
        val http_error = parser_source(
            "src/compiler_rust/lib/std/src/host/common/net/http_error.spl")
        val net_error = parser_source(
            "src/compiler_rust/lib/std/src/host/common/net/net_error.spl")
        val static_vec = parser_source(
            "src/compiler_rust/lib/std/src/core_nogc_immut/static_vec.spl")
        val static_string = parser_source(
            "src/compiler_rust/lib/std/src/core_nogc_immut/static_string.spl")
        val fixed_vec = parser_source(
            "src/compiler_rust/lib/std/src/core_nogc/fixed_vec.spl")
        expect(http_error).to_contain("impl Error for HttpError:")
        expect(net_error).to_contain("impl Error for NetError:")
        expect(static_vec).to_contain("impl Error for StaticVecError:")
        expect(static_string).to_contain("impl Error for StaticStringError:")
        expect(fixed_vec).to_contain("impl Error for FixedVecError:")

    it "uses supported callable types for monoio runtime wrappers":
        step("Verify: uses supported callable types for monoio runtime wrappers")
        val runtime_source = parser_source(
            "src/compiler_rust/lib/std/src/host/common/net/runtime.spl")
        expect(runtime_source).to_contain("spawn<T>(task: fn() -> T)")
        expect(runtime_source).to_contain("block_on<T>(future: fn() -> T)")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/host/common/net/runtime.spl",
            ": async fn()")

    it "uses the declared SDN text variant":
        step("Verify: uses the declared SDN text variant")
        val sdn_parser = parser_source(
            "src/compiler_rust/lib/std/src/sdn/parser.spl")
        expect(sdn_parser).to_contain("SdnValue.text(combined)")
        expect_source_omits(
            "src/compiler_rust/lib/std/src/sdn/parser.spl",
            "SdnValue.String(combined)")

    it "parse val declaration":
        step("Verify: parse val declaration")
        val x = 42
        check(x == 42)

    it "parse var declaration":
        step("Verify: parse var declaration")
        var x = 42
        x = 100
        check(x == 100)

    it "parse typed val":
        step("Verify: parse typed val")
        val x: i64 = 42
        check(x == 42)

    it "parse typed var":
        step("Verify: parse typed var")
        var x: i64 = 42
        check(x == 42)

    it "parse walrus operator":
        step("Verify: parse walrus operator")
        val x = 42
        # TODO: walrus operator `:=` triggers parse error (expected indented block after ':')
        # Once fixed, restore: x := 42
        check(x == 42)

    it "parse function declaration":
        step("Verify: parse function declaration")
        fn add(a: i64, b: i64) -> i64:
            a + b
        check(add(3, 4) == 7)

    it "parse function with no return type":
        step("Verify: parse function with no return type")
        fn greet(name: text):
            check(name == "test")
        greet("test")
        check(1 + 1 == 2)

    it "parse function with default args":
        step("Verify: parse function with default args")
        fn greet(name: text, prefix: text = "Hello") -> text:
            "{prefix}, {name}!"
        check(greet("World") == "Hello, World!")
        check(greet("World", "Hi") == "Hi, World!")

describe "Parser Bootstrap Compatibility":
    it "keeps driver process-result tuples positional for bootstrap parser":
        step("Verify: keeps driver process-result tuples positional for bootstrap parser")
        expect_source_omits("src/compiler/80.driver/driver.spl", "-> (stdout: text")
        expect_source_omits("src/compiler/80.driver/driver_aot_native_output.spl", "-> (stdout: text")
        expect_source_omits("src/compiler/80.driver/driver_bootstrap.spl", "-> (stdout: text")
        expect_source_omits("src/compiler/80.driver/driver_helpers.spl", "-> (stdout: text")
        expect_source_omits("src/compiler/80.driver/driver_public_shared.spl", "-> (stdout: text")

    it "keeps driver parallel wait-result literals positional":
        step("Verify: keeps driver parallel wait-result literals positional")
        # `80.driver/driver/parallel.spl` was deleted (10d50ad3e27); the surviving
        # owner of the wait-result literals is `driver_build/parallel.spl`, already
        # asserted here. The two dead-path lines were duplicates of these two.
        expect_source_omits("src/compiler/80.driver/driver_build/parallel.spl", "finished_pid:")
        expect_source_omits("src/compiler/80.driver/driver_build/parallel.spl", ", exit_code:")

    it "keeps compiler tool tuple returns positional for bootstrap parser":
        step("Verify: keeps compiler tool tuple returns positional for bootstrap parser")
        # `sffi_gen/specs/treesitter.spl` was deleted as dead (c22135e98a7, 38
        # unregistered externs) with no successor file, so its two lines are
        # dropped rather than repointed -- there is no surviving source to guard.
        expect_source_omits("src/compiler/90.tools/sffi_gen/specs/mmap.spl", "-> (success: bool")
        expect_source_omits("src/compiler/90.tools/stats/dynamic.spl", "total_public: i64")

    it "keeps startup byte escape checks compatible with bootstrap parser":
        step("Verify: keeps startup byte escape checks compatible with bootstrap parser")
        expect_source_omits("src/app/startup/launch_metadata.spl", "10u8")
        expect_source_omits("src/app/startup/launch_metadata.spl", "13u8")
        expect_source_omits("src/app/startup/launch_metadata.spl", "9u8")

    it "keeps zipped type loops flat for bootstrap parser":
        step("Verify: keeps zipped type loops flat for bootstrap parser")
        # Repointed at the consolidation targets, not the retired phase files.
        # `src/compiler/PHASE_FILES.md` and `variance.spl`'s own docstring record
        # variance_phase6a-d -> variance_types.spl (implementation) +
        # variance_tests_repr_infer.spl (6A/6B) + variance_tests_check.spl (6C/6D),
        # and macro_checker_phase7a-c -> macro_checker.spl. Those files inherited
        # the loops this guard is about, so the guard follows the code.
        expect_source_omits("src/compiler/30.types/variance_types.spl", "for i, (")
        expect_source_omits("src/compiler/30.types/variance_tests_check.spl", "for i, (")
        expect_source_omits("src/compiler/30.types/variance_tests_repr_infer.spl", "for i, (")
        expect_source_omits("src/compiler/30.types/macro_type_checker.spl", "for i, (")
        expect_source_omits("src/compiler/30.types/macro_checker.spl", "for i, (")

describe "Parse Expressions":
    it "parse binary expression":
        step("Verify: parse binary expression")
        check(3 + 4 == 7)

    it "parse parenthesized expression":
        step("Verify: parse parenthesized expression")
        check((3 + 4) * 2 == 14)

    it "parse unary negation":
        step("Verify: parse unary negation")
        check(-5 == -5)

    it "parse logical not":
        step("Verify: parse logical not")
        check(not false)

    it "parse string interpolation":
        step("Verify: parse string interpolation")
        val name = "world"
        check("hello {name}" == "hello world")

    it "parse escaped string literal":
        step("Verify: parse escaped string literal")
        val s = "line1\nline2"
        check(s.len() == 11)

    it "parse array literal":
        step("Verify: parse array literal")
        val arr = [1, 2, 3]
        check(arr.len() == 3)

    it "parse map literal":
        step("Verify: parse map literal")
        val m = {"a": 1, "b": 2}
        check(m.len() == 2)

    it "parse range":
        step("Verify: parse range")
        var count = 0
        for i in 0..5:
            count = count + 1
        check(count == 5)

    it "parse lambda":
        step("Verify: parse lambda")
        val f = \x: x * 2
        check(f(21) == 42)

    it "parse placeholder lambda":
        step("Verify: parse placeholder lambda")
        val f = _ * 2
        check(f(21) == 42)

    it "parse placeholder lambda nested in a call argument":
        step("Verify: parse placeholder lambda nested in a call argument")
        fn double_nested(value: i64) -> i64:
            value * 2
        val values = [1, 2, 3].map(double_nested(_))
        check(values[2] == 6)

    it "parse method reference":
        step("Verify: parse method reference")
        val words = ["hello", "world"]
        val lengths = words.map(&:len)
        check(lengths[0] == 5)

    it "parse pipe operator":
        step("Verify: parse pipe operator")
        fn double(x: i64) -> i64:
            x * 2
        val result = 21 |> double
        check(result == 42)

    it "parse optional chaining":
        step("Verify: parse optional chaining")
        val x = Some(42)
        check(x.?)

    it "parse nil coalescing":
        step("Verify: parse nil coalescing")
        val x: Option<i64> = nil
        val y = x ?? 99
        check(y == 99)

describe "Parse Control Flow":
    it "parse if":
        step("Verify: parse if")
        var result = 0
        if true:
            result = 1
        check(result == 1)

    it "parse if-else":
        step("Verify: parse if-else")
        var result = 0
        if false:
            result = 1
        else:
            result = 2
        check(result == 2)

    it "parse if-elif-else":
        step("Verify: parse if-elif-else")
        check(parser_if_elif_result(5) == "small")

    it "parse while loop":
        step("Verify: parse while loop")
        var i = 0
        while i < 5:
            i = i + 1
        check(i == 5)

    it "parse for-in loop":
        step("Verify: parse for-in loop")
        var sum = 0
        for i in [1, 2, 3]:
            sum = sum + i
        check(sum == 6)

    it "parse match expression":
        step("Verify: parse match expression")
        val x = 2
        val result = match x:
            1: "one"
            2: "two"
            _: "other"
        check(result == "two")

    it "parse match with destructuring":
        step("Verify: parse match with destructuring")
        val opt = Some(42)
        var result = 0
        match opt:
            Some(v): result = v
            nil: result = -1
        check(result == 42)

describe "Parse Class Definitions":
    it "parse simple class":
        step("Verify: parse simple class")
        class Point2D:
            x: i64
            y: i64
        val p = Point2D(x: 1, y: 2)
        check(p.x == 1 and p.y == 2)

    it "parse class with methods":
        step("Verify: parse class with methods")
        class Counter:
            value: i64
            fn get() -> i64:
                self.value
            me increment():
                self.value = self.value + 1
        var c = Counter(value: 0)
        c.increment()
        check(c.get() == 1)

    it "parse class with static":
        step("Verify: parse class with static")
        class Factory:
            val_field: i64
            static fn create() -> Factory:
                Factory(val_field: 0)
        val f = Factory.create()
        check(f.val_field == 0)

describe "Parse Comprehensions":
    it "list comprehension":
        step("Verify: list comprehension")
        val squares = [for x in 0..5: x * x]
        check(squares.len() == 5)
        check(squares[0] == 0)
        check(squares[4] == 16)

    it "filtered comprehension":
        step("Verify: filtered comprehension")
        val evens = [for x in 0..10 if x % 2 == 0: x]
        check(evens.len() == 5)

    it "nested comprehension":
        step("Verify: nested comprehension")
        val pairs = [for x in 0..3: x * 10]
        check(pairs.len() == 3)
