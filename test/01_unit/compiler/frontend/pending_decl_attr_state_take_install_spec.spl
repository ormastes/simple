use std.spec.{describe, it, expect}
use compiler.frontend.core._ParserDecls.enum_module_body.{pending_decl_attr_state_take, pending_decl_attr_state_install}

describe "PendingDeclAttrState ParseContext snapshot (stage 1)":
    it "take leaves fresh stores and install restores the snapshot":
        val a = pending_decl_attr_state_take()
        val fresh = pending_decl_attr_state_take()
        expect(fresh.PENDING_SFFI_KEYS.len()).to_equal(0)
        pending_decl_attr_state_install(a)
        val again = pending_decl_attr_state_take()
        expect(again.PENDING_SFFI_KEYS.len()).to_equal(a.PENDING_SFFI_KEYS.len())
        pending_decl_attr_state_install(again)
