# @req REQ-FLAT-POOL-TRUNCATION-001
use std.spec
use std.spec.step
use compiler.frontend.core.flat_pool_codec.*

describe "canonical scalar failure publication":
    it "does not publish a rejected integer":
        step("Reject a noncanonical integer after a valid prefix")
        val reader = FlatPoolReader.new_canonical("2\n7\n01\n")
        expect(flat_pool_dec_i64(reader)).to_equal([7])
        expect(reader.ok).to_equal(false)

    it "does not publish a rejected integer into retained storage":
        step("Reject a noncanonical integer in a retained destination")
        val reader = FlatPoolReader.new_canonical("2\n7\n01\n")
        expect(flat_pool_dec_i64_into([99], reader)).to_equal([7])
        expect(reader.ok).to_equal(false)

    it "does not turn a rejected integer into a false boolean":
        step("Reject a malformed integer before boolean conversion")
        val reader = FlatPoolReader.new_canonical("2\n1\n01\n")
        expect(flat_pool_dec_bool(reader)).to_equal([true])
        expect(reader.ok).to_equal(false)

    it "does not publish a rejected boolean into retained storage":
        step("Reject a malformed boolean in a retained destination")
        val reader = FlatPoolReader.new_canonical("2\n1\n01\n")
        expect(flat_pool_dec_bool_into([false], reader)).to_equal([true])
        expect(reader.ok).to_equal(false)
