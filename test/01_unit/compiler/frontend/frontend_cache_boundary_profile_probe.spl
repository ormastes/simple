# Runnable companion to frontend_cache_boundary_profile_spec.spl.
# The parent spec controls the profile/cache environment before this process
# begins, then scores its direct stdout for miss/hit boundary categories.
use std.io_runtime.{file_write_exact, file_delete, getpid}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}

fn main() -> i64:
    val path = "build/frontend_cache_boundary_profile_probe_{getpid()}.spl"
    val source = "class CacheBoundaryProbe{getpid()}:\n    val value: i64"
    if not file_write_exact(path, source):
        panic("cannot write cache-boundary probe source")
    val log = Logger(level: 0)
    val first = parse_full_frontend(source, path, "cache_boundary_probe_first", log)
    val second = parse_full_frontend(source, path, "cache_boundary_probe_second", log)
    val _cleaned = file_delete(path)
    if not first.classes.contains("CacheBoundaryProbe{getpid()}"):
        panic("cache-boundary miss parse failed")
    if not second.classes.contains("CacheBoundaryProbe{getpid()}"):
        panic("cache-boundary hit restore failed")
    print("CACHE_BOUNDARY_PROFILE_PROBE_PASS")
    0
