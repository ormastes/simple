# BUG-MATCH-DEDENT-CALL-20261012: actual flat parser and bridge source TDD.
use std.spec.*
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*
use compiler.frontend.parser_types_expr.*

fn parsed_subject(source: text) -> ParserFunction:
    val parsed = parse_and_build_module(source, "match_boundary_fixture.spl")
    parsed.functions["subject"] ?? panic("missing subject function")

fn assert_match_binding(statement: Stmt, expected_name: text):
    match statement.kind:
        case StmtKind.Val(name, _, initializer):
            expect(name).to_equal(expected_name)
            match initializer.kind:
                case ExprKind.MatchCase(_, arms): expect(arms.len()).to_be_greater_than(0)
                case _: panic("binding initializer is not the authored match")
        case _: panic("missing authored val binding")

fn assert_final_binary(statement: Stmt):
    match statement.kind:
        case StmtKind.Expr(expression):
            match expression.kind:
                case ExprKind.Binary(_, _, _): pass
                case _: panic("final statement is not the authored binary expression")
        case _: panic("missing final expression statement")

describe "match DEDENT parenthesized statement boundary":
    it "keeps a match initializer and following result as separate statements":
        val function = parsed_subject("fn subject():\n    val available = match 1:\n        case 1: 3\n        case _: 0\n    (available & 1) == 1\n")
        expect(function.body.stmts.len()).to_equal(2)
        assert_match_binding(function.body.stmts[0], "available")
        assert_final_binary(function.body.stmts[1])

    it "preserves both authored match bindings before the result":
        val function = parsed_subject("fn subject():\n    val required = match 1:\n        case _: 1\n    val available = match 3:\n        case _: 3\n    (required & available) == required\n")
        expect(function.body.stmts.len()).to_equal(3)
        assert_match_binding(function.body.stmts[0], "required")
        assert_match_binding(function.body.stmts[1], "available")
        assert_final_binary(function.body.stmts[2])

    # New positive controls execute only with the candidate, never in baseline.
    it "preserves an explicitly parenthesized match as call target":
        val function = parsed_subject("fn subject():\n    (match 1:\n        case _: callback)(9)\n")
        expect(function.body.stmts.len()).to_equal(1)
        match function.body.stmts[0].kind:
            case StmtKind.Expr(expression):
                match expression.kind:
                    case ExprKind.Call(callee, arguments):
                        expect(arguments.len()).to_equal(1)
                        match callee.kind:
                            case ExprKind.MatchCase(_, arms): expect(arms.len()).to_equal(1)
                            case _: panic("parenthesized match call target changed")
                    case _: panic("parenthesized match call disappeared")
            case _: panic("missing call expression statement")

    it "preserves an ordinary adjacent call":
        val function = parsed_subject("fn subject():\n    callback(9)\n")
        expect(function.body.stmts.len()).to_equal(1)
        match function.body.stmts[0].kind:
            case StmtKind.Expr(expression):
                match expression.kind:
                    case ExprKind.Call(callee, arguments):
                        expect(arguments.len()).to_equal(1)
                        match callee.kind:
                            case ExprKind.Ident(name): expect(name).to_equal("callback")
                            case _: panic("ordinary call target changed")
                    case _: panic("ordinary call disappeared")
            case _: panic("missing ordinary call statement")
