use compiler.frontend.flat_ast_bridge.{flat_pool_capture_arm, flat_pool_capture_take, build_module_from_flat_pool_blob}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION}
use compiler.core.parser.{parser_has_errors}
use compiler.frontend.frontend_aop_owner.{frontend_aop_bind_module_owner}
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}

describe "AOP and architecture declaration constructor owners":
    it "binds both constructors from the concrete declaration owner":
        val source = file_read("src/compiler/10.frontend/core/_ParserDecls/bitfield_aop_arch_decls.spl")
        expect(source).to_contain("use compiler.frontend.core._Ast.decl_nodes.{decl_aop_advice, decl_aop_advice_owned, decl_arch_rule}")
        expect(source).to_contain("decl_aop_advice(pointcut, handler, form, priority_text, 0)")
        expect(source).to_contain("decl_arch_rule(kind, pointcut, message, 0)")

    it "preserves advice and adjacent forbid and allow metadata":
        val source = (
            "on pc{{ execution(* target(..)) }} use advice before priority 10\n" +
            "forbid pc{{ import(test.internal.*) }} \"forbidden import\"\n" +
            "allow pc{{ import(test.public.*) }} \"allowed import\"\n"
        )
        val module = parse_and_build_module(source, "aop_arch_owner_spec.spl")
        expect(module.aop_advices.len()).to_equal(1)
        expect(module.aop_advices[0].handler).to_equal("advice")
        expect(module.aop_advices[0].form).to_equal("before")
        expect(module.aop_advices[0].priority).to_equal(10)
        expect(module.aop_advices[0].pointcut).to_equal("execution ( * target ( .. ) )")
        expect(module.arch_rules.len()).to_equal(2)
        expect(module.arch_rules[0].kind).to_equal("forbid")
        expect(module.arch_rules[0].pointcut).to_equal("import ( test . internal . * )")
        expect(module.arch_rules[0].message).to_equal("forbidden import")
        expect(module.arch_rules[1].kind).to_equal("allow")
        expect(module.arch_rules[1].pointcut).to_equal("import ( test . public . * )")
        expect(module.arch_rules[1].message).to_equal("allowed import")

    it "retains lexical owners for two aspects and explicit legacy advice":
        val source = "aspect First:\n    on pc{{ execution(* target(..)) }} use before_one before\naspect Second:\n    on pc{{ execution(* target(..)) }} use before_two before\non pc{{ execution(* target(..)) }} use legacy before\n"
        val module = parse_and_build_module(source, "owner_transport.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.aop_advices.len()).to_equal(3)
        expect(module.aop_advices[0].aspect_name).to_equal("First")
        expect(module.aop_advices[1].aspect_name).to_equal("Second")
        expect(module.aop_advices[2].aspect_name).to_equal("")
        expect(module.aop_advices[0].aspect_module).to_equal("")

    it "rebinds every restored advice to the current loader identity":
        val source = "aspect Trace:\n    on pc{{ execution(* target(..)) }} use trace before\n"
        val module = parse_and_build_module(source, "/untrusted/path/owner.spl")
        val first = frontend_aop_bind_module_owner(module.aop_advices, "app.first")
        val second = frontend_aop_bind_module_owner(first, "app.second")
        expect(first[0].aspect_module).to_equal("app.first")
        expect(second[0].aspect_module).to_equal("app.second")
        expect(second[0].aspect_name).to_equal("Trace")
        expect(module.aop_advices[0].aspect_module).to_equal("")

    it "rejects duplicate aspect names in one module":
        val source = "aspect Trace:\n    on pc{{ execution(* target(..)) }} use first before\naspect Trace:\n    on pc{{ execution(* target(..)) }} use second before\n"
        val module = parse_and_build_module(source, "duplicate_owner.spl")
        expect(parser_has_errors()).to_equal(true)

    it "preserves ordinary callable identifiers named aspect":
        val module = parse_and_build_module("fn aspect(x: i64) -> i64:\n    x\nval answer = aspect(1)\n", "aspect_identifier.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.functions.contains_key("aspect")).to_equal(true)

    it "round trips lexical ownership through the actual AST cache and rejects old headers":
        val source = "aspect Trace:\n    on pc{{ execution(* target(..)) }} use trace before\n"
        flat_pool_capture_arm()
        val parsed = parse_and_build_module(source, "cached_owner.spl")
        val blob = flat_pool_capture_take()
        expect(blob.len()).to_be_greater_than(0)
        val restored = build_module_from_flat_pool_blob(blob, source, "cached_owner.spl")
        expect(restored.?).to_equal(true)
        val cached = restored.unwrap()
        expect(cached.aop_advices[0].aspect_name).to_equal("Trace")
        expect(cached.aop_advices[0].aspect_module).to_equal("")
        val rebound = frontend_aop_bind_module_owner(cached.aop_advices, "app.current")
        expect(rebound[0].aspect_module).to_equal("app.current")
        val old_blob = blob.replace(FLAT_POOL_CODEC_VERSION, "spl-flatpool-v16-field-array-sizes")
        val old = build_module_from_flat_pool_blob(old_blob, source, "cached_owner.spl")
        expect(old.?).to_equal(false)
