use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}

describe "AOP and architecture declaration constructor owners":
    it "binds both constructors from the concrete declaration owner":
        val source = file_read("src/compiler/10.frontend/core/_ParserDecls/bitfield_aop_arch_decls.spl")
        expect(source).to_contain("use compiler.frontend.core._Ast.decl_nodes.{decl_aop_advice, decl_arch_rule}")
        expect(source).to_contain("decl_aop_advice(pointcut, handler, form, priority_text, 0)")
        expect(source).to_contain("decl_arch_rule(kind, pointcut, message, 0)")

    it "preserves advice and adjacent forbid and allow metadata":
        val source = (
            "on pc{{ execution(* target(..)) }} use advice before priority 10\n" +
            "forbid pc{{ import(test.internal.*) }} \"forbidden import\"\n" +
            "allow pc{{ import(test.public.*) }} \"allowed import\"\n"
        )
        val module = parse_and_build_module(source, "aop_arch_owner_spec.spl")
        expect(module.aop_advices.len()).to_equal(1)
        expect(module.aop_advices[0].handler).to_equal("advice")
        expect(module.aop_advices[0].form).to_equal("before")
        expect(module.aop_advices[0].priority).to_equal(10)
        expect(module.aop_advices[0].pointcut).to_equal("execution ( * target ( .. ) )")
        expect(module.arch_rules.len()).to_equal(2)
        expect(module.arch_rules[0].kind).to_equal("forbid")
        expect(module.arch_rules[0].pointcut).to_equal("import ( test . internal . * )")
        expect(module.arch_rules[0].message).to_equal("forbidden import")
        expect(module.arch_rules[1].kind).to_equal("allow")
        expect(module.arch_rules[1].pointcut).to_equal("import ( test . public . * )")
        expect(module.arch_rules[1].message).to_equal("allowed import")
