"""Executable round-trip coverage for append-only facet declaration tags 18--21."""

use std.spec.*
use compiler.core.ast.*
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

describe "flat facet declaration codec":
    it "round trips tags 18 through 21 and every facet-owned payload":
        step("Construct one declaration of each frozen facet family")
        ast_reset()
        val iface = decl_facet_interface("a", 2, "Readable", ["T"], [11], [12], "public", 1, ["stable"], 1)
        val impl = decl_facet_impl("a", 2, "ReadableImpl", ["T"], 21, [22], "InspectReadonly", [23], ["cold"], 2)
        val binding_decl = decl_facet_bind("a", 2, 31, "type File", 32, "NominalStatic", 9, "disk", 3)
        val req = decl_facet_require("a", 2, 41, "type File", 4)
        expect([decl_get_tag(iface), decl_get_tag(impl), decl_get_tag(binding_decl), decl_get_tag(req)]).to_equal([18, 19, 20, 21])
        val blob = flat_decl_pools_dump()

        step("Clear the arena, restore the encoded pools, and read canonical accessors")
        ast_reset()
        val reader = FlatPoolReader.new(blob)
        expect(flat_decl_pools_restore(reader)).to_equal(true)
        expect(decl_get_facet_name(iface)).to_equal("Readable")
        expect(decl_get_facet_type_params(iface)).to_equal(["T"])
        expect(decl_get_facet_composes(iface)).to_equal([11])
        expect(decl_get_facet_access_mode(impl)).to_equal("InspectReadonly")
        expect(decl_get_facet_interfaces(impl)).to_equal([22])
        expect(decl_get_facet_binding_mode(binding_decl)).to_equal("NominalStatic")
        expect(decl_get_facet_priority(binding_decl)).to_equal(9)
        expect(decl_get_facet_provider_id(binding_decl)).to_equal("disk")
        expect(decl_get_facet_interface_type(req)).to_equal(41)
        expect(decl_get_facet_pointcut_text(req)).to_equal("type File")

    it "rejects a stale truncated pool payload as a cache miss":
        step("Remove the final framing data from a current pool blob")
        ast_reset()
        val decl = decl_facet_require("a", 1, 7, "type X", 0)
        val blob = flat_decl_pools_dump()
        ast_reset()
        val stale_v1 = blob.substring(0, blob.len() / 2)
        expect(flat_decl_pools_restore(FlatPoolReader.new(stale_v1))).to_equal(false)
