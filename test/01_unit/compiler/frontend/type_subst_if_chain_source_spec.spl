"""
## Purpose and audience
Source-contract and runtime spec for `STMT_IF` / `elif` chain type substitution:
the substitution pass must walk statement bodies, `else_body`, `elif_conds`, and
`elif_bodies` through `subst_type_in_stmt` and `subst_type_in_stmt_list`, while
`ast_clone` clones declaration and nested `elif` payloads cleanly. Audience:
frontend type-substitution maintainers.
"""
# Lifecycle: doc/01_research/local/parser_framework.md ;
# doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md ;
# doc/04_architecture/compiler/misc/parser_file_locations_2026-02-04.md ;
# doc/05_design/compiler/parsing/parser_architecture_unified_2026-02-04.md
# @manual_section: linked-if-chain-type-substitution

use std.spec.{describe, it, expect, step}
extern fn rt_file_read_text(path: text) -> text?
use compiler.core.ast.{
    STMT_IF, ast_reset, decl_fn, decl_get_body, decl_get_param_types,
    decl_get_ret_type, elif_new, expr_bool_lit, expr_int_lit,
    stmt_get_body, stmt_get_if_single_else, stmt_get_tag, stmt_get_type,
    stmt_if_stmt, stmt_if_stmt_with_single_else, stmt_val_decl
}
use compiler.core.types.{TYPE_I64, TYPE_NAMED_BASE, named_type_register}
use compiler.frontend.core.ast_clone.{ast_clone_decl}
use compiler.core.type_subst.{
    type_subst_reset, type_subst_add, type_subst_lookup, subst_type_in_decl
}

describe "if-chain type substitution source contract":
    it "recurses through child expressions, arguments, and statement lists in subst_type_in_expr":
        # @req REQ-COMPILER-FRONTEND-TYPESUBST-001
        # @capture(protocol_json): the grep-verified expression recursion clauses of the substitution owner
        step("Read the substitution owner and verify expression/statement recursion")
        val source = rt_file_read_text("src/compiler/10.frontend/core/type_subst.spl") ?? ""
        val recurses_children = source.contains("subst_type_in_expr(e.left)") and
            source.contains("subst_type_in_expr(e.right)") and
            source.contains("subst_type_in_expr(e.extra)")
        val keeps_argument_list_recursion = source.contains("for arg_eid in e.args:\n        subst_type_in_expr(arg_eid)")
        val recurses_stmt_lists = source.contains("for stmt_id in e.stmts:\n        subst_type_in_stmt(stmt_id)")
        val carries_no_legacy_materializer = not source.contains("materialize_legacy")
        expect(recurses_children).to_equal(true)
        expect(keeps_argument_list_recursion).to_equal(true)
        expect(recurses_stmt_lists).to_equal(true)
        expect(carries_no_legacy_materializer).to_equal(true)

    it "visits body, else_body, elif_conds, and elif_bodies in subst_type_in_stmt":
        # @req REQ-COMPILER-FRONTEND-TYPESUBST-002
        # @capture(protocol_json): the grep-verified branch visit clauses
        step("Read the substitution owner and verify each arm and terminal visit")
        val source = rt_file_read_text("src/compiler/10.frontend/core/type_subst.spl") ?? ""
        val visits_body = source.contains("for stmt_id in s.body:\n        subst_type_in_stmt(stmt_id)")
        val visits_else = source.contains("for stmt_id in s.else_body:\n        subst_type_in_stmt(stmt_id)")
        val visits_elif_conds = source.contains("for cond_eid in s.elif_conds:\n        subst_type_in_expr(cond_eid)")
        val visits_elif_bodies = source.contains("for branch_stmts in s.elif_bodies:\n        subst_type_in_stmt_list(branch_stmts)")
        val defines_stmt_list_helper = source.contains("fn subst_type_in_stmt_list(statement_ids: [i64]):")
        expect(visits_body).to_equal(true)
        expect(visits_else).to_equal(true)
        expect(visits_elif_conds).to_equal(true)
        expect(visits_elif_bodies).to_equal(true)
        expect(defines_stmt_list_helper).to_equal(true)

    it "clones and traverses nested STMT_IF chains in subst_type_in_decl":
        # @req REQ-COMPILER-FRONTEND-TYPESUBST-003
        # @capture(bit_table): the cloned and traversed declaration and STMT_IF chain metadata
        step("Build a generic STMT_IF chain decl, clone it, and run subst_type_in_decl")
        ast_reset()
        val named_id = named_type_register("FlatIfTypeParam", [], [])
        val param_tag = TYPE_NAMED_BASE + named_id
        val arm_local = stmt_val_decl("arm_local", param_tag, expr_int_lit(1, 0), 0)
        val elif_local = stmt_val_decl("elif_local", param_tag, expr_int_lit(2, 0), 0)
        val else_local = stmt_val_decl("else_local", param_tag, expr_int_lit(0, 0), 0)
        val inner_cond = expr_bool_lit(false, 0)
        val inner_elif = elif_new(inner_cond, [elif_local], [else_local])
        val inner_if = stmt_if_stmt(inner_cond, [elif_local], inner_elif, 0)
        val outer_cond = expr_bool_lit(true, 0)
        val outer_elif = elif_new(outer_cond, [arm_local], [inner_if])
        val root = stmt_if_stmt_with_single_else(outer_cond, [arm_local], outer_elif, inner_if, 0)
        val decl_id = decl_fn(
            "specialized", ["value"], [param_tag], param_tag, [root], 0,
            ["FlatIfTypeParam"], 0
        )

        type_subst_reset()
        type_subst_add("FlatIfTypeParam", TYPE_I64)
        expect(type_subst_lookup("FlatIfTypeParam")).to_equal(TYPE_I64)
        val cloned_id = ast_clone_decl(decl_id)
        subst_type_in_decl(cloned_id)

        step("Require cloned declaration tag and source STMT_IF structure remain intact")
        expect(decl_get_param_types(decl_id)).to_equal([param_tag])
        expect(decl_get_ret_type(decl_id)).to_equal(param_tag)
        expect(cloned_id > decl_id).to_equal(true)
        val source_body = decl_get_body(decl_id)
        expect(source_body.len()).to_equal(1)
        expect(stmt_get_tag(source_body[0])).to_equal(STMT_IF)
        expect(stmt_get_body(source_body[0]).len()).to_equal(1)
        expect(stmt_get_type(stmt_get_body(source_body[0])[0])).to_equal(param_tag)
        expect(stmt_get_if_single_else(root)).to_equal(inner_if)

    it "keeps ast_clone_decl and ast_clone_stmt_list wired for specialization":
        # @req REQ-COMPILER-FRONTEND-TYPESUBST-004
        # @capture(protocol_json): the grep-verified clone helper clauses
        step("Read ast_clone.spl and verify nested elif branch cloning")
        val clone_source = rt_file_read_text("src/compiler/10.frontend/core/ast_clone.spl") ?? ""
        val clones_elif_conds = clone_source.contains("for cond_eid in src.elif_conds:\n        new_elif_conds.push(ast_clone_expr(cond_eid))")
        val clones_elif_bodies = clone_source.contains("val new_branch: [i64] = ast_clone_stmt_list(body_stmts)")
        val clears_specialized_tparams = clone_source.contains("dst.type_params = []")
        expect(clones_elif_conds).to_equal(true)
        expect(clones_elif_bodies).to_equal(true)
        expect(clears_specialized_tparams).to_equal(true)
