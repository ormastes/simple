# Fixture for two parser gaps measured on the Rust seed (2026-10-24) while
# building AST-anchored TLDR sections (module_tldr_ast_sections_v1), which
# currently work around both:
#   - a top-level struct's span.line came back as 0;
#   - `@inline` above a function was not kept in ParserFunction.attributes.
# A design review could not reproduce either at its ref, so this spec pins
# the expected behaviour: it fails wherever a gap is real.
use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}

val SRC: text = "pub struct Point:\n    x: i64\n\n@inline\nfn twice(a: i64) -> i64:\n    a * 2\n"

describe "parser span and attribute retention":
    it "records the declaration line of a top-level struct":
        val parsed = parse_full_frontend(SRC, "span_fixture.spl", "span_fixture", Logger(level: 0))
        expect(parsed.structs["Point"].span.line).to_equal(1)

    it "keeps @inline on the function it decorates":
        val parsed = parse_full_frontend(SRC, "span_fixture.spl", "span_fixture", Logger(level: 0))
        var names: [text] = []
        for attribute in parsed.functions["twice"].attributes:
            names.push(attribute.name)
        expect(names.contains("inline")).to_equal(true)
