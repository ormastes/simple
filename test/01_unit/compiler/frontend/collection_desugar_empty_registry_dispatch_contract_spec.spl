"""Empty-registry dispatch coverage for the collection desugar arena walk."""

use std.spec.*
use std.io_runtime.{file_read}
use compiler.blocks.sugar_registry.{
    DesugarRule, register_desugar_rule, unregister_desugar_rule,
    lookup_rule, has_ast_rewrite_rules, ast_rewrite_rule_generation
}

describe "collection desugar empty registry dispatch":
    it "checks for executable AST rules once before walking the arena":
        val source = file_read("src/compiler/10.frontend/desugar/collection_desugar.spl")
        val begin = source.index_of("fn desugar_collections(start_from:")
        val finish = source.index_of("fn desugar_collections_static(")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        val gate = body.index_of("var dynamic_ast_rules = has_ast_rewrite_rules()")
        val walk = body.index_of("while i < count:")
        expect(gate >= 0 and walk > gate).to_equal(true)
        expect(body.count("has_ast_rewrite_rules()")).to_equal(2)
        expect(body.count("ast_rewrite_rule_generation()")).to_equal(2)
        expect(body).to_contain("if current_ast_rule_generation != ast_rule_generation:")
        expect(body.count("apply_sugar_rules_ast(_new_tag, i)")).to_equal(1)
        expect(body).to_contain("if dynamic_ast_rules:\n            val _new_tag = expr_tag[i]")

    it "keeps the static desugar path independent of the plugin registry":
        val source = file_read("src/compiler/10.frontend/desugar/collection_desugar.spl")
        val begin = source.index_of("fn desugar_collections_static(")
        val finish = source.index_of("fn is_definite_scalar_addend(")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body.count("has_ast_rewrite_rules")).to_equal(0)
        expect(body.count("apply_sugar_rules_ast")).to_equal(0)

    it "does not activate AST dispatch for sentinel-only text rules":
        val source = file_read("src/compiler/15.blocks/sugar_registry.spl")
        val begin = source.index_of("fn has_ast_rewrite_rules()")
        val finish = source.index_of("fn apply_sugar_rules_ast(")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body).to_contain("for r in reg.rules:")
        expect(body).to_contain("if r.ast_rewrite_fn != 0:")
        expect(body).to_contain("return true")
        expect(body).to_contain("false")

    it "persists sentinel and executable registrations with exact receipts":
        val sentinel_name = "collection_gate_sentinel_contract_9b71"
        val executable_name = "collection_gate_executable_contract_9b71"
        val _clean_sentinel = unregister_desugar_rule(sentinel_name)
        val _clean_executable = unregister_desugar_rule(executable_name)
        val generation_before = ast_rewrite_rule_generation()

        val sentinel = DesugarRule(
            name: sentinel_name, pattern_tag: 91001,
            rewrite_fn: 0, ast_rewrite_fn: 0)
        expect(register_desugar_rule(sentinel)).to_equal(true)
        expect(lookup_rule(sentinel_name).is_some()).to_equal(true)
        expect(ast_rewrite_rule_generation()).to_equal(generation_before)

        val executable = DesugarRule(
            name: executable_name, pattern_tag: 91002,
            rewrite_fn: 0, ast_rewrite_fn: 1)
        expect(register_desugar_rule(executable)).to_equal(true)
        expect(lookup_rule(executable_name).is_some()).to_equal(true)
        expect(has_ast_rewrite_rules()).to_equal(true)
        expect(ast_rewrite_rule_generation()).to_equal(generation_before + 1)

        expect(unregister_desugar_rule(executable_name)).to_equal(true)
        expect(ast_rewrite_rule_generation()).to_equal(generation_before + 2)
        expect(unregister_desugar_rule(sentinel_name)).to_equal(true)
        expect(ast_rewrite_rule_generation()).to_equal(generation_before + 2)
