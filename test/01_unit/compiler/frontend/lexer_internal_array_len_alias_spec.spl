use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "lexer internal array length naming":
    it "carries no array-len helper at all without changing runtime ABI fixtures":
        val lexer = file_read("src/compiler/10.frontend/core/lexer_struct.spl")
        val runtime_array = file_read("src/runtime/simple_core/core_array.spl")
        val runtime_string = file_read("src/runtime/simple_core/core_string.spl")
        val generic_fixture = file_read("test/fixtures/compiler/native_runtime_local_name_collision.spl")
        val concrete_fixture = file_read("test/fixtures/compiler/native_runtime_local_name_collision_non_generic.spl")
        val abi_guard = file_read("test/01_unit/compiler/backend/cranelift_aggregate_runtime_abi_spec.spl")

        # Pin drift: the compiler-local alias was renamed to rt_array_len_safe by
        # 102959c3ea3, then every <T> array-len helper was dropped from the
        # compiler lexer by d2bdc42d8ad (native-path fatal). Current contract is
        # stronger than the old alias pin: no array-len helper of any name, and
        # no rt_array_len_safe anywhere in the compiler lexer.
        expect(lexer.contains("array_len")).to_equal(false)
        expect(lexer.contains("rt_array_len_safe")).to_equal(false)
        expect(runtime_array).to_contain("pub fn rt_array_len_safe(array: i64) -> i64:")
        expect(runtime_string).to_contain("extern fn rt_array_len_safe(array: i64) -> i64")
        expect(generic_fixture).to_contain("fn rt_array_len_safe<T>(array: [T]) -> i64:")
        expect(concrete_fixture).to_contain("fn rt_array_len_safe(array: [i64]) -> i64:")
        expect(abi_guard).to_contain("native_runtime_local_name_collision.spl")
        expect(abi_guard).to_contain("native_runtime_local_name_collision_non_generic.spl")
