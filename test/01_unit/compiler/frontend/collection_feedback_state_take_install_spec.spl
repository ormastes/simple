use std.spec.{describe, it, expect}
use compiler.frontend.core.collection_feedback.{collection_feedback_state_take, collection_feedback_state_install}

describe "CollectionFeedbackState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = collection_feedback_state_take()
        val fresh = collection_feedback_state_take()
        expect(fresh._parser_collection_site_owner.len()).to_equal(0)
        collection_feedback_state_install(a)
        val again = collection_feedback_state_take()
        expect(again._parser_collection_site_owner.len()).to_equal(a._parser_collection_site_owner.len())
        collection_feedback_state_install(again)
