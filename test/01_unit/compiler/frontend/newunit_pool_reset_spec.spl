# A parser cache dump must use this file's newunit pools, not a previous
# file's transient arrays. The three parallel owners reset together.

use std.spec
use compiler.core.types.{reset_all_pools, newunit_register, newunit_count,
    newunit_name_at, newunit_suffix_at, newunit_underlying_tag_at,
    flat_type_pools_dump, flat_type_pools_restore, TYPE_I64}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

describe "newunit flat pool owner reset":
    it "dumps a following file with no stale newunit":
        reset_all_pools()
        newunit_register("PriorTransientUnit", "prior_suffix", TYPE_I64)
        reset_all_pools()
        expect(newunit_count()).to_equal(0)
        val blob = flat_type_pools_dump()
        expect(blob.contains("PriorTransientUnit")).to_equal(false)
        expect(blob.contains("prior_suffix")).to_equal(false)
        expect(flat_type_pools_restore(FlatPoolReader.new(blob))).to_equal(true)
        expect(newunit_count()).to_equal(0)

    it "round-trips current-file names and suffixes with escapes":
        reset_all_pools()
        val name = "Current\\Unit\nName"
        val suffix = "cur\\suffix\nline"
        newunit_register(name, suffix, TYPE_I64)
        val blob = flat_type_pools_dump()
        reset_all_pools()
        expect(flat_type_pools_restore(FlatPoolReader.new(blob))).to_equal(true)
        expect(newunit_count()).to_equal(1)
        expect(newunit_name_at(0)).to_equal(name)
        expect(newunit_suffix_at(0)).to_equal(suffix)
        expect(newunit_underlying_tag_at(0)).to_equal(TYPE_I64)
