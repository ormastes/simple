"""
## Purpose and audience
Purpose: `expr?.method(args)` parses as a method call on a try expression, not as
an indirect call of a field (which MIR rejects with "indirect callable lacks a
proven function signature"). Regression for git_provider.spl under Stage 2.
Audience: compiler frontend engineers.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

use std.spec.*
use compiler.core.ast.{ast_reset, module_get_decls, decl_get_name, decl_get_body}
use compiler.core.ast_expr.{expr_get_tag, expr_get_str, expr_get_left, expr_get_args,
    EXPR_METHOD_CALL, EXPR_TRY, EXPR_FIELD_ACCESS, EXPR_CALL}
use compiler.core.ast_stmt.{stmt_get_expr}
use compiler.core.parser.{parse_module, parser_has_errors}

fn first_body_expr(source: text, path: text, wanted: text) -> i64:
    ast_reset()
    parse_module(source, path)
    if parser_has_errors():
        fail("unexpected parser errors for {path}")
        return -1
    for decl in module_get_decls():
        if decl_get_name(decl) == wanted:
            val body = decl_get_body(decl)
            if body.len() < 1:
                fail("empty body for {wanted}")
                return -1
            return stmt_get_expr(body[0])
    fail("missing function {wanted}")
    -1

describe "optional member call parsing":
    it "parses result?.trim() as MethodCall(Try(call), trim)":
        val e = first_body_expr("fn f() -> Result<text, text>:\n    g()?.trim()\n", "opt_member_try.spl", "f")
        if e < 0: return
        expect(expr_get_tag(e)).to_equal(EXPR_METHOD_CALL)
        expect(expr_get_str(e)).to_equal("trim")
        val recv = expr_get_left(e)
        expect(expr_get_tag(recv)).to_equal(EXPR_TRY)
        expect(expr_get_tag(expr_get_left(recv))).to_equal(EXPR_CALL)

    it "keeps method arguments on the optional member call":
        val e = first_body_expr("fn f(x: Result<text, text>) -> Result<bool, text>:\n    x?.contains(\"a\")\n", "opt_member_args.spl", "f")
        if e < 0: return
        expect(expr_get_tag(e)).to_equal(EXPR_METHOD_CALL)
        expect(expr_get_str(e)).to_equal("contains")
        expect(expr_get_args(e).len()).to_equal(1)
        expect(expr_get_tag(expr_get_left(e))).to_equal(EXPR_TRY)

    it "leaves the field form base?.name as a field access":
        val e = first_body_expr("fn f(p: Point?) -> i64:\n    p?.x\n", "opt_member_field.spl", "f")
        if e < 0: return
        expect(expr_get_tag(e)).to_equal(EXPR_FIELD_ACCESS)
        expect(expr_get_str(e)).to_equal("x")
