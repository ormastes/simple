# Function-body `extern fn` declarations must become module declarations.
#
# Regression: parse_extern_fn_stmt_inline built the extern decl but never
# called module_add_decl, so function-body extern calls failed HIR lowering
# with "unresolved name". Repeated declarations also need compatible types.
# Bugs: doc/08_tracking/bug/pure_simple_nested_extern_registration_2026_10_12.md
#       (lane duplicate: p4p2_inline_extern_fn_never_registered_2026-10-20)
#
# @cover src/compiler/10.frontend/core/parser_stmts.spl

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*
use compiler.core.parser.{parser_error_count, parser_get_errors}

fn order_count(module: ParserModule, name: text) -> i64:
    var n = 0
    for entry in module.function_order:
        if entry == name:
            n = n + 1
    n

describe "function-body extern fn registration":
    it "retains the exact nested extern declaration source span":
        val prefix = "fn probe() -> i64:\n    "
        val declaration = "extern fn rt_cpu_count() -> i64"
        val src = prefix + declaration + "\n    rt_cpu_count()\n"
        val module = parse_and_build_module(src, "inline_extern_span_probe.spl")
        expect(parser_error_count()).to_equal(0)
        val ext: ParserFunction = module.functions["rt_cpu_count"]
        expect(ext.is_extern).to_equal(true)
        expect(ext.span.line).to_equal(2)
        expect(ext.span.col).to_equal(5)
        expect(ext.span.start).to_equal(prefix.len())
        expect(ext.span.end).to_equal(prefix.len() + declaration.len())
        expect(ext.span.length).to_equal(declaration.len())

    it "retains a nested extern span inside a static method":
        val prefix = "class ParallelProbe:\n    static fn default_config() -> i64:\n        "
        val declaration = "extern fn rt_cpu_count() -> i64"
        val src = prefix + declaration + "\n        rt_cpu_count()\n"
        val module = parse_and_build_module(src, "inline_extern_static_span_probe.spl")
        expect(parser_error_count()).to_equal(0)
        val ext: ParserFunction = module.functions["rt_cpu_count"]
        expect(ext.span.line).to_equal(3)
        expect(ext.span.col).to_equal(9)
        expect(ext.span.start).to_equal(prefix.len())
        expect(ext.span.end).to_equal(prefix.len() + declaration.len())

    it "preserves the first declaration span when another body repeats an extern":
        val prefix = "fn first() -> i64:\n    "
        val declaration = "extern fn rt_cpu_count() -> i64"
        val src = prefix + declaration + "\n    rt_cpu_count()\n\n" +
            "fn second() -> i64:\n    extern fn rt_cpu_count() -> i64\n    rt_cpu_count()\n"
        val module = parse_and_build_module(src, "inline_extern_repeated_span_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(order_count(module, "rt_cpu_count")).to_equal(1)
        val ext: ParserFunction = module.functions["rt_cpu_count"]
        expect(ext.span.line).to_equal(2)
        expect(ext.span.start).to_equal(prefix.len())
        expect(ext.span.length).to_equal(declaration.len())

    it "accepts the same contextual keyword declaration name at module and body scope":
        val top = parse_and_build_module("extern fn match() -> i64\n", "extern_keyword_top_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(top.functions.contains("match")).to_equal(true)
        val src = "fn caller() -> i64:\n    extern fn match() -> i64\n    0\n"
        val module = parse_and_build_module(src, "extern_keyword_nested_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(module.functions.contains("match")).to_equal(true)
        val ext: ParserFunction = module.functions["match"]
        expect(ext.is_extern).to_equal(true)
        expect(ext.span.line).to_equal(2)

    it "registers a body-local extern as a module extern function":
        val src = "fn probe(data: [u8]) -> u64:\n" +
            "    extern fn unsafe_addr_of(ref: any) -> u64\n" +
            "    unsafe_addr_of(data) + 16u64\n"
        val module = parse_and_build_module(src, "inline_extern_single_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(module.functions.contains("probe")).to_equal(true)
        expect(module.functions.contains("unsafe_addr_of")).to_equal(true)
        val ext: ParserFunction = module.functions["unsafe_addr_of"]
        expect(ext.is_extern).to_equal(true)

    it "registers an @unsafe-attributed body-local extern":
        val src = "fn probe(addr: u64) -> u32:\n" +
            "    @unsafe(reason: \"reads raw memory\", capabilities: [ffi, raw_ptr])\n" +
            "    extern fn mmio_read32(addr: u64) -> u32\n" +
            "    mmio_read32(addr)\n"
        val module = parse_and_build_module(src, "inline_extern_attr_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(module.functions.contains("mmio_read32")).to_equal(true)

    it "adds one declaration when several bodies repeat the same extern":
        val src = "fn first(addr: u64) -> u32:\n" +
            "    extern fn mmio_read32(ptr: u64) -> u32\n" +
            "    mmio_read32(addr)\n" +
            "\n" +
            "fn second(addr: u64) -> u32:\n" +
            "    extern fn mmio_read32(addr: u64) -> u32\n" +
            "    extern fn mmio_read16(addr: u64) -> u16\n" +
            "    mmio_read32(addr) + mmio_read16(addr).to_u32()\n"
        val module = parse_and_build_module(src, "inline_extern_repeat_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(module.functions.contains("first")).to_equal(true)
        expect(module.functions.contains("second")).to_equal(true)
        expect(order_count(module, "mmio_read32")).to_equal(1)
        expect(order_count(module, "mmio_read16")).to_equal(1)

    it "does not duplicate an extern already declared at module level":
        val src = "extern fn unsafe_addr_of(ref: any) -> u64\n" +
            "\n" +
            "fn probe(data: [u8]) -> u64:\n" +
            "    extern fn unsafe_addr_of(ref: any) -> u64\n" +
            "    unsafe_addr_of(data)\n"
        val module = parse_and_build_module(src, "inline_extern_toplevel_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(order_count(module, "unsafe_addr_of")).to_equal(1)

    it "never replaces a same-named module fn with a body-local extern":
        val src = "fn rt_probe(x: i64) -> i64:\n" +
            "    x + 1\n" +
            "\n" +
            "fn caller(x: i64) -> i64:\n" +
            "    extern fn rt_probe(x: i64) -> i64\n" +
            "    rt_probe(x)\n"
        val module = parse_and_build_module(src, "inline_extern_fn_twin_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(module.functions.contains("rt_probe")).to_equal(true)
        val probe: ParserFunction = module.functions["rt_probe"]
        expect(probe.is_extern).to_equal(false)
        expect(order_count(module, "rt_probe")).to_equal(1)

    it "rejects repeated externs with a conflicting parameter count":
        val src = "fn first(a: i64) -> i64:\n" +
            "    extern fn rt_conflict(a: i64) -> i64\n" +
            "    rt_conflict(a)\n" +
            "\n" +
            "fn second(a: i64) -> i64:\n" +
            "    extern fn rt_conflict(a: i64, b: i64) -> i64\n" +
            "    rt_conflict(a, a)\n"
        val module = parse_and_build_module(src, "inline_extern_conflict_probe.spl")
        expect(order_count(module, "rt_conflict")).to_equal(1)
        expect(parser_error_count()).to_equal(1)
        expect(parser_get_errors().join("\n")).to_contain("line 6:5: conflicting extern declaration: rt_conflict")

    it "rejects a same-arity extern with a different parameter type":
        val src = "fn first(a: i64) -> i64:\n" +
            "    extern fn rt_param_conflict(a: i64) -> i64\n" +
            "    a\n" +
            "\n" +
            "fn second(a: i64) -> i64:\n" +
            "    extern fn rt_param_conflict(a: u64) -> i64\n" +
            "    a\n"
        val module = parse_and_build_module(src, "inline_extern_param_conflict_probe.spl")
        expect(order_count(module, "rt_param_conflict")).to_equal(1)
        expect(parser_error_count()).to_equal(1)
        expect(parser_get_errors().join("\n")).to_contain("conflicting extern declaration: rt_param_conflict")

    it "checks every parameter type in a repeated signature":
        val src = "fn first(a: i64, b: i64) -> i64:\n" +
            "    extern fn rt_second_param_conflict(a: i64, b: i64) -> i64\n" +
            "    a + b\n" +
            "\n" +
            "fn second(a: i64, b: i64) -> i64:\n" +
            "    extern fn rt_second_param_conflict(a: i64, b: u64) -> i64\n" +
            "    a + b\n"
        val module = parse_and_build_module(src, "inline_extern_second_param_conflict_probe.spl")
        expect(order_count(module, "rt_second_param_conflict")).to_equal(1)
        expect(parser_error_count()).to_equal(1)
        expect(parser_get_errors().join("\n")).to_contain("conflicting extern declaration: rt_second_param_conflict")

    it "rejects an extern with a different return type, including zero-argument signatures":
        val src = "fn first() -> i64:\n" +
            "    extern fn rt_return_conflict() -> i64\n" +
            "    1\n" +
            "\n" +
            "fn second() -> i64:\n" +
            "    extern fn rt_return_conflict() -> u64\n" +
            "    1\n"
        val module = parse_and_build_module(src, "inline_extern_return_conflict_probe.spl")
        expect(order_count(module, "rt_return_conflict")).to_equal(1)
        expect(parser_error_count()).to_equal(1)
        expect(parser_get_errors().join("\n")).to_contain("conflicting extern declaration: rt_return_conflict")

    it "accepts identical composite signatures with renamed parameter names":
        val src = "fn first(cb: fn(i64) -> text, values: [i64], maybe: i64?) -> text:\n" +
            "    extern fn rt_composite(cb: fn(i64) -> text, values: [i64], maybe: i64?) -> text\n" +
            "    \"\"\n" +
            "\n" +
            "fn second(callback: fn(i64) -> text, items: [i64], optional: i64?) -> text:\n" +
            "    extern fn rt_composite(callback: fn(i64) -> text, items: [i64], optional: i64?) -> text\n" +
            "    \"\"\n"
        val module = parse_and_build_module(src, "inline_extern_composite_probe.spl")
        expect(parser_error_count()).to_equal(0)
        expect(order_count(module, "rt_composite")).to_equal(1)

    it "rejects a nested extern conflicting with a prior top-level extern":
        val src = "extern fn rt_top_conflict(value: i64) -> i64\n" +
            "\n" +
            "fn caller(value: i64) -> i64:\n" +
            "    extern fn rt_top_conflict(value: u64) -> i64\n" +
            "    value\n"
        val module = parse_and_build_module(src, "inline_extern_top_conflict_probe.spl")
        expect(order_count(module, "rt_top_conflict")).to_equal(1)
        expect(parser_error_count()).to_equal(1)
        expect(parser_get_errors().join("\n")).to_contain("conflicting extern declaration: rt_top_conflict")
