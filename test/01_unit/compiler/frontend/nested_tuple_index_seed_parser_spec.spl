# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




"""
Feature: Nested Tuple Index Parsing
Category: Compiler Frontend
Status: Active
"""

# Regression spec for
# doc/08_tracking/bug/seed_nested_tuple_index_float_munch_2026-08-06.md
#
# The seed lexer is context-free, so in `r.0.1` it munched the `0.1` following
# the first `.` into a single Float token. The postfix parser's tuple-index arm
# only accepted `TokenKind::Integer`, so nested tuple indexing died at parse
# time -- before any type or codegen work -- with:
#
#     Unexpected token: expected identifier, found Float(0.1)
#
# Fix: `split_tuple_index_pair` in
# src/compiler_rust/parser/src/expressions/postfix.rs re-splits a
# `digits.digits` LEXEME (not the f64 value -- `.0.1` and `.0.10` share the
# value 0.1) back into two tuple indices.
#
# The `does not break real floats` block below is the ablation half: it fences
# the fix against over-reach, since the same token stream carries genuine float
# literals.

use std.spec.step

use spec.{describe, it, expect}

describe("nested tuple indexing parses"):
    it("reads a two-level index r.0.1"):
        # @req REQ-SSPEC-UNIT
        # @req REQ-SSPEC-UNIT
        val r = ((1, 2), (3, 4))
        expect(r.0.0).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(r.1.0).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(r.1.1).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it("reads the other two-level paths"):
        val r = ((1, 2), (3, 4))
        expect(r.0.0).to_equal(1)
        expect(r.1.0).to_equal(3)
        expect(r.1.1).to_equal(4)

    it("reads a three-level index r.0.1.0"):
        val r = ((1, (7, 8)), (3, 4))
        expect(r.0.1.0).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(r.0.1.1).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "still reads a single-level index":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: still reads a single-level index")
        val r = (10, 20)
        expect(r.0).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(r.1).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "allows a method call after a nested index":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: allows a method call after a nested index")
        val r = ((1, 2), (3, 4))
        expect(r.0.1.to_string()).to_equal("2")

describe "nested tuple index fix does not break real floats":
    it "keeps a plain float literal a float":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps a plain float literal a float")
        val x = 0.1
        expect(x > 0.09 and x < 0.11).to_equal(true)

    it "keeps a float literal in an expression":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps a float literal in an expression")
        expect(1.5 + 1.5).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement

    it "keeps exponent-form floats":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps exponent-form floats")
        val e = 1e3
        expect(e > 999.0 and e < 1001.0).to_equal(true)

    it "keeps a float returned from a call":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps a float returned from a call")
        expect((2.0).to_string().starts_with("2")).to_equal(true)
