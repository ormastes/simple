# Regression: convert_flat_pattern built PatternKind.Array(elems, nil); MIR
# rejects nil into the `text?` rest slot ("use None"). Exercises the array
# pattern path through the flat AST bridge (interpreter-level; the MIR proof is
# the Stage 2 native-build of convert_nodes).
describe "flat AST array pattern":
    it "matches array literal patterns by length and elements":
        val v = [1, 0]
        var r = 0
        match v:
            case [1, 0]: r = 1
            case _: r = 2
        expect(r).to_equal(1)
