use std.spec.{describe, it, expect}
use compiler.frontend.core.lexer.{lex_tokenize_all, lexer_state_take, lexer_state_install}

describe "lexer ParseContext snapshot (stage 1)":
    it "take isolates token streams and install restores them":
        val a_count = lex_tokenize_all("val a = 1")
        val a = lexer_state_take()
        expect(a.lex_all_kinds.len()).to_equal(a_count)
        expect(a.lex_all_texts.len()).to_equal(a_count)

        val fresh = lexer_state_take()
        expect(fresh.lex_all_kinds.len()).to_equal(0)

        val b_count = lex_tokenize_all("fn f(x: i64) -> i64: x")
        expect(b_count > a_count).to_equal(true)
        val b = lexer_state_take()

        lexer_state_install(a)
        val again = lexer_state_take()
        expect(again.lex_all_kinds.len()).to_equal(a_count)
        expect(again.lex_all_texts).to_equal(a.lex_all_texts)
        lexer_state_install(b)
