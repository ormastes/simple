"""
A unit suffix glued to a call/index result (`f(n)_sfx`) is a parse error
with a fix hint; only a group takes a suffix (`(f(n))_sfx`). `text * 1_sfx`
is a semantic error. Unit*unit and unit*int scaling are unaffected.
Bug: paren_expr_unit_suffix_parsed_as_call_2026-11-16.
"""

use std.spec
use compiler.core.ast.{ast_reset}
use compiler.frontend.core.frontend.{core_frontend_parse_reset}

unit FreeBytes: i64 as fbytes

fn spec_parses(source: text) -> bool:
    ast_reset()
    core_frontend_parse_reset(source, "call_result_unit_suffix.spl")

fn two() -> i64:
    2

describe "Unit suffix after a call or index result":
    it "pure-Simple parser rejects f(n)_sfx":
        expect(spec_parses("val x = f(2)_fbytes\n")).to_equal(false)

    it "pure-Simple parser rejects a[i]_sfx":
        expect(spec_parses("val x = a[0]_fbytes\n")).to_equal(false)

    it "pure-Simple parser accepts the grouped form (f(n))_sfx":
        expect(spec_parses("val x = (f(2))_fbytes\n")).to_equal(true)

    it "pure-Simple parser still accepts f(n) followed by a spaced name":
        expect(spec_parses("val x = f(2)\nval y = _z\n")).to_equal(true)

    it "grouped call result takes the suffix at runtime":
        expect((two())_fbytes).to_equal(2_fbytes)

    it "unit * int scaling still works":
        expect(3_fbytes * 2).to_equal(6_fbytes)

    it "unit * unit of the same unit is not rejected as non-numeric":
        val p = 3_fbytes * 2_fbytes
        expect(p.to_string().contains("6")).to_equal(true)
