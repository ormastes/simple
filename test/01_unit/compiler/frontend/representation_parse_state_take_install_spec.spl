use std.spec.{describe, it, expect}
use compiler.frontend.core.representation_declarations_v1.{representation_parse_state_take, representation_parse_state_install}

describe "RepresentationParseState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = representation_parse_state_take()
        val fresh = representation_parse_state_take()
        expect(fresh.representation_frames_v1.len()).to_equal(0)
        representation_parse_state_install(a)
        val again = representation_parse_state_take()
        expect(again.representation_frames_v1.len()).to_equal(a.representation_frames_v1.len())
        representation_parse_state_install(again)
