use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}

describe "top-level control flow synthetic main":
    it "synthesizes main for a binding followed only by if":
        val source = "val value = 40 + 1\nif value != 41:\n    panic(\"wrong value\")\n"
        val module = parse_full_frontend(source, "script_if.spl", "script_if.spl", Logger(level: 0))
        val main = module.functions["main"] ?? panic("missing script main")
        expect(main.body.stmts.len()).to_equal(2)

    it "synthesizes main for a binding followed only by for":
        val source = "val values = [1, 2, 3]\nfor value in values:\n    print value\n"
        val module = parse_full_frontend(source, "script_for.spl", "script_for.spl", Logger(level: 0))
        val main = module.functions["main"] ?? panic("missing script main")
        expect(main.body.stmts.len()).to_equal(2)

    it "synthesizes main for a binding followed only by while":
        val source = "var count = 0\nwhile count < 3:\n    count = count + 1\n"
        val module = parse_full_frontend(source, "script_while.spl", "script_while.spl", Logger(level: 0))
        val main = module.functions["main"] ?? panic("missing script main")
        expect(main.body.stmts.len()).to_equal(2)

    it "preserves an explicit main and initializer control flow":
        val source = "val value = 41\nif value != 41:\n    panic(\"wrong value\")\nfn main() -> i64:\n    42\n"
        val module = parse_full_frontend(source, "explicit_main.spl", "explicit_main.spl", Logger(level: 0))
        val main = module.functions["main"] ?? panic("missing explicit main")
        expect(main.body.stmts.len()).to_equal(1)
        expect(module.functions.len()).to_equal(1)
        expect(module.constants.len()).to_equal(2)

    it "does not classify authored control-like binding names as statements":
        val source = "val _if_0 = 1\nval _for_1 = 2\nval _while_2 = 3\n"
        val module = parse_full_frontend(source, "bindings.spl", "bindings.spl", Logger(level: 0))
        expect(module.functions.contains("main")).to_equal(false)
        expect(module.constants.len()).to_equal(3)
