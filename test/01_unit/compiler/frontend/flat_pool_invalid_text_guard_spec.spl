# @req: REQ-COMPILER-FRONTEND-001
# Bug stage2_mir_shard_flat_pool_text_len_minus1_2026_10_22: a dangling pool
# text (rt_string_len == -1) must be rejected by HANDLE before the encoder
# reads its bytes (flat_pool_escape). The checks live in the fixture
# test/fixtures/compiler/flat_pool_sanitize_invalid_text.spl, which needs a
# real `main` (the invalid text is the provider's NIL word for an absent
# element; the spec interpreter rejects that word at the call boundary).
# Fixture exit codes: 40/41 handle classifier, 42 text pool (repro),
# 43/44 sibling text_list / text_list_list pools, 47 escape reached before the
# guard, 45 validate-only arm, 46 valid-text encode coverage.
use std.spec
use std.io_runtime.{env_get, env_set}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}

fn runner() -> text:
    val configured = env_get("SIMPLE_FLAT_POOL_INVALID_TEXT_RUNNER") ?? ""
    if configured != "":
        return configured
    if file_exists("bin/simple.exe"):
        return "bin/simple.exe"
    "bin/simple"

describe "flat pool invalid text guard":
    it "rejects invalid text handles before escaping them in every text pool":
        step("Run the invalid-text fixture through the encoder sanitize, validate and strict-valid arms")
        val fixture = "test/fixtures/compiler/flat_pool_sanitize_invalid_text.spl"
        expect(file_exists(fixture)).to_equal(true)
        # The test runner exports SIMPLE_EXECUTION_MODE=interpret and
        # (test_runner_single.spl) and the child inherits it; under the
        # interpreter the fixture's NIL text word fails with "cannot convert
        # array to int". Run the child on the JIT ("" is rejected as a mode).
        val saved_exec = env_get("SIMPLE_EXECUTION_MODE") ?? ""
        env_set("SIMPLE_EXECUTION_MODE", "jit")
        val (out, err, code) = process_run_timeout(runner(), ["run", fixture], 600000)
        env_set("SIMPLE_EXECUTION_MODE", saved_exec)
        expect(code).to_equal(0)
        expect(out).to_contain("sanitize-invalid-text-ok")
        expect(out).to_contain("[flat-pool] capture refused: invalid text handle site=text.value item=1 input_length=-1")
        expect(err.contains("flat pool encoder string builder append failed")).to_equal(false)
