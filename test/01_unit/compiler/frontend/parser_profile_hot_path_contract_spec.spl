use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "parser profile hot-path policy":
    it "shares one parse-scoped environment decision":
        val parser = file_read("src/compiler/10.frontend/core/parser.spl")
        val decls = file_read(
            "src/compiler/10.frontend/core/parser_decls_use.spl")
        val codec_guard = file_read(
            "scripts/check/check-flat-ast-codec-complete.shs")
        expect(parser).to_contain("par_prof_enabled_cached = -1")
        # Pin refreshed 2026-11-05 (provenance 5cfc7fc8590 "perf(parser):
        # PARSEPROF instrumentation"): the profile env sample now routes
        # through the canonical std.io_runtime env_get facade instead of the
        # raw rt_env_get extern.
        expect(parser).to_contain(
            "env_get(\"SIMPLE_PARSE_PROFILE\")")
        expect(parser).to_contain("export par_prof_enabled")
        expect(codec_guard).to_contain(
            "ast_reset_seq|par_prof_enabled_cached")
        expect(parser).to_not_contain(
            "flat_pool_enc_scalar_i64(par_prof_enabled_cached)")
        expect(parser).to_not_contain(
            "par_prof_enabled_cached = flat_pool_dec_scalar_i64(r)")
        expect(decls).to_contain("if not par_prof_enabled():")
        expect(decls).to_not_contain("env_get(\"SIMPLE_PARSE_PROFILE\")")

    it "keeps disabled clocks and enabled interval output lazy":
        val decls = file_read(
            "src/compiler/10.frontend/core/parser_decls_use.spl")
        expect(decls).to_contain(
            "if t0 == 0:\n        return 0")
        expect(decls).to_contain("val now = time_now_unix_micros()")
        # Pin refreshed 2026-11-05: braces escaped (\{label\}, \{now - t0\}) so
        # the spec string carries the literal source text instead of
        # interpolating; same escaped-brace class as ca61588c2b3.
        expect(decls).to_contain(
            "print(\"PARSEPROF\\t\{label\}\\t\{now - t0\}\")")
        expect(decls).to_contain("var _pp = parse_prof_now()")
        # Pins refreshed 2026-11-05 (provenance 5cfc7fc8590): the declaration
        # probe labels gained a "method:" prefix; same marks, same laziness.
        expect(decls).to_contain("parse_prof_mark(\"method:signature\", _pp)")
        expect(decls).to_contain("parse_prof_mark(\"method:body\", _pp)")
        expect(decls).to_contain("parse_prof_mark(\"method:declreg\", _pp)")
