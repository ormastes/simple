use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "parser profile hot-path policy":
    it "shares one parse-scoped environment decision":
        val parser = file_read("src/compiler/10.frontend/core/parser.spl")
        val decls = file_read(
            "src/compiler/10.frontend/core/parser_decls_use.spl")
        expect(parser).to_contain("par_prof_enabled_cached = -1")
        expect(parser).to_contain(
            "rt_env_get(\"SIMPLE_PARSE_PROFILE\")")
        expect(parser).to_contain("export par_prof_enabled")
        expect(decls).to_contain("if not par_prof_enabled():")
        expect(decls).not.to_contain("env_get(\"SIMPLE_PARSE_PROFILE\")")

    it "keeps disabled clocks and enabled interval output lazy":
        val decls = file_read(
            "src/compiler/10.frontend/core/parser_decls_use.spl")
        expect(decls).to_contain(
            "if t0 == 0:\n        return 0")
        expect(decls).to_contain("val now = time_now_unix_micros()")
        expect(decls).to_contain(
            "print(\"PARSEPROF\\t{label}\\t{now - t0}\")")
        expect(decls).to_contain("var _pp = parse_prof_now()")
        expect(decls).to_contain("parse_prof_mark(\"signature\", _pp)")
        expect(decls).to_contain("parse_prof_mark(\"body\", _pp)")
        expect(decls).to_contain("parse_prof_mark(\"declreg\", _pp)")
