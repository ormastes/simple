# @req REQ-SSPEC-COMPILER
# @cover src/compiler_rust/parser/src/parser_impl/functions.rs 0%
"""
# One-line function body that is a `return` statement

**Category:** Language / Parser
**Status:** Regression guard

`fn f() -> i64: return 0` used to parse `return` as an identifier expression
instead of a return statement (JIT HIR lowering failed). The single-line body
path of function definitions now routes `return`/`break`/`continue`/`pass`
through the statement parser.
"""
use std.spec.step
use std.spec.*

fn oneline_ret_zero() -> i64: return 0
fn oneline_ret_inc(x: i64) -> i64: return x + 1
fn oneline_ret_unit(): return
fn oneline_pass(): pass

describe "one-line return body":
    it "returns a literal":
        step("call fn with inline return literal")
        expect(oneline_ret_zero()).to_equal(0)
    it "returns an expression of a parameter":
        step("call fn with inline return expression")
        expect(oneline_ret_inc(4)).to_equal(5)
    it "accepts bare return and pass":
        step("call unit fns with inline return / pass")
        oneline_ret_unit()
        oneline_pass()
        expect(true).to_be(true)
