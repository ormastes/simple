# The CStr facade is chosen from the PARSED return type of an extern
# signature, not from the text `-> CStr`: arrow spacing and trailing comments
# do not change the dispatch, and a unit/type that merely contains or prefixes
# the name `CStr` (e.g. `CStrLen`) is not a borrowed-pointer return.
# Runtime: src/compiler/90.tools/sffi_gen/constrained_unit_scan.spl
use std.spec.{describe, it, expect}
use compiler.tools.sffi_gen.constrained_unit_scan.{generate_constrained_unit_facades}

describe "SFFI CStr facade dispatch on the parsed return type":
    it "recognises a return written without spaces around the arrow":
        val r = generate_constrained_unit_facades("extern fn rt_v()->CStr\n")
        expect(r.source).to_contain("rt_cstring_to_text(ptr)")

    it "recognises a return followed by a comment":
        val r = generate_constrained_unit_facades("extern fn rt_v() ->   CStr   # borrowed\n")
        expect(r.source).to_contain("rt_cstring_to_text(ptr)")

    it "recognises a return with tab separators":
        val r = generate_constrained_unit_facades("extern\tfn rt_v(a: i64)\t->\tCStr\n")
        expect(r.source).to_contain("rt_cstring_to_text(ptr)")

    it "does not treat a type that only starts with CStr as a borrowed pointer":
        val r = generate_constrained_unit_facades("extern fn rt_v() -> CStrLen\n")
        expect(r.source).to_equal("")

    it "does not take a parameter or comment mentioning CStr as the return":
        val r = generate_constrained_unit_facades("extern fn rt_v(p: CStr) -> i64 # -> CStr\n")
        expect(r.source).to_equal("")
