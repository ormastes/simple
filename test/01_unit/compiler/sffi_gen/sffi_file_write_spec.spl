extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text?

val SFFI_WRITERS = [
    "src/compiler/90.tools/sffi_gen/sffi_gen_workspace.spl",
    "src/compiler/90.tools/sffi_gen/_SffiGenMain/cli_and_generate.spl"
]

describe "sffi_file_write":
    it "no longer shells out to /bin/sh heredoc (Windows-portable)":
        for f in SFFI_WRITERS:
            val src = rt_file_read_text(f) ?? ""
            expect(src.contains("fn sffi_file_write")).to_equal(true)
            expect(src.contains("SIMPLE_WRITE_EOF")).to_equal(false)
            expect(src.contains("rt_file_write_text(path, content)")).to_equal(true)

    it "writes quotes, dollars, backticks and heredoc markers byte-exact":
        val path = "build/sffi_file_write_spec_a.txt"
        val content = "a 'q' \"dq\" $HOME `ls`\nSIMPLE_WRITE_EOF\nline3"
        expect(rt_file_write_text(path, content)).to_equal(true)
        expect(rt_file_read_text(path) ?? "").to_equal(content)
