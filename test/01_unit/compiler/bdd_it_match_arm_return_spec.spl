# Regression: `return` inside a match arm of an `it` body must end only that
# example, not escape as the seed's "try: early return" error.
use std.spec.*

fn pick(flag: bool) -> Result<i64, text>:
    if flag:
        Ok(1)
    else:
        Err("no")

describe "return inside match arm of an it block":
    it "ends the example on Err arm return":
        val v = match pick(false):
            case Ok(value): value
            case Err(reason):
                expect(reason).to_equal("no")
                return
        expect(v).to_equal(-1)

    it "continues past the Ok arm":
        val v = match pick(true):
            case Ok(value): value
            case Err(reason):
                return
        expect(v).to_equal(1)

    it "ends the example on if-expression return":
        val v = if pick(false).is_err():
            return
        else:
            5
        expect(v).to_equal(-1)
