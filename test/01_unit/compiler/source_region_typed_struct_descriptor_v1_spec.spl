use std.spec.{describe, it, expect}
use compiler.backend.common.source_region_descriptor_v1.*
use compiler.backend.common.source_region_typed_struct_descriptor_v1.*
use compiler.common.source_region_descriptor_schema_v1.*
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{MirTypeDef, MirTypeDefKind, MirFieldDef, MirType, MirTypeKind}
use compiler.mir.mir_instruction_support.{MirOperand, mir_operand_const_int}

fn source_region_typed_descriptor_fixture_v1(key: MirType, child_exists: bool = true) -> Dict<SymbolId, MirTypeDef>:
    val child = MirType(kind: MirTypeKind.Struct(SymbolId(id: 20)))
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[SymbolId(id: 10)] = MirTypeDef(symbol: SymbolId(id: 10), name: "Root",
        kind: MirTypeDefKind.Struct([MirFieldDef(name: "dictionary", type_: MirType(kind: MirTypeKind.Dict(key, child)), offset: 0, has_bits_attr: false, bits_width: 0)]), is_export_c: false, export_name: "")
    if child_exists:
        types[SymbolId(id: 20)] = MirTypeDef(symbol: SymbolId(id: 20), name: "Child",
            kind: MirTypeDefKind.Struct([MirFieldDef(name: "id", type_: MirType.i64(), offset: 0, has_bits_attr: false, bits_width: 0)]), is_export_c: false, export_name: "")
    types

fn source_region_typed_descriptor_args_v1(owner: i64, token: i64) -> [MirOperand]:
    [mir_operand_const_int(owner), mir_operand_const_int(2), mir_operand_const_int(token)]

describe "C4 nominal Struct-to-Dictionary descriptor recipe":
    it "resolves exact declared dictionaries to physical4 on both backends":
        val types = source_region_typed_descriptor_fixture_v1(MirType.i64())
        var digest = ""
        for physical_struct in [1, 2]:
            match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(10, 5), physical_struct):
                case Ok(recipe):
                    expect(recipe.slots.len()).to_equal(1)
                    expect(recipe.slots[0].kind).to_equal(2)
                    expect(recipe.slots[0].representation).to_equal(4)
                    expect(recipe.recipe_digest.len()).to_equal(64)
                    if digest != "": expect(recipe.recipe_digest).to_equal(digest)
                    digest = recipe.recipe_digest
                case Err(_): assert(false)

    it "refuses token5 in the old pair-only descriptor route":
        match source_region_resolve_struct_slots_v1([SourceRegionSlotV1(kind: 2, representation: 5)], 1):
            case Err(error): expect(error).to_equal(SourceRegionDescriptorErrorV1.InvalidRepresentation)
            case Ok(_): assert(false)

    it "refuses a physical4 integer instead of typed Dictionary selection":
        val types = source_region_typed_descriptor_fixture_v1(MirType.i64())
        match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(10, 4), 1):
            case Err(error): expect(error).to_equal(SourceRegionDescriptorErrorV1.InvalidTypeRecipe)
            case Ok(_): assert(false)

    it "does not authorize a raw containing symbol without an actual definition":
        val types = source_region_typed_descriptor_fixture_v1(MirType.i64())
        match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(99, 5), 1):
            case Err(error): expect(error).to_equal(SourceRegionDescriptorErrorV1.InvalidTypeRecipe)
            case Ok(_): assert(false)

    it "rejects a non-i64 declared dictionary key":
        val types = source_region_typed_descriptor_fixture_v1(MirType(kind: MirTypeKind.U64))
        match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(10, 5), 1):
            case Err(error): expect(error).to_equal(SourceRegionDescriptorErrorV1.InvalidTypeRecipe)
            case Ok(_): assert(false)

    it "requires the actual nominal value layout to resolve":
        val types = source_region_typed_descriptor_fixture_v1(MirType.i64(), false)
        match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(10, 5), 1):
            case Err(error): expect(error).to_equal(SourceRegionDescriptorErrorV1.InvalidTypeRecipe)
            case Ok(_): assert(false)

    it "binds the nominal value layout into the compiler recipe digest":
        var types = source_region_typed_descriptor_fixture_v1(MirType.i64())
        var before = ""
        match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(10, 5), 1):
            case Ok(recipe): before = recipe.recipe_digest
            case Err(_): assert(false)
        types[SymbolId(id: 20)] = MirTypeDef(symbol: SymbolId(id: 20), name: "Child",
            kind: MirTypeDefKind.Struct([MirFieldDef(name: "id", type_: MirType(kind: MirTypeKind.U64), offset: 0, has_bits_attr: false, bits_width: 0)]), is_export_c: false, export_name: "")
        match source_region_struct_descriptor_typed_v1(types, source_region_typed_descriptor_args_v1(10, 5), 1):
            case Ok(recipe): expect(recipe.recipe_digest == before).to_equal(false)
            case Err(_): assert(false)

    it "confines physical4 to shape1 mutable dictionary fields":
        expect(source_region_descriptor_schema_row_v1(1, 8u64, 1, 0, 0u64, 8u64, 2u64, 4u64)).to_equal(true)
        expect(source_region_descriptor_schema_row_v1(1, 8u64, 1, 0, 0u64, 8u64, 1u64, 4u64)).to_equal(false)
        expect(source_region_descriptor_schema_row_v1(1, 8u64, 1, 0, 0u64, 8u64, 3u64, 4u64)).to_equal(false)
        expect(source_region_descriptor_schema_row_v1(4, 64u64, 2, 1, 8u64, 8u64, 2u64, 4u64)).to_equal(false)
