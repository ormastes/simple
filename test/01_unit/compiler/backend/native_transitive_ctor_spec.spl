use std.spec
use .fixtures.xctor_maker.{make_xport}

describe "transitively imported class constructor":
    """
    A class declared in one module and constructed inside another imported
    module must resolve in the provider module's context.
    """
    it "builds the value in the provider module's context":
        step("construct XPort through the importing module")
        val p = make_xport("sqlite3")
        expect(p.kind).to_equal("sqlite3")
        expect(p.version).to_equal(1)
