"""Prevention contract spec for x86_64 native ISel float tuple/struct reconciliation (#5145)."""

use std.spec.*
use std.io_runtime.{file_read}
use compiler.backend.native.mach_inst.{
    X86_OP_MOVQ_XMM_GPR, X86_OP_MOVQ_GPR_XMM,
    X86_OP_MOVSD_REG_MEM, X86_OP_MOVSD_MEM_REG,
    X86_OP_MOVSS_REG_MEM, X86_OP_MOVSS_MEM_REG
}

describe "CompFix-14 scalar float tuple reconciliation contract":
    it "places SSE scalar opcodes outside regalloc AVX-512 frame range 400..450":
        expect(X86_OP_MOVQ_XMM_GPR >= 500).to_equal(true)
        expect(X86_OP_MOVSS_MEM_REG <= 505).to_equal(true)
        expect(X86_OP_MOVQ_GPR_XMM > X86_OP_MOVQ_XMM_GPR).to_equal(true)
        expect(X86_OP_MOVSD_MEM_REG > X86_OP_MOVSD_REG_MEM).to_equal(true)

    it "keeps float constant lowering and field reconciliation wired while preserving AArch64 float rejection":
        val isel_src = file_read("src/compiler/70.backend/backend/native/isel_x86_64.spl")
        val ctx_src = file_read("src/compiler/70.backend/backend/common/isel_context.spl")
        val a64_src = file_read("src/compiler/70.backend/backend/native/isel_aarch64.spl")
        expect(ctx_src).to_contain("float_locals: Dict<i64, i64>")
        expect(isel_src).to_contain("case Float(v):")
        expect(isel_src).to_contain("case FloatLexeme(decimal_lexeme):")
        expect(isel_src).to_contain("x64_reconcile_store_field_value")
        expect(isel_src).to_contain("x64_reconcile_load_field_value")
        expect(a64_src).to_contain("Float")
