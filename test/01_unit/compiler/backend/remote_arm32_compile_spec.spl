# @cover src/compiler/70.backend/backend/native/remote_arm32_compile.spl

use compiler.backend.backend.native.remote_arm32_compile.{compile_remote_arm32_binary}

describe "remote ARM32 compiler boundary":
    it "rejects empty source before invoking LLVM":
        val result = compile_remote_arm32_binary("   \n", 0x40010000)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("source must not be empty")

    it "rejects a misaligned placement address before invoking LLVM":
        val result = compile_remote_arm32_binary("fn main() -> i64:\n    0\n", 0x40010002)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("4-byte aligned")
