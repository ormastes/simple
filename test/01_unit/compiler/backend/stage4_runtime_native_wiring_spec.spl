use test.helpers.compiler_native_link_source.{compiler_native_link_source}
use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "Stage4 runtime-native wiring":
    it "keeps CUDA and Vulkan-compute fallbacks weak so dynamic providers win":
        val source = rt_file_read_text("src/runtime/runtime_native.c") ?? ""
        expect(source).to_contain(
            "SPL_HOSTED_UNAVAILABLE_WEAK int64_t rt_cuda_available(void)")
        expect(source).to_contain(
            "SPL_HOSTED_UNAVAILABLE_WEAK int64_t rt_cuda_device_count(void)")
        expect(source).to_contain(
            "SPL_HOSTED_UNAVAILABLE_WEAK int32_t rt_vk_available(void)")
        expect(source).to_contain(
            "spl_hosted_provider_i64_probe(\"rt_cuda_provider_available\")")
        expect(source).to_contain(
            "spl_hosted_provider_i64_probe(\"rt_cuda_provider_device_count\")")
        expect(source).to_contain(
            "spl_hosted_provider_i32_probe(\"rt_vk_provider_available\")")

    it "keeps Vulkan availability fallbacks weak so real providers win":
        val source = rt_file_read_text("src/runtime/runtime_native.c") ?? ""
        expect(source).to_contain(
            "SPL_HOSTED_UNAVAILABLE_WEAK int64_t rt_vulkan_is_available(void)")
        expect(source).to_contain(
            "SPL_HOSTED_UNAVAILABLE_WEAK int64_t rt_vulkan_device_count(void)")
        expect(source).to_contain("dlsym(RTLD_DEFAULT, symbol)")
        expect(source).to_contain(
            "return spl_hosted_provider_i64_probe(\"rt_vulkan_provider_is_available\")")
        expect(source).to_contain(
            "return spl_hosted_provider_i64_probe(\"rt_vulkan_provider_device_count\")")

    it "localizes legacy dynload owners before archive inventory":
        val source = compiler_native_link_source()
        val build_start: i64 = source.find("fn llvm_stage4_build_runtime_native_archive(")
        val next_start: i64 = source.find("fn llvm_stage4_build_dynload_provider_archive(")
        val build_source = if build_start >= 0 and next_start > build_start: source.substring(build_start, next_start) else: ""
        expect(build_start).to_be_greater_than(-1)
        expect(next_start).to_be_greater_than(build_start)

        val match_pos: i64 = build_source.find("stage4_runtime_provider_object_matches(object, \"runtime_native\"")
        val raw_scan_pos: i64 = build_source.find("stage4_runtime_native_localization_symbols(raw_nm_out, object_format)")
        val objcopy_pos: i64 = build_source.find("\"--localize-symbols=\" + localize_path")
        val contract_pos: i64 = build_source.find("stage4_validate_runtime_native_core_symbol_contract(localized_nm_out, object_format)")
        val archive_pos: i64 = build_source.find("process_run(archiver, [\"rcsD\", archive_path, localized_object])")
        val member_pos: i64 = build_source.find("members != \"runtime_native\" + object_ext")
        val inventory_pos: i64 = build_source.find("llvm_stage4_candidate_archive_inventory([\"runtime_native\"], [archive_path])")
        expect(match_pos).to_be_greater_than(-1)
        expect(raw_scan_pos).to_be_greater_than(match_pos)
        expect(objcopy_pos).to_be_greater_than(raw_scan_pos)
        expect(contract_pos).to_be_greater_than(objcopy_pos)
        expect(archive_pos).to_be_greater_than(contract_pos)
        expect(member_pos).to_be_greater_than(archive_pos)
        expect(inventory_pos).to_be_greater_than(member_pos)

    it "resolves current owners before exact selected archive projection":
        val source = compiler_native_link_source()
        val strict_start: i64 = source.find("var stage4_requested_symbols: [text] = []")
        val strict_source = if strict_start >= 0: source.substring(strict_start) else: ""
        val native_pos: i64 = strict_source.find("llvm_stage4_build_runtime_native_archive(")
        val labels_pos: i64 = strict_source.find("\"compiler_backfill\", \"runtime_native\", \"runtime_contracts\", \"runtime_legacy_compat\", \"runtime_process\", \"runtime_dynload\"")
        val owner_pos: i64 = strict_source.find("stage4_resolve_requested_archive_owners(")
        val projection_pos: i64 = strict_source.find("llvm_stage4_project_selected_archives(candidate_labels, candidate_paths, selected_archive_indices, stage4_requested_symbols")
        val cleanup_pos: i64 = strict_source.find("llvm_stage4_cleanup_candidate_inputs(candidate_paths")
        expect(native_pos).to_be_greater_than(-1)
        expect(labels_pos).to_be_greater_than(native_pos)
        expect(owner_pos).to_be_greater_than(labels_pos)
        expect(projection_pos).to_be_greater_than(owner_pos)
        expect(cleanup_pos).to_be_greater_than(projection_pos)
        expect(strict_source).to_contain("if hosted_os != \"windows\":")
