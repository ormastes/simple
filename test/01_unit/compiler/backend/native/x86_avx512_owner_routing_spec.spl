"""Regression for scalar instructions being routed into the AVX-512 owner."""

use std.spec.*
use compiler.mir.mir_data.*
use compiler.backend.native.x86_64_avx512_lower.{x86_avx512_handles}
use std.io_runtime.{file_read}

fn scalar_const_inst() -> MirInst:
    MirInst(
        kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Int(1), MirType.i64()),
        span: nil
    )

fn vector_splat_inst() -> MirInst:
    val vector = MirType(kind: MirTypeKind.Vec16i)
    MirInst(
        kind: MirInstKind.MirSimdSplat(LocalId(id: 1), MirOperand.const_int(1), vector),
        span: nil
    )

describe "AVX-512 instruction ownership":
    it "rejects an ordinary scalar instruction even when vector shapes exist":
        var shapes: Dict<i64, text> = {}
        shapes[1] = "i32x16"
        expect(x86_avx512_handles(scalar_const_inst(), shapes)).to_be_false()

    it "accepts an explicit fixed-width SIMD instruction":
        var shapes: Dict<i64, text> = {}
        shapes[1] = "i32x16"
        expect(x86_avx512_handles(vector_splat_inst(), shapes)).to_be_true()

    it "leaves SIMD on fallback paths when AVX-512 is denied":
        val denied_shapes: Dict<i64, text> = {}
        expect(x86_avx512_handles(vector_splat_inst(), denied_shapes)).to_be_false()

        var unrelated_shapes: Dict<i64, text> = {}
        unrelated_shapes[2] = "i32x16"
        expect(x86_avx512_handles(vector_splat_inst(), unrelated_shapes)).to_be_false()

    it "does not name an owner method after the text builtin lower":
        # The Rust seed binds an untyped bare `x.lower()` to the only user
        # `*.lower` method; a method of that name here captured every text
        # lowercase call and aborted the seed-built Stage 2 on hello world.
        val source = file_read("src/compiler/70.backend/backend/native/x86_64_avx512_lower.spl")
        expect(source.contains("me lower(")).to_be_false()
