# @cover src/compiler/70.backend/backend/native/mod.spl
# @req REQ-REMOTE-JIT-RV32-RAW-001
"""RV32 remote images contain instruction bytes only, in function order."""

use compiler.backend.backend.native.mach_inst.{EncodedReloc, EncodedFunction}
use compiler.backend.backend.native.encode_riscv32.{RV32_R_RISCV_CALL_PLT}
use compiler.backend.backend.native.mod.{rv32_encoded_code, rv32_link_raw_image}

describe "RV32 raw remote image":
    it "concatenates encoded functions without ELF framing":
        val first = EncodedFunction(name: "main", code: [0x13, 0x05, 0xa0, 0x02], relocations: [])
        val second = EncodedFunction(name: "halt", code: [0x73, 0x00, 0x10, 0x00], relocations: [])

        val image = rv32_encoded_code([first, second])

        expect(image).to_equal([0x13, 0x05, 0xa0, 0x02, 0x73, 0x00, 0x10, 0x00])
        expect(image.len()).to_equal(8)

    it "resolves internal AUIPC JALR calls against the placed image":
        val call = EncodedReloc(offset: 0, symbol_name: "answer", reloc_type: RV32_R_RISCV_CALL_PLT, addend: 0)
        val main = EncodedFunction(
            name: "main", code: [0x97, 0x00, 0x00, 0x00, 0xe7, 0x80, 0x00, 0x00], relocations: [call])
        val answer = EncodedFunction(name: "answer", code: [0x67, 0x80, 0x00, 0x00], relocations: [])

        val linked = rv32_link_raw_image([main, answer], 0x80010000)

        expect(linked.is_ok()).to_equal(true)
        expect(linked.unwrap().slice(0, 8)).to_equal(
            [0x97, 0x00, 0x00, 0x00, 0xe7, 0x80, 0x80, 0x00])

    it "fails closed when a raw call names an external symbol":
        val call = EncodedReloc(offset: 0, symbol_name: "missing", reloc_type: RV32_R_RISCV_CALL_PLT, addend: 0)
        val main = EncodedFunction(
            name: "main", code: [0x97, 0x00, 0x00, 0x00, 0xe7, 0x80, 0x00, 0x00], relocations: [call])

        val linked = rv32_link_raw_image([main], 0x80010000)

        expect(linked.is_err()).to_equal(true)

    it "encodes a backward internal call with a signed low immediate":
        val answer = EncodedFunction(name: "answer", code: [0x67, 0x80, 0x00, 0x00], relocations: [])
        val call = EncodedReloc(offset: 0, symbol_name: "answer", reloc_type: RV32_R_RISCV_CALL_PLT, addend: 0)
        val main = EncodedFunction(
            name: "main", code: [0x97, 0x00, 0x00, 0x00, 0xe7, 0x80, 0x00, 0x00], relocations: [call])

        val linked = rv32_link_raw_image([answer, main], 0x80010000)

        expect(linked.is_ok()).to_equal(true)
        expect(linked.unwrap().slice(4, 12)).to_equal(
            [0x97, 0x00, 0x00, 0x00, 0xe7, 0x80, 0xc0, 0xff])

    it "rejects malformed call pairs and duplicate symbols":
        val call = EncodedReloc(offset: 0, symbol_name: "main", reloc_type: RV32_R_RISCV_CALL_PLT, addend: 0)
        val malformed = EncodedFunction(
            name: "main", code: [0x13, 0x00, 0x00, 0x00, 0xe7, 0x80, 0x00, 0x00], relocations: [call])
        val duplicate_a = EncodedFunction(name: "same", code: [0x13, 0x00, 0x00, 0x00], relocations: [])
        val duplicate_b = EncodedFunction(name: "same", code: [0x13, 0x00, 0x00, 0x00], relocations: [])

        expect(rv32_link_raw_image([malformed], 0x80010000).is_err()).to_equal(true)
        expect(rv32_link_raw_image([duplicate_a, duplicate_b], 0x80010000).is_err()).to_equal(true)
