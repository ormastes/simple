use std.spec.*
use compiler.backend.native.x86_64_avx512.{X86_ZMM_ALLOCATABLE, X86_K_ALLOCATABLE}
use std.common.convert.{try_parse_i32}

describe "SIMD native dependency surfaces":
    it "preserves all allocatable ZMM register IDs in order":
        expect(X86_ZMM_ALLOCATABLE.len()).to_equal(32)
        for index in 0..32:
            expect(X86_ZMM_ALLOCATABLE[index]).to_equal(48 + index)

    it "preserves the seven mask IDs and excludes reserved k0":
        expect(X86_K_ALLOCATABLE.len()).to_equal(7)
        for index in 0..7:
            expect(X86_K_ALLOCATABLE[index]).to_equal(81 + index)

    it "range-checks signed i32 bounds before narrowing SVE byte counts":
        expect((try_parse_i32("2147483647") ?? 0).to_i32()).to_equal(2147483647)
        expect((try_parse_i32("-2147483648") ?? 0).to_i32()).to_equal(-2147483648)
        expect((try_parse_i32(" 32 ".trim()) ?? 0).to_i32()).to_equal(32)
        expect((try_parse_i32("0") ?? -1).to_i32()).to_equal(0)

    it "rejects invalid and out-of-range byte counts before defaulting to zero":
        expect(try_parse_i32("2147483648")).to_be_nil()
        expect(try_parse_i32("-2147483649")).to_be_nil()
        expect(try_parse_i32("invalid")).to_be_nil()
        expect(try_parse_i32("+")).to_be_nil()
        expect(try_parse_i32("-")).to_be_nil()
        expect(try_parse_i32("")).to_be_nil()
