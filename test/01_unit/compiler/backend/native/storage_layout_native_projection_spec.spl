use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use std.common.structural.storage_layout.storage_layout_contracts.{
    StorageConversionPolicy, StorageLayoutKind, storage_layout_plan_v1
}
use std.common.structural.storage_layout.mapping.{
    storage_layout_project, storage_projection_request_v1
}
use compiler.mir_opt.mir_opt.storage_projection_lowering.{
    MIR_STORAGE_PROJECT_ADDRESS_V1, MIR_STORAGE_PROJECT_FIELD_V1,
    lower_mir_storage_project_fields_v1,
    mir_storage_address_recipe_v1, mir_storage_field_binding_v1,
    mir_storage_view_binding_v1, mir_storage_view_site_binding_v1
}
use compiler.mir.mir_data.*
use compiler.backend.native.isel_x86_64.{isel_module}
use compiler.backend.backend.backend_helpers.{
    compile_module_with_backend_target_cpu_storage_bindings
}
use compiler.backend.native.mach_inst.{
    X86_OP_ADD, X86_OP_ADD_IMM, X86_OP_IMUL, X86_OP_MOV_REG_IMM, X86_OP_NOP
}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}

fn projection_plan(layout: StorageLayoutKind):
    storage_layout_plan_v1(7001, layout, 1, 8, false,
        StorageConversionPolicy.Cached, "wp22-native-v1", "typed-host-view")

fn projection_binding(layout: StorageLayoutKind, observed: bool):
    mir_storage_view_binding_v1(7001, 9, 64, 1024, 16, observed,
        projection_plan(layout), [
            mir_storage_field_binding_v1(0, 0, 1, 0),
            mir_storage_field_binding_v1(1, 4, 4, 64),
            mir_storage_field_binding_v1(2, 8, 8, 320)
        ])

fn projection_intrinsic_module(scale: i64, base_offset: i64) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val ptr_type = MirType(kind: MirTypeKind.Ptr(pointee: i64_type, mutable: true))
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("base"), type_: ptr_type, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 1), name: Some("index"), type_: i64_type, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 2), name: Some("address"), type_: ptr_type, kind: LocalKind.Temp)
    ]
    val instruction = MirInst(kind: MirInstKind.Intrinsic(
        Some(LocalId(id: 2)), MIR_STORAGE_PROJECT_ADDRESS_V1, [
            MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1)),
            MirOperand.const_int(scale),
            MirOperand.const_int(base_offset)
        ]), span: nil)
    val function = MirFunction(
        symbol: SymbolId.new(0), name: "project_address",
        signature: MirSignature(params: [ptr_type, i64_type], return_type: ptr_type, is_variadic: false),
        locals: locals, blocks: [MirBlock(
            id: BlockId.new(0), label: Some("entry"), instructions: [instruction],
            terminator: MirTerminator.Ret(Some(MirOperand.copy(LocalId(id: 2)))))],
        entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = function
    MirModule(name: "storage_projection", functions: functions,
        statics: {}, constants: {}, types: {})

fn logical_projection_module(field: MirOperand) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val ptr_type = MirType(kind: MirTypeKind.Ptr(pointee: i64_type, mutable: true))
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("base"), type_: ptr_type, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 1), name: Some("index"), type_: i64_type, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 2), name: Some("address"), type_: ptr_type, kind: LocalKind.Temp)
    ]
    val instruction = MirInst(kind: MirInstKind.Intrinsic(
        Some(LocalId(id: 2)), MIR_STORAGE_PROJECT_FIELD_V1, [
            MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1)), field
        ]), span: nil)
    val function = MirFunction(
        symbol: SymbolId.new(41), name: "logical_project",
        signature: MirSignature(params: [ptr_type, i64_type], return_type: ptr_type,
            is_variadic: false), locals: locals,
        blocks: [MirBlock(id: BlockId.new(0), label: Some("entry"),
            instructions: [instruction],
            terminator: MirTerminator.Ret(Some(MirOperand.copy(LocalId(id: 2)))))],
        entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(41)] = function
    MirModule(name: "logical_storage_projection", functions: functions,
        statics: {}, constants: {}, types: {})

fn assert_rewritten_recipe(layout: StorageLayoutKind, expected_scale: i64,
                           expected_offset: i64):
    val result = lower_mir_storage_project_fields_v1(
        logical_projection_module(MirOperand.const_int(2)), [
            mir_storage_view_site_binding_v1(41, 0, true, projection_binding(layout, false))
        ])
    assert_true(result.ok)
    assert_equal(result.rewritten_count, 1)
    val instruction = result.module.functions[SymbolId.new(41)].blocks[0].instructions[0]
    match instruction.kind:
        case Intrinsic(_, name, args):
            assert_equal(name, MIR_STORAGE_PROJECT_ADDRESS_V1)
            match args[2].kind:
                case Const(MirConstValue.Int(scale), _): assert_equal(scale, expected_scale)
                case _: assert_true(false)
            match args[3].kind:
                case Const(MirConstValue.Int(offset), _): assert_equal(offset, expected_offset)
                case _: assert_true(false)
        case _: assert_true(false)

fn atomic_failure_module() -> MirModule:
    var module = logical_projection_module(MirOperand.const_int(2))
    val function = module.functions[SymbolId.new(41)]
    val first = function.blocks[0].instructions[0]
    val second = MirInst(kind: MirInstKind.Intrinsic(
        Some(LocalId(id: 2)), MIR_STORAGE_PROJECT_FIELD_V1, [
            MirOperand.copy(LocalId(id: 1)), MirOperand.copy(LocalId(id: 1)),
            MirOperand.const_int(2)
        ]), span: nil)
    module.functions[SymbolId.new(41)] = MirFunction(..function, blocks: [
        MirBlock(id: BlockId.new(0), label: Some("entry"),
            instructions: [first, second], terminator: function.blocks[0].terminator)
    ])
    module

fn assert_logical_projection_name(instruction: MirInst):
    match instruction.kind:
        case Intrinsic(_, name, _): assert_equal(name, MIR_STORAGE_PROJECT_FIELD_V1)
        case _: assert_true(false)

describe "typed host AoS and SoA native projection":
    it "automatically rewrites logical field projections with exact site bindings":
        assert_rewritten_recipe(StorageLayoutKind.AoS, 16, 8)
        assert_rewritten_recipe(StorageLayoutKind.SoA, 8, 320)

    it "routes logical projections through the post-optimization native boundary":
        val module = logical_projection_module(MirOperand.const_int(2))
        val site = mir_storage_view_site_binding_v1(41, 0, true,
            projection_binding(StorageLayoutKind.SoA, false))
        match compile_module_with_backend_target_cpu_storage_bindings(
            "native", module, false, 0, "", [site]):
            case Ok(compiled): assert_true(compiled.object_code != nil)
            case Err(_): assert_true(false)
        match compile_module_with_backend_target_cpu_storage_bindings(
            "cranelift", module, false, 0, "", [site]):
            case Ok(_): assert_true(false)
            case Err(error):
                assert_true(error.message.contains(
                    "typed storage projections require the custom native backend"))

    it "fails closed on missing duplicate dynamic and observed bindings":
        val logical = logical_projection_module(MirOperand.const_int(2))
        assert_equal(lower_mir_storage_project_fields_v1(logical, []).reason,
            "missing-storage-view-site-binding")
        val site = mir_storage_view_site_binding_v1(41, 0, true,
            projection_binding(StorageLayoutKind.SoA, false))
        assert_equal(lower_mir_storage_project_fields_v1(logical, [site, site]).reason,
            "duplicate-storage-view-site-binding")
        val dynamic_field = logical_projection_module(MirOperand.copy(LocalId(id: 1)))
        assert_equal(lower_mir_storage_project_fields_v1(dynamic_field, [site]).reason,
            "logical-projection-field-must-be-constant")
        val observed = mir_storage_view_site_binding_v1(41, 0, true,
            projection_binding(StorageLayoutKind.SoA, true))
        assert_equal(lower_mir_storage_project_fields_v1(logical, [observed]).reason,
            "storage-view-recipe:address-observed-or-abi-pinned")
        val unproven = mir_storage_view_site_binding_v1(41, 0, false,
            projection_binding(StorageLayoutKind.SoA, false))
        assert_equal(lower_mir_storage_project_fields_v1(logical, [unproven]).reason,
            "storage-view-index-bounds-unproven")

    it "leaves the entire input MIR logical when a later site fails":
        val module = atomic_failure_module()
        val site = mir_storage_view_site_binding_v1(41, 0, true,
            projection_binding(StorageLayoutKind.SoA, false))
        val result = lower_mir_storage_project_fields_v1(module, [site])
        assert_false(result.ok)
        assert_equal(result.reason, "missing-storage-view-site-binding")
        assert_logical_projection_name(module.functions[SymbolId.new(41)].blocks[0].instructions[0])
        assert_logical_projection_name(module.functions[SymbolId.new(41)].blocks[0].instructions[1])

    it "rejects a binding whose allocation cannot contain the projection":
        val too_small = mir_storage_view_binding_v1(7001, 9, 64, 64, 16, false,
            projection_plan(StorageLayoutKind.SoA), [
                mir_storage_field_binding_v1(0, 0, 8, 32)
            ])
        assert_equal(mir_storage_address_recipe_v1(too_small, 0).reason,
            "storage-view-allocation-too-small")

    it "rejects non-pointer-width fields until typed memory operations land":
        val logical = logical_projection_module(MirOperand.const_int(1))
        val site = mir_storage_view_site_binding_v1(41, 0, true,
            projection_binding(StorageLayoutKind.SoA, false))
        assert_equal(lower_mir_storage_project_fields_v1(logical, [site]).reason,
            "native-storage-field-width-unsupported")

    it "matches canonical projection for unequal fields and runtime indices":
        for layout in [StorageLayoutKind.AoS, StorageLayoutKind.SoA]:
            val binding = projection_binding(layout, false)
            for field_id in 0..3:
                val recipe = mir_storage_address_recipe_v1(binding, field_id)
                assert_true(recipe.ok)
                for index in 0..64:
                    val field = binding.fields[field_id]
                    val expected = storage_layout_project(binding.plan,
                        storage_projection_request_v1(index, binding.element_count,
                            field.logical_offset, field.field_size,
                            binding.logical_stride, field.column_offset, 0, 0))
                    assert_true(expected.ok)
                    assert_equal(recipe.base_offset + index * recipe.scale,
                        expected.byte_offset)

    it "lowers the affine recipe through real native machine selection":
        val recipe = mir_storage_address_recipe_v1(
            projection_binding(StorageLayoutKind.SoA, false), 2)
        val selected = isel_module(
            projection_intrinsic_module(recipe.scale, recipe.base_offset))
        var saw_mul = false
        var saw_add = false
        var saw_base_offset = false
        for block in selected.functions[0].blocks:
            for instruction in block.insts:
                if instruction.opcode == X86_OP_IMUL: saw_mul = true
                if instruction.opcode == X86_OP_ADD: saw_add = true
                if instruction.opcode == X86_OP_ADD_IMM: saw_base_offset = true
                assert_false(instruction.opcode == X86_OP_NOP)
        assert_true(saw_mul and saw_add and saw_base_offset)

    it "materializes base offsets that exceed signed ADD immediate width":
        val selected = isel_module(projection_intrinsic_module(8, 2147483648))
        var saw_offset_register = false
        var saw_immediate_add = false
        for block in selected.functions[0].blocks:
            for instruction in block.insts:
                if instruction.opcode == X86_OP_MOV_REG_IMM:
                    saw_offset_register = true
                if instruction.opcode == X86_OP_ADD_IMM:
                    saw_immediate_add = true
        assert_true(saw_offset_register)
        assert_false(saw_immediate_add)

    it "rejects observed ABI and unsupported physical layouts":
        val observed = mir_storage_address_recipe_v1(
            projection_binding(StorageLayoutKind.SoA, true), 1)
        assert_false(observed.ok)
        assert_equal(observed.reason, "address-observed-or-abi-pinned")
        val grouped = mir_storage_address_recipe_v1(
            projection_binding(StorageLayoutKind.Grouped, false), 1)
        assert_false(grouped.ok)
        assert_equal(grouped.reason, "layout-requires-specialized-lowering")
        assert_equal(mir_storage_address_recipe_v1(
            projection_binding(StorageLayoutKind.AoS, false), 99).reason,
            "unknown-field")

    it "rejects overlapping SoA columns across the whole bound schema":
        val malformed = mir_storage_view_binding_v1(7001, 9, 64, 1024, 16, false,
            projection_plan(StorageLayoutKind.SoA), [
                mir_storage_field_binding_v1(0, 0, 4, 0),
                mir_storage_field_binding_v1(1, 8, 8, 128)
            ])
        assert_equal(mir_storage_address_recipe_v1(malformed, 0).reason,
            "overlapping-physical-columns")
