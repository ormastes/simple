# @req: REQ-COMPILER-NATIVE-RV64-CALLEE-SAVE-ORDER-001
"""RV64 allocator preserves incoming nonvolatile registers before argument definitions."""

use std.spec.*
use compiler.backend.backend.native.regalloc.{regalloc_module_riscv64}
use compiler.backend.backend.native.isel_riscv64.{isel_module_riscv64}
use compiler.backend.native.mach_inst.*
use compiler.mir.mir_data.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}

fn argument_move_module() -> MachModule:
    var prologue = new_mach_block("prologue", -1)
    prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(-16)]))
    prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_SD, [op_phys(RV_X1), op_mem(physical_reg(RV_X2), 8)]))
    prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_SD, [op_phys(RV_X8), op_mem(physical_reg(RV_X2), 0)]))
    prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X8), op_phys(RV_X2), op_imm(16)]))
    prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_MV, [op_reg(virtual_reg(0)), op_phys(RV_X10)]))

    var body = new_mach_block("entry", 0)
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_MV, [op_phys(RV_X10), op_reg(virtual_reg(0))]))
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_LD, [op_phys(RV_X1), op_mem(physical_reg(RV_X2), 8)]))
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_LD, [op_phys(RV_X8), op_mem(physical_reg(RV_X2), 0)]))
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(16)]))
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_RET, []))

    val function = MachFunction(name: "argument_move", blocks: [prologue, body],
        frame_size: 16, num_virtual_regs: 1, used_callee_saved: [])
    var module = new_mach_module("argument_move")
    mach_module_add_func(module, function)

fn frame_layout_module(frame_size: i64, outgoing_arg_size: i64, large_epilogue: bool) -> MachModule:
    var prologue = new_mach_block("prologue", -1)
    if large_epilogue:
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(0 - frame_size)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADD, [op_phys(RV_X2), op_phys(RV_X2), op_phys(RV_X31)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size - 8)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADD, [op_phys(RV_X31), op_phys(RV_X2), op_phys(RV_X31)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_SD, [op_phys(RV_X1), op_mem(physical_reg(RV_X31), 0)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size - 16)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADD, [op_phys(RV_X31), op_phys(RV_X2), op_phys(RV_X31)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_SD, [op_phys(RV_X8), op_mem(physical_reg(RV_X31), 0)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADD, [op_phys(RV_X8), op_phys(RV_X2), op_phys(RV_X31)]))
    else:
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(0 - frame_size)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_SD, [op_phys(RV_X1), op_mem(physical_reg(RV_X2), frame_size - 8)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_SD, [op_phys(RV_X8), op_mem(physical_reg(RV_X2), frame_size - 16)]))
        prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X8), op_phys(RV_X2), op_imm(frame_size)]))
    prologue = mach_block_add_inst(prologue, new_mach_inst(RV_OP_MV, [op_reg(virtual_reg(0)), op_phys(RV_X10)]))

    var body = new_mach_block("entry", 0)
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_SD, [op_reg(virtual_reg(0)), op_mem(physical_reg(RV_X2), 0)]))
    if large_epilogue:
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size - 8)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_ADD, [op_phys(RV_X31), op_phys(RV_X2), op_phys(RV_X31)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LD, [op_phys(RV_X1), op_mem(physical_reg(RV_X31), 0)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size - 16)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_ADD, [op_phys(RV_X31), op_phys(RV_X2), op_phys(RV_X31)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LD, [op_phys(RV_X8), op_mem(physical_reg(RV_X31), 0)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_ADD, [op_phys(RV_X2), op_phys(RV_X2), op_phys(RV_X31)]))
    else:
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LD, [op_phys(RV_X1), op_mem(physical_reg(RV_X2), frame_size - 8)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_LD, [op_phys(RV_X8), op_mem(physical_reg(RV_X2), frame_size - 16)]))
        body = mach_block_add_inst(body, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(frame_size)]))
    body = mach_block_add_inst(body, new_mach_inst(RV_OP_RET, []))

    val function = MachFunction(name: "frame_layout", blocks: [prologue, body],
        frame_size: frame_size, num_virtual_regs: 1, used_callee_saved: [],
        outgoing_arg_size: outgoing_arg_size)
    var module = new_mach_module("frame_layout")
    mach_module_add_func(module, function)

fn mir_call_frame_module(call_kind: text) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val unit_type = MirType(kind: MirTypeKind.Unit)
    val callee_sig = MirSignature(params: [], return_type: unit_type, is_variadic: true)
    val callee_type = MirType(kind: MirTypeKind.FuncPtr(callee_sig))
    val value = LocalId.new(1)
    val pointer = LocalId.new(2)
    var args: [MirOperand] = []
    for _ in 0..9: args.push(MirOperand(kind: MirOperandKind.Copy(value)))
    val named_target = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("callee"), callee_type))
    val indirect_target = MirOperand(kind: MirOperandKind.Copy(pointer))
    var instructions = [MirInst(kind: MirInstKind.Const(value, MirConstValue.Int(7), i64_type), span: nil)]
    var terminator = MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(value))))
    if call_kind == "call":
        instructions.push(MirInst(kind: MirInstKind.Call(nil, named_target, args), span: nil))
    elif call_kind == "indirect":
        instructions.push(MirInst(kind: MirInstKind.CallIndirect(nil, indirect_target, args, callee_sig), span: nil))
    else:
        terminator = MirTerminator.CallTerminator(nil, named_target, args, BlockId.new(1), nil, nil, nil)
    val entry = MirBlock(id: BlockId.new(0), label: Some("entry"),
        instructions: instructions, terminator: terminator)
    var blocks = [entry]
    if call_kind == "terminator":
        blocks.push(MirBlock(id: BlockId.new(1), label: Some("return"), instructions: [],
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(value))))))
    val function = MirFunction(symbol: SymbolId.new(0), name: "call_frame_{call_kind}",
        signature: MirSignature(params: [], return_type: i64_type, is_variadic: false),
        locals: [
            MirLocal(id: LocalId.new(0), name: Some("_return"), type_: i64_type, kind: LocalKind.Return),
            MirLocal(id: value, name: Some("value"), type_: i64_type, kind: LocalKind.Temp),
            MirLocal(id: pointer, name: Some("pointer"), type_: callee_type, kind: LocalKind.Temp)
        ], blocks: blocks, entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = function
    MirModule(name: "call_frame_{call_kind}", functions: functions, statics: {}, constants: {}, types: {})

fn assert_real_call_frame_layout(call_kind: text):
    val selected = isel_module_riscv64(mir_call_frame_module(call_kind))
    expect(selected.functions[0].outgoing_arg_size).to_equal(8)
    val function = regalloc_module_riscv64(selected).functions[0]
    expect(function.frame_size % 16).to_equal(0)
    expect(function.used_callee_saved.len() > 0).to_equal(true)
    val extension_size = function.frame_size - selected.functions[0].frame_size
    expect(extension_size % 16).to_equal(0)
    val allocated_reg = function.used_callee_saved[0]
    var outgoing_at_zero = false
    var save_at_eight = false
    var restore_at_eight = false
    var teardown_before_ra = false
    for block in function.blocks:
        var teardown_index = -1
        var ra_restore_index = -1
        for index in 0..block.insts.len():
            val inst = block.insts[index]
            if inst.opcode == RV_OP_SD and inst.operands.len() >= 2:
                match inst.operands[1].kind:
                    case Mem(base, offset):
                        match base.kind:
                            case Physical(id):
                                if id == RV_X2 and offset == 0: outgoing_at_zero = true
                                if id == RV_X2 and offset == 8 and get_phys_reg_id(inst.operands[0]) == allocated_reg: save_at_eight = true
                            case _: ()
                    case _: ()
            elif inst.opcode == RV_OP_LD and inst.operands.len() >= 2:
                match inst.operands[1].kind:
                    case Mem(base, offset):
                        match base.kind:
                            case Physical(id):
                                if id == RV_X2 and offset == 8 and get_phys_reg_id(inst.operands[0]) == allocated_reg: restore_at_eight = true
                                if id == RV_X2 and get_phys_reg_id(inst.operands[0]) == RV_X1: ra_restore_index = index
                            case _: ()
                    case _: ()
            elif inst.opcode == RV_OP_ADDI and inst.operands.len() >= 3:
                match inst.operands[2].kind:
                    case Imm(value_):
                        if value_ == extension_size: teardown_index = index
                    case _: ()
        if teardown_index >= 0 and ra_restore_index >= 0 and teardown_index < ra_restore_index:
            teardown_before_ra = true
    expect(outgoing_at_zero).to_equal(true)
    expect(save_at_eight).to_equal(true)
    expect(restore_at_eight).to_equal(true)
    expect(teardown_before_ra).to_equal(true)

describe "RV64 callee-save prologue ordering":
    it "saves an allocated argument destination before defining it":
        step("Allocate an incoming argument to the first nonvolatile register")
        val function = regalloc_module_riscv64(argument_move_module()).functions[0]
        expect(function.used_callee_saved.len()).to_equal(1)
        val allocated_reg = function.used_callee_saved[0]

        var save_index = -1
        var argument_move_index = -1
        var restore_index = -1
        var ra_restore_index = -1
        val prologue = function.blocks[0]
        for index in 0..prologue.insts.len():
            val inst = prologue.insts[index]
            if inst.opcode == RV_OP_SD and inst.operands.len() > 0:
                if get_phys_reg_id(inst.operands[0]) == allocated_reg: save_index = index
            elif inst.opcode == RV_OP_MV and inst.operands.len() > 0:
                if get_phys_reg_id(inst.operands[0]) == allocated_reg: argument_move_index = index

        val body = function.blocks[1]
        for index in 0..body.insts.len():
            val inst = body.insts[index]
            if inst.opcode == RV_OP_LD and inst.operands.len() >= 2:
                if get_phys_reg_id(inst.operands[0]) == allocated_reg: restore_index = index
                if get_phys_reg_id(inst.operands[0]) == RV_X1: ra_restore_index = index

        expect(save_index >= 0).to_equal(true)
        expect(argument_move_index >= 0).to_equal(true)
        expect(save_index < argument_move_index).to_equal(true)
        expect(restore_index >= 0).to_equal(true)
        expect(ra_restore_index >= 0).to_equal(true)
        expect(restore_index < ra_restore_index).to_equal(true)

    it "derives a disjoint outgoing frame for a nine-argument direct call":
        assert_real_call_frame_layout("call")

    it "derives a disjoint outgoing frame for a nine-argument indirect call":
        assert_real_call_frame_layout("indirect")

    it "derives a disjoint outgoing frame for a nine-argument call terminator":
        assert_real_call_frame_layout("terminator")

    it "keeps stack argument zero disjoint from allocator save slots":
        step("Reserve one outgoing stack word and allocate one nonvolatile register")
        val function = regalloc_module_riscv64(frame_layout_module(32, 8, false)).functions[0]
        val allocated_reg = function.used_callee_saved[0]
        var outgoing_at_zero = false
        var save_at_eight = false
        for block in function.blocks:
            for inst in block.insts:
                if inst.opcode == RV_OP_SD and inst.operands.len() >= 2:
                    match inst.operands[1].kind:
                        case Mem(base, offset):
                            match base.kind:
                                case Physical(id):
                                    if id == RV_X2 and offset == 0: outgoing_at_zero = true
                                    if id == RV_X2 and offset == 8 and get_phys_reg_id(inst.operands[0]) == allocated_reg: save_at_eight = true
                                case _: ()
                        case _: ()
        expect(outgoing_at_zero).to_equal(true)
        expect(save_at_eight).to_equal(true)

    it "restores the allocator extension before an x31-expanded epilogue":
        step("Match the large selector epilogue at its address-materialization boundary")
        val function = regalloc_module_riscv64(frame_layout_module(4096, 8, true)).functions[0]
        val body = function.blocks[1]
        var extension_restore_index = -1
        var selector_address_index = -1
        for index in 0..body.insts.len():
            val inst = body.insts[index]
            if inst.opcode == RV_OP_ADDI and inst.operands.len() >= 3:
                match inst.operands[2].kind:
                    case Imm(value):
                        if value == 16: extension_restore_index = index
                    case _: ()
            elif inst.opcode == RV_OP_LI and inst.operands.len() >= 2:
                match inst.operands[1].kind:
                    case Imm(value):
                        if value == 4088: selector_address_index = index
                    case _: ()
        expect(extension_restore_index >= 0).to_equal(true)
        expect(selector_address_index >= 0).to_equal(true)
        expect(extension_restore_index < selector_address_index).to_equal(true)
