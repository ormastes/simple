# @req REQ-AARCH64-FRAME-PAIR-001
use std.spec
use std.spec.step
use compiler.backend.native.mach_inst.{A64_OP_STP, A64_OP_LDP, AARCH64_SP, AARCH64_X29, AARCH64_X30, new_mach_inst, op_phys, op_imm, op_mem, physical_reg}
use compiler.backend.native.encode_aarch64.{a64_new_encode_context, encode_inst_aarch64}

describe "AArch64 frame pair encoding":
    it "encodes the selector preindexed frame save":
        step("Encode STP x29,x30,[sp,#-16]!")
        val inst = new_mach_inst(A64_OP_STP, [op_phys(AARCH64_X29), op_phys(AARCH64_X30), op_phys(AARCH64_SP), op_imm(-16)])
        val encoded = encode_inst_aarch64(a64_new_encode_context(), inst)
        expect(encoded.code).to_equal([0xfd, 0x7b, 0xbf, 0xa9])

    it "encodes the selector postindexed frame restore":
        step("Encode LDP x29,x30,[sp],#16")
        val inst = new_mach_inst(A64_OP_LDP, [op_phys(AARCH64_X29), op_phys(AARCH64_X30), op_phys(AARCH64_SP), op_imm(16)])
        val encoded = encode_inst_aarch64(a64_new_encode_context(), inst)
        expect(encoded.code).to_equal([0xfd, 0x7b, 0xc1, 0xa8])

    it "keeps ordinary offset pair stores without writeback":
        step("Encode STP x29,x30,[sp]")
        val inst = new_mach_inst(A64_OP_STP, [op_phys(AARCH64_X29), op_phys(AARCH64_X30), op_mem(physical_reg(AARCH64_SP), 0)])
        val encoded = encode_inst_aarch64(a64_new_encode_context(), inst)
        expect(encoded.code).to_equal([0xfd, 0x7b, 0x00, 0xa9])

    it "keeps ordinary offset pair loads without writeback":
        step("Encode LDP x29,x30,[sp]")
        val inst = new_mach_inst(A64_OP_LDP, [op_phys(AARCH64_X29), op_phys(AARCH64_X30), op_mem(physical_reg(AARCH64_SP), 0)])
        val encoded = encode_inst_aarch64(a64_new_encode_context(), inst)
        expect(encoded.code).to_equal([0xfd, 0x7b, 0x40, 0xa9])
