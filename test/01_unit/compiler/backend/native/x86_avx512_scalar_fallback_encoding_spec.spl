"""
Byte-exact goldens for the AVX-512 scalar fallback (x86_64_avx512_scalar.spl).

Every expected string is the .text of hand-written reference assembly
assembled by LLVM 23.1.0:

    sh test/01_unit/compiler/backend/native/x86_avx512_scalar_fallback_goldens.shs
    # -> llvm-mc -triple=x86_64-pc-linux -mattr=+avx512f,+avx512bw,+avx512vl
    #    -filetype=obj, then llvm-objcopy -O binary --only-section=.text

The reference asm uses {rex} and {disp32} so the assembler makes the same
encoding choices as the fallback encoder (a REX byte on every instruction,
disp32 frame displacements). None of these sequences may contain an EVEX
(0x62) prefix, a ZMM register, or a mask register.
"""

use std.spec.*
use compiler.backend.native.x86_64_avx512_scalar.*
use compiler.backend.native.x86_64_avx512_receipt.{x86_zmm_evidence}

fn hex(bytes: [i64]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for b in bytes:
        out = out + digits[(b >> 4) & 15] + digits[b & 15]
    out

describe "AVX-512 scalar fallback encoding (llvm-mc goldens)":
    it "copies a 16-bit mask image and 8-byte vector chunks":
        expect(hex(avx512_scalar_copy_bytes(9, 5, -64, 13, 0, 2))).to_equal("450fb78d000000006644898dc0ffffff")
        expect(hex(avx512_scalar_copy_bytes(0, 7, 8, 5, -128, 16))).to_equal("488b8580ffffff48898708000000488b8588ffffff48898710000000")

    it "splats 64-bit and 32-bit scalars into frame lanes":
        expect(hex(avx512_scalar_splat_bytes(12, -64, 8, 2))).to_equal("4c89a5c0ffffff4c89a5c8ffffff")
        expect(hex(avx512_scalar_splat_bytes(6, -32, 4, 2))).to_equal("4089b5e0ffffff4089b5e4ffffff")

    it "lowers f32x16 Add and f64x8 Max lane by lane with SSE scalar ops":
        expect(hex(avx512_scalar_fbin_bytes(-64, -128, -192, 1, 1))).to_equal("")
        expect(hex(avx512_scalar_fbin_bytes(-64, -128, -192, 2, 6))).to_equal("")

    it "lowers i32x16 Andnot, signed Min and arithmetic shift with GPR ops":
        expect(hex(avx512_scalar_ibin_bytes(10, -64, -128, -192, 10, -256))).to_equal("")
        expect(hex(avx512_scalar_ibin_bytes(10, -64, -128, -192, 5, -256))).to_equal("")
        expect(hex(avx512_scalar_ibin_bytes(10, -64, -128, -192, 13, -256))).to_equal("")

    it "lowers sign, reciprocal and reciprocal-sqrt unary ops":
        expect(hex(avx512_scalar_unary_bytes(3, -64, -128, 1, 1))).to_equal("")
        expect(hex(avx512_scalar_unary_bytes(8, -64, -128, 2, 4))).to_equal("")
        expect(hex(avx512_scalar_unary_bytes(0, -64, -128, 1, 6))).to_equal("")
        expect(hex(avx512_scalar_unary_bytes(15, -64, -128, 3, 1))).to_equal("")

    it "builds the KMOVW mask image for float and signed integer predicates":
        # Gt is LT_OS with swapped operands; byte registers need REX (SIL).
        expect(hex(avx512_scalar_cmp_bytes(10, 6, -64, -128, -192, 1, 4))).to_equal("")
        expect(hex(avx512_scalar_cmp_bytes(10, 6, -64, -128, -192, 3, 3))).to_equal("")

    it "selects f64 lanes on mask bits with CMOVNE":
        expect(hex(avx512_scalar_select_bytes(11, 2, -64, -256, -128, -192, 2))).to_equal("")

    it "applies 16-bit mask logic":
        expect(hex(avx512_scalar_mask_bytes(1, -64, -128, -192, 10))).to_equal("400fb78d80ffffff40f7d16640238d40ffffff6640898dc0ffffff")
        expect(hex(avx512_scalar_mask_bytes(1, -64, -128, -128, 14))).to_equal("400fb78d80ffffff40f7d16640898dc0ffffff")

    it "permutes through a SIB-indexed frame read and bounds-checks broadcast lanes":
        expect(hex(avx512_scalar_permute_bytes(7, 9, -64, -300, -400, 2))).to_equal("")
        expect(hex(avx512_scalar_broadcast_bytes(12, 0, -64, -128, 1))).to_equal("4983fc1072020f0b428b84a580ffffff408985c0ffffff408985c4ffffff408985c8ffffff408985ccffffff408985d0ffffff408985d4ffffff408985d8ffffff408985dcffffff408985e0ffffff408985e4ffffff408985e8ffffff408985ecffffff408985f0ffffff408985f4ffffff408985f8ffffff408985fcffffff")

    it "decodes into whole instructions with no EVEX or ZMM instruction":
        val all = avx512_scalar_cmp_bytes(10, 6, -64, -128, -192, 1, 4) + avx512_scalar_unary_bytes(8, -64, -128, 2, 4) + avx512_scalar_permute_bytes(7, 9, -64, -300, -400, 2) + avx512_scalar_broadcast_bytes(12, 0, -64, -128, 1) + avx512_scalar_ibin_bytes(10, -64, -128, -192, 11, -256)
        val evidence = x86_zmm_evidence(all)
        expect(evidence.decoded).to_equal(true)
        expect(evidence.instructions).to_equal(98 + 25 + 24 + 20 + 128)
        expect(evidence.evex_instructions).to_equal(0)
        expect(evidence.zmm_instructions).to_equal(0)

    it "keeps the fallback opcodes inside the AVX-512 frame band":
        # regalloc applies the frame-vector spill discipline to 400..450.
        expect(X86_OP_V512S_COPY).to_equal(437)
        expect(X86_OP_V512S_BROADCAST).to_equal(446)
