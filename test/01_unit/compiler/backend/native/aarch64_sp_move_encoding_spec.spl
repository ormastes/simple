# @req REQ-AARCH64-SP-MOVE-001
use std.spec
use std.spec.step
use compiler.backend.native.mach_inst.{A64_OP_MOV, AARCH64_SP, AARCH64_X29, new_mach_inst, op_phys}
use compiler.backend.native.encode_aarch64.{a64_new_encode_context, encode_inst_aarch64}

fn encoded_move(destination: i64, source: i64) -> [i64]:
    val inst = new_mach_inst(A64_OP_MOV, [op_phys(destination), op_phys(source)])
    val encoded = encode_inst_aarch64(a64_new_encode_context(), inst)
    encoded.code

describe "AArch64 stack pointer move encoding":
    it "copies sp to the frame pointer with ADD immediate zero":
        step("Encode the production frame pointer setup")
        expect(encoded_move(AARCH64_X29, AARCH64_SP)).to_equal([0xfd, 0x03, 0x00, 0x91])

    it "restores sp from the frame pointer with ADD immediate zero":
        step("Encode the production stack pointer restore")
        expect(encoded_move(AARCH64_SP, AARCH64_X29)).to_equal([0xbf, 0x03, 0x00, 0x91])

    it "preserves an explicit sp self move":
        step("Encode a move whose two operands name the stack pointer")
        expect(encoded_move(AARCH64_SP, AARCH64_SP)).to_equal([0xff, 0x03, 0x00, 0x91])

    it "keeps general register moves as ORR shifted register aliases":
        step("Encode an ordinary x0 to x1 move")
        expect(encoded_move(1, 0)).to_equal([0xe1, 0x03, 0x00, 0xaa])
