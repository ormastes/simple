# codex-system-test
# @tag: unit, simd, avx512, fma, evex
# @req REQ-AVX512-002 REQ-AVX512-006

"""Exact EVEX goldens for the fixed-width AVX-512 FMA emitter."""

use std.spec.{describe, it, expect}
use std.spec.step
use compiler.backend.native.x86_64_avx512.{
    X86_ZMM0, X86_ZMM1, X86_ZMM2, X86_ZMM8, X86_ZMM9, X86_ZMM10,
    X86_K0, X86_K1, X86_K7,
    encode_avx512_fma_f32x16
}

describe "AVX-512 FMA EVEX encoding":
    it "should encode an unmasked VFMADD213PS with k0 as the no-mask form":
        step("Emit the canonical f32x16 FMA register form")
        expect(encode_avx512_fma_f32x16(X86_ZMM0, X86_ZMM1, X86_ZMM2, X86_K0, false)).to_equal([0x62, 0xF2, 0x75, 0x48, 0xA8, 0xC2])

    it "should encode the opmask and zeroing fields in the EVEX P2 byte":
        step("Emit masked and zeroing FMA forms with low and high k registers")
        expect(encode_avx512_fma_f32x16(X86_ZMM0, X86_ZMM1, X86_ZMM2, X86_K1, true)).to_equal([0x62, 0xF2, 0x75, 0xC9, 0xA8, 0xC2])
        expect(encode_avx512_fma_f32x16(X86_ZMM8, X86_ZMM9, X86_ZMM10, X86_K7, false)).to_equal([0x62, 0x52, 0x35, 0x4F, 0xA8, 0xC2])

    it "should reject invalid ZMM and mask registers before emitting bytes":
        step("Pass out-of-range physical registers to the strict emitter")
        expect(encode_avx512_fma_f32x16(47, X86_ZMM1, X86_ZMM2, X86_K1, false).len()).to_equal(0)
        expect(encode_avx512_fma_f32x16(X86_ZMM0, 80, X86_ZMM2, X86_K1, false).len()).to_equal(0)
        expect(encode_avx512_fma_f32x16(X86_ZMM0, X86_ZMM1, X86_ZMM2, 88, false).len()).to_equal(0)
