# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec.{describe, it, assert_equal}
use compiler.backend.backend.backend_helpers.{backend_helper_target_opt_context}


describe "custom native driver AVX2 policy":
    # @manual scenario evidence
    it "admits a requested host v3 profile only when runtime AVX2 is available":
        # @req REQ-SSPEC-UNIT
        step("admits a requested host v3 profile only when runtime AVX2 is available")
        val admitted = backend_helper_target_opt_context("", "x86_64-v3", true)
        assert_equal(admitted.x86_caps.has_avx2, true)

    it "denies the same profile when runtime AVX2 is unavailable":
        # @req REQ-SSPEC-UNIT
        step("denies the same profile when runtime AVX2 is unavailable")
        val denied = backend_helper_target_opt_context("", "x86_64-v3", false)
        assert_equal(denied.x86_caps.has_avx2, false)

    it "denies target-profile inference for cross compilation":
        # @req REQ-SSPEC-UNIT
        step("denies target-profile inference for cross compilation")
        val denied = backend_helper_target_opt_context(
            "x86_64-unknown-linux-gnu", "x86_64-v3", true)
        assert_equal(denied.x86_caps.has_avx2, false)

    it "keeps baseline and unknown CPU profiles denied":
        # @req REQ-SSPEC-UNIT
        step("keeps baseline and unknown CPU profiles denied")
        assert_equal(
            backend_helper_target_opt_context("", "x86_64-v2", true).x86_caps.has_avx2,
            false)
        assert_equal(
            backend_helper_target_opt_context("", "unknown", true).x86_caps.has_avx2,
            false)
