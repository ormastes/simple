# @cover src/compiler/70.backend/backend/native/remote_riscv32_compile.spl
# @req REQ-REMOTE-JIT-RV32-SOURCE-001
"""Remote RV32 compilation uses the real frontend, MIR, and native backend."""

use compiler.backend.backend.native.remote_riscv32_compile.{compile_remote_riscv32_binary}

describe "remote RV32 source compiler":
    it "rejects empty source and misaligned placement addresses":
        expect(compile_remote_riscv32_binary("", 0x80010000).is_err()).to_equal(true)
        expect(compile_remote_riscv32_binary("fn main() -> i64:\n    0\n", 0x80010002).is_err()).to_equal(true)

    it "emits a raw source-derived instruction image instead of an ELF container":
        val compiled = compile_remote_riscv32_binary(
            "fn main() -> i64:\n    42\n", 0x80010000)

        expect(compiled.is_ok()).to_equal(true)
        val image = compiled.unwrap()
        expect(image.len()).to_be_greater_than(0)
        if image.len() >= 4:
            expect(image.slice(0, 4) == [0x7f, 0x45, 0x4c, 0x46]).to_equal(false)
