"""
`@must(avx512)` / `@prefer(avx512)` receipts must stay truthful: a function
claimed AVX-512 has to contain at least one ZMM instruction in its emitted
machine code, otherwise the machine-code receipt says not satisfied.

Byte inputs below are llvm-mc 23.1.0 encodings
(`llvm-mc -triple=x86_64 -mattr=+avx512f,+avx512vl -x86-asm-syntax=intel
-show-encoding`), quoted next to each use.
"""

use std.spec.*
use compiler.mir.mir_data.*
use compiler.mir_opt.auto_vectorize_receipt.{SimdReqOutcome, SimdReqVerdict}
use compiler.backend.native.x86_64_avx512_receipt.{x86_zmm_evidence, x86_avx512_machine_code_receipt, x86_avx512_confirm_receipt, x86_avx512_report_machine_receipts}
use compiler.backend.native.isel_x86_64.{isel_module_with_x86_simd_capability}
use compiler.backend.native.native_avx2_capability.{native_avx2_denied_v1}
use compiler.backend.native.native_avx512_capability.{native_avx512_capability_v1, native_avx512_denied_v1}
use compiler.backend.native.regalloc.{regalloc_module}
use compiler.backend.native.encode_x86_64.{encode_module}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}

# push rbp ; mov rbp, rsp ; ... ; pop rbp ; ret
val PROLOGUE = [0x55, 0x48, 0x89, 0xE5]
val EPILOGUE = [0x5D, 0xC3]
# vaddps zmm0, zmm1, zmm2
val VADDPS_ZMM = [0x62, 0xF1, 0x74, 0x48, 0x58, 0xC2]
# {evex} vpaddd ymm0, ymm1, ymm2
val VPADDD_EVEX_YMM = [0x62, 0xF1, 0x75, 0x28, 0xFE, 0xC2]
# vaddss xmm0, xmm1, xmm2, {rn-sae}  (b = 1 register form: rounding, scalar)
val VADDSS_RN_SAE = [0x62, 0xF1, 0x76, 0x18, 0x58, 0xC2]
# mov eax, dword ptr [rbp + 0x62] ; mov eax, 0x62626262
val SCALAR_WITH_62_BYTES = [0x8B, 0x45, 0x62, 0xB8, 0x62, 0x62, 0x62, 0x62]
# kmovw k1, word ptr [rbp - 8] ; vzeroupper
val VEX_MASK_AND_VZEROUPPER = [0xC5, 0xF8, 0x90, 0x4D, 0xF8, 0xC5, 0xF8, 0x77]

fn avx512_admitted():
    native_avx512_capability_v1("x86_64-avx512-linux", "integration-injected", "fixture-avx512-v1", true, false, true)

fn tagged_module(level: text) -> MirModule:
    val f32 = MirType(kind: MirTypeKind.F32)
    val ptr = MirType(kind: MirTypeKind.Ptr(pointee: f32, mutable: true))
    val v16f = MirType(kind: MirTypeKind.Vec16f)
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("a"), type_: ptr, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 1), name: Some("out"), type_: ptr, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 2), name: Some("x"), type_: v16f, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 3), name: Some("y"), type_: v16f, kind: LocalKind.Temp)
    ]
    val instructions = [
        MirInst(kind: MirInstKind.MirSimdLoad(LocalId(id: 2), MirOperand.copy(LocalId(id: 0)), true, v16f), span: nil),
        MirInst(kind: MirInstKind.MirSimdBinop(LocalId(id: 3), MirOperand.copy(LocalId(id: 2)), MirOperand.copy(LocalId(id: 2)), "Add"), span: nil),
        MirInst(kind: MirInstKind.MirSimdStore(MirOperand.copy(LocalId(id: 3)), MirOperand.copy(LocalId(id: 1)), true), span: nil)
    ]
    val block = MirBlock(id: BlockId.new(0), label: Some("entry"), instructions: instructions, terminator: MirTerminator.Ret(nil))
    val function = MirFunction(
        symbol: SymbolId.new(0), name: "tagged_avx512",
        signature: MirSignature(params: [ptr, ptr], return_type: MirType.unit(), is_variadic: false),
        locals: locals, blocks: [block], entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        simd_req_level: level, simd_req_backend: "avx512")
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = function
    MirModule(name: "tagged_avx512", functions: functions, statics: {}, constants: {}, types: {})

fn compiled(module: MirModule, admitted: bool):
    val capability = if admitted: avx512_admitted() else: native_avx512_denied_v1()
    encode_module(regalloc_module(isel_module_with_x86_simd_capability(module, native_avx2_denied_v1(), capability)))

describe "x86 ZMM machine-code evidence":
    it "counts a 512-bit EVEX instruction between ordinary instructions":
        val evidence = x86_zmm_evidence(PROLOGUE + VADDPS_ZMM + EPILOGUE)
        expect(evidence.decoded).to_equal(true)
        expect(evidence.instructions).to_equal(5)
        expect(evidence.evex_instructions).to_equal(1)
        expect(evidence.zmm_instructions).to_equal(1)

    it "does not count 256-bit EVEX, scalar rounding forms, or VEX mask code as ZMM":
        val evidence = x86_zmm_evidence(PROLOGUE + VPADDD_EVEX_YMM + VADDSS_RN_SAE + VEX_MASK_AND_VZEROUPPER + EPILOGUE)
        expect(evidence.decoded).to_equal(true)
        expect(evidence.evex_instructions).to_equal(2)
        expect(evidence.zmm_instructions).to_equal(0)

    it "never mistakes 0x62 displacement or immediate bytes for an EVEX prefix":
        val evidence = x86_zmm_evidence(PROLOGUE + SCALAR_WITH_62_BYTES + EPILOGUE)
        expect(evidence.decoded).to_equal(true)
        expect(evidence.instructions).to_equal(6)
        expect(evidence.evex_instructions).to_equal(0)

    it "reports truncated bytes as undecodable rather than as evidence":
        val evidence = x86_zmm_evidence(PROLOGUE + [0x62, 0xF1, 0x74, 0x48])
        expect(evidence.decoded).to_equal(false)

describe "x86 AVX-512 machine-code receipt":
    it "is satisfied only by decodable code containing ZMM":
        expect(x86_avx512_machine_code_receipt("must", "avx512", PROLOGUE + VADDPS_ZMM + EPILOGUE).verdict).to_equal(SimdReqVerdict.Satisfied)
        val missing = x86_avx512_machine_code_receipt("must", "avx512", PROLOGUE + VPADDD_EVEX_YMM + EPILOGUE)
        expect(missing.verdict).to_equal(SimdReqVerdict.Error)
        expect(missing.reason).to_equal("@must(avx512) unsatisfied: emitted-machine-code-has-no-zmm-instruction")
        expect(x86_avx512_machine_code_receipt("prefer", "avx512", PROLOGUE + EPILOGUE).verdict).to_equal(SimdReqVerdict.Warn)
        val garbage = x86_avx512_machine_code_receipt("must", "avx512", PROLOGUE + [0x62])
        expect(garbage.verdict).to_equal(SimdReqVerdict.Error)
        expect(garbage.reason.contains("machine-code-undecodable")).to_equal(true)

    it "does not adjudicate other backends or untagged functions":
        expect(x86_avx512_machine_code_receipt("must", "avx2", PROLOGUE + EPILOGUE).verdict).to_equal(SimdReqVerdict.NotRequested)
        expect(x86_avx512_machine_code_receipt("", "avx512", PROLOGUE + EPILOGUE).verdict).to_equal(SimdReqVerdict.NotRequested)

    it "downgrades a planned Satisfied when the machine code disagrees and never upgrades a failure":
        val planned_ok = SimdReqOutcome(verdict: SimdReqVerdict.Satisfied, reason: "avx512-satisfied-at-512-bit-lanes")
        val planned_bad = SimdReqOutcome(verdict: SimdReqVerdict.Error, reason: "@must(avx512) unsatisfied: loop-not-vectorized")
        val machine_ok = x86_avx512_machine_code_receipt("must", "avx512", PROLOGUE + VADDPS_ZMM + EPILOGUE)
        val machine_bad = x86_avx512_machine_code_receipt("must", "avx512", PROLOGUE + EPILOGUE)
        expect(x86_avx512_confirm_receipt(planned_ok, machine_ok).verdict).to_equal(SimdReqVerdict.Satisfied)
        expect(x86_avx512_confirm_receipt(planned_ok, machine_bad).verdict).to_equal(SimdReqVerdict.Error)
        expect(x86_avx512_confirm_receipt(planned_bad, machine_ok).reason).to_equal(planned_bad.reason)

describe "x86 AVX-512 receipts on real backend output":
    it "is satisfied when AVX-512 is admitted and the function really has ZMM code":
        val module = tagged_module("must")
        val encoded = compiled(module, true)
        expect(x86_zmm_evidence(encoded[0].code).zmm_instructions > 0).to_equal(true)
        expect(x86_avx512_report_machine_receipts(module, encoded).len()).to_equal(0)

    it "says not satisfied when the scalar fallback compiled the claimed function":
        val module = tagged_module("must")
        val encoded = compiled(module, false)
        val evidence = x86_zmm_evidence(encoded[0].code)
        expect(evidence.decoded).to_equal(true)
        expect(evidence.zmm_instructions).to_equal(0)
        val lines = x86_avx512_report_machine_receipts(module, encoded)
        expect(lines.len()).to_equal(1)
        expect(lines[0]).to_equal("error[SIMD-REQ-002] tagged_avx512: @must(avx512) unsatisfied: emitted-machine-code-has-no-zmm-instruction")

    it "warns for @prefer(avx512) under the scalar fallback":
        val module = tagged_module("prefer")
        val lines = x86_avx512_report_machine_receipts(module, compiled(module, false))
        expect(lines.len()).to_equal(1)
        expect(lines[0].starts_with("warning[SIMD-REQ-002] tagged_avx512:")).to_equal(true)
