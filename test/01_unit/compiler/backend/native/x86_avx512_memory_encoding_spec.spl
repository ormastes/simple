"""Focused byte goldens for validated AVX-512 memory and VSIB encoding."""

use compiler.backend.native.x86_64_avx512.{encode_avx512_load_zmm, encode_avx512_loadu_zmm, encode_avx512_storeu_zmm, emit_avx512_vpgatherdd_zmm, emit_avx512_vpscatterdd_zmm, emit_avx512_vgatherdps_zmm, emit_avx512_vgatherdpd_zmm, emit_avx512_vpermps_zmm, emit_avx512_vpermd, emit_avx512_vpermq, emit_avx512_vpermi2d, emit_avx512_vpermi2q, emit_avx512_vpmovsxdq_zmm_from_ymm}

describe "AVX-512 aligned ZMM memory addressing":
    it "encodes rsp and r12 through a no-index SIB":
        expect(encode_avx512_load_zmm(49, 4, 0, 80, false)).to_equal([0x62, 0xF1, 0x7C, 0x48, 0x28, 0x0C, 0x24])
        expect(encode_avx512_load_zmm(65, 12, 0, 80, false)).to_equal([0x62, 0xC1, 0x7C, 0x48, 0x28, 0x0C, 0x24])

    it "encodes rbp and r13 zero displacement explicitly":
        expect(encode_avx512_load_zmm(50, 5, 0, 80, false)).to_equal([0x62, 0xF1, 0x7C, 0x48, 0x28, 0x55, 0x00])
        expect(encode_avx512_load_zmm(66, 13, 0, 80, false)).to_equal([0x62, 0xC1, 0x7C, 0x48, 0x28, 0x55, 0x00])

    it "normalizes negative compressed and full displacements":
        expect(encode_avx512_load_zmm(51, 3, -64, 80, false)).to_equal([0x62, 0xF1, 0x7C, 0x48, 0x28, 0x5B, 0xFF])
        expect(encode_avx512_load_zmm(51, 3, -65, 80, false)).to_equal([0x62, 0xF1, 0x7C, 0x48, 0x28, 0x9B, 0xBF, 0xFF, 0xFF, 0xFF])

describe "AVX-512 unaligned ZMM memory helpers":
    it "encodes VMOVUPS load and store with special bases":
        expect(encode_avx512_loadu_zmm(52, 12, 64, 80, false)).to_equal([0x62, 0xD1, 0x7C, 0x48, 0x10, 0x64, 0x24, 0x01])
        expect(encode_avx512_storeu_zmm(68, 13, 0, 80)).to_equal([0x62, 0xC1, 0x7C, 0x48, 0x11, 0x65, 0x00])

describe "AVX-512 VSIB addressing":
    it "encodes high base and index bits with signed disp8":
        expect(emit_avx512_vpgatherdd_zmm(48, 81, 65, 12, 8, -4)).to_equal([0x62, 0xD2, 0x7D, 0x41, 0x90, 0x44, 0xCC, 0xFF])

    it "encodes r13 zero displacement instead of no-base mode":
        expect(emit_avx512_vpscatterdd_zmm(87, 66, 13, 2, 0, 67)).to_equal([0x62, 0xC2, 0x7D, 0x47, 0xA0, 0x5C, 0x55, 0x00])

    it "encodes f32 and f64 gather forms with their complete EVEX and VSIB bytes":
        expect(emit_avx512_vgatherdps_zmm(48, 81, 49, 0, 4, 0)).to_equal([0x62, 0xF2, 0x7D, 0x49, 0x92, 0x04, 0x88])
        expect(emit_avx512_vgatherdpd_zmm(48, 81, 33, 0, 8, 0)).to_equal([0x62, 0xF2, 0xFD, 0x49, 0x92, 0x04, 0xC8])

describe "AVX-512 cross-lane encoding":
    it "distinguishes f32 i32 and f64 variable permutes by the complete instruction":
        expect(emit_avx512_vpermps_zmm(48, 49, 50)).to_equal([0x62, 0xF2, 0x75, 0x48, 0x16, 0xC2])
        expect(emit_avx512_vpermd(48, 49, 50)).to_equal([0x62, 0xF2, 0x75, 0x48, 0x36, 0xC2])
        expect(emit_avx512_vpermq(48, 49, 50)).to_equal([0x62, 0xF2, 0xF5, 0x48, 0x36, 0xC2])

    it "encodes two-source interleave controls and f64 index widening exactly":
        expect(emit_avx512_vpermi2d(48, 49, 50)).to_equal([0x62, 0xF2, 0x75, 0x48, 0x76, 0xC2])
        expect(emit_avx512_vpermi2q(48, 49, 50)).to_equal([0x62, 0xF2, 0xF5, 0x48, 0x76, 0xC2])
        expect(emit_avx512_vpmovsxdq_zmm_from_ymm(48, 33)).to_equal([0x62, 0xF2, 0x7E, 0x48, 0x25, 0xC1])

describe "AVX-512 malformed memory operands":
    it "rejects invalid registers masks scales and displacements":
        expect(encode_avx512_load_zmm(47, 0, 0, 80, false).len()).to_equal(0)
        expect(encode_avx512_load_zmm(48, 16, 0, 80, false).len()).to_equal(0)
        expect(encode_avx512_load_zmm(48, 0, 0, 88, false).len()).to_equal(0)
        expect(encode_avx512_load_zmm(48, 0, 0, 80, true).len()).to_equal(0)
        expect(encode_avx512_load_zmm(48, 0, 2147483648, 80, false).len()).to_equal(0)
        expect(emit_avx512_vpgatherdd_zmm(48, 81, 49, 0, 3, 0).len()).to_equal(0)
        expect(emit_avx512_vpgatherdd_zmm(48, 80, 49, 0, 4, 0).len()).to_equal(0)
        expect(emit_avx512_vpgatherdd_zmm(48, 81, 80, 0, 4, 0).len()).to_equal(0)
