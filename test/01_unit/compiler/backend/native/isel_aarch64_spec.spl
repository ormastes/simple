use std.spec.*

use compiler.mir.mir_data.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.backend.common.isel_context.{new_isel_context}
use compiler.backend.native.isel_aarch64.{a64_select_scalar_bitmanip, isel_module_aarch64}
use compiler.backend.native.encode_aarch64.{
    a64_new_encode_context, encode_inst_aarch64,
    COND_EQ, COND_NE, COND_HS, COND_LO, COND_HI, COND_LS, COND_GE, COND_LT, COND_GT, COND_LE
}
use compiler.backend.native.operand_utils.{get_imm_value}
use compiler.backend.native.mach_inst.{
    MachReg, MachRegKind, Operand, OperandKind,
    AARCH64_X0,
    A64_OP_MOV, A64_OP_MOVZ, A64_OP_MOVK, A64_OP_ADD, A64_OP_SUB, A64_OP_AND,
    A64_OP_LSR, A64_OP_RBIT, A64_OP_CLZ, A64_OP_REV, A64_OP_CSET,
    A64_COND_EQ, A64_COND_NE, A64_COND_HS, A64_COND_LO, A64_COND_HI, A64_COND_LS,
    A64_COND_GE, A64_COND_LT, A64_COND_GT, A64_COND_LE,
    new_mach_inst, op_phys, op_imm, reg_id, operand_get_reg
}

fn virt_operand(id: i64) -> Operand:
    Operand(kind: OperandKind.Reg(MachReg(kind: MachRegKind.Virtual(id))))

fn build_a64_cmp_module(name: text, kind: MirTypeKind, op: MirBinOp) -> MirModule:
    val ty = MirType(kind: kind)
    val bool_ty = MirType(kind: MirTypeKind.Bool)
    val sig = MirSignature(params: [ty, ty], return_type: bool_ty, is_variadic: false)
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("_return"), type_: bool_ty, kind: LocalKind.Return),
        MirLocal(id: LocalId(id: 1), name: Some("a"), type_: ty, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 2), name: Some("b"), type_: ty, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 3), name: Some("r"), type_: bool_ty, kind: LocalKind.Temp)
    ]
    val entry = MirBlock(
        id: BlockId.new(0),
        label: Some("entry"),
        instructions: [
            MirInst(kind: MirInstKind.BinOp(LocalId(id: 3), op,
                MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1))),
                MirOperand(kind: MirOperandKind.Copy(LocalId(id: 2)))), span: nil)
        ],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 3)))))
    )
    val func = MirFunction(
        symbol: SymbolId.new(0),
        name: name,
        signature: sig,
        locals: locals,
        blocks: [entry],
        entry_block: BlockId.new(0),
        span: Span.new(0, 0, 1, 1),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = func
    MirModule(name: name, functions: functions, statics: {}, constants: {}, types: {})

fn selected_cset_cond(kind: MirTypeKind, op: MirBinOp) -> i64:
    val mach = isel_module_aarch64(build_a64_cmp_module("cmp_fn", kind, op))
    for func in mach.functions:
        for block in func.blocks:
            for inst in block.insts:
                if inst.opcode == A64_OP_CSET:
                    return get_imm_value(inst.operands[1])
    -1

fn encode_cset_x0_word(cond: i64) -> i64:
    val inst = new_mach_inst(A64_OP_CSET, [op_phys(AARCH64_X0), op_imm(cond)])
    val enc = encode_inst_aarch64(a64_new_encode_context(), inst)
    enc.code[0] | (enc.code[1] << 8) | (enc.code[2] << 16) | (enc.code[3] << 24)

describe "AArch64 native ISel bitmanip intrinsics":
    it "lowers bit_clz to a single CLZ":
        val result = a64_select_scalar_bitmanip(new_isel_context(), virt_operand(7), "bit_clz", virt_operand(3))
        expect(result.insts.len()).to_equal(1)
        expect(result.insts[0].opcode).to_equal(A64_OP_CLZ)
        expect(reg_id(operand_get_reg(result.insts[0].operands[0]))).to_equal(7)
        expect(reg_id(operand_get_reg(result.insts[0].operands[1]))).to_equal(3)

    it "lowers bit_ctz to RBIT followed by CLZ":
        val result = a64_select_scalar_bitmanip(new_isel_context(), virt_operand(9), "bit_ctz", virt_operand(4))
        expect(result.insts.len()).to_equal(2)
        expect(result.insts[0].opcode).to_equal(A64_OP_RBIT)
        expect(result.insts[1].opcode).to_equal(A64_OP_CLZ)
        val tmp_reg = operand_get_reg(result.insts[0].operands[0])
        expect(reg_id(operand_get_reg(result.insts[0].operands[1]))).to_equal(4)
        expect(reg_id(operand_get_reg(result.insts[1].operands[0]))).to_equal(9)
        expect(reg_id(operand_get_reg(result.insts[1].operands[1]))).to_equal(reg_id(tmp_reg))

    it "lowers bit_bswap to REV":
        val result = a64_select_scalar_bitmanip(new_isel_context(), virt_operand(5), "bit_bswap", virt_operand(2))
        expect(result.insts.len()).to_equal(1)
        expect(result.insts[0].opcode).to_equal(A64_OP_REV)

    it "lowers bit_bitreverse to RBIT":
        val result = a64_select_scalar_bitmanip(new_isel_context(), virt_operand(6), "bit_bitreverse", virt_operand(1))
        expect(result.insts.len()).to_equal(1)
        expect(result.insts[0].opcode).to_equal(A64_OP_RBIT)

    it "lowers bit_popcount to a scalar SWAR sequence":
        val result = a64_select_scalar_bitmanip(new_isel_context(), virt_operand(1), "bit_popcount", virt_operand(0))
        expect(result.ctx.next_vreg).to_equal(3)
        expect(result.insts.len()).to_equal(37)
        expect(result.insts[0].opcode).to_equal(A64_OP_MOV)
        expect(result.insts[1].opcode).to_equal(A64_OP_MOVZ)
        expect(result.insts[2].opcode).to_equal(A64_OP_LSR)
        expect(result.insts[7].opcode).to_equal(A64_OP_AND)
        expect(result.insts[8].opcode).to_equal(A64_OP_SUB)
        expect(result.insts[13].opcode).to_equal(A64_OP_MOVK)
        expect(result.insts[16].opcode).to_equal(A64_OP_AND)
        expect(result.insts[17].opcode).to_equal(A64_OP_ADD)
        expect(result.insts[35].opcode).to_equal(A64_OP_MOVZ)
        expect(result.insts[36].opcode).to_equal(A64_OP_AND)

describe "AArch64 native ISel/encoder CSET condition codes":
    it "shares one architectural A64 condition table between mach_inst and encode_aarch64":
        expect([COND_EQ, COND_NE, COND_HS, COND_LO, COND_HI, COND_LS, COND_GE, COND_LT, COND_GT, COND_LE]).to_equal(
            [A64_COND_EQ, A64_COND_NE, A64_COND_HS, A64_COND_LO, A64_COND_HI, A64_COND_LS, A64_COND_GE, A64_COND_LT, A64_COND_GT, A64_COND_LE]
        )
        expect([A64_COND_EQ, A64_COND_NE, A64_COND_HS, A64_COND_LO, A64_COND_HI, A64_COND_LS, A64_COND_GE, A64_COND_LT, A64_COND_GT, A64_COND_LE]).to_equal(
            [0, 1, 2, 3, 8, 9, 10, 11, 12, 13]
        )

    it "lowers signed i64 comparisons to architectural A64 CSET words":
        val c_eq = selected_cset_cond(MirTypeKind.I64, MirBinOp.Eq)
        val c_ne = selected_cset_cond(MirTypeKind.I64, MirBinOp.Ne)
        val c_lt = selected_cset_cond(MirTypeKind.I64, MirBinOp.Lt)
        val c_le = selected_cset_cond(MirTypeKind.I64, MirBinOp.Le)
        val c_gt = selected_cset_cond(MirTypeKind.I64, MirBinOp.Gt)
        val c_ge = selected_cset_cond(MirTypeKind.I64, MirBinOp.Ge)
        expect([c_eq, c_ne, c_lt, c_le, c_gt, c_ge]).to_equal(
            [A64_COND_EQ, A64_COND_NE, A64_COND_LT, A64_COND_LE, A64_COND_GT, A64_COND_GE]
        )
        # CSINC x0, xzr, xzr, invert(cond): bits [15:12] carry cond_inv
        expect(encode_cset_x0_word(c_eq)).to_equal(0x9A9F17E0)
        expect(encode_cset_x0_word(c_ne)).to_equal(0x9A9F07E0)
        expect(encode_cset_x0_word(c_lt)).to_equal(0x9A9FA7E0)
        expect(encode_cset_x0_word(c_le)).to_equal(0x9A9FC7E0)
        expect(encode_cset_x0_word(c_gt)).to_equal(0x9A9FD7E0)
        expect(encode_cset_x0_word(c_ge)).to_equal(0x9A9FB7E0)
        expect((encode_cset_x0_word(c_lt) >> 12) & 0xF).to_equal(A64_COND_GE)
        expect((encode_cset_x0_word(c_le) >> 12) & 0xF).to_equal(A64_COND_GT)
        expect((encode_cset_x0_word(c_gt) >> 12) & 0xF).to_equal(A64_COND_LE)
        expect((encode_cset_x0_word(c_ge) >> 12) & 0xF).to_equal(A64_COND_LT)

    it "lowers signed i64 x < 0 as CSET lt (0x9A9FA7E0), not CSET hs (0x9A9F37E0)":
        val c_lt = selected_cset_cond(MirTypeKind.I64, MirBinOp.Lt)
        val word = encode_cset_x0_word(c_lt)
        expect(c_lt).to_equal(11)
        expect(word).to_equal(0x9A9FA7E0)

    it "lowers unsigned u64 ordered comparisons to LO/LS/HI/HS CSET words":
        val c_eq = selected_cset_cond(MirTypeKind.U64, MirBinOp.Eq)
        val c_ne = selected_cset_cond(MirTypeKind.U64, MirBinOp.Ne)
        val c_lt = selected_cset_cond(MirTypeKind.U64, MirBinOp.Lt)
        val c_le = selected_cset_cond(MirTypeKind.U64, MirBinOp.Le)
        val c_gt = selected_cset_cond(MirTypeKind.U64, MirBinOp.Gt)
        val c_ge = selected_cset_cond(MirTypeKind.U64, MirBinOp.Ge)
        expect([c_eq, c_ne, c_lt, c_le, c_gt, c_ge]).to_equal(
            [A64_COND_EQ, A64_COND_NE, A64_COND_LO, A64_COND_LS, A64_COND_HI, A64_COND_HS]
        )
        expect(encode_cset_x0_word(c_eq)).to_equal(0x9A9F17E0)
        expect(encode_cset_x0_word(c_ne)).to_equal(0x9A9F07E0)
        expect(encode_cset_x0_word(c_lt)).to_equal(0x9A9F27E0)
        expect(encode_cset_x0_word(c_le)).to_equal(0x9A9F87E0)
        expect(encode_cset_x0_word(c_gt)).to_equal(0x9A9F97E0)
        expect(encode_cset_x0_word(c_ge)).to_equal(0x9A9F37E0)

    it "lowers u32 ordered comparisons using unsigned condition codes":
        expect(selected_cset_cond(MirTypeKind.U32, MirBinOp.Lt)).to_equal(A64_COND_LO)
        expect(selected_cset_cond(MirTypeKind.U32, MirBinOp.Le)).to_equal(A64_COND_LS)
        expect(selected_cset_cond(MirTypeKind.U32, MirBinOp.Gt)).to_equal(A64_COND_HI)
        expect(selected_cset_cond(MirTypeKind.U32, MirBinOp.Ge)).to_equal(A64_COND_HS)
