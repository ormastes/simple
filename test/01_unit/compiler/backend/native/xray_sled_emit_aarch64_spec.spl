# @cover src/compiler/70.backend/backend/native/xray_sled_emit.spl
# @req REQ-XRAY-PR5-NATIVE-AARCH64-SLED
"""
# XRay PR5 — pure-Simple native AArch64 sleds

Design: doc/04_architecture/compiler/xray/xray_compiler_structural_change_2026-11-06.md
A.5 (native sled pass, `.simple_xray_map`) and B (static off identity).

The sled bytes are NOT invented here: they are the landed V1 contract template
`trace_native_off_template_v1` (Arm64Branch26) that the map validator checks
byte for byte, so emitter/validator drift fails this spec.
"""
use std.spec.*
use std.common.trace.observer_contract_v1.*
use std.common.trace.observer_native_map_v1.*
use std.common.trace.xray_native_map_format_v1.*
use compiler.backend.native.mach_inst.{A64_OP_RET, A64_OP_NOP, A64_OP_STP, A64_OP_XRAY_SLED, AARCH64_SP, AARCH64_X29, AARCH64_X30, MachModule, MachFunction, MachBlock, MachInst, EncodedFunction, EncodedReloc, new_mach_inst, new_mach_block, mach_block_add_inst, new_mach_function, mach_func_add_block, new_mach_module, mach_module_add_func, op_phys, op_imm}
use compiler.backend.native.encode_aarch64.{a64_new_encode_context, encode_inst_aarch64, encode_module_aarch64}
use compiler.backend.native.native_elf.{emit_elf_aarch64, emit_elf_aarch64_xray}
use compiler.backend.native.xray_sled_emit.*
use compiler.mir.mir_data.{MirModule}

fn sled_word_bytes(word: i64) -> [i64]:
    [word & 255, (word >> 8) & 255, (word >> 16) & 255, (word >> 24) & 255]

# Independent golden for site 3: B +32 / STP x16,x17 / STP x0,x30 /
# MOVZ w0,#3 / MOVK w0,#0,lsl 16 / BL +0 (CALL26 reloc) / LDP x0,x30 / LDP x16,x17.
fn golden_sled_site3() -> [i64]:
    val words: [i64] = [0x14000008, 0xA9BF47F0, 0xA9BF7BE0, 0x52800060, 0x72A00000, 0x94000000, 0xA8C17BE0, 0xA8C147F0]
    var out: [i64] = []
    for index in 0..words.len():
        val bytes = sled_word_bytes(words[index])
        for k in 0..4:
            out.push(bytes[k])
    out

fn ret_block(label: text, id: i64) -> MachBlock:
    var block = new_mach_block(label, id)
    block = mach_block_add_inst(block, new_mach_inst(A64_OP_NOP, []))
    mach_block_add_inst(block, new_mach_inst(A64_OP_RET, []))

fn two_exit_function(name: text) -> MachFunction:
    var func = new_mach_function(name)
    var prologue = new_mach_block("prologue", -1)
    prologue = mach_block_add_inst(prologue, new_mach_inst(A64_OP_STP, [op_phys(AARCH64_X29), op_phys(AARCH64_X30), op_phys(AARCH64_SP), op_imm(-16)]))
    func = mach_func_add_block(func, prologue)
    func = mach_func_add_block(func, ret_block("a", 0))
    mach_func_add_block(func, ret_block("b", 1))

fn fixture_module() -> MachModule:
    var module = new_mach_module("xray_fixture")
    module = mach_module_add_func(module, two_exit_function("traced"))
    mach_module_add_func(module, two_exit_function("plain"))

fn empty_mir_module(name: text) -> MirModule:
    MirModule(name: name, functions: {}, statics: {}, constants: {}, types: {})

fn opcodes(func: MachFunction) -> [i64]:
    var out: [i64] = []
    for block in func.blocks:
        for inst in block.insts:
            out.push(inst.opcode)
    out

fn read_u32(bytes: [i64], offset: i64) -> i64:
    bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)

fn contains_text(bytes: [i64], needle: text) -> bool:
    val n = needle.bytes()
    var start = 0
    while start + n.len() <= bytes.len():
        var hit = true
        for index in 0..n.len():
            if bytes[start + index] != (n[index] as i64):
                hit = false
                break
        if hit: return true
        start = start + 1
    false

describe "XRay PR5 native AArch64 sled emission":
    it "encodes the sled pseudo-instruction as the V1 contract template plus a CALL26 trampoline reloc":
        val inst = new_mach_inst(A64_OP_XRAY_SLED, [op_imm(3), op_imm(XRAY_MAP_KIND_ENTRY_V1)])
        val encoded = encode_inst_aarch64(a64_new_encode_context(), inst)
        expect(encoded.code).to_equal(golden_sled_site3())
        val site = TraceNativeSiteV1(site_id: 3, function_id: 1, kind: TraceEventKindV1.Entry,
            offset: 0, target_offset: 20, encoding: TraceNativeEncodingV1.Arm64Branch26)
        val template = trace_native_off_template_v1(site, 32).unwrap()
        var template_i64: [i64] = []
        for index in 0..template.len():
            template_i64.push(template[index] as i64)
        expect(encoded.code).to_equal(template_i64)
        expect(encoded.relocations.len()).to_equal(1)
        expect(encoded.relocations[0].offset).to_equal(20)
        expect(encoded.relocations[0].symbol_name).to_equal(XRAY_TRAMPOLINE_SYMBOL_V1)
        expect(encoded.relocations[0].reloc_type).to_equal(283)

    it "inserts an entry sled first and an exit sled before every RET of instrumented functions only":
        val planned = xray_insert_sleds_aarch64(fixture_module(), ["traced"])
        val traced = planned.module.functions[0]
        expect(opcodes(traced)).to_equal([A64_OP_XRAY_SLED, A64_OP_STP, A64_OP_NOP, A64_OP_XRAY_SLED, A64_OP_RET, A64_OP_NOP, A64_OP_XRAY_SLED, A64_OP_RET])
        expect(opcodes(planned.module.functions[1])).to_equal([A64_OP_STP, A64_OP_NOP, A64_OP_RET, A64_OP_NOP, A64_OP_RET])
        expect(planned.sites.len()).to_equal(3)
        expect(planned.sites[0].site_id).to_equal(1)
        expect(planned.sites[0].kind).to_equal(XRAY_MAP_KIND_ENTRY_V1)
        expect(planned.sites[1].kind).to_equal(XRAY_MAP_KIND_EXIT_V1)
        expect(planned.sites[2].site_id).to_equal(3)
        expect(planned.sites[2].function_id).to_equal(1)
        expect(planned.module.extern_symbols.contains(XRAY_TRAMPOLINE_SYMBOL_V1)).to_equal(true)

    it "is the identity when no function is instrumented (static off)":
        val module = fixture_module()
        val planned = xray_insert_sleds_aarch64(module, [])
        expect(planned.sites.len()).to_equal(0)
        expect(opcodes(planned.module.functions[0])).to_equal(opcodes(module.functions[0]))
        expect(planned.module.extern_symbols.len()).to_equal(module.extern_symbols.len())
        val encoded = encode_module_aarch64(module)
        val off = emit_elf_aarch64(encoded, module, empty_mir_module("xray_fixture"))
        val with_empty = emit_elf_aarch64_xray(encoded, module, empty_mir_module("xray_fixture"), [])
        expect(with_empty).to_equal(off)
        expect(contains_text(off, ".simple_xray_map")).to_equal(false)

    it "locates every emitted sled from its trampoline relocation":
        val planned = xray_insert_sleds_aarch64(fixture_module(), ["traced"])
        val encoded = encode_module_aarch64(planned.module)
        val sites = xray_locate_sleds(encoded, planned.sites).unwrap()
        # entry at 0; body: STP(4) NOP(4) -> exit sled at 40; RET; NOP -> exit at 80
        expect(sites[0].code_offset).to_equal(0)
        expect(sites[1].code_offset).to_equal(40)
        expect(sites[2].code_offset).to_equal(80)
        for site in sites:
            expect(read_u32(encoded[0].code, site.code_offset)).to_equal(0x14000008)
            expect(read_u32(encoded[0].code, site.code_offset + 12)).to_equal(0x52800000 | (site.site_id << 5))
        # A planned sled whose relocation is missing fails closed.
        val stripped = [EncodedFunction(name: encoded[0].name, code: encoded[0].code, relocations: []), encoded[1]]
        expect(xray_locate_sleds(stripped, planned.sites).is_err()).to_equal(true)

    it "writes a .simple_xray_map section whose rows decode back to the emitted sleds":
        val planned = xray_insert_sleds_aarch64(fixture_module(), ["traced"])
        val encoded = encode_module_aarch64(planned.module)
        val sites = xray_locate_sleds(encoded, planned.sites).unwrap()
        val object = emit_elf_aarch64_xray(encoded, planned.module, empty_mir_module("xray_fixture"), sites)
        expect(contains_text(object, ".simple_xray_map")).to_equal(true)
        val map_bytes = xray_object_map_bytes(object).unwrap()
        val map = xray_map_decode_v1(map_bytes).unwrap()
        expect(map.isa).to_equal(XRAY_MAP_ISA_AARCH64_V1)
        expect(map.functions.len()).to_equal(1)
        expect(map.functions[0].name).to_equal("traced")
        expect(map.sites.len()).to_equal(3)
        expect(map.sites[1].kind).to_equal(XRAY_MAP_KIND_EXIT_V1)
        expect(map.sites[0].off_word).to_equal(0x14000008)
        expect(map.sites[0].on_word).to_equal(0xD503201F)
        expect(map.build_id.len()).to_equal(16)
