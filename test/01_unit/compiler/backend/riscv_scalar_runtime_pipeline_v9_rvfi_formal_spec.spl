use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v9_rvfi_formal.{RiscvScalarRuntimePipelineV9RvfiFormalArtifactsV1, generate_riscv_scalar_runtime_pipeline_v9_rvfi_formal_artifacts, reduce_riscv_scalar_runtime_pipeline_v9_rvfi_formal_receipt}

fn v9_hash() -> text: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn v9_receipt(artifacts: RiscvScalarRuntimePipelineV9RvfiFormalArtifactsV1) -> text:
    "schema simple-riscv-v9-rvfi-formal-receipt-v1\nmodule " + artifacts.module_name + "\nproduct_profile " + artifacts.profile + "\nxlen " + artifacts.xlen.to_text() + "\nhwir_sha256 " + artifacts.hwir_hash + "\nrtl_sha256 " + artifacts.rtl_hash + "\nrvfi_contract_sha256 " + artifacts.rvfi_contract_hash + "\nassumption_manifest_sha256 " + artifacts.assumption_manifest_hash + "\nprove_status proved\ncover_status covered\nmutant_status counterexample\nprove_output_sha256 " + v9_hash() + "\ncover_output_sha256 " + v9_hash() + "\nmutant_output_sha256 " + v9_hash() + "\nsby_version_sha256 " + v9_hash() + "\nyosys_version_sha256 " + v9_hash() + "\nghdl_version_sha256 " + v9_hash() + "\nboolector_version_sha256 " + v9_hash() + "\ninput_sha256 " + artifacts.core_file + " " + sha256_text(artifacts.core_vhdl) + "\ninput_sha256 " + artifacts.harness_file + " " + sha256_text(artifacts.harness_vhdl) + "\ninput_sha256 " + artifacts.mutant_harness_file + " " + sha256_text(artifacts.mutant_harness_vhdl) + "\ninput_sha256 " + artifacts.prove_file + " " + sha256_text(artifacts.prove_sby) + "\ninput_sha256 " + artifacts.cover_file + " " + sha256_text(artifacts.cover_sby) + "\ninput_sha256 " + artifacts.mutant_file + " " + sha256_text(artifacts.mutant_sby) + "\n"

describe "V9 RVFI formal artifacts":
    it "generates strict RV32 and RV64 formal jobs from the V9 RVFI wrapper":
        val rv32 = generate_riscv_scalar_runtime_pipeline_v9_rvfi_formal_artifacts("v9_formal32", CoreConfig.rv32im_zicsr_zifencei(), LsuConfig.rv32_product_default()).ok().unwrap()
        val rv64 = generate_riscv_scalar_runtime_pipeline_v9_rvfi_formal_artifacts("v9_formal64", CoreConfig.rv64im_zicsr_zifencei(), LsuConfig.rv64_product_default()).ok().unwrap()
        expect(rv32.core_vhdl).to_contain("entity v9_formal32_rvfi")
        expect(rv64.core_vhdl).to_contain("entity v9_formal64_rvfi")
        expect(rv32.manifest).to_contain("product_profile=rv32im_zicsr_zifencei")
        expect(rv32.manifest).to_contain("proved_property_ids=v9.rvfi.non-control-pc-plus-four,v9.rvfi.retirement-order,v9.rvfi.non-interrupt-retirement,v9.runtime.fault-fail-closed")
        expect(rv64.prove_sby).to_contain("mode prove")
        expect(rv64.cover_sby).to_contain("mode cover")
        expect(rv32.harness_vhdl).to_contain("non_control_non_trap_pc_advance_by_four")
        expect(rv32.harness_vhdl).to_contain("signal formal_started : std_logic := '0'")
        expect(rv32.harness_vhdl).to_contain("-- psl reset_released: assume always (formal_started='1' -> rst='0')")
        expect(rv32.harness_vhdl).to_contain("rvfi_insn(6 downto 0)=\"1100011\"")
        expect(rv32.harness_vhdl).to_contain("temporal pairing is deliberately outside this generic RVFI harness")
        expect(rv32.harness_vhdl).to_contain("unsigned(rvfi_order) = 0")
        expect(rv64.mutant_harness_vhdl).to_contain("order_zero_mutant_must_fail")
        expect(rv64.mutant_harness_vhdl).to_contain("unsigned(rvfi_order) /= 0")
        val receipt = reduce_riscv_scalar_runtime_pipeline_v9_rvfi_formal_receipt(rv32, v9_receipt(rv32))
        expect(receipt.property_ids.contains("v9.csr.commit")).to_be(false)
        expect(receipt.property_ids.contains("v9.rvfi.trap")).to_be(false)
        expect(receipt.property_ids.contains("v9.runtime.fault-fail-closed")).to_be(true)

    it "never promotes caller-built V9 receipt text to executed evidence":
        val artifacts = generate_riscv_scalar_runtime_pipeline_v9_rvfi_formal_artifacts("v9_receipt", CoreConfig.rv64im_zicsr_zifencei(), LsuConfig.rv64_product_default()).ok().unwrap()
        val receipt = v9_receipt(artifacts)
        val accepted = reduce_riscv_scalar_runtime_pipeline_v9_rvfi_formal_receipt(artifacts, receipt)
        val forged = reduce_riscv_scalar_runtime_pipeline_v9_rvfi_formal_receipt(artifacts, receipt.replace("cover_status covered", "cover_status proved"))
        val ambiguous_profile = reduce_riscv_scalar_runtime_pipeline_v9_rvfi_formal_receipt(artifacts, receipt.replace("product_profile " + artifacts.profile, "profile " + artifacts.profile))
        val extra = reduce_riscv_scalar_runtime_pipeline_v9_rvfi_formal_receipt(artifacts, receipt + "unbound value\n")
        expect(accepted.status).to_equal(FormalStatus.Failed)
        expect(accepted.evidence_receipt_hashes.len()).to_equal(0)
        expect(accepted.engine_versions.len()).to_equal(0)
        expect(forged.status).to_equal(FormalStatus.Failed)
        expect(ambiguous_profile.status).to_equal(FormalStatus.Failed)
        expect(extra.status).to_equal(FormalStatus.Failed)
