use std.spec.*
use compiler.backend.mir_to_llvm.{xray_msvc_export_directives, xray_msvc_export_directives_for_arch}

describe "XRay MSVC .drectve export symbol mangling":
    it "uses two underscores for x64, arm64, and armv7 MSVC targets (m:w)":
        for arch in ["x86_64", "aarch64", "armv7"]:
            expect(xray_msvc_export_directives_for_arch(false, arch)).to_equal([
                "/EXPORT:__simple_xray_descriptor_v1,DATA",
                "/EXPORT:__simple_xray_names_v1,DATA",
                "/EXPORT:__simple_xray_hook_v1,DATA",
                "/EXPORT:__simple_xray_ring_v2,DATA"
            ])
            expect(xray_msvc_export_directives_for_arch(true, arch)).to_equal([
                "/EXPORT:__simple_xray_descriptor_v1,DATA",
                "/EXPORT:__simple_xray_names_v1,DATA",
                "/EXPORT:__simple_xray_hook_v1,DATA",
                "/EXPORT:__simple_xray_ring_v2,DATA",
                "/EXPORT:__simple_xray_ring_wrap_v2,DATA"
            ])
        expect(xray_msvc_export_directives(false)).to_equal(
            xray_msvc_export_directives_for_arch(false, "x86_64"))

    it "uses three underscores for 32-bit x86 MSVC targets (m:x)":
        for arch in ["i686", "i386", "x86"]:
            expect(xray_msvc_export_directives_for_arch(false, arch)).to_equal([
                "/EXPORT:___simple_xray_descriptor_v1,DATA",
                "/EXPORT:___simple_xray_names_v1,DATA",
                "/EXPORT:___simple_xray_hook_v1,DATA",
                "/EXPORT:___simple_xray_ring_v2,DATA"
            ])
            expect(xray_msvc_export_directives_for_arch(true, arch)).to_equal([
                "/EXPORT:___simple_xray_descriptor_v1,DATA",
                "/EXPORT:___simple_xray_names_v1,DATA",
                "/EXPORT:___simple_xray_hook_v1,DATA",
                "/EXPORT:___simple_xray_ring_v2,DATA",
                "/EXPORT:___simple_xray_ring_wrap_v2,DATA"
            ])
