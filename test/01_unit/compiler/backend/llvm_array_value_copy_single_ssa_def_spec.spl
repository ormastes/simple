# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir_opt.{ssa_alloca_transform_blocks}
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use app.io.mod.{file_read}


# Bug llvm_text_backend_array_copy_loop_ssa_redefinition_2026-08-22: `val t = xs`
# (array value copy) lowers to a per-element copy LOOP whose counter local is
# written in the preheader AND the latch. The alloca SSA transform refused every
# function with a `Ret(Some(..))` terminator, so in a value-returning function
# nothing slotted that counter and the text LLVM backend emitted it twice
# (llc: multiple definition of local value named 'lN'). The transform now admits
# value returns through the same operand-payload gate as If/Switch and loads
# the returned local at the ret.

fn lower_source(src: text) -> MirModule:
    val ast = parse_full_frontend(src, "copy.spl", "copy.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("copy.spl")
    val hir = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.lower_module(hir)

fn find_function(mir: MirModule, name: text) -> MirFunction?:
    for function in mir.functions.values():
        if function.name == name:
            return Some(function)
    nil

# Name of any `%lN` that is defined more than once in the emitted text, or "".
fn first_duplicate_ssa_def(llvm: text) -> text:
    var seen: [text] = []
    for line in llvm.split("\n"):
        val t = line.trim()
        if not t.starts_with("%l"):
            continue
        val eq = t.index_of(" = ")
        if eq < 0:
            continue
        val name = t.substring(0, eq)
        if seen.contains(name):
            return name
        seen = seen.push(name)
    ""

fn count_value_returns(function: MirFunction) -> i64:
    var n = 0
    for block in function.blocks:
        match block.terminator:
            case MirTerminator.Ret(value):
                if value != nil:
                    n = n + 1
            case _:
                pass
    n

val copy_in_value_fn = "fn copy_len(src: [i64]) -> i64:\n    val t = src\n    t.len()\n"
val copy_in_main = "fn main() -> i64:\n    var xs = [1, 2]\n    val t = xs\n    xs.push(9)\n    t.len() + xs.len()\n"
val loop_ret_local = "fn total(n: i64) -> i64:\n    var acc = 0\n    var i = 0\n    while i < n:\n        acc = acc + i\n        i = i + 1\n    acc\n"

describe "alloca SSA transform admits value-returning functions", tag: ["only-compiled"]:
    # @manual scenario evidence
    it "applies to a value-returning function whose copy-loop counter is multi-def":
        # @req REQ-SSPEC-UNIT
        step("applies to a value-returning function whose copy-loop counter is multi-def")
        val mir = lower_source(copy_in_value_fn)
        val f = find_function(mir, "copy_len").unwrap()
        expect(count_value_returns(f)).to_be_greater_than(0)
        val r = ssa_alloca_transform_blocks(f.blocks, f.locals, f.entry_block)
        expect(r.applied).to_equal(true)

    it "loads a reassigned local at the ret instead of leaving it unrewritten":
        # @req REQ-SSPEC-UNIT
        step("loads a reassigned local at the ret instead of leaving it unrewritten")
        val mir = lower_source(loop_ret_local)
        val f = find_function(mir, "total").unwrap()
        val r = ssa_alloca_transform_blocks(f.blocks, f.locals, f.entry_block)
        expect(r.applied).to_equal(true)
        val llvm = MirToLlvm.create("test.copy.total", CodegenTarget.X86_64, nil).translate_module(mir)
        expect(first_duplicate_ssa_def(llvm)).to_equal("")
        expect(llvm.contains("= load i64, ptr")).to_equal(true)

describe "array value copy emits a single SSA definition per local", tag: ["only-compiled"]:
    it "copy inside a value-returning fn":
        # @req REQ-SSPEC-UNIT
        step("copy inside a value-returning fn")
        val mir = lower_source(copy_in_value_fn)
        val llvm = MirToLlvm.create("test.copy.value_fn", CodegenTarget.X86_64, nil).translate_module(mir)
        expect(first_duplicate_ssa_def(llvm)).to_equal("")

    it "aliased copy then mutate original in main":
        # @req REQ-SSPEC-UNIT
        step("aliased copy then mutate original in main")
        val mir = lower_source(copy_in_main)
        val llvm = MirToLlvm.create("test.copy.main", CodegenTarget.X86_64, nil).translate_module(mir)
        expect(first_duplicate_ssa_def(llvm)).to_equal("")

    it "text and struct element arrays":
        # @req REQ-SSPEC-UNIT
        step("text and struct element arrays")
        val src = "struct Pt:\n    x: i64\n\nfn go() -> i64:\n    val ss = [\"a\"]\n    val ts = ss\n    val ps = [Pt(x: 1)]\n    val tp = ps\n    ts.len() + tp.len()\n"
        val mir = lower_source(src)
        val llvm = MirToLlvm.create("test.copy.texts", CodegenTarget.X86_64, nil).translate_module(mir)
        expect(first_duplicate_ssa_def(llvm)).to_equal("")

    it "repairs flat bootstrap functions at the final LLVM boundary":
        # @req REQ-SSPEC-UNIT
        step("Read the flat bootstrap LLVM consumer")
        val source = file_read(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        expect(source).to_contain(
            "val fn_ = llvm_bootstrap_ssa_function(")
        expect(source).to_contain(
            "bootstrap_mir_function_at(index), true)")

        step("Confirm the flat MIR producer stores canonical unrewritten MIR")
        val producer = file_read(
            "src/compiler/50.mir/_MirLowering/bootstrap_globals.spl")
        expect(producer).to_contain(
            "_bootstrap_mir_functions = _bootstrap_mir_functions.push(fn_)")
        expect(producer.contains("stored_fn.blocks = rewritten.blocks"))
            .to_equal(false)

        step("Keep a directly defined Return-kind local as the return value")
        expect(source.contains(
            "return_local_id == return_slot_id or"))
            .to_equal(false)
        expect(source).to_contain(
            "val requires_fallback = not self.local_types.has(return_local_id)")

        step("Preserve return operands that do not require slot loads")
        val transform = file_read(
            "src/compiler/60.mir_opt/mir_opt/var_reassign_ssa.spl")
        expect(transform).to_contain(
            "if ret_slot_index < 0:\n                    return ([], term, next_temp)")

    it "counts every reassigned local without aggregate tuple transport":
        # @req REQ-SSPEC-UNIT
        step("Read the alloca transform's multi-definition census")
        val source = file_read(
            "src/compiler/60.mir_opt/mir_opt/var_reassign_ssa.spl")
        expect(source.contains("val next_counts = local_count_increment("))
            .to_equal(false)
        expect(source).to_contain("var write_count = 0")
        expect(source).to_contain(
            "if _ssa_written_local_id(count_inst) == written_id:")
        expect(source).to_contain(
            "reassigned = reassigned.push(written_id)")
        expect(source.contains("var local_ids: [i64] = []"))
            .to_equal(false)
        expect(source.contains("var counts: [i64] = []"))
            .to_equal(false)
        expect(source).to_contain("case Copy(dest, _):\n            ssa_local_id_value(dest)")
        expect(source).to_contain(
            "val reassigned = ssa_reassigned_locals_for_blocks(blocks)")
        expect(source).to_contain(
            "val cross_block = ssa_cross_block_live_locals(blocks, mir_locals)")
        expect(source.contains(
            "if not ssa_inst_operand_payloads_valid(inst):"))
            .to_equal(false)
        expect(source.contains(
            "return ssa_var_transform_reject(\"invalid terminator operands\""))
            .to_equal(false)
