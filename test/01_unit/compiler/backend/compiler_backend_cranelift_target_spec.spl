use std.spec
use std.io_runtime.{file_read}
use compiler.backend.codegen.{CodegenMode, CodegenPipeline, CraneliftTarget}

describe "compiler backend Cranelift target boundary":
    it "constructs the native AOT pipeline with the Cranelift target owner":
        val pipeline = CodegenPipeline.aot(CraneliftTarget.Native)
        expect(pipeline.target).to_equal(CraneliftTarget.Native)
        expect(pipeline.mode).to_equal(CodegenMode.Aot)

    it "preserves the explicit x86_64 Cranelift target adjacent case":
        val pipeline = CodegenPipeline.aot(CraneliftTarget.X86_64)
        expect(pipeline.target).to_equal(CraneliftTarget.X86_64)
        expect(pipeline.mode).to_equal(CodegenMode.Aot)

    it "does not route the backend through the facade CodegenTarget enum":
        val source = file_read("src/compiler/70.backend/backend/compiler.spl")
        expect(source).to_contain("use compiler.backend.codegen.{CodegenPipeline, CraneliftTarget}")
        expect(source).to_contain("CodegenPipeline.aot(CraneliftTarget.Native)")
        expect(source.contains("CodegenPipeline.aot(CodegenTarget.Native)")).to_equal(false)
