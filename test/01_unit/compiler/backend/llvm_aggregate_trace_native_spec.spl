use std.spec.*
use std.env.{env_get, env_set, env_has, env_unset}
use test.fixtures.compiler.llvm_aggregate_trace_native.{llvm_aggregate_trace_case}

describe "LLVM aggregate fast-path trace retains its typed operands":
    it "emits both array elements and marks the actual destination defined":
        val was_set = env_has("SIMPLE_MIRB_TRACE")
        val previous = env_get("SIMPLE_MIRB_TRACE")
        val enabled = env_set("SIMPLE_MIRB_TRACE", "1")
        val correct = llvm_aggregate_trace_case()
        val restored = if was_set:
            env_set("SIMPLE_MIRB_TRACE", previous)
        else:
            env_unset("SIMPLE_MIRB_TRACE")
        expect(enabled).to_equal(true)
        expect(restored).to_equal(true)
        expect(correct).to_equal(true)
