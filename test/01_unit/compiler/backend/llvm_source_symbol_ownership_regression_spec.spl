# Regression guard for the two source ownership defects that reached the
# Stage 2 LLVM backend as undeclared global loads. The backend is correct to
# reject both: receiver and control-flow tokens must never become globals.

use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "LLVM source symbol ownership regressions":
    it "keeps the later DAP receiver methods inside an explicit impl owner":
        step("keeps the later DAP receiver methods inside an explicit impl owner")
        val source = rt_file_read_text("src/lib/editor/services/debug_session_dap.spl") ?? ""
        val poll = source.find("fn editor_debug_dap_poll_process_pid")
        val owned = source.find("impl EditorDebugDapClient:\n    me _send_framed_json")
        expect(poll).to_be_greater_than(-1)
        expect(owned).to_be_greater_than(poll)

    it "keeps the failed-close return in a statement block":
        step("keeps the failed-close return in a statement block")
        val source = rt_file_read_text("src/lib/nogc_sync_mut/rt_hal/process_task_arena.spl") ?? ""
        expect(source).to_contain("else:\n            return unavailable_exact_join(-1, deadline_ticks)")
        expect(source).to_not_contain("else: return unavailable_exact_join(-1, deadline_ticks)")
