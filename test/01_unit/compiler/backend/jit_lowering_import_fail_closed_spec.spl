# Pure-Simple JIT: imports the lowering declares on its own fail closed.
#
# jit_extern_resolution refuses a named callee it cannot bind before codegen.
# The shared Cranelift lowering also declares imports that no MIR callee names:
# a string constant boxes through rt_string_new_literal, array literals go
# through rt_array_new/rt_array_push, aggregates through rt_alloc, an imported
# module static through a generated accessor. The provider binds imports by
# process symbol lookup and registers no runtime symbols, so any of these
# aborted the host inside rt_cranelift_finalize_module ("can't resolve symbol
# rt_string_new_literal", exit 134). The JIT now records every import the
# lowering declares and refuses, by name and before finalize, any import that
# is not a Foreign callee of the module.
# Bug: doc/08_tracking/bug/pure_simple_jit_provider_registers_no_runtime_symbols_2026-11-13.md
use std.spec.*
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.cranelift_codegen_adapter.{cranelift_jit_run_main}

fn entry_fn(params: [MirType], insts: [MirInst], ret: MirOperand) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 1), name: "main",
        signature: MirSignature(params: params, return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: insts, terminator: MirTerminator.Ret(Some(ret)))],
        entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

fn int_op(value: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), MirType.i64()))

fn entry_module(name: text, insts: [MirInst], ret: MirOperand) -> MirModule:
    MirModule(name: name, functions: {SymbolId(id: 1): entry_fn([], insts, ret)},
        statics: {}, constants: {}, types: {})

fn outcome(module: MirModule) -> text:
    match cranelift_jit_run_main(module):
        case Ok(value): "ok:{value}"
        case Err(message): "err:{message}"

describe "pure-Simple JIT entry ABI":

    it "returns main's full i64, negative and above 32 bits":
        expect(outcome(entry_module("entry_neg", [], int_op(-5)))).to_equal("ok:-5")
        expect(outcome(entry_module("entry_wide", [], int_op(8589934593)))).to_equal("ok:8589934593")

    it "refuses a main that takes parameters instead of calling it with none":
        val module = MirModule(name: "entry_params",
            functions: {SymbolId(id: 1): entry_fn([MirType.i64()], [], int_op(1))},
            statics: {}, constants: {}, types: {})
        val result = outcome(module)
        expect(result).to_start_with("err:E-JIT-ENTRY:")
        expect(result).to_contain("entry_params")

describe "pure-Simple JIT refuses imports no MIR callee names":

    it "refuses an imported module static by name":
        val imported = MirStatic(symbol: SymbolId(id: 7), name: "provider_count", type_: MirType.i64(),
            init: nil, is_mutable: false, alignment: 8, visibility: Visibility.Public, is_external: true)
        val module = MirModule(name: "entry_static",
            functions: {SymbolId(id: 1): entry_fn([], [], int_op(1))},
            statics: {SymbolId(id: 7): imported}, constants: {}, types: {})
        val result = outcome(module)
        expect(result).to_start_with("err:")
        expect(result).to_contain("E-JIT-EXTERN-STATIC-UNBOUND: provider_count")

    it "refuses the string-literal runtime helper by name, before finalize":
        val literal = MirInst(kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Str("hi"), MirType.i64()), span: nil)
        val result = outcome(entry_module("entry_literal", [literal], int_op(3)))
        expect(result).to_start_with("err:")
        expect(result).to_contain("E-JIT-LOWERING-IMPORT-UNBOUND: rt_string_new_literal")
        expect(result).to_contain("entry_literal")

    it "keeps the host alive and the next module runnable after that refusal":
        val literal = MirInst(kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Str("hi"), MirType.i64()), span: nil)
        expect(outcome(entry_module("entry_literal_again", [literal], int_op(3)))).to_start_with("err:")
        expect(outcome(entry_module("entry_after", [], int_op(42)))).to_equal("ok:42")
