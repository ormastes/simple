# Regression: the SimpleOS RISC-V link path must compile its entry/runtime/
# module-init C and asm with clang, never a GCC driver (CLAUDE.md: never GCC).
# Before the fix it invoked riscv64-unknown-elf-gcc, which is absent on a
# clang+lld host, so every riscv64 SimpleOS kernel link failed with an empty
# "SimpleOS RISC-V entry compilation failed:" diagnostic.
use std.spec
use std.spec.step
use std.nogc_sync_mut.io_runtime.{file_read}

val LINKERS = "src/compiler/70.backend/backend/simpleos_native_linkers.spl"

describe "SimpleOS RISC-V link toolchain":
    it "invokes no GCC driver":
        step("read the linker source and look for a gcc driver invocation")
        val src = file_read(LINKERS)
        expect(src.contains("process_run(\"riscv64-unknown-elf-gcc\"")).to_equal(false)

    it "cross-compiles with clang targeting riscv64-unknown-elf":
        step("the clang driver target flag is present")
        val src = file_read(LINKERS)
        expect(src.contains("--target=riscv64-unknown-elf")).to_equal(true)
