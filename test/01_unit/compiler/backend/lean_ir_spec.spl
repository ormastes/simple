use std.spec
use compiler.backend.backend.lean_ir.{LeanTypeIR, LeanBinaryOpIR, LeanBinderIR, LeanTermIR, LeanTheoremIR}
use compiler.backend.backend.lean_backend.{LeanBuilder}

fn rendered(term: LeanTermIR) -> text:
    match term.render():
        case Ok(value): value
        case Err(_): ""

describe "typed Lean IR v1":
    it "renders an execution-linked contract without raw text or existential witnesses":
        val x = LeanBinderIR("x", LeanTypeIR.BitVec(32))
        val call = LeanTermIR.Apply("increment", [LeanTermIR.Var("x")])
        val post = LeanTermIR.Binary(LeanBinaryOpIR.Equal, LeanTermIR.Var("result"), LeanTermIR.Binary(LeanBinaryOpIR.BitVecAdd, LeanTermIR.Var("x"), LeanTermIR.BitVecLiteral(1, 32)))
        val linked = LeanTermIR.Forall([x], LeanTermIR.Let(LeanBinderIR("result", LeanTypeIR.BitVec(32)), call, post))
        val output = rendered(linked)
        expect(output).to_contain("let result : BitVec 32 := increment x")
        expect(output.contains("∃")).to_equal(false)

    it "rejects invalid widths before printing":
        val invalid = LeanTermIR.BitVecLiteral(1, 0)
        expect(invalid.diagnostic()).to_contain("WIDTH")
        expect(rendered(invalid)).to_equal("")

    it "requires explicit proof ownership for theorem emission":
        val theorem = LeanTheoremIR("safe", LeanTermIR.TrueProp, "")
        expect(theorem.diagnostic()).to_contain("PROOF")

    it "lets the builder emit validated typed theorems without tactic guessing":
        var builder = LeanBuilder.create()
        val theorem = LeanTheoremIR("safe", LeanTermIR.TrueProp, "by trivial")
        val emitted = builder.emit_typed_theorem(theorem)
        expect(emitted.is_ok()).to_equal(true)
        expect(builder.build()).to_equal("theorem safe : True := by trivial")
