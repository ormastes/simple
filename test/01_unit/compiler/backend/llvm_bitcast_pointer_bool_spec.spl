# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec.*
use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mir.mir_data.*


fn emit_bitcast_ir(source_llvm_type: text, return_llvm_type: text) -> text:
    val llvm = MirToLlvm.create("test.llvm.bitcast.pointer_bool", CodegenTarget.X86_64, nil)
    llvm.local_types[0] = source_llvm_type
    llvm.defined_locals[0] = true
    if source_llvm_type == "ptr":
        llvm.ptr_locals[0] = true
    elif source_llvm_type == "i1":
        llvm.bool_locals[0] = true
    # Model only a defined SSA value's return coercion. The real env/paths IR
    # also has an upstream missing-store symptom; this focused helper proves
    # verifier legalization without treating that semantic defect as fixed.
    llvm.current_function_name = "bitcast_return"
    llvm.current_return_type = return_llvm_type
    llvm.translate_terminator(MirTerminator.Ret(Some(mir_operand_copy(LocalId(id: 0)))))
    llvm.builder.build()

fn emit_mir_bitcast_ir(source_llvm_type: text, target: MirType) -> text:
    val llvm = MirToLlvm.create("test.llvm.mir_bitcast", CodegenTarget.X86_64, nil)
    llvm.local_types[0] = source_llvm_type
    llvm.defined_locals[0] = true
    if source_llvm_type == "ptr":
        llvm.ptr_locals[0] = true
    elif source_llvm_type == "i1":
        llvm.bool_locals[0] = true
    llvm.llvm_bitcast_impl(LocalId(id: 1), mir_operand_copy(LocalId(id: 0)), target)
    llvm.builder.build()

describe "LLVM pointer and boolean bitcast lowering":
    # @manual scenario evidence
    it "preserves an i1 value through native integer before pointer conversion":
        # @req REQ-SSPEC-UNIT
        step("preserves an i1 value through native integer before pointer conversion")
        val ir = emit_bitcast_ir("i1", "ptr")

        expect(ir).to_contain("zext i1 %l0 to i64")
        expect(ir).to_contain("inttoptr i64")
        expect(ir).to_contain("to ptr")
        expect(ir).to_contain("ret ptr %")
        expect(ir.contains("inttoptr i64 0 to ptr")).to_equal(false)
        expect(ir.contains("bitcast i1 %l0 to ptr")).to_equal(false)

    it "compares a pointer against null when producing i1":
        # @req REQ-SSPEC-UNIT
        step("compares a pointer against null when producing i1")
        val ir = emit_bitcast_ir("ptr", "i1")

        expect(ir).to_contain("icmp ne ptr %l0, null")
        expect(ir).to_contain("ret i1 %")
        expect(ir.contains("bitcast ptr %l0 to i1")).to_equal(false)

    it "uses inttoptr for an integer to pointer conversion":
        # @req REQ-SSPEC-UNIT
        step("uses inttoptr for an integer to pointer conversion")
        val ir = emit_bitcast_ir("i64", "ptr")

        expect(ir).to_contain("inttoptr i64 %l0 to ptr")
        expect(ir.contains("bitcast i64 %l0 to ptr")).to_equal(false)

    it "uses ptrtoint for a pointer to integer conversion":
        # @req REQ-SSPEC-UNIT
        step("uses ptrtoint for a pointer to integer conversion")
        val ir = emit_bitcast_ir("ptr", "i64")

        expect(ir).to_contain("ptrtoint ptr %l0 to i64")
        expect(ir.contains("bitcast ptr %l0 to i64")).to_equal(false)

    it "lowers a MIR payload word bitcast to a pointer":
        step("lowers a MIR payload word bitcast to a pointer")
        val pointer_type = MirType(kind: MirTypeKind.Ref(MirType.i64(), true))
        val ir = emit_mir_bitcast_ir("i64", pointer_type)
        expect(ir).to_contain("%l1 = inttoptr i64 %l0 to ptr")
        expect(ir.contains("bitcast i64 %l0 to ptr")).to_equal(false)

    it "lowers a MIR pointer bitcast to an integer word":
        step("lowers a MIR pointer bitcast to an integer word")
        val ir = emit_mir_bitcast_ir("ptr", MirType.i64())
        expect(ir).to_contain("%l1 = ptrtoint ptr %l0 to i64")
        expect(ir.contains("bitcast ptr %l0 to i64")).to_equal(false)

    it "preserves same pointer identity without a pointer bitcast":
        step("preserves same pointer identity without a pointer bitcast")
        val pointer_type = MirType(kind: MirTypeKind.Ref(MirType.i64(), true))
        val ir = emit_mir_bitcast_ir("ptr", pointer_type)
        expect(ir).to_contain("%l1 = getelementptr i8, ptr %l0, i64 0")

    it "keeps integer to float bit reinterpretation":
        step("keeps integer to float bit reinterpretation")
        val ir = emit_mir_bitcast_ir("i64", MirType(kind: MirTypeKind.F64))
        expect(ir).to_contain("%l1 = bitcast i64 %l0 to double")

    it "legalizes one-bit integer pointer bit reinterpretation in both directions":
        step("legalizes one-bit integer pointer bit reinterpretation in both directions")
        val pointer_type = MirType(kind: MirTypeKind.Ref(MirType.i64(), true))
        val to_pointer = emit_mir_bitcast_ir("i1", pointer_type)
        val to_bit = emit_mir_bitcast_ir("ptr", MirType(kind: MirTypeKind.Bool))
        expect(to_pointer).to_contain("%l1 = inttoptr i1 %l0 to ptr")
        expect(to_bit).to_contain("%l1 = ptrtoint ptr %l0 to i1")
