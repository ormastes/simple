# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

fn mir_to_llvm_core_source() -> text:
    rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl") ?? ""

fn driver_bootstrap_source() -> text:
    rt_file_read_text("src/compiler/80.driver/driver_bootstrap.spl") ?? ""

fn linker_native_source() -> text:
    rt_file_read_text("src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl") ?? ""

fn llvm_backend_tools_source() -> text:
    rt_file_read_text("src/compiler/70.backend/backend/llvm_backend_tools.spl") ?? ""

# 050209d9b36 ("fix: speed up pure Simple bootstrap") removed the SIMPLE_BOOTSTRAP
# "minimal Stage2 CLI entry" stub and the block_defined_locals tracker; the
# bootstrap lane now emits the real __simple_main and slots multi-def locals
# through ssa_alloca_transform_blocks. These contracts pin that current shape.
describe "bootstrap LLVM entry symbol source":
    # @manual scenario evidence
    it "uses plain function definitions for bootstrap objects":
        # @req REQ-SSPEC-UNIT
        step("uses plain function definitions for bootstrap objects")
        val source = mir_to_llvm_core_source()

        expect(source).to_contain(
            "if ir_handle >= 0 or placement_naked or placement_suffix != \"\" or placement_prefix != \"define\"")
        val scalar_start = source.index_of(
            "        else:\n            val param_str = params.join(\", \")") ?? -1
        val scalar_end = source.index_of(
            "        if bootstrap_debug:\n            print \"[mir-to-llvm] function:started") ?? -1
        expect(scalar_start).to_be_greater_than(-1)
        expect(scalar_end).to_be_greater_than(scalar_start)
        val scalar_opener = source.substring(scalar_start, scalar_end)
        expect(scalar_opener).to_contain("val param_str = params.join(\", \")")
        expect(scalar_opener).to_contain("var attrs = \" nounwind\" + placement_attrs")
        expect(scalar_opener).to_contain("if is_readonly and not placement_naked:")
        expect(scalar_opener).to_contain("attrs = attrs + \" readonly\"")
        expect(scalar_opener).to_contain("if (is_small or self.fn_inline.has(name)) and not placement_naked:")
        expect(scalar_opener).to_contain("attrs = attrs + \" alwaysinline\"")
        expect(scalar_opener).to_contain("Some(id): dbg_suffix = \" !dbg !{{id}}\"")
        expect(scalar_opener).to_contain(
            "val opening = \"define {{effective_ret_ty}} @{{fn_name}}({{param_str}}){{attrs}}{{dbg_suffix}} {{{{\"")
        val handle_pos = scalar_opener.index_of(
            "val builder_handle = llvm_ir_builder_handle(self.builder)") ?? -1
        val push_pos = scalar_opener.index_of(
            "llvm_ir_builder_push_line(opening, builder_handle)") ?? -1
        expect(handle_pos).to_be_greater_than(-1)
        expect(handle_pos).to_be_less_than(push_pos)
        expect(scalar_opener.contains("llvm_ir_builder_start_function_opt(")).to_equal(false)

    it "tracks bootstrap function-local definitions":
        # @req REQ-SSPEC-UNIT
        step("tracks bootstrap function-local definitions")
        val source = mir_to_llvm_core_source()

        expect(source).to_contain("val alloca_rewritten = ssa_alloca_transform_blocks(fn_.blocks, fn_.locals, fn_.entry_block)")
        expect(source).to_contain("if alloca_rewritten.applied:")
        expect(source).to_contain("the normal and SIMPLE_BOOTSTRAP paths; ssa_var_transform_blocks remains")
        expect(source.contains("self.block_defined_locals = {{}}")).to_equal(false)

    it "links bootstrap LLVM with runtime argv and non-pie objects":
        # @req REQ-SSPEC-UNIT
        step("links bootstrap LLVM with runtime argv and non-pie objects")
        val source = mir_to_llvm_core_source()
        val driver = driver_bootstrap_source()
        val linker = linker_native_source()
        val tools = llvm_backend_tools_source()

        expect(source).to_contain("var call_func_name = if bare_name_for_call == \"get_args\" or bare_name_for_call == \"get_cli_args\" or bare_name_for_call == \"sys_get_args\": \"@rt_get_args\"")
        expect(source).to_contain("elif bare_func_name == \"rt_get_args\":")
        expect(driver).to_contain("pie: false")
        expect(linker).to_contain("args.push(\"-no-pie\")")
        expect(tools).to_contain("var args: [text] = [\"--filetype=obj\", \"--relocation-model=pic\",")
        expect(tools).to_contain("\"--function-sections\", \"--data-sections\"]")
        expect(tools).to_contain("if llvm_llc_error_diagnostic(llc_code, llc_out, llc_err, llc, compile_input_path) != \"\":")

    it "remaps env_get to rt_env_get and keeps runtime declaration consistent":
        # @req REQ-SSPEC-UNIT
        step("remaps env_get to rt_env_get and keeps runtime declaration consistent")
        val source = mir_to_llvm_core_source()

        expect(source).to_contain("elif bare_name_for_call == \"env_get\": \"@rt_env_get\"")
        expect(source).to_contain("elif bare_name_for_call == \"rt_env_get\" and args.len() == 1: \"@rt_env_get_value\"")
        expect(source.contains("minimal Stage2 CLI entry")).to_equal(false)
        expect(source.contains("simple-bootstrap 1.0.0-beta")).to_equal(false)
