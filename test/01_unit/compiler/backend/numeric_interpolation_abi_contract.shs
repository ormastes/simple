#!/bin/sh
set -eu

expr=src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl
bridge=src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl
print_lowering=src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl
stmts=src/compiler/50.mir/mir_lowering_stmts.spl
llvm=src/compiler/70.backend/backend/_MirToLlvm/asm_constraints_helpers.spl
spec=test/01_unit/compiler/backend/numeric_interpolation_abi_spec.spl
probe=test/fixtures/compiler/native_numeric_interpolation_abi_probe.spl
bug=doc/08_tracking/bug/stage3_numeric_interpolation_slot_corruption_2026-08-13.md

# Scalar renderers retain their tagged i64 ABI. They must not create an
# Opaque(str) temporary, because only rt_interp_cstr owns the ptr conversion.
grep -F 'MirSignature(params: [render_param_type], return_type: MirType.i64(), is_variadic: false)' "$expr" >/dev/null
grep -F 'val num_res = b_num.emit_call(num_op, [render_src], MirType.i64())' "$expr" >/dev/null
! grep -F 'val num_res = b_num.emit_call(num_op, [render_src], MirType(kind: MirTypeKind.Opaque("str")))' "$expr" >/dev/null
grep -F 'if self.is_tagged_text_local(local.id):' "$expr" >/dev/null
grep -F 'self.mark_tagged_text_local(num_local.id)' "$expr" >/dev/null
grep -F 'self.is_runtime_value_local(local.id) or self.is_tagged_text_local(local.id) or self.runtime_array_locals.contains(local.id)' "$expr" >/dev/null
grep -F 'self.mark_tagged_text_local(local.id)' "$stmts" >/dev/null
grep -F 'self.tagged_text_locals = self.tagged_text_locals.remove(local.id)' "$stmts" >/dev/null
grep -F 'str(count())' "$spec" >/dev/null
grep -F '"n=" + rendered + ";again=" + rendered' "$spec" >/dev/null
grep -F 'str(str(count()))' "$spec" >/dev/null
grep -F 'replacement = rendered' "$spec" >/dev/null
grep -F 'rendered.len() == 2 and rendered.starts_with("4")' "$spec" >/dev/null
grep -F 'val values: [text] = [rendered]' "$spec" >/dev/null
grep -F 'val named: Dict<text, text> = {"count": rendered}' "$spec" >/dev/null
grep -F 'tagged_text_identity(str(count()))' "$spec" >/dev/null
grep -F 'tagged_text_identity("plain")' "$spec" >/dev/null
grep -F 'tagged_text_consumer(str(count()))' "$spec" >/dev/null

# Print must treat a tagged scalar renderer result as text before its I64 ABI
# type is classified. The existing rt_interp_cstr bridge remains the sole
# tagged-handle-to-char* conversion at the print boundary.
grep -F 'val arg_is_semantic_text = self.local_is_str(arg_local)' "$print_lowering" >/dev/null
grep -F 'if not arg_is_semantic_text:' "$print_lowering" >/dev/null
grep -F 'MirConstValue.Str("rt_interp_cstr")' "$print_lowering" >/dev/null
grep -F 'print(str(value))' "$probe" >/dev/null

# A direct user `text` parameter has pointer/text ABI. A renderer result is
# still I64 in MIR, so it must be unwrapped by rt_interp_cstr before that ABI;
# the bridge region must not ask generic LLVM coercion for an I64->ptr cast.
grep -F 'me bridge_tagged_text_direct_arg(arg_local: LocalId, declared_param_type: HirType) -> LocalId:' "$print_lowering" >/dev/null
grep -F 'if self.is_tagged_text_local(arg_local.id):' "$print_lowering" >/dev/null
grep -F 'val cstr_res = b_cstr.emit_call(cstr_op, [mir_operand_copy(arg_local)], self.bootstrap_text_type())' "$print_lowering" >/dev/null
grep -F 'arg_local = self.bridge_tagged_text_direct_arg(arg_local, declared_param_type)' "$print_lowering" >/dev/null
bridge_region=$(sed -n '/me bridge_tagged_text_direct_arg/,/me lower_call/p' "$print_lowering")
printf '%s\n' "$bridge_region" | grep -F 'rt_interp_cstr' >/dev/null
if printf '%s\n' "$bridge_region" | grep -F 'emit_cast' >/dev/null; then
    exit 1
fi
if printf '%s\n' "$bridge_region" | grep -F 'inttoptr' >/dev/null; then
    exit 1
fi

grep -F 'MirSignature(params: [MirType.i64()], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)' "$bridge" >/dev/null
grep -F 'self.remember_function_return_type("rt_raw_i64_to_string", "i64")' "$llvm" >/dev/null
grep -F 'self.remember_function_return_type("rt_raw_u64_to_string", "i64")' "$llvm" >/dev/null
grep -F 'self.remember_function_return_type("rt_raw_bool_to_string", "i64")' "$llvm" >/dev/null
grep -F 'self.remember_function_return_type("rt_raw_f64_to_string", "i64")' "$llvm" >/dev/null
grep -F 'self.remember_function_param_types("rt_interp_cstr", ["i64"])' "$llvm" >/dev/null
grep -F 'self.remember_function_return_type("rt_interp_cstr", "ptr")' "$llvm" >/dev/null
grep -F 'self.builder.emit("declare i64 @rt_raw_i64_to_string(i64)")' "$llvm" >/dev/null
grep -F 'self.builder.emit("declare i64 @rt_raw_u64_to_string(i64)")' "$llvm" >/dev/null
grep -F 'self.builder.emit("declare i64 @rt_raw_bool_to_string(i64)")' "$llvm" >/dev/null
grep -F 'self.builder.emit("declare i64 @rt_raw_f64_to_string(double)")' "$llvm" >/dev/null

grep -F 'val minimum: i64 = -9223372036854775807 - 1' "$probe" >/dev/null
grep -F 'heap_registry={heap_registry}' "$probe" >/dev/null
grep -F 'str(str(value))' "$probe" >/dev/null
grep -F 'replacement = rendered' "$probe" >/dev/null
grep -F 'rendered.len() == 6 and rendered.starts_with("807")' "$probe" >/dev/null
grep -F 'val values: [text] = [rendered]' "$probe" >/dev/null
grep -F 'val named: Dict<text, text> = {"count": rendered}' "$probe" >/dev/null
grep -F 'tagged_text_identity(str(value))' "$probe" >/dev/null
grep -F 'tagged_text_identity("plain")' "$probe" >/dev/null
grep -F 'tagged_text_consumer(str(value))' "$probe" >/dev/null
grep -F 'print_tagged_text(heap_registry) != 0' "$probe" >/dev/null
grep -F 'parser_init_with_path' "$bug" >/dev/null
grep -F 'ast_reset' "$bug" >/dev/null
