# @feature mcdc_hal_runtime_hardening
# @req REQ-009 REQ-010

use std.spec.*
use std.nogc_sync_mut.io_runtime.{file_read}

describe "@rt(hal) call binding lowering contract":
    it "uses a closed O(1) operation table and no runtime lookup":
        val source = file_read(
            "src/compiler/00.common/hal/rt_hal_static_binding.spl")
        expect(source).to_contain(
            "operation == \"io.clock.monotonic_nanos.v1\"")
        expect(source).to_contain("hal_clock_monotonic_nanos_v1")
        expect(source).to_contain("rt_time_now_nanos")
        expect(source).to_contain("rt_hal_sealed_invoke_clock_mode_v2")
        expect(source).to_contain("io.environment.get.v1")
        expect(source).to_contain("bounded-text result ABI")
        expect(source.contains("rt_env_get(\"")).to_be(false)
        expect(source.contains("Dict<")).to_be(false)

    it "wires binding validation into the existing HIR contract pass":
        val source = file_read(
            "src/compiler/80.driver/driver_hir_pipeline_passes.spl")
        expect(source).to_contain("rt_hal_static_binding_v1(operation)")
        expect(source).to_contain(
            "rt_hal_binding_signature_diagnostic_v1")
        expect(source).to_contain("not binding.compare_supported")
