use std.spec
use compiler.backend.linker.msvc.{is_msvc_linker_candidate}

describe "MSVC linker candidate validation":
    it "rejects Unix hard-link tools exposed as link.exe":
        expect(is_msvc_linker_candidate("C:/dev/tool/Git/usr/bin/link.exe")).to_be(false)
        expect(is_msvc_linker_candidate("C:\\msys64\\mingw64\\bin\\link.exe")).to_be(false)

    it "accepts MSVC and LLVM-compatible linker paths":
        expect(is_msvc_linker_candidate("C:/VS/VC/Tools/MSVC/14.44/bin/Hostx64/x64/link.exe")).to_be(true)
        expect(is_msvc_linker_candidate("C:/LLVM/bin/lld-link.exe")).to_be(true)
