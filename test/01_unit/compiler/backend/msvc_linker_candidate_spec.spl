use std.spec
use compiler.backend.linker.msvc.{is_lld_link_candidate, LLD_LINK_INSTALL_HINT}

describe "Windows COFF linker candidate validation":
    it "rejects every link.exe (Git/MSYS coreutils and MSVC alike)":
        expect(is_lld_link_candidate("C:/dev/tool/Git/usr/bin/link.exe")).to_be(false)
        expect(is_lld_link_candidate("C:\\msys64\\mingw64\\bin\\link.exe")).to_be(false)
        expect(is_lld_link_candidate("C:/VS/VC/Tools/MSVC/14.44/bin/Hostx64/x64/link.exe")).to_be(false)

    it "accepts lld-link only":
        expect(is_lld_link_candidate("C:/LLVM/bin/lld-link.exe")).to_be(true)
        expect(is_lld_link_candidate("C:\\LLVM\\bin\\LLD-LINK.EXE")).to_be(true)

    it "names the install command when lld-link is missing":
        expect(LLD_LINK_INSTALL_HINT.contains("scripts/setup/bootstrap-prereqs.shs install")).to_be(true)
