use std.spec
use compiler.backend.linker.msvc.{is_lld_link_candidate, LLD_LINK_INSTALL_HINT, MsvcConfig}

describe "Windows COFF linker candidate validation":
    it "rejects every link.exe (Git/MSYS coreutils and MSVC alike)":
        expect(is_lld_link_candidate("C:/dev/tool/Git/usr/bin/link.exe")).to_be(false)
        expect(is_lld_link_candidate("C:\\msys64\\mingw64\\bin\\link.exe")).to_be(false)
        expect(is_lld_link_candidate("C:/VS/VC/Tools/MSVC/14.44/bin/Hostx64/x64/link.exe")).to_be(false)

    it "accepts lld-link only":
        expect(is_lld_link_candidate("C:/LLVM/bin/lld-link.exe")).to_be(true)
        expect(is_lld_link_candidate("C:\\LLVM\\bin\\LLD-LINK.EXE")).to_be(true)

    it "names the install command when lld-link is missing":
        expect(LLD_LINK_INSTALL_HINT.contains("scripts/setup/bootstrap-prereqs.shs install")).to_be(true)

    it "links the hosted WinHTTP provider through the default MSVC arguments":
        val config = MsvcConfig.default()
        expect(config.libs.contains("winhttp.lib")).to_be(true)
        expect(config.build_args("http-probe.exe", ["http-probe.obj"]).contains("winhttp.lib")).to_be(true)

    it "reserves a 64 MiB stack by default and defers to an explicit /STACK or -STACK":
        val config = MsvcConfig.default()
        expect(config.build_args("a.exe", ["a.obj"]).contains("/STACK:67108864")).to_be(true)
        var custom = MsvcConfig.default()
        for override_flag in ["/STACK:8388608", "/stack:8388608", "-STACK:8388608", "-stack:8388608", "/StAcK:16777216"]:
            custom.extra_args = [override_flag]
            val args = custom.build_args("a.exe", ["a.obj"])
            expect(args.contains(override_flag)).to_be(true)
            expect(args.contains("/STACK:67108864")).to_be(false)
        custom.extra_args = ["/OPT:NOREF", "/STACKUSAGE"]
        val unrelated_args = custom.build_args("a.exe", ["a.obj"])
        expect(unrelated_args.contains("/STACK:67108864")).to_be(true)
