#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
normalizer=$root/src/compiler/70.backend/backend/aot_target_normalization.spl
provider=$root/src/compiler/70.backend/backend/mir_target_context_provider.spl
adapter=$root/src/compiler/70.backend/backend_plugin/builtin_adapter.spl

test "$(grep -c '^use ' "$normalizer")" = 0
grep -F 'use compiler.backend.aot_target_normalization.{backend_aot_simpleos_target_triple, backend_normalize_requested_aot_target}' "$provider" >/dev/null
grep -F 'use compiler.backend.aot_target_normalization.{backend_normalize_requested_aot_target}' "$adapter" >/dev/null
test "$(grep -F 'Some(self.cranelift_target_triple()),' "$adapter" | wc -l | tr -d ' ')" = 2
if grep -F 'Some(self.target_context.llvm_config.triple.to_text())' "$adapter" >/dev/null; then
    echo 'Cranelift path bypasses SimpleOS target normalization' >&2
    exit 1
fi
grep -A1 -F '"x86_64-unknown-simpleos-elf":' "$normalizer" | grep -F '"x86_64-unknown-none-elf"' >/dev/null
grep -A1 -F '"aarch64-unknown-simpleos-elf":' "$normalizer" | grep -F '"aarch64-unknown-none-elf"' >/dev/null
grep -A1 -F '"riscv64gc-unknown-simpleos-elf":' "$normalizer" | grep -F '"riscv64gc-unknown-none-elf"' >/dev/null

echo 'PASS SimpleOS Cranelift target normalization source contract'
