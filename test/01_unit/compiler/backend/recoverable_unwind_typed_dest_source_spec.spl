# @req: REQ-COMP-RECOVERABLE-UNWIND-TYPED-DEST-001
"""Source contract for typed recoverable-call destinations in native backends."""

use std.spec.*
use std.io_runtime.{read_file}

val LLVM = "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
val X86 = "src/compiler/70.backend/backend/native/isel_x86_64.spl"
val A64 = "src/compiler/70.backend/backend/native/isel_aarch64.spl"
val RV64 = "src/compiler/70.backend/backend/native/isel_riscv64.spl"

fn source_has(path: text, needle: text) -> bool:
    read_file(path).contains(needle)

describe "recoverable calls keep normal and typed unwind results distinct":
    it "textual LLVM stores payload and type tag into dedicated unwind destinations":
        step("Inspect the textual LLVM typed-catch destination contract")
        assert_true(source_has(LLVM, "if unwind_payload_dest.?"))
        assert_true(source_has(LLVM, "if unwind_type_tag_dest.?"))
        assert_true(source_has(LLVM, "call i64 @rt_exception_caught_type_tag()"))

    it "each supported native selector consumes both dedicated destinations":
        step("Inspect x86_64, AArch64, and RV64 typed-catch destination contracts")
        for path in [X86, A64, RV64]:
            assert_true(source_has(path, "unwind_payload_dest, unwind_type_tag_dest"))
            assert_true(source_has(path, "match unwind_payload_dest:"))
            assert_true(source_has(path, "exc.tag."))
            assert_true(source_has(path, "rt_exception_caught_type_tag"))
