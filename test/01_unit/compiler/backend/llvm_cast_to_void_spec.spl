use std.spec.*
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mir.mir_data.*

describe "LLVM cast and bitcast to void/unit":
    it "discards an integer operand cast to Unit without emitting an invalid void conversion":
        val llvm = MirToLlvm.create("test.llvm.cast_to_void", CodegenTarget.X86_64, None)
        llvm.local_types[0] = "i64"
        llvm.defined_locals[0] = true
        llvm.current_function_name = "stmt_match_arm"
        llvm.llvm_cast_impl(LocalId(id: 1), mir_operand_copy(LocalId(id: 0)), MirType.unit())
        val ir = llvm.builder.build()
        expect(llvm.codegen_errors.len()).to_equal(0)
        expect(llvm.local_types[1]).to_equal("void")
        expect(ir.contains("add void")).to_equal(false)
        expect(ir.contains("unsupported LLVM value conversion")).to_equal(false)

    it "discards a pointer operand bitcast to Unit without emitting an invalid void conversion":
        val llvm = MirToLlvm.create("test.llvm.bitcast_to_void", CodegenTarget.X86_64, None)
        llvm.local_types[0] = "ptr"
        llvm.ptr_locals[0] = true
        llvm.defined_locals[0] = true
        llvm.current_function_name = "stmt_match_bitcast"
        llvm.llvm_bitcast_impl(LocalId(id: 1), mir_operand_copy(LocalId(id: 0)), MirType.unit())
        val ir = llvm.builder.build()
        expect(llvm.codegen_errors.len()).to_equal(0)
        expect(llvm.local_types[1]).to_equal("void")
        expect(ir.contains("add void")).to_equal(false)
        expect(ir.contains("unsupported LLVM value conversion")).to_equal(false)
