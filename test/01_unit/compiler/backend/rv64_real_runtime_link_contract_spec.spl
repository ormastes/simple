use std.spec.*
use std.io_runtime.{rt_file_read_text}

describe "RV64 native linker runtime ownership":
    it "links architecture-owned probe semantics instead of generated success bodies":
        val linker = rt_file_read_text("src/compiler/70.backend/backend/simpleos_native_linkers.spl") ?? ""

        expect(linker).to_contain("examples/09_embedded/simple_os/arch/riscv64/boot/baremetal_stubs.c")
        expect(linker).to_contain("val runtime_source = if uses_freestanding_runtime:")
        expect(linker.contains("rt_riscv_nvfs_probe(void){return 1;}")).to_equal(false)
        expect(linker.contains("rt_riscv_smf_cli_probe(void){return 1;}")).to_equal(false)
        expect(linker.contains("rt_riscv_smf_cli_load(void){return 1;}")).to_equal(false)
        expect(linker.contains("rt_riscv_smf_gui_probe(void){return 1;}")).to_equal(false)
        expect(linker.contains("rt_riscv_native_gui_process_render(void){return 1;}")).to_equal(false)
        expect(linker.contains("TODO(rv64-real-exit-facade)")).to_equal(false)

    it "keeps real storage and SMF checks in the selected RV64 runtime":
        val runtime = rt_file_read_text("examples/09_embedded/simple_os/arch/riscv64/boot/baremetal_runtime_services.inc.c") ?? ""
        val common = rt_file_read_text("examples/09_embedded/simple_os/arch/common/riscv_common.h") ?? ""

        expect(common).to_contain("Fat32Probe fat")
        expect(common).to_contain("fat32_probe_bpb(&fat)")
        expect(runtime).to_contain("riscv_smf_probe_file")
        expect(runtime).to_contain("riscv_load_smf_process")
