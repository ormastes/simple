# @cover src/compiler/70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl
use compiler.backend.backend._MirToLlvm.aggregate_intrinsics.{llvm_phi_incoming_text}

describe "LLVM textual N-way PHI emission":
    it "retains one incoming arm for every predecessor":
        val incoming = llvm_phi_incoming_text(["%l10", "%l11", "%l12"], [2, 5, 8])
        expect(incoming).to_equal("[ %l10, %bb2 ], [ %l11, %bb5 ], [ %l12, %bb8 ]")

    it "rejects mismatched predecessor and value counts":
        expect(llvm_phi_incoming_text(["%l10", "%l11"], [2])).to_equal("")
