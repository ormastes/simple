# @feature mcdc_hal_runtime_hardening
# @req REQ-009 REQ-010

use std.spec.*
use std.nogc_sync_mut.io_runtime.{file_read}

describe "Critical rt(hal) automatic sealed archive link":
    it "emits a zero-cost marker and auto-selects the sealed archive":
        val lowering = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        val linker = file_read("src/compiler/70.backend/backend/llvm_native_link_stage4_projection.spl")
        val orchestrator = file_read("src/compiler/70.backend/backend/llvm_native_link_orchestrator.spl")
        expect(lowering).to_contain("__simple_rt_hal_sealed_required_v1")
        expect(lowering).to_contain("if rt_hal_fn.has_rt_hal and rt_hal_fn.rt_hal_requires_sealed_archive")
        expect(linker).to_contain("llvm_user_objects_require_sealed_hal")
        expect(linker).to_contain("build/lib/libsimple_hal_provider_sealed_v1.a")
        expect(orchestrator).to_contain("llvm_auto_sealed_hal_archive(user_objects)")
        expect(orchestrator).to_contain("rt_hal_sealed_prepare_v1")
