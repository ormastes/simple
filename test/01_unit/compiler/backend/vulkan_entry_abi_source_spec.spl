# @cover src/compiler/70.backend/backend/vulkan_backend.spl 5%
# @tag: unit, compiler, backend, gpu, vulkan, source-contract

extern fn rt_file_read_text(path: text) -> text

fn vulkan_backend_source() -> text:
    rt_file_read_text("src/compiler/70.backend/backend/vulkan_backend.spl") ?? ""

describe "Vulkan compute entry ABI source contract":
    it "rejects parameters and non-unit returns before emission":
        val source = vulkan_backend_source()

        expect(source).to_contain("if func.signature.params.len() != 0 or func.signature.is_variadic:")
        expect(source).to_contain("Vulkan compute entry parameters require StorageBuffer interface lowering")
        expect(source).to_contain("if func.signature.return_type.kind != MirTypeKind.Unit:")
        expect(source).to_contain("Vulkan compute entry points must return Unit")
        expect(source).to_contain("if func.is_kernel:")
        expect(source).to_contain("gpu_backend_accepts_kernel(BackendKind.Vulkan, func)")
        expect(source).to_contain("case LocalKind.Arg(_):")
        expect(source).to_contain("Vulkan compute entry argument locals require StorageBuffer interface lowering")

    it "rejects malformed value returns while preserving unit return emission":
        val source = vulkan_backend_source()

        expect(source).to_contain("case Ret(value):")
        expect(source).to_contain("Vulkan compute entry points cannot return a value")
        expect(source).to_contain("builder.emit_return()")
        expect(source).to_contain("if mir_body.arg_count != 0:")
        expect(source).to_contain("MirSignature(params: [], return_type: mir_body.return_ty")
