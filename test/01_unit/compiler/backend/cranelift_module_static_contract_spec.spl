# @req: REQ-CRANELIFT-STATIC-001
# Native fixture and provider-object evidence are required in addition to this
# in-process MIR/backend contract. No source-text assertions or missing-host pass.
use std.spec
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.cranelift_codegen_adapter.{cranelift_static_init_supported}

@inline
fn lower_static_fixture(source: text) -> MirModule:
    val path = "cranelift_module_static_contract.spl"
    val ast = parse_full_frontend(source, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    mir

@inline
fn count_static_stores(module: MirModule) -> i64:
    var stores = 0
    for function in module.functions.values():
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.StoreGlobal(_, _): stores = stores + 1
                    case _: ()
    stores

describe "Cranelift module static initialization contracts":
    it "initializes stored immutable text through a runtime string value":
        step("Lower a public immutable text declaration")
        val mir = lower_static_fixture("pub val LABEL = \"present\"\npub fn label() -> text:\n    LABEL\n")
        var labels = 0
        for static_ in mir.statics.values():
            if static_.name.ends_with("LABEL"):
                labels = labels + 1
                expect(static_.init.?).to_equal(false)
                expect(cranelift_static_init_supported(static_)).to_equal(true)
        expect(labels).to_equal(1)
        step("Require a real initializer store")
        expect(count_static_stores(mir)).to_be_greater_than(0)

    it "accepts runtime aggregate and array handles without constant payloads":
        step("Lower aggregate factory and array initializers")
        val mir = lower_static_fixture("class State:\n    value: i64\nfn make_state() -> State:\n    State(value: 17)\nvar state = make_state()\nvar entries: [i64] = []\n")
        var slots = 0
        for static_ in mir.statics.values():
            if static_.name.ends_with("state") or static_.name.ends_with("entries"):
                slots = slots + 1
                expect(static_.init.?).to_equal(false)
                expect(cranelift_static_init_supported(static_)).to_equal(true)
        expect(slots).to_equal(2)
        expect(count_static_stores(mir)).to_be_greater_than(1)

    it "rejects imported initialization and nonempty aggregate payloads":
        step("Lower concrete scalar and aggregate storage declarations")
        val mir = lower_static_fixture("pub val COUNT: i64 = 29\nclass State:\n    value: i64\nfn make_state() -> State:\n    State(value: 17)\nvar state = make_state()\n")
        var checked = 0
        for static_ in mir.statics.values():
            if static_.name.ends_with("COUNT"):
                var imported = static_
                imported.is_external = true
                imported.init = Some(MirConstant(symbol: static_.symbol, name: static_.name,
                    type_: static_.type_, value: MirConstValue.Zero))
                expect(cranelift_static_init_supported(imported)).to_equal(false)
                imported.init = nil
                expect(cranelift_static_init_supported(imported)).to_equal(true)
                checked = checked + 1
            elif static_.name.ends_with("state"):
                var aggregate = static_
                aggregate.init = Some(MirConstant(symbol: static_.symbol, name: static_.name,
                    type_: static_.type_, value: MirConstValue.Zero))
                expect(cranelift_static_init_supported(aggregate)).to_equal(false)
                checked = checked + 1
        expect(checked).to_equal(2)
