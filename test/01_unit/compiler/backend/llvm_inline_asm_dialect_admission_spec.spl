# @cover src/compiler/70.backend/backend/llvm_diagnostic_admission.spl
use std.spec.*
use compiler.backend.llvm_diagnostic_admission.{llvm_llc_error_diagnostic}

fn diagnostic_from(stdout: text, stderr: text) -> text:
    llvm_llc_error_diagnostic(0, stdout, stderr, "/qualified/bin/llc-23", "/private/input path.ll")

describe "LLVM diagnostic grammar and source echo admission":
    it "rejects nonzero status independently of output":
        expect(llvm_llc_error_diagnostic(7, "", "", "llc", "input.ll")).to_equal("llc exited with status 7")

    it "recognizes inline locations and optional actual tool prefixes":
        val inline_error = "<inline asm>:1:1: error: invalid operand"
        expect(diagnostic_from(inline_error, "")).to_equal(inline_error)
        expect(diagnostic_from("", inline_error)).to_equal(inline_error)
        val tool_error = "llc-23: <inline asm>:1:1: error: invalid operand"
        expect(diagnostic_from("", tool_error)).to_equal(tool_error)
        val full_tool = "/qualified/bin/llc-23: /private/input path.ll:22:8: error: invalid input"
        expect(diagnostic_from("", full_tool)).to_equal(full_tool)

    it "recognizes filename-only and line-only locations without assuming a column":
        val filename = "/private/input path.ll: error: invalid input"
        val line = "/private/input path.ll:2: error: invalid input"
        expect(diagnostic_from("", filename)).to_equal(filename)
        expect(diagnostic_from("", line)).to_equal(line)

    it "preserves windows drive and filename colons in its exact input context":
        val diagnostic = r"C:\LLVM\llc.exe: C:\source path\input:part.ll:12:4: error: invalid input"
        expect(llvm_llc_error_diagnostic(0, "", diagnostic, r"C:\LLVM\llc.exe", r"C:\source path\input:part.ll")).to_equal(diagnostic)

    it "rejects unlocated LLVM errors and exact producing-tool errors":
        expect(diagnostic_from("", "error: invalid operand")).to_equal("error: invalid operand")
        expect(diagnostic_from("", "llc-23: error: invalid input")).to_equal("llc-23: error: invalid input")
        expect(diagnostic_from("", "LLVM ERROR: invalid constraint")).to_equal("LLVM ERROR: invalid constraint")

    it "accepts warning text and unindented raw assembler source echoes":
        val source_echo = ".warning \"example: error: text\""
        expect(diagnostic_from("", source_echo)).to_equal("")
        expect(diagnostic_from("", "<inline asm>:1:1: warning: example: error: text\n" + source_echo + "\n^\n")).to_equal("")
        expect(diagnostic_from("", "llc-23: <inline asm>:1:1: warning: quoted message\nerror: .warning \"message\"\n^\n")).to_equal("")
        expect(diagnostic_from("", "warning: error: quoted message\nnote: error: quoted message\nremark: error: quoted message")).to_equal("")
        expect(diagnostic_from("generated object", "")).to_equal("")

    it "does not scan malformed or unrelated location text for severity words":
        expect(diagnostic_from("", "example: error: text")).to_equal("")
        expect(diagnostic_from("", "<inline asm>:x:1: error: source echo")).to_equal("")
        expect(diagnostic_from("", "<inline asm>:1:x: error: source echo")).to_equal("")
        expect(diagnostic_from("", "unrelated:1:1: error: text")).to_equal("")

    it "rejects the next genuine diagnostic after warning source and caret lines":
        val error_line = "llc-23: <inline asm>:2:1: error: invalid operand"
        val warning = "llc-23: <inline asm>:1:1: warning: example: error: text\n.warning \"example: error: text\"\n^\n"
        expect(diagnostic_from("", warning + error_line)).to_equal(error_line)

    it "accepts wrapped located diagnostics with suppressed inner severity":
        for kind in ["warning", "note", "remark"]:
            val wrapped = kind + ": <inline asm>:1:1: example: error: text\nerror: .warning \"example: error: text\"\n^\n"
            expect(diagnostic_from("", wrapped)).to_equal("")
            val later_error = "error: <inline asm>:2:1: invalid operand"
            expect(diagnostic_from("", wrapped + later_error)).to_equal(later_error)

    it "accepts both source printer modes with the producing tool prefix":
        val with_inner = "llc-23: <inline asm>:1:1: warning: example: error: text\nerror: .warning \"example: error: text\"\n^\n"
        val without_inner = "llc-23: warning: <inline asm>:1:1: example: error: text\nerror: .warning \"example: error: text\"\n^\n"
        expect(diagnostic_from("", with_inner)).to_equal("")
        expect(diagnostic_from("", without_inner)).to_equal("")

    it "consumes a blank source line and still sees the next actual error":
        val error_line = "error: invalid operand"
        val warning = "warning: <inline asm>:1:1: example: error: text\n\n^\n"
        expect(diagnostic_from("", warning)).to_equal("")
        expect(diagnostic_from("", warning + error_line)).to_equal(error_line)

    it "consumes non-ASCII source without requiring a caret":
        val error_line = "error: invalid operand"
        val warning = "warning: <inline asm>:1:1: message\nerror: .warning \"é: error: text\"\n"
        expect(diagnostic_from("", warning)).to_equal("")
        expect(diagnostic_from("", warning + error_line)).to_equal(error_line)

    it "never skips the next actual error for a diagnostic without a column":
        val error_line = "error: invalid operand"
        for warning in ["warning: message", "warning: /private/input path.ll: message", "warning: <inline asm>:1: message", "<inline asm>:1: warning: message"]:
            expect(diagnostic_from("", warning + "\n" + error_line)).to_equal(error_line)

    it "requires the exact numeric location terminator before consuming source":
        val error_line = "error: invalid operand"
        expect(diagnostic_from("", "warning: <inline asm>:1:1:message\n" + error_line)).to_equal(error_line)
        expect(diagnostic_from("", "warning: <inline asm>:1:x:message\n" + error_line)).to_equal(error_line)
