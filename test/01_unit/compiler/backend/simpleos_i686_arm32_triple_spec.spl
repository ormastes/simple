# SimpleOS 32-bit user target normalization. Runtime admission additionally
# requires matching sysroot inputs and execution evidence for each tool.
use std.spec.*
use compiler.backend.aot_target_normalization.{
    backend_aot_simpleos_target_triple,
    backend_aot_simpleos_32bit_user_target_error
}

describe "SimpleOS i686/arm32 target triples":
    it "accepts i686-unknown-simpleos":
        expect(backend_aot_simpleos_target_triple("i686-unknown-simpleos")).to_equal("i686-unknown-none-elf")
        expect(backend_aot_simpleos_32bit_user_target_error("i686-unknown-simpleos")).to_equal("")

    it "accepts armv7-unknown-simpleos":
        expect(backend_aot_simpleos_target_triple("armv7-unknown-simpleos")).to_equal("armv7a-none-eabi")
        expect(backend_aot_simpleos_32bit_user_target_error("armv7-unknown-simpleos")).to_equal("")

    it "accepts riscv32imac without changing the configured ISA":
        expect(backend_aot_simpleos_target_triple("riscv32imac-unknown-simpleos")).to_equal("riscv32imac-unknown-none-elf")
        expect(backend_aot_simpleos_32bit_user_target_error("riscv32imac-unknown-simpleos")).to_equal("")

    it "rejects unmodeled 32-bit SimpleOS spellings":
        expect(backend_aot_simpleos_target_triple("riscv32imaf-unknown-simpleos")).to_equal("")
        expect(backend_aot_simpleos_32bit_user_target_error("riscv32imaf-unknown-simpleos")).to_contain("unsupported triple spelling")
