# @tag:in-development
# Assert-only spec: SimpleOS i686 / arm32 user triples are not supported yet.
# Expected to FAIL until the 32-bit userland lands.
# TODO(simpleos-i686-arm32-triple): see doc/08_tracking/bug/simpleos_no_i686_arm32_target_triple_2026-11-20.md
use std.spec.*
use compiler.backend.aot_target_normalization.{
    backend_aot_simpleos_target_triple,
    backend_aot_simpleos_32bit_user_target_error
}

describe "SimpleOS i686/arm32 target triples":
    it "accepts i686-unknown-simpleos":
        expect(backend_aot_simpleos_target_triple("i686-unknown-simpleos")).to_not_equal("")
        expect(backend_aot_simpleos_32bit_user_target_error("i686-unknown-simpleos")).to_equal("")

    it "accepts armv7-unknown-simpleos":
        expect(backend_aot_simpleos_target_triple("armv7-unknown-simpleos")).to_not_equal("")
        expect(backend_aot_simpleos_32bit_user_target_error("armv7-unknown-simpleos")).to_equal("")
