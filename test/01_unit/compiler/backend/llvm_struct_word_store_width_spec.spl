use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}

# These tests exercise the actual conversion owner, including the stale map
# entry that motivated the verbatim path. Native execution remains required.
describe "LLVM verbatim struct field word widths":
    it "sign extends narrow SSA integers into 64-bit physical words without pointer retagging":
        for width in ["i8", "i16", "i32"]:
            val llvm = MirToLlvm.create("test.struct.word64", CodegenTarget.X86_64, nil)
            llvm.value_types["%input"] = "ptr"
            val stored = llvm.store_field_bits_verbatim("%input", width, "i64")
            llvm.builder.emit_store("i64", stored, "%field")
            val ir = llvm.builder.build()
            expect(stored == "%input").to_equal(false)
            expect(ir).to_contain("sext {width} %input to i64")
            expect(ir).to_contain("store i64 {stored}, ptr %field")
            expect(ir.contains("ptrtoint")).to_equal(false)

    it "truncates a 64-bit SSA integer into a 32-bit physical word":
        val llvm = MirToLlvm.create("test.struct.word32", CodegenTarget.X86, nil)
        llvm.value_types["%input"] = "ptr"
        val stored = llvm.store_field_bits_verbatim("%input", "i64", "i32")
        llvm.builder.emit_store("i32", stored, "%field")
        val ir = llvm.builder.build()
        expect(stored == "%input").to_equal(false)
        expect(ir).to_contain("trunc i64 %input to i32")
        expect(ir).to_contain("store i32 {stored}, ptr %field")
        expect(ir.contains("ptrtoint")).to_equal(false)

    it "keeps equal-width native SSA operands unchanged even with a stale pointer tag":
        val llvm = MirToLlvm.create("test.struct.equal", CodegenTarget.X86_64, nil)
        llvm.value_types["%input"] = "ptr"
        expect(llvm.store_field_bits_verbatim("%input", "i64", "i64")).to_equal("%input")
        expect(llvm.builder.build()).to_equal("")

    it "retains the existing signed widening convention for negative field values":
        val llvm = MirToLlvm.create("test.struct.negative", CodegenTarget.X86_64, nil)
        val stored = llvm.store_field_bits_verbatim("-1", "i8", "i64")
        expect(stored == "-1").to_equal(false)
        expect(llvm.builder.build()).to_contain("sext i8 -1 to i64")

    it "retains pointer bit conversion into native word storage":
        val llvm = MirToLlvm.create("test.struct.pointer", CodegenTarget.X86_64, nil)
        val stored = llvm.store_field_bits_verbatim("%input", "ptr", "i64")
        expect(stored == "%input").to_equal(false)
        expect(llvm.builder.build()).to_contain("ptrtoint ptr %input to i64")
