# @req: REQ-CRANELIFT-VERIFIER-TYPES-001
# Regression contracts for the four Cranelift AOT "Verifier errors:" clusters
# seen in the phase-4 tool build (bug p4p2_cranelift_verifier_types_2026-10-20):
# char cast reduce width, imported-call float ABI, numeric to_i64 receivers,
# and untyped-parameter functions that return a value.
use std.spec
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.cranelift_codegen_adapter.{cl_cast_narrow_int_type, cl_cast_int_width_bytes, cl_fallback_abi_type}

@inline
fn lower_verifier_fixture(source: text) -> MirModule:
    val path = "cranelift_verifier_type_contract.spl"
    val ast = parse_full_frontend(source, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    mir

@inline
fn call_names_in(module: MirModule, fn_suffix: text) -> [text]:
    var names: [text] = []
    for function in module.functions.values():
        if function.name.ends_with(fn_suffix):
            for block in function.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case MirInstKind.Call(_, func_op, _):
                            match func_op.kind:
                                case MirOperandKind.Const(value, _):
                                    match value:
                                        case MirConstValue.Str(name): names.push(name)
                                        case _: ()
                                case _: ()
                        case _: ()
    names

describe "Cranelift verifier type contracts":
    it "reduces a char cast to a 32-bit scalar, never ireduce.i64":
        step("Char is a 32-bit Unicode scalar; 64-bit targets need no reduce")
        expect(cl_cast_narrow_int_type(MirType(kind: MirTypeKind.Char))).to_equal(3)
        expect(cl_cast_int_width_bytes(MirType(kind: MirTypeKind.Char))).to_equal(4)
        expect(cl_cast_narrow_int_type(MirType(kind: MirTypeKind.U8))).to_equal(1)
        expect(cl_cast_narrow_int_type(MirType(kind: MirTypeKind.I16))).to_equal(2)
        expect(cl_cast_narrow_int_type(MirType.i64())).to_equal(0)
        expect(cl_cast_narrow_int_type(MirType(kind: MirTypeKind.Bool))).to_equal(0)

    it "keeps float register classes on undeclared imported calls":
        step("f64/f32 operands and results are not declared as i64")
        expect(cl_fallback_abi_type(MirType.f64())).to_equal(6)
        expect(cl_fallback_abi_type(MirType(kind: MirTypeKind.F32))).to_equal(5)
        expect(cl_fallback_abi_type(MirType.i64())).to_equal(4)
        expect(cl_fallback_abi_type(MirType(kind: MirTypeKind.Bool))).to_equal(4)

    it "lowers f64.to_i64 as a numeric cast, not the text builtin":
        step("Lower a typed f64 receiver conversion round trip")
        val mir = lower_verifier_fixture("fn whole(x: f64) -> bool:\n    x == x.to_i64().to_f64()\n")
        val names = call_names_in(mir, "whole")
        for name in names:
            expect(name.starts_with("rt_string_")).to_equal(false)
            expect(name == "rt_interp_cstr").to_equal(false)

    it "gives an untyped-parameter function that returns a value a value signature":
        step("Lower an untyped helper with an explicit value return")
        val mir = lower_verifier_fixture("fn fin(crc):\n    return crc ^ 1\n")
        var checked = 0
        for function in mir.functions.values():
            if function.name.ends_with("fin"):
                expect(function.signature.return_type.kind == MirTypeKind.Unit).to_equal(false)
                checked = checked + 1
        expect(checked).to_equal(1)
