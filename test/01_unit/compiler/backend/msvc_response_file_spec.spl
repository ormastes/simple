use std.spec
use compiler.backend.linker.msvc_response_file.{msvc_response_quote, msvc_response_body}

describe "Windows linker response-file argv encoding":
    it "preserves empty arguments and spaces":
        expect(msvc_response_quote("")).to_equal("\"\"")
        expect(msvc_response_quote("C:/Program Files/input.obj")).to_equal("\"C:/Program Files/input.obj\"")

    it "escapes quotes and doubles only the backslashes preceding quotes":
        expect(msvc_response_quote("a\"b")).to_equal("\"a\\\"b\"")
        expect(msvc_response_quote("a\\\"b")).to_equal("\"a\\\\\\\"b\"")
        expect(msvc_response_quote("C:\\plain\\file.obj")).to_equal("\"C:\\plain\\file.obj\"")
        expect(msvc_response_quote("C:\\space dir\\")).to_equal("\"C:\\space dir\\\\\"")

    it "writes ordered argv lines without dropping duplicate inputs":
        expect(msvc_response_body(["one.obj", "two words.obj", "one.obj"])).to_equal("\"one.obj\"\n\"two words.obj\"\n\"one.obj\"\n")

    it "keeps an object list larger than the Windows process command limit":
        var args: [text] = []
        var count = 0
        while count < 2000:
            args.push("C:/object directory/input-{count}.obj")
            count = count + 1
        val body = msvc_response_body(args)
        expect(body.len()).to_be_greater_than(32767)
        expect(body.starts_with("\"C:/object directory/input-0.obj\"\n")).to_be(true)
        expect(body.ends_with("\"C:/object directory/input-1999.obj\"\n")).to_be(true)
