"""VHDL source-fallback expressions preserve Simple's inline else-if syntax."""

use std.spec.*
use compiler.driver.driver_compile_vhdl_expr.{_simple_inline_if_to_vhdl}

describe "VHDL inline else-if lowering":
    it "lowers each branch as one nested conditional expression":
        val result = _simple_inline_if_to_vhdl(
            "if privilege == 0: 8 else if privilege == 1: 9 else: 11",
            "u32",
            ["privilege"],
            ["u32"]
        )
        expect(result.is_err()).to_be(false)
        expect(result.unwrap()).to_equal(
            "to_unsigned(8, 32) when ('1' when privilege = to_unsigned(0, 32) else '0') = '1' else to_unsigned(9, 32) when ('1' when privilege = to_unsigned(1, 32) else '0') = '1' else to_unsigned(11, 32)"
        )
