"""
Regression coverage for llvm_llc_probe diagnostic surfacing in llvm_backend_tools.
Bug: doc/08_tracking/bug/native_build_llc_probe_per_unit_transient_not_found_2026-11-16.md
"""
# @cover src/compiler/70.backend/backend/llvm_backend_tools.spl
# @req REQ-SSPEC-COMPILER

use std.spec.*
use compiler.backend.llvm_backend_tools.{llvm_llc_not_found_message_v1}

extern fn rt_file_read_text(path: text) -> text?

describe "LLVM llc not-found diagnostic surfacing":
    it "preserves base message when no tool probe diagnostic was recorded":
        step("Format llc error with empty probe diagnostic")
        expect(llvm_llc_not_found_message_v1("llc not found", "")).to_equal("llc not found")
        expect(llvm_llc_not_found_message_v1("llc not found", "   \n")).to_equal("llc not found")

    it "appends trimmed transient probe diagnostic when present":
        step("Format llc error with recorded transient probe detail")
        val msg = llvm_llc_not_found_message_v1(
            "llc not found",
            "  transient --version probe failure for /usr/bin/llc (exit 137)  \n")
        expect(msg).to_contain("llc not found")
        expect(msg).to_contain("Tool probe detail: transient --version probe failure for /usr/bin/llc (exit 137)")

    it "surfaces last_tool_probe_diagnostic on all llc missing paths in llvm_backend_tools":
        step("Inspect llvm_backend_tools source wiring")
        val src = rt_file_read_text("src/compiler/70.backend/backend/llvm_backend_tools.spl") ?? ""
        expect(src).to_contain("llvm_llc_not_found_message_v1(")
        expect(src).to_contain("last_tool_probe_diagnostic()")
        expect(src).to_contain("_llvm_resolve_object_tools_v1()")
        expect(src).to_contain("val llc_probe_diag = if llc == \"\": last_tool_probe_diagnostic() else: \"\"")
