# @cover src/compiler/70.backend/backend/common/mir_text_codegen.spl
# @cover src/compiler/70.backend/backend/wasm_codegen_adapter.spl
# @cover src/compiler/70.backend/backend/vhdl_type_mapper.spl
# @cover src/compiler/70.backend/backend/cuda_type_mapper.spl
# @cover src/compiler/70.backend/backend/vulkan_type_mapper.spl

extern fn rt_file_read_text(path: text) -> text

use std.spec.*

fn backend_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "ExceptionToken backend defaults reject instead of guessing":
    it "rejects LandingPad in shared text codegen":
        val source = backend_source(
            "src/compiler/70.backend/backend/common/mir_text_codegen.spl")
        expect(source).to_contain("text codegen cannot lower LandingPad")
        expect(source).to_contain("E-MIR-UNWIND002")

    it "rejects the WebAssembly adapter i32 fallback":
        val source = backend_source(
            "src/compiler/70.backend/backend/wasm_codegen_adapter.spl")
        expect(source).to_contain("WebAssembly adapter cannot map ExceptionToken")

    it "rejects VHDL synthesis and layout defaults":
        val source = backend_source(
            "src/compiler/70.backend/backend/vhdl_type_mapper.spl")
        expect(source).to_contain("VHDL cannot synthesize ExceptionToken")
        expect(source).to_contain("VHDL cannot size ExceptionToken")
        expect(source).to_contain("VHDL cannot align ExceptionToken")

    it "rejects CUDA layout defaults":
        val source = backend_source(
            "src/compiler/70.backend/backend/cuda_type_mapper.spl")
        expect(source).to_contain("CUDA cannot size ExceptionToken")
        expect(source).to_contain("CUDA cannot align ExceptionToken")

    it "rejects Vulkan layout defaults":
        val source = backend_source(
            "src/compiler/70.backend/backend/vulkan_type_mapper.spl")
        expect(source).to_contain("Vulkan cannot size ExceptionToken")
        expect(source).to_contain("Vulkan cannot align ExceptionToken")
