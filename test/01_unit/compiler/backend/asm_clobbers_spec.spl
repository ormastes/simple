"""`clobbers(...)` on raw asm blocks (design A.4, plan 1.5).

`asm volatile clobbers(rax, rcx, memory) {{ rdmsr }}` parses into the
AsmExpr clobber list, lowers to the LLVM constraint string
`~{{rax}},~{{rcx}},~{{memory}}`, and unknown names are E-ASM-CLOBBER.
"""
# @req REQ-HAL-ASM-CLOBBERS
# research: doc/01_research/os/hal/hal_asm_embedding_dual_run_survey_2026-08-28.md ; plan: doc/03_plan/os/hal/asm_to_simple_migration_plan.md ; design: doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md

use std.spec
use std.spec.step
use compiler.common.attributes.{is_known_asm_clobber, vhdl_hardware_metadata_default}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types_expr.*
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*

fn first_asm_clobbers(source: text, fn_name: text) -> [text]:
    """Parse `source` and return the clobber list of the first raw asm block
    in `fn_name` ("<none>" sentinel when no asm statement was found)."""
    val module = parse_and_build_module(source, "asm_clobbers_fixture.spl")
    val f = module.functions[fn_name]
    for stmt in f.body.stmts:
        match stmt.kind:
            case Expr(e):
                match e.kind:
                    case AsmBlock(asm_node):
                        return asm_node.clobbers
                    case _:
                        pass
            case _:
                pass
    ["<none>"]

fn clobber_module(clobbers: [text]) -> MirModule:
    val i64_type = MirType.i64()
    val function = MirFunction(
        symbol: SymbolId(id: 21), name: "clobber_owner",
        signature: MirSignature(params: [], return_type: i64_type, is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: Some("v"), type_: i64_type, kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [
                MirInst(kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Int(0), MirType.i64()), span: nil),
                MirInst(kind: MirInstKind.InlineAsm("rdmsr", true, [], [], clobbers, [], []), span: nil)
            ],
            terminator: MirTerminator.Ret(Some(mir_operand_copy(LocalId(id: 0))))
        )],
        entry_block: BlockId.entry(), span: Span.empty(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false)
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(name: "hal.clobbers.backend", functions: functions, statics: {}, constants: {}, types: {})

describe "clobbers(...) syntax on raw asm blocks (design A.4)":
    it "parses the clobber list of a braced raw block":
        step("parses the clobber list of a braced raw block")
        val source = "fn read_msr_probe():\n    asm volatile clobbers(rax, rcx, memory) {{ rdmsr }}\n"
        val clobbers = first_asm_clobbers(source, "read_msr_probe")
        expect(clobbers.len()).to_equal(3)
        expect(clobbers).to_contain("rax")
        expect(clobbers).to_contain("rcx")
        expect(clobbers).to_contain("memory")

    it "lowers clobbers to the LLVM tilde-brace constraint string":
        step("lowers clobbers to the LLVM tilde-brace constraint string")
        val ir = MirToLlvm.create("hal.clobbers.backend", CodegenTarget.X86_64, nil)
            .translate_module(clobber_module(["rax", "rcx", "memory"]))
        expect(ir).to_contain("~{{rax}},~{{rcx}},~{{memory}}")
        expect(ir).to_contain("call void asm sideeffect \"rdmsr\"")

    it "knows the register and pseudo-register vocabulary (E-ASM-CLOBBER)":
        step("knows the register and pseudo-register vocabulary (E-ASM-CLOBBER)")
        expect(is_known_asm_clobber("rax")).to_be(true)
        expect(is_known_asm_clobber("r11")).to_be(true)
        expect(is_known_asm_clobber("memory")).to_be(true)
        expect(is_known_asm_clobber("cc")).to_be(true)
        expect(is_known_asm_clobber("flags")).to_be(true)
        expect(is_known_asm_clobber("x30")).to_be(true)
        expect(is_known_asm_clobber("t6")).to_be(true)
        expect(is_known_asm_clobber("bogus")).to_be(false)
        expect(is_known_asm_clobber("x99")).to_be(false)
        expect(is_known_asm_clobber("")).to_be(false)
