# @req REQ-SSPEC-UNIT
use std.spec.{describe, it, expect}
use std.spec.step
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.*

fn text_literal_count(source: text, needle: text) -> i64:
    var count = 0
    for line in source.split("\n"):
        if line.contains(needle):
            count = count + 1
    count

fn build_typed_text_literal_module() -> MirModule:
    val text_type = MirType(kind: MirTypeKind.Opaque("str"))
    val raw_bytes_type = MirType.ptr(MirType(kind: MirTypeKind.I8), false)
    val sink_signature = MirSignature(
        params: [text_type], return_type: MirType.unit(), is_variadic: false)
    val raw_sink_signature = MirSignature(
        params: [raw_bytes_type], return_type: MirType.unit(), is_variadic: false)
    val fn_ = MirFunction(
        symbol: SymbolId(id: 301),
        name: "typed_text_literal_sites",
        signature: MirSignature(params: [], return_type: text_type, is_variadic: false),
        locals: [
            MirLocal(id: LocalId(id: 1), name: Some("typed_local"), type_: text_type, kind: LocalKind.Temp, is_ghost: false),
            MirLocal(id: LocalId(id: 2), name: Some("raw_bytes"), type_: raw_bytes_type, kind: LocalKind.Temp, is_ghost: false)
        ],
        blocks: [
            MirBlock(
                id: BlockId.entry(),
                label: Some("entry"),
                instructions: [
                    MirInst(kind: MirInstKind.Const(
                        LocalId(id: 1), MirConstValue.Str("A\0é"), text_type), span: nil),
                    MirInst(kind: MirInstKind.Const(
                        LocalId(id: 2), MirConstValue.Str("raw"), raw_bytes_type), span: nil),
                    MirInst(kind: MirInstKind.Call(
                        nil,
                        MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str("consume_text"),
                            MirType(kind: MirTypeKind.FuncPtr(sink_signature)))),
                        [MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str("B\0é"), text_type))]), span: nil),
                    MirInst(kind: MirInstKind.Call(
                        nil,
                        MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str("consume_raw"),
                            MirType(kind: MirTypeKind.FuncPtr(raw_sink_signature)))),
                        [MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str("raw-call"), raw_bytes_type))]), span: nil)
                ],
                terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("C\0é"), text_type))))
            )
        ],
        entry_block: BlockId.entry(),
        span: Span.empty(),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false)
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[fn_.symbol] = fn_
    MirModule(name: "typed_text_literal_sites", functions: functions, statics: {}, constants: {}, types: {})

describe "LLVM typed text literal boxing":
    it "boxes local, direct argument, and return literals with explicit UTF-8 byte lengths":
        step("lower three Opaque(str) literal sites containing NUL and non-ASCII bytes")
        val output = MirToLlvm.create(
            "test.llvm.typed_text_literal_sites", CodegenTarget.X86_64, nil
        ).translate_module(build_typed_text_literal_module())

        step("box each text literal with its explicit four-byte length")
        expect(text_literal_count(output, "call i64 @rt_string_new_literal")).to_equal(3)
        expect(output).to_contain("call i64 @rt_string_new_literal(ptr")
        expect(output).to_contain("i64 4)")
        expect(output).to_contain("c\"A\\00é\\00\"")
        expect(output).to_contain("c\"B\\00é\\00\"")
        expect(output).to_contain("c\"C\\00é\\00\"")

        step("keep Ptr(I8) raw and leave the function reference as a symbol")
        expect(output).to_contain("c\"raw\\00\"")
        expect(output).to_contain("getelementptr inbounds [4 x i8]")
        expect(output).to_contain("call void @consume_text(ptr")
        expect(output).to_contain("@consume_raw(ptr getelementptr inbounds")
        expect(text_literal_count(output, "call i64 @rt_string_new_literal")).to_equal(3)
