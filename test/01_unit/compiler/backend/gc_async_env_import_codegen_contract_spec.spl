use std.spec
use std.fs.{file_read}

describe "GC-async environment facade native symbol ownership":
    it "uses the module owner instead of emitting an imported alias symbol":
        val source = file_read("src/lib/gc_async_mut/env/variables.spl")
        val owner = file_read("src/lib/gc_async_mut/io/env_ops.spl")
        val facade = file_read("src/lib/gc_async_mut/io/mod_stub.spl")
        expect(source).to_contain("use std.gc_async_mut.io.mod_stub.\{gc_env_get\}")
        expect(source).to_contain("val v = gc_env_get(key)")
        expect(owner).to_contain("fn gc_env_get(key: text) -> text:")
        expect(owner).to_contain("env_get(key)")
        expect(facade).to_contain("env_get, gc_env_get")
