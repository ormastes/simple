use std.spec.*
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef}
use compiler.mir.hwir.riscv_scalar_runtime_alu_pipeline.{
    HwScalarRuntimeAluPipeline, HwScalarRuntimeAluPipelineBinding,
    strict_riscv_scalar_runtime_alu_pipeline}
use compiler.backend.backend.riscv_scalar_runtime_alu_pipeline_to_vhdl.{
    compile_strict_riscv_scalar_runtime_alu_pipeline,
    scalar_runtime_alu_pipeline_driver_closure_diagnostic}

fn pipeline_with_bindings(base: HwScalarRuntimeAluPipeline,
    bindings: [HwScalarRuntimeAluPipelineBinding]) -> HwScalarRuntimeAluPipeline:
    HwScalarRuntimeAluPipeline(node_id: base.node_id, module_name: base.module_name,
        config: base.config, plan: base.plan, descriptor: base.descriptor,
        decoder: base.decoder, uop_skid: base.uop_skid, alu: base.alu,
        completion_skid: base.completion_skid, illegal_provider: base.illegal_provider,
        selector: base.selector,
        fault_owner: base.fault_owner, defaults: base.defaults,
        top_ports: base.top_ports, bindings: bindings)

fn pipeline_with_alu(base: HwScalarRuntimeAluPipeline,
    alu: HwModuleDef) -> HwScalarRuntimeAluPipeline:
    HwScalarRuntimeAluPipeline(node_id: base.node_id, module_name: base.module_name,
        config: base.config, plan: base.plan, descriptor: base.descriptor,
        decoder: base.decoder, uop_skid: base.uop_skid, alu: alu,
        completion_skid: base.completion_skid, illegal_provider: base.illegal_provider,
        selector: base.selector,
        fault_owner: base.fault_owner, defaults: base.defaults,
        top_ports: base.top_ports, bindings: base.bindings)

fn replaced_pipeline_binding(rows: [HwScalarRuntimeAluPipelineBinding], index: i32,
    replacement: HwScalarRuntimeAluPipelineBinding) -> [HwScalarRuntimeAluPipelineBinding]:
    var result: [HwScalarRuntimeAluPipelineBinding] = []
    var current = 0
    for row in rows:
        result.push(if current == index: replacement else: row)
        current = current + 1
    result

fn swapped_pipeline_bindings(rows: [HwScalarRuntimeAluPipelineBinding],
    first: i32, second: i32) -> [HwScalarRuntimeAluPipelineBinding]:
    var result: [HwScalarRuntimeAluPipelineBinding] = []
    var current = 0
    for row in rows:
        if current == first: result.push(rows[second])
        elif current == second: result.push(rows[first])
        else: result.push(row)
        current = current + 1
    result

describe "strict runtime scalar ALU pipeline emission":
    it "closes every typed driver and publishes canonical child hashes":
        val pipeline = strict_riscv_scalar_runtime_alu_pipeline(
            "runtime_alu_pipeline_rv32", CoreConfig.rv32())
        expect(pipeline.is_ok()).to_equal(true)
        if pipeline.is_ok():
            val graph = pipeline.ok().unwrap()
            expect(scalar_runtime_alu_pipeline_driver_closure_diagnostic(graph)).to_equal("")
            val result = compile_strict_riscv_scalar_runtime_alu_pipeline(
                "runtime_alu_pipeline_rv32", CoreConfig.rv32())
            expect(result.is_success()).to_equal(true)
            if result.is_success():
                expect(result.route).to_equal("hwir-gen2-scalar-runtime-alu-pipeline-v2")
                expect(result.hwir_graph_sha256).to_equal(graph.structural_sha256())
                expect(result.vhdl).to_contain("-- simple-hwir child-decoder=")
                expect(result.vhdl).to_contain("-- simple-hwir child-uop-skid=")
                expect(result.vhdl).to_contain("-- simple-hwir child-alu=")
                expect(result.vhdl).to_contain("-- simple-hwir child-completion-skid=")
                expect(result.vhdl).to_contain("-- simple-hwir child-illegal-provider=")
                expect(result.vhdl).to_contain("-- simple-hwir child-selector=")
                expect(result.vhdl).to_contain("-- simple-hwir child-fault-owner=")
                expect(result.vhdl).to_contain("-- simple-hwir child-defaults=")
                expect(result.vhdl).to_contain("graph=" + graph.structural_sha256())
                expect(result.vhdl).to_contain(
                    "wire_uop_skid_uop_ready <= source_selector_uop_ready")
                expect(result.vhdl).to_contain(
                    "wire_selector_completion_ready <= source_completion_skid_upstream_ready")
                expect(result.vhdl).to_contain(
                    "runtime_protocol_fault <= source_fault_owner_protocol_fault")

    it "specializes the compiler-owned top-level widths for RV64":
        val result = compile_strict_riscv_scalar_runtime_alu_pipeline(
            "runtime_alu_pipeline_rv64", CoreConfig.rv64())
        expect(result.is_success()).to_equal(true)
        if result.is_success():
            expect(result.vhdl).to_contain(
                "completion_rd_value : out std_logic_vector(63 downto 0)")
            expect(result.vhdl).to_contain(
                "entity runtime_alu_pipeline_rv64 is port(")

    it "rejects immutable endpoint width driver order and child graph forgeries":
        val base = strict_riscv_scalar_runtime_alu_pipeline(
            "runtime_alu_pipeline_negative", CoreConfig.rv32()).unwrap()
        expect(base.diagnostic()).to_equal("")

        val first = base.bindings[0]
        val wrong_endpoint_binding = HwScalarRuntimeAluPipelineBinding(
            source_owner: first.source_owner, source_port: "missing_instruction",
            destination_owner: first.destination_owner,
            destination_port: first.destination_port, bit_width: first.bit_width)
        val wrong_endpoint = pipeline_with_bindings(base,
            replaced_pipeline_binding(base.bindings, 0, wrong_endpoint_binding))
        expect(wrong_endpoint.diagnostic()).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-ENDPOINT: binding endpoint direction is invalid")

        val wrong_width_binding = HwScalarRuntimeAluPipelineBinding(
            source_owner: first.source_owner, source_port: first.source_port,
            destination_owner: first.destination_owner,
            destination_port: first.destination_port, bit_width: 31)
        val wrong_width = pipeline_with_bindings(base,
            replaced_pipeline_binding(base.bindings, 0, wrong_width_binding))
        expect(wrong_width.diagnostic()).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-WIDTH: binding endpoint width is invalid")

        val duplicate_source = base.bindings[1]
        val duplicate_destination = HwScalarRuntimeAluPipelineBinding(
            source_owner: duplicate_source.source_owner,
            source_port: duplicate_source.source_port,
            destination_owner: duplicate_source.destination_owner,
            destination_port: duplicate_source.destination_port,
            bit_width: duplicate_source.bit_width)
        val duplicate = pipeline_with_bindings(base,
            replaced_pipeline_binding(base.bindings, 2, duplicate_destination))
        expect(duplicate.diagnostic()).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-DRIVER: every destination requires one driver")
        expect(scalar_runtime_alu_pipeline_driver_closure_diagnostic(duplicate)).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-VHDL-DRIVER: every destination requires exactly one driver")

        val reordered = pipeline_with_bindings(base,
            swapped_pipeline_bindings(base.bindings, 0, 1))
        expect(reordered.diagnostic()).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-BINDINGS: pipeline requires exact ordered typed bindings")

        val other = strict_riscv_scalar_runtime_alu_pipeline(
            "runtime_alu_pipeline_other_child", CoreConfig.rv32()).unwrap()
        val wrong_child = pipeline_with_alu(base, other.alu)
        expect(wrong_child.diagnostic()).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-HASH: pipeline requires exact compiler-owned child graphs")

    it "retains the compiler-owned route on fail-closed rejection":
        val result = compile_strict_riscv_scalar_runtime_alu_pipeline("", CoreConfig.rv32())
        expect(result.is_success()).to_equal(false)
        expect(result.route).to_equal("hwir-gen2-scalar-runtime-alu-pipeline-v2")
        expect(result.vhdl).to_equal("")
        expect(result.hwir_graph_sha256).to_equal("")
        expect(result.diagnostic).to_contain("HWIR-E-RISCV-RUNTIME-PIPELINE-ID")
