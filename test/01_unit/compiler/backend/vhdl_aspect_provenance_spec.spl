use std.spec
use compiler.driver.driver_vhdl_artifacts.{
    VhdlArtifactLocation, VhdlArtifactGeneratedItem, VhdlArtifactPort,
    VhdlArtifactAspect, VhdlArtifactInput, vhdl_gen2_capability_ids,
    vhdl_gen2_capability_sha256, vhdl_render_production_artifacts,
    vhdl_validate_production_artifact_input
}
use compiler.mir.hwir.aspects.{HwAspectLock, HwAspectLockEntry, hwir_aspect_lock_sha256}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.frontend.{strict_zca_control_predecode_hwir}

fn aspect_provenance_hash(value: text) -> text:
    if value == "a":
        return "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn aspect_provenance_unknown_location() -> VhdlArtifactLocation:
    VhdlArtifactLocation(available: false, module_name: "", file: "",
        start: 0, end: 0, line: 0, col: 0)

fn aspect_provenance_lock(aspects: [VhdlArtifactAspect]) -> text:
    var entries: [HwAspectLockEntry] = []
    for aspect in aspects:
        entries.push(HwAspectLockEntry(id: aspect.id, version: aspect.version,
            content_hash: aspect.content_hash))
    hwir_aspect_lock_sha256(HwAspectLock(entries: entries)).unwrap()

fn aspect_provenance_ports() -> [VhdlArtifactPort]:
    val entity = "riscv_gen2_zca_control_predecode_rv32"
    val module = strict_zca_control_predecode_hwir(entity,
        CoreConfig.rv32_zca_mission_critical()).unwrap()
    var ports: [VhdlArtifactPort] = []
    var index = 0
    for port in module.ports:
        ports.push(VhdlArtifactPort(entity: entity, name: port.name,
            direction: port.direction, type_name: port.type_name,
            bit_width: port.bit_width as i64, index: index,
            location: aspect_provenance_unknown_location()))
        index = index + 1
    ports

fn aspect_provenance_input(aspects: [VhdlArtifactAspect]) -> VhdlArtifactInput:
    val capability_ids = vhdl_gen2_capability_ids("hwir-gen2-product",
        "riscv_gen2_zca_control_predecode_rv32").unwrap()
    val capability_sha256 = vhdl_gen2_capability_sha256(capability_ids).unwrap()
    VhdlArtifactInput(output_path: "build/aspect-provenance.vhd",
        entry_module: "compiler.product.riscv_gen2",
        entry_entity: "riscv_gen2_zca_control_predecode_rv32",
        root_modules: ["compiler.product.riscv_gen2"], sources: [],
        compiler_identity: "simple", compiler_hash: aspect_provenance_hash("a"),
        target: "riscv32", xlen: 32, profile: "riscv-gen2-rv32-zca-critical",
        catalog_name: "simple_hwir_product", module_count: 1, entity_count: 1,
        type_count: 1, helper_count: 0, generation_route: "hwir-gen2-product",
        hwir_module_node_id: "riscv_gen2_zca_control_predecode_rv32:module",
        hwir_config_profile: "riscv-gen2-rv32-zca-critical",
        hwir_graph_sha256: aspect_provenance_hash("a"),
        riscv_isa_profile: "rv32i", riscv_compressed_decode_profile: "zca-common-critical",
        riscv_capability_scope: "frontend-predecode-only",
        riscv_admitted_instruction_ids: capability_ids,
        riscv_capability_sha256: capability_sha256,
        riscv_target_evidence_complete: false,
        hwir_aspect_lock_sha256: aspect_provenance_lock(aspects), hwir_aspects: aspects,
        generated_items: [VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
            name: "riscv_gen2_zca_control_predecode_rv32",
            location: aspect_provenance_unknown_location())],
        ports: aspect_provenance_ports(),
        aop_advices_requested: 0, aop_weave_count: 0)

describe "VHDL HWIR aspect provenance":
    it "serializes semantically identical typed aspect plans in a canonical order":
        val debug = VhdlArtifactAspect(id: "debug.rvfi", version: "1.0.0",
            content_hash: aspect_provenance_hash("a"))
        val safety = VhdlArtifactAspect(id: "safety.parity", version: "2.1.0",
            content_hash: aspect_provenance_hash("b"))
        val first = vhdl_render_production_artifacts(
            aspect_provenance_input([safety, debug]), "entity rtl is\n")
        val second = vhdl_render_production_artifacts(
            aspect_provenance_input([debug, safety]), "entity rtl is\n")
        expect(vhdl_validate_production_artifact_input(
            aspect_provenance_input([debug, safety])).is_ok()).to_equal(true)
        expect(first.manifest).to_equal(second.manifest)
        expect(first.manifest).to_contain(
            "\"entries\":[{\"id\":\"debug.rvfi\",\"version\":\"1.0.0\",\"sha256\":\"" +
            aspect_provenance_hash("a") + "\"},{\"id\":\"safety.parity\",\"version\":\"2.1.0\",\"sha256\":\"" +
            aspect_provenance_hash("b") + "\"}]")

    it "rejects a digest that is not the canonical identity of its pinned aspect entries":
        val debug = VhdlArtifactAspect(id: "debug.rvfi", version: "1.0.0",
            content_hash: aspect_provenance_hash("a"))
        var forged = aspect_provenance_input([debug])
        forged.hwir_aspect_lock_sha256 = aspect_provenance_hash("b")
        expect(vhdl_validate_production_artifact_input(forged).unwrap_err()).to_equal(
            "VHDL artifact aspect provenance lock SHA-256 does not match pinned aspect identities")
