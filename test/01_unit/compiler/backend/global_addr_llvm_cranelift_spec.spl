"""LLVM and Cranelift contracts for canonical module-static addresses."""
# @req: REQ-COMPILER-MIR-GLOBAL-ADDR-001

use std.spec
use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read_text}
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.backend.backend.cranelift_codegen_adapter.{
    cranelift_static_alignment, cranelift_static_linkage,
    CL_LINKAGE_EXPORT, CL_LINKAGE_HIDDEN, CL_LINKAGE_LOCAL,
    CRANELIFT_STATIC_MAX_ALIGNMENT}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*

fn address_module(visibility: Visibility, alignment: i64) -> MirModule:
    val global_symbol = SymbolId(id: 101)
    val i64_type = MirType.i64()
    var statics: Dict<SymbolId, MirStatic> = {}
    statics[global_symbol] = MirStatic(
        symbol: global_symbol, name: "address_owner", type_: i64_type,
        init: Some(MirConstant(
            symbol: global_symbol, name: "address_owner", type_: i64_type,
            value: MirConstValue.Int(29))),
        is_mutable: true, alignment: alignment, visibility: visibility)
    val pointer_type = MirType(kind: MirTypeKind.Ref(i64_type, true))
    val function = MirFunction(
        symbol: SymbolId(id: 102), name: "address_roundtrip",
        signature: MirSignature(params: [], return_type: i64_type, is_variadic: false),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("address"), type_: pointer_type, kind: LocalKind.Temp, is_ghost: false),
            MirLocal(id: LocalId(id: 1), name: Some("loaded"), type_: i64_type, kind: LocalKind.Temp, is_ghost: false)
        ],
        blocks: [MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [
                MirInst(kind: MirInstKind.GlobalAddr(LocalId(id: 0), global_symbol, true), span: nil),
                MirInst(kind: MirInstKind.Load(LocalId(id: 1), mir_operand_copy(LocalId(id: 0))), span: nil),
                MirInst(kind: MirInstKind.Store(
                    mir_operand_copy(LocalId(id: 0)), mir_operand_copy(LocalId(id: 1))), span: nil)
            ],
            terminator: MirTerminator.Ret(Some(mir_operand_copy(LocalId(id: 1))))
        )],
        entry_block: BlockId.entry(), span: Span.empty(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false)
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(name: "global.address.backend", functions: functions,
        statics: statics, constants: {}, types: {})

fn static_fixture(visibility: Visibility, alignment: i64) -> MirStatic:
    MirStatic(
        symbol: SymbolId(id: 201), name: "metadata", type_: MirType.i64(),
        init: nil, is_mutable: true, alignment: alignment, visibility: visibility)

describe "LLVM GlobalAddr lowering":
    it "uses the exact declaration identity for address, load, and store":
        step("Lower one canonical static through all three memory operations")
        val llvm = MirToLlvm.create(
            "global.address.backend", CodegenTarget.X86_64, nil
        ).translate_module(address_module(Visibility.Public, 32))
        expect(llvm).to_contain("@g_address_owner = global i64 29, align 32")
        expect(llvm).to_contain("getelementptr i8, ptr @g_address_owner, i64 0  ; GlobalAddr")
        expect(llvm).to_contain("load i64, ptr %l0")
        expect(llvm).to_contain("store i64 %l1, ptr %l0")

    it "preserves private and scoped linkage decisions":
        step("Exercise both conditions in the three-way linkage decision")
        val private_ir = MirToLlvm.create(
            "global.address.private", CodegenTarget.X86_64, nil
        ).translate_module(address_module(Visibility.Private, 8))
        val hidden_ir = MirToLlvm.create(
            "global.address.hidden", CodegenTarget.X86_64, nil
        ).translate_module(address_module(Visibility.Package, 8))
        expect(private_ir).to_contain("@g_address_owner = internal global")
        expect(hidden_ir).to_contain("@g_address_owner = hidden global")

    it "routes bootstrap enum payloads through typed accessors":
        step("Inspect the bootstrap-safe dispatch and canonical static lookup")
        val source = file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        expect(source).to_contain("inst.bootstrap_global_addr_dest_local_id()")
        expect(source).to_contain("inst.bootstrap_global_addr_symbol_id()")
        expect(source).to_contain("bootstrap_llvm_static_index(module_index, symbol_id)")
        expect(source).to_contain("@g_{bootstrap_mir_static_name_at(static_index)}")
        expect(source.contains("LLVM GlobalAddr lowering is not implemented")).to_equal(false)
        expect(source).to_contain("E-BACKEND-LLVM-GLOBAL-ADDR-MISSING")
        expect(source).to_contain("me translate_global_addr_ids(dest_id: i64, symbol_id: i64")
        expect(source).to_contain("var g_name = \"\"")

describe "Cranelift GlobalAddr metadata":
    it "maps all six source visibilities without collapsing scoped linkage":
        step("Cover every source visibility arm")
        expect(cranelift_static_linkage(static_fixture(Visibility.Public, 8))).to_equal(CL_LINKAGE_EXPORT)
        expect(cranelift_static_linkage(static_fixture(Visibility.Peer, 8))).to_equal(CL_LINKAGE_HIDDEN)
        expect(cranelift_static_linkage(static_fixture(Visibility.Up, 8))).to_equal(CL_LINKAGE_HIDDEN)
        expect(cranelift_static_linkage(static_fixture(Visibility.Internal, 8))).to_equal(CL_LINKAGE_HIDDEN)
        expect(cranelift_static_linkage(static_fixture(Visibility.Package, 8))).to_equal(CL_LINKAGE_HIDDEN)
        expect(cranelift_static_linkage(static_fixture(Visibility.Private, 8))).to_equal(CL_LINKAGE_LOCAL)

    it "uses explicit alignment or the type's natural alignment":
        step("Cover both outcomes of the alignment override condition")
        expect(cranelift_static_alignment(static_fixture(Visibility.Private, 32))).to_equal(32)
        expect(cranelift_static_alignment(static_fixture(Visibility.Private, 0))).to_equal(8)
        expect(cranelift_static_alignment(static_fixture(Visibility.Private, -1))).to_equal(-1)
        expect(cranelift_static_alignment(static_fixture(Visibility.Private, 3))).to_equal(-1)
        expect(cranelift_static_alignment(static_fixture(
            Visibility.Private, CRANELIFT_STATIC_MAX_ALIGNMENT * 2))).to_equal(-1)

    it "has no unsupported GlobalAddr fallback and uses data_addr":
        step("Inspect the exact backend and provider ownership contracts")
        val adapter = file_read_text(
            "src/compiler/70.backend/backend/cranelift_codegen_adapter.spl")
        val provider = file_read_text(
            "src/compiler_rust/compiler/src/codegen/cranelift_sffi.rs")
        expect(adapter).to_contain("case GlobalAddr(dest, symbol, _):")
        expect(adapter).to_contain("cranelift_data_addr_in_func(ctx, global_handles[symbol.id])")
        expect(adapter.contains("does not support GlobalAddr")).to_equal(false)
        expect(provider).to_contain("desc.set_align(requested_alignment)")
        expect(provider).to_contain("declare_data(&name, linkage, true, false)")
