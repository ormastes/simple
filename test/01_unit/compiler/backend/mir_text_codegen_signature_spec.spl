# @workaround bug=BUG-PHASE1-BDD-NEGATED-MATCHERS-20261011 reason=cached producer lacks negated matcher links; retain exact negative containment predicate.
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_data.*

extern fn rt_file_read_text(path: text) -> text?

describe "MIR text codegen function signature":
    it "keeps the trait and LLVM implementation on the same span-aware contract":
        val trait_source = rt_file_read_text(
            "src/compiler/70.backend/backend/common/mir_text_codegen.spl"
        ) ?? ""
        val llvm_source = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val driver_source = rt_file_read_text(
            "src/compiler/80.driver/driver_bootstrap.spl"
        ) ?? ""

        val signature = "me translate_function(name: text, body: MirBody, span: Span)"
        expect(trait_source).to_contain(r"use compiler.common.diagnostics.span.{Span}")
        expect(trait_source).to_contain(signature)
        expect(llvm_source).to_contain(signature)
        expect(llvm_source).to_contain("val fn_name = name")
        expect(llvm_source).to_contain(
            "self.translate_function(fn_name, body, fn_.span)"
        )
        expect(llvm_source).to_contain(
            "self.translate_function(self.llvm_function_symbol_name(name), body, bootstrap_fn.span)"
        )
        expect(llvm_source.contains("self.translate_function(fn_name, body)")).to_equal(false)
        expect(llvm_source.contains("self.translate_function(self.llvm_function_symbol_name(name), body)")).to_equal(false)
        expect(driver_source).to_contain(
            "translator.translate_function(if fn_.name == \"main\": \"__simple_main\" else: fn_.name, body, fn_.span)"
        )
        expect(driver_source).to_not_contain(
            "translator.translate_function(if name == \"main\": \"__simple_main\" else: name, body)"
        )
        expect(driver_source).to_not_contain(
            "translator.translate_function(if fn_.name == \"main\": \"__simple_main\" else: fn_.name, body)"
        )

    it "accepts the span argument and emits the requested LLVM function":
        var translator = MirToLlvm.create(
            "test.mir_text_codegen_signature",
            CodegenTarget.X86_64,
            nil
        )
        translator.builder.emit_module_header()
        val body = MirBody(
            name: "trait_signature_probe",
            blocks: [
                MirBlock(
                    id: BlockId.entry(),
                    label: Some("entry"),
                    instructions: [],
                    terminator: MirTerminator.Ret(nil)
                )
            ],
            locals: [],
            arg_count: 0,
            return_ty: MirType.unit()
        )

        translator.translate_function(
            "trait_signature_probe",
            body,
            Span.empty()
        )
        val ir = translator.builder.build()

        expect(ir).to_contain("define void @trait_signature_probe()")
        expect(ir).to_contain("ret void")

    it "preserves an already-emitted entry symbol without remangling":
        var translator = MirToLlvm.create(
            "test.already_emitted_main",
            CodegenTarget.X86_64,
            nil
        )
        translator.builder.emit_module_header()
        val body = MirBody(
            name: "main",
            blocks: [
                MirBlock(
                    id: BlockId.entry(),
                    label: Some("entry"),
                    instructions: [],
                    terminator: MirTerminator.Ret(nil)
                )
            ],
            locals: [],
            arg_count: 0,
            return_ty: MirType.unit()
        )

        translator.translate_function("__simple_main", body, Span.empty())
        val ir = translator.builder.build()

        expect(ir).to_contain("define i64 @__simple_main()")
        expect(ir.contains("@nil(")).to_equal(false)
        expect(ir.contains("@__simple_main_test_already_emitted_main(")).to_equal(false)

    # Stage3 s3_fable38 (2026-11-04): `fn main():` printed `x` and exited rc=10.
    # The entry file was not flagged entry_main_symbol, so its main was spelled
    # `__simple_main_<mod>` and stayed `define void` / `ret void`; the hosted C
    # main (and the smoke harness's objcopy rename to __simple_main) read
    # print()'s leftover RAX as the exit code. Every main spelling that can
    # become the process entry must return i64 0 for a unit body.
    it "REPRO: a unit-returning module-suffixed main returns i64 0, never void":
        var translator = MirToLlvm.create(
            "test.unit_main_module",
            CodegenTarget.X86_64,
            nil
        )
        translator.builder.emit_module_header()
        val body = MirBody(
            name: "main",
            blocks: [
                MirBlock(
                    id: BlockId.entry(),
                    label: Some("entry"),
                    instructions: [],
                    terminator: MirTerminator.Ret(nil)
                )
            ],
            locals: [],
            arg_count: 0,
            return_ty: MirType.unit()
        )

        translator.translate_function("__simple_main_test_unit_main_module", body, Span.empty())
        val ir = translator.builder.build()

        expect(ir).to_contain("define i64 @__simple_main_test_unit_main_module()")
        expect(ir).to_contain("ret i64 0")
        expect(ir.contains("define void @__simple_main_test_unit_main_module()")).to_equal(false)
        expect(ir.contains("ret void")).to_equal(false)

    it "sibling: the exact global entry spelling still returns i64 0 for a unit body":
        var translator = MirToLlvm.create(
            "test.unit_main_global",
            CodegenTarget.X86_64,
            nil
        )
        translator.builder.emit_module_header()
        val body = MirBody(
            name: "main",
            blocks: [
                MirBlock(
                    id: BlockId.entry(),
                    label: Some("entry"),
                    instructions: [],
                    terminator: MirTerminator.Ret(nil)
                )
            ],
            locals: [],
            arg_count: 0,
            return_ty: MirType.unit()
        )

        translator.translate_function("__simple_main", body, Span.empty())
        val ir = translator.builder.build()

        expect(ir).to_contain("define i64 @__simple_main()")
        expect(ir).to_contain("ret i64 0")
        expect(ir.contains("ret void")).to_equal(false)

    it "prevention: a unit function that merely resembles an entry name keeps its void signature":
        var translator = MirToLlvm.create(
            "test.unit_main_lookalike",
            CodegenTarget.X86_64,
            nil
        )
        translator.builder.emit_module_header()
        val body = MirBody(
            name: "helper",
            blocks: [
                MirBlock(
                    id: BlockId.entry(),
                    label: Some("entry"),
                    instructions: [],
                    terminator: MirTerminator.Ret(nil)
                )
            ],
            locals: [],
            arg_count: 0,
            return_ty: MirType.unit()
        )

        translator.translate_function("__simple_mainframe_helper", body, Span.empty())
        val ir = translator.builder.build()

        expect(ir).to_contain("define void @__simple_mainframe_helper()")
        expect(ir).to_contain("ret void")
        expect(ir.contains("define i64 @__simple_mainframe_helper()")).to_equal(false)
