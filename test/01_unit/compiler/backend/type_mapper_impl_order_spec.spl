"""
Regression and parity spec for TypeMapper impl-block ordering across all 8
compiler and plugin TypeMapper modules.

Each module must define its inherent `impl <Name>TypeMapper:` block before
`impl TypeMapper for <Name>TypeMapper:` so HIR surface indexing does not emit
`stale surface index [impls]` for `compiler.backend.common.type_mapper`.
"""

use std.spec.{describe, it, expect, assert_true}
use std.io_runtime.{file_read}
use compiler.backend.common.type_mapper.{PrimitiveType}
use compiler.mir.mir_types.{MirType}
use compiler.backend.cranelift_type_mapper.{CraneliftTypeMapper}
use compiler.backend.interpreter_type_mapper.{InterpreterTypeMapper}
use compiler.backend.llvm_type_mapper.{LlvmTypeMapper}
use plugins.backend_c.c_type_mapper.{CTypeMapper}
use plugins.backend_cuda.cuda_type_mapper.{CudaTypeMapper}
use plugins.backend_vhdl.vhdl_type_mapper.{VhdlTypeMapper}
use plugins.backend_vulkan.vulkan_type_mapper.{VulkanTypeMapper}
use plugins.backend_wasm.wasm_type_mapper.{WasmTypeMapper}

fn assert_inherent_before_trait(path: text, inherent_marker: text, trait_marker: text):
    val src = file_read(path)
    val inh_pos = src.index_of(inherent_marker) ?? -1
    val trait_pos = src.index_of(trait_marker) ?? -1
    expect(inh_pos).to_be_greater_than(-1)
    expect(trait_pos).to_be_greater_than(-1)
    expect(inh_pos).to_be_less_than(trait_pos)

describe "TypeMapper impl block ordering and parity":
    """Verify inherent-before-trait impl ordering and dispatch parity for all 8 TypeMappers."""

    it "places inherent impl before impl TypeMapper for in all 8 TypeMapper modules":
        assert_inherent_before_trait(
            "src/compiler/70.backend/backend/cranelift_type_mapper.spl",
            "impl CraneliftTypeMapper:",
            "impl TypeMapper for CraneliftTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/compiler/70.backend/backend/interpreter_type_mapper.spl",
            "impl InterpreterTypeMapper:",
            "impl TypeMapper for InterpreterTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/compiler/70.backend/backend/llvm_type_mapper.spl",
            "impl LlvmTypeMapper:",
            "impl TypeMapper for LlvmTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/plugins/backend_c/c_type_mapper.spl",
            "impl CTypeMapper:",
            "impl TypeMapper for CTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/plugins/backend_cuda/cuda_type_mapper.spl",
            "impl CudaTypeMapper:",
            "impl TypeMapper for CudaTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/plugins/backend_vhdl/vhdl_type_mapper.spl",
            "impl VhdlTypeMapper:",
            "impl TypeMapper for VhdlTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/plugins/backend_vulkan/vulkan_type_mapper.spl",
            "impl VulkanTypeMapper:",
            "impl TypeMapper for VulkanTypeMapper:"
        )
        assert_inherent_before_trait(
            "src/plugins/backend_wasm/wasm_type_mapper.spl",
            "impl WasmTypeMapper:",
            "impl TypeMapper for WasmTypeMapper:"
        )

    it "dispatches both TypeMapper trait and inherent methods for compiler mappers":
        val cranelift = CraneliftTypeMapper.create()
        expect(cranelift.backend_name()).to_equal("Cranelift")
        expect(cranelift.map_type(MirType.i64())).to_equal("I64")
        expect(cranelift.size_of(MirType.i64())).to_equal(8)
        expect(cranelift.map_function_signature([MirType.i64(), MirType.bool()], MirType.i64())).to_equal("(I64, I8) -> I64")
        assert_true(cranelift.is_primitive(MirType.i64()))

        val interp = InterpreterTypeMapper.create()
        expect(interp.backend_name()).to_equal("Interpreter")
        expect(interp.map_type(MirType.i64())).to_equal("Int")
        expect(interp.map_function_signature([MirType.i64(), MirType.bool()], MirType.bool())).to_equal("Function<(Int, Bool) -> Bool>")
        assert_true(interp.is_primitive_value(MirType.i64()))

        val llvm = LlvmTypeMapper.create()
        expect(llvm.backend_name()).to_equal("LLVM")
        expect(llvm.map_type(MirType.i64())).to_equal("i64")
        expect(llvm.size_of(MirType.i64())).to_equal(8)
        expect(llvm.map_function_signature([MirType.i64(), MirType.i64()], MirType.i64())).to_equal("i64 (i64, i64)")

    it "dispatches both TypeMapper trait and inherent methods for plugin mappers":
        val c_mapper = CTypeMapper.create()
        expect(c_mapper.backend_name()).to_equal("C")
        expect(c_mapper.map_type(MirType.bool())).to_equal("int64_t")
        expect(c_mapper.size_of(MirType.bool())).to_equal(8)
        expect(c_mapper.map_return_type(MirType.unit())).to_equal("void")
        expect(c_mapper.map_return_type(MirType.i64())).to_equal("int64_t")

        val cuda = CudaTypeMapper.create_sm(8, 6)
        expect(cuda.backend_name()).to_equal("CUDA")
        expect(cuda.map_primitive(PrimitiveType.F32)).to_equal("float")
        expect(cuda.size_of(MirType.i64())).to_equal(8)
        expect(cuda.ptx_type(PrimitiveType.I64)).to_equal(".s64")
        expect(cuda.warp_size()).to_equal(32)

        val vhdl = VhdlTypeMapper.create()
        expect(vhdl.backend_name()).to_equal("VHDL")
        expect(vhdl.map_primitive(PrimitiveType.I64)).to_equal("signed(63 downto 0)")
        expect(vhdl.map_signed(16)).to_equal("signed(15 downto 0)")
        expect(vhdl.bit_type()).to_equal("bit")

        val vulkan = VulkanTypeMapper.create()
        expect(vulkan.backend_name()).to_equal("Vulkan/SPIR-V")
        expect(vulkan.map_primitive(PrimitiveType.I32)).to_equal("OpTypeInt 32 1")
        expect(vulkan.spirv_execution_model()).to_equal("GLCompute")
        expect(vulkan.subgroup_size()).to_equal(32)

        val wasm = WasmTypeMapper.create_wasm32()
        expect(wasm.backend_name()).to_equal("WebAssembly")
        expect(wasm.map_type(MirType.i64())).to_equal("i64")
        expect(wasm.map_function_signature([MirType.i64(), MirType.bool()], MirType.unit())).to_equal("(param i64 i32)")
        expect(wasm.wasm_size(MirType.i64())).to_equal(1)
