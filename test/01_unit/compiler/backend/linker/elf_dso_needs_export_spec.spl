# Internal ELF linker: executable definitions a DSO references go in .dynsym.
# Repro of FreeBSD aarch64 `ld-elf.so.1: /lib/libc.so.7: Undefined symbol
# "environ"` (doc/08_tracking/bug/linker_dso_referenced_exe_defs_not_exported_2026-11-19.md).
# Oracle: ld.lld --dynamic-linker /lib/ld.so needenv_start_a64.o
# libneedenv_a64.so.1 exports environ (GLOBAL OBJECT) and the weak
# _Jv_RegisterClasses (WEAK FUNC), never the hidden hidden_thing.
#
# @cover src/compiler/70.backend/linker/elf/elf_static_link.spl
# @cover src/compiler/70.backend/linker/elf/reloc_scan.spl
# @cover src/compiler/70.backend/linker/elf/shared_object.spl

use compiler.backend.linker.elf.elf_static_link.{elf_link, ElfLinkRequest, ELF_LINK_DYNAMIC_EXEC, ELF_LINK_DYNAMIC_PIE}
use compiler.backend.linker.elf.shared_object.{elf_parse_shared}
use compiler.backend.linker.reloc_engine.{RelocArch}
use std.io_runtime.{file_read_bytes}
use std.string_core.{char_from_code}

val FIX: text = "test/fixtures/linker/elf"

fn load_path(path: text) -> [i64]:
    val raw = file_read_bytes(path)
    var out: [i64] = []
    var i: i64 = 0
    while i < raw.len():
        out = out.push(raw[i] as i64)
        i = i + 1
    out

fn rd16(b: [i64], o: i64) -> i64:
    b[o] | (b[o + 1] << 8)

fn rd32(b: [i64], o: i64) -> i64:
    rd16(b, o) | (rd16(b, o + 2) << 16)

fn rd64(b: [i64], o: i64) -> i64:
    rd32(b, o) | (rd32(b, o + 4) << 32)

fn cstr(b: [i64], o: i64) -> text:
    var s = ""
    var i = o
    while b[i] != 0:
        s = s + char_from_code(b[i])
        i = i + 1
    s

fn shdr(b: [i64], name: text) -> i64:
    val shoff = rd64(b, 0x28)
    val stroff = rd64(b, shoff + rd16(b, 0x3e) * 64 + 24)
    var i: i64 = 0
    while i < rd16(b, 0x3c):
        val h = shoff + i * 64
        if cstr(b, stroff + rd32(b, h)) == name:
            return h
        i = i + 1
    -1

fn dynsym_at(b: [i64], name: text) -> i64:
    """File offset of the .dynsym entry for name, or -1."""
    val ds = rd64(b, shdr(b, ".dynsym") + 24)
    val st = rd64(b, shdr(b, ".dynstr") + 24)
    val n = rd64(b, shdr(b, ".dynsym") + 32) / 24
    var i: i64 = 1
    while i < n:
        if cstr(b, st + rd32(b, ds + i * 24)) == name:
            return ds + i * 24
        i = i + 1
    -1

fn link_ne(mode: i64) -> [i64]:
    val r = elf_link(ElfLinkRequest(objects: [load_path("{FIX}/needenv_start_a64.o")], archives: [],
        shared: [load_path("{FIX}/libneedenv_a64.so.1")], entry: "_start",
        target: RelocArch.AArch64, mode: mode, interp: "/lib/ld.so"))
    if r.is_err():
        print "link error: {r.unwrap_err()}"
        return []
    r.unwrap()

describe "elf_link - DSO-referenced executable definitions":
    it "records the DSO's undefined references":
        val lib = elf_parse_shared(file_read_bytes("{FIX}/libneedenv_a64.so.1")).unwrap()
        expect(lib.needs.contains("environ")).to_equal(true)
        expect(lib.needs.contains("_Jv_RegisterClasses")).to_equal(true)
        expect(lib.needs.contains("get_env")).to_equal(false)

    it "exports environ GLOBAL and _Jv_RegisterClasses WEAK, defined, like ld.lld":
        for mode in [ELF_LINK_DYNAMIC_EXEC, ELF_LINK_DYNAMIC_PIE]:
            val b = link_ne(mode)
            expect(b.len() > 0).to_equal(true)
            val env = dynsym_at(b, "environ")
            expect(env > 0).to_equal(true)
            expect(b[env + 4]).to_equal((1 << 4) | 1)      # GLOBAL OBJECT
            expect(rd16(b, env + 6) != 0).to_equal(true)   # defined
            expect(rd64(b, env + 8) != 0).to_equal(true)
            expect(rd64(b, env + 16)).to_equal(8)
            val jv = dynsym_at(b, "_Jv_RegisterClasses")
            expect(jv > 0).to_equal(true)
            expect(b[jv + 4]).to_equal((2 << 4) | 2)       # WEAK FUNC
            expect(rd16(b, jv + 6) != 0).to_equal(true)

    it "keeps a hidden definition out of .dynsym and still imports get_env":
        val b = link_ne(ELF_LINK_DYNAMIC_EXEC)
        expect(dynsym_at(b, "hidden_thing")).to_equal(-1)
        val g = dynsym_at(b, "get_env")
        expect(g > 0).to_equal(true)
        expect(rd16(b, g + 6)).to_equal(0)
