# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# native_linking — link_to_native's own SIMPLE_LINKER=internal routing (lane
# B3, doc/03_plan/compiler/linker/mold_mdsocpp_linker_plan_2026-09-18.md
# §1/§11), plus the pre-existing single-SMF create_temp_dir Result-unwrap bug
# (doc/08_tracking/bug/native_linking_single_smf_temp_dir_result_not_unwrapped_2026-09-18.md).
#
# Before this lane, `link_to_native` under SIMPLE_LINKER=internal stopped
# with the named error from `find_linker_path` (mold.spl) -- "internal engine
# is not a linker path" -- because only `link_request_to_native`
# (link_engine_external.spl, lane A3/A7) knew how to select the internal ELF
# engine. Lane B3 gives `link_to_native` the same routing, sharing the
# implementation (`internal_link_native`) with that adapter instead of
# duplicating it.
#
# @cover src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl

use std.spec.step
use std.spec.*

use compiler.backend.linker.linker_wrapper.{link_to_native, NativeLinkConfig}
use compiler.backend.linker.smf_writer.{SmfWriter}
use std.io_runtime.{file_read_bytes, file_write_bytes, shell}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text)

fn with_env(key: text, value: text, block: fn()):
    val previous = rt_env_get(key) ?? ""
    rt_env_set(key, value)
    block()
    rt_env_set(key, previous)

val HELLO_A64_OBJ: text = "test/fixtures/linker/elf/hello_libc_a64.o"
val LIBM_A64_OBJ: text = "test/fixtures/linker/elf/hello_libm_a64.o"

describe "native_linking - link_to_native SIMPLE_LINKER=internal routing":
    # Host requirement: aarch64 Linux with glibc (crt_discovery finds
    # Scrt1.o/crti.o/crtn.o and libc.so.6 next to them) -- same requirement
    # as link_engine_external_spec.spl's internal-engine specs.
    it "links a Linux aarch64 ELF object internally and the output runs":
        # @req REQ-LINKER-B3-INTERNAL-ROUTING
        step("SIMPLE_LINKER=internal routes link_to_native to the internal ELF engine end to end")
        with_env("SIMPLE_LINKER", "internal", fn():
            val out = "/tmp/native_linking_internal_spec_hello"
            val cfg = NativeLinkConfig.default()
            val result = link_to_native([HELLO_A64_OBJ], out, cfg)
            expect(result.is_ok()).to_equal(true)
            val run = shell("'{out}'")
            expect(run.exit_code).to_equal(42)
            expect(run.stdout).to_equal("hi from libc\n")
        )

    it "reports a missing input as a named internal-engine error, never a silent external fallback":
        # @req REQ-LINKER-B3-INTERNAL-ROUTING
        step("SIMPLE_LINKER=internal + unreadable object -> 'internal engine: ... cannot be read', not a mold/lld/cc attempt")
        with_env("SIMPLE_LINKER", "internal", fn():
            val cfg = NativeLinkConfig.default()
            val result = link_to_native(
                ["/tmp/native_linking_internal_spec_nonexistent.o"],
                "/tmp/native_linking_internal_spec_missing_out", cfg)
            expect(result.is_err()).to_equal(true)
            expect(result.unwrap_err()).to_contain("internal engine:")
            expect(result.unwrap_err()).to_contain("cannot be read")
        )

    it "rejects a config field the internal engine would silently ignore (strip_output), naming it":
        # @req REQ-LINKER-B3-INTERNAL-ROUTING
        step("SIMPLE_LINKER=internal + strip_output -> named 'unsupported config field' error, not a silent drop")
        with_env("SIMPLE_LINKER", "internal", fn():
            var cfg = NativeLinkConfig.default()
            cfg.strip_output = true
            val result = link_to_native(
                ["test/fixtures/linker/elf/hello_libc_a64.o"],
                "/tmp/native_linking_internal_spec_libs_out", cfg)
            expect(result.is_err()).to_equal(true)
            expect(result.unwrap_err()).to_contain("unsupported config field 'strip_output'")
        )

    it "SIMPLE_LINKER unset still resolves through the external path unchanged":
        # @req REQ-LINKER-B3-INTERNAL-ROUTING
        step("Unsetting SIMPLE_LINKER leaves the pre-existing mold/lld/ld resolution untouched (byte-identical argv builders)")
        with_env("SIMPLE_LINKER", "", fn():
            val out = "/tmp/native_linking_internal_spec_external_hello"
            val cfg = NativeLinkConfig.default()
            val result = link_to_native([HELLO_A64_OBJ], out, cfg)
            expect(result.is_ok()).to_equal(true)
            val run = shell("'{out}'")
            expect(run.exit_code).to_equal(42)
            expect(run.stdout).to_equal("hi from libc\n")
        )

describe "native_linking - single-SMF create_temp_dir Result unwrap (bug fix)":
    it "links a single SMF wrapping a real ELF object without crashing on the Result comparison":
        # @req REQ-LINKER-B3-SMF-TEMPDIR-FIX
        step("A single .smf whose Code section embeds a real ELF object reaches create_temp_dir() and links, not 'method contains not found on type enum'")
        val obj_bytes = file_read_bytes(HELLO_A64_OBJ)
        var code: [i64] = []
        var read_i = 0
        while read_i < obj_bytes.len():
            code = code.push(obj_bytes[read_i] as i64)
            read_i = read_i + 1
        var writer = SmfWriter.create()
        writer.add_code_section("code", code)
        val write_result = writer.write()
        expect(write_result.is_ok()).to_equal(true)
        val write_bytes = write_result.unwrap()
        var smf_bytes: [u8] = []
        var write_i = 0
        while write_i < write_bytes.len():
            smf_bytes = smf_bytes.push(write_bytes[write_i] as u8)
            write_i = write_i + 1
        val smf_path = "/tmp/native_linking_internal_spec_object.smf"
        expect(file_write_bytes(smf_path, smf_bytes)).to_equal(true)

        val out = "/tmp/native_linking_internal_spec_smf_hello"
        val cfg = NativeLinkConfig.default()
        val result = link_to_native([smf_path], out, cfg)
        expect(result.is_ok()).to_equal(true)
        val run = shell("'{out}'")
        expect(run.exit_code).to_equal(42)
        expect(run.stdout).to_equal("hi from libc\n")

describe "native_linking - internal engine library search (NativeLinkConfig.libraries)":
    # Lane F1: linking the real `simple` binary needs library SEARCH names --
    # its own DT_NEEDED set is libm/libgcc_s/libc -- so `libraries` /
    # `library_paths` stopped being a reject (lane B3 listed both) and became
    # a capability. Resolution mirrors ld: each `library_paths` entry then the
    # host crt libdir, `lib<name>.so` before `lib<name>.a`, and a `lib<name>.so`
    # that is a GNU ld script (glibc's libm.so is one) is followed to its
    # GROUP() members. Anything unresolvable is a named error, never a silent
    # drop and never an external fallback.
    it "resolves libraries=[m] through the host libm.so GNU ld script and the output runs":
        # @req REQ-LINKER-F1-INTERNAL-LIBRARY-SEARCH
        step("SIMPLE_LINKER=internal + libraries=[m] links an object that calls sqrt; the binary prints sqrt=42 and exits 42")
        with_env("SIMPLE_LINKER", "internal", fn():
            val out = "/tmp/native_linking_internal_spec_libm"
            var cfg = NativeLinkConfig.default()
            cfg.libraries = ["m"]
            val result = link_to_native([LIBM_A64_OBJ], out, cfg)
            expect(result.is_ok()).to_equal(true)
            val run = shell("'{out}'")
            expect(run.exit_code).to_equal(42)
            expect(run.stdout).to_equal("sqrt=42\n")
        )

    it "resolves a static archive by search name from library_paths":
        # @req REQ-LINKER-F1-INTERNAL-LIBRARY-SEARCH
        step("libraries=[chain_a64] + library_paths=[test/fixtures/linker/elf] selects libchain_a64.a for the archive fixpoint")
        with_env("SIMPLE_LINKER", "internal", fn():
            val out = "/tmp/native_linking_internal_spec_archive_by_name"
            var cfg = NativeLinkConfig.default()
            cfg.libraries = ["chain_a64"]
            cfg.library_paths = ["test/fixtures/linker/elf"]
            val result = link_to_native([HELLO_A64_OBJ], out, cfg)
            expect(result.is_ok()).to_equal(true)
            val run = shell("'{out}'")
            expect(run.exit_code).to_equal(42)
        )

    it "reports an unresolvable library search name, listing the directories searched":
        # @req REQ-LINKER-F1-INTERNAL-LIBRARY-SEARCH
        step("libraries=[definitely_not_a_library] -> 'internal engine: unresolved library' naming the name and the search path")
        with_env("SIMPLE_LINKER", "internal", fn():
            var cfg = NativeLinkConfig.default()
            cfg.libraries = ["definitely_not_a_library_f1"]
            val result = link_to_native([HELLO_A64_OBJ],
                "/tmp/native_linking_internal_spec_unresolved_out", cfg)
            expect(result.is_err()).to_equal(true)
            expect(result.unwrap_err()).to_contain("internal engine: unresolved library 'definitely_not_a_library_f1'")
            expect(result.unwrap_err()).to_contain("searched")
        )

    it "still rejects extra_flags by name - library support did not widen the accepted config":
        # @req REQ-LINKER-F1-INTERNAL-LIBRARY-SEARCH
        step("SIMPLE_LINKER=internal + extra_flags=[-Wl,-z,relro] -> named 'unsupported config field' error (reject, never mask)")
        with_env("SIMPLE_LINKER", "internal", fn():
            var cfg = NativeLinkConfig.default()
            cfg.extra_flags = ["-Wl,-z,relro"]
            val result = link_to_native([HELLO_A64_OBJ],
                "/tmp/native_linking_internal_spec_flags_out", cfg)
            expect(result.is_err()).to_equal(true)
            expect(result.unwrap_err()).to_contain("unsupported config field 'extra_flags'")
        )

describe "native_linking - internal engine and the real bootstrap link config":
    # Lane F1: the sanctioned bootstrap links stage2/stage3 `simple` with
    # `native-build ... -o <stage bin>`, which reaches
    # llvm_native_link_orchestrator's `link_to_native(all_objects, output,
    # link_config)`. That link_config carries `runtime_path: "none"` -- the
    # documented sentinel for "the LLVM pipeline supplies the runtime objects
    # directly", not a path. Rejecting it stopped the internal route at the one
    # call site that links the compiler itself, for a field with nothing to
    # honour. A real runtime_path is still rejected.
    it "accepts runtime_path=none, the sentinel the bootstrap stage link passes":
        # @req REQ-LINKER-F1-INTERNAL-BOOTSTRAP-CONFIG
        step("SIMPLE_LINKER=internal + runtime_path='none' links and runs (not 'unsupported config field')")
        with_env("SIMPLE_LINKER", "internal", fn():
            val out = "/tmp/native_linking_internal_spec_runtime_none"
            var cfg = NativeLinkConfig.default()
            cfg.runtime_path = "none"
            val result = link_to_native([HELLO_A64_OBJ], out, cfg)
            expect(result.is_ok()).to_equal(true)
            val run = shell("'{out}'")
            expect(run.exit_code).to_equal(42)
        )

    it "still rejects a real runtime_path by name":
        # @req REQ-LINKER-F1-INTERNAL-BOOTSTRAP-CONFIG
        step("SIMPLE_LINKER=internal + runtime_path=/opt/simple/runtime -> named 'unsupported config field' error")
        with_env("SIMPLE_LINKER", "internal", fn():
            var cfg = NativeLinkConfig.default()
            cfg.runtime_path = "/opt/simple/runtime"
            val result = link_to_native([HELLO_A64_OBJ],
                "/tmp/native_linking_internal_spec_runtime_real_out", cfg)
            expect(result.is_err()).to_equal(true)
            expect(result.unwrap_err()).to_contain("unsupported config field 'runtime_path'")
        )

    it "names retained_symbols as unsupported - the engine has no GC-root input to honour them with":
        # @req REQ-LINKER-F1-INTERNAL-BOOTSTRAP-CONFIG
        step("retained_symbols is the remaining hard reject on the real bootstrap link config: ElfLinkRequest has only `entry`, no extra-roots field, so a retained symbol living in an otherwise-unneeded archive member would be dropped by the fixpoint")
        with_env("SIMPLE_LINKER", "internal", fn():
            var cfg = NativeLinkConfig.default()
            cfg.retained_symbols = ["spl_init_args"]
            val result = link_to_native([HELLO_A64_OBJ],
                "/tmp/native_linking_internal_spec_retained_out", cfg)
            expect(result.is_err()).to_equal(true)
            expect(result.unwrap_err()).to_contain("unsupported config field 'retained_symbols'")
        )

describe "native_linking - internal engine DT_NEEDED parity with ld.lld on an ld-script library":
    # Lane F1. Found by comparing the internal output against ld.lld rather
    # than by reading the code: the first GROUP() parser also returned the
    # AS_NEEDED() member, because the keyword and its `(` are separated by
    # whitespace in glibc's own script. `-lm` then recorded
    # DT_NEEDED libmvec.so.1, which ld.lld does not emit -- this engine writes
    # one DT_NEEDED per shared input unconditionally, so an AS_NEEDED member
    # must never become one.
    it "records DT_NEEDED for libm.so.6 and libc.so.6 only, never the AS_NEEDED member":
        # @req REQ-LINKER-F1-INTERNAL-LIBRARY-SEARCH
        step("libraries=[m] -> DT_NEEDED set matches ld.lld: libc.so.6 + libm.so.6, no libmvec.so.1")
        with_env("SIMPLE_LINKER", "internal", fn():
            val out = "/tmp/native_linking_internal_spec_libm_needed"
            var cfg = NativeLinkConfig.default()
            cfg.libraries = ["m"]
            expect(link_to_native([LIBM_A64_OBJ], out, cfg).is_ok()).to_equal(true)
            val needed = shell("readelf -dW '{out}' | grep NEEDED")
            expect(needed.stdout).to_contain("libc.so.6")
            expect(needed.stdout).to_contain("libm.so.6")
            expect(needed.stdout.contains("libmvec")).to_equal(false)
        )

    it "does not duplicate DT_NEEDED when a library search name resolves to the implicit libc":
        # @req REQ-LINKER-F1-INTERNAL-LIBRARY-SEARCH
        step("libraries=[c] resolves libc.so's GROUP() to the same libc.so.6 the engine already adds implicitly; exactly one DT_NEEDED libc.so.6, as ld.lld emits")
        with_env("SIMPLE_LINKER", "internal", fn():
            val out = "/tmp/native_linking_internal_spec_libc_dedup"
            var cfg = NativeLinkConfig.default()
            cfg.libraries = ["c"]
            expect(link_to_native([HELLO_A64_OBJ], out, cfg).is_ok()).to_equal(true)
            val needed = shell("readelf -dW '{out}' | grep -c 'libc.so.6'")
            expect(needed.stdout.trim()).to_equal("1")
            val run = shell("'{out}'")
            expect(run.exit_code).to_equal(42)
        )
