use std.spec.*
use compiler.backend.linker.coff.coff_object.{coff_parse_object}
use compiler.backend.linker.coff.archive_closure.{
    coff_archive_members, coff_archive_closure}

fn _ca_ascii(bytes: [u8], value: text, width: i64) -> [u8]:
    var result = bytes
    var i: i64 = 0
    while i < width:
        result = result.push((if i < value.len(): value.byte_at(i) else: 0x20) as u8)
        i = i + 1
    result

fn _ca_u16(bytes: [u8], value: i64) -> [u8]:
    bytes.push((value & 0xff) as u8).push(((value >> 8) & 0xff) as u8)

fn _ca_u32(bytes: [u8], value: i64) -> [u8]:
    bytes.push((value & 0xff) as u8).push(((value >> 8) & 0xff) as u8)
        .push(((value >> 16) & 0xff) as u8).push(((value >> 24) & 0xff) as u8)

fn _ca_name(bytes: [u8], value: text) -> [u8]:
    var result = bytes
    var i: i64 = 0
    while i < 8:
        result = result.push((if i < value.len(): value.byte_at(i) else: 0) as u8)
        i = i + 1
    result

fn _ca_object(symbol: text, section: i64, machine: i64 = 0x8664) -> [u8]:
    var bytes: [u8] = []
    bytes = _ca_u16(bytes, machine)
    bytes = _ca_u16(bytes, 1)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 61)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_name(bytes, ".text")
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u32(bytes, 60)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u32(bytes, 0x60000020)
    bytes = bytes.push(0xc3)
    bytes = _ca_name(bytes, symbol)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, section)
    bytes = _ca_u16(bytes, 0x20)
    bytes = bytes.push(2).push(0)
    _ca_u32(bytes, 4)

fn _ca_bigobj(symbol: text) -> [u8]:
    var bytes: [u8] = []
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0xffff)
    bytes = _ca_u16(bytes, 2)
    bytes = _ca_u16(bytes, 0x8664)
    bytes = _ca_u32(bytes, 0)
    val magic: [i64] = [
        0xc7, 0xa1, 0xba, 0xd1, 0xee, 0xba, 0xa9, 0x4b,
        0xaf, 0x20, 0xfa, 0xf6, 0x6a, 0xa4, 0xdc, 0xb8]
    for byte in magic: bytes = bytes.push(byte as u8)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u32(bytes, 97)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_name(bytes, ".text")
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u32(bytes, 96)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u32(bytes, 0x60000020)
    bytes = bytes.push(0xc3)
    bytes = _ca_name(bytes, symbol)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u16(bytes, 0x20)
    bytes = bytes.push(2).push(0)
    _ca_u32(bytes, 4)

fn _ca_long_symbol_object(symbol: text) -> [u8]:
    var bytes: [u8] = []
    bytes = _ca_u16(bytes, 0x8664)
    bytes = _ca_u16(bytes, 1)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 61)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_name(bytes, ".rdata")
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 1)
    bytes = _ca_u32(bytes, 60)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u32(bytes, 0x40000040)
    bytes = bytes.push(0)
    bytes = _ca_u32(bytes, 0).push(4).push(0).push(0).push(0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, 1)
    bytes = _ca_u16(bytes, 0)
    bytes = bytes.push(2).push(0)
    bytes = _ca_u32(bytes, symbol.len() + 5)
    var index: i64 = 0
    while index < symbol.len():
        bytes = bytes.push(symbol.byte_at(index) as u8)
        index = index + 1
    bytes.push(0)

fn _ca_weak_object(policy: i64) -> [u8]:
    var bytes: [u8] = []
    bytes = _ca_u16(bytes, 0x8664)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u32(bytes, 20)
    bytes = _ca_u32(bytes, 3)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_name(bytes, "weak")
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = bytes.push(105).push(1)
    bytes = _ca_u32(bytes, 2)
    bytes = _ca_u32(bytes, policy)
    bytes = _ca_name(bytes, "").push(0).push(0)
    bytes = _ca_name(bytes, "strong")
    bytes = _ca_u32(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = _ca_u16(bytes, 0)
    bytes = bytes.push(2).push(0)
    _ca_u32(bytes, 4)

fn _ca_archive(name: text, member: [u8]) -> [u8]:
    var bytes: [u8] = []
    bytes = _ca_ascii(bytes, "!<arch>\n", 8)
    bytes = _ca_ascii(bytes, name + "/", 16)
    bytes = _ca_ascii(bytes, "0", 12)
    bytes = _ca_ascii(bytes, "0", 6)
    bytes = _ca_ascii(bytes, "0", 6)
    bytes = _ca_ascii(bytes, "100644", 8)
    bytes = _ca_ascii(bytes, member.len().to_text(), 10)
    bytes = bytes.push(0x60).push(0x0a)
    for b in member: bytes = bytes.push(b)
    if member.len() % 2 != 0: bytes = bytes.push(0x0a)
    bytes

describe "COFF archive closure":
    it "decodes ordinary AMD64 members from an MSVC-style library container":
        val members = coff_archive_members([_ca_archive("provider.obj", _ca_object("foo", 1))])
        expect(members.is_ok()).to_equal(true)
        expect(members.unwrap().len()).to_equal(1)
        expect(members.unwrap()[0].name).to_equal("provider.obj")

    it "decodes ordinary ARM64 members from an MSVC-style library container":
        val members = coff_archive_members([
            _ca_archive("provider.obj", _ca_object("foo", 1, 0xaa64))])
        expect(members.is_ok()).to_equal(true)
        expect(members.unwrap().len()).to_equal(1)
        expect(members.unwrap()[0].object.machine).to_equal(0xaa64)

    it "admits bigobj members instead of skipping them as machine zero":
        val members = coff_archive_members([
            _ca_archive("provider.obj", _ca_bigobj("foo"))])
        expect(members.is_ok()).to_equal(true)
        expect(members.unwrap().len()).to_equal(1)
        expect(members.unwrap()[0].object.symbols[0].name).to_equal("foo")
        val root = coff_parse_object(_ca_object("foo", 0)).unwrap()
        val closure = coff_archive_closure([root], [
            _ca_archive("provider.obj", _ca_bigobj("foo"))])
        expect(closure.is_ok()).to_equal(true)
        expect(closure.unwrap().members.len()).to_equal(1)

    it "extracts a member that resolves a root external":
        val root = coff_parse_object(_ca_object("foo", 0)).unwrap()
        val closure = coff_archive_closure([root], [_ca_archive("provider.obj", _ca_object("foo", 1))])
        expect(closure.is_ok()).to_equal(true)
        expect(closure.unwrap().members.len()).to_equal(1)
        expect(closure.unwrap().passes).to_equal(1)

    it "does not extract an unrelated member":
        val root = coff_parse_object(_ca_object("foo", 0)).unwrap()
        val closure = coff_archive_closure([root], [_ca_archive("other.obj", _ca_object("bar", 1))])
        expect(closure.is_ok()).to_equal(true)
        expect(closure.unwrap().members.len()).to_equal(0)

    it "honors weak external library-search policy during extraction":
        val no_library = coff_archive_closure(
            [coff_parse_object(_ca_weak_object(1)).unwrap()], [
                _ca_archive("weak.obj", _ca_object("weak", 1)),
                _ca_archive("strong.obj", _ca_object("strong", 1))]).unwrap()
        expect(no_library.members.len()).to_equal(1)
        expect(no_library.members[0].name).to_equal("strong.obj")

        val search_library = coff_archive_closure(
            [coff_parse_object(_ca_weak_object(2)).unwrap()], [
                _ca_archive("weak.obj", _ca_object("weak", 1)),
                _ca_archive("strong.obj", _ca_object("strong", 1))]).unwrap()
        expect(search_library.members.len()).to_equal(1)
        expect(search_library.members[0].name).to_equal("weak.obj")

    it "extracts CRT loader metadata symbols when archives provide them":
        val root = coff_parse_object(_ca_object("_start", 1)).unwrap()
        val closure = coff_archive_closure([root], [
            _ca_archive("tls.obj", _ca_long_symbol_object("_tls_used")),
            _ca_archive("loadcfg.obj",
                _ca_long_symbol_object("_load_config_used"))]).unwrap()
        expect(closure.members.len()).to_equal(2)
        expect(closure.members[0].name).to_equal("tls.obj")
        expect(closure.members[1].name).to_equal("loadcfg.obj")
