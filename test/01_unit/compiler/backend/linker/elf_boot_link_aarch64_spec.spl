# elf_boot_link — aarch64 SimpleOS kernel-style link (fs_exec_linker.ld)
#
# Fixtures: test/fixtures/linker/elf/aarch64_boot/{start_a64,lib_a64}.{S,o},
# assembled with clang --target=aarch64-none-elf. Together they carry
# R_AARCH64_ABS64, CALL26, JUMP26, ADR_PREL_PG_HI21, ADD_ABS_LO12_NC,
# LDST8/16/32/64/128_ABS_LO12_NC and PREL32. The script is the real arm64
# kernel script (MEMORY, KEEP, ALIGN inside a section, NOLOAD, INCLUDE of the
# common arm script, `. += 8M`). Every expected byte and address below is
# `ld.lld --no-relax -T fs_exec_linker.ld` (LLVM 21, Windows) on the same two
# objects. --no-relax because ld.lld otherwise rewrites an in-range ADRP+ADD
# pair into NOP+ADR; elf_boot_link does not relax.
#
# @cover src/compiler/70.backend/linker/elf/elf_boot_link.spl

use compiler.backend.linker.elf.elf_boot_link.{ElfBootImage, elf_boot_link_image}
use compiler.backend.linker.boot_layout.boot_layout_plan.{BootLayoutPlan, boot_layout_from_file}
use compiler.backend.linker.reloc_engine.{RelocArch}
use std.io_runtime.{file_read_bytes}

val A64_FIX: text = "test/fixtures/linker/elf/aarch64_boot"
val A64_LDS: text = "examples/09_embedded/simple_os/arch/arm64/fs_exec_linker.ld"

# .text @0x40200000, bytes 0..0x2c: adrp/add/mov/bl/adrp/ldrb/ldrh/ldr w/ldr x/ldr q/b
val LLD_A64_ENTRY: [i64] = [0x20, 0x40, 0x00, 0x90, 0x00, 0x00, 0x01, 0x91, 0x1f, 0x00, 0x00, 0x91, 0xfe, 0x01, 0x00, 0x94, 0x01, 0x00, 0x00, 0xf0, 0x22, 0x88, 0x40, 0x39, 0x23, 0x40, 0x40, 0x79, 0x24, 0x18, 0x40, 0xb9, 0x25, 0x08, 0x40, 0xf9, 0x26, 0x00, 0xc0, 0x3d, 0xfa, 0x01, 0x00, 0x14]
# .text @0x40200800: vectors (b _start), lib_fn (adrp/add/ret), lib_tail (b .)
val LLD_A64_VEC: [i64] = [0x00, 0xfe, 0xff, 0x17, 0x00, 0x00, 0x00, 0xb0, 0x00, 0x00, 0x00, 0x91, 0xc0, 0x03, 0x5f, 0xd6, 0x00, 0x00, 0x00, 0x14]
val LLD_A64_DATA: [i64] = [0x11, 0x11, 0, 0, 0, 0, 0, 0, 0x22, 0x22, 0, 0, 0, 0, 0, 0, 0x04, 0x08, 0x20, 0x40, 0, 0, 0, 0, 0x07, 0, 0, 0, 0xe4, 0xdf, 0xff, 0xff, 0x03, 0x00, 0x09, 0, 0, 0, 0, 0, 0x08, 0x00, 0x20, 0x40, 0, 0, 0, 0]

fn a6_load(name: text) -> [i64]:
    val raw = file_read_bytes("{A64_FIX}/{name}")
    var out: [i64] = []
    var i: i64 = 0
    while i < raw.len():
        out = out.push(raw[i] as i64)
        i = i + 1
    out

fn a6_u16(b: [i64], off: i64) -> i64:
    b[off] | (b[off + 1] << 8)

fn a6_u32(b: [i64], off: i64) -> i64:
    a6_u16(b, off) | (a6_u16(b, off + 2) << 16)

fn a6_u64(b: [i64], off: i64) -> i64:
    a6_u32(b, off) | (a6_u32(b, off + 4) << 32)

fn a6_img() -> ElfBootImage:
    val plan = boot_layout_from_file(A64_LDS, []).unwrap()
    elf_boot_link_image([a6_load("start_a64.o"), a6_load("lib_a64.o")], plan, RelocArch.AArch64).unwrap()

fn a6_vma(im: ElfBootImage, name: text) -> i64:
    var i: i64 = 0
    while i < im.sec_names.len():
        if im.sec_names[i] == name:
            return im.sec_vmas[i]
        i = i + 1
    -1

fn a6_sym(im: ElfBootImage, name: text) -> i64:
    var i: i64 = 0
    while i < im.sym_names.len():
        if im.sym_names[i] == name:
            return im.sym_values[i]
        i = i + 1
    -1

fn a6_at(im: ElfBootImage, vma: i64, n: i64) -> [i64]:
    """Bytes at virtual address `vma`, located through the PT_LOAD headers."""
    val phoff = a6_u64(im.bytes, 32)
    val phnum = a6_u16(im.bytes, 56)
    var i: i64 = 0
    while i < phnum:
        val ph = phoff + i * 56
        val va = a6_u64(im.bytes, ph + 16)
        if a6_u32(im.bytes, ph) == 1 and va <= vma and vma + n <= va + a6_u64(im.bytes, ph + 32):
            val off = a6_u64(im.bytes, ph + 8) + vma - va
            var out: [i64] = []
            var k: i64 = 0
            while k < n:
                out = out.push(im.bytes[off + k])
                k = k + 1
            return out
        i = i + 1
    []

describe "elf_boot_link - aarch64 kernel script":
    it "writes an EM_AARCH64 ELF64 header with the script entry":
        val im = a6_img()
        expect(im.bytes[4]).to_equal(2)
        expect(a6_u16(im.bytes, 18)).to_equal(183)
        expect(im.entry).to_equal(0x40200000)
        expect(a6_u64(im.bytes, 24)).to_equal(0x40200000)

    it "places the fs_exec_linker.ld sections at the ld.lld addresses":
        val im = a6_img()
        expect(a6_vma(im, ".text")).to_equal(0x40200000)
        expect(a6_vma(im, ".rodata")).to_equal(0x40201000)
        expect(a6_vma(im, ".simple_sandbox")).to_equal(0x40202000)
        expect(a6_vma(im, ".data")).to_equal(0x40203000)
        expect(a6_vma(im, ".bss")).to_equal(0x40204000)
        expect(a6_vma(im, ".stack")).to_equal(0x40204040)
        expect(a6_vma(im, ".heap")).to_equal(0x40a05000)

    it "binds the script symbols like ld.lld":
        val im = a6_img()
        expect(a6_sym(im, "vectors")).to_equal(0x40200800)
        expect(a6_sym(im, "__simple_sandbox_start")).to_equal(0x40202000)
        expect(a6_sym(im, "__simple_sandbox_end")).to_equal(0x40202008)
        expect(a6_sym(im, "_kernel_load_end")).to_equal(0x40203030)
        expect(a6_sym(im, "_ebss")).to_equal(0x40204040)
        expect(a6_sym(im, "_stack_top")).to_equal(0x40a04040)
        expect(a6_sym(im, "_kernel_end")).to_equal(0x44a05000)
        expect(a6_sym(im, "_image_size")).to_equal(0x4805000)

    it "applies ADR_PREL_PG_HI21, ADD/LDST8..128_ABS_LO12_NC, CALL26 and JUMP26 like ld.lld":
        val im = a6_img()
        expect(a6_at(im, 0x40200000, LLD_A64_ENTRY.len())).to_equal(LLD_A64_ENTRY)

    it "applies backward JUMP26 into .text.vectors and the library ADRP+ADD":
        val im = a6_img()
        expect(a6_at(im, 0x40200800, LLD_A64_VEC.len())).to_equal(LLD_A64_VEC)

    it "applies ABS64 and PREL32 in .data like ld.lld":
        val im = a6_img()
        expect(a6_at(im, 0x40203000, LLD_A64_DATA.len())).to_equal(LLD_A64_DATA)

    it "emits PT_LOADs at ld.lld's 64 KiB-congruent offsets":
        val im = a6_img()
        val phoff = a6_u64(im.bytes, 32)
        var text_off: i64 = -1
        var data_mem: i64 = -1
        var i: i64 = 0
        while i < a6_u16(im.bytes, 56):
            val ph = phoff + i * 56
            if a6_u32(im.bytes, ph) == 1:
                val va = a6_u64(im.bytes, ph + 16)
                if va == 0x40200000:
                    text_off = a6_u64(im.bytes, ph + 8)
                if va == 0x40203000:
                    data_mem = a6_u64(im.bytes, ph + 40)
            i = i + 1
        expect(text_off).to_equal(0x10000)
        expect(data_mem).to_equal(75505664)

    it "keeps SHF_MERGE string bytes and points ADRP+ADD at them like ld.lld":
        # Kernel regression: objects reach elf_boot_link as [i64] bytes, and the
        # merge pool used to come out empty, so every .rodata.str1.1 reference
        # in _boot_baremetal_stubs.o resolved to one wrong address.
        val plan = boot_layout_from_file(A64_LDS, []).unwrap()
        val im = elf_boot_link_image([a6_load("str_a64.o")], plan, RelocArch.AArch64).unwrap()
        expect(a6_vma(im, ".rodata")).to_equal(0x40201000)
        expect(a6_at(im, 0x40201000, 13)).to_equal([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0, 0x77, 0x6f, 0x72, 0x6c, 0x64, 0x21, 0])
        expect(a6_at(im, 0x40200000, 20)).to_equal([0x00, 0x00, 0x00, 0xb0, 0x00, 0x00, 0x00, 0x91, 0x01, 0x00, 0x00, 0xb0, 0x21, 0x18, 0x00, 0x91, 0xfc, 0xff, 0xff, 0x17])
