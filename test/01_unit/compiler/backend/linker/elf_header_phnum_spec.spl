# ELF header parsing exposes e_phnum for ELF64 (offset 56) and ELF32 (offset 44).
use std.spec.*
use compiler.backend.linker.elf_inspect.{elf_parse_header}

fn phnum_header(class_byte: i64, phnum_offset: i64, phnum: i64) -> [u8]:
    var bytes: [u8] = []
    for i in 0..64: bytes = bytes.push(0 as u8)
    bytes[0] = 0x7f as u8
    bytes[1] = 0x45 as u8
    bytes[2] = 0x4c as u8
    bytes[3] = 0x46 as u8
    bytes[4] = class_byte as u8
    bytes[5] = 1 as u8
    bytes[phnum_offset] = (phnum % 256) as u8
    bytes[phnum_offset + 1] = (phnum / 256) as u8
    bytes

describe "ELF header e_phnum":
    it "reads e_phnum from an ELF64 header":
        val parsed = elf_parse_header(phnum_header(2, 56, 3))
        expect(parsed.is_ok()).to_equal(true)
        expect(parsed.unwrap().e_phnum).to_equal(3)

    it "reads e_phnum from an ELF32 header":
        val parsed = elf_parse_header(phnum_header(1, 44, 300))
        expect(parsed.is_ok()).to_equal(true)
        expect(parsed.unwrap().e_phnum).to_equal(300)
