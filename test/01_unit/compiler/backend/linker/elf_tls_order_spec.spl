# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Repro: an unnamed RW section (.igot.plt) sorted between .tdata and .tbss,
# splitting the PT_TLS block; armv7 static glibc then SIGSEGVed at startup
# (bug simple_linker_tls_block_split_2026-11-18).

use compiler.backend.linker.elf.elf_exec_writer.{elf_out_sec, ELF_SEG_RW}
use compiler.backend.linker.elf.elf_static_link.{elf_sort_outs}

describe "RW output section order":
    it "keeps .tdata and .tbss adjacent when another RW section follows .tdata":
        val tdata = elf_out_sec(".tdata", 1, 0x403, 4, 16, ELF_SEG_RW)
        val igot = elf_out_sec(".igot.plt", 1, 3, 4, 8, ELF_SEG_RW)
        val tbss = elf_out_sec(".tbss", 8, 0x403, 4, 32, ELF_SEG_RW)
        val bss = elf_out_sec(".bss", 8, 3, 8, 64, ELF_SEG_RW)
        val out = elf_sort_outs([tdata, igot, tbss, bss])
        var names: [text] = []
        for s in out:
            names.push(s.name)
        expect(names).to_equal([".igot.plt", ".tdata", ".tbss", ".bss"])
