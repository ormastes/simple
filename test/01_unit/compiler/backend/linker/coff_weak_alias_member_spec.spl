# SEARCH_ALIAS weak externals in archive members (oldnames.lib).
#
# oldnames.lib's mkdir.obj carries only a weak external `__imp_mkdir` whose
# default is `__imp__mkdir` (IMAGE_WEAK_EXTERN_SEARCH_ALIAS). lld-link lists
# that name in the archive index, selects the member, and resolves the
# reference through the alias. The internal engine never counted a weak
# external as an archive definition, so the hosted runtime's POSIX calls
# failed with "unresolved external COFF symbol '__imp_mkdir'".

use std.spec.*
use compiler.backend.linker.coff.coff_link.{CoffLinkRequest, coff_link_amd64}
use compiler.backend.linker.pe_inspect.{pe_inspect}

fn _cl_u16(bytes: [u8], value: i64) -> [u8]:
    var result = bytes.push((value & 0xff) as u8)
    result.push(((value >> 8) & 0xff) as u8)

fn _cl_u32(bytes: [u8], value: i64) -> [u8]:
    var result = bytes.push((value & 0xff) as u8)
    result = result.push(((value >> 8) & 0xff) as u8)
    result = result.push(((value >> 16) & 0xff) as u8)
    result.push(((value >> 24) & 0xff) as u8)

fn _cl_name(bytes: [u8], value: text) -> [u8]:
    var result = bytes
    var i: i64 = 0
    while i < 8:
        result = result.push((if i < value.len(): value.byte_at(i) else: 0) as u8)
        i = i + 1
    result

fn _cl_object(symbol_name: text, section_number: i64) -> [u8]:
    # Header 20 + section 40 + one-byte RET + symbol 18 + string table.
    var bytes: [u8] = []
    bytes = _cl_u16(bytes, 0x8664)
    bytes = _cl_u16(bytes, 1)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 61)
    bytes = _cl_u32(bytes, 1)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_name(bytes, ".text")
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 1)
    bytes = _cl_u32(bytes, 60)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u32(bytes, 0x60000020)
    bytes = bytes.push(0xc3)
    # Names longer than eight bytes live in the string table at offset 4.
    val long_name = symbol_name.len() > 8
    if long_name:
        bytes = _cl_u32(bytes, 0)
        bytes = _cl_u32(bytes, 4)
    else:
        bytes = _cl_name(bytes, symbol_name)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, section_number)
    bytes = _cl_u16(bytes, 0x20)
    bytes = bytes.push(2)
    bytes = bytes.push(0)
    if not long_name: return _cl_u32(bytes, 4)
    bytes = _cl_u32(bytes, 4 + symbol_name.len() + 1)
    var ni: i64 = 0
    while ni < symbol_name.len():
        bytes = bytes.push(symbol_name.byte_at(ni) as u8)
        ni = ni + 1
    bytes.push(0)

fn _cl_ascii(bytes: [u8], value: text, width: i64) -> [u8]:
    var result = bytes
    var i: i64 = 0
    while i < width:
        result = result.push((if i < value.len(): value.byte_at(i) else: 0x20) as u8)
        i = i + 1
    result

fn _cl_archive(member: [u8]) -> [u8]:
    var bytes: [u8] = []
    bytes = _cl_ascii(bytes, "!<arch>\n", 8)
    bytes = _cl_ascii(bytes, "exit.obj/", 16)
    bytes = _cl_ascii(bytes, "0", 12)
    bytes = _cl_ascii(bytes, "0", 6)
    bytes = _cl_ascii(bytes, "0", 6)
    bytes = _cl_ascii(bytes, "100644", 8)
    bytes = _cl_ascii(bytes, member.len().to_text(), 10)
    bytes = bytes.push(0x60).push(0x0a)
    var mi: i64 = 0
    while mi < member.len():
        bytes = bytes.push(member[mi])
        mi = mi + 1
    if member.len() % 2 != 0: bytes = bytes.push(0x0a)
    bytes

fn _cl_ref_object(defined: text, referenced: text) -> [u8]:
    # One RET section; `defined` is defined there and `referenced` is undefined.
    var bytes: [u8] = []
    bytes = _cl_u16(bytes, 0x8664)
    bytes = _cl_u16(bytes, 1)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 61)
    bytes = _cl_u32(bytes, 2)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_name(bytes, ".text")
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 1)
    bytes = _cl_u32(bytes, 60)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u32(bytes, 0x60000020)
    bytes = bytes.push(0xc3)
    bytes = _cl_name(bytes, defined)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 1)
    bytes = _cl_u16(bytes, 0x20)
    bytes = bytes.push(2)
    bytes = bytes.push(0)
    bytes = _cl_name(bytes, referenced)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0x20)
    bytes = bytes.push(2)
    bytes = bytes.push(0)
    _cl_u32(bytes, 4)

fn _cl_weak_alias_object(alias: text, target: text, machine: i64) -> [u8]:
    # No sections: weak external `alias` (one aux record, SEARCH_ALIAS) whose
    # default is the undefined external `target` at symbol index 2.
    var bytes: [u8] = []
    bytes = _cl_u16(bytes, machine)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 20)
    bytes = _cl_u32(bytes, 3)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_name(bytes, alias)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = bytes.push(105)
    bytes = bytes.push(1)
    bytes = _cl_u32(bytes, 2)
    bytes = _cl_u32(bytes, 3)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_name(bytes, target)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = bytes.push(2)
    bytes = bytes.push(0)
    _cl_u32(bytes, 4)

fn _cl_weak_def_object(alias: text, target: text) -> [u8]:
    # clang `weak` definition: one RET section, weak external `alias`
    # (SEARCH_ALIAS) whose default is the external `target` defined there.
    var bytes: [u8] = []
    bytes = _cl_u16(bytes, 0x8664)
    bytes = _cl_u16(bytes, 1)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 61)
    bytes = _cl_u32(bytes, 3)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_name(bytes, ".text")
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 1)
    bytes = _cl_u32(bytes, 60)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u32(bytes, 0x60000020)
    bytes = bytes.push(0xc3)
    bytes = _cl_name(bytes, alias)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = bytes.push(105)
    bytes = bytes.push(1)
    bytes = _cl_u32(bytes, 2)
    bytes = _cl_u32(bytes, 3)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 0)
    bytes = _cl_name(bytes, target)
    bytes = _cl_u32(bytes, 0)
    bytes = _cl_u16(bytes, 1)
    bytes = _cl_u16(bytes, 0x20)
    bytes = bytes.push(2)
    bytes = bytes.push(0)
    _cl_u32(bytes, 4)

describe "COFF weak alias archive members":
    it "selects a SEARCH_ALIAS member and resolves the reference through it":
        val linked = coff_link_amd64(CoffLinkRequest(
            objects: [_cl_ref_object("_start", "mkdir")],
            archives: [_cl_archive(_cl_weak_alias_object("mkdir", "_mkdir", 0x8664)),
                _cl_archive(_cl_object("_mkdir", 1))], entry: "_start"))
        if linked.is_err(): print("link error: {linked.unwrap_err()}")
        expect(linked.is_ok()).to_equal(true)
        val inspected = pe_inspect(linked.unwrap()).unwrap()
        expect(inspected.sections[0].virtual_size).to_equal(2)

    it "accepts a machine-neutral (IMAGE_FILE_MACHINE_UNKNOWN) alias member":
        # oldnames.lib alias objects carry machine 0, as llvm-readobj reports.
        val linked = coff_link_amd64(CoffLinkRequest(
            objects: [_cl_ref_object("_start", "mkdir")],
            archives: [_cl_archive(_cl_weak_alias_object("mkdir", "_mkdir", 0)),
                _cl_archive(_cl_object("_mkdir", 1))], entry: "_start"))
        if linked.is_err(): print("link error: {linked.unwrap_err()}")
        expect(linked.is_ok()).to_equal(true)

    it "resolves another object's reference through an input object's weak alias":
        # Hosted runtime: simple_entry.obj references spl_init_args, which
        # runtime_native.obj provides only as a clang weak definition.
        val linked = coff_link_amd64(CoffLinkRequest(
            objects: [_cl_ref_object("_start", "wfn"), _cl_weak_def_object("wfn", "wfn_def")],
            archives: [], entry: "_start"))
        if linked.is_err(): print("link error: {linked.unwrap_err()}")
        expect(linked.is_ok()).to_equal(true)
