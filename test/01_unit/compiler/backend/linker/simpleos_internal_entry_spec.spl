# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

# SimpleOS x86_64 user link through the internal ELF engine
# (doc/03_plan/compiler/linker/mold_mdsocpp_linker_plan_2026-09-18.md,
# doc/03_plan/os/simpleos/simpleos_selfhost_seed_linker_plan_2026-10-04.md G4).
#
# Regression (measured 2026-10-05): `SIMPLE_LINKER=internal native-build
# --target x86_64-unknown-simpleos` failed with "internal engine: entry symbol
# not defined: _start" although crt0.o defines `T _start`. Root cause: the ELF
# symbol parser read st_info/st_other with the inline form
# `if c: bytes[i] as i64 else: bytes[j] as i64`, which the compiler
# miscompiles (the else arm is lost), so every ELF64 symbol came back with
# binding LOCAL and no global ever entered the resolver's defined table.
#
# @cover src/compiler/70.backend/linker/elf_parser.spl
# @cover src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl

use std.spec.*

use compiler.backend.linker.linker_wrapper.{link_simpleos_internal, NativeLinkConfig}
use compiler.backend.linker.elf_parser.{elf_parse_object, elf_symbol_binding, STB_GLOBAL}
use std.io_runtime.{file_read_bytes}

val FIX: text = "test/fixtures/linker/simpleos"

fn _u64_le(bytes: [u8], at: i64) -> i64:
    var v: i64 = 0
    var i: i64 = 7
    while i >= 0:
        v = (v << 8) | (bytes[at + i] as i64)
        i = i - 1
    v

fn _binding_of(path: text, name: text) -> i64:
    val obj = elf_parse_object(file_read_bytes(path)).unwrap()
    var binding: i64 = -1
    for sym in obj.symbols:
        if sym.name == name:
            binding = elf_symbol_binding(sym)
    binding

describe "SimpleOS x86_64 user link - internal ELF engine":
    it "parses a crt0 GLOBAL _start as STB_GLOBAL":
        expect(_binding_of("{FIX}/crt0_x64.o", "_start")).to_equal(STB_GLOBAL)
        expect(_binding_of("{FIX}/main_x64.o", "main")).to_equal(STB_GLOBAL)

    it "links crt0 + main with the sysroot script and enters at _start":
        var cfg = NativeLinkConfig.default()
        cfg.runtime_path = "none"
        cfg.pie = false
        cfg.allow_duplicate_definitions = false
        cfg.allow_cc_fallback = false
        cfg.extra_flags = [
            "-T", "{FIX}/simpleos_user.ld", "-nostdlib", "-static",
            "--gc-sections", "--start-group", "--end-group"]
        val out = "/tmp/simpleos_internal_entry_spec.elf"
        val result = link_simpleos_internal(
            ["{FIX}/crt0_x64.o", "{FIX}/main_x64.o"], out, "simpleos-x86_64", cfg)
        if result.is_err():
            print "link error: {result.unwrap_err()}"
        expect(result.is_ok()).to_equal(true)
        val image = file_read_bytes(out)
        # ELF64 x86_64 executable; ld.lld puts e_entry at 0x10000000 (_start
        # is the first .text input under the script's `. = 0x10000000`).
        expect(image[16] as i64).to_equal(2)
        expect(image[18] as i64).to_equal(62)
        expect(_u64_le(image, 24)).to_equal(0x10000000)

describe "SimpleOS aarch64 user link - internal ELF engine":
    it "links aarch64 crt0 + main with the sysroot script like ld.lld":
        var cfg = NativeLinkConfig.default()
        cfg.runtime_path = "none"
        cfg.pie = false
        cfg.allow_duplicate_definitions = false
        cfg.allow_cc_fallback = false
        cfg.extra_flags = [
            "-T", "{FIX}/simpleos_user_a64.ld", "-nostdlib", "-static",
            "--gc-sections", "--start-group", "--end-group"]
        val out = "/tmp/simpleos_internal_entry_spec_a64.elf"
        val result = link_simpleos_internal(
            ["{FIX}/crt0_a64.o", "{FIX}/main_a64.o"], out, "simpleos-aarch64", cfg)
        if result.is_err():
            print "link error: {result.unwrap_err()}"
        expect(result.is_ok()).to_equal(true)
        val image = file_read_bytes(out)
        # ld.lld reference (RECIPE.md): ET_EXEC, EM_AARCH64, entry 0x50000000.
        expect(image[16] as i64).to_equal(2)
        expect(image[18] as i64).to_equal(183)
        expect(_u64_le(image, 24)).to_equal(0x50000000)

describe "SimpleOS riscv64 user link - internal ELF engine":
    it "links riscv64 main with the sysroot script (crt0 via INPUT) like ld.lld":
        var cfg = NativeLinkConfig.default()
        cfg.runtime_path = "none"
        cfg.pie = false
        cfg.allow_duplicate_definitions = false
        cfg.allow_cc_fallback = false
        cfg.extra_flags = [
            "-T", "{FIX}/simpleos_user_rv64.ld", "-nostdlib", "-static",
            "--gc-sections", "--start-group", "--end-group"]
        val out = "/tmp/simpleos_internal_entry_spec_rv64.elf"
        val result = link_simpleos_internal(
            ["{FIX}/main_rv64.o"], out, "simpleos-riscv64", cfg)
        if result.is_err():
            print "link error: {result.unwrap_err()}"
        expect(result.is_ok()).to_equal(true)
        val image = file_read_bytes(out)
        # ld.lld reference (RECIPE.md): ET_EXEC, EM_RISCV, entry 0x100000000.
        expect(image[16] as i64).to_equal(2)
        expect(image[18] as i64).to_equal(243)
        expect(_u64_le(image, 24)).to_equal(0x100000000)

fn _sos_cfg(script: text) -> NativeLinkConfig:
    var cfg = NativeLinkConfig.default()
    cfg.runtime_path = "none"
    cfg.pie = false
    cfg.allow_duplicate_definitions = false
    cfg.allow_cc_fallback = false
    cfg.extra_flags = [
        "-T", script, "-nostdlib", "-static",
        "--gc-sections", "--start-group", "--end-group"]
    cfg

describe "SimpleOS internal link - script INPUT() search path":
    it "finds a bare INPUT() file through the -L library paths like ld.lld":
        var cfg = _sos_cfg("{FIX}/simpleos_user_rv64_bare.ld")
        cfg.library_paths = [FIX]
        val out = "/tmp/simpleos_internal_entry_spec_rv64_bare.elf"
        val result = link_simpleos_internal(["{FIX}/main_rv64.o"], out, "simpleos-riscv64", cfg)
        if result.is_err():
            print "link error: {result.unwrap_err()}"
        expect(result.is_ok()).to_equal(true)
        val image = file_read_bytes(out)
        expect(image[18] as i64).to_equal(243)
        expect(_u64_le(image, 24)).to_equal(0x100000000)

    it "fails closed when a bare INPUT() file is on no search path":
        val result = link_simpleos_internal(["{FIX}/main_rv64.o"],
            "/tmp/simpleos_internal_entry_spec_rv64_bare_miss.elf", "simpleos-riscv64",
            _sos_cfg("{FIX}/simpleos_user_rv64_bare.ld"))
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err().contains("crt0_rv64.o")).to_equal(true)

describe "SimpleOS internal link - runtime static archive":
    it "pulls main from a -l archive found on the library paths like ld.lld":
        var cfg = _sos_cfg("{FIX}/simpleos_user.ld")
        cfg.libraries = ["sosmain"]
        cfg.library_paths = [FIX]
        val out = "/tmp/simpleos_internal_entry_spec_archive.elf"
        val result = link_simpleos_internal(["{FIX}/crt0_x64.o"], out, "simpleos-x86_64", cfg)
        if result.is_err():
            print "link error: {result.unwrap_err()}"
        expect(result.is_ok()).to_equal(true)
        val image = file_read_bytes(out)
        expect(image[18] as i64).to_equal(62)
        expect(_u64_le(image, 24)).to_equal(0x10000000)

    it "fails when the archive that defines main is not linked":
        val result = link_simpleos_internal(["{FIX}/crt0_x64.o"],
            "/tmp/simpleos_internal_entry_spec_archive_miss.elf", "simpleos-x86_64",
            _sos_cfg("{FIX}/simpleos_user.ld"))
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err().contains("main")).to_equal(true)
