describe "reloc_engine - RISC-V relocations":
    it "R_RISCV_NONE returns success":
        # @req REQ-SSPEC-COMPILER
        step("R_RISCV_NONE returns success")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_riscv(bytes, 0, R_RISCV_NONE, 0, 0, 0)
        expect(result.success).to_equal(true)

    it "R_RISCV_64 computes S + A":
        # @req REQ-SSPEC-COMPILER
        step("R_RISCV_64 computes S + A")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = reloc_apply_riscv(bytes, 0, R_RISCV_64, 0x80000000, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x80000000)

    it "R_RISCV_HI20 computes (S + A + 0x800) >> 12":
        # @req REQ-SSPEC-COMPILER
        step("R_RISCV_HI20 computes (S + A + 0x800) >> 12")
        # 0x12345678 + 0x800 = 0x12345E78, >> 12 = 0x12345
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_riscv(bytes, 0, R_RISCV_HI20, 0x12345678, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x12345)

    it "R_RISCV_LO12_I computes S + A masked to 12 bits":
        # @req REQ-SSPEC-COMPILER
        step("R_RISCV_LO12_I computes S + A masked to 12 bits")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_riscv(bytes, 0, R_RISCV_LO12_I, 0x12345678, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x678)

# ============================================================================
# Unified dispatch
# ============================================================================

describe "reloc_engine - unified dispatch":
    it "reloc_apply with X86_64 arch matches reloc_apply_x86_64":
        # @req REQ-SSPEC-COMPILER
        step("reloc_apply with X86_64 arch matches reloc_apply_x86_64")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val direct = reloc_apply_x86_64(bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        val unified = reloc_apply(RelocArch.X86_64, bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        expect(unified.success).to_equal(direct.success)
        expect(unified.value).to_equal(direct.value)

    it "reloc_apply with AArch64 arch matches reloc_apply_aarch64":
        # @req REQ-SSPEC-COMPILER
        step("reloc_apply with AArch64 arch matches reloc_apply_aarch64")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val direct = reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS64, 0x10000, 0, 0)
        val unified = reloc_apply(RelocArch.AArch64, bytes, 0, R_AARCH64_ABS64, 0x10000, 0, 0)
        expect(unified.success).to_equal(direct.success)
        expect(unified.value).to_equal(direct.value)

# ============================================================================
# Byte patching integration
# ============================================================================

describe "reloc_engine - byte patching integration":
    it "R_X86_64_64 reloc value patched as 8 LE bytes at offset":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_64 reloc value patched as 8 LE bytes at offset")
        # reloc_patch_bytes internally uses .set() which requires compiled mode.
        # Verify the same end-to-end semantics by composing reloc_apply + patch_u64_le.
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = reloc_apply(RelocArch.X86_64, bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1008)
        val patched = patch_u64_le(bytes, 0, result.value)
        # 0x1008 in LE: 0x08, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
        expect(patched[0]).to_equal(0x08)
        expect(patched[1]).to_equal(0x10)
        expect(patched[2]).to_equal(0x00)
        expect(patched[3]).to_equal(0x00)
        expect(patched[4]).to_equal(0x00)
        expect(patched[5]).to_equal(0x00)
        expect(patched[6]).to_equal(0x00)
        expect(patched[7]).to_equal(0x00)

    it "R_X86_64_PC32 reloc value patched as 4 LE bytes at offset":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_PC32 reloc value patched as 4 LE bytes at offset")
        # Verify end-to-end via reloc_apply + patch_u32_le (avoids interpreter .set() dispatch issue).
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply(RelocArch.X86_64, bytes, 0, R_X86_64_PC32, 0x2000, 0, 0x1000)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1000)
        val patched = patch_u32_le(bytes, 0, result.value)
        # 0x1000 in LE: 0x00, 0x10, 0x00, 0x00
        expect(patched[0]).to_equal(0x00)
        expect(patched[1]).to_equal(0x10)
        expect(patched[2]).to_equal(0x00)
        expect(patched[3]).to_equal(0x00)

# ============================================================================
# Oracle delegation + reject-not-mask (x86_64 S+A / S+A-P via smf_reloc_compute)
# ============================================================================

describe "reloc_engine - x86_64 reject-not-mask (delegates to smf_reloc_compute)":
    it "R_X86_64_32 out of range rejects (was: silently masked to 32 bits)":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32 out of range rejects (was: silently masked to 32 bits)")
        # s + a = 4294967296 = 2^32, one past the unsigned 32-bit max (4294967295).
        # Before this change: `v & 0xffffffff` silently wrapped this to 0.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_32, 4294967296, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "R_X86_64_32 in range still succeeds with the exact value":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32 in range still succeeds with the exact value")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_32, 4294967295, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(4294967295)

# ============================================================================
# AArch64 page-relative pair: ADRP + ADD/LDR (ADR_PREL_PG_HI21, ADD_ABS_LO12_NC,
# LDST64_ABS_LO12_NC) — hand-derived per the ARM ELF ABI (AAELF64):
#   page delta pages = (Page(S+A) - Page(P)) >> 12, Page(x) = x with low 12
#   bits cleared; immlo = pages[1:0] -> insn[30:29]; immhi = pages[20:2] ->
#   insn[23:5]. ADD's imm12 = (S+A)[11:0] -> insn[21:10]. LDR (64-bit,
#   unsigned offset) scales by the 8-byte access size: imm12 = (S+A)[11:0] >> 3
#   -> insn[21:10].
# ============================================================================

describe "reloc_engine - AArch64 ADR_PREL_PG_HI21 (page delta)":
    it "patches MOVW absolute groups and rejects checked overflow":
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_MOVW_UABS_G1)).to_equal(RC_ABS_NARROW)
        val movz = patch_u32_le([0, 0, 0, 0], 0, 0xd2800000)
        val g0 = reloc_patch_bytes(RelocArch.AArch64, movz, 0,
            R_AARCH64_MOVW_UABS_G0, 0x1234, 0, 0)
        expect(read_u32_le(g0, 0)).to_equal(0xd2824680)
        val g1 = reloc_patch_bytes(RelocArch.AArch64, movz, 0,
            R_AARCH64_MOVW_UABS_G1, 0x56780000, 0, 0)
        expect(read_u32_le(g1, 0)).to_equal(0xd28acf00)
        expect(reloc_apply_aarch64(movz, 0, R_AARCH64_MOVW_UABS_G0,
            0x10000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(movz, 0, R_AARCH64_MOVW_UABS_G0_NC,
            0x123456, 0, 0).value).to_equal(0x3456)
        expect(reloc_apply_aarch64(movz, 0, R_AARCH64_MOVW_UABS_G2,
            0x1000000000000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(movz, 0, R_AARCH64_MOVW_UABS_G3,
            0x1234000000000000, 0, 0).value).to_equal(0x1234)

    it "selects MOVZ or MOVN for checked signed and unsigned MOVW forms":
        val movn = patch_u32_le([0, 0, 0, 0], 0, 0x92800000)
        val unsigned = reloc_patch_bytes(RelocArch.AArch64, movn, 0,
            R_AARCH64_MOVW_UABS_G0, 0x1234, 0, 0)
        expect(read_u32_le(unsigned, 0)).to_equal(0xd2824680)
        val negative = reloc_patch_bytes(RelocArch.AArch64, movn, 0,
            R_AARCH64_MOVW_SABS_G0, -0x1234, 0, 0)
        expect(read_u32_le(negative, 0)).to_equal(0x92824660)
        val positive = reloc_patch_bytes(RelocArch.AArch64, movn, 0,
            R_AARCH64_MOVW_SABS_G1, 0x56780000, 0, 0)
        expect(read_u32_le(positive, 0)).to_equal(0xd28acf00)
        expect(reloc_apply_aarch64(movn, 0, R_AARCH64_MOVW_SABS_G0,
            0x10000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(movn, 0, R_AARCH64_MOVW_SABS_G2,
            -0x1000000000001, 0, 0).success).to_equal(false)

    it "applies checked and NC position-relative MOVW groups":
        val movn = patch_u32_le([0, 0, 0, 0], 0, 0x92800000)
        val positive = reloc_patch_bytes(RelocArch.AArch64, movn, 0,
            R_AARCH64_MOVW_PREL_G0, 0x3234, 0, 0x2000)
        expect(read_u32_le(positive, 0)).to_equal(0xd2824680)
        val negative = reloc_patch_bytes(RelocArch.AArch64, movn, 0,
            R_AARCH64_MOVW_PREL_G0, 0x1000, 0, 0x2000)
        expect(read_u32_le(negative, 0)).to_equal(0x9281ffe0)
        val movk = patch_u32_le([0, 0, 0, 0], 0, 0xf2800000)
        val nc = reloc_patch_bytes(RelocArch.AArch64, movk, 0,
            R_AARCH64_MOVW_PREL_G0_NC, 0x1fff, 0, 0x2000)
        expect(read_u32_le(nc, 0)).to_equal(0xf29fffe0)
        expect(reloc_apply_aarch64(movn, 0, R_AARCH64_MOVW_PREL_G0,
            0x12000, 0, 0x2000).success).to_equal(false)
        expect(reloc_apply_aarch64(movn, 0, R_AARCH64_MOVW_PREL_G1,
            0x100002000, 0, 0x2000).success).to_equal(false)
        expect(reloc_apply_aarch64(movn, 0, R_AARCH64_MOVW_PREL_G2,
            0x1000000002000, 0, 0x2000).success).to_equal(false)
        expect(reloc_apply_aarch64(movn, 0, R_AARCH64_MOVW_PREL_G3,
            0x1234000000002000, 0, 0x2000).value).to_equal(0x1234)
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_MOVW_PREL_G0)).to_equal(RC_PCREL)

    it "LD_PREL_LO19 patches a checked aligned literal-load displacement":
        # @req REQ-SSPEC-COMPILER
        val base: [i64] = [0x00, 0x00, 0x00, 0x58]
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_LD_PREL_LO19, 0x1040, 0, 0x1000)
        expect(read_u32_le(patched, 0)).to_equal(0x58000200)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_LD_PREL_LO19,
            3, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_LD_PREL_LO19,
            1048576, 0, 0).success).to_equal(false)

    it "GOT_LD_PREL19 allocates and patches a checked literal GOT load":
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_GOT_LD_PREL19)).to_equal(RC_GOT)
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x58000003)
        val applied = reloc_apply_aarch64(base, 0,
            R_AARCH64_GOT_LD_PREL19, 0x402000, 0, 0x401000)
        expect(applied.success).to_equal(true)
        expect(applied.value).to_equal(0x400)
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_GOT_LD_PREL19, 0x402000, 0, 0x401000)
        expect(read_u32_le(patched, 0)).to_equal(0x58008003)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_GOT_LD_PREL19,
            0x401002, 0, 0x401000).error).to_contain("R_AARCH64_GOT_LD_PREL19")
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_GOT_LD_PREL19,
            0x501000, 0, 0x401000).error).to_contain("R_AARCH64_GOT_LD_PREL19")

    it "LD64_GOTPAGE_LO15 loads an aligned slot relative to Page(GOT)":
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_LD64_GOTPAGE_LO15)).to_equal(RC_GOT)
        val base = patch_u32_le([0, 0, 0, 0], 0, 0xf9400005)
        val applied = reloc_apply_aarch64(base, 0,
            R_AARCH64_LD64_GOTPAGE_LO15, 0x403ff8, 0, 0x400000)
        expect(applied.success).to_equal(true)
        expect(applied.value).to_equal(0x7ff)
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_LD64_GOTPAGE_LO15, 0x403ff8, 0, 0x400000)
        expect(read_u32_le(patched, 0)).to_equal(0xf95ffc05)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_LD64_GOTPAGE_LO15,
            0x400006, 0, 0x400000).success).to_equal(false)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_LD64_GOTPAGE_LO15,
            0x408000, 0, 0x400000).success).to_equal(false)

    it "LD64_GOTOFF_LO15 loads an aligned slot relative to the exact GOT base":
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_LD64_GOTOFF_LO15)).to_equal(RC_GOT)
        val base = patch_u32_le([0, 0, 0, 0], 0, 0xf9400005)
        val applied = reloc_apply_aarch64(base, 0,
            R_AARCH64_LD64_GOTOFF_LO15, 0x408000, 0, 0x400008)
        expect(applied.success).to_equal(true)
        expect(applied.value).to_equal(0xfff)
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_LD64_GOTOFF_LO15, 0x408000, 0, 0x400008)
        expect(read_u32_le(patched, 0)).to_equal(0xf97ffc05)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_LD64_GOTOFF_LO15,
            0x40000e, 0, 0x400008).success).to_equal(false)
        expect(reloc_apply_aarch64(base, 0, R_AARCH64_LD64_GOTOFF_LO15,
            0x408008, 0, 0x400008).success).to_equal(false)

    it "MOVW_GOTOFF groups materialize checked and unchecked GOT offsets":
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_MOVW_GOTOFF_G1)).to_equal(RC_GOT)
        val movk = patch_u32_le([0, 0, 0, 0], 0, 0xf2800007)
        val g1_nc = reloc_apply_aarch64(movk, 0,
            R_AARCH64_MOVW_GOTOFF_G1_NC, 0x12345678, 0, 0)
        expect(g1_nc.value).to_equal(0x1234)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, movk, 0,
            R_AARCH64_MOVW_GOTOFF_G1_NC, 0x12345678, 0, 0), 0)).to_equal(0xf2824687)
        val movz_g2 = patch_u32_le([0, 0, 0, 0], 0, 0xd2c00007)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, movz_g2, 0,
            R_AARCH64_MOVW_GOTOFF_G2, 0x123456789abc, 0, 0), 0)).to_equal(0xd2c24687)
        expect(reloc_apply_aarch64(movk, 0, R_AARCH64_MOVW_GOTOFF_G1,
            0x100000000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(movk, 0, R_AARCH64_MOVW_GOTOFF_G1_NC,
            0x100001234, 0, 0).value).to_equal(0)
        expect(reloc_apply_aarch64(movk, 0, R_AARCH64_MOVW_GOTOFF_G3,
            -1, 0, 0).success).to_equal(false)

    it "writes GOTREL64 and checked signed GOTREL32 data offsets":
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_GOTREL64)).to_equal(RC_PCREL)
        expect(reloc_patch_bytes(RelocArch.AArch64, [0, 0, 0, 0, 0, 0, 0, 0], 0,
            R_AARCH64_GOTREL64, 0x401020, 8, 0x400000)).to_equal([0x28, 0x10, 0, 0, 0, 0, 0, 0])
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0, R_AARCH64_GOTREL32,
            0x3ffff0, 0, 0x400000).value).to_equal(0xfffffff0)
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0, R_AARCH64_GOTREL32,
            0x80000000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0, R_AARCH64_GOTREL32,
            -0x80000001, 0, 0).success).to_equal(false)

    it "writes checked GOTPCREL32 offsets while retaining the relocation addend":
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_GOTPCREL32)).to_equal(RC_GOT)
        expect(reloc_patch_bytes(RelocArch.AArch64, [0, 0, 0, 0], 0,
            R_AARCH64_GOTPCREL32, 0x402000, 12, 0x401004)).to_equal([8, 0x10, 0, 0])
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0, R_AARCH64_GOTPCREL32,
            0x80000000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0, R_AARCH64_GOTPCREL32,
            -0x80000001, 0, 0).success).to_equal(false)

    it "ADR_PREL_LO21 patches a byte-granular signed 21-bit delta":
        # @req REQ-SSPEC-COMPILER
        val base: [i64] = [0x01, 0x00, 0x00, 0x10]
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_ADR_PREL_LO21, 0x1123, 0, 0x1000)
        expect(read_u32_le(patched, 0)).to_equal(0x70000901)
        val overflow = reloc_apply_aarch64(base, 0, R_AARCH64_ADR_PREL_LO21,
            1048576, 0, 0)
        expect(overflow.success).to_equal(false)
        expect(overflow.error).to_contain("signed 21-bit")

    it "encodes page delta: S+A=0x420000 (page-aligned), P=0x400004 -> 32 pages":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 encodes page delta")
        # Page(0x420000) = 0x420000; Page(0x400004) = 0x400000.
        # (0x420000 - 0x400000) >> 12 = 0x20000 >> 12 = 32.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADR_PREL_PG_HI21, 0x420000, 0, 0x400004)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(32)

    it "keeps the NC ADRP form unchecked while masking its encoded field":
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x90000001)
        val checked = reloc_apply_aarch64(base, 0,
            R_AARCH64_ADR_PREL_PG_HI21, 0x100000000, 0, 0)
        expect(checked.success).to_equal(false)
        val nc = reloc_apply_aarch64(base, 0,
            R_AARCH64_ADR_PREL_PG_HI21_NC, 0x100000000, 0, 0)
        expect(nc.success).to_equal(true)
        expect(nc.value).to_equal(0x100000)
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_ADR_PREL_PG_HI21_NC, 0x100000000, 0, 0)
        expect(read_u32_le(patched, 0)).to_equal(0x90800001)

    it "packs the page delta into an ADRP instruction word (immlo/immhi split)":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 packs immlo[30:29]/immhi[23:5] into the instruction")
        # Base: 0x90000001 = "adrp x1, #0" (op=1, fixed 10000, Rd=1, immlo=immhi=0).
        # page_delta_pages=32=0b100000 -> immlo=0, immhi=8.
        # patched = (insn & 0x9f00001f) | (immlo<<29) | (immhi<<5)
        #         = 0x90000001 | (8<<5) = 0x90000001 | 0x100 = 0x90000101.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x90000001)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_ADR_PREL_PG_HI21, 0x420000, 0, 0x400004)
        expect(result.success).to_equal(true)
        val insn = read_u32_le(base, 0)
        val immlo = result.value & 0x3
        val immhi = (result.value >> 2) & 0x7ffff
        val patched_word = (insn & 0x9f00001f) | (immlo << 29) | (immhi << 5)
        expect(patched_word).to_equal(0x90000101)
        val patched_bytes = patch_u32_le(base, 0, patched_word)
        expect(read_u32_le(patched_bytes, 0)).to_equal(0x90000101)

describe "reloc_engine - AArch64 ADD_ABS_LO12_NC (imm12 lo12)":
    it "encodes lo12: S+A=0x420034 -> imm12=0x034":
        # @req REQ-SSPEC-COMPILER
        step("ADD_ABS_LO12_NC encodes lo12 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADD_ABS_LO12_NC, 0x420034, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x034)

    it "packs lo12 into an ADD (immediate) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("ADD_ABS_LO12_NC packs imm12 into insn[21:10]")
        # Base: 0x91000000 = "add x0, x0, #0" (sf=1,op=0,S=0, fixed 10001, imm12=0).
        # lo12 = 0x420034 & 0xfff = 0x034 = 52. patched = 0x91000000 | (52<<10)
        #      = 0x91000000 | 0xd000 = 0x9100d000.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x91000000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_ADD_ABS_LO12_NC, 0x420034, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0x9100d000)

describe "reloc_engine - AArch64 LDST64_ABS_LO12_NC (imm12 lo12 >> 3)":
    it "encodes lo12 scaled by 8: S+A=0x420038 (lo12=0x038) -> imm12=7":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC encodes lo12 >> 3 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420038, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(7)

    it "packs the scaled lo12 into an LDR (64-bit, unsigned offset) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC packs scaled imm12 into insn[21:10]")
        # Base: 0xf9400000 = "ldr x0, [x0]" (size=11, opc=01 LDR, imm12=0).
        # lo12 = 0x420038 & 0xfff = 0x038 = 56; imm12 = 56 >> 3 = 7.
        # patched = 0xf9400000 | (7<<10) = 0xf9400000 | 0x1c00 = 0xf9401c00.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0xf9400000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420038, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0xf9401c00)

# ============================================================================
# Range/alignment rejects added after Fable review (blocking findings):
# ADR_PREL_PG_HI21 must reject an out-of-signed-21-bit page delta instead of
# silently masking immlo/immhi, and LDST64_ABS_LO12_NC must reject a target
# that is not 8-byte aligned.
# ============================================================================

describe "reloc_engine - AArch64 ADR_PREL_PG_HI21 range reject":
    it "accepts the exact positive boundary: page_delta_pages = 1048575 (2^20 - 1)":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 accepts the exact positive boundary page count")
        # S+A = 0xFFFFF000 (page-aligned, = 1048575 * 4096), P = 0 (Page(P) = 0).
        # page_delta_pages = 0xFFFFF000 >> 12 = 1048575 = 2^20 - 1 (max signed 21-bit).
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADR_PREL_PG_HI21, 4294963200, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(1048575)

    it "rejects one page past the boundary: page_delta_pages = 1048576 (2^20)":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 rejects page delta one past the signed 21-bit boundary")
        # S+A = 0x100000000 (page-aligned, = 1048576 * 4096), P = 0.
        # page_delta_pages = 0x100000000 >> 12 = 1048576, one past the max.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADR_PREL_PG_HI21, 4294967296, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

describe "reloc_engine - AArch64 LDST64_ABS_LO12_NC alignment reject":
    it "rejects an unaligned target: S+A=0x420039 (lo12=0x039, not a multiple of 8)":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC rejects a target that is not 8-byte aligned")
        # lo12 = 0x420039 & 0xfff = 0x039 = 57; 57 & 0x7 = 1 != 0 -> misaligned.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420039, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "still accepts the existing aligned case: S+A=0x420038 (lo12=0x038, multiple of 8)":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC still accepts an 8-byte aligned target")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420038, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(7)

# ============================================================================
# AArch64 CALL26 / JUMP26 (branch): reject range/alignment, don't mask.
# Hand-derived per AAELF64: imm26 = (S+A-P) >> 2, into bits 25:0 (keep-mask
# 0xfc000000 preserves the fixed BL/B opcode bits). The raw byte offset
# (S+A-P) must be 4-byte aligned and fit the signed-26-bit x4-scaled field,
# i.e. lie in [-2^27, 2^27) = [-134217728, 134217728).
# ============================================================================

describe "reloc_engine - AArch64 CALL26 range/alignment reject":
    it "accepts an in-range aligned offset: S+A-P=0x1000 -> imm26=0x400":
        # @req REQ-SSPEC-COMPILER
        step("CALL26 accepts an in-range aligned offset")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, 0x1000, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x400)

    it "accepts the exact positive boundary: S+A-P=134217724 (2^27-4)":
        # @req REQ-SSPEC-COMPILER
        step("CALL26 accepts the exact positive boundary offset")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, 134217724, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(33554431)

    it "rejects one past the positive boundary: S+A-P=134217728 (2^27)":
        # @req REQ-SSPEC-COMPILER
        step("CALL26 rejects an offset one past the positive boundary")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, 134217728, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "accepts the exact negative boundary: S+A-P=-134217728 (-2^27)":
        # @req REQ-SSPEC-COMPILER
        step("CALL26 accepts the exact negative boundary offset")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, -134217728, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x2000000)

    it "rejects one past the negative boundary: S+A-P=-134217732 (-2^27-4)":
        # @req REQ-SSPEC-COMPILER
        step("CALL26 rejects an offset one past the negative boundary")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, -134217732, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "rejects a misaligned offset: S+A-P=5 (not a multiple of 4)":
        # @req REQ-SSPEC-COMPILER
        step("CALL26 rejects a misaligned branch offset")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, 5, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

describe "reloc_engine - AArch64 JUMP26 (real relocation, same formula as CALL26)":
    it "R_AARCH64_JUMP26 computes the same value as R_AARCH64_CALL26 for the same inputs":
        # @req REQ-SSPEC-COMPILER
        step("JUMP26 matches CALL26's formula and encoding")
        val bytes: [i64] = [0, 0, 0, 0]
        val call26 = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, 0x1000, 0, 0)
        val jump26 = reloc_apply_aarch64(bytes, 0, R_AARCH64_JUMP26, 0x1000, 0, 0)
        expect(jump26.success).to_equal(call26.success)
        expect(jump26.value).to_equal(call26.value)

    it "R_AARCH64_JUMP26 rejects out-of-range offsets exactly like CALL26":
        # @req REQ-SSPEC-COMPILER
        step("JUMP26 rejects out-of-range branch offsets")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_JUMP26, 134217728, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "R_AARCH64_JUMP26 rejects a misaligned offset exactly like CALL26":
        # @req REQ-SSPEC-COMPILER
        step("JUMP26 rejects a misaligned branch offset")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_JUMP26, 5, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "packs the imm26 into a B/BL instruction word identically to CALL26":
        # @req REQ-SSPEC-COMPILER
        step("JUMP26 packs imm26 into insn[25:0]")
        # Base: 0x14000000 = "b #0" (op=000101, imm26=0). Keep-mask 0xfc000000
        # preserves the fixed opcode bits; imm26 = 0x1000 >> 2 = 0x400.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x14000000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_JUMP26, 0x1000, 0, 0)
        expect(result.success).to_equal(true)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xfc000000) | (result.value & 0x3ffffff)
        expect(patched_word).to_equal(0x14000400)

# ============================================================================
# AArch64 LDST8/16/32/128_ABS_LO12_NC: same imm12/read-modify-write shape as
# LDST64_ABS_LO12_NC, scaled by the access size (1/2/4/16 bytes). Only the
# 8-bit variant has no alignment constraint — every byte offset is valid.
# Hand-derived per AAELF64: imm12 = ((S+A) & 0xfff) >> {0,1,2,4}, into
# insn[21:10] (keep-mask 0xffc003ff).
# ============================================================================

describe "reloc_engine - AArch64 LDST8_ABS_LO12_NC (imm12 lo12, unscaled)":
    it "encodes lo12 with no scaling: S+A=0x420034 -> imm12=0x034":
        # @req REQ-SSPEC-COMPILER
        step("LDST8_ABS_LO12_NC encodes lo12 unscaled")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST8_ABS_LO12_NC, 0x420034, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x034)

    it "accepts an odd (non-power-of-2-aligned) offset — byte access has no alignment reject":
        # @req REQ-SSPEC-COMPILER
        step("LDST8_ABS_LO12_NC has no alignment reject")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST8_ABS_LO12_NC, 0x420035, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x035)

    it "packs lo12 into an LDRB (unsigned offset) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("LDST8_ABS_LO12_NC packs imm12 into insn[21:10]")
        # Base: 0x39400000 = "ldrb w0, [x0]" (size=00, opc=01, imm12=0).
        # lo12 = 0x420034 & 0xfff = 0x034 = 52. patched = 0x39400000 | (52<<10)
        #      = 0x39400000 | 0xd000 = 0x3940d000.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x39400000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_LDST8_ABS_LO12_NC, 0x420034, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0x3940d000)

describe "reloc_engine - AArch64 LDST16_ABS_LO12_NC (imm12 lo12 >> 1)":
    it "encodes lo12 scaled by 2: S+A=0x420036 (lo12=0x036) -> imm12=27":
        # @req REQ-SSPEC-COMPILER
        step("LDST16_ABS_LO12_NC encodes lo12 >> 1 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST16_ABS_LO12_NC, 0x420036, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(27)

    it "rejects an unaligned target: S+A=0x420037 (lo12=0x037, not a multiple of 2)":
        # @req REQ-SSPEC-COMPILER
        step("LDST16_ABS_LO12_NC rejects a target that is not 2-byte aligned")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST16_ABS_LO12_NC, 0x420037, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "packs the scaled lo12 into an LDRH instruction word":
        # @req REQ-SSPEC-COMPILER
        step("LDST16_ABS_LO12_NC packs scaled imm12 into insn[21:10]")
        # Base: 0x79400000 = "ldrh w0, [x0]" (size=01, opc=01, imm12=0).
        # lo12 = 0x420036 & 0xfff = 0x036 = 54; imm12 = 54 >> 1 = 27.
        # patched = 0x79400000 | (27<<10) = 0x79400000 | 0x6c00 = 0x79406c00.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x79400000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_LDST16_ABS_LO12_NC, 0x420036, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0x79406c00)

describe "reloc_engine - AArch64 LDST32_ABS_LO12_NC (imm12 lo12 >> 2)":
    it "encodes lo12 scaled by 4: S+A=0x420034 (lo12=0x034) -> imm12=13":
        # @req REQ-SSPEC-COMPILER
        step("LDST32_ABS_LO12_NC encodes lo12 >> 2 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST32_ABS_LO12_NC, 0x420034, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(13)

    it "rejects an unaligned target: S+A=0x420035 (lo12=0x035, not a multiple of 4)":
        # @req REQ-SSPEC-COMPILER
        step("LDST32_ABS_LO12_NC rejects a target that is not 4-byte aligned")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST32_ABS_LO12_NC, 0x420035, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "packs the scaled lo12 into an LDR (32-bit, unsigned offset) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("LDST32_ABS_LO12_NC packs scaled imm12 into insn[21:10]")
        # Base: 0xb9400000 = "ldr w0, [x0]" (size=10, opc=01, imm12=0).
        # lo12 = 0x420034 & 0xfff = 0x034 = 52; imm12 = 52 >> 2 = 13.
        # patched = 0xb9400000 | (13<<10) = 0xb9400000 | 0x3400 = 0xb9403400.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0xb9400000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_LDST32_ABS_LO12_NC, 0x420034, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0xb9403400)

describe "reloc_engine - AArch64 LDST128_ABS_LO12_NC (imm12 lo12 >> 4)":
    it "encodes lo12 scaled by 16: S+A=0x420030 (lo12=0x030) -> imm12=3":
        # @req REQ-SSPEC-COMPILER
        step("LDST128_ABS_LO12_NC encodes lo12 >> 4 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST128_ABS_LO12_NC, 0x420030, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(3)

    it "rejects an unaligned target: S+A=0x420031 (lo12=0x031, not a multiple of 16)":
        # @req REQ-SSPEC-COMPILER
        step("LDST128_ABS_LO12_NC rejects a target that is not 16-byte aligned")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST128_ABS_LO12_NC, 0x420031, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "packs the scaled lo12 into an LDR (128-bit SIMD, unsigned offset) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("LDST128_ABS_LO12_NC packs scaled imm12 into insn[21:10]")
        # Base: 0x3dc00000 = "ldr q0, [x0]" (size=00, V=1, opc=11, imm12=0).
        # lo12 = 0x420030 & 0xfff = 0x030 = 48; imm12 = 48 >> 4 = 3.
        # patched = 0x3dc00000 | (3<<10) = 0x3dc00000 | 0xc00 = 0x3dc00c00.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x3dc00000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_LDST128_ABS_LO12_NC, 0x420030, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0x3dc00c00)

describe "reloc_engine - AArch64 TLS local dynamic":
    it "writes statically resolved 64-bit TLS ABI records":
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLS_DTPREL64)).to_equal(RC_TLS_LD)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLS_DTPMOD64)).to_equal(RC_TLS_MOD)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLS_TPREL64)).to_equal(RC_TLS_LE)
        expect(reloc_patch_bytes(RelocArch.AArch64, [0, 0, 0, 0, 0, 0, 0, 0], 0,
            R_AARCH64_TLS_DTPREL64, 0x28, 0, 0)).to_equal([0x28, 0, 0, 0, 0, 0, 0, 0])
        expect(reloc_patch_bytes(RelocArch.AArch64, [0, 0, 0, 0, 0, 0, 0, 0], 0,
            R_AARCH64_TLS_DTPMOD64, 1, 99, 0)).to_equal([1, 0, 0, 0, 0, 0, 0, 0])
        expect(reloc_patch_bytes(RelocArch.AArch64, [0, 0, 0, 0, 0, 0, 0, 0], 0,
            R_AARCH64_TLS_TPREL64, 0x38, 0, 0)).to_equal([0x38, 0, 0, 0, 0, 0, 0, 0])

    it "classifies and patches DTPREL MOVW groups":
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_TLSLD_MOVW_DTPREL_G2)).to_equal(RC_TLS_LD)
        val movz = patch_u32_le([0, 0, 0, 0], 0, 0xd2c00007)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, movz, 0,
            R_AARCH64_TLSLD_MOVW_DTPREL_G2, 0x123456789abc, 0, 0), 0)).to_equal(0xd2c24687)
        expect(reloc_apply_aarch64(movz, 0, R_AARCH64_TLSLD_MOVW_DTPREL_G2,
            0x1000000000000, 0, 0).success).to_equal(false)
        val movk = patch_u32_le([0, 0, 0, 0], 0, 0xf2a00007)
        expect(reloc_apply_aarch64(movk, 0, R_AARCH64_TLSLD_MOVW_DTPREL_G1_NC,
            0x100001234, 0, 0).value).to_equal(0)

    it "checks DTPREL add and naturally-scaled load offsets":
        val add_hi = patch_u32_le([0, 0, 0, 0], 0, 0x91400000)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, add_hi, 0,
            R_AARCH64_TLSLD_ADD_DTPREL_HI12, 0x123456, 0, 0), 0)).to_equal(0x91448c00)
        expect(reloc_apply_aarch64(add_hi, 0, R_AARCH64_TLSLD_ADD_DTPREL_LO12,
            0x1000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(add_hi, 0, R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC,
            0x1234, 0, 0).value).to_equal(0x234)
        val ldr = patch_u32_le([0, 0, 0, 0], 0, 0xf9400000)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, ldr, 0,
            R_AARCH64_TLSLD_LDST64_DTPREL_LO12, 0xff8, 0, 0), 0)).to_equal(0xf947fc00)
        expect(reloc_apply_aarch64(ldr, 0, R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC,
            0xffa, 0, 0).success).to_equal(false)
        expect(elf_reloc_class(RelocArch.AArch64,
            R_AARCH64_TLSLD_LDST128_DTPREL_LO12)).to_equal(RC_TLS_LD)

describe "reloc_engine - AArch64 TLS initial/local exec":
    it "classifies canonical TLSIE and TLSLE instruction relocations":
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSIE_MOVW_GOTTPREL_G1)).to_equal(RC_TLS_IE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21)).to_equal(RC_TLS_IE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC)).to_equal(RC_TLS_IE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSIE_LD_GOTTPREL_PREL19)).to_equal(RC_TLS_IE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSLE_ADD_TPREL_HI12)).to_equal(RC_TLS_LE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSLE_MOVW_TPREL_G2)).to_equal(RC_TLS_LE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSLE_ADD_TPREL_LO12_NC)).to_equal(RC_TLS_LE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSLE_LDST8_TPREL_LO12)).to_equal(RC_TLS_LE)
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_TLSLE_LDST128_TPREL_LO12)).to_equal(RC_TLS_LE)

    it "materializes large-model TLSIE GOT offsets with MOVZ/MOVK":
        val movz = patch_u32_le([0, 0, 0, 0], 0, 0xd2a00005)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, movz, 0,
            R_AARCH64_TLSIE_MOVW_GOTTPREL_G1, 0x12345678, 0, 0), 0)).to_equal(0xd2a24685)
        val movk = patch_u32_le([0, 0, 0, 0], 0, 0xf2800005)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, movk, 0,
            R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC, 0x12345678, 0, 0), 0)).to_equal(0xf28acf05)
        expect(reloc_apply_aarch64(movz, 0, R_AARCH64_TLSIE_MOVW_GOTTPREL_G1,
            0x100000000, 0, 0).success).to_equal(false)
        expect(read_u32_le(reloc_patch_bytes(RelocArch.AArch64, movz, 0,
            R_AARCH64_TLSIE_MOVW_GOTTPREL_G1, -1, 0, 0), 0)).to_equal(0x92a00005)

    it "encodes the TLSIE GOT page and scaled slot offset":
        val page = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21, 0x403018, 0, 0x401004)
        val slot = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC, 0x403018, 0, 0)
        expect(page.success).to_equal(true)
        expect(page.value).to_equal(2)
        expect(slot.success).to_equal(true)
        expect(slot.value).to_equal(3)

    it "encodes the TLSIE literal-load displacement":
        val literal = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSIE_LD_GOTTPREL_PREL19, 0x402000, 0, 0x401000)
        expect(literal.success).to_equal(true)
        expect(literal.value).to_equal(0x400)

    it "splits a TLSLE TPREL value between high and low add immediates":
        val hi = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_ADD_TPREL_HI12, 0x123456, 0, 0)
        val lo = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_ADD_TPREL_LO12, 0x123456, 0, 0)
        expect(hi.success).to_equal(true)
        expect(hi.value).to_equal(0x123)
        expect(lo.success).to_equal(true)
        expect(lo.value).to_equal(0x456)

    it "extracts and patches TLSLE MOVW groups":
        val value: i64 = 0x123456789abc
        val g2 = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_MOVW_TPREL_G2, value, 0, 0)
        val g1 = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_MOVW_TPREL_G1_NC, value, 0, 0)
        val base = patch_u32_le([0, 0, 0, 0], 0, 0xd2800000)
        val patched = reloc_patch_bytes(RelocArch.AArch64, base, 0,
            R_AARCH64_TLSLE_MOVW_TPREL_G0, 0x9abc, 0, 0)
        expect(g2.value).to_equal(0x1234)
        expect(g1.value).to_equal(0x5678)
        expect(read_u32_le(patched, 0)).to_equal(0xd2935780)

    it "checks TLSLE MOVW group overflow while NC groups truncate":
        val checked = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_MOVW_TPREL_G1, 0x100000000, 0, 0)
        val nc = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_MOVW_TPREL_G1_NC, 0x100001234, 0, 0)
        expect(checked.success).to_equal(false)
        expect(nc.success).to_equal(true)
        expect(nc.value).to_equal(0)

    it "rejects checked TLSLE offsets beyond the unsigned 24-bit model":
        val hi = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_ADD_TPREL_HI12, 0x1000000, 0, 0)
        val lo = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_ADD_TPREL_LO12, -1, 0, 0)
        expect(hi.success).to_equal(false)
        expect(lo.success).to_equal(false)

    it "encodes naturally scaled TLSLE load/store offsets":
        val byte = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_LDST8_TPREL_LO12, 0x123456, 0, 0)
        val word = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_LDST64_TPREL_LO12, 0x123458, 0, 0)
        val vector = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_LDST128_TPREL_LO12, 0x123450, 0, 0)
        expect(byte.value).to_equal(0x456)
        expect(word.value).to_equal(0x8b)
        expect(vector.value).to_equal(0x45)

    it "rejects checked overflow and natural-alignment violations while NC truncates":
        val overflow = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_LDST64_TPREL_LO12, 0x1000000, 0, 0)
        val unaligned = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC, 0x12345a, 0, 0)
        val truncated = reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC, 0x1000018, 0, 0)
        expect(overflow.success).to_equal(false)
        expect(unaligned.success).to_equal(false)
        expect(truncated.success).to_equal(true)
        expect(truncated.value).to_equal(3)
