# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Relocation Engine Unit Tests
#
# Tests for reloc_engine.spl: byte patch helpers, arch detection,
# x86_64/AArch64/RISC-V relocation formulas, unified dispatch, and
# byte-patching integration.
#
# @cover src/compiler/70.backend/linker/reloc_engine.spl

use std.spec.step

use compiler.backend.linker.reloc_engine.{

    RelocArch, RelocTarget, RelocResult,
    reloc_apply, reloc_apply_x86_64, reloc_apply_arm32, reloc_apply_aarch64, reloc_apply_riscv,
    reloc_patch_bytes, reloc_arch_from_machine,
    patch_u32_le, patch_u64_le, read_u16_le, read_u32_le,
    R_X86_64_NONE, R_X86_64_64, R_X86_64_PC32, R_X86_64_PC64,
    R_X86_64_16, R_X86_64_PC16, R_X86_64_8, R_X86_64_PC8, R_X86_64_PLT32,
    R_X86_64_32, R_X86_64_32S, R_X86_64_GOTPCREL,
    R_ARM_NONE, R_ARM_PC24, R_ARM_ABS32, R_ARM_REL32, R_ARM_ABS16, R_ARM_ABS8, R_ARM_THM_CALL,
    R_ARM_CALL, R_ARM_JUMP24, R_ARM_THM_JUMP24,
    R_ARM_TARGET1, R_ARM_V4BX, R_ARM_PREL31,
    R_ARM_MOVW_ABS_NC, R_ARM_MOVT_ABS, R_ARM_MOVW_PREL_NC, R_ARM_MOVT_PREL,
    R_ARM_THM_MOVW_ABS_NC, R_ARM_THM_MOVT_ABS, R_ARM_THM_MOVW_PREL_NC, R_ARM_THM_MOVT_PREL,
    R_ARM_THM_JUMP11, R_ARM_THM_JUMP8,
    R_AARCH64_NONE, R_AARCH64_ABS64, R_AARCH64_ABS32, R_AARCH64_ABS16,
    R_AARCH64_PREL16, R_AARCH64_PREL32, R_AARCH64_PLT32,
    R_AARCH64_TSTBR14, R_AARCH64_CONDBR19, R_AARCH64_CALL26, R_AARCH64_JUMP26,
    R_AARCH64_LD_PREL_LO19, R_AARCH64_ADR_PREL_LO21, R_AARCH64_ADR_PREL_PG_HI21,
    R_AARCH64_ADR_PREL_PG_HI21_NC,
    R_AARCH64_MOVW_UABS_G0, R_AARCH64_MOVW_UABS_G0_NC,
    R_AARCH64_MOVW_UABS_G1, R_AARCH64_MOVW_UABS_G2, R_AARCH64_MOVW_UABS_G3,
    R_AARCH64_MOVW_SABS_G0, R_AARCH64_MOVW_SABS_G1, R_AARCH64_MOVW_SABS_G2,
    R_AARCH64_MOVW_PREL_G0, R_AARCH64_MOVW_PREL_G0_NC,
    R_AARCH64_MOVW_PREL_G1, R_AARCH64_MOVW_PREL_G2, R_AARCH64_MOVW_PREL_G3,
    R_AARCH64_MOVW_GOTOFF_G0, R_AARCH64_MOVW_GOTOFF_G0_NC,
    R_AARCH64_MOVW_GOTOFF_G1, R_AARCH64_MOVW_GOTOFF_G1_NC,
    R_AARCH64_MOVW_GOTOFF_G2, R_AARCH64_MOVW_GOTOFF_G2_NC, R_AARCH64_MOVW_GOTOFF_G3,
    R_AARCH64_GOTREL64, R_AARCH64_GOTREL32, R_AARCH64_GOTPCREL32,
    R_AARCH64_ADD_ABS_LO12_NC, R_AARCH64_LDST64_ABS_LO12_NC,
    R_AARCH64_GOT_LD_PREL19, R_AARCH64_LD64_GOTOFF_LO15, R_AARCH64_LD64_GOTPAGE_LO15,
    R_AARCH64_TLSLD_MOVW_DTPREL_G2, R_AARCH64_TLSLD_MOVW_DTPREL_G1_NC,
    R_AARCH64_TLSLD_ADD_DTPREL_HI12, R_AARCH64_TLSLD_ADD_DTPREL_LO12, R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC,
    R_AARCH64_TLSLD_LDST64_DTPREL_LO12, R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC,
    R_AARCH64_TLSLD_LDST128_DTPREL_LO12,
    R_AARCH64_TLS_DTPREL64, R_AARCH64_TLS_DTPMOD64, R_AARCH64_TLS_TPREL64,
    R_AARCH64_TLSIE_MOVW_GOTTPREL_G1, R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC,
    R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21, R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC,
    R_AARCH64_TLSIE_LD_GOTTPREL_PREL19,
    R_AARCH64_TLSLE_MOVW_TPREL_G2, R_AARCH64_TLSLE_MOVW_TPREL_G1,
