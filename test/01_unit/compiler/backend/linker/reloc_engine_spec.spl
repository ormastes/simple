# ============================================================================
# Unified dispatch
# ============================================================================

describe "reloc_engine - unified dispatch":
    it "reloc_apply with X86_64 arch matches reloc_apply_x86_64":
        # @req REQ-SSPEC-COMPILER
        step("reloc_apply with X86_64 arch matches reloc_apply_x86_64")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val direct = reloc_apply_x86_64(bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        val unified = reloc_apply(RelocArch.X86_64, bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        expect(unified.success).to_equal(direct.success)
        expect(unified.value).to_equal(direct.value)

    it "reloc_apply with AArch64 arch matches reloc_apply_aarch64":
        # @req REQ-SSPEC-COMPILER
        step("reloc_apply with AArch64 arch matches reloc_apply_aarch64")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val direct = reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS64, 0x10000, 0, 0)
        val unified = reloc_apply(RelocArch.AArch64, bytes, 0, R_AARCH64_ABS64, 0x10000, 0, 0)
        expect(unified.success).to_equal(direct.success)
        expect(unified.value).to_equal(direct.value)

# ============================================================================
# Byte patching integration
# ============================================================================

describe "reloc_engine - byte patching integration":
    it "R_X86_64_64 reloc value patched as 8 LE bytes at offset":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_64 reloc value patched as 8 LE bytes at offset")
        # reloc_patch_bytes internally uses .set() which requires compiled mode.
        # Verify the same end-to-end semantics by composing reloc_apply + patch_u64_le.
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = reloc_apply(RelocArch.X86_64, bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1008)
        val patched = patch_u64_le(bytes, 0, result.value)
        # 0x1008 in LE: 0x08, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
        expect(patched[0]).to_equal(0x08)
        expect(patched[1]).to_equal(0x10)
        expect(patched[2]).to_equal(0x00)
        expect(patched[3]).to_equal(0x00)
        expect(patched[4]).to_equal(0x00)
        expect(patched[5]).to_equal(0x00)
        expect(patched[6]).to_equal(0x00)
        expect(patched[7]).to_equal(0x00)

    it "R_X86_64_PC32 reloc value patched as 4 LE bytes at offset":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_PC32 reloc value patched as 4 LE bytes at offset")
        # Verify end-to-end via reloc_apply + patch_u32_le (avoids interpreter .set() dispatch issue).
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply(RelocArch.X86_64, bytes, 0, R_X86_64_PC32, 0x2000, 0, 0x1000)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1000)
        val patched = patch_u32_le(bytes, 0, result.value)
        # 0x1000 in LE: 0x00, 0x10, 0x00, 0x00
        expect(patched[0]).to_equal(0x00)
        expect(patched[1]).to_equal(0x10)
        expect(patched[2]).to_equal(0x00)
        expect(patched[3]).to_equal(0x00)

# ============================================================================
# Oracle delegation + reject-not-mask (x86_64 S+A / S+A-P via smf_reloc_compute)
# ============================================================================

describe "reloc_engine - x86_64 reject-not-mask (delegates to smf_reloc_compute)":
    it "R_X86_64_32 out of range rejects (was: silently masked to 32 bits)":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32 out of range rejects (was: silently masked to 32 bits)")
        # s + a = 4294967296 = 2^32, one past the unsigned 32-bit max (4294967295).
        # Before this change: `v & 0xffffffff` silently wrapped this to 0.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_32, 4294967296, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "R_X86_64_32 in range still succeeds with the exact value":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32 in range still succeeds with the exact value")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_32, 4294967295, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(4294967295)

# ============================================================================
# AArch64 page-relative pair: ADRP + ADD/LDR (ADR_PREL_PG_HI21, ADD_ABS_LO12_NC,
# LDST64_ABS_LO12_NC) — hand-derived per the ARM ELF ABI (AAELF64):
#   page delta pages = (Page(S+A) - Page(P)) >> 12, Page(x) = x with low 12
#   bits cleared; immlo = pages[1:0] -> insn[30:29]; immhi = pages[20:2] ->
#   insn[23:5]. ADD's imm12 = (S+A)[11:0] -> insn[21:10]. LDR (64-bit,
#   unsigned offset) scales by the 8-byte access size: imm12 = (S+A)[11:0] >> 3
#   -> insn[21:10].
# ============================================================================

describe "reloc_engine - AArch64 ADR_PREL_PG_HI21 (page delta)":
    it "encodes page delta: S+A=0x420000 (page-aligned), P=0x400004 -> 32 pages":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 encodes page delta")
        # Page(0x420000) = 0x420000; Page(0x400004) = 0x400000.
        # (0x420000 - 0x400000) >> 12 = 0x20000 >> 12 = 32.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADR_PREL_PG_HI21, 0x420000, 0, 0x400004)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(32)

    it "packs the page delta into an ADRP instruction word (immlo/immhi split)":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 packs immlo[30:29]/immhi[23:5] into the instruction")
        # Base: 0x90000001 = "adrp x1, #0" (op=1, fixed 10000, Rd=1, immlo=immhi=0).
        # page_delta_pages=32=0b100000 -> immlo=0, immhi=8.
        # patched = (insn & 0x9f00001f) | (immlo<<29) | (immhi<<5)
        #         = 0x90000001 | (8<<5) = 0x90000001 | 0x100 = 0x90000101.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x90000001)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_ADR_PREL_PG_HI21, 0x420000, 0, 0x400004)
        expect(result.success).to_equal(true)
        val insn = read_u32_le(base, 0)
        val immlo = result.value & 0x3
        val immhi = (result.value >> 2) & 0x7ffff
        val patched_word = (insn & 0x9f00001f) | (immlo << 29) | (immhi << 5)
        expect(patched_word).to_equal(0x90000101)
        val patched_bytes = patch_u32_le(base, 0, patched_word)
        expect(read_u32_le(patched_bytes, 0)).to_equal(0x90000101)

describe "reloc_engine - AArch64 ADD_ABS_LO12_NC (imm12 lo12)":
    it "encodes lo12: S+A=0x420034 -> imm12=0x034":
        # @req REQ-SSPEC-COMPILER
        step("ADD_ABS_LO12_NC encodes lo12 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADD_ABS_LO12_NC, 0x420034, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x034)

    it "packs lo12 into an ADD (immediate) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("ADD_ABS_LO12_NC packs imm12 into insn[21:10]")
        # Base: 0x91000000 = "add x0, x0, #0" (sf=1,op=0,S=0, fixed 10001, imm12=0).
        # lo12 = 0x420034 & 0xfff = 0x034 = 52. patched = 0x91000000 | (52<<10)
        #      = 0x91000000 | 0xd000 = 0x9100d000.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0x91000000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_ADD_ABS_LO12_NC, 0x420034, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0x9100d000)

describe "reloc_engine - AArch64 LDST64_ABS_LO12_NC (imm12 lo12 >> 3)":
    it "encodes lo12 scaled by 8: S+A=0x420038 (lo12=0x038) -> imm12=7":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC encodes lo12 >> 3 into imm12")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420038, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(7)

    it "packs the scaled lo12 into an LDR (64-bit, unsigned offset) instruction word":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC packs scaled imm12 into insn[21:10]")
        # Base: 0xf9400000 = "ldr x0, [x0]" (size=11, opc=01 LDR, imm12=0).
        # lo12 = 0x420038 & 0xfff = 0x038 = 56; imm12 = 56 >> 3 = 7.
        # patched = 0xf9400000 | (7<<10) = 0xf9400000 | 0x1c00 = 0xf9401c00.
        val base = patch_u32_le([0, 0, 0, 0], 0, 0xf9400000)
        val result = reloc_apply_aarch64(base, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420038, 0, 0)
        val insn = read_u32_le(base, 0)
        val patched_word = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
        expect(patched_word).to_equal(0xf9401c00)

# ============================================================================
# Range/alignment rejects added after Fable review (blocking findings):
# ADR_PREL_PG_HI21 must reject an out-of-signed-21-bit page delta instead of
# silently masking immlo/immhi, and LDST64_ABS_LO12_NC must reject a target
# that is not 8-byte aligned.
# ============================================================================

describe "reloc_engine - AArch64 ADR_PREL_PG_HI21 range reject":
    it "accepts the exact positive boundary: page_delta_pages = 1048575 (2^20 - 1)":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 accepts the exact positive boundary page count")
        # S+A = 0xFFFFF000 (page-aligned, = 1048575 * 4096), P = 0 (Page(P) = 0).
        # page_delta_pages = 0xFFFFF000 >> 12 = 1048575 = 2^20 - 1 (max signed 21-bit).
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADR_PREL_PG_HI21, 4294963200, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(1048575)

    it "rejects one page past the boundary: page_delta_pages = 1048576 (2^20)":
        # @req REQ-SSPEC-COMPILER
        step("ADR_PREL_PG_HI21 rejects page delta one past the signed 21-bit boundary")
        # S+A = 0x100000000 (page-aligned, = 1048576 * 4096), P = 0.
        # page_delta_pages = 0x100000000 >> 12 = 1048576, one past the max.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ADR_PREL_PG_HI21, 4294967296, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

describe "reloc_engine - AArch64 LDST64_ABS_LO12_NC alignment reject":
    it "rejects an unaligned target: S+A=0x420039 (lo12=0x039, not a multiple of 8)":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC rejects a target that is not 8-byte aligned")
        # lo12 = 0x420039 & 0xfff = 0x039 = 57; 57 & 0x7 = 1 != 0 -> misaligned.
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420039, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

    it "still accepts the existing aligned case: S+A=0x420038 (lo12=0x038, multiple of 8)":
        # @req REQ-SSPEC-COMPILER
        step("LDST64_ABS_LO12_NC still accepts an 8-byte aligned target")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_LDST64_ABS_LO12_NC, 0x420038, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(7)
