    R_AARCH64_TLSLE_LDST8_TPREL_LO12, R_AARCH64_TLSLE_LDST64_TPREL_LO12,
    R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC, R_AARCH64_TLSLE_LDST128_TPREL_LO12,
    R_AARCH64_LDST8_ABS_LO12_NC, R_AARCH64_LDST16_ABS_LO12_NC, R_AARCH64_LDST32_ABS_LO12_NC, R_AARCH64_LDST128_ABS_LO12_NC,
    R_RISCV_NONE, R_RISCV_32, R_RISCV_64, R_RISCV_HI20, R_RISCV_LO12_I
}
use compiler.backend.linker.elf.reloc_scan.{elf_reloc_class, RC_ABS_NARROW, RC_PCREL, RC_BRANCH, RC_GOT, RC_TLS_IE, RC_TLS_LE, RC_TLS_LD, RC_TLS_MOD}

# ============================================================================
# Byte patch helpers
# ============================================================================

describe "reloc_engine - byte patch helpers":
    # @manual scenario evidence
    it "patch_u32_le writes correct little-endian bytes":
        # @req REQ-SSPEC-COMPILER
        step("patch_u32_le writes correct little-endian bytes")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = patch_u32_le(bytes, 0, 0x12345678)
        expect(result[0]).to_equal(0x78)
        expect(result[1]).to_equal(0x56)
        expect(result[2]).to_equal(0x34)
        expect(result[3]).to_equal(0x12)

    it "patch_u64_le writes correct little-endian bytes":
        # @req REQ-SSPEC-COMPILER
        step("patch_u64_le writes correct little-endian bytes")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = patch_u64_le(bytes, 0, 0x0102030405060708)
        expect(result[0]).to_equal(0x08)
        expect(result[1]).to_equal(0x07)
        expect(result[2]).to_equal(0x06)
        expect(result[3]).to_equal(0x05)
        expect(result[4]).to_equal(0x04)
        expect(result[5]).to_equal(0x03)
        expect(result[6]).to_equal(0x02)
        expect(result[7]).to_equal(0x01)

    it "read_u32_le reads back correct little-endian value":
        # @req REQ-SSPEC-COMPILER
        step("read_u32_le reads back correct little-endian value")
        val bytes: [i64] = [0x78, 0x56, 0x34, 0x12]
        val value = read_u32_le(bytes, 0)
        expect(value).to_equal(0x12345678)

    it "patch_u32_le then read_u32_le round-trips correctly":
        # @req REQ-SSPEC-COMPILER
        step("patch_u32_le then read_u32_le round-trips correctly")
        val bytes: [i64] = [0, 0, 0, 0]
        val written = patch_u32_le(bytes, 0, 0xDEADBEEF)
        val read_back = read_u32_le(written, 0)
        expect(read_back).to_equal(0xDEADBEEF)

# ============================================================================
# reloc_arch_from_machine
# ============================================================================

describe "reloc_engine - reloc_arch_from_machine":
    it "machine 62 maps to X86_64":
        # @req REQ-SSPEC-COMPILER
        step("machine 62 maps to X86_64")
        val arch = reloc_arch_from_machine(62)
        expect(arch == RelocArch.X86_64).to_equal(true)

    it "machine 183 maps to AArch64":
        step("Verify: machine 183 maps to AArch64")
        # @req: REQ-SSPEC-LOCAL-001
        val arch = reloc_arch_from_machine(183)
        expect(arch == RelocArch.AArch64).to_equal(true)

    it "machine 40 maps to Arm32":
        step("Verify: machine 40 maps to Arm32")
        val arch = reloc_arch_from_machine(40)
        expect(arch == RelocArch.Arm32).to_equal(true)

    it "machine 243 maps to Riscv64":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: machine 243 maps to Riscv64")
        val arch = reloc_arch_from_machine(243)
        expect(arch == RelocArch.Riscv64).to_equal(true)

# ============================================================================
# ARM32 relocations
# ============================================================================

describe "reloc_engine - ARM32 relocations":
    it "applies absolute and relative 32-bit data formulas":
        val bytes: [i64] = [0, 0, 0, 0]
        val absolute = reloc_apply_arm32(bytes, 0, R_ARM_ABS32, 0x1000, 8, 0)
        val relative = reloc_apply_arm32(bytes, 0, R_ARM_REL32, 0x1800, 4, 0x1000)

        expect(absolute.success).to_equal(true)
        expect(absolute.value).to_equal(0x1008)
        expect(relative.success).to_equal(true)
        expect(relative.value).to_equal(0x804)

    it "applies narrow absolute data and bare-metal TARGET1 formulas":
        val half = reloc_patch_bytes(
            RelocArch.Arm32, [0, 0], 0, R_ARM_ABS16, 0x1230, 4, 0)
        val byte = reloc_patch_bytes(
            RelocArch.Arm32, [0], 0, R_ARM_ABS8, 0x70, 8, 0)
        val target = reloc_apply_arm32(
            [0, 0, 0, 0], 0, R_ARM_TARGET1, 0x12345670, 8, 0)

        expect(half).to_equal([0x34, 0x12])
        expect(byte).to_equal([0x78])
        expect(target.value).to_equal(0x12345678)
        expect(reloc_apply_arm32([0, 0], 0, R_ARM_ABS16, 65536, 0, 0).success).to_equal(false)
        expect(reloc_apply_arm32([0], 0, R_ARM_ABS8, 256, 0, 0).success).to_equal(false)

    it "encodes forward and backward ARM branch immediates":
        val bytes: [i64] = [0, 0, 0, 0]
        val forward = reloc_apply_arm32(bytes, 0, R_ARM_CALL, 0x1100, 0, 0x1000)
        val backward = reloc_apply_arm32(bytes, 0, R_ARM_JUMP24, 0x0f00, 0, 0x1000)

        expect(forward.success).to_equal(true)
        expect(forward.value).to_equal(0x40)
        expect(backward.success).to_equal(true)
        expect(backward.value).to_equal(0xffffc0)

    it "rejects misaligned out-of-range and unsupported ARM relocations":
        val bytes: [i64] = [0, 0, 0, 0]
        expect(reloc_apply_arm32(bytes, 0, R_ARM_PC24, 0x1002, 0, 0x1000).success).to_equal(false)
        expect(reloc_apply_arm32(bytes, 0, R_ARM_CALL, 0x2100000, 0, 0).success).to_equal(false)
        expect(reloc_apply_arm32(bytes, 0, 255, 0, 0, 0).success).to_equal(false)

    it "preserves an ARM branch opcode while patching imm24":
        val branch: [i64] = [0, 0, 0, 0xeb]
        val patched = reloc_patch_bytes(RelocArch.Arm32, branch, 0, R_ARM_CALL, 0x1100, 0, 0x1000)

        expect(patched).to_equal([0x40, 0x00, 0x00, 0xeb])

    it "patches forward and backward Thumb-2 branch displacements":
        val bl: [i64] = [0x00, 0xf0, 0x00, 0xf8]
        val forward = reloc_patch_bytes(
            RelocArch.Arm32, bl, 0, R_ARM_THM_CALL, 0x1101, 0, 0x1000)
        val backward = reloc_patch_bytes(
            RelocArch.Arm32, bl, 0, R_ARM_THM_JUMP24, 0x0f01, 0, 0x1000)

        expect(forward).to_equal([0x00, 0xf0, 0x80, 0xf8])
        expect(backward).to_equal([0xff, 0xf7, 0x80, 0xff])

    it "rejects out-of-range Thumb-2 branches":
        val bytes: [i64] = [0x00, 0xf0, 0x00, 0xf8]
        val result = reloc_apply_arm32(bytes, 0, R_ARM_THM_CALL, 0x1000001, 0, 0)

        expect(result.success).to_equal(false)

    it "patches narrow Thumb unconditional and conditional branches":
        val unconditional: [i64] = [0x00, 0xe0]
        val conditional: [i64] = [0x00, 0xd1]
        val forward = reloc_patch_bytes(
            RelocArch.Arm32, unconditional, 0, R_ARM_THM_JUMP11, 0x1081, 0, 0x1000)
        val backward = reloc_patch_bytes(
            RelocArch.Arm32, conditional, 0, R_ARM_THM_JUMP8, 0x0fc1, 0, 0x1000)

        expect(forward).to_equal([0x40, 0xe0])
        expect(backward).to_equal([0xe0, 0xd1])
        expect(reloc_apply_arm32(
            unconditional, 0, R_ARM_THM_JUMP11, 0x1801, 0, 0x1000).success).to_equal(false)
        expect(reloc_apply_arm32(
            conditional, 0, R_ARM_THM_JUMP8, 0x1101, 0, 0x1000).success).to_equal(false)

    it "patches split Thumb MOVW and MOVT immediates without changing Rd":
        val movw: [i64] = [0x40, 0xf2, 0x00, 0x00]
        val movt: [i64] = [0xc0, 0xf2, 0x00, 0x00]
        val low = reloc_patch_bytes(
            RelocArch.Arm32, movw, 0, R_ARM_THM_MOVW_ABS_NC, 0x1234, 0, 0)
        val high = reloc_patch_bytes(
            RelocArch.Arm32, movt, 0, R_ARM_THM_MOVT_ABS, 0x12345678, 0, 0)

        expect(low).to_equal([0x41, 0xf2, 0x34, 0x20])
        expect(high).to_equal([0xc1, 0xf2, 0x34, 0x20])
        expect(read_u16_le(low, 0)).to_equal(0xf241)

    it "computes PC-relative Thumb MOVW and MOVT halves":
        val bytes: [i64] = [0, 0, 0, 0]
        val low = reloc_apply_arm32(bytes, 0, R_ARM_THM_MOVW_PREL_NC, 0x12345678, 0, 0x1000)
        val high = reloc_apply_arm32(bytes, 0, R_ARM_THM_MOVT_PREL, 0x12345678, 0, 0x1000)

        expect(low.success).to_equal(true)
        expect(low.value).to_equal(0x4678)
        expect(high.success).to_equal(true)
        expect(high.value).to_equal(0x1234)

    it "applies PREL31 while preserving the compact-unwind flag bit":
        val base: [i64] = [0, 0, 0, 0x80]
        val patched = reloc_patch_bytes(
            RelocArch.Arm32, base, 0, R_ARM_PREL31, 0x1800, 0, 0x1000)
        val too_far = reloc_apply_arm32(
            base, 0, R_ARM_PREL31, 0x40000000, 0, 0)

        expect(patched).to_equal([0x00, 0x08, 0x00, 0x80])
        expect(too_far.success).to_equal(false)

    it "patches ARM-state MOVW and MOVT split immediates":
        val movw: [i64] = [0, 0, 0, 0xe3]
        val movt: [i64] = [0, 0, 0x40, 0xe3]
        val low = reloc_patch_bytes(
            RelocArch.Arm32, movw, 0, R_ARM_MOVW_ABS_NC, 0x1234, 0, 0)
        val high = reloc_patch_bytes(
            RelocArch.Arm32, movt, 0, R_ARM_MOVT_ABS, 0x12345678, 0, 0)
        val relative = reloc_apply_arm32(
            movw, 0, R_ARM_MOVW_PREL_NC, 0x2234, 0, 0x1000)

        expect(low).to_equal([0x34, 0x02, 0x01, 0xe3])
        expect(high).to_equal([0x34, 0x02, 0x41, 0xe3])
        expect(relative.value).to_equal(0x1234)

    it "leaves V4BX marker instructions unchanged":
        val bx: [i64] = [0x1e, 0xff, 0x2f, 0xe1]
        val patched = reloc_patch_bytes(
            RelocArch.Arm32, bx, 0, R_ARM_V4BX, 0, 0, 0)

        expect(patched).to_equal(bx)

# ============================================================================
# x86_64 relocations
# ============================================================================

describe "reloc_engine - x86_64 relocations":
    it "R_X86_64_NONE returns success with value 0":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_NONE returns success with value 0")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_NONE, 0, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0)

    it "R_X86_64_64 computes S + A":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_64 computes S + A")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_64, 0x1000, 8, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1008)

    it "R_X86_64_PC32 computes S + A - P":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_PC32 computes S + A - P")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_PC32, 0x2000, 0, 0x1000)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1000)

    it "R_X86_64_PC64 preserves a full-width negative S + A - P delta":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_PC64 computes a signed 64-bit PC-relative value")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_PC64, 0x1000, -8, 0x3000)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(-8200)

    it "R_X86_64_PC16 and PC8 reject deltas outside their signed fields":
        # @req REQ-SSPEC-COMPILER
        val bytes: [i64] = [0, 0, 0, 0]
        expect(reloc_apply_x86_64(bytes, 0, R_X86_64_PC16, 32767, 0, 0).success).to_equal(true)
        expect(reloc_apply_x86_64(bytes, 0, R_X86_64_PC16, 32768, 0, 0).success).to_equal(false)
        expect(reloc_apply_x86_64(bytes, 0, R_X86_64_PC8, -128, 0, 0).success).to_equal(true)
        val overflow = reloc_apply_x86_64(bytes, 0, R_X86_64_PC8, -129, 0, 0)
        expect(overflow.success).to_equal(false)
        expect(overflow.error).to_contain("signed 8-bit")

    it "R_X86_64_PLT32 computes S + A - P":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_PLT32 computes S + A - P")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_PLT32, 0x3000, -4, 0x1004)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x1FF8)

    it "R_X86_64_32 computes S + A truncated to u32":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32 computes S + A truncated to u32")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_32, 0x400, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x400)

    it "R_X86_64_32S computes S + A":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32S computes S + A")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, R_X86_64_32S, 0x400, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x400)

    it "R_X86_64_32S accepts both signed boundaries and rejects overflow":
        # @req REQ-SSPEC-COMPILER
        step("R_X86_64_32S enforces the signed 32-bit field range")
        val bytes: [i64] = [0, 0, 0, 0]
        val min = reloc_apply_x86_64(bytes, 0, R_X86_64_32S, -2147483648, 0, 0)
        val max = reloc_apply_x86_64(bytes, 0, R_X86_64_32S, 2147483647, 0, 0)
        val below = reloc_apply_x86_64(bytes, 0, R_X86_64_32S, -2147483649, 0, 0)
        val above = reloc_apply_x86_64(bytes, 0, R_X86_64_32S, 2147483648, 0, 0)
        expect(min.success).to_equal(true)
        expect(max.success).to_equal(true)
        expect(below.success).to_equal(false)
        expect(above.success).to_equal(false)
        expect(above.error).to_contain("signed 32-bit")

    it "R_X86_64_16 and R_X86_64_8 enforce zero-extended field ranges":
        # @req REQ-SSPEC-COMPILER
        val bytes: [i64] = [0, 0, 0, 0]
        expect(reloc_apply_x86_64(bytes, 0, R_X86_64_16, 65535, 0, 0).success).to_equal(true)
        expect(reloc_apply_x86_64(bytes, 0, R_X86_64_16, 65536, 0, 0).success).to_equal(false)
        expect(reloc_apply_x86_64(bytes, 0, R_X86_64_8, 255, 0, 0).success).to_equal(true)
        val negative = reloc_apply_x86_64(bytes, 0, R_X86_64_8, -1, 0, 0)
        expect(negative.success).to_equal(false)
        expect(negative.error).to_contain("unsigned 8-bit")

    it "unsupported x86_64 reloc type returns failure with non-empty error":
        # @req REQ-SSPEC-COMPILER
        step("unsupported x86_64 reloc type returns failure with non-empty error")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_x86_64(bytes, 0, 999, 0, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

# ============================================================================
# AArch64 relocations
# ============================================================================

describe "reloc_engine - AArch64 relocations":
    it "R_AARCH64_NONE returns success with value 0":
        # @req REQ-SSPEC-COMPILER
        step("R_AARCH64_NONE returns success with value 0")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_NONE, 0, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0)

    it "R_AARCH64_ABS64 computes S + A":
        # @req REQ-SSPEC-COMPILER
        step("R_AARCH64_ABS64 computes S + A")
        val bytes: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS64, 0x10000, 0, 0)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x10000)

    it "AArch64 ABS32 and ABS16 enforce AAELF64 signed-or-unsigned ranges":
        # @req REQ-SSPEC-COMPILER
        val bytes: [i64] = [0, 0, 0, 0]
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS32, -2147483648, 0, 0).success).to_equal(true)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS32, 4294967295, 0, 0).success).to_equal(true)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS32, 4294967296, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS16, -32768, 0, 0).success).to_equal(true)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS16, 65535, 0, 0).success).to_equal(true)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_ABS16, 65536, 0, 0).success).to_equal(false)

    it "AArch64 PREL32 and PREL16 enforce signed PC-relative ranges":
        # @req REQ-SSPEC-COMPILER
        val bytes: [i64] = [0, 0, 0, 0]
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_PREL32, 2147483647, 0, 0).success).to_equal(true)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_PREL32, 2147483648, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64(bytes, 0, R_AARCH64_PREL16, -32768, 0, 0).success).to_equal(true)
        val overflow = reloc_apply_aarch64(bytes, 0, R_AARCH64_PREL16, 32768, 0, 0)
        expect(overflow.success).to_equal(false)
        expect(overflow.error).to_contain("signed 16-bit")

    it "R_AARCH64_PLT32 computes a checked signed L + A - P delta":
        # @req REQ-SSPEC-COMPILER
        val bytes: [i64] = [0, 0, 0, 0]
        val in_range = reloc_apply_aarch64(bytes, 0, R_AARCH64_PLT32,
            0x3000, -4, 0x1000)
        expect(in_range.success).to_equal(true)
        expect(in_range.value).to_equal(0x1ffc)
        val overflow = reloc_apply_aarch64(bytes, 0, R_AARCH64_PLT32,
            2147483648, 0, 0)
        expect(overflow.success).to_equal(false)
        expect(overflow.error).to_contain("L + A - P")
        expect(elf_reloc_class(RelocArch.AArch64, R_AARCH64_PLT32)).to_equal(RC_BRANCH)

    it "R_AARCH64_CALL26 computes (S + A - P) >> 2 masked to 26 bits":
        # @req REQ-SSPEC-COMPILER
        step("R_AARCH64_CALL26 computes (S + A - P) >> 2 masked to 26 bits")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, R_AARCH64_CALL26, 0x2000, 0, 0x1000)
        expect(result.success).to_equal(true)
        expect(result.value).to_equal(0x400)

    it "AArch64 test and conditional branches patch only their immediate fields":
        # @req REQ-SSPEC-COMPILER
        val tbz = reloc_patch_bytes(RelocArch.AArch64, [0x00, 0x00, 0x00, 0x36],
            0, R_AARCH64_TSTBR14, 0x1040, 0, 0x1000)
        val cond = reloc_patch_bytes(RelocArch.AArch64, [0x00, 0x00, 0x00, 0x54],
            0, R_AARCH64_CONDBR19, 0x1040, 0, 0x1000)
        expect(read_u32_le(tbz, 0)).to_equal(0x36000200)
        expect(read_u32_le(cond, 0)).to_equal(0x54000200)
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_TSTBR14, 0x9000, 0, 0).success).to_equal(false)
        expect(reloc_apply_aarch64([0, 0, 0, 0], 0,
            R_AARCH64_CONDBR19, 3, 0, 0).success).to_equal(false)

    it "unsupported AArch64 reloc type returns failure with non-empty error":
        # @req REQ-SSPEC-COMPILER
        step("unsupported AArch64 reloc type returns failure with non-empty error")
        val bytes: [i64] = [0, 0, 0, 0]
        val result = reloc_apply_aarch64(bytes, 0, 999, 0, 0, 0)
        expect(result.success).to_equal(false)
        expect(result.error.len() > 0).to_equal(true)

