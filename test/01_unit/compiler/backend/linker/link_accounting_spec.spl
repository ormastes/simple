use std.spec
use std.spec.step
use std.common.linker.link_receipt_v1.{LinkAccountingClassV1}
use std.common.perf.execution_metrics.{ResourceUsage, ResourceEvidenceQuality, TerminationCause}
use compiler.backend.linker.link_accounting.{link_accounting_observation_v1}

fn usage(peak: i64, quality: ResourceEvidenceQuality) -> ResourceUsage:
    ResourceUsage(
        wall_ms: 1, user_cpu_ms: 1, system_cpu_ms: 0,
        peak_tree_charge_bytes: peak, peak_direct_child_rss_bytes: 0,
        heap_live_end_bytes: 0, heap_peak_bytes: 0,
        io_read_bytes: 0, io_write_bytes: 0, pids_peak: 1,
        evidence_quality: quality, termination: TerminationCause.Exited,
        signal: 0, exit_code: 0,
    )

describe "linker accounting evidence":
    it "qualifies only exact cgroup tree charge below the admitted limit":
        step("Classify exact-tree evidence on both sides of the strict limit")
        val below = link_accounting_observation_v1(usage(5999999999, ResourceEvidenceQuality.ExactTree), 6000000000)
        assert_equal(below.accounting_class, LinkAccountingClassV1.QualifiedJobScope)
        assert_true(below.certified_under_limit)
        val at_limit = link_accounting_observation_v1(usage(6000000000, ResourceEvidenceQuality.ExactTree), 6000000000)
        assert_equal(at_limit.accounting_class, LinkAccountingClassV1.QualifiedJobScope)
        assert_false(at_limit.certified_under_limit)

    it "never promotes weaker or absent evidence":
        step("Keep process-only measurements outside the release gate")
        val measured = link_accounting_observation_v1(usage(100, ResourceEvidenceQuality.ProcessOnly), 6000000000)
        assert_equal(measured.accounting_class, LinkAccountingClassV1.MeasuredOnly)
        assert_false(measured.certified_under_limit)
        val absent = link_accounting_observation_v1(usage(-1, ResourceEvidenceQuality.Unavailable), 6000000000)
        assert_equal(absent.accounting_class, LinkAccountingClassV1.NotCertified)
        assert_equal(absent.measured_peak_bytes, 0u64)
