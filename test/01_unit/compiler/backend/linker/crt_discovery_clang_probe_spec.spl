use std.spec.*
use compiler.backend.linker.crt_discovery.*

# crt_discovery.spl has no `pub` surface; native_linking.spl re-exports it with
# `use ... crt_discovery.*`, so a parse break there takes every hosted native
# link down with it (2026-11-13: an orphaned `if trace:` block after the gcc
# probe removal did exactly that and no spec imported the module). This spec
# imports it the same way, so a non-parsing crt_discovery fails here first.

describe "crt discovery (clang-only probe)":
    it "loads and exposes its pure path helper":
        # @req REQ-SSPEC-COMPILER
        step("path_dirname of a crtbegin.o path")
        expect(path_dirname("/usr/lib/gcc/x86_64-linux-gnu/13/crtbegin.o")).to_equal("/usr/lib/gcc/x86_64-linux-gnu/13")
        expect(path_dirname("crtbegin.o")).to_equal("")

    it "probes crt lib dirs without executing gcc or bare cc":
        # @req REQ-SSPEC-COMPILER
        step("find_gcc_lib_dirs runs the selected clang driver only")
        # Every directory it returns must exist; the probe itself is the
        # selected clang (`<clang> -print-file-name=crtbegin.o`) or the
        # /usr/lib/gcc/<triplet>/<ver> directory scan, never a gcc/cc process.
        val dirs = find_gcc_lib_dirs()
        var i = 0
        while i < dirs.len():
            expect(dirs[i] != "").to_be(true)
            i = i + 1
