# @cover src/compiler/70.backend/linker/elf/arm32_raw_link.spl
# RISC-V 32 (ELF32, ilp32) raw image link: the shared RISC-V pcrel HI20/LO12 pairing.

use compiler.backend.linker.elf_inspect.{ElfHeader, ElfSectionHeader, SHT_PROGBITS, ET_REL, EM_ARM}
use compiler.backend.linker.elf_parser.{
    ElfObject, ElfSymbol, ElfRelocation, ElfStringTable, elf_make_empty_strtab,
    STB_LOCAL, STB_GLOBAL, STT_NOTYPE, STT_FUNC
}
use compiler.backend.linker.elf.arm32_raw_link.{elf_riscv32_link_parsed}

val RV32_EM_RISCV: i64 = 243

fn rv32_symbol(name: text, binding: i64, section: i64, value: i64, symbol_type: i64) -> ElfSymbol:
    ElfSymbol(st_name: 0, st_info: (binding << 4) | symbol_type,
        st_other: 0, st_shndx: section, st_value: value, st_size: 4, name: name)

# .text (12 bytes): auipc a0,0 ; addi a0,a0,0 ; ret   .data (4 bytes) at section 2.
fn rv32_object(machine: i64, relocations: [ElfRelocation]) -> ElfObject:
    val text_off: i64 = 160
    val data_off: i64 = 172
    var raw: [i64] = [0; 176]
    raw[4] = 1
    val text = [0x17, 0x05, 0x00, 0x00, 0x13, 0x05, 0x05, 0x00, 0x67, 0x80, 0x00, 0x00]
    var i: i64 = 0
    while i < 12:
        raw[text_off + i] = text[i]
        i = i + 1
    val sections = [
        ElfSectionHeader(sh_name: 0, sh_type: 0, sh_flags: 0, sh_addr: 0, sh_size: 0, sh_info: 0),
        ElfSectionHeader(sh_name: 0, sh_type: SHT_PROGBITS, sh_flags: 6,
            sh_addr: text_off, sh_size: 12, sh_info: 0),
        ElfSectionHeader(sh_name: 0, sh_type: SHT_PROGBITS, sh_flags: 3,
            sh_addr: data_off, sh_size: 4, sh_info: 0)
    ]
    # symbols: 0 null, 1 _start (.text+0), 2 target (.data+0), 3 local label .Lpcrel_hi0 (.text+0)
    val symbols = [
        rv32_symbol("", STB_LOCAL, 0, 0, STT_NOTYPE),
        rv32_symbol("_start", STB_GLOBAL, 1, 0, STT_FUNC),
        rv32_symbol("target", STB_GLOBAL, 2, 0, STT_NOTYPE),
        rv32_symbol(".Lpcrel_hi0", STB_LOCAL, 1, 0, STT_NOTYPE)
    ]
    val empty = elf_make_empty_strtab()
    ElfObject(
        header: ElfHeader(e_type: ET_REL, e_machine: machine, e_entry: 0,
            e_phoff: 0, e_shoff: 32, e_shnum: 3, e_shstrndx: 0),
        sections: sections, symbols: symbols, relocations: relocations,
        strtab: empty, shstrtab: empty, raw: raw)

fn rv32_reloc(offset: i64, sym: i64, rtype: i64) -> ElfRelocation:
    ElfRelocation(r_offset: offset, r_info: (sym << 32) | rtype, r_addend: 0,
        section_idx: 0, target_section_idx: 1)

describe "RISC-V 32 raw ELF linker":
    it "pairs PCREL_HI20 with PCREL_LO12_I and patches both fields":
        val obj = rv32_object(RV32_EM_RISCV, [
            rv32_reloc(0, 2, 23), rv32_reloc(4, 3, 24), rv32_reloc(0, 0, 51)])
        val linked = elf_riscv32_link_parsed([obj], 0x80400000, "_start")
        expect(linked.is_ok()).to_equal(true)
        val image = linked.unwrap()
        expect(image.entry_addr).to_equal(0x80400000)
        # target is at +12: hi20 = 0 (auipc unchanged), lo12 = 12 (addi imm)
        expect(image.bytes[0:4]).to_equal([0x17, 0x05, 0x00, 0x00])
        expect(image.bytes[4:8]).to_equal([0x13, 0x05, 0xc5, 0x00])

    it "rejects a PCREL_LO12 whose HI20 is missing":
        val obj = rv32_object(RV32_EM_RISCV, [rv32_reloc(4, 3, 24)])
        val linked = elf_riscv32_link_parsed([obj], 0x80400000, "_start")
        expect(linked.is_err()).to_equal(true)
        expect(linked.unwrap_err().contains("no matching HI20")).to_equal(true)

    it "rejects R_RISCV_ALIGN padding (not shrunk in a raw image)":
        val obj = rv32_object(RV32_EM_RISCV, [rv32_reloc(8, 0, 43)])
        expect(elf_riscv32_link_parsed([obj], 0x80400000, "_start").is_err()).to_equal(true)

    it "rejects a non-RISC-V object":
        val obj = rv32_object(EM_ARM, [])
        expect(elf_riscv32_link_parsed([obj], 0x80400000, "_start").is_err()).to_equal(true)

    it "places .text.boot before .text so the entry stub sits at the image base":
        val base_obj = rv32_object(RV32_EM_RISCV, [])
        var raw = base_obj.raw
        raw[172] = 0x6f
        raw[173] = 0x00
        raw[174] = 0x00
        raw[175] = 0x00
        val names: [u8] = [0, 46, 116, 101, 120, 116, 46, 98, 111, 111, 116, 0]
        val shstr = ElfStringTable(data: names, offset: 0)
        val boot = ElfSectionHeader(sh_name: 1, sh_type: SHT_PROGBITS, sh_flags: 6,
            sh_addr: 172, sh_size: 4, sh_info: 0)
        val sections = [base_obj.sections[0], base_obj.sections[1], boot]
        val symbols = [
            rv32_symbol("", STB_LOCAL, 0, 0, STT_NOTYPE),
            rv32_symbol("_start", STB_GLOBAL, 2, 0, STT_FUNC)
        ]
        val obj = ElfObject(header: base_obj.header, sections: sections, symbols: symbols,
            relocations: [], strtab: base_obj.strtab, shstrtab: shstr, raw: raw)
        val image = elf_riscv32_link_parsed([obj], 0x80400000, "_start").unwrap()
        expect(image.entry_addr).to_equal(0x80400000)
        expect(image.bytes[0:4]).to_equal([0x6f, 0x00, 0x00, 0x00])
        expect(image.bytes[4:8]).to_equal([0x17, 0x05, 0x00, 0x00])
