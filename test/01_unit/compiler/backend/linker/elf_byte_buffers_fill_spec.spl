# elf_u8_filled: bulk byte fill (doubling native copies) used for the x86 int3 text fill.
use std.spec.*
use compiler.backend.linker.elf.byte_buffers.{elf_u8_filled, elf_u8_zeros}

fn all_eq(b: [u8], v: i64) -> bool:
    for x in b:
        if (x as i64) != v:
            return false
    true

describe "elf_u8_filled":
    it "fills exactly count bytes with the byte, including non-power-of-two counts":
        for n in [0, 1, 2, 3, 7, 8, 9, 4095, 4097]:
            val b = elf_u8_filled(n, 0xccu8)
            expect(b.len()).to_equal(n)
            expect(all_eq(b, 0xcc)).to_equal(true)

    it "keeps elf_u8_zeros as the zero fill":
        val z = elf_u8_zeros(5)
        expect(z.len()).to_equal(5)
        expect(all_eq(z, 0)).to_equal(true)
