# Regression: native-built stage3 emitted `store i64 %l141733920772` (an
# undefined local) for `KpfDigest256(w0: 0, w1: 0, w2: 0, w3: 0)` in
# lib.common.kernel_plugin.ids.kpf_digest256_zero. The aggregate emitter passed
# the indexed enum element `operands[i]` BY VALUE into translate_operand /
# get_operand_type; under native codegen that copy loses the MirOperandKind
# payload and the LocalId is read from garbage. The index-based helpers
# (translate_operand_at / get_operand_type_at) read the element inside the
# callee and are the established fix for this miscompile class.
use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "LLVM aggregate emission operand access":
    it "never passes an indexed operands[i] element by value":
        val src = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl"
        ) ?? ""
        expect(src.len() > 0).to_equal(true)
        expect(src.contains("self.translate_operand(operands[i])")).to_equal(false)
        expect(src.contains("self.get_operand_type(operands[i])")).to_equal(false)
        expect(src).to_contain("self.translate_operand_at(operands, i)")
        expect(src).to_contain("self.get_operand_type_at(operands, i)")
