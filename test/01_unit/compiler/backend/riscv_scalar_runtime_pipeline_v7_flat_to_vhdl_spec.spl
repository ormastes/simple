use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v7_flat.{strict_riscv_scalar_runtime_pipeline_v7_flat_direct}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v7_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v7_flat, scalar_runtime_pipeline_v7_flat_driver_closure_diagnostic, scalar_runtime_pipeline_v7_flat_aggregate_child_entity_diagnostic, scalar_runtime_pipeline_v7_flat_route_receipt}

fn rv64im() -> CoreConfig: CoreConfig.rv64im()

fn rv32im() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "rv32-im", isa_profile: "rv32im", compressed_decode_profile: "none")

describe "strict flattened runtime scalar pipeline v7 VHDL emission":
    it "renders the direct IM graph with one unified M child and route receipt":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v7_flat_direct("runtime_pipeline_v7_rv64", rv64im(), LsuConfig.rv64_product_default()).unwrap()
        expect(scalar_runtime_pipeline_v7_flat_driver_closure_diagnostic(pipeline)).to_equal("")
        val result = compile_strict_riscv_scalar_runtime_pipeline_v7_flat("runtime_pipeline_v7_rv64", rv64im(), LsuConfig.rv64_product_default())
        expect(result.is_success()).to_equal(true)
        if result.is_success():
            expect(result.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v7-flat-direct")
            expect(result.hwir_graph_sha256).to_equal(pipeline.structural_sha256())
            expect(result.vhdl).to_contain("-- simple-hwir v7-flat-route-receipt=" + scalar_runtime_pipeline_v7_flat_route_receipt(pipeline))
            expect(result.vhdl).to_contain("-- simple-hwir child-muldiv=" + pipeline.muldiv.structural_sha256())
            expect(result.vhdl).to_contain("muldiv: entity work." + pipeline.muldiv.entity_name)
            expect(result.vhdl).to_contain("wire_o6_muldiv_p13_request_valid <= source_o7_pending_p20_muldiv_request_valid")
            expect(result.vhdl).to_contain("wire_o7_pending_p21_muldiv_request_accept <= source_o6_muldiv_p14_request_accept")
            expect(result.vhdl).to_contain("completion_rd_value : out std_logic_vector(63 downto 0)")

    it "retains the V7 route when canonical construction rejects input":
        val result = compile_strict_riscv_scalar_runtime_pipeline_v7_flat("", rv32im(), LsuConfig.rv32_product_default())
        expect(result.is_success()).to_equal(false)
        expect(result.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v7-flat-direct")
        expect(result.diagnostic).to_contain("HWIR-E-RISCV-RUNTIME-PIPELINE-V7-ID")

    it "rejects case-insensitive aggregate entity collisions with different graphs":
        expect(scalar_runtime_pipeline_v7_flat_aggregate_child_entity_diagnostic(
            ["provider_rtl", "PROVIDER_RTL"], ["graph-a", "graph-b"])).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-V7-FLAT-VHDL-ENTITY-COLLISION: one case-insensitive child entity name requires one exact graph")
        expect(scalar_runtime_pipeline_v7_flat_aggregate_child_entity_diagnostic(
            ["provider_rtl", "PROVIDER_RTL"], ["graph-a", "graph-a"])).to_equal("")
