use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirInst}

describe "LLVM dest-defined tracking for GPU/SIMD/VHDL instructions":
    it "marks a GpuGlobalId destination as defined so a direct return does not fall back to 0":
        val llvm = MirToLlvm.create("test.llvm.gpu_dest_defined", CodegenTarget.X86_64, nil)
        val dest = LocalId(id: 9)
        val inst = MirInst(kind: MirInstKind.GpuGlobalId(dest, 0), span: nil)
        llvm.mark_instruction_dest_defined_at([inst], 0)
        expect(llvm.defined_locals.has(9)).to_equal(true)

    it "marks a SimdAddF32x4 destination as defined so a direct return does not fall back to 0":
        val llvm = MirToLlvm.create("test.llvm.simd_dest_defined", CodegenTarget.X86_64, nil)
        val dest = LocalId(id: 11)
        val a = mir_operand_copy(LocalId(id: 1))
        val b = mir_operand_copy(LocalId(id: 2))
        val inst = MirInst(kind: MirInstKind.SimdAddF32x4(dest, a, b), span: nil)
        llvm.mark_instruction_dest_defined_at([inst], 0)
        expect(llvm.defined_locals.has(11)).to_equal(true)
