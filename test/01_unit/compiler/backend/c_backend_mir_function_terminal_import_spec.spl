"""
# C backend MirFunction terminal-owner contract

The split C translator imports `MirFunction` from its declaring MIR graph
module.  This keeps strict staged HIR lowering independent of compatibility
facade re-export materialization.
"""

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use compiler.backend.backend.c_backend_translate.{MirToC}
use compiler.mir.mir_instruction_graph.{MirFunction}

fn c_backend_terminal_function_name(function: MirFunction) -> text:
    function.name

describe "C backend MirFunction terminal imports":
    it "compiles the C translator surface with the terminal MIR type identity":
        val translator = MirToC.create("terminal.import.contract")
        translator.builder.emit_raw("terminal-import-ok")
        expect(translator.builder.build()).to_contain("terminal-import-ok")

    it "pins both split owners to mir_instruction_graph":
        val class_core = file_read(
            "src/compiler/70.backend/backend/_CBackendTranslate/class_core.spl")
        val instruction_lowering = file_read(
            "src/compiler/70.backend/backend/_CBackendTranslate/instruction_lowering.spl")
        val terminal_import =
            "use compiler.mir.mir_instruction_graph.\{MirFunction\}"
        val facade_member =
            "compiler.mir.mir_instructions.\{MirModule, MirFunction"

        expect(class_core).to_contain(terminal_import)
        expect(instruction_lowering).to_contain(terminal_import)
        expect(class_core).to_not_contain(facade_member)
        expect(instruction_lowering).to_not_contain(facade_member)
