use std.spec.*
use compiler.backend.native.parser_lexical_avx2_classifier_v1.*

describe "AVX2 lexical candidate classifier V1":
    it "declares a distinct exact callable interface and size":
        expect(PARSER_LEXICAL_CLASSIFIER_INTERFACE_HANDLE_V1).to_equal(0x4c45584d41534b31u64)
        expect(PARSER_LEXICAL_CLASSIFIER_CODE_SIZE_V1).to_equal(25u64)

    it "emits the exact SysV one-mask callable bytes":
        expect(parser_lexical_avx2_one_mask_callable_bytes_v1(true).unwrap()).to_equal([
            0xC5,0xFE,0x6F,0x07, 0xC5,0xF9,0x6E,0xCE,
            0xC4,0xE2,0x7D,0x78,0xC9, 0xC5,0xFD,0x74,0xC1,
            0xC5,0xFD,0xD7,0xC0, 0xC5,0xF8,0x77, 0xC3])
        expect(parser_lexical_avx2_one_mask_callable_bytes_v1(false)).to_equal(
            Err(ParserLexicalClassifierErrorV1.Avx2Unavailable))

    it "classifies exact masks including high bytes without mutating input":
        val bytes = [39u8,34u8,92u8,35u8,10u8,47u8,42u8,123u8,125u8,
            40u8,41u8,91u8,93u8,44u8,58u8,255u8] + [0u8 for _ in 0..16]
        val before = bytes
        val r = parser_lexical_candidate_masks_scalar_v1(bytes).unwrap()
        expect(r.single_quote).to_equal(1u32)
        expect(r.double_quote).to_equal(2u32)
        expect(r.backslash).to_equal(4u32)
        expect(r.hash).to_equal(8u32)
        expect(r.newline).to_equal(16u32)
        expect(r.slash).to_equal(32u32)
        expect(r.star).to_equal(64u32)
        expect(r.braces).to_equal(384u32)
        expect(r.structural_delimiters).to_equal(32640u32)
        expect(bytes).to_equal(before)

    it "rejects tails rather than overreading":
        expect(parser_lexical_candidate_masks_scalar_v1([])).to_equal(
            Err(ParserLexicalClassifierErrorV1.RequiresExactBlock))
        expect(parser_lexical_candidate_masks_scalar_v1([0u8 for _ in 0..31])).to_equal(
            Err(ParserLexicalClassifierErrorV1.RequiresExactBlock))
