# Regression: wildcard import of c_backend_stubs must not poison the session
# (bug wildcard_import_c_backend_stubs_function_to_int_2026-07-30).
use plugins.backend_c.c_backend_translate.{MirToC}
use plugins.backend_c.c_backend_stubs.*

describe "wildcard import of c_backend_stubs":
    it "runs a trivial body and exits cleanly":
        expect(1).to_equal(1)
    it "keeps integer arithmetic intact after the wildcard import":
        val n = 2 + 3
        expect(n).to_equal(5)
