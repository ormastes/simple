# Purpose and audience: executable specification evidence for the owning engineering team.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec
use std.io_runtime.{file_read}

describe "backend declaration name collision guards":
    """
    Purpose: this manual pins the behavior named "backend declaration name collision guards" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    it "keeps backend facade construction off the globally ambiguous Backend name":
        # @req REQ-SSPEC-UNIT
        step("keeps backend facade construction off the globally ambiguous Backend name")
        val src = file_read("src/compiler/70.backend/backend/backend_api.spl")
        expect(src).to_contain("class CompilerBackend:")
        expect(src).to_contain("type Backend = CompilerBackend")
        assert_false(src.contains("\nclass Backend:"))
        assert_false(src.contains("\n        Backend("))
        assert_false(src.contains("Ok(Backend("))

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
    it "keeps legacy cranelift state construction off the globally ambiguous Codegen name":
        # @req REQ-SSPEC-UNIT
        step("keeps legacy cranelift state construction off the globally ambiguous Codegen name")
        val src = file_read("src/compiler/70.backend/codegen.spl")
        expect(src).to_contain("struct CraneliftCodegenState:")
        expect(src).to_contain("type Codegen = CraneliftCodegenState")
        assert_false(src.contains("\nstruct Codegen:"))
        assert_false(src.contains("Codegen.new("))
        assert_false(src.contains("\n        Codegen("))

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
    it "keeps HIR symbol table construction off the globally ambiguous Symbol name":
        # @req REQ-SSPEC-UNIT
        step("keeps HIR symbol table construction off the globally ambiguous Symbol name")
        val src = file_read("src/compiler/20.hir/hir_types.spl")
        expect(src).to_contain("struct HirSymbol:")
        expect(src).to_contain("type Symbol = HirSymbol")
        expect(src.contains("\nstruct Symbol:")).to_equal(false)
        expect(src.contains("\n        val symbol = Symbol(")).to_equal(false)
        expect(src.contains("var type_symbol: Symbol = Symbol(")).to_equal(false)
