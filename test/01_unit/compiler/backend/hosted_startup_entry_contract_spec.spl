use std.io_runtime.{file_read}
use std.spec.{describe, it, expect}

describe "Hosted native startup entry contract":
    it "invokes startup before runtime and module initialization and main":
        val source = file_read("src/compiler/70.backend/backend/llvm_native_link_hosted_support.spl")
        val call_pos = source.find("__simple_startup_before_main(argc, argv) != 0")
        val runtime_pos = source.find("    __simple_runtime_init();")
        val module_pos = source.find("    {{name}}();")
        val main_pos = source.find("    long long result = __simple_main();")
        expect(call_pos).to_be_greater_than(-1)
        expect(runtime_pos).to_be_greater_than(call_pos)
        expect(module_pos).to_be_greater_than(runtime_pos)
        expect(main_pos).to_be_greater_than(module_pos)
        expect(source).to_contain("return 125")

    it "keeps optional startup bindings linkable on ELF Mach-O MinGW and MSVC":
        val source = file_read("src/compiler/70.backend/backend/llvm_native_link_hosted_support.spl")
        expect(source).to_contain("#if defined(_MSC_VER)")
        expect(source).to_contain("/alternatename:__simple_startup_before_main=__simple_startup_before_main_default")
        expect(source).to_contain("/alternatename:___simple_startup_before_main=___simple_startup_before_main_default")
        expect(source).to_contain("#elif defined(__APPLE__) || defined(_WIN32)")
        expect(source).to_contain("int __attribute__((weak)) __simple_startup_before_main")
        expect(source).to_contain("extern int __simple_startup_before_main(int argc, char** argv) __attribute__((weak));")
