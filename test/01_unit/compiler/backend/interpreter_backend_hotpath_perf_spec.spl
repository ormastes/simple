"""
## Purpose and audience
Purpose: Verify Wave B3 hot-path optimizations and boundary safety in the
pure-Simple HIR backend interpreter:
1. Memoized SIMPLE_INTERP_TRACE + guarded interpolated itrace(...) calls.
2. Pre-indexed O(1) module tables on EvalContext with default {} fields and
   cached lazy fallback, plus early break in try_construct_struct.
3. Bounded integer range streaming in eval_for without [Value] allocation,
   including inclusive i64::MAX and i64::MIN step wraparound guards.
Audience: compiler and backend interpreter maintainers.
"""
# @cover src/compiler/70.backend/backend/interpreter.spl
# @cover src/compiler/70.backend/backend/interpreter_calls.spl
# @cover src/compiler/70.backend/backend/interpreter_expr.spl
# @cover src/compiler/70.backend/backend/interpreter_control.spl
# @cover src/compiler/70.backend/backend/env.spl

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read, env_set_process}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.backend.backend_types.*
use compiler.backend.env.{Environment, EvalContext, ModuleByNameMap}
use compiler.backend.interpreter.{
    InterpreterBackendImpl,
    interp_trace_enabled,
    interp_refresh_trace_cache
}
use compiler.backend.interpreter_calls.{
    interp_module_index_rebuild_count,
    interp_reset_module_index_rebuild_count
}
use compiler.backend.interpreter_control.{
    interp_range_array_alloc_count,
    interp_reset_range_array_alloc_count
}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}

fn hp_lower(src: text, path: text, module_name: text) -> HirModule:
    val module = parse_full_frontend(src, path, module_name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    lowering.lower_module(module)

fn hp_lower_importing(src: text, path: text, module_name: text, dep_src: text, dep_path: text, dep_name: text) -> HirModule:
    val log = Logger(level: 0)
    val dep_module = parse_full_frontend(dep_src, dep_path, dep_name, log)
    val module = parse_full_frontend(src, path, module_name, log)
    var modules: Dict<text, Module> = {}
    modules[dep_name] = dep_module
    modules[module_name] = module
    val sources = [
        SourceFile(path: dep_path, content: dep_src, module_name: dep_name),
        SourceFile(path: path, content: src, module_name: module_name)
    ]
    var lowering = hirlowering_for_module(path, module_surfaces_from_modules(modules, sources).unwrap())
    lowering.lower_module(module)

fn hp_run_int(hir: HirModule) -> i64:
    var backend = InterpreterBackendImpl.new()
    match backend.interpret_hir_module(hir):
        case Ok(BackendResult.Value(Value.Int(n))): n
        case _: -999999

fn hp_run_stepped_range_hits(a: i64, b: i64, inclusive: bool, step_by: i64) -> i64:
    val tmpl_hir = hp_lower(
        "fn main() -> i64:\n    var hits = 0\n    hits = hits + 1\n    hits\n",
        "hp_step_tmpl.spl",
        "hp_step_tmpl"
    )
    var main_fn_opt: HirFunction? = None
    for fn_item in tmpl_hir.functions.values():
        val f: HirFunction = fn_item
        if f.name == "main":
            main_fn_opt = Some(f)
    val main_fn = main_fn_opt.unwrap()
    val tmpl_expr: HirExpr = main_fn.body.value
    val inc_stmt: HirStmt = main_fn.body.stmts[1]
    val loop_body = HirBlock(
        stmts: [inc_stmt],
        has: false,
        value: tmpl_expr,
        span: main_fn.body.span
    )
    val start_expr = HirExpr(kind: HirExprKind.IntLit(a, nil), has_type_: tmpl_expr.has_type_, type_: tmpl_expr.type_, span: tmpl_expr.span)
    val end_expr = HirExpr(kind: HirExprKind.IntLit(b, nil), has_type_: tmpl_expr.has_type_, type_: tmpl_expr.type_, span: tmpl_expr.span)
    val step_expr = HirExpr(kind: HirExprKind.IntLit(step_by, nil), has_type_: tmpl_expr.has_type_, type_: tmpl_expr.type_, span: tmpl_expr.span)
    val backend = InterpreterBackendImpl.new()
    val env = Environment.new()
    env.define("hits", backend_value_int_v1(0))
    var names_map: Dict<i64, text> = {}
    for sym_item in tmpl_hir.symbols.symbols.values():
        val s: HirSymbol = sym_item
        val sid: i64 = s.id.id
        names_map[sid] = s.name
    val ctx = EvalContext(
        env: env,
        module: tmpl_hir,
        backend: backend,
        names: names_map
    )
    match backend.eval_for_bounded_range(main_fn.symbol, start_expr, end_expr, inclusive, Some(step_expr), loop_body, ctx, tmpl_expr.span):
        case Ok(_):
            match ctx.env.lookup("hits"):
                case Some(Value.Int(total)): total
                case _: -999998
        case Err(_): -999997

describe "HIR backend interpreter hot-path optimizations (Wave B3)":
    it "memoizes SIMPLE_INTERP_TRACE across calls and refreshes on module entry":
        val hir = hp_lower("fn main() -> i64:\n    7\n", "hp_trace.spl", "hp_trace")
        var backend = InterpreterBackendImpl.new()

        env_set_process("SIMPLE_INTERP_TRACE", "0")
        interp_refresh_trace_cache()
        expect(interp_trace_enabled()).to_equal(false)

        # Mutating the OS env mid-run must NOT flip the cached flag until module entry.
        env_set_process("SIMPLE_INTERP_TRACE", "1")
        expect(interp_trace_enabled()).to_equal(false)

        # Module entry refreshes the cached trace flag.
        match backend.interpret_hir_module(hir):
            case Ok(BackendResult.Value(Value.Int(v))): expect(v).to_equal(7)
            case _: expect(false).to_equal(true)
        expect(interp_trace_enabled()).to_equal(true)

        # Restore disabled trace state and confirm module entry refreshes back to false.
        env_set_process("SIMPLE_INTERP_TRACE", "0")
        match backend.interpret_hir_module(hir):
            case Ok(BackendResult.Value(Value.Int(v2))): expect(v2).to_equal(7)
            case _: expect(false).to_equal(true)
        expect(interp_trace_enabled()).to_equal(false)

    it "guards interpolated itrace probes behind interp_trace_enabled":
        val interp_src = file_read("src/compiler/70.backend/backend/interpreter.spl")
        val calls_src = file_read("src/compiler/70.backend/backend/interpreter_calls.spl")
        val expr_src = file_read("src/compiler/70.backend/backend/interpreter_expr.spl")

        expect(interp_src).to_contain("var _interp_trace_cached: i64 = -1")
        expect(interp_src).to_contain("pub fn interp_trace_enabled() -> bool:")
        expect(interp_src).to_contain("if interp_trace_enabled():\n            itrace(\"[ES] exec_stmt entry disc=")
        expect(calls_src).to_contain("if interp_trace_enabled():\n            itrace(\"[TCB] try_call_builtin name=")
        expect(expr_src).to_contain("if interp_trace_enabled():\n            itrace(\"[EE] eval_expr entry disc=")

    it "pre-indexes entry and provider modules once across repeated calls and method dispatches":
        val dep_src = (
            "pub fn add_bias(x: i64) -> i64:\n" +
            "    x + 3\n"
        )
        val entry_src = (
            "use hp_dep.\{add_bias\}\n\n" +
            "struct First:\n" +
            "    v: i64\n\n" +
            "struct UnusedA:\n" +
            "    a: i64\n\n" +
            "struct UnusedB:\n" +
            "    b: i64\n\n" +
            "impl First:\n" +
            "    fn doubled() -> i64:\n" +
            "        self.v * 2\n\n" +
            "fn main() -> i64:\n" +
            "    var total = 0\n" +
            "    for i in 0..25:\n" +
            "        val item = First(v: add_bias(i))\n" +
            "        total = total + item.doubled()\n" +
            "    total\n"
        )
        val provider = hp_lower(dep_src, "hp_dep.spl", "hp_dep")
        val entry = hp_lower_importing(entry_src, "hp_entry.spl", "hp_entry", dep_src, "hp_dep.spl", "hp_dep")
        var providers: Dict<text, HirModule> = {}
        providers["hp_dep"] = provider
        val no_ownership_providers: Dict<text, HirModule> = {}

        interp_reset_module_index_rebuild_count()
        var backend = InterpreterBackendImpl.new()
        match backend.interpret_hir_module_with_live_providers(entry, no_ownership_providers, providers):
            case Ok(BackendResult.Value(Value.Int(ans))):
                # sum_{i=0..24} 2*(i + 3) = 2 * (300 + 75) = 750
                expect(ans).to_equal(750)
            case _:
                expect(false).to_equal(true)
        # Exactly 2 module index builds: 1 for entry + 1 for hp_dep across all 25 iterations.
        expect(interp_module_index_rebuild_count()).to_equal(2)

    it "supports default empty EvalContext index fields with cached lazy fallback":
        val dep_hir = hp_lower("pub fn bump(n: i64) -> i64:\n    n + 1\n", "hp_lazy_dep.spl", "hp_lazy_dep")
        val entry_hir = hp_lower(
            "struct Boxed:\n    x: i64\n\nimpl Boxed:\n    fn get_x() -> i64:\n        self.x\n\nfn main() -> i64:\n    0\n",
            "hp_lazy_entry.spl",
            "hp_lazy_entry"
        )
        var owners: ModuleByNameMap = {}
        owners["bump"] = dep_hir
        val backend = InterpreterBackendImpl.new()
        val env = Environment.new()
        val manual_ctx = EvalContext(
            env: env,
            module: entry_hir,
            backend: backend,
            fn_owner: owners,
            has_fn_owner: true
        )

        interp_reset_module_index_rebuild_count()
        var k = 0
        while k < 15:
            val pctx_opt = backend.provider_context_for("bump", manual_ctx)
            expect(pctx_opt.?).to_equal(true)
            k = k + 1
        var fields: Dict<text, Value> = {}
        fields["x"] = Value.Int(19)
        val recv = Value.Struct("Boxed", fields)
        var m = 0
        while m < 10:
            match backend.call_method_by_key("Boxed::get_x", [recv], manual_ctx):
                case Some(Ok(Value.Int(got))): expect(got).to_equal(19)
                case _: expect(false).to_equal(true)
            m = m + 1
        # Lazy fallback builds each module's index once and reuses it from Environment.
        expect(interp_module_index_rebuild_count()).to_equal(2)

    it "streams bounded integer for-ranges without allocating a Value array":
        val stream_hir = hp_lower(
            "fn main() -> i64:\n" +
            "    var s1 = 0\n" +
            "    for i in 0..6:\n" +
            "        s1 = s1 + i\n" +
            "    var s2 = 0\n" +
            "    for j in 1..=5:\n" +
            "        s2 = s2 + j\n" +
            "    var s3 = 0\n" +
            "    for huge in 0..1000000000:\n" +
            "        if huge == 1:\n" +
            "            continue\n" +
            "        s3 = s3 + huge\n" +
            "        if huge == 4:\n" +
            "            break\n" +
            "    s1 * 100 + s2 * 10 + s3\n",
            "hp_range_stream.spl",
            "hp_range_stream"
        )
        interp_reset_range_array_alloc_count()
        # s1 = 15, s2 = 15, s3 = 0 + 2 + 3 + 4 = 9 -> 1500 + 150 + 9 = 1659
        expect(hp_run_int(stream_hir)).to_equal(1659)
        expect(interp_range_array_alloc_count()).to_equal(0)

        # Non-for range consumers (e.g. list comprehensions) still materialize via eval_range.
        val comp_hir = hp_lower(
            "fn main() -> i64:\n" +
            "    val xs = [i * 2 for i in 1..=3]\n" +
            "    xs[0] + xs[1] + xs[2]\n",
            "hp_range_comp.spl",
            "hp_range_comp"
        )
        expect(hp_run_int(comp_hir)).to_equal(12)
        expect(interp_range_array_alloc_count()).to_equal(1)

    it "stops inclusive bounded for-ranges safely at i64::MAX and i64::MIN without wraparound":
        """Verify eval_for_bounded_range breaks cleanly before signed i64 wraparound on positive and negative steps."""
        val max_hir = hp_lower(
            "fn main() -> i64:\n" +
            "    val hi = 9223372036854775807\n" +
            "    val lo = hi - 2\n" +
            "    var count = 0\n" +
            "    for i in lo..=hi:\n" +
            "        count = count + 1\n" +
            "    count\n",
            "hp_range_max.spl",
            "hp_range_max"
        )
        interp_reset_range_array_alloc_count()
        expect(hp_run_int(max_hir)).to_equal(3)
        expect(interp_range_array_alloc_count()).to_equal(0)

        val max_i64: i64 = 9223372036854775807
        val min_i64: i64 = -9223372036854775807 - 1
        expect(hp_run_stepped_range_hits(max_i64 - 3, max_i64, true, 2)).to_equal(2)
        expect(hp_run_stepped_range_hits(min_i64 + 2, min_i64, true, -1)).to_equal(3)
        expect(hp_run_stepped_range_hits(min_i64 + 3, min_i64, true, -2)).to_equal(2)
