use std.spec.*
use compiler.backend.runtime_xray_context_policy_v1.*

describe "resident XRay runtime thread object policy":
    it "preserves Off on every otherwise unsupported provider":
        expect(runtime_xray_context_validate_v1(false, "", "windows", "rust", false, true).unwrap()).to_equal(false)
        expect(runtime_xray_context_cache_suffix_v1(false)).to_equal("")
        expect(runtime_xray_context_flags_v1(false, "runtime_thread")).to_equal([])

    it "admits only exact Linux GNU source-built core-C variants":
        expect(runtime_xray_context_validate_v1(true, "aarch64-unknown-linux-gnu", "linux", "c", true, false).unwrap()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "x86_64-unknown-linux-gnu", "linux", "c", true, false).unwrap()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "host", "linux", "c", true, false).is_err()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "x86_64-unknown-linux-musl", "linux", "c", true, false).is_err()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "x86_64-unknown-linux-gnu", "windows", "c", true, false).is_err()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "x86_64-unknown-linux-gnu", "linux", "rust", true, false).is_err()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "x86_64-unknown-linux-gnu", "linux", "c", false, false).is_err()).to_equal(true)
        expect(runtime_xray_context_validate_v1(true, "x86_64-unknown-linux-gnu", "linux", "c", true, true).is_err()).to_equal(true)

    it "changes only source owners and enabled cache identities":
        expect(runtime_xray_context_cache_suffix_v1(true)).to_equal(";xray_thread_context_v1=1")
        expect(runtime_xray_context_flags_v1(true, "runtime_thread")).to_equal(["-DSIMPLE_XRAY_CONTEXT_HOOKS_V1=1"])
        expect(runtime_xray_context_flags_v1(true, "runtime_pool")).to_equal(["-DSIMPLE_XRAY_CONTEXT_HOOKS_V1=1"])
        expect(runtime_xray_context_flags_v1(true, "runtime_native")).to_equal([])
