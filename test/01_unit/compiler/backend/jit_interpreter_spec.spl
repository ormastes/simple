#!/usr/bin/env simple
# JIT Interpreter Backend Tests
#
# Tests for the hybrid JIT+interpreter backend.
#
# NOTE: This is a minimal smoke test since the full implementation
# requires MIR lowering which is not yet complete in Simple.

use std.spec.{describe, it, expect}
use compiler.backend.jit_interpreter.{
    JitMode,
    JitInterpreterConfig,
    JitInterpreterBackend
}
use compiler.backend.backend_types.{BackendKind}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction}

fn _jit_spec_lower(src: text, mod_name: text) -> HirModule:
    val vpath = "test/{mod_name}.spl"
    val log = Logger(level: 0)
    val ast = parse_full_frontend(src, vpath, mod_name, log)
    var modules: Dict<text, Module> = {}
    modules[mod_name] = ast
    val sources = [SourceFile(path: vpath, content: src, module_name: mod_name)]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var hl = hirlowering_for_module(vpath, surfaces)
    hl.lower_module(ast)

fn _jit_spec_find_fn(hir: HirModule, name: text) -> HirFunction:
    var found: HirFunction? = None
    for fn_item in hir.functions.values():
        val f: HirFunction = fn_item
        if f.name == name:
            found = Some(f)
    found.unwrap()

describe "JitInterpreterBackend":
    describe "Configuration":
        it "creates with default mode and threshold":
            val cfg = JitInterpreterConfig.default()
            expect(cfg.mode).to_equal(JitMode.Auto)
            expect(cfg.backend).to_equal("auto")
            expect(cfg.jit_threshold).to_equal(10)
            val backend = JitInterpreterBackend.default()
            expect(backend.name()).to_equal("jit-interpreter")
            expect(backend.kind()).to_equal(BackendKind.Interpreter)
            expect(backend.module_prescans).to_equal(0)

        it "supports hybrid, always_jit, and interpret_only modes":
            val hybrid = JitInterpreterBackend.new(JitInterpreterConfig.hybrid(4))
            expect(hybrid.config.mode).to_equal(JitMode.Hybrid)
            expect(hybrid.config.jit_threshold).to_equal(4)
            val always_jit = JitInterpreterBackend.new(JitInterpreterConfig.always_jit())
            expect(always_jit.kind()).to_equal(BackendKind.CraneliftJit)
            val interp_only = JitInterpreterBackend.new(JitInterpreterConfig.interpret_only())
            expect(interp_only.should_jit_compile("anything")).to_equal(false)

    describe "Per-Module Lowering and CFG Cache":
        it "caches cfg_winners and module inventory prescan across functions in the same module":
            val src_a = "enum Color:\n    Red\n    Blue\n\nfn first_fn(c: Color) -> i64:\n    match c:\n        Color.Red: 1\n        Color.Blue: 2\n\nfn second_fn(x: i64) -> i64:\n    x + 1\n"
            val src_b = "fn third_fn(x: i64) -> i64:\n    x * 2\n"
            val mod_a = _jit_spec_lower(src_a, "jit_cache_mod_a")
            val mod_b = _jit_spec_lower(src_b, "jit_cache_mod_b")

            var backend = JitInterpreterBackend.new(JitInterpreterConfig.auto_jit())
            backend.record_call("first_fn")
            backend.record_call("second_fn")
            backend.record_call("third_fn")

            val r1 = backend.try_jit_compile(_jit_spec_find_fn(mod_a, "first_fn"), mod_a)
            expect(r1.is_ok()).to_equal(true)
            val err1 = backend.jit_failed["first_fn"] ?? ""
            expect(err1.contains("MIR lowering failed")).to_equal(false)
            expect(err1.contains("unknown variant")).to_equal(false)
            expect(backend.module_prescans).to_equal(1)

            val r2 = backend.try_jit_compile(_jit_spec_find_fn(mod_a, "second_fn"), mod_a)
            expect(r2.is_ok()).to_equal(true)
            val err2 = backend.jit_failed["second_fn"] ?? ""
            expect(err2.contains("MIR lowering failed")).to_equal(false)
            expect(backend.module_prescans).to_equal(1)
            expect(backend.compile_attempts).to_equal(2)

            val r3 = backend.try_jit_compile(_jit_spec_find_fn(mod_b, "third_fn"), mod_b)
            expect(r3.is_ok()).to_equal(true)
            val err3 = backend.jit_failed["third_fn"] ?? ""
            expect(err3.contains("MIR lowering failed")).to_equal(false)
            expect(backend.module_prescans).to_equal(2)
            expect(backend.compile_attempts).to_equal(3)

        it "does not collide same-named modules with equal declaration counts and distinct signatures or impls":
            val v1_src = "struct BoxVal:\n    x: i64\n\nimpl BoxVal:\n    fn get(self) -> i64:\n        self.x\n\nfn compute(a: i64) -> i64:\n    a + 1\n"
            val v2_src = "struct BoxVal:\n    x: f64\n\nimpl BoxVal:\n    fn value(self) -> f64:\n        self.x\n\nfn compute_v2(a: f64) -> f64:\n    a + 1.0\n"
            val mod_v1 = _jit_spec_lower(v1_src, "jit_reload_same_name")
            val mod_v2 = _jit_spec_lower(v2_src, "jit_reload_same_name")

            var backend = JitInterpreterBackend.new(JitInterpreterConfig.auto_jit())
            backend.record_call("compute")
            backend.record_call("compute_v2")

            val r1 = backend.try_jit_compile(_jit_spec_find_fn(mod_v1, "compute"), mod_v1)
            expect(r1.is_ok()).to_equal(true)
            val err1 = backend.jit_failed["compute"] ?? ""
            expect(err1.contains("MIR lowering failed")).to_equal(false)
            expect(backend.module_prescans).to_equal(1)

            val r2 = backend.try_jit_compile(_jit_spec_find_fn(mod_v2, "compute_v2"), mod_v2)
            expect(r2.is_ok()).to_equal(true)
            val err2 = backend.jit_failed["compute_v2"] ?? ""
            expect(err2.contains("MIR lowering failed")).to_equal(false)
            expect(backend.module_prescans).to_equal(2)
