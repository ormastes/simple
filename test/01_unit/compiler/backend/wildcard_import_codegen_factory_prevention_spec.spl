# Regression: wildcard_import_codegen_factory_function_to_int_2026-07-30
# Wildcard-importing codegen_factory must not poison the session with
# "cannot convert function to int" after the tests finish.
use std.spec
use compiler.backend.codegen_factory.*

describe "wildcard import of codegen_factory":
    it "leaves the interpreter session healthy":
        expect(1).to_equal(1)
