# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use plugins.backend_c.c_backend_translate.{MirToC}
use plugins.backend_c.c_backend_stubs.*
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.*
use compiler.backend.mir_test_builder_full.{MirTestBuilder, new_builder, simple_arithmetic, simd_reduction, gpu_kernel, BackendTarget, MirTestCase}
use compiler.backend.backend_sffi.{BackendCapability, get_cranelift_capability, get_llvm_capability, get_vulkan_capability, get_interpreter_capability, get_all_capabilities}
use compiler.backend.capability_tracker.{CapabilityTracker, InstructionCategory, InstructionSupport, create_default_tracker}
use compiler.backend.matrix_builder.{MatrixBuilder, create_matrix_builder}


fn c_output_for(block: fn(MirToC)) -> text:
    # These specs exercise the emit-a-runtime-panic path on purpose: the text
    # they assert IS the generated `spl_panic(...)`. Since 2026-08-23 an
    # unlowerable MIR kind is a COMPILE error by default, because emit-only was
    # fail-OPEN (build green, binary dead on first use) --
    # doc/08_tracking/bug/llvm_backend_unlowered_mir_kind_fails_open_2026-08-23.md.
    # SIMPLE_ALLOW_UNLOWERED_MIR=1 is that fix's documented opt-in for exactly
    # this case, so the spec sets it itself rather than depending on the caller.
    env_set("SIMPLE_ALLOW_UNLOWERED_MIR", "1")
    val translator = MirToC.create("test.backend.capability")
    block(translator)
    translator.builder.build()

fn llvm_output_for(block: fn(MirToLlvm)) -> text:
    # These specs exercise the emit-a-runtime-panic path on purpose: the text
    # they assert IS the generated `spl_panic(...)`. Since 2026-08-23 an
    # unlowerable MIR kind is a COMPILE error by default, because emit-only was
    # fail-OPEN (build green, binary dead on first use) --
    # doc/08_tracking/bug/llvm_backend_unlowered_mir_kind_fails_open_2026-08-23.md.
    # SIMPLE_ALLOW_UNLOWERED_MIR=1 is that fix's documented opt-in for exactly
    # this case, so the spec sets it itself rather than depending on the caller.
    env_set("SIMPLE_ALLOW_UNLOWERED_MIR", "1")
    val translator = MirToLlvm.create("test.backend.capability", CodegenTarget.X86_64, nil)
    block(translator)
    # Panic messages are LLVM global constants, separate from instruction text.
    # Observe both emitted sections so message assertions inspect actual output.
    translator.string_globals.join("\n") + "\n" + translator.builder.build()

describe "Backend Capability":
    # @manual scenario evidence
    it "names the backend and unsupported async operation in C lowering":
        # @req REQ-SSPEC-COMPILER
        step("names the backend and unsupported async operation in C lowering")
        val output = c_output_for(
            _1.translate_create_promise(
                LocalId(id: 1),
                LocalId(id: 2),
                MirType.promise(MirType.i64())
            )
        )

        expect(output).to_contain("C backend does not support async CreatePromise lowering")
        expect(output.contains("not implemented")).to_equal(false)

    it "names the backend and unsupported actor operation in C lowering":
        # @req REQ-SSPEC-COMPILER
        step("names the backend and unsupported actor operation in C lowering")
        val output = c_output_for(
            _1.translate_receive(LocalId(id: 1), nil)
        )

        expect(output).to_contain("C backend does not support actor Receive lowering")
        expect(output.contains("Instruction not implemented")).to_equal(false)

    it "names the backend and unsupported matrix operation in LLVM lowering":
        # @req REQ-SSPEC-COMPILER
        step("names the backend and unsupported matrix operation in LLVM lowering")
        val output = llvm_output_for(\translator:
            translator.local_types[0] = "ptr"
            translator.local_types[1] = "ptr"
            translator.local_types[2] = "ptr"
            translator.translate_binop(
                LocalId(id: 2),
                MirBinOp.MatMul,
                mir_operand_copy(LocalId(id: 0)),
                mir_operand_copy(LocalId(id: 1))
            )
        )

        expect(output).to_contain("LLVM backend does not support MatMul lowering")
        expect(output.contains("@__simple_runtime_matmul")).to_equal(false)

    it "lowers optimizer pseudo SSA phi to a native LLVM phi":
        # @req REQ-SSPEC-COMPILER
        step("lowers optimizer pseudo SSA phi to a native LLVM phi")
        val output = llvm_output_for(\translator:
            translator.local_types[10] = "i64"
            translator.local_types[11] = "i64"
            translator.local_types[12] = "i64"
            translator.llvm_intrinsic_impl(
                Some(LocalId(id: 12)),
                "__simple_ssa_phi",
                [
                    mir_operand_const_int(1),
                    mir_operand_copy(LocalId(id: 10)),
                    mir_operand_const_int(2),
                    mir_operand_copy(LocalId(id: 11))
                ]
            )
        )

        expect(output).to_contain("%l12 = phi i64 [ %l10, %bb1 ], [ %l11, %bb2 ]")
        expect(output.contains("@__simple_intrinsic___simple_ssa_phi")).to_equal(false)

    it "keeps unsupported messages actionable instead of generic":
        # @req REQ-SSPEC-COMPILER
        step("keeps unsupported messages actionable instead of generic")
        val output = llvm_output_for(\translator:
            translator.local_types[0] = "ptr"
            translator.local_types[2] = "ptr"
            translator.translate_unaryop(
                LocalId(id: 2),
                MirUnaryOp.Transpose,
                mir_operand_copy(LocalId(id: 0))
            )
        )

        expect(output).to_contain("LLVM backend does not support Transpose lowering")
        expect(output.contains("Instruction not implemented")).to_equal(false)

fn supports_backend(test_case: MirTestCase, target: BackendTarget) -> bool:
    for backend in test_case.expected_backends:
        if backend == target:
            return true
    false

# ============================================================================
# Test Group 1: Capability Detection Accuracy
# ============================================================================

describe "Backend Capability Detection":
    # @manual scenario evidence

    context "Cranelift backend capabilities":
        it "supports basic arithmetic":
            # @req REQ-SSPEC-COMPILER
            step("Build basic arithmetic MIR case with Cranelift target expectation")
            val builder = new_builder("cranelift_arith")
            builder.add_const_int(0, 10)
            builder.add_const_int(1, 20)
            builder.add_add(2, 0, 1)
            builder.add_ret(2)

            val test_case = builder.build()
            expect(test_case.instructions.len()).to_equal(4)
            expect(supports_backend(test_case, BackendTarget.Cranelift)).to_equal(true)

        it "does not claim SIMD support in MIR builder expectations":
            # @req REQ-SSPEC-COMPILER
            step("Build SIMD reduction case and confirm Cranelift is excluded")
            val builder = new_builder("simd_cranelift")
            builder.add_vec_sum(1, 0)
            builder.add_ret(1)
            builder.only_backends([BackendTarget.LLVM, BackendTarget.Interpreter])

            val test_case = builder.build()
            expect(test_case.instructions.len()).to_equal(2)
            expect(supports_backend(test_case, BackendTarget.Cranelift)).to_equal(false)

        it "does not claim GPU support":
            # @req REQ-SSPEC-COMPILER
            step("Check Cranelift capability descriptor rejects GPU instructions")
            val cap = get_cranelift_capability()
            expect(cap.backend_name).to_equal("Cranelift")
            expect(cap.supports_gpu).to_equal(false)
            expect(gpu_kernel().expected_backends).to_equal([BackendTarget.Vulkan])

    context "LLVM backend capabilities":
        it "supports basic arithmetic":
            # @req REQ-SSPEC-COMPILER
            step("Build multiply arithmetic MIR case and verify LLVM support")
            val builder = new_builder("llvm_arith")
            builder.add_const_int(0, 5)
            builder.add_const_int(1, 7)
            builder.add_mul(2, 0, 1)
            builder.add_ret(2)

            val test_case = builder.build()
            expect(test_case.instructions.len()).to_equal(4)
            expect(supports_backend(test_case, BackendTarget.LLVM)).to_equal(true)

        it "supports SIMD operations":
            # @req REQ-SSPEC-COMPILER
            step("Verify SIMD capability descriptor and simd_reduction targets include LLVM")
            val cap = get_llvm_capability()
            val simd_case = simd_reduction()
            expect(cap.supports_simd).to_equal(true)
            expect(supports_backend(simd_case, BackendTarget.LLVM)).to_equal(true)

    context "Vulkan backend capabilities":
        it "supports GPU work item IDs and GPU capability flags":
            # @req REQ-SSPEC-COMPILER
            step("Build GPU work-item MIR case and verify Vulkan capability flags")
            val builder = new_builder("vulkan_gid")
            builder.add_gpu_global_id(0, 0)
            builder.add_ret(0)
            builder.only_backend(BackendTarget.Vulkan)

            val test_case = builder.build()
            val cap = get_vulkan_capability()
            expect(cap.supports_gpu).to_equal(true)
            expect(cap.supports_simd).to_equal(false)
            expect(supports_backend(test_case, BackendTarget.Vulkan)).to_equal(true)

        it "records GPU instruction support in capability tracker":
            # @req REQ-SSPEC-COMPILER
            step("Inspect GPU category entries in default capability tracker for Vulkan")
            # Note: CapabilityTracker.get_by_category (owned by H3 in capability_tracker.spl:58)
            # currently uses `val result` with `.push`; inspect `mb.tracker.instructions` via `category_to_string`.
            val mb = create_matrix_builder()
            var gpu_insts: [InstructionSupport] = []
            for inst in mb.tracker.instructions:
                if mb.category_to_string(inst.category) == "GPU":
                    gpu_insts = gpu_insts.push(inst)
            expect(gpu_insts.len()).to_be_greater_than(0)
            for inst in gpu_insts:
                expect(inst.vulkan).to_equal(true)
                expect(inst.cranelift).to_equal(false)

    context "Interpreter backend capabilities":
        it "supports all instruction types":
            # @req REQ-SSPEC-COMPILER
            step("Verify Interpreter capability covers SIMD, GPU, async, and 100% tracker support")
            val cap = get_interpreter_capability()
            val tracker = create_default_tracker()
            expect(cap.supports_simd).to_equal(true)
            expect(cap.supports_gpu).to_equal(true)
            expect(cap.supports_async).to_equal(true)
            expect(cap.instruction_coverage).to_equal(100)
            expect(tracker.get_coverage("interpreter")).to_equal(100)

# ============================================================================
# Test Group 2: Error Message Quality
# ============================================================================

describe "Backend Error Messages":
    # @manual scenario evidence

    context "unsupported instruction errors":
        it "provides instruction name, backend name, and actionable context in C/LLVM errors":
            # @req REQ-SSPEC-COMPILER
            step("Verify C and LLVM unsupported diagnostics name instruction, backend, and exact lowering gap")
            val c_err = c_output_for(\translator:
                translator.translate_create_promise(LocalId(id: 1), LocalId(id: 2), MirType.promise(MirType.i64()))
            )
            val llvm_err = llvm_output_for(\translator:
                translator.local_types[0] = "ptr"
                translator.local_types[2] = "ptr"
                translator.translate_unaryop(LocalId(id: 2), MirUnaryOp.Transpose, mir_operand_copy(LocalId(id: 0)))
            )
            expect(c_err).to_contain("CreatePromise")
            expect(c_err).to_contain("C backend")
            expect(llvm_err).to_contain("Transpose")
            expect(llvm_err).to_contain("LLVM backend")

# ============================================================================
# Test Group 3: Backend Selection Logic
# ============================================================================

describe "Backend Selection Logic":
    # @manual scenario evidence

    context "pure arithmetic code":
        it "selects all standard execution backends":
            # @req REQ-SSPEC-COMPILER
            step("Check simple_arithmetic targets include Cranelift, LLVM, and Interpreter")
            val test_case = simple_arithmetic()
            expect(supports_backend(test_case, BackendTarget.Cranelift)).to_equal(true)
            expect(supports_backend(test_case, BackendTarget.LLVM)).to_equal(true)
            expect(supports_backend(test_case, BackendTarget.Interpreter)).to_equal(true)

    context "SIMD-heavy code":
        it "selects LLVM and Interpreter backends":
            # @req REQ-SSPEC-COMPILER
            step("Check simd_reduction targets exclude Cranelift/Vulkan and include LLVM")
            val test_case = simd_reduction()
            expect(test_case.expected_backends).to_equal([BackendTarget.LLVM, BackendTarget.Interpreter])

    context "GPU kernel code":
        it "requires Vulkan backend":
            # @req REQ-SSPEC-COMPILER
            step("Check gpu_kernel targets require Vulkan")
            val test_case = gpu_kernel()
            expect(test_case.expected_backends).to_equal([BackendTarget.Vulkan])

# ============================================================================
# Test Group 4: Fallback Behavior
# ============================================================================

describe "Backend Fallback Behavior":
    # @manual scenario evidence

    context "mixed instruction types":
        it "restricts builder test cases with interpreter-only ops to Interpreter":
            # @req REQ-SSPEC-COMPILER
            step("Build a mixed instruction case pinned to Interpreter fallback")
            val builder = new_builder("mixed_fallback")
            builder.add_const_int(0, 42)
            builder.add_ret_void()
            builder.only_backend(BackendTarget.Interpreter)

            val test_case = builder.build()
            expect(test_case.expected_backends).to_equal([BackendTarget.Interpreter])
            expect(supports_backend(test_case, BackendTarget.Cranelift)).to_equal(false)

# ============================================================================
# Test Group 5: Capability Matrix Generation
# ============================================================================

describe "Backend Capability Matrix":
    # @manual scenario evidence

    context "instruction categories":
        it "tracks constants, arithmetic, SIMD, GPU, and async categories":
            # @req REQ-SSPEC-COMPILER
            step("Verify create_default_tracker populates Constants, Arithmetic, SIMD, GPU, and Async")
            val mb = create_matrix_builder()
            var const_count = 0
            var arith_count = 0
            var simd_count = 0
            var gpu_count = 0
            var async_count = 0
            for inst in mb.tracker.instructions:
                val cat = mb.category_to_string(inst.category)
                if cat == "Constants":
                    const_count = const_count + 1
                elif cat == "Arithmetic":
                    arith_count = arith_count + 1
                elif cat == "SIMD":
                    simd_count = simd_count + 1
                elif cat == "GPU":
                    gpu_count = gpu_count + 1
                elif cat == "Async":
                    async_count = async_count + 1
            expect(const_count).to_equal(4)
            expect(arith_count).to_equal(6)
            expect(simd_count).to_equal(9)
            expect(gpu_count).to_equal(6)
            expect(async_count).to_equal(5)

    context "support percentages":
        it "calculates non-zero coverage percentages matching backend capabilities":
            # @req REQ-SSPEC-COMPILER
            step("Verify tracker coverage percentages for Cranelift, LLVM, Vulkan, and Interpreter")
            val tracker = create_default_tracker()
            val cran_cov = tracker.get_coverage("cranelift")
            val llvm_cov = tracker.get_coverage("llvm")
            val vulk_cov = tracker.get_coverage("vulkan")
            val interp_cov = tracker.get_coverage("interpreter")
            expect(interp_cov).to_equal(100)
            expect(cran_cov).to_be_greater_than(50)
            expect(llvm_cov).to_be_greater_than(30)
            expect(vulk_cov).to_be_greater_than(30)
            expect(cran_cov).to_be_less_than(100)

# ============================================================================
# Test Group 6: Documentation Consistency
# ============================================================================

describe "Capability Documentation":
    # @manual scenario evidence

    context "documentation accuracy":
        it "generates capability matrix tables matching backend capability descriptors":
            # @req REQ-SSPEC-COMPILER
            step("Generate markdown summary and full matrix via MatrixBuilder and verify key headers/entries")
            val matrix_builder = create_matrix_builder()
            val summary = matrix_builder.generate_summary()
            val full = matrix_builder.generate_full_matrix()
            val caps = get_all_capabilities()
            expect(caps.len()).to_equal(4)
            expect(summary).to_contain("## Backend Coverage Summary")
            expect(summary).to_contain("| Interpreter | 100% |")
            expect(full).to_contain("| ConstInt | Constants |")
            expect(full).to_contain("| GpuGlobalId | GPU |")
            expect(full).to_contain("| ActorSpawn | Async |")
