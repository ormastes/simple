# Native regression for rt_string_new_literal's stable-address contract.
#
# Each function has the same stack shape and returns an equal-length literal.
# The former Cranelift lowering placed those bytes in a reusable stack slot;
# rt_string_new_literal then interned the second call by the first call's
# identical (stack address, length), returning the wrong string.
#
# @cover src/compiler_rust/compiler/src/codegen/instr/helpers.rs
# @cover src/compiler_rust/runtime/src/value/collections.rs
# @mode: native

fn cranelift_literal_val() -> text:
    "val"

fn cranelift_literal_pub() -> text:
    "pub"

fn cranelift_literal_receive() -> text:
    "receive"

fn cranelift_literal_newtype() -> text:
    "newtype"

describe "Cranelift literal rodata identity":
    it "keeps equal-length literals from separate functions distinct":
        val first_short = cranelift_literal_val()
        val second_short = cranelift_literal_pub()
        val first_long = cranelift_literal_receive()
        val second_long = cranelift_literal_newtype()

        expect(first_short).to_equal("val")
        expect(second_short).to_equal("pub")
        expect(first_short).to_not_equal(second_short)
        expect(first_long).to_equal("receive")
        expect(second_long).to_equal("newtype")
        expect(first_long).to_not_equal(second_long)
