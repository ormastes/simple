# The pure-Simple JIT and the interpreter agree on runtime extern results.
#
# The JIT links each runtime extern through the provider's runtime symbol
# table, with the seed's RuntimeFuncSpec signature, and runs the generated
# machine code natively. Each case calls the same runtime extern once from
# JIT code and once from the interpreter, and compares the results: text
# (a boxed string literal and its length), I/O (a file's size) and time.
# Bug: doc/08_tracking/bug/pure_simple_jit_provider_registers_no_runtime_symbols_2026-11-13.md
use std.spec.*
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.cranelift_codegen_adapter.{cranelift_jit_run_main}

extern fn rt_string_len(value: text) -> i64
extern fn rt_file_size(path: text) -> i64
extern fn rt_time_now_unix_micros() -> i64

val PARITY_FILE: text = "test/01_unit/compiler/backend/jit_runtime_extern_interpreter_parity_spec.spl"

fn call_main(name: text, args: [MirOperand]) -> MirModule:
    val callee = mir_operand_runtime_function(name, MirType.i64())
    val main_fn = MirFunction(
        symbol: SymbolId(id: 1), name: "main",
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil,
            instructions: [MirInst(kind: MirInstKind.Call(Some(LocalId(id: 0)), callee, args), span: nil)],
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0))))))],
        entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )
    MirModule(name: "jit_rt_parity_{name}", functions: {SymbolId(id: 1): main_fn}, statics: {}, constants: {}, types: {})

fn boxed_text(value: text) -> MirOperand:
    # A string constant in a value position: the lowering boxes it through
    # rt_string_new_literal into a tagged text RuntimeValue.
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(value), MirType.i64()))

fn raw_bytes(value: text) -> MirOperand:
    # A string constant typed as a pointer: the raw UTF-8 bytes in rodata.
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(value), MirType.ptr(MirType.bits(8), false)))

fn int_op(value: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), MirType.i64()))

fn jit_result(module: MirModule) -> text:
    match cranelift_jit_run_main(module):
        case Ok(value): "ok:{value}"
        case Err(message): "err:{message}"

fn jit_value(module: MirModule) -> i64:
    match cranelift_jit_run_main(module):
        case Ok(value): value
        case Err(message):
            print "jit error: {message}"
            -1

describe "pure-Simple JIT runtime externs match the interpreter":

    it "text: the length of a boxed string literal":
        val sample = "jit parity sample"
        expect(jit_result(call_main("rt_string_len", [boxed_text(sample)]))).to_equal("ok:{rt_string_len(sample)}")

    # The (ptr, len) words are built by hand, matching the RuntimeFuncSpec row.
    # This proves the provider binds rt_file_size and that JIT and interpreter
    # agree. It does not prove source-level lowering: MIR for
    # `extern fn rt_file_size(path: text)` passes one boxed text, and the
    # provider refuses that call on arity.
    it "I/O: the size of a file named by raw path bytes":
        val expected = rt_file_size(PARITY_FILE)
        expect(expected > 0).to_equal(true)
        val module = call_main("rt_file_size", [raw_bytes(PARITY_FILE), int_op(PARITY_FILE.byte_len())])
        expect(jit_result(module)).to_equal("ok:{expected}")

    it "time: the wall clock read between two interpreter reads":
        val before = rt_time_now_unix_micros()
        val micros = jit_value(call_main("rt_time_now_unix_micros", []))
        val after = rt_time_now_unix_micros()
        expect(micros >= before).to_equal(true)
        expect(micros <= after).to_equal(true)
