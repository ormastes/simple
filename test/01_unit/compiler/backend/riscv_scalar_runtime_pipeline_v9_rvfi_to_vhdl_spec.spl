use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v9_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v9_flat}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v9_rvfi_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v9_rvfi, scalar_runtime_pipeline_v9_rvfi_contract_sha256}

describe "V9 RVFI pipeline wrapper":
    it "projects canonical RV64 IM CSR completion with registered operand evidence":
        val config = CoreConfig.rv64im_zicsr_zifencei()
        val base = compile_strict_riscv_scalar_runtime_pipeline_v9_flat("runtime_v9_rvfi", config, LsuConfig.rv64_product_default())
        val result = compile_strict_riscv_scalar_runtime_pipeline_v9_rvfi("runtime_v9_rvfi", config, LsuConfig.rv64_product_default())
        expect(result.is_success()).to_be(true)
        if result.is_success():
            expect(result.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v9-rvfi-v1")
            expect(result.vhdl).to_contain("-- simple-rvfi contract=" + scalar_runtime_pipeline_v9_rvfi_contract_sha256(base) + " scope=V9-IM-Zicsr-Zifencei; interrupts=excluded")
            expect(result.vhdl).to_contain("rvfi_input_ready <= in_ready_i and not metadata_inflight_reg; pipeline_in_valid_i <= in_valid and in_ready_i and not metadata_inflight_reg;")
            expect(result.vhdl).to_contain("else if pipeline_in_valid_i='1' and in_ready_i='1' then metadata_inflight_reg <= '1'; rs1_addr_reg <= instruction(19 downto 15); rs2_addr_reg <= instruction(24 downto 20); if instruction(19 downto 15)=\"00000\" then rs1_reg <= (others=>'0'); else rs1_reg <= rs1_value; end if;")
            expect(result.vhdl).to_contain("if instruction(24 downto 20)=\"00000\" then rs2_reg <= (others=>'0'); else rs2_reg <= rs2_value; end if;")
            expect(result.vhdl).to_contain("if completion_valid_i='1' then metadata_inflight_reg <= '0'; rvfi_order_reg <= rvfi_order_reg + 1;")
            expect(result.vhdl).to_contain("rvfi_order_reg <= rvfi_order_reg + 1")
            expect(result.vhdl).to_contain("rvfi_trap <= completion_execute_trap_i or completion_memory_trap_i; rvfi_halt <= '0'; rvfi_intr <= '0';")
            expect(result.vhdl).to_contain("rvfi_ixl <= \"10\"")
            expect(result.vhdl).to_contain("rvfi_rd_addr <= completion_rd_i; rvfi_rd_wdata <= completion_rd_value_i")
            expect(result.vhdl).to_contain("v9_runtime_protocol_fault <= runtime_protocol_fault_i; v9_csr_commit_valid <= csr_commit_valid_i")
            expect(result.vhdl).to_contain("v9_fence_effect_valid <= fence_effect_valid_i")

    it "supports the canonical RV32 profile and rejects non-V9 scope":
        val rv32 = compile_strict_riscv_scalar_runtime_pipeline_v9_rvfi("runtime_v9_rvfi32", CoreConfig.rv32im_zicsr_zifencei(), LsuConfig.rv32_product_default())
        expect(rv32.is_success()).to_be(true)
        if rv32.is_success(): expect(rv32.vhdl).to_contain("rvfi_ixl <= \"01\"")
        val rejected = compile_strict_riscv_scalar_runtime_pipeline_v9_rvfi("runtime_v9_bad", CoreConfig.rv64im(), LsuConfig.rv64_product_default())
        expect(rejected.is_success()).to_be(false)
        expect(rejected.diagnostic).to_contain("HWIR-E-RISCV-RUNTIME-PIPELINE-V9-RVFI-SCOPE")
