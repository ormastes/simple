"""
## Purpose and audience
Prevention guard for CompFix-15 ensuring `backend_capability_spec.spl` stays wired to real `mir_test_builder_full`, `backend_sffi`, `capability_tracker`, and `matrix_builder` APIs rather than legacy commented-out `MirTestBuilder.new()` / `pass` stubs.
Audience: compiler and backend engineers maintaining `test/01_unit/compiler/backend/`.
"""
# @req: REQ-SSPEC-COMPILER — backend capability specs must exercise live APIs without commented-out test groups or pass stubs.

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "backend capability builder prevention (CompFix-15)":
    it "keeps backend_capability_spec wired to live mir_test_builder_full and tracker APIs":
        step("Verify backend_capability_spec.spl imports live modules and contains no legacy MirTestBuilder.new() stubs")
        val source = rt_file_read_text("test/01_unit/compiler/backend/backend_capability_spec.spl") ?? ""
        expect(source).to_contain("compiler.backend.mir_test_builder_full")
        expect(source).to_contain("compiler.backend.capability_tracker")
        expect(source).to_contain("compiler.backend.matrix_builder")
        expect(source.contains("MirTestBuilder.new()")).to_equal(false)
        expect(source.contains("compiler.backend.mir_test_builder.")).to_equal(false)
        expect(source.contains("pass_todo")).to_equal(false)
