# A refused cross-module call is a compile error of the MODULE, not a panic of
# the compiler process.
#
# Stage 3 run 32 (2026-11-14): one call whose callee signature was unknown made
# cl_translate_call panic, the single codegen worker died with SIGABRT, and
# all 1664 modules of the build were marked failed. The refusal itself is
# correct (an f64 through an all-i64 import is a silent miscompile); these
# examples pin how it is REPORTED on the AOT lane: recorded for the module
# being lowered, returned as that module's CompileError before any object is
# emitted, and the next module compiles normally.
use std.spec.*
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.backend.backend_types.{compileoptions_default_options}
use compiler.backend.cranelift_codegen_adapter.{CraneliftCodegenAdapter, cranelift_compile_module_direct}
use compiler.backend.cranelift_runtime_imports.{cl_aot_call_abi_begin, cl_aot_call_abi_end, cl_aot_refuse_call_abi}

fn refusal_fn(id: i64, name: text, insts: [MirInst]) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: id), name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: insts,
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), MirType.i64())))))],
        entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

fn refusal_unknown_signature() -> MirType:
    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))

fn refusal_float_arg() -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Float(2.5), MirType(kind: MirTypeKind.F64)))

# `main` passes an f64 to a callee of another module whose signature is unknown.
fn refusal_module(name: text, callee: MirOperand) -> MirModule:
    MirModule(name: name,
        functions: {SymbolId(id: 1): refusal_fn(1, "main", [
            MirInst(kind: MirInstKind.Call(nil, callee, [refusal_float_arg()]), span: nil)])},
        statics: {}, constants: {}, types: {})

fn refusal_message(module: MirModule) -> text:
    match cranelift_compile_module_direct(compileoptions_default_options(), module):
        case Ok(_): "compiled"
        case Err(error): error.message

describe "Cranelift AOT call-ABI refusal is a module compile error":
    it "returns the refusal of a source callee as the module's error":
        val callee = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("other.owner.Sink.take"), refusal_unknown_signature()),
            call_origin: MirCallOrigin.Source)
        val message = refusal_message(refusal_module("aot_refusal_source_probe", callee))
        expect(message).to_contain("E-BACKEND-CRANELIFT-CALL-ABI: other.owner.Sink.take: call in main")
        expect(message).to_contain("callee signature unknown; arg 0 is f64")

    it "returns the refusal of an unknown runtime-origin callee as the module's error":
        val callee = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("abi_spec_unknown_float_sink"), refusal_unknown_signature()),
            call_origin: MirCallOrigin.Runtime)
        val message = refusal_message(refusal_module("aot_refusal_runtime_probe", callee))
        expect(message).to_contain("E-BACKEND-CRANELIFT-CALL-ABI: abi_spec_unknown_float_sink: call in main")

    it "returns the refusal through the Codegen adapter entry of the build lane":
        val callee = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("other.owner.Sink.take"), refusal_unknown_signature()),
            call_origin: MirCallOrigin.Source)
        var adapter = CraneliftCodegenAdapter(options: compileoptions_default_options())
        val message = match adapter.compile_module(refusal_module("aot_refusal_adapter_probe", callee)):
            case Ok(_): "compiled"
            case Err(error): error.message
        expect(message).to_contain("E-BACKEND-CRANELIFT-CALL-ABI: other.owner.Sink.take: call in main")

    it "compiles the next module after a refused one":
        val callee = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("other.owner.Sink.take"), refusal_unknown_signature()),
            call_origin: MirCallOrigin.Source)
        expect(refusal_message(refusal_module("aot_refusal_first_probe", callee))).to_contain("E-BACKEND-CRANELIFT-CALL-ABI")
        val good = MirModule(name: "aot_refusal_next_probe",
            functions: {SymbolId(id: 1): refusal_fn(1, "main", [])},
            statics: {}, constants: {}, types: {})
        expect(refusal_message(good)).to_equal("compiled")

describe "Cranelift AOT call-ABI refusal record":
    it "records only for the module that is open":
        expect(cl_aot_refuse_call_abi(41, "before begin")).to_equal(false)
        cl_aot_call_abi_begin(41)
        expect(cl_aot_refuse_call_abi(42, "other module")).to_equal(false)
        expect(cl_aot_refuse_call_abi(0, "no module")).to_equal(false)
        expect(cl_aot_refuse_call_abi(41, "first")).to_equal(true)
        expect(cl_aot_refuse_call_abi(41, "second")).to_equal(true)
        expect(cl_aot_call_abi_end().join("|")).to_equal("first|second")

    it "closes at end, so a later refusal fails closed again":
        cl_aot_call_abi_begin(41)
        expect(cl_aot_call_abi_end().len()).to_equal(0)
        expect(cl_aot_refuse_call_abi(41, "after end")).to_equal(false)
        cl_aot_call_abi_begin(43)
        expect(cl_aot_call_abi_end().len()).to_equal(0)
