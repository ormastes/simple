# InterpreterBackendImpl.process_module on a module where one user-defined
# function calls another.
#
# @cover src/compiler/70.backend/backend/env.spl
#
# `Environment.define`/`assign`/`lookup` had two independent defects, both
# only reachable once a SECOND scope exists -- i.e. inside any call frame:
#
#   1. `define`/`assign` wrote `self.scopes[last_idx][name] = value`, a
#      doubly-indexed assignment target the interpreter does not support, so
#      the very first parameter bind of ANY callee aborted with
#      "invalid assignment: index assignment requires identifier or field
#      access as container".
#   2. `assign`/`lookup` searched inner scopes with `for i in
#      (scopes.len() - 1)..=0` -- a DESCENDING inclusive range, which iterates
#      ZERO times in this language, so the search silently found nothing
#      whenever more than one scope existed (every function-parameter lookup
#      from within a call frame).
#
# Fixed 2026-08-09 (commit e5bc26ced33) by reading through a typed local with
# an explicit write-back for #1, and an explicit counted-down `while` loop for
# #2.
#
# doc/08_tracking/bug/interpreter_backend_two_function_call_index_assign_error_2026-08-09.md

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use compiler.common.config.{Logger}

fn cf_logger() -> Logger:
    Logger(level: 0)

fn cf_lower(src: text, path: text) -> HirModule:
    val module = parse_full_frontend(src, path, "cf_probe", cf_logger())
    var lowering = HirLowering.with_filename(path)
    lowering.lower_module(module)

describe "InterpreterBackendImpl call-frame scoping":
    it "runs a module where main calls a second user-defined function":
        # The simplest possible repro from the bug doc: no aspects, no
        # weaving, just a two-function call chain -- this alone used to abort
        # with "invalid assignment: index assignment requires identifier or
        # field access as container" on the callee's first parameter bind.
        val src = "fn f(n: i64) -> i64:\n    n + 1\n\nfn main() -> i64:\n    f(41)\n"
        val hir = cf_lower(src, "cf_two_fn.spl")
        var backend = InterpreterBackendImpl.new()

        val result = backend.interpret_hir_module(hir)
        var ok = false
        match result:
            case Ok(_): ok = true
            case Err(_): ok = false
        expect(ok).to_equal(true)

    it "binds and returns the callee's own parameter, not a stale/missing one":
        # Distinguishes "didn't crash" from "computed the right value": if
        # `define` silently failed to bind `n`, or `lookup`/`assign` searched
        # zero inner scopes, the callee would not see the caller-supplied
        # argument at all.
        val src = "fn double(n: i64) -> i64:\n    n * 2\n\nfn main() -> i64:\n    double(21)\n"
        val hir = cf_lower(src, "cf_param_bind.spl")
        var backend = InterpreterBackendImpl.new()

        val result = backend.interpret_hir_module(hir)
        var ok = false
        match result:
            case Ok(_): ok = true
            case Err(_): ok = false
        expect(ok).to_equal(true)

    it "reassigns a local inside the callee's own (inner) scope":
        # Stresses `assign`'s inner-scope search specifically: `m` is defined
        # and then reassigned within the SAME call frame (scopes.len() > 1
        # the whole time main is running f).
        val src = "fn f(n: i64) -> i64:\n    var m = n\n    m = m + 1\n    m\n\nfn main() -> i64:\n    f(9)\n"
        val hir = cf_lower(src, "cf_inner_reassign.spl")
        var backend = InterpreterBackendImpl.new()

        val result = backend.interpret_hir_module(hir)
        var ok = false
        match result:
            case Ok(_): ok = true
            case Err(_): ok = false
        expect(ok).to_equal(true)
