var _items: [text] = []

fn _admit(items: [text], item: text) -> ([text], text):
    for existing in items:
        if existing == item:
            return (items, "dup")
    (items + [item], "")

pub fn modvar_reset():
    _items = []

pub fn modvar_register(item: text) -> bool:
    val admitted = _admit(_items, item)
    if admitted.1 != "":
        return false
    _items = admitted.0
    true

pub fn modvar_count() -> i64:
    _items.len()

export modvar_reset, modvar_register, modvar_count
