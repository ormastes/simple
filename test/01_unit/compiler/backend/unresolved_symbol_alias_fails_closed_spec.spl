"""
# No link path may alias an UNRESOLVED symbol onto a real function

**Category:** Backend / linker fail-open (similar-problem detection)
**Bug:** doc/08_tracking/bug/simpleos_riscv64_defsym_unknown_symbol_aliasing_2026-07-28.md

## Overview

When MIR lowering cannot resolve a callee, `symbol_to_operand`
(`src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl`) names it
`unknown_<symbol-id>`. That is a deliberately undefined symbol: reaching the
linker as `undefined symbol: unknown_7` is the LOUD, correct outcome.

The riscv64 real-kernel link path once silenced exactly that signal with
thirteen `--defsym=unknown_N=<real kernel function>` arguments, mapping the
unknowns onto `rt_riscv_uart_put`, `_uart_put`, `_boot_banner`,
`log_raw_println`, `rt_riscv_noalloc_pmm_init` and friends -- functions with
entirely unrelated signatures. A call the compiler failed to resolve therefore
did not fail: it jumped into some other function with whatever happened to be
in the argument registers, and the kernel booted and behaved wrongly under
exit 0.

## Executable reproducer

The first example keeps the broad source guard. The second builds two tiny
RISC-V64 ELF objects: one calls undefined `unknown_0`, while the other defines
the historically unrelated target `rt_riscv_uart_put`. It proves the old link
argument aliases the two symbols, then proves the production policy fails
closed when that argument is absent.

## The generalization

The reproducer would have pinned the thirteen known aliases. This spec instead
pins the stronger rule: no link path may defsym an `unknown_*` symbol at all.
The undefined reference must remain visible so the link fails closed.
"""

use std.spec.*
use std.io_runtime.{dir_create_all, dir_remove_all, file_write, getpid, process_run}
use std.nogc_sync_mut.io.env_ops.{env_get}

val LINK_SRC: text = "src/compiler/70.backend/backend/simpleos_native_linkers.spl"
fn defsym_unknown_lines() -> text:
    # grep exit 1 means no match. Any other nonzero status is a broken scan,
    # not evidence that the backend is clean.
    val out = process_run("/usr/bin/grep", [
        "-rn", "--", "--defsym=unknown_", "src/compiler/70.backend/"
    ])
    if out.2 != 0 and out.2 != 1:
        return "__grep_scan_error__ exit={out.2} stderr={out.1}"
    out.0

fn symbol_address(nm_output: text, symbol: text) -> text:
    for line in nm_output.split("\n"):
        if line.ends_with(" " + symbol):
            val fields = line.split(" ")
            if fields.len() > 0:
                return fields[0]
    ""

fn rv64_fixture_dir() -> text:
    "build/test/rv64_defsym_alias_{getpid()}"

fn find_fixture_tool(config_env: text, candidates: [text]) -> text:
    val configured = env_get(config_env) ?? ""
    if configured != "":
        return configured
    for candidate in candidates:
        val probe = process_run(candidate, ["--version"])
        if probe.2 == 0:
            return candidate
    ""

describe "an unresolved unknown_N symbol is never aliased onto a working function":

    it "leaves every unknown_N undefined so the link fails closed":
        step("Collect every --defsym=unknown_ site in the backend")
        val lines = defsym_unknown_lines()

        step("No backend link argument may manufacture an unknown_N definition")
        expect(lines).to_equal("")

        step("None of the known fail-open targets is an alias target")
        # These are the exact five functions the incident aliased onto. Each is
        # a real function with an unrelated signature; jumping into any of them
        # from a lost call is the defect.
        expect(lines.contains("unknown_0=rt_riscv_uart_put")).to_equal(false)
        expect(lines.contains("=_uart_put")).to_equal(false)
        expect(lines.contains("=_boot_banner")).to_equal(false)
        expect(lines.contains("=log_raw_println")).to_equal(false)
        expect(lines.contains("=rt_riscv_qemu_ram_base")).to_equal(false)
        expect(lines.contains("=rt_riscv_qemu_ram_size")).to_equal(false)
        expect(lines.contains("=rt_riscv_qemu_heap_size")).to_equal(false)
        expect(lines.contains("=rt_riscv_qemu_reserved_end")).to_equal(false)
        expect(lines.contains("=rt_riscv_noalloc_pmm_init")).to_equal(false)

    it "reproduces the historical alias and rejects it without defsym":
        val clang = find_fixture_tool("SIMPLE_TEST_CLANG", [
            "clang-19", "clang-18", "clang-17", "clang-16", "clang"
        ])
        val lld = find_fixture_tool("SIMPLE_TEST_LLD", [
            "ld.lld-19", "ld.lld-18", "ld.lld-17", "ld.lld-16", "ld.lld"
        ])
        val nm = find_fixture_tool("SIMPLE_TEST_NM", [
            "llvm-nm-19", "llvm-nm-18", "llvm-nm-17", "llvm-nm-16", "llvm-nm", "nm"
        ])
        expect(clang.len()).to_be_greater_than(0)
        expect(lld.len()).to_be_greater_than(0)
        expect(nm.len()).to_be_greater_than(0)

        val root = rv64_fixture_dir()
        _ = dir_remove_all(root)
        val created = dir_create_all(root)
        val caller_written = file_write(root + "/caller.S", """
.section .text.entry,"ax",@progbits
.globl _start
_start:
  call unknown_0
  ret
""")
        val target_written = file_write(root + "/target.S", """
.text
.globl rt_riscv_uart_put
rt_riscv_uart_put:
  ret
""")
        val caller = process_run(clang, ["--target=riscv64-none-elf", "-c", root + "/caller.S", "-o", root + "/caller.o"])
        val target = process_run(clang, ["--target=riscv64-none-elf", "-c", root + "/target.S", "-o", root + "/target.o"])

        step("Link the fixture with the historical parent argument")
        val parent = process_run(lld, [
            "-m", "elf64lriscv", "-e", "_start", "-o", root + "/parent.elf",
            root + "/caller.o", root + "/target.o",
            "--defsym=unknown_0=rt_riscv_uart_put"
        ])
        val symbols = process_run(nm, [root + "/parent.elf"])
        val unknown_address = symbol_address(symbols.0, "unknown_0")
        val target_address = symbol_address(symbols.0, "rt_riscv_uart_put")

        step("Link the candidate fixture without an alias")
        val candidate = process_run(lld, [
            "-m", "elf64lriscv", "-e", "_start", "-o", root + "/candidate.elf",
            root + "/caller.o", root + "/target.o"
        ])
        val cleaned = dir_remove_all(root)

        # Cleanup occurs before assertions so an ordinary test failure does not
        # accumulate per-process fixture directories.
        expect(created).to_equal(true)
        expect(caller_written).to_equal(true)
        expect(target_written).to_equal(true)
        expect(caller.2).to_equal(0)
        expect(target.2).to_equal(0)
        expect(parent.2).to_equal(0)
        expect(symbols.2).to_equal(0)
        expect(symbols.0).to_contain(" T unknown_0")
        expect(symbols.0).to_contain(" T rt_riscv_uart_put")
        expect(unknown_address.len()).to_be_greater_than(0)
        expect(unknown_address).to_equal(target_address)
        expect(candidate.2).to_be_greater_than(0)
        expect(candidate.1).to_contain("undefined symbol: unknown_0")
        expect(cleaned).to_equal(true)
