# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# SVM-G Task D4 unit spec — checked-HIR test-body lowering to SGP bytecode.
#
# Design doc: doc/05_design/runtime/gpu_remote_interpreter_architecture.md
# §4.4. Bodies below are hand-built genuine `compiler.hir` nodes (HirExpr /
# HirStmt / HirBlock -- the real checked AST the frontend's HIR lowering
# pass produces, same precedent as
# test/01_unit/compiler/backend/llvm_mutable_global_static_spec.spl), fed
# into `compiler.backend.svmg_lowering.lower_svmg_program`, and the emitted
# code is executed on Task D2's host reference VM
# (`std.common.svmg.ref_vm.assemble_and_run`) exactly the way D1/D2's own
# spec (test/01_unit/lib/svmg/ref_vm_spec.spl) executes hand-assembled
# programs -- proving the lowering pass produces bytecode the real
# interpreter accepts and runs correctly, not just bytes that happen to
# satisfy this pass's own encoder.

use std.spec.step

use std.spipe.*
use compiler.hir.hir_types.{SymbolId, HirType, HirTypeKind, MethodResolution}
use compiler.hir.hir_definitions.{
    HirExpr, HirExprKind, HirStmt, HirStmtKind, HirBlock,
    HirBinOp, HirAssignOp, HirCallArg, HirParam, HirInterpolation,
}
use compiler.common.diagnostics.span.{Span}
use compiler.backend.svmg_lowering.{SvmgHelperFn, LoweredProgram, lower_svmg_program}
use std.common.svmg.ref_vm.{VmRunResult, assemble_and_run, read_records, read_log}
use std.common.binary_io.{f32_to_bits}


# ============================================================================
# HIR construction helpers. Basic fixtures use untyped placeholders; cases
# testing print or shift signedness explicitly provide checked type metadata.
# ============================================================================

fn ty() -> HirType:
    HirType(kind: HirTypeKind.Int(bits: 32, signed: true), span: Span.empty())

fn e(kind: HirExprKind) -> HirExpr:
    HirExpr(kind: kind, has_type_: false, type_: ty(), span: Span.empty())

fn s(kind: HirStmtKind) -> HirStmt:
    HirStmt(kind: kind, span: Span.empty())

fn int_lit(v: i64) -> HirExpr:
    e(HirExprKind.IntLit(value: v, suffix: None))

fn var_(sym: SymbolId) -> HirExpr:
    e(HirExprKind.Var(symbol: sym))

fn named_var(sym: SymbolId, name: text) -> HirExpr:
    e(HirExprKind.NamedVar(symbol: sym, name: name))

fn binop(op: HirBinOp, l: HirExpr, r: HirExpr) -> HirExpr:
    e(HirExprKind.Binary(op: op, left: l, right: r))

fn call_arg(v: HirExpr) -> HirCallArg:
    HirCallArg(has_name: false, name: "", value: v, span: Span.empty())

fn call(callee: HirExpr, args: [HirExpr]) -> HirExpr:
    var call_args: [HirCallArg] = []
    for a in args:
        call_args = call_args.push(call_arg(a))
    e(HirExprKind.Call(callee: callee, args: call_args, type_args: []))

fn expect_to_equal(actual: HirExpr, expected: HirExpr) -> HirExpr:
    val expect_call = call(named_var(SymbolId(id: 9000), "expect"), [actual])
    e(HirExprKind.MethodCall(receiver: expect_call, method: "to_equal",
        args: [call_arg(expected)], resolution: MethodResolution.Unresolved))

fn block_no_tail(stmts: [HirStmt]) -> HirBlock:
    HirBlock(stmts: stmts, has: false, value: int_lit(0), span: Span.empty())

fn block_with_tail(stmts: [HirStmt], tail: HirExpr) -> HirBlock:
    HirBlock(stmts: stmts, has: true, value: tail, span: Span.empty())

fn param(sym: SymbolId, name: text) -> HirParam:
    HirParam(symbol: sym, name: name, type_: ty(), has_default: false, default: int_lit(0), span: Span.empty())

fn float_ty() -> HirType:
    HirType(kind: HirTypeKind.Float(bits: 32), span: Span.empty())

fn float_lit(v: f64) -> HirExpr:
    e(HirExprKind.FloatLit(value: v, suffix: None))

fn string_lit(v: text) -> HirExpr:
    e(HirExprKind.StringLit(value: v, interpolations: None))

fn assign(target: HirExpr, op: HirAssignOp, value: HirExpr) -> HirStmt:
    s(HirStmtKind.Assign(target: target, op: op, value: value))

fn expected_signed_i32_bits(v: f64) -> i64:
    """Independently reproduce ref_vm.spl's `record.value` signed-i32
    decoding for an f32 bit pattern, so a float assertion checks the actual
    executed value rather than only `passed == 1`."""
    val bits = f32_to_bits(v as f32) as i64
    if bits >= 0x80000000: bits - 0x100000000 else: bits

fn run_print_body(body: HirBlock, helpers: [SvmgHelperFn]) -> VmRunResult:
    val prog = lower_svmg_program(body, helpers, 50000)
    assert_true(prog.ok)
    assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)

fn expect_vm_print_log(result: VmRunResult, expected: text):
    assert_equal(result.halted, true)
    assert_equal(result.trapped, false)
    assert_equal(result.timed_out, false)
    assert_equal(read_log(result.arena, result.log_cap), expected)

fn float_compound_body(op: HirAssignOp, initial: f64, operand: f64, expected: f64) -> HirBlock:
    val left_sym = SymbolId(id: 1)
    val right_sym = SymbolId(id: 2)
    val left = HirExpr(kind: HirExprKind.Var(symbol: left_sym), has_type_: true, type_: float_ty(), span: Span.empty())
    val right = HirExpr(kind: HirExprKind.Var(symbol: right_sym), has_type_: true, type_: float_ty(), span: Span.empty())
    block_no_tail([
        s(HirStmtKind.Let(symbol: left_sym, type_: float_ty(), init: float_lit(initial))),
        s(HirStmtKind.Let(symbol: right_sym, type_: float_ty(), init: float_lit(operand))),
        assign(left, op, right),
        s(HirStmtKind.Expr(expr: expect_to_equal(left, float_lit(expected)))),
    ])

fn integer_shift_body(value: i64, count: i64, signed: bool, compound: bool, expected: i64) -> HirBlock:
    val type_ = HirType(kind: HirTypeKind.Int(bits: 32, signed: signed), span: Span.empty())
    val symbol = SymbolId(id: 1)
    val initial = HirExpr(kind: HirExprKind.IntLit(value: value, suffix: None), has_type_: true, type_: type_, span: Span.empty())
    val target = HirExpr(kind: HirExprKind.Var(symbol: symbol), has_type_: true, type_: type_, span: Span.empty())
    val amount = HirExpr(kind: HirExprKind.IntLit(value: count, suffix: None), has_type_: true, type_: ty(), span: Span.empty())
    var stmts = [s(HirStmtKind.Let(symbol: symbol, type_: type_, init: initial))]
    if compound:
        stmts = stmts.push(assign(target, HirAssignOp.Shr, amount))
    val actual = if compound: target else: HirExpr(kind: HirExprKind.Binary(op: HirBinOp.Shr, left: target, right: amount), has_type_: true, type_: type_, span: Span.empty())
    stmts = stmts.push(s(HirStmtKind.Expr(expr: expect_to_equal(actual, int_lit(expected)))))
    block_no_tail(stmts)

fn expect_vm_shift_result(result: VmRunResult, expected: i64):
    expect_vm_print_log(result, "")
    val records = read_records(result.arena, result.log_cap, result.record_count)
    assert_equal(records.len(), 1)
    assert_equal(records[0].passed, 1)
    assert_equal(records[0].value, expected)

# ============================================================================
# Positive cases
# ============================================================================

describe "SVM-G Task D4 lowering — expect(add(1,2)).to_equal(3)":
    # @manual scenario evidence
    it "lowers a non-recursive helper-fn call plus expect().to_equal() and executes it correctly on D2's VM":
        # @req REQ-SSPEC-UNIT
        step("lowers a non-recursive helper-fn call plus expect().to_equal() and executes it correctly on D2's VM")
        val a_sym = SymbolId(id: 1)
        val b_sym = SymbolId(id: 2)
        val add_fn = SvmgHelperFn(
            name: "add",
            params: [param(a_sym, "a"), param(b_sym, "b")],
            body: block_with_tail([], binop(HirBinOp.Add, var_(a_sym), var_(b_sym))),
        )
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: expect_to_equal(
                call(named_var(SymbolId(id: 10), "add"), [int_lit(1), int_lit(2)]),
                int_lit(3),
            ))),
        ])
        val prog = lower_svmg_program(body, [add_fn], 1000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 3)

describe "SVM-G Task D4 lowering — bounded for-range loop":
    it "sums 0..5 (exclusive) via a bounded for loop and checks the total with expect().to_equal()":
        # @req REQ-SSPEC-UNIT
        step("sums 0..5 (exclusive) via a bounded for loop and checks the total with expect().to_equal()")
        val i_sym = SymbolId(id: 1)
        val sum_sym = SymbolId(id: 2)
        val range_expr = e(HirExprKind.Range(start: int_lit(0), end: int_lit(5), inclusive: false, step: None))
        val loop_body = block_no_tail([
            s(HirStmtKind.Assign(target: var_(sum_sym), op: HirAssignOp.Add, value: var_(i_sym))),
        ])
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: sum_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Expr(expr: e(HirExprKind.For(var_: i_sym, iter: range_expr, body: loop_body, label: None)))),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(sum_sym), int_lit(10)))),
        ])
        val prog = lower_svmg_program(body, [], 5000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 10)

describe "SVM-G Task D4 lowering — fixed-size array sum":
    it "sums a fixed-size array via for-x-in-array and checks the total with expect().to_equal()":
        # @req REQ-SSPEC-UNIT
        step("sums a fixed-size array via for-x-in-array and checks the total with expect().to_equal()")
        val arr_sym = SymbolId(id: 1)
        val x_sym = SymbolId(id: 2)
        val sum_sym = SymbolId(id: 3)
        val arr_lit = e(HirExprKind.ArrayLit(elements: [int_lit(1), int_lit(2), int_lit(3), int_lit(4), int_lit(5)], type_: None))
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: arr_sym, type_: ty(), init: arr_lit)),
            s(HirStmtKind.Let(symbol: sum_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Expr(expr: e(HirExprKind.For(var_: x_sym, iter: var_(arr_sym), body: block_no_tail([
                s(HirStmtKind.Assign(target: var_(sum_sym), op: HirAssignOp.Add, value: var_(x_sym))),
            ]), label: None)))),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(sum_sym), int_lit(15)))),
        ])
        val prog = lower_svmg_program(body, [], 5000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 15)

# ============================================================================
# Positive cases — Task D4 extension (if/elif/else, while, print, float)
# ============================================================================

describe "SVM-G Task D4 lowering — if/elif/else":
    it "picks the elif branch (nested If inside the else_ block) and executes the right accumulation on D2's VM":
        # @req REQ-SSPEC-UNIT
        step("picks the elif branch (nested If inside the else_ block) and executes the right accumulation on D2's VM")
        val x_sym = SymbolId(id: 1)
        val total_sym = SymbolId(id: 2)
        # if x > 10: total += 100
        # elif x > 5: total += 10   <- x == 7 takes this branch
        # else: total += 1
        val inner_if = e(HirExprKind.If(
            cond: binop(HirBinOp.Gt, var_(x_sym), int_lit(5)),
            then_: block_no_tail([assign(var_(total_sym), HirAssignOp.Add, int_lit(10))]),
            else_: block_no_tail([assign(var_(total_sym), HirAssignOp.Add, int_lit(1))]),
        ))
        val outer_if = e(HirExprKind.If(
            cond: binop(HirBinOp.Gt, var_(x_sym), int_lit(10)),
            then_: block_no_tail([assign(var_(total_sym), HirAssignOp.Add, int_lit(100))]),
            else_: block_no_tail([s(HirStmtKind.Expr(expr: inner_if))]),
        ))
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: x_sym, type_: ty(), init: int_lit(7))),
            s(HirStmtKind.Let(symbol: total_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Expr(expr: outer_if)),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(total_sym), int_lit(10)))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 10)

describe "SVM-G Task D4 lowering — bounded while loop":
    it "sums 0..5 (exclusive) via a while loop (step-budget backstop) and checks the total with expect().to_equal()":
        # @req REQ-SSPEC-UNIT
        step("sums 0..5 (exclusive) via a while loop (step-budget backstop) and checks the total with expect().to_equal()")
        val i_sym = SymbolId(id: 1)
        val sum_sym = SymbolId(id: 2)
        val loop_body = block_no_tail([
            assign(var_(sum_sym), HirAssignOp.Add, var_(i_sym)),
            assign(var_(i_sym), HirAssignOp.Add, int_lit(1)),
        ])
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: i_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Let(symbol: sum_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Expr(expr: e(HirExprKind.While(
                cond: binop(HirBinOp.Lt, var_(i_sym), int_lit(5)),
                body: loop_body,
                label: None,
            )))),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(sum_sym), int_lit(10)))),
        ])
        val prog = lower_svmg_program(body, [], 5000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 10)

describe "SVM-G Task D4 lowering — print of a string literal":
    it "lowers print(\"hi\") to one SYS_PUTC per byte and the LOG ring holds the executed bytes":
        # @req REQ-SSPEC-UNIT
        step("lowers print(\"hi\") to one SYS_PUTC per byte and the LOG ring holds the executed bytes")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 40), "print"), [string_lit("hi")]))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        assert_equal(read_log(result.arena, result.log_cap), "hi")

describe "SVM-G Task D4 lowering — float arithmetic and comparison":
    it "computes 1.5 + 2.5 via FADD and checks it against 4.0 via FEQ (expect().to_equal())":
        # @req REQ-SSPEC-UNIT
        step("computes 1.5 + 2.5 via FADD and checks it against 4.0 via FEQ (expect().to_equal())")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: expect_to_equal(
                binop(HirBinOp.Add, float_lit(1.5), float_lit(2.5)),
                float_lit(4.0),
            ))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, expected_signed_i32_bits(4.0))

    it "takes the FGT branch of an if (3.5 > 2.0) and accumulates the correct total":
        # @req REQ-SSPEC-UNIT
        step("takes the FGT branch of an if (3.5 > 2.0) and accumulates the correct total")
        val r_sym = SymbolId(id: 1)
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: r_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Expr(expr: e(HirExprKind.If(
                cond: binop(HirBinOp.Gt, float_lit(3.5), float_lit(2.0)),
                then_: block_no_tail([assign(var_(r_sym), HirAssignOp.Add, int_lit(1))]),
                else_: block_no_tail([assign(var_(r_sym), HirAssignOp.Add, int_lit(0))]),
            )))),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(r_sym), int_lit(1)))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_true(prog.ok)
        val result = assemble_and_run(prog.code, prog.step_budget, prog.entry_pc)
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 1)

# ============================================================================
# Rejection cases — one per design §4.4 excluded construct
# ============================================================================

describe "SVM-G Task D4 lowering — rejects excluded constructs (design doc §4.4)":
    it "rejects closures (Lambda)":
        # @req REQ-SSPEC-UNIT
        step("rejects closures (Lambda)")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: e(HirExprKind.Lambda(params: [], body: int_lit(0), captures: [])))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "closures")

    it "rejects GC types (struct-literal construction)":
        # @req REQ-SSPEC-UNIT
        step("rejects GC types (struct-literal construction)")
        val struct_ty = HirType(kind: HirTypeKind.Named(symbol: SymbolId(id: 99), args: []), span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: e(HirExprKind.StructLit(type_: struct_ty, fields: [])))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "GC types")

    it "rejects actors/async (await)":
        # @req REQ-SSPEC-UNIT
        step("rejects actors/async (await)")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: e(HirExprKind.Await(expr: int_lit(0))))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "actors/async")

    it "rejects text manipulation beyond literals (string interpolation)":
        # @req REQ-SSPEC-UNIT
        step("rejects text manipulation beyond literals (string interpolation)")
        val interp = HirInterpolation(expr: int_lit(1), has_format: false, format: "", span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: e(HirExprKind.StringLit(value: "x={0}", interpolations: [interp])))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "text manipulation")

    it "rejects dictionaries (DictLit)":
        # @req REQ-SSPEC-UNIT
        step("rejects dictionaries (DictLit)")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: e(HirExprKind.DictLit(entries: [], key_type: ty(), value_type: None)))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "dictionaries")

    it "rejects recursion (a helper fn calling itself)":
        # @req REQ-SSPEC-UNIT
        step("rejects recursion (a helper fn calling itself)")
        val n_sym = SymbolId(id: 1)
        val bad_fn = SvmgHelperFn(
            name: "bad",
            params: [param(n_sym, "n")],
            body: block_with_tail([], call(named_var(SymbolId(id: 20), "bad"), [var_(n_sym)])),
        )
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: expect_to_equal(call(named_var(SymbolId(id: 21), "bad"), [int_lit(1)]), int_lit(1)))),
        ])
        val prog = lower_svmg_program(body, [bad_fn], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "recursion")

# ============================================================================
# Completed D4 numeric subset plus unsupported numeric-operation guards.
# ============================================================================

describe "SVM-G Task D4 lowering — integer printing and float compound assignment":
    it "prints zero through generated bytecode":
        # @req REQ-SSPEC-UNIT
        step("Lower print(0) and inspect the reference VM LOG")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(0)]))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "0")
        assert_equal(result.record_count, 0)

    it "prints positive single-digit and multidigit integers":
        # @req REQ-SSPEC-UNIT
        step("Lower two integer print calls separated by a literal")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(7)]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(12345)]))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "7|12345")
        assert_equal(result.record_count, 0)

    it "prints negative single-digit and multidigit integers":
        # @req REQ-SSPEC-UNIT
        step("Execute negative integer formatting on the reference VM")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(-7)]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(-12345)]))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "-7|-12345")
        assert_equal(result.record_count, 0)

    it "prints both signed i32 limits without overflowing the minimum magnitude":
        # @req REQ-SSPEC-UNIT
        step("Execute i32 MIN and MAX decimal formatting")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(-2147483648)]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(2147483647)]))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "-2147483648|2147483647")
        assert_equal(result.record_count, 0)

    it "prints typed u32 high-bit values as unsigned decimal":
        # @req REQ-SSPEC-UNIT
        step("Execute the two unsigned high-bit decimal boundaries")
        val unsigned_ty = HirType(kind: HirTypeKind.Int(bits: 32, signed: false), span: Span.empty())
        val high_bit = HirExpr(kind: HirExprKind.IntLit(value: 2147483648, suffix: None), has_type_: true, type_: unsigned_ty, span: Span.empty())
        val maximum = HirExpr(kind: HirExprKind.IntLit(value: 4294967295, suffix: None), has_type_: true, type_: unsigned_ty, span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [high_bit]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [maximum]))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "2147483648|4294967295")
        assert_equal(result.record_count, 0)

    it "prints a safe untyped u32-suffixed maximum literal":
        # @req REQ-SSPEC-UNIT
        step("Use the literal suffix admission path rather than checked type metadata")
        val argument = e(HirExprKind.IntLit(value: 4294967295, suffix: Some("u32")))
        val result = run_print_body(block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [argument]))),
        ]), [])
        expect_vm_print_log(result, "4294967295")
        assert_equal(result.record_count, 0)

    it "rejects an unsupported wider suffix on an untyped integer literal":
        # @req REQ-SSPEC-UNIT
        step("Reject an i64 literal suffix instead of silently narrowing its value")
        val argument = e(HirExprKind.IntLit(value: 7, suffix: Some("i64")))
        val prog = lower_svmg_program(block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [argument]))),
        ]), [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "32-bit integer")

    it "rejects untyped literals outside their selected integer range":
        # @req REQ-SSPEC-UNIT
        step("Reject a absent-suffix i32 overflow and both u32 range boundaries")
        val signed_prog = lower_svmg_program(block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [int_lit(2147483648)]))),
        ]), [], 1000)
        assert_false(signed_prog.ok)
        assert_contains(signed_prog.error, "i32 range")
        for value in [-1, 4294967296]:
            val argument = e(HirExprKind.IntLit(value: value, suffix: Some("u32")))
            val unsigned_prog = lower_svmg_program(block_no_tail([
                s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [argument]))),
            ]), [], 1000)
            assert_false(unsigned_prog.ok)
            assert_contains(unsigned_prog.error, "u32 range")

    it "prints a dynamic local and expression repeatedly without scratch aliasing":
        # @req REQ-SSPEC-UNIT
        step("Keep two locals live across repeated prints and an arithmetic print")
        val left_sym = SymbolId(id: 1)
        val right_sym = SymbolId(id: 2)
        val left = HirExpr(kind: HirExprKind.Var(symbol: left_sym), has_type_: true, type_: ty(), span: Span.empty())
        val right = HirExpr(kind: HirExprKind.Var(symbol: right_sym), has_type_: true, type_: ty(), span: Span.empty())
        val difference = HirExpr(kind: HirExprKind.Binary(op: HirBinOp.Sub, left: left, right: int_lit(9)), has_type_: true, type_: ty(), span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: left_sym, type_: ty(), init: int_lit(123456789))),
            s(HirStmtKind.Let(symbol: right_sym, type_: ty(), init: int_lit(-987654321))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [left]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [right]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [difference]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [left]))),
            s(HirStmtKind.Expr(expr: expect_to_equal(left, int_lit(123456789)))),
            s(HirStmtKind.Expr(expr: expect_to_equal(right, int_lit(-987654321)))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "123456789|-987654321|123456780|123456789")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 2)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 123456789)
        assert_equal(records[1].passed, 1)
        assert_equal(records[1].value, -987654321)

    it "evaluates an integer print argument with observable helper side effects exactly once":
        # @req REQ-SSPEC-UNIT
        step("Print a helper result and retain the helper's single marker and result record")
        val value_sym = SymbolId(id: 77)
        val printed_param = HirExpr(kind: HirExprKind.Var(symbol: value_sym), has_type_: true, type_: ty(), span: Span.empty())
        val helper = SvmgHelperFn(name: "print_once_helper", params: [param(value_sym, "value")], body: block_with_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("call;")]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [printed_param]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(value_sym), int_lit(12345)))),
        ], var_(value_sym)))
        val invoked = call(named_var(SymbolId(id: 42), "print_once_helper"), [int_lit(12345)])
        val typed_call = HirExpr(kind: invoked.kind, has_type_: true, type_: ty(), span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [typed_call]))),
        ])
        val result = run_print_body(body, [helper])
        expect_vm_print_log(result, "call;12345|12345")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 12345)

    it "resets decimal scratch at the same print site on every loop iteration":
        # @req REQ-SSPEC-UNIT
        step("Execute one integer print site four times with shrinking digit counts")
        val value_sym = SymbolId(id: 1)
        val count_sym = SymbolId(id: 2)
        val value = HirExpr(kind: HirExprKind.Var(symbol: value_sym), has_type_: true, type_: ty(), span: Span.empty())
        val loop_body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [value]))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [string_lit("|")]))),
            assign(value, HirAssignOp.Div, int_lit(10)),
            assign(var_(count_sym), HirAssignOp.Add, int_lit(1)),
        ])
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: value_sym, type_: ty(), init: int_lit(1000))),
            s(HirStmtKind.Let(symbol: count_sym, type_: ty(), init: int_lit(0))),
            s(HirStmtKind.Expr(expr: e(HirExprKind.While(cond: binop(HirBinOp.Gt, value, int_lit(0)), body: loop_body, label: None)))),
            s(HirStmtKind.Expr(expr: expect_to_equal(value, int_lit(0)))),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(count_sym), int_lit(4)))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "1000|100|10|1|")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 2)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 0)
        assert_equal(records[1].passed, 1)
        assert_equal(records[1].value, 4)

    it "rejects printing a checked f32 value without a float formatting contract":
        # @req REQ-SSPEC-UNIT
        step("Reject a typed F32 print argument")
        val argument = HirExpr(kind: HirExprKind.FloatLit(value: 1.5, suffix: None), has_type_: true, type_: float_ty(), span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [argument]))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "32-bit integer")

    it "rejects printing a checked bool instead of treating its bits as an integer":
        # @req REQ-SSPEC-UNIT
        step("Reject a typed Bool print argument")
        val bool_ty = HirType(kind: HirTypeKind.Bool, span: Span.empty())
        val argument = HirExpr(kind: HirExprKind.BoolLit(value: true), has_type_: true, type_: bool_ty, span: Span.empty())
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [argument]))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "32-bit integer")

    it "rejects wider signed and unsigned integer print arguments":
        # @req REQ-SSPEC-UNIT
        step("Reject checked I64 and U64 instead of silently narrowing to the VM word")
        for signed in [true, false]:
            val wider_ty = HirType(kind: HirTypeKind.Int(bits: 64, signed: signed), span: Span.empty())
            val argument = HirExpr(kind: HirExprKind.IntLit(value: 7, suffix: None), has_type_: true, type_: wider_ty, span: Span.empty())
            val body = block_no_tail([
                s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [argument]))),
            ])
            val prog = lower_svmg_program(body, [], 1000)
            assert_false(prog.ok)
            assert_contains(prog.error, "32-bit integer")

    it "rejects an untyped dynamic print argument instead of guessing its integer kind":
        # @req REQ-SSPEC-UNIT
        step("Reject a dynamic Var without checked print type metadata")
        val value_sym = SymbolId(id: 1)
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: value_sym, type_: ty(), init: int_lit(7))),
            s(HirStmtKind.Expr(expr: call(named_var(SymbolId(id: 41), "print"), [var_(value_sym)]))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "32-bit integer")

    it "executes float compound addition on typed locals":
        # @req REQ-SSPEC-UNIT
        step("Execute F32 local += local and inspect the actual result bits")
        val result = run_print_body(float_compound_body(HirAssignOp.Add, 8.0, 2.0, 10.0), [])
        expect_vm_print_log(result, "")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, expected_signed_i32_bits(10.0))

    it "executes float compound subtraction on typed locals":
        # @req REQ-SSPEC-UNIT
        step("Execute F32 local -= local and inspect the actual result bits")
        val result = run_print_body(float_compound_body(HirAssignOp.Sub, 8.0, 2.0, 6.0), [])
        expect_vm_print_log(result, "")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, expected_signed_i32_bits(6.0))

    it "executes float compound multiplication on typed locals":
        # @req REQ-SSPEC-UNIT
        step("Execute F32 local *= local and inspect the actual result bits")
        val result = run_print_body(float_compound_body(HirAssignOp.Mul, 8.0, 2.0, 16.0), [])
        expect_vm_print_log(result, "")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, expected_signed_i32_bits(16.0))

    it "executes float compound division on typed locals":
        # @req REQ-SSPEC-UNIT
        step("Execute F32 local /= local and inspect the actual result bits")
        val result = run_print_body(float_compound_body(HirAssignOp.Div, 8.0, 2.0, 4.0), [])
        expect_vm_print_log(result, "")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, expected_signed_i32_bits(4.0))

    it "preserves integer compound arithmetic":
        # @req REQ-SSPEC-UNIT
        step("Execute the existing integer compound operator map as a control")
        val value_sym = SymbolId(id: 1)
        val body = block_no_tail([
            s(HirStmtKind.Let(symbol: value_sym, type_: ty(), init: int_lit(8))),
            assign(var_(value_sym), HirAssignOp.Add, int_lit(2)),
            assign(var_(value_sym), HirAssignOp.Sub, int_lit(1)),
            assign(var_(value_sym), HirAssignOp.Mul, int_lit(3)),
            assign(var_(value_sym), HirAssignOp.Div, int_lit(3)),
            s(HirStmtKind.Expr(expr: expect_to_equal(var_(value_sym), int_lit(9)))),
        ])
        val result = run_print_body(body, [])
        expect_vm_print_log(result, "")
        val records = read_records(result.arena, result.log_cap, result.record_count)
        assert_equal(records.len(), 1)
        assert_equal(records[0].passed, 1)
        assert_equal(records[0].value, 9)

    it "rejects float compound remainder bitwise and shift operations":
        # @req REQ-SSPEC-UNIT
        step("Reject every compound operation without a defined float VM opcode")
        for op in [HirAssignOp.Mod, HirAssignOp.BitAnd, HirAssignOp.BitOr, HirAssignOp.BitXor, HirAssignOp.Shl, HirAssignOp.Shr]:
            val prog = lower_svmg_program(float_compound_body(op, 8.0, 2.0, 0.0), [], 1000)
            assert_false(prog.ok)
            assert_contains(prog.error, "float operands")

    it "rejects float binary bitwise and shift operations":
        # @req REQ-SSPEC-UNIT
        step("Reject float binary operators instead of reinterpreting their F32 bits as integers")
        for op in [HirBinOp.BitAnd, HirBinOp.BitOr, HirBinOp.BitXor, HirBinOp.Shl, HirBinOp.Shr]:
            val body = block_no_tail([
                s(HirStmtKind.Expr(expr: binop(op, float_lit(8.0), float_lit(2.0)))),
            ])
            val prog = lower_svmg_program(body, [], 1000)
            assert_false(prog.ok)
            assert_contains(prog.error, "float operands")

    it "rejects REM on float operands instead of silently emitting the integer REM opcode":
        # @req REQ-SSPEC-UNIT
        step("rejects REM on float operands instead of silently emitting the integer REM opcode")
        val body = block_no_tail([
            s(HirStmtKind.Expr(expr: expect_to_equal(binop(HirBinOp.Mod, float_lit(5.0), float_lit(2.0)), float_lit(1.0)))),
        ])
        val prog = lower_svmg_program(body, [], 1000)
        assert_false(prog.ok)
        assert_contains(prog.error, "float operands")

describe "SVM-G checked i32 right shift signedness":
    it "executes signed binary shifts with zero sign-bit and masked counts":
        step("Run checked I32 -8 right shifts and the positive control on the actual VM")
        val counts = [0, 1, 31, 33]
        val expected = [-8, -4, -1, -4]
        for index in 0..4:
            val result = run_print_body(integer_shift_body(-8, counts[index], true, false, expected[index]), [])
            expect_vm_shift_result(result, expected[index])
        expect_vm_shift_result(run_print_body(integer_shift_body(8, 1, true, false, 4), []), 4)

    it "executes signed compound shifts with the same count masking":
        step("Run checked I32 >>= through generated bytecode")
        val counts = [0, 1, 31, 33]
        val expected = [-8, -4, -1, -4]
        for index in 0..4:
            val result = run_print_body(integer_shift_body(-8, counts[index], true, true, expected[index]), [])
            expect_vm_shift_result(result, expected[index])

    it "keeps checked U32 shifts logical despite a checked signed count":
        step("Run U32 high-bit binary and compound shifts with an I32 right operand")
        for compound in [false, true]:
            val result = run_print_body(integer_shift_body(2147483648, 1, false, compound, 1073741824), [])
            expect_vm_shift_result(result, 1073741824)

    it "preserves logical shifting for the legacy untyped left operand":
        step("Run untyped binary and compound right shifts without claiming checked signed metadata")
        for compound in [false, true]:
            val symbol = SymbolId(id: 1)
            var stmts = [s(HirStmtKind.Let(symbol: symbol, type_: ty(), init: int_lit(-8)))]
            if compound:
                stmts = stmts.push(assign(var_(symbol), HirAssignOp.Shr, int_lit(1)))
            val actual = if compound: var_(symbol) else: binop(HirBinOp.Shr, var_(symbol), int_lit(1))
            stmts = stmts.push(s(HirStmtKind.Expr(expr: expect_to_equal(actual, int_lit(2147483644)))))
            expect_vm_shift_result(run_print_body(block_no_tail(stmts), []), 2147483644)
