use std.spec
use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mir.mir_data.*

describe "LLVM pointer-backed integer constants":
    it "preserves the absent optional payload's tagged nil word":
        var translator = MirToLlvm.create("pointer_nil", CodegenTarget.AArch64, nil)
        # SSA-created destinations have no registered local: instruction type
        # must remain authoritative, including pointer metadata for later uses.
        translator.translate_const(LocalId(id: 129), MirConstValue.Int(3), MirType.ptr(MirType.i64(), false))
        val output = translator.builder.build()
        expect(output).to_contain("%l129 = inttoptr i64 3 to ptr")
        expect(output.contains("add ptr")).to_equal(false)
        expect(translator.get_local_type(129)).to_equal("ptr")
        expect(translator.ptr_locals.has(129)).to_equal(true)

    it "uses the target pointer width for registered pointer locals":
        var translator = MirToLlvm.create("pointer_32", CodegenTarget.X86, nil)
        translator.local_types[7] = "ptr"
        translator.translate_const(LocalId(id: 7), MirConstValue.Int(3), MirType.i64())
        expect(translator.builder.build()).to_contain("%l7 = inttoptr i32 3 to ptr")

    it "retains nonzero and negative pointer bit patterns without boxing":
        var translator = MirToLlvm.create("pointer_bits", CodegenTarget.X86_64, nil)
        val pointer_type = MirType.ptr(MirType.i64(), false)
        translator.translate_const(LocalId(id: 1), MirConstValue.Int(4097), pointer_type)
        translator.translate_const(LocalId(id: 2), MirConstValue.Int(-1), pointer_type)
        val output = translator.builder.build()
        expect(output).to_contain("%l1 = inttoptr i64 4097 to ptr")
        expect(output).to_contain("%l2 = inttoptr i64 -1 to ptr")
        expect(output.contains("call ")).to_equal(false)

    it "retains ordinary integer arithmetic constants and null's zero bits":
        var translator = MirToLlvm.create("integer_and_null", CodegenTarget.AArch64, nil)
        translator.translate_const(LocalId(id: 1), MirConstValue.Int(-7), MirType.i64())
        translator.translate_const(LocalId(id: 2), MirConstValue.Int(0), MirType.ptr(MirType.i64(), false))
        val output = translator.builder.build()
        expect(output).to_contain("%l1 = add i64 -7, 0")
        expect(output).to_contain("%l2 = inttoptr i64 0 to ptr")
