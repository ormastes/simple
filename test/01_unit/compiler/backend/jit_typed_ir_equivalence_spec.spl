# Typed JIT IR contract — semantic equivalence (audit gap #17, reproducing spec).
#
# A function lowered through the typed-IR contract (MIR -> JitTypedFunction ->
# word stream -> JitTypedFunction -> typed evaluator) must produce the SAME
# observable result as the current path (MirInterpreter, and ExecIR's untyped
# tight loop). No source text is involved anywhere on this path.
#
# Contract: src/compiler/70.backend/jit_typed_ir.spl

use std.spec
use compiler.interp.mir_interpreter.{MirInterpreter}
use compiler.interp.execir.{ExecIrProgram, execir_encode, execir_run}
use compiler.backend.jit_typed_ir.*
use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.*
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default}

fn tj_local(id: i64, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: MirType.i64(), kind: kind, is_ghost: false)

fn tj_fn(name: text, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId.new(-1),
        name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: locals,
        blocks: blocks,
        entry_block: BlockId.new(0),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false,
        unroll_factor: 0,
        pipeline_ii: 0,
        memory_banks: 0,
        verification_contract: nil
    )

fn tj_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn tj_blk(id: i64, insts: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId.new(id), label: nil, instructions: insts, terminator: term)

fn tj_lid(id: i64) -> LocalId:
    LocalId(id: id)

# fn arith() = (7 + 5) * 3 - 4
fn tj_arith_fn() -> MirFunction:
    val locals = [tj_local(0, LocalKind.Temp), tj_local(1, LocalKind.Temp), tj_local(2, LocalKind.Temp)]
    val b0 = tj_blk(0, [
        tj_inst(MirInstKind.BinOp(tj_lid(0), MirBinOp.Add, mir_operand_const_int(7), mir_operand_const_int(5))),
        tj_inst(MirInstKind.BinOp(tj_lid(1), MirBinOp.Mul, mir_operand_copy(tj_lid(0)), mir_operand_const_int(3))),
        tj_inst(MirInstKind.BinOp(tj_lid(2), MirBinOp.Sub, mir_operand_copy(tj_lid(1)), mir_operand_const_int(4)))
    ], MirTerminator.Ret(Some(mir_operand_copy(tj_lid(2)))))
    tj_fn("arith", locals, [b0])

# fn unary_copy() = -(7) via Neg then Copy
fn tj_unary_fn() -> MirFunction:
    val locals = [tj_local(0, LocalKind.Var), tj_local(1, LocalKind.Temp), tj_local(2, LocalKind.Temp)]
    val b0 = tj_blk(0, [
        tj_inst(MirInstKind.Const(tj_lid(0), MirConstValue.Int(7), MirType.i64())),
        tj_inst(MirInstKind.UnaryOp(tj_lid(1), MirUnaryOp.Neg, mir_operand_copy(tj_lid(0)))),
        tj_inst(MirInstKind.Copy(tj_lid(2), tj_lid(1)))
    ], MirTerminator.Ret(Some(mir_operand_copy(tj_lid(2)))))
    tj_fn("unary_copy", locals, [b0])

# fn branch(c) = if c != 0: 7 else: 9
fn tj_branch_fn(c: i64) -> MirFunction:
    val locals = [tj_local(0, LocalKind.Var)]
    val b0 = tj_blk(0, [
        tj_inst(MirInstKind.Const(tj_lid(0), MirConstValue.Int(c), MirType.i64()))
    ], MirTerminator.If(mir_operand_copy(tj_lid(0)), BlockId.new(1), BlockId.new(2)))
    val b1 = tj_blk(1, [], MirTerminator.Ret(Some(mir_operand_const_int(7))))
    val b2 = tj_blk(2, [], MirTerminator.Ret(Some(mir_operand_const_int(9))))
    tj_fn("branch", locals, [b0, b1, b2])

# sum 0..n-1 via a loop with out-of-order blocks
fn tj_loop_fn(n: i64) -> MirFunction:
    val locals = [tj_local(0, LocalKind.Var), tj_local(1, LocalKind.Var), tj_local(2, LocalKind.Temp)]
    val b0 = tj_blk(0, [
        tj_inst(MirInstKind.Const(tj_lid(0), MirConstValue.Int(0), MirType.i64())),
        tj_inst(MirInstKind.Const(tj_lid(1), MirConstValue.Int(0), MirType.i64()))
    ], MirTerminator.Goto(BlockId.new(1)))
    val b1 = tj_blk(1, [
        tj_inst(MirInstKind.BinOp(tj_lid(2), MirBinOp.Lt, mir_operand_copy(tj_lid(0)), mir_operand_const_int(n)))
    ], MirTerminator.If(mir_operand_copy(tj_lid(2)), BlockId.new(2), BlockId.new(3)))
    val b2 = tj_blk(2, [
        tj_inst(MirInstKind.BinOp(tj_lid(1), MirBinOp.Add, mir_operand_copy(tj_lid(1)), mir_operand_copy(tj_lid(0)))),
        tj_inst(MirInstKind.BinOp(tj_lid(0), MirBinOp.Add, mir_operand_copy(tj_lid(0)), mir_operand_const_int(1)))
    ], MirTerminator.Goto(BlockId.new(1)))
    val b3 = tj_blk(3, [], MirTerminator.Ret(Some(mir_operand_copy(tj_lid(1)))))
    tj_fn("loop_sum", locals, [b0, b3, b1, b2])

# bitwise/shift coverage
fn tj_bits_fn() -> MirFunction:
    val locals = [tj_local(0, LocalKind.Temp), tj_local(1, LocalKind.Temp), tj_local(2, LocalKind.Temp)]
    val b0 = tj_blk(0, [
        tj_inst(MirInstKind.BinOp(tj_lid(0), MirBinOp.Shl, mir_operand_const_int(3), mir_operand_const_int(4))),
        tj_inst(MirInstKind.BinOp(tj_lid(1), MirBinOp.BitXor, mir_operand_copy(tj_lid(0)), mir_operand_const_int(255))),
        tj_inst(MirInstKind.UnaryOp(tj_lid(2), MirUnaryOp.BitNot, mir_operand_copy(tj_lid(1))))
    ], MirTerminator.Ret(Some(mir_operand_copy(tj_lid(2)))))
    tj_fn("bits", locals, [b0])

fn tj_interp(f: MirFunction) -> i64:
    var interp = MirInterpreter.create()
    val res = interp.execute_function(f)
    res[0] ?? -1

# Full contract path: MIR -> typed -> verify -> words -> typed -> verify -> eval.
# Returns nil if ANY stage rejects. No source text on this path.
fn tj_contract_eval(f: MirFunction) -> i64?:
    val tf0 = jit_typed_from_mir(f)
    if tf0 == nil:
        return nil
    val tf = tf0 ?? JitTypedFunction(name: "", params: [], ret: JitType.I64, reg_types: [], code: [], const_regs: [], const_vals: [], entry_pc: 0)
    if not jit_verdict_ok(jit_typed_verify(tf)):
        return nil
    val words = jit_typed_to_words(tf)
    val rt0 = jit_typed_from_words(tf.name, words)
    if rt0 == nil:
        return nil
    val rt = rt0 ?? tf
    if not jit_verdict_ok(jit_typed_verify(rt)):
        return nil
    jit_typed_eval(rt)

fn tj_execir(f: MirFunction) -> i64:
    val p = execir_encode(f)
    execir_run(p ?? ExecIrProgram(code: [], reg_count: 0, const_regs: [], const_vals: [], entry_pc: 0))

describe "Typed JIT IR contract — semantic equivalence with the current path":
    it "arith: typed contract == ExecIR == MirInterpreter (32)":
        val got = tj_contract_eval(tj_arith_fn())
        expect(got != nil).to_equal(true)
        expect(got ?? -1).to_equal(32)
        expect(got ?? -1).to_equal(tj_execir(tj_arith_fn()))
        expect(got ?? -1).to_equal(tj_interp(tj_arith_fn()))

    it "unary + copy: typed contract == ExecIR == MirInterpreter (-7)":
        val got = tj_contract_eval(tj_unary_fn())
        expect(got ?? 0).to_equal(-7)
        expect(got ?? 0).to_equal(tj_execir(tj_unary_fn()))
        expect(got ?? 0).to_equal(tj_interp(tj_unary_fn()))

    it "branch both ways: typed contract == ExecIR == MirInterpreter":
        val t = tj_contract_eval(tj_branch_fn(1))
        val e = tj_contract_eval(tj_branch_fn(0))
        expect(t ?? 0).to_equal(7)
        expect(e ?? 0).to_equal(9)
        expect(t ?? 0).to_equal(tj_interp(tj_branch_fn(1)))
        expect(e ?? 0).to_equal(tj_interp(tj_branch_fn(0)))
        expect(t ?? 0).to_equal(tj_execir(tj_branch_fn(1)))
        expect(e ?? 0).to_equal(tj_execir(tj_branch_fn(0)))

    it "loop with out-of-order blocks: sum 0..49 == 1225 on all three paths":
        val got = tj_contract_eval(tj_loop_fn(50))
        expect(got ?? -1).to_equal(1225)
        expect(got ?? -1).to_equal(tj_execir(tj_loop_fn(50)))
        expect(got ?? -1).to_equal(tj_interp(tj_loop_fn(50)))

    it "bitwise and shifts: typed contract == ExecIR == MirInterpreter":
        val got = tj_contract_eval(tj_bits_fn())
        expect(got != nil).to_equal(true)
        expect(got ?? -1).to_equal(tj_execir(tj_bits_fn()))
        expect(got ?? -1).to_equal(tj_interp(tj_bits_fn()))

    it "word stream round-trips every field faithfully — no type loss":
        val tf0 = jit_typed_from_mir(tj_loop_fn(50))
        expect(tf0 != nil).to_equal(true)
        val tf = tf0 ?? JitTypedFunction(name: "", params: [], ret: JitType.I64, reg_types: [], code: [], const_regs: [], const_vals: [], entry_pc: 0)
        val rt0 = jit_typed_from_words("loop_sum", jit_typed_to_words(tf))
        expect(rt0 != nil).to_equal(true)
        val rt = rt0 ?? tf
        expect(rt.reg_types.len()).to_equal(tf.reg_types.len())
        expect(rt.code.len()).to_equal(tf.code.len())
        expect(rt.entry_pc).to_equal(tf.entry_pc)
        expect(rt.const_regs.len()).to_equal(tf.const_regs.len())
        expect(jit_type_code(rt.ret)).to_equal(jit_type_code(tf.ret))
        var i = 0
        var types_equal = true
        while i < tf.reg_types.len():
            if jit_type_code(rt.reg_types[i]) != jit_type_code(tf.reg_types[i]):
                types_equal = false
            i = i + 1
        expect(types_equal).to_equal(true)
        var j = 0
        var code_equal = true
        while j < tf.code.len():
            if rt.code[j] != tf.code[j]:
                code_equal = false
            j = j + 1
        expect(code_equal).to_equal(true)

    it "reg_types covers every register — no untyped register reaches a JIT":
        val tf0 = jit_typed_from_mir(tj_arith_fn())
        val tf = tf0 ?? JitTypedFunction(name: "", params: [], ret: JitType.I64, reg_types: [], code: [], const_regs: [], const_vals: [], entry_pc: 0)
        var maxreg = -1
        var pc = 0
        while pc < tf.code.len():
            val op = tf.code[pc]
            if op >= 10:
                if tf.code[pc + 1] > maxreg: maxreg = tf.code[pc + 1]
                if tf.code[pc + 2] > maxreg: maxreg = tf.code[pc + 2]
                if op <= 25 and tf.code[pc + 3] > maxreg: maxreg = tf.code[pc + 3]
            elif op == 1 or op == 2 or op == 5:
                if tf.code[pc + 1] > maxreg: maxreg = tf.code[pc + 1]
            pc = pc + 4
        expect(maxreg >= 0).to_equal(true)
        expect(tf.reg_types.len() > maxreg).to_equal(true)
