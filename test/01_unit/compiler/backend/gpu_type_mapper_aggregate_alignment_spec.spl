use std.spec.*
use compiler.mir.mir_data.{MirType, MirTypeKind}
use plugins.backend_cuda.cuda_type_mapper.{CudaTypeMapper}
use plugins.backend_vulkan.vulkan_type_mapper.{VulkanTypeMapper}

fn mixed_tuple() -> MirType:
    MirType(kind: MirTypeKind.Tuple([MirType.bool(), MirType.i64()]))

describe "GPU type mapper aggregate alignment":
    it "computes CUDA tuple alignment without an unresolved Array.max call":
        expect(CudaTypeMapper.create().align_of(mixed_tuple())).to_equal(8)

    it "computes Vulkan tuple alignment without an unresolved Array.max call":
        expect(VulkanTypeMapper.create().align_of(mixed_tuple())).to_equal(8)
