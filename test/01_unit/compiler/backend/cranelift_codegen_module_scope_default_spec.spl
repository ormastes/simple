# Bug stage2_cranelift_codegen_scope_default_off_2026-11-07: the Cranelift
# per-module codegen scope must be on by default (SIMPLE_CODEGEN_MODULE_SCOPE
# unset); only an explicit "0" keeps the unscoped lane. Other backends keep
# the explicit "1" opt-in. The RSS half of this contract is measured by
# scripts/bootstrap/tests/cranelift-codegen-scope-rss-test.shs (needs a built compiler).
use std.spec.{describe, it, expect}
use compiler.backend.backend_helpers.{codegen_module_scope_enabled_for_v1}

describe "cranelift codegen module scope default":
    it "is on for cranelift unless the knob is 0":
        expect(codegen_module_scope_enabled_for_v1("cranelift", "")).to_equal(true)
        expect(codegen_module_scope_enabled_for_v1("cranelift", "1")).to_equal(true)
        expect(codegen_module_scope_enabled_for_v1("cranelift", "0")).to_equal(false)

    it "stays opt-in for the other in-memory backends":
        expect(codegen_module_scope_enabled_for_v1("llvm", "")).to_equal(false)
        expect(codegen_module_scope_enabled_for_v1("llvm", "1")).to_equal(true)
        expect(codegen_module_scope_enabled_for_v1("auto", "")).to_equal(false)
        expect(codegen_module_scope_enabled_for_v1("auto", "0")).to_equal(false)
