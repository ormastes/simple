use compiler.backend.backend.llvm_type_mapper.{LlvmTypeMapper}
use compiler.mir.mir_data.*
use compiler.hir.hir_types.{SymbolId}

describe "Llvm Type Mapper - real MIR Struct type (SymbolId payload)":
    it "computes a sane pointer-sized value for size_of/align_of on Struct(symbol)":
        # Real MIR always constructs Struct as MirTypeKind.Struct(SymbolId(...)) --
        # never as a field list. See e.g.
        # src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl:3468
        # `MirType(kind: MirTypeKind.Struct(canonical_symbol))`.
        val mapper = LlvmTypeMapper.create()
        val struct_ty = MirType(kind: MirTypeKind.Struct(SymbolId(id: 7)))

        # Aggregates are pointer-passed at the LLVM ABI boundary (64-bit),
        # matching the fix already applied to CraneliftTypeMapper/CTypeMapper
        # ("Struct kind carries only a SymbolId; aggregates are pointer-passed").
        expect(mapper.size_of(struct_ty)).to_equal(8)
        expect(mapper.align_of(struct_ty)).to_equal(8)
