# Gap debug_info_path_prefix (live_object_key.sdn) closed: debug-info source
# paths under the build root are emitted root-relative.
use std.spec
use compiler.backend._MirToLlvm.core_codegen.{debug_info_prefix_map_path}

describe "debug_info_prefix_map_path":
    it "strips the build root from an absolute path":
        expect(debug_info_prefix_map_path("/home/a/repo/src/m.spl", "/home/a/repo")).to_equal("src/m.spl")
        expect(debug_info_prefix_map_path("/home/b/ws2/src/m.spl", "/home/b/ws2/")).to_equal("src/m.spl")

    it "makes two workspaces emit the same path":
        val one = debug_info_prefix_map_path("C:/dev/wt-a/src/m.spl", "C:/dev/wt-a")
        val two = debug_info_prefix_map_path("c:/dev/wt-b/src/m.spl", "C:/dev/wt-b/")
        expect(one).to_equal("src/m.spl")
        expect(two).to_equal(one)

    it "leaves relative and outside-root paths alone":
        expect(debug_info_prefix_map_path("src/m.spl", "/home/a/repo")).to_equal("src/m.spl")
        expect(debug_info_prefix_map_path("/home/a/repo2/m.spl", "/home/a/repo")).to_equal("/home/a/repo2/m.spl")
        expect(debug_info_prefix_map_path("/home/a/repo", "/home/a/repo")).to_equal("/home/a/repo")
