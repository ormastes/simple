use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "VHDL trace hot-path policy":
    it "samples catalog trace state once outside function and metadata loops":
        val source = file_read(
            "src/plugins/backend_vhdl/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain(
            "val trace_enabled = (_sffi_env_get(\"SIMPLE_COMPILER_TRACE\") ?? \"\") == \"1\"")
        expect(source).to_contain(
            "if trace_enabled and func.name.starts_with(\"core32_\"):")
        expect(source.contains(
            "if (rt_env_get(\"SIMPLE_COMPILER_TRACE\") ?? \"\") == \"1\" and func.name")).to_be(false)
        expect(source).to_contain("[vhdl-catalog] match module=")
        expect(source).to_contain("[vhdl-catalog] rebase module=")
        expect(source).to_contain("[vhdl-catalog] candidate module=")
        expect(source).to_contain("if modules.len() == 0:")
        expect(source.contains("modules.keys().len()")).to_be(false)

    it "samples driver trace state once after entry validation":
        val source = file_read(
            "src/compiler/80.driver/driver_aot_vhdl_output.spl")
        expect(source).to_contain(
            "val entry_module: text = _driver_vhdl_enum_payload_raw(entry_result)")
        expect(source).to_contain(
            "val trace_enabled = (env_get_opt(\"SIMPLE_COMPILER_TRACE\") ?? \"\") == \"1\"")
        expect(source).to_contain(
            "if trace_enabled and metadata.function_name.starts_with(\"core32_\"):")
        expect(source.contains(
            "if (rt_env_get(\"SIMPLE_COMPILER_TRACE\") ?? \"\") == \"1\":")).to_be(false)
        expect(source).to_contain("[vhdl-driver] root=")
        expect(source).to_contain("[vhdl-driver] metadata-row module=")
        expect(source).to_contain("[vhdl-driver] catalog_disc=")
        expect(source).to_contain("[vhdl-driver] catalog payload extracted")
