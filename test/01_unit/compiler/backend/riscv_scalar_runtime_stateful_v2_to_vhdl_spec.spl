use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_lsu_composition.{
    strict_riscv_scalar_runtime_stateful_composition_v2}
use compiler.backend.backend.riscv_scalar_runtime_stateful_v2_to_vhdl.{
    compile_strict_riscv_scalar_runtime_stateful_v2_vhdl,
    render_strict_riscv_scalar_runtime_stateful_v2_vhdl,
    scalar_runtime_stateful_v2_vhdl_closure_diagnostic}

describe "dedicated strict runtime stateful v2 VHDL backend":
    it "renders the canonical LSU plus FENCE closure with complete provenance":
        val graph = strict_riscv_scalar_runtime_stateful_composition_v2(
            "runtime_stateful_v2_vhdl_rv32", CoreConfig.rv32(), LsuConfig.xlen(32)).unwrap()
        expect(scalar_runtime_stateful_v2_vhdl_closure_diagnostic(graph)).to_equal("")
        val result = compile_strict_riscv_scalar_runtime_stateful_v2_vhdl(
            "runtime_stateful_v2_vhdl_rv32", CoreConfig.rv32(), LsuConfig.xlen(32))
        expect(result.is_success()).to_equal(true)
        if result.is_success():
            expect(result.route).to_equal("hwir-gen2-scalar-runtime-stateful-composition-v2")
            expect(result.hwir_graph_sha256).to_equal(graph.structural_sha256())
            for marker in ["top=", "config=", "bus=",
                    "plan=" + graph.plan.structural_sha256(),
                    "schema=" + graph.decoded.structural_sha256(),
                    "protocol=" + graph.protocol.structural_sha256(),
                    "child-decoder=" + graph.decoder.structural_sha256(),
                    "child-pending=" + graph.pending.structural_sha256(),
                    "child-projection=" + graph.projection.structural_sha256(),
                    "child-lsu=" + graph.lsu.structural_sha256(),
                    "child-fence=" + graph.fence.structural_sha256(),
                    "child-idle=" + graph.idle.structural_sha256(),
                    "child-route=" + graph.route.structural_sha256()]:
                expect(result.vhdl).to_contain("-- simple-hwir " + marker)
            expect(result.vhdl).to_contain("pending: entity work." + graph.pending.entity_name)
            expect(result.vhdl).to_contain("lsu: entity work." + graph.lsu.entity_name)
            expect(result.vhdl).to_contain("fence: entity work." + graph.fence.entity_name)
            expect(result.vhdl).to_contain("projection: entity work." + graph.projection.summary.name)
            expect(result.vhdl).to_contain("idle: entity work." + graph.idle.summary.name)
            expect(result.vhdl).to_contain("route_owner: entity work." + graph.route.summary.name)
            expect(result.vhdl).to_contain(
                "fence_effect_valid <= source_o5_fence_p18_fence_effect_valid")

    it "specializes the exact RV64 bus and FENCE payload widths":
        val result = compile_strict_riscv_scalar_runtime_stateful_v2_vhdl(
            "runtime_stateful_v2_vhdl_rv64", CoreConfig.rv64(), LsuConfig.xlen(64))
        expect(result.is_success()).to_equal(true)
        if result.is_success():
            expect(result.config_xlen).to_equal(64)
            expect(result.vhdl).to_contain(
                "bus_request_write_data : out std_logic_vector(63 downto 0)")
            expect(result.vhdl).to_contain("fence_effect_fm : out std_logic_vector(3 downto 0)")

    it "rejects alien routes and preserves the dedicated route in the rejection":
        val graph = strict_riscv_scalar_runtime_stateful_composition_v2(
            "runtime_stateful_v2_route_guard", CoreConfig.rv32(), LsuConfig.xlen(32)).unwrap()
        val rejected = render_strict_riscv_scalar_runtime_stateful_v2_vhdl(
            graph, "hwir-gen2-scalar-runtime-lsu-composition-v1")
        expect(rejected.is_success()).to_equal(false)
        expect(rejected.route).to_equal("hwir-gen2-scalar-runtime-stateful-composition-v2")
        expect(rejected.diagnostic).to_contain("HWIR-E-RISCV-RUNTIME-STATEFUL-V2-VHDL-ROUTE")

    it "rejects non-XLEN bus geometry with one diagnostic":
        val rejected = compile_strict_riscv_scalar_runtime_stateful_v2_vhdl(
            "runtime_stateful_v2_bad_bus", CoreConfig.rv32(), LsuConfig.xlen(64))
        expect(rejected.is_success()).to_equal(false)
        expect(rejected.vhdl).to_equal("")
        expect(rejected.route).to_equal("hwir-gen2-scalar-runtime-stateful-composition-v2")
        expect(rejected.diagnostic).to_contain("one XLEN-wide bus beat")
