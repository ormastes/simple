"""
## Purpose and audience
Purpose: Verify canonical and re-exported OutputFormat, BuildMode, CompiledSymbol, and CompiledSymbolKind compile and behave identically across compiler modules.
Audience: Compiler engineers maintaining shared driver/frontend/backend/linker types.
"""
# @cover src/compiler/00.common/driver_core_modes.spl
# @cover src/compiler/70.backend/backend/backend_types.spl
# @cover src/compiler/10.frontend/core/backend_types.spl
# @cover src/compiler/70.backend/linker/link.spl
# @cover src/compiler/80.driver/build_mode.spl
# @req REQ-COMPFIX-7

use std.spec.*
use compiler.common.driver_core_modes.{OutputFormat, driver_output_format_shared_lib}
use compiler.backend.backend.backend_types.{BuildMode, CompiledSymbol, CompiledSymbolKind}
use compiler.backend.linker.link.{OutputFormat as LinkOutputFormat}
use compiler.driver.build_mode.{BuildMode as DriverBuildMode}
use compiler.frontend.core.backend_types.{
    OutputFormat as FrontendOutputFormat,
    BuildMode as FrontendBuildMode,
    CompiledSymbol as FrontendCompiledSymbol,
    CompiledSymbolKind as FrontendCompiledSymbolKind,
    OPT_NONE, OPT_DEBUG, OPT_SPEED, OPT_SIZE
}

describe "Single-terminal compiler backend/driver types":
    it "shares canonical OutputFormat across common, frontend, and linker modules":
        step("Exercise canonical and re-exported OutputFormat variants including SharedLib")
        expect(OutputFormat.SharedLib.to_text()).to_equal("shared-lib")
        expect(LinkOutputFormat.SharedLib.to_text()).to_equal("shared-lib")
        expect(FrontendOutputFormat.SharedLib.to_text()).to_equal("shared-lib")
        expect(driver_output_format_shared_lib().to_text()).to_equal("shared-lib")
        expect(OutputFormat.from_text("native").to_text()).to_equal("native")

    it "shares canonical BuildMode across backend, driver, and frontend modules":
        step("Exercise BuildMode methods and frontend default_optimization extension")
        expect(BuildMode.Debug.is_debug()).to_equal(true)
        expect(DriverBuildMode.Release.is_release()).to_equal(true)
        expect(FrontendBuildMode.Bootstrap.to_text()).to_equal("bootstrap")
        expect(FrontendBuildMode.Debug.default_optimization()).to_equal(OPT_DEBUG)
        expect(FrontendBuildMode.Release.default_optimization()).to_equal(OPT_SPEED)
        expect(FrontendBuildMode.Test.default_optimization()).to_equal(OPT_NONE)
        expect(FrontendBuildMode.Bootstrap.default_optimization()).to_equal(OPT_SIZE)

    it "shares canonical CompiledSymbol and CompiledSymbolKind":
        step("Construct CompiledSymbol and convert CompiledSymbolKind via canonical and frontend imports")
        val sym = CompiledSymbol(
            name: "main",
            kind: CompiledSymbolKind.Function,
            address: 4096,
            size: 64
        )
        val frontend_sym = FrontendCompiledSymbol(
            name: "tbl",
            kind: FrontendCompiledSymbolKind.Data,
            address: 8192,
            size: 16
        )
        expect(sym.kind.to_text()).to_equal("function")
        expect(frontend_sym.kind.to_text()).to_equal("data")
