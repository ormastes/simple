# @req: REQ-COMPILER-ARM32-EMIT-OBJECT-001
"""
## Purpose and audience
Purpose: Prove the source-level ARM32 relocatable-object target and acceptance contracts.
Audience: compiler/backend maintainers shipping Pure Simple cross-target objects.
"""

import std.spec
use std.spec.step
use std.io_runtime.{read_file_text}
use compiler.backend.backend.llvm_target.{llvm_arm32_baremetal_environment}

describe "Pure Simple ARM32 emit-object contract":
    it "preserves explicit hard-float and conservative soft-float EABI targets":
        step("Verify: preserve the requested ARM32 bare-metal ABI")
        expect(llvm_arm32_baremetal_environment("armv7-unknown-none-eabihf")).to_equal("eabihf")
        expect(llvm_arm32_baremetal_environment("armv7-unknown-none-eabi")).to_equal("eabi")
        expect(llvm_arm32_baremetal_environment("armv7")).to_equal("eabi")

    it "keeps the exact CLI and Cosmos ELF acceptance regression executable":
        step("Verify: exact source, CLI, object-format, symbol, relocation, and link checks exist")
        val runner = read_file_text(
            "test/02_integration/os/cosmos/run_pure_simple_arm32_emit_object_test.shs")
        val fixture = read_file_text(
            "test/fixtures/os/cosmos/simple_object_link_probe.spl")
        expect(fixture).to_contain("@export(\"C\", name: \"cosmos_simple_object_link_probe\")")
        expect(fixture).to_contain("fn cosmos_simple_object_link_probe(value: u32) -> u32:")
        expect(fixture).to_contain("value + 1")
        expect(runner).to_contain("simple_object_link_probe.spl")
        expect(runner).to_contain("--target armv7-unknown-none-eabihf --emit-object")
        expect(runner).to_contain("Type:[[:space:]]+REL")
        expect(runner).to_contain("Machine:[[:space:]]+ARM")
        expect(runner).to_contain("readelf -SW")
        expect(runner).to_contain("cosmos_simple_object_link_probe")
        expect(runner).to_contain("__aeabi_unwind_cpp_pr0")
        expect(runner).to_contain("readelf -rW")
        expect(runner).to_contain("ld.lld -r")
        expect(runner).to_contain("Rust-built")
        expect(runner).to_contain("SIMPLE_ADMITTED_COMPILER_SHA256")
