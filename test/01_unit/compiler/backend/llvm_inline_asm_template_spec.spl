# @cover src/compiler/70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl

use std.spec.*
use compiler.backend.backend._MirToLlvm.aggregate_intrinsics.{
    llvm_inline_asm_rewrite_template
}

describe "LLVM inline assembly template lowering":
    it "maps ARM64 syscall names with outputs before inputs":
        val lowered = llvm_inline_asm_rewrite_template(
            r"mov x8, {id}; mov x0, {arg0}; mov {out}, x0",
            ["out"],
            ["id", "arg0"]
        )

        expect(lowered).to_equal("mov x8, $1; mov x0, $2; mov $0, x0")
        expect(lowered).to_not_contain(r"{id}")
        expect(lowered).to_not_contain(r"{out}")

    it "maps numbered input-only operands in constraint order":
        val lowered = llvm_inline_asm_rewrite_template(
            r"add {0}, {1}; add {0}, {1}",
            [],
            ["lhs", "rhs"]
        )

        expect(lowered).to_equal("add $0, $1; add $0, $1")

    it "transports named RV64 immediate operands after outputs and register inputs":
        # RV64 `addi` is the minimal reproducer for the former operand-transport
        # failure: `{shift}` is an `in(imm)` constraint, not text spliced into
        # the template. LLVM numbers the output first, then both inputs.
        val lowered = llvm_inline_asm_rewrite_template(
            r"addi {dst}, {src}, {shift}",
            ["dst"],
            ["src", "shift"]
        )

        expect(lowered).to_equal("addi $0, $1, $2")
        expect(lowered).to_not_contain(r"{shift}")
