use std.spec.*
use compiler.mir.mir_types.{MirType, MirTypeKind}
use compiler.backend.common.c_abi_type_mapping.{c_abi_map_type, c_backend_map_type}

describe "shared C ABI type mapping":
    it "spells primitive and pointer types for C headers":
        expect(c_abi_map_type(MirType.i64())).to_equal("int64_t")
        expect(c_abi_map_type(MirType.bool())).to_equal("int64_t")
        expect(c_abi_map_type(MirType.unit())).to_equal("void")
        expect(c_abi_map_type(MirType.ptr(MirType.i64(), false))).to_equal("void*")

    it "uses a concrete integer width for bounded bit types":
        expect(c_abi_map_type(MirType.bits(16))).to_equal("uint16_t")

    it "keeps the C++ runtime aggregate spelling used by the backend":
        val array_ty = MirType(kind: MirTypeKind.Array(MirType.i64(), 4))
        expect(c_backend_map_type(array_ty)).to_equal("spl::Array<int64_t>")
