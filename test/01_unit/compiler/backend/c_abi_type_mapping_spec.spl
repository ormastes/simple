use compiler.backend.common.c_abi_type_mapping.{c_abi_map_type}
use compiler.mir.mir_types.{MirType, MirTypeKind}
use compiler.hir.hir_types.{SymbolId}

describe "Shared C ABI type mapping":
    it "preserves primitive and runtime bool representations":
        expect(c_abi_map_type(MirType.i64())).to_equal("int64_t")
        expect(c_abi_map_type(MirType.f64())).to_equal("double")
        expect(c_abi_map_type(MirType.bool())).to_equal("int64_t")
        expect(c_abi_map_type(MirType.unit())).to_equal("void")

    it "preserves named struct and enum representations":
        val symbol = SymbolId(id: 71)
        val names: Dict<i64, text> = {71: "Widget"}
        expect(c_abi_map_type(MirType(kind: MirTypeKind.Struct(symbol)), names)).to_equal("Widget*")
        expect(c_abi_map_type(MirType(kind: MirTypeKind.Enum(symbol)), names)).to_equal("Widget")

    it "keeps opaque fallbacks and integer width policy":
        expect(c_abi_map_type(MirType(kind: MirTypeKind.Struct(SymbolId(id: 72))))).to_equal("void*")
        expect(c_abi_map_type(MirType.bits(17))).to_equal("uint32_t")
        expect(c_abi_map_type(MirType.sbits(9))).to_equal("int16_t")
