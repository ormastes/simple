# @req REQ-MIR-CALL-ORIGIN
# Executes the production translators; source-text scans are not an oracle.
use std.spec.{describe, it, expect}
use std.spec.step
use plugins.backend_c.c_backend_translate.{MirToC}
use plugins.backend_wasm.wasm_backend.{WatBuilder}
use plugins.backend_wasm.wasm.wat_codegen.{MirToWat}
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_instruction_graph.{MirFunction, MirModule, MirBlock, MirInst}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, MirCallOrigin, MirTerminator, BlockId}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirSignature, MirConstValue}

fn p1_baremetal_codegen_callee(name: text, origin: MirCallOrigin) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name), MirType.i64()), call_origin: origin)

fn p1_baremetal_codegen_setup() -> MirModule:
    val function = MirFunction(
        symbol: SymbolId(id: 1), name: "rt_array_new",
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: [MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [],
            terminator: MirTerminator.Ret(None))],
        entry_block: BlockId.entry(), span: Span.empty(),
        generic_params: [], is_generic_template: false, specialization_of: None,
        type_bindings: {}, layout_phase: None, is_kernel: false,
        gpu_target: "", gpu_backend_order: "", is_export_c: false, export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.NativeLib,
            driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0,
        verification_contract: None, nogc_strict: false)
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(name: "call_origin", functions: functions, statics: {}, constants: {}, types: {})

describe "C and Wasm callable authority":
    it "keeps a source function named like the runtime distinct in C":
        step("Translate a module with a genuine user rt_array_new definition")
        var translator = MirToC.create("call_origin")
        val source = translator.translate_module(p1_baremetal_codegen_setup())
        expect(source).to_contain("__simple_local_rt_array_new(void)")
        step("Resolve the same spelling under each proven call origin")
        expect(translator.translate_call_target(p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Source))).to_equal("__simple_local_rt_array_new")
        expect(translator.translate_call_target(p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Runtime))).to_equal("rt_array_new")
        expect(translator.translate_call_target(p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Foreign))).to_equal("rt_array_new")

    it "emits C calls as symbols while keeping text operands as data":
        step("Translate a runtime call through the real Call instruction owner")
        var translator = MirToC.create("call_origin")
        val callee = p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Runtime)
        translator.translate_instruction(MirInst(kind: MirInstKind.Call(None, callee, []), span: None))
        expect(translator.builder.build()).to_contain("rt_array_new();")
        step("Translate the identical string operand in a data position")
        expect(translator.translate_operand(callee)).to_start_with("(const char*)")

    it "does not intercept source or foreign C container-like function names":
        step("Emit genuine foreign and source calls whose spelling resembles a container helper")
        for origin in [MirCallOrigin.Source, MirCallOrigin.Foreign]:
            var translator = MirToC.create("call_origin")
            val callee = p1_baremetal_codegen_callee("spl_array_new", origin)
            translator.translate_instruction(MirInst(kind: MirInstKind.Call(None, callee, []), span: None))
            expect(translator.builder.build()).to_contain("spl_array_new();")

    it "keeps Wasm source definitions and calls separate from runtime imports":
        step("Translate a user definition that collides with an existing runtime import")
        var translator = MirToWat.create("call_origin")
        val module_text = translator.translate_module(p1_baremetal_codegen_setup())
        expect(module_text).to_contain("(func $__simple_local_rt_array_new")
        expect(module_text).to_contain("(import \"simple\" \"rt_array_new\"")
        step("Emit source, runtime and foreign calls through the real WAT call owner")
        var source_builder = WatBuilder.create()
        translator.translate_call(source_builder, None,
            p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Source), [])
        expect(source_builder.build()).to_contain("call $__simple_local_rt_array_new")
        for origin in [MirCallOrigin.Runtime, MirCallOrigin.Foreign]:
            var external_builder = WatBuilder.create()
            translator.translate_call(external_builder, None,
                p1_baremetal_codegen_callee("rt_array_new", origin), [])
            expect(external_builder.build()).to_contain("call $rt_array_new")
            expect(external_builder.build().contains("call $__simple_local_rt_array_new")).to_equal(false)

    it "preserves source ownership when the defining module is another object":
        step("Resolve an imported source callable without its body in this module")
        var c = MirToC.create("empty")
        expect(c.translate_call_target(p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Source))).to_equal("__simple_local_rt_array_new")
        var wasm = MirToWat.create("empty")
        var builder = WatBuilder.create()
        wasm.translate_call(builder, None,
            p1_baremetal_codegen_callee("rt_array_new", MirCallOrigin.Source), [])
        expect(builder.build()).to_contain("call $__simple_local_rt_array_new")
