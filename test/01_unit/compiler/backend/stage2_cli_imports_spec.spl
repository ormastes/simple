use std.spec.*
use app.t32_cli.mod.{t32_cli_main}
use compiler.backend.common.c_abi_type_mapping.{c_abi_map_type}
use compiler.mir.mir_types.{MirType}
use compiler.backend.backend.backend_types.{CodegenTarget, compileoptions_default_options}
use compiler.backend.wasm_codegen_adapter.{WasmCodegenAdapter}
use plugins.backend_registry.full_static_backend_ports.{wasm_backend_port_v1}
use std.common.structural.parallel_commit.executable_mapping_receipt.{ExecutableMappingProducerKindV1, executable_mapping_receipt_v1, executable_mapping_receipt_v1_well_formed}

describe "Stage2 CLI import providers":
    it "maps integer and unit MIR types to C ABI types":
        expect(c_abi_map_type(MirType.i64())).to_equal("int64_t")
        expect(c_abi_map_type(MirType.unit())).to_equal("void")

    it "loads the real WebAssembly adapter and accepts wasm32":
        val adapter = WasmCodegenAdapter(options: compileoptions_default_options())
        expect(adapter.supports_target(CodegenTarget.Wasm32)).to_equal(true)
        expect(wasm_backend_port_v1().describe_fn().name).to_equal("wasm")

    it "loads the TRACE32 CLI entry and renders usage":
        expect(t32_cli_main([])).to_equal(0)

    it "loads the executable mapping receipt provider":
        val receipt = executable_mapping_receipt_v1(
            ExecutableMappingProducerKindV1.SegmentMapper,
            "mapper-1", "owner-1", "mapping-1", 1, 4096, 1)
        expect(executable_mapping_receipt_v1_well_formed(receipt)).to_equal(true)
