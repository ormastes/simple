# Module-level `var` list mutated through an imported function must stay a list
# (interpreter regression: `invalid operands for +` on the second register).
use std.spec.*
use std.spec.step
use .fixtures.modvar_reg.{modvar_reset, modvar_register, modvar_count}

describe "module-level var list registry":
    it "should admit once and refuse a duplicate after a reset":
        step("Reset then register twice")
        modvar_reset()
        expect(modvar_register("a")).to_equal(true)
        expect(modvar_register("a")).to_equal(false)
        expect(modvar_register("b")).to_equal(true)
        expect(modvar_count()).to_equal(2)

describe "text ordering operators":
    it "should order text with >, >= and <=":
        val a = "abc"
        val b = "abd"
        expect(b > a).to_equal(true)
        expect(b >= a).to_equal(true)
        expect(a >= a).to_equal(true)
        expect(a <= b).to_equal(true)
        expect(a >= b).to_equal(false)

describe "text conversion and search methods":
    it "should parse digits with to_int and locate a separator with find":
        val line = "key: 42"
        val idx = line.find(":")
        expect(idx).to_equal(3)
        expect(line[idx + 1:].trim().to_int()).to_equal(42)
        expect(line[0:idx]).to_equal("key")
