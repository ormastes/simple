use std.spec.{describe, it, expect}
use app.io.dir_ops.{dir_create_all}
use app.io.file_ops.{file_delete, file_exists, file_read, file_write}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use compiler.backend.linker.linker_wrapper_helpers.{write_elf_bytes_to_file}

describe "native object publication":
    it "rejects truncated headers without replacing an existing object":
        val path = "build/native-object-publication-{getpid()}.o"
        val truncated: [u8] = [0x7f, 0x45, 0x4c]
        expect(dir_create_all("build")).to_equal(true)
        val missing = write_elf_bytes_to_file(path, truncated)
        expect(missing.is_err()).to_equal(true)
        expect(file_exists(path)).to_equal(false)
        expect(file_write(path, "existing object")).to_equal(true)
        val existing = write_elf_bytes_to_file(path, truncated)
        expect(existing.is_err()).to_equal(true)
        expect(file_read(path)).to_equal("existing object")
        expect(file_delete(path)).to_equal(true)
