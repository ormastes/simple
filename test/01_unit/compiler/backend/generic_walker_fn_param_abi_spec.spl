"""
Purpose: ABI receipt for the fn-type annotation fix (visitor_fn_param_ctx_
inference_spec.spl). A `fn(..) -> R` parameter used to reach MIR as `Any`
(an i64 slot); it now lowers to `HirTypeKind.Function` ->
`MirTypeKind.FuncPtr(MirSignature)` -> LLVM `ptr` (function_lowering.spl
Function arm, core_codegen.spl FuncPtr arms; cranelift maps FuncPtr to
CL_TYPE_PTR in codegen.spl / cranelift_codegen_adapter.spl). This spec drives
parse -> HIR -> monomorphization -> MIR -> LLVM IR text on a program that
passes a named function to a generic walker and calls through it, and pins
the receipt on both the MIR type and the emitted IR.
Audience: compiler engineers maintaining the native call ABI of fn-typed
parameters.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mono.monomorphize_integration.{run_monomorphization_with_diagnostics}
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}

val WALKER_SRC = "fn walk<C>(n: i64, ctx: C, f: fn(i64, C) -> C) -> C:\n    var acc = f(n, ctx)\n    if n > 0:\n        acc = walk(n - 1, acc, f)\n    acc\n\nfn add(n: i64, c: i64) -> i64:\n    c + n\n\nfn main() -> i64:\n    walk<i64>(3, 0, add)\n"

fn find_mir_function_with_arity(mir: MirModule, arity: i64) -> MirFunction?:
    # Located by shape, not name: MIR names a specialization through the
    # module symbol table, and the mono pass's fresh symbol id can alias an
    # unrelated symbol there (the walker currently surfaces as `<mod>.C`).
    # That naming defect is independent of the fn-type ABI pinned here.
    for function in mir.functions.values():
        if function.signature.params.len() == arity:
            return Some(function)
    nil

fn param_kind_names(function: MirFunction) -> [text]:
    var out: [text] = []
    for pt in function.signature.params:
        out = out.push(match pt.kind:
            case MirTypeKind.I64: "i64"
            case MirTypeKind.FuncPtr(sig): "funcptr/{sig.params.len()}"
            case _: "other")
    out

describe "generic walker with a fn-typed parameter: native ABI receipt":
    it "specializes the walker and types its callback as a function pointer in MIR":
        val parsed = parse_full_frontend(WALKER_SRC, "walker_abi.spl", "walker_abi", Logger(level: 0))
        var hl = HirLowering.with_filename("walker_abi.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        var mods: Dict<text, HirModule> = {}
        mods["walker_abi"] = hir
        val (out, stats, diags) = run_monomorphization_with_diagnostics(mods)
        expect(diags.len()).to_equal(0)
        expect(stats.unresolved_generic_calls).to_equal(0)
        expect(stats.specializations_created).to_equal(1)
        val mono: HirModule = out["walker_abi"]
        var mir_lowering = MirLowering.new(mono.symbols)
        val mir = mir_lowering.lower_module(mono)
        expect(mir_lowering.errors.len()).to_equal(0)
        val walker = find_mir_function_with_arity(mir, 3)
        expect(walker.is_some()).to_equal(true)
        val kinds = param_kind_names(walker.unwrap())
        expect(kinds.len()).to_equal(3)
        expect(kinds[0]).to_equal("i64")
        expect(kinds[1]).to_equal("i64")
        expect(kinds[2]).to_equal("funcptr/2")

    it "emits the callback as an LLVM `ptr` parameter and calls through it, passing `add` by reference":
        val parsed = parse_full_frontend(WALKER_SRC, "walker_abi.spl", "walker_abi", Logger(level: 0))
        var hl = HirLowering.with_filename("walker_abi.spl")
        val hir = hl.lower_module(parsed)
        var mods: Dict<text, HirModule> = {}
        mods["walker_abi"] = hir
        val (out, _stats, diags) = run_monomorphization_with_diagnostics(mods)
        expect(diags.len()).to_equal(0)
        val mono: HirModule = out["walker_abi"]
        var mir_lowering = MirLowering.new(mono.symbols)
        val mir = mir_lowering.lower_module(mono)
        expect(mir_lowering.errors.len()).to_equal(0)
        val llvm = MirToLlvm.create("walker_abi", CodegenTarget.X86_64, nil).translate_module(mir)
        print "[walker-abi] llvm bytes={llvm.len()}"
        # the specialization takes its callback as a pointer parameter
        expect(llvm.contains("i64 %l2, ptr %l3)")).to_be(true)
        expect(llvm.contains("define i64 @__simple_main")).to_be(true)
        # the caller hands over the named function by reference, never as text
        expect(llvm.contains("ptr @walker_abi.add)")).to_be(true)
        expect(llvm.contains("c\"add\\00\"")).to_be(false)
        # the body calls through the parameter (closure/raw-fn diamond)
        expect(llvm.contains("call i64 @rt_closure_func_ptr(i64")).to_be(true)
        expect(llvm.contains("call i64 %l3(i64 %l1, i64 %l2)")).to_be(true)
        expect(llvm.contains("undefined symbol")).to_be(false)

    it "keeps the same pointer-width callback slot on riscv32 (Simple-to-Simple only)":
        # Covers only calls between Simple functions. An `extern fn` whose C/Rust
        # side takes the callback as a 64-bit integer (native_spawn_worker:
        # `u64`) is NOT covered and is a known 32-bit gap, tracked in
        # doc/08_tracking/bug/funcptr_param_32bit_extern_abi_unproven_2026-10-10.md.
        val parsed = parse_full_frontend(WALKER_SRC, "walker_abi.spl", "walker_abi", Logger(level: 0))
        var hl = HirLowering.with_filename("walker_abi.spl")
        val hir = hl.lower_module(parsed)
        var mods: Dict<text, HirModule> = {}
        mods["walker_abi"] = hir
        val (out, _stats, diags) = run_monomorphization_with_diagnostics(mods)
        expect(diags.len()).to_equal(0)
        val mono: HirModule = out["walker_abi"]
        var mir_lowering = MirLowering.new(mono.symbols)
        val mir = mir_lowering.lower_module(mono)
        expect(mir_lowering.errors.len()).to_equal(0)
        val llvm = MirToLlvm.create("walker_abi", CodegenTarget.Riscv32, nil).translate_module(mir)
        expect(llvm.contains("riscv32")).to_be(true)
        expect(llvm.contains("-p:32:32")).to_be(true)
        expect(llvm.contains("i64 %l2, ptr %l3)")).to_be(true)
        expect(llvm.contains("ptr @walker_abi.add)")).to_be(true)
        expect(llvm.contains("call i64 %l3(i64 %l1, i64 %l2)")).to_be(true)
