# @cover src/compiler/70.backend/backend/common/type_mapper.spl
# @cover src/compiler/70.backend/backend/interpreter_type_mapper.spl
# @cover src/compiler/70.backend/backend/wasm_type_mapper.spl
# @cover src/compiler/70.backend/backend/cranelift_type_mapper.spl

extern fn rt_file_read_text(path: text) -> text

use std.spec.*

fn mapper_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "ExceptionToken auxiliary mapper rejection":
    it "rejects shared size and alignment fallback":
        val source = mapper_source(
            "src/compiler/70.backend/backend/common/type_mapper.spl")
        expect(source).to_contain("cannot map ExceptionToken")
        expect(source).to_contain("cannot size ExceptionToken")
        expect(source).to_contain("cannot align ExceptionToken")
        expect(source).to_contain("E-MIR-UNWIND002")

    it "rejects interpreter naming classification and layout":
        val source = mapper_source(
            "src/compiler/70.backend/backend/interpreter_type_mapper.spl")
        expect(source).to_contain("Interpreter cannot name ExceptionToken")
        expect(source).to_contain("Interpreter cannot classify ExceptionToken")
        expect(source).to_contain("Interpreter cannot size ExceptionToken")
        expect(source).to_contain("Interpreter cannot align ExceptionToken")

    it "rejects WebAssembly stack and memory classification":
        val source = mapper_source(
            "src/compiler/70.backend/backend/wasm_type_mapper.spl")
        expect(source).to_contain("WebAssembly cannot map ExceptionToken")
        expect(source).to_contain("WebAssembly cannot classify ExceptionToken")
        expect(source).to_contain("WebAssembly cannot size ExceptionToken")
        expect(source).to_contain("WebAssembly cannot align ExceptionToken")

    it "rejects Cranelift mapping classification and layout":
        val source = mapper_source(
            "src/compiler/70.backend/backend/cranelift_type_mapper.spl")
        expect(source).to_contain("Cranelift cannot map ExceptionToken")
        expect(source).to_contain("Cranelift cannot classify ExceptionToken")
        expect(source).to_contain("Cranelift cannot size ExceptionToken")
        expect(source).to_contain("Cranelift cannot align ExceptionToken")
