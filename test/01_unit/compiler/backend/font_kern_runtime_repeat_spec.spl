# BUG-FONT-KERN-LITERAL-REPEAT-2026-10-11
# Runner wrapper is unexecuted; native fixture is separately admitted.
use std.spec.{describe, it, expect}

var _check_failures: i32 = 0
var _check_count: i32 = 0
fn check(condition: bool):
    _check_count = _check_count + 1
    if not condition:
        # Saturated failure flag cannot wrap after repeated failed checks.
        _check_failures = 1
var _evaluations: i32 = 0
fn next_empty() -> i32:
    _evaluations = _evaluations + 1
    2147483647
fn dynamic_count(count: i32) -> i32:
    count
val _KERN_EMPTY: i32 = 2147483647
val _KERN_SQUARE: i32 = 9025
val _ADV_ASCII_SLOTS: i32 = 8
fn _kern_ascii_entry_count() -> i32:
    _ADV_ASCII_SLOTS * _KERN_SQUARE
var _kern_ascii_vals: [i32] = [_KERN_EMPTY; _kern_ascii_entry_count()]
fn _font_kern_runtime_repeat_check() -> i32:
    check(_kern_ascii_vals.len() == 72200)
    if _kern_ascii_vals.len() != 72200:
        return 1
    var i: i32 = 0
    while i < 72200:
        check(_kern_ascii_vals[i] == _KERN_EMPTY)
        i = i + 1
    _kern_ascii_vals[0] = -7
    _kern_ascii_vals[9025] = 0
    _kern_ascii_vals[72199] = 11
    check(_kern_ascii_vals[0] == -7)
    check(_kern_ascii_vals[1] == _KERN_EMPTY)
    check(_kern_ascii_vals[9025] == 0)
    check(_kern_ascii_vals[9026] == _KERN_EMPTY)
    check(_kern_ascii_vals[72198] == _KERN_EMPTY)
    check(_kern_ascii_vals[72199] == 11)
    _evaluations = 0
    val empty: [i32] = [next_empty(); dynamic_count(0)]
    check(empty.len() == 0)
    if empty.len() != 0:
        return 1
    # Zero-count value evaluation is recorded separately; compare producer behavior.
    val zero_evaluations = _evaluations
    _evaluations = 0
    val single: [i32] = [next_empty(); dynamic_count(1)]
    check(single.len() == 1)
    if single.len() != 1:
        return 1
    check(single[0] == 2147483647)
    check(_evaluations == 1)
    _evaluations = 0
    val repeated: [i32] = [next_empty(); dynamic_count(3)]
    check(repeated.len() == 3)
    if repeated.len() != 3:
        return 1
    check(_evaluations == 1)
    check(repeated[0] == 2147483647)
    check(repeated[1] == 2147483647)
    check(repeated[2] == 2147483647)
    var nested: [[i32]] = [[9; 2]; dynamic_count(2)]
    if nested.len() != 2:
        return 1
    if nested[0].len() != 2 or nested[1].len() != 2:
        return 1
    var first = nested[0]
    first[0] = 17
    nested[0] = first
    check(nested[0][0] == 17)
    check(nested[0][1] == 9)
    check(nested[1][0] == 9)
    check(nested[1][1] == 9)
    if _check_failures != 0:
        return 1
    if _check_count != 72220:
        return 2
    print "zero_evaluations={zero_evaluations}"
    print "check_count={_check_count}"
    print "semantic_checks_complete=72200;counts=0,1,3;nested=independent"
    0

describe "font kern runtime-count repeat regression":
    it "preserves 72200 defaults, evaluation and independent mutable cells":
        expect(_font_kern_runtime_repeat_check()).to_equal(0)
