use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "VHDL metadata index":
    it "builds collision-framed exact and eligible-alias indexes once":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain("fn vhdl_catalog_metadata_key(")
        expect(source).to_contain("{module_name.len()}:{module_name}{function_name.len()}:{function_name}")
        expect(source).to_contain("var metadata_exact_rows: Dict<text, i64> = {}")
        expect(source).to_contain("var metadata_alias_rows: Dict<text, i64> = {}")
        expect(source).to_contain("if not rt_dict_contains(modules, metadata_row.module_name):")
        expect(source).to_contain("rows[key] = -2")

    it "joins functions through two lookups without rescanning rows":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain("metadata_exact_rows[metadata_exact_key]")
        expect(source).to_contain("metadata_alias_rows[metadata_alias_key]")
        expect(source).to_contain("metadata_exact_index == -2")
        expect(source).to_contain("metadata_alias_index == -2")
        expect(source).not.to_contain("while metadata_index < hardware_metadata_rows.len()")
        expect(source).not.to_contain("metadata_match_rank")
