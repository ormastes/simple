use std.spec.*
use compiler.backend.backend.backend_types.{BackendKind}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.backend.backend.static_backend_registry.{
    BackendLinkClass, StaticBackendEntryV1, static_backend_entry_v1,
    validate_k1_static_backend_table_v1}
use compiler.backend.backend.static_backend_cranelift_port.{cranelift_backend_port_v1}
use compiler.backend.backend.static_backend_interpreter_port.{interpreter_backend_port_v1}
use compiler.backend.backend.static_backend_llvm_port.{llvm_backend_port_v1}

fn cranelift_entry_v1() -> StaticBackendEntryV1:
    static_backend_entry_v1(BackendKind.Cranelift, BackendLinkClass.KernelLinked,
        cranelift_backend_port_v1(), CodegenOutputKind.ObjectCode)

fn llvm_entry_v1() -> StaticBackendEntryV1:
    static_backend_entry_v1(BackendKind.Llvm, BackendLinkClass.KernelLinked,
        llvm_backend_port_v1(), CodegenOutputKind.ObjectCode)

fn interpreter_entry_v1() -> StaticBackendEntryV1:
    static_backend_entry_v1(BackendKind.Interpreter,
        BackendLinkClass.KernelLinked, interpreter_backend_port_v1(),
        CodegenOutputKind.InterpretedResult)

describe "parameterized kernel K1 backend policy":
    it "admits LLVM and Cranelift only for the combined composition":
        expect(validate_k1_static_backend_table_v1("llvm-cranelift",
            [cranelift_entry_v1(), interpreter_entry_v1(),
                llvm_entry_v1()])).to_equal(true)

    it "rejects the unselected Cranelift-only policy":
        expect(validate_k1_static_backend_table_v1("cranelift-only",
            [cranelift_entry_v1(), interpreter_entry_v1()])).to_equal(false)

    it "fails closed for an unknown policy rather than choosing a default":
        expect(validate_k1_static_backend_table_v1("unknown",
            [cranelift_entry_v1(), interpreter_entry_v1(),
                llvm_entry_v1()])).to_equal(false)
