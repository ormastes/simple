# @tag: unit, compiler, driver, cli, vulkan, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "canonical Vulkan compiler producer endpoint":
    it "routes the existing compile driver to Vulkan assembly output":
        val cli = rt_file_read_text("src/app/io/_CliCompile/compile_opt_and_driver.spl") ?? ""
        val pipeline = rt_file_read_text("src/compiler/80.driver/driver_aot_pipeline.spl") ?? ""
        val output = rt_file_read_text("src/compiler/80.driver/driver_aot_codegen_outputs.spl") ?? ""
        val helpers = rt_file_read_text("src/compiler/70.backend/backend/backend_helpers.spl") ?? ""

        expect(cli).to_contain("--emit-vulkan-spirv-assembly")
        expect(cli).to_contain("cli_compile_pure_simple(source_file, vulkan_output, \"vulkan\", \"vulkan\"")
        expect(cli).to_contain("requires --backend=vulkan")
        expect(pipeline).to_contain("return self.compile_to_vulkan(output)")
        expect(output).to_contain("me compile_to_vulkan(output: text)")
        expect(output).to_contain("OpEntryPoint GLCompute")
        expect(output).to_contain("rt_file_write_text(output, all_spirv)")
        expect(output).to_contain("Vulkan backend produced no compute entry point")
        expect(helpers).to_contain("kind = BackendKind.Vulkan")

    it "passes the requested source to the live-lane producer":
        val bridge = rt_file_read_text("scripts/check/check-vulkan-compiler-live-lane.shs") ?? ""
        expect(bridge).to_contain("SIMPLE_VULKAN_SPIRV_SOURCE")
        expect(bridge).to_contain("compile --backend=vulkan --emit-vulkan-spirv-assembly")
        expect(bridge).to_contain("$" + "PRODUCER_SOURCE")
        expect(bridge).to_contain("compiler-producer-source-unset")
