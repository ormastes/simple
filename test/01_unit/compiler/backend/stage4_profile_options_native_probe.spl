use compiler.backend.backend.stage4_link_profile_options.{stage4_link_profile_options_v1}

fn main() -> i64:
    val plain = stage4_link_profile_options_v1(false, true, false, 3, false)
    val stripped = stage4_link_profile_options_v1(false, true, false, 3, true)
    if plain == stripped: return 1
    if not plain.contains("strip_output=false"): return 2
    if not stripped.contains("strip_output=true"): return 3
    0
