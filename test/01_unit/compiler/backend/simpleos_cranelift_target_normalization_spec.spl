use std.spec.*
use compiler.backend.aot_target_normalization.{
    backend_aot_simpleos_target_triple,
    backend_normalize_requested_aot_target
}

describe "SimpleOS Cranelift target normalization":
    it "maps every release architecture to its freestanding object target":
        expect(backend_normalize_requested_aot_target(
            "x86_64-unknown-simpleos")).to_equal("x86_64-unknown-none-elf")
        expect(backend_normalize_requested_aot_target(
            "aarch64-unknown-simpleos")).to_equal("aarch64-unknown-none-elf")
        expect(backend_normalize_requested_aot_target(
            "riscv64-unknown-simpleos")).to_equal("riscv64gc-unknown-none-elf")

    it "accepts exact aliases and rejects malformed spellings":
        expect(backend_normalize_requested_aot_target(
            " SIMPLEOS ")).to_equal("x86_64-unknown-none-elf")
        expect(backend_normalize_requested_aot_target(
            "AARCH64-SIMPLEOS")).to_equal("aarch64-unknown-none-elf")
        expect(backend_normalize_requested_aot_target(
            "riscv64gc-unknown-simpleos-elf")).to_equal("riscv64gc-unknown-none-elf")
        expect(backend_aot_simpleos_target_triple(
            "simpleos-x86_64junk")).to_equal("")
        expect(backend_aot_simpleos_target_triple(
            "armv7-unknown-simpleos")).to_equal("")

    it "preserves hosted targets and normalized targets":
        expect(backend_normalize_requested_aot_target(
            "x86_64-unknown-linux-gnu")).to_equal("x86_64-unknown-linux-gnu")
        expect(backend_normalize_requested_aot_target("host")).to_equal("")
        expect(backend_normalize_requested_aot_target("native")).to_equal("")
        expect(backend_normalize_requested_aot_target(
            "riscv64gc-unknown-none-elf")).to_equal("riscv64gc-unknown-none-elf")
