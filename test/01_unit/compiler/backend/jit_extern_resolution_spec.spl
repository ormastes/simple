# Pure-Simple Cranelift JIT: how a call target is bound, and what happens
# when it cannot be.
#
# The JIT lane compiles MIR through the same lowering the AOT lane uses
# (cranelift_codegen_adapter) into a host JIT module. A callee is one of:
#   - Source, defined in the module       -> local call
#   - Foreign                             -> import bound by the provider
#   - Runtime (`rt_*`)                    -> REFUSED, named, before codegen
#   - Source, not defined in the module   -> REFUSED, named, before codegen
# Runtime externs are refused because the provider behind rt_cranelift_new_module
# registers no runtime symbols: an `rt_*` import aborts the host at finalize
# (doc/08_tracking/bug/pure_simple_jit_provider_registers_no_runtime_symbols_2026-11-13.md).
# A refusal is an error value naming the symbol. It is never a nil result, a
# call through address 0, or an interpreter demotion.
use std.spec.*
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.jit_extern_resolution.{JitCalleeResolution, jit_classify_callee, jit_callee_refusal, jit_module_extern_errors}
use compiler.backend.cranelift_codegen_adapter.{cranelift_jit_run_main}

fn jit_fn(id: i64, name: text, insts: [MirInst], ret: MirOperand) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: id), name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: insts, terminator: MirTerminator.Ret(Some(ret)))],
        entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

fn int_op(value: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), MirType.i64()))

fn local0() -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0)))

fn call0(callee: MirOperand, args: [MirOperand]) -> MirInst:
    MirInst(kind: MirInstKind.Call(Some(LocalId(id: 0)), callee, args), span: nil)

fn source_callee(name: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name), MirType.i64()), call_origin: MirCallOrigin.Source)

fn main_module(insts: [MirInst], ret: MirOperand) -> MirModule:
    MirModule(name: "jit_extern_probe", functions: {SymbolId(id: 1): jit_fn(1, "main", insts, ret)},
        statics: {}, constants: {}, types: {})

fn runtime_call_module(name: text, args: [MirOperand]) -> MirModule:
    main_module([call0(mir_operand_runtime_function(name, MirType.i64()), args)], local0())

fn run_error(module: MirModule) -> text:
    match cranelift_jit_run_main(module):
        case Ok(value): "unexpected-ok:{value}"
        case Err(message): message

fn run_value(module: MirModule) -> i64:
    match cranelift_jit_run_main(module):
        case Ok(value): value
        case Err(message):
            print "jit error: {message}"
            -999999

describe "pure-Simple JIT callee classification":

    it "binds a Source callee defined in the module locally":
        val resolution = jit_classify_callee(MirCallOrigin.Source, "helper", {"helper": true})
        expect(resolution == JitCalleeResolution.Local).to_equal(true)
        expect(jit_callee_refusal(resolution, "helper", "main")).to_equal("")

    it "binds a Foreign callee as a provider import":
        val resolution = jit_classify_callee(MirCallOrigin.Foreign, "labs", {})
        expect(resolution == JitCalleeResolution.ForeignImport).to_equal(true)
        expect(jit_callee_refusal(resolution, "labs", "main")).to_equal("")

    it "refuses every Runtime callee by name, whatever its family":
        for name in ["rt_file_exists", "rt_file_read_text", "rt_process_run", "rt_getpid", "rt_time_now_unix_micros", "rt_string_len"]:
            val resolution = jit_classify_callee(MirCallOrigin.Runtime, name, {})
            expect(resolution == JitCalleeResolution.RuntimeUnbound).to_equal(true)
            val refusal = jit_callee_refusal(resolution, name, "main")
            expect(refusal).to_contain("E-JIT-RUNTIME-EXTERN-UNBOUND")
            expect(refusal).to_contain(name)

    it "does not let a same-named local definition capture a Runtime callee":
        val resolution = jit_classify_callee(MirCallOrigin.Runtime, "rt_getpid", {"rt_getpid": true})
        expect(resolution == JitCalleeResolution.RuntimeUnbound).to_equal(true)

    it "refuses a Source callee the module does not define":
        val resolution = jit_classify_callee(MirCallOrigin.Source, "no_such_fn", {"main": true})
        expect(resolution == JitCalleeResolution.UnresolvedSource).to_equal(true)
        val refusal = jit_callee_refusal(resolution, "no_such_fn", "main")
        expect(refusal).to_contain("E-JIT-UNRESOLVED-CALLEE")
        expect(refusal).to_contain("no_such_fn")

    it "refuses a callee whose origin was never proven":
        val resolution = jit_classify_callee(MirCallOrigin.Unknown, "mystery", {})
        expect(resolution == JitCalleeResolution.UnknownOrigin).to_equal(true)
        expect(jit_callee_refusal(resolution, "mystery", "main")).to_contain("E-JIT-UNKNOWN-CALL-ORIGIN")

    it "reports each refused callee of a module once":
        val module = main_module([
            call0(mir_operand_runtime_function("rt_getpid", MirType.i64()), []),
            call0(mir_operand_runtime_function("rt_getpid", MirType.i64()), []),
            call0(mir_operand_foreign_function("labs", MirType.i64()), [int_op(-5)]),
            call0(source_callee("no_such_fn"), [])
        ], local0())
        val errors = jit_module_extern_errors(module)
        expect(errors.len()).to_equal(2)
        expect(errors[0]).to_contain("rt_getpid")
        expect(errors[1]).to_contain("no_such_fn")

describe "pure-Simple JIT executes natively through the provider":

    it "runs a module with no calls":
        expect(run_value(main_module([], int_op(42)))).to_equal(42)

    it "calls a function defined in the same module":
        val module = MirModule(name: "jit_local_call",
            functions: {
                SymbolId(id: 1): jit_fn(1, "main", [call0(source_callee("seven"), [])], local0()),
                SymbolId(id: 2): jit_fn(2, "seven", [], int_op(7))
            },
            statics: {}, constants: {}, types: {})
        expect(run_value(module)).to_equal(7)

    it "links a Foreign extern natively and passes its argument":
        val module = main_module([call0(mir_operand_foreign_function("labs", MirType.i64()), [int_op(-5)])], local0())
        expect(run_value(module)).to_equal(5)

    it "gives the same value the interpreter computes":
        val jit_const = run_value(main_module([], int_op(6 * 7)))
        expect(jit_const).to_equal(6 * 7)
        val magnitude: i64 = -1234
        val jit_abs = run_value(main_module(
            [call0(mir_operand_foreign_function("labs", MirType.i64()), [int_op(magnitude)])], local0()))
        expect(jit_abs).to_equal(magnitude.abs())

describe "pure-Simple JIT fails closed on a callee it cannot bind":

    it "returns a named error for file, process, time and text runtime externs":
        expect(run_error(runtime_call_module("rt_file_exists", [int_op(0), int_op(0)]))).to_contain("E-JIT-RUNTIME-EXTERN-UNBOUND: rt_file_exists")
        expect(run_error(runtime_call_module("rt_process_run", [int_op(0), int_op(0), int_op(0)]))).to_contain("E-JIT-RUNTIME-EXTERN-UNBOUND: rt_process_run")
        expect(run_error(runtime_call_module("rt_time_now_unix_micros", []))).to_contain("E-JIT-RUNTIME-EXTERN-UNBOUND: rt_time_now_unix_micros")
        expect(run_error(runtime_call_module("rt_string_len", [int_op(0)]))).to_contain("E-JIT-RUNTIME-EXTERN-UNBOUND: rt_string_len")

    it "returns a named error for a callee defined nowhere":
        val message = run_error(main_module([call0(source_callee("no_such_fn"), [])], local0()))
        expect(message).to_contain("E-JIT-UNRESOLVED-CALLEE: no_such_fn")

    it "returns an error, not a value, when the module has no main":
        val module = MirModule(name: "jit_no_main", functions: {SymbolId(id: 2): jit_fn(2, "seven", [], int_op(7))},
            statics: {}, constants: {}, types: {})
        expect(run_error(module)).to_contain("E-JIT-ENTRY")

    it "keeps the host alive after a refusal":
        val refused = run_error(runtime_call_module("rt_getpid", []))
        expect(refused).to_contain("E-JIT-RUNTIME-EXTERN-UNBOUND")
        expect(run_value(main_module([], int_op(3)))).to_equal(3)
