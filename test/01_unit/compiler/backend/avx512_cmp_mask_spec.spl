"""
## Purpose and audience
Byte-level golden contract for the AVX-512 compare-to-mask emit bodies
(`emit_avx512_vpcmpeqd`, `emit_avx512_vpcmpeqq`, `emit_avx512_vpcmpd`,
`emit_avx512_vpcmpq` in `compiler.backend.native.x86_64_avx512`), owned by
the native-codegen backend team. Every scenario pins one instruction byte
against the Intel SDM and an llvm-mc encoding captured in the comments.
## Operator workflow
Run `simple run test/01_unit/compiler/backend/avx512_cmp_mask_spec.spl`
after touching `src/compiler/**/x86_64_avx512.spl` EVEX emission or the
register-ID scaffold.
## Compatibility and limitations
The golden bytes are fixed for the 512-bit fixed-predicate (VPCMPEQD/Q) and
imm8-predicate (VPCMPD/Q) forms only; masked/zeroing variants and other
vector widths are covered by sibling backend specs. All sequences were
verified against `llvm-mc -triple=x86_64 -mattr=+avx512f --show-encoding`,
Intel SDM Vol 2C (VPCMP entries) and Vol 2A §2.6.1 Table 2-36 (EVEX prefix
layout). Register IDs follow the x86_64_avx512.spl scaffold: X86_ZMM0=48,
X86_ZMM1=49, k_dst raw 0-7.
## Verification guidance and troubleshooting
A failure names the drifting byte by position: byte 0 is the 0x62 escape,
bytes 1-3 are the EVEX P0/P1/P2 prefix bytes, byte 4 the opcode, byte 5 the
ModRM, and byte 6 the imm8 for the 3A-map forms. Re-derive the failing byte
from the per-scenario bit-layout comment before changing the encoder; the
post-F4 ERR-001a/b corrections live in the simd strict emit errata notes.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use compiler.backend.native.x86_64_avx512.{emit_avx512_vpcmpeqd, emit_avx512_vpcmpeqq, emit_avx512_vpcmpd, emit_avx512_vpcmpq}
use std.spec.{step}

# ============================================================================
# VPCMPEQD k0, zmm0, zmm1  (fixed-predicate EQ, 32-bit)
# EVEX.512.66.0F38.W0 76 /r
# k_dst=0 src1=zmm0(idx=0) src2=zmm1(idx=1) kmask=k0(unmasked) z=false
# Expected: 62 F2 7D 48 76 C1
# P0=0xF2: ~R=1 ~X=1 ~B=1 ~R'=1 0 mm[2:0]=010 (0F38 map) = 242
# P1=0x7D: W=0 ~vvvv=1111(src1=zmm0,idx=0) must-1 pp=01(0x66) = 125
# P2=0x48: z=0 L'=1 L=0 b=0 ~V'=1 aaa=000 = 72
# ModRM=0xC1: mod=11 reg=0(k0) rm=1(zmm1) = 193
# Intel SDM Vol 2C VPCMPEQD; Vol 2A §2.6.1 Table 2-36
# llvm-mc verified: vpcmpeqd k0, zmm0, zmm1 → 62 f2 7d 48 76 c1
# ============================================================================

describe "AVX-512 EVEX emit VPCMPEQD compare-to-mask golden":
    # @manual_section: avx512 compare-to-mask emit golden bytes
    it "VPCMPEQD k0 zmm0 zmm1 emits 6 bytes":
        # @req REQ-COMPILER-AVX512-CMPMASK-001
        # @capture(protocol_binary): VPCMPEQD k0 zmm0 zmm1 full encoding
        step("Emit VPCMPEQD k0, zmm0, zmm1 and check the encoded length")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result.len()).to_equal(6)  # oracle: one EVEX instruction is escape + P0 + P1 + P2 + opcode + ModRM = 6 bytes

    it "VPCMPEQD k0 zmm0 zmm1 escape byte is 0x62":
        # @req REQ-COMPILER-AVX512-CMPMASK-002
        # @capture(protocol_binary): VPCMPEQD escape byte
        step("Emit VPCMPEQD and check the EVEX escape byte")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result[0]).to_equal(98)  # oracle: 0x62 is the EVEX escape byte that replaced AVX's 0xC4/0xC5 VEX leads

    it "VPCMPEQD k0 zmm0 zmm1 P0 is 0xF2":
        # @req REQ-COMPILER-AVX512-CMPMASK-003
        # @capture(protocol_binary): VPCMPEQD EVEX P0 byte
        step("Emit VPCMPEQD and check the P0 map byte")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result[1]).to_equal(242)  # oracle: P0=0xF2 — ~R~X~B~R' all 1, mm=010 selects the 0F38 map

    it "VPCMPEQD k0 zmm0 zmm1 P1 is 0x7D":
        # @req REQ-COMPILER-AVX512-CMPMASK-004
        # @capture(protocol_binary): VPCMPEQD EVEX P1 byte
        step("Emit VPCMPEQD and check the P1 prefix byte")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result[2]).to_equal(125)  # oracle: P1=0x7D — W=0, ~vvvv=1111 for src1 zmm0, must-1, pp=01 for 0x66

    it "VPCMPEQD k0 zmm0 zmm1 P2 is 0x48":
        # @req REQ-COMPILER-AVX512-CMPMASK-005
        # @capture(protocol_binary): VPCMPEQD EVEX P2 byte
        step("Emit VPCMPEQD and check the P2 prefix byte")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result[3]).to_equal(72)  # oracle: P2=0x48 — L'=1 L=0 selects 512-bit, z=0 no zeroing, aaa=000 k0

    it "VPCMPEQD k0 zmm0 zmm1 opcode is 0x76":
        # @req REQ-COMPILER-AVX512-CMPMASK-006
        # @capture(protocol_binary): VPCMPEQD opcode byte
        step("Emit VPCMPEQD and check the opcode byte")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result[4]).to_equal(118)  # oracle: 0x76 is VPCMPEQD's opcode in the 0F38 map per Intel SDM Vol 2C

    it "VPCMPEQD k0 zmm0 zmm1 ModRM is 0xC1":
        # @req REQ-COMPILER-AVX512-CMPMASK-007
        # @capture(protocol_binary): VPCMPEQD ModRM byte
        step("Emit VPCMPEQD and check the ModRM byte")
        val result = emit_avx512_vpcmpeqd(0, 48, 49)
        expect(result[5]).to_equal(193)  # oracle: ModRM=0xC1 — mod=11 register form, reg=k0, rm=zmm1

# ============================================================================
# VPCMPEQQ k1, zmm0, zmm1  (fixed-predicate EQ, 64-bit)
# EVEX.512.66.0F38.W1 29 /r
# k_dst=1 src1=zmm0(idx=0) src2=zmm1(idx=1) kmask=k0(unmasked) z=false
# Expected: 62 F2 FD 48 29 C9
# P0=0xF2: ~R=1 ~X=1 ~B=1 ~R'=1 0 mm=010(0F38) = 242
# P1=0xFD: W=1 ~vvvv=1111 must-1 pp=01 = 253
# P2=0x48: z=0 L'=1 L=0 b=0 ~V'=1 aaa=000 = 72
# ModRM=0xC9: mod=11 reg=1(k1) rm=1(zmm1) = 192+8+1 = 201
# Intel SDM Vol 2C VPCMPEQQ; Vol 2A §2.6.1 Table 2-36
# llvm-mc verified: vpcmpeqq k1, zmm0, zmm1 → 62 f2 fd 48 29 c9
# ============================================================================

describe "AVX-512 EVEX emit VPCMPEQQ compare-to-mask golden":
    # @manual_section: avx512 compare-to-mask emit golden bytes
    it "VPCMPEQQ k1 zmm0 zmm1 emits 6 bytes":
        # @req REQ-COMPILER-AVX512-CMPMASK-008
        # @capture(protocol_binary): VPCMPEQQ k1 zmm0 zmm1 full encoding
        step("Emit VPCMPEQQ k1, zmm0, zmm1 and check the encoded length")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result.len()).to_equal(6)  # oracle: escape + P0 + P1 + P2 + opcode + ModRM = 6 bytes for every EVEX 2-op form

    it "VPCMPEQQ k1 zmm0 zmm1 escape byte is 0x62":
        # @req REQ-COMPILER-AVX512-CMPMASK-009
        # @capture(protocol_binary): VPCMPEQQ escape byte
        step("Emit VPCMPEQQ and check the EVEX escape byte")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result[0]).to_equal(98)  # oracle: 0x62 EVEX escape, identical to the D-form lead byte

    it "VPCMPEQQ k1 zmm0 zmm1 P0 is 0xF2":
        # @req REQ-COMPILER-AVX512-CMPMASK-010
        # @capture(protocol_binary): VPCMPEQQ EVEX P0 byte
        step("Emit VPCMPEQQ and check the P0 map byte")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result[1]).to_equal(242)  # oracle: P0=0xF2 — mm=010 (0F38 map), same map as the D-form

    it "VPCMPEQQ k1 zmm0 zmm1 P1 is 0xFD":
        # @req REQ-COMPILER-AVX512-CMPMASK-011
        # @capture(protocol_binary): VPCMPEQQ EVEX P1 byte
        step("Emit VPCMPEQQ and check the P1 prefix byte")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result[2]).to_equal(253)  # oracle: P1=0xFD — W=1 selects the 64-bit Q-form (W=0 would give 0x7D)

    it "VPCMPEQQ k1 zmm0 zmm1 P2 is 0x48":
        # @req REQ-COMPILER-AVX512-CMPMASK-012
        # @capture(protocol_binary): VPCMPEQQ EVEX P2 byte
        step("Emit VPCMPEQQ and check the P2 prefix byte")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result[3]).to_equal(72)  # oracle: P2=0x48 — 512-bit vectors, no zeroing, aaa=000

    it "VPCMPEQQ k1 zmm0 zmm1 opcode is 0x29":
        # @req REQ-COMPILER-AVX512-CMPMASK-013
        # @capture(protocol_binary): VPCMPEQQ opcode byte
        step("Emit VPCMPEQQ and check the opcode byte")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result[4]).to_equal(41)  # oracle: 0x29 is VPCMPEQQ's opcode in the 0F38 map per Intel SDM Vol 2C

    it "VPCMPEQQ k1 zmm0 zmm1 ModRM is 0xC9":
        # @req REQ-COMPILER-AVX512-CMPMASK-014
        # @capture(protocol_binary): VPCMPEQQ ModRM byte
        step("Emit VPCMPEQQ and check the ModRM byte")
        val result = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(result[5]).to_equal(201)  # oracle: ModRM=0xC9 — mod=11, reg=k1 (adds 8 over k0), rm=zmm1

    it "VPCMPEQQ P1 byte differs from VPCMPEQD P1 by W-bit (0x7D vs 0xFD)":
        # @req REQ-COMPILER-AVX512-CMPMASK-015
        # @capture(protocol_binary): D-form vs Q-form P1 bytes side by side
        step("Emit both D-form and Q-form EQ instructions and compare their P1 bytes")
        val rd = emit_avx512_vpcmpeqd(0, 48, 49)
        val rq = emit_avx512_vpcmpeqq(1, 48, 49)
        expect(rd[2]).to_equal(125)  # oracle: W=0 gives P1=0x7D=125 for the 32-bit D-form
        expect(rq[2]).to_equal(253)  # oracle: W=1 gives P1=0xFD=253 for the 64-bit Q-form — only the W bit differs

# ============================================================================
# VPCMPD k0, zmm0, zmm1, 0  (imm8 predicate EQ=0, 32-bit)
# EVEX.512.66.0F3A.W0 1F /r ib
# k_dst=0 src1=zmm0(idx=0) src2=zmm1(idx=1) imm8=0
# Expected: 62 F3 7D 48 1F C1 00
# P0=0xF3: ~R=1 ~X=1 ~B=1 ~R'=1 0 mm=011(0F3A) = 243
# P1=0x7D: W=0 ~vvvv=1111 must-1 pp=01 = 125
# P2=0x48: z=0 L'=1 L=0 b=0 ~V'=1 aaa=000 = 72
# ModRM=0xC1: mod=11 reg=0(k0) rm=1(zmm1) = 193
# imm8=0x00
# Intel SDM Vol 2C VPCMPD; Vol 2A §2.6.1 Table 2-36
# llvm-mc verified: vpcmpd k0, zmm0, zmm1, 0 → 62 f3 7d 48 1f c1 00
# ============================================================================

describe "AVX-512 EVEX emit VPCMPD imm8-predicate golden":
    # @manual_section: avx512 compare-to-mask emit golden bytes
    it "VPCMPD k0 zmm0 zmm1 EQ=0 emits 7 bytes":
        # @req REQ-COMPILER-AVX512-CMPMASK-016
        # @capture(protocol_binary): VPCMPD EQ=0 full encoding
        step("Emit VPCMPD k0, zmm0, zmm1 with predicate EQ and check the length")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result.len()).to_equal(7)  # oracle: the imm8-predicate 3A-map form appends one imm8 byte to the 6-byte base

    it "VPCMPD k0 zmm0 zmm1 EQ=0 escape byte is 0x62":
        # @req REQ-COMPILER-AVX512-CMPMASK-017
        # @capture(protocol_binary): VPCMPD escape byte
        step("Emit VPCMPD EQ and check the EVEX escape byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[0]).to_equal(98)  # oracle: 0x62 EVEX escape, shared by every EVEX form in this spec

    it "VPCMPD k0 zmm0 zmm1 EQ=0 P0 is 0xF3":
        # @req REQ-COMPILER-AVX512-CMPMASK-018
        # @capture(protocol_binary): VPCMPD EVEX P0 byte
        step("Emit VPCMPD EQ and check the P0 map byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[1]).to_equal(243)  # oracle: P0=0xF3 — mm=011 selects the 0F3A map used by imm8-predicate compares

    it "VPCMPD k0 zmm0 zmm1 EQ=0 P1 is 0x7D":
        # @req REQ-COMPILER-AVX512-CMPMASK-019
        # @capture(protocol_binary): VPCMPD EVEX P1 byte
        step("Emit VPCMPD EQ and check the P1 prefix byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[2]).to_equal(125)  # oracle: P1=0x7D — W=0 32-bit form, ~vvvv=1111 for src1 zmm0, pp=01

    it "VPCMPD k0 zmm0 zmm1 EQ=0 P2 is 0x48":
        # @req REQ-COMPILER-AVX512-CMPMASK-020
        # @capture(protocol_binary): VPCMPD EVEX P2 byte
        step("Emit VPCMPD EQ and check the P2 prefix byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[3]).to_equal(72)  # oracle: P2=0x48 — 512-bit, no zeroing, aaa=000 writes the plain mask k0

    it "VPCMPD k0 zmm0 zmm1 EQ=0 opcode is 0x1F":
        # @req REQ-COMPILER-AVX512-CMPMASK-021
        # @capture(protocol_binary): VPCMPD opcode byte
        step("Emit VPCMPD EQ and check the opcode byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[4]).to_equal(31)  # oracle: 0x1F is VPCMPD/VPCMPQ's shared opcode in the 0F3A map per Intel SDM Vol 2C

    it "VPCMPD k0 zmm0 zmm1 EQ=0 ModRM is 0xC1":
        # @req REQ-COMPILER-AVX512-CMPMASK-022
        # @capture(protocol_binary): VPCMPD ModRM byte
        step("Emit VPCMPD EQ and check the ModRM byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[5]).to_equal(193)  # oracle: ModRM=0xC1 — mod=11, reg=k0, rm=zmm1

    it "VPCMPD k0 zmm0 zmm1 EQ=0 imm8 is 0x00":
        # @req REQ-COMPILER-AVX512-CMPMASK-023
        # @capture(protocol_binary): VPCMPD imm8 predicate byte
        step("Emit VPCMPD EQ and check the trailing imm8 predicate byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 0)
        expect(result[6]).to_equal(0)  # oracle: imm8 predicate 0 encodes EQ per Intel SDM Vol 2C VPCMPD predicate table

    it "VPCMPD k0 zmm0 zmm1 LT=1 emits 7 bytes":
        # @req REQ-COMPILER-AVX512-CMPMASK-024
        # @capture(protocol_binary): VPCMPD LT=1 full encoding
        step("Emit VPCMPD with predicate LT and check the length")
        val result = emit_avx512_vpcmpd(0, 48, 49, 1)
        expect(result.len()).to_equal(7)  # oracle: predicate value does not change instruction length — still 6 bytes plus imm8

    it "VPCMPD k0 zmm0 zmm1 LT=1 imm8 is 0x01":
        # @req REQ-COMPILER-AVX512-CMPMASK-025
        # @capture(protocol_binary): VPCMPD LT=1 imm8 byte
        step("Emit VPCMPD LT and check the trailing imm8 predicate byte")
        val result = emit_avx512_vpcmpd(0, 48, 49, 1)
        expect(result[6]).to_equal(1)  # oracle: imm8 predicate 1 encodes LT per the VPCMPD predicate table

    it "VPCMPD LT differs from EQ only in imm8 byte":
        # @req REQ-COMPILER-AVX512-CMPMASK-026
        # @capture(protocol_binary): EQ vs LT encodings byte by byte
        step("Emit both EQ and LT predicates and require every non-imm8 byte to match")
        val req = emit_avx512_vpcmpd(0, 48, 49, 0)
        val rlt = emit_avx512_vpcmpd(0, 48, 49, 1)
        expect(req[0]).to_equal(rlt[0])
        expect(req[1]).to_equal(rlt[1])
        expect(req[2]).to_equal(rlt[2])
        expect(req[3]).to_equal(rlt[3])
        expect(req[4]).to_equal(rlt[4])
        expect(req[5]).to_equal(rlt[5])
        expect(req[6]).to_equal(0)  # oracle: EQ stays imm8 0 while LT flips only the final byte
        expect(rlt[6]).to_equal(1)  # oracle: LT stays imm8 1 — predicate selection must touch no other byte

# ============================================================================
# VPCMPQ k1, zmm0, zmm1, 0  (imm8 predicate EQ=0, 64-bit)
# EVEX.512.66.0F3A.W1 1F /r ib
# k_dst=1 src1=zmm0(idx=0) src2=zmm1(idx=1) imm8=0
# Expected: 62 F3 FD 48 1F C9 00
# P0=0xF3: mm=011(0F3A) = 243
# P1=0xFD: W=1 ~vvvv=1111 must-1 pp=01 = 253 (W=1 differentiates Q from D)
# P2=0x48: z=0 L'=1 L=0 b=0 ~V'=1 aaa=000 = 72
# ModRM=0xC9: mod=11 reg=1(k1) rm=1(zmm1) = 201
# imm8=0x00
# Intel SDM Vol 2C VPCMPQ; Vol 2A §2.6.1 Table 2-36
# llvm-mc verified: vpcmpq k1, zmm0, zmm1, 0 → 62 f3 fd 48 1f c9 00
# ============================================================================

describe "AVX-512 EVEX emit VPCMPQ imm8-predicate golden":
    # @manual_section: avx512 compare-to-mask emit golden bytes
    it "VPCMPQ k1 zmm0 zmm1 EQ=0 emits 7 bytes":
        # @req REQ-COMPILER-AVX512-CMPMASK-027
        # @capture(protocol_binary): VPCMPQ EQ=0 full encoding
        step("Emit VPCMPQ k1, zmm0, zmm1 with predicate EQ and check the length")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result.len()).to_equal(7)  # oracle: 6-byte EVEX base plus the trailing imm8 predicate byte

    it "VPCMPQ k1 zmm0 zmm1 EQ=0 P0 is 0xF3":
        # @req REQ-COMPILER-AVX512-CMPMASK-028
        # @capture(protocol_binary): VPCMPQ EVEX P0 byte
        step("Emit VPCMPQ EQ and check the P0 map byte")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result[1]).to_equal(243)  # oracle: P0=0xF3 — mm=011 (0F3A map), identical to the D-form map

    it "VPCMPQ k1 zmm0 zmm1 EQ=0 P1 is 0xFD":
        # @req REQ-COMPILER-AVX512-CMPMASK-029
        # @capture(protocol_binary): VPCMPQ EVEX P1 byte
        step("Emit VPCMPQ EQ and check the P1 prefix byte")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result[2]).to_equal(253)  # oracle: P1=0xFD — W=1 64-bit Q-form; W=0 would give 0x7D

    it "VPCMPQ k1 zmm0 zmm1 EQ=0 P2 is 0x48":
        # @req REQ-COMPILER-AVX512-CMPMASK-030
        # @capture(protocol_binary): VPCMPQ EVEX P2 byte
        step("Emit VPCMPQ EQ and check the P2 prefix byte")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result[3]).to_equal(72)  # oracle: P2=0x48 — 512-bit vectors, no zeroing, aaa=000

    it "VPCMPQ k1 zmm0 zmm1 EQ=0 opcode is 0x1F":
        # @req REQ-COMPILER-AVX512-CMPMASK-031
        # @capture(protocol_binary): VPCMPQ opcode byte
        step("Emit VPCMPQ EQ and check the opcode byte")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result[4]).to_equal(31)  # oracle: 0x1F opcode shared with VPCMPD; width lives in EVEX.W, not the opcode

    it "VPCMPQ k1 zmm0 zmm1 EQ=0 ModRM is 0xC9":
        # @req REQ-COMPILER-AVX512-CMPMASK-032
        # @capture(protocol_binary): VPCMPQ ModRM byte
        step("Emit VPCMPQ EQ and check the ModRM byte")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result[5]).to_equal(201)  # oracle: ModRM=0xC9 — mod=11, reg=k1, rm=zmm1

    it "VPCMPQ k1 zmm0 zmm1 EQ=0 imm8 is 0x00":
        # @req REQ-COMPILER-AVX512-CMPMASK-033
        # @capture(protocol_binary): VPCMPQ imm8 predicate byte
        step("Emit VPCMPQ EQ and check the trailing imm8 predicate byte")
        val result = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(result[6]).to_equal(0)  # oracle: imm8 predicate 0 encodes EQ for VPCMPQ just as for VPCMPD

    it "VPCMPQ P1 byte differs from VPCMPD P1 by W-bit (0x7D vs 0xFD)":
        # @req REQ-COMPILER-AVX512-CMPMASK-034
        # @capture(protocol_binary): VPCMPD vs VPCMPQ P1 bytes side by side
        step("Emit both D-form and Q-form imm8 compares and compare their P1 bytes")
        val rd = emit_avx512_vpcmpd(0, 48, 49, 0)
        val rq = emit_avx512_vpcmpq(1, 48, 49, 0)
        expect(rd[2]).to_equal(125)  # oracle: W=0 gives P1=0x7D=125 for the 32-bit D-form
        expect(rq[2]).to_equal(253)  # oracle: W=1 gives P1=0xFD=253 for the 64-bit Q-form — only the W bit differs
