# The pure-Simple HIR interpreter (the engine behind the native CLI's `run`
# and `test`) must run ordinary program bodies: builtin methods on text,
# arrays and dicts, loops, early return and literal `match`.
#
# @cover src/compiler/70.backend/backend/interpreter_expr.spl
# @cover src/compiler/70.backend/backend/interpreter_calls.spl
# @cover src/compiler/70.backend/backend/interpreter.spl
#
# doc/08_tracking/bug/native_cli_test_cannot_run_std_spec_2026-11-15.md

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.backend.backend_types.*
use compiler.backend.interpreter.{InterpreterBackendImpl}
use compiler.common.config.{Logger}

fn ws_run(src: text) -> text:
    val module = parse_full_frontend(src, "ws_main.spl", "ws_main", Logger(level: 0))
    var lowering = HirLowering.with_filename("ws_main.spl")
    val hir = lowering.lower_module(module)
    var backend = InterpreterBackendImpl.new()
    match backend.interpret_hir_module(hir):
        case Ok(BackendResult.Value(Value.String(s))): "string:" + s
        case Ok(BackendResult.Value(Value.Int(n))): "int:" + n.to_text()
        case Ok(BackendResult.Value(Value.Bool(b))): "bool:" + b.to_text()
        case Ok(_): "other"
        case Err(e): "error:" + e.message

describe "HIR interpreter program bodies":
    it "measures text and array length":
        expect(ws_run("fn main() -> i64:\n    val xs = [1, 2, 3]\n    \"abcd\".len() + xs.len()\n")).to_equal("int:7")

    it "appends to a var array with push":
        expect(ws_run("fn main() -> i64:\n    var xs = [1, 2]\n    xs.push(5)\n    xs.len() + xs[2]\n")).to_equal("int:8")

    it "answers dict key membership and lookup":
        expect(ws_run("fn main() -> i64:\n    val d = \{\"a\": 4\}\n    if d.contains_key(\"a\") and not d.contains_key(\"b\"):\n        d[\"a\"]\n    else:\n        0\n")).to_equal("int:4")

    it "answers text predicates":
        expect(ws_run("fn main() -> bool:\n    val s = \"hello world\"\n    s.starts_with(\"hell\") and s.contains(\"o w\") and not s.ends_with(\"x\")\n")).to_equal("bool:true")

    it "sums with a while loop":
        expect(ws_run("fn main() -> i64:\n    var i = 0\n    var total = 0\n    while i < 5:\n        total = total + i\n        i = i + 1\n    total\n")).to_equal("int:10")

    it "sums array elements with a for loop":
        expect(ws_run("fn main() -> i64:\n    var total = 0\n    for x in [3, 4, 5]:\n        total = total + x\n    total\n")).to_equal("int:12")

    it "sums a range with a for loop":
        expect(ws_run("fn main() -> i64:\n    var total = 0\n    for i in 0..4:\n        total = total + i\n    total\n")).to_equal("int:6")

    it "stops a loop with break and skips with continue":
        expect(ws_run("fn main() -> i64:\n    var total = 0\n    for i in 0..10:\n        if i == 2:\n            continue\n        if i == 5:\n            break\n        total = total + i\n    total\n")).to_equal("int:8")

    it "returns early from a function":
        expect(ws_run("fn pick(n: i64) -> i64:\n    if n > 3:\n        return 100\n    n\n\nfn main() -> i64:\n    pick(9) + pick(2)\n")).to_equal("int:102")

    it "returns from inside a loop":
        expect(ws_run("fn find(xs: [i64]) -> i64:\n    for x in xs:\n        if x > 10:\n            return x\n    -1\n\nfn main() -> i64:\n    find([1, 20, 30])\n")).to_equal("int:20")

    it "selects a match arm by literal":
        expect(ws_run("fn name(n: i64) -> text:\n    match n:\n        case 1: \"one\"\n        case 2: \"two\"\n        case _: \"many\"\n\nfn main() -> text:\n    name(2) + name(7)\n")).to_equal("string:twomany")
