# @cover src/compiler/70.backend/backend/interpreter.spl 3%
# @cover src/compiler/70.backend/backend/env.spl 3%
"""
# Pure-Simple interpreter strict-memory mode (M5 parity with SIMPLE_STRICT_MEM)

**Category:** Compiler / Interpreter backend
**Lane:** M5 pure-Simple parity for strict-memory mode

## Overview

The Rust seed's tree-walking interpreter has a strict mode
(`SIMPLE_STRICT_MEM=1`, see `src/compiler_rust/compiler/src/value.rs`
`strict_mem_enabled()` / `CowEnv::mark_uninit`) that traps a read of an
initializer-less `let`/`var` binding with a clear diagnostic instead of
silently falling through. This spec drives the equivalent gate now added to
the pure-Simple tree-walking interpreter
(`InterpreterBackendImpl`/`Environment`, `src/compiler/70.backend/backend/`):

- default OFF (`SIMPLE_STRICT_MEM` unset / not `"1"`): reading an
  initializer-less `var` binding returns the placeholder `Value.Nil`, exactly
  as it did before this change -- no behavior difference.
- ON (`ctx.strict_mem == true`, set directly here rather than through the
  process-wide env var -- see note below): the same read instead returns an
  `Err(BackendError.runtime_error(...))` whose message names the variable and
  says it is uninitialized.
- a subsequent real assignment clears the trap so later reads succeed again.

Both cases build the `HirStmt`/`HirExpr` nodes by hand and call
`InterpreterBackendImpl.exec_stmt`/`.eval_expr` directly (the same idiom
`interpreter_backend_spec.spl` already uses for `eval_binop`), instead of
routing through `parse_full_frontend` + `HirLowering`, to keep this spec's
import graph -- and compile time -- small.

Note on env-var plumbing: `EvalContext.strict_mem` is read ONCE from
`SIMPLE_STRICT_MEM` inside `process_module()` (the real entry point used by
`bin/simple run`/`test`), not per-check -- see `interp_strict_mem_enabled()`
in `interpreter.spl`. This spec calls `exec_stmt`/`eval_expr` directly and so
builds `EvalContext` by hand, setting `strict_mem` explicitly to exercise
both the on and off path deterministically without depending on the host
process's environment (avoiding the documented `bin/simple test`
session-daemon env-scrubbing landmine for env-var-dependent specs).
"""

use std.spec
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use compiler.backend.backend.env.{Environment, EvalContext}
use compiler.backend.backend_types.*
use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}

fn make_module() -> HirModule:
    HirModule(name: "strict_mem_fixture", path: "strict_mem_fixture.spl", symbols: SymbolTable.new())

fn make_ctx(backend: InterpreterBackendImpl, strict_mem: bool) -> EvalContext:
    var names: Dict<i64, text> = {}
    names[1] = "x"
    EvalContext(env: Environment.new(), module: make_module(), backend: backend, names: names, fn_by_name: {}, has_fn_index: false, strict_mem: strict_mem)

fn uninit_let_stmt() -> HirStmt:
    # Mirrors what hir_lowering/statements.spl synthesizes for `var x: i64`
    # (no initializer): a bare NilLit init expression.
    val sp = Span.default()
    val init = HirExpr(kind: HirExprKind.NilLit, type_: nil, span: sp)
    HirStmt(kind: HirStmtKind.Let(SymbolId.new(1), nil, init), span: sp)

fn read_x_expr() -> HirExpr:
    val sp = Span.default()
    HirExpr(kind: HirExprKind.Var(SymbolId.new(1)), type_: nil, span: sp)

describe "Pure-Simple interpreter strict-mem (SIMPLE_STRICT_MEM parity)":
    it "default OFF: reading an uninitialized var returns Value.Nil, unchanged":
        val backend = InterpreterBackendImpl.new()
        val ctx = make_ctx(backend, false)
        val _ = backend.exec_stmt(uninit_let_stmt(), ctx)
        val result = backend.eval_expr(read_x_expr(), ctx)
        var got_nil = false
        match result:
            case Ok(Value.Nil):
                got_nil = true
            case _:
                got_nil = false
        expect(got_nil).to_equal(true)

    it "ON: reading an uninitialized var traps with a clear diagnostic":
        val backend = InterpreterBackendImpl.new()
        val ctx = make_ctx(backend, true)
        val _ = backend.exec_stmt(uninit_let_stmt(), ctx)
        val result = backend.eval_expr(read_x_expr(), ctx)
        var trapped = false
        match result:
            case Err(err):
                trapped = err.message.contains("strict-mem") and err.message.contains("uninitialized") and err.message.contains("x")
            case Ok(_):
                trapped = false
        expect(trapped).to_equal(true)

    it "ON: a real assignment clears the trap so a later read succeeds":
        val backend = InterpreterBackendImpl.new()
        val ctx = make_ctx(backend, true)
        val _ = backend.exec_stmt(uninit_let_stmt(), ctx)
        val sp = Span.default()
        val assign_stmt = HirStmt(kind: HirStmtKind.Assign(read_x_expr(), nil, HirExpr(kind: HirExprKind.IntLit(7, nil), type_: nil, span: sp)), span: sp)
        val _ = backend.exec_stmt(assign_stmt, ctx)
        val result = backend.eval_expr(read_x_expr(), ctx)
        var got_seven = false
        match result:
            case Ok(Value.Int(v)):
                got_seven = v == 7
            case _:
                got_seven = false
        expect(got_seven).to_equal(true)

    it "ON: a genuinely-initialized var is never trapped":
        val backend = InterpreterBackendImpl.new()
        val ctx = make_ctx(backend, true)
        val sp = Span.default()
        val let_stmt = HirStmt(kind: HirStmtKind.Let(SymbolId.new(1), nil, HirExpr(kind: HirExprKind.IntLit(42, nil), type_: nil, span: sp)), span: sp)
        val _ = backend.exec_stmt(let_stmt, ctx)
        val result = backend.eval_expr(read_x_expr(), ctx)
        var got_42 = false
        match result:
            case Ok(Value.Int(v)):
                got_42 = v == 42
            case _:
                got_42 = false
        expect(got_42).to_equal(true)
