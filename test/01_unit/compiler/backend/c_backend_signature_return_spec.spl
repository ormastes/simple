# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_file_read_text(path: text) -> text

fn c_instruction_source() -> text:
    rt_file_read_text("src/compiler/70.backend/backend/_CBackendTranslate/instruction_lowering.spl") ?? ""

use std.spec.step

describe "C backend signature return metadata":
    it "does not map nil indirect-call signature returns through the type mapper":
        # @req REQ-SSPEC-COMPILER
        step("does not map nil indirect-call signature returns through the type mapper")
        val source = c_instruction_source()
        expect(source).to_contain("if sig.return_type == nil: \"void\" else: self.type_mapper.map_type(sig.return_type)")
        assert_false(source.contains("val ret_ty = self.type_mapper.map_type(sig.return_type)"))
