# ============================================================================
# BSL V.16B — base 0x6E601C00
# V0,V0,V0 => LE: 0x00, 0x1C, 0x60, 0x6E
# ============================================================================

# @manual_section: neon-bsl-golden
describe "emit_bsl_16b — bitwise select 128-bit":
    it "BSL V0.16B, V0.16B, V0.16B encodes to base opcode bytes":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode BSL V0.16B, V0.16B, V0.16B (Rd=Rn=Rm=0)")
        var b = emit_bsl_16b(0, 0, 0)
        # @capture(bit_table): BSL little-endian 4-byte base opcode layout
        expect(b.len()).to_equal(4)  # oracle: BSL is a fixed 4-byte AArch64 instruction
        expect(b[0]).to_equal(0x00)  # oracle: byte0 = Rd field, Rd=0 contributes nothing
        expect(b[1]).to_equal(0x1C)  # oracle: byte1 = base opcode bits for the BSL bitwise-select family
        expect(b[2]).to_equal(0x60)  # oracle: byte2 = base opcode bits with Rm=0 (no Rm<<16 offset)
        expect(b[3]).to_equal(0x6E)  # oracle: byte3 = top opcode byte identifying BSL (U=1,Q=1)

    it "BSL V1.16B, V2.16B, V3.16B encodes register fields correctly":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode BSL V1.16B, V2.16B, V3.16B (Rd=1, Rn=2, Rm=3)")
        # word = 0x6E601C00 | (3 << 16) | (2 << 5) | 1
        #      = 0x6E601C00 | 0x30000 | 0x40 | 1
        #      = 0x6E631C41
        # LE: 0x41, 0x1C, 0x63, 0x6E
        var b = emit_bsl_16b(1, 2, 3)
        # @capture(bit_table): BSL little-endian 4-byte register-field layout
        expect(b.len()).to_equal(4)  # oracle: BSL is a fixed 4-byte AArch64 instruction
        expect(b[0]).to_equal(0x41)  # oracle: byte0 = base+Rd(1)+Rn<<5(0x40) folded into the low byte
        expect(b[1]).to_equal(0x1C)  # oracle: byte1 unaffected — Rn<<5 stayed within byte0's carry
        expect(b[2]).to_equal(0x63)  # oracle: byte2 = base byte + Rm(3) from the Rm<<16 term
        expect(b[3]).to_equal(0x6E)  # oracle: byte3 = top opcode byte, unaffected by register fields

    it "emit_bsl_16b always returns 4 bytes":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode BSL V25.16B, V26.16B, V27.16B and verify the fixed instruction width")
        var b = emit_bsl_16b(25, 26, 27)
        # @capture(bit_table): BSL emitted byte count for an arbitrary register triple
        expect(b.len()).to_equal(4)  # oracle: every BSL encoding is a fixed 4-byte AArch64 instruction
