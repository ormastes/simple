        expect(b[0]).to_equal(0x00)  # oracle: byte0 = Rd field, Rd=0 contributes nothing
        expect(b[1]).to_equal(0x34)  # oracle: byte1 = base opcode bits for the CMGT signed-compare family
        expect(b[2]).to_equal(0xA0)  # oracle: byte2 = base opcode bits with Rm=0 (no Rm<<16 offset)
        expect(b[3]).to_equal(0x4E)  # oracle: byte3 = top opcode byte identifying signed CMGT (U=0,Q=1)

    it "CMGT V1.4S, V2.4S, V3.4S encodes register fields correctly":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode CMGT V1.4S, V2.4S, V3.4S (Rd=1, Rn=2, Rm=3)")
        # word = 0x4EA03400 | (3 << 16) | (2 << 5) | 1
        #      = 0x4EA03400 | 0x30000 | 0x40 | 1
        #      = 0x4EA33441
        # LE: 0x41, 0x34, 0xA3, 0x4E
        var b = emit_cmgt_4s(1, 2, 3)
        # @capture(bit_table): CMGT little-endian 4-byte register-field layout
        expect(b.len()).to_equal(4)  # oracle: CMGT is a fixed 4-byte AArch64 instruction
        expect(b[0]).to_equal(0x41)  # oracle: byte0 = base+Rd(1)+Rn<<5(0x40) folded into the low byte
        expect(b[1]).to_equal(0x34)  # oracle: byte1 unaffected — Rn<<5 stayed within byte0's carry
        expect(b[2]).to_equal(0xA3)  # oracle: byte2 = base byte + Rm(3) from the Rm<<16 term
        expect(b[3]).to_equal(0x4E)  # oracle: byte3 = top opcode byte, unaffected by register fields

    it "emit_cmgt_4s always returns 4 bytes":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode CMGT V7.4S, V8.4S, V9.4S and verify the fixed instruction width")
        var b = emit_cmgt_4s(7, 8, 9)
        # @capture(bit_table): CMGT emitted byte count for an arbitrary register triple
        expect(b.len()).to_equal(4)  # oracle: every CMGT encoding is a fixed 4-byte AArch64 instruction

