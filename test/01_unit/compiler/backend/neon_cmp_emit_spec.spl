"""
## Purpose and audience
Byte-level golden encoding evidence for the compiler's native AArch64 backend
NEON comparison and select emit functions — CMEQ, CMGT, CMGE, CMHI, FCMEQ,
FCMGT, FCMGE, BSL (REQ-COMPILER-BACKEND-NATIVE-NEON-CMP). Audience: the ARM64
backend engineer who must verify each emitted 4-byte compare/select
instruction matches the ARMv8 ARM opcode layout bit-for-bit before trusting
the codegen path.

## Operator workflow
bin/simple test test/01_unit/compiler/backend/neon_cmp_emit_spec.spl

## Compatibility and limitations
Interpreter-mode note (per .claude/rules/testing.md): the test runner in
interpreter mode only verifies file loading and describe/it block
reachability; assertions inside it-blocks execute under compiled mode. Only
the 8 listed integer/float compare and BSL variants are covered; other NEON
comparison forms (scalar, immediate-zero) live in sibling spec files.

## Verification guidance and troubleshooting
Each scenario captures the emitted little-endian byte layout of one
compare/select instruction as a bit_table. A mismatch names the offending
byte; cross-reference ARMv8 ARM §C7.2.27 (CMEQ), §C7.2.33 (CMGT), §C7.2.30
(CMGE), §C7.2.36 (CMHI), §C7.2.79 (FCMEQ), §C7.2.85 (FCMGT), §C7.2.82
(FCMGE), §C7.2.22 (BSL), and the per-scenario derivation comment
(`base | (Rm << 16) | (Rn << 5) | Rd`) to locate which register field
produced the wrong byte.
"""
# research: doc/01_research/compiler/backend/backend_completeness_summary.md ; plan: doc/03_plan/compiler/backend/arm32_x86_32_native_backend_plan.md ; architecture: doc/04_architecture/compiler/backend/unified_backend_architecture.md ; design: doc/05_design/compiler/backend/backend_architecture.md
# @manual_section: neon-cmp-emit-encoding

# test/unit/compiler/backend/neon_cmp_emit_spec.spl
#
# Feature ID: #COMPILER-BACKEND-NATIVE-NEON-CMP
# Category:   Compiler | Backend | Native | AArch64 NEON Comparison/Select Encoding
#
# Byte-level golden tests for ARMv8-A NEON comparison and BSL emit functions:
#   CMEQ  Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.27)
#   CMGT  Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.33)
#   CMGE  Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.30)
#   CMHI  Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.36)
#   FCMEQ Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.79)
#   FCMGT Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.85)
#   FCMGE Vd.4S, Vn.4S, Vm.4S  (ARMv8 ARM §C7.2.82)
#   BSL   Vd.16B, Vn.16B, Vm.16B  (ARMv8 ARM §C7.2.22)
#
# All instructions are 4-byte fixed-width, little-endian per ARMv8 ABI.
# Encoding: base | (Rm << 16) | (Rn << 5) | Rd

use compiler.backend.native.encode_aarch64_neon_cmp.{emit_cmeq_4s, emit_cmgt_4s, emit_cmge_4s, emit_cmhi_4s, emit_fcmeq_4s, emit_fcmgt_4s, emit_fcmge_4s, emit_bsl_16b}

# ============================================================================
# CMEQ V.4S — base 0x6EA08C00
# V0,V0,V0 => LE: 0x00, 0x8C, 0xA0, 0x6E
# ============================================================================

# @manual_section: neon-cmeq-golden
describe "emit_cmeq_4s — compare equal 4x32-bit lanes":
    it "CMEQ V0.4S, V0.4S, V0.4S encodes to base opcode bytes":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode CMEQ V0.4S, V0.4S, V0.4S (Rd=Rn=Rm=0)")
        var b = emit_cmeq_4s(0, 0, 0)
        # @capture(bit_table): CMEQ little-endian 4-byte base opcode layout
        expect(b.len()).to_equal(4)  # oracle: CMEQ is a fixed 4-byte AArch64 instruction
        expect(b[0]).to_equal(0x00)  # oracle: byte0 = Rd field, Rd=0 contributes nothing
        expect(b[1]).to_equal(0x8C)  # oracle: byte1 = base opcode bits for the CMEQ integer-compare family
        expect(b[2]).to_equal(0xA0)  # oracle: byte2 = base opcode bits with Rm=0 (no Rm<<16 offset)
        expect(b[3]).to_equal(0x6E)  # oracle: byte3 = top opcode byte identifying unsigned CMEQ (U=1,Q=1)

    it "CMEQ V1.4S, V2.4S, V3.4S encodes register fields correctly":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode CMEQ V1.4S, V2.4S, V3.4S (Rd=1, Rn=2, Rm=3)")
        # word = 0x6EA08C00 | (3 << 16) | (2 << 5) | 1
        #      = 0x6EA08C00 | 0x30000 | 0x40 | 1
        #      = 0x6EA38C41
        # LE: 0x41, 0x8C, 0xA3, 0x6E
        var b = emit_cmeq_4s(1, 2, 3)
        # @capture(bit_table): CMEQ little-endian 4-byte register-field layout
        expect(b.len()).to_equal(4)  # oracle: CMEQ is a fixed 4-byte AArch64 instruction
        expect(b[0]).to_equal(0x41)  # oracle: byte0 = base+Rd(1)+Rn<<5(0x40) folded into the low byte
        expect(b[1]).to_equal(0x8C)  # oracle: byte1 unaffected — Rn<<5 stayed within byte0's carry
        expect(b[2]).to_equal(0xA3)  # oracle: byte2 = base byte + Rm(3) from the Rm<<16 term
        expect(b[3]).to_equal(0x6E)  # oracle: byte3 = top opcode byte, unaffected by register fields

    it "emit_cmeq_4s always returns 4 bytes":
        # @req REQ-COMPILER-BACKEND-NATIVE-NEON-CMP
        step("Encode CMEQ V4.4S, V5.4S, V6.4S and verify the fixed instruction width")
        var b = emit_cmeq_4s(4, 5, 6)
        # @capture(bit_table): CMEQ emitted byte count for an arbitrary register triple
        expect(b.len()).to_equal(4)  # oracle: every CMEQ encoding is a fixed 4-byte AArch64 instruction

# ============================================================================
# CMGT V.4S — base 0x4EA03400
# V0,V0,V0 => LE: 0x00, 0x34, 0xA0, 0x4E
# ============================================================================

# @manual_section: neon-cmgt-golden
describe "emit_cmgt_4s — compare signed greater-than 4x32-bit lanes":
