"""
# research: doc/01_research/compiler/backend/backend_completeness_summary.md ; plan: doc/03_plan/compiler/backend/arm32_x86_32_native_backend_plan.md ; architecture: doc/04_architecture/compiler/backend/unified_backend_architecture.md ; design: doc/05_design/compiler/backend/backend_architecture.md
## Purpose and audience
Executable schema-contract evidence for the `compiler.backend.feature_caps`
target-capability interface: micro-architecture-level preset derivation for
x86_64/Aarch64/Rv64, the supports()/cost() dispatch used to gate idiom
lowering, and the preferred-vector-width and preferred-lane-count planning
helpers. Audience: compiler backend engineers adding or auditing target
idioms and SIMD/bit/crypto/matrix lowering decisions.
REQ-SSPEC-COMPILER, REQ-COMPILER-BACKEND-FEATURE-CAPS.

## Operator workflow
Run this file with `bin/simple run test/01_unit/compiler/backend/feature_caps_spec.spl`.
Interpreter mode only verifies file loading and describe/it reachability;
compiled-mode execution exercises the assertions. Each scenario builds a
caps value (via a target-triple preset or an explicit constructor) and
checks a derived field, a supports()/cost() dispatch result, or a planning
helper's return value.

## Compatibility and limitations
Covers the x86_64-v1..v4 preset ladder, an unknown-triple fallback, a
representative subset of X86Caps/Aarch64Caps/Rv64Caps supports()/cost()
combinations, and the vector-width / lane-count helpers for f32 lanes only;
it does not enumerate every TargetIdiom or every feature combination.

## Verification guidance and troubleshooting
On a failing scenario, compare the asserted field or return value against
the microarchitecture-levels feature ladder (x86-64-v1..v4) or the relevant
backend's supports()/cost() table, and read the oracle comment on the
failing assertion for what the expected number represents.
"""

# TargetCaps — Schema Contract Tests
#
# Feature ID: #COMPILER-BACKEND-FEATURE-CAPS
# Category:   Compiler | Backend | Target Capability Interface
# Status:     Schema only — preset derivation + supports/cost dispatch
#
# Interpreter-mode note (per .claude/rules/testing.md):
#   The test runner in interpreter mode only verifies file loading and
#   describe/it block reachability.  The assertions inside it-blocks are not
#   executed.  Compiled-mode execution will exercise them.

use std.spec.step
use compiler.backend.feature_caps.{
    TargetIdiom, TargetFeatureClass,
    X86Caps, Aarch64Caps, Rv64Caps,
    x86_caps_from_target, aarch64_caps_from_target, rv64_caps_from_target,
    idiom_feature_class,
    x86_supports_feature_class, aarch64_supports_feature_class, rv64_supports_feature_class,
    preferred_lane_count_x86, preferred_lane_count_aarch64, preferred_lane_count_rv64
}

# ============================================================================
# Preset derivation — x86_64 micro-arch levels
# ============================================================================

# @manual_section: x86_64 preset derivation
describe "TargetCaps — x86_64 preset derivation":
    it "x86_64-v1 has none of aes/sha/sse42/popcnt/pclmul/avx2/avx512":
        step("Derive caps for the x86_64-v1 target triple and inspect every feature flag")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): x86_64-v1 preset feature flags, all expected false
        val caps = x86_caps_from_target("x86_64-v1")
        expect(caps.has_aes).to_equal(false)
        expect(caps.has_sha_ni).to_equal(false)
        expect(caps.has_sse42).to_equal(false)
        expect(caps.has_popcnt).to_equal(false)
        expect(caps.has_pclmul).to_equal(false)
        expect(caps.has_avx2).to_equal(false)
        expect(caps.has_avx512).to_equal(false)

    it "x86_64-v2 has sse42 + popcnt only (no aes, no pclmul, no avx2, no avx512, no sha_ni)":
        step("Derive caps for the x86_64-v2 target triple and inspect every feature flag")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): x86_64-v2 preset feature flags, sse42/popcnt true, rest false
        val caps = x86_caps_from_target("x86_64-v2")
        expect(caps.has_sse42).to_equal(true)
        expect(caps.has_popcnt).to_equal(true)
        expect(caps.has_aes).to_equal(false)
        expect(caps.has_sha_ni).to_equal(false)
        expect(caps.has_pclmul).to_equal(false)
        expect(caps.has_avx2).to_equal(false)
        expect(caps.has_avx512).to_equal(false)

    it "x86_64-v3 has aes + pclmul + avx2 + sse42, no avx512, no sha_ni":
        step("Derive caps for the x86_64-v3 target triple and inspect every feature flag")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): x86_64-v3 preset feature flags, aes/sse42/popcnt/pclmul/avx2 true
        val caps = x86_caps_from_target("x86_64-v3")
        expect(caps.has_aes).to_equal(true)
        expect(caps.has_sse42).to_equal(true)
        expect(caps.has_popcnt).to_equal(true)
        expect(caps.has_pclmul).to_equal(true)
        expect(caps.has_avx2).to_equal(true)
        expect(caps.has_sha_ni).to_equal(false)
        expect(caps.has_avx512).to_equal(false)

    it "x86_64-v4 has avx512 + sha_ni in addition to v3 features":
        step("Derive caps for the x86_64-v4 target triple and inspect every feature flag")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): x86_64-v4 preset feature flags, all listed flags true
        val caps = x86_caps_from_target("x86_64-v4")
        expect(caps.has_aes).to_equal(true)
        expect(caps.has_sha_ni).to_equal(true)
        expect(caps.has_sse42).to_equal(true)
        expect(caps.has_popcnt).to_equal(true)
        expect(caps.has_pclmul).to_equal(true)
        expect(caps.has_avx2).to_equal(true)
        expect(caps.has_avx512).to_equal(true)

    it "unknown triple defaults to all-false":
        step("Derive caps for an unrecognized target triple and inspect every feature flag")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): unknown-triple preset feature flags, all expected false
        val caps = x86_caps_from_target("unknown-triple-xyz")
        expect(caps.has_aes).to_equal(false)
        expect(caps.has_sha_ni).to_equal(false)
        expect(caps.has_sse42).to_equal(false)
        expect(caps.has_popcnt).to_equal(false)
        expect(caps.has_pclmul).to_equal(false)
        expect(caps.has_avx2).to_equal(false)
        expect(caps.has_avx512).to_equal(false)

# ============================================================================
# supports() dispatch across backends
# ============================================================================

# @manual_section: supports() and cost() dispatch
describe "TargetCaps — supports() dispatch":
    it "X86Caps with has_aes=true supports AesEnc":
        step("Construct X86Caps with has_aes true and query supports for AesEnc")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): X86Caps.supports(AesEnc) result when has_aes is true
        val caps = X86Caps(
            has_aes: true,
            has_sha_ni: false,
            has_sse42: false,
            has_popcnt: false,
            has_pclmul: false,
            has_avx: false,
            has_avx2: false,
            has_avx512: false,
            has_bmi1: false
        )
        expect(caps.supports(TargetIdiom.AesEnc)).to_equal(true)

    it "X86Caps with has_aes=false reports false for AesEnc":
        step("Construct X86Caps with has_aes false and query supports for AesEnc")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): X86Caps.supports(AesEnc) result when has_aes is false
        val caps = X86Caps(
            has_aes: false,
            has_sha_ni: false,
            has_sse42: false,
            has_popcnt: false,
            has_pclmul: false,
            has_avx: false,
            has_avx2: false,
            has_avx512: false,
            has_bmi1: false
        )
        expect(caps.supports(TargetIdiom.AesEnc)).to_equal(false)

    it "X86Caps supports ByteSwap without sse42":
        step("Construct X86Caps with no extended features and query supports for ByteSwap")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): X86Caps.supports(ByteSwap) result with no extended features
        val caps = X86Caps(
            has_aes: false,
            has_sha_ni: false,
            has_sse42: false,
            has_popcnt: false,
            has_pclmul: false,
            has_avx: false,
            has_avx2: false,
            has_avx512: false,
            has_bmi1: false
        )
        expect(caps.supports(TargetIdiom.ByteSwap)).to_equal(true)

    it "X86Caps with sse42/popcnt but no bmi1 blocks CountLeadingZeros and CountTrailingZeros":
        step("Construct X86Caps with sse42 and popcnt but no bmi1 and query both bit-count idioms")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): X86Caps.supports() results for CountLeadingZeros and CountTrailingZeros without bmi1
        val caps = X86Caps(
            has_aes: false,
            has_sha_ni: false,
            has_sse42: true,
            has_popcnt: true,
            has_pclmul: false,
            has_avx: false,
            has_avx2: false,
            has_avx512: false,
            has_bmi1: false
        )
        expect(caps.supports(TargetIdiom.CountLeadingZeros)).to_equal(false)
        expect(caps.supports(TargetIdiom.CountTrailingZeros)).to_equal(false)

    it "Aarch64Caps with has_aes=true supports AesEnc":
        step("Construct Aarch64Caps with has_aes true and query supports for AesEnc")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): Aarch64Caps.supports(AesEnc) result when has_aes is true
        val caps = Aarch64Caps(
            has_aes: true,
            has_sha2: false,
            has_sha3: false,
            has_crc32: false,
            has_pmull: false,
            has_sve2: false,
            has_neon: true,
            has_sha512: false
        )
        expect(caps.supports(TargetIdiom.AesEnc)).to_equal(true)

    it "Rv64Caps with has_zvkned=true supports AesEnc":
        step("Construct Rv64Caps with has_zvkned true and query supports for AesEnc")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): Rv64Caps.supports(AesEnc) result when has_zvkned is true
        val caps = Rv64Caps(
            has_zvkned: true,
            has_zvknh: false,
            has_zvkg: false,
            has_zbb: false,
            has_zbkb: false,
            has_v: true,
            vlen_bits: 128
        )
        expect(caps.supports(TargetIdiom.AesEnc)).to_equal(true)

    it "Rv64Caps with zbb but no v supports Popcount":
        step("Construct Rv64Caps with zbb but no v and query supports for Popcount")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): Rv64Caps.supports(Popcount) result with zbb and no v
        val caps = Rv64Caps(
            has_zvkned: false,
            has_zvknh: false,
            has_zvkg: false,
            has_zbb: true,
            has_zbkb: false,
            has_v: false,
            vlen_bits: 128
        )
        expect(caps.supports(TargetIdiom.Popcount)).to_equal(true)

    it "Rv64Caps with zbkb but no zbb supports RotateLeft":
        step("Construct Rv64Caps with zbkb but no zbb and query supports for RotateLeft")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): Rv64Caps.supports(RotateLeft) result with zbkb and no zbb
        val caps = Rv64Caps(
            has_zvkned: false,
            has_zvknh: false,
            has_zvkg: false,
            has_zbb: false,
            has_zbkb: true,
            has_v: false,
            vlen_bits: 128
        )
        expect(caps.supports(TargetIdiom.RotateLeft)).to_equal(true)

    it "Rv64Caps needs both zbb and zbkb for BitReverse":
        step("Construct Rv64Caps with zbb but no zbkb and query supports for BitReverse")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): Rv64Caps.supports(BitReverse) result with only zbb set
        val caps = Rv64Caps(
            has_zvkned: false,
            has_zvknh: false,
            has_zvkg: false,
            has_zbb: true,
            has_zbkb: false,
            has_v: false,
            vlen_bits: 128
        )
        expect(caps.supports(TargetIdiom.BitReverse)).to_equal(false)

    it "cost(unsupported idiom) returns -1":
        step("Construct X86Caps with no features and query cost for the unsupported AesEnc idiom")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): X86Caps.cost(AesEnc) result when the idiom is unsupported
        val caps = X86Caps(
            has_aes: false,
            has_sha_ni: false,
            has_sse42: false,
            has_popcnt: false,
            has_pclmul: false,
            has_avx: false,
            has_avx2: false,
            has_avx512: false,
            has_bmi1: false
        )
        expect(caps.cost(TargetIdiom.AesEnc)).to_equal(-1)  # oracle: -1 is the sentinel cost() returns for an unsupported idiom

# ============================================================================
# preferred_vector_width_bits — sanity checks per backend
# ============================================================================

# @manual_section: preferred vector width
describe "TargetCaps — preferred_vector_width_bits":
    it "X86Caps avx512 returns 512":
        step("Derive caps for x86_64-v4 and query preferred_vector_width_bits")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): preferred_vector_width_bits() result for the avx512-capable v4 preset
        val caps = x86_caps_from_target("x86_64-v4")
        expect(caps.preferred_vector_width_bits() > 0).to_equal(true)
        expect(caps.preferred_vector_width_bits()).to_equal(512)  # oracle: 512-bit ZMM register width, selected because has_avx512 is true

    it "X86Caps avx2-only returns 256":
        step("Derive caps for x86_64-v3 and query preferred_vector_width_bits")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): preferred_vector_width_bits() result for the avx2-only v3 preset
        val caps = x86_caps_from_target("x86_64-v3")
        expect(caps.preferred_vector_width_bits()).to_equal(256)  # oracle: 256-bit YMM register width, selected because has_avx2 is true but not has_avx512

    it "X86Caps baseline returns 128":
        step("Derive caps for x86_64-v1 and query preferred_vector_width_bits")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): preferred_vector_width_bits() result for the baseline v1 preset
        val caps = x86_caps_from_target("x86_64-v1")
        expect(caps.preferred_vector_width_bits()).to_equal(128)  # oracle: 128-bit XMM register width, the SSE2 baseline with no AVX2/AVX512

# ============================================================================
# Feature-class helpers for SIMD / bit / crypto / matrix planning
# ============================================================================

# @manual_section: feature-class classification helpers
describe "TargetCaps — feature-class helpers":
    it "MatrixDot is classified as Matrix":
        step("Query idiom_feature_class for MatrixDot")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): idiom_feature_class(MatrixDot) result
        expect(idiom_feature_class(TargetIdiom.MatrixDot)).to_equal(TargetFeatureClass.Matrix)

    it "RotateLeft is classified as BitManip":
        step("Query idiom_feature_class for RotateLeft")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): idiom_feature_class(RotateLeft) result
        expect(idiom_feature_class(TargetIdiom.RotateLeft)).to_equal(TargetFeatureClass.BitManip)

    it "x86 v3 supports scalable-simd planning class":
        step("Derive caps for x86_64-v3 and query x86_supports_feature_class for ScalableSimd")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): x86_supports_feature_class(ScalableSimd) result for the v3 preset
        val caps = x86_caps_from_target("x86_64-v3")
        expect(x86_supports_feature_class(caps, TargetFeatureClass.ScalableSimd)).to_equal(true)

    it "aarch64 neon-only supports fixed-width simd but not scalable-simd":
        step("Derive caps for the plain aarch64 target triple and query both simd feature classes")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): aarch64_supports_feature_class results for FixedWidthSimd and ScalableSimd on a neon-only preset
        val caps = aarch64_caps_from_target("aarch64")
        expect(aarch64_supports_feature_class(caps, TargetFeatureClass.FixedWidthSimd)).to_equal(true)
        expect(aarch64_supports_feature_class(caps, TargetFeatureClass.ScalableSimd)).to_equal(false)

    it "rv64gcv supports matrix class when V is present":
        step("Derive caps for rv64gcv and query rv64_supports_feature_class for Matrix")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): rv64_supports_feature_class(Matrix) result when the V extension is present
        val caps = rv64_caps_from_target("rv64gcv")
        expect(rv64_supports_feature_class(caps, TargetFeatureClass.Matrix)).to_equal(true)

    it "rv64gc_zbb supports bitmanip class without V":
        step("Derive caps for rv64gc_zbb and query rv64_supports_feature_class for BitManip and Matrix")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): rv64_supports_feature_class results for BitManip and Matrix without the V extension
        val caps = rv64_caps_from_target("rv64gc_zbb")
        expect(rv64_supports_feature_class(caps, TargetFeatureClass.BitManip)).to_equal(true)
        expect(rv64_supports_feature_class(caps, TargetFeatureClass.Matrix)).to_equal(false)

# @manual_section: preferred lane count
describe "TargetCaps — preferred lane count helpers":
    it "x86 v3 prefers 8 lanes for f32":
        step("Derive caps for x86_64-v3 and query preferred_lane_count_x86 for 32-bit lanes")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): preferred_lane_count_x86(caps, 32) result for the avx2-capable v3 preset
        val caps = x86_caps_from_target("x86_64-v3")
        expect(preferred_lane_count_x86(caps, 32)).to_equal(8)  # oracle: 256-bit AVX2 vector / 32-bit f32 element = 8 lanes

    it "aarch64 neon prefers 4 lanes for f32":
        step("Derive caps for the plain aarch64 target triple and query preferred_lane_count_aarch64 for 32-bit lanes")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): preferred_lane_count_aarch64(caps, 32) result for a neon-only preset
        val caps = aarch64_caps_from_target("aarch64")
        expect(preferred_lane_count_aarch64(caps, 32)).to_equal(4)  # oracle: 128-bit NEON vector / 32-bit f32 element = 4 lanes

    it "rv64gcv_v256 prefers 8 lanes for f32":
        step("Derive caps for rv64gcv_v256 and query preferred_lane_count_rv64 for 32-bit lanes")
        # @req REQ-COMPILER-BACKEND-FEATURE-CAPS
        # @capture(bit_table): preferred_lane_count_rv64(caps, 32) result for a 256-bit VLEN preset
        val caps = rv64_caps_from_target("rv64gcv_v256")
        expect(preferred_lane_count_rv64(caps, 32)).to_equal(8)  # oracle: 256-bit VLEN / 32-bit f32 element = 8 lanes
