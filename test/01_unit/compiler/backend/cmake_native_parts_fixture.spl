use compiler.backend.cmake_gen.{generate_leaf_cmake, generate_intermediate_cmake, generate_root_cmake}

fn cmake_native_parts_controls_v1() -> text:
    val header = "# Auto-generated by Simple compiler -- DO NOT EDIT\n"
    val runtime = r"${RUNTIME_DIR}"
    val root = r"${SIMPLE_GENERATED_ROOT}"
    val list_dir = r"${CMAKE_CURRENT_LIST_DIR}"
    val binary_dir = r"${CMAKE_CURRENT_BINARY_DIR}"
    val empty: [text] = []
    val leaf_tail = ")\n\ntarget_include_directories(gen_demo PRIVATE\n    " + runtime + "\n    " + runtime + "/platform\n    " + root + "\n)\n"
    if generate_leaf_cmake("gen_demo", empty, empty) != header + "add_library(gen_demo OBJECT\n" + leaf_tail:
        return "empty leaf"
    val files: [text] = ["first.cpp", "second.cpp"]
    val children: [text] = ["child_a", "child_b"]
    val leaf_expected = header + "add_library(gen_demo OBJECT\n    first.cpp\n    second.cpp\n" + leaf_tail + "\nadd_subdirectory(child_a)\nadd_subdirectory(child_b)\n"
    if generate_leaf_cmake("gen_demo", files, children) != leaf_expected:
        return "ordered leaf with children"
    if generate_intermediate_cmake(empty) != header:
        return "empty intermediate"
    if generate_intermediate_cmake(children) != header + "add_subdirectory(child_a)\nadd_subdirectory(child_b)\n":
        return "ordered intermediate"
    val preamble = header + "# Include from the root CMakeLists.txt:\n#   include(<generated-dir>/generated_sources.cmake)\n\nset(SIMPLE_GENERATED_ROOT " + list_dir + ")\n\n"
    if generate_root_cmake(empty, empty, empty) != preamble + "\nset(GENERATED_ROOT_SOURCES\n)\n\nset(GENERATED_OBJECT_LIBS\n)\n":
        return "empty root"
    val dirs: [text] = ["compiler", "app"]
    val libs: [text] = ["gen_compiler", "gen_app"]
    val root_expected = preamble + "add_subdirectory(" + list_dir + "/compiler " + binary_dir + "/generated_compiler)\nadd_subdirectory(" + list_dir + "/app " + binary_dir + "/generated_app)\n\nset(GENERATED_ROOT_SOURCES\n    " + list_dir + "/first.cpp\n    " + list_dir + "/second.cpp\n)\n\nset(GENERATED_OBJECT_LIBS\n    gen_compiler\n    gen_app\n)\n"
    if generate_root_cmake(dirs, files, libs) != root_expected:
        return "ordered root and literal CMake variables"
    if files.len() != 2 or files[0] != "first.cpp" or files[1] != "second.cpp" or children.len() != 2 or children[0] != "child_a" or children[1] != "child_b":
        return "input arrays mutated"
    ""

export cmake_native_parts_controls_v1
