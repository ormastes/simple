use std.io_runtime.{file_read}
use std.spec.*

describe "native mutable arrays across intervening calls":
    it "owns an exact cross-module dual-backend fixture":
        val main = file_read(
            "test/fixtures/native_mut_slice_intervening_call/main.spl")
        val provider = file_read(
            "test/fixtures/native_mut_slice_intervening_call/provider.spl")
        val parity = file_read("scripts/check/check-native-seed-parity.shs")

        expect(main).to_contain("after_scalar(scalar_meta, scalar_pixels)")
        expect(main).to_contain(
            "after_aggregate(aggregate_meta, aggregate_pixels)")
        expect(main).to_contain(
            "native_mut_slice_intervening_call_status=pass")
        expect(provider).to_contain(
            "fn after_scalar(mut meta: [i64], mut pixels: [u8]):")
        expect(provider).to_contain(
            "fn after_aggregate(mut meta: [i64], mut pixels: [u8]) -> i64:")
        expect(provider).to_contain(
            "export leaf, after_scalar, after_aggregate")
        expect(parity).to_contain(
            "run_strict_dual_backend_case mut_slice_intervening_call")
