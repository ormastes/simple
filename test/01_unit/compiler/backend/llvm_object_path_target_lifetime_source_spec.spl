# Regression for the self-hosted LLVM object-path target lifetime boundary.

# @workaround bug=BUG-PHASE1-BDD-NEGATED-MATCHERS-20261011 reason=cached producer lacks negated matcher links; retain exact negative containment predicate.
use std.io_runtime.{file_read}
use std.spec.{describe, it, expect}
use std.spec.step

describe "LLVM object-path target lifetime":
    it "renders the llc triple in the consuming frame":
        step("keep constructed target text out of a callee-return boundary")
        val full_source = file_read(
            "src/compiler/70.backend/backend/llvm_backend_tools.spl")
        val owner_start = full_source.index_of("pub fn compile_ir_to_object_path(")
        val owner_end = full_source.index_of("fn llvm_target_flags(")
        expect(owner_start).to_be_greater_than(-1)
        expect(owner_end).to_be_greater_than(owner_start)
        val source = full_source.substring(owner_start, owner_end)
        expect(source).to_contain(
            "var frozen_target_triple = (\n        \"{{config.triple.arch}}-{{config.triple.vendor}}-{{config.triple.os}}\")")
        expect(source).to_contain(
            "args.push(\"-mtriple={{frozen_target_triple}}\")")
        expect(source.contains(
            "val triple = config.triple.to_text()\n    var cpu = config.to_cpu_string()")).to_equal(false)
