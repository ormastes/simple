# @req KPM-REQ-004 KPM-REQ-007 KPM-REQ-009 KPM-REQ-010 KPM-NFR-002
use common.plugin.iface_id.{IfaceId}
use compiler.backend.backend_port.{BACKEND_PORT_IFACE_MAJOR, BACKEND_PORT_IFACE_DIGEST, BackendPortV1, backend_port_host_iface, backend_port_iface_digest_v1, backend_plugin_from_port_v1}
use compiler.backend.backend.backend_types.{BackendKind}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.backend.backend.static_backend_registry.{
    BackendLinkClass, StaticBackendEntryV1, static_backend_table_v1, select_static_backend_v1,
    negotiate_static_backend_entry_v1
}
use compiler.backend.backend.static_backend_cranelift_port.{cranelift_backend_port_v1}
use compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use plugins.backend_registry.full_static_backend_registry.{
    full_static_backend_table_for_k1_policy_v1,
    install_full_static_backends_for_k1_policy_v1}

fn selected_full_table_v1() -> [StaticBackendEntryV1]:
    val policy = selected_k1_backend_policy_v1()
    expect(install_selected_k1_backend_table_v1()).to_equal(true)
    expect(install_full_static_backends_for_k1_policy_v1(policy)).to_equal(true)
    full_static_backend_table_for_k1_policy_v1(policy)

describe "BackendPortV1 static negotiation":
    it "negotiates every deterministic table entry":
        val table = selected_full_table_v1()
        expect(table.len()).to_equal(16)
        for entry in table:
            val name = entry.kind.to_text()
            val selected = select_static_backend_v1(name, table)
            expect(selected.is_ok()).to_equal(true)
            expect(selected.unwrap().plugin.describe().name).to_equal(name)
            expect(selected.unwrap().plugin.describe().cache_id).to_equal(name)

    it "uses exact BackendKind names including c and native":
        val table = selected_full_table_v1()
        expect(select_static_backend_v1(BackendKind.CCodegen.to_text(), table).unwrap().plugin.describe().name).to_equal("c")
        expect(select_static_backend_v1(BackendKind.Native.to_text(), table).unwrap().plugin.describe().name).to_equal("native")
        expect(select_static_backend_v1(BackendKind.LlvmLib.to_text(), table).unwrap().plugin.describe().name).to_equal("llvm-lib")

    it "recomputes the stable domain-framed ABI digest":
        expect(backend_port_iface_digest_v1()).to_equal(BACKEND_PORT_IFACE_DIGEST)

    it "uses only the K1 entries admitted by the committed composition":
        expect(install_selected_k1_backend_table_v1()).to_equal(true)
        val table = static_backend_table_v1()
        expect(select_static_backend_v1("cranelift", table).unwrap().link_class).to_equal(BackendLinkClass.KernelLinked)
        expect(select_static_backend_v1("interpreter", table).unwrap().link_class).to_equal(BackendLinkClass.KernelLinked)
        val llvm = select_static_backend_v1("llvm", table)
        expect(llvm.is_ok()).to_equal(true)

    it "classifies non-bootstrap Wasm as P-static without renaming its cache id":
        val wasm = select_static_backend_v1("wasm", selected_full_table_v1()).unwrap()
        expect(wasm.link_class).to_equal(BackendLinkClass.PluginStatic)
        expect(wasm.plugin.describe().name).to_equal("wasm")
        expect(wasm.plugin.describe().cache_id).to_equal("wasm")

    it "rejects a major mismatch with PLUG-E-MAJOR":
        val base = cranelift_backend_port_v1()
        val bad_port = BackendPortV1(base.hdr,
            IfaceId(base.iface.name, BACKEND_PORT_IFACE_MAJOR + 1,
                base.iface.minor, base.iface.abi_digest),
            base.describe_fn, base.run_fn, base.supports_fn, base.ext)
        val fixture = StaticBackendEntryV1(BackendKind.Cranelift,
            BackendLinkClass.KernelLinked, backend_plugin_from_port_v1(bad_port),
            CodegenOutputKind.ObjectCode)
        val verdict = negotiate_static_backend_entry_v1(backend_port_host_iface(), fixture)
        expect(verdict.is_err()).to_equal(true)
        expect(verdict.unwrap_err().code()).to_equal("PLUG-E-MAJOR")

    it "fails closed for an unknown user-visible backend name":
        val verdict = select_static_backend_v1("missing")
        expect(verdict.is_err()).to_equal(true)
        expect(verdict.unwrap_err().code()).to_equal("PLUG-E-NOTFOUND")
