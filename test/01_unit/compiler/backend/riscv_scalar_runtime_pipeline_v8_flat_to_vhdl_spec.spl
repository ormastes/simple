use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v8_flat.{strict_riscv_scalar_runtime_pipeline_v8_flat_direct}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v8_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v8_flat, scalar_runtime_pipeline_v8_flat_driver_closure_diagnostic, scalar_runtime_pipeline_v8_flat_aggregate_child_entity_diagnostic, scalar_runtime_pipeline_v8_flat_route_receipt}

fn rv64_zmmul_zicsr() -> CoreConfig:
    CoreConfig(xlen: 64, physical_address_bits: 56, register_count: 32,
        profile: "riscv-gen2-rv64-zmmul-zicsr", isa_profile: "rv64i_zmmul_zicsr_zifencei",
        compressed_decode_profile: "none")

describe "strict flattened runtime scalar pipeline v8 VHDL emission":
    it "renders the closed dynamic-M and CSR direct graph with receipt and child hashes":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v8_flat_direct("runtime_pipeline_v8_rv64", rv64_zmmul_zicsr(), LsuConfig.rv64_product_default()).unwrap()
        expect(scalar_runtime_pipeline_v8_flat_driver_closure_diagnostic(pipeline)).to_equal("")
        val result = compile_strict_riscv_scalar_runtime_pipeline_v8_flat("runtime_pipeline_v8_rv64", rv64_zmmul_zicsr(), LsuConfig.rv64_product_default())
        expect(result.is_success()).to_equal(true)
        if result.is_success():
            expect(result.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v8-flat-direct")
            expect(result.hwir_graph_sha256).to_equal(pipeline.structural_sha256())
            expect(result.vhdl).to_contain("-- simple-hwir v8-flat-route-receipt=" + scalar_runtime_pipeline_v8_flat_route_receipt(pipeline))
            expect(result.vhdl).to_contain("-- simple-hwir child-csr=" + pipeline.csr.structural_sha256())
            expect(result.vhdl).to_contain("csr: entity work." + pipeline.csr.entity_name)
            expect(result.vhdl).to_contain("wire_o3_csr_p13_request_valid <= source_o7_pending_p17_csr_request_valid")
            expect(result.vhdl).to_contain("csr_commit_value : out std_logic_vector(63 downto 0)")

    it "retains the V8 route when canonical construction rejects input":
        val result = compile_strict_riscv_scalar_runtime_pipeline_v8_flat("", CoreConfig.rv32im(), LsuConfig.rv32_product_default())
        expect(result.is_success()).to_equal(false)
        expect(result.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v8-flat-direct")
        expect(result.diagnostic).to_contain("HWIR-E-RISCV-RUNTIME-PIPELINE-V8-ID")

    it "rejects case-insensitive aggregate entity collisions with different graphs":
        expect(scalar_runtime_pipeline_v8_flat_aggregate_child_entity_diagnostic(
            ["provider_rtl", "PROVIDER_RTL"], ["graph-a", "graph-b"])).to_equal(
            "HWIR-E-RISCV-RUNTIME-PIPELINE-V8-FLAT-VHDL-ENTITY-COLLISION: one case-insensitive child entity name requires one exact graph")
        expect(scalar_runtime_pipeline_v8_flat_aggregate_child_entity_diagnostic(
            ["provider_rtl", "PROVIDER_RTL"], ["graph-a", "graph-a"])).to_equal("")
