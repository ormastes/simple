        product.riscv_capability_sha256 = vhdl_gen2_capability_sha256(
            product.riscv_admitted_instruction_ids).unwrap()
        product.hwir_aspect_lock_sha256 = hwir_aspect_lock_sha256(HwAspectLock(entries: [])).unwrap()
        product.generated_items = [VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
            name: entity, location: artifact_port_location())]
        expect(vhdl_validate_production_artifact_input(product).is_ok()).to_equal(true)
        product.profile = "riscv-gen2-rv32-zca-critical"
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance requires the concrete critical XLEN/profile closure")

