            CoreConfig.rv32_zca_cjal_mission_critical()).hwir_graph_sha256
        product.target = "riscv32"
        product.xlen = 32
        product.profile = module.config.profile
        product.riscv_isa_profile = module.config.isa_profile
        product.riscv_compressed_decode_profile = module.config.compressed_decode_profile
        product.riscv_capability_scope = "frontend-predecode-only"
