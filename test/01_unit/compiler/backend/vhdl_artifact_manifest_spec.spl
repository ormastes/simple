"""
## Purpose and audience
Purpose: Prove that VHDL production artifact manifest.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-BACKEND-001 — stable requirement identity for this spec.

use std.spec
use compiler.driver.driver_vhdl_artifacts.{
    VhdlArtifactSource, VhdlArtifactLocation, VhdlArtifactGeneratedItem,
    VhdlArtifactPort, VhdlArtifactAspect, VhdlArtifactInput,
    vhdl_artifact_assurance_policy_snapshot,
    vhdl_render_production_artifacts,
    vhdl_write_production_artifacts,
    vhdl_artifact_target_for_entity,
    vhdl_gen2_capability_ids, vhdl_gen2_capability_sha256,
    vhdl_validate_production_artifact_input
}
use compiler.mir.hwir.aspects.{HwAspectLock, HwAspectLockEntry, hwir_aspect_lock_sha256}
use compiler.mir.hwir.types.{CoreConfig, HwPort}
use compiler.mir.hwir.stateful_frontend.{strict_zca_single_outstanding_frontend_hwir, strict_zca_trap_single_outstanding_frontend_hwir}
use compiler.mir.hwir.frontend.{strict_zca_rv32_cjal_migrating_predecode_hwir, strict_zca_rv64_addiw_migrating_predecode_hwir}
use compiler.backend.backend.hwir_to_vhdl.{compile_strict_zca_single_outstanding_frontend_product, compile_strict_zca_trap_single_outstanding_frontend_product}
use compiler.common.assurance.policy.{policy_for_profile_name}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create(path: text, recursive: bool) -> bool
extern fn rt_dir_remove_all(path: text) -> bool

fn artifact_sha() -> text:
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn artifact_non_hex_sha() -> text:
    "gggggggg" + "gggggggg" + "gggggggg" + "gggggggg" +
        "gggggggg" + "gggggggg" + "gggggggg" + "gggggggg"

fn artifact_location() -> VhdlArtifactLocation:
    VhdlArtifactLocation(available: true, module_name: "hardware.rv32.entry",
        file: "src/lib/hardware/rv32i_rtl/protected_entry.spl",
        start: 100, end: 140, line: 8, col: 1)

fn artifact_port_location() -> VhdlArtifactLocation:
    VhdlArtifactLocation(available: false, module_name: "", file: "",
        start: 0, end: 0, line: 0, col: 0)

fn artifact_gen2_ports(entity: text) -> [VhdlArtifactPort]:
    val config = CoreConfig.rv32_zca_mission_critical()
    var typed_ports: [HwPort] = []
    if entity == "riscv_gen2_zca_trap_single_outstanding_frontend_rv32":
        typed_ports = strict_zca_trap_single_outstanding_frontend_hwir(entity, config).unwrap().frontend_contract.ports()
    elif entity == "riscv_gen2_zca_rv32_cjal_trap_single_outstanding_frontend":
        typed_ports = strict_zca_trap_single_outstanding_frontend_hwir(entity,
            CoreConfig.rv32_zca_cjal_mission_critical()).unwrap().frontend_contract.ports()
    elif entity == "riscv_gen2_zca_rv64_addiw_trap_single_outstanding_frontend":
        typed_ports = strict_zca_trap_single_outstanding_frontend_hwir(entity,
            CoreConfig.rv64_zca_addiw_mission_critical()).unwrap().frontend_contract.ports()
    elif entity == "riscv_gen2_zca_rv32_cjal_migrating_predecode":
        typed_ports = strict_zca_rv32_cjal_migrating_predecode_hwir(entity,
            CoreConfig.rv32_zca_cjal_mission_critical()).unwrap().ports
    elif entity == "riscv_gen2_zca_rv64_addiw_migrating_predecode":
        typed_ports = strict_zca_rv64_addiw_migrating_predecode_hwir(entity,
            CoreConfig.rv64_zca_addiw_mission_critical()).unwrap().ports
    elif entity == "riscv_gen2_zca_rv32_cjal_single_outstanding_frontend":
        typed_ports = strict_zca_single_outstanding_frontend_hwir(entity,
            CoreConfig.rv32_zca_cjal_mission_critical()).unwrap().frontend_contract.ports()
    elif entity == "riscv_gen2_zca_rv64_addiw_single_outstanding_frontend":
        typed_ports = strict_zca_single_outstanding_frontend_hwir(entity,
            CoreConfig.rv64_zca_addiw_mission_critical()).unwrap().frontend_contract.ports()
    else:
        typed_ports = strict_zca_single_outstanding_frontend_hwir(entity, config).unwrap().frontend_contract.ports()
    var ports: [VhdlArtifactPort] = []
    var index = 0
    for port in typed_ports:
        ports.push(VhdlArtifactPort(entity: entity, name: port.name,
            direction: port.direction, type_name: port.type_name,
            bit_width: port.bit_width as i64, index: index,
            location: artifact_port_location()))
        index = index + 1
    ports

fn artifact_input(sources: [VhdlArtifactSource], ports: [VhdlArtifactPort], output: text) -> VhdlArtifactInput:
    VhdlArtifactInput(output_path: output,
        entry_module: "hardware.rv32.entry",
        entry_entity: "core32_protected_product_entry",
        root_modules: ["hardware.rv32.entry"], sources: sources,
        compiler_identity: "compiler-id", compiler_hash: artifact_sha(),
        target: "riscv32", xlen: 32, profile: "RV32IMAC+Sv32+PMP",
        catalog_name: "simple_vhdl_design", module_count: 2,
        entity_count: 1, type_count: 3, helper_count: 4,
        generation_route: "legacy-vhdl", hwir_module_node_id: "",
        hwir_config_profile: "", hwir_graph_sha256: "",
        riscv_isa_profile: "", riscv_compressed_decode_profile: "",
        riscv_capability_scope: "", riscv_admitted_instruction_ids: [], riscv_capability_sha256: "",
        riscv_target_evidence_complete: false,
        hwir_aspect_lock_sha256: "", hwir_aspects: [],
        generated_items: [VhdlArtifactGeneratedItem(kind: "entity",
            name: "core32_protected_product_entry", location: artifact_location())],
        ports: ports, aop_advices_requested: 0, aop_weave_count: 0)

fn artifact_trap_gen2_input(output: text) -> VhdlArtifactInput:
    val entity = "riscv_gen2_zca_trap_single_outstanding_frontend_rv32"
    var product = artifact_input([], artifact_gen2_ports(entity), output)
    product.entry_module = "compiler-product:riscv-gen2-zca-trap-single-outstanding-v3"
    product.entry_entity = entity
    product.root_modules = [product.entry_module]
    product.catalog_name = product.entry_module
    product.generation_route = "hwir-gen2-trap-stateful-product-v3"
    product.hwir_module_node_id = entity + ":module"
    product.hwir_config_profile = "riscv-gen2-rv32-zca-critical"
    product.hwir_graph_sha256 = compile_strict_zca_trap_single_outstanding_frontend_product(
        CoreConfig.rv32_zca_mission_critical()).hwir_graph_sha256
    product.target = "riscv32"
    product.xlen = 32
    product.profile = "riscv-gen2-rv32-zca-critical"
    product.riscv_isa_profile = "rv32i"
    product.riscv_compressed_decode_profile = "zca-common-critical"
    product.riscv_capability_scope = "frontend-predecode-only"
    product.riscv_admitted_instruction_ids = vhdl_gen2_capability_ids(
        product.generation_route, entity).unwrap()
    product.riscv_capability_sha256 = vhdl_gen2_capability_sha256(
        product.riscv_admitted_instruction_ids).unwrap()
    product.assurance_policy = vhdl_artifact_assurance_policy_snapshot(
        policy_for_profile_name("critical"))
    product.hwir_aspect_lock_sha256 = hwir_aspect_lock_sha256(HwAspectLock(entries: [])).unwrap()
    product.module_count = 2
    product.entity_count = 2
    product.generated_items = [VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
        name: entity, location: artifact_port_location()),
        VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
            name: "riscv_gen2_zca_trap_migrating_predecode_rv32", location: artifact_port_location())]
    product

describe "VHDL production artifact manifest":
    it "rejects case-only Gen2 port identity collisions":
        step("Verify: rejects case-only Gen2 port identity collisions")
        # @req: REQ-COMPILER-BACKEND-001
        var product = artifact_trap_gen2_input("build/casefold-port.vhd")
        var colliding = product.ports[1]
        colliding.name = product.ports[0].name.upper()
        product.ports[1] = colliding
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance requires unique non-negative entry port identities")

    it "routes every artifact writer error to CompileResult failure":
        step("Verify: routes every artifact writer error to CompileResult failure")
        val source = rt_file_read_text(
            "src/compiler/80.driver/driver_aot_vhdl_output.spl") ?? ""
        expect(source).to_contain("if not vhdl_remove_production_artifacts(output)")
        expect(source).to_contain("match vhdl_write_production_artifacts(output, all_vhdl, rendered)")
        expect(source).to_contain("case Err(err):")
        expect(source).to_contain("return CompileResult.CodegenError(err)")

    it "preserves a prior Gen2 bundle until the authorized receipt write boundary":
        step("Verify: preserves a prior Gen2 bundle until the authorized receipt write boundary")
        val source = rt_file_read_text(
            "src/compiler/80.driver/driver_riscv_gen2_product.spl") ?? ""
        # The compiler-product driver may remove a bundle only inside the
        # receipt writer, after strict lowering, graph reconstruction, and
        # provenance authorization all succeeded. There are four cleanup calls:
        # one initial write boundary plus the three partial-write recovery paths.
        expect(source.split("vhdl_remove_production_artifacts(output)").len()).to_equal(5)
        expect(source).to_contain("fn gen2_write_authorized_vhdl_artifact_emission(")
        expect(source).to_contain("val emitted = compile_strict_zca_control_predecode_product(config)")
        expect(source).to_contain("val emitted = compile_strict_zca_trap_single_outstanding_frontend_product(config)")

    it "pins the production RISC-V target profiles":
        step("Verify: pins the production RISC-V target profiles")
        val rv32 = vhdl_artifact_target_for_entity("core32_protected_product_entry", "dev")
        val rv64 = vhdl_artifact_target_for_entity("core64_imac_product_entry", "dev")
        expect(rv32.name).to_equal("riscv32")
        expect(rv32.xlen).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(rv32.profile).to_equal("RV32IMAC+Sv32+PMP")
        expect(rv64.name).to_equal("riscv64")
        expect(rv64.xlen).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(rv64.profile).to_equal("RV64IMAC+Sv39+PMP")

    it "is deterministic and retains exact source and flat-port provenance":
        step("Verify: is deterministic and retains exact source and flat-port provenance")
        val a = VhdlArtifactSource(module_name: "hardware.rv32.entry",
            path: "entry.spl", content_hash: artifact_sha())
        val b = VhdlArtifactSource(module_name: "hardware.rv32.core",
            path: "core.spl", content_hash: artifact_sha())
        val p0 = VhdlArtifactPort(entity: "core32_protected_product_entry",
            name: "clk", direction: "in", type_name: "std_logic", bit_width: 0, index: 0,
            location: artifact_port_location())
        val p1 = VhdlArtifactPort(entity: "core32_protected_product_entry",
            name: "bus_addr", direction: "out", type_name: "unsigned(33 downto 0)",
            bit_width: 0, index: 1, location: artifact_port_location())
        val first = vhdl_render_production_artifacts(
            artifact_input([a, b], [p1, p0], "build/core32.vhd"), "entity rtl is\n")
        val second = vhdl_render_production_artifacts(
            artifact_input([b, a], [p0, p1], "build/core32.vhd"), "entity rtl is\n")
        expect(first.manifest).to_equal(second.manifest)
        expect(first.source_map).to_equal(second.source_map)
        expect(first.manifest).to_contain("\"qualification\":{\"status\":\"FAIL\"")
        expect(first.manifest).to_contain("\"riscv\":{\"isa_profile\":\"\",\"compressed_decode_profile\":\"\",\"implementation_scope\":\"\",\"implemented_instruction_ids\":[],\"capability_sha256\":\"\",\"target_evidence_complete\":false}")
        expect(first.manifest).to_contain("\"source_closure_sha256\"")
        expect(first.manifest).to_contain("\"name\":\"bus_addr\",\"direction\":\"out\"")
        expect(first.source_map).to_contain("\"file\":\"src/lib/hardware/rv32i_rtl/protected_entry.spl\"")
        expect(first.source_map).to_contain("\"line\":8")
        expect(first.source_map).to_contain("\"name\":\"clk\",\"direction\":\"in\",\"type\":\"std_logic\",\"bit_width\":0,\"source\":null")
        expect(vhdl_validate_production_artifact_input(
            artifact_input([a, b], [p0, p1], "build/core32.vhd")).is_ok()).to_equal(true)

    it "records typed HWIR aspect-lock provenance independently of legacy AOP counts":
        step("Verify: records typed HWIR aspect-lock provenance independently of legacy AOP counts")
        val source = VhdlArtifactSource(module_name: "hardware.rv32.entry",
            path: "entry.spl", content_hash: artifact_sha())
        val port = VhdlArtifactPort(entity: "core32_protected_product_entry",
            name: "result_out", direction: "out", type_name: "Bits[1]", bit_width: 0, index: 0,
            location: artifact_port_location())
        var input = artifact_input([source], [port], "build/aspect.vhd")
        input.hwir_aspects = [VhdlArtifactAspect(id: "debug.rvfi", version: "1.0.0",
            content_hash: artifact_sha())]
        input.hwir_aspect_lock_sha256 = hwir_aspect_lock_sha256(HwAspectLock(entries: [
            HwAspectLockEntry(id: "debug.rvfi", version: "1.0.0",
                content_hash: artifact_sha())])).unwrap()
        expect(vhdl_validate_production_artifact_input(input).is_ok()).to_equal(true)
        val rendered = vhdl_render_production_artifacts(input, "entity rtl is\n")
        expect(rendered.manifest).to_contain("\"hwir_aspects\":{\"lock_sha256\":\"" + artifact_sha() + "\"")
        expect(rendered.manifest).to_contain("\"id\":\"debug.rvfi\",\"version\":\"1.0.0\",\"sha256\":\"" + artifact_sha() + "\"")
        input.hwir_aspects = [VhdlArtifactAspect(id: "debug.rvfi", version: "1.0.0",
            content_hash: artifact_sha()), VhdlArtifactAspect(id: "debug.rvfi",
            version: "1.0.1", content_hash: artifact_sha())]
        expect(vhdl_validate_production_artifact_input(input).unwrap_err()).to_equal("VHDL artifact aspect provenance requires unique ID/version/SHA-256 identities")

    it "rejects missing compiler and source hashes":
        step("Verify: rejects missing compiler and source hashes")
        val source = VhdlArtifactSource(module_name: "hardware.rv32.entry",
            path: "entry.spl", content_hash: "")
        val input = artifact_input([source], [], "build/core32.vhd")
        expect(vhdl_validate_production_artifact_input(input).is_err()).to_equal(true)

    it "rejects syntactically forged SHA-256 provenance identities":
        step("Verify: rejects syntactically forged SHA-256 provenance identities")
        val source = VhdlArtifactSource(module_name: "hardware.rv32.entry",
            path: "entry.spl", content_hash: artifact_sha())
        val port = VhdlArtifactPort(entity: "core32_protected_product_entry",
            name: "result_out", direction: "out", type_name: "Bits[1]", bit_width: 0, index: 0,
            location: artifact_port_location())
        var input = artifact_input([source], [port], "build/digest.vhd")
        input.compiler_hash = artifact_non_hex_sha()
        expect(vhdl_validate_production_artifact_input(input).unwrap_err()).to_equal(
            "VHDL artifact provenance requires compiler identity and SHA-256")
        input.compiler_hash = artifact_sha()
        input.generation_route = "hwir-strict"
        input.hwir_module_node_id = "critical_and:module"
        input.hwir_config_profile = "riscv-gen2-rv32-zca-critical"
        input.hwir_graph_sha256 = artifact_non_hex_sha()
        expect(vhdl_validate_production_artifact_input(input).unwrap_err()).to_equal(
            "VHDL strict-HWIR provenance requires a canonical HWIR graph SHA-256")
        input.generation_route = "legacy-vhdl"
        input.hwir_graph_sha256 = ""
        input.sources[0].content_hash = artifact_non_hex_sha()
        expect(vhdl_validate_production_artifact_input(input).unwrap_err()).to_equal(
            "VHDL artifact source closure contains incomplete provenance")

    it "requires concrete HWIR provenance for strict source emission":
        step("Verify: requires concrete HWIR provenance for strict source emission")
        val source = VhdlArtifactSource(module_name: "hardware.rv32.entry",
            path: "entry.spl", content_hash: artifact_sha())
        val port = VhdlArtifactPort(entity: "core32_protected_product_entry",
            name: "result_out", direction: "out", type_name: "Bits[1]", bit_width: 0, index: 0,
            location: artifact_port_location())
        var strict = artifact_input([source], [port], "build/strict.vhd")
        strict.generation_route = "hwir-strict"
        expect(vhdl_validate_production_artifact_input(strict).is_err()).to_equal(true)
        strict.hwir_module_node_id = "critical_and:module"
        strict.hwir_config_profile = "riscv-gen2-rv32-zca-critical"
        strict.hwir_graph_sha256 = artifact_sha()
        expect(vhdl_validate_production_artifact_input(strict).is_ok()).to_equal(true)
        val rendered = vhdl_render_production_artifacts(strict, "entity strict is\n")
        expect(rendered.manifest).to_contain("\"generation_route\":\"hwir-strict\"")
        expect(rendered.manifest).to_contain("\"module_node_id\":\"critical_and:module\"")
        expect(rendered.manifest).to_contain("\"graph_sha256\":\"" + artifact_sha() + "\"")

    it "requires graph-bound provenance for typed stateful compiler products":
        step("Verify: requires graph-bound provenance for typed stateful compiler products")
        val port = VhdlArtifactPort(entity: "core32_protected_product_entry",
            name: "result_out", direction: "out", type_name: "Bits[1]", bit_width: 0, index: 0,
            location: artifact_port_location())
        var product = artifact_input([], [port], "build/stateful.vhd")
        product.generation_route = "hwir-gen2-stateful-product-v2"
        product.hwir_module_node_id = "stateful:module"
        product.hwir_config_profile = "riscv-gen2-rv32-zca-critical"
        product.riscv_isa_profile = "rv32i"
        product.riscv_compressed_decode_profile = "zca-common-critical"
        expect(vhdl_validate_production_artifact_input(product).is_err()).to_equal(true)
        product.hwir_graph_sha256 = artifact_sha()
        product.hwir_aspect_lock_sha256 = hwir_aspect_lock_sha256(
            HwAspectLock(entries: [])).unwrap()
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance route does not admit the claimed entry entity")
        product.entry_module = "compiler-product:riscv-gen2-zca-trap-single-outstanding-v3"
        product.entry_entity = "riscv_gen2_zca_trap_single_outstanding_frontend_rv32"
        product.generation_route = "hwir-gen2-trap-stateful-product-v3"
        product.root_modules = [product.entry_module]
        product.hwir_module_node_id = product.entry_entity + ":module"
        product.catalog_name = product.entry_module
        product.module_count = 2
        product.entity_count = 2
        product.generated_items = [VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
            name: product.entry_entity, location: artifact_port_location()),
            VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
            name: "riscv_gen2_zca_trap_migrating_predecode_rv32", location: artifact_port_location())]
        product.ports = artifact_gen2_ports(product.entry_entity)
        product.riscv_capability_scope = "frontend-predecode-only"
        product.riscv_admitted_instruction_ids = vhdl_gen2_capability_ids(
            product.generation_route, product.entry_entity).unwrap()
        product.riscv_capability_sha256 = vhdl_gen2_capability_sha256(
            product.riscv_admitted_instruction_ids).unwrap()
        product.hwir_graph_sha256 = compile_strict_zca_trap_single_outstanding_frontend_product(
            CoreConfig.rv32_zca_mission_critical()).hwir_graph_sha256
        expect(vhdl_validate_production_artifact_input(product).is_ok()).to_equal(true)
        product.hwir_graph_sha256 = artifact_sha()
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance graph SHA-256 does not match the canonical HWIR closure")
        product.hwir_graph_sha256 = compile_strict_zca_trap_single_outstanding_frontend_product(
            CoreConfig.rv32_zca_mission_critical()).hwir_graph_sha256
        product.riscv_capability_scope = "full-rv32i-core"
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance must declare its frontend-only implementation scope")
        product.riscv_capability_scope = "frontend-predecode-only"
        product.riscv_admitted_instruction_ids = []
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance capability set does not match the selected product")
        product.riscv_admitted_instruction_ids = vhdl_gen2_capability_ids(
            product.generation_route, product.entry_entity).unwrap()
        product.riscv_capability_sha256 = artifact_sha()
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance capability SHA-256 does not match the selected product")
        product.riscv_capability_sha256 = vhdl_gen2_capability_sha256(
            product.riscv_admitted_instruction_ids).unwrap()
        product.generated_items[1] = VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
            name: "riscv_gen2_zca_migrating_predecode_rv32", location: artifact_port_location())
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 stateful product provenance decoder dependency does not match the selected route")
        product.generated_items[1] = VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
            name: "riscv_gen2_zca_trap_migrating_predecode_rv32", location: artifact_port_location())
        product.entry_module = "compiler-product:riscv-gen2-zca-trap-single-outstanding-v2"
        product.root_modules = [product.entry_module]
        product.catalog_name = product.entry_module
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 stateful product provenance requires the current versioned compiler product identity")
        product.entry_module = "compiler-product:riscv-gen2-zca-trap-single-outstanding-v3"
        product.root_modules = [product.entry_module]
        product.catalog_name = product.entry_module
        product.aop_advices_requested = 1
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance forbids legacy AOP requests and weaves")
        product.aop_advices_requested = 0
        product.aop_weave_count = 1
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance forbids legacy AOP requests and weaves")
        product.aop_weave_count = 0
        var forged_port = product.ports[0]
        forged_port.bit_width = 2
        product.ports[0] = forged_port
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance ports do not match the typed HWIR contract")
        product.ports = artifact_gen2_ports(product.entry_entity)
        product.hwir_module_node_id = "forged:module"
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance requires the canonical entry module node")
        product.hwir_module_node_id = product.entry_entity + ":module"
        product.generation_route = "hwir-gen2-stateful-product-v2"
        product.entry_entity = "riscv_gen2_zca_single_outstanding_frontend_rv32"
        product.hwir_module_node_id = product.entry_entity + ":module"
        product.generated_items[0] = VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
            name: product.entry_entity, location: artifact_port_location())
        product.generated_items[1] = VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
            name: "riscv_gen2_zca_migrating_predecode_rv32", location: artifact_port_location())
        product.ports = artifact_gen2_ports(product.entry_entity)
        product.riscv_admitted_instruction_ids = vhdl_gen2_capability_ids(
            product.generation_route, product.entry_entity).unwrap()
        product.riscv_capability_sha256 = vhdl_gen2_capability_sha256(
            product.riscv_admitted_instruction_ids).unwrap()
        product.hwir_graph_sha256 = compile_strict_zca_single_outstanding_frontend_product(
            CoreConfig.rv32_zca_mission_critical()).hwir_graph_sha256
        expect(vhdl_validate_production_artifact_input(product).is_ok()).to_equal(true)
        product.generation_route = "hwir-gen2-trap-stateful-product-v3"
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 product provenance route does not admit the claimed entry entity")
        product.generation_route = "hwir-gen2-stateful-product-v2-untrusted"
        expect(vhdl_validate_production_artifact_input(product).is_err()).to_equal(true)

    it "accepts the RV32-only C.JAL product only with its frozen profile and capability closure":
        step("Verify: accepts the RV32-only C.JAL product only with its frozen profile and capability closure")
