        product.entry_module = "compiler-product:riscv-gen2-zca-rv32-cjal-single-outstanding-v2"
        product.entry_entity = entity
        product.root_modules = [product.entry_module]
        product.catalog_name = product.entry_module
        product.generation_route = "hwir-gen2-stateful-product-v2"
        product.hwir_module_node_id = entity + ":module"
