        product.hwir_aspect_lock_sha256 = hwir_aspect_lock_sha256(HwAspectLock(entries: [])).unwrap()
        product.module_count = 2
        product.entity_count = 2
        product.generated_items = [VhdlArtifactGeneratedItem(kind: "compiler_product_entity",
            name: entity, location: artifact_port_location()),
            VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
                name: module.decoder_entity, location: artifact_port_location())]
        expect(product.riscv_admitted_instruction_ids.len()).to_equal(26)  # oracle: 26 — named expected value from the requirement
        expect(vhdl_validate_production_artifact_input(product).is_ok()).to_equal(true)
        product.entry_module = "riscv_gen2_zca_rv32_cjal_trap_migrating_predecode"
        product.root_modules = [product.entry_module]
        product.catalog_name = product.entry_module
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 stateful product provenance requires the current versioned compiler product identity")
        product.entry_module = "compiler-product:riscv-gen2-zca-trap-single-outstanding-v3"
        product.root_modules = [product.entry_module]
        product.catalog_name = product.entry_module
        product.generated_items[1] = VhdlArtifactGeneratedItem(kind: "compiler_product_dependency",
            name: "riscv_gen2_zca_trap_migrating_predecode_rv32", location: artifact_port_location())
        expect(vhdl_validate_production_artifact_input(product).unwrap_err()).to_equal(
            "VHDL Gen2 stateful product provenance decoder dependency does not match the selected route")

    it "removes the VHDL when a sidecar write fails":
        step("Verify: removes the VHDL when a sidecar write fails")
        val root = "build/vhdl_artifact_write_failure_contract"
        rt_dir_remove_all(root)
        expect(rt_dir_create(root, true)).to_equal(true)
        val output = root + "/core.vhd"
        # A directory at the map path deterministically rejects the map write.
        expect(rt_dir_create(output + ".map.json", true)).to_equal(true)
        val rendered = vhdl_render_production_artifacts(
            artifact_input([], [], output), "entity core is\n")
        val result = vhdl_write_production_artifacts(output, "entity core is\n", rendered)
        expect(result.is_err()).to_equal(true)
        expect(rt_file_exists(output)).to_equal(false)
        expect(rt_file_exists(output + ".gen.json")).to_equal(false)
        rt_dir_remove_all(root)

    it "rejects forged raw Gen2 text and preserves stale artifacts without an exported special writer":
        step("Verify: rejects forged raw Gen2 text and preserves stale artifacts without an exported special writer")
        val root = "build/vhdl_artifact_gen2_writer_boundary"
        rt_dir_remove_all(root)
        expect(rt_dir_create(root, true)).to_equal(true)
        val output = root + "/gen2.vhd"
        expect(rt_file_write_text(output, "known-vhdl")).to_equal(true)
        expect(rt_file_write_text(output + ".map.json", "known-map")).to_equal(true)
        expect(rt_file_write_text(output + ".gen.json", "known-manifest")).to_equal(true)
        val product = artifact_trap_gen2_input(output)
        expect(vhdl_validate_production_artifact_input(product).is_ok()).to_equal(true)
        val rendered = vhdl_render_production_artifacts(product, "entity gen2 is\n")
        expect(vhdl_write_production_artifacts(output, "entity gen2 is\n", rendered).unwrap_err()).to_equal(
            "VHDL raw artifact writer refuses compiler-owned RISC-V Gen2 routes")
        expect(rt_file_read_text(output).unwrap()).to_equal("known-vhdl")
        expect(rt_file_read_text(output + ".map.json").unwrap()).to_equal("known-map")
        expect(rt_file_read_text(output + ".gen.json").unwrap()).to_equal("known-manifest")
        val legacy_rendered = vhdl_render_production_artifacts(
            artifact_input([], [], output), "entity legacy is\n")
        expect(vhdl_write_production_artifacts(output,
            "-- simple-hwir route=hwir-gen2-stateful-product-v2\nentity forged is\n",
            legacy_rendered).unwrap_err()).to_equal(
            "VHDL raw artifact writer refuses compiler-owned RISC-V Gen2 routes")
        expect(rt_file_read_text(output).unwrap()).to_equal("known-vhdl")
        expect(rt_file_read_text(output + ".map.json").unwrap()).to_equal("known-map")
        expect(rt_file_read_text(output + ".gen.json").unwrap()).to_equal("known-manifest")
        val artifacts_source = rt_file_read_text(
            "src/compiler/80.driver/driver_vhdl_artifacts.spl") ?? ""
        expect(artifacts_source.contains("pub fn vhdl_write_compiler_gen2_production_artifacts")).to_equal(false)
        expect(artifacts_source.contains("export vhdl_write_compiler_gen2_production_artifacts")).to_equal(false)
        val driver_source = rt_file_read_text(
            "src/compiler/80.driver/driver_riscv_gen2_product.spl") ?? ""
        expect(driver_source).to_contain("struct Gen2VhdlArtifactEmissionReceipt")
        expect(driver_source).to_contain("gen2_write_authorized_vhdl_artifact_emission")
        expect(driver_source.contains("vhdl_write_compiler_gen2_production_artifacts")).to_equal(false)
        expect(driver_source.contains("vhdl_write_production_artifacts(output, emitted.vhdl")).to_equal(false)
        rt_dir_remove_all(root)

    it "returns an error when the VHDL path is not writable":
        step("Verify: returns an error when the VHDL path is not writable")
        val root = "build/vhdl_artifact_vhdl_write_failure_contract"
        rt_dir_remove_all(root)
        expect(rt_dir_create(root, true)).to_equal(true)
        expect(rt_file_write_text(root + ".map.json", "stale")).to_equal(true)
        expect(rt_file_write_text(root + ".gen.json", "stale")).to_equal(true)
        val rendered = vhdl_render_production_artifacts(
            artifact_input([], [], root), "entity core is\n")
        expect(vhdl_write_production_artifacts(root, "entity core is\n", rendered).is_err()).to_equal(true)
        expect(rt_file_exists(root + ".map.json")).to_equal(false)
        expect(rt_file_exists(root + ".gen.json")).to_equal(false)
        rt_dir_remove_all(root)

    it "removes VHDL and source map when the manifest write fails":
        step("Verify: removes VHDL and source map when the manifest write fails")
        val root = "build/vhdl_artifact_manifest_write_failure_contract"
        rt_dir_remove_all(root)
        expect(rt_dir_create(root, true)).to_equal(true)
        val output = root + "/core.vhd"
        expect(rt_dir_create(output + ".gen.json", true)).to_equal(true)
        val rendered = vhdl_render_production_artifacts(
            artifact_input([], [], output), "entity core is\n")
        expect(vhdl_write_production_artifacts(output, "entity core is\n", rendered).is_err()).to_equal(true)
        expect(rt_file_exists(output)).to_equal(false)
        expect(rt_file_exists(output + ".map.json")).to_equal(false)
        rt_dir_remove_all(root)
