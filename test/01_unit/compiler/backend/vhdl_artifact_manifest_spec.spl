        product.entry_module = "compiler-product:riscv-gen2-zca-rv32-cjal-migrating-predecode-v1"
        product.entry_entity = entity
        product.root_modules = [product.entry_module]
        product.catalog_name = product.entry_module
        product.generation_route = "hwir-gen2-product"
        product.hwir_module_node_id = entity + ":module"
        product.hwir_config_profile = module.config.profile
        product.hwir_graph_sha256 = module.structural_sha256()
        product.target = "riscv32"
        product.xlen = 32
        product.profile = module.config.profile
        product.riscv_isa_profile = module.config.isa_profile
        product.riscv_compressed_decode_profile = module.config.compressed_decode_profile
        product.riscv_capability_scope = "frontend-predecode-only"
        product.riscv_admitted_instruction_ids = vhdl_gen2_capability_ids(
