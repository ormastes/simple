use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "VHDL catalog deterministic sorting":
    it "uses bounded stable merge passes instead of quadratic selection scans":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain("fn vhdl_catalog_sorted_text(")
        expect(source).to_contain("fn vhdl_catalog_sorted_symbols(")
        expect(source).to_contain("var scratch = values")
        expect(source).to_contain("var width = 1")
        expect(source).to_contain("while width < count:")
        expect(source).to_contain("result[right] < result[left]")
        expect(source).to_contain("result[right].id < result[left].id")
        expect(source).to_contain("if width > count / 2:")
        expect(source).not.to_contain("var j = i + 1")
        expect(source).not.to_contain("if result[j] < result[i]")
        expect(source).not.to_contain("if result[j].id < result[i].id")

    it "reuses sorted module-owned key snapshots":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain("val ordered_module_names =")
        expect(source).to_contain("val ordered_function_symbols =")
        expect(source).to_contain("val ordered_static_symbols =")
        expect(source).to_contain("val ordered_constant_symbols =")
        expect(source).to_contain("val ordered_type_symbols =")
