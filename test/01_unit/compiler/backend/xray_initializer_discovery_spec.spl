use std.spec.*
use compiler.backend.simpleos_native_guards.{simpleos_module_init_symbols_checked_v1}

describe "checked XRay startup initializer discovery":
    it "accepts a genuinely empty object set":
        expect(simpleos_module_init_symbols_checked_v1([]).unwrap()).to_equal([])

    it "refuses an object that the real symbol owner cannot inspect":
        val result = simpleos_module_init_symbols_checked_v1(["test/fixtures/xray/not-an-object.txt"])
        expect(result.is_err()).to_equal(true)
