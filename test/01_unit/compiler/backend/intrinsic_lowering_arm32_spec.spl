# @manual_section: arm32-scalar-narrow-form-helpers
describe "ARM32 lowering — scalar narrow-form helpers":
    it "CLZ is always available":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query arm32_clz_available()")
        # @capture(bit_table): ARM32 CLZ scalar-helper availability verdict
        expect(arm32_clz_available()).to_equal(true)

    it "RBIT is always available (ARMv6T2+)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query arm32_rbit_available()")
        # @capture(bit_table): ARM32 RBIT scalar-helper availability verdict
        expect(arm32_rbit_available()).to_equal(true)

    it "REV is always available (ARMv6+)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query arm32_rev_available()")
        # @capture(bit_table): ARM32 REV scalar-helper availability verdict
        expect(arm32_rev_available()).to_equal(true)

    it "ROL 1 via ROR is 31 (32 - 1)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Compute arm32_rotate_left_via_ror(1)")
        # @capture(bit_table): ROL-via-ROR shift amount for a 1-bit rotate-left
        expect(arm32_rotate_left_via_ror(1)).to_equal(31)  # oracle: ARM32 has no ROL; ROL n == ROR (32-n), so ROL 1 == ROR 31

    it "ROL 8 via ROR is 24 (32 - 8)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Compute arm32_rotate_left_via_ror(8)")
        # @capture(bit_table): ROL-via-ROR shift amount for an 8-bit rotate-left
        expect(arm32_rotate_left_via_ror(8)).to_equal(24)  # oracle: ROL n == ROR (32-n), so ROL 8 == ROR 24

    it "ROL 32 via ROR is 0 (identity)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Compute arm32_rotate_left_via_ror(32)")
        # @capture(bit_table): ROL-via-ROR shift amount for a full 32-bit rotate (identity)
        expect(arm32_rotate_left_via_ror(32)).to_equal(0)  # oracle: ROL n == ROR (32-n) mod 32, so ROL 32 == ROR 0 (identity, no-op)

# ============================================================================
# RV32 scalar narrow-form hooks
# ============================================================================

# @manual_section: rv32-scalar-narrow-form-hooks
describe "RV32 lowering — scalar narrow-form hooks":
    it "rv32 without Zbb has no native popcount":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac and query rv32_popcount_native")
        val caps = rv32_caps_from_target("riscv32imac")
        # @capture(bit_table): RV32 native-popcount verdict without the Zbb extension
        expect(rv32_popcount_native(caps)).to_equal(false)

    it "rv32 with Zbb has native popcount":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb and query rv32_popcount_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        # @capture(bit_table): RV32 native-popcount verdict with the Zbb extension
        expect(rv32_popcount_native(caps)).to_equal(true)

    it "rv32 with Zbb has native CLZ":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb and query rv32_clz_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        # @capture(bit_table): RV32 native-CLZ verdict with the Zbb extension
        expect(rv32_clz_native(caps)).to_equal(true)

    it "rv32 with Zbb has native CTZ":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb and query rv32_ctz_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        # @capture(bit_table): RV32 native-CTZ verdict with the Zbb extension
        expect(rv32_ctz_native(caps)).to_equal(true)

    it "rv32 with Zbb has native byte-swap":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb and query rv32_bswap_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        # @capture(bit_table): RV32 native-byte-swap verdict with the Zbb extension
        expect(rv32_bswap_native(caps)).to_equal(true)

    it "rv32 with Zbb but not Zbkb does not have native bit-reverse":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb and query rv32_bitrev_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        # @capture(bit_table): RV32 native-bit-reverse verdict with only Zbb (Zbkb absent)
        expect(rv32_bitrev_native(caps)).to_equal(false)

    it "rv32 with Zbb+Zbkb has native bit-reverse":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb_zbkb and query rv32_bitrev_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb_zbkb")
        # @capture(bit_table): RV32 native-bit-reverse verdict with Zbb+Zbkb
        expect(rv32_bitrev_native(caps)).to_equal(true)

    it "rv32 with Zbb has native rotate":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zbb and query rv32_rotate_native")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        # @capture(bit_table): RV32 native-rotate verdict with the Zbb extension
        expect(rv32_rotate_native(caps)).to_equal(true)

    it "rv32 with Zkne has native AES encrypt":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zkne and query rv32_aes_enc_native")
        val caps = rv32_caps_from_target("riscv32imac_zkne")
        # @capture(bit_table): RV32 native-AES-encrypt verdict with the Zkne extension
        expect(rv32_aes_enc_native(caps)).to_equal(true)

    it "rv32 with Zknd has native AES decrypt":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zknd and query rv32_aes_dec_native")
        val caps = rv32_caps_from_target("riscv32imac_zknd")
        # @capture(bit_table): RV32 native-AES-decrypt verdict with the Zknd extension
        expect(rv32_aes_dec_native(caps)).to_equal(true)

    it "rv32 with Zknh has native SHA-256":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac_zknh and query rv32_sha256_native")
        val caps = rv32_caps_from_target("riscv32imac_zknh")
        # @capture(bit_table): RV32 native-SHA-256 verdict with the Zknh extension
        expect(rv32_sha256_native(caps)).to_equal(true)

    it "rv32 baseline has no native AES":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Rv32Caps for riscv32imac and query both AES native predicates")
        val caps = rv32_caps_from_target("riscv32imac")
        # @capture(bit_table): RV32 native-AES verdicts on the baseline profile (neither direction)
        expect(rv32_aes_enc_native(caps)).to_equal(false)
        expect(rv32_aes_dec_native(caps)).to_equal(false)

# ============================================================================
# RV32 lowering decisions
# ============================================================================

# @manual_section: rv32-lowering-decisions
describe "RV32 lowering — decision predicates":
    it "SHA-512 is always a fallback on RV32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build full-crypto Rv32Caps and decide TargetIdiom.Sha512Rounds2")
        val caps = rv32_caps_from_target("riscv32imac_zknd_zkne_zknh")
        val d = rv32_lowering_decision(caps, TargetIdiom.Sha512Rounds2)
        # @capture(bit_table): RV32 lowering decision for Sha512Rounds2 (permanent fallback, reasoned)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)
        expect(d.reason.len()).to_be_greater_than(0)

    it "CRC32 is always a fallback on RV32 (no hardware CRC in RISC-V)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build baseline Rv32Caps and decide TargetIdiom.Crc32U32")
        val caps = rv32_caps_from_target("riscv32imac")
        val d = rv32_lowering_decision(caps, TargetIdiom.Crc32U32)
        # @capture(bit_table): RV32 lowering decision for Crc32U32 (no hardware CRC unit)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

    it "ClmulLo is a fallback on RV32 (Zbc not guaranteed)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build baseline Rv32Caps and decide TargetIdiom.ClmulLo")
        val caps = rv32_caps_from_target("riscv32imac")
        val d = rv32_lowering_decision(caps, TargetIdiom.ClmulLo)
        # @capture(bit_table): RV32 lowering decision for ClmulLo (Zbc not present)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

    it "SimdI32x8 is always a fallback on RV32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Zbb-only Rv32Caps and decide TargetIdiom.SimdI32x8")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        val d = rv32_lowering_decision(caps, TargetIdiom.SimdI32x8)
        # @capture(bit_table): RV32 lowering decision for SimdI32x8 (no vector unit modeled)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

    it "RotateLeft is natively lowered with Zbb":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Zbb Rv32Caps and decide TargetIdiom.RotateLeft")
        val caps = rv32_caps_from_target("riscv32imac_zbb")
        val d = rv32_lowering_decision(caps, TargetIdiom.RotateLeft)
        # @capture(bit_table): RV32 lowering decision for RotateLeft with Zbb (native)
        expect(d.lowered).to_equal(true)
        expect(d.fallback).to_equal(false)

    it "AesEnc is natively lowered with Zkne":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build Zkne Rv32Caps and decide TargetIdiom.AesEnc")
        val caps = rv32_caps_from_target("riscv32imac_zkne")
        val d = rv32_lowering_decision(caps, TargetIdiom.AesEnc)
        # @capture(bit_table): RV32 lowering decision for AesEnc with Zkne (native)
        expect(d.lowered).to_equal(true)
        expect(d.fallback).to_equal(false)

    it "AesEnc falls back without Zkne":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build baseline Rv32Caps and decide TargetIdiom.AesEnc")
        val caps = rv32_caps_from_target("riscv32imac")
        val d = rv32_lowering_decision(caps, TargetIdiom.AesEnc)
        # @capture(bit_table): RV32 lowering decision for AesEnc without Zkne (software fallback)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)
        expect(d.reason.len()).to_be_greater_than(0)
