"""
## Purpose and audience
Byte-level decision evidence for the compiler's ARM32 and RV32 intrinsic
lowering hooks (REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING). Audience: the
ARM32/RV32 backend engineer who must confirm which SIMD/crypto/bit-manipulation
idioms lower natively on a given target-feature profile, and which fall back to
software emulation, before trusting codegen on a constrained embedded target.

## Operator workflow
bin/simple test test/01_unit/compiler/backend/intrinsic_lowering_arm32_spec.spl

## Compatibility and limitations
Interpreter-mode note (per .claude/rules/testing.md): the test runner in
interpreter mode only verifies file loading and describe/it block
reachability; assertions inside it-blocks execute under compiled mode.
Some idioms (Sha512Rounds2/Msg1/Msg2, SimdI32x8, SimdF32x8, Crc32U64,
ClmulLo/Hi) are permanently unavailable on ARM32/RV32 regardless of the
target-feature profile — no future flag makes them native.

## Verification guidance and troubleshooting
Each scenario captures the lowering decision (`lowered`/`fallback`/`reason`)
or scalar helper result for one target-feature profile as a bit_table. A
mismatch names the offending idiom or profile; cross-reference
`src/compiler/*/backend/lowering/intrinsic_lowering_arm32.spl` and the
`feature_caps` module's target-string parsing to locate which capability bit
produced the wrong decision.
"""
# research: doc/01_research/compiler/backend/backend_completeness_summary.md ; plan: doc/03_plan/compiler/backend/arm32_x86_32_native_backend_plan.md ; architecture: doc/04_architecture/compiler/backend/unified_backend_architecture.md ; design: doc/05_design/compiler/backend/backend_architecture.md
# @manual_section: arm32-rv32-lowering-fallback

# ARM32 + RV32 Lowering Hooks — Fallback Tests
#
# Feature ID: #COMPILER-BACKEND-ARM32-RV32-LOWERING
# Category:   Compiler | Backend | ARM32 + RV32 Lowering
# Status:     Active
#
# Tests Task 5: conservative feature tables for ARM32/RV32 and their lowering
# decision predicates. Verifies fallback paths for unsupported features.
#
# Interpreter-mode note: assertions not executed in interpreter mode.

use compiler.backend.feature_caps.{ArmCaps, Rv32Caps, TargetIdiom}
use compiler.backend.feature_caps.{arm_caps_from_target, rv32_caps_from_target}
use compiler.backend.lowering.intrinsic_lowering_arm32.{
    arm32_can_lower_natively,
    arm32_needs_software_fallback,
    arm32_permanently_unavailable,
    arm32_needs_neon,
    arm32_needs_aes,
    arm32_needs_sha2,
    Arm32LoweringDecision,
    arm32_lowering_decision,
    arm32_clz_available,
    arm32_rbit_available,
    arm32_rev_available,
    arm32_rotate_left_via_ror,
    rv32_popcount_native,
    rv32_ctz_native,
    rv32_clz_native,
    rv32_bswap_native,
    rv32_bitrev_native,
    rv32_rotate_native,
    rv32_aes_enc_native,
    rv32_aes_dec_native,
    rv32_sha256_native,
    Rv32LoweringDecision,
    rv32_lowering_decision
}

# ============================================================================
# arm32_permanently_unavailable — architecture-level limits
# ============================================================================

# @manual_section: arm32-permanently-unavailable
describe "ARM32 lowering — permanently unavailable idioms":
    it "Sha512Rounds2 is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.Sha512Rounds2 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for Sha512Rounds2
        expect(arm32_permanently_unavailable(TargetIdiom.Sha512Rounds2)).to_equal(true)

    it "Sha512Msg1 is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.Sha512Msg1 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for Sha512Msg1
        expect(arm32_permanently_unavailable(TargetIdiom.Sha512Msg1)).to_equal(true)

    it "Sha512Msg2 is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.Sha512Msg2 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for Sha512Msg2
        expect(arm32_permanently_unavailable(TargetIdiom.Sha512Msg2)).to_equal(true)

    it "SimdI32x8 is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.SimdI32x8 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for SimdI32x8 (no 256-bit NEON)
        expect(arm32_permanently_unavailable(TargetIdiom.SimdI32x8)).to_equal(true)

    it "SimdF32x8 is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.SimdF32x8 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for SimdF32x8 (no 256-bit NEON)
        expect(arm32_permanently_unavailable(TargetIdiom.SimdF32x8)).to_equal(true)

    it "Crc32U64 is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.Crc32U64 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for Crc32U64 (32-bit-only CRC unit)
        expect(arm32_permanently_unavailable(TargetIdiom.Crc32U64)).to_equal(true)

    it "ClmulLo is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.ClmulLo on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for ClmulLo
        expect(arm32_permanently_unavailable(TargetIdiom.ClmulLo)).to_equal(true)

    it "ClmulHi is permanently unavailable on ARM32":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.ClmulHi on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for ClmulHi
        expect(arm32_permanently_unavailable(TargetIdiom.ClmulHi)).to_equal(true)

    it "RotateLeft is NOT permanently unavailable":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.RotateLeft on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for RotateLeft (always liftable)
        expect(arm32_permanently_unavailable(TargetIdiom.RotateLeft)).to_equal(false)

    it "AesEnc is NOT permanently unavailable (optional extension exists)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.AesEnc on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for AesEnc (optional crypto ext)
        expect(arm32_permanently_unavailable(TargetIdiom.AesEnc)).to_equal(false)

    it "SimdI32x4 is NOT permanently unavailable (NEON provides it)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Query permanent-unavailability for TargetIdiom.SimdI32x4 on ARM32")
        # @capture(bit_table): ARM32 permanent-unavailability verdict for SimdI32x4 (NEON-provided)
        expect(arm32_permanently_unavailable(TargetIdiom.SimdI32x4)).to_equal(false)

# ============================================================================
# arm32_lowering_decision — Cortex-M0 (baseline, no NEON, no crypto)
# ============================================================================

# @manual_section: arm32-cortex-m0-baseline
describe "ARM32 lowering — Cortex-M0 baseline decisions":
    it "RotateLeft is lowered natively on Cortex-M0":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for thumbv6m-none-eabi and decide TargetIdiom.RotateLeft")
        val caps = arm_caps_from_target("thumbv6m-none-eabi")
        val d = arm32_lowering_decision(caps, TargetIdiom.RotateLeft)
        # @capture(bit_table): Cortex-M0 lowering decision for RotateLeft (lowered, no fallback)
        expect(d.lowered).to_equal(true)
        expect(d.fallback).to_equal(false)

    it "ByteSwap is lowered natively on Cortex-M0 (REV instruction)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for thumbv6m-none-eabi and decide TargetIdiom.ByteSwap")
        val caps = arm_caps_from_target("thumbv6m-none-eabi")
        val d = arm32_lowering_decision(caps, TargetIdiom.ByteSwap)
        # @capture(bit_table): Cortex-M0 lowering decision for ByteSwap (native via REV)
        expect(d.lowered).to_equal(true)

    it "AesEnc falls back on Cortex-M0 (no AES extension)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for thumbv6m-none-eabi and decide TargetIdiom.AesEnc")
        val caps = arm_caps_from_target("thumbv6m-none-eabi")
        val d = arm32_lowering_decision(caps, TargetIdiom.AesEnc)
        # @capture(bit_table): Cortex-M0 lowering decision for AesEnc (software fallback, reasoned)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)
        expect(d.reason.len()).to_be_greater_than(0)

    it "SimdI32x4 falls back on Cortex-M0 (no NEON)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for thumbv6m-none-eabi and decide TargetIdiom.SimdI32x4")
        val caps = arm_caps_from_target("thumbv6m-none-eabi")
        val d = arm32_lowering_decision(caps, TargetIdiom.SimdI32x4)
        # @capture(bit_table): Cortex-M0 lowering decision for SimdI32x4 (software fallback, no NEON)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

    it "Sha512Rounds2 falls back with permanent unavailability reason":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for thumbv6m-none-eabi and decide TargetIdiom.Sha512Rounds2")
        val caps = arm_caps_from_target("thumbv6m-none-eabi")
        val d = arm32_lowering_decision(caps, TargetIdiom.Sha512Rounds2)
        # @capture(bit_table): Cortex-M0 lowering decision for Sha512Rounds2 (permanent fallback)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

# ============================================================================
# arm32_lowering_decision — neon+crypto triple
# ============================================================================

# @manual_section: arm32-neon-crypto-triple
describe "ARM32 lowering — neon+crypto triple decisions":
    it "AesEnc is lowered natively with AES extension":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for armv8-neon-crypto and decide TargetIdiom.AesEnc")
        val caps = arm_caps_from_target("armv8-neon-crypto")
        val d = arm32_lowering_decision(caps, TargetIdiom.AesEnc)
        # @capture(bit_table): neon+crypto lowering decision for AesEnc (native, no fallback)
        expect(d.lowered).to_equal(true)
        expect(d.fallback).to_equal(false)

    it "Sha256Rounds2 is lowered natively with SHA2 extension":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for armv8-neon-crypto and decide TargetIdiom.Sha256Rounds2")
        val caps = arm_caps_from_target("armv8-neon-crypto")
        val d = arm32_lowering_decision(caps, TargetIdiom.Sha256Rounds2)
        # @capture(bit_table): neon+crypto lowering decision for Sha256Rounds2 (native)
        expect(d.lowered).to_equal(true)

    it "SimdI32x4 is lowered natively with NEON":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for armv8-neon-crypto and decide TargetIdiom.SimdI32x4")
        val caps = arm_caps_from_target("armv8-neon-crypto")
        val d = arm32_lowering_decision(caps, TargetIdiom.SimdI32x4)
        # @capture(bit_table): neon+crypto lowering decision for SimdI32x4 (native via NEON)
        expect(d.lowered).to_equal(true)

    it "Sha512Rounds2 still falls back even with full crypto (permanent limit)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for armv8-neon-crypto and decide TargetIdiom.Sha512Rounds2")
        val caps = arm_caps_from_target("armv8-neon-crypto")
        val d = arm32_lowering_decision(caps, TargetIdiom.Sha512Rounds2)
        # @capture(bit_table): neon+crypto lowering decision for Sha512Rounds2 (still fallback)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

    it "SimdI32x8 still falls back (no 256-bit NEON on ARM32)":
        # @req REQ-COMPILER-BACKEND-ARM32-RV32-LOWERING
        step("Build ArmCaps for armv8-neon-crypto and decide TargetIdiom.SimdI32x8")
        val caps = arm_caps_from_target("armv8-neon-crypto")
        val d = arm32_lowering_decision(caps, TargetIdiom.SimdI32x8)
        # @capture(bit_table): neon+crypto lowering decision for SimdI32x8 (still fallback, no 256-bit)
        expect(d.lowered).to_equal(false)
        expect(d.fallback).to_equal(true)

# ============================================================================
# ARM32 scalar narrow-form helpers
