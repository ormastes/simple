use compiler.backend.backend.llvm_stage4_explicit_link_inputs.{llvm_stage4_explicit_link_inputs_reason}

fn main() -> i64:
    if llvm_stage4_explicit_link_inputs_reason([], [], []) != "": return 1
    if not llvm_stage4_explicit_link_inputs_reason(["sqlite3"], [], []).contains("explicit libraries"): return 2
    if not llvm_stage4_explicit_link_inputs_reason([], ["/unadmitted"], []).contains("explicit library paths"): return 3
    if not llvm_stage4_explicit_link_inputs_reason([], [], ["-Wl,--whole-archive"]).contains("explicit linker flags"): return 4
    0
