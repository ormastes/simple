# @cover src/compiler/70.backend/backend/llvm_backend_tools.spl

use compiler.backend.backend.backend_types.{OptimizationLevel}
use compiler.backend.backend.llvm_backend_tools.{llvm_llc_opt_flag}

describe "LLVM llc optimization argument policy":
    it "uses only numeric optimization levels accepted by llc":
        expect(llvm_llc_opt_flag(OptimizationLevel.None_)).to_equal("-O0")
        expect(llvm_llc_opt_flag(OptimizationLevel.Debug)).to_equal("-O0")
        expect(llvm_llc_opt_flag(OptimizationLevel.Size)).to_equal("-O2")
        expect(llvm_llc_opt_flag(OptimizationLevel.Speed)).to_equal("-O2")
        expect(llvm_llc_opt_flag(OptimizationLevel.Aggressive)).to_equal("-O3")
