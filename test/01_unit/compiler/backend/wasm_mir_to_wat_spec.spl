# MirToWat translation-layer specification.
#
# The pre-existing wasm_codegen_spec.spl files claim in their header to
# "validate MIR to WAT translation", but every test in them drives WatBuilder /
# WasmType / WasmTypeMapper primitives DIRECTLY -- none constructs a MirToWat.
# The whole MIR->WAT translation layer was untested, which is how four silent
# wrong-code defects survived in wat_codegen.spl (see
# doc/08_tracking/bug/wasm_wat_codegen_match_on_struct_not_kind_2026-08-01.md).
#
# This spec exists to pin the thing those specs skipped: that a const, a call,
# and an operand each actually emit their instruction, and that an unsupported
# case FAILS LOUDLY (`unreachable`) rather than emitting a plausible value.
#
# Every `it` block here fails against the pre-fix code.

use compiler.backend.{WatBuilder}
use compiler.backend.wasm.wat_codegen.{MirToWat}
use compiler.mir.mir_data.*
# MirOperand/MirOperandKind are NOT reachable through the mir_data wildcard --
# constructing one via `MirOperand(kind: ...)` with only the `.*` import fails
# with "function `MirOperand` not found". Import them explicitly.
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind}

fn translator() -> MirToWat:
    MirToWat.create("spec_mod")

fn builder() -> WatBuilder:
    WatBuilder.create()

fn local(n: i64) -> LocalId:
    LocalId(id: n)

fn ty(k: MirTypeKind) -> MirType:
    MirType(kind: k)

fn op_const(v: MirConstValue, t: MirType) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(v, t))

fn op_local(n: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(local(n)))

fn binop_wat(op: MirBinOp) -> text:
    val b = builder()
    translator().translate_binop(b, local(20), op, op_local(0), op_local(1))
    b.build()

fn unaryop_wat(op: MirUnaryOp) -> text:
    val b = builder()
    translator().translate_unaryop(b, local(21), op, op_local(0))
    b.build()

describe "MirToWat translation layer":

    describe "translate_const":
        it "writes the destination local for a scalar Zero constant":
            # REGRESSION: `Zero` is the real MirConstValue variant, but
            # translate_const only had dead `Unit`/`Nil` arms, so Zero fell to
            # `case _:` which emitted a comment and NO local.set -- leaving the
            # destination local unwritten with no diagnostic.
            val b = builder()
            translator().translate_const(b, local(0), MirConstValue.Zero, ty(MirTypeKind.I64))
            val wat = b.build()

            expect(wat).to_contain("i64.const 0")
            expect(wat).to_contain("local.set $_l0")

        it "zero-initializes at the destination width, not always i64":
            val b = builder()
            translator().translate_const(b, local(1), MirConstValue.Zero, ty(MirTypeKind.I32))
            val wat = b.build()

            expect(wat).to_contain("i32.const 0")
            expect(wat).to_contain("local.set $_l1")

        it "emits an integer constant and stores it":
            val b = builder()
            translator().translate_const(b, local(2), MirConstValue.Int(42), ty(MirTypeKind.I64))
            val wat = b.build()

            expect(wat).to_contain("i64.const 42")
            expect(wat).to_contain("local.set $_l2")

        it "traps on an aggregate constant instead of emitting malformed WAT":
            # The old Array arm emitted `i64.const {elem}` -- interpolating a
            # MirConstValue into a numeric operand. Unsupported must fail
            # explicitly, never produce a plausible-looking instruction.
            val b = builder()
            val elems = [MirConstValue.Int(1), MirConstValue.Int(2)]
            translator().translate_const(b, local(3), MirConstValue.Array(elems), ty(MirTypeKind.I64))
            val wat = b.build()

            expect(wat).to_contain("UNSUPPORTED")
            expect(wat).to_contain("unreachable")

    describe "emit_operand":
        it "pushes a local for a Copy operand":
            # REGRESSION: emit_operand matched the MirOperand STRUCT instead of
            # `.kind`, so every operand fell to a comment-only default and
            # pushed NOTHING onto the value stack.
            val b = builder()
            translator().emit_operand(b, MirOperand(kind: MirOperandKind.Copy(local(4))))
            expect(b.build()).to_contain("local.get $_l4")

        it "pushes a local for a Move operand":
            val b = builder()
            translator().emit_operand(b, MirOperand(kind: MirOperandKind.Move(local(5))))
            expect(b.build()).to_contain("local.get $_l5")

        it "pushes a real constant, not a comment, for a Const operand":
            val b = builder()
            translator().emit_operand(b, op_const(MirConstValue.Int(7), ty(MirTypeKind.I64)))
            expect(b.build()).to_contain("i64.const 7")

        it "pushes a bool constant as i32":
            val b = builder()
            translator().emit_operand(b, op_const(MirConstValue.Bool(true), ty(MirTypeKind.Bool)))
            expect(b.build()).to_contain("i32.const 1")

    describe "translate_call":
        it "emits the call instruction for a symbol callee":
            # REGRESSION: translate_call matched the struct against
            # `Constant`/`Use` with no `case _:`, so it emitted the argument
            # pushes and then NO call at all -- the following local.set
            # consumed the last argument as if it were the return value.
            val b = builder()
            val callee = op_const(MirConstValue.Str("my_func"), ty(MirTypeKind.I32))
            val args = [op_const(MirConstValue.Int(3), ty(MirTypeKind.I64))]
            translator().translate_call(b, local(6), callee, args)
            val wat = b.build()

            expect(wat).to_contain("i64.const 3")
            expect(wat).to_contain("call $my_func")

        it "emits call_indirect for a computed callee":
            val b = builder()
            val callee = MirOperand(kind: MirOperandKind.Move(local(7)))
            translator().translate_call(b, local(8), callee, [])
            val wat = b.build()

            expect(wat).to_contain("local.get $_l7")
            expect(wat).to_contain("call_indirect")

    describe "translate_binop":
        # REGRESSION: `And` is NOT a MirBinOp variant (the enum has BitAnd/BitOr
        # /BitXor, no And/Or/Xor, no Mod, and no F* float ops at all). A bare
        # identifier in `case` position is an IRREFUTABLE BINDING, so
        # `case And:` matched EVERY op that reached it and killed all 27 arms
        # below it, `case _:` included. Measured before the fix: Pow, MatMul,
        # BitAnd, BitOr, BitXor, Shl, Shr, all five Broadcast ops and Offset
        # every one of them emitted `i32.and`.

        it "emits i64.and for BitAnd instead of the swallowed i32.and":
            expect(binop_wat(MirBinOp.BitAnd)).to_contain("i64.and")

        it "emits i64.or for BitOr":
            expect(binop_wat(MirBinOp.BitOr)).to_contain("i64.or")

        it "emits i64.xor for BitXor":
            expect(binop_wat(MirBinOp.BitXor)).to_contain("i64.xor")

        it "emits i64.shl for Shl":
            expect(binop_wat(MirBinOp.Shl)).to_contain("i64.shl")

        it "emits an arithmetic right shift for Shr":
            expect(binop_wat(MirBinOp.Shr)).to_contain("i64.shr_s")

        it "keeps the already-reachable arms working":
            expect(binop_wat(MirBinOp.Add)).to_contain("i64.add")
            expect(binop_wat(MirBinOp.Ge)).to_contain("i64.ge_s")

        it "lowers Offset as unscaled pointer arithmetic":
            expect(binop_wat(MirBinOp.Offset)).to_contain("i64.add")

        it "traps on Pow rather than emitting a comment and no result":
            # The old Pow arm re-pushed both operands (already on the stack),
            # converted them, then emitted only a comment -- four values left
            # on the value stack and no result produced.
            val wat = binop_wat(MirBinOp.Pow)
            expect(wat).to_contain("UNSUPPORTED")
            expect(wat).to_contain("unreachable")

        it "traps on MatMul":
            val wat = binop_wat(MirBinOp.MatMul)
            expect(wat).to_contain("UNSUPPORTED")
            expect(wat).to_contain("unreachable")

        it "traps on every Broadcast op instead of emitting a bitwise and":
            for op in [MirBinOp.BroadcastAdd, MirBinOp.BroadcastSub,
                       MirBinOp.BroadcastMul, MirBinOp.BroadcastDiv,
                       MirBinOp.BroadcastPow]:
                val wat = binop_wat(op)
                expect(wat).to_contain("UNSUPPORTED")
                expect(wat).to_contain("unreachable")

        it "never emits i32.and for an op that is not a bitwise and":
            # The single sharpest pin on the defect: i32.and was the swallowing
            # arm's instruction and is not the correct lowering for ANY
            # MirBinOp variant, so it must not appear at all.
            for op in [MirBinOp.Pow, MirBinOp.MatMul, MirBinOp.BitAnd,
                       MirBinOp.BitOr, MirBinOp.BitXor, MirBinOp.Shl,
                       MirBinOp.Shr, MirBinOp.Offset]:
                assert_false(binop_wat(op).contains("i32.and"))

    describe "translate_unaryop":
        # Same defect, same file: `FNeg` is not a MirUnaryOp variant (the enum
        # is Neg/Not/BitNot/Transpose), so `case FNeg:` swallowed the real
        # BitNot and Transpose arms and both emitted `f64.neg`.

        it "emits a bitwise complement for BitNot, not f64.neg":
            val wat = unaryop_wat(MirUnaryOp.BitNot)
            expect(wat).to_contain("i64.const -1")
            expect(wat).to_contain("i64.xor")
            assert_false(wat.contains("f64.neg"))

        it "traps on Transpose instead of negating a float":
            val wat = unaryop_wat(MirUnaryOp.Transpose)
            expect(wat).to_contain("UNSUPPORTED")
            expect(wat).to_contain("unreachable")
            assert_false(wat.contains("f64.neg"))

        it "keeps Neg and Not working":
            expect(unaryop_wat(MirUnaryOp.Neg)).to_contain("i64.sub")
            expect(unaryop_wat(MirUnaryOp.Not)).to_contain("i32.eqz")
