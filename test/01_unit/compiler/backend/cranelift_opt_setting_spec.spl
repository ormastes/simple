# @req REQ-CRANELIFT-OPT-SETTING
use std.spec.*
use compiler.backend.backend.backend_types.{OptimizationLevel, compileoptions_default_options}
use compiler.backend.cranelift_codegen_adapter.{cranelift_isa_opt_level_v2}

describe "Cranelift ISA optimization settings":
    it "maps aggressive MIR optimization to the provider maximum speed setting":
        var options = compileoptions_default_options()
        options.opt_level = OptimizationLevel.Aggressive
        expect(cranelift_isa_opt_level_v2(options)).to_equal(2)
        options.opt_level = OptimizationLevel.Speed
        expect(cranelift_isa_opt_level_v2(options)).to_equal(2)

    it "preserves none and size and rejects unsupported basic":
        var options = compileoptions_default_options()
        options.opt_level = OptimizationLevel.None_
        expect(cranelift_isa_opt_level_v2(options)).to_equal(0)
        options.opt_level = OptimizationLevel.Size
        expect(cranelift_isa_opt_level_v2(options)).to_equal(1)
        options.opt_level = OptimizationLevel.Basic
        expect(cranelift_isa_opt_level_v2(options)).to_equal(-1)
