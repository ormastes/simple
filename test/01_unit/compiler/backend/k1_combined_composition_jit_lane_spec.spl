use std.spec.*
use compositions.kernel_llvm_cranelift.compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use compiler.backend.backend.static_backend_registry.{
    installed_k1_static_backend_policy_v1, select_static_backend_v1}
use compiler.backend.backend.static_jit_lane.{
    installed_k1_jit_lane_name_v1, k1_jit_lane_run_modules_v1}
use compiler.common.driver_core_types.{CompileResult}

fn _runtime_error_text(result: CompileResult) -> text:
    match result:
        case RuntimeError(message): message
        case _: ""

# The combined kernel is the only importer of the Cranelift JIT lane; the
# kernel reaches it solely through the StaticJitLaneV1 slot.
describe "kernel_llvm_cranelift composition installs the Cranelift JIT lane":
    it "installs the table and the lane together":
        expect(selected_k1_backend_policy_v1()).to_equal("llvm-cranelift")
        expect(install_selected_k1_backend_table_v1()).to_equal(true)
        expect(installed_k1_static_backend_policy_v1()).to_equal("llvm-cranelift")
        expect(installed_k1_jit_lane_name_v1()).to_equal("cranelift")
        expect(select_static_backend_v1("cranelift").is_ok()).to_equal(true)

    it "routes JIT execution into the lane instead of refusing":
        expect(install_selected_k1_backend_table_v1()).to_equal(true)
        # An empty module list never reaches Cranelift itself; the lane's own
        # verdict proves the slot dispatched into it.
        expect(_runtime_error_text(k1_jit_lane_run_modules_v1([]))).to_equal("No modules compiled")
