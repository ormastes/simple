# Execute actual typed MIR instructions through the Cranelift provider JIT.
# Source expressions may infer wide destinations; their width contract is
# separate from this backend boundary. Requires an admitted runtime.
use std.spec.*
use std.spec.step
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.cranelift_codegen_adapter.{cl_translate_instruction}
use std.nogc_sync_mut.sffi.codegen.*

fn shift_metadata(type_: MirType) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 9017), name: "shift_probe",
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: type_, kind: LocalKind.Temp, is_ghost: false)],
        blocks: [], entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

fn execute_mir_shift(op: MirBinOp, value: i64, count: i64, source_type: MirType, result_type: MirType) -> i64:
    # The provider's default target selects the host ISA; no cross-target code executes.
    val module = cranelift_new_module("shift_width", -1)
    expect(module != 0).to_equal(true)
    val sig = cranelift_new_signature(-1)
    cranelift_sig_set_return(sig, 4)
    val ctx = cranelift_begin_function(module, "shift_probe", sig)
    expect(ctx != 0).to_equal(true)
    val entry = cranelift_create_block(ctx)
    cranelift_switch_to_block(ctx, entry)
    val left = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), source_type))
    val right = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(count), MirType.i64()))
    val inst = MirInst(kind: MirInstKind.BinOp(LocalId(id: 0), op, left, right), span: nil)
    var values: Dict<i64, i64> = {}
    cl_translate_instruction(ctx, inst, values, {}, {}, module, {}, {}, shift_metadata(result_type))
    expect(values.has(0)).to_equal(true)
    cranelift_return(ctx, values[0])
    cranelift_seal_all_blocks(ctx)
    val finished = cranelift_end_function(ctx)
    expect(finished != 0).to_equal(true)
    expect(cranelift_define_function(module, 0, finished)).to_equal(true)
    expect(cranelift_finalize_module(module) != 0).to_equal(true)
    val address = cranelift_get_function_ptr(module, "shift_probe")
    expect(address != 0).to_equal(true)
    val actual = cranelift_call_function_ptr(address, 0, 0)
    cranelift_free_module(module)
    actual

describe "Cranelift shifts mask by actual MIR destination width":

    it "executes I8 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.I8)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 8, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, -128, 8, type_, type_)).to_equal(-128)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 9, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, -128, 9, type_, type_)).to_equal(-64)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal(-128)
        expect(execute_mir_shift(MirBinOp.Shr, -128, -1, type_, type_)).to_equal(-1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, -128, 0, type_, type_)).to_equal(-128)

    it "executes U8 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.U8)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 8, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, 128, 8, type_, type_)).to_equal(128)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 9, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, 128, 9, type_, type_)).to_equal(64)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal(128)
        expect(execute_mir_shift(MirBinOp.Shr, 128, -1, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, 128, 0, type_, type_)).to_equal(128)

    it "executes I16 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.I16)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 16, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, -32768, 16, type_, type_)).to_equal(-32768)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 17, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, -32768, 17, type_, type_)).to_equal(-16384)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal(-32768)
        expect(execute_mir_shift(MirBinOp.Shr, -32768, -1, type_, type_)).to_equal(-1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, -32768, 0, type_, type_)).to_equal(-32768)

    it "executes U16 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.U16)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 16, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, 32768, 16, type_, type_)).to_equal(32768)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 17, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, 32768, 17, type_, type_)).to_equal(16384)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal(32768)
        expect(execute_mir_shift(MirBinOp.Shr, 32768, -1, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, 32768, 0, type_, type_)).to_equal(32768)

    it "executes I32 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.I32)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 32, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, -2147483648, 32, type_, type_)).to_equal(-2147483648)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 33, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, -2147483648, 33, type_, type_)).to_equal(-1073741824)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal(-2147483648)
        expect(execute_mir_shift(MirBinOp.Shr, -2147483648, -1, type_, type_)).to_equal(-1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, -2147483648, 0, type_, type_)).to_equal(-2147483648)

    it "executes U32 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.U32)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 32, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, 2147483648, 32, type_, type_)).to_equal(2147483648)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 33, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, 2147483648, 33, type_, type_)).to_equal(1073741824)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal(2147483648)
        expect(execute_mir_shift(MirBinOp.Shr, 2147483648, -1, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, 2147483648, 0, type_, type_)).to_equal(2147483648)

    it "executes I64 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.I64)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 64, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), 64, type_, type_)).to_equal((-9223372036854775807 - 1))
        expect(execute_mir_shift(MirBinOp.Shl, 1, 65, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), 65, type_, type_)).to_equal(-4611686018427387904)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal((-9223372036854775807 - 1))
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), -1, type_, type_)).to_equal(-1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), 0, type_, type_)).to_equal((-9223372036854775807 - 1))

    it "executes U64 shifts at the declared width":
        val type_ = MirType(kind: MirTypeKind.U64)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 64, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), 64, type_, type_)).to_equal((-9223372036854775807 - 1))
        expect(execute_mir_shift(MirBinOp.Shl, 1, 65, type_, type_)).to_equal(2)
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), 65, type_, type_)).to_equal(4611686018427387904)
        expect(execute_mir_shift(MirBinOp.Shl, 1, -1, type_, type_)).to_equal((-9223372036854775807 - 1))
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), -1, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shl, 1, 0, type_, type_)).to_equal(1)
        expect(execute_mir_shift(MirBinOp.Shr, (-9223372036854775807 - 1), 0, type_, type_)).to_equal((-9223372036854775807 - 1))

    it "keeps wide destinations wide when their source operand is narrow":
        step("Execute I64-result shifts with narrow source metadata")
        expect(execute_mir_shift(MirBinOp.Shl, 1, 8, MirType(kind: MirTypeKind.I8), MirType.i64())).to_equal(256)
        expect(execute_mir_shift(MirBinOp.Shr, 128, 8, MirType(kind: MirTypeKind.U8), MirType.i64())).to_equal(0)
