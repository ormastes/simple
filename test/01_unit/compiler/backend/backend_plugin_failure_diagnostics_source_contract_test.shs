#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
native_bridge=$root/src/runtime/runtime_backend_plugin.c
rust_bridge=$root/src/compiler_rust/compiler/src/interpreter_extern/wsffi.rs

grep -F 'int32_t diagnostic_status=v->diagnostics(session,&diagnostic);' "$native_bridge" >/dev/null
grep -F 'if (!status && diagnostic_status) status=diagnostic_status;' "$native_bridge" >/dev/null
grep -F 'let diagnostic_status = diagnostics(session, &mut diagnostic);' "$rust_bridge" >/dev/null
grep -F 'if status == 0 && diagnostic_status != 0 {' "$rust_bridge" >/dev/null

if grep -F 'if (!status) status=v->diagnostics(session,&diagnostic);' "$native_bridge" >/dev/null; then
    echo 'native bridge still suppresses diagnostics after provider failure' >&2
    exit 1
fi

printf '%s\n' 'PASS backend plugin failure diagnostics source contract'
