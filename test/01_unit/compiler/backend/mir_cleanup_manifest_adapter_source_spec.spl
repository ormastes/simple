use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn cleanup_adapter_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "MIR cleanup manifest adapter propagation":
    it "preserves manifests through VHDL catalog reconstruction":
        val source = cleanup_adapter_source(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain(
            "exception_cleanup_contracts: func.exception_cleanup_contracts")

    it "preserves manifests through VHDL MirBody conversion":
        val source = cleanup_adapter_source(
            "src/compiler/70.backend/backend/vhdl_backend.spl")
        expect(source).to_contain(
            "exception_cleanup_contracts: body.exception_cleanup_contracts")
        expect(source).to_contain("entry_block: body.entry_block")

    it "preserves manifests through both CUDA MirBody conversions":
        val source = cleanup_adapter_source(
            "src/compiler/70.backend/backend/cuda_backend.spl")
        expect(source.split(
            "exception_cleanup_contracts: body.exception_cleanup_contracts").len() - 1).to_equal(2)
        expect(source.split(
            "entry_block: body.entry_block").len() - 1).to_equal(2)

    it "preserves manifests through Vulkan MirBody conversion":
        val source = cleanup_adapter_source(
            "src/compiler/70.backend/backend/vulkan_backend.spl")
        expect(source).to_contain(
            "exception_cleanup_contracts: mir_body.exception_cleanup_contracts")
        expect(source).to_contain("entry_block: mir_body.entry_block")

    it "uses spread reconstruction on advice and debug identity-preserving paths":
        val advice = cleanup_adapter_source(
            "src/compiler/50.mir/mir_aop_injection.spl")
        val debug = cleanup_adapter_source(
            "src/compiler/50.mir/mir_debug_trace_injection.spl")
        val prepared = cleanup_adapter_source(
            "src/compiler/80.driver/prepared_advice_slot_handoff.spl")
        expect(advice).to_contain("MirFunction(..func, blocks:")
        expect(debug).to_contain("MirFunction(..func, blocks:")
        expect(prepared).to_contain("MirFunction(..func, blocks:")
