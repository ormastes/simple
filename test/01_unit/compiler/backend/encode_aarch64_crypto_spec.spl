        var b = emit_sha256su1(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: SHA256SU1 is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(V0=0) | (Rn(V1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x60)  # oracle: LE byte1 = bits[15:8] of base opcode 0x5E006000 with Rm(V2)<<16 folded in
        expect(b[2]).to_equal(0x02)  # oracle: LE byte2 = bits[23:16] carrying Rm(V2=2) in bits[20:16]
        expect(b[3]).to_equal(0x5E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-SHA top byte

# ============================================================================
# PMULL V0.1Q, V1.1D, V2.1D => 0x0EE0E000 | (2<<16) | (1<<5) | 0 = 0x0EE2E020
# LE bytes: 0x20, 0xE0, 0xE2, 0x0E
# ============================================================================

# @manual_section: AArch64 PMULL encoders
describe "emit_pmull — polynomial multiply lower halves":
    it "PMULL V0, V1, V2 encodes to correct LE bytes":
        step("Encode PMULL with V0, V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian PMULL instruction word
        var b = emit_pmull(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: PMULL is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(V0=0) | (Rn(V1=1)<<5) = 0x20
        expect(b[1]).to_equal(0xE0)  # oracle: LE byte1 = bits[15:8] of base opcode 0x0EE0E000 with Rm(V2)<<16 folded in
        expect(b[2]).to_equal(0xE2)  # oracle: LE byte2 = bits[23:16] carrying Rm(V2=2) in bits[20:16]
        expect(b[3]).to_equal(0x0E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-PMULL (1Q form) top byte

# ============================================================================
# PMULL2 V0.1Q, V1.2D, V2.2D => 0x4EE0E000 | (2<<16) | (1<<5) | 0 = 0x4EE2E020
# LE bytes: 0x20, 0xE0, 0xE2, 0x4E
# ============================================================================

# @manual_section: AArch64 PMULL encoders
describe "emit_pmull2 — polynomial multiply upper halves":
    it "PMULL2 V0, V1, V2 encodes to correct LE bytes":
        step("Encode PMULL2 with V0, V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian PMULL2 instruction word
        var b = emit_pmull2(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: PMULL2 is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(V0=0) | (Rn(V1=1)<<5) = 0x20
        expect(b[1]).to_equal(0xE0)  # oracle: LE byte1 = bits[15:8] of base opcode 0x4EE0E000 with Rm(V2)<<16 folded in
        expect(b[2]).to_equal(0xE2)  # oracle: LE byte2 = bits[23:16] carrying Rm(V2=2) in bits[20:16]
        expect(b[3]).to_equal(0x4E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-PMULL (2D form) top byte

# ============================================================================
# CRC32B W0, W1, W2 => 0x1AC04000 | (2<<16) | (1<<5) | 0 = 0x1AC24020
# LE bytes: 0x20, 0x40, 0xC2, 0x1A
# ============================================================================

# @manual_section: AArch64 CRC32 encoders
describe "emit_crc32b — CRC32 byte accumulate":
    it "CRC32B W0, W1, W2 encodes to correct LE bytes":
        step("Encode CRC32B with W0, W1 and W2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian CRC32B instruction word
        var b = emit_crc32b(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: CRC32B is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(W0=0) | (Rn(W1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x40)  # oracle: LE byte1 = bits[15:8] of base opcode 0x1AC04000 with Rm(W2)<<16 folded in
        expect(b[2]).to_equal(0xC2)  # oracle: LE byte2 = bits[23:16] carrying Rm(W2=2) in bits[20:16]
        expect(b[3]).to_equal(0x1A)  # oracle: LE byte3 = bits[31:24], AArch64 CRC32 (byte size) top byte

# ============================================================================
# CRC32H W0, W1, W2 => 0x1AC04400 | (2<<16) | (1<<5) | 0 = 0x1AC24420
# LE bytes: 0x20, 0x44, 0xC2, 0x1A
# ============================================================================

# @manual_section: AArch64 CRC32 encoders
describe "emit_crc32h — CRC32 halfword accumulate":
    it "CRC32H W0, W1, W2 encodes to correct LE bytes":
        step("Encode CRC32H with W0, W1 and W2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian CRC32H instruction word
        var b = emit_crc32h(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: CRC32H is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(W0=0) | (Rn(W1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x44)  # oracle: LE byte1 = bits[15:8] of base opcode 0x1AC04400 with Rm(W2)<<16 folded in
        expect(b[2]).to_equal(0xC2)  # oracle: LE byte2 = bits[23:16] carrying Rm(W2=2) in bits[20:16]
        expect(b[3]).to_equal(0x1A)  # oracle: LE byte3 = bits[31:24], AArch64 CRC32 (halfword size) top byte

# ============================================================================
# CRC32W W0, W1, W2 => 0x1AC04800 | (2<<16) | (1<<5) | 0 = 0x1AC24820
# LE bytes: 0x20, 0x48, 0xC2, 0x1A
# ============================================================================

# @manual_section: AArch64 CRC32 encoders
describe "emit_crc32w — CRC32 word accumulate":
    it "CRC32W W0, W1, W2 encodes to correct LE bytes":
        step("Encode CRC32W with W0, W1 and W2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
