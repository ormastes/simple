        var b = emit_crc32w(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: CRC32W is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(W0=0) | (Rn(W1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x48)  # oracle: LE byte1 = bits[15:8] of base opcode 0x1AC04800 with Rm(W2)<<16 folded in
        expect(b[2]).to_equal(0xC2)  # oracle: LE byte2 = bits[23:16] carrying Rm(W2=2) in bits[20:16]
        expect(b[3]).to_equal(0x1A)  # oracle: LE byte3 = bits[31:24], AArch64 CRC32 (word size) top byte

# ============================================================================
# CRC32X W0, W1, X2 => 0x9AC04C00 | (2<<16) | (1<<5) | 0 = 0x9AC24C20
# LE bytes: 0x20, 0x4C, 0xC2, 0x9A
# ============================================================================

# @manual_section: AArch64 CRC32 encoders
describe "emit_crc32x — CRC32 doubleword accumulate":
    it "CRC32X W0, W1, X2 encodes to correct LE bytes":
        step("Encode CRC32X with W0, W1 and X2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian CRC32X instruction word
        var b = emit_crc32x(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: CRC32X is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(W0=0) | (Rn(W1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x4C)  # oracle: LE byte1 = bits[15:8] of base opcode 0x9AC04C00 with Rm(X2)<<16 folded in
        expect(b[2]).to_equal(0xC2)  # oracle: LE byte2 = bits[23:16] carrying Rm(X2=2) in bits[20:16]
        expect(b[3]).to_equal(0x9A)  # oracle: LE byte3 = bits[31:24], AArch64 CRC32 (doubleword, 64-bit) top byte
