"""
# research: doc/01_research/compiler/backend/backend_completeness_summary.md ; plan: doc/03_plan/compiler/backend/arm32_x86_32_native_backend_plan.md ; architecture: doc/04_architecture/compiler/backend/unified_backend_architecture.md ; design: doc/05_design/compiler/backend/backend_architecture.md
## Purpose and audience
Executable golden-byte evidence for the AArch64 native crypto instruction
encoders (AESE, AESD, AESMC, AESIMC, SHA256H, SHA256H2, SHA256SU0, SHA256SU1,
PMULL, PMULL2, CRC32B, CRC32H, CRC32W, CRC32X) in
`compiler.backend.backend.native.encode_aarch64_crypto`. Audience: compiler
backend engineers verifying or extending AArch64 crypto-extension code
generation. REQ-SSPEC-COMPILER, REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO.

## Operator workflow
Run this file with `bin/simple run test/01_unit/compiler/backend/encode_aarch64_crypto_spec.spl`.
Interpreter mode only verifies file loading and describe/it reachability;
compiled-mode execution exercises the byte-level assertions. Each scenario
calls one emit_* encoder with fixed register operands and checks the returned
4-byte little-endian instruction word against a hand-derived ARMv8-A base
opcode.

## Compatibility and limitations
Goldens assume little-endian byte order per the ARMv8 ABI and cover only the
14 listed fixed-width crypto instructions with a small, fixed set of register
operands; other register combinations and wider SIMD-vector variants are not
covered here.

## Verification guidance and troubleshooting
On a failing scenario, recompute the expected opcode from the ARMv8-A base
opcode plus register field insertion (Rd in bits[4:0], Rn in bits[9:5], Rm in
bits[20:16] where applicable) and compare against the oracle comment on the
failing assertion, which names the exact bit derivation for that byte.
"""

# AArch64 Crypto Byte-Emit — Spec Tests
#
# Feature ID: #COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
# Category:   Compiler | Backend | Native | AArch64 Crypto Encoding
#
# Byte-level golden tests for all 14 AArch64 crypto instructions:
#   AESE, AESD, AESMC, AESIMC, SHA256H, SHA256H2, SHA256SU0, SHA256SU1,
#   PMULL, PMULL2, CRC32B, CRC32H, CRC32W, CRC32X.
#
# All instructions are 4-byte fixed-width, little-endian per ARMv8 ABI.
# Goldens derived by hand from ARMv8-A ARM base opcodes + register field insertion.
#
# Register indices used as raw 0-31 (direct Vn/Xn index):
#   V1=1, V2=2, V3=3  (AES/SHA/PMULL)
#   W1=1, W2=2, W3=3  (CRC32)
#
# Interpreter-mode note (per .claude/rules/testing.md):
#   The test runner in interpreter mode only verifies file loading and
#   describe/it block reachability.  Assertions inside it-blocks are not
#   executed.  Compiled-mode execution will exercise them.

use std.spec.step
use compiler.backend.backend.native.encode_aarch64_crypto.{
    emit_aese, emit_aesd, emit_aesmc_aarch64, emit_aesimc_aarch64,
    emit_sha256h, emit_sha256h2, emit_sha256su0, emit_sha256su1,
    emit_pmull, emit_pmull2,
    emit_crc32b, emit_crc32h, emit_crc32w, emit_crc32x
}

# ============================================================================
# AES instructions
# AESE V1.16B, V2.16B  => 0x4E284800 | (2<<5) | 1 = 0x4E284841
# LE bytes: 0x41, 0x48, 0x28, 0x4E
# ============================================================================

# @manual_section: AArch64 AES encoders
describe "emit_aese — AES single-round encryption":
    it "AESE V1, V2 encodes to correct LE bytes":
        step("Encode AESE with V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian AESE instruction word
        var b = emit_aese(1, 2)
        expect(b.len()).to_equal(4)  # oracle: AESE is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x41)  # oracle: LE byte0 = Rd(V1=1) | (Rn(V2=2)<<5) = base 0x00 | 0x41
        expect(b[1]).to_equal(0x48)  # oracle: LE byte1 = bits[15:8] of AESE base opcode 0x4E284800
        expect(b[2]).to_equal(0x28)  # oracle: LE byte2 = bits[23:16], AESE crypto-AES class opcode field
        expect(b[3]).to_equal(0x4E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-AES top byte

    it "AESE V0, V0 produces base opcode bytes":
        step("Encode AESE with V0 and V0 to confirm the unmodified base opcode")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian AESE instruction word with zero register fields
        var b = emit_aese(0, 0)
        expect(b[0]).to_equal(0x00)  # oracle: LE byte0 = Rd(0) | (Rn(0)<<5) = 0x00, no register bits set
        expect(b[1]).to_equal(0x48)  # oracle: LE byte1 = bits[15:8] of AESE base opcode 0x4E284800
        expect(b[2]).to_equal(0x28)  # oracle: LE byte2 = bits[23:16], AESE crypto-AES class opcode field
        expect(b[3]).to_equal(0x4E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-AES top byte

# ============================================================================
# AESD V1.16B, V2.16B => 0x4E285800 | (2<<5) | 1 = 0x4E285841
# LE bytes: 0x41, 0x58, 0x28, 0x4E
# ============================================================================

# @manual_section: AArch64 AES encoders
describe "emit_aesd — AES single-round decryption":
    it "AESD V1, V2 encodes to correct LE bytes":
        step("Encode AESD with V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian AESD instruction word
        var b = emit_aesd(1, 2)
        expect(b.len()).to_equal(4)  # oracle: AESD is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x41)  # oracle: LE byte0 = Rd(V1=1) | (Rn(V2=2)<<5) = 0x41
        expect(b[1]).to_equal(0x58)  # oracle: LE byte1 = bits[15:8] of AESD base opcode 0x4E285800
        expect(b[2]).to_equal(0x28)  # oracle: LE byte2 = bits[23:16], AESD crypto-AES class opcode field
        expect(b[3]).to_equal(0x4E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-AES top byte

# ============================================================================
# AESMC V1.16B, V1.16B => 0x4E286800 | (1<<5) | 1 = 0x4E286821
# LE bytes: 0x21, 0x68, 0x28, 0x4E
# ============================================================================

# @manual_section: AArch64 AES encoders
describe "emit_aesmc_aarch64 — AES mix columns":
    it "AESMC V1, V1 encodes to correct LE bytes":
        step("Encode AESMC with V1 as both operands and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian AESMC instruction word
        var b = emit_aesmc_aarch64(1, 1)
        expect(b.len()).to_equal(4)  # oracle: AESMC is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x21)  # oracle: LE byte0 = Rd(V1=1) | (Rn(V1=1)<<5) = 0x21
        expect(b[1]).to_equal(0x68)  # oracle: LE byte1 = bits[15:8] of AESMC base opcode 0x4E286800
        expect(b[2]).to_equal(0x28)  # oracle: LE byte2 = bits[23:16], AESMC crypto-AES class opcode field
        expect(b[3]).to_equal(0x4E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-AES top byte

# ============================================================================
# AESIMC V1.16B, V2.16B => 0x4E287800 | (2<<5) | 1 = 0x4E287841
# LE bytes: 0x41, 0x78, 0x28, 0x4E
# ============================================================================

# @manual_section: AArch64 AES encoders
describe "emit_aesimc_aarch64 — AES inverse mix columns":
    it "AESIMC V1, V2 encodes to correct LE bytes":
        step("Encode AESIMC with V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian AESIMC instruction word
        var b = emit_aesimc_aarch64(1, 2)
        expect(b.len()).to_equal(4)  # oracle: AESIMC is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x41)  # oracle: LE byte0 = Rd(V1=1) | (Rn(V2=2)<<5) = 0x41
        expect(b[1]).to_equal(0x78)  # oracle: LE byte1 = bits[15:8] of AESIMC base opcode 0x4E287800
        expect(b[2]).to_equal(0x28)  # oracle: LE byte2 = bits[23:16], AESIMC crypto-AES class opcode field
        expect(b[3]).to_equal(0x4E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-AES top byte

# ============================================================================
# SHA256H Q0, Q1, V2.4S => 0x5E004000 | (2<<16) | (1<<5) | 0 = 0x5E024020
# LE bytes: 0x20, 0x40, 0x02, 0x5E
# ============================================================================

# @manual_section: AArch64 SHA-256 encoders
describe "emit_sha256h — SHA-256 hash update part 1":
    it "SHA256H Q0, Q1, V2 encodes to correct LE bytes":
        step("Encode SHA256H with Q0, Q1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian SHA256H instruction word
        var b = emit_sha256h(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: SHA256H is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(Q0=0) | (Rn(Q1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x40)  # oracle: LE byte1 = bits[15:8] of base opcode 0x5E004000 with Rm(V2)<<16 folded in
        expect(b[2]).to_equal(0x02)  # oracle: LE byte2 = bits[23:16] carrying Rm(V2=2) in bits[20:16]
        expect(b[3]).to_equal(0x5E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-SHA top byte

# ============================================================================
# SHA256H2 Q0, Q1, V2.4S => 0x5E005000 | (2<<16) | (1<<5) | 0 = 0x5E025020
# LE bytes: 0x20, 0x50, 0x02, 0x5E
# ============================================================================

# @manual_section: AArch64 SHA-256 encoders
describe "emit_sha256h2 — SHA-256 hash update part 2":
    it "SHA256H2 Q0, Q1, V2 encodes to correct LE bytes":
        step("Encode SHA256H2 with Q0, Q1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian SHA256H2 instruction word
        var b = emit_sha256h2(0, 1, 2)
        expect(b.len()).to_equal(4)  # oracle: SHA256H2 is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x20)  # oracle: LE byte0 = Rd(Q0=0) | (Rn(Q1=1)<<5) = 0x20
        expect(b[1]).to_equal(0x50)  # oracle: LE byte1 = bits[15:8] of base opcode 0x5E005000 with Rm(V2)<<16 folded in
        expect(b[2]).to_equal(0x02)  # oracle: LE byte2 = bits[23:16] carrying Rm(V2=2) in bits[20:16]
        expect(b[3]).to_equal(0x5E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-SHA top byte

# ============================================================================
# SHA256SU0 V1.4S, V2.4S => 0x5E282800 | (2<<5) | 1 = 0x5E282841
# LE bytes: 0x41, 0x28, 0x28, 0x5E
# ============================================================================

# @manual_section: AArch64 SHA-256 encoders
describe "emit_sha256su0 — SHA-256 schedule update 0":
    it "SHA256SU0 V1, V2 encodes to correct LE bytes":
        step("Encode SHA256SU0 with V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
        # @capture(bit_table): 4-byte little-endian SHA256SU0 instruction word
        var b = emit_sha256su0(1, 2)
        expect(b.len()).to_equal(4)  # oracle: SHA256SU0 is a fixed 4-byte AArch64 instruction word
        expect(b[0]).to_equal(0x41)  # oracle: LE byte0 = Rd(V1=1) | (Rn(V2=2)<<5) = 0x41
        expect(b[1]).to_equal(0x28)  # oracle: LE byte1 = bits[15:8] of SHA256SU0 base opcode 0x5E282800
        expect(b[2]).to_equal(0x28)  # oracle: LE byte2 = bits[23:16], SHA256SU0 crypto-SHA class opcode field
        expect(b[3]).to_equal(0x5E)  # oracle: LE byte3 = bits[31:24], AArch64 crypto-SHA top byte

# ============================================================================
# SHA256SU1 V0.4S, V1.4S, V2.4S => 0x5E006000 | (2<<16) | (1<<5) | 0 = 0x5E026020
# LE bytes: 0x20, 0x60, 0x02, 0x5E
# ============================================================================

# @manual_section: AArch64 SHA-256 encoders
describe "emit_sha256su1 — SHA-256 schedule update 1":
    it "SHA256SU1 V0, V1, V2 encodes to correct LE bytes":
        step("Encode SHA256SU1 with V0, V1 and V2 and inspect the emitted bytes")
        # @req REQ-COMPILER-BACKEND-NATIVE-ENCODE-AARCH64-CRYPTO
