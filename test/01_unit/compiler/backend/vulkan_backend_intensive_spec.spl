    it "rejects non-unit parameterized and value-returning Vulkan entry points":
        val backend = VulkanBackend.create_with_options([1, 3], compileoptions_default_options())

        val non_unit_body = vulkan_body_with_signature([], MirTerminator.Ret(nil), [], 0, vulkan_u32())
        val non_unit = backend.compile_kernel("non_unit_vulkan", non_unit_body)
        expect(non_unit.is_err()).to_equal(true)
        assert_backend_error_contains(non_unit.unwrap_err(), "must return Unit")

        val parameter_body = vulkan_body_with_signature(
            [], MirTerminator.Ret(nil), [vulkan_arg(0, 0, vulkan_u32())], 1, MirType.unit()
        )
        val parameterized = backend.compile_kernel("parameterized_vulkan", parameter_body)
        expect(parameterized.is_err()).to_equal(true)
        assert_backend_error_contains(parameterized.unwrap_err(), "require StorageBuffer interface lowering")

        val value_body = vulkan_body_with_signature(
            [], MirTerminator.Ret(Some(vulkan_u32_operand(1))), [], 0, MirType.unit()
        )
        val value_return = backend.compile_kernel("value_return_vulkan", value_body)
        expect(value_return.is_err()).to_equal(true)
        assert_backend_error_contains(value_return.unwrap_err(), "cannot return a value")

        val hidden_arg = backend.compile_kernel(
            "hidden_arg_vulkan",
            vulkan_body_with_signature([], MirTerminator.Ret(nil), [vulkan_arg(0, 0, vulkan_u32())], 0, MirType.unit())
        )
        expect(hidden_arg.is_err()).to_equal(true)
        assert_backend_error_contains(hidden_arg.unwrap_err(), "argument locals require StorageBuffer")

        val negative_arg_count = backend.compile_kernel(
            "negative_arg_count_vulkan",
            vulkan_body_with_signature([], MirTerminator.Ret(nil), [], -1, MirType.unit())
        )
        expect(negative_arg_count.is_err()).to_equal(true)
        assert_backend_error_contains(negative_arg_count.unwrap_err(), "require StorageBuffer interface lowering")

        val oversized_arg_count = backend.compile_kernel(
            "oversized_arg_count_vulkan",
            vulkan_body_with_signature([], MirTerminator.Ret(nil), [], 1, MirType.unit())
        )
        expect(oversized_arg_count.is_err()).to_equal(true)
        assert_backend_error_contains(oversized_arg_count.unwrap_err(), "require StorageBuffer interface lowering")

    it "rejects non-unit returns through compile_module":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: rejects non-unit returns through compile_module")
        val fn_ = vulkan_function_with_signature(
            [vulkan_inst(MirInstKind.GpuGlobalId(vulkan_local(0), 0))],
            MirTerminator.Ret(nil)
        )
        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v spirv-as >/dev/null 2>&1 && command -v spirv-val >/dev/null 2>&1"])
        if available == 0:
            val asm_path = "/tmp/simple_vulkan_intensive.spvasm"
            val bin_path = "/tmp/simple_vulkan_intensive.spv"
            expect(rt_file_write_text(asm_path, output)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("spirv-as", ["--target-env", "vulkan1.3", asm_path, "-o", bin_path])
            expect(as_code).to_equal(0)
            expect(as_err).to_equal("")
            val (_val_out, val_err, val_code) = rt_process_run("spirv-val", ["--target-env", "vulkan1.3", bin_path])
            expect(val_code).to_equal(0)
            expect(val_err).to_equal("")
        else:
            expect(output).to_contain("OpMemoryModel Logical GLSL450")

