use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "LLVM adapter operation policy":
    it "keeps the optimized function opener outside mutable receiver write-back":
        val builder_source = file_read(
            "src/compiler/70.backend/backend/llvm_ir_builder.spl")
        val core_source = file_read(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        expect(builder_source).to_contain("fn llvm_ir_builder_push_line(")
        expect(builder_source).not.to_contain("me start_function_opt(")
        expect(builder_source).not.to_contain(
            "fn llvm_ir_builder_start_function_opt(")
        val scalar_start = core_source.index_of(
            "        else:\n            val param_str = params.join(\", \")")
        val scalar_end = core_source.index_of(
            "        if bootstrap_debug:\n            print \"[mir-to-llvm] function:started")
        val scalar_opener = core_source.substring(scalar_start, scalar_end)
        expect(scalar_opener).to_contain("val param_str = params.join(\", \")")
        expect(scalar_opener).to_contain("var attrs = \" nounwind\"")
        expect(scalar_opener).to_contain("if is_readonly and not placement_naked:")
        expect(scalar_opener).to_contain("attrs = attrs + \" readonly\"")
        expect(scalar_opener).to_contain("if is_small and not placement_naked:")
        expect(scalar_opener).to_contain("attrs = attrs + \" alwaysinline\"")
        expect(scalar_opener).to_contain("Some(id): dbg_suffix = \" !dbg !{id}\"")
        expect(scalar_opener).to_contain(
            "val opening = \"define {effective_ret_ty} @{fn_name}({param_str}){attrs}{dbg_suffix} {{\"")
        val handle_pos = scalar_opener.index_of(
            "val builder_handle = llvm_ir_builder_handle(self.builder)")
        val push_pos = scalar_opener.index_of(
            "llvm_ir_builder_push_line(opening, builder_handle)")
        expect(handle_pos).to_be_less_than(push_pos)
        expect(scalar_opener).not.to_contain(
            "llvm_ir_builder_start_function_opt(")

    it "samples trace and target mode once per direct compile operation":
        val source = file_read(
            "src/compiler/70.backend/backend/llvm_codegen_adapter.spl")
        val direct_start = source.index_of("pub fn llvm_compile_module_direct(")
        val compiled_start = source.index_of(
            "pub fn llvm_compile_module_direct_compiled")
        val impl_start = source.index_of("impl Codegen for LlvmCodegenAdapter")
        val direct = source.substring(direct_start, compiled_start)
        val compiled = source.substring(compiled_start, impl_start)
        expect(direct).to_contain(
            "val trace_enabled = llvm_codegen_trace_enabled()")
        expect(direct).to_contain(
            "val bare_metal = llvm_codegen_bare_metal_requested()")
        expect(direct).not.to_contain("if llvm_codegen_trace_enabled()")
        expect(direct).to_contain("module.functions.len()")
        expect(direct).not.to_contain("module.functions.keys().len()")
        expect(compiled).to_contain(
            "val trace_enabled = llvm_codegen_trace_enabled()")
        expect(compiled).to_contain(
            "val bare_metal = llvm_codegen_bare_metal_requested()")
        expect(compiled).not.to_contain("if llvm_codegen_trace_enabled()")

    it "feeds one target snapshot to config and translator":
        val source = file_read(
            "src/compiler/70.backend/backend/llvm_codegen_adapter.spl")
        expect(source).to_contain(
            "llvm_codegen_target_config_for(options, bare_metal)")
        expect(source).to_contain(
            "llvm_translate_module_direct_ir_for(options, module, bare_metal)")
        expect(source).to_contain(
            "\"app.cli.bootstrap_main\", options.target, bare_metal")
        expect(source).to_contain("[llvm-direct] start")
        expect(source).to_contain("[llvm-direct] done")
        expect(source).to_contain("[llvm-direct] compiled:bytes")

