# The Cranelift AOT lane still emits an object through the lowering it now
# shares with the JIT lane.
#
# cranelift_compile_module_direct and the JIT entry cranelift_jit_run_main both
# go through cranelift_declare_and_compile_functions. This spec executes the
# AOT side end to end: declare, lower, define through the AOT definer, emit,
# read the object back. It passes unchanged on the commit before the lowering
# was shared, so it is the behaviour-preservation check for that refactor.
use std.spec.*
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.backend.backend_types.{compileoptions_default_options}
use compiler.backend.cranelift_codegen_adapter.{cranelift_compile_module_direct}

fn aot_fn(id: i64, name: text, insts: [MirInst], ret: MirOperand) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: id), name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: insts, terminator: MirTerminator.Ret(Some(ret)))],
        entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

fn aot_int(value: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), MirType.i64()))

fn aot_object_size(module: MirModule) -> i64:
    match cranelift_compile_module_direct(compileoptions_default_options(), module):
        case Ok(output):
            if output.has_object_code: output.object_code.len() else: -1
        case Err(error):
            print "aot error: {error.message}"
            -2

describe "Cranelift AOT lane emits an object through the shared lowering":

    it "emits a non-empty object for a module with one function":
        val module = MirModule(name: "aot_const_probe",
            functions: {SymbolId(id: 1): aot_fn(1, "main", [], aot_int(42))},
            statics: {}, constants: {}, types: {})
        expect(aot_object_size(module) > 0).to_equal(true)

    it "emits a non-empty object for a local call and a runtime import":
        val local_callee = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("seven"), MirType.i64()),
            call_origin: MirCallOrigin.Source)
        val runtime_callee = mir_operand_runtime_function("rt_time_now_unix_micros", MirType.i64())
        val module = MirModule(name: "aot_call_probe",
            functions: {
                SymbolId(id: 1): aot_fn(1, "main", [
                    MirInst(kind: MirInstKind.Call(Some(LocalId(id: 0)), local_callee, []), span: nil),
                    MirInst(kind: MirInstKind.Call(Some(LocalId(id: 0)), runtime_callee, []), span: nil)
                ], MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0)))),
                SymbolId(id: 2): aot_fn(2, "seven", [], aot_int(7))
            },
            statics: {}, constants: {}, types: {})
        expect(aot_object_size(module) > 0).to_equal(true)
