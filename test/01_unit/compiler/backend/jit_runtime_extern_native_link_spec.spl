# The pure-Simple JIT links runtime externs natively. The Cranelift provider
# (rt_cranelift_new_module_impl in the Rust seed) registers the seed JIT's own
# runtime symbol table and admits a runtime import only with its
# RuntimeFuncSpec signature, so a Runtime callee the table backs is called
# directly from JIT code.
# Bug: doc/08_tracking/bug/pure_simple_jit_provider_registers_no_runtime_symbols_2026-11-13.md
use std.spec.*
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use compiler.backend.cranelift_codegen_adapter.{cranelift_jit_run_main}

extern fn rt_getpid() -> i64

fn runtime_main(name: text) -> MirModule:
    val callee = mir_operand_runtime_function(name, MirType.i64())
    val main_fn = MirFunction(
        symbol: SymbolId(id: 1), name: "main",
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil,
            instructions: [MirInst(kind: MirInstKind.Call(Some(LocalId(id: 0)), callee, []), span: nil)],
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0))))))],
        entry_block: BlockId(id: 0), span: Span.default(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )
    MirModule(name: "jit_runtime_link", functions: {SymbolId(id: 1): main_fn}, statics: {}, constants: {}, types: {})

fn jit_value(name: text) -> i64:
    match cranelift_jit_run_main(runtime_main(name)):
        case Ok(value): value
        case Err(message):
            print "jit error: {message}"
            -1

describe "pure-Simple JIT links runtime externs natively":

    it "returns the interpreter's process id from rt_getpid":
        expect(jit_value("rt_getpid")).to_equal(rt_getpid())

    it "returns a wall-clock time from rt_time_now_unix_micros":
        expect(jit_value("rt_time_now_unix_micros") > 0).to_equal(true)
