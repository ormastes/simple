"""M-profile (Thumb-only) arch selection for the Cortex-M bare-metal profile."""

use std.spec.{describe, it, expect}
use compiler.backend.backend.llvm_target.{llvm_arm32_baremetal_arch}

describe "Cortex-M bare-metal triple arch":
    it "keeps the M-profile arch instead of collapsing it to armv7":
        # Collapsing to armv7 emitted A32 instructions, which Cortex-M cannot
        # execute: SimpleOS Lite faulted with UsageFault UNDEFINSTR on the first
        # call into the Simple policy object (QEMU MPS2-AN505, 2026-09-19).
        expect(llvm_arm32_baremetal_arch("thumbv8m.main-none-eabi")).to_equal("thumbv8m.main")
        expect(llvm_arm32_baremetal_arch("thumbv7em-none-eabi")).to_equal("thumbv7em")

    it "leaves every non-M-profile ARM selector on armv7":
        expect(llvm_arm32_baremetal_arch("armv7-unknown-none-eabi")).to_equal("armv7")
        expect(llvm_arm32_baremetal_arch("armv7-unknown-linux-gnueabihf")).to_equal("armv7")
        expect(llvm_arm32_baremetal_arch("")).to_equal("armv7")
