use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "Builtin text static lowering":
    it "routes text.from_char_code / text.from_bytes onto the canonical runtime entries":
        val helpers = rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/asm_constraints_helpers.spl") ?? ""
        val core = rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl") ?? ""
        expect(core).to_contain("bare_static_name == \"text.from_char_code\": \"@rt_char_from_code\"")
        expect(core).to_contain("bare_static_name == \"text.from_bytes\": \"@rt_bytes_to_text\"")
        expect(helpers).to_contain("declare ptr @rt_char_from_code(i64)")
        expect(helpers).to_contain("declare ptr @rt_bytes_to_text(ptr)")
        expect(helpers).to_contain("self.defined_func_names[\"rt_bytes_to_text\"] = true")
        expect(helpers).to_contain("self.remember_function_return_type(\"rt_char_from_code\", \"ptr\")")

    it "narrows tagged-int slot [u8] arrays instead of copying slot words":
        val runtime = rt_file_read_text("src/runtime/runtime_native.c") ?? ""
        expect(runtime).to_contain("int64_t copied = rt_array_bytes_copy_checked(bytes_value, narrowed, length);")
