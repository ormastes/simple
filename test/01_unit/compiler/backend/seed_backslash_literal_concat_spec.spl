# Regression pin (test-runner path) for
# seed_interp_double_backslash_literal_concat_drops_2026-11-03, tracked under
# seed_string_literal_escapes_decoded_twice_2026-11-03 (P1).
# The seed double-decodes string-literal escapes on the `bin/simple run` path
# only: there `"\\lld"` is already `lld` (3 chars) BEFORE any concatenation and
# `"x" + "\\lld"` prints `xlld`. Concatenation itself is correct (`"\\" + "lld"`
# keeps the backslash) and the test-runner path decodes once, which is what
# this file pins. The failing-first `run`-path matrix (raw vs normal, `\\n`,
# `\\t`, `\\u{...}`, pure-Simple lexer comparison) is
# test/01_unit/language/string_literal_escape_single_decode_spec.spl.
use std.spec.{describe, it, expect}
describe "escaped backslash inside one literal survives concatenation":
    it "keeps the backslash in a literal starting with an escaped backslash":
        val a = "x" + "\\lld"
        expect(a.len()).to_equal(5)
        expect(a.char_at(1)).to_equal("\\")
    it "does not turn an escaped backslash + n into a newline":
        expect("\\n".len()).to_equal(2)
        expect("\\n".char_at(1)).to_equal("n")
