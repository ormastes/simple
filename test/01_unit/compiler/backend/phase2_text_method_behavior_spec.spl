# Purpose: reproduce the GPU VM budget behavior whose former text method did
# not lower in the Phase 2 native build.
# @cover src/lib/common/gpu/vm_step_budget.spl

use std.spec.*
use std.spec.step
use std.common.gpu.vm_step_budget.{positive_vm_step_budget}

describe "Phase 2 GPU VM step budget parsing":
    it "accepts a positive decimal budget including surrounding whitespace":
        step("Parse a positive value through the shared pure Simple policy")
        expect(positive_vm_step_budget(" 4096 ", 100000)).to_equal(4096)

    it "uses the fallback for invalid input":
        expect(positive_vm_step_budget("not-a-number", 100000)).to_equal(100000)

    it "uses the fallback for zero and negative input":
        expect(positive_vm_step_budget("0", 100000)).to_equal(100000)
        expect(positive_vm_step_budget("-7", 100000)).to_equal(100000)

    it "uses the fallback for decimal overflow":
        step("Use a value one digit beyond signed 64-bit range")
        expect(positive_vm_step_budget("92233720368547758070", 100000)).to_equal(100000)

    it "bounds work and temporary memory for oversized environment values":
        val oversized = "99999999999999999999999999999999999999999999999999999999999999999"
        expect(positive_vm_step_budget(oversized, 100000)).to_equal(100000)
