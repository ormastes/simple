use std.spec.*
use compiler.backend.runtime_compiler.{hosted_c_compiler_plan, hosted_cross_c_target_args}

describe "darwin cross-arch hosted C plan":
    it "admits arm64 -> x86_64 Darwin with clang":
        # @req REQ-SSPEC-COMPILER
        step("admits arm64 -> x86_64 Darwin with clang")
        val plan = hosted_c_compiler_plan("x86_64-apple-darwin", "macos", "aarch64")
        expect(plan.requires_cross).to_be(true)
        expect(plan.supported).to_be(true)
        expect(plan.command).to_equal("clang")

    it "admits x86_64 -> arm64 Darwin with clang":
        # @req REQ-SSPEC-COMPILER
        step("admits x86_64 -> arm64 Darwin with clang")
        val plan = hosted_c_compiler_plan("aarch64-apple-darwin", "macos", "x86_64")
        expect(plan.requires_cross).to_be(true)
        expect(plan.supported).to_be(true)

    it "retargets clang only for the Darwin cross plan":
        # @req REQ-SSPEC-COMPILER
        step("retargets clang only for the Darwin cross plan")
        val cross = hosted_cross_c_target_args("x86_64-apple-darwin", "macos", "aarch64")
        expect(cross.len()).to_equal(1)
        expect(cross[0]).to_equal("--target=x86_64-apple-darwin")
        expect(hosted_cross_c_target_args("aarch64-apple-darwin", "macos", "aarch64").len()).to_equal(0)
        expect(hosted_cross_c_target_args("", "macos", "aarch64").len()).to_equal(0)
        expect(hosted_cross_c_target_args("aarch64-unknown-linux-gnu", "linux", "x86_64").len()).to_equal(0)

    it "keeps sysroot-less cross targets fail-closed":
        # @req REQ-SSPEC-COMPILER
        step("keeps sysroot-less cross targets fail-closed")
        expect(hosted_c_compiler_plan("x86_64-unknown-linux-gnu", "macos", "aarch64").supported).to_be(false)
        expect(hosted_c_compiler_plan("aarch64-unknown-freebsd", "macos", "aarch64").supported).to_be(false)
        expect(hosted_c_compiler_plan("x86_64-apple-darwin", "linux", "x86_64").supported).to_be(false)
        expect(hosted_c_compiler_plan("x86_64-apple-darwin", "freebsd", "aarch64").supported).to_be(false)
