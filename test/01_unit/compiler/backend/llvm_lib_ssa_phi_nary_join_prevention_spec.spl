"""
## Purpose and audience
Purpose: Prevent regression of N-ary `__simple_ssa_phi` lowering in the LLVM C-API plugin backend.
Audience: Compiler engineers maintaining llvm-lib MIR-to-LLVM translation.
"""
# @cover src/plugins/backend_llvm_lib/llvm_lib_translate_expr.spl
# @req REQ-COMPFIX-6

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

fn read_source_text(path: text) -> text:
    match rt_file_read_text(path):
        case Some(content): content
        case None: ""

describe "LLVM-lib N-ary __simple_ssa_phi regression guard":
    it "removes the 4-arg phi abort and handles N-ary pairs with explicit Option match":
        step("Verify llvm_lib_translate_expr.spl collects all predecessor/value phi pairs")
        val source = read_source_text("src/plugins/backend_llvm_lib/llvm_lib_translate_expr.spl")

        expect(source.contains("only supports a single then/else pair")).to_equal(false)
        expect(source).to_contain("args.len() < 4 or (args.len() % 2) != 0")
        expect(source).to_contain("while pair_idx < args.len():")
        expect(source).to_contain("match pred_block:")
        expect(source).to_contain("llvm_add_incoming(phi, incoming_vals, incoming_bbs)")
