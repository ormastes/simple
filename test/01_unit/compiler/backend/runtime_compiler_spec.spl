use std.spec.*
use compiler.backend.backend.runtime_compiler.{find_c_compiler, find_runtime_source_dir, _is_mingw, _is_msvc_cc, _runtime_dir_walk_up, _runtime_dir_not_found_message}
use app.io.mod.{cwd}
use std.io_runtime.{rt_file_read_text, process_run}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text)

fn with_env(key: text, value: text, block: fn()):
    val previous = rt_env_get(key) ?? ""
    rt_env_set(key, value)
    block()
    rt_env_set(key, previous)

describe "Runtime Compiler":
    it "recognizes MSVC-compatible driver spellings without classifying GNU clang":
        expect(_is_msvc_cc("cl")).to_be(true)
        expect(_is_msvc_cc("C:\\VS\\BIN\\CL.EXE")).to_be(true)
        expect(_is_msvc_cc("C:/VS/bin/cl")).to_be(true)
        expect(_is_msvc_cc("C:/LLVM/bin/clang-cl.exe")).to_be(true)
        expect(_is_msvc_cc("C:\\LLVM\\bin\\clang-cl")).to_be(true)
        expect(_is_msvc_cc("clang-cl")).to_be(true)
        expect(_is_msvc_cc("clang.exe")).to_be(false)
        expect(_is_msvc_cc("gcc.exe")).to_be(false)

    it "honors SIMPLE_CC override":
        with_env("SIMPLE_NATIVE_BUILD_TARGET", "aarch64-unknown-linux-gnu", fn():
            with_env("SIMPLE_CC", "/custom/toolchain/cc", fn():
                expect(find_c_compiler()).to_equal("/custom/toolchain/cc")
            )
        )

    it "honors the explicit Windows ABI outside MSYS":
        with_env("SIMPLE_LINKER_FLAVOR", "", fn():
            with_env("MSYSTEM", "", fn():
                with_env("SIMPLE_WINDOWS_ABI", "gnu", fn():
                    expect(_is_mingw()).to_be(true)
                )
                with_env("SIMPLE_WINDOWS_ABI", "msvc", fn():
                    expect(_is_mingw()).to_be(false)
                )
            )
        )

    it "fails closed before host compiler discovery when a cross driver is missing":
        val source = rt_file_read_text("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val finder_pos = source.find("fn find_c_compiler()")
        val discovery_pos = source.find("# Runtime Source Discovery")
        val finder_source = source.substring(finder_pos, discovery_pos)
        val cross_pos = finder_source.find("val plan = hosted_c_compiler_plan")
        val lookup_pos = finder_source.find("command -v {plan.command}")
        val windows_pos = finder_source.find("if _is_windows()")
        val guarded = finder_source.substring(cross_pos, windows_pos)
        expect(cross_pos).to_be_greater_than(-1)
        expect(lookup_pos).to_be_greater_than(cross_pos)
        expect(windows_pos).to_be_greater_than(lookup_pos)
        expect(guarded).to_contain("return \"\"")

    it "cleans every planned runtime object on post-plan failure":
        val source = rt_file_read_text("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val compile_pos = source.find("fn compile_runtime_objects(")
        val cleanup_fn_pos = source.find("fn cleanup_runtime_objects(")
        val compile_source = source.substring(compile_pos, cleanup_fn_pos)
        expect(compile_source.split("cleanup_runtime_objects(objects)").len() - 1).to_equal(4)
        expect(compile_source).to_contain("if not rt_file_exists(src_path):\n            cleanup_runtime_objects(objects)\n            return Err(\"Required runtime source not found")
        expect(compile_source).to_contain("if comp_code != 0:\n            cleanup_runtime_objects(objects)\n            return Err(\"Failed to compile")
        expect(compile_source).to_contain("if object_count == 0:\n        cleanup_runtime_objects(objects)\n        return Err(\"No runtime source files were compiled\")")
        expect(compile_source).to_contain("if object_count < sources.len():\n        cleanup_runtime_objects(objects)\n        return Err(\"Expected ")

    it "includes the contract ABI owner in every fresh hosted runtime bundle":
        val source = rt_file_read_text("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val compile_pos = source.find("fn compile_runtime_objects(")
        val cleanup_fn_pos = source.find("fn cleanup_runtime_objects(")
        val compile_source = source.substring(compile_pos, cleanup_fn_pos)
        val source_entry = "\"runtime_native\", \"runtime_contracts\", \"runtime_rocm\""
        val object_prefix_text = "{" + "object_prefix}"
        val ext_text = "{" + "ext}"
        val contract_object = "\"" + object_prefix_text + "runtime_contracts" + ext_text + "\""
        val object_entry = "\"" + object_prefix_text + "runtime_native" + ext_text + "\",\n        " + contract_object + ",\n        \"" + object_prefix_text + "runtime_rocm" + ext_text + "\""
        expect(compile_source.split("\"runtime_contracts\"").len() - 1).to_equal(1)
        expect(compile_source.split(contract_object).len() - 1).to_equal(1)
        expect(compile_source).to_contain(source_entry)
        expect(compile_source).to_contain(object_entry)
        expect(compile_source.find(source_entry)).to_be_less_than(compile_source.find(object_entry))
        expect(compile_source.find(object_entry)).to_be_less_than(compile_source.find("for name in sources:"))

    it "honors SIMPLE_PROJECT_ROOT override before cwd fallback":
        val project_root = cwd()
        with_env("SIMPLE_PROJECT_ROOT", project_root, fn():
            expect(find_runtime_source_dir()).to_equal("{project_root}/src/runtime")
        )

    it "finds runtime sources from cwd when no override is set":
        with_env("SIMPLE_PROJECT_ROOT", "", fn():
            expect(find_runtime_source_dir()).to_equal("src/runtime")
        )

