use std.spec.*
use compiler.backend.runtime_compiler.{find_c_compiler, find_runtime_source_dir, runtime_abi_policy_v1, runtime_abi_define_args_v1, runtime_core_c_sources_v1, runtime_object_paths_v1, runtime_thread_rust_owner_v1, _is_mingw, _is_msvc_cc, _runtime_dir_walk_up, _runtime_dir_not_found_message}
use compiler.backend.llvm_native_link_runtime_owner.{llvm_runtime_owner_compile_owner_v1}
use app.io.mod.{cwd}
use std.io_runtime.{file_read_nullable, process_run}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text)

fn with_env(key: text, value: text, block: fn()):
    val previous = rt_env_get(key) ?? ""
    rt_env_set(key, value)
    block()
    rt_env_set(key, previous)

describe "Runtime Compiler":
    it "defaults the production runtime ABI policy to selected v1":
        with_env("SIMPLE_ABI_POLICY", "", fn():
            val policy = runtime_abi_policy_v1()
            expect(policy.is_ok()).to_be(true)
            expect(policy.unwrap()).to_equal("v1")
        )

    it "rejects deferred and maps selected v1 to both canonical C defines":
        with_env("SIMPLE_ABI_POLICY", "deferred", fn():
            val policy = runtime_abi_policy_v1()
            expect(policy.is_err()).to_be(true)
            expect(policy.unwrap_err()).to_contain("selected policy is v1")
        )
        with_env("SIMPLE_ABI_POLICY", "v1", fn():
            val policy = runtime_abi_policy_v1()
            expect(policy.is_ok()).to_be(true)
            expect(runtime_abi_define_args_v1(policy.unwrap(), true)).to_equal([
                "/DSIMPLE_ABI_VERSION=1", "/DSIMPLE_ABI_VERSION_DEFERRED=0"])
        )

    it "rejects an unknown runtime ABI policy before producing defines":
        with_env("SIMPLE_ABI_POLICY", "automatic", fn():
            val policy = runtime_abi_policy_v1()
            expect(policy.is_err()).to_be(true)
            expect(policy.unwrap_err()).to_contain("selected policy is v1")
        )

    it "recognizes MSVC-compatible driver spellings without classifying GNU clang":
        expect(_is_msvc_cc("cl")).to_be(true)
        expect(_is_msvc_cc("C:\\VS\\BIN\\CL.EXE")).to_be(true)
        expect(_is_msvc_cc("C:/VS/bin/cl")).to_be(true)
        expect(_is_msvc_cc("C:/LLVM/bin/clang-cl.exe")).to_be(true)
        expect(_is_msvc_cc("C:\\LLVM\\bin\\clang-cl")).to_be(true)
        expect(_is_msvc_cc("clang-cl")).to_be(true)
        expect(_is_msvc_cc("clang.exe")).to_be(false)
        expect(_is_msvc_cc("gcc.exe")).to_be(false)

    it "honors SIMPLE_CC override":
        with_env("SIMPLE_NATIVE_BUILD_TARGET", "aarch64-unknown-linux-gnu", fn():
            with_env("SIMPLE_CC", "/custom/toolchain/cc", fn():
                expect(find_c_compiler()).to_equal("/custom/toolchain/cc")
            )
        )

    it "honors the explicit Windows ABI outside MSYS":
        with_env("SIMPLE_LINKER_FLAVOR", "", fn():
            with_env("MSYSTEM", "", fn():
                with_env("SIMPLE_WINDOWS_ABI", "gnu", fn():
                    expect(_is_mingw()).to_be(true)
                )
                with_env("SIMPLE_WINDOWS_ABI", "msvc", fn():
                    expect(_is_mingw()).to_be(false)
                )
            )
        )

    it "fails closed before host compiler discovery when a cross driver is missing":
        val source = file_read_nullable("src/compiler/70.backend/backend/runtime_host_compiler_v1.spl") ?? ""
        val finder_pos = source.find("fn find_c_compiler()")
        val discovery_pos = source.find("pub fn _cc_verify_compiles(")
        val finder_source = source.substring(finder_pos, discovery_pos)
        val cross_pos = finder_source.find("val plan = hosted_c_compiler_plan")
        val lookup_pos = finder_source.find(r"command -v {plan.command}")
        val windows_pos = finder_source.find("if _is_windows()")
        val guarded = finder_source.substring(cross_pos, windows_pos)
        expect(cross_pos).to_be_greater_than(-1)
        expect(lookup_pos).to_be_greater_than(cross_pos)
        expect(windows_pos).to_be_greater_than(lookup_pos)
        expect(guarded).to_contain("return \"\"")

    it "cleans every planned runtime object on post-plan failure":
        val source = file_read_nullable("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val compile_pos = source.find("fn compile_runtime_objects(")
        val cleanup_fn_pos = source.find("fn cleanup_runtime_objects(")
        val compile_source = source.substring(compile_pos, cleanup_fn_pos)
        expect(compile_source).to_contain("if not file_exists(src_path):\n            cleanup_runtime_objects(objects)\n            return Err(\"Required runtime source not found")
        expect(compile_source).to_contain("match runtime_byte_text_owner_admit_v1(name, src_path, obj_path, runtime_owner, sources):\n            case Ok(_): ()\n            case Err(reason):\n                cleanup_runtime_objects(objects)\n                return Err(reason)")
        val failure_pos = compile_source.find("if comp_code != 0:")
        val failure_end = compile_source.find("object_count = object_count + 1")
        expect(failure_pos).to_be_greater_than(-1)
        expect(failure_end).to_be_greater_than(failure_pos)
        val failure_source = compile_source.substring(failure_pos, failure_end)
        val cleanup_pos = failure_source.find("cleanup_runtime_objects(objects)")
        val return_pos = failure_source.find("return Err(")
        expect(cleanup_pos).to_be_greater_than(-1)
        expect(return_pos).to_be_greater_than(cleanup_pos)
        expect(compile_source).to_contain("if object_count == 0:\n        cleanup_runtime_objects(objects)\n        return Err(\"No runtime source files were compiled\")")
        expect(compile_source).to_contain("if object_count < sources.len():\n        cleanup_runtime_objects(objects)\n        return Err(\"Expected ")

    it "routes runtime compilation through exact canonical I/O owners":
        step("Verify: canonical facades preserve nullable env and direct process semantics")
        val source = file_read_nullable("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val host = file_read_nullable("src/compiler/70.backend/backend/runtime_host_compiler_v1.spl") ?? ""
        for owner in [source, host]:
            expect(owner).to_contain("use std.io_runtime.")
            expect(owner).to_contain("use std.nogc_sync_mut.io.sysinfo_ops.{getpid}")
            for forbidden in ["rt_env_get", "rt_file_exists", "rt_file_delete", "rt_process_run", "rt_getpid"]:
                expect(owner.contains("extern fn " + forbidden)).to_be(false)
        expect(source).to_contain("process_run(cc, comp_args)")
        expect(host).to_contain("process_run(cc, args)")
        expect(host).to_contain("val pid = getpid()")
        expect(source).to_contain("val compile_pid = getpid()")
        # rt_path_absolute remains direct until a nullable facade preserves its
        # failure sentinel instead of narrowing it to non-nullable text.
        expect(source.split("extern fn rt_path_absolute(path: text) -> text?").len() - 1).to_equal(1)
        expect(source.split("file_delete(obj)").len() - 1).to_equal(1)

    it "keeps moved host selection helpers public through the original module boundary":
        val source = file_read_nullable("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val host = file_read_nullable("src/compiler/70.backend/backend/runtime_host_compiler_v1.spl") ?? ""
        expect(source).to_contain("export use compiler.backend.runtime_host_compiler_v1.")
        expect(host).to_contain("pub struct HostedCCompilerPlan:")
        for name in ["find_c_compiler", "_is_windows", "_is_msvc_cc", "_is_mingw", "_get_temp_dir", "_obj_ext",
                "windows_link_flavor_for_target", "hosted_c_compiler_plan", "hosted_cross_c_compiler_name",
                "runtime_compile_trace_enabled", "runtime_abi_policy_v1", "runtime_abi_define_args_v1"]:
            expect(source).to_contain(name)
            expect(host).to_contain("pub fn " + name + "(")

    it "includes the contract ABI owner in every fresh hosted runtime bundle":
        val source = file_read_nullable("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val compile_pos = source.find("fn compile_runtime_objects(")
        val cleanup_fn_pos = source.find("fn cleanup_runtime_objects(")
        val compile_source = source.substring(compile_pos, cleanup_fn_pos)
        # Ordinary and Stage4 profiles retain the initial owner list; core-C
        # selects the shared source plan and uses the same object mapper.
        expect(compile_source.split("\"runtime_contracts\"").len() - 1).to_equal(1)
        expect(compile_source).to_contain("sources = runtime_core_c_sources_v1()")
        expect(compile_source).to_contain("val objects = runtime_object_paths_v1(sources, object_prefix, ext)")
        val core_sources = runtime_core_c_sources_v1()
        var contract_count = 0
        for name in core_sources:
            if name == "runtime_contracts":
                contract_count = contract_count + 1
        expect(contract_count).to_equal(1)
        val objects = runtime_object_paths_v1(core_sources, "build/core/", ".o")
        expect(objects.len()).to_equal(core_sources.len())
        expect(objects).to_contain("build/core/runtime_contracts.o")

    it "selects the Rust thread-handle owner only for runtime owner rust on COFF native-all":
        # owner=rust, native-all (include_dynload=false) on COFF: Rust owns rt_thread_*.
        expect(runtime_thread_rust_owner_v1("rust", false, false, true, "host")).to_equal(true)
        expect(runtime_thread_rust_owner_v1("rust", false, false, false, "x86_64-pc-windows-gnu")).to_equal(true)
        # ELF native-all, dynload, and core-C compositions keep the C owner.
        expect(runtime_thread_rust_owner_v1("rust", false, false, false, "x86_64-unknown-linux-gnu")).to_equal(false)
        expect(runtime_thread_rust_owner_v1("rust", true, false, true, "host")).to_equal(false)
        expect(runtime_thread_rust_owner_v1("rust", false, true, true, "host")).to_equal(false)
        # The default owner c never renames the C thread family itself...
        expect(runtime_thread_rust_owner_v1("c", false, false, true, "host")).to_equal(false)
        # ...but a native-all link that ceding does not cover (windows-gnu)
        # compiles for the rust thread owner, keeping eff83aaa8b4's fix.
        val gnu_owner = llvm_runtime_owner_compile_owner_v1("c", "r/libsimple_native_all.a", false)
        expect(gnu_owner).to_equal("rust")
        expect(runtime_thread_rust_owner_v1(gnu_owner, false, false, false, "x86_64-pc-windows-gnu")).to_equal(true)
        expect(llvm_runtime_owner_compile_owner_v1("c", "r/simple_native_all.lib", true)).to_equal("c")

    it "honors SIMPLE_PROJECT_ROOT override before cwd fallback":
        val project_root = cwd()
        with_env("SIMPLE_PROJECT_ROOT", project_root, fn():
            expect(find_runtime_source_dir()).to_equal("{project_root}/src/runtime")
        )

    it "finds runtime sources from cwd when no override is set":
        with_env("SIMPLE_PROJECT_ROOT", "", fn():
            expect(find_runtime_source_dir()).to_equal("src/runtime")
        )

