# ---------------------------------------------------------------------------
# Regression coverage for the cwd-independent runtime-source discovery fix
# (origin/main 8beeb621c70f, FIX B). `find_runtime_source_dir`'s only
# cwd-independent strategy used to be a fixed 3-level dirname chain from
# /proc/self/exe, which lands on `<root>/bin` for the deployed
# `<root>/bin/release/<triple>/simple` layout and therefore never resolved.
# `_runtime_dir_walk_up` replaced it.
#
# The two cases above only ever observe cwd == repo root, where the plain
# `src/runtime/runtime.c` relative probe already answers. The load-bearing
# cases are the ones where cwd cannot help, so this runs the SAME probe
# program from four different working directories through the real CLI and
# requires the identical absolute answer from each.
# ---------------------------------------------------------------------------

fn probe_rtdir_from(dir: text) -> text:
    val repo = cwd()
    # SIMPLE_PROJECT_ROOT is deliberately cleared: the point is what discovery
    # finds on its own. Exit status is read on the line AFTER the command, never
    # through a pipe.
    val script = "set -u; cd " + dir + " || exit 91; " +
        "SIMPLE_PROJECT_ROOT= " + repo + "/bin/simple run " +
        repo + "/test/fixtures/runtime_source_dir_cwd/probe_runtime_source_dir.spl " +
        "2>/dev/null; echo PROBE_RC=$?"
    val result = process_run("sh", ["-c", script])
    return result.0 + result.1

describe "Runtime source discovery is cwd-independent":
    it "resolves the same runtime source directory from every working directory":
        step("resolve the expected absolute answer once, from the repository root")
        val repo = cwd()
        val expected = "RTDIR={repo}/src/runtime"

        step("probe from the repository root, where the cwd-relative strategy answers first")
        val from_root = probe_rtdir_from(repo)
        expect(from_root).to_contain("PROBE_RC=0")
        # Documented difference in FORM, not in resolution: at the root the
        # plain `src/runtime/runtime.c` probe hits, so the answer is relative.
        # Every cwd below cannot use that strategy and must still resolve.
        expect(from_root).to_contain("RTDIR=src/runtime")

        step("probe from a directory nested deep inside the repository")
        val from_nested = probe_rtdir_from("{repo}/src/compiler/70.backend/backend")
        expect(from_nested).to_contain("PROBE_RC=0")
        expect(from_nested).to_contain(expected)

        step("probe from /tmp, which is outside the repository entirely")
        val from_tmp = probe_rtdir_from("/tmp")
        expect(from_tmp).to_contain("PROBE_RC=0")
        expect(from_tmp).to_contain(expected)

        step("probe from / — the shallowest possible cwd, no ancestor can help")
        val from_slash = probe_rtdir_from("/")
        expect(from_slash).to_contain("PROBE_RC=0")
        expect(from_slash).to_contain(expected)

        step("the answer must never be empty, which is what the old fixed dirname chain returned")
        expect(from_tmp).to_contain("RTDIR=/")

    it "walks up to the tree that holds src/runtime/runtime.c, and stops honestly elsewhere":
        step("an absolute path deep inside the repository resolves to this repository")
        val repo = cwd()
        expect(_runtime_dir_walk_up("{repo}/src/compiler/70.backend/backend")).to_equal("{repo}/src/runtime")

        step("the deployed binary layout <root>/bin/release/<triple>/simple resolves too")
        expect(_runtime_dir_walk_up("{repo}/bin/release/x86_64-unknown-linux-gnu/simple")).to_equal("{repo}/src/runtime")

        step("a path with no such ancestor resolves to nothing rather than guessing")
        expect(_runtime_dir_walk_up("/proc")).to_equal("")

        step("a relative or empty path is rejected outright")
        expect(_runtime_dir_walk_up("src/runtime")).to_equal("")
        expect(_runtime_dir_walk_up("")).to_equal("")

    it "names cwd, the executable and SIMPLE_PROJECT_ROOT when nothing resolves":
        step("read the diagnostic the failure path emits")
        val message = _runtime_dir_not_found_message()

        step("it must blame the search, not the user's program")
        expect(message).to_contain("Runtime source directory not found")
        expect(message).to_contain("SIMPLE_PROJECT_ROOT=")
        expect(message).to_contain("current directory")
        expect(message).to_contain("running executable")
