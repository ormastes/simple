# Regression: macos_native_struct_roundtrip_double_to_ptr_2026_09_21.
# Native counterpart: test/fixtures/macos_struct_roundtrip/main.spl.
use std.spec.step
use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*

describe "LLVM named struct roundtrip representation":
    it "keeps a named struct pointer through the return conversion":
        step("map a named struct and convert its existing pointer return value")
        val llvm = MirToLlvm.create("test.llvm.named_struct", CodegenTarget.AArch64_MacOS, nil)
        val struct_type = MirType(kind: MirTypeKind.Struct(SymbolId(id: 42)))
        val mapped = llvm.llvm_type_text(struct_type)
        expect(mapped).to_equal("ptr")
        llvm.value_types["%returned"] = mapped
        expect(llvm.value_as_type("%returned", mapped, "ptr")).to_equal("%returned")
        expect(llvm.builder.build().contains("double")).to_be(false)

    it "keeps floating point and named aggregate types distinct":
        step("map f64 before and after a named struct with the same translator")
        val llvm = MirToLlvm.create("test.llvm.struct_float", CodegenTarget.AArch64_MacOS, nil)
        expect(llvm.llvm_type_text(MirType.f64())).to_equal("double")
        expect(llvm.llvm_type_text(MirType(kind: MirTypeKind.Struct(SymbolId(id: 17))))).to_equal("ptr")
        expect(llvm.llvm_type_text(MirType.f64())).to_equal("double")
