# A real native qualification gate: two LLVM emitters must overlap on two OS
# threads in one process, and each resulting object must match its serial one.
# @req REQ-GROUP-NATIVE-INNER-THREADS

use std.spec.{describe, it, expect}
use std.spec.step
use std.io_runtime.{env_get_opt}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_exists}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_instructions.{MirModule}
use compiler.common.module_path_naming.{module_logical_name_from_path}
use compiler.backend.backend.backend_types.{CodegenTarget, compileoptions_default_options}
use compiler.backend.backend.llvm_target.{LlvmTargetConfig}
use compiler.backend.backend.group_native_thread_capability.{
    GroupNativeLlvmJobV1, group_native_llvm_qualify_pair_v1,
    group_native_llvm_emit_calibrated_pair_v1,
    group_native_llvm_has_calibration_v1,
    group_native_thread_capability_v1}

fn grouped_thread_fixture_module(name: text) -> MirModule:
    var source = "fn seed(x: i64) -> i64:\n    x + 1\nfn marker() -> text:\n    \"grouped-native\"\n"
    for index in 0..128:
        source = source + "\nfn work_{index}(x: i64) -> i64:\n    (x + {index}) * 3\n"
    val ast = parse_full_frontend(source, "group_thread.spl", "group_thread.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("group_thread.spl")
    val hir = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    var module = mir_lowering.lower_module(hir)
    module.name = name
    module

fn grouped_thread_job(module: MirModule, root: text, stem: text) -> GroupNativeLlvmJobV1:
    var options = compileoptions_default_options()
    options.target = CodegenTarget.X86_64
    val native_entry = env_get_opt("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    val entry_module = if native_entry == "": "" else:
        module_logical_name_from_path(native_entry)
    GroupNativeLlvmJobV1(
        module: module, storage_bindings: [], options: options,
        target: LlvmTargetConfig.for_target_portable_numeric(CodegenTarget.X86_64, nil),
        is_entry: entry_module == "" or entry_module == module.name,
        bootstrap_mode: (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1",
        baseline_object_path: "{root}/{stem}.serial.o",
        baseline_diagnostic_path: "{root}/{stem}.serial.diagnostic",
        object_path: "{root}/{stem}.thread.o",
        diagnostic_path: "{root}/{stem}.thread.diagnostic",
        receipt_path: "{root}/{stem}.thread.receipt")

describe "grouped native LLVM inner-thread qualification", tag: ["only-compiled"]:
    it "observes distinct overlapping OS threads and serial object parity":
        # @req REQ-GROUP-NATIVE-INNER-THREADS
        step("Build two distinct frozen MIR modules and emit serial baselines")
        val temp_parent = env_get_opt("TEMP") ?? "."
        val root = secure_temp_dir(temp_parent, "simple-group-thread-").unwrap()
        val job_a = grouped_thread_job(grouped_thread_fixture_module("test.group_thread_a"), root, "a")
        val job_b = grouped_thread_job(grouped_thread_fixture_module("test.group_thread_b"), root, "b")

        step("Spawn two native LLVM workers with scalar slot and generation handles")
        val result = group_native_llvm_qualify_pair_v1(
            job_a, job_b, 1, "group-thread-spec-calibration")
        expect(result.accepted).to_equal(true)
        expect(result.baseline_status_a).to_equal(0)
        expect(result.baseline_status_b).to_equal(0)
        expect(result.threaded_status_a).to_equal(0)
        expect(result.threaded_status_b).to_equal(0)

        step("Admit two worker threads only from the observed overlap and matching object bytes")
        val capability = group_native_thread_capability_v1(
            "llvm", 2, 2, 2, 1073741824, 268435456, 268435456,
            result.qualification)
        expect(capability.effective_threads).to_equal(2)
        expect(capability.overlap_qualified).to_equal(true)
        expect(capability.object_parity_qualified).to_equal(true)

        step("Reuse the process-local calibration for a new frozen pair without serial baselines")
        expect(group_native_llvm_has_calibration_v1(
            "group-thread-spec-calibration")).to_equal(true)
        val job_c = grouped_thread_job(grouped_thread_fixture_module("test.group_thread_c"), root, "c")
        val job_d = grouped_thread_job(grouped_thread_fixture_module("test.group_thread_d"), root, "d")
        val reused = group_native_llvm_emit_calibrated_pair_v1(
            job_c, job_d, 2, "group-thread-spec-calibration")
        expect(reused.accepted).to_equal(true)
        expect(reused.threaded_status_a).to_equal(0)
        expect(reused.threaded_status_b).to_equal(0)
        expect(reused.execution.?).to_equal(true)
        if val execution = reused.execution:
            expect(execution.thread_id_a == execution.thread_id_b).to_equal(false)
            expect(execution.process_id_a).to_equal(execution.process_id_b)
            expect(execution.llvm_start_us_a < execution.llvm_end_us_b).to_equal(true)
            expect(execution.llvm_start_us_b < execution.llvm_end_us_a).to_equal(true)
        expect(file_exists(job_c.baseline_object_path)).to_equal(false)
        expect(file_exists(job_d.baseline_object_path)).to_equal(false)
        expect(group_native_llvm_has_calibration_v1(
            "different-group-or-policy")).to_equal(false)
        val job_e = grouped_thread_job(grouped_thread_fixture_module("test.group_thread_e"), root, "e")
        val job_f = grouped_thread_job(grouped_thread_fixture_module("test.group_thread_f"), root, "f")
        val drifted = group_native_llvm_emit_calibrated_pair_v1(
            job_e, job_f, 3, "different-group-or-policy")
        expect(drifted.accepted).to_equal(false)
        expect(file_exists(job_e.object_path)).to_equal(false)
        expect(file_exists(job_f.object_path)).to_equal(false)

    it "fails closed without a native qualification receipt":
        # @req REQ-GROUP-NATIVE-INNER-THREADS
        val capability = group_native_thread_capability_v1(
            "llvm", 2, 2, 2, 1073741824, 268435456, 268435456, nil)
        expect(capability.effective_threads).to_equal(1)
        expect(capability.overlap_qualified).to_equal(false)
