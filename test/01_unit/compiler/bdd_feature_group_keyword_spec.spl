# Reproducer: `feature "..."` must work as a top-level BDD grouping block.
#
# Bug: doc/08_tracking/bug/feature_block_not_a_bdd_keyword_2026-08-04.md
#
# Before the fix, the BDD grouping keywords were hard-coded to exactly
# `describe` and `context` in both seed lanes:
#   - src/compiler_rust/compiler/src/interpreter_call/bdd.rs   (interpreter)
#   - src/compiler_rust/compiler/src/hir/lower/stmt_lowering.rs (HIR/JIT)
# so a `feature` block fell through to ordinary function resolution and the
# WHOLE FILE died with `error[E1002]: function `feature` not found` before a
# single example was registered:
#
#     error[E1002]: function `feature` not found
#     error: test-runner: no examples executed
#     Results: 1 total, 0 passed, 1 failed
#
# 300 `it` blocks across 10 spec files were dead entry points for this reason.
# NOTE: the second example below is deliberately NOT named "...registers each
# example separately, not as one synthetic failure". That name reproduces a
# SEPARATE, pre-existing defect found while writing this spec -- the file-level
# verdict is text-scavenged from child stdout, so an example NAME containing
# both "example" and "failure" forges the count. See
# doc/08_tracking/bug/spec_verdict_forgeable_from_example_name_2026-08-17.md
#
# This file is deliberately rooted in `feature` so that a regression cannot
# quietly downgrade it to "1 synthetic failure" without the count changing.

use std.spipe.*

fn double(n: i64) -> i64:
    n * 2

feature "feature block is a real BDD grouping keyword":

    it "runs examples declared directly inside a feature block":
        expect double(21) to_equal 42

    it "registers each block separately, not as one synthetic error":
        expect double(0) to_equal 0

    scenario "nested scenario groups inside a feature":

        it "runs examples nested one level down":
            expect double(5) to_equal 10

        it "keeps ordinary assertions working at depth":
            val xs = [1, 2, 3]
            expect xs.len() to_equal 3

    context "context still nests inside a feature":

        it "mixes Gherkin and RSpec grouping keywords in one tree":
            expect double(3) to_equal 6
