# @req: REQ-COMP-SFFI-U8-RETURN-MARSHALLING-DEFECT-CLASS-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove that SFFI [u8] return marshalling — defect class.
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""

"""
# SFFI `[u8]` Return Marshalling — Defect-Class Sweep

**Feature IDs:** N/A
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Implemented

## Overview

Class-level companion to `sffi_byte_array_return_not_option_spec.spl`.

That spec pins ONE family (`signature_sffi`'s sign wrappers). This one sweeps
the SIBLING externs that share the same declared shape — a raw `extern fn`
whose return type is a plain `[u8]` — to prove the historical
`Option::Some([bytes])` mis-binding is absent across the class, not just at the
one call site that originally reported it.

Positive control: `rt_bytes_alloc(24)` must return an array whose `.len()` is
exactly 24 — a value the marshaller had to actually compute and transport, so a
green sweep cannot come from a stubbed-out or never-loaded extern path.

Defect B of `sffi_u8_return_nil_and_cross_engine_len_2026-08-18` (JIT reporting
`rt_bytes_alloc(n).len() == 0`) is fixed by the packed-byte bridge in
`runtime_bridge.rs`; the cases below pin the length for several sizes so an
interpreter and a `run` (JIT-eligible) path must agree. Defect A is closed by
the `[u8]?` declaration of `rt_file_read_bytes`
(`fs_extern_optional_spec.spl`).

tag: unit, compiler, sffi
"""

use std.spipe.*
use std.spec.step

extern fn rt_bytes_alloc(len: i64) -> [u8]
extern fn rt_byte_array_new(cap: i64) -> [u8]
extern fn rt_bytes_from_raw(ptr: i64, len: i64) -> [u8]

describe "SFFI [u8] return marshalling — defect class":
    # @manual scenario evidence

    it "positive control: rt_bytes_alloc(24) transports a real 24-byte array":
        # @req REQ-SSPEC-COMPILER
        step("positive control: rt_bytes_alloc(24) transports a real 24-byte array")
        step("Verify: positive control: rt_bytes_alloc(24) transports a real 24-byte array")
        # @req: REQ-COMP-SFFI-U8-RETURN-MARSHALLING-DEFECT-CLASS-001
        val buf = rt_bytes_alloc(24)
        expect(buf.len()).to_equal(24)

    it "positive control: rt_bytes_alloc(1) is length 1, not a constant":
        # @req REQ-SSPEC-COMPILER
        step("positive control: rt_bytes_alloc(1) is length 1, not a constant")
        step("Verify: positive control: rt_bytes_alloc(1) is length 1, not a constant")
        val buf = rt_bytes_alloc(1)
        expect(buf.len()).to_equal(1)

    it "rt_byte_array_new declared -> [u8] binds an array":
        # @req REQ-SSPEC-COMPILER
        step("rt_byte_array_new declared -> [u8] binds an array")
        step("Verify: rt_byte_array_new declared -> [u8] binds an array")
        val buf = rt_byte_array_new(8)
        expect(buf.len() >= 0).to_equal(true)

    it "rt_bytes_from_raw(0, 0) declared -> [u8] binds an empty array":
        # @req REQ-SSPEC-COMPILER
        step("rt_bytes_from_raw(0, 0) declared -> [u8] binds an empty array")
        step("Verify: rt_bytes_from_raw(0, 0) declared -> [u8] binds an empty array")
        val buf = rt_bytes_from_raw(0, 0)
        expect(buf.len()).to_equal(0)


    it "rt_bytes_alloc length is the requested size across sizes (engine parity)":
        # @req REQ-SSPEC-COMPILER
        step("rt_bytes_alloc length is the requested size across sizes (engine parity)")
        step("Verify: rt_bytes_alloc length is the requested size across sizes (engine parity)")
        expect(rt_bytes_alloc(0).len()).to_equal(0)
        expect(rt_bytes_alloc(7).len()).to_equal(7)
        expect(rt_bytes_alloc(4096).len()).to_equal(4096)

    it "rt_bytes_alloc elements are zero-filled and readable":
        # @req REQ-SSPEC-COMPILER
        step("rt_bytes_alloc elements are zero-filled and readable")
        step("Verify: rt_bytes_alloc elements are zero-filled and readable")
        val buf = rt_bytes_alloc(4)
        expect(buf[0]).to_equal(0)
        expect(buf[3]).to_equal(0)
