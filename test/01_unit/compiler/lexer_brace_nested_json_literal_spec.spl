# @tag:in-development
# Repro: doc/08_tracking/bug/string_literal_nested_json_drops_closing_brace_silently_2026-11-12.md
# Two JSON object literals written the same way behave differently: the
# W-STR-BRACE-001 "kept as literal" region rule keeps `{}}` whole, while a
# non-empty nested object loses one `}` (`}}` collapses) and the text becomes
# invalid JSON with no error surfaced to the author or the spec runner.
# Expected to FAIL until the malformed-brace warning is ratcheted to an error
# or the region rule is applied consistently.
use std.spec
use std.spec.step
use std.common.json.value.{json_parse_value_strict}

describe "nested JSON object literals in plain text literals":
    it "round-trips an empty and a non-empty nested object the same way":
        step("both literals end in two closing braces")
        val empty_nested = "{\"p\":{}}"
        val filled_nested = "{\"p\":{\"x\":1}}"
        val empty_ok = json_parse_value_strict(empty_nested).is_ok()
        val filled_ok = json_parse_value_strict(filled_nested).is_ok()
        expect(empty_ok).to_equal(filled_ok)
        expect(filled_ok).to_equal(true)
