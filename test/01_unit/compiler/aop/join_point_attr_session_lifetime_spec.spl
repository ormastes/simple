# AUTHORED / UNRUN. Actual BuildSession end_with owner with injected end result.
use std.spec
use compiler.frontend.join_point_attr_registry.*
use compiler.driver.session.build_session.{SessionEndPort, SessionKept, build_session_inactive}

fn attr_end_refused_v3(heap: u32) -> bool:
    false

fn attr_end_accepted_v3(heap: u32) -> bool:
    true

describe "join-point attribute session edge":
    it "preserves live metadata when heap teardown refuses":
        val epoch = join_point_attr_begin_epoch_v2()
        join_point_attr_record("owner.spl", "f", ["logged"])
        val session = build_session_inactive()
        session.heap = 7u32
        expect(session.end_with(SessionKept(all_ok: true, session_active: true),
            SessionEndPort(heap_end: attr_end_refused_v3))).to_equal(false)
        expect(join_point_attr_names_of("owner.spl", "f")).to_equal(["logged"])
        expect(join_point_attr_epoch_matches_v2("owner.spl", "f", epoch)).to_equal(true)

    it "invalidates only after successful teardown and requires a new epoch":
        val epoch = join_point_attr_begin_epoch_v2()
        join_point_attr_record("owner.spl", "f", ["logged"])
        val session = build_session_inactive()
        session.heap = 7u32
        expect(session.end_with(SessionKept(all_ok: true, session_active: true),
            SessionEndPort(heap_end: attr_end_accepted_v3))).to_equal(true)
        expect(join_point_attr_names_of("owner.spl", "f")).to_equal([])
        expect(join_point_attr_epoch_matches_v2("owner.spl", "f", epoch)).to_equal(false)
        val next = join_point_attr_begin_epoch_v2()
        expect(next).to_be_greater_than(epoch)
        expect(join_point_attr_names_of("owner.spl", "f")).to_equal([])
