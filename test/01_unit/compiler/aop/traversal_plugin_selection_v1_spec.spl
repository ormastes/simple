# AUTHORED / UNRUN. Structural identity checks, not signed loader admission.
use std.spec
use compiler.common.cache_contract.traversal_plugin_selection_v1.*
use compiler.common.cache_contract.aspect_plugin_model_v1.*
use compiler.common.cache_contract.aspect_traversal_v1.*
use compiler.common.cache_contract.aspect_match_shard_v1.{PointcutSelectorV1, WeavePlanDeltaV1}

fn selection_test_value() -> TraversalPluginDescriptorV1:
    val code = "sha256:" + "1".repeat(64)
    val instance = plugin_instance_descriptor_v1(PluginDefinitionV1(code_digest: code,
        fields: [PluginConfigFieldV1(name: "entry", role: PluginFieldRoleV1.Instance)]),
        [PluginConfigValueV1(name: "entry", value: "fixture.visit")]).unwrap()
    TraversalPluginDescriptorV1(provider_id: "fixture", provider_code_digest: code, entry_identity: "fixture.visit",
        abi_schema: "fixture.checked/v1", policy_identity: "sha256:" + "3".repeat(64), instance: instance)

describe "checked traversal selection identity":
    it "binds provider entry ABI and full instance identity but not runtime token":
        val value = selection_test_value()
        val identity = traversal_descriptor_identity_v1(value).unwrap()
        val first = TraversalPluginSelectionV1(provider_token: 1, canonical_identity: identity)
        val second = TraversalPluginSelectionV1(provider_token: 2, canonical_identity: identity)
        expect(traversal_selection_identity_v1(first).unwrap()).to_equal(
            traversal_selection_identity_v1(second).unwrap())
        expect(traversal_descriptor_identity_v1(TraversalPluginDescriptorV1(..value,
            entry_identity: "fixture.other")).unwrap() == identity).to_equal(false)
        expect(traversal_descriptor_identity_v1(TraversalPluginDescriptorV1(..value,
            abi_schema: "fixture.checked/v2")).unwrap() == identity).to_equal(false)
        expect(traversal_descriptor_identity_v1(TraversalPluginDescriptorV1(..value,
            provider_code_digest: "sha256:" + "2".repeat(64))).unwrap() == identity).to_equal(false)
        expect(traversal_bind_ordered_identity_v1("ordered", nil).unwrap()).to_equal("ordered")
        expect(traversal_bind_ordered_identity_v1("ordered", Some(first)).unwrap() == "ordered").to_equal(false)

    it "rejects corrupt descriptor identity and invalid or oversized fields":
        val value = selection_test_value()
        val corrupt = PluginInstanceDescriptorV1(..value.instance, canonical_identity: "changed")
        expect(traversal_descriptor_identity_v1(TraversalPluginDescriptorV1(..value,
            instance: corrupt)).is_err()).to_equal(true)
        expect(traversal_selection_identity_v1(TraversalPluginSelectionV1(
            provider_token: 0, canonical_identity: "forged")).is_err()).to_equal(true)
        expect(traversal_descriptor_identity_v1(TraversalPluginDescriptorV1(..value,
            entry_identity: "")).is_err()).to_equal(true)
        expect(traversal_descriptor_identity_v1(TraversalPluginDescriptorV1(..value,
            abi_schema: "x".repeat(65537))).is_err()).to_equal(true)

    it "requires exact complete delta lists rather than just a matching count":
        val expected = WeavePlanDeltaV1(weave: ["a::f"], unweave: [], reweave: [], reuse: [])
        expect(traversal_delta_equal_v1(expected, expected)).to_equal(true)
        expect(traversal_delta_equal_v1(expected,
            WeavePlanDeltaV1(weave: ["a::g"], unweave: [], reweave: [], reuse: []))).to_equal(false)
        expect(traversal_delta_equal_v1(expected,
            WeavePlanDeltaV1(weave: ["a::f"], unweave: ["a::g"], reweave: [], reuse: []))).to_equal(false)

    it "separately binds signed source and public trust-root identities":
        val policy = "sha256:" + "4".repeat(64)
        val root = "sha256:" + "5".repeat(64)
        val identity = traversal_policy_identity_v1(policy, root).unwrap()
        expect(traversal_policy_identity_v1(root, policy).unwrap() == identity).to_equal(false)
        expect(traversal_policy_identity_v1(policy, "sha256:" + "6".repeat(64)).unwrap() == identity).to_equal(false)
        expect(traversal_policy_identity_v1("path/to/policy", root).is_err()).to_equal(true)
