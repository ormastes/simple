# AUTHORED / UNRUN. Real constructors, no substitute admission implementation.
use std.spec
use compiler.common.driver_compile_options.{driver_core_compile_options_default,
    traversal_plugin_provider_request_v1}
use compiler.common.cache_contract.traversal_plugin_selection_v1.{TraversalPluginSelectionV1}
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver.{compiler_driver_create, compiler_driver_create_with_traversal_plugin_v1}

describe "checked construction rejects before context publication":
    it "returns errors through all ordinary factories for an explicit unresolved request":
        var options = driver_core_compile_options_default()
        options.traversal_plugin_request_v1 = Some(traversal_plugin_provider_request_v1(
            "unissued", "/missing/policy.sdn", "/missing/policy.sig").unwrap())
        expect(CompileContext.create(options).is_err()).to_equal(true)
        expect(CompilerDriver.create(options).is_err()).to_equal(true)
        expect(compiler_driver_create(options).is_err()).to_equal(true)

    it "does not treat matching option text and a fabricated token as admitted":
        var options = driver_core_compile_options_default()
        options.traversal_plugin_request_v1 = Some(traversal_plugin_provider_request_v1(
            "unissued", "/missing/policy.sdn", "/missing/policy.sig").unwrap())
        options.traversal_plugin_resolved_identity_v1 = "forged"
        val selected = Some(TraversalPluginSelectionV1(provider_token: 1, canonical_identity: "forged"))
        expect(CompileContext.create_with_traversal_plugin_v1(options, selected).is_err()).to_equal(true)
        expect(compiler_driver_create_with_traversal_plugin_v1(options, selected).is_err()).to_equal(true)

    it "refuses an identity without a provider request":
        var options = driver_core_compile_options_default()
        options.traversal_plugin_resolved_identity_v1 = "forged"
        expect(CompileContext.create(options).is_err()).to_equal(true)
        expect(compiler_driver_create(options).is_err()).to_equal(true)
