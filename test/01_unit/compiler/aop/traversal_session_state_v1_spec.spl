# AUTHORED / UNRUN. Real common owner; this does not qualify native restoration.
use std.spec
use compiler.common.cache_contract.traversal_session_state_v1.{TraversalSessionStateV1}

describe "traversal epoch ownership":
    it "does not certify the same woven epoch as fresh":
        val state = TraversalSessionStateV1.create()
        expect(state.begin_epoch(1)).to_equal(true)
        state.started_epoch = 1
        state.completed_epoch = 1
        state.output_lease = 3
        expect(state.begin_epoch(1)).to_equal(false)
        expect(state.epoch_admitted).to_equal(false)
        expect(state.started_epoch).to_equal(1)
        expect(state.output_lease).to_equal(3)

    it "begins a new source epoch without inventing a live allocation session":
        val state = TraversalSessionStateV1.create()
        expect(state.begin_epoch(1)).to_equal(true)
        state.cache_session = 17
        state.cache_initialized = true
        state.started_epoch = 1
        state.completed_epoch = 1
        state.output_lease = 3
        expect(state.begin_epoch(2)).to_equal(true)
        expect(state.started_epoch).to_equal(0)
        expect(state.completed_epoch).to_equal(0)
        expect(state.output_lease).to_equal(0)
        expect(state.cache_session).to_equal(17)
        expect(state.cache_initialized).to_equal(true)

    it "rejects zero and keeps independently created owners separate":
        val first = TraversalSessionStateV1.create()
        val second = TraversalSessionStateV1.create()
        expect(first.begin_epoch(0)).to_equal(false)
        expect(first.epoch_admitted).to_equal(false)
        expect(first.begin_epoch(9)).to_equal(true)
        first.reuse_hits = 4
        expect(second.source_epoch).to_equal(0)
        expect(second.reuse_hits).to_equal(0)
