# @req: REQ-GEN-COMPILER-001

# Regression: a module global written inside a `fn` MUST be visible to every
# function that `fn` then calls — not only after it returns.
#
# Bug: doc/08_tracking/bug/module_global_write_invisible_to_callee_2026-07-27.md
# Interpreter-only defect (the JIT uses real .data slots and was always right).
# Module globals are copy-in / write-back in the Rust seed interpreter: the
# callee rebuilt its env from the *committed* owner map, which was only refreshed
# when the writer returned, so every callee read the pre-call snapshot. Fixed by
# publishing the writing frame's global overlay at call entry
# (`interpreter_call/core/function_exec.rs` `publish_live_owned_globals`).
#
# Each fixture writer returns what its CALLEE observed, so every expectation
# below is an assertion about the callee's mid-write view. The spec runner
# executes on the interpreter, which is the engine that was broken; the same
# assertions also hold on the JIT.
use std.spec.{describe, it, expect}
use test.fixtures.global_write_visibility.gwv_owner.{
    gwv_reset,
    gwv_read_n,
    gwv_read_len,
    gwv_read_at,
    gwv_w_scalar,
    gwv_w_array,
    gwv_w_indexed,
    gwv_w_push_loop,
    gwv_w_nested_if,
    gwv_w_midwrite,
    gwv_w_scalar_xmod,
    gwv_w_array_xmod,
    gwv_w_indexed_xmod,
    gwv_w_push_loop_xmod,
    gwv_w_nested_if_xmod,
    gwv_w_then_return_n,
}

use std.spec.step

describe "module global write is visible to a callee":
    it "scalar assignment is visible to a same-module callee":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: scalar assignment is visible to a same-module callee")
        gwv_reset()
        expect gwv_w_scalar() == 42

    it "whole-array assignment is visible to a same-module callee":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: whole-array assignment is visible to a same-module callee")
        gwv_reset()
        expect gwv_w_array() == 7

    it "indexed assignment is visible to a same-module callee":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: indexed assignment is visible to a same-module callee")
        gwv_reset()
        expect gwv_w_indexed() == 55

    it "push loop growth is visible to a same-module callee":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: push loop growth is visible to a same-module callee")
        gwv_reset()
        expect gwv_w_push_loop() == 7

    it "assignment nested in if/while is visible to a same-module callee":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: assignment nested in if/while is visible to a same-module callee")
        gwv_reset()
        expect gwv_w_nested_if() == 777

    it "callee sees the write that precedes it, not the one that follows":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: callee sees the write that precedes it, not the one that follows")
        gwv_reset()
        expect gwv_w_midwrite() == 11

describe "module global write is visible across a module boundary":
    it "scalar assignment is visible to a callee in another module":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: scalar assignment is visible to a callee in another module")
        gwv_reset()
        expect gwv_w_scalar_xmod() == 43

    it "whole-array assignment is visible to a callee in another module":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: whole-array assignment is visible to a callee in another module")
        gwv_reset()
        expect gwv_w_array_xmod() == 8

    it "indexed assignment is visible to a callee in another module":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: indexed assignment is visible to a callee in another module")
        gwv_reset()
        expect gwv_w_indexed_xmod() == 56

    it "push loop growth is visible to a callee in another module":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: push loop growth is visible to a callee in another module")
        gwv_reset()
        expect gwv_w_push_loop_xmod() == 7

    it "assignment nested in if/while is visible to a callee in another module":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: assignment nested in if/while is visible to a callee in another module")
        gwv_reset()
        expect gwv_w_nested_if_xmod() == 778

describe "module global write-back on return still works":
    it "value written by a returned writer stays visible afterwards":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: value written by a returned writer stays visible afterwards")
        gwv_reset()
        gwv_w_then_return_n()
        expect gwv_read_n() == 99

    it "reset republishes the initial values":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: reset republishes the initial values")
        gwv_reset()
        expect gwv_read_n() == 0
        expect gwv_read_len() == 4
        expect gwv_read_at(2) == 0
