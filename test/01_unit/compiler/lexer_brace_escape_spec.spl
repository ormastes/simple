use std.spec

# Regression: doc/08_tracking/bug/runtime_surface_spec_brace_escape_contains_red_2026-08-17.md
# Contract: in double-quoted text literals, `{{` renders a literal `{` and
# `}}` renders a literal `}` — with or WITHOUT any `{expr}` interpolation in
# the same literal. A briefly-landed lexer variant preserved doubled braces
# when the literal had no interpolation, breaking `.contains()` needles.
# Expected strings are built by CONCATENATION so this spec never depends on
# the very escape feature under test.

fn open_brace() -> text:
    "{"

fn close_brace() -> text:
    "}"

describe "text literal double-brace escapes":
    it "renders {{ as a single literal open brace":
        val s = "{{"
        expect(s.len()).to_equal(1)
        expect(s).to_equal(open_brace())

    it "renders }} as a single literal close brace":
        val s = "}}"
        expect(s.len()).to_equal(1)
        expect(s).to_equal(close_brace())

    it "collapses doubled braces inside a non-interpolated literal":
        val s = "a{{b}}c"
        expect(s.len()).to_equal(5)
        expect(s).to_equal("a" + open_brace() + "b" + close_brace() + "c")

    it "collapses doubled braces alongside a real interpolation":
        val name = "x"
        val s = "{{lit}} {name}"
        expect(s.len()).to_equal(7)
        expect(s).to_equal(open_brace() + "lit" + close_brace() + " x")
