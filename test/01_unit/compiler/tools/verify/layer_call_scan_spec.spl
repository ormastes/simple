"""
## Purpose and audience
Purpose: Prove that layer_call_scan.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-TOOLS-001 — stable requirement identity for this spec.

# Spec for layer_call_scan.spl (M1 of doc/03_plan/compiler/forwarding/
# zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md).
#
# BINARY PROVENANCE: run under bin/simple, which on this tree resolves to
# the self-hosted binary at bin/release/x86_64-unknown-linux-gnu/simple
# (verified via `readlink -f bin/simple` before writing this spec) — not
# the Rust seed.
#
# Real-text-scan proof: this spec writes REAL fixture .spl files to disk
# under src/lib/ and scans them with scan_file_calls/scan_layer_calls, the
# same real-source-text approach noalloc_manifest_scan_spec.spl uses for its
# PROBE_PATH fixture. It does not fabricate ScannedModuleCalls values by
# hand — every assertion below is against what the scanner actually read
# off disk.
#
# Fixtures use a real, resolvable `use std.X` import
# (`use std._layer_call_scan_spec_fixture.callee.{helper_fn}`) so they are
# genuinely valid Simple source under src/lib/ (whole-program compilation
# discovers every .spl file there, so an unresolvable fixture import would
# break unrelated specs, not just this one) — and so layer_call_scan's
# "std." -> "src/lib/" resolution rule is exercised against a real,
# existing file, not a hand-built ScannedModuleCalls value.

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.common.string_core.{char_from_code}
use compiler.tools.verify.layer_call_scan.{scan_file_calls, scan_layer_calls, layer_call_edges}

# Fixture source text is built via concatenation with these, never as a
# literal '{'/'}' inside a text literal — Simple text literals treat an
# unescaped '{' as the start of string interpolation (see
# .claude/memory reference_text_literal_css_braces_parse_as_interpolation.md),
# so a literal "...{helper_fn}..." in THIS spec's own source would try to
# evaluate `helper_fn` as an expression in the spec's scope and fail to
# compile the spec itself, before any fixture is ever written to disk.
val OB = char_from_code(123)
val CB = char_from_code(125)

val FIXTURE_DIR = "src/lib/_layer_call_scan_spec_fixture"
val CALLEE_PATH = FIXTURE_DIR + "/callee.spl"
val CALLER_PATH = FIXTURE_DIR + "/caller.spl"

# UNRESOLVED_DIR lives under test/, NOT src/lib/ — whole-program compilation
# discovers every .spl file under src/lib/ (the stdlib is fully compiled for
# every run), so a fixture whose import deliberately does not resolve must
# stay outside that tree or it would break unrelated specs. Files under
# test/ are only reached by an explicit `bin/simple test <path>` or import,
# so this probe is never compiled — only ever file_read by the scanner.
val UNRESOLVED_DIR = "test/01_unit/compiler/tools/verify/_layer_call_scan_unresolved_fixture"
val UNRESOLVED_PATH = UNRESOLVED_DIR + "/probe.spl"

val CALLEE_SOURCE = "fn helper_fn() -> i64:\n    1\n\nexport helper_fn\n"
val CALLER_SOURCE = "use std._layer_call_scan_spec_fixture.callee." + OB + "helper_fn" + CB
    + "\n\nfn local_noise() -> i64:\n    3\n\nfn probe() -> i64:\n    local_noise()\n    helper_fn()\n"

fn _setup():
    dir_create_all(FIXTURE_DIR)
    file_write(CALLEE_PATH, CALLEE_SOURCE)
    file_write(CALLER_PATH, CALLER_SOURCE)

fn _teardown():
    file_delete(CALLEE_PATH)
    file_delete(CALLER_PATH)
    dir_remove_all(FIXTURE_DIR)

describe "layer_call_scan":

    it "attributes a bare-ident call to the module its symbol was imported from":
        step("Verify: attributes a bare-ident call to the module its symbol was imported from")
        # @req: REQ-COMPILER-TOOLS-001
        _setup()
        val scanned = scan_file_calls(CALLER_PATH)
        _teardown()

        expect(scanned.module_path).to_equal(CALLER_PATH)
        expect(scanned.callee_modules.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(scanned.callee_modules[0]).to_equal(CALLEE_PATH)

    it "does not attribute a call to a bare identifier with no matching import (e.g. 'local_noise')":
        step("Verify: does not attribute a call to a bare identifier with no matching import (e.g. 'local_noise')")
        _setup()
        val scanned = scan_file_calls(CALLER_PATH)
        _teardown()

        # probe() calls BOTH local_noise() (no `use` line names it) and
        # helper_fn() (imported from callee.spl). Only the imported one may
        # be attributed — a bare identifier match alone is not enough.
        expect(scanned.callee_modules.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(scanned.callee_modules[0]).to_equal(CALLEE_PATH)

    it "drops an import that does not resolve to a real file on disk":
        step("Verify: drops an import that does not resolve to a real file on disk")
        dir_create_all(UNRESOLVED_DIR)
        val unresolved_source = "use totally.nonexistent.module_xyz." + OB + "ghost_fn" + CB
            + "\n\nfn probe():\n    ghost_fn()\n"
        file_write(UNRESOLVED_PATH, unresolved_source)
        val scanned = scan_file_calls(UNRESOLVED_PATH)
        file_delete(UNRESOLVED_PATH)
        dir_remove_all(UNRESOLVED_DIR)

        expect(scanned.callee_modules.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "walks a directory and builds the caller->callees edge list":
        step("Verify: walks a directory and builds the caller->callees edge list")
        _setup()
        val edges = layer_call_edges(FIXTURE_DIR)
        _teardown()

        var found = false
        for entry in edges:
            if entry.has(CALLER_PATH):
                found = true
                expect(entry[CALLER_PATH].len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
                expect(entry[CALLER_PATH][0]).to_equal(CALLEE_PATH)
        expect(found).to_equal(true)
