"""
# Static Runner Runtime Facade Contract

The static leak-check runner keeps missing-source policy locally while the
canonical I/O facade owns its single failure-as-empty source read.
"""

use std.io_runtime.{read_file_text}
use std.spec.*

describe "static runner runtime facade ownership":
    it "preserves guarded one-read failure-as-empty semantics":
        step("Load the production static runner source")
        val source = read_file_text("src/compiler/90.tools/leak_check/static_runner.spl")

        step("Require the canonical facade and exactly one guarded read")
        expect(source).to_contain("use std.io_runtime.{file_exists, read_file_text}")
        expect(source.split("file_exists(cfg.source_file)").len()).to_equal(2)
        expect(source.split("read_file_text(cfg.source_file)").len()).to_equal(2)
        expect(source).to_contain("if not file_exists(cfg.source_file):\n        print \"Error: source file not found: {cfg.source_file}\"\n        result.exit_code = 1\n        result.verdict = \"fail\"\n        return result\n\n    val source_text = read_file_text(cfg.source_file)")
        expect(source).to_contain("val source_text = read_file_text(cfg.source_file)\n    result.static_violations = analyze_static_source_text(source_text)")

        step("Reject duplicate raw ownership while preserving the local API")
        expect(source).to_not_contain("extern fn rt_file_read_text")
        expect(source).to_not_contain("rt_file_read_text(")
        expect(source).to_contain("fn run_static_check(cfg: LeakCheckConfig) -> LeakCheckResult:")
