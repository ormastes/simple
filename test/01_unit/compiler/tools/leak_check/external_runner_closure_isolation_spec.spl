"""
# External Runner Driver Closure Isolation Contract

Ensures `src/compiler/90.tools/leak_check/external_runner.spl` does not import
`compiler.driver.*` or `app.compile.*` (which previously dragged a 1,551-module
driver closure into leak_check HIR units) and routes C++ generation through an
out-of-process CLI invocation via `find_simple_binary()`.
"""

use std.io_runtime.{read_file_text}
use std.spec.step

describe "leak-check external runner driver closure isolation":
    it "has zero compiler.driver or app.compile imports":
        step("Load external_runner.spl source")
        val source = read_file_text("src/compiler/90.tools/leak_check/external_runner.spl")

        step("Verify driver/compile imports are absent")
        expect(source).to_not_contain("compiler.driver.")
        expect(source).to_not_contain("compiler.common.driver_compile_result")
        expect(source).to_not_contain("app.compile.")
        expect(source).to_not_contain("aot_c_file(")

    it "routes C++ generation through subprocess simple compile --emit-c":
        step("Load external_runner.spl source")
        val source = read_file_text("src/compiler/90.tools/leak_check/external_runner.spl")

        step("Verify find_simple_binary and process_run compile invocation")
        expect(source).to_contain("fn find_simple_binary() -> text:")
        expect(source).to_contain("process_run(simple_bin, [\"compile\", cfg.source_file, \"--emit-c\", \"-o\", temp_cpp])")
