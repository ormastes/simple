# Stable E0002 parser diagnostics for `simple check`.
# Bug: simple_check_diagnostics_contract_raw_parser_error_not_stable_format_2026-07-20

use std.spec
use compiler.tools.lint.check_diagnostic.{CheckDiagnostic, check_parser_diagnostic, check_diagnostic_text, check_diagnostic_json}

describe "check_parser_diagnostic":
    it "maps an unexpected-token error to stable E0002 with expected/found/help":
        val d = check_parser_diagnostic("a.spl", "line 3:1: unexpected token in expression: Dedent ''")
        expect(d.code).to_equal("E0002")
        expect(d.message).to_equal("unexpected token")
        expect(d.line).to_equal(3)
        expect(d.column).to_equal(1)
        expect(d.expected).to_equal("expression")
        expect(d.found).to_equal("Dedent")
        expect(d.help).to_equal("try adding `expression` before this token")

    it "renders the contract text lines":
        val d = check_parser_diagnostic("a.spl", "line 3:1: unexpected token in expression: Dedent ''")
        val text = check_diagnostic_text(d)
        expect(text).to_contain("error[E0002]: unexpected token")
        expect(text).to_contain("expected: expression")
        expect(text).to_contain("found:    Dedent")
        expect(text).to_contain("= help: try adding `expression` before this token")

    it "serializes the contract JSON fields":
        val d = check_parser_diagnostic("a.spl", "line 3:1: unexpected token in expression: Dedent ''")
        val json = check_diagnostic_json(d)
        expect(json).to_contain("\"code\": \"E0002\"")
        expect(json).to_contain("\"expected\": \"expression\"")
        expect(json).to_contain("\"found\": \"Dedent\"")

    it "keeps other parser messages as E0002 with the original message":
        val d = check_parser_diagnostic("a.spl", "line 7:2: expected ':' after condition")
        expect(d.code).to_equal("E0002")
        expect(d.message).to_equal("expected ':' after condition")
        expect(d.line).to_equal(7)
        expect(d.column).to_equal(2)
        expect(d.expected).to_equal("")

    it "tolerates text without a line prefix":
        val d = check_parser_diagnostic("a.spl", "boom")
        expect(d.code).to_equal("E0002")
        expect(d.message).to_equal("boom")
        expect(d.line).to_equal(0)
