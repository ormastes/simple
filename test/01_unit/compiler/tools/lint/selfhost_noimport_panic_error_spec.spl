# Bug: selfhost_noimport_carveouts_error_panic_blockdsl_nilname_2026-08-01
# `panic` is a resolver builtin; a bare free-function `error` has no provider and must stay a loud error.

use std.spec
use compiler.tools.lint.semantic_check.{simple_semantic_check_source}

describe "self-hosted no-import carve-outs: panic vs error":
    it "resolves panic(...) as a builtin with no unresolved-name diagnostic":
        val src = "fn f(x: i64) -> i64:\n    if x < 0:\n        panic(\"neg\")\n    x\n"
        val result = simple_semantic_check_source(src, "panic_ok.spl")
        var joined = ""
        for d in result.diagnostics:
            joined = joined + d + "\n"
        expect(joined.contains("unresolved name: panic")).to_equal(false)

    it "keeps a bare free-function error(...) as an unresolved name":
        val src = "fn f(x: i64) -> i64:\n    error(\"bad\")\n    x\n"
        val result = simple_semantic_check_source(src, "error_bad.spl")
        var joined = ""
        for d in result.diagnostics:
            joined = joined + d + "\n"
        expect(joined.contains("unresolved name: error")).to_equal(true)
