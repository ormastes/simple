# Emits the real C-header generator output for a scalar-only exported API.
use compiler.tools.header_gen.c_header.{emit_c_header}
use compiler.mir.mir_data.*
use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}

fn main():
    val scalar = MirFunction(
        symbol: SymbolId(id: 1), name: "probe_scalar",
        signature: MirSignature(
            params: [MirType.i64()], return_type: MirType.bool(),
            is_variadic: false),
        locals: [], blocks: [], entry_block: BlockId.entry(),
        span: Span(start: 0, end: 0, line: 1, col: 1, file: "", length: 0),
        generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil,
        is_kernel: false, is_export_c: true, export_name: "",
        driver_manifest_attr: nil)
    val module = MirModule(
        name: "c_mode_probe", functions: {}, statics: {},
        constants: {}, types: {})
    print emit_c_header("c_mode_probe", [scalar], [], module)
