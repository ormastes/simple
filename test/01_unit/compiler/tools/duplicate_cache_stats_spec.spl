use compiler.tools.duplicate_check.cache.{TokenCache, TokenCacheManager, get_cache_stats}
use compiler.tools.duplicate_check.tokenizer.{SimpleToken, SimpleTokenKind}

fn token(value: text) -> SimpleToken:
    SimpleToken(kind: SimpleTokenKind.Identifier, value: value,
        line: 1, column: 1, start_offset: 0, end_offset: value.len())

describe "Duplicate-check cache statistics":
    it "reports cached files and total retained tokens":
        val manager = TokenCacheManager(cache: {
            "a.spl": TokenCache(file_path: "a.spl", mtime: 1, source_hash: "a",
                tokens: [token("a")], content: "a"),
            "b.spl": TokenCache(file_path: "b.spl", mtime: 1, source_hash: "b",
                tokens: [token("b"), token("c")], content: "b c")
        })
        expect(get_cache_stats(manager)).to_equal("Cache: 2 files, 3 tokens")
