# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# # Formatter Core Unit Tests
#
# Direct in-process tests of `compiler.tools.formatter`
# (src/compiler/90.tools/formatter/main.spl) via `Formatter.format_source`,
# feeding literal source strings (no file I/O, no subprocess). See
# test/03_system/app/fmt_doccov_contract_spec.spl for the CLI-level contract
# (subprocess, fixtures, exit codes for `--check`/`--write`).
#
# Known seed-only caveat (2026-07-17): under both `run <spec>` and
# `test <spec>` on src/compiler_rust/target/release/simple, the 5 examples
# below genuinely execute and pass ("5 examples, 0 failures" /
# "Passed: 5"), but the file-level result is still reported FAIL / the
# process exits nonzero. This is the same seed/interpreter exit-code-taint
# class already documented for other specs (see
# test/01_unit/app/io/process_limits_enforcement_spec.spl and
# doc/08_tracking/bug/host_toolchain_seed_pinned_lint_fmt_doccov_unrunnable_2026-07-17.md)
# -- not a defect in the formatter logic under test here.

use compiler.tools.formatter.main.{make_formatter, formatter_gap_fingerprint}

extern fn rt_file_read_text(path: text) -> text

fn formatted_or_fail(source: text) -> text:
    val fmt = make_formatter()
    val result = fmt.format_source(source)
    match result:
        case Ok(formatted):
            formatted
        case Err(e):
            "FORMAT_ERROR: {e}"

describe "compiler.tools.formatter Formatter.format_source":
    # @manual scenario evidence
    """Feeds literal source strings directly to the formatter and checks
    specific, real rewrites it performs (not just "output != input")."""

    it "adds spaces around a binary + operator":
        # @req REQ-SSPEC-UNIT
        step("adds spaces around a binary + operator")
        val out = formatted_or_fail("fn add(a: i64, b: i64) -> i64:\n    a+b\n")
        assert_contains(out, "a + b")

    it "adds a space after a comma in a parameter list":
        # @req REQ-SSPEC-UNIT
        step("adds a space after a comma in a parameter list")
        val out = formatted_or_fail("fn add(a:i64,b:i64) -> i64:\n    a + b\n")
        assert_contains(out, "a:i64, b:i64")

    it "adds spaces around the -> return-type arrow":
        # @req REQ-SSPEC-UNIT
        step("adds spaces around the -> return-type arrow")
        val out = formatted_or_fail("fn add(a: i64, b: i64)->i64:\n    a + b\n")
        assert_contains(out, ") -> i64:")

    it "preserves a hyphenated word in a full-line comment verbatim":
        # @req REQ-SSPEC-UNIT
        step("preserves a hyphenated word in a full-line comment verbatim")
        """Regression: add_expression_spacing used to run on comment lines
        too, rewriting `pure-Simple` to `pure - Simple` and tripping the
        formatter's own lexical-equivalence guard (fixed 2026-07-17; see
        doc/08_tracking/bug/host_toolchain_seed_pinned_lint_fmt_doccov_unrunnable_2026-07-17.md)."""
        val out = formatted_or_fail("# a pure-Simple comment\nfn add(a: i64, b: i64) -> i64:\n    a + b\n")
        assert_contains(out, "# a pure-Simple comment")

    it "keeps docstring prose verbatim instead of operator-spacing it":
        # @req REQ-SSPEC-UNIT
        step("keeps docstring prose verbatim instead of operator-spacing it")
        """Regression (2026-10-20): `Non-UTF-8` / `U+FFFD` inside a docstring
        were rewritten to `Non - UTF - 8` / `U + FFFD`, which the lexical
        guard then refused, so `fmt --check` failed on base_encoding.spl."""
        val src = "fn bytes_to_text(data: [u8]) -> text:\n    \"\"\"Interpret bytes as UTF-8.\n\n    Non-UTF-8 bytes become U+FFFD.\n    \"\"\"\n    \"\"\n"
        val out = formatted_or_fail(src)
        assert_contains(out, "    Non-UTF-8 bytes become U+FFFD.")
        assert_equal(out, src)

    it "leaves a long line unbroken when breaking it would change its tokens":
        # @req REQ-SSPEC-UNIT
        step("leaves a long line unbroken when breaking it would change its tokens")
        """Regression (2026-10-20): the heuristic breakers split a long `if`
        condition into a non-equivalent token stream; the whole file was then
        refused. A long line is valid Simple, a rewritten one is not."""
        val cond = "if (b2 & 0xC0) == 0x80 and (b3 & 0xC0) == 0x80 and cp >= 0x800 and not (cp >= 0xD800 and cp <= 0xDFFF):"
        val src = "fn check(b2: i64, b3: i64, cp: i64) -> bool:\n    " + cond + "\n        return true\n    false\n"
        val out = formatted_or_fail(src)
        assert_contains(out, cond)

    it "is idempotent: formatting already-formatted source changes nothing":
        # @req REQ-SSPEC-UNIT
        step("is idempotent: formatting already-formatted source changes nothing")
        val once = formatted_or_fail("fn add(a:i64,b:i64)->i64:\n    a+b\n")
        val twice = formatted_or_fail(once)
        assert_equal(once, twice)

    it "frames multiple skipped comments without changing bytes or order":
        val gap = "  # first\n\n # second\n"
        assert_equal(
            formatter_gap_fingerprint(gap, false),
            "comment:7:# first\ncomment:8:# second\n"
        )

    it "assembles formatter fingerprints from fragments once":
        val source = rt_file_read_text("src/compiler/90.tools/formatter/main.spl") ?? ""
        assert_contains(source, "parts.push(\"token:")
        assert_contains(source, "return Ok(parts.join(\"\"))")
        assert_equal(source.contains("result = result +"), false)

describe "compiler.tools.formatter unary minus and power operator":
    """Unary minus and `**` must format without refusal and keep their meaning;
    binary minus stays binary; output is idempotent."""

    it "formats the ** power operator (src/lib/common/math.spl refusal)":
        step("formats the ** power operator")
        val out = formatted_or_fail("fn p(x: f64) -> f64:\n    x ** 0.5\n")
        assert_equal(out, "fn p(x: f64) -> f64:\n    x ** 0.5\n")

    it "keeps unary minus attached to its operand":
        step("keeps unary minus attached to its operand")
        val src = "fn u(a: i64, b: i64) -> i64:\n    val y = -a\n    val z = a * -b\n    val w = -(a + b)\n    val c = -1\n    f(a, -b)\n    -a\n"
        val out = formatted_or_fail(src)
        assert_equal(out, src)

    it "keeps binary minus binary":
        step("keeps binary minus binary")
        val out = formatted_or_fail("fn s(a: i64, b: i64) -> i64:\n    a-b\n")
        assert_contains(out, "a - b")
        val out2 = formatted_or_fail("fn s(a: i64, b: i64) -> i64:\n    a - -b\n")
        assert_contains(out2, "a - -b")

    it "is idempotent over unary minus and **":
        step("is idempotent over unary minus and **")
        val once = formatted_or_fail("fn q(a: f64, b: f64) -> f64:\n    val t = a** -b\n    -t - a\n")
        assert_equal(formatted_or_fail(once), once)
