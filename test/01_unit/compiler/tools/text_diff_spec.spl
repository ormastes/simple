# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

"""
## Purpose and audience

Purpose: pin that `compute_diff` emits the FINAL hunk when the changed lines run
to the end of the input. The porter left the terminal-flush predicate as the
unresolved name `has_current_lines`, so the last hunk was never emitted (and the
module did not resolve at all). Audience: compiler tooling engineers.

## Operator workflow

`bin/simple test test/01_unit/compiler/tools/text_diff_spec.spl`
"""

use std.spec.{describe, it, expect}
use compiler.90.tools.text_diff.{compute_diff, count_additions, count_deletions, format_unified}

describe "text_diff — terminal hunk flush":

    context "a change at the end of the input":
        it "emits one hunk for a trailing addition":
            val d = compute_diff("a\nb\nc", "a\nb\nc\nd")
            expect(d.hunks.len()).to_equal(1)

        it "counts the trailing addition":
            val d = compute_diff("a\nb\nc", "a\nb\nc\nd")
            expect(count_additions(d)).to_equal(1)

        it "emits one hunk for a trailing deletion":
            val d = compute_diff("a\nb\nc\nd", "a\nb\nc")
            expect(d.hunks.len()).to_equal(1)

        it "counts the trailing deletion":
            val d = compute_diff("a\nb\nc\nd", "a\nb\nc")
            expect(count_deletions(d)).to_equal(1)

        it "reports the trailing hunk in unified output":
            val d = compute_diff("a\nb\nc", "a\nb\nc\nd")
            val out = format_unified(d, "old.txt", "new.txt")
            expect(out.contains("+d")).to_equal(true)

    context "a change in the middle keeps working":
        it "emits a hunk for a mid-stream replacement":
            val d = compute_diff("a\nb\nc\nd\ne\nf\ng\nh", "a\nb\nc\nX\ne\nf\ng\nh")
            expect(d.hunks.len()).to_equal(1)

        it "counts one addition and one deletion":
            val d = compute_diff("a\nb\nc\nd\ne\nf\ng\nh", "a\nb\nc\nX\ne\nf\ng\nh")
            expect(count_additions(d) + count_deletions(d)).to_equal(2)

    context "identical input":
        it "produces no hunks":
            val d = compute_diff("a\nb\nc", "a\nb\nc")
            expect(d.hunks.len()).to_equal(0)
