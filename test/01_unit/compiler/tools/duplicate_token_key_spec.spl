# Purpose and audience: regression spec for stable duplicate-check token keys.
# @req REQ-SSPEC-UNIT
# @cover src/compiler/90.tools/duplicate_check/tokenizer.spl 80%
"""
# Duplicate Check Token Key Specification

Token keys feed cosine buckets, so they must be deterministic text. Interpolating
an enum field printed a per-object address (`<enum@0x..>` seed, `<value:0x..>`
native) and collapsed every bucket (bug dupcheck_enum_interpolation_erased_value).
"""
use std.spec.step

use compiler.tools.duplicate_check.tokenizer.{SimpleToken, SimpleTokenKind, token_to_string}

describe "Duplicate Check token_to_string":
    it "renders the kind name, not an address":
        step("keyword and identifier keys are stable names")
        val kw = SimpleToken(kind: SimpleTokenKind.Keyword, value: "fn", line: 1, column: 1, start_offset: 0, end_offset: 2)
        val id = SimpleToken(kind: SimpleTokenKind.Identifier, value: "x", line: 1, column: 4, start_offset: 3, end_offset: 4)
        expect(token_to_string(kw)).to_equal("SimpleTokenKind::Keyword:fn")
        expect(token_to_string(id)).to_equal("SimpleTokenKind::Identifier:x")
