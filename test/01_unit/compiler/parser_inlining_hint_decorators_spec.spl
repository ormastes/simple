# Inlining-hint decorators must be recognised by the interpreter, not rejected as unknown.
#
# @manual_section Compiler annotations

use std.spipe.*

# Reproduces doc/08_tracking/bug/origin_main_not_test_runnable_always_inline_decorator_2026-08-26.md.
# `@always_inline` is a real annotation -- the LLVM backend reads it and applies the
# `alwaysinline` attribute (codegen/llvm/backend_core.rs) -- but the interpreter's decorator
# skip-list omitted it, so loading ANY module carrying one aborted with
# `unknown decorator @always_inline`. 18 stdlib files under src/lib carry it, all on the
# compiler's startup path, so `bin/simple test` could not run at all.
#
# These declarations are the oracle: on a seed without the fix this file fails to LOAD, so the
# scenarios below never report. That is the reproduction -- a decorator defect cannot be caught
# by an assertion inside the function it decorates.

@always_inline
fn hinted_always(a: i64) -> i64:
    a + 1

@inline
fn hinted_inline(a: i64) -> i64:
    a + 2

@force_inline
fn hinted_force(a: i64) -> i64:
    a + 3

# Generalization: the same hint on the shape that actually broke main -- an optional return
# whose body is an unsafe block wrapping an extern. This is the neighbouring defect class:
# the hint must survive on functions that are not plain arithmetic.
extern fn rt_file_mmap_read_text(path: text) -> text?

@always_inline
fn hinted_optional_unsafe(path: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_file_mmap_read_text(path)

describe "A developer annotates a function with an inlining hint":
    """
    Inlining hints are advice to the optimiser, never a change in meaning. Whichever engine
    runs the code, an annotated function must load and behave exactly as the unannotated one
    would. A hint the compiler does not recognise must not be able to take the whole toolchain
    down -- which is precisely what happened when the interpreter did not know this one.
    """

    # @req REQ-COMPILER-DECORATOR-001
    it "runs an @always_inline function and gets the same answer as without the hint":
        step("Call the annotated function -- reaching this line at all proves the module loaded")
        assert_equal(hinted_always(41), 42)
        step("The hint is advice only: the result is the plain arithmetic result")
        assert_equal(hinted_always(0), 1)

    # @req REQ-COMPILER-DECORATOR-001
    it "accepts the sibling inlining hints rather than only the one that broke":
        step("@inline and @force_inline are read by the same backend path and must load too")
        assert_equal(hinted_inline(40), 42)
        assert_equal(hinted_force(39), 42)

    # @req REQ-COMPILER-DECORATOR-001
    it "keeps the hint working on the exact shape that made main un-test-runnable":
        step("Optional return, body an unsafe block around an extern -- file_ops.spl's shape")
        step("Calling it on a path that does not exist must answer nil, not abort")
        assert_nil(hinted_optional_unsafe("/nonexistent/path/for/this/spec"))
