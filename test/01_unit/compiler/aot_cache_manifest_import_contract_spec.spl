extern fn rt_file_read_text(path: text) -> text

fn assert_cache_manifest_imports_at_module_scope(path: text):
    val source = rt_file_read_text(path) ?? ""
    expect(source.contains("use compiler.driver.cache.cache_validator.{source_to_cache_path}")).to_equal(true)
    expect(source.contains("use compiler.driver.watcher.smf_manifest.{update_smf_manifest_entry}")).to_equal(true)
    expect(source.contains("            use compiler.driver.cache.cache_validator")).to_equal(false)
    expect(source.contains("            use compiler.driver.watcher.smf_manifest")).to_equal(false)

describe("AOT cache manifest import ownership"):
    it("binds AOT pipeline cache helpers at module scope"):
        assert_cache_manifest_imports_at_module_scope("src/compiler/driver/driver_aot_pipeline.spl")

    it("binds watcher cache helpers at module scope"):
        assert_cache_manifest_imports_at_module_scope("src/compiler/driver/watcher/watcher_daemon.spl")
        val source = rt_file_read_text("src/compiler/driver/watcher/watcher_daemon.spl") ?? ""
        expect(source.contains("        use compiler.driver.driver_api_compile_single")).to_equal(false)

    it("binds SMF dependency hash lookup at module scope"):
        val source = rt_file_read_text("src/compiler/driver/driver_aot_smf_output.spl") ?? ""
        expect(source.contains("use compiler.driver.cache.cache_validator.{get_shb_interface_hash}")).to_equal(true)
        expect(source.contains("    use compiler.driver.cache.cache_validator")).to_equal(false)
