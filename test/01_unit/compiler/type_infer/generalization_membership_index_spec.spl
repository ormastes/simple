"""
## Purpose and audience

This spec pins the HM generalization membership indexes in
`src/compiler/30.types/type_infer/generalization.spl`: which type variables
a `generalize` call quantifies (environment-free variables only, scheme
boundaries excluded), in what order (first encounter, deduplicated), and
through which containers (ordered arrays for output, dictionaries for
membership). It is written for engineers changing type inference
generalization and for operators verifying that a quantifier change did not
silently widen polymorphism or reorder quantified variables.

## Operator workflow

Run this file with
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/compiler/type_infer/generalization_membership_index_spec.spl`.
A green verdict means every generalization scenario quantifies exactly the
variables the Hindley-Milner level discipline requires, in encounter order.

## Compatibility and limitations

- Level filtering differs between `generalize` (current level only) and
  `generalize_all` (every level); both scenarios are pinned so neither can
  drift independently.
- The source-contract scenario asserts properties of the shipped
  generalization source because the container choice (dict membership, no
  linear scans) has no runtime API of its own; it is a contract on the
  implementation shape the ordered-output guarantees rest on.
- On this host the JIT lowers one imported-module match to the interpreter
  (jit-fallback warning); scenario verdicts are unaffected.

## Verification guidance and troubleshooting

Rerun the single file with the operator command above. A failing
"excludes/does not treat" scenario means generalization now quantifies a
variable owned by the environment — the classic let-polymorphism unsoundness
(Too Genuine: a binder escapes its level). A failing "deduplicates" scenario
means quantified variable order drifted; downstream monomorphisation
instants are order-sensitive, so re-review any emitted-code diffs before
shrugging. A failing source-contract scenario means a linear membership
scan (`contains`) was reintroduced into generalization — restore the dict
membership index or re-derive the complexity budget first.
"""

# Lifecycle: research doc/01_research/compiler/compiler_mdsoc_design.md ;
# plan doc/03_plan/compiler/bootstrap_debug_test_observability.md ;
# architecture doc/04_architecture/compiler/00_compiler_architecture.md ;
# design doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md
# @manual_section: hm-generalization-membership

use compiler.types.type_infer_types.*
use compiler.types.type_infer.context.*
use compiler.types.type_infer.core.*
use compiler.types.type_infer.generalization.*
use compiler.hir.hir.*
use compiler.frontend.core.lexer.*
use std.spec.step

fn gen_span() -> Span:
    lex_span_empty()

fn gen_fn(params: [HirType], ret: HirType) -> HirType:
    HirType(kind: HirTypeKind.Function(params, ret, []), span: gen_span())

fn gen_tuple(elements: [HirType]) -> HirType:
    HirType(kind: HirTypeKind.Tuple(elements), span: gen_span())

fn gen_var_id(ty: HirType) -> i64:
    match ty.kind:
        case Infer(id, _): id
        case _: -1

describe "HM generalization membership indexes":
    it "excludes a free variable owned by the outer environment":
        # @req REQ-TI-GMI-001
        # @capture(statistics): the quantified-variable list for an outer-env free variable, retained for review
        step("Generalize a function mixing one outer-level and one inner-level free variable")
        var ctx = HmInferContext.new()
        ctx.enter_level()
        val outer = ctx.fresh_var(gen_span())
        ctx.exit_level()
        ctx.bind_mono("outer", outer)
        ctx.enter_level()
        val local = ctx.fresh_var(gen_span())
        ctx.exit_level()

        val scheme = ctx.generalize(gen_fn([outer, local], outer))
        expect(scheme.vars).to_equal([gen_var_id(local)])  # oracle: only the inner-level variable is generalizable; the mono-bound outer variable must stay monomorphic

    it "does not treat a scheme-bound variable as environment-free":
        # @req REQ-TI-GMI-002
        # @capture(statistics): the quantified-variable list past a poly environment binder, retained for review
        step("Bind one variable as polymorphic in the environment, then generalize it again")
        var ctx = HmInferContext.new()
        ctx.enter_level()
        val bound = ctx.fresh_var(gen_span())
        ctx.exit_level()
        val bound_id = gen_var_id(bound)
        ctx.bind_poly("poly", TypeScheme(vars: [bound_id], ty: gen_fn([bound], bound)))

        val scheme = ctx.generalize(bound)
        expect(scheme.vars).to_equal([bound_id])  # oracle: the scheme-bound variable is owned by the new scheme, not excluded as env-free

    it "deduplicates nested repeated variables in first encounter order":
        # @req REQ-TI-GMI-003
        # @capture(statistics): the deduplicated quantifier order over a nested type, retained for review
        step("Generalize a nested function/tuple type where variables repeat across levels of the type")
        var ctx = HmInferContext.new()
        ctx.enter_level()
        val first = ctx.fresh_var(gen_span())
        val second = ctx.fresh_var(gen_span())
        val third = ctx.fresh_var(gen_span())
        ctx.exit_level()

        val nested = gen_fn(
            [gen_tuple([second, first, second]), gen_fn([third, first], second)],
            gen_tuple([third, first]))
        val scheme = ctx.generalize(nested)
        expect(scheme.vars).to_equal([
            gen_var_id(second), gen_var_id(first), gen_var_id(third)])  # oracle: first encounter order — second, then first, then third — each exactly once

    it "keeps the same ordered owner for generalize and generalize_all":
        # @req REQ-TI-GMI-004
        # @capture(statistics): the two quantifier lists side by side, retained for review
        step("Generalize one type both level-filtered and unfiltered, then compare owners")
        var ctx = HmInferContext.new()
        val current = ctx.fresh_var(gen_span())
        ctx.enter_level()
        val deeper = ctx.fresh_var(gen_span())
        ctx.exit_level()
        val ty = gen_tuple([deeper, current, deeper, current])

        expect(ctx.generalize(ty).vars).to_equal([gen_var_id(deeper)])  # oracle: level filtering admits only the deeper-level variable
        expect(ctx.generalize_all(ty).vars).to_equal([
            gen_var_id(deeper), gen_var_id(current)])  # oracle: unfiltered generalization owns both levels in encounter order

    it "deduplicates after applying substitutions":
        # @req REQ-TI-GMI-005
        # @capture(statistics): the post-unification quantifier list, retained for review
        step("Unify an alias variable onto its owner, then generalize a tuple mentioning both")
        var ctx = HmInferContext.new()
        ctx.enter_level()
        val alias = ctx.fresh_var(gen_span())
        val owner = ctx.fresh_var(gen_span())
        expect(ctx.unify(alias, owner).is_ok()).to_equal(true)  # oracle: the unification itself must succeed for the scenario to mean anything
        ctx.exit_level()

        val scheme = ctx.generalize(gen_tuple([alias, owner, alias]))
        val resolved_owner = gen_var_id(ctx.resolve(owner))
        expect(scheme.vars).to_equal([resolved_owner])  # oracle: substitution collapses alias and owner to one quantified variable

describe "HM generalization membership-index source contract":
    it "uses dictionaries only for membership and retains an ordered output":
        # @req REQ-TI-GMI-006
        # @capture(bit_table): the container-contract checklist verdicts for the shipped generalization source, retained for review
        step("Read the shipped generalization source and evaluate each container-contract clause")
        val source = file_read("src/compiler/30.types/type_infer/generalization.spl")
        val env_free_collected_into_dict = source.contains("me env_free_var_ids() -> Dict<i64, bool>:")
        val bound_vars_is_a_dict = source.contains("var bound_vars: Dict<i64, bool> = {}")
        val output_is_an_ordered_array = source.contains("var to_generalize: [i64] = []")
        val seen_is_a_dict_twice = source.count("var seen: Dict<i64, bool> = {}" )
        val bound_gate_appears_once = source.count("if not bound_vars.has(id):")
        val env_gate_appears_twice = source.count("if not env_vars.has(id)")
        val seen_gate_appears_twice = source.count("if not seen.has(id):")
        val seen_marks_appear_twice = source.count("seen[id] = true")
        val push_retains_order_twice = source.count("to_generalize = to_generalize.push(id)")
        val no_scheme_vars_scan = source.contains("scheme.vars.contains(id)")
        val no_env_vars_scan = source.contains("env_vars.contains(id)")
        val no_output_scan = source.contains("to_generalize.contains(id)")
        expect(env_free_collected_into_dict).to_equal(true)  # oracle: env-free collection is keyed, not scanned
        expect(bound_vars_is_a_dict).to_equal(true)  # oracle: scheme binders gate via O(1) dict membership
        expect(output_is_an_ordered_array).to_equal(true)  # oracle: quantifier order comes from this array's push order
        expect(seen_is_a_dict_twice).to_equal(2)  # oracle: both generalization entry points carry their own seen-set declaration
        expect(bound_gate_appears_once).to_equal(1)  # oracle: the binder gate is shared, not duplicated per entry point
        expect(env_gate_appears_twice).to_equal(2)  # oracle: each entry point gates against the environment once
        expect(seen_gate_appears_twice).to_equal(2)  # oracle: each entry point dedupes through its seen-set gate
        expect(seen_marks_appear_twice).to_equal(2)  # oracle: each gate is paired with exactly one membership mark
        expect(push_retains_order_twice).to_equal(2)  # oracle: both entry points append in encounter order
        expect(no_scheme_vars_scan).to_equal(false)  # oracle: a linear scheme.vars scan would regress the index contract
        expect(no_env_vars_scan).to_equal(false)  # oracle: a linear env scan would regress the index contract
        expect(no_output_scan).to_equal(false)  # oracle: a linear output scan would regress the index contract
