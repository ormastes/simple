        expect(ctx.caller_assumes_bound(Some(f.generic_fn), gcc_named(f.param_id, []), gcc_bound(f.param_id, gcc_named(f.trait_id, [])))).to_equal(false)

    it "generic_calls.spl:88 c1 true: caller has no bounds":
