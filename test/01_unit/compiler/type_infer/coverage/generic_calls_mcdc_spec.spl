describe "generic_calls.spl finish_direct_function_bounds":
    it "generic_calls.spl:115 c1 true: no context drains pending calls without errors":
        # @req REQ-GEN-COV-GENCALLS-046
        val f = gcc_fixture()
        var ctx = HmInferContext.new()
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [gcc_infer()], nil)]
        ctx.finish_direct_function_bounds()
        expect(ctx.pending_bound_calls.len()).to_equal(0)
        expect(ctx.errors.len()).to_equal(0)
        expect(ctx.trait_solver.obligations.len()).to_equal(0)

    it "generic_calls.spl:128 c1 true and 140 c1 true: unresolved argument takes the declared default":
        # @req REQ-GEN-COV-GENCALLS-047
        val f = gcc_fixture()
        var signatures = gcc_signatures(f)
        signatures[f.generic_fn.id] = HmGenericSignature(parameters: [gcc_default_param(f.param_id, "T", gcc_i64())], type_: gcc_unit())
        var ctx = gcc_context_with(f, signatures)
        val v = ctx.fresh_var(gcc_sp())
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [v], nil)]
        ctx.finish_direct_function_bounds()
        expect(gcc_show(ctx.resolve(v))).to_equal("i64")
        expect(ctx.errors.len()).to_equal(0)

    it "generic_calls.spl:128 c1 false: unresolved argument without default stays unresolved":
        # @req REQ-GEN-COV-GENCALLS-048
        val f = gcc_fixture()
        var ctx = gcc_context(f)
        val v = ctx.fresh_var(gcc_sp())
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [v], nil)]
        ctx.finish_direct_function_bounds()
        expect(gcc_show(ctx.resolve(v))).to_equal("?")
        expect(ctx.errors.len()).to_equal(0)

    it "generic_calls.spl:130 c1 err: self-referential default records an occurs error":
        # @req REQ-GEN-COV-GENCALLS-049
        val f = gcc_fixture()
        var signatures = gcc_signatures(f)
        val fallback = gcc_mk(HirTypeKind.Optional(gcc_named(f.param_id, [])))
        signatures[f.pair_fn.id] = HmGenericSignature(parameters: [gcc_param(f.param_id, "T"), gcc_default_param(f.param2_id, "U", fallback)], type_: gcc_unit())
        var ctx = gcc_context_with(f, signatures)
        val v = ctx.fresh_var(gcc_sp())
        ctx.pending_bound_calls = [gcc_call(f.pair_fn, [v, v], nil)]
        ctx.finish_direct_function_bounds()
        expect(ctx.errors.len()).to_equal(1)
        expect(gcc_error_kind(ctx.errors[0])).to_equal("occurs")

    it "generic_calls.spl:148 c1 true: bound on an undeclared binder is reported":
        # @req REQ-GEN-COV-GENCALLS-050
        val f = gcc_fixture()
        var ctx = gcc_context(f)
        ctx.function_bounds[f.generic_fn.id] = [gcc_bound(f.param2_id, gcc_named(f.trait_id, []))]
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [gcc_named(f.struct_id, [])], nil)]
        ctx.finish_direct_function_bounds()
        expect(ctx.errors.len()).to_equal(1)
        expect(gcc_error_kind(ctx.errors[0])).to_equal("function bound parameter is absent from declaration")

    it "generic_calls.spl:152 c1 true: caller-assumed bound adds no obligation and no error":
        # @req REQ-GEN-COV-GENCALLS-051
        val f = gcc_fixture()
        var ctx = gcc_context(f)
        ctx.function_bounds[f.generic_fn.id] = [gcc_bound(f.param_id, gcc_named(f.trait_id, []))]
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [gcc_mk(HirTypeKind.TypeParam("T", []))], Some(f.generic_fn))]
        ctx.finish_direct_function_bounds()
        expect(ctx.errors.len()).to_equal(0)
        expect(ctx.trait_solver.obligations.len()).to_equal(0)

    it "generic_calls.spl:153 c1 true: unresolved argument without caller bound is reported":
        # @req REQ-GEN-COV-GENCALLS-052
        val f = gcc_fixture()
        var ctx = gcc_context(f)
        ctx.function_bounds[f.generic_fn.id] = [gcc_bound(f.param_id, gcc_named(f.trait_id, []))]
        val v = ctx.fresh_var(gcc_sp())
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [v], nil)]
        ctx.finish_direct_function_bounds()
        expect(ctx.errors.len()).to_equal(1)
        expect(gcc_error_kind(ctx.errors[0])).to_equal("function bound requires a resolved argument or matching caller bound")

    it "generic_calls.spl:153 c1 false and 156: concrete argument reaches the trait solver":
        # @req REQ-GEN-COV-GENCALLS-053
        step("No impl GccTrait for GccStruct exists, so the solver must reject the obligation")
        val f = gcc_fixture()
        var ctx = gcc_context(f)
        ctx.function_bounds[f.generic_fn.id] = [gcc_bound(f.param_id, gcc_named(f.trait_id, []))]
        ctx.pending_bound_calls = [gcc_call(f.generic_fn, [gcc_named(f.struct_id, [])], nil)]
        ctx.finish_direct_function_bounds()
        expect(ctx.errors.len()).to_equal(1)
        expect(gcc_error_kind(ctx.errors[0])).to_equal("trait GccTrait")
        expect(ctx.trait_solver.obligations.len()).to_equal(0)
        expect(ctx.pending_bound_calls.len()).to_equal(0)
