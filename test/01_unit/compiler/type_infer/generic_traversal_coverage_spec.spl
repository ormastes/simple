describe "HM traversal: payload preservation":
    it "apply preserves Union member order":
        # @req REQ-HM-TRAV-037
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Apply over a three-member union")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        expect(ctx.unify(v, int64()).is_ok()).to_equal(true)
        val u = mk(HirTypeKind.Union([str_ty(), v, unit_ty()]))
        expect(show(ctx.apply_subst(u))).to_equal("Union[str,i64,unit]")

    it "apply keeps non-Throws effects around a resolved Throws":
        # @req REQ-HM-TRAV-038
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Apply over effects IO, Throws, Custom")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        expect(ctx.unify(v, str_ty()).is_ok()).to_equal(true)
        val fx = [Effect(kind: EffectKind.IO, span: sp()), throws(v), Effect(kind: EffectKind.Custom("net"), span: sp())]
        val f = mk(HirTypeKind.Function([], unit_ty(), fx))
        expect(show(ctx.apply_subst(f))).to_equal("Fn[->unit!io,throws str,custom net]")

    it "apply preserves the Projection associated name":
        # @req REQ-HM-TRAV-039
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Apply over a projection named Output")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        expect(ctx.unify(v, int64()).is_ok()).to_equal(true)
        expect(show(ctx.apply_subst(mk(HirTypeKind.Projection(v, "Output"))))).to_equal("Proj[i64.Output]")

    it "apply preserves the source span of a rebuilt Union":
        # @req REQ-HM-TRAV-040
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Apply over a union carrying a distinctive span")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val marked = Span(start: 11, end: 22, line: 3, col: 4, file: "m.spl", length: 11)
        val out = ctx.apply_subst(HirType(kind: HirTypeKind.Union([v]), span: marked))
        expect(out.span.start).to_equal(11)  # oracle: input span above
        expect(out.span.file).to_equal("m.spl")

    it "apply is idempotent across nested carriers":
        # @req REQ-HM-TRAV-041
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Apply twice over Union inside Isolated inside Throws")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        expect(ctx.unify(v, int64()).is_ok()).to_equal(true)
        val t = wrap_throws(wrap_isolated(wrap_union(v)))
        val once = ctx.apply_subst(t)
        expect(show(once)).to_equal("Fn[->unit!throws Iso[Union[i64,str]]]")
        expect(show(ctx.apply_subst(once))).to_equal(show(once))

    it "apply chases a variable chain under Projection":
        # @req REQ-HM-TRAV-042
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Link two variables then apply")
        var ctx = HmInferContext.new()
        val a = ctx.fresh_var(sp())
        val b = ctx.fresh_var(sp())
        expect(ctx.unify(a, b).is_ok()).to_equal(true)
        expect(ctx.unify(b, int64()).is_ok()).to_equal(true)
        expect(show(ctx.apply_subst(wrap_projection(a)))).to_equal("Proj[i64.Item]")

    it "apply resolves a variable bound to a carrier containing another variable":
        # @req REQ-HM-TRAV-043
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Bind a to Union of b, then bind b")
        var ctx = HmInferContext.new()
        val a = ctx.fresh_var(sp())
        val b = ctx.fresh_var(sp())
        expect(ctx.unify(a, wrap_union(b)).is_ok()).to_equal(true)
        expect(ctx.unify(b, int64()).is_ok()).to_equal(true)
        expect(show(ctx.resolve(a))).to_equal("Union[i64,str]")

describe "HM traversal: nesting and soundness":
    it "rejects a cycle formed in two steps through Isolated":
        # @req REQ-HM-TRAV-044
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Bind a to Isolated b, then unify b with a")
        var ctx = HmInferContext.new()
        val a = ctx.fresh_var(sp())
        val b = ctx.fresh_var(sp())
        expect(ctx.unify(a, wrap_isolated(b)).is_ok()).to_equal(true)
        expect(occurs_error_id(ctx.unify(b, a))).to_equal(var_id(b))

    it "rejects a self reference with the variable on the right":
        # @req REQ-HM-TRAV-045
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Unify Union of a with a")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        expect(occurs_error_id(ctx.unify(wrap_union(v), v))).to_equal(var_id(v))

    it "rejects a self reference nested under Optional, Function and Union":
        # @req REQ-HM-TRAV-046
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Unify a with a deeply nested self reference")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val inner = mk(HirTypeKind.Function([wrap_union(v)], unit_ty(), []))
        expect(occurs_error_id(ctx.unify(v, mk(HirTypeKind.Optional(inner))))).to_equal(var_id(v))

    it "finds a variable in a Throws payload nested in a Throws payload":
        # @req REQ-HM-TRAV-047
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Occurs over a thrown function that throws the variable")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        assert_true(ctx.occurs(var_id(v), wrap_throws(wrap_throws(v))))

    it "quantifies in first encounter order across params, return and Throws":
        # @req REQ-HM-TRAV-048
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Generalize a function with a variable in each slot")
        var ctx = HmInferContext.new()
        val a = bound_var(ctx)
        val b = bound_var(ctx)
        val c = bound_var(ctx)
        val f = mk(HirTypeKind.Function([wrap_union(a)], wrap_isolated(b), [throws(c)]))
        expect(ctx.generalize(f).vars).to_equal([var_id(a), var_id(b), var_id(c)])

    it "deduplicates a variable repeated across carriers":
        # @req REQ-HM-TRAV-049
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Generalize one variable present in Union and Throws")
        var ctx = HmInferContext.new()
        val v = bound_var(ctx)
        val f = mk(HirTypeKind.Function([wrap_union(v)], wrap_projection(v), [throws(v)]))
        expect(ctx.generalize(f).vars).to_equal([var_id(v)])

    it "does not quantify an environment variable hidden under Union":
        # @req REQ-HM-TRAV-050
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Bind a mono Union of a variable, then generalize it")
        var ctx = HmInferContext.new()
        val v = bound_var(ctx)
        ctx.bind_mono("x", wrap_union(v))
        expect(ctx.generalize(v).vars.len()).to_equal(0)  # oracle: env owns the variable

    it "does not quantify an environment variable hidden under Throws":
        # @req REQ-HM-TRAV-051
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Bind a mono thrown function, then generalize its variable")
        var ctx = HmInferContext.new()
        val v = bound_var(ctx)
        ctx.bind_mono("x", wrap_throws(v))
        expect(ctx.generalize(v).vars.len()).to_equal(0)  # oracle: env owns the variable

    it "instantiates a generalized Union with a fresh variable":
        # @req REQ-HM-TRAV-052
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Generalize then instantiate a Union scheme")
        var ctx = HmInferContext.new()
        val v = bound_var(ctx)
        val scheme = ctx.generalize(wrap_union(v))
        val fresh = ctx.instantiate(scheme)
        assert_false(ctx.occurs(var_id(v), fresh))

describe "HM traversal: leaf and existing-arm controls":
    it "leaves every non-type-bearing leaf unchanged and var-free":
        # @req REQ-HM-TRAV-053
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Walk a table of leaf kinds through all three kernels")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val leaves = [HirTypeKind.Int(8, false), HirTypeKind.Float(32), HirTypeKind.Bool, HirTypeKind.Char, HirTypeKind.Str, HirTypeKind.Unit, HirTypeKind.Error, HirTypeKind.Never, HirTypeKind.Any, HirTypeKind.DynTrait(SymbolId(id: 1)), HirTypeKind.Layer([], [])]
        for kind in leaves:
            assert_false(ctx.occurs(var_id(v), mk(kind)))
            expect(ctx.free_vars_with_levels(mk(kind)).len()).to_equal(0)  # oracle: leaves carry no type

    it "still covers every pre-existing carrier":
        # @req REQ-HM-TRAV-054
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Walk a table of pre-existing carriers through occurs and apply")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val carriers = [mk(HirTypeKind.Tuple([v])), mk(HirTypeKind.Array(v, nil)), mk(HirTypeKind.Slice(v)), mk(HirTypeKind.Dict(str_ty(), v)), mk(HirTypeKind.Ref(v, false)), mk(HirTypeKind.Ptr(v, true)), mk(HirTypeKind.Optional(v)), mk(HirTypeKind.Result(v, str_ty())), mk(HirTypeKind.Named(SymbolId(id: 2), [v])), mk(HirTypeKind.Unique(v)), mk(HirTypeKind.Shared(v)), mk(HirTypeKind.Weak(v))]
        for carrier in carriers:
            assert_true(ctx.occurs(var_id(v), carrier))
            expect(ctx.free_vars_with_levels(carrier).len()).to_equal(1)  # oracle: one variable per carrier

