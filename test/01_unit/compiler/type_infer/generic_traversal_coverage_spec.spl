"""
## Purpose and audience

Pins Hindley-Milner traversal coverage in `30.types`: `Substitution.apply`,
`HmInferContext.occurs` and `collect_free_vars` must walk every type-bearing
payload (Union, Isolated, Projection, Throws effects, Tensor, TypeParam bounds).
For compiler engineers changing type inference. A carrier that is skipped lets
an infinite type bind, leaves an inference variable unresolved, or under-quantifies.

## Operator workflow

Run `bin/simple test test/01_unit/compiler/type_infer/generic_traversal_coverage_spec.spl`
with the pure-Simple binary. Expected strings come from a local structural
renderer, independent of the kernels under test.
"""

# @manual_section: hm-traversal-coverage

use compiler.types.type_infer_types.*
use compiler.types.type_infer.context.*
use compiler.types.type_infer.core.*
use compiler.types.type_infer.generalization.*
use compiler.hir.hir.*
use compiler.frontend.core.lexer.*
use std.spec.step

fn sp() -> Span:
    lex_span_empty()

fn mk(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: sp())

fn int64() -> HirType:
    mk(HirTypeKind.Int(64, true))

fn str_ty() -> HirType:
    mk(HirTypeKind.Str)

fn unit_ty() -> HirType:
    mk(HirTypeKind.Unit)

fn throws(payload: HirType) -> Effect:
    Effect(kind: EffectKind.Throws(payload), span: sp())

fn wrap_union(x: HirType) -> HirType:
    mk(HirTypeKind.Union([x, str_ty()]))

fn wrap_isolated(x: HirType) -> HirType:
    mk(HirTypeKind.Isolated(x))

fn wrap_projection(x: HirType) -> HirType:
    mk(HirTypeKind.Projection(x, "Item"))

fn wrap_throws(x: HirType) -> HirType:
    mk(HirTypeKind.Function([], unit_ty(), [throws(x)]))

fn wrap_tensor(x: HirType) -> HirType:
    mk(HirTypeKind.Tensor(x, [], nil))

fn wrap_bound(x: HirType) -> HirType:
    mk(HirTypeKind.TypeParam("T", [x]))

fn show_all(items: [HirType]) -> text:
    var parts: [text] = []
    for item in items:
        parts = parts.push(show(item))
    parts.join(",")

fn show_effect(effect: Effect) -> text:
    match effect.kind:
        case Throws(payload): "throws " + show(payload)
        case IO: "io"
        case Custom(name): "custom " + name
        case _: "other"

fn show_effects(effects: [Effect]) -> text:
    var parts: [text] = []
    for effect in effects:
        parts = parts.push(show_effect(effect))
    parts.join(",")

fn show(ty: HirType) -> text:
    match ty.kind:
        case Int(bits, _): "i{bits}"
        case Str: "str"
        case Unit: "unit"
        case Bool: "bool"
        case Infer(id, _): "?{id}"
        case Union(members): "Union[" + show_all(members) + "]"
        case Isolated(inner): "Iso[" + show(inner) + "]"
        case Projection(base, name): "Proj[" + show(base) + "." + name + "]"
        case Function(params, ret, effects): "Fn[" + show_all(params) + "->" + show(ret) + "!" + show_effects(effects) + "]"
        case Tensor(element, _, _): "Tensor[" + show(element) + "]"
        case TypeParam(name, bounds): name + ":[" + show_all(bounds) + "]"
        case Optional(inner): "Opt[" + show(inner) + "]"
        case Tuple(elements): "Tup[" + show_all(elements) + "]"
        case _: "leaf"

fn var_id(ty: HirType) -> i64:
    match ty.kind:
        case Infer(id, _): id
        case _: -1

fn occurs_error_id(result: Result<(), TypeInferError>) -> i64:
    match result:
        case Err(TypeInferError.OccursCheck(id, _, _)): id
        case _: -1

fn bound_var(ctx: HmInferContext) -> HirType:
    ctx.enter_level()
    val v = ctx.fresh_var(sp())
    ctx.exit_level()
    v
describe "HM traversal through Union":
    it "apply resolves a bound variable under Union":
        # @req REQ-HM-TRAV-001
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Bind a variable to i64 and apply over Union")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        expect(ctx.unify(v, int64()).is_ok()).to_equal(true)
        expect(show(ctx.apply_subst(wrap_union(v)))).to_equal("Union[i64,str]")

    it "apply keeps an unbound variable under Union":
        # @req REQ-HM-TRAV-002
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Apply over Union with no binding for its variable")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val id = var_id(v)
        expect(show(ctx.apply_subst(wrap_union(v)))).to_equal("Union[?{id},str]")

    it "occurs finds a variable under Union":
        # @req REQ-HM-TRAV-003
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Ask whether a variable occurs in Union around itself")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        assert_true(ctx.occurs(var_id(v), wrap_union(v)))

    it "occurs rejects a different variable under Union":
        # @req REQ-HM-TRAV-004
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Ask about a variable absent from Union")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val other = ctx.fresh_var(sp())
        assert_false(ctx.occurs(var_id(other), wrap_union(v)))

    it "unify rejects a self reference through Union":
        # @req REQ-HM-TRAV-005
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Unify a variable with Union around itself")
        var ctx = HmInferContext.new()
        val v = ctx.fresh_var(sp())
        val result = ctx.unify(v, wrap_union(v))
        expect(occurs_error_id(result)).to_equal(var_id(v))
        expect(show(ctx.resolve(v))).to_equal("?{var_id(v)}")

    it "generalize quantifies a variable under Union":
        # @req REQ-HM-TRAV-006
        # @capture(statistics): the rendered type or verdict, retained for review
        step("Generalize Union around an inner-level variable")
        var ctx = HmInferContext.new()
        val v = bound_var(ctx)
        expect(ctx.generalize(wrap_union(v)).vars).to_equal([var_id(v)])

