# Purpose: seed interpreter keeps i64 width for `i64 | u8` / `i64 ^ u8`, and
# evaluates a `me` method-call argument exactly once inside an imported module.
# Bugs: native_cache_contract_mir_lowering_gaps_2026_10_11 (wire byte assembly
# and PIT1/TLD1 decode broke under the test runner).

use std.spec.*
use std.common.structural.wire.{wire_get_u32, wire_get_u64, wire_put_u32, wire_put_u64}
use test.fixtures.compiler.method_call_arg_once.reader_mod.{once_offsets}

fn or_wide(b: [u8]) -> i64:
    var acc = 300
    acc = acc | (b[0] & 0xFF)
    acc

fn xor_wide(b: [u8]) -> i64:
    var acc = 300
    acc = acc ^ (b[0] & 0xFF)
    acc

fn and_wide(b: [u8]) -> i64:
    var acc = 0x1FF
    acc = acc & (b[0] & 0xFF)
    acc

fn assemble_le(b: [u8]) -> i64:
    var acc = 0
    var i = 3
    while i >= 0:
        acc = (acc << 8) | (b[i] & 0xFF)
        i = i - 1
    acc

describe "mixed-width integer bitwise ops":
    it "keeps i64 width for i64 | u8":
        val b: [u8] = [80]
        expect(or_wide(b)).to_equal(380)

    it "keeps i64 width for i64 ^ u8":
        val b: [u8] = [80]
        expect(xor_wide(b)).to_equal(380)

    it "narrows i64 & u8 to the byte":
        val b: [u8] = [80]
        expect(and_wide(b)).to_equal(80)

    it "assembles little-endian words from bytes":
        val b: [u8] = [80, 73, 84, 49]
        expect(assemble_le(b)).to_equal(827607376)

    it "round-trips wire u32 and u64":
        val b32 = wire_put_u32([], 827607376)
        expect(wire_get_u32(b32, 0)).to_equal(827607376)
        val b64 = wire_put_u64([], 1234567890123)
        expect(wire_get_u64(b64, 0)).to_equal(1234567890123)

describe "method-call arguments in imported modules":
    it "evaluates a me-method argument exactly once":
        val b: [u8] = [2, 3, 4, 5, 6, 7]
        expect(once_offsets(b)).to_equal([2, 1, 3, 2, 4, 3])
