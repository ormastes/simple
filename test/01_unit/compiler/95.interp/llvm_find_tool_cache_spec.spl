# _find_tool per-process resolution cache (PR #4733).
# A resolved tool path is computed once per process; later calls must not
# re-resolve (here: a changed SIMPLE_LLVM_BIN is ignored after the first hit),
# and SIMPLE_LLVM_BIN is consulted before PATH discovery.
use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use compiler.interp.interpreter.llvm.tools.{find_clang}

fn clang_dir_on_path() -> text:
    val sep = if env_get("OS") == "Windows_NT": ";" else: ":"
    var picked = ""
    for dir in env_get("PATH").split(sep):
        val d = dir.replace("\\", "/")
        if d != "" and (file_exists(d + "/clang") or file_exists(d + "/clang.exe")):
            picked = d
    picked

describe "_find_tool per-process cache":
    it "honors SIMPLE_LLVM_BIN, then caches the hit for the process lifetime":
        val dir = clang_dir_on_path()
        if dir == "":
            # No clang on this host: a miss must stay a stable miss.
            expect(find_clang()).to_equal("")
            expect(find_clang()).to_equal("")
        else:
            expect(env_set("SIMPLE_LLVM_BIN", dir)).to_equal(true)
            val first = find_clang()
            expect(first.replace("\\", "/").starts_with(dir + "/clang")).to_equal(true)
            # Point the env at nothing: a re-resolution would now take a
            # different path (or fail); the cache must return the same hit.
            expect(env_set("SIMPLE_LLVM_BIN", "/nonexistent-llvm-bin")).to_equal(true)
            expect(find_clang()).to_equal(first)
            expect(find_clang()).to_equal(first)
