# Bug: test_private_access_closure_attribution_2026-11-14
#
# Owner rule (2026-11-13, "test can access private, if cant should fixed"):
# code written in a test file may import and call a private `fn` of any
# module, on every run lane. The import rule and the call rule both use the
# seed's `is_test_caller` predicate (a `test/` prefix or a `/test/` path
# component). Before the fix the call rule judged a closure body by the frame
# that INVOKED it, so a test's `\: secret_helper()` handed to a `src/**`
# helper was refused as a call from that helper.
#
# Each row writes a tiny `src/app/...` + `test/unit/...` tree under the temp
# dir and runs one file with the seed. Product (non-test) rows must stay
# refused: the exemption is lexical, never "a test is somewhere on the stack".
# Needs the fixed seed: SIMPLE_BINARY=<seed built from this tree>.
use std.spec.{describe, it, expect}
use std.io_runtime.{write_file, file_exists, env_get, mkdir_p}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use app.io.process_ops.{process_run_timeout}

fn binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "": return env_bin
    if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"

fn is_windows() -> bool:
    file_exists("bin/simple.exe")

fn fixture_root(tag: text) -> text:
    val root = get_temp_dir().replace("\\", "/") + "/tpa_matrix_" + tag
    for dir in ["/src/app/sub", "/src/app/runner", "/src/app/facade", "/src/app/other", "/test/unit"]:
        val _ = mkdir_p(root + dir)
    val _l = write_file(root + "/src/app/sub/lib_mod.spl", "fn secret_inc(x: i64) -> i64:\n    x + 1\nfn secret_helper() -> i64:\n    42\npub fn open_api() -> i64:\n    secret_helper()\n")
    val _f = write_file(root + "/src/app/sub/sub_facade.spl", "export use app.sub.lib_mod.{{secret_helper, open_api}}\n")
    val _g = write_file(root + "/src/app/facade/glob_facade.spl", "export use app.sub.lib_mod.*\n")
    val _r = write_file(root + "/src/app/runner/run.spl", "pub fn run_cb(f: fn() -> i64) -> i64:\n    f()\n")
    val _k = write_file(root + "/src/app/runner/mk.spl", "use app.sub.lib_mod.*\npub fn make_cb() -> fn() -> i64:\n    \\: secret_helper()\npub fn make_fn() -> fn() -> i64:\n    fn inner() -> i64:\n        secret_helper()\n    inner\n")
    # src helpers that run a caller's closure through the BDD block fast path,
    # the decorator call arms, and an AOP join point.
    val _d = write_file(root + "/src/app/runner/deco.spl", "pub fn apply_dec(dec: fn(fn() -> i64) -> fn() -> i64) -> i64:\n    @dec\n    fn inner() -> i64:\n        1\n    inner()\n")
    val _b = write_file(root + "/src/app/runner/bddh.spl", "pub fn shared_it(blk):\n    describe \"shared\":\n        it \"x\", blk\n")
    val _j = write_file(root + "/src/app/runner/jp.spl", "pub fn call_target() -> i64:\n    target_fn()\n")
    val _a = write_file(root + "/src/app/runner/aopsrc.spl", "pub fn with_advice(f: fn() -> i64):\n    describe \"s\":\n        it \"y\":\n            fn adv():\n                val _ = secret_helper()\n            on pc{{ execution(* target_fn(..)) }} use adv before priority 1\n            print f()\n")
    # src functions in another directory reaching the private fn by glob,
    # by a glob facade, and qualified; a module handing its OWN private fn
    # to a helper as a value.
    val _gc = write_file(root + "/src/app/other/glob_caller.spl", "use app.sub.lib_mod.*\npub fn call_glob() -> i64:\n    secret_helper()\n")
    val _fc = write_file(root + "/src/app/other/facade_caller.spl", "use app.facade.glob_facade.*\npub fn call_facade() -> i64:\n    secret_helper()\n")
    val _qc = write_file(root + "/src/app/other/qual_caller.spl", "use app.sub.lib_mod\npub fn call_qual() -> i64:\n    lib_mod.secret_helper()\n")
    val _cb = write_file(root + "/src/app/sub/cb_user.spl", "use app.runner.run.{{run_cb}}\nfn own() -> i64:\n    42\npub fn via_cb() -> i64:\n    run_cb(own)\n")
    # A sub-dir lambda / decorator calling sub's OWN private fn, run from other
    # dirs (judged as its writer); a sub lambda calling another dir's fn that
    # leaks (the writer must not stick to that named frame); and other-dir
    # code reaching the private fn as a value, by UFCS or by pipeline.
    val _lk = write_file(root + "/src/app/other/leaky.spl", "use app.sub.lib_mod.*\npub fn leak() -> i64:\n    secret_helper()\n")
    val _ll = write_file(root + "/src/app/sub/lamlib.spl", "use app.other.leaky.{{leak}}\nfn own2() -> i64:\n    42\npub fn make_lam() -> fn() -> i64:\n    \\: own2()\npub fn make_leak_lam() -> fn() -> i64:\n    \\: leak()\npub fn deco(f: fn() -> i64) -> fn() -> i64:\n    val k = own2()\n    return f\n")
    val _lf = write_file(root + "/src/app/other/lamfn.spl", "use app.sub.lamlib.{{make_lam}}\npub fn call_lam() -> i64:\n    val g = make_lam()\n    g()\n")
    val _vf = write_file(root + "/src/app/other/vf.spl", "use app.sub.lib_mod.*\nuse app.runner.run.{{run_cb}}\npub fn vf_cb() -> i64:\n    run_cb(secret_helper)\npub fn vf_val() -> i64:\n    val f = secret_helper\n    f()\npub fn uf() -> i64:\n    val x = 41\n    x.secret_inc()\npub fn pipe() -> i64:\n    41 |> secret_inc\n")
    val _vq = write_file(root + "/src/app/other/vq.spl", "use app.sub.lib_mod\npub fn vq() -> i64:\n    val f = lib_mod.secret_helper\n    f()\n")
    root

# The fixture root itself must not look like a test path, or every product
# row would be exempt and the negative rows would pass vacuously.
fn root_is_not_test_path(root: text) -> bool:
    not root.starts_with("test/") and not root.contains("/test/")

# Runs `rel` on one lane; returns (stdout, stderr, rc).
fn run_lane(root: text, rel: text, src: text, lane: text) -> (text, text, i64):
    val path = root + "/" + rel
    val _ = write_file(path, src)
    if lane == "interpret":
        return process_run_timeout("/usr/bin/env", ["SIMPLE_EXECUTION_MODE=interpret", binary(), path], 300000)
    process_run_timeout(binary(), [path], 300000)

fn lanes() -> [text]:
    if is_windows(): ["default"] else: ["default", "interpret"]

fn allowed_on_every_lane(tag: text, rel: text, src: text) -> bool:
    allowed_with_marker(tag, rel, src, "42")

# `marker` must appear on stdout: proves the row's private call really ran.
fn allowed_with_marker(tag: text, rel: text, src: text, marker: text) -> bool:
    val root = fixture_root(tag)
    var ok = root_is_not_test_path(root)
    for lane in lanes():
        val (out, err, rc) = run_lane(root, rel, src, lane)
        if rc != 0 or not out.contains(marker) or (out + err).contains("is not visible"):
            print "[{tag}/{lane}] rc={rc} out={out.trim()} err={err.trim()}"
            ok = false
    ok

fn refused_on_every_lane(tag: text, rel: text, src: text) -> bool:
    refused_fn_on_every_lane(tag, rel, src, "secret_helper")

fn refused_fn_on_every_lane(tag: text, rel: text, src: text, fname: text) -> bool:
    val root = fixture_root(tag)
    var ok = root_is_not_test_path(root)
    for lane in lanes():
        val (out, err, rc) = run_lane(root, rel, src, lane)
        if rc == 0 or out.contains("42") or not err.contains("private fn `{fname}`"):
            print "[{tag}/{lane}] expected refusal: rc={rc} out={out.trim()}"
            ok = false
    ok

# Same as refused_on_every_lane, for a fixture whose refusal surfaces inside
# a BDD example: the spec runner prints the example failure on stdout.
fn refused_in_example_on_every_lane(tag: text, rel: text, src: text) -> bool:
    val root = fixture_root(tag)
    var ok = root_is_not_test_path(root)
    for lane in lanes():
        val (out, err, rc) = run_lane(root, rel, src, lane)
        if rc == 0 or out.contains("42") or not (out + err).contains("private fn `secret_helper`"):
            print "[{tag}/{lane}] expected refusal: rc={rc} out={out.trim()}"
            ok = false
    ok

val T_BRACED = "use app.sub.lib_mod.{{secret_helper}}\n"
val T_RUNNER = "use app.runner.run.{{run_cb}}\n"

describe "a test file can call private fns on every lane":
    it "braced import, top level":
        expect(allowed_on_every_lane("braced", "test/unit/braced_spec.spl", T_BRACED + "print secret_helper()\n")).to_equal(true)

    it "braced import, fn main":
        expect(allowed_on_every_lane("main", "test/unit/main_spec.spl", T_BRACED + "fn main():\n    print secret_helper()\n")).to_equal(true)

    it "glob import":
        expect(allowed_on_every_lane("glob", "test/unit/glob_spec.spl", "use app.sub.lib_mod.*\nprint secret_helper()\n")).to_equal(true)

    it "braced import through an `export use m.*` facade":
        expect(allowed_on_every_lane("globfacade", "test/unit/globfacade_spec.spl", "use app.facade.glob_facade.{{secret_helper}}\nprint secret_helper()\n")).to_equal(true)

    it "braced import through a braced `export use` facade":
        expect(allowed_on_every_lane("bracefacade", "test/unit/bracefacade_spec.spl", "use app.sub.sub_facade.{{secret_helper}}\nprint secret_helper()\n")).to_equal(true)

    it "module-qualified call":
        expect(allowed_on_every_lane("qualified", "test/unit/qualified_spec.spl", "use app.sub.lib_mod\nprint lib_mod.secret_helper()\n")).to_equal(true)

    it "test lambda run by a src helper (was refused as a call from the helper)":
        expect(allowed_on_every_lane("lambda", "test/unit/lambda_spec.spl", T_BRACED + T_RUNNER + "print run_cb(\\: secret_helper())\n")).to_equal(true)

    it "test lambda written inside a test fn, run by a src helper":
        expect(allowed_on_every_lane("fnlambda", "test/unit/fnlambda_spec.spl", T_BRACED + T_RUNNER + "fn helper() -> i64:\n    run_cb(\\: secret_helper())\nprint helper()\n")).to_equal(true)

    it "test lambda written inside an `it` block, run by a src helper":
        expect(allowed_on_every_lane("itlambda", "test/unit/itlambda_spec.spl", T_BRACED + T_RUNNER + "describe \"p\":\n    it \"x\":\n        print run_cb(\\: secret_helper())\n")).to_equal(true)

    it "nested fn written in a test fn, handed to a src helper":
        expect(allowed_on_every_lane("nestedfn", "test/unit/nestedfn_spec.spl", T_BRACED + T_RUNNER + "fn outer() -> i64:\n    fn inner() -> i64:\n        secret_helper()\n    run_cb(inner)\nprint outer()\n")).to_equal(true)

    it "test block handed to `it` by a src helper (BDD block fast path)":
        expect(allowed_on_every_lane("bddblock", "test/unit/bddblock_spec.spl", T_BRACED + "use app.runner.bddh.{{shared_it}}\nshared_it(fn():\n    print secret_helper()\n)\n")).to_equal(true)

    it "test fn applied as a decorator inside a src helper":
        expect(allowed_on_every_lane("decofn", "test/unit/decofn_spec.spl", T_BRACED + "use app.runner.deco.{{apply_dec}}\nfn mk(f: fn() -> i64) -> fn() -> i64:\n    val x = secret_helper()\n    return \\: x\nprint apply_dec(mk)\n")).to_equal(true)

    it "test lambda applied as a decorator inside a src helper":
        expect(allowed_on_every_lane("decolambda", "test/unit/decolambda_spec.spl", T_BRACED + "use app.runner.deco.{{apply_dec}}\nprint apply_dec(\\f: if secret_helper() == 42: (\\: 42) else: f)\n")).to_equal(true)

    it "owner-less test advice fired at a join point inside a src function":
        # The advice prints 4200, so the row cannot pass without it firing.
        expect(allowed_with_marker("advice", "test/unit/advice_spec.spl", T_BRACED + "use app.runner.jp.{{call_target}}\nfn target_fn() -> i64:\n    42\ndescribe \"d\":\n    it \"x\":\n        fn adv():\n            print secret_helper() * 100\n        on pc{{ execution(* target_fn(..)) }} use adv before priority 1\n        print call_target()\n", "4200")).to_equal(true)

describe "product code stays refused (the exemption is lexical)":
    it "a src-written lambda run by a src helper, from a test entry":
        expect(refused_on_every_lane("srclambda", "test/unit/srclambda_spec.spl", "use app.runner.mk.{{make_cb}}\n" + T_RUNNER + "print run_cb(make_cb())\n")).to_equal(true)

    it "a src-written nested fn called inside a test closure body":
        expect(refused_on_every_lane("srcnested", "test/unit/srcnested_spec.spl", "use app.runner.mk.{{make_fn}}\n" + T_RUNNER + "print run_cb(\\: make_fn()())\n")).to_equal(true)

    it "a product file importing the private fn":
        expect(refused_on_every_lane("prodbraced", "src/app/other/prod_braced.spl", T_BRACED + "print secret_helper()\n")).to_equal(true)

    it "a product lambda run by a src helper":
        expect(refused_on_every_lane("prodlambda", "src/app/other/prod_lambda.spl", "use app.sub.lib_mod.*\n" + T_RUNNER + "print run_cb(\\: secret_helper())\n")).to_equal(true)

    it "owner-less src advice fired inside a test closure body (judged where declared)":
        expect(refused_in_example_on_every_lane("srcadvice", "test/unit/srcadvice_spec.spl", T_BRACED + "use app.runner.aopsrc.{{with_advice}}\nfn target_fn() -> i64:\n    42\nwith_advice(\\: target_fn())\n")).to_equal(true)

# private_call_gate_skips_import_bound_and_entry_calls_2026-11-14: a glob
# import, a facade or a qualified name binds a private fn; it does not make
# it visible. Entry rows use top-level code: an entry `fn main` on the
# default (JIT) lane is the separate jit_main_lane_skips_private_import_visibility.
describe "product code reaching a private fn by glob, facade or qualified name is refused":
    it "a src fn calling it through a glob import (import-bound dispatch)":
        expect(refused_on_every_lane("srcglob", "src/app/main_srcglob.spl", "use app.other.glob_caller.{{call_glob}}\nprint call_glob()\n")).to_equal(true)

    it "a src fn calling it through an `export use m.*` facade":
        expect(refused_on_every_lane("srcfacade", "src/app/main_srcfacade.spl", "use app.other.facade_caller.{{call_facade}}\nprint call_facade()\n")).to_equal(true)

    it "a src fn calling it module-qualified":
        expect(refused_on_every_lane("srcqual", "src/app/main_srcqual.spl", "use app.other.qual_caller.{{call_qual}}\nprint call_qual()\n")).to_equal(true)

    it "a product entry calling it through a glob import":
        expect(refused_on_every_lane("entryglob", "src/app/other/entry_glob.spl", "use app.sub.lib_mod.*\nprint secret_helper()\n")).to_equal(true)

    it "a product entry calling it through a glob facade":
        expect(refused_on_every_lane("entryfacade", "src/app/other/entry_facade.spl", "use app.facade.glob_facade.*\nprint secret_helper()\n")).to_equal(true)

    it "a product entry calling it through a braced facade import":
        expect(refused_on_every_lane("entrybfacade", "src/app/other/entry_bfacade.spl", "use app.sub.sub_facade.{{secret_helper}}\nprint secret_helper()\n")).to_equal(true)

    it "a product entry calling it module-qualified":
        expect(refused_on_every_lane("entryqual", "src/app/other/entry_qual.spl", "use app.sub.lib_mod\nprint lib_mod.secret_helper()\n")).to_equal(true)

describe "the tightened gate keeps its exemptions":
    it "a same-directory product entry (glob and qualified)":
        expect(allowed_on_every_lane("samedirglob", "src/app/sub/entry_same.spl", "use app.sub.lib_mod.*\nprint secret_helper()\n")).to_equal(true)
        expect(allowed_on_every_lane("samedirqual", "src/app/sub/entry_same_q.spl", "use app.sub.lib_mod\nprint lib_mod.secret_helper()\n")).to_equal(true)

    it "a module handing its own private fn to another directory's helper as a value":
        expect(allowed_on_every_lane("owncb", "src/app/main_owncb.spl", "use app.sub.cb_user.{{via_cb}}\nprint via_cb()\n")).to_equal(true)

    it "a product entry calling its own private fn":
        expect(allowed_on_every_lane("ownpriv", "src/app/other/entry_own.spl", "fn mine() -> i64:\n    42\nprint mine()\n")).to_equal(true)

    it "a test entry through a glob facade and qualified inside fn main":
        expect(allowed_on_every_lane("testglobfacade", "test/unit/globfacade2_spec.spl", "use app.facade.glob_facade.*\nprint secret_helper()\n")).to_equal(true)
        expect(allowed_on_every_lane("testqualmain", "test/unit/qualmain_spec.spl", "use app.sub.lib_mod\nfn main():\n    print lib_mod.secret_helper()\n")).to_equal(true)

# Reviewer P1s on the same gap: a private fn taken as a VALUE, by UFCS, or by
# pipeline is a use by the code that names it; a closure body is judged as
# the module that WROTE it, not whoever invokes it.
describe "product code reaching a private fn as a value, by UFCS or by pipeline is refused":
    it "passing it as a callback and binding it to a local":
        expect(refused_on_every_lane("valuecb", "src/app/main_valuecb.spl", "use app.other.vf.{{vf_cb}}\nprint vf_cb()\n")).to_equal(true)
        expect(refused_on_every_lane("valueval", "src/app/main_valueval.spl", "use app.other.vf.{{vf_val}}\nprint vf_val()\n")).to_equal(true)

    it "binding it module-qualified":
        expect(refused_on_every_lane("valuequal", "src/app/main_valuequal.spl", "use app.other.vq.{{vq}}\nprint vq()\n")).to_equal(true)

    it "calling it by UFCS and by pipeline":
        expect(refused_fn_on_every_lane("ufcs", "src/app/main_ufcs.spl", "use app.other.vf.{{uf}}\nprint uf()\n", "secret_inc")).to_equal(true)
        expect(refused_fn_on_every_lane("pipe", "src/app/main_pipe.spl", "use app.other.vf.{{pipe}}\nprint pipe()\n", "secret_inc")).to_equal(true)

    it "a sub lambda calling another dir's fn that reaches it (no writer leak into named frames)":
        expect(refused_on_every_lane("lamleak", "src/app/other/entry_lamleak.spl", "use app.sub.lamlib.{{make_leak_lam}}\nval f = make_leak_lam()\nprint f()\n")).to_equal(true)

describe "a closure or decorator runs as the module that wrote it":
    it "a lambda calling its writer's private fn, invoked from an entry, a fn and a helper":
        expect(allowed_on_every_lane("lamentry", "src/app/other/entry_lam.spl", "use app.sub.lamlib.{{make_lam}}\nval f = make_lam()\nprint f()\n")).to_equal(true)
        expect(allowed_on_every_lane("lamfn", "src/app/main_lamfn.spl", "use app.other.lamfn.{{call_lam}}\nprint call_lam()\n")).to_equal(true)
        expect(allowed_on_every_lane("lamcb", "src/app/other/entry_lamcb.spl", "use app.sub.lamlib.{{make_lam}}\nuse app.runner.run.{{run_cb}}\nprint run_cb(make_lam())\n")).to_equal(true)

    it "a decorator fn calling its owner's private fn, applied in another dir":
        expect(allowed_on_every_lane("decoentry", "src/app/other/entry_deco.spl", "use app.sub.lamlib.{{deco}}\nfn outer() -> i64:\n    @deco\n    fn inner() -> i64:\n        return 42\n    inner()\nprint outer()\n")).to_equal(true)

    it "an entry-defined decorator calling another dir's private fn stays refused":
        expect(refused_on_every_lane("entrydeco", "src/app/other/entry_deco2.spl", "use app.sub.lib_mod\nfn deco(f: fn() -> i64) -> fn() -> i64:\n    val k = lib_mod.secret_helper()\n    return f\nfn outer() -> i64:\n    @deco\n    fn inner() -> i64:\n        return 7\n    inner()\nprint outer()\n")).to_equal(true)
