# Bug: interp_brace_literal_collides_with_string_interpolation_2026-07-03
#
# Owner rule (2026-11-07): any `{ident}` or `{ ident }` interpolates; a literal
# brace needs `{{` / `}}`. Every expected value below is built WITHOUT brace
# characters inside a string literal (the open/close braces are concatenated
# from "{" and "}" pieces), so an expectation can never be re-interpolated the
# same way as the value under test.
use std.spec

val LB = "{"
val RB = "}"

describe "interpolation vs literal braces":
    it "compact identifier interpolates":
        val x = 1
        expect("a{x}b").to_equal("a1b")
    it "padded identifier interpolates":
        val x = 1
        expect("a{ x }b").to_equal("a1b")
    it "padded identifier beside another placeholder interpolates":
        val b = 5
        val name = "n"
        expect("a { b } {name} c").to_equal("a 5 n c")
    it "doubled braces are literal braces":
        expect("a{{b}}c").to_equal("a" + LB + "b" + RB + "c")
    it "doubled braces beside a placeholder":
        val name = "n"
        expect("css {{margin:0}} then {name}").to_equal("css " + LB + "margin:0" + RB + " then n")
    it "escaped braces around an interpolated field":
        val z = 11
        expect("{{ eye: [0.0, {z}] }}").to_equal(LB + " eye: [0.0, 11] " + RB)
    it "placeholder-free brace group is verbatim":
        expect("body{font:14px;color:red;}").to_equal("body" + LB + "font:14px;color:red;" + RB)
    it "placeholder nested in braces keeps the outer braces literal":
        val inner = 9
        expect("N1:{ {inner} }|END").to_equal("N1:" + LB + " 9 " + RB + "|END")
    it "placeholder nested without padding":
        val inner = 9
        expect("N3:{ {inner}}|END").to_equal("N3:" + LB + " 9" + RB + "|END")
