# Bug: interp_brace_literal_collides_with_string_interpolation_2026-07-03
#
# A literal brace group sharing a string with a real `{placeholder}` must
# never be silently swallowed or emptied. The supported, deterministic forms
# are pinned here: `{{`/`}}` escapes next to a placeholder, a brace group in a
# placeholder-free literal (verbatim), and a placeholder nested in braces
# (the placeholder interpolates, the outer braces stay literal text).
use std.spec

describe "brace literals beside interpolation":
    it "doubled braces stay literal next to a placeholder":
        val name = "n"
        expect("css {{margin:0}} then {name}").to_equal("css {{margin:0}} then n")
    it "placeholder-free brace group is verbatim":
        expect("body{font:14px;color:red;}").to_equal("body{font:14px;color:red;}")
    it "nested placeholder with space padding is not swallowed":
        val inner = 9
        expect("N1:{ {inner} }|END").to_equal("N1:{{ 9 }}|END")
    it "nested placeholder without padding is not swallowed":
        val inner = 9
        expect("N3:{ {inner}}|END").to_equal("N3:{{ 9}}|END")
    it "escaped dict-shaped text with an interpolated field":
        val z = 11
        expect("{{ eye: [0.0, {z}] }}").to_equal("{{ eye: [0.0, 11] }}")

describe "owner rule: any {ident} or { ident } interpolates; literal braces need {{":
    it "padded identifier interpolates":
        val b = 5
        expect("A:{ b }").to_equal("A:5")
    it "padded identifier beside another placeholder interpolates":
        val b = 5
        val name = "n"
        expect("a { b } {name} c").to_equal("a 5 n c")
    it "padded identifier beside an escaped literal":
        val b = 5
        expect("{ b } {{lit}}").to_equal("5 " + "{" + "lit}")
