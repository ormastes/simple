# Bug: interp_private_names_leak_across_modules_2026-11-05
#
# A bare `fn` is private to its file. A braced `use m.{name}` that names a
# private fn of `m` from a file in a DIFFERENT directory is a hard error; a
# `pub fn`, an `export`ed fn and a same-directory sibling stay legal.
# Needs the fixed seed: SIMPLE_BINARY=<seed built from this tree>.
use std.spec.{describe, it, expect}
use std.io_runtime.{write_file, file_exists, env_get, mkdir_p}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use app.io.process_ops.{process_run_timeout}

fn binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "": return env_bin
    if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"

fn fixture_root(tag: text) -> text:
    val root = get_temp_dir().replace("\\", "/") + "/priv_vis_" + tag
    val _ = mkdir_p(root + "/app/sub")
    root

fn run_main(root: text, main_src: text) -> (text, text, i64):
    val _m = write_file(root + "/app/main.spl", main_src)
    process_run_timeout(binary(), [root + "/app/main.spl"], 300000)

describe "private fn import visibility (repro)":
    it "rejects a braced import of a private fn from another directory":
        val root = fixture_root("private")
        val _a = write_file(root + "/app/sub/lib_mod.spl", "fn secret_helper() -> i64:\n    42\npub fn open_api() -> i64:\n    secret_helper()\n")
        val (out, err, rc) = run_main(root, "use app.sub.lib_mod.{{secret_helper}}\nprint secret_helper()\n")
        expect(rc != 0).to_equal(true)
        expect((out + err).contains("private fn `secret_helper`")).to_equal(true)
        expect(out.contains("42")).to_equal(false)
