# Prevention for compiler_interpreter_integration_real_gaps_found_2026-09-06
# (gap 1): legal impl shapes must keep working -- the same method name on
# different types, differently-typed overloads, and distinct methods spread
# over several impl blocks of one type.
use std.spec.{describe, it, expect}
use std.io_runtime.{write_file, file_exists, env_get, env_set_process}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use app.io.process_ops.{process_run_timeout}

fn binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "": return env_bin
    if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"

val OK = "class A:\n    v: i64\nclass B:\n    v: i64\nimpl A:\n    fn get() -> i64:\n        self.v\nimpl B:\n    fn get() -> i64:\n        self.v + 1\nimpl A:\n    fn other() -> i64:\n        5\nfn main():\n    print A(v: 10).get()\n    print B(v: 10).get()\n    print A(v: 1).other()\nmain()\n"

describe "legal impl block shapes":
    it "runs same-named methods on different types and split impl blocks":
        val file = get_temp_dir().replace("\\", "/") + "/impl_dup_ok.spl"
        val _w = write_file(file, OK)
        val (out, err, rc) = process_run_timeout(binary(), [file], 300000)
        expect(rc).to_equal(0)
        expect(out.contains("10")).to_equal(true)
        expect(out.contains("11")).to_equal(true)
        expect(out.contains("5")).to_equal(true)
