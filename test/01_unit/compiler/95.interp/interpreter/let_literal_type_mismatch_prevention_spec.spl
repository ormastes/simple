# Prevention for compiler_interpreter_integration_real_gaps_found_2026-09-06
# (gap 2): matching literal/annotation pairs must keep working in both engines.
use std.spec.{describe, it, expect}
use std.io_runtime.{write_file, file_exists, env_get, env_set_process}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use app.io.process_ops.{process_run_timeout}

fn binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "": return env_bin
    if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"

val OK = "fn main():\n    val a: i64 = 5\n    val b: text = \"s\"\n    val c: f64 = 2.5\n    val d: bool = true\n    val e: i64 = \"0123\".len()\n    print a\n    print b\n    print c\n    print d\n    print e\nmain()\n"

fn run_ok(mode: text) -> (text, i64):
    val file = get_temp_dir().replace("\\", "/") + "/let_lit_ok.spl"
    val _w = write_file(file, OK)
    val _e = env_set_process("SIMPLE_EXECUTION_MODE", mode)
    val (out, err, rc) = process_run_timeout(binary(), [file], 300000)
    val _r = env_set_process("SIMPLE_EXECUTION_MODE", "")
    (out, rc)

describe "matching literal and annotation":
    it "runs in the interpreter":
        val (o, rc) = run_ok("interpreter")
        expect(rc).to_equal(0)
        expect(o.contains("2.5")).to_equal(true)
    it "runs in the default engine":
        val (o, rc) = run_ok("jit")
        expect(rc).to_equal(0)
        expect(o.contains("2.5")).to_equal(true)
