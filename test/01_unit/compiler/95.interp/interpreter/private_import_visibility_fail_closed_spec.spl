# Bug: visibility_error_jit_fallback_fail_open_2026-11-13
#
# A private-fn visibility rejection must fail closed on the default (JIT) run
# lane: non-zero exit, no program output, and no interpreter fallback. Before
# the fix the JIT lane reported "is not visible to", then the JIT ->
# interpreter fallback re-ran the program (the retry saw the module still
# marked "loading", took the circular-import path and skipped the check), it
# printed 42 and exited 0.
# Needs the fixed seed: SIMPLE_BINARY=<seed built from this tree>.
use std.spec.{describe, it, expect}
use std.io_runtime.{write_file, file_exists, env_get, mkdir_p}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use app.io.process_ops.{process_run_timeout}

fn binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "": return env_bin
    if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"

fn fixture_root(tag: text) -> text:
    val root = get_temp_dir().replace("\\", "/") + "/priv_vis_fc_" + tag
    val _ = mkdir_p(root + "/app/sub")
    root

fn run_product(root: text, main_src: text) -> (text, text, i64):
    val _l = write_file(root + "/app/sub/lib_mod.spl", "fn secret_helper() -> i64:\n    42\npub fn open_api() -> i64:\n    secret_helper()\n")
    val _m = write_file(root + "/app/main.spl", main_src)
    process_run_timeout(binary(), [root + "/app/main.spl"], 300000)

describe "private fn import visibility fails closed on the run lane":
    it "rejects a main-less product importer with no output and no fallback":
        val root = fixture_root("nomain")
        val (out, err, rc) = run_product(root, "use app.sub.lib_mod.{{secret_helper}}\nprint secret_helper()\n")
        expect(rc != 0).to_equal(true)
        expect(out.trim()).to_equal("")
        expect(err.contains("private fn `secret_helper`")).to_equal(true)
        expect(err.contains("falling back to interpreter")).to_equal(false)

    it "still runs a public import from another directory":
        val root = fixture_root("public")
        val (out, _err, rc) = run_product(root, "use app.sub.lib_mod.{{open_api}}\nprint open_api()\n")
        expect(rc).to_equal(0)
        expect(out.contains("42")).to_equal(true)
