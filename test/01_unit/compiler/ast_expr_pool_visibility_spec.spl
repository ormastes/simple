# @cover src/compiler/10.frontend/core/_AstExpr/nodes.spl 1%
extern fn rt_file_read_text(path: text) -> text

# Regression for cranelift_private_static_cross_module_2026-10-24: a private
# module static is file-only, so a pool that core/__init__.spl `export`s and
# other files read must be declared `pub var`. Cranelift AOT rejects importing
# a non-public static. UNEXECUTED: source-shape spec, not run in this lane.
describe "AST expr pool visibility":
    it "declares every exported expr_* pool as pub var":
        val nodes = rt_file_read_text("src/compiler/10.frontend/core/_AstExpr/nodes.spl") ?? ""
        val pools = ["expr_tag", "expr_span", "expr_i_val", "expr_f_val", "expr_s_val", "expr_left", "expr_right", "expr_extra", "expr_args", "expr_stmts"]
        for pool in pools:
            expect(nodes.contains("\npub var {pool}:")).to_equal(true)
            expect(nodes.contains("\nvar {pool}:")).to_equal(false)
