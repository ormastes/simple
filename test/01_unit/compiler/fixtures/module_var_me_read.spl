# Fixture for module_var_write_lost_when_rhs_reads_me_spec.spl.
#
# B1.inc() builds its result from a field of `me`; Box.with_n() builds its
# result from the PARAMETER only. Under the seed interpreter the module-var
# write is lost for the first shape and kept for the second.

class B1:
    n: int
    me inc() -> B1:
        return B1(n: me.n + 1)
    static fn empty() -> B1: B1(n: 0)

var _v1: B1 = B1.empty()
var _v2: B1 = B1.empty()

# direct_bump — the natural form. RHS method reads `me`.
pub fn direct_bump() -> int:
    _v1 = _v1.inc()
    return _v1.n

# guarded_bump — the same mutation through a temporary binding.
pub fn guarded_bump() -> int:
    val cur = _v2
    val nxt = cur.inc()
    _v2 = nxt
    return _v2.n
