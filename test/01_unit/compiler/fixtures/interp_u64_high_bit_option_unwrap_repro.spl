struct HighBitFrameRepro:
    id: text
    checksum: u64

fn find_high_bit_frame_repro(frames: [HighBitFrameRepro], target_id: text) -> HighBitFrameRepro?:
    var found: HighBitFrameRepro? = nil
    var matching_count = 0
    for frame in frames:
        if frame.id == target_id:
            matching_count = matching_count + 1
            if frame.checksum > 0u64:
                found = frame
    if matching_count == 1:
        return found
    nil

fn main():
    val frames = [HighBitFrameRepro(id: "at", checksum: 9223372036854775808u64)]
    if val frame = find_high_bit_frame_repro(frames, "at"):
        print "checksum={frame.checksum}"
    else:
        print "missing"
