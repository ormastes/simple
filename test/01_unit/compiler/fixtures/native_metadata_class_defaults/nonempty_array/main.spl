use owner.{ImportedArrayNonemptyDefault}

fn main():
    val actual = ImportedArrayNonemptyDefault()
    assert(actual.values.len() == 3)
    assert(actual.values[0] == 11)
    assert(actual.values[1] == 23)
    assert(actual.values[2] == 37)
    print "imported-array-nonempty-default-pass assertions=4"
