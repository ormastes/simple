use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use compiler.backend.backend_types.{Value}
use compiler.hir.hir.{HirBinOp}
use compiler.common.diagnostics.span.{Span}

fn main():
    val backend = InterpreterBackendImpl.new()
    val maximum = Value.UInt(18446744073709551615u64)
    var fields: Dict<text, Value> = {}
    fields["checksum"] = maximum
    val aggregate: Value = Value.Struct("HighBitFrame", fields)
    val wrapped = Value.some(aggregate)

    print "probe-option"
    match wrapped:
        case Value.Option(inner):
            assert not inner.is_empty(), "high-bit Value survives Option"
            match inner[0]:
                case Value.Struct(_, stored):
                    match stored["checksum"]:
                        case Value.UInt(value):
                            print "probe-uint={value}"
                            assert value == 18446744073709551615u64, "u64 max survives aggregate"
                        case _:
                            assert false, "checksum must remain UInt"
                case _:
                    assert false, "Option payload must remain a struct"
        case _:
            assert false, "wrapper must remain an Option"

    print "probe-shift"
    match backend.eval_binop(HirBinOp.Shr, maximum, Value.UInt(63u64), Span.default(), true, true):
        case Ok(Value.UInt(value)):
            print "probe-shift-value={value}"
            assert value == 1u64, "u64 right shift is logical"
        case _:
            assert false, "u64 shift must return UInt"

    print "probe-display={backend.value_to_string(maximum)}"
    assert backend.value_to_string(maximum) == "18446744073709551615", "u64 display is unsigned"
    print "u64-owner-pass"
