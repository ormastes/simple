# AUTHORED_UNEXECUTED; canonical source grammar, no parser feature claim.
fn guarded_value(valid: bool, value: i64) -> Result<i64, text>:
    val selected: Result<i64, text> = if valid:
        Ok(value)
    else:
        Err("invalid")
    selected

fn guarded_unwrap(input: Result<i64, text>) -> Result<i64, text>:
    val selected: Result<i64, text> = if input.is_ok():
        guarded_value(true, input.unwrap())
    else:
        Err("invalid")
    selected

fn main() -> i64:
    assert(guarded_value(true, 7).unwrap() == 7)
    assert(guarded_value(false, 7).is_err())
    assert(guarded_unwrap(Ok(9)).unwrap() == 9)
    assert(guarded_unwrap(Err("original")).is_err())
    var pass_index = 0
    var ordered = 0
    while pass_index < 4:
        ordered = ordered * 10 + pass_index
        pass_index = pass_index + 1
    assert(ordered == 123)
    assert(pass_index == 4)
    0
