# @req: REQ-COMP-TWO-HOP-FIELD-METHOD-MUTATION-CROSS-MODU-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove that two-hop field-method mutation (cross-module intermediate).
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""

"""
Two-Hop Field-Method Mutation Must Persist

Bug doc: doc/08_tracking/bug/selfhost_two_hop_field_method_mutation_lost_2026-07-27.md

A mutating method reached through TWO struct-field hops
(`root.mid.inner.bump()`, the shape behind `self.world.store.insert(...)` and
`self.world.base.spawn()`) must write through to the rooted storage. The
reported symptom was a SILENT loss: the call executed, returned normally, and
the mutation vanished — collapsing ECS entity identity to Entity(id:0).

Root cause (lane THFIX2, 2026-07-27): the loss is an INTERPRETER place-model
limit, not a hop-count or module-boundary defect. The interpreter supports
field places only 2 levels deep; it rejects `root.mid.inner.n = 5` LOUDLY
("deeply nested field access requires intermediate variables") but has no
equivalent guard on the method-call receiver path, so the same unsupported
place silently becomes a value copy with no write-back. The JIT/native path
lowers it correctly. Programs land on the interpreter when JIT lowering bails,
e.g. from a mutating `fn X(self)` method anywhere in the import closure.

This spec pins the CORRECT semantics on the default execution path, with the
intermediate struct type imported from another module (the exact shape the bug
was reported against).
"""

use std.spec
use test.fixtures.two_hop_mutation.inner_types.{TwoHopInner, TwoHopMid}

struct TwoHopRoot:
    mid: TwoHopMid

    static fn new() -> TwoHopRoot:
        TwoHopRoot(mid: TwoHopMid.new())

class TwoHopService:
    root: TwoHopRoot

    static fn new() -> TwoHopService:
        TwoHopService(root: TwoHopRoot.new())

    me hit():
        self.root.mid.inner.bump()

    me count() -> i64:
        self.root.mid.inner.n

describe "two-hop field-method mutation (cross-module intermediate)":
    it "one-hop mutating method persists":
        step("Verify: one-hop mutating method persists")
        # @req: REQ-COMP-TWO-HOP-FIELD-METHOD-MUTATION-CROSS-MODU-001
        var mid = TwoHopMid.new()
        mid.inner.bump()
        expect(mid.inner.n).to_equal(1)

    it "two-hop mutating method persists on a var-rooted chain":
        step("Verify: two-hop mutating method persists on a var-rooted chain")
        var root = TwoHopRoot.new()
        root.mid.inner.bump()
        expect(root.mid.inner.n).to_equal(1)

    it "repeated two-hop mutations accumulate":
        step("Verify: repeated two-hop mutations accumulate")
        var root = TwoHopRoot.new()
        root.mid.inner.bump()
        root.mid.inner.bump()
        root.mid.inner.bump()
        expect(root.mid.inner.n).to_equal(3)

    it "two-hop mutating method persists on a self-rooted chain":
        step("Verify: two-hop mutating method persists on a self-rooted chain")
        val svc = TwoHopService.new()
        svc.hit()
        svc.hit()
        expect(svc.count()).to_equal(2)

    it "extract-mutate-write-back workaround stays equivalent":
        step("Verify: extract-mutate-write-back workaround stays equivalent")
        # The workaround shipped in src/os/services/** must remain harmless
        # once the direct chain works: both forms must agree.
        var direct = TwoHopRoot.new()
        direct.mid.inner.bump()

        var manual = TwoHopRoot.new()
        var mid = manual.mid
        mid.inner.bump()
        manual.mid = mid

        expect(manual.mid.inner.n).to_equal(direct.mid.inner.n)
