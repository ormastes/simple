"""
## Purpose and audience

Executable evidence, replicated at module level with no imports, for the
cross-compilation `TargetPreset` field values (cortex-m4, cortex-m0,
riscv32-baremetal, wasm32, linux-x86_64, macos-arm64) and for the
preset-to-runtime-family allow-list mapping (`is_family_allowed` /
`check_family_allowed`). Written for compiler/build engineers who own
`src/compiler/80.driver/build/baremetal.spl` and
`src/compiler/00.common/driver_core_types.spl`.

## Operator workflow

Run this spec in COMPILED mode for authoritative proof:
`bin/simple test --compiled test/unit/compiler/target_presets_spec.spl`. In
plain interpreter mode `it` bodies do not execute; the runner still reports
per-scenario verdict lines for the 23 declared scenarios here, and every one
is expected green.

## Compatibility and limitations

These are LOCAL replicas of the real preset/family logic, not calls into the
compiler itself — if `baremetal.spl` or `driver_core_types.spl` changes,
these local helpers (`make_cortex_m4`, `check_family_allowed`, etc.) must be
updated to match or this spec silently drifts from reality.

## Verification guidance and troubleshooting

A red scenario here means either a local helper drifted from the real
preset/family-mapping source files named above, or (if run uncompiled) the
interpreter-mode limitation applies — re-run compiled before concluding a
regression landed.
"""
# Lifecycle: research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: target presets and runtime family mapping

# Tests for cross-compilation target presets.
# No imports - all logic is replicated at module level.

# WARNING: Interpreter mode limitation
# In interpreter mode, `it` block bodies do NOT execute — assertions are not evaluated.
# These tests verify file loading and structure only.
# For authoritative proof, run in compiled mode: bin/simple test --compiled test/unit/compiler/target_presets_spec.spl
#
# Local helpers replicate logic from:
#   - src/compiler/80.driver/build/baremetal.spl (TargetPreset struct, cortex-m4/m0/riscv32/wasm32/linux/macos presets, allowed_families)
#   - src/compiler/00.common/driver_core_types.spl (is_family_allowed / check_family_allowed)
# If the real implementation changes, these helpers must be updated to match.

# ============================================================================
# Module-level preset helpers (replicate logic without imports)
# ============================================================================

struct TargetPresetSpec:
    name: text
    arch: text
    os: text
    abi: text
    no_std: bool
    no_gc: bool
    stack_size: i64
    heap_size: i64
    pointer_width: i64
    float_support: bool
    allowed_families: [text]
    description: text

fn make_cortex_m4() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "cortex-m4",
        arch: "thumbv7em",
        os: "none",
        abi: "eabihf",
        no_std: true,
        no_gc: true,
        stack_size: 8192,
        heap_size: 0,
        pointer_width: 32,
        float_support: true,
        allowed_families: ["nogc_async_mut_noalloc", "common"],
        description: "ARM Cortex-M4 bare-metal (FPU, 32-bit, no OS)"
    )

fn make_cortex_m0() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "cortex-m0",
        arch: "thumbv6m",
        os: "none",
        abi: "eabi",
        no_std: true,
        no_gc: true,
        stack_size: 2048,
        heap_size: 0,
        pointer_width: 32,
        float_support: false,
        allowed_families: ["nogc_async_mut_noalloc", "common"],
        description: "ARM Cortex-M0/M0+ bare-metal (no FPU, 32-bit, no OS)"
    )

fn make_riscv32_baremetal() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "riscv32-baremetal",
        arch: "riscv32imac",
        os: "none",
        abi: "ilp32",
        no_std: true,
        no_gc: true,
        stack_size: 16384,
        heap_size: 0,
        pointer_width: 32,
        float_support: false,
        allowed_families: ["nogc_async_mut_noalloc", "common"],
        description: "RISC-V 32-bit bare-metal (integer only, no OS)"
    )

fn make_wasm32() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "wasm32",
        arch: "wasm32",
        os: "wasi",
        abi: "wasm",
        no_std: false,
        no_gc: true,
        stack_size: 65536,
        heap_size: 65536,
        pointer_width: 32,
        float_support: true,
        allowed_families: ["nogc_async_mut_noalloc", "nogc_sync_mut", "nogc_async_mut", "common"],
        description: "WebAssembly 32-bit (WASI, browser-compatible)"
    )

fn make_linux_x86_64() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "linux-x86_64",
        arch: "x86_64",
        os: "linux",
        abi: "gnu",
        no_std: false,
        no_gc: false,
        stack_size: 0,
        heap_size: 0,
        pointer_width: 64,
        float_support: true,
        allowed_families: [],
        description: "Linux x86-64 (native, full stdlib)"
    )

fn make_macos_arm64() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "macos-arm64",
        arch: "aarch64",
        os: "macos",
        abi: "macho",
        no_std: false,
        no_gc: false,
        stack_size: 0,
        heap_size: 0,
        pointer_width: 64,
        float_support: true,
        allowed_families: [],
        description: "macOS ARM64 (Apple Silicon, full stdlib)"
    )

fn make_by_name(name: text) -> TargetPresetSpec:
    if name == "cortex-m4":
        return make_cortex_m4()
    elif name == "wasm32":
        return make_wasm32()
    else:
        TargetPresetSpec(
            name: name,
            arch: "unknown",
            os: "none",
            abi: "none",
            no_std: true,
            no_gc: true,
            stack_size: 4096,
            heap_size: 0,
            pointer_width: 32,
            float_support: false,
            allowed_families: ["nogc_async_mut_noalloc", "common"],
            description: "Unknown preset (defaults to bare-metal)"
        )

fn spec_is_baremetal(p: TargetPresetSpec) -> bool:
    p.no_std and p.no_gc

fn spec_triple(p: TargetPresetSpec) -> text:
    p.arch + "-" + p.os + "-" + p.abi

fn spec_all_names() -> [text]:
    ["cortex-m4", "cortex-m0", "riscv32-baremetal", "riscv64-linux",
     "wasm32", "linux-x86_64", "macos-arm64", "windows-x86_64",
     "avr-atmega328", "i8086-dos", "i8086-baremetal"]

# ============================================================================
# Tests
# ============================================================================

describe "TargetPreset":
    context "cortex-m4 preset":
        it "has the correct name":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has the correct name")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(p.name).to_equal("cortex-m4")

        it "has the correct arch":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has the correct arch")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(p.arch).to_equal("thumbv7em")

        it "is bare-metal (no_std and no_gc)":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: is bare-metal (no_std and no_gc)")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(spec_is_baremetal(p)).to_equal(true)

        it "has pointer_width of 32":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has pointer_width of 32")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(p.pointer_width).to_equal(32)  # oracle: cortex-m4 is a 32-bit MCU (ARM Cortex-M, thumbv7em)

        it "has float_support enabled":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has float_support enabled")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(p.float_support).to_equal(true)

    context "riscv32-baremetal preset":
        it "has os set to none":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has os set to none")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_riscv32_baremetal()
            expect(p.os).to_equal("none")

    context "wasm32 preset":
        it "has arch set to wasm32":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has arch set to wasm32")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_wasm32()
            expect(p.arch).to_equal("wasm32")

    context "linux-x86_64 preset":
        it "is not bare-metal":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: is not bare-metal")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_linux_x86_64()
            expect(spec_is_baremetal(p)).to_equal(false)

    context "preset_by_name lookup":
        it "returns cortex-m4 when asked by name":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: returns cortex-m4 when asked by name")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_by_name("cortex-m4")
            expect(p.name).to_equal("cortex-m4")

        it "returns wasm32 when asked by name":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: returns wasm32 when asked by name")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_by_name("wasm32")
            expect(p.arch).to_equal("wasm32")

        it "returns unknown-default preset for unknown name":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: returns unknown-default preset for unknown name")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_by_name("nonexistent-target")
            expect(p.arch).to_equal("unknown")

    context "preset_triple":
        it "formats triple as arch-os-abi":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: formats triple as arch-os-abi")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            val triple = spec_triple(p)
            expect(triple).to_equal("thumbv7em-none-eabihf")

    context "preset_all_names":
        it "returns a list of 11 preset names":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: returns a list of 11 preset names")
            # @capture(statistics): preset/family field values recorded for this scenario
            val names = spec_all_names()
            expect(names.len()).to_equal(11)  # oracle: spec_all_names() lists exactly 11 preset name strings

    context "cortex-m0 preset":
        it "has no float_support":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has no float_support")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m0()
            expect(p.float_support).to_equal(false)

    context "macos-arm64 preset":
        it "has pointer_width of 64":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: has pointer_width of 64")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_macos_arm64()
            expect(p.pointer_width).to_equal(64)  # oracle: macos-arm64 (Apple Silicon aarch64) is a 64-bit target

    # ================================================================
    # Target preset → runtime family mapping tests
    # ================================================================

    context "baremetal preset family mapping":
        it "restricts to nogc_async_mut_noalloc and common":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: restricts to nogc_async_mut_noalloc and common")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            # Baremetal presets (no_std + no_gc) should only allow these two families
            val families = p.allowed_families
            expect(families.len()).to_equal(2)  # oracle: baremetal restricts to exactly 2 families -- nogc_async_mut_noalloc and common
            expect(families[0]).to_equal("nogc_async_mut_noalloc")
            expect(families[1]).to_equal("common")

        it "sets gc_off to true for baremetal":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: sets gc_off to true for baremetal")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(p.no_gc).to_equal(true)

        it "disallows allocation for baremetal":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: disallows allocation for baremetal")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_cortex_m4()
            expect(p.heap_size).to_equal(0)  # oracle: baremetal presets declare zero heap (no allocator), so heap_size must be 0

    context "hosted preset family mapping":
        it "allows all families (empty restriction)":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: allows all families (empty restriction)")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_linux_x86_64()
            val families = p.allowed_families
            expect(families.len()).to_equal(0)  # oracle: an empty allowed_families list means no restriction, i.e. 0 entries

        it "does not set gc_off for hosted":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: does not set gc_off for hosted")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_linux_x86_64()
            expect(p.no_gc).to_equal(false)

    context "embedded_with_heap preset family mapping":
        it "allows nogc families plus common but not gc":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: allows nogc families plus common but not gc")
            # @capture(statistics): preset/family field values recorded for this scenario
            val p = make_wasm32()
            val families = p.allowed_families
            expect(families.len()).to_equal(4)  # oracle: embedded_with_heap allows exactly 4 families -- the 3 nogc_* families plus common
            expect(families[0]).to_equal("nogc_async_mut_noalloc")
            expect(families[1]).to_equal("nogc_sync_mut")
            expect(families[2]).to_equal("nogc_async_mut")
            expect(families[3]).to_equal("common")

    context "is_family_allowed helper":
        it "allows any family when restriction is empty":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: allows any family when restriction is empty")
            # @capture(statistics): preset/family field values recorded for this scenario
            val families: [text] = []
            expect(check_family_allowed(families, "gc_async_mut")).to_equal(true)
            expect(check_family_allowed(families, "nogc_sync_mut")).to_equal(true)

        it "blocks non-listed families when restriction is active":
            # @req REQ-SSPEC-COMPILER-001
            step("Verify: blocks non-listed families when restriction is active")
            # @capture(statistics): preset/family field values recorded for this scenario
            val families = ["nogc_async_mut_noalloc", "common"]
            expect(check_family_allowed(families, "nogc_async_mut_noalloc")).to_equal(true)
            expect(check_family_allowed(families, "common")).to_equal(true)
            expect(check_family_allowed(families, "nogc_sync_mut")).to_equal(false)
            expect(check_family_allowed(families, "gc_async_mut")).to_equal(false)

# ============================================================================
# Family mapping helpers (replicate TargetPreset.allowed_families logic)
# ============================================================================

fn baremetal_allowed_families() -> [text]:
    ["nogc_async_mut_noalloc", "common"]

fn hosted_allowed_families() -> [text]:
    []

fn embedded_with_heap_allowed_families() -> [text]:
    ["nogc_async_mut_noalloc", "nogc_sync_mut", "nogc_async_mut", "common"]

fn check_family_allowed(allowed: [text], family: text) -> bool:
    if allowed.len() == 0:
        return true
    for af in allowed:
        if af == family:
            return true
    false
