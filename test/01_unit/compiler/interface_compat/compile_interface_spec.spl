# @req: REQ-COMPILER-INTERFACECOM-001

"""
# CompileInterfaceDigest / ModuleIdentity Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/build/targeted_build_interface_compat_minimal_bootstrap_2026-08-10.md (§7, §20)

## Overview

Acceptance properties for the first-slice interface extractor:
body-only / comment-only / private-decl changes keep the
compile_interface_digest stable; public signature changes and the
implementation digest move; declaration insertion order never matters.

Limitation (stated per plan): digests are computed over ApiSurface
structures directly, not by driving the full parse+semantic pipeline
from this unit spec.
"""

use std.spec.*
use compiler.tools.api_surface.{ApiSurface, FunctionSignature, ParamSignature}
use compiler.semantics.interface.compile_interface.{compile_interface_digest}
use compiler.semantics.interface.module_identity.{compute_module_identity}

fn fn_sig(name: text, ptype: text, ret: text, vis: text?) -> FunctionSignature:
    var params: [ParamSignature] = []
    params.push(ParamSignature(name: "x", type_name: Some(ptype)))
    FunctionSignature(name: name, params: params, return_type: Some(ret),
        is_async: false, is_generator: false,
        visibility_display: vis, declared_visibility: vis)

# Fixture module A: two public functions.
fn surface_a() -> ApiSurface:
    var s = ApiSurface.create("fixture.mod_a")
    s.add_function(fn_sig("alpha", "i64", "i64", nil))
    s.add_function(fn_sig("beta", "text", "bool", nil))
    s

val source_a: text = "fn alpha(x: i64) -> i64:\n    x + 1\n\nfn beta(x: text) -> bool:\n    x.len() > 0\n"
# Same interface, different alpha body.
val source_a_body_changed: text = "fn alpha(x: i64) -> i64:\n    x + 2\n\nfn beta(x: text) -> bool:\n    x.len() > 0\n"
# Same code, comments/blank-line formatting only.
val source_a_commented: text = "# a comment\nfn alpha(x: i64) -> i64:\n    x + 1   \n\n\nfn beta(x: text) -> bool:  # trailing note\n    x.len() > 0\n"
# Regression fixture (2026-08-10 bug fix): a `#` inside a text literal must
# NOT be treated as a comment start. These two sources differ only in the
# text AFTER the `#` inside a string literal ("tag#1" vs "tag#2"). A naive
# line-based `#`-strip truncates both at the `#` and normalizes them to the
# IDENTICAL text, wrongly collapsing two different bodies into one
# implementation digest. A string-aware strip must keep them distinct.
val source_a_hash_in_literal_1: text = "fn alpha(x: i64) -> i64:\n    x + 1\n\nfn beta(x: text) -> bool:\n    x.len() > 0 and x != \"tag#1\"\n"
val source_a_hash_in_literal_2: text = "fn alpha(x: i64) -> i64:\n    x + 1\n\nfn beta(x: text) -> bool:\n    x.len() > 0 and x != \"tag#2\"\n"

use std.spec.step

describe "compile_interface_digest acceptance properties":
    it "body-only change: same interface digest, different implementation digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: body-only change: same interface digest, different implementation digest")
        val id1 = compute_module_identity(surface_a(), source_a)
        val id2 = compute_module_identity(surface_a(), source_a_body_changed)
        expect id1.compile_interface_digest == id2.compile_interface_digest
        expect id1.implementation_digest != id2.implementation_digest
        expect id1.source_digest != id2.source_digest

    it "comment/formatting-only change: same interface AND implementation digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: comment/formatting-only change: same interface AND implementation digest")
        val id1 = compute_module_identity(surface_a(), source_a)
        val id2 = compute_module_identity(surface_a(), source_a_commented)
        expect id1.compile_interface_digest == id2.compile_interface_digest
        expect id1.implementation_digest == id2.implementation_digest
        expect id1.source_digest != id2.source_digest

    it "private declaration added: same interface digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: private declaration added: same interface digest")
        var with_private = surface_a()
        with_private.add_function(fn_sig("helper", "i64", "i64", Some("private")))
        expect compile_interface_digest(surface_a()) == compile_interface_digest(with_private)

    it "public function signature change: different interface digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: public function signature change: different interface digest")
        var changed = ApiSurface.create("fixture.mod_a")
        changed.add_function(fn_sig("alpha", "text", "i64", nil))  # param i64 -> text
        changed.add_function(fn_sig("beta", "text", "bool", nil))
        expect compile_interface_digest(surface_a()) != compile_interface_digest(changed)

    it "public function return type change: different interface digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: public function return type change: different interface digest")
        var changed = ApiSurface.create("fixture.mod_a")
        changed.add_function(fn_sig("alpha", "i64", "bool", nil))  # ret i64 -> bool
        changed.add_function(fn_sig("beta", "text", "bool", nil))
        expect compile_interface_digest(surface_a()) != compile_interface_digest(changed)

    it "declaration iteration order does not change the digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: declaration iteration order does not change the digest")
        var reversed = ApiSurface.create("fixture.mod_a")
        reversed.add_function(fn_sig("beta", "text", "bool", nil))
        reversed.add_function(fn_sig("alpha", "i64", "i64", nil))
        expect compile_interface_digest(surface_a()) == compile_interface_digest(reversed)

    it "hash inside a string literal is not treated as a comment start (no false collision)":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: hash inside a string literal is not treated as a comment start (no false collision)")
        val id1 = compute_module_identity(surface_a(), source_a_hash_in_literal_1)
        val id2 = compute_module_identity(surface_a(), source_a_hash_in_literal_2)
        expect id1.compile_interface_digest == id2.compile_interface_digest
        expect id1.implementation_digest != id2.implementation_digest
        expect id1.source_digest != id2.source_digest

    it "placeholder abi/semantic digests are domain-separated from compile digest":
        # @req: REQ-COMPILER-INTERFACECOM-001
        step("Verify: placeholder abi/semantic digests are domain-separated from compile digest")
        val id = compute_module_identity(surface_a(), source_a)
        expect id.abi_interface_digest != id.compile_interface_digest
        expect id.compile_semantic_digest != id.compile_interface_digest
        expect id.link_export_digest != id.compile_interface_digest
