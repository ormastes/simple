"""
KPM Phase 1 mutation probe for the typed-HIR ABI field-type contribution.
"""

use std.spec.*
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.abi_interface.{hir_abi_interface_digest_v1}

fn typed_hir_abi_digest(source: text, name: text) -> Result<text, text>:
    val parsed = parse_full_frontend(source, "testdata/{name}.spl", name, Logger(level: 0))
    var lowering = HirLowering.with_filename("testdata/{name}.spl")
    hir_abi_interface_digest_v1(lowering.lower_module(parsed))

describe "KPM Phase 1 typed-HIR ABI field-type evidence":
    it "changes the ABI digest for the exact exported field-type comparison":
        val text_field = typed_hir_abi_digest(
            "pub struct Packet:\n    payload: text\n", "kpm_phase1_text").unwrap()
        val bytes_field = typed_hir_abi_digest(
            "pub struct Packet:\n    payload: [u8]\n", "kpm_phase1_bytes").unwrap()
        step("KPM_PHASE1_FIELD_TYPE_ABI_COMPARISON_SENTINEL_V1")
        expect(text_field != bytes_field).to_equal(true)
