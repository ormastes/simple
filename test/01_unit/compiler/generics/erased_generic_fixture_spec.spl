# @tag: unit, compiler, generics
"""
# Standalone generic regression programs

Each program in `test/fixtures/compiler/erased_generics/` carries its own
checks: a fixture exits 0 only when every check inside it held. Two of them
also print a PASS marker after their last check.

Run: `bin/simple test test/01_unit/compiler/generics/erased_generic_fixture_spec.spl`
"""

use std.spec
use std.nogc_sync_mut.io.process_ops.{process_run}

val DIR = "test/fixtures/compiler/erased_generics/"

fn run_fixture(name: text) -> (text, i64):
    val (out, _err, code) = process_run("bin/simple", ["run", DIR + name + ".spl"])
    (out, code)

describe "erased generic fixtures":
    it "sorts three record layouts through array_sort_by":
        val (out, code) = run_fixture("array_sort_by_native")
        expect(code).to_equal(0)
        expect(out).to_contain("PASS production array_sort_by")

    it "keeps callback ABI and generic tuple projection":
        val (out, code) = run_fixture("contextual_callback_native")
        expect(code).to_equal(0)
        expect(out).to_contain("PASS contextual callback ABI")

    it "projects a return-only optional tuple element":
        val (_out, code) = run_fixture("return_only_optional_tuple_native")
        expect(code).to_equal(0)

    it "passes typed keys through runtime generic boundaries":
        val (_out, code) = run_fixture("runtime_generic_typed_key_native")
        expect(code).to_equal(0)

    it "keeps the runtime generic extern ABI":
        val (_out, code) = run_fixture("runtime_generic_extern_abi_native")
        expect(code).to_equal(0)
