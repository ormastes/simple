# Purpose and audience: executable kernel/pluggable partition evidence for compiler maintainers.
# @req KPM-REQ-001 KPM-REQ-009 KPM-NFR-004 KPM-NFR-006
# plan: doc/03_plan/compiler/plugin_arch/kernel_plugin_migration_plan.md
# architecture: doc/04_architecture/compiler/plugin_arch/kernel_pluggable_partition.md

use std.spec
use std.spec.step
use std.io_runtime.{process_run}

fn checker(args: text) -> (text, text, i64):
    process_run("/bin/sh", ["-c", "scripts/check/check-kernel-closure.shs " + args])

describe "kernel closure classification":
    # KPM-NFR-004: the selected kernel closure remains independently checkable.
    # KPM-NFR-006: positive and mutation-red checks use executable assertions.
    it "passes clean fixtures and rejects forbidden imports and empty trees":
        step("Run the checker's clean, mutation-red, and empty-tree fixtures")
        val (output, errors, code) = checker("--selftest")
        expect(code).to_equal(0)
        expect(errors).to_equal("")
        expect(output).to_contain("PASS — 7 selftest fixture(s) checked")

    it "classifies every compiler file and reports the repository partition verdict":
        step("Classify the authoritative compiler tree with the versioned manifest")
        val (output, _errors, code) = checker("")
        expect(code).to_equal(0)
        expect(output).to_contain("0 unclassified")
        expect(output).to_contain("0 K0->P imports")
        expect(output).to_start_with("PASS —")
