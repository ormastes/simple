# Kernel closure manifest/checker executable contract (migration Phase 0).
# @req KERNEL-PLUGIN-PHASE-0
use std.spec.{describe, it, expect}
use std.io_runtime.{file_exists, read_file}
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

describe "compiler kernel closure partition":
    it "ships a versioned closure manifest and fail-closed checker":
        expect(file_exists("doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn")).to_equal(true)
        expect(file_exists("scripts/check/check-kernel-closure.shs")).to_equal(true)
        val manifest = read_file("doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn")
        expect(manifest.contains("simple/compiler/kernel-closure/v1")).to_equal(true)
        expect(manifest.contains("K0|src/compiler/10.frontend/**")).to_equal(true)
        expect(manifest.contains("K1|src/compiler/70.backend/**")).to_equal(true)
        expect(manifest.contains("P_STATIC|src/compiler/90.tools/**")).to_equal(true)

    it "proves clean pass, K0 to plugin rejection, and empty-tree error":
        val (out, err, code) = rt_process_run("sh", ["scripts/check/check-kernel-closure.shs", "--selftest"])
        expect(code).to_equal(0)
        expect((out + err).contains("kernel closure self-test OK")).to_equal(true)
