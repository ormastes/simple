#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../../.." && pwd)
cd "$ROOT"

set +e
cargo test --quiet \
    --manifest-path src/compiler_rust/compiler/Cargo.toml \
    --test kernel_phase7_strict_capability -- --nocapture
status=$?
set -e
printf 'KERNEL_PHASE7_STRICT_CAPABILITY_CARGO_STATUS=%s\n' "$status"
if test "$status" -ne 0; then
    echo "BLOCKED — one or more strict parse/HIR capability checks failed"
    exit "$status"
fi
echo "KERNEL_PHASE7_STRICT_CAPABILITY_PASS"
