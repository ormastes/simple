#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../../.." && pwd)
cd "$ROOT"

owner=src/compiler/90.tools/verify/layer_call_scan.spl
production=src/compiler/35.semantics/layer_call_wiring.spl
spec=test/01_unit/compiler/plugin_arch/kernel_dependency_boundary_spec.spl
canonical='use compiler.tools.verify.layer_call_scan.{scan_source_calls}'
stale='use compiler.semantics.layer_call_scan.{scan_source_calls}'

test -f "$owner"
grep -Fqx "$canonical" "$production"
grep -Fqx "$canonical" "$spec"
if grep -Fqx "$stale" "$production" || grep -Fqx "$stale" "$spec"; then
    echo "FAIL — stale layer_call_scan module owner remains"
    exit 1
fi

echo "KERNEL_RELOCATION_MODULE_RESOLUTION_PASS"
