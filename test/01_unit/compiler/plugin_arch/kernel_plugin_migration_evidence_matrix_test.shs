#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../../.." && pwd)
CHECKER=$ROOT/scripts/check/check-kernel-plugin-migration-evidence-matrix.shs

output=$($CHECKER)
printf '%s\n' "$output" | grep -Fq 'phases 0-8 have distinct positive and injected-defect contracts'

selftest_output=$($CHECKER --selftest)
printf '%s\n' "$selftest_output" | grep -Fq '9/9 phase mutations and runtime-authority forgery were rejected'

echo 'PASS: kernel plugin migration evidence matrix is complete and fail closed'
