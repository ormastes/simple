"""
## Purpose and audience
Purpose: Prove that Config.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-CONFIG-001 — stable requirement identity for this spec.

"""
# CompilerConfig Specification

**Category:** Infrastructure
**Status:** Implemented

## Overview

Tests for CompilerConfig struct — default construction, CLI arg parsing,
SDN application, key-value bag, and logger creation.
Tests that require extern functions (env_get) are noted.
"""

use compiler.common.config.{CompilerConfig, CompilerProfile, McdcPolicy, Config, Logger}


# ============================================================================
# Config (key-value bag)
# ============================================================================

use std.spec.step

describe "Config":
    context "default":
        it "creates empty config":
            step("Verify: creates empty config")
            # @req: REQ-COMPILER-CONFIG-001
            val config = Config.default()
            val result = config.get("anything")
            expect(result != nil).to_equal(false)

    context "get and set":
        it "stores and retrieves a value":
            step("Verify: stores and retrieves a value")
            var config = Config.default()
            config.set("key1", "value1")
            val result = config.get("key1")
            expect(result != nil).to_equal(true)
            expect(result).to_equal("value1")

        it "returns nil for missing key":
            step("Verify: returns nil for missing key")
            val config = Config.default()
            val result = config.get("nonexistent")
            expect(result != nil).to_equal(false)

        it "overwrites existing value":
            step("Verify: overwrites existing value")
            var config = Config.default()
            config.set("key", "first")
            config.set("key", "second")
            val result = config.get("key")
            expect(result).to_equal("second")

        it "handles multiple keys":
            step("Verify: handles multiple keys")
            var config = Config.default()
            config.set("a", "1")
            config.set("b", "2")
            config.set("c", "3")
            expect(config.get("a")).to_equal("1")
            expect(config.get("b")).to_equal("2")
            expect(config.get("c")).to_equal("3")


# ============================================================================
# CompilerConfig
# ============================================================================

describe "CompilerConfig":
    context "default":
        it "has Dev profile":
            step("Verify: has Dev profile")
            val config = CompilerConfig.default()
            expect(config.profile.to_text()).to_equal("dev")

        it "has zero log level":
            step("Verify: has zero log level")
            val config = CompilerConfig.default()
            expect(config.log_level).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "has use_rust_types false":
            step("Verify: has use_rust_types false")
            val config = CompilerConfig.default()
            expect(config.use_rust_types).to_equal(false)

        it "has use_rust_interp false":
            step("Verify: has use_rust_interp false")
            val config = CompilerConfig.default()
            expect(config.use_rust_interp).to_equal(false)

        it "has use_rust_lexer false":
            step("Verify: has use_rust_lexer false")
            val config = CompilerConfig.default()
            expect(config.use_rust_lexer).to_equal(false)

        it "has deterministic false":
            step("Verify: has deterministic false")
            val config = CompilerConfig.default()
            expect(config.deterministic).to_equal(false)

        it "has coverage_enabled false":
            step("Verify: has coverage_enabled false")
            val config = CompilerConfig.default()
            expect(config.coverage_enabled).to_equal(false)

        it "fully disables MC/DC by default":
            val config = CompilerConfig.default()
            expect(config.mcdc_policy.to_text()).to_equal("off")
            expect(config.mcdc_policy.emits_manifest()).to_equal(false)
            expect(config.mcdc_policy.emits_direct_probes()).to_equal(false)
            expect(config.mcdc_policy.emits_dynamic_patchpoints()).to_equal(false)
            expect(config.mcdc_policy.links_static_payload()).to_equal(false)

        it "has default type inference config":
            step("Verify: has default type inference config")
            val config = CompilerConfig.default()
            expect(config.type_inference.empty_array_default.to_text()).to_equal("i32")
            expect(config.type_inference.strict_empty_collections).to_equal(false)

    context "get":
        it "returns nil for missing key":
            step("Verify: returns nil for missing key")
            val config = CompilerConfig.default()
            val result = config.get("nonexistent")
            expect(result != nil).to_equal(false)

    context "apply_cli_args":
        it "sets use_rust_types flag":
            step("Verify: sets use_rust_types flag")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--use-rust-types"])
            expect(config.use_rust_types).to_equal(true)

        it "sets fast_interp flag":
            step("Verify: sets fast_interp flag")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--fast-interp"])
            expect(config.use_rust_interp).to_equal(true)

        it "sets fast_lex flag":
            step("Verify: sets fast_lex flag")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--fast-lex"])
            expect(config.use_rust_lexer).to_equal(true)

        it "sets deterministic flag":
            step("Verify: sets deterministic flag")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--deterministic"])
            expect(config.deterministic).to_equal(true)

        it "sets coverage flag":
            step("Verify: sets coverage flag")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--coverage"])
            expect(config.coverage_enabled).to_equal(true)
            expect(config.mcdc_policy.to_text()).to_equal("static")

        it "selects static and dynamic MC/DC policies explicitly":
            var static_config = CompilerConfig.default()
            static_config.apply_cli_args(["--mcdc-mode", "static"])
            expect(static_config.mcdc_policy.emits_direct_probes()).to_equal(true)
            expect(static_config.mcdc_policy.links_static_payload()).to_equal(true)
            var dynamic_config = CompilerConfig.default()
            dynamic_config.apply_cli_args(["--mcdc-mode", "dynamic"])
            expect(dynamic_config.mcdc_policy.emits_manifest()).to_equal(true)
            expect(dynamic_config.mcdc_policy.emits_direct_probes()).to_equal(false)
            expect(dynamic_config.mcdc_policy.emits_dynamic_patchpoints()).to_equal(true)

        it "retains invalid MC/DC policy for fail-closed driver rejection":
            var config = CompilerConfig.default()
            config.apply_cli_args(["--mcdc-mode", "surprise"])
            expect(config.mcdc_policy.to_text()).to_equal("invalid")
            expect(config.coverage_enabled).to_equal(false)

        it "rejects a missing MC/DC policy value":
            var config = CompilerConfig.default()
            config.apply_cli_args(["--mcdc-mode"])
            expect(config.mcdc_policy.to_text()).to_equal("invalid")
            expect(config.coverage_enabled).to_equal(false)

        it "sets profile with next arg":
            step("Verify: sets profile with next arg")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--profile", "prod"])
            expect(config.profile.to_text()).to_equal("prod")

        it "handles key=value form":
            step("Verify: handles key=value form")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--output-dir=/tmp/build"])
            val result = config.get("output-dir")
            expect(result != nil).to_equal(true)
            expect(result).to_equal("/tmp/build")

        it "handles multiple flags":
            step("Verify: handles multiple flags")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--deterministic", "--coverage", "--fast-lex"])
            expect(config.deterministic).to_equal(true)
            expect(config.coverage_enabled).to_equal(true)
            expect(config.use_rust_lexer).to_equal(true)

        it "ignores unknown flags":
            step("Verify: ignores unknown flags")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--unknown-flag"])
            # Should not crash; config unchanged
            expect(config.deterministic).to_equal(false)

    context "apply_sdn":
        it "applies key-value pairs from SDN content":
            step("Verify: applies key-value pairs from SDN content")
            var config = CompilerConfig.default()
            config.apply_sdn("output: build\noptimize: true")
            expect(config.get("output")).to_equal("build")
            expect(config.get("optimize")).to_equal("true")

        it "skips comments":
            step("Verify: skips comments")
            var config = CompilerConfig.default()
            config.apply_sdn("# comment\nkey: value")
            expect(config.get("key")).to_equal("value")

        it "skips empty lines":
            step("Verify: skips empty lines")
            var config = CompilerConfig.default()
            config.apply_sdn("\n\nkey: value\n\n")
            expect(config.get("key")).to_equal("value")

        it "does not overwrite existing values":
            step("Verify: does not overwrite existing values")
            var config = CompilerConfig.default()
            config.apply_cli_args(["--key=cli_value"])
            config.apply_sdn("key: sdn_value")
            # CLI takes precedence (already set before SDN)
            expect(config.get("key")).to_equal("cli_value")

    context "logger":
        it "creates logger with configured log level":
            step("Verify: creates logger with configured log level")
            var config = CompilerConfig.default()
            config.log_level = 10
            val log = config.logger()
            expect(log.level).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "creates silent logger by default":
            step("Verify: creates silent logger by default")
            val config = CompilerConfig.default()
            val log = config.logger()
            expect(log.level).to_equal(0)  # oracle: 0 — named expected value from the requirement


# ============================================================================
# Logger
# ============================================================================

describe "Logger":
    context "construction":
        it "stores configured level":
            step("Verify: stores configured level")
            val log = Logger(level: 4)
            expect(log.level).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "zero level is silent":
            step("Verify: zero level is silent")
            val log = Logger(level: 0)
            expect(log.level).to_equal(0)  # oracle: 0 — named expected value from the requirement


# ============================================================================
# from_env
# ============================================================================

describe "CompilerConfig.from_env":
    context "reading env vars via the local inline env_get":
        it "does not abort under the strict SFFI non-optional return contract":
            step("Verify: from_env() reads SIMPLE_PROFILE/SIMPLE_LOG/etc via env_get without crashing")
            # Regression for non_optional_wrappers_return_nil_sweep_2026-08-21:
            # `env_get` in compiler/00.common/config.spl used to be declared
            # `-> text` while directly forwarding `rt_env_get(key)`, which
            # returns nil for an unset variable. Under the strict SFFI
            # non-optional-return contract this aborted with "nil is
            # forbidden by the non-optional return contract of 'env_get'"
            # the moment `from_env()` ran — i.e. before compilation even
            # started. `env_get` is now declared `-> text?`.
            val config = CompilerConfig.from_env()
            expect(config != nil).to_equal(true)
