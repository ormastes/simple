"""
# TypeInferenceConfig & TypeDefault Specification

**Category:** Infrastructure
**Status:** Implemented

## Overview

Tests for TypeDefault enum and TypeInferenceConfig struct — pure logic
type inference configuration that works in interpreter mode.
"""
use std.spec.step

use std.spec.step

use compiler.common.config.{TypeDefault, TypeInferenceConfig}



# ============================================================================
# TypeDefault Enum
# ============================================================================

describe "TypeDefault":
    # @manual scenario evidence
    context "to_text":
        it "converts Void":
            # @req REQ-SSPEC-UNIT
            step("converts Void")
            expect(TypeDefault.Void.to_text()).to_equal("void")

        it "converts Bool":
            # @req REQ-SSPEC-UNIT
            step("converts Bool")
            expect(TypeDefault.Bool.to_text()).to_equal("bool")

        it "converts I8":
            # @req REQ-SSPEC-UNIT
            step("converts I8")
            expect(TypeDefault.I8.to_text()).to_equal("i8")

        it "converts I16":
            # @req REQ-SSPEC-UNIT
