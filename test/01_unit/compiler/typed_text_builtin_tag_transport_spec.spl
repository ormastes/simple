use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text?

describe "typed text builtin tag transport":
    it "assigns tags only from exact owner-qualified names":
        val hir = rt_file_read_text("src/compiler/20.hir/hir_types.spl") ?? ""
        expect(hir).to_contain("if qualified_name.len() != 9:")
        expect(hir).to_contain("char_code(qualified_name[4]) == 115")
        expect(hir).to_contain("char_code(qualified_name[4]) == 108")
        expect(hir.contains("qualified_name == \"str.")).to_equal(false)
        expect(hir).to_contain("builtin_method_tag: hir_builtin_method_tag(name)")

    it "preserves the scalar through rename codec and MIR lowering":
        val symbols = rt_file_read_text("src/compiler/20.hir/hir_symbol_table_methods.spl") ?? ""
        val codec = rt_file_read_text("src/compiler/20.hir/generated/hir_codec.spl") ?? ""
        val mir = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        expect(symbols).to_contain("builtin_method_tag: hir_builtin_method_tag(new_name)")
        expect(codec).to_contain("w.put_i64(node.builtin_method_tag)")
        expect(codec).to_contain("builtin_method_tag: f_builtin_method_tag")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_STRIP")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_LINES")
        expect(mir.contains("rt_text_eq_any")).to_equal(false)
        expect(mir.contains("rt_text_cmp_any")).to_equal(false)
