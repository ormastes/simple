use std.spec.{describe, it, expect}
use compiler.hir.hir_types.{
    hir_builtin_method_tag,
    BUILTIN_METHOD_NONE, BUILTIN_METHOD_STR_STRIP, BUILTIN_METHOD_STR_LINES,
    BUILTIN_METHOD_STR_LEN, BUILTIN_METHOD_STR_CONTAINS,
    BUILTIN_METHOD_STR_STARTS_WITH,
}

extern fn rt_file_read_text(path: text) -> text?

describe "typed text builtin tag transport":
    it "classifies exact text owners and rejects custom or flattened names":
        expect(hir_builtin_method_tag("str.strip")).to_equal(BUILTIN_METHOD_STR_STRIP)
        expect(hir_builtin_method_tag("str.lines")).to_equal(BUILTIN_METHOD_STR_LINES)
        expect(hir_builtin_method_tag("str.len")).to_equal(BUILTIN_METHOD_STR_LEN)
        expect(hir_builtin_method_tag("str.contains")).to_equal(BUILTIN_METHOD_STR_CONTAINS)
        expect(hir_builtin_method_tag("str.starts_with")).to_equal(BUILTIN_METHOD_STR_STARTS_WITH)
        expect(hir_builtin_method_tag("custom.len")).to_equal(BUILTIN_METHOD_NONE)
        expect(hir_builtin_method_tag("str_len")).to_equal(BUILTIN_METHOD_NONE)
        expect(hir_builtin_method_tag("str.ends_with")).to_equal(BUILTIN_METHOD_NONE)

    it "assigns tags only from exact owner-qualified names":
        val hir = rt_file_read_text("src/compiler/20.hir/hir_types.spl") ?? ""
        expect(hir).to_contain("val BUILTIN_METHOD_STR_LEN = 3")
        expect(hir).to_contain("val BUILTIN_METHOD_STR_CONTAINS = 4")
        expect(hir).to_contain("val BUILTIN_METHOD_STR_STARTS_WITH = 5")
        expect(hir).to_contain("if name_len == 7")
        expect(hir).to_contain("if name_len == 12")
        expect(hir).to_contain("if name_len == 15")
        expect(hir.contains("qualified_name == \"str.")).to_equal(false)
        expect(hir).to_contain("builtin_method_tag: hir_builtin_method_tag(name)")

    it "preserves the scalar through rename codec and MIR lowering":
        val symbols = rt_file_read_text("src/compiler/20.hir/hir_symbol_table_methods.spl") ?? ""
        val codec = rt_file_read_text("src/compiler/20.hir/generated/hir_codec.spl") ?? ""
        val mir = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        expect(symbols).to_contain("builtin_method_tag: hir_builtin_method_tag(new_name)")
        expect(codec).to_contain("w.put_i64(node.builtin_method_tag)")
        expect(codec).to_contain("builtin_method_tag: f_builtin_method_tag")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_STRIP")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_LINES")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_LEN")
        expect(mir).to_contain("name = \"rt_string_len\"")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_CONTAINS")
        expect(mir).to_contain("name = \"rt_string_contains\"")
        expect(mir).to_contain("builtin_method_tag == BUILTIN_METHOD_STR_STARTS_WITH")
        expect(mir).to_contain("name = \"rt_string_starts_with\"")
        expect(mir.contains("rt_text_eq_any")).to_equal(false)
        expect(mir.contains("rt_text_cmp_any")).to_equal(false)
