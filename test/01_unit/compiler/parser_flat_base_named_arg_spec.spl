# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

"""
# Parser: `flat` and other soft keywords as named-argument labels

`S(flat: 1, base: 2)` failed with "expected Comma, found Colon": `flat` lexes
as a keyword token (tensor literal mode) and was missing from the seed's
named-argument label allow-list. `base` is a plain identifier. Same hole for
slice, common, comptime, newtype, bitfield, extend, asm and out_err.
The pure-Simple parser accepts any keyword before `:`/`=` and was not affected.
A parse error stops this file loading, so the constructions are the coverage.
"""

use std.spec

struct FlatBase:
    flat: i64
    base: i64

struct SoftKw:
    slice: i64
    common: i64
    comptime: i64
    newtype: i64
    bitfield: i64
    extend: i64
    asm: i64
    out_err: i64

fn sum_flat_base(flat: i64, base: i64) -> i64:
    flat + base

describe("soft keywords as named-argument labels"):
    it("accepts flat and base in a constructor"):
        val s = FlatBase(flat: 1, base: 2)
        assert_equal(s.flat, 1)
        assert_equal(s.base, 2)

    it("accepts flat and base in a call, in any order"):
        assert_equal(sum_flat_base(base: 20, flat: 1), 21)

    it("accepts the other soft keywords"):
        val k = SoftKw(slice: 1, common: 2, comptime: 3, newtype: 4, bitfield: 5, extend: 6, asm: 7, out_err: 8)
        assert_equal(k.slice + k.common + k.comptime + k.newtype, 10)
        assert_equal(k.bitfield + k.extend + k.asm + k.out_err, 26)

describe("flat and base remain ordinary values elsewhere"):
    it("reads flat as a local and positional argument"):
        val flat = 3
        val base = 4
        assert_equal(sum_flat_base(flat, base), 7)
