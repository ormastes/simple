"""
# Text methods on a value unwrapped from `text?` -- executable engine probe

**Category:** Compiler / HIR lowering
**Status:** Implemented
**Research:** doc/08_tracking/bug/bug_db.sdn row
             interp_option_unwrapped_text_starts_with_nil_2026_10_19

## Why this is a runnable program and not an sspec `describe`

An sspec body always runs on the tree-walking interpreter, which was never
wrong here. The defect is Cranelift-JIT only: `opt(x)!` was typed `ANY` and
`opt(x) ?? d` kept the `text?` pointer type, so `.starts_with` / `.ends_with`
/ `.find` / `.rfind` fell to the generic dynamic fallback with no result type
and their RAW bool / i64 results were never boxed -- `true` printed `nil`,
`false` printed `0`, and `if b.starts_with(p)` took the false branch. That
broke `is_strict_storage_descendant` (storage_roots/path_policy.spl) and with
it every MCP caret_* tool.

Run once per engine and score the `PROBE VERDICT:` line:

    SIMPLE_EXECUTION_MODE=interpret <simple> run <this file>
    SIMPLE_EXECUTION_MODE=jit       <simple> run <this file>

Caller: test/01_unit/compiler/unwrapped_text_method_dispatch_spec.spl
"""

var failures = 0

fn check_text(name: text, got: text, want: text) -> void:
    if got == want:
        print("  ok   " + name)
    else:
        print("  FAIL " + name + " (got " + got + ", want " + want + ")")
        failures = failures + 1

fn opt(s: text) -> text?:
    Some(s)

fn none_text() -> text?:
    nil

fn flat_text(s: text) -> text?:
    if s == "":
        return nil
    s

fn try_prefix(x: text) -> text?:
    val s = opt(x)?
    if s.starts_with("/h"):
        return Some("yes")
    Some("no")

fn flat_i64(n: i64) -> i64?:
    if n < 0:
        return nil
    n

fn branch(flag: bool) -> text:
    if flag:
        return "taken"
    "skipped"

fn main() -> void:
    print("unwrapped text method dispatch probe")

    # --- `!` force unwrap bound to a val ------------------------------------
    val b = opt("/h/s/tmp")!
    check_text("bang starts_with true", "{b.starts_with("/h/s/")}", "true")
    check_text("bang starts_with false", "{b.starts_with("zz")}", "false")
    check_text("bang ends_with true", "{b.ends_with("tmp")}", "true")
    check_text("bang ends_with false", "{b.ends_with("zz")}", "false")
    check_text("bang contains", "{b.contains("/s/")}", "true")
    check_text("bang len", "{b.len()}", "8")
    check_text("bang trim", b.trim(), "/h/s/tmp")
    check_text("bang split len", "{b.split("/").len()}", "4")
    check_text("bang find", "{b.find("s")}", "3")
    check_text("bang rfind", "{b.rfind("/")}", "4")
    check_text("bang index_of", "{b.index_of("s")}", "3")
    check_text("bang is_empty", "{b.is_empty()}", "false")
    var bad_branch = "skipped"
    if b.starts_with("/h"):
        bad_branch = "taken"
    check_text("bang starts_with in if", bad_branch, "taken")
    check_text("bang starts_with as bool arg", branch(b.ends_with("tmp")), "taken")

    # --- `!` inline and through a var ---------------------------------------
    check_text("inline bang starts_with", "{opt("/h/s/tmp")!.starts_with("/h")}", "true")
    var vb = opt("/h/s/tmp")!
    check_text("var bang ends_with", "{vb.ends_with("tmp")}", "true")

    # --- `??` coalesce -------------------------------------------------------
    val d = opt("/h/s/tmp") ?? "d"
    check_text("coalesce starts_with true", "{d.starts_with("/h/s/")}", "true")
    check_text("coalesce starts_with false", "{d.starts_with("zz")}", "false")
    check_text("coalesce ends_with true", "{d.ends_with("tmp")}", "true")
    check_text("coalesce find", "{d.find("s")}", "3")
    check_text("coalesce len", "{d.len()}", "8")
    val dn = none_text() ?? "/def"
    check_text("coalesce default starts_with", "{dn.starts_with("/d")}", "true")
    check_text("inline coalesce ends_with", "{(opt("/h/s/tmp") ?? "d").ends_with("tmp")}", "true")

    # --- `text?` compared with `Some(x)` -------------------------------------
    # A flat `text?` (function returns the bare text) vs a boxed `Some(x)`:
    # path_policy validate_storage_containment compares exactly this shape
    # (`_canonical_lexical(resolved_root) != Some(normalized_root.value)`).
    val v = "abc"
    check_text("flat == Some", "{flat_text(v) == Some(v)}", "true")
    check_text("flat != Some", "{flat_text(v) != Some(v)}", "false")
    check_text("flat == Some other", "{flat_text(v) == Some("zz")}", "false")
    check_text("Some == flat", "{Some(v) == flat_text(v)}", "true")
    check_text("boxed == Some", "{opt(v) == Some(v)}", "true")
    check_text("nil != Some", "{none_text() != Some(v)}", "true")
    val n = 5
    check_text("flat i64 == Some", "{flat_i64(n) == Some(n)}", "true")
    check_text("raw i64 == Some", "{n == Some(5)}", "true")
    check_text("raw i64 != Some other", "{n != Some(6)}", "true")
    val flag = true
    check_text("raw bool == Some", "{flag == Some(true)}", "true")
    check_text("text == Some", "{v == Some(v)}", "true")

    # --- `?` propagation on a `text?` feeds a text receiver --------------------
    check_text("try then starts_with", try_prefix("/h/x") ?? "none", "yes")

    if failures == 0:
        print("PROBE VERDICT: PASS")
    else:
        print("PROBE VERDICT: FAIL (" + failures.to_text() + " checks wrong)")
