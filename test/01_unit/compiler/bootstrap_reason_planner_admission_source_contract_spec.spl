# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




"""Static source contract for fail-closed bootstrap planner authorization v2."""

use std.spec.step

use std.io.file.{file_read}

describe "bootstrap reason planner v2":
    # @manual scenario evidence
    val source = file_read("src/app/cli/bootstrap_reason_planner.spl")

fn compiler_binary() -> text:
    if rt_file_exists("bin/simple"):
        "bin/simple"
    else:
        "/mnt/data/worktrees/simple-main/bin/simple"

fn sha64(ch: text) -> text:
    var out = ""
    var i = 0
    while i < 64:
        out = out + ch
        i = i + 1
    out

fn run_planner(target: text, reason: text, receipt: text, parent: text, runtime_sha: text, closure: text, planner: text) -> (text, i64):
    val args = [
        "run", "src/app/cli/bootstrap_reason_planner.spl",
        "--bootstrap-target=" + target,
        "--bootstrap-reason=" + reason,
        "--bootstrap-receipt=" + receipt,
        "--parent-compiler-sha256=" + parent,
        "--runtime-snapshot-sha256=" + runtime_sha,
        "--planner-source-closure-sha256=" + closure,
        "--planner-sha256=" + planner
    ]
    val (_mk_out, _mk_err, _mk_rc) = rt_process_run_timeout("/bin/sh",
        ["-c", "mkdir -p build/land11_spec_fx"], 30000)
    val (out, _err, rc) = rt_process_run_timeout(compiler_binary(), args, 300000)
    (out, rc)

describe "bootstrap reason planner v2":
    it "admits only the Stage 3 and Stage 4 targets":
        # @req REQ-SSPEC-COMPILER
        step("admits only the Stage 3 and Stage 4 targets")
        expect(source.contains("target == \"//bootstrap:stage3\"")).to_equal(true)
        expect(source.contains("target == \"//bootstrap:stage4\"")).to_equal(true)
        expect(source.contains("starts_with(\"//bootstrap:\")")).to_equal(false)
        expect(source.contains("starts_with(\"//release:\")")).to_equal(false)

    it "requires all four binding hashes":
        # @req REQ-SSPEC-COMPILER
        step("requires all four binding hashes")
        expect(source.contains("--parent-compiler-sha256=")).to_equal(true)
        expect(source.contains("--runtime-snapshot-sha256=")).to_equal(true)
        expect(source.contains("--planner-source-closure-sha256=")).to_equal(true)
        expect(source.contains("--planner-sha256=")).to_equal(true)
        expect(source.contains("simple-bootstrap-authorization-v2")).to_equal(true)
