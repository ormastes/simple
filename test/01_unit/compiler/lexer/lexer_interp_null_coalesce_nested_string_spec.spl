# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

# Regression: a nested `""` on the RHS of `??` inside string interpolation.
#
# `h1_decode_content_encoding(framed, "{encoding ?? ""}")` (h1_client.spl:649)
# is accepted by the seed/interpreter but the self-hosted CoreLexer split it:
# the inner `"` closed the OUTER string, leaving `"}"` as a second StringLit and
# the native parser reported `expected ), got StringLit '}'`.
#
# Root cause: `fs_nested_string_may_open` (core/lexer_struct.spl) recognised
# `== != <= >=` as operand-expecting two-char operators but not `??`, which
# the seed's `nested_string_may_open` (compiler_rust/parser/src/lexer/
# strings.rs) already lists.
#
# The `!=` rows are the discriminator: same call shape, already GREEN.

use std.spec.step

use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text}
use compiler.frontend.core.tokens.{TOK_EOF}


describe "Lexer nested string after ?? in interpolation":
    # @manual scenario evidence

    # Render the token stream as `<kind>:<text>|...`.
    fn lex_render(src: text) -> text:
        var lx: CoreLexer = make_core_lexer(src)
        var out: text = ""
        var seen: i64 = 0
        for i in 0..20:
            val r = core_lexer_next_token(lx)
            lx = r.0
            val k: i64 = r.1
            if k == 0 or k == TOK_EOF:
                break
            if seen > 0:
                out = out + "|"
            out = out + k.to_text() + ":" + core_lexer_token_text(lx)
            seen = seen + 1
        return out

    # `f("{<expr>}")` built without interpolating it in THIS file.
    fn call_with_interp(expr: text) -> text:
        val q = "\""
        return "f(" + q + r"{" + expr + r"}" + q + ")"

    fn expected_tokens(expr: text) -> text:
        # One string token holding the whole `{...}` body, then `)`.
        val first = lex_render("f(")
        val close = lex_render(")")
        return first + "|3:" + r"{" + expr + r"}" + "|" + close

    it "keeps a not-equal nested empty string in one token (discriminator)":
        # @req REQ-SSPEC-UNIT
        step("keeps != nested empty string as one token")
        val q = "\""
        val expr = "k != " + q + q
        expect(lex_render(call_with_interp(expr))).to_equal(expected_tokens(expr))

    it "keeps a null-coalesce nested empty string in one token":
        # @req REQ-SSPEC-UNIT
        step("keeps ?? nested empty string as one token")
        val q = "\""
        val expr = "x ?? " + q + q
        expect(lex_render(call_with_interp(expr))).to_equal(expected_tokens(expr))

    it "keeps a null-coalesce nested non-empty string in one token":
        # @req REQ-SSPEC-UNIT
        step("keeps ?? nested non-empty string as one token")
        val q = "\""
        val expr = "x??" + q + "d" + q
        expect(lex_render(call_with_interp(expr))).to_equal(expected_tokens(expr))
