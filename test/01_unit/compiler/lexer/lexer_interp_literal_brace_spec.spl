# Regression: bug string_literal_brace_breaks_concat_2026-06-29
#
# Inside an interpolated string, an unescaped `"` may only OPEN a NESTED string
# where an operand is expected (paren_depth > 0, after a binary/logical
# operator, or inside if/else/match). Anywhere else it CLOSES the outer string
# and the preceding `{` was a literal brace.
#
# Both directions matter, and the history of this bug is fixes that broke the
# other one:
#   * literal braces  `"p { " + v + " }"` must keep their `+` operators
#   * nested quotes   `"{xs.join("-")}"` must stay one string token
#
# Probe inputs are assembled with char_from_code so this spec's own source
# contains no `{`/`}`/`"` that could be mis-lexed while reading the spec.

use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text}
use std.string_core.{char_from_code}

describe "Lexer interpolation vs literal brace":

    # Lex `src` and render the token stream as `<text>|<text>|...` so a single
    # expect() pins both the token split and each token's text.
    fn lex_render(src: text) -> text:
        var lx: CoreLexer = make_core_lexer(src)
        var out: text = ""
        var seen: i64 = 0
        for i in 0..40:
            val r = core_lexer_next_token(lx)
            lx = r.0
            val k: i64 = r.1
            # 1520 = EOF/newline padding emitted after the real tokens.
            if k == 0 or k == 1520:
                break
            if seen > 0:
                out = out + "|"
            out = out + core_lexer_token_text(lx)
            seen = seen + 1
        return out

    fn q() -> text:
        return char_from_code(34)

    fn lb() -> text:
        return char_from_code(123)

    fn rb() -> text:
        return char_from_code(125)

    it "keeps concatenation operators around a literal brace":
        # "p { " + v + " }"
        val src = q() + "p " + lb() + " " + q() + " + v + " + q() + " " + rb() + q()
        expect(lex_render(src)).to_equal("p " + lb() + " |+|v|+| " + rb())

    it "keeps concatenation operators for a css declaration brace":
        # "p { q: " + v + "; }"
        val src = q() + "p " + lb() + " q: " + q() + " + v + " + q() + "; " + rb() + q()
        expect(lex_render(src)).to_equal("p " + lb() + " q: |+|v|+|; " + rb())

    it "keeps a literal brace with trailing text":
        # "x { " + v + " } y"
        val src = q() + "x " + lb() + " " + q() + " + v + " + q() + " " + rb() + " y" + q()
        expect(lex_render(src)).to_equal("x " + lb() + " |+|v|+| " + rb() + " y")

    it "does not split a nested string inside a call":
        # "{xs.join("-")}"
        val inner = lb() + "xs.join(" + q() + "-" + q() + ")" + rb()
        expect(lex_render(q() + inner + q())).to_equal(inner)

    it "does not split a plain interpolation":
        # "{a + b}"
        val inner = lb() + "a + b" + rb()
        expect(lex_render(q() + inner + q())).to_equal(inner)

    it "allows a nested string right after a binary operator":
        # "{k != ""}"
        val inner = lb() + "k != " + q() + q() + rb()
        expect(lex_render(q() + inner + q())).to_equal(inner)

    it "allows nested strings inside an inline conditional":
        # "{if c: "y" else: "n"}"
        val inner = lb() + "if c: " + q() + "y" + q() + " else: " + q() + "n" + q() + rb()
        expect(lex_render(q() + inner + q())).to_equal(inner)
