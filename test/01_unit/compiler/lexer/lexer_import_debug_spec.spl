use std.spec.{describe, it, expect, step}
use compiler.core.lexer_types.{Token, LexSpan, TokenKind, token_kind_code}
use compiler.core.lexer_chars.{is_digit, is_ident_char}
use compiler.frontend.core.lexer.{Lexer, lex_init, lex_next_snapshot}
use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer}

extern fn rt_file_read_text(path: text) -> text?

describe "Lexer Import Debug":
    """Verifies current lexer module imports, types, and entry points."""

    it "documents the current lexer import surface":
        val lexer = rt_file_read_text("src/compiler/10.frontend/core/lexer.spl") ?? ""
        val types = rt_file_read_text("src/compiler/10.frontend/core/lexer_types.spl") ?? ""

        expect(lexer).to_contain("use compiler.core.lexer_types.{Token, TokenKind, LexSpan")
        expect(lexer).to_contain("use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer")
        expect(types).to_contain("struct LexSpan:")
        expect(types).to_contain("struct Token:")
        expect(types).to_contain("fn lex_token_new(kind: i64, text: text, line: i64, col: i64) -> Token:")

    it "documents character helper imports used by lexer modules":
        val chars = rt_file_read_text("src/compiler/10.frontend/core/lexer_chars.spl") ?? ""
        val core = rt_file_read_text("src/compiler/10.frontend/core/lexer_struct.spl") ?? ""

        expect(core).to_contain("use compiler.core.lexer_chars.{is_digit")
        expect(chars).to_contain("char_code")
        expect(chars).to_contain("pub fn is_digit(c: text) -> bool:")
        expect(chars).to_contain("pub fn is_ident_char(c: text) -> bool:")

    it "imports and invokes TokenKind, is_digit, Lexer, and CoreLexer":
        step("Inspect TokenKind and character helper imports")
        expect(token_kind_code(TokenKind.KwFn)).to_be_greater_than(0)
        expect(is_digit("5")).to_equal(true)
        expect(is_digit("a")).to_equal(false)
        expect(is_ident_char("_")).to_equal(true)

        step("Construct Lexer and CoreLexer wrappers and scan a token")
        val lexer = Lexer.new("fn demo")
        val core = make_core_lexer("fn demo")
        expect(core.pos).to_equal(0)
        lex_init("fn demo")
        val first = lex_next_snapshot()
        expect(first.token_text).to_equal("fn")
        expect(first.line).to_equal(1)
        expect(first.col).to_equal(1)
        expect(lexer.dummy).to_equal(0)

