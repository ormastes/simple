use std.io.{file_read}

describe "lexer native array length boundary":
    it "uses direct concrete array length operations":
        val source = file_read("src/compiler/10.frontend/core/lexer.spl")

        expect(source.contains("fn lexer_array_len<")).to_equal(false)
        expect(source.contains("lexer_array_len(")).to_equal(false)
        expect(source).to_contain("lex_source_codes.len()")
        expect(source).to_contain("current_core_lexer_slot.len()")
        expect(source).to_contain("lex_env_save_enabled.len()")
        expect(source).to_contain("lex_inline_source_slot.len()")
        expect(source).to_contain("fn lexer_new(source: text) -> Lexer:")
        expect(source).to_contain("fn lexer_next_token(self: Lexer) -> Token:")
