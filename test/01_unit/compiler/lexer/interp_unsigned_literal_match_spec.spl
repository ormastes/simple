# Purpose and audience: regression evidence for interpreter literal patterns on sized values.
# @req REQ-SSPEC-COMPILER

use std.spec.step
use std.nogc_sync_mut.simd.{Vec4f, simd_mul_f32x4}

fn csr_known(addr: u64) -> bool:
    match addr:
        case 0x300u64: true
        case 0xC00u64: true
        case _: false

describe "interpreter literal patterns on sized values":
    it "matches a u64 scrutinee against typed integer literal arms":
        expect(csr_known(0x300u64)).to_equal(true)
        expect(csr_known(0xC00u64)).to_equal(true)
        expect(csr_known(5u64)).to_equal(false)

    it "accepts f32-cast lanes in Vec4f SIMD externs":
        val a = 2.0 as f32
        val v = Vec4f(x: a, y: a, z: a, w: a)
        val r = simd_mul_f32x4(v, v)
        expect(r.x == 4.0).to_equal(true)
