"""
## Purpose and audience
Purpose: Prove that numeric separators.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LEXER-001 — stable requirement identity for this spec.

# Numeric separator spec
#
# Tests for _ separator in numeric literals

use std.spec.step

describe "numeric separators":
    it "underscore in decimal integer":
        step("Verify: underscore in decimal integer")
        # @req: REQ-COMPILER-LEXER-001
        val n = 1_000_000
        expect(n).to_equal(1000000)  # oracle: 1000000 — named expected value from the requirement

    it "underscore in smaller number":
        step("Verify: underscore in smaller number")
        val n = 1_234
        expect(n).to_equal(1234)  # oracle: 1234 — named expected value from the requirement

    it "hex literal with underscore":
        step("Verify: hex literal with underscore")
        val n = 0xFF_FF
        expect(n).to_equal(65535)  # oracle: 65535 — named expected value from the requirement

    it "binary literal with underscore":
        step("Verify: binary literal with underscore")
        val n = 0b1111_0000
        expect(n).to_equal(240)  # oracle: 240 — named expected value from the requirement

    it "float with underscore":
        step("Verify: float with underscore")
        val f = 3.141_592
        expect(f).to_equal(3.141592)  # oracle: 3.141592 — named expected value from the requirement

    it "multiple underscores work":
        step("Verify: multiple underscores work")
        val n = 1_000_000_000
        expect(n).to_equal(1000000000)  # oracle: 1000000000 — named expected value from the requirement
