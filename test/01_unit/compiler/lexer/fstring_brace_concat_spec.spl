# Purpose and audience: regression evidence for text-literal brace handling.
# @req REQ-SSPEC-COMPILER

use std.spec.step

describe "text literal with a brace run before a concatenation":
    it "closes the literal at its own quote when the brace body is not an expression":
        val v: text = "V"
        val s = "B2=[" + ("{x (" + v + ")} y") + "]"
        expect(s).to_equal("B2=[{x (V)} y]")

    it "still parses nested strings inside a real hole":
        val xs = ["a", "b"]
        val s = "j={xs.join("-")}"
        expect(s).to_equal("j=a-b")
