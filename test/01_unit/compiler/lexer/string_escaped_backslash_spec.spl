use std.spec.*

# seed_escaped_backslash_n_lexes_as_newline_2026-11-23: an escaped backslash
# is consumed once; the following letter is not unescaped a second time.
describe "string literal escaped backslash":
    it "keeps backslash + n":
        val s = "\\n"
        expect(s.len()).to_equal(2)
        expect(s.bytes()).to_equal([92u8, 110u8])
        expect(("a\\nb").len()).to_equal(4)

    it "keeps backslash + n inside an array literal":
        val payloads = ["a", "\\n", "\\\\"]
        expect(payloads[1].len()).to_equal(2)
        expect(payloads[2].len()).to_equal(2)

    it "keeps backslash + t, r, N and a doubled backslash":
        expect(("\\t").len()).to_equal(2)
        expect(("\\r").len()).to_equal(2)
        expect(("\\N").len()).to_equal(2)
        expect(("\\\\").len()).to_equal(2)

    it "still decodes a single escape":
        expect(("\n").len()).to_equal(1)
        expect(("\\\n").len()).to_equal(2)

    it "keeps backslash + n after an interpolation":
        val x = 1
        expect(("{x}\\n").len()).to_equal(3)
