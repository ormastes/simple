"""
## Purpose and audience
Purpose: Prove numbered last-segment resolution performs one directory scan.
Audience: compiler and loader engineers maintaining module resolution.
"""
# @req: REQ-COMPILER-MODULE-RESOLVER-001

use std.spec.*
use std.io_runtime.{dir_create_all, dir_remove_all, file_read, file_write}
use compiler.loader.module_resolver.types.{ModulePath, moduleresolver_new}
use compiler.loader.module_resolver.resolution

val FIXTURE_ROOT = "build/test-artifacts/numbered_last_segment_single_scan"
val RESOLUTION_SOURCE = "src/compiler/99.loader/module_resolver/resolution.spl"

fn reset_fixture(name: text) -> text:
    val root = FIXTURE_ROOT + "/" + name
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root + "/src")).to_equal(true)
    root

fn resolve_from_base_body() -> text:
    val source = file_read(RESOLUTION_SOURCE)
    val start_marker = "    fn resolve_from_base("
    val end_marker = "    fn get_exports("
    val start = source.find(start_marker)
    if start < 0:
        fail("resolve_from_base start marker is missing")
        return ""
    val tail = source.substring(start, source.len())
    val finish = tail.find(end_marker)
    if finish < 0:
        fail("resolve_from_base end marker is missing")
        return ""
    tail.substring(0, finish)

describe "numbered last-segment resolution uses one scan":
    it "resolves NN.name/__init__.spl through the retained numbered fallback":
        step("Create a numbered directory module")
        val root = reset_fixture("success")
        val numbered = root + "/src/42.widget"
        expect(dir_create_all(numbered)).to_equal(true)
        expect(file_write(numbered + "/__init__.spl", "fn marker() -> i64:\n    42\n")).to_equal(true)

        step("Resolve crate.widget through the public resolver")
        var resolver = moduleresolver_new(root, root + "/src")
        val result = resolver.resolve(ModulePath(segments: ["crate", "widget"]), root + "/src/main.spl")
        match result:
            case Ok(resolved):
                expect(resolved.path).to_equal(numbered + "/__init__.spl")
                expect(resolved.is_directory).to_equal(true)
            case Err(err):
                fail("numbered directory module did not resolve: " + err.message())

    it "keeps the exact E1034 message when the numbered directory lacks an init":
        step("Create the matching numbered directory without __init__.spl")
        val root = reset_fixture("missing_init")
        expect(dir_create_all(root + "/src/42.widget")).to_equal(true)

        step("Resolve crate.widget and preserve the public error")
        var resolver = moduleresolver_new(root, root + "/src")
        val result = resolver.resolve(ModulePath(segments: ["crate", "widget"]), root + "/src/main.spl")
        match result:
            case Ok(resolved):
                fail("numbered directory without __init__.spl unexpectedly resolved: " + resolved.path)
            case Err(err):
                expect(err.message()).to_equal(
                    "cannot resolve import: module `widget` not found; create either " +
                    root + "/src/widget.spl or " + root + "/src/widget/__init__.spl")

    it "contains exactly one last-segment numbered-directory lookup":
        step("Inspect only the resolve_from_base implementation")
        val body = resolve_from_base_body()

        step("Pin the single cached-entry scan and forbid the deleted no-op block")
        expect(body.split("find_numbered_dir(current, last)").len()).to_equal(2)
        expect(body.contains("val numbered_parent =")).to_equal(false)
