"""
Bare tier import (`use common.x`) must resolve to src/lib/<tier>/ even without
a configured stdlib_root (entry-closure native builds).
Source-scan spec (resolver imports are not reliably executable in unit specs;
same approach as allowed_families_spec). Fails before the fix: marker absent.
Native repro: test/fixtures/entry_closure_bare_common_import/main.spl
"""

use std.spec.*
use std.io_runtime.{file_read}



describe "module resolver bare tier import":
    it "has a bare-tier strategy mapping tier to source_root/lib/<tier>":
        val src = file_read("src/compiler/99.loader/module_resolver/resolution.spl") ?? ""
        expect(src.contains("Strategy bare-tier")).to_equal(true)
        expect(src.contains("TIER_PRECEDENCE.contains(segments[0])")).to_equal(true)
        expect(src.contains("path_join2(path_join2(self.source_root, \"lib\"), segments[0])")).to_equal(true)
