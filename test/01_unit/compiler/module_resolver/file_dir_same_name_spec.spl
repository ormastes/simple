# # File and Package With the Same Module Name
#
# **Category:** Module Resolution
# **Status:** Implemented (pure-Simple loaders); seed interpreter pending
#
# Rule (doc/04_architecture/language/modules.md § "File vs package with the
# same name"): `X.spl` next to `X/__init__.spl` is ambiguous and new pairs are
# rejected by scripts/check/check-module-file-dir-ambiguity.shs. Grandfathered
# pairs resolve FILE-FIRST for every import form, so the compiler and the
# interpreter load the same code. The fixture `fx.spl` / `fx/__init__.spl`
# export different values; every import form must see the file's.
#
# Before the fix the Rust seed interpreter redirected group/glob imports to
# `fx/__init__.spl` (module_loader.rs prefer_package_init_for_member_import),
# which is how gc_async_mut/cuda.spl and cuda/ drifted (PR #11023).

use std.spec.*
use fixtures.file_dir_ambig.fx.{FX_ORIGIN, fx_origin}
use fixtures.file_dir_ambig.fx as fx_mod

describe "file and package with the same module name":
    it "group import loads the file form":
        expect(FX_ORIGIN).to_equal("file")
        expect(fx_origin()).to_equal("file")

    it "module alias import loads the file form":
        expect(fx_mod.fx_origin()).to_equal("file")
