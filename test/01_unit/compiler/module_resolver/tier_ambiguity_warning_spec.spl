"""
Tier-less std import ambiguity warning (stage 1, non-fatal).

A tier-less `use std.<path>` whose <path> exists under 2+ of the 5 lib
tiers resolves by directory-listing order; the resolver now warns
(default-on, non-fatal, once per distinct path per resolver) naming the
candidate tiers. Resolution itself must be unchanged. See
doc/08_tracking/bug/tierless_std_import_ambiguity_resolves_by_registration_order_2026-07-29.md

The warning mechanism is exercised directly through
`maybe_warn_tier_ambiguity` and end to end through `ModuleResolver.resolve`
on a filesystem fixture.
"""

use std.spec.*
use compiler.loader.module_resolver.types.{ModuleResolver, ModulePath, moduleresolver_new}
# Loads the impl block that defines the tier-ambiguity warning methods.
use compiler.loader.module_resolver.resolution

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_env_set(key: text, value_str: text) -> bool

val FIXTURE = "/tmp/simple_tier_ambiguity_fixture"

fn setup_fixture():
    # Two same-named modules in two tier dirs (ambiguous), one unambiguous.
    val sh = "rm -rf {FIXTURE} && mkdir -p {FIXTURE}/src/lib/common/foo {FIXTURE}/src/lib/nogc_sync_mut/foo {FIXTURE}/src/lib/common/solo && printf 'fn amb_common() -> i64:\\n    1\\n' > {FIXTURE}/src/lib/common/foo/bar.spl && printf 'fn amb_sync() -> i64:\\n    2\\n' > {FIXTURE}/src/lib/nogc_sync_mut/foo/bar.spl && printf 'fn solo_fn() -> i64:\\n    3\\n' > {FIXTURE}/src/lib/common/solo/only.spl"
    rt_process_run("/bin/sh", ["-c", sh])

describe "tier-less std import ambiguity warning":
    it "warns once per distinct ambiguous path, across importing files":
        setup_fixture()
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "1")
        var resolver = moduleresolver_new(FIXTURE, "{FIXTURE}/src")
        val lib_dir = "{FIXTURE}/src/lib"
        resolver.maybe_warn_tier_ambiguity(lib_dir, ["foo", "bar"], "{FIXTURE}/src/main_a.spl")
        expect(resolver.tier_warn_count).to_equal(1)
        # Second occurrence (different importer) is deduplicated.
        resolver.maybe_warn_tier_ambiguity(lib_dir, ["foo", "bar"], "{FIXTURE}/src/main_b.spl")
        expect(resolver.tier_warn_count).to_equal(1)
        # The multiplicity map recorded exactly the two fixture tiers.
        expect(resolver.tier_multiplicity["foo.bar"].len()).to_equal(2)

    it "emits nothing for an unambiguous tier-less path":
        setup_fixture()
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "1")
        var resolver = moduleresolver_new(FIXTURE, "{FIXTURE}/src")
        resolver.maybe_warn_tier_ambiguity("{FIXTURE}/src/lib", ["solo", "only"], "{FIXTURE}/src/main_a.spl")
        expect(resolver.tier_warn_count).to_equal(0)

    it "SIMPLE_AMBIGUOUS_IMPORT_WARN=0 silences the warning":
        setup_fixture()
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "0")
        var resolver = moduleresolver_new(FIXTURE, "{FIXTURE}/src")
        resolver.maybe_warn_tier_ambiguity("{FIXTURE}/src/lib", ["foo", "bar"], "{FIXTURE}/src/main_a.spl")
        expect(resolver.tier_warn_count).to_equal(0)
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "1")

    it "verbose mode warns on every occurrence":
        setup_fixture()
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "verbose")
        var resolver = moduleresolver_new(FIXTURE, "{FIXTURE}/src")
        val lib_dir = "{FIXTURE}/src/lib"
        resolver.maybe_warn_tier_ambiguity(lib_dir, ["foo", "bar"], "{FIXTURE}/src/main_a.spl")
        resolver.maybe_warn_tier_ambiguity(lib_dir, ["foo", "bar"], "{FIXTURE}/src/main_b.spl")
        expect(resolver.tier_warn_count).to_equal(2)
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "1")

    it "resolve warns on an ambiguous tier-less import and still resolves it":
        # Behaviour through resolve(): the hook fires on the Ok path of the
        # lib/*/ tier search, is non-fatal, and the fixed tier order picks
        # common/ first. A cache hit does not warn again.
        setup_fixture()
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "1")
        var resolver = moduleresolver_new(FIXTURE, "{FIXTURE}/src")
        val path = ModulePath(segments: ["std", "foo", "bar"])
        match resolver.resolve(path, "{FIXTURE}/src/main_a.spl"):
            Ok(resolved):
                expect(resolved.path).to_end_with("lib/common/foo/bar.spl")
            Err(_): fail("ambiguous tier-less import did not resolve")
        expect(resolver.tier_warn_count).to_equal(1)
        match resolver.resolve(path, "{FIXTURE}/src/main_a.spl"):
            Ok(_): expect(resolver.tier_warn_count).to_equal(1)
            Err(_): fail("cached tier-less import did not resolve")

    it "resolve stays silent for an unambiguous tier-less import":
        setup_fixture()
        rt_env_set("SIMPLE_AMBIGUOUS_IMPORT_WARN", "1")
        var resolver = moduleresolver_new(FIXTURE, "{FIXTURE}/src")
        match resolver.resolve(ModulePath(segments: ["std", "solo", "only"]), "{FIXTURE}/src/main_a.spl"):
            Ok(resolved): expect(resolved.path).to_end_with("lib/common/solo/only.spl")
            Err(_): fail("unambiguous tier-less import did not resolve")
        expect(resolver.tier_warn_count).to_equal(0)
