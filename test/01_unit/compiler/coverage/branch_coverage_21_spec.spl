# @req: REQ-COMPILER-COVERAGE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/coverage/branch_coverage_21_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_21.md
# doc-path: doc/03_plan/sys_test/branch_coverage_21.md
# doc-path: doc/04_architecture/branch_coverage_21.md
# doc-path: doc/05_design/branch_coverage_21.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "match dispatches on the first equal pattern":
        step("Verify: match dispatches on the first equal pattern")
        # @req: REQ-COMPILER-COVERAGE-001
        val k = 2
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            3: r = 30
            _: r = -1
        expect(r).to_equal(20)  # oracle: literal pattern 2

    it "elif second arm wins when first guard fails":
        step("Verify: elif second arm wins when first guard fails")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 9:
            r = 2
        elif 7 > 5:
            r = 3
        expect(r).to_equal(3)  # oracle: later elif evaluated after earlier false

    it "nested conditionals evaluate inner guard independently":
        step("Verify: nested conditionals evaluate inner guard independently")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if true:
            if false:
                r = 1
            else:
                r = 2
        expect(r).to_equal(2)  # oracle: outer true, inner false

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

    it "while loop stops when guard turns false":
        step("Verify: while loop stops when guard turns false")
        # @req: REQ-COMPILER-COVERAGE-001
        var i = 0
        while i < 4:
            i = i + 1
        expect(i).to_equal(4)  # oracle: guard boundary

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken
