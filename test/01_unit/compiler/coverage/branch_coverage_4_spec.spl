# @req: REQ-COMPILER-COVERAGE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/coverage/branch_coverage_4_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_4.md
# doc-path: doc/03_plan/sys_test/branch_coverage_4.md
# doc-path: doc/04_architecture/branch_coverage_4.md
# doc-path: doc/05_design/branch_coverage_4.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-COMPILER-COVERAGE-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

    it "elif second arm wins when first guard fails":
        step("Verify: elif second arm wins when first guard fails")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 9:
            r = 2
        elif 7 > 5:
            r = 3
        expect(r).to_equal(3)  # oracle: later elif evaluated after earlier false

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "while loop with false guard never runs":
        step("Verify: while loop with false guard never runs")
        # @req: REQ-COMPILER-COVERAGE-001
        var i = 7
        while i < 0:
            i = i + 1
        expect(i).to_equal(7)  # oracle: body skipped

    it "break terminates the innermost loop":
        step("Verify: break terminates the innermost loop")
        # @req: REQ-COMPILER-COVERAGE-001
        var c = 0
        for i in 0..10:
            if i == 3: break
            c = c + 1
        expect(c).to_equal(3)  # oracle: iterations 0,1,2 counted

    it "else arm runs when all guards fail":
        step("Verify: else arm runs when all guards fail")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 1 > 2:
            r = 1
        elif 2 > 3:
            r = 2
        else:
            r = 9
        expect(r).to_equal(9)  # oracle: terminal else
