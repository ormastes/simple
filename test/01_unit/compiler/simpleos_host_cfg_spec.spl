# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


use std.spec.step

use std.spec.*
use compiler.core.cfg_platform.{cfg_normalize_os}
use compiler.types.platform_attr_parser.{PlatformAttrValue}


describe "SimpleOS host-OS cfg recognition":
    # @manual scenario evidence

    it "cfg_normalize_os normalizes 'simpleos' to 'simpleos'":
        # @req REQ-SSPEC-UNIT
        step("cfg_normalize_os normalizes 'simpleos' to 'simpleos'")
        expect(cfg_normalize_os("simpleos")).to_equal("simpleos")

    it "cfg_normalize_os normalizes 'SimpleOS' to 'simpleos'":
        # @req REQ-SSPEC-UNIT
        step("cfg_normalize_os normalizes 'SimpleOS' to 'simpleos'")
        expect(cfg_normalize_os("SimpleOS")).to_equal("simpleos")

    it "cfg_normalize_os regression: linux still normalizes to 'linux'":
        # @req REQ-SSPEC-UNIT
        step("cfg_normalize_os regression: linux still normalizes to 'linux'")
        expect(cfg_normalize_os("linux")).to_equal("linux")

    it "cfg_normalize_os regression: freebsd still normalizes to 'freebsd'":
        # @req REQ-SSPEC-UNIT
        step("cfg_normalize_os regression: freebsd still normalizes to 'freebsd'")
        expect(cfg_normalize_os("freebsd")).to_equal("freebsd")

    it "PlatformAttrValue.create marks os=simpleos as valid":
        # @req REQ-SSPEC-UNIT
        step("PlatformAttrValue.create marks os=simpleos as valid")
        val result = PlatformAttrValue.create("os", "simpleos")
        expect(result.is_valid).to_equal(true)
