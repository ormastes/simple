"""
# Exact-Key Lookup, Shadow Comparison and Explain Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
**Design:** doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14.2, §20.2

## Overview

The three safety properties of the integration layer:

1. EXACT-KEY ONLY — a key that differs in one field misses, with no fallback.
2. DEGRADE TO COMPUTE — every failure returns `must_compute`, never a result.
3. STRICT SHADOW — a divergence names the exact field and discards the cached
   result, so build output is unchanged even in warning mode.
"""

use std.spec.*
use compiler.driver.cache.cas_store.{ResultManifest, result_manifest_digest}
use compiler.driver.cache.tier_router.tier_router.{TierRoots, tier_roots_open}
use compiler.driver.cache.action_key.{
    ActionKey, ActionKeyV2, ResultKind, action_key_v2_from_v1, action_key_v2_digest
}
use compiler.driver.cache_integration.key_wiring.{ActionRoots, action_roots_collect}
use compiler.driver.cache_integration.cache_lookup.{
    CacheMode, CacheLookup, MissReason, ShadowConfig, ShadowVerdict,
    cache_lookup_exact, cache_publish, cache_mode_name,
    shadow_compare, shadow_strict, shadow_disabled, shadow_should_abort
}
use compiler.driver.cache_integration.cache_explain.{
    action_key_v2_first_difference, why_miss_render, explain_render
}
use compiler.mdsoc.aop_index.pointcut_query.{PointcutQuery}
use compiler.mdsoc.aop_index.join_point_descriptor.{JoinPointDescriptor}
use compiler.mir.incremental.block_key.{BlockKey, BlockKeyMap, BlockRole}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

fn fresh_roots() -> TierRoots:
    val base = "build/tmp/cache_integration_spec/{rt_getpid()}-{rt_time_now_unix_micros()}"
    val roots = TierRoots(
        workspace_index_root: "{base}/workspace/actions/workspace/ws1",
        workspace_cas_root: "{base}/workspace",
        machine_index_root: "{base}/machine/actions/machine/repo1/user1",
        machine_cas_root: "{base}/machine"
    )
    rt_dir_create_all(roots.workspace_index_root)
    rt_dir_create_all(roots.machine_index_root)
    tier_roots_open(roots)
    roots

fn v1_with(source_content: text) -> ActionKey:
    ActionKey(
        domain: "simple/interpreter-module/v1",
        compiler_exe: "exe-sha",
        live_compiler_src: "src-sha",
        schema_version: 2,
        target_triple: "x86_64-unknown-linux-gnu",
        host_arch: "x86_64",
        cfg_features: ["debug"],
        stdlib_variant: "default",
        runtime_family: "nogc_sync_mut",
        source_content: source_content,
        resolution_witness: "witness-sha",
        deps: [],
        macro_root: "macro-root",
        aop_selection: "aop-selection",
        ct_env_inputs: []
    )

fn key_with(source_content: text) -> ActionKeyV2:
    action_key_v2_from_v1(v1_with(source_content), "schema-digest", ResultKind.MirModule)

fn cacheable_roots() -> ActionRoots:
    val q: [PointcutQuery] = []
    val d: [JoinPointDescriptor] = []
    val m: [BlockKeyMap] = []
    action_roots_collect(q, d, m)

fn uncacheable_roots() -> ActionRoots:
    val q: [PointcutQuery] = []
    val d: [JoinPointDescriptor] = []
    val ambiguous = BlockKeyMap(
        block_ids: [0],
        keys: [BlockKey(parent_function: "app::run", origin_anchor: "b0", role: BlockRole.Entry, structural_path: "p", same_anchor_ordinal: 0)],
        ambiguous: true
    )
    action_roots_collect(q, d, [ambiguous])

fn manifest_for(key: ActionKeyV2, fingerprint: text) -> ResultManifest:
    ResultManifest(
        action_digest: action_key_v2_digest(key),
        result_kind: "mir_module",
        artifact_digests: ["artifact-1"],
        output_fingerprint: fingerprint,
        dependency_manifest: "dep-manifest",
        aop_group_roots: [],
        block_manifest_root: "",
        diagnostics_digest: "",
        producer_schema: 2
    )

describe "EXACT-KEY ONLY":
    it "misses a key that differs in exactly one field":
        # SABOTAGE TARGET: any prefix/nearest/restore-key fallback makes the
        # second lookup HIT. Asserting `tier == "miss"` AND the specific
        # ExactKeyAbsent reason pins it; a generic "not found" default cannot
        # satisfy the paired positive assertion above it.
        val roots = fresh_roots()
        val stored = key_with("source-A")
        val other = key_with("source-B")
        cache_publish(roots, stored, cacheable_roots(), CacheMode.Local, manifest_for(stored, "fp-A"))

        val hit = cache_lookup_exact(roots, stored, cacheable_roots(), CacheMode.Local, nil)
        expect(hit.hit).to_equal(true)
        expect(hit.must_compute).to_equal(false)

        val miss = cache_lookup_exact(roots, other, cacheable_roots(), CacheMode.Local, nil)
        expect(miss.hit).to_equal(false)
        expect(miss.tier).to_equal("miss")
        expect(miss.must_compute).to_equal(true)

describe "DEGRADE TO COMPUTE":
    it "refuses the cache entirely for an uncacheable action":
        # SABOTAGE TARGET: removing the roots.cacheable short-circuit lets an
        # action with ambiguous block identity read the cache. Asserting the
        # UNCACHEABLE reason specifically (not merely must_compute, which the
        # ordinary-miss path also sets) is what makes this test load-bearing.
        val roots = fresh_roots()
        val key = key_with("source-A")
        cache_publish(roots, key, cacheable_roots(), CacheMode.Local, manifest_for(key, "fp-A"))
        val out = cache_lookup_exact(roots, key, uncacheable_roots(), CacheMode.Local, nil)
        expect(out.hit).to_equal(false)
        expect(out.must_compute).to_equal(true)
        match out.miss_reason:
            case ActionUncacheable: expect(true).to_equal(true)
            case NoMiss: fail("uncacheable action was served from cache")
            case ExactKeyAbsent: fail("wrong reason: reported absent, not uncacheable")
            case CacheDisabled: fail("wrong reason: reported disabled, not uncacheable")
            case TierUnavailable: fail("wrong reason: reported unavailable, not uncacheable")

    it "never publishes an uncacheable action":
        val roots = fresh_roots()
        val key = key_with("source-C")
        expect(cache_publish(roots, key, uncacheable_roots(), CacheMode.Local, manifest_for(key, "fp-C"))).to_equal(false)
        # And the entry really is absent afterwards — not merely reported false.
        val after = cache_lookup_exact(roots, key, cacheable_roots(), CacheMode.Local, nil)
        expect(after.hit).to_equal(false)

    it "reports CacheDisabled, distinctly from an ordinary miss, when --cache=off":
        val roots = fresh_roots()
        val key = key_with("source-A")
        cache_publish(roots, key, cacheable_roots(), CacheMode.Local, manifest_for(key, "fp-A"))
        val out = cache_lookup_exact(roots, key, cacheable_roots(), CacheMode.Off, nil)
        expect(out.hit).to_equal(false)
        match out.miss_reason:
            case CacheDisabled: expect(true).to_equal(true)
            case NoMiss: fail("cache=off still served a cached result")
            case ExactKeyAbsent: fail("cache=off reported absent instead of disabled")
            case ActionUncacheable: fail("cache=off reported uncacheable")
            case TierUnavailable: fail("cache=off reported unavailable")

describe "STRICT SHADOW COMPARISON":
    it "does nothing when disabled":
        val key = key_with("source-A")
        val v = shadow_compare(shadow_disabled(), manifest_for(key, "fp-A"), manifest_for(key, "fp-B"))
        expect(v.compared).to_equal(false)
        expect(v.diverged).to_equal(false)

    it "names the exact diverging field and DISCARDS the cached result":
        # SABOTAGE TARGET: a comparator that only compares whole-manifest
        # digests would set diverged but leave `field` empty. Asserting the
        # field NAME "output_fingerprint" — a token no error/default path
        # emits — is what proves field-level comparison actually ran.
        val key = key_with("source-A")
        val v = shadow_compare(shadow_strict(), manifest_for(key, "fp-cached"), manifest_for(key, "fp-recomputed"))
        expect(v.compared).to_equal(true)
        expect(v.diverged).to_equal(true)
        expect(v.field).to_equal("output_fingerprint")
        expect(v.cached).to_equal("fp-cached")
        expect(v.recomputed).to_equal("fp-recomputed")
        # The safety property: the FROM-SCRATCH result is used, so build
        # output is unchanged even though a divergence was found.
        expect(v.use_cached).to_equal(false)
        expect(shadow_should_abort(shadow_strict(), v)).to_equal(true)

    it "reports identical manifests as identical":
        val key = key_with("source-A")
        val v = shadow_compare(shadow_strict(), manifest_for(key, "fp-A"), manifest_for(key, "fp-A"))
        expect(v.compared).to_equal(true)
        expect(v.diverged).to_equal(false)
        expect(v.field).to_equal("")
        expect(v.use_cached).to_equal(true)
        expect(shadow_should_abort(shadow_strict(), v)).to_equal(false)

describe "why-miss names the field that moved":
    it "reports source_content at frozen position 9":
        # SABOTAGE TARGET: scanning fields in the wrong order, or reporting the
        # digest instead of the field, breaks the exact field name + position.
        val d = action_key_v2_first_difference(key_with("source-A"), key_with("source-B"))
        expect(d.differs).to_equal(true)
        expect(d.field).to_equal("source_content")
        expect(d.position).to_equal(9)
        expect(d.mine).to_equal("source-A")
        expect(d.theirs).to_equal("source-B")

    it "reports NO differing field when the keys are identical":
        val d = action_key_v2_first_difference(key_with("source-A"), key_with("source-A"))
        expect(d.differs).to_equal(false)
        expect(d.position).to_equal(-1)

    it "renders the cause line naming the field":
        val out = why_miss_render("app::run", key_with("source-A"), key_with("source-B"))
        expect(out.contains("field `source_content`")).to_equal(true)
        expect(out.contains("frozen position 9")).to_equal(true)

describe "explain reports unbacked positions HONESTLY":
    it "marks positions 17 and 18 as having no producer":
        # SABOTAGE TARGET: rendering a sentinel as a plain digest would let a
        # reader believe position 18 carries a real weave root. The literal
        # "UNBACKED" marker is the assertion.
        val roots = fresh_roots()
        val key = key_with("source-A")
        val lookup = cache_lookup_exact(roots, key, cacheable_roots(), CacheMode.Local, nil)
        val out = explain_render("app::run", key, CacheMode.Local, lookup, shadow_compare(shadow_disabled(), manifest_for(key, "x"), manifest_for(key, "x")))
        expect(out).to_contain("[18] aop_weave_root")
        expect(out).to_contain("UNBACKED")

    it "reports the per-tier miss reason and the strict-comparison state":
        # A key no other example publishes. C1's L0 process cache is a
        # module-level dict keyed by ActionDigest ALONE — it is not scoped by
        # TierRoots, so a key published by any earlier example in this process
        # still hits here even with a fresh on-disk workspace. That is sound
        # for the cache (same ActionDigest => same result by construction) but
        # it means "fresh roots" is NOT a fresh cache.
        val roots = fresh_roots()
        val key = key_with("source-explain-miss-only")
        val lookup = cache_lookup_exact(roots, key, cacheable_roots(), CacheMode.Local, nil)
        val out = explain_render("app::run", key, CacheMode.Local, lookup, shadow_compare(shadow_disabled(), manifest_for(key, "x"), manifest_for(key, "x")))
        expect(out).to_contain("exact ActionDigest absent")
        expect(out).to_contain("strict comparison: not run")
