"""
# Action-Key Wiring Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
**Design:** doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14, §17.4

## Overview

Positions 16-19 of ActionKeyV2. Two are now backed by real producers (16 from
C4's pointcut selection digests, 19 from C5's BlockKeyMap) and two remain on
the unbacked sentinel (17 candidate partitions, 18 weave root) because no
producer exists.

Every negative assertion here asserts a SPECIFIC consequence — a digest that
must MOVE, or a value that must EQUAL the sentinel — never a token that a
default or error path also produces.
"""

use std.spec.*
use compiler.driver.cache.action_key.{
    ActionKey, ActionKeyV2, ResultKind, action_key_v2_digest,
    action_key_v2_from_v1, action_key_v2_sentinel_root_digest
}
use compiler.driver.cache_integration.key_wiring.{
    ActionRoots, BlockManifestRoot, BlockManifestRootSet,
    aop_surface_root_of, block_manifest_root_of, block_manifest_roots_of,
    action_roots_collect, action_key_v2_wired, action_key_v2_field_is_sentinel,
    cache_root_of_digest_set
}
use compiler.mdsoc.aop_index.pointcut_parser.{pointcut_parse}
use compiler.mdsoc.aop_index.pointcut_query.{PointcutQuery}
use compiler.mdsoc.aop_index.join_point_descriptor.{JoinPointDescriptor}
use compiler.mir.incremental.block_key.{BlockKey, BlockKeyMap, BlockRole}

fn sample_v1() -> ActionKey:
    ActionKey(
        domain: "simple/interpreter-module/v1",
        compiler_exe: "exe-sha",
        live_compiler_src: "src-sha",
        schema_version: 2,
        target_triple: "x86_64-unknown-linux-gnu",
        host_arch: "x86_64",
        cfg_features: ["debug"],
        stdlib_variant: "default",
        runtime_family: "nogc_sync_mut",
        source_content: "source-sha",
        resolution_witness: "witness-sha",
        deps: [],
        macro_root: "macro-root",
        aop_selection: "aop-selection",
        ct_env_inputs: []
    )

fn descriptor(name: text) -> JoinPointDescriptor:
    JoinPointDescriptor(
        kind_name: "Execution",
        kind_operands: [],
        qualified_name: name,
        owning_scope: "app",
        signature: "() -> unit",
        attributes: [],
        effects: [],
        same_site_ordinal: 0
    )

fn block_key(anchor: text) -> BlockKey:
    BlockKey(
        parent_function: "app::run",
        origin_anchor: anchor,
        role: BlockRole.Entry,
        structural_path: "path-" + anchor,
        same_anchor_ordinal: 0
    )

fn block_map(anchor: text, ambiguous: bool) -> BlockKeyMap:
    BlockKeyMap(
        block_ids: [0],
        keys: [block_key(anchor)],
        ambiguous: ambiguous
    )

describe "position 16 aop_surface_root is BACKED by C4":
    it "moves when the join-point surface changes":
        # SABOTAGE TARGET: if this position were left on the sentinel (or given
        # any constant), these two roots would be EQUAL. Asserting inequality
        # of two real digests cannot be satisfied by a constant fallback.
        val queries = [pointcut_parse("execution(app.*)")]
        val a = aop_surface_root_of(queries, [descriptor("app::alpha")])
        val b = aop_surface_root_of(queries, [descriptor("app::beta")])
        expect(a).to_not_equal(b)
        expect(action_key_v2_field_is_sentinel(a)).to_equal(false)
        expect(action_key_v2_field_is_sentinel(b)).to_equal(false)

    it "moves when the pointcut query changes":
        val descs = [descriptor("app::alpha")]
        val a = aop_surface_root_of([pointcut_parse("execution(app.*)")], descs)
        val b = aop_surface_root_of([pointcut_parse("execution(other.*)")], descs)
        expect(a).to_not_equal(b)

    it "is the sentinel when the action sees no AOP surface at all":
        val empty_q: [PointcutQuery] = []
        val empty_d: [JoinPointDescriptor] = []
        expect(aop_surface_root_of(empty_q, empty_d)).to_equal(action_key_v2_sentinel_root_digest())

describe "positions 17 and 18 stay on the UNBACKED sentinel":
    it "never fabricates a candidate-partition root or a weave root":
        # SABOTAGE TARGET: wiring either position to some available-but-wrong
        # digest breaks these two assertions specifically. Note this asserts
        # EQUALITY TO THE SENTINEL, not merely "non-empty" — an error path
        # returning "" would fail this, and so would a fabricated digest.
        val roots = action_roots_collect(
            [pointcut_parse("execution(app.*)")],
            [descriptor("app::alpha")],
            [block_map("b0", false)]
        )
        expect(roots.aop_candidate_partition_roots.is_empty()).to_equal(true)
        expect(roots.aop_weave_root).to_equal(action_key_v2_sentinel_root_digest())
        # ...while the two BACKED positions are simultaneously NOT sentinels,
        # so this test cannot pass by everything being sentinel.
        expect(action_key_v2_field_is_sentinel(roots.aop_surface_root)).to_equal(false)
        expect(roots.block_manifest_roots.is_empty()).to_equal(false)

describe "position 19 block_manifest_roots is BACKED by C5":
    it "moves when block identity changes":
        val a = block_manifest_root_of(block_map("b0", false))
        val b = block_manifest_root_of(block_map("b1", false))
        expect(a.cacheable).to_equal(true)
        expect(b.cacheable).to_equal(true)
        expect(a.root).to_not_equal(b.root)

    it "FAILS CLOSED on an ambiguous BlockKeyMap":
        # SABOTAGE TARGET: dropping the `ambiguous` guard makes this return a
        # cacheable root. Asserting cacheable == false AND root == "" pins the
        # refusal, and the sibling assertion below proves the same fixture is
        # cacheable when NOT ambiguous — so a blanket "always uncacheable" bug
        # cannot make this suite green.
        val amb = block_manifest_root_of(block_map("b0", true))
        expect(amb.cacheable).to_equal(false)
        expect(amb.root).to_equal("")
        val ok = block_manifest_root_of(block_map("b0", false))
        expect(ok.cacheable).to_equal(true)

    it "poisons the whole set when any consumed map is ambiguous":
        val poisoned = block_manifest_roots_of([block_map("b0", false), block_map("b1", true)])
        expect(poisoned.cacheable).to_equal(false)
        expect(poisoned.roots.is_empty()).to_equal(true)
        val clean = block_manifest_roots_of([block_map("b0", false), block_map("b1", false)])
        expect(clean.cacheable).to_equal(true)
        expect(clean.roots.len()).to_equal(2)

describe "the wired key differs from the all-sentinel key":
    it "produces a DIFFERENT digest than action_key_v2_from_v1":
        # This is the whole point of the wiring: an action with a real AOP
        # surface and real block manifests must not share a key with one that
        # has neither.
        val v1 = sample_v1()
        val roots = action_roots_collect(
            [pointcut_parse("execution(app.*)")],
            [descriptor("app::alpha")],
            [block_map("b0", false)]
        )
        val wired = action_key_v2_wired(v1, "schema-digest", ResultKind.MirModule, roots)
        val sentinel_only = action_key_v2_from_v1(v1, "schema-digest", ResultKind.MirModule)
        expect(action_key_v2_digest(wired)).to_not_equal(action_key_v2_digest(sentinel_only))

    it "is stable: identical inputs give an identical digest":
        val v1 = sample_v1()
        val q = [pointcut_parse("execution(app.*)")]
        val d = [descriptor("app::alpha")]
        val m = [block_map("b0", false)]
        val k1 = action_key_v2_wired(v1, "schema-digest", ResultKind.MirModule, action_roots_collect(q, d, m))
        val k2 = action_key_v2_wired(v1, "schema-digest", ResultKind.MirModule, action_roots_collect(q, d, m))
        expect(action_key_v2_digest(k1)).to_equal(action_key_v2_digest(k2))

describe "root domain separation":
    it "gives different roots to the same digest set under different domains":
        # SABOTAGE TARGET: dropping the domain from cache_root_of_digest_set
        # makes an AOP root and a block root collide whenever their digest sets
        # coincide — a cross-kind false hit.
        val set = ["d1", "d2"]
        expect(cache_root_of_digest_set("simple/aop-surface-root/v2", set))
            .to_not_equal(cache_root_of_digest_set("simple/block-manifest-root/v2", set))

    it "is order-independent within a set":
        expect(cache_root_of_digest_set("dom", ["a", "b"]))
            .to_equal(cache_root_of_digest_set("dom", ["b", "a"]))
