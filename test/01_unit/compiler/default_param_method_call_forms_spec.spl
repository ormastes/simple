use std.spec.step

fn free_i64(value: i64 = 41) -> i64: value
fn free_i32(value: i32 = 17) -> i32: value
fn free_bool(value: bool = true) -> bool: value
fn free_text(value: text = "default") -> text: value

class DefaultParamCallForms:
    fn instance_i64(self, value: i64 = 41) -> i64: value
    fn instance_i32(self, value: i32 = 17) -> i32: value
    static fn static_i64(value: i64 = 41) -> i64: value
    static fn static_bool(value: bool = true) -> bool: value
    static fn static_text(value: text = "default") -> text: value

describe "default parameters across free and method calls":
    it "uses i64 defaults and preserves explicit values":
        step("free instance and static i64 calls retain their declared value")
        val probe = DefaultParamCallForms()
        expect free_i64() == 41
        expect free_i64(73) == 73
        expect probe.instance_i64() == 41
        expect probe.instance_i64(73) == 73
        expect DefaultParamCallForms.static_i64() == 41
        expect DefaultParamCallForms.static_i64(73) == 73

    it "keeps adjacent primitive and text defaults scoped to their owner":
        step("i32 bool and text controls do not take another method default")
        val probe = DefaultParamCallForms()
        expect free_i32() == 17
        expect probe.instance_i32() == 17
        expect free_bool() == true
        expect DefaultParamCallForms.static_bool() == true
        expect free_text() == "default"
        expect DefaultParamCallForms.static_text() == "default"
