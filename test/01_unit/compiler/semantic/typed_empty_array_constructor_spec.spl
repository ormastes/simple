# Regression spec for: typed empty-array constructor rejected
# doc/08_tracking/bug/typed_empty_array_constructor_rejected_2026-08-10.md
#
# `val allowed: [i64] = [i64]()` failed at execution time with
# "semantic: variable `i64` not found" because the array-literal callee's
# element TYPE name was resolved as a variable. The typed empty-array
# constructor must yield an empty array.

use std.spec.*

describe "typed empty array constructor [i64]()":
    it "constructs an empty i64 array":
        val allowed: [i64] = [i64]()
        expect(allowed.len()).to_equal(0)

    it "constructed array accepts pushes":
        var xs: [i64] = [i64]()
        xs.push(41)
        xs.push(1)
        expect(xs.len()).to_equal(2)
        expect(xs[0] + xs[1]).to_equal(42)

    it "matches the [] spelling":
        val a: [i64] = [i64]()
        val b: [i64] = []
        expect(a.len()).to_equal(b.len())
