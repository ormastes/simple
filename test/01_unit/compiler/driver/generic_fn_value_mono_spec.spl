# @req REQ-SSPEC-COMPILER
# @tag:in-development
"""
# Generic fn passed as a value (bug mono_generic_fn_value_arg_2026-10-27)

`keep<T>(v)` passes the uninstantiated generic `share_it<T>` as a `fn(T) -> bool`
value to `keep_with<T>`. A value use records no call site, so no generic-spec row
exists for `share_it`; mono must still bind T from the enclosing substitution.
Expected RED until the real fix in the bug record lands (module-scoped mono shares
the same inference as the global pass, so PR2 does not change this).
"""

# @tag:unit
# @tag:compiler
# @tag:mono
# @tag:generics
# @tag:in-development

use std.spec
use compiler.common.config.Logger
use compiler.common.driver_core_types.SourceFile
use compiler.frontend.parser_types.{Module}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.hirlowering_for_module
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule}
use compiler.mono.monomorphize_integration.{run_monomorphization_with_diagnostics}

val fn_value_src = "fn share_it<T>(v: T) -> bool:\n" +
    "    true\n" +
    "\n" +
    "fn keep_with<T>(v: T, share: fn(T) -> bool) -> bool:\n" +
    "    share(v)\n" +
    "\n" +
    "fn keep<T>(v: T) -> bool:\n" +
    "    keep_with(v, share_it)\n" +
    "\n" +
    "fn main() -> i64:\n" +
    "    if keep(3): 1 else: 0\n"

fn lower_fn_value() -> Dict<text, HirModule>:
    val log = Logger(level: 0)
    val name = "gen_main"
    val parsed_module = parse_full_frontend(fn_value_src, name + ".spl", name, log)
    var parsed: Dict<text, Module> = {}
    parsed[name] = parsed_module
    val surfaces = module_surfaces_from_modules(parsed, [
        SourceFile(path: name + ".spl", content: fn_value_src, module_name: name)])
    var hl = hirlowering_for_module(name, surfaces.unwrap())
    var hir: Dict<text, HirModule> = {}
    hir[name] = hl.lower_module(parsed_module)
    hir

describe "generic fn passed as a value":
    it "monomorphizes without E-MONO-032 / unresolved sites":
        val (_mono, stats, diags) = run_monomorphization_with_diagnostics(lower_fn_value())
        for d in diags:
            print "diag: {d}"
        expect(diags.len()).to_equal(0)
        expect(stats.unresolved_generic_calls).to_equal(0)
