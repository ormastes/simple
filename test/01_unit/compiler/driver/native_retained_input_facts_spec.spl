# @req REQ-IM-005 REQ-IM-008 REQ-IM-016
# Contract coverage subordinate to object_reuse_driver_spec actual execution.
use std.spec.*
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types.{ParserImport}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry_index.{module_surface_import_resolution_trace_v1}
use compiler.driver.cache.native_source_interface_index.{native_source_interface_index_from_sources_v1}
use compiler.driver.cache.native_module_input_fact_snapshots.{native_module_input_fact_snapshots_v1}
use compiler.driver.cache.native_module_witness.{NativeModuleConfigFactV1, native_module_cache_witness_v1}

fn object_reuse_surfaces() -> ModuleSurfacesByName:
    var consumer = ModuleSurface.empty("app.main")
    consumer.preferred_registry_name = "app.main"
    consumer.canonical_path = "src/app/main.spl"
    consumer.imports = [ParserImport(module: "lib.dep", items: [],
        is_lazy: false, span: Span.empty())]
    consumer.import_target_indices = [1]
    consumer.import_target_names = ["lib.dep"]
    var dependency = ModuleSurface.empty("lib.dep")
    dependency.preferred_registry_name = "lib.dep"
    dependency.canonical_path = "src/lib/dep.spl"
    var registry = ModuleSurfacesByName(surfaces: [consumer, dependency],
        index_by_name: {"app.main": 0, "lib.dep": 1},
        ordered_names: ["app.main", "lib.dep"], ordered_indices: [0, 1],
        generation: 1, frozen: true)
    consumer.import_resolution_traces = [
        module_surface_import_resolution_trace_v1(registry, consumer, "lib.dep")]
    registry.surfaces[0] = consumer
    registry

fn object_reuse_config() -> NativeModuleConfigFactV1:
    NativeModuleConfigFactV1(compiler_identity: "qualified-compiler",
        target_identity: "qualified-target", options_identity: "opt=0",
        provider_identity: "qualified-provider", emitter_scheme: "pure-simple-dotted-v1")

describe "native compact retained input facts":
    it "keeps routed public facets and negative queries after source and surface owner replacement":
        step("capture from actual source index and completed resolution traces")
        var sources = [SourceFile(path: "src/lib/dep.spl",
            content: "pub fn value() -> i64:\n    21\n", module_name: "lib.dep")]
        var surfaces = object_reuse_surfaces()
        val index = native_source_interface_index_from_sources_v1(sources)
        val snapshots = native_module_input_fact_snapshots_v1(surfaces, index)
        val captured = snapshots["app.main"]
        expect(captured.valid).to_equal(true)
        expect(captured.dependencies.len()).to_equal(1)
        expect(captured.resolutions.len()).to_equal(1)
        val before = native_module_cache_witness_v1("app.main", "current-mir",
            captured.dependencies, captured.resolutions, [], object_reuse_config())
        expect(before.valid).to_equal(true)
        step("replace original owners without consulting source bodies again")
        sources = []
        surfaces = ModuleSurfacesByName.empty()
        val retained = snapshots["app.main"]
        val after = native_module_cache_witness_v1("app.main", "current-mir",
            retained.dependencies, retained.resolutions, [], object_reuse_config())
        expect(after.digest()).to_equal(before.digest())
        expect(index.facts["src/lib/dep.spl"].source_digest.len()).to_equal(64)
        expect(retained.resolutions[0].probes.len()).to_be_greater_than(0)

    it "retains an exact missing-source refusal instead of inventing a reusable witness":
        val surfaces = object_reuse_surfaces()
        val empty_index = native_source_interface_index_from_sources_v1([])
        val snapshots = native_module_input_fact_snapshots_v1(surfaces, empty_index)
        val refused = snapshots["app.main"]
        expect(refused.valid).to_equal(false)
        expect(refused.reason).to_equal("missing-dependency-source")
        expect(refused.dependencies.len()).to_equal(0)

    it "refuses an unfinished surface generation before capturing publication facts":
        var surfaces = object_reuse_surfaces()
        surfaces.frozen = false
        val index = native_source_interface_index_from_sources_v1([
            SourceFile(path: "src/lib/dep.spl", content: "pub fn value() -> i64:\n    21\n", module_name: "lib.dep")])
        val snapshots = native_module_input_fact_snapshots_v1(surfaces, index)
        expect(snapshots["app.main"].valid).to_equal(false)
        expect(snapshots["app.main"].reason).to_equal("unfrozen-native-input-surfaces")
