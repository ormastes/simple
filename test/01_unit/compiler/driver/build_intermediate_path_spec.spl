use std.spec.{describe, it, expect}
use app.io._CliCompile.build_intermediate_policy.{native_build_output_parent_for_platform, native_build_output_name_for_platform, native_build_intermediate_name}
use app.io._CliCompile.build_intermediate_policy.{native_build_join_output_parent}

describe "native output staging path ownership":
    it "keeps Windows drive paths beside their requested output":
        for path in ["C:\\work dir\\hello.exe", "C:/work dir/hello.exe", "C:\\work dir/hello.exe"]:
            expect(native_build_output_parent_for_platform(path, true)).to_equal("C:/work dir")
            val name = native_build_output_name_for_platform(path, true)
            expect(name).to_equal("hello.exe")
            expect(native_build_intermediate_name(name, 42, 7)).to_equal("hello.exe.simple-native-build-42-7.tmp")

    it "preserves root and UNC parents":
        expect(native_build_output_parent_for_platform("C:\\hello.exe", true)).to_equal("C:/")
        expect(native_build_output_parent_for_platform("/hello", false)).to_equal("/")
        expect(native_build_output_parent_for_platform("\\\\server\\share\\hello.exe", true)).to_equal("//server/share")
        expect(native_build_output_name_for_platform("\\\\server\\share\\hello.exe", true)).to_equal("hello.exe")
        expect(native_build_join_output_parent("C:/", "hello.tmp")).to_equal("C:/hello.tmp")
        expect(native_build_join_output_parent("/", "hello.tmp")).to_equal("/hello.tmp")
        expect(native_build_join_output_parent("//server/share", "hello.tmp")).to_equal("//server/share/hello.tmp")

    it "preserves literal backslashes in Unix filenames":
        expect(native_build_output_parent_for_platform("name\\part", false)).to_equal(".")
        expect(native_build_output_name_for_platform("name\\part", false)).to_equal("name\\part")
        expect(native_build_output_parent_for_platform("out/hello", false)).to_equal("out")
        expect(native_build_output_name_for_platform("hello", false)).to_equal("hello")
