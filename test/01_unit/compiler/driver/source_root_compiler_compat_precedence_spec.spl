use std.spec.*
use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use compiler.driver.driver_source_loading.{_driver_resolve_source_root_entry_import_v1}

fn selected_path(result: SourceRootResolutionV1) -> text:
    match result:
        case SourceRootResolutionV1.Found(path): path
        case SourceRootResolutionV1.Missing: "MISSING"
        case SourceRootResolutionV1.Ambiguous(_): "AMBIGUOUS"

val FIXTURE = "test/fixtures/compiler/compiler_compat_owner"

describe "declared compiler compatibility module ownership":
    it "selects the real nested MIR optimizer module before the parent facade":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.mir_opt.mod", ["src/compiler"]))).to_equal(
            "src/compiler/60.mir_opt/mir_opt/mod.spl")

    it "selects the real nested backend types before the backend facade":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.backend.codegen_types", ["src/compiler"]))).to_equal(
            "src/compiler/70.backend/backend/codegen_types.spl")

    it "supports a declared parent source root without checkout fallback":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.backend.codegen_types", ["src"]))).to_equal(
            "src/compiler/70.backend/backend/codegen_types.spl")

    it "keeps all exact custom roots ahead of canonical compatibility":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.mir_opt.mod", ["src/compiler", FIXTURE + "/overlay"]))).to_equal(
            FIXTURE + "/overlay/compiler/mir_opt/mod.spl")

    it "resolves terminal item imports through the full compatibility owner":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.backend.codegen_types.CodegenOutputKind", ["src/compiler"]))).to_equal(
            "src/compiler/70.backend/backend/codegen_types.spl")

    it "propagates checked ambiguity before a parent facade or later root":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.backend.codegen_types", [FIXTURE + "/ambiguous/compiler", "src/compiler"]))).to_equal(
            "AMBIGUOUS")

    it "does not consult the checkout when declared authority has no owner":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "compiler.backend.codegen_types", [FIXTURE + "/missing/compiler"]))).to_equal("MISSING")
