use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use compiler.driver.driver_build.incremental.{
    native_module_cache_shadow_mismatch_v1
}

describe "native module witness shadow wiring":
    it "classifies exact legacy and mismatched recorded witnesses":
        val first = "native-module-cache-witness-v1|first"
        val second = "native-module-cache-witness-v1|second"
        expect(native_module_cache_shadow_mismatch_v1(first, first)).to_equal("match")
        expect(native_module_cache_shadow_mismatch_v1(first, second)).to_equal("witness-mismatch")
        expect(native_module_cache_shadow_mismatch_v1("", first)).to_equal("legacy-missing")
        expect(native_module_cache_shadow_mismatch_v1(
            "native-module-cache-witness-corrupt-v1", first)).to_equal(
                "corrupt-recorded")

    it "keeps complete module witness authority while bounding mismatch evidence":
        val source = file_read(
            "src/compiler/80.driver/driver_aot_native_output.spl")
        expect(source).to_contain(
            "decision-authority=per-module-complete-witness")
        expect(source).to_contain(
            "closure-comparison-only=" + "{" + "sources_fingerprint}")
        expect(source).to_contain(
            "NATIVE_MODULE_CACHE_SHADOW_MISMATCH_LIMIT: i64 = 64")
        expect(source).to_contain(
            "native-module-witness-shadow-v1.receipt")
        expect(source).to_contain(
            "build_cache_module_witness")
        expect(source).to_contain(
            "[], [obj_path], capsule.module_witness")
        expect(source).to_contain("native_capsule_mir_identity_v1(module)")
        expect(source).to_contain(
            "native_direct_dependency_facts_v1")
        expect(source).to_contain("native_resolution_facts_v1")
        expect(source).to_contain("native_external_layout_facts_from_mir_v1")
        expect(source).to_contain("source-mutated-since-parse")
        expect(source).to_contain("native-capsule-source-mutated")
        expect(source).to_contain("phase=prelookup-attempt")
        expect(source).to_contain("non_authoritative=false")
        expect(source.contains(
            "native-build failed to write module witness shadow receipt")).to_equal(false)
        expect(source).to_contain("val provider_threads = if backend_session.?")
        expect(source.contains("native-module-source-mir-proxy-v1")).to_equal(false)

        val types_source = file_read(
            "src/compiler/80.driver/driver_types.spl")
        expect(types_source).to_contain("source_identity: text")
        expect(types_source).to_contain("sha256_text(source.content)")
        expect(types_source).to_contain(
            "storage_identity_text_v1(self.source_identity)")

    it "persists legacy-missing witnesses without treating them as authority":
        val source = file_read(
            "src/compiler/80.driver/driver_build/incremental.spl")
        expect(source).to_contain("module_witness: text")
        expect(source).to_contain("var module_witness = \"\"")
        expect(source).to_contain(
            "native_module_cache_shadow_mismatch_v1")
        expect(source).to_contain(
            "Versioned per-module semantic witness")
        expect(source).to_contain("effective_module_witness")
        expect(source).to_contain(
            "NATIVE_MODULE_CACHE_WITNESS_CORRUPT_V1")
