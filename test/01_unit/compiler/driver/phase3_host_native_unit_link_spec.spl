fn _compile_c_obj(cc: text, src_path: text, obj_path: text, code: text) -> bool:
    if not file_write(src_path, code):
        return false
    val (_out, _err, rc) = process_run(cc, ["-c", "-fPIC", "-O1", src_path, "-o", obj_path])
    rc == 0 and file_exists(obj_path)

describe "Phase 3 host-native tag resolution and Stage 3 match policy":
    it "normalizes (platform, cpu) tags and enforces native_host_match and SIMPLE_STAGE3_HOST_TAG":
        val mac_arm = library_unit_resolve_host_tag_v1("", "macos", "arm64")
        expect(mac_arm.platform).to_equal("darwin")
        expect(mac_arm.cpu).to_equal("aarch64")
        expect(mac_arm.tag).to_equal("darwin-aarch64")
        expect(mac_arm.native_host_match).to_equal(true)

        val mac_triple = library_unit_resolve_host_tag_v1("aarch64-apple-darwin", "macos", "arm64")
        expect(mac_triple.tag).to_equal("darwin-aarch64")
        expect(mac_triple.native_host_match).to_equal(true)

        val cross_cpu = library_unit_resolve_host_tag_v1("x86_64-apple-darwin", "macos", "arm64")
        expect(cross_cpu.platform).to_equal("darwin")
        expect(cross_cpu.cpu).to_equal("x86_64")
        expect(cross_cpu.tag).to_equal("darwin-x86_64")
        expect(cross_cpu.native_host_match).to_equal(false)

        val cross_os = library_unit_resolve_host_tag_v1("aarch64-unknown-linux-gnu", "macos", "arm64")
        expect(cross_os.platform).to_equal("linux")
        expect(cross_os.cpu).to_equal("aarch64")
        expect(cross_os.tag).to_equal("linux-aarch64")
        expect(cross_os.native_host_match).to_equal(false)

        val old_tag = env_get("SIMPLE_STAGE3_HOST_TAG") ?? ""
        env_set("SIMPLE_STAGE3_HOST_TAG", "")
        expect(library_unit_stage3_host_match_error_v1(
            "1", "1", "aarch64-apple-darwin", "macos", "arm64")).to_equal("")
        expect(library_unit_stage3_host_match_error_v1(
            "1", "1", "x86_64-apple-darwin", "macos", "arm64")).to_contain(
            "STAGE3-E-NATIVE-HOST-MISMATCH")
        expect(library_unit_stage3_host_match_error_v1(
            "1", "1", "x86_64-unknown-linux-gnu", "macos", "arm64")).to_contain(
            "STAGE3-E-NATIVE-HOST-MISMATCH")
        expect(library_unit_stage3_host_match_error_v1(
            "1", "0", "x86_64-unknown-linux-gnu", "macos", "arm64")).to_equal("")
        expect(library_unit_stage3_host_match_error_v1(
            "", "1", "x86_64-unknown-linux-gnu", "macos", "arm64")).to_equal("")

        env_set("SIMPLE_STAGE3_HOST_TAG", "darwin-aarch64")
        expect(library_unit_stage3_host_match_error_v1(
            "1", "1", "macos", "macos", "arm64")).to_equal("")
        env_set("SIMPLE_STAGE3_HOST_TAG", "linux-x86_64")
        expect(library_unit_stage3_host_match_error_v1(
            "1", "1", "macos", "macos", "arm64")).to_contain(
            "STAGE3-E-NATIVE-HOST-TAG-MISMATCH")
        env_set("SIMPLE_STAGE3_HOST_TAG", old_tag)

    it "selects DynLibUnits for Stage 3 and Stage 4 --mode dynload while keeping Stage 4 --mode one-binary on FlatObjects":
        val s4_dyn = library_unit_select_build_mode_v1(LibraryUnitModeInputsV1(
            args: ["--entry", "src/app/cli/main.spl", "--mode", "dynload"],
            build_mode: "dynload", stage3_env: "", stage4_env: "1",
            stage3_dynlib_env: "", library_units_env: "", whole_program_env: "",
            explicit_emit_mode: "", target_or_os: "macos"))
        expect(s4_dyn.to_text()).to_equal("dyn-lib-units")
        val s4_bind = library_unit_env_bindings_for_inputs_v1(LibraryUnitModeInputsV1(
            args: ["--entry", "src/app/cli/main.spl", "--mode", "dynload"],
            build_mode: "dynload", stage3_env: "", stage4_env: "1",
            stage3_dynlib_env: "", library_units_env: "", whole_program_env: "",
            explicit_emit_mode: "", target_or_os: "macos"))
        expect(s4_bind.library_units_env).to_equal("1")
        expect(s4_bind.stage3_dynlib_env).to_equal("1")
        val s4_one = library_unit_select_build_mode_v1(LibraryUnitModeInputsV1(
            args: ["--entry", "src/app/cli/main.spl", "--mode", "one-binary"],
            build_mode: "one-binary", stage3_env: "", stage4_env: "1",
            stage3_dynlib_env: "1", library_units_env: "1", whole_program_env: "",
            explicit_emit_mode: "", target_or_os: "macos"))
        expect(s4_one.to_text()).to_equal("flat-objects")

describe "Phase 3 primitive static-archive classification and plugin filtering":
    it "classifies only primitive Simple and host-matched platform shims as primitive static":
        for prim_path in [
            "src/lib/bitwise_utils.spl",
            "src/lib/common.spl",
            "src/lib/io_runtime.spl",
            "src/lib/math.spl",
            "src/lib/string_core.spl",
            "src/lib/text.spl",
            "src/lib/core/option.spl",
            "src/lib/pure/collections.spl",
            "src/lib/nogc_async_mut_noalloc/ring.spl",
            "src/lib/math/vec.spl",
            "src/runtime/simple_core/alloc.spl",
            "src/lib/nogc_sync_mut/platform/darwin/shim.spl",
            "src/lib/nogc_sync_mut/platform/macos/aarch64/shim.spl",
            "src/lib/nogc_sync_mut/platform/aarch64/cpu_shim.spl"
        ]:
            expect(library_unit_source_is_primitive_static_for_host_v1(
                prim_path, "darwin", "aarch64")).to_equal(true)

        for non_prim_path in [
            "src/lib/nogc_sync_mut/http/client.spl",
            "src/lib/nogc_sync_mut/io/file_ops.spl",
            "src/lib/nogc_sync_mut/platform/linker.spl",
            "src/lib/nogc_sync_mut/platform/macos/x86_64/shim.spl",
            "src/lib/nogc_sync_mut/platform/linux/aarch64/shim.spl",
            "src/lib/nogc_sync_mut/platform/x86_64/cpu_shim.spl",
            "src/compiler/00.common/types.spl",
            "src/app/cli/bootstrap_main.spl"
        ]:
            expect(library_unit_source_is_primitive_static_for_host_v1(
                non_prim_path, "darwin", "aarch64")).to_equal(false)

        expect(library_unit_source_is_primitive_static_v1("src/lib/io_runtime.spl")).to_equal(true)
        expect(library_unit_source_is_unneeded_stage3_dynlib_v1(
            "src/plugins/backend_vhdl/mod.spl", "darwin", "aarch64")).to_equal(true)
        expect(library_unit_source_is_unneeded_stage3_dynlib_v1(
            "src/lib/nogc_sync_mut/platform/linux/aarch64/shim.spl", "darwin", "aarch64")).to_equal(true)
        expect(library_unit_source_is_unneeded_stage3_dynlib_v1(
            "src/compositions/backends_host_only/plugins/backend_registry/full_static_backend_registry.spl",
            "darwin", "aarch64")).to_equal(false)

describe "Existing --backend-plugin dynamic routing and minimal Stage 3 linker support flags":
    it "routes non-CUDA backends to versioned plugin session when --backend-plugin is supplied":
        expect(driver_aot_uses_versioned_backend("vhdl")).to_equal(false)
        expect(driver_aot_uses_versioned_backend("vulkan")).to_equal(false)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1("vhdl", "")).to_equal(false)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1("vhdl", "   ")).to_equal(false)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1(
            "vhdl", "/tmp/libsimple_backend_vhdl.dylib")).to_equal(true)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1(
            "vulkan", "/tmp/libsimple_backend_vulkan.dylib")).to_equal(true)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1(
            "c", "/tmp/libsimple_backend_c.so")).to_equal(true)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1(
            "cuda", "/tmp/libsimple_backend_cuda.so")).to_equal(false)
        expect(driver_aot_uses_versioned_backend_with_plugin_v1(
            "ptx", "/tmp/libsimple_backend_ptx.so")).to_equal(false)

    it "omits Vulkan forced retention and GUI/GPU macOS frameworks when stage3_host_only is true":
        val inputs = ["/runtime/libsimple_native_all.a"]
        val full_mac = native_all_gnu_support_args_for_stage_v1(inputs, "macos", "/opt/homebrew", false)
        expect(full_mac).to_equal(native_all_gnu_support_args(inputs, "macos", "/opt/homebrew"))
        expect(full_mac.contains("_rt_vulkan_provider_is_available")).to_equal(true)
        expect(full_mac.contains("AppKit")).to_equal(true)
        expect(full_mac.contains("Metal")).to_equal(true)
        expect(full_mac.contains("CoreGraphics")).to_equal(true)

        val min_mac = native_all_gnu_support_args_for_stage_v1(inputs, "macos", "/opt/homebrew", true)
        expect(min_mac.contains("_rt_vulkan_provider_is_available")).to_equal(false)
        expect(min_mac.contains("AppKit")).to_equal(false)
        expect(min_mac.contains("Metal")).to_equal(false)
        expect(min_mac.contains("CoreGraphics")).to_equal(false)
        expect(min_mac.contains("CoreFoundation")).to_equal(true)
        expect(min_mac.contains("Security")).to_equal(true)

        val min_linux = native_all_gnu_support_args_for_stage_v1(inputs, "linux", "", true)
        expect(min_linux.contains("rt_vulkan_provider_is_available")).to_equal(false)
        expect(min_linux.contains("-lstdc++")).to_equal(true)

describe "End-to-end simple-app primitive .a + dynlib packaging, dead-strip, and symbol retention":
    it "packages libsimple-primitive-<platform>-<cpu>.a + 4 dynlibs, skips Stage 3 plugin dynlibs, retains referenced primitive symbols, and dead-strips unused members":
        val cc = find_c_compiler()
        val nm = find_nm_portable()
        if host_os() != "windows" and cc != "" and nm != "":
            val root = "build/spec_phase3_host_native_unit_link"
            val _clean = dir_remove_all(root)
            expect(dir_create_all("{root}/src/lib/core")).to_equal(true)
            expect(dir_create_all("{root}/src/lib/nogc_sync_mut/http")).to_equal(true)
            expect(dir_create_all("{root}/src/compiler/00.common")).to_equal(true)
            expect(dir_create_all("{root}/src/compiler/80.driver")).to_equal(true)
            expect(dir_create_all("{root}/src/app/cli")).to_equal(true)
            expect(dir_create_all("{root}/src/plugins/backend_vhdl")).to_equal(true)
            expect(dir_create_all("{root}/src/compiler_rust")).to_equal(true)
            expect(dir_create_all("{root}/objs")).to_equal(true)

            expect(file_write("{root}/src/compiler_rust/simple.sdn",
                "project:\n  name: simple-rust-runtime\n  version: 1.0.0\n  type: runtime\n  root: .\n")).to_equal(true)
            expect(file_write("{root}/src/lib/simple.sdn",
                "project:\n  name: simple-std\n  version: 1.0.0\n  type: library\n  root: .\n  dependencies:\n    - project: ../compiler_rust\n")).to_equal(true)
            expect(file_write("{root}/src/compiler/00.common/simple.sdn",
                "project:\n  name: simple-compiler-common\n  version: 1.0.0\n  type: library\n  root: .\n  dependencies:\n    - project: ../../lib\n")).to_equal(true)
            expect(file_write("{root}/src/compiler/simple.sdn",
                "project:\n  name: simple-compiler\n  version: 1.0.0\n  type: library\n  root: .\n  sources:\n    include: [\"**/*.spl\"]\n    exclude: [\"00.common/**\"]\n  dependencies:\n    - project: ./00.common\n    - project: ../lib\n    - project: ../compiler_rust\n")).to_equal(true)
            expect(file_write("{root}/src/app/simple.sdn",
                "project:\n  name: simple-app\n  version: 1.0.0\n  type: application\n  root: .\n  dependencies:\n    - project: ../compiler\n    - project: ../lib\n    - project: ../compiler_rust\n")).to_equal(true)

            expect(file_write("{root}/src/lib/string_core.spl", "pub fn prim_used_value() -> i64: 19\n")).to_equal(true)
            expect(file_write("{root}/src/lib/core/unused_prim.spl", "pub fn prim_unused_dead_fn() -> i64: 999\n")).to_equal(true)
            expect(file_write("{root}/src/lib/nogc_sync_mut/http/client.spl", "pub fn std_compute() -> i64: 20\n")).to_equal(true)
            expect(file_write("{root}/src/compiler/00.common/types.spl", "pub fn common_compute() -> i64: 22\n")).to_equal(true)
            expect(file_write("{root}/src/compiler/80.driver/driver.spl", "pub fn compiler_compute() -> i64: 32\n")).to_equal(true)
            expect(file_write("{root}/src/app/cli/helper.spl", "pub fn app_compute() -> i64: 42\n")).to_equal(true)
            expect(file_write("{root}/src/app/cli/bootstrap_main.spl", "fn main() -> i64: 0\n")).to_equal(true)
            expect(file_write("{root}/src/plugins/backend_vhdl/vhdl_plugin.spl", "pub fn vhdl_unused() -> i64: 777\n")).to_equal(true)

            expect(_compile_c_obj(cc, "{root}/objs/prim_used.c", "{root}/objs/prim_used.o",
                "int prim_used_value(void) { return 19; }\nint sffi_bridge_probe(void) { return 1; }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/prim_unused.c", "{root}/objs/prim_unused.o",
                "int prim_unused_dead_fn(void) { return 999; }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/std_mod.c", "{root}/objs/std_mod.o",
                "extern int prim_used_value(void);\nextern int sffi_bridge_probe(void);\nvoid __module_init_std_mod(void) {}\nint std_compute(void) { return prim_used_value() + sffi_bridge_probe(); }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/common_mod.c", "{root}/objs/common_mod.o",
                "extern int std_compute(void);\nvoid __module_init_common_mod(void) {}\nint common_compute(void) { return std_compute() + 2; }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/compiler_mod.c", "{root}/objs/compiler_mod.o",
                "extern int common_compute(void);\nvoid __module_init_compiler_mod(void) {}\nint compiler_compute(void) { return common_compute() + 10; }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/app_helper.c", "{root}/objs/app_helper.o",
                "extern int compiler_compute(void);\nvoid __module_init_app_helper(void) {}\nint app_compute(void) { return compiler_compute() + 10; }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/vhdl_plugin.c", "{root}/objs/vhdl_plugin.o",
                "int unneeded_vhdl_plugin_fn(void) { return 777; }\n")).to_equal(true)
            expect(_compile_c_obj(cc, "{root}/objs/entry_main.c", "{root}/objs/entry_main.o",
                "extern int app_compute(void);\nint main(void) { return app_compute() == 42 ? 0 : 1; }\n")).to_equal(true)

            val host_tag = library_unit_resolve_host_tag_v1("", host_os(), host_arch())
            val rows = [
                LibraryUnitClosureModuleRowV1(
                    module_name: "std.string_core",
                    source_path: "{root}/src/lib/string_core.spl",
                    object_path: "{root}/objs/prim_used.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "std.core.unused_prim",
                    source_path: "{root}/src/lib/core/unused_prim.spl",
                    object_path: "{root}/objs/prim_unused.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "std.nogc_sync_mut.http.client",
                    source_path: "{root}/src/lib/nogc_sync_mut/http/client.spl",
                    object_path: "{root}/objs/std_mod.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "compiler.common.types",
                    source_path: "{root}/src/compiler/00.common/types.spl",
                    object_path: "{root}/objs/common_mod.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "compiler.driver.driver",
                    source_path: "{root}/src/compiler/80.driver/driver.spl",
                    object_path: "{root}/objs/compiler_mod.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "app.cli.helper",
                    source_path: "{root}/src/app/cli/helper.spl",
                    object_path: "{root}/objs/app_helper.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "plugins.backend_vhdl.vhdl_plugin",
                    source_path: "{root}/src/plugins/backend_vhdl/vhdl_plugin.spl",
                    object_path: "{root}/objs/vhdl_plugin.o"),
                LibraryUnitClosureModuleRowV1(
                    module_name: "app.cli.bootstrap_main",
                    source_path: "{root}/src/app/cli/bootstrap_main.spl",
                    object_path: "{root}/objs/entry_main.o")
            ]

            val old_s3 = env_get("SIMPLE_BOOTSTRAP_STAGE3") ?? ""
            val old_ht = env_get("SIMPLE_STAGE3_HOST_TAG") ?? ""
            env_set("SIMPLE_BOOTSTRAP_STAGE3", "1")
            env_set("SIMPLE_STAGE3_HOST_TAG", host_tag.tag)

            val out_bin = "{root}/dist/simple"
            val cache_root = "{root}/cache"
            val pkg_req = LibraryUnitClosurePackageRequestV1(
                repo_root: root,
                entry_source: "{root}/src/app/cli/bootstrap_main.spl",
                output_path: out_bin,
                cache_root: cache_root,
                producer_identity: "phase3-spec-prod-v1",
                scope_key: "phase3-spec-scope-v1",
                target_or_os: "",
                rows: rows)

            val cold_res = library_unit_partition_and_package_closure_v1(pkg_req)
            val warm_res = library_unit_partition_and_package_closure_v1(pkg_req)

            # Verify cross-OS mismatch fails closed under SIMPLE_BOOTSTRAP_STAGE3=1
            val mismatch_target = if host_tag.platform == "darwin":
                "x86_64-unknown-linux-gnu"
            else:
                "aarch64-apple-darwin"
            val mismatch_res = library_unit_partition_and_package_closure_v1(
                LibraryUnitClosurePackageRequestV1(
                    repo_root: root,
                    entry_source: "{root}/src/app/cli/bootstrap_main.spl",
                    output_path: out_bin,
                    cache_root: cache_root,
                    producer_identity: "phase3-spec-prod-v1",
                    scope_key: "phase3-spec-scope-v1",
                    target_or_os: mismatch_target,
                    rows: rows))

            env_set("SIMPLE_BOOTSTRAP_STAGE3", old_s3)
            env_set("SIMPLE_STAGE3_HOST_TAG", old_ht)

            expect(mismatch_res.is_err()).to_equal(true)
            expect(mismatch_res.unwrap_err()).to_contain("STAGE3-E-NATIVE-HOST-MISMATCH")

            if cold_res.is_err():
                expect(cold_res.unwrap_err()).to_equal("")
            else:
                val plan = cold_res.unwrap()
                expect(plan.unit_artifacts.len()).to_equal(4)
                expect(plan.unit_artifacts[0].unit).to_equal("simple-std")
                expect(plan.unit_artifacts[1].unit).to_equal("simple-compiler-common")
                expect(plan.unit_artifacts[2].unit).to_equal("simple-compiler")
                expect(plan.unit_artifacts[3].unit).to_equal("simple-app")
                expect(plan.staged_dynlibs.len()).to_equal(4)

                expect(plan.entry_objects.len()).to_equal(2)
                expect(plan.entry_objects[0]).to_equal("{root}/objs/entry_main.o")
                val expected_prim_name = "libsimple-primitive-{host_tag.platform}-{host_tag.cpu}.a"
                expect(plan.entry_objects[1]).to_contain(
                    "/units/simple-primitive-{host_tag.platform}-{host_tag.cpu}/")
                expect(plan.entry_objects[1].ends_with("/" + expected_prim_name)).to_equal(true)
                expect(file_exists(plan.entry_objects[1])).to_equal(true)

                expect(plan.retained_symbols.contains("prim_used_value")).to_equal(true)
                expect(plan.retained_symbols.contains("sffi_bridge_probe")).to_equal(true)
                expect(plan.retained_symbols.contains("prim_unused_dead_fn")).to_equal(false)

                expect(warm_res.is_ok()).to_equal(true)
                val warm_plan = warm_res.unwrap()
                expect(warm_plan.unit_artifacts[0].reused).to_equal(true)
                expect(warm_plan.unit_artifacts[3].reused).to_equal(true)
                expect(warm_plan.entry_objects[1]).to_equal(plan.entry_objects[1])

                # Link thin executable against libsimple-primitive-<platform>-<cpu>.a + 4 staged dynlibs
                var link_argv: [text] = []
                for rf in native_retained_symbol_cc_args(plan.retained_symbols, host_os()):
                    link_argv.push(rf)
                for eo in plan.entry_objects:
                    link_argv.push(eo)
                for sd in plan.staged_dynlibs:
                    link_argv.push(sd)
                var li = 0
                while li < plan.linker_flags.len():
                    val lf = plan.linker_flags[li]
                    if lf == "-rpath" and li + 1 < plan.linker_flags.len():
                        link_argv.push("-Wl,-rpath," + plan.linker_flags[li + 1])
                        li = li + 2
                        continue
                    link_argv.push(lf)
                    li = li + 1
                if host_tag.platform == "darwin":
                    link_argv.push("-Wl,-dead_strip")
                else:
                    link_argv.push("-Wl,--gc-sections")
                link_argv.push("-o")
                link_argv.push(out_bin)
                val (l_out, l_err, l_code) = process_run(cc, link_argv)
                if l_code != 0:
                    expect("{l_err}{l_out}").to_equal("")
                expect(l_code).to_equal(0)
                if host_tag.platform == "darwin" and file_exists("/usr/bin/codesign"):
                    val (_cs_o, _cs_e, cs_c) = process_run("/usr/bin/codesign", ["-s", "-", "--force", out_bin])
                    expect(cs_c).to_equal(0)

                val (_run_out, _run_err, run_code) = process_run(out_bin, [])
                expect(run_code).to_equal(0)

                val (nm_exec, _nm_err, nm_code) = process_run(nm, ["-g", out_bin])
                expect(nm_code).to_equal(0)
                expect(nm_exec).to_contain("prim_used_value")
                expect(nm_exec.contains("prim_unused_dead_fn")).to_equal(false)
                expect(nm_exec.contains("unneeded_vhdl_plugin_fn")).to_equal(false)

            val _rm = dir_remove_all(root)
