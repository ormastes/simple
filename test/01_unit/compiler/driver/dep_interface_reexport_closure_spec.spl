# Gap reexport_chain_closure (live_object_key.sdn) closed: deps_iface folds the
# TRANSITIVE dependency closure (dependency_closure_v1, the body of
# build_cache_dependency_closure), so A (imports B, B re-exports C) is
# invalidated by an interface change of C even though B's own text never
# changes. The fold itself (dep_iface_gate_record/_valid) is covered by
# dep_interface_cache_key_spec.spl.
use std.spec
use compiler.driver.driver_build.incremental.{dependency_closure_v1}

describe "dependency closure for deps_iface":
    it "reaches the re-exported module through the re-exporter":
        var recorded: {text: [text]} = {}
        recorded["b.spl"] = ["c.spl"]
        recorded["c.spl"] = ["d.spl"]
        recorded["d.spl"] = []
        val closure = dependency_closure_v1(recorded, ["b.spl"]) ?? []
        expect(closure).to_equal(["b.spl", "c.spl", "d.spl"])

    it "fails closed when a reachable dependency has no recorded edges":
        var recorded: {text: [text]} = {}
        recorded["x.spl"] = ["never_recorded.spl"]
        expect(dependency_closure_v1(recorded, ["x.spl"]) == nil).to_equal(true)

    it "terminates on a dependency cycle and de-duplicates":
        var recorded: {text: [text]} = {}
        recorded["p.spl"] = ["q.spl", "q.spl"]
        recorded["q.spl"] = ["p.spl"]
        expect(dependency_closure_v1(recorded, ["p.spl", "q.spl"]) ?? []).to_equal(["p.spl", "q.spl"])
