extern fn rt_file_read_text(path: text) -> text

# Bug: doc/08_tracking/bug/stage3_clean_baseline_is_bootstrap_flat_artifact_2026-08-01.md
#
# A stage3 build (SIMPLE_BOOTSTRAP=1, SIMPLE_BOOTSTRAP_STAGE4 unset) silently
# runs a "bootstrap-flat" pipeline that skips MIR lowering, borrow-check, and
# the flat MIR passes for every module except the bootstrap entry -- but its
# "728/0/0, 0 unresolved" summary looked identical to a real clean-tree
# result, and three lanes cited it as tree evidence before that was caught.
#
# The fix adds log_bootstrap_flat_warning(), which uses log_warn (always
# prints -- unlike log_phase, which is silent unless
# SIMPLE_COMPILER_PHASE_PROFILE/SIMPLE_COMPILER_TRACE happen to be set) and is
# wired at both chokepoints identified in the bug report: the MIR-lowering
# skip (driver_pipeline_lowering.spl) and the borrow-check/flat-MIR-passes
# skip (driver_aot_pipeline.spl).
#
# This spec is a sabotage-style regression proof: it asserts the exact
# properties that make the warning "loud" (unconditional call, not gated
# behind the same trace flag that made the original banner invisible) and
# that it is actually wired at both known-bad sites. Reverting any one of
# these assertions reproduces the original silent-flat-pipeline defect.

fn log_helpers_source() -> text:
    rt_file_read_text("src/compiler/80.driver/driver_log_helpers.spl") ?? ""

fn aot_pipeline_source() -> text:
    rt_file_read_text("src/compiler/80.driver/driver_aot_pipeline.spl") ?? ""

fn pipeline_lowering_source() -> text:
    rt_file_read_text("src/compiler/80.driver/driver_pipeline_lowering.spl") ?? ""

describe "stage3 bootstrap-flat measurement warning":
    it "defines log_bootstrap_flat_warning as an always-on banner (uses log_warn, not log_phase)":
        val source = log_helpers_source()

        expect(source).to_contain("pub fn log_bootstrap_flat_warning(site: text):")
        # log_warn's body is an unconditional print -- verify the warning
        # function calls log_warn (unconditional), NOT log_phase (which is a
        # no-op unless driver_phase_trace_enabled() -- the exact gate that
        # made the original "aot:flat_mir_passes:skipped" banner invisible).
        val fn_start = source.find("pub fn log_bootstrap_flat_warning(site: text):")
        val fn_end = source.find("pub fn log_phase(msg: text):")
        expect(fn_end).to_be_greater_than(fn_start)
        val fn_body = source[fn_start:fn_end]
        expect(fn_body).to_contain("log_warn(")
        expect(fn_body).to_not_contain("driver_phase_trace_enabled()")

    it "warns that a clean stage3 count is not tree-clean evidence, pointing at the bug record":
        val source = log_helpers_source()

        expect(source).to_contain("is NOT evidence the tree is clean")
        expect(source).to_contain(
            "doc/08_tracking/bug/stage3_clean_baseline_is_bootstrap_flat_artifact_2026-08-01.md")

    it "is wired at the borrow-check / flat-MIR-passes skip site (driver_aot_pipeline.spl)":
        val source = aot_pipeline_source()

        expect(source).to_contain(
            "use compiler.driver.driver_log_helpers.{log_debug, log_error, log_phase, log_bootstrap_flat_warning}")
        expect(source).to_contain("if bootstrap_flat_aot:\n            log_phase(\"aot:flat_mir_passes:skipped\")\n            log_bootstrap_flat_warning(\"aot:flat_mir_passes:skipped\")")

    it "is wired at the MIR-lowering skip site (driver_pipeline_lowering.spl)":
        val source = pipeline_lowering_source()

        expect(source).to_contain(
            "use compiler.driver.driver_log_helpers.{log_debug, log_phase, log_build_progress, log_bootstrap_flat_warning}")
        expect(source).to_contain("log_bootstrap_flat_warning(\"mir:bootstrap_fixed\")")

    it "sabotage check: removing either call site would leave a skip branch with no loud warning":
        # This encodes the exact defect shape from the bug report: a
        # `bootstrap_flat_aot` / SIMPLE_BOOTSTRAP branch that returns/continues
        # without ever calling the unconditional warning. Both known skip
        # sites must call it exactly once.
        val aot_source = aot_pipeline_source()
        val lowering_source = pipeline_lowering_source()

        val aot_calls = aot_source.split("log_bootstrap_flat_warning(").len() - 1
        val lowering_calls = lowering_source.split("log_bootstrap_flat_warning(").len() - 1

        expect(aot_calls).to_be_greater_than(0)
        expect(lowering_calls).to_be_greater_than(0)
