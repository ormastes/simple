"""Integrity checks for compiler-owned native collection receipt publication."""
use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{file_write_exact}
use compiler.driver.driver_collection_native_receipt.*
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.mir.mir_data.{MirModule}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_orchestration.*
use compiler.common.cache.reverse_reference_facts.{reverse_reference_owner_begin_v1, reverse_reference_owner_end_v1}
use std.nogc_sync_mut.io_runtime.{file_hash_sha256_or_empty}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}

extern fn rt_getpid() -> i64
extern fn rt_time_monotonic_ns() -> i64
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool

fn collection_receipt_fixture_path() -> text:
    expect(rt_dir_create_all("build")).to_equal(true)
    "build/collection-native-{rt_getpid()}-{rt_time_monotonic_ns()}"

describe "native collection artifact receipt":
    it "preserves active owner evidence but clears it after owned configuration failure":
        step("Exercise actual driver owner rejection and early failure cleanup")
        val output = collection_receipt_fixture_path()
        var options = driver_core_compile_options_default()
        options.cli_mode_text = "aot"
        options.output_file = Some(output)
        val driver = CompilerDriver.create(options)
        driver.ctx.config["mcdc_config_error"] = "fixture configuration rejection"
        val receipt = collection_native_receipt_path_v1(output)
        expect(file_write_exact(receipt, "active-owner-proof")).to_equal(true)
        expect(reverse_reference_owner_begin_v1()).to_equal(true)
        val rejected = driver.compile()
        reverse_reference_owner_end_v1()
        expect(rejected.is_success()).to_equal(false)
        expect(file_hash_sha256_or_empty(receipt)).to_equal(sha256_text("active-owner-proof"))
        expect(driver.compile().is_success()).to_equal(false)
        expect(file_hash_sha256_or_empty(receipt)).to_equal("")

    it "rejects absent capsule bindings and malformed identities":
        step("Fail closed before publishing unbound native evidence")
        expect(collection_native_encode_v1("", sha256_text("artifact"), []).is_err()).to_equal(true)
        expect(collection_native_encode_v1(sha256_text("request"), sha256_text("artifact"), []).is_err()).to_equal(true)

    it "uses canonical framing for multiline reports and rejects truncation":
        step("Roundtrip framed report payload and reject trailing partial data")
        val fields = ["collection-plan-v1\nprofile=not-admitted\n", "", "1:a:b"]
        val encoded = collection_native_frame_v1(fields)
        expect(collection_native_unframe_v1(encoded).unwrap()).to_equal(fields)
        expect(collection_native_unframe_v1(encoded + "4:bad").is_err()).to_equal(true)
        expect(collection_native_unframe_v1("-1:x").is_err()).to_equal(true)
        expect(collection_native_unframe_v1("01:x").is_err()).to_equal(true)
        expect(collection_native_unframe_v1("9999999999999999:x").is_err()).to_equal(true)
        expect(collection_native_unframe_v1("0:").unwrap()).to_equal([""])
        var many: [text] = []
        for index in 0..2048:
            many = many.push("field:{index}\n")
        expect(collection_native_unframe_v1(collection_native_frame_v1(many)).unwrap()).to_equal(many)

    it "clears prior proof before a failed build can reuse it":
        step("Remove only the compiler-owned sidecar, preserving artifact bytes")
        val output = collection_receipt_fixture_path()
        expect(file_write_exact(output, "prior-artifact")).to_equal(true)
        expect(file_write_exact(collection_native_receipt_path_v1(output), "prior-receipt")).to_equal(true)
        expect(collection_native_clear_v1(output)).to_equal("")
        expect(collection_native_validate_v1(output, sha256_text("request"))).to_equal("receipt-missing")
        expect(file_hash_sha256_or_empty(output)).to_equal(sha256_text("prior-artifact"))
        expect(rt_file_delete(output)).to_equal(true)

    it "binds current frozen reports and detects artifact and object mutation":
        step("Exercise real capsule freezing and file publication with IO fixture bytes")
        # These bytes test integrity only; they are not an executable or a
        # runtime semantics proof. Typed lowering has separate MIR specs.
        val output = collection_receipt_fixture_path()
        val ctx = CompileContext.create(driver_core_compile_options_default())
        ctx.mir_modules["receipt"] = MirModule(name: "receipt", functions: {},
            statics: {}, constants: {}, types: {}, collection_plan_explanations:
                ["collection-plan-v1\nprofile=not-admitted\ntyped_mir=original"])
        _ = ctx.freeze_storage_registry()
        val batch = ctx.freeze_native_module_capsules_v1(["receipt"], output + "-objects",
            "llvm", "x86_64-unknown-linux-gnu", "generic", 2, false)
        expect(batch.ok).to_equal(true)
        val capsule = batch.find("receipt")
        expect(capsule.ok).to_equal(true)
        expect(file_write_exact(capsule.object_path, "object-fixture")).to_equal(true)
        val object_digest = sha256_text("object-fixture")
        val object_size = "object-fixture".len()
        val capsule_receipt = "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n{object_size}\n{object_digest}\n"
        val mismatched_digest = sha256_text("different-object")
        val mismatched_capsule_receipt = "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n{object_size}\n{mismatched_digest}\n"
        expect(file_write_exact(capsule.object_path + ".capsule-receipt", mismatched_capsule_receipt)).to_equal(true)
        expect(collection_native_bind_capsule_v1(capsule).is_err()).to_equal(true)
        expect(file_write_exact(capsule.object_path + ".capsule-receipt", capsule_receipt)).to_equal(true)
        val binding = collection_native_bind_capsule_v1(capsule).unwrap()
        val request = sha256_text("request")
        var altered = collection_native_unframe_v1(binding).unwrap()
        altered[11] = collection_native_frame_v1(["collection-plan-v1\ntyped_mir=consumed"])
        expect(collection_native_encode_v1(request, sha256_text("artifact-fixture"),
            [collection_native_frame_v1(altered)]).is_err()).to_equal(true)
        altered[11] = ""
        altered[10] = sha256_text("")
        val empty_binding = collection_native_frame_v1(altered)
        val empty_receipt = collection_native_encode_v1(request, sha256_text("artifact-fixture"),
            [empty_binding]).unwrap()
        val empty_outer = collection_native_unframe_v1(empty_receipt).unwrap()
        val empty_body = collection_native_unframe_v1(empty_outer[0]).unwrap()
        expect(empty_body[3]).to_equal("no-reported-plans")
        expect(collection_native_decode_v1(empty_receipt, request, sha256_text("artifact-fixture")).unwrap()).to_equal([empty_binding])
        expect(file_write_exact(output, "artifact-fixture")).to_equal(true)
        val retained_dir = output + "-retained"
        expect(rt_dir_create_all(retained_dir)).to_equal(true)
        val retained = collection_native_retain_link_inputs_v1([binding], retained_dir).unwrap()
        expect(retained.len()).to_equal(1)
        expect(collection_native_link_inputs_valid_v1([binding], retained)).to_equal(true)
        # Mutating the shared cache/build path after admission cannot change the
        # bytes selected for the linker. Publication authenticates the same
        # private retained path the driver passes to every native link mode.
        expect(file_write_exact(capsule.object_path, "changed-object")).to_equal(true)
        expect(collection_native_link_inputs_valid_v1([binding], retained)).to_equal(true)
        expect(file_write_exact(capsule.object_path, "object-fixture")).to_equal(true)
        expect(collection_native_publish_v1(output, request, [binding], retained)).to_equal("")
        expect(collection_native_validate_v1(output, request)).to_equal("")
        expect(collection_native_copy_v1(output, output, request)).to_equal("")
        expect(collection_native_validate_v1(output, request)).to_equal("")
        expect(collection_native_validate_v1(output, sha256_text("different"))).to_equal("build-request-mismatch")
        val delivery = output + "-delivery"
        expect(file_write_exact(delivery, "artifact-fixture")).to_equal(true)
        expect(collection_native_copy_v1(output, delivery, request)).to_equal("")
        expect(collection_native_validate_v1(delivery, request)).to_equal("")
        expect(file_write_exact(output, "changed-artifact")).to_equal(true)
        expect(collection_native_validate_v1(output, request)).to_equal("artifact-digest-mismatch")
        expect(file_write_exact(retained[0], "tampered-retained")).to_equal(true)
        expect(collection_native_link_inputs_valid_v1([binding], retained)).to_equal(false)
        expect(collection_native_publish_v1(output, request, [binding], retained)).to_equal("link-input-object-changed")
        expect(file_write_exact(retained[0], "object-fixture")).to_equal(true)
        expect(collection_native_clear_v1(output)).to_equal("")
        expect(collection_native_clear_v1(delivery)).to_equal("")
        expect(rt_file_delete(output)).to_equal(true)
        expect(rt_file_delete(delivery)).to_equal(true)
        expect(rt_file_delete(capsule.object_path)).to_equal(true)
        expect(rt_file_delete(capsule.object_path + ".capsule-receipt")).to_equal(true)
        expect(dir_remove(retained_dir, true)).to_equal(true)
