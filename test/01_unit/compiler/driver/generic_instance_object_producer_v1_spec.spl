# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/generic_instance_object_producer_v1.spl 0%
"""
# Generic instance-object producer + link wiring (P-G7)

MIR children stage one COMDAT instance object FILE per ConcreteTldrKey (first
writer wins); the coordinator's single-flight job copies the staged object
byte-for-byte into the producer-keyed cache (sidecar header over the byte
digest), and the link step links a re-verified copy once. Two consumers -> one
instance object linked once; unchanged -> reuse; a template change (same key,
changed owner body) -> exactly that instance rebuilt and nothing retired
against the old object. Instances naming module-local symbols are not
extracted.
"""

# @tag:unit
# @tag:compiler
# @tag:cache
# @tag:generics

use std.spec
use std.io_runtime.{dir_create_all, file_exists, file_write, file_read_bytes, file_write_bytes}
use app.io.time_ops.{time_now_unix_micros}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.driver.cache.generic_specialization_list_v1.{RequiredSpecializationV1, GenericSpecializationListV1}
use compiler.driver.driver_build.native_file_worker_instances_v1.*
use compiler.driver.driver_build.generic_instance_object_producer_v1.*

val PRODUCER = "producer-pg7"

fn spec_of(symbol: text, key: text) -> RequiredSpecializationV1:
    RequiredSpecializationV1(template_symbol: symbol, template_id: "t:id", args_id: "a:" + key,
        arg_keys: [key], concrete_key: key)

fn fresh_root(tag: text) -> text:
    val root = "build/test_tmp/pg7_" + tag + "_" + "{time_now_unix_micros()}"
    val _ok = dir_create_all(root)
    root

# A template owner source file and its module id ("<id>.id" is the template).
fn owner(root: text, body: text) -> (text, text):
    val path = root + "/pkg_owner.spl"
    val _w = file_write(path, body)
    val ids = generic_instance_module_ids_v1([path])
    var id = ""
    for k in ids.keys():
        id = k
    (path, id)

fn object_file(root: text, name: text, content: text) -> text:
    val path = root + "/" + name + ".o"
    val _w = file_write(path, content)
    path

fn body_lists(root: text, keys: [text]) -> ([GenericSpecializationListV1?], Dict<text, text>):
    val (path, id) = owner(root, file_read_owner(root))
    var specs: [RequiredSpecializationV1] = []
    for k in keys:
        specs.push(spec_of(id + ".id", k))
    var deps: Dict<text, [text]> = {}
    deps[path] = ["pkg/shapes.spl"]
    generic_instance_lists_with_body_v1([Some(GenericSpecializationListV1(complete: true, specs: specs))],
        generic_instance_module_ids_v1([path]), deps, fake_iface)

var owner_body_v1: text = "fn id<T>(x: T) -> T: x\n"
# Interface digest of the owner's one direct import (stands in for
# file_worker_inc_iface_digest_v1).
var import_iface_v1: text = "iface-1"

fn fake_iface(path: text) -> text:
    if path == "pkg/shapes.spl": import_iface_v1 else: ""

fn two_import_iface(path: text) -> text:
    if path == "pkg/shapes.spl": "shape-iface"
    elif path == "pkg/other.spl": "other-iface"
    else: ""

fn file_read_owner(root: text) -> text:
    owner_body_v1

fn run_round(root: text, round: text, keys: [text]) -> FileWorkerInstanceRunV1:
    val (lists, _owners) = body_lists(root, keys)
    val plan = file_worker_instances_plan_v1(lists, root + "/cache", PRODUCER)
    file_worker_instances_run_v1(plan, root + "/cache", PRODUCER, root + "/jobs-" + round,
        "owner-" + round, true, generic_instance_object_from_stage_v1(root + "/stage-" + round, _1))

# ---- MIR fixtures ----

fn span_at(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "fixture/pg7.spl", length: 0)

fn i64_t() -> MirType:
    MirType(kind: MirTypeKind.I64)

fn mk_fn(sym: i64, name: text, instructions: [MirInst], comdat: bool) -> MirFunction:
    var f = MirFunction(
        symbol: SymbolId(id: sym), name: name,
        signature: MirSignature(params: [], return_type: i64_t(), is_variadic: false, params_known: true),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: i64_t(), kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: Some("entry"), instructions: instructions,
            terminator: MirTerminator.Ret(nil))],
        entry_block: BlockId(id: 0), span: span_at(1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0)
    f.is_comdat = comdat
    f

fn call_inst(callee: text) -> MirInst:
    val op = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(callee), i64_t()))
    MirInst(kind: MirInstKind.Call(Some(LocalId(id: 0)), op, []), span: Some(span_at(2)))

fn str_inst(value: text) -> MirInst:
    MirInst(kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Str(value), i64_t()), span: Some(span_at(3)))

fn mk_module(functions: [MirFunction], constants: [MirConstant]) -> MirModule:
    var fns: Dict<SymbolId, MirFunction> = {}
    for f in functions:
        fns[f.symbol] = f
    var cs: Dict<SymbolId, MirConstant> = {}
    for c in constants:
        cs[c.symbol] = c
    MirModule(name: "fixture.pg7", functions: fns, statics: {}, constants: cs, types: {})

describe "generic instance-object producer (P-G7)":
    it "two consumers stage one instance object, built once and linked once":
        val root = fresh_root("two")
        val stage = root + "/stage-0"
        val a = object_file(root, "a", "OBJ-A")
        val b = object_file(root, "b", "OBJ-B")
        # Two MIR children (consumer A, consumer B) stage the same key.
        expect(generic_instance_stage_publish_v1(stage, "k:id_i64", a)).to_equal(true)
        expect(generic_instance_stage_publish_v1(stage, "k:id_i64", b)).to_equal(true)
        val r = run_round(root, "0", ["k:id_i64", "k:id_i64"])
        expect(r.built.len()).to_equal(1)
        expect(r.failed.len()).to_equal(0)
        expect(r.retire_comdat).to_equal(true)
        val (objects, ok) = generic_instance_link_objects_v1(root + "/cache", PRODUCER, r.built,
            root + "/link")
        expect(ok).to_equal(true)
        expect(objects.len()).to_equal(1)
        expect(file_read_bytes(objects[0])).to_equal(file_read_bytes(a))

    it "object bytes round-trip stage -> cache -> link byte-for-byte":
        val root = fresh_root("bytes")
        val raw = root + "/raw.o"
        val payload: [u8] = [0u8, 255u8, 0xC3u8, 0x28u8, 0x7Fu8, 0u8, 0x80u8, 0xFEu8]
        expect(file_write_bytes(raw, payload)).to_equal(true)
        expect(generic_instance_stage_publish_v1(root + "/stage-0", "k:bytes", raw)).to_equal(true)
        val r = run_round(root, "0", ["k:bytes"])
        expect(r.built.len()).to_equal(1)
        val (objects, ok) = generic_instance_link_objects_v1(root + "/cache", PRODUCER, r.built,
            root + "/link")
        expect(ok).to_equal(true)
        expect(file_read_bytes(objects[0])).to_equal(payload)

    it "unchanged lists reuse the cached instance object and build nothing":
        val root = fresh_root("same")
        val _staged = generic_instance_stage_publish_v1(root + "/stage-0", "k:id_i64",
            object_file(root, "one", "OBJ-1"))
        val _first = run_round(root, "0", ["k:id_i64"])
        # Round 1 stages nothing: a build attempt would fail closed.
        val again = run_round(root, "1", ["k:id_i64"])
        expect(again.built.len()).to_equal(0)
        expect(again.failed.len()).to_equal(0)
        expect(again.reused.len()).to_equal(1)
        expect(again.relink).to_equal(false)

    it "a template body change with the same key rebuilds exactly that instance and retires nothing":
        val root = fresh_root("body")
        val cache = root + "/cache"
        val _s = generic_instance_stage_publish_v1(root + "/stage-0", "k:id_i64",
            object_file(root, "v1", "ID-V1"))
        owner_body_v1 = "fn id<T>(x: T) -> T: x\n"
        val first = run_round(root, "0", ["k:id_i64"])
        val (_l, owners) = body_lists(root, ["k:id_i64"])
        expect(generic_instance_retire_record_v1(cache, PRODUCER, first.built, owners,
            first.retire_comdat)).to_equal(true)
        expect(generic_instance_retire_snapshot_v1(cache, PRODUCER, fake_iface).len()).to_equal(1)
        # Body-only edit: same signature, so the same ConcreteTldrKey.
        owner_body_v1 = "fn id<T>(x: T) -> T:\n    val y = x\n    y\n"
        val _w = owner(root, owner_body_v1)
        expect(generic_instance_retire_snapshot_v1(cache, PRODUCER, fake_iface).len()).to_equal(0)
        val _s2 = generic_instance_stage_publish_v1(root + "/stage-1", "k:id_i64",
            object_file(root, "v2", "ID-V2"))
        val r = run_round(root, "1", ["k:id_i64"])
        expect(r.built.len()).to_equal(1)
        expect(r.reused.len()).to_equal(0)
        expect(r.dropped).to_equal(first.built)
        expect(generic_instance_concrete_of_v1(r.built[0])).to_equal("k:id_i64")

    it "an unknown template owner keeps the plan incomplete":
        val lists: [GenericSpecializationListV1?] = [Some(GenericSpecializationListV1(complete: true,
            specs: [spec_of("nowhere.id", "k:x")]))]
        val (out, _owners) = generic_instance_lists_with_body_v1(lists, {}, {}, fake_iface)
        match out[0]:
            case Some(l): expect(l.complete).to_equal(false)
            case nil: expect(false).to_equal(true)

    it "a key with no staged object fails closed and nothing is retirable":
        val root = fresh_root("missing")
        val r = run_round(root, "0", ["k:none"])
        expect(r.failed.len()).to_equal(1)
        expect(r.retire_comdat).to_equal(false)
        val (_objects, ok) = generic_instance_link_objects_v1(root + "/cache", PRODUCER, r.failed,
            root + "/link")
        expect(ok).to_equal(false)

    it "extracts a self-contained instance but not one naming module-local symbols":
        val inst = mk_fn(1, "id$i64", [], true)
        val calls_local = mk_fn(2, "use$i64", [call_inst("fixture.helper")], true)
        val names_const = mk_fn(3, "k$i64", [str_inst("fixture.LIMIT")], true)
        val helper = mk_fn(4, "fixture.helper", [], false)
        val limit = MirConstant(symbol: SymbolId(id: 5), name: "fixture.LIMIT", type_: i64_t(),
            value: MirConstValue.Int(3))
        val m = mk_module([inst, calls_local, names_const, helper], [limit])
        expect(generic_instance_mir_module_of_v1(m, "id$i64") != nil).to_equal(true)
        expect(generic_instance_mir_module_of_v1(m, "use$i64") == nil).to_equal(true)
        expect(generic_instance_mir_module_of_v1(m, "k$i64") == nil).to_equal(true)
        expect(generic_instance_mir_module_of_v1(m, "fixture.helper") == nil).to_equal(true)

    it "maps a placed instance symbol to its key":
        generic_instance_key_record_v1("id$i64", "k:id_i64")
        expect(generic_instance_key_of_v1("id$i64")).to_equal("k:id_i64")
        expect(generic_instance_key_of_v1("other$i64")).to_equal("")

    it "an imported type's layout change with the template source unchanged rebuilds the instance":
        val root = fresh_root("iface")
        val cache = root + "/cache"
        owner_body_v1 = "fn id<T>(x: T) -> T: x\n"
        import_iface_v1 = "iface-1"
        val _s = generic_instance_stage_publish_v1(root + "/stage-0", "k:id_shape",
            object_file(root, "v1", "ID-SHAPE-V1"))
        val first = run_round(root, "0", ["k:id_shape"])
        val (_l, owners) = body_lists(root, ["k:id_shape"])
        expect(generic_instance_retire_record_v1(cache, PRODUCER, first.built, owners,
            first.retire_comdat)).to_equal(true)
        expect(generic_instance_retire_snapshot_v1(cache, PRODUCER, fake_iface).len()).to_equal(1)
        # A field of a type in the imported module changes: its interface digest moves.
        import_iface_v1 = "iface-2"
        expect(generic_instance_retire_snapshot_v1(cache, PRODUCER, fake_iface).len()).to_equal(0)
        val _s2 = generic_instance_stage_publish_v1(root + "/stage-1", "k:id_shape",
            object_file(root, "v2", "ID-SHAPE-V2"))
        val r = run_round(root, "1", ["k:id_shape"])
        expect(r.built.len()).to_equal(1)
        expect(r.reused.len()).to_equal(0)
        expect(r.dropped).to_equal(first.built)
        import_iface_v1 = "iface-1"

    it "an owner import with no interface digest keeps the plan incomplete":
        val root = fresh_root("noiface")
        import_iface_v1 = ""
        val (lists, _owners) = body_lists(root, ["k:id_x"])
        match lists[0]:
            case Some(l): expect(l.complete).to_equal(false)
            case nil: expect(false).to_equal(true)
        import_iface_v1 = "iface-1"

    it "round-trips both owner imports through the retirement row separator":
        val root = fresh_root("two-imports")
        val (path, id) = owner(root, "fn id<T>(x: T) -> T: x\n")
        val imports = ["pkg/shapes.spl", "pkg/other.spl"]
        var deps: Dict<text, [text]> = {}
        deps[path] = imports
        val (lists, owners) = generic_instance_lists_with_body_v1(
            [Some(GenericSpecializationListV1(complete: true, specs: [spec_of(id + ".id", "k:two")]))],
            generic_instance_module_ids_v1([path]), deps, two_import_iface)
        match lists[0]:
            case Some(list):
                expect(list.complete).to_equal(true)
                expect(list.specs.len()).to_equal(1)
                val row = owners[list.specs[0].concrete_key].split("\t")
                expect(row.len()).to_equal(2)
                val restored = row[1].split("\u001e")
                expect(restored).to_equal(imports)
                expect(generic_instance_owner_digest_v1(path, restored, two_import_iface)).to_equal(
                    generic_instance_body_digest_of_v1(list.specs[0].concrete_key))
            case nil: expect(false).to_equal(true)
