# Source candidate: real parser/HIR/mono, body admission and same-owner MIR.
# Runtime evidence is UNRUN until an admitted rebuilt producer executes this.
# @req REQ-MIR-SELECTIVE-001
use std.spec.*
use std.spec.step
use std.io_runtime.{env_get, env_set, getpid}
use std.nogc_sync_mut.io_runtime.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.cache.reverse_reference_facts.{reverse_reference_owner_begin_v1,
    reverse_reference_owner_end_v1}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, SymbolId, HirExpr, HirExprKind}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.mono.monomorphize_integration.{MonomorphizationPass}
use compiler.mono.mono_selective_emission_publication_v1.{MonoSelectiveFunctionPlacementV1,
    mono_selective_emission_publication_v1}
use compiler.driver.driver_build.native_mir_selective_bundle_v1.{NativeMirSelectiveRowV1,
    NativeMirSelectiveBundleV1, native_mir_selective_write_module_in_owned_scope_v1,
    native_mir_selective_write_manifest_v1, native_mir_selective_load_bundle_v1,
    native_mir_selective_source_binding_v1}
use compiler.driver.driver_mir_selective_worker_v1.{driver_mir_selective_alias_functions_v1,
    driver_mir_selective_copy_symbols_v1, driver_mir_selective_prepare_v1,
    driver_mir_selective_lower_claimed_v1}
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1,
    hir_cache_clear_last_warnings}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_instructions.{MirModule}
use compiler.mir.hir_declaration_types_v1.{MirHirModuleDeclarationsV1,
    MirHirFunctionDeclarationV1}
use compiler.mir._MirLowering.archive_borrowed_module_v1.{MirArchiveFunctionEmissionV1}
use std.common.crypto.sha256.{sha256_text}

fn alias_mono_lower_source_v1(source: text) -> HirModule:
    val path = "testdata/selective_alias_mono.spl"
    val ast = parse_full_frontend(source, path, "alias_shared", Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    val module = lowering.lower_module(ast)
    expect(lowering.errors.len()).to_equal(0)
    module

fn alias_mono_write_row_v1(dir: text, source: text, context: text,
        name: text, body: text, module: HirModule,
        selected: [MirArchiveFunctionEmissionV1]) -> NativeMirSelectiveRowV1:
    expect(transient_scope_begin()).to_equal(true)
    val result = native_mir_selective_write_module_in_owned_scope_v1(dir,
        source, context, name, module, 1,
        native_mir_selective_source_binding_v1(name, module.path, sha256_text(body), body.len()), selected)
    val paused = transient_scope_pause()
    var promoted = false
    if paused:
        promoted = transient_promote(result) and hir_cache_promote_diagnostic_owner_v1()
        hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    expect(paused and promoted and ended).to_equal(true)
    expect(result.is_ok()).to_equal(true)
    result.unwrap()

describe "selective repeated alias bodies with real monomorphizer provenance", tag: ["only-compiled"]:
    it "emits one certified specialization, deduplicates its repeated alias and rejects changed or uncertified bodies":
        val dir = "build/test_tmp/mir_selective_alias_mono_{getpid()}"
        val saved_selective = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        val saved_export = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        val saved_cache = env_get("SIMPLE_HIR_CACHE") ?? ""
        val saved_cache_dir = env_get("SIMPLE_HIR_CACHE_DIR") ?? ""
        val _clean_before = dir_remove_all(dir)
        expect(dir_create_all(dir)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", dir)).to_equal(true)
        expect(env_set("SIMPLE_HIR_CACHE", "1")).to_equal(true)
        expect(env_set("SIMPLE_HIR_CACHE_DIR", "{dir}/owned-artifacts")).to_equal(true)
        step("Run real monomorphization and retain exact placements for three logical aliases")
        val body = "fn identity<T>(value: T) -> T:\n    value\n\nfn main() -> i64:\n    identity(7)\n"
        val names = ["primary", "alias_a", "alias_b"]
        var input: Dict<text, HirModule> = {}
        for name in names: input[name] = alias_mono_lower_source_v1(body)
        var mono = MonomorphizationPass.create()
        val modules = mono.process_modules(input)
        expect(mono.diagnostics.len()).to_equal(0)
        expect(mono.stats.specializations_created).to_equal(1)
        val publication = mono_selective_emission_publication_v1()
        expect(publication.is_ok()).to_equal(true)
        val placements = publication.unwrap()
        expect(placements.len()).to_equal(3)
        var selections: Dict<text, [MirArchiveFunctionEmissionV1]> = {}
        for name in names: selections[name] = []
        for index in 0..placements.len():
            val placement: MonoSelectiveFunctionPlacementV1 = placements[index]
            val exact = MirArchiveFunctionEmissionV1(symbol: placement.symbol,
                name: placement.name, complete_function_digest: placement.complete_function_digest)
            var owned: [MirArchiveFunctionEmissionV1] = selections[placement.logical_key]
            owned.push(exact)
            selections[placement.logical_key] = owned
        val target: MirArchiveFunctionEmissionV1 = selections["alias_a"][0]
        expect(selections["alias_b"][0].symbol).to_equal(target.symbol)
        expect(selections["alias_b"][0].complete_function_digest).to_equal(target.complete_function_digest)
        # Deliberately construct the missing-primary variant from complete
        # actual mono output; the two secondary bodies remain untouched.
        var primary: HirModule = modules["primary"]
        var primary_functions: Dict<SymbolId, HirFunction> = {}
        for key in primary.functions.keys():
            val function: HirFunction = primary.functions[key]
            if function.symbol.id != target.symbol: primary_functions[key] = function
        expect(primary_functions.len()).to_equal(primary.functions.len() - 1)
        primary.functions = primary_functions
        val source = sha256_text(body)
        val context = sha256_text("actual-mono-alias-worker-regression-v1")
        val no_selections: [MirArchiveFunctionEmissionV1] = []
        val first = alias_mono_write_row_v1(dir, source, context, "primary", body, primary, no_selections)
        val second = alias_mono_write_row_v1(dir, source, context, "alias_a", body, modules["alias_a"], selections["alias_a"])
        val third = alias_mono_write_row_v1(dir, source, context, "alias_b", body, modules["alias_b"], selections["alias_b"])
        var entry = first
        entry.is_entry = true
        entry.secondary_names = ["alias_a", "alias_b"]
        expect(native_mir_selective_write_manifest_v1(dir, source, context,
            [first, second, third], [entry], names).is_ok()).to_equal(true)
        val admitted = native_mir_selective_load_bundle_v1(dir, source, context)
        expect(admitted.is_ok()).to_equal(true)
        var bundle: NativeMirSelectiveBundleV1 = admitted.unwrap()
        step("Lower the primary and its first actual selected alias under one MIR owner")
        expect(reverse_reference_owner_begin_v1()).to_equal(true)
        val symbols = driver_mir_selective_copy_symbols_v1(bundle.declarations.modules["primary"].symbols)
        expect(symbols.is_ok()).to_equal(true)
        var lowering = MirLowering.new(symbols.unwrap())
        lowering.use_explicit_semantic_policy()
        expect(driver_mir_selective_prepare_v1(lowering, bundle.declarations, names).is_ok()).to_equal(true)
        val primary_result = driver_mir_selective_lower_claimed_v1(lowering, dir, bundle, entry)
        expect(primary_result.is_ok()).to_equal(true)
        val primary_output: MirModule = primary_result.unwrap()
        var emitted: Dict<i64, bool> = {}
        for raw_id in primary_output.functions.keys():
            val id: SymbolId = raw_id
            emitted[id.id] = true
        expect(emitted.has(target.symbol)).to_equal(false)
        var certified: Dict<i64, MirArchiveFunctionEmissionV1> = {}
        val selected = driver_mir_selective_alias_functions_v1(bundle, "primary", "alias_a", emitted, certified)
        expect(selected.is_ok()).to_equal(true)
        expect(selected.unwrap().len()).to_equal(1)
        val previous_symbols = lowering.symbols
        val previous_thunks = lowering.native_trait_thunks
        val added = driver_mir_selective_lower_claimed_v1(lowering, dir, bundle, second,
            Some(selected.unwrap()), "primary", Some(primary_output), Some(previous_symbols),
            "primary", previous_thunks)
        expect(added.is_ok()).to_equal(true)
        val merged: MirModule = added.unwrap()
        expect(merged.functions.len()).to_equal(primary_output.functions.len() + 1)
        expect(lowering.errors.len()).to_equal(0)
        # Certification follows successful actual lowering. Its numeric set
        # comes from the merged result, never from names or guessed ranges.
        for raw_id in merged.functions.keys():
            val id: SymbolId = raw_id
            emitted[id.id] = true
        expect(emitted.has(target.symbol)).to_equal(true)
        val actual_selected = selected.unwrap()
        for index in 0..actual_selected.len():
            val exact: MirArchiveFunctionEmissionV1 = actual_selected[index]
            certified[exact.symbol] = exact
        step("Deduplicate the identical second alias while refusing an emitted ID without certification")
        val duplicate = driver_mir_selective_alias_functions_v1(bundle, "primary", "alias_b", emitted, certified)
        expect(duplicate.is_ok()).to_equal(true)
        expect(duplicate.unwrap().len()).to_equal(0)
        val no_certification: Dict<i64, MirArchiveFunctionEmissionV1> = {}
        val generated_collision = driver_mir_selective_alias_functions_v1(bundle,
            "primary", "alias_b", emitted, no_certification)
        expect(generated_collision.is_err()).to_equal(true)
        expect(generated_collision.unwrap_err()).to_contain("emitted generated function")
        step("Change an actual complete HIR body and reject its conflicting digest at the alias filter")
        val alias: HirModule = modules["alias_b"]
        var changed_digest = ""
        for key in alias.functions.keys():
            var function: HirFunction = alias.functions[key]
            if function.symbol.id != target.symbol: continue
            var changed_body = function.body
            changed_body.value = HirExpr(kind: HirExprKind.IntLit(99, nil),
                has_type_: true, type_: function.return_type, span: Span.empty())
            function.body = changed_body
            changed_digest = mono_complete_function_digest_v1(function)
        expect(changed_digest.len()).to_equal(64)
        expect(changed_digest == target.complete_function_digest).to_equal(false)
        # Adversarial metadata is intentionally applied only to the mechanical
        # filter fixture. Full bundle admission remains a separate prerequisite.
        var declaration: MirHirModuleDeclarationsV1 = bundle.declarations.modules["alias_b"]
        var changed_functions: [MirHirFunctionDeclarationV1] = []
        for raw_function in declaration.functions:
            var function: MirHirFunctionDeclarationV1 = raw_function
            if function.symbol.id == target.symbol: function.complete_function_digest = changed_digest
            changed_functions.push(function)
        declaration.functions = changed_functions
        bundle.declarations.modules["alias_b"] = declaration
        bundle.specialization_selections["alias_b"] = [MirArchiveFunctionEmissionV1(
            symbol: target.symbol, name: target.name, complete_function_digest: changed_digest)]
        val conflicting = driver_mir_selective_alias_functions_v1(bundle, "primary", "alias_b", emitted, certified)
        expect(conflicting.is_err()).to_equal(true)
        expect(conflicting.unwrap_err()).to_contain("earlier certified alias")
        reverse_reference_owner_end_v1()
        expect(env_set("SIMPLE_MIR_SELECTIVE", saved_selective)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved_export)).to_equal(true)
        expect(env_set("SIMPLE_HIR_CACHE", saved_cache)).to_equal(true)
        expect(env_set("SIMPLE_HIR_CACHE_DIR", saved_cache_dir)).to_equal(true)
        val _clean_after = dir_remove_all(dir)
