# @cover src/compiler/80.driver/driver_build/native_file_worker_v1.spl
# A file-worker child killed at its wall budget is sealed TIMEOUT, not CRASH:
# the ledger already distinguishes the two (driver_hir_recovery
# hir_shard_reap_state_v1), and a deadline is operator-tunable (--timeout)
# where a crash is a defect. Every other negative code stays CRASH, every
# non-negative one FAILED (the seal is only published when the child did not
# publish its own terminal).
use std.spec
use compiler.driver.driver_build.native_file_worker_v1.{
    native_file_worker_seal_state_v1, NATIVE_FILE_WORKER_TIMEOUT_CODE_V1}

describe "file-worker child seal state":
    it "seals a budget kill as TIMEOUT":
        expect(NATIVE_FILE_WORKER_TIMEOUT_CODE_V1).to_equal(-2)
        expect(native_file_worker_seal_state_v1(NATIVE_FILE_WORKER_TIMEOUT_CODE_V1)).to_equal("TIMEOUT")

    it "seals any other abnormal exit as CRASH":
        expect(native_file_worker_seal_state_v1(-1)).to_equal("CRASH")
        expect(native_file_worker_seal_state_v1(-137)).to_equal("CRASH")

    it "seals a normal non-zero or zero exit as FAILED":
        expect(native_file_worker_seal_state_v1(0)).to_equal("FAILED")
        expect(native_file_worker_seal_state_v1(3)).to_equal("FAILED")
