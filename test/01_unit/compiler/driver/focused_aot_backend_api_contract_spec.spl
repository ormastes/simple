use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused AOT backend API closure contract":
    it "does not retain the dead check backend adapter":
        val driver = file_read("src/compiler/80.driver/driver.spl")
        expect(driver.contains("backend.backend.backend_api")).to_equal(false)
        expect(driver.contains("CheckBackendImpl")).to_equal(false)
