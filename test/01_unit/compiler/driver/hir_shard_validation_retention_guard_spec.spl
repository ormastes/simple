# Source-contract regression for the retained cold-store path. This does not
# qualify runtime memory: the three-module cold-shard probe must separately
# observe zero growth in all four fields, cache adoption, and rejection paths.
use std.spec.*
use std.io.{file_read}

val DRIVER = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"

describe "retained HIR shard validation retention guard":
    it "guards all four aggregate transports after cache and identity receipts":
        val source = file_read(DRIVER)
        val retained_start = source.index_of("me lower_and_check_impl()")
        expect(retained_start).to_be_greater_than(0)
        val retained = source.substring(retained_start, source.len())
        val cache_store = retained.index_of("hir_cache_store(hir_cache_key_value,")
        val cache_receipt = retained.index_of("if not hir_shard_finish(", cache_store)
        val identity = retained.index_of("var validation_surface_index:", cache_receipt)
        val layout = retained.index_of("validation_module_values = validation_module_values.push(", identity)
        val guard = retained.index_of("\n                    if not hir_shard_mode:\n", layout)
        val end = retained.index_of("\n                    if source_idx < 4:\n", guard)
        expect(cache_store).to_be_greater_than(0)
        expect(cache_receipt).to_be_greater_than(cache_store)
        expect(identity).to_be_greater_than(cache_receipt)
        expect(layout).to_be_greater_than(identity)
        expect(guard).to_be_greater_than(layout)
        expect(end).to_be_greater_than(guard)

        val guarded = retained.substring(guard, end)
        for field in ["validation_module_array", "validation_module_blobs",
                "validation_module_has_rt_hal", "validation_module_claim_counts"]:
            val assignment = "self.ctx." + field + " ="
            expect(retained.split(assignment).len()).to_equal(2)
            expect(guarded).to_contain(assignment)
        expect(guarded).to_contain("hir_module_encode_retained_v1(hir_module_copy)")
        expect(guarded).to_contain("hir_module_has_rt_hal(hir_module)")
        expect(guarded).to_contain("rt_criticality_claim_keys().len()")
        # Every executable statement after the guard remains nested under it;
        # a dedented blob/fact write must fail even if the guard still exists.
        val lines = guarded.split("\n")
        var index = 2
        while index < lines.len():
            val line = lines[index]
            if line.trim() != "" and not line.trim().starts_with("#"):
                expect(line.starts_with("                        ")).to_equal(true)
            index = index + 1

        val receipts = retained.substring(cache_receipt, guard)
        expect(receipts).to_contain("phase_hir_modules[name] = hir_module")
        expect(receipts).to_contain("Missing immutable source receipt for {name}")
        expect(receipts).to_contain("Missing module surface alias for {name}")
        expect(receipts).to_contain("Invalid module surface index for {name}: {validation_surface_index}")
        expect(receipts).to_contain("validation_module_keys = validation_module_keys.push(")
        expect(receipts).to_contain("value_struct_layout_declarations_v1(")
