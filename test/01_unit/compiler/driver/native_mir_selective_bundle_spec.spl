# Run this transport spec in its own process: frontend cache producer identity
# is intentionally memoized for the lifetime of a real compiler process.
# @req REQ-MIR-SELECTIVE-IMMUTABLE-TRANSPORT
use std.spec.*
use std.spec.step
use std.env.variables.{env_get, env_has, env_set, env_unset}
use std.io_runtime.{dir_create_all, dir_remove_all, file_read, file_write, file_delete, file_exists, getpid}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirAopAdvice}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_mir_selective_producer_v1.{driver_mir_selective_write_v1}
use compiler.driver.cache.cold_hir_semantic_seed_v1.{cold_hir_typed_receipt_from_admitted_entry_v1}
use compiler.driver.action_graph.demand_compile_integration.{demand_compile_begin_v1}
use compiler.driver.cache.package_index_route.{PackageIndexRouteV1}
use compiler.driver.backend.demand_backend_plan.{DemandBackendIdentityV1,
    PrecompiledPlatformIdentityV1, ForegroundBackendBudgetV1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1,
    CompileSourceInventoryV1, compile_source_inventory_event_from_content_v1,
    compile_source_inventory_digest_v1}
use compiler.driver.driver_build.native_mir_selective_bundle_v1.*
use compiler.driver.driver_build.native_mir_selective_manifest_envelope_v1.{native_mir_selective_job_count_v1}

class SelectiveBundleFixtureV1:
    directory: text
    names: [text]
    present: [bool]
    previous: [text]

    static fn create(tag: text) -> SelectiveBundleFixtureV1:
        val names = ["SIMPLE_HIR_CACHE", "SIMPLE_HIR_CACHE_DIR", "SIMPLE_FRONTEND_CACHE",
            "SIMPLE_FRONTEND_CACHE_SCOPE", "SIMPLE_MIR_SELECTIVE_DISK_BYTES"]
        var present: [bool] = []
        var previous: [text] = []
        for name in names:
            present.push(env_has(name))
            previous.push(env_get(name))
        val directory = "build/test_tmp/mir-selective-{tag}-{getpid()}"
        expect(dir_remove_all(directory)).to_equal(true)
        expect(dir_create_all(directory)).to_equal(true)
        expect(env_set(names[0], "1")).to_equal(true)
        expect(env_set(names[1], directory + "/artifacts")).to_equal(true)
        expect(env_set(names[2], "1")).to_equal(true)
        expect(env_set(names[3], "mir-selective-transport-unit-producer-v1")).to_equal(true)
        expect(env_set(names[4], "536870912")).to_equal(true)
        SelectiveBundleFixtureV1(directory: directory, names: names, present: present, previous: previous)

    fn cleanup():
        var index = 0
        while index < self.names.len():
            if self.present[index]:
                expect(env_set(self.names[index], self.previous[index])).to_equal(true)
            else:
                expect(env_unset(self.names[index])).to_equal(true)
            index = index + 1
        expect(dir_remove_all(self.directory)).to_equal(true)

fn selective_actual_source_v1(number: i64) -> text:
    "fn compute() -> i64:\n    {number}\n"

fn selective_actual_module_v1(name: text, number: i64) -> HirModule:
    val source = selective_actual_source_v1(number)
    val ast = parse_full_frontend(source,
        "src/{name}.spl", name, Logger(level: 0))
    var lowering = HirLowering.with_filename("src/{name}.spl")
    val module = lowering.lower_module(ast)
    expect(lowering.errors.len()).to_equal(0)
    module

fn selective_publish_actual_v1(dir: text, name: text, module: HirModule,
        source: text) -> NativeMirSelectiveRowV1:
    expect(transient_scope_begin()).to_equal(true)
    val written = native_mir_selective_write_module_in_owned_scope_v1(dir,
        sha256_text("source"), sha256_text("context"), name, module, source.len(),
        native_mir_selective_source_binding_v1(name, module.path, sha256_text(source), source.len()))
    expect(transient_scope_pause()).to_equal(true)
    expect(transient_promote(written)).to_equal(true)
    expect(hir_cache_promote_diagnostic_owner_v1()).to_equal(true)
    hir_cache_clear_last_warnings()
    expect(transient_scope_end()).to_equal(true)
    expect(written.is_ok()).to_equal(true)
    written.unwrap()

fn selective_seal_v1(dir: text, providers: [NativeMirSelectiveRowV1], emissions: [NativeMirSelectiveRowV1],
        source_order: [text] = []):
    val written = native_mir_selective_write_manifest_v1(dir, sha256_text("source"),
        sha256_text("context"), providers, emissions, source_order)
    expect(written.is_ok()).to_equal(true)
    expect(written.unwrap()).to_equal(true)

describe "immutable selective MIR post-mono body transport":
    it "binds a resealed source barrier order to a different exact manifest identity":
        step("changes manifest identity when an admitted source barrier order changes")
        val fixture = SelectiveBundleFixtureV1.create("manifest-identity")
        val dir = fixture.directory + "/bundle"
        val first = selective_publish_actual_v1(dir, "identity.first", selective_actual_module_v1("identity.first", 3), selective_actual_source_v1(3))
        val second = selective_publish_actual_v1(dir, "identity.second", selective_actual_module_v1("identity.second", 5), selective_actual_source_v1(5))
        var entry = first
        entry.is_entry = true
        selective_seal_v1(dir, [first, second], [entry, second], ["identity.first", "identity.second"])
        val before = native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context"))
        expect(before.is_ok()).to_equal(true)
        val original = file_read(dir + "/selective.manifest")
        val original_cut = original.rfind("seal ")
        expect(original_cut > 0).to_equal(true)
        expect(before.unwrap().manifest_identity).to_equal(sha256_text(original.substring(0, original_cut)))
        val changed = original.replace("source-order\tidentity.first\tidentity.second\n",
            "source-order\tidentity.second\tidentity.first\n")
        expect(changed != original).to_equal(true)
        val cut = changed.rfind("seal ")
        val covered = changed.substring(0, cut)
        expect(file_write(dir + "/selective.manifest", covered + "seal {sha256_text(covered)}\n")).to_equal(true)
        val after = native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context"))
        expect(after.is_ok()).to_equal(true)
        expect(after.unwrap().source_order).to_equal(["identity.second", "identity.first"])
        expect(after.unwrap().manifest_identity).to_equal(sha256_text(covered))
        expect(after.unwrap().manifest_identity != before.unwrap().manifest_identity).to_equal(true)
        # All declarations are unchanged: the exact manifest order is the
        # additional identity input required by object/ledger admission.
        expect(after.unwrap().declarations.authority).to_equal(before.unwrap().declarations.authority)
        fixture.cleanup()

    it "refuses a real cold typed receipt populated after early worker admission":
        step("refuses late cold typed HIR ownership before publishing a manifest")
        val fixture = SelectiveBundleFixtureV1.create("late-cold")
        val source = selective_actual_source_v1(47)
        val module = selective_actual_module_v1("late.cold", 47)
        val event = compile_source_inventory_event_from_content_v1("fixture", "upsert", "late.cold.spl", source)
        val input = CompileSourceInventoryEntryV1(event.source_identity, event.content_digest,
            event.semantic_digest, event.export_digest, event.initializer_digest, event.provider_digest, event.byte_count)
        val inventory = CompileSourceInventoryV1(schema_version: 1, generation: 1, entries: [input])
        val receipt = cold_hir_typed_receipt_from_admitted_entry_v1(module, "src", "late.cold.spl",
            source, compile_source_inventory_digest_v1(inventory), input)
        expect(receipt.is_ok()).to_equal(true)
        var driver = CompilerDriver.create(CompileOptions.default())
        driver.ctx.cold_hir_typed_receipts = [receipt.unwrap()]
        val dir = fixture.directory + "/bundle"
        val result = driver_mir_selective_write_v1(driver, dir)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_equal("selective MIR cannot transport late cold typed HIR receipts")
        expect(file_exists(dir + "/selective.manifest")).to_equal(false)
        fixture.cleanup()

    it "refuses late demand execution even when its original route was refused":
        step("refuses a late demand execution owner independently of its validity verdict")
        val fixture = SelectiveBundleFixtureV1.create("late-demand")
        val route = PackageIndexRouteV1(valid: false, reason: "fixture route not admitted",
            source_paths: [], dirty_modules: [], package_schedule: [], archive_admissions: [])
        val identity = DemandBackendIdentityV1(snapshot_revision: "", snapshot_tree_digest: "",
            snapshot_inventory_digest: "", semantic_digest: "", target_triple: "", variant_digest: "",
            platform: PrecompiledPlatformIdentityV1("", "", "", ""))
        val budget = ForegroundBackendBudgetV1(priority: 0, memory_bytes: 1, deadline_millis: 1, cancelled: false)
        val execution = demand_compile_begin_v1(route, identity, budget, false, false, false, 0)
        expect(execution.valid).to_equal(false)
        var driver = CompilerDriver.create(CompileOptions.default())
        driver.ctx.demand_compile_execution = Some(execution)
        val dir = fixture.directory + "/bundle"
        val result = driver_mir_selective_write_v1(driver, dir)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_equal("selective MIR cannot transport late demand execution ownership")
        expect(file_exists(dir + "/selective.manifest")).to_equal(false)
        fixture.cleanup()

    it "refuses actual closure AOP advice before publishing provider bodies":
        step("refuses AOP advice that still requires the complete post-MIR HIR inventory")
        val fixture = SelectiveBundleFixtureV1.create("aop-refusal")
        val dir = fixture.directory + "/bundle"
        var module = selective_actual_module_v1("aop.body", 7)
        module.aop_advices = [HirAopAdvice(predicate_text: "calls(*)", advice_function: "audit",
            form: "before", priority: 0, span: Span.empty())]
        val source = selective_actual_source_v1(7)
        expect(transient_scope_begin()).to_equal(true)
        val written = native_mir_selective_write_module_in_owned_scope_v1(dir,
            sha256_text("source"), sha256_text("context"), "aop.body", module, source.len(),
            native_mir_selective_source_binding_v1("aop.body", module.path, sha256_text(source), source.len()))
        expect(written.is_err()).to_equal(true)
        expect(transient_scope_end()).to_equal(true)
        expect(file_exists(native_mir_selective_body_path_v1(dir, "aop.body"))).to_equal(false)
        expect(file_exists(dir + "/selective.manifest")).to_equal(false)
        fixture.cleanup()

    it "retains independent full provider order and physical emission order":
        step("retains full provider inventory and actual physical emission order")
        val fixture = SelectiveBundleFixtureV1.create("orders")
        val dir = fixture.directory + "/bundle"
        val first = selective_publish_actual_v1(dir, "provider.first", selective_actual_module_v1("provider.first", 11), selective_actual_source_v1(11))
        val second = selective_publish_actual_v1(dir, "entry.second", selective_actual_module_v1("entry.second", 19), selective_actual_source_v1(19))
        var entry = second
        entry.is_entry = true
        selective_seal_v1(dir, [first, second], [entry, first], ["entry.second", "provider.first"])
        val loaded = native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context"))
        expect(loaded.is_ok()).to_equal(true)
        val bundle = loaded.unwrap()
        expect(bundle.declarations.ordered_modules).to_equal(["provider.first", "entry.second"])
        expect(bundle.source_order).to_equal(["entry.second", "provider.first"])
        expect(bundle.rows[0].lookup_name).to_equal("entry.second")
        expect(bundle.rows[0].is_entry).to_equal(true)
        expect(bundle.rows[1].is_entry).to_equal(false)
        expect(native_mir_selective_job_count_v1(dir).unwrap()).to_equal(2)
        expect(native_mir_selective_provider_row_v1(bundle, "provider.first").unwrap().body_digest).to_equal(first.body_digest)
        fixture.cleanup()

    it "decodes the exact complete body only inside its consumer owned scope":
        step("decodes only the claimed module body in an owned scratch scope")
        val fixture = SelectiveBundleFixtureV1.create("body")
        val dir = fixture.directory + "/bundle"
        val module = selective_actual_module_v1("actual.body", 23)
        val provider = selective_publish_actual_v1(dir, "actual.body", module, selective_actual_source_v1(23))
        var entry = provider
        entry.is_entry = true
        selective_seal_v1(dir, [provider], [entry])
        val bundle = native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context")).unwrap()
        expect(native_mir_selective_load_body_in_owned_scope_v1(dir, bundle, entry).is_err()).to_equal(true)
        expect(transient_scope_begin()).to_equal(true)
        val body = native_mir_selective_load_body_in_owned_scope_v1(dir, bundle, entry)
        expect(body.is_ok()).to_equal(true)
        expect(hir_module_encode(body.unwrap())).to_equal(hir_module_encode(module))
        expect(body.unwrap().functions.len()).to_equal(1)
        expect(transient_scope_end()).to_equal(true)
        fixture.cleanup()

    it "refuses a changed complete body even while its declaration record is unchanged":
        step("refuses complete body bytes that differ from the frozen declaration digest")
        val fixture = SelectiveBundleFixtureV1.create("tamper-body")
        val dir = fixture.directory + "/bundle"
        val provider = selective_publish_actual_v1(dir, "tamper.body", selective_actual_module_v1("tamper.body", 29), selective_actual_source_v1(29))
        var entry = provider
        entry.is_entry = true
        selective_seal_v1(dir, [provider], [entry])
        val bundle = native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context")).unwrap()
        expect(file_write(native_mir_selective_body_path_v1(dir, provider.lookup_name), "changed body\n")).to_equal(true)
        expect(transient_scope_begin()).to_equal(true)
        expect(native_mir_selective_load_body_in_owned_scope_v1(dir, bundle, entry).is_err()).to_equal(true)
        expect(transient_scope_end()).to_equal(true)
        fixture.cleanup()

    it "refuses another source identity, another context and a damaged manifest seal":
        step("refuses source/context substitutions and damaged completeness seals")
        val fixture = SelectiveBundleFixtureV1.create("manifest")
        val dir = fixture.directory + "/bundle"
        val provider = selective_publish_actual_v1(dir, "manifest.body", selective_actual_module_v1("manifest.body", 31), selective_actual_source_v1(31))
        var entry = provider
        entry.is_entry = true
        selective_seal_v1(dir, [provider], [entry])
        expect(native_mir_selective_load_bundle_v1(dir, sha256_text("other source"), sha256_text("context")).is_err()).to_equal(true)
        expect(native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("other context")).is_err()).to_equal(true)
        val manifest = file_read(dir + "/selective.manifest")
        expect(file_write(dir + "/selective.manifest", manifest + "suffix\n")).to_equal(true)
        expect(native_mir_selective_job_count_v1(dir).is_err()).to_equal(true)
        expect(native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context")).is_err()).to_equal(true)
        fixture.cleanup()

    it "refuses a changed declaration record and a missing provider body":
        step("refuses incomplete or changed provider artifacts before body admission")
        val fixture = SelectiveBundleFixtureV1.create("declaration")
        val dir = fixture.directory + "/bundle"
        val provider = selective_publish_actual_v1(dir, "declaration.body", selective_actual_module_v1("declaration.body", 37), selective_actual_source_v1(37))
        var entry = provider
        entry.is_entry = true
        selective_seal_v1(dir, [provider], [entry])
        val path = native_mir_selective_declaration_path_v1(dir, provider.lookup_name)
        val original = file_read(path)
        expect(file_write(path, original + "corruption\n")).to_equal(true)
        expect(native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context")).is_err()).to_equal(true)
        expect(file_write(path, original)).to_equal(true)
        expect(file_delete(native_mir_selective_body_path_v1(dir, provider.lookup_name))).to_equal(true)
        expect(native_mir_selective_load_bundle_v1(dir, sha256_text("source"), sha256_text("context")).is_err()).to_equal(true)
        fixture.cleanup()

    it "refuses replacing an immutable provider artifact with another complete body":
        step("refuses rewriting an already published complete provider body")
        val fixture = SelectiveBundleFixtureV1.create("immutable")
        val dir = fixture.directory + "/bundle"
        val provider = selective_publish_actual_v1(dir, "immutable.body", selective_actual_module_v1("immutable.body", 41), selective_actual_source_v1(41))
        val changed = selective_actual_module_v1("immutable.body", 43)
        val changed_source = selective_actual_source_v1(43)
        expect(transient_scope_begin()).to_equal(true)
        val written = native_mir_selective_write_module_in_owned_scope_v1(dir, sha256_text("source"),
            sha256_text("context"), provider.lookup_name, changed, changed_source.len(),
            native_mir_selective_source_binding_v1(provider.lookup_name, changed.path, sha256_text(changed_source), changed_source.len()))
        expect(written.is_err()).to_equal(true)
        expect(transient_scope_end()).to_equal(true)
        expect(sha256_text(file_read(native_mir_selective_body_path_v1(dir, provider.lookup_name)))).to_equal(provider.body_digest)
        fixture.cleanup()
