"""
# MIR Optional Inner Discriminant

Requires staged diagnostics to classify an Optional payload before recursive
MIR type lowering and to inspect a symbol only after proving Named ownership.
"""

extern fn rt_file_read_text(path: text) -> text

describe "MIR Optional Inner Discriminant":
    it "records inner kind references and guards Named payload extraction":
        val source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""
        expect(source).to_contain("[mir-optional-inner] actual={{inner_actual_disc}}")
        expect(source).to_contain("if inner_actual_disc == inner_named_disc:")
        expect(source).to_contain("case HirTypeKind.Named(inner_symbol, _):")
        expect(source).to_contain("inner_symbol_id = self.symbol_id_value(inner_symbol)")
        expect(source).to_contain("val any_type_disc = rt_enum_discriminant(HirTypeKind.Any)")
        expect(source).to_contain("if rt_enum_discriminant(type_.kind) == any_type_disc:")
        expect(source).to_contain("return MirType.i64()")
