use std.spec
use compiler.driver.driver_build.native_link_receipt_v1.{native_link_key_v1,
    native_link_receipt_render_v1, native_link_receipt_output_digest_v1}

val D1: text = "1111111111111111111111111111111111111111111111111111111111111111"
val D2: text = "2222222222222222222222222222222222222222222222222222222222222222"

describe "native link receipt":
    it "keys on object content digests in link order":
        val a = native_link_key_v1([D1, D2], "out/app", "opt=3", [])
        expect(native_link_key_v1([D1, D2], "out/app", "opt=3", [])).to_equal(a)
        expect(native_link_key_v1([D2, D1], "out/app", "opt=3", []) != a).to_equal(true)

    it "changes the key for any other link input":
        val a = native_link_key_v1([D1], "out/app", "opt=3", [])
        expect(native_link_key_v1([D2], "out/app", "opt=3", []) != a).to_equal(true)
        expect(native_link_key_v1([D1], "out/other", "opt=3", []) != a).to_equal(true)
        expect(native_link_key_v1([D1], "out/app", "opt=2", []) != a).to_equal(true)
        expect(native_link_key_v1([D1], "out/app", "opt=3", ["libsimple.a=" + D2]) != a).to_equal(true)

    it "admits a receipt only for the exact key":
        val key = native_link_key_v1([D1], "out/app", "opt=3", [])
        val receipt = native_link_receipt_render_v1(key, D2)
        expect(native_link_receipt_output_digest_v1(receipt, key)).to_equal(D2)
        val other = native_link_key_v1([D2], "out/app", "opt=3", [])
        expect(native_link_receipt_output_digest_v1(receipt, other)).to_equal("")

    it "rejects a truncated receipt":
        val key = native_link_key_v1([D1], "out/app", "opt=3", [])
        val receipt = native_link_receipt_render_v1(key, D2)
        expect(native_link_receipt_output_digest_v1(receipt.substring(0, receipt.len() - 3), key)).to_equal("")
