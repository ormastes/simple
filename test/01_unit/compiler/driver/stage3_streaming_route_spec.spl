"""Focused Stage-3 streaming ownership routing and layer-parity contracts."""

use std.spec.{describe, it, expect}
use std.io.{file_read}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.common.string_core.{char_from_code}
use compiler.driver.driver_phase_gates.{driver_streaming_surface_gate_values}
use compiler.semantics.layer_call_wiring.{check_loaded_project_layer_calls}

val PARSING = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"
val ORCHESTRATION = "src/compiler/80.driver/driver_orchestration.spl"
val HIR_LOWERING = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
val BOOTSTRAP_MAIN = "src/app/cli/bootstrap_main.spl"
val BOOTSTRAP_FIXED = "src/compiler/80.driver/bootstrap_api_fixed.spl"
val DRIVER = "src/compiler/80.driver/driver.spl"
val SURFACE_TYPES = "src/compiler/20.hir/hir_lowering/module_surface_types.spl"
val SURFACE_DECLARATIONS = "src/compiler/20.hir/hir_lowering/module_surface_declarations.spl"
val SURFACE_REGISTRY = "src/compiler/20.hir/hir_lowering/module_surface_registry.spl"
val SURFACE_SOURCE_IDENTITY = "src/compiler/20.hir/hir_lowering/module_surface_source_identity.spl"
val MODULE_LOWERING = "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl"
val FRONTEND = "src/compiler/frontend/frontend.spl"
val RT_VALIDATION = "src/compiler/semantics/rt_criticality_validation.spl"
val MIR_EXPR_DISPATCH = "src/compiler/mir/_MirLoweringExpr/expr_dispatch.spl"
val SHA512 = "src/std/common/crypto/sha512.spl"
val CRYPTO_TYPES = "src/std/common/crypto/types.spl"
val MATCH_DESUGARING = "src/compiler/20.hir/hir_lowering/_Expressions/match_desugaring.spl"

val OB = char_from_code(123)
val CB = char_from_code(125)
val FIXTURE_DIR = "src/lib/_stage3_streaming_layer_spec_fixture"
val CALLEE_PATH = FIXTURE_DIR + "/callee.spl"
val CALLEE_SOURCE = "fn helper_fn() -> i64:\n    1\n\nexport helper_fn\n"
val CALLER_SOURCE = "use std._stage3_streaming_layer_spec_fixture.callee." + OB + "helper_fn" + CB
    + "\n\nfn probe() -> i64:\n    helper_fn()\n"

fn setup_layer_fixture():
    dir_create_all(FIXTURE_DIR)
    file_write(CALLEE_PATH, CALLEE_SOURCE)

fn teardown_layer_fixture():
    file_delete(CALLEE_PATH)
    dir_remove_all(FIXTURE_DIR)

fn stage3_gate(
    coverage: bool,
    mcdc_mode: text,
    closure: text,
    entry: text,
    backend: text
) -> bool:
    driver_streaming_surface_gate_values(
        true, coverage, mcdc_mode, "1", closure, entry,
        "1", "0", "0", backend)

describe "Stage3 streaming route":
    it "is stable before and after the late entry-closure latch":
        expect(stage3_gate(false, "off", "0", "src/app/cli/bootstrap_main.spl", "llvm")).to_equal(true)
        expect(stage3_gate(false, "off", "1", "", "llvm")).to_equal(true)

    it "fails closed when the requested route has no entry authority":
        expect(stage3_gate(false, "off", "0", "", "llvm")).to_equal(false)
        val orchestration = file_read(ORCHESTRATION)
        expect(orchestration).to_contain("val stage3_streaming_requested_at_entry =")
        expect(orchestration).to_contain("error[E-DRV-STREAM-ROUTE-LOST]")
        val reject_pos = orchestration.index_of("if streaming_requested and not streaming_route:")
        val load_pos = orchestration.index_of("val (loaded_ctx, load_ok) = self.load_sources_impl()")
        expect(reject_pos).to_be_greater_than(0)
        expect(load_pos).to_be_greater_than(reject_pos)

    it "keeps one compile-owned route across phase boundaries":
        val orchestration = file_read(ORCHESTRATION)
        expect(orchestration).to_contain("val streaming_route = (streaming_requested and bootstrap_streaming and")
        expect(orchestration).to_contain("entry_ready and streaming_is_aot and streaming_coverage_off and")
        expect(orchestration).to_contain("streaming_mcdc_off and streaming_backend_safe)")
        expect(orchestration).not_to_contain("driver_streaming_surface_gate_values(")
        expect(orchestration).to_contain("self.parse_all_committing_routed_impl(streaming_route)")
        expect(orchestration).to_contain("self.lower_and_check_routed_impl(streaming_route)")
        val load_pos = orchestration.index_of("val (loaded_ctx, load_ok) = self.load_sources_impl()")
        val compatibility_pos = orchestration.index_of("me compile_vhdl_only()")
        val compile_tail = orchestration.substring(load_pos, compatibility_pos)
        expect(compile_tail).not_to_contain("driver_streaming_surface_enabled(self.ctx)")

    it "uses one receiver hop on the canonical ordinary wrapper":
        val driver = file_read(DRIVER)
        expect(driver).to_contain("pub fn compiler_driver_run_compile(driver: CompilerDriver) -> CompileResult:\n    driver.compile_routed(0)")
        expect(driver).not_to_contain("pub fn compiler_driver_run_compile(driver: CompilerDriver) -> CompileResult:\n    driver.compile()")

    it "routes Stage3 with one producer-local primitive mask":
        val bootstrap = file_read(BOOTSTRAP_MAIN)
        val mask_pos = bootstrap.index_of("var streaming_eligibility_mask: i64 = 1")
        val backend_pos = bootstrap.index_of("if backend != \"vhdl\":")
        val coverage_pos = bootstrap.index_of("if (env_get(\"SIMPLE_COVERAGE\") ?? \"\") != \"1\":")
        val mcdc_pos = bootstrap.index_of("if driver_streaming_mcdc_raw_is_off(env_get(\"SIMPLE_MCDC_MODE\") ?? \"\"):")
        val create_pos = bootstrap.index_of("val driver = compiler_driver_create(options)")
        val routed_pos = bootstrap.index_of("compiler_driver_run_compile_routed(driver, streaming_eligibility_mask)")
        expect(backend_pos).to_be_greater_than(mask_pos)
        expect(coverage_pos).to_be_greater_than(backend_pos)
        expect(mcdc_pos).to_be_greater_than(coverage_pos)
        expect(create_pos).to_be_greater_than(mcdc_pos)
        expect(routed_pos).to_be_greater_than(create_pos)
        expect(bootstrap).to_contain("else:\n        compiler_driver_run_compile(driver)")

    it "routes Stage4 with the same one-scalar contract":
        val producer = file_read(BOOTSTRAP_FIXED)
        val mask_pos = producer.index_of("var streaming_eligibility_mask: i64 = 1")
        val backend_pos = producer.index_of("if backend != \"vhdl\":")
        val coverage_pos = producer.index_of("if (env_get(\"SIMPLE_COVERAGE\") ?? \"\") != \"1\":")
        val mcdc_pos = producer.index_of("if driver_streaming_mcdc_raw_is_off(env_get(\"SIMPLE_MCDC_MODE\") ?? \"\"):")
        val create_pos = producer.index_of("val driver = compiler_driver_create(options)")
        val routed_pos = producer.index_of("compiler_driver_run_compile_routed(driver, streaming_eligibility_mask)")
        expect(backend_pos).to_be_greater_than(mask_pos)
        expect(coverage_pos).to_be_greater_than(backend_pos)
        expect(mcdc_pos).to_be_greater_than(coverage_pos)
        expect(create_pos).to_be_greater_than(mcdc_pos)
        expect(routed_pos).to_be_greater_than(create_pos)
        expect(producer).to_contain("else:\n        compiler_driver_run_compile(driver)")

    it "emits allocation-free fixed guard diagnostics":
        val orchestration = file_read(ORCHESTRATION)
        expect(orchestration).to_contain("E-DRV-STREAM-GUARD-BOOTSTRAP")
        expect(orchestration).to_contain("E-DRV-STREAM-GUARD-ENTRY")
        expect(orchestration).to_contain("E-DRV-STREAM-GUARD-AOT")
        expect(orchestration).to_contain("E-DRV-STREAM-GUARD-COVERAGE")
        expect(orchestration).to_contain("E-DRV-STREAM-GUARD-MCDC")
        expect(orchestration).to_contain("E-DRV-STREAM-GUARD-BACKEND")

    it "does not reuse a failed streaming owner for a legacy retry":
        val parsing = file_read(PARSING)
        val routed_parse = parsing.index_of("me parse_all_committing_routed_impl(streaming_route: bool)")
        val legacy_parse = parsing.index_of("val (parsed_ctx, parse_ok) = self.parse_all_legacy_impl()")
        val retry_body = parsing.substring(routed_parse, legacy_parse)
        expect(retry_body).to_contain("self.streaming_module_surfaces_owner = ModuleSurfacesByName.empty()")
        expect(retry_body).to_contain("self.streaming_surface_owner_ready = false")
        expect(retry_body).to_contain("self.ctx.module_surfaces = nil")
        val routed_end = parsing.index_of("# Compatibility entry for focused callers", routed_parse)
        val parse_routed_body = parsing.substring(routed_parse, routed_end)
        expect(parse_routed_body).to_contain("self.parse_all_legacy_impl()")
        expect(parse_routed_body).not_to_contain("driver_streaming_surface_enabled(self.ctx)")

        val hir = file_read(HIR_LOWERING)
        val routed_hir = hir.index_of("me lower_and_check_routed_impl(streaming_route: bool)")
        val compatibility_hir = hir.index_of("me lower_and_check_impl()")
        val hir_routed_body = hir.substring(routed_hir, compatibility_hir)
        expect(hir_routed_body).to_contain("if streaming_config_gate:")
        expect(hir_routed_body).not_to_contain("if streaming_ready_flag or streaming_config_gate:")
        val compatibility_body = hir.substring(compatibility_hir, hir.len())
        expect(compatibility_body).to_contain("self.streaming_surface_owner_ready")
        expect(compatibility_body).to_contain("self.streaming_module_surfaces_owner")
        expect(compatibility_body).not_to_contain("self.ctx.module_surfaces.unwrap()")

    it "retains positional entry surfaces in a direct driver owner":
        val parsing = file_read(PARSING)
        val entry_commit = parsing.index_of("self.ctx.modules = entry_modules")
        val entry_return = parsing.index_of("return (self.ctx, self.ctx.error_count_value == 0)", entry_commit)
        val entry_body = parsing.substring(entry_commit, entry_return)
        expect(entry_body).to_contain("self.streaming_module_surfaces_owner = entry_surfaces")
        expect(entry_body).to_contain("self.ctx.module_surfaces = Some(entry_surfaces)")

    it "retains the coverage MC/DC and VHDL exclusions":
        expect(stage3_gate(true, "off", "0", "entry.spl", "llvm")).to_equal(false)
        expect(stage3_gate(false, "on", "0", "entry.spl", "llvm")).to_equal(false)
        expect(stage3_gate(false, "dynamic", "0", "entry.spl", "llvm")).to_equal(false)
        expect(stage3_gate(false, "off", "0", "entry.spl", "vhdl")).to_equal(false)
        expect(driver_streaming_surface_gate_values(
            false, false, "off", "1", "0", "entry.spl",
            "1", "0", "0", "llvm")).to_equal(false)
        expect(driver_streaming_surface_gate_values(
            true, false, "off", "0", "0", "entry.spl",
            "1", "0", "0", "llvm")).to_equal(false)
        expect(driver_streaming_surface_gate_values(
            true, false, "off", "1", "1", "",
            "0", "0", "0", "llvm")).to_equal(false)

    it "retains the legacy Stage4 streaming conjunction":
        expect(driver_streaming_surface_gate_values(
            true, false, "off", "1", "1", "",
            "0", "1", "1", "llvm")).to_equal(true)
        expect(driver_streaming_surface_gate_values(
            true, false, "off", "1", "1", "",
            "0", "1", "0", "llvm")).to_equal(false)

    it "retains compact layer facts and promotes both before scope end":
        val parsing = file_read(PARSING)
        expect(parsing).to_contain("class StreamingLayerFactOwner:")
        expect(parsing).to_contain("rt_transient_heap_promote(tagged_layer)")
        expect(parsing).to_contain("rt_transient_heap_promote(layer_dag_edges)")
        expect(parsing).to_contain("val streaming_layer_violations = check_loaded_project_layer_calls(")
        expect(parsing).to_contain("val layer_call_violations = check_loaded_project_layer_calls(")

    it "keeps rich parse and builder aggregates behind rooted owners":
        val parsing = file_read(PARSING)
        val surface_types = file_read(SURFACE_TYPES)
        expect(surface_types).to_contain("class ModuleSurfaceBuilder:")
        expect(surface_types).not_to_contain("struct ModuleSurfaceBuilder:")
        expect(parsing).to_contain(
            "val module_owner = parse_full_frontend_streaming_owner_diagnostic(")
        expect(parsing).not_to_contain("ModuleSurfaceParserOwner.new(module)")
        expect(parsing).to_contain("class StreamingSurfaceBuilderOwner:")
        expect(parsing).to_contain("builder_owner: StreamingSurfaceBuilderOwner")
        expect(parsing).to_contain(") -> bool:")
        expect(parsing).not_to_contain(") -> Result<ModuleSurfaceBuilder, text>:")
        expect(parsing).not_to_contain("builder = parsed_result.unwrap()")
        expect(parsing).not_to_contain("var owned = self.value")
        expect(parsing).to_contain("val projection_owner = ModuleSurfaceProjectionOwner.new()")
        expect(parsing).to_contain("module_surface_from_parser_owner_into(")
        expect(parsing).not_to_contain("val surface_result = module_surface_from_parser_owner(")
        val declarations = file_read(SURFACE_DECLARATIONS)
        val into_start = declarations.index_of("pub fn module_surface_from_parser_owner_into(")
        val wrapper_start = declarations.index_of("pub fn module_surface_from_parser_owner(\n", into_start)
        val into_body = declarations.substring(into_start, wrapper_start)
        expect(into_body).to_contain("output.surface = ModuleSurface(")
        expect(into_body).not_to_contain("Some(ModuleSurface(")
        expect(into_body).to_contain("var compact_imports: [ParserImport] = []")
        expect(into_body).to_contain("var compact_items: [ImportItem] = []")
        expect(into_body).to_contain("module: import_decl.module")
        expect(into_body).to_contain("name: import_item.name")
        expect(into_body).to_contain("has_alias: import_item.has_alias")
        expect(into_body).to_contain("alias: import_alias")
        expect(into_body).to_contain("items: compact_items")
        expect(into_body).to_contain("is_lazy: import_decl.is_lazy")
        expect(into_body).to_contain("span: Span.empty()")
        expect(into_body).to_contain("var compact_exports: [Export] = []")
        expect(into_body).to_contain("items: export_decl.items.copy()")
        expect(into_body).to_contain("import_alias = if import_item.has_alias")
        expect(into_body).to_contain("import_item_has_alias.push(import_item.has_alias)")
        val compact_items = into_body.index_of("var compact_items: [ImportItem] = []")
        val item_loop = into_body.index_of(
            "for import_item in import_decl.items:", compact_items)
        val normalized_alias = into_body.index_of(
            "val import_alias = if import_item.has_alias: import_item.alias else: \"\"",
            item_loop)
        val compact_item_push = into_body.index_of(
            "compact_items = compact_items.push(ImportItem(", compact_items)
        val compact_import_push = into_body.index_of(
            "compact_imports = compact_imports.push(ParserImport(", compact_item_push)
        # A glob import has no loop iterations and therefore retains an empty
        # compact item array. Named imports append in source order, and an
        # absent alias cannot outrank the original name via stale alias text.
        expect(item_loop).to_be_greater_than(compact_items)
        expect(normalized_alias).to_be_greater_than(item_loop)
        expect(compact_item_push).to_be_greater_than(normalized_alias)
        expect(compact_import_push).to_be_greater_than(compact_item_push)
        expect(into_body).to_contain("imports: compact_imports")
        expect(into_body).to_contain("exports: compact_exports")
        expect(into_body).not_to_contain("imports: owner.value.imports")
        expect(into_body).not_to_contain("exports: owner.value.exports")
        expect(into_body).to_contain("for impl_ in owner.value.impls:")
        expect(into_body).to_contain("module_surface_impl_from_impl(impl_)")
        expect(into_body).not_to_contain("impls: owner.value.impls")
        expect(into_body).not_to_contain("Result<ModuleSurface, text>")
        expect(into_body).not_to_contain("module_surface_from_parser_owner(")
        expect(into_body).not_to_contain("result.unwrap()")
        val wrapper_body = declarations.substring(wrapper_start, declarations.len())
        expect(wrapper_body).to_contain("module_surface_from_parser_owner_into(")
        val registry = file_read(SURFACE_REGISTRY)
        val promote_start = registry.index_of("pub fn module_surface_promote(")
        val promote_end = registry.index_of("pub fn module_surfaces_promote(", promote_start)
        val promote_body = registry.substring(promote_start, promote_end)
        expect(promote_body).to_contain("surface.callables = {}")
        expect(promote_body).to_contain("surface.composites = {}")
        expect(promote_body).to_contain("surface.enums = {}")
        expect(promote_body).to_contain("surface.traits = {}")
        expect(promote_body).to_contain("surface.type_aliases = {}")
        expect(promote_body).to_contain("surface.constants = {}")
        expect(promote_body).to_contain("surface.export_origins = {}")
        expect(promote_body).to_contain(
            "_module_surface_promote_last_failure = \"surface\"")
        # Required resolution indexes must survive the construction-Dict drop.
        expect(promote_body).not_to_contain("surface.export_origin_index =")
        expect(promote_body).not_to_contain("surface.declaration_authority_index =")
        val lowering = file_read(MODULE_LOWERING)
        val decl_index_start = lowering.index_of("me build_surface_decl_index():")
        val decl_index_end = lowering.index_of(
            "me surface_decl_owner_indices", decl_index_start)
        val decl_index = lowering.substring(decl_index_start, decl_index_end)
        expect(decl_index).to_contain("case 0: surface.callable_names")
        expect(decl_index).to_contain("case 1: surface.composite_names")
        expect(decl_index).to_contain("case 2: surface.enum_names")
        expect(decl_index).to_contain("case 3: surface.trait_names")
        expect(decl_index).to_contain("case 4: surface.type_alias_names")
        expect(decl_index).to_contain("case _: surface.constant_names")
        expect(decl_index).not_to_contain(".keys()")
        val identity = file_read(SURFACE_SOURCE_IDENTITY)
        expect(identity).to_contain("surface.callable_names.len()")
        expect(identity).to_contain(
            "module_surface_name_position(surface.callable_names, name)")
        expect(identity).not_to_contain("surface.callables.contains_key(name)")

    it "keeps all Cycle6 unresolved-name authority mappings explicit":
        val parsing = file_read(PARSING)
        val declarations = file_read(SURFACE_DECLARATIONS)
        val into_start = declarations.index_of(
            "pub fn module_surface_from_parser_owner_into(")
        val wrapper_start = declarations.index_of(
            "pub fn module_surface_from_parser_owner(\n", into_start)
        val into_body = declarations.substring(into_start, wrapper_start)
        val identity = file_read(SURFACE_SOURCE_IDENTITY)
        val frontend = file_read(FRONTEND)
        expect(frontend).to_contain(
            "parser_types.{ParserModule, ParserModuleOwner, DomainBlock}")
        val rt_validation = file_read(RT_VALIDATION)
        val profile_start = rt_validation.index_of("if rt_critical_profile(profile):")
        val profile_end = rt_validation.index_of(
            "# Non-flat/full frontend routes", profile_start)
        val profile_body = rt_validation.substring(profile_start, profile_end)
        expect(profile_body).to_contain(
            "val hal_facts = rt_hal_facts_with_reviewed_intrinsic(root_id, facts)")
        expect(profile_body).to_contain(
            "            else:\n                val hal_facts = " +
            "rt_hal_facts_with_reviewed_intrinsic(root_id, facts)\n" +
            "                for d in rt_admit_with_manifest(root_id, hal_facts): " +
            "diagnostics.push(d)")
        expect(profile_body).not_to_contain(
            "            else:\n            val hal_facts")
        expect(profile_body).to_contain("admitted_roots[root_id] = true")
        val mir_dispatch = file_read(MIR_EXPR_DISPATCH)
        expect(mir_dispatch).to_contain(
            "self.folded_global_scalar_type(constant)")
        expect(mir_dispatch).to_contain(
            "self.folded_global_scalar_type(mir_const)")
        expect(mir_dispatch).not_to_contain(
            "val corrected_type = folded_global_scalar_type(constant)")
        val sha512 = file_read(SHA512)
        val crypto_types = file_read(CRYPTO_TYPES)
        expect(sha512).to_contain(
            "use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}")
        expect(crypto_types).to_contain(
            "pub(package) fn crypto_text_to_bytes(s: text) -> [i64]:")
        expect(crypto_types).to_contain(
            "pub(package) fn bytes_to_hex(bytes: [i64]) -> text:")
        # Same-package leaf helpers stay package-local; name-array declaration
        # indexing, not API widening, supplies their retained surface authority.
        expect(crypto_types).not_to_contain(
            "pub fn crypto_text_to_bytes(s: text) -> [i64]:")
        expect(crypto_types).not_to_contain(
            "pub fn bytes_to_hex(bytes: [i64]) -> text:")
        expect(sha512.index_of(
            "use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}"))
            .to_be_greater_than(0)
        expect(sha512.index_of("fn sha512_text(data: text) -> text:"))
            .to_be_greater_than(sha512.index_of(
                "use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}"))
        expect(sha512.index_of(
            "use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}",
            sha512.index_of("fn sha512_text(data: text) -> text:")))
            .to_equal(-1)
        expect(into_body).to_contain("visibility: function_.visibility")
        expect(into_body).to_contain("callable_names = callable_names.push(name)")
        expect(identity).to_contain("segments[0:segments.len() - 1].join(\".\")")
        val hir_pipeline = file_read(HIR_LOWERING)
        val lower_start = hir_pipeline.index_of("me lower_streaming_surface_source(")
        val lower_end = hir_pipeline.index_of(
            "me lower_and_check_streaming_surfaces_impl", lower_start)
        val lower_body = hir_pipeline.substring(lower_start, lower_end)
        expect(lower_body).to_contain(
            "val module_owner = parse_full_frontend_streaming_owner(")
        expect(lower_body).to_contain(
            "lowering.lower_parser_module_owner_unstub(module_owner, is_entry)")
        expect(lower_body).not_to_contain("module_owner.value")
        expect(lower_body).not_to_contain("val module = parse_full_frontend(")
        val match_source = file_read(MATCH_DESUGARING)
        val flatten_start = match_source.index_of("me flatten_enum_match_arm(")
        val flatten_end = match_source.index_of("me build_match_expr(", flatten_start)
        val flatten_body = match_source.substring(flatten_start, flatten_end)
        expect(flatten_body).to_contain("rt_enum_discriminant(pat.kind)")
        expect(flatten_body).to_contain(
            "rt_enum_discriminant(HirPatternKind.Binding(SymbolId(id: -1), false))")
        expect(flatten_body).to_contain("case HirPatternPayload.Tuple(patterns):")
        expect(flatten_body).not_to_contain("match pat.kind:")
        val surface_error = parsing.index_of("builder_owner.retain_error(projection_owner.error)")
        val surface_end = parsing.index_of("val _ended = driver_end_transient_parse_scope()", surface_error)
        expect(surface_end).to_be_greater_than(surface_error)
        val finish_fail = parsing.index_of("if not builder_owner.finish_into(retained_surfaces):")
        val finish_pause = parsing.index_of("if not rt_transient_array_scope_pause():", finish_fail)
        val finish_retain = parsing.index_of("builder_owner.retain_error(builder_owner.error)", finish_pause)
        val finish_end = parsing.index_of("val _ended = rt_transient_array_scope_end()", finish_retain)
        val finish_read = parsing.index_of("Module surface alignment error: {builder_owner.error}", finish_end)
        expect(finish_pause).to_be_greater_than(finish_fail)
        expect(finish_retain).to_be_greater_than(finish_pause)
        expect(finish_end).to_be_greater_than(finish_retain)
        expect(finish_read).to_be_greater_than(finish_end)

describe "Stage3 streaming layer parity":
    it "keeps bounded parse-owner checkpoints cached and ordered":
        val parsing = file_read(PARSING)
        val frontend = file_read(FRONTEND)
        expect(parsing).to_contain(
            "rt_env_get(\"SIMPLE_DEBUG_STAGE3_PARSE_OWNER\")")
        val debug_env = parsing.index_of(
            "rt_env_get(\"SIMPLE_DEBUG_STAGE3_PARSE_OWNER\")")
        expect(parsing.index_of(
            "rt_env_get(\"SIMPLE_DEBUG_STAGE3_PARSE_OWNER\")", debug_env + 1))
            .to_equal(-1)
        expect(parsing).to_contain("debug_parse_source, source_index")
        expect(parsing).to_contain(
            "val debug_parse_source = debug_parse_owner and source_index < 128")
        expect(frontend).not_to_contain(
            "rt_env_get(\"SIMPLE_DEBUG_STAGE3_PARSE_OWNER\")")
        expect(frontend).to_contain("if debug_owner:")
        val pre_scope = parsing.index_of("stage=driver-pre-scope")
        val parse_call = parsing.index_of(
            "parse_full_frontend_streaming_owner_diagnostic(", pre_scope)
        val post_end = parsing.index_of("stage=driver-post-end", parse_call)
        expect(parse_call).to_be_greater_than(pre_scope)
        expect(post_end).to_be_greater_than(parse_call)
        val pre_preprocess = frontend.index_of("stage=frontend-pre-preprocess")
        val post_preprocess = frontend.index_of("stage=frontend-post-preprocess")
        val pre_outline = frontend.index_of("stage=frontend-pre-outline")
        val post_outline = frontend.index_of("stage=frontend-post-outline")
        val pre_bridge = frontend.index_of("stage=frontend-pre-parse-or-restore")
        val post_bridge = frontend.index_of("stage=frontend-post-parse-or-restore")
        val pre_desugar = frontend.index_of("stage=frontend-pre-desugar")
        val post_desugar = frontend.index_of("stage=frontend-post-desugar")
        val pre_owner = frontend.index_of("stage=frontend-pre-owner")
        val post_owner = frontend.index_of("stage=frontend-post-owner")
        expect(post_preprocess).to_be_greater_than(pre_preprocess)
        expect(pre_outline).to_be_greater_than(post_preprocess)
        expect(post_outline).to_be_greater_than(pre_outline)
        expect(pre_bridge).to_be_greater_than(post_outline)
        expect(post_bridge).to_be_greater_than(pre_bridge)
        expect(pre_desugar).to_be_greater_than(post_bridge)
        expect(post_desugar).to_be_greater_than(pre_desugar)
        expect(pre_owner).to_be_greater_than(post_desugar)
        expect(post_owner).to_be_greater_than(pre_owner)

    it "reports the same invalid whole-project edge through the shared checker":
        setup_layer_fixture()
        val result = check_loaded_project_layer_calls(
            ["stage3_streaming_caller.spl", CALLEE_PATH],
            [CALLER_SOURCE, CALLEE_SOURCE],
            ["gui", "draw"],
            ["D:gui", "D:draw"])
        teardown_layer_fixture()
        expect(result.len()).to_equal(1)
        expect(result[0]).to_contain("error[layer_call]")

    it "accepts the same edge when the project DAG permits it":
        setup_layer_fixture()
        val result = check_loaded_project_layer_calls(
            ["stage3_streaming_caller.spl", CALLEE_PATH],
            [CALLER_SOURCE, CALLEE_SOURCE],
            ["gui", "draw"],
            ["D:gui\nE:gui>draw", "D:draw"])
        teardown_layer_fixture()
        expect(result.len()).to_equal(0)
