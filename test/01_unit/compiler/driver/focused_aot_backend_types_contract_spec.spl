use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused AOT backend types closure contract":
    it "keeps mode-only backend result edges lazy":
        val driver = file_read("src/compiler/80.driver/driver.spl")
        val types = file_read("src/compiler/80.driver/driver_types.spl")
        val pipeline = file_read("src/compiler/80.driver/driver_pipeline.spl")
        val helpers = file_read("src/compiler/80.driver/driver_helpers.spl")
        val port = file_read("src/compiler/70.backend/backend_port.spl")
        expect(driver).to_contain("use lazy compiler.backend.backend_types.")
        expect(types).to_contain("use lazy compiler.backend.backend_types.")
        expect(pipeline.contains("compiler.backend.backend_types")).to_equal(false)
        expect(helpers.contains("compiler.backend.backend_types")).to_equal(false)
        expect(port.contains("compiler.backend.backend_types")).to_equal(false)
