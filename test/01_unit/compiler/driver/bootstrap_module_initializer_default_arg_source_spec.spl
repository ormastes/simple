extern fn rt_file_read_text(path: text) -> text

describe "bootstrap module initializer declared-default preservation":
    it "passes the semantic minus-one default explicitly on the bootstrap call":
        val lowering = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

        expect(lowering).to_contain("self.lower_runtime_module_initializers(module, const_vals, -1)")
        expect(lowering).to_contain("bootstrap_module_index: i64 = -1")
        expect(lowering.contains("self.lower_runtime_module_initializers(module, const_vals)\n")).to_equal(false)

