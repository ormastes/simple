use std.spec.*
use std.nogc_sync_mut.io_runtime.{file_read_nullable}
use compiler.driver.driver_hir_cache.{hir_cache_key}
use app.io.file_ops.{path_absolute}
use app.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{dir_create_all, file_write}

val LEFT = "test/fixtures/compiler/hir_cache_source_identity/left.spl"
val RIGHT = "test/fixtures/compiler/hir_cache_source_identity/right.spl"

describe "HIR cache physical source identity":
    it "separates equal source bytes at different physical paths":
        val left_source = file_read_nullable(LEFT)
        val right_source = file_read_nullable(RIGHT)
        expect(left_source != nil).to_equal(true)
        expect(right_source != nil).to_equal(true)
        expect(left_source).to_equal(right_source)
        val left_key = hir_cache_key(LEFT, "same-frozen-closure", false)
        val right_key = hir_cache_key(RIGHT, "same-frozen-closure", false)
        expect(left_key.len()).to_equal(64)
        expect(right_key.len()).to_equal(64)
        expect(left_key == right_key).to_equal(false)

    it "keeps repeated physical ownership stable and entry roles distinct":
        val module_key = hir_cache_key(LEFT, "same-frozen-closure", false)
        expect(module_key.len()).to_equal(64)
        expect(hir_cache_key(LEFT, "same-frozen-closure", false)).to_equal(module_key)
        expect(hir_cache_key(LEFT, "same-frozen-closure", true) == module_key).to_equal(false)

    it "refuses absent source bytes":
        expect(hir_cache_key(LEFT + ".absent", "same-frozen-closure", false)).to_equal("")

    it "shares one key across the sharded snapshot and direct checkout spellings":
        # Sharded HIR workers read an absolute SCV snapshot path, the direct
        # route a checkout path; the same repo-relative file is one owner.
        val stamp = time_now_unix_micros().to_string()
        val snapshot = path_absolute("build/native_probe/hir-key-snapshot-" + stamp).replace("\\", "/")
        val checkout = "build/native_probe/hir-key-checkout-" + stamp
        for root in [snapshot, checkout]:
            expect(dir_create_all(root + "/src/lib/probe")).to_be(true)
            expect(file_write(root + "/src/lib/probe/same.spl", "pub fn same() -> i64: 1\n")).to_be(true)
            expect(file_write(root + "/src/lib/probe/other.spl", "pub fn same() -> i64: 1\n")).to_be(true)
        val sharded = hir_cache_key(snapshot + "/src/lib/probe/same.spl", "same-frozen-closure", false)
        val direct = hir_cache_key(checkout + "/src/lib/probe/same.spl", "same-frozen-closure", false)
        expect(sharded.len()).to_equal(64)
        expect(direct).to_equal(sharded)
        expect(hir_cache_key(checkout + "/src/lib/probe/other.spl", "same-frozen-closure", false) == sharded).to_equal(false)
