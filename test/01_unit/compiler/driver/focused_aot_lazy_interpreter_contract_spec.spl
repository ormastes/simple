use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused AOT bootstrap closure contract":
    it "keeps bootstrap driver dependencies in the native closure":
        val driver = file_read("src/compiler/80.driver/driver.spl")
        val types = file_read("src/compiler/80.driver/driver_types.spl")
        val direct_import = "use compiler.backend.backend.interpreter."
        expect(driver).to_contain(direct_import)
        expect(types).to_contain(direct_import)
        expect(types).to_contain(
            "use compiler.driver.cache.compile_options_hash."
        )
        expect(driver).to_contain("InterpreterBackendImpl")
        expect(types).to_contain("InterpreterBackendImpl")
        val interpreter = file_read("src/compiler/70.backend/backend/interpreter.spl")
        expect(interpreter).to_contain("use compiler.hir.hir_types.*")
        expect(interpreter).to_contain("use compiler.hir.hir_definitions.*")
