use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "durable Stage3 memory snapshot ownership":
    it "keeps environment access and the descriptor in one owner":
        val owner = file_read("src/compiler/80.driver/driver_mem_snapshot.spl")
        val lowering = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        expect(owner).to_contain(
            "use std.nogc_sync_mut.io_runtime.{env_get_opt}")
        expect(owner).not_to_contain("extern fn rt_env_get")
        expect(owner).not_to_contain("rt_env_get(")
        expect(owner.split("env_get_opt(").len()).to_equal(2)
        expect(owner).to_contain("var _mem_snapshot_fd: i64 = -1")
        expect(lowering.contains("rt_env_get(\"SIMPLE_MEM_SNAPSHOT_FILE\")")).to_equal(false)

    it "samples the sink path once at begin before disable or open decisions":
        val owner = file_read("src/compiler/80.driver/driver_mem_snapshot.spl")
        val begin_start = owner.index_of("fn mem_snapshot_begin()")
        val record_start = owner.index_of("fn mem_snapshot_record(")
        val begin = owner.substring(begin_start, record_start)
        expect(begin.split("env_get_opt(").len()).to_equal(2)
        expect(begin).to_contain(
            "val path = env_get_opt(\"SIMPLE_MEM_SNAPSHOT_FILE\") ?? \"\"")
        val already_open_guard = begin.index_of("if _mem_snapshot_fd >= 0:")
        val lookup = begin.index_of("val path = env_get_opt(")
        val empty_guard = begin.index_of("if path == \"\"")
        val enable = begin.index_of("_mem_snapshot_enabled = true")
        val open = begin.index_of("rt_mem_snapshot_open(path)")
        expect(lookup).to_be_greater_than(already_open_guard)
        expect(begin).to_contain(
            "if _mem_snapshot_fd >= 0:\n" +
            "        return -1\n" +
            "    val path = env_get_opt(")
        expect(empty_guard).to_be_greater_than(lookup)
        expect(enable).to_be_greater_than(empty_guard)
        expect(open).to_be_greater_than(enable)
        expect(begin).to_contain(
            "if path == \"\":\n" +
            "        _mem_snapshot_enabled = false\n" +
            "        return 0")
        expect(begin).to_contain("if _mem_snapshot_fd < 0:")
        expect(begin).to_contain("return -1")

    it "records all four exact HIR boundaries and closes normally":
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        expect(source).to_contain("\"hir-file-start\"")
        expect(source).to_contain("\"hir-post-lowering\"")
        expect(source).to_contain("\"hir-post-diagnostics\"")
        expect(source).to_contain("\"hir-post-store\"")
        expect(source).to_contain("mem_snapshot_finish()")

    it "passes only scalar cardinalities into runtime-owned formatting":
        val owner = file_read("src/compiler/80.driver/driver_mem_snapshot.spl")
        expect(owner).to_contain("Formatting is deliberately runtime-owned")
        expect(owner).to_contain("rt_mem_snapshot_record(")
        expect(owner.contains("heap_live_bytes=\\{")).to_equal(false)

    it "binds phase records to the same durable schema and run identity":
        val source = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        expect(source).to_contain("rt_mem_snapshot_open(sink)")
        expect(source).to_contain("_g_phase_profile_seq")
        expect(source).to_contain("\"phase\", msg")
        expect(source).to_contain("SIMPLE_EVIDENCE_RUN_ID")
        expect(source.contains("file_append(sink, line")).to_equal(false)
