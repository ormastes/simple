use std.spec.*
use compiler.driver.driver_build.native_link_observation_v3.{native_link_observation_render_v3}
use compiler.driver.driver_build.native_link_receipt_v1.{native_link_receipt_output_digest_v1}

val OBSERVATION_DIGEST = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

describe "completed native link observations":
    it "binds the canonical userspace target and exact completed engine":
        val content = native_link_observation_render_v3("aarch64-unknown-simpleos", "internal:simpleos", OBSERVATION_DIGEST).unwrap()
        expect(content).to_contain("target: simpleos-aarch64\narch: aarch64\nengine-id: internal:simpleos\n")
        expect(content).to_contain("output-sha256: " + OBSERVATION_DIGEST + "\n")
        expect(content).to_contain("completed: true\nfresh-only: true\ncache-authority: none\n")

    it "cannot be read as an authoritative version-one cache receipt":
        val content = native_link_observation_render_v3("simpleos-x86_64", "ld.lld", OBSERVATION_DIGEST).unwrap()
        expect(native_link_receipt_output_digest_v1(content, "any-key")).to_equal("")

    it "refuses unknown internal labels external fallback labels and malformed digests":
        expect(native_link_observation_render_v3("simpleos-x86_64", "internal:invented", OBSERVATION_DIGEST)).to_equal(None)
        expect(native_link_observation_render_v3("simpleos-x86_64", "cc", OBSERVATION_DIGEST)).to_equal(None)
        expect(native_link_observation_render_v3("simpleos-x86_64", "ld.lld", "bad")).to_equal(None)
        expect(native_link_observation_render_v3("x86_64-unknown-linux-gnu", "ld.lld", OBSERVATION_DIGEST)).to_equal(None)
