use std.spec.{describe, it, expect, step}
use std.io.{file_read_text}

describe "native cache frozen source ownership":
    it "keys cache admission from the phase-1 frozen source owners":
        step("Inspect native cache source and content identity lookup")
        val source = file_read_text(
            "src/compiler/80.driver/driver_aot_native_output.spl") ?? ""

        step("Require module lookup through the retained scalar owners")
        expect(source).to_contain(
            "ctx.source_paths_owner, ctx.source_contents_owner")
        expect(source).to_contain(
            "ctx.source_module_names_owner, module_name")
        expect(source).to_contain(
            "identity = sha256_text(source_contents[source_index])")
        expect(source).to_contain(
            "if source_paths.len() != source_contents.len()")

        step("Forbid stale aggregate SourceFile lookup in cache admission")
        val cache_lookup_start = source.find(
            "fn driver_native_module_cache_source")
        val disk_lookup_start = source.find(
            "fn driver_native_disk_source_identity")
        val cache_lookup = source.substring(cache_lookup_start, disk_lookup_start)
        expect(cache_lookup.contains("for source in ctx.sources:")).to_equal(false)
