"""
## Purpose and audience
Driver maintainers who shard parsing and HIR lowering across processes. Every
shard must assign a module to the same owner, so the owner index is a pure,
cross-process-stable fingerprint of the module path: XXH3-64 of its UTF-8
bytes, shifted right one bit so it stays a non-negative i64 for `% count`.
"""
use std.spec.step
use std.spipe.*
use std.common.hash.xxh3.{xxh3_64}
use std.common.text_bytes.{text_to_utf8_bytes}
use compiler.driver.driver_parse_shard_hash.{driver_parse_shard_hash}

fn expected_shard_hash(path: text) -> i64:
    (xxh3_64(text_to_utf8_bytes(path)) >> 1u64).to_i64()

describe "parse/HIR shard index fingerprint":
    it "is XXH3-64 of the module path, non-negative":
        step("Hash a typical module path and the empty path")
        for path in ["src/compiler/80.driver/driver_hir_cache.spl", "", "a", "src/lib/común/ñ.spl"]:
            val h = driver_parse_shard_hash(path)
            expect(h).to_equal(expected_shard_hash(path))
            expect(h >= 0).to_equal(true)

    it "is stable across calls and separates nearby paths":
        step("Hash the same path twice and two sibling paths")
        val a = driver_parse_shard_hash("src/lib/a.spl")
        expect(driver_parse_shard_hash("src/lib/a.spl")).to_equal(a)
        expect(driver_parse_shard_hash("src/lib/b.spl") != a).to_equal(true)
