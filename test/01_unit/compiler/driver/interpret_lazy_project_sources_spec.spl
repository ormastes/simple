use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "interpret-mode project source loading":
    it "keeps explicit interpretation out of the whole-project bulk loader":
        val loading = file_read(
            "src/compiler/80.driver/driver_source_pipeline_loading.spl")

        expect(loading).to_contain(
            "compile_mode != CompileMode.Interpret")
        expect(loading).to_contain(
            "if (has_project_source and needs_bulk_project_sources and")
        expect(loading).to_contain(
            "not nb_entry_closure and not package_index_routed and")
        expect(loading).to_contain(
            "self.ctx.options.mode == CompileMode.Interpret and driver_inputs.len() == 1")

    it "retains lazy interpreter import resolution through SIMPLE_LIB":
        val resolver = file_read(
            "src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl")

        expect(resolver).to_contain(
            "val simple_lib = env_get_opt(\"SIMPLE_LIB\")")
        expect(resolver).to_contain(
            "val lib_path = _sffi_path_join(simple_lib, relative_path)")
