"""NOGC param-effect admission uses indexed (linear) membership, not O(n^2) scans."""

use std.spec.*
use compiler.driver.hir_admission_order_v1.{hir_admission_path_order_v1, hir_admission_identity_key_v1, hir_admission_unadmitted_indices_v1, hir_admission_group_positions_v1}

describe "NOGC param-effect admission indexing":
    it "keeps selection-sort order for duplicate and windows-style paths":
        val paths = ["C:/b.spl", "/z.spl", "C:/a.spl", "/z.spl", "C:/a.spl"]
        expect(hir_admission_path_order_v1(paths)).to_equal([1, 3, 2, 4, 0])

    it "joins name and path into one identity":
        expect(hir_admission_identity_key_v1("m", "/a.spl")).to_equal("m\n/a.spl")

    it "returns unadmitted pending positions in pending order":
        val pending = ["a\n/1", "b\n/2", "c\n/3", "a\n/1"]
        expect(hir_admission_unadmitted_indices_v1(pending, ["a\n/1"])).to_equal([1, 2])
        expect(hir_admission_unadmitted_indices_v1(pending, [])).to_equal([0, 1, 2, 3])
        expect(hir_admission_unadmitted_indices_v1(pending, ["b\n/2", "c\n/3", "a\n/1"])).to_equal([])

    it "groups positions per key in original order (aliases and conflicting surfaces)":
        val groups = hir_admission_group_positions_v1(["/x", "/y", "/x", "/x"])
        val xs: [i64] = groups["/x"]
        val ys: [i64] = groups["/y"]
        expect(xs).to_equal([0, 2, 3])
        expect(ys).to_equal([1])
        expect(groups.contains_key("/z")).to_equal(false)
