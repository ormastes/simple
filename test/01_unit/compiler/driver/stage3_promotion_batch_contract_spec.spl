use std.io.{file_read}
use std.spec.{describe, it, expect}

val DRIVER = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
val LOG_HELPERS = "src/compiler/80.driver/driver_log_helpers.spl"
val CORE_RUNTIME = "src/runtime/runtime_native.c"
val RUNTIME_HEADER = "src/runtime/runtime.h"
val RUST_RUNTIME = "src/compiler_rust/runtime/src/value/collections.rs"
val RUST_INTERPRETER = "src/compiler_rust/compiler/src/interpreter_extern/memory.rs"
val RUNTIME_SYMBOLS = "src/compiler_rust/common/src/runtime_symbols.rs"

describe "Stage3 promotion batch source and ABI contract":
    it "unions frozen retained roots and commits before detach and scope end":
        val driver = file_read(DRIVER)
        val log_helpers = file_read(LOG_HELPERS)
        val core_runtime = file_read(CORE_RUNTIME)
        val runtime_header = file_read(RUNTIME_HEADER)
        val rust_runtime = file_read(RUST_RUNTIME)
        val rust_interpreter = file_read(RUST_INTERPRETER)
        val runtime_symbols = file_read(RUNTIME_SYMBOLS)
        val start = driver.index_of("me lower_streaming_surface_source")
        val end = driver.index_of("me lower_and_check_streaming_surfaces_impl")
        val body = driver.substring(start, end)
        val pause = body.index_of("rt_transient_array_scope_pause()")
        val batch_begin = body.index_of(
            "rt_transient_heap_promotion_batch_begin()", pause)
        val hir_root = body.index_of("rt_transient_heap_promote(hir_module)", batch_begin)
        val lowering_roots = body.index_of(
            "lowering.promote_transient_compilation_roots()", hir_root)
        val bootstrap_roots = body.index_of(
            "bootstrap_hir_modules_promote_transient_roots()", lowering_roots)
        val frontend_roots = body.index_of(
            "frontend_promote_compilation_registries()", bootstrap_roots)
        val commit = body.index_of(
            "rt_transient_heap_promotion_batch_commit()", frontend_roots)
        val abort = body.index_of(
            "rt_transient_heap_promotion_batch_abort()", commit)
        val detach = body.index_of("lowering.detach_transient_module_scratch()", commit)
        val scope_end = body.last_index_of("driver_end_transient_parse_scope()")
        expect(batch_begin).to_be_greater_than(pause)
        expect(hir_root).to_be_greater_than(batch_begin)
        expect(lowering_roots).to_be_greater_than(hir_root)
        expect(bootstrap_roots).to_be_greater_than(lowering_roots)
        expect(frontend_roots).to_be_greater_than(bootstrap_roots)
        expect(commit).to_be_greater_than(frontend_roots)
        expect(abort).to_be_greater_than(commit)
        expect(detach).to_be_greater_than(commit)
        expect(scope_end).to_be_greater_than(detach)

        for symbol in [
            "rt_transient_heap_promotion_batch_begin",
            "rt_transient_heap_promotion_batch_commit",
            "rt_transient_heap_promotion_batch_abort",
            "rt_transient_heap_promotion_last_roots",
            "rt_transient_heap_promotion_last_unique_heap",
            "rt_transient_heap_promotion_last_unique_raw",
            "rt_transient_heap_promotion_last_duplicates",
            "rt_transient_heap_promotion_last_workspace_peak_lower_bound_bytes",
            "rt_transient_heap_promotion_last_status"
        ]:
            expect(runtime_header).to_contain(symbol)
            expect(runtime_symbols).to_contain(symbol)
        expect(core_runtime).to_contain("static _Thread_local RtCoreTransientPlan")
        expect(core_runtime).to_contain("rt_core_transient_plan_validate")
        expect(core_runtime).to_contain(
            "RT_CORE_TRANSIENT_PROMOTION_SCOPE_ENDED_ACTIVE")
        expect(rust_runtime).to_contain("TransientPromotionBatch")
        expect(rust_runtime).to_contain("validate_transient_promotion")
        expect(rust_runtime).to_contain(
            "transient_heap_promotion_note_interpreter_root")
        expect(rust_interpreter).to_contain(
            "transient_heap_promotion_note_interpreter_root")
        expect(log_helpers).to_contain("promotion_status={{promotion_status}}")
        expect(log_helpers).to_contain("promotion_roots={{promotion_roots}}")
        expect(log_helpers).to_contain(
            "promotion_receipt_valid={{promotion_receipt_valid}}")
        expect(log_helpers).to_contain(
            "promotion_status == 1 and promotion_roots > 0")
