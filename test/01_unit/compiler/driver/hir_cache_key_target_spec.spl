use std.spec.*
use compiler.driver.driver_hir_cache.{hir_cache_key}
use std.io_runtime.{env_get, env_set}

val SRC = "test/fixtures/compiler/hir_cache_source_identity/left.spl"

fn _key_for_target(triple: text) -> text:
    val old = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    env_set("SIMPLE_NATIVE_BUILD_TARGET", triple)
    val key = hir_cache_key(SRC, "same-frozen-closure", false)
    env_set("SIMPLE_NATIVE_BUILD_TARGET", old)
    key

describe "HIR cache key folds the compile target":
    it "gives different keys for different targets":
        val linux = _key_for_target("x86_64-unknown-linux-gnu")
        val win = _key_for_target("x86_64-pc-windows-msvc")
        val arm = _key_for_target("aarch64-unknown-linux-gnu")
        expect(linux.len()).to_equal(64)
        expect(linux == win).to_equal(false)
        expect(linux == arm).to_equal(false)

    it "gives equal keys for the same target":
        expect(_key_for_target("x86_64-unknown-linux-gnu")).to_equal(_key_for_target("x86_64-unknown-linux-gnu"))

    it "gives different keys when only the enabled feature set differs":
        val old = env_get("SIMPLE_FEATURES") ?? ""
        env_set("SIMPLE_FEATURES", "")
        val off = hir_cache_key(SRC, "same-frozen-closure", false)
        env_set("SIMPLE_FEATURES", "macho")
        val on = hir_cache_key(SRC, "same-frozen-closure", false)
        env_set("SIMPLE_FEATURES", old)
        expect(off.len()).to_equal(64)
        expect(off == on).to_equal(false)
