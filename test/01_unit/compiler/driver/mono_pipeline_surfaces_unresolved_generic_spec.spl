"""
# Driver pipeline surfaces E-MONO-032 for an uninferable generic call

Phase 3 of `doc/03_plan/compiler/hardening/critical_hardening_plan_2026-08-21.md`
/ bug `doc/08_tracking/bug/hir_generic_templates_unconsumed_by_mono_pass_2026-08-21.md`.

`monomorphize_impl` used to call `run_monomorphization`, whose return type has
no diagnostics channel at all. The mono pass genuinely produced the
E-MONO-032 finding for a generic call it could not specialize, and the driver
then threw it away: the pass returned `true`, the still-generic HIR was handed
to MIR, and the build stayed green at rc=0. That is the same fail-open shape as
a type error reported into a list nobody reads.

Pre-fix verdict for this file: both `it` blocks FAIL — the driver has no
`run_monomorphization_with_diagnostics` call site, and a driver run over the
uninferable module records zero errors.

## What makes the fixture uninferable
`ident(v: 7)` passes its argument BY NAME. `infer_type_args_from_args` bails on
the first named argument (`at.has_name` -> `return []`) because positional
unification is the only binding rule it implements — deliberately fail-closed,
never a guess. So `T` stays unbound, the call is left unspecialized, and the
pass must say so out loud instead of silently emitting a generic template.
"""

use std.spec
use std.io_runtime.{file_read}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.driver.driver.{CompilerDriver}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.mono.monomorphize_integration.{run_monomorphization_with_diagnostics}

fn contains_code(msgs: [text], code: text) -> bool:
    for m in msgs:
        if m.contains(code):
            return true
    false

describe "driver monomorphization pass surfaces unresolved generic calls":
    it "records E-MONO-032 as a driver ERROR and fails the pass":
        # Inlined parse -> HIR on purpose; a module-level helper loses the
        # recorded lowering state (see mono_source_inference_fixed_point_spec).
        val src = "fn ident<T>(v: T) -> T:\n    v\n\nfn main() -> i64:\n    val x: i64 = ident(v: 7)\n    x\n"
        val parsed = parse_full_frontend(
            src,
            "testdata/mono_uninferable_named_arg.spl",
            "mono_uninferable_named_arg",
            Logger(level: 0))
        var hl = HirLowering.with_filename(
            "testdata/mono_uninferable_named_arg.spl")
        val hir = hl.lower_module(parsed)

        # The pass itself must produce the loud finding.
        var probe: Dict<text, HirModule> = {}
        probe["m"] = hir
        val (_out, _stats, diags) = run_monomorphization_with_diagnostics(probe)
        expect(diags.len()).to_be_greater_than(0)
        expect(contains_code(diags, "E-MONO-032")).to_equal(true)

        # ...and the DRIVER must surface it rather than dropping it.
        var driver = CompilerDriver.create(driver_core_compile_options_default())
        driver.ctx.hir_modules["m"] = hir
        val ok = driver.monomorphize_impl(true)

        expect(ok).to_equal(false)
        expect(driver.ctx.has_errors()).to_equal(true)
        # Read through `error_message_at`, never `ctx.errors[i]` — see the
        # accessor's comment in driver_types.spl.
        var found = false
        var i = 0
        while i < driver.ctx.error_count():
            if driver.ctx.error_message_at(i).contains("E-MONO-032"):
                found = true
            i = i + 1
        expect(found).to_equal(true)

    it "wires the diagnostics-carrying entry point, not the silent one":
        val passes = file_read(
            "src/compiler/80.driver/driver_hir_pipeline_passes.spl")

        expect(passes).to_contain("run_monomorphization_with_diagnostics(")
        expect(passes).to_contain("E-MONO-033")
        # The post-mono verifier still runs, and still runs BEFORE MIR.
        expect(passes).to_contain("post_mono_verify_modules(")
        expect(passes).to_contain("post_mono_report_total(")
