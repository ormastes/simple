use std.spec.*
use compiler.driver.incremental_builder.{IncrementalBuilder, CompilationStatus}

describe "IncrementalBuilder dirty-file stats":
    it "counts a dirty file in stats().files_dirty after needs_recompile sees it as a miss":
        var builder = IncrementalBuilder.create()
        builder.add_source("a.spl", "fn foo():\n    1")

        # Mark the registered source dirty (as a real dependency-graph
        # invalidation would), then ask the incremental engine whether it
        # needs recompilation — this is the exact staleness-detection path
        # incremental compilation depends on.
        builder.state.mark_dirty("a.spl")
        val needs = builder.state.needs_recompile("a.spl")
        expect(needs).to_equal(true)

        val stats = builder.stats()
        # A file that was just found dirty and reported as needing
        # recompilation must be reflected in files_dirty — otherwise
        # rebuild_ratio()/hit_ratio() observability is silently wrong.
        expect(stats.files_dirty).to_be_greater_than(0)
