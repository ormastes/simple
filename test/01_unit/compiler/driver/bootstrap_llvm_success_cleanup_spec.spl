use std.spec.{describe, it, expect}
use compiler.driver.driver_bootstrap.{
    bootstrap_llvm_success_cleanup_paths,
    bootstrap_llvm_success_cleanup_paths_with_policy
}

describe "bootstrap LLVM successful-copy cleanup":
    it "removes the duplicate object and textual IR by default":
        val paths = bootstrap_llvm_success_cleanup_paths("/tmp/simple_llvm_42.o", false)
        expect(paths.len()).to_equal(2)
        expect(paths[0]).to_equal("/tmp/simple_llvm_42.o")
        expect(paths[1]).to_equal("/tmp/simple_llvm_42.ll")

    it "preserves requested diagnostic IR but removes the duplicate object":
        val paths = bootstrap_llvm_success_cleanup_paths("/tmp/simple_llvm_42.o", true)
        expect(paths.len()).to_equal(1)
        expect(paths[0]).to_equal("/tmp/simple_llvm_42.o")

    it "preserves all diagnostic intermediates under the general keep policy":
        val paths = bootstrap_llvm_success_cleanup_paths_with_policy(
            "/tmp/simple_llvm_42.o", true, false)
        expect(paths.len()).to_equal(0)
