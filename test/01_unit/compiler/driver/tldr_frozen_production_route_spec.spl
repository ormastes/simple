# Frozen production phase-2 caller, with a full-source surface oracle.
# Runtime evidence is pending an admitted self-hosted Linux runtime.
use std.spec
use std.io_runtime.{file_write, rt_env_get, rt_env_set, getpid}
use std.nogc_sync_mut.io_runtime.{dir_create_all, cwd, time_now_unix_micros}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.driver_core_types.{CompileMode, driver_core_compile_options_default}
use compiler.driver.driver.{compiler_driver_create, CompilerDriver}
use compiler.driver.driver_tldr_import_route_v1.{tldr_route_frozen_inputs_v1,
    tldr_imports_memo_reset_v1, tldr_closure_walk_check_v1}
use compiler.driver.driver_tldr_frozen_surface_route_v1.{tldr_frozen_surface_lane_error_v1}
use compiler.driver.driver_parse_shard_hash.{driver_parse_shard_hash}
use compiler.driver.perf.compiler_work_counters.{compiler_work_counters_reset_v1,
    compiler_work_counters_snapshot_v1}
use compiler.frontend.flat_ast_bridge.{flat_parse_module_body_calls}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.common.diagnostics.span.{Span}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.driver.cache.tldr_frozen_projection_v1.{tldr_frozen_span_projection_v1}

val FROZEN_A = "# retained leading comment\npub fn z(x: i64) -> i64:\n    val next = x + 7\n    next\n    # trailing comment\n\npub fn a(x: i64) -> i64:\n    x\n"
val FROZEN_B = "@no_gc(strict)\nuse pkg.a.{a}\n\npub fn mid(x: i64) -> i64:\n    a(x)\n"
val FROZEN_C = "use pkg.b.{mid}\n\npub fn leaf(x: i64) -> i64:\n    mid(x)\n"

fn frozen_flag(value: text):
    rt_env_set("SIMPLE_TLDR_IMPORTS", value)
    tldr_imports_memo_reset_v1()

fn check_frozen_span(actual: Span, expected: Span):
    expect(actual.start).to_equal(expected.start)
    expect(actual.end).to_equal(expected.end)
    expect(actual.line).to_equal(expected.line)
    expect(actual.col).to_equal(expected.col)
    expect(actual.length).to_equal(expected.length)
    expect(actual.file).to_equal(expected.file)

fn check_frozen_function_spans(source: text, expected_names: [text]):
    val planned = tldr_route_frozen_inputs_v1(["fx.spl"], ["pkg.a"], [source], [false]).unwrap()
    expect(planned.interface_parses).to_equal(1)
    expect(planned.fallbacks).to_equal(0)
    expect(planned.parse_texts[0].len()).to_equal(source.len())
    expect(planned.parse_texts[0] == source).to_equal(false)
    val full = parse_full_frontend(source, "fx.spl", "pkg.a", Logger(level: 0))
    val projected = parse_full_frontend(planned.parse_texts[0], "fx.spl", "pkg.a", Logger(level: 0))
    expect(full.function_order).to_equal(expected_names)
    expect(projected.function_order).to_equal(expected_names)
    expect(full.functions.len()).to_equal(expected_names.len())
    expect(projected.functions.len()).to_equal(expected_names.len())
    for name in expected_names:
        expect(full.functions.contains_key(name)).to_equal(true)
        expect(projected.functions.contains_key(name)).to_equal(true)
        val expected = full.functions[name]
        val actual = projected.functions[name]
        check_frozen_span(actual.span, expected.span)
        check_frozen_span(actual.return_type.span, expected.return_type.span)
        expect(actual.params.len()).to_equal(expected.params.len())
        for index in 0..expected.params.len():
            check_frozen_span(actual.params[index].span, expected.params[index].span)
            check_frozen_span(actual.params[index].type_.span, expected.params[index].type_.span)

fn frozen_driver(paths: [text], root: text) -> CompilerDriver:
    var options = driver_core_compile_options_default()
    options.input_files = paths
    options.mode = CompileMode.Check
    options.bootstrap_input_count = 0
    options.native_source_roots = ["src"]
    options.native_source_snapshot_root = root
    val driver = compiler_driver_create(options)
    val (_loaded_ctx, loaded) = driver.load_sources_impl()
    expect(loaded).to_equal(true)
    driver

describe "frozen TLDR route admission":
    it "keeps exact original spans with comments, declaration order and short bodies":
        check_frozen_function_spans(FROZEN_A, ["z", "a"])
        check_frozen_function_spans(FROZEN_A.replace("\n", "\r\n"), ["z", "a"])
        check_frozen_function_spans("# short body at EOF\nfn z() -> i64:\n    1", ["z"])

    it "falls back for Unicode rather than guessing a byte-coordinate map":
        val source = "pub fn value() -> text:\n    '한글'\n"
        expect(tldr_frozen_span_projection_v1(source)).to_be_nil()
        val planned = tldr_route_frozen_inputs_v1(["fx.spl"], ["fx"], [source], [false]).unwrap()
        expect(planned.parse_texts).to_equal([source])
        expect(planned.fallbacks).to_equal(1)

    it "retains module attributes preceding imports and their parsed authority":
        val markers = ["@no_gc(strict)\n", "@layer(gui)\n"]
        for marker in markers:
            val layer = if marker.starts_with("@layer"): "layer gui\n" else: ""
            val source = marker + "use pkg.a.{a}\n" + layer + "pub fn value(x: i64) -> i64:\n    a(x)\n"
            val planned = tldr_route_frozen_inputs_v1(["a.spl", "fx.spl"], ["pkg.a", "fx"],
                [FROZEN_A, source], [false, false]).unwrap()
            expect(planned.parse_texts[1]).to_equal(source)
            expect(planned.fallbacks).to_equal(1)
            expect(planned.interface_parses).to_equal(1)
            val full = parse_full_frontend(source, "fx.spl", "fx", Logger(level: 0))
            val projected = parse_full_frontend(planned.parse_texts[1], "fx.spl", "fx", Logger(level: 0))
            expect(projected.nogc_strict).to_equal(full.nogc_strict)
            expect(projected.tagged_layer).to_equal(full.tagged_layer)
            expect(projected.layer_dag_edges).to_equal(full.layer_dag_edges)
            if marker.starts_with("@layer"): expect(projected.tagged_layer).to_equal("gui")
            else: expect(projected.nogc_strict).to_equal(true)

    it "refuses missing and duplicate declared identities without opening a path":
        expect(tldr_route_frozen_inputs_v1(["absent.spl"], ["pkg.b"],
            [FROZEN_B], [true]).unwrap_err()).to_contain("DECLARED-UNIVERSE")
        expect(tldr_route_frozen_inputs_v1(["a.spl", "b.spl"], ["pkg.a", "pkg.a"],
            [FROZEN_A, FROZEN_A], [true, false]).unwrap_err()).to_contain("duplicate module")
        expect(tldr_route_frozen_inputs_v1(["a.spl"], [], [], []).unwrap_err()).to_contain("unaligned")

    it "uses frozen source fallback for an inferred return type":
        val source = "pub fn value():\n    13\n"
        val route = tldr_route_frozen_inputs_v1(["does-not-exist.spl"],
            ["value"], [source], [false]).unwrap()
        expect(route.parse_texts).to_equal([source])
        expect(route.fallbacks).to_equal(1)
        expect(route.source_parses).to_equal(1)
        expect(route.interface_parses).to_equal(0)

    it "preserves trait default bodies through frozen source fallback":
        val source = "trait Value:\n    fn value(self) -> i64:\n        13\n"
        val route = tldr_route_frozen_inputs_v1(["absent.spl"],
            ["value"], [source], [false]).unwrap()
        expect(route.parse_texts).to_equal([source])
        expect(route.fallbacks).to_equal(1)

    it "refuses advice and unsupported native bodies without a closure walk":
        expect(tldr_route_frozen_inputs_v1(["aspect.spl"], ["aspect"],
            ["on pc{call(*)}:\n    pass\n"], [true]).unwrap_err()).to_contain("GLOBAL-FACET")
        expect(tldr_frozen_surface_lane_error_v1(true, false, false, true, false, false)).to_contain("BODY-REQUIRED")
        expect(tldr_frozen_surface_lane_error_v1(true, false, false, false, false, true)).to_contain("CFG-RECEIPT")
        expect(tldr_frozen_surface_lane_error_v1(false, false, false, false, false, false)).to_contain("UNSUPPORTED-LANE")
        expect(tldr_closure_walk_check_v1(true, "oracle").is_err()).to_equal(true)

describe "production frozen phase-2 surface caller":
    it "matches cold source surfaces and records actual source and interface parses after live edits":
        val saved_flag = rt_env_get("SIMPLE_TLDR_IMPORTS") ?? ""
        val saved_worker = rt_env_get("SIMPLE_HIR_SHARD") ?? ""
        val saved_skeleton = rt_env_get("SIMPLE_HIR_WORKER_SKELETON") ?? ""
        val saved_parse = rt_env_get("SIMPLE_PARSE_SHARD") ?? ""
        val saved_mir = rt_env_get("SIMPLE_MIR_SHARD_ONLY_PATHS") ?? ""
        val saved_queue = rt_env_get("SIMPLE_HIR_SHARD_QUEUE") ?? ""
        val root = cwd() + "/build/test_tmp/tldr_frozen-" + getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root + "/src/pkg")).to_equal(true)
        val paths = [root + "/src/pkg/a.spl", root + "/src/pkg/b.spl", root + "/src/pkg/c.spl"]
        val contents = [FROZEN_A, FROZEN_B, FROZEN_C]
        for index in 0..paths.len(): expect(file_write(paths[index], contents[index])).to_equal(true)
        rt_env_set("SIMPLE_HIR_SHARD", "")
        rt_env_set("SIMPLE_PARSE_SHARD", "")
        rt_env_set("SIMPLE_MIR_SHARD_ONLY_PATHS", "")
        rt_env_set("SIMPLE_HIR_SHARD_QUEUE", "")
        frozen_flag("")
        val cold = frozen_driver(paths, root)
        expect(cold.stage_parse().is_none()).to_equal(true)
        val oracle = module_surfaces_from_modules(cold.ctx.modules, cold.ctx.sources,
            cold.ctx.options.library_mode).unwrap()

        frozen_flag("1")
        val route = frozen_driver(paths, root)
        # A real existing HIR-worker selector owns exactly the leaf in this
        # fixture; all other declared inventory members need summary surfaces.
        val bucket = driver_parse_shard_hash(paths[2]) % 65521
        expect(driver_parse_shard_hash(paths[0]) % 65521 == bucket).to_equal(false)
        expect(driver_parse_shard_hash(paths[1]) % 65521 == bucket).to_equal(false)
        rt_env_set("SIMPLE_HIR_SHARD", "{bucket}/65521")
        rt_env_set("SIMPLE_HIR_WORKER_SKELETON", "1")
        for path in paths: expect(file_write(path, "invalid live worktree input\n")).to_equal(true)
        compiler_work_counters_reset_v1()
        val parser_before = flat_parse_module_body_calls()
        expect(route.stage_parse().is_none()).to_equal(true)
        expect(route.streaming_surface_owner_ready).to_equal(true)
        expect(route.tldr_surface_source_parses).to_equal(2)
        expect(route.tldr_surface_interface_parses).to_equal(1)
        expect(compiler_work_counters_snapshot_v1().parser_scheduled).to_equal(3)
        expect(flat_parse_module_body_calls() - parser_before).to_equal(3)
        val routed = route.streaming_module_surfaces_owner
        expect(routed.surfaces.len()).to_equal(oracle.surfaces.len())
        for index in 0..oracle.surfaces.len():
            val full = oracle.surfaces[index]
            val summarized = routed.surfaces[index]
            expect(summarized.module_name).to_equal(full.module_name)
            expect(summarized.canonical_path).to_equal(full.canonical_path)
            expect(summarized.content_length).to_equal(full.content_length)
            expect(summarized.content_hash).to_equal(full.content_hash)
            expect(summarized.semantic_cacheable).to_equal(full.semantic_cacheable)
            expect(summarized.semantic_hash0).to_equal(full.semantic_hash0)
            expect(summarized.semantic_hash1).to_equal(full.semantic_hash1)
            expect(summarized.semantic_hash2).to_equal(full.semantic_hash2)
            expect(summarized.semantic_hash3).to_equal(full.semantic_hash3)
            expect(summarized.callable_names).to_equal(full.callable_names)
            expect(summarized.import_target_names).to_equal(full.import_target_names)
            expect(summarized.nogc_strict).to_equal(full.nogc_strict)
            if full.module_name == "pkg.b": expect(summarized.nogc_strict).to_equal(true)
            for callable_index in 0..full.callable_values.len():
                val expected = full.callable_values[callable_index]
                val actual = summarized.callable_values[callable_index]
                check_frozen_span(actual.span, expected.span)
                check_frozen_span(actual.return_type.span, expected.return_type.span)
                for param_index in 0..expected.params.len():
                    check_frozen_span(actual.params[param_index].span, expected.params[param_index].span)
                    check_frozen_span(actual.params[param_index].type_.span, expected.params[param_index].type_.span)
            expect(route.ctx.source_identities_owner[index]).to_equal(sha256_text(contents[index]))
        # Original frozen source must remain authoritative for later HIR.
        expect(route.ctx.source_contents_owner).to_equal(contents)
        # A second independent context claims the full inventory. It must not
        # inherit the first context's static slice or overwrite its counters.
        for index in 0..paths.len(): expect(file_write(paths[index], contents[index])).to_equal(true)
        rt_env_set("SIMPLE_HIR_SHARD", "")
        val following = frozen_driver(paths, root)
        expect(following.stage_parse().is_none()).to_equal(true)
        expect(following.tldr_surface_source_parses).to_equal(3)
        expect(following.tldr_surface_interface_parses).to_equal(0)
        expect(route.tldr_surface_source_parses).to_equal(2)
        expect(route.tldr_surface_interface_parses).to_equal(1)
        val refused_queue = frozen_driver(paths, root)
        rt_env_set("SIMPLE_HIR_SHARD_QUEUE", root + "/unadmitted-dynamic-queue")
        expect(refused_queue.stage_parse().is_none()).to_equal(false)
        expect(refused_queue.ctx.error_message_at(0)).to_contain("dynamic HIR claims")
        rt_env_set("SIMPLE_HIR_SHARD", saved_worker)
        rt_env_set("SIMPLE_HIR_WORKER_SKELETON", saved_skeleton)
        rt_env_set("SIMPLE_PARSE_SHARD", saved_parse)
        rt_env_set("SIMPLE_MIR_SHARD_ONLY_PATHS", saved_mir)
        rt_env_set("SIMPLE_HIR_SHARD_QUEUE", saved_queue)
        frozen_flag(saved_flag)
