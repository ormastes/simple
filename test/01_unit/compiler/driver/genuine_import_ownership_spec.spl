"""
## Purpose and audience
Purpose: Verify genuine import ownership.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
Troubleshooting: a red scenario here means the pinned contract changed —
check verification guidance in the linked design docs before editing oracles.
# @manual: primary
REQ-COMPILER-DRIVER-001
doc/01_research/local/REQ-COMPILER-DRIVER-001.md
doc/03_plan/sys_test/REQ-COMPILER-DRIVER-001.md
doc/04_architecture/REQ-COMPILER-DRIVER-001.md
doc/05_design/REQ-COMPILER-DRIVER-001.md
"""
# @req: REQ-COMPILER-DRIVER-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "genuine import ownership":
    it "binds handler compile and check symbols to their leaf owners":
        # @req: REQ-COMPILER-DRIVER-001
        step("Verify: binds handler compile and check symbols to their leaf owners")
        val source = file_read("src/app/io/_CliCommands/handler_commands.spl")
        expect(source).to_contain(r"use compiler.driver.driver_api_core.{interpret_file, check_file}")
        expect(source).to_contain(r"use compiler.driver.driver_types.{CompileResult}")
        expect(source).to_contain(r"use app.io.cli_compile.{cli_compile}")

    it "does not rely on the circular command facade for compile-driver symbols":
        # @req: REQ-COMPILER-DRIVER-001
        step("Verify: does not rely on the circular command facade for compile-driver symbols")
        val source = file_read("src/app/io/_CliCommands/handler_commands.spl")
        val owner_prefix = source.substring(0, source.find("fn cli_run_i18n"))
        expect(owner_prefix).to_contain("use app.io.cli_commands.*")
        expect(owner_prefix).to_contain(r"use app.io.cli_compile.{cli_compile}")
        expect(owner_prefix).to_contain(r"use compiler.driver.driver_api_core.{interpret_file, check_file}")

    it "imports SdnValue at module scope in both db_atomic implementations":
        # @req: REQ-COMPILER-DRIVER-001
        step("Verify: imports SdnValue at module scope in both db_atomic implementations")
        for path in [
            "src/lib/nogc_sync_mut/db_atomic.spl",
            "src/lib/nogc_async_mut/db_atomic.spl"
        ]:
            val source = file_read(path)
            expect(source).to_contain(r"use std.sdn.{SdnValue}" + "\n")
            expect(source.contains(r"    use std.sdn.{SdnValue}")).to_equal(false)
            expect(source.contains(r"use std.sdn.{parse, SdnValue}")).to_equal(false)
            expect(source).to_contain(r"use std.sdn.{parse}")
