"""Focused cache/capsule identity evidence for versioned backend providers."""

use std.spec.{describe, it, assert_false, assert_true, expect}
use compiler.driver.driver_build.incremental.{native_build_cache_scope_key}
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_aot_native_output.{
    driver_native_capsule_inputs_valid_v1
}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.mir.mir_data.{MirModule}

describe "backend provider cache identity":
    it "changes incremental scope only when the admitted provider receipt changes":
        val first = native_build_cache_scope_key(
            Some("llvm"), Some("x86-64-v3"), ["+avx2"], 2,
            "compiler-a", "provider-receipt-a")
        val same = native_build_cache_scope_key(
            Some("llvm"), Some("x86-64-v3"), ["+avx2"], 2,
            "compiler-a", "provider-receipt-a")
        val changed = native_build_cache_scope_key(
            Some("llvm"), Some("x86-64-v3"), ["+avx2"], 2,
            "compiler-a", "provider-receipt-b")
        expect(first).to_equal(same)
        assert_false(first == changed)
        expect(first).to_contain("provider=receipt:provider-receipt-a")

    it "keeps legacy built-ins compiler-bound until the driver supplies a receipt":
        val scope = native_build_cache_scope_key(
            Some("cranelift"), nil, [], 0, "compiler-a")
        expect(scope).to_contain(
            "provider=compiler-bound-builtin:cranelift")

    it "freezes provider receipt identity into every native module capsule":
        val ctx = CompileContext.create(driver_core_compile_options_default())
        ctx.mir_modules["provider_probe"] = MirModule(
            name: "provider_probe", functions: {}, statics: {},
            constants: {}, types: {})
        _ = ctx.freeze_storage_registry()
        val first = ctx.freeze_native_module_capsules_v1(
            ["provider_probe"], "/tmp/provider-capsule", "llvm",
            "x86_64", "baseline", 2, false, "provider-receipt-a")
        val changed = ctx.freeze_native_module_capsules_v1(
            ["provider_probe"], "/tmp/provider-capsule", "llvm",
            "x86_64", "baseline", 2, false, "provider-receipt-b")
        assert_true(first.ok and changed.ok)
        if first.ok and changed.ok:
            val first_capsule = first.find("provider_probe")
            val changed_capsule = changed.find("provider_probe")
            assert_true(first_capsule.identity_valid())
            assert_true(first_capsule.provider_receipt_valid(
                "provider-receipt-a"))
            assert_false(first_capsule.provider_receipt_valid(
                "provider-receipt-b"))
            assert_true(driver_native_capsule_inputs_valid_v1(
                first_capsule, "llvm", "x86_64", false, 2,
                "provider-receipt-a"))
            assert_false(driver_native_capsule_inputs_valid_v1(
                first_capsule, "llvm", "x86_64", false, 2,
                "provider-receipt-b"))
            assert_false(first_capsule.capsule_identity ==
                changed_capsule.capsule_identity)
            first_capsule.provider_receipt_hash = "provider-receipt-b"
            assert_false(first_capsule.identity_valid())
