"""
# MIR Method Enum Receiver Nil Guard

Requires enum-constructor recovery in method-call lowering to avoid the staged
TryOperator presence-test miscompile on missing symbols.
"""

extern fn rt_file_read_text(path: text) -> text

describe "MIR Method Enum Receiver Nil Guard":
    it "guards the symbol explicitly before reading its name":
        val source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        val dispatch_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        val stmt_source = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(source).to_contain("if rs != nil:")
        expect(source).to_contain("recv_enum_name = rs.name")
        expect(source).to_not_contain("if rs.?: recv_enum_name = rs.name")
        expect(source).to_contain("if found_local_type != nil:")
        expect(source).to_contain("val ts_local = b_ts.emit_call_value(ts_op, ts_ops, ts_dest_ty)")
        expect(source).to_contain("if not symbol.is_valid():")
        expect(source).to_contain("if sym != nil:")
        expect(source).to_not_contain("if found_local_type.?:")
        expect(source).to_not_contain("if ts_res.?:")
        expect(source).to_not_contain("val ts_local = ts_res ?? ts_recv")
        expect(source).to_not_contain("if sym.?: sym.name")
        expect(source).to_contain("[mir-method-call] start method={{method}}")
        expect(source).to_contain("[mir-method-call] enum-owner method={{method}}")
        expect(source).to_contain("[mir-method-call] gpu-owner method={{method}}")
        expect(source).to_contain("[mir-method-call] receiver-type method={{method}}")
        expect(source).to_contain("[mir-method-call] text-special-enter method={{method}}")
        expect(source).to_contain("[mir-method-call] text-special-call-after method={{method}}")
        expect(source).to_contain("[mir-method-call] text-special-builder-writeback-after method={{method}}")
        expect(source).to_contain("[mir-method-call] text-special-local-id method={{method}} id={{ts_local.id}}")
        expect(dispatch_source).to_contain("[mir-lower-expr] method-dispatch-after method={{method}} id={{method_result.id}}")
        expect(stmt_source).to_contain("if declared_type != nil:")
        expect(stmt_source).to_contain("init_local = self.ensure_option_handle(init_local, declared_type)")
        expect(source).to_contain("[mir-method-call] writeback-done method={{method}}")
        expect(source).to_contain("[mir-method-call] resolution-enter method={{method}}")
        expect(source).to_contain("[mir-method-call] resolution-arm=instance method={{method}}")
        expect(source).to_contain("[mir-method-call] resolution-arm=unresolved method={{method}}")
        expect(source).to_not_contain("rt_enum_discriminant(resolution)")
        expect(source).to_contain("case Unresolved: resolution_is_unresolved = true")
        expect(source).to_contain("case FreeFunction(_): resolution_is_free_function = true")
        expect(source).to_contain("case InstanceMethod(_, _): resolution_is_instance_method = true")
        expect(source).to_contain("case StaticMethod(_, _): resolution_is_static_method = true")
        expect(source).to_contain("case TraitMethod(_, _): ()")
        expect(source).to_contain("[mir-method-call] unresolved-receiver method={{method}}")
        expect(source).to_contain("[mir-method-call] push-enter local={{unresolved_receiver_local.id}}")
        expect(source).to_contain("me lower_unresolved_array_push(")
        expect(source).to_contain("return self.lower_unresolved_array_push(")
        expect(source).to_contain("Once custom-owner")
        expect(source).to_contain("if method == \"char_code_at\" and args.len() == 1:")
        expect(source).to_contain("me local_hir_type_is_str(local: LocalId) -> bool:")
        expect(source).to_contain("me local_hir_type_is_int(local: LocalId) -> bool:")
        expect(source).to_contain("if found_type == nil or found_type == 0:")
        expect(source).to_contain("char_code_receiver_is_text = self.local_hir_type_is_str(unresolved_receiver_local)")
        expect(source).to_contain("if method == \"byte_at\" and args.len() == 1:")
        expect(source).to_contain("byte_at_receiver_is_text = self.local_hir_type_is_str(unresolved_receiver_local)")
        expect(source).to_contain("predicate_receiver_is_text = self.local_hir_type_is_str(prelowered_method_receiver)")
        expect(source).to_contain("chr_receiver_is_local_int = self.local_hir_type_is_int(prelowered_method_receiver)")
        expect(source).to_not_contain("self.find_local_hir_type(unresolved_receiver_local.id) ?? HirType")
