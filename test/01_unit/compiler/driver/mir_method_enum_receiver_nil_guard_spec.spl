"""
# MIR Method Enum Receiver Nil Guard

Requires enum-constructor recovery in method-call lowering to avoid the staged
TryOperator presence-test miscompile on missing symbols.
"""

extern fn rt_file_read_text(path: text) -> text

describe "MIR Method Enum Receiver Nil Guard":
    it "guards the symbol explicitly before reading its name":
        val source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        expect(source).to_contain("if rs != nil:")
        expect(source).to_contain("recv_enum_name = rs.name")
        expect(source).to_not_contain("if rs.?: recv_enum_name = rs.name")
        expect(source).to_contain("if found_local_type != nil:")
        expect(source).to_contain("if ts_res != nil:")
        expect(source).to_contain("if not symbol.is_valid():")
        expect(source).to_contain("if sym != nil:")
        expect(source).to_not_contain("if found_local_type.?:")
        expect(source).to_not_contain("if ts_res.?:")
        expect(source).to_not_contain("if sym.?: sym.name")
        expect(source).to_contain("[mir-method-call] start method={{method}}")
        expect(source).to_contain("[mir-method-call] enum-owner method={{method}}")
        expect(source).to_contain("[mir-method-call] gpu-owner method={{method}}")
        expect(source).to_contain("[mir-method-call] receiver-type method={{method}}")
        expect(source).to_contain("[mir-method-call] writeback-done method={{method}}")
        expect(source).to_contain("[mir-method-call] resolution-enter method={{method}}")
        expect(source).to_contain("[mir-method-call] resolution-arm=instance method={{method}}")
        expect(source).to_contain("[mir-method-call] resolution-arm=unresolved method={{method}}")
        expect(source).to_contain("[mir-method-call] unresolved-receiver method={{method}}")
        expect(source).to_contain("[mir-method-call] push-enter local={{unresolved_receiver_local.id}}")
        expect(source).to_contain("me lower_unresolved_array_push(")
        expect(source).to_contain("return self.lower_unresolved_array_push(")
        expect(source).to_contain("Once custom-owner")
