"""Failure-only attribution follows actual frozen edges without changing readiness."""
use std.spec.*
use compiler.driver.driver_worker_surface_graph_v1.{worker_surface_ready_v1,
    worker_surface_gap_v1, worker_surface_gap_message_v1}

describe "blocked worker surface attribution":
    it "identifies an unbuilt target itself":
        val gap = worker_surface_gap_v1(0, [false], [[]])
        expect(gap.reason).to_equal("unbuilt-root")
        expect(gap.target_index).to_equal(0)
        expect(gap.inspected_edges).to_equal(0)

    it "finds the actual transitive missing edge through a cycle":
        val built = [true, true, false, false]
        val edges = [[1], [0, 2], [], []]
        val before = worker_surface_ready_v1(built, edges)
        val gap = worker_surface_gap_v1(0, built, edges)
        expect(gap.reason).to_equal("unbuilt-dependency")
        expect(gap.source_index).to_equal(1)
        expect(gap.target_index).to_equal(2)
        expect(gap.inspected_edges).to_equal(3)
        expect(before).to_equal([false, false, false, false])
        expect(worker_surface_ready_v1(built, edges)).to_equal(before)

    it "does not blame an unrelated unbuilt surface or an absent negative route":
        val gap = worker_surface_gap_v1(0, [true, false], [[-1], []])
        expect(gap.reason).to_equal("no-missing-surface")
        expect(gap.target_index).to_equal(-1)

    it "terminates a fully built cycle without inventing a gap":
        val gap = worker_surface_gap_v1(0, [true, true], [[1], [0]])
        expect(gap.reason).to_equal("no-missing-surface")
        expect(gap.inspected_edges).to_equal(2)

    it "reports the actual invalid edge instead of indexing outside the registry":
        val gap = worker_surface_gap_v1(0, [true], [[9]])
        expect(gap.reason).to_equal("invalid-edge")
        expect(gap.source_index).to_equal(0)
        expect(gap.target_index).to_equal(9)
        val message = worker_surface_gap_message_v1(gap, "root", "root", "<no-surface>")
        expect(message.contains("blocking_target=root")).to_equal(true)
        expect(message.contains("target=<no-surface>")).to_equal(true)

    it "reports bounded search exhaustion without guessing the unseen dependency":
        val gap = worker_surface_gap_v1(0, [true, true, false], [[1], [2], []], 1)
        expect(gap.reason).to_equal("search-limit")
        expect(gap.target_index).to_equal(-1)
        expect(gap.inspected_edges).to_equal(1)

    it "rejects an invalid root and handles a missing edge row":
        expect(worker_surface_gap_v1(2, [true], [[]]).reason).to_equal("invalid-root")
        expect(worker_surface_gap_v1(0, [true], []).reason).to_equal("no-missing-surface")

    it "bounds path text and labels truncation":
        var long_path = ""
        for i in 0..600: long_path = long_path + "x"
        val message = worker_surface_gap_message_v1(worker_surface_gap_v1(0, [false], [[]]), long_path, long_path, long_path)
        expect(message.contains("...[truncated]")).to_equal(true)
        expect(message.len() < 1900).to_equal(true)

    it "preserves UTF-8 scalars at the byte truncation boundary":
        var prefix = ""
        for i in 0..511: prefix = prefix + "x"
        val gap = worker_surface_gap_v1(0, [false], [[]])
        for scalar in ["é", "한", "😀"]:
            val message = worker_surface_gap_message_v1(gap, prefix + scalar, "", "")
            expect(message.starts_with("blocking_target=" + prefix + "...[truncated] reachable-gap=")).to_equal(true)
        val exact = prefix + "x"
        expect(worker_surface_gap_message_v1(gap, exact, "", "").starts_with("blocking_target=" + exact + " reachable-gap=")).to_equal(true)

    it "finds unbuilt dependencies past 256 edges under the default limit":
        var built: [bool] = []
        var edges: [[i64]] = []
        var idx = 0
        while idx < 299:
            built.push(true)
            edges.push([idx + 1])
            idx = idx + 1
        built.push(false)
        edges.push([])
        val gap = worker_surface_gap_v1(0, built, edges)
        expect(gap.reason).to_equal("unbuilt-dependency")
        expect(gap.source_index).to_equal(298)
        expect(gap.target_index).to_equal(299)
        expect(gap.inspected_edges).to_equal(299)

    it "visits each node once across diamonds and cycles":
        val gap = worker_surface_gap_v1(0, [true, true, true, true], [[1, 2], [3], [3], [0]])
        expect(gap.reason).to_equal("no-missing-surface")
        expect(gap.inspected_edges).to_equal(5)
