"""
# Bare Optional In Condition Position Routes Through rt_is_some

Regression guard for bug
`bare_optional_in_condition_position_wrong_branch_2026-08-01`: a bare `T?`
used directly as an `if`/`while` condition (no `.?`) used to fall straight
through `lower_cond_expr`'s `case _:` arm to `lower_expr`, branching on the
raw i64 payload/sentinel. `RT_NIL` is the non-zero sentinel `3`, so an ABSENT
optional read as truthy -- the then-branch was silently taken when it should
not have been.

This is a source-content guard, not a runtime execution spec: the fix lives
in the pure-Simple self-hosted compiler
(`src/compiler/50.mir/mir_lowering_stmts.spl`), which the currently deployed
`bin/simple` (a Rust bootstrap seed, see `bin/simple --version`) does not
execute -- the seed has its own independent Rust MIR lowering and never reads
this file's compiled behavior. A true end-to-end runtime check requires a
self-hosted binary built via full bootstrap (T3), which is out of scope for
an ordinary spec run. This spec instead asserts the exact fix shape is
present in source, which is real, sabotage-provable execution evidence today
(revert the fix -> this spec goes RED; restore it -> GREEN), pending someone
with T3 bootstrap access to additionally confirm the runtime repro from the
bug doc.
"""

extern fn rt_file_read_text(path: text) -> text

describe "bare Optional in condition position (lower_cond_expr)":
    it "routes a bare Optional-typed condition through rt_is_some, not raw branching":
        val source = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(source).to_contain("Bug bare_optional_in_condition_position_wrong_branch")
        expect(source).to_contain("case HirTypeKind.Optional(_):")
        expect(source).to_contain("cond_is_optional = true")
        expect(source).to_contain("is_some_func_bare")
        expect(source).to_contain("rt_is_some")
