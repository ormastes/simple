"""Interpreter cache validation must read the authored source, not demo text."""

use std.spec.step
use std.io_runtime.{read_file_text}

describe "interpreter cache source ownership":
    it "uses the canonical nullable read facade":
        step("Load the tier-one interpreter API")
        val source = read_file_text("src/compiler/80.driver/driver_api_interpret.spl")
        expect(source).to_contain("file_read_nullable(path)")
        expect(source).to_not_contain("use std.file_system")
        expect(source).to_not_contain("file_read_text(path)")
        expect(source).to_not_contain("unsafe(capabilities: [ffi])")
