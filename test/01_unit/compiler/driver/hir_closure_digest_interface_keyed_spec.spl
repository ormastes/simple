"""
# HIR Closure Digest Interface-Keying Specification

**Category:** Infrastructure
**Covers:** compiler.driver.driver_hir_cache.hir_cache_closure_digest

## Why this exists

`hir_cache_closure_digest` used to fold every surface's raw `content_hash`, so
a comment or body edit anywhere in the closure invalidated all HIR cache
entries — a 0% incremental hit rate by construction on a ~60 minute phase.
It now folds each surface's canonical INTERFACE encoding instead, falling back
to the content hash per surface when the interface cannot be encoded.

Both halves are asserted here, and the second is the one that matters:

  - the SKIP half — a body-only edit must NOT change the digest (the win);
  - the REBUILD half — every interface change MUST change it (the safety
    property). A cache that skips something it should have rebuilt produces a
    silently stale compiler binary, which is far worse than a slow build.

The fallback is asserted to be both SAFE (content hash still folded, so the
old over-invalidating behaviour returns) and ATTRIBUTABLE (counted), because a
silent degradation to fallback would look exactly like a merely cold cache.
"""

use std.spec.*
use std.io_runtime.{env_get_nullable, env_set, env_remove_process}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.driver.driver_hir_cache.{hir_cache_closure_digest, hir_cache_closure_fallback_count_v1}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfacesByName}

fn freeze_source_closure(source: text) -> ModuleSurfacesByName:
    val log = Logger(level: 0)
    val ast = parse_full_frontend(source, "m.spl", "m", log)
    var modules: Dict<text, Module> = {}
    modules["m"] = ast
    val sources = [SourceFile(path: "m.spl", content: source, module_name: "m")]
    module_surfaces_from_modules(modules, sources).unwrap()

fn with_interface_closure_key(surfaces: ModuleSurfacesByName) -> text:
    val prev = env_get_nullable("SIMPLE_HIR_CACHE_CLOSURE_KEY")
    val _set = env_set("SIMPLE_HIR_CACHE_CLOSURE_KEY", "interface")
    val result = hir_cache_closure_digest(surfaces)
    if val p = prev:
        val _restored = env_set("SIMPLE_HIR_CACHE_CLOSURE_KEY", p)
    else:
        val _cleared = env_remove_process("SIMPLE_HIR_CACHE_CLOSURE_KEY")
    result

fn digest_of_source(source: text) -> text:
    with_interface_closure_key(freeze_source_closure(source))

fn digest_of_uncacheable(content_hash: i64) -> text:
    var s = ModuleSurface.empty("m")
    s.canonical_path = "m.spl"
    s.content_hash = content_hash
    s.content_length = 100
    s.frozen = true
    s.semantic_cacheable = false
    var index_by_name: Dict<text, i64> = {}
    index_by_name["m"] = 0
    val surfaces = ModuleSurfacesByName(
        surfaces: [s], index_by_name: index_by_name, ordered_names: ["m"],
        ordered_indices: [0], generation: 1, frozen: true)
    with_interface_closure_key(surfaces)

val BASE_SOURCE = "pub struct Point:\n    x: i64\n    y: i64\n\nfn helper() -> i64:\n    1\n"
val BODY_EDITED_SOURCE = "pub struct Point:\n    x: i64\n    y: i64\n\n# comment-only and body-only edit\nfn helper() -> i64:\n    2 + 3\n"

describe "SKIP half — a body-only edit does not invalidate":
    it "produces a non-empty, stable digest":
        val d = digest_of_source(BASE_SOURCE)
        expect(d == "").to_equal(false)
        expect(d).to_equal(digest_of_source(BASE_SOURCE))

    it "is UNCHANGED when only the body and comments change":
        # This is the entire point of the re-key: the interface is identical,
        # only the file bytes and function body moved.
        expect(digest_of_source(BASE_SOURCE)).to_equal(digest_of_source(BODY_EDITED_SOURCE))

    it "does not fall back for an encodable surface":
        val before = hir_cache_closure_fallback_count_v1()
        val d = digest_of_source(BASE_SOURCE)
        expect(d == "").to_equal(false)
        expect(hir_cache_closure_fallback_count_v1() - before).to_equal(0)

describe "REBUILD half — every interface change DOES invalidate":
    it "changes when a field is RETYPED":
        val retyped = "pub struct Point:\n    x: f64\n    y: i64\n\nfn helper() -> i64:\n    1\n"
        expect(digest_of_source(BASE_SOURCE) == digest_of_source(retyped)).to_equal(false)

    it "changes when a field is ADDED":
        val added = "pub struct Point:\n    x: i64\n    y: i64\n    z: i64\n\nfn helper() -> i64:\n    1\n"
        expect(digest_of_source(BASE_SOURCE) == digest_of_source(added)).to_equal(false)

    it "changes when a field is RENAMED":
        val renamed = "pub struct Point:\n    x: i64\n    w: i64\n\nfn helper() -> i64:\n    1\n"
        expect(digest_of_source(BASE_SOURCE) == digest_of_source(renamed)).to_equal(false)

    it "changes when field ORDER changes (layout is order-dependent)":
        val reordered = "pub struct Point:\n    y: i64\n    x: i64\n\nfn helper() -> i64:\n    1\n"
        expect(digest_of_source(BASE_SOURCE) == digest_of_source(reordered)).to_equal(false)

    it "changes when declaration VISIBILITY changes":
        val private_struct = "struct Point:\n    x: i64\n    y: i64\n\nfn helper() -> i64:\n    1\n"
        expect(digest_of_source(BASE_SOURCE) == digest_of_source(private_struct)).to_equal(false)

describe "fallback is SAFE and ATTRIBUTABLE":
    # An uncacheable surface (semantic_cacheable = false) falls back to its
    # content hash. Safety means the OLD over-invalidating behaviour returns for
    # that surface -- never that the surface is skipped.
    it "still produces a digest rather than failing":
        expect(digest_of_uncacheable(111) == "").to_equal(false)

    it "counts the fallback so a degraded build is attributable":
        val before = hir_cache_closure_fallback_count_v1()
        val d = digest_of_uncacheable(333)
        expect(d == "").to_equal(false)
        expect(hir_cache_closure_fallback_count_v1() - before).to_equal(1)

    it "RESTORES content-hash sensitivity for the fallen-back surface":
        # The decisive fail-closed assertion: because the interface could not be
        # encoded, the content hash is folded again, so any byte change still
        # invalidates. This is what makes an encoder gap slow rather than wrong.
        expect(digest_of_uncacheable(111) == digest_of_uncacheable(222)).to_equal(false)
