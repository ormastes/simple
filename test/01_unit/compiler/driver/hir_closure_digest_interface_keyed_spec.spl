"""
# HIR Closure Digest Interface-Keying Specification

**Category:** Infrastructure
**Covers:** compiler.driver.driver_hir_cache.hir_cache_closure_digest

## Why this exists

`hir_cache_closure_digest` used to fold every surface's raw `content_hash`, so
a comment or body edit anywhere in the closure invalidated all HIR cache
entries — a 0% incremental hit rate by construction on a ~60 minute phase.
It now folds each surface's canonical INTERFACE encoding instead, falling back
to the content hash per surface when the interface cannot be encoded.

Both halves are asserted here, and the second is the one that matters:

  - the SKIP half — a body-only edit must NOT change the digest (the win);
  - the REBUILD half — every interface change MUST change it (the safety
    property). A cache that skips something it should have rebuilt produces a
    silently stale compiler binary, which is far worse than a slow build.

The fallback is asserted to be both SAFE (content hash still folded, so the
old over-invalidating behaviour returns) and ATTRIBUTABLE (counted), because a
silent degradation to fallback would look exactly like a merely cold cache.
"""

use std.spec.*
use compiler.driver.driver_hir_cache.{hir_cache_closure_digest, hir_cache_iface_fallback_count}
use compiler.hir.hir_lowering.module_surface_types.{
    ModuleSurface, ModuleSurfacesByName, ModuleSurfaceComposite, ModuleSurfaceField
}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}

fn sp() -> Span:
    Span(0, 0, 0, 0, "", 0)

fn named(name: text) -> Type:
    Type(kind: TypeKind.Named(name, []), span: sp())

fn field(name: text, ty: Type) -> ModuleSurfaceField:
    ModuleSurfaceField(
        name: name, type_: ty, type_name: "", array_element_name: "",
        visibility: Visibility.Public, declaring_module: "m")

fn composite(fields: [ModuleSurfaceField]) -> ModuleSurfaceComposite:
    ModuleSurfaceComposite(
        name: "Point", kind: "struct", type_params: [], fields: fields,
        visibility: Visibility.Public, is_public: true, span: sp())

fn surface_with(fields: [ModuleSurfaceField], content_hash: i64) -> ModuleSurface:
    var s = ModuleSurface.empty("m")
    s.canonical_path = "m.spl"
    s.content_hash = content_hash
    s.content_length = 100
    s.composite_values = [composite(fields)]
    s.composite_names = ["Point"]
    s

fn closure_of(s: ModuleSurface) -> ModuleSurfacesByName:
    ModuleSurfacesByName(
        surfaces: [s], index_by_name: {}, ordered_names: ["m"],
        ordered_indices: [0], generation: 1, frozen: true)

fn digest_of(fields: [ModuleSurfaceField], content_hash: i64) -> text:
    hir_cache_closure_digest(closure_of(surface_with(fields, content_hash)))

val BASE: [ModuleSurfaceField] = [field("x", named("i64")), field("y", named("i64"))]

describe "SKIP half — a body-only edit does not invalidate":
    it "produces a non-empty, stable digest":
        val d = digest_of(BASE, 111)
        expect(d == "").to_equal(false)
        expect(d).to_equal(digest_of(BASE, 111))

    it "is UNCHANGED when only the content hash moves (body/comment edit)":
        # This is the entire point of the re-key: the interface is identical,
        # only the file bytes moved.
        expect(digest_of(BASE, 111)).to_equal(digest_of(BASE, 222))

    it "does not fall back for an encodable surface":
        val d = digest_of(BASE, 111)
        expect(d == "").to_equal(false)
        expect(hir_cache_iface_fallback_count()).to_equal(0)

describe "REBUILD half — every interface change DOES invalidate":
    it "changes when a field is RETYPED":
        val retyped = [field("x", named("f64")), field("y", named("i64"))]
        expect(digest_of(BASE, 111) == digest_of(retyped, 111)).to_equal(false)

    it "changes when a field is ADDED":
        val added = [field("x", named("i64")), field("y", named("i64")), field("z", named("i64"))]
        expect(digest_of(BASE, 111) == digest_of(added, 111)).to_equal(false)

    it "changes when a field is RENAMED":
        val renamed = [field("x", named("i64")), field("w", named("i64"))]
        expect(digest_of(BASE, 111) == digest_of(renamed, 111)).to_equal(false)

    it "changes when field ORDER changes (layout is order-dependent)":
        val reordered = [field("y", named("i64")), field("x", named("i64"))]
        expect(digest_of(BASE, 111) == digest_of(reordered, 111)).to_equal(false)

    it "changes when a field VISIBILITY changes":
        var hidden_field = field("x", named("i64"))
        hidden_field.visibility = Visibility.Private
        val changed = [hidden_field, field("y", named("i64"))]
        expect(digest_of(BASE, 111) == digest_of(changed, 111)).to_equal(false)

describe "fallback is SAFE and ATTRIBUTABLE":
    # A field whose type cannot be encoded (Infer) makes the whole surface fall
    # back to its content hash. Safety means the OLD over-invalidating
    # behaviour returns for that surface -- never that the surface is skipped.
    val UNENCODABLE: [ModuleSurfaceField] = [field("x", Type(kind: TypeKind.Infer, span: sp()))]

    it "still produces a digest rather than failing":
        expect(digest_of(UNENCODABLE, 111) == "").to_equal(false)

    it "counts the fallback so a degraded build is attributable":
        val d = digest_of(UNENCODABLE, 111)
        expect(d == "").to_equal(false)
        expect(hir_cache_iface_fallback_count()).to_equal(1)

    it "RESTORES content-hash sensitivity for the fallen-back surface":
        # The decisive fail-closed assertion: because the interface could not be
        # encoded, the content hash is folded again, so any byte change still
        # invalidates. This is what makes an encoder gap slow rather than wrong.
        expect(digest_of(UNENCODABLE, 111) == digest_of(UNENCODABLE, 222)).to_equal(false)
