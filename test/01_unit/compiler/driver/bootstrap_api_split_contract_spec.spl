use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "bootstrap API split contract":
    it "keeps compatibility exports while focused builds bypass the facade":
        val facade = file_read("src/compiler/driver/bootstrap_api.spl")
        val focused = file_read("src/app/cli/bootstrap_focused_native_build.spl")
        expect(facade).to_contain("bootstrap_api_fixed")
        expect(facade).to_contain("bootstrap_api_low_memory")
        expect(facade.contains("pub fn aot_native_project_with_backend_fixed(")).to_equal(false)
        expect(focused).to_contain("compiler.driver.bootstrap_api_fixed")
