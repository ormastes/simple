use std.spec.{describe, it, expect, step}
use app.io.dir_ops.{dir_create_all, dir_remove_all}
use app.io.file_ops.{file_exists, file_write}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use compiler.driver.driver_build.native_cache_lease.{
    native_cache_lease_begin, native_cache_lease_end, native_cache_sweep_with_lease
}

describe "native cache leases":
    it "defers cache deletion while another build owns a lease":
        step("defer cache deletion while another build owns a lease")
        val root = "build/native-cache-lease-{getpid()}-{time_now_unix_micros()}"
        val stale = root + "/s264d59a3c4d238c02222a5fc874a842c"
        expect(dir_create_all(stale)).to_equal(true)
        expect(file_write(stale + "/object.o", "object")).to_equal(true)
        val builder = native_cache_lease_begin(root).unwrap()
        val sweeper = native_cache_lease_begin(root).unwrap()
        expect(native_cache_sweep_with_lease(sweeper, "", 1, 0)).to_equal(0)
        expect(file_exists(stale + "/object.o")).to_equal(true)
        native_cache_lease_end(builder)
        expect(native_cache_sweep_with_lease(sweeper, "", 1, 0)).to_equal(1)
        expect(file_exists(stale + "/object.o")).to_equal(false)
        native_cache_lease_end(sweeper)
        expect(dir_remove_all(root)).to_equal(true)

    it "protects planner and collection scopes with the base coordinator lease":
        step("protect planner and collection scopes with the base coordinator lease")
        val root = "build/native-cache-lease-{getpid()}-{time_now_unix_micros()}"
        val hash = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        val derived = root + "/planner-" + hash + "/collection-" + hash
        val stale = derived + "/s264d59a3c4d238c02222a5fc874a842c"
        expect(dir_create_all(stale)).to_equal(true)
        expect(file_write(stale + "/object.o", "object")).to_equal(true)
        val coordinator = native_cache_lease_begin(root).unwrap()
        val sweeper = native_cache_lease_begin(derived).unwrap()
        expect(native_cache_sweep_with_lease(sweeper, "", 1, 0)).to_equal(0)
        expect(file_exists(stale + "/object.o")).to_equal(true)
        native_cache_lease_end(coordinator)
        expect(native_cache_sweep_with_lease(sweeper, "", 1, 0)).to_equal(1)
        expect(file_exists(stale + "/object.o")).to_equal(false)
        native_cache_lease_end(sweeper)
        expect(dir_remove_all(root)).to_equal(true)
