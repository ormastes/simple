"""
## Purpose and audience
Purpose: Prove that bootstrap MIR-to-LLVM owner mutation.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-DRIVER-001 — stable requirement identity for this spec.

use compiler.mir.mir_instruction_graph.{MirBlock, MirInst}
use compiler.mir.mir_instruction_support.{BlockId, SwitchCase, MirOperand, MirOperandKind, mir_operand_const_int, mir_operand_const_float, mir_operand_const_bool, mir_operand_copy, mir_operand_move}
use compiler.mir.mir_instruction_kinds.{MirInstKind, MirTerminator}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirConstValue}

extern fn rt_file_read_text(path: text) -> text

use std.spec.step

describe "bootstrap MIR-to-LLVM owner mutation":
    it "selects the flat module through the MirToLlvm owner":
        step("Verify: selects the flat module through the MirToLlvm owner")
        # @req: REQ-COMPILER-DRIVER-001
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_bootstrap.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(driver).to_contain("translator.select_bootstrap_module(")
        expect(driver).to_contain("bootstrap_mir_static_module_at(static_idx)")
        expect(driver).to_contain("bootstrap_mir_function_module_at(idx)")
        expect(driver.contains("translator.current_bootstrap_module =")).to_equal(false)
        expect(translator).to_contain(
            "me select_bootstrap_module(module_index: i64):"
        )
        expect(translator).to_contain(
            "self.current_bootstrap_module = module_index"
        )

    it "resets function translation state through the MirToLlvm owner":
        step("Verify: resets function translation state through the MirToLlvm owner")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(codegen).to_contain("self.begin_function_translation(name)")
        expect(codegen.contains("self.current_function_name = name")).to_equal(false)
        expect(codegen.contains("self.local_types = {}" )).to_equal(false)
        expect(translator).to_contain(
            "me begin_function_translation(name: text):"
        )
        expect(translator).to_contain("self.current_function_name = name")
        expect(translator).to_contain("self.defined_func_names[name] = true")
        expect(translator).to_contain("self.local_types = {}")
        expect(translator).to_contain("self.alloca_elem_unsigned = {}")

    it "selects the function return type through the MirToLlvm owner":
        step("Verify: selects the function return type through the MirToLlvm owner")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(codegen).to_contain("self.set_function_return_type(ret_ty)")
        expect(codegen).to_contain(
            "self.set_function_return_type(effective_ret_ty)"
        )
        expect(codegen.contains("self.current_return_type = ret_ty")).to_equal(false)
        expect(codegen.contains(
            "self.current_return_type = effective_ret_ty"
        )).to_equal(false)
        expect(translator).to_contain(
            "me set_function_return_type(return_type: text):"
        )
        expect(translator).to_contain(
            "self.current_return_type = return_type"
        )

    it "reads the MIR body return type through the MirBody owner":
        step("Verify: reads the MIR body return type through the MirBody owner")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val body_owner = rt_file_read_text(
            "src/compiler/50.mir/mir_instruction_graph.spl"
        ) ?? ""

        expect(codegen.contains("body.return_ty)")).to_equal(false)
        expect(codegen.contains("body.return_ty.kind")).to_equal(false)
        expect(codegen).to_contain("body.bootstrap_return_type()")
        expect(body_owner).to_contain("me bootstrap_return_type() -> MirType:")
        expect(body_owner).to_contain("self.return_ty")

    it "constructs the flattened bootstrap MIR body through its owner":
        step("Verify: constructs the flattened bootstrap MIR body through its owner")
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_bootstrap.spl"
        ) ?? ""
        val body_owner = rt_file_read_text(
            "src/compiler/50.mir/mir_instruction_graph.spl"
        ) ?? ""

        expect(driver).to_contain("val body = MirBody.from_bootstrap_parts(")
        expect(driver.contains("val body = MirBody(")).to_equal(false)
        expect(body_owner).to_contain("static fn from_bootstrap_parts(")
        expect(body_owner).to_contain("return_ty: MirType.unit()")
        expect(driver.contains("var body_return_ty = MirType.i64()")).to_equal(false)
        expect(body_owner).to_contain("MirBody(")

    it "passes the flattened return ABI as owner-selected scalars":
        step("Verify: passes the flattened return ABI as owner-selected scalars")
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_bootstrap.spl"
        ) ?? ""
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(driver).to_contain("translator.translate_bootstrap_function_at(idx, bootstrap_ir_handle)")
        expect(driver.contains("bootstrap_static_llvm_type_text")).to_equal(false)
        expect(codegen).to_contain("me translate_bootstrap_function_at(index: i64, ir_handle: i64):")
        expect(codegen).to_contain("bootstrap_mir_function_return_unsigned_at(index)")
        expect(translator).to_contain("bootstrap_return_abi_text: text")
        expect(translator).to_contain("bootstrap_return_abi_unsigned: bool")
        expect(translator).to_contain("bootstrap_return_abi_active: bool")

    it "accumulates signedness independently from LLVM return type tags":
        step("Verify: accumulates signedness independently from LLVM return type tags")
        val globals = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/bootstrap_globals.spl"
        ) ?? ""

        expect(globals).to_contain("_bootstrap_mir_function_return_unsigned: [bool]")
        expect(globals).to_contain("bootstrap_mir_return_type_unsigned(fn_.signature.return_type)")
        expect(globals).to_contain("case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: true")
        expect(globals).to_contain("case MirTypeKind.I64 | MirTypeKind.U64: 1")
        expect(globals).to_contain("case MirTypeKind.Struct(_) | MirTypeKind.Enum(_) | MirTypeKind.Tuple(_)")
        expect(globals).to_contain("fn bootstrap_mir_function_return_unsigned_at(index: i64) -> bool:")
        expect(globals).to_contain("ret_unsigned={{_bootstrap_mir_function_return_unsigned.len()}}")

    it "projects nested block ids through the MirBlock owner":
        step("Verify: projects nested block ids through the MirBlock owner")
        val block = MirBlock(
            id: BlockId(id: 37),
            label: nil,
            instructions: [],
            terminator: MirTerminator.Unreachable
        )
        expect(block.bootstrap_block_id_value()).to_equal(37)  # oracle: 37 — named expected value from the requirement

        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val block_owner = rt_file_read_text(
            "src/compiler/50.mir/mir_instruction_graph.spl"
        ) ?? ""
        expect(codegen).to_contain("block.bootstrap_block_id_value()")
        expect(codegen.contains("self.block_id_value(block.id)")).to_equal(false)
        expect(block_owner).to_contain("me bootstrap_block_id_value() -> i64:")
        expect(block_owner).to_contain("self.id.id")

    it "keeps reusable block boundary traces bootstrap-debug gated":
        step("Verify: keeps reusable block boundary traces bootstrap-debug gated")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""

        expect(codegen).to_contain("val bootstrap_debug = (rt_env_get(\"SIMPLE_BOOTSTRAP_DEBUG\") ?? \"\") == \"1\"")
        expect(codegen).to_contain("[mir-to-llvm] block:label-before")
        expect(codegen).to_contain("[mir-to-llvm] block:label-after")
        expect(codegen).to_contain("[mir-to-llvm] block:instruction-before")
        expect(codegen).to_contain("[mir-to-llvm] block:instruction-after")
        expect(codegen).to_contain("[mir-to-llvm] block:terminator-before")
        expect(codegen).to_contain("[mir-to-llvm] block:terminator-after")

    it "dispatches indexed instructions without a MirInst method parameter":
        step("Verify: dispatches indexed instructions without a MirInst method parameter")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""

        expect(codegen).to_contain("val bootstrap_instructions = block.instructions")
        expect(codegen).to_contain("self.translate_instruction_at(bootstrap_instructions, bootstrap_inst_i)")
        expect(codegen).to_contain("me translate_instruction_at(instructions: [MirInst], index: i64):")
        expect(codegen).to_contain("val inst: MirInst = instructions[index]")
        expect(codegen).to_contain("me mark_instruction_dest_defined_at(instructions: [MirInst], index: i64):")
        expect(codegen.contains("self.translate_instruction(inst)")).to_equal(false)
        expect(codegen.contains("me translate_instruction(inst: MirInst)")).to_equal(false)
        expect(codegen.contains("me mark_instruction_dest_defined(inst: MirInst)")).to_equal(false)

    it "keeps indexed kind and Call dispatch observable":
        step("Verify: keeps indexed kind and Call dispatch observable")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""

        expect(codegen).to_contain("[mir-to-llvm] instruction:entry")
        expect(codegen).to_contain("[mir-to-llvm] instruction:kind")
        expect(codegen).to_contain("[mir-to-llvm] instruction:const-discriminant")
        expect(codegen).to_contain("[mir-to-llvm] instruction:copy-discriminant")
        expect(codegen).to_contain("[mir-to-llvm] instruction:call")

        val call_inst = MirInst(
            kind: MirInstKind.Call(nil, mir_operand_const_int(0), []),
            span: nil
        )
        val instructions: [MirInst] = [call_inst]
        val fetched: MirInst = instructions[0]
        match fetched.kind:
            case MirInstKind.Call(dest, _, args):
                expect(dest == nil).to_equal(true)
                expect(args.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            case _:
                expect(false).to_equal(true)

    it "routes Call payloads through indexed aggregate-safe helpers":
        step("Verify: routes Call payloads through indexed aggregate-safe helpers")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""

        expect(codegen).to_contain("self.translate_call_at(instructions, index)")
        expect(codegen).to_contain("me translate_call_at(instructions: [MirInst], index: i64):")
        expect(codegen.contains("self.translate_call(dest, func, args)")).to_equal(false)
        expect(codegen).to_contain("self.translate_operand_at(callee_operands, 0)")
        expect(codegen).to_contain("self.translate_operand_at(args, arg_i)")
        expect(codegen).to_contain("self.get_operand_type_at(args, arg_i)")
        expect(codegen).to_contain("self.get_operand_unsigned_at(args, arg_i)")
        expect(codegen).to_contain("if has_dest:")
        expect(codegen).to_contain("else:\n            self.builder.emit(\"  call void")

    it "keeps present nil and typed Call payloads distinct":
        step("Verify: keeps present nil and typed Call payloads distinct")
        val present = MirInst(
            kind: MirInstKind.Call(
                Some(LocalId(id: 0)),
                mir_operand_copy(LocalId(id: 1)),
                [mir_operand_copy(LocalId(id: 2))]
            ),
            span: nil
        )
        val absent = MirInst(
            kind: MirInstKind.Call(nil, mir_operand_const_int(0), []),
            span: nil
        )
        val instructions: [MirInst] = [present, absent]
        match instructions[0].kind:
            case MirInstKind.Call(dest, callee, args):
                expect(dest != nil).to_equal(true)
                expect(args.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
                match callee.kind:
                    case Copy(local): expect(local.id).to_equal(1)  # oracle: 1 — named expected value from the requirement
                    case _: expect(false).to_equal(true)
            case _: expect(false).to_equal(true)
        match instructions[1].kind:
            case MirInstKind.Call(dest, _, args):
                expect(dest == nil).to_equal(true)
                expect(args.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            case _: expect(false).to_equal(true)

    it "keeps Call progress markers bootstrap-debug gated":
        step("Verify: keeps Call progress markers bootstrap-debug gated")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        expect(codegen).to_contain("[mir-to-llvm] call:entry")
        expect(codegen).to_contain("[mir-to-llvm] call:matched")
        expect(codegen).to_contain("[mir-to-llvm] call:dest")
        expect(codegen).to_contain("[mir-to-llvm] call:callee")
        expect(codegen).to_contain("[mir-to-llvm] call:arg-before")
        expect(codegen).to_contain("[mir-to-llvm] call:arg-after")
        expect(codegen).to_contain("[mir-to-llvm] call:emit")

    it "projects terminator block and switch targets through their owners":
        step("Verify: projects terminator block and switch targets through their owners")
        expect(BlockId(id: 73).bootstrap_value()).to_equal(73)  # oracle: 73 — named expected value from the requirement
        val switch_case = SwitchCase(value: 19, target: BlockId(id: 91))
        expect(switch_case.bootstrap_value()).to_equal(19)  # oracle: 19 — named expected value from the requirement
        expect(switch_case.bootstrap_target_value()).to_equal(91)  # oracle: 91 — named expected value from the requirement

    it "routes every terminator through indexed blocks and scalar targets":
        step("Verify: routes every terminator through indexed blocks and scalar targets")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val support = rt_file_read_text(
            "src/compiler/50.mir/mir_instruction_support.spl"
        ) ?? ""

        expect(codegen).to_contain("self.translate_block_at(body.blocks, block_i, effective_ret_ty, is_start, return_slot_id)")
        expect(codegen).to_contain("me translate_block_at(blocks: [MirBlock], block_index: i64, return_type_text: text, is_start: bool, return_slot_id: i64):")
        expect(codegen).to_contain("self.translate_terminator_at(blocks, block_index, return_type_text, is_start, return_slot_id)")
        expect(codegen).to_contain("me translate_terminator_at(blocks: [MirBlock], block_index: i64, return_type_text: text, is_start: bool, return_slot_id: i64):")
        expect(codegen).to_contain("val term = block.terminator")
        expect(codegen.contains("self.translate_terminator(block.terminator)")).to_equal(false)
        expect(codegen).to_contain("blocks[block_index].bootstrap_ret_kind()")
        expect(codegen).to_contain("blocks[block_index].bootstrap_ret_local_id()")
        expect(codegen).to_contain("blocks[block_index].bootstrap_ret_const_kind()")
        expect(codegen).to_contain("blocks[block_index].bootstrap_ret_const_scalar_text()")
        expect(codegen).to_contain("val ret_ty = self.valid_llvm_type(self.current_return_type)")
        expect(codegen.contains("value ?? mir_operand_const_int(0)")).to_equal(false)
        expect(codegen.contains("val ret_operand: MirOperand")).to_equal(false)
        expect(codegen.contains("translate_ret_operand_at")).to_equal(false)
        expect(codegen).to_contain("val target_id = target.bootstrap_value()")
        expect(codegen).to_contain("val then_id = then_.bootstrap_value()")
        expect(codegen).to_contain("val else_id = else_.bootstrap_value()")
        expect(codegen).to_contain("switch_case.bootstrap_target_value()")
        expect(codegen).to_contain("val normal_id = normal.bootstrap_value()")
        expect(codegen).to_contain("val dest_id = if has_dest: (dest ?? LocalId(id: 0)).id else: 0")
        expect(support).to_contain("fn bootstrap_value() -> i64:")
        expect(support).to_contain("fn bootstrap_target_value() -> i64:")
        expect(support.contains("fn bootstrap_ret_operands() -> [MirOperand]:")).to_equal(false)

    it "keeps indexed terminator variants and nonsequential ids intact":
        step("Verify: keeps indexed terminator variants and nonsequential ids intact")
        val ret_nil = MirTerminator.Ret(nil)
        val ret_const = MirTerminator.Ret(Some(mir_operand_const_int(7)))
        val ret_float = MirTerminator.Ret(Some(mir_operand_const_float(2.5)))
        val ret_bool = MirTerminator.Ret(Some(mir_operand_const_bool(true)))
        val ret_str = MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("hello"), MirType(kind: MirTypeKind.Opaque("str"))))))
        val ret_zero = MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Zero, MirType.i64()))))
        val ret_array = MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Array([]), MirType(kind: MirTypeKind.Array(MirType.i64(), 0))))))
        val ret_tuple = MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Tuple([]), MirType(kind: MirTypeKind.Tuple([]))))))
        val ret_struct = MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Struct({}), MirType(kind: MirTypeKind.Opaque("struct"))))))
        val ret_copy = MirTerminator.Ret(Some(mir_operand_copy(LocalId(id: 4))))
        val ret_move = MirTerminator.Ret(Some(mir_operand_move(LocalId(id: 5))))
        val goto = MirTerminator.Goto(BlockId(id: 41))
        val if_ = MirTerminator.If(mir_operand_const_int(1), BlockId(id: 53), BlockId(id: 79))
        val switch = MirTerminator.Switch(
            mir_operand_const_int(9),
            [SwitchCase(value: 9, target: BlockId(id: 101))],
            BlockId(id: 137)
        )
        val unreachable = MirTerminator.Unreachable
        val abort = MirTerminator.Abort("stop")
        val call_plain = MirTerminator.CallTerminator(
            nil, mir_operand_const_int(0), [], BlockId(id: 149), nil
        )
        val call_invoke = MirTerminator.CallTerminator(
            Some(LocalId(id: 6)), mir_operand_copy(LocalId(id: 8)),
            [mir_operand_const_int(3)], BlockId(id: 163), Some(BlockId(id: 181))
        )

        val ret_blocks = [
            MirBlock(id: BlockId(id: 1), label: nil, instructions: [], terminator: ret_nil),
            MirBlock(id: BlockId(id: 2), label: nil, instructions: [], terminator: ret_copy),
            MirBlock(id: BlockId(id: 3), label: nil, instructions: [], terminator: ret_move),
            MirBlock(id: BlockId(id: 4), label: nil, instructions: [], terminator: ret_const),
            MirBlock(id: BlockId(id: 5), label: nil, instructions: [], terminator: ret_float),
            MirBlock(id: BlockId(id: 6), label: nil, instructions: [], terminator: ret_bool),
            MirBlock(id: BlockId(id: 7), label: nil, instructions: [], terminator: ret_str),
            MirBlock(id: BlockId(id: 8), label: nil, instructions: [], terminator: ret_zero),
            MirBlock(id: BlockId(id: 9), label: nil, instructions: [], terminator: ret_array),
            MirBlock(id: BlockId(id: 10), label: nil, instructions: [], terminator: ret_tuple),
            MirBlock(id: BlockId(id: 11), label: nil, instructions: [], terminator: ret_struct)
        ]
        expect(ret_blocks[0].bootstrap_ret_kind()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(ret_blocks[1].bootstrap_ret_kind()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ret_blocks[2].bootstrap_ret_kind()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(ret_blocks[1].bootstrap_ret_local_id()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(ret_blocks[2].bootstrap_ret_local_id()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(ret_blocks[3].bootstrap_ret_kind()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(ret_blocks[3].bootstrap_ret_const_kind()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ret_blocks[3].bootstrap_ret_const_scalar_text()).to_equal("7")
        expect(ret_blocks[4].bootstrap_ret_const_kind()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(ret_blocks[4].bootstrap_ret_const_scalar_text()).to_equal("2.5")
        expect(ret_blocks[5].bootstrap_ret_const_kind()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(ret_blocks[5].bootstrap_ret_const_scalar_text()).to_equal("1")
        expect(ret_blocks[6].bootstrap_ret_const_kind()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(ret_blocks[6].bootstrap_ret_const_scalar_text()).to_equal("hello")
        expect(ret_blocks[7].bootstrap_ret_const_kind()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(ret_blocks[7].bootstrap_ret_const_scalar_text()).to_equal("0")
        expect(ret_blocks[8].bootstrap_ret_const_kind()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(ret_blocks[8].bootstrap_ret_const_scalar_text()).to_equal("zeroinitializer")
        expect(ret_blocks[9].bootstrap_ret_const_kind()).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(ret_blocks[9].bootstrap_ret_const_scalar_text()).to_equal("zeroinitializer")
        expect(ret_blocks[10].bootstrap_ret_const_kind()).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(ret_blocks[10].bootstrap_ret_const_scalar_text()).to_equal("zeroinitializer")
        match goto:
            case MirTerminator.Goto(target): expect(target.bootstrap_value()).to_equal(41)  # oracle: 41 — named expected value from the requirement
            case _: expect(false).to_equal(true)
        match if_:
            case MirTerminator.If(_, then_, else_):
                expect(then_.bootstrap_value()).to_equal(53)  # oracle: 53 — named expected value from the requirement
                expect(else_.bootstrap_value()).to_equal(79)  # oracle: 79 — named expected value from the requirement
            case _: expect(false).to_equal(true)
        match switch:
            case MirTerminator.Switch(_, targets, default):
                expect(targets[0].bootstrap_target_value()).to_equal(101)  # oracle: 101 — named expected value from the requirement
                expect(default.bootstrap_value()).to_equal(137)  # oracle: 137 — named expected value from the requirement
            case _: expect(false).to_equal(true)
        var saw_unreachable = false
        match unreachable:
            case MirTerminator.Unreachable: saw_unreachable = true
            case _: expect(false).to_equal(true)
        expect(saw_unreachable).to_equal(true)
        match abort:
            case MirTerminator.Abort(message): expect(message).to_equal("stop")
            case _: expect(false).to_equal(true)
        match call_plain:
            case MirTerminator.CallTerminator(dest, _, args, normal, unwind):
                expect(dest == nil).to_equal(true)
                expect(args.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(normal.bootstrap_value()).to_equal(149)  # oracle: 149 — named expected value from the requirement
                expect(unwind == nil).to_equal(true)
            case _: expect(false).to_equal(true)
        match call_invoke:
            case MirTerminator.CallTerminator(dest, _, args, normal, unwind):
                expect((dest ?? LocalId(id: 0)).id).to_equal(6)  # oracle: 6 — named expected value from the requirement
                expect(args.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
                expect(normal.bootstrap_value()).to_equal(163)  # oracle: 163 — named expected value from the requirement
                expect((unwind ?? BlockId(id: 0)).bootstrap_value()).to_equal(181)  # oracle: 181 — named expected value from the requirement
            case _: expect(false).to_equal(true)

    it "keeps indexed terminator progress markers bootstrap-debug gated":
        step("Verify: keeps indexed terminator progress markers bootstrap-debug gated")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        expect(codegen).to_contain("[mir-to-llvm] terminator:entry")
        expect(codegen).to_contain("[mir-to-llvm] terminator:kind")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-scalar-kind")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-scalar-local")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-scalar-const")
        expect(codegen).to_contain("[mir-to-llvm] terminator:goto")
        expect(codegen).to_contain("[mir-to-llvm] terminator:if")
        expect(codegen).to_contain("[mir-to-llvm] terminator:switch")
        expect(codegen).to_contain("[mir-to-llvm] terminator:unreachable")
        expect(codegen).to_contain("[mir-to-llvm] terminator:abort")
        expect(codegen).to_contain("[mir-to-llvm] terminator:call")
        expect(codegen).to_contain("[mir-to-llvm] terminator:emit")

    it "threads primitive return state into indexed terminators":
        step("Verify: threads primitive return state into indexed terminators")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(codegen).to_contain("var return_slot_id = -1")
        expect(codegen).to_contain("return_slot_id = local_id")
        expect(codegen).to_contain("val is_start = name == \"_start\"")
        expect(codegen).to_contain("effective_ret_ty, is_start, return_slot_id")
        expect(codegen).to_contain("return_local_id == return_slot_id")
        expect(codegen).to_contain("not self.local_types.has(return_local_id)")
        expect(codegen).to_contain("not self.defined_locals.has(return_local_id)")
        expect(codegen).to_contain("val val_str = \"%l" + "{" + "return_local_id}\"")
        expect(codegen).to_contain("val ret_ty = self.valid_llvm_type(return_type_text)")
        expect(codegen).to_contain("self.builder.emit_ret(ret_ty, self.ret_value_for_type(ret_ty, val_str))")
        expect(codegen).to_contain("materialize any required value cast before this edge")
        expect(translator.contains("fn bootstrap_return_decision(local_id: i64) -> i64:")).to_equal(false)
        expect(translator.contains("fn bootstrap_return_type_text() -> text:")).to_equal(false)
        expect(translator.contains("fn bootstrap_return_local_value_text(local_id: i64) -> text:")).to_equal(false)
        expect(translator.contains("fn bootstrap_return_local_type_text(local_id: i64) -> text:")).to_equal(false)

    it "keeps threaded return decisions observable":
        step("Verify: keeps threaded return decisions observable")
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-threaded-type")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-threaded-status")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-threaded-fallback")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-threaded-value")
        expect(codegen).to_contain("[mir-to-llvm] terminator:ret-threaded-abi")
