extern fn rt_file_read_text(path: text) -> text

describe "bootstrap MIR-to-LLVM owner mutation":
    it "selects the flat module through the MirToLlvm owner":
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_bootstrap.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(driver).to_contain("translator.select_bootstrap_module(")
        expect(driver).to_contain("bootstrap_mir_static_module_at(static_idx)")
        expect(driver).to_contain("bootstrap_mir_function_module_at(idx)")
        expect(driver.contains("translator.current_bootstrap_module =")).to_equal(false)
        expect(translator).to_contain(
            "me select_bootstrap_module(module_index: i64):"
        )
        expect(translator).to_contain(
            "self.current_bootstrap_module = module_index"
        )

    it "resets function translation state through the MirToLlvm owner":
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(codegen).to_contain("self.begin_function_translation(name)")
        expect(codegen.contains("self.current_function_name = name")).to_equal(false)
        expect(codegen.contains("self.local_types = {}" )).to_equal(false)
        expect(translator).to_contain(
            "me begin_function_translation(name: text):"
        )
        expect(translator).to_contain("self.current_function_name = name")
        expect(translator).to_contain("self.defined_func_names[name] = true")
        expect(translator).to_contain("self.local_types = {}")
        expect(translator).to_contain("self.alloca_elem_unsigned = {}")

    it "selects the function return type through the MirToLlvm owner":
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val translator = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/class_def.spl"
        ) ?? ""

        expect(codegen).to_contain("self.set_function_return_type(ret_ty)")
        expect(codegen).to_contain(
            "self.set_function_return_type(effective_ret_ty)"
        )
        expect(codegen.contains("self.current_return_type = ret_ty")).to_equal(false)
        expect(codegen.contains(
            "self.current_return_type = effective_ret_ty"
        )).to_equal(false)
        expect(translator).to_contain(
            "me set_function_return_type(return_type: text):"
        )
        expect(translator).to_contain(
            "self.current_return_type = return_type"
        )

    it "reads the MIR body return type through the MirBody owner":
        val codegen = rt_file_read_text(
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ) ?? ""
        val body_owner = rt_file_read_text(
            "src/compiler/50.mir/mir_instruction_graph.spl"
        ) ?? ""

        expect(codegen.contains("body.return_ty)")).to_equal(false)
        expect(codegen.contains("body.return_ty.kind")).to_equal(false)
        expect(codegen).to_contain("body.bootstrap_return_type()")
        expect(body_owner).to_contain("me bootstrap_return_type() -> MirType:")
        expect(body_owner).to_contain("self.return_ty")

    it "constructs the flattened bootstrap MIR body through its owner":
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_bootstrap.spl"
        ) ?? ""
        val body_owner = rt_file_read_text(
            "src/compiler/50.mir/mir_instruction_graph.spl"
        ) ?? ""

        expect(driver).to_contain("val body = MirBody.from_parts(")
        expect(driver.contains("val body = MirBody(")).to_equal(false)
        expect(body_owner).to_contain("static fn from_parts(")
        expect(body_owner).to_contain("return_ty: MirType")
        expect(body_owner).to_contain("MirBody(")
