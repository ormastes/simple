# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/go_to_end.spl 0%
"""
# native-build --go-to-end under default dynload: emit format

**Category:** Compiler / driver

## Purpose and Audience

Run 12 (`native-build --keep-going --go-to-end`, default `--mode dynload`)
lowered 1503/1516 modules, then emitted 0 objects: dynload maps to
OutputFormat.Both, which the per-module native lane refuses. This spec pins
the plan that fixes it: one failing module plus passing modules downgrades
Both to Native so the passing modules reach the backend.

## Expected Outcome

With failures, Both becomes Native; without failures, or for other formats,
the format is unchanged.
"""
use std.spec.step
use std.spec.{describe, it, assert_true, assert_false}
use compiler.common.driver_core_modes.{driver_output_format_native,
    driver_output_format_both, driver_output_format_is_both,
    driver_output_format_is_smf}
use app.cli.native_build_output_plan.{native_build_output_format_v1}
use compiler.driver.driver_build.go_to_end.{go_to_end_emit_format_v1}

describe "go-to-end emit format under dynload":
    it "default dynload plans OutputFormat.Both (failure shape)":
        # @req REQ-SSPEC-COMPILER
        step("default dynload plans OutputFormat.Both")
        val planned = native_build_output_format_v1("dynload", false, false, false)
        assert_true(driver_output_format_is_both(planned))

    it "one failing module downgrades Both to Native so passing modules emit objects":
        # @req REQ-SSPEC-COMPILER
        step("one failing module downgrades Both to Native")
        val planned = native_build_output_format_v1("dynload", false, false, false)
        val emitted = go_to_end_emit_format_v1(planned, 1)
        assert_false(driver_output_format_is_both(emitted) or driver_output_format_is_smf(emitted))
        assert_false(driver_output_format_is_both(emitted))

    it "keeps Both when nothing failed":
        # @req REQ-SSPEC-COMPILER
        step("keeps Both when nothing failed")
        val emitted = go_to_end_emit_format_v1(driver_output_format_both(), 0)
        assert_true(driver_output_format_is_both(emitted))

    it "leaves Native unchanged with failures":
        # @req REQ-SSPEC-COMPILER
        step("leaves Native unchanged with failures")
        val emitted = go_to_end_emit_format_v1(driver_output_format_native(), 72)
        assert_false(driver_output_format_is_both(emitted) or driver_output_format_is_smf(emitted))
