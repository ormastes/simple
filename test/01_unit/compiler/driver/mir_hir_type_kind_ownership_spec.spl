"""
# MIR HIR Type Kind Ownership

Requires MIR type lowering patterns to name the HIR enum owner explicitly so
overlapping MIR variant names cannot capture Stage 3 optional fields.
"""

extern fn rt_file_read_text(path: text) -> text

describe "MIR HIR Type Kind Ownership":
    it "qualifies optional and primitive HIR type patterns":
        val source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""
        expect(source).to_contain("case HirTypeKind.Optional(inner):")
        expect(source).to_contain(
            "val optional_type_disc = rt_enum_discriminant(HirTypeKind.Optional(type_))")
        expect(source).to_contain(
            "if rt_enum_discriminant(type_.kind) == optional_type_disc:")
        expect(source).to_contain(
            "val named_type_disc = rt_enum_discriminant(HirTypeKind.Named(SymbolId(id: -1), []))")
        expect(source).to_contain(
            "if rt_enum_discriminant(type_.kind) == named_type_disc:")
        expect(source).to_contain("case HirTypeKind.Int(bits, signed):")
        expect(source).to_contain("case HirTypeKind.Named(symbol, _):")
        expect(source).to_contain("case HirTypeKind.Error:")
