use std.spec
use target_profile_native.{target_profile_native_check}
use compiler.common.driver_compile_options.*

describe "normalized target profiles":
    it "keeps optimization independent and validates managed policy and missing capability":
        expect(target_profile_native_check()).to_equal("")

    it "preserves ordinary default and explicit disabled debug requests":
        val absent = TargetTraceCapabilityV1.Unavailable("test-no-admission")
        val ordinary = target_profile_normalize_v1(TargetBuildProfileV1.Development, TargetDebugRequestV1.Default, false, absent)
        expect(ordinary.unwrap().trace_resolution).to_equal(TargetTraceResolutionV1.Disabled)
        val disabled = target_profile_normalize_v1(TargetBuildProfileV1.Development, TargetDebugRequestV1.Disabled, true, absent)
        expect(disabled.unwrap().trace_resolution).to_equal(TargetTraceResolutionV1.Disabled)

    it "rejects release with an explicit observer request":
        val invalid = target_profile_normalize_v1(TargetBuildProfileV1.Release, TargetDebugRequestV1.Enabled, false, TargetTraceCapabilityV1.Unavailable("test-no-admission"))
        expect(invalid.is_err()).to_equal(true)
