# Regression spec: default `DEFAULT_MAX_BYTES` in `cache_limits.spl` is 1 GiB
# (1073741824) unless overridden by `SIMPLE_CACHE_MAX_BYTES`.
# @cover src/compiler/80.driver/cache/metadata/cache_limits.spl

use std.spec.*
use std.io_runtime.{env_get_opt, env_set}
use compiler.driver.cache.metadata.cache_limits.{
    DEFAULT_MAX_BYTES, cache_limits_default, cache_limits_load,
    cache_retention_limits_load_v1
}

describe "Cache limits 1 GiB default":
    it "defaults machine and retention storage/memory maxima to 1 GiB and honours SIMPLE_CACHE_MAX_BYTES":
        val old_max = env_get_opt("SIMPLE_CACHE_MAX_BYTES") ?? ""
        val old_host_storage = env_get_opt("SIMPLE_HOST_CACHE_STORAGE_MAX_BYTES") ?? ""
        val old_mem = env_get_opt("SIMPLE_CACHE_MEMORY_MAX_BYTES") ?? ""
        val old_host_mem = env_get_opt("SIMPLE_HOST_CACHE_MEMORY_MAX_BYTES") ?? ""
        val _c1 = env_set("SIMPLE_CACHE_MAX_BYTES", "")
        val _c2 = env_set("SIMPLE_HOST_CACHE_STORAGE_MAX_BYTES", "")
        val _c3 = env_set("SIMPLE_CACHE_MEMORY_MAX_BYTES", "")
        val _c4 = env_set("SIMPLE_HOST_CACHE_MEMORY_MAX_BYTES", "")

        expect(DEFAULT_MAX_BYTES).to_equal(1073741824)
        expect(cache_limits_default().max_bytes).to_equal(1073741824)
        expect(cache_limits_load().max_bytes).to_equal(1073741824)
        val retention = cache_retention_limits_load_v1()
        expect(retention.storage_max_bytes).to_equal(1073741824)
        expect(retention.memory_max_bytes).to_equal(1073741824)

        val _s1 = env_set("SIMPLE_CACHE_MAX_BYTES", "268435456")
        expect(cache_limits_load().max_bytes).to_equal(268435456)
        expect(cache_retention_limits_load_v1().storage_max_bytes).to_equal(268435456)

        val _r1 = env_set("SIMPLE_CACHE_MAX_BYTES", old_max)
        val _r2 = env_set("SIMPLE_HOST_CACHE_STORAGE_MAX_BYTES", old_host_storage)
        val _r3 = env_set("SIMPLE_CACHE_MEMORY_MAX_BYTES", old_mem)
        val _r4 = env_set("SIMPLE_HOST_CACHE_MEMORY_MAX_BYTES", old_host_mem)
