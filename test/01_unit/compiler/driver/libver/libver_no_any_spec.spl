"""
## Purpose and audience

The lib-versioning module's API is stable and reusable. To keep it type-safe
and thread-safe without depending on a compiler session, the module must not
use Any. This spec verifies that requirement (AC-8).

## Operator workflow

Run: bin/simple test test/unit/compiler/driver/libver/libver_no_any_spec.spl

## Verification guidance

The spec reads each source file in src/compiler/80.driver/libver/ as text and
searches for uses of "Any" as a type. An erased type that slipped in will fail
the test.
"""

# @manual_section: type safety, no Any

use std.io_runtime.{file_read}
use std.spec.step

describe "LibVer type safety":
    # @req AC-8
    it "naming.spl contains no Any type":
        step("Read the source file and search for Any")
        val source = file_read("src/compiler/80.driver/libver/naming.spl")
        val has_any = source.contains(": Any") or source.contains(" Any ")
        expect(has_any).to_equal(false)

    # @req AC-8
    it "sidecar.spl contains no Any type":
        step("Read the source file and search for Any")
        val source = file_read("src/compiler/80.driver/libver/sidecar.spl")
        val has_any = source.contains(": Any") or source.contains(" Any ")
        expect(has_any).to_equal(false)

    # @req AC-8
    it "cache.spl contains no Any type":
        step("Read the source file and search for Any")
        val source = file_read("src/compiler/80.driver/libver/cache.spl")
        val has_any = source.contains(": Any") or source.contains(" Any ")
        expect(has_any).to_equal(false)

    # @req AC-8
    it "identity.spl contains no Any type":
        step("Read the source file and search for Any")
        val source = file_read("src/compiler/80.driver/libver/identity.spl")
        val has_any = source.contains(": Any") or source.contains(" Any ")
        expect(has_any).to_equal(false)

    # @req AC-8
    it "admit.spl contains no Any type":
        step("Read the source file and search for Any")
        val source = file_read("src/compiler/80.driver/libver/admit.spl")
        val has_any = source.contains(": Any") or source.contains(" Any ")
        expect(has_any).to_equal(false)
