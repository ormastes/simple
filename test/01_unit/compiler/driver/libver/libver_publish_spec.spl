"""
## Purpose and audience

Executable specification for library version publish manifest (AC-10).
Verifies that libver_publish_manifest emits a deterministic, sorted SDN
release manifest listing each artifact's file name and sha256. Written for
engineers implementing release publishing and for reviewers verifying the
manifest contract.

## Operator workflow

Run: bin/simple test test/01_unit/compiler/driver/libver/libver_publish_spec.spl

Every scenario calls real functions from src/compiler/80.driver/libver/cache.spl.

## Verification guidance

A manifest failure means the function drifted, sorting changed, or SDN format
changed. If the output is not deterministic (changes between runs), that is
a non-determinism bug. Parse the SDN output to verify structure.
"""

# @manual_section: library version publish manifest

use compiler.driver.libver.identity ({LibIdentity})
use compiler.driver.libver.cache ({libver_publish_manifest})
use std.spec.step

fn make_id(
    name: text, semver: text, triple: text, tier: text, sha256: text
) -> LibIdentity:
    LibIdentity(
        name: name,
        semver: semver,
        abi_major: 1,
        abi_minor: 0,
        iface_digest: "d",
        iface_parts: [],
        producer: "c",
        triple: triple,
        cpu_tier: tier,
        sha256: sha256
    )

fn dummy_naming_fn(id: LibIdentity) -> text:
    """Simple naming function for testing."""
    "lib" + id.name + "-" + id.semver + "-" + id.triple + "-" + id.cpu_tier + ".a"

describe "libver_publish: manifest format":
    # @req AC-10
    it "emits valid SDN array":
        step("Manifest must be valid SDN array format")
        val ids = [
            make_id("lib1", "1.0.0", "x86_64-unknown-linux-gnu", "x86-64-v2", "hash1")
        ]
        val manifest = libver_publish_manifest(ids, dummy_naming_fn)

        expect(manifest.starts_with("[")).to_equal(true)
        expect(manifest.ends_with("]\n")).to_equal(true)
        expect(manifest.contains("filename")).to_equal(true)
        expect(manifest.contains("sha256")).to_equal(true)

describe "libver_publish: sorting":
    # @req AC-10
    it "sorts entries by filename":
        step("Manifest entries must be sorted by filename")
        val ids = [
            make_id("zebra", "1.0.0", "x86_64-unknown-linux-gnu", "x86-64-v2", "h3"),
            make_id("apple", "2.0.0", "x86_64-unknown-linux-gnu", "x86-64-v2", "h1"),
            make_id("monkey", "1.5.0", "x86_64-unknown-linux-gnu", "x86-64-v2", "h2")
        ]
        val manifest = libver_publish_manifest(ids, dummy_naming_fn)

        // Find positions of filenames in output
        val apple_pos = manifest.find("libapple-2.0.0")
        val monkey_pos = manifest.find("libmonkey-1.5.0")
        val zebra_pos = manifest.find("libzebra-1.0.0")

        // All should be found
        expect(apple_pos >= 0).to_equal(true)
        expect(monkey_pos >= 0).to_equal(true)
        expect(zebra_pos >= 0).to_equal(true)

        // Should be in alphabetical order
        expect(apple_pos < monkey_pos).to_equal(true)  // oracle: apple < monkey
        expect(monkey_pos < zebra_pos).to_equal(true)  // oracle: monkey < zebra

describe "libver_publish: determinism":
    # @req AC-10
    it "produces identical output on repeated calls":
        step("Manifest must be deterministic")
        val ids = [
            make_id("lib1", "1.0.0", "x86_64-unknown-linux-gnu", "x86-64-v2", "hash1"),
            make_id("lib2", "2.0.0", "aarch64-unknown-linux-gnu", "armv8-a", "hash2")
        ]

        val manifest1 = libver_publish_manifest(ids, dummy_naming_fn)
        val manifest2 = libver_publish_manifest(ids, dummy_naming_fn)

        expect(manifest1 == manifest2).to_equal(true)  // oracle: outputs must be byte-identical

describe "libver_publish: entry structure":
    # @req AC-10
    it "includes filename and sha256 for each entry":
        step("Each entry must have filename and sha256 fields")
        val ids = [
            make_id("test", "1.0.0", "x86_64-unknown-linux-gnu", "generic", "deadbeef")
        ]
        val manifest = libver_publish_manifest(ids, dummy_naming_fn)

        expect(manifest.contains("filename = \"libtest-1.0.0-x86_64-unknown-linux-gnu-generic.a\"")).to_equal(true)
        expect(manifest.contains("sha256 = \"deadbeef\"")).to_equal(true)

describe "libver_publish: empty list":
    # @req AC-10
    it "handles empty artifact list":
        step("Empty list should produce empty array")
        val ids: [LibIdentity] = []
        val manifest = libver_publish_manifest(ids, dummy_naming_fn)

        expect(manifest.starts_with("[")).to_equal(true)
        expect(manifest.ends_with("]\n")).to_equal(true)
        expect(manifest.contains("filename")).to_equal(false)
