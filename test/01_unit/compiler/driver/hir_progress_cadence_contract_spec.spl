use std.io_runtime.{file_read}

describe "Stage 4 HIR progress cadence":
    it "reports often enough to remain useful across large parser modules":
        val lowering = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        val helpers = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        val import_start = lowering.find("use compiler.driver.driver_log_helpers.{")
        val import_end = lowering.find("}\n", import_start)
        val imports = lowering.substring(import_start, import_end)

        expect(import_start).to_be_greater_than(-1)
        expect(import_end).to_be_greater_than(import_start)
        expect(imports).to_contain("log_build_progress")
        expect(helpers).to_contain("pub fn log_build_progress(")
        expect(lowering).to_contain("log_build_progress(\"hir\", \"modules\", 0")
        expect(lowering).to_contain("log_build_progress(\"hir\", \"modules\", progress_hir_done")
        expect(lowering).to_contain("progress_hir_done % 16 == 0")
        expect(lowering.contains("progress_hir_done % 64 == 0")).to_be(false)
