# @req: REQ-COMPILER-DRIVER-001

use std.io_runtime.{file_read}

use std.spec.step

describe "Stage 4 HIR progress cadence":
    it "reports often enough to remain useful across large parser modules":
        # @req: REQ-COMPILER-DRIVER-001
        step("Verify: reports often enough to remain useful across large parser modules")
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        expect(source).to_contain("progress_hir_done % 16 == 0")
        expect(source).to_contain("log_build_progress(\"hir\", \"modules\", progress_hir_done")
        expect(source.contains("progress_hir_done % 64 == 0")).to_equal(false)
