use std.spec
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_vhdl_output_port.{
    VhdlDriverOutputPortV1, install_vhdl_driver_output_port_v1,
    vhdl_driver_output_dispatch_v1}
use compiler.common.driver_core_types.{
    CompileResult, compile_result_errors, driver_core_compile_options_default}

fn _vhdl_test_output(driver: CompilerDriver, output: text) -> CompileResult:
    val _ = driver
    CompileResult.CodegenError("vhdl-test-output:{output}")

describe "VHDL driver output port":
    it "fails closed without a plugin and dispatches only an installed VHDL port":
        val driver = CompilerDriver.create(driver_core_compile_options_default())
        val unavailable = compile_result_errors(
            vhdl_driver_output_dispatch_v1([], driver, "before"))
        expect(unavailable.len()).to_equal(1)
        expect(unavailable[0]).to_contain("PLUG-E-NOTFOUND")

        expect(install_vhdl_driver_output_port_v1(
            VhdlDriverOutputPortV1("other", _vhdl_test_output))).to_equal(false)
        val wrong = compile_result_errors(
            vhdl_driver_output_dispatch_v1(
                [VhdlDriverOutputPortV1("other", _vhdl_test_output)],
                driver, "wrong"))
        expect(wrong.len()).to_equal(1)
        expect(wrong[0]).to_contain("PLUG-E-NOTFOUND")
        val dispatched = compile_result_errors(
            vhdl_driver_output_dispatch_v1(
                [VhdlDriverOutputPortV1("vhdl", _vhdl_test_output)],
                driver, "after"))
        expect(dispatched.len()).to_equal(1)
        expect(dispatched[0]).to_equal("vhdl-test-output:after")
