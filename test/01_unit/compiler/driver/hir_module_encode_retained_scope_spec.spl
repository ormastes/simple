# hir_module_encode_retained_v1 feeds ctx.validation_module_blobs on the
# Stage-3 retained HIR loop. It must hand back exactly the unscoped encoder's
# bytes, fully owned after its own scratch scope has been reclaimed, and leave
# the scratch scope reusable. Under a live outer scope it falls back to the
# unscoped encode and must neither pause nor end that scope.
#
# Native before/after execution is what qualifies the ownership half: the
# interpreter promotes any composite trivially, so it only proves protocol
# and byte equality.

use std.spec.*
use test.fixtures.compiler.completeness95.hir_cases_v1.{fixture_hir_module_v1}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode}
use compiler.driver.driver_hir_cache.{hir_module_encode_retained_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn expect_scratch_reusable():
    val began = transient_scope_begin()
    val ended = if began: transient_scope_end() else: false
    expect(began).to_equal(true)
    expect(ended).to_equal(true)

# Allocate and reclaim a fresh scratch generation so a blob that still aliased
# scope memory would be read back as garbage, not by luck as its old bytes.
fn churn_scratch() -> i64:
    if not transient_scope_begin():
        panic("retained encode spec requires a real scratch scope")
    var strings: [text] = []
    var index = 0
    var total = 0
    while index < 64:
        val value = "reclaimed-{index}-0123456789abcdef0123456789abcdef0123456789abcdef"
        strings.push(value)
        total = total + value.len()
        index = index + 1
    if not transient_scope_end():
        panic("retained encode spec could not end its churn scope")
    total

describe "HIR validation blob retained encode":
    it "returns the unscoped encoder's bytes and owns them past scope end":
        val module = fixture_hir_module_v1(false)
        val expected = hir_module_encode(module)
        expect(expected != "").to_equal(true)
        val blob = hir_module_encode_retained_v1(module)
        expect(churn_scratch() > 0).to_equal(true)
        expect(blob.len()).to_equal(expected.len())
        expect(blob).to_equal(expected)
        expect(hir_module_decode(blob) != nil).to_equal(true)
        expect_scratch_reusable()

    it "falls back to an unscoped encode under a live outer scope and leaves it open":
        val module = fixture_hir_module_v1(false)
        val expected = hir_module_encode(module)
        expect(transient_scope_begin()).to_equal(true)
        val blob = hir_module_encode_retained_v1(module)
        # Compare while the owning scope is still live: the fallback blob is
        # scope memory and is reclaimed by the end below.
        val same = blob == expected
        # Still the live owner: pause and end succeed only if the callee did
        # not close our transaction.
        val paused = transient_scope_pause()
        val ended = transient_scope_end()
        expect(same).to_equal(true)
        expect(paused).to_equal(true)
        expect(ended).to_equal(true)
        expect_scratch_reusable()
