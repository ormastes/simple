use std.spec
use compiler.driver.driver_source_llvm_ir.{compile_source_to_llvm_ir}

describe "compiler-owned source LLVM IR API":
    it "emits real source-dependent IR under the exact requested target":
        val seven = compile_source_to_llvm_ir(
            "test/fixtures/compiler/source_llvm_ir/answer_7.spl",
            "x86_64-unknown-linux-gnu",
            false)
        val twenty_nine = compile_source_to_llvm_ir(
            "test/fixtures/compiler/source_llvm_ir/answer_29.spl",
            "x86_64-unknown-linux-gnu",
            false)

        expect(seven.is_success()).to_equal(true)
        expect(twenty_nine.is_success()).to_equal(true)
        expect(seven.module_count()).to_equal(1)
        expect(twenty_nine.module_count()).to_equal(1)

        val seven_ir = seven.module_irs[0]
        val twenty_nine_ir = twenty_nine.module_irs[0]
        expect(seven_ir).to_contain(
            "target triple = \"x86_64-unknown-linux-gnu\"")
        expect(twenty_nine_ir).to_contain(
            "target triple = \"x86_64-unknown-linux-gnu\"")
        expect(seven_ir).to_contain("i64 7")
        expect(twenty_nine_ir).to_contain("i64 29")
        expect(seven_ir == twenty_nine_ir).to_equal(false)
        expect(seven_ir.contains("minimal stub")).to_equal(false)
        expect(twenty_nine_ir.contains("minimal stub")).to_equal(false)

    it "fails closed when bare-metal policy contradicts the target triple":
        val result = compile_source_to_llvm_ir(
            "test/fixtures/compiler/source_llvm_ir/answer_7.spl",
            "x86_64-unknown-linux-gnu",
            true)

        expect(result.is_success()).to_equal(false)
        expect(result.module_count()).to_equal(0)
        expect(result.error).to_contain(
            "bare_metal=true requires a target triple")
