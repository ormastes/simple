# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/native_file_worker_v1.spl 0%
"""
# Per-file lane: owner template bodies by HIR cache content key (P-G5b)

The HIR child publishes each claimed module's HIR cache key (`.hirkey` record
next to its `.deps` record), so a MIR child can load a template owner's body it
does not hold by content identity instead of guessing the key (closes the
P-G4 gap in doc/08_tracking/bug/pg4_template_body_hir_cache_load_gap_2026-10-25.md).
"""

# @tag:unit
# @tag:compiler
# @tag:driver

use std.spec.*
use std.io_runtime.{dir_create_all, file_read}
use compiler.driver.driver_build.native_file_worker_v1.{native_file_worker_hirkey_publish_v1,
    native_file_worker_hirkey_path_v1}

val QUEUE = "build/test_tmp/pg5b_hirkey_queue"

describe "HIR cache key ledger record":
    it "publishes the key for a module as a path-then-key record":
        expect(dir_create_all(QUEUE)).to_equal(true)
        expect(native_file_worker_hirkey_publish_v1(QUEUE, "src/a/owner.spl", "hirkey:abc")).to_equal(true)
        expect(file_read(native_file_worker_hirkey_path_v1(QUEUE, "src/a/owner.spl"))).to_equal("src/a/owner.spl\nhirkey:abc\n")

    it "refuses to publish an empty key or no queue":
        expect(native_file_worker_hirkey_publish_v1(QUEUE, "src/a/owner.spl", "")).to_equal(false)
        expect(native_file_worker_hirkey_publish_v1("", "src/a/owner.spl", "k")).to_equal(false)
