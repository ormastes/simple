use std.spec.*
use std.io_runtime.{read_file_text, file_exists}

fn source(path: text) -> text:
    read_file_text(path) ?? ""

describe "native-build closure owner hygiene":
    it "routes TRACE32 parser imports through the app-owned module alias":
        expect(file_exists("src/app/cmm_lsp/cmm_parser.spl")).to_equal(true)
        for path in [
            "examples/10_tooling/trace32_tools/t32_cli/bridge.spl",
            "examples/10_tooling/trace32_tools/t32_mcp/dialog_tools.spl",
            "examples/10_tooling/trace32_tools/t32_lsp_mcp/tools.spl"
        ]:
            val body = source(path)
            expect(body).to_contain("use app.cmm_lsp.")
            expect(body.contains("use cmm_lsp.")).to_equal(false)

    it "keeps compiler HIR lowering off the compatibility facade":
        for path in [
            "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_build.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_import_resolution.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl",
            "src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl"
        ]:
            val body = source(path)
            expect(body.contains("use compiler.core.{")).to_equal(false)
            expect(body).to_contain("use compiler.core.ast.")
            expect(body).to_contain("use compiler.core.tokens.")
