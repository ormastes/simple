# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Regression guard for cross-module PUBLIC free-function name collision with
# DIFFERING signatures -- a live silent wrong-dispatch.
#
# The `$dupN` overload mangling in
# src/compiler_rust/compiler/src/mir/lower/lowering_core.rs
# (the `private_dup_overloads` block) used to gate on `name.starts_with('_')`.
# Every colliding PUBLIC name therefore got no `$dupN` variants at all, so its
# call sites fell straight through to plain last-write-wins in codegen -- no
# type check, no arity check, no diagnostic beyond a warning.
#
# Measured on the 2026-08-31 suite log: 359 distinct colliding free-function
# names fire `compiler_cross_module_private_symbol_collision`, of which 265 are
# PUBLIC (only the 94 `_`-prefixed helpers were ever protected by the mangling).
#
# The observable defect: a caller that SELECTIVELY imports `m1.pick(i64)` and
# calls it with an i64 executes `m2.pick(bool)`'s body instead, returning 222
# where 111 is correct -- silently, exit code 0. Whether it misdispatches
# depends only on module load ORDER, so the same source is correct or wrong
# depending on the order of unrelated `use` lines.
#
# Fix: consider public free functions in the collision scan too, mangling all
# but the LAST definition. The last definition keeps the bare name so indirect
# calls (function taken as a value), extern imports and every by-name symbol
# lookup resolve exactly as before, while exact-signature direct calls now
# reach the body the caller actually imported.
#
# @cover src/compiler_rust/compiler/src/mir/lower/lowering_core.rs
# @cover src/compiler_rust/compiler/src/mir/lower/lowering_expr_call.rs

use std.spec.step

use std.spec
use std.spec.step
use std.io_runtime.{file_write, file_delete, file_exists, dir_create_all, shell, env_get}

fn _pubdup_seed_bin() -> text:
    # SIMPLE_BIN lets a lane point this at a freshly built candidate.
    val override_bin = env_get("SIMPLE_BIN") ?? ""
    if override_bin != "":
        return override_bin
    "src/compiler_rust/target/bootstrap/simple"

fn _pubdup_m1() -> text:
    "fn pick(x: i64) -> i64:\n    return 111\n\nfn m1_tag() -> i64:\n    return 1\n"

fn _pubdup_m2() -> text:
    "fn pick(b: bool) -> i64:\n    return 222\n\nfn m2_tag() -> i64:\n    return 2\n"

# `m2` is imported FIRST so that the colliding `m1.pick` is not the last
# definition in load order -- this is the ordering that misdispatched.
# Note the selective `use M.{x}` form: a whole-module `use M` probe loads
# nothing and is vacuous.
fn _pubdup_main() -> text:
    "use mods.m2.{{m2_tag}}\nuse mods.m1.{{pick, m1_tag}}\n\nfn main() -> i64:\n    val got = pick(7)\n    print(\"got=\" + got.to_text() + \" tags=\" + m1_tag().to_text() + m2_tag().to_text())\n    if got == 111:\n        print(\"PASS\")\n        return 0\n    print(\"FAIL\")\n    return 1\n"

describe "seed cross-module public duplicate-signature dispatch":
    # @manual scenario evidence
    it "calls the selectively imported definition, not the last-loaded same-named one":
        # @req REQ-SSPEC-COMPILER
        step("calls the selectively imported definition, not the last-loaded same-named one")
        val seed = _pubdup_seed_bin()
        if file_exists(seed):
            val dir = "/tmp/public_dup_signature_dispatch_repro"
            dir_create_all(dir + "/mods")
            file_write(dir + "/mods/m1.spl", _pubdup_m1())
            file_write(dir + "/mods/m2.spl", _pubdup_m2())
            file_write(dir + "/main.spl", _pubdup_main())
            file_delete(dir + "/main.smf")

            val compiled = shell("cd {dir} && SIMPLE_RUST_SEED_WARNING=0 {seed} compile main.spl -o main.smf 2>&1")
            expect(compiled.exit_code).to_equal(0)

            val ran = shell("cd {dir} && SIMPLE_RUST_SEED_WARNING=0 {seed} main.smf 2>&1")

            # Pre-fix this printed `got=222` (m2's `pick(bool)` body) and exited
            # 0 -- a silent wrong answer.
            expect(ran.stdout).to_contain("got=111")
            expect(ran.stdout).to_contain("PASS")

    # @manual scenario evidence
    it "still reaches the same body when the colliding function is taken as a value":
        # @req REQ-SSPEC-COMPILER
        step("still reaches the same body when the colliding function is taken as a value")
        val seed = _pubdup_seed_bin()
        if file_exists(seed):
            val dir = "/tmp/public_dup_signature_dispatch_indirect"
            dir_create_all(dir + "/mods")
            file_write(dir + "/mods/m1.spl", _pubdup_m1())
            file_write(dir + "/mods/m2.spl", _pubdup_m2())
            # Indirect call: the bare name must still resolve to a real symbol.
            # Mangling EVERY definition would leave this reference undefined,
            # which is why the last definition keeps the bare name.
            file_write(dir + "/main.spl", "use mods.m2.{{m2_tag}}\nuse mods.m1.{{pick, m1_tag}}\n\nfn main() -> i64:\n    val f = pick\n    val got = f(7)\n    print(\"got=\" + got.to_text())\n    if got == 111:\n        print(\"PASS\")\n        return 0\n    print(\"FAIL\")\n    return 1\n")
            file_delete(dir + "/main.smf")

            val compiled = shell("cd {dir} && SIMPLE_RUST_SEED_WARNING=0 {seed} compile main.spl -o main.smf 2>&1")
            expect(compiled.exit_code).to_equal(0)

            val ran = shell("cd {dir} && SIMPLE_RUST_SEED_WARNING=0 {seed} main.smf 2>&1")
            expect(ran.stdout).to_contain("got=111")
            expect(ran.stdout).to_contain("PASS")
