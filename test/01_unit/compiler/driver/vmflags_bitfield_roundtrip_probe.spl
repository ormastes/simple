# Exercises the actual kernel bitfield type; no privileged paging instructions.
use os.kernel.types.memory_types.{VmFlags, VM_NO_EXECUTE}

fn main() -> i64:
    var checked: i64 = 0
    for raw in 0..64:
        val flags = VmFlags(bits: raw as u32)
        if flags.present() != ((raw & 1) != 0): return 1
        if flags.writable() != ((raw & 2) != 0): return 2
        if flags.user() != ((raw & 4) != 0): return 3
        if flags.write_through() != ((raw & 8) != 0): return 4
        if flags.cache_disable() != ((raw & 16) != 0): return 5
        if flags.no_execute() != ((raw & 32) != 0): return 6
        var safe_flags = flags
        if flags.writable() and not flags.no_execute():
            safe_flags = VmFlags(bits: flags.bits | VM_NO_EXECUTE)
        val expected = if (raw & 2) != 0: raw | 32 else: raw
        if (safe_flags.bits as i64) != expected: return 7
        if (flags.bits as i64) != raw: return 8
        checked = checked + 1
    if checked != 64: return 9
    print "PASS: 64 VmFlags bitfield roundtrips and W^X preservation"
    0
