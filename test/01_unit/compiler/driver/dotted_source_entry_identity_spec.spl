# Regression: native_build_entry_main_undefined_when_source_path_has_dot_2026_10_20
# Source-only packet: execution UNRUN until an admitted runtime is available.
use std.spec.{describe, it, expect}
use std.spec.step
use std.io_runtime.{env_get_opt, env_set_process, file_write_exact}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir_raw}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove}
use compiler.backend.mir_to_llvm.{llvm_module_is_native_entry, llvm_module_name_from_entry_path}
use compiler.driver.driver_source_loading.{_driver_module_aliases, _driver_module_name_from_path}

extern fn rt_path_absolute(path: text) -> text

fn dotted_entry_primary_name(path: text) -> text:
    val key = "SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE"
    val previous = env_get_opt(key) ?? ""
    val enabled = env_set_process(key, "1")
    val aliases = _driver_module_aliases(
        path, "fn main() -> i64: 0\n", _driver_module_name_from_path(path))
    val restored = env_set_process(key, previous)
    expect(enabled).to_equal(true)
    expect(restored).to_equal(true)
    expect(aliases.len()).to_be_greater_than(0)
    aliases[0].module_name

describe "dotted out-of-tree native entry identity":
    it "preserves a numeric dot suffix in the entry directory":
        # @req REQ-DOTTED-ENTRY-001
        step("Compare the selected source name with the shared native entry derivation")
        val path = "/tmp/simple_dotted_entry/dot.1/hello.spl"
        val selected = dotted_entry_primary_name(path)
        expect(selected).to_equal(".tmp.simple_dotted_entry.dot.1.hello")
        expect(selected).to_equal(_driver_module_name_from_path(path))

    it "preserves a numeric dot suffix in a grandparent":
        # @req REQ-DOTTED-ENTRY-001
        step("Keep the grandparent suffix while selecting the nested entry")
        val path = "/tmp/simple_dotted_entry/g.1/sub/hello.spl"
        expect(dotted_entry_primary_name(path)).to_equal(_driver_module_name_from_path(path))
        expect(dotted_entry_primary_name(path)).to_equal(".tmp.simple_dotted_entry.g.1.sub.hello")

    it "keeps neighboring numeric directories distinct":
        # @req REQ-DOTTED-ENTRY-002
        step("Reject equality with the same basename in another numbered directory")
        val first = dotted_entry_primary_name("/tmp/simple_dotted_entry/dot.1/hello.spl")
        val neighbor = dotted_entry_primary_name("/tmp/simple_dotted_entry/dot.2/hello.spl")
        expect(first == neighbor).to_equal(false)
        expect(first == _driver_module_name_from_path("/tmp/simple_dotted_entry/dot.2/hello.spl")).to_equal(false)

    it "preserves existing plain and nonnumeric dotted directory spellings":
        # @req REQ-DOTTED-ENTRY-003
        step("Select entries in control directories without changing their names")
        expect(dotted_entry_primary_name("/tmp/simple_dotted_entry/nodot1/hello.spl")).to_equal(
            ".tmp.simple_dotted_entry.nodot1.hello")
        expect(dotted_entry_primary_name("/tmp/simple_dotted_entry/a-b/hello.spl")).to_equal(
            ".tmp.simple_dotted_entry.a_b.hello")
        expect(dotted_entry_primary_name("/tmp/simple_dotted_entry/dot.alpha/hello.spl")).to_equal(
            ".tmp.simple_dotted_entry.dot.alpha.hello")

    it "retains canonical numbered-tier aliases for repository compiler sources":
        # @req REQ-DOTTED-ENTRY-003
        step("Fold an actual repository tier spelling while preserving external paths")
        val path = "src/compiler/10.frontend/core/lexer.spl"
        val key = "SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE"
        val previous = env_get_opt(key) ?? ""
        val enabled = env_set_process(key, "1")
        val aliases = _driver_module_aliases(
            path, "fn marker() -> i64: 1\n", "compiler.10.frontend.core.lexer")
        val restored = env_set_process(key, previous)
        expect(enabled).to_equal(true)
        expect(restored).to_equal(true)
        expect(aliases.len()).to_be_greater_than(0)
        expect(aliases[0].module_name).to_equal("compiler.frontend.core.lexer")

    it "selects only the requested dotted source through the actual LLVM entry predicate":
        # @req REQ-DOTTED-ENTRY-001 REQ-DOTTED-ENTRY-002
        step("Ask LLVM to classify the primary aliases of the entry and its neighbor")
        val path = "/tmp/simple_dotted_entry/dot.1/hello.spl"
        val selected = dotted_entry_primary_name(path)
        val neighbor = dotted_entry_primary_name("/tmp/simple_dotted_entry/dot.2/hello.spl")
        val key = "SIMPLE_NATIVE_BUILD_ENTRY"
        val previous = env_get_opt(key) ?? ""
        val enabled = env_set_process(key, path)
        val expected_name = llvm_module_name_from_entry_path(path)
        val selected_is_entry = llvm_module_is_native_entry(selected)
        val neighbor_is_entry = llvm_module_is_native_entry(neighbor)
        val restored = env_set_process(key, previous)
        expect(enabled).to_equal(true)
        expect(restored).to_equal(true)
        expect(selected).to_equal(expected_name)
        expect(selected_is_entry).to_equal(true)
        expect(neighbor_is_entry).to_equal(false)

    it "keeps relative dotted directories and numbered basenames in the LLVM identity":
        # @req REQ-DOTTED-ENTRY-001 REQ-DOTTED-ENTRY-002
        step("Derive relative and absolute paths and remove only the final source extension")
        val relative = "simple_dotted_entry/dot.1/hello.1.spl"
        val absolute = "/tmp/simple_dotted_entry/dot.1/hello.1.spl"
        val relative_name = dotted_entry_primary_name(relative)
        val absolute_name = dotted_entry_primary_name(absolute)
        expect(relative_name).to_equal("simple_dotted_entry.dot.1.hello.1")
        expect(absolute_name).to_equal(".tmp.simple_dotted_entry.dot.1.hello.1")
        expect(relative_name).to_equal(llvm_module_name_from_entry_path(relative))
        expect(absolute_name).to_equal(llvm_module_name_from_entry_path(absolute))
        expect(relative_name == dotted_entry_primary_name("simple_dotted_entry/dot.1/hello.2.spl")).to_equal(false)
        expect(dotted_entry_primary_name("simple_dotted_entry/dot.1/hello.spl.spl")).to_equal(
            "simple_dotted_entry.dot.1.hello.spl")

    it "keeps real external src and examples directories outside repository tier folding":
        # @req REQ-DOTTED-ENTRY-001 REQ-DOTTED-ENTRY-002 REQ-DOTTED-ENTRY-004
        step("Create real external paths whose directory names also occur in the repository")
        val root = secure_temp_dir_raw("/tmp", "simple-dotted-entry-external")
        expect(root == "").to_equal(false)
        val source = "fn main() -> i64: 0\n"
        for tree in ["src", "examples"]:
            val first_dir = root + "/" + tree + "/dot.1"
            val neighbor_dir = root + "/" + tree + "/dot.2"
            expect(dir_create_all(first_dir)).to_equal(true)
            expect(dir_create_all(neighbor_dir)).to_equal(true)
            val path = first_dir + "/hello.spl"
            val neighbor_path = neighbor_dir + "/hello.spl"
            expect(file_write_exact(path, source)).to_equal(true)
            expect(file_write_exact(neighbor_path, source)).to_equal(true)
            val selected = dotted_entry_primary_name(path)
            val neighbor = dotted_entry_primary_name(neighbor_path)
            val key = "SIMPLE_NATIVE_BUILD_ENTRY"
            val previous = env_get_opt(key) ?? ""
            val enabled = env_set_process(key, path)
            val selected_is_entry = llvm_module_is_native_entry(selected)
            val neighbor_is_entry = llvm_module_is_native_entry(neighbor)
            val restored = env_set_process(key, previous)
            expect(enabled).to_equal(true)
            expect(restored).to_equal(true)
            expect(selected).to_equal(llvm_module_name_from_entry_path(path))
            expect(neighbor).to_equal(llvm_module_name_from_entry_path(neighbor_path))
            expect(selected == neighbor).to_equal(false)
            expect(selected_is_entry).to_equal(true)
            expect(neighbor_is_entry).to_equal(false)
        expect(dir_remove(root, true)).to_equal(true)

    it "preserves true repository membership for relative and absolute tier aliases":
        # @req REQ-DOTTED-ENTRY-003 REQ-DOTTED-ENTRY-004
        step("Resolve actual repository source files against the physical working root")
        val relative = "src/compiler/10.frontend/core/lexer.spl"
        val absolute = rt_path_absolute(relative) ?? ""
        expect(absolute == "").to_equal(false)
        val key = "SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE"
        val previous = env_get_opt(key) ?? ""
        val enabled = env_set_process(key, "1")
        val relative_aliases = _driver_module_aliases(
            relative, "fn marker() -> i64: 1\n", "compiler.10.frontend.core.lexer")
        val absolute_aliases = _driver_module_aliases(
            absolute, "fn marker() -> i64: 1\n", "compiler.10.frontend.core.lexer")
        val restored = env_set_process(key, previous)
        expect(enabled).to_equal(true)
        expect(restored).to_equal(true)
        expect(relative_aliases.len()).to_be_greater_than(0)
        expect(absolute_aliases.len()).to_be_greater_than(0)
        expect(relative_aliases[0].module_name).to_equal("compiler.frontend.core.lexer")
        expect(absolute_aliases[0].module_name).to_equal(relative_aliases[0].module_name)
        val example = "examples/01_getting_started/hello_native.spl"
        val absolute_example = rt_path_absolute(example) ?? ""
        expect(absolute_example == "").to_equal(false)
        expect(dotted_entry_primary_name(example)).to_equal("examples.01_getting_started.hello_native")
        expect(dotted_entry_primary_name(absolute_example)).to_equal(
            dotted_entry_primary_name(example))
