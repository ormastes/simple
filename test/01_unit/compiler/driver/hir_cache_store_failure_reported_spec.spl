# A failed HIR cache store must be counted, shown in the summary, and must not
# leave its pid-unique temp file behind. Before this, a store that could not
# write (disk full was the measured case) returned false silently.
#
# The cache directory is pointed below a regular FILE, so creating it and
# writing into it both fail on every platform.

use std.spec.*
use app.io.env_ops.{env_get, env_set}
use test.fixtures.compiler.completeness95.hir_cases_v1.{fixture_hir_module_v1}
use compiler.driver.driver_hir_cache.{hir_cache_store, hir_cache_stores,
    hir_cache_store_failures, hir_cache_summary, hir_cache_enabled, hir_cache_path,
    hir_cache_last_refusal_is_io_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_end}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_remove_all(path: text) -> bool
extern fn rt_getpid() -> i64

# Exercise a new allocation/reclamation boundary before reading retained text.
# Keep assertion machinery outside the scratch scope: its own diagnostics live
# for the rest of the spec. Native before/after execution is required to qualify
# this lifetime regression; interpreter behavior alone is insufficient.
fn churn_cache_failure_scratch() -> i64:
    if not transient_scope_begin():
        panic("cache failure regression requires a real scratch scope")
    var strings: [text] = []
    var index = 10
    var total = 0
    while index < 42:
        val value = "reuse-{index}"
        strings.push(value)
        total = total + value.len()
        index = index + 1
    if not transient_scope_end():
        panic("cache failure regression could not end scratch scope")
    total

describe "HIR cache store failure":
    it "should count and report a store that cannot write, leaving no temp file":
        val blocker = "build/hir_cache_store_failure_blocker_{rt_getpid()}.txt"
        expect(rt_file_write_text(blocker, "not a directory\n")).to_equal(true)
        val saved_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? ""
        val saved_dir = env_get("SIMPLE_HIR_CACHE_DIR") ?? ""
        val saved_cache = env_get("SIMPLE_HIR_CACHE") ?? ""
        expect(env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "store-failure-spec")).to_be(true)
        expect(env_set("SIMPLE_HIR_CACHE_DIR", blocker + "/hir")).to_be(true)
        expect(env_set("SIMPLE_HIR_CACHE", "1")).to_be(true)
        expect(hir_cache_enabled()).to_equal(true)

        val before_failures = hir_cache_store_failures()
        val before_stores = hir_cache_stores()
        expect(hir_cache_summary()).to_contain("stores=")
        val stored = hir_cache_store("k1", fixture_hir_module_v1(false), [])

        expect(stored).to_equal(false)
        expect(churn_cache_failure_scratch()).to_equal(256)
        expect(hir_cache_last_refusal_is_io_v1()).to_equal(true)
        expect(hir_cache_summary()).to_contain("reason=io-write ")
        expect(hir_cache_stores()).to_equal(before_stores)
        expect(hir_cache_store_failures()).to_equal(before_failures + 1)
        expect(hir_cache_summary()).to_contain("store_failures={before_failures + 1}")
        expect(rt_file_exists(hir_cache_path("k1") + ".{rt_getpid()}.tmp")).to_equal(false)

        val _scope = env_set("SIMPLE_FRONTEND_CACHE_SCOPE", saved_scope)
        val _dir = env_set("SIMPLE_HIR_CACHE_DIR", saved_dir)
        val _cache = env_set("SIMPLE_HIR_CACHE", saved_cache)
        val _gone = rt_file_delete(blocker)

    it "retains the rename failure reason after scratch reclamation without publishing a cache entry":
        val dir = "build/hir_cache_rename_failure_{rt_getpid()}"
        expect(rt_dir_create_all(dir)).to_equal(true)
        val saved_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? ""
        val saved_dir = env_get("SIMPLE_HIR_CACHE_DIR") ?? ""
        val saved_cache = env_get("SIMPLE_HIR_CACHE") ?? ""
        expect(env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "store-failure-spec")).to_be(true)
        expect(env_set("SIMPLE_HIR_CACHE_DIR", dir)).to_be(true)
        expect(env_set("SIMPLE_HIR_CACHE", "1")).to_be(true)
        expect(hir_cache_enabled()).to_equal(true)

        # A real nonempty directory blocks replacing the final cache file,
        # while its writable parent permits the temporary file to be written.
        val final_path = hir_cache_path("rename")
        expect(rt_dir_create_all(final_path)).to_equal(true)
        val marker = final_path + "/keep.txt"
        expect(rt_file_write_text(marker, "retain the directory\n")).to_equal(true)
        val before_failures = hir_cache_store_failures()
        val before_stores = hir_cache_stores()
        val stored = hir_cache_store("rename", fixture_hir_module_v1(false), [])

        expect(stored).to_equal(false)
        expect(churn_cache_failure_scratch()).to_equal(256)
        expect(hir_cache_last_refusal_is_io_v1()).to_equal(true)
        expect(hir_cache_summary()).to_contain("reason=io-rename ")
        expect(hir_cache_store_failures()).to_equal(before_failures + 1)
        expect(hir_cache_stores()).to_equal(before_stores)
        expect(rt_file_exists(final_path + ".{rt_getpid()}.tmp")).to_equal(false)
        expect(rt_file_exists(marker)).to_equal(true)

        val _scope = env_set("SIMPLE_FRONTEND_CACHE_SCOPE", saved_scope)
        val _dir = env_set("SIMPLE_HIR_CACHE_DIR", saved_dir)
        val _cache = env_set("SIMPLE_HIR_CACHE", saved_cache)
        val _gone = rt_dir_remove_all(dir)
