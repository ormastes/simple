use std.spec

extern fn rt_file_read_text(path: text) -> text?

describe "bootstrap HIR handoff lifecycle":
    it "releases promoted Stage3 owners as soon as MIR has consumed them":
        val bootstrap_src = (rt_file_read_text("src/compiler/80.driver/driver_bootstrap.spl") ?? "").replace("\r\n", "\n")
        val pipeline_src = (rt_file_read_text("src/compiler/80.driver/driver_aot_pipeline.spl") ?? "").replace("\r\n", "\n")

        val flat_lower = bootstrap_src.find("val flat_bootstrap_mir = bootstrap_lower_flat_hir_modules_to_mir_for_target")
        expect(flat_lower).to_be_greater_than(-1)
        val flat_tail = bootstrap_src[flat_lower:]
        val flat_publish = flat_tail.find("next_ctx.mir_modules[entry_module_name] = flat_bootstrap_mir")
        expect(flat_publish).to_be_greater_than(-1)

        val clear_pos = bootstrap_src.find("bootstrap_clear_entry_hir_module()")
        val globals_lower = bootstrap_src.find("var bootstrap_mir = bootstrap_lower_hir_globals_to_mir_module_for_target")
        expect(clear_pos).to_be_greater_than(-1)
        expect(globals_lower).to_be_greater_than(clear_pos)

        val stage_lower = pipeline_src.find("val mir_ok = self.lower_to_mir()")
        expect(stage_lower).to_be_greater_than(-1)
        val stage_tail = pipeline_src[stage_lower:]
        val flat_release = stage_tail.find("bootstrap_hir_modules_reset()")
        val evict_hir = stage_tail.find("self.ctx.evict_hir()")
        expect(flat_release).to_be_greater_than(-1)
        expect(evict_hir).to_be_greater_than(flat_release)
