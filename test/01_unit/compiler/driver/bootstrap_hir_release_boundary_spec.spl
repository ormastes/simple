use std.spec

extern fn rt_file_read_text(path: text) -> text?

describe "bootstrap HIR handoff lifecycle":
    it "releases promoted Stage3 owners as soon as MIR has consumed them":
        val source = rt_file_read_text("src/compiler/80.driver/driver_bootstrap.spl") ?? ""

        val flat_lower = source.find("val flat_bootstrap_mir = bootstrap_lower_flat_hir_modules_to_mir_for_target")
        expect(flat_lower).to_be_greater_than(-1)
        val flat_tail = source[flat_lower:]
        val flat_release = flat_tail.find("bootstrap_hir_modules_reset()")
        val flat_publish = flat_tail.find("next_ctx.mir_modules[entry_module_name] = flat_bootstrap_mir")
        expect(flat_release).to_be_greater_than(-1)
        expect(flat_publish).to_be_greater_than(flat_release)

        val entry_lower = source.find("var bootstrap_mir = bootstrap_lower_hir_globals_to_mir_module_for_target")
        expect(entry_lower).to_be_greater_than(-1)
        val entry_tail = source[entry_lower:]
        expect(entry_tail.find("bootstrap_clear_entry_hir_module()")).to_be_greater_than(-1)
