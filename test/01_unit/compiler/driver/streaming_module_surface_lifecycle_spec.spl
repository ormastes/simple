use std.spec.{describe, it, expect}
use compiler.common.driver_core_types.{
    SourceFile,
    driver_core_compile_options_default
}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_types.{CompileMode}

fn streaming_source(path: text, content: text, module_name: text) -> SourceFile:
    SourceFile(path: path, content: content, module_name: module_name)

fn streaming_driver() -> CompilerDriver:
    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.low_memory = true
    options.backend = "llvm"
    var driver = CompilerDriver.create(options)
    val alpha = "fn alpha() -> i64:\n    return 1\n"
    driver.ctx.sources = [
        streaming_source("build/streaming/alpha.spl", alpha, "fixture.alpha"),
        streaming_source("build/streaming/alpha.spl", alpha, "fixture.alpha_alias"),
        streaming_source("build/streaming/beta.spl", "fn beta() -> i64:\n    return 2\n", "fixture.beta")
    ]
    driver.ctx.source_paths_owner = [
        "build/streaming/alpha.spl",
        "build/streaming/alpha.spl",
        "build/streaming/beta.spl"]
    driver.ctx.source_authored_paths_owner = ["", "", ""]
    driver.ctx.source_contents_owner = [
        alpha, alpha, "fn beta() -> i64:\n    return 2\n"]
    driver.ctx.source_module_names_owner = [
        "fixture.alpha", "fixture.alpha_alias", "fixture.beta"]
    driver

describe "streaming module-surface driver lifecycle":
    it "preserves physical-source order and aliases through phase 2":
        var driver = streaming_driver()
        val phase2_ok = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_equal(true)
        expect(driver.ctx.modules.len()).to_equal(0)
        expect(driver.ctx.module_surfaces != nil).to_be(true)
        val surfaces = driver.ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(2)
        expect(surfaces.surfaces[0].module_name).to_equal("fixture.alpha")
        expect(surfaces.index_by_name["fixture.alpha_alias"]).to_equal(0)
        expect(surfaces.surfaces[0].physical_index).to_equal(0)
        expect(surfaces.surfaces[1].physical_index).to_equal(1)
        expect(surfaces.ordered_indices).to_equal([0, 0, 1])

    it "dispatches from stable streaming state when readiness flag is lost":
        var driver = streaming_driver()
        val phase2_ok = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_equal(true)
        val phase3_ok = driver.lower_and_check_streaming_surfaces_impl()
        expect(phase3_ok).to_equal(true)
        expect(driver.ctx.modules.keys().len()).to_equal(0)
        expect(driver.ctx.hir_modules.contains_key("fixture.alpha")).to_equal(true)
        expect(driver.ctx.hir_modules.contains_key("fixture.alpha_alias")).to_equal(true)
        expect(driver.ctx.hir_modules.contains_key("fixture.beta")).to_equal(true)
        expect(driver.ctx.hir_modules["fixture.alpha"].functions.keys().len()).to_be_greater_than(0)
        expect(driver.ctx.hir_modules["fixture.alpha_alias"].functions.keys().len()).to_be_greater_than(0)
        expect(driver.ctx.hir_modules["fixture.beta"].functions.keys().len()).to_be_greater_than(0)

    it "lowers A alias A B once per dense physical owner without streaming":
        var driver = streaming_driver()
        driver.ctx.options.low_memory = false
        val (parsed_ctx, phase2_ok) = driver.parse_all_impl()
        driver.ctx = parsed_ctx
        expect(phase2_ok).to_equal(true)
        val surfaces = driver.ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(2)
        expect(surfaces.surfaces[0].physical_index).to_equal(0)
        expect(surfaces.surfaces[1].physical_index).to_equal(1)
        expect(surfaces.ordered_indices).to_equal([0, 0, 1])
        val (lowered_ctx, phase3_ok) = driver.lower_and_check_impl()
        driver.ctx = lowered_ctx
        expect(phase3_ok).to_equal(true)
        expect(driver.ctx.hir_modules.contains_key("fixture.alpha")).to_equal(true)
        expect(driver.ctx.hir_modules.contains_key("fixture.alpha_alias")).to_equal(true)
        expect(driver.ctx.hir_modules.contains_key("fixture.beta")).to_equal(true)
        expect(driver.ctx.hir_modules["fixture.alpha"].functions.keys().len()).to_equal(
            driver.ctx.hir_modules["fixture.alpha_alias"].functions.keys().len())

    it "retains source and surface state after a phase-3 fingerprint failure":
        var driver = streaming_driver()
        val phase2_ok = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_equal(true)
        var sources = driver.ctx.sources
        sources[0] = streaming_source("build/streaming/alpha.spl", "fn alpha() -> i64:\n    return 99\n", "fixture.alpha")
        driver.ctx.sources = sources
        val phase3_ok = driver.lower_and_check_streaming_surfaces_impl()
        expect(phase3_ok).to_equal(false)
        expect(driver.ctx.sources.len()).to_equal(3)
        expect(driver.ctx.module_surfaces != nil).to_equal(true)
        expect(driver.ctx.errors[0]).to_contain("fingerprint mismatch")

    it "poisons one physical MIR facade once and reaches the clean tail alias-safely":
        var options = driver_core_compile_options_default()
        options.mode = CompileMode.Aot
        options.low_memory = true
        options.backend = "llvm"
        var driver = CompilerDriver.create(options)
        # These two real paths resolve through the repo's `compiler/mir ->
        # 50.mir` symlink to one physical file. The compact source is a
        # deterministic HIR-only poison: phase 2 can parse and surface it, but
        # phase 3 rejects its unknown declared type.
        val poison = (
            "fn poisoned(value: MissingStreamingType) -> i64:\n" +
            "    return 0\n")
        driver.ctx.sources = [
            streaming_source(
                "src/compiler/mir/__init__.spl", poison,
                "compiler.50.mir"),
            streaming_source(
                "src/compiler/50.mir/__init__.spl", poison,
                "compiler.mir"),
            streaming_source(
                "build/streaming/after_mir_poison.spl",
                "fn after_mir_poison() -> i64:\n    return 7\n",
                "fixture.after_mir_poison")
        ]

        val phase2_ok = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_equal(true)
        val surfaces = driver.ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(2)
        expect(surfaces.index_by_name["compiler.50.mir"]).to_equal(0)
        expect(surfaces.index_by_name["compiler.mir"]).to_equal(0)

        val phase3_ok = driver.lower_and_check_streaming_surfaces_impl()
        expect(phase3_ok).to_equal(false)
        expect(driver.ctx.hir_modules.contains_key(
            "fixture.after_mir_poison")).to_equal(true)
        expect(driver.ctx.hir_modules.contains_key(
            "compiler.50.mir")).to_equal(false)
        expect(driver.ctx.hir_modules.contains_key(
            "compiler.mir")).to_equal(false)
        expect(driver.ctx.poisoned_module_count_value).to_equal(2)
        expect(driver.ctx.poisoned_modules[0]).to_equal("compiler.50.mir")
        expect(driver.ctx.poisoned_modules[1]).to_equal("compiler.mir")

        var root_diagnostic_count = 0
        var fingerprint_mismatch_count = 0
        for error in driver.ctx.errors:
            if error.contains("MissingStreamingType"):
                root_diagnostic_count = root_diagnostic_count + 1
            if error.contains("fingerprint mismatch"):
                fingerprint_mismatch_count = fingerprint_mismatch_count + 1
        # One root diagnostic proves one physical HIR attempt; the alias did
        # not relower. The clean third logical name proves collect-all reached
        # the remainder of the work list.
        expect(root_diagnostic_count).to_equal(1)
        expect(fingerprint_mismatch_count).to_equal(0)
