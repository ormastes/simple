use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use compiler.common.driver_core_types.{
    SourceFile,
    driver_core_compile_options_default
}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_types.{CompileMode}

fn streaming_source(path: text, content: text, module_name: text) -> SourceFile:
    SourceFile(path: path, content: content, module_name: module_name)

fn streaming_driver() -> CompilerDriver:
    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.low_memory = true
    options.backend = "llvm"
    var driver = CompilerDriver.create(options)
    val alpha = "fn alpha() -> i64:\n    return 1\n"
    driver.ctx.sources = [
        streaming_source("build/streaming/alpha.spl", alpha, "fixture.alpha"),
        streaming_source("build/streaming/alpha.spl", alpha, "fixture.alpha_alias"),
        streaming_source("build/streaming/beta.spl", "fn beta() -> i64:\n    return 2\n", "fixture.beta")
    ]
    driver

describe "streaming module-surface driver lifecycle":
    it "accepts high decimal u64 literals through the streaming parser":
        var driver = streaming_driver()
        val source = "fn fnv_basis() -> u64:\n    14695981039346656037u64\nfn max_u64() -> u64:\n    18446744073709551615u64\n"
        driver.ctx.sources = [
            streaming_source(
                "build/streaming/decimal_u64.spl",
                source,
                "fixture.decimal_u64"
            )
        ]
        val (phase2_ctx, phase2_ok) = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_be(true)
        expect(phase2_ctx.errors.len()).to_equal(0)
        expect(phase2_ctx.module_surfaces == nil).to_be(false)
        val surfaces = phase2_ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(1)

    it "preserves physical-source order and aliases through phase 2":
        var driver = streaming_driver()
        val (phase2_ctx, phase2_ok) = driver.parse_all_streaming_surfaces_impl()
        driver.ctx = phase2_ctx
        expect(phase2_ok).to_equal(true)
        expect(driver.ctx.modules.len()).to_equal(0)
        expect(driver.ctx.module_surfaces != nil).to_equal(true)
        val surfaces = driver.ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(2)
        expect(surfaces.surfaces[0].module_name).to_equal("fixture.alpha")
        expect(surfaces.index_by_name["fixture.alpha_alias"]).to_equal(0)

    it "retains source and surface state after a phase-3 fingerprint failure":
        var driver = streaming_driver()
        val (phase2_ctx, phase2_ok) = driver.parse_all_streaming_surfaces_impl()
        driver.ctx = phase2_ctx
        expect(phase2_ok).to_equal(true)
        var sources = driver.ctx.sources
        sources[0] = streaming_source("build/streaming/alpha.spl", "fn alpha() -> i64:\n    return 99\n", "fixture.alpha")
        driver.ctx.sources = sources
        val (_, phase3_ok) = driver.lower_and_check_streaming_surfaces_impl()
        expect(phase3_ok).to_equal(false)
        expect(driver.ctx.sources.len()).to_equal(3)
        expect(driver.ctx.module_surfaces != nil).to_equal(true)
        expect(driver.ctx.errors[0]).to_contain("fingerprint mismatch")

    it "survives two real CLI source surface releases":
        var driver = streaming_driver()
        driver.ctx.sources = [
            streaming_source(
                "src/app/cli/main.spl",
                file_read("src/app/cli/main.spl"),
                "app.cli.main"
            ),
            streaming_source(
                "src/app/cli/bootstrap_main.spl",
                file_read("src/app/cli/bootstrap_main.spl"),
                "app.cli.bootstrap_main"
            )
        ]
        val (phase2_ctx, phase2_ok) = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_be(true)
        expect(phase2_ctx.errors.len()).to_equal(0)
        expect(phase2_ctx.modules.len()).to_equal(0)
        expect(phase2_ctx.module_surfaces == nil).to_be(false)
        val surfaces = phase2_ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(2)
        expect(surfaces.surfaces[0].module_name).to_equal("app.cli.main")
        expect(surfaces.surfaces[1].module_name).to_equal("app.cli.bootstrap_main")

    it "reuses the released real CLI surface for an immediate alias":
        var driver = streaming_driver()
        val content = file_read("src/app/cli/main.spl")
        driver.ctx.sources = [
            streaming_source("src/app/cli/main.spl", content, "app.cli.main"),
            streaming_source(
                "src/app/cli/main.spl", content, "fixture.cli_main_alias")
        ]
        val (phase2_ctx, phase2_ok) = driver.parse_all_streaming_surfaces_impl()
        expect(phase2_ok).to_be(true)
        expect(phase2_ctx.errors.len()).to_equal(0)
        expect(phase2_ctx.module_surfaces == nil).to_be(false)
        val surfaces = phase2_ctx.module_surfaces.unwrap()
        expect(surfaces.surfaces.len()).to_equal(1)
        expect(surfaces.index_by_name["fixture.cli_main_alias"]).to_equal(0)
