use std.spec
use app.io._CliCompile.native_build_mcdc_closure.{native_build_mcdc_closure_spec_v1}

# A frozen preclosed request (closure_walks=0) skips the pipeline closure scan
# that admits the MC/DC probe owner as a synthetic edge, so the CLI entry walk
# admits it itself (walk-level check: native_source_root_handoff_spec.spl).
# Without it every `--entry-closure` native build under SIMPLE_MCDC_MODE=on
# whose authored closure lacked the owner linked with
# `undefined symbol: lib.nogc_sync_mut.mcdc.static_probe.mcdc_static_probe_configure_bytes`
# (native_entry_closure_preclosed_walk_omits_mcdc_static_probe_owner_2026-11-12).
describe "native-build MC/DC probe owner closure spec":
    """
    Feature: MC/DC probe owner admission for --entry-closure native builds
    Maps SIMPLE_MCDC_MODE text to the synthetic owner spec the CLI entry walk must carry.
    """
    it "maps the configured mode to the probe owner spec":
        """on/static -> static_probe, dynamic -> dynamic_probe, anything else -> none."""
        expect(native_build_mcdc_closure_spec_v1("on")).to_equal("std.nogc_sync_mut.mcdc.static_probe")
        expect(native_build_mcdc_closure_spec_v1("static")).to_equal("std.nogc_sync_mut.mcdc.static_probe")
        expect(native_build_mcdc_closure_spec_v1("dynamic")).to_equal("std.nogc_sync_mut.mcdc.dynamic_probe")
        expect(native_build_mcdc_closure_spec_v1("off")).to_equal("")
        expect(native_build_mcdc_closure_spec_v1("")).to_equal("")
        expect(native_build_mcdc_closure_spec_v1("bogus")).to_equal("")
