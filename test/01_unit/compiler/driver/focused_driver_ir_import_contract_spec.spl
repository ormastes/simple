use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused driver IR import contract":
    it "uses explicit HIR and MIR owners":
        val driver = file_read("src/compiler/80.driver/driver.spl")
        expect(driver.contains("use compiler.hir.hir.*")).to_equal(false)
        expect(driver.contains("use compiler.mir.mir.*")).to_equal(false)
        expect(driver).to_contain("compiler.hir.hir_types.")
        expect(driver).to_contain("compiler.mir.mir_instructions.")
