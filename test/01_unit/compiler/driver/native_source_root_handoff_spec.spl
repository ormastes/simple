use std.spec
use app.io._CliCompile.native_build_closure.{
    _native_build_entry_closure, _nb_scv_snapshot_path_v1,
    native_build_closure_source_roots_v1}
use std.nogc_async_mut.sosix.environment.{sosix_cwd}
use compiler.common.driver_core_types.{CompileOptions, compileoptions_normalize_mir_optimization}
use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use compiler.driver.driver_build.native_source_root_handoff.{
    native_source_root_paths_v1, native_source_root_loaded_owner_error_v1}

describe "native worker source root handoff":
    it "preserves ordered duplicate selectors when inputs become closure files":
        var options = CompileOptions.default()
        options.native_source_roots = ["composition_roots", "ambiguous_composition_overlay", "composition_roots"]
        options.native_source_snapshot_root = "test/fixtures/compiler"
        options.input_files = ["only_entry.spl"]
        val copied = compileoptions_normalize_mir_optimization(options)
        expect(copied.native_source_roots).to_equal(options.native_source_roots)
        expect(copied.native_source_snapshot_root).to_equal("test/fixtures/compiler")
        val mapped = native_source_root_paths_v1(copied.native_source_roots, copied.native_source_snapshot_root)
        expect(mapped.is_ok()).to_equal(true)
        expect(mapped.unwrap()).to_equal([
            "test/fixtures/compiler/composition_roots",
            "test/fixtures/compiler/ambiguous_composition_overlay",
            "test/fixtures/compiler/composition_roots"])

    it "does not replace nonempty selectors with input files when the snapshot is absent":
        val rejected = native_source_root_paths_v1(["composition_roots"], "")
        expect(rejected.is_err()).to_equal(true)
        expect(rejected.unwrap_err()).to_equal("SOURCE_ROOT_SNAPSHOT_MISSING")

    it "rejects a missing mapped root even after a valid mapping":
        val rejected = native_source_root_paths_v1(
            ["composition_roots", "missing_native_source_root_handoff"], "test/fixtures/compiler")
        expect(rejected.is_err()).to_equal(true)
        expect(rejected.unwrap_err()).to_equal("SOURCE_ROOT_MAPPING_MISSING: missing_native_source_root_handoff")

    it "rejects selectors that escape the admitted snapshot":
        expect(native_source_root_paths_v1(["../compiler"], "test/fixtures/compiler").is_err()).to_equal(true)
        expect(native_source_root_paths_v1(["/src/compiler"], "test/fixtures/compiler").is_err()).to_equal(true)

    it "keeps empty nonnative defaults compatible":
        val options = CompileOptions.default()
        expect(options.native_source_roots.len()).to_equal(0)
        expect(options.native_source_snapshot_root).to_equal("")
        expect(native_source_root_paths_v1([], "").unwrap().len()).to_equal(0)

    it "rejects ambiguous authority even when a default module was already loaded":
        val reason = native_source_root_loaded_owner_error_v1(
            SourceRootResolutionV1.Ambiguous("overlay/plugins"), "default/plugins/selected.spl")
        expect(reason).to_start_with("SOURCE_ROOT_AMBIGUOUS")

    it "rejects a preloaded owner that disagrees with the selected root":
        val reason = native_source_root_loaded_owner_error_v1(
            SourceRootResolutionV1.Found("overlay/selected.spl"), "default/selected.spl")
        expect(reason).to_start_with("SOURCE_ROOT_OWNER_MISMATCH")

    it "accepts the same physical owner and retains the missing-owner distinction":
        expect(native_source_root_loaded_owner_error_v1(
            SourceRootResolutionV1.Found("overlay/selected.spl"), "overlay/selected.spl")).to_equal("")
        expect(native_source_root_loaded_owner_error_v1(
            SourceRootResolutionV1.Found("overlay/selected.spl"), "")).to_equal("")
        expect(native_source_root_loaded_owner_error_v1(
            SourceRootResolutionV1.Missing, "already-loaded.spl")).to_equal("")

    it "captures effective defaults and supported spellings through the admitted accessor":
        val entry = "test/fixtures/compiler/composition_roots/00.ambiguous/owner.spl"
        # Establish the real snapshot through the canonical closure owner.
        # This spec requires the same source admission as ordinary native tooling.
        val closure = _native_build_entry_closure(entry, [])
        expect(closure.len()).to_be_greater_than(0)
        expect(_nb_scv_snapshot_path_v1(entry).len()).to_be_greater_than(0)
        val defaults = native_build_closure_source_roots_v1(entry, [])
        expect(defaults.is_ok()).to_equal(true)
        expect(defaults.unwrap()).to_equal([
            "src/app", "src/lib", "src/compiler", "src/os", "src/plugins",
            "test/fixtures/compiler/composition_roots/00.ambiguous"])
        val spellings = native_build_closure_source_roots_v1(entry,
            ["./src/app", "src/./app", sosix_cwd() + "/src/app", "src/app/"])
        expect(spellings.is_ok()).to_equal(true)
        expect(spellings.unwrap()).to_equal(["src/app", "src/app", "src/app", "src/app"])

    it "rejects lost selectors when an admitted snapshot was transported":
        val rejected = native_source_root_paths_v1([], "test/fixtures/compiler")
        expect(rejected.is_err()).to_equal(true)
        expect(rejected.unwrap_err()).to_equal("SOURCE_ROOT_SELECTORS_MISSING")
