"""
## Purpose and audience
Purpose: Prove the driver builds the SPL-BOUND cross-file raw-return summaries
itself from the project import graph (module id -> source inventory) and feeds
them to check_bound_late_casts_cross, with no caller-supplied summaries.
Audience: compiler engineers maintaining the driver and robust-boundary lints.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
Operates on an in-memory inventory (module id -> source). Cycles terminate;
unresolved imports contribute no summary. No path lookups: the inventory is
the frozen module set the driver already owns.
"""
# @req: REQ-DIAG-POLICY-001

use std.spec.*
use std.spec.step
use compiler.driver.driver_bound_summaries_v1.{driver_bound_import_graph_v1, driver_bound_summaries_v1, driver_bound_findings_v1}

fn inventory() -> Dict<text, text>:
    var d: Dict<text, text> = {}
    d["sensor_raw"] = "extern fn c_read_distance() -> i32\n\npub fn read_distance() -> i32:\n    val raw = c_read_distance()\n    return raw\n"
    d["sensor_mid"] = "use sensor_raw.{{read_distance}}\n\npub fn fetch() -> i32:\n    read_distance()\n"
    d["client"] = "use sensor_mid.{{fetch}}\n\nunit DistanceKm: i32 as km\n\nfn get_distance() -> DistanceKm:\n    return DistanceKm(fetch())\n"
    d["adapter"] = "extern fn c_read_distance() -> i32\n\n@unsafe(reason: \"adapter\", capabilities: [ffi])\npub fn read_adapter() -> i32:\n    c_read_distance()\n"
    d["clean_client"] = "use adapter.{{read_adapter}}\n\nunit DistanceKm: i32 as km\n\nfn get_distance() -> DistanceKm:\n    val raw = read_adapter()\n    return DistanceKm(raw)\n"
    d["cyc_a"] = "use cyc_b.{{loop_b}}\n\npub fn loop_a() -> i32:\n    loop_b()\n"
    d["cyc_b"] = "use cyc_a.{{loop_a}}\n\npub fn loop_b() -> i32:\n    loop_a()\n"
    d["dangling"] = "use no_such_mod.{{f}}\n\npub fn g() -> i32:\n    1\n"
    d

describe "driver-built SPL-BOUND import graph":
    it "extracts imports present in the inventory":
        # @req: REQ-DIAG-POLICY-001
        step("Edges of client and dangling")
        val g = driver_bound_import_graph_v1(inventory())
        expect(g["client"]).to_equal(["sensor_mid"])
        expect(g["dangling"].len()).to_equal(0)

    it "summarises transitive raw returns for an importer":
        # @req: REQ-DIAG-POLICY-001
        step("client sees sensor_mid.fetch as raw")
        val sums = driver_bound_summaries_v1(inventory(), "client")
        expect(sums.len()).to_equal(1)
        expect(sums[0].module).to_equal("sensor_mid")
        expect(sums[0].raw_fns.contains("fetch")).to_equal(true)

    it "reports SPL-BOUND-002 for the client and not for the adapter client":
        # @req: REQ-DIAG-POLICY-001
        step("Project-wide findings keyed by module id")
        var client = 0
        var clean = 0
        for f in driver_bound_findings_v1(inventory()):
            if f.module == "client":
                client = client + 1
            if f.module == "clean_client":
                clean = clean + 1
        expect(client).to_equal(1)
        expect(clean).to_equal(0)

    it "terminates on cycles and ignores unresolved imports":
        # @req: REQ-DIAG-POLICY-001
        step("Cycle and dangling modules yield no summaries")
        expect(driver_bound_summaries_v1(inventory(), "cyc_a").len()).to_equal(0)
        expect(driver_bound_summaries_v1(inventory(), "dangling").len()).to_equal(0)

    it "does not reuse a summary truncated by a cycle exclusion":
        # @req: REQ-DIAG-POLICY-001
        step("Each ring member re-exports the other's raw fn; both clients must report")
        val ext = "extern fn c_read() -> i32\n\n"
        val unit_decl = "\n\nunit DistanceKm: i32 as km\n\nfn get_distance() -> DistanceKm:\n    return DistanceKm("
        var d: Dict<text, text> = {}
        d["ring_a"] = "use ring_b.{{b_raw}}\n" + ext + "pub fn a_raw() -> i32:\n    val raw = c_read()\n    return raw\n\npub fn a_via_b() -> i32:\n    b_raw()\n"
        d["ring_b"] = "use ring_a.{{a_raw}}\n" + ext + "pub fn b_raw() -> i32:\n    val raw = c_read()\n    return raw\n\npub fn b_via_a() -> i32:\n    a_raw()\n"
        d["ring_client_a"] = "use ring_a.{{a_via_b}}" + unit_decl + "a_via_b())\n"
        d["ring_client_b"] = "use ring_b.{{b_via_a}}" + unit_decl + "b_via_a())\n"
        var hits: [text] = []
        for f in driver_bound_findings_v1(d):
            if f.code == "SPL-BOUND-002" and f.module.starts_with("ring_client_"):
                hits.push(f.module)
        expect(hits.len()).to_equal(2)
        expect(hits.contains("ring_client_a")).to_equal(true)
        expect(hits.contains("ring_client_b")).to_equal(true)
