# BSM P6: build_session_end_reset_globals_v1 must also drop the resource
# registry and the mir_data `_bootstrap_fn_*` registries, which used to stay
# dangling into the ended session heap.

use std.spec
use compiler.driver.session.build_session.{build_session_end_reset_globals_v1}
use compiler.frontend.resource_registry.{resource_registry_declare,
    resource_registry_selective_mir_safe_v1}
use compiler.mir.mir_data.{bootstrap_fn_ret_shape_register,
    bootstrap_fn_ret_shape_lookup, bootstrap_fn_registries_entry_count_v1}

describe "build_session_end_reset_globals_v1":
    it "clears resource registry and bootstrap fn registries":
        resource_registry_declare("probe_res", "kind=file")
        bootstrap_fn_ret_shape_register("probe_fn", "text")
        expect(resource_registry_selective_mir_safe_v1()).to_equal(false)
        expect(bootstrap_fn_registries_entry_count_v1() > 0).to_equal(true)
        build_session_end_reset_globals_v1()
        expect(resource_registry_selective_mir_safe_v1()).to_equal(true)
        expect(bootstrap_fn_registries_entry_count_v1()).to_equal(0)
        expect(bootstrap_fn_ret_shape_lookup("probe_fn") == nil).to_equal(true)
