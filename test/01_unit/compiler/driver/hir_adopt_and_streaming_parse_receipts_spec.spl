# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# doc/08_tracking/bug/phase4_hir_adoption_reported_cached0_and_parse_shards_unpartitioned_2026-10-19.md
#
# Phase 4 full-CLI build (r13 Stage 2, 2702 modules, 8 workers) read as if
# the main build ignored the HIR shard pre-pass: every `[build] phase=hir`
# row said `cached=0` although the main build's own summary said
# `[hir-cache] hits=2702 misses=0 stores=0`. The HIR loop passed a literal 0
# as the `cached` progress argument. In the same build all 8 parse shards
# reported `claimed=0` and together ran ~11k body parses for 2702 modules:
# the streaming surface loop never consulted parse-shard ownership, and it
# printed no `[frontend-cache]` receipt at all, so the redundancy was silent.

use std.io_runtime.{file_read}
use compiler.driver.driver_hir_cache.{hir_cache_load_reencodes_v1, hir_cache_adoption_receipt_v1}

describe "HIR adoption and streaming parse receipts contract":
    it "HIR loop reports adopted cache hits as cached= progress, never a literal 0":
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        val start = source.index_of("val hir_shard_mode: bool = hir_shard_active()")
        expect(start >= 0).to_equal(true)
        val stop = source.index_of("log_phase(\"phase3:hir:loop:done")
        expect(stop > start).to_equal(true)
        val loop_body = source.substring(start, stop)
        # Three in-flight rows (shard claim, pre-lowering, post-lowering) all
        # carry the hit count. The phase-start "pending" row before the loop
        # legitimately reports 0: nothing has been adopted yet.
        val hit_rows = loop_body.split("hir_cache_hits(), \"running\")").len() - 1
        expect(hit_rows >= 3).to_equal(true)
        expect(loop_body.contains("source.module_name,\n                2, 6, 0, 0, \"running\")")).to_equal(false)

    it "main build prints an adopted= receipt before the hir-cache summary":
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        val receipt = source.index_of("hir_cache_adoption_receipt_v1(")
        val summary = source.index_of("print hir_cache_summary()")
        expect(receipt >= 0).to_equal(true)
        expect(summary > receipt).to_equal(true)

    it "adoption receipt names adopted and lowered counts under the hir-cache tag":
        expect(hir_cache_adoption_receipt_v1(2702, 0)).to_equal("[hir-cache] adopted=2702 lowered=0")
        expect(hir_cache_adoption_receipt_v1(0, 5)).to_equal("[hir-cache] adopted=0 lowered=5")

    it "streaming surface loop honors parse-shard ownership and prints the frontend-cache receipt":
        val source = file_read("src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        val start = source.index_of("me parse_all_streaming_surfaces_in_place_impl()")
        val stop = source.index_of("me parse_all_streaming_surfaces_impl()")
        expect(start >= 0).to_equal(true)
        expect(stop > start).to_equal(true)
        val body = source.substring(start, stop)
        expect(body).to_contain("_driver_parse_shard_owns(")
        expect(body).to_contain("print \"[frontend-cache] hits=")
        expect(body).to_contain("frontend_parse_cache_misses()")
        expect(body).to_contain("flat_parse_module_body_calls()")
        # A parse shard exits right after the loop; the surface registry is
        # the real build's job.
        val shard_exit = body.index_of("_sffi_exit(0)")
        val registry = body.index_of("builder.resolve_export_origins()")
        expect(shard_exit >= 0).to_equal(true)
        expect(registry > shard_exit).to_equal(true)

    it "cache load re-encodes the decoded module only under explicit full selfcheck":
        # The store side already refuses an unstable frame
        # (hir_cache_store_in_owned_scope), and the checksum covers the bytes,
        # so a hit decodes once. 2702 hits re-encoding 940 MB cost ~9 minutes.
        expect(hir_cache_load_reencodes_v1("off")).to_equal(false)
        expect(hir_cache_load_reencodes_v1("sampled")).to_equal(false)
        expect(hir_cache_load_reencodes_v1("all")).to_equal(true)
