"""Load the serializer through its canonical AST owners and check its wire header."""
use std.spec.{describe, it, expect, step}
use compiler.driver.smf_serialization.{serialize_templates}
use compiler.mono.monomorphize.partition.{GenericTemplates}

describe "SMF serializer canonical import owners":
    it "serializes an empty template set with the version two GTPL header":
        step("Call the real serializer after resolving its AST dependencies")
        val templates = GenericTemplates(functions: [], structs: [], classes: [], enums: [], traits: [])
        val encoded = serialize_templates(templates)
        expect(encoded.len()).to_equal(10)
        val expected: [i64] = [0x47, 0x54, 0x50, 0x4c, 2, 0, 0, 0, 0, 0]
        for index in 0..10:
            expect(encoded[index] as i64).to_equal(expected[index])
