use std.spec.*
use compiler.driver.driver_mir_physical_owners.{driver_mir_physical_source_indices_v1, driver_mir_feed_is_identity_v1,
    driver_mir_owner_disposition_v1, driver_mir_schedule_name_v1}

val MIR_ALIAS_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val MIR_OTHER_DIGEST = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

describe "MIR birth feed identity requires actual ordered owners":
    it "preserves a feed matching the complete admitted order":
        expect(driver_mir_feed_is_identity_v1([0, 1], ["app.a", "app.b"], ["app.a", "app.b"])).to_equal(true)

    it "rejects a reversed feed despite equal counts and identity source indices":
        expect(driver_mir_feed_is_identity_v1([0, 1], ["app.a", "app.b"], ["app.b", "app.a"])).to_equal(false)

    it "rejects missing and extra actual feed owners":
        expect(driver_mir_feed_is_identity_v1([0, 1], ["app.a", "app.b"], ["app.a"])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([0], ["app.a"], ["app.a", "app.b"])).to_equal(false)

    it "rejects filtered inventories even when retained feed owners match":
        expect(driver_mir_feed_is_identity_v1([0, 2], ["app.a", "app.alias", "app.b"], ["app.a", "app.b"])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([0], ["app.a", "app.alias"], ["app.a"])).to_equal(false)

    it "rejects reordered duplicate and out of bounds indices":
        expect(driver_mir_feed_is_identity_v1([1, 0], ["app.a", "app.b"], ["app.b", "app.a"])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([0, 0], ["app.a", "app.b"], ["app.a", "app.a"])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([-1], ["app.a"], ["app.a"])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([1], ["app.a"], ["app.a"])).to_equal(false)

    it "uses canonical provider owners while refusing empty or wrong owners":
        expect(driver_mir_feed_is_identity_v1([0], ["lib.common.provider"], ["std.common.provider"])).to_equal(true)
        expect(driver_mir_feed_is_identity_v1([0], [""], [""])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([0], ["app.a"], [""])).to_equal(false)
        expect(driver_mir_feed_is_identity_v1([0], ["app.a"], ["app.other"])).to_equal(false)

describe "MIR work owns admitted physical surfaces":
    it "retains one std/lib provider while preserving another source":
        val paths = ["src/lib/common/provider.spl", "src/lib/common/provider.spl", "src/app/main.spl"]
        val identities = [MIR_ALIAS_DIGEST, MIR_ALIAS_DIGEST, MIR_OTHER_DIGEST]
        val owners = ["lib.common.provider", "std.common.provider", "app.main"]
        val result = driver_mir_physical_source_indices_v1(paths, identities, owners)
        expect(result.is_ok()).to_equal(true)
        val selected = result.unwrap()
        expect(selected.len()).to_equal(2)
        expect(selected[0]).to_equal(0)
        expect(selected[1]).to_equal(2)
        expect(paths.len()).to_equal(3)
        expect(identities[1]).to_equal(MIR_ALIAS_DIGEST)

    it "chooses the first admitted row even when the std alias precedes lib":
        val result = driver_mir_physical_source_indices_v1(
            ["src/lib/common/provider.spl", "src/lib/common/provider.spl"],
            [MIR_ALIAS_DIGEST, MIR_ALIAS_DIGEST],
            ["std.common.provider", "lib.common.provider"])
        expect(result.is_ok()).to_equal(true)
        val selected = result.unwrap()
        expect(selected.len()).to_equal(1)
        expect(selected[0]).to_equal(0)

    it "rejects changed content under the same owner and physical path":
        val result = driver_mir_physical_source_indices_v1(
            ["src/lib/common/provider.spl", "src/lib/common/provider.spl"],
            [MIR_ALIAS_DIGEST, MIR_OTHER_DIGEST],
            ["lib.common.provider", "std.common.provider"])
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("ownership conflict")

    it "rejects a second physical declaration with the same canonical owner":
        val result = driver_mir_physical_source_indices_v1(
            ["src/lib/common/provider.spl", "other/lib/common/provider.spl"],
            [MIR_ALIAS_DIGEST, MIR_ALIAS_DIGEST],
            ["lib.common.provider", "std.common.provider"])
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("ownership conflict")

    it "rejects distinct canonical owners claiming the same physical source":
        val result = driver_mir_physical_source_indices_v1(
            ["src/lib/common/provider.spl", "src/lib/common/provider.spl"],
            [MIR_ALIAS_DIGEST, MIR_ALIAS_DIGEST],
            ["lib.common.provider", "lib.common.other"])
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("conflicting owners")

    it "does not merge equal basenames from different owners":
        val result = driver_mir_physical_source_indices_v1(
            ["src/lib/left/provider.spl", "src/lib/right/provider.spl"],
            [MIR_ALIAS_DIGEST, MIR_ALIAS_DIGEST],
            ["lib.left.provider", "lib.right.provider"])
        expect(result.is_ok()).to_equal(true)
        val selected = result.unwrap()
        expect(selected.len()).to_equal(2)

    it "rejects missing content identity and inventory shape mismatch":
        val missing = driver_mir_physical_source_indices_v1(["provider.spl"], [""], ["provider"])
        expect(missing.is_err()).to_equal(true)
        val malformed = driver_mir_physical_source_indices_v1(["provider.spl"], [], ["provider"])
        expect(malformed.is_err()).to_equal(true)

    it "rejects truncated and non-hex content identities":
        val truncated = driver_mir_physical_source_indices_v1(["provider.spl"], ["aaaaaaaa"], ["provider"])
        expect(truncated.is_err()).to_equal(true)
        val malformed = driver_mir_physical_source_indices_v1(["provider.spl"],
            ["gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg"], ["provider"])
        expect(malformed.is_err()).to_equal(true)

# bug per_file_lane_unit_mir_physical_ownership_missing_hir_2026-11-12: a
# per-file unit (module-scoped MIR) holds HIR only for its targets and their
# load closure, so the ownership gate must not demand HIR for every row.
describe "MIR physical ownership in a module-scoped per-file unit":
    it "uses held HIR whether or not the unit is scoped":
        expect(driver_mir_owner_disposition_v1(false, false, true)).to_equal("hir")
        expect(driver_mir_owner_disposition_v1(true, false, true)).to_equal("hir")
        expect(driver_mir_owner_disposition_v1(true, true, true)).to_equal("hir")

    it "stands in an unheld non-target row of a scoped unit":
        expect(driver_mir_owner_disposition_v1(true, false, false)).to_equal("placeholder")

    it "still fails closed on an unheld target of a scoped unit":
        expect(driver_mir_owner_disposition_v1(true, true, false)).to_equal("missing")

    it "keeps the whole-inventory demand outside a scoped unit":
        expect(driver_mir_owner_disposition_v1(false, false, false)).to_equal("missing")
        expect(driver_mir_owner_disposition_v1(false, true, false)).to_equal("missing")

    it "publishes the same ledger schedule from units holding different HIR":
        # Unit A holds only the leaf; unit B holds the entry and the alias
        # provider. Every unit must publish the identical inventory.
        val logical = ["app.p3rp.aa", "std.common.provider", "app.p3rp.main"]
        val hir_names = ["app.p3rp.aa", "lib.common.provider", "app.p3rp.main"]
        val held_a = [true, false, false]
        val held_b = [false, true, true]
        var schedule_a: [text] = []
        var schedule_b: [text] = []
        var index = 0
        while index < logical.len():
            schedule_a = schedule_a.push(driver_mir_schedule_name_v1(true, held_a[index],
                if held_a[index]: hir_names[index] else: "", logical[index]))
            schedule_b = schedule_b.push(driver_mir_schedule_name_v1(true, held_b[index],
                if held_b[index]: hir_names[index] else: "", logical[index]))
            index = index + 1
        expect(schedule_a.join("|")).to_equal(schedule_b.join("|"))
        expect(schedule_a[1]).to_equal("lib.common.provider")

    it "leaves the unscoped unheld schedule name unchanged":
        expect(driver_mir_schedule_name_v1(false, false, "", "std.common.provider")).to_equal("std.common.provider")
        expect(driver_mir_schedule_name_v1(false, true, "std.common.provider", "x")).to_equal("lib.common.provider")
