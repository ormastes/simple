"""
# HIR If payload decoding contract

The staged native bridge must not rely on destructuring the multi-field
HirExprKind.If arm. Its condition and then-block are mandatory aggregate
payloads and must be decoded and validated before lower_cond_expr reads
`cond.kind`.
"""

extern fn rt_file_read_text(path: text) -> text

describe "HIR If payload decoding" :
    it "decodes and validates If before native pattern dispatch" :
        val expr_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        val stmt_source = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(expr_source).to_contain("val if_payload = rt_enum_payload(expr_value.kind)")
        expect(expr_source).to_contain("val if_cond: HirExpr = rt_tuple_get(if_payload, 0)")
        expect(expr_source).to_contain("val if_then: HirBlock = rt_tuple_get(if_payload, 1)")
        expect(expr_source).to_contain("if if_cond == nil or if_then == nil:")
        expect(expr_source).to_contain("val bad_if = b_bad_if.new_temp(MirType.unit())")
        expect(expr_source).to_contain("if expr_value.has_type_ and expr_value.type_ != nil:")
        expect(expr_source).to_contain("if expr.has_type_ and expr.type_ != nil:")
        expect(stmt_source).to_contain("if cond == nil:")
        expect(stmt_source).to_contain("val bad_cond = b_bad_cond.new_temp(MirType.unit())")

    it "decodes recursive Binary operands before native pattern dispatch" :
        val expr_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        expect(expr_source).to_contain("val binary_payload = rt_enum_payload(expr_value.kind)")
        expect(expr_source).to_contain("val binary_op: HirBinOp = rt_tuple_get(binary_payload, 0)")
        expect(expr_source).to_contain("val binary_left: HirExpr = rt_tuple_get(binary_payload, 1)")
        expect(expr_source).to_contain("val binary_right: HirExpr = rt_tuple_get(binary_payload, 2)")
        expect(expr_source).to_contain("return self.lower_binary_expr(expr_value, binary_op, binary_left, binary_right)")
