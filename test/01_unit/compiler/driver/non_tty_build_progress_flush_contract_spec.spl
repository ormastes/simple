use std.spec.*
use std.io_runtime.{file_read}

describe("native-build non-tty progress flushing"):
    it("emits and flushes progress before consulting the optional event file"):
        val source = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        val emit_at = source.index_of("eprint(line)")
        val flush_at = source.index_of("stderr_flush()")
        val path_at = source.index_of("val path = _build_progress_path()")

        expect(emit_at).to_be_greater_than(0)
        expect(flush_at).to_be_greater_than(emit_at)
        expect(path_at).to_be_greater_than(flush_at)
        expect(source).to_contain("event=build_progress")

    it("keeps the durable event-file append optional without suppressing stderr"):
        val source = file_read("src/compiler/80.driver/driver_log_helpers.spl")

        expect(source).to_contain("if path != \"\":")
        expect(source).to_contain("file_append(path, line)")
        expect(source.contains("if path == \"\":\n        return")).to_equal(false)
