"""
## Purpose and audience
Driver maintainers. The entry-closure import scan walks a source one line at a time
through `_driver_line_end`, which must find each newline and the end of a final
unterminated line without allocating. Natively compiled Stage 2 code copied the whole
source per line through `index_of`, quadratic in memory on large generated files
(doc/08_tracking/bug/text_method_arg_copied_through_extern_abi_per_call_2026-10-25.md).
This interpreter-lane spec pins the line-walk contract; it cannot show the native copy.
"""
use std.spec.step
use std.spipe.*
use compiler.driver.driver_source_loading.{_driver_entry_import_module_paths}

describe "entry import scan line walk":
    it "keeps imports on every line including a final unterminated one":
        step("Scan a source whose last line has no trailing newline")
        val source = "use first.owner.\{A}\nfn f():\n    0\n\nuse last.owner.\{B}"
        expect(_driver_entry_import_module_paths(source)).to_equal(
            ["first.owner", "last.owner"])

    it "handles a source that starts with an empty line":
        val source = "\nuse only.owner.\{C}\n"
        expect(_driver_entry_import_module_paths(source)).to_equal(["only.owner"])
