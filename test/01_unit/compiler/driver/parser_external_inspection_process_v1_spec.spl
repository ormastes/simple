use std.spec.*
use compiler.driver.parser_external_inspection_process_v1.*
use compiler.driver.parser_external_inspection_tool_owner_v1.ParserExternalInspectionToolKindV1

describe "compiler external inspection process stage":
    it "reserves stderr within the native combined 16 MiB capture budget":
        expect(PARSER_INSPECTION_STDOUT_LIMIT_V1).to_equal(15 * 1024 * 1024)
        expect(PARSER_INSPECTION_STDERR_LIMIT_V1).to_equal(1024 * 1024)
        expect(PARSER_INSPECTION_STDOUT_LIMIT_V1 +
            PARSER_INSPECTION_STDERR_LIMIT_V1).to_equal(16 * 1024 * 1024)

    it "pins readobj arguments to all three codec inputs and stdin":
        expect(parser_inspection_process_argv_v1(ParserExternalInspectionToolKindV1.Readobj)).to_equal(
            ["llvm-readobj", "--elf-output-style=JSON", "--file-headers", "--sections",
                "--section-data", "--symbols", "--relocations", "--expand-relocs", "-"])

    it "keeps objdump default raw bytes and stdin":
        expect(parser_inspection_process_argv_v1(ParserExternalInspectionToolKindV1.Objdump)).to_equal(
            ["llvm-objdump", "-d", "-"])

    it "cannot collect or acknowledge an idle process":
        var stage = ParserExternalInspectionProcessV1.create()
        expect(stage.collect().is_err()).to_equal(true)
        expect(stage.acknowledge().is_err()).to_equal(true)
        expect(stage.state()).to_equal(ParserInspectionProcessStateV1.Idle)

    it "rejects cleanup without a native lease and keeps idle state":
        var stage = ParserExternalInspectionProcessV1.create()
        expect(stage.cleanup().is_err()).to_equal(true)
        expect(stage.state()).to_equal(ParserInspectionProcessStateV1.Idle)
