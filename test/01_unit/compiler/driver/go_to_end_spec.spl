"""Relative-import handling in go-to-end blocked-module propagation."""

use compiler.driver.driver_build.go_to_end.{go_to_end_resolve_import_v1, go_to_end_blocked_modules_v1}
use testing.{describe, it, expect}

describe "go-to-end relative imports":
    it "resolves .x as a sibling":
        expect(go_to_end_resolve_import_v1("compiler.hir.a", ".x")).to_equal("compiler.hir.x")

    it "resolves ..x one package level up":
        expect(go_to_end_resolve_import_v1("compiler.hir.a", "..x")).to_equal("compiler.x")

    it "leaves absolute imports unchanged":
        expect(go_to_end_resolve_import_v1("compiler.hir.a", "std.text")).to_equal("std.text")

    it "blocks importers of a failed sibling via relative paths":
        val blocked = go_to_end_blocked_modules_v1(["compiler.hir.a", "compiler.hir.b", "compiler.c"],
            ["compiler.hir.a", "compiler.c"], [".x", ".hir.x"], ["compiler.hir.x"])
        expect(blocked.len()).to_equal(2)
