# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/go_to_end.spl 0%
"""
# native-build --go-to-end: selection and failure manifest

**Category:** Compiler / driver

## Purpose and Audience

Phase-3 attempt 7 lowered 1250 modules, failed 104, and stopped before codegen:
0 objects, not even for the good modules. `--go-to-end` continues every stage
with the modules that can still be built, writes their objects to the cache,
never links, and names every failure in `<output>.go-to-end.sdn`. This spec
pins the pure parts: which modules a HIR failure excludes, and the manifest.

## Expected Outcome

A module importing a failed module (directly or transitively) is excluded;
unrelated modules are not. Logical `std.` imports match physical `lib.` names.
The manifest lists each failure under its stage, reports `linked: false`, and
quotes messages so they stay one SDN row.
"""
use std.spec.step
use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use compiler.driver.driver_build.go_to_end.{GoToEndLedgerV1,
    go_to_end_manifest_path_v1, go_to_end_import_names_module_v1,
    go_to_end_blocked_modules_v1, go_to_end_sdn_quote_v1,
    go_to_end_manifest_text_v1}

describe "go-to-end import matching":
    it "matches exact and logical std imports":
        # @req REQ-SSPEC-COMPILER
        step("matches exact and logical std imports")
        assert_true(go_to_end_import_names_module_v1("bad_b", "bad_b"))
        assert_true(go_to_end_import_names_module_v1("std.common.text", "lib.common.text"))
        assert_true(go_to_end_import_names_module_v1("compiler.hir.hir_types", "compiler.hir.hir_types"))

    it "does not match an unrelated module":
        # @req REQ-SSPEC-COMPILER
        step("does not match an unrelated module")
        assert_false(go_to_end_import_names_module_v1("good_a", "bad_b"))
        assert_false(go_to_end_import_names_module_v1("", "bad_b"))
        assert_false(go_to_end_import_names_module_v1("text_extra", "lib.common.text"))

describe "go-to-end dependency selection":
    it "excludes direct and transitive importers of a failed module only":
        # @req REQ-SSPEC-COMPILER
        step("excludes direct and transitive importers of a failed module only")
        # main -> mid -> bad ; leaf -> good ; good has no imports.
        val candidates = ["main", "mid", "leaf", "good"]
        val edge_from = ["main", "mid", "leaf"]
        val edge_to = ["mid", "bad", "good"]
        val blocked = go_to_end_blocked_modules_v1(candidates, edge_from, edge_to, ["bad"])
        assert_equal(blocked.len(), 2)
        assert_true(blocked.contains("mid"))
        assert_true(blocked.contains("main"))
        assert_false(blocked.contains("leaf"))
        assert_false(blocked.contains("good"))

    it "excludes nothing when no candidate imports a failure":
        # @req REQ-SSPEC-COMPILER
        step("excludes nothing when no candidate imports a failure")
        val blocked = go_to_end_blocked_modules_v1(["a", "b"], ["a"], ["b"], ["c"])
        assert_equal(blocked.len(), 0)

describe "go-to-end ledger and manifest":
    it "records failures per stage and excludes failed modules":
        # @req REQ-SSPEC-COMPILER
        step("records failures per stage and excludes failed modules")
        var ledger = GoToEndLedgerV1.empty()
        ledger.record("mir", "bad_b", "for-in over non-array")
        ledger.record("mir", "bad_b", "second error")
        ledger.record("codegen", "worse_c", "ERROR: llvm")
        ledger.exclude("bad_b")
        ledger.exclude("bad_b")
        assert_equal(ledger.len(), 3)
        assert_equal(ledger.count_stage("mir"), 2)
        assert_equal(ledger.stage_modules("mir").len(), 1)
        assert_true(ledger.is_excluded("bad_b"))
        assert_false(ledger.is_excluded("good_a"))
        assert_equal(ledger.excluded.len(), 1)
        assert_true(ledger.has_message("second error"))

    it "writes a manifest naming the failed module and never claims a link":
        # @req REQ-SSPEC-COMPILER
        step("writes a manifest naming the failed module and never claims a link")
        var ledger = GoToEndLedgerV1.empty()
        ledger.record("mir", "bad_b", "unsupported \"for\" at bad_b.spl:4")
        val text_out = go_to_end_manifest_text_v1("out/fixture.exe", ledger, 2, ["main", "good_a"])
        assert_true(text_out.contains("schema: \"simple-native-go-to-end-v1\""))
        assert_true(text_out.contains("linked: false"))
        assert_true(text_out.contains("object_count: 2"))
        assert_true(text_out.contains("failed_count: 1"))
        assert_true(text_out.contains("    mir: [\"bad_b\"]"))
        assert_true(text_out.contains("    hir: []"))
        assert_true(text_out.contains("built: [\"main\", \"good_a\"]"))
        assert_true(text_out.contains("  mir, \"bad_b\", \"unsupported \\\"for\\\" at bad_b.spl:4\""))
        assert_equal(go_to_end_manifest_path_v1("out/fixture.exe"), "out/fixture.exe.go-to-end.sdn")
        # The CLI's private temporary output maps back to the user's output.
        assert_equal(go_to_end_manifest_path_v1("out/fixture.exe.simple-native-build-34908-1792467268895743.tmp"),
            "out/fixture.exe.go-to-end.sdn")

    it "keeps a multi-line message on one row":
        # @req REQ-SSPEC-COMPILER
        step("keeps a multi-line message on one row")
        assert_equal(go_to_end_sdn_quote_v1("a\nb"), "\"a\\nb\"")
        assert_equal(go_to_end_sdn_quote_v1("c:\\x"), "\"c:\\\\x\"")
