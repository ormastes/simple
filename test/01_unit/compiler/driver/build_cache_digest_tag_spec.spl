# Gap hash_algorithm_tag (live_object_key.sdn) closed for persisted build-cache
# digests: written as DigestV1 `sha256:<hex>`, and read back only when they
# name sha256 -- untagged legacy, unknown or other-algorithm values are a miss.
use std.spec
use compiler.driver.driver_build.incremental.{incremental_digest_tag_v1, incremental_digest_untag_v1}

val HEX: text = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

describe "build cache digest tagging":
    it "round-trips a sha256 digest through its tagged text":
        expect(incremental_digest_tag_v1(HEX)).to_equal("sha256:" + HEX)
        expect(incremental_digest_untag_v1(incremental_digest_tag_v1(HEX))).to_equal(HEX)

    it "keeps the fail-closed sentinel and rejects malformed hex":
        expect(incremental_digest_tag_v1("")).to_equal("")
        expect(incremental_digest_tag_v1("not-hex")).to_equal("")

    it "reads untagged, unknown and other-algorithm digests as a miss":
        expect(incremental_digest_untag_v1(HEX)).to_equal("")
        expect(incremental_digest_untag_v1("md5:" + HEX)).to_equal("")
        expect(incremental_digest_untag_v1("blake3:" + HEX)).to_equal("")
        expect(incremental_digest_untag_v1("xxh3-128:0123456789abcdef0123456789abcdef")).to_equal("")
        expect(incremental_digest_untag_v1("")).to_equal("")
