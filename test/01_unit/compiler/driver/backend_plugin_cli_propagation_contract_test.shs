#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
opts="$root/src/compiler/00.common/driver_compile_options.spl"
cli="$root/src/app/cli/bootstrap_main.spl"
driver="$root/src/compiler/80.driver/driver_aot_native_output.spl"
receipt="$root/src/compiler/00.common/backend_plugin/receipt.spl"
warm="$root/src/app/cli/native_build_warm_receipt.spl"
native_cli="$root/src/app/cli/native_build_main.spl"
grep -q 'backend_plugin_path: text = ""' "$opts"
grep -q 'normalized.backend_plugin_path = backend_plugin_path' "$opts"
grep -q 'fn native_build_backend_plugin_from_args' "$cli"
grep -q 'options.backend_plugin_path = native_build_backend_plugin_from_args' "$cli"
grep -q 'BACKEND_PLUGIN_BRIDGE_NOT_READY' "$driver"
grep -q 'plugin_path_policy' "$receipt"
grep -q 'paths.push(backend_plugin)' "$warm"
grep -q 'arg == "--backend-plugin"' "$native_cli"
printf '%s\n' 'PASS backend plugin CLI propagation contract'
