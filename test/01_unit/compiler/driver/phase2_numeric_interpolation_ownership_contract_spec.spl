use std.spec
use std.io_runtime.{file_read}

describe "phase2 diagnostic interpolation ownership containment":
    it "removes heap-count interpolation from the active phase2 surface diagnostic":
        val driver = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        val surface = file_read("src/compiler/20.hir/hir_lowering/module_surface.spl")
        expect(driver).to_contain("phase2:surface:file:released path={path} seq={seq}\\n")
        expect(driver.contains("phase2:surface:file:released path={path} seq={seq} heap_registry=")).to_equal(false)
        expect(surface.contains("heap_registry={rt_heap_registry_count()}")).to_equal(false)
        expect(driver.contains("heap_registry={rt_heap_registry_count()}")).to_equal(false)

    it "keeps generic numeric interpolation available outside the quarantined lines":
        val driver = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        expect(driver).to_contain("[BOOTSTRAP-PHASE] +{_phase_elapsed_ms()}ms {msg}")
        expect(driver).to_contain("heap_live_bytes={rt_heap_live_bytes()} heap_peak_bytes={rt_heap_peak_bytes()}")
