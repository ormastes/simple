use std.spec
use compiler.driver.cache.module_surface_skeleton_v1.{module_surface_skeleton_v1}

# Run-26 Stage 2 (2026-11-13): `len()` counts code points while `substring`
# indexes UTF-8 bytes. The skeleton's delimiter scan bounded its byte cursor
# by `len()`, so on any line holding a multibyte character it stopped short of
# a closing triple quote at the line end, carried the string state onward and
# blanked every later declaration as string body. HIR shard workers parse the
# skeleton, so lib.common.math.special lost exp_f64/ln_f64 and the importers
# (statistics, execution_metrics, ...) failed HIR lowering.
# Kept apart from module_surface_skeleton_v1_spec, which the seed cannot parse.

val Q: text = "\"\"\""

describe "module surface skeleton with multibyte source":
    it "keeps declarations after a docstring line that carries a multibyte character":
        val source = "pub fn a() -> i64:\n    " + Q + "Doc — x." + Q + "\n    1\n\npub fn b() -> i64:\n    2\n"
        val skeleton = module_surface_skeleton_v1(source)
        expect(skeleton.split("\n").len()).to_equal(source.split("\n").len())
        expect(skeleton.contains("pub fn b() -> i64:")).to_equal(true)
        expect(skeleton.contains("    2")).to_equal(false)
