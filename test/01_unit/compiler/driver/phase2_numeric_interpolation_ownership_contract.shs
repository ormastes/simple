#!/bin/sh
set -eu

driver=src/compiler/80.driver/driver_log_helpers.spl
surface=src/compiler/20.hir/hir_lowering/module_surface.spl
bug=doc/08_tracking/bug/stage3_numeric_interpolation_slot_corruption_2026-08-13.md

grep -F 'phase2:surface:file:released path={path} seq={seq}\n' "$driver" >/dev/null
! grep -F 'phase2:surface:file:released path={path} seq={seq} heap_registry=' "$driver" >/dev/null
! grep -F 'heap_registry={rt_heap_registry_count()}' "$surface" >/dev/null
! grep -F 'extern fn rt_heap_registry_count()' "$surface" >/dev/null
grep -F '[BOOTSTRAP-PHASE] +{_phase_elapsed_ms()}ms {msg}' "$driver" >/dev/null
grep -F 'heap_live_bytes={rt_heap_live_bytes()} heap_peak_bytes={rt_heap_peak_bytes()}' "$driver" >/dev/null
! grep -F 'heap_registry={rt_heap_registry_count()}' "$driver" >/dev/null
grep -F 'SIMPLE_COMPILER_PHASE_PROFILE' "$bug" >/dev/null
grep -F 'SIMPLE_COMPILER_TRACE' "$bug" >/dev/null
grep -F 'SIMPLE_MEM_SNAPSHOT' "$bug" >/dev/null
grep -F 'Generic numeric interpolation remains enabled elsewhere and is not fixed' "$bug" >/dev/null
