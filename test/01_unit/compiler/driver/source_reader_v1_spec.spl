use std.spec
use compiler.driver.cache.source_reader_v1.{file_source_reader_v1}

extern fn rt_file_write_text(path: text, content: text) -> bool

val DIR: text = "build/test_tmp/source_reader_v1"

describe "FileReader (SourceReader)":
    it "returns no AST and no TLDR for a missing source":
        val reader = file_source_reader_v1(DIR + "/tldr")
        expect(reader.read_src(DIR + "/missing.spl") == nil).to_equal(true)
        expect(reader.read_tldr(DIR + "/missing.spl")).to_equal("")

    it "makes the TLDR current on update and reports stale after a source edit":
        val reader = file_source_reader_v1(DIR + "/tldr")
        val src = DIR + "/m.spl"
        expect(rt_file_write_text(src, "pub struct P:\n    x: i64\n")).to_equal(true)
        expect(reader.read_tldr(src)).to_equal("")
        expect(reader.update_tldr(src)).to_equal("")
        expect(reader.read_tldr(src).contains("section: layout")).to_equal(true)
        expect(rt_file_write_text(src, "pub struct P:\n    y: i64\n")).to_equal(true)
        expect(reader.read_tldr(src)).to_equal("")

    it "restores or parses the AST through the frontend cache boundary":
        val reader = file_source_reader_v1(DIR + "/tldr")
        val src = DIR + "/m.spl"
        val parsed = reader.read_src(src)
        expect(parsed != nil).to_equal(true)
        expect(reader.update_src(src)).to_equal(true)
