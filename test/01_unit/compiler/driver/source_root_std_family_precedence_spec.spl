use std.spec.*
use std.nogc_sync_mut.io_runtime.{file_read_nullable}
use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use compiler.common.driver_core_types.{SourceFile}
use compiler.driver.driver_source_loading.{_driver_resolve_source_root_entry_import_v1}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*

fn selected_path(result: SourceRootResolutionV1) -> text:
    match result:
        case SourceRootResolutionV1.Found(path): path
        case SourceRootResolutionV1.Missing: "MISSING"
        case SourceRootResolutionV1.Ambiguous(_): "AMBIGUOUS"

val FIXTURE_LIB = "test/fixtures/compiler/std_family_owner/lib"
val OVERLAY = "test/fixtures/compiler/std_family_owner/overlay"
val AMBIGUOUS_LIB = "test/fixtures/compiler/std_family_owner/ambiguous/lib"

describe "declared std family module ownership":
    it "selects the real SHA3 module before the crypto parent facade":
        val path = selected_path(_driver_resolve_source_root_entry_import_v1(
            "std.crypto.sha3", ["src/lib"]))
        expect(path).to_equal("src/lib/common/crypto/sha3.spl")
        val content = file_read_nullable(path)
        expect(content != nil).to_equal(true)
        val source = content.unwrap()
        val parsed = parse_and_build_module(source, path)
        val frozen = module_surfaces_from_modules(
            {"std.crypto.sha3": parsed},
            [SourceFile(path: path, content: source, module_name: "std.crypto.sha3")])
        expect(frozen.is_ok()).to_equal(true)
        val surfaces = frozen.unwrap()
        val target = surfaces.surfaces[0]
        expect(target.canonical_path).to_equal(path)
        var lowering = hirlowering_for_module("probe.spl", surfaces)
        expect(lowering.surface_declares_item_indexed(target, "sha3_256_bytes")).to_equal(true)
        expect(lowering.surface_declares_item_indexed(target, "sha3_384_bytes")).to_equal(true)
        expect(lowering.surface_declares_item_indexed(target, "sha3_512_bytes")).to_equal(true)

    it "finishes the family module before shortening to a sibling facade":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "std.crypto.sha3", [FIXTURE_LIB]))).to_equal(
            FIXTURE_LIB + "/common/crypto/sha3.spl")

    it "preserves later exact declared roots ahead of family fallback":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "std.crypto.sha3", [FIXTURE_LIB, OVERLAY]))).to_equal(
            OVERLAY + "/std/crypto/sha3.spl")

    it "keeps legitimate terminal item imports on their owning module":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "std.crypto.facade_only", [FIXTURE_LIB]))).to_equal(
            FIXTURE_LIB + "/crypto.spl")
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "std.crypto.sha3.family_owner", [FIXTURE_LIB]))).to_equal(
            FIXTURE_LIB + "/common/crypto/sha3.spl")

    it "rejects ambiguous family owners before parent or later family fallback":
        expect(selected_path(_driver_resolve_source_root_entry_import_v1(
            "std.crypto.sha3", [AMBIGUOUS_LIB, FIXTURE_LIB]))).to_equal("AMBIGUOUS")
