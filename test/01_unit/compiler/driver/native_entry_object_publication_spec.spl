# Filesystem publication boundary tests; compiler-generated entry parity is the
# separate object_reuse_driver_spec native scenario. These are not codegen proof.
use std.spec.{describe, it, expect}
use std.io_runtime.{file_write_exact, file_exists}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir_raw}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove}
use std.nogc_sync_mut.path.{dirname}
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.driver_types.{CompileContext, FrozenNativeModuleCapsuleV1}
use compiler.driver.driver_aot_native_output.{driver_native_capsule_result_bytes_v1,
    driver_native_entry_object_copy_v1}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.mir.mir_data.{MirModule}

fn entry_publication_fixture(root: text) -> FrozenNativeModuleCapsuleV1:
    val ctx = CompileContext.create(driver_core_compile_options_default())
    ctx.mir_modules["entry_publication"] = MirModule(
        name: "entry_publication", functions: {}, statics: {}, constants: {}, types: {})
    expect(ctx.freeze_storage_registry() == "invalid").to_equal(false)
    val batch = ctx.freeze_native_module_capsules_v1(
        ["entry_publication"], root + "/objects", "cranelift",
        "aarch64-unknown-linux-gnu", "", 0, false, "provider-v1",
        {"entry_publication": "complete-witness-v1"}, {"entry_publication": "ok"})
    expect(batch.ok).to_equal(true)
    val capsule = batch.find("entry_publication")
    expect(capsule.ok).to_equal(true)
    expect(dir_create_all(dirname(capsule.object_path))).to_equal(true)
    capsule

fn entry_publication_write(capsule: FrozenNativeModuleCapsuleV1, bytes: text):
    expect(file_write_exact(capsule.object_path, bytes)).to_equal(true)
    val receipt = "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n{bytes.len()}\n{sha256_text(bytes)}\n"
    expect(file_write_exact(capsule.object_path + ".capsule-receipt", receipt)).to_equal(true)

describe "entry object publication retains admission identity":
    it "rejects replacement even when the replacement has a valid new receipt":
        val root = secure_temp_dir_raw("/tmp", "simple-entry-replacement")
        expect(root == "").to_equal(false)
        val capsule = entry_publication_fixture(root)
        entry_publication_write(capsule, "original-object-bytes")
        val admitted = driver_native_capsule_result_bytes_v1(capsule)
        expect(admitted.is_ok()).to_equal(true)
        val (digest, size) = admitted.unwrap()
        # Deterministic race interleaving: replace both mutable paths after the
        # successful admission, before the publication source handle is opened.
        entry_publication_write(capsule, "replaced-object-bytes")
        expect(driver_native_capsule_result_bytes_v1(capsule).is_ok()).to_equal(true)
        val copied = driver_native_entry_object_copy_v1(
            capsule.object_path, root + "/entry.o", digest, size, capsule.capsule_identity)
        expect(copied.is_err()).to_equal(true)
        expect(file_exists(root + "/entry.o")).to_equal(false)
        expect(dir_remove(root, true)).to_equal(true)

    it "publishes original admitted bytes durably and accepts equal bytes again":
        val root = secure_temp_dir_raw("/tmp", "simple-entry-idempotent")
        expect(root == "").to_equal(false)
        val capsule = entry_publication_fixture(root)
        entry_publication_write(capsule, "original-object-bytes")
        val (digest, size) = driver_native_capsule_result_bytes_v1(capsule).unwrap()
        val copied = driver_native_entry_object_copy_v1(
            capsule.object_path, root + "/entry.o", digest, size, capsule.capsule_identity)
        expect(copied.is_ok()).to_equal(true)
        expect(copied.unwrap()).to_equal(digest)
        expect(driver_native_entry_object_copy_v1(
            capsule.object_path, root + "/entry.o", digest, size, capsule.capsule_identity).is_ok()).to_equal(true)
        expect(driver_native_entry_object_copy_v1(
            capsule.object_path, root + "/oversize.o", digest, 67108865, capsule.capsule_identity).is_err()).to_equal(true)
        expect(file_exists(root + "/oversize.o")).to_equal(false)
        expect(dir_remove(root, true)).to_equal(true)

    it "copies an object above 64 KiB using the whole retained-file owner":
        val root = secure_temp_dir_raw("/tmp", "simple-entry-whole-read")
        expect(root == "").to_equal(false)
        val capsule = entry_publication_fixture(root)
        var bytes = "x"
        for index in 0..17:
            bytes = bytes + bytes
        expect(bytes.len()).to_equal(131072)
        entry_publication_write(capsule, bytes)
        val (digest, size) = driver_native_capsule_result_bytes_v1(capsule).unwrap()
        val copied = driver_native_entry_object_copy_v1(
            capsule.object_path, root + "/large-entry.o", digest, size,
            capsule.capsule_identity)
        expect(copied.is_ok()).to_equal(true)
        expect(copied.unwrap()).to_equal(sha256_text(bytes))
        expect(driver_native_entry_object_copy_v1(
            capsule.object_path, root + "/empty.o", digest, 0,
            capsule.capsule_identity).is_err()).to_equal(true)
        expect(file_exists(root + "/empty.o")).to_equal(false)
        expect(dir_remove(root, true)).to_equal(true)
