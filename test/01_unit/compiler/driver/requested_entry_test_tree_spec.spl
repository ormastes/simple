# Bug: doc/08_tracking/bug/native_build_absolute_entry_zero_sources_2026-11-12.md
# The requested entry must not be dropped by the closure packaging filter
# (test/doc trees) that exists for IMPORTED modules.
use std.spec.*
use compiler.driver.driver_entry_closure_core.{_driver_collect_entry_import_source, _driver_collect_requested_entry_source}

describe "requested native entry inside a test tree":
    it "keeps the entry while imported test-tree modules stay filtered":
        """
        A spelling containing `/test/` (an absolute or frozen-snapshot path
        such as `<checkout>/build/scv/snapshots/<rev>/test/...`) made the
        parse-shard children collect zero sources for a test/ fixture entry.
        """
        val entry = "./test/01_unit/app/provider_cli/fixtures/provider_hello.spl"
        expect(_driver_collect_entry_import_source(entry).len()).to_equal(0)
        expect(_driver_collect_requested_entry_source(entry).len()).to_be_greater_than(0)
        expect(_driver_collect_requested_entry_source("./test/does_not_exist.spl").len()).to_equal(0)
        expect(_driver_collect_requested_entry_source("README.md").len()).to_equal(0)
