use std.spec.{describe, it, expect}
use compiler.driver.cache.native_build_environment_identity.{
    native_build_environment_snapshot_fingerprint_v1,
    native_build_module_environment_snapshot_fingerprint_v1}

describe "native module delivery-intent projection":
    it "keeps selective object ownership stable across sibling counts and private queues":
        val first = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_MIR_SELECTIVE", "1"),
            ("SIMPLE_MIR_SELECTIVE_OBJECT_CONTEXT", "frozen-provider-context"),
            ("SIMPLE_NATIVE_BUILD_THREADS", "1"),
            ("SIMPLE_MIR_SHARD_EXPORT_DIR", "/private/run-one"),
            ("SIMPLE_MIR_SELECTIVE_WORKER_KIB", "1024")])
        val many = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_MIR_SELECTIVE", "1"),
            ("SIMPLE_MIR_SELECTIVE_OBJECT_CONTEXT", "frozen-provider-context"),
            ("SIMPLE_NATIVE_BUILD_THREADS", "15"),
            ("SIMPLE_MIR_SHARD_EXPORT_DIR", "/private/run-two"),
            ("SIMPLE_MIR_SELECTIVE_WORKER_KIB", "2048")])
        expect(first.valid).to_equal(true)
        expect(many.valid).to_equal(true)
        expect(first.digest).to_equal(many.digest)
        val changed_owner = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_MIR_SELECTIVE", "1"),
            ("SIMPLE_MIR_SELECTIVE_OBJECT_CONTEXT", "different-provider-context"),
            ("SIMPLE_NATIVE_BUILD_THREADS", "15")])
        expect(first.digest == changed_owner.digest).to_equal(false)

    it "preserves the existing serial environment identity for worker settings":
        val one = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_NATIVE_BUILD_THREADS", "1")])
        val many = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_NATIVE_BUILD_THREADS", "15")])
        expect(one.valid).to_equal(true)
        expect(one.digest == many.digest).to_equal(false)

    it "shares executable and entry module facets but keeps final action intent":
        val baseline: [(text, text)] = [("PATH", "/usr/bin"), ("SIMPLE_TYPECHECK_WARN", "0")]
        val entry: [(text, text)] = [("PATH", "/usr/bin"), ("SIMPLE_TYPECHECK_WARN", "0"),
            ("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", "entry")]
        val executable_module = native_build_module_environment_snapshot_fingerprint_v1(baseline)
        val entry_module = native_build_module_environment_snapshot_fingerprint_v1(entry)
        expect(executable_module.valid).to_equal(true)
        expect(entry_module.valid).to_equal(true)
        expect(entry_module.digest).to_equal(executable_module.digest)
        expect(native_build_environment_snapshot_fingerprint_v1(entry).digest ==
            native_build_environment_snapshot_fingerprint_v1(baseline).digest).to_equal(false)

    it "preserves codegen options and tool search changes":
        val baseline: [(text, text)] = [("PATH", "/usr/bin"), ("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", "entry")]
        val original = native_build_module_environment_snapshot_fingerprint_v1(baseline)
        val symbol_change = native_build_module_environment_snapshot_fingerprint_v1(
            [("PATH", "/usr/bin"), ("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", "entry"),
                ("SIMPLE_NATIVE_BUILD_NO_MANGLE", "1")])
        val tool_change = native_build_module_environment_snapshot_fingerprint_v1(
            [("PATH", "/other-tools"), ("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", "entry")])
        expect(symbol_change.digest == original.digest).to_equal(false)
        expect(tool_change.digest == original.digest).to_equal(false)

    it "keeps other output scopes distinct and refuses duplicate intent capture":
        val ordinary = native_build_module_environment_snapshot_fingerprint_v1([])
        for mode in ["1", "archive", "shared"]:
            val other = native_build_module_environment_snapshot_fingerprint_v1(
                [("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", mode)])
            expect(other.valid).to_equal(true)
            expect(other.digest == ordinary.digest).to_equal(false)
        val duplicate = native_build_module_environment_snapshot_fingerprint_v1(
            [("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", ""), ("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", "entry")])
        expect(duplicate.valid).to_equal(false)
        expect(duplicate.reason).to_contain("environment-field-duplicate")

    it "ignores per-run observability sinks and the external RSS ceiling":
        # Stage 3 relaunches differ only in these (pid-stamped paths, run id,
        # watchdog ceiling); none is read by a compiler decision, so they must
        # not give every relaunch a private object-cache scope.
        val run_a: [(text, text)] = [("PATH", "/usr/bin"),
            ("SIMPLE_COMPILER_PHASE_PROFILE", "1"),
            ("SIMPLE_COMPILER_PHASE_PROFILE_FILE", "/out/phase-profile.101.events"),
            ("SIMPLE_MEM_SNAPSHOT_FILE", "/out/memory-snapshot-v1.101.events"),
            ("SIMPLE_EVIDENCE_RUN_ID", "stage3-101"),
            ("SIMPLE_BUILD_PROGRESS_EVENTS", "/out/a.events"),
            ("SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB", "52428800")]
        val run_b: [(text, text)] = [("PATH", "/usr/bin"),
            ("SIMPLE_COMPILER_PHASE_PROFILE_FILE", "/out/phase-profile.202.events"),
            ("SIMPLE_MEM_SNAPSHOT_FILE", "/out/memory-snapshot-v1.202.events"),
            ("SIMPLE_EVIDENCE_RUN_ID", "stage3-202"),
            ("SIMPLE_BUILD_PROGRESS_EVENTS", "/out/b.events"),
            ("SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB", "77594624")]
        val bare: [(text, text)] = [("PATH", "/usr/bin")]
        val a = native_build_module_environment_snapshot_fingerprint_v1(run_a)
        val b = native_build_module_environment_snapshot_fingerprint_v1(run_b)
        val plain = native_build_module_environment_snapshot_fingerprint_v1(bare)
        expect(a.valid).to_equal(true)
        expect(a.digest).to_equal(b.digest)
        expect(a.digest).to_equal(plain.digest)
        # The complete capture (admission/no-op evidence) still records them.
        expect(native_build_environment_snapshot_fingerprint_v1(run_a).digest ==
            native_build_environment_snapshot_fingerprint_v1(run_b).digest).to_equal(false)
        # A semantic switch still moves the module scope; the shard tree
        # budget and the frontend worker-KB budgets only size worker pools
        # (excluded by native_build_environment_identity.spl like the
        # SIMPLE_MIR_SHARD_* family).
        val semantic = native_build_module_environment_snapshot_fingerprint_v1(
            [("PATH", "/usr/bin"), ("SIMPLE_EVIDENCE_RUN_ID", "stage3-101"),
                ("SIMPLE_NATIVE_ARENA_DECLS", "1")])
        val budget = native_build_module_environment_snapshot_fingerprint_v1(
            [("PATH", "/usr/bin"), ("SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB", "46137344"),
                ("SIMPLE_PARSE_SHARD_WORKER_KB", "3800000"),
                ("SIMPLE_HIR_SHARD_WORKER_KB", "9000000"),
                ("SIMPLE_SHARD_MEM_CLAMP", "1"),
                ("SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB", "62914560"),
                ("SIMPLE_PROCESS_TREE_RSS_SCOPE_GROUP", "row-compiler_cli_build-101"),
                ("SIMPLE_PROCESS_TREE_RSS_RECEIPT", "build/rss/receipt-101.sdn"),
                ("SIMPLE_BOOTSTRAP_RSS_CAP_MODE", "enforce"),
                ("SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS", "250"),
                ("SIMPLE_BUILD_MEMORY_RESERVE_BYTES", "1073741824"),
                ("SIMPLE_HOST_CONFIG", "/home/me/.config/simple/host.sdn")])
        val budget_retuned = native_build_module_environment_snapshot_fingerprint_v1(
            [("PATH", "/usr/bin"), ("SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB", "11534336"),
                ("SIMPLE_PARSE_SHARD_WORKER_KB", "2500000"),
                ("SIMPLE_HIR_SHARD_WORKER_KB", "7000000"),
                ("SIMPLE_SHARD_MEM_CLAMP", "0"),
                ("SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB", "11534336"),
                ("SIMPLE_PROCESS_TREE_RSS_SCOPE_GROUP", "row-compiler_cli_build-202"),
                ("SIMPLE_PROCESS_TREE_RSS_RECEIPT", "build/rss/receipt-202.sdn"),
                ("SIMPLE_BOOTSTRAP_RSS_CAP_MODE", "off"),
                ("SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS", "500"),
                ("SIMPLE_BUILD_MEMORY_RESERVE_BYTES", "12884901888"),
                ("SIMPLE_HOST_CONFIG", "/alt/host.sdn")])
        expect(semantic.digest == plain.digest).to_equal(false)
        expect(budget.digest).to_equal(plain.digest)
        expect(budget.digest).to_equal(budget_retuned.digest)

    it "ignores pid-valued SIMPLE_ICE_DIR and warm-closure candidate paths":
        # UNEXECUTED: authored without a runnable producer (cannot rebuild).
        val run_a: [(text, text)] = [("PATH", "/usr/bin"),
            ("SIMPLE_ICE_DIR", "build/ice/1111_abc"),
            ("SIMPLE_NATIVE_BUILD_WARM_CLOSURE_CANDIDATE", "root/candidate-1111.receipt")]
        val run_b: [(text, text)] = [("PATH", "/usr/bin"),
            ("SIMPLE_ICE_DIR", "build/ice/2222_abc"),
            ("SIMPLE_NATIVE_BUILD_WARM_CLOSURE_CANDIDATE", "root/candidate-2222.receipt")]
        val bare: [(text, text)] = [("PATH", "/usr/bin")]
        val a = native_build_module_environment_snapshot_fingerprint_v1(run_a)
        val b = native_build_module_environment_snapshot_fingerprint_v1(run_b)
        expect(a.valid).to_equal(true)
        expect(a.digest).to_equal(b.digest)
        expect(a.digest).to_equal(native_build_module_environment_snapshot_fingerprint_v1(bare).digest)

    it "ignores the go-to-end knob so a plain run reuses a go-to-end run's objects":
        # UNEXECUTED: authored without a runnable producer (cannot rebuild).
        val go_to_end: [(text, text)] = [("PATH", "/usr/bin"),
            ("SIMPLE_NATIVE_GO_TO_END", "1"),
            ("SIMPLE_NATIVE_STAGED_CODEGEN_BATCH", "32")]
        val plain: [(text, text)] = [("PATH", "/usr/bin")]
        val staged = native_build_module_environment_snapshot_fingerprint_v1(go_to_end)
        expect(staged.valid).to_equal(true)
        expect(staged.digest).to_equal(native_build_module_environment_snapshot_fingerprint_v1(plain).digest)
        # Still a semantic field: the bootstrap marker keeps changing the scope.
        val bootstrap: [(text, text)] = [("PATH", "/usr/bin"), ("SIMPLE_BOOTSTRAP", "1")]
        expect(native_build_module_environment_snapshot_fingerprint_v1(bootstrap).digest == staged.digest).to_equal(false)

    it "gives a relaunched MIR shard worker the same object scope as the killed launch":
        # Replay of the MIR shard worker environment of two Stage 3 launches
        # (bootstrap-fable-35, 2026-11-15): same compiler, same SCV snapshot,
        # same --cache-dir; the coordinator pid/clock, the watchdog session and
        # the per-worker dataset cap differ. All 1549 objects of launch 1 sat
        # in one scope and launch 2 got a fresh one (cached=0).
        val launch_1 = objreuse_mir_worker_env_v1("1473763", "4806744499",
            "1473763", "BZ7QDHQu", "18432000000")
        val launch_2 = objreuse_mir_worker_env_v1("2134674", "4818894709",
            "2134674", "HDHJR4V3", "42119075840")
        val first = native_build_module_environment_snapshot_fingerprint_v1(launch_1)
        val second = native_build_module_environment_snapshot_fingerprint_v1(launch_2)
        expect(first.valid).to_equal(true)
        expect(second.valid).to_equal(true)
        expect(first.digest).to_equal(second.digest)
        # One key at a time, so each exclusion is pinned on its own.
        val per_key: [(text, text)] = [
            ("SIMPLE_PARSE_CLOSURE_REQUEST", "/c/frontend/closure-request-9-9/request.v1"),
            ("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", "ffff"),
            ("SIMPLE_BOOTSTRAP_SESSION_ID", "9"),
            ("SIMPLE_BOOTSTRAP_SESSION_EXEC", "/l/simple-rss-session-ZZZZZZZZ/bootstrap-session-exec"),
            ("SIMPLE_GLOBAL_DATASET_MAX_BYTES", "1")]
        for pair in per_key:
            val moved = native_build_module_environment_snapshot_fingerprint_v1(
                objreuse_env_replace_v1(launch_1, pair.0, pair.1))
            expect(moved.digest).to_equal(first.digest)
        # Retained inputs still move the scope: the source snapshot, a
        # codegen switch, the compiler under test and the ABI receipt.
        val retained: [(text, text)] = [
            ("SIMPLE_SCV_TREE_ID", "scv-tree-v1-other"),
            ("SIMPLE_SCV_REVISION_ID", "scv-revision-v2-other"),
            ("SIMPLE_NATIVE_ARENA_DECLS", "0"),
            ("SIMPLE_BINARY", "/other/simple"),
            ("SIMPLE_ABI_ADMISSION_RECEIPT", "/other/admission.env")]
        for pair in retained:
            val moved = native_build_module_environment_snapshot_fingerprint_v1(
                objreuse_env_replace_v1(launch_1, pair.0, pair.1))
            expect(moved.digest == first.digest).to_equal(false)
        # The complete capture (admission/no-op evidence) still records them.
        expect(native_build_environment_snapshot_fingerprint_v1(launch_1).digest ==
            native_build_environment_snapshot_fingerprint_v1(launch_2).digest).to_equal(false)

    it "keeps the object scope when a relaunch changes only a Stage 3 route knob":
        # The bootstrap exports both route knobs into every MIR shard worker.
        # REQUESTED_ROUTE is read only by bootstrap_main's dispatch (shard
        # workers carry SIMPLE_NATIVE_BUILD_WORKER=1) and FALLBACK_ROUTE by no
        # compiler source; a relaunch that retunes either must keep its scope.
        var routed = objreuse_mir_worker_env_v1("1473763", "4806744499",
            "1473763", "BZ7QDHQu", "18432000000")
        routed.push(("SIMPLE_BOOTSTRAP_STAGE3_REQUESTED_ROUTE", "coordinator"))
        routed.push(("SIMPLE_BOOTSTRAP_STAGE3_FALLBACK_ROUTE", "direct"))
        val first = native_build_module_environment_snapshot_fingerprint_v1(routed)
        expect(first.valid).to_equal(true)
        val requested = native_build_module_environment_snapshot_fingerprint_v1(
            objreuse_env_replace_v1(routed, "SIMPLE_BOOTSTRAP_STAGE3_REQUESTED_ROUTE", "direct"))
        val fallback = native_build_module_environment_snapshot_fingerprint_v1(
            objreuse_env_replace_v1(routed, "SIMPLE_BOOTSTRAP_STAGE3_FALLBACK_ROUTE", "none"))
        expect(requested.digest).to_equal(first.digest)
        expect(fallback.digest).to_equal(first.digest)
        # The watchdog's cap provenance labels follow the memory admission
        # (stage3-native-build-worker.sh); no compiler source reads them.
        var capped = routed
        capped.push(("SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_SOURCE", "memory-admission"))
        capped.push(("SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_BOUND", "memory-high"))
        val relabelled = objreuse_env_replace_v1(objreuse_env_replace_v1(capped,
            "SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_SOURCE", "explicit"),
            "SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_BOUND", "memory-max")
        expect(native_build_module_environment_snapshot_fingerprint_v1(capped).digest).to_equal(first.digest)
        expect(native_build_module_environment_snapshot_fingerprint_v1(relabelled).digest).to_equal(first.digest)

    it "keeps file-worker unit object scope stable across batches and relaunches":
        val first = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_ABI_POLICY", "v1"),
            ("SIMPLE_FILE_WORKER_UNIT", "1"),
            ("SIMPLE_HIR_SHARD", "0/4"),
            ("SIMPLE_HIR_SHARD_QUEUE", "/b/hir/hir-queue-111-0"),
            ("SIMPLE_HIR_SHARD_OWNER", "w0~h1"),
            ("SIMPLE_HIR_SHARD_CLAIM_LIMIT", "8"),
            ("SIMPLE_UNIT_TLDR_ROOT", "/b/hir/hir-queue-111-0/frontend"),
            ("SIMPLE_FILE_WORKER_QUEUE", "/b/hir/mir-queue-111-0"),
            ("SIMPLE_FILE_WORKER_OWNER", "w0"),
            ("SIMPLE_FILE_WORKER_HIR_QUEUE", "/b/hir/hir-queue-111-0"),
            ("SIMPLE_FILE_WORKER_BATCH", "8"),
            ("SIMPLE_FILE_WORKER_REUSE", "/b/hir/reuse-111.plan")])
        val relaunch = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_ABI_POLICY", "v1"),
            ("SIMPLE_FILE_WORKER_UNIT", "1"),
            ("SIMPLE_HIR_SHARD", "2/6"),
            ("SIMPLE_HIR_SHARD_QUEUE", "/b/hir/hir-queue-222-3"),
            ("SIMPLE_HIR_SHARD_OWNER", "w2~h7"),
            ("SIMPLE_HIR_SHARD_CLAIM_LIMIT", "3"),
            ("SIMPLE_UNIT_TLDR_ROOT", "/b/hir/hir-queue-222-3/frontend"),
            ("SIMPLE_FILE_WORKER_QUEUE", "/b/hir/mir-queue-222-3"),
            ("SIMPLE_FILE_WORKER_OWNER", "w2"),
            ("SIMPLE_FILE_WORKER_HIR_QUEUE", "/b/hir/hir-queue-222-3"),
            ("SIMPLE_FILE_WORKER_BATCH", "3"),
            ("SIMPLE_FILE_WORKER_REUSE", "/b/hir/reuse-222.plan")])
        expect(first.valid).to_equal(true)
        expect(relaunch.valid).to_equal(true)
        expect(first.digest).to_equal(relaunch.digest)
        val changed_option = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_ABI_POLICY", "v2"),
            ("SIMPLE_FILE_WORKER_UNIT", "1"),
            ("SIMPLE_HIR_SHARD", "0/4"),
            ("SIMPLE_HIR_SHARD_QUEUE", "/b/hir/hir-queue-111-0"),
            ("SIMPLE_HIR_SHARD_OWNER", "w0~h1")])
        expect(changed_option.valid).to_equal(true)
        expect(first.digest == changed_option.digest).to_equal(false)
        val other_snapshot = native_build_module_environment_snapshot_fingerprint_v1([
            ("SIMPLE_ABI_POLICY", "v1"),
            ("SIMPLE_FILE_WORKER_UNIT", "1"),
            ("SIMPLE_SCV_TREE_ID", "scv-tree-v1-different")])
        expect(first.digest == other_snapshot.digest).to_equal(false)

fn objreuse_env_replace_v1(env: [(text, text)], name: text, value: text) -> [(text, text)]:
    var out: [(text, text)] = []
    for pair in env:
        if pair.0 == name:
            out.push((name, value))
        else:
            out.push(pair)
    out

fn objreuse_mir_worker_env_v1(coordinator_pid: text, clock_ms: text, session_id: text,
        session_dir: text, dataset_bytes: text) -> [(text, text)]:
    val s3 = "/b/stage3/aarch64-unknown-linux-gnu"
    val request = "{s3}/stage3-native-cache/default/frontend/closure-request-{coordinator_pid}-{clock_ms}/request.v1"
    [("PATH", "/usr/bin"), ("PWD", "/b"), ("TMPDIR", "{s3}/stage3-tmp"),
        ("SIMPLE_ABI_ADMISSION_RECEIPT", "{s3}/stage2-admitted/admission.env"),
        ("SIMPLE_ABI_POLICY", "v1"),
        ("SIMPLE_BINARY", "{s3}/stage2-admitted/simple"),
        ("SIMPLE_BOOTSTRAP", ""),
        ("SIMPLE_BOOTSTRAP_SESSION_EXEC", "/b/logs/simple-rss-session-{session_dir}/bootstrap-session-exec"),
        ("SIMPLE_BOOTSTRAP_SESSION_ID", session_id),
        ("SIMPLE_BOOTSTRAP_RSS_CAP_MODE", "enforce"),
        ("SIMPLE_COMPILER_PHASE_PROFILE_FILE", "{s3}/phase-profile.{coordinator_pid}.events"),
        ("SIMPLE_EVIDENCE_RUN_ID", "stage3-{coordinator_pid}"),
        ("SIMPLE_FRONTEND_CACHE_DIR", "{s3}/stage3-native-cache/default/frontend"),
        ("SIMPLE_GLOBAL_DATASET_MAX_BYTES", dataset_bytes),
        ("SIMPLE_ICE_DIR", "build/ice/{coordinator_pid}_n1"),
        ("SIMPLE_MIR_SHARD_COUNT", "9"),
        ("SIMPLE_MIR_SHARD_OWNER", "0/9@0"),
        ("SIMPLE_MIR_SHARD_QUEUE", "{s3}/stage3-native-cache/hir/mir-queue-{coordinator_pid}-0"),
        ("SIMPLE_NATIVE_ARENA_DECLS", "1"),
        ("SIMPLE_NATIVE_BUILD_WORKER", "1"),
        ("SIMPLE_PARSE_CLOSURE_CONSUMER", "1"),
        ("SIMPLE_PARSE_CLOSURE_REQUEST", request),
        ("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", "digest-of-{request}"),
        ("SIMPLE_PARSE_CLOSURE_SELECTED_COUNT", "1670"),
        ("SIMPLE_SCV_REVISION_ID", "scv-revision-v2-0b1eb429"),
        ("SIMPLE_SCV_SNAPSHOT_ROOT", "/b/build/scv/snapshots/scv-revision-v2-0b1eb429"),
        ("SIMPLE_SCV_TREE_ID", "scv-tree-v1-27082117")]
