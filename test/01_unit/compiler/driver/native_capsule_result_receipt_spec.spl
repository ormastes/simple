use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use std.io.{file_write, file_delete}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.mir.mir_data.{MirModule}
use compiler.driver.driver_build.incremental.{BuildCache, FileFingerprint}
use compiler.driver.driver_aot_native_output.{
    driver_native_capsule_result_valid_v1,
    driver_native_capsule_result_reason_v1,
    driver_native_collect_capsule_result_v1,
    driver_native_capsule_inputs_valid_v1,
    driver_native_capsule_receipt_size_reason_v1
}

fn receipt_ctx() -> CompileContext:
    CompileContext.create(driver_core_compile_options_default())

fn receipt_fixture():
    val ctx = CompileContext.create(driver_core_compile_options_default())
    ctx.mir_modules["receipt"] = MirModule(name: "receipt", functions: {},
        statics: {}, constants: {}, types: {})
    _ = ctx.freeze_storage_registry()
    ctx.freeze_native_module_capsules_v1(["receipt"],
        "/tmp/simple-native-capsule-receipt", "native", "x86_64",
        "frozen-cpu", 2, false)

describe "native capsule result receipt":
    it "binds object bytes size path identity and frozen inputs":
        val batch = receipt_fixture()
        assert_true(batch.ok)
        if batch.ok:
            val capsule = batch.find("receipt")
            assert_true(capsule.ok)
            if capsule.ok:
                assert_true(driver_native_capsule_inputs_valid_v1(capsule,
                    "native", "x86_64", false, 2))
                capsule.target_cpu = "mutated-cpu"
                assert_false(driver_native_capsule_inputs_valid_v1(capsule,
                    "native", "x86_64", false, 2))

                val fresh = receipt_fixture().find("receipt")
                _ = file_write(fresh.object_path, "object-v1")
                val fingerprint = FileFingerprint.from_file(fresh.object_path)
                assert_true(fingerprint.?)
                if val fp = fingerprint:
                    val receipt = "native-capsule-result-v1\n{fresh.capsule_identity}\n{fresh.object_path}\n{fp.size}\n{fp.content_hash}\n"
                    _ = file_write(fresh.object_path + ".capsule-receipt", receipt)
                    assert_true(driver_native_capsule_result_valid_v1(fresh))
                    val cache = BuildCache.empty("/tmp/simple-native-capsule-cache.sdn")
                    assert_equal(driver_native_collect_capsule_result_v1(
                        receipt_ctx(), receipt_fixture(), cache, "receipt", fresh.object_path), "")
                    _ = file_write(fresh.object_path, "object-v2-tampered")
                    assert_false(driver_native_capsule_result_valid_v1(fresh))
                    assert_true(driver_native_collect_capsule_result_v1(
                        receipt_ctx(), receipt_fixture(), cache, "receipt", fresh.object_path) != "")
                _ = file_delete(fresh.object_path + ".capsule-receipt")
                assert_false(driver_native_capsule_result_valid_v1(fresh))
                _ = file_delete(fresh.object_path)

    it "rejects malformed receipt identity path and trailing bytes":
        val batch = receipt_fixture()
        if batch.ok:
            val capsule = batch.find("receipt")
            if capsule.ok:
                _ = file_write(capsule.object_path, "object-v1")
                for bad in [
                    "native-capsule-result-v1\nwrong\n{capsule.object_path}\n",
                    "native-capsule-result-v1\n{capsule.capsule_identity}\nwrong-path\n",
                    "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n0\nwrong\ntrailing"
                ]:
                    _ = file_write(capsule.object_path + ".capsule-receipt", bad)
                    assert_false(driver_native_capsule_result_valid_v1(capsule))
                _ = file_delete(capsule.object_path + ".capsule-receipt")
                _ = file_delete(capsule.object_path)

    it "names the first differing receipt line when the byte counts match":
        # Regression pin for the 2026-09-12 Stage-2 blocker: a wrong `size`
        # field that happens to render the SAME number of characters made the
        # verdict read `expected-bytes=N:actual-bytes=N`, which localises
        # nothing. The reason string must name WHICH line diverged. This only
        # adds diagnosis -- the comparison itself is still full-text equality,
        # so a receipt that differs anywhere is still rejected.
        val batch = receipt_fixture()
        if batch.ok:
            val capsule = batch.find("receipt")
            if capsule.ok:
                _ = file_write(capsule.object_path, "object-v1")
                val fingerprint = FileFingerprint.from_file(capsule.object_path)
                if val fp = fingerprint:
                    # Same character count as the true size (9 -> 8), so the
                    # two receipts are byte-for-byte the same LENGTH.
                    val skewed = "native-capsule-result-v1\n{capsule.capsule_identity}\n{capsule.object_path}\n8\n{fp.content_hash}\n"
                    _ = file_write(capsule.object_path + ".capsule-receipt", skewed)
                    val reason = driver_native_capsule_result_reason_v1(capsule)
                    assert_true(reason.contains("receipt-content-mismatch"))
                    assert_true(reason.contains("expected-bytes=") and
                        reason.contains("actual-bytes="))
                    assert_true(reason.contains("first-diff-line=4"))
                _ = file_delete(capsule.object_path + ".capsule-receipt")
                _ = file_delete(capsule.object_path)

describe "native capsule receipt size plausibility":
    # Fail-closed gate on receipt line 4. Both receipt sites take the size from
    # `rt_file_size`; the `FileFingerprint.size` field read is passed in only as
    # a canary, because reading that `i64` field off an optional-bound struct is
    # miscompiled under Stage-2 native codegen and yields a tagged heap pointer.
    # A run in which the two disagree must FAIL at the site that noticed it,
    # never write a pointer into a receipt and surface far away as an opaque
    # `receipt-content-mismatch`.
    it "admits a size the runtime and the struct field agree on":
        assert_equal(driver_native_capsule_receipt_size_reason_v1(632, 632), "")
        assert_equal(driver_native_capsule_receipt_size_reason_v1(0, 0), "")

    it "rejects the heap pointer the Stage-2 blocker actually recorded":
        # 37196932097 is the verbatim line-4 value from the 2026-09-13 run-8
        # receipt, written for a 632-byte object.
        val reason = driver_native_capsule_receipt_size_reason_v1(37196932097, 632)
        assert_true(reason.contains("receipt-size-implausible"))
        assert_true(reason.contains("field=37196932097"))
        assert_true(reason.contains("runtime=632"))

    it "rejects a runtime size that is itself a pointer":
        # 2^40 is the bound: at or above it the value cannot be a byte count.
        assert_true(driver_native_capsule_receipt_size_reason_v1(
            1099511627776, 1099511627776).contains("receipt-size-implausible"))
        assert_equal(driver_native_capsule_receipt_size_reason_v1(
            1099511627775, 1099511627775), "")

    it "rejects the stat sentinel instead of recording it as a size":
        # `FileFingerprint.from_file` passes -1 through unchecked.
        assert_true(driver_native_capsule_receipt_size_reason_v1(-1, -1)
            .contains("receipt-size-unreadable"))
