use std.spec.*
use compiler.driver.hydration_manifest.{HydrationManifest, EventOptions}

describe "HydrationManifest event options serialization":
    it "renders once/passive/capture as false when explicitly set to false":
        var m = HydrationManifest.create()
        m.add_binding_with_options("#btn", "click", "onClick",
            EventOptions(once: Some(false), passive: Some(false), capture: Some(false)))

        val sdn = m.to_sdn()
        # The bindings row must record "false, false, false" for an explicit
        # Some(false) option — presence of Some(...) is not the same as the
        # wrapped boolean being true.
        expect(sdn).to_contain("onClick, false, false, false")

    it "renders once/passive/capture as true only when the wrapped value is true":
        var m = HydrationManifest.create()
        m.add_binding_with_options("#btn2", "click", "onClick2",
            EventOptions(once: Some(true), passive: nil, capture: nil))

        val sdn = m.to_sdn()
        expect(sdn).to_contain("onClick2, true, false, false")
