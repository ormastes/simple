# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# bug: doc/08_tracking/bug/per_file_lane_unit_mir_physical_ownership_missing_hir_2026-11-12.md (layer 3)
#
# A per-file unit child continues past its HIR shard step and loads (from the
# cache) or lowers every row of its load closure for its own MIR. Rows it did
# not claim belong to another unit, and its own claimed rows already received
# their terminal from the shard transaction. Publishing a terminal again from
# that fall-through is refused by hir_shard_recovery_terminal (non-owner, or a
# different cache flag), which killed every importing unit with "HIR
# completion receipt publication failed".
use std.spec
use compiler.driver.driver_hir_cache.{hir_shard_row_terminal_due_v1}

describe "HIR shard row terminal after the shard step":
    it "is due on the ordinary (non-shard) build, where finishing is a no-op":
        expect(hir_shard_row_terminal_due_v1(false, false)).to_equal(true)
        expect(hir_shard_row_terminal_due_v1(false, true)).to_equal(true)

    it "keeps the historical publication for a non-unit shard child":
        expect(hir_shard_row_terminal_due_v1(true, false)).to_equal(true)

    it "is never due for a per-file unit child's fall-through rows":
        expect(hir_shard_row_terminal_due_v1(true, true)).to_equal(false)
