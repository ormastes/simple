use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "driver public runtime facade contract":
    it "routes public compile subprocesses through the canonical process facade":
        val files = [
            "src/compiler/80.driver/driver_public_compile_backends.spl",
            "src/compiler/80.driver/driver_api_project_build.spl",
            "src/compiler/80.driver/driver_public_headers.spl",
            "src/compiler/80.driver/driver_public_interpret_bridge.spl",
            "src/compiler/80.driver/driver_public_shared.spl"
        ]
        for path in files:
            val source = file_read(path)
            expect(source).to_contain("process_run(")
            expect(source.contains("extern fn rt_process_run")).to_equal(false)
            expect(source.contains("fn _header_process_run_raw")).to_equal(false)

    it "preserves nullable lookup and mutation status at the shared boundary":
        val source = file_read("src/compiler/80.driver/driver_public_shared.spl")
        expect(source).to_contain("use std.io_runtime.{env_get_nullable, env_set, process_run}")
        expect(source).to_contain("env_get_nullable(\"SIMPLE_BINARY\") ?? \"\"")
        expect(source).to_contain("env_get_nullable(\"SIMPLE_COMPILE_DELEGATED\") ?? \"\"")
        expect(source).to_contain("env_set(\"SIMPLE_COMPILE_DELEGATED\", \"1\")")
        expect(source.contains("extern fn rt_env_get")).to_equal(false)
        expect(source.contains("extern fn rt_env_set")).to_equal(false)
