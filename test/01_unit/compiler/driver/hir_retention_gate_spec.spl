"""
# HIR Retention Gate Unit Spec

Prevents corrupt HIR module dictionaries from reaching retained phase state.
"""

use compiler.driver.driver_hir_pipeline_lowering.{driver_hir_retention_error}

describe "driver HIR retention gate":
    it "rejects the negative function length observed after future lowering errors":
        val error = driver_hir_retention_error(-1)
        expect(error != nil).to_equal(true)
        expect(error.unwrap()).to_contain("length: -1")

    it "accepts an empty valid function dictionary":
        expect(driver_hir_retention_error(0) == nil).to_equal(true)

    it "accepts a populated valid function dictionary":
        expect(driver_hir_retention_error(4) == nil).to_equal(true)
