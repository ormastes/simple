use std.spec.*
use compiler.driver.aot_output_aggregation.{
    aot_join_text_fragments, aot_join_wat_fragments
}

describe "AOT backend output aggregation":
    it "preserves C CUDA and OpenCL fragment bytes and ordering":
        expect(aot_join_text_fragments([])).to_equal("")
        expect(aot_join_text_fragments(["first", "", "second\n"])).to_equal(
            "firstsecond\n")

    it "preserves historical WAT empty-module separator behavior":
        expect(aot_join_wat_fragments([])).to_equal("")
        expect(aot_join_wat_fragments(["", "(module $a)", "", "(module $b)", ""])).to_equal(
            "(module $a)\n\n(module $b)")
        expect(aot_join_wat_fragments(["(module)", ""])).to_equal("(module)")
