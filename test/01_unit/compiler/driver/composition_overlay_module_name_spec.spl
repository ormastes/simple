use std.spec.*
use compiler.driver.driver_source_loading.{driver_composition_overlay_module_name_v1}

# Winner-selection decision for composition overlays: the overlay file that
# the ordered --source roots selected is lowered under the spelling of the
# module it replaces, so the per-module HIR importer key matches the
# collector's winner. doc/07_guide/tooling/bootstrap_options.md.
describe "composition overlay module name":
    it "maps an overlay file onto the module it stands in for":
        # @req REQ-SSPEC-COMPILER
        step("overlay file maps onto the shadowed module spelling")
        expect(driver_composition_overlay_module_name_v1(
            "compositions.cuda_static.plugins.backend_registry.selected_cuda_backend"
        )).to_equal("plugins.backend_registry.selected_cuda_backend")
        expect(driver_composition_overlay_module_name_v1(
            "compositions.kernel_llvm_cranelift.compiler.driver.bootstrap_k1_selected"
        )).to_equal("compiler.driver.bootstrap_k1_selected")

    it "leaves non-overlay and bare overlay package spellings alone":
        # @req REQ-SSPEC-COMPILER
        step("non-overlay spellings are not renamed")
        expect(driver_composition_overlay_module_name_v1(
            "plugins.backend_registry.selected_cuda_backend")).to_equal("")
        expect(driver_composition_overlay_module_name_v1("compositions")).to_equal("")
        expect(driver_composition_overlay_module_name_v1("compositions.cuda_static")).to_equal("")
        expect(driver_composition_overlay_module_name_v1("compositions.cuda_static.__init__")).to_equal("")
        expect(driver_composition_overlay_module_name_v1(
            "lib.compositions.cuda_static.plugins.x")).to_equal("")
