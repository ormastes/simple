# Purpose: cross-module macro resolution from imported modules' TLDR macro
# sections (macro-def + macro-key); missing/stale companions keep negative
# lookups conservative (plan 2026-10-24 §6.2).
# @req M-02

use std.spec.*
use std.io_runtime.{file_write, file_exists}
use std.nogc_sync_mut.io_runtime.{dir_create_all}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.cache_contract.macro_reference_manifest_v1.{macro_use_status_tag_v1,
    macro_use_cacheable_v1}
use compiler.frontend.cache_artifact.macro_source_from_parse_v1.{macro_module_source_from_parse_v1}
use compiler.frontend.cache_artifact.macro_reference_projector.{project_macro_module_v1}
use compiler.driver.cache.module_artifacts_v1.{module_artifacts_emit_v1,
    module_tldr_imported_macro_projections_v1, macro_projection_mark_imports_incomplete_v1}
use compiler.driver.cache.generic_spec_rr_producer_v1.{
    macro_reference_sealed_manifests_for_module_v1}
use compiler.driver.cache.reverse_reference_projection_v2.{
    reverse_reference_project_generation_v2}
use compiler.driver.cache.reverse_reference_receipt.{
    ReverseReferenceReceiptReadV1, reverse_reference_consumers_v1,
    reverse_reference_receipt_decode_v1, reverse_reference_receipt_encode_v1}
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{
    semantic_query_key_canonical_v1}

val DIR = "build/test_tmp/macro_imports_v1"
val ROOT = "build/test_tmp/macro_imports_v1/tldr"
val A_SRC = "macro double(x: Int) -> (returns result: Int):\n    emit result:\n        x + x\n"
val B_SRC = "fn user() -> i64:\n    double!(21) + triple!(1)\n"
val LOCAL_SRC = "macro double(x: Int) -> (returns result: Int):\n    emit result:\n        x + x\n\nfn user() -> i64:\n    double!(21)\n"

fn project_b(imports: [text]) -> (text, text, bool):
    val _m = parse_full_frontend(B_SRC, DIR + "/b.spl", "b", Logger(level: 0))
    val src = macro_module_source_from_parse_v1("", "b", DIR + "/b.spl")
    val (imported, complete) = module_tldr_imported_macro_projections_v1(imports, ROOT)
    var p = project_macro_module_v1(src, imported)
    if not complete: p = macro_projection_mark_imports_incomplete_v1(p)
    (macro_use_status_tag_v1(p.use_table.uses[0].status),
        macro_use_status_tag_v1(p.use_table.uses[1].status) + "/" + p.use_table.uses[1].coverage,
        complete)

describe "imported macro resolution":
    it "resolves a macro defined in an imported module's fresh companion":
        expect(dir_create_all(DIR)).to_equal(true)
        expect(file_write(DIR + "/a.spl", A_SRC)).to_equal(true)
        expect(module_artifacts_emit_v1(DIR + "/a.spl", ROOT)).to_equal("")
        val (double_status, triple_status, complete) = project_b([DIR + "/a.spl"])
        expect(complete).to_equal(true)
        expect(double_status).to_equal("resolved")
        expect(triple_status).to_equal("unresolved/complete")

    it "a stale import companion keeps negative lookups conservative":
        expect(file_write(DIR + "/a.spl", A_SRC + "\n# edited\n")).to_equal(true)
        val (double_status, triple_status, complete) = project_b([DIR + "/a.spl"])
        expect(complete).to_equal(false)
        expect(double_status).to_equal("unresolved")
        expect(triple_status).to_equal("unresolved/conservative")

    it "a missing import companion is incomplete, not empty":
        val (_d, _t, complete) = project_b([DIR + "/nope.spl"])
        expect(complete).to_equal(false)

    it "projects the source-fresh parser-produced macro-use table as forward RR reads":
        expect(dir_create_all(DIR)).to_equal(true)
        expect(file_write(DIR + "/local.spl", LOCAL_SRC)).to_equal(true)
        expect(module_artifacts_emit_v1(DIR + "/local.spl", ROOT)).to_equal("")
        val manifests = macro_reference_sealed_manifests_for_module_v1(
            DIR + "/local.spl", ROOT)
        expect(manifests.len()).to_be_greater_than(1)
        var definition_subject = ""
        var definition_consumer = ""
        for entry in manifests:
            expect(entry.sealed).to_equal(true)
            if val forward = entry.manifest:
                for read in forward.ordered_reads:
                    if read.producer.kind == "macro.def":
                        definition_subject = semantic_query_key_canonical_v1(read.producer)
                        definition_consumer = semantic_query_key_canonical_v1(read.consumer)
        expect(definition_subject != "").to_equal(true)
        expect(definition_consumer != "").to_equal(true)
        val built = reverse_reference_project_generation_v2("g1", "r1", manifests,
            ReverseReferenceReceiptReadV1(false, "missing-generation", nil))
        expect(built.ok).to_equal(true)
        val read = reverse_reference_receipt_decode_v1(
            reverse_reference_receipt_encode_v1(built.receipt!))
        val users = reverse_reference_consumers_v1(read, definition_subject,
            "macro-definition-consumer")
        expect(users.exact).to_equal(true)
        expect(users.consumers).to_equal([definition_consumer])
