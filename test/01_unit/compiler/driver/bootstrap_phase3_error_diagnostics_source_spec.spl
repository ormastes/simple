use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "bootstrap phase 3 error diagnostics source contract":
    it "reports bounded error count, length, and text":
        val source = rt_file_read_text(
            "src/compiler/80.driver/driver_orchestration.spl") ?? ""
        val hir_source = rt_file_read_text(
            "src/compiler/80.driver/driver_hir_pipeline_lowering.spl") ?? ""

        # 2026-08-23: the preview is no longer gated on SIMPLE_BOOTSTRAP_DEBUG
        # and no longer uses the [bootstrap-phase3-error*] prefixes -- it is an
        # unconditional log_error preview, because the gated form printed
        # NOTHING on the real 140-module failure. See
        # doc/08_tracking/bug/step3_silent_rc255_no_phase_receipt_2026-08-23.md
        expect(source).to_contain("phase 3 FAILED (")
        expect(source).to_contain("phase3_error_index < 20")
        expect(source).to_contain("error[E-DRV-PHASE3-000]")
        expect(source).to_contain("val phase3_error = self.ctx.error_message_at(phase3_error_index)")
        expect(hir_source).to_contain("[bootstrap-hir-module-errors] source_idx=")
        expect(hir_source).to_contain("[bootstrap-hir-module-error] source_idx=")
        expect(hir_source).to_contain("source_idx < 20 and module_error_idx < 20")
