use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "bootstrap phase 3 error diagnostics source contract":
    it "reports bounded error count, length, and text":
        val source = rt_file_read_text(
            "src/compiler/80.driver/driver_orchestration.spl") ?? ""
        val hir_source = rt_file_read_text(
            "src/compiler/80.driver/driver_hir_pipeline_lowering.spl") ?? ""

        expect(source).to_contain("[bootstrap-phase3-errors] count=")
        expect(source).to_contain("phase3_error_index < 20")
        expect(source).to_contain("[bootstrap-phase3-error] index=")
        expect(source).to_contain("len={phase3_error.len()} text={phase3_error}")
        expect(hir_source).to_contain("[bootstrap-hir-module-errors] source_idx=")
        expect(hir_source).to_contain("[bootstrap-hir-module-error] source_idx=")
        expect(hir_source).to_contain("source_idx < 20 and module_error_idx < 20")
