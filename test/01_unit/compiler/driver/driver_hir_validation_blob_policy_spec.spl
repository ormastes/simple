use std.spec.*
use compiler.driver.driver_hir_pipeline_support.{
    driver_hir_validation_blob_encode_enabled_v1,
    driver_rt_criticality_policy_needed_v1}

describe "HIR validation blob encode gate":
    it "is enabled only for SIMPLE_HIR_VALIDATION_BLOBS=1":
        expect(driver_hir_validation_blob_encode_enabled_v1("1")).to_equal(true)
        expect(driver_hir_validation_blob_encode_enabled_v1("")).to_equal(false)
        expect(driver_hir_validation_blob_encode_enabled_v1("0")).to_equal(false)
        expect(driver_hir_validation_blob_encode_enabled_v1("yes")).to_equal(false)

describe "RT criticality policy short-circuit":
    it "is not needed with no claims and no rt/HAL modules":
        val none: [bool] = []
        expect(driver_rt_criticality_policy_needed_v1(0, none)).to_equal(false)
        expect(driver_rt_criticality_policy_needed_v1(0, [false, false])).to_equal(false)
    it "is needed when a claim exists":
        val none: [bool] = []
        expect(driver_rt_criticality_policy_needed_v1(1, none)).to_equal(true)
    it "is needed when any module has rt/HAL":
        expect(driver_rt_criticality_policy_needed_v1(0, [false, true])).to_equal(true)
