# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/native_staged_codegen.spl 0%
"""
# Staged native codegen bounds retained MIR

**Category:** Compiler / driver
**Bug:** doc/08_tracking/bug/phase3_mir_retained_memory_2026_10_17.md

## Purpose and Audience

Phase 3 retained the MIR of every one of ~1302 modules before any object was
emitted (>83 GiB RSS, 0 objects). The native lane now lowers a batch, emits
its objects, and releases its MIR. This spec pins the batching decisions and
the one cross-module registry that must know modules lowered after it freezes.

## Expected Outcome

The batch knob parses strictly (default 0 = off, garbage fails closed);
a batch flushes only when full and more modules remain, so the tail batch
always reaches the ordinary final verdict and link; and freezing the typed
storage registry for the whole schedule admits a module that was not yet
lowered when it froze, without changing the frozen identity.
"""
use std.spec.step
use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use compiler.driver.driver_build.native_staged_codegen.{
    NativeStagedCodegenStateV1, NATIVE_STAGED_CODEGEN_DEFAULT_BATCH_V1,
    native_staged_codegen_batch_parse_v1, native_staged_codegen_flush_due_v1}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}

describe "the staged codegen batch knob":
    it "defaults to streaming batches of 8 when unset":
        # @req REQ-SSPEC-COMPILER
        step("defaults to streaming batches of 8 when unset")
        assert_equal(native_staged_codegen_batch_parse_v1(""), 8)
        assert_equal(NATIVE_STAGED_CODEGEN_DEFAULT_BATCH_V1, 8)

    it "accepts an explicit count and 0 as disable":
        # @req REQ-SSPEC-COMPILER
        step("accepts an explicit count and 0 as disable")
        assert_equal(native_staged_codegen_batch_parse_v1("128"), 128)
        assert_equal(native_staged_codegen_batch_parse_v1("0"), 0)
        assert_false(NativeStagedCodegenStateV1.begin(0).active)
        assert_true(NativeStagedCodegenStateV1.begin(16).active)

    it "fails closed on a malformed value":
        # @req REQ-SSPEC-COMPILER
        step("fails closed on a malformed value")
        assert_equal(native_staged_codegen_batch_parse_v1("-4"), -1)
        assert_equal(native_staged_codegen_batch_parse_v1("64k"), -1)
        assert_equal(native_staged_codegen_batch_parse_v1("9999999999"), -1)

describe "when a batch is flushed":
    it "flushes a full batch while modules remain":
        # @req REQ-SSPEC-COMPILER
        step("flushes a full batch while modules remain")
        assert_true(native_staged_codegen_flush_due_v1(64, 64, 64, 1302))
        assert_false(native_staged_codegen_flush_due_v1(63, 64, 63, 1302))

    it "never flushes the tail, so the final call owns verdict and link":
        # @req REQ-SSPEC-COMPILER
        step("never flushes the tail, so the final call owns verdict and link")
        assert_false(native_staged_codegen_flush_due_v1(64, 64, 128, 128))
        assert_false(native_staged_codegen_flush_due_v1(64, 0, 64, 1302))

describe "the frozen storage registry under staging":
    it "admits a module lowered after the registry froze":
        # @req REQ-SSPEC-COMPILER
        step("admits a module lowered after the registry froze")
        val ctx = CompileContext.create(driver_core_compile_options_default())
        val identity = ctx.freeze_storage_registry_for_schedule(["batch1.mod", "batch2.mod"])
        assert_true(identity != "invalid")
        assert_equal(ctx.freeze_storage_registry(), identity)
        assert_true(ctx.frozen_storage_module_snapshot("batch2.mod").ok)
        assert_false(ctx.frozen_storage_module_snapshot("not.scheduled").ok)
