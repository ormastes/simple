use compiler.driver.driver_log_helpers.{phase_rss_enabled_v1, phase_rss_suffix_v1, phase_rss_set_retained_objects_v1, phase_rss_retained_objects_v1}
use std.io_runtime.{file_read}

# doc/08_tracking/bug/item5_phase3_open_failures_2026_10_14.md
# (item5_native_object_resource_growth_2026_10_14): opt-in per-phase RSS /
# peak-RSS / retained-object instrumentation, SIMPLE_PHASE_RSS=1.
describe "Per-phase RSS instrumentation":
    it "is off unless SIMPLE_PHASE_RSS is exactly 1":
        expect(phase_rss_enabled_v1("")).to_equal(false)
        expect(phase_rss_enabled_v1("0")).to_equal(false)
        expect(phase_rss_enabled_v1("1")).to_equal(true)

    it "formats rss, peak and retained-object count":
        val s = phase_rss_suffix_v1(2048, 4096, 7)
        expect(s).to_equal(" rss_kib=2048 peak_kib=4096 retained_objs=7")

    it "tracks the retained-object count":
        phase_rss_set_retained_objects_v1(69)
        expect(phase_rss_retained_objects_v1()).to_equal(69)

    it "log_phase wires the suffix behind the flag":
        val src = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        expect(src).to_contain("phase_rss_suffix_v1(")
        expect(src).to_contain("SIMPLE_PHASE_RSS")
