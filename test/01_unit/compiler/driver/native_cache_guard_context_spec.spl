# Gap guard_id (live_object_key.sdn) closed: everything @when/cfg evaluation
# reads (resolved target/host OS, arch, CPU) is in the native cache scope key.
use std.spec
use compiler.core.cfg_platform.{cfg_guard_context_identity_v1}
use compiler.driver.driver_build.incremental.{native_build_cache_scope_key}

extern fn rt_env_set(key: text, value: text) -> bool

describe "native cache guard context":
    it "puts the resolved guard context in the scope key":
        val scope = native_build_cache_scope_key(Some("llvm"), nil, [], 2, "c")
        expect(scope).to_contain(";guards=")
        expect(scope).to_contain(cfg_guard_context_identity_v1())

    it "changes the scope when a guard input changes":
        rt_env_set("SIMPLE_NATIVE_BUILD_TARGET", "x86_64-unknown-linux-gnu")
        val linux = native_build_cache_scope_key(Some("llvm"), nil, [], 2, "c")
        expect(cfg_guard_context_identity_v1()).to_contain("os=5:linux")
        rt_env_set("SIMPLE_NATIVE_BUILD_TARGET", "x86_64-pc-windows-msvc")
        val windows = native_build_cache_scope_key(Some("llvm"), nil, [], 2, "c")
        rt_env_set("SIMPLE_NATIVE_BUILD_TARGET", "aarch64-unknown-linux-gnu")
        val arm = native_build_cache_scope_key(Some("llvm"), nil, [], 2, "c")
        rt_env_set("SIMPLE_NATIVE_BUILD_TARGET", "")
        expect(linux == windows).to_equal(false)
        expect(linux == arm).to_equal(false)
