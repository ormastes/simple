use std.spec.*
use std.spec.step
use compiler.driver.driver_hir_pipeline_support.{
    driver_hir_diagnostic_budget,
    driver_hir_diagnostic_budget_exhausted
}

describe "HIR diagnostic memory budget":
    it "allows the last count below the limit":
        step("keeps collect-all active below the bounded no-GC limit")
        val limit = driver_hir_diagnostic_budget()
        expect(limit).to_be_greater_than(1)
        expect(driver_hir_diagnostic_budget_exhausted(limit - 1)).to_equal(false)

    it "stops at the limit before lowering another poisoned module":
        step("fails closed at the deterministic module boundary")
        val limit = driver_hir_diagnostic_budget()
        expect(driver_hir_diagnostic_budget_exhausted(limit)).to_equal(true)
        expect(driver_hir_diagnostic_budget_exhausted(limit + 100)).to_equal(true)
