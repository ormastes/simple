use std.spec.{describe, it, expect}
use compiler.driver.driver_streaming_surface_policy.{
    driver_low_memory_streaming_requested_values,
    driver_streaming_surface_route_values}

describe "Low-memory parser ownership":
    it "streams an AOT entry closure without a bootstrap environment request":
        val requested = driver_low_memory_streaming_requested_values(
            true, true, true, false, true, false)
        expect(requested).to_equal(true)
        expect(driver_streaming_surface_route_values(
            requested, true, true, false, true, false)).to_equal(1)

    it "preserves ordinary ownership without low-memory":
        expect(driver_low_memory_streaming_requested_values(
            false, true, true, false, true, false)).to_equal(false)

    it "preserves consumers that require retained parser inventory":
        expect(driver_low_memory_streaming_requested_values(
            true, false, true, false, true, false)).to_equal(false)
        expect(driver_low_memory_streaming_requested_values(
            true, true, false, false, true, false)).to_equal(false)
        expect(driver_low_memory_streaming_requested_values(
            true, true, true, true, true, false)).to_equal(false)
        expect(driver_low_memory_streaming_requested_values(
            true, true, true, false, false, false)).to_equal(false)
        expect(driver_low_memory_streaming_requested_values(
            true, true, true, false, true, true)).to_equal(false)

    it "continues to reject unsupported explicit streaming requests":
        expect(driver_streaming_surface_route_values(
            true, true, true, true, true, false)).to_equal(-3)
        expect(driver_streaming_surface_route_values(
            true, true, true, false, false, false)).to_equal(-4)
        expect(driver_streaming_surface_route_values(
            true, true, true, false, true, true)).to_equal(-5)
