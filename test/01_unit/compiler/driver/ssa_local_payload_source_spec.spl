"""
# Staged SSA Local Payload Contract

Keeps nested MirOperand LocalId decoding inside the SSA module so staged-native
value-type payloads do not cross the var-reassign module boundary as nil.
"""

extern fn rt_file_read_text(path: text) -> text

describe "Staged SSA Local Payload":
    it "decodes copy and move operands with the local SSA helper":
        val source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/var_reassign_ssa.spl") ?? ""
        expect(source).to_contain(
            "local_list_push_unique(locals, ssa_local_id_value(local))")
        expect(source).to_not_contain(
            "local_list_push_unique(locals, var_reassign_local_id_value(local))")
        expect(source).to_contain(
            "if not ssa_inst_operand_payloads_valid(inst):")
        expect(source).to_contain(
            "case LocalId(raw_id): raw_id >= 0")
        expect(source).to_contain(
            "case MirOperand(kind):")
        expect(source).to_contain(
            "if operand == nil or operand == 0:")
        expect(source).to_contain(
            "if local == nil or local == 0:")
        expect(source).to_contain(
            "if kind == nil:")
        expect(source).to_not_contain(
            "local != nil")
        # Ret(Some(v)) is admitted to the alloca lane through the same payload
        # gate as If/Switch (bug llvm_text_backend_array_copy_loop_ssa_redefinition
        # _2026-08-22); the blanket value-return refusal is gone.
        expect(source).to_not_contain(
            "fn ssa_term_has_value_return(term: MirTerminator) -> bool:")
        expect(source).to_not_contain(
            "unsupported value return terminator")
        expect(source).to_contain(
            "if value != nil: ssa_operand_local_payload_valid(value.unwrap()) else: true")
        expect(source).to_not_contain(
            "ssa_ret_operand_info")
        expect(source).to_contain(
            "case Copy(_, src): src != nil")
        expect(source).to_contain(
            "case Move(_, src): src != nil")
        expect(source).to_contain(
            "fn ssa_term_operand_payloads_valid(term: MirTerminator) -> bool:")
        expect(source).to_contain(
            "invalid terminator operands")
