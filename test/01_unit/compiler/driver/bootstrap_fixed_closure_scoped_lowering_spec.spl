# @req REQ-SSPEC-COMPILER
"""
# Bootstrap-fixed closure loop lowers each module inside a transient scope

Stage 3 diagnostic (2026-10-20, Stage 2 `ce8bd78f`): after the closure-call
SIGSEGV fix the bootstrap-fixed lane lowered 1100 closure modules on one
`MirLowering` instance with plain `lower_module`, and the compiler grew from
13.2 GB to 52.9 GB (~36 MB retained per module;
doc/08_tracking/bug/stage3_bootstrap_closure_mir_lowering_retention_2026_10_20.md).
The direct lane already reclaims that arena through
`lower_module_transient_scoped`, which promotes only the returned MirModule,
the lowering's cross-module owners and the bootstrap flat registries.

Fix: `MirLowering.lower_bootstrap_closure_module` returns
`Result<MirModule, text>` from `lower_module_transient_scoped(module,
no_providers, false)` -- every argument explicit, called from inside the
class -- and the driver loop fails closed on `Err` exactly like the direct
lane (the scope has already ended, so nothing half-reclaimed is used). The
loop order (closure modules first, entry last) is unchanged.

The lane only runs for the Stage 3 entry under SIMPLE_BOOTSTRAP=1, so these
probes pin the wiring in source (the neighboring driver-spec idiom) and the
imports force the seed to compile both edited modules.
"""

# @tag: unit, compiler, driver, bootstrap, stage3, memory

use std.spec
use std.io_runtime.{file_read}
use compiler.driver.driver_pipeline_lowering.*
use compiler.mir._MirLowering.module_lowering.*

describe "bootstrap-fixed closure scoped lowering":
    it "lowers each closure module through the transient-scoped path":
        val mir = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        expect(mir).to_contain("me lower_bootstrap_closure_module(module: HirModule, providers: [HirModule]) -> Result<MirModule, text>:")
        expect(mir).to_contain("self.lower_module_transient_scoped(module, providers, false)")

    it "fails closed on a transient-scope error and unwraps only after the check":
        val driver = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(driver).to_contain("val bootstrap_closure_scoped = bootstrap_lowering.lower_bootstrap_closure_module(")
        expect(driver).to_contain("if bootstrap_closure_scoped.is_err():")
        expect(driver).to_contain('aot:bootstrap_fixed:transient_scope_failed module={bootstrap_closure_name}')
        val err_pos = driver.index_of("if bootstrap_closure_scoped.is_err():")
        val unwrap_pos = driver.index_of("bootstrap_closure_scoped.unwrap()")
        expect(err_pos >= 0 and unwrap_pos > err_pos).to_equal(true)

    it "keeps closure modules ahead of the entry lowering":
        val driver = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        val closure_pos = driver.index_of("bootstrap_closure_idx = 0")
        val entry_pos = driver.index_of("lower_bootstrap_entry_module(bootstrap_hir, self.ctx.mir_feed_modules)")
        expect(closure_pos >= 0 and entry_pos > closure_pos).to_equal(true)

    it "passes every lower_module argument explicitly inside the scoped path":
        val mir = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        val start = mir.index_of("me lower_module_transient_scoped(")
        expect(start >= 0).to_equal(true)
        val body = mir[start:start + 9000]
        expect(body).to_contain("return Ok(self.lower_module(module, providers, is_entry_module, scoped_archive_symbols,")
        expect(body).to_contain("val lowered: MirModule = self.lower_module(module, providers, is_entry_module, scoped_archive_symbols,")

    it "collects accumulated MIR errors before failing closed":
        val driver = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        val err_pos = driver.index_of("if bootstrap_closure_scoped.is_err():")
        val collect_pos = driver.index_of("_driver_collect_mir_errors(self.ctx, bootstrap_lowering.errors)", err_pos)
        val fail_pos = driver.index_of("aot:bootstrap_fixed:transient_scope_failed", err_pos)
        expect(err_pos >= 0 and collect_pos > err_pos and fail_pos > collect_pos).to_equal(true)

    it "gives closure modules the direct lane's provider feed, not an empty list":
        val driver = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(driver).to_contain("bootstrap_lowering.lower_bootstrap_closure_module(\n                            bootstrap_closure_hir, self.ctx.mir_feed_modules)")
        val feed_pos = driver.index_of("self.ctx.mir_feed_modules = []")
        val closure_pos = driver.index_of("bootstrap_closure_idx = 0")
        expect(feed_pos >= 0 and closure_pos > feed_pos).to_equal(true)
