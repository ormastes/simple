# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# Assert-only invariant behind bug_db row stage3_selfhost_exit_139_2026-08-14
# (doc/08_tracking/bug/stage3_selfhost_exit_139_2026-08-14.md). The August
# exit 139 was never symbolized. The only later root-caused Stage-3 exit-139
# with the same "dies before any diagnostic output" signature is the fixed-entry
# lower_module call shape fixed in a0d60244575. This pins that the fixed lane
# keeps the unique, fully-argumented entry, so a regression cannot silently
# reintroduce the candidate crash shape.
# TODO(opf-1): confirm attribution with a retained, symbolized Linux Stage-3 run.
use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text?

fn read_src(path: text) -> text:
    val got = rt_file_read_text(path)
    if got.is_none():
        return ""
    got.unwrap()

describe "stage3 self-host exit-139 candidate call shape stays fixed":
    it "driver fixed lane calls the unique bootstrap entry":
        val src = read_src("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(src.len()).to_be_greater_than(0)
        expect(src).to_contain("bootstrap_lowering.lower_bootstrap_entry_module(bootstrap_hir, self.ctx.mir_feed_modules)")

    it "MirLowering still declares the unique entry":
        val src = read_src("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        expect(src).to_contain("me lower_bootstrap_entry_module(module: HirModule, providers: [HirModule]) -> MirModule:")
