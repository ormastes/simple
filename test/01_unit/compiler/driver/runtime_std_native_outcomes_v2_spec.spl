# @req REQ-RUNTIME-STD-NATIVE-TARGET-OUTCOMES

use std.spec.{describe, it, expect}
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.smf.runtime_std_native_outcomes_v2.{
    RuntimeStdNativeOutcomeKindV2, RuntimeStdNativeOutcomeReceiptV2,
    runtime_std_native_semantic_action_key_v2,
    runtime_std_native_outcomes_section_v2,
    runtime_std_native_outcomes_decode_v2}
use compiler.driver.smf.runtime_std_native_action_budget_v2.{
    RuntimeStdNativeActionBudgetV2,
    runtime_std_native_action_budget_valid_v2,
    runtime_std_native_action_peak_admitted_v2,
    runtime_std_native_action_abi_digest_v2}
use compiler.driver.cache.runtime_std_authority_receipt.{
    RuntimeStdAuthorityReceiptV1, RuntimeStdAuthorityReceiptV2,
    RUNTIME_STD_AUTHORITY_ACTION_SCHEMA_V2,
    runtime_std_authority_receipt_encode_v2,
    runtime_std_authority_receipt_decode_v2}
use compiler.driver.smf.runtime_std_package_set.{
    RuntimeStdPackageAuthorityV1, runtime_std_action_digest_v2}

fn _native_outcome_fixture_v2(
    kind: RuntimeStdNativeOutcomeKindV2, source: text,
    object_digest: text, object_bytes: i64, capsule_digest: text
) -> RuntimeStdNativeOutcomeReceiptV2:
    val source_digest = sha256_text("source:" + source)
    val hir_digest = sha256_text("hir:" + source)
    val mir_digest = sha256_text("mir:" + source)
    val cfg_digest = sha256_text("cfg:" + source)
    val target = "x86_64-unknown-linux-gnu"
    val key = runtime_std_native_semantic_action_key_v2(kind, source,
        source_digest, target, "llvm", hir_digest, mir_digest, cfg_digest)
    RuntimeStdNativeOutcomeReceiptV2(kind, source, source_digest,
        target, hir_digest, mir_digest, cfg_digest, key,
        object_digest, object_bytes, capsule_digest)

describe "runtime/std native source outcomes v2", tag: ["only-compiled"]:
    it "roundtrips all dispositions with exact selected source closure":
        step("Frame code, active objectless, and cfg inactive rows canonically")
        val code = _native_outcome_fixture_v2(
            RuntimeStdNativeOutcomeKindV2.code_object,
            "src/runtime/a.spl", sha256_text("object-a"), 42,
            sha256_text("capsule-a"))
        val objectless = _native_outcome_fixture_v2(
            RuntimeStdNativeOutcomeKindV2.active_objectless,
            "src/runtime/b.spl", "", 0, "")
        val inactive = _native_outcome_fixture_v2(
            RuntimeStdNativeOutcomeKindV2.cfg_inactive,
            "src/runtime/c.spl", "", 0, "")
        val rows = [code, objectless, inactive]
        val ids = [code.source_identity, objectless.source_identity,
            inactive.source_identity]
        val digests = [code.source_digest, objectless.source_digest,
            inactive.source_digest]
        val encoded = runtime_std_native_outcomes_section_v2(rows,
            "llvm", code.target_triple, ids, digests)
        expect(encoded.is_ok()).to_equal(true)
        val decoded = runtime_std_native_outcomes_decode_v2(encoded.unwrap(),
            "llvm", code.target_triple, ids, digests)
        expect(decoded.is_ok()).to_equal(true)
        expect(decoded.unwrap().len()).to_equal(3)
        expect(decoded.unwrap()[1].kind).to_equal(
            RuntimeStdNativeOutcomeKindV2.active_objectless)

        step("Reject a source omission, reordered source, or target delimiter")
        expect(runtime_std_native_outcomes_section_v2(
            [code, inactive], "llvm", code.target_triple, ids,
            digests).is_err()).to_equal(true)
        expect(runtime_std_native_outcomes_section_v2(
            [objectless, code, inactive], "llvm", code.target_triple,
            ids, digests).is_err()).to_equal(true)
        expect(runtime_std_native_outcomes_section_v2(rows, "llvm",
            "bad\ntarget", ids, digests).is_err()).to_equal(true)
        expect(runtime_std_native_outcomes_decode_v2(
            encoded.unwrap() + "extra\n", "llvm", code.target_triple,
            ids, digests).is_err()).to_equal(true)

    it "requires manager-bound whole-process memory evidence":
        val budget = RuntimeStdNativeActionBudgetV2(
            sha256_text("exact pinned request.sdn bytes"), 1024)
        expect(runtime_std_native_action_budget_valid_v2(budget)).to_equal(true)
        expect(runtime_std_native_action_peak_admitted_v2(
            budget, 1024)).to_equal(true)
        expect(runtime_std_native_action_peak_admitted_v2(
            budget, 1025)).to_equal(false)
        expect(runtime_std_native_action_peak_admitted_v2(
            budget, 0)).to_equal(false)
        expect(runtime_std_native_action_budget_valid_v2(
            RuntimeStdNativeActionBudgetV2("", 1024))).to_equal(false)

    it "roundtrips a V2 authority receipt and changes action keys with budget":
        val producer = sha256_text("producer")
        val abi = runtime_std_native_action_abi_digest_v2(producer)
        val authority = RuntimeStdPackageAuthorityV1(
            producer, abi, sha256_text("runtime ABI"),
            sha256_text("std ABI"), sha256_text("variant"),
            "x86_64-unknown-linux-gnu", "revision-1")
        val budget = RuntimeStdNativeActionBudgetV2(
            sha256_text("manager request"), 8192)
        val runtime_key = runtime_std_action_digest_v2(
            authority, "simple.runtime", budget)
        val std_key = runtime_std_action_digest_v2(
            authority, "simple.std", budget)
        expect(runtime_key == "").to_equal(false)
        val base = RuntimeStdAuthorityReceiptV1(
            producer, abi, authority.runtime_abi_digest,
            authority.std_abi_digest, authority.config_digest,
            authority.target_triple, authority.snapshot_revision,
            runtime_key, std_key, sha256_text("runtime archive"),
            sha256_text("std archive"), sha256_text("runtime receipt"),
            sha256_text("std receipt"))
        val v2 = RuntimeStdAuthorityReceiptV2(base, budget,
            RUNTIME_STD_AUTHORITY_ACTION_SCHEMA_V2)
        val encoded = runtime_std_authority_receipt_encode_v2(v2)
        expect(encoded == "").to_equal(false)
        val decoded = runtime_std_authority_receipt_decode_v2(encoded)
        expect(decoded.is_ok()).to_equal(true)
        expect(decoded.unwrap().budget.manager_request_digest).to_equal(
            budget.manager_request_digest)
        expect(runtime_std_action_digest_v2(authority, "simple.runtime",
            RuntimeStdNativeActionBudgetV2(
                sha256_text("other request"), 8192)) == runtime_key).to_equal(false)
        expect(runtime_std_authority_receipt_decode_v2(
            encoded + "\nextra=1").is_err()).to_equal(true)
