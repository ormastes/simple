"""
## Purpose and audience
Driver maintainers. `native_interface_decls_v1` emits one declaration per trailing
top-level `@attr` line at end of file. Natively compiled Stage 2 code int-boxed the
one-element `[attr]` literal and SEGV'd in join
(doc/08_tracking/bug/one_element_literal_of_loop_text_boxed_as_int_2026-10-25.md).
This interpreter-lane spec pins the shape and the rewrite; it cannot reproduce the native SEGV.
"""
use std.spec.step
use std.spipe.*
use compiler.driver.cache.native_interface_slice.{native_interface_decls_v1}

describe "native interface slice trailing attributes":
    it "keeps trailing top-level attribute lines as their own declarations":
        step("Slice a source whose last top-level lines are attributes")
        val decls = native_interface_decls_v1("@a1\nfn f():\n    x\n@trail1\n@trail2(\n    y)\n")
        expect(decls.len()).to_equal(3)
        expect(decls[0].names).to_equal(["f"])
        expect(decls[2].tokens.contains("trail2")).to_equal(true)
        expect(decls[2].tokens.contains("y")).to_equal(true)
