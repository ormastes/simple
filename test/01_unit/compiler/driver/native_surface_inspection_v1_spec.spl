# @cover src/compiler/80.driver/driver_native_surface_inspection_v1.spl
# @cover src/app/cli/bootstrap_surface_inspection_v1.spl
use std.spec.*
use app.cli.bootstrap_surface_inspection_v1.{bootstrap_surface_inspection_plan_v1,
    bootstrap_surface_inspection_reserve_v1, bootstrap_surface_inspection_publish_v1}
use compiler.driver.driver_native_surface_inspection_v1.{inspection_surface_text_v1,
    native_surface_inspection_apply_cli_options_v1}
use compiler.driver.driver.{compiler_driver_create}
use compiler.driver.driver_phase_gates.{driver_streaming_surface_route}
use compiler.common.driver_compile_options.{driver_core_compile_options_default}
use compiler.common.driver_core_modes.{CompileMode}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend_target_receipted_v1}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry_index.{module_surface_registry_index}
use app.io._CliCompile.compile_targets.{cli_native_build_option_error}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.io_runtime.{env_get_opt}
use std.nogc_sync_mut.io.env_ops.{env_set, env_unset}

val INSPECT_FACADE = "@when(os=\"windows\"):\nfn path_errno_address() -> i64: 0\n@else:\nuse std.inspection._Posix.errno.{path_errno_address}\n@end\nexport path_errno_address\n"

fn inspection_registry_v1(include_leaf: bool) -> ModuleSurfacesByName:
    var builder = ModuleSurfaceBuilder.new()
    var names = ["lib.inspection.facade"]
    var paths = ["src/lib/inspection/facade.spl"]
    var bodies = [INSPECT_FACADE]
    if include_leaf:
        names = names.push("lib.inspection._Posix.errno")
        paths = paths.push("src/lib/inspection/_Posix/errno.spl")
        bodies = bodies.push("fn path_errno_address() -> i64: 42\nexport path_errno_address\n")
    var index = 0
    while index < names.len():
        val parsed = parse_full_frontend_target_receipted_v1(bodies[index], paths[index], names[index],
            Logger(level: 0), paths[index], sha256_text(bodies[index]), "x86_64-unknown-linux-gnu").unwrap()
        expect(builder.add_parsed(parsed.0, SourceFile(path: paths[index], content: bodies[index],
            module_name: names[index]), index).is_ok()).to_equal(true)
        index = index + 1
    builder.finish().unwrap()

describe "native surface diagnostic inspection":
    it "honors the ordinary parsed low-memory context without forcing a forbidden streaming route":
        val keys = ["SIMPLE_STAGE3_STREAMING_SURFACES", "SIMPLE_BOOTSTRAP_STAGE4", "SIMPLE_STAGE4_STREAMING_SURFACES"]
        var prior: [text?] = []
        for key in keys:
            prior = prior.push(env_get_opt(key))
            env_unset(key)
        val args = ["simple", "inspect-native-surfaces", "--entry", "src/app/probe.spl",
            "--low-memory", "--module", "facade", "--item", "get", "--diagnostic-root", "build/verify"]
        val planned = bootstrap_surface_inspection_plan_v1(args)
        var request_flag = false
        var prior_route = -99
        var actual_low_memory = false
        var actual_route = -99
        var forbidden_route = -99
        match planned:
            case Ok(plan):
                request_flag = plan.request.requested_low_memory
                var options = driver_core_compile_options_default()
                options.mode = CompileMode.Aot
                options.cli_mode_text = "aot"
                options.backend = "llvm"
                options.low_memory = false
                val driver = compiler_driver_create(options)
                driver.ctx.config["compiler_source_entry"] = "src/app/probe.spl"
                prior_route = driver_streaming_surface_route(driver.ctx)
                native_surface_inspection_apply_cli_options_v1(driver, plan.request)
                actual_low_memory = driver.ctx.options.low_memory
                actual_route = driver_streaming_surface_route(driver.ctx)
                driver.ctx.config["coverage"] = "1"
                forbidden_route = driver_streaming_surface_route(driver.ctx)
            case Err(_): ()
        var index = 0
        while index < keys.len():
            if val value = prior[index]:
                env_set(keys[index], value)
            else:
                env_unset(keys[index])
            index = index + 1
        expect(prior_route).to_equal(0)
        expect(planned.is_ok()).to_equal(true)
        expect(request_flag).to_equal(true)
        expect(actual_low_memory).to_equal(true)
        expect(actual_route).to_equal(1)
        expect(forbidden_route).to_equal(0)

    it "passes the actual SDK argv shape as canonical options and still rejects two entries":
        val args = ["/producer/linux-x86_64-p1/simple", "inspect-native-surfaces",
            "--source", "/checkout/src/compiler", "--source", "/checkout/src/lib",
            "--source", "/checkout/sdk_owner/src/app", "--entry-closure",
            "--entry", "/checkout/sdk_owner/src/app/simpleos_sdk_owner_probe.spl",
            "--mode", "dynload", "--low-memory", "--threads", "4", "--cache-dir", "/checkout/sdk_owner/cache",
            "--module", "lib.nogc_sync_mut.io.path_identity_abi",
            "--module", "lib.nogc_sync_mut.io._PathIdentityPosix.errno_abi",
            "--item", "path_errno_address", "--diagnostic-root", "build/verify"]
        val planned = bootstrap_surface_inspection_plan_v1(args).unwrap()
        expect(planned.request.requested_low_memory).to_equal(true)
        expect(cli_native_build_option_error(planned.native_args, true)).to_equal("")
        expect(planned.native_args.contains(args[0])).to_equal(false)
        expect(planned.native_args.contains("inspect-native-surfaces")).to_equal(false)
        expect(planned.native_args.contains("--module")).to_equal(false)
        expect(planned.native_args.contains("--diagnostic-root")).to_equal(false)
        expect(bootstrap_surface_inspection_plan_v1(args + ["--entry", "/checkout/other.spl"]).is_err()).to_equal(true)
        expect(bootstrap_surface_inspection_plan_v1(args + ["/checkout/other.spl"]).is_err()).to_equal(true)

    it "retains an omitted canonical target instead of inventing a host triple":
        val args = ["simple", "inspect-native-surfaces", "--entry", "entry.spl", "--module", "facade",
            "--item", "get", "--diagnostic-root", "build/verify"]
        val implicit = bootstrap_surface_inspection_plan_v1(args).unwrap()
        expect(implicit.request.requested_target).to_equal("")
        expect(implicit.request.requested_low_memory).to_equal(false)
        expect(implicit.native_args.contains("--target")).to_equal(false)
        val explicit = bootstrap_surface_inspection_plan_v1(args + ["--target", "x86_64-unknown-linux-gnu"]).unwrap()
        expect(explicit.request.requested_target).to_equal("x86_64-unknown-linux-gnu")

    it "publishes a fresh private diagnostic once and preserves it on a collision":
        expect(dir_create_all("build/verify")).to_equal(true)
        val parsed = bootstrap_surface_inspection_plan_v1(["simple", "inspect-native-surfaces",
            "--entry", "entry.spl", "--target", "x86_64-unknown-linux-gnu", "--module", "facade",
            "--item", "get", "--diagnostic-root", "build/verify"]).unwrap()
        val reserved = bootstrap_surface_inspection_reserve_v1(parsed).unwrap()
        val fixture = "schema: surface-inspection-owner-test-fixture\n"
        val first = bootstrap_surface_inspection_publish_v1(reserved.request, fixture).unwrap()
        expect(first).to_equal(reserved.request.output)
        expect(bootstrap_surface_inspection_publish_v1(reserved.request, "replacement\n").is_err()).to_equal(true)
        expect(file_read_regular_no_follow_bounded(first, 4096).unwrap()).to_equal(fixture)

    it "observes configured POSIX imports and the same walk through a bare export":
        val registry = inspection_registry_v1(true)
        val index = module_surface_registry_index(registry, "lib.inspection.facade")
        val observed = inspection_surface_text_v1(registry, index, "lib.inspection.facade", "path_errno_address").unwrap()
        expect(observed.contains("raw_callable_match: false")).to_equal(true)
        expect(observed.contains("module: \"std.inspection._Posix.errno\"")).to_equal(true)
        expect(observed.contains("target_present: true")).to_equal(true)
        expect(observed.contains("walker_found: true")).to_equal(true)
        expect(observed.contains("walker_source_item: \"path_errno_address\"")).to_equal(true)

    it "retains missing configured targets as observations rather than successful bindings":
        val registry = inspection_registry_v1(false)
        val index = module_surface_registry_index(registry, "lib.inspection.facade")
        val observed = inspection_surface_text_v1(registry, index, "lib.inspection.facade", "path_errno_address").unwrap()
        expect(observed.contains("target_index: -1")).to_equal(true)
        expect(observed.contains("target_present: false")).to_equal(true)
        expect(observed.contains("walker_found: false")).to_equal(true)
        val absent = inspection_surface_text_v1(registry, -1, "missing.module", "path_errno_address").unwrap()
        expect(absent.contains("observation: MISSING_MODULE")).to_equal(true)

    it "rejects malformed selector sets and native-output requests before source ownership changes":
        val base = ["simple", "inspect-native-surfaces", "--entry", "entry.spl", "--target", "x86_64-unknown-linux-gnu"]
        expect(bootstrap_surface_inspection_plan_v1(base + ["--module", "facade", "--item", "get",
            "--diagnostic-root", "build/verify"]).is_ok()).to_equal(true)
        expect(bootstrap_surface_inspection_plan_v1(base + ["--module", "facade", "--module", "leaf", "--module", "third",
            "--item", "get", "--diagnostic-root", "build/verify"]).is_err()).to_equal(true)
        expect(bootstrap_surface_inspection_plan_v1(base + ["--module", "facade", "--item", "get",
            "--output", "native.elf", "--diagnostic-root", "build/verify"]).is_err()).to_equal(true)
        expect(bootstrap_surface_inspection_plan_v1(base + ["--module", "facade", "--item", "get",
            "--diagnostic-root", "src/overwrite.sdn"]).is_err()).to_equal(true)
