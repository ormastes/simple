# @req REQ-IM-005 REQ-IM-008
"""
# Native per-module object cache key: recompile only affected modules

Bug: doc/08_tracking/bug/pure_simple_native_cache_closure_wide_scope_key_2026_10_20.md

Each module's object witness folds its own lowered input (stand-in here: the
module's own source digest, which is what changes its MIR), the interface
facts of the modules it imports, and the compiler/target/options config.
These probes drive the production dependency-fact path the driver uses
(native_source_interface_index_from_sources_v1 +
native_direct_dependency_facts_from_index_v1) over a four-module world:

    main -> mid -> prov        main -> other

and check which witnesses move for each kind of edit.
"""

# @tag: unit, compiler, cache, native, witness

use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types.{ParserImport, ImportItem}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_path}
use compiler.driver.cache.native_source_interface_index.{
    native_source_interface_index_from_sources_v1,
    native_direct_dependency_facts_from_index_v1}
use compiler.driver.cache.native_module_witness.{
    NativeModuleConfigFactV1, native_module_cache_witness_v1}

val PROV_BASE: text = "struct Point:\n    x: i64\n    y: i64\n\nfn make_point(a: i64) -> Point:\n    Point(x: a, y: a + 1)\n\nfn prov_value() -> i64:\n    40\n"
val MID_SRC: text = 'use prov.{Point, make_point, prov_value}' + "\n\nfn mid_sum(a: i64) -> i64:\n    val p = make_point(a)\n    p.x + p.y + prov_value()\n"
val OTHER_SRC: text = "fn other_value() -> i64:\n    7\n"
val MAIN_SRC: text = 'use mid.{mid_sum}' + "\n" + 'use other.{other_value}' + "\n\nfn main() -> i64:\n    mid_sum(1) + other_value()\n"

fn gran_items(names: [text]) -> [ImportItem]:
    var items: [ImportItem] = []
    for n in names:
        items.push(ImportItem(name: n, has_alias: false, alias: ""))
    items

fn gran_surface(name: text, imports: [ParserImport], targets: [i64], target_names: [text]) -> ModuleSurface:
    var s = ModuleSurface.empty(name)
    s.preferred_registry_name = name
    # Production surfaces carry the ABSOLUTE canonical path while the admitted
    # sources keep the path they were loaded under (relative here).
    s.canonical_path = module_surface_canonical_path("gran/{name}.spl")
    s.imports = imports
    s.import_target_indices = targets
    s.import_target_names = target_names
    s

fn gran_import(module: text, names: [text]) -> ParserImport:
    ParserImport(module: module, items: gran_items(names), is_lazy: false, span: Span.empty())

# World indices: 0 main, 1 mid, 2 prov, 3 other.
fn gran_surfaces(prov_imports_other: bool) -> ModuleSurfacesByName:
    val main = gran_surface("main",
        [gran_import("mid", ["mid_sum"]), gran_import("other", ["other_value"])],
        [1, 3], ["mid", "other"])
    val mid = gran_surface("mid",
        [gran_import("prov", ["Point", "make_point", "prov_value"])], [2], ["prov"])
    val prov = if prov_imports_other:
        gran_surface("prov", [gran_import("other", ["other_value"])], [3], ["other"])
    else:
        gran_surface("prov", [], [], [])
    val other = gran_surface("other", [], [], [])
    ModuleSurfacesByName(surfaces: [main, mid, prov, other],
        index_by_name: {"main": 0, "mid": 1, "prov": 2, "other": 3},
        ordered_names: ["main", "mid", "prov", "other"], ordered_indices: [0, 1, 2, 3],
        generation: 1, frozen: true)

fn gran_config(compiler: text) -> NativeModuleConfigFactV1:
    NativeModuleConfigFactV1(compiler_identity: compiler,
        target_identity: "aarch64-linux", options_identity: "opt=0",
        provider_identity: "llvm", emitter_scheme: "pure-simple-dotted-v1")

fn gran_source(name: text, prov_src: text) -> text:
    if name == "main": return MAIN_SRC
    if name == "mid": return MID_SRC
    if name == "prov": return prov_src
    OTHER_SRC

# Witness digest per module, in world order. "" marks a refused witness.
fn gran_witnesses(prov_src: text, prov_imports_other: bool, compiler: text) -> [text]:
    var sources: [SourceFile] = []
    for name in ["main", "mid", "prov", "other"]:
        sources.push(SourceFile(path: "gran/{name}.spl",
            content: gran_source(name, prov_src), module_name: name))
    val index = native_source_interface_index_from_sources_v1(sources)
    val surfaces = gran_surfaces(prov_imports_other)
    var out: [text] = []
    for name in ["main", "mid", "prov", "other"]:
        val deps = native_direct_dependency_facts_from_index_v1(name, surfaces, index)
        if not deps.valid:
            out.push("")
            continue
        val w = native_module_cache_witness_v1(name,
            sha256_text(gran_source(name, prov_src)), deps.dependencies, [], [],
            gran_config(compiler))
        out.push(if w.valid: w.digest() else: "")
    out

# "main mid prov other" -> which witnesses differ between two worlds.
fn gran_changed(before: [text], after: [text]) -> text:
    val names = ["main", "mid", "prov", "other"]
    var changed: [text] = []
    var i = 0
    while i < names.len():
        if before[i] != after[i]:
            changed.push(names[i])
        i = i + 1
    changed.join(",")

fn gran_base() -> [text]:
    gran_witnesses(PROV_BASE, false, "compiler-a")

describe "native per-module object cache key granularity":
    it "admits a witness for every module, importers included":
        # A relative admitted path must still be found under the surface's
        # absolute canonical path; otherwise every importer is refused.
        val w = gran_base()
        expect(w[0] != "").to_equal(true)
        expect(w[1] != "").to_equal(true)
        expect(w[2] != "").to_equal(true)
        expect(w[3] != "").to_equal(true)

    it "recompiles only the edited module on a body-only edit":
        val edited = PROV_BASE.replace("    40\n", "    41\n")
        expect(gran_changed(gran_base(), gran_witnesses(edited, false, "compiler-a"))).to_equal("prov")

    it "recompiles the provider and its importer when a struct field is added":
        val edited = PROV_BASE.replace("    y: i64\n", "    y: i64\n    z: i64\n")
        expect(gran_changed(gran_base(), gran_witnesses(edited, false, "compiler-a"))).to_equal("mid,prov")

    it "recompiles the provider and its importer when struct fields are reordered":
        val edited = PROV_BASE.replace("    x: i64\n    y: i64\n", "    y: i64\n    x: i64\n")
        expect(gran_changed(gran_base(), gran_witnesses(edited, false, "compiler-a"))).to_equal("mid,prov")

    it "recompiles the provider and its importer when a field type changes":
        val edited = PROV_BASE.replace("    x: i64\n", "    x: i32\n")
        expect(gran_changed(gran_base(), gran_witnesses(edited, false, "compiler-a"))).to_equal("mid,prov")

    it "recompiles the provider and its importer when a signature changes":
        val edited = PROV_BASE.replace("fn make_point(a: i64) -> Point:", "fn make_point(a: i64, b: i64) -> Point:")
        expect(gran_changed(gran_base(), gran_witnesses(edited, false, "compiler-a"))).to_equal("mid,prov")

    it "recompiles only the importer when its import set changes":
        val edited = 'use other.{other_value}' + "\n\n" + PROV_BASE.replace("    40\n", "    other_value() + 33\n")
        expect(gran_changed(gran_base(), gran_witnesses(edited, true, "compiler-a"))).to_equal("prov")

    it "recompiles dependents when an imported name is re-pointed through an import":
        # mid imports Point from prov; if prov's Point now comes from another
        # module, mid must rebuild even though prov's own declarations moved out.
        val moved = 'use other.{Point}' + "\n\nfn make_point(a: i64) -> Point:\n    Point(x: a, y: a + 1)\n\nfn prov_value() -> i64:\n    40\n"
        val changed = gran_changed(gran_base(), gran_witnesses(moved, true, "compiler-a"))
        expect(changed).to_equal("mid,prov")

    it "invalidates every module when the compiler identity changes":
        expect(gran_changed(gran_base(), gran_witnesses(PROV_BASE, false, "compiler-b"))).to_equal("main,mid,prov,other")

    it "keeps later declarations after a header whose string default holds a bracket":
        val base = "fn sep_of(sep: text = \"(\") -> text:\n    sep\n\n" + PROV_BASE
        val edited = base.replace("fn prov_value() -> i64:", "fn prov_value() -> i32:")
        expect(gran_changed(gran_witnesses(base, false, "compiler-a"), gran_witnesses(edited, false, "compiler-a"))).to_equal("mid,prov")

    it "keeps later declarations after a multi-line string value":
        val base = "val USAGE: text = \"\"\"\nusage text\n\"\"\"\n\n" + PROV_BASE
        val edited = base.replace("fn prov_value() -> i64:", "fn prov_value() -> i32:")
        expect(gran_changed(gran_witnesses(base, false, "compiler-a"), gran_witnesses(edited, false, "compiler-a"))).to_equal("mid,prov")
