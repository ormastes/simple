use compiler.driver.driver_source_loading.{_driver_entry_import_module_paths}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool

describe "entry closure architecture cfg selection":
    it "keeps only ARM64 imports for an ARM64 target":
        val previous = rt_env_get("SIMPLE_TARGET_ARCH") ?? ""
        rt_env_set("SIMPLE_TARGET_ARCH", "arm64")
        val imports = _driver_entry_import_module_paths("""@cfg(x86_64)
use os.userlib.syscall_target_x86_64.{syscall}
@cfg(arm64)
use os.userlib.syscall_target_arm64.{syscall}
@cfg(riscv64)
use os.userlib.syscall_target_riscv64.{syscall}
@cfg(riscv32)
use os.userlib.syscall_target_riscv32.{syscall}
""")
        rt_env_set("SIMPLE_TARGET_ARCH", previous)

        expect(imports.len()).to_equal(1)
        expect(imports[0]).to_equal("os.userlib.syscall_target_arm64")
