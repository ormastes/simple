# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/driver/interface_digest_wiring_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/interface_digest_wiring_spec.md
# doc-path: doc/03_plan/sys_test/interface_digest_wiring_spec.md
# doc-path: doc/04_architecture/interface_digest_wiring_spec.md
# doc-path: doc/05_design/interface_digest_wiring_spec_oracles.md
# @manual: primary

"""
# Interface Digest Wiring Specification

**Category:** Infrastructure
**Wires:** compiler.driver.cache.action_key.interface_digest_of — first real
consumer (recorded into SmfManifestEntry.iface_digest, verified on load as a
level-gated diagnostic).

## Overview

Contract of the textual interface digest (`interface_digest_of_source`):
deterministic; sensitive to declaration-header (signature) edits; insensitive
to body-only edits. Plus the three typed verdicts of
`smf_manifest_entry_iface_verdict` (match / mismatch / absent) and the
additive manifest round-trip (old rows parse with an absent digest).

Honest limits of the textual v1 extractor are asserted, not hidden: struct
FIELD lines are not part of the digest (documented in action_key.spl).
"""
use std.spec.step

use std.spec.step

use std.spec.*
use compiler.driver.cache.action_key.{interface_digest_of, interface_digest_of_source, source_interface_parts}
use compiler.driver.watcher.smf_manifest.{SmfManifestEntry, smf_manifest_entry_new_with_iface, smf_manifest_entry_iface_verdict, iface_digest_verdict_text, iface_digest_gate_code, smf_manifest_to_sdn, smf_manifest_from_sdn, smf_manifest_new, smf_manifest_update, smf_manifest_find}


val SRC_A: text = "fn add(a: i64, b: i64) -> i64:\n    a + b\n\nfn hello() -> text:\n    \"hi\"\n"
# Same signatures as SRC_A, different BODY only.
val SRC_A_BODY_EDIT: text = "fn add(a: i64, b: i64) -> i64:\n    val t = a\n    t + b\n\nfn hello() -> text:\n    \"hello there\"\n"
# Signature change: add's return type differs.
val SRC_A_SIG_EDIT: text = "fn add(a: i64, b: i64) -> f64:\n    a + b\n\nfn hello() -> text:\n    \"hi\"\n"

fn entry_with(iface: text) -> SmfManifestEntry:
    smf_manifest_entry_new_with_iface("/tmp/x.spl", "/tmp/x.smf", 7, "cranelift", 0, false, true, false, "dev", [], iface)

describe "interface_digest_of_source contract":
    # @manual scenario evidence
    it "is deterministic for the same source":
        # @req REQ-SSPEC-COMPILER
        step("is deterministic for the same source")
        expect(interface_digest_of_source(SRC_A)).to_equal(interface_digest_of_source(SRC_A))

    it "changes when a fn signature changes":
        # @req REQ-SSPEC-COMPILER
        step("changes when a fn signature changes")
        expect(interface_digest_of_source(SRC_A) == interface_digest_of_source(SRC_A_SIG_EDIT)).to_equal(false)

    it "is unchanged when only a fn body changes":
        # @req REQ-SSPEC-COMPILER
        step("is unchanged when only a fn body changes")
        expect(interface_digest_of_source(SRC_A)).to_equal(interface_digest_of_source(SRC_A_BODY_EDIT))

    it "extracts only declaration headers as parts":
        # @req REQ-SSPEC-COMPILER
        step("extracts only declaration headers as parts")
        val parts = source_interface_parts(SRC_A)
        expect(parts.len()).to_equal(2)
        expect(parts[0]).to_equal("fn add(a: i64, b: i64) -> i64:")

    it "matches interface_digest_of over the extracted parts":
        # @req REQ-SSPEC-COMPILER
        step("matches interface_digest_of over the extracted parts")
        expect(interface_digest_of_source(SRC_A)).to_equal(interface_digest_of(source_interface_parts(SRC_A)))

describe "smf_manifest_entry_iface_verdict":
    it "returns match when recorded digest equals recomputed":
        # @req REQ-SSPEC-COMPILER
        step("returns match when recorded digest equals recomputed")
        val v = smf_manifest_entry_iface_verdict(entry_with(interface_digest_of_source(SRC_A)), SRC_A)
        expect(iface_digest_verdict_text(v)).to_equal("match")

    it "returns mismatch when the interface changed since compile":
        # @req REQ-SSPEC-COMPILER
        step("returns mismatch when the interface changed since compile")
        val v = smf_manifest_entry_iface_verdict(entry_with(interface_digest_of_source(SRC_A)), SRC_A_SIG_EDIT)
        expect(iface_digest_verdict_text(v)).to_equal("mismatch")
        expect(iface_digest_gate_code(v)).to_equal("SMF-E-IFACE-MISMATCH")

    it "still matches when only a body changed (that is the point)":
        # @req REQ-SSPEC-COMPILER
        step("still matches when only a body changed (that is the point)")
        val v = smf_manifest_entry_iface_verdict(entry_with(interface_digest_of_source(SRC_A)), SRC_A_BODY_EDIT)
        expect(iface_digest_verdict_text(v)).to_equal("match")

    it "returns absent for an old row with no recorded digest":
        # @req REQ-SSPEC-COMPILER
        step("returns absent for an old row with no recorded digest")
        val v = smf_manifest_entry_iface_verdict(entry_with(""), SRC_A)
        expect(iface_digest_verdict_text(v)).to_equal("absent")
        expect(iface_digest_gate_code(v)).to_equal("SMF-E-IFACE-MISSING")

    it "returns absent when the live source is unreadable (fail closed on evidence)":
        # @req REQ-SSPEC-COMPILER
        step("returns absent when the live source is unreadable (fail closed on evidence)")
        val v = smf_manifest_entry_iface_verdict(entry_with(interface_digest_of_source(SRC_A)), "")
        expect(iface_digest_verdict_text(v)).to_equal("absent")

describe "manifest round-trip carries the digest additively":
    it "serializes and re-parses iface_digest":
        # @req REQ-SSPEC-COMPILER
        step("serializes and re-parses iface_digest")
        val d = interface_digest_of_source(SRC_A)
        var m = smf_manifest_new()
        m = smf_manifest_update(m, entry_with(d))
        val m2 = smf_manifest_from_sdn(smf_manifest_to_sdn(m))
        val entry = smf_manifest_find(m2, "/tmp/x.spl")
        expect(entry.?).to_be(true)
        expect(entry.unwrap().iface_digest).to_equal(d)

    it "rejects an old 11-column row instead of inventing identity fields":
        # @req REQ-SSPEC-COMPILER
        step("rejects an old 11-column row instead of inventing identity fields")
        val old_row = "entries |source_path, smf_path, source_hash, compiled_at, backend, opt_level, release, debug_info, gc_off, profile, allowed_families|\n    \"/tmp/y.spl\", \"/tmp/y.smf\", 5, 1, \"cranelift\", 0, 0, 1, 0, \"dev\", \"\""
        val m = smf_manifest_from_sdn("smf_manifest:\n  version: 3\n  updated_at: 1\n\n" + old_row)
        expect(smf_manifest_find(m, "/tmp/y.spl") == nil).to_equal(true)
