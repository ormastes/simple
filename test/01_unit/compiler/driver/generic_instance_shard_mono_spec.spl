# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/native_file_worker_v1.spl 0%
"""
# Generic instance shard path mono selection (PR2)

Test the mono selection logic for the shard MIR route that runs module-scoped
mono on claimed shards instead of global mono, controlled by file_worker_active
and shard_active flags with SIMPLE_BOOTSTRAP_WHOLE_PROGRAM opt-out.
"""

# @tag:unit
# @tag:compiler
# @tag:generics
# @tag:driver

use std.spec
use compiler.driver.driver_build.native_file_worker_v1.{
    mono_module_scoped_selected_shard_v1,
    mono_module_scoped_selected_v1
}

describe "mono_module_scoped_selected_shard_v1":
    it "shard active with no whole_program flag selects module-scoped mono":
        val result = mono_module_scoped_selected_shard_v1(false, true, "")
        expect(result).to_equal(true)

    it "file_worker active with no whole_program flag selects module-scoped mono":
        val result = mono_module_scoped_selected_shard_v1(true, false, "")
        expect(result).to_equal(true)

    it "both file_worker and shard active with no whole_program flag selects module-scoped mono":
        val result = mono_module_scoped_selected_shard_v1(true, true, "")
        expect(result).to_equal(true)

    it "neither file_worker nor shard active selects global mono":
        val result = mono_module_scoped_selected_shard_v1(false, false, "")
        expect(result).to_equal(false)

    it "shard active with whole_program=1 forces global mono":
        val result = mono_module_scoped_selected_shard_v1(false, true, "1")
        expect(result).to_equal(false)

    it "file_worker active with whole_program=1 forces global mono":
        val result = mono_module_scoped_selected_shard_v1(true, false, "1")
        expect(result).to_equal(false)

    it "whole_program env with any non-1 value still selects module-scoped when active":
        val result = mono_module_scoped_selected_shard_v1(true, false, "some-other-value")
        expect(result).to_equal(true)

describe "mono_module_scoped_selected_v1 backward compatibility":
    it "file_worker active with no whole_program selects module-scoped":
        val result = mono_module_scoped_selected_v1("", true)
        expect(result).to_equal(true)

    it "file_worker inactive with no whole_program selects global":
        val result = mono_module_scoped_selected_v1("", false)
        expect(result).to_equal(false)

    it "file_worker active with whole_program=1 forces global mono":
        val result = mono_module_scoped_selected_v1("1", true)
        expect(result).to_equal(false)
