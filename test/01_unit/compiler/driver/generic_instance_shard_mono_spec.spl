# @req REQ-SSPEC-COMPILER
"""
# Generic instance shard route (PR2)

Plain MIR shards do not run scoped mono yet: mono selection stays whole-program
unless admitted target paths exist. The shard route shares the pre-link instance
step with the file-worker pool, but retires no COMDAT copies (may_retire=false),
so an instance failure never blocks its link and no retire record is written.
"""

# @tag:unit
# @tag:compiler
# @tag:generics
# @tag:driver

use std.spec
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{dir_create_all, file_write}
use app.io.time_ops.{time_now_unix_micros}
use compiler.driver.cache.generic_specialization_list_v1.{RequiredSpecializationV1, GenericSpecializationListV1}
use compiler.driver.driver_build.native_file_worker_instances_v1.{prelink_instances_run_v1,
    prelink_instances_blocks_link_v1, prelink_instances_writes_retire_v1}
use compiler.driver.driver_build.native_file_worker_v1.{mono_module_scoped_selected_v1}


fn spec_of(key: text) -> RequiredSpecializationV1:
    RequiredSpecializationV1(template_symbol: "pkg_a.Pair", template_id: "t:Pair", args_id: "a:" + key,
        arg_keys: [key], concrete_key: key)

fn list_of(keys: [text]) -> GenericSpecializationListV1?:
    var specs: [RequiredSpecializationV1] = []
    for k in keys:
        specs.push(spec_of(k))
    Some(GenericSpecializationListV1(complete: true, specs: specs))

fn fresh_root(tag: text) -> text:
    val root = "build/test_tmp/pr2_" + tag + "_" + "{time_now_unix_micros()}"
    val _ok = dir_create_all(root)
    root

fn obj(s: RequiredSpecializationV1) -> text:
    val dir = "build/test_tmp/pr2_objs"
    val _ok = dir_create_all(dir)
    val path = dir + "/" + sha256_text(s.concrete_key) + ".o"
    val _w = file_write(path, "OBJ:" + s.concrete_key)
    path

describe "mono_module_scoped_selected_v1":
    it "a plain shard (no ONLY_PATHS) leaves whole-program selection unchanged":
        expect(mono_module_scoped_selected_v1("", false)).to_equal(false)
        expect(mono_module_scoped_selected_v1("some-other-value", false)).to_equal(false)

    it "file_worker active with no whole_program selects module-scoped":
        val result = mono_module_scoped_selected_v1("", true)
        expect(result).to_equal(true)

    it "file_worker inactive with no whole_program selects global":
        val result = mono_module_scoped_selected_v1("", false)
        expect(result).to_equal(false)

    it "file_worker active with whole_program=1 forces global mono":
        val result = mono_module_scoped_selected_v1("1", true)
        expect(result).to_equal(false)

describe "shared pre-link instance step (prelink_instances_run_v1)":
    it "builds needed minus present and reuses present objects":
        val root = fresh_root("diff")
        val (_p1, first) = prelink_instances_run_v1([list_of(["k:a"])], root + "/cache", "producer-1",
            root + "/ledger-0", "owner-0", obj)
        expect(first.complete).to_equal(true)
        expect(first.built).to_equal(["k:a"])
        val (p2, second) = prelink_instances_run_v1([list_of(["k:a", "k:b"])], root + "/cache", "producer-1",
            root + "/ledger-1", "owner-1", obj)
        expect(p2.build).to_equal(["k:b"])
        expect(second.built).to_equal(["k:b"])
        expect(second.link_objects.len()).to_equal(2)
        val (_p3, third) = prelink_instances_run_v1([list_of(["k:a", "k:b"])], root + "/cache", "producer-1",
            root + "/ledger-2", "owner-2", obj)
        expect(third.built.len()).to_equal(0)
        expect(third.link_objects.len()).to_equal(2)

    it "an incomplete plan builds nothing and keeps the COMDAT copies":
        val root = fresh_root("inc")
        val inc: GenericSpecializationListV1? = Some(GenericSpecializationListV1(complete: false,
            specs: [spec_of("k:a")]))
        val (_p, run) = prelink_instances_run_v1([inc], root + "/cache", "producer-1",
            root + "/ledger-0", "owner-0", obj)
        expect(run.complete).to_equal(false)
        expect(run.built.len()).to_equal(0)
        expect(run.link_objects.len()).to_equal(0)
        expect(run.retire_comdat).to_equal(false)

describe "shard route may_retire=false":
    it "an instance failure is non-blocking for the shard route":
        expect(prelink_instances_blocks_link_v1(false, false)).to_equal(false)
        expect(prelink_instances_blocks_link_v1(false, true)).to_equal(false)

    it "the retiring file-worker pool is still blocked by an instance failure":
        expect(prelink_instances_blocks_link_v1(true, false)).to_equal(true)
        expect(prelink_instances_blocks_link_v1(true, true)).to_equal(false)

    it "no retire record is written without may_retire":
        expect(prelink_instances_writes_retire_v1(false)).to_equal(false)
        expect(prelink_instances_writes_retire_v1(true)).to_equal(true)
