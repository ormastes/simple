"""Stage-3 post-HIR boundary diagnostics remain ordered and complete."""

use std.spec.{describe, it, expect, step}
use std.io.{file_read}

val HIR_LOWERING = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
val HIR_SUPPORT = "src/compiler/80.driver/driver_hir_pipeline_support.spl"

describe "Stage3 post-HIR boundary diagnostics":
    # @manual scenario evidence
    it "identifies every operation after the final HIR module":
        # @req REQ-SSPEC-COMPILER
        step("loads the owning HIR pipeline source")
        val source = file_read(HIR_LOWERING)

        step("keeps ordered markers around each post-loop crash boundary")
        val loop_done = source.index_of("phase3:hir:loop:done")
        val cache_done = source.index_of("phase3:hir:cache-summary:done")
        val shard_done = source.index_of("phase3:hir:shard-gate:done")
        val poison_start = source.index_of("phase3:hir:poison-owner-read:start")
        val poison_done = source.index_of("phase3:hir:poison-owner-read:done")
        val commit_start = source.index_of("phase3:hir:context-commit:start")
        val commit_done = source.index_of("phase3:hir:context-commit:done")
        val validation_start = source.index_of("phase3:hir:layout-validation:start")
        val validation_done = source.index_of("phase3:hir:layout-validation:done")
        val reclaim_start = source.index_of("phase3:hir:owner-reclaim:start")
        val reclaim_done = source.index_of("phase3:hir:owner-reclaim:done")

        expect(loop_done).to_be_greater_than(0)
        expect(cache_done).to_be_greater_than(loop_done)
        expect(shard_done).to_be_greater_than(cache_done)
        expect(poison_start).to_be_greater_than(shard_done)
        expect(poison_done).to_be_greater_than(poison_start)
        expect(commit_start).to_be_greater_than(poison_done)
        expect(commit_done).to_be_greater_than(commit_start)
        expect(validation_start).to_be_greater_than(commit_done)
        expect(validation_done).to_be_greater_than(validation_start)
        expect(reclaim_start).to_be_greater_than(validation_done)
        expect(reclaim_done).to_be_greater_than(reclaim_start)

    # @manual scenario evidence
    it "identifies the validator that fails after HIR":
        # @req REQ-SSPEC-COMPILER
        step("loads the validation dispatcher source")
        val source = file_read(HIR_SUPPORT)

        step("keeps ordered start and completion evidence for every validator")
        val value_start = source.index_of("phase3:validation:value-struct:start")
        val value_done = source.index_of("phase3:validation:value-struct:done")
        val layer_start = source.index_of("phase3:validation:layer-eq:start")
        val layer_done = source.index_of("phase3:validation:layer-eq:done")
        val effects_start = source.index_of("phase3:validation:effects:start")
        val effects_done = source.index_of("phase3:validation:effects:done")
        val aspects_start = source.index_of("phase3:validation:aspects:start")
        val aspects_done = source.index_of("phase3:validation:aspects:done")
        val weave_start = source.index_of("phase3:validation:weave:start")
        val weave_done = source.index_of("phase3:validation:weave:done")

        expect(value_start).to_be_greater_than(0)
        expect(value_done).to_be_greater_than(value_start)
        expect(layer_start).to_be_greater_than(value_done)
        expect(layer_done).to_be_greater_than(layer_start)
        expect(effects_start).to_be_greater_than(layer_done)
        expect(effects_done).to_be_greater_than(effects_start)
        expect(aspects_start).to_be_greater_than(effects_done)
        expect(aspects_done).to_be_greater_than(aspects_start)
        expect(weave_start).to_be_greater_than(aspects_done)
        expect(weave_done).to_be_greater_than(weave_start)
