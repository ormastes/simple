use std.spec.*
use compiler.driver.driver_source_loading.{_driver_resolve_entry_import}

describe "physical T32 module resolution":
    it "resolves the app alias when checkout symlinks are unavailable":
        val resolved = _driver_resolve_entry_import("app.t32_cli.mod", "src/app/cli")
        expect(resolved == "examples/10_tooling/trace32_tools/t32_cli/mod.spl" or resolved == "src/app/t32_cli/mod.spl").to_equal(true)

    it "resolves an imported function through its containing module":
        val resolved = _driver_resolve_entry_import("app.t32_cli.mod.t32_cli_main", "src/app/cli")
        expect(resolved == "examples/10_tooling/trace32_tools/t32_cli/mod.spl" or resolved == "src/app/t32_cli/mod.spl").to_equal(true)

    it "does not treat a similarly named module as the T32 alias":
        val resolved = _driver_resolve_entry_import("app.t32_cli_missing.mod", "src/app/cli")
        expect(resolved == "examples/10_tooling/trace32_tools/t32_cli/mod.spl" or resolved == "src/app/t32_cli/mod.spl").to_equal(false)
