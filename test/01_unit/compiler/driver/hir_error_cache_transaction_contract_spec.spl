use std.spec.*
use std.spec.step
use std.file.{file_read}

describe "poisoned HIR cache publication":
    it "returns before the cache store on a fatal diagnostic budget":
        step("guards the transactional cache publication ordering")
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl") ?? ""
        val poison = source.index_of("driver_hir_diagnostic_budget_exhausted(self.ctx.error_count_value)") ?? -1
        val store = source.index_of("if hir_cache_store(hir_cache_key_value, hir_module, hir_module_warnings)") ?? -1
        expect(poison).to_be_greater_than(0)
        expect(store).to_be_greater_than(poison)
        expect(source).to_contain("return (self.ctx, false)")
