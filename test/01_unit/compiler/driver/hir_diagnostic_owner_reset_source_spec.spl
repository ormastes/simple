use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "HIR diagnostic owner reset source contract":
    it "preserves and clears stable diagnostic handles across modules":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/types.spl") ?? ""

        expect(source).to_contain("self.errors.clear()")
        expect(source).to_contain("self.diagnostic_messages.clear()")
        expect(source).to_contain("self.diagnostic_recovered.clear()")
        expect(source).to_not_contain("val preserved_errors = self.errors")
        expect(source).to_not_contain("val preserved_diagnostic_messages = self.diagnostic_messages")
        expect(source).to_not_contain("val preserved_diagnostic_recovered = self.diagnostic_recovered")
        expect(source).to_not_contain("self.errors = fresh.errors")
        expect(source).to_not_contain("self.diagnostic_messages = fresh.diagnostic_messages")
        expect(source).to_not_contain("self.diagnostic_recovered = fresh.diagnostic_recovered")
