# @req REQ-SSPEC-UNIT

use std.spec.*
use std.spec.step
use std.io_runtime.{
    cwd_process, dir_create_all, dir_remove_all,
    file_read_nullable, file_write_exact
}

describe "compiler host nullable file reads":
    it "preserves missing, empty, and populated file results":
        # @req REQ-SSPEC-UNIT
        val root = cwd_process() + "/build/test/compiler-host-nullable-read"
        dir_remove_all(root)
        expect(dir_create_all(root)).to_equal(true)

        step("A missing file produces nil, not empty content")
        expect(file_read_nullable(root + "/missing")).to_be_nil()

        step("An existing empty file remains distinguishable from a missing file")
        expect(file_write_exact(root + "/empty", "")).to_equal(true)
        val empty_content = file_read_nullable(root + "/empty")
        expect(empty_content != nil).to_equal(true)
        expect(empty_content ?? "<missing>").to_equal("")

        step("A populated file retains its exact content")
        expect(file_write_exact(root + "/content", "source-v1")).to_equal(true)
        val content = file_read_nullable(root + "/content")
        expect(content ?? "<missing>").to_equal("source-v1")
        dir_remove_all(root)
