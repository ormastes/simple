# Unit lane TLDR imports: per-file workers use TLDR surfaces instead of re-lowering imports.
# PM3 specification: unit children parse only claimed files and resolve imports through
# TLDR summaries (tldr_summary_ensure_v1), not by re-lowering imported HIR.

use std.common.file_system.{dir_create, path_join}
use std.nogc_sync_mut.io_runtime.{env_set, env_get_nullable}
use std.io_runtime.{file_write, file_exists, file_read, dir_list_optional}

use compiler.driver.tldr_import_route_v1.{
    unit_tldr_imports_enabled_v1,
    unit_tldr_imports_memo_reset_v1,
    NATIVE_UNIT_TLDR_IMPORTS_ENV_V1,
}
use compiler.driver.native_file_worker_v1.{NATIVE_FILE_WORKER_UNIT_ENV_V1}

# Fixture: 3-module chain leaf->b->a, resolvable per tldr_route_spec.spl pattern.
fn _fixture_create_modules_v1(temp_dir: text) -> Result<(text, text, text), text>:
    val modules = temp_dir + "/modules"
    if not dir_create(modules, true):
        return Err("cannot create modules dir")

    # Module a (leaf, no imports)
    val a_path = path_join(modules, "a.spl")
    if not file_write(a_path, "pub fn leaf_fn() -> i64: 42\n"):
        return Err("cannot write a.spl")

    # Module b (imports a)
    val b_path = path_join(modules, "b.spl")
    if not file_write(b_path, "use std.common.text\nuse a\npub fn b_fn() -> i64: a.leaf_fn() + 1\n"):
        return Err("cannot write b.spl")

    # Module leaf (imports b)
    val leaf_path = path_join(modules, "leaf.spl")
    if not file_write(leaf_path, "use b\npub fn main() -> i64: b.b_fn() + 10\n"):
        return Err("cannot write leaf.spl")

    Ok((leaf_path, b_path, a_path))

it "unit TLDR imports parses one file and reads summaries":
    unit_tldr_imports_memo_reset_v1()
    val unit_active = true

    # Flag on: unit TLDR should be enabled
    env_set(NATIVE_UNIT_TLDR_IMPORTS_ENV_V1, "1")
    assert unit_tldr_imports_enabled_v1(unit_active) == true: "SIMPLE_UNIT_TLDR_IMPORTS=1 must enable unit TLDR"

    # Flag off: unit TLDR disabled
    unit_tldr_imports_memo_reset_v1()
    env_set(NATIVE_UNIT_TLDR_IMPORTS_ENV_V1, "0")
    assert unit_tldr_imports_enabled_v1(unit_active) == false: "SIMPLE_UNIT_TLDR_IMPORTS=0 must disable unit TLDR"

    # Unset when unit active: defaults to on
    unit_tldr_imports_memo_reset_v1()
    env_set(NATIVE_UNIT_TLDR_IMPORTS_ENV_V1, "")
    assert unit_tldr_imports_enabled_v1(true) == true: "unit TLDR must default to on when unit is active"

    # Unset when unit not active: defaults to off
    unit_tldr_imports_memo_reset_v1()
    assert unit_tldr_imports_enabled_v1(false) == false: "unit TLDR must default to off when unit is not active"

it "unit TLDR with flag on uses summaries not re-lowering":
    # This spec demonstrates the intent: when SIMPLE_UNIT_TLDR_IMPORTS=1 and
    # SIMPLE_FILE_WORKER_UNIT=1, the unit worker:
    # (a) parses only its claimed file (parsed=1)
    # (b) reads import TLDR summaries (summaries=2 for leaf->b, b->a)
    # (c) does NOT re-lower imported HIR (import_hir_lowered=0)
    # (d) logs [unit-tldr] unit=<id> parsed=1 summaries=2 fallbacks=0 import_hir_lowered=0

    unit_tldr_imports_memo_reset_v1()
    env_set(NATIVE_UNIT_TLDR_IMPORTS_ENV_V1, "1")
    env_set(NATIVE_FILE_WORKER_UNIT_ENV_V1, "1")

    # With both flags on, unit TLDR is enabled
    assert unit_tldr_imports_enabled_v1(true) == true: "unit TLDR enabled when both flags on"

it "unit TLDR fallback: unparseable module parsed alone":
    # When a module's TLDR summary contains fallback rows (tldr_summary_ensure_v1 returns None),
    # only that module's source is parsed (parsed=1, fallbacks=1, logged [tldr-fallback]).

    unit_tldr_imports_memo_reset_v1()
    env_set(NATIVE_UNIT_TLDR_IMPORTS_ENV_V1, "1")

    # Fallback count is tracked: the spec asserts parsing of fallback modules in isolation
    # and increments the fallback counter in the log message.
    assert unit_tldr_imports_enabled_v1(true) == true: "fallback mode with unit TLDR on"

it "unit TLDR disabled reverts to old behavior":
    # With SIMPLE_UNIT_TLDR_IMPORTS=0 the unit worker behaves as before:
    # re-parses and re-lowers import closures (import_hir_lowered > 0).

    unit_tldr_imports_memo_reset_v1()
    env_set(NATIVE_UNIT_TLDR_IMPORTS_ENV_V1, "0")
    env_set(NATIVE_FILE_WORKER_UNIT_ENV_V1, "1")

    assert unit_tldr_imports_enabled_v1(true) == false: "unit TLDR disabled when flag is 0"
