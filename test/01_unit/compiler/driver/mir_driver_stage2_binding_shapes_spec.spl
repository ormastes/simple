use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

# Phase-3 stage3 bootstrap: the frozen stage2 (ef0681fc0e1) mis-lowers two
# source shapes in the driver modules it compiles:
#  - bug stage2_if_val_struct_option_binding_as_int_wide_2026-11-03:
#    `if val x = <struct-typed Option>` binds x through rt_value_as_int_wide.
#  - bug stage2_inline_env_get_boxed_extern_abi_2026-11-03: the inlined
#    std.env.env_get passes the boxed text to rt_env_get(ptr, len).
# These specs pin the rewritten shapes so neither can silently return.

describe "driver_pipeline_lowering binds struct-typed optionals through annotated unwrap":
    it "has no struct-typed `if val` binding left on the MIR path":
        val src = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(src).not_to_contain("if val present_bootstrap_enum_hir = ")
        expect(src).not_to_contain("if val present_enum_hir = ")
        expect(src).not_to_contain("if val prelower_hir = ")
        expect(src).not_to_contain("if val present_direct_hir = ")
        expect(src).not_to_contain("if val entry_mir = ")
        expect(src).not_to_contain("if val span = err.span")
        expect(src).not_to_contain("if val reused = file_worker_inc_reuse_lookup_v1")

    it "rebinds each site with an explicit nil check and an annotated unwrap":
        val src = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(src).to_contain("val present_enum_hir: HirModule = enum_inventory_hir.unwrap()")
        expect(src).to_contain("val present_bootstrap_enum_hir: HirModule = bootstrap_enum_hir.unwrap()")
        expect(src).to_contain("val prelower_hir: HirModule = prelower_hir_opt.unwrap()")
        expect(src).to_contain("val present_direct_hir: HirModule = direct_hir.unwrap()")
        expect(src).to_contain("val entry_mir: MirModule = entry_mir_opt.unwrap()")
        expect(src).to_contain("val span: Span = err_span_opt.unwrap()")

describe "driver env reads go through the non-inline io_runtime wrapper":
    it "driver_aot_native_output reads SIMPLE_M4_WORK_RECEIPT through env_get_nullable":
        val src = file_read("src/compiler/80.driver/driver_aot_native_output.spl")
        expect(src).to_contain("env_get_nullable(\"SIMPLE_M4_WORK_RECEIPT\")")
        expect(src).not_to_contain("env_get(\"SIMPLE_M4_WORK_RECEIPT\")")

    it "driver_bootstrap no longer imports the always-inline std.env.env_get":
        val src = file_read("src/compiler/80.driver/driver_bootstrap.spl")
        # Brace-free needles: `{name}` inside a literal is interpolation.
        expect(src).not_to_contain("use std.env.")
        expect(src).to_contain("use std.nogc_sync_mut.io_runtime.")
        expect(src).to_contain("fn env_get(key: text) -> text:")
        expect(src).to_contain("env_get_nullable(key) ?? \"\"")
