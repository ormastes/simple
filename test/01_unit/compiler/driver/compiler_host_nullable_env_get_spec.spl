# @req REQ-SSPEC-UNIT

use std.spec.*
use std.spec.step
use std.io_runtime.{env_get_nullable, env_set}
use std.nogc_sync_mut.env.variables.{env_unset}

describe "compiler host nullable environment reads":
    it "preserves unset, explicitly empty, and populated values":
        # @req REQ-SSPEC-UNIT
        val key = "SIMPLE_TEST_COMPILER_HOST_NULLABLE_ENV"
        val original = env_get_nullable(key)

        step("An unset variable produces nil")
        env_unset(key)
        expect(env_get_nullable(key)).to_be_nil()

        step("An explicitly empty variable remains present")
        expect(env_set(key, "")).to_equal(true)
        val empty_value = env_get_nullable(key)
        expect(empty_value != nil).to_equal(true)
        expect(empty_value ?? "<missing>").to_equal("")

        step("A populated variable retains its exact value")
        expect(env_set(key, "route-v1")).to_equal(true)
        expect(env_get_nullable(key) ?? "<missing>").to_equal("route-v1")

        if original == nil:
            env_unset(key)
        else:
            env_set(key, original!)
