# @req REQ-IM-005 REQ-IM-006 REQ-IM-016
# Complete witnesses and provider identities remain part of receipt authority.
use std.spec.{describe, it, expect}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.mir.mir_data.{MirModule}

fn cache_authority_fixture() -> CompileContext:
    val ctx = CompileContext.create(driver_core_compile_options_default())
    ctx.mir_modules["cache_authority"] = MirModule(
        name: "cache_authority", functions: {}, statics: {}, constants: {},
        types: {})
    val storage_identity = ctx.freeze_storage_registry()
    expect(storage_identity == "invalid").to_equal(false)
    ctx

describe "cached native capsule authority":
    it "reconstructs emission authority without dropping complete facts":
        val ctx = cache_authority_fixture()
        val emitted = ctx.freeze_native_module_capsules_v1(
            ["cache_authority"], "/tmp/simple-cache-authority", "cranelift",
            "aarch64-unknown-linux-gnu", "", 0, false, "provider-v1",
            {"cache_authority": "complete-witness-v1"},
            {"cache_authority": "ok"})
        val reconstructed = ctx.freeze_native_module_capsules_v1(
            ["cache_authority"], "/tmp/simple-cache-authority", "cranelift",
            "aarch64-unknown-linux-gnu", "", 0, false, "provider-v1",
            {"cache_authority": "complete-witness-v1"},
            {"cache_authority": "ok"})
        expect(emitted.ok).to_equal(true)
        expect(reconstructed.ok).to_equal(true)
        expect(reconstructed.find("cache_authority").capsule_identity).to_equal(
            emitted.find("cache_authority").capsule_identity)
        for changed in [
            ctx.freeze_native_module_capsules_v1(
                ["cache_authority"], "/tmp/simple-cache-authority", "cranelift",
                "aarch64-unknown-linux-gnu", "", 0, false),
            ctx.freeze_native_module_capsules_v1(
                ["cache_authority"], "/tmp/simple-cache-authority", "cranelift",
                "aarch64-unknown-linux-gnu", "", 0, false, "provider-v2",
                {"cache_authority": "complete-witness-v1"},
                {"cache_authority": "ok"}),
            ctx.freeze_native_module_capsules_v1(
                ["cache_authority"], "/tmp/simple-cache-authority", "cranelift",
                "aarch64-unknown-linux-gnu", "", 0, false, "provider-v1",
                {"cache_authority": "changed-witness-v2"},
                {"cache_authority": "ok"})]:
            expect(changed.ok).to_equal(true)
            expect(changed.find("cache_authority").capsule_identity ==
                emitted.find("cache_authority").capsule_identity).to_equal(false)
