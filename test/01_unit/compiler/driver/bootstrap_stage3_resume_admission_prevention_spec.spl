"""
## Purpose and audience
Purpose: Prevent regressions in stage-3 Darwin RSS admission cap and non-Linux process-tree ancestor exclusion.
Audience: Release and bootstrap engineers maintaining stage-3 memory admission.
"""
# @cover scripts/bootstrap/resume-stage3-from-admitted.sh
# @cover scripts/check/lib/bootstrap-stage3/memory-admission.shs
# @req REQ-COMPFIX-10

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

fn read_source_text(path: text) -> text:
    match rt_file_read_text(path):
        case Some(content): content
        case None: ""

describe "Bootstrap stage-3 resume memory admission guard":
    it "raises Darwin process-tree RSS cap to 11 GiB without reverting to 6835937":
        step("Verify resume-stage3-from-admitted.sh Darwin cap constants")
        val resume_script = read_source_text("scripts/bootstrap/resume-stage3-from-admitted.sh")

        expect(resume_script.contains("6835937")).to_equal(false)
        expect(resume_script).to_contain("11534336")

    it "excludes invoking shell ancestor PIDs in non-Linux ps admission snapshots":
        step("Verify memory-admission.shs computes and filters bootstrap_stage3_memory_ancestors")
        val admission = read_source_text("scripts/check/lib/bootstrap-stage3/memory-admission.shs")

        expect(admission).to_contain("bootstrap_stage3_memory_ancestors")
        expect(admission).to_contain("case \"$bootstrap_stage3_memory_ancestors\" in")
