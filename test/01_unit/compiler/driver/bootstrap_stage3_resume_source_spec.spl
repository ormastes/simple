extern fn rt_file_read_text(path: text) -> text

describe "Stage 3 admitted recovery wrapper":
    it "fails closed and resumes into the canonical one-thread Stage 3 lane":
        val source = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val wrapper = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        expect(source).to_contain("SIMPLE_NATIVE_BUILD_THREADS=1")
        expect(source).to_contain("--threads 1")
        expect(source).to_contain("bootstrap_stage3_run_transcribed")
        expect(source).to_contain("path=$(bootstrap_stage3_transcript_host_value \"$stage2_transcript\" PATH)")
        expect(source).to_contain("[ \"$stage2_sha\" = \"$admitted_sha\" ]")
        expect(source).to_contain("cmp -s \"$source_before\" \"$source_after\"")
        expect(source).to_contain("Build complete: [0-9]+ compiled")
        expect(source).to_contain("BSTAGE3_MANIFEST=$manifest")
        expect(source).to_contain("bootstrap_stage3_write_manifest")
        expect(source).to_contain("bootstrap_stage3_verify_manifest \"$manifest\" \"$root\" \"$candidate\"")
        expect(source).to_contain("manifest=\"$stage3/provenance.env\"")
        expect(source).to_contain("Stage 3 compiler exited successfully without an executable candidate")
        expect(source).to_contain("[ \"$status\" -ne 0 ]")
        expect(wrapper).to_contain("--resume-stage3-from-admitted=*")
        expect(wrapper).to_contain("Stage 3 resume permits only --jobs=1")
