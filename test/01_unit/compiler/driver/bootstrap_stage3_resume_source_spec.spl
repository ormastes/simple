extern fn rt_file_read_text(path: text) -> text

describe "Stage 3 admitted recovery wrapper":
    it "fails closed and resumes with bounded authoritative build jobs":
        val source = rt_file_read_text("scripts/bootstrap/resume-stage3-from-admitted.sh") ?? ""
        val wrapper = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        expect(source).to_contain("bootstrap_build_jobs_resolve")
        expect(source).to_contain("SIMPLE_NATIVE_BUILD_THREADS=\"$jobs\"")
        expect(source).to_contain("--threads \"$jobs\"")
        expect(source).to_contain("bootstrap_build_jobs_write_receipt")
        expect(source).to_contain("bootstrap_stage3_run_transcribed")
        expect(source).to_contain("path=$(bootstrap_stage3_transcript_host_value \"$stage2_transcript\" PATH)")
        expect(source).to_contain("[ \"$stage2_sha\" = \"$admitted_sha\" ]")
        expect(source).to_contain("resume_source_check=\"$archive/source-preflight.$$\"")
        expect(source).to_contain("bootstrap_stage3_source_snapshot \"$resume_source_check\" \"$root\"")
        expect(source).to_contain("bootstrap_stage3_git_state \"$root\" \"$resume_git_check\"")
        expect(source).to_contain("cmp -s \"$source_before\" \"$resume_source_check\"")
        expect(source).to_contain("cmp -s \"$git_before\" \"$resume_git_check\"")
        expect(source).to_contain("resume_tool_check=\"$archive/tool-preflight.$$\"")
        expect(source).to_contain("resume_lock_owned=0")
        expect(source).to_contain("if [ \"$resume_lock_owned\" = 1 ]; then")
        expect(source).to_contain("resume_lock_owned=1")
        expect(source).to_contain("trap resume_cleanup EXIT")
        expect(source).to_contain("trap 'exit 129' HUP")
        expect(source).to_contain("rmdir \"$lock\" 2>/dev/null || true")
        expect(source).to_not_contain("rm -rf \"$lock\"")
        expect(source).to_contain("archive_root=\"$stage3/recovery-threads1\"")
        expect(source).to_contain("archive=$(mktemp -d \"$archive_root/attempt.XXXXXX\")")
        expect(source).to_contain("bootstrap_stage3_retain_candidate()")
        expect(source).to_contain("schema=simple-bootstrap-stage3-candidate-retention-v1")
        expect(source).to_contain("bootstrap_stage3_retain_candidate \"$candidate\" previous")
        expect(source).to_contain("if bootstrap_stage3_retain_candidate \"$candidate\" failed; then")
        expect(source).to_contain("resume_retention_failed=1")
        expect(source).to_contain("candidate_created=1")
        expect(source).to_contain("candidate_created=0")
        expect(source).to_contain("trap '' HUP INT TERM")
        expect(source).to_not_contain("trap resume_cleanup EXIT HUP INT TERM")
        expect(source).to_contain("\"$git_before\" \\")
        expect(source).to_contain("bootstrap_stage3_tool_authority_snapshot \"$resume_tool_check\" \"$path\" \"$root\"")
        expect(source).to_contain("cmp -s \"$tool_before\" \"$resume_tool_check\"")
        expect(source).to_contain("immutable bindings, never a fresh resume")
        expect(source).to_not_contain("bootstrap_stage3_source_snapshot \"$source_before\" \"$root\"")
        expect(source).to_not_contain("bootstrap_stage3_git_state \"$root\" \"$git_before\"")
        expect(source).to_contain("cmp -s \"$source_before\" \"$source_after\"")
        expect(source).to_contain("Build complete: [0-9]+ compiled")
        expect(source).to_contain("BSTAGE3_MANIFEST=$manifest")
        expect(source).to_contain("bootstrap_stage3_write_manifest")
        expect(source).to_contain("bootstrap_stage3_verify_manifest \"$manifest\" \"$root\" \"$candidate\"")
        expect(source).to_contain("manifest=\"$stage3/provenance.env\"")
        expect(source).to_contain("Stage 3 compiler exited successfully without an executable candidate")
        expect(source).to_contain("[ \"$status\" -ne 0 ]")
        expect(wrapper).to_contain("--resume-stage3-from-admitted=*")
        expect(wrapper).to_contain("exec sh \"$(dirname -- \"$0\")/resume-stage3-from-admitted.sh\"")
        expect(wrapper).to_contain("--jobs=\"" + r"${bootstrap_build_jobs_requested}" + "\"")
        expect(wrapper).to_contain("bootstrap_build_jobs_resolve")
