extern fn rt_file_read_text(path: text) -> text

describe "Stage 3 admitted recovery wrapper":
    it "fails closed and preserves a separate one-thread provenance lane":
        val source = rt_file_read_text("scripts/bootstrap/resume-stage3-from-admitted.sh") ?? ""
        val wrapper = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        expect(source).to_contain("SIMPLE_NATIVE_BUILD_THREADS=1")
        expect(source).to_contain("--threads 1")
        expect(source).to_contain("bootstrap_stage3_run_transcribed")
        expect(source).to_contain("stage2_admitted_sha256")
        expect(source).to_contain("cmp -s \"$lane/source-before.txt\" \"$lane/source-after.txt\"")
        expect(source).to_contain("Build complete: [0-9]+ compiled")
        expect(wrapper).to_contain("--resume-stage3-from-admitted=*")
        expect(wrapper).to_contain("Stage 3 resume permits only --jobs=1")
