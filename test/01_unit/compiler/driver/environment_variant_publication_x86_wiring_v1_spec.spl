use std.spec.*
use std.io_runtime.file_read
use compiler.driver.environment_variant_composite_publication_v1.{
    EnvironmentCompositePublicationErrorV1}

describe "environment variant x86 publication wiring V1":
    it "routes exact x86 and device facts before canonical artifact admission":
        val source = file_read(
            "src/compiler/80.driver/environment_variant_composite_publication_v1.spl")
        val catalog_at = source.index_of("environment_variant_catalog_create_canonical_v1(")
        val exact_at = source.index_of(
            "_environment_composite_select_exact_v1(", catalog_at)
        val admission_at = source.index_of(
            "environment_publication_admit_canonical_v1(", exact_at)
        expect(catalog_at).to_be_greater_than(0)
        expect(exact_at).to_be_greater_than(catalog_at)
        expect(admission_at).to_be_greater_than(exact_at)
        expect(source).to_contain(
            "x86_variant_select_admitted_with_devices_v1(")
        expect(source).to_contain(
            "snapshot, feature_words, projection, catalog, gpu_devices")
        expect(EnvironmentCompositePublicationErrorV1.CompositeSelectionFailed ==
            EnvironmentCompositePublicationErrorV1.CanonicalAdmissionFailed).to_be(false)
