use std.spec.*
use compiler.driver.canonical_target_registry_owner_v2.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.target_codegen_profile_v1.*

fn target_digest_ctr2(value: u64) -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: value, w1: 0u64, w2: 0u64, w3: 0u64)

fn x86_profile_ctr2() -> TargetCodegenProfileV1:
    TargetCodegenProfileV1(
        descriptor_size: TARGET_CODEGEN_PROFILE_DESCRIPTOR_BYTES_V1,
        schema_version: TARGET_CODEGEN_PROFILE_SCHEMA_V1,
        profile_identity: target_digest_ctr2(1u64),
        target_identity: target_digest_ctr2(2u64),
        target_architecture: ENV_ARCH_X86_64_V1,
        target_abi_id: 1u32, target_object_format_id: 1u32,
        target_endian_id: 1u16, target_pointer_width_bits: 64u16,
        requested_features: EnvironmentFeatureSetV1(
            architecture: ENV_ARCH_X86_64_V1,
            words: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32)),
        strict_requested_features: true,
        backend_identity: target_digest_ctr2(3u64),
        semantic_identity: target_digest_ctr2(4u64),
        numerical_contract_id: 1u32)

describe "canonical target registry owner V2":
    it "binds a live profile to canonical registry content across aliases and owners":
        val owner = canonical_target_registry_owner_v2(81u64).unwrap()
        val alias = canonical_target_registry_resolve_v2(owner,
            "amd64-unknown-linux-gnu").unwrap()
        val canonical = canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu").unwrap()
        val alias_use = canonical_target_registry_acquire_use_v2(owner, alias).unwrap()
        val canonical_use = canonical_target_registry_acquire_use_v2(owner, canonical).unwrap()
        val profile = x86_profile_ctr2()
        val first = canonical_target_registry_bind_profile_v2(owner, alias_use,
            profile, [1u64]).unwrap()
        val second = canonical_target_registry_bind_profile_v2(owner, canonical_use,
            profile, [1u64]).unwrap()
        expect(first.canonical_target_triple).to_equal("x86_64-unknown-linux-gnu")
        expect(first.mapping_digest).to_equal(owner.candidate.mapping_digest)
        expect(first.profile_binding_digest).to_equal(second.profile_binding_digest)
        val other = canonical_target_registry_owner_v2(82u64).unwrap()
        val other_resolution = canonical_target_registry_resolve_v2(other,
            "x86_64-unknown-linux-gnu").unwrap()
        val other_use = canonical_target_registry_acquire_use_v2(other, other_resolution).unwrap()
        val other_binding = canonical_target_registry_bind_profile_v2(other, other_use,
            profile, [1u64]).unwrap()
        expect(other_binding.profile_binding_digest).to_equal(first.profile_binding_digest)
        val different_features = canonical_target_registry_bind_profile_v2(owner,
            alias_use, profile, [2u64]).unwrap()
        expect(different_features.profile_binding_digest == first.profile_binding_digest).to_be(false)
        var mismatch = profile
        mismatch.target_abi_id = 2u32
        expect(canonical_target_registry_bind_profile_v2(owner, alias_use,
            mismatch, [1u64])).to_equal(Err(CanonicalTargetRegistryErrorV2.InvalidTargetProfile))
        expect(canonical_target_registry_release_v2(owner, alias_use).is_ok()).to_be(true)
        expect(canonical_target_registry_bind_profile_v2(owner, alias_use,
            profile, [1u64])).to_equal(Err(CanonicalTargetRegistryErrorV2.StaleToken))
        expect(canonical_target_registry_release_v2(owner, canonical_use).is_ok()).to_be(true)
        expect(canonical_target_registry_release_v2(other, other_use).is_ok()).to_be(true)

    it "keeps a pinned profile bound to its original registry generation":
        val owner = canonical_target_registry_owner_v2(91u64).unwrap()
        val old = canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu").unwrap()
        val old_use = canonical_target_registry_acquire_use_v2(owner, old).unwrap()
        val profile = x86_profile_ctr2()
        val old_binding = canonical_target_registry_bind_profile_v2(owner, old_use,
            profile, [1u64]).unwrap()
        expect(canonical_target_registry_replace_v2(owner, owner.candidate,
            owner.aliases).is_ok()).to_be(true)
        val retained = canonical_target_registry_bind_profile_v2(owner, old_use,
            profile, [1u64]).unwrap()
        expect(retained.profile_binding_digest).to_equal(old_binding.profile_binding_digest)
        val current = canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu").unwrap()
        val current_use = canonical_target_registry_acquire_use_v2(owner, current).unwrap()
        val current_binding = canonical_target_registry_bind_profile_v2(owner, current_use,
            profile, [1u64]).unwrap()
        expect(current_binding.profile_binding_digest == old_binding.profile_binding_digest).to_be(false)
        expect(canonical_target_registry_release_v2(owner, old_use).is_ok()).to_be(true)
        expect(canonical_target_registry_release_v2(owner, current_use).is_ok()).to_be(true)

    it "binds aliases into owner-issued resolution and use tokens":
        val owner = canonical_target_registry_owner_v2(101u64).unwrap()
        val resolution = canonical_target_registry_resolve_v2(owner,
            "amd64-unknown-linux-gnu").unwrap()
        val use_token = canonical_target_registry_acquire_use_v2(owner, resolution).unwrap()
        val projected = canonical_target_registry_project_v2(owner, use_token).unwrap()
        expect(projected.target_profile_id).to_equal(1u32)
        expect(projected.supplied_target_triple).to_equal("amd64-unknown-linux-gnu")
        expect(projected.canonical_target_triple).to_equal("x86_64-unknown-linux-gnu")
        expect(canonical_target_registry_release_v2(owner, use_token).is_ok()).to_be(true)

    it "rejects cross-owner tokens and duplicate release":
        val first = canonical_target_registry_owner_v2(201u64).unwrap()
        val second = canonical_target_registry_owner_v2(202u64).unwrap()
        val resolution = canonical_target_registry_resolve_v2(first,
            "x86_64-unknown-linux-gnu").unwrap()
        expect(canonical_target_registry_acquire_use_v2(second, resolution)).to_equal(
            Err(CanonicalTargetRegistryErrorV2.CrossOwner))
        val use_token = canonical_target_registry_acquire_use_v2(first, resolution).unwrap()
        expect(canonical_target_registry_release_v2(first, use_token).is_ok()).to_be(true)
        expect(canonical_target_registry_release_v2(first, use_token)).to_equal(
            Err(CanonicalTargetRegistryErrorV2.DuplicateRelease))

    it "reuses released use records without reauthorizing stale tokens":
        val owner = canonical_target_registry_owner_v2(251u64).unwrap()
        val resolution = canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu").unwrap()
        val first = canonical_target_registry_acquire_use_v2(owner, resolution).unwrap()
        expect(canonical_target_registry_release_v2(owner, first).is_ok()).to_be(true)
        expect(canonical_target_registry_release_v2(owner, first)).to_equal(
            Err(CanonicalTargetRegistryErrorV2.DuplicateRelease))
        var current = canonical_target_registry_acquire_use_v2(owner, resolution).unwrap()
        expect(current.use_serial > first.use_serial).to_be(true)
        expect(canonical_target_registry_project_v2(owner, first)).to_equal(
            Err(CanonicalTargetRegistryErrorV2.StaleToken))
        for i in 0..CANONICAL_TARGET_REGISTRY_MAX_USES_V2:
            expect(canonical_target_registry_release_v2(owner, current).is_ok()).to_be(true)
            current = canonical_target_registry_acquire_use_v2(owner, resolution).unwrap()
        expect(canonical_target_registry_project_v2(owner, current).is_ok()).to_be(true)
        expect(canonical_target_registry_release_v2(owner, current).is_ok()).to_be(true)

    it "drains pinned generations and retires them after final release":
        val owner = canonical_target_registry_owner_v2(301u64).unwrap()
        val old = canonical_target_registry_resolve_v2(owner,
            "arm64-unknown-linux-gnu").unwrap()
        val use_token = canonical_target_registry_acquire_use_v2(owner, old).unwrap()
        expect(canonical_target_registry_replace_v2(owner, owner.candidate,
            owner.aliases).is_ok()).to_be(true)
        expect(canonical_target_registry_resolution_state_v2(owner, old).unwrap()).to_equal(
            CanonicalTargetRegistryStateV2.Draining)
        expect(canonical_target_registry_acquire_use_v2(owner, old)).to_equal(
            Err(CanonicalTargetRegistryErrorV2.Draining))
        expect(canonical_target_registry_project_v2(owner, use_token).is_ok()).to_be(true)
        expect(canonical_target_registry_release_v2(owner, use_token).is_ok()).to_be(true)
        expect(canonical_target_registry_resolution_state_v2(owner, old).unwrap()).to_equal(
            CanonicalTargetRegistryStateV2.Retired)

    it "prevents ABA substitution and fails closed on unknown targets":
        val owner = canonical_target_registry_owner_v2(401u64).unwrap()
        val old = canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu").unwrap()
        expect(canonical_target_registry_replace_v2(owner, owner.candidate,
            owner.aliases).is_ok()).to_be(true)
        val current = canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu").unwrap()
        expect(current.owner_generation).to_equal(2u64)
        expect(current.serial == old.serial).to_be(false)
        expect(current.binding_digest == old.binding_digest).to_be(false)
        expect(canonical_target_registry_acquire_use_v2(owner, old)).to_equal(
            Err(CanonicalTargetRegistryErrorV2.Draining))
        expect(canonical_target_registry_resolve_v2(owner,
            "x86_64-pc-windows-msvc")).to_equal(
                Err(CanonicalTargetRegistryErrorV2.UnknownTargetTriple))

    it "fails closed before serial or generation overflow":
        var owner = canonical_target_registry_owner_v2(501u64).unwrap()
        owner.next_serial = 0xffffffffffffffffu64
        expect(canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu")).to_equal(
                Err(CanonicalTargetRegistryErrorV2.SerialOverflow))
        owner = canonical_target_registry_owner_generation_v2(
            502u64, 0xffffffffffffffffu64).unwrap()
        expect(canonical_target_registry_replace_v2(owner, owner.candidate,
            owner.aliases)).to_equal(Err(CanonicalTargetRegistryErrorV2.GenerationOverflow))

    it "bounds unresolved resolution records":
        val owner = canonical_target_registry_owner_v2(601u64).unwrap()
        for i in 0..CANONICAL_TARGET_REGISTRY_MAX_RESOLUTIONS_V2:
            expect(canonical_target_registry_resolve_v2(owner,
                "x86_64-unknown-linux-gnu").is_ok()).to_be(true)
        expect(canonical_target_registry_resolve_v2(owner,
            "x86_64-unknown-linux-gnu")).to_equal(
                Err(CanonicalTargetRegistryErrorV2.CapacityExceeded))
