# Actual parser/HIR/MIR regressions. Execution status: UNRUN.
use std.spec
use std.common.crypto.sha256.{sha256_text}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserModule}
use compiler.core.parser.{par_had_error_get}
use compiler.hir.hir_lowering.module_surface_declarations.{ModuleSurfaceParserOwner}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction, HirBlock}
use compiler.mono.monomorphize_integration.{run_monomorphization}
use compiler.driver.driver_native_objectless_proof.{driver_native_parser_can_persist_objectless}
use compiler.driver.driver_types.{driver_native_parsed_module_has_no_runtime_body_v1,
    driver_native_parsed_objectless_proof_v1, driver_native_parsed_objectless_proof_valid_v1}
use compiler.driver.driver_aot_native_output.{driver_native_module_is_export_facade}
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}

val TEMPLATE_ENUM = "enum Poll<T>:\n    Ready(T)\n    Pending\n\nimpl Poll<T>:\n    fn is_ready() -> bool:\n        match self:\n            case Poll.Ready(_): true\n            case Poll.Pending: false\n"

fn enum_template_parse(source: text) -> ParserModule:
    val parsed = parse_full_frontend(source, "template.spl", "template", Logger(level: 0))
    expect(par_had_error_get()).to_equal(false)
    parsed

fn enum_template_candidate(source: text) -> bool:
    val parsed = enum_template_parse(source)
    val persistent = driver_native_parser_can_persist_objectless(ModuleSurfaceParserOwner.new(parsed))
    # Cold proof capture and retained-parser scheduling share the same rule.
    expect(driver_native_parsed_module_has_no_runtime_body_v1(parsed)).to_equal(persistent)
    persistent

fn enum_template_mir(source: text) -> MirModule:
    val parsed = enum_template_parse(source)
    var lowering = HirLowering.with_filename("template.spl")
    val hir = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    expect(mir_lowering.errors.len()).to_equal(0)
    mir

fn enum_template_specialized_mir() -> MirModule:
    val source = TEMPLATE_ENUM + "\nfn selected() -> bool:\n    val value: Poll<bool> = Poll.Ready(true)\n    value.is_ready()\n"
    val parsed = enum_template_parse(source)
    var lowering = HirLowering.with_filename("template.spl")
    val hir = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    var modules: Dict<text, HirModule> = {}
    modules["template"] = hir
    val (specialized, stats) = run_monomorphization(modules)
    expect(stats.specializations_created).to_be_greater_than(0)
    expect(stats.unresolved_generic_calls).to_equal(0)
    val concrete: HirModule = specialized["template"]
    var mir_lowering = MirLowering.new(concrete.symbols)
    val mir = mir_lowering.lower_module(concrete)
    expect(mir_lowering.errors.len()).to_equal(0)
    expect(mir.functions.len()).to_be_greater_than(1)
    mir

describe "generic enum templates have no standalone native unit":
    it "retains the actual method body as a HIR template before empty MIR admission":
        val parsed = enum_template_parse(TEMPLATE_ENUM)
        expect(parsed.impls.len()).to_equal(1)
        expect(parsed.impls[0].type_params.len()).to_equal(1)
        expect(parsed.impls[0].methods.len()).to_equal(1)
        var lowering = HirLowering.with_filename("template.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var templates = 0
        for key in hir.functions.keys():
            val function: HirFunction = hir.functions[key]
            val body: HirBlock = function.body
            expect(function.is_generic_template).to_equal(true)
            expect(body.stmts.len() > 0 or body.value != nil).to_equal(true)
            templates = templates + 1
        expect(templates).to_equal(1)
        var mir_lowering = MirLowering.new(hir.symbols)
        val mir = mir_lowering.lower_module(hir)
        expect(mir_lowering.errors.len()).to_equal(0)
        expect(mir.functions.len()).to_equal(0)
        expect(mir.statics.len()).to_equal(0)
        expect(mir.constants.len()).to_equal(0)
        expect(driver_native_module_is_export_facade(mir, parsed)).to_equal(true)
        expect(enum_template_candidate(TEMPLATE_ENUM)).to_equal(true)

    it "allows alpha-renamed positional owner parameters":
        val source = "enum Choice<T>:\n    Item(T)\nimpl Choice<U>:\n    fn present() -> bool: true\n"
        expect(enum_template_candidate(source)).to_equal(true)

    it "rejects concrete, nested, permuted and non-generic impl targets":
        for source in [
            "enum Choice<T>:\n    Item(T)\nimpl Choice<i64>:\n    fn present() -> bool: true\n",
            "enum Choice<T>:\n    Item(T)\nimpl<T> Choice<[T]>:\n    fn present() -> bool: true\n",
            "enum Pair<A, B>:\n    Item(A, B)\nimpl<A, B> Pair<B, A>:\n    fn present() -> bool: true\n",
            "enum Flag:\n    On\nimpl Flag:\n    fn present() -> bool: true\n"]:
            expect(enum_template_candidate(source)).to_equal(false)

    it "rejects imported owners, static methods and concrete free functions":
        for source in [
            "impl External<T>:\n    fn present() -> bool: true\n",
            "enum Choice<T>:\n    Item(T)\nimpl Choice<T>:\n    static fn present() -> bool: true\n",
            TEMPLATE_ENUM + "\nfn answer() -> i64: 42\n",
            TEMPLATE_ENUM + "\nval answer = 42\n"]:
            expect(enum_template_candidate(source)).to_equal(false)

    it "rejects trait impls and owner arity mismatches":
        for source in [
            "trait Present:\n    fn present() -> bool\nenum Choice<T>:\n    Item(T)\nimpl<T> Present for Choice<T>:\n    fn present() -> bool: true\n",
            "enum Pair<A, B>:\n    Item(A, B)\nimpl Pair<T>:\n    fn present() -> bool: true\n"]:
            expect(enum_template_candidate(source)).to_equal(false)

    it "retains the stricter persistent rejection of trait default bodies":
        val parsed = enum_template_parse(TEMPLATE_ENUM + "\ntrait Named:\n    fn name() -> text:\n        \"value\"\n")
        expect(driver_native_parser_can_persist_objectless(ModuleSurfaceParserOwner.new(parsed))).to_equal(false)

    it "binds omission to exact source ownership and final MIR":
        val identity = sha256_text(TEMPLATE_ENUM)
        val proof = driver_native_parsed_objectless_proof_v1("template", "template.spl", identity)
        val empty_mir = enum_template_mir(TEMPLATE_ENUM)
        expect(driver_native_parsed_objectless_proof_valid_v1(proof, "template", "template.spl", identity, empty_mir)).to_equal(true)
        expect(driver_native_parsed_objectless_proof_valid_v1(proof, "template", "other.spl", identity, empty_mir)).to_equal(false)
        expect(driver_native_parsed_objectless_proof_valid_v1(proof, "template", "template.spl", sha256_text("changed"), empty_mir)).to_equal(false)
        expect(driver_native_parsed_objectless_proof_valid_v1("", "template", "template.spl", identity, empty_mir)).to_equal(false)
        # Actual lowered code must not disappear merely because an earlier
        # declaration proof was true (e.g. a concrete specialization arrived).
        val concrete = enum_template_mir("fn answer() -> i64: 42\n")
        expect(concrete.functions.len()).to_be_greater_than(0)
        expect(driver_native_parsed_objectless_proof_valid_v1(proof, "template", "template.spl", identity, concrete)).to_equal(false)
        val specialized = enum_template_specialized_mir()
        expect(driver_native_parsed_objectless_proof_valid_v1(proof, "template", "template.spl", identity, specialized)).to_equal(false)

