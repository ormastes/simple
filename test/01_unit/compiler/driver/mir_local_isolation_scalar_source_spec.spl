"""
# MIR local isolation must not pass HirType? through staged-native ownership
# decisions. The owner-local scalar query reads aligned local metadata instead.
"""

extern fn rt_file_read_text(path: text) -> text

describe "MIR local isolation scalar query source contract":
    it "uses direct aligned metadata and removes optional isolation call paths":
        val types_source = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_types.spl") ?? ""
        val stmts_source = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        val function_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""
        val expr_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        expect(types_source).to_contain(
            "fn local_hir_type_isolation_state(local_id: i64) -> i64:")
        expect(types_source).to_contain(
            "local_hir_type_isolation_states: [i64]")
        expect(types_source).to_contain(
            "states[i] = isolation_state")
        expect(types_source).to_contain(
            "states.push(isolation_state)")
        expect(types_source).to_contain(
            "return self.local_hir_type_isolation_states[i]")
        expect(types_source).to_contain(
            "states.push(self.local_hir_type_isolation_states[i])")
        expect(types_source).to_not_contain(
            "match self.local_hir_type_values[i]:")
        expect(types_source).to_not_contain(
            "return self.local_hir_type_values[i]")
        expect(stmts_source).to_not_contain(
            "fn mir_hir_type_is_isolated(t: HirType?) -> bool:")
        expect(stmts_source).to_not_contain(
            "mir_hir_type_is_isolated(self.find_local_hir_type(")
        expect(function_source).to_not_contain(
            "mir_hir_type_is_isolated(self.find_local_hir_type(")
        expect(expr_source).to_not_contain(
            "mir_hir_type_is_isolated(self.find_local_hir_type(")
