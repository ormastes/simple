use std.spec.*
use compiler.driver.parser_llvm_readobj_codec_v1.PARSER_LLVM_READOBJ_JSON_MAX_BYTES_V1
use compiler.driver.parser_llvm_readobj_relocation_codec_v1.{
    parser_llvm_readobj_relocations_decode_v1, ParserLlvmRelocationCodecErrorV1
}
use compiler.driver.parser_llvm_readobj_group_codec_v1.{
    parser_llvm_readobj_groups_decode_v1, ParserLlvmGroupCodecErrorV1
}

describe "LLVM readobj JSON inspection input bounds":
    it "rejects output above the shared cap before parsing either projection":
        val oversized = " " * (PARSER_LLVM_READOBJ_JSON_MAX_BYTES_V1 + 1)
        expect(parser_llvm_readobj_relocations_decode_v1(oversized, "<stdin>")).to_equal(
            Err(ParserLlvmRelocationCodecErrorV1.ResourceLimit))
        expect(parser_llvm_readobj_groups_decode_v1(oversized, "<stdin>")).to_equal(
            Err(ParserLlvmGroupCodecErrorV1.ResourceLimit))

    it "rejects empty tool output before parsing either projection":
        expect(parser_llvm_readobj_relocations_decode_v1("", "<stdin>")).to_equal(
            Err(ParserLlvmRelocationCodecErrorV1.ResourceLimit))
        expect(parser_llvm_readobj_groups_decode_v1("", "<stdin>")).to_equal(
            Err(ParserLlvmGroupCodecErrorV1.ResourceLimit))
