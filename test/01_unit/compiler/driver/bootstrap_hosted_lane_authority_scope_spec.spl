# Defect-class spec with a POSITIVE CONTROL for the 2026-08-18 Stage 1 link
# failure. The fix must not degenerate into "authorise every rt_* symbol":
# the hosted authority stays scoped to the bootstrap entry, the hosted-only
# contract stays an explicit allowlist, and a symbol outside every authorised
# lane must STILL be rejected.
use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "bootstrap hosted lane authority scope":
    it "keeps the hosted authority scoped to the bootstrap entry":
        val config = file_read("src/compiler_rust/compiler/src/pipeline/native_project/config.rs")
        expect(config).to_contain("pub(super) fn is_bootstrap_main_entry(")
        expect(config).to_contain("if is_bootstrap_main_entry(&self.entry_file) {")
        # the core-c lane is still the default for everything else
        expect(config).to_contain("build_core_c_runtime_library")

    it "rejects a symbol outside every authorised lane (positive control)":
        val contract = file_read("scripts/check/bootstrap_hosted_only_externs.txt")
        val native_all = file_read("src/compiler_rust/native_all/src/lib.rs")
        val guard = file_read("scripts/check/check-bootstrap-entry-core-lane-abi.shs")
        expect(contract.contains("rt_definitely_not_core_abi")).to_equal(false)
        expect(native_all.contains("rt_definitely_not_core_abi")).to_equal(false)
        expect(guard).to_contain("neither core-defined nor on the hosted contract")
        # the allowlist names the one hosted-only symbol and nothing more
        expect(contract).to_contain("rt_native_build")
