use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.common.driver_core_types.{CompileOptions}
use compiler.driver.driver_types.{compute_options_hash}
use compiler.driver.cache.compile_options_hash.{compile_options_hash_validate}

describe "driver compile-options hash surface":
    it "resolves the public helper return type and computes default options":
        val result = compute_options_hash(CompileOptions.default())
        expect(result.hash == 0).to_equal(false)
        expect(result.backend_kind).to_equal(0)
        expect(result.opt_level).to_equal(0)
        expect(result.flags).to_equal(1)

    it "resolves the adjacent cache validation return type":
        val result = compute_options_hash(CompileOptions.default())
        val validation = compile_options_hash_validate(result, result)
        expect(validation.status).to_equal(0)
        expect(validation.detail).to_equal("fresh")

    it "keeps signature-visible types on module-scope direct owner imports":
        val driver_source = file_read("src/compiler/80.driver/driver_types.spl")
        val hash_source = file_read("src/compiler/80.driver/cache/compile_options_hash.spl")
        expect(driver_source).to_contain("use compiler.driver.cache.compile_options_hash.{CompileOptionsHash, compile_options_hash_compute}")
        expect(driver_source.contains("    use compiler.driver.cache.compile_options_hash.{CompileOptionsHash, compile_options_hash_compute}")).to_equal(false)
        expect(hash_source).to_contain("use compiler.driver.cache.cache_types.{CacheCheckResult, cache_check_result_fresh, cache_check_result_stale}")
        expect(hash_source.contains("    use compiler.driver.cache.cache_types.{CacheCheckResult, cache_check_result_fresh, cache_check_result_stale}")).to_equal(false)
