use compiler.common.bootstrap_low_memory_config.{bootstrap_low_memory_opt_ins_requested}
use std.spec.{describe, it, expect}

describe "bootstrap low-memory opt-in":
    it "requires all three exact bootstrap flags":
        expect(bootstrap_low_memory_opt_ins_requested("1", "1", "1")).to_equal(true)
        expect(bootstrap_low_memory_opt_ins_requested("", "1", "1")).to_equal(false)
        expect(bootstrap_low_memory_opt_ins_requested("0", "1", "1")).to_equal(false)
        expect(bootstrap_low_memory_opt_ins_requested("1", "", "1")).to_equal(false)
        expect(bootstrap_low_memory_opt_ins_requested("1", "0", "1")).to_equal(false)
        expect(bootstrap_low_memory_opt_ins_requested("1", "1", "")).to_equal(false)
        expect(bootstrap_low_memory_opt_ins_requested("1", "1", "0")).to_equal(false)
        expect(bootstrap_low_memory_opt_ins_requested("true", "1", "1")).to_equal(false)
