extern fn rt_file_read_text(path: text) -> text

describe "Stage 3 manifest command environment verification":
    it "reconstructs producer-only environment from canonical transcripts":
        val source = rt_file_read_text("scripts/check/lib/bootstrap-stage3/manifest-verify.shs") ?? ""
        val snapshot = rt_file_read_text("scripts/check/lib/bootstrap-stage3/command-snapshot.shs") ?? ""
        expect(snapshot).to_contain("bootstrap_stage3_transcript_explicit_env_value()")
        expect(source).to_contain("\"LIBRARY_PATH=$bootstrap_stage3_stage2_library_path\"")
        expect(source).to_contain("\"SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage2_link_compat\"")
        expect(source).to_contain("\"SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage2_progress\"")
        expect(source).to_contain("\"SIMPLE_NATIVE_ARENA_DECLS=$bootstrap_stage3_stage3_arena_decls\"")
        expect(source).to_contain("$bootstrap_stage3_manifest_output_root/bootstrap-build-progress.events")
