use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.native_layout_trace.{MirExternalLayoutTraceV1}
use compiler.frontend.parser_types.{ParserImport}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry_index.{
    module_surface_import_resolution_trace_v1}
use compiler.mir.mir_data.{MirModule}
use compiler.driver.cache.action_key.{ActionDep}
use compiler.driver.cache.native_module_witness.{
    NativeModuleConfigFactV1, native_module_cache_witness_v1,
    native_module_cache_witness_invalid_v1}
use compiler.driver.cache.native_module_witness_facts.{
    native_direct_dependency_facts_v1, native_resolution_facts_v1,
    native_external_layout_facts_from_mir_v1,
    native_module_cache_fact_set_invalid_v1,
    native_module_cache_fact_set_merge_v1}

fn complete_fact_surfaces() -> ModuleSurfacesByName:
    var consumer = ModuleSurface.empty("app.main")
    consumer.preferred_registry_name = "app.main"
    consumer.canonical_path = "src/app/main.spl"
    consumer.imports = [ParserImport(
        module: "lib.dep", items: [], is_lazy: false, span: Span.empty())]
    consumer.import_target_indices = [1]
    consumer.import_target_names = ["lib.dep"]
    var dependency = ModuleSurface.empty("lib.dep")
    dependency.preferred_registry_name = "lib.dep"
    dependency.canonical_path = "src/lib/dep.spl"
    var registry = ModuleSurfacesByName(
        surfaces: [consumer, dependency],
        index_by_name: {"app.main": 0, "lib.dep": 1},
        ordered_names: ["app.main", "lib.dep"],
        ordered_indices: [0, 1], generation: 1, frozen: true)
    consumer.import_resolution_traces = [
        module_surface_import_resolution_trace_v1(
            registry, consumer, "lib.dep")]
    registry.surfaces[0] = consumer
    registry

describe "native AOT complete module witness wiring":
    it "combines retained dependency resolution and MIR layout facts":
        val surfaces = complete_fact_surfaces()
        val dependencies = native_direct_dependency_facts_v1(
            "app.main", surfaces, [SourceFile(
                path: "src/lib/dep.spl",
                content: "pub struct External:\n    value: i64",
                module_name: "lib.dep")])
        val resolutions = native_resolution_facts_v1("app.main", surfaces)
        val module = MirModule(name: "app.main", functions: {}, statics: {},
            constants: {}, types: {}, external_layout_traces: [
                MirExternalLayoutTraceV1(
                    consumer_module_id: "app.main", owner_module_id: "lib.dep",
                    type_id: "External", layout_digest: "layout-v1",
                    owner_count: 1)])
        val layouts = native_external_layout_facts_from_mir_v1(module, true)
        val config = NativeModuleConfigFactV1(
            compiler_identity: "compiler-v1", target_identity: "x86_64",
            options_identity: "opt=2", provider_identity: "builtin-native")
        val complete_facts = native_module_cache_fact_set_merge_v1(
            dependencies, resolutions, layouts)
        # Keep this call receiver-free: native method dispatch can misclassify
        # the struct receiver ABI and trap before the witness fields are read.
        val witness = native_module_cache_witness_v1(
            complete_facts.module_id, "mir-v1", complete_facts.dependencies,
            complete_facts.resolutions, complete_facts.layouts, config)
        expect(dependencies.valid).to_equal(true)
        expect(resolutions.valid).to_equal(true)
        expect(layouts.valid).to_equal(true)
        expect(complete_facts.valid).to_equal(true)
        expect(witness.module_id).to_equal("app.main")
        expect(witness.valid).to_equal(true)
        expect(witness.dependency_fold == "").to_equal(false)
        expect(witness.resolution_fold == "").to_equal(false)
        expect(witness.cross_module_layout_fingerprint == "").to_equal(false)
        expect(witness.config_fingerprint == "").to_equal(false)
        val changed_dependency = native_module_cache_witness_v1(
            complete_facts.module_id, "mir-v1", [ActionDep(
                module_id: "lib.dep", iface_digest: "changed-interface")],
            complete_facts.resolutions, complete_facts.layouts, config)
        val changed_config = native_module_cache_witness_v1(
            complete_facts.module_id, "mir-v1", complete_facts.dependencies,
            complete_facts.resolutions, complete_facts.layouts,
            NativeModuleConfigFactV1(
                compiler_identity: "compiler-v1", target_identity: "aarch64",
                options_identity: "opt=2", provider_identity: "builtin-native"))
        expect(witness.dependency_fold == changed_dependency.dependency_fold).to_equal(false)
        expect(witness.config_fingerprint == changed_config.config_fingerprint).to_equal(false)

        val invalid_facts = native_module_cache_fact_set_merge_v1(
            native_module_cache_fact_set_invalid_v1(
                "app.main", "fixture-incomplete-complete-facts"),
            resolutions, layouts)
        expect(invalid_facts.valid).to_equal(false)
        # The driver must refuse an invalid merged fact set before entering the
        # free witness constructor; this is the receiver-ABI crash regression
        # fixture and must complete without a native trap.
        val refused = if not invalid_facts.valid:
            native_module_cache_witness_invalid_v1(invalid_facts.reason)
        else:
            native_module_cache_witness_v1(
                invalid_facts.module_id, "mir-v1", invalid_facts.dependencies,
                invalid_facts.resolutions, invalid_facts.layouts, config)
        expect(refused.valid).to_equal(false)
        expect(refused.reason).to_equal("fixture-incomplete-complete-facts")

        val wiring = file_read(
            "src/compiler/80.driver/driver_aot_native_output.spl")
        expect(wiring).to_contain("native_direct_dependency_facts_v1")
        expect(wiring).to_contain("native_resolution_facts_v1")
        expect(wiring).to_contain("native_external_layout_facts_from_mir_v1")
        expect(wiring).to_contain("native_module_cache_fact_set_merge_v1")
        expect(wiring).to_contain("module_cache_config")
        expect(wiring).to_contain("capsule.module_witness")

        val witness_start = wiring.index_of(
            "fn driver_native_shadow_witness_v1(")
        val witness_end = wiring.index_of(
            "fn driver_native_shadow_bounded_module", witness_start)
        val witness_body = wiring.slice(witness_start, witness_end)
        val free_call = witness_body.index_of(
            "native_module_cache_witness_v1(")
        expect(free_call).to_be_greater_than(-1)
        expect(witness_body.contains("complete_facts.witness(")).to_equal(false)
        val module_arg = witness_body.index_of(
            "complete_facts.module_id", free_call)
        val mir_arg = witness_body.index_of("mir_identity", module_arg)
        val dependencies_arg = witness_body.index_of(
            "complete_facts.dependencies", mir_arg)
        val resolutions_arg = witness_body.index_of(
            "complete_facts.resolutions", dependencies_arg)
        val layouts_arg = witness_body.index_of(
            "complete_facts.layouts", resolutions_arg)
        val config_arg = witness_body.index_of("config", layouts_arg)
        expect(module_arg).to_be_greater_than(free_call)
        expect(mir_arg).to_be_greater_than(module_arg)
        expect(dependencies_arg).to_be_greater_than(mir_arg)
        expect(resolutions_arg).to_be_greater_than(dependencies_arg)
        expect(layouts_arg).to_be_greater_than(resolutions_arg)
        expect(config_arg).to_be_greater_than(layouts_arg)
