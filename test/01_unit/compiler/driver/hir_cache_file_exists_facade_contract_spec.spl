"""
# HIR Cache File-Existence Facade Contract

The HIR cache uses the already-loaded `std.io.file_exists` boundary for its
three cache-entry probes. Two shard-marker probes already used that boundary.
Other runtime operations retain their distinct raw sentinel and mutation
contracts; this is a leaf migration, not a runtime-family removal claim.
"""

use std.spec.step
use std.io_runtime.{read_file_text}

describe "HIR cache file-existence facade ownership":
    it "uses the exact facade for three cache probes and two existing shard probes":
        step("Load the HIR cache source")
        val source = read_file_text("src/compiler/80.driver/driver_hir_cache.spl")

        step("Require the existing facade import and the three migrated probes")
        expect(source).to_contain("use std.io.{file_exists, file_write}")
        expect(source).to_contain("if closure_digest == \"\" or not file_exists(source_path):")
        expect(source).to_contain("key != \"\" and hir_cache_enabled() and file_exists(hir_cache_path(key))")
        expect(source).to_contain("if not file_exists(path):")

        step("Retain the two pre-existing shard-marker probes")
        expect(source).to_contain("if file_exists(marker):")
        expect(source).to_contain("if not file_exists(marker):")
        expect(source.split("file_exists(").len() - 1).to_equal(5)

        step("Reject duplicate raw ownership in this leaf")
        expect(source).to_not_contain("extern fn rt_file_exists")
        expect(source).to_not_contain("rt_file_exists(")

    it "keeps non-equivalent cache runtime operations direct":
        step("Load the HIR cache source")
        val source = read_file_text("src/compiler/80.driver/driver_hir_cache.spl")

        step("Preserve raw read, exact write, move, cleanup, and environment calls")
        expect(source).to_contain("extern fn rt_file_read_text(path: text) -> text")
        expect(source).to_contain("extern fn rt_file_write_text(path: text, content: text) -> bool")
        expect(source).to_contain("extern fn rt_file_move(src: text, dst: text) -> bool")
        expect(source).to_contain("extern fn rt_file_delete(path: text) -> bool")
        expect(source).to_contain("extern fn rt_env_get(key: text) -> text")
        expect(source).to_contain("if not rt_file_write_text(tmp, hir_cache_header()")
        expect(source).to_contain("if rt_file_move(tmp, final_path):")
        expect(source).to_contain("val _cleaned = rt_file_delete(tmp)")
