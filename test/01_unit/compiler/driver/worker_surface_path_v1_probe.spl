use compiler.driver.driver_worker_surface_path_v1.{worker_surface_path_suffix_v1}

fn main() -> i64:
    val paths = ["", "/", "//", "a", "a/", "/a", "a/b", "/a/b", "ba/b", "b", "ab", "/b", "//b", "a//b", "C:/src/a.spl", "src/a.spl", "a.spl", "C:\\src\\a.spl", "é/文", "文"]
    var checks = 0
    for raw_path in paths:
        for raw_suffix in paths:
            val path = raw_path.replace("\\", "/")
            val suffix = raw_suffix.replace("\\", "/")
            val expected = path.ends_with("/" + suffix)
            if worker_surface_path_suffix_v1(path, suffix) != expected:
                print "suffix mismatch path={path} suffix={suffix}"
                return 1
            checks = checks + 1
    if worker_surface_path_suffix_v1("/src/notmod.spl", "mod.spl"):
        return 2
    if not worker_surface_path_suffix_v1("/src/mod.spl", "mod.spl"):
        return 3
    if worker_surface_path_suffix_v1("mod.spl", "mod.spl"):
        return 4
    print "worker_surface_path_v1 checks={checks + 3} failures=0"
    0
