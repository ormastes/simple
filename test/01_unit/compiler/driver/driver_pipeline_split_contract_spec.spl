use std.spec
use std.io_runtime.{file_read}

describe "compiler driver pipeline split":
    it "keeps the facade small and registers every method owner":
        val facade = file_read("src/compiler/80.driver/driver_pipeline.spl")
        expect(facade.len()).to_be_less_than(1000)
        expect(facade).to_contain("use compiler.driver.driver_pipeline_lowering.*")
        expect(facade).to_contain("use compiler.driver.driver_pipeline_execution.*")
        expect(facade).to_contain("use compiler.driver.driver_pipeline_passes.*")
        expect(facade).to_contain("use compiler.driver.driver_pipeline_aop.*")

        val lowering = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(lowering).to_contain("fn _driver_collect_mir_errors")
        expect(lowering).to_contain("me lower_to_mir() -> bool")

        val execution = file_read("src/compiler/80.driver/driver_pipeline_execution.spl")
        expect(execution).to_contain("me jit_compile_and_run()")
        expect(execution).to_contain("me execute_smf()")
        expect(execution).to_contain("compiled.release_codegen_module()")

        val passes = file_read("src/compiler/80.driver/driver_pipeline_passes.spl")
        expect(passes).to_contain("me borrow_check() -> bool")
        expect(passes).to_contain("me process_async()")
        expect(passes).to_contain("me optimize_mir_level(level: i64)")
        expect(passes).to_contain("backend_name == \"vhdl\"")

        val aop = file_read("src/compiler/80.driver/driver_pipeline_aop.spl")
        expect(aop).to_contain("me weave_aop()")
        expect(aop).to_contain("me apply_debug_trace()")
        expect(aop).to_contain("aop_log_weaving_rules")
        expect(aop).to_contain("aop_weave_accounting_reset")
