# Purpose and audience: regression evidence for compiler bootstrap owners.
# @req REQ-SSPEC-COMPILER

use std.spec
use std.spec.step
use std.io_runtime.{file_read}

describe "explicit entry closure downstream gate":
    it "enables closure mode for the downstream parse HIR and MIR phases":
        step("inspect the closure completion boundary")
        val source = file_read(
            "src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val start = source.find(
            "# Every entry walk is now a closure") ?? -1
        val end = source.find(
            "# Add core source roots only when compiling project sources") ?? -1

        expect(start).to_be_greater_than(-1)
        expect(end).to_be_greater_than(start)

        val completion = source.substring(start, end)
        expect(completion).to_contain(
            "rt_env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"1\")")
        expect(completion).to_not_contain("if not explicit_entry_closure:")
