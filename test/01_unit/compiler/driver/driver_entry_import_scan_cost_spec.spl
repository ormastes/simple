"""
# Entry-closure import scan: per-line work is rejected early

Reproduce for doc/08_tracking/bug/native_build_per_file_driver_overhead_2026-08-21.md.

`_driver_entry_import_module_paths` runs once per file in the native-build entry
closure. Measured with SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING=1 on
`native-build --source src/app --entry-closure --entry src/app/cli/bootstrap_main.spl`
it cost 56.5 s over 1211 calls (46.7 ms each) — 62% of a 91 s `[build] source_closure`
phase that contains no parsing at all. The body ran a comment scan (contains + split
+ length), a triple-quote scan, a trim and four prefix tests on EVERY line, when only
lines whose trimmed form starts with a use/import keyword (or that carry a triple
quote) can affect the result.

Two properties are pinned. BEHAVIOUR: the returned module list must be unchanged
for imports, comments, docstrings, lazy forms, and the `pub use` / `export use` /
`import` spellings — the fast reject must not swallow a real import nor let a
commented one through. MECHANISM: the whole-content early-out and the per-line
fast reject must both be present, with the reject ahead of the comment scan.
(A wall-clock budget is deliberately NOT used — see check_fast_reject_is_wired.)
"""

use compiler.driver.driver_source_loading.{
    _driver_entry_import_module_paths,
    _driver_cached_entry_source_scan,
    _driver_collect_sources,
    driver_entry_scan_cache_release,
    driver_entry_scan_cache_reset,
    driver_entry_scan_cache_read_count,
    driver_entry_scan_cache_scan_count,
    driver_entry_scan_cache_hit_count
}
use app.io._CliCompile.native_build_closure.{_native_build_entry_closure}
use app.io.env_ops.{env_get, env_set}
use std.io_runtime.{read_file_text, file_write, dir_create}

fn _fixture_source() -> text:
    var lines: [text] = [
        "\"\"\"",
        "Module docstring. use std.not_an_import must be ignored here.",
        "\"\"\"",
        "use std.common.text",
        "pub use std.common.json",
        "export use std.common.sdn",
        "import std.common.math",
        "use lazy std.common.deferred",
        "use lazy std.common.named.{alpha, beta}",
        "# use std.common.commented",
        "use std.common.trailing  # trailing comment",
        "val x = 1  # use std.common.inline_comment"
    ]
    var i: i64 = 0
    while i < 1200:
        lines = lines.push("    val body_{i} = compute(body_{i}) + 1")
        i = i + 1
    lines.join("\n")

fn check_scan_behaviour() -> text:
    val found = _driver_entry_import_module_paths(_fixture_source())
    val joined = "|" + found.join("|") + "|"
    for wanted in ["std.common.text", "std.common.json", "std.common.sdn",
                   "std.common.math", "std.common.named", "std.common.trailing"]:
        if not joined.contains("|" + wanted + "|"):
            return "missing import '{wanted}' in {joined}"
    for unwanted in ["std.not_an_import", "std.common.commented",
                     "std.common.deferred", "std.common.inline_comment"]:
        if joined.contains("|" + unwanted + "|"):
            return "import '{unwanted}' must not be collected; got {joined}"
    ""

fn check_fast_reject_is_wired() -> text:
    """Pin the MECHANISM, not wall time.

    A wall-clock budget cannot discriminate here: run through the JIT (as a spec
    is) the fix measures 471 ms -> 303 ms over 8 scans of a 1212-line file, a
    1.55x gap far too narrow to threshold without flaking. The 4.6x that matters
    (56.5 s -> 12.4 s over 1209 calls) is paid by the INTERPRETED native-build
    worker, which a spec does not run in. So assert the structure that produces
    it, in the same idiom entry_closure_physical_source_dedup_spec.spl uses for
    the bucket set: the whole-content early-out, and a trimmed-line fast reject
    that returns BEFORE the comment scan on every non-import line."""
    val loading = read_file_text("src/compiler/80.driver/driver_source_loading.spl")
    if loading == "":
        return "could not read driver_source_loading.spl"
    if not loading.contains("if not content.contains(\"use \") and not content.contains(\"import \"):"):
        return "whole-content early-out missing from the import scan"
    if not loading.contains("val quick = raw_line.trim()"):
        return "per-line fast reject missing from the import scan"
    val reject_at = _spec_index_of(loading, "val quick = raw_line.trim()")
    val comment_at = _spec_index_of(loading, "val comment_at = _driver_text_index_of(scan_line, \"#\")")
    if reject_at < 0 or comment_at < 0:
        return "could not locate both the fast reject and the comment scan"
    if reject_at > comment_at:
        return "fast reject must precede the per-line comment scan"
    ""

fn _spec_index_of(haystack: text, needle: text) -> i64:
    if not haystack.contains(needle):
        return -1
    haystack.split(needle)[0].len()

fn _path_cache_probe_path() -> text:
    "build/test_tmp/closure_scan_memo/source.spl"

describe "entry-closure import scan":
    it "collects exactly the real imports":
        expect(check_scan_behaviour()).to_equal("")

    it "rejects non-import lines before doing per-line comment work":
        expect(check_fast_reject_is_wired()).to_equal("")

    it "memoizes normalized paths and releases payloads without losing counters":
        expect(dir_create("build/test_tmp/closure_scan_memo", true)).to_equal(true)
        expect(file_write(_path_cache_probe_path(), "use std.first\nmod local\n")).to_equal(true)
        driver_entry_scan_cache_reset()
        val first_path = "./" + _path_cache_probe_path()
        val alias_path = "build/test_tmp/closure_scan_memo/../closure_scan_memo/source.spl"

        val (first_content, first_imports, first_siblings, first_hit) =
            _driver_cached_entry_source_scan(first_path)
        val (second_content, second_imports, second_siblings, second_hit) =
            _driver_cached_entry_source_scan(alias_path)

        expect(first_content).to_equal(second_content)
        expect(first_hit).to_equal(false)
        expect(second_hit).to_equal(true)
        expect(first_imports).to_equal(["std.first"])
        expect(second_imports).to_equal(["std.first"])
        expect(first_siblings).to_equal([".local"])
        expect(second_siblings).to_equal([".local"])
        expect(driver_entry_scan_cache_read_count()).to_equal(1)
        expect(driver_entry_scan_cache_scan_count()).to_equal(1)
        expect(driver_entry_scan_cache_hit_count()).to_equal(1)

        # Phase-1 release must free the cached source payload. A same-path edit
        # is therefore read and scanned again, while diagnostics stay cumulative.
        driver_entry_scan_cache_release()
        expect(file_write(_path_cache_probe_path(), "use std.changed\n")).to_equal(true)
        val (changed_content, changed_imports, changed_siblings, changed_hit) =
            _driver_cached_entry_source_scan(alias_path)
        expect(changed_hit).to_equal(false)
        expect(changed_content).to_equal("use std.changed\n")
        expect(changed_imports).to_equal(["std.changed"])
        expect(changed_siblings).to_equal([])
        expect(driver_entry_scan_cache_read_count()).to_equal(2)
        expect(driver_entry_scan_cache_scan_count()).to_equal(2)
        expect(driver_entry_scan_cache_hit_count()).to_equal(1)

        # A following build reset also releases payloads and restarts counters.
        driver_entry_scan_cache_reset()
        expect(file_write(_path_cache_probe_path(), "use std.final\n")).to_equal(true)
        val (_, final_imports, _, final_hit) = _driver_cached_entry_source_scan(first_path)
        expect(final_hit).to_equal(false)
        expect(final_imports).to_equal(["std.final"])
        expect(driver_entry_scan_cache_read_count()).to_equal(1)
        expect(driver_entry_scan_cache_scan_count()).to_equal(1)
        expect(driver_entry_scan_cache_hit_count()).to_equal(0)
        driver_entry_scan_cache_release()

    it "shares one build-local scan across CLI BFS and driver phase 1":
        val dir = "build/test_tmp/closure_scan_memo_cross"
        val entry = dir + "/entry.spl"
        val dep = dir + "/dep.spl"
        val old_entry = env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
        val old_closure = env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? ""
        expect(dir_create(dir, true)).to_equal(true)
        expect(file_write(entry, "use dep\nfn main() -> i64:\n    1\n")).to_equal(true)
        expect(file_write(dep, "fn dep_value() -> i64:\n    2\n")).to_equal(true)
        driver_entry_scan_cache_reset()
        expect(env_set("SIMPLE_NATIVE_BUILD_ENTRY", entry)).to_equal(true)
        expect(env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "0")).to_equal(true)

        val closure = _native_build_entry_closure(entry, [dir])
        val bfs_reads = driver_entry_scan_cache_read_count()
        val bfs_scans = driver_entry_scan_cache_scan_count()
        val bfs_hits = driver_entry_scan_cache_hit_count()
        val entry_loaded = _driver_collect_sources(entry).len()
        val dep_loaded = _driver_collect_sources(dep).len()
        val phase1_reads = driver_entry_scan_cache_read_count()
        val phase1_scans = driver_entry_scan_cache_scan_count()
        val phase1_hits = driver_entry_scan_cache_hit_count()

        # Restore process-global mode and release payloads before assertions so
        # a failing expectation cannot contaminate a later same-process spec.
        val restored_entry = env_set("SIMPLE_NATIVE_BUILD_ENTRY", old_entry)
        val restored_closure = env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", old_closure)
        driver_entry_scan_cache_release()

        expect(restored_entry).to_equal(true)
        expect(restored_closure).to_equal(true)
        expect(closure).to_equal([entry, dep])
        expect(bfs_reads).to_equal(2)
        expect(bfs_scans).to_equal(2)
        expect(bfs_hits).to_equal(0)
        expect(entry_loaded).to_be_greater_than(0)
        expect(dep_loaded).to_be_greater_than(0)
        expect(phase1_reads).to_equal(2)
        expect(phase1_scans).to_equal(2)
        expect(phase1_hits).to_equal(2)

    it "wires cache reuse and release to the native-build phase-1 boundary":
        val driver = read_file_text("src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val native_build = read_file_text("src/app/io/_CliCompile/native_build_closure.spl")
        val compile_targets = read_file_text("src/app/io/_CliCompile/compile_targets.spl")
        val parse_shard = read_file_text("src/app/cli/parse_shard_main.spl")

        expect(driver).to_contain("val (_, closure_imports, _, _) = _driver_cached_entry_source_scan(closure_src.path)")
        expect(driver).to_contain("driver_entry_scan_cache_release()")
        expect(native_build).to_contain("val (content, imports, siblings, _) = _driver_cached_entry_source_scan(f)")
        expect(native_build).to_not_contain("var module_paths = _driver_entry_import_module_paths(content)")
        expect(compile_targets).to_contain("driver_entry_scan_cache_reset()")
        expect(parse_shard).to_contain("driver_entry_scan_cache_reset()")
