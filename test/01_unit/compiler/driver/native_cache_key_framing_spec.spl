# Gap scope_key_unframed (live_object_key.sdn) closed: every scope/producer
# component value is length-framed, so delimiter-bearing values cannot alias.
use std.spec
use compiler.driver.driver_build.incremental.{native_build_cache_scope_key, cache_key_frame}

describe "cache key framing":
    it "keeps feature lists and identities from aliasing across delimiters":
        val joined = native_build_cache_scope_key(
            Some("llvm"), nil, ["+a,+b"], 2, "compiler-a")
        val split = native_build_cache_scope_key(
            Some("llvm"), nil, ["+a", "+b"], 2, "compiler-a")
        assert_false(joined == split)
        val smuggled = native_build_cache_scope_key(
            Some("llvm"), nil, [], 2, "c;provider=x")
        val plain = native_build_cache_scope_key(
            Some("llvm"), nil, [], 2, "c")
        assert_false(smuggled == plain)
        expect(plain).to_contain("compiler=1:c;")

    it "frames by length":
        expect(cache_key_frame("a;b")).to_equal("3:a;b")
        expect(cache_key_frame("")).to_equal("0:")

    it "keeps the provider receipt visible":
        val scope = native_build_cache_scope_key(Some("llvm"), nil, [], 2, "c", "r1")
        expect(scope).to_contain("provider=10:receipt:r1")
