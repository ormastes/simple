use std.spec
use compiler.driver.driver_worker_surface_path_v1.{worker_surface_path_suffix_v1}

describe "worker surface path suffix without joined path allocation":
    it "preserves empty, root and component boundary semantics":
        expect(worker_surface_path_suffix_v1("", "")).to_equal(false)
        expect(worker_surface_path_suffix_v1("/", "")).to_equal(true)
        expect(worker_surface_path_suffix_v1("//", "/")).to_equal(true)
        expect(worker_surface_path_suffix_v1("/src/mod.spl", "mod.spl")).to_equal(true)
        expect(worker_surface_path_suffix_v1("/src/notmod.spl", "mod.spl")).to_equal(false)
        expect(worker_surface_path_suffix_v1("mod.spl", "mod.spl")).to_equal(false)

    it "preserves normalized Windows and UTF-8 paths":
        expect(worker_surface_path_suffix_v1("C:\\src\\a.spl".replace("\\", "/"), "src/a.spl")).to_equal(true)
        expect(worker_surface_path_suffix_v1("é/文", "文")).to_equal(true)
