use std.spec.*
use compiler.driver.x86_variant_admission_v1.*
use compiler.common.structural_contracts.environment_variant_catalog_policy_bridge_v1.*
use compiler.common.structural_contracts.environment_variant_composite_selector_v1.*
use compiler.common.structural_contracts.offload_profile.{OffloadMode, OffloadFallbackPolicy}
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.catalog_v1.*
use std.nogc_sync_mut.composition.environment_variants.feature_registry_v1.*
use std.nogc_sync_mut.composition.environment_variants.policy.*

fn d(value: u64) -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: value, w1: 0u64, w2: 0u64, w3: 0u64)

fn fs(offset: u32) -> EnvironmentFeatureSetV1:
    EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1,
        words: EnvironmentArenaRangeV1(offset: offset, count: 1u32))

fn mask(feature_id: u32) -> u64:
    environment_feature_registry_lookup_v2(feature_id).unwrap().feature_mask

fn descriptor(variant: u64, feature_offset: u32, os_offset: u32,
              width: u32, budget: u64) -> VariantDescriptorV1:
    VariantDescriptorV1(descriptor_size: 360u32,
        schema_version: ENV_VARIANT_SCHEMA_V1,
        placement: ENV_PLACEMENT_NATIVE_DYNLIB_V1,
        provider_identity: d(10u64), variant_identity: d(variant),
        contract_identity: d(20u64), contract_major: 1u16, contract_minor: 0u16,
        abi_digest: d(21u64), semantic_identity: d(22u64),
        grammar_identity: d(23u64), program_identity: d(24u64),
        artifact_digest: d(100u64 + variant),
        artifact_location: EnvironmentArenaRangeV1(offset: variant as u32, count: 1u32),
        target_architecture: ENV_ARCH_X86_64_V1,
        required_os_id: 1u32, required_abi_id: 1u32,
        required_object_format_id: 1u32, required_endian_id: 1u16,
        required_pointer_width_bits: 64u16, required_loader_permission_bits: 1u64,
        required_cpu_features: fs(feature_offset),
        required_os_state_words: if width == 0u32:
            EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)
        else:
            EnvironmentArenaRangeV1(offset: os_offset, count: 1u32),
        required_vector_state_mode: if width == 0u32: ENV_VECTOR_NONE_V1 else: ENV_VECTOR_FIXED_V1,
        required_vector_length_bits: width, required_device_api: 0u32,
        minimum_device_api_version: 0u32,
        required_device_features: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32),
        required_memory_domain_bits: 0u64, minimum_device_buffer_bytes: 0u64,
        minimum_workgroup_invocations: 0u32, minimum_queue_family_count: 0u32,
        required_effect_bits: 1u64, numerical_contract_id: 1u32,
        resource_layout_digest: d(9u64),
        dependencies: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32),
        assurance_receipt_digest: d(30u64 + variant), startup_budget_us: budget,
        max_session_bytes: 4096u64, max_inflight_operations: 1u32)

fn snapshot(policy_offset: u32, width: u32) -> EnvironmentSnapshotV1:
    EnvironmentSnapshotV1(descriptor_size: 232u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        execution_architecture: ENV_ARCH_X86_64_V1, os_id: 1u32, abi_id: 1u32,
        object_format_id: 1u32, endian_id: 1u16, pointer_width_bits: 64u16,
        snapshot_identity: d(1u64), snapshot_generation: 1u64,
        execution_domain_identity: d(2u64), hardware_features: fs(0u32),
        os_usable_features: fs(1u32), policy_allowed_features: fs(policy_offset),
        vector_state_mode: ENV_VECTOR_FIXED_V1, vector_length_bits: width,
        loader_permission_bits: 1u64, allowed_effect_bits: 1u64,
        numerical_contract_id: 1u32, resource_layout_digest: d(9u64),
        gpu_devices: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32))

fn projection(preferred: u64, required: bool, ceiling_offset: u32) -> EnvironmentVariantCatalogPolicyProjectionV1:
    val policy_text = "1111111111111111111111111111111111111111111111111111111111111111"
    val policy_digest = environment_variant_policy_digest256_v1(policy_text).unwrap()
    val cap = EnvironmentVariantCatalogPolicyRequestV1(mode: ENV_POLICY_MAX_V1,
        requested_provider: d(10u64), preferred_variant: d(0u64),
        max_architecture: ENV_ARCH_X86_64_V1, max_startup_budget_us: 1000u64,
        max_placement: ENV_PLACEMENT_NATIVE_DYNLIB_V1,
        max_feature_ceiling: fs(ceiling_offset))
    val choose = EnvironmentVariantCatalogPolicyRequestV1(
        mode: if required: ENV_POLICY_REQUIRE_V1 else: ENV_POLICY_PREFER_V1,
        requested_provider: d(10u64), preferred_variant: d(preferred),
        max_architecture: ENV_ARCH_X86_64_V1, max_startup_budget_us: 0u64,
        max_placement: 0u16, max_feature_ceiling: fs(ceiling_offset))
    EnvironmentVariantCatalogPolicyProjectionV1(cap_request: cap,
        selection_request: choose, frontend_offload: OffloadMode.CpuReference,
        frontend_offload_auto: false, frontend_fallback: OffloadFallbackPolicy.AllowCpu,
        explain_policy_digest: policy_text, binding_policy_digest: policy_digest)

fn catalog(rows: [VariantDescriptorV1], words: [u64]) -> EnvironmentVariantCatalogV1:
    environment_variant_catalog_create_v1(d(40u64), 1u64, d(41u64),
        512u32, words.len() as u32, rows, []).unwrap()

fn forged_catalog(rows: [VariantDescriptorV1], words: [u64]) -> EnvironmentVariantCatalogV1:
    EnvironmentVariantCatalogV1(catalog_digest: d(40u64), catalog_generation: 1u64,
        dependency_lock_digest: d(41u64), arena_byte_count: 512u32,
        feature_word_count: words.len() as u32, descriptors: rows, dependencies: [])

fn all_words(policy: u64) -> [u64]:
    val v4 = mask(ENV_FEATURE_X86_64_LEVEL4_V2)
    [v4, v4, policy,
     mask(ENV_FEATURE_X86_64_BASELINE_V2),
     mask(ENV_FEATURE_X86_64_LEVEL3_V2), v4]

describe "X86 admitted variant selection V1":
    it "keeps generic admission from treating a legacy V1 word as exact V2":
        val exact = mask(ENV_FEATURE_X86_64_BASELINE_V2)
        val legacy = environment_feature_registry_lookup_v1(
            ENV_FEATURE_X86_64_BASELINE_V1).unwrap().feature_mask
        val words = [exact, exact, exact, legacy]
        val rows = [descriptor(1u64, 3u32, 3u32, 0u32, 1u64)]
        val selected = environment_variant_catalog_select_composite_v1(
            catalog(rows, words), snapshot(2u32, 128u32), words, [],
            projection(1u64, false, 2u32)).unwrap()
        expect(selected.selection.selected_index).to_equal(-1)

    it "selects baseline without requiring any AVX state":
        val baseline = mask(ENV_FEATURE_X86_64_BASELINE_V2)
        val words = [baseline, baseline, baseline, baseline]
        val rows = [descriptor(1u64, 3u32, 3u32, 0u32, 1u64)]
        val selected = x86_variant_select_admitted_v1(snapshot(2u32, 128u32), words,
            projection(1u64, true, 2u32), catalog(rows, words)).unwrap()
        expect(selected.selection.selected_variant_identity).to_equal(d(1u64))

    it "falls from preferred v4 to admitted v3 under a v3 ceiling":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL3_V2))
        val rows = [descriptor(1u64, 3u32, 3u32, 0u32, 50u64),
                    descriptor(3u64, 4u32, 4u32, 256u32, 1u64),
                    descriptor(4u64, 5u32, 5u32, 512u32, 1u64)]
        val selected = x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(4u64, false, 2u32), catalog(rows, words)).unwrap()
        expect(selected.selection.selected_variant_identity).to_equal(d(3u64))
        expect(selected.preferred_fallback).to_equal(true)

    it "fails rather than falling back when v4 is required":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL3_V2))
        val rows = [descriptor(1u64, 3u32, 3u32, 0u32, 50u64),
                    descriptor(3u64, 4u32, 4u32, 256u32, 1u64),
                    descriptor(4u64, 5u32, 5u32, 512u32, 1u64)]
        expect(x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(4u64, true, 2u32), catalog(rows, words)))
            .to_equal(Err(X86VariantAdmissionErrorV1.RequiredVariantMissing))

    it "selects plain v4 without requiring VBMI or VBMI2":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL4_V2))
        val rows = [descriptor(4u64, 5u32, 5u32, 512u32, 1u64)]
        val selected = x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(4u64, true, 2u32), catalog(rows, words)).unwrap()
        expect(selected.selection.selected_variant_identity).to_equal(d(4u64))

    it "is deterministic when catalog input order changes":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL3_V2))
        val low = descriptor(2u64, 3u32, 3u32, 0u32, 5u64)
        val high = descriptor(1u64, 3u32, 3u32, 0u32, 5u64)
        val first = x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(0u64, false, 2u32), catalog([low, high], words)).unwrap()
        val second = x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(0u64, false, 2u32), catalog([high, low], words)).unwrap()
        expect(first.selection.selected_variant_identity)
            .to_equal(second.selection.selected_variant_identity)

    it "rejects partial v3 descriptors before generic ranking":
        var words = all_words(mask(ENV_FEATURE_X86_64_LEVEL4_V2))
        words[4] = words[4] ^ ENV_X86_FEATURE_BMI2_V2
        val rows = [descriptor(3u64, 4u32, 4u32, 256u32, 1u64)]
        expect(x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(3u64, false, 2u32), catalog(rows, words)))
            .to_equal(Err(X86VariantAdmissionErrorV1.IncompleteLevelRequirements))

    it "rejects a variant whose reference semantics were substituted":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL4_V2))
        val baseline = descriptor(1u64, 3u32, 3u32, 0u32, 5u64)
        var substituted = descriptor(3u64, 4u32, 4u32, 256u32, 1u64)
        substituted.semantic_identity = d(999u64)
        expect(x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(3u64, false, 2u32), catalog([baseline, substituted], words)))
            .to_equal(Err(X86VariantAdmissionErrorV1.ReferenceParityMismatch))

    it "rejects forged duplicate provider and variant identities":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL4_V2))
        val first = descriptor(3u64, 4u32, 4u32, 256u32, 1u64)
        var substituted_artifact = descriptor(3u64, 4u32, 4u32, 256u32, 1u64)
        substituted_artifact.artifact_digest = d(999u64)
        expect(x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(3u64, false, 2u32),
            forged_catalog([first, substituted_artifact], words)))
            .to_equal(Err(X86VariantAdmissionErrorV1.InvalidCatalog))

    it "rejects a foreign target catalog without widening the host":
        val words = all_words(mask(ENV_FEATURE_X86_64_LEVEL4_V2))
        var row = descriptor(1u64, 3u32, 3u32, 0u32, 1u64)
        row.target_architecture = ENV_ARCH_AARCH64_V1
        expect(x86_variant_select_admitted_v1(snapshot(2u32, 512u32), words,
            projection(1u64, false, 2u32), forged_catalog([row], words)))
            .to_equal(Err(X86VariantAdmissionErrorV1.ForeignTarget))
