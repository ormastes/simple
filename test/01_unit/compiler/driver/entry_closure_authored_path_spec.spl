use std.spec.*
use compiler.driver.driver_source_loading.{_driver_module_aliases}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool

describe "entry-closure authored source aliases":
    it "preserves coverage wrapper identity across every logical alias":
        val key = "SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE"
        val previous = rt_env_get(key) ?? ""
        val _enabled = rt_env_set(key, "1")
        val aliases = _driver_module_aliases(
            "/tmp/simple_cov_fixture.spl",
            "# simple-coverage-source: src/product/fixture.spl\nfn fixture() -> i64: 1\n",
            "product.fixture"
        )
        val _restored = rt_env_set(key, previous)

        expect(aliases.len()).to_be_greater_than(0)
        for alias in aliases:
            expect(alias.path).to_equal("/tmp/simple_cov_fixture.spl")
            expect(alias.authored_path).to_equal("src/product/fixture.spl")
            expect(alias.content).to_equal("fn fixture() -> i64: 1\n")
