use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.driver.driver_api_project_build.{generate_headers, aot_shared_library}

val PROJECT_BUILD_SOURCE = "src/compiler/80.driver/driver_api_project_build.spl"

describe "project-build import ownership":
    it "binds header generation and shared-library flags at module scope":
        val source = file_read(PROJECT_BUILD_SOURCE)
        expect(source).to_contain("use lazy compiler.tools.header_gen.mod_ (HeaderGenerator)")
        expect(source).to_contain("use compiler.tools.header_gen.shared_lib_flags (get_shared_lib_flags, SharedLibFlags)")
        expect(source.contains("    use compiler.tools.header_gen.mod_ (HeaderGenerator)")).to_be(false)
        expect(source.contains("    use compiler.tools.header_gen.shared_lib_flags")).to_be(false)

    it "keeps the adjacent Tier-5 API free of function-local compiler imports":
        val source = file_read(PROJECT_BUILD_SOURCE)
        expect(source).to_contain("pub fn generate_headers")
        expect(source).to_contain("pub fn aot_shared_library")
        expect(source.contains("\n    use compiler.")).to_be(false)
