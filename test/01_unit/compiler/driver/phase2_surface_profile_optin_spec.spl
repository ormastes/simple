use compiler.driver.driver_log_helpers.{driver_phase_trace_enabled}
use std.env.{env_get}
use std.spec.{describe, it, expect}

describe "Phase 2 surface profile opt-in":
    it "follows the compiler phase profile setting":
        val expected = env_get("SIMPLE_EXPECT_PHASE_TRACE") == "1"
        expect(driver_phase_trace_enabled()).to_equal(expected)
