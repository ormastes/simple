use compiler.driver.driver_log_helpers.{
    build_progress_remaining_units,
    build_progress_succeeded_units
}
use std.io_runtime.{file_read}

describe "LLM-readable compiler build progress summary":
    it "separates completed work from incremental cache reuse":
        expect(build_progress_succeeded_units(90, 70)).to_equal(20)
        expect(build_progress_remaining_units(90, 100)).to_equal(10)

    it "clamps terminal counts and preserves unknown cardinality":
        expect(build_progress_succeeded_units(4, 9)).to_equal(0)
        expect(build_progress_remaining_units(12, 10)).to_equal(0)
        expect(build_progress_succeeded_units(-1, 0)).to_equal(-1)
        expect(build_progress_remaining_units(0, -1)).to_equal(-1)

    it "publishes one parseable status line with reuse and failure fields":
        val source = file_read("src/compiler/80.driver/driver_log_helpers.spl")
        expect(source).to_contain("[build] phase={phase} state={terminal}")
        expect(source).to_contain("remaining={_build_progress_number(remaining)}")
        expect(source).to_contain("succeeded={_build_progress_number(succeeded)}")
        expect(source).to_contain("cached={_build_progress_number(cached)}")
        expect(source).to_contain("failed={_build_progress_number(failed)}")
