use std.spec.*
use compiler.driver.driver_mir_error_owner.{driver_module_mir_failure_message_v1}

describe "Immediate MIR failure diagnostic":
    it "preserves the failed module, physical path and actual cause":
        val message = driver_module_mir_failure_message_v1("broken.module",
            "src/broken/module.spl", "E-MIR-123: unsupported operand")
        expect(message).to_equal("MIR module failed: module=broken.module path=src/broken/module.spl cause=E-MIR-123: unsupported operand")

    it "keeps a multiline cause on one log line":
        val message = driver_module_mir_failure_message_v1("broken", "broken.spl", "first\nsecond\rthird")
        expect(message).to_end_with("cause=first second third")

    it "bounds the excerpt at a UTF-8 boundary and retains the aggregate hint":
        var prefix = ""
        var index = 0
        while index < 511:
            prefix = prefix + "a"
            index = index + 1
        val message = driver_module_mir_failure_message_v1("broken", "broken.spl",
            prefix + "한tail")
        expect(message).to_equal("MIR module failed: module=broken path=broken.spl cause={prefix}... (full diagnostic at scan end)")

    it "preserves an exactly bounded cause without a truncation hint":
        var cause = ""
        var index = 0
        while index < 512:
            cause = cause + "x"
            index = index + 1
        expect(driver_module_mir_failure_message_v1("broken", "broken.spl", cause)).to_end_with("cause={cause}")
