"""A failing HIR shard worker still reports its surface work.

s3-wa (2026-10-25): every worker crashed before the `[hir-shard] done` receipt,
so whether P5 surface trimming ran could not be told from the log. The
failure path (hir_shard_guard_block) prints the counters, and the streaming
route prints them at surface freeze, before any lowering can crash.
"""

use std.spec.*
use std.io.{file_read}

val HIR_CACHE = "src/compiler/80.driver/driver_hir_cache.spl"
val PARSING = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"

fn section_after(source: text, marker: text, length: i64) -> text:
    val at = source.index_of(marker)
    if at < 0: return ""
    val stop = if at + length < source.len(): at + length else: source.len()
    source.substring(at, stop)

describe "HIR shard surface counters on failure":
    it "guard block prints counters before blocking the ledger":
        val body = section_after(file_read(HIR_CACHE), "fn hir_shard_guard_block(", 600)
        expect(body.contains("[hir-shard] failed shard=")).to_equal(true)
        expect(body.contains("worker_surface_counters_v1()")).to_equal(true)
        expect(body.index_of("worker_surface_counters_v1()") < body.index_of("hir_shard_recovery_block(")).to_equal(true)

    it "streaming route prints counters at freeze":
        val body = section_after(file_read(PARSING), "worker_surface_restrict_claims_v1(allowed_paths)", 300)
        expect(body.contains("[hir-shard] surfaces-ready")).to_equal(true)
        expect(body.contains("worker_surface_counters_v1()")).to_equal(true)
