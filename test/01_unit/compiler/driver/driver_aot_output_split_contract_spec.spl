use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "driver AOT output owner split":
    it "keeps every output method registered behind the compatibility facade":
        val facade = file_read(
            "src/compiler/80.driver/driver_aot_output.spl")
        val native = file_read(
            "src/compiler/80.driver/driver_aot_native_output.spl")
        val vhdl = file_read(
            "src/compiler/80.driver/driver_aot_vhdl_output.spl")
        val codegen = file_read(
            "src/compiler/80.driver/driver_aot_codegen_outputs.spl")
        val smf = file_read(
            "src/compiler/80.driver/driver_aot_smf_output.spl")
        val pipeline = file_read(
            "src/compiler/80.driver/driver_aot_pipeline.spl")

        expect(facade.len()).to_be_less_than(1000)
        expect(facade).to_contain("driver_aot_native_output")
        expect(facade).to_contain("driver_native_sources_fingerprint")
        expect(facade).to_contain("driver_native_module_is_export_facade")
        expect(facade).to_contain("compile_bootstrap_context_to_native")
        expect(facade).to_contain("driver_aot_vhdl_output.*")
        expect(facade).to_contain("driver_aot_codegen_outputs.*")
        expect(facade).to_contain("driver_aot_smf_output.*")

        expect(native).to_contain("me compile_to_native")
        expect(native.contains("compile_to_vhdl")).to_equal(false)
        expect(vhdl).to_contain("me compile_to_vhdl")
        expect(vhdl).to_contain("vhdl_remove_production_artifacts")
        expect(vhdl).to_contain("vhdl_write_production_artifacts")
        expect(vhdl).to_contain("aop_advices_requested")
        expect(codegen).to_contain("me compile_to_cuda")
        expect(codegen).to_contain("me compile_to_opencl")
        expect(codegen).to_contain("me compile_to_wasm")
        expect(smf).to_contain("me compile_to_smf")
        expect(smf).to_contain("me compile_to_self_contained")
        expect(pipeline).to_contain("self.compile_to_cuda")
        expect(pipeline).to_contain("self.compile_to_opencl")
        expect(pipeline).to_contain("self.compile_to_vhdl")
        expect(pipeline).to_contain("self.compile_to_wasm")
