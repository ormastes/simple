# Unit entry-contract acceptance, UNRUN without a qualified self-hosted runner.
# Actual interval overlap requires real object compilation and parent admission.
use std.spec.*
use std.nogc_sync_mut.io.env_ops.{env_get_nullable, env_set}
use std.nogc_sync_mut.io.sysinfo_ops.{process_start_identity_checked}
use compiler.driver.driver_build.native_mir_codegen_observation_v1.{native_mir_codegen_observation_begin_v1}

describe "native object observation entry contract":
    it "preserves legacy workers without manufacturing an interval":
        val previous = env_get_nullable("SIMPLE_MIR_WORKER_PRIVATE_ROOT") ?? ""
        expect(env_set("SIMPLE_MIR_WORKER_PRIVATE_ROOT", "")).to_equal(true)
        val result = native_mir_codegen_observation_begin_v1("module")
        val restored = env_set("SIMPLE_MIR_WORKER_PRIVATE_ROOT", previous)
        expect(restored).to_equal(true)
        expect(result.is_ok()).to_equal(true)
        expect(result.unwrap()).to_be_nil()

    it "refuses partial private-worker identity before native compilation":
        val root_previous = env_get_nullable("SIMPLE_MIR_WORKER_PRIVATE_ROOT") ?? ""
        val invocation_previous = env_get_nullable("SIMPLE_MIR_WORKER_INVOCATION") ?? ""
        expect(env_set("SIMPLE_MIR_WORKER_PRIVATE_ROOT", "/not-a-real-worker")).to_equal(true)
        expect(env_set("SIMPLE_MIR_WORKER_INVOCATION", "")).to_equal(true)
        val result = native_mir_codegen_observation_begin_v1("module")
        val root_restored = env_set("SIMPLE_MIR_WORKER_PRIVATE_ROOT", root_previous)
        val invocation_restored = env_set("SIMPLE_MIR_WORKER_INVOCATION", invocation_previous)
        expect(root_restored and invocation_restored).to_equal(true)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("admitted job identities")

    it "rejects invalid process identity without treating PID as birth proof":
        expect(process_start_identity_checked(0).is_err()).to_equal(true)
        expect(process_start_identity_checked(-1).is_err()).to_equal(true)
