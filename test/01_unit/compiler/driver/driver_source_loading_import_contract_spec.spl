use std.spec
use std.io.{file_read}

describe "driver source loading import boundary":
    it "imports only the type inference error contract":
        val source = file_read("src/compiler/80.driver/driver_source_loading.spl")
        expect(source).to_contain("use compiler.hir.hir_types.{Symbol}")
        expect(source).to_contain("use compiler.types.type_infer_types.{TypeInferError}")
        expect(source.contains("use compiler.types.type_infer.*")).to_equal(false)
