"""Ownership admission keeps physical order and ties without quadratic path work."""

use std.spec.*
use compiler.driver.hir_admission_order_v1.{hir_admission_path_order_v1}
use compiler.hir.hir_lowering.module_surface.{module_surface_canonical_path}

describe "HIR ownership admission order":
    it "accepts empty and single-module inventories":
        expect(hir_admission_path_order_v1([])).to_equal([])
        expect(hir_admission_path_order_v1(["/one.spl"])).to_equal([0])

    it "orders paths lexically and preserves equal-path input order":
        val paths = ["/z.spl", "/a.spl", "/z.spl", "", "/a.spl"]
        expect(hir_admission_path_order_v1(paths)).to_equal([3, 1, 4, 0, 2])
        expect(paths).to_equal(["/z.spl", "/a.spl", "/z.spl", "", "/a.spl"])

    it "retains the physical alias order after canonicalization":
        val paths = [module_surface_canonical_path("testdata/order/../b.spl"),
            module_surface_canonical_path("testdata/a.spl"),
            module_surface_canonical_path("testdata/b.spl")]
        expect(hir_admission_path_order_v1(paths)).to_equal([1, 0, 2])

    it "orders an odd-sized reversed inventory without dropping any module":
        val paths = ["g", "f", "e", "d", "c", "b", "a"]
        expect(hir_admission_path_order_v1(paths)).to_equal([6, 5, 4, 3, 2, 1, 0])

    it "keeps one already-ordered inventory unchanged":
        expect(hir_admission_path_order_v1(["a", "b", "c", "d"])).to_equal([0, 1, 2, 3])
