use compiler.mir._MirLowering.module_lowering.{mir_dynamic_module_init_name}

describe "bootstrap dynamic module initializer symbol ownership":
    it "keeps every worker object initializer external and module-unique":
        expect(mir_dynamic_module_init_name("compiler.driver", 7)).to_equal(
            "__module_init_compiler_driver_7_dynamic")
        expect(mir_dynamic_module_init_name("---", 7)).to_equal(
            "__module_init_mod_7_dynamic")
        expect(mir_dynamic_module_init_name("---", 7) ==
            "__module_init_dynamic").to_be(false)
