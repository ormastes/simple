extern fn rt_file_read_text(path: text) -> text

describe "bootstrap dynamic module initializer symbol ownership":
    it "keeps every worker object initializer external and module-unique":
        val lowering = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

        expect(lowering).to_contain("module_name = module_name + module_name_raw.char_at(_mn_i)")
        expect(lowering).to_contain("module_name_uniq = module_name_uniq + \"_\" + bootstrap_module_index.to_text()")
        expect(lowering).to_contain("val init_name = \"__module_init_\" + module_name_uniq + \"_dynamic\"")
        expect(lowering).to_contain("assert init_name != \"__module_init_dynamic\"")
        expect(lowering.contains("_module_init_name_fallback_seq")).to_equal(false)

    it "retains the aggregate linker discovery contract for unique initializers":
        val linker = rt_file_read_text("src/compiler_rust/compiler/src/pipeline/native_project/linker.rs") ?? ""

        expect(linker).to_contain("normalized.starts_with(\"__module_init_\")")
        expect(linker).to_contain("init_names.sort()")
        expect(linker).to_contain("init_names.dedup()")
