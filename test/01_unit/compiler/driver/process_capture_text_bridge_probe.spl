# Linux bootstrap-producer diagnostic: no test-runner or host-detection closure.
use std.nogc_sync_mut.sffi.process_capture.{process_capture_bounded_native, process_capture_unbounded_native}
use std.nogc_sync_mut.sffi.process_capture_text.{process_capture_text_data_v1}

@unsafe(reason: "inspect borrowed UTF8 bytes while the text owner remains live", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_read_u8(address: i64, offset: i64) -> i64

fn check_text(value: text) -> bool:
    val expected: [i64] = [65, 237, 149, 156, 234, 184, 128, 240, 159, 153, 130]
    if value.len() != 11: return false
    val pointer = process_capture_text_data_v1(value)
    if pointer == 0: return false
    var index = 0
    while index < expected.len():
        val byte = unsafe(capabilities: [ffi, raw_ptr]): rt_ptr_read_u8(pointer, index)
        if byte != expected[index]: return false
        index = index + 1
    true

fn main() -> i64:
    if not check_text("A한글🙂") or not check_text("A" + "한글🙂"):
        print "FAIL retained UTF8 bytes"
        return 1
    val args = ["-c", "printf CAPTURE_OUT; printf CAPTURE_ERR >&2; exit 7"]
    val (out, err, code) = process_capture_bounded_native("/bin/sh", args, 10000, 4096)
    if out != "CAPTURE_OUT" or err != "CAPTURE_ERR" or code != 7:
        print "FAIL bounded status={code} stdout={out} stderr={err}"
        return 2
    val (plain_out, plain_err, plain_code) = process_capture_unbounded_native("/bin/sh", args)
    # Existing C unbounded provider discards stderr; bounded capture above
    # verifies actual stderr transport. Preserve that distinction explicitly.
    if plain_out != "CAPTURE_OUT" or plain_err != "" or plain_code != 7:
        print "FAIL unbounded status={plain_code} stdout={plain_out} stderr={plain_err}"
        return 3
    print "PASS process-capture-text-bridge UTF8 bounded unbounded status7"
    0
