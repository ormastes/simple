"""Focused contracts for post-entry bootstrap HIR/MIR ownership."""

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "post-entry bootstrap lowering ownership":
    it "lowers declared parameters and preserves their symbols":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl") ?? ""

        expect(source).to_contain("val param_names = decl_get_param_names(decl_idx)")
        expect(source).to_contain("val param_types = decl_get_param_types(decl_idx)")
        expect(source).to_contain("val param_count = param_names.len()")
        expect(source).to_contain("if not bootstrap_hir_symbol_known_name(name):")
        expect(source).to_contain("self.symbols.define(p_name, SymbolKind.Parameter")

    it "retains flat local declarations with a concrete inferred type":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""

        expect(source).to_contain("var local_type = HirType(kind: HirTypeKind.Infer(0, 0)")
        expect(source).to_contain("self.symbols.define(local_name, SymbolKind.Variable, Some(local_type)")
        expect(source).to_contain("HirStmtKind.Let(local_symbol, local_type, init_expr)")
        expect(source).to_contain("if tag == TYPE_ARRAY_I64:")

    it "keeps the existing final let and array metadata owners":
        val statements = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        val types = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_types.spl") ?? ""

        expect(statements).to_contain("me maybe_copy_array_value(")
        expect(statements).to_contain("self.copy_local_hir_type_metadata(init_local.id, result_arr.id)")
        expect(statements).to_contain("val let_disc = mir_hir_stmt_kind_disc(HirStmtKind.Let(")
        expect(types).to_contain("me copy_local_hir_type_metadata(")
