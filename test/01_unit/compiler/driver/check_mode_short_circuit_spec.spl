use std.io.{file_read}

describe "compiler Check mode boundary":
    it "returns after fatal HIR analysis and before collection analysis":
        val source = file_read("src/compiler/80.driver/driver_orchestration.spl")
        val lower_hir = source.index_of("match self.stage_lower_hir(compile_mode_text):") ?? -1
        val check_return = source.index_of(
            "if compile_mode_text == \"check\":", lower_hir
        ) ?? -1
        val collection_start = source.index_of(
            "match self.stage_collection_analysis(compile_mode_text):", lower_hir
        ) ?? -1

        expect(lower_hir).to_be_greater_than(-1)
        expect(check_return).to_be_greater_than(lower_hir)
        expect(collection_start).to_be_greater_than(check_return)
