# Similar-problem DETECTION sweep for the defect CLASS behind
# doc/08_tracking/bug/stage3_native_build_and_compile_segv_on_hello_world_2026-08-18.md
# (phase-2 half) and
# doc/08_tracking/bug/stage3_selfhost_phase3_error_array_index_after_struct_reassign_silently_noops_2026-08-10.md
#
# @cover src/compiler/80.driver/driver_source_pipeline_parsing.spl
#
# THE CLASS: under pure-Simple NATIVE codegen, a `fn`-receiver call on a struct
# LOCAL that was just reassigned from another struct value reads a stale
# snapshot of that struct's scalar fields. Every phase verdict in the driver has
# the same shape — stage the commit into `var X: CompileContext = self.ctx`, then
# return `not X.has_errors()` — so one such site being wrong means the whole
# family is a latent repeat. The remedy already proven on the streaming path is
# to commit IN PLACE on `self.ctx` and compare `error_count_value` directly.
#
# This is a SWEEP, not a single case: it pins that no verdict in the parse
# pipeline goes back to the miscompiling shape, so the next one added is caught
# by an existing test rather than by another silent phase failure.
#
# Non-vacuity: the file must be present and non-empty, and the sweep must find a
# positive control (at least one scalar-field verdict actually present) — an
# absence check that scanned nothing would otherwise pass by accident.

use std.spec
use std.io_runtime.{file_read}

val _PARSING_SRC = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"

describe "no parse-pipeline verdict is taken through a stale receiver call":

    it "reads the source under test":
        val src = file_read(_PARSING_SRC) ?? ""
        assert_true(src.len() > 0)

    it "has no staged CompileContext local carrying a verdict":
        val src = file_read(_PARSING_SRC) ?? ""
        assert_true(src.len() > 0)
        assert_false(src.contains("not entry_ctx.has_errors()"))
        assert_false(src.contains("not bootstrap_parse_ctx.has_errors()"))
        assert_false(src.contains("not parsed_all_ctx.has_errors()"))

    it "positive control: the scalar-field verdict is the shape actually used":
        val src = file_read(_PARSING_SRC) ?? ""
        assert_true(src.contains("self.ctx.error_count_value == 0"))
