"""Relocations embedded in an SMF module must belong to the code section(s)
that were actually extracted.

`extract_code_from_object` returns the concatenated bytes of every `.text*`
PROGBITS section, in section-index order; `extract_elf_relocations` returns
the entries that `build_smf_with_relocations` then applies to exactly those
bytes at load time, each one rebased to its section's offset in the merged
blob. Relocation offsets are section-relative, so the two must always agree
on which sections exist and where each one lands in the merged blob. ELF
already records the reloc-to-section link explicitly: a SHT_RELA section's
`sh_info` holds the index of the section it relocates.

These synthetic ELF64 objects probe the pairing from both sides:
 * `.rela.rodata` listed ahead of `.rela.text`
 * `-ffunction-sections` layout where `.rela.text.b` is listed ahead of
   `.rela.text.a` -- both `.text.a` and `.text.b` must be extracted (not just
   the first), and each section's relocations must be rebased to its own
   offset in the merged Code blob
 * a truncated object file, to prove `extract_code_from_object` and
   `extract_elf_relocations` still agree on which sections exist (neither
   accepts a `.text` section whose bytes run past the end of the buffer)
"""

use compiler.driver.smf_elf_parser.{extract_code_from_object, extract_elf_relocations}

fn u16b(v: i64) -> [u8]:
    [(v & 0xFF) as u8, ((v >> 8) & 0xFF) as u8]

fn u32b(v: i64) -> [u8]:
    [(v & 0xFF) as u8, ((v >> 8) & 0xFF) as u8, ((v >> 16) & 0xFF) as u8, ((v >> 24) & 0xFF) as u8]

fn u64b(v: i64) -> [u8]:
    u32b(v) + u32b((v >> 32) & 0xFFFFFFFF)

fn zeros(n: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < n:
        out.push(0)
        i = i + 1
    out

fn truncate_to(b: [u8], n: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < n:
        out.push(b[i])
        i = i + 1
    out

# ELF64 section header: 64 bytes.
fn sec_hdr(name_idx: i64, sh_type: i64, off: i64, size: i64, info: i64) -> [u8]:
    var h: [u8] = []
    h = h + u32b(name_idx)   # sh_name
    h = h + u32b(sh_type)    # sh_type
    h = h + u64b(0)          # sh_flags
    h = h + u64b(0)          # sh_addr
    h = h + u64b(off)        # sh_offset
    h = h + u64b(size)       # sh_size
    h = h + u32b(0)          # sh_link
    h = h + u32b(info)       # sh_info
    h = h + u64b(1)          # sh_addralign
    h = h + u64b(24)         # sh_entsize
    h

# ELF64 header: 64 bytes. Section headers always follow at offset 64.
fn elf_hdr(shnum: i64) -> [u8]:
    var b: [u8] = []
    b = b + [0x7F as u8, 0x45 as u8, 0x4C as u8, 0x46 as u8, 2 as u8, 1 as u8, 1 as u8, 0 as u8]
    b = b + zeros(8)
    b = b + u16b(1)          # e_type = ET_REL
    b = b + u16b(62)         # e_machine = EM_X86_64
    b = b + u32b(1)          # e_version
    b = b + u64b(0)          # e_entry
    b = b + u64b(0)          # e_phoff
    b = b + u64b(64)         # e_shoff
    b = b + u32b(0)          # e_flags
    b = b + u16b(64)         # e_ehsize
    b = b + u16b(0)          # e_phentsize
    b = b + u16b(0)          # e_phnum
    b = b + u16b(64)         # e_shentsize
    b = b + u16b(shnum)      # e_shnum
    b = b + u16b(0)          # e_shstrndx -> section 0
    b

fn rela(off: i64, info: i64, addend: i64) -> [u8]:
    u64b(off) + u64b(info) + u64b(addend)

val DOT_TEXT: [u8] = [0x2E as u8, 0x74 as u8, 0x65 as u8, 0x78 as u8, 0x74 as u8]
val DOT_RELA: [u8] = [0x2E as u8, 0x72 as u8, 0x65 as u8, 0x6C as u8, 0x61 as u8]
val DOT_RODATA: [u8] = [0x2E as u8, 0x72 as u8, 0x6F as u8, 0x64 as u8, 0x61 as u8, 0x74 as u8, 0x61 as u8]
val DOT_A: [u8] = [0x2E as u8, 0x61 as u8]
val DOT_B: [u8] = [0x2E as u8, 0x62 as u8]

# Object A: one `.text`, plus `.rela.rodata` listed BEFORE `.rela.text`.
# Layout: ehdr @0 | 4 section headers @64 | shstrtab @320 (31) | pad
#         | .text @352 (4) | .rela.rodata @356 (24) | .rela.text @380 (24)
fn build_object_with_rodata_relocs_first() -> [u8]:
    var b = elf_hdr(4)
    b = b + sec_hdr(0, 3, 320, 31, 0)     # .shstrtab
    b = b + sec_hdr(1, 1, 352, 4, 0)      # .text          -> section index 1
    b = b + sec_hdr(7, 4, 356, 24, 0)     # .rela.rodata   -> decoy, relocates nothing
    b = b + sec_hdr(20, 4, 380, 24, 1)    # .rela.text     -> relocates section 1

    b.push(0)                                  # shstrtab @320
    b = b + DOT_TEXT                           # name 1  ".text"
    b.push(0)
    b = b + DOT_RELA + DOT_RODATA              # name 7  ".rela.rodata"
    b.push(0)
    b = b + DOT_RELA + DOT_TEXT                # name 20 ".rela.text"
    b.push(0)
    b = b + zeros(352 - 351)

    b = b + [0x90 as u8, 0x90 as u8, 0x90 as u8, 0xC3 as u8]   # .text @352
    b = b + rela(0xAAAA, 0, 0)                                  # .rela.rodata @356
    b = b + rela(0xBBBB, (1 << 32) | 2, 7)                      # .rela.text @380
    b

# Object B: `-ffunction-sections` layout. `.text.a` is the section whose bytes
# extract_code_from_object() returns, but `.rela.text.b` is listed first.
# Layout: ehdr @0 | 5 section headers @64 | shstrtab @384 (43) | pad
#         | .text.a @432 (4) | .text.b @436 (4)
#         | .rela.text.b @440 (24) | .rela.text.a @464 (24)
fn build_function_sections_object() -> [u8]:
    var b = elf_hdr(5)
    b = b + sec_hdr(0, 3, 384, 43, 0)     # .shstrtab
    b = b + sec_hdr(1, 1, 432, 4, 0)      # .text.a       -> section index 1
    b = b + sec_hdr(9, 1, 436, 4, 0)      # .text.b       -> section index 2
    b = b + sec_hdr(17, 4, 440, 24, 2)    # .rela.text.b  -> relocates section 2
    b = b + sec_hdr(30, 4, 464, 24, 1)    # .rela.text.a  -> relocates section 1

    b.push(0)                                  # shstrtab @384
    b = b + DOT_TEXT + DOT_A                   # name 1  ".text.a"
    b.push(0)
    b = b + DOT_TEXT + DOT_B                   # name 9  ".text.b"
    b.push(0)
    b = b + DOT_RELA + DOT_TEXT + DOT_B        # name 17 ".rela.text.b"
    b.push(0)
    b = b + DOT_RELA + DOT_TEXT + DOT_A        # name 30 ".rela.text.a"
    b.push(0)
    b = b + zeros(432 - 427)

    b = b + [0xB8 as u8, 0x01 as u8, 0x00 as u8, 0x00 as u8]   # .text.a @432
    b = b + [0xB8 as u8, 0x02 as u8, 0x00 as u8, 0x00 as u8]   # .text.b @436
    b = b + rela(0xCCCC, 0, 0)                                  # .rela.text.b @440
    b = b + rela(0xDDDD, (1 << 32) | 2, 7)                      # .rela.text.a @464
    b

describe "SMF ELF relocation extraction":
    it "returns exactly one entry for an object with a decoy .rela.rodata":
        val relocs = extract_elf_relocations(build_object_with_rodata_relocs_first())
        assert_equal(relocs.len(), 1)

    it "returns the .rela.text offset, not that of an earlier .rela.* section":
        val relocs = extract_elf_relocations(build_object_with_rodata_relocs_first())
        assert_equal(relocs[0].offset, 0xBBBB)

    it "returns the .rela.text symbol index and type":
        val relocs = extract_elf_relocations(build_object_with_rodata_relocs_first())
        assert_equal(relocs[0].sym_idx, 1)
        assert_equal(relocs[0].reloc_type, 2)

    it "returns the .rela.text addend":
        val relocs = extract_elf_relocations(build_object_with_rodata_relocs_first())
        assert_equal(relocs[0].addend, 7)

describe "SMF ELF relocations pair with the extracted code section":
    it "concatenates BOTH .text.a and .text.b under a -ffunction-sections layout (no silent code drop)":
        val code = extract_code_from_object(build_function_sections_object())
        assert_equal(code.len(), 8)
        assert_equal(code[1] as i64, 1)   # byte 1 of .text.a's 4 bytes
        assert_equal(code[5] as i64, 2)   # byte 1 of .text.b's 4 bytes, at merged offset 4

    it "returns relocations for BOTH sections, each rebased to its offset in the merged blob":
        val relocs = extract_elf_relocations(build_function_sections_object())
        assert_equal(relocs.len(), 2)
        # .text.a is first in the merged blob (base 0): .rela.text.a's r_offset unchanged.
        assert_equal(relocs[0].offset, 0xDDDD)
        assert_equal(relocs[0].sym_idx, 1)
        assert_equal(relocs[0].addend, 7)
        # .text.b starts at offset 4 in the merged blob (after .text.a's 4 bytes):
        # .rela.text.b's r_offset 0xCCCC must be rebased by +4.
        assert_equal(relocs[1].offset, 0xCCCC + 4)

describe "SMF ELF text-section discovery agrees on truncated objects":
    it "extract_code_from_object and extract_elf_relocations both skip a .text section truncated past EOF":
        # Same layout as build_object_with_rodata_relocs_first(), but the
        # buffer is cut off before .text's declared [offset, offset+size)
        # range ends -- object_code.len() < sec_offset + sec_size for the
        # ".text" section (offset 352, size 4, but buffer ends at 353).
        val full = build_object_with_rodata_relocs_first()
        val truncated = truncate_to(full, 353)
        val code = extract_code_from_object(truncated)
        # No section header names a valid, fully in-bounds ".text" section,
        # so this must fall back to raw bytes -- NOT the 3 in-bounds bytes of
        # the declared-but-truncated .text section. If this ever returns a
        # partial 3-byte slice instead, extract_code_from_object started
        # accepting a section _find_text_section_index() would reject as
        # out-of-bounds, and the sibling-agreement guard regressed.
        assert_equal(code.len(), truncated.len())
        val relocs = extract_elf_relocations(truncated)
        assert_equal(relocs.len(), 0)
