# Child process for hir_shard_block_race_spec.spl.
# Writers (owner A, B, C) race to publish the ledger BLOCKED reason in every
# round directory under SIMPLE_BLOCK_RACE_QUEUE; the reader (owner R) plays the
# coordinator: it spins on hir_shard_recovery_blocked and records the content
# it reads the first moment the record exists (native_build_main.spl reads
# BLOCKED exactly that way). Each racer announces itself with a ready marker
# and spins until every peer is ready, so one round's calls start within
# microseconds of each other. A writer's reason is one single-character line
# whose length is unique per owner, so a torn, partial or overwritten record
# is distinguishable from any whole one.
# Inputs: SIMPLE_BLOCK_RACE_QUEUE, SIMPLE_BLOCK_RACE_OWNER,
# SIMPLE_BLOCK_RACE_PEERS (comma-separated owners), SIMPLE_BLOCK_RACE_ROUNDS.
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_block, hir_shard_recovery_blocked}
use std.nogc_sync_mut.io_runtime.{env_get_nullable}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.io_runtime.{file_exists, file_read, time_now_monotonic_ms}
use app.io.time_ops.{sleep_ms}

pub fn block_race_owner_units_v1(owner: text) -> i64:
    if owner == "A": return 1
    if owner == "B": return 2
    if owner == "C": return 3
    0

pub fn block_race_reason_v1(owner: text) -> text:
    # "A" -> 20000 bytes, "B" -> 40000, "C" -> 60000: every owner's length differs.
    val units = block_race_owner_units_v1(owner)
    var out = ""
    var block = ""
    var i = 0
    while i < 1000:
        block = block + owner
        i = i + 1
    i = 0
    while i < units * 20:
        out = out + block
        i = i + 1
    out

# Barrier/reader budgets are generous (300 s): on a loaded box the fourth
# interpreter can take well over 30 s to start, and a late peer must never
# read as a product failure. Only a never-arriving peer or record expires it.
val BLOCK_RACE_WAIT_MS: i64 = 300000

fn wait_peers(dir: text, peers: [text]) -> bool:
    val deadline = time_now_monotonic_ms() + BLOCK_RACE_WAIT_MS
    while time_now_monotonic_ms() < deadline:
        var all_ready = true
        for peer in peers:
            if not file_exists("{dir}/ready-{peer}"):
                all_ready = false
        if all_ready:
            return true
        sleep_ms(1)
    false

fn main() -> i64:
    val queue = env_get_nullable("SIMPLE_BLOCK_RACE_QUEUE") ?? ""
    val owner = env_get_nullable("SIMPLE_BLOCK_RACE_OWNER") ?? ""
    val peers = (env_get_nullable("SIMPLE_BLOCK_RACE_PEERS") ?? "").split(",")
    val rounds = (env_get_nullable("SIMPLE_BLOCK_RACE_ROUNDS") ?? "").to_i64() ?? 0
    if queue == "" or owner == "" or peers.len() == 0 or rounds <= 0:
        return 2
    val reader = owner == "R"
    val reason = if reader: "" else: block_race_reason_v1(owner)
    var round = 0
    while round < rounds:
        val dir = "{queue}/r{round}"
        if not file_atomic_write("{dir}/ready-{owner}", owner):
            return 3
        if not wait_peers(dir, peers):
            return 4
        if reader:
            val deadline = time_now_monotonic_ms() + BLOCK_RACE_WAIT_MS
            while not hir_shard_recovery_blocked(dir) and time_now_monotonic_ms() < deadline:
                sleep_ms(1)
            if not hir_shard_recovery_blocked(dir):
                return 6
            val seen = file_read("{dir}/BLOCKED")
            if not file_atomic_write("{dir}/observed-{owner}", seen):
                return 7
        elif not hir_shard_recovery_block(dir, reason):
            return 5
        round = round + 1
    0
