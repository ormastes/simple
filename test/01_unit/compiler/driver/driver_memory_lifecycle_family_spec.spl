# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

use std.io.{file_read}
use std.spec.{describe, it, expect}

# Family detection spec for the three parse/HIR memory-blowup rows, which share
# ONE root cause and must not be patched independently:
#   doc/08_tracking/bug/bootstrap_stage4_selfhost_parse_memory_blowup_2026-07-20.md
#   doc/08_tracking/bug/stage3_current_source_hir_rss_termination_2026-08-14.md
#   doc/08_tracking/bug/bootstrap_stage4_ast_hir_overlap_memory_2026-07-27.md
#
# The shared root, recorded in-source at driver_types.spl:1080-1100 with probe
# numbers: on the no-GC bootstrap lane the driver's three `evict_*` methods drop
# REFERENCES only and reclaim nothing (0 of 2001 allocations, probe P0), because a
# class instance is an untagged, unregistered, header-less rt_alloc block. Closing
# these rows needs a codegen/representation change so class instances are
# identifiable at runtime -- NOT a driver change.
#
# This spec exists because the two obvious "driver fixes" are both actively
# harmful and have both been attempted:
#   (a) calling rt_dict_free_deep from evict_* -- measured WORSE than the no-op:
#       it frees key strings that are aliased from outside the dict by
#       HIR/AST/SymbolTable, i.e. a use-after-free (probes P2/P3);
#   (b) reconstructing the HIR lowerer per module, or copying the frozen surface
#       and trait registries through per-iteration locals -- the retained
#       aggregate boundary that drove the unbounded Stage-3 HIR RSS growth.
# It fails if either is reintroduced, or if the hazard rationale is deleted.

val TYPES = "src/compiler/80.driver/driver_types.spl"
val HIR = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"

use std.spec.step

describe "driver memory lifecycle family invariants":
    # @manual scenario evidence
    it "keeps the three phase evictions reference-drop only":
        # @req REQ-SSPEC-COMPILER
        step("keeps the three phase evictions reference-drop only")
        val source = file_read(TYPES)
        expect(source).to_contain("me evict_ast():")
        expect(source).to_contain("me evict_hir():")
        # No deep-free CALL anywhere in the driver context (the name appears once
        # more, in the prohibition comment asserted by the next example).
        expect(source).to_not_contain("rt_dict_free_deep(")
    it "retains the measured rationale that forbids a deep free":
        # @req REQ-SSPEC-COMPILER
        step("retains the measured rationale that forbids a deep free")
        val source = file_read(TYPES)
        expect(source).to_contain("Do NOT \"fix\" this by calling rt_dict_free_deep here")
        expect(source).to_contain("reclaims NOTHING")

    it "records that the real fix is a codegen change, not a driver change":
        # @req REQ-SSPEC-COMPILER
        step("records that the real fix is a codegen change, not a driver change")
        val source = file_read(TYPES)
        expect(source).to_contain("NOT a driver change")

    it "never constructs the HIR lowerer inside the per-source loop":
        # @req REQ-SSPEC-COMPILER
        step("never constructs the HIR lowerer inside the per-source loop")
        val source = file_read(HIR)
        # 2026-11-10 re-anchor: the old `while source_idx < ...` loop header was
        # renamed to `while hir_loop_pos < hir_visit_order.len():` on both
        # per-source paths. Guard each path's loop tail separately so a
        # constructor introduced between the two loops cannot be mistaken for
        # in-loop construction (the reuse contract spec owns the fine-grained
        # ordering; this is the family-level tripwire).
        val streaming_start = source.index_of(
            "me lower_and_check_streaming_surfaces_impl() -> bool:")
        val streaming_end = source.index_of("me lower_and_check_impl()", streaming_start)
        expect(streaming_start).to_be_greater_than(0)
        expect(streaming_end).to_be_greater_than(streaming_start)
        val streaming = source.substring(streaming_start, streaming_end)
        val streaming_loop = streaming.index_of(
            "while hir_loop_pos < hir_visit_order.len():")
        expect(streaming_loop).to_be_greater_than(0)
        val streaming_tail = streaming.substring(streaming_loop, streaming.len())
        expect(streaming_tail).to_not_contain("hirlowering_for_module_with_diagnostics(")
        expect(streaming_tail).to_not_contain("hirlowering_new()")
        val impl_start = source.index_of("if self.ctx.sources.len() <= 0:")
        expect(impl_start).to_be_greater_than(0)
        val owner_start = source.index_of(
            "var phase_hir_modules: Dict<text, HirModule>", impl_start)
        val owner_end = source.index_of(
            "# Step 3b: ParserTrait coherence checking", owner_start)
        expect(owner_start).to_be_greater_than(0)
        expect(owner_end).to_be_greater_than(owner_start)
        val owner = source.substring(owner_start, owner_end)
        val retained_loop = owner.index_of(
            "while hir_loop_pos < hir_visit_order.len():")
        expect(retained_loop).to_be_greater_than(0)
        val retained_tail = owner.substring(retained_loop, owner.len())
        expect(retained_tail).to_not_contain("hirlowering_for_module_with_diagnostics(")
        expect(retained_tail).to_not_contain("hirlowering_new()")
    it "reuses one diagnostics buffer and one trait-registry owner":
        # @req REQ-SSPEC-COMPILER
        step("reuses one diagnostics buffer and one trait-registry owner")
        val source = file_read(HIR)
        expect(source).to_contain("Allocate the diagnostics array before the long HIR loop")
        expect(source).to_contain("This loop-owned lowerer is the trait registry owner")
