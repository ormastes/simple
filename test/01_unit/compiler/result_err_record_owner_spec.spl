# bug: result_err_record_owner_erased_2026_10_11
use std.spec.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.result_err_record_owner.*
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.asm_and_targets.*
use compiler.mir.mir_lowering_stmts.*

class ErrOwnerLowered:
    lowering: MirLowering
    mir: MirModule

val err_records_source = "pub class IoError:\n    kind: i64\n    message: text\n    source: i64\n\npub struct ValueError:\n    code: i64\n    message: text\n"
val err_provider_source = "use app.probe.records.\{IoError, ValueError\}\n\npub class Service:\n    calls: i64\n    me run() -> Result<(), IoError>:\n        self.calls = self.calls + 1\n        Err(IoError(kind: 19, message: \"provider message\", source: 41))\n\npub fn fail() -> Result<(), IoError>:\n    Err(IoError(kind: 7, message: \"provider message\", source: 11))\n\npub fn okay() -> Result<IoError, text>:\n    Ok(IoError(kind: 7, message: \"ok message\", source: 11))\n\npub fn scalar_error() -> Result<(), text>:\n    Err(\"text error\")\n\npub class OtherError:\n    message: text\n    kind: i64\n\npub fn fail_other() -> Result<(), OtherError>:\n    Err(OtherError(message: \"other message\", kind: 3))\n\npub fn value_fail() -> Result<(), ValueError>:\n    Err(ValueError(code: 9, message: \"value message\"))\n"
val err_consumer_source = "use app.probe.provider.\{Service, fail, okay, scalar_error, fail_other, value_fail\}\n\nclass IoError:\n    message: i64\n    padding: i64\n\nfn alias_probe(service: Service) -> text:\n    val first = service.run()\n    val second = first\n    val third = second\n    match third:\n        case Ok(_): \"unexpected\"\n        case Err(error): error.message\n\nfn direct_probe() -> text:\n    match fail():\n        case Ok(_): \"unexpected\"\n        case Err(error): error.message\n\nfn wildcard_probe() -> text:\n    val result = fail()\n    match result:\n        case Err(error): error.message\n        case _: \"unexpected\"\n\nfn joined_probe(flag: bool) -> text:\n    val result = if flag: fail() else: fail()\n    match result:\n        case Ok(_): \"unexpected\"\n        case Err(error): error.message\n\nfn scalar_probe() -> text:\n    val result = scalar_error()\n    match result:\n        case Ok(_): \"unexpected\"\n        case Err(error): error\n\nfn value_copy_probe() -> i64:\n    val result = value_fail()\n    match result:\n        case Ok(_): 1\n        case Err(error):\n            var separate = error\n            separate.message = \"changed copy\"\n            if error.message != \"value message\": return 2\n            if separate.message != \"changed copy\": return 3\n            0\n\nfn main() -> i64:\n    var service = Service(calls: 0)\n    if alias_probe(service) != \"provider message\": return 1\n    if service.calls != 1: return 2\n    if direct_probe() != \"provider message\": return 3\n    if wildcard_probe() != \"provider message\": return 4\n    if scalar_probe() != \"text error\": return 5\n    if joined_probe(true) != \"provider message\": return 6\n    if joined_probe(false) != \"provider message\": return 7\n    if value_copy_probe() != 0: return 8\n    0\n"

fn err_owner_lower() -> ErrOwnerLowered:
    err_owner_lower_source(err_consumer_source)

fn err_owner_lower_source(consumer_source: text, conflict_mode: i64 = 0) -> ErrOwnerLowered:
    val log = Logger(level: 0)
    val records_ast = parse_full_frontend(err_records_source, "app/probe/records.spl", "app.probe.records", log)
    val provider_ast = parse_full_frontend(err_provider_source, "app/probe/provider.spl", "app.probe.provider", log)
    val consumer_ast = parse_full_frontend(consumer_source, "app/probe/main.spl", "app.probe.main", log)
    var modules: Dict<text, Module> = {}
    modules["app.probe.records"] = records_ast
    modules["app.probe.provider"] = provider_ast
    val files = [SourceFile(path: "app/probe/records.spl", content: err_records_source, module_name: "app.probe.records"), SourceFile(path: "app/probe/provider.spl", content: err_provider_source, module_name: "app.probe.provider")]
    val surfaces_option = module_surfaces_from_modules(modules, files)
    if val surfaces = surfaces_option:
        var records_lowering = hirlowering_for_module("app/probe/records.spl", surfaces)
        var provider_lowering = hirlowering_for_module("app/probe/provider.spl", surfaces)
        var consumer_lowering = hirlowering_for_module("app/probe/main.spl", surfaces)
        val records = records_lowering.lower_module(records_ast)
        val provider = provider_lowering.lower_module(provider_ast)
        val consumer = consumer_lowering.lower_module(consumer_ast)
        expect(records_lowering.errors.len()).to_equal(0)
        expect(provider_lowering.errors.len()).to_equal(0)
        expect(consumer_lowering.errors.len()).to_equal(0)
        var lowering = MirLowering.new(consumer.symbols)
        # The local homonym is observed first; a unique bare-name guess cannot
        # authorize the provider's second text field.
        var prescan_mods: Dict<text, HirModule> = {}
        prescan_mods["consumer"] = consumer
        prescan_mods["provider"] = provider
        prescan_mods["records"] = records
        lowering.prescan_module_struct_names(prescan_mods, "consumer")
        lowering.prescan_module_struct_names(prescan_mods, "provider")
        lowering.prescan_module_struct_names(prescan_mods, "records")
        if conflict_mode != 0:
            # Same qualified identity, field names, offsets and widths; only
            # message's semantic type differs. The common physical digest
            # deliberately remains unchanged.
            val changed_source = err_records_source.replace("message: text", "message: i64")
            val duplicate_ast = parse_full_frontend(changed_source, "app/probe/records.spl", "app.probe.records", log)
            var duplicate_lowering = hirlowering_for_module("app/probe/records.spl", surfaces)
            val duplicate = duplicate_lowering.lower_module(duplicate_ast)
            expect(duplicate_lowering.errors.len()).to_equal(0)
            val original_digest = lowering.composite_layout_digests["app.probe.records::IoError"]
            if conflict_mode == 1:
                var dup_mods: Dict<text, HirModule> = {}
                dup_mods["duplicate"] = duplicate
                lowering.prescan_module_struct_names(dup_mods, "duplicate")
            else:
                for class_def in duplicate.classes.values():
                    if class_def.name == "IoError":
                        lowering.register_composite_field_metadata("app.probe.records.IoError", class_def.fields, duplicate.symbols, true)
            expect(lowering.composite_layout_digests["app.probe.records::IoError"]).to_equal(original_digest)
            expect(lowering.composite_layout_owner_counts["app.probe.records::IoError"]).to_equal(1)
        val mir = lowering.lower_module(consumer, [consumer, provider, records])
        return ErrOwnerLowered(lowering: lowering, mir: mir)
    fail("module surface construction failed")

fn err_owner_text_field_count(mir: MirModule, name: text, index: i64) -> i64:
    var count = 0
    for function in mir.functions.values():
        if function.name.ends_with("." + name):
            for block in function.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.GetField(destination, _, field):
                            if field == index and function.locals[destination.id].type_.kind == MirTypeKind.Opaque("str"):
                                count = count + 1
                        case _: ()
    count

fn err_owner_call_count(mir: MirModule, name: text, suffix: text) -> i64:
    var count = 0
    for function in mir.functions.values():
        if function.name.ends_with("." + name):
            for block in function.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Call(_, operand, _):
                            match operand.kind:
                                case MirOperandKind.Const(MirConstValue.Str(callee), _):
                                    if callee.ends_with(suffix): count = count + 1
                                case _: ()
                        case _: ()
    count

describe "provider-owned Result Err record fields", tag: ["only-compiled"]:
    it "uses the imported record field index and text type through three aliases":
        val lowered = err_owner_lower()
        expect(lowered.lowering.errors.len()).to_equal(0)
        expect(err_owner_text_field_count(lowered.mir, "alias_probe", 1)).to_equal(1)
        expect(err_owner_call_count(lowered.mir, "alias_probe", ".Service.run")).to_equal(1)

    it "retains direct call and wildcard Err matching without double evaluation":
        val lowered = err_owner_lower()
        expect(lowered.lowering.errors.len()).to_equal(0)
        expect(err_owner_text_field_count(lowered.mir, "direct_probe", 1)).to_equal(1)
        expect(err_owner_text_field_count(lowered.mir, "wildcard_probe", 1)).to_equal(1)
        expect(err_owner_call_count(lowered.mir, "direct_probe", ".fail")).to_equal(1)
        expect(err_owner_call_count(lowered.mir, "wildcard_probe", ".fail")).to_equal(1)

    it "leaves text Err outside record-owner admission":
        val lowered = err_owner_lower()
        expect(lowered.lowering.errors.len()).to_equal(0)
        expect(err_owner_text_field_count(lowered.mir, "scalar_probe", 0)).to_equal(0)
        expect(err_owner_call_count(lowered.mir, "scalar_probe", ".scalar_error")).to_equal(1)

    it "does not borrow the Ok payload registry for Err":
        bootstrap_fn_ret_ok_shape_register("err_owner_test.only_ok", "provider.Record")
        expect(bootstrap_fn_ret_err_shape_lookup("err_owner_test.only_ok")).to_be_nil()
        bootstrap_fn_ret_err_shape_register("err_owner_test.conflict", "left.Record")
        bootstrap_fn_ret_err_shape_register("err_owner_test.conflict", "right.Record")
        expect(bootstrap_fn_ret_err_shape_lookup("err_owner_test.conflict")).to_equal(Some(""))

    it "invalidates differing branch owners and keeps equal owners":
        var lowered = err_owner_lower()
        var owner = lowered.lowering
        owner.result_err_record_owners[8101] = "left.Record"
        owner.result_err_record_owners[8102] = "right.Record"
        owner.join_result_err_record_owners([LocalId(id: 8101), LocalId(id: 8102)], 8103)
        expect(owner.result_err_record_owners[8103]).to_equal("")
        owner.join_result_err_record_owners([LocalId(id: 8101), LocalId(id: 8101)], 8104)
        expect(owner.result_err_record_owners[8104]).to_equal("left.Record")
        owner.join_result_err_record_owners([LocalId(id: 8101), LocalId(id: 8199)], 8105)
        expect(owner.result_err_record_owners[8105]).to_equal("")

    it "retains invalidation across assignment and later copies":
        var lowered = err_owner_lower()
        var owner = lowered.lowering
        owner.result_err_record_owners[8201] = "left.Record"
        owner.result_err_record_owners[8202] = "right.Record"
        owner.copy_result_err_record_owner(8201, 8203)
        owner.assign_result_err_record_owner(8202, 8203)
        owner.copy_result_err_record_owner(8201, 8203)
        expect(owner.result_err_record_owners[8203]).to_equal("")
        owner.assign_result_err_record_owner(8299, 8201)
        expect(owner.result_err_record_owners[8201]).to_equal("")

    it "rejects missing qualified layout despite a similarly named local declaration":
        var lowered = err_owner_lower()
        var owner = lowered.lowering
        val before = owner.errors.len()
        owner.result_err_record_owners[8301] = "unregistered.IoError"
        expect(owner.checked_result_err_record_owner(8301, Span.empty())).to_equal("")
        expect(owner.errors.len()).to_equal(before + 1)
        expect(owner.errors[before].fatal).to_be(true)
        expect(owner.errors[before].message).to_contain("provider layout")

    it "ignores a colliding current-table Named ID during actual field lowering":
        var lowered = err_owner_lower()
        var owner = lowered.lowering
        val declaration = bootstrap_fn_ret_err_shape_lookup("app.probe.provider.fail") ?? ""
        expect(declaration != "").to_be(true)
        val exact_owner = owner.declared_struct_layout_key(declaration)
        val raw = owner.builder.emit_const_int(0)
        val binding = owner.symbols.define("err_collision_value", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, false, nil)
        owner.bind_local(binding.id, raw)
        owner.result_err_record_owners[raw.id] = exact_owner
        owner.struct_value_syms[raw.id] = exact_owner
        # The cached payload's numeric slot is deliberately a valid but wrong
        # consumer declaration. The exact provider metadata must win.
        val decoy = owner.symbols.lookup_or_invalid("IoError")
        val receiver = HirExpr(kind: HirExprKind.NamedVar(binding, "err_collision_value"),
            has_type_: true, type_: HirType(kind: HirTypeKind.Named(decoy, []), span: Span.empty()), span: Span.empty())
        val field = HirExpr(kind: HirExprKind.Field(receiver, "message", nil), has_type_: false, type_: nil, span: Span.empty())
        val before = owner.errors.len()
        val result = owner.lower_expr(field)
        expect(owner.errors.len()).to_equal(before)
        expect((owner.local_mir_type_of(result) ?? MirType.i64()).kind).to_equal(MirTypeKind.Opaque("str"))
        expect(owner.resolve_field_index(receiver, raw, "message", nil)).to_equal(1)

    it "invalidates conflicting assignment through the actual MIR writeback route":
        var lowered = err_owner_lower()
        var owner = lowered.lowering
        val initial = owner.builder.emit_const_int(1)
        val replacement = owner.builder.emit_const_int(2)
        val binding = owner.symbols.define("assigned_result", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, true, nil)
        owner.bind_local(binding.id, initial)
        owner.result_err_record_owners[initial.id] = "left.Record"
        owner.result_err_record_owners[replacement.id] = "right.Record"
        owner.lower_assign_var(binding.id, nil, replacement, Span.empty(), HirExprKind.Var(binding))
        expect(owner.result_err_record_owners[initial.id]).to_equal("")

    it "retains equal provider identity through a real conditional result join":
        val lowered = err_owner_lower()
        expect(lowered.lowering.errors.len()).to_equal(0)
        expect(err_owner_text_field_count(lowered.mir, "joined_probe", 1)).to_equal(1)

    it "rejects divergent provider owners through parsed conditional and match lowering":
        val lowered = err_owner_lower_source("use app.probe.provider.\{fail, fail_other\}\n\nfn main() -> i64:\n    val choose = true\n    val result = if choose: fail() else: fail_other()\n    match result:\n        case Ok(_): 0\n        case Err(error):\n            print(error.message)\n            1\n")
        var rejected = false
        for error in lowered.lowering.errors:
            if error.fatal and error.message.contains("Result Err record has no unique provider layout snapshot"):
                rejected = true
        expect(rejected).to_be(true)

    it "keeps imported struct payloads typed for subsequent value-copy lowering":
        val lowered = err_owner_lower()
        expect(lowered.lowering.errors.len()).to_equal(0)
        expect(err_owner_text_field_count(lowered.mir, "value_copy_probe", 1)).to_be_greater_than(0)
        expect(err_owner_call_count(lowered.mir, "value_copy_probe", ".value_fail")).to_equal(1)

    it "rejects same-size semantic field conflict from a duplicate parsed declaration":
        val lowered = err_owner_lower_source(err_consumer_source, 1)
        var rejected = false
        for error in lowered.lowering.errors:
            if error.fatal and error.message.contains("conflicting or unknown provider field types"):
                rejected = true
        expect(rejected).to_be(true)

    it "retains semantic conflict after overwrite and later valid provider registration":
        val lowered = err_owner_lower_source(err_consumer_source, 2)
        var rejected = false
        for error in lowered.lowering.errors:
            if error.fatal and error.message.contains("conflicting or unknown provider field types"):
                rejected = true
        expect(rejected).to_be(true)

    it "uses the exact class registration spelling and canonical snapshot identity":
        val lowered = err_owner_lower()
        val shape = bootstrap_fn_ret_err_shape_lookup("app.probe.provider.fail") ?? ""
        expect(shape).to_equal("app.probe.records.IoError")
        expect(lowered.lowering.class_type_names.contains(shape)).to_be(true)
        expect(result_err_layout_identity(shape)).to_equal("app.probe.records::IoError")
        val snapshot = lowered.lowering.result_err_layout_types["app.probe.records::IoError"]
        expect(snapshot).to_contain("message:text")
        expect(snapshot).to_contain("kind:i64")
