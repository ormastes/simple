# Batch 2 focused regression coverage for stale_merge_reverted_august_fixes_audit_2026-11-15:
# exercises restored crypto/TLS/package-signing boundaries, co-compiled symbol
# collision fixes, compositor/desugar/chromium/sspec/sshd/machine_profile parity.

use std.spec.{describe, context, it, expect}
use std.io_runtime.{file_read}
use os.crypto.ed25519.{ed25519_self_test, ed25519_sign_live_runtime_only}
use os.tls13.server_builders.{build_certificate_verify_checked}
use os.tls13.transcript.{transcript_empty_hash}
use os.kernel.net.tcp_shim.{rt_io_tcp_connect_timeout, rt_io_tcp_accept_timeout}
use os.crypto.sha384.{sha384}
use os.crypto.sha512.{sha512}
use os.crypto.serpent.{serpent_encrypt_block, serpent_decrypt_block}
use os.crypto.zuc.{zuc_keystream}
use app.package.registry.signing.{bytes_to_hex}
use app.package.registry.verify.{verify_signature, verify_checksum}
use app.desugar.rewriter.{rewrite_static_calls}
use app.ui.chromium.acid2.pixel_grid.{PixelGrid, ACID2_PIXEL_RED}
use app.ui.chromium.engine_merge.{engine_merge_css_px}
use app.sspec_maintain.documentize.{compose_sspec_documentized_manual}
use app.sspec_maintain.source_facts.{extract_sspec_manual_facts}
use os.compositor.vulkan_present_damage_gate.{hosted_vulkan_present_identity_valid}
use os.apps.sshd.ssh_channel.{ssh_parse_channel_eof}
use os.machine_profile.{_boot_protocol_for_lane}
use os.port.simpleos_multiplatform_build.{SimpleOsFirmwareContractKind, simpleos_machine_target_projection}

fn _empty_u8() -> [u8]:
    var out: [u8] = []
    out

fn _zeros_u8(count: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < count:
        out.push(0u8)
        i = i + 1
    out

fn _seq16_u8() -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < 16:
        out.push(i.to_u8())
        i = i + 1
    out

describe "August audit Batch 2 restorations":
    context "Group A crypto, TLS 1.3, and package registry fail-closed boundaries":
        it "passes Pure-Simple Ed25519 RFC 8032 self-test and rejects invalid checked seed inputs":
            val self_res = ed25519_self_test()
            expect(self_res.is_ok()).to_equal(true)
            val err_res = ed25519_sign_live_runtime_only(_empty_u8(), _empty_u8(), [0x72u8])
            expect(err_res.is_err()).to_equal(true)

        it "fails closed on unsupported TLS CertificateVerify signature scheme":
            val cv_res = build_certificate_verify_checked(_zeros_u8(32), _empty_u8(), 0x9999u16)
            expect(cv_res.is_err()).to_equal(true)
            expect(cv_res.unwrap_err()).to_contain("unsupported")

        it "keeps package registry signing and verification fail-closed":
            expect(verify_signature([0x61u8, 0x62u8], "deadbeef", _empty_u8())).to_equal(false)
            expect(verify_signature([0x61u8, 0x62u8], "deadbeef", _zeros_u8(32))).to_equal(false)
            expect(verify_checksum("/nonexistent/pkg.spk", "abc").is_err()).to_equal(true)
            expect(bytes_to_hex([0xabu8, 0xcdu8])).to_equal("abcd")
            val signing_src = file_read("src/app/package.registry/signing.spl")
            expect(signing_src).to_contain("E-SFFI-001: checked Ed25519 key-generation provider unavailable")
            expect(signing_src).to_contain("E-SFFI-006: signing key lacks a cryptographically bound Ed25519 public key")

        it "computes SHA-256 empty transcript hash and enforces non-positive TCP timeouts fail-closed":
            val th = transcript_empty_hash()
            expect(th.len()).to_equal(32)
            expect(th[0]).to_equal(0xe3u8)
            expect(th[1]).to_equal(0xb0u8)
            expect(rt_io_tcp_connect_timeout("127.0.0.1:80", 0)).to_equal(-1)
            expect(rt_io_tcp_connect_timeout("127.0.0.1:80", -5)).to_equal(-1)
            expect(rt_io_tcp_accept_timeout(-1, 0)).to_equal(-1)
            expect(rt_io_tcp_accept_timeout(-1, -5)).to_equal(-1)

    context "Group B co-compiled crypto symbol collision isolation":
        it "co-imports sha384 and sha512 and matches FIPS 180-4 empty-input prefixes":
            val h384 = sha384(_empty_u8())
            val h512 = sha512(_empty_u8())
            expect(h384.len()).to_equal(48)
            expect(h384[0]).to_equal(0x38u8)
            expect(h384[1]).to_equal(0xb0u8)
            expect(h512.len()).to_equal(64)
            expect(h512[0]).to_equal(0xcfu8)
            expect(h512[1]).to_equal(0x83u8)

        it "co-imports serpent and zuc cleanly after private helper renames":
            val key = _zeros_u8(16)
            val pt = _seq16_u8()
            val ct = serpent_encrypt_block(key, pt)
            val rt = serpent_decrypt_block(key, ct)
            expect(rt).to_equal(pt)
            val ks = zuc_keystream(_zeros_u8(16), _zeros_u8(16), 2)
            expect(ks.len()).to_equal(2)
            expect(ks[0]).to_equal(0x27BEDE74u32)

    context "Group D app, compositor, sshd, sspec, and machine_profile parity":
        it "rejects zero wildcard identity mismatches in Vulkan present damage gate":
            expect(hosted_vulkan_present_identity_valid(41, 52, 63, 41, 52, 63)).to_equal(true)
            expect(hosted_vulkan_present_identity_valid(41, 52, 63, 0, 52, 63)).to_equal(false)

        it "rewrites static calls in source without mangling lowercase instance calls":
            val rewritten = rewrite_static_calls("val a = Point.origin()\nval b = obj.run()\n")
            expect(rewritten).to_contain("Point__origin()")
            expect(rewritten).to_contain("obj.run()")

        it "tracks painted pixels accurately via PixelGrid.painted_count and is_blank":
            var grid = PixelGrid.new()
            expect(grid.is_blank()).to_equal(true)
            expect(grid.painted_count()).to_equal(0)
            expect(grid.set(1, 2, ACID2_PIXEL_RED)).to_equal(true)
            expect(grid.is_blank()).to_equal(false)
            expect(grid.painted_count()).to_equal(1)

        it "parses CSS px units via engine_merge_css_px":
            expect(engine_merge_css_px("24px")).to_equal(24.0)

        it "counts bulleted - <label> scenario steps and generates ## Traceability sections":
            val manual_md = "## Purpose\nCheck.\n\n## Scenarios\n\n- Step one\n- Step two\n"
            val mfacts = extract_sspec_manual_facts("m.md", manual_md)
            expect(mfacts.visible_step_count).to_equal(2)
            val spec_src = "# @req REQ-101\ndescribe \"demo\":\n    it \"works\":\n        step(\"Step one\")\n        expect(1).to_equal(1)\n"
            val doc_res = compose_sspec_documentized_manual("m.md", spec_src, manual_md, false)
            expect(doc_res.content).to_contain("## Traceability")
            expect(doc_res.content).to_contain("REQ-101")

        it "rejects trailing bytes on SSH_MSG_CHANNEL_EOF":
            val ok_eof = ssh_parse_channel_eof([96u8, 0u8, 0u8, 0u8, 9u8])
            expect(ok_eof.is_ok()).to_equal(true)
            val bad_eof = ssh_parse_channel_eof([96u8, 0u8, 0u8, 0u8, 9u8, 0x01u8])
            expect(bad_eof.is_err()).to_equal(true)

        it "maps SimpleOsFirmwareContractKind.BareMetal to bare-metal boot protocol":
            var lane = simpleos_machine_target_projection("riscv64").qemu_smoke_lane
            lane.firmware_contract = SimpleOsFirmwareContractKind.BareMetal
            expect(_boot_protocol_for_lane(lane)).to_equal("bare-metal")
