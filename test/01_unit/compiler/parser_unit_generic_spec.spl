# @cover src/compiler/10.frontend/core/parser.spl 2%
"""
# Pure-Simple parser accepts unit type `()` inside generic type arguments (2026-07-29)

**Category:** Compiler / Parser
**Bug:** doc/08_tracking/bug/stage2_parser_result_unit_generic_divergence_2026-07-29.md

## Overview

The pure-Simple parser previously rejected `Result<(), E>` (a unit `()` type
used as a generic type argument), even though the Rust seed parser accepted
it. This broke stage-3 self-host on
`src/compiler/70.backend/backend/vhdl_codegen_helpers.spl`, which declares
6 functions returning `Result<(), CompileError>`.

This spec drives real source text with `Result<(), text>` (a function return
type) through the real frontend pipeline and asserts it parses without error
and that the function is registered.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}

fn make_logger() -> Logger:
    Logger(level: 0)

describe "Parser accepts unit type () as a generic type argument":
    it "parses `fn f() -> Result<(), text>:` without a parser error":
        val src = "fn f() -> Result<(), text>:\n    Ok(())\n"
        val path = "src/parser_unit_generic_fixture.spl"
        val log = make_logger()
        val module = parse_full_frontend(src, path, "parser_unit_generic_fixture", log)
        expect(module.functions.contains_key("f")).to_equal(true)

    it "parses a tuple type `(i64, text)` as a generic type argument":
        val src = "fn g() -> Result<(i64, text), text>:\n    Ok((1, \"a\"))\n"
        val path = "src/parser_tuple_generic_fixture.spl"
        val log = make_logger()
        val module = parse_full_frontend(src, path, "parser_tuple_generic_fixture", log)
        expect(module.functions.contains_key("g")).to_equal(true)
