describe "module globals across init chunks":
    # @manual scenario evidence

    it "initializes a 150-long dependency chain in declaration order":
        # @req REQ-SSPEC-COMPILER
        step("initializes a 150-long dependency chain in declaration order")
        step("Each global is the previous one plus one, starting from BASE")
        expect(g_0).to_equal(1001)
        expect(g_63).to_equal(1064)
        expect(g_64).to_equal(1065)
        expect(g_127).to_equal(1128)
        expect(g_128).to_equal(1129)
        expect(g_149).to_equal(1150)

    it "runs every initializer exactly once":
        # @req REQ-SSPEC-COMPILER
        step("runs every initializer exactly once")
        step("150 dynamic initializers called bump once each")
        expect(init_calls).to_equal(150)

    it "keeps const-foldable globals interleaved with the chain":
        # @req REQ-SSPEC-COMPILER
        step("keeps const-foldable globals interleaved with the chain")
        expect(CONST_25).to_equal(25)
        expect(CONST_125).to_equal(125)
