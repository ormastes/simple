# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @cover src/compiler_rust/compiler/src/hir/lower/module_lowering/module_pass.rs 0%
"""
# Module globals initialize in declaration order across init chunks

**Category:** Language / Module initialization
**Status:** Regression guard

## Purpose and Audience

Module-level globals whose initializer needs runtime evaluation (a call, or a
read of another global) are assigned by a synthesized init function, in
source declaration order. Since 2026-10-05 the seed splits a large set into
bounded chunks (`__dyninit_part_<i>`, called in order by the single
`__module_init_dynamic` root): the browser's ~10k globals had produced ONE
151k-instruction function that took Cranelift 674 s to compile.

This spec declares more dynamic globals than one chunk holds (the chunk size
is 64), each depending on the one before it, interleaved with const-foldable
globals, and checks every value -- so a chunk boundary that reordered,
dropped, or double-ran an initializer would show up as a wrong number.

The audience is anyone touching module-init synthesis in the Rust seed.
"""

use std.spec.step

use std.spec.*

var init_calls: i64 = 0

fn bump(x: i64) -> i64:
    init_calls = init_calls + 1
    x + 1

val BASE = 1000
val g_0 = bump(BASE)
val g_1 = bump(g_0)
val g_2 = bump(g_1)
val g_3 = bump(g_2)
val g_4 = bump(g_3)
