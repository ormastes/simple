# Minimal reproduction for freestanding_u64_cross_fn_range_compare_miscompile.
# The .to_u64() literal conversions are intentional regression coverage.

extern fn serial_println(msg: text)
extern fn rt_port_outb(port: u16, value: u8)

fn u64_range_or_zero(vaddr: u64, top_page_base: u64, stack_top: u64) -> u64:
    if vaddr < top_page_base or vaddr >= stack_top:
        return 0
    vaddr

fn main() -> i64:
    val actual = u64_range_or_zero(
        0x80001FFFE0.to_u64(),
        0x80001FF000.to_u64(),
        0x8000200000.to_u64())
    print("U64_RANGE={actual}")
    if actual != 0x80001FFFE0.to_u64():
        return 1
    print("U64_RANGE_PASS")
    0

fn _start():
    val actual = u64_range_or_zero(
        0x80001FFFE0.to_u64(),
        0x80001FF000.to_u64(),
        0x8000200000.to_u64())
    serial_println("U64_RANGE=" + actual.to_string())
    if actual != 0x80001FFFE0.to_u64():
        serial_println("U64_RANGE_FAIL")
        rt_port_outb(0xf4u16, 1u8)
        return
    serial_println("U64_RANGE_PASS")
    rt_port_outb(0xf4u16, 0u8)
