# Return-only generic tuple projection must preserve optional payloads.
struct TupleProjectionCarrier:
    value: i64

extern fn rt_tuple_new(length: i64) -> i64
extern fn rt_tuple_set(tuple: i64, index: i64, value: TupleProjectionCarrier) -> bool
extern fn rt_tuple_get<T>(tuple: i64, index: i64) -> T?

fn project<T>(tuple: i64, index: i64) -> T?:
    unsafe(capabilities: [ffi]):
        rt_tuple_get<T>(tuple, index)

fn main() -> i32:
    var tuple: i64 = 0
    unsafe(capabilities: [ffi]):
        tuple = rt_tuple_new(2)
        if not rt_tuple_set(tuple, 0, TupleProjectionCarrier(value: 73)): return 1
    val present: TupleProjectionCarrier? = project<TupleProjectionCarrier>(tuple, 0)
    if present == nil: return 2
    if present.unwrap().value != 73: return 3
    if project<TupleProjectionCarrier>(tuple, -1) != nil: return 4
    if project<TupleProjectionCarrier>(tuple, 2) != nil: return 5
    0