use std.spec
use value_owner_constructor_native.{value_probe_primitives_v1, value_probe_collections_v1, value_probe_record_carriers_v1, value_probe_option_result_v1}

describe "genuine Value owner constructor compatibility":
    it "preserves primitive payloads with overlapping real enum declarations visible":
        expect(value_probe_primitives_v1()).to_equal("")
    it "preserves collection payloads and original inputs":
        expect(value_probe_collections_v1()).to_equal("")
    it "preserves real record carrier fields and nested expression metadata":
        expect(value_probe_record_carriers_v1()).to_equal("")
    it "preserves declared optional payload presence and contained Value":
        expect(value_probe_option_result_v1()).to_equal("")
