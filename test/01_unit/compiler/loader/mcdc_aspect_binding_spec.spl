use std.spec.*
use compiler.loader.mcdc_aspect_binding.*
use std.nogc_sync_mut.io.coverage_mcdc.{mcdc_compiled_target}

describe "MC/DC dynamic aspect binding", tag: ["only-compiled"]:
    it "binds one increasing generation and settles after unbind":
        var binding = McdcAspectBinding.dormant()
        val target = mcdc_compiled_target()
        expect(target != 0u64).to_equal(true)
        expect(binding.bind(target, 1).is_ok()).to_equal(true)
        expect(binding.bind(target, 2).is_err()).to_equal(true)
        expect(binding.unbind().is_ok()).to_equal(true)
        expect(binding.settle()).to_equal(Ok(true))

    it "rejects null targets and stale generations":
        var binding = McdcAspectBinding.dormant()
        expect(binding.bind(0u64, 1).is_err()).to_equal(true)
        val target = mcdc_compiled_target()
        expect(binding.bind(target, 1).is_ok()).to_equal(true)
        expect(binding.unbind().is_ok()).to_equal(true)
        expect(binding.settle()).to_equal(Ok(true))
        expect(binding.bind(target, 1).is_err()).to_equal(true)
