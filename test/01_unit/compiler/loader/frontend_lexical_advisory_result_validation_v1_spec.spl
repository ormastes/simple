use std.spec.*
use compiler.loader.frontend_lexical_advisory_adapter_v1.*
use compiler.frontend.frontend_advisory_preprocess_port_v1.FrontendAdvisoryPreprocessPolicyV1
use compiler.driver.environment_variant_sealed_activation_owner_v1.*
use compiler.loader.parser_structural_package_owner_v1.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_async_mut.structural.parse.lexical_block_summary_v1.*

fn vrzero() -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: 0u64, w1: 0u64, w2: 0u64, w3: 0u64)
fn vrstate() -> LexicalBlockStateV1:
    LexicalBlockStateV1(quote_kind: LexicalQuoteKindV1.None, escape_parity: false,
        in_line_comment: false, in_block_comment: false, pending_quote_byte: 0u8,
        pending_quote_run: 0u8, pending_raw_prefix: false, pending_identifier: false,
        pending_slash: false, after_newline: false)
fn vrsnapshot() -> EnvironmentSnapshotV1:
    val none = EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)
    val features = EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1, words: none)
    EnvironmentSnapshotV1(descriptor_size: 232u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        execution_architecture: ENV_ARCH_X86_64_V1, os_id: 1u32, abi_id: 1u32,
        object_format_id: 1u32, endian_id: 1u16, pointer_width_bits: 64u16,
        snapshot_identity: vrzero(), snapshot_generation: 0u64,
        execution_domain_identity: vrzero(), hardware_features: features,
        os_usable_features: features, policy_allowed_features: features,
        vector_state_mode: ENV_VECTOR_NONE_V1, vector_length_bits: 0u32,
        loader_permission_bits: 0u64, allowed_effect_bits: 0u64,
        numerical_contract_id: 0u32, resource_layout_digest: vrzero(), gpu_devices: none)
fn reference_result() -> FrontendLexicalAdvisoryAdapterResultV1:
    frontend_lexical_advisory_adapter_run_v1("abc",
        FrontendAdvisoryPreprocessPolicyV1.Reference,
        EnvironmentVariantSealedActivationOwnerV1.create(),
        EnvironmentVariantSealedActivationOwnerTokenV1(token_id: 0u64, owner_identity: 0u64),
        ParserStructuralPackageOwnerV1.create(),
        ParserStructuralPackageV2SessionV1(handle: 0u64, owner_identity: 0u64),
        vrsnapshot(), [], vrstate()).unwrap()

describe "frontend lexical advisory result V1 publication validation":
    it "accepts canonical lazy reference evidence":
        expect(frontend_lexical_advisory_adapter_result_valid_v1(reference_result())).to_equal(true)

    it "rejects copied receipt coverage substitution":
        var forged = reference_result()
        forged.receipt.scalar_tail_byte_count = 2u64
        expect(frontend_lexical_advisory_adapter_result_valid_v1(forged)).to_equal(false)

    it "rejects source substitution with an unchanged receipt":
        var forged = reference_result()
        forged.parse_source = "abd"
        expect(frontend_lexical_advisory_adapter_result_valid_v1(forged)).to_equal(false)
