use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI instantiation arity guard":
    it "rejects mismatched generic arguments before cache work":
        val handle = compiler_create_context()
        val result = compiler_instantiate_template_typed(handle, "pair", ["T", "U"], [make_int_type(64, true)])
        expect(result.success).to_equal(false)
        expect(result.has_error).to_equal(true)
        expect(result.error).to_equal("template type argument arity mismatch")
        expect(result.code.len()).to_equal(0)
        expect(compiler_get_stats(handle)).to_contain('"cache_misses": 0')
        expect(compiler_get_stats(handle)).to_contain('"template_instantiations": 0')
        compiler_destroy_context(handle)

    it "rejects arity that cannot be encoded in one byte":
        var names: [text] = []
        var types: [TypeInfo] = []
        var index = 0
        while index < 256:
            names.push("T" + index.to_string())
            types.push(make_int_type(64, true))
            index = index + 1
        val handle = compiler_create_context()
        val result = compiler_instantiate_template_typed(handle, "oversized", names, types)
        expect(result.success).to_equal(false)
        expect(result.error).to_equal("template type argument count exceeds bytecode limit")
        expect(result.code.len()).to_equal(0)
        expect(compiler_get_stats(handle)).to_contain('"cache_misses": 0')
        compiler_destroy_context(handle)
