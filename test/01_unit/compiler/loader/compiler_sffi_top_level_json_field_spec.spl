use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI top-level JSON fields":
    it "ignores field spellings embedded in string values":
        val json = '{"name":"decoy \\\"bits\\\":999","bits":32,"signed":true}'
        val ty = json_to_type_info_text(json)
        expect(ty.name).to_equal('decoy "bits":999')
        expect(ty.bits).to_equal(32)
        expect(ty.signed).to_equal(true)

    it "ignores nested fields before the top-level field":
        val json = '{"metadata":{"bits":8,"name":"nested"},"kind":"int","name":"outer","bits":64,"signed":true}'
        val ty = json_to_type_info_text(json)
        expect(ty.name).to_equal("outer")
        expect(ty.bits).to_equal(64)

    it "finds top-level arrays after nested and quoted decoys":
        val json = '{"metadata":{"type_params":["wrong"]},"name":"x type_params","type_params":["T","U"]}'
        val tmpl = parse_template_json(json)
        expect(tmpl.name).to_equal("x type_params")
        expect(tmpl.type_params).to_equal(["T", "U"])
