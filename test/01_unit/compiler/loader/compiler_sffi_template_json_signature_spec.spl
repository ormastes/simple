use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI template JSON signatures":
    it "decodes parameter and return types when supplied":
        val tmpl = parse_template_json(
            '{"name":"convert","type_params":["T"],"param_types":[{"kind":"int","name":"i32","bits":32,"signed":true}],"return_type":{"kind":"float","name":"f64","bits":64}}'
        )
        expect(tmpl.name).to_equal("convert")
        expect(tmpl.type_params).to_equal(["T"])
        expect(tmpl.param_types.len()).to_equal(1)
        expect(tmpl.param_types[0].name).to_equal("i32")
        expect(tmpl.param_types[0].bits).to_equal(32)
        expect(tmpl.has_return_type).to_equal(true)
        expect(tmpl.return_type.name).to_equal("f64")
        expect(tmpl.return_type.bits).to_equal(64)

    it "keeps absent signature fields absent and cache-distinct":
        val minimal = parse_template_json('{"name":"convert","type_params":["T"]}')
        val complete = parse_template_json(
            '{"name":"convert","type_params":["T"],"param_types":[{"kind":"int","bits":32}],"return_type":{"kind":"int","bits":64,"signed":true}}'
        )
        expect(minimal.param_types.len()).to_equal(0)
        expect(minimal.has_return_type).to_equal(false)
        expect(template_to_cache_key(minimal) == template_to_cache_key(complete)).to_equal(false)

    it "emits the supplied return type through the JSON API":
        val handle = compiler_create_context()
        val result_json = compiler_instantiate_template(
            handle,
            '{"name":"identity","type_params":["T"],"return_type":{"kind":"float","bits":64}}',
            '[{"kind":"int","bits":64,"signed":true}]'
        )
        val code = compiler_result_json_code(result_json)
        expect(compiler_result_json_success(result_json)).to_equal(true)
        expect(code[2]).to_equal(0x20)
        compiler_destroy_context(handle)
