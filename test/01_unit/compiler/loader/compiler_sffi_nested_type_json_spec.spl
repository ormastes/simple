use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI nested TypeInfo JSON":
    it "round-trips lanes arguments and element identity":
        val i32_ty = make_int_type(32, true)
        val element = TypeInfo(
            kind: "array", name: "Row", has_bits: false, bits: 0,
            has_signed: false, signed: false, has_lanes: false, lanes: 0,
            args: [i32_ty], has_elem: true, elem: i32_ty
        )
        val vector = TypeInfo(
            kind: "simd", name: "Rows", has_bits: true, bits: 64,
            has_signed: false, signed: false, has_lanes: true, lanes: 8,
            args: [element, i32_ty], has_elem: true, elem: element
        )
        val wire = serialize_types_json([vector])
        val parsed = parse_types_json(wire)
        expect(parsed.len()).to_equal(1)
        expect(parsed[0].lanes).to_equal(8)
        expect(parsed[0].args.len()).to_equal(2)
        expect(parsed[0].args[0].name).to_equal("Row")
        expect(parsed[0].args[0].args[0].name).to_equal("i32")
        expect(parsed[0].has_elem).to_equal(true)
        expect(parsed[0].elem.elem.name).to_equal("i32")
        expect(types_to_key(parsed)).to_equal(types_to_key([vector]))

    it "keeps absent nested fields absent and scalar wire stable":
        val scalar = make_int_type(64, true)
        val wire = serialize_type_json(scalar)
        val parsed = json_to_type_info_text(wire)
        expect(wire).to_equal('{"kind":"int","name":"i64","bits":64,"signed":true}')
        expect(parsed.args.len()).to_equal(0)
        expect(parsed.has_elem).to_equal(false)
        expect(parsed.has_lanes).to_equal(false)
