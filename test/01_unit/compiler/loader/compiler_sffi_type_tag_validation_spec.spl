use compiler.loader.loader.compiler_sffi.*

fn valid_single_param_code(tag: u8) -> [u8]:
    [0x00, 1, 0x00, 0x01, tag, 8, 0x10, 0x20, 0, tag, 0xFE, 0xFF, tag]

describe "Compiler SFFI bytecode type tags":
    it "accepts every tag emitted by the specialization producer":
        val handle = compiler_create_context()
        for tag in [0x10u8, 0x11u8, 0x20u8, 0x30u8, 0x40u8, 0x50u8, 0x60u8, 0x70u8]:
            expect(compiler_check_types(handle, valid_single_param_code(tag))).to_equal(true)
        compiler_destroy_context(handle)

    it "continues to reject an unknown parameter tag":
        val handle = compiler_create_context()
        expect(compiler_check_types(handle, valid_single_param_code(0x12))).to_equal(false)
        compiler_destroy_context(handle)
