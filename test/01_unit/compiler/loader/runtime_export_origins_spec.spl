# The curated loader facade must name physical owners for these runtime types.
use std.io_runtime.{read_file_text}

describe "curated loader runtime export origins":
    it "routes compiler and JIT types to their defining loader modules":
        val facade = read_file_text("src/compiler/99.loader/runtime/__init__.spl")
        expect(facade).to_contain("export use compiler.loader.loader.compiler_sffi.{CompilerContext}")
        expect(facade).to_contain("export use compiler.loader.loader.jit_context.{JitCompilationContext}")
        expect(facade).to_contain("export use compiler.loader.loader.jit_instantiator.{JitInstantiationResult}")
        expect(read_file_text("src/compiler/99.loader/loader/compiler_sffi.spl")).to_contain("struct CompilerContext:")
        expect(read_file_text("src/compiler/99.loader/loader/jit_context.spl")).to_contain("struct JitCompilationContext:")
        expect(read_file_text("src/compiler/99.loader/loader/jit_instantiator.spl")).to_contain("enum JitInstantiationResult:")

    it "routes sweeper and resource types to their defining loader modules":
        val facade = read_file_text("src/compiler/99.loader/runtime/__init__.spl")
        expect(facade).to_contain("export use compiler.loader.loader.generation_sweeper.{SweeperConfig, SweeperStats, GenerationSweeper}")
        expect(facade).to_contain("export use compiler.loader.loader.resource_lifecycle.{OwnedResources}")
        val sweeper = read_file_text("src/compiler/99.loader/loader/generation_sweeper.spl")
        expect(sweeper).to_contain("struct SweeperConfig:")
        expect(sweeper).to_contain("struct SweeperStats:")
        expect(sweeper).to_contain("class GenerationSweeper:")
        expect(read_file_text("src/compiler/99.loader/loader/resource_lifecycle.spl")).to_contain("struct OwnedResources:")

    it "routes module and mapper types to their defining modules":
        val facade = read_file_text("src/compiler/99.loader/runtime/__init__.spl")
        expect(facade).to_contain("export use compiler.loader.module_loader_compat.{ModuleLoader}")
        expect(facade).to_contain("export use compiler.loader.loader.module_loader_lib_support.{ModuleLoaderWithLibs}")
        expect(facade).to_contain("export use compiler.loader.loader.object_mapper.{ResolvedSymbol}")
        expect(read_file_text("src/compiler/99.loader/module_loader_compat.spl")).to_contain("struct ModuleLoader:")
        expect(read_file_text("src/compiler/99.loader/loader/module_loader_lib_support.spl")).to_contain("struct ModuleLoaderWithLibs:")
        expect(read_file_text("src/compiler/99.loader/loader/object_mapper.spl")).to_contain("struct ResolvedSymbol:")
