"""Authored, intentionally unexecuted ownership/race contract for final unpin V2.

The assertions are static until the mapping-receipt producer and mapper-owned
release port land in the same integration lane. They prevent this prerequisite
from being mistaken for an executable unmap implementation.
"""

use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

fn registry_source() -> text:
    rt_file_read_text("src/compiler/99.loader/aspect_final_unpin_registry.spl")

fn pack_source() -> text:
    rt_file_read_text("src/lib/common/aspect_pack.spl")

describe "aspect final unpin V2 ownership contract":
    it "AUTHORED-UNEXECUTED REQ-AFU-01 carries only pointer-free receipt identity":
        val source = registry_source()
        expect(source).to_contain("struct AspectMapperBindingReceiptV1")
        expect(source).to_contain("mapper_owner_id: text")
        expect(source).to_contain("mapping_id: text")
        expect(source).to_contain("mapping_generation: i64")
        expect(source).to_contain("release_port_id: text")
        expect(source.contains("raw_ptr")).to_equal(false)
        expect(source.contains("native_free_exec_memory")).to_equal(false)

    it "AUTHORED-UNEXECUTED REQ-AFU-02 stages exact final pin before owner release":
        val source = pack_source()
        expect(source).to_contain("fn apk_facet_final_unpin_stage_v2")
        expect(source).to_contain("_fc_state[i] != APK_FC_QUIESCING or _fc_refs[i] != 1")
        expect(source).to_contain("APK_FINAL_UNPIN_GENERATION_MISMATCH")
        expect(source).to_contain("APK_FINAL_UNPIN_ALREADY_STAGED")
        expect(source).to_contain("final unpin is staged")

    it "AUTHORED-UNEXECUTED REQ-AFU-03 rejects forged mapper owner or port before commit":
        val source = registry_source()
        expect(source).to_contain("mapper_owner_id != binding.mapper_owner_id")
        expect(source).to_contain("release_port_id != binding.release_port_id")
        expect(source).to_contain("stage.mapping_id != binding.mapping_id")
        expect(source).to_contain("stage.mapping_generation != binding.mapping_generation")

    it "AUTHORED-UNEXECUTED REQ-AFU-04 race outcome is deterministic commit or rollback":
        val source = registry_source()
        expect(source).to_contain("self.staged = self.staged.remove(key)")
        expect(source).to_contain("apk_facet_final_unpin_rollback_v2(stage)")
        expect(source).to_contain("apk_facet_final_unpin_commit_v2(stage)")
        expect(source).to_contain("self.staged[key] = stage")

    it "AUTHORED-UNEXECUTED NFR-AFU-01 bounds registry and tombstone growth":
        val source = registry_source()
        expect(source).to_contain("ASPECT_FINAL_UNPIN_MAX_BINDINGS_V1: i64 = 1024")
        expect(source).to_contain("ASPECT_FINAL_UNPIN_MAX_TOMBSTONES_V1: i64 = 1024")
        expect(source).to_contain("self.bindings.keys().len() >= ASPECT_FINAL_UNPIN_MAX_BINDINGS_V1")
        expect(source).to_contain("self.tombstones = self.tombstones.remove(evicted)")
