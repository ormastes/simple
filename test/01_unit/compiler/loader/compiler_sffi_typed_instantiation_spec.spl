use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI typed instantiation":
    it "instantiates and caches without a JSON wire round trip":
        val handle = compiler_create_context()
        val result = compiler_instantiate_template_typed(
            handle, "identity", ["T"], [make_int_type(64, true)]
        )
        expect(result.success).to_equal(true)
        expect(compiler_check_types(handle, result.code)).to_equal(true)

        val cached = compiler_instantiate_template_typed(
            handle, "identity", ["T"], [make_int_type(64, true)]
        )
        expect(cached.code).to_equal(result.code)
        expect(compiler_get_stats(handle).contains('"cache_hits": 1')).to_equal(true)
        compiler_destroy_context(handle)
