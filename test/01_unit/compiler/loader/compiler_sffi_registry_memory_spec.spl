use compiler.loader.loader.compiler_sffi.{
    compiler_context_registry_count,
    compiler_context_registry_index_words,
    compiler_create_context,
    compiler_destroy_context,
}

describe "compiler context registry memory":
    it "stores one ownership index word per live context":
        step("create many independent compiler contexts")
        var handles: [i64] = []
        for _ in 0..1024:
            handles.push(compiler_create_context())

        expect(compiler_context_registry_count()).to_equal(1024)
        expect(compiler_context_registry_index_words()).to_equal(1024)

        step("destroy contexts in reverse order without rebuilding a shadow index")
        var index = handles.length() - 1
        while index >= 0:
            compiler_destroy_context(handles[index])
            index = index - 1

        expect(compiler_context_registry_count()).to_equal(0)
        expect(compiler_context_registry_index_words()).to_equal(0)
