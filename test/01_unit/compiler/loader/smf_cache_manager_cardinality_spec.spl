"""Production SMF cache-manager cardinality invariant."""

use std.spec.step
use compiler.loader.loader.smf_cache_manager.{
    smfcachemanager_with_new_cache, smfcachemanager_ref_count_inc,
    smfcachemanager_ref_count_dec, smfcachemanager_get_ref_count,
    smfcachemanager_force_clear, smfcachemanager_tracked_count
}

describe "SMF cache manager cardinality":
    it "counts paths rather than total references":
        # @req NFR-SMF-CACHE-MANAGER-COUNT-001
        step("retain two paths with one path referenced twice")
        val manager = smfcachemanager_with_new_cache()
        smfcachemanager_ref_count_inc(manager, "a.smf")
        smfcachemanager_ref_count_inc(manager, "a.smf")
        smfcachemanager_ref_count_inc(manager, "b.smf")
        expect(smfcachemanager_tracked_count(manager)).to_equal(2)
        expect(smfcachemanager_get_ref_count(manager, "a.smf")).to_equal(2)

    it "updates scalar count on final release and clear":
        # @req NFR-SMF-CACHE-MANAGER-COUNT-002
        step("release the final reference for one path")
        val manager = smfcachemanager_with_new_cache()
        smfcachemanager_ref_count_inc(manager, "a.smf")
        smfcachemanager_ref_count_inc(manager, "b.smf")
        smfcachemanager_ref_count_dec(manager, "a.smf")
        expect(smfcachemanager_tracked_count(manager)).to_equal(1)
        step("clear dictionary and scalar owners together")
        smfcachemanager_force_clear(manager)
        expect(smfcachemanager_tracked_count(manager)).to_equal(0)
