# @req: REQ-BUILD-SRC-001
# RB-LOAD-02: lockless rollback of an admitted swap whose load then failed,
# so the slot never ends a generation ahead of the module.
# todo (remaining scope): doc/08_tracking/todo/rb_load_hot_swap_pinning_2026-11-22.md
use std.spec.*
use std.spec.step

use compiler.driver.smf_writer.{SmfBuildOptions, Target, generate_smf_with_options}
use compiler.driver.unit_identity.{UnitIdentity, unit_identity_encode}
use compiler.driver.watcher.smf_manifest.{SmfManifestEntry, smf_manifest_entry_new_with_identity}
use compiler.loader.hot_swap_pin.{HotSwapSlot, hot_swap_slot_load, hot_swap_try, hot_swap_read_begin, hot_swap_read_end, hot_swap_reclaim, hot_swap_image_live, hot_swap_rollback}

fn good_identity() -> UnitIdentity:
    UnitIdentity(
        iface_digest: "iface-v1-1111",
        abi_digest: "abi-v1-aaaa",
        target_triple: "x86_64-unknown-linux-gnu",
        policy: "release",
        capabilities: ["io"])

fn image_with(id: UnitIdentity, code: u8) -> [u8]:
    var opts = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
    opts.unit_identity_bytes = unit_identity_encode(id).bytes()
    generate_smf_with_options([code, 0xC3], opts)

fn pinned_row() -> SmfManifestEntry:
    val id = good_identity()
    smf_manifest_entry_new_with_identity(
        "hs_unit.spl", "build/hs_unit.smf", 1, "cranelift", 0, true, false, false,
        id.policy, id.capabilities, id.iface_digest, id.abi_digest, [], [], id.target_triple)

fn loaded_slot() -> HotSwapSlot:
    hot_swap_slot_load(pinned_row(), image_with(good_identity(), 0x90)).unwrap()
describe "RB-LOAD-02: hot-swap rollback after a failed load":
    it "rolls the generation back and readers get the old image":
        # @req: REQ-BUILD-SRC-001
        val slot = loaded_slot()
        val v0 = image_with(good_identity(), 0x90)
        step("admit generation 1, then roll it back")
        val next = hot_swap_try(slot, 0, image_with(good_identity(), 0x91)).unwrap()
        expect(hot_swap_rollback(slot, next).unwrap()).to_equal(0)
        val r = hot_swap_read_begin(slot).unwrap()
        expect(r.generation()).to_equal(0)
        expect(r.image() == v0).to_equal(true)
        hot_swap_read_end(r)
        expect(hot_swap_image_live(slot, 1)).to_equal(false)

    it "refuses a rollback of a generation that is not current":
        val slot = loaded_slot()
        expect(hot_swap_rollback(slot, 3).unwrap_err().contains("SMF-E-HOTSWAP-STALE")).to_equal(true)
        expect(slot.current_generation()).to_equal(0)

    it "a rolled-back entry still pinned by a reader is reclaimed later":
        val slot = loaded_slot()
        val next = hot_swap_try(slot, 0, image_with(good_identity(), 0x91)).unwrap()
        val held = hot_swap_read_begin(slot).unwrap()
        expect(held.generation()).to_equal(1)
        expect(hot_swap_rollback(slot, next).is_ok()).to_equal(true)
        expect(hot_swap_image_live(slot, 1)).to_equal(true)
        hot_swap_read_end(held)
        expect(hot_swap_reclaim(slot)).to_equal(1)
        step("the next swap reuses the entry")
        expect(hot_swap_try(slot, 0, image_with(good_identity(), 0x92)).unwrap()).to_equal(1)
