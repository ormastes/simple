use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI wire serialization":
    it "serializes and parses concrete type arrays without placeholders":
        val wire = serialize_types_json([make_int_type(64, true), make_bool_type()])
        expect(wire).to_equal('[{"kind":"int","name":"i64","bits":64,"signed":true},{"kind":"bool","name":"bool","bits":1}]')
        val parsed = parse_types_json(wire)
        expect(parsed.len()).to_equal(2)
        expect(parsed[0].name).to_equal("i64")
        expect(parsed[1].bits).to_equal(1)

    it "serializes numeric compiler statistics without placeholders":
        val handle = compiler_create_context()
        val wire = compiler_get_stats(handle)
        expect(wire.contains('"type_inferences": 0')).to_equal(true)
        expect(wire.contains("{stats.")).to_equal(false)
        compiler_destroy_context(handle)
