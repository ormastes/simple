use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI value shapes":
    it "constructs primitive type values with explicit presence fields":
        val signed = make_int_type(64, true)
        expect(signed.name).to_equal("i64")
        expect(signed.has_bits).to_equal(true)
        expect(signed.has_signed).to_equal(true)
        expect(signed.signed).to_equal(true)

        val float_ty = make_float_type(32)
        expect(float_ty.name).to_equal("f32")
        expect(float_ty.has_bits).to_equal(true)
        expect(float_ty.has_signed).to_equal(false)

        val bool_ty = make_bool_type()
        expect(bool_ty.bits).to_equal(1)
        expect(bool_ty.has_bits).to_equal(true)

        expect(make_string_type().has_bits).to_equal(false)
        expect(make_named_type("Widget").name).to_equal("Widget")
        expect(make_named_type("Widget").has_elem).to_equal(false)

    it "distinguishes absent false and true JSON optional fields":
        val absent = json_to_type_info_text('{"kind":"int","name":"i64"}')
        expect(absent.has_signed).to_equal(false)
        expect(absent.signed).to_equal(false)

        val explicit_false = json_to_type_info_text('{"kind":"int","name":"i64","signed":false}')
        expect(explicit_false.has_signed).to_equal(true)
        expect(explicit_false.signed).to_equal(false)

        val explicit_true = json_to_type_info_text('{"kind":"int","name":"i64","signed":true}')
        expect(explicit_true.has_signed).to_equal(true)
        expect(explicit_true.signed).to_equal(true)

    it "serializes success and error result wire shapes":
        val success = CompilationResult(success: true, code: [1, 2, 3], has_error: false, error: "")
        expect(serialize_compilation_result(success)).to_equal('{"success":true,"code":[1,2,3]}')

        val failure = CompilationResult(success: false, code: [], has_error: true, error: "boom")
        expect(serialize_compilation_result(failure)).to_equal('{"success":false,"error":"boom"}')

    it "creates and destroys a registry-backed context":
        val handle = compiler_create_context()
        expect(handle).to_be_greater_than(0)
        compiler_destroy_context(handle)
