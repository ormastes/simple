use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI JSON escaping":
    it "escapes type kind and name strings":
        val ty = TypeInfo(
            kind: "named\nkind", name: "A\\B\"C", has_bits: false, bits: 0,
            has_signed: false, signed: false, has_lanes: false, lanes: 0,
            args: [], has_elem: false, elem: nil
        )
        val wire = serialize_type_json(ty)
        # NOTE: single-quoted string literals in Simple are raw (no backslash
        # escape processing — verified: '\\n' has length 2, "\\n" has length
        # 1), so the expected JSON text below is written as a double-quoted
        # literal with real escape sequences instead.
        expect(wire).to_equal("{\"kind\":\"named\\nkind\",\"name\":\"A\\\\B\\\"C\"}")
        expect(wire.contains("\n")).to_equal(false)

    it "escapes failure text without changing successful bytecode JSON":
        val failure = CompilationResult(
            success: false, code: [], has_error: true,
            error: "bad \"type\"\\path\nnext"
        )
        val failed_wire = serialize_compilation_result(failure)
        expect(failed_wire).to_equal("{\"success\":false,\"error\":\"bad \\\"type\\\"\\\\path\\nnext\"}")

        val success = CompilationResult(
            success: true, code: [1u8, 2u8], has_error: false, error: ""
        )
        expect(serialize_compilation_result(success)).to_equal('{"success":true,"code":[1,2]}')
