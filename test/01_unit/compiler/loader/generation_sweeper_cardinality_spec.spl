"""Production generation-sweeper cardinality invariant."""

use std.spec.step
use compiler.loader.loader.generation_sweeper.{
    SweeperConfig, sweeper_new, sweeper_mark_used, sweeper_tracked_count,
    sweeper_advance_epoch, sweeper_reset
}

describe "generation sweeper cardinality":
    it "counts unique tracked symbols without materializing dictionary keys":
        # @req NFR-SWEEPER-COUNT-001
        step("mark two unique symbols and refresh one")
        val sweeper = sweeper_new(SweeperConfig(max_age: 10, jit_only: true, verbose: false))
        sweeper_mark_used(sweeper, "alpha")
        sweeper_mark_used(sweeper, "beta")
        _ = sweeper_advance_epoch(sweeper)
        sweeper_mark_used(sweeper, "alpha")
        expect(sweeper_tracked_count(sweeper)).to_equal(2)

    it "resets dictionary and scalar cardinality together":
        # @req NFR-SWEEPER-COUNT-002
        step("populate and reset the production sweeper")
        val sweeper = sweeper_new(SweeperConfig(max_age: 10, jit_only: false, verbose: false))
        sweeper_mark_used(sweeper, "one")
        sweeper_mark_used(sweeper, "two")
        sweeper_reset(sweeper)
        expect(sweeper_tracked_count(sweeper)).to_equal(0)
