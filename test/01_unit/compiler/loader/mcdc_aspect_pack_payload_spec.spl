use std.spec.*
use compiler.loader.mcdc_aspect_pack_payload.*

describe "MC/DC executable aspect-pack payload contract":
    it "builds one bounded inner SMF with only vector and exact ABI marker exports":
        # RET is sufficient for container/loader validation; execution ABI is
        # independently pinned by mcdc_vector_aspect_payload_selfcheck.c.
        val built = mcdc_build_aspect_module_payload_v1([0xC3u8])
        expect(built.is_ok()).to_equal(true)
        val checked = mcdc_validate_aspect_module_payload_v1(built.unwrap())
        expect(checked.ok).to_equal(true)
        expect(checked.vector_code).to_equal([0xC3u8])
        expect(checked.marker_bytes).to_equal([MCDC_ASPECT_MARKER_VALUE_V1])

    it "rejects empty and non-SMF payloads before mapping":
        expect(mcdc_validate_aspect_module_payload_v1([]).ok).to_equal(false)
        expect(mcdc_validate_aspect_module_payload_v1([1u8, 2u8, 3u8]).ok).to_equal(false)

    it "packages the validated executable inner SMF as one stored aligned module":
        val pack = mcdc_build_aspect_pack_v1([0xC3u8])
        expect(pack.ok).to_equal(true)
        expect(pack.module_count).to_equal(1)
        expect(pack.bytes.len()).to_be_greater_than(0)
