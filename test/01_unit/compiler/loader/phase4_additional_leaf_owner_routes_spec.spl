use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}

fn phase4_named_import_owner(path: text, name: text) -> text:
    val source = file_read(path)
    val parsed = parse_and_build_module(source, path)
    for imported in parsed.imports:
        for item in imported.items:
            if item.name == name:
                return imported.module
    ""

describe "Phase4 additional leaf owner routes":
    it "selects the actual typed JIT SFFI implementation instead of compatibility facade":
        expect(phase4_named_import_owner(
            "src/compiler/99.loader/loader/jit_instantiator.spl",
            "compiler_instantiate_template_typed"
        )).to_equal("compiler.loader.loader.compiler_sffi")

    it "keeps the existing raw rename API at its declaring runtime owner":
        expect(phase4_named_import_owner(
            "src/lib/gc_async_mut/io/file_ops.spl", "rt_file_rename"
        )).to_equal("std.nogc_sync_mut.io_runtime")

    it "selects the declared debug owner without manufacturing debug support":
        expect(phase4_named_import_owner(
            "src/lib/nogc_async_mut/io.spl", "rt_debug_add_breakpoint_at"
        )).to_equal("std.nogc_sync_mut.io.debug_stubs")
        expect(phase4_named_import_owner(
            "src/lib/nogc_async_mut/io.spl", "nonexistent_debug_owner_case"
        )).to_equal("")
