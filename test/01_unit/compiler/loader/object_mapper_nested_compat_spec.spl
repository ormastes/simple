# The historical compiler.loader.loader object-mapper spelling retains its
# original i32 counters while delegating memory semantics to SegmentMapper.
# SharedExecMapper is reference-semantic so policy-wrapper mutations remain
# visible to their caller on every engine.
use compiler.loader.loader.object_mapper.{
    SharedExecMapper, SharedExecMapperConfig,
    LoaderMapper, LoaderMapperConfig, JitMapper, JitMapperConfig
}
use compiler.loader.loader.smf_mmap_native.{compat_native_call_function_0_i64}

fn nested_tiny_code(value: i64) -> [u8]:
    [184, (value & 0xFF) as u8, 0, 0, 0, 195]

fn nested_execute(address: i64) -> i64:
    compat_native_call_function_0_i64(address)

describe "nested object mapper compatibility adapter":
    it "preserves i32 statistics and unmap ABI around executable mapping":
        var mapper = SharedExecMapper.new(SharedExecMapperConfig(verbose: false))
        val mapped = mapper.map_symbol("nested_owner", "nested_fn", nested_tiny_code(7), false)
        expect(mapped.is_ok()).to_equal(true)
        expect(nested_execute(mapped.unwrap())).to_equal(7)

        val mapped_symbols: i32 = mapper.stats().mapped_symbols
        val generation: i32 = mapper.stats().generation
        val removed: i32 = mapper.unmap_owner("nested_owner")
        expect(mapped_symbols).to_equal(1)
        expect(generation).to_equal(1)
        expect(removed).to_equal(1)
        expect(mapper.stats().mapped_symbols).to_equal(0)

    it "keeps LoaderMapper mutations visible to its caller":
        var mapper = SharedExecMapper.new(SharedExecMapperConfig(verbose: false))
        val policy = LoaderMapper.new(LoaderMapperConfig(allow_replace_on_reload: false))
        val mapped = policy.map(mapper, "loader_owner", "loader_fn", nested_tiny_code(17), false)
        expect(mapped.is_ok()).to_equal(true)
        expect(mapper.lookup("loader_fn").unwrap()).to_equal(mapped.unwrap())
        expect(nested_execute(mapped.unwrap())).to_equal(17)
        expect(policy.unmap_owner(mapper, "loader_owner")).to_equal(1)
        expect(mapper.lookup("loader_fn") == nil).to_equal(true)

    it "keeps JitMapper mutations visible and applies its default owner":
        var mapper = SharedExecMapper.new(SharedExecMapperConfig(verbose: false))
        val policy = JitMapper.new(JitMapperConfig(default_owner: "nested_jit", allow_replace: true))
        val mapped = policy.map(mapper, "", "jit_fn", nested_tiny_code(27))
        expect(mapped.is_ok()).to_equal(true)
        expect(mapper.get_record("jit_fn").unwrap().owner_id).to_equal("nested_jit")
        expect(nested_execute(mapped.unwrap())).to_equal(27)
        expect(policy.unmap_owner(mapper, "nested_jit")).to_equal(1)
        expect(mapper.stats().mapped_symbols).to_equal(0)
