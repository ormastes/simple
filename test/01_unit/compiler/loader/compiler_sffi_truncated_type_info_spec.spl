use compiler.loader.loader.compiler_sffi.{
    compiler_create_context, compiler_destroy_context, compiler_check_types
}

describe "compiler SFFI bytecode type-info bounds":
    it "rejects a truncated TYPE_INFO record after an otherwise valid function":
        val handle = compiler_create_context()
        val complete: [u8] = [0x00, 0x00, 0x00, 0x10, 0xFE, 0xFF, 0x10]
        val truncated: [u8] = [0x00, 0x00, 0x00, 0x10, 0xFE, 0xFF]

        expect(compiler_check_types(handle, complete)).to_equal(true)
        expect(compiler_check_types(handle, truncated)).to_equal(false)
        compiler_destroy_context(handle)
