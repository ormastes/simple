use std.spec
use compiler.loader.smf_mmap_native.{
    native_mmap_file as compatibility_native_mmap_file,
    PROT_READ as COMPATIBILITY_PROT_READ,
    MAP_PRIVATE as COMPATIBILITY_MAP_PRIVATE
}
use compiler.loader.loader.smf_mmap_native.{
    native_mmap_file as canonical_native_mmap_file,
    PROT_READ as CANONICAL_PROT_READ,
    MAP_PRIVATE as CANONICAL_MAP_PRIVATE
}

extern fn rt_file_read_text(path: text) -> text

describe "loader mmap direct-file compatibility facade":
    it "preserves the canonical tuple contract through the legacy module path":
        val (compatibility_address, compatibility_size) = compatibility_native_mmap_file(
            "", COMPATIBILITY_PROT_READ, COMPATIBILITY_MAP_PRIVATE, -1, 0
        )
        val (canonical_address, canonical_size) = canonical_native_mmap_file(
            "", CANONICAL_PROT_READ, CANONICAL_MAP_PRIVATE, -1, 0
        )

        expect(compatibility_address).to_equal(canonical_address)
        expect(compatibility_size).to_equal(canonical_size)
        expect(compatibility_address).to_equal(0)
        expect(compatibility_size).to_equal(0)

    it "keeps low-level mmap compatibility off the root loader package":
        val root_init = rt_file_read_text("src/compiler/99.loader/__init__.spl")
        expect(root_init.contains("native_mmap_file")).to_equal(false)

    it "keeps executable allocation telemetry in exactly the production root owner":
        val root = rt_file_read_text("src/compiler/99.loader/smf_mmap_native.spl")
        val nested = rt_file_read_text("src/compiler/99.loader/loader/smf_mmap_native.spl")
        expect(root.split("var EXEC_MEMORY_ALLOCS").len() - 1).to_equal(1)
        expect(nested.contains("var EXEC_MEMORY_ALLOCS")).to_equal(false)
        expect(nested.contains("native_alloc_exec_memory as owner_alloc_exec_memory")).to_equal(true)
        expect(nested.contains("native_free_exec_memory as owner_free_exec_memory")).to_equal(true)
        expect(nested.contains("owner_exec_memory_count()")).to_equal(true)
        expect(nested.contains("owner_exec_memory_total()")).to_equal(true)
        expect(root.split("extern fn rt_mprotect").len() - 1).to_equal(1)
        expect(nested.contains("extern fn rt_mprotect")).to_equal(false)
        expect(nested.contains("native_make_executable as owner_make_executable")).to_equal(true)
        expect(nested.contains("native_make_rw as owner_make_rw")).to_equal(true)
        expect(root.split("extern fn rt_mmap_raw").len() - 1).to_equal(1)
        expect(root.split("extern fn rt_munmap_raw").len() - 1).to_equal(1)
        expect(nested.contains("extern fn rt_mmap_raw")).to_equal(false)
        expect(nested.contains("extern fn rt_munmap_raw")).to_equal(false)
        expect(nested.contains("native_mmap_file as owner_mmap_file")).to_equal(true)
        expect(nested.contains("native_munmap as owner_munmap")).to_equal(true)
        expect(nested.contains("extern fn rt_array_data_ptr")).to_equal(false)
        expect(nested.contains("extern fn rt_ptr_write_bytes_raw")).to_equal(false)
        expect(nested.contains("extern fn rt_ptr_write_i32")).to_equal(false)
        expect(nested.contains("extern fn rt_ptr_write_i64")).to_equal(false)
        expect(nested.contains("native_write_exec_memory as owner_write_exec_memory")).to_equal(true)
        expect(nested.contains("native_reloc_write_i32 as owner_reloc_write_i32")).to_equal(true)
        expect(nested.contains("native_reloc_write_i64 as owner_reloc_write_i64")).to_equal(true)
        expect(nested.contains("native_alloc_rw_memory as owner_alloc_rw_memory")).to_equal(true)
        expect(nested.contains("native_call_function_0 as owner_call_function_0")).to_equal(true)
        expect(nested.contains("native_call_function_3 as owner_call_function_3")).to_equal(true)
        expect(nested.contains("fn_ptr as fn(")).to_equal(false)
        expect(nested.contains("extern fn ")).to_equal(false)
        expect(nested.contains("fn slice_from_raw_parts")).to_equal(false)
        expect(nested.contains("fn ptr_write_u8")).to_equal(false)
