use std.spec
use compiler.loader.smf_mmap_native.{
    native_mmap_file as compatibility_native_mmap_file,
    PROT_READ as COMPATIBILITY_PROT_READ,
    MAP_PRIVATE as COMPATIBILITY_MAP_PRIVATE
}
use compiler.loader.loader.smf_mmap_native.{
    native_mmap_file as canonical_native_mmap_file,
    PROT_READ as CANONICAL_PROT_READ,
    MAP_PRIVATE as CANONICAL_MAP_PRIVATE
}

extern fn rt_file_read_text(path: text) -> text

describe "loader mmap direct-file compatibility facade":
    it "preserves the canonical tuple contract through the legacy module path":
        val (compatibility_address, compatibility_size) = compatibility_native_mmap_file(
            "", COMPATIBILITY_PROT_READ, COMPATIBILITY_MAP_PRIVATE, -1, 0
        )
        val (canonical_address, canonical_size) = canonical_native_mmap_file(
            "", CANONICAL_PROT_READ, CANONICAL_MAP_PRIVATE, -1, 0
        )

        expect(compatibility_address).to_equal(canonical_address)
        expect(compatibility_size).to_equal(canonical_size)
        expect(compatibility_address).to_equal(0)
        expect(compatibility_size).to_equal(0)

    it "keeps low-level mmap compatibility off the root loader package":
        val root_init = rt_file_read_text("src/compiler/99.loader/__init__.spl")
        expect(root_init.contains("native_mmap_file")).to_equal(false)
