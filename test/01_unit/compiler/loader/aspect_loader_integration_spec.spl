use std.spec.{describe, it, assert_true, assert_eq}
use std.io_runtime.{dir_create_all, file_delete, file_write_bytes}
use std.common.aspect_pack.{
    ApkModuleSourceV2, ApkCatalogEntryV2,
    apk_build_pack_v2, apk_build_catalog_v2,
    APK_ENTRY_FACET, APK_ACT_LAZY_FACET
}
use std.common.string_core.{text_to_bytes}
use compiler.loader.aspect_acquisition.{
    loader_aspect_state_new, loader_aspect_register_pack,
    loader_aspect_acquire, loader_aspect_try_resident,
    loader_aspect_result_is_current, loader_aspect_result_ok,
    loader_aspect_result_found, loader_aspect_result_module_id,
    loader_aspect_result_pack_path, loader_aspect_result_from_cache,
    loader_aspect_result_payload_len, loader_aspect_result_payload_byte,
    loader_aspect_result_error_code,
    loader_aspect_index_cached_count, loader_aspect_index_bytes_read,
    loader_aspect_invalidate, loader_aspect_unload, loader_aspect_destroy,
    loader_aspect_provider_handle
}

val ASPECT_LOADER_DIR: text = "build/test/aspect_loader_integration"
val ASPECT_LOADER_PACK: text = "build/test/aspect_loader_integration/trace.apk"

fn _loader_pack_bytes() -> [u8]:
    var modules: [ApkModuleSourceV2] = []
    modules.push(ApkModuleSourceV2(
        module_id: "trace.core", aspect_id: "trace",
        module_abi_hash: "trace-abi-1", required_core_public_abi_hash: "",
        variant_fingerprint: "", payload: text_to_bytes("trace-payload")))
    apk_build_pack_v2(modules).bytes

fn _loader_catalog_bytes() -> [u8]:
    var entries: [ApkCatalogEntryV2] = []
    entries.push(ApkCatalogEntryV2(
        facet_key: "Widget/Traceable", pack_path: ASPECT_LOADER_PACK,
        module_id: "trace.core", entry_kind: APK_ENTRY_FACET,
        activation: APK_ACT_LAZY_FACET, abi_hash: "trace-abi-1"))
    apk_build_catalog_v2(entries).bytes

describe "loader-owned aspect acquisition":
    it "indexes a window, acquires by scalar handle, invalidates, and unloads":
        dir_create_all(ASPECT_LOADER_DIR)
        val pack = _loader_pack_bytes()
        file_delete(ASPECT_LOADER_PACK)
        assert_true(file_write_bytes(ASPECT_LOADER_PACK, pack), "fixture pack written")

        val state = loader_aspect_state_new()
        assert_eq(loader_aspect_register_pack(state, ASPECT_LOADER_PACK, pack), 1)
        assert_eq(loader_aspect_index_cached_count(state), 1)
        val index_bytes = loader_aspect_index_bytes_read(state)
        assert_true(index_bytes > 0, "index read is observable: {index_bytes}")
        assert_true(index_bytes < pack.len(), "index {index_bytes} stays below pack {pack.len()}")

        val loaded = loader_aspect_acquire(
            state, _loader_catalog_bytes(), "Widget/Traceable")
        assert_true(loader_aspect_result_is_current(loaded), "issued result is current")
        assert_true(loader_aspect_result_ok(loaded), "acquisition result is ok")
        assert_true(loader_aspect_result_found(loaded), "acquisition found the routed facet")
        assert_eq(loader_aspect_result_module_id(loaded), "trace.core")
        assert_eq(loader_aspect_result_pack_path(loaded), ASPECT_LOADER_PACK)
        assert_eq(loader_aspect_result_payload_len(loaded), 13)
        assert_eq(loader_aspect_result_payload_byte(loaded, 0), 116)

        val resident = loader_aspect_try_resident(state, "Widget/Traceable")
        assert_true(loader_aspect_result_found(resident), "resident lookup finds the binding")
        assert_true(loader_aspect_result_from_cache(resident), "resident lookup reports cache")

        assert_eq(loader_aspect_unload(state, ASPECT_LOADER_PACK), 1)
        assert_eq(loader_aspect_index_cached_count(state), 0)
        assert_true(not loader_aspect_result_is_current(loaded), "unload invalidates prior result epoch")
        assert_true(not loader_aspect_result_ok(loaded), "stale result cannot retain success authority")
        assert_true(not loader_aspect_result_found(loaded), "stale result cannot retain discovery authority")
        assert_eq(loader_aspect_result_payload_len(loaded), 0)
        assert_eq(loader_aspect_result_payload_byte(loaded, 0), -1)
        assert_eq(loader_aspect_result_error_code(loaded), "APK_LOADER_STALE_RESULT_HANDLE")
        val after_unload = loader_aspect_try_resident(state, "Widget/Traceable")
        assert_true(not loader_aspect_result_found(after_unload), "unloaded binding is not resident")

        assert_eq(loader_aspect_register_pack(state, ASPECT_LOADER_PACK, pack), 1)
        assert_true(loader_aspect_invalidate(state, ASPECT_LOADER_PACK), "explicit invalidation removes the rebuilt index")
        assert_true(not loader_aspect_invalidate(state, ASPECT_LOADER_PACK), "second invalidation is a miss")
        _ = loader_aspect_unload(state, ASPECT_LOADER_PACK)
        _ = loader_aspect_destroy(state)
        assert_eq(loader_aspect_provider_handle(state), -1)
        file_delete(ASPECT_LOADER_PACK)
