use std.spec
use std.string_core.{char_from_code}
use compiler.loader.loader.smf_mmap_native.{str_from_utf8_lossy}

describe "SMF mmap byte text conversion":
    it "decodes valid bytes and replaces invalid bytes":
        val decoded = str_from_utf8_lossy([65u8, 0xC2u8, 0xA2u8, 0xFFu8, 66u8])
        expect(decoded).to_equal("A" + char_from_code(162) + "?B")

    it "preserves empty ASCII and every valid UTF-8 width":
        expect(str_from_utf8_lossy([])).to_equal("")
        expect(str_from_utf8_lossy([0xC2u8, 0xA2u8])).to_equal(char_from_code(0xA2))
        expect(str_from_utf8_lossy([0xE2u8, 0x82u8, 0xACu8])).to_equal(char_from_code(0x20AC))
        expect(str_from_utf8_lossy([0xF0u8, 0x9Fu8, 0x98u8, 0x80u8])).to_equal(char_from_code(0x1F600))

    it "retains the legacy engine behavior for embedded NUL":
        # The legacy implementation was repeated text concatenation. Use that
        # exact operation as a differential oracle because native and
        # interpreter embedded-NUL behavior currently differs.
        val legacy = "A" + char_from_code(0) + "B"
        expect(str_from_utf8_lossy([65u8, 0u8, 66u8])).to_equal(legacy)

    it "preserves valid UTF-8 boundary scalars":
        expect(str_from_utf8_lossy([0xC2u8, 0x80u8])).to_equal(char_from_code(0x80))
        expect(str_from_utf8_lossy([0xDFu8, 0xBFu8])).to_equal(char_from_code(0x7FF))
        expect(str_from_utf8_lossy([0xE0u8, 0xA0u8, 0x80u8])).to_equal(char_from_code(0x800))
        expect(str_from_utf8_lossy([0xEFu8, 0xBFu8, 0xBFu8])).to_equal(char_from_code(0xFFFF))
        expect(str_from_utf8_lossy([0xF0u8, 0x90u8, 0x80u8, 0x80u8])).to_equal(char_from_code(0x10000))
        expect(str_from_utf8_lossy([0xF4u8, 0x8Fu8, 0xBFu8, 0xBFu8])).to_equal(char_from_code(0x10FFFF))

    it "replaces each malformed or truncated input byte exactly once":
        expect(str_from_utf8_lossy([0x80u8, 0xC0u8, 0xC1u8, 0xF5u8, 0xFFu8])).to_equal("?????")
        expect(str_from_utf8_lossy([0xC2u8])).to_equal("?")
        expect(str_from_utf8_lossy([0xE2u8, 0x82u8])).to_equal("??")
        expect(str_from_utf8_lossy([0xF0u8, 0x9Fu8, 0x98u8])).to_equal("???")

    it "rejects overlong surrogate out-of-range and bad-continuation forms bytewise":
        expect(str_from_utf8_lossy([0xE0u8, 0x80u8, 0x80u8])).to_equal("???")
        expect(str_from_utf8_lossy([0xEDu8, 0xA0u8, 0x80u8])).to_equal("???")
        expect(str_from_utf8_lossy([0xF0u8, 0x80u8, 0x80u8, 0x80u8])).to_equal("????")
        expect(str_from_utf8_lossy([0xF4u8, 0x90u8, 0x80u8, 0x80u8])).to_equal("????")
        expect(str_from_utf8_lossy([0xE2u8, 65u8, 0xACu8])).to_equal("?A?")
        expect(str_from_utf8_lossy([0xF0u8, 65u8, 0x80u8, 0x80u8])).to_equal("?A??")
        expect(str_from_utf8_lossy([0xF0u8, 0x90u8, 65u8, 0x80u8])).to_equal("??A?")
        expect(str_from_utf8_lossy([0xF0u8, 0x90u8, 0x80u8, 65u8])).to_equal("???A")

    it "joins full decode chunks and a tail without changing order":
        var bytes: [u8] = []
        for _i in 0..63:
            bytes.push(97u8)
        bytes.push(88u8)
        bytes.push(89u8)
        for _i in 0..62:
            bytes.push(98u8)
        bytes.push(90u8)
        bytes.push(33u8)
        val expected = "a".repeat(63) + "XY" + "b".repeat(62) + "Z!"
        expect(str_from_utf8_lossy(bytes)).to_equal(expected)
