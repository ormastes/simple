"""Real module-loader import regression. Pure-Simple execution UNRUN."""
use std.spec.*
use compiler.loader.loader.module_loader.{mangle_name}
use compiler.loader.loader.compiler_sffi.{make_int_type, make_named_type}

describe "Module loader generic symbol identity through its real owner":
    it "preserves an uninstantiated symbol without adding a separator":
        expect(mangle_name("lookup", [])).to_equal("lookup")

    it "includes real concrete type names in the instantiated symbol":
        expect(mangle_name("lookup", [make_int_type(64, true)])).to_equal("lookup$i64")
        expect(mangle_name("lookup", [make_named_type("Widget")])).to_equal("lookup$Widget")

    it "preserves type argument order and distinguishes instantiated symbols":
        val integer = make_int_type(64, true)
        val widget = make_named_type("Widget")
        expect(mangle_name("pair", [integer, widget])).to_equal("pair$i64_Widget")
        expect(mangle_name("pair", [widget, integer])).to_equal("pair$Widget_i64")
        expect(mangle_name("pair", [integer, widget]) == mangle_name("pair", [])).to_equal(false)
