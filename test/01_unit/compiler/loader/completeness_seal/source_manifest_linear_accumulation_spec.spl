"""
# Source-manifest linear accumulation contract

Source-derived extension manifests preserve canonical payload spelling,
constructor and operation order, exact SDN bytes, and document order while
growing transient arrays with amortized-linear `push` operations.
"""

use std.spec.*
use std.io_runtime.{file_read}

describe "source-manifest accumulation":
    it "uses linear array growth throughout extraction and rendering":
        val source = file_read("src/compiler/99.loader/completeness_seal/source_manifest.spl")

        # This structural contract complements source_manifest_spec.spl's real
        # extraction, exact ordering, hash, rendering, and parser round-trip
        # assertions. It prevents a future rewrite from restoring prefix-copy
        # growth while keeping the same output on small fixtures.
        expect(source.count("parts.push(")).to_equal(1)
        expect(source.count("out.push(")).to_equal(3)
        expect(source.count("handlers.push(")).to_equal(1)
        expect(source.count("extends_list.push(")).to_equal(1)
        expect(source.count("lines.push(")).to_equal(26)

        expect(source.count("parts = parts + [")).to_equal(0)
        expect(source.count("out = out + [")).to_equal(0)
        expect(source.count("handlers = handlers + [")).to_equal(0)
        expect(source.count("extends_list = extends_list + [")).to_equal(0)
        expect(source.count("lines = lines + [")).to_equal(0)
