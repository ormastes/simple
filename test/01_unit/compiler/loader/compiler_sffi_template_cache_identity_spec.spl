use compiler.loader.loader.compiler_sffi.*

fn cache_template(name: text, generics: [text], params: [TypeInfo], has_return: bool, returns: TypeInfo) -> SffiTemplate:
    SffiTemplate(
        name: name, type_params: generics, param_types: params,
        has_return_type: has_return, return_type: returns
    )

describe "Compiler SFFI template cache identity":
    it "distinguishes generic arity and names for equal template names":
        val ty = make_int_type(64, true)
        val one = cache_template("same", ["T"], [ty], true, ty)
        val two = cache_template("same", ["T", "U"], [ty], true, ty)
        val renamed = cache_template("same", ["U"], [ty], true, ty)
        expect(template_to_cache_key(one) == template_to_cache_key(two)).to_equal(false)
        expect(template_to_cache_key(one) == template_to_cache_key(renamed)).to_equal(false)

    it "distinguishes parameter and return signatures during instantiation":
        val i64_ty = make_int_type(64, true)
        val f64_ty = make_float_type(64)
        val integers = cache_template("convert", ["T"], [i64_ty], true, i64_ty)
        val floats = cache_template("convert", ["T"], [f64_ty], true, f64_ty)
        expect(instantiation_cache_key(integers, [i64_ty]) == instantiation_cache_key(floats, [i64_ty])).to_equal(false)

    it "distinguishes absent returns and frames delimiter-bearing names":
        val ty = make_int_type(32, true)
        val absent = cache_template("a:b", ["T:X"], [], false, nil)
        val present = cache_template("a:b", ["T:X"], [], true, ty)
        val split = cache_template("a", ["b", "T:X"], [], false, nil)
        expect(template_to_cache_key(absent) == template_to_cache_key(present)).to_equal(false)
        expect(template_to_cache_key(absent) == template_to_cache_key(split)).to_equal(false)
