# Compatibility names encode their legacy return contract so they cannot
# collide with the canonical root Result/[i64] APIs in a co-compiled program.
use compiler.loader.loader.smf_mmap_native.{
    compat_native_mmap_file_tuple,
    compat_native_call_function_0_i64,
    compat_native_call_function_1_i64,
    compat_native_call_function_2_i64,
    compat_native_call_function_3_i64
}

describe "nested mmap compatibility return contracts":
    it "returns the historical tuple shape for rejected mmap input":
        val mapped: (i64, i64) = compat_native_mmap_file_tuple("", 0, 0, -1, 0)
        expect(mapped[0]).to_equal(0)
        expect(mapped[1]).to_equal(0)

    it "returns historical i64 sentinels for invalid call addresses":
        val call0: fn(i64) -> i64 = compat_native_call_function_0_i64
        val call1: fn(i64, i64) -> i64 = compat_native_call_function_1_i64
        val call2: fn(i64, i64, i64) -> i64 = compat_native_call_function_2_i64
        val call3: fn(i64, i64, i64, i64) -> i64 = compat_native_call_function_3_i64
        expect(call0(0)).to_equal(0)
        expect(call1(0, 1)).to_equal(0)
        expect(call2(0, 1, 2)).to_equal(0)
        expect(call3(0, 1, 2, 3)).to_equal(0)
