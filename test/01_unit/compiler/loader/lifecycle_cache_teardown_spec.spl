"""Lifecycle teardown clears orphaned SMF reference accounting through its canonical owner."""
use std.spec.*
use compiler.loader.resource_lifecycle.{lifecycle_with_defaults, lifecycle_destroy}
use compiler.loader.smf_cache_manager.{smfcachemanager_with_new_cache, smfcachemanager_ref_count_inc}
use compiler.loader.loader.object_mapper.{SharedExecMapper, SharedExecMapperConfig}

describe "Lifecycle cache teardown":
    it "clears orphaned cache references without requiring registered modules":
        val lifecycle = lifecycle_with_defaults(smfcachemanager_with_new_cache())
        smfcachemanager_ref_count_inc(lifecycle.smf_cache_mgr, "orphan.smf")
        expect(lifecycle.smf_cache_mgr.tracked_count).to_equal(1)
        expect(lifecycle.smf_cache_mgr.ref_counts.len()).to_equal(1)
        val mapper = SharedExecMapper.new(SharedExecMapperConfig.default())
        lifecycle_destroy(lifecycle, mapper)
        expect(lifecycle.smf_cache_mgr.tracked_count).to_equal(0)
        expect(lifecycle.smf_cache_mgr.ref_counts.len()).to_equal(0)
