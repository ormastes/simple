"""Bulk-copy controls for the portable aspect-pack range provider."""

use std.spec.{describe, it, expect, step}
use std.io_runtime.{file_write_bytes, file_delete, dir_create_all}
use compiler.loader.aspect_pack_io.{
    PackWindow, APKIO_MAX_RANGE_BYTES, pack_window_map,
    pack_window_bytes, pack_window_unmap, pack_read_range
}
use compiler.loader.smf_mmap_native.{native_mmap_read_bytes}

val BULK_DIR = "build/test/aspect_pack_bulk"
val BULK_PATH = "build/test/aspect_pack_bulk/range.bin"

fn bulk_test_window(address: i64, map_length: i64, delta: i64, length: i64) -> PackWindow:
    PackWindow(address: address, map_length: map_length, data_offset: delta,
        want_offset: delta, want_length: length, ok: true,
        error_code: "", error_message: "")

describe "aspect-pack bulk range copying":
    it "uses the exported native byte-copy owner on a live binary file mapping":
        step("Copy nontext bytes through the actual exported native bulk owner")
        dir_create_all(BULK_DIR)
        val original: [u8] = [3u8, 255u8, 128u8, 0u8, 192u8, 175u8, 7u8]
        expect(file_write_bytes(BULK_PATH, original)).to_equal(true)
        val window = pack_window_map(BULK_PATH, 1, 5)
        expect(window.ok).to_equal(true)
        var copied: [u8] = []
        unsafe(capabilities: [raw_ptr]):
            copied = native_mmap_read_bytes(window.address, window.data_offset, 5)
        expect(copied.len()).to_equal(5)
        for index in 0..5:
            expect(copied[index] as i64).to_equal(original[index + 1] as i64)
        expect(pack_window_unmap(window)).to_equal(true)
        expect(file_delete(BULK_PATH)).to_equal(true)

    it "copies an unaligned range across the Windows allocation granule":
        step("Verify every byte across the 64 KiB mapping granule")
        dir_create_all(BULK_DIR)
        var original: [u8] = []
        for index in 0..70000:
            original.push(((index * 13 + 255) & 255).to_u8())
        expect(file_write_bytes(BULK_PATH, original)).to_equal(true)
        val copied = pack_read_range(BULK_PATH, 65531, 4096)
        expect(copied.len()).to_equal(4096)
        for index in 0..4096:
            expect(copied[index] as i64).to_equal(original[65531 + index] as i64)
        expect(file_delete(BULK_PATH)).to_equal(true)

    it "refuses invalid window geometry before borrowing any pointer":
        step("Use an inaccessible pointer with invalid geometry to require fail-closed checks")
        expect(pack_window_bytes(bulk_test_window(1, 8, -1, 1)).len()).to_equal(0)
        expect(pack_window_bytes(bulk_test_window(1, 8, 7, 2)).len()).to_equal(0)
        expect(pack_window_bytes(bulk_test_window(1, 8, 0, 9)).len()).to_equal(0)
        expect(pack_window_bytes(bulk_test_window(1, 8, 0, 0)).len()).to_equal(0)
        expect(pack_window_bytes(bulk_test_window(1, APKIO_MAX_RANGE_BYTES + 1,
            0, APKIO_MAX_RANGE_BYTES + 1)).len()).to_equal(0)

    it "refuses pointer offset overflow before invoking the native copy owner":
        step("Reject wrapped pointer addition without dereferencing the synthetic address")
        val forged = bulk_test_window(9223372036854775807, 8, 1, 1)
        expect(pack_window_bytes(forged).len()).to_equal(0)
