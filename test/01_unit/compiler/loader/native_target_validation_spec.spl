"""
Purpose: Validate target-bound real SMF files and loaded-record refusal.
Evidence class: authored host fixture, UNRUN; no executable mapping success is claimed.
"""
# @req: REQ-GENERIC-CONFIG-TARGET-002
use std.spec
use std.spec.step
use compiler.backend.linker.smf_header.{SmfHeader}
use compiler.backend.linker.smf_enums.{Platform, Arch}
use compiler.backend.linker.smf_reader.{SmfReaderImpl}
use compiler.driver.cache.compile_options_hash.{compile_options_hash_compute, compile_options_hash_to_bytes}
use compiler.driver.watcher.watcher_client.{watcher_validate_generated_smf}
use compiler.driver.watcher.watcher_types.{watcher_config_default}
use compiler.driver.cache.cache_validator.{source_to_cache_path}
use compiler.loader.loader.smf_cache.{validated_smf_load}
use compiler.loader.loader.module_loader.{LoadedModule, LoadResult,
    lazymoduleloader_with_defaults, moduleloader_load_validated, moduleloader_any_heavy_service_created}
use std.io_runtime.{file_write, file_write_bytes, file_delete, getpid, hash_text}

fn target_fixture_options(target: text):
    compile_options_hash_compute("cranelift", 0, false, false, false, "dev", [], [], [], [], "moderate", -1, target)

fn target_fixture_write(path: text, source: text, target: text):
    var header = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)
    header.source_hash = hash_text(source)
    header.set_compile_options_bytes(compile_options_hash_to_bytes(target_fixture_options(target)))
    expect(file_write_bytes(path, header.to_bytes())).to_equal(true)

describe "REQ-GENERIC-CONFIG-TARGET-002 actual artifact validation":
    it "should reject regenerated bytes for a different target":
        step("Validate a real source and SMF header against a different requested target")
        val source_path = "/tmp/simple_target_source_{getpid()}.spl"
        val smf_path = "/tmp/simple_target_generated_{getpid()}.smf"
        val source = "fn value() -> i64: 1\n"
        expect(file_write(source_path, source)).to_equal(true)
        target_fixture_write(smf_path, source, "x86_64-unknown-linux-gnu")
        val result = watcher_validate_generated_smf(source_path, smf_path, target_fixture_options("aarch64-unknown-linux-gnu"))
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("compile options changed")
        expect(file_delete(smf_path)).to_equal(true)
        expect(file_delete(source_path)).to_equal(true)

    it "should retain dependency refusal even when target matches":
        step("Show matching target does not waive the existing dependency receipt")
        val source_path = "/tmp/simple_target_dependency_{getpid()}.spl"
        val smf_path = "/tmp/simple_target_dependency_{getpid()}.smf"
        val source = "fn value() -> i64: 1\n"
        expect(file_write(source_path, source)).to_equal(true)
        target_fixture_write(smf_path, source, "x86_64-unknown-linux-gnu")
        val result = watcher_validate_generated_smf(source_path, smf_path, target_fixture_options("x86_64-unknown-linux-gnu"))
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("dependency content receipt")
        expect(file_delete(smf_path)).to_equal(true)
        expect(file_delete(source_path)).to_equal(true)

    it "should forward explicit target through standalone validated loading":
        step("Open a real header with matching target then refuse a different target")
        val path = "/tmp/simple_target_load_{getpid()}.smf"
        target_fixture_write(path, "fn value() -> i64: 1\n", "x86_64-unknown-linux-gnu")
        val accepted = validated_smf_load(path, "unused.spl", "cranelift", 0, false, false, false, "dev", [], "x86_64-unknown-linux-gnu")
        expect(accepted.is_ok()).to_equal(true)
        val mapping = accepted.unwrap()
        expect(mapping.close()).to_equal(true)
        val rejected = validated_smf_load(path, "unused.spl", "cranelift", 0, false, false, false, "dev", [], "aarch64-unknown-linux-gnu")
        expect(rejected.is_err()).to_equal(true)
        expect(rejected.unwrap_err()).to_contain("SMF options mismatch")
        expect(file_delete(path)).to_equal(true)

    it "should refuse explicit target reuse of a loaded record without authority":
        step("Insert real parsed metadata and refuse both changed and repeated target requests")
        val path = "/tmp/simple_target_record_{getpid()}.smf"
        target_fixture_write(path, "fn value() -> i64: 1\n", "x86_64-unknown-linux-gnu")
        val reader_result = SmfReaderImpl.open(path)
        expect(reader_result.is_ok()).to_equal(true)
        var loader = lazymoduleloader_with_defaults()
        loader.modules[path] = LoadedModule(path: path, reader: reader_result.unwrap(), symbols: {}, load_time: 0, version: 1)
        for target in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]:
            val result = moduleloader_load_validated(loader, path, "cranelift", 0, false, false, false, "dev", [], target)
            match result:
                case LoadResult.Error(message):
                    expect(message).to_equal("SMF mapped target provenance unavailable; use a fresh loader")
                case _: fail("expected refusal for targetless loaded-record authority")
        expect(loader.modules.has(path)).to_equal(true)
        expect(moduleloader_any_heavy_service_created(loader)).to_equal(false)
        expect(file_delete(path)).to_equal(true)

    it "should also refuse an existing cached-output record reached through a source path":
        step("Check the derived SMF path before freshness or service creation")
        val source_path = "logical_target_fixture.spl"
        val fixture = "/tmp/simple_target_cached_record_{getpid()}.smf"
        target_fixture_write(fixture, "fn value() -> i64: 1\n", "x86_64-unknown-linux-gnu")
        val reader = SmfReaderImpl.open(fixture).unwrap()
        val config = watcher_config_default()
        val cached_path = source_to_cache_path(source_path, config.smf_dir, ".smf")
        var loader = lazymoduleloader_with_defaults()
        loader.modules[cached_path] = LoadedModule(path: cached_path, reader: reader, symbols: {}, load_time: 0, version: 1)
        val result = moduleloader_load_validated(loader, source_path, "cranelift", 0, false, false, false, "dev", [], "aarch64-unknown-linux-gnu")
        match result:
            case LoadResult.Error(message):
                expect(message).to_equal("SMF mapped target provenance unavailable; use a fresh loader")
            case _: fail("expected refusal for cached-path mapping without target authority")
        expect(loader.modules.has(cached_path)).to_equal(true)
        expect(moduleloader_any_heavy_service_created(loader)).to_equal(false)
        expect(file_delete(fixture)).to_equal(true)
