"""Freeze the root compatibility mapper's nominal and numeric API."""

use std.io_runtime.{read_file_text}

val ROOT_OBJECT_MAPPER = "src/compiler/99.loader/object_mapper.spl"
val CANONICAL_OBJECT_MAPPER = "src/compiler/99.loader/loader/object_mapper.spl"
val EXEC_MAPPING = "src/compiler/99.loader/loader/exec_mapping.spl"
val EXEC_NATIVE = "src/compiler/99.loader/loader/smf_mmap_native.spl"
val SHADOW_JIT = "src/compiler/99.loader/loader/jit_instantiator.spl"

describe "Object mapper public compatibility surface":
    it "keeps every exported compatibility type as a class":
        val source = read_file_text(ROOT_OBJECT_MAPPER)
        expect(source).to_contain("class SharedExecMapperConfig:")
        expect(source).to_contain("class SharedExecRecord:")
        expect(source).to_contain("class SharedExecMapperStats:")
        expect(source).to_contain("class SharedExecMapper:")
        expect(source).to_contain("class LoaderMapperConfig:")
        expect(source).to_contain("class LoaderMapper:")
        expect(source).to_contain("class JitMapperConfig:")
        expect(source).to_contain("class JitMapper:")
        expect(source.contains("export use compiler.loader.loader.object_mapper")).to_equal(false)

    it "keeps public fields and numeric widths exact":
        val source = read_file_text(ROOT_OBJECT_MAPPER)
        expect(source).to_contain("records: Dict<text, SharedExecRecord>")
        expect(source).to_contain("mapped_symbols: i64")
        expect(source).to_contain("owner_count: i64")
        expect(source).to_contain("total_bytes: i64")
        expect(source).to_contain("generation: i64")
        expect(source).to_contain("allow_replace_on_reload: bool")
        expect(source).to_contain("default_owner: text")
        expect(source).to_contain("allow_replace: bool")

    it "keeps constructor and method signatures exact":
        val source = read_file_text(ROOT_OBJECT_MAPPER)
        expect(source).to_contain("static fn default() -> SharedExecMapperConfig:")
        expect(source).to_contain("static fn new(config: SharedExecMapperConfig) -> SharedExecMapper:")
        expect(source).to_contain("me map_symbol(owner_id: text, symbol: text, code: [u8], allow_replace: bool) -> Result<i64, text>:")
        expect(source).to_contain("fn lookup(symbol: text) -> i64?:")
        expect(source).to_contain("fn get_record(symbol: text) -> SharedExecRecord?:")
        expect(source).to_contain("me unmap_symbol(symbol: text) -> bool:")
        expect(source).to_contain("me unmap_owner(owner_id: text) -> i64:")
        expect(source).to_contain("me clear():")
        expect(source).to_contain("fn stats() -> SharedExecMapperStats:")
        expect(source).to_contain("static fn default() -> LoaderMapperConfig:")
        expect(source).to_contain("static fn new(config: LoaderMapperConfig) -> LoaderMapper:")
        expect(source).to_contain("fn map(exec_mapper: SharedExecMapper, owner_id: text, symbol: text, code: [u8], allow_replace_request: bool) -> Result<i64, text>:")
        expect(source).to_contain("static fn default() -> JitMapperConfig:")
        expect(source).to_contain("static fn new(config: JitMapperConfig) -> JitMapper:")
        expect(source).to_contain("fn map(exec_mapper: SharedExecMapper, owner_id: text, symbol: text, code: [u8]) -> Result<i64, text>:")

    it "contains no fabricated-address formula and keeps shadow JIT canonical":
        val source = read_file_text(ROOT_OBJECT_MAPPER)
        val shadow = read_file_text(SHADOW_JIT)
        expect(source.contains("4096 + (self.generation * 256)")).to_equal(false)
        expect(source).to_contain("exec_mapping_map_rx(symbol, code)")
        expect(source).to_contain("exec_mapping_free(rec.address, rec.size)")
        expect(shadow).to_contain("use .object_mapper.{{")
        expect(shadow.contains("use compiler.loader.object_mapper.{{")).to_equal(false)

    it "shares one stateless RW-to-RX mapping transaction":
        val root = read_file_text(ROOT_OBJECT_MAPPER)
        val canonical = read_file_text(CANONICAL_OBJECT_MAPPER)
        val mapping = read_file_text(EXEC_MAPPING)
        val native = read_file_text(EXEC_NATIVE)
        expect(root).to_contain("exec_mapping_map_rx(symbol, code)")
        expect(canonical).to_contain("exec_mapping_map_rx(symbol, code)")
        expect(mapping).to_contain("native_alloc_exec_memory(code_size)")
        expect(mapping).to_contain("native_write_exec_memory(address, code, 0)")
        expect(mapping).to_contain("native_make_executable(address, code_size)")
        expect(mapping).to_contain("native_flush_icache(address, code_size)")
        expect(mapping).to_contain("native_free_exec_memory(address, size)")
        expect(mapping.contains("class ")).to_equal(false)
        expect(mapping.contains("struct ")).to_equal(false)
        expect(mapping.contains("Dict<")).to_equal(false)
        expect(native).to_contain("val prot = PROT_READ | PROT_WRITE")
        expect(native).to_contain("val prot = PROT_READ | PROT_EXEC")
        expect(native.contains("PROT_READ | PROT_WRITE | PROT_EXEC")).to_equal(false)
