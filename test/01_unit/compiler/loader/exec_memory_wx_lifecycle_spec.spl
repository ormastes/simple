# Focused W^X and bulk-copy regression coverage for the canonical SMF loader.

use std.spec.{describe, it, assert_true, assert_eq}
use compiler.loader.loader.smf_mmap_native.{
    native_alloc_exec_memory, native_free_exec_memory,
    native_write_exec_memory, native_mmap_read_bytes, native_munmap,
    native_make_executable, native_make_rw,
    native_flush_icache_checked,
    native_reloc_write_i32, native_reloc_write_i64,
    native_exec_memory_count
}
use compiler.loader.segment_mapper.{SegmentMapper}

extern fn rt_file_read_text(path: text) -> text
extern fn rt_page_size() -> i64
extern fn rt_byte_array_new(capacity: i64) -> [u8]
extern fn rt_array_new_with_cap(capacity: i64) -> [u8]

fn mapping_line(address: i64) -> text:
    val prefix = (address as u64).to_hex() + "-"
    for line in rt_file_read_text("/proc/self/maps").lines():
        if line.starts_with(prefix):
            return line
    ""

fn sample_bytes() -> [u8]:
    var bytes = rt_byte_array_new(0)
    var i = 0i64
    while i < 16:
        bytes.push((0x90 + i) as u8)
        i = i + 1
    bytes

fn generic_bytes() -> [u8]:
    var bytes = rt_array_new_with_cap(4)
    bytes.push(0x11u8)
    bytes.push(0x22u8)
    bytes.push(0x33u8)
    bytes.push(0x44u8)
    bytes

describe "canonical executable-memory W^X lifecycle":
    it "never overlaps writable and executable permissions":
        val page = rt_page_size()
        assert_true(page > 0)
        val address = native_alloc_exec_memory(page)
        assert_true(address != 0)

        val rw = mapping_line(address)
        assert_true(rw.contains(" rw-p "))
        assert_eq(rw.contains("x"), false)

        assert_eq(native_write_exec_memory(address, sample_bytes(), 0), 16)
        assert_true(native_make_executable(address, 16))
        val rx = mapping_line(address)
        assert_true(rx.contains(" r-xp "))
        assert_eq(rx.contains("w"), false)
        assert_true(native_flush_icache_checked(address, 16))

        assert_true(native_make_rw(address, 16))
        val rw_again = mapping_line(address)
        assert_true(rw_again.contains(" rw-p "))
        assert_eq(rw_again.contains("x"), false)
        assert_true(native_free_exec_memory(address, page))

    it "rounds the requested range to exactly the intersecting pages":
        val page = rt_page_size()
        val address = native_alloc_exec_memory(page * 2)
        assert_true(address != 0)
        val second_page = address + page

        assert_true(native_make_executable(second_page + 17, 1))
        val first = mapping_line(address)
        val second = mapping_line(second_page)
        assert_true(first.contains(" rw-p "))
        assert_eq(first.contains("x"), false)
        assert_true(second.contains(" r-xp "))
        assert_eq(second.contains("w"), false)

        assert_true(native_make_rw(second_page + 17, 1))
        assert_true(native_free_exec_memory(address, page * 2))

    it "rejects invalid and overflowing transitions without changing a live mapping":
        val page = rt_page_size()
        val address = native_alloc_exec_memory(page)
        assert_true(address != 0)
        assert_eq(native_make_executable(0, page), false)
        assert_eq(native_make_executable(0x7FFFFFFFFFFFFFFEi64, 4), false)
        assert_eq(native_make_rw(0x7FFFFFFFFFFFFFFEi64, 4), false)
        assert_eq(native_flush_icache_checked(0x7FFFFFFFFFFFFFFEi64, 4), false)
        val still_rw = mapping_line(address)
        assert_true(still_rw.contains(" rw-p "))
        assert_eq(still_rw.contains("x"), false)
        assert_true(native_free_exec_memory(address, page))

describe "canonical executable-memory bytes and relocation":
    it "rejects a generic value-backed byte array before raw-pointer copy":
        val page = rt_page_size()
        val address = native_alloc_exec_memory(page)
        assert_true(address != 0)
        assert_eq(native_write_exec_memory(address, generic_bytes(), 0), 0)
        assert_true(native_free_exec_memory(address, page))

    it "copies packed bytes and applies little-endian 32/64-bit relocations before seal":
        val page = rt_page_size()
        val address = native_alloc_exec_memory(page)
        assert_true(address != 0)
        assert_eq(native_write_exec_memory(address, sample_bytes(), 0), 16)
        native_reloc_write_i32(address, 0, 0x44332211i32)
        native_reloc_write_i64(address, 8, 0x0807060504030201i64)
        val bytes = native_mmap_read_bytes(address, 0, 16)
        assert_eq(bytes[0] as i64, 0x11)
        assert_eq(bytes[3] as i64, 0x44)
        assert_eq(bytes[8] as i64, 0x01)
        assert_eq(bytes[15] as i64, 0x08)
        assert_true(native_make_executable(address, 16))
        assert_true(native_flush_icache_checked(address, 16))
        assert_true(native_free_exec_memory(address, page))

    it "keeps a mapped segment writable through relocation and seals it once":
        var mapper = SegmentMapper.new()
        val mapped = mapper.map_segment("reloc-before-seal", 7, sample_bytes(), 16)
        assert_true(mapped.is_ok())
        val address = mapped.unwrap()
        assert_eq(mapper.stats().protection_transitions, 0)
        val before = mapping_line(address)
        assert_true(before.contains(" rw-p "))
        assert_eq(before.contains("x"), false)

        native_reloc_write_i32(address, 4, 0x78563412i32)
        assert_true(mapper.seal_owner("reloc-before-seal").is_ok())
        assert_eq(mapper.stats().protection_transitions, 1)
        val after = mapping_line(address)
        assert_true(after.contains(" r-xp "))
        assert_eq(after.contains("w"), false)
        val bytes = native_mmap_read_bytes(address, 4, 4)
        assert_eq(bytes[0] as i64, 0x12)
        assert_eq(bytes[3] as i64, 0x78)
        assert_eq(mapper.unmap_owner("reloc-before-seal"), 1)

    it "cleans every candidate mapping when a seal transition fails":
        val before = native_exec_memory_count()
        var mapper = SegmentMapper.new()
        val first = mapper.map_segment("failure-cleanup", 1, sample_bytes(), 16)
        val second = mapper.map_segment("failure-cleanup", 2, sample_bytes(), 16)
        assert_true(first.is_ok())
        assert_true(second.is_ok())
        val live = mapper.segment_base("failure-cleanup", 1)
        val stale = mapper.segment_base("failure-cleanup", 2)
        assert_true(native_munmap(stale, 16))

        val sealed = mapper.seal_owner("failure-cleanup")
        assert_true(sealed.is_err())
        assert_eq(mapping_line(live), "")
        assert_eq(mapping_line(stale), "")
        assert_eq(native_exec_memory_count(), before)

describe "instruction-cache runtime ownership contract":
    it "uses one runtime symbol owner and no loader-local no-op":
        val loader = rt_file_read_text("src/compiler/99.loader/loader/smf_mmap_native.spl")
        val facade = rt_file_read_text("src/compiler/99.loader/smf_mmap_native.spl")
        val icache = rt_file_read_text("src/runtime/runtime_icache.c")
        val native_runtime = rt_file_read_text("src/runtime/runtime_native.c")
        val memory_runtime = rt_file_read_text("src/runtime/runtime_memory.c")
        val page_runtime = rt_file_read_text("src/runtime/runtime_page_size.c")
        val unix_runtime = rt_file_read_text("src/runtime/platform/unix_common.h")
        val win_runtime = rt_file_read_text("src/runtime/platform/platform_win.h")
        val symbol_manifest = rt_file_read_text("src/compiler_rust/common/src/runtime_symbols.rs")
        val native_project = rt_file_read_text("src/compiler_rust/compiler/src/pipeline/native_project/tools.rs")
        assert_true(loader.contains("rt_array_bytes_basis_ptr(code)"))
        assert_true(loader.contains("rt_ptr_write_bytes_raw(address, offset, src, length)"))
        assert_eq(loader.contains("PROT_READ | PROT_WRITE | PROT_EXEC"), false)
        assert_true(loader.contains("rt_flush_icache(address, size) == 0"))
        assert_eq(facade.contains("extern fn rt_flush_icache"), false)
        assert_eq(icache.split("int64_t rt_flush_icache(").len() - 1, 1)
        assert_eq(native_runtime.contains("int64_t rt_flush_icache("), false)
        assert_eq(memory_runtime.contains("int64_t rt_flush_icache("), false)
        assert_eq(page_runtime.split("int64_t rt_page_size(").len() - 1, 1)
        assert_eq(unix_runtime.contains("int64_t rt_page_size("), false)
        assert_eq(win_runtime.contains("int64_t rt_page_size("), false)
        assert_true(symbol_manifest.contains("\"rt_array_bytes_basis_ptr\""))
        assert_true(symbol_manifest.contains("\"rt_flush_icache\""))
        assert_true(symbol_manifest.contains("\"rt_page_size\""))
        assert_true(native_project.contains("\"runtime_icache.c\""))
        assert_true(native_project.contains("\"runtime_page_size.c\""))
