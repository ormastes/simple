use compiler.loader.loader.compiler_sffi.*

fn fifo_test_context() -> CompilerContextImpl:
    CompilerContextImpl(
        type_cache: {}, instantiation_cache: {},
        type_cache_keys: [], instantiation_cache_keys: [],
        type_cache_evict_index: 0, instantiation_cache_evict_index: 0,
        type_cache_count: 0, instantiation_cache_count: 0,
        stats: ContextStats(
            type_inferences: 0, template_instantiations: 0,
            cache_hits: 0, cache_misses: 0
        ),
        next_type_var: 0
    )

describe "Compiler SFFI bounded FIFO caches":
    it "evicts one inferred-type entry instead of clearing the cache":
        val ty = make_int_type(64, true)
        val ctx = fifo_test_context()
        var index = 0i64
        while index <= COMPILER_SFFI_CACHE_LIMIT:
            ctx.cache_inferred_types("type-" + index.to_string(), [ty])
            index = index + 1
        expect(ctx.type_cache_count).to_equal(COMPILER_SFFI_CACHE_LIMIT)
        expect(ctx.type_cache_keys.len()).to_equal(COMPILER_SFFI_CACHE_LIMIT)
        expect(ctx.type_cache.has("type-0")).to_equal(false)
        expect(ctx.type_cache.has("type-1")).to_equal(true)
        expect(ctx.type_cache.has("type-4096")).to_equal(true)

    it "evicts one bytecode entry instead of clearing the cache":
        val ctx = fifo_test_context()
        var index = 0i64
        while index <= COMPILER_SFFI_CACHE_LIMIT:
            ctx.cache_instantiation("code-" + index.to_string(), [1u8])
            index = index + 1
        expect(ctx.instantiation_cache_count).to_equal(COMPILER_SFFI_CACHE_LIMIT)
        expect(ctx.instantiation_cache_keys.len()).to_equal(COMPILER_SFFI_CACHE_LIMIT)
        expect(ctx.instantiation_cache.has("code-0")).to_equal(false)
        expect(ctx.instantiation_cache.has("code-1")).to_equal(true)
        expect(ctx.instantiation_cache.has("code-4096")).to_equal(true)
