use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI structural type cache keys":
    it "distinguishes scalar metadata that shares kind and name":
        val signed = TypeInfo(
            kind: "int", name: "word", has_bits: true, bits: 32,
            has_signed: true, signed: true, has_lanes: false, lanes: 0,
            args: [], has_elem: false, elem: nil
        )
        val unsigned = TypeInfo(
            kind: "int", name: "word", has_bits: true, bits: 32,
            has_signed: true, signed: false, has_lanes: false, lanes: 0,
            args: [], has_elem: false, elem: nil
        )
        expect(types_to_key([signed]) == types_to_key([unsigned])).to_equal(false)

    it "distinguishes nested arguments elements and lane counts":
        val i32 = make_int_type(32, true)
        val i64 = make_int_type(64, true)
        val left = TypeInfo(
            kind: "simd", name: "Vector", has_bits: false, bits: 0,
            has_signed: false, signed: false, has_lanes: true, lanes: 4,
            args: [i32], has_elem: true, elem: i32
        )
        val right = TypeInfo(
            kind: "simd", name: "Vector", has_bits: false, bits: 0,
            has_signed: false, signed: false, has_lanes: true, lanes: 8,
            args: [i64], has_elem: true, elem: i64
        )
        expect(types_to_key([left]) == types_to_key([right])).to_equal(false)
        expect(types_to_key([left])).to_equal(types_to_key([left]))

    it "frames names so delimiters cannot alias adjacent types":
        val split_left = make_named_type("A:B")
        val split_right = make_named_type("A")
        val tail = make_named_type("B")
        expect(types_to_key([split_left]) == types_to_key([split_right, tail])).to_equal(false)
