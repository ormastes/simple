use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI hint JSON presence":
    it "preserves absent parameter index independently from zero":
        val absent = parse_hints_json('[{"source":"call_site","ty":{"kind":"int","bits":64,"signed":true}}]')
        val zero = parse_hints_json('[{"source":"call_site","param_index":0,"ty":{"kind":"int","bits":64,"signed":true}}]')
        expect(absent.len()).to_equal(1)
        expect(zero.len()).to_equal(1)
        expect(absent[0].has_param_index).to_equal(false)
        expect(zero[0].has_param_index).to_equal(true)
        expect(zero[0].param_index).to_equal(0)
        expect(hints_to_key(absent) == hints_to_key(zero)).to_equal(false)

    it "preserves an explicit nonzero parameter index":
        val hints = parse_hints_json('[{"source":"return","param_index":7,"ty":{"kind":"float","bits":32}}]')
        expect(hints.len()).to_equal(1)
        expect(hints[0].has_param_index).to_equal(true)
        expect(hints[0].param_index).to_equal(7)
        expect(hints[0].ty.kind).to_equal("float")
