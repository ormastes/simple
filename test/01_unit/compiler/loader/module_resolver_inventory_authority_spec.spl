use std.io_runtime.{file_read}
use std.spec.*

val RESOLUTION_SOURCE = "src/compiler/99.loader/module_resolver/resolution.spl"
val TYPES_SOURCE = "src/compiler/99.loader/module_resolver/types.spl"
val INVENTORY_SOURCE = "src/compiler/99.loader/shared_contract/module_inventory.spl"

describe "module resolver inventory authority":
    it "contains no live directory enumeration or fallback scan":
        val source = file_read(RESOLUTION_SOURCE)
        expect(source.contains("dir_list(")).to_equal(false)
        expect(source.contains("walk_dir(")).to_equal(false)
        expect(source.contains("live_source_fallback")).to_equal(false)

    it "requires explicitly admitted immutable inventory":
        val types = file_read(TYPES_SOURCE)
        val resolver = file_read(RESOLUTION_SOURCE)
        expect(types.contains("module_inventory: LoaderModuleInventoryV1?")).to_equal(true)
        expect(types.contains("fn moduleresolver_with_module_inventory(")).to_equal(true)
        expect(resolver.contains("if self.module_inventory == nil:")).to_equal(true)
        expect(resolver.contains("live directory scanning is forbidden")).to_equal(true)

    it "binds PackageImageV1 and package index to snapshot authority":
        val inventory = file_read(INVENTORY_SOURCE)
        expect(inventory.contains("package_image_validate_v1(image, receipt)")).to_equal(true)
        expect(inventory.contains("index.scv_revision_id != snapshot_revision")).to_equal(true)
        expect(inventory.contains("index.scv_tree_id != snapshot_tree_digest")).to_equal(true)
        expect(inventory.contains("index.inventory_digest != snapshot_inventory_digest")).to_equal(true)
        expect(inventory.contains("LoaderModuleInventoryErrorV1.package_missing")).to_equal(true)
