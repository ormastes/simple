# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: `use lazy` must parse and must resolve deferred symbols on first call,
returning the real callee's result rather than failing or silently degrading.
Audience: compiler engineers who maintain the module loader.
"""

use std.spec.step

use lazy std.common.base_encoding.base32.{base32_encode, base32_decode}

fn _bytes(s: text) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < s.len():
        out.push(s[i:i + 1].ord().to_u8())
        i = i + 1
    out

describe "use lazy deferred loading":
    # @manual scenario evidence
    it "parses use lazy with a selective import":
        # @req REQ-SSPEC-COMPILER
        step("Verify: selective lazy import parses and the symbol is callable")
        val encoded = base32_encode(_bytes("lazy"))
        expect(encoded.len() > 0).to_equal(true)  # oracle: real call returns a non-empty encoding

    it "force-loads a lazy module on first symbol access and returns its real value":
        # @req REQ-SSPEC-COMPILER
        step("Verify: lazy import round-trips through the real base32 codec")
        val payload = _bytes("use lazy loads on demand")
        val encoded = base32_encode(payload)
        val decoded = base32_decode(encoded)
        expect(decoded).to_equal(payload)  # oracle: real encode/decode round-trip through the lazy import
