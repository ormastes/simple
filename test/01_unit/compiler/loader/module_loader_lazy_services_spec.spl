"""
# Module Loader Lazy Services

Phase D (startup perf plan 2026-08-17): ModuleLoader construction must not
build heavy services (compiler ctx, ObjTaker, provider, JIT, mapper,
lifecycle/cache). Services are created on first use by ensure_* helpers, and
a disabled JIT config never creates the JIT service through symbol lookup.
"""

use compiler.loader.loader.module_loader.{
    LazyModuleLoaderConfig, lazymoduleloaderconfig_default,
    lazymoduleloader_new, lazymoduleloader_with_defaults,
    moduleloader_load, moduleloader_resolve_symbol,
    moduleloader_any_heavy_service_created,
    moduleloader_compiler_ctx_created, moduleloader_obj_taker_created,
    moduleloader_provider_created, moduleloader_jit_service_created,
    moduleloader_loader_mapper_created, moduleloader_lifecycle_created,
    moduleloader_record_dependency_semantic_fingerprint,
    moduleloader_semantic_dependents_of
}
use compiler.loader.loader.module_loader_semantic.{_semantic_dependents_from_paths}
use std.io_runtime.{read_file_text}

val MODULE_LOADER_SEMANTIC_SOURCE = "src/compiler/99.loader/loader/module_loader_semantic.spl"

fn lazy_default_config() -> LazyModuleLoaderConfig:
    lazymoduleloaderconfig_default()

fn lazy_no_jit_config() -> LazyModuleLoaderConfig:
    LazyModuleLoaderConfig(
        enable_jit: false,
        enable_cache: true,
        max_cache_size: 100,
        verbose: false,
        hot_reload: false
    )

describe "Module Loader Lazy Services":
    """Construction-time laziness and first-use service creation."""

    it "creates no heavy services at construction":
        val loader = lazymoduleloader_new(lazy_default_config())
        expect(moduleloader_any_heavy_service_created(loader)).to_equal(false)
        expect(moduleloader_compiler_ctx_created(loader)).to_equal(false)
        expect(moduleloader_obj_taker_created(loader)).to_equal(false)
        expect(moduleloader_provider_created(loader)).to_equal(false)
        expect(moduleloader_jit_service_created(loader)).to_equal(false)
        expect(moduleloader_loader_mapper_created(loader)).to_equal(false)
        expect(moduleloader_lifecycle_created(loader)).to_equal(false)

    it "creates no heavy services via with_defaults either":
        val loader = lazymoduleloader_with_defaults()
        expect(moduleloader_any_heavy_service_created(loader)).to_equal(false)

    it "symbol lookup creates exactly lifecycle and jit, not provider or obj_taker":
        val loader = lazymoduleloader_new(lazy_default_config())
        match moduleloader_resolve_symbol(loader, "no_such_symbol_lazy_spec"):
            case NotFound(_):
                expect(true).to_equal(true)
            case _:
                expect("unexpected resolve result").to_equal("NotFound")
        expect(moduleloader_lifecycle_created(loader)).to_equal(true)
        expect(moduleloader_jit_service_created(loader)).to_equal(true)
        expect(moduleloader_provider_created(loader)).to_equal(false)
        expect(moduleloader_obj_taker_created(loader)).to_equal(false)
        expect(moduleloader_compiler_ctx_created(loader)).to_equal(false)

    it "module load attempt creates provider, lifecycle, and exec-mapper host":
        val loader = lazymoduleloader_new(lazy_default_config())
        match moduleloader_load(loader, "/nonexistent/lazy_spec_module.smf"):
            case Error(_):
                expect(true).to_equal(true)
            case _:
                expect("unexpected load result").to_equal("Error")
        expect(moduleloader_provider_created(loader)).to_equal(true)
        expect(moduleloader_lifecycle_created(loader)).to_equal(true)
        expect(moduleloader_jit_service_created(loader)).to_equal(true)
        expect(moduleloader_obj_taker_created(loader)).to_equal(false)

    it "disabled jit config never creates the JIT service on lookup (fail-closed)":
        val loader = lazymoduleloader_new(lazy_no_jit_config())
        match moduleloader_resolve_symbol(loader, "no_such_symbol_nojit_spec"):
            case NotFound(_):
                expect(true).to_equal(true)
            case _:
                expect("unexpected resolve result").to_equal("NotFound")
        expect(moduleloader_jit_service_created(loader)).to_equal(false)
        expect(moduleloader_lifecycle_created(loader)).to_equal(true)

    it "repeated lookups keep working and do not duplicate services":
        val loader = lazymoduleloader_new(lazy_default_config())
        val _r1 = moduleloader_resolve_symbol(loader, "sym_a_lazy_spec")
        val _r2 = moduleloader_resolve_symbol(loader, "sym_a_lazy_spec")
        expect(moduleloader_jit_service_created(loader)).to_equal(true)
        expect(moduleloader_lifecycle_created(loader)).to_equal(true)

    it "keeps transitive dependent order across a cycle and skips unrelated modules":
        var loader = lazymoduleloader_new(lazy_default_config())
        moduleloader_record_dependency_semantic_fingerprint(loader, "late.smf", "middle.smf", "middle:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "middle.smf", "root.smf", "root:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "root.smf", "late.smf", "late:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "unrelated.smf", "other.smf", "other:v1")

        val affected = moduleloader_semantic_dependents_of(loader, "root.smf")

        expect(affected).to_equal(["middle.smf", "late.smf", "root.smf"])
        expect(affected.contains("unrelated.smf")).to_equal(false)

    it "returns no dependents when the changed path has no incoming edges":
        var loader = lazymoduleloader_new(lazy_default_config())
        moduleloader_record_dependency_semantic_fingerprint(loader, "module.smf", "dependency.smf", "dependency:v1")

        val affected = moduleloader_semantic_dependents_of(loader, "absent.smf")

        expect(affected).to_equal([])

    it "keeps fixed-point scan order when fan-in makes an earlier module ready":
        var loader = lazymoduleloader_new(lazy_default_config())
        moduleloader_record_dependency_semantic_fingerprint(loader, "A.smf", "B.smf", "B:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "B.smf", "seed.smf", "seed:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "C.smf", "seed.smf", "seed:v1")

        val affected = moduleloader_semantic_dependents_of(loader, "seed.smf")

        expect(affected).to_equal(["B.smf", "C.smf", "A.smf"])

    it "finds wide and deep dependents in established pass order":
        var loader = lazymoduleloader_new(lazy_default_config())
        moduleloader_record_dependency_semantic_fingerprint(loader, "deep3.smf", "deep2.smf", "deep2:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "deep2.smf", "deep1.smf", "deep1:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "deep1.smf", "seed.smf", "seed:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "wide_a.smf", "seed.smf", "seed:v1")
        moduleloader_record_dependency_semantic_fingerprint(loader, "wide_b.smf", "seed.smf", "seed:v1")

        val affected = moduleloader_semantic_dependents_of(loader, "seed.smf")

        expect(affected).to_equal([
            "deep1.smf", "wide_a.smf", "wide_b.smf",
            "deep2.smf", "deep3.smf"
        ])

    it "keeps high-fanout and dense reverse edges in append-only scalar-index storage":
        val source = read_file_text(MODULE_LOADER_SEMANTIC_SOURCE)

        expect(source).to_contain("var reverse_heads: Dict<text, i64> = {}")
        expect(source).to_contain("var reverse_dependents: [text] = []")
        expect(source).to_contain("var reverse_next: [i64] = []")
        expect(source).to_contain("reverse_dependents.push(module_path)")
        expect(source).to_contain("reverse_next.push(previous_head)")
        expect(source).to_contain("reverse_heads[dependency_path] = edge_index")
        expect(source).to_contain("edge_index = reverse_next[edge_index]")
        expect(source.contains("var reverse_dependents: Dict<text, [text]>")).to_equal(false)

    it "keeps export and dependency closure order across backward edges and a cycle":
        val paths = ["late.smf", "exporter.smf", "direct.smf", "unrelated.smf", "seed"]
        var exports: Dict<text, [text]> = {}
        exports["exporter.smf"] = ["seed", "api.key"]
        var dependencies: Dict<text, [text]> = {}
        dependencies["late.smf"] = ["api.key"]
        dependencies["direct.smf"] = ["seed"]
        dependencies["unrelated.smf"] = ["other.key"]
        dependencies["seed"] = ["late.smf"]

        val affected = _semantic_dependents_from_paths(paths, exports, dependencies, "seed")

        expect(affected).to_equal(["exporter.smf", "direct.smf", "late.smf", "seed"])
        expect(affected.contains("unrelated.smf")).to_equal(false)

    it "returns no semantic closure for unrelated exports and dependencies":
        val paths = ["module.smf"]
        var exports: Dict<text, [text]> = {}
        exports["module.smf"] = ["other.export"]
        var dependencies: Dict<text, [text]> = {}
        dependencies["module.smf"] = ["other.dependency"]

        val affected = _semantic_dependents_from_paths(paths, exports, dependencies, "absent.key")

        expect(affected).to_equal([])
