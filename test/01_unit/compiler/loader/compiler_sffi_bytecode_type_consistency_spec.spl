use compiler.loader.loader.compiler_sffi.*

fn consistency_check(code: [u8]) -> bool:
    val handle = compiler_create_context()
    val valid = compiler_check_types(handle, code)
    compiler_destroy_context(handle)
    valid

describe "Compiler SFFI bytecode type consistency":
    it "rejects a load tag different from its parameter":
        val code = [0x00u8, 1, 0x00, 0x01, 0x10, 8, 0x10, 0x20, 0, 0x20, 0xFE, 0xFF, 0x10]
        expect(consistency_check(code)).to_equal(false)

    it "rejects metadata different from its parameter":
        val code = [0x00u8, 1, 0x00, 0x01, 0x10, 8, 0x10, 0x20, 0, 0x10, 0xFE, 0xFF, 0x30]
        expect(consistency_check(code)).to_equal(false)

    it "rejects zero and non-producer parameter sizes":
        val zero = [0x00u8, 1, 0x00, 0x01, 0x10, 0, 0x10, 0x20, 0, 0x10, 0xFE, 0xFF, 0x10]
        val odd = [0x00u8, 1, 0x00, 0x01, 0x10, 3, 0x10, 0x20, 0, 0x10, 0xFE, 0xFF, 0x10]
        expect(consistency_check(zero)).to_equal(false)
        expect(consistency_check(odd)).to_equal(false)

    it "accepts matching multi-parameter records":
        val code = [
            0x00u8, 2, 0x00,
            0x01, 0x10, 8, 0x01, 0x20, 4,
            0x10, 0x20, 0, 0x10, 0x20, 1, 0x20,
            0xFE, 0xFF, 0x10, 0xFF, 0x20
        ]
        expect(consistency_check(code)).to_equal(true)
