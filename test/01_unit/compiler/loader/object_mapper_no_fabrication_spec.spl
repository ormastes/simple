# W4: the `compiler.loader.object_mapper` package (the root loader package's
# public re-export surface, see `compiler/99.loader/__init__.spl:35-39`) used
# to define its own SharedExecMapper that fabricated addresses arithmetically
# as `4096 + generation*256 + code.len()` instead of mapping any memory.
# This spec fails against that fabricating implementation and passes only
# once the compatibility class delegates its raw allocation/copy/seal/free
# transaction to the same stateless primitive as the canonical loader mapper.
use compiler.loader.object_mapper.*
use compiler.loader.loader.smf_mmap_native.{native_mmap_read_bytes}

fn tiny_code() -> [u8]:
    # x86-64 `mov eax, 42; ret`
    [184, 42, 0, 0, 0, 195]

fn execute_mapped(address: i64) -> i64:
    var called: Result<i64, text> = Err("mapped function was not called")
    unsafe(capabilities: [raw_ptr]):
        called = native_call_function_0(address)
    called.unwrap()

describe "Object mapper public surface does not fabricate addresses":
    it "returns an address that is NOT the fabricated 4096 + gen*256 + len formula":
        var mapper = SharedExecMapper.new(SharedExecMapperConfig(verbose: false))
        val mapped = mapper.map_symbol("owner", "fn_real_addr", tiny_code(), false)
        expect(mapped.is_ok()).to_equal(true)

        val addr = mapped.unwrap()
        val fabricated = 4096 + (1 * 256) + tiny_code().len() as i64

        # A real mmap'd executable address must not equal the old fake formula.
        expect(addr == fabricated).to_equal(false)
        var copied: [u8] = []
        unsafe(capabilities: [raw_ptr]):
            copied = native_mmap_read_bytes(addr, 0, tiny_code().len() as i64)
        # Address arithmetic cannot satisfy this oracle: the bytes must exist in
        # the native mapping at the returned address.
        expect(copied).to_equal(tiny_code())
        expect(mapper.unmap_symbol("fn_real_addr")).to_equal(true)
        expect(mapper.lookup("fn_real_addr") == nil).to_equal(true)

    it "publishes replacement bytes only after a real mapping succeeds" :
        var mapper = SharedExecMapper.new(SharedExecMapperConfig(verbose: false))
        val first = mapper.map_symbol("owner", "fn_replace", tiny_code(), false)
        expect(first.is_ok()).to_equal(true)
        val replacement: [u8] = [144, 195]
        val replaced = mapper.map_symbol("owner", "fn_replace", replacement, true)
        expect(replaced.is_ok()).to_equal(true)

        val rec = mapper.get_record("fn_replace").unwrap()
        expect(rec.address).to_equal(replaced.unwrap())
        expect(rec.size).to_equal(2)
        expect(rec.generation).to_equal(2)
        expect(mapper.stats().total_bytes).to_equal(2)

        var copied: [u8] = []
        unsafe(capabilities: [raw_ptr]):
            copied = native_mmap_read_bytes(rec.address, 0, rec.size)
        expect(copied).to_equal(replacement)
        expect(mapper.unmap_owner("owner")).to_equal(1)
        expect(mapper.stats().mapped_symbols).to_equal(0)
        expect(mapper.stats().total_bytes).to_equal(0)
