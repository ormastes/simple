# @req REQ-INNER-JIT-MEMBERSHIP
# @tag: unit, compiler, loader
# This exact physical owner is distinct from compiler.loader.jit_instantiator.
use std.spec.{describe, it, expect}
use compiler.loader.loader.jit_instantiator.{
    JitInstantiator, JitInstantiatorConfig, JitInstantiationResult,
    LoadedMetadata, PossibleInstantiation
}

fn inner_membership_config() -> JitInstantiatorConfig:
    JitInstantiatorConfig(update_smf: false, max_depth: 5000, enabled: true, verbose: false)

fn inner_membership_metadata(symbol: text) -> LoadedMetadata:
    LoadedMetadata(possible: [PossibleInstantiation(
        template_name: "MembershipProbe", type_args: "i64", mangled_name: symbol
    )], instantiations: [])

fn inner_membership_occurrences(values: [text], needle: text) -> i64:
    var count = 0
    for value in values:
        if value == needle:
            count = count + 1
    count

describe "inner loader JIT membership":
    it "deduplicates misses and keeps freshly constructed instances independent":
        var first = JitInstantiator.new(inner_membership_config())
        var second = JitInstantiator.new(inner_membership_config())
        expect(first.find_possible("missing").?).to_be(false)
        expect(first.find_possible("missing").?).to_be(false)
        expect(first.possible_miss_count).to_equal(1)
        expect(first.possible_misses.len()).to_equal(1)
        expect(second.possible_miss_count).to_equal(0)
        expect(second.possible_misses.has("missing")).to_be(false)
        first.in_progress["active"] = true
        expect(second.in_progress.has("active")).to_be(false)
        second.remember_possible_miss("second")
        expect(first.possible_misses.has("second")).to_be(false)

    it "resets the negative cache at 4096 distinct misses without counting duplicates":
        var jit = JitInstantiator.new(inner_membership_config())
        for index in 0..4096:
            jit.remember_possible_miss("miss-{index}")
        expect(jit.possible_miss_count).to_equal(4096)
        expect(jit.possible_misses.len()).to_equal(4096)
        jit.remember_possible_miss("miss-4095")
        expect(jit.possible_miss_count).to_equal(4096)
        expect(jit.possible_misses.has("miss-0")).to_be(true)
        jit.remember_possible_miss("after-limit")
        expect(jit.possible_miss_count).to_equal(1)
        expect(jit.possible_misses.len()).to_equal(1)
        expect(jit.possible_misses.has("after-limit")).to_be(true)
        expect(jit.possible_misses.has("miss-0")).to_be(false)
        expect(jit.possible_misses.has("miss-4095")).to_be(false)

    it "invalidates positive and negative lookup caches when metadata changes":
        var jit = JitInstantiator.new(inner_membership_config())
        jit.set_metadata_for_test("probe.smf", inner_membership_metadata("old"))
        expect(jit.find_possible("old").?).to_be(true)
        expect(jit.find_possible("new").?).to_be(false)
        expect(jit.possible_miss_count).to_equal(1)
        jit.set_metadata_for_test("probe.smf", inner_membership_metadata("new"))
        expect(jit.possible_miss_count).to_equal(0)
        expect(jit.possible_misses.len()).to_equal(0)
        expect(jit.possible_lookup.len()).to_equal(0)
        expect(jit.find_possible("new").?).to_be(true)
        expect(jit.find_possible("old").?).to_be(false)

    it "reports cycle contents without mutating active membership or depth":
        var jit = JitInstantiator.new(inner_membership_config())
        jit.in_progress["outer"] = true
        jit.in_progress["inner"] = true
        jit.depth = 2
        val result = jit.try_jit_instantiate("inner")
        match result:
            case JitInstantiationResult.CircularDependency(cycle):
                expect(cycle.len()).to_equal(3)
                expect(inner_membership_occurrences(cycle, "outer")).to_equal(1)
                expect(inner_membership_occurrences(cycle, "inner")).to_equal(2)
            case _: expect(false).to_be(true)
        expect(jit.depth).to_equal(2)
        expect(jit.in_progress.len()).to_equal(2)
        var snapshot = jit.in_progress.keys()
        snapshot.push("detached")
        expect(jit.in_progress.has("detached")).to_be(false)
        expect(jit.compiler_ctx_handle).to_equal(0)

    it "cleans active membership and restores depth after real typed compiler rejection":
        var jit = JitInstantiator.new(inner_membership_config())
        # Exercise the real in-process invalid-handle path. It returns a typed
        # compiler failure without spawning a compiler or mapping executable code.
        jit.compiler_ctx_handle = -1
        jit.in_progress["outer"] = true
        jit.depth = 1
        for index in 0..64:
            val symbol = "rejected-{index}"
            jit.set_metadata_for_test("probe.smf", inner_membership_metadata(symbol))
            val result = jit.try_jit_instantiate(symbol)
            match result:
                case JitInstantiationResult.CompilationError(message):
                    expect(message).to_equal("Invalid context handle")
                case _: expect(false).to_be(true)
            expect(jit.in_progress.has(symbol)).to_be(false)
            expect(jit.in_progress.has("outer")).to_be(true)
            expect(jit.in_progress.len()).to_equal(1)
            expect(jit.depth).to_equal(1)
        expect(jit.compile_count).to_equal(0)
        expect(jit.cached_count).to_equal(0)

    it "keeps membership and depth unchanged for cache hits and depth rejection":
        var jit = JitInstantiator.new(inner_membership_config())
        jit.in_progress["outer"] = true
        jit.depth = 1
        jit.set_cache_for_test("cached", [1u8], 123)
        val cached = jit.try_jit_instantiate("cached")
        match cached:
            case JitInstantiationResult.Success(code, symbol, address):
                expect(symbol).to_equal("cached")
                expect(code.len()).to_equal(1)
                expect(address).to_equal(Some(123))
            case _: expect(false).to_be(true)
        expect(jit.depth).to_equal(1)
        expect(jit.in_progress.len()).to_equal(1)
        jit.depth = 5000
        val rejected = jit.try_jit_instantiate("depth-limit")
        match rejected:
            case JitInstantiationResult.CompilationError(message):
                expect(message).to_equal("Maximum JIT depth (5000) exceeded")
            case _: expect(false).to_be(true)
        expect(jit.depth).to_equal(5000)
        expect(jit.in_progress.len()).to_equal(1)
        expect(jit.in_progress.has("outer")).to_be(true)
        expect(jit.compiler_ctx_handle).to_equal(0)
