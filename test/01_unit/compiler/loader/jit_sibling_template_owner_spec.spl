# The runtime loader template owner is a sibling, not the compatibility class.
use std.spec.{describe, it, expect}
use compiler.loader.loader.jit_instantiator.{TemplateBytes}
use compiler.loader.loader.jit_context.{JitCompilationContext}
use compiler.loader.loader.compiler_sffi.{CompilerContext}

fn runtime_template_parameter_count(value: TemplateBytes) -> i32:
    value.param_count

describe "runtime JIT sibling template owner":
    it "retains the i32 template payload through context lookup":
        val template = TemplateBytes(bytes: [1, 2, 3], name: "Example", param_count: 2 as i32)
        val context = JitCompilationContext(
            compiler_ctx: CompilerContext(handle: 0, alive: false),
            smf_templates: {"Example": template}, recorded: [])
        val retained = context.load_template("Example").unwrap()
        expect(runtime_template_parameter_count(retained)).to_equal(2 as i32)
        expect(retained.bytes).to_equal([1, 2, 3])
        expect(retained.name).to_equal("Example")

    it "rejects a missing template instead of fabricating compatibility bytes":
        val context = JitCompilationContext(
            compiler_ctx: CompilerContext(handle: 0, alive: false),
            smf_templates: {}, recorded: [])
        expect(context.load_template("Missing").is_err()).to_equal(true)
