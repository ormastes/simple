use std.spec.*
use std.common.crypto.sha256.{sha256_bytes, sha256_text}
use compiler.backend.native.parser_byte_avx2_lowering.parser_byte_avx2_callable_bytes_v1
use compiler.backend.native.parser_lexical_avx2_classifier_v1.{
    parser_lexical_avx2_one_mask_callable_bytes_v1,
    PARSER_LEXICAL_CLASSIFIER_INTERFACE_HANDLE_V1}
use compiler.loader.parser_lexical_mapping_authorization_v1.*
use compiler.loader.parser_structural_mask_mapping_authorization_v1.*
use compiler.loader.parser_structural_mask_mapper_v1.*
use compiler.loader.parser_structural_provider_activation_v2.*
use compiler.loader.smf_mmap_native.native_exec_memory_count
use compiler.driver.environment_variant_composite_publication_v1.{EnvironmentCompositePublicationV1, environment_composite_publication_expected_plan_digest_v1}
use compiler.common.structural_contracts.environment_variant_catalog_policy_bridge_v1.environment_variant_policy_digest256_v1
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.publication_admission_v1.*
use std.nogc_sync_mut.composition.environment_variants.artifact_admission_v1.*
use std.nogc_sync_mut.composition.environment_variants.receipt_v1.*
use std.nogc_sync_mut.composition.environment_variants.catalog_identity_v1.environment_variant_descriptor_identity_v1
use std.nogc_sync_mut.composition.environment_variants.provider_generation_v2.ProviderGenerationManagerV2

fn d(v: u64) -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: v, w1: 0u64, w2: 0u64, w3: 0u64)
fn read64(raw: [i64], at: i64) -> u64:
    var value = 0u64
    for i in 0..8: value = value | ((raw[at + i] as u64) << ((i as u64) * 8u64))
    value
fn bytes_digest(bytes: [i64]) -> EnvironmentDigest256V1:
    val raw = sha256_bytes(bytes)
    EnvironmentDigest256V1(w0: read64(raw, 0), w1: read64(raw, 8),
        w2: read64(raw, 16), w3: read64(raw, 24))
fn code() -> [i64]: parser_lexical_avx2_one_mask_callable_bytes_v1(true).unwrap()
fn root_digest() -> EnvironmentDigest256V1: bytes_digest(code())
fn identity() -> EnvironmentVariantReceiptIdentityV1:
    EnvironmentVariantReceiptIdentityV1(provider_identity: d(1u64), variant_identity: d(2u64),
        artifact_digest: root_digest(), environment_identity: d(4u64),
        environment_generation: 5u64, provider_generation: 6u64)
fn evidence(provider: u64, variant: u64, artifact: EnvironmentDigest256V1,
            generation: u64) -> PublicationArtifactEvidenceV1:
    val trust = ArtifactTrustVerificationReceiptV1(
        descriptor_size: ENV_ARTIFACT_TRUST_RECEIPT_BYTES_V1,
        schema_version: ENV_VARIANT_SCHEMA_V1,
        authentication_status: ENV_ARTIFACT_TRUST_AUTHENTICATED_V1,
        receipt_identity: d(20u64 + variant), artifact_digest: artifact,
        trust_policy_digest: d(30u64), verifier_identity: d(31u64),
        verifier_generation: 2u64, verification_evidence_digest: d(32u64))
    PublicationArtifactEvidenceV1(provider_identity: d(provider), variant_identity: d(variant),
        artifact_digest: artifact, provider_generation: generation,
        observed_artifact_digest: artifact, required_trust_policy_digest: d(30u64),
        required_verifier_identity: d(31u64), minimum_verifier_generation: 1u64,
        trust_receipt: trust)
fn binding() -> VariantFacetBindingV1:
    VariantFacetBindingV1(facet_id: ENV_FACET_FRONTEND_V1, interface_major: 1u16,
        interface_minor: 0u16, slot_index: 0u32, provider_identity: d(1u64),
        variant_identity: d(2u64), provider_generation: 6u64,
        interface_handle: PARSER_LEXICAL_CLASSIFIER_INTERFACE_HANDLE_V1,
        provider_context: 41u64)
fn root_descriptor() -> VariantDescriptorV1:
    val e = EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)
    VariantDescriptorV1(descriptor_size: 360u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        placement: ENV_PLACEMENT_NATIVE_DYNLIB_V1, provider_identity: d(1u64), variant_identity: d(2u64),
        contract_identity: d(18u64), contract_major: 1u16, contract_minor: 0u16, abi_digest: d(19u64),
        semantic_identity: d(20u64), grammar_identity: d(21u64), program_identity: d(22u64),
        artifact_digest: root_digest(), artifact_location: e, target_architecture: ENV_ARCH_X86_64_V1,
        required_os_id: 1u32, required_abi_id: 1u32, required_object_format_id: 1u32,
        required_endian_id: 1u16, required_pointer_width_bits: 64u16, required_loader_permission_bits: 1u64,
        required_cpu_features: EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1, words: e),
        required_os_state_words: e, required_vector_state_mode: ENV_VECTOR_FIXED_V1,
        required_vector_length_bits: 256u32, required_device_api: 0u32, minimum_device_api_version: 0u32,
        required_device_features: e, required_memory_domain_bits: 0u64, minimum_device_buffer_bytes: 0u64,
        minimum_workgroup_invocations: 0u32, minimum_queue_family_count: 0u32, required_effect_bits: 0u64,
        numerical_contract_id: 1u32, resource_layout_digest: d(23u64), dependencies: e,
        assurance_receipt_digest: d(22u64), startup_budget_us: 1u64, max_session_bytes: 1u64,
        max_inflight_operations: 1u32)
fn publication() -> EnvironmentCompositePublicationV1:
    val policy_text = sha256_text("parser-map-policy")
    val policy_digest = environment_variant_policy_digest256_v1(policy_text).unwrap()
    val plan = BindingPlanV1(descriptor_size: 224u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        plan_digest: d(10u64), environment_identity: d(4u64), environment_generation: 5u64,
        catalog_digest: d(11u64), catalog_generation: 12u64, policy_digest: policy_digest,
        dependency_lock_digest: d(14u64), publication_generation: 15u64,
        facet_bindings: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32),
        selected_variant_identities: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32),
        rejections: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32))
    val admission = EnvironmentPublicationAdmissionV1(
        schema_version: ENV_PUBLICATION_ADMISSION_SCHEMA_V1, plan: plan,
        root_provider_identity: d(1u64), root_variant_identity: d(2u64),
        dependency_closure_digest: d(16u64), admitted_artifacts: [
            evidence(1u64, 2u64, root_digest(), 6u64),
            evidence(7u64, 8u64, d(9u64), 10u64)])
    var result = EnvironmentCompositePublicationV1(admission: admission,
        canonical_base_plan_digest: d(17u64), preferred_fallback: false,
        policy_explanation_digest: policy_text, facet_bindings: [binding()],
        selected_variant_identities: [d(2u64)], rejections: [
            VariantRejectionV1(provider_identity: d(1u64), variant_identity: d(9u64),
                reason_code: 1u32, phase_code: 1u16)], root_descriptor: root_descriptor(),
        root_descriptor_digest: environment_variant_descriptor_identity_v1(root_descriptor(), [], [], []),
        root_artifact_location_bytes: [], root_referenced_feature_words: [], root_referenced_dependencies: [])
    result.admission.plan.plan_digest = environment_composite_publication_expected_plan_digest_v1(result)
    result
fn checked_receipt() -> EnvironmentVariantReceiptV1:
    val base = environment_variant_receipt_create_v1(identity()).unwrap()
    val metadata = environment_variant_receipt_metadata_validate_v1(base, identity(), d(50u64)).unwrap()
    environment_variant_receipt_self_check_v1(metadata, identity(), d(51u64)).unwrap()

describe "authenticated parser structural mapping authorization V1":
    it "binds lexical ABI schema tail lifecycle and rejects substitutions":
        val p = publication(); val receipt = checked_receipt()
        val lexical = parser_lexical_mapping_authorize_v1(p, receipt, code()).unwrap()
        expect(parser_lexical_mapping_authorization_valid_v1(lexical)).to_equal(true)
        expect(lexical.lifecycle_receipt).to_equal(lexical.structural.eligible_receipt)
        var changed = lexical
        changed.abi_identity = d(90u64)
        expect(parser_lexical_mapping_authorization_valid_v1(changed)).to_equal(false)
        changed = lexical; changed.mask_schema_identity = d(91u64)
        expect(parser_lexical_mapping_authorization_valid_v1(changed)).to_equal(false)
        changed = lexical; changed.tail_policy_identity = d(92u64)
        expect(parser_lexical_mapping_authorization_valid_v1(changed)).to_equal(false)
        changed = lexical; changed.lifecycle_receipt.event_sequence =
            changed.lifecycle_receipt.event_sequence + 1u64
        expect(parser_lexical_mapping_authorization_valid_v1(changed)).to_equal(false)
        expect(parser_lexical_mapping_authorize_v1(p, receipt,
            parser_byte_avx2_callable_bytes_v1(true).unwrap())).to_equal(
                Err(ParserLexicalMappingAuthorizationErrorV1.GenericRejected))

    it "authorizes the complete admitted AVX2 byte artifact with dependency evidence":
        val authorized = parser_structural_mapping_authorize_v1(publication(), checked_receipt(), code()).unwrap()
        expect(authorized.artifact_digest).to_equal(root_digest())
        expect(authorized.provider_generation).to_equal(6u64)
        expect(authorized.code_size).to_equal(code().len() as u64)
        expect(authorized.eligible_receipt.state).to_equal(EnvironmentVariantReceiptStateV1.Eligible)
        expect(publication().admission.admitted_artifacts.len()).to_equal(2)
        expect(publication().selected_variant_identities.len()).to_equal(1)

    it "rejects byte, publication, facet, trust and lifecycle substitutions":
        var wrong = code(); wrong[0] = wrong[0] ^ 1
        expect(parser_structural_mapping_authorize_v1(publication(), checked_receipt(), wrong)).to_equal(
            Err(ParserStructuralMappingAuthorizationErrorV1.ArtifactDigestMismatch))
        var wide = code(); wide[0] = 256
        expect(parser_structural_mapping_authorize_v1(publication(), checked_receipt(), wide)).to_equal(
            Err(ParserStructuralMappingAuthorizationErrorV1.InvalidCodeByte))
        var changed = publication(); changed.selected_variant_identities = [d(99u64)]
        expect(parser_structural_mapping_authorize_v1(changed, checked_receipt(), code())).to_equal(
            Err(ParserStructuralMappingAuthorizationErrorV1.InvalidPublication))
        changed = publication()
        var bindings = changed.facet_bindings; var bad_binding = bindings[0]
        bad_binding.facet_id = 2u16; bindings[0] = bad_binding; changed.facet_bindings = bindings
        changed.admission.plan.plan_digest = environment_composite_publication_expected_plan_digest_v1(changed)
        expect(parser_structural_mapping_authorize_v1(changed, checked_receipt(), code())).to_equal(
            Err(ParserStructuralMappingAuthorizationErrorV1.ParserFacetMissing))
        changed = publication()
        var artifacts = changed.admission.admitted_artifacts; var bad_artifact = artifacts[0]
        bad_artifact.trust_receipt.authentication_status = ENV_ARTIFACT_TRUST_UNKNOWN_V1
        artifacts[0] = bad_artifact; changed.admission.admitted_artifacts = artifacts
        expect(parser_structural_mapping_authorize_v1(changed, checked_receipt(), code())).to_equal(
            Err(ParserStructuralMappingAuthorizationErrorV1.LifecycleEvidenceRejected))
        var bad_receipt = checked_receipt(); bad_receipt.provider_generation = 99u64
        expect(parser_structural_mapping_authorize_v1(publication(), bad_receipt, code())).to_equal(
            Err(ParserStructuralMappingAuthorizationErrorV1.LifecycleEvidenceRejected))

    it "maps only after reauthorization, keeps address opaque and closes once":
        val owner = ParserStructuralMapperOwnerV1.create()
        val authorization = parser_structural_mapping_authorize_v1(
            publication(), checked_receipt(), code()).unwrap()
        val before = native_exec_memory_count()
        var wrong = code(); wrong[1] = wrong[1] ^ 1
        expect(parser_structural_mapper_map_v1(owner, publication(), checked_receipt(),
            authorization, wrong)).to_equal(Err(ParserStructuralMapperErrorV1.AuthorizationRejected))
        expect(native_exec_memory_count()).to_equal(before)
        var stale = authorization; stale.provider_generation = 99u64
        expect(parser_structural_mapper_map_v1(owner, publication(), checked_receipt(),
            stale, code())).to_equal(Err(ParserStructuralMapperErrorV1.AuthorizationSubstituted))
        expect(native_exec_memory_count()).to_equal(before)
        var receipt_substitution = authorization
        receipt_substitution.eligible_receipt.event_sequence =
            receipt_substitution.eligible_receipt.event_sequence + 1u64
        expect(parser_structural_mapper_map_v1(owner, publication(), checked_receipt(),
            receipt_substitution, code())).to_equal(
                Err(ParserStructuralMapperErrorV1.AuthorizationSubstituted))
        expect(native_exec_memory_count()).to_equal(before)
        val mapping = parser_structural_mapper_map_v1(owner, publication(), checked_receipt(),
            authorization, code())
        match mapping:
            case Ok(mapped):
                expect(native_exec_memory_count()).to_equal(before + 1)
                expect(mapped.provider_generation).to_equal(authorization.provider_generation)
                val generations = ProviderGenerationManagerV2.create()
                val activations = ParserStructuralProviderActivationOwnerV2.create()
                val active = parser_structural_provider_activate_v2(activations, generations,
                    owner, publication(), authorization, mapped).unwrap()
                expect(parser_structural_mapper_close_v1(owner, mapped)).to_equal(
                    Err(ParserStructuralMapperErrorV1.Busy))
                expect(parser_structural_provider_retire_v2(activations, generations, owner,
                    ParserStructuralProviderActivationV2(activation_id: 999u64))).to_equal(
                    Err(ParserStructuralProviderActivationErrorV2.UnknownOrSubstituted))
                expect(parser_structural_provider_retire_v2(activations, generations, owner,
                    active)).to_equal(Ok(()))
                expect(parser_structural_provider_retire_v2(activations, generations, owner,
                    active)).to_equal(Err(ParserStructuralProviderActivationErrorV2.AlreadyRetired))
                expect(parser_structural_mapper_invoke_v1(owner, mapped)).to_equal(
                    Err(ParserStructuralMapperErrorV1.ExecutionCapabilityProofMissing))
                expect(parser_structural_mapper_close_v1(owner, mapped)).to_equal(Ok(()))
                expect(native_exec_memory_count()).to_equal(before)
                expect(parser_structural_mapper_close_v1(owner, mapped)).to_equal(
                    Err(ParserStructuralMapperErrorV1.UnknownOrRetired))
            case Err(reason):
                # Some interpreter/sandbox hosts deny executable mappings.
                # That is a supported fail-closed result only when rollback
                # leaves the shared mapping owner exactly unchanged.
                expect(reason).to_equal(ParserStructuralMapperErrorV1.SealFailed)
                expect(native_exec_memory_count()).to_equal(before)

    it "refuses activation without the exact live authenticated mapping":
        val mappings = ParserStructuralMapperOwnerV1.create()
        val generations = ProviderGenerationManagerV2.create()
        val activations = ParserStructuralProviderActivationOwnerV2.create()
        val authorization = parser_structural_mapping_authorize_v1(
            publication(), checked_receipt(), code()).unwrap()
        val forged = ParserStructuralMappedKernelV1(mapped_handle: 77u64,
            provider_generation: authorization.provider_generation,
            artifact_digest: authorization.artifact_digest, code_size: authorization.code_size)
        expect(parser_structural_provider_activate_v2(activations, generations, mappings,
            publication(), authorization, forged)).to_equal(
            Err(ParserStructuralProviderActivationErrorV2.MappingNotLive))
        expect(generations.generations.len()).to_equal(0)
        var changed = publication()
        changed.root_descriptor_digest = d(99u64)
        expect(parser_structural_provider_activate_v2(activations, generations, mappings,
            changed, authorization, forged)).to_equal(
            Err(ParserStructuralProviderActivationErrorV2.InvalidPublication))
        expect(generations.generations.len()).to_equal(0)
        var substituted = authorization
        substituted.abi_digest = d(99u64)
        expect(parser_structural_provider_activate_v2(activations, generations, mappings,
            publication(), substituted, forged)).to_equal(
            Err(ParserStructuralProviderActivationErrorV2.AuthorizationMismatch))
        expect(generations.generations.len()).to_equal(0)
