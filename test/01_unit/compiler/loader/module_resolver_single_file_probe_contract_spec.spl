# Contract coverage for the single-file stdlib discovery startup path.
#
# The resolver's filesystem probe is intentionally not given a production
# injection hook solely for tests. This source contract pins the behaviorally
# significant traversal shape: the file parent is probed once, then exactly
# the same four ancestor levels and candidate order as before.

use std.io_runtime.{file_read}
use std.spec.*

val TYPES_SOURCE = "src/compiler/99.loader/module_resolver/types.spl"

fn single_file_search_body() -> text:
    val source = file_read(TYPES_SOURCE)
    val start_marker = "fn moduleresolver_single_file(file_path: text) -> ModuleResolver:"
    val end_marker = "fn moduleresolver_with_var_roots("
    val start = source.find(start_marker)
    if start < 0:
        fail("single-file resolver start marker is missing")
        return ""
    val tail = source.substring(start, source.len())
    val finish = tail.find(end_marker)
    if finish < 0:
        fail("single-file resolver end marker is missing")
        return ""
    tail.substring(0, finish)

describe "single-file module resolver probe traversal":
    it "does not probe the file parent twice after the first candidate pass":
        step("Inspect the single-file resolver search body")
        val body = single_file_search_body()

        step("Verify the ancestor pass starts above the already-probed parent")
        expect(body.contains("var current = path_parent(parent)")).to_equal(true)
        expect(body.contains("var current = parent")).to_equal(false)
        expect(body.contains("if current != parent:")).to_equal(true)

    it "preserves the legacy four post-parent ancestor levels and candidate order":
        step("Inspect the single-file resolver search body")
        val body = single_file_search_body()

        step("Verify the post-parent depth and ordered candidate traversal")
        val candidates = "val stdlib_candidates = [\n            \"src/lib/src\",\n            \"src/lib/std/src\",\n            \"simple/std_lib/src\",\n            \"std_lib/src\"\n        ]"
        val traversal = "for _unused in 0..4:\n                    for candidate in stdlib_candidates:\n                        val candidate_path = path_join2(current, candidate)\n                        if dir_exists(candidate_path):"
        expect(body.contains(candidates)).to_equal(true)
        expect(body.contains(traversal)).to_equal(true)
