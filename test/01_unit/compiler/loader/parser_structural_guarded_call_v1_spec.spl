use std.spec.*
use compiler.loader.parser_structural_guarded_call_v1.*
use compiler.loader.parser_structural_mask_mapper_v1.*
use compiler.loader.parser_structural_source_buffer_v1.*
use compiler.loader.parser_structural_mask_mapping_authorization_v1.*
use compiler.driver.parser_simd_execution_capability_v1.*
use compiler.driver.execution_domain_affinity_lease_v1.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.receipt_v1.*
use std.nogc_sync_mut.composition.environment_variants.provider_generation_v2.*
use compiler.loader.parser_structural_provider_activation_v2.*

fn d(v: u64) -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: v, w1: 0u64, w2: 0u64, w3: 0u64)

describe "guarded parser structural mask call V1":
    it "rejects missing capability before resolving or invoking opaque addresses":
        val mapper = ParserStructuralMapperOwnerV1.create()
        val source_owner = ParserStructuralSourceBufferOwnerV1.create()
        val affinity_owner = ExecutionDomainAffinityLeaseOwnerV1.create()
        val mapped = ParserStructuralMappedKernelV1(mapped_handle: 1u64,
            provider_generation: 6u64, artifact_digest: d(3u64), code_size: 44u64)
        val source = ParserStructuralNativeSourceLeaseV1(native_lease_id: 1u64,
            source_lease_id: 2u64, source_lease_generation: 3u64, byte_length: 32u64)
        val affinity = ExecutionDomainAffinityLeaseV1(lease_id: 1u64,
            lease_generation: 1u64, environment_identity: d(4u64), environment_generation: 5u64,
            execution_domain_identity: d(8u64), execution_domain_generation: 1u64,
            native_thread_id: 1, cpu_id: 0)
        val identity = EnvironmentVariantReceiptIdentityV1(provider_identity: d(1u64),
            variant_identity: d(2u64), artifact_digest: d(3u64), environment_identity: d(4u64),
            environment_generation: 5u64, provider_generation: 6u64)
        val authorization = ParserStructuralMappingAuthorizationV1(provider_identity: d(1u64),
            variant_identity: d(2u64), artifact_digest: d(3u64), plan_digest: d(7u64),
            environment_identity: d(4u64), environment_generation: 5u64,
            provider_generation: 6u64, parser_interface_major: 1u16,
            parser_interface_minor: 0u16, code_size: 44u64,
            abi_digest: d(12u64), contract_identity: d(13u64), semantic_identity: d(14u64),
            grammar_identity: d(15u64), program_identity: d(16u64),
            required_cpu_features: EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1,
                words: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32)),
            required_vector_state_mode: ENV_VECTOR_FIXED_V1, required_vector_length_bits: 256u32,
            provider_interface_handle: 40u64,
            eligible_receipt: environment_variant_receipt_create_v1(identity).unwrap())
        val capability = ParserSimdExecutionCapabilityReceiptV1(
            schema_version: 0u16, environment_identity: d(4u64), environment_generation: 5u64,
            execution_domain_identity: d(8u64), execution_domain_generation: 1u64,
            architecture: ENV_ARCH_X86_64_V1, required_feature_mask: 0u64,
            hardware_feature_mask: 0u64, os_usable_feature_mask: 0u64,
            policy_allowed_feature_mask: 0u64, vector_state_mode: ENV_VECTOR_NONE_V1,
            vector_length_bits: 0u32, verifier_identity: d(9u64), verifier_generation: 1u64,
            probe_evidence_digest: d(10u64), same_call_probe_only: true,
            worker_domain_stability_proven: false, affinity_lease_id: 0u64,
            affinity_lease_generation: 0u64, affinity_native_thread_id: 0,
            affinity_cpu_id: -1, receipt_digest: d(11u64))
        val snapshot = EnvironmentSnapshotV1(descriptor_size: 232u32,
            schema_version: ENV_VARIANT_SCHEMA_V1, execution_architecture: ENV_ARCH_X86_64_V1,
            os_id: 1u32, abi_id: 1u32, object_format_id: 1u32, endian_id: 1u16,
            pointer_width_bits: 64u16, snapshot_identity: d(4u64), snapshot_generation: 5u64,
            execution_domain_identity: d(8u64),
            hardware_features: EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1,
                words: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32)),
            os_usable_features: EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1,
                words: EnvironmentArenaRangeV1(offset: 1u32, count: 1u32)),
            policy_allowed_features: EnvironmentFeatureSetV1(architecture: ENV_ARCH_X86_64_V1,
                words: EnvironmentArenaRangeV1(offset: 2u32, count: 1u32)),
            vector_state_mode: ENV_VECTOR_NONE_V1, vector_length_bits: 0u32,
            loader_permission_bits: 1u64, allowed_effect_bits: 1u64,
            numerical_contract_id: 1u32, resource_layout_digest: d(12u64),
            gpu_devices: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32))
        val generations = ProviderGenerationManagerV2.create()
        val activation_owner = ParserStructuralProviderActivationOwnerV2.create()
        val activation = ParserStructuralProviderActivationV2(activation_id: 1u64)
        expect(parser_structural_guarded_mask_call_v1(mapper, mapped, generations,
            activation_owner, activation,
            source_owner, source,
            affinity_owner, affinity, snapshot, [0u64, 0u64, 0u64], authorization,
            capability, 0u64, 10u8, 34u8)).to_equal(
                Err(ParserStructuralGuardedCallErrorV1.CapabilityRejected))
        expect(generations.pins.len()).to_equal(0)
