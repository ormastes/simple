#!/bin/sh
set -eu

adapter=src/compiler/99.loader/shared_contract/package_image_loader_adapter.spl

test -f "$adapter"
grep -q 'package_section_reader_open_v1' "$adapter"
grep -q 'SmfReaderMemory.from_data' "$adapter"
grep -q 'symbols_in_table_order' "$adapter"
grep -q 'read_relocations' "$adapter"
grep -q 'snapshot_revision: text' "$adapter"
grep -q 'snapshot_tree_digest: text' "$adapter"
grep -q 'snapshot_inventory_digest: text' "$adapter"
grep -q 'action_digest: text' "$adapter"
grep -q 'relocation_symbol_out_of_bounds' "$adapter"
grep -q 'package_section_reader_close_v1' "$adapter"

if grep -Eq 'rt_(file|path)_|read_file|open\(' "$adapter"; then
    echo 'IL2 must not reopen archive paths or add a loader parser' >&2
    exit 1
fi

echo IL2_LOADER_SMF_ADAPTER_STATIC_PASS
