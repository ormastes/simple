use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI type-tag positions":
    it "rejects an invalid return tag":
        val handle = compiler_create_context()
        expect(compiler_check_types(handle, [0x00, 0, 0x12, 0x10, 0xFE])).to_equal(false)
        compiler_destroy_context(handle)

    it "rejects an invalid typed-load tag":
        val handle = compiler_create_context()
        val code: [u8] = [0x00, 1, 0x00, 0x01, 0x10, 8, 0x10, 0x20, 0, 0x12, 0xFE, 0xFF, 0x10]
        expect(compiler_check_types(handle, code)).to_equal(false)
        compiler_destroy_context(handle)

    it "rejects an invalid metadata tag":
        val handle = compiler_create_context()
        val code: [u8] = [0x00, 1, 0x00, 0x01, 0x10, 8, 0x10, 0x20, 0, 0x10, 0xFE, 0xFF, 0x12]
        expect(compiler_check_types(handle, code)).to_equal(false)
        compiler_destroy_context(handle)
