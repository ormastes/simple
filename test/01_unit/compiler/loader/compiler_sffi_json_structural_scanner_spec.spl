use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI JSON structural scanning":
    it "ignores structural delimiters inside escaped type strings":
        val first = TypeInfo(
            kind: "named", name: "A{B}[C]\"}D", has_bits: false, bits: 0,
            has_signed: false, signed: false, has_lanes: false, lanes: 0,
            args: [], has_elem: false, elem: nil
        )
        val second = make_int_type(32, true)
        val parsed = parse_types_json(serialize_types_json([first, second]))
        expect(parsed.len()).to_equal(2)
        expect(parsed[0].name).to_equal(first.name)
        expect(parsed[1].name).to_equal("i32")

    it "balances nested objects despite quoted closing braces":
        val json = '{"outer":{"name":"quoted } and ]","nested":{"value":"{"}},"after":1}'
        val body = sffi_json_field_object(json, "outer")
        expect(body).to_equal('{"name":"quoted } and ]","nested":{"value":"{"}}')

    it "rejects unmatched and unterminated object arrays":
        expect(sffi_json_object_array_items('[{"kind":"int"')).to_equal([])
        expect(sffi_json_object_array_items('[{"kind":"unterminated}]')).to_equal([])
        expect(sffi_json_object_array_items('[}')).to_equal([])
