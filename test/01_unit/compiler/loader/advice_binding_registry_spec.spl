# @req REQ-AF-007 REQ-AF-008 REQ-AF-010 NFR-AF-003
# @cover src/compiler/99.loader/loader/advice_binding_registry.spl 80%

use std.spec.*
use compiler.loader.loader.aspect_catalog.{AspectAdviceSummary}
use compiler.loader.loader.advice_binding_registry.{
    AdviceBindingAdmission, AdviceBindingRegistry, AdviceDispatchPermit,
    AdviceDispatchInvocationReceipt,
    advice_binding_stage_validated, advice_publish_generation,
    advice_lookup_slot, advice_unbind_generation,
    advice_disabled_path_footprint, advice_dispatch_projection_empty,
    advice_dispatch_projection_create,
    advice_dispatch_projection_invalidate,
    advice_dispatch_projection_with_invoker,
    advice_dispatch_projection_prepare,
    advice_dispatch_permit_invoke_with_invoker,
    advice_dispatch_projection_finalize, advice_merge_counter_delta
}
use compiler.loader.loader.module_loader.{ModuleLoader, moduleloader_with_defaults}
use compiler.loader.{LoadedSymbol, SymbolType}
use os.smf.smf_generation.{LifecycleManager}

fn advice_summary(id: text, witness: text, priority: i64, specificity: i64) -> AspectAdviceSummary:
    AspectAdviceSummary(
        advice_id: id,
        joinpoint_slot_id: "orders.submit.prepared",
        form: "before",
        priority: priority,
        specificity: specificity,
        witness_symbol: witness,
        capabilities: ["orders.observe"])

fn publish_advice(
    registry: AdviceBindingRegistry,
    activation_key: text,
    aspect_id: text,
    admissions: [AdviceBindingAdmission]
) -> AdviceBindingRegistry:
    val candidate = advice_binding_stage_validated(
        registry, activation_key, 7, aspect_id, admissions).unwrap()
    advice_publish_generation(
        registry, candidate, activation_key, 7).unwrap()

fn advice_test_invoke(address: i64) -> Result<i64, text>:
    if address == 103: return Ok(3003)
    if address == 102: return Ok(2002)
    if address == 101: return Ok(1001)
    Err("unexpected callback address")

fn advice_test_invoke_failure(address: i64) -> Result<i64, text>:
    if address == 102: return Err("callback rejected")
    advice_test_invoke(address)

fn advice_test_loader() -> ModuleLoader:
    var loader = moduleloader_with_defaults()
    loader.global_symbols["z_audit"] = ("pack:a:7", LoadedSymbol(
        name: "z_audit", address: 101, size: 8,
        ty: SymbolType.Function, is_jit: false, file_offset: 0))
    loader.global_symbols["a_audit"] = ("pack:a:7", LoadedSymbol(
        name: "a_audit", address: 102, size: 8,
        ty: SymbolType.Function, is_jit: false, file_offset: 0))
    loader.global_symbols["m_audit"] = ("pack:a:7", LoadedSymbol(
        name: "m_audit", address: 103, size: 8,
        ty: SymbolType.Function, is_jit: false, file_offset: 0))
    loader

describe "Loader advice binding registry":
    it "publishes only prepared slots and preserves canonical AOP order":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101),
            AdviceBindingAdmission(
                summary: advice_summary("audit.tie", "a_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 102),
            AdviceBindingAdmission(
                summary: advice_summary("audit.high", "m_audit", 20, 1),
                witness_owner_id: "pack:a:7", resolved_witness_address: 103)])

        val lookup = advice_lookup_slot(registry, "orders.submit.prepared").unwrap()
        expect(lookup.chain.len()).to_equal(3)
        expect(lookup.chain[0].advice_id).to_equal("audit.high")
        expect(lookup.chain[1].advice_id).to_equal("audit.tie")
        expect(lookup.chain[2].advice_id).to_equal("audit.low")
        expect(lookup.registry.counters.advice_publications).to_equal(1)
        expect(lookup.registry.counters.slot_lookups).to_equal(1)
        expect(lookup.registry.counters.slot_hits).to_equal(1)
        expect(lookup.registry.counters.disabled_slot_checks).to_equal(1)
        expect(lookup.registry.counters.disabled_slot_branches).to_equal(1)

    it "fails closed for unprepared targets and duplicate advice IDs":
        val registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        var unprepared = advice_summary("audit.bad", "audit_bad", 1, 1)
        unprepared.joinpoint_slot_id = "orders.unknown"
        val unprepared_result = advice_binding_stage_validated(
            registry, "pack:a:7", 7, "audit.aspect", [
            AdviceBindingAdmission(summary: unprepared, witness_owner_id: "pack:a:7", resolved_witness_address: 101)
        ])
        expect(unprepared_result.unwrap_err()).to_contain("without a prepared join point")

        val duplicate = advice_summary("audit.same", "audit_same", 1, 1)
        val duplicate_result = advice_binding_stage_validated(
            registry, "pack:a:7", 7, "audit.aspect", [
            AdviceBindingAdmission(summary: duplicate, witness_owner_id: "pack:a:7", resolved_witness_address: 101),
            AdviceBindingAdmission(summary: duplicate, witness_owner_id: "pack:a:7", resolved_witness_address: 101)
        ])
        expect(duplicate_result.unwrap_err()).to_contain("duplicate staged dynamic advice")

        val unresolved = advice_binding_stage_validated(
            registry, "pack:a:7", 7, "audit.aspect", [
                AdviceBindingAdmission(
                    summary: advice_summary("audit.unresolved", "audit_unresolved", 1, 1),
                    witness_owner_id: "pack:a:7", resolved_witness_address: 0)])
        expect(unresolved.unwrap_err()).to_contain("invalid loaded dynamic advice")

    it "counts disabled prepared slots and removes visibility before drain":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        val miss = advice_lookup_slot(registry, "orders.submit.prepared").unwrap()
        registry = miss.registry
        expect(miss.chain.len()).to_equal(0)
        expect(registry.counters.slot_misses).to_equal(1)

        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.active", "audit_active", 1, 1),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        registry = advice_unbind_generation(registry, "pack:a:7", 7)
        val after = advice_lookup_slot(registry, "orders.submit.prepared").unwrap()
        expect(after.chain.len()).to_equal(0)
        expect(after.registry.counters.advice_unbinds).to_equal(1)
        expect(after.registry.counters.slot_misses).to_equal(2)

        val footprint = advice_disabled_path_footprint()
        expect(footprint.dispatch_kind).to_equal("prepared_slot_guard")
        expect(footprint.disabled_footprint_bytes).to_equal(1)
        expect(footprint.disabled_footprint_source).to_equal("contract_minimum_not_backend_measurement")
        expect(footprint.prepared_slot_checks_per_call).to_equal(1)
        expect(footprint.conditional_branches_per_call).to_equal(1)
        expect(footprint.exact_zero_overhead).to_equal(false)

    it "dispatches an empty supported phase without inventing a callback":
        val registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        val outcome = advice_dispatch_projection_with_invoker(
            advice_dispatch_projection_empty(), registry,
            LifecycleManager.new_manager(), moduleloader_with_defaults(),
            "orders.submit.prepared", "before", advice_test_invoke)
        expect(outcome.status).to_equal("dispatched")
        expect(outcome.invoked_count).to_equal(0)
        expect(outcome.return_values.len()).to_equal(0)
        expect(outcome.registry.counters.dispatch_attempts).to_equal(1)
        expect(outcome.registry.counters.dispatch_invocations).to_equal(0)

    it "fails before invocation when loader witness ownership is absent":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.stale", "audit_stale", 1, 1),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        var loader = advice_test_loader()
        loader.global_symbols["audit_stale"] = ("pack:a:7", LoadedSymbol(
            name: "audit_stale", address: 101, size: 8,
            ty: SymbolType.Function, is_jit: false, file_offset: 0))
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        val other_phase = advice_dispatch_projection_with_invoker(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "after_success", advice_test_invoke)
        expect(other_phase.status).to_equal("dispatched")
        expect(other_phase.invoked_count).to_equal(0)
        registry = other_phase.registry
        loader.global_symbols["audit_stale"] = ("other-owner", LoadedSymbol(
            name: "audit_stale", address: 101, size: 8,
            ty: SymbolType.Function, is_jit: false, file_offset: 0))
        val outcome = advice_dispatch_projection_with_invoker(
            projection, registry, other_phase.lifecycle, loader,
            "orders.submit.prepared", "before", advice_test_invoke)
        expect(outcome.status).to_equal("failed")
        expect(outcome.reason).to_contain("no longer loader-owned")
        expect(outcome.invoked_count).to_equal(0)
        expect(outcome.registry.counters.dispatch_failures).to_equal(1)
        expect(outcome.registry.counters.dispatch_invocations).to_equal(0)
        expect(outcome.registry.counters.dispatch_attempts).to_equal(2)

    it "rejects runtime around advice without pretending to provide proceed":
        val registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        var around = advice_summary("audit.around", "audit_around", 1, 1)
        around.form = "around"
        val staged = advice_binding_stage_validated(
            registry, "pack:a:7", 7, "audit.aspect", [
                AdviceBindingAdmission(
                    summary: around, witness_owner_id: "pack:a:7",
                    resolved_witness_address: 101)])
        expect(staged.unwrap_err()).to_contain("exactly-once proceed path")

        val outcome = advice_dispatch_projection_with_invoker(
            advice_dispatch_projection_empty(), registry,
            LifecycleManager.new_manager(), moduleloader_with_defaults(),
            "orders.submit.prepared", "around", advice_test_invoke)
        expect(outcome.status).to_equal("failed")
        expect(outcome.reason).to_contain("exactly-once proceed path")
        expect(outcome.registry.counters.around_rejections).to_equal(1)

    it "derives an exact-generation projection only from loader-owned records":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.active", "audit_active", 1, 1),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        var loader = moduleloader_with_defaults()
        loader.global_symbols["audit_active"] = ("pack:a:7", LoadedSymbol(
            name: "audit_active", address: 101, size: 8,
            ty: SymbolType.Function, is_jit: false, file_offset: 0))
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        expect(projection.schema_id).to_equal("simple.advice-dispatch-projection")
        expect(projection.entries.len()).to_equal(1)
        expect(projection.entries[0].publication_id).to_equal("pack:a:7@7")
        expect(projection.entries[0].generation).to_equal(7)
        expect(projection.entries[0].resolved_witness_address).to_equal(101)

        loader.global_symbols["audit_active"] = ("other-owner", loader.global_symbols["audit_active"][1])
        expect(advice_dispatch_projection_create(registry, loader).unwrap_err()).to_contain(
            "no longer loader-owned")

    it "pins the exact generation, invokes the complete phase chain in order, and releases every token":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101),
            AdviceBindingAdmission(
                summary: advice_summary("audit.tie", "a_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 102),
            AdviceBindingAdmission(
                summary: advice_summary("audit.high", "m_audit", 20, 1),
                witness_owner_id: "pack:a:7", resolved_witness_address: 103)])
        val loader = advice_test_loader()
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        val outcome = advice_dispatch_projection_with_invoker(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "before", advice_test_invoke)

        expect(outcome.status).to_equal("dispatched")
        expect(outcome.return_values).to_equal([3003, 2002, 1001])
        expect(outcome.invoked_count).to_equal(3)
        expect(outcome.tokens_acquired).to_equal(3)
        expect(outcome.tokens_released).to_equal(3)
        expect(outcome.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(0)

    it "rejects stale or forged projected generations without leaking a partial pin":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101),
            AdviceBindingAdmission(
                summary: advice_summary("audit.tie", "a_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 102)])
        val loader = advice_test_loader()
        var projection = advice_dispatch_projection_create(registry, loader).unwrap()
        projection.entries[1].generation = 8
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        val outcome = advice_dispatch_projection_prepare(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "before")

        expect(outcome.status).to_equal("failed")
        expect(outcome.reason).to_contain("stale or unpublished")
        expect(outcome.permit == nil).to_equal(true)
        expect(outcome.tokens_acquired).to_equal(1)
        expect(outcome.tokens_released).to_equal(1)
        expect(outcome.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(0)

    it "releases the exact generation tokens after loader validation or callback failure":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101),
            AdviceBindingAdmission(
                summary: advice_summary("audit.tie", "a_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 102)])
        var loader = advice_test_loader()
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        loader.global_symbols["z_audit"] = (
            "forged-owner", loader.global_symbols["z_audit"][1])
        val invalid = advice_dispatch_projection_with_invoker(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "before", advice_test_invoke)
        expect(invalid.status).to_equal("failed")
        expect(invalid.reason).to_contain("no longer loader-owned")
        expect(invalid.tokens_acquired).to_equal(2)
        expect(invalid.tokens_released).to_equal(2)
        expect(invalid.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(0)

        val callback = advice_dispatch_projection_with_invoker(
            projection, registry, lifecycle, advice_test_loader(),
            "orders.submit.prepared", "before", advice_test_invoke_failure)
        expect(callback.status).to_equal("failed")
        expect(callback.reason).to_contain("callback rejected")
        expect(callback.invoked_count).to_equal(1)
        expect(callback.registry.counters.dispatch_invocations).to_equal(1)
        expect(callback.registry.counters.dispatch_failures).to_equal(1)
        expect(callback.tokens_acquired).to_equal(2)
        expect(callback.tokens_released).to_equal(2)
        expect(callback.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(0)

    it "finalizes against current state and merges deltas without stale replacement":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        val loader = advice_test_loader()
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        val prepared = advice_dispatch_projection_prepare(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "before")
        expect(prepared.status).to_equal("prepared")
        expect(prepared.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(1)
        expect(prepared.permit != nil).to_equal(true)
        val permit = prepared.permit.unwrap()

        # Simulate unrelated registry and lifecycle commits during the unlocked
        # callback interval. Finalize must retain both.
        val prepared_registry = advice_merge_counter_delta(
            registry, prepared.counter_delta)
        val current_registry = advice_lookup_slot(
            prepared_registry, "orders.submit.prepared").unwrap().registry
        val unrelated_pin = prepared.lifecycle.acquire_generation_token_for(
            "pack:a:7", 7).unwrap()
        val receipt = advice_dispatch_permit_invoke_with_invoker(
            permit, advice_test_invoke)
        val outcome = advice_dispatch_projection_finalize(
            permit, receipt, current_registry, unrelated_pin.0)

        expect(outcome.status).to_equal("dispatched")
        expect(outcome.return_values).to_equal([1001])
        expect(outcome.registry.counters.slot_lookups).to_equal(2)
        expect(outcome.registry.counters.dispatch_invocations).to_equal(1)
        expect(outcome.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(1)

    it "binds receipts to permits and rejects finalize replay through token authority":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        val loader = advice_test_loader()
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        val prepared = advice_dispatch_projection_prepare(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "before")
        expect(prepared.status).to_equal("prepared")
        expect(prepared.permit != nil).to_equal(true)
        val permit = prepared.permit.unwrap()
        val receipt = advice_dispatch_permit_invoke_with_invoker(
            permit, advice_test_invoke)
        val prepared_registry = advice_merge_counter_delta(
            registry, prepared.counter_delta)
        val first = advice_dispatch_projection_finalize(
            permit, receipt, prepared_registry, prepared.lifecycle)
        expect(first.status).to_equal("dispatched")
        expect(first.tokens_released).to_equal(1)

        val replay = advice_dispatch_projection_finalize(
            permit, receipt, first.registry, first.lifecycle)
        expect(replay.status).to_equal("failed")
        expect(replay.reason).to_contain("token release failed")
        expect(replay.tokens_released).to_equal(0)

        val prepared_again = advice_dispatch_projection_prepare(
            projection, replay.registry, first.lifecycle, loader,
            "orders.submit.prepared", "before")
        expect(prepared_again.status).to_equal("prepared")
        expect(prepared_again.permit != nil).to_equal(true)
        val permit_again = prepared_again.permit.unwrap()
        val mismatched = AdviceDispatchInvocationReceipt(
            permit_id: "other-permit", status: "invoked", reason: "",
            invoked_count: 1, return_values: [1001])
        val rejected = advice_dispatch_projection_finalize(
            permit_again, mismatched, replay.registry, prepared_again.lifecycle)
        expect(rejected.status).to_equal("failed")
        expect(rejected.reason).to_contain("does not match its permit")
        expect(rejected.tokens_released).to_equal(1)
        expect(rejected.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(0)

    it "does not release any token carried by a malformed permit":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        val loader = advice_test_loader()
        val projection = advice_dispatch_projection_create(registry, loader).unwrap()
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()
        val prepared = advice_dispatch_projection_prepare(
            projection, registry, lifecycle, loader,
            "orders.submit.prepared", "before")
        expect(prepared.status).to_equal("prepared")
        expect(prepared.permit != nil).to_equal(true)
        var malformed = prepared.permit.unwrap()
        val receipt = advice_dispatch_permit_invoke_with_invoker(
            malformed, advice_test_invoke)
        val unrelated = prepared.lifecycle.acquire_generation_token_for(
            "pack:a:7", 7).unwrap()
        malformed.entries[0].slot_id = "other.slot"
        val rejected = advice_dispatch_projection_finalize(
            malformed, receipt, registry, unrelated.0)

        expect(rejected.status).to_equal("failed")
        expect(rejected.reason).to_contain("permit structure is invalid")
        expect(rejected.tokens_released).to_equal(0)
        expect(rejected.lifecycle.generation_pin_count_for("pack:a:7", 7)).to_equal(2)

    it "documents that an empty permit needs an application ledger for replay":
        val registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        val prepared = advice_dispatch_projection_prepare(
            advice_dispatch_projection_empty(), registry,
            LifecycleManager.new_manager(), moduleloader_with_defaults(),
            "orders.submit.prepared", "before")
        expect(prepared.status).to_equal("prepared")
        expect(prepared.permit != nil).to_equal(true)
        val permit = prepared.permit.unwrap()
        val receipt = advice_dispatch_permit_invoke_with_invoker(
            permit, advice_test_invoke)
        val prepared_registry = advice_merge_counter_delta(
            registry, prepared.counter_delta)
        val first = advice_dispatch_projection_finalize(
            permit, receipt, prepared_registry, prepared.lifecycle)
        val replay = advice_dispatch_projection_finalize(
            permit, receipt, first.registry, first.lifecycle)

        expect(first.status).to_equal("dispatched")
        expect(replay.status).to_equal("dispatched")
        expect(replay.tokens_released).to_equal(0)

    it "invalidates exact projection visibility before quiesce and drain":
        var registry = AdviceBindingRegistry.create(["orders.submit.prepared"]).unwrap()
        registry = publish_advice(registry, "pack:a:7", "audit.aspect", [
            AdviceBindingAdmission(
                summary: advice_summary("audit.low", "z_audit", 10, 4),
                witness_owner_id: "pack:a:7", resolved_witness_address: 101)])
        val projection = advice_dispatch_projection_create(
            registry, advice_test_loader()).unwrap()
        val hidden = advice_dispatch_projection_invalidate(
            projection, "pack:a:7", 7)
        val lifecycle = LifecycleManager.new_manager().register_candidate(
            "pack:a:7", 7).promote_candidate()

        expect(hidden.entries.len()).to_equal(0)
        expect(lifecycle.generation_state_for("pack:a:7", 7)).to_equal("active")
        val quiesced = lifecycle.quiesce_generation_for("pack:a:7", 7).unwrap()
        expect(quiesced.generation_state_for("pack:a:7", 7)).to_equal("quiescing")
        expect(quiesced.generation_pin_count_for("pack:a:7", 7)).to_equal(0)
