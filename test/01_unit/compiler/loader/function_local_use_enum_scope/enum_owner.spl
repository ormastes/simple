# Fixture: a module whose closure defines an enum AND a function that returns
# one of its values. A function-local `use` of `describe_level` must bring
# `FixtureLevel` into scope too, or the call fails at run time with
# "enum `FixtureLevel` not found in this scope".
# See doc/08_tracking/bug/function_local_use_loses_enum_scope_2026-09-12.md

enum FixtureLevel:
    Info
    Warning

fn describe_level(level: FixtureLevel) -> text:
    if level == FixtureLevel.Warning:
        return "warning"
    "info"

fn default_level() -> FixtureLevel:
    FixtureLevel.Warning

export FixtureLevel, describe_level, default_level
