#!/bin/sh
set -eu

interp=src/compiler/95.interp/load_facade/__init__.spl
loader=src/compiler/99.loader/runtime/package_image_entrypoint.spl
runtime=src/compiler/99.loader/runtime/__init__.spl

grep -q 'interpreter_load_facade_v1' "$interp"
grep -q 'interpreter_load_from_package_v1' "$interp"
grep -q 'provider_admit_metadata_v1' "$loader"
grep -q 'pinned_archive_close_v1(request.capability)' "$loader"
grep -q 'package_image_to_loader_contract_v1' "$loader"
grep -q 'package_image_loader_admit_v1' "$runtime"

provider_line=$(grep -n 'val admitted = provider_admit_metadata_v1' "$loader" | cut -d: -f1)
adapter_line=$(grep -n 'val adapted = package_image_to_loader_contract_v1' "$loader" | cut -d: -f1)
test "$provider_line" -lt "$adapter_line"

if grep -Eq 'archive_path|read_file|SmfReaderImpl\.open|compiler\.loader\.loader\.' "$loader"; then
    echo 'package-image production entrypoint bypasses pinned authority' >&2
    exit 1
fi
if grep -q 'provider_execution_ticket_v1' "$loader"; then
    echo 'metadata admission must not execute provider effects' >&2
    exit 1
fi

echo INTERPRETER_LOADER_PRODUCTION_ENTRYPOINT_STATIC_PASS
