"""Explicit compatibility-loader intent checks."""

use compiler.loader.test_loader_cases.{
    loader_registers_source_metadata, loader_rejects_source_as_smf,
    loader_rejects_cross_intent_cache
}
use std.spec.{describe, it, expect, step}

fn source_fixture() -> text:
    "test/01_unit/compiler/loader/module_load_intent_spec.spl"

describe "Module load intent":
    it "registers source metadata only when explicitly requested":
        step("Load a source path with SourceMetadata intent")
        expect(loader_registers_source_metadata(source_fixture())).to_equal(true)

    it "rejects source bytes when an SMF artifact is required":
        step("Load the same source path with the default SMF intent")
        expect(loader_rejects_source_as_smf(source_fixture())).to_equal(true)

    it "does not reuse a source metadata cache entry for SMF intent":
        step("Load source metadata, then request the same path as an SMF artifact")
        expect(loader_rejects_cross_intent_cache(source_fixture())).to_equal(true)

    it "does not count a missing fixture as intent coverage":
        step("Require all three real loader cases to reject a missing source fixture")
        val missing_path = "test/01_unit/compiler/loader/__missing_loader_intent_fixture__.spl"
        expect(loader_registers_source_metadata(missing_path)).to_equal(false)
        expect(loader_rejects_source_as_smf(missing_path)).to_equal(false)
        expect(loader_rejects_cross_intent_cache(missing_path)).to_equal(false)
