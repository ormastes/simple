use compiler.loader.loader.compiler_sffi.*

describe "Compiler SFFI JSON string round trip":
    it "parses its escaped type output without truncating at quotes":
        val original_name = "A\\B\"C\nD\tE"
        val ty = TypeInfo(
            kind: "named", name: original_name, has_bits: false, bits: 0,
            has_signed: false, signed: false, has_lanes: false, lanes: 0,
            args: [], has_elem: false, elem: nil
        )
        val parsed = json_to_type_info_text(serialize_type_json(ty))
        expect(parsed.name).to_equal(original_name)

    it "round-trips escaped compiler errors":
        val original_error = "bad \"type\"\\path\nnext\tcolumn"
        val result = CompilationResult(
            success: false, code: [], has_error: true, error: original_error
        )
        expect(compiler_result_json_error(serialize_compilation_result(result))).to_equal(original_error)

    it "decodes canonical unicode control escapes and rejects malformed ones":
        expect(sffi_json_unquote('"a\\u0001b"')).to_equal("a" + text.from_char_code(1) + "b")
        expect(sffi_json_unquote('"a\\u00xz"')).to_equal("")
        expect(sffi_json_unquote('"bad\\q"')).to_equal("")
