use compiler.loader.loader.compiler_sffi.*

fn structural_hint(source: text, has_index: bool, index: i64, ty: TypeInfo) -> TypeHint:
    TypeHint(
        source: source, has_param_index: has_index, param_index: index, ty: ty
    )

describe "Compiler SFFI structural hint cache keys":
    it "distinguishes identical hint locations carrying different types":
        val integer = structural_hint("call_site", true, 0, make_int_type(64, true))
        val floating = structural_hint("call_site", true, 0, make_float_type(64))
        expect(hints_to_key([integer]) == hints_to_key([floating])).to_equal(false)

    it "distinguishes an absent parameter index from explicit zero":
        val ty = make_int_type(64, true)
        val absent = structural_hint("call_site", false, 0, ty)
        val zero = structural_hint("call_site", true, 0, ty)
        expect(hints_to_key([absent]) == hints_to_key([zero])).to_equal(false)

    it "frames sources and preserves ordered hint boundaries":
        val ty = make_int_type(32, true)
        val colon = structural_hint("call:site", false, 0, ty)
        val plain = structural_hint("call", false, 0, ty)
        val tail = structural_hint("site", false, 0, ty)
        expect(hints_to_key([colon]) == hints_to_key([plain, tail])).to_equal(false)
        expect(hints_to_key([colon])).to_equal(hints_to_key([colon]))
