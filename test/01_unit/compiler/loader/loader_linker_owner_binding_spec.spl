# Regression: loader consumers bind the actual numbered backend linker owner.
use std.spec.{describe, it, expect}
use compiler.loader.loader.smf_cache.{parse_header_minimal}
use compiler.backend.linker.smf_header.{SMF_HEADER_SIZE}
use compiler.backend.linker.smf_enums.{Platform, Arch, CompressionType}

describe "loader canonical linker owners":
    it "retains the short-input header fallback through the real reader types":
        val header = parse_header_minimal([])
        expect(SMF_HEADER_SIZE).to_equal(128)
        expect(header.version).to_equal((1, 1))
        expect(header.platform).to_equal(Platform.Linux)
        expect(header.arch).to_equal(Arch.X86_64)
        expect(header.compression).to_equal(CompressionType.None_)
        expect(header.section_count).to_equal(0)
