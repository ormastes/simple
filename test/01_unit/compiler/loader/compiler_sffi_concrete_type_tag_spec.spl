use compiler.loader.loader.compiler_sffi.*

fn unknown_sffi_type() -> TypeInfo:
    TypeInfo(
        kind: "mystery", name: "unknown", has_bits: false, bits: 0,
        has_signed: false, signed: false, has_lanes: false, lanes: 0,
        args: [], has_elem: false, elem: nil
    )

fn concrete_type_test_context() -> CompilerContextImpl:
    CompilerContextImpl(
        type_cache: {}, instantiation_cache: {},
        type_cache_keys: [], instantiation_cache_keys: [],
        type_cache_evict_index: 0, instantiation_cache_evict_index: 0,
        type_cache_count: 0, instantiation_cache_count: 0,
        stats: ContextStats(
            type_inferences: 0, template_instantiations: 0,
            cache_hits: 0, cache_misses: 0
        ), next_type_var: 0
    )

describe "Compiler SFFI concrete type tags":
    it "rejects unknown concrete arguments before cache work":
        val handle = compiler_create_context()
        val result = compiler_instantiate_template_typed(
            handle, "unknown_arg", ["T"], [unknown_sffi_type()]
        )
        expect(result.success).to_equal(false)
        expect(result.error).to_equal("unsupported template type argument")
        expect(compiler_get_stats(handle)).to_contain('"cache_misses": 0')
        compiler_destroy_context(handle)

    it "rejects unknown declared return types before cache work":
        val ctx = concrete_type_test_context()
        val tmpl = SffiTemplate(
            name: "unknown_return", type_params: [], param_types: [],
            has_return_type: true, return_type: unknown_sffi_type()
        )
        val result = ctx.instantiate_template(tmpl, [])
        expect(result.success).to_equal(false)
        expect(result.error).to_equal("unsupported template return type")
        expect(ctx.stats.cache_misses).to_equal(0)

    it "accepts void only as a return tag":
        val ctx = concrete_type_test_context()
        expect(ctx.check_types([0x00, 0, 0x00, 0x10, 0xFE])).to_equal(true)
        expect(ctx.check_types([0x00, 1, 0x00, 0x01, 0x00, 8, 0x10, 0x20, 0, 0x00, 0xFE, 0xFF, 0x00])).to_equal(false)
