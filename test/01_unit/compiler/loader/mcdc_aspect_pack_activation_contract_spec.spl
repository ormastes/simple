use std.spec.*
use std.io_runtime.{file_read_text}

describe "MC/DC aspect-pack activation ownership contract":
    it "keeps compatibility loader payload machinery absent until explicit activation":
        val source = file_read_text("src/compiler/99.loader/module_loader_compat.spl")
        expect(source).to_contain("mcdc_payload_loader_cell: Dict<i64, LazyModuleLoader>")
        expect(source).to_contain("mcdc_payload_loader_cell: {}")
        expect(source).to_contain("if not self.mcdc_payload_loader_cell.has(0)")

    it "orders withdrawal and settlement before executable owner unmap":
        val source = file_read_text("src/compiler/99.loader/loader/module_loader.spl")
        val retire = source.split("fn moduleloader_retire_mcdc_aspect_payload_v1")[1]
        expect(retire).to_contain("moduleloader_retire_mcdc_aspect(self, owner_id)")
        expect(retire).to_contain("lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)")
        expect(retire.index_of("moduleloader_retire_mcdc_aspect(self, owner_id)")).to_be_less_than(
            retire.index_of("lifecycle_unload_module(lifecycle, jit.exec_mapper, owner_id)"))
