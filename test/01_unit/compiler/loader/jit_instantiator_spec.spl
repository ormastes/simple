"""
## Purpose and audience
Purpose: Prove that Jit Instantiator.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LOADER-001 — stable requirement identity for this spec.

use compiler.loader.jit_instantiator.*

fn default_jit_config() -> JitInstantiatorConfig:
    JitInstantiatorConfig(
        update_smf: true,
        max_depth: 50,
        enabled: true,
        verbose: false
    )

use std.spec.step

describe "Jit Instantiator":
    it "reports empty stats for a new instance":
        step("Verify: reports empty stats for a new instance")
        # @req: REQ-COMPILER-LOADER-001
        val jit = JitInstantiator.new(default_jit_config())
        val stats = jit.stats()
        expect(stats.cached_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(stats.compile_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(stats.loaded_smf_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "finds metadata-backed symbols":
        step("Verify: finds metadata-backed symbols")
        var jit = JitInstantiator.new(default_jit_config())
        val entry = PossibleInstantiation(
            template_name: "Vec",
            type_args: "i64",
            mangled_name: "Vec$i64"
        )
        jit.set_metadata_for_test("vec.smf", LoadedMetadata(possible: [entry], instantiations: []))

        expect(jit.can_jit_instantiate("Vec$i64")).to_equal(true)
        val found = jit.find_possible("Vec$i64")
        expect(found != nil).to_equal(true)
        expect(found.unwrap()[0]).to_equal("vec.smf")

    it "keeps global symbol replacement and removal exact across mappers":
        step("Verify: keyed global registry preserves replacement, precedence, and removal")
        val mapper = JitMapper()
        var first = JitExecMapper(records: {}, symbols: [], owners: [], addresses: [])
        var second = JitExecMapper(records: {}, symbols: [], owners: [], addresses: [])

        _ = mapper.map(first, "owner-a", "shared_registry_symbol", [1])
        _ = mapper.map(second, "owner-b", "shared_registry_symbol", [2])

        val replaced = first.lookup("shared_registry_symbol").unwrap()
        expect(replaced.owner_id).to_equal("owner-b")
        expect(replaced.address).to_equal(1)

        _global_remove("shared_registry_symbol")
        val local_fallback = first.lookup("shared_registry_symbol").unwrap()
        expect(local_fallback.owner_id).to_equal("owner-a")
        expect(second.lookup("shared_registry_symbol").unwrap().owner_id).to_equal("owner-b")

    it "returns cached code without changing depth":
        step("Verify: returns cached code without changing depth")
        var jit = JitInstantiator.new(default_jit_config())
        jit.set_cache_for_test("cached_fn", [1, 2, 3], 4096)
        val before_depth = jit.depth

        val result = jit.try_jit_instantiate("cached_fn")
        match result:
            case JitInstantiationResult.Success(code, symbol, address):
                expect(code).to_equal([1, 2, 3])
                expect(symbol).to_equal("cached_fn")
                expect(address.unwrap()).to_equal(4096)  # oracle: 4096 — named expected value from the requirement
            case _:
                fail("expected cached success")

        expect(jit.depth).to_equal(before_depth)

    it "compiles known metadata-backed symbols and records the instantiation":
        step("Verify: compiles known metadata-backed symbols and records the instantiation")
        var jit = JitInstantiator.new(default_jit_config())
        val entry = PossibleInstantiation(
            template_name: "Map",
            type_args: "text,i64",
            mangled_name: "Map$text_i64"
        )
        jit.set_metadata_for_test("map.smf", LoadedMetadata(possible: [entry], instantiations: []))

        val result = jit.try_jit_instantiate("Map$text_i64")
        match result:
            case JitInstantiationResult.Success(code, symbol, address):
                expect(symbol).to_equal("Map$text_i64")
                expect(code).to_equal([
                    77, 97, 112, 58,
                    116, 101, 120, 116, 44, 105, 54, 52, 58,
                    77, 97, 112, 36, 116, 101, 120, 116, 95, 105, 54, 52,
                    195
                ])
                expect(address != nil).to_equal(true)
            case _:
                fail("expected compile success")

        expect(jit.in_progress.contains("Map$text_i64")).to_equal(false)
        expect(jit.depth).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(jit.stats().compile_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(jit.loaded_metadata["map.smf"].possible.len()).to_equal(0)
        expect(jit.loaded_metadata["map.smf"].instantiations.len()).to_equal(1)

    it "preserves empty fields and multibyte UTF-8 in compiled bytes":
        step("Verify: preserves exact framing without a byte-array temporary")
        val config = JitInstantiatorConfig(
            update_smf: false,
            max_depth: 50,
            enabled: true,
            verbose: false
        )

        var empty_jit = JitInstantiator.new(config)
        empty_jit.set_metadata_for_test("empty.smf", LoadedMetadata(
            possible: [PossibleInstantiation(
                template_name: "",
                type_args: "",
                mangled_name: ""
            )],
            instantiations: []
        ))
        match empty_jit.try_jit_instantiate(""):
            case JitInstantiationResult.Success(code, _, _):
                expect(code).to_equal([58, 58, 195])
            case _:
                fail("expected empty-field compile success")

        var utf8_jit = JitInstantiator.new(config)
        utf8_jit.set_metadata_for_test("utf8.smf", LoadedMetadata(
            possible: [PossibleInstantiation(
                template_name: "Café",
                type_args: "Té",
                mangled_name: "Café$Té"
            )],
            instantiations: []
        ))
        match utf8_jit.try_jit_instantiate("Café$Té"):
            case JitInstantiationResult.Success(code, _, _):
                expect(code).to_equal([
                    67, 97, 102, 195, 169, 58,
                    84, 195, 169, 58,
                    67, 97, 102, 195, 169, 36, 84, 195, 169,
                    195
                ])
            case _:
                fail("expected UTF-8 compile success")

    it "detects direct circular dependencies":
        step("Verify: detects direct circular dependencies")
        var jit = JitInstantiator.new(default_jit_config())
        jit.in_progress = jit.in_progress.push("cycle_fn")

        val result = jit.try_jit_instantiate("cycle_fn")
        match result:
            case JitInstantiationResult.CircularDependency(cycle):
                expect(cycle.len()).to_be_greater_than(0)
            case _:
                fail("expected circular dependency")

    it "enforces the configured depth limit":
        step("Verify: enforces the configured depth limit")
        var jit = JitInstantiator.new(JitInstantiatorConfig(
            update_smf: true,
            max_depth: 2,
            enabled: true,
            verbose: false
        ))
        jit.depth = 2

        val result = jit.try_jit_instantiate("too_deep")
        match result:
            case JitInstantiationResult.CompilationError(message):
                expect(message).to_contain("Maximum JIT depth")
            case _:
                fail("expected depth error")
