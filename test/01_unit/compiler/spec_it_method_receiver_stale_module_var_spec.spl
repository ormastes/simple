"""A method call on a module `var` inside an `it` body sees the value a helper just assigned.

The spec runner runs each `it` body in a copy of the caller env. Field reads
already preferred the live module value, but method-call receivers read the
stale copy and then wrote it back over the live value.
See doc/08_tracking/bug/spec_it_method_receiver_stale_module_var_2026-10-30.md."""

use std.spec.*

class Counter:
    n: i64
    fn get() -> i64:
        self.n
    me bump():
        self.n = self.n + 1

var g_counter = Counter(n: 0)
var g_items: [i64] = []

fn reset_counter(start: i64):
    g_counter = Counter(n: start)

fn reset_items():
    g_items = [7, 8]

describe "method receivers on a module var reassigned by a helper":
    it "reads the reassigned object through a fn method":
        # @req REQ-SSPEC-INTERP-GLOBALS
        reset_counter(2)
        expect(g_counter.get()).to_equal(2)
        expect(g_counter.n).to_equal(2)

    it "mutates the reassigned object through a me method in statement position":
        # @req REQ-SSPEC-INTERP-GLOBALS
        reset_counter(5)
        g_counter.bump()
        expect(g_counter.n).to_equal(6)
        expect(g_counter.get()).to_equal(6)

    it "uses the reassigned array as a method receiver":
        # @req REQ-SSPEC-INTERP-GLOBALS
        reset_items()
        expect(g_items.len()).to_equal(2)
        expect(g_items.contains(8)).to_equal(true)
