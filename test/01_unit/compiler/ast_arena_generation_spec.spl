# @cover src/compiler/10.frontend/core/_AstExpr/nodes.spl 5%
# @cover src/compiler/10.frontend/core/_Ast/module_state.spl 5%
# @req: REQ-COMP-AST-ARENA-GENERATION-DIAGNOSTICS-L6-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove that AST arena generation diagnostics (L6).
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""

"""
# AST arena generation diagnostics (lane L6, stage4 memory plan 2026-07-29)

**Category:** Compiler / Frontend / AST arena

## Overview

Stage-4 failures manifested as thousands of secondary out-of-bounds /
missing-tag diagnostics after an `ast_reset()` cleared the parallel-array
arenas while stale i64 indices survived. Lane L6 adds a module-global
generation counter next to the arenas plus debug-gated stale-index
diagnostics — diagnosis only, no representation change.

This spec exercises:
- `ast_reset()` bumps the arena generation by exactly one per call
- `ast_gen_stale_message` produces the precise
  "stale <Kind> <idx>: produced at generation N, arena now at M" text
- `ast_gen_check_index` is inert (false) when the knob is off, detects a
  stale generation when `SIMPLE_AST_GEN_CHECK=1`, and accepts fresh indices
- the `expr_get_tag`/`stmt_get_tag` OOB fallback still returns the -1
  sentinel for stale indices (now with generation-enriched output)
"""

use std.spec.*
use compiler.core.ast.{ast_reset}
use compiler.core.ast_expr.{expr_alloc, expr_get_tag, ast_generation, ast_generation_bump, ast_gen_stale_message, ast_gen_check_index}
use compiler.core.ast_stmt.{stmt_alloc, stmt_get_tag}
use compiler.core.types.{int_to_str}

extern fn rt_env_set(key: text, value_str: text) -> bool

describe "AST arena generation diagnostics (L6)":
    it "ast_reset bumps the arena generation by one per call":
        step("Verify: ast_reset bumps the arena generation by one per call")
        # @req: REQ-COMP-AST-ARENA-GENERATION-DIAGNOSTICS-L6-001
        ast_reset()
        val g0 = ast_generation()
        ast_reset()
        val g1 = ast_generation()
        ast_reset()
        val g2 = ast_generation()
        expect(g1).to_equal(g0 + 1)
        expect(g2).to_equal(g0 + 2)

    it "stale message names the minted and current generations":
        step("Verify: stale message names the minted and current generations")
        ast_reset()
        val cur = ast_generation()
        val minted = cur - 1
        val msg = ast_gen_stale_message("StmtId", 48, minted)
        val expected = "stale StmtId 48: produced at generation " + int_to_str(minted) + ", arena now at " + int_to_str(cur)
        expect(msg).to_equal(expected)

    it "ast_gen_check_index is inert when the knob is off":
        step("Verify: ast_gen_check_index is inert when the knob is off")
        assert_true(rt_env_set("SIMPLE_AST_GEN_CHECK", "0"))
        assert_true(rt_env_set("SIMPLE_BOOTSTRAP_STAGE4", "0"))
        ast_reset()
        val stale_gen = ast_generation() - 1
        assert_false(ast_gen_check_index("StmtId", 7, stale_gen))

    it "ast_gen_check_index flags a stale generation when enabled, accepts fresh":
        step("Verify: ast_gen_check_index flags a stale generation when enabled, accepts fresh")
        assert_true(rt_env_set("SIMPLE_AST_GEN_CHECK", "1"))
        ast_reset()
        val cur = ast_generation()
        # Fresh index: minted at the live generation -> not stale.
        assert_false(ast_gen_check_index("ExprId", 3, cur))
        # Stale index: minted before the last reset -> flagged (reported once).
        assert_true(ast_gen_check_index("ExprId", 3, cur - 1))
        # Second stale read in the same generation still returns true
        # (report itself is deduplicated per generation, not the result).
        assert_true(ast_gen_check_index("StmtId", 9, cur - 1))
        assert_true(rt_env_set("SIMPLE_AST_GEN_CHECK", "0"))

    it "stale expr/stmt indices past a reset still fall back to the -1 sentinel":
        step("Verify: stale expr/stmt indices past a reset still fall back to the -1 sentinel")
        ast_reset()
        val eid = expr_alloc(1, -1)
        val sid = stmt_alloc(1, -1)
        # Simulate the stage-4 failure shape: reset clears the arenas while the
        # raw i64 indices survive; the tag reads must degrade to -1, not crash.
        ast_reset()
        expect(expr_get_tag(eid)).to_equal(-1)
        expect(stmt_get_tag(sid)).to_equal(-1)
