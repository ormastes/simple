"""Target-pinned SMF symbols must round-trip through the production reader."""
# @req: REQ-COMPILER-LINKER-001

use compiler.backend.linker.smf_writer.{SmfWriter, SmfWriterSymbol,
    SmfWriterSymbolBinding, SmfWriterSymbolType, DataSectionKind}
use compiler.backend.linker.smf_enums.{Platform, Arch}
use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory}

fn group_test_symbol(name: text, section: i64, size: i64,
        ty: SmfWriterSymbolType) -> SmfWriterSymbol:
    SmfWriterSymbol(name: name, binding: SmfWriterSymbolBinding.Global,
        sym_type: ty, section_index: section, value: 0, size: size,
        layout_phase: 2, is_event_loop_anchor: false, layout_pinned: false)

describe "target-pinned SMF writer section identities":
    it "writes Windows target bytes and reads a data symbol from its own section":
        var writer = SmfWriter.create_target(Platform.Windows, Arch.X86_64)
        writer.add_code_section(".text", [195])
        writer.add_data_section(".data", [42, 43], DataSectionKind.Mutable)
        writer.add_symbol(group_test_symbol("entry", 0, 1,
            SmfWriterSymbolType.Function))
        writer.add_symbol(group_test_symbol("payload", 1, 2,
            SmfWriterSymbolType.Object))
        val written = writer.write()
        expect(written.is_ok()).to_equal(true)
        val bytes = written.unwrap()
        val header_at = bytes.len() - 128
        expect(bytes[header_at + 6]).to_equal(2)
        val reader_result = SmfReaderMemory.from_data(bytes)
        expect(reader_result.is_ok()).to_equal(true)
        var reader = reader_result.unwrap()
        val entry = reader.lookup_symbol("entry")
        val payload = reader.lookup_symbol("payload")
        expect(entry.is_ok()).to_equal(true)
        expect(payload.is_ok()).to_equal(true)
        expect(entry.unwrap().section_index).to_equal(0)
        expect(payload.unwrap().section_index).to_equal(1)
        val data = reader.read_code(payload.unwrap())
        expect(data.is_ok()).to_equal(true)
        expect(data.unwrap()).to_equal([42u8, 43u8])

    it "rejects an explicit symbol section outside the emitted sections":
        var writer = SmfWriter.create_target(Platform.Linux, Arch.X86_64)
        writer.add_code_section(".text", [195])
        writer.add_symbol(group_test_symbol("bad", 1, 1,
            SmfWriterSymbolType.Function))
        expect(writer.write().is_err()).to_equal(true)

    it "keeps an undefined import in table order without exporting executable code":
        var writer = SmfWriter.create_target(Platform.Linux, Arch.X86_64)
        writer.add_code_section(".text", [195])
        writer.add_symbol(group_test_symbol("defined", 0, 1,
            SmfWriterSymbolType.Function))
        writer.add_symbol(group_test_symbol("external", -1, 0,
            SmfWriterSymbolType.Function))
        var reader = SmfReaderMemory.from_data(writer.write().unwrap()).unwrap()
        val ordered = reader.symbols_in_table_order().unwrap()
        expect(ordered.len()).to_equal(2)
        expect(ordered[1].section_index).to_equal(-1)
        val exports = reader.exported_symbols()
        expect(exports.len()).to_equal(1)
        expect(exports[0].name).to_equal("defined")
