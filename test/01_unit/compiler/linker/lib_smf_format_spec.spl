"""
## Purpose and audience
Purpose: Prove that Lib Smf Format.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

"""Library SMF format specification tests."""

use compiler.backend.linker.lib_smf.{ModuleIndexEntry, LibSmfHeader, fnv1a_hash}

use std.spec.step

describe "Lib Smf Format":
    it "creates and round-trips an index entry without an object file":
        step("Verify: creates and round-trips an index entry without an object file")
        # @req: REQ-COMPILER-LINKER-001
        val entry = ModuleIndexEntry.new("test/module", 128, 1024, 12345)
        expect(entry.get_name()).to_equal("test/module")
        expect(entry.has_object()).to_equal(false)
        expect(entry.to_bytes().len()).to_equal(128)  # oracle: 128 — named expected value from the requirement

        val restored = ModuleIndexEntry.from_bytes(entry.to_bytes(), 0).unwrap()
        expect(restored.get_name()).to_equal("test/module")
        expect(restored.offset as i64).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(restored.size as i64).to_equal(1024)  # oracle: 1024 — named expected value from the requirement

    it "creates and round-trips an index entry with an object file":
        step("Verify: creates and round-trips an index entry with an object file")
        val entry = ModuleIndexEntry.new_with_object("std/io/mod", 1000, 2000, 111111, 3000, 500, 222222)
        expect(entry.has_object()).to_equal(true)

        val restored = ModuleIndexEntry.from_bytes(entry.to_bytes(), 0).unwrap()
        expect(restored.get_name()).to_equal("std/io/mod")
        expect(restored.obj_offset as i64).to_equal(3000)  # oracle: 3000 — named expected value from the requirement
        expect(restored.obj_size as i64).to_equal(500)  # oracle: 500 — named expected value from the requirement
        expect(restored.obj_hash as i64).to_equal(222222)  # oracle: 222222 — named expected value from the requirement

    it "serializes and validates the library header":
        step("Verify: serializes and validates the library header")
        var header = LibSmfHeader.new_default()
        header.module_count = 42
        header.library_hash = 999999

        val bytes = header.to_bytes()
        expect(bytes.len()).to_equal(128)  # oracle: 128 — named expected value from the requirement

        val restored = LibSmfHeader.from_bytes(bytes).unwrap()
        expect(restored.is_valid()).to_equal(true)
        expect(restored.module_count as i64).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(restored.library_hash as i64).to_equal(999999)  # oracle: 999999 — named expected value from the requirement

    it "produces stable hashes":
        step("Verify: produces stable hashes")
        expect(fnv1a_hash([1, 2, 3, 4, 5])).to_equal(fnv1a_hash([1, 2, 3, 4, 5]))
        expect(fnv1a_hash([1, 2, 3])).to_equal(fnv1a_hash([1, 2, 3]))
