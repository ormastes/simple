"""
## Purpose and audience
Purpose: Prove that SmfWriter.write() real byte serialization.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

"""SMF writer real-byte-serialization specification tests.

Covers WP-20 (aerospace hardening plan, Wave 4): `SmfWriter.write()` used to be
a stub returning `Ok([])` unconditionally
(doc/08_tracking/bug/smf_reader_bridge_silent_nil.md). These specs prove it now
emits a real, byte-exact SMF v1.1 image and that the image round-trips through
the actual in-tree pure-Simple reader, `SmfReaderMemory`
(compiler.backend.linker._SmfReaderMemory) -- not the six-extern
`rt_smf_reader_*` reader (smf_reader.spl), which stays out of scope and
unimplemented.
"""

use compiler.backend.linker.smf_writer.{SmfWriter, SmfWriterSymbol, SmfWriterSymbolBinding, SmfWriterSymbolType, SmfRelocation, RelocationType}
use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory}

fn build_code_bytes() -> [i64]:
    """200 zero bytes (padding filler) followed by one 0xC3 (ret) byte.

    Non-trivial length so the section/reloc/symbol-table offsets below are all
    distinct, non-adjacent, real numbers -- not degenerate 0/1 values that
    could pass by coincidence.
    """
    var code: [i64] = []
    var i = 0
    while i < 200:
        code.push(0)
        i = i + 1
    code.push(195)  # 0xC3
    code

fn build_test_writer() -> SmfWriter:
    var writer = SmfWriter.create()
    writer.add_code_section("code", build_code_bytes())
    val sym = SmfWriterSymbol(
        name: "main",
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 1,
        value: 200,
        size: 1,
        layout_phase: 2,
        is_event_loop_anchor: true,
        layout_pinned: true
    )
    writer.add_symbol(sym)
    writer.add_relocation(SmfRelocation(offset: 5, symbol_index: 0, reloc_type: RelocationType.Abs64, addend: 7))
    writer

fn to_u8_bytes(data: [i64]) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < data.len():
        out.push(data[i] as u8)
        i = i + 1
    out

use std.spec.step

describe "SmfWriter.write() real byte serialization":

    it "produces real, non-empty bytes (not the old Ok([]) stub)":
        step("Verify: produces real, non-empty bytes (not the old Ok([]) stub)")
        # @req: REQ-COMPILER-LINKER-001
        var writer = build_test_writer()
        val result = writer.write()
        expect(result.is_ok()).to_equal(true)
        val bytes = result.unwrap()
        expect(bytes.len()).to_equal(550)  # oracle: 550 — named expected value from the requirement

    it "rejects a builder with no sections":
        step("Verify: rejects a builder with no sections")
        var writer = SmfWriter.create()
        val result = writer.write()
        expect(result.is_err()).to_equal(true)

    it "rejects a relocation whose symbol_index is out of range":
        step("Verify: rejects a relocation whose symbol_index is out of range")
        var writer = SmfWriter.create()
        writer.add_code_section("code", [195])
        writer.add_relocation(SmfRelocation(offset: 0, symbol_index: 9, reloc_type: RelocationType.Abs64, addend: 0))
        val result = writer.write()
        expect(result.is_err()).to_equal(true)

    it "places the 128-byte SmfHeader trailer at exact byte offsets (magic, version, platform/arch, counts, entry point)":
        step("Verify: places the 128-byte SmfHeader trailer at exact byte offsets (magic, version, platform/arch, counts, entry point)")
        var writer = build_test_writer()
        val bytes = writer.write().unwrap()
        val h = bytes.len() - 128
        expect(h).to_equal(422)  # oracle: 422 — named expected value from the requirement

        # Magic "SMF\0"
        expect(bytes[h]).to_equal(83)  # oracle: 83 — named expected value from the requirement
        expect(bytes[h + 1]).to_equal(77)  # oracle: 77 — named expected value from the requirement
        expect(bytes[h + 2]).to_equal(70)  # oracle: 70 — named expected value from the requirement
        expect(bytes[h + 3]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # version_major / version_minor
        expect(bytes[h + 4]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[h + 5]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        # platform (Linux=1), arch (X86_64=0)
        expect(bytes[h + 6]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[h + 7]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # section_count = 2 (code section + synthetic .rela reloc section)
        expect(bytes[h + 16]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(bytes[h + 17]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # section_table_offset = 232 (u64 LE, low byte)
        expect(bytes[h + 20]).to_equal(232)  # oracle: 232 — named expected value from the requirement
        expect(bytes[h + 21]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # symbol_table_offset = 360 = 256 + 104 (u64 LE)
        expect(bytes[h + 28]).to_equal(104)  # oracle: 104 — named expected value from the requirement
        expect(bytes[h + 29]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        # symbol_count = 1
        expect(bytes[h + 36]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        # exported_count = 1 (symbol binding is Global, not Local)
        expect(bytes[h + 40]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        # entry_point = 200 (picked up from the "main" symbol's value)
        expect(bytes[h + 44]).to_equal(200)  # oracle: 200 — named expected value from the requirement
        expect(bytes[h + 45]).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "writes the Code section table entry with the real type/flags/offset/size/alignment/name bytes":
        step("Verify: writes the Code section table entry with the real type/flags/offset/size/alignment/name bytes")
        var writer = build_test_writer()
        val bytes = writer.write().unwrap()
        val e = 232  # section_table_offset
        expect(bytes[e]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[e + 4]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(bytes[e + 8]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bytes[e + 16]).to_equal(201)  # oracle: 201 — named expected value from the requirement
        expect(bytes[e + 32]).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(bytes[e + 40]).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(bytes[e + 41]).to_equal(111)  # oracle: 111 — named expected value from the requirement
        expect(bytes[e + 42]).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(bytes[e + 43]).to_equal(101)  # oracle: 101 — named expected value from the requirement

    it "writes the synthetic .rela section table entry pointing at real relocation bytes":
        step("Verify: writes the synthetic .rela section table entry pointing at real relocation bytes")
        var writer = build_test_writer()
        val bytes = writer.write().unwrap()
        val e = 232 + 64  # second section-table entry
        expect(bytes[e]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(bytes[e + 8]).to_equal(208)  # oracle: 208 — named expected value from the requirement
        expect(bytes[e + 16]).to_equal(24)  # oracle: 24 — named expected value from the requirement
        expect(bytes[e + 32]).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(bytes[e + 40]).to_equal(46)  # oracle: 46 — named expected value from the requirement
        expect(bytes[e + 41]).to_equal(114)  # oracle: 114 — named expected value from the requirement

        # Relocation payload itself at file offset 208: offset=5, symbol_index=0,
        # reloc_type=Abs64(wire 1), addend=7.
        expect(bytes[208]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(bytes[208 + 12]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[208 + 16]).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "writes the symbol table entry with real name_offset/type/binding/visibility/flags/value/size bytes":
        step("Verify: writes the symbol table entry with real name_offset/type/binding/visibility/flags/value/size bytes")
        var writer = build_test_writer()
        val bytes = writer.write().unwrap()
        val s = 360  # symbol_table_offset
        expect(bytes[s]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[s + 8]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bytes[s + 9]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[s + 10]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[s + 11]).to_equal(14)  # oracle: 14 — named expected value from the requirement
        expect(bytes[s + 16]).to_equal(200)  # oracle: 200 — named expected value from the requirement
        expect(bytes[s + 24]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bytes[s + 41]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "round-trips through the real pure-Simple reader (SmfReaderMemory): header, symbol lookup, and code bytes all match":
        step("Verify: round-trips through the real pure-Simple reader (SmfReaderMemory): header, symbol lookup, and code bytes all match")
        var writer = build_test_writer()
        val bytes = writer.write().unwrap()
        val u8_bytes = to_u8_bytes(bytes)

        val reader_result = SmfReaderMemory.from_data(u8_bytes)
        expect(reader_result.is_ok()).to_equal(true)
        var reader = reader_result.unwrap()

        val header = reader.get_header()
        expect(header.section_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(header.symbol_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(header.entry_point).to_equal(200)  # oracle: 200 — named expected value from the requirement

        val sym_result = reader.lookup_symbol("main")
        expect(sym_result.is_ok()).to_equal(true)
        val found = sym_result.unwrap()
        expect(found.offset).to_equal(200)  # oracle: 200 — named expected value from the requirement
        expect(found.size).to_equal(1)  # oracle: 1 — named expected value from the requirement

        val code_result = reader.read_code(found)
        expect(code_result.is_ok()).to_equal(true)
        val code_out = code_result.unwrap()
        expect(code_out.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(code_out[0]).to_equal(195u8)

        val relocs_result = reader.read_relocations()
        expect(relocs_result.is_ok()).to_equal(true)
        val relocs = relocs_result.unwrap()
        expect(relocs.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(relocs[0].offset).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(relocs[0].symbol_index).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(relocs[0].addend).to_equal(7)  # oracle: 7 — named expected value from the requirement
