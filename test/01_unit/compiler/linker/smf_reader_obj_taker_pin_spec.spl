# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/compiler/linker/linker_loader_inventory_2026-09-18.md ; plan: doc/03_plan/compiler/linker/mold_mdsocpp_linker_plan_2026-09-18.md ; architecture: doc/04_architecture/README.md ; design: doc/05_design/compiler/linker/mold_mdsocpp_linker_design.md

"""Pin spec for the A12 (SMF read dedup) lane.

Pins today's behaviour of `objtaker_take_object` (obj_taker.spl) and the
public `smf_reader.spl` (`SmfReaderImpl`/`SmfReaderFfi`) API surface that
other callers in this tree actually use (`object_resolver.spl`,
`object_provider.spl`, `link.spl`, `lazy_instantiator.spl`,
`smf_getter.spl`, `99.loader/loader/module_loader.spl`) -- BEFORE
`smf_reader.spl` is swapped to a thin file->`SmfReaderMemory` shim
(doc/05_design/compiler/linker/mold_mdsocpp_linker_design.md §2, SMF read
row). Every assertion here must still pass, unchanged, after the swap.

The fixture is a real SMF built by the existing writer
(`compiler.driver.smf_writer.build_smf_with_code_for_target`), not
hand-rolled bytes -- the same helper `object_provider_spec.spl` uses to
build fixtures for this same directory.

UPDATED 2026-09-19 after Fable review of the first version of this lane:
- `ty` used to be pinned as `SymbolType.Unknown` (a preserved bug in the
  pre-swap file's own decoder). That bug's ROOT CAUSE
  (`_SmfReaderMemory/symbol_parser.spl`'s `parse_sym_type`/
  `derive_section_index`, a raw-`u8`-`match` defect) is now fixed at the one
  real owner, so `ty` decodes correctly through this shim too. This spec now
  pins the CORRECT value and adds hand-built-fixture cases for non-Function
  symbol types the real writer never emits (it hardcodes sym_type=0).
- Added a corrupted-symbol-table case: `open()` must return `Err`, not an
  `Ok` reader with a silently-empty `symbols` dict (that dict is read
  directly by `link.spl`'s `find_unresolved()`).
"""

use compiler.backend.linker.smf_reader.{SmfReaderImpl}
use compiler.backend.linker.obj_taker.{
    ObjTaker, ObjTakeResult, SmfSymbol, SymbolType, SymbolBinding,
    objtaker_with_defaults, objtaker_take_object
}
use compiler.driver.smf_writer.{build_smf_with_code_for_target, Target}
use std.io_runtime.{file_write_bytes}

fn fixture_code() -> [u8]:
    # mov eax, 42 ; ret -- arbitrary but deterministic, distinguishable bytes.
    [0xB8, 0x2A, 0x00, 0x00, 0x00, 0xC3]

fn write_fixture() -> text:
    val path = "/tmp/smf_reader_obj_taker_pin_fixture.smf"
    val data = build_smf_with_code_for_target(fixture_code(), Target.x86_64_unknown_linux_gnu())
    expect(file_write_bytes(path, data)).to_equal(true)
    path

# ============================================================================
# Hand-built fixtures for symbol-type decode correctness and corruption.
# Same byte-building style as smf_reader_bridge_parity_class_spec.spl /
# smf_reader_ffi_bridge_silent_empty_spec.spl (legacy offset-0 header).
# ============================================================================

fn push_u32_le(out: [u8], v: i64) -> [u8]:
    var o = out
    o.push((v % 256) as u8)
    o.push(((v / 256) % 256) as u8)
    o.push(((v / 65536) % 256) as u8)
    o.push(((v / 16777216) % 256) as u8)
    o

fn push_u64_le(out: [u8], v: i64) -> [u8]:
    var o = push_u32_le(out, v)
    o = push_u32_le(o, 0)
    o

fn pad_to(out: [u8], n: i64) -> [u8]:
    var o = out
    while o.len() < n:
        o.push(0)
    o

# Canonical 128-byte SMF v1.1 header, stored at file offset 0.
fn build_header(section_count: i64, symbol_table_offset: i64, symbol_count: i64) -> [u8]:
    var h: [u8] = []
    h.push(83)
    h.push(77)
    h.push(70)
    h.push(0)
    h.push(1)
    h.push(1)
    h.push(1)
    h.push(0)
    h = push_u32_le(h, 0)
    h.push(0)
    h = pad_to(h, 16)
    h = push_u32_le(h, section_count)
    h = push_u64_le(h, 0)
    h = push_u64_le(h, symbol_table_offset)
    h = push_u32_le(h, symbol_count)
    h = push_u32_le(h, symbol_count)
    h = push_u64_le(h, 0)
    h = push_u32_le(h, 0)
    h = push_u32_le(h, 0)
    pad_to(h, 128)

# 56-byte symbol entry with an explicit, controllable sym_type byte -- the
# real writer (80.driver/smf_writer.spl:503) hardcodes sym_type=0, so this is
# the only way to exercise Data/Type/etc. decoding.
fn build_symbol_typed(name_offset: i64, sym_type: u8, value: i64, size: i64) -> [u8]:
    var s: [u8] = []
    s = push_u32_le(s, name_offset)
    s = push_u32_le(s, 0)
    s.push(sym_type)
    s.push(1)   # binding: Global
    s.push(0)
    s.push(0)
    s = pad_to(s, 16)
    s = push_u64_le(s, value)
    s = push_u64_le(s, size)
    s = push_u32_le(s, 0)
    s = push_u32_le(s, 0)
    s.push(0)
    s = pad_to(s, 48)
    s = push_u64_le(s, 0)
    pad_to(s, 56)

fn append_all(dst: [u8], src: [u8]) -> [u8]:
    var out = dst
    var i = 0
    while i < src.len():
        out.push(src[i])
        i = i + 1
    out

# header(0..128) | one symbol entry(128..184) | string table "\0<name>\0"
fn fixture_with_typed_symbol(name: text, name_bytes: [u8], sym_type: u8) -> [u8]:
    var data = build_header(0, 128, 1)
    data = append_all(data, build_symbol_typed(1, sym_type, 0, 20))
    data.push(0)
    data = append_all(data, name_bytes)
    data.push(0)
    data

fn write_typed_fixture(tag: text, name: text, name_bytes: [u8], sym_type: u8) -> text:
    val path = "/tmp/smf_reader_obj_taker_pin_typed_" + tag + ".smf"
    expect(file_write_bytes(path, fixture_with_typed_symbol(name, name_bytes, sym_type))).to_equal(true)
    path

# Header claims 3 symbol entries but the file only has bytes for one --
# the ordered-decode path must reject this, not silently return a partial
# or empty symbol set.
fn write_corrupted_fixture() -> text:
    val path = "/tmp/smf_reader_obj_taker_pin_corrupted.smf"
    var data = build_header(0, 128, 3)
    data = append_all(data, build_symbol_typed(1, 0, 0, 20))
    data.push(0)
    data = append_all(data, [104, 105])  # "hi" -- table ends here, entries 2/3 missing
    data.push(0)
    expect(file_write_bytes(path, data)).to_equal(true)
    path

describe "A12 pin: smf_reader.spl public API, today":
    # @manual scenario evidence
    it "opens a writer-built SMF and reports a header consistent with one exported symbol":
        # @req REQ-SSPEC-COMPILER
        step("opens a writer-built SMF and reports a header consistent with one exported symbol")
        val path = write_fixture()
        val reader_result = SmfReaderImpl.open(path)
        expect(reader_result.is_ok()).to_equal(true)
        val reader = reader_result.unwrap()
        expect(reader.path()).to_equal(path)
        expect(reader.header.symbol_count).to_equal(1)

    it "exposes exactly one exported symbol named main with the fixture's code size":
        # @req REQ-SSPEC-COMPILER
        step("exposes exactly one exported symbol named main with the fixture's code size")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val exported = reader.exported_symbols()
        expect(exported.len()).to_equal(1)
        expect(exported[0].name).to_equal("main")
        expect(exported[0].size).to_equal(fixture_code().len() as i64)
        expect(exported[0].binding).to_equal(SymbolBinding.Global)
        # The fixture's "main" symbol is written as sym_type=0/Function
        # (80.driver/smf_writer.spl:503 hardcodes it), and parse_sym_type
        # correctly decodes byte 0 as Function -- see the "decode
        # correctness" describe block below for bytes the real writer never
        # emits (1/Data, 2/Type), which is where the fixed decoder actually
        # had something to prove.
        expect(exported[0].ty).to_equal(SymbolType.Function)
        expect(exported[0].is_generic_template).to_equal(false)

    it "looks up the main symbol by name":
        # @req REQ-SSPEC-COMPILER
        step("looks up the main symbol by name")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val found = reader.lookup_symbol("main")
        expect(found.is_ok()).to_equal(true)
        expect(found.unwrap().offset).to_equal(0)
        expect(reader.lookup_symbol("does_not_exist").is_err()).to_equal(true)

    it "reads back the exact code bytes for the main symbol":
        # @req REQ-SSPEC-COMPILER
        step("reads back the exact code bytes for the main symbol")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val symbol = reader.lookup_symbol("main").unwrap()
        val code_result = reader.read_code(symbol)
        expect(code_result.is_ok()).to_equal(true)
        expect(code_result.unwrap()).to_equal(fixture_code())

    it "reports no template symbols and empty note.sdn dependencies for a plain module":
        # @req REQ-SSPEC-COMPILER
        step("reports no template symbols and empty note.sdn dependencies for a plain module")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val templates_result = reader.template_symbols()
        expect(templates_result.is_ok()).to_equal(true)
        expect(templates_result.unwrap().len()).to_equal(0)
        val meta = reader.read_note_sdn()
        expect(meta.dependencies.len()).to_equal(0)

describe "A12 pin: symbol-type decode correctness (Fable review 2026-09-19)":
    # @manual scenario evidence
    it "decodes a Data-typed symbol as Data, not the pre-fix default of Function":
        # @req REQ-SSPEC-COMPILER
        step("decodes a Data-typed symbol as Data, not the pre-fix default of Function")
        val path = write_typed_fixture("data", "gvar", [103, 118, 97, 114], 1)
        val reader = SmfReaderImpl.open(path).unwrap()
        val sym = reader.lookup_symbol("gvar").unwrap()
        expect(sym.ty).to_equal(SymbolType.Data)
        expect(sym.section_index).to_equal(1)

    it "decodes a Type-typed symbol as Type, not the pre-fix default of Function":
        # @req REQ-SSPEC-COMPILER
        step("decodes a Type-typed symbol as Type, not the pre-fix default of Function")
        val path = write_typed_fixture("type", "MyType", [77, 121, 84, 121, 112, 101], 2)
        val reader = SmfReaderImpl.open(path).unwrap()
        val sym = reader.lookup_symbol("MyType").unwrap()
        expect(sym.ty).to_equal(SymbolType.Type)

    it "rejects a corrupted symbol table with Err instead of an Ok reader with an empty symbols dict":
        # @req REQ-SSPEC-COMPILER
        step("rejects a corrupted symbol table with Err instead of an Ok reader with an empty symbols dict")
        val path = write_corrupted_fixture()
        val result = SmfReaderImpl.open(path)
        expect(result.is_err()).to_equal(true)

describe "A12 pin: objtaker_take_object over SmfReaderImpl, today":
    # @manual scenario evidence
    it "extracts the concrete code for an existing symbol as ObjTakeResult.Code":
        # @req REQ-SSPEC-COMPILER
        step("extracts the concrete code for an existing symbol as ObjTakeResult.Code")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        var obj_taker = objtaker_with_defaults()
        val result = objtaker_take_object(obj_taker, reader, "main")
        match result:
            case Code(bytes, symbol, ty):
                expect(bytes).to_equal(fixture_code())
                expect(symbol.name).to_equal("main")
                expect(ty).to_equal(nil)
            case _:
                expect("expected Code").to_equal("got something else")

    it "reports NotFound for a symbol absent from the module":
        # @req REQ-SSPEC-COMPILER
        step("reports NotFound for a symbol absent from the module")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        var obj_taker = objtaker_with_defaults()
        val result = objtaker_take_object(obj_taker, reader, "no_such_symbol")
        match result:
            case NotFound(name):
                expect(name).to_equal("no_such_symbol")
            case _:
                expect("expected NotFound").to_equal("got something else")

    it "serves the second take of the same symbol from the instance cache with identical bytes":
        # @req REQ-SSPEC-COMPILER
        step("serves the second take of the same symbol from the instance cache with identical bytes")
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        var obj_taker = objtaker_with_defaults()
        val first = objtaker_take_object(obj_taker, reader, "main")
        val second = objtaker_take_object(obj_taker, reader, "main")
        match first:
            case Code(bytes1, _, _):
                match second:
                    case Code(bytes2, _, _):
                        expect(bytes2).to_equal(bytes1)
                    case _:
                        expect("expected Code").to_equal("got something else")
            case _:
                expect("expected Code").to_equal("got something else")
