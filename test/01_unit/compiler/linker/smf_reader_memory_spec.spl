"""
## Purpose and audience
Purpose: Prove that Smf Reader Memory.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

"""SMF reader memory specification tests."""

use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory}

fn append_minimal_header(data: [u8], section_offset: i32, symbol_offset: i32) -> [u8]:
    var out = data

    out.push(83)
    out.push(77)
    out.push(70)
    out.push(0)
    out.push(1)
    out.push(1)
    out.push(1)
    out.push(0)

    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    out.push(section_offset.to_u8())
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    out.push(symbol_offset.to_u8())
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)

    var i = 0
    while i < 8:
        out.push(0)
        i = i + 1

    while out.len() < data.len() + 128:
        out.push(0)

    out

fn create_minimal_smf() -> [u8]:
    append_minimal_header([], 128, 128)

fn create_trailer_smf() -> [u8]:
    append_minimal_header([9, 8, 7, 6, 5], 5, 5)

use std.spec.step

describe "Smf Reader Memory":
    it "rejects data that is too small":
        step("Verify: rejects data that is too small")
        # @req: REQ-COMPILER-LINKER-001
        val result = SmfReaderMemory.from_data([1, 2, 3])
        expect(result.is_err()).to_equal(true)

    it "rejects invalid magic":
        step("Verify: rejects invalid magic")
        var data: [u8] = [66, 65, 68, 0]
        while data.len() < 128:
            data.push(0)

        val result = SmfReaderMemory.from_data(data)
        expect(result.is_err()).to_equal(true)

    it "accepts a minimal valid SMF and parses the header":
        step("Verify: accepts a minimal valid SMF and parses the header")
        val reader = SmfReaderMemory.from_data(create_minimal_smf()).unwrap()
        val header = reader.get_header()

        val ver = header.version
        expect(ver.0).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ver.1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(header.section_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(header.symbol_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(reader.data_size()).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(reader.exported_symbols().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "accepts v1.1 SMF with header trailer at EOF minus 128":
        step("Verify: accepts v1.1 SMF with header trailer at EOF minus 128")
        val reader = SmfReaderMemory.from_data(create_trailer_smf()).unwrap()
        val header = reader.get_header()

        val ver2 = header.version
        expect(ver2.0).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ver2.1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(header.header_offset).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(header.section_table_offset).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(header.symbol_table_offset).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(reader.data_size()).to_equal(133)  # oracle: 133 — named expected value from the requirement
