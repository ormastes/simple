use std.spec.{describe, it, expect}
use compiler.linker._LinkerWrapper.native_all_support.{native_all_gnu_support_args, native_all_msvc_support_libraries}

describe "Windows aggregate runtime SDK dependencies":
    it "links the Windows APIs imported by the aggregate runtime sysinfo objects":
        for archive in ["C:/runtime/simple_native_all.lib", "C:\\runtime\\simple_native_all.lib"]:
            val libraries = native_all_msvc_support_libraries([archive])
            for library in ["pdh.lib", "netapi32.lib", "psapi.lib", "powrprof.lib"]:
                expect(libraries).to_contain(library)

    it "uses GNU driver spelling for the same MinGW runtime dependencies":
        val arguments = native_all_gnu_support_args(["C:/runtime/libsimple_native_all.a"], "windows-mingw", "")
        for argument in ["-lpdh", "-lnetapi32", "-lpsapi", "-lpowrprof"]:
            expect(arguments).to_contain(argument)

    it "does not add aggregate SDK dependencies to a core-only link":
        expect(native_all_msvc_support_libraries(["runtime.obj"])).to_equal([])
        expect(native_all_gnu_support_args(["runtime.o"], "windows-mingw", "")).to_equal([])
