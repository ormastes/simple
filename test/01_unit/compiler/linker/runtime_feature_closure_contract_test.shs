#!/bin/sh
set -eu

closure=src/compiler/70.backend/linker/runtime_feature_closure.spl
linker=src/compiler/70.backend/backend/llvm_native_link_orchestrator.spl

grep -q 'runtime-feature-closure-undeclared-root:' "$closure"
grep -q 'runtime-feature-closure-unretained-declaration:' "$closure"
grep -q 'kind: RuntimeFeatureRootKindV1.DemandAction' "$linker"
grep -q 'kind: RuntimeFeatureRootKindV1.Provider' "$linker"
grep -q 'runtime_feature_closure_v1(' "$linker"
grep -q 'runtime_feature_closure_receipt_v1(runtime_feature_closure)' "$linker"
grep -q 'runtime_feature_closure=' "$linker"

echo RUNTIME_FEATURE_CLOSURE_STATIC_PASS
