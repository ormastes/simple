# @cover src/compiler/70.backend/backend/llvm_native_link.spl
use compiler.backend.backend.llvm_native_link.{llvm_configured_link_libraries}

describe "native link library environment contract":
    it "keeps common libraries in declared order and removes duplicates":
        val result = llvm_configured_link_libraries("ssl:crypto:stdc++:ssl")
        match result:
            case Ok(libraries): expect(libraries).to_equal(["ssl", "crypto", "stdc++"])
            case Err(_): expect(false).to_equal(true)

    it "rejects linker option and path injection":
        val option = llvm_configured_link_libraries("ssl:-Wl,--rpath=/tmp")
        val path = llvm_configured_link_libraries("../../evil")
        match option:
            case Err(message): expect(message).to_contain("invalid library name")
            case Ok(_): expect(false).to_equal(true)
        match path:
            case Err(message): expect(message).to_contain("invalid library name")
            case Ok(_): expect(false).to_equal(true)
