use std.spec.{describe, it, expect}
use compiler.linker._LinkerWrapper.native_all_support.{native_mingw_stack_reserve_args, NATIVE_MINGW_STACK_RESERVE_BYTES}

# F3 / W51 Windows builds died with 0xC00000FD: the PE default 1 MiB
# SizeOfStackReserve (and even 8 MiB on deep MIR lowering chains like
# lib/common/process/observation_v4.spl and test_runner_args.spl:251)
# overflowed only on Windows. Match MSVC (`MSVC_DEFAULT_STACK_RESERVE`) and
# internal COFF (`PeImagePolicy.default().stack_reserve`) at 64 MiB.
describe "Windows GNU clang link main-thread stack reserve":
    it "reserves 64 MiB main-thread stack matching MSVC and internal COFF parity":
        expect(NATIVE_MINGW_STACK_RESERVE_BYTES).to_equal(67108864)
        expect(native_mingw_stack_reserve_args([])).to_equal(["-Wl,--stack,67108864"])

    it "keeps an explicit caller stack reserve instead of adding a second one":
        expect(native_mingw_stack_reserve_args(["-Wl,--stack,33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["-Wl,--stack=33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["-Wl,--STACK,33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["-WL,--STACK=33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["-Wl,--gc-sections,--stack,33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["--stack,33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["--stack=33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["--STACK=33554432"])).to_equal([])
        expect(native_mingw_stack_reserve_args(["--stack", "33554432"])).to_equal([])

    it "ignores unrelated or near-miss extra flags":
        expect(native_mingw_stack_reserve_args(["-Wl,--gc-sections", "-municode"])).to_equal(["-Wl,--stack,67108864"])
        expect(native_mingw_stack_reserve_args(["-Wl,--stack-usage", "-Wl,-z,noexecstack"])).to_equal(["-Wl,--stack,67108864"])
