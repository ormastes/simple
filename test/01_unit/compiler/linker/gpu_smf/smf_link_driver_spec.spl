# ============================================================================
# smf_link_driver.spl spec (mold-MDSOC++ linker plan lane A6) — one CPU
# driver running SmfLinkProfile stages L2 -> L8 with one StageReceipt each.
#
# Claims:
#   1. LINK — two in-memory SMF modules (built with the real SmfWriter), one
#      cross-module Rel32 reference, link to an image with exactly 7
#      receipts keyed smf_link.L2 .. smf_link.L8 in order, and the Rel32
#      field patched to the hand-derived value.
#   2. UNRESOLVED — a module whose reference has no definition anywhere is a
#      typed UnresolvedSymbol error naming the symbol.
#   3. DUPLICATE — two strong (Global) definitions of one name are a typed
#      DuplicateStrongDefinition error naming the symbol.
#   5. BINDING — Local definitions are module-private; Global beats Weak.
#   4. PROFILE — SmfLinkProfile implements the frozen ResolveProfile v1
#      trait: group_key is the record key, resolve_group is GraphResolveCore's
#      reduce_group over the profile's own sorted arena.
#
# Hand derivation for claim 1 (base 0x1000, add_code_section alignment 16):
#   module 0 section 0 ("text", 8 bytes)  -> addr 0x1000
#   module 1 section 0 ("text", 4 bytes)  -> addr align_up(0x1008, 16) = 0x1010
#   Rel32 at module 0 offset 1, addend -4, target `helper` = 0x1010 + 0:
#     S + A - P = 0x1010 + (-4) - (0x1000 + 1) = 4112 - 4 - 4097 = 11 = 0x0B
#   patched module 0 bytes: E8 0B 00 00 00 90 90 C3; total_size 0x14 = 20.
# ============================================================================

use std.spec
use std.common.structural.identity.entity_id.{artifact_id, hash128, snapshot_id}
use std.common.structural.resolve.resolve_types.{resolve_key_equal}
use std.common.structural.resolve.resolve_core.{
    group_sorted,
    reduce_group,
    sort_definitions_stable,
    sort_references_stable
}
use compiler.backend.linker.smf_writer.{
    RelocationType,
    SmfRelocation,
    SmfWriter,
    SmfWriterSymbol,
    SmfWriterSymbolBinding,
    SmfWriterSymbolType
}
use compiler.backend.linker.gpu_smf.smf_link_profile.{
    SmfLinkInputs,
    smf_collect_records,
    smf_link_profile_new
}
use compiler.backend.linker.gpu_smf.smf_reader_adapter.{smf_symbol_inputs_from_writer_symbols}
use compiler.backend.linker.gpu_smf.smf_link_driver.{
    SmfLinkError,
    SmfLinkModule,
    smf_link_module_from_writer,
    smf_link_modules
}

# ----------------------------------------------------------------------------
# Fixtures — real SmfWriter builders
# ----------------------------------------------------------------------------

fn _sym(name: text, sym_type: SmfWriterSymbolType, section_index: i64, size: i64) -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: name,
        binding: SmfWriterSymbolBinding.Global,
        sym_type: sym_type,
        section_index: section_index,
        value: 0,
        size: size,
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false)

fn _caller_module() -> SmfLinkModule:
    """Module 0: `main` (8-byte code: call rel32 helper; nop; nop; ret) and an
    undefined reference to `helper` patched by one Rel32 at offset 1."""
    var w = SmfWriter.create()
    val _s = w.add_code_section("text", [0xE8, 0, 0, 0, 0, 0x90, 0x90, 0xC3])
    val _m = w.add_symbol(_sym("main", SmfWriterSymbolType.Function, 0, 8))
    val _h = w.add_symbol(_sym("helper", SmfWriterSymbolType.NoType, -1, 0))
    w.add_relocation(SmfRelocation(offset: 1, symbol_index: 1, reloc_type: RelocationType.Rel32, addend: -4))
    smf_link_module_from_writer(0, w)

fn _helper_module(module_index: u32) -> SmfLinkModule:
    """A module defining `helper` (4-byte code: xor eax,eax; ret; nop)."""
    var w = SmfWriter.create()
    val _s = w.add_code_section("text", [0x31, 0xC0, 0xC3, 0x90])
    val _h = w.add_symbol(_sym("helper", SmfWriterSymbolType.Function, 0, 4))
    smf_link_module_from_writer(module_index, w)

fn _error_text(e: SmfLinkError) -> text:
    match e:
        case UnresolvedSymbol(name): "unresolved:" + name
        case DuplicateStrongDefinition(name): "duplicate:" + name
        case EntryNotFound(name): "entry:" + name
        case ReachabilityRejected: "reach"
        case LayoutRejected: "layout"
        case RelocationRejected(detail): "reloc:" + detail

# ----------------------------------------------------------------------------
# 1. Link
# ----------------------------------------------------------------------------

describe "smf_link_modules two-module link":
    it "emits exactly 7 receipts L2..L8 in stage order":
        val run = smf_link_modules([_caller_module(), _helper_module(1)], "main", 0x1000)
        expect(run.receipts.len()).to_equal(7)
        var i = 0
        while i < 7:
            expect(run.receipts[i].stage.value).to_equal("smf_link.L" + (i + 2).to_text())
            i = i + 1

    it "patches the cross-module Rel32 to the hand-derived value":
        val run = smf_link_modules([_caller_module(), _helper_module(1)], "main", 0x1000)
        match run.result:
            case Ok(image):
                expect(image.total_size).to_equal(20)
                expect(image.entry_addr).to_equal(0x1000)
                expect(image.sections.len()).to_equal(2)
                expect(image.sections[0].addr).to_equal(0x1000)
                expect(image.sections[1].addr).to_equal(0x1010)
                val b = image.sections[0].bytes
                expect(b.len()).to_equal(8)
                expect(b[0] as i64).to_equal(0xE8)
                expect(b[1] as i64).to_equal(0x0B)
                expect(b[2] as i64).to_equal(0)
                expect(b[3] as i64).to_equal(0)
                expect(b[4] as i64).to_equal(0)
                expect(b[5] as i64).to_equal(0x90)
                expect(b[7] as i64).to_equal(0xC3)
            case Err(e):
                expect(_error_text(e)).to_equal("ok")

# ----------------------------------------------------------------------------
# 2. Unresolved
# ----------------------------------------------------------------------------

describe "smf_link_modules unresolved reference":
    it "returns a typed UnresolvedSymbol error naming the symbol":
        val run = smf_link_modules([_caller_module()], "main", 0x1000)
        match run.result:
            case Ok(_image):
                expect("linked").to_equal("unresolved:helper")
            case Err(e):
                expect(_error_text(e)).to_equal("unresolved:helper")

# ----------------------------------------------------------------------------
# 3. Duplicate strong definition
# ----------------------------------------------------------------------------

describe "smf_link_modules duplicate strong definition":
    it "returns a typed DuplicateStrongDefinition error naming the symbol":
        val run = smf_link_modules([_caller_module(), _helper_module(1), _helper_module(2)], "main", 0x1000)
        match run.result:
            case Ok(_image):
                expect("linked").to_equal("duplicate:helper")
            case Err(e):
                expect(_error_text(e)).to_equal("duplicate:helper")

# ----------------------------------------------------------------------------
# 4. ResolveProfile v1 implementation
# ----------------------------------------------------------------------------

describe "SmfLinkProfile implements ResolveProfile":
    it "group_key and resolve_group match GraphResolveCore over its sorted arena":
        val m = _caller_module()
        val (defs, refs) = smf_collect_records(SmfLinkInputs(
            module_index: 0,
            symbols: smf_symbol_inputs_from_writer_symbols(m.symbols)))
        val profile = smf_link_profile_new(defs)
        val input = profile.collect(snapshot_id(artifact_id(hash128(1, 2), 1), 0))
        expect(input.generation).to_equal(profile.generation)
        expect(resolve_key_equal(profile.group_key(refs[0]), refs[0].key)).to_be(true)
        val sorted_defs = sort_definitions_stable(defs)
        val views = group_sorted(sorted_defs, sort_references_stable(refs))
        val expected = reduce_group(views[0], sorted_defs)
        val got = profile.resolve_group(views[0])
        expect(got.status).to_equal(expected.status)
        expect(got.reason).to_equal(expected.reason)
        expect(got.diagnostic_count).to_equal(expected.diagnostic_count)

# ----------------------------------------------------------------------------
# 5. Binding precedence (Local is module-private; Global beats Weak)
# ----------------------------------------------------------------------------

fn _bsym(name: text, binding: SmfWriterSymbolBinding, section_index: i64, value: i64, size: i64) -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: name,
        binding: binding,
        sym_type: SmfWriterSymbolType.Function,
        section_index: section_index,
        value: value,
        size: size,
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false)

fn _rel32(offset: i64, symbol_index: i64) -> SmfRelocation:
    SmfRelocation(offset: offset, symbol_index: symbol_index, reloc_type: RelocationType.Rel32, addend: -4)

fn _local_a() -> SmfLinkModule:
    """Module A (0x1000, 16 bytes): Global `main`, LOCAL `f` at +15, refs to
    `f` (offset 1) and `g` (offset 6)."""
    var w = SmfWriter.create()
    val _s = w.add_code_section("text", [0xE8, 0, 0, 0, 0, 0xE8, 0, 0, 0, 0, 0x90, 0x90, 0x90, 0x90, 0x90, 0xC3])
    val _m = w.add_symbol(_bsym("main", SmfWriterSymbolBinding.Global, 0, 0, 16))
    val _f = w.add_symbol(_bsym("f", SmfWriterSymbolBinding.Local, 0, 15, 1))
    val _rf = w.add_symbol(_bsym("f", SmfWriterSymbolBinding.Global, -1, 0, 0))
    val _rg = w.add_symbol(_bsym("g", SmfWriterSymbolBinding.Global, -1, 0, 0))
    w.add_relocation(_rel32(1, 2))
    w.add_relocation(_rel32(6, 3))
    smf_link_module_from_writer(0, w)

fn _global_b() -> SmfLinkModule:
    """Module B (0x1010, 8 bytes): Global `g` at +0, GLOBAL `f` at +6, ref
    to `f` (offset 1)."""
    var w = SmfWriter.create()
    val _s = w.add_code_section("text", [0xE8, 0, 0, 0, 0, 0xC3, 0x90, 0x90])
    val _g = w.add_symbol(_bsym("g", SmfWriterSymbolBinding.Global, 0, 0, 8))
    val _f = w.add_symbol(_bsym("f", SmfWriterSymbolBinding.Global, 0, 6, 1))
    val _rf = w.add_symbol(_bsym("f", SmfWriterSymbolBinding.Global, -1, 0, 0))
    w.add_relocation(_rel32(1, 2))
    smf_link_module_from_writer(1, w)

fn _h_def(module_index: u32, binding: SmfWriterSymbolBinding) -> SmfLinkModule:
    var w = SmfWriter.create()
    val _s = w.add_code_section("text", [0x31, 0xC0, 0xC3, 0x90])
    val _h = w.add_symbol(_bsym("h", binding, 0, 0, 4))
    smf_link_module_from_writer(module_index, w)

fn _h_caller() -> SmfLinkModule:
    var w = SmfWriter.create()
    val _s = w.add_code_section("text", [0xE8, 0, 0, 0, 0, 0x90, 0x90, 0xC3])
    val _m = w.add_symbol(_bsym("main", SmfWriterSymbolBinding.Global, 0, 0, 8))
    val _rh = w.add_symbol(_bsym("h", SmfWriterSymbolBinding.Global, -1, 0, 0))
    w.add_relocation(_rel32(1, 1))
    smf_link_module_from_writer(0, w)

fn _byte(run_sections: [u8], i: i64) -> i64:
    run_sections[i] as i64

describe "smf_link_modules binding precedence":
    it "binds A's reference to A's Local f and B's reference to B's Global f":
        # A ref f: S = 0x1000+15, P = 0x1001 -> 0x100F - 4 - 0x1001 = 10
        #   (B's Global f would give 0x1016 - 4 - 0x1001 = 17).
        # A ref g: 0x1010 - 4 - 0x1006 = 6.
        # B ref f: S = 0x1010+6, P = 0x1011 -> 0x1016 - 4 - 0x1011 = 1
        #   (A's Local f would give 0x100F - 4 - 0x1011 = -6 = 0xFA).
        val run = smf_link_modules([_local_a(), _global_b()], "main", 0x1000)
        match run.result:
            case Ok(image):
                expect(image.sections.len()).to_equal(2)
                expect(image.sections[1].addr).to_equal(0x1010)
                expect(_byte(image.sections[0].bytes, 1)).to_equal(10)
                expect(_byte(image.sections[0].bytes, 6)).to_equal(6)
                expect(_byte(image.sections[1].bytes, 1)).to_equal(1)
                expect(_byte(image.sections[1].bytes, 2)).to_equal(0)
            case Err(e):
                expect(_error_text(e)).to_equal("ok")

    it "prefers a Global definition over an earlier Weak one":
        # Only the winner's section is reachable: Global h (module 2) is kept
        # at 0x1010 and Weak h (module 1) is dead-stripped. 0x1010 - 4 - 0x1001 = 11.
        # If Weak won, module 1 would be the one kept.
        val run = smf_link_modules([_h_caller(), _h_def(1, SmfWriterSymbolBinding.Weak), _h_def(2, SmfWriterSymbolBinding.Global)], "main", 0x1000)
        match run.result:
            case Ok(image):
                expect(image.sections.len()).to_equal(2)
                expect(image.sections[1].module_index as i64).to_equal(2)
                expect(image.sections[1].addr).to_equal(0x1010)
                expect(_byte(image.sections[0].bytes, 1)).to_equal(11)
            case Err(e):
                expect(_error_text(e)).to_equal("ok")

    it "does not let another module's Local definition satisfy a reference":
        val run = smf_link_modules([_h_caller(), _h_def(1, SmfWriterSymbolBinding.Local)], "main", 0x1000)
        match run.result:
            case Ok(_image):
                expect("linked").to_equal("unresolved:h")
            case Err(e):
                expect(_error_text(e)).to_equal("unresolved:h")
