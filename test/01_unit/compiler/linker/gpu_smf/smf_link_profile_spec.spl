# ============================================================================
# SmfLinkProfile CPU reference (LINK lane, Lane SMFPROFILE) —
# smf_link_profile.spl spec.
#
# Four claims:
#   1. RESOLUTION — a symbol list with defined `main`/`foo` and undefined
#      `bar` (plus references to `foo`/`main`) resolves each reference to
#      the right owner EntityRef, and the undefined-only reference stays
#      Unresolved/MissingDefinition.
#   2. UNDEFINED-ONLY — a module with a single undefined symbol and no
#      definitions anywhere yields Unresolved/MissingDefinition for its one
#      ResolutionRecord.
#   3. DUPLICATE DEFINITION — two definitions of the same name reduce to the
#      lowest-order winner with diagnostic_count 1 (GraphResolveCore's
#      reduce_group, exercised over smf_collect_records' own output — proof
#      the SMF collect step feeds the shared reduction correctly).
#   4. DETERMINISM — running smf_collect_records + smf_resolve twice on the
#      same input yields identical ResolutionRecord arrays, compared via
#      resolution_record_equal.
# ============================================================================

use std.spec
use std.common.structural.identity.entity_id.{entity_ref, entity_ref_equal}
use std.common.structural.resolve.resolve_types.{
    DefinitionRecord,
    ReferenceRecord,
    ResolutionRecord,
    resolution_record_equal
}
use std.common.structural.resolve.resolve_core.{
    group_sorted,
    reduce_group,
    sort_definitions_stable
}
use compiler.backend.linker.gpu_smf.smf_link_profile.{
    SmfLinkInputs,
    SmfSymbolInput,
    smf_collect_records,
    smf_resolve
}

# ----------------------------------------------------------------------------
# Fixtures
# ----------------------------------------------------------------------------

fn _main_foo_bar_inputs() -> SmfLinkInputs:
    """One module (index 7) with two definitions (`main`, `foo`), one
    undefined-only reference (`bar`), and references to both defined names.
    Symbol order (and therefore EntityRef.local_index and resolve order):
    0 main(def) 1 foo(def) 2 bar(ref) 3 foo(ref) 4 main(ref)."""
    SmfLinkInputs(
        module_index: 7,
        symbols: [
            SmfSymbolInput(name: "main", defined: true),
            SmfSymbolInput(name: "foo", defined: true),
            SmfSymbolInput(name: "bar", defined: false),
            SmfSymbolInput(name: "foo", defined: false),
            SmfSymbolInput(name: "main", defined: false)
        ])

fn _find_result(results: [ResolutionRecord], ref_local_index: u32) -> ResolutionRecord:
    """Locate the ResolutionRecord whose `reference.local_index` matches —
    `smf_resolve`'s output is grouped by key hash order, not input order, so
    tests must look results up by reference identity rather than position."""
    var i = 0
    val n = results.len()
    while i < n:
        if results[i].reference.local_index == ref_local_index:
            return results[i]
        i = i + 1
    results[0]

# ----------------------------------------------------------------------------
# 1. Resolution
# ----------------------------------------------------------------------------

describe "smf_link_profile resolution":
    it "resolves references to their defined symbol's owner EntityRef":
        val (defs, refs) = smf_collect_records(_main_foo_bar_inputs())
        val results = smf_resolve(defs, refs)
        expect(results.len()).to_equal(3)

        val foo_ref = _find_result(results, 3)
        expect(foo_ref.status).to_equal(1)
        expect(foo_ref.reason).to_equal(0)
        expect(entity_ref_equal(foo_ref.definition, entity_ref(7, 1))).to_be(true)

        val main_ref = _find_result(results, 4)
        expect(main_ref.status).to_equal(1)
        expect(main_ref.reason).to_equal(0)
        expect(entity_ref_equal(main_ref.definition, entity_ref(7, 0))).to_be(true)

    it "leaves an undefined-only reference Unresolved with reason MissingDefinition":
        val (defs, refs) = smf_collect_records(_main_foo_bar_inputs())
        val results = smf_resolve(defs, refs)
        val bar_ref = _find_result(results, 2)
        expect(bar_ref.status).to_equal(0)
        expect(bar_ref.reason).to_equal(1)

# ----------------------------------------------------------------------------
# 2. Undefined-only module
# ----------------------------------------------------------------------------

describe "smf_link_profile undefined-only module":
    it "yields exactly one Unresolved/MissingDefinition ResolutionRecord":
        val inputs = SmfLinkInputs(
            module_index: 1,
            symbols: [SmfSymbolInput(name: "baz", defined: false)])
        val (defs, refs) = smf_collect_records(inputs)
        expect(defs.len()).to_equal(0)
        expect(refs.len()).to_equal(1)
        val results = smf_resolve(defs, refs)
        expect(results.len()).to_equal(1)
        expect(results[0].status).to_equal(0)
        expect(results[0].reason).to_equal(1)

# ----------------------------------------------------------------------------
# 3. Duplicate definition
# ----------------------------------------------------------------------------

describe "smf_link_profile duplicate definition":
    it "reduces two definitions of one name to the lowest-order winner with diagnostic_count 1":
        val inputs = SmfLinkInputs(
            module_index: 2,
            symbols: [
                SmfSymbolInput(name: "dup", defined: true),
                SmfSymbolInput(name: "dup", defined: true)
            ])
        val (defs, refs) = smf_collect_records(inputs)
        expect(defs.len()).to_equal(2)
        val sorted = sort_definitions_stable(defs)
        val views = group_sorted(sorted, refs)
        expect(views.len()).to_equal(1)
        val group = reduce_group(views[0], sorted)
        expect(group.status).to_equal(1)
        expect(group.reason).to_equal(2)
        expect(group.diagnostic_count).to_equal(1)
        expect(entity_ref_equal(group.selected, entity_ref(2, 0))).to_be(true)

# ----------------------------------------------------------------------------
# 4. Determinism
# ----------------------------------------------------------------------------

describe "smf_link_profile determinism":
    it "produces identical ResolutionRecord arrays across two runs of the same input":
        val (defs_a, refs_a) = smf_collect_records(_main_foo_bar_inputs())
        val results_a = smf_resolve(defs_a, refs_a)

        val (defs_b, refs_b) = smf_collect_records(_main_foo_bar_inputs())
        val results_b = smf_resolve(defs_b, refs_b)

        expect(results_a.len()).to_equal(results_b.len())
        var i = 0
        val n = results_a.len()
        while i < n:
            expect(resolution_record_equal(results_a[i], results_b[i])).to_be(true)
            i = i + 1
