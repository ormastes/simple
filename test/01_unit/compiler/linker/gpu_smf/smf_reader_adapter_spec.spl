"""
## Purpose and audience
Purpose: Prove that SmfWriter.write() route-(b) blocker.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

# ============================================================================
# smf_reader_adapter.spl spec (Lane L1ADAPT) — writer-symbol -> SmfSymbolInput
# adapter, proven end-to-end through smf_collect_records + smf_resolve.
#
# Fixture route: (c) — writer-side `SmfWriterSymbol` values, not a read-back
# on-disk `.smf` file. Both blocked routes were checked before falling back:
#   (a) no `.smf` fixture exists anywhere under `test/`
#       (`find test -iname '*.smf'` returns nothing).
#   (b) `rt_smf_reader_open` (the only way `SmfReaderImpl.open` can populate
#       a real symbol table) has no implementation anywhere in the runtime
#       (grepped `src/compiler_rust/`, `src/runtime/`, every `.rs`/`.c`/
#       `.cpp` file — only its own `extern fn` declaration matches).
# Claim 1 below adds a THIRD, live piece of evidence: `SmfWriter.write()`
# itself is checked here, today, to still return `Ok([])` even with a
# populated section/symbol — so building a real `.smf` byte artifact isn't
# possible either. Full route writeup: smf_reader_adapter.spl's header.
#
# Claims:
#   1. WRITE STUB — SmfWriter.write() returns Ok([]) regardless of a
#      populated section/symbol, confirming route (b) is blocked live.
#   2. ADAPT — a defined writer symbol (size>0), an undefined one (size==0,
#      section_index==-1), and a zero-size-but-sectioned symbol (size==0,
#      section_index>=0) map to SmfSymbolInput.defined true/false/true —
#      proving the rule is the OR of the two signals, not their AND.
#   3. END-TO-END — the adapted list, fed through smf_collect_records +
#      smf_resolve, resolves a reference to the defined symbol to the right
#      owner EntityRef and leaves the undefined-only reference
#      Unresolved/MissingDefinition.
# ============================================================================

use std.spec
use compiler.backend.linker.smf_writer.{
    SmfWriter,
    SmfWriterSymbol,
    SmfWriterSymbolBinding,
    SmfWriterSymbolType
}
use compiler.backend.linker.gpu_smf.smf_link_profile.{
    SmfLinkInputs,
    smf_collect_records,
    smf_resolve
}
use compiler.backend.linker.gpu_smf.smf_reader_adapter.{
    smf_symbol_input_from_writer_symbol,
    smf_symbol_inputs_from_writer_symbols
}
use std.common.structural.identity.entity_id.{entity_ref, entity_ref_equal}
use std.common.structural.resolve.resolve_types.{ResolutionRecord}

# ----------------------------------------------------------------------------
# 1. Write stub — live proof route (b) is blocked
# ----------------------------------------------------------------------------

describe "SmfWriter.write() route-(b) blocker":
    it "still returns Ok([]) with a populated section and symbol, today":
        step("Verify: still returns Ok([]) with a populated section and symbol, today")
        # @req: REQ-COMPILER-LINKER-001
        var writer = SmfWriter.create()
        val _section = writer.add_code_section("text", [1, 2, 3])
        val _symbol = writer.add_symbol(SmfWriterSymbol(
            name: "main",
            binding: SmfWriterSymbolBinding.Global,
            sym_type: SmfWriterSymbolType.Function,
            section_index: 0,
            value: 0,
            size: 16,
            layout_phase: 0,
            is_event_loop_anchor: false,
            layout_pinned: false))
        val result = writer.write()
        match result:
            case Ok(bytes):
                expect(bytes.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            case Err(_e):
                assert_true(false)

# ----------------------------------------------------------------------------
# 2. Adapt — defined/undefined/zero-size-but-sectioned
# ----------------------------------------------------------------------------

fn _defined_symbol() -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: "main",
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 0,
        value: 0,
        size: 16,
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false)

fn _undefined_reference_symbol(name: text) -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: name,
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.NoType,
        section_index: -1,
        value: 0,
        size: 0,
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false)

fn _zero_size_sectioned_symbol() -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: "empty_at_section",
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 0,
        value: 0,
        size: 0,
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false)

describe "smf_reader_adapter defined derivation":
    it "marks size>0 as defined":
        step("Verify: marks size>0 as defined")
        val input = smf_symbol_input_from_writer_symbol(_defined_symbol())
        expect(input.name).to_equal("main")
        expect(input.defined).to_equal(true)

    it "marks size==0 and section_index==-1 as undefined":
        step("Verify: marks size==0 and section_index==-1 as undefined")
        val input = smf_symbol_input_from_writer_symbol(_undefined_reference_symbol("bar"))
        expect(input.defined).to_equal(false)

    it "carries section_index through unchanged (0 and the negative no-section sentinel)":
        step("Verify: carries section_index through unchanged (0 and the negative no-section sentinel)")
        val sectioned = smf_symbol_input_from_writer_symbol(_defined_symbol())
        expect(sectioned.section_index).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val unsectioned = smf_symbol_input_from_writer_symbol(_undefined_reference_symbol("bar"))
        expect(unsectioned.section_index).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "marks size==0 but section_index>=0 as defined (OR, not AND)":
        step("Verify: marks size==0 but section_index>=0 as defined (OR, not AND)")
        val input = smf_symbol_input_from_writer_symbol(_zero_size_sectioned_symbol())
        expect(input.defined).to_equal(true)

# ----------------------------------------------------------------------------
# 3. End-to-end — through smf_collect_records + smf_resolve
# ----------------------------------------------------------------------------

fn _main_bar_writer_symbols() -> [SmfWriterSymbol]:
    """Symbol order (module index 3): 0 main(def) 1 bar(undefined-only ref)
    2 main(ref)."""
    [
        _defined_symbol(),
        _undefined_reference_symbol("bar"),
        _undefined_reference_symbol("main")
    ]

fn _find_result(results: [ResolutionRecord], ref_local_index: u32) -> ResolutionRecord:
    var i = 0
    val n = results.len()
    while i < n:
        if results[i].reference.local_index == ref_local_index:
            return results[i]
        i = i + 1
    results[0]

describe "smf_reader_adapter end-to-end resolution":
    it "resolves the reference to main to the defined symbol's owner EntityRef":
        step("Verify: resolves the reference to main to the defined symbol's owner EntityRef")
        val adapted = smf_symbol_inputs_from_writer_symbols(_main_bar_writer_symbols())
        val inputs = SmfLinkInputs(module_index: 3, symbols: adapted)
        val (defs, refs) = smf_collect_records(inputs)
        expect(defs.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(refs.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        val results = smf_resolve(defs, refs)
        expect(results.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        val main_ref = _find_result(results, 2)
        expect(main_ref.status).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(main_ref.reason).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(entity_ref_equal(main_ref.definition, entity_ref(3, 0))).to_be(true)

    it "leaves the undefined-only reference Unresolved with reason MissingDefinition":
        step("Verify: leaves the undefined-only reference Unresolved with reason MissingDefinition")
        val adapted = smf_symbol_inputs_from_writer_symbols(_main_bar_writer_symbols())
        val inputs = SmfLinkInputs(module_index: 3, symbols: adapted)
        val (defs, refs) = smf_collect_records(inputs)
        val results = smf_resolve(defs, refs)

        val bar_ref = _find_result(results, 1)
        expect(bar_ref.status).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bar_ref.reason).to_equal(1)  # oracle: 1 — named expected value from the requirement
