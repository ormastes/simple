"""
## Purpose and audience
Purpose: Prove that smf_link_attributes schema v1 goldens.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

# ============================================================================
# smf_link_attributes.spl spec (Lane ATTR) — frozen schema-v1 attributes u64
# bit layout: exact hand-computed goldens, total-decode round trips,
# hard-reject of unknown bits/discriminants, writer-adapter mapping, and the
# smf_collect_records wiring.
#
# Hand computations (schema v1, low bits first — bit 0 defined, bits 1-2
# binding, bits 3-4 sym_type, bits 5-6 layout_phase, bit 7 anchor, bit 8
# pinned):
#   A. all-zero fields                                  -> 0
#   B. defined + Global(1) + Function(1) + startup(0)
#        = 1 + (1<<1) + (1<<3)          = 1 + 2 + 8     -> 11
#   C. defined + Weak(2) + Object(2) + steady(2)
#      + anchor + pinned
#        = 1 + 4 + 16 + 64 + 128 + 256                  -> 469
#   D. defined + Weak(2) + Section(3) + cold(3) + pinned
#        = 1 + 4 + 24 + 96 + 256                        -> 381
#   E. adapter case: defined + Global(1) + Function(1)
#      + first_frame(1) + anchor
#        = 1 + 2 + 8 + 32 + 128                         -> 171
#
# Claims:
#   1. GOLDENS — smf_link_attributes_encode returns exactly A-D above.
#   2. ROUND TRIP — decode(encode(f)) is ok and reproduces every field.
#   3. TOTAL REJECT — decode hard-rejects (ok=false) any reserved bit
#      (bit 9, bit 40, bit 62) and the unknown binding discriminant 3
#      (value 6 = bits 1+2), while 0 and 469 stay accepted.
#   4. ENCODER MASKING — an out-of-range in-memory binding code (4) is
#      width-masked (wire_put_u8 discipline), freezing that encode never
#      emits reserved bits.
#   5. ADAPTER — the writer-symbol adapter maps binding/sym_type enums,
#      layout_phase, and both flags onto SmfSymbolInput 1:1 (case E).
#   6. WIRING — smf_collect_records emits Definition/ReferenceRecords whose
#      `attributes` carry the real schema-v1 encodings, not 0.
# ============================================================================

use std.spec
use compiler.backend.linker.gpu_smf.smf_link_attributes.{
    SMF_LINK_ATTR_KNOWN_MASK,
    SMF_LINK_ATTR_SCHEMA_VERSION,
    SMF_LINK_BINDING_GLOBAL,
    SMF_LINK_BINDING_LOCAL,
    SMF_LINK_BINDING_WEAK,
    SMF_LINK_LAYOUT_PHASE_COLD,
    SMF_LINK_LAYOUT_PHASE_FIRST_FRAME,
    SMF_LINK_LAYOUT_PHASE_STARTUP,
    SMF_LINK_LAYOUT_PHASE_STEADY,
    SMF_LINK_SYM_TYPE_FUNCTION,
    SMF_LINK_SYM_TYPE_NOTYPE,
    SMF_LINK_SYM_TYPE_OBJECT,
    SMF_LINK_SYM_TYPE_SECTION,
    SmfLinkAttrFields,
    smf_link_attr_fields_zero,
    smf_link_attributes_decode,
    smf_link_attributes_encode
}
use compiler.backend.linker.gpu_smf.smf_link_profile.{
    SmfLinkInputs,
    SmfSymbolInput,
    smf_collect_records
}
use compiler.backend.linker.smf_writer.{
    SmfWriterSymbol,
    SmfWriterSymbolBinding,
    SmfWriterSymbolType
}
use compiler.backend.linker.gpu_smf.smf_reader_adapter.{
    smf_symbol_input_from_writer_symbol
}

# ----------------------------------------------------------------------------
# Fixtures
# ----------------------------------------------------------------------------

fn _fields_b() -> SmfLinkAttrFields:
    SmfLinkAttrFields(
        defined: true,
        binding: SMF_LINK_BINDING_GLOBAL,
        sym_type: SMF_LINK_SYM_TYPE_FUNCTION,
        layout_phase: SMF_LINK_LAYOUT_PHASE_STARTUP,
        is_event_loop_anchor: false,
        layout_pinned: false)

fn _fields_c() -> SmfLinkAttrFields:
    SmfLinkAttrFields(
        defined: true,
        binding: SMF_LINK_BINDING_WEAK,
        sym_type: SMF_LINK_SYM_TYPE_OBJECT,
        layout_phase: SMF_LINK_LAYOUT_PHASE_STEADY,
        is_event_loop_anchor: true,
        layout_pinned: true)

fn _fields_d() -> SmfLinkAttrFields:
    SmfLinkAttrFields(
        defined: true,
        binding: SMF_LINK_BINDING_WEAK,
        sym_type: SMF_LINK_SYM_TYPE_SECTION,
        layout_phase: SMF_LINK_LAYOUT_PHASE_COLD,
        is_event_loop_anchor: false,
        layout_pinned: true)

# ----------------------------------------------------------------------------
# 1. Exact hand-computed goldens
# ----------------------------------------------------------------------------

describe "smf_link_attributes schema v1 goldens":
    it "freezes schema version 1 and the 9-bit known mask":
        step("Verify: freezes schema version 1 and the 9-bit known mask")
        # @req: REQ-COMPILER-LINKER-001
        expect(SMF_LINK_ATTR_SCHEMA_VERSION).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(SMF_LINK_ATTR_KNOWN_MASK).to_equal(511)  # oracle: 511 — named expected value from the requirement

    it "encodes all-zero fields as 0 (case A)":
        step("Verify: encodes all-zero fields as 0 (case A)")
        expect(smf_link_attributes_encode(smf_link_attr_fields_zero())).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "encodes defined Global Function startup as 11 (case B)":
        step("Verify: encodes defined Global Function startup as 11 (case B)")
        expect(smf_link_attributes_encode(_fields_b())).to_equal(11)  # oracle: 11 — named expected value from the requirement

    it "encodes defined Weak Object steady anchor pinned as 469 (case C)":
        step("Verify: encodes defined Weak Object steady anchor pinned as 469 (case C)")
        expect(smf_link_attributes_encode(_fields_c())).to_equal(469)  # oracle: 469 — named expected value from the requirement

    it "encodes defined Weak Section cold pinned as 381 (case D)":
        step("Verify: encodes defined Weak Section cold pinned as 381 (case D)")
        expect(smf_link_attributes_encode(_fields_d())).to_equal(381)  # oracle: 381 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 2. Round trips
# ----------------------------------------------------------------------------

describe "smf_link_attributes round trip":
    it "decodes encode(case C) back to every field":
        step("Verify: decodes encode(case C) back to every field")
        val decoded = smf_link_attributes_decode(smf_link_attributes_encode(_fields_c()))
        expect(decoded.ok).to_equal(true)
        expect(decoded.value.defined).to_equal(true)
        expect(decoded.value.binding).to_equal(SMF_LINK_BINDING_WEAK)
        expect(decoded.value.sym_type).to_equal(SMF_LINK_SYM_TYPE_OBJECT)
        expect(decoded.value.layout_phase).to_equal(SMF_LINK_LAYOUT_PHASE_STEADY)
        expect(decoded.value.is_event_loop_anchor).to_equal(true)
        expect(decoded.value.layout_pinned).to_equal(true)

    it "decodes encode(case D) back to every field":
        step("Verify: decodes encode(case D) back to every field")
        val decoded = smf_link_attributes_decode(smf_link_attributes_encode(_fields_d()))
        expect(decoded.ok).to_equal(true)
        expect(decoded.value.defined).to_equal(true)
        expect(decoded.value.binding).to_equal(SMF_LINK_BINDING_WEAK)
        expect(decoded.value.sym_type).to_equal(SMF_LINK_SYM_TYPE_SECTION)
        expect(decoded.value.layout_phase).to_equal(SMF_LINK_LAYOUT_PHASE_COLD)
        expect(decoded.value.is_event_loop_anchor).to_equal(false)
        expect(decoded.value.layout_pinned).to_equal(true)

    it "decodes 0 as the all-zero fields":
        step("Verify: decodes 0 as the all-zero fields")
        val decoded = smf_link_attributes_decode(0)
        expect(decoded.ok).to_equal(true)
        expect(decoded.value.defined).to_equal(false)
        expect(decoded.value.binding).to_equal(SMF_LINK_BINDING_LOCAL)
        expect(decoded.value.sym_type).to_equal(SMF_LINK_SYM_TYPE_NOTYPE)
        expect(decoded.value.layout_phase).to_equal(SMF_LINK_LAYOUT_PHASE_STARTUP)
        expect(decoded.value.is_event_loop_anchor).to_equal(false)
        expect(decoded.value.layout_pinned).to_equal(false)

# ----------------------------------------------------------------------------
# 3. Total decode — hard rejects
# ----------------------------------------------------------------------------

describe "smf_link_attributes decode hard-reject":
    it "rejects reserved bit 9 (value 512)":
        step("Verify: rejects reserved bit 9 (value 512)")
        expect(smf_link_attributes_decode(512).ok).to_equal(false)

    it "rejects a mid reserved bit (bit 40)":
        step("Verify: rejects a mid reserved bit (bit 40)")
        val bit40: u64 = 1 << 40
        expect(smf_link_attributes_decode(bit40).ok).to_equal(false)

    it "rejects a high reserved bit (bit 62)":
        step("Verify: rejects a high reserved bit (bit 62)")
        val bit62: u64 = 1 << 62
        expect(smf_link_attributes_decode(bit62).ok).to_equal(false)

    it "rejects a reserved bit even when the low bits are a valid word (469 + 512)":
        step("Verify: rejects a reserved bit even when the low bits are a valid word (469 + 512)")
        expect(smf_link_attributes_decode(981).ok).to_equal(false)

    it "rejects the unknown binding discriminant 3 (value 6)":
        step("Verify: rejects the unknown binding discriminant 3 (value 6)")
        expect(smf_link_attributes_decode(6).ok).to_equal(false)

    it "still accepts the valid golden 469":
        step("Verify: still accepts the valid golden 469")
        expect(smf_link_attributes_decode(469).ok).to_equal(true)

# ----------------------------------------------------------------------------
# 4. Encoder masking discipline
# ----------------------------------------------------------------------------

describe "smf_link_attributes encoder masking":
    it "width-masks an out-of-range binding code so reserved bits are never emitted":
        step("Verify: width-masks an out-of-range binding code so reserved bits are never emitted")
        val bogus = SmfLinkAttrFields(
            defined: false,
            binding: 4,
            sym_type: 0,
            layout_phase: 0,
            is_event_loop_anchor: false,
            layout_pinned: false)
        # (4 << 1) & 0x6 == 0 — aliases to Local, exactly as wire_put_u8
        # truncates a u32 status; no bit above the known mask appears.
        expect(smf_link_attributes_encode(bogus)).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 5. Writer-symbol adapter mapping (case E)
# ----------------------------------------------------------------------------

fn _writer_symbol_e() -> SmfWriterSymbol:
    SmfWriterSymbol(
        name: "frame_pump",
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 0,
        value: 0,
        size: 32,
        layout_phase: 1,
        is_event_loop_anchor: true,
        layout_pinned: false)

describe "smf_reader_adapter attribute-field mapping":
    it "maps writer enums, layout_phase and flags onto SmfSymbolInput 1:1":
        step("Verify: maps writer enums, layout_phase and flags onto SmfSymbolInput 1:1")
        val input = smf_symbol_input_from_writer_symbol(_writer_symbol_e())
        expect(input.defined).to_equal(true)
        expect(input.binding).to_equal(SMF_LINK_BINDING_GLOBAL)
        expect(input.sym_type).to_equal(SMF_LINK_SYM_TYPE_FUNCTION)
        expect(input.layout_phase).to_equal(SMF_LINK_LAYOUT_PHASE_FIRST_FRAME)
        expect(input.is_event_loop_anchor).to_equal(true)
        expect(input.layout_pinned).to_equal(false)

    it "encodes the adapted case-E symbol to exactly 171 through collect":
        step("Verify: encodes the adapted case-E symbol to exactly 171 through collect")
        val inputs = SmfLinkInputs(
            module_index: 5,
            symbols: [smf_symbol_input_from_writer_symbol(_writer_symbol_e())])
        val (defs, refs) = smf_collect_records(inputs)
        expect(defs.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(refs.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(defs[0].attributes).to_equal(171)  # oracle: 171 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 6. smf_collect_records wiring — real attributes on both record kinds
# ----------------------------------------------------------------------------

describe "smf_collect_records real attributes":
    it "carries case-B attributes on a DefinitionRecord and case-D on a ReferenceRecord":
        step("Verify: carries case-B attributes on a DefinitionRecord and case-D on a ReferenceRecord")
        val inputs = SmfLinkInputs(
            module_index: 9,
            symbols: [
                SmfSymbolInput(
                    name: "main",
                    defined: true,
                    binding: SMF_LINK_BINDING_GLOBAL,
                    sym_type: SMF_LINK_SYM_TYPE_FUNCTION,
                    layout_phase: SMF_LINK_LAYOUT_PHASE_STARTUP,
                    is_event_loop_anchor: false,
                    layout_pinned: false),
                SmfSymbolInput(
                    name: "cold_pin",
                    defined: false,
                    binding: SMF_LINK_BINDING_WEAK,
                    sym_type: SMF_LINK_SYM_TYPE_SECTION,
                    layout_phase: SMF_LINK_LAYOUT_PHASE_COLD,
                    is_event_loop_anchor: false,
                    layout_pinned: true)
            ])
        val (defs, refs) = smf_collect_records(inputs)
        expect(defs.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(refs.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(defs[0].attributes).to_equal(11)  # oracle: 11 — named expected value from the requirement
        # Reference "cold_pin" is undefined, so its defined bit is 0:
        # 381 - 1 = 380.
        expect(refs[0].attributes).to_equal(380)  # oracle: 380 — named expected value from the requirement

    it "round-trips a collected record's attributes through the total decoder":
        step("Verify: round-trips a collected record's attributes through the total decoder")
        val inputs = SmfLinkInputs(
            module_index: 9,
            symbols: [
                SmfSymbolInput(
                    name: "steady_obj",
                    defined: true,
                    binding: SMF_LINK_BINDING_WEAK,
                    sym_type: SMF_LINK_SYM_TYPE_OBJECT,
                    layout_phase: SMF_LINK_LAYOUT_PHASE_STEADY,
                    is_event_loop_anchor: true,
                    layout_pinned: true)
            ])
        val (defs, _refs) = smf_collect_records(inputs)
        expect(defs[0].attributes).to_equal(469)  # oracle: 469 — named expected value from the requirement
        val decoded = smf_link_attributes_decode(defs[0].attributes)
        expect(decoded.ok).to_equal(true)
        expect(decoded.value.binding).to_equal(SMF_LINK_BINDING_WEAK)
        expect(decoded.value.layout_phase).to_equal(SMF_LINK_LAYOUT_PHASE_STEADY)
