"""
## Purpose and audience
Purpose: Prove that smf_reloc_compute Abs64 (S + A, 64-bit).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

# ============================================================================
# smf_reloc_formulas.spl spec (link_manager wave 7, Lane RELOC) — L8 CPU
# oracle formulas.
#
# Hand-computed fixtures per RelocationType variant: positive case, negative
# addend, PC-relative crossing zero, range-reject at exactly the width
# boundary and boundary +/- 1, plus wire-code totality rejection. All values
# computed by hand from the frozen formula table in
# src/compiler/70.backend/linker/gpu_smf/smf_reloc_formulas.spl.
# ============================================================================

use std.spec
use compiler.backend.linker.smf_writer.{RelocationType}
use compiler.backend.linker.gpu_smf.smf_reloc_formulas.{
    SmfRelocValue,
    smf_reloc_compute,
    smf_reloc_compute_wire
}

# ----------------------------------------------------------------------------
# 1. Abs64 — S + A, full 64-bit, no range check
# ----------------------------------------------------------------------------

describe "smf_reloc_compute Abs64 (S + A, 64-bit)":
    it "computes a positive case: s=4096 a=8 -> 4104":
        step("Verify: computes a positive case: s=4096 a=8 -> 4104")
        # @req: REQ-COMPILER-LINKER-001
        val r = smf_reloc_compute(RelocationType.Abs64, 4096, 8, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(4104)  # oracle: 4104 — named expected value from the requirement

    it "computes a negative addend: s=4096 a=-16 -> 4080":
        step("Verify: computes a negative addend: s=4096 a=-16 -> 4080")
        val r = smf_reloc_compute(RelocationType.Abs64, 4096, -16, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(4080)  # oracle: 4080 — named expected value from the requirement

    it "accepts values far above 32 bits: s=4294967296 a=4 -> 4294967300":
        step("Verify: accepts values far above 32 bits: s=4294967296 a=4 -> 4294967300")
        val r = smf_reloc_compute(RelocationType.Abs64, 4294967296, 4, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(4294967300)  # oracle: 4294967300 — named expected value from the requirement

    it "ignores p entirely: same result for p=0 and p=123456":
        step("Verify: ignores p entirely: same result for p=0 and p=123456")
        val r0 = smf_reloc_compute(RelocationType.Abs64, 4096, 8, 0)
        val r1 = smf_reloc_compute(RelocationType.Abs64, 4096, 8, 123456)
        expect(r0.value).to_equal(r1.value)

# ----------------------------------------------------------------------------
# 2. Rel32 — S + A - P, signed 32-bit range check
# ----------------------------------------------------------------------------

describe "smf_reloc_compute Rel32 (S + A - P, signed 32-bit)":
    it "computes a positive case: s=8192 a=-4 p=4096 -> 4092":
        step("Verify: computes a positive case: s=8192 a=-4 p=4096 -> 4092")
        val r = smf_reloc_compute(RelocationType.Rel32, 8192, -4, 4096)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(4092)  # oracle: 4092 — named expected value from the requirement

    it "computes a negative addend: s=8192 a=-8192 p=0 -> 0":
        step("Verify: computes a negative addend: s=8192 a=-8192 p=0 -> 0")
        val r = smf_reloc_compute(RelocationType.Rel32, 8192, -8192, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "crosses zero PC-relatively: s=16 a=0 p=4096 -> -4080":
        step("Verify: crosses zero PC-relatively: s=16 a=0 p=4096 -> -4080")
        val r = smf_reloc_compute(RelocationType.Rel32, 16, 0, 4096)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(-4080)  # oracle: -4080 — named expected value from the requirement

    it "accepts exactly the positive boundary 2147483647":
        step("Verify: accepts exactly the positive boundary 2147483647")
        val r = smf_reloc_compute(RelocationType.Rel32, 2147483647, 0, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(2147483647)  # oracle: 2147483647 — named expected value from the requirement

    it "rejects boundary+1 = 2147483648 (no silent truncation)":
        step("Verify: rejects boundary+1 = 2147483648 (no silent truncation)")
        val r = smf_reloc_compute(RelocationType.Rel32, 2147483648, 0, 0)
        expect(r.ok).to_be(false)

    it "accepts exactly the negative boundary -2147483648":
        step("Verify: accepts exactly the negative boundary -2147483648")
        val r = smf_reloc_compute(RelocationType.Rel32, 0, 0, 2147483648)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(-2147483648)  # oracle: -2147483648 — named expected value from the requirement

    it "rejects negative boundary-1 = -2147483649":
        step("Verify: rejects negative boundary-1 = -2147483649")
        val r = smf_reloc_compute(RelocationType.Rel32, 0, 0, 2147483649)
        expect(r.ok).to_be(false)

# ----------------------------------------------------------------------------
# 3. PltRel32 — S + A - P (L == S for static SMF), signed 32-bit
# ----------------------------------------------------------------------------

describe "smf_reloc_compute PltRel32 (S + A - P, signed 32-bit)":
    it "computes a positive case: s=12288 a=-4 p=12272 -> 12":
        step("Verify: computes a positive case: s=12288 a=-4 p=12272 -> 12")
        val r = smf_reloc_compute(RelocationType.PltRel32, 12288, -4, 12272)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "computes a negative addend crossing zero: s=100 a=-50 p=200 -> -150":
        step("Verify: computes a negative addend crossing zero: s=100 a=-50 p=200 -> -150")
        val r = smf_reloc_compute(RelocationType.PltRel32, 100, -50, 200)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(-150)  # oracle: -150 — named expected value from the requirement

    it "accepts exactly the positive boundary via addend: s=0 a=2147483647 p=0":
        step("Verify: accepts exactly the positive boundary via addend: s=0 a=2147483647 p=0")
        val r = smf_reloc_compute(RelocationType.PltRel32, 0, 2147483647, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(2147483647)  # oracle: 2147483647 — named expected value from the requirement

    it "rejects boundary+1: s=2147483644 a=8 p=4 -> 2147483648 rejected":
        step("Verify: rejects boundary+1: s=2147483644 a=8 p=4 -> 2147483648 rejected")
        val r = smf_reloc_compute(RelocationType.PltRel32, 2147483644, 8, 4)
        expect(r.ok).to_be(false)

    it "rejects negative boundary-1: s=0 a=-1 p=2147483648 -> -2147483649":
        step("Verify: rejects negative boundary-1: s=0 a=-1 p=2147483648 -> -2147483649")
        val r = smf_reloc_compute(RelocationType.PltRel32, 0, -1, 2147483648)
        expect(r.ok).to_be(false)

# ----------------------------------------------------------------------------
# 4. GotRel32 — S + A - P with s = GOT-entry address, signed 32-bit
# ----------------------------------------------------------------------------

describe "smf_reloc_compute GotRel32 (S + A - P, s = GOT entry, signed 32-bit)":
    it "computes a positive case: s=20480 a=-4 p=16384 -> 4092":
        step("Verify: computes a positive case: s=20480 a=-4 p=16384 -> 4092")
        val r = smf_reloc_compute(RelocationType.GotRel32, 20480, -4, 16384)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(4092)  # oracle: 4092 — named expected value from the requirement

    it "crosses zero PC-relatively: s=0 a=0 p=100 -> -100":
        step("Verify: crosses zero PC-relatively: s=0 a=0 p=100 -> -100")
        val r = smf_reloc_compute(RelocationType.GotRel32, 0, 0, 100)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(-100)  # oracle: -100 — named expected value from the requirement

    it "accepts exactly the negative boundary: s=0 a=0 p=2147483648":
        step("Verify: accepts exactly the negative boundary: s=0 a=0 p=2147483648")
        val r = smf_reloc_compute(RelocationType.GotRel32, 0, 0, 2147483648)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(-2147483648)  # oracle: -2147483648 — named expected value from the requirement

    it "rejects positive boundary+1: s=2147483648 a=0 p=0":
        step("Verify: rejects positive boundary+1: s=2147483648 a=0 p=0")
        val r = smf_reloc_compute(RelocationType.GotRel32, 2147483648, 0, 0)
        expect(r.ok).to_be(false)

    it "rejects negative boundary-1: s=0 a=0 p=2147483649":
        step("Verify: rejects negative boundary-1: s=0 a=0 p=2147483649")
        val r = smf_reloc_compute(RelocationType.GotRel32, 0, 0, 2147483649)
        expect(r.ok).to_be(false)

# ----------------------------------------------------------------------------
# 5. Abs32 — S + A, unsigned 32-bit range check
# ----------------------------------------------------------------------------

describe "smf_reloc_compute Abs32 (S + A, unsigned 32-bit)":
    it "computes a positive case: s=70000 a=1000 -> 71000":
        step("Verify: computes a positive case: s=70000 a=1000 -> 71000")
        val r = smf_reloc_compute(RelocationType.Abs32, 70000, 1000, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(71000)  # oracle: 71000 — named expected value from the requirement

    it "computes a negative addend still in range: s=70000 a=-1000 -> 69000":
        step("Verify: computes a negative addend still in range: s=70000 a=-1000 -> 69000")
        val r = smf_reloc_compute(RelocationType.Abs32, 70000, -1000, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(69000)  # oracle: 69000 — named expected value from the requirement

    it "accepts exactly the boundary 4294967295":
        step("Verify: accepts exactly the boundary 4294967295")
        val r = smf_reloc_compute(RelocationType.Abs32, 4294967295, 0, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(4294967295)  # oracle: 4294967295 — named expected value from the requirement

    it "rejects boundary+1 = 4294967296 (no silent truncation)":
        step("Verify: rejects boundary+1 = 4294967296 (no silent truncation)")
        val r = smf_reloc_compute(RelocationType.Abs32, 4294967296, 0, 0)
        expect(r.ok).to_be(false)

    it "accepts exactly the lower boundary 0":
        step("Verify: accepts exactly the lower boundary 0")
        val r = smf_reloc_compute(RelocationType.Abs32, 0, 0, 0)
        expect(r.ok).to_be(true)
        expect(r.value).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects lower boundary-1 = -1 (zero-extended field is unsigned)":
        step("Verify: rejects lower boundary-1 = -1 (zero-extended field is unsigned)")
        val r = smf_reloc_compute(RelocationType.Abs32, 0, -1, 0)
        expect(r.ok).to_be(false)

# ----------------------------------------------------------------------------
# 6. Wire-code entry point — agreement + totality rejection
# ----------------------------------------------------------------------------

describe "smf_reloc_compute_wire":
    it "agrees with the enum entry point on all 5 wire codes":
        step("Verify: agrees with the enum entry point on all 5 wire codes")
        val e1 = smf_reloc_compute(RelocationType.Abs64, 4096, 8, 0)
        val w1 = smf_reloc_compute_wire(1, 4096, 8, 0)
        expect(w1.ok).to_be(e1.ok)
        expect(w1.value).to_equal(e1.value)
        val e2 = smf_reloc_compute(RelocationType.Rel32, 8192, -4, 4096)
        val w2 = smf_reloc_compute_wire(2, 8192, -4, 4096)
        expect(w2.ok).to_be(e2.ok)
        expect(w2.value).to_equal(e2.value)
        val e3 = smf_reloc_compute(RelocationType.PltRel32, 12288, -4, 12272)
        val w3 = smf_reloc_compute_wire(3, 12288, -4, 12272)
        expect(w3.ok).to_be(e3.ok)
        expect(w3.value).to_equal(e3.value)
        val e4 = smf_reloc_compute(RelocationType.GotRel32, 20480, -4, 16384)
        val w4 = smf_reloc_compute_wire(4, 20480, -4, 16384)
        expect(w4.ok).to_be(e4.ok)
        expect(w4.value).to_equal(e4.value)
        val e5 = smf_reloc_compute(RelocationType.Abs32, 70000, 1000, 0)
        val w5 = smf_reloc_compute_wire(5, 70000, 1000, 0)
        expect(w5.ok).to_be(e5.ok)
        expect(w5.value).to_equal(e5.value)

    it "rejects unknown wire code 0":
        step("Verify: rejects unknown wire code 0")
        val r = smf_reloc_compute_wire(0, 4096, 8, 0)
        expect(r.ok).to_be(false)
        expect(r.value).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects unknown wire code 6 (one past the last defined variant)":
        step("Verify: rejects unknown wire code 6 (one past the last defined variant)")
        val r = smf_reloc_compute_wire(6, 4096, 8, 0)
        expect(r.ok).to_be(false)

    it "rejects negative wire code -1":
        step("Verify: rejects negative wire code -1")
        val r = smf_reloc_compute_wire(-1, 4096, 8, 0)
        expect(r.ok).to_be(false)
