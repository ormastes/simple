"""
## Purpose and audience
Purpose: Prove that Smf Header.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

"""SMF header specification tests."""

use compiler.backend.linker.smf_header.*
use compiler.backend.linker.smf_enums.*

use std.spec.step

describe "Smf Header":
    it "creates a v1.1 header with defaults":
        step("Verify: creates a v1.1 header with defaults")
        # @req: REQ-COMPILER-LINKER-001
        val header = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)

        expect(header.version_major).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(header.version_minor).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(header.get_platform()).to_equal(Platform.Linux)
        expect(header.get_arch()).to_equal(Arch.X86_64)
        expect(header.flags).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(header.window_width).to_equal(1280)  # oracle: 1280 — named expected value from the requirement
        expect(header.window_height).to_equal(720)  # oracle: 720 — named expected value from the requirement

    it "updates flags independently":
        step("Verify: updates flags independently")
        var header = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)
        header.set_executable(true)
        header.set_reloadable(true)
        header.set_debug_info(true)
        header.set_pic(true)

        expect(header.is_executable()).to_equal(true)
        expect(header.is_reloadable()).to_equal(true)
        expect(header.has_debug_info()).to_equal(true)
        expect(header.is_pic()).to_equal(true)

    it "stores compression and stub metadata":
        step("Verify: stores compression and stub metadata")
        var header = SmfHeader.new_v1_1(Platform.Windows, Arch.Aarch64)
        header.set_compression(CompressionType.Zstd, 3)
        header.set_stub_info(1024, 1024)

        expect(header.get_compression()).to_equal(CompressionType.Zstd)
        expect(header.compression_level).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(header.get_stub_size()).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(header.get_smf_data_offset()).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(header.has_stub()).to_equal(true)

    it "serializes to the fixed header size":
        step("Verify: serializes to the fixed header size")
        val header = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)
        expect(header.to_bytes().len()).to_equal(SMF_HEADER_SIZE)
