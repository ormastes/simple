"""Unit tests for native linker hardening helpers."""

use compiler.backend.linker.linker_wrapper.{
    NativeLinkConfig,
    unresolved_symbol_flags_for_unix_linker,
    unresolved_symbol_flags_for_cc,
    native_direct_platform_flags,
    native_effective_link_os,
    native_linker_abi_for_target
}
use compiler.backend.build_native_types.{BuildLinkConfig, BuildOutputFormat, native_link_config_from_build}
use compiler.backend.backend.llvm_native_link.{NativeLinkOptions}
use testing.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "Native linker hardening":
    it "preserves an explicit runtime provider across the build-link boundary":
        val build = BuildLinkConfig(
            output_format: BuildOutputFormat.Native,
            output_path: "/tmp/program",
            libraries: [],
            library_paths: [],
            pie: true,
            debug: false,
            verbose: false,
            allow_deferred: false,
            optimization_level: 0,
            target_flags: [],
            linker_flags: [],
            runtime_path: "/admitted/runtime"
        )
        expect(native_link_config_from_build(build).runtime_path).to_equal("/admitted/runtime")

    it "selects the complete admitted aggregate runtime when the monolith is absent":
        expect(native_runtime_archive_names("host-gpu", false, true, true)).to_equal([
            "libsimple_compiler_backfill.a", "libsimple_native_all.a"
        ])
        expect(native_runtime_archive_names("host-gpu", true, true, true)).to_equal(["libsimple_compiler.a"])
        expect(native_runtime_archive_names("host-gpu", false, false, false)).to_equal([])

    it "selects only the admitted provider pair for a core-C bootstrap bundle":
        expect(native_runtime_archive_names(
            "core-c-bootstrap", true, true, true
        )).to_equal(["libsimple_compiler_backfill.a", "libsimple_native_all.a"])
        expect(native_runtime_archive_names(
            "core-c-bootstrap", true, false, false
        )).to_equal([])
        expect(native_runtime_archive_names(
            "core-c-bootstrap", true, true, false
        )).to_equal([])
        expect(native_runtime_archive_names(
            "core-c-bootstrap", true, false, true
        )).to_equal([])

    it "fails closed before direct or cc fallback can substitute the monolith":
        val config = NativeLinkConfig(
            libraries: [],
            library_paths: [],
            runtime_path: "/missing/admitted/runtime",
            pie: true,
            debug: false,
            verbose: false,
            allow_duplicate_definitions: true,
            allow_cc_fallback: true,
            retained_symbols: [],
            extra_flags: [],
            runtime_bundle: "core-c-bootstrap"
        )
        expect(native_runtime_provider_selection_error_for_config(config)).to_contain(
            "has no complete admitted provider set"
        )
        expect(_cc_fallback_runtime_lib_args(config).contains("-lsimple_compiler")).to_equal(false)
        val linker_source = rt_file_read_text(
            "src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl"
        ) ?? ""
        expect(linker_source).to_contain(
            "val provider_error = native_runtime_provider_selection_error_for_config_platform("
        )
        expect(linker_source).to_contain(
            "val provider_error = native_runtime_provider_selection_error_for_config(config)"
        )

    it "rejects disabled, undiscovered, and unknown explicit authorities":
        val none_config = NativeLinkConfig(
            libraries: [], library_paths: [], runtime_path: "none", pie: true,
            debug: false, verbose: false, allow_duplicate_definitions: true,
            allow_cc_fallback: true, retained_symbols: [], extra_flags: [],
            runtime_bundle: "core-c-bootstrap"
        )
        expect(native_runtime_provider_selection_error_for_config(none_config)).to_contain(
            "cannot use runtime path 'none'"
        )
        expect(native_runtime_provider_selection_error_for(
            "", "core-c-bootstrap", false, false, false
        )).to_contain(
            "requires a discovered runtime directory"
        )
        val typo = NativeLinkConfig(..none_config,
            runtime_path: "/admitted/runtime", runtime_bundle: "core-c-bootstarp")
        expect(native_runtime_provider_selection_error_for_config(typo)).to_contain(
            "unknown runtime bundle"
        )
        expect(native_runtime_archive_names(
            "core-c-bootstarp", true, true, true
        )).to_equal([])

    it "keeps empty default compatibility and renders exact validated final args":
        expect(native_runtime_archive_names("", true, true, true)).to_equal([
            "libsimple_compiler.a"
        ])
        expect(native_runtime_archive_names("auto", true, true, true)).to_equal([
            "libsimple_compiler.a"
        ])
        expect(native_runtime_provider_selection_error_for(
            "/legacy/runtime", "auto", true, false, false
        )).to_equal("")
        expect(native_runtime_provider_selection_error_for(
            "none", "auto", false, false, false
        )).to_equal("")
        expect(native_runtime_provider_selection_error_for(
            "", "auto", false, false, false
        )).to_equal("")
        expect(native_runtime_archive_names("auto", false, true, false)).to_equal([
            "libsimple_compiler_backfill.a"
        ])
        val pair = [
            "/admitted/runtime/libsimple_compiler_backfill.a",
            "/admitted/runtime/libsimple_native_all.a"
        ]
        expect(native_runtime_archive_link_args(
            "/admitted/runtime", "core-c-bootstrap", pair, false, true, true
        )).to_equal([
            pair[0], pair[1], pair[0], "-rpath", "/admitted/runtime"
        ])
        expect(native_runtime_archive_link_args(
            "/admitted/runtime", "core-c-bootstrap", pair, true, true, true
        )).to_equal([pair[0], pair[1], pair[0],
            "-Wl,-rpath,/admitted/runtime"])
        expect(native_runtime_archive_link_args(
            "/admitted/runtime", "core-c-bootstrap", [], false, true, true
        )).to_equal([])
        expect(native_runtime_archive_link_args(
            "/admitted/runtime", "core-c-bootstrap", [], true, true, true
        )).to_equal([])
        expect(native_runtime_archive_link_args(
            "/legacy/runtime", "", [], false, true, true
        )).to_equal([
            "-L", "/legacy/runtime", "-lsimple_compiler", "-rpath", "/legacy/runtime"
        ])
        expect(native_runtime_archive_link_args(
            "/legacy/runtime", "auto", [], false, true, true
        )).to_equal([
            "-L", "/legacy/runtime", "-lsimple_compiler", "-rpath", "/legacy/runtime"
        ])
        expect(native_runtime_archive_link_args(
            "/legacy/runtime", "auto", [], true, true, true
        )).to_equal([
            "-L", "/legacy/runtime", "-lsimple_compiler",
            "-Wl,-rpath,/legacy/runtime"
        ])

    it "requires complete named aggregates and maps them onto Windows providers":
        for bundle in ["simple-core", "simple_core", "host-gpu", "host_gpu"]:
            expect(native_runtime_archive_names(bundle, false, true, false)).to_equal([])
            expect(native_runtime_archive_names(bundle, false, false, true)).to_equal([])
            expect(native_runtime_archive_names(bundle, false, true, true)).to_equal([
                "libsimple_compiler_backfill.a", "libsimple_native_all.a"
            ])
            expect(native_runtime_archive_names(bundle, true, true, true)).to_equal([
                "libsimple_compiler_backfill.a", "libsimple_native_all.a"
            ])
            val alias_pair = [
                "/admitted/runtime/libsimple_compiler_backfill.a",
                "/admitted/runtime/libsimple_native_all.a"
            ]
            expect(native_runtime_archive_link_args(
                "/admitted/runtime", bundle, alias_pair, false, true, true
            )).to_equal([alias_pair[0], alias_pair[1], alias_pair[0],
                "-rpath", "/admitted/runtime"])
            expect(native_runtime_archive_link_args(
                "/admitted/runtime", bundle, alias_pair, true, true, true
            )).to_equal([alias_pair[0], alias_pair[1], alias_pair[0],
                "-Wl,-rpath,/admitted/runtime"])
            expect(native_runtime_provider_selection_error_for(
                "/partial/runtime", bundle, false, true, false
            )).to_contain("has no complete admitted provider set")
        val windows_pair = native_runtime_archive_names_for_platform(
            "core-c-bootstrap", true, true, true, true)
        expect(windows_pair).to_equal([
            "simple_compiler_backfill.lib", "simple_native_all.lib"
        ])
        expect(native_runtime_archive_link_args(
            "C:/admitted/runtime", "core-c-bootstrap", windows_pair, true, false, false
        )).to_equal([
            "simple_compiler_backfill.lib", "simple_native_all.lib"
        ])
        expect(native_msvc_runtime_libraries([
            "simple_compiler_backfill.lib", "user.lib"
        ], [
            "C:/admitted/runtime/simple_compiler_backfill.lib",
            "C:/admitted/runtime/simple_native_all.lib"
        ])).to_equal([
            "simple_compiler_backfill.lib", "user.lib",
            "C:/admitted/runtime/simple_native_all.lib"
        ])
        expect(native_msvc_runtime_libraries([
            "C:\\configured\\simple_native_all.lib"
        ], [
            "C:/admitted/runtime/simple_compiler_backfill.lib",
            "C:/admitted/runtime/simple_native_all.lib"
        ])).to_equal([
            "C:\\configured\\simple_native_all.lib",
            "C:/admitted/runtime/simple_compiler_backfill.lib"
        ])
        for bundle in ["", "auto"]:
            val fallback = native_msvc_runtime_selection(bundle, [])
            expect(fallback).to_equal(["simple_compiler.lib"])
            expect(native_msvc_runtime_libraries([
                "simple_compiler.lib"
            ], fallback)).to_equal(["simple_compiler.lib"])
            expect(native_msvc_runtime_libraries([
                "C:/configured/SIMPLE_COMPILER.LIB"
            ], fallback)).to_equal(["C:/configured/SIMPLE_COMPILER.LIB"])
            expect(native_msvc_runtime_libraries([
                "C:\\configured\\Simple_Compiler.Lib"
            ], fallback)).to_equal(["C:\\configured\\Simple_Compiler.Lib"])
            val uppercase_config = native_msvc_configured_libraries([], [
                "C:/configured/SIMPLE_COMPILER.LIB"
            ])
            expect(uppercase_config).to_equal([
                "C:/configured/SIMPLE_COMPILER.LIB"
            ])
            expect(native_msvc_runtime_libraries(
                uppercase_config, fallback)).to_equal(uppercase_config)
            val mixed_config = native_msvc_configured_libraries([], [
                "C:\\configured\\Simple_Compiler.Lib"
            ])
            expect(mixed_config).to_equal([
                "C:\\configured\\Simple_Compiler.Lib"
            ])
            expect(native_msvc_runtime_libraries(
                mixed_config, fallback)).to_equal(mixed_config)
        val raw_pair_config = native_msvc_configured_libraries([], [
            "C:/configured/SIMPLE_COMPILER_BACKFILL.LIB",
            "C:\\configured\\Simple_Native_All.Lib"
        ])
        val selected_pair = native_msvc_runtime_selection(
            "core-c-bootstrap", [
                "C:/admitted/simple_compiler_backfill.lib",
                "C:/admitted/simple_native_all.lib"
            ])
        expect(native_msvc_runtime_libraries(
            raw_pair_config, selected_pair)).to_equal(raw_pair_config)
        expect(native_msvc_configured_libraries([], ["user_provider"])).to_equal([
            "user_provider.lib"
        ])
        val duplicate_config = native_msvc_configured_libraries([], [
            "C:/configured/USER_PROVIDER.LIB", "user_provider.lib",
            "C:\\configured\\Other_Provider.Lib"
        ])
        expect(duplicate_config).to_equal([
            "C:/configured/USER_PROVIDER.LIB",
            "C:\\configured\\Other_Provider.Lib"
        ])
        expect(native_msvc_runtime_libraries(
            duplicate_config, ["simple_compiler.lib"])).to_equal([
            "C:/configured/USER_PROVIDER.LIB",
            "C:\\configured\\Other_Provider.Lib", "simple_compiler.lib"
        ])
        val configured_fallback = native_msvc_configured_libraries([], [
            "C:\\configured\\SIMPLE_COMPILER.LIB", "distinct"
        ])
        expect(native_msvc_runtime_libraries(
            configured_fallback, ["simple_compiler.lib"])).to_equal([
            "C:\\configured\\SIMPLE_COMPILER.LIB", "distinct.lib"
        ])

    it "assembles platform-correct shared runtime commands for default and named bundles":
        val unix_pair = ["/runtime/libsimple_compiler_backfill.a",
            "/runtime/libsimple_native_all.a"]
        for bundle in ["", "auto"]:
            var unix_command = ["cc", "-shared", "user.o"]
            for arg in native_runtime_archive_link_args(
                    "/runtime", bundle, [], true, true, true):
                unix_command.push(arg)
            unix_command.push("-o")
            unix_command.push("libuser.so")
            expect(unix_command).to_equal([
                "cc", "-shared", "user.o", "-L", "/runtime",
                "-lsimple_compiler", "-Wl,-rpath,/runtime", "-o", "libuser.so"
            ])
            var mingw_command = ["gcc", "-shared", "user.o"]
            for arg in native_runtime_archive_link_args(
                    "C:/runtime", bundle, [], true, true, false):
                mingw_command.push(arg)
            mingw_command.push("-o")
            mingw_command.push("user.dll")
            expect(mingw_command).to_equal([
                "gcc", "-shared", "user.o", "-L", "C:/runtime",
                "-lsimple_compiler", "-o", "user.dll"
            ])
        var unix_pair_command = ["cc", "-shared", "user.o"]
        for arg in native_runtime_archive_link_args(
                "/runtime", "host-gpu", unix_pair, true, true, true):
            unix_pair_command.push(arg)
        expect(unix_pair_command).to_equal([
            "cc", "-shared", "user.o", unix_pair[0], unix_pair[1], unix_pair[0],
            "-Wl,-rpath,/runtime"
        ])
        var mingw_pair_command = ["gcc", "-shared", "user.o"]
        for arg in native_runtime_archive_link_args(
                "C:/runtime", "host-gpu", unix_pair, true, true, false):
            mingw_pair_command.push(arg)
        expect(mingw_pair_command).to_equal([
            "gcc", "-shared", "user.o", unix_pair[0], unix_pair[1], unix_pair[0]
        ])
        val msvc_pair = ["simple_compiler_backfill.lib", "simple_native_all.lib"]
        expect(native_msvc_runtime_selection("host-gpu", msvc_pair)).to_equal(msvc_pair)

    it "validates authority before SMF and Windows dispatch and honors it in both Windows linkers":
        val native = rt_file_read_text(
            "src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl"
        ) ?? ""
        val shared = rt_file_read_text(
            "src/compiler/70.backend/linker/_LinkerWrapper/shared_linking.spl"
        ) ?? ""
        val validation = native.index_of(
            "val provider_error = native_runtime_provider_selection_error_for_config_platform(")
        val smf_dispatch = native.index_of("val smf_inputs = filter_smf_inputs(object_files)")
        val windows_dispatch = native.index_of('if os == "windows":', validation)
        expect(validation).to_be_greater_than(0)
        expect(validation).to_be_less_than(smf_dispatch)
        expect(validation).to_be_less_than(windows_dispatch)
        val shared_validation = shared.index_of(
            "val provider_error = native_runtime_provider_selection_error_for_config_platform(")
        val shared_windows_dispatch = shared.index_of(
            'if os == "windows":', shared_validation)
        val shared_unix_dispatch = shared.index_of(
            "_link_shared_unix(object_files, output, config)", shared_validation)
        expect(shared_validation).to_be_greater_than(0)
        expect(shared_validation).to_be_less_than(shared_windows_dispatch)
        expect(shared_validation).to_be_less_than(shared_unix_dispatch)
        expect(native).to_contain(
            "native_runtime_archive_inputs_for_platform(\n            runtime_dir, config.runtime_bundle, true)"
        )
        expect(native).to_contain(
            "val selected_runtime_libs = native_msvc_runtime_selection("
        )
        expect(native).to_contain(
            "msvc_config.libs = native_msvc_runtime_libraries("
        )
        expect(native).to_contain(
            "msvc_config.libs = native_msvc_configured_libraries("
        )
        expect(native.contains('if lib.ends_with(".lib")')).to_equal(false)
        expect(shared).to_contain(
            "native_runtime_archive_link_args(\n                runtime_dir, config.runtime_bundle, runtime_archives, true, true, false)"
        )
        expect(shared).to_contain(
            "native_runtime_archive_link_args(\n                runtime_dir, config.runtime_bundle, runtime_archives, true, true, true)"
        )
        expect(shared).to_contain(
            "val runtime_archives = native_runtime_archive_inputs(\n            runtime_dir, config.runtime_bundle)"
        )
        expect(shared).to_contain(
            "msvc_config.libs = native_msvc_configured_libraries("
        )
        expect(shared).to_contain(
            "val selected_runtime_libs = native_msvc_runtime_selection("
        )
        expect(shared).to_contain(
            "msvc_config.libs = native_msvc_runtime_libraries("
        )
        expect(shared.contains('if lib.ends_with(".lib")')).to_equal(false)
        expect(shared.contains('msvc_config.libs.push("simple_compiler.lib")')).to_equal(false)
        expect(shared.contains("sb.push(\" -L{runtime_dir} -lsimple_compiler\")")).to_equal(false)
        expect(shared.contains("sb.push(\" -Wl,-rpath,{runtime_dir}\")")).to_equal(false)

    it "carries runtime authority explicitly through the active AOT link options":
        val options = NativeLinkOptions(
            debug: false,
            verbose: false,
            pie: true,
            bare_metal: false,
            opt_level: 0,
            stage4_backend: "cranelift",
            stage4_compiler_hash: "compiler-sha",
            runtime_path: "/admitted/runtime",
            runtime_bundle: "host-gpu"
        )
        expect(options.runtime_path).to_equal("/admitted/runtime")
        expect(options.runtime_bundle).to_equal("host-gpu")

    it "keeps object-format flags and cross-target dispatch explicit":
        expect(native_direct_platform_flags("linux", "lld")).to_equal([
            "--eh-frame-hdr", "--build-id", "--hash-style=gnu",
            "-z", "relro", "-z", "now", "--gc-sections", "--icf=all"
        ])
        expect(native_direct_platform_flags("darwin", "ld64")).to_equal(["-dead_strip"])
        expect(native_direct_platform_flags("windows-mingw", "ld")).to_equal([])
        expect(native_direct_platform_flags("windows-msvc", "msvc")).to_equal([])
        expect(native_linker_abi_for_target("x86_64-pc-windows-gnu")).to_equal("windows-gnu")
        expect(native_linker_abi_for_target("x86_64-pc-windows-msvc")).to_equal("windows-msvc")
        expect(native_effective_link_os("linux", "x86_64-pc-windows-gnu", "windows-gnu")).to_equal("windows-mingw")
        expect(native_effective_link_os("linux", "x86_64-pc-windows-msvc", "windows-msvc")).to_equal("windows-msvc")

    it "transports native target from CLI options into the linker config":
        val cli = rt_file_read_text("src/app/io/_CliCompile/compile_targets.spl") ?? ""
        val driver = rt_file_read_text("src/compiler/80.driver/driver_aot_native_output.spl") ?? ""
        val orchestrator = rt_file_read_text("src/compiler/70.backend/backend/llvm_native_link_orchestrator.spl") ?? ""
        expect(cli).to_contain("options.native_target = native_target")
        expect(driver).to_contain("val native_target = ctx.native_target")
        expect(orchestrator).to_contain("val hosted_target = options.target_triple")
        expect(orchestrator.contains("val hosted_target = env_get")).to_equal(false)

    it "recognizes only strong Vulkan provider definitions":
        expect(llvm_nm_output_has_strong_definition(
            "weak.o:\n                 w rt_vulkan_provider_is_available\nstrong.o:\n0000000000000000 T rt_vulkan_provider_is_available\n",
            "rt_vulkan_provider_is_available"
        )).to_be(true)
        expect(llvm_nm_output_has_strong_definition(
            "                 W rt_vulkan_provider_is_available\n",
            "rt_vulkan_provider_is_available"
        )).to_be(false)
        expect(llvm_nm_output_has_strong_definition(
            "                 U rt_vulkan_provider_is_available\n",
            "rt_vulkan_provider_is_available"
        )).to_be(false)
        expect(llvm_nm_output_has_strong_definition(
            "0000000000000000 T _rt_vulkan_provider_is_available\n",
            "rt_vulkan_provider_is_available"
        )).to_be(true)

    it "renders archive roots for each native linker family":
        val roots = ["rt_vulkan_provider_is_available"]
        expect(native_retained_symbol_direct_args(roots, "linux")).to_equal([
            "--undefined=rt_vulkan_provider_is_available",
            "--export-dynamic-symbol=rt_vulkan_provider_is_available"
        ])
        expect(native_retained_symbol_direct_args(roots, "macos")).to_equal([
            "-u", "_rt_vulkan_provider_is_available",
            "-export_dynamic"
        ])
        expect(native_retained_symbol_cc_args(roots, "linux")).to_equal([
            "-Wl,--undefined=rt_vulkan_provider_is_available",
            "-Wl,--export-dynamic-symbol=rt_vulkan_provider_is_available"
        ])
        expect(native_retained_symbol_cc_args(roots, "darwin")).to_equal([
            "-Wl,-u,_rt_vulkan_provider_is_available",
            "-Wl,-export_dynamic"
        ])
        expect(native_retained_symbol_cc_args(roots, "windows-mingw")).to_equal([
            "-Wl,-u,rt_vulkan_provider_is_available"
        ])
        expect(native_retained_symbol_msvc_args(roots)).to_equal([
            "/INCLUDE:rt_vulkan_provider_is_available",
            "/EXPORT:rt_vulkan_provider_is_available"
        ])

    it "preserves every object in cc fallback arguments":
        expect(cc_fallback_object_args(["user.o", "runtime.o", "entry.o"])).to_equal([
            "user.o", "runtime.o", "entry.o"
        ])

    it "allows duplicate symbols without ignoring unresolved ELF symbols":
        expect(unresolved_symbol_flags_for_unix_linker("linux")).to_equal([
            "--allow-multiple-definition",
            "--unresolved-symbols=ignore-all"
        ])
        expect(unresolved_symbol_flags_for_unix_linker("freebsd")).to_equal([
            "--allow-multiple-definition",
            "--unresolved-symbols=ignore-all"
        ])

    it "skips ELF unresolved-symbol flags on non-ELF direct linkers":
        expect(unresolved_symbol_flags_for_unix_linker("macos")).to_equal([])
        expect(unresolved_symbol_flags_for_unix_linker("darwin")).to_equal([])

    it "allows duplicate symbols without ignoring unresolved cc symbols":
        expect(unresolved_symbol_flags_for_cc("Linux")).to_equal([
            "-Wl,--allow-multiple-definition",
            "-Wl,--unresolved-symbols=ignore-all"
        ])
        expect(unresolved_symbol_flags_for_cc("FreeBSD")).to_equal([
            "-Wl,--allow-multiple-definition",
            "-Wl,--unresolved-symbols=ignore-all"
        ])

    it "keeps unresolved Windows symbols fatal":
        expect(msvc_duplicate_symbol_flag()).to_equal("/FORCE:MULTIPLE")
        expect(msvc_duplicate_symbol_flag().contains("UNRESOLVED")).to_equal(false)

    it "lets strict links disable duplicate forgiveness and cc fallback":
        val native = rt_file_read_text("src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl") ?? ""
        val llvm = rt_file_read_text("src/compiler/70.backend/backend/llvm_native_link.spl") ?? ""
        expect(native).to_contain("if config.allow_duplicate_definitions:")
        expect(native).to_contain("if not config.allow_cc_fallback:")
        expect(llvm).to_contain("allow_duplicate_definitions: not stage4_requested")
        expect(llvm).to_contain("allow_cc_fallback: not stage4_requested")

    it "makes strict SimpleOS links disable fabrication debt baselines":
        val llvm = rt_file_read_text("src/compiler/70.backend/backend/llvm_native_link.spl") ?? ""
        expect(llvm).to_contain("env_get(\"SIMPLE_NO_STUB_FALLBACK\")")
        expect(llvm).to_contain("if flight_closure: {} else: simpleos_simple_symbol_baseline(entry_key)")
        expect(llvm).to_contain("if flight_closure: {} else: simpleos_fabricated_baseline(entry_key)")

    it "WP-10: a flight-closure link (critical profile OR strict env) disables the fabrication baseline exactly like strict_no_stub_fallback":
        step("Verify: WP-10: a flight-closure link (critical profile OR strict env) disables the fabrication baseline exactly like strict_no_stub_fallback")
        """
        doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md
        WP-10: `simpleos_check_no_fabricated_rt_stubs`'s baseline exemption
        used to be gated ONLY by SIMPLE_NO_STUB_FALLBACK=1 -- a `critical`
        assurance-profile link got the same lenient baseline exemption as
        every other profile, so a previously-baselined fabricated weak
        NIL-returning stub (auto_stubs.c) could still ship silently. This
        pins that `flight_closure` now ORs in the critical profile, routed
        through the WP-3 canonical policy resolver rather than a hardcoded
        string compare.
        """
        val llvm = compiler_native_link_source()
        expect(llvm).to_contain("use compiler.common.assurance.policy." + "{" + "strictness_for_profile_name" + "}")
        expect(llvm).to_contain("use compiler.common.assurance.policy_schema." + "{" + "AssuranceStrictness" + "}")
        expect(llvm).to_contain("val flight_closure_profile = env_get(\"SIMPLE_SAFETY_PROFILE\") ?? \"\"")
        expect(llvm).to_contain("val flight_closure = strict_no_stub_fallback or strictness_for_profile_name(flight_closure_profile).at_least(AssuranceStrictness.Critical)")
        # non-flight-closure (moderate/strict/robust, SIMPLE_NO_STUB_FALLBACK
        # unset) must keep today's fabrication-tolerant behaviour: the
        # baseline lookup is still reachable, not unconditionally emptied.
        expect(llvm.contains("val baseline = if flight_closure: {} else: simpleos_fabricated_baseline(entry_key)")).to_equal(true)

    it "requires complete CRT endpoints before direct linking":
        val crt = rt_file_read_text("src/compiler/70.backend/linker/crt_discovery.spl") ?? ""
        expect(crt).to_contain("found: found_crtbegin != \"\" and found_crtend != \"\"")
        expect(crt.contains("found: true")).to_equal(false)

    it "uses configured and architecture-default Homebrew prefixes":
        expect(macos_homebrew_prefix("/custom/brew", "x86_64")).to_equal("/custom/brew")
        expect(macos_homebrew_prefix("", "x86_64")).to_equal("/usr/local")
        expect(macos_homebrew_prefix("", "aarch64")).to_equal("/opt/homebrew")

    it "skips cc fallback unresolved-symbol flags on Darwin":
        expect(unresolved_symbol_flags_for_cc("Darwin")).to_equal([])

    it "recognizes only canonical native-all archive leaves":
        expect(native_all_input_present(["/tmp/libsimple_native_all.a"])).to_be(true)
        expect(native_all_input_present(["C:\\runtime\\SIMPLE_NATIVE_ALL.LIB"])).to_be(true)
        expect(native_all_input_present(["/tmp/libsimple_runtime.a"])).to_be(false)
        expect(native_all_input_present(["/tmp/libsimple_native_all.dll.a"])).to_be(false)
        expect(native_all_input_present(["/tmp/libsimple_native_all.a.tmp"])).to_be(false)
        expect(native_all_input_present(["/tmp/my_libsimple_native_all.a"])).to_be(false)

    it "keeps native-all support out of core-only links":
        for os in ["linux", "macos", "freebsd", "windows-mingw"]:
            expect(native_all_gnu_support_args(["runtime.o"], os, "/brew")).to_equal([])
        expect(native_all_msvc_support_libraries(["runtime.obj"])).to_equal([])

    it "supplies hosted native-all transitive dependencies":
        val archive = ["/runtime/libsimple_native_all.a"]
        expect(native_all_gnu_support_args(archive, "linux", "")).to_equal([
            "-lstdc++", "-lsqlite3", "-lz", "-lzstd", "-ltinfo", "-lffi", "-lxml2", "-lncurses"
        ])
        val macos = native_all_gnu_support_args(archive, "macos", "/custom/brew")
        expect(macos).to_contain("-L/custom/brew/lib")
        expect(macos).to_contain("CoreFoundation")
        expect(macos).to_contain("AppKit")
        expect(macos).to_contain("CoreGraphics")
        expect(native_all_gnu_support_args(archive, "freebsd", "")).to_equal([
            "-L/usr/local/lib", "-lc++", "-lexecinfo", "-lz", "-lzstd", "-lutil", "-lrt"
        ])
        val mingw = native_all_gnu_support_args(["C:\\runtime\\simple_native_all.lib"], "windows-mingw", "")
        expect(mingw).to_contain("-ldbghelp")
        expect(mingw).to_contain("-lruntimeobject")
        expect(mingw).to_contain("-lgcc")
        val msvc = native_all_msvc_support_libraries(["C:\\runtime\\simple_native_all.lib"])
        expect(msvc).to_contain("dbghelp.lib")
        expect(msvc).to_contain("gdi32.lib")
        expect(msvc).to_contain("vcruntime.lib")

    it "wires the shared policy into every native and shared linker path":
        val native = rt_file_read_text("src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl")
        val shared = rt_file_read_text("src/compiler/70.backend/linker/_LinkerWrapper/shared_linking.spl")
        expect(native.split("native_all_gnu_support_args").len() - 1).to_equal(4)
        expect(shared.split("native_all_gnu_support_args").len() - 1).to_equal(3)
        expect(native.split("native_all_msvc_support_libraries").len() - 1).to_equal(1)
        expect(shared.split("native_all_msvc_support_libraries").len() - 1).to_equal(1)
