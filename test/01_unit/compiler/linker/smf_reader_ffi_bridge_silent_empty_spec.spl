"""Reproducing spec for doc/08_tracking/bug/smf_reader_bridge_silent_nil.md

`SmfReaderImpl.open` routed every read through six `rt_smf_reader_*` externs
that have NO implementation anywhere in the tree. An unregistered extern does
not fail to link -- it yields 0/nil -- so `read_header` returned a hardcoded
all-zero header, and `read_symbol_table` / `read_string_table` / `read_section`
returned `[]` unconditionally.

The result is a silent wrong answer, not a crash: a perfectly valid SMF file
containing symbols was reported as parsing fine with section_count 0,
symbol_count 0 and every `lookup_symbol` failing with "Symbol not found".

This spec builds a real, minimal-but-valid SMF byte image on disk and asserts
the file-backed reader reports what is actually in the file. It runs
INTERPRETED, which is sufficient: the defect is in pure-Simple code in
src/compiler/70.backend/linker/smf_reader.spl, not in a backend lowering.
"""

use compiler.backend.linker.smf_reader.{SmfReaderImpl}
use std.io_runtime.{file_write_bytes}

fn push_u32_le(out: [u8], v: i64) -> [u8]:
    var o = out
    o.push((v % 256) as u8)
    o.push(((v / 256) % 256) as u8)
    o.push(((v / 65536) % 256) as u8)
    o.push(((v / 16777216) % 256) as u8)
    o

fn push_u64_le(out: [u8], v: i64) -> [u8]:
    var o = push_u32_le(out, v)
    o = push_u32_le(o, 0)
    o

fn pad_to(out: [u8], n: i64) -> [u8]:
    var o = out
    while o.len() < n:
        o.push(0)
    o

# Canonical 128-byte SMF v1.1 header, stored at file offset 0.
# Offsets are exactly those decoded by parse_header_from_bytes().
fn build_header(section_count: i64, symbol_table_offset: i64, symbol_count: i64) -> [u8]:
    var h: [u8] = []
    h.push(83)   # 'S'
    h.push(77)   # 'M'
    h.push(70)   # 'F'
    h.push(0)    # NUL
    h.push(1)    # version_major
    h.push(1)    # version_minor
    h.push(1)    # platform
    h.push(0)    # arch
    h = push_u32_le(h, 0)                     # 8..12   flags
    h.push(0)                                 # 12      compression
    h = pad_to(h, 16)                         # 13..16  reserved
    h = push_u32_le(h, section_count)         # 16..20  section_count
    h = push_u64_le(h, 0)                     # 20..28  section_table_offset
    h = push_u64_le(h, symbol_table_offset)   # 28..36  symbol_table_offset
    h = push_u32_le(h, symbol_count)          # 36..40  symbol_count
    h = push_u32_le(h, symbol_count)          # 40..44  exported_count
    h = push_u64_le(h, 0)                     # 44..52  entry_point
    h = push_u32_le(h, 0)                     # 52..56  stub_size
    h = push_u32_le(h, 0)                     # 56..60  smf_data_offset
    pad_to(h, 128)

# 56-byte symbol entry, layout per _SmfReaderMemory/symbol_parser.spl.
fn build_symbol(name_offset: i64, value: i64, size: i64) -> [u8]:
    var s: [u8] = []
    s = push_u32_le(s, name_offset)   # 0..4    name_offset
    s = push_u32_le(s, 0)             # 4..8    name_hash
    s.push(1)                         # 8       sym_type (Function)
    s.push(1)                         # 9       binding (Global)
    s.push(0)                         # 10      visibility
    s.push(0)                         # 11      flags
    s = pad_to(s, 16)                 # 12..16  padding
    s = push_u64_le(s, value)         # 16..24  value
    s = push_u64_le(s, size)          # 24..32  size
    s = push_u32_le(s, 0)             # 32..36  type_id
    s = push_u32_le(s, 0)             # 36..40  version
    s.push(0)                         # 40      template_param_count
    s = pad_to(s, 48)                 # 41..48  reserved + padding
    s = push_u64_le(s, 0)             # 48..56  template_offset
    pad_to(s, 56)

# One global function symbol named "hello".
# header 0..128 | symbol entry 128..184 | string table 184..
fn build_smf_with_one_symbol() -> [u8]:
    var data = build_header(0, 128, 1)
    val sym = build_symbol(1, 0, 16)
    var i = 0
    while i < sym.len():
        data.push(sym[i])
        i = i + 1
    data.push(0)     # strtab offset 0: the empty name
    data.push(104)   # 'h'  <- offset 1
    data.push(101)   # 'e'
    data.push(108)   # 'l'
    data.push(108)   # 'l'
    data.push(111)   # 'o'
    data.push(0)     # terminator
    data

fn fixture_path() -> text:
    "/tmp/smf_reader_bridge_repro_one_symbol.smf"

fn write_fixture() -> text:
    val path = fixture_path()
    val ok = file_write_bytes(path, build_smf_with_one_symbol())
    expect(ok).to_equal(true)
    path

describe "SMF file-backed reader returns the file's real contents":
    """
    ## smf_reader_bridge_silent_nil

    The file-backed `SmfReaderImpl` must decode the same bytes the in-memory
    reader decodes. Before the fix every assertion below failed with the
    hardcoded-empty answer while `open()` still reported `Ok`.
    """

    it "reports the symbol count that is actually in the file":
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        expect(reader.header.symbol_count).to_equal(1)

    it "reports the real SMF version rather than a fabricated one":
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val (major, minor) = reader.header.version
        expect(major).to_equal(1)
        expect(minor).to_equal(1)

    it "resolves a symbol that is present in the file":
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val found = reader.lookup_symbol("hello")
        expect(found.is_ok()).to_equal(true)

    it "still reports a genuinely absent symbol as missing":
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val missing = reader.lookup_symbol("no_such_symbol")
        expect(missing.is_err()).to_equal(true)

    it "exposes the symbol through exported_symbols":
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        expect(reader.exported_symbols().len()).to_equal(1)

    it "carries the symbol's size through from the file":
        val path = write_fixture()
        val reader = SmfReaderImpl.open(path).unwrap()
        val sym = reader.lookup_symbol("hello").unwrap()
        expect(sym.size).to_equal(16)

    it "fails closed on a path that does not exist":
        val result = SmfReaderImpl.open("/tmp/definitely_not_an_smf_file_9f3a.smf")
        expect(result.is_err()).to_equal(true)

    it "fails closed on a file whose magic is not SMF":
        val bad = "/tmp/smf_reader_bridge_repro_bad_magic.smf"
        var junk: [u8] = [66, 65, 68, 0]
        while junk.len() < 200:
            junk.push(0)
        expect(file_write_bytes(bad, junk)).to_equal(true)
        val result = SmfReaderImpl.open(bad)
        expect(result.is_err()).to_equal(true)
