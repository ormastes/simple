# @req REQ-COMPILE-INDEX-PUBLIC-INTERFACE
use std.spec.{describe, it, expect, step}
use compiler.core.ast.{ast_reset}
use compiler.core.parser.{parse_module}
use compiler.core.types.{reset_all_pools}
use compiler.shb.shb_extractor.{shb_extract}

describe "SHB public interface extraction":
    it "includes an explicit public function and excludes a private peer":
        step("Parse real declarations into the compiler AST")
        val source = "pub fn visible() -> i64:\n    1\n" +
            "fn hidden() -> i64:\n    2\n"
        reset_all_pools()
        ast_reset()
        parse_module(source, "fixture.spl")

        step("Extract the public SHB interface from the parsed AST")
        val iface = shb_extract(source, "fixture.spl")
        expect(iface.functions.len()).to_equal(1)
        expect(iface.functions[0].name).to_equal("visible")
