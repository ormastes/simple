# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/jit_any_optional_boxing_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/jit_any_optional_boxing_spec.md
# doc-path: doc/03_plan/sys_test/jit_any_optional_boxing_spec.md
# doc-path: doc/04_architecture/jit_any_optional_boxing_spec.md
# doc-path: doc/05_design/jit_any_optional_boxing_spec_oracles.md
# @manual: primary

"""
# `Any?` Slot Boxing (JIT lane)

`slot_holds_tagged_value` (mir/lower/lowering_core.rs) decides whether a
DECLARED slot holds a tagged `RuntimeValue` or a raw machine word. It
accepted a nullable `T?` -- `HirType::Pointer { inner }` -- only when
`inner` was a raw scalar, so `Pointer { inner: ANY }` was never recognised
as a tagged slot. A raw scalar stored into an `Any?` slot therefore skipped
boxing at every site the predicate governs: implicit and explicit return,
`val`/`var` binding, assignment, and the `Any` parameter path in
lowering_expr_call.rs. Non-optional `Any` was correct throughout, which is
what made this read as an `Any?`-only defect.

Pre-fix JIT ground truth, all from the fixture below: `tail=<value:0x7>`,
`flt=576601489791778816`, `bol=nil`, `arg=<value:0x5>`,
`let=<invalid-heap:0x9>`, `asg=true`.

Regression cover for round-3 item R4, follow-up to PR #138
(doc/08_tracking/bug/optional_i64_return_payload_corruption_2026-08-31.md).

**This spec must shell out.** `bin/simple test` overwrites
SIMPLE_EXECUTION_MODE to "interpret" before every child spec
(src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl), and the
interpreter was always CORRECT here -- an in-process assertion would be
green on a broken compiler. Verified: an in-process form of these same
assertions was 9/9 green on the pre-fix seed. So it runs the fixture
through `simple run` under both engines and requires the JIT lane to agree
with the interpreter AND with pinned ground truth.
Set SIMPLE_BIN to target a specific binary; default `bin/simple`.
"""
use std.spec.step

use std.spipe.*
use std.io.{process_run, env_get}


fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BIN") ?? ""
    if configured.len() > 0:
        return configured
    "bin/simple"

fn fixture_path() -> text:
    "test/fixtures/jit_differential/any_optional_boxing.spl"

fn run_engine(mode_env: text) -> text:
    val command = mode_env + " " + simple_binary() + " run " + fixture_path()
    val (stdout, stderr, _code) = process_run("/bin/sh", ["-c", command])
    stdout + stderr

fn jit_output() -> text:
    # The JIT engine must be named EXPLICITLY -- a plain `simple run`
    # inherits the runner's SIMPLE_EXECUTION_MODE=interpret and would
    # silently exercise the lane that never had the bug.
    run_engine("SIMPLE_EXECUTION_MODE=jit")

fn interp_output() -> text:
    run_engine("SIMPLE_EXECUTION_MODE=interpreter")

describe "Any? slot boxing under the JIT":
    # @manual scenario evidence

    it "boxes an int returned implicitly from an Any? function":
        # @req REQ-SSPEC-UNIT
        step("boxes an int returned implicitly from an Any? function")
        expect(jit_output()).to_contain("tail=7")

    it "boxes an int returned explicitly from an Any? function":
        # @req REQ-SSPEC-UNIT
        step("boxes an int returned explicitly from an Any? function")
        expect(jit_output()).to_contain("ret=7")

    it "boxes a float and a bool returned from an Any? function":
        # @req REQ-SSPEC-UNIT
        step("boxes a float and a bool returned from an Any? function")
        val out = jit_output()
        expect(out).to_contain("flt=2.5")
        expect(out).to_contain("bol=true")

    it "still returns nil from an Any? function":
        # @req REQ-SSPEC-UNIT
        step("still returns nil from an Any? function")
        expect(jit_output()).to_contain("nil=true")

    it "boxes an int argument passed to an Any? parameter":
        # @req REQ-SSPEC-UNIT
        step("boxes an int argument passed to an Any? parameter")
        expect(jit_output()).to_contain("arg=5")

    it "boxes an int bound to and assigned into an Any? local":
        # @req REQ-SSPEC-UNIT
        step("boxes an int bound to and assigned into an Any? local")
        val out = jit_output()
        expect(out).to_contain("let=9")
        expect(out).to_contain("asg=11")

    it "leaves non-optional Any unchanged":
        # @req REQ-SSPEC-UNIT
        step("leaves non-optional Any unchanged")
        expect(jit_output()).to_contain("plain=7")

    it "agrees with the interpreter, which was always correct here":
        # @req REQ-SSPEC-UNIT
        step("agrees with the interpreter, which was always correct here")
        expect(interp_output()).to_contain("summary=7|2.5|true|9|11|7")
        expect(jit_output()).to_contain("summary=7|2.5|true|9|11|7")
