"""
# Static factory receiver identity

Pins the small language contract behind the Stage 3 `BackendError.runtime_error`
failure: two adjacent static factories on one owner must resolve without
lowering the type name as a runtime value.
"""

use std.spec

struct UnitFactoryError:
    message: text
    code: i64

impl UnitFactoryError:
    static fn runtime_error(message: text) -> UnitFactoryError:
        UnitFactoryError(message: message, code: 17)

    static fn type_error(message: text) -> UnitFactoryError:
        UnitFactoryError(message: message, code: 23)

describe("static factory receiver identity"):
    it("keeps the owner for the runtime_error-shaped factory"):
        val error = UnitFactoryError.runtime_error("runtime")
        expect(error.message).to_equal("runtime")
        expect(error.code).to_equal(17)

    it("keeps the owner for an adjacent static factory"):
        val error = UnitFactoryError.type_error("typed")
        expect(error.message).to_equal("typed")
        expect(error.code).to_equal(23)
