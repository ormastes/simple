# Authored source controls. UNRUN during Phase3 producer watch.
use std.spec.{describe, it, expect}
use compiler.mir.mir_data.*
use compiler.mir.source_region_operation_plan_types_v1.*
use compiler.mir.source_region_dictionary_site_types_v1.*
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId}
use compiler.mir.source_region_instruction_rebase_types_v1.*
use compiler.mir.source_region_instruction_rebase_v1.*
use compiler.common.loop_resource_account_v1.*
use compiler.common.diagnostics.span.{Span}

fn rebase_local_fixture_v1(id: i64, type_: MirType = MirType.i64()) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: LocalKind.Temp, is_ghost: false)

fn rebase_plan_fixture_v1(first: i64) -> SourceRegionInstructionPlanV1:
    SourceRegionInstructionPlanV1(locals: [rebase_local_fixture_v1(first)], next_local: first + 1,
        steps: [SourceRegionOperationPlanV1(prelude: [MirInst(kind: MirInstKind.Cast(LocalId(id: first), mir_operand_copy(LocalId(id: 0)), MirType.i64()), span: nil)],
            facade: mir_operand_const_int(123), args: [mir_operand_copy(LocalId(id: first))], result_type: MirType.i64(),
            destination: Some(LocalId(id: first)), success: [MirInst(kind: MirInstKind.Copy(LocalId(id: 0), LocalId(id: first)), span: nil)])])

describe "typed SOURCE plan alpha conversion":
    it "preserves original locals while interleaved unwrap temps change actual allocation":
        val account = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        val stable = [rebase_local_fixture_v1(0)]
        val actual = [rebase_local_fixture_v1(0), rebase_local_fixture_v1(1), rebase_local_fixture_v1(2), rebase_local_fixture_v1(3)]
        val prior = [SourceRegionPlanLocalBindingV1(planned: LocalId(id: 1), actual: LocalId(id: 2), type_: MirType.i64())]
        val result = source_region_instruction_plan_rebase_v1(rebase_plan_fixture_v1(2), stable, prior, actual, 4, account).unwrap()
        expect(result.next_local).to_equal(5)
        expect(result.plan.locals[0].id.id).to_equal(4)
        expect(result.bindings[0].actual.id).to_equal(2)
        expect(result.bindings[1].planned.id).to_equal(2)
        expect(result.bindings[1].actual.id).to_equal(4)
        match result.plan.steps[0].success[0].kind:
            case MirInstKind.Copy(destination, source):
                expect(destination.id).to_equal(0)
                expect(source.id).to_equal(4)
            case _: assert(false)

    it "rejects prior mappings that alias a stable local":
        val account = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        val stable = [rebase_local_fixture_v1(0)]
        val prior = [SourceRegionPlanLocalBindingV1(planned: LocalId(id: 1), actual: LocalId(id: 0), type_: MirType.i64())]
        expect(source_region_instruction_plan_rebase_v1(rebase_plan_fixture_v1(2), stable, prior, stable, 1, account).is_err()).to_equal(true)

    it "rejects mismatched actual stable types":
        val account = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        expect(source_region_instruction_plan_rebase_v1(rebase_plan_fixture_v1(1), [rebase_local_fixture_v1(0)], [],
            [rebase_local_fixture_v1(0, MirType.bool())], 1, account).is_err()).to_equal(true)

    it "rejects unknown block-bearing or effect instruction variants":
        val account = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        var plan = rebase_plan_fixture_v1(1)
        plan.steps[0].prelude = [MirInst(kind: MirInstKind.Store(mir_operand_copy(LocalId(id: 0)), mir_operand_const_int(9)), span: nil)]
        val stable = [rebase_local_fixture_v1(0)]
        expect(source_region_instruction_plan_rebase_v1(plan, stable, [], stable, 1, account).is_err()).to_equal(true)

    it "rejects an unbound source local":
        val account = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        var plan = rebase_plan_fixture_v1(1)
        plan.steps[0].args = [mir_operand_copy(LocalId(id: 99))]
        val stable = [rebase_local_fixture_v1(0)]
        expect(source_region_instruction_plan_rebase_v1(plan, stable, [], stable, 1, account).is_err()).to_equal(true)

    it "accepts an identity plan after live read materialization and refuses ordinary rebase of its debt":
        val account = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        val key = HirType(kind: HirTypeKind.Int(64, true), span: nil)
        val value = HirType(kind: HirTypeKind.Named(SymbolId(id: 44), []), span: nil)
        val descriptor = SourceRegionDictionaryDescriptorV1(key_type: key, value_type: value, value_owner: SymbolId(id: 44),
            value_codec: SourceRegionDictionaryCodecV1.OrdinaryStruct, value_layout_identity: "fixture.Child", value_layout_digest: "resolved-layout")
        val emitted = MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 0)), "source_region_dictionary_get_v1", [mir_operand_copy(LocalId(id: 0))]), span: nil)
        val site = SourceRegionDictionarySiteV1(owner: SymbolId(id: 5), block: BlockId(id: 0), instruction_index: 0,
            operation: SourceRegionDictionaryOperationV1.Read, dictionary_local: LocalId(id: 0), result_local: Some(LocalId(id: 0)),
            key_local: Some(LocalId(id: 0)), value_local: nil, key_type: key, value_type: value, descriptor: descriptor,
            key_codec: SourceRegionDictionaryCodecV1.RawI64, emitted: emitted, read_kind: Some(SourceRegionDictionaryReadKindV1.Optional))
        val step = SourceRegionOperationPlanV1(prelude: [], facade: mir_operand_const_int(16),
            args: [mir_operand_copy(LocalId(id: 0)), mir_operand_copy(LocalId(id: 1)), mir_operand_copy(LocalId(id: 0)), mir_operand_copy(LocalId(id: 0))],
            result_type: MirType.i64(), destination: Some(LocalId(id: 0)), success: [], dictionary_read: Some(site),
            success_type: Some(HirType(kind: HirTypeKind.Optional(key), span: nil)), callee_symbol: Some(SymbolId(id: 16)))
        val actual = [rebase_local_fixture_v1(0), rebase_local_fixture_v1(1)]
        val plan = SourceRegionInstructionPlanV1(steps: [step], locals: [], next_local: 2)
        # Structural input fixture only: actual epoch authority is deliberately
        # outside this pure test and remains the production caller's obligation.
        val checked = source_region_dictionary_read_plan_identity_v1(plan, step, actual, 2, account).unwrap()
        expect(checked.plan.steps[0].dictionary_read.unwrap().owner.id).to_equal(5)
        expect(checked.next_local).to_equal(2)
        expect(source_region_instruction_plan_rebase_v1(plan, actual, [], actual, 2, account).is_err()).to_equal(true)
        var altered = step
        altered.args = [mir_operand_copy(LocalId(id: 0)), mir_operand_copy(LocalId(id: 0)), mir_operand_copy(LocalId(id: 0)), mir_operand_copy(LocalId(id: 0))]
        expect(source_region_dictionary_read_plan_identity_v1(plan, altered, actual, 2, account).is_err()).to_equal(true)

        # Filename equality is variable work even for an otherwise fixed HIR
        # shape. Exercise the public read path with an actual nonempty span.
        val filename = "source/retained/compiler/fixture/dictionary/read/long_source_filename.spl"
        val span = Span(start: 0, end: 1, line: 1, col: 1, file: filename, length: 1)
        val spanned_key = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val spanned_value = HirType(kind: HirTypeKind.Named(SymbolId(id: 44), []), span: span)
        var spanned_descriptor = descriptor
        spanned_descriptor.key_type = spanned_key
        spanned_descriptor.value_type = spanned_value
        var spanned_site = site
        spanned_site.key_type = spanned_key
        spanned_site.value_type = spanned_value
        spanned_site.descriptor = spanned_descriptor
        spanned_site.emitted = MirInst(kind: emitted.kind, span: Some(span))
        var spanned_step = step
        spanned_step.dictionary_read = Some(spanned_site)
        spanned_step.success_type = Some(HirType(kind: HirTypeKind.Optional(spanned_key), span: span))
        val spanned_plan = SourceRegionInstructionPlanV1(steps: [spanned_step], locals: [], next_local: 2)
        val funded = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1()).unwrap()
        val spanned = source_region_dictionary_read_plan_identity_v1(spanned_plan, spanned_step, actual, 2, funded).unwrap()
        expect(spanned.plan.steps[0].dictionary_read.unwrap().key_type.span.file).to_equal(filename)

        val limited = MirLoopResourceAccountV1.create(MirLoopResourceLimitsV1(max_work: 200)).unwrap()
        val before = limited.snapshot()
        val diagnostic = match source_region_dictionary_read_plan_identity_v1(spanned_plan, spanned_step, actual, 2, limited):
            case Err(message): message
            case Ok(_): "accepted underfunded span equality"
        expect(diagnostic).to_equal("SOURCE-PIN-CAPACITY: invocation verifier budget exhausted")
        # Begin13 + step64 + span8 + filename-count1 are paid. The filename
        # comparison bound exceeds the remaining94 and must not debit it.
        expect(limited.snapshot().work_used).to_equal(before.work_used + 86)
        expect(limited.snapshot().state_fields).to_equal(before.state_fields + 1)
        expect(limited.snapshot().output_bytes).to_equal(before.output_bytes + 8)
