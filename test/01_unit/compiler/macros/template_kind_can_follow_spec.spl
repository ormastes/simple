# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




# Regression spec for the `kind_can_follow` unresolved-call family member.
#
# doc/08_tracking/bug/stage3_unresolved_call_warning_family_2026-08-07.md
# §3/§4: `macro_check/template.spl` called the bare free function
# `kind_can_follow(kind, prev_kind)` with no definition anywhere in the tree
# (mechanism B — the `impl X:` -> free-function refactor dropped the body).
# This spec proves the function now resolves and behaves sanely.

use std.spec.step

use compiler.semantics.macro_check.template.{FragmentKind, kind_can_follow}

describe "kind_can_follow":
    # @manual scenario evidence
    it "allows any fragment kind to start a matcher (no previous kind)":
        # @req REQ-SSPEC-COMPILER
        step("allows any fragment kind to start a matcher (no previous kind)")
        kind_can_follow(FragmentKind.Expr, nil) == true

    it "forbids anything from directly following an expr fragment":
        # @req REQ-SSPEC-COMPILER
        step("forbids anything from directly following an expr fragment")
        kind_can_follow(FragmentKind.Ident, FragmentKind.Expr) == false

    it "forbids anything from directly following a stmt fragment":
        # @req REQ-SSPEC-COMPILER
        step("forbids anything from directly following a stmt fragment")
        kind_can_follow(FragmentKind.Ident, FragmentKind.Stmt) == false

    it "allows a fragment to follow an unambiguous fragment kind":
        # @req REQ-SSPEC-COMPILER
        step("allows a fragment to follow an unambiguous fragment kind")
        kind_can_follow(FragmentKind.Ident, FragmentKind.Ty) == true
