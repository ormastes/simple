# Purpose and audience: regression spec for bare payload-variant arms over a known enum.
# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/match_unqualified_imported_enum_variant_default_arms_2026-10-24.md

use std.spec

enum ProcKind:
    Comb(sens: [text])
    Clocked(dom: text)
    Async(dom: text)

fn name_of(k: ProcKind) -> text:
    match k:
        case Comb: "comb"
        case Clocked: "clocked"
        case Async: "async"

describe("bare payload-variant arms"):
    it("are variant tests, not multiple default arms"):
        assert_equal(name_of(ProcKind.Comb([])), "comb")
        assert_equal(name_of(ProcKind.Clocked("c")), "clocked")
        assert_equal(name_of(ProcKind.Async("c")), "async")

fn qualified_name_of(k: ProcKind) -> text:
    match k:
        case ProcKind.Comb: "comb"
        case ProcKind.Clocked: "clocked"
        case ProcKind.Async: "async"

fn with_default(k: ProcKind) -> text:
    match k:
        case Clocked: "clocked"
        case _: "other"

fn nested(a: ProcKind, b: ProcKind) -> text:
    match a:
        case Comb:
            match b:
                case Clocked: "comb-clocked"
                case _: "comb-other"
        case _: "none"

describe("bare payload-variant arms: prevention"):
    it("qualified arms still match payload variants"):
        assert_equal(qualified_name_of(ProcKind.Clocked("c")), "clocked")
        assert_equal(qualified_name_of(ProcKind.Comb([])), "comb")
    it("mix with a default arm"):
        assert_equal(with_default(ProcKind.Clocked("c")), "clocked")
        assert_equal(with_default(ProcKind.Async("c")), "other")
    it("nested matches"):
        assert_equal(nested(ProcKind.Comb([]), ProcKind.Clocked("c")), "comb-clocked")
        assert_equal(nested(ProcKind.Comb([]), ProcKind.Async("c")), "comb-other")
        assert_equal(nested(ProcKind.Async("c"), ProcKind.Async("c")), "none")
