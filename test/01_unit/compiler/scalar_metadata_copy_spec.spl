use std.spec

extern fn rt_file_read_text(path: text) -> text?

describe("scalar-keyed metadata copy"):
    it("binds the array-copy path to the source-first scalar helper"):
        val statements = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        val types = rt_file_read_text(
            "src/compiler/50.mir/mir_lowering_types.spl") ?? ""

        expect(statements).to_contain(
            "self.copy_local_hir_type_metadata(init_local.id, result_arr.id)")
        expect(statements.contains(
            "self.remember_local_hir_type(result_arr.id, init_hir_type")).to_be(false)
        expect(types).to_contain(
            "me copy_local_hir_type_metadata(source_local_id: i64, destination_local_id: i64)")
        expect(types).to_contain("if source_type == nil or source_type == 0:")
        expect(types).to_contain(
            "resource_states[destination_index] = resource_states[source_index]")
