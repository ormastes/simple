use std.spec
use compiler.common.assurance.policy_schema.{ResolvedAssurancePolicyV1}
use compiler.common.assurance.schema_migration.{FV2_POLICY_SCHEMA_V1,
    FV2_POLICY_SCHEMA_V2, PolicySchemaMigrationRequestV1,
    PolicySchemaCacheV1, migrate_policy_schema_v1_to_v2,
    migrate_policy_cache_v1_to_v2}

fn migration_request(
    policy: ResolvedAssurancePolicyV1,
    source_version: text = FV2_POLICY_SCHEMA_V1,
    target_version: text = FV2_POLICY_SCHEMA_V2,
    cached_policy_hash: text = "exact"
) -> PolicySchemaMigrationRequestV1:
    val policy_hash = policy.policy_hash()
    PolicySchemaMigrationRequestV1(source_version, target_version, policy_hash,
        if cached_policy_hash == "exact": policy_hash else: cached_policy_hash)

describe "FV2 frozen assurance schema migration":
    it "migrates exact V1 policy state and proves old-cache invalidation":
        val policy = ResolvedAssurancePolicyV1.default()
        val request = migration_request(policy)
        val old_cache = PolicySchemaCacheV1(FV2_POLICY_SCHEMA_V1,
            policy.policy_hash())
        val migrated = migrate_policy_cache_v1_to_v2(policy, old_cache, request)
        val receipt = migrated.receipt
        expect(receipt.passed()).to_be(true)
        expect(receipt.source_policy_hash).to_equal(policy.policy_hash())
        expect(receipt.invalidated_cache_hash).to_equal(policy.policy_hash())
        expect(receipt.replacement_cache_hash).to_equal(receipt.target_policy_hash)
        expect(receipt.target_policy_hash == policy.policy_hash()).to_be(false)
        expect(migrated.cache.contains(FV2_POLICY_SCHEMA_V1,
            policy.policy_hash())).to_be(false)
        expect(migrated.cache.contains(FV2_POLICY_SCHEMA_V2,
            receipt.target_policy_hash)).to_be(true)

    it "leaves owner cache state unchanged when no exact entry can be invalidated":
        val policy = ResolvedAssurancePolicyV1.default()
        val cache = PolicySchemaCacheV1(FV2_POLICY_SCHEMA_V1, "APOLV1-other")
        val result = migrate_policy_cache_v1_to_v2(policy, cache,
            migration_request(policy))
        expect(result.receipt.accepted).to_be(false)
        expect(result.receipt.diagnostic).to_contain("CACHE-OWNER")
        expect(result.cache.schema_version).to_equal(cache.schema_version)
        expect(result.cache.policy_hash).to_equal(cache.policy_hash)

    it "rejects an unversioned migration request":
        val policy = ResolvedAssurancePolicyV1.default()
        val receipt = migrate_policy_schema_v1_to_v2(policy,
            migration_request(policy, source_version: ""))
        expect(receipt.accepted).to_be(false)
        expect(receipt.diagnostic).to_contain("UNVERSIONED")
        expect(receipt.receipt_hash).to_equal("")

    it "rejects incompatible source or target schemas":
        val policy = ResolvedAssurancePolicyV1.default()
        val wrong_source = migrate_policy_schema_v1_to_v2(policy,
            migration_request(policy, source_version: "ResolvedAssurancePolicyV0"))
        val wrong_target = migrate_policy_schema_v1_to_v2(policy,
            migration_request(policy, target_version: "ResolvedAssurancePolicyV3"))
        expect(wrong_source.diagnostic).to_contain("INCOMPATIBLE")
        expect(wrong_target.diagnostic).to_contain("INCOMPATIBLE")

    it "rejects source identity drift and stale cache state":
        val policy = ResolvedAssurancePolicyV1.default()
        var wrong_hash_request = migration_request(policy)
        wrong_hash_request.source_policy_hash = "APOLV1-wrong"
        val wrong_hash = migrate_policy_schema_v1_to_v2(policy,
            wrong_hash_request)
        val stale_cache = migrate_policy_schema_v1_to_v2(policy,
            migration_request(policy, cached_policy_hash: "APOLV1-stale"))
        expect(wrong_hash.diagnostic).to_contain("SOURCE-HASH")
        expect(stale_cache.diagnostic).to_contain("STALE-CACHE")
        expect(stale_cache.stale_cache_invalidated).to_be(false)
        expect(stale_cache.replacement_cache_hash).to_equal("")
