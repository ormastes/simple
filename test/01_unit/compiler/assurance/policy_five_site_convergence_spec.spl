# @cover src/compiler/00.common/assurance/policy_names.spl
# @cover src/compiler/00.common/assurance/policy.spl
#
# WP-3 ORACLE — five-site profile-table convergence.
#
# Plan: doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE PROVES, AND WHAT IT CANNOT
# ---------------------------------------------------------------------------
# The plan's stated criterion is "lint/check/build/run/test resolve an
# identical policy hash". That criterion is NOT provable at the PROCESS
# boundary in this tree: `bin/simple` is the Rust seed (plan premise #0.2), so
# `bin/simple run` never executes handler_commands.spl at all. Cross-COMMAND
# hash agreement is therefore UNVERIFIED and this file does not claim it.
#
# What is provable, and what this file does, is agreement at the FUNCTION
# boundary under the interpreter: it imports the profile-resolving function of
# each of the five call sites FROM THAT SITE'S OWN MODULE and asserts, over the
# WHOLE accepted-spelling table plus rejects, that all five derive the same
# canonical name.
#
# The import path is the falsifiability mechanism. `normalize_profile_name` is
# imported from `std.test_runner.test_runner_args`, not from policy_names — so
# if a future edit re-adds a local copy of the table at that site, this spec
# drives the COPY and goes red. Same for `_run_normalize_profile_name`,
# `safety_pass_severity_for_name`, `parse_lint_profile` and
# `match_fallthrough_profile_is_deny`. A spec that called the canonical
# function five times would be vacuous.
#
# The expected mapping below is written out longhand ON PURPOSE. It is the
# assertion, not a sixth copy of the table: if someone changes policy_names.spl
# alone, this file goes red and states which spelling moved.
#
# ---------------------------------------------------------------------------
# THREE PROJECTIONS, NOT ONE
# ---------------------------------------------------------------------------
# The same four names carry three DIFFERENT meanings and WP-3 deliberately did
# not flatten them: lint -> a level dict, driver -> SafetyPassSeverity,
# interpreter -> a bool. Each projection is asserted against the canonical name
# separately, so converging the names cannot silently converge the semantics.

use std.spec

# --- the canonical table + the typed resolver -------------------------------
use compiler.common.assurance.policy_names.{
    deprecated_profile_alias_replacement, is_known_profile_name,
    all_accepted_profile_spellings, canonical_profile_names
}
use compiler.common.assurance.policy.{
    policy_for_profile_name, resolve_assurance_policy, policy_would_weaken,
    policy_env_value, profile_name_is_at_least
}
use compiler.common.assurance.policy_schema.{
    AssuranceStrictness, ResolvedAssurancePolicyV1
}

# --- the five SITES, each imported from its own module ----------------------
# test-runner site (also supplies `normalize_profile_name`, deliberately NOT
# imported from policy_names -- see the falsifiability note above)
use std.test_runner.test_runner_args.{normalize_profile_name, valid_profile_names_help}
# `run` site
use app.io.cli_commands.{_run_normalize_profile_name, _run_valid_profile_names_help}
# driver site
use compiler.driver.driver_safety_severity.{
    SafetyPassSeverity, safety_pass_severity_for_name,
    safety_pass_severity_for_policy
}
# lint site
use compiler.tools.lint.main.{parse_lint_profile, LintProfile, profile_default_levels}
# interpreter site
use compiler.core.interpreter.eval_decls.{
    match_fallthrough_profile_is_deny, eval_apply_assurance_profile
}
use compiler.core.interpreter.eval_tables.{
    match_fallthrough_get_abort, match_wildcard_catch_get_enabled
}
use compiler.core.interpreter.module_loader_core.{import_admission_get_deny}

# The assertion table, longhand. "" means "not an accepted profile name".
fn expected_canonical(spelling: text) -> text:
    if spelling == "moderate": return "moderate"
    if spelling == "strict": return "strict"
    if spelling == "robust": return "robust"
    if spelling == "critical": return "critical"
    if spelling == "verified": return "verified"
    if spelling == "lib": return "strict"
    if spelling == "reliable": return "robust"
    if spelling == "mission-critical": return "critical"
    if spelling == "mission_critical": return "critical"
    ""

# Every accepted spelling PLUS strings that must stay rejected. Near-misses
# ("reliabl") are included because a sloppy prefix match would accept them.
fn probe_spellings() -> [text]:
    ["moderate", "strict", "robust", "critical", "verified",
     "lib", "reliable", "mission-critical", "mission_critical",
     "MODERATE", "Critical", "Mission-Critical",
     "", "bogus", "reliabl", "criticall", "mission critical"]

# Case-insensitive expectation for the mixed-case probes.
fn expected_canonical_ci(spelling: text) -> text:
    expected_canonical(spelling.lower())

# The driver's projection, expressed as a function of the CANONICAL name.
fn expected_severity(canonical: text) -> SafetyPassSeverity:
    if canonical == "critical" or canonical == "verified": return SafetyPassSeverity.Deny
    if canonical == "robust": return SafetyPassSeverity.Warn
    SafetyPassSeverity.Advisory

# V1 engineering projections cannot serialize the FV2 proof-closure rung.
# They conservatively enforce it as critical; only PolicyV2 retains `verified`
# for formal release evidence.
fn expected_v1_projection(canonical: text) -> text:
    if canonical == "verified": return "critical"
    canonical

# lint's projection, read back as a canonical name so it is comparable.
fn lint_site_canonical(spelling: text) -> text:
    match parse_lint_profile(spelling):
        case Some(p):
            match p:
                case Moderate: "moderate"
                case Strict: "strict"
                case Robust: "robust"
                case Critical: "critical"
        case nil:
            ""

describe "WP-3: all five profile call sites derive one canonical name":

    it "the canonical table lists exactly the five rungs, strictness-ascending":
        step("canonical_profile_names is the ladder, not a set")
        expect(canonical_profile_names()).to_equal(["moderate", "strict", "robust", "critical", "verified"])

    it "all_accepted_profile_spellings covers every spelling the sites accept":
        step("anything the sites accept must be enumerated, or the sweep below is partial")
        for s in all_accepted_profile_spellings():
            expect(expected_canonical(s)).to_not_equal("")
        expect(all_accepted_profile_spellings().len()).to_equal(9)

    # --- SITE 1: test runner ------------------------------------------------
    it "test-runner site (normalize_profile_name) matches the table":
        for s in probe_spellings():
            expect(normalize_profile_name(s)).to_equal(expected_canonical_ci(s))

    # --- SITE 2: run --------------------------------------------------------
    it "run site (_run_normalize_profile_name) matches the table":
        for s in probe_spellings():
            expect(_run_normalize_profile_name(s)).to_equal(expected_canonical_ci(s))

    it "run and test-runner print the SAME help text":
        expect(_run_valid_profile_names_help()).to_equal(valid_profile_names_help())

    # --- SITE 3: driver -----------------------------------------------------
    it "driver site (safety_pass_severity_for_name) projects the table onto SafetyPassSeverity":
        for s in probe_spellings():
            expect(safety_pass_severity_for_name(s)).to_equal(expected_severity(expected_canonical_ci(s)))

    it "driver's env path and its TYPED-policy path agree for every spelling":
        step("safety_pass_severity_for_name(s) == safety_pass_severity_for_policy(policy_for_profile_name(s))")
        for s in probe_spellings():
            expect(safety_pass_severity_for_name(s))
                .to_equal(safety_pass_severity_for_policy(policy_for_profile_name(s)))

    # --- SITE 4: lint -------------------------------------------------------
    it "lint site (parse_lint_profile) matches the table":
        for s in probe_spellings():
            expect(lint_site_canonical(s)).to_equal(
                expected_v1_projection(expected_canonical_ci(s)))

    it "lint REJECTS every non-accepted spelling (explicit predicate, not an Option truthiness test)":
        step("is_some() is the predicate; `if opt:` would take the present branch on a miss")
        expect(parse_lint_profile("bogus").is_some()).to_equal(false)
        expect(parse_lint_profile("reliabl").is_some()).to_equal(false)
        expect(parse_lint_profile("").is_some()).to_equal(false)
        expect(is_known_profile_name("bogus")).to_equal(false)
        expect(is_known_profile_name("")).to_equal(false)

    it "lint's LEVEL projection is preserved, not flattened into the name table":
        step("deprecated spellings land on the SAME level dict as their canonical name")
        expect(profile_default_levels(LintProfile.Critical)["bare_primitive_internal"]).to_equal("warn")
        expect(profile_default_levels(LintProfile.Robust)["primitive_api"]).to_equal("deny")
        expect(profile_default_levels(LintProfile.Moderate)["primitive_api"]).to_not_equal("deny")

    # --- SITE 5: interpreter ------------------------------------------------
    it "interpreter site (match_fallthrough_profile_is_deny) projects the table onto a bool":
        step("only `critical` denies; robust/reliable stay warn-only")
        for s in probe_spellings():
            expect(match_fallthrough_profile_is_deny(s)).to_equal(expected_canonical_ci(s) == "critical")

describe "WP-3: the interpreter no longer LATCHES the profile at eval_init":

    # Premise 5b: eval_init read SIMPLE_SAFETY_PROFILE inline, so the
    # interpreter could never observe a policy resolved later in the session.
    # eval_apply_assurance_profile makes the flags follow a passed value.
    it "applying a critical policy after init turns the abort flags ON":
        eval_apply_assurance_profile(policy_env_value(policy_for_profile_name("critical")))
        expect(match_fallthrough_get_abort()).to_equal(true)
        expect(match_wildcard_catch_get_enabled()).to_equal(true)

    it "applying a moderate policy after that turns them back OFF (no latch)":
        eval_apply_assurance_profile(policy_env_value(policy_for_profile_name("moderate")))
        expect(match_fallthrough_get_abort()).to_equal(false)
        expect(match_wildcard_catch_get_enabled()).to_equal(false)

    it "a deprecated spelling reaches the interpreter through the shared table":
        eval_apply_assurance_profile("mission_critical")
        expect(match_fallthrough_get_abort()).to_equal(true)
        eval_apply_assurance_profile("robust")
        expect(match_fallthrough_get_abort()).to_equal(false)

    it "WP-10: applying critical also flips import admission to fail-closed":
        eval_apply_assurance_profile(policy_env_value(policy_for_profile_name("critical")))
        expect(import_admission_get_deny()).to_equal(true)
        eval_apply_assurance_profile(policy_env_value(policy_for_profile_name("moderate")))
        expect(import_admission_get_deny()).to_equal(false)

    it "WP-10: robust does NOT flip import admission (critical-only, same rung as match-fallthrough deny)":
        eval_apply_assurance_profile(policy_env_value(policy_for_profile_name("robust")))
        expect(import_admission_get_deny()).to_equal(false)
        eval_apply_assurance_profile(policy_env_value(policy_for_profile_name("strict")))
        expect(import_admission_get_deny()).to_equal(false)

describe "WP-3: precedence is raise-only (fail-closed)":

    it "CLI RAISES a project pinned to moderate":
        val p = resolve_assurance_policy("moderate", "critical", "", "", "", "")
        expect(p.strictness.name()).to_equal("critical")

    it "CLI CANNOT lower a project pinned to robust":
        val p = resolve_assurance_policy("robust", "moderate", "", "", "", "")
        expect(p.strictness.name()).to_equal("robust")

    it "CLI CANNOT lower a project pinned to critical, nor can the env var":
        expect(resolve_assurance_policy("critical", "strict", "", "", "", "").strictness.name())
            .to_equal("critical")
        expect(resolve_assurance_policy("critical", "", "moderate", "", "", "").strictness.name())
            .to_equal("critical")

    it "an unknown or empty input never lowers a pin":
        expect(resolve_assurance_policy("critical", "bogus", "", "", "", "").strictness.name())
            .to_equal("critical")
        expect(resolve_assurance_policy("robust", "", "", "", "", "").strictness.name())
            .to_equal("robust")

    it "an unconfigured resolve equals the frozen default policy hash":
        val p = resolve_assurance_policy("", "", "", "", "", "")
        expect(p.policy_hash()).to_equal(ResolvedAssurancePolicyV1.default().policy_hash())

    it "policy_would_weaken is an explicit bool predicate in both directions":
        val pinned = policy_for_profile_name("robust")
        expect(policy_would_weaken(pinned, policy_for_profile_name("moderate"))).to_equal(true)
        expect(policy_would_weaken(pinned, policy_for_profile_name("robust"))).to_equal(false)
        expect(policy_would_weaken(pinned, policy_for_profile_name("critical"))).to_equal(false)

    it "profile_name_is_at_least agrees with the ladder":
        expect(profile_name_is_at_least("critical", "robust")).to_equal(true)
        expect(profile_name_is_at_least("robust", "critical")).to_equal(false)
        expect(profile_name_is_at_least("mission-critical", "robust")).to_equal(true)
        expect(profile_name_is_at_least("robust", "not-a-rung")).to_equal(false)

describe "WP-3: SIMPLE_SAFETY_PROFILE is subprocess serialization only":

    it "policy_env_value emits the CANONICAL name, never a deprecated alias":
        step("a child process must not have to re-run the alias table or re-warn")
        for s in all_accepted_profile_spellings():
            expect(policy_env_value(policy_for_profile_name(s))).to_equal(
                expected_v1_projection(expected_canonical(s)))
            expect(deprecated_profile_alias_replacement(policy_env_value(policy_for_profile_name(s))))
                .to_equal("")

    it "the env value round-trips to an IDENTICAL policy hash":
        step("this is the parent/child half of the plan's identical-hash criterion")
        for s in all_accepted_profile_spellings():
            val parent = policy_for_profile_name(s)
            val child = resolve_assurance_policy("", "", policy_env_value(parent), "", "", "")
            expect(child.policy_hash()).to_equal(parent.policy_hash())

    it "policy hashes DIFFER between rungs (the hash is not a constant)":
        step("without this the round-trip test above would pass vacuously")
        expect(policy_for_profile_name("critical").policy_hash())
            .to_not_equal(policy_for_profile_name("moderate").policy_hash())
        expect(policy_for_profile_name("robust").policy_hash())
            .to_not_equal(policy_for_profile_name("strict").policy_hash())
