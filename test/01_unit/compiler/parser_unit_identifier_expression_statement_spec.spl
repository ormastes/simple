# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

# @cover src/compiler_rust/parser/src/parser_impl/core.rs 0%
"""
# `unit` as an identifier at the start of an expression statement

**Category:** Language / Parser
**Status:** Regression guard

## Purpose and Audience

Bug: doc/08_tracking/bug/db/unit_identifier_expression_statement_parse_error_2026-11-26.sdn
The Rust seed lexer maps `unit` to `TokenKind::Unit`. Statement dispatch in
src/compiler_rust/parser/src/parser_impl/core.rs used an allow-list
(assignment ops, `.`, `[`) to decide that a statement starting with `unit`
was an assignment to a variable named `unit`; every other follow token —
`==`, `+`, `(`, newline — fell into the unit-DECLARATION parser, so
`fn f(unit: text) -> bool:` with body `unit == "px"` died with
`expected identifier, found Eq`. The fix inverts the gate: parse_unit is
entered only when an identifier directly follows `unit` (a declaration is
always `unit <Name> ...`); everything else is an expression statement.

The audience is anyone touching statement dispatch in the Rust seed parser.

## Scope and Preconditions

Expression statements that start with a variable named `unit`: bare
comparisons, arithmetic, and calls, at function-body statement start.
Requires a seed built with the inverted `TokenKind::Unit` statement dispatch
(fix for the bug above); on an older seed this file itself fails to parse
with `expected identifier, found Eq`.

## Primary Workflow

Name a parameter or variable `unit`, use it in every statement-start
expression form, and check the resulting values.
"""

use std.spec.step

use std.spec.*

fn suffix_is_px(unit: text) -> bool:
    unit == "px"

fn bump(unit: i64) -> i64:
    unit + 1

fn apply(unit: fn(i64) -> i64) -> i64:
    unit(21)

fn double(x: i64) -> i64:
    return x * 2

describe "unit as an identifier at expression-statement start":
    # @manual scenario evidence

    it "evaluates the doc shape unit == \"px\" as the function result":
        # @req REQ-SSPEC-COMPILER
        step("evaluates the doc shape unit == \"px\" as the function result")
        expect(suffix_is_px("px")).to_equal(true)  # oracle: true — "px" == "px"
        expect(suffix_is_px("em")).to_equal(false)  # oracle: false — "em" != "px"

    it "evaluates a unit + 1 statement as the function result":
        # @req REQ-SSPEC-COMPILER
        step("evaluates a unit + 1 statement as the function result")
        expect(bump(41)).to_equal(42)  # oracle: 42 — 41 + 1

    it "evaluates a unit(...) call statement as the function result":
        # @req REQ-SSPEC-COMPILER
        step("evaluates a unit(...) call statement as the function result")
        expect(apply(double)).to_equal(42)  # oracle: 42 — double(21)
