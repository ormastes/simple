"""ACOWN03/ACBOR01/ACBOR02: facts must originate in actual MIR instructions."""

use std.spec
use compiler.borrow.borrow_check.mod.{BorrowCheckResult, create_borrow_checker}
use compiler.mir.mir_instruction_graph.{MirBody, MirBlock, MirInst}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator, MirOperand, MirBorrowKind, MirPlace, AggregateKind, mir_operand_copy, mir_operand_move}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirLocal, LocalKind}

fn adapter_spec_local(id: i64, type_: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: LocalKind.Temp, is_ghost: false)

fn adapter_spec_accepts(kinds: [MirInstKind], result: MirOperand? = nil, scalar_result: bool = false) -> bool:
    var instructions: [MirInst] = []
    for kind in kinds:
        instructions = instructions.push(MirInst(kind: kind, span: nil))
    val block = MirBlock(id: BlockId(id: 23), label: nil, instructions: instructions, terminator: MirTerminator.Ret(result))
    val reference_type = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
    val result_type = if scalar_result: MirType.i64() else: reference_type
    val source_reference_type = MirType(kind: MirTypeKind.Ref(result_type, false))
    val locals = [adapter_spec_local(0, result_type), adapter_spec_local(1, source_reference_type), adapter_spec_local(2, result_type), adapter_spec_local(3, reference_type), adapter_spec_local(4, MirType.i64()), adapter_spec_local(9, reference_type)]
    val body = MirBody(name: "adapter-spec", blocks: [block], locals: locals, arg_count: 0, return_ty: MirType.i64(), nogc_strict: true)
    var checker = create_borrow_checker()
    match checker.check_function(body, 23):
        case BorrowCheckResult.Ok: true
        case BorrowCheckResult.Errors(_): false

fn adapter_spec_ref() -> MirInstKind:
    MirInstKind.Ref(LocalId(id: 1), MirBorrowKind.Shared, MirPlace(local: LocalId(id: 0), projection: []))

describe "typed MIR ownership adapter":
    it "ACBOR01 returns a loaded scalar independently of its source borrow":
        val accepted = adapter_spec_accepts([
            adapter_spec_ref(),
            MirInstKind.Load(LocalId(id: 2), mir_operand_copy(LocalId(id: 1)))
        ], Some(mir_operand_copy(LocalId(id: 2))), true)
        expect(accepted).to_equal(true)

    it "ACBOR01 preserves a reference-valued loaded result's loan":
        val accepted = adapter_spec_accepts([
            adapter_spec_ref(),
            MirInstKind.Load(LocalId(id: 2), mir_operand_copy(LocalId(id: 1)))
        ], Some(mir_operand_copy(LocalId(id: 2))))
        expect(accepted).to_equal(false)

    it "ACOWN03 records a move into an aggregate before a later reuse":
        val accepted = adapter_spec_accepts([
            MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Tuple, [mir_operand_move(LocalId(id: 0))]),
            MirInstKind.DebugValue(LocalId(id: 0), "reused")
        ])
        expect(accepted).to_equal(false)

    it "ACBOR01 retains borrow provenance through aggregate construction and projection":
        val accepted = adapter_spec_accepts([
            adapter_spec_ref(),
            MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Tuple, [mir_operand_copy(LocalId(id: 1))]),
            MirInstKind.GetField(LocalId(id: 3), mir_operand_copy(LocalId(id: 2)), 0)
        ], Some(mir_operand_copy(LocalId(id: 3))))
        expect(accepted).to_equal(false)

    it "ACBOR02 rejects a borrowed spawn argument":
        val accepted = adapter_spec_accepts([
            adapter_spec_ref(),
            MirInstKind.Spawn(LocalId(id: 2), mir_operand_copy(LocalId(id: 9)), [mir_operand_copy(LocalId(id: 1))])
        ])
        expect(accepted).to_equal(false)

    it "ACBOR02 allows a borrow whose last use precedes suspension":
        val accepted = adapter_spec_accepts([
            adapter_spec_ref(),
            MirInstKind.DebugValue(LocalId(id: 1), "last use"),
            MirInstKind.Await(LocalId(id: 2), mir_operand_copy(LocalId(id: 9)))
        ])
        expect(accepted).to_equal(true)

    it "ACOWN03 permits an unaffected field after a sibling was moved":
        val accepted = adapter_spec_accepts([
            MirInstKind.GetField(LocalId(id: 3), mir_operand_move(LocalId(id: 2)), 0),
            MirInstKind.GetField(LocalId(id: 4), mir_operand_copy(LocalId(id: 2)), 1)
        ])
        expect(accepted).to_equal(true)
