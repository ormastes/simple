"""AC-BOR-03: synchronous forwarding and exclusive call boundaries."""

use std.spec
use compiler.borrow.borrow_check.borrow_graph.{BorrowKind, place_local, place_field}
use compiler.borrow.borrow_check.call_loans.{CallLoan, check_call_loans}

describe "AC-BOR-03 short call loans":
    it "accepts simultaneous reads of the same owner":
        val read = CallLoan(place: place_local(1), kind: BorrowKind.Shared, contract_known: true)
        expect(check_call_loans(7, 0, [read, read], []).len()).to_equal(0)

    it "rejects a mutable argument aliased by a read":
        val read = CallLoan(place: place_local(1), kind: BorrowKind.Shared, contract_known: true)
        val write = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, contract_known: true)
        val errors = check_call_loans(7, 0, [read, write], [])
        expect(errors.len()).to_equal(1)
        expect(errors[0].point).to_equal(7)

    it "rejects two exclusive arguments for the same place":
        val write = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, contract_known: true)
        expect(check_call_loans(7, 0, [write, write], []).len()).to_equal(1)

    it "accepts exclusive borrows of distinct fields":
        val first = CallLoan(place: place_field(place_local(1), 0), kind: BorrowKind.Mutable, contract_known: true)
        val second = CallLoan(place: place_field(place_local(1), 1), kind: BorrowKind.Mutable, contract_known: true)
        expect(check_call_loans(7, 0, [first, second], []).len()).to_equal(0)

    it "rejects a whole owner overlapping an exclusive field":
        val whole = CallLoan(place: place_local(1), kind: BorrowKind.Shared, contract_known: true)
        val field = CallLoan(place: place_field(place_local(1), 0), kind: BorrowKind.Mutable, contract_known: true)
        expect(check_call_loans(7, 0, [whole, field], []).len()).to_equal(1)

    it "preserves the original boundary through a nested synchronous call":
        val forwarded = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, origin_boundary: 3, contract_known: true)
        expect(check_call_loans(90, 3, [forwarded], []).len()).to_equal(0)
        expect(check_call_loans(91, 3, [forwarded], []).len()).to_equal(0)
        expect(check_call_loans(92, 4, [forwarded], []).len()).to_equal(1)

    it "rejects reentrant mutation of an actively read owner":
        val read = CallLoan(place: place_local(1), kind: BorrowKind.Shared, origin_boundary: 3, contract_known: true)
        val write = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, origin_boundary: 3, contract_known: true)
        expect(check_call_loans(8, 3, [write], [read]).len()).to_equal(1)

    it "rejects reading an active exclusive loan even with the same token":
        val read = CallLoan(place: place_local(1), kind: BorrowKind.Shared, origin_boundary: 3, contract_known: true)
        val write = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, origin_boundary: 3, contract_known: true)
        expect(check_call_loans(8, 3, [read], [write]).len()).to_equal(1)

    it "fails closed for unknown contracts or absent boundaries":
        val unknown = CallLoan(place: place_local(1), kind: BorrowKind.Shared, contract_known: false)
        expect(check_call_loans(8, 3, [unknown], []).len()).to_equal(1)
        expect(check_call_loans(8, -1, [], []).len()).to_equal(1)

    it "rejects malformed forwarded origins":
        val malformed = CallLoan(place: place_local(1), kind: BorrowKind.Shared, origin_boundary: -2, contract_known: true)
        expect(check_call_loans(8, 3, [malformed], []).len()).to_equal(1)

    it "keeps whole and child may-alias views of one slot without self-conflict":
        val whole = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, contract_known: true, argument_index: 0)
        val child = CallLoan(place: place_field(place_local(1), 0), kind: BorrowKind.Mutable, contract_known: true, argument_index: 0)
        expect(check_call_loans(8, 3, [whole, child], []).len()).to_equal(0)

    it "compares every possible view against a different argument slot":
        val whole = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, contract_known: true, argument_index: 0)
        val child = CallLoan(place: place_field(place_local(1), 0), kind: BorrowKind.Mutable, contract_known: true, argument_index: 0)
        val sibling = CallLoan(place: place_field(place_local(1), 1), kind: BorrowKind.Shared, contract_known: true, argument_index: 1)
        val errors = check_call_loans(8, 3, [whole, child, sibling], [])
        expect(errors.len()).to_equal(1)
        expect(errors[0].message).to_contain("conflicting short call arguments")

    it "does not exempt active loans that share an argument slot number":
        val whole = CallLoan(place: place_local(1), kind: BorrowKind.Mutable, contract_known: true, argument_index: 0)
        val read = CallLoan(place: place_local(1), kind: BorrowKind.Shared, contract_known: true, argument_index: 0)
        expect(check_call_loans(8, 3, [whole], [read]).len()).to_equal(1)

    it "checks boundary and contract on each alternative of a single slot":
        val valid = CallLoan(place: place_local(1), kind: BorrowKind.Shared, origin_boundary: 3, contract_known: true, argument_index: 0)
        val stale = CallLoan(place: place_local(1), kind: BorrowKind.Shared, origin_boundary: 4, contract_known: false, argument_index: 0)
        expect(check_call_loans(8, 3, [valid, stale], []).len()).to_equal(2)
