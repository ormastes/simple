# @req AC-OWN-01
"""Actual assignment policy and move-check controls; source routes remain separate gates."""
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.hir.hir_definitions.{HirExprKind}
use compiler.mir.mir_types.{MirType, LocalKind, MirLocal}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_lowering_stmts.*
use compiler.borrow.borrow_check.nll.{BasicBlock, ControlFlowGraph, NLLChecker}
use compiler.borrow.borrow_check.borrow_graph.{place_local}

describe "no-GC local assignment ownership policy":
    it "moves a bare nominal owner only in strict mode":
        var lowering = MirLowering.new(SymbolTable.new())
        var builder = lowering.builder
        val local = builder.new_local(nil, MirType.i64(), LocalKind.Var)
        lowering.builder = builder
        val owner = HirType(kind: HirTypeKind.Named(SymbolId(id: 81), []), span: Span.empty())
        lowering.remember_local_hir_type(local.id, owner, 0, 0)
        val read = HirExprKind.Var(SymbolId(id: 82))
        expect(lowering.ownership_assignment_requires_move(local, read, Span.empty())).to_equal(false)
        lowering.nogc_strict = true
        expect(lowering.ownership_assignment_requires_move(local, read, Span.empty())).to_equal(true)

    it "keeps short local aliases at the original boundary":
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.nogc_strict = true
        var builder = lowering.builder
        val source = builder.new_local(nil, MirType.i64(), LocalKind.Arg(0))
        val destination = builder.new_local(nil, MirType.i64(), LocalKind.Var)
        var slot_index = 0
        while slot_index < builder.locals.len():
            val slot: MirLocal = builder.locals[slot_index]
            if slot.id.id == source.id:
                builder.locals[slot_index] = MirLocal(id: slot.id, name: slot.name,
                    type_: slot.type_, kind: slot.kind, is_ghost: slot.is_ghost,
                    short_borrow: true, short_mutable: true, short_boundary: 91)
            slot_index = slot_index + 1
        lowering.builder = builder
        val owner = HirType(kind: HirTypeKind.Named(SymbolId(id: 81), []), span: Span.empty())
        lowering.remember_local_hir_type(source.id, owner, 0, 0)
        expect(lowering.ownership_assignment_requires_move(source, HirExprKind.Var(SymbolId(id: 82)), Span.empty())).to_equal(false)
        lowering.copy_assignment_short_provenance(source, destination)
        expect(lowering.ownership_assignment_is_short(destination)).to_equal(true)
        for definition in lowering.builder.locals:
            val destination_definition: MirLocal = definition
            if destination_definition.id.id == destination.id:
                expect(destination_definition.short_boundary).to_equal(91)
                expect(destination_definition.short_mutable).to_equal(true)

    it "rejects a second read after the emitted owning transfer":
        var cfg = ControlFlowGraph.create()
        var block = BasicBlock.create(0)
        block.statements = [0, 1]
        block.terminator_point = 2
        block.successors = []
        cfg.add_block(block)
        cfg.compute_predecessors()
        var checker = NLLChecker.create(cfg)
        checker.record_move(0, place_local(3))
        checker.record_use(1, place_local(3))
        expect(checker.check()).to_equal(false)
        expect(checker.errors[0].primary_span).to_equal(1)
