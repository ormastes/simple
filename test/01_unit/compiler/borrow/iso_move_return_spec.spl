"""
## Purpose and audience
Purpose: Prove that returning an already-moved iso value (`val c = a; a`) is a real Move.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-BORROW-001 — stable requirement identity for this spec.

"""
# `iso` (Isolated) capability -- returning an iso value is a real Move

**Bug:** `doc/08_tracking/bug/iso_transfer_sites_missing_move_return_assign_field_2026-08-06.md`,
item #1 (the last of the three double-gap sites; #2 reassignment and #3
struct-field-store were already closed -- see `iso_move_assign_field_spec.spl`).

Two sub-gaps existed at the return site:
- **Checker:** `analyze_instruction` had no terminator-walking arm at all, so
  a `Ret` operand's use/move fact was invisible however lowering built it.
  This half was closed separately (`analyze_terminator` +
  `record_operand_use`, `borrow_check/mod.spl`).
- **Lowering:** the function's own tail-expression return value reached the
  `Ret` terminator as a bare `mir_operand_copy(tail_local)` operand with no
  Move instruction backing it (`_MirLowering/function_lowering.spl`). This
  spec's fix inserts a synthetic `emit_move(fresh, tail_local)` ahead of the
  terminator, mirroring the already-landed call-argument/field-store/
  array-store/dict-store fixes, gated on `mir_hir_type_is_isolated`.

Same hand-built-HIR technique as `iso_move_pipeline_spec.spl` /
`iso_move_assign_field_spec.spl` (see either file's header for why: `iso`
parameter syntax does not parse through `parse_full_frontend` yet).
"""

use std.spec
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirBlock, HirStmt, HirStmtKind, HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.borrow.borrow_check.*
use compiler.common.attributes.{FunctionAttr}

fn mk_span(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "synthetic", length: 0)

fn i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: mk_span(0))

fn iso_i64_type() -> HirType:
    HirType(kind: HirTypeKind.Isolated(i64_type()), span: mk_span(0))

fn var_read(sym: SymbolId, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(sym), has_type_: true, type_: i64_type(), span: mk_span(line))

fn int_lit(value: i64, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn nil_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: i64_type(), span: mk_span(0))

fn iso_param(sym: SymbolId) -> HirParam:
    HirParam(symbol: sym, name: "a", type_: iso_i64_type(), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn non_iso_param(sym: SymbolId) -> HirParam:
    HirParam(symbol: sym, name: "a", type_: i64_type(), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn make_fn(params: [HirParam], body_stmts: [HirStmt], tail: HirExpr) -> HirFunction:
    val body = HirBlock(stmts: body_stmts, has: true, value: tail, span: mk_span(1))
    HirFunction(
        symbol: SymbolId(id: 3),
        name: "take",
        type_params: [],
        params: params,
        return_type: i64_type(),
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(1)
    )

fn make_hir_module(fn_: HirFunction) -> HirModule:
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[fn_.symbol] = fn_
    HirModule(
        name: "iso_move_return_test",
        path: "synthetic/iso_move_return_test.spl",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

fn lower_and_check(fn_: HirFunction) -> [NLLError]:
    val hir_module = make_hir_module(fn_)
    var mir_lowering = MirLowering.new(hir_module.symbols)
    val mir_module = mir_lowering.lower_module(hir_module)
    check_mir_module(mir_module)

describe "returning an already-moved iso value (`val c = a; a`) is a real Move":
    it "reports a borrow diagnostic for `fn take(a: iso i64) -> i64: val c = a; a`":
        step("Verify: reports a borrow diagnostic for `fn take(a: iso i64) -> i64: val c = a; a`")
        # @req: REQ-COMPILER-BORROW-001
        # val c = a  -- place-read let-binding move of the iso param
        # (already-landed LANE ISO1 site).
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        # tail: a  -- returning the same now-moved param: the Ret-terminator
        # site this spec's fix covers.
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [let_c], var_read(SymbolId(id: 1), 20))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() > 0)

describe "scalar local isolation metadata":
    it "distinguishes missing, ordinary, and isolated local HIR types without optional transport":
        step("Verify: distinguishes missing, ordinary, and isolated local HIR types without optional transport")
        var lowering = MirLowering.new(SymbolTable.new())
        expect(lowering.local_hir_type_isolation_state(901)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        lowering.remember_local_hir_type(901, i64_type(), 2, 0)
        expect(lowering.local_hir_type_isolation_state(901)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        lowering.remember_local_hir_type(901, iso_i64_type(), 1, 0)
        expect(lowering.local_hir_type_isolation_state(901)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        lowering.remember_local_hir_type(901, i64_type(), 2, 0)
        expect(lowering.local_hir_type_isolation_state(901)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(lowering.local_hir_type_resource_state(901)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        lowering.forget_local_hir_type(901)
        expect(lowering.local_hir_type_isolation_state(901)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lowering.local_hir_type_resource_state(901)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps caller-supplied resource state aligned without HIR inspection":
        step("Verify: keeps caller-supplied resource state aligned without HIR inspection")
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.remember_local_hir_type(902, i64_type(), 1, 1)
        expect(lowering.local_hir_type_isolation_state(902)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(lowering.local_hir_type_resource_state(902)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        lowering.remember_local_hir_type(902, i64_type(), 0, 0)
        expect(lowering.local_hir_type_isolation_state(902)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lowering.local_hir_type_resource_state(902)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports no borrow diagnostic for the identical non-iso shape (`a: i64`)":
        step("Verify: reports no borrow diagnostic for the identical non-iso shape (`a: i64`)")
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val fn_ = make_fn([non_iso_param(SymbolId(id: 1))], [let_c], var_read(SymbolId(id: 1), 20))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)

    it "reports no borrow diagnostic for a plain return of an unmoved iso value (`fn take(a: iso i64) -> i64: a`)":
        step("Verify: reports no borrow diagnostic for a plain return of an unmoved iso value (`fn take(a: iso i64) -> i64: a`)")
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [], var_read(SymbolId(id: 1), 20))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)

describe "an EXPLICIT early `return a` inside an if-branch is a real Move too":
    it "reports a borrow diagnostic for `fn take(a: iso i64) -> i64: if 1: return a; val c = a; 0`":
        step("Verify: reports a borrow diagnostic for `fn take(a: iso i64) -> i64: if 1: return a; val c = a; 0`")
        # This is the distinguishing scenario for the explicit-`return`
        # lowering site (expr_dispatch.spl's lower_return_expr): the
        # checker's `record_use` on a bare Copy operand already flags a
        # USE of an already-moved place, but never itself ADDS the place
        # to moved_now (only `record_move` does). Without a real Move
        # instruction backing the early return, the checker's block-order
        # forward walk never learns `a` was moved inside the if-branch, so
        # the later `val c = a` in the fall-through block goes undetected.
        val cond = int_lit(1, 15)
        val return_a = HirExpr(kind: HirExprKind.Return(Some(var_read(SymbolId(id: 1), 16))), has_type_: true, type_: i64_type(), span: mk_span(16))
        val then_block = HirBlock(stmts: [], has: true, value: return_a, span: mk_span(16))
        val if_expr = HirExpr(kind: HirExprKind.If(cond, then_block, nil), has_type_: true, type_: i64_type(), span: mk_span(15))
        val if_stmt = HirStmt(kind: HirStmtKind.Expr(if_expr), span: mk_span(15))
        # val c = a  -- reached only when the if-branch did NOT return;
        # still a genuine use-after-move site in the checker's own
        # (already-documented, not-in-scope-here) linear over-approximate
        # forward walk.
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [if_stmt, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() > 0)

    it "reports no borrow diagnostic for the identical non-iso shape (`a: i64`)":
        step("Verify: reports no borrow diagnostic for the identical non-iso shape (`a: i64`)")
        val cond = int_lit(1, 15)
        val return_a = HirExpr(kind: HirExprKind.Return(Some(var_read(SymbolId(id: 1), 16))), has_type_: true, type_: i64_type(), span: mk_span(16))
        val then_block = HirBlock(stmts: [], has: true, value: return_a, span: mk_span(16))
        val if_expr = HirExpr(kind: HirExprKind.If(cond, then_block, nil), has_type_: true, type_: i64_type(), span: mk_span(15))
        val if_stmt = HirStmt(kind: HirStmtKind.Expr(if_expr), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([non_iso_param(SymbolId(id: 1))], [if_stmt, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)
