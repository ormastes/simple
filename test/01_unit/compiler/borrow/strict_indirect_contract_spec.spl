"""Strict indirect invocation admission through source lowering and MIR borrow checking."""

use std.spec
use std.io.{file_read}
use compiler.common.config.Logger
use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.driver.driver_hir_pipeline_support.{driver_admit_nogc_param_effects_v1}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surface_from_owner, ModuleSurfaceParserOwner}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_instruction_graph.{MirBody, MirBlock, MirInst, MirFunction, MirModule}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator, MirOperand, MirOperandKind, MirBorrowKind, MirPlace}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirSignature, MirLocal, LocalKind}
use compiler.mir._MirLoweringExpr.lambda_abi.{lambda_scalar_source_signature_v1}
use compiler.common.diagnostics.span.{Span}
use compiler.borrow.borrow_check.mod.{BorrowCheckResult, create_borrow_checker}

val missing_indirect_contract_message_v1 = "strict indirect call requires an admitted non-retaining invocation contract"

fn make_indirect_gate_function_v1(signature: MirSignature, callback_type_signature: MirSignature,
    argument_type: MirType, terminator_call: bool = false, ordinary_call: bool = false,
    short_argument: bool = false) -> MirBody:
    val callback_id = LocalId(id: 0)
    val argument_id = LocalId(id: 1)
    val result_id = LocalId(id: 2)
    val callback_type = MirType(kind: MirTypeKind.FuncPtr(callback_type_signature))
    val callback = MirOperand(kind: MirOperandKind.Copy(callback_id))
    val argument = MirOperand(kind: MirOperandKind.Copy(argument_id))
    val callback_local = MirLocal(id: callback_id, name: Some("action"), type_: callback_type,
        kind: LocalKind.Arg(0), is_ghost: false)
    val argument_local = MirLocal(id: argument_id, name: Some("owner"), type_: argument_type,
        kind: LocalKind.Arg(1), is_ghost: false, short_borrow: short_argument,
        short_mutable: false, short_boundary: if short_argument: 91 else: -1)
    val result_local = MirLocal(id: result_id, name: Some("result"), type_: MirType.i64(),
        kind: LocalKind.Temp, is_ghost: false)
    var blocks: [MirBlock] = []
    if terminator_call:
        blocks = [
            MirBlock(id: BlockId(id: 0), label: nil, instructions: [],
                terminator: MirTerminator.CallTerminator(Some(result_id), callback, [argument],
                    BlockId(id: 1), nil, nil, nil)),
            MirBlock(id: BlockId(id: 1), label: nil, instructions: [],
                terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(result_id)))))]
    elif ordinary_call:
        val call = MirInst(kind: MirInstKind.Call(Some(result_id), callback, [argument]), span: nil)
        blocks = [MirBlock(id: BlockId(id: 0), label: nil, instructions: [call],
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(result_id)))))]
    else:
        val call = MirInst(kind: MirInstKind.CallIndirect(Some(result_id), callback, [argument], signature), span: nil)
        blocks = [MirBlock(id: BlockId(id: 0), label: nil, instructions: [call],
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(result_id)))))]
    MirBody(name: "strict-indirect-contract", blocks: blocks,
        locals: [callback_local, argument_local, result_local], arg_count: 2,
        return_ty: MirType.i64(), nogc_strict: true, short_call_contracts: {})

fn expect_missing_indirect_contract_v1(result: BorrowCheckResult):
    var found = false
    match result:
        case BorrowCheckResult.Errors(errors):
            for error in errors:
                if error.message == missing_indirect_contract_message_v1: found = true
        case BorrowCheckResult.Ok: ()
    expect(found).to_equal(true)

fn indirect_call_is_accepted_v1(result: BorrowCheckResult) -> bool:
    match result:
        case BorrowCheckResult.Ok: true
        case BorrowCheckResult.Errors(_): false

fn check_indirect_gate_v1(body: MirBody) -> BorrowCheckResult:
    var checker = create_borrow_checker()
    checker.check_function(body, 0)

fn expect_borrow_rejected_v1(result: BorrowCheckResult):
    var found_loan_escape = false
    match result:
        case BorrowCheckResult.Errors(errors):
            for error in errors:
                if error.message.contains("short borrow escapes: call argument requires a checked non-retaining short contract"):
                    found_loan_escape = true
        case BorrowCheckResult.Ok: ()
    expect(found_loan_escape).to_equal(true)

fn make_casted_loan_indirect_function_v1(signature: MirSignature) -> MirBody:
    val callback_id = LocalId(id: 0)
    val owner_id = LocalId(id: 1)
    val reference_id = LocalId(id: 2)
    val scalar_id = LocalId(id: 3)
    val result_id = LocalId(id: 4)
    val callback_type = MirType(kind: MirTypeKind.FuncPtr(signature))
    val reference_type = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
    val callback = MirOperand(kind: MirOperandKind.Copy(callback_id))
    val reference = MirInst(kind: MirInstKind.Ref(reference_id, MirBorrowKind.Shared,
        MirPlace(local: owner_id, projection: [])), span: nil)
    val cast = MirInst(kind: MirInstKind.Cast(scalar_id,
        MirOperand(kind: MirOperandKind.Copy(reference_id)), MirType.i64()), span: nil)
    val call = MirInst(kind: MirInstKind.CallIndirect(Some(result_id), callback,
        [MirOperand(kind: MirOperandKind.Copy(scalar_id))], signature), span: nil)
    val block = MirBlock(id: BlockId(id: 0), label: nil,
        instructions: [reference, cast, call],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(result_id)))))
    MirBody(name: "strict-indirect-cast-loan", blocks: [block],
        locals: [
            MirLocal(id: callback_id, name: Some("action"), type_: callback_type,
                kind: LocalKind.Arg(0), is_ghost: false),
            MirLocal(id: owner_id, name: Some("owner"), type_: MirType.i64(),
                kind: LocalKind.Arg(1), is_ghost: false),
            MirLocal(id: reference_id, name: Some("borrowed"), type_: reference_type,
                kind: LocalKind.Temp, is_ghost: false),
            MirLocal(id: scalar_id, name: Some("erased"), type_: MirType.i64(),
                kind: LocalKind.Temp, is_ghost: false),
            MirLocal(id: result_id, name: Some("result"), type_: MirType.i64(),
                kind: LocalKind.Temp, is_ghost: false)],
        arg_count: 2, return_ty: MirType.i64(), nogc_strict: true, short_call_contracts: {})

fn strict_callback_signature_v1(parameter: MirType, params_known: bool = true,
    variadic: bool = false) -> MirSignature:
    MirSignature(params: [parameter], return_type: MirType.i64(), is_variadic: variadic,
        params_known: params_known)

fn hir_type_v1(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn expect_erased_non_scalar_callback_rejected_v1(callback_type: HirType):
    val scalar_proven = lambda_scalar_source_signature_v1(callback_type)
    expect(scalar_proven).to_equal(false)
    val erased_scalar = MirType.i64()
    val signature = MirSignature(params: [erased_scalar], return_type: MirType.i64(),
        is_variadic: false, params_known: scalar_proven)
    expect_missing_indirect_contract_v1(check_indirect_gate_v1(
        make_indirect_gate_function_v1(signature, signature, erased_scalar)))

fn admit_source_fixture_v1(source: text, path: text, module_name: text) -> HirModule:
    var parsed = parse_full_frontend(source, path, module_name, Logger(level: 0))
    expect(parsed.nogc_strict).to_equal(true)
    val source_file = SourceFile(path: path, content: source, module_name: module_name)
    val surface = module_surface_from_owner(ModuleSurfaceParserOwner.new(parsed), source_file, 0).unwrap()
    var lowering = HirLowering.with_filename(path)
    lowering.use_explicit_semantic_policy()
    val hir = lowering.lower_module(parsed)
    val context = CompileContext.create(driver_core_compile_options_default())
    context.hir_modules[module_name] = hir
    context.validation_module_array = [hir]
    context.bootstrap_entry_hir = hir
    driver_admit_nogc_param_effects_v1(context, [surface])
    expect(context.error_count_value).to_equal(0)
    val admitted: HirModule = context.hir_modules[module_name]
    expect(admitted.nogc_param_effects_checked).to_equal(true)
    admitted

fn expect_admitted_function_report_v1(module: HirModule, function_name: text, parameter_count: i64):
    var symbol_id = -1
    for declaration in module.functions.values():
        if declaration.name == function_name: symbol_id = declaration.symbol.id
    var found = false
    var row = 0
    while row < module.nogc_param_effect_symbol_ids.len():
        if module.nogc_param_effect_symbol_ids[row] == symbol_id:
            expect(module.nogc_param_effects[row].len()).to_equal(parameter_count)
            found = true
        row = row + 1
    expect(found).to_equal(true)

fn lower_admitted_fixture_v1(module: HirModule) -> MirModule:
    val target = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(module.symbols, target)
    val mir = lowering.lower_module(module)
    expect(lowering.errors.len()).to_equal(0)
    mir

fn function_symbol_id_v1(module: HirModule, name: text) -> i64:
    var id = -1
    var matches = 0
    for declaration in module.functions.values():
        if declaration.name == name:
            id = declaration.symbol.id
            matches = matches + 1
    expect(matches).to_equal(1)
    id

fn function_named_v1(hir: HirModule, mir: MirModule, name: text) -> MirFunction?:
    val symbol_id = function_symbol_id_v1(hir, name)
    var selected: MirFunction? = nil
    var matches = 0
    for function in mir.functions.values():
        if function.symbol.id == symbol_id:
            selected = Some(function)
            matches = matches + 1
    expect(matches).to_equal(1)
    selected

fn expect_known_scalar_call_branches_v1(function: MirFunction):
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.CallIndirect(_, _, arguments, signature):
                    count = count + 1
                    expect(signature.params_known).to_equal(true)
                    expect(signature.is_variadic).to_equal(false)
                    expect(signature.params.len()).to_equal(arguments.len())
                    expect(signature.return_type.kind).to_equal(MirTypeKind.I64)
                    for parameter in signature.params:
                        expect(parameter.kind).to_equal(MirTypeKind.I64)
                case _: ()
    expect(count).to_equal(2)

describe "strict indirect invocation contract":
    it "rejects unchecked indirect reference callback":
        step("reject unchecked indirect reference callback")
        val source = file_read("test/fixtures/compiler/nogc_strict_indirect_callback_probe.spl")
        val path = "test/fixtures/compiler/nogc_strict_indirect_callback_probe.spl"
        val admitted = admit_source_fixture_v1(source, path, "nogc_strict_indirect_callback_probe")
        expect_admitted_function_report_v1(admitted, "invoke", 2)
        val mir = lower_admitted_fixture_v1(admitted)
        val invoke = function_named_v1(admitted, mir, "invoke").unwrap()
        expect(invoke.nogc_strict).to_equal(true)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(MirBody.from_function(invoke)))

    it "rejects a reference callback when no short-loan alias is present":
        val reference = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
        val signature = strict_callback_signature_v1(reference)
        val body = make_indirect_gate_function_v1(signature, signature, reference)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(body))

    it "rejects unknown, variadic, and wrong-arity callback signatures":
        val scalar = MirType.i64()
        val reference = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
        val unknown = strict_callback_signature_v1(reference, false, false)
        val variadic = strict_callback_signature_v1(reference, true, true)
        val wrong_arity = MirSignature(params: [], return_type: MirType.i64(),
            is_variadic: false, params_known: true)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(
            make_indirect_gate_function_v1(unknown, unknown, reference)))
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(
            make_indirect_gate_function_v1(variadic, variadic, reference)))
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(
            make_indirect_gate_function_v1(wrong_arity, wrong_arity, scalar)))

    it "rejects dynamic CallTerminator through a local function pointer":
        val reference = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
        val signature = strict_callback_signature_v1(reference)
        val body = make_indirect_gate_function_v1(signature, signature, reference, true)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(body))

    it "rejects dynamic ordinary Call through a local function pointer":
        val reference = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
        val signature = strict_callback_signature_v1(reference)
        val body = make_indirect_gate_function_v1(signature, signature, reference, false, true)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(body))

    it "rejects a known scalar signature when its scalar MIR argument is marked short-borrowed":
        val scalar = MirType.i64()
        val signature = strict_callback_signature_v1(scalar)
        val body = make_indirect_gate_function_v1(signature, signature, scalar, false, false, true)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(body))

    it "does not classify an erased Any callback parameter as scalar at the HIR boundary":
        val any_type = hir_type_v1(HirTypeKind.Any)
        val callback_type = hir_type_v1(HirTypeKind.Function(
            [any_type], hir_type_v1(HirTypeKind.Int(64, true)), []))
        expect_erased_non_scalar_callback_rejected_v1(callback_type)

    it "does not classify a weak callback parameter as scalar at the HIR boundary":
        val weak_node = hir_type_v1(HirTypeKind.Weak(
            hir_type_v1(HirTypeKind.Named(SymbolId(id: 701), []))))
        val callback_type = hir_type_v1(HirTypeKind.Function(
            [weak_node], hir_type_v1(HirTypeKind.Int(64, true)), []))
        expect_erased_non_scalar_callback_rejected_v1(callback_type)

    it "preserves a weak callback as non-scalar through the source parser and MIR lowering":
        val source = "@no_gc(strict)\nclass Node:\n    value: i64\n\n" +
            "fn invoke_weak(action: fn(-Node) -> i64, owner: -Node) -> i64:\n" +
            "    action(owner)\n"
        val path = "testdata/strict_weak_callback.spl"
        val hir = admit_source_fixture_v1(source, path, "strict_weak_callback")
        expect_admitted_function_report_v1(hir, "invoke_weak", 2)
        var proof_checked = false
        for declaration in hir.functions.values():
            if declaration.name == "invoke_weak":
                match declaration.params[0].type_.kind:
                    case HirTypeKind.Function(parameters, result, effects):
                        val callback = hir_type_v1(HirTypeKind.Function(parameters, result, effects))
                        expect(lambda_scalar_source_signature_v1(callback)).to_equal(false)
                        match parameters[0].kind:
                            case HirTypeKind.Weak(_): proof_checked = true
                            case _: ()
                    case _: ()
        expect(proof_checked).to_equal(true)
        val mir = lower_admitted_fixture_v1(hir)
        val invoke = function_named_v1(hir, mir, "invoke_weak").unwrap()
        expect(invoke.nogc_strict).to_equal(true)
        expect_missing_indirect_contract_v1(check_indirect_gate_v1(MirBody.from_function(invoke)))

    it "keeps a casted loan visible to a known scalar indirect call":
        val scalar = MirType.i64()
        val signature = strict_callback_signature_v1(scalar)
        val body = make_casted_loan_indirect_function_v1(signature)
        expect_borrow_rejected_v1(check_indirect_gate_v1(body))

    it "retain scalar indirect callback":
        step("retain scalar indirect callback")
        val source = file_read("test/fixtures/compiler/nogc_strict_indirect_callback_probe.spl")
        val path = "test/fixtures/compiler/nogc_strict_indirect_callback_probe.spl"
        val admitted = admit_source_fixture_v1(source, path, "nogc_strict_indirect_callback_probe")
        expect_admitted_function_report_v1(admitted, "invoke_scalar", 2)
        val mir = lower_admitted_fixture_v1(admitted)
        val invoke_scalar = function_named_v1(admitted, mir, "invoke_scalar").unwrap()
        expect(invoke_scalar.nogc_strict).to_equal(true)
        expect_known_scalar_call_branches_v1(invoke_scalar)
        expect(indirect_call_is_accepted_v1(
            check_indirect_gate_v1(MirBody.from_function(invoke_scalar)))).to_equal(true)
