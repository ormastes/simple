# @req AC-OWN-03
"""Shared type-shape policy; execution-route ownership needs separate evidence."""
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId}
use compiler.hir.ownership_types.{hir_type_contains_unique, hir_type_requires_move, hir_type_is_short_candidate, hir_type_ownership_is_known}

fn ownership_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.new(0, 0, 1, 1))

fn scalar_type() -> HirType:
    ownership_type(HirTypeKind.Int(64, true))

fn unique_type() -> HirType:
    ownership_type(HirTypeKind.Unique(scalar_type()))

describe "recursive ownership type classification":
    it "finds unique values in each stored structural payload":
        val scalar = scalar_type()
        val unique = unique_type()
        val shapes = [
            ownership_type(HirTypeKind.Tuple([scalar, unique])),
            ownership_type(HirTypeKind.Array(unique, nil)),
            ownership_type(HirTypeKind.Dict(unique, scalar)),
            ownership_type(HirTypeKind.Dict(scalar, unique)),
            ownership_type(HirTypeKind.Optional(unique)),
            ownership_type(HirTypeKind.Result(unique, scalar)),
            ownership_type(HirTypeKind.Result(scalar, unique)),
            ownership_type(HirTypeKind.Union([scalar, unique])),
            ownership_type(HirTypeKind.Tensor(unique, [], nil)),
            ownership_type(HirTypeKind.Named(SymbolId(id: 17), [unique]))
        ]
        for shape in shapes:
            expect(hir_type_contains_unique(shape)).to_equal(true)
            expect(hir_type_requires_move(shape, false)).to_equal(true)
            expect(hir_type_is_short_candidate(shape)).to_equal(true)

    it "does not confuse pointees or function signatures with stored owners":
        val unique = unique_type()
        val barriers = [
            ownership_type(HirTypeKind.Shared(unique)),
            ownership_type(HirTypeKind.Weak(unique)),
            ownership_type(HirTypeKind.Ref(unique, false)),
            ownership_type(HirTypeKind.Ptr(unique, true)),
            ownership_type(HirTypeKind.Slice(unique)),
            ownership_type(HirTypeKind.Function([unique], unique, []))
        ]
        for barrier in barriers:
            expect(hir_type_contains_unique(barrier)).to_equal(false)
            expect(hir_type_requires_move(barrier, true)).to_equal(false)
        expect(hir_type_is_short_candidate(barriers[0])).to_equal(false)
        expect(hir_type_is_short_candidate(barriers[1])).to_equal(false)
        expect(hir_type_is_short_candidate(barriers[2])).to_equal(true)
        expect(hir_type_is_short_candidate(barriers[3])).to_equal(false)
        expect(hir_type_is_short_candidate(barriers[4])).to_equal(true)
        expect(hir_type_is_short_candidate(barriers[5])).to_equal(false)

    it "moves strict allocated storage even with copyable elements":
        val scalar = scalar_type()
        val owners = [
            ownership_type(HirTypeKind.Array(scalar, nil)),
            ownership_type(HirTypeKind.Dict(scalar, scalar)),
            ownership_type(HirTypeKind.Tensor(scalar, [], nil)),
            ownership_type(HirTypeKind.Named(SymbolId(id: 42), [])),
            ownership_type(HirTypeKind.DynTrait(SymbolId(id: 43))),
            ownership_type(HirTypeKind.Layer([], []))
        ]
        for owner in owners:
            expect(hir_type_requires_move(owner, false)).to_equal(false)
            expect(hir_type_requires_move(owner, true)).to_equal(true)
            expect(hir_type_is_short_candidate(owner)).to_equal(true)

    it "retains primitive and all-copy aggregate semantics":
        val scalar = scalar_type()
        val copies = [scalar, ownership_type(HirTypeKind.Float(64)),
            ownership_type(HirTypeKind.Bool), ownership_type(HirTypeKind.Char),
            ownership_type(HirTypeKind.Str), ownership_type(HirTypeKind.Unit),
            ownership_type(HirTypeKind.Never), ownership_type(HirTypeKind.Tuple([scalar])),
            ownership_type(HirTypeKind.Optional(scalar)),
            ownership_type(HirTypeKind.Result(scalar, scalar))]
        for copy_type in copies:
            expect(hir_type_contains_unique(copy_type)).to_equal(false)
            expect(hir_type_requires_move(copy_type, true)).to_equal(false)
            expect(hir_type_is_short_candidate(copy_type)).to_equal(false)

    it "preserves nested storage ownership and isolated moves":
        val array = ownership_type(HirTypeKind.Array(scalar_type(), nil))
        val nested = ownership_type(HirTypeKind.Tuple([ownership_type(HirTypeKind.Optional(array))]))
        expect(hir_type_requires_move(nested, true)).to_equal(true)
        expect(hir_type_requires_move(nested, false)).to_equal(false)
        expect(hir_type_is_short_candidate(nested)).to_equal(true)
        val isolated = ownership_type(HirTypeKind.Isolated(scalar_type()))
        expect(hir_type_requires_move(isolated, false)).to_equal(true)
        expect(hir_type_contains_unique(isolated)).to_equal(true)
        expect(hir_type_is_short_candidate(isolated)).to_equal(false)
        expect(hir_type_is_short_candidate(unique_type())).to_equal(false)
        # A plain wrapper parameter lends its payload; value transfer still
        # moves that payload. An explicit outer owner parameter consumes it.
        val wrapped = ownership_type(HirTypeKind.Optional(unique_type()))
        expect(hir_type_is_short_candidate(wrapped)).to_equal(true)
        expect(hir_type_requires_move(wrapped, false)).to_equal(true)
        val explicit = ownership_type(HirTypeKind.Unique(wrapped))
        expect(hir_type_is_short_candidate(explicit)).to_equal(false)
        expect(hir_type_requires_move(explicit, false)).to_equal(true)

    it "does not fabricate ownership from unresolved types or bounds":
        val unknowns = [ownership_type(HirTypeKind.Infer(4, 2)),
            ownership_type(HirTypeKind.Error), ownership_type(HirTypeKind.Any),
            ownership_type(HirTypeKind.TypeParam("T", [unique_type()])),
            ownership_type(HirTypeKind.Projection(unique_type(), "Item"))]
        for unknown in unknowns:
            expect(hir_type_ownership_is_known(unknown)).to_equal(false)
            expect(hir_type_contains_unique(unknown)).to_equal(false)
            expect(hir_type_requires_move(unknown, true)).to_equal(false)
            expect(hir_type_is_short_candidate(unknown)).to_equal(false)

    it "separates unknown stored payloads from known handle ownership":
        val unknown = ownership_type(HirTypeKind.Infer(3, 1))
        val stored = [ownership_type(HirTypeKind.Tuple([scalar_type(), unknown])),
            ownership_type(HirTypeKind.Array(unknown, nil)),
            ownership_type(HirTypeKind.Dict(unknown, scalar_type())),
            ownership_type(HirTypeKind.Dict(scalar_type(), unknown)),
            ownership_type(HirTypeKind.Optional(unknown)),
            ownership_type(HirTypeKind.Result(scalar_type(), unknown)),
            ownership_type(HirTypeKind.Union([unknown])),
            ownership_type(HirTypeKind.Tensor(unknown, [], nil)),
            ownership_type(HirTypeKind.Named(SymbolId(id: 8), [unknown]))]
        for value_type in stored:
            expect(hir_type_ownership_is_known(value_type)).to_equal(false)
        val handles = [ownership_type(HirTypeKind.Unique(unknown)),
            ownership_type(HirTypeKind.Isolated(unknown)),
            ownership_type(HirTypeKind.Shared(unknown)),
            ownership_type(HirTypeKind.Weak(unknown)),
            ownership_type(HirTypeKind.Ref(unknown, false)),
            ownership_type(HirTypeKind.Ptr(unknown, true)),
            ownership_type(HirTypeKind.Slice(unknown)),
            ownership_type(HirTypeKind.Function([unknown], unknown, []))]
        for handle in handles:
            expect(hir_type_ownership_is_known(handle)).to_equal(true)
        expect(hir_type_ownership_is_known(scalar_type())).to_equal(true)
