"""AC-OWN-05: actual MIR alternatives, joins and unreachable blocks."""
use std.spec
use compiler.borrow.borrow_check.mod.{BorrowCheckResult, create_borrow_checker}
use compiler.mir.mir_instruction_graph.{MirBody, MirBlock, MirInst}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId, MirType}

fn path_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn path_block(id: i64, instructions: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId(id: id), label: nil, instructions: instructions, terminator: term)

fn paths_accept(blocks: [MirBlock]) -> bool:
    val body = MirBody(name: "exclusive-paths", blocks: blocks, locals: [], arg_count: 0, return_ty: MirType.i64(), nogc_strict: true)
    var checker = create_borrow_checker()
    match checker.check_function(body, 10):
        case BorrowCheckResult.Ok: true
        case BorrowCheckResult.Errors(_): false

fn branch_paths(reuse_at_join: bool, reverse_storage: bool) -> [MirBlock]:
    val owner = LocalId(id: 0)
    val entry = path_block(10, [], MirTerminator.If(mir_operand_const_int(1), BlockId(id: 30), BlockId(id: 50)))
    val left = path_block(30, [path_inst(MirInstKind.Move(LocalId(id: 1), owner))], MirTerminator.Goto(BlockId(id: 70)))
    val right = path_block(50, [path_inst(MirInstKind.Move(LocalId(id: 2), owner))], MirTerminator.Goto(BlockId(id: 70)))
    var joined: [MirInst] = []
    if reuse_at_join: joined = joined.push(path_inst(MirInstKind.DebugValue(owner, "reuse after either move")))
    val merge = path_block(70, joined, MirTerminator.Ret(nil))
    if reverse_storage: return [merge, right, left, entry]
    [entry, left, right, merge]

describe "AC-OWN-05 actual MIR path exclusivity":
    it "accepts independent moves of one owner on mutually exclusive arms":
        expect(paths_accept(branch_paths(false, false))).to_equal(true)

    it "rejects a use after the arms join":
        expect(paths_accept(branch_paths(true, false))).to_equal(false)

    it "preserves valid alternatives under reversed block storage":
        expect(paths_accept(branch_paths(false, true))).to_equal(true)

    it "preserves conflicting joins under reversed block storage":
        expect(paths_accept(branch_paths(true, true))).to_equal(false)

    it "does not diagnose an unsupported opcode in an unreachable block":
        val entry = path_block(10, [], MirTerminator.Ret(nil))
        val dead = path_block(90, [path_inst(MirInstKind.Parallel(LocalId(id: 1), []))], MirTerminator.Ret(nil))
        expect(paths_accept([dead, entry])).to_equal(true)

    it "still rejects the same unsupported opcode when reachable":
        val entry = path_block(10, [path_inst(MirInstKind.Parallel(LocalId(id: 1), []))], MirTerminator.Ret(nil))
        expect(paths_accept([entry])).to_equal(false)

    it "still validates malformed edges in unreachable blocks":
        val entry = path_block(10, [], MirTerminator.Ret(nil))
        val dead = path_block(90, [], MirTerminator.Goto(BlockId(id: 999)))
        expect(paths_accept([entry, dead])).to_equal(false)
