"""Regression coverage for entry-closure-safe BorrowChecker construction."""

use std.spec
use compiler.borrow.borrow_check.mod.{create_borrow_checker}

describe "BorrowChecker owner-module factory":
    it "constructs an empty checker through the exported function":
        val checker = create_borrow_checker()
        expect(checker.errors.len()).to_equal(0)
