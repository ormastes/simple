"""REQ-ACBOR-001: loan liveness scales to large functions under the default budget.

A 700-block straight chain (1400 CFG points) carries a reference from the
first block to the last. The old round-robin, reverse-postorder liveness
moved that fact one block per round and charged per-point list sizes, about
2,000,000 work units: `loan liveness work budget exhausted` with the default
budget. The worklist solver needs one block transfer per block here.
Bug: doc/08_tracking/bug/borrow_loan_work_budget_exhausted_2026-10-24.md
"""
use std.spec
use compiler.borrow.borrow_check.nll.{BasicBlock, ControlFlowGraph, NLLChecker}
use compiler.borrow.borrow_check.borrow_graph.{Place, BorrowKind}

fn large_block(id: i64, statements: [i64], terminal: i64, successors: [i64]) -> BasicBlock:
    var block = BasicBlock.create(id)
    block.statements = statements
    block.terminator_point = terminal
    block.successors = successors
    block

# Block k owns statement point 2k and terminator point 2k+1. With
# `loop_back`, the last block also jumps back to block 1.
fn large_chain(count: i64, loop_back: bool) -> ControlFlowGraph:
    var cfg = ControlFlowGraph.create()
    var k = 0
    while k < count:
        var succs: [i64] = []
        if k + 1 < count: succs = [k + 1]
        elif loop_back: succs = [1]
        cfg.add_block(large_block(k, [2 * k], 2 * k + 1, succs))
        k = k + 1
    cfg

fn large_errors(checker: NLLChecker) -> text:
    var joined = ""
    for msg in checker.format_errors(): joined = "{joined}{msg};"
    joined

describe "NLL loan liveness on a large function":
    it "accepts shared loans whose reference is live across 700 blocks":
        var checker = NLLChecker.create(large_chain(700, false))
        checker.record_borrow(0, Place.local(0), BorrowKind.Shared, 10)
        checker.record_borrow(700, Place.local(0), BorrowKind.Shared, 11)
        checker.record_use(1398, Place.local(10))
        checker.record_use(1398, Place.local(11))
        val ok = checker.check()
        expect(large_errors(checker)).to_equal("")
        expect(ok).to_equal(true)

    it "still rejects a conflicting loan while the long-lived reference is live":
        var checker = NLLChecker.create(large_chain(700, false))
        checker.record_borrow(0, Place.local(0), BorrowKind.Mutable, 10)
        checker.record_borrow(700, Place.local(0), BorrowKind.Mutable, 11)
        checker.record_use(1398, Place.local(10))
        expect(checker.check()).to_equal(false)
        expect(large_errors(checker).contains("work budget")).to_equal(false)
        expect(large_errors(checker).contains("also borrowed as mutable")).to_equal(true)

    it "accepts the conflict-free shape when the first reference dies early":
        var checker = NLLChecker.create(large_chain(700, false))
        checker.record_borrow(0, Place.local(0), BorrowKind.Mutable, 10)
        checker.record_use(2, Place.local(10))
        checker.record_borrow(700, Place.local(0), BorrowKind.Mutable, 11)
        checker.record_use(1398, Place.local(11))
        val ok = checker.check()
        expect(large_errors(checker)).to_equal("")
        expect(ok).to_equal(true)

    it "carries liveness around a 700-block loop backedge":
        var checker = NLLChecker.create(large_chain(700, true))
        checker.record_borrow(0, Place.local(0), BorrowKind.Mutable, 10)
        checker.record_use(2, Place.local(10))
        checker.record_borrow(1398, Place.local(0), BorrowKind.Mutable, 11)
        expect(checker.check()).to_equal(false)
        expect(large_errors(checker).contains("work budget")).to_equal(false)
