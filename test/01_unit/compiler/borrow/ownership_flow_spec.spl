"""WP-02 move dataflow: branch joins, loop edges and ordered revival.

These exercise the NLL recorder/check boundary. Whole-language ownership and
runtime cleanup qualification require separate end-to-end fixtures.
"""

use std.spec
use compiler.borrow.borrow_check.ownership_flow.{OwnershipFlow, OwnershipEvent}
use compiler.borrow.borrow_check.nll.{BasicBlock, ControlFlowGraph, NLLChecker}
use compiler.borrow.borrow_check.borrow_graph.{place_local, place_field}

fn ownership_block(id: i64, points: [i64], terminal: i64, successors: [i64]) -> BasicBlock:
    var block = BasicBlock.create(id)
    block.statements = points
    block.terminator_point = terminal
    block.successors = successors
    block

fn ownership_loop(backedge: bool) -> ControlFlowGraph:
    var cfg = ControlFlowGraph.create()
    cfg.add_block(ownership_block(0, [0], 1, [1]))
    val targets = if backedge: [1, 2] else: [2]
    cfg.add_block(ownership_block(1, [2, 3], 4, targets))
    cfg.add_block(ownership_block(2, [5], 6, []))
    cfg.compute_predecessors()
    cfg

describe "WP-02 NLL ownership facts":
    it "rejects a second move reached over a backedge":
        var checker = NLLChecker.create(ownership_loop(true))
        checker.record_move(3, place_local(0))
        expect(checker.check()).to_equal(false)
        expect(checker.errors[0].primary_span).to_equal(3)

    it "accepts a dominating refill before each move":
        var checker = NLLChecker.create(ownership_loop(true))
        checker.record_assign(2, place_local(0))
        checker.record_move(3, place_local(0))
        expect(checker.check()).to_equal(true)

    it "distinguishes an unconditional break from a loop backedge":
        var checker = NLLChecker.create(ownership_loop(false))
        checker.record_move(3, place_local(0))
        expect(checker.check()).to_equal(true)

    it "preserves moved state at a break exit":
        var checker = NLLChecker.create(ownership_loop(false))
        checker.record_move(3, place_local(0))
        checker.record_use(5, place_local(0))
        expect(checker.check()).to_equal(false)
        expect(checker.errors[0].primary_span).to_equal(5)

    it "does not leak a sibling-arm move into another arm":
        var cfg = ControlFlowGraph.create()
        cfg.add_block(ownership_block(0, [0], 1, [1, 2]))
        cfg.add_block(ownership_block(1, [2], 3, [3]))
        cfg.add_block(ownership_block(2, [4], 5, [3]))
        cfg.add_block(ownership_block(3, [6], 7, []))
        cfg.compute_predecessors()
        var checker = NLLChecker.create(cfg)
        checker.record_move(2, place_local(0))
        checker.record_move(4, place_local(0))
        expect(checker.check()).to_equal(true)

    it "diagnoses a whole read after a field move at the actual use":
        var checker = NLLChecker.create(ownership_loop(false))
        checker.record_move(3, place_field(place_local(0), 0))
        checker.record_use(5, place_local(0))
        expect(checker.check()).to_equal(false)
        expect(checker.errors[0].primary_span).to_equal(5)

    it "charges replay work and accepts the exact deterministic budget":
        var flow = OwnershipFlow.create()
        flow.record(0, OwnershipEvent.Read(place_local(0)))
        val points: Dict<i64, [i64]> = {0: [0]}
        val edges: Dict<i64, [i64]> = {}
        val exhausted = flow.check(0, points, edges, 8)
        expect(exhausted.len()).to_equal(1)
        expect(exhausted[0].message).to_equal("ownership CFG work budget exhausted during replay")
        expect(flow.check(0, points, edges, 9).len()).to_equal(0)

    it "rejects malformed edges even outside the reachable graph":
        var flow = OwnershipFlow.create()
        val points: Dict<i64, [i64]> = {0: [0], 1: [1]}
        val edges: Dict<i64, [i64]> = {0: [], 1: [99]}
        val errors = flow.check(0, points, edges)
        expect(errors.len()).to_equal(1)
        expect(errors[0].message).to_equal("ownership CFG edge targets a missing block")

    it "preserves partial moves across join and block-order permutations":
        var flow = OwnershipFlow.create()
        val owner = place_local(0)
        flow.record(1, OwnershipEvent.Move(place_field(owner, 0)))
        flow.record(2, OwnershipEvent.Revive(place_field(owner, 0)))
        flow.record(3, OwnershipEvent.Read(owner))
        val points: Dict<i64, [i64]> = {0: [0], 1: [1], 2: [2], 3: [3]}
        val reversed: Dict<i64, [i64]> = {3: [3], 2: [2], 1: [1], 0: [0]}
        val edges: Dict<i64, [i64]> = {0: [1, 2], 1: [3], 2: [3], 3: []}
        val reordered: Dict<i64, [i64]> = {3: [], 2: [3], 1: [3], 0: [2, 1]}
        val normal = flow.check(0, points, edges)
        val permuted = flow.check(0, reversed, reordered)
        expect(normal.len()).to_equal(1)
        expect(permuted.len()).to_equal(1)
        expect(normal[0].point).to_equal(3)
        expect(permuted[0].point).to_equal(3)
        val returning: Dict<i64, [i64]> = {0: [1, 2], 1: [], 2: [3], 3: []}
        expect(flow.check(0, points, returning).len()).to_equal(0)

    it "requires the moved field to be refilled on a multi-block loop":
        val owner = place_local(0)
        val child = place_field(owner, 0)
        val points: Dict<i64, [i64]> = {30: [30], 20: [20], 10: [10], 0: [0]}
        val edges: Dict<i64, [i64]> = {0: [10], 10: [20], 20: [10, 30], 30: []}
        var refilled = OwnershipFlow.create()
        refilled.record(10, OwnershipEvent.Move(child))
        refilled.record(20, OwnershipEvent.Revive(child))
        refilled.record(30, OwnershipEvent.Read(owner))
        expect(refilled.check(0, points, edges).len()).to_equal(0)
        var wrong = OwnershipFlow.create()
        wrong.record(10, OwnershipEvent.Move(child))
        wrong.record(20, OwnershipEvent.Revive(place_field(owner, 1)))
        val errors = wrong.check(0, points, edges)
        expect(errors.len()).to_equal(1)
        expect(errors[0].point).to_equal(10)
