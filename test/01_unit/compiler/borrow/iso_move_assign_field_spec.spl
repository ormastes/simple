"""
# `iso` (Isolated) capability -- reassignment + struct-field-store transfer sites

**Bug:** `doc/08_tracking/bug/iso_transfer_sites_missing_move_return_assign_field_2026-08-06.md`

Covers two more iso ownership-transfer sites in `mir_lowering_stmts.spl` that
were still always-Copy (the let-binding site and the iso call-argument site
were already fixed in prior lanes -- see `iso_move_pipeline_spec.spl` and
`switch_operators_calls.spl`'s `case HirTypeKind.Isolated(_):` call-arg arm):

1. **Reassignment to an existing var** (`b = a`) -- `lower_assign_var`'s plain
   (non-compound) branch, mirrored from the let-binding site's
   `mir_expr_kind_is_place` + `mir_hir_type_is_isolated` guard.
2. **Struct field store** (`obj.f = a`) -- `lower_assign`'s `Field` arm.
   `emit_set_field` takes a bare `MirOperand` with no instruction to hang a
   Move on, so the fix inserts a synthetic `emit_move(fresh, value)` ahead of
   the store (same shape as the already-landed call-argument fix), then
   stores the fresh local instead of the original.

Same hand-built-HIR technique as `iso_move_pipeline_spec.spl` (see that
file's header for why: `iso`/`mut` parameter syntax does not parse through
`parse_full_frontend` yet -- a separate, already-filed pre-existing gap).
"""

use std.spec
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirBlock, HirStmt, HirStmtKind, HirExpr, HirExprKind, HirAssignOp}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.borrow.borrow_check.*
use compiler.common.attributes.{FunctionAttr}

fn mk_span(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "synthetic", length: 0)

fn i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: mk_span(0))

fn iso_i64_type() -> HirType:
    HirType(kind: HirTypeKind.Isolated(i64_type()), span: mk_span(0))

fn dummy_struct_type() -> HirType:
    # A `Named` type whose symbol resolves to nothing in struct_field_order /
    # field_map -- resolve_field_index/resolve_base_struct_name fall back to
    # index 0 / nil owner without crashing, which is all this spec needs
    # (it is testing the Move-vs-Copy wiring, not real struct field layout).
    HirType(kind: HirTypeKind.Named(SymbolId(id: 77), []), span: mk_span(0))

fn var_read(sym: SymbolId, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(sym), has_type_: true, type_: i64_type(), span: mk_span(line))

fn struct_var_read(sym: SymbolId, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(sym), has_type_: true, type_: dummy_struct_type(), span: mk_span(line))

fn int_lit(value: i64, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn nil_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: i64_type(), span: mk_span(0))

fn field_target(base: HirExpr, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Field(base, "f", nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn index_target(base: HirExpr, index: HirExpr, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Index(base, index), has_type_: true, type_: i64_type(), span: mk_span(line))

fn array_init(line: i64) -> HirExpr:
    # Empty array literal -- lower_array_lit registers the dest local in
    # runtime_array_locals, which is all the Index-store arm needs to route
    # through the plain rt_array_set path (it is NOT recognized as a dict).
    HirExpr(kind: HirExprKind.ArrayLit([], nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn dict_init(line: i64) -> HirExpr:
    # Empty dict literal -- lower_dict_lit registers the dest local in
    # runtime_dict_locals, which routes the Index-store arm through the
    # rt_dict_set path instead of rt_array_set.
    HirExpr(kind: HirExprKind.DictLit([], i64_type(), nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn iso_param(sym: SymbolId) -> HirParam:
    HirParam(symbol: sym, name: "a", type_: iso_i64_type(), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn non_iso_param(sym: SymbolId) -> HirParam:
    HirParam(symbol: sym, name: "a", type_: i64_type(), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn make_fn(params: [HirParam], body_stmts: [HirStmt], tail: HirExpr) -> HirFunction:
    val body = HirBlock(stmts: body_stmts, has: true, value: tail, span: mk_span(1))
    HirFunction(
        symbol: SymbolId(id: 3),
        name: "take",
        type_params: [],
        params: params,
        return_type: i64_type(),
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(1)
    )

fn make_hir_module(fn_: HirFunction) -> HirModule:
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[fn_.symbol] = fn_
    HirModule(
        name: "iso_move_assign_field_test",
        path: "synthetic/iso_move_assign_field_test.spl",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

fn lower_and_check(fn_: HirFunction) -> [NLLError]:
    val hir_module = make_hir_module(fn_)
    var mir_lowering = MirLowering.new(hir_module.symbols)
    val mir_module = mir_lowering.lower_module(hir_module)
    check_mir_module(mir_module)

describe "iso reassignment to an existing var (`b = a`) is a real Move":
    it "reports a borrow diagnostic for `fn take(a: iso i64) -> i64: var b = 0; b = a; val c = a; 0`":
        # var b = 0
        val let_b0 = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 5), nil, int_lit(0, 9)), span: mk_span(9))
        # b = a  -- reassignment: a PLACE read of the iso param into an
        # EXISTING var target, the site mir_lowering_stmts.spl:1013 fixes.
        val assign_stmt = HirStmt(kind: HirStmtKind.Assign(var_read(SymbolId(id: 5), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        # val c = a  -- use-after-move: must be flagged
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [let_b0, assign_stmt, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() > 0)

    it "reports no borrow diagnostic for the identical non-iso shape (`a: i64`)":
        val let_b0 = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 5), nil, int_lit(0, 9)), span: mk_span(9))
        val assign_stmt = HirStmt(kind: HirStmtKind.Assign(var_read(SymbolId(id: 5), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([non_iso_param(SymbolId(id: 1))], [let_b0, assign_stmt, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)

describe "iso struct field store (`obj.f = a`) is a real Move":
    it "reports a borrow diagnostic for `fn take(a: iso i64) -> i64: var obj = 0; obj.f = a; val c = a; 0`":
        # var obj = 0  (dummy struct-typed local; resolve_field_index falls
        # back to index 0 since symbol 77 is unregistered -- fine, this spec
        # only probes the Move-vs-Copy wiring at the store).
        val let_obj = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 6), nil, int_lit(0, 9)), span: mk_span(9))
        # obj.f = a  -- struct field store of a PLACE read of the iso param,
        # the site mir_lowering_stmts.spl's Field arm (emit_set_field) fixes.
        val field_assign = HirStmt(kind: HirStmtKind.Assign(field_target(struct_var_read(SymbolId(id: 6), 15), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        # val c = a  -- use-after-move: must be flagged
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [let_obj, field_assign, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() > 0)

    it "reports no borrow diagnostic for the identical non-iso shape (`a: i64`)":
        val let_obj = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 6), nil, int_lit(0, 9)), span: mk_span(9))
        val field_assign = HirStmt(kind: HirStmtKind.Assign(field_target(struct_var_read(SymbolId(id: 6), 15), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([non_iso_param(SymbolId(id: 1))], [let_obj, field_assign, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)

describe "iso array element store (`arr[i] = a`) is a real Move":
    it "reports a borrow diagnostic for `fn take(a: iso i64) -> i64: var arr = []; arr[0] = a; val c = a; 0`":
        val let_arr = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 8), nil, array_init(9)), span: mk_span(9))
        # arr[0] = a  -- array element store of a PLACE read of the iso
        # param, the Index arm's plain (non-dict) rt_array_set path fixes.
        val arr_assign = HirStmt(kind: HirStmtKind.Assign(index_target(var_read(SymbolId(id: 8), 15), int_lit(0, 15), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [let_arr, arr_assign, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() > 0)

    it "reports no borrow diagnostic for the identical non-iso shape (`a: i64`)":
        val let_arr = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 8), nil, array_init(9)), span: mk_span(9))
        val arr_assign = HirStmt(kind: HirStmtKind.Assign(index_target(var_read(SymbolId(id: 8), 15), int_lit(0, 15), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([non_iso_param(SymbolId(id: 1))], [let_arr, arr_assign, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)

describe "iso dict value store (`d[k] = a`) is a real Move":
    it "reports a borrow diagnostic for `fn take(a: iso i64) -> i64: var d = {}; d[0] = a; val c = a; 0`":
        val let_d = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 9), nil, dict_init(9)), span: mk_span(9))
        # d[0] = a  -- dict value store of a PLACE read of the iso param,
        # the Index arm's dict (rt_dict_set) path fixes.
        val dict_assign = HirStmt(kind: HirStmtKind.Assign(index_target(var_read(SymbolId(id: 9), 15), int_lit(0, 15), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([iso_param(SymbolId(id: 1))], [let_d, dict_assign, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() > 0)

    it "reports no borrow diagnostic for the identical non-iso shape (`a: i64`)":
        val let_d = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 9), nil, dict_init(9)), span: mk_span(9))
        val dict_assign = HirStmt(kind: HirStmtKind.Assign(index_target(var_read(SymbolId(id: 9), 15), int_lit(0, 15), 15), nil, var_read(SymbolId(id: 1), 15)), span: mk_span(15))
        val let_c = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), nil, var_read(SymbolId(id: 1), 20)), span: mk_span(20))
        val fn_ = make_fn([non_iso_param(SymbolId(id: 1))], [let_d, dict_assign, let_c], int_lit(0, 25))
        val errors = lower_and_check(fn_)
        assert_true(errors.len() == 0)
