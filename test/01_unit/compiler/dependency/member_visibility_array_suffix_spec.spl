# Regression: pure_simple_native_array_suffix_range_2026_10_12.
# Runner status UNRUN; exact original driver native evidence is in the linked bug report.
use std.spec
use std.spec.step
use compiler.common.dependency.member_visibility.{member_layer_and_tail}

fn assert_suffix(path: text, expected_layer: text, expected_tail: text):
    val actual = member_layer_and_tail(path)
    expect(actual.0).to_equal(expected_layer)
    expect(actual.1).to_equal(expected_tail)

describe "native member visibility suffix boundaries":
    it "preserves empty":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("", "", "")

    it "preserves single":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("one", "", "")

    it "preserves compiler-only":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler", "", "")

    it "preserves two-components":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("app/main.spl", "app", "main.spl")

    it "preserves compiler-short-boundary":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler/20.hir", "compiler", "20.hir")

    it "preserves compiler-minimum":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler/20.hir/node.spl", "20.hir", "node.spl")

    it "preserves complete-tail":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler/20.hir/one/two/node.spl", "20.hir", "one/two/node.spl")

    it "preserves empty-tail":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("app/", "app", "")

    it "preserves compiler-empty-tail":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler/20.hir/", "20.hir", "")

    it "preserves empty-interior-and-end":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler/20.hir//node/", "20.hir", "/node/")

    it "preserves leading-empty-segment":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("/app/main.spl", "", "app/main.spl")

    it "preserves korean":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler/계층/경로/파일.spl", "계층", "경로/파일.spl")

    it "preserves supplementary-unicode":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("app/😀/é.spl", "app", "😀/é.spl")

    it "preserves absolute-src-marker":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("/work/src/compiler/50.mir/lower.spl", "50.mir", "lower.spl")

    it "preserves relative-src-marker":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("src/lib/foo/bar.spl", "lib", "foo/bar.spl")

    it "preserves two-empty-tail-segments":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("app//", "app", "/")

    it "preserves empty-compiler-layer":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("compiler//node.spl", "", "node.spl")

    it "preserves delimiter-only":
        step("compare complete layer and suffix against the retained boundary expectation")
        assert_suffix("/", "", "")
