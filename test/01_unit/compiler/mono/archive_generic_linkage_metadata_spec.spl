# @req REQ-SSPEC-COMPILER
# Authored source-bound regression; execution admission is recorded separately.
use std.spec
use std.spec.step
use compiler.common.config.Logger
use compiler.common.diagnostics.span.Span
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, Effect, EffectKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mono.monomorphize_integration.{mono_sym_key, mono_type_identity}
use compiler.hir.hir_definitions.HirFunction
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode_stable}
use compiler.mono.monomorphize_integration.MonomorphizationPass
use compiler.mono.mono_archive_registration_types_v1.{MonoArchiveRegistrationRowV1}
use compiler.mono.mono_archive_registration_v1.{mono_archive_registration_row_digest_v1}
use compiler.mono.mono_archive_types_v1.{MonoTemplateBodyModeV1, mono_template_signature_digest_v1, mono_template_signature_v1}

fn linkage_fixture(flag: text) -> HirModule:
    val source = "fn identity<T>(value: T) -> T:\n    value\nfn invoke() -> i64:\n    identity<i64>(41)\n"
    val parsed = parse_full_frontend(source, "provider.spl", "provider", Logger(level: 0))
    var lowering = HirLowering.with_filename("provider.spl")
    var module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.functions.len()).to_equal(2)
    for key in module.functions.keys():
        var function: HirFunction = module.functions[key]
        if function.name != "identity": continue
        function.is_extern = flag.contains("extern")
        function.has_export_attr = flag.contains("export")
        var attributes = function.func_attr
        attributes.is_global = flag.contains("global")
        attributes.is_entry = flag.contains("entry")
        function.func_attr = attributes
        module.functions[key] = function
    module

fn linkage_check_mode(module: HirModule, mode: MonoTemplateBodyModeV1, expected: bool) -> text:
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = mode
    pass_.current_module = "provider"
    pass_.collect_generics(module, "provider")
    val template = pass_.template_signature_v1("identity")
    expect(template.global_linkage).to_equal(expected)
    val argument = HirType(kind: HirTypeKind.Int(64, true), span: Span.new(0, 0, 1, 1))
    val symbol = pass_.request_specialization("identity", [argument])
    expect(symbol).to_be_greater_than(-1)
    val name = pass_.mangled_name("identity", [argument])
    val specialized = pass_.specialization_signature_v1(name)
    expect(specialized.global_linkage).to_equal(expected)
    expect(specialized.type_params.len()).to_equal(0)
    mono_template_signature_digest_v1(template)

# Rewrite the actual parsed/lowered call body. The second logical key is
# the supported repeated-provider surface; both point to the real module and
# its actual SymbolTable. No synthetic module or signature substitutes it.
fn linkage_rewrite_body(module: HirModule, mode: MonoTemplateBodyModeV1,
        caller: text, misleading: bool) -> text:
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = mode
    pass_.collect_generics(module, caller)
    pass_.collect_generics(module, "provider")
    pass_.current_module = caller
    var spelling = ""
    for key in module.functions.keys():
        val function: HirFunction = module.functions[key]
        if function.name != "invoke": continue
        var body = function.body
        expect(body.has).to_equal(true)
        if misleading:
            # Fault input changes only display spelling, preserving the actual
            # resolved symbol. Its owner must win over a misleading qualifier.
            var call: HirExpr = body.value
            match call.kind:
                case HirExprKind.Call(callee, arguments, type_arguments):
                    var named: HirExpr = callee
                    match callee.kind:
                        case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                            named.kind = HirExprKind.NamedVar(symbol, "misleading.alias.identity")
                        case _: expect(false).to_equal(true)
                    call.kind = HirExprKind.Call(named, arguments, type_arguments)
                case _: expect(false).to_equal(true)
            body.value = call
        val rewritten = pass_.rewrite_block(body)
        expect(rewritten.has).to_equal(true)
        match rewritten.value.kind:
            case HirExprKind.Call(callee, _, type_arguments):
                expect(type_arguments.len()).to_equal(0)
                expect(callee.has_type_).to_equal(true)
                match callee.kind:
                    case HirExprKind.NamedVar(symbol, name):
                        spelling = name
                        val spec_name = "identity$i64"
                        expect(pass_.spec_symbols[spec_name]).to_equal(symbol.id)
                        expect(pass_.spec_module[spec_name]).to_equal("provider")
                        if mode == MonoTemplateBodyModeV1.Retained:
                            val generated: HirFunction = pass_.specialized_functions[spec_name]
                            expect(generated.symbol.id).to_equal(symbol.id)
                            expect(generated.name).to_equal(spec_name)
                            expect(generated.body.has).to_equal(true)
                        else:
                            expect(pass_.archive_requests.len()).to_equal(1)
                            val request = pass_.archive_requests[0]
                            expect(request.module_name).to_equal("provider")
                            expect(request.caller_module).to_equal(caller)
                            expect(request.symbol_id).to_equal(symbol.id)
                            expect(pass_.archive_specialized_signatures[spec_name].type_params.len()).to_equal(0)
                    case _: expect(false).to_equal(true)
            case _: expect(false).to_equal(true)
    expect(pass_.diagnostics.len()).to_equal(0)
    spelling

fn linkage_method_fixture(global: bool) -> HirModule:
    val source = "class Box<T>:\n    value: T\nimpl Box<T>:\n    fn read() -> T:\n        self.value\nfn invoke(box: Box<i64>) -> i64:\n    box.read()\n"
    val parsed = parse_full_frontend(source, "provider.spl", "provider", Logger(level: 0))
    var lowering = HirLowering.with_filename("provider.spl")
    var module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.impls.len()).to_equal(1)
    for key in module.functions.keys():
        var function: HirFunction = module.functions[key]
        if not function.is_method: continue
        var attributes = function.func_attr
        attributes.is_global = global
        function.func_attr = attributes
        module.functions[key] = function
    module

fn linkage_rewrite_method(module: HirModule, mode: MonoTemplateBodyModeV1, caller: text) -> text:
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = mode
    pass_.collect_generics(module, "provider")
    pass_.current_module = caller
    # ArchiveRequests deliberately excludes tables from ordinary collection.
    # Supply the actual parsed tables/identities used by nominal transport,
    # as the real archive facts consumer does; no name-only fabricated rows.
    pass_.module_symbols["provider"] = module.symbols
    pass_.module_symbols[caller] = module.symbols
    if mode == MonoTemplateBodyModeV1.ArchiveRequests:
        for id in module.symbols.symbols.keys():
            val row = module.symbols.symbols[id]
            pass_.archive_symbol_identities[mono_sym_key(caller, id)] =
                mono_type_identity(module.symbols, row.id, caller)
    expect(pass_.generic_methods.len()).to_equal(1)
    var spelling = ""
    for key in module.functions.keys():
        val function: HirFunction = module.functions[key]
        if function.name != "invoke": continue
        val rewritten = pass_.rewrite_function(function)
        expect(rewritten.body.has).to_equal(true)
        match rewritten.body.value.kind:
            case HirExprKind.Call(callee, arguments, type_arguments):
                expect(arguments.len()).to_equal(1)
                expect(type_arguments.len()).to_equal(0)
                expect(callee.has_type_).to_equal(true)
                match callee.kind:
                    case HirExprKind.NamedVar(symbol, name):
                        spelling = name
                        val spec_name = "Box__read$i64"
                        expect(pass_.spec_symbols[spec_name]).to_equal(symbol.id)
                        expect(pass_.spec_module[spec_name]).to_equal("provider")
                        if mode == MonoTemplateBodyModeV1.Retained:
                            expect(pass_.specialized_functions[spec_name].symbol.id).to_equal(symbol.id)
                        else:
                            expect(pass_.archive_requests.len()).to_equal(1)
                            expect(pass_.archive_requests[0].module_name).to_equal("provider")
                            expect(pass_.archive_requests[0].caller_module).to_equal(caller)
                    case _: expect(false).to_equal(true)
            case _: expect(false).to_equal(true)
    expect(pass_.diagnostics.len()).to_equal(0)
    spelling

describe "generic ABI linkage metadata survives archive projection":
    it "preserves all sixteen flag combinations in both body modes":
        for external in [false, true]:
            for exported in [false, true]:
                for global_ in [false, true]:
                    for entry in [false, true]:
                        var flags = ""
                        if external: flags = flags + "extern "
                        if exported: flags = flags + "export "
                        if global_: flags = flags + "global "
                        if entry: flags = flags + "entry "
                        val expected = external or exported or global_ or entry
                        val module = linkage_fixture(flags)
                        val retained = linkage_check_mode(module, MonoTemplateBodyModeV1.Retained, expected)
                        val archived = linkage_check_mode(module, MonoTemplateBodyModeV1.ArchiveRequests, expected)
                        expect(archived).to_equal(retained)

    it "retains ordinary and each ABI attribute through both body modes and HIR persistence":
        for flag in ["ordinary", "extern", "export", "global", "entry"]:
            val module = linkage_fixture(flag)
            val encoded = hir_module_encode(module)
            val decoded = hir_module_decode_stable(encoded)
            expect(decoded != nil).to_equal(true)
            val restored = decoded.unwrap()
            val expected = flag != "ordinary"
            val retained = linkage_check_mode(module, MonoTemplateBodyModeV1.Retained, expected)
            val archived = linkage_check_mode(module, MonoTemplateBodyModeV1.ArchiveRequests, expected)
            val persisted = linkage_check_mode(restored, MonoTemplateBodyModeV1.ArchiveRequests, expected)
            expect(archived).to_equal(retained)
            expect(persisted).to_equal(retained)
            expect(retained.len()).to_equal(64)

    it "changes the signature digest when only physical linkage changes":
        val ordinary = linkage_check_mode(linkage_fixture("ordinary"), MonoTemplateBodyModeV1.ArchiveRequests, false)
        val global = linkage_check_mode(linkage_fixture("global"), MonoTemplateBodyModeV1.ArchiveRequests, true)
        expect(ordinary == global).to_equal(false)

    it "rewrites actual ordinary cross-module calls to the retained template owner in both modes":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            expect(linkage_rewrite_body(linkage_fixture("ordinary"), mode, "consumer", false)).to_equal("provider.identity$i64")
            expect(linkage_rewrite_body(linkage_fixture("ordinary"), mode, "consumer", true)).to_equal("provider.identity$i64")

    it "keeps actual same-module and each global ABI call bare without moving its body owner":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            expect(linkage_rewrite_body(linkage_fixture("ordinary"), mode, "provider", true)).to_equal("identity$i64")
            for flag in ["extern", "export", "global", "entry"]:
                expect(linkage_rewrite_body(linkage_fixture(flag), mode, "consumer", true)).to_equal("identity$i64")

    it "uses the same actual linkage rule for parsed generic impl method calls and nominal receiver transport":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            expect(linkage_rewrite_method(linkage_method_fixture(false), mode, "consumer")).to_equal("provider.Box__read$i64")
            expect(linkage_rewrite_method(linkage_method_fixture(true), mode, "consumer")).to_equal("Box__read$i64")
            expect(linkage_rewrite_method(linkage_method_fixture(false), mode, "provider")).to_equal("Box__read$i64")


fn linkage_effect_fixture(method: bool) -> HirModule:
    var module = if method: linkage_method_fixture(false) else: linkage_fixture("")
    for key in module.functions.keys():
        var function: HirFunction = module.functions[key]
        if (method and function.is_method) or (not method and function.name == "identity"):
            function.effects = [Effect(kind: EffectKind.IO, span: Span.new(1, 2, 3, 4)),
                Effect(kind: EffectKind.Throws(HirType(kind: HirTypeKind.TypeParam("T", []), span: Span.empty())), span: Span.new(5, 6, 7, 8)),
                Effect(kind: EffectKind.Custom("audit"), span: Span.new(9, 10, 11, 12))]
            module.functions[key] = function
    module

fn linkage_expect_effects(effects: [Effect]):
    expect(effects.len()).to_equal(3)
    match effects[0].kind:
        case EffectKind.IO: ()
        case _: fail("expected ordered IO effect")
    match effects[1].kind:
        case EffectKind.Throws(type_):
            match type_.kind:
                case HirTypeKind.Int(bits, signed):
                    expect(bits).to_equal(64)
                    expect(signed).to_equal(true)
                case _: fail("expected specialized Throws<i64>")
        case _: fail("expected ordered Throws effect")
    match effects[2].kind:
        case EffectKind.Custom(name): expect(name).to_equal("audit")
        case _: fail("expected ordered custom effect")
    expect(effects[0].span.line).to_equal(3)
    expect(effects[1].span.line).to_equal(7)
    expect(effects[2].span.line).to_equal(11)

fn linkage_rewrite_effects(module: HirModule, mode: MonoTemplateBodyModeV1):
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = mode
    pass_.collect_generics(module, "provider")
    pass_.current_module = "provider"
    pass_.module_symbols["provider"] = module.symbols
    var seen = false
    for key in module.functions.keys():
        val function: HirFunction = module.functions[key]
        if function.name != "invoke": continue
        val rewritten = pass_.rewrite_function(function)
        expect(rewritten.body.has).to_equal(true)
        match rewritten.body.value.kind:
            case HirExprKind.Call(callee, _, arguments):
                expect(arguments.len()).to_equal(0)
                match callee.type_.kind:
                    case HirTypeKind.Function(_, _, effects): linkage_expect_effects(effects)
                    case _: fail("expected actual specialized callee function stamp")
            case _: fail("expected rewritten actual call")
        seen = true
    expect(seen).to_equal(true)
    expect(pass_.diagnostics.len()).to_equal(0)
    if mode == MonoTemplateBodyModeV1.ArchiveRequests:
        expect(pass_.specialized_functions.len()).to_equal(0)
        expect(pass_.archive_requests.len()).to_equal(1)
        val request = pass_.archive_requests[0]
        linkage_expect_effects(pass_.archive_specialized_signatures[request.mangled_name].effects)

describe "archive declaration effects reach real rewritten calls":
    it "preserves ordered effects and specialized Throws in both direct-call body modes":
        step("Rewrite actual parsed generic calls using retained and archive-request producers")
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            linkage_rewrite_effects(linkage_effect_fixture(false), mode)

    it "preserves effects through inherent-method recipe canonicalization and rewrite":
        step("Use the actual generic class method collector and specialization call stamp")
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            linkage_rewrite_effects(linkage_effect_fixture(true), mode)

    it "retains declaration effects through the actual HIR archive codec":
        step("Roundtrip canonical module bytes before the actual archive-request projection")
        val source = linkage_effect_fixture(false)
        val encoded = hir_module_encode(source)
        val decoded = hir_module_decode_stable(encoded)
        expect(decoded != nil).to_equal(true)
        linkage_rewrite_effects(decoded.unwrap(), MonoTemplateBodyModeV1.ArchiveRequests)


    it "binds ordered effect facts and provenance in actual registration identity":
        step("Alter only effects in a real projected declaration and retain all other signature facts")
        val module = linkage_effect_fixture(false)
        var seen = false
        for key in module.functions.keys():
            val function: HirFunction = module.functions[key]
            if function.name != "identity": continue
            val original = mono_template_signature_v1(function)
            val original_row = MonoArchiveRegistrationRowV1.TemplateSignature("identity", original)
            val original_digest = mono_archive_registration_row_digest_v1(original_row)
            expect(original_digest.len()).to_equal(64)
            var reordered = original
            reordered.effects = [original.effects[2], original.effects[1], original.effects[0]]
            val reordered_digest = mono_archive_registration_row_digest_v1(
                MonoArchiveRegistrationRowV1.TemplateSignature("identity", reordered))
            expect(reordered_digest == original_digest).to_equal(false)
            var changed_span = original
            var effect: Effect = original.effects[0]
            effect.span = Span.new(20, 21, 22, 23)
            changed_span.effects = [effect, original.effects[1], original.effects[2]]
            expect(mono_archive_registration_row_digest_v1(
                MonoArchiveRegistrationRowV1.TemplateSignature("identity", changed_span)) == original_digest).to_equal(false)
            expect(mono_archive_registration_row_digest_v1(original_row)).to_equal(original_digest)
            seen = true
        expect(seen).to_equal(true)


    it "refuses malformed effect facts before assigning a signature digest":
        step("Exercise direct API malformed nodes independently of canonical module admission")
        val module = linkage_effect_fixture(false)
        var seen = false
        for key in module.functions.keys():
            val function: HirFunction = module.functions[key]
            if function.name != "identity": continue
            var signature = mono_template_signature_v1(function)
            unsafe:
                signature.effects = [nil]
                expect(mono_template_signature_digest_v1(signature)).to_equal("")
                signature.effects = [Effect(kind: nil, span: Span.empty())]
                expect(mono_template_signature_digest_v1(signature)).to_equal("")
                signature.effects = [Effect(kind: EffectKind.Throws(nil), span: Span.empty())]
                expect(mono_template_signature_digest_v1(signature)).to_equal("")
                val malformed = HirType(kind: nil, span: Span.empty())
                signature.effects = [Effect(kind: EffectKind.Throws(malformed), span: Span.empty())]
                expect(mono_template_signature_digest_v1(signature)).to_equal("")
            seen = true
        expect(seen).to_equal(true)
