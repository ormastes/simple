"""C34 HIR failures: error-state ownership and the metadata constructor."""
use std.spec
use compiler.mono.monomorphize.deferred_subst.{deferred_clear_error, deferred_set_error}
use compiler.mono.monomorphize.deferred_deserialize.{deserialize_last_error, read_u32}
use compiler.mono.monomorphize.tracker.{instantiationtracker_new}

describe "monomorphization source API owners":
    it "reads current deserializer errors after setting, replacing and clearing them":
        deferred_clear_error()
        expect(deserialize_last_error()).to_equal("")
        deferred_set_error("first error")
        expect(deserialize_last_error()).to_equal("first error")
        val truncated: [u8] = [1, 2, 3]
        expect(read_u32(truncated, 0)).to_be_nil()
        expect(deserialize_last_error()).to_equal("Unexpected end of data reading u32 at offset 0")
        deferred_clear_error()
        expect(deserialize_last_error()).to_equal("")

    it "initializes tracker metadata through its declared static constructor":
        val tracker = instantiationtracker_new("input.spl", "output.o")
        expect(tracker.current_file).to_equal("input.spl")
        expect(tracker.current_obj).to_equal("output.o")
        expect(tracker.next_inst_id).to_equal(0)
        val metadata = tracker.metadata
        expect(metadata.is_empty()).to_equal(true)
        expect(metadata.build_metadata).to_be_nil()
        expect(tracker.pending_deps.len()).to_equal(0)
        expect(tracker.tracked_names.len()).to_equal(0)
