# @req REQ-SSPEC-COMPILER
"""
# Generic substitution model: every variable-change kind preserves typing

A generic value changes variable in a fixed number of ways: it is bound by a
`let`, reassigned, passed as an argument, returned, stored into or loaded from
a field, an array element, a dict entry, wrapped in or taken out of an
optional, captured by a closure, called through one, destructured by a
pattern, or bound by a loop. `mf_step` gives the type the destination holds
for each of these 19 kinds.

For every kind this spec enumerates every input tuple of the bounded universe
and, for each well-typed step, every substitution, checking:

- F1 the step is still well typed after substitution, at the substituted
  type (a template body that type-checks keeps type-checking in every
  specialization, and the destination has the specialized type);
- F2 closed inputs give a closed result (no type variable survives into a
  specialization through this kind);
- F3 the result mentions no variable its inputs did not (nothing is invented).

Bounded exhaustive checking, not a proof: 26 types per input slot, 25
substitutions, 19 kinds. Per-kind case counts are printed, and a kind with no
well-typed case fails the spec.
"""

# @tag:unit
# @tag:compiler
# @tag:mono
# @tag:generics
# @tag:model

use std.spec
use compiler.mono.model.generic_subst_model.*
use compiler.mono.model.generic_subst_universe.*

var ok_cases = 0
var ill_cases = 0
var substituted = 0
var first_bad = ""

fn reset():
    ok_cases = 0
    ill_cases = 0
    substituted = 0
    first_bad = ""

fn skip_ill(n: i64):
    """Count `n` cases known to be ill typed without evaluating each (the
    counters are module state: only module functions update them)."""
    ill_cases = ill_cases + n

fn subset(xs: [text], ys: [text]) -> bool:
    for x in xs:
        val xt: text = x
        if not ys.contains(xt):
            return false
    true

fn flow_substs() -> [MSubst]:
    mu_substs(mu_small_closed_range(), false)

fn input_vars(kind: text, inputs: [MType]) -> [text]:
    """Variables of the inputs the FUNCTION can see (a declared field type
    is written over the struct's own parameters and is not one of them)."""
    var out: [text] = []
    var i = 0
    while i < inputs.len():
        val t: MType = inputs[i]
        if not (i == 1 and mf_is_field_kind(kind)):
            out = mt_free_vars_into(t, out)
        i = i + 1
    out

fn check_case(kind: text, inputs: [MType], decl_params: [text], substs: [MSubst]):
    val base = mf_step(kind, inputs, decl_params)
    if not mf_is_ok(base):
        ill_cases = ill_cases + 1
        return
    ok_cases = ok_cases + 1
    val result = mf_result(base)
    val visible = input_vars(kind, inputs)
    if not subset(mt_free_vars(result), visible):
        first_bad = "F3 {kind} {mt_render_list(inputs)} -> {mt_render(result)}"
    if visible.len() == 0 and not mt_is_closed(result):
        first_bad = "F2 {kind} {mt_render_list(inputs)} -> {mt_render(result)}"
    for s in substs:
        val st: MSubst = s
        substituted = substituted + 1
        val after = mf_step(kind, mf_substitute_inputs(kind, st, inputs), decl_params)
        val want = ms_apply(st, result)
        if not mf_is_ok(after):
            first_bad = "F1 {kind} {mt_render_list(inputs)} under {ms_render(st)}: {mf_render(after)}"
        elif not mt_struct_eq(mf_result(after), want):
            first_bad = "F1 {kind} {mt_render_list(inputs)} under {ms_render(st)}: {mf_render(after)} want {mt_render(want)}"
        if subset(visible, ms_domain(st)) and not mt_is_closed(mf_result(after)):
            first_bad = "F2 {kind} {mt_render_list(inputs)} under {ms_render(st)}"

fn sweep_unary(kind: text):
    reset()
    val substs = flow_substs()
    for a in mu_flow_types():
        val x: MType = a
        check_case(kind, [x], [], substs)
    print "{kind}: ok={ok_cases} ill={ill_cases} substituted={substituted}"

fn sweep_binary(kind: text):
    reset()
    val substs = flow_substs()
    val types = mu_flow_types()
    for a in types:
        val x: MType = a
        for b in types:
            val y: MType = b
            check_case(kind, [x, y], [], substs)
    print "{kind}: ok={ok_cases} ill={ill_cases} substituted={substituted}"

describe "generic substitution model: flow universe":
    it "has the stated sizes":
        expect(mf_kinds().len()).to_equal(19)
        expect(mu_flow_types().len()).to_equal(26)
        expect(flow_substs().len()).to_equal(25)
        expect(mu_pair_instances().len()).to_equal(25)
        expect(mu_field_declarations().len()).to_equal(8)

describe "generic substitution model: bindings keep the type (F1-F3)":
    it "let with an annotation":
        sweep_binary(MF_LET)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)
        expect(ill_cases).to_equal(650)

    it "let without an annotation":
        sweep_unary(MF_LET_INFER)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)

    it "assignment to a var":
        sweep_binary(MF_ASSIGN)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)

    it "argument passed to a parameter":
        sweep_binary(MF_PARAM)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)

    it "value returned":
        sweep_binary(MF_RETURN)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)

    it "closure capture":
        sweep_unary(MF_CAPTURE)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)

describe "generic substitution model: containers keep the element type (F1-F3)":
    it "array element read":
        sweep_unary(MF_ELEM_READ)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(5)
        expect(ill_cases).to_equal(21)

    it "array element write":
        sweep_binary(MF_ELEM_WRITE)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(5)

    it "loop variable":
        sweep_unary(MF_LOOP)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(5)

    it "dict entry read":
        sweep_binary(MF_DICT_READ)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(2)

    it "dict entry write":
        reset()
        val substs = flow_substs()
        val types = mu_flow_types()
        for a in types:
            val x: MType = a
            for b in types:
                val y: MType = b
                # Only a key of the dict's key type can be well typed; the
                # value slot is still swept over every type.
                if mf_is_ok(mf_step(MF_DICT_READ, [x, y], [])):
                    for c in types:
                        val z: MType = c
                        check_case(MF_DICT_WRITE, [x, y, z], [], substs)
                else:
                    skip_ill(types.len())
        print "dict_write: ok={ok_cases} ill={ill_cases} substituted={substituted}"
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(2)
        expect(ok_cases + ill_cases).to_equal(17576)

    it "tuple destructuring, both components":
        sweep_unary(MF_TUPLE_FIRST)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(2)
        sweep_unary(MF_TUPLE_SECOND)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(2)

describe "generic substitution model: optionals and closures (F1-F3)":
    it "wrap into an optional":
        sweep_unary(MF_OPT_WRAP)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(26)

    it "unwrap / payload pattern":
        sweep_unary(MF_OPT_UNWRAP)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(5)

    it "coalesce with a default":
        sweep_binary(MF_OPT_DEFAULT)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(5)

    it "call through a closure value":
        sweep_binary(MF_CLOSURE_CALL)
        expect(first_bad).to_equal("")
        expect(ok_cases).to_equal(2)

describe "generic substitution model: generic struct fields (F1-F3)":
    it "field read instantiates the declaration by the instance's arguments":
        reset()
        val substs = flow_substs()
        for inst in mu_pair_instances():
            val it_: MType = inst
            for d in mu_field_declarations():
                val dt: MType = d
                check_case(MF_FIELD_READ, [it_, dt], ["P", "Q"], substs)
        print "field_read: ok={ok_cases} ill={ill_cases} substituted={substituted}"
        expect(first_bad).to_equal("")
        # 25 instances x 7 declarations closed over P, Q; the eighth is open.
        expect(ok_cases).to_equal(175)
        expect(ill_cases).to_equal(25)
        val read = mf_step(MF_FIELD_READ, [mt_app(MU_PAIR, [mt_var("T"), mt_con("i64")]), mt_app(MT_ARRAY, [mt_var("P")])], ["P", "Q"])
        expect(mf_render(read)).to_equal("Ok(Array<'T>)")

    it "a declaration open in a variable of the enclosing function is rejected":
        val open = mf_step(MF_FIELD_READ, [mt_app(MU_PAIR, [mt_con("i64"), mt_con("i64")]), mt_var("T")], ["P", "Q"])
        expect(mf_render(open)).to_equal("Ill(open_declaration)")
        val wrong_arity = mf_step(MF_FIELD_READ, [mt_app(MU_BOX, [mt_con("i64")]), mt_var("P")], ["P", "Q"])
        expect(mf_render(wrong_arity)).to_equal("Ill(shape)")
        val not_an_instance = mf_step(MF_FIELD_READ, [mt_app(MT_ARRAY, [mt_con("i64")]), mt_var("P")], ["P"])
        expect(mf_render(not_an_instance)).to_equal("Ill(shape)")

    it "field write accepts exactly the instantiated field type":
        reset()
        val substs = flow_substs()
        val values = mu_flow_types()
        for inst in mu_pair_instances():
            val it_: MType = inst
            for d in mu_field_declarations():
                val dt: MType = d
                for v in values:
                    val vt: MType = v
                    check_case(MF_FIELD_WRITE, [it_, dt, vt], ["P", "Q"], substs)
        print "field_write: ok={ok_cases} ill={ill_cases} substituted={substituted}"
        expect(first_bad).to_equal("")
        expect(ok_cases > 0).to_equal(true)
        expect(ok_cases + ill_cases).to_equal(5200)
