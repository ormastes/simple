# @req REQ-SSPEC-COMPILER
"""
# Generic substitution model vs the production pass (differential)

The laws in `generic_subst_model_laws_spec` are about the MODEL. This spec
ties the model to the code that actually runs: every case of the bounded
universe is translated to `HirType`, pushed through the production function,
translated back, and compared with the model's answer.

| Production (40.mono) | Model | Cases |
|----------------------|-------|-------|
| `substitute_type` | `ms_apply` | 365 types x 25 substitutions |
| `hir_type_is_concrete` | `mt_is_closed` | 365 types |
| `bind_type_params` | `mm_match` | 95 patterns x (16 instances + 39 closed types) |
| `hir_type_key` | structural equality | 147 x 147 closed types |
| `MonomorphizationPass.type_key` | structural equality | 147 x 147 closed types |

Agreement over these cases is what is checked -- a bounded differential test,
not a proof of refinement.
"""

# @tag:unit
# @tag:compiler
# @tag:mono
# @tag:generics
# @tag:model

use std.spec
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.{Span}
use compiler.monomorphize.type_subst.{TypeSubstitution, substitute_type}
use compiler.mono.monomorphize_integration.{MonomorphizationPass, bind_type_params, hir_type_is_concrete, hir_type_key}
use compiler.mono.model.generic_subst_model.*
use compiler.mono.model.generic_subst_universe.*

fn sp() -> Span:
    Span.empty()

fn hir(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: sp())

fn model_monomorphization_pass() -> MonomorphizationPass:
    # The model's synthetic nominal ids must have real declaration owners.
    # Missing production ownership is an error, not an alternate name key.
    var symbols = SymbolTable.new()
    for i in 0..7:
        symbols.define("padding_{i}", SymbolKind.Variable, nil, sp(), Visibility.Private, false, nil)
    val box_id = symbols.define("Box", SymbolKind.Struct, nil, sp(), Visibility.Public, false, "model")
    val pair_id = symbols.define("Pair", SymbolKind.Struct, nil, sp(), Visibility.Public, false, "model")
    expect(box_id.id).to_equal(7)
    expect(pair_id.id).to_equal(8)
    var pass_ = MonomorphizationPass.create()
    pass_.current_module = "model"
    pass_.module_symbols["model"] = symbols
    pass_.named_symbol_names["model#7"] = "Box"
    pass_.named_symbol_names["model#8"] = "Pair"
    pass_

fn to_hir_list(ts: [MType]) -> [HirType]:
    var out: [HirType] = []
    for t in ts:
        val tt: MType = t
        out = out.push(to_hir(tt))
    out

fn to_hir(t: MType) -> HirType:
    match t:
        case MType.Var(n): hir(HirTypeKind.TypeParam(n, []))
        case MType.Con(n):
            if n == "i64":
                return hir(HirTypeKind.Int(64, true))
            if n == "text":
                return hir(HirTypeKind.Str)
            hir(HirTypeKind.Bool)
        case MType.App(c, args):
            val hs = to_hir_list(args)
            if c == MT_ARRAY:
                return hir(HirTypeKind.Array(hs[0], nil))
            if c == MT_SLICE:
                return hir(HirTypeKind.Slice(hs[0]))
            if c == MT_OPTIONAL:
                return hir(HirTypeKind.Optional(hs[0]))
            if c == MT_TUPLE:
                return hir(HirTypeKind.Tuple(hs))
            if c == MT_DICT:
                return hir(HirTypeKind.Dict(hs[0], hs[1]))
            if c == MT_FN:
                return hir(HirTypeKind.Function([hs[0]], hs[1], []))
            if c == MU_PAIR:
                return hir(HirTypeKind.Named(SymbolId(id: 8), hs))
            hir(HirTypeKind.Named(SymbolId(id: 7), hs))

fn to_model_list(ts: [HirType]) -> [MType]:
    var out: [MType] = []
    for t in ts:
        val tt: HirType = t
        out = out.push(to_model(tt))
    out

fn to_model(t: HirType) -> MType:
    match t.kind:
        case HirTypeKind.TypeParam(n, _): mt_var(n)
        case HirTypeKind.Int(_, _): mt_con("i64")
        case HirTypeKind.Str: mt_con("text")
        case HirTypeKind.Bool: mt_con("bool")
        case HirTypeKind.Array(elem, _): mt_app(MT_ARRAY, [to_model(elem)])
        case HirTypeKind.Slice(elem): mt_app(MT_SLICE, [to_model(elem)])
        case HirTypeKind.Optional(inner): mt_app(MT_OPTIONAL, [to_model(inner)])
        case HirTypeKind.Tuple(elems): mt_app(MT_TUPLE, to_model_list(elems))
        case HirTypeKind.Dict(k, v): mt_app(MT_DICT, [to_model(k), to_model(v)])
        case HirTypeKind.Function(params, ret, _): mt_app(MT_FN, [to_model(params[0]), to_model(ret)])
        case HirTypeKind.Named(sym, args):
            if sym.id == 8:
                return mt_app(MU_PAIR, to_model_list(args))
            mt_app(MU_BOX, to_model_list(args))
        case _: mt_unknown()

fn to_hir_subst(s: MSubst) -> TypeSubstitution:
    var mapping: Dict<text, HirType> = {}
    for k in ms_domain(s):
        val key: text = k
        mapping[key] = to_hir(ms_get(s, key))
    TypeSubstitution(mapping: mapping, by_symbol: {})

fn same_keys(a: [text], b: [text]) -> bool:
    if a.len() != b.len():
        return false
    for x in a:
        val xt: text = x
        if not b.contains(xt):
            return false
    true

describe "model vs production: translation":
    it "round-trips every type of the universe":
        var bad = ""
        var checked = 0
        for t in mu_types():
            val tt: MType = t
            checked = checked + 1
            if not mt_struct_eq(to_model(to_hir(tt)), tt):
                bad = mt_render(tt)
        expect(bad).to_equal("")
        expect(checked).to_equal(365)

describe "model vs production: substitution and closedness":
    it "substitute_type agrees with ms_apply":
        val types = mu_types()
        val substs = mu_substs(mu_small_closed_range(), false)
        var checked = 0
        var bad = ""
        for s in substs:
            val st: MSubst = s
            val hs = to_hir_subst(st)
            for t in types:
                val tt: MType = t
                checked = checked + 1
                val produced = to_model(substitute_type(to_hir(tt), hs))
                if not mt_struct_eq(produced, ms_apply(st, tt)):
                    bad = "{ms_render(st)} {mt_render(tt)} -> {mt_render(produced)}"
        print "substitute_type checked={checked}"
        expect(bad).to_equal("")
        expect(checked).to_equal(9125)

    it "hir_type_is_concrete agrees with mt_is_closed":
        var closed = 0
        var open = 0
        var bad = ""
        for t in mu_types():
            val tt: MType = t
            val want = mt_is_closed(tt)
            if want:
                closed = closed + 1
            else:
                open = open + 1
            if hir_type_is_concrete(to_hir(tt)) != want:
                bad = mt_render(tt)
        expect(bad).to_equal("")
        expect(closed).to_equal(147)
        expect(open).to_equal(218)

describe "model vs production: matching":
    it "bind_type_params agrees with mm_match on verdict and bindings":
        val patterns = mu_depth1(mu_atoms())
        val substs = mu_substs(mu_small_closed_range(), true)
        val strangers = mu_depth1(mu_closed_atoms())
        var checked = 0
        var bound = 0
        var refused = 0
        var bad = ""
        for p in patterns:
            val pt: MType = p
            var evidence: [MType] = []
            for s in substs:
                val st: MSubst = s
                evidence = evidence.push(ms_apply(st, pt))
            for x in strangers:
                val xt: MType = x
                evidence = evidence.push(xt)
            for e in evidence:
                val et: MType = e
                checked = checked + 1
                var bindings: Dict<text, HirType> = {}
                val produced = bind_type_params(to_hir(pt), to_hir(et), bindings)
                val modelled = mm_match(pt, et, ms_empty())
                if produced != mm_is_bound(modelled):
                    bad = "verdict {mt_render(pt)} ~ {mt_render(et)}: production={produced} model={mm_render(modelled)}"
                elif produced:
                    bound = bound + 1
                    val b = mm_subst(modelled)
                    if not same_keys(bindings.keys(), ms_domain(b)):
                        bad = "domain {mt_render(pt)} ~ {mt_render(et)}: model={mm_render(modelled)}"
                    else:
                        for k in ms_domain(b):
                            val key: text = k
                            val got: HirType = bindings[key]
                            if not mt_struct_eq(to_model(got), ms_get(b, key)):
                                bad = "binding {key} {mt_render(pt)} ~ {mt_render(et)}"
                else:
                    refused = refused + 1
        print "bind_type_params checked={checked} bound={bound} refused={refused}"
        expect(bad).to_equal("")
        expect(checked).to_equal(5225)
        expect(bound > 0).to_equal(true)
        expect(refused > 0).to_equal(true)

    it "rejects two witnesses that differ only inside a function type":
        # `(T, T)` against `([fn(i64) -> bool], [fn(text) -> bool])`: the
        # mangling spells both elements `arr_unknown`, so the binding used to
        # be accepted.
        val fn_a = mt_app(MT_ARRAY, [mt_app(MT_FN, [mt_con("i64"), mt_con("bool")])])
        val fn_b = mt_app(MT_ARRAY, [mt_app(MT_FN, [mt_con("text"), mt_con("bool")])])
        val pattern = mt_app(MT_TUPLE, [mt_var("T"), mt_var("T")])
        val evidence = mt_app(MT_TUPLE, [fn_a, fn_b])
        expect(mm_render(mm_match(pattern, evidence, ms_empty()))).to_equal("Conflict(T)")
        var bindings: Dict<text, HirType> = {}
        expect(bind_type_params(to_hir(pattern), to_hir(evidence), bindings)).to_equal(false)
        var same: Dict<text, HirType> = {}
        expect(bind_type_params(to_hir(pattern), to_hir(mt_app(MT_TUPLE, [fn_a, fn_a])), same)).to_equal(true)

describe "model vs production: keys":
    it "hir_type_key and the specialization type_key are injective on closed types":
        val types = mu_closed_types()
        var pass_ = model_monomorphization_pass()
        var binding_keys: [text] = []
        var spec_keys: [text] = []
        for t in types:
            val tt: MType = t
            val h = to_hir(tt)
            binding_keys = binding_keys.push(hir_type_key(h))
            spec_keys = spec_keys.push(pass_.type_key(h))
        var checked = 0
        var bad = ""
        var i = 0
        while i < types.len():
            val a: MType = types[i]
            var j = 0
            while j < types.len():
                val b: MType = types[j]
                val same_term = mt_struct_eq(a, b)
                checked = checked + 1
                if (binding_keys[i] == binding_keys[j]) != same_term:
                    bad = "hir_type_key {binding_keys[i]} vs {binding_keys[j]}"
                if (spec_keys[i] == spec_keys[j]) != same_term:
                    bad = "type_key {spec_keys[i]} vs {spec_keys[j]}"
                j = j + 1
            i = i + 1
        print "keys pairs={checked}"
        expect(bad).to_equal("")
        expect(checked).to_equal(21609)

describe "model vs production: one specialization name per instantiation":
    it "mangled_name is stable per type list and never shared by two (the _k<n> path)":
        # Two key-sharing defects were found here by reading, so the display
        # name is checked against structural equality over the whole closed
        # universe: singles, and pairs over the 39 closed depth<=1 types.
        var pass_ = model_monomorphization_pass()
        var lists: [[MType]] = []
        for t in mu_closed_types():
            val tt: MType = t
            lists = lists.push([tt])
        val parts = mu_depth1(mu_closed_atoms())
        for a in parts:
            val x: MType = a
            for b in parts:
                val y: MType = b
                lists = lists.push([x, y])
        # Outside the universe on purpose: two shapes whose DISPLAY names are
        # known to clash. A function type inside a tuple mangles as `unknown`,
        # and `_` both separates arguments and nests a tuple (the 3-tuple
        # clashes with the universe pair `[Tuple<i64,i64>, i64]`).
        val i64t = mt_con("i64")
        lists = lists.push([mt_app(MT_TUPLE, [mt_app(MT_FN, [i64t, mt_con("bool")]), i64t])])
        lists = lists.push([mt_app(MT_TUPLE, [mt_app(MT_FN, [mt_con("text"), mt_con("bool")]), i64t])])
        lists = lists.push([mt_app(MT_TUPLE, [i64t, i64t, i64t])])
        var owner: Dict<text, text> = {}
        var names: [text] = []
        var suffixed = 0
        var bad = ""
        for l in lists:
            val args: [MType] = l
            val model_key = mk_key("m", "f", args)
            val name = pass_.mangled_name("f", to_hir_list(args))
            # What `request_specialization` does next: the name is taken.
            pass_.spec_symbols[name] = 1
            if owner.has(name):
                bad = "{name} names both {owner[name]} and {model_key}"
            owner[name] = model_key
            names = names.push(name)
            if name.contains("_k"):
                suffixed = suffixed + 1
        # Asking again gives the same name (no fresh suffix on a re-request).
        var i = 0
        while i < lists.len():
            val again: [MType] = lists[i]
            if pass_.mangled_name("f", to_hir_list(again)) != names[i]:
                bad = "unstable name for {mt_render_list(again)}"
            i = i + 1
        print "mangled_name lists={lists.len()} names={owner.keys().len()} suffixed={suffixed}"
        expect(bad).to_equal("")
        expect(lists.len()).to_equal(1671)
        expect(owner.keys().len()).to_equal(1671)
        # Inside the universe the display mangling happens to be injective;
        # the two added pairs are the clashes, each resolved by one suffix.
        expect(suffixed).to_equal(2)
