# Source-authored parser -> HIR -> direct mono placement regressions.
# Runtime execution remains UNRUN until an admitted rebuilt producer exists.
use std.spec
use std.io_runtime.{env_get, env_set}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_end}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.mono.monomorphize_integration.{MonomorphizationPass}
use compiler.mono.mono_selective_emission_publication_v1.{MonoSelectiveFunctionPlacementV1,
    mono_selective_emission_publication_v1, mono_selective_emission_publish_v1}

fn selective_placement_lower_v1(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "testdata/selective_placement.spl",
        "physical.provider", Logger(level: 0))
    var lowering = HirLowering.with_filename("testdata/selective_placement.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    module

fn selective_placement_aliases_v1() -> Dict<text, HirModule>:
    val source = "fn identity<T>(value: T) -> T:\n    value\n\nfn identity_i64() -> i64:\n    9\n\nfn caller() -> i64:\n    identity(7)\n"
    var modules: Dict<text, HirModule> = {}
    modules["logical.primary"] = selective_placement_lower_v1(source)
    modules["logical.alias"] = selective_placement_lower_v1(source)
    modules

describe "direct selective monomorphization exact placement publication":
    it "records actual specialized bodies in every logical alias and their producer origin":
        val selective_saved = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        val saved = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "test-placement-export")).to_equal(true)
        var mono = MonomorphizationPass.create()
        val output = mono.process_modules(selective_placement_aliases_v1())
        val publication = mono_selective_emission_publication_v1()
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", selective_saved)).to_equal(true)
        expect(mono.diagnostics.len()).to_equal(0)
        expect(mono.stats.specializations_created).to_equal(1)
        expect(publication.is_ok()).to_equal(true)
        val rows = publication.unwrap()
        expect(rows.len()).to_equal(2)
        val expected_keys = ["logical.primary", "logical.alias"]
        var index = 0
        while index < rows.len():
            val row: MonoSelectiveFunctionPlacementV1 = rows[index]
            expect(row.logical_key).to_equal(expected_keys[index])
            expect(row.origin_logical_key).to_equal(mono.spec_module[row.name])
            expect(output.has(row.origin_logical_key)).to_equal(true)
            val module: HirModule = output[row.logical_key]
            var matches = 0
            for key in module.functions.keys():
                val function: HirFunction = module.functions[key]
                if function.symbol.id == row.symbol and function.name == row.name:
                    expect(mono_complete_function_digest_v1(function)).to_equal(row.complete_function_digest)
                    expect(function.is_generic_template).to_equal(false)
                    expect(function.name == "identity_i64").to_equal(false)
                    matches = matches + 1
            expect(matches).to_equal(1)
            index = index + 1
        expect(rows[0].symbol).to_equal(rows[1].symbol)
        expect(rows[0].complete_function_digest).to_equal(rows[1].complete_function_digest)

    it "replaces prior placement rows with a successful empty no-generic inventory":
        val selective_saved = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        val saved = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "test-placement-export")).to_equal(true)
        var first = MonomorphizationPass.create()
        first.process_modules(selective_placement_aliases_v1())
        expect(mono_selective_emission_publication_v1().unwrap().len()).to_equal(2)
        var second = MonomorphizationPass.create()
        var modules: Dict<text, HirModule> = {}
        modules["plain"] = selective_placement_lower_v1("fn plain() -> i64:\n    4\n")
        second.process_modules(modules)
        val publication = mono_selective_emission_publication_v1()
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", selective_saved)).to_equal(true)
        expect(publication.is_ok()).to_equal(true)
        expect(publication.unwrap().len()).to_equal(0)

    it "revokes prior rows when a later default invocation disables exporting":
        val selective_saved = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        val saved = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "test-placement-export")).to_equal(true)
        var first = MonomorphizationPass.create()
        first.process_modules(selective_placement_aliases_v1())
        expect(mono_selective_emission_publication_v1().is_ok()).to_equal(true)
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "")).to_equal(true)
        var second = MonomorphizationPass.create()
        second.process_modules(selective_placement_aliases_v1())
        val publication = mono_selective_emission_publication_v1()
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", selective_saved)).to_equal(true)
        expect(publication.is_err()).to_equal(true)

    it "revokes publication before a checked invocation fails its entry policy":
        val selective_saved = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        val saved = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "test-placement-export")).to_equal(true)
        var first = MonomorphizationPass.create()
        first.process_modules(selective_placement_aliases_v1())
        expect(mono_selective_emission_publication_v1().is_ok()).to_equal(true)
        var invalid = MonomorphizationPass.create()
        val output = invalid.process_modules_checked_v1(selective_placement_aliases_v1())
        val publication = mono_selective_emission_publication_v1()
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", selective_saved)).to_equal(true)
        expect(output.is_err()).to_equal(true)
        expect(publication.is_err()).to_equal(true)

    it "does not pause or close a caller lease to publish escaping records":
        val selective_saved = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        val saved = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "test-placement-export")).to_equal(true)
        var mono = MonomorphizationPass.create()
        mono.process_modules(selective_placement_aliases_v1())
        val rows = mono_selective_emission_publication_v1().unwrap()
        expect(transient_scope_begin()).to_equal(true)
        val refused = not mono_selective_emission_publish_v1(rows)
        val absent = mono_selective_emission_publication_v1().is_err()
        val still_owned = transient_array_scope_state_v1()
        val ended = transient_scope_end()
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", selective_saved)).to_equal(true)
        expect(refused).to_equal(true)
        expect(absent).to_equal(true)
        expect(still_owned).to_equal(1)
        expect(ended).to_equal(true)

    it "leaves no publication after a new pass reports an unresolved generic call":
        val selective_saved = env_get("SIMPLE_MIR_SELECTIVE") ?? ""
        expect(env_set("SIMPLE_MIR_SELECTIVE", "1")).to_equal(true)
        val saved = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", "test-placement-export")).to_equal(true)
        var first = MonomorphizationPass.create()
        first.process_modules(selective_placement_aliases_v1())
        expect(mono_selective_emission_publication_v1().is_ok()).to_equal(true)
        val source = "fn identity<T>(value: T) -> T:\n    value\n\nfn caller():\n    identity()\n"
        var modules: Dict<text, HirModule> = {}
        modules["invalid"] = selective_placement_lower_v1(source)
        var second = MonomorphizationPass.create()
        second.process_modules(modules)
        val publication = mono_selective_emission_publication_v1()
        expect(env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", saved)).to_equal(true)
        expect(env_set("SIMPLE_MIR_SELECTIVE", selective_saved)).to_equal(true)
        expect(second.diagnostics.len()).to_be_greater_than(0)
        expect(publication.is_err()).to_equal(true)
