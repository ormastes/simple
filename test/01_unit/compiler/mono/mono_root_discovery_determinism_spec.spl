# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
# 40.mono root discovery: identical output to the full root walk

`MonomorphizationPass.root_discovery` (env `SIMPLE_MONO_ROOT_DISCOVERY=1`)
passes a ROOT function through unchanged when a read-only pre-walk proves its
body has no mono-relevant site (generic call, generic constructor, static
generic factory, generic impl method name, generic type field name). The
result must be identical to the full walk: same specialization names, same
minted symbol ids, same statistics, same E-MONO diagnostics and warnings in
the same order, and byte-identical encoded HIR per module.
"""

# @tag:unit
# @tag:compiler
# @tag:mono
# @tag:generics
# @tag:determinism

use std.spec
use compiler.common.config.Logger
use compiler.common.driver_core_types.SourceFile
use compiler.frontend.parser_types.{Module}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.hirlowering_for_module
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.mono.monomorphize_integration.{MonomorphizationPass, mono_last_phase_profile_v1}
use std.env.variables.{env_get, env_set}

struct DiscoveryLowered:
    modules: Dict<text, HirModule>
    errors: [text]

struct DiscoveryRun:
    modules: Dict<text, HirModule>
    pass_: MonomorphizationPass

fn discovery_lower(src: text) -> DiscoveryLowered:
    val log = Logger(level: 0)
    val name = "disc_main"
    val parsed_module = parse_full_frontend(src, name + ".spl", name, log)
    var parsed: Dict<text, Module> = {}
    parsed[name] = parsed_module
    val surfaces_result = module_surfaces_from_modules(parsed, [
        SourceFile(path: name + ".spl", content: src, module_name: name)])
    if surfaces_result.is_err():
        return DiscoveryLowered(modules: {}, errors: ["surface build failed: " + surfaces_result.unwrap_err()])
    var hl = hirlowering_for_module(name, surfaces_result.unwrap())
    var hir: Dict<text, HirModule> = {}
    hir[name] = hl.lower_module(parsed_module)
    var errors: [text] = []
    for e in hl.errors:
        errors.push(e.message)
    DiscoveryLowered(modules: hir, errors: errors)

fn discovery_run(src: text, discovery: bool) -> DiscoveryRun:
    discovery_run_env(src, discovery, if discovery: "1" else: "0")

# Discovery is ON by default (env unset), so the full-walk baseline must pin
# SIMPLE_MONO_ROOT_DISCOVERY=0 or it silently compares discovery to itself.
fn discovery_run_env(src: text, discovery: bool, env_value: text) -> DiscoveryRun:
    # Lower afresh per run: the two passes must not share one input value.
    val low = discovery_lower(src)
    val previous = env_get("SIMPLE_MONO_ROOT_DISCOVERY")
    env_set("SIMPLE_MONO_ROOT_DISCOVERY", env_value)
    var pass_ = MonomorphizationPass.create()
    pass_.root_discovery = discovery
    val out = pass_.process_modules(low.modules)
    env_set("SIMPLE_MONO_ROOT_DISCOVERY", previous)
    DiscoveryRun(modules: out, pass_: pass_)

fn discovery_fingerprint(run: DiscoveryRun) -> text:
    """Everything observable downstream, in a fixed order."""
    var lines: [text] = []
    val st = run.pass_.get_stats()
    lines.push("stats {st.generic_functions_found} {st.generic_structs_found} {st.generic_classes_found} {st.call_sites_found} {st.specializations_created} {st.unresolved_generic_calls}")
    for d in run.pass_.diagnostics:
        lines.push("diag " + d)
    for w in run.pass_.warnings:
        lines.push("warn " + w)
    for mangled in run.pass_.spec_queue:
        lines.push("spec {mangled} sym={run.pass_.spec_symbols[mangled]} owner={run.pass_.spec_module[mangled]}")
    lines.push("next_symbol {run.pass_.next_symbol}")
    for name in run.modules.keys().sort():
        val m: HirModule = run.modules[name]
        var fnames: [text] = []
        for sym in m.functions.keys():
            val f: HirFunction = m.functions[sym]
            fnames.push("{f.name}#{f.symbol.id}")
        lines.push("module {name} fns=" + fnames.sort().join(","))
        lines.push("module {name} hir=" + hir_module_encode(m))
    lines.join("\n")

fn discovery_roots_rewritten(run: DiscoveryRun) -> i64:
    # The profile is "... roots=<n> roots_rewritten=<m> ...".
    var out = -1
    for part in mono_last_profile_parts():
        if part.starts_with("roots_rewritten="):
            out = i64(part.substring(16, part.len()))
    out

fn mono_last_profile_parts() -> [text]:
    mono_last_phase_profile_v1.split(" ")

# Generic free functions (nested, two call sites at one type, explicit type
# args), a generic struct read through its field, a generic impl method, a
# lambda calling a generic, a string interpolation calling a generic, an
# unresolvable generic call (E-MONO-032), a module constant whose initializer
# calls a generic (rewritten under the env the LAST root leaves; `main` is
# inert, so discovery must rebuild that env), and several inert roots that
# the discovery walk must pass through untouched.
val discovery_src = "struct Box<T>:\n" +
    "    item: T\n" +
    "\n" +
    "impl<T> Box<T>:\n" +
    "    fn get(self) -> T:\n" +
    "        self.item\n" +
    "\n" +
    "fn wrap<T>(x: T) -> T:\n" +
    "    x\n" +
    "\n" +
    "fn pick<A, B>(a: A, b: B) -> B:\n" +
    "    b\n" +
    "\n" +
    "fn none_of<T>() -> T?:\n" +
    "    nil\n" +
    "\n" +
    "fn inert_add(a: i64, b: i64) -> i64:\n" +
    "    val c = a + b\n" +
    "    if c > 3:\n" +
    "        return c * 2\n" +
    "    c\n" +
    "\n" +
    "fn inert_text(s: text) -> text:\n" +
    '    "<{s}>"' + "\n" +
    "\n" +
    "fn uses_nested() -> i64:\n" +
    "    wrap(wrap(5)) + wrap(7)\n" +
    "\n" +
    "fn uses_two(s: text) -> text:\n" +
    "    pick(1, s)\n" +
    "\n" +
    "fn uses_box() -> text:\n" +
    "    val b = Box(item: \"x\")\n" +
    "    b.item + b.get()\n" +
    "\n" +
    "fn uses_lambda() -> i64:\n" +
    "    val f = \\v: wrap(v)\n" +
    "    f(3)\n" +
    "\n" +
    "fn uses_interp(s: text) -> text:\n" +
    '    "v={wrap(s)}"' + "\n" +
    "\n" +
    "fn uses_unresolved() -> i64:\n" +
    "    val v = none_of()\n" +
    "    0\n" +
    "\n" +
    "val seed_value: i64 = wrap(4)\n" +
    "\n" +
    "fn main() -> i64:\n" +
    "    inert_add(1, 2) + uses_nested() + uses_lambda() + inert_text(\"q\").len()\n"

describe "40.mono root discovery is output-identical to the full root walk":
    it "lowers the fixture without HIR errors":
        val low = discovery_lower(discovery_src)
        expect(low.errors.len()).to_equal(0)

    it "produces identical specializations, ids, diagnostics and HIR":
        val full = discovery_run(discovery_src, false)
        val full_print = discovery_fingerprint(full)
        val disc = discovery_run(discovery_src, true)
        val disc_print = discovery_fingerprint(disc)
        expect(full.pass_.stats.specializations_created > 0).to_equal(true)
        expect(disc_print).to_equal(full_print)

    it "keeps the fail-closed E-MONO-032 diagnostic under discovery":
        val disc = discovery_run(discovery_src, true)
        var found = false
        for d in disc.pass_.diagnostics:
            if d.contains("E-MONO-032"):
                found = true
        expect(found).to_equal(true)

    it "actually skips the inert roots":
        val full = discovery_run(discovery_src, false)
        val full_rewritten = discovery_roots_rewritten(full)
        val disc = discovery_run(discovery_src, true)
        val disc_rewritten = discovery_roots_rewritten(disc)
        expect(full_rewritten > disc_rewritten).to_equal(true)
        expect(disc_rewritten > 0).to_equal(true)

    it "is on by default when the env var is unset":
        val full = discovery_run(discovery_src, false)
        val dflt = discovery_run_env(discovery_src, false, "")
        expect(discovery_roots_rewritten(full) > discovery_roots_rewritten(dflt)).to_equal(true)
        expect(discovery_fingerprint(dflt)).to_equal(discovery_fingerprint(full))
