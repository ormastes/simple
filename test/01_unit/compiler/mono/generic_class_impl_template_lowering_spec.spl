"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/mono/generic_class_impl_template_lowering_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/generic_class_impl_template_lowering_spec.md
# doc-path: doc/03_plan/sys_test/generic_class_impl_template_lowering_spec.md
# doc-path: doc/04_architecture/generic_class_impl_template_lowering_spec.md
# doc-path: doc/05_design/generic_class_impl_template_lowering_spec_oracles.md
# @manual: primary

"""
# Generic class / generic impl lower as NON-EMITTABLE templates (#158 Phase C)

Before this fix, `class Future<T>:` and `impl Poll<T>:` were HARD ERRORS at
their DECLARATION site in HIR lowering, regardless of whether anything ever
instantiated them. That blocked the stage1 bootstrap closure on three sites
that have ZERO instantiations anywhere in the closure:

    src/lib/nogc_async_mut/async/future.spl  class Future<T>      (class tier)
    src/lib/nogc_async_mut/async/future.spl  Future<T>'s methods  (impl tier)
    src/lib/nogc_async_mut/async/poll.spl    impl Poll<T>         (impl tier)

Per the hardening plan 9.3 step 12 ("Remove or mark generic templates
non-emittable"), declaring a template is not the defect -- EMITTING one is.
The declaration now lowers and is flagged `is_generic_template`; MIR skips
every flagged function; a reachable instantiation still fails loudly in
40.mono (E-MONO-030/032) and in strict MIR (HWIR-E-GENERIC).

Pre-fix these examples produced HIR errors; the type-param and template-flag
assertions below all failed.
"""

use std.spec
use std.spec.step
use std.spec.fail
use compiler.common.config.Logger
use compiler.common.driver_core_types.SourceFile
use compiler.frontend.parser_types.{Module}
use compiler.frontend.parser_types_expr.{TypeKind}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.hirlowering_for_module
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule, HirTypeKind}
use compiler.hir.hir_definitions.{HirFunction}


# The stage1 blockers, reduced. `Poll2` mirrors src/lib/.../async/poll.spl
# (generic enum + generic inherent impl); `Fut` mirrors the generic class in
# async/future.spl (type-parameterised class with inline methods).
val SRC = "enum Poll2<T>:\n" +
    "    Ready(T)\n" +
    "    Pending\n" +
    "\n" +
    "impl Poll2<T>:\n" +
    "    fn is_pending(self) -> bool:\n" +
    "        return false\n" +
    "\n" +
    "class Fut<T>:\n" +
    "    tag: i64\n" +
    "\n" +
    "    fn tag_of(self) -> i64:\n" +
    "        return self.tag\n" +
    "\n" +
    "fn main() -> i64:\n" +
    "    return 0\n"

struct Lowered:
    module: HirModule
    errors: [text]

fn lower_one(name: text, src: text) -> Lowered:
    val log = Logger(level: 0)
    val parsed_mod = parse_full_frontend(src, name + ".spl", name, log)
    var parsed: Dict<text, Module> = {}
    parsed[name] = parsed_mod
    val surfaces_result = module_surfaces_from_modules(parsed, [
        SourceFile(path: name + ".spl", content: src, module_name: name)])
    if surfaces_result.is_err():
        return Lowered(module: nil, errors: ["surface build failed: " + surfaces_result.unwrap_err()])
    var hl = hirlowering_for_module(name, surfaces_result.unwrap())
    val m = hl.lower_module(parsed_mod)
    var errors: [text] = []
    for e in hl.errors:
        errors.push(e.message)
    Lowered(module: m, errors: errors)

fn gate_error_count(errs: [text]) -> i64:
    var n = 0
    for e in errs:
        if e.contains("monomorphization is not implemented"):
            n = n + 1
    n

fn template_function_count(m: HirModule) -> i64:
    var n = 0
    for sym in m.functions.keys():
        val f: HirFunction = m.functions[sym]
        if f.is_generic_template:
            n = n + 1
    n

fn expect_bound_method_receivers(m: HirModule, expected_methods: i64, expected_arguments: i64):
    expect(m.impls.len()).to_equal(1)
    val implementation = m.impls[0]
    expect(implementation.type_params.len()).to_equal(expected_arguments)
    var checked = 0
    for function in m.functions.values():
        if function.is_method and not function.is_static:
            expect(function.params.len()).to_be_greater_than(0)
            match implementation.type_.kind:
                case HirTypeKind.Named(expected_owner, _):
                    match function.params[0].type_.kind:
                        case HirTypeKind.Named(actual_owner, arguments):
                            expect(actual_owner).to_equal(expected_owner)
                            expect(arguments.len()).to_equal(expected_arguments)
                            for index in 0..expected_arguments:
                                match arguments[index].kind:
                                    case HirTypeKind.Named(parameter, nested):
                                        expect(parameter).to_equal(implementation.type_params[index].symbol)
                                        expect(nested.len()).to_equal(0)
                                    case _: fail("receiver argument lost its bound impl parameter")
                        case _: fail("method receiver lost its nominal owner")
                case _: fail("generic impl lost its nominal owner")
            checked = checked + 1
    expect(checked).to_equal(expected_methods)

describe "generic class and generic impl lower as non-emittable templates":
    it "raises no declaration-site monomorphization gate error":
        # @req: REQ-SSPEC-LOCAL-001
        step("Lower a module declaring impl Poll2<T> and class Fut<T>")
        val out = lower_one("phase_c_tpl", SRC)
        step("Confirm the #158 declaration gates no longer fire")
        expect(gate_error_count(out.errors)).to_equal(0)

    it "lowers the module without errors at all":
        # @req: REQ-SSPEC-LOCAL-001
        step("Lower the same module")
        val out = lower_one("phase_c_tpl2", SRC)
        step("Confirm the uninstantiated templates are not an error")
        expect(out.errors.len()).to_equal(0)

    it "records the generic class as a template":
        # @req: REQ-SSPEC-LOCAL-001
        step("Lower and inspect HirClass.is_generic_template")
        val out = lower_one("phase_c_tpl3", SRC)
        var flagged = false
        for cn in out.module.classes.keys():
            val c = out.module.classes[cn]
            if c.name == "Fut":
                flagged = c.is_generic_template
        expect(flagged).to_equal(true)

    it "flags at least one method as a non-emittable template":
        # @req: REQ-SSPEC-LOCAL-001
        step("Lower and count is_generic_template functions")
        val out = lower_one("phase_c_tpl4", SRC)
        step("Both the impl method and the class method are templates")
        expect(template_function_count(out.module) > 0).to_equal(true)

    it "keeps the non-generic entry function emittable":
        # @req: REQ-SSPEC-LOCAL-001
        step("main() must NOT be flagged as a template")
        val out = lower_one("phase_c_tpl5", SRC)
        var main_is_template = true
        for sym in out.module.functions.keys():
            val f: HirFunction = out.module.functions[sym]
            if f.name == "main":
                main_is_template = f.is_generic_template
        expect(main_is_template).to_equal(false)


    it "retains ordered enum binders on the synthetic method receiver":
        step("Parse inline methods of a two-parameter generic enum")
        val source = "enum Ordered<First, Second>:\n    Pair(Second, First)\n    fn first(default: First) -> First:\n        default\n"
        val parsed = parse_full_frontend(source, "enum_ordered.spl", "enum_ordered", Logger(level: 0))
        expect(parsed.impls.len()).to_equal(1)
        expect(parsed.impls[0].type_params.len()).to_equal(2)
        expect(parsed.impls[0].type_params[0].name).to_equal("First")
        expect(parsed.impls[0].type_params[1].name).to_equal("Second")
        var receiver_name = ""
        var argument_names: [text] = []
        match parsed.impls[0].type_.kind:
            case TypeKind.Named(name, args):
                receiver_name = name
                for argument in args:
                    match argument.kind:
                        case TypeKind.Named(parameter_name, _): argument_names.push(parameter_name)
                        case _: argument_names.push("invalid")
            case _: ()
        expect(receiver_name).to_equal("Ordered")
        expect(argument_names).to_equal(["First", "Second"])

    it "lowers match self with impl-bound nominal type parameters":
        step("Lower the FailSafeResult unwrap_or and is_ok shapes without a library workaround")
        val source = "enum PatternResult<T>:\n    Ok(T)\n    Err(text)\n    fn unwrap_or(default: T) -> T:\n        match self:\n            case Ok(v): v\n            case Err(_): default\n    fn is_ok() -> bool:\n        match self:\n            case Ok(_): true\n            case Err(_): false\n"
        val out = lower_one("enum_self_payload", source)
        expect(out.errors.len()).to_equal(0)
        expect(template_function_count(out.module)).to_equal(2)
        expect_bound_method_receivers(out.module, 2, 1)
        expect(out.module.impls.len()).to_equal(1)
        val implementation = out.module.impls[0]
        expect(implementation.type_params.len()).to_equal(1)
        # Declaration payload templates use HirTypeKind.TypeParam, while an
        # in-scope impl parameter is Named(the bound TypeParam symbol, []).
        # Assert that identity rather than weakening the concrete-slot guard.
        var receiver_parameter_is_bound = false
        match implementation.type_.kind:
            case HirTypeKind.Named(_, args):
                if args.len() == 1:
                    match args[0].kind:
                        case HirTypeKind.Named(parameter_symbol, parameter_args):
                            receiver_parameter_is_bound = parameter_symbol == implementation.type_params[0].symbol and parameter_args.len() == 0
                        case _: ()
            case _: ()
        expect(receiver_parameter_is_bound).to_equal(true)

    it "keeps receiver binders in declaration order when payload order differs":
        step("Lower a generic enum method whose variant reverses its binder order")
        val source = "enum Ordered<First, Second>:\n    Pair(Second, First)\n    fn first(default: First) -> First:\n        match self:\n            case Pair(second, first): first\n"
        val out = lower_one("enum_ordered_receiver", source)
        expect(out.errors.len()).to_equal(0)
        expect_bound_method_receivers(out.module, 1, 2)

    it "preserves an explicitly annotated receiver of another type":
        step("An applied generic owner must not replace a different receiver annotation")
        val source = "enum Annotated<T>:\n    Value(T)\n    fn probe(self: i64) -> i64:\n        self\n"
        val out = lower_one("enum_annotated_receiver", source)
        expect(out.errors.len()).to_equal(0)
        var checked = 0
        for function in out.module.functions.values():
            if function.name == "probe":
                expect(function.params.len()).to_equal(1)
                match function.params[0].type_.kind:
                    case HirTypeKind.Int(bits, signed):
                        expect(bits).to_equal(64)
                        expect(signed).to_equal(true)
                    case _: fail("explicit receiver annotation was replaced")
                checked = checked + 1
        expect(checked).to_equal(1)

    it "does not invent target arguments for an explicit generic bare impl":
        step("An explicit impl<T> Missing keeps its argless target and fails the existing payload guard")
        val source = "enum Missing<T>:\n    Value(T)\nimpl<T> Missing:\n    fn value() -> i64:\n        match self:\n            case Value(v): 1\n"
        val parsed = parse_full_frontend(source, "enum_missing_args.spl", "enum_missing_args", Logger(level: 0))
        expect(parsed.impls[0].type_params.len()).to_equal(1)
        var receiver_argument_count = -1
        match parsed.impls[0].type_.kind:
            case TypeKind.Named(_, args): receiver_argument_count = args.len()
            case _: ()
        expect(receiver_argument_count).to_equal(0)
        val out = lower_one("enum_missing_args", source)
        var rejected_missing_arguments = false
        for error in out.errors:
            if error.contains("generic enum pattern requires concrete declaration-ordered type arguments"):
                rejected_missing_arguments = true
        expect(rejected_missing_arguments).to_equal(true)

    it "does not rewrite the explicit reordered impl opaque target":
        step("Preserve the existing explicit-head refusal marker instead of fabricating positional arguments")
        val source = "enum Ordered<First, Second>:\n    Pair(Second, First)\nimpl<A, B> Ordered<B, A>:\n    fn tag() -> i64:\n        1\n"
        val parsed = parse_full_frontend(source, "enum_explicit.spl", "enum_explicit", Logger(level: 0))
        var argument_names: [text] = []
        match parsed.impls[0].type_.kind:
            case TypeKind.Named(_, args):
                for argument in args:
                    match argument.kind:
                        case TypeKind.Named(parameter_name, _): argument_names.push(parameter_name)
                        case _: argument_names.push("invalid")
            case _: ()
        expect(argument_names).to_equal(["__any"])
