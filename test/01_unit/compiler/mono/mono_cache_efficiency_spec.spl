"""
Real MonoCache restore/count/capacity regression scenarios.
REQ-MONO-CACHE-RESTORE-001; authored source only, execution UNRUN.
Disk rows restore metadata, never executable specialization bodies.
"""
use std.spec.*
use std.spec.step
use compiler.mono.monomorphize.cache.{MonoCache, MonoCacheConfig, MonoCacheValue}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use std.io_runtime.{mkdir_p, dir_remove, file_exists, file_write, getpid}

fn mono_cache_test_value() -> MonoCacheValue:
    val parsed = parse_full_frontend("fn cached_value() -> i64:\n    7\n", "cache_fixture.spl", "cache_fixture", Logger(level: 0))
    var lowering = HirLowering.with_filename("cache_fixture.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    val symbols = module.functions.keys()
    expect(symbols.len()).to_equal(1)
    MonoCacheValue.Function(module.functions[symbols[0]])

fn mono_cache_test_dir(label: text) -> text:
    val path = "/tmp/simple_mono_cache_{getpid()}_{label}"
    expect(file_exists(path)).to_equal(false)
    expect(mkdir_p(path)).to_equal(true)
    path

fn mono_cache_test_index(path: text, rows: [text]):
    val content = "{ max_entries: 999999999, entry_count: 999999999, entries: [" + rows.join(", ") + "] }"
    expect(file_write("{path}/mono_cache_index.sdn", content)).to_equal(true)

fn mono_cache_test_row(key: text, stamp: i64, hash: i64) -> text:
    "{ key: \"" + key + "\", last_access: " + stamp.to_text() + ", content_hash: " + hash.to_text() + " }"

describe "REQ-MONO-CACHE-RESTORE-001 real cache accounting":
    it "restores actual saved metadata counts and the persisted oldest key":
        step("Save typed production entries and restore metadata without inventing bodies")
        val path = mono_cache_test_dir("roundtrip")
        val value = mono_cache_test_value()
        var original = MonoCache.create(MonoCacheConfig.persistent(path))
        original.store("first", value, 11)
        original.store("second", value, 22)
        original.save_to_disk(path)
        val restored = MonoCache.load_from_disk(path)
        expect(restored.entry_count).to_equal(2)
        expect(restored.entries.keys().len()).to_equal(2)
        expect(restored.oldest_key).to_equal("first")
        expect(restored.entries["first"].content_hash).to_equal(11)
        expect(restored.entries["second"].content_hash).to_equal(22)
        expect(restored.entries["first"].value.?).to_equal(false)
        expect(restored.entries["second"].value.?).to_equal(false)
        expect(dir_remove(path, true)).to_equal(true)

    it "counts duplicate keys once and reconstructs oldest after the last duplicate wins":
        step("Read a real SDN index whose duplicate replaces the previous minimum timestamp")
        val path = mono_cache_test_dir("duplicate")
        mono_cache_test_index(path, [mono_cache_test_row("a", 1, 11),
            mono_cache_test_row("b", 2, 22), mono_cache_test_row("a", 9, 99)])
        var cache = MonoCache.load_from_disk(path)
        expect(cache.entry_count).to_equal(2)
        expect(cache.entries.keys().len()).to_equal(2)
        expect(cache.entries["a"].content_hash).to_equal(99)
        expect(cache.entries["a"].last_access).to_equal(9)
        expect(cache.oldest_key).to_equal("b")
        cache.evict_oldest()
        expect(cache.entries.has("b")).to_equal(false)
        expect(cache.entries.has("a")).to_equal(true)
        expect(cache.entry_count).to_equal(1)
        expect(cache.oldest_key).to_equal("a")
        expect(dir_remove(path, true)).to_equal(true)

    it "replaces a loaded key at capacity without evicting its neighbor":
        step("Hydrate metadata then replace it with a real typed specialization")
        val path = mono_cache_test_dir("replace")
        mono_cache_test_index(path, [mono_cache_test_row("a", 1, 11), mono_cache_test_row("b", 2, 22)])
        var cache = MonoCache.load_from_disk(path)
        var limited = cache.config
        limited.max_entries = 2
        cache.config = limited
        cache.store("b", mono_cache_test_value(), 33)
        expect(cache.entries.has("a")).to_equal(true)
        expect(cache.entries.has("b")).to_equal(true)
        expect(cache.entries["b"].content_hash).to_equal(33)
        expect(cache.entries["b"].value.?).to_equal(true)
        expect(cache.entry_count).to_equal(2)
        expect(cache.entries.keys().len()).to_equal(2)
        expect(cache.stats.evictions).to_equal(0)
        expect(dir_remove(path, true)).to_equal(true)

    it "evicts one persisted oldest entry when inserting a new key at capacity":
        step("Use restored accounting in the production store capacity branch")
        val path = mono_cache_test_dir("evict")
        mono_cache_test_index(path, [mono_cache_test_row("a", 1, 11), mono_cache_test_row("b", 2, 22)])
        var cache = MonoCache.load_from_disk(path)
        var limited = cache.config
        limited.max_entries = 2
        cache.config = limited
        cache.store("c", mono_cache_test_value(), 33)
        expect(cache.entries.has("a")).to_equal(false)
        expect(cache.entries.has("b")).to_equal(true)
        expect(cache.entries.has("c")).to_equal(true)
        expect(cache.entry_count).to_equal(2)
        expect(cache.entries.keys().len()).to_equal(2)
        expect(cache.stats.evictions).to_equal(1)
        expect(dir_remove(path, true)).to_equal(true)

    it "refuses an oversized persisted index instead of trusting its advertised capacity":
        step("Admit at most the trusted persistent capacity, even with forged index counters")
        val path = mono_cache_test_dir("over_capacity")
        val trusted = MonoCacheConfig.persistent(path)
        var rows: [text] = []
        for i in 0..trusted.max_entries:
            rows.push(mono_cache_test_row("key_{i}", i, i))
        mono_cache_test_index(path, rows)
        var full = MonoCache.load_from_disk(path)
        expect(full.entry_count).to_equal(trusted.max_entries)
        expect(full.entries.keys().len()).to_equal(trusted.max_entries)
        expect(full.oldest_key).to_equal("key_0")
        full.clear()
        rows.push(mono_cache_test_row("one_too_many", trusted.max_entries, 7))
        mono_cache_test_index(path, rows)
        val cache = MonoCache.load_from_disk(path)
        expect(cache.config.max_entries).to_equal(trusted.max_entries)
        expect(cache.entry_count).to_equal(0)
        expect(cache.entries.keys().len()).to_equal(0)
        expect(cache.oldest_key).to_equal("")
        expect(dir_remove(path, true)).to_equal(true)

    it "returns an empty cache for a missing or malformed index":
        step("Exercise actual file absence and actual parser refusal")
        val path = mono_cache_test_dir("decode")
        val missing = MonoCache.load_from_disk(path)
        expect(missing.entry_count).to_equal(0)
        expect(missing.entries.keys().len()).to_equal(0)
        expect(file_write("{path}/mono_cache_index.sdn", "{ entries: [")).to_equal(true)
        val malformed = MonoCache.load_from_disk(path)
        expect(malformed.entry_count).to_equal(0)
        expect(malformed.entries.keys().len()).to_equal(0)
        expect(malformed.oldest_key).to_equal("")
        expect(dir_remove(path, true)).to_equal(true)

    it "does not count blank or nontext persisted keys":
        step("Preserve existing ignored-row behavior without phantom accounting")
        val path = mono_cache_test_dir("invalid_keys")
        mono_cache_test_index(path, [mono_cache_test_row("", 1, 1), "{ key: 4 }", mono_cache_test_row("valid", 5, 9)])
        val cache = MonoCache.load_from_disk(path)
        expect(cache.entry_count).to_equal(1)
        expect(cache.entries.keys().len()).to_equal(1)
        expect(cache.oldest_key).to_equal("valid")
        expect(dir_remove(path, true)).to_equal(true)

    it "stores nothing when capacity is zero or negative":
        step("Keep empty disabled caches bounded without synthetic evictions")
        val value = mono_cache_test_value()
        for capacity in [0, -1]:
            var config = MonoCacheConfig.memory_only()
            config.max_entries = capacity
            var cache = MonoCache.create(config)
            cache.store("value", value, 1)
            expect(cache.entry_count).to_equal(0)
            expect(cache.entries.keys().len()).to_equal(0)
            expect(cache.stats.evictions).to_equal(0)

    it "evicts the older neighbor after replacing the recorded oldest entry":
        step("Replace a at capacity then require c to evict b rather than the refreshed a")
        val path = mono_cache_test_dir("replace_oldest")
        mono_cache_test_index(path, [mono_cache_test_row("a", 1, 11), mono_cache_test_row("b", 2, 22)])
        var cache = MonoCache.load_from_disk(path)
        var limited = cache.config
        limited.max_entries = 2
        cache.config = limited
        val value = mono_cache_test_value()
        cache.store("a", value, 33)
        expect(cache.stats.evictions).to_equal(0)
        cache.store("c", value, 44)
        expect(cache.entries.has("a")).to_equal(true)
        expect(cache.entries["a"].content_hash).to_equal(33)
        expect(cache.entries.has("b")).to_equal(false)
        expect(cache.entries.has("c")).to_equal(true)
        expect(cache.entry_count).to_equal(2)
        expect(cache.entries.keys().len()).to_equal(2)
        expect(cache.stats.evictions).to_equal(1)
        expect(dir_remove(path, true)).to_equal(true)

    it "preserves deferred oldest discovery across intervening writes":
        step("Do not let an intervening insert or replacement hide the older retained neighbor")
        val path = mono_cache_test_dir("deferred_oldest")
        mono_cache_test_index(path, [mono_cache_test_row("a", 1, 11), mono_cache_test_row("b", 2, 22)])
        var cache = MonoCache.load_from_disk(path)
        var limited = cache.config
        limited.max_entries = 3
        cache.config = limited
        val value = mono_cache_test_value()
        cache.store("a", value, 33)
        cache.store("c", value, 44)
        cache.store("c", value, 55)
        expect(cache.stats.evictions).to_equal(0)
        cache.store("d", value, 66)
        expect(cache.entries.has("b")).to_equal(false)
        expect(cache.entries.has("a")).to_equal(true)
        expect(cache.entries.has("c")).to_equal(true)
        expect(cache.entries["c"].content_hash).to_equal(55)
        expect(cache.entries.has("d")).to_equal(true)
        expect(cache.entry_count).to_equal(3)
        expect(cache.entries.keys().len()).to_equal(3)
        expect(cache.stats.evictions).to_equal(1)
        expect(dir_remove(path, true)).to_equal(true)

    it "reestablishes oldest after replacing and evicting a singleton":
        step("A deferred minimum with one retained entry still permits bounded replacement")
        val value = mono_cache_test_value()
        var config = MonoCacheConfig.memory_only()
        config.max_entries = 1
        var cache = MonoCache.create(config)
        cache.store("a", value, 11)
        cache.store("a", value, 22)
        expect(cache.stats.evictions).to_equal(0)
        cache.store("b", value, 33)
        expect(cache.entries.has("a")).to_equal(false)
        expect(cache.entries.has("b")).to_equal(true)
        expect(cache.entry_count).to_equal(1)
        expect(cache.entries.keys().len()).to_equal(1)
        expect(cache.oldest_key).to_equal("b")
        expect(cache.stats.evictions).to_equal(1)
