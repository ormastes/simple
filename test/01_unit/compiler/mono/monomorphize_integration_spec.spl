# Monomorphization Integration Test Specification
#
# Tests for monomorphization pipeline integration.
# Verifies that the driver correctly runs monomorphization pass.

extern fn rt_file_read_text(path: text) -> text

# ============================================================================
# Documentation Tests (interpreter-compatible)
# ============================================================================

use std.spec.step
use compiler.common.diagnostics.span.Span
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirEnumPayload}
use compiler.mono.monomorphize_integration.MonomorphizationPass

fn payload_evidence_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn payload_evidence_expr(type_: HirType, payload: HirEnumPayload?) -> HirExpr:
    HirExpr(kind: HirExprKind.EnumLit(type_, "Ok", payload),
        has_type_: false, type_: nil, span: Span.empty())

describe "Result missing-arm payload evidence":
    it "rejects an absent payload without treating Option as HirEnumPayload":
        step("reject absent Result payload evidence")
        var pass_ = MonomorphizationPass.create()
        val integer = payload_evidence_type(HirTypeKind.Int(64, true))
        val partial = payload_evidence_type(HirTypeKind.Result(integer, payload_evidence_type(HirTypeKind.Infer(1, 0))))
        expect(pass_.call_evidence_is_valid_v1(payload_evidence_expr(partial, nil), partial)).to_equal(false)

    it "accepts exactly one concrete payload matching the active Result arm":
        step("accept concrete Result tuple payload evidence")
        var pass_ = MonomorphizationPass.create()
        val integer = payload_evidence_type(HirTypeKind.Int(64, true))
        val partial = payload_evidence_type(HirTypeKind.Result(integer, payload_evidence_type(HirTypeKind.Infer(1, 0))))
        val value = HirExpr(kind: HirExprKind.IntLit(7, "i64"), has_type_: true, type_: integer, span: Span.empty())
        expect(pass_.call_evidence_is_valid_v1(payload_evidence_expr(partial, HirEnumPayload.Tuple([value])), partial)).to_equal(true)

    it "rejects empty, multiple, named and mismatched payload evidence":
        step("reject malformed Result payload evidence")
        var pass_ = MonomorphizationPass.create()
        val integer = payload_evidence_type(HirTypeKind.Int(64, true))
        val boolean = payload_evidence_type(HirTypeKind.Bool)
        val partial = payload_evidence_type(HirTypeKind.Result(integer, payload_evidence_type(HirTypeKind.Infer(1, 0))))
        val value = HirExpr(kind: HirExprKind.IntLit(7, "i64"), has_type_: true, type_: integer, span: Span.empty())
        val wrong = HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true, type_: boolean, span: Span.empty())
        val malformed: [HirEnumPayload] = [HirEnumPayload.Tuple([]), HirEnumPayload.Tuple([value, value]), HirEnumPayload.Struct([("value", value)]), HirEnumPayload.Tuple([wrong])]
        for payload in malformed:
            expect(pass_.call_evidence_is_valid_v1(payload_evidence_expr(partial, payload), partial)).to_equal(false)

describe "Monomorphization Pipeline Integration":
    describe "Driver Integration":
        it "Phase 4 runs after Phase 3 (HIR lowering)":
            # @req REQ-SSPEC-COMPILER
            step("Phase 4 runs after Phase 3 (HIR lowering)")
            # Driver.compile() flow:
            # Phase 1: Load sources
            # Phase 2: Parse
            # Phase 3: Lower to HIR + resolve methods + type check
            # Phase 4: Monomorphization (NEW)
            # Phase 5: Mode-specific processing
            pass

        it "checks driver errors before replacing HIR modules":
            # @req REQ-SSPEC-COMPILER
            step("checks driver errors before replacing HIR modules")
            val source = rt_file_read_text(
                "src/compiler/80.driver/driver_hir_pipeline_passes.spl") ?? ""
            val error_guard = source.index_of("if not hir_phase_admitted:")
            val mono_call = source.index_of(
                "run_monomorphization_with_diagnostics(self.ctx.hir_modules)")
            val module_assignment = source.index_of(
                "self.ctx.hir_modules = mono_modules")
            val success_return = source.index_of(
                "        true\n\npub fn run_typecheck_warn_pass")
            expect(error_guard).to_be_greater_than(-1)
            expect(mono_call).to_be_greater_than(error_guard)
            expect(module_assignment).to_be_greater_than(mono_call)
            expect(success_return).to_be_greater_than(module_assignment)
            expect(source.contains("self.ctx.errors.len()")).to_equal(false)

