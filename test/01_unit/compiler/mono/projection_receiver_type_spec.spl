# Rewriter regressions: an inferred projection must carry its nominal receiver
# type into MIR, not merely answer infer_expr_type queries correctly.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mono.monomorphize_integration.{MonomorphizationPass, run_monomorphization_with_diagnostics}

fn projection_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn projection_expr(kind: HirExprKind) -> HirExpr:
    HirExpr(kind: kind, has_type_: false, span: Span.empty())

fn projection_base(type_: HirType) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(SymbolId(id: 901)), has_type_: true, type_: type_, span: Span.empty())

fn projection_slot(slot: i64) -> HirExpr:
    projection_expr(HirExprKind.IntLit(slot, "i64"))

describe "mono persists projection receiver types for MIR field layout":
    it "stamps nominal tuple array slice and dictionary projections and TupleIndex":
        var pass_ = MonomorphizationPass.create()
        pass_.current_module = "consumer"
        val record = projection_type(HirTypeKind.Named(SymbolId(id: 301), []))
        val text_type = projection_type(HirTypeKind.Str)
        val containers = [projection_type(HirTypeKind.Tuple([text_type, record])),
            projection_type(HirTypeKind.Array(record, nil)), projection_type(HirTypeKind.Slice(record)),
            projection_type(HirTypeKind.Dict(text_type, record))]
        val selectors = [projection_slot(1), projection_slot(0), projection_slot(0), projection_expr(HirExprKind.StringLit("keep", nil))]
        var index = 0
        for container in containers:
            val projected = pass_.rewrite_expr(projection_expr(HirExprKind.Index(projection_base(container), selectors[index])))
            expect(projected.has_type_).to_equal(true)
            expect(projected.type_.kind == record.kind).to_equal(true)
            if index == 1 or index == 2:
                val dynamic_index = projection_base(projection_type(HirTypeKind.Int(64, true)))
                val dynamic_projection = pass_.rewrite_expr(projection_expr(HirExprKind.Index(projection_base(container), dynamic_index)))
                expect(dynamic_projection.has_type_).to_equal(true)
                expect(dynamic_projection.type_.kind == record.kind).to_equal(true)
            index = index + 1
        val tuple_projection = pass_.rewrite_expr(projection_expr(HirExprKind.TupleIndex(projection_base(containers[0]), 1)))
        expect(tuple_projection.has_type_).to_equal(true)
        expect(tuple_projection.type_.kind == record.kind).to_equal(true)

    it "preserves caller nominal identity when projecting provider-owned field containers":
        var pass_ = MonomorphizationPass.create()
        pass_.current_module = "consumer"
        var provider = SymbolTable.new()
        var consumer = SymbolTable.new()
        val record = provider.define("Record", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "provider")
        val collision = consumer.define("Other", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "consumer")
        val imported = consumer.define("Record", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "provider")
        val holder = consumer.define("Holder", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "consumer")
        pass_.module_symbols["provider"] = provider
        pass_.module_symbols["consumer"] = consumer
        pass_.named_symbol_names["consumer#{holder.id}"] = "Holder"
        pass_.named_symbol_names["consumer#{imported.id}"] = "Record"
        pass_.named_symbol_names["provider#{record.id}"] = "Record"
        pass_.env[901] = projection_type(HirTypeKind.Named(holder, []))
        val nominal = projection_type(HirTypeKind.Named(record, []))
        val text_type = projection_type(HirTypeKind.Str)
        val containers = [projection_type(HirTypeKind.Tuple([text_type, nominal])),
            projection_type(HirTypeKind.Array(nominal, nil)), projection_type(HirTypeKind.Slice(nominal)),
            projection_type(HirTypeKind.Dict(text_type, nominal))]
        val selectors = [projection_slot(1), projection_slot(0), projection_slot(0), projection_expr(HirExprKind.StringLit("keep", nil))]
        pass_.field_types["Record::value"] = projection_type(HirTypeKind.Int(64, true))
        pass_.field_owner_modules["Record::value"] = "provider"
        var index = 0
        for container in containers:
            pass_.field_types["Holder::items"] = container
            pass_.field_owner_modules["Holder::items"] = "provider"
            val holder_read = projection_expr(HirExprKind.Var(SymbolId(id: 901)))
            val items = projection_expr(HirExprKind.Field(holder_read, "items", nil))
            val projection = projection_expr(HirExprKind.Index(items, selectors[index]))
            val member = pass_.rewrite_expr(projection_expr(HirExprKind.Field(projection, "value", nil)))
            expect(member.has_type_).to_equal(true)
            expect(member.type_.kind == HirTypeKind.Int(64, true)).to_equal(true)
            match member.kind:
                case HirExprKind.Field(receiver, _, _):
                    expect(receiver.has_type_).to_equal(true)
                    expect(receiver.type_.kind == HirTypeKind.Named(imported, [])).to_equal(true)
                    expect(receiver.type_.kind == HirTypeKind.Named(collision, [])).to_equal(false)
                case _: assert(false)
            if index == 0:
                val tuple_projection = pass_.rewrite_expr(projection_expr(HirExprKind.TupleIndex(items, 1)))
                expect(tuple_projection.has_type_).to_equal(true)
                expect(tuple_projection.type_.kind == HirTypeKind.Named(imported, [])).to_equal(true)
            index = index + 1
        expect(pass_.diagnostics.len()).to_equal(0)

    it "leaves invalid and unknown projections unstamped and keeps concrete annotations":
        var pass_ = MonomorphizationPass.create()
        val integer = projection_type(HirTypeKind.Int(64, true))
        val text_type = projection_type(HirTypeKind.Str)
        val tuple_base = projection_base(projection_type(HirTypeKind.Tuple([text_type, integer])))
        val unknown_tuple = projection_base(projection_type(HirTypeKind.Tuple([projection_type(HirTypeKind.Infer(0, 0))])))
        val dynamic_index = projection_base(integer)
        val text_index = projection_expr(HirExprKind.StringLit("key", nil))
        val invalid = [projection_expr(HirExprKind.Index(tuple_base, projection_slot(-1))),
            projection_expr(HirExprKind.Index(tuple_base, projection_slot(2))),
            projection_expr(HirExprKind.Index(tuple_base, dynamic_index)),
            projection_expr(HirExprKind.TupleIndex(tuple_base, 2)),
            projection_expr(HirExprKind.TupleIndex(unknown_tuple, 0)),
            projection_expr(HirExprKind.Index(projection_base(projection_type(HirTypeKind.Array(integer, nil))), text_index)),
            projection_expr(HirExprKind.Index(projection_base(projection_type(HirTypeKind.Slice(integer))), text_index)),
            projection_expr(HirExprKind.Index(projection_base(projection_type(HirTypeKind.Dict(text_type, integer))), projection_slot(0)))]
        for expression in invalid:
            expect(pass_.rewrite_expr(expression).has_type_).to_equal(false)
        var annotated = projection_expr(HirExprKind.TupleIndex(tuple_base, 1))
        annotated.has_type_ = true
        annotated.type_ = projection_type(HirTypeKind.Bool)
        expect(pass_.rewrite_expr(annotated).type_.kind == HirTypeKind.Bool).to_equal(true)

    it "persists the retained dictionary tuple element receiver in the source pipeline":
        val source = "struct Record:\n    name: text\n    value: i64\nfn inspect(values: Dict<text, (text, Record)>) -> i64:\n    val retained = values[\"keep\"]\n    retained[1].value\n"
        val parsed = parse_full_frontend(source, "projection_receiver.spl", "projection_receiver", Logger(level: 0))
        var lowering = HirLowering.with_filename("projection_receiver.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var modules: Dict<text, HirModule> = {}
        modules["projection_receiver"] = hir
        val (out, stats, diagnostics) = run_monomorphization_with_diagnostics(modules)
        expect(diagnostics.len()).to_equal(0)
        expect(stats.unresolved_generic_calls).to_equal(0)
        var checked = 0
        val module = out["projection_receiver"]
        for key in module.functions.keys():
            val function: HirFunction = module.functions[key]
            if function.name != "inspect": continue
            match function.body.value.kind:
                case HirExprKind.Field(receiver, name, _):
                    expect(name).to_equal("value")
                    expect(receiver.has_type_).to_equal(true)
                    match receiver.kind:
                        case HirExprKind.Index(_, _): ()
                        case _: assert(false)
                    match receiver.type_.kind:
                        case HirTypeKind.Named(symbol, _):
                            expect(module.symbols.get_symbol_raw(symbol.id).unwrap().name).to_equal("Record")
                            checked = checked + 1
                        case _: assert(false)
                case _: assert(false)
        expect(checked).to_equal(1)
