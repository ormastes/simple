# @req REQ-SSPEC-UNIT
# Scope: doc/03_plan/phase3_bootstrap_remaining_2026-10-13.md item 7.
# Authored assertions; runtime admission is recorded in the companion manual.
use std.spec
use compiler.common.config.Logger
use compiler.common.diagnostics.span.Span
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable, SymbolKind, Visibility}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirCallArg, HirFunction, HirTypeParam, HirEnumPayload}
use compiler.mono.monomorphize_integration.MonomorphizationPass
use compiler.mono.mono_archive_types_v1.{MonoTemplateSignatureV1, MonoTemplateBodyModeV1}

fn linkage_fixture(flag: text) -> HirModule:
    val source = "fn identity<T>(value: T) -> T:\n    value\nfn invoke() -> i64:\n    identity<i64>(41)\n"
    val parsed = parse_full_frontend(source, "provider.spl", "provider", Logger(level: 0))
    var lowering = HirLowering.with_filename("provider.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.functions.len()).to_equal(2)
    module
fn default_test_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn default_test_parameter(id: i64, name: text, default_: HirType, bounds: [HirType] = []) -> HirTypeParam:
    HirTypeParam(symbol: SymbolId(id: id), name: name, bounds: bounds,
        has_default: default_ != nil, default: default_, span: Span.empty())

fn default_test_pass(mode: MonoTemplateBodyModeV1) -> MonomorphizationPass:
    var module = linkage_fixture("ordinary")
    for key in module.functions.keys():
        var function: HirFunction = module.functions[key]
        if function.name != "identity": continue
        var parameter: HirTypeParam = function.type_params[0]
        parameter.has_default = true
        parameter.default = default_test_type(HirTypeKind.Int(64, true))
        function.type_params = [parameter]
        module.functions[key] = function
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = mode
    pass_.current_module = "provider"
    pass_.collect_generics(module, "provider")
    pass_

describe "generic defaults complete actual caller-owned specialization keys":
    it "keeps empty literal absence until a later witness or declared default":
        var pass_ = MonomorphizationPass.create()
        pass_.current_module = "provider"
        val integer = default_test_type(HirTypeKind.Int(64, true))
        val boolean = default_test_type(HirTypeKind.Bool)
        val parameter = default_test_parameter(701, "T", boolean)
        val pattern = default_test_type(HirTypeKind.TypeParam("T", []))
        val array_pattern = default_test_type(HirTypeKind.Array(pattern, nil))
        val empty = HirExpr(kind: HirExprKind.ArrayLit([], nil), has_type_: false, type_: nil, span: Span.empty())
        val empty_argument = HirCallArg(has_name: false, name: "", value: empty, span: Span.empty())
        val value = HirExpr(kind: HirExprKind.IntLit(9, "i64"), has_type_: true, type_: integer, span: Span.empty())
        val witness = HirCallArg(has_name: false, name: "", value: value, span: Span.empty())
        val signature = MonoTemplateSignatureV1(name: "first_or", param_types: [array_pattern, pattern], return_type: pattern, type_params: [parameter])
        val completed = pass_.resolve_call_type_args_signature_v1(signature, [empty_argument, witness], [])
        expect(completed.is_ok()).to_be(true)
        expect(completed.unwrap()[0].kind == HirTypeKind.Int(64, true)).to_be(true)
        val only_empty = MonoTemplateSignatureV1(name: "empty_default", param_types: [array_pattern], return_type: integer, type_params: [parameter])
        val defaulted = pass_.resolve_call_type_args_signature_v1(only_empty, [empty_argument], [])
        expect(defaulted.is_ok()).to_be(true)
        expect(defaulted.unwrap()[0].kind == HirTypeKind.Bool).to_be(true)
        val required = default_test_parameter(701, "T", nil)
        val no_default = MonoTemplateSignatureV1(name: "empty_required", param_types: [array_pattern], return_type: integer, type_params: [required])
        expect(pass_.resolve_call_type_args_signature_v1(no_default, [empty_argument], []).is_err()).to_be(true)

    it "rejects invalid explicit target evidence without defaulting or publication":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.ArchiveRequests)
        val signature = pass_.template_signature_v1("identity")
        val integer = default_test_type(HirTypeKind.Int(64, true))
        val value = HirExpr(kind: HirExprKind.IntLit(1, "i64"), has_type_: true, type_: integer, span: Span.empty())
        val invalid_types = [default_test_type(HirTypeKind.Any), default_test_type(HirTypeKind.Error), default_test_type(HirTypeKind.Infer(1, 0)), default_test_type(HirTypeKind.Array(default_test_type(HirTypeKind.Any), nil)), default_test_type(HirTypeKind.Result(integer, default_test_type(HirTypeKind.Error)))]
        val before = pass_.next_symbol
        for target in invalid_types:
            val casts = [HirExprKind.Cast(value, target), HirExprKind.As(value, target), HirExprKind.ConvertCall(value, target)]
            for kind in casts:
                val cast = HirExpr(kind: kind, has_type_: false, type_: nil, span: Span.empty())
                val argument = HirCallArg(has_name: false, name: "", value: cast, span: Span.empty())
                val result = pass_.resolve_call_type_args_signature_v1(signature, [argument], [])
                expect(result.is_err()).to_be(true)
                expect(result.unwrap_err()).to_contain("invalid or erased")
                val original = HirExpr(kind: HirExprKind.NamedVar(SymbolId(id: 0), "identity"), has_type_: false, type_: nil, span: Span.empty())
                pass_.rewrite_call(original, [argument], [])
                expect(pass_.spec_symbols.len()).to_equal(0)
                expect(pass_.archive_requests.len()).to_equal(0)
                expect(pass_.stats.specializations_created).to_equal(0)
                expect(pass_.next_symbol).to_equal(before)

    it "retains valid Result missing-arm evidence without accepting nested erasure":
        var pass_ = MonomorphizationPass.create()
        pass_.current_module = "provider"
        val integer = default_test_type(HirTypeKind.Int(64, true))
        val boolean = default_test_type(HirTypeKind.Bool)
        val t = default_test_parameter(801, "T", boolean)
        val e = default_test_parameter(802, "E", boolean)
        val pattern = default_test_type(HirTypeKind.Result(default_test_type(HirTypeKind.TypeParam("T", [])), default_test_type(HirTypeKind.TypeParam("E", []))))
        val signature = MonoTemplateSignatureV1(name: "consume", param_types: [pattern], return_type: integer, type_params: [t, e])
        val value = HirExpr(kind: HirExprKind.IntLit(1, "i64"), has_type_: true, type_: integer, span: Span.empty())
        val partial = default_test_type(HirTypeKind.Result(integer, default_test_type(HirTypeKind.Infer(1, 0))))
        val ok = HirExpr(kind: HirExprKind.EnumLit(partial, "Ok", HirEnumPayload.Tuple([value])), has_type_: false, type_: nil, span: Span.empty())
        val argument = HirCallArg(has_name: false, name: "", value: ok, span: Span.empty())
        val completed = pass_.resolve_call_type_args_signature_v1(signature, [argument], [])
        expect(completed.is_ok()).to_be(true)
        expect(completed.unwrap()[0].kind == HirTypeKind.Int(64, true)).to_be(true)
        expect(completed.unwrap()[1].kind == HirTypeKind.Bool).to_be(true)
        val invalid = default_test_type(HirTypeKind.Result(integer, default_test_type(HirTypeKind.Any)))
        val invalid_ok = HirExpr(kind: HirExprKind.EnumLit(invalid, "Ok", HirEnumPayload.Tuple([value])), has_type_: false, type_: nil, span: Span.empty())
        val invalid_argument = HirCallArg(has_name: false, name: "", value: invalid_ok, span: Span.empty())
        expect(pass_.resolve_call_type_args_signature_v1(signature, [invalid_argument], []).is_err()).to_be(true)
        for target in [default_test_type(HirTypeKind.Any), default_test_type(HirTypeKind.Error), default_test_type(HirTypeKind.Infer(2, 0))]:
            val erased = HirExpr(kind: HirExprKind.Cast(value, target), has_type_: false, type_: nil, span: Span.empty())
            val lying_ok = HirExpr(kind: HirExprKind.EnumLit(partial, "Ok", HirEnumPayload.Tuple([erased])), has_type_: false, type_: nil, span: Span.empty())
            val lying_argument = HirCallArg(has_name: false, name: "", value: lying_ok, span: Span.empty())
            expect(pass_.resolve_call_type_args_signature_v1(signature, [lying_argument], []).is_err()).to_be(true)
        val both_holes = default_test_type(HirTypeKind.Result(default_test_type(HirTypeKind.Infer(3, 0)), default_test_type(HirTypeKind.Infer(4, 0))))
        val unknown_ok = HirExpr(kind: HirExprKind.EnumLit(both_holes, "Ok", HirEnumPayload.Tuple([value])), has_type_: false, type_: nil, span: Span.empty())
        expect(pass_.resolve_call_type_args_signature_v1(signature, [HirCallArg(has_name: false, name: "", value: unknown_ok, span: Span.empty())], []).is_err()).to_be(true)
        val string_type = default_test_type(HirTypeKind.Str)
        val text_value = HirExpr(kind: HirExprKind.StringLit("failure", nil), has_type_: true, type_: string_type, span: Span.empty())
        val partial_error = default_test_type(HirTypeKind.Result(default_test_type(HirTypeKind.Infer(5, 0)), string_type))
        val err = HirExpr(kind: HirExprKind.EnumLit(partial_error, "Err", HirEnumPayload.Tuple([text_value])), has_type_: false, type_: nil, span: Span.empty())
        val error_argument = HirCallArg(has_name: false, name: "", value: err, span: Span.empty())
        val error_completed = pass_.resolve_call_type_args_signature_v1(signature, [error_argument], [])
        expect(error_completed.is_ok()).to_be(true)
        expect(error_completed.unwrap()[0].kind == HirTypeKind.Bool).to_be(true)
        expect(error_completed.unwrap()[1].kind == HirTypeKind.Str).to_be(true)
        val later_pattern = MonoTemplateSignatureV1(name: "consume_witness", param_types: [pattern, default_test_type(HirTypeKind.TypeParam("T", []))], return_type: integer, type_params: [t, e])
        val later = HirCallArg(has_name: false, name: "", value: value, span: Span.empty())
        val witnessed = pass_.resolve_call_type_args_signature_v1(later_pattern, [error_argument, later], [])
        expect(witnessed.is_ok()).to_be(true)
        expect(witnessed.unwrap()[0].kind == HirTypeKind.Int(64, true)).to_be(true)

    it "deduplicates omitted and equivalent explicit scalar defaults in both modes":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = default_test_pass(mode)
            val first = pass_.request_specialization("identity", [])
            expect(first).to_be_greater_than(-1)
            val integer = default_test_type(HirTypeKind.Int(64, true))
            val second = pass_.request_specialization("identity", [integer])
            expect(second).to_equal(first)
            expect(pass_.stats.specializations_created).to_equal(1)
            val signature = pass_.specialization_signature_v1("identity$i64")
            expect(signature.return_type.kind == HirTypeKind.Int(64, true)).to_be(true)
            if mode == MonoTemplateBodyModeV1.ArchiveRequests:
                expect(pass_.archive_requests.len()).to_equal(1)
                expect(pass_.archive_requests[0].type_args.len()).to_equal(1)
                expect(pass_.archive_requests[0].caller_type_args[0].kind == HirTypeKind.Int(64, true)).to_be(true)

    it "keeps inferred evidence instead of the default and rejects inference conflicts":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.Retained)
        val template = pass_.template_signature_v1("identity")
        val value = HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true,
            type_: default_test_type(HirTypeKind.Bool), span: Span.empty())
        val argument = HirCallArg(has_name: false, name: "", value: value, span: Span.empty())
        val inferred = pass_.infer_call_type_args_signature_v1(template, [argument])
        expect(inferred.len()).to_equal(1)
        expect(inferred[0].kind == HirTypeKind.Bool).to_be(true)
        val conflict = pass_.infer_call_type_args_signature_v1(template, [argument], default_test_type(HirTypeKind.Int(64, true)))
        expect(conflict.len()).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(0)

    it "completes sparse and partial-prefix bindings with declaration-owned dependent defaults":
        var pass_ = MonomorphizationPass.create()
        pass_.current_module = "provider"
        val integer = default_test_type(HirTypeKind.Int(64, true))
        val boolean = default_test_type(HirTypeKind.Bool)
        val t = default_test_parameter(101, "T", integer)
        val t_by_symbol = default_test_type(HirTypeKind.Named(SymbolId(id: 101), []))
        val u = default_test_parameter(102, "U", default_test_type(HirTypeKind.Tuple([t_by_symbol, t_by_symbol])))
        val result = pass_.complete_declared_type_args_v1([t, u], [t, u], "provider", {"T": boolean})
        expect(result.is_ok()).to_be(true)
        val completed = result.unwrap()
        expect(completed[0].kind == HirTypeKind.Bool).to_be(true)
        expect(completed[1].kind == HirTypeKind.Tuple([boolean, boolean])).to_be(true)
        val sparse = pass_.complete_declared_type_args_v1([t, u], [t, u], "provider", {"U": boolean})
        expect(sparse.is_ok()).to_be(true)
        expect(sparse.unwrap()[0].kind == HirTypeKind.Int(64, true)).to_be(true)
        expect(sparse.unwrap()[1].kind == HirTypeKind.Bool).to_be(true)
        val signature = MonoTemplateSignatureV1(name: "partial", param_types: [], return_type: integer, type_params: [t, u])
        val prefix = pass_.call_type_args_signature_v1(signature, [], [boolean])
        expect(prefix.len()).to_equal(2)
        expect(prefix[1].kind == HirTypeKind.Tuple([boolean, boolean])).to_be(true)

    it "does not mint requests for cyclic, absent, excessive or newly bounded defaults":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.ArchiveRequests)
        val integer = default_test_type(HirTypeKind.Int(64, true))
        expect(pass_.request_specialization("identity", [integer, integer])).to_equal(-1)
        expect(pass_.archive_requests.len()).to_equal(0)
        expect(pass_.spec_symbols.len()).to_equal(0)
        val cyclic = default_test_parameter(201, "T", default_test_type(HirTypeKind.Named(SymbolId(id: 201), [])))
        val cycle = pass_.complete_declared_type_args_v1([cyclic], [cyclic], "provider", {})
        expect(cycle.is_err()).to_be(true)
        expect(cycle.unwrap_err()).to_contain("cyclic")
        val required = default_test_parameter(202, "U", nil)
        expect(pass_.complete_declared_type_args_v1([required], [required], "provider", {}).is_err()).to_be(true)
        val forward = default_test_parameter(204, "A", default_test_type(HirTypeKind.TypeParam("B", [])))
        val later = default_test_parameter(205, "B", integer)
        expect(pass_.complete_declared_type_args_v1([forward, later], [forward, later], "provider", {"B": integer}).is_err()).to_be(true)
        val invalid = default_test_parameter(206, "Invalid", default_test_type(HirTypeKind.Any))
        expect(pass_.complete_declared_type_args_v1([invalid], [invalid], "provider", {}).is_err()).to_be(true)
        var absent_payload = default_test_parameter(207, "Absent", nil)
        absent_payload.has_default = true
        expect(pass_.complete_declared_type_args_v1([absent_payload], [absent_payload], "provider", {}).is_err()).to_be(true)
        val bounded = default_test_parameter(203, "B", integer, [integer])
        val denied = pass_.complete_declared_type_args_v1([bounded], [bounded], "provider", {})
        expect(denied.is_err()).to_be(true)
        expect(denied.unwrap_err()).to_contain("trait-obligation")
        # Complete already-admitted bounded evidence remains unchanged.
        expect(pass_.complete_declared_type_args_v1([bounded], [bounded], "provider", {"B": integer}).is_ok()).to_be(true)

    it "preserves direct request depth and missing-owner diagnostics before completion":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.ArchiveRequests)
        var nested = default_test_type(HirTypeKind.TypeParam("Outer", []))
        var depth = 0
        while depth < 18:
            nested = default_test_type(HirTypeKind.Optional(nested))
            depth = depth + 1
        expect(pass_.request_specialization("identity", [nested])).to_equal(-1)
        expect(pass_.diagnostics.len()).to_equal(1)
        expect(pass_.diagnostics[0]).to_start_with("E-MONO-030:")
        expect(pass_.archive_requests.len()).to_equal(0)
        expect(pass_.spec_symbols.len()).to_equal(0)
        var missing = MonomorphizationPass.create()
        missing.current_module = "missing"
        val unknown = default_test_type(HirTypeKind.Named(SymbolId(id: 777), []))
        expect(missing.request_specialization("identity", [unknown])).to_equal(-1)
        expect(missing.diagnostics.len()).to_equal(1)
        expect(missing.diagnostics[0]).to_contain("E-MONO-041")
        expect(missing.spec_symbols.len()).to_equal(0)

    it "preserves full supplied lists at the direct completion compatibility seam":
        var pass_ = MonomorphizationPass.create()
        pass_.current_module = "provider"
        val parameter = default_test_parameter(301, "T", nil)
        val outer = default_test_type(HirTypeKind.TypeParam("Outer", []))
        val complete = pass_.complete_declared_type_args_v1([parameter], [parameter], "provider", {"T": outer})
        expect(complete.is_ok()).to_be(true)
        expect(complete.unwrap()[0].kind == HirTypeKind.TypeParam("Outer", [])).to_be(true)
        # This preserves the old seam, not permission to publish unresolved
        # concrete bodies; the existing later validation gates still apply.

    it "does not mask unknown arguments or conflicting explicit prefixes with defaults":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.ArchiveRequests)
        val template = pass_.template_signature_v1("identity")
        val unknown = HirExpr(kind: HirExprKind.Var(SymbolId(id: 999)), has_type_: false, type_: nil, span: Span.empty())
        val argument = HirCallArg(has_name: false, name: "", value: unknown, span: Span.empty())
        val failed = pass_.resolve_call_type_args_signature_v1(template, [argument], [])
        expect(failed.is_err()).to_be(true)
        expect(failed.unwrap_err()).to_contain("no concrete local type")
        expect(pass_.archive_requests.len()).to_equal(0)
        expect(pass_.spec_symbols.len()).to_equal(0)
        val before = pass_.next_symbol
        val explicit_preserved = pass_.resolve_call_type_args_signature_v1(template, [argument], [default_test_type(HirTypeKind.Bool)])
        expect(explicit_preserved.is_ok()).to_be(true)
        expect(explicit_preserved.unwrap()[0].kind == HirTypeKind.Bool).to_be(true)
        expect(pass_.next_symbol).to_equal(before)
        val integer = default_test_type(HirTypeKind.Int(64, true))
        val t = default_test_parameter(401, "T", integer)
        val u = default_test_parameter(402, "U", integer)
        val partial = MonoTemplateSignatureV1(name: "partial", param_types: [default_test_type(HirTypeKind.TypeParam("T", []))], return_type: integer, type_params: [t, u])
        val boolean = HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true, type_: default_test_type(HirTypeKind.Bool), span: Span.empty())
        val known = HirCallArg(has_name: false, name: "", value: boolean, span: Span.empty())
        expect(pass_.resolve_call_type_args_signature_v1(partial, [known], [integer]).is_err()).to_be(true)
        val nongeneric_pattern = MonoTemplateSignatureV1(name: "phantom", param_types: [integer], return_type: integer, type_params: [t])
        expect(pass_.resolve_call_type_args_signature_v1(nongeneric_pattern, [argument], []).is_ok()).to_be(true)

    it "transports imported declaration defaults and preserves their original span":
        var pass_ = MonomorphizationPass.create()
        var provider = SymbolTable.new()
        val token = provider.define("Token", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "provider")
        var consumer = SymbolTable.new()
        consumer.define("padding", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, false, nil)
        pass_.module_symbols["provider"] = provider
        pass_.module_symbols["consumer"] = consumer
        pass_.current_module = "consumer"
        val original_span = Span.new(1, 3, 7, 9)
        val declared = HirType(kind: HirTypeKind.Named(token, []), span: original_span)
        val parameter = default_test_parameter(501, "T", declared)
        val completed = pass_.complete_declared_type_args_v1([parameter], [parameter], "provider", {})
        expect(completed.is_ok()).to_be(true)
        val arguments = completed.unwrap()
        expect(arguments[0].span.line).to_equal(7)
        expect(arguments[0].span.col).to_equal(9)
        pass_.current_module = "provider"
        val owner_key = pass_.type_key(declared)
        pass_.current_module = "consumer"
        expect(pass_.type_key(arguments[0])).to_equal(owner_key)
        expect(owner_key.len()).to_be_greater_than(0)

    it "completes nominal constructor phantom defaults and refuses unknown field evidence":
        var pass_ = MonomorphizationPass.create()
        var provider = SymbolTable.new()
        val box = provider.define("Box", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "provider")
        pass_.module_symbols["provider"] = provider
        pass_.current_module = "provider"
        val identity = pass_.symbol_identity_v1("provider", box)
        val integer = default_test_type(HirTypeKind.Int(64, true))
        pass_.generic_type_params[identity] = [default_test_parameter(601, "T", integer)]
        pass_.generic_type_modules[identity] = "provider"
        pass_.generic_type_field_names[identity] = ["value"]
        pass_.generic_type_fields["{identity}::value"] = integer
        val callee = HirExpr(kind: HirExprKind.NamedVar(box, "Box"), has_type_: false, type_: nil, span: Span.empty())
        val value = HirExpr(kind: HirExprKind.IntLit(41, "i64"), has_type_: true, type_: integer, span: Span.empty())
        val field = HirCallArg(has_name: true, name: "value", value: value, span: Span.empty())
        val omitted = pass_.generic_constructor_type(callee, [field], [])
        val explicit = pass_.generic_constructor_type(callee, [field], [integer])
        expect(omitted != nil).to_be(true)
        expect(explicit != nil).to_be(true)
        val omitted_type: HirType = omitted
        val explicit_type: HirType = explicit
        expect(pass_.type_key(omitted_type)).to_equal(pass_.type_key(explicit_type))
        val unknown = HirExpr(kind: HirExprKind.Var(SymbolId(id: 999)), has_type_: false, type_: nil, span: Span.empty())
        val missing = HirCallArg(has_name: true, name: "value", value: unknown, span: Span.empty())
        pass_.generic_type_fields["{identity}::value"] = default_test_type(HirTypeKind.TypeParam("T", []))
        expect(pass_.generic_constructor_type(callee, [missing], []) == nil).to_be(true)
        for target in [default_test_type(HirTypeKind.Any), default_test_type(HirTypeKind.Error)]:
            val cast = HirExpr(kind: HirExprKind.Cast(value, target), has_type_: false, type_: nil, span: Span.empty())
            val invalid_field = HirCallArg(has_name: true, name: "value", value: cast, span: Span.empty())
            expect(pass_.generic_constructor_type(callee, [invalid_field], []) == nil).to_be(true)
        expect(pass_.diagnostics.join("\n")).to_contain("invalid or erased")

    it "uses completed imported archive arguments for caller and owner metadata":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.ArchiveRequests)
        pass_.module_symbols["consumer"] = SymbolTable.new()
        pass_.current_module = "consumer"
        val first = pass_.request_specialization("identity", [])
        expect(first).to_be_greater_than(-1)
        val integer = default_test_type(HirTypeKind.Int(64, true))
        expect(pass_.request_specialization("identity", [integer])).to_equal(first)
        expect(pass_.archive_requests.len()).to_equal(1)
        val request = pass_.archive_requests[0]
        expect(request.module_name).to_equal("provider")
        expect(request.caller_module).to_equal("consumer")
        expect(request.type_args.len()).to_equal(1)
        expect(request.caller_type_args.len()).to_equal(1)
        expect(request.type_args[0].kind == HirTypeKind.Int(64, true)).to_be(true)
        expect(request.caller_type_args[0].kind == HirTypeKind.Int(64, true)).to_be(true)
        expect(pass_.specialization_signature_v1(request.mangled_name).return_type.kind == HirTypeKind.Int(64, true)).to_be(true)

    it "refuses declaration defaults with missing nominal ownership before publication":
        var pass_ = default_test_pass(MonoTemplateBodyModeV1.ArchiveRequests)
        pass_.module_symbols["consumer"] = SymbolTable.new()
        var signature = pass_.archive_template_signatures["identity"]
        var parameter: HirTypeParam = signature.type_params[0]
        parameter.default = default_test_type(HirTypeKind.Named(SymbolId(id: 999), []))
        signature.type_params = [parameter]
        pass_.archive_template_signatures["identity"] = signature
        pass_.current_module = "consumer"
        val before = pass_.next_symbol
        expect(pass_.request_specialization("identity", [])).to_equal(-1)
        expect(pass_.next_symbol).to_equal(before)
        expect(pass_.spec_symbols.len()).to_equal(0)
        expect(pass_.archive_requests.len()).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(0)
        expect(pass_.diagnostics.join("\n")).to_contain("E-MONO-042")

    it "rewrites omitted and explicit archive calls to one concrete callee":
        val parsed = parse_full_frontend("fn marker<T>() -> i64:\n    19\n", "marker.spl", "provider", Logger(level: 0))
        var lowering = HirLowering.with_filename("marker.spl")
        var module = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var original: SymbolId = nil
        val integer = default_test_type(HirTypeKind.Int(64, true))
        for key in module.functions.keys():
            var function: HirFunction = module.functions[key]
            original = function.symbol
            var parameter: HirTypeParam = function.type_params[0]
            parameter.has_default = true
            parameter.default = integer
            function.type_params = [parameter]
            module.functions[key] = function
        var pass_ = MonomorphizationPass.create()
        pass_.template_body_mode = MonoTemplateBodyModeV1.ArchiveRequests
        pass_.current_module = "provider"
        pass_.collect_generics(module, "provider")
        val callee = HirExpr(kind: HirExprKind.NamedVar(original, "marker"), has_type_: false, type_: nil, span: Span.new(0, 1, 8, 3))
        val omitted = pass_.rewrite_call(callee, [], [])
        val explicit = pass_.rewrite_call(callee, [], [integer])
        expect(omitted == explicit).to_be(true)
        match omitted:
            case HirExprKind.Call(target, arguments, type_arguments):
                val concrete: HirExpr = target
                expect(concrete.has_type_).to_be(true)
                expect(concrete.type_.kind == HirTypeKind.Function([], integer, [])).to_be(true)
                expect(arguments.len()).to_equal(0)
                expect(type_arguments.len()).to_equal(0)
            case _:
                expect(false).to_be(true)
        expect(pass_.archive_requests.len()).to_equal(1)
        expect(pass_.stats.specializations_created).to_equal(1)
        expect(pass_.diagnostics.len()).to_equal(0)
