"""
## Purpose and audience
Purpose: Prove that MonoSemanticKey canonical form.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-MONO-001 — stable requirement identity for this spec.

"""
# MonoSemanticKey / MonoArtifactKey canonical determinism (hardening Phase 3, M1)

Design §9.2: the semantic key is canonical data. Two uses with the same
definition + positional type args + set-valued effect/capability args must
produce byte-identical canonical text and the same hash, regardless of the
order effects/capabilities were listed in; positional type args must NOT be
reordered; and the legacy `SpecializationKey` adapter must agree with the
HIR-built key on the shared primitive forms.
"""

use std.spec
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.{Span}
use compiler.monomorphize.types.{SpecializationKey, ConcreteType}
use compiler.monomorphize.mono_key.*

fn sp() -> Span:
    Span.empty()

fn t_i64() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: sp())

fn t_str() -> HirType:
    HirType(kind: HirTypeKind.Str, span: sp())

fn t_opt(inner: HirType) -> HirType:
    HirType(kind: HirTypeKind.Optional(inner), span: sp())

fn t_named(id: i64, args: [HirType]) -> HirType:
    HirType(kind: HirTypeKind.Named(SymbolId(id: id), args), span: sp())

fn t_param(name: text) -> HirType:
    HirType(kind: HirTypeKind.TypeParam(name, []), span: sp())

describe "MonoSemanticKey canonical form":
    it "is deterministic across two independently built keys":
        step("Verify: is deterministic across two independently built keys")
        # @req: REQ-COMPILER-MONO-001
        val a = mono_semantic_key_new("sym#7", ["i64", "str"], ["3"], ["io", "alloc"], ["net"])
        val b = mono_semantic_key_new("sym#7", ["i64", "str"], ["3"], ["io", "alloc"], ["net"])
        expect(mono_semantic_key_canonical_text(a)).to_equal(mono_semantic_key_canonical_text(b))
        expect(mono_semantic_key_hash(a)).to_equal(mono_semantic_key_hash(b))
        expect(mono_semantic_key_equals(a, b)).to_equal(true)

    it "has the documented separator layout":
        step("Verify: has the documented separator layout")
        val k = mono_semantic_key_new("sym#7", ["i64", "str"], ["3"], ["io"], ["net"])
        expect(mono_semantic_key_canonical_text(k)).to_equal("sym#7<i64,str>;c=[3];e=[io];k=[net]")

    it "canonicalizes effect and capability SETS (order + duplicates)":
        step("Verify: canonicalizes effect and capability SETS (order + duplicates)")
        val a = mono_semantic_key_new("sym#1", ["i64"], [], ["io", "alloc", "io"], ["b", "a"])
        val b = mono_semantic_key_new("sym#1", ["i64"], [], ["alloc", "io"], ["a", "b", "a"])
        expect(mono_semantic_key_canonical_text(a)).to_equal(mono_semantic_key_canonical_text(b))
        expect(a.effect_args.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(a.capability_args.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "keeps type args POSITIONAL":
        step("Verify: keeps type args POSITIONAL")
        val a = mono_semantic_key_types_only("sym#1", ["i64", "str"])
        val b = mono_semantic_key_types_only("sym#1", ["str", "i64"])
        expect(mono_semantic_key_equals(a, b)).to_equal(false)
        expect(mono_semantic_key_hash(a) != mono_semantic_key_hash(b)).to_equal(true)

    it "distinguishes definitions and const args":
        step("Verify: distinguishes definitions and const args")
        val a = mono_semantic_key_new("sym#1", ["i64"], ["4"], [], [])
        val b = mono_semantic_key_new("sym#1", ["i64"], ["8"], [], [])
        val c = mono_semantic_key_new("sym#2", ["i64"], ["4"], [], [])
        expect(mono_semantic_key_equals(a, b)).to_equal(false)
        expect(mono_semantic_key_equals(a, c)).to_equal(false)

describe "canonical type ids from HIR":
    it "renders nested generics span-free and deterministically":
        step("Verify: renders nested generics span-free and deterministically")
        val ty = t_named(42, [t_opt(t_i64()), t_named(9, [t_str()])])
        expect(canonical_type_id_of_hir(ty)).to_equal("sym#42<opt<i64>,sym#9<str>>")
        val again = t_named(42, [t_opt(t_i64()), t_named(9, [t_str()])])
        expect(canonical_type_id_of_hir(again)).to_equal(canonical_type_id_of_hir(ty))

    it "renders Result and Union (union members canonicalized as a set)":
        step("Verify: renders Result and Union (union members canonicalized as a set)")
        val r = HirType(kind: HirTypeKind.Result(t_i64(), t_str()), span: sp())
        expect(canonical_type_id_of_hir(r)).to_equal("result<i64,str>")
        val u1 = HirType(kind: HirTypeKind.Union([t_i64(), t_str()]), span: sp())
        val u2 = HirType(kind: HirTypeKind.Union([t_str(), t_i64()]), span: sp())
        expect(canonical_type_id_of_hir(u1)).to_equal(canonical_type_id_of_hir(u2))

    it "builds a key from HIR args and flags leftover type params":
        step("Verify: builds a key from HIR args and flags leftover type params")
        val ok = mono_semantic_key_from_hir(SymbolId(id: 5), [t_i64()])
        expect(mono_semantic_key_canonical_text(ok)).to_equal("sym#5<i64>;c=[];e=[];k=[]")
        expect(mono_semantic_key_is_generic(ok)).to_equal(false)
        val bad = mono_semantic_key_from_hir(SymbolId(id: 5), [t_opt(t_param("T"))])
        expect(mono_semantic_key_is_generic(bad)).to_equal(true)

describe "SpecializationKey adapter":
    it "maps the legacy key onto a semantic key with canonical concrete ids":
        step("Verify: maps the legacy key onto a semantic key with canonical concrete ids")
        val legacy = SpecializationKey(name: "identity", type_args: [ConcreteType.Int, ConcreteType.Optional(ConcreteType.String)])
        val k = specialization_key_to_mono_key(legacy)
        expect(k.definition).to_equal("name:identity")
        expect(k.type_args.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(k.type_args[0]).to_equal("i64")
        expect(k.type_args[1]).to_equal("opt<str>")
        expect(mono_semantic_key_canonical_text(k)).to_equal("name:identity<i64,opt<str>>;c=[];e=[];k=[]")

    it "agrees with the HIR canonical id on shared primitive forms":
        step("Verify: agrees with the HIR canonical id on shared primitive forms")
        expect(canonical_type_id_of_concrete(ConcreteType.Optional(ConcreteType.Int))).to_equal(canonical_type_id_of_hir(t_opt(t_i64())))

describe "MonoArtifactKey":
    it "is deterministic and changes with emission context":
        step("Verify: is deterministic and changes with emission context")
        val s = mono_semantic_key_types_only("sym#1", ["i64"])
        val a = mono_artifact_key_new(s, "x86_64-unknown-linux-gnu", 11, 22, "llvm", 33, 44, 55)
        val b = mono_artifact_key_new(s, "x86_64-unknown-linux-gnu", 11, 22, "llvm", 33, 44, 55)
        val c = mono_artifact_key_new(s, "aarch64-unknown-linux-gnu", 11, 22, "llvm", 33, 44, 55)
        expect(mono_artifact_key_equals(a, b)).to_equal(true)
        expect(mono_artifact_key_hash(a)).to_equal(mono_artifact_key_hash(b))
        expect(mono_artifact_key_equals(a, c)).to_equal(false)
        expect(mono_artifact_key_canonical_text(a).contains("|target=x86_64-unknown-linux-gnu|")).to_equal(true)
