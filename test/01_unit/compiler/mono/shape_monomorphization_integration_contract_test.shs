#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
integration="$root/src/compiler/40.mono/monomorphize_integration.spl"
policy="$root/src/compiler/40.mono/shape/monomorphization_policy.spl"
driver="$root/src/compiler/80.driver/driver_hir_pipeline_passes.spl"

grep -q 'monomorphization_shape_plan_v1' "$integration"
grep -q 'shape_baseline_symbols' "$integration"
grep -q 'shape_baselines_reused' "$integration"
grep -q 'operation_dictionary_v1' "$policy"
grep -q 'pointer_map_digest' "$root/src/compiler/40.mono/shape/layout_shape.spl"
grep -q 'shape_baselines=' "$driver"

if grep -q 'impl:{generic_body_digest}:{shape_id.digest}' "$policy"; then
    echo "unsafe shape-only operation identity" >&2
    exit 1
fi

echo "D10_MONOMORPHIZATION_INTEGRATION_STATIC_PASS"
