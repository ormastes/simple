# @req REQ-SSPEC-COMPILER
"""
# 40.mono: a type argument must survive every way a value changes variable

A generic call is specialized from the types of its arguments, so the pass
has to know the type of a value after it was bound, rebound, stored, loaded,
wrapped, unwrapped, captured, destructured or iterated. Each example binds a
`text` (the instantiation whose ABI differs from the erased `i64`) or another
concrete type through ONE variable-change kind and passes it to
`keep<T>(x: T) -> T`. The expected verdict is the specialization that kind
must request (`keep$str`, ...) with zero unresolved call sites.

The last group pins the kinds the pass cannot type yet: those call sites must
be REFUSED (E-MONO-032, template kept, no specialization) -- never bound to a
guessed type.

Design: doc/05_design/compiler/generics/generic_instantiation_model.md (§9).
"""

# @tag:unit
# @tag:compiler
# @tag:mono
# @tag:generics

use std.spec
use compiler.common.config.Logger
use compiler.common.driver_core_types.SourceFile
use compiler.frontend.parser_types.{Module}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.hirlowering_for_module
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.mono.monomorphize_integration.{run_monomorphization_with_diagnostics}

val prelude = "struct S:\n" +
    "    name: text\n" +
    "\n" +
    "struct Box<T>:\n" +
    "    item: T\n" +
    "\n" +
    "impl<T> Box<T>:\n" +
    "    fn get(self) -> T:\n" +
    "        self.item\n" +
    "\n" +
    "enum Shape:\n" +
    "    Tagged(text)\n" +
    "    Empty\n" +
    "\n" +
    "fn keep<T>(x: T) -> T:\n" +
    "    x\n" +
    "\n" +
    "fn mk() -> text:\n" +
    "    \"m\"\n" +
    "\n"

fn flow(extra: text, body: text) -> text:
    """Lower `prelude + extra + fn main() { body }`, run 40.mono and render
    the verdict: sorted names of the surviving `keep`/`Box__get`/`twice`
    functions, unresolved count, and the diagnostic codes."""
    val src = prelude + extra + "fn main() -> i64:\n" + body + "    0\n"
    val log = Logger(level: 0)
    val name = "flow_main"
    val parsed_module = parse_full_frontend(src, name + ".spl", name, log)
    var parsed: Dict<text, Module> = {}
    parsed[name] = parsed_module
    val surfaces_result = module_surfaces_from_modules(parsed, [
        SourceFile(path: name + ".spl", content: src, module_name: name)])
    if surfaces_result.is_err():
        return "surface error: " + surfaces_result.unwrap_err()
    var hl = hirlowering_for_module(name, surfaces_result.unwrap())
    var hir: Dict<text, HirModule> = {}
    hir[name] = hl.lower_module(parsed_module)
    if hl.errors.len() > 0:
        return "hir error: " + hl.errors[0].message
    val (mono, stats, diags) = run_monomorphization_with_diagnostics(hir)
    val out_module: HirModule = mono[name]
    var names: [text] = []
    for sym in out_module.functions.keys():
        val f: HirFunction = out_module.functions[sym]
        val fname: text = f.name
        if fname.starts_with("keep") or fname.starts_with("Box__") or fname.starts_with("twice"):
            names = names.push(fname)
    names = names.sorted()
    var codes: [text] = []
    for d in diags:
        val dt: text = d
        print "diag: {dt}"
        val code = dt.substring(0, 10)
        if not codes.contains(code):
            codes = codes.push(code)
    "{names.join(\",\")} unresolved={stats.unresolved_generic_calls} diags={codes.join(\",\")}"

val ok_str = "keep$str unresolved=0 diags="
val ok_i64 = "keep$i64 unresolved=0 diags="
val refused = "keep unresolved=1 diags=E-MONO-032"

describe "40.mono variable flow: bindings":
    it "annotated let":
        expect(flow("", "    val a: text = \"x\"\n    keep(a)\n")).to_equal(ok_str)

    it "unannotated let from a literal":
        expect(flow("", "    val a = \"x\"\n    keep(a)\n")).to_equal(ok_str)

    it "var after reassignment":
        expect(flow("", "    var a = \"x\"\n    a = \"y\"\n    keep(a)\n")).to_equal(ok_str)

    it "function parameter":
        expect(flow("fn use_p(p: text) -> text:\n    keep(p)\n\n", "    use_p(\"x\")\n")).to_equal(ok_str)

    it "return value of a non-generic function":
        expect(flow("", "    keep(mk())\n")).to_equal(ok_str)

    it "unannotated let from a generic call, passed on":
        expect(flow("", "    val a = keep(\"x\")\n    val b = keep(a)\n")).to_equal(ok_str)

    it "return position inside another generic (T flows template to template)":
        expect(flow("fn twice<T>(x: T) -> T:\n    keep(keep(x))\n\n", "    twice(\"x\")\n")).to_equal("keep$str,twice$str unresolved=0 diags=")

    # An unannotated local INSIDE a template has no declared type to
    # substitute; specializing it used to abort the pass.
    it "unannotated let inside a template body":
        expect(flow("fn keep_local<T>(x: T) -> T:\n    val k = x\n    keep(k)\n\n", "    keep_local(\"x\")\n")).to_equal("keep$str,keep_local$str unresolved=0 diags=")

    it "var reassigned inside a template body":
        expect(flow("fn keep_var<T>(x: T, y: T) -> T:\n    var k = x\n    k = y\n    keep(k)\n\n", "    keep_var(1, 2)\n")).to_equal("keep$i64,keep_var$i64 unresolved=0 diags=")

describe "40.mono variable flow: aggregates":
    it "field of a non-generic struct":
        expect(flow("", "    val s = S(name: \"x\")\n    keep(s.name)\n")).to_equal(ok_str)

    it "type-parameter field of a generic struct instance":
        expect(flow("", "    val b = Box(item: \"x\")\n    keep(b.item)\n")).to_equal(ok_str)

    it "a generic struct instance as the type argument":
        expect(flow("", "    val b = Box(item: \"x\")\n    keep(b)\n")).to_equal("keep$Box_str unresolved=0 diags=")

    it "method of a same-module generic impl on a constructed receiver (BUG-IT-3)":
        expect(flow("", "    val bx = Box<i64>(item: 7)\n    bx.get()\n")).to_equal("Box__get$i64,keep unresolved=0 diags=")

    it "method of a generic impl at text, result passed on":
        expect(flow("", "    val bx = Box(item: \"x\")\n    val v = bx.get()\n    keep(v)\n")).to_equal("Box__get$str,keep$str unresolved=0 diags=")

    it "array element read":
        expect(flow("", "    val xs = [\"a\", \"b\"]\n    keep(xs[0])\n")).to_equal(ok_str)

    it "array as the type argument":
        expect(flow("", "    val xs = [\"a\", \"b\"]\n    keep(xs)\n")).to_equal("keep$arr_str unresolved=0 diags=")

    it "dict element read":
        expect(flow("", "    val d: Dict<text, text> = \{\"k\": \"v\"\}\n    keep(d[\"k\"])\n")).to_equal(ok_str)

    it "tuple destructuring":
        expect(flow("", "    val (p, q) = (\"a\", 1)\n    keep(p)\n")).to_equal(ok_str)

describe "40.mono variable flow: optionals and patterns":
    it "optional as the type argument":
        expect(flow("", "    val o: text? = \"x\"\n    keep(o)\n")).to_equal("keep$opt_str unresolved=0 diags=")

    it "optional coalesced with a default":
        expect(flow("", "    val o: text? = \"x\"\n    keep(o ?? \"d\")\n")).to_equal(ok_str)

    # `if val v = o` reaches HIR as `v = o.?`, which the whole pipeline types
    # as the optional itself (payload-or-nil in one word). The specialization
    # follows that declared type; narrowing `v` to the payload is a frontend
    # change (design note, open hole H-IFVAL).
    it "if-val binding keeps the optional type HIR declares for it":
        expect(flow("", "    val o: text? = \"x\"\n    if val v = o:\n        keep(v)\n")).to_equal("keep$opt_str unresolved=0 diags=")

    it "enum payload bound by a match arm":
        expect(flow("", "    val sh = Shape.Tagged(\"x\")\n    match sh:\n        case Shape.Tagged(n):\n            keep(n)\n        case _:\n            \"\"\n")).to_equal(ok_str)

describe "40.mono variable flow: closures and loops":
    it "closure capture":
        expect(flow("", "    val a = \"x\"\n    val f = \\n: keep(a)\n    f(1)\n")).to_equal(ok_str)

    it "for-in variable over an array":
        expect(flow("", "    val xs = [\"a\", \"b\"]\n    for s in xs:\n        keep(s)\n")).to_equal(ok_str)

    it "for-in variable over a range":
        expect(flow("", "    for i in 0..3:\n        keep(i)\n")).to_equal(ok_i64)

    it "var updated in a while loop from the generic's own result":
        expect(flow("", "    var n = 0\n    while n < 2:\n        n = keep(n) + 1\n")).to_equal(ok_i64)

describe "40.mono variable flow: computed values":
    it "text concatenation":
        expect(flow("", "    val a = \"x\"\n    keep(a + \"y\")\n")).to_equal(ok_str)

    it "integer arithmetic":
        expect(flow("", "    val n = 2\n    keep(n * 3 + 1)\n")).to_equal(ok_i64)

    it "comparison":
        expect(flow("", "    val n = 2\n    keep(n > 1)\n")).to_equal("keep$bool unresolved=0 diags=")

    it "if-expression with agreeing arms":
        expect(flow("", "    val c = true\n    keep(if c: \"a\" else: \"b\")\n")).to_equal(ok_str)

describe "40.mono variable flow: one specialization per instantiation":
    # `Result` has no mangling of its own (`unknown`), so two different
    # Result instantiations used to share ONE specialization body.
    it "two instantiations that mangle alike get distinct specializations":
        expect(flow("fn use_r(a: Result<i64, text>, b: Result<bool, text>) -> i64:\n    keep(a)\n    keep(b)\n    0\n\n", "    0\n")).to_equal("keep$unknown,keep$unknown_k1 unresolved=0 diags=")

    it "the same instantiation from two call sites still shares one":
        expect(flow("fn use_r(a: Result<i64, text>, b: Result<i64, text>) -> i64:\n    keep(a)\n    keep(b)\n    0\n\n", "    0\n")).to_equal("keep$unknown unresolved=0 diags=")

describe "40.mono variable flow: refused, never guessed":
    it "a value with no local type evidence is refused with E-MONO-032":
        expect(flow("", "    keep(nil)\n")).to_equal(refused)

    it "an untyped lambda parameter is refused":
        expect(flow("", "    val f = \\s: keep(s)\n    f(\"x\")\n")).to_equal(refused)

    it "the result of a builtin method is refused":
        expect(flow("", "    val a = \" x \"\n    keep(a.trim())\n")).to_equal(refused)

    it "a generic struct whose constructor arguments carry no evidence is refused":
        expect(flow("", "    val b = Box(item: nil)\n    keep(b)\n")).to_equal(refused)

    it "an if-expression whose arms disagree is refused":
        expect(flow("", "    val c = true\n    keep(if c: \"a\" else: 1)\n")).to_equal(refused)
