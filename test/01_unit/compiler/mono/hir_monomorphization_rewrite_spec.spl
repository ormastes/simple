# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/mono/hir_monomorphization_rewrite_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/hir_monomorphization_rewrite_spec.md
# doc-path: doc/03_plan/sys_test/hir_monomorphization_rewrite_spec.md
# doc-path: doc/04_architecture/hir_monomorphization_rewrite_spec.md
# doc-path: doc/05_design/hir_monomorphization_rewrite_spec_oracles.md
# @manual: primary

"""
# HIR monomorphization actually specializes and rewrites (#158 Phase B)

`run_monomorphization` was wired as driver Phase 4 but was an expensive no-op:
`rewrite_module` returned the module unchanged ("For now, return module
unchanged"), so no specialization was ever emitted and no call site was ever
rewritten. Marking a generic as a template is not monomorphizing it.

This spec drives the pass on a hand-built HIR module holding

    fn identity<T>(v: T) -> T: v
    fn main(): identity<i64>(7)

and pins the three things that must be true after Phase 4:

1. a specialized `identity$i64` exists in `module.functions`, with EMPTY
   `type_params` (that emptiness is what a post-Phase-4 sweep checks) and a
   CONCRETE `i64` parameter type substituted for `T`;
2. the generic template is still present (other modules may still call it);
3. `main`'s call site targets the specialization's SymbolId and carries EMPTY
   `type_args`, so nothing downstream of Phase 4 sees a call that still needs
   monomorphizing.

Before the change all three failed: `specializations_created` was 0, no
`identity$i64` function existed, and `main`'s call still named the template
with `[i64]` type arguments.

The module is built by hand rather than parsed on purpose: the Phase A refusal
gates in HIR lowering (`declaration_lowering.spl`) still reject a generic `fn`
outright, so a generic HirFunction cannot be produced from source today. Those
gates stay loud; see
`doc/08_tracking/bug/hir_generic_templates_unconsumed_by_mono_pass_2026-08-21.md`.
"""

use std.spec.step

use std.spec
use std.spec.step
use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.mono.monomorphize_integration.{run_monomorphization, MonomorphizationPass, bind_type_params, hir_type_key}


fn mk_span() -> Span:
    Span.empty()

fn mk_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: mk_span())

fn mk_expr(kind: HirExprKind) -> HirExpr:
    HirExpr(kind: kind, has_type_: false, type_: nil, span: mk_span())

fn mk_block(stmts: [HirStmt]) -> HirBlock:
    HirBlock(stmts: stmts, has: false, value: mk_expr(HirExprKind.NilLit), span: mk_span())

fn mk_fn(id: i64, name: text, type_params: [HirTypeParam], params: [HirParam], ret: HirType, body: HirBlock) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: id),
        name: name,
        type_params: type_params,
        params: params,
        return_type: ret,
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(),
        is_gpu_kernel: false,
        gpu_target: "",
        gpu_backend_order: ""
    )

fn make_modules() -> Dict<text, HirModule>:
    val t_param = HirTypeParam(
        symbol: SymbolId(id: 90),
        name: "T",
        bounds: [],
        has_default: false,
        default: nil,
        span: mk_span()
    )
    val t_type = mk_type(HirTypeKind.TypeParam("T", []))
    val v_param = HirParam(
        symbol: SymbolId(id: 91),
        name: "v",
        type_: t_type,
        has_default: false,
        default: nil,
        span: mk_span(),
        is_mutable: false
    )
    val identity = mk_fn(
        1, "identity", [t_param], [v_param], t_type,
        mk_block([HirStmt(kind: HirStmtKind.Expr(mk_expr(HirExprKind.Var(SymbolId(id: 91)))), span: mk_span())])
    )

    val call = mk_expr(HirExprKind.Call(
        mk_expr(HirExprKind.Var(SymbolId(id: 1))),
        [HirCallArg(has_name: false, name: "", value: mk_expr(HirExprKind.IntLit(7, nil)), span: mk_span())],
        [mk_type(HirTypeKind.Int(64, true))]
    ))
    val main_fn = mk_fn(
        2, "main", [], [], mk_type(HirTypeKind.Unit),
        mk_block([HirStmt(kind: HirStmtKind.Expr(call), span: mk_span())])
    )

    var functions: Dict<SymbolId, HirFunction> = {}
    functions[identity.symbol] = identity
    functions[main_fn.symbol] = main_fn
    val module = HirModule(
        name: "mono_rewrite_test",
        path: "synthetic/mono_rewrite_test.spl",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        gpu_function_targets: {},
        gpu_function_backend_orders: {},
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )
    var modules: Dict<text, HirModule> = {}
    modules["mono_rewrite_test"] = module
    modules

describe "HIR monomorphization pass (#158 Phase B)":
    # @manual scenario evidence
    it "emits a specialization for identity<i64> instead of returning the module unchanged":
        # @req REQ-SSPEC-COMPILER
        step("emits a specialization for identity<i64> instead of returning the module unchanged")
        val (result, stats) = run_monomorphization(make_modules())
        expect(stats.generic_functions_found).to_equal(1)
        expect(stats.specializations_created).to_equal(1)
        val out = result["mono_rewrite_test"]
        var found = 0
        var type_params_left = -1
        var param_is_i64 = false
        for key in out.functions.keys():
            val f: HirFunction = out.functions[key]
            if f.name == "identity$i64":
                found = found + 1
                type_params_left = f.type_params.len()
                for p in f.params:
                    val pt: HirParam = p
                    match pt.type_.kind:
                        case Int(bits, signed):
                            if bits == 64 and signed:
                                param_is_i64 = true
                        case _:
                            pass
        expect(found).to_equal(1)
        expect(type_params_left).to_equal(0)
        expect(param_is_i64).to_equal(true)

    it "removes the consumed generic template once its specialization exists (plan 9.3 step 12)":
        # @req REQ-SSPEC-COMPILER
        step("removes the consumed generic template once its specialization exists (plan 9.3 step 12)")
        # Superseded the earlier "keeps the template" expectation: plan section
        # 9.3 step 12 requires a template with >= 1 specialization to stop being
        # emittable, and the post-mono verifier counts a surviving one as
        # `generic_emitted_definition`. See
        # test/01_unit/compiler/mono/mono_template_pruning_spec.spl.
        val (result, _) = run_monomorphization(make_modules())
        val out = result["mono_rewrite_test"]
        var templates = 0
        for key in out.functions.keys():
            val f: HirFunction = out.functions[key]
            if f.name == "identity":
                templates = templates + 1
        expect(templates).to_equal(0)

    it "rewrites the call site to the specialized symbol with no type arguments":
        # @req REQ-SSPEC-COMPILER
        step("rewrites the call site to the specialized symbol with no type arguments")
        val (result, _) = run_monomorphization(make_modules())
        val out = result["mono_rewrite_test"]
        var spec_id = -1
        for key in out.functions.keys():
            val f: HirFunction = out.functions[key]
            if f.name == "identity$i64":
                spec_id = f.symbol.id
        expect(spec_id > 0).to_equal(true)

        var callee_id = -1
        var type_arg_count = -1
        for key in out.functions.keys():
            val f: HirFunction = out.functions[key]
            if f.name == "main":
                for stmt in f.body.stmts:
                    val st: HirStmt = stmt
                    match st.kind:
                        case HirStmtKind.Expr(e):
                            val et: HirExpr = e
                            match et.kind:
                                case HirExprKind.Call(callee, _, type_args):
                                    val ct: HirExpr = callee
                                    type_arg_count = type_args.len()
                                    match ct.kind:
                                        case HirExprKind.Var(sym):
                                            val s: SymbolId = sym
                                            callee_id = s.id
                                        case _:
                                            pass
                                case _:
                                    pass
                        case _:
                            pass
        expect(type_arg_count).to_equal(0)
        expect(callee_id).to_equal(spec_id)

fn context_template(with_argument: bool) -> HirFunction:
    val tp = HirTypeParam(symbol: SymbolId(id: 90), name: "T", bounds: [],
        has_default: false, default: nil, span: mk_span())
    val generic = mk_type(HirTypeKind.TypeParam("T", []))
    var params: [HirParam] = []
    if with_argument:
        params = params.push(HirParam(symbol: SymbolId(id: 91), name: "value",
            type_: generic, has_default: false, default: nil, span: mk_span(), is_mutable: false))
    mk_fn(1, "context_failure", [tp], params,
        mk_type(HirTypeKind.Result(generic, mk_type(HirTypeKind.Str))), mk_block([]))

fn context_call() -> HirExpr:
    mk_expr(HirExprKind.Call(mk_expr(HirExprKind.Var(SymbolId(id: 1))), [], []))

fn context_pass() -> MonomorphizationPass:
    val pass_ = MonomorphizationPass.create()
    pass_.current_module = "context"
    pass_.generic_functions["context_failure"] = context_template(false)
    pass_.template_module["context_failure"] = "context"
    pass_.sym_names["context#1"] = "context_failure"
    pass_.next_symbol = 100
    pass_

describe "contextual generic inference preserves checked types":
    it "binds return-only generics to scalar and array contexts independently":
        val pass_ = MonomorphizationPass.create()
        val scalar = mk_type(HirTypeKind.Int(64, true))
        val array = mk_type(HirTypeKind.Array(mk_type(HirTypeKind.Str), nil))
        val first = pass_.infer_call_type_args(context_template(false), [],
            mk_type(HirTypeKind.Result(scalar, mk_type(HirTypeKind.Str))))
        val second = pass_.infer_call_type_args(context_template(false), [],
            mk_type(HirTypeKind.Result(array, mk_type(HirTypeKind.Str))))
        expect(first.len()).to_equal(1)
        expect(second.len()).to_equal(1)
        expect(hir_type_key(first[0])).to_equal(hir_type_key(scalar))
        expect(hir_type_key(second[0])).to_equal(hir_type_key(array))
        expect(hir_type_key(first[0])).to_equal(hir_type_key(scalar))

    it "rejects missing context and conflicting argument versus result bindings":
        val pass_ = MonomorphizationPass.create()
        expect(pass_.infer_call_type_args(context_template(false), []).len()).to_equal(0)
        val args = [HirCallArg(has_name: false, name: "",
            value: mk_expr(HirExprKind.IntLit(7, nil)), span: mk_span())]
        val wrong = mk_type(HirTypeKind.Result(mk_type(HirTypeKind.Str), mk_type(HirTypeKind.Str)))
        expect(pass_.infer_call_type_args(context_template(true), args, wrong).len()).to_equal(0)
        expect(pass_.infer_call_type_args(context_template(false), [], mk_type(HirTypeKind.Any)).len()).to_equal(0)

    it "does not compare concrete nominal IDs from different module tables":
        var bindings: Dict<text, HirType> = {}
        val formal = mk_type(HirTypeKind.Named(SymbolId(id: 12), []))
        val actual = mk_type(HirTypeKind.Named(SymbolId(id: 80), []))
        expect(bind_type_params(formal, actual, bindings)).to_equal(true)
        expect(bindings.len()).to_equal(0)
        val generic = mk_type(HirTypeKind.TypeParam("T", []))
        val parameterized = mk_type(HirTypeKind.Named(SymbolId(id: 12), [generic]))
        val wrong_owner = mk_type(HirTypeKind.Named(SymbolId(id: 80), [mk_type(HirTypeKind.Str)]))
        expect(bind_type_params(parameterized, wrong_owner, bindings)).to_equal(false)
        expect(bindings.len()).to_equal(0)

    it "rewrites a function tail exactly once using its declared Result":
        val pass_ = context_pass()
        var body = mk_block([])
        body.has = true
        body.value = context_call()
        val result = mk_type(HirTypeKind.Result(mk_type(HirTypeKind.Int(64, true)), mk_type(HirTypeKind.Str)))
        val rewritten = pass_.rewrite_function(mk_fn(2, "caller", [], [], result, body))
        expect(pass_.stats.call_sites_found).to_equal(1)
        expect(pass_.stats.unresolved_generic_calls).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(1)
        expect(pass_.current_return_type).to_be_nil()
        expect(rewritten.body.has).to_equal(true)

    it "does not lend the enclosing return context to an untyped lambda":
        val pass_ = context_pass()
        pass_.current_return_type = mk_type(HirTypeKind.Result(mk_type(HirTypeKind.Int(64, true)), mk_type(HirTypeKind.Str)))
        val lambda_body = mk_expr(HirExprKind.Return(context_call()))
        val lambda_expr = mk_expr(HirExprKind.Lambda([], lambda_body, []))
        val rewritten = pass_.rewrite_expr(lambda_expr)
        expect(pass_.stats.unresolved_generic_calls).to_equal(1)
        expect(pass_.stats.specializations_created).to_equal(0)
        expect(pass_.current_return_type != nil).to_equal(true)

    it "uses annotated locals and explicit returns without duplicate specialization":
        val pass_ = context_pass()
        val result = mk_type(HirTypeKind.Result(mk_type(HirTypeKind.Int(64, true)), mk_type(HirTypeKind.Str)))
        val local = HirStmt(kind: HirStmtKind.Let(SymbolId(id: 4), result, context_call()), span: mk_span())
        val ret = HirStmt(kind: HirStmtKind.Expr(mk_expr(HirExprKind.Return(context_call()))), span: mk_span())
        val rewritten = pass_.rewrite_function(mk_fn(2, "caller", [], [], result, mk_block([local, ret])))
        expect(pass_.stats.call_sites_found).to_equal(2)
        expect(pass_.stats.unresolved_generic_calls).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(1)
        expect(pass_.specialized_functions.len()).to_equal(1)
        expect(pass_.spec_queue.len()).to_equal(1)
        expect(rewritten.body.stmts.len()).to_equal(2)
        expect(pass_.current_return_type).to_be_nil()

    it "restores the outer return type after rewriting a typed lambda":
        val pass_ = context_pass()
        val scalar = mk_type(HirTypeKind.Int(64, true))
        val array = mk_type(HirTypeKind.Array(mk_type(HirTypeKind.Str), nil))
        val outer_result = mk_type(HirTypeKind.Result(scalar, mk_type(HirTypeKind.Str)))
        val inner_result = mk_type(HirTypeKind.Result(array, mk_type(HirTypeKind.Str)))
        pass_.current_return_type = outer_result
        var lambda_expr = mk_expr(HirExprKind.Lambda([], mk_expr(HirExprKind.Return(context_call())), []))
        lambda_expr.has_type_ = true
        lambda_expr.type_ = mk_type(HirTypeKind.Function([], inner_result, []))
        val rewritten_lambda = pass_.rewrite_expr(lambda_expr)
        expect(hir_type_key(pass_.current_return_type.unwrap())).to_equal(hir_type_key(outer_result))
        expect(pass_.stats.call_sites_found).to_equal(1)
        expect(pass_.stats.unresolved_generic_calls).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(1)
        val inner_name = pass_.mangled_name("context_failure", [array])
        expect(pass_.specialized_functions.has(inner_name)).to_equal(true)
        val inner_function: HirFunction = pass_.specialized_functions[inner_name]
        expect(hir_type_key(inner_function.return_type)).to_equal(hir_type_key(inner_result))
        val rewritten_return = pass_.rewrite_expr(mk_expr(HirExprKind.Return(context_call())))
        val outer_name = pass_.mangled_name("context_failure", [scalar])
        expect(pass_.specialized_functions.has(outer_name)).to_equal(true)
        val outer_function: HirFunction = pass_.specialized_functions[outer_name]
        expect(hir_type_key(outer_function.return_type)).to_equal(hir_type_key(outer_result))
        expect(pass_.stats.call_sites_found).to_equal(2)
        expect(pass_.stats.unresolved_generic_calls).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(2)
        expect(hir_type_key(pass_.current_return_type.unwrap())).to_equal(hir_type_key(outer_result))
