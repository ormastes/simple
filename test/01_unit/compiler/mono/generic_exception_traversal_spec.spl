# @req REQ-SSPEC-COMPILER
# @tag: unit, compiler, mono, generics
use std.spec
use compiler.hir.hir.*
use compiler.common.diagnostics.span.Span
use compiler.monomorphize.type_subst.{TypeSubstitution, typesubstitution_from_params}
use compiler.monomorphize.hir_subst.body_subst.{subst_hir_body_with_report}
use compiler.verify.post_mono_verify.*

fn traversal_type() -> HirType:
    HirType(kind: HirTypeKind.TypeParam("T", []), span: Span.empty())

fn traversal_value() -> HirExpr:
    HirExpr(kind: HirExprKind.Var(SymbolId(id: 1)), has_type_: true,
        type_: traversal_type(), span: Span.empty())

fn traversal_block(value: HirExpr) -> HirBlock:
    HirBlock(stmts: [], has: true, value: value, span: Span.empty())

fn traversal_catch(typed: bool) -> HirCatchClause:
    HirCatchClause(has_pattern: typed,
        pattern: HirPattern(kind: HirPatternKind.Wildcard, has_type_: true,
            type_: traversal_type(), span: Span.empty()),
        has_type_: typed, type_: traversal_type(),
        body: traversal_block(traversal_value()), span: Span.empty())

fn traversal_try(typed: bool, with_finally: bool) -> HirExpr:
    val final_block: HirBlock? = if with_finally: traversal_block(traversal_value()) else: nil
    HirExpr(kind: HirExprKind.TryCatch(traversal_block(traversal_value()),
        [traversal_catch(typed)], final_block), has_type_: false,
        type_: nil, span: Span.empty())

fn traversal_substitution() -> TypeSubstitution:
    val parameter = HirTypeParam(symbol: SymbolId(id: 2), name: "T", bounds: [],
        has_default: false, default: nil, span: Span.empty())
    typesubstitution_from_params([parameter],
        [HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())])

describe "generic exception traversal reaches every typed edge":
    it "counts unresolved types in try, catch pattern, filter, body and finally":
        var verifier = PostMonoVerifier.create()
        verifier.walk_expr(traversal_try(true, true))
        expect(verifier.r.unresolved_type_param).to_equal(5)
        expect(verifier.r.unreachable_variant).to_equal(0)

    it "substitutes all catch metadata and both surrounding blocks":
        val report = subst_hir_body_with_report(
            traversal_block(traversal_try(true, true)), traversal_substitution())
        expect(report.diagnostics.len()).to_equal(0)
        match report.body.value.kind:
            case HirExprKind.TryCatch(body, clauses, finally_):
                expect(body.value.type_.kind).to_equal(HirTypeKind.Int(64, true))
                expect(clauses.len()).to_equal(1)
                val clause: HirCatchClause = clauses[0]
                expect(clause.has_pattern).to_be(true)
                expect(clause.pattern.type_.kind).to_equal(HirTypeKind.Int(64, true))
                expect(clause.has_type_).to_be(true)
                expect(clause.type_.kind).to_equal(HirTypeKind.Int(64, true))
                expect(clause.body.value.type_.kind).to_equal(HirTypeKind.Int(64, true))
                if val final_block = finally_:
                    expect(final_block.value.type_.kind).to_equal(HirTypeKind.Int(64, true))
                else: fail("finally block was lost")
            case _: fail("try/catch expression was lost")
        var verifier = PostMonoVerifier.create()
        verifier.walk_block(report.body)
        expect(post_mono_report_total(verifier.r)).to_equal(0)

    it "respects absent catch metadata and absent finally":
        var verifier = PostMonoVerifier.create()
        verifier.walk_expr(traversal_try(false, false))
        expect(verifier.r.unresolved_type_param).to_equal(2)
        expect(verifier.r.unreachable_variant).to_equal(0)
        val report = subst_hir_body_with_report(
            traversal_block(traversal_try(false, false)), traversal_substitution())
        expect(report.diagnostics.len()).to_equal(0)
        match report.body.value.kind:
            case HirExprKind.TryCatch(_, clauses, finally_):
                expect(finally_).to_be_nil()
                expect(clauses[0].has_pattern).to_be(false)
                expect(clauses[0].has_type_).to_be(false)
            case _: fail("try/catch expression was lost")

    it "substitutes a type-test operand without changing its literal target name":
        val input = HirExpr(kind: HirExprKind.TypeTest(traversal_value(), "i64"),
            has_type_: false, type_: nil, span: Span.empty())
        val report = subst_hir_body_with_report(traversal_block(input), traversal_substitution())
        expect(report.diagnostics.len()).to_equal(0)
        match report.body.value.kind:
            case HirExprKind.TypeTest(value, name):
                expect(name).to_equal("i64")
                expect(value.type_.kind).to_equal(HirTypeKind.Int(64, true))
            case _: fail("type-test expression was lost")
