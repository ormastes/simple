# Source-method regression; execution requires an authorized self-hosted runtime.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mono.monomorphize_integration.{MonomorphizationPass, run_monomorphization}
use compiler.verify.post_mono_verify.*

fn tuple_index_literal(slot: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(slot, nil), has_type_: false, span: Span.empty())

fn tuple_index_probe(parts: [HirType], index: HirExpr) -> HirType?:
    var pass_ = MonomorphizationPass.create()
    val tuple_type = HirType(kind: HirTypeKind.Tuple(parts), span: Span.empty())
    val base = HirExpr(kind: HirExprKind.Var(SymbolId(id: 101)),
        has_type_: true, type_: tuple_type, span: Span.empty())
    val access = HirExpr(kind: HirExprKind.Index(base, index),
        has_type_: false, span: Span.empty())
    pass_.infer_expr_type(access)

describe "mono recovers literal tuple projections emitted by destructuring":
    it "selects each heterogeneous element without erasing its kind":
        val parts = [HirType.named("text"), HirType.named("i64")]
        val first = tuple_index_probe(parts, tuple_index_literal(0))
        val second = tuple_index_probe(parts, tuple_index_literal(1))
        expect(first != nil).to_equal(true)
        expect(second != nil).to_equal(true)
        if val found = first:
            match found.kind:
                case HirTypeKind.Str: ()
                case _: assert(false)
        if val found = second:
            match found.kind:
                case HirTypeKind.Int(bits, signed):
                    expect(bits).to_equal(64)
                    expect(signed).to_equal(true)
                case _: assert(false)

    it "preserves distinct nominal symbols and nested type arguments":
        for owner in [301, 302]:
            val nominal = HirType(kind: HirTypeKind.Named(SymbolId(id: owner), [HirType.named("text")]), span: Span.empty())
            val projected = tuple_index_probe([HirType.named("i64"), nominal], tuple_index_literal(1))
            expect(projected != nil).to_equal(true)
            if val found = projected:
                match found.kind:
                    case HirTypeKind.Named(symbol, args):
                        expect(symbol.id).to_equal(owner)
                        expect(args.len()).to_equal(1)
                        if args.len() == 1:
                            match args[0].kind:
                                case HirTypeKind.Str: ()
                                case _: assert(false)
                    case _: assert(false)

    it "refuses negative or out of bounds slots and dynamic integer indices":
        val parts = [HirType.named("text"), HirType.named("i64")]
        expect(tuple_index_probe(parts, tuple_index_literal(-1)) == nil).to_equal(true)
        expect(tuple_index_probe(parts, tuple_index_literal(2)) == nil).to_equal(true)
        expect(tuple_index_probe([], tuple_index_literal(0)) == nil).to_equal(true)
        val dynamic_index = HirExpr(kind: HirExprKind.Var(SymbolId(id: 102)),
            has_type_: true, type_: HirType.named("i64"), span: Span.empty())
        expect(tuple_index_probe(parts, dynamic_index) == nil).to_equal(true)
        val bool_index = HirExpr(kind: HirExprKind.BoolLit(true), has_type_: false, span: Span.empty())
        expect(tuple_index_probe(parts, bool_index) == nil).to_equal(true)

    it "refuses erased unresolved and symbolic nominal element evidence":
        val unknowns = [
            HirType(kind: HirTypeKind.Any, span: Span.empty()),
            HirType(kind: HirTypeKind.Error, span: Span.empty()),
            HirType(kind: HirTypeKind.Infer(0, 0), span: Span.empty()),
            HirType(kind: HirTypeKind.Named(SymbolId(id: 301), [HirType(kind: HirTypeKind.Infer(0, 0), span: Span.empty())]), span: Span.empty())]
        for unknown in unknowns:
            expect(tuple_index_probe([HirType.named("text"), unknown], tuple_index_literal(1)) == nil).to_equal(true)

    it "resolves a generic partition destructure followed by a generic dictionary filter":
        val source = "struct LoadedSymbol:\n    address: i64\nfn partition_global_symbols_by_owner<T>(globals: Dict<text, (text, T)>, path: text) -> ([text], Dict<text, (text, T)>):\n    var owned: [text] = []\n    var kept: Dict<text, (text, T)> = {}\n    for item in globals:\n        val name = item[0]\n        val pair = item[1]\n        if pair[0] == path:\n            owned.push(name)\n        else:\n            kept[name] = pair\n    (owned, kept)\nfn global_symbols_without_names<T>(globals: Dict<text, (text, T)>, names: [text]) -> Dict<text, (text, T)>:\n    var kept: Dict<text, (text, T)> = {}\n    for item in globals:\n        if not names.contains(item[0]):\n            kept[item[0]] = item[1]\n    kept\nfn unload(globals: Dict<text, (text, LoadedSymbol)>, path: text, names: [text]) -> Dict<text, (text, LoadedSymbol)>:\n    val (_owned, remaining) = partition_global_symbols_by_owner(globals, path)\n    global_symbols_without_names(remaining, names)\n"
        val path = "testdata/tuple_index_inference.spl"
        val parsed = parse_full_frontend(source, path, path, Logger(level: 0))
        var lowering = HirLowering.with_filename(path)
        val module = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var modules: Dict<text, HirModule> = {}
        modules[module.name] = module
        val (out, stats) = run_monomorphization(modules)
        expect(stats.unresolved_generic_calls).to_equal(0)
        expect(stats.specializations_created).to_equal(2)
        var partitions = 0
        var filters = 0
        val rewritten: HirModule = out[module.name]
        for key in rewritten.functions.keys():
            val function: HirFunction = rewritten.functions[key]
            if function.name.starts_with("partition_global_symbols_by_owner$"):
                partitions = partitions + 1
            if function.name.starts_with("global_symbols_without_names$"):
                filters = filters + 1
        expect(partitions).to_equal(1)
        expect(filters).to_equal(1)
        expect(post_mono_report_total(post_mono_verify_modules(out))).to_equal(0)
