# Cached optional interpolation lists must survive monomorphization.
# Native oracle: test/fixtures/bootstrap/stage2_micro/diff_generic_struct_field/main.spl
# @req REQ-SSPEC-COMPILER
use std.spec
use compiler.common.diagnostics.span.Span
use compiler.hir.hir_definitions.*
use compiler.hir.hir_codec_support.HirCodecWriter
use compiler.frontend.core.flat_pool_codec.FlatPoolReader
use compiler.hir.generated.hir_codec.{hc_enc_hir_expr, hc_dec_hir_expr}
use compiler.mono.monomorphize_integration.MonomorphizationPass
use compiler.monomorphize.type_subst.{typesubstitution_empty, substitute_expr}
use compiler.monomorphize.hir_subst.body_subst.{HirSubstCtx, subst_hir_expr}

fn interpolation_item() -> HirInterpolation:
    var span = Span.empty()
    span.line = 13
    span.col = 11
    HirInterpolation(
        expr: HirExpr(kind: HirExprKind.IntLit(3, nil), has_type_: false,
            type_: nil, span: span),
        has_format: true, format: "04d", span: span)

fn interpolation_literal(parts: [HirInterpolation]?) -> HirExpr:
    HirExpr(kind: HirExprKind.StringLit("n=\{3:04d\}", parts),
        has_type_: false, type_: nil, span: Span.empty())

fn encoded_expr(expr: HirExpr) -> text:
    var writer = HirCodecWriter.create()
    hc_enc_hir_expr(writer, expr)
    expect(writer.ok).to_equal(true)
    writer.finish()

fn expect_rewrite_preserves(expr: HirExpr, from_cache: bool):
    val before = encoded_expr(expr)
    var input = expr
    if from_cache:
        var reader = FlatPoolReader.new(before)
        input = hc_dec_hir_expr(reader)
        expect(reader.ok).to_equal(true)
        expect(encoded_expr(input)).to_equal(before)
    var mono = MonomorphizationPass.create()
    mono.collect_lets_expr(input)
    val rewritten = mono.rewrite_expr(input)
    # Full real codec equality checks count, expression, format, and span.
    expect(encoded_expr(rewritten)).to_equal(before)
    val substituted = substitute_expr(input, typesubstitution_empty())
    expect(encoded_expr(substituted)).to_equal(before)
    val ctx = HirSubstCtx(subst: typesubstitution_empty(), diagnostics: [], nodes_visited: 0)
    val body_substituted = subst_hir_expr(input, ctx)
    expect(ctx.diagnostics.len()).to_equal(0)
    expect(encoded_expr(body_substituted)).to_equal(before)

describe "cached interpolation monomorphization":
    it "preserves a fresh flat interpolation list":
        expect_rewrite_preserves(interpolation_literal([interpolation_item()]), false)

    it "preserves an explicitly wrapped interpolation list":
        expect_rewrite_preserves(interpolation_literal(Some([interpolation_item()])), false)

    it "preserves a generated-codec decoded interpolation list":
        expect_rewrite_preserves(interpolation_literal([interpolation_item()]), true)

    it "keeps absent interpolations absent after cache decode":
        expect_rewrite_preserves(interpolation_literal(nil), true)

    it "keeps a present empty list present after cache decode":
        val empty: [HirInterpolation] = []
        expect_rewrite_preserves(interpolation_literal(Some(empty)), true)
