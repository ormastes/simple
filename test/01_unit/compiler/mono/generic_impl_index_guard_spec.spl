# @req REQ-SSPEC-COMPILER
# Regression for unused generic-impl body indexing; execution UNRUN.
use std.spec.*
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.HirModule
use compiler.hir.hir_definitions.HirImpl
use compiler.hir.hir_codec.hir_module_encode
use compiler.mono.monomorphize_integration.MonomorphizationPass
use compiler.mono.mono_archive_types_v1.MonoTemplateBodyModeV1

fn generic_impl_index_lower(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "impl_index.spl", "impl_index", Logger(level: 0))
    var lowering = HirLowering.with_filename("impl_index.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.functions.len()).to_be_greater_than(0)
    module

describe "generic impl collection skips unused indexing without changing registration":
    it "preserves a free generic declaration with no impls in both modes":
        val module = generic_impl_index_lower("fn identity<T>(value: T) -> T:\n    value\n")
        expect(module.impls.len()).to_equal(0)
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = MonomorphizationPass.create()
            pass_.template_body_mode = mode
            pass_.collect_generics(module, "impl_index")
            expect(pass_.generic_methods.len()).to_equal(0)
            expect(pass_.generic_method_rejected.len()).to_equal(0)
            expect(pass_.template_recipes.has("identity")).to_be(true)
            val signature = pass_.template_signature_v1("identity")
            expect(signature.type_params.len()).to_equal(1)
            expect(signature.param_types.len()).to_equal(1)

    it "keeps a real nongeneric impl and its complete body unchanged":
        val module = generic_impl_index_lower("class Plain:\n    value: i64\nimpl Plain:\n    fn read() -> i64:\n        self.value\n")
        expect(module.impls.len()).to_equal(1)
        val impl_: HirImpl = module.impls[0]
        expect(impl_.type_params.len()).to_equal(0)
        val before = hir_module_encode(module)
        var pass_ = MonomorphizationPass.create()
        pass_.collect_generic_impl_methods(module, "impl_index")
        expect(pass_.generic_methods.len()).to_equal(0)
        expect(pass_.generic_method_rejected.len()).to_equal(0)
        expect(pass_.template_recipes.len()).to_equal(0)
        expect(hir_module_encode(module)).to_equal(before)

    it "finds a generic impl after a nongeneric impl in both modes":
        val module = generic_impl_index_lower("class Plain:\n    value: i64\nimpl Plain:\n    fn read() -> i64:\n        self.value\nclass Box<T>:\n    value: T\nimpl Box<T>:\n    fn read() -> T:\n        self.value\n")
        expect(module.impls.len()).to_equal(2)
        val first: HirImpl = module.impls[0]
        val last: HirImpl = module.impls[1]
        expect(first.type_params.len()).to_equal(0)
        expect(last.type_params.len()).to_equal(1)
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = MonomorphizationPass.create()
            pass_.template_body_mode = mode
            pass_.collect_generic_impl_methods(module, "impl_index")
            expect(pass_.generic_methods.len()).to_equal(1)
            expect(pass_.generic_method_rejected.len()).to_equal(0)
            expect(pass_.template_recipes.has("Box__read")).to_be(true)
            expect(pass_.template_recipes.has("Plain__read")).to_be(false)
            val signature = pass_.template_signature_v1("Box__read")
            expect(signature.type_params.len()).to_equal(1)
            for key in pass_.generic_methods.keys():
                expect(pass_.generic_methods[key]).to_equal("Box__read")

    it "preserves generic trait-impl rejection at the HIR classification boundary":
        var module = generic_impl_index_lower("class Box<T>:\n    value: T\nimpl Box<T>:\n    fn read() -> T:\n        self.value\n")
        expect(module.impls.len()).to_equal(1)
        val original: HirImpl = module.impls[0]
        val original_count: i64 = original.type_params.len()
        expect(original_count).to_equal(1)
        var rejected: HirImpl = original
        rejected.has_trait_ = true
        module.impls = [rejected]
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = MonomorphizationPass.create()
            pass_.template_body_mode = mode
            pass_.collect_generic_impl_methods(module, "impl_index")
            expect(pass_.generic_methods.len()).to_equal(0)
            expect(pass_.template_recipes.len()).to_equal(0)
            expect(pass_.generic_method_rejected.len()).to_equal(1)
            for key in pass_.generic_method_rejected.keys():
                expect(pass_.generic_method_rejected[key]).to_contain("trait impl")
