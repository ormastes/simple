# @req REQ-C1-SM-BOUNDS
# Tests-first actual HIR preflight API. Execution UNRUN.
use std.spec.{describe, it, expect, fail}
use compiler.hir.hir.*
use compiler.common.diagnostics.span.Span
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}
use compiler.mono.mono_invocation_policy_v1.{MonoInvocationLimitsV1,
    MonoInvocationBudgetV1, mono_verification_limits_v1}
use compiler.mono.mono_invocation_preflight_v1.{mono_preflight_module_v1,
    mono_preflight_function_v1, mono_preflight_type_v1, mono_preflight_schema_matches_v1}
use compiler.hir.hir_codec.{HIR_CODEC_VERSION, HIR_CANONICAL_CODEC_VERSION,
    HIR_CANONICAL_CODEC_RULES_V1}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION}

fn preflight_budget_v1(work: i64, depth: i64) -> MonoInvocationBudgetV1:
    MonoInvocationBudgetV1.create(MonoInvocationLimitsV1(
        max_specializations: 16, max_work_units: work,
        max_hir_depth: depth)).unwrap()

fn preflight_type_v1(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn preflight_empty_module_v1() -> HirModule:
    HirModule(name: "preflight", path: "preflight.spl", imports: [],
        exports: [], domain_blocks: [], symbols: SymbolTable.new(),
        functions: {}, gpu_function_targets: {}, gpu_function_backend_orders: {},
        classes: {}, structs: {}, enums: {}, bitfields: {}, traits: {},
        impls: [], constants: {}, static_asserts: [], aop_advices: [],
        di_bindings: [], arch_rules: [], mock_decls: [], types: [],
        extend_enums: [])

fn preflight_function_v1() -> HirFunction:
    val type_ = preflight_type_v1(HirTypeKind.TypeParam("T", []))
    HirFunction(symbol: SymbolId(id: 1), name: "identity",
        type_params: [HirTypeParam(symbol: SymbolId(id: 2), name: "T",
            bounds: [], has_default: false, default: nil, span: Span.empty())],
        params: [HirParam(symbol: SymbolId(id: 3), name: "value", type_: type_,
            has_default: false, default: nil, span: Span.empty(), is_mutable: false)],
        return_type: type_,
        body: HirBlock(stmts: [], has: true,
            value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 3)),
                has_type_: true, type_: type_, span: Span.empty()), span: Span.empty()),
        effects: [], visibility: Visibility.Public, is_async: false,
        is_static: false, is_public: true, is_method: false, is_mutable: false,
        is_const: false, is_extern: false, func_attr: FunctionAttr.default(),
        has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false, vhdl_metadata: nil,
        has_doc_comment: false, doc_comment: "", span: Span.empty(),
        is_gpu_kernel: false, gpu_target: "", gpu_backend_order: "",
        verification_contract: nil, is_generic_template: true)

describe "invocation-owned HIR resource preflight":
    it "admits open generic composite type and effect evidence before specialization":
        val open = preflight_type_v1(HirTypeKind.TypeParam("T", []))
        val nominal = preflight_type_v1(HirTypeKind.Named(SymbolId(id: 9), [open]))
        val thrown = Effect(kind: EffectKind.Throws(nominal), span: Span.empty())
        val function = preflight_type_v1(HirTypeKind.Function(
            [preflight_type_v1(HirTypeKind.Dict(open, nominal))],
            preflight_type_v1(HirTypeKind.Optional(nominal)), [thrown]))
        var budget = preflight_budget_v1(65536, 128)
        match mono_preflight_type_v1(function, budget):
            case Ok(facts):
                expect(facts.node_count).to_be_greater_than(10)
                expect(facts.copy_units).to_equal(65536 - budget.remaining_work)
                expect(budget.hir_depth).to_equal(0)
            case Err(message): fail(message)

    it "accepts the exact measured work bound and refuses one less":
        val type_ = preflight_type_v1(HirTypeKind.Tuple([
            preflight_type_v1(HirTypeKind.Int(64, true)),
            preflight_type_v1(HirTypeKind.Bool)]))
        var first = preflight_budget_v1(65536, 128)
        val facts = mono_preflight_type_v1(type_, first).unwrap()
        var exact = preflight_budget_v1(facts.copy_units, 128)
        expect(mono_preflight_type_v1(type_, exact).is_ok()).to_equal(true)
        expect(exact.remaining_work).to_equal(0)
        var short = preflight_budget_v1(facts.copy_units - 1, 128)
        match mono_preflight_type_v1(type_, short):
            case Ok(_): fail("one-less work bound admitted the full type")
            case Err(message): expect(message).to_contain("E-MONO-WORK")
        expect(short.hir_depth).to_equal(0)

    it "checks depth before descending and restores the shared depth after refusal":
        val type_ = preflight_type_v1(HirTypeKind.Optional(
            preflight_type_v1(HirTypeKind.Optional(
                preflight_type_v1(HirTypeKind.Bool)))))
        var first = preflight_budget_v1(65536, 128)
        val facts = mono_preflight_type_v1(type_, first).unwrap()
        var exact = preflight_budget_v1(65536, facts.maximum_depth)
        expect(mono_preflight_type_v1(type_, exact).is_ok()).to_equal(true)
        var short = preflight_budget_v1(65536, facts.maximum_depth - 1)
        match mono_preflight_type_v1(type_, short):
            case Ok(_): fail("one-less depth bound admitted the nested type")
            case Err(message): expect(message).to_contain("E-MONO-DEPTH")
        expect(short.hir_depth).to_equal(0)

    it "charges retained text before admitting a large type parameter name":
        val type_ = preflight_type_v1(HirTypeKind.TypeParam(
            "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz", []))
        var budget = preflight_budget_v1(16, 128)
        match mono_preflight_type_v1(type_, budget):
            case Ok(_): fail("text payload exceeded the entire work allowance")
            case Err(message): expect(message).to_contain("E-MONO-WORK")

    it "traverses empty dictionaries and populated text indexes without mutating input":
        var module = preflight_empty_module_v1()
        module.gpu_function_targets["kernel"] = "cuda"
        var budget = preflight_budget_v1(65536, 128)
        match mono_preflight_module_v1(module, budget):
            case Ok(facts):
                expect(facts.copy_units).to_equal(65536 - budget.remaining_work)
                expect(module.gpu_function_targets["kernel"]).to_equal("cuda")
                expect(module.functions.keys().len()).to_equal(0)
            case Err(message): fail(message)

    it "refuses a present function dictionary key with an absent required declaration":
        var module = preflight_empty_module_v1()
        module.functions[SymbolId(id: 4)] = nil
        var budget = preflight_budget_v1(65536, 128)
        match mono_preflight_module_v1(module, budget):
            case Ok(_): fail("absent dictionary declaration acquired resource facts")
            case Err(message): expect(message).to_contain("E-MONO-SHAPE")

    it "measures a generic function including its retained default body":
        var function = preflight_function_v1()
        var before = preflight_budget_v1(65536, 128)
        val initial = mono_preflight_function_v1(function, before).unwrap()
        var param = function.params[0]
        param.has_default = true
        param.default = function.body.value
        function.params = [param]
        var after = preflight_budget_v1(65536, 128)
        val extended = mono_preflight_function_v1(function, after).unwrap()
        expect(extended.node_count).to_be_greater_than(initial.node_count)
        expect(extended.copy_units).to_be_greater_than(initial.copy_units)
        expect(function.type_params.len()).to_equal(1)

    it "rejects a true default flag whose retained expression is absent":
        var function = preflight_function_v1()
        var param = function.params[0]
        param.has_default = true
        function.params = [param]
        var budget = preflight_budget_v1(65536, 128)
        match mono_preflight_function_v1(function, budget):
            case Ok(_): fail("missing retained default acquired copy reservation")
            case Err(message): expect(message).to_contain("E-MONO-SHAPE")

    it "refuses version or rules drift against the actual exported schema owners":
        expect(mono_preflight_schema_matches_v1(HIR_CODEC_VERSION,
            HIR_CANONICAL_CODEC_VERSION, HIR_CANONICAL_CODEC_RULES_V1,
            FLAT_POOL_CODEC_VERSION)).to_equal(true)
        expect(mono_preflight_schema_matches_v1(HIR_CODEC_VERSION + "-changed",
            HIR_CANONICAL_CODEC_VERSION, HIR_CANONICAL_CODEC_RULES_V1,
            FLAT_POOL_CODEC_VERSION)).to_equal(false)
        expect(mono_preflight_schema_matches_v1(HIR_CODEC_VERSION,
            HIR_CANONICAL_CODEC_VERSION + "-changed", HIR_CANONICAL_CODEC_RULES_V1,
            FLAT_POOL_CODEC_VERSION)).to_equal(false)
        expect(mono_preflight_schema_matches_v1(HIR_CODEC_VERSION,
            HIR_CANONICAL_CODEC_VERSION, HIR_CANONICAL_CODEC_RULES_V1 + "-changed",
            FLAT_POOL_CODEC_VERSION)).to_equal(false)
        expect(mono_preflight_schema_matches_v1(HIR_CODEC_VERSION,
            HIR_CANONICAL_CODEC_VERSION, HIR_CANONICAL_CODEC_RULES_V1,
            FLAT_POOL_CODEC_VERSION + "-changed")).to_equal(false)

    it "admits exact dictionary traversal work and refuses a smaller allowance":
        var module = preflight_empty_module_v1()
        module.gpu_function_targets["first"] = "cuda"
        module.gpu_function_targets["second"] = "rocm"
        var first = preflight_budget_v1(65536, 128)
        val facts = mono_preflight_module_v1(module, first).unwrap()
        var exact = preflight_budget_v1(facts.copy_units, 128)
        expect(mono_preflight_module_v1(module, exact).is_ok()).to_equal(true)
        expect(exact.remaining_work).to_equal(0)
        var short = preflight_budget_v1(facts.copy_units - 1, 128)
        match mono_preflight_module_v1(module, short):
            case Ok(_): fail("one-less dictionary traversal allowance was admitted")
            case Err(message): expect(message).to_contain("E-MONO-WORK")
        expect(short.hir_depth).to_equal(0)
        expect(module.gpu_function_targets.keys().len()).to_equal(2)

    it "keeps a failed invocation poisoned and leaves fresh invocations independent":
        val type_ = preflight_type_v1(HirTypeKind.Bool)
        var exhausted = preflight_budget_v1(1, 128)
        expect(mono_preflight_type_v1(type_, exhausted).is_err()).to_equal(true)
        val remaining = exhausted.remaining_work
        val failure = exhausted.failure
        expect(mono_preflight_type_v1(type_, exhausted).is_err()).to_equal(true)
        expect(exhausted.remaining_work).to_equal(remaining)
        expect(exhausted.failure).to_equal(failure)
        expect(exhausted.hir_depth).to_equal(0)
        var fresh = preflight_budget_v1(65536, 128)
        expect(mono_preflight_type_v1(type_, fresh).is_ok()).to_equal(true)
        expect(fresh.failure).to_equal("")

    it "refuses an absent required function key before looking up its declaration":
        var module = preflight_empty_module_v1()
        module.functions[nil] = preflight_function_v1()
        val budget = preflight_budget_v1(65536, 128)
        match mono_preflight_module_v1(module, budget):
            case Ok(_): fail("absent required function key acquired resource facts")
            case Err(message): expect(message).to_contain("missing_required_hir_module_function_entry")
        expect(budget.hir_depth).to_equal(0)
        expect(budget.failure).to_contain("E-MONO-SHAPE")
