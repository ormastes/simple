# @req REQ-GENERIC-NOMINAL-IDENTITY
# @tag: unit, compiler, mono, generics
use std.spec
use compiler.mono.mono_archive_registration_types_v1.{MonoArchiveRegistrationRowV1}
use compiler.mono.mono_archive_registration_v1.{mono_archive_registration_row_digest_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir.*
use compiler.common.diagnostics.span.Span
use compiler.mono.monomorphize_integration.MonomorphizationPass
use compiler.mono.nominal_type_identity.mono_owned_type_key
use compiler.mono.mono_archive_types_v1.MonoTemplateBodyModeV1
use compiler.mono.mono_archive_state_v1.{mono_archive_facts_from_collector_v1,
    mono_archive_state_create_v1, mono_archive_scratch_pass_v1, mono_archive_state_digest_v1,
    mono_archive_delta_v1}
use compiler.mono.mono_archive_nominal_v2.{mono_archive_nominal_project_v2,
    mono_archive_nominal_install_v2}
use compiler.driver.cache.hir_mono_verification_recipe_codec_v1.{MonoVerificationGlobalRecipeV1,
    mono_verification_global_encode_v1, mono_verification_global_decode_v1}

fn transport_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn transport_expr(kind: HirExprKind, type_: HirType) -> HirExpr:
    HirExpr(kind: kind, has_type_: true, type_: type_, span: Span.empty())

fn transport_template() -> HirFunction:
    val t = transport_type(HirTypeKind.TypeParam("T", []))
    HirFunction(
        symbol: SymbolId(id: 20), name: "identity",
        type_params: [HirTypeParam(symbol: SymbolId(id: 21), name: "T", bounds: [], has_default: false, default: nil, span: Span.empty())],
        params: [HirParam(symbol: SymbolId(id: 22), name: "value", type_: t, has_default: false, default: nil, span: Span.empty(), is_mutable: false)],
        return_type: t,
        body: HirBlock(stmts: [], has: true, value: transport_expr(HirExprKind.Var(SymbolId(id: 22)), t), span: Span.empty()),
        effects: [], visibility: Visibility.Public, is_async: false, is_static: false,
        is_public: true, is_method: false, is_mutable: false, is_const: false,
        is_extern: false, func_attr: FunctionAttr.default(), has_export_attr: false,
        export_attr: nil, has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false, vhdl_metadata: nil,
        has_doc_comment: false, doc_comment: "", span: Span.empty(),
        is_gpu_kernel: false, gpu_target: "", gpu_backend_order: "")

fn transport_pass() -> MonomorphizationPass:
    var pass_ = MonomorphizationPass.create()
    var caller = SymbolTable.new()
    caller.define("Packet", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "third")
    var provider = SymbolTable.new()
    provider.define("Packet", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "decoy")
    pass_.module_symbols["caller"] = caller
    pass_.module_symbols["provider"] = provider
    pass_.current_module = "caller"
    pass_.generic_functions["identity"] = transport_template()
    pass_.template_module["identity"] = "provider"
    pass_.named_symbol_names["caller#0"] = "Packet"
    pass_

fn transport_packet() -> HirType:
    transport_type(HirTypeKind.Named(SymbolId(id: 0), []))

fn transport_module(name: text, symbols: SymbolTable, functions: Dict<SymbolId, HirFunction>) -> HirModule:
    HirModule(name: name, path: "synthetic/{name}.spl", imports: [], exports: [],
        domain_blocks: [], symbols: symbols, functions: functions,
        gpu_function_targets: {}, gpu_function_backend_orders: {}, classes: {},
        structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [], constants: {},
        static_asserts: [], aop_advices: [], di_bindings: [], arch_rules: [],
        mock_decls: [], types: [])

fn transport_nested() -> HirType:
    transport_type(HirTypeKind.Optional(transport_type(HirTypeKind.Array(transport_packet(), 3))))

fn transport_archive_collector() -> MonomorphizationPass:
    val setup = transport_pass()
    var provider_functions: Dict<SymbolId, HirFunction> = {}
    val template = transport_template()
    provider_functions[template.symbol] = template
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = MonoTemplateBodyModeV1.ArchiveRequests
    pass_.module_paths["provider"] = "synthetic/provider.spl"
    pass_.module_paths["caller"] = "synthetic/caller.spl"
    pass_.collect_generics(transport_module("provider", setup.module_symbols["provider"], provider_functions), "provider")
    pass_.collect_generics(transport_module("caller", setup.module_symbols["caller"], {}), "caller")
    pass_.current_module = "caller"
    pass_

fn expect_transport_call(kind: HirExprKind, pass_: MonomorphizationPass, expected: HirType):
    match kind:
        case HirExprKind.Call(callee, _, type_args):
            expect(type_args.len()).to_equal(0)
            expect(callee.has_type_).to_be(true)
            match callee.kind:
                case HirExprKind.NamedVar(id, _): expect(id.id).to_be_greater_than(1125899906842623)
                case _: expect(false).to_be(true)
            match callee.type_.kind:
                case HirTypeKind.Function(params, ret, _):
                    val wanted = mono_owned_type_key(expected, pass_.module_symbols["caller"], "caller")
                    expect(wanted.len()).to_be_greater_than(0)
                    expect(mono_owned_type_key(ret, pass_.module_symbols["caller"], "caller")).to_equal(wanted)
                    expect(mono_owned_type_key(params[0], pass_.module_symbols["caller"], "caller")).to_equal(wanted)
                case _: expect(false).to_be(true)
        case _: expect(false).to_be(true)

describe "generic specialization transports nominal ownership":
    it "substitutes caller arguments into provider ids and stamps the direct call back into caller ids":
        var pass_ = transport_pass()
        val actual = transport_nested()
        val callee = transport_expr(HirExprKind.NamedVar(SymbolId(id: 20), "provider.identity"), transport_type(HirTypeKind.Any))
        val rewritten = pass_.rewrite_call(callee, [], [actual])
        expect_transport_call(rewritten, pass_, actual)
        expect(pass_.diagnostics.len()).to_equal(0)
        val name = pass_.mangled_name("identity", [actual])
        val specialized: HirFunction = pass_.specialized_functions[name]
        val expected = mono_owned_type_key(actual, pass_.module_symbols["caller"], "caller")
        expect(mono_owned_type_key(specialized.return_type, pass_.module_symbols["provider"], "provider")).to_equal(expected)
        expect(pass_.module_symbols["provider"].next_symbol_id).to_equal(2)
        expect(pass_.module_symbols["caller"].next_symbol_id).to_equal(1)
        if val nested_return = pass_.fn_return_of(specialized.symbol):
            expect(mono_owned_type_key(nested_return, pass_.module_symbols["caller"], "caller")).to_equal(expected)
        else: expect(false).to_be(true)

    it "uses the same caller-owned signature for generic method rewriting":
        var pass_ = transport_pass()
        val actual = transport_nested()
        val receiver_type = transport_type(HirTypeKind.Named(SymbolId(id: 0), [actual]))
        val receiver = transport_expr(HirExprKind.NamedVar(SymbolId(id: 40), "value"), receiver_type)
        val rewritten = pass_.rewrite_generic_method_call("identity", receiver, "identity", [], MethodResolution.Unresolved)
        expect_transport_call(rewritten, pass_, actual)
        expect(pass_.diagnostics.len()).to_equal(0)

    it "reserves pending specialization ids before allocating nominal imports":
        var pass_ = transport_pass()
        val high = pass_.next_symbol
        pass_.next_symbol = high + 5
        var provider: SymbolTable = pass_.module_symbols["provider"]
        provider.next_symbol_id = high
        pass_.module_symbols["provider"] = provider
        if val types = pass_.relocate_mono_types([transport_packet()], "caller", "provider", "counter regression"):
            match types[0].kind:
                case HirTypeKind.Named(id, _): expect(id.id).to_equal(high + 5)
                case _: expect(false).to_be(true)
        else: expect(false).to_be(true)
        expect(pass_.next_symbol).to_equal(high + 6)

    it "refuses missing target ownership without reserving a display name or symbol":
        var pass_ = transport_pass()
        pass_.module_symbols.remove("provider")
        val before = pass_.next_symbol
        expect(pass_.request_specialization("identity", [transport_packet()])).to_equal(-1)
        expect(pass_.spec_display.len()).to_equal(0)
        expect(pass_.spec_symbols.len()).to_equal(0)
        expect(pass_.next_symbol).to_equal(before)
        expect(pass_.diagnostics[0]).to_contain("E-MONO-042")

    it "does not require nominal tables for scalar arguments":
        var pass_ = MonomorphizationPass.create()
        val scalar = transport_type(HirTypeKind.Int(64, true))
        if val types = pass_.relocate_mono_types([scalar], "absent_a", "absent_b", "scalar regression"):
            expect(types.len()).to_equal(1)
            expect(types[0].kind).to_equal(HirTypeKind.Int(64, true))
        else: expect(false).to_be(true)
        expect(pass_.diagnostics.len()).to_equal(0)

    it "retains imported provider rows and reserves the final counter in a caller without owned specializations":
        var setup = transport_pass()
        var caller_symbols: SymbolTable = setup.module_symbols["caller"]
        val high = setup.next_symbol
        caller_symbols.next_symbol_id = high
        var main_fn = transport_template()
        main_fn.name = "main"
        main_fn.symbol = SymbolId(id: 30)
        main_fn.type_params = []
        main_fn.params = []
        main_fn.return_type = transport_nested()
        val callee = transport_expr(HirExprKind.NamedVar(SymbolId(id: 20), "provider.identity"), transport_type(HirTypeKind.Any))
        main_fn.body.value = transport_expr(HirExprKind.Call(callee, [], [transport_nested()]), transport_nested())
        val template = transport_template()
        var caller_functions: Dict<SymbolId, HirFunction> = {}
        caller_functions[main_fn.symbol] = main_fn
        var provider_functions: Dict<SymbolId, HirFunction> = {}
        provider_functions[template.symbol] = template
        var modules: Dict<text, HirModule> = {}
        modules["caller"] = transport_module("caller", caller_symbols, caller_functions)
        modules["provider"] = transport_module("provider", setup.module_symbols["provider"], provider_functions)
        var pass_ = MonomorphizationPass.create()
        val result = pass_.run(modules)
        expect(pass_.diagnostics.len()).to_equal(0)
        expect(pass_.stats.specializations_created).to_equal(1)
        expect(result["caller"].symbols.next_symbol_id).to_equal(pass_.next_symbol)
        expect(result["caller"].symbols.next_symbol_id).to_be_greater_than(high)
        expect(result["provider"].symbols.lookup_qualified_type_raw("third", "Packet")).to_be_greater_than(0)

describe "body-free archive nominal specialization":
    it "hydrates only declaration tables and keeps caller and provider argument namespaces distinct":
        var pass_ = transport_archive_collector()
        expect(pass_.module_symbols.len()).to_equal(0)
        expect(pass_.generic_functions.len()).to_equal(0)
        val before = pass_.next_symbol
        val actual = transport_nested()
        val callee = transport_expr(HirExprKind.NamedVar(SymbolId(id: 20), "provider.identity"), transport_type(HirTypeKind.Any))
        val rewritten = pass_.rewrite_call(callee, [], [actual])
        expect_transport_call(rewritten, pass_, actual)
        expect(pass_.diagnostics.len()).to_equal(0)
        expect(pass_.specialized_functions.len()).to_equal(0)
        expect(pass_.archive_requests.len()).to_equal(1)
        expect(pass_.archive_nominal_imports.len()).to_equal(1)
        expect(pass_.next_symbol).to_equal(before + 2)
        val request = pass_.archive_requests[0]
        expect(request.caller_module).to_equal("caller")
        expect(request.module_name).to_equal("provider")
        expect(mono_owned_type_key(request.caller_type_args[0], pass_.module_symbols["caller"], "caller")).to_equal(
            mono_owned_type_key(request.type_args[0], pass_.module_symbols["provider"], "provider"))
        match request.type_args[0].kind:
            case HirTypeKind.Optional(array):
                match array.kind:
                    case HirTypeKind.Array(packet, size):
                        expect(size).to_equal(3)
                        match packet.kind:
                            case HirTypeKind.Named(id, _): expect(id.id).to_equal(before)
                            case _: expect(false).to_be(true)
                    case _: expect(false).to_be(true)
            case _: expect(false).to_be(true)
        expect(pass_.request_specialization("identity", [actual])).to_equal(request.symbol_id)
        expect(pass_.archive_requests.len()).to_equal(1)
        expect(pass_.next_symbol).to_equal(before + 2)

    it "uses the body-free signature for inherent methods as well as direct calls":
        var pass_ = transport_archive_collector()
        val actual = transport_nested()
        val receiver = transport_expr(HirExprKind.NamedVar(SymbolId(id: 40), "value"),
            transport_type(HirTypeKind.Named(SymbolId(id: 0), [actual])))
        val rewritten = pass_.rewrite_generic_method_call("identity", receiver, "identity", [], MethodResolution.Unresolved)
        expect_transport_call(rewritten, pass_, actual)
        expect(pass_.specialized_functions.len()).to_equal(0)
        expect(pass_.diagnostics.len()).to_equal(0)

    it "records import allocation in the delta without retaining worker tables":
        var collector = transport_archive_collector()
        expect(collector.ensure_archive_nominal_table_v2("caller")).to_be(true)
        expect(collector.ensure_archive_nominal_table_v2("provider")).to_be(true)
        val facts = mono_archive_facts_from_collector_v1(collector,
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").unwrap()
        expect(facts.symbol_projections.len()).to_equal(2)
        val state = mono_archive_state_create_v1(facts)
        val base = mono_archive_state_digest_v1(state)
        expect(base.len()).to_equal(64)
        var worker = mono_archive_scratch_pass_v1(state)
        worker.current_module = "caller"
        expect(worker.module_symbols.len()).to_equal(2)
        expect(worker.request_specialization("identity", [transport_nested()])).to_be_greater_than(state.next_symbol)
        val delta = mono_archive_delta_v1(state, worker, base, false)
        expect(delta.nominal_imports.len()).to_equal(1)
        expect(delta.requests.len()).to_equal(1)
        expect(delta.next_symbol).to_equal(state.next_symbol + 2)
        expect(state.nominal_imports.len()).to_equal(0)
        expect(mono_archive_state_digest_v1(state)).to_equal(base)
        var hydrated = SymbolTable.new()
        expect(mono_archive_nominal_install_v2(hydrated, "provider", delta.nominal_imports)).to_be(true)
        expect(hydrated.lookup_qualified_type_raw("third", "Packet")).to_equal(state.next_symbol)

    it "preserves accepted nominal declarations through the versioned final recipe":
        var worker = transport_archive_collector()
        worker.request_specialization("identity", [transport_nested()])
        val recipe = MonoVerificationGlobalRecipeV1(unresolved_templates: [], emitted_templates: [],
            next_symbol: worker.next_symbol, nominal_imports: worker.archive_nominal_imports)
        val encoded = mono_verification_global_encode_v1(recipe)
        val decoded = mono_verification_global_decode_v1(encoded)
        expect(decoded.is_ok()).to_be(true)
        expect(decoded.unwrap().nominal_imports.len()).to_equal(1)
        expect(mono_verification_global_encode_v1(decoded.unwrap())).to_equal(encoded)
        expect(mono_verification_global_decode_v1(encoded.replace("mono-verification-global-recipe-v2", "mono-verification-global-recipe-v1")).is_err()).to_be(true)
        expect(mono_verification_global_decode_v1(encoded + "extra\n").is_err()).to_be(true)

    it "refuses unavailable archive declaration ownership without publishing a request":
        var worker = transport_archive_collector()
        worker.archive_nominal_rows.remove("caller#0")
        val before = worker.next_symbol
        expect(worker.request_specialization("identity", [transport_packet()])).to_equal(-1)
        expect(worker.archive_requests.len()).to_equal(0)
        expect(worker.archive_nominal_imports.len()).to_equal(0)
        expect(worker.next_symbol).to_equal(before)

    it "refuses conflicting nominal overlays without changing the destination":
        val setup = transport_pass()
        val rows = mono_archive_nominal_project_v2("caller", setup.module_symbols["caller"])
        var destination = SymbolTable.new()
        destination.define("Packet", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "wrong")
        val before = destination.next_symbol_id
        expect(mono_archive_nominal_install_v2(destination, "caller", rows)).to_be(false)
        expect(destination.next_symbol_id).to_equal(before)
        expect(destination.symbols.len()).to_equal(1)
        expect(destination.symbols[0].defining_module).to_equal("wrong")

# Registration tag 21 remains the nominal DTO; upstream projection is tag 22.
# The domain changes so persisted pre-merge receipts cannot authenticate v3 rows.
describe "combined nominal registration protocol":
    it "binds symbol projections to tag 22 and the v3 row domain":
        val row = MonoArchiveRegistrationRowV1.SymbolProjection("caller", "projection-bytes")
        var current = HirCodecWriter.create()
        current.put_i64(22)
        current.put_text("caller")
        current.put_text("projection-bytes")
        val actual = mono_archive_registration_row_digest_v1(row)
        expect(actual).to_equal(sha256_text("mono-registration-row-v3\n" + current.finish()))
        var legacy = HirCodecWriter.create()
        legacy.put_i64(21)
        legacy.put_text("caller")
        legacy.put_text("projection-bytes")
        expect(actual == sha256_text("mono-registration-row-v2\n" + legacy.finish())).to_be(false)


fn transport_effect_pass(mode: MonoTemplateBodyModeV1, missing: bool) -> MonomorphizationPass:
    val setup = transport_pass()
    var template = transport_template()
    val thrown = transport_type(HirTypeKind.Named(SymbolId(id: if missing: 99 else: 0), []))
    template.effects = [Effect(kind: EffectKind.IO, span: Span.empty()),
        Effect(kind: EffectKind.Throws(thrown), span: Span.new(5, 6, 7, 8))]
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[template.symbol] = template
    var pass_ = MonomorphizationPass.create()
    pass_.template_body_mode = mode
    pass_.module_paths["provider"] = "synthetic/provider.spl"
    pass_.module_paths["caller"] = "synthetic/caller.spl"
    pass_.collect_generics(transport_module("provider", setup.module_symbols["provider"], functions), "provider")
    pass_.collect_generics(transport_module("caller", setup.module_symbols["caller"], {}), "caller")
    pass_.current_module = "caller"
    pass_

describe "nominal Throws ownership on specialized caller signatures":
    it "relocates a provider Throws declaration even when parameters and return are scalar":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = transport_effect_pass(mode, false)
            val integer = transport_type(HirTypeKind.Int(64, true))
            expect(pass_.request_specialization("identity", [integer])).to_be_greater_than(-1)
            val name = pass_.mangled_name("identity", [integer])
            val signature = pass_.specialization_signature_in_caller(name, Span.empty())
            expect(signature != nil).to_equal(true)
            match signature.unwrap().kind:
                case HirTypeKind.Function(_, _, effects):
                    expect(effects.len()).to_equal(2)
                    expect(effects[1].span.line).to_equal(7)
                    match effects[1].kind:
                        case EffectKind.Throws(type_):
                            match type_.kind:
                                case HirTypeKind.Named(id, _):
                                    expect(id.id).to_be_greater_than(0)
                                    val owner = pass_.module_symbols["caller"].get_symbol_raw(id.id)
                                    expect(owner.defining_module ?? "").to_equal("decoy")
                                    expect(owner.name).to_equal("Packet")
                                case _: fail("expected relocated nominal Throws")
                        case _: fail("expected Throws effect")
                case _: fail("expected specialized function signature")
            val original = pass_.module_symbols["caller"].get_symbol_raw(0)
            expect(original.defining_module ?? "").to_equal("third")
            expect(pass_.diagnostics.len()).to_equal(0)

    it "refuses an absent Throws declaration before caller symbol allocation":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = transport_effect_pass(mode, true)
            val integer = transport_type(HirTypeKind.Int(64, true))
            expect(pass_.request_specialization("identity", [integer])).to_be_greater_than(-1)
            val name = pass_.mangled_name("identity", [integer])
            val signature = pass_.specialization_signature_in_caller(name, Span.empty())
            expect(signature == nil).to_equal(true)
            expect(pass_.diagnostics.len()).to_be_greater_than(0)
            expect(pass_.diagnostics[pass_.diagnostics.len() - 1]).to_contain("nominal source symbol 99 is absent")
            expect(pass_.module_symbols["caller"].next_symbol_id).to_equal(1)


    it "routes a malformed Throws kind through validating transport instead of the scalar fast path":
        for mode in [MonoTemplateBodyModeV1.Retained, MonoTemplateBodyModeV1.ArchiveRequests]:
            var pass_ = transport_effect_pass(mode, false)
            val integer = transport_type(HirTypeKind.Int(64, true))
            expect(pass_.request_specialization("identity", [integer])).to_be_greater_than(-1)
            val name = pass_.mangled_name("identity", [integer])
            unsafe:
                val malformed = HirType(kind: nil, span: Span.empty())
                val effects = [Effect(kind: EffectKind.Throws(malformed), span: Span.empty())]
                if mode == MonoTemplateBodyModeV1.ArchiveRequests:
                    var signature = pass_.archive_specialized_signatures[name]
                    signature.effects = effects
                    pass_.archive_specialized_signatures[name] = signature
                else:
                    var function: HirFunction = pass_.specialized_functions[name]
                    function.effects = effects
                    pass_.specialized_functions[name] = function
            expect(pass_.specialization_signature_in_caller(name, Span.empty()) == nil).to_equal(true)
            expect(pass_.diagnostics.len()).to_be_greater_than(0)
            expect(pass_.diagnostics[pass_.diagnostics.len() - 1]).to_contain("absent type/kind")
            expect(pass_.module_symbols["caller"].next_symbol_id).to_equal(1)
