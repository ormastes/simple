# @req REQ-SSPEC-COMPILER
"""
# Module-scoped monomorphization (per-file lane default; whole-program lane uses the global pass)

One module F is monomorphized against a caller-supplied set of visible
template modules. Instances land in F's own function table flagged for
COMDAT (`linkonce_odr`) emission, spelled exactly as the global pass spells
them; the template module is never modified. A generic call whose template
is not visible is E-MONO-040, never silently skipped.
"""

# @tag:unit
# @tag:compiler
# @tag:generics

use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.mono.monomorphize_integration.{MonomorphizationPass,
    run_monomorphization_module_scoped_v1}

val TEMPLATE_SRC = "fn id<X>(x: X) -> X:\n    x\n"
val USER_SRC = "use t.{id}\n\nfn main() -> i64:\n    id(1)\n"

fn lower_v1(source: text, name: text) -> HirModule:
    val path = "testdata/{name}.spl"
    val ast = parse_full_frontend(source, path, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    lowering.lower_module(ast)

fn instance_names_v1(module: HirModule) -> [text]:
    var names: [text] = []
    for key in module.functions.keys():
        val f: HirFunction = module.functions[key]
        if f.name.contains("$"): names.push(f.name)
    names

describe "module-scoped monomorphization":
    it "places the instance in the requesting module with COMDAT linkage":
        val t = lower_v1(TEMPLATE_SRC, "t")
        val f = lower_v1(USER_SRC, "f")
        var templates: Dict<text, HirModule> = {}
        templates["t"] = t
        val (out, stats, diags) = run_monomorphization_module_scoped_v1(f, templates)
        expect(diags.len()).to_equal(0)
        expect(stats.specializations_created).to_equal(1)
        val names = instance_names_v1(out)
        expect(names.len()).to_equal(1)
        for key in out.functions.keys():
            val fun: HirFunction = out.functions[key]
            if fun.name.contains("$"):
                expect(fun.func_attr.is_comdat_instance).to_equal(true)

    it "spells the instance exactly as the global pass does":
        val t = lower_v1(TEMPLATE_SRC, "t")
        val f = lower_v1(USER_SRC, "f")
        var templates: Dict<text, HirModule> = {}
        templates["t"] = t
        val (out, _s, _d) = run_monomorphization_module_scoped_v1(f, templates)
        var both: Dict<text, HirModule> = {}
        both["t"] = lower_v1(TEMPLATE_SRC, "t")
        both["f"] = lower_v1(USER_SRC, "f")
        var global_pass = MonomorphizationPass.create()
        val global_out = global_pass.process_modules(both)
        var global_names: [text] = []
        for key in global_out.keys():
            for n in instance_names_v1(global_out[key]): global_names.push(n)
        expect(global_names.len()).to_equal(1)
        expect(instance_names_v1(out)[0]).to_equal(global_names[0])

    it "leaves the template module unchanged":
        val t = lower_v1(TEMPLATE_SRC, "t")
        val before = t.functions.len()
        var templates: Dict<text, HirModule> = {}
        templates["t"] = t
        val (_o, _s, _d) = run_monomorphization_module_scoped_v1(lower_v1(USER_SRC, "f"), templates)
        val after: HirModule = templates["t"]
        expect(after.functions.len()).to_equal(before)
        expect(instance_names_v1(after).len()).to_equal(0)

    it "fails closed with E-MONO-040 when the template is not visible":
        val empty: Dict<text, HirModule> = {}
        val (out, _s, diags) = run_monomorphization_module_scoped_v1(lower_v1(USER_SRC, "f"), empty)
        expect(diags.len()).to_equal(1)
        expect(diags[0]).to_contain("E-MONO-040: template")
        expect(diags[0]).to_contain("not visible to module")
        expect(instance_names_v1(out).len()).to_equal(0)
