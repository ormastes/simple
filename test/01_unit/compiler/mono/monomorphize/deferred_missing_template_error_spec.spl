use std.spec
use compiler.mono.monomorphize.deferred.{DeferredMonomorphizer}
use compiler.mono.monomorphize.deferred_subst.{InstantiationMode, deferred_last_error, deferred_clear_error}
use compiler.mono.monomorphize.types.{ConcreteType}

# Regression for https://github.com/ormastes/simple/issues/3021.
# Importing deferred must not depend on the unrelated bare error module.
describe "deferred missing template errors":
    it "returns nil and retains the missing template diagnostic":
        deferred_clear_error()
        var mono = DeferredMonomorphizer.new(InstantiationMode.LinkTime)
        val result = mono.instantiate_function("MissingTemplate", [ConcreteType.Int])
        expect(result).to_be_nil()
        expect(deferred_last_error).to_equal("Template not found: MissingTemplate")
        deferred_clear_error()
