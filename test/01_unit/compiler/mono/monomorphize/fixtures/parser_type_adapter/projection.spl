use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.mono.monomorphize.types.{ConcreteType, PointerKind, ReferenceCapability}
use compiler.mono.monomorphize.util.{concrete_to_ast_type, ast_type_to_concrete}

fn main() -> i32:
    val handle = ConcreteType.Pointer(PointerKind.Handle, ReferenceCapability.Shared, ConcreteType.Int)
    val error_type = concrete_to_ast_type(handle)
    val wrapped = Type(kind: TypeKind.Projection(error_type, "Item"), span: Span(0, 0, 0, 0, "", 0))
    val result = ast_type_to_concrete(wrapped, {"T": ConcreteType.Int})
    0
