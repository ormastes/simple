use std.spec
use app.io.mod.{process_run_timeout}

# Execute only with a deployed self-hosted runtime; never substitute a seed.
# Check both exit status and the exact panic, so an import/build failure is RED.
fn check_rejected_adapter_error(fixture: text):
    val (stdout, stderr, code) = process_run_timeout("bin/simple", ["run", "test/01_unit/compiler/mono/monomorphize/fixtures/parser_type_adapter/" + fixture + ".spl"], 30000)
    expect(code == 0).to_equal(false)
    expect(stdout + stderr).to_contain("cannot monomorphize invalid AST type")

describe "invalid parser types never become a named Unknown":
    it "rejects direct Handle Error": check_rejected_adapter_error("direct")
    it "rejects Handle Error under Optional": check_rejected_adapter_error("optional")
    it "rejects Handle Error before a generic binding hides it": check_rejected_adapter_error("bound_generic")
    it "rejects Handle Error beneath an unsupported projection": check_rejected_adapter_error("projection")
