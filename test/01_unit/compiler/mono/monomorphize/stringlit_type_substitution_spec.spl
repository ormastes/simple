# @req REQ-SSPEC-COMPILER
# Regression for #3049: optional interpolation arrays retain recursive substitution.
use std.spec
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirInterpolation}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use compiler.hir.generated.hir_codec.{hc_enc_hir_expr, hc_dec_hir_expr}
use compiler.monomorphize.type_subst.{TypeSubstitution, substitute_expr}

fn interpolation_parts(type_: HirType) -> [HirInterpolation]:
    var span = Span.empty()
    span.line = 17
    span.col = 9
    val child = HirExpr(kind: HirExprKind.IntLit(7, nil),
        has_type_: true, type_: type_, span: span)
    val cast = HirExpr(kind: HirExprKind.Cast(child, type_),
        has_type_: true, type_: type_, span: span)
    [HirInterpolation(expr: cast, has_format: true, format: "04d", span: span)]

fn literal(parts: [HirInterpolation]?) -> HirExpr:
    val string_type = HirType(kind: HirTypeKind.Str, span: Span.empty())
    HirExpr(kind: HirExprKind.StringLit("value=\{7:04d\}", parts),
        has_type_: true, type_: string_type, span: Span.empty())

fn encoded(expr: HirExpr) -> text:
    var writer = HirCodecWriter.create()
    hc_enc_hir_expr(writer, expr)
    expect(writer.ok).to_equal(true)
    writer.finish()

fn expect_substitution(parts: [HirInterpolation]?, expected_parts: [HirInterpolation]?, from_cache: bool, changed: bool):
    var input = literal(parts)
    val before = encoded(input)
    if from_cache:
        var reader = FlatPoolReader.new(before)
        input = hc_dec_hir_expr(reader)
        expect(reader.ok).to_equal(true)
        expect(encoded(input)).to_equal(before)
    val concrete = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
    val subst = TypeSubstitution(mapping: {"T": concrete}, by_symbol: {})
    val actual = encoded(substitute_expr(input, subst))
    # Full codec equality verifies nested expression and cast types, formatting,
    # literal text, spans, and the difference between nil and a present empty list.
    expect(actual).to_equal(encoded(literal(expected_parts)))
    expect(actual != before).to_equal(changed)

describe "StringLit optional interpolation type substitution":
    it "substitutes nested types in fresh and codec-decoded interpolation arrays":
        val generic = HirType(kind: HirTypeKind.TypeParam("T", []), span: Span.empty())
        val concrete = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        for from_cache in [false, true]:
            expect_substitution(interpolation_parts(generic), interpolation_parts(concrete), from_cache, true)

    it "substitutes nested types in explicitly wrapped interpolation arrays":
        val generic = HirType(kind: HirTypeKind.TypeParam("T", []), span: Span.empty())
        val concrete = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        for from_cache in [false, true]:
            expect_substitution(Some(interpolation_parts(generic)), Some(interpolation_parts(concrete)), from_cache, true)

    it "preserves absent and present-empty interpolation lists":
        val empty: [HirInterpolation] = []
        for from_cache in [false, true]:
            expect_substitution(nil, nil, from_cache, false)
            expect_substitution(Some(empty), Some(empty), from_cache, false)
