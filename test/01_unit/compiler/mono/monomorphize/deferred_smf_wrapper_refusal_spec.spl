# @req REQ-GENERIC-SMF-TYPED-EXTRACTION
# Actual writer/file/reader APIs; source-predicted RED. Runtime UNRUN.
use std.spec.{describe, it, expect, step, fail}
use compiler.frontend.ast.FunctionDef
use compiler.driver.smf_writer.{SmfBuildOptions, Target, generate_smf_with_raw_code_options}
use compiler.driver.smf_binary_helpers.smf_u64_to_bytes
use compiler.mono.monomorphize.partition.GenericTemplates
use compiler.mono.monomorphize.deferred.{DeferredMonomorphizer, GenericTemplate}
use compiler.mono.monomorphize.deferred_subst.{InstantiationMode, deferred_last_error, deferred_set_error}
use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory, SMF_TEMPLATE_CODE_SECTION_TYPE}
use compiler.backend.linker.smf_reader.SmfReaderImpl
use compiler.backend.linker.obj_taker.SmfReader
use std.nogc_sync_mut.io.file_ops.secure_temp_dir_raw
use std.nogc_sync_mut.io_runtime.{file_write_bytes, dir_remove_all, dir_exists}

fn file_template_definition(name: text, body: text) -> FunctionDef:
    FunctionDef(name: name, generic_params: ["T"], params: ["value: T"],
        has_return_type: true, return_type: "T", body: [body], is_generic_template: true,
        has_specialization_of: false, specialization_of: "", type_bindings: {})

fn file_template_image(with_templates: bool) -> [u8]:
    var options = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
    if with_templates:
        options.templates = Some(GenericTemplates(functions: [file_template_definition("loaded", "value")], structs: [], classes: [], enums: [], traits: []))
    generate_smf_with_raw_code_options([195u8], options)

fn file_template_reader(bytes: [u8]) -> SmfReaderMemory:
    val result = SmfReaderMemory.from_data(bytes)
    if result.is_err():
        fail(result.unwrap_err())
        return nil
    result.unwrap()

fn file_template_write(dir: text, bytes: [u8]) -> text:
    val path = dir + "/templates.smf"
    expect(file_write_bytes(path, bytes)).to_be(true)
    path

fn file_template_expect(mono: DeferredMonomorphizer, name: text, body: text):
    expect(mono.has_template(name)).to_be(true)
    val template: GenericTemplate = mono.template_cache[name]
    match template:
        case GenericTemplate.Function(function):
            expect(function.body.len()).to_equal(1)
            expect(function.body[0]).to_equal(body)
            expect(function.generic_params.len()).to_equal(1)
            expect(function.generic_params[0]).to_equal("T")
            expect(function.params.len()).to_equal(1)
            expect(function.params[0]).to_equal("value: T")
        case _: fail("file extraction changed template owner")

fn file_template_set_u64(bytes: [u8], offset: i64, value: i64) -> [u8]:
    var changed = bytes
    val encoded = smf_u64_to_bytes(value)
    for index in 0..8: changed[offset + index] = encoded[index]
    changed

describe "canonical SMF template extraction":
    it "loads actual TemplateCode at index one through file and memory readers":
        val dir = secure_temp_dir_raw(".", "smf-template-positive")
        if dir == "": fail("temporary directory creation failed")
        val bytes = file_template_image(true)
        val reader = file_template_reader(bytes)
        val selected = reader.find_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE)
        if selected.is_err(): fail(selected.unwrap_err())
        expect(selected.unwrap()).to_equal(1)
        expect(reader.read_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE).is_ok()).to_be(true)
        val path = file_template_write(dir, bytes)
        val opened = SmfReaderImpl.open(path)
        if opened.is_err(): fail(opened.unwrap_err())
        expect(opened.unwrap().find_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE)).to_equal(1)
        step("Load actual file bytes in both modes without compiling or mapping bodies")
        for mode in [InstantiationMode.LinkTime, InstantiationMode.JitTime]:
            var mono = DeferredMonomorphizer.new(mode)
            mono.register_template(GenericTemplate.Function(file_template_definition("kept", "original")))
            deferred_set_error("old failure")
            expect(mono.load_templates_from_smf(path)).to_be(true)
            expect(deferred_last_error).to_equal("")
            expect(mono.template_cache.keys().len()).to_equal(2)
            file_template_expect(mono, "loaded", "value")
            file_template_expect(mono, "kept", "original")
            expect(mono.specialization_count()).to_equal(0)
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)

    it "uses recorded section types after reordering and refuses duplicates":
        var bytes = file_template_image(true)
        val original = file_template_reader(bytes)
        val table = original.sections_offset
        var swapped: [u8] = []
        for byte in bytes: swapped = swapped.push(byte)
        for index in 0..64:
            swapped[table + index] = bytes[table + 64 + index]
            swapped[table + 64 + index] = bytes[table + index]
        val reordered = file_template_reader(swapped)
        expect(reordered.find_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE).unwrap()).to_equal(0)
        expect(reordered.read_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE).is_ok()).to_be(true)
        bytes[table] = 12u8
        val duplicated = file_template_reader(bytes)
        val found = duplicated.find_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE)
        expect(found.is_err()).to_be(true)
        expect(found.unwrap_err()).to_equal("Duplicate SMF section type: 12")

    it "refuses missing, unknown, duplicate and truncated TemplateCode without publication":
        val dir = secure_temp_dir_raw(".", "smf-template-section-errors")
        if dir == "": fail("temporary directory creation failed")
        for fault in [0, 1, 2, 3]:
            var bytes = file_template_image(fault != 0)
            if fault != 0:
                val reader = file_template_reader(bytes)
                val entry = reader.sections_offset + 64
                if fault == 1: bytes[entry] = 99u8
                if fault == 2: bytes[reader.sections_offset] = 12u8
                if fault == 3: bytes = file_template_set_u64(bytes, entry + 16, 9)
            var mono = DeferredMonomorphizer.new(InstantiationMode.LinkTime)
            mono.register_template(GenericTemplate.Function(file_template_definition("kept", "original")))
            expect(mono.load_templates_from_smf(file_template_write(dir, bytes))).to_be(false)
            expect(deferred_last_error.len()).to_be_greater_than(0)
            expect(mono.has_template("loaded")).to_be(false)
            expect(mono.template_cache.keys().len()).to_equal(1)
            file_template_expect(mono, "kept", "original")
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)

    it "rejects overflowing or truncated table and payload bounds before indexing":
        val dir = secure_temp_dir_raw(".", "smf-template-bounds")
        if dir == "": fail("temporary directory creation failed")
        for fault in [0, 1, 2, 3, 4, 5, 6, 7]:
            var bytes = file_template_image(true)
            val reader = file_template_reader(bytes)
            val header = reader.header.header_offset
            val entry = reader.sections_offset + 64
            if fault == 0: bytes = file_template_set_u64(bytes, header + 20, 9223372036854775807)
            if fault == 1:
                for index in 0..4: bytes[header + 16 + index] = 255u8
            if fault == 2: bytes = file_template_set_u64(bytes, entry + 8, 9223372036854775807)
            if fault == 3: bytes = file_template_set_u64(bytes, entry + 16, 9223372036854775807)
            if fault == 4: bytes = file_template_set_u64(bytes, header + 28, 9223372036854775807)
            if fault == 5:
                for index in 0..8: bytes[entry + 8 + index] = 255u8
            if fault == 6: bytes = file_template_set_u64(bytes, header + 20, bytes.len() - 63)
            if fault == 7:
                # Exercise string-table discovery before typed extraction.
                bytes[entry] = 6u8
                bytes = file_template_set_u64(bytes, entry + 16, 9223372036854775807)
            var mono = DeferredMonomorphizer.new(InstantiationMode.LinkTime)
            expect(mono.load_templates_from_smf(file_template_write(dir, bytes))).to_be(false)
            expect(deferred_last_error.len()).to_be_greater_than(0)
            expect(mono.template_cache.keys().len()).to_equal(0)
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)

    it "rejects compressed, unknown outer formats and incompatible GTPL versions":
        val dir = secure_temp_dir_raw(".", "smf-template-format")
        if dir == "": fail("temporary directory creation failed")
        for fault in [0, 1, 2, 3, 4]:
            var bytes = file_template_image(true)
            val reader = file_template_reader(bytes)
            val header = reader.header.header_offset
            if fault == 0: bytes[header + 12] = 1u8
            if fault == 1: bytes[header + 12] = 255u8
            if fault == 2: bytes[header + 4] = 2u8
            if fault == 3:
                # One-byte code prefix is emitted by this real writer fixture.
                expect(bytes[1]).to_equal(71u8)
                bytes[5] = 3u8
            if fault == 4: bytes[header + 5] = 2u8
            var mono = DeferredMonomorphizer.new(InstantiationMode.JitTime)
            expect(mono.load_templates_from_smf(file_template_write(dir, bytes))).to_be(false)
            expect(deferred_last_error.len()).to_be_greater_than(0)
            expect(mono.template_cache.keys().len()).to_equal(0)
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)

    it "reports file and header failures then recovers through a real valid file":
        val dir = secure_temp_dir_raw(".", "smf-template-recovery")
        if dir == "": fail("temporary directory creation failed")
        var mono = DeferredMonomorphizer.new(InstantiationMode.LinkTime)
        expect(mono.load_templates_from_smf(dir + "/absent.smf")).to_be(false)
        expect(deferred_last_error).to_contain("file byte read failed")
        expect(mono.load_templates_from_smf(file_template_write(dir, [1u8, 2u8]))).to_be(false)
        expect(deferred_last_error).to_contain("SMF data too small")
        expect(mono.template_cache.keys().len()).to_equal(0)
        expect(mono.load_templates_from_smf(file_template_write(dir, file_template_image(true)))).to_be(true)
        expect(deferred_last_error).to_equal("")
        file_template_expect(mono, "loaded", "value")
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)

    it "accepts a canonical zero-template transaction and the supported outer legacy version":
        val dir = secure_temp_dir_raw(".", "smf-template-empty")
        if dir == "": fail("temporary directory creation failed")
        var options = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
        options.templates = Some(GenericTemplates(functions: [], structs: [], classes: [], enums: [], traits: []))
        val bytes = generate_smf_with_raw_code_options([195u8], options)
        var mono = DeferredMonomorphizer.new(InstantiationMode.LinkTime)
        mono.register_template(GenericTemplate.Function(file_template_definition("kept", "original")))
        expect(mono.load_templates_from_smf(file_template_write(dir, bytes))).to_be(true)
        expect(mono.template_cache.keys().len()).to_equal(1)
        file_template_expect(mono, "kept", "original")
        var legacy = file_template_image(true)
        val reader = file_template_reader(legacy)
        legacy[reader.header.header_offset + 5] = 0u8
        expect(mono.load_templates_from_smf(file_template_write(dir, legacy))).to_be(true)
        file_template_expect(mono, "loaded", "value")
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)

    it "keeps an existing template when a later file record is truncated":
        step("Load a real two-record SMF with a valid replacement followed by a truncated record")
        val dir = secure_temp_dir_raw(".", "smf-template-atomic")
        if dir == "": fail("temporary directory creation failed")
        var options = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
        options.templates = Some(GenericTemplates(
            functions: [file_template_definition("kept", "replacement"), file_template_definition("second", "value")],
            structs: [], classes: [], enums: [], traits: []))
        val complete = generate_smf_with_raw_code_options([195u8], options)
        val reader = file_template_reader(complete)
        val selected = reader.find_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE).unwrap()
        val section = reader.read_section_by_type(SMF_TEMPLATE_CODE_SECTION_TYPE).unwrap()
        expect(section.len()).to_be_greater_than(10)
        val truncated = file_template_set_u64(complete, reader.sections_offset + selected * 64 + 16, section.len() - 1)
        for mode in [InstantiationMode.LinkTime, InstantiationMode.JitTime]:
            var mono = DeferredMonomorphizer.new(mode)
            mono.register_template(GenericTemplate.Function(file_template_definition("kept", "original")))
            expect(mono.load_templates_from_smf(file_template_write(dir, truncated))).to_be(false)
            expect(deferred_last_error.len()).to_be_greater_than(0)
            expect(mono.template_cache.keys().len()).to_equal(1)
            file_template_expect(mono, "kept", "original")
            expect(mono.has_template("second")).to_be(false)
            expect(mono.specialization_count()).to_equal(0)
        expect(dir_remove_all(dir)).to_be(true)
        expect(dir_exists(dir)).to_be(false)
