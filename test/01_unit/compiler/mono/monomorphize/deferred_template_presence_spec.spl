# @req REQ-GENERIC-SMF-TYPED-EXTRACTION
# Actual AST flags and existing GTPL-v2 writer/decoder; execution UNRUN.
use std.spec.{describe, it, expect, step, fail}
use compiler.frontend.ast.{FunctionDef, StructDef, ClassDef, EnumDef}
use compiler.mono.monomorphize.partition.GenericTemplates
use compiler.driver.smf_serialization.serialize_templates
use compiler.mono.monomorphize.deferred.{DeferredMonomorphizer, GenericTemplate}
use compiler.mono.monomorphize.deferred_subst.{InstantiationMode, deferred_last_error}

fn presence_templates(present: bool, value: text) -> GenericTemplates:
    GenericTemplates(
        functions: [FunctionDef(name: "function", generic_params: ["T"], params: ["x: T"],
            has_return_type: present, return_type: value, body: ["x"], is_generic_template: true,
            has_specialization_of: present, specialization_of: value, type_bindings: {})],
        structs: [StructDef(name: "struct", generic_params: ["T"], fields: [], is_generic_template: true,
            has_specialization_of: present, specialization_of: value, type_bindings: {})],
        classes: [ClassDef(name: "class", generic_params: ["T"], fields: [], methods: [], is_generic_template: true,
            has_specialization_of: present, specialization_of: value, type_bindings: {})],
        enums: [EnumDef(name: "enum", generic_params: ["T"], variants: [], is_generic_template: true,
            has_specialization_of: present, specialization_of: value, type_bindings: {})], traits: [])

fn presence_check(mono: DeferredMonomorphizer, present: bool, value: text):
    expect(mono.template_cache.keys().len()).to_equal(4)
    match mono.template_cache["function"]:
        case GenericTemplate.Function(node):
            expect(node.has_return_type).to_equal(present)
            expect(node.return_type).to_equal(value)
            expect(node.has_specialization_of).to_equal(present)
            expect(node.specialization_of).to_equal(value)
            expect(node.body[0]).to_equal("x")
        case _: fail("wrong function template kind")
    match mono.template_cache["struct"]:
        case GenericTemplate.Struct(node):
            expect(node.has_specialization_of).to_equal(present)
            expect(node.specialization_of).to_equal(value)
        case _: fail("wrong struct template kind")
    match mono.template_cache["class"]:
        case GenericTemplate.Class(node):
            expect(node.has_specialization_of).to_equal(present)
            expect(node.specialization_of).to_equal(value)
        case _: fail("wrong class template kind")
    match mono.template_cache["enum"]:
        case GenericTemplate.Enum(node):
            expect(node.has_specialization_of).to_equal(present)
            expect(node.specialization_of).to_equal(value)
        case _: fail("wrong enum template kind")

describe "GTPL explicit AST optional fields":
    it "preserves absent, present empty and present named fields for every affected owner":
        step("Serialize actual AST flag/value fields and decode through the public transaction")
        for state in [0, 1, 2]:
            val present = state != 0
            val value = if state == 2: "Origin<T>" else: ""
            val bytes = serialize_templates(presence_templates(present, value))
            expect(bytes[4]).to_equal(2u8)
            expect(bytes[5]).to_equal(0u8)
            for mode in [InstantiationMode.LinkTime, InstantiationMode.JitTime]:
                var mono = DeferredMonomorphizer.new(mode)
                expect(mono.deserialize_templates(bytes)).to_be(true)
                expect(deferred_last_error).to_equal("")
                presence_check(mono, present, value)
                expect(mono.specialization_count()).to_equal(0)

    it "uses absence flags rather than stale payload text for wire presence":
        step("Compare complete canonical sections element by element")
        val stale = serialize_templates(presence_templates(false, "ignored stale payload"))
        val empty = serialize_templates(presence_templates(false, ""))
        expect(stale.len()).to_equal(empty.len())
        for index in 0..empty.len(): expect(stale[index]).to_equal(empty[index])
        val present_empty = serialize_templates(presence_templates(true, ""))
        # Five present text fields each add a four-byte length, even when empty.
        expect(present_empty.len()).to_equal(empty.len() + 20)
        var mono = DeferredMonomorphizer.new(InstantiationMode.LinkTime)
        expect(mono.deserialize_templates(stale)).to_be(true)
        presence_check(mono, false, "")
