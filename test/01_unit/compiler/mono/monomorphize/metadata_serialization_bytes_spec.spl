use std.spec
use app.io.mod.{process_run_timeout}

# Issue #3048. The standalone fixture calls production serializers and compares
# every byte against fixed goldens. Nonzero, timeout, or missing marker is RED.
describe "monomorphization META v1 serialization":
    it "preserves the exact byte format, UTF-8 payloads and category order":
        val (stdout, stderr, code) = process_run_timeout("bin/simple", ["run", "test/01_unit/compiler/mono/monomorphize/fixtures/metadata_serialization_probe.spl"], 30000)
        expect(code).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("metadata-serialization-goldens:PASS")
