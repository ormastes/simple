use std.spec
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{Type, TypeKind, Expr, ExprKind}
use compiler.frontend.parser_types_expr.{parser_type_kind_named_name, parser_type_kind_named_args}
use compiler.mono.monomorphize.types.{ConcreteType, PointerKind, ReferenceCapability}
use compiler.mono.monomorphize.util.{concrete_to_ast_type, ast_type_to_concrete, type_uses_param, infer_concrete_type, mono_pointer_concrete}

fn adapter_type(kind: TypeKind) -> Type:
    Type(kind: kind, span: Span(0, 0, 0, 0, "", 0))

fn adapter_expr(kind: ExprKind) -> Expr:
    Expr(kind: kind, span: Span(0, 0, 0, 0, "", 0))

fn check_pointer_adapter(kind: PointerKind, capability: ReferenceCapability, expected: TypeKind):
    val inner = ConcreteType.Optional(ConcreteType.Named("Payload"))
    val concrete = ConcreteType.Pointer(kind, capability, inner)
    val ast = concrete_to_ast_type(concrete)
    expect(ast.kind).to_equal(expected)
    expect(ast_type_to_concrete(ast, {})).to_equal(concrete)

fn check_literal_adapter(kind: ExprKind, expected: ConcreteType):
    val actual = infer_concrete_type(adapter_expr(kind), {})
    expect(actual.?).to_equal(true)
    expect(actual!).to_equal(expected)

fn check_pointer_capability_owner(kind: PointerKind, capability: ReferenceCapability):
    val inner = adapter_type(TypeKind.Named("T", []))
    val actual = mono_pointer_concrete(kind, inner, {"T": ConcreteType.String})
    val expected = ConcreteType.Pointer(kind, capability, ConcreteType.String)
    expect(actual).to_equal(expected)

describe "current parser monomorphization adapter":
    it "retains every representable pointer capability and substitutes its leaf":
        check_pointer_capability_owner(PointerKind.Unique, ReferenceCapability.Isolated)
        check_pointer_capability_owner(PointerKind.Shared, ReferenceCapability.Shared)
        check_pointer_capability_owner(PointerKind.Weak, ReferenceCapability.Shared)
        check_pointer_capability_owner(PointerKind.Borrow, ReferenceCapability.Shared)
        check_pointer_capability_owner(PointerKind.BorrowMut, ReferenceCapability.Exclusive)
        check_pointer_capability_owner(PointerKind.RawConst, ReferenceCapability.Shared)
        check_pointer_capability_owner(PointerKind.RawMut, ReferenceCapability.Exclusive)

    it "preserves named and already-specialized names":
        val named = concrete_to_ast_type(ConcreteType.Named("Widget"))
        expect(parser_type_kind_named_name(named.kind)).to_equal("Widget")
        expect(parser_type_kind_named_args(named.kind).len()).to_equal(0)
        val specialized = concrete_to_ast_type(ConcreteType.Specialized("List$Int", [ConcreteType.Int]))
        expect(parser_type_kind_named_name(specialized.kind)).to_equal("List$Int")
        expect(parser_type_kind_named_args(specialized.kind).len()).to_equal(0)
        expect(ast_type_to_concrete(named, {})).to_equal(ConcreteType.Named("Widget"))

    it "normalizes primitive aliases and preserves legitimate Unknown and Infer":
        expect(ast_type_to_concrete(adapter_type(TypeKind.Named("i32", [])), {})).to_equal(ConcreteType.Int)
        expect(ast_type_to_concrete(adapter_type(TypeKind.Named("text", [])), {})).to_equal(ConcreteType.String)
        expect(ast_type_to_concrete(adapter_type(TypeKind.Named("Unknown", [])), {})).to_equal(ConcreteType.Named("Unknown"))
        expect(ast_type_to_concrete(adapter_type(TypeKind.Infer), {})).to_equal(ConcreteType.Named("Unknown"))

    it "substitutes nested named parameters and finds them inside wrappers":
        val parameter = adapter_type(TypeKind.Named("T", []))
        val optional = adapter_type(TypeKind.Optional(parameter))
        val array = adapter_type(TypeKind.Array(optional, nil))
        val signature = adapter_type(TypeKind.Function([array], parameter))
        val expected = ConcreteType.Function([ConcreteType.Array(ConcreteType.Optional(ConcreteType.String))], ConcreteType.String)
        expect(ast_type_to_concrete(signature, {"T": ConcreteType.String})).to_equal(expected)
        expect(type_uses_param(signature, "T")).to_equal(true)
        expect(type_uses_param(signature, "U")).to_equal(false)
        expect(type_uses_param(adapter_type(TypeKind.Pointer(parameter, true)), "T")).to_equal(true)
        expect(type_uses_param(adapter_type(TypeKind.Atomic(parameter)), "T")).to_equal(true)

    it "round trips nested optional tuple and function types":
        val concrete = ConcreteType.Optional(ConcreteType.Tuple([ConcreteType.Function([ConcreteType.Int], ConcreteType.Bool), ConcreteType.Array(ConcreteType.String)]))
        expect(ast_type_to_concrete(concrete_to_ast_type(concrete), {})).to_equal(concrete)

    it "preserves dictionary generic output and union cardinality rules":
        val dict = concrete_to_ast_type(ConcreteType.Dict(ConcreteType.String, ConcreteType.Int))
        expect(parser_type_kind_named_name(dict.kind)).to_equal("Dict")
        expect(ast_type_to_concrete(dict, {})).to_equal(ConcreteType.Specialized("Dict", [ConcreteType.String, ConcreteType.Int]))
        expect(ast_type_to_concrete(adapter_type(TypeKind.Union([])), {})).to_equal(ConcreteType.Nil)
        val integer = adapter_type(TypeKind.Named("Int", []))
        expect(ast_type_to_concrete(adapter_type(TypeKind.Union([integer])), {})).to_equal(ConcreteType.Int)
        val union = ConcreteType.Union([ConcreteType.Int, ConcreteType.String])
        expect(ast_type_to_concrete(concrete_to_ast_type(union), {})).to_equal(union)

    it "maps Unique to Isolated":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.Unique, ReferenceCapability.Isolated, TypeKind.Isolated(inner))

    it "maps Shared to Atomic at the parser boundary only":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.Shared, ReferenceCapability.Shared, TypeKind.Atomic(inner))

    it "maps Weak to Weak":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.Weak, ReferenceCapability.Shared, TypeKind.Weak(inner))

    it "maps Borrow to immutable Reference":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.Borrow, ReferenceCapability.Shared, TypeKind.Reference(inner, false))

    it "maps BorrowMut to mutable Reference":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.BorrowMut, ReferenceCapability.Exclusive, TypeKind.Reference(inner, true))

    it "maps RawConst to immutable Pointer":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.RawConst, ReferenceCapability.Shared, TypeKind.Pointer(inner, false))

    it "maps RawMut to mutable Pointer":
        val inner = adapter_type(TypeKind.Optional(adapter_type(TypeKind.Named("Payload", []))))
        check_pointer_adapter(PointerKind.RawMut, ReferenceCapability.Exclusive, TypeKind.Pointer(inner, true))

    it "derives pointer capability from kind as before":
        val concrete = ConcreteType.Pointer(PointerKind.RawMut, ReferenceCapability.Shared, ConcreteType.Int)
        val roundtrip = ast_type_to_concrete(concrete_to_ast_type(concrete), {})
        expect(roundtrip).to_equal(ConcreteType.Pointer(PointerKind.RawMut, ReferenceCapability.Exclusive, ConcreteType.Int))

    it "marks unsupported Handle as Error without inventing a type":
        val handle = ConcreteType.Pointer(PointerKind.Handle, ReferenceCapability.Shared, ConcreteType.Int)
        val ast = concrete_to_ast_type(handle)
        expect(ast.kind).to_equal(TypeKind.Error)
        val optional = concrete_to_ast_type(ConcreteType.Optional(handle))
        expect(optional.kind).to_equal(TypeKind.Error)

    it "infers literal types through ExprKind":
        check_literal_adapter(ExprKind.IntLit(42), ConcreteType.Int)
        check_literal_adapter(ExprKind.FloatLit(1.5), ConcreteType.Float)
        check_literal_adapter(ExprKind.StringLit("hello", nil), ConcreteType.String)
        check_literal_adapter(ExprKind.BoolLit(true), ConcreteType.Bool)
        check_literal_adapter(ExprKind.NilLit, ConcreteType.Nil)

    it "infers identifiers and first array elements and rejects unknowns":
        val identifier = infer_concrete_type(adapter_expr(ExprKind.Ident("value")), {"value": ConcreteType.Bool})
        expect(identifier.?).to_equal(true)
        expect(identifier!).to_equal(ConcreteType.Bool)
        val array = infer_concrete_type(adapter_expr(ExprKind.ArrayLit([adapter_expr(ExprKind.IntLit(7))])), {})
        expect(array.?).to_equal(true)
        expect(array!).to_equal(ConcreteType.Array(ConcreteType.Int))
        expect(infer_concrete_type(adapter_expr(ExprKind.ArrayLit([])), {})).to_be_nil()
        expect(infer_concrete_type(adapter_expr(ExprKind.Ident("missing")), {})).to_be_nil()
        expect(infer_concrete_type(adapter_expr(ExprKind.TupleLit([])), {})).to_be_nil()

    it "substitutes parameters in generic named arguments":
        val parameter = adapter_type(TypeKind.Named("T", []))
        val generic = adapter_type(TypeKind.Named("List", [parameter]))
        expect(ast_type_to_concrete(generic, {"T": ConcreteType.Int})).to_equal(ConcreteType.Specialized("List", [ConcreteType.Int]))
        expect(type_uses_param(generic, "T")).to_equal(true)

    it "lifts nested Handle Error across every materialized composite":
        val handle = ConcreteType.Pointer(PointerKind.Handle, ReferenceCapability.Shared, ConcreteType.Int)
        val composites: [ConcreteType] = [
            ConcreteType.Array(handle),
            ConcreteType.Tuple([ConcreteType.Int, handle]),
            ConcreteType.Dict(handle, ConcreteType.Int),
            ConcreteType.Dict(ConcreteType.Int, handle),
            ConcreteType.Function([handle], ConcreteType.Int),
            ConcreteType.Function([ConcreteType.Int], handle),
            ConcreteType.Optional(handle),
            ConcreteType.Pointer(PointerKind.Unique, ReferenceCapability.Isolated, handle),
            ConcreteType.Pointer(PointerKind.Shared, ReferenceCapability.Shared, handle),
            ConcreteType.Pointer(PointerKind.Weak, ReferenceCapability.Shared, handle),
            ConcreteType.Pointer(PointerKind.Borrow, ReferenceCapability.Shared, handle),
            ConcreteType.Pointer(PointerKind.BorrowMut, ReferenceCapability.Exclusive, handle),
            ConcreteType.Pointer(PointerKind.RawConst, ReferenceCapability.Shared, handle),
            ConcreteType.Pointer(PointerKind.RawMut, ReferenceCapability.Exclusive, handle),
            ConcreteType.Union([ConcreteType.Int, handle])
        ]
        for composite in composites:
            val ast = concrete_to_ast_type(composite)
            expect(ast.kind).to_equal(TypeKind.Error)

    it "keeps already-specialized names authoritative over discarded arguments":
        val handle = ConcreteType.Pointer(PointerKind.Handle, ReferenceCapability.Shared, ConcreteType.Int)
        val ast = concrete_to_ast_type(ConcreteType.Specialized("Resolved$Handle", [handle]))
        expect(ast.kind).to_equal(TypeKind.Named("Resolved$Handle", []))
