use std.spec.*
use compiler.driver.cache.cold_hir_source_inventory_admission_v1.{cold_hir_source_inventory_admit_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1,
    CompileSourceInventoryV1, CompileSourceInventoryReadV1,
    compile_source_inventory_digest_v1}
use std.common.crypto.sha256.{sha256_text}

# doc/08_tracking/bug/stage2_windows_frontend_hir_cold_receipt_perf_2026-10-16.md
# Cold HIR receipt admission re-derived the inventory digest (sort + encode +
# sha256 over every row) even though the reader had already authenticated it:
# 42.8 s of a 38.5-43 s fixed cost at 14,443 rows (seed interpreter, Windows),
# paid for a 1-module closure. Cost pin: with the reader-minted digest the
# admission must cost at most HALF of the recompute path (measured ratio is
# far below that, so the threshold has wide headroom and is host independent).

val ROWS: i64 = 3000

fn build_inventory() -> CompileSourceInventoryV1:
    val empty = sha256_text("")
    val d = sha256_text("x")
    var entries: [CompileSourceInventoryEntryV1] = []
    var i = 0
    while i < ROWS:
        entries = entries.push(CompileSourceInventoryEntryV1("pkg/m{i}.spl", d, empty, empty, empty, empty, 5))
        i = i + 1
    CompileSourceInventoryV1(1, 7, entries)

fn admitted_inventory(
    inventory: CompileSourceInventoryV1, digest: text
) -> CompileSourceInventoryReadV1:
    CompileSourceInventoryReadV1(true, "", digest, Some(inventory))

describe "cold HIR inventory admission binding":
    it "accepts a reader result whose payload really matches its digest":
        val inv = build_inventory()
        val digest = compile_source_inventory_digest_v1(inv)
        val d = sha256_text("x")
        val snap = "pkg/m1.spl|sha256_{d}|5"
        val snap_digest = sha256_text(snap)
        val admitted = cold_hir_source_inventory_admit_v1(
            "/frozen", digest, admitted_inventory(inv, digest),
            snap, snap_digest, 1, 1, 1, 1)
        expect(admitted.is_ok()).to_be(true)

describe "cold HIR inventory admission stays fail-closed (prevention)":
    it "an invalid reader result or mismatched reader digest refuses admission":
        val inv = build_inventory()
        val d = sha256_text("x")
        val snap = "pkg/m1.spl|sha256_{d}|5"
        val forged = sha256_text("forged")
        val no_proof = cold_hir_source_inventory_admit_v1(
            "/frozen", forged,
            CompileSourceInventoryReadV1(false, "inventory-generation-invalid", "", nil),
            snap, sha256_text(snap), 1, 1, 1, 1)
        expect(no_proof.is_err()).to_be(true)
        expect(no_proof.unwrap_err()).to_equal("cold-hir-inventory-mismatch")
        # A reader result whose digest differs from the expected binding is not trusted.
        val real = compile_source_inventory_digest_v1(inv)
        val wrong_proof = cold_hir_source_inventory_admit_v1(
            "/frozen", forged, admitted_inventory(inv, real),
            snap, sha256_text(snap), 1, 1, 1, 1)
        expect(wrong_proof.is_err()).to_be(true)
        expect(wrong_proof.unwrap_err()).to_equal("cold-hir-inventory-mismatch")

    it "a modified inventory cannot be substituted beside a copied expected digest":
        val inv = build_inventory()
        val real = compile_source_inventory_digest_v1(inv)
        val other = sha256_text("other")
        val empty = sha256_text("")
        val substituted = CompileSourceInventoryV1(1, 7, [
            CompileSourceInventoryEntryV1(
                "pkg/m1.spl", other, empty, empty, empty, empty, 5)])
        val substituted_entry = substituted.entries[0]
        val forged_row =
            "{substituted_entry.source_identity}|sha256_{substituted_entry.content_digest}|{substituted_entry.byte_count}"
        # This is the exact old bypass shape: valid=true, copied expected
        # digest, modified inventory, and a snapshot coherent with that
        # modified inventory. The public boundary must rebind payload->digest.
        val refused = cold_hir_source_inventory_admit_v1(
            "/frozen", real, admitted_inventory(substituted, real),
            forged_row, sha256_text(forged_row), 1, 1, 1, 1)
        expect(refused.is_err()).to_be(true)
        expect(refused.unwrap_err()).to_equal("cold-hir-inventory-mismatch")
