"""`text.rfind` / `last_index_of` return a raw i64 (-1 on a miss) in every lane, never an Option.

The directory helpers below once tested that result with `== nil` /
`.is_none()`, which is never true for an i64: a miss fell through to
`path.slice(0, -1)` and native MIR rejected `.is_none()` on the int receiver.
"""

use std.spec.{describe, it, expect}
use compiler.driver.cache.directory_tldr_snapshot_capture_v2.{_snapshot_dir_v2}
use compiler.driver.cache.aop_match_cache_driver_v1.{_dir_of as _aop_driver_dir_of}
use compiler.common.cache_contract.aspect_match_shard_v1.{_dir_of as _shard_dir_of}
use compiler.backend.linker.crt_discovery.{path_dirname}

describe "rfind-based directory helpers":
    it "snapshot capture: a path with no slash has no directory":
        expect(_snapshot_dir_v2("a.spl")).to_equal("")

    it "snapshot capture: a slash at index 3 keeps its directory":
        expect(_snapshot_dir_v2("pkg/a.spl")).to_equal("pkg")

    it "aop match driver: a path with no slash has no directory":
        expect(_aop_driver_dir_of("a.spl")).to_equal("")
        expect(_aop_driver_dir_of("pkg/a.spl")).to_equal("pkg")

    it "aspect match shard: a path with no slash has no directory":
        expect(_shard_dir_of("a.spl")).to_equal("")
        expect(_shard_dir_of("pkg/a.spl")).to_equal("pkg")

    it "crt discovery: last_index_of miss has no directory":
        expect(path_dirname("crt1.o")).to_equal("")
        expect(path_dirname("lib/crt1.o")).to_equal("lib")
