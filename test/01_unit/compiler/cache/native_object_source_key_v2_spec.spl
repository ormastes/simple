use std.spec.*
use compiler.driver.cache.native_object_source_key_v1.{native_scv_snapshot_root_v1, native_object_source_key_v1, native_scv_snapshot_rebase_v1, native_scv_snapshot_rebind_candidate_v1}

val KEY_V1 = "/owned/build/scv/snapshots/scv-revision-v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/"
val KEY_V2 = "/owned/build/scv/snapshots/scv-revision-v2-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/"
val KEY_V2_OTHER = "/owned/build/scv/snapshots/scv-revision-v2-cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc/"

describe "v2 bundle source paths retain normal revision-neutral object routing":
    it "recognizes both layouts without changing the module-relative key":
        expect(native_scv_snapshot_root_v1(KEY_V1 + "src/a.spl")).to_equal(KEY_V1)
        expect(native_scv_snapshot_root_v1(KEY_V2 + "src/a.spl")).to_equal(KEY_V2)
        expect(native_object_source_key_v1(KEY_V1 + "src/a.spl")).to_equal("scv-snapshot:src/a.spl")
        expect(native_object_source_key_v1(KEY_V2 + "src/a.spl")).to_equal("scv-snapshot:src/a.spl")
        expect(native_object_source_key_v1("/owned/src/a.spl")).to_equal("/owned/src/a.spl")

    it "keeps rebind ambiguity fail-closed and does not itself admit an object":
        val old = KEY_V1 + "src/a.spl"
        val current = KEY_V2 + "src/a.spl"
        expect(native_scv_snapshot_rebase_v1(old, KEY_V1, KEY_V2)).to_equal(current)
        expect(native_scv_snapshot_rebind_candidate_v1([old], current)).to_equal(old)
        expect(native_scv_snapshot_rebind_candidate_v1([old, KEY_V2_OTHER + "src/a.spl"], current)).to_equal("")
        expect(native_scv_snapshot_rebind_candidate_v1([old, current], current)).to_equal("")
        expect(native_scv_snapshot_root_v1(KEY_V2)).to_equal("")
