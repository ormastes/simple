use std.spec.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.common.config.{Logger}
use compiler.driver.cache.driver_cold_hir_module_capture_v1.*
use compiler.driver.cache.driver_cold_hir_emission_lease_v1.{driver_cold_hir_emit_v1}
use compiler.driver.cache.cold_hir_semantic_seed_v1.{cold_hir_typed_receipt_from_admitted_digest_v1}
use compiler.driver.smf.runtime_std_native_emit_witness_v1.{runtime_std_live_hir_semantic_digest_v1,
    runtime_std_native_emit_witness_valid_v1, runtime_std_native_emit_counts_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1,
    CompileSourceInventoryV1, compile_source_inventory_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

val CAPTURE_SOURCE = "fn value() -> i64:\n    37\n"

fn capture_module() -> HirModule:
    val parsed = parse_full_frontend(CAPTURE_SOURCE, "/frozen/pkg/mod.spl", "pkg.mod", Logger(level: 0))
    var lowering = HirLowering.with_filename("/frozen/pkg/mod.spl")
    lowering.lower_parser_module_unstub(parsed, false)

fn capture_input() -> DriverColdHirModuleInputV1:
    val empty = sha256_text("")
    val entry = CompileSourceInventoryEntryV1("pkg/mod.spl", sha256_text(CAPTURE_SOURCE),
        empty, empty, empty, empty, CAPTURE_SOURCE.len())
    val inventory = CompileSourceInventoryV1(1, 1, [entry])
    DriverColdHirModuleInputV1(module_identity: "pkg.mod", source_root: "/frozen",
        source_identity: "pkg/mod.spl", source_digest: entry.content_digest,
        source_byte_count: entry.byte_count, snapshot_inventory_digest: compile_source_inventory_digest_v1(inventory),
        inventory_entry: entry, full_inventory: false, artifact_root: "",
        target_triple: "x86_64-pc-windows-msvc", backend: "llvm")

describe "actual cold HIR module capture mechanics", tag: ["only-compiled"]:
    it "preserves real retained emission and witness bytes across its own scope":
        val module = capture_module()
        var input = capture_input()
        input.full_inventory = true
        input.artifact_root = "build/test/cold-hir-emission-lease-v1"
        expect(dir_create_all(input.artifact_root)).to_equal(true)
        val complete = driver_cold_hir_capture_module_v1(module, input)
        val retained = driver_cold_hir_emit_v1(module, input.module_identity,
            input.source_identity, input.source_digest, input.artifact_root,
            input.target_triple, input.backend)
        expect(complete.is_ok()).to_equal(true)
        expect(retained.is_ok()).to_equal(true)
        val expected = complete.unwrap().emission!
        val actual = retained.unwrap()
        expect(actual.module_identity).to_equal(expected.module_identity)
        expect(actual.artifact_identity).to_equal(expected.artifact_identity)
        expect(actual.semantic_payloads).to_equal(expected.semantic_payloads)
        expect(actual.semantic_sections).to_equal(expected.semantic_sections)
        expect(actual.native_emit_witness).to_equal(expected.native_emit_witness)
        expect(actual.export_file).to_equal(expected.export_file)
        expect(actual.initializer_file).to_equal(expected.initializer_file)
        expect(actual.provider_file).to_equal(expected.provider_file)
        expect(actual.generated_source_file).to_equal(expected.generated_source_file)
        expect(transient_array_scope_state_v1()).to_equal(0)

    it "preserves parent leases and escapes a real owner failure after artifact emission":
        val module = capture_module()
        var input = capture_input()
        input.artifact_root = "build/test/cold-hir-emission-owner-refusal-v1"
        expect(dir_create_all(input.artifact_root)).to_equal(true)
        if not transient_scope_begin(): panic("test emission scope unavailable")
        val occupied = driver_cold_hir_emit_v1(module, input.module_identity,
            input.source_identity, input.source_digest, input.artifact_root,
            input.target_triple, input.backend).is_err()
        val active = transient_array_scope_state_v1() == 1
        if not transient_scope_pause(): panic("test emission pause unavailable")
        val refused = driver_cold_hir_emit_v1(module, input.module_identity,
            input.source_identity, input.source_digest, input.artifact_root,
            input.target_triple, input.backend).is_err()
        val paused = transient_array_scope_state_v1() == 2
        if not transient_scope_end(): panic("test emission close unavailable")
        expect(occupied and active and refused and paused).to_equal(true)
        val failed = driver_cold_hir_emit_v1(module, "foreign.module",
            input.source_identity, input.source_digest, input.artifact_root,
            input.target_triple, input.backend)
        expect(failed.is_err()).to_equal(true)
        expect(failed.unwrap_err().kind).to_equal("owner")
        expect(failed.unwrap_err().reason).to_equal("cold HIR typed emission module identity changed")
        expect(transient_array_scope_state_v1()).to_equal(0)

    it "matches the actual typed ABI consumer after scope closure":
        val module = capture_module()
        val input = capture_input()
        val retained = cold_hir_typed_receipt_from_admitted_digest_v1(module, module.name,
            input.source_root, input.source_identity, input.source_digest, input.source_byte_count,
            input.snapshot_inventory_digest, input.inventory_entry)
        val captured = driver_cold_hir_capture_module_v1(module, input)
        expect(retained.is_ok()).to_equal(true)
        expect(captured.is_ok()).to_equal(true)
        expect(captured.unwrap().typed_receipt.abi_payload).to_equal(retained.unwrap().abi_payload)
        expect(captured.unwrap().typed_receipt.seed.abi_digest).to_equal(retained.unwrap().seed.abi_digest)
        expect(captured.unwrap().typed_receipt.seed.direct_imports).to_equal(retained.unwrap().seed.direct_imports)
        expect(captured.unwrap().emission == nil).to_equal(true)
        expect(transient_array_scope_state_v1()).to_equal(0)

    it "refuses a changed module owner or actual source byte count":
        val module = capture_module()
        var input = capture_input()
        input.module_identity = "foreign.mod"
        expect(driver_cold_hir_capture_module_v1(module, input).is_err()).to_equal(true)
        input = capture_input()
        input.source_byte_count = input.source_byte_count + 1
        expect(driver_cold_hir_capture_module_v1(module, input).is_err()).to_equal(true)
        expect(transient_array_scope_state_v1()).to_equal(0)

    it "consumes in an active borrowed lease and preserves occupied or paused callers":
        val module = capture_module()
        val input = capture_input()
        expect(driver_cold_hir_capture_module_in_owned_scope_v1(module, input).is_err()).to_equal(true)
        if not transient_scope_begin(): panic("test capture scope unavailable")
        val borrowed_ok = driver_cold_hir_capture_module_in_owned_scope_v1(module, input).is_ok()
        val occupied_refused = driver_cold_hir_capture_module_v1(module, input).is_err()
        val active_preserved = transient_array_scope_state_v1() == 1
        if not transient_scope_pause(): panic("test capture pause unavailable")
        val paused_refused = driver_cold_hir_capture_module_in_owned_scope_v1(module, input).is_err()
        val paused_wrapper_refused = driver_cold_hir_capture_module_v1(module, input).is_err()
        val paused_preserved = transient_array_scope_state_v1() == 2
        if not transient_scope_end(): panic("test capture close unavailable")
        expect(borrowed_ok and occupied_refused and active_preserved).to_equal(true)
        expect(paused_refused and paused_wrapper_refused and paused_preserved).to_equal(true)

    it "keeps logical HIR ownership distinct from real immutable artifact identity":
        val module = capture_module()
        var input = capture_input()
        input.full_inventory = true
        input.artifact_root = "build/test/cold-hir-module-capture-v1"
        expect(dir_create_all(input.artifact_root)).to_equal(true)
        val captured = driver_cold_hir_capture_module_v1(module, input)
        expect(captured.is_ok()).to_equal(true)
        val emission = captured.unwrap().emission!
        val witness = emission.native_emit_witness!
        val digest = runtime_std_live_hir_semantic_digest_v1(emission.semantic_payloads,
            input.source_identity, input.source_digest, input.module_identity)
        expect(emission.module_identity).to_equal(module.name)
        expect(emission.artifact_identity.len()).to_equal(64)
        expect(emission.private_root.ends_with("/" + emission.artifact_identity)).to_equal(true)
        expect(runtime_std_native_emit_witness_valid_v1(witness, input.source_identity,
            input.source_digest, input.module_identity, input.target_triple, input.backend, digest)).to_equal(true)
        val counts = runtime_std_native_emit_counts_v1(module)
        expect(counts.0 > 0).to_equal(true)
        expect(witness.active_function_count).to_equal(counts.0)
        expect(witness.active_data_count).to_equal(counts.1)
        expect(witness.active_runtime_init_count).to_equal(counts.2)
        expect(transient_array_scope_state_v1()).to_equal(0)
