# @req REQ-CSM-007 REQ-CSM-008 REQ-CSM-009 REQ-CSM-012
use std.spec.{describe, it, expect}
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.gateway.cooperative_namespace_host_prerequisite_v1.*

fn digest(char: text) -> text:
    var value = ""
    for _ in 0..64:
        value = value + char
    value

fn selected_head(revision: i64, operation: text) -> CacheCooperativeSelectedHeadV1:
    cache_cooperative_selected_head_v1(
        revision, 9, digest("a"), 128, digest("b"), operation, 4,
        digest("c"), digest("d"))

describe "cooperative namespace host prerequisite":
    it "keeps production admission closed while descriptor-bound durability is incomplete":
        step("Inspect the additive host prerequisite without minting authority")
        val inventory = cache_cooperative_namespace_host_api_inventory_v1()
        expect(inventory.cross_process_per_root_gate_api_present).to_equal(true)
        expect(inventory.opaque_writer_receipt_api_present).to_equal(true)
        expect(inventory.writer_revalidation_api_present).to_equal(true)
        expect(inventory.descriptor_bound_immutable_sync_api_present).to_equal(false)
        expect(inventory.descriptor_bound_selected_head_replace_api_present).to_equal(false)
        expect(inventory.exact_operation_recovery_api_present).to_equal(false)
        expect(inventory.complete_namespace_union_api_present).to_equal(false)
        expect(inventory.qualified_physical_scope).to_equal(false)
        expect(cache_cooperative_namespace_host_next_missing_v1(inventory)).to_equal(
            CacheCooperativeNamespaceHostPrerequisiteStateV1.ImmutableSyncUnavailable)
        expect(cache_cooperative_namespace_host_prerequisite_available_v1()).to_equal(false)

    it "reports later physical issuer dependencies without minting authority":
        step("Advance a diagnostic API inventory through the prerequisite order")
        val no_replace = CacheCooperativeNamespaceHostApiInventoryV1(
            cross_process_per_root_gate_api_present: true,
            opaque_writer_receipt_api_present: true,
            writer_revalidation_api_present: true,
            descriptor_bound_head_read_api_present: true,
            descriptor_bound_immutable_sync_api_present: true,
            descriptor_bound_journal_admission_api_present: true,
            descriptor_bound_selected_head_replace_api_present: false,
            selected_head_directory_sync_api_present: false,
            exact_operation_recovery_api_present: false,
            complete_namespace_union_api_present: false,
            qualified_physical_scope: false)
        expect(cache_cooperative_namespace_host_next_missing_v1(no_replace)).to_equal(
            CacheCooperativeNamespaceHostPrerequisiteStateV1.SelectedHeadReplaceUnavailable)
        val no_head_dir_sync = CacheCooperativeNamespaceHostApiInventoryV1(
            cross_process_per_root_gate_api_present: true,
            opaque_writer_receipt_api_present: true,
            writer_revalidation_api_present: true,
            descriptor_bound_head_read_api_present: true,
            descriptor_bound_immutable_sync_api_present: true,
            descriptor_bound_journal_admission_api_present: true,
            descriptor_bound_selected_head_replace_api_present: true,
            selected_head_directory_sync_api_present: false,
            exact_operation_recovery_api_present: false,
            complete_namespace_union_api_present: false,
            qualified_physical_scope: false)
        expect(cache_cooperative_namespace_host_next_missing_v1(no_head_dir_sync)).to_equal(
            CacheCooperativeNamespaceHostPrerequisiteStateV1.SelectedHeadDirectorySyncUnavailable)
        val no_reissue = CacheCooperativeNamespaceHostApiInventoryV1(
            cross_process_per_root_gate_api_present: true,
            opaque_writer_receipt_api_present: true,
            writer_revalidation_api_present: true,
            descriptor_bound_head_read_api_present: true,
            descriptor_bound_immutable_sync_api_present: true,
            descriptor_bound_journal_admission_api_present: true,
            descriptor_bound_selected_head_replace_api_present: true,
            selected_head_directory_sync_api_present: true,
            exact_operation_recovery_api_present: false,
            complete_namespace_union_api_present: false,
            qualified_physical_scope: false)
        expect(cache_cooperative_namespace_host_next_missing_v1(no_reissue)).to_equal(
            CacheCooperativeNamespaceHostPrerequisiteStateV1.RestartReissueUnavailable)
        val no_union = CacheCooperativeNamespaceHostApiInventoryV1(
            cross_process_per_root_gate_api_present: true,
            opaque_writer_receipt_api_present: true,
            writer_revalidation_api_present: true,
            descriptor_bound_head_read_api_present: true,
            descriptor_bound_immutable_sync_api_present: true,
            descriptor_bound_journal_admission_api_present: true,
            descriptor_bound_selected_head_replace_api_present: true,
            selected_head_directory_sync_api_present: true,
            exact_operation_recovery_api_present: true,
            complete_namespace_union_api_present: false,
            qualified_physical_scope: false)
        expect(cache_cooperative_namespace_host_next_missing_v1(no_union)).to_equal(
            CacheCooperativeNamespaceHostPrerequisiteStateV1.NamespaceUnionUnavailable)
        val no_evidence = CacheCooperativeNamespaceHostApiInventoryV1(
            cross_process_per_root_gate_api_present: true,
            opaque_writer_receipt_api_present: true,
            writer_revalidation_api_present: true,
            descriptor_bound_head_read_api_present: true,
            descriptor_bound_immutable_sync_api_present: true,
            descriptor_bound_journal_admission_api_present: true,
            descriptor_bound_selected_head_replace_api_present: true,
            selected_head_directory_sync_api_present: true,
            exact_operation_recovery_api_present: true,
            complete_namespace_union_api_present: true,
            qualified_physical_scope: false)
        expect(cache_cooperative_namespace_host_next_missing_v1(no_evidence)).to_equal(
            CacheCooperativeNamespaceHostPrerequisiteStateV1.QualifiedEvidenceUnavailable)
        expect(cache_cooperative_namespace_host_prerequisite_available_v1()).to_equal(false)

    it "round trips one checksummed selected head and rejects a changed operation":
        step("Bind selected head identity to the exact journal prefix and operation")
        val original = selected_head(3, digest("e"))
        val encoded = cache_cooperative_selected_head_encode_v1(original).unwrap()
        val decoded = cache_cooperative_selected_head_decode_v1(encoded).unwrap()
        expect(decoded.revision).to_equal(3)
        expect(decoded.accepted_journal_bytes).to_equal(128)
        expect(decoded.operation_digest).to_equal(digest("e"))
        expect(decoded.checksum).to_equal(original.checksum)
        val changed = encoded.replace(digest("e"), digest("f"))
        expect(cache_cooperative_selected_head_decode_v1(changed).is_err()).to_equal(true)

    it "matches only the selected journal prefix and ignores unselected suffix bytes":
        step("Hash the exact selected prefix rather than unselected suffix bytes")
        val prefix = "selected-prefix\n"
        val suffix = "unselected-suffix-bytes\n"
        val head = cache_cooperative_selected_head_v1(
            1, 2, digest("a"), prefix.len(), sha256_text(prefix), digest("b"),
            7, digest("c"), digest("d"))
        expect(cache_cooperative_selected_prefix_matches_journal_v1(
            head, prefix + suffix)).to_equal(true)
        expect(cache_cooperative_selected_prefix_v1(
            head, prefix + suffix).unwrap()).to_equal(prefix)
        expect(cache_cooperative_selected_prefix_matches_journal_v1(
            head, "changed-prefix\n" + suffix)).to_equal(false)
        expect(cache_cooperative_selected_head_matches_operation_and_prefix_v1(
            head, 1, digest("b"), prefix + suffix)).to_equal(true)
        expect(cache_cooperative_selected_head_matches_operation_and_prefix_v1(
            head, 1, digest("e"), prefix + suffix)).to_equal(false)

    it "rejects stale writer or selected head before any physical phase":
        step("Revalidate writer incarnation and selected-head identity under the gate")
        val expected = selected_head(5, digest("e"))
        val current = selected_head(6, digest("f"))
        expect(cache_cooperative_namespace_revalidation_v1(
            expected, current, 4, 4)).to_equal(
                CacheCooperativeNamespaceRevalidationV1.StaleHead)
        expect(cache_cooperative_namespace_revalidation_v1(
            expected, expected, 4, 5)).to_equal(
                CacheCooperativeNamespaceRevalidationV1.StaleWriter)

    it "rejects journal or head work before immutable blob and directory durability":
        step("Validate the immutable-blob then journal then head durability order")
        val invalid = CacheCooperativeDurabilityTraceV1(
            writer_revalidated: true, head_revalidated: true,
            immutable_blobs_synced: false, immutable_directories_synced: false,
            journal_admitted: true, head_replace_started: false,
            head_replace_confirmed: false, head_directory_synced: false)
        expect(cache_cooperative_durability_trace_valid_v1(invalid)).to_equal(false)
        expect(cache_cooperative_durability_outcome_v1(invalid)).to_equal(
            CacheCooperativeDurabilityOutcomeV1.InvalidOrder)

    it "reports indeterminate once selected-head replacement may have happened":
        step("Refuse to describe a possibly replaced unsynced head as rejected")
        val uncertain = CacheCooperativeDurabilityTraceV1(
            writer_revalidated: true, head_revalidated: true,
            immutable_blobs_synced: true, immutable_directories_synced: true,
            journal_admitted: true, head_replace_started: true,
            head_replace_confirmed: false, head_directory_synced: false)
        expect(cache_cooperative_durability_trace_valid_v1(uncertain)).to_equal(true)
        expect(cache_cooperative_durability_outcome_v1(uncertain)).to_equal(
            CacheCooperativeDurabilityOutcomeV1.Indeterminate)

    it "retains indeterminate when post-replacement evidence has invalid ordering":
        step("Never downgrade possible selected-head replacement to a definite rejection")
        val malformed_after_start = CacheCooperativeDurabilityTraceV1(
            writer_revalidated: false, head_revalidated: false,
            immutable_blobs_synced: false, immutable_directories_synced: false,
            journal_admitted: false, head_replace_started: true,
            head_replace_confirmed: false, head_directory_synced: false)
        expect(cache_cooperative_durability_trace_valid_v1(
            malformed_after_start)).to_equal(false)
        expect(cache_cooperative_durability_outcome_v1(
            malformed_after_start)).to_equal(
                CacheCooperativeDurabilityOutcomeV1.Indeterminate)

    it "treats replacement confirmation without a start event as indeterminate":
        step("Interpret any replacement evidence as possible authoritative mutation")
        val missing_start = CacheCooperativeDurabilityTraceV1(
            writer_revalidated: true, head_revalidated: true,
            immutable_blobs_synced: true, immutable_directories_synced: true,
            journal_admitted: true, head_replace_started: false,
            head_replace_confirmed: true, head_directory_synced: false)
        expect(cache_cooperative_durability_trace_valid_v1(missing_start)).to_equal(false)
        expect(cache_cooperative_durability_outcome_v1(missing_start)).to_equal(
            CacheCooperativeDurabilityOutcomeV1.Indeterminate)

    it "reports committed only after replacement and selected-head directory sync":
        step("Require every physical durability phase before definite success")
        val committed = CacheCooperativeDurabilityTraceV1(
            writer_revalidated: true, head_revalidated: true,
            immutable_blobs_synced: true, immutable_directories_synced: true,
            journal_admitted: true, head_replace_started: true,
            head_replace_confirmed: true, head_directory_synced: true)
        expect(cache_cooperative_durability_trace_valid_v1(committed)).to_equal(true)
        expect(cache_cooperative_durability_outcome_v1(committed)).to_equal(
            CacheCooperativeDurabilityOutcomeV1.Committed)
