#!/bin/sh
set -eu

cache=src/compiler/80.driver/cache/package_archive_cache.spl
route=src/compiler/80.driver/cache/package_index_route.spl
driver=src/compiler/80.driver/driver_source_pipeline_loading.spl
types=src/compiler/80.driver/driver_types.spl

grep -q 'cas_batch_begin_v1' "$cache"
grep -q 'cas_batch_stage_object_v1' "$cache"
grep -q 'cas_batch_publish_v1(transaction)' "$cache"
! grep -q 'action_put(' "$cache"
! grep -q 'package_archive_publish_v1' "$cache"
grep -q 'PackageArchiveAdmissionV1' "$route"
! grep -q 'interface_archive_paths' "$route"
! grep -q 'action_archive_paths' "$route"
grep -q 'pinned_archive_open_verified_v1' "$driver"
grep -q 'interface_action_archive_decode_v1' "$driver"
grep -q 'route_archive_install_stage_v1' "$driver"
grep -q 'route_archive_install_commit_v1' "$driver"
grep -q 'route_capability_scope_close_all_v1' "$driver"
grep -q 'for admission in route.archive_admissions' "$driver"
grep -q 'if package_index_routed:' "$driver"
grep -q 'self.ctx.sources = \[\]' "$driver"
archive_return_line=$(grep -n 'self.ctx.sources = \[\]' "$driver" | head -1 | cut -d: -f1)
bootstrap_line=$(grep -n 'self.parse_bootstrap_default_root("./src/compiler")' "$driver" | head -1 | cut -d: -f1)
test "$archive_return_line" -lt "$bootstrap_line"
! grep -q 'SIMPLE_PACKAGE_INDEX_INTERFACE_ARCHIVES' "$driver"
! grep -q 'SIMPLE_PACKAGE_INDEX_ACTION_ARCHIVES' "$driver"
grep -q 'archive_semantic_owner: SemanticContext' "$types"
grep -q 'archive_action_owner: CompileActionRegistry' "$types"
echo PACKAGE_ARCHIVE_CUTOVER_STATIC_PASS
