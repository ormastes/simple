use std.spec.*
use compiler.driver.cache.native_build_environment_identity.{native_build_environment_snapshot_fingerprint_v1}

describe "release native object environment identity":
    it "changes identity for actual compiler cache inputs":
        val before = native_build_environment_snapshot_fingerprint_v1([("SIMPLE_HIR_CACHE", "1"), ("SIMPLE_NATIVE_BUILD_THREADS", "2")])
        val changed = native_build_environment_snapshot_fingerprint_v1([("SIMPLE_HIR_CACHE", "1"), ("SIMPLE_NATIVE_BUILD_THREADS", "4")])
        expect(before.valid).to_equal(true)
        expect(changed.valid).to_equal(true)
        expect(before.digest == changed.digest).to_equal(false)

    it "distinguishes absent and present empty options":
        val absent = native_build_environment_snapshot_fingerprint_v1([])
        val empty = native_build_environment_snapshot_fingerprint_v1([("SIMPLE_ABI_POLICY", "")])
        expect(absent.valid).to_equal(true)
        expect(empty.valid).to_equal(true)
        expect(absent.digest == empty.digest).to_equal(false)

    it "is independent of snapshot ordering":
        val a = native_build_environment_snapshot_fingerprint_v1([("CC", "compiler with spaces"), ("SIMPLE_HIR_CACHE", "1")])
        val b = native_build_environment_snapshot_fingerprint_v1([("SIMPLE_HIR_CACHE", "1"), ("CC", "compiler with spaces")])
        expect(a.valid).to_equal(true)
        expect(b.valid).to_equal(true)
        expect(a.digest).to_equal(b.digest)

    it "refuses duplicate snapshot fields before cache use":
        val invalid = native_build_environment_snapshot_fingerprint_v1([("SIMPLE_HIR_CACHE", "1"), ("SIMPLE_HIR_CACHE", "0")])
        expect(invalid.valid).to_equal(false)
        expect(invalid.digest).to_equal("")
        expect(invalid.reason).to_contain("environment-field-duplicate")
