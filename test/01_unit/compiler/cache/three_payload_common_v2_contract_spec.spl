    physical_tld_object_digest_v1, physical_tld_object_encode_v1,
    physical_tld_object_decode_v2, physical_tld_object_decode_bounded_v2,
    physical_tld_object_digest_v2, physical_tld_object_encode_v2,
    physical_tld_header_encode_v1, physical_tld_projection_text_v1,
