# @req REQ-SSPEC-COMPILER
# Staged native codegen saved the build cache once per module and once per
# batch, and every save rebuilt + sorted the whole-program reverse-reference
# receipt: O(modules x facts log facts), days for the 3095-module full CLI.
# Intermediate saves now persist entries only; the final save publishes.
use std.spec.*
use std.nogc_sync_mut.io_runtime.{dir_remove, file_exists}
use compiler.driver.driver_build.incremental.{build_cache_open, build_cache_persist}
use compiler.driver.cache.reverse_reference_receipt.{reverse_reference_read_current_v1}

val ROOT = "/tmp/simple_build_cache_deferred_receipt_spec"

describe "build cache receipt publication":
    it "entries-only persist writes the cache but publishes no receipt":
        val _r = dir_remove(ROOT, true)
        val path = ROOT + "/build_cache.sdn"
        val cache = build_cache_open(path)
        expect(build_cache_persist(cache, false)).to_equal(true)
        expect(reverse_reference_read_current_v1(path).reason).to_equal("missing-generation")
        expect(file_exists(path)).to_equal(true)
        val _c = dir_remove(ROOT, true)
