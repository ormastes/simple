use compiler.backend.linker.smf_header.{SmfHeader}
use compiler.backend.linker.smf_enums.{Platform, Arch}
use compiler.driver.cache.cache_validator.{read_smf_source_hash, validate_smf}
use compiler.driver.cache.compile_options_hash.{compile_options_hash_zero}
use compiler.driver.cache.cache_types.{CACHE_STALE}
use std.io_runtime.{file_write_bytes, file_delete, file_read, getpid, hash_text}

describe "SMF cache validator header layout":
    it "reads source_hash from the canonical SMF header offset":
        var header = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)
        header.module_hash = 456
        header.source_hash = 123456789
        header.window_width = 321
        header.window_height = 654
        val path = "/tmp/simple_cache_validator_smf_header_{getpid()}.smf"
        expect(file_write_bytes(path, header.to_bytes())).to_equal(true)
        expect(read_smf_source_hash(path)).to_equal(123456789)
        expect(file_delete(path)).to_equal(true)

    it "fails closed for a truncated artifact through the existing path API":
        val path = "/tmp/simple_cache_validator_short_{getpid()}.smf"
        expect(file_write_bytes(path, [1, 2, 3, 4])).to_equal(true)
        expect(read_smf_source_hash(path)).to_equal(0)
        expect(file_delete(path)).to_equal(true)

    it "fails closed when a forged section count exceeds the artifact table":
        var header = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)
        header.source_hash = hash_text("x") as u64
        header.section_count = 0xFFFFFFFF
        header.section_table_offset = 0
        val suffix = "{getpid()}"
        val smf_path = "/tmp/simple_cache_validator_count_{suffix}.smf"
        val source_path = "/tmp/simple_cache_validator_count_{suffix}.spl"
        expect(file_write_bytes(smf_path, header.to_bytes())).to_equal(true)
        expect(file_write_bytes(source_path, [120])).to_equal(true)
        val result = validate_smf(source_path, smf_path, compile_options_hash_zero())
        expect(result.status).to_equal(CACHE_STALE)
        expect(result.reason).to_contain("missing or invalid dependency content receipt")
        expect(file_delete(source_path)).to_equal(true)
        expect(file_delete(smf_path)).to_equal(true)

    it "routes one validation decision through one snapshot owner":
        val source = file_read("src/compiler/80.driver/cache/cache_validator.spl")
        val begin = source.index_of("fn validate_smf_with_deps")
        val finish = source.index_of("# ============================================================================\n# Combined Freshness Check")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body.count("SmfValidationSnapshot.open(smf_path)")).to_equal(1)
        expect(body.count("file_read_bytes(smf_path)")).to_equal(0)
        expect(body.count("read_smf_reserved_bytes(smf_path)")).to_equal(0)
        expect(body.count("read_smf_source_hash(smf_path)")).to_equal(0)
        expect(body.count("read_smf_dependencies(smf_path)")).to_equal(0)
        expect(body).to_contain("smf_snapshot.release()")

        val open_begin = source.index_of("static fn open(path: text) -> SmfValidationSnapshot")
        val open_end = source.index_of("fn valid_header() -> bool")
        expect(open_begin >= 0 and open_end > open_begin).to_equal(true)
        val open_body = source.substring(open_begin, open_end)
        expect(open_body.count("file_read_bytes(path)")).to_equal(1)
