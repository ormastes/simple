    PhysicalTldHeaderV1, TldPayloadRoleV1,
    physical_tld_section_table_digest_v1
}
use compiler.common.cache_contract.three_payload_compile_v2.{
    ClosureCoverageRootV1, ThreePayloadClosureSealV2, ThreePayloadFallbackV1,
    closure_coverage_dimension_v1, three_payload_closure_seal_digest_v2
}
use compiler.driver.cache.cas.verified_cas_kind_registry_v1.{verified_cas_kind_digest_v1}
use compiler.driver.cache.gc.verified_generation_reachability_v1.*
