# @req REQ-SSPEC-COMPILER
"""
# Per-module generic instance demand projection.

Counts distinct committed consumer modules from canonical generic-spec rows.
This is a logical 3,000-consumer model, not a thread/concurrency measurement.
"""

# @tag:unit
# @tag:compiler
# @tag:cache
# @tag:generics

use std.spec.*
use compiler.driver.cache.generic_specialization_list_v1.{
    RequiredSpecializationV1, GenericSpecializationListV1
}
use compiler.driver.cache.generic_instance_build_plan_v1.{
    GenericInstanceDemandV1, generic_instance_demands_v1,
    generic_instance_build_plan_v1
}

fn spec(key: text) -> RequiredSpecializationV1:
    RequiredSpecializationV1(template_symbol: "pkg.Pair", template_id: "template:Pair",
        args_id: "args:i64,f64", arg_keys: ["i64", "f64"], concrete_key: key)

fn list(key: text) -> GenericSpecializationListV1:
    GenericSpecializationListV1(complete: true, specs: [spec(key)])

describe "generic reverse-reference demand projection":
    it "counts distinct module users and preserves exact instance keys":
        val (demands, complete) = generic_instance_demands_v1(
            ["src/a.spl", "src/b.spl", "src/a.spl"],
            [Some(list("canonical:i64,f64:host")), Some(list("canonical:i64,f64:host")),
                Some(list("canonical:i64,f64:host"))])
        expect(complete).to_equal(true)
        expect(demands.len()).to_equal(1)
        expect(demands[0].concrete_key).to_equal("canonical:i64,f64:host")
        expect(demands[0].consumers).to_equal(["src/a.spl", "src/b.spl"])
        expect(demands[0].distinct_consumer_count).to_equal(2)

    it "models 3000 logical users without calling it concurrent execution":
        var paths: [text] = []
        var lists: [GenericSpecializationListV1?] = []
        for i in 0..3000:
            paths.push("src/user-{i}.spl")
            lists.push(Some(list("canonical:Pair<i64>:host")))
        val (demands, complete) = generic_instance_demands_v1(paths, lists)
        expect(complete).to_equal(true)
        expect(demands.len()).to_equal(1)
        expect(demands[0].distinct_consumer_count).to_equal(3000)

    it "does not infer an empty demand set from an incomplete inventory":
        val (demands, complete) = generic_instance_demands_v1(
            ["src/a.spl", "src/b.spl"], [Some(list("canonical:Pair<i64>:host")), nil])
        expect(complete).to_equal(false)
        expect(demands.len()).to_equal(1)
        val plan = generic_instance_build_plan_v1(["historical:key"],
            [Some(list("canonical:Pair<i64>:host")), nil], [])
        expect(plan.complete).to_equal(false)
        expect(plan.drop.len()).to_equal(0)

    it "rejects conflicting manifests for one consumer and conflicting key metadata":
        val (same_consumer, same_consumer_complete) = generic_instance_demands_v1(
            ["src/a.spl", "src/a.spl"],
            [Some(list("canonical:Pair<i64>:host")), Some(list("canonical:Pair<f64>:host"))])
        expect(same_consumer_complete).to_equal(false)
        val conflict = RequiredSpecializationV1(template_symbol: "pkg.Other",
            template_id: "template:Other", args_id: "args:i64", arg_keys: ["i64"],
            concrete_key: "canonical:Pair<i64>:host")
        val other = GenericSpecializationListV1(complete: true, specs: [conflict])
        val (same_key, same_key_complete) = generic_instance_demands_v1(
            ["src/a.spl", "src/b.spl"], [Some(list("canonical:Pair<i64>:host")), Some(other)])
        expect(same_key_complete).to_equal(false)
        expect(same_key.len()).to_equal(1)

    it "retires demand after the last complete consumer is removed":
        val plan = generic_instance_build_plan_v1(["historical:key"], [], [])
        expect(plan.complete).to_equal(true)
        expect(plan.needed.len()).to_equal(0)
        expect(plan.drop).to_equal(["historical:key"])
