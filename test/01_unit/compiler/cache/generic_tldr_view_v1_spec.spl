# @req REQ-SSPEC-COMPILER
"""
# Concrete generic TLDR view (plan slice P3, acceptance G-01, laws T1/T5)

A generic declaration has ONE symbolic template TLDR section entry; a
reference `Pair<i64, f64>` acquires an immutable `ConcreteTldrAstViewV1`
whose fields are ordinary closed types. Repeated identical references share
one view (single-flight on the canonical `ConcreteTldrKey`); reversed
arguments and a shadowed `Box<T>` in another module get distinct keys.

Interpreter-lane evidence only: the native consumer/object path is UNRUN.
"""

# @tag:unit
# @tag:compiler
# @tag:cache
# @tag:generics

use std.spec
use compiler.common.cache_contract.hash_algorithm_registry_v1.{digest_v1_parse, digest_v1_identity_ok}
use compiler.common.cache_contract.guard_id_v1.{active_guard_root_empty_v1, active_guard_root_v1, guard_id_v1, GuardEvalV1, ActiveGuardRootV1}
use compiler.common.cache_contract.generic_tldr_view_v1.*
use compiler.frontend.cache_artifact.generic_tldr_projector.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.driver.cache.module_artifacts_v1.{module_tldr_companion_view_sections_v1}
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{semantic_query_read_manifest_valid_v1,
    semantic_query_kind_known_v1}

fn field_in(name: text, type_text: text) -> GenericFieldInputV1:
    GenericFieldInputV1(name: name, type_text: type_text)

fn decl(module_path: text, name: text, params: [text], fields: [GenericFieldInputV1]) -> GenericDeclInputV1:
    var kinds: [text] = []
    for p in params:
        kinds = kinds.push(GENERIC_PARAM_KIND_TYPE)
    GenericDeclInputV1(module_path: module_path, name: name, params: params,
        param_kinds: kinds, fields: fields, visibility_root: "vis:pub",
        active_guard_root: active_guard_root_empty_v1("").root_digest, source_digest: "src:" + module_path + "." + name)

fn pair_decl() -> GenericDeclInputV1:
    decl("pkg_a", "Pair", ["First", "Second"],
        [field_in("first", "First"), field_in("second", "Second")])

fn box_decl(module_path: text) -> GenericDeclInputV1:
    decl(module_path, "Box", ["T"], [field_in("value", "T"), field_in("count", "i64")])

fn section_of(decls: [GenericDeclInputV1]) -> GenericTemplateSectionV1:
    var entries: [GenericTemplateEntryV1] = []
    for d in decls:
        val r = project_generic_template_v1(d)
        entries = entries.push(r.unwrap())
    build_generic_template_section_v1(entries)

fn std_section() -> GenericTemplateSectionV1:
    section_of([pair_decl(), box_decl("pkg_a"), box_decl("pkg_b")])

describe "generic TLDR view: indexed section codec":
    it "round-trips the section and verifies its digest":
        val s = std_section()
        val bytes = generic_template_section_encode_v1(s)
        val d = generic_template_section_decode_v1(bytes)
        expect(d.ok).to_equal(true)
        expect(d.section.digest).to_equal(s.digest)
        expect(generic_template_section_lookup_v1(d.section, "pkg_b.Box")).to_be_greater_than(-1)

    it "rejects a corrupted section":
        val bytes = generic_template_section_encode_v1(std_section())
        val bad = bytes.replace("pkg_b", "pkg_c")
        expect(generic_template_section_decode_v1(bad).ok).to_equal(false)

    it "is alpha-invariant: renaming binders keeps the template digest (T4)":
        val a = project_generic_template_v1(pair_decl()).unwrap()
        val b = project_generic_template_v1(decl("pkg_a", "Pair", ["A", "B"],
            [field_in("first", "A"), field_in("second", "B")])).unwrap()
        expect(generic_template_id_v1(a)).to_equal(generic_template_id_v1(b))

val PAIR_SRC: text = "pub struct Pair<First, Second>:\n    first: First\n    second: Second\n\npub struct Point:\n    x: i64\n"

fn produced_section() -> GenericTemplateSectionV1:
    val parsed = parse_full_frontend(PAIR_SRC, "pkg_a.spl", "pkg_a", Logger(level: 0))
    val (sections, refusal) = module_tldr_companion_view_sections_v1(parsed, "pkg_a.spl", PAIR_SRC, "pkg_a")
    var body = ""
    for s in sections:
        if s.starts_with("generic-template|"):
            body = s.substring(17)
    generic_template_section_decode_v1(body).section

describe "generic TLDR view: produced by the module TLDR companion":
    it "emits one verified generic-template section for the generic struct only":
        val section = produced_section()
        expect(section.entries.len()).to_equal(1)
        expect(section.entries[0].symbol_id).to_equal("pkg_a.Pair")

fn guard_root(active: bool, evaluable: bool) -> ActiveGuardRootV1:
    active_guard_root_v1("profile:default", [GuardEvalV1(guard: guard_id_v1("when", "feature_x"),
        evaluable: evaluable, active: active)])

describe "generic TLDR view: active guard root (guard_id_v1)":
    it "puts the template's guard root into TemplateId":
        val a = project_generic_template_v1(pair_decl()).unwrap()
        var b = a
        b.active_guard_root = guard_root(true, true).root_digest
        expect(generic_template_id_v1(a) == generic_template_id_v1(b)).to_equal(false)

# ----------------------------------------------------------------------------
# E3 negative controls (generics formal-verification plan §1A.4 / §5.7)
# ----------------------------------------------------------------------------
#
# Seam note for (b): release/1.0.0 has no acquisition table and no injectable
# bucket-hash function — the file header's "XXH3 bucket index + full-key
# verify" is a stated contract only (tracked in
# doc/08_tracking/bug/generic_tldr_acquisition_table_missing.md). These
# controls therefore drive the real key path (`concrete_tldr_key_v1`) through
# a spec-local bucket whose hash is deliberately constant, and verify a hit by
# comparing the full canonical key exactly as the contract requires.
#
# The XXH3-is-not-identity control is NOT duplicated here; it is owned by
# test/01_unit/compiler/driver/cache_xxh3_identity_gate_spec.spl
# (`digest_admits_identity_v1(HASH_ALGO_XXH3_128_V1)` is false).

struct BucketEntryE3:
    full_key: text
    payload: text

fn constant_bucket_hash_e3(key: text) -> i64:
    0

fn bucket_lookup_e3(bucket: [BucketEntryE3], key: text) -> text:
    """Every entry shares bucket 0; only a full-key match is a hit."""
    for e in bucket:
        val ee: BucketEntryE3 = e
        if constant_bucket_hash_e3(ee.full_key) == constant_bucket_hash_e3(key) and ee.full_key == key:
            return ee.payload
    ""

fn pair_template_id_e3() -> text:
    generic_template_id_v1(project_generic_template_v1(pair_decl()).unwrap())

fn concrete_key_e3(args: [text]) -> text:
    val g = active_guard_root_empty_v1("").root_digest
    concrete_tldr_key_v1(pair_template_id_e3(),
        generic_args_id_v1([GENERIC_PARAM_KIND_TYPE, GENERIC_PARAM_KIND_TYPE], args),
        "constraints:none", "profile:default", g)

describe "generic TLDR view: E3 identity negative controls":
    # @req REQ-GENERIC-TLDR-E3-001
    it "same display name in a different declaring module gives a different TemplateId":
        step("Project Box<T> declared in pkg_a and Box<T> declared in pkg_b")
        val a = project_generic_template_v1(box_decl("pkg_a")).unwrap()
        val b = project_generic_template_v1(box_decl("pkg_b")).unwrap()
        step("Confirm both share the display name Box and differ only by module")
        expect(a.symbol_id).to_end_with(".Box")
        expect(b.symbol_id).to_end_with(".Box")
        expect(a.symbol_id == b.symbol_id).to_equal(false)
        step("Confirm the TemplateIds differ")
        expect(generic_template_id_v1(a) == generic_template_id_v1(b)).to_equal(false)

    # @req REQ-GENERIC-TLDR-E3-002
    it "two ConcreteTldrKeys colliding under a constant bucket hash stay distinct":
        step("Build ConcreteTldrKeys for Pair<i64, f64> and Pair<f64, i64>")
        val k1 = concrete_key_e3(["i64", "f64"])
        val k2 = concrete_key_e3(["f64", "i64"])
        step("Confirm the deliberately constant bucket hash collides them")
        expect(constant_bucket_hash_e3(k1)).to_equal(constant_bucket_hash_e3(k2))
        step("Confirm the full canonical keys are distinct SHA-256 identities")
        expect(k1 == k2).to_equal(false)
        expect(k1).to_start_with("sha256:")
        expect(digest_v1_identity_ok(digest_v1_parse(k1).unwrap())).to_equal(true)
        expect(digest_v1_identity_ok(digest_v1_parse(k2).unwrap())).to_equal(true)

    # @req REQ-GENERIC-TLDR-E3-003
    it "full-key verification rejects the wrong entry in a shared bucket":
        step("Place only the Pair<i64, f64> view in the shared bucket")
        val k1 = concrete_key_e3(["i64", "f64"])
        val k2 = concrete_key_e3(["f64", "i64"])
        val bucket = [BucketEntryE3(full_key: k1, payload: "view:pair_i64_f64")]
        step("Look up the colliding Pair<f64, i64> key and expect a miss")
        expect(bucket_lookup_e3(bucket, k2)).to_equal("")
        step("Look up the matching key and expect the stored view")
        expect(bucket_lookup_e3(bucket, k1)).to_equal("view:pair_i64_f64")
        step("Add the second view and confirm each key returns its own entry")
        val both = [BucketEntryE3(full_key: k1, payload: "view:pair_i64_f64"),
            BucketEntryE3(full_key: k2, payload: "view:pair_f64_i64")]
        expect(bucket_lookup_e3(both, k2)).to_equal("view:pair_f64_i64")
        expect(bucket_lookup_e3(both, k1)).to_equal("view:pair_i64_f64")
