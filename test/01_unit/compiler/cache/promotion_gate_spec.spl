# Promotion Gate Specification — Git admission for main-namespace cache mappings.
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §15
# Impl:   src/compiler/80.driver/cache/promotion/, src/compiler/80.driver/cache/remote/
#
# Proves the three cases the campaign requires:
#   - a NORMAL MERGE with a valid signed receipt is ACCEPTED
#   - a SQUASH MERGE is REJECTED
#   - a STALE origin/main is REJECTED
# plus cherry-pick, force-push-away, pre-rebase receipts, and the structural
# read-only developer rule.

use compiler.driver.cache.promotion.git_provenance.{
    GitProvenanceFacts, git_provenance_admits, git_origin_main_is_stale,
    MERGE_NORMAL_MERGE, MERGE_FAST_FORWARD, MERGE_SQUASH, MERGE_CHERRY_PICK,
    MERGE_REBASE, MERGE_FORCE_PUSHED_AWAY
}
use compiler.driver.cache.promotion.promotion_receipt.{
    PromotionReceipt, TrustedBuilder,
    promotion_receipt_from_facts, promotion_receipt_sign, promotion_receipt_verify
}
use compiler.driver.cache.promotion.promotion_gate.{
    promotion_gate_admit, promotion_attestation_full
}
use compiler.driver.cache.remote.namespace_policy.{
    CacheNamespace, NamespacePolicy,
    namespace_policy_developer_default, namespace_policy_for_attestation,
    namespace_policy_can_ever_write_main, namespace_policy_may_write,
    ROLE_TRUSTED_MAIN_CI, NS_MAIN, TRUST_TRUSTED_MAIN_CI
}

val BUILDER = "ci://simple/main-runner"
val WORKFLOW = "workflowdigest0001"
val SIGNING_KEY = "test-builder-attestation-key"
val TIP = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val COMMIT = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn builders() -> [TrustedBuilder]:
    var out: [TrustedBuilder] = []
    out.push(TrustedBuilder(builder_id: BUILDER, signing_key: SIGNING_KEY, approved_workflow_digests: [WORKFLOW]))
    out

# A fully healthy set of facts: clean, authenticated, freshly fetched, reachable.
fn good_facts(strategy: text) -> GitProvenanceFacts:
    GitProvenanceFacts(
        repository_url: "git@github.com:ormastes/simple.git",
        repository_id: "repoid0001",
        remote_authenticated: true,
        trusted_ref: "refs/remotes/origin/main",
        origin_main_tip_before_fetch: "cccccccccccccccccccccccccccccccccccccccc",
        origin_main_tip: TIP,
        fetch_performed: true,
        fetch_epoch_seconds: 1000,
        now_epoch_seconds: 1010,
        build_commit: COMMIT,
        build_tree: "treeid0001",
        worktree_clean: true,
        clean_tree_digest: "cleantree0001",
        is_ancestor_of_main_tip: true,
        merge_strategy: strategy,
        rebased_commit: "",
        builder_id: BUILDER,
        builder_is_trusted: true,
        workflow_digest: WORKFLOW,
        workflow_is_approved: true
    )

fn main_ci_policy() -> NamespacePolicy:
    namespace_policy_for_attestation(
        requested_role: ROLE_TRUSTED_MAIN_CI,
        user_name: "ci",
        attested_builder_id: BUILDER,
        attested_workflow_digest: WORKFLOW,
        workflow_is_approved: true,
        worktree_dirty: false,
        branch_namespace_enabled: false
    )

fn main_namespace() -> CacheNamespace:
    CacheNamespace(
        kind: NS_MAIN,
        repository_id: "repoid0001",
        trust: TRUST_TRUSTED_MAIN_CI,
        target_profile: "profile0001",
        schema_version: 2,
        branch_identity: "",
        workspace_id: ""
    )

fn signed_receipt(facts: GitProvenanceFacts) -> PromotionReceipt:
    val unsigned = promotion_receipt_from_facts(
        facts: facts,
        action_digest: "action0001",
        result_manifest_digest: "manifest0001",
        toolchain_digest: "toolchain0001",
        external_parameters: "",
        timestamp: 1010
    )
    promotion_receipt_sign(unsigned, SIGNING_KEY)

fn admit(facts: GitProvenanceFacts) -> bool:
    val r = promotion_gate_admit(main_ci_policy(), main_namespace(), facts, signed_receipt(facts), builders(), promotion_attestation_full())
    r.admitted

fn deny_reason(facts: GitProvenanceFacts) -> text:
    val r = promotion_gate_admit(main_ci_policy(), main_namespace(), facts, signed_receipt(facts), builders(), promotion_attestation_full())
    r.reason

describe "promotion gate — accepted cases":
    """
    As a trusted main-CI lane, I integrate a branch into main and want its
    already-built cache entries published under the main namespace without
    re-executing the work, provided the branch commit really is the commit
    main now carries and a trusted builder signed for it.
    """

    it "accepts a normal merge commit carrying a valid signed receipt":
        assert_true(admit(good_facts(MERGE_NORMAL_MERGE)))

    it "accepts a fast-forward merge carrying a valid signed receipt":
        assert_true(admit(good_facts(MERGE_FAST_FORWARD)))

    it "accepts only the rebased commit under a rebase":
        var facts = good_facts(MERGE_REBASE)
        facts.rebased_commit = COMMIT
        assert_true(admit(facts))

describe "promotion gate — rejected merge strategies":
    """
    As the operator of the shared main cache, I need integration styles that
    rewrite or drop the built commit — squash, cherry-pick, force-push, and a
    stale pre-rebase receipt — to be refused, because the artefact main would
    serve was never proven to come from the commit main actually has.
    """

    it "rejects a squash merge outright":
        val facts = good_facts(MERGE_SQUASH)
        assert_false(admit(facts))
        # Assert the SQUASH-SPECIFIC reason, not the substring "squash": the
        # allowlist fallback also denies with "unknown merge strategy: squash",
        # so a bare substring oracle passes even when the squash rule is gone.
        assert_contains(deny_reason(facts), "main must rebuild/reproduce")

    it "rejects a cherry-pick outright":
        val facts = good_facts(MERGE_CHERRY_PICK)
        assert_false(admit(facts))
        assert_contains(deny_reason(facts), "cherry-pick")

    it "rejects a force-pushed-away commit for any new promotion":
        val facts = good_facts(MERGE_FORCE_PUSHED_AWAY)
        assert_false(admit(facts))
        assert_contains(deny_reason(facts), "force-push")

    it "rejects a pre-rebase receipt whose commit is not the rebased one":
        var facts = good_facts(MERGE_REBASE)
        facts.rebased_commit = "dddddddddddddddddddddddddddddddddddddddd"
        assert_false(admit(facts))

describe "promotion gate — freshness of origin/main":
    """
    As a security reviewer, I need the reachability proof to rest on a ref this
    admission actually fetched. A local origin/main a developer could have set
    by hand is not evidence, so I expect promotion refused whenever the fetch
    did not happen or is too old — even if the ref happens to be correct.
    """

    it "rejects a stale origin/main that was never re-fetched":
        var facts = good_facts(MERGE_NORMAL_MERGE)
        facts.fetch_performed = false
        assert_true(git_origin_main_is_stale(facts))
        assert_false(admit(facts))
        assert_contains(deny_reason(facts), "stale origin/main")

    it "rejects a fetch older than the freshness window":
        var facts = good_facts(MERGE_NORMAL_MERGE)
        facts.now_epoch_seconds = 1000 + 3600
        assert_false(admit(facts))
        assert_contains(deny_reason(facts), "stale origin/main")

    it "rejects an unreachable commit even with a fresh fetch":
        var facts = good_facts(MERGE_NORMAL_MERGE)
        facts.is_ancestor_of_main_tip = false
        assert_false(admit(facts))
        assert_contains(deny_reason(facts), "not reachable")

describe "promotion gate — tree, identity and builder trust":
    """
    As a security reviewer, I need each remaining §15.1 precondition to be
    load-bearing on its own: a dirty tree, an unauthenticated remote, an
    untrusted builder, or a receipt whose signature no longer covers its
    contents must each be enough to refuse promotion by itself.
    """

    it "rejects a dirty worktree":
        var facts = good_facts(MERGE_NORMAL_MERGE)
        facts.worktree_clean = false
        assert_false(admit(facts))

    it "rejects an unauthenticated remote":
        var facts = good_facts(MERGE_NORMAL_MERGE)
        facts.remote_authenticated = false
        assert_false(admit(facts))

    it "rejects an untrusted builder":
        var facts = good_facts(MERGE_NORMAL_MERGE)
        facts.builder_is_trusted = false
        assert_false(admit(facts))

    it "rejects a tampered receipt signature":
        val facts = good_facts(MERGE_NORMAL_MERGE)
        var r = signed_receipt(facts)
        r.action_digest = "action9999"
        val v = promotion_receipt_verify(r, builders())
        assert_false(v.valid)

describe "namespace policy — read-only developer mode":
    """
    As a developer building locally, I want to read the shared main cache but
    be structurally incapable of writing it — not merely configured not to.
    Declaring myself a CI role without an attested builder must leave me a
    developer, so a misconfiguration cannot poison what everyone else trusts.
    """

    it "makes a default developer policy structurally unable to write main":
        val dev = namespace_policy_developer_default("ormastes")
        assert_false(namespace_policy_can_ever_write_main(dev))
        assert_false(namespace_policy_may_write(dev, NS_MAIN))

    it "collapses a self-declared main-CI role without attestation to a developer role":
        val fake = namespace_policy_for_attestation(
            requested_role: ROLE_TRUSTED_MAIN_CI,
            user_name: "ormastes",
            attested_builder_id: "",
            attested_workflow_digest: "",
            workflow_is_approved: true,
            worktree_dirty: false,
            branch_namespace_enabled: false
        )
        assert_false(namespace_policy_can_ever_write_main(fake))

    it "refuses promotion when the producer is a developer":
        val facts = good_facts(MERGE_NORMAL_MERGE)
        val r = promotion_gate_admit(namespace_policy_developer_default("ormastes"), main_namespace(), facts, signed_receipt(facts), builders(), promotion_attestation_full())
        assert_false(r.admitted)
