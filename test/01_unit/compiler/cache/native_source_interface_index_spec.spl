# @req REQ-SSPEC-UNIT
"""
# Native source interface index: duplicate authored paths resolve to the
# retained phase-1 identity instead of invalidating every consumer witness

The manual stage3 per-module object sweep measured the cost of the old
behavior: a duplicated authored path with differing raw bytes marked the
dependency's source fact "ambiguous-dependency-source", which invalidated
the stored native-module cache witness of a large share of closure modules
(lib.common.crypto.sha256, lib.scv.delta, lib.nogc_sync_mut.io.process_ops,
...). Together with the per-run uncacheable ABI identity (no
SIMPLE_ABI_ADMISSION_RECEIPT in the sweep env) that pinned "reused 0
modules; rebuilt N" on every per-module compile: each compile re-ran
MIR+codegen for its entire closure (~2-5 min; the 1299-module entry parsed
118/1299 files in 767s before its 600s timeout).

Rule (2026-10-16): when two admitted sources share an authored path with
differing bytes, resolve the fact to the copy whose content matches the
phase-1 retained identity (the digest projection the owner-copy loop
captured while the content was live). The witness then binds to exactly the
content the compile retained -- the security intent (reuse only when the
exact compiled inputs match) is preserved, not weakened. Only a duplicate
where NO copy matches the retained identity stays invalid, and the reason
now names the path. Resolution is content-and-interface based: it depends
only on the admitted bytes, never on which module requested the dependency.

These probes drive the same public entry point the driver uses
(native_source_interface_index_from_sources_with_digests_v1) with synthetic
SourceFile lists.
"""

# @tag: unit, compiler, cache, native, witness

use std.spec
use std.common.crypto.sha256.{sha256_text}
use compiler.common.driver_core_types.{SourceFile}
use compiler.driver.cache.native_source_interface_index.{
    native_source_interface_index_from_sources_with_digests_v1,
    native_source_interface_index_lookup_v1}

fn idx_src(path: text, authored: text, content: text) -> SourceFile:
    SourceFile(path: path, authored_path: authored, content: content, module_name: "probe.mod")

describe "native source interface index duplicate resolution":
    it "keeps unique sources valid (baseline unchanged)":
        val sources = [idx_src("src/a.spl", "src/a.spl", "fn a() -> i64:\n    1\n")]
        val fixed = [sha256_text("fn a() -> i64:\n    1\n")]
        val index = native_source_interface_index_from_sources_with_digests_v1(sources, ["src/a.spl"], fixed).unwrap()
        val fact = native_source_interface_index_lookup_v1(index, "src/a.spl")
        expect(fact.valid).to_equal(true)
        expect(fact.source_digest).to_equal(fixed[0])
        expect(fact.interface_digest).to_not_equal("")

    it "resolves a differing-bytes duplicate to the copy matching the retained identity":
        val content_a = "fn a() -> i64:\n    1\n"
        val content_b = "fn a() -> i64:\n    2\n"
        # Two admissions of the same logical file (e.g. two module-name
        # spellings from different load routes). Phase 1 retained content_b:
        # the digest projection names content_b, so the fact must describe
        # content_b -- never the requester, never first-wins-by-accident.
        val sources = [
            idx_src("src/a.spl", "src/a.spl", content_a),
            idx_src("src/a.spl", "src/a.spl", content_b)]
        val result = native_source_interface_index_from_sources_with_digests_v1(
            sources, ["src/a.spl", "src/a.spl"],
            [sha256_text(content_b), sha256_text(content_b)])
        expect(result.is_err()).to_equal(false)
        val fact = native_source_interface_index_lookup_v1(result.unwrap(), "src/a.spl")
        expect(fact.valid).to_equal(true)
        expect(fact.reason).to_equal("ok")

    it "stays fail-closed when no duplicate copy matches the retained identity":
        val content_a = "fn a() -> i64:\n    1\n"
        val content_b = "fn a() -> i64:\n    2\n"
        val retained_elsewhere = sha256_text("fn other() -> i64:\n    9\n")
        val sources = [
            idx_src("src/a.spl", "src/a.spl", content_a),
            idx_src("src/a.spl", "src/a.spl", content_b)]
        val result = native_source_interface_index_from_sources_with_digests_v1(
            sources, ["src/a.spl", "src/a.spl"],
            [retained_elsewhere, retained_elsewhere])
        expect(result.is_err()).to_equal(false)
        val fact = native_source_interface_index_lookup_v1(result.unwrap(), "src/a.spl")
        expect(fact.valid).to_equal(false)
        expect(fact.reason).to_contain("ambiguous-dependency-source:src/a.spl")

    it "keeps identical-content duplicates valid (dedup, unchanged behavior)":
        val content = "fn a() -> i64:\n    1\n"
        val sources = [
            idx_src("src/a.spl", "src/a.spl", content),
            idx_src("src/a.spl", "src/a.spl", content)]
        val result = native_source_interface_index_from_sources_with_digests_v1(
            sources, ["src/a.spl", "src/a.spl"], [sha256_text(content), sha256_text(content)])
        val fact = native_source_interface_index_lookup_v1(result.unwrap(), "src/a.spl")
        expect(fact.valid).to_equal(true)
