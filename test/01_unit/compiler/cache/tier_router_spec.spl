"""
# Tier Router Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
**Design:** doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14.2

## Overview

Tests for the process -> workspace -> machine -> remote-main tier router:
exact-key lookup, tier fallthrough with read-through backfill, and the
process-level single-flight guard.
"""

use std.spec.*
use compiler.driver.cache.cas_store.{ResultManifest, result_manifest_put}
use compiler.driver.cache.tier_router.tier_router.{
    TierRoots, tier_roots_open, tier_router_lookup, tier_router_publish_workspace,
    tier_router_process_get, tier_router_process_put,
    tier_router_begin_single_flight, tier_router_end_single_flight, tier_router_is_in_flight
}
use compiler.driver.cache.action_index.action_index.{action_index_put, ActionIndexPutOutcome}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

fn fresh_roots() -> TierRoots:
    val base = "build/tmp/tier_router_spec/{rt_getpid()}-{rt_time_now_unix_micros()}"
    val roots = TierRoots(
        workspace_index_root: "{base}/workspace/actions/workspace/ws1",
        workspace_cas_root: "{base}/workspace",
        machine_index_root: "{base}/machine/actions/machine/repo1/user1",
        machine_cas_root: "{base}/machine"
    )
    rt_dir_create_all(roots.workspace_index_root)
    rt_dir_create_all(roots.machine_index_root)
    tier_roots_open(roots)
    roots

fn sample_manifest(tag: text) -> ResultManifest:
    ResultManifest(
        action_digest: "action-digest-{tag}",
        result_kind: "interpreter_module",
        artifact_digests: ["artifact-{tag}-1", "artifact-{tag}-2"],
        output_fingerprint: "fingerprint-{tag}",
        dependency_manifest: "dep-manifest-{tag}",
        aop_group_roots: [],
        block_manifest_root: "",
        diagnostics_digest: "",
        producer_schema: 2
    )

describe "tier_router_lookup exact-key fallthrough":
    it "is a miss when nothing exists at any tier":
        val roots = fresh_roots()
        val result = tier_router_lookup(roots, "no-such-action-digest", nil)
        expect(result.found).to_equal(false)
        expect(result.tier).to_equal("miss")

    it "an entry seeded ONLY at the workspace tier (process tier untouched) is found at 'workspace'":
        # Seed workspace directly, bypassing tier_router_publish_workspace's
        # process-cache warm-up, so this genuinely exercises the L1 tier
        # rather than the L0 process cache that a publish call also fills.
        val roots = fresh_roots()
        val manifest = sample_manifest("A")
        val digest = result_manifest_put(roots.workspace_cas_root, manifest)
        action_index_put(roots.workspace_index_root, manifest.action_digest, digest)
        val result = tier_router_lookup(roots, manifest.action_digest, nil)
        expect(result.found).to_equal(true)
        expect(result.tier).to_equal("workspace")
        expect(result.result_manifest_digest).to_equal(digest)

    it "a SECOND lookup for the same key hits the process tier (backfilled by the first lookup)":
        val roots = fresh_roots()
        val manifest = sample_manifest("B")
        val digest = result_manifest_put(roots.workspace_cas_root, manifest)
        action_index_put(roots.workspace_index_root, manifest.action_digest, digest)
        val first = tier_router_lookup(roots, manifest.action_digest, nil)
        expect(first.tier).to_equal("workspace")
        val second = tier_router_lookup(roots, manifest.action_digest, nil)
        expect(second.tier).to_equal("process")
        expect(second.result_manifest_digest).to_equal(first.result_manifest_digest)

    it "an entry seeded ONLY at the machine tier is found at 'machine' and backfills workspace + process":
        val roots = fresh_roots()
        val manifest = sample_manifest("M")
        val digest = result_manifest_put(roots.machine_cas_root, manifest)
        action_index_put(roots.machine_index_root, manifest.action_digest, digest)
        val first = tier_router_lookup(roots, manifest.action_digest, nil)
        expect(first.tier).to_equal("machine")
        # Backfilled into workspace: a fresh lookup after clearing process
        # would now hit workspace, but process is warmer, so the very next
        # lookup already reflects the backfill via 'process'.
        val second = tier_router_lookup(roots, manifest.action_digest, nil)
        expect(second.tier).to_equal("process")
        expect(second.result_manifest_digest).to_equal(digest)

    it "a lookup for a DIFFERENT action_digest never matches an unrelated stored entry (exact-key only)":
        val roots = fresh_roots()
        val manifest = sample_manifest("C")
        val digest = result_manifest_put(roots.workspace_cas_root, manifest)
        action_index_put(roots.workspace_index_root, manifest.action_digest, digest)
        val result = tier_router_lookup(roots, "action-digest-C-nomatch", nil)
        expect(result.found).to_equal(false)

describe "tier_router single-flight guard":
    it "begin succeeds for a key not currently in flight":
        val ok = tier_router_begin_single_flight("single-flight-key-1")
        expect(ok).to_equal(true)
        expect(tier_router_is_in_flight("single-flight-key-1")).to_equal(true)
        tier_router_end_single_flight("single-flight-key-1")

    it "a reentrant begin for the SAME in-flight key is refused, not silently allowed":
        tier_router_begin_single_flight("single-flight-key-2")
        val reentrant = tier_router_begin_single_flight("single-flight-key-2")
        expect(reentrant).to_equal(false)
        tier_router_end_single_flight("single-flight-key-2")

    it "after end, the same key can begin again":
        tier_router_begin_single_flight("single-flight-key-3")
        tier_router_end_single_flight("single-flight-key-3")
        val again = tier_router_begin_single_flight("single-flight-key-3")
        expect(again).to_equal(true)
        tier_router_end_single_flight("single-flight-key-3")

describe "tier_router process tier":
    it "process_put then process_get round-trips":
        tier_router_process_put("process-key-1", "process-digest-1")
        val got = tier_router_process_get("process-key-1")
        val digest_or_empty = match got:
            case Some(digest):
                digest
            case nil:
                ""
        expect(digest_or_empty).to_equal("process-digest-1")

describe "tier_router publish conflict":
    it "publishing two different manifests under the same action_digest quarantines, never overwrites":
        val roots = fresh_roots()
        val m1 = sample_manifest("D")
        val outcome1 = tier_router_publish_workspace(roots, m1.action_digest, m1)
        expect(outcome1 == ActionIndexPutOutcome.Stored).to_equal(true)

        var m2 = sample_manifest("D")
        m2.output_fingerprint = "fingerprint-D-CHANGED"
        val outcome2 = tier_router_publish_workspace(roots, m1.action_digest, m2)
        expect(outcome2 == ActionIndexPutOutcome.ConflictQuarantined).to_equal(true)
