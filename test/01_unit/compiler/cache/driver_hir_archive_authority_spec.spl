use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_create_exclusive}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_end}
use compiler.driver.cache.driver_hir_archive_authority_v1.*
use compiler.driver.cache.package_module_index_builder.{PackageModuleIndexBuildAuthorityV1}
use compiler.driver.cache.package_tldr_metadata.{ConfigVariantKeyV1}
use compiler.driver.driver_build.incremental.{native_build_compiler_executable_hash}
use compiler.driver.driver_hir_cache.{hir_cache_enabled}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.common.driver_core_types.{SourceFile}

fn hir_archive_test_selection(root: text, receipt: text, digest: text, producer: text) -> DriverHirRuntimeStdArchiveSelectionV1:
    DriverHirRuntimeStdArchiveSelectionV1(root, receipt, digest,
        PackageModuleIndexBuildAuthorityV1(producer, "root-generation", "revision",
            "commit", "tree", sha256_text("inventory"),
            ConfigVariantKeyV1("x86_64-unknown-linux-gnu", "llvm", [], "debug", "abi-v1", [], [])))

describe "Driver HIR archive authority":
    it "rejects a foreign producer before a body lease and returns an owned reason":
        val source = SourceFile(path: "absent.spl", content: "", module_name: "absent")
        val selection = hir_archive_test_selection(".", "absent.receipt", sha256_text("receipt"), "")
        val result = driver_hir_archive_input_from_runtime_std_selection_v1(
            selection, source, ModuleSurfacesByName.empty(), 0, false)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("actual compiler")
        expect(transient_array_scope_state_v1()).to_equal(0)
        expect(transient_scope_begin()).to_equal(true)
        expect(transient_scope_end()).to_equal(true)
        expect(result.unwrap_err()).to_contain("actual compiler")

    it "rejects matching receipt bytes without canonical runtime/std admission":
        # This owner test requires a real initialized compiler/cache lane.
        expect(hir_cache_enabled()).to_equal(true)
        val producer = native_build_compiler_executable_hash()
        expect(producer.len()).to_equal(64)
        val root = secure_temp_dir(".", "hir-driver-authority-").unwrap()
        val path = "{root}/caller-selected.receipt"
        val content = "caller asserted runtime provider"
        expect(file_create_exclusive(path, content)).to_equal(true)
        val selection = hir_archive_test_selection(root, path, sha256_text(content), producer)
        val source = SourceFile(path: "absent.spl", content: "", module_name: "absent")
        val result = driver_hir_archive_input_from_runtime_std_selection_v1(
            selection, source, ModuleSurfacesByName.empty(), 0, false)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("runtime/std authority")
        expect(transient_array_scope_state_v1()).to_equal(0)

    it "does not acquire or end another caller's active authority lease":
        val source = SourceFile(path: "absent.spl", content: "", module_name: "absent")
        val selection = hir_archive_test_selection(".", "absent.receipt", sha256_text("receipt"), "")
        expect(transient_scope_begin()).to_equal(true)
        val refused = driver_hir_archive_input_from_runtime_std_selection_v1(
            selection, source, ModuleSurfacesByName.empty(), 0, false).is_err()
        val still_owned = transient_array_scope_state_v1() == 1
        expect(transient_scope_end()).to_equal(true)
        expect(refused).to_equal(true)
        expect(still_owned).to_equal(true)
