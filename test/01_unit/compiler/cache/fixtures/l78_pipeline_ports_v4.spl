# Test-only composition helpers for the frozen L7/L8 V4 pipeline seam.
#
# The four concrete fake owners remain defined by U01/U02.  This module only
# assembles them into the exact P10 generic ports record; it must never grow a
# raw host, filesystem, production-adapter, or live-authority dependency.

use std.spec.*
use compiler.driver.cache.gateway.cache_gateway_adapter.{
    L78PipelinePortsV4, L78PipelineObservationV4,
}
use .l78_scope_rr_ports_v4.{
    L78FakeScopePortV4, L78FakeAffectedDomainPortV4,
}
use .l78_namespace_publication_ports_v4.{
    L78FakeNamespacePortV4, L78FakePublicationPortV4,
}

pub fn l78_fake_pipeline_ports_v4(
    scope: L78FakeScopePortV4,
    affected: L78FakeAffectedDomainPortV4,
    namespace_port: L78FakeNamespacePortV4,
    publication: L78FakePublicationPortV4,
) -> L78PipelinePortsV4<L78FakeScopePortV4, L78FakeAffectedDomainPortV4, L78FakeNamespacePortV4, L78FakePublicationPortV4>:
    L78PipelinePortsV4<L78FakeScopePortV4, L78FakeAffectedDomainPortV4, L78FakeNamespacePortV4, L78FakePublicationPortV4>(
        scope: scope,
        affected: affected,
        namespace_port: namespace_port,
        publication: publication,
    )

pub fn l78_expect_pipeline_trace_v4(
    observation: L78PipelineObservationV4,
    actual: [text],
    expected: [text],
) -> ():
    expect(observation.simulated).to_equal(true)
    expect(actual).to_equal(expected)
