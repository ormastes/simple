# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

"""
## Purpose and audience

Purpose: pin the native object PRE-LOWERING cache key
(`src/compiler/80.driver/cache/native_prelower_object_key.spl`).
Audience: engineers changing the native object cache.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/cache/native_prelower_object_key_spec.spl`.
2. Every scenario must pass; a failure is a regression in the key's soundness.

## Compatibility and limitations

Pure key computation only. The driver wiring (lowering skip, object store)
is not exercised here.
"""

use std.spec.step
use std.spec.*
use compiler.driver.cache.native_prelower_object_key.{NativePrelowerKeyInputsV1,
    native_prelower_dependency_digest_v1, native_prelower_object_key_v1,
    native_prelower_mono_instance_admissible_v1}

val DEP_V1: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i64\n\nfn area(p: Point) -> i64:\n    p.x * p.y\n"
val DEP_BODY_EDIT: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i64\n\nfn area(p: Point) -> i64:\n    val w = p.x\n    w * p.y\n"
val DEP_SIGNATURE_EDIT: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i64\n\nfn area(p: Point, scale: i64) -> i64:\n    p.x * p.y * scale\n"
val DEP_FIELD_EDIT: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i32\n\nfn area(p: Point) -> i64:\n    p.x * p.y\n"
val GENERIC_V1: text = "fn first<T>(xs: [T]) -> T:\n    xs[0]\n"
val GENERIC_BODY_EDIT: text = "fn first<T>(xs: [T]) -> T:\n    val v = xs[0]\n    v\n"

val PUB_V1: text = "pub struct Length:\n    value: f64\n    unit: text\n\npub fn scale(l: Length) -> f64:\n    l.value\n"
val PUB_FIELD_RETYPE: text = "pub struct Length:\n    value: f32\n    unit: text\n\npub fn scale(l: Length) -> f64:\n    l.value\n"
val PUB_FIELD_REORDER: text = "pub struct Length:\n    unit: text\n    value: f64\n\npub fn scale(l: Length) -> f64:\n    l.value\n"
val PUB_BODY_EDIT: text = "pub struct Length:\n    value: f64\n    unit: text\n\npub fn scale(l: Length) -> f64:\n    val v = l.value\n    v\n"
val PUB_TRAIT_V1: text = "pub trait Shape:\n    fn area() -> i64:\n        1\n"
val PUB_TRAIT_BODY_EDIT: text = "pub trait Shape:\n    fn area() -> i64:\n        2\n"
val PUB_GENERIC_CLASS_V1: text = "pub class Box<T>:\n    item: T\n    fn get() -> T:\n        self.item\n"
val PUB_GENERIC_CLASS_BODY_EDIT: text = "pub class Box<T>:\n    item: T\n    fn get() -> T:\n        val v = self.item\n        v\n"
val GENERIC_IMPL_V1: text = "impl Poll<T>:\n    fn ready() -> bool:\n        true\n"
val GENERIC_IMPL_BODY_EDIT: text = "impl Poll<T>:\n    fn ready() -> bool:\n        false\n"
val NESTED_V1: text = "class Holder:\n    enum Mode:\n        A\n        B\n    static val TABLE = [\n        1,\n        2]\n    async fn run() -> i64:\n        0\n"
val NESTED_VARIANT_EDIT: text = "class Holder:\n    enum Mode:\n        A\n        C\n    static val TABLE = [\n        1,\n        2]\n    async fn run() -> i64:\n        0\n"
val NESTED_TABLE_EDIT: text = "class Holder:\n    enum Mode:\n        A\n        B\n    static val TABLE = [\n        1,\n        3]\n    async fn run() -> i64:\n        0\n"
val NESTED_ASYNC_SIG_EDIT: text = "class Holder:\n    enum Mode:\n        A\n        B\n    static val TABLE = [\n        1,\n        2]\n    async fn run(x: i64) -> i64:\n        0\n"
val NESTED_ASYNC_BODY_EDIT: text = "class Holder:\n    enum Mode:\n        A\n        B\n    static val TABLE = [\n        1,\n        2]\n    async fn run() -> i64:\n        7\n"

fn dep_key(source: text) -> text:
    key_of(inputs_with_dep(source))

fn inputs_with_dep(dep_source: text) -> NativePrelowerKeyInputsV1:
    NativePrelowerKeyInputsV1(
        module_name: "app.main",
        source_digest: "src-digest-main",
        dependency_digests: ["lib.geo={native_prelower_dependency_digest_v1(dep_source)}"],
        mono_instances: ["first$i64"],
        producer_identity: "compiler=c1|target=x86_64-pc-windows-msvc|opt=0",
        cache_lane: "default")

fn key_of(inputs: NativePrelowerKeyInputsV1) -> text:
    val (key, _reason) = native_prelower_object_key_v1(inputs)
    key

fn reason_of(inputs: NativePrelowerKeyInputsV1) -> text:
    val (_key, reason) = native_prelower_object_key_v1(inputs)
    reason

describe "Native pre-lowering object key":
    it "changes when a dependency's interface digest changes":
        # @req REQ-SSPEC-UNIT
        step("a dependency signature edit changes the consumer pre-key")
        val base = key_of(inputs_with_dep(DEP_V1))
        expect(base == "").to_be(false)
        expect(base == key_of(inputs_with_dep(DEP_SIGNATURE_EDIT))).to_be(false)
        step("a dependency struct field edit (layout) changes the consumer pre-key")
        expect(base == key_of(inputs_with_dep(DEP_FIELD_EDIT))).to_be(false)

    it "is unchanged when only a dependency's private body changes":
        # @req REQ-SSPEC-UNIT
        step("a body-only edit of a body-opaque dependency keeps the pre-key")
        expect(key_of(inputs_with_dep(DEP_V1))).to_equal(key_of(inputs_with_dep(DEP_BODY_EDIT)))
        step("a body edit of a GENERIC dependency is keyed on full source and changes it")
        expect(key_of(inputs_with_dep(GENERIC_V1)) == key_of(inputs_with_dep(GENERIC_BODY_EDIT))).to_be(false)

    it "refuses when an input is missing":
        # @req REQ-SSPEC-UNIT
        step("missing own source digest")
        var no_source = inputs_with_dep(DEP_V1)
        no_source.source_digest = ""
        expect(key_of(no_source)).to_equal("")
        expect(reason_of(no_source)).to_equal("source-digest-missing")
        step("missing dependency source yields an empty dependency digest")
        expect(key_of(inputs_with_dep(""))).to_equal("")
        step("missing producer identity")
        var no_producer = inputs_with_dep(DEP_V1)
        no_producer.producer_identity = ""
        expect(key_of(no_producer)).to_equal("")
        step("empty dependency set")
        var no_deps = inputs_with_dep(DEP_V1)
        no_deps.dependency_digests = []
        expect(key_of(no_deps)).to_equal("")
        step("non-primitive mono instance is inadmissible")
        var foreign_mono = inputs_with_dep(DEP_V1)
        foreign_mono.mono_instances = ["first$app.model.User"]
        expect(key_of(foreign_mono)).to_equal("")
        expect(native_prelower_mono_instance_admissible_v1("first$i64")).to_be(true)

describe "Native pre-lowering object key: visibility, generics and nesting":
    it "keys pub declarations exactly like bare ones":
        # @req REQ-SSPEC-UNIT
        step("a pub struct field retype changes the pre-key")
        expect(dep_key(PUB_V1) == dep_key(PUB_FIELD_RETYPE)).to_be(false)
        step("a pub struct field reorder changes the pre-key")
        expect(dep_key(PUB_V1) == dep_key(PUB_FIELD_REORDER)).to_be(false)
        step("a pub fn body-only edit keeps the pre-key")
        expect(dep_key(PUB_V1)).to_equal(dep_key(PUB_BODY_EDIT))

    it "treats pub trait, pub generic class and generic impl as body-visible":
        # @req REQ-SSPEC-UNIT
        step("pub trait default body edit changes the pre-key")
        expect(dep_key(PUB_TRAIT_V1) == dep_key(PUB_TRAIT_BODY_EDIT)).to_be(false)
        step("pub class Box<T> method body edit changes the pre-key")
        expect(dep_key(PUB_GENERIC_CLASS_V1) == dep_key(PUB_GENERIC_CLASS_BODY_EDIT)).to_be(false)
        step("impl Poll<T> method body edit changes the pre-key")
        expect(dep_key(GENERIC_IMPL_V1) == dep_key(GENERIC_IMPL_BODY_EDIT)).to_be(false)

    it "captures nested variants, class static initializers and async fn headers":
        # @req REQ-SSPEC-UNIT
        step("nested enum variant edit changes the pre-key")
        expect(dep_key(NESTED_V1) == dep_key(NESTED_VARIANT_EDIT)).to_be(false)
        step("multi-line class static val initializer edit changes the pre-key")
        expect(dep_key(NESTED_V1) == dep_key(NESTED_TABLE_EDIT)).to_be(false)
        step("async fn signature edit changes the pre-key")
        expect(dep_key(NESTED_V1) == dep_key(NESTED_ASYNC_SIG_EDIT)).to_be(false)
        step("async fn body-only edit keeps the pre-key")
        expect(dep_key(NESTED_V1)).to_equal(dep_key(NESTED_ASYNC_BODY_EDIT))
