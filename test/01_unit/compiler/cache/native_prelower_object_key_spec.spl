# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

"""
## Purpose and audience

Purpose: pin the native object PRE-LOWERING cache key
(`src/compiler/80.driver/cache/native_prelower_object_key.spl`).
Audience: engineers changing the native object cache.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/cache/native_prelower_object_key_spec.spl`.
2. Every scenario must pass; a failure is a regression in the key's soundness.

## Compatibility and limitations

Pure key computation only. The driver wiring (lowering skip, object store)
is not exercised here.
"""

use std.spec.step
use std.spec.*
use compiler.driver.cache.native_prelower_object_key.{NativePrelowerKeyInputsV1,
    native_prelower_dependency_digest_v1, native_prelower_object_key_v1,
    native_prelower_mono_instance_admissible_v1}

val DEP_V1: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i64\n\nfn area(p: Point) -> i64:\n    p.x * p.y\n"
val DEP_BODY_EDIT: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i64\n\nfn area(p: Point) -> i64:\n    val w = p.x\n    w * p.y\n"
val DEP_SIGNATURE_EDIT: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i64\n\nfn area(p: Point, scale: i64) -> i64:\n    p.x * p.y * scale\n"
val DEP_FIELD_EDIT: text = "use std.text\n\nstruct Point:\n    x: i64\n    y: i32\n\nfn area(p: Point) -> i64:\n    p.x * p.y\n"
val GENERIC_V1: text = "fn first<T>(xs: [T]) -> T:\n    xs[0]\n"
val GENERIC_BODY_EDIT: text = "fn first<T>(xs: [T]) -> T:\n    val v = xs[0]\n    v\n"

fn inputs_with_dep(dep_source: text) -> NativePrelowerKeyInputsV1:
    NativePrelowerKeyInputsV1(
        module_name: "app.main",
        source_digest: "src-digest-main",
        dependency_digests: ["lib.geo={native_prelower_dependency_digest_v1(dep_source)}"],
        mono_instances: ["first$i64"],
        producer_identity: "compiler=c1|target=x86_64-pc-windows-msvc|opt=0",
        cache_lane: "default")

fn key_of(inputs: NativePrelowerKeyInputsV1) -> text:
    val (key, _reason) = native_prelower_object_key_v1(inputs)
    key

fn reason_of(inputs: NativePrelowerKeyInputsV1) -> text:
    val (_key, reason) = native_prelower_object_key_v1(inputs)
    reason

describe "Native pre-lowering object key":
    it "changes when a dependency's interface digest changes":
        # @req REQ-SSPEC-UNIT
        step("a dependency signature edit changes the consumer pre-key")
        val base = key_of(inputs_with_dep(DEP_V1))
        expect(base == "").to_be(false)
        expect(base == key_of(inputs_with_dep(DEP_SIGNATURE_EDIT))).to_be(false)
        step("a dependency struct field edit (layout) changes the consumer pre-key")
        expect(base == key_of(inputs_with_dep(DEP_FIELD_EDIT))).to_be(false)

    it "is unchanged when only a dependency's private body changes":
        # @req REQ-SSPEC-UNIT
        step("a body-only edit of a body-opaque dependency keeps the pre-key")
        expect(key_of(inputs_with_dep(DEP_V1))).to_equal(key_of(inputs_with_dep(DEP_BODY_EDIT)))
        step("a body edit of a GENERIC dependency is keyed on full source and changes it")
        expect(key_of(inputs_with_dep(GENERIC_V1)) == key_of(inputs_with_dep(GENERIC_BODY_EDIT))).to_be(false)

    it "refuses when an input is missing":
        # @req REQ-SSPEC-UNIT
        step("missing own source digest")
        var no_source = inputs_with_dep(DEP_V1)
        no_source.source_digest = ""
        expect(key_of(no_source)).to_equal("")
        expect(reason_of(no_source)).to_equal("source-digest-missing")
        step("missing dependency source yields an empty dependency digest")
        expect(key_of(inputs_with_dep(""))).to_equal("")
        step("missing producer identity")
        var no_producer = inputs_with_dep(DEP_V1)
        no_producer.producer_identity = ""
        expect(key_of(no_producer)).to_equal("")
        step("empty dependency set")
        var no_deps = inputs_with_dep(DEP_V1)
        no_deps.dependency_digests = []
        expect(key_of(no_deps)).to_equal("")
        step("non-primitive mono instance is inadmissible")
        var foreign_mono = inputs_with_dep(DEP_V1)
        foreign_mono.mono_instances = ["first$app.model.User"]
        expect(key_of(foreign_mono)).to_equal("")
        expect(native_prelower_mono_instance_admissible_v1("first$i64")).to_be(true)
