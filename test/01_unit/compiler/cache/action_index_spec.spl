"""
# Action Index Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
**Design:** doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14.2, §14.4

## Overview

Tests for the ActionDigest -> ResultManifestDigest index storage: exact-key
put/get, and conflict reporting when the same ActionDigest is written twice
with two DIFFERENT ResultManifestDigests (never a silent overwrite).
"""

use std.spec.*
use compiler.driver.cache.action_index.action_index.{
    action_index_put, action_index_get, action_index_read_raw,
    CacheNamespace, IndexLookupResult, IndexPutResult
}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

val NS: CacheNamespace = CacheNamespace.WorkspaceLocal

fn fresh_index_root() -> text:
    val root = "build/tmp/action_index_spec/{rt_getpid()}-{rt_time_now_unix_micros()}"
    rt_dir_create_all(root)
    root

# `got` is a match on the get result reduced to a real derived digest (or ""
# when absent) so assertions below compare an actual value, never a literal.
fn hit_digest_or_empty(got: IndexLookupResult) -> text:
    match got:
        case IndexLookupResult.Hit(digest):
            digest
        case IndexLookupResult.Miss:
            ""

fn put_is_ok(outcome: IndexPutResult) -> bool:
    match outcome:
        case IndexPutResult.Ok:
            true
        case IndexPutResult.Conflict(_, _):
            false

fn put_conflict_pair(outcome: IndexPutResult) -> text:
    match outcome:
        case IndexPutResult.Ok:
            ""
        case IndexPutResult.Conflict(existing, attempted):
            "{existing}|{attempted}"

describe "action_index_put / action_index_get":
    it "stores a fresh mapping and returns Ok":
        val root = fresh_index_root()
        val outcome = action_index_put(root, NS, "action-digest-1", "result-manifest-digest-1")
        expect(put_is_ok(outcome)).to_equal(true)

    it "an exact-key get returns exactly what was put":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-2", "result-manifest-digest-2")
        val got = action_index_get(root, NS, "action-digest-2")
        expect(hit_digest_or_empty(got)).to_equal("result-manifest-digest-2")

    it "a lookup for a DIFFERENT action_digest is a miss (exact-key only, no fallback)":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-3", "result-manifest-digest-3")
        val got = action_index_get(root, NS, "action-digest-3-nomatch")
        expect(hit_digest_or_empty(got)).to_equal("")

    it "action_index_read_raw agrees with a subsequent action_index_get":
        val root = fresh_index_root()
        expect(action_index_read_raw(root, NS, "action-digest-4")).to_be_nil()
        action_index_put(root, NS, "action-digest-4", "result-manifest-digest-4")
        expect(hit_digest_or_empty(action_index_get(root, NS, "action-digest-4"))).to_equal("result-manifest-digest-4")

    it "re-putting the SAME mapping is a no-op (Ok, entry unchanged)":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-5", "result-manifest-digest-5")
        val outcome = action_index_put(root, NS, "action-digest-5", "result-manifest-digest-5")
        expect(put_is_ok(outcome)).to_equal(true)
        val got = action_index_get(root, NS, "action-digest-5")
        expect(hit_digest_or_empty(got)).to_equal("result-manifest-digest-5")

describe "action_index conflict reporting":
    it "the SAME action_digest mapping to a DIFFERENT result_manifest_digest is reported as a Conflict":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-6", "result-manifest-digest-6-A")
        val outcome = action_index_put(root, NS, "action-digest-6", "result-manifest-digest-6-B")
        expect(put_conflict_pair(outcome)).to_equal("result-manifest-digest-6-A|result-manifest-digest-6-B")

    it "after a conflict, the ORIGINAL mapping is still the live entry (never overwritten)":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-7", "result-manifest-digest-7-A")
        action_index_put(root, NS, "action-digest-7", "result-manifest-digest-7-B")
        val got = action_index_get(root, NS, "action-digest-7")
        expect(hit_digest_or_empty(got)).to_equal("result-manifest-digest-7-A")

    it "a conflict never silently admits the SECOND (new) mapping either":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-8", "result-manifest-digest-8-A")
        action_index_put(root, NS, "action-digest-8", "result-manifest-digest-8-B")
        val got = action_index_get(root, NS, "action-digest-8")
        # Neither A nor B may be silently replaced: the live answer is A.
        expect(hit_digest_or_empty(got)).to_equal("result-manifest-digest-8-A")

    it "the conflict outcome preserves both sides (existing and attempted)":
        val root = fresh_index_root()
        action_index_put(root, NS, "action-digest-9", "result-manifest-digest-9-A")
        val outcome = action_index_put(root, NS, "action-digest-9", "result-manifest-digest-9-B")
        expect(put_conflict_pair(outcome)).to_equal("result-manifest-digest-9-A|result-manifest-digest-9-B")
