"""
# Action Index Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
**Design:** doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14.2, §14.4

## Overview

Tests for the ActionDigest -> ResultManifestDigest index storage: exact-key
put/get, and conflict quarantine when the same ActionDigest is written twice
with two DIFFERENT ResultManifestDigests (never a silent overwrite).
"""

use std.spec.*
use compiler.driver.cache.action_index.action_index.{action_index_put, action_index_get, action_index_has, ActionIndexPutOutcome}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64
extern fn rt_file_exists(path: text) -> bool

fn fresh_index_root() -> text:
    val root = "build/tmp/action_index_spec/{rt_getpid()}-{rt_time_now_unix_micros()}"
    rt_dir_create_all(root)
    root

# `got` is a match on the get result reduced to a real derived digest (or ""
# when absent) so assertions below compare an actual value, never a literal.
fn got_digest_or_empty(got: text?) -> text:
    match got:
        case Some(digest):
            digest
        case nil:
            ""

describe "action_index_put / action_index_get":
    it "stores a fresh mapping and returns Stored":
        val root = fresh_index_root()
        val outcome = action_index_put(root, "action-digest-1", "result-manifest-digest-1")
        expect(outcome == ActionIndexPutOutcome.Stored).to_equal(true)

    it "an exact-key get returns exactly what was put":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-2", "result-manifest-digest-2")
        val got = action_index_get(root, "action-digest-2")
        expect(got_digest_or_empty(got)).to_equal("result-manifest-digest-2")

    it "a lookup for a DIFFERENT action_digest is a miss (exact-key only, no fallback)":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-3", "result-manifest-digest-3")
        val got = action_index_get(root, "action-digest-3-nomatch")
        expect(got_digest_or_empty(got)).to_equal("")

    it "action_index_has agrees with a subsequent action_index_get":
        val root = fresh_index_root()
        expect(action_index_has(root, "action-digest-4")).to_equal(false)
        action_index_put(root, "action-digest-4", "result-manifest-digest-4")
        expect(action_index_has(root, "action-digest-4")).to_equal(true)

    it "re-putting the SAME mapping is a no-op (AlreadyPresentSame)":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-5", "result-manifest-digest-5")
        val outcome = action_index_put(root, "action-digest-5", "result-manifest-digest-5")
        expect(outcome == ActionIndexPutOutcome.AlreadyPresentSame).to_equal(true)
        val got = action_index_get(root, "action-digest-5")
        expect(got_digest_or_empty(got)).to_equal("result-manifest-digest-5")

describe "action_index conflict quarantine":
    it "the SAME action_digest mapping to a DIFFERENT result_manifest_digest is quarantined, not overwritten":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-6", "result-manifest-digest-6-A")
        val outcome = action_index_put(root, "action-digest-6", "result-manifest-digest-6-B")
        expect(outcome == ActionIndexPutOutcome.ConflictQuarantined).to_equal(true)

    it "after a conflict, the ORIGINAL mapping is no longer readable as a live entry (quarantined, not silently kept)":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-7", "result-manifest-digest-7-A")
        action_index_put(root, "action-digest-7", "result-manifest-digest-7-B")
        val got = action_index_get(root, "action-digest-7")
        expect(got_digest_or_empty(got)).to_equal("")

    it "a conflict never silently admits the SECOND (new) mapping either":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-8", "result-manifest-digest-8-A")
        action_index_put(root, "action-digest-8", "result-manifest-digest-8-B")
        val got = action_index_get(root, "action-digest-8")
        # Neither A nor B may be silently served as the live answer.
        expect(got_digest_or_empty(got)).to_equal("")

    it "quarantine directory receives evidence of the conflict (both sides preserved)":
        val root = fresh_index_root()
        action_index_put(root, "action-digest-9", "result-manifest-digest-9-A")
        action_index_put(root, "action-digest-9", "result-manifest-digest-9-B")
        expect(rt_file_exists("{root}/quarantine")).to_equal(true)
