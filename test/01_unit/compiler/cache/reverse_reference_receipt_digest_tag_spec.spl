use std.spec
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.reverse_reference_receipt.{reverse_reference_receipt_file_v1,
    reverse_reference_pointer_matches_v1}

describe "reverse-reference receipt digests are algorithm-tagged":
    it "namespaces the immutable receipt by algorithm":
        expect(reverse_reference_receipt_file_v1("d", "sha256:ab")).to_equal("d/sha256/ab.receipt")

    it "admits only a known tagged pointer whose algorithm re-hashes the bytes":
        val content = "receipt-body"
        val hex = sha256_text(content)
        expect(reverse_reference_pointer_matches_v1("sha256:" + hex, content)).to_equal(true)
        expect(reverse_reference_pointer_matches_v1("sha256:" + hex, content + "x")).to_equal(false)
        expect(reverse_reference_pointer_matches_v1(hex, content)).to_equal(false)
        expect(reverse_reference_pointer_matches_v1("md5:" + hex, content)).to_equal(false)
