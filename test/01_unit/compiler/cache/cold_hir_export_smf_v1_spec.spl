use std.spec.*
use compiler.hir.hir_types.{HirModule, HirImport, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.driver.cache.cold_hir_semantic_seed_v1.{ColdHirSemanticSeedV1, cold_hir_semantic_seed_v1}
use compiler.driver.cache.cold_hir_export_smf_v1.{cold_hir_export_smf_v1}
use compiler.driver.cache.package_tldr_metadata.{package_export_smf_payload_validate_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1, CompileSourceInventoryV1, compile_source_inventory_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn smf_test_module() -> HirModule:
    HirModule(name: "pkg.mod", path: "/repo/pkg/mod.spl",
        imports: [HirImport("dep.mod", [], false, Span.empty())], exports: [],
        domain_blocks: [], symbols: SymbolTable.new(), functions: {},
        gpu_function_targets: {}, gpu_function_backend_orders: {}, classes: {},
        structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [], constants: {},
        static_asserts: [], aop_advices: [], di_bindings: [], arch_rules: [],
        mock_decls: [], types: [], extend_enums: [])

fn smf_test_seed(module: HirModule) -> ColdHirSemanticSeedV1:
    val content = "use dep.mod\n"
    val empty = sha256_text("")
    val inventory = CompileSourceInventoryV1(1, 1, [
        CompileSourceInventoryEntryV1("pkg/mod.spl", sha256_text(content),
            empty, empty, empty, empty, content.len())])
    cold_hir_semantic_seed_v1(module, "/repo", "pkg/mod.spl", content,
        inventory, compile_source_inventory_digest_v1(inventory)).unwrap()

describe "cold typed-HIR export SMF producer":
    it "joins actual ABI and reverse graph bytes into an admitted SMF":
        val module = smf_test_module()
        val seed = smf_test_seed(module)
        val result = cold_hir_export_smf_v1(module, seed, "pkg",
            sha256_text("variant"), ["consumer.mod"])
        expect(result.is_ok()).to_be(true)
        val produced = result.unwrap()
        expect(produced.smf.record.sections.len()).to_equal(2)
        expect(produced.smf.record.sections[0].kind).to_equal("abi_interface")
        expect(produced.smf.record.sections[0].digest).to_equal(seed.abi_digest)
        expect(produced.smf.record.sections[1].kind).to_equal("reverse_projection")
        expect(produced.smf.record.sections[1].digest).to_equal(
            produced.reverse_projection_digest)
        expect(package_export_smf_payload_validate_v1(
            produced.smf.record, produced.smf.payload)).to_equal("ok")
        val changed_graph = cold_hir_export_smf_v1(module, seed, "pkg",
            sha256_text("variant"), ["other.mod"]).unwrap()
        expect(changed_graph.reverse_projection_digest ==
            produced.reverse_projection_digest).to_be(false)

    it "rejects a stale typed ABI seed before writing metadata":
        val module = smf_test_module()
        val seed = smf_test_seed(module)
        var changed = smf_test_module()
        changed.exports = ["new_public_name"]
        val rejected = cold_hir_export_smf_v1(changed, seed, "pkg",
            sha256_text("variant"), [])
        expect(rejected.is_err()).to_be(true)
        expect(rejected.unwrap_err()).to_equal("cold-export-smf-typed-abi-mismatch")
