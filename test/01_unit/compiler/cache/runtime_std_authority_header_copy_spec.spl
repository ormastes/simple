use std.spec.*
use compiler.driver.cache.runtime_std_authority_receipt.*

fn authority_header_fixture() -> text:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val final_digest = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    [
        "simple-runtime-std-authority-receipt-v2",
        "compiler={digest}", "action_abi={digest}",
        "runtime_abi={digest}", "std_abi={digest}", "config={digest}",
        "target=x86_64-pc-windows-msvc", "snapshot_revision=scv-test",
        "runtime_action={digest}", "std_action={digest}",
        "runtime_archive={digest}", "std_archive={digest}",
        "runtime_receipt={digest}", "std_receipt={final_digest}",
        "manager_request={digest}", "enforced_memory=4096",
        "action_schema=manager-budget+source-outcomes-v2"
    ].join("\n")

describe "runtime authority v2 header copy boundaries":
    it "preserves the first and fourteenth header fields and the v2 budget":
        val content = authority_header_fixture()
        val decoded = runtime_std_authority_receipt_decode_v2(content)
        expect(decoded.is_ok()).to_equal(true)
        val receipt = decoded.unwrap()
        expect(receipt.base.compiler_digest).to_equal(
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        expect(receipt.base.std_receipt_digest).to_equal(
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
        expect(receipt.budget.enforced_process_limit_bytes).to_equal(4096)
        expect(runtime_std_authority_receipt_encode_v2(receipt)).to_equal(content)

    it "rejects short and overlong receipts before copying the header":
        val content = authority_header_fixture()
        expect(runtime_std_authority_receipt_decode_v2(
            content.substring(0, content.rfind("\n"))).is_err()).to_equal(true)
        expect(runtime_std_authority_receipt_decode_v2(
            content + "\nextra=unexpected").is_err()).to_equal(true)

    it "retains digest schema and budget validation":
        var rows = authority_header_fixture().split("\n")
        rows[13] = "std_receipt=invalid"
        expect(runtime_std_authority_receipt_decode_v2(rows.join("\n")).is_err()).to_equal(true)
        rows = authority_header_fixture().split("\n")
        rows[16] = "action_schema=unexpected"
        expect(runtime_std_authority_receipt_decode_v2(rows.join("\n")).is_err()).to_equal(true)
        rows = authority_header_fixture().split("\n")
        rows[15] = "enforced_memory=0"
        expect(runtime_std_authority_receipt_decode_v2(rows.join("\n")).is_err()).to_equal(true)
