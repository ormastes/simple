# Regression spec: reverse-reference receipt superseded file GC, linear-pass
# canonical decode validation, and O(1) indexed lookups.
# @cover src/compiler/80.driver/cache/reverse_reference_receipt.spl

use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{dir_list_or_empty, dir_remove, file_exists, getpid}
use compiler.common.cache.reverse_reference_key.{ReverseReferenceKeyV1, reverse_reference_key_encode_v1}
use compiler.driver.cache.reverse_reference_receipt.{
    REVERSE_REFERENCE_FAMILIES_V2, REVERSE_REFERENCE_RECEIPT_SCHEMA_V2,
    ReverseReferenceProjectionV1, ReverseReferenceGenerationReceiptV1,
    reverse_reference_receipt_encode_v1, reverse_reference_receipt_decode_v1,
    reverse_reference_receipt_digest_v1, reverse_reference_publish_generation_v1,
    reverse_reference_read_current_v1, reverse_reference_consumers_v1,
    reverse_reference_exact_key_v1, reverse_reference_exact_projection_v1,
    reverse_reference_receipt_contains_key_v1,
    reverse_reference_receipt_contains_projection_v1,
    reverse_reference_bind_published_keys_v1
}

fn build_v2_receipt(owner: text, subject: text, consumer: text) -> ReverseReferenceGenerationReceiptV1:
    var rows: [ReverseReferenceProjectionV1] = []
    for family in REVERSE_REFERENCE_FAMILIES_V2:
        val subj = if family == "direct-import-export": subject else: "@family-complete"
        val cons = if family == "direct-import-export": consumer else: "@family-complete"
        rows.push(ReverseReferenceProjectionV1(
            key: ReverseReferenceKeyV1(
                registry_kind: "semantic",
                owner_generation: owner,
                root_generation: "root-1",
                subject_identity: subj,
                projection_kind: family,
                projection_digest: sha256_text(owner + ":" + family + ":" + subj),
                schema_version: 1),
            consumer_identity: cons))
    ReverseReferenceGenerationReceiptV1(REVERSE_REFERENCE_RECEIPT_SCHEMA_V2, owner, "root-1", rows)

describe "Reverse-reference receipt retention GC, linear-pass decode, and O(1) index":
    it "protects fresh receipts under default min_age_s and prunes superseded sha256/*.receipt to CURRENT + newest 2 when eligible":
        val base = "/tmp/rr-receipt-gc-{getpid()}"
        dir_remove(base, true)
        val cache_path = base + "/build_cache.sdn"
        var last_digest = ""
        var i = 0
        while i < 5:
            val receipt = build_v2_receipt("owner-{i}", "mod/sub_{i}.spl", "mod/cons_{i}.spl")
            expect(reverse_reference_publish_generation_v1(cache_path, receipt)).to_equal(true)
            i = i + 1

        val sha_dir = cache_path + ".reverse-references/sha256"
        var fresh_files: [text] = []
        for name in dir_list_or_empty(sha_dir):
            if name.ends_with(".receipt"):
                fresh_files.push(name)
        expect(fresh_files.len()).to_equal(5)

        val final_receipt = build_v2_receipt("owner-5", "mod/sub_5.spl", "mod/cons_5.spl")
        expect(reverse_reference_publish_generation_v1(cache_path, final_receipt, 0)).to_equal(true)
        last_digest = reverse_reference_receipt_digest_v1(final_receipt)

        var receipt_files: [text] = []
        for name in dir_list_or_empty(sha_dir):
            if name.ends_with(".receipt"):
                receipt_files.push(name)
        expect(receipt_files.len()).to_equal(3)
        val current_hex = last_digest.substring(7, last_digest.byte_len())
        expect(file_exists(sha_dir + "/" + current_hex + ".receipt")).to_equal(true)
        dir_remove(base, true)

    it "validates canonical row order and count in a single linear pass and serves exact O(1) indexed queries":
        val base = "/tmp/rr-receipt-idx-{getpid()}"
        dir_remove(base, true)
        val cache_path = base + "/build_cache.sdn"
        val receipt = build_v2_receipt("owner-idx", "pkg/prov.spl", "pkg/user.spl")
        val encoded = reverse_reference_receipt_encode_v1(receipt)
        expect(reverse_reference_publish_generation_v1(cache_path, receipt)).to_equal(true)

        val read = reverse_reference_read_current_v1(cache_path)
        expect(read.valid).to_equal(true)
        expect(read.index_id > 0).to_equal(true)

        val consumers = reverse_reference_consumers_v1(read, "pkg/prov.spl", "direct-import-export")
        expect(consumers.exact).to_equal(true)
        expect(consumers.consumers).to_equal(["pkg/user.spl"])

        val exact_key = reverse_reference_exact_key_v1(read, "pkg/prov.spl", "pkg/user.spl", "direct-import-export")
        expect(exact_key.is_some()).to_equal(true)
        val key_frame = reverse_reference_key_encode_v1(exact_key!)
        expect(reverse_reference_receipt_contains_key_v1(read, key_frame)).to_equal(true)
        expect(reverse_reference_receipt_contains_projection_v1(read, key_frame, "pkg/user.spl")).to_equal(true)
        expect(reverse_reference_receipt_contains_projection_v1(read, key_frame, "pkg/other.spl")).to_equal(false)

        val binding = reverse_reference_exact_projection_v1(read, "pkg/prov.spl", "pkg/user.spl", "direct-import-export")
        expect(binding.is_some()).to_equal(true)
        expect(binding!.key_frame).to_equal(key_frame)

        val expected_digest = reverse_reference_receipt_digest_v1(receipt)
        expect(reverse_reference_bind_published_keys_v1(
            cache_path, expected_digest, "owner-idx", "root-1", [key_frame], ["pkg/user.spl"])).to_equal("ok")

        # Non-canonical leading-zero count ("count=015") must fail closed as noncanonical-receipt
        val noncanonical_count = encoded.replace("\ncount=15\n", "\ncount=015\n")
        val bad_count = reverse_reference_receipt_decode_v1(noncanonical_count)
        expect(bad_count.valid).to_equal(false)
        expect(bad_count.reason).to_equal("noncanonical-receipt")

        # Duplicate row must fail closed as noncanonical-order-or-duplicate
        val lines = encoded.split("\n")
        var dup_lines: [text] = [lines[0], lines[1], lines[2], lines[3], "count=16", lines[5], lines[5]]
        var li = 6
        while li < lines.len():
            dup_lines.push(lines[li])
            li = li + 1
        val bad_dup = reverse_reference_receipt_decode_v1(dup_lines.join("\n"))
        expect(bad_dup.valid).to_equal(false)
        expect(bad_dup.reason).to_equal("noncanonical-order-or-duplicate")

        dir_remove(base, true)
