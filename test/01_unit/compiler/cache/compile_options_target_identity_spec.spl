"""
Purpose: Exercise native target identity through the driver and SMF options codec.
Audience: compiler cache and generic collection/profile maintainers.
Execution status: authored; no runtime or docgen execution in this packet.
"""
# @req: REQ-GENERIC-CONFIG-TARGET-001
use std.spec
use compiler.common.driver_core_types.{CompileOptions}
use compiler.driver.driver_types.{compute_options_hash}
use compiler.driver.cache.compile_options_hash.{
    CompileOptionsHash, compile_options_hash_compute, compile_options_hash_validate,
    compile_options_hash_to_bytes, compile_options_hash_from_bytes
}
use compiler.driver.cache.cache_types.{CACHE_FRESH, CACHE_STALE}

fn target_options(target: text, backend: text = "cranelift", policy: text = "moderate", budget: i64 = -1) -> CompileOptions:
    var options = CompileOptions.default()
    options.backend = backend
    options.native_target = target
    options.collection_policy = policy
    options.collection_memory_budget_bytes = budget
    options

fn target_options_stored(options: CompileOptions) -> CompileOptionsHash:
    val current = compute_options_hash(options)
    val bytes = compile_options_hash_to_bytes(current)
    expect(bytes.len()).to_equal(16)
    compile_options_hash_from_bytes(bytes)

describe "REQ-GENERIC-CONFIG-TARGET-001: target-bound artifact options":
    it "should reject a target-only change under default collection policy":
        step("Store x86 options and request aarch64 with moderate policy and no budget")
        val stored = target_options_stored(target_options("x86_64-unknown-linux-gnu"))
        val current = compute_options_hash(target_options("aarch64-unknown-linux-gnu"))
        expect(stored.hash == current.hash).to_equal(false)
        expect(compile_options_hash_validate(stored, current).status).to_equal(CACHE_STALE)

    it "should keep identical target options fresh through the existing wire layout":
        step("Roundtrip the real options header and compare an identical request")
        val options = target_options("aarch64-unknown-linux-gnu")
        val stored = target_options_stored(options)
        val current = compute_options_hash(options)
        expect(stored.backend_kind).to_equal(current.backend_kind)
        expect(stored.flags).to_equal(current.flags)
        expect(compile_options_hash_validate(stored, current).status).to_equal(CACHE_FRESH)

    it "should preserve unspecified target defaults for legacy callers":
        step("Compare omitted optional configuration with explicit empty defaults")
        val omitted = compile_options_hash_compute("cranelift", 0, false, false, false, "default", [])
        val explicit = compile_options_hash_compute("cranelift", 0, false, false, false, "default", [], [], [], [], "moderate", -1, "")
        expect(compile_options_hash_to_bytes(omitted)).to_equal(compile_options_hash_to_bytes(explicit))
        expect(compile_options_hash_validate(omitted, explicit).status).to_equal(CACHE_FRESH)

    it "should reject a legacy target-omitting identity when target is explicit":
        step("Use the actual legacy empty-target key against an explicit target")
        val legacy = compile_options_hash_compute("cranelift", 0, false, false, false, "default", [])
        val current = compile_options_hash_compute("cranelift", 0, false, false, false, "default", [], [], [], [], "moderate", -1, "aarch64-unknown-linux-gnu")
        expect(compile_options_hash_validate(legacy, current).status).to_equal(CACHE_STALE)

    it "should keep backend changes distinct on the same target":
        step("Change only the backend of a target-bound driver request")
        val stored = target_options_stored(target_options("aarch64-unknown-linux-gnu", "cranelift"))
        val current = compute_options_hash(target_options("aarch64-unknown-linux-gnu", "llvm"))
        expect(compile_options_hash_validate(stored, current).status).to_equal(CACHE_STALE)

    it "should distinguish targets under every existing collection policy":
        step("Change only target for moderate strict robust and critical policies")
        for policy in ["moderate", "strict", "robust", "critical"]:
            val stored = target_options_stored(target_options("x86_64-unknown-linux-gnu", "cranelift", policy))
            val current = compute_options_hash(target_options("aarch64-unknown-linux-gnu", "cranelift", policy))
            expect(compile_options_hash_validate(stored, current).status).to_equal(CACHE_STALE)

    it "should retain independent policy and budget invalidation":
        step("Hold target fixed while changing policy and budget independently")
        val stored = target_options_stored(target_options("aarch64-unknown-linux-gnu"))
        val policy = compute_options_hash(target_options("aarch64-unknown-linux-gnu", "cranelift", "strict"))
        val budget = compute_options_hash(target_options("aarch64-unknown-linux-gnu", "cranelift", "moderate", 4096))
        expect(compile_options_hash_validate(stored, policy).status).to_equal(CACHE_STALE)
        expect(compile_options_hash_validate(stored, budget).status).to_equal(CACHE_STALE)

    it "should keep target text framed independently from adjacent options":
        step("Compare target text containing framing punctuation with a different target")
        val first = compile_options_hash_compute("cranelift", 0, false, false, false, "default", [], [], [], [], "moderate", -1, "a:1|b")
        val second = compile_options_hash_compute("cranelift", 0, false, false, false, "default", [], [], [], [], "moderate", -1, "a|1:b")
        expect(compile_options_hash_validate(first, second).status).to_equal(CACHE_STALE)
