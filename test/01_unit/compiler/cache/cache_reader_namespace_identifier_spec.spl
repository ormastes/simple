"""Source contract for the reader-pin namespace digest identifier."""

use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}

val HOST_AUTHORITY_SOURCE = "src/lib/common/cache_host_authority_v1.spl"
val GATEWAY_SOURCE = "src/compiler/80.driver/cache/gateway/cache_gateway_adapter.spl"

describe "cache reader namespace digest identifiers":
    it "avoids the reserved namespace identifier without changing the pin field or digest domain":
        val host_source = file_read(HOST_AUTHORITY_SOURCE)
        val gateway_source = file_read(GATEWAY_SOURCE)

        expect(host_source).to_not_contain("namespace: [u8]")
        expect(host_source).to_not_contain("namespace: text")
        expect(host_source).to_contain("namespace_digest_bytes: [u8]")
        expect(host_source).to_contain("namespace_entry_digest: text")

        expect(gateway_source).to_not_contain("val namespace =")
        expect(gateway_source).to_contain(
            "val namespace_entry_digest = sha256_text(\"simple.cache.reader.namespace.v1")
        expect(gateway_source).to_contain(
            "namespace_entry_digest: namespace_entry_digest")
