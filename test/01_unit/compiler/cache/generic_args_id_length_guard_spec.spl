# @req REQ-GENERIC-TLDR-ARGS-001
"""
# generic_args_id_v1 fails closed on kind/value length mismatch

`generic_args_id_v1(kinds, value_keys)` frames one (kind, value) pair per
positional argument. A caller that passes fewer kinds than value keys used to
index `kinds[i]` out of range; a caller that passes more kinds silently dropped
the extra kinds from the identity. Both are malformed inputs: the id must be
"" (no identity) instead of a crash or a colliding digest.
"""

# @tag:unit
# @tag:compiler
# @tag:cache
# @tag:generics

use std.spec
use compiler.common.cache_contract.generic_tldr_view_v1.*

describe "generic_args_id_v1 length guard":
    # @req REQ-GENERIC-TLDR-ARGS-001
    it "returns no identity when kinds is shorter than value_keys":
        step("Ask for an args id with one kind and two value keys")
        val id = generic_args_id_v1([GENERIC_PARAM_KIND_TYPE], ["i64", "f64"])
        expect(id).to_equal("")

    # @req REQ-GENERIC-TLDR-ARGS-001
    it "returns no identity when kinds is longer than value_keys":
        step("Ask for an args id with two kinds and one value key")
        val id = generic_args_id_v1([GENERIC_PARAM_KIND_TYPE, GENERIC_PARAM_KIND_TYPE], ["i64"])
        expect(id).to_equal("")

    # @req REQ-GENERIC-TLDR-ARGS-001
    it "still yields a tagged digest when the lengths match":
        step("Ask for an args id with two kinds and two value keys")
        val id = generic_args_id_v1([GENERIC_PARAM_KIND_TYPE, GENERIC_PARAM_KIND_TYPE], ["i64", "f64"])
        expect(id).to_start_with("sha256:")
