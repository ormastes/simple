use std.spec.*
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.driver.cache.driver_cold_hir_source_capture_plan_v1.{driver_cold_hir_source_capture_plan_v1}
use compiler.driver.cache.cold_hir_source_inventory_admission_v1.{
    cold_hir_source_inventory_admit_v1, cold_hir_source_inventory_row_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1,
    CompileSourceInventoryV1, compile_source_inventory_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

describe "cold HIR source capture ownership", tag: ["only-compiled"]:
    it "refuses an active parent without closing it or publishing receipts":
        val ctx = CompileContext.create(CompileOptions.default())
        expect(transient_scope_begin()).to_be(true)
        val refused = driver_cold_hir_source_capture_plan_v1(ctx).is_err()
        val state = transient_array_scope_state_v1()
        val ended = transient_scope_end()
        expect(refused).to_be(true)
        expect(state).to_equal(1)
        expect(ended).to_be(true)
        expect(ctx.cold_hir_typed_receipts.len()).to_equal(0)

    it "refuses a paused parent without consuming its ownership":
        val ctx = CompileContext.create(CompileOptions.default())
        expect(transient_scope_begin()).to_be(true)
        expect(transient_scope_pause()).to_be(true)
        val refused = driver_cold_hir_source_capture_plan_v1(ctx).is_err()
        val state = transient_array_scope_state_v1()
        val ended = transient_scope_end()
        expect(refused).to_be(true)
        expect(state).to_equal(2)
        expect(ended).to_be(true)

describe "cold HIR selected source rows":
    it "binds each logical alias to the actual admitted physical bytes":
        val content = "fn value() -> i64: 37\n"
        val digest = sha256_text(content)
        val empty = sha256_text("")
        val entry = CompileSourceInventoryEntryV1("pkg/mod.spl", digest,
            empty, empty, empty, empty, content.len())
        val inventory = CompileSourceInventoryV1(1, 7, [entry])
        val snapshot = "pkg/mod.spl|sha256_{digest}|{content.len()}"
        val admitted = cold_hir_source_inventory_admit_v1("/frozen",
            compile_source_inventory_digest_v1(inventory), inventory,
            snapshot, sha256_text(snapshot), 2, 2, 2, 2)
        expect(admitted.is_ok()).to_be(true)
        val owner = admitted.unwrap()
        val first = cold_hir_source_inventory_row_v1(owner, inventory, 0,
            "/frozen/pkg/mod.spl", digest, content.len(), "pkg.mod")
        val alias = cold_hir_source_inventory_row_v1(owner, inventory, 1,
            "/frozen/pkg/mod.spl", digest, content.len(), "compat.mod")
        expect(first.is_ok()).to_be(true)
        expect(alias.is_ok()).to_be(true)
        expect(first.unwrap().source_identity).to_equal(alias.unwrap().source_identity)
        expect(alias.unwrap().module_identity).to_equal("compat.mod")
        expect(alias.unwrap().inventory_entry.content_digest).to_equal(digest)
        # Deduplication must never skip validation of a later alias's bytes.
        expect(cold_hir_source_inventory_row_v1(owner, inventory, 1,
            "/frozen/pkg/mod.spl", sha256_text("changed"), content.len(), "compat.mod").is_err()).to_be(true)

    it "rejects a coherent snapshot digest whose row contradicts the pinned generation":
        val empty = sha256_text("")
        val entry = CompileSourceInventoryEntryV1("pkg/mod.spl", sha256_text("actual"),
            empty, empty, empty, empty, 6)
        val inventory = CompileSourceInventoryV1(1, 7, [entry])
        val other_digest = sha256_text("other")
        val forged = "pkg/mod.spl|sha256_{other_digest}|5"
        val refused = cold_hir_source_inventory_admit_v1("/frozen",
            compile_source_inventory_digest_v1(inventory), inventory,
            forged, sha256_text(forged), 1, 1, 1, 1)
        expect(refused.is_err()).to_be(true)
        expect(refused.unwrap_err()).to_equal("cold-hir-snapshot-source-content-mismatch")
