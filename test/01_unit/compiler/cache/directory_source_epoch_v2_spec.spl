use std.spec.*
use compiler.common.cache_contract.directory_source_epoch_v2.{DirectorySourceEpochV2,
    directory_source_epoch_advance_v2, directory_source_epoch_equal_v2}

describe "directory source lineage correlation":
    it "advances only the actual owner's generation":
        val first = directory_source_epoch_advance_v2(7, 0).unwrap()
        val next = directory_source_epoch_advance_v2(7, first.generation).unwrap()
        expect(first.generation).to_equal(1)
        expect(next.generation).to_equal(2)
        expect(directory_source_epoch_equal_v2(first, first)).to_equal(true)
        expect(directory_source_epoch_equal_v2(first, next)).to_equal(false)
        expect(directory_source_epoch_equal_v2(first,
            DirectorySourceEpochV2(driver_identity: 8, generation: 1))).to_equal(false)

    it "refuses missing owners and exhaustion without wrapping":
        expect(directory_source_epoch_advance_v2(0, 0).is_err()).to_equal(true)
        expect(directory_source_epoch_advance_v2(7, -1).is_err()).to_equal(true)
        expect(directory_source_epoch_advance_v2(7, 9223372036854775807).is_err()).to_equal(true)
        expect(directory_source_epoch_equal_v2(
            DirectorySourceEpochV2(driver_identity: 0, generation: 1),
            DirectorySourceEpochV2(driver_identity: 0, generation: 1))).to_equal(false)
