"""Cache decoders reject invalid UTF-8 text as a corrupt entry (never U+FFFD)."""

use std.spec.*
use compiler.common.cache_contract.canonical_cache_codec_v1.{canonical_cache_encode_envelope_v1, canonical_cache_kind_semantic_read_set_v1, canonical_semantic_read_set_payload_v1, canonical_semantic_read_set_decode_v1}
use compiler.common.cache_contract.semantic_read_set_v1.{SemanticReadSetV1}

describe "SemanticReadSetV1 corrupt cache text":
    it "rejects invalid UTF-8 text bytes as malformed":
        var payload = canonical_semantic_read_set_payload_v1(SemanticReadSetV1(entries: [], uncacheable_reason: "ab"))
        payload[payload.len() - 1] = 0xFF
        val corrupt = canonical_cache_encode_envelope_v1(canonical_cache_kind_semantic_read_set_v1(), 1, payload)
        val decoded = canonical_semantic_read_set_decode_v1(corrupt)
        expect(decoded.ok).to_equal(false)
        expect(decoded.error).to_equal("malformed_semantic_read_set")
