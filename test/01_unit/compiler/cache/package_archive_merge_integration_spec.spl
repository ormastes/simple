use std.spec.*
use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "package archive merge-owner integration":
    it "pins decodes installs and closes without environment path handoff":
        step("pins decodes installs and closes without environment path handoff")
        val source = rt_file_read_text(
            "src/compiler/80.driver/driver_source_pipeline_loading.spl") ?? ""
        expect(source).to_contain("pinned_archive_open_verified_v1")
        expect(source).to_contain("interface_action_archive_decode_v1")
        expect(source).to_contain("route_archive_install_stage_v1")
        expect(source).to_contain("route_archive_install_commit_v1")
        expect(source).to_contain("pinned_archive_close_v1")
        expect(source).to_contain("for admission in route.archive_admissions")
        expect(source).to_not_contain("SIMPLE_PACKAGE_INDEX_INTERFACE_ARCHIVES")
        expect(source).to_not_contain("SIMPLE_PACKAGE_INDEX_ACTION_ARCHIVES")

    it "publishes dirty SCC mappings with one generation transaction":
        step("publishes dirty SCC mappings with one generation transaction")
        val source = rt_file_read_text(
            "src/compiler/80.driver/cache/package_archive_cache.spl") ?? ""
        expect(source).to_contain("cas_batch_begin_v1")
        expect(source).to_contain("cas_batch_stage_object_v1")
        expect(source).to_contain("cas_batch_publish_v1(transaction)")
        expect(source).to_not_contain("action_put(")
        expect(source).to_not_contain("package_archive_publish_v1")

    it "routes clean packages as typed archive admissions and no sources":
        step("routes clean packages as typed archive admissions and no sources")
        val source = rt_file_read_text(
            "src/compiler/80.driver/cache/package_index_route.spl") ?? ""
        expect(source).to_contain("PackageArchiveAdmissionV1")
        expect(source).to_contain("archive_admissions")
        expect(source).to_not_contain("interface_archive_paths")
        expect(source).to_not_contain("action_archive_paths")
