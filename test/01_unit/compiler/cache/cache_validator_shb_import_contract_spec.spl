use std.io.{file_read}

describe "cache validator SHB import boundary":
    it "binds ShbReader at module scope":
        val source = file_read("src/compiler/80.driver/cache/cache_validator.spl")

        expect(source).to_contain("use compiler.shb.shb_reader.{ShbReader}")
        expect(source).to_contain("val reader = ShbReader.open(shb_path)")
        expect(source.contains("    use compiler.shb.shb_reader.{ShbReader}")).to_equal(false)
