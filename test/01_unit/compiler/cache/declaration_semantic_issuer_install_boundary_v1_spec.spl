# codex-system-test
# Closed prerequisite for declaration-derived semantic issuer installation.
# @req REQ-CSM-003 REQ-CSM-006 REQ-CSM-008 REQ-CSM-017

use std.spec.*
use std.io_runtime.{read_file_text}
use compiler.common.cache_contract.three_payload_compile_v2.{ThreePayloadFallbackV1}
use compiler.driver.cache.gateway.declaration_semantic_issuer_install_boundary_v1.{
    declaration_semantic_issuer_install_available_v1,
    declaration_semantic_issuer_install_owner_v1,
}

fn boundary_source_v1() -> text:
    read_file_text(
        "src/compiler/80.driver/cache/gateway/declaration_semantic_issuer_install_boundary_v1.spl")

describe "declaration semantic issuer install boundary V1":
    it "stays unavailable until the canonical gate and five live owners install":
        step("Keep the production installation boundary closed")
        expect(declaration_semantic_issuer_install_available_v1()).to_equal(false)
        expect(declaration_semantic_issuer_install_owner_v1().unwrap_err()).to_equal(
            ThreePayloadFallbackV1.AuthorityUnavailable)

    it "keeps owner and issued handle construction private":
        step("Reject public constructors, DTO registration, and digest admission")
        val source = boundary_source_v1()
        expect(source.contains("struct DeclarationSemanticIssuerInstallHandleV1:")).to_equal(true)
        expect(source.contains("pub struct DeclarationSemanticIssuerInstallHandleV1:")).to_equal(false)
        expect(source.contains("class DeclarationSemanticIssuerInstallOwnerV1:")).to_equal(true)
        expect(source.contains("pub class DeclarationSemanticIssuerInstallOwnerV1:")).to_equal(false)
        expect(source.contains("pub fn create(")).to_equal(false)
        expect(source.contains("register_candidate")).to_equal(false)
        expect(source.contains("install_from_digest")).to_equal(false)

    it "defers canonical consumption until five real capability owners exist":
        step("Audit the closed stream boundary without count or boolean authority")
        val source = boundary_source_v1()
        expect(source.contains("semantic_canonical_begin_v1")).to_equal(true)
        expect(source.contains("semantic_canonical_write_owner_revision_set_v1")).to_equal(true)
        expect(source.contains("semantic_canonical_finish_v1")).to_equal(true)
        expect(source.contains("installed_live_owner_count")).to_equal(false)
        expect(source.contains("semantic_stream_gate_admitted: bool")).to_equal(false)
        expect(source.contains("SemanticOwnerRevisionSetV1")).to_equal(false)
        expect(source.contains("canonical_digest: text")).to_equal(false)
