use std.spec.*
use compiler.common.cache_contract.errors_v1.{SummaryErrorCodeV1}
use compiler.common.cache_contract.virtual_source_store_v1.{SummaryAuthV1, VirtualSourceStoreV1, UnavailableVirtualSourceStoreV1}
use compiler.common.cache_contract.virtual_source_consumer_v1.{compiler_cli_virtual_source_v1}

fn unavailable_auth() -> SummaryAuthV1:
    SummaryAuthV1(root_digest: "root", session_digest: "session",
        capability_digest: "capability", capability_admission_receipt: "admission",
        request_epoch: 10, expires_epoch: 20)

describe "unavailable virtual source store null object":
    it "gives the trait a real implementation whose four slots each fail closed with their own operation name":
        val store: VirtualSourceStoreV1 = UnavailableVirtualSourceStoreV1.new()
        val consumer = compiler_cli_virtual_source_v1(store, unavailable_auth(), "snap")
        val uri = "simple-summary://snap/pkg/a.spl/_tldr.spl"

        match consumer.list("pkg", 8, nil):
            case Err(error):
                expect(error.code).to_equal(SummaryErrorCodeV1.SummaryAccessDenied)
                expect(error.reject.bounded_detail).to_equal("list")
            case Ok(_):
                expect("list returned Ok").to_equal("list must fail closed")

        match consumer.stat(uri):
            case Err(error):
                expect(error.code).to_equal(SummaryErrorCodeV1.SummaryAccessDenied)
                expect(error.reject.bounded_detail).to_equal("stat")
            case Ok(_):
                expect("stat returned Ok").to_equal("stat must fail closed")

        match consumer.read(uri, 0, 64):
            case Err(error):
                expect(error.code).to_equal(SummaryErrorCodeV1.SummaryAccessDenied)
                expect(error.reject.bounded_detail).to_equal("read")
            case Ok(_):
                expect("read returned Ok").to_equal("read must fail closed")

        match consumer.page(uri, nil, 4096, 32):
            case Err(error):
                expect(error.code).to_equal(SummaryErrorCodeV1.SummaryAccessDenied)
                expect(error.reject.bounded_detail).to_equal("page")
            case Ok(_):
                expect("page returned Ok").to_equal("page must fail closed")
