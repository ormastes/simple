# Cache quota, watermark hysteresis, admission, and the access journal
#
# """As a developer building near a full cache, I need the cache to clean up in
# one decisive pass instead of thrashing on every write, and I need a cache that
# cannot accept my write to quietly get out of the way rather than break my
# build."""
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §18.2, §18.6, §18.7
#
# **Category:** Infrastructure

use std.spec.*
use compiler.driver.cache.metadata.gc_config.{GcLimits, gc_limits_default, gc_limits_validate, gc_high_watermark_bytes, gc_low_watermark_bytes, gc_hard_limit_bytes, gc_min_free_required, gc_should_start, gc_should_stop, gc_bytes_to_free, gc_admit, gc_diagnostic_gate_new, GC_ADMIT_ACCEPT, GC_ADMIT_GC_THEN_ACCEPT, GC_ADMIT_REJECT}
use compiler.driver.cache.gc.gc_admission.{gc_admission_outcome, gc_admission_summary}
use compiler.driver.cache.metadata.cache_metadata.{cache_metadata_new, cache_metadata_table_new, cache_metadata_table_put, cache_metadata_table_get, metadata_journal_new, metadata_journal_record, metadata_journal_pending, metadata_journal_should_flush, metadata_journal_flush, metadata_journal_cleared, GC_CLASS_OLD_MACHINE_LOCAL}

fn no_pressure_limits() -> GcLimits:
    gc_limits_default(1000)


describe "watermarks and hysteresis":
    """GC starts at the high watermark and only stops once it has come back down
    to the low one, so a cache sitting near its maximum cleans up once instead of
    thrashing on every write."""
    it "places the stop threshold strictly below the start threshold":
        val l = no_pressure_limits()
        expect(gc_high_watermark_bytes(l)).to_equal(900)
        expect(gc_low_watermark_bytes(l)).to_equal(750)
        expect(gc_hard_limit_bytes(l)).to_equal(1050)
        assert_true(gc_low_watermark_bytes(l) < gc_high_watermark_bytes(l))

    it "does not re-trigger GC between the low and high watermark (no thrash)":
        val l = no_pressure_limits()
        assert_false(gc_should_start(l, 800))
        assert_false(gc_should_stop(l, 800))
        assert_true(gc_should_start(l, 900))
        assert_true(gc_should_stop(l, 750))

    it "targets the low watermark, not the high one, when freeing":
        val l = no_pressure_limits()
        expect(gc_bytes_to_free(l, 950)).to_equal(200)
        expect(gc_bytes_to_free(l, 700)).to_equal(0)

    it "rejects a configuration without hysteresis":
        val bad = GcLimits(max_bytes: 1000, high_watermark_permille: 900,
                           low_watermark_permille: 900, hard_limit_permille: 1050,
                           min_free_bytes: 0, min_free_permille: 50)
        assert_true(gc_limits_validate(bad).len() > 0)
        expect(gc_limits_validate(no_pressure_limits()).len()).to_equal(0)

    it "takes the larger of the absolute and the ratio free-space reserve":
        val l = GcLimits(max_bytes: 1000, high_watermark_permille: 900,
                         low_watermark_permille: 750, hard_limit_permille: 1050,
                         min_free_bytes: 100, min_free_permille: 50)
        expect(gc_min_free_required(l, 1000)).to_equal(100)     # absolute wins
        expect(gc_min_free_required(l, 100000)).to_equal(5000)  # ratio wins

describe "admission under storage pressure":
    """A cache that cannot take the write says so and gets out of the way: the
    build continues uncached, with one diagnostic per window and no effect on
    its exit status or its output."""
    it "accepts below the high watermark, schedules GC above it, rejects above the hard limit":
        val l = no_pressure_limits()
        expect(gc_admit(l, 100, 10, 10000000000, 100000000000)).to_equal(GC_ADMIT_ACCEPT)
        expect(gc_admit(l, 895, 10, 10000000000, 100000000000)).to_equal(GC_ADMIT_GC_THEN_ACCEPT)
        expect(gc_admit(l, 1045, 10, 10000000000, 100000000000)).to_equal(GC_ADMIT_REJECT)

    it "rejects when the filesystem free reserve would be breached even below max":
        val l = GcLimits(max_bytes: 1000000, high_watermark_permille: 900,
                         low_watermark_permille: 750, hard_limit_permille: 1050,
                         min_free_bytes: 5000, min_free_permille: 0)
        expect(gc_admit(l, 10, 1000, 5500, 100000)).to_equal(GC_ADMIT_REJECT)

    it "degrades a rejected write to a miss and never affects the build":
        val l = no_pressure_limits()
        val gate = gc_diagnostic_gate_new(60)
        val out = gc_admission_outcome(l, gate, 1045, 10, 10000000000, 100000000000, 100)
        expect(out.code).to_equal(GC_ADMIT_REJECT)
        assert_false(out.cache_the_write)
        assert_true(out.diagnostic.len() > 0)
        # The outcome carries no build-failure channel at all: the only signals
        # are "do not cache" plus one diagnostic string.
        assert_contains(gc_admission_summary(out), "build_affected=false")

    it "emits the storage-pressure diagnostic at most once per window":
        val l = no_pressure_limits()
        val gate = gc_diagnostic_gate_new(60)
        val first = gc_admission_outcome(l, gate, 1045, 10, 10000000000, 100000000000, 100)
        val second = gc_admission_outcome(l, first.gate, 1045, 10, 10000000000, 100000000000, 110)
        assert_true(first.diagnostic.len() > 0)
        expect(second.diagnostic).to_equal("")
        expect(second.gate.suppressed_count).to_equal(1)
        val later = gc_admission_outcome(l, second.gate, 1045, 10, 10000000000, 100000000000, 200)
        assert_true(later.diagnostic.len() > 0)

describe "access metadata is journaled, never written synchronously on a hit":
    """A cache hit stays a read: the access is appended to an in-memory journal
    and folded into the eviction metadata in batches."""
    it "records a hit into the journal without touching the metadata table":
        var table = cache_metadata_table_new()
        table = cache_metadata_table_put(table, cache_metadata_new("d1", 10, GC_CLASS_OLD_MACHINE_LOCAL, 100))
        var journal = metadata_journal_new(4)
        journal = metadata_journal_record(journal, "d1", 500)
        journal = metadata_journal_record(journal, "d1", 600)
        expect(metadata_journal_pending(journal)).to_equal(2)
        val before = cache_metadata_table_get(table, "d1")
        if val b = before:
            expect(b.access_count).to_equal(0)
            expect(b.last_access_time).to_equal(100)
        else:
            assert_true(false)

    it "folds the batch into the table only on flush":
        var table = cache_metadata_table_new()
        table = cache_metadata_table_put(table, cache_metadata_new("d1", 10, GC_CLASS_OLD_MACHINE_LOCAL, 100))
        var journal = metadata_journal_new(2)
        journal = metadata_journal_record(journal, "d1", 500)
        journal = metadata_journal_record(journal, "d1", 600)
        assert_true(metadata_journal_should_flush(journal))
        table = metadata_journal_flush(journal, table)
        journal = metadata_journal_cleared(journal)
        expect(metadata_journal_pending(journal)).to_equal(0)
        val after = cache_metadata_table_get(table, "d1")
        if val a = after:
            expect(a.access_count).to_equal(2)
            expect(a.last_access_time).to_equal(600)
        else:
            assert_true(false)
