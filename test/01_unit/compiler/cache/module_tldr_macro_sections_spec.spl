# Purpose: P5 macro sections ride in the module TLDR companion (plan 2026-10-24 §6.1).
# @req M-02

use std.spec.*
use compiler.frontend.parser.macro_registry.{MacroDef}
use compiler.frontend.cache_artifact.macro_reference_projector.{MacroSourceDefV1,
    MacroSourceInvocationV1, MacroModuleSourceV1, project_macro_module_v1}
use compiler.common.cache_contract.macro_reference_manifest_v1.{
    macro_definition_table_decode_v1, macro_use_table_decode_v1}
use compiler.driver.cache.module_tldr_sections_v1.{module_tldr_sections_render_v1,
    module_tldr_sections_parse_v1}
use compiler.driver.cache.module_artifacts_v1.{module_tldr_macro_sections_v1}

describe "module TLDR macro sections":
    it "render and parse back to the sealed def/use tables":
        val d = MacroSourceDefV1(def: MacroDef(name: "double", params: ["x"], contract_intros: [],
            contract_injects: []), namespace: "macro", body_text: "x + x", nested_macro_names: [],
            declared_effects: [], guard_ids: [], is_public: true)
        val i = MacroSourceInvocationV1(region_id: "r1", stable_invocation_id: "inv:r1",
            requested_name: "double", invocation_text: "double(1)", args_text: "1",
            hygiene_scope_id: "h", active_guard_id: "", active: true)
        val p = project_macro_module_v1(MacroModuleSourceV1(package: "pkg", module: "a",
            source_id: "a.spl", defs: [d], invocations: [i]), [])
        val sections = module_tldr_macro_sections_v1(p.def_table, p.use_table)
        expect(sections.len()).to_equal(2)
        val (parsed, consumed) = module_tldr_sections_parse_v1(module_tldr_sections_render_v1(sections))
        expect(consumed > 0).to_equal(true)
        expect(parsed.len()).to_equal(2)
        expect(macro_definition_table_decode_v1(parsed[0].substring(10)).ok).to_equal(true)
        expect(macro_use_table_decode_v1(parsed[1].substring(10)).ok).to_equal(true)
