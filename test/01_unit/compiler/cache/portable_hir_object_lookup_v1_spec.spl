use std.spec.*
use compiler.common.cache_contract.portable_object_ref_v1.{PortableObjectRefV1,
    PortableObjectStageV1, PortablePortabilityV1, portable_object_ref_key_v1}
use compiler.hir.portable_object_profile_v1.{PortableHirObjectV1,
    portable_hir_object_lookup_key_v1, portable_hir_semantic_verifier_available_v1,
    portable_body_semantic_completeness_available_v1}

fn reference(semantics: text, receipt: text) -> PortableObjectRefV1:
    PortableObjectRefV1(content_digest: "content", stage: PortableObjectStageV1.Base,
        portability: PortablePortabilityV1.Portable, ir_schema: 2,
        required_semantics_digest: semantics, target_contract_digest: nil,
        verification_receipt_digest: receipt)

fn object(value: PortableObjectRefV1) -> PortableHirObjectV1:
    PortableHirObjectV1(encoded_hir: "body", verifier_digest: "verifier",
        reference: value)

describe "Portable HIR three-payload object lookup":
    it "binds symbolic body lookup to the complete immutable reference":
        val first = reference("semantics-a", "receipt-a")
        val changed_semantics = reference("semantics-b", "receipt-a")
        val changed_receipt = reference("semantics-a", "receipt-b")
        expect(portable_hir_object_lookup_key_v1(object(first))).to_equal(
            portable_object_ref_key_v1(first))
        expect(portable_object_ref_key_v1(first) ==
            portable_object_ref_key_v1(changed_semantics)).to_be(false)
        expect(portable_object_ref_key_v1(first) ==
            portable_object_ref_key_v1(changed_receipt)).to_be(false)

    it "length-frames symbolic identity parts without delimiter aliasing":
        val left = reference("a:b", "c")
        val right = reference("a", "b:c")
        expect(portable_object_ref_key_v1(left) ==
            portable_object_ref_key_v1(right)).to_be(false)

    it "does not turn lookup identity into verifier or completeness authority":
        expect(portable_hir_semantic_verifier_available_v1()).to_be(false)
        expect(portable_body_semantic_completeness_available_v1()).to_be(false)
