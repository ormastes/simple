"""Canonical semantic-cache contract codec golden and rejection vectors."""

use std.spec.*
use std.fs.{read_file}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.common.cache_contract.canonical_cache_codec_v1.{canonical_cache_encode_envelope_v1, canonical_cache_decode_envelope_v1, canonical_cache_object_digest_v1, canonical_cache_encode_sorted_text_map_v1, canonical_public_summary_encode_v1, canonical_public_summary_decode_v1, canonical_public_summary_declaration_graph_digest_v1, canonical_cache_encode_text_v1, canonical_semantic_read_set_encode_v1, canonical_semantic_read_set_decode_v1, canonical_compile_snapshot_payload_v1, verified_object_dependencies_v1}
use compiler.common.cache_contract.public_summary_v1.{PublicSummaryEntryV1, PublicSummaryV1}
use compiler.common.cache_contract.snapshot_contract_v1.{LogicalSourcePathV1, PathSemanticsV1, SnapshotSourceEntryV1, ResolutionCandidateV1, ResolutionWitnessV1, NamedDigestV1, CompileSnapshotV1, CacheObjectRefV1, CacheObjectDependencyV1, CacheVerifiedObjectViewV1, CacheDependencyRoleV1, logical_source_path_valid_v1}
use compiler.common.cache_contract.semantic_read_set_v1.{SemanticEffectKindV1, SemanticReplayPolicyV1, SemanticReadEntryV1, SemanticReadSetV1}

fn _summary_v1() -> PublicSummaryV1:
    val path = LogicalSourcePathV1(
        repository_namespace_digest: "1111111111111111111111111111111111111111111111111111111111111111",
        module_relative_utf8: "pkg/main.spl", path_semantics: PathSemanticsV1.CaseSensitiveNfc)
    val forwards = [PublicSummaryEntryV1(stable_symbol_id: "sym.main", canonical_bytes: "pub extern fn main() -> i64", dependency_symbol_ids: [])]
    val declarations = [PublicSummaryEntryV1(stable_symbol_id: "sym.main", canonical_bytes: "pub extern fn main() -> i64", dependency_symbol_ids: [])]
    val none: [PublicSummaryEntryV1] = []
    var summary = PublicSummaryV1(
        snapshot_id: "2222222222222222222222222222222222222222222222222222222222222222",
        logical_path: path,
        source_blob_digest: "3333333333333333333333333333333333333333333333333333333333333333",
        schema: 1,
        compiler_owner_digest: "4444444444444444444444444444444444444444444444444444444444444444",
        grammar_digest: "5555555555555555555555555555555555555555555555555555555555555555",
        forward_declarations: forwards, declarations: declarations,
        layouts_abi: none, traits_impls_coherence: none, extensions_reexports: none,
        aop_selectors: none, macro_signatures: none, body_refs: none,
        reverse_reference_roots: none,
        declaration_graph_digest: "",
        virtual_text_digest: "7777777777777777777777777777777777777777777777777777777777777777")
    summary.declaration_graph_digest = canonical_public_summary_declaration_graph_digest_v1(summary)
    summary

fn _digest(ch: text) -> text: ch.repeat(64)

fn _logical(name: text) -> LogicalSourcePathV1:
    LogicalSourcePathV1(repository_namespace_digest: _digest("1"),
        module_relative_utf8: name, path_semantics: PathSemanticsV1.CaseSensitiveNfc)

fn _snapshot_v1(reverse: bool, physical: text) -> CompileSnapshotV1:
    val first = SnapshotSourceEntryV1(logical_path: _logical("pkg/a.spl"), source_blob_digest: _digest("a"))
    val second = SnapshotSourceEntryV1(logical_path: _logical("pkg/b.spl"), source_blob_digest: _digest("b"))
    val candidate = ResolutionCandidateV1(order: 0, logical_path: "pkg/a.spl", normalization_key: "pkg/a.spl",
        physical_identity_digest: physical, parent_directory_generation_digest: _digest("2"),
        entry_kind: "file", exists: true, selected: true, content_digest: _digest("a"),
        symlink_chain_digest: _digest("3"))
    val witness = ResolutionWitnessV1(resolver_policy_digest: _digest("4"), root_trust_digest: _digest("5"),
        candidates: [candidate], selected_index: 0, generated_input_digests: [], witness_digest: _digest("6"))
    CompileSnapshotV1(schema: 1, repository_namespace_digest: _digest("1"), path_policy_digest: _digest("7"),
        source_entries: if reverse then [second, first] else [first, second], resolution_witnesses: [witness],
        negative_candidates: [], directory_generations: [], generated_inputs: [], configuration_digest: _digest("8"),
        target_layout_digest: _digest("9"), compiler_owner_digest: _digest("a"), runtime_digest: _digest("b"),
        provider_manifests: if reverse then [NamedDigestV1(name: "z", digest: _digest("c")), NamedDigestV1(name: "a", digest: _digest("d"))]
            else [NamedDigestV1(name: "a", digest: _digest("d")), NamedDigestV1(name: "z", digest: _digest("c"))],
        toolchain_component_digests: [])

describe "Canonical cache envelope V1":
    it "roundtrips one golden payload and produces a stable object digest":
        val encoded = canonical_cache_encode_envelope_v1(3, 1, [1.to_u8(), 2.to_u8(), 3.to_u8()])
        val decoded = canonical_cache_decode_envelope_v1(encoded)
        expect(decoded.ok).to_equal(true)
        expect(encoded.len()).to_equal(59)
        expect(canonical_cache_object_digest_v1(encoded).len()).to_equal(64)

    it "rejects reserved flags, corruption, truncation, and trailing bytes":
        val good = canonical_cache_encode_envelope_v1(3, 1, [9.to_u8()])
        var reserved = good.copy()
        reserved[12] = 1.to_u8()
        expect(canonical_cache_decode_envelope_v1(reserved).error).to_equal("reserved_flags_nonzero")
        var corrupt = good.copy()
        corrupt[55] = 8.to_u8()
        expect(canonical_cache_decode_envelope_v1(corrupt).error).to_equal("payload_digest_mismatch")
        expect(canonical_cache_decode_envelope_v1(good[0..55]).error).to_equal("truncated_envelope")
        var trailing = good.copy()
        trailing.push(0.to_u8())
        expect(canonical_cache_decode_envelope_v1(trailing).error).to_equal("trailing_bytes")

    it "sorts map keys independently of input permutation and rejects duplicates":
        val first = canonical_cache_encode_sorted_text_map_v1(["b", "a"], ["2", "1"])
        val second = canonical_cache_encode_sorted_text_map_v1(["a", "b"], ["1", "2"])
        expect(first).to_equal(second)
        expect(canonical_cache_encode_sorted_text_map_v1(["a", "a"], ["1", "1"]).len()).to_equal(0)

    it "returns a typed success for empty text instead of ambiguous zero bytes":
        val encoded = canonical_cache_encode_text_v1("")
        expect(encoded.ok).to_equal(true)
        expect(encoded.bytes.len()).to_equal(8)
        expect(encoded.bytes).to_equal([0.to_u8(), 0.to_u8(), 0.to_u8(), 0.to_u8(), 0.to_u8(), 0.to_u8(), 0.to_u8(), 0.to_u8()])

    it "preserves bytes returned through every nested accumulator":
        val text_value = canonical_cache_encode_text_v1("A")
        expect(text_value.bytes.len()).to_equal(9)
        expect(text_value.bytes[8]).to_equal(65.to_u8())
        val envelope = canonical_cache_encode_envelope_v1(3, 1, text_value.bytes)
        expect(envelope[0..8]).to_equal([83.to_u8(), 77.to_u8(), 80.to_u8(), 76.to_u8(), 67.to_u8(), 65.to_u8(), 86.to_u8(), 49.to_u8()])
        expect(canonical_cache_decode_envelope_v1(envelope).ok).to_equal(true)

    it "copies a bounded dependency page in the requested order":
        val first = CacheObjectDependencyV1(name: "first",
            role: CacheDependencyRoleV1.ExternalWitness, target_kind: "", schema: 0,
            digest: _digest("1"))
        val second = CacheObjectDependencyV1(name: "second",
            role: CacheDependencyRoleV1.ExternalWitness, target_kind: "", schema: 0,
            digest: _digest("2"))
        val view = CacheVerifiedObjectViewV1(
            identity: CacheObjectRefV1(kind: "source_blob", schema: 1,
                object_digest: _digest("3")),
            semantic_digest: _digest("4"), dependencies: [first, second],
            complete_object_dependencies: true)
        val page = verified_object_dependencies_v1(view, 1, 1)
        expect(page.ok).to_equal(true)
        expect(page.dependencies).to_equal([second])
        expect(page.next_cursor).to_equal(2)

describe "LogicalSourcePathV1 portability":
    it "uses slash-only semantic paths independent of Windows physical spelling":
        val namespace_digest = "1111111111111111111111111111111111111111111111111111111111111111"
        expect(logical_source_path_valid_v1(LogicalSourcePathV1(
            repository_namespace_digest: namespace_digest, module_relative_utf8: "src/compiler/main.spl",
            path_semantics: PathSemanticsV1.CaseFoldedNfc))).to_equal(true)
        expect(logical_source_path_valid_v1(LogicalSourcePathV1(
            repository_namespace_digest: namespace_digest, module_relative_utf8: "C:\\src\\compiler\\main.spl",
            path_semantics: PathSemanticsV1.CaseFoldedNfc))).to_equal(false)

describe "CompileSnapshotV1 canonical identity":
    it "is independent of collection permutations and physical worktree witnesses":
        val first = canonical_compile_snapshot_payload_v1(_snapshot_v1(false, _digest("e")))
        val permuted = canonical_compile_snapshot_payload_v1(_snapshot_v1(true, _digest("e")))
        val other_worktree = canonical_compile_snapshot_payload_v1(_snapshot_v1(false, _digest("f")))
        expect(first.len() > 0).to_equal(true)
        expect(first).to_equal(permuted)
        expect(first).to_equal(other_worktree)

describe "PublicSummaryV1 canonical codec":
    it "roundtrips the distinct forward-declaration phase":
        val encoded = canonical_public_summary_encode_v1(_summary_v1())
        val decoded = canonical_public_summary_decode_v1(encoded)
        expect(decoded.ok).to_equal(true)
        val summary = match decoded.value:
            case value: value
            case nil: _summary_v1()
        expect(summary.forward_declarations.len()).to_equal(1)
        expect(summary.forward_declarations[0].stable_symbol_id).to_equal("sym.main")
        expect(summary.declarations[0].canonical_bytes).to_equal("pub extern fn main() -> i64")

    it "binds forward ordering and the declaration graph into the digest":
        val base = canonical_public_summary_encode_v1(_summary_v1())
        var changed = _summary_v1()
        changed.forward_declarations = [
            PublicSummaryEntryV1(stable_symbol_id: "sym.z", canonical_bytes: "pub extern fn z()", dependency_symbol_ids: []),
            PublicSummaryEntryV1(stable_symbol_id: "sym.main", canonical_bytes: "pub extern fn main() -> i64", dependency_symbol_ids: [])]
        changed.declaration_graph_digest = canonical_public_summary_declaration_graph_digest_v1(changed)
        expect(canonical_cache_object_digest_v1(base) == canonical_cache_object_digest_v1(canonical_public_summary_encode_v1(changed))).to_equal(false)

    it "sorts a copy without changing the caller's forward-declaration order":
        var summary = _summary_v1()
        summary.forward_declarations = [
            PublicSummaryEntryV1(stable_symbol_id: "sym.z", canonical_bytes: "pub extern fn z()", dependency_symbol_ids: []),
            PublicSummaryEntryV1(stable_symbol_id: "sym.main", canonical_bytes: "pub extern fn main() -> i64", dependency_symbol_ids: [])]
        summary.declaration_graph_digest = canonical_public_summary_declaration_graph_digest_v1(summary)
        val encoded = canonical_public_summary_encode_v1(summary)
        expect(encoded.len() > 0).to_equal(true)
        expect(summary.forward_declarations[0].stable_symbol_id).to_equal("sym.z")
        expect(canonical_public_summary_decode_v1(encoded).ok).to_equal(true)

    it "rejects a stale declaration graph digest":
        var changed = _summary_v1()
        changed.declaration_graph_digest = "8888888888888888888888888888888888888888888888888888888888888888"
        expect(canonical_public_summary_encode_v1(changed).len()).to_equal(0)

describe "SemanticReadSetV1 canonical codec":
    it "roundtrips one declared provider-bound effect":
        val entry = SemanticReadEntryV1(effect_kind: SemanticEffectKindV1.Plugin,
            logical_name: "backend", provider_id: "llvm",
            provider_manifest_digest: "1111111111111111111111111111111111111111111111111111111111111111",
            value_digest: "2222222222222222222222222222222222222222222222222222222222222222",
            replay_policy: SemanticReplayPolicyV1.DeclaredReplayable)
        val encoded = canonical_semantic_read_set_encode_v1(SemanticReadSetV1(entries: [entry], uncacheable_reason: ""))
        expect(canonical_semantic_read_set_decode_v1(encoded).ok).to_equal(true)

    it "sorts a copy while preserving the caller's entry order":
        val plugin = SemanticReadEntryV1(effect_kind: SemanticEffectKindV1.Plugin,
            logical_name: "backend", provider_id: "llvm",
            provider_manifest_digest: _digest("1"), value_digest: _digest("2"),
            replay_policy: SemanticReplayPolicyV1.DeclaredReplayable)
        val source = SemanticReadEntryV1(effect_kind: SemanticEffectKindV1.Source,
            logical_name: "pkg/main.spl", provider_id: "source-root",
            provider_manifest_digest: _digest("3"), value_digest: _digest("4"),
            replay_policy: SemanticReplayPolicyV1.DeclaredReplayable)
        var entries = [plugin, source]
        val encoded = canonical_semantic_read_set_encode_v1(
            SemanticReadSetV1(entries: entries, uncacheable_reason: ""))
        expect(encoded.len() > 0).to_equal(true)
        expect(entries[0].logical_name).to_equal("backend")
        expect(canonical_semantic_read_set_decode_v1(encoded).ok).to_equal(true)

    it "rejects the same effect identity with divergent manifest or value":
        val first = SemanticReadEntryV1(effect_kind: SemanticEffectKindV1.Plugin,
            logical_name: "backend", provider_id: "llvm",
            provider_manifest_digest: "1111111111111111111111111111111111111111111111111111111111111111",
            value_digest: "2222222222222222222222222222222222222222222222222222222222222222",
            replay_policy: SemanticReplayPolicyV1.DeclaredReplayable)
        var second = first
        second.value_digest = "3333333333333333333333333333333333333333333333333333333333333333"
        expect(canonical_semantic_read_set_encode_v1(SemanticReadSetV1(entries: [first, second], uncacheable_reason: "")).len()).to_equal(0)

    it "rejects an empty provider manifest digest":
        val entry = SemanticReadEntryV1(effect_kind: SemanticEffectKindV1.Plugin,
            logical_name: "backend", provider_id: "llvm", provider_manifest_digest: "",
            value_digest: "2222222222222222222222222222222222222222222222222222222222222222",
            replay_policy: SemanticReplayPolicyV1.DeclaredReplayable)
        expect(canonical_semantic_read_set_encode_v1(SemanticReadSetV1(entries: [entry], uncacheable_reason: "")).len()).to_equal(0)

    it "rejects different providers for one semantic effect identity":
        val first = SemanticReadEntryV1(effect_kind: SemanticEffectKindV1.Plugin,
            logical_name: "backend", provider_id: "llvm", provider_manifest_digest: _digest("1"),
            value_digest: _digest("2"), replay_policy: SemanticReplayPolicyV1.DeclaredReplayable)
        var second = first
        second.provider_id = "cranelift"
        second.provider_manifest_digest = _digest("3")
        expect(canonical_semantic_read_set_encode_v1(
            SemanticReadSetV1(entries: [first, second], uncacheable_reason: "")).len()).to_equal(0)

    it "rejects conflicting duplicate symbols within one phase":
        var changed = _summary_v1()
        changed.forward_declarations = [
            PublicSummaryEntryV1(stable_symbol_id: "sym.main", canonical_bytes: "a", dependency_symbol_ids: []),
            PublicSummaryEntryV1(stable_symbol_id: "sym.main", canonical_bytes: "b", dependency_symbol_ids: [])]
        expect(canonical_public_summary_encode_v1(changed).len()).to_equal(0)

# #3054: retain actual parsed production type declarations, omitting unrelated
# function bodies so this owner regression needs no crypto/runtime closure.
fn cache_owner_provider(source: text, path: text, key: text,
        struct_names: [text], enum_names: [text]) -> Module:
    expect(source.len() > 0).to_equal(true)
    val actual = parse_full_frontend(source, path, key, Logger(level: 0))
    var selected = parse_full_frontend("", path, key, Logger(level: 0))
    for name in struct_names:
        expect(actual.structs.contains(name)).to_equal(true)
        selected.structs[name] = actual.structs[name]
    for name in enum_names:
        expect(actual.enums.contains(name)).to_equal(true)
        selected.enums[name] = actual.enums[name]
    selected

fn cache_owner_lower_original(body: text, optional_proof: bool = false, wrong_optional_owner: bool = false) -> (text, MirModule):
    val snapshot_path = "src/compiler/00.common/cache_contract/snapshot_contract_v1.spl"
    val codec_path = "src/compiler/00.common/cache_contract/canonical_cache_codec_v1.spl"
    val tld_path = "src/compiler/00.common/cache_contract/physical_tld_v1.spl"
    val snapshot_key = "compiler.common.cache_contract.snapshot_contract_v1"
    val codec_key = "compiler.common.cache_contract.canonical_cache_codec_v1"
    val tld_key = "compiler.common.cache_contract.physical_tld_v1"
    val snapshot_source = read_file(snapshot_path)
    val codec_source = read_file(codec_path)
    val tld_source = read_file(tld_path)
    val snapshot_ast = cache_owner_provider(snapshot_source, snapshot_path,
        snapshot_key, ["CacheObjectRefV1", "NamedDigestV1"], [])
    val codec_ast = cache_owner_provider(codec_source, codec_path, codec_key,
        ["CanonicalCacheEnvelopeV1", "CanonicalCacheDecodeV1"], [])
    val tld_ast = cache_owner_provider(tld_source, tld_path, tld_key,
        ["TldSectionRefV1", "PhysicalTldHeaderV1", "PhysicalTldHeaderDecodeV1"], ["TldPayloadRoleV1"])
    val imports = "use compiler.common.cache_contract.snapshot_contract_v1.\{CacheObjectRefV1\}\n" +
        "use compiler.common.cache_contract.canonical_cache_codec_v1.\{CanonicalCacheEnvelopeV1, CanonicalCacheDecodeV1\}\n" +
        "use compiler.common.cache_contract.physical_tld_v1.\{TldSectionRefV1, PhysicalTldHeaderV1, PhysicalTldHeaderDecodeV1\}\n"
    val consumer_key = "probe.cache_owner_consumer"
    val entry_key = "probe.cache_owner_entry"
    val consumer_source = imports + "\npub struct CacheOwnerPrimitiveOptional:\n    count: i64?\n\n" + body
    val entry_source = "use compiler.common.cache_contract.snapshot_contract_v1.\{NamedDigestV1\}\n" + imports + "use probe.cache_owner_consumer.*\n\nfn main() -> i64:\n    0\n"
    val consumer_ast = parse_full_frontend(consumer_source,
        "testdata/cache_owner_consumer.spl", consumer_key, Logger(level: 0))
    val entry_ast = parse_full_frontend(entry_source,
        "testdata/cache_owner_entry.spl", entry_key, Logger(level: 0))
    var modules: Dict<text, Module> = {}
    modules[snapshot_key] = snapshot_ast
    modules[codec_key] = codec_ast
    modules[tld_key] = tld_ast
    modules[consumer_key] = consumer_ast
    modules[entry_key] = entry_ast
    val sources = [
        SourceFile(path: snapshot_path, content: snapshot_source, module_name: snapshot_key),
        SourceFile(path: codec_path, content: codec_source, module_name: codec_key),
        SourceFile(path: tld_path, content: tld_source, module_name: tld_key),
        SourceFile(path: "testdata/cache_owner_consumer.spl", content: consumer_source, module_name: consumer_key),
        SourceFile(path: "testdata/cache_owner_entry.spl", content: entry_source, module_name: entry_key)]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var snapshot_lowering = hirlowering_for_module(snapshot_key, surfaces)
    var codec_lowering = hirlowering_for_module(codec_key, surfaces)
    var tld_lowering = hirlowering_for_module(tld_key, surfaces)
    var consumer_lowering = hirlowering_for_module(consumer_key, surfaces)
    var entry_lowering = hirlowering_for_module(entry_key, surfaces)
    val snapshot_hir = snapshot_lowering.lower_module(snapshot_ast)
    val codec_hir = codec_lowering.lower_module(codec_ast)
    val tld_hir = tld_lowering.lower_module(tld_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    val entry_hir = entry_lowering.lower_module(entry_ast)
    var hir_modules: Dict<text, HirModule> = {}
    hir_modules[snapshot_key] = snapshot_hir
    hir_modules[codec_key] = codec_hir
    hir_modules[tld_key] = tld_hir
    hir_modules[consumer_key] = consumer_hir
    hir_modules[entry_key] = entry_hir
    var lowering = MirLowering.new(entry_hir.symbols)
    # Native feed order: imported entry rows precede defining-module rows.
    lowering.prescan_module_struct_names(hir_modules, entry_key)
    lowering.prescan_module_struct_names(hir_modules, consumer_key)
    lowering.prescan_module_struct_names(hir_modules, snapshot_key)
    lowering.prescan_module_struct_names(hir_modules, codec_key)
    lowering.prescan_module_struct_names(hir_modules, tld_key)
    lowering.lower_module(entry_hir, [], true)
    if optional_proof:
        # Pin the first transport boundary to the actual defining HIR rows,
        # not an entry-imported copy with accidentally coincident symbol ids.
        val codec_owner = codec_key + "::CanonicalCacheDecodeV1"
        val tld_owner = tld_key + "::PhysicalTldHeaderDecodeV1"
        var registered_codec = false
        var registered_tld = false
        for symbol in codec_hir.structs.keys():
            val definition = codec_hir.structs[symbol]
            if definition.name == "CanonicalCacheDecodeV1":
                lowering.register_composite_field_metadata(codec_owner, definition.fields, codec_hir.symbols, true)
                registered_codec = true
        for symbol in tld_hir.structs.keys():
            val definition = tld_hir.structs[symbol]
            if definition.name == "PhysicalTldHeaderDecodeV1":
                lowering.register_composite_field_metadata(tld_owner, definition.fields, tld_hir.symbols, true)
                registered_tld = true
        expect(registered_codec).to_equal(true)
        expect(registered_tld).to_equal(true)
        lowering.symbols = consumer_hir.symbols
        val records = [codec_owner, tld_owner]
        val payload_names = ["CanonicalCacheEnvelopeV1", "PhysicalTldHeaderV1"]
        val payload_modules = [codec_key, tld_key]
        var proof_index = 0
        while proof_index < records.len():
            val record = records[proof_index]
            val payload_owner = payload_modules[proof_index] + "::" + payload_names[proof_index]
            val expected_id = consumer_hir.symbols.lookup_qualified_type_raw(payload_modules[proof_index], payload_names[proof_index])
            expect(expected_id).to_be_greater_than(-1)
            expect(lowering.symbol_matches_ownership_key(expected_id, payload_owner)).to_equal(true)
            val raw_fields = lowering.struct_field_hir_type[record]
            val raw_optional = raw_fields[1]
            var saw_distinct_provider_id = false
            match raw_optional.kind:
                case HirTypeKind.Optional(inner):
                    match inner.kind:
                        case HirTypeKind.Named(provider_symbol, args):
                            expect(args.len()).to_equal(0)
                            saw_distinct_provider_id = provider_symbol.id != expected_id
                            val actual_provider_name = if proof_index == 0:
                                codec_hir.symbols.symbol_name_scalar_raw(provider_symbol.id)
                            else:
                                tld_hir.symbols.symbol_name_scalar_raw(provider_symbol.id)
                            expect(actual_provider_name).to_equal(payload_names[proof_index])
                        case _: ()
                case _: ()
            expect(saw_distinct_provider_id).to_equal(true)
            # FIRST-loss oracle: baseline registration has no Optional key.
            var ownership_keys = lowering.struct_field_type_ownership_key[record]
            expect(ownership_keys[1]).to_equal(payload_owner)
            if wrong_optional_owner:
                # The consumer has the same leaf name under the REAL module;
                # a different module's claimed owner must not capture it.
                ownership_keys[1] = "probe.wrong_provider::" + payload_names[proof_index]
                lowering.struct_field_type_ownership_key[record] = ownership_keys
            val rebound = lowering.declared_field_type_in_current_table(record, 1, raw_optional)
            var exact_optional = false
            var refused = false
            match rebound.kind:
                case HirTypeKind.Optional(inner):
                    match inner.kind:
                        case HirTypeKind.Named(active_symbol, args):
                            exact_optional = active_symbol.id == expected_id and args.len() == 0 and lowering.symbol_matches_ownership_key(active_symbol.id, payload_owner)
                        case _: ()
                case HirTypeKind.Error: refused = true
                case _: ()
            if wrong_optional_owner:
                expect(refused).to_equal(true)
                var fatal_owner_error = false
                for e in lowering.errors:
                    if e.fatal and e.message.contains("optional field payload owner is unavailable in consumer"):
                        fatal_owner_error = true
                expect(fatal_owner_error).to_equal(true)
            else:
                expect(exact_optional).to_equal(true)
            proof_index = proof_index + 1
        # A parsed primitive Optional has no nominal ownership evidence and
        # remains primitive; this transport repair must not wrap Error or
        # reinterpret a scalar as a record.
        var verified_primitive = false
        for symbol in consumer_hir.structs.keys():
            val definition = consumer_hir.structs[symbol]
            if definition.name == "CacheOwnerPrimitiveOptional":
                val primitive_owner = consumer_key + "::CacheOwnerPrimitiveOptional"
                lowering.register_composite_field_metadata(primitive_owner, definition.fields, consumer_hir.symbols, true)
                val primitive_fields = lowering.struct_field_hir_type[primitive_owner]
                val primitive_keys = lowering.struct_field_type_ownership_key[primitive_owner]
                expect(primitive_keys[0]).to_equal("")
                val primitive = lowering.declared_field_type_in_current_table(primitive_owner, 0, primitive_fields[0])
                var preserved_primitive = false
                match primitive.kind:
                    case HirTypeKind.Optional(inner):
                        match inner.kind:
                            case HirTypeKind.Int(bits, signed): preserved_primitive = bits == 64 and signed
                            case _: ()
                    case _: ()
                expect(preserved_primitive).to_equal(true)
                verified_primitive = true
        expect(verified_primitive).to_equal(true)
    val mir = lowering.lower_module(consumer_hir, [], false)
    var errors = ""
    for e in snapshot_lowering.errors: errors = errors + "snapshot hir: " + e.message + "\n"
    for e in codec_lowering.errors: errors = errors + "codec hir: " + e.message + "\n"
    for e in tld_lowering.errors: errors = errors + "tld hir: " + e.message + "\n"
    for e in entry_lowering.errors: errors = errors + "entry hir: " + e.message + "\n"
    for e in consumer_lowering.errors: errors = errors + "consumer hir: " + e.message + "\n"
    for e in lowering.errors: errors = errors + "mir: " + e.message + "\n"
    (errors, mir)

fn cache_owner_local_i64(function: MirFunction, id: LocalId) -> bool:
    for local in function.locals:
        if local.id.id == id.id:
            match local.type_.kind:
                case MirTypeKind.I64: return true
                case _: return false
    false

fn cache_owner_operand_i64(function: MirFunction, operand: MirOperand) -> bool:
    match operand.kind:
        case MirOperandKind.Copy(local): cache_owner_local_i64(function, local)
        case MirOperandKind.Move(local): cache_owner_local_i64(function, local)
        case MirOperandKind.Const(_, type_):
            match type_.kind:
                case MirTypeKind.I64: true
                case _: false

fn cache_owner_scalar_ne_count(module: MirModule, name: text) -> i64:
    var count = 0
    for symbol in module.functions.keys():
        val function = module.functions[symbol]
        if function.name == name or function.name.ends_with("." + name):
            for block in function.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.BinOp(_, op, left, right):
                            match op:
                                case MirBinOp.Ne:
                                    if cache_owner_operand_i64(function, left) and cache_owner_operand_i64(function, right):
                                        count = count + 1
                                case _: ()
                        case _: ()
    count

fn cache_owner_section_evidence(module: MirModule) -> [i64]:
    # Array GetField, scalar element GetField, runtime length/get calls.
    var counts: [i64] = [0, 0, 0, 0]
    for symbol in module.functions.keys():
        val function = module.functions[symbol]
        if function.name == "cache_owner_section_total" or function.name.ends_with(".cache_owner_section_total"):
            for block in function.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.GetField(dest, _, field):
                            # header.sections and section.stored_bytes both
                            # have index 5 in the actual production records.
                            if field == 5:
                                for local in function.locals:
                                    if local.id.id == dest.id:
                                        match local.type_.kind:
                                            case MirTypeKind.Array(_, _): counts[0] = counts[0] + 1
                                            case MirTypeKind.I64: counts[1] = counts[1] + 1
                                            case _: ()
                        case MirInstKind.Call(_, target, _):
                            match target.kind:
                                case MirOperandKind.Const(value, _):
                                    match value:
                                        case MirConstValue.Str(callee):
                                            if callee == "rt_array_len": counts[2] = counts[2] + 1
                                            if callee == "rt_array_get": counts[3] = counts[3] + 1
                                        case _: ()
                                case _: ()
                        case _: ()
    counts

describe "Cache codec original-form MIR owner qualification #3054":
    it "keeps actual imported cache scalar fields out of record equality dispatch":
        val source = "pub fn cache_owner_reference(reference: CacheObjectRefV1, expected: i64) -> bool:\n    reference.schema != expected\n\n" +
            "pub fn cache_owner_envelope(decoded: CanonicalCacheDecodeV1, expected_kind: i64) -> bool:\n" +
            "    val envelope = match decoded.value:\n        case Some(value): value\n        case nil: return false\n" +
            "    envelope.kind != expected_kind or envelope.schema != 1\n\n" +
            "pub fn cache_owner_tld(header: PhysicalTldHeaderV1, expected_offset: i64) -> bool:\n    expected_offset != header.payload_bytes\n"
        val (errors, mir) = cache_owner_lower_original(source)
        expect(errors).to_equal("")
        # Counting i64 Ne operands rejects structural-equality fallbacks that
        # merely silence the historical wrong-record diagnostic.
        expect(cache_owner_scalar_ne_count(mir, "cache_owner_reference")).to_equal(1)
        expect(cache_owner_scalar_ne_count(mir, "cache_owner_envelope")).to_equal(2)
        expect(cache_owner_scalar_ne_count(mir, "cache_owner_tld")).to_equal(1)

    it "keeps header.sections as an array and section.stored_bytes on its owner":
        val source = "pub fn cache_owner_section_total(header: PhysicalTldHeaderV1) -> i64:\n" +
            "    var total: i64 = 0\n    for section in header.sections:\n" +
            "        total = total + section.stored_bytes\n    total\n"
        val (errors, mir) = cache_owner_lower_original(source)
        expect(errors).to_equal("")
        val evidence = cache_owner_section_evidence(mir)
        expect(evidence[0]).to_be_greater_than(0)
        expect(evidence[1]).to_be_greater_than(0)
        expect(evidence[2]).to_be_greater_than(0)
        expect(evidence[3]).to_be_greater_than(0)

    it "rejects a real CacheObjectRefV1 record as an iterable":
        val (errors, _) = cache_owner_lower_original("pub fn cache_owner_bad_iteration(reference: CacheObjectRefV1) -> i64:\n    for section in reference:\n        return 1\n    0\n")
        expect(errors.contains("for-in over non-array iterables")).to_equal(true)

    it "retains the record owner for unsupported CacheObjectRefV1 arithmetic":
        val (errors, _) = cache_owner_lower_original("pub fn cache_owner_bad_operator(reference: CacheObjectRefV1) -> CacheObjectRefV1:\n    reference + reference\n")
        expect(errors.contains("operator overload for struct")).to_equal(true)
        expect(errors.contains("CacheObjectRefV1")).to_equal(true)


    it "rebinds actual decoded optional owners before scalar and section use after Some":
        val source = "pub fn cache_owner_envelope(decoded: CanonicalCacheDecodeV1, expected_kind: i64) -> bool:\n" +
            "    val envelope = match decoded.value:\n        case Some(value): value\n        case nil: return false\n" +
            "    envelope.kind != expected_kind or envelope.schema != 1\n\n" +
            "pub fn cache_owner_tld(decoded: PhysicalTldHeaderDecodeV1, expected_offset: i64) -> bool:\n" +
            "    val header = match decoded.value:\n        case Some(value): value\n        case nil: return false\n" +
            "    expected_offset != header.payload_bytes\n\n" +
            "pub fn cache_owner_section_total(decoded: PhysicalTldHeaderDecodeV1) -> i64:\n" +
            "    val header = match decoded.value:\n        case Some(value): value\n        case nil: return 0\n" +
            "    var total: i64 = 0\n    for section in header.sections:\n" +
            "        total = total + section.stored_bytes\n    total\n"
        val (errors, mir) = cache_owner_lower_original(source, true)
        expect(errors).to_equal("")
        expect(cache_owner_scalar_ne_count(mir, "cache_owner_envelope")).to_equal(2)
        expect(cache_owner_scalar_ne_count(mir, "cache_owner_tld")).to_equal(1)
        val evidence = cache_owner_section_evidence(mir)
        expect(evidence[0]).to_be_greater_than(0)
        expect(evidence[1]).to_be_greater_than(0)
        expect(evidence[2]).to_be_greater_than(0)
        expect(evidence[3]).to_be_greater_than(0)

    it "fatally rejects a same-leaf optional payload from the wrong provider":
        val (errors, _) = cache_owner_lower_original("pub fn cache_owner_unused() -> i64:\n    0\n", true, true)
        expect(errors.contains("optional field payload owner is unavailable in consumer")).to_equal(true)
