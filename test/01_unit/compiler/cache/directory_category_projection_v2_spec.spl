# @req REQ-DTA-A1 REQ-DTA-H1
use std.spec.*
use compiler.common.cache_contract.directory_category_projection_v2.{DirectoryCategoryProjectionV2,
    directory_category_projection_valid_v2}

fn projection(policy: text = "a".repeat(64), trait_root: text = "b".repeat(64),
        extension_root: text = "c".repeat(64)) -> DirectoryCategoryProjectionV2:
    DirectoryCategoryProjectionV2(canonical_path: "src/pkg/a.spl", source_identity: "pkg/a.spl",
        source_digest: "d".repeat(64), target_triple: "aarch64-unknown-linux-gnu",
        preprocessed_digest: "e".repeat(64), cfg_decision_digest: "f".repeat(64),
        environment_policy_digest: policy, trait_root: trait_root, extension_root: extension_root)

describe "partial directory category projection transport":
    it "accepts well formed partial facts without claiming directory admission":
        expect(directory_category_projection_valid_v2(projection())).to_equal(true)

    it "rejects absent or malformed policy and category digests":
        expect(directory_category_projection_valid_v2(projection(""))).to_equal(false)
        expect(directory_category_projection_valid_v2(projection("a".repeat(64), ""))).to_equal(false)
        expect(directory_category_projection_valid_v2(projection("a".repeat(64), "b".repeat(64), "bad"))).to_equal(false)

    it "rejects absent source and target identity":
        var missing_source = projection()
        missing_source.source_identity = ""
        expect(directory_category_projection_valid_v2(missing_source)).to_equal(false)
        var missing_target = projection()
        missing_target.target_triple = ""
        expect(directory_category_projection_valid_v2(missing_target)).to_equal(false)
