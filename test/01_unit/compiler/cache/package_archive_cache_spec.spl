use std.spec.*
use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "sealed clean-package archive cache":
    it "stores one pinned archive and receipt per package":
        step("stores one pinned archive and receipt per package")
        val source = rt_file_read_text(
            "src/compiler/80.driver/cache/package_archive_cache.spl") ?? ""
        expect(source).to_contain("PackageArchiveMemberReceiptV1")
        expect(source).to_contain("actions.smf")
        expect(source).to_contain("interface.smf")
        expect(source).to_contain("manifest.sdn")
        expect(source).to_contain("cas_blob_path(root, receipt!.archive_digest)")

    it "loads only an atomically visible receipt mapping":
        step("loads only an atomically visible receipt mapping")
        val source = rt_file_read_text(
            "src/compiler/80.driver/cache/package_archive_cache.spl") ?? ""
        expect(source).to_contain("cas_batch_lookup_receipt_digest_v1")
        expect(source).to_contain("archive-provenance-mismatch")
        expect(source).to_not_contain("action_get(")

    it "publishes one complete SCC generation":
        step("publishes one complete SCC generation")
        val source = rt_file_read_text(
            "src/compiler/80.driver/cache/package_archive_cache.spl") ?? ""
        expect(source).to_contain("cas_batch_begin_v1")
        expect(source).to_contain("cas_batch_stage_object_v1")
        expect(source).to_contain("cas_batch_publish_v1(transaction)")
        expect(source).to_contain("cas_batch_abort_v1(transaction)")
