# Functional assertions share the same production entry used by the P2 native check.
use std.spec.*
use test.fixtures.compiler.macro_array_insert_native.{macro_insert_boundary_check, macro_sorted_names_check}

describe "macro typed array insertion compatibility":
    it "preserves insertion boundaries, equal-line order, arguments, guards and activity":
        expect(macro_insert_boundary_check()).to_equal(true)
    it "sorts and deduplicates registry and projector names without mutating input":
        expect(macro_sorted_names_check()).to_equal(true)
