# Spec files have no `fn main`. Under the seed JIT the runner synthesizes the
# spec entry instead of silently interpreting (doc/08_tracking/bug/
# seed_jit_spec_files_never_jit_2026-11-04.md). The std.spec import also pulls
# in decorators.spl's closure-returning `skip`, which the JIT used to refuse.
use std.spec.*

val base = 40

fn plus_two(x: i64) -> i64:
    x + 2

describe "jit spec entry":
    it "runs module-level examples with globals and helpers":
        expect(plus_two(base)).to_equal(42)
    it "runs a second example":
        expect("ab" + "c").to_equal("abc")
    skip("documents a skip", "fixture: skip must not abort the module")
