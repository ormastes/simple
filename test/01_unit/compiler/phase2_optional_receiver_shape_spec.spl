# Purpose and audience: regression evidence for Phase 2 optional and typed receiver lowering.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect, step}

extern fn rt_file_read_text(path: text) -> text?

describe "Phase 2 optional receiver shapes":
    it "unwraps optional text positions before arithmetic":
        step("Bind the optional index returned by text.index_of")
        val source = rt_file_read_text("src/app/devhub/version_manifest.spl") ?? ""
        expect(source).to_contain("if val idx = line.index_of")
        expect(source.contains("\n    val idx = line.index_of")).to_be(false)

    it "uses the narrowed JIT mapping record directly":
        step("Do not compare an already-bound Some payload with nil")
        val source = rt_file_read_text("src/compiler/99.loader/module_loader_compat.spl") ?? ""
        expect(source).to_contain("Some(value):\n                        owner = value.owner_id")
        expect(source.contains("if value != nil:")).to_be(false)

    it "moves receipt enum comparison behind a typed helper boundary":
        step("Keep the receipt type explicit while lowering the ownership predicate")
        val source = rt_file_read_text("src/compiler/99.loader/segment_mapper.spl") ?? ""
        expect(source).to_contain("fn segment_mapper_owns_receipt_v1(receipt: ExecutableMappingReceiptV1")
        expect(source).to_contain("if not segment_mapper_owns_receipt_v1(receipt, self.instance_id):")
