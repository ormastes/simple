# @tag:in-development
# Repro: doc/08_tracking/bug/function_local_use_leaves_impl_blocks_unloaded_2026-11-12.md
# A function-local `use` of a module whose methods live in an `impl` block
# loads the named symbol only; the impl block stays unloaded, so the first
# method call fails with `method parse_outline not found`. The MCP source_open
# path hit this on the real server (seed-served src/app/mcp/main.spl).
# Expected to FAIL until the loader loads impl blocks for lazily imported types.
use std.spec
use std.spec.step

fn lazy_outline_node_count(source: text) -> i64:
    use compiler.frontend.treesitter.outline.{TreeSitter}
    use compiler.frontend.treesitter.outline_lexer.{treesitter_new}
    var parser = treesitter_new(source)
    val module = parser.parse_outline()
    module.classes.len() + module.functions.len()

describe "function-local lazy use of a type with impl-block methods":
    it "resolves the impl method on the first call after a function-local use":
        step("construct TreeSitter through a function-local use and call its impl method")
        val count = lazy_outline_node_count("class A:\n    fn f(): 1\nfn g(): 2\n")
        expect(count).to_equal(2)
