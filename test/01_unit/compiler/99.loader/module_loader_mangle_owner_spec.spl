use std.spec
# Retargeted 2026-11-12: mangle_name is package-visible; the loader runtime
# facade (99.loader/runtime/__init__.spl) is its public export.
use compiler.loader.runtime.{mangle_name}
use compiler.loader.compiler_sffi.{make_int_type, make_bool_type}

describe "module loader type-argument helper ownership":
    it "keeps nongeneric symbol names unchanged":
        expect(mangle_name("load_value", [])).to_equal("load_value")

    it "includes an integer type in the generic name":
        expect(mangle_name("load_value", [make_int_type(64, true)])).to_equal("load_value$i64")

    it "preserves type argument order":
        expect(mangle_name("pair", [make_int_type(32, false), make_bool_type()])).to_equal("pair$u32_bool")
        expect(mangle_name("pair", [make_bool_type(), make_int_type(32, false)])).to_equal("pair$bool_u32")
