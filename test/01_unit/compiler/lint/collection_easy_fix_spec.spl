# Proof-gated fixes for collection-efficiency lints.
use std.spec.*
use compiler.tools.lint.main.{Linter, lint_cli_source}
use std.tooling.easy_fix.*


val CONCAT_SRC = "fn build(xs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for x in xs:\n        out = out + [x]\n    out\n"
val MULTI_SRC = "fn build2(xs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for x in xs:\n        out = out + [x, x]\n    out\n"
val POP_SRC = "fn drain(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[0:arr.len()-1]\n    arr\n"

describe "collection lint auto-fix":
    # @manual scenario evidence

    it "reports COLL001 on the offending line, not the enclosing function":
        # @req REQ-SSPEC-COMPILER
        step("reports COLL001 on the offending line, not the enclosing function")
        """A quadratic concat inside a loop should point at the concat itself,
        so the reader lands on the defect rather than the function header."""
        step("Lint a function whose loop body grows an array by concatenation")
        var line = 0
        var count = 0
        for result in lint_cli_source(Linter.new(), "/tmp/coll_push.spl", CONCAT_SRC):
            if result.lint.code == "COLL001":
                count = count + 1
                line = result.line
        assert_equal(count, 1)
        # `out = out + [x]` is line 4; `fn build` is line 1.
        assert_equal(line, 4)

    it "keeps the AST fallback advisory and exposes its uncertainty":
        """A source-shape match lacks the typed/effect/alias proof required for
        a machine-applicable rewrite. COLL001 is not in the §10.3 exception
        list (only COLL002 and COLL020 get a Certain fix in this lane), so it
        stays hint-only: a fix_hint string, never an easy_fix."""
        step("Inspect the COLL001 evidence contract")
        var found = false
        var has_fix = false
        var hint = ""
        for result in lint_cli_source(Linter.new(), "/tmp/coll_push2.spl", CONCAT_SRC):
            if result.lint.code == "COLL001":
                found = true
                match result.lint.easy_fix:
                    case Some(_):
                        has_fix = true
                    case nil:
                        val _ = 0
                match result.lint.fix_hint:
                    case Some(h):
                        hint = h
                    case nil:
                        val _ = 0
        assert_true(found)
        assert_false(has_fix)
        assert_equal(hint, "use .push() instead of arr = arr + [x]")

    it "warns without a fix when the concat appends more than one element":
        # @req REQ-SSPEC-COMPILER
        step("warns without a fix when the concat appends more than one element")
        """`arr + [a, b]` needs one push per element, which is not a
        statement-local rewrite, so the warning stands alone."""
        step("Lint a loop body appending a two-element literal")
        var warned = false
        var replacements = 0
        for result in lint_cli_source(Linter.new(), "/tmp/coll_multi.spl", MULTI_SRC):
            if result.lint.code == "COLL001":
                warned = true
                match result.lint.easy_fix:
                    case Some(fix):
                        replacements = replacements + easyfix_replacements(fix).len()
                    case nil:
                        val _ = 0
        assert_true(warned)
        assert_equal(replacements, 0)

    it "keeps the array-rebuild fallback hint-only":
        """The bug report and this rule's own header comment wrote the
        fixture with `..` (arr[0..arr.len()-1]); that is not valid slice
        syntax (`..` builds a Range, not a slice — indexing by one errors
        at runtime), so neither the warning nor a fix could ever see it.
        The rule fires on the real colon slice form. COLL007 is not in the
        §10.3 exception list either, so — like COLL001 above — it stays
        hint-only rather than offering a machine-applicable rewrite."""
        step("Lint a loop that rebuilds arr via arr[0:arr.len()-1]")
        var found = false
        var has_fix = false
        var hint = ""
        for result in lint_cli_source(Linter.new(), "/tmp/coll_pop.spl", POP_SRC):
            if result.lint.code == "COLL007":
                found = true
                match result.lint.easy_fix:
                    case Some(_):
                        has_fix = true
                    case nil:
                        val _ = 0
                match result.lint.fix_hint:
                    case Some(h):
                        hint = h
                    case nil:
                        val _ = 0
        assert_true(found)
        assert_false(has_fix)
        assert_equal(hint, "use .pop() instead of rebuilding array")

# ---------------------------------------------------------------------------
# COLL002 upgrade: a Certain fix, but only when every §10.3 precondition
# holds (arr declared file-unique with a real element type, not mutated in
# the loop, and the `.contains(` call itself file-unique).
# ---------------------------------------------------------------------------

val COLL002_FIX_SRC = "fn search_slow(targets: [i64]) -> [i64]:\n    var out: [i64] = []\n    var arr: [i64] = [1, 2, 3]\n    for t in targets:\n        if arr.contains(t):\n            out.push(t)\n    out\n"
val COLL002_TEXT_RECEIVER_SRC = "fn search_text(targets: [text]) -> [text]:\n    var out: [text] = []\n    var arr: text = \"hello\"\n    for t in targets:\n        if arr.contains(t):\n            out.push(t)\n    out\n"
val COLL002_MUTATED_SRC = "fn search_mutate(targets: [i64]) -> [i64]:\n    var out: [i64] = []\n    var arr: [i64] = [1, 2, 3]\n    for t in targets:\n        if arr.contains(t):\n            out.push(t)\n        arr.push(t)\n    out\n"
val COLL002_AMBIGUOUS_SRC = "fn search_twice(targets: [i64]) -> [i64]:\n    var out: [i64] = []\n    var arr: [i64] = [1, 2, 3]\n    var other: [i64] = [4, 5, 6]\n    for t in targets:\n        if arr.contains(t):\n            out.push(t)\n        if other.contains(t):\n            out.push(t)\n    out\n"

fn coll002_fix_of(path: text, src: text) -> EasyFix?:
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == "COLL002":
            match result.lint.easy_fix:
                case Some(fix): return Some(fix)
                case nil: val _ = 0
    nil

fn coll002_warned(path: text, src: text) -> bool:
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == "COLL002":
            return true
    false

describe "COLL002 upgrade — Certain fix under §10.3 preconditions":
    it "hoists a file-unique, non-mutated array into a membership Dict":
        step("hoists a file-unique, non-mutated array into a membership Dict")
        match coll002_fix_of("/tmp/coll002_fix.spl", COLL002_FIX_SRC):
            case Some(fix):
                val replacements = easyfix_replacements(fix)
                assert_equal(replacements.len(), 2)
                var sorted = easyfix_sort_replacements_descending(replacements)
                val applied = easyfix_apply_sorted_replacements(COLL002_FIX_SRC, sorted)
                expect(applied).to_contain("var arr_set: Dict<i64, bool> = {}")
                expect(applied).to_contain("for _v in arr: arr_set[_v] = true")
                expect(applied).to_contain("if arr_set.contains_key(t):")
                assert_false(applied.contains("arr.contains(t)"))
            case nil:
                assert_true(false)

    it "does not warn at all when the receiver is text, not an array":
        step("does not warn at all when the receiver is text, not an array")
        """FLIPPED round 5. This used to assert the rule WARNS here and
        merely withholds the fix. That was wrong, and it was a real false
        positive in the tree: on text `.contains` is a SUBSTRING search, not
        an O(n) element scan, so COLL002 simply does not apply and there is
        nothing for the user to act on. Measured at
        src/compiler/80.driver/driver_build/incremental.spl:308 —
        `val alphabet = "0123456789abcdef"`. `check_loop_body` was already
        being handed `text_vars` for COLL001's sake and was not consulting
        them here. Both the positive and the negated form are now gated; the
        array case still warns, pinned in collection_frame_rules_spec."""
        assert_false(coll002_warned("/tmp/coll002_text.spl", COLL002_TEXT_RECEIVER_SRC))
        match coll002_fix_of("/tmp/coll002_text.spl", COLL002_TEXT_RECEIVER_SRC):
            case Some(_): assert_true(false)
            case nil: val _ = 0

    it "stays hint-only when the array is mutated inside the loop":
        step("stays hint-only when the array is mutated inside the loop")
        """A hoisted-before-the-loop Dict snapshot would go stale the moment
        the loop pushes onto `arr`, so a mutated receiver must not get a
        machine-applied fix."""
        assert_true(coll002_warned("/tmp/coll002_mutate.spl", COLL002_MUTATED_SRC))
        match coll002_fix_of("/tmp/coll002_mutate.spl", COLL002_MUTATED_SRC):
            case Some(_): assert_true(false)
            case nil: val _ = 0

    it "fixes BOTH sites when two different arrays are searched in one loop":
        step("fixes BOTH sites when two different arrays are searched in one loop")
        """FLIPPED round 4. This used to refuse, on a file-uniqueness rule
        inherited from COLL001/COLL007: two `.contains(` sites made the
        TEXTUAL location recovery ambiguous. Location is no longer recovered
        from text — each proof carries the parser's own line for its guard,
        its push and its declaration — so the ambiguity it was guarding
        against no longer exists, and refusing here cost real coverage.
        `arr` and `other` are distinct receivers with distinct declarations,
        distinct generated names and disjoint edits. A/B'd by execution:
        `search_twice([1, 4, 7, 2, 5])` is `[1, 4, 2, 5]` before and after.
        (Two safe proofs on the SAME receiver are still collapsed to one
        rendered fix — see collection_certain_fix_safety_spec.)"""
        assert_true(coll002_warned("/tmp/coll002_ambiguous.spl", COLL002_AMBIGUOUS_SRC))
        match coll002_fix_of("/tmp/coll002_ambiguous.spl", COLL002_AMBIGUOUS_SRC):
            case Some(_): val _ = 0
            case nil: assert_true(false)

# ---------------------------------------------------------------------------
# COLL020 manual_distinct: a Certain fix, but only for the fresh-local,
# single-array shape §10.3 describes.
# ---------------------------------------------------------------------------

val COLL020_FIX_SRC = "fn distinct_slow(xs: [i64]) -> [i64]:\n    var result: [i64] = []\n    for x in xs:\n        if not result.contains(x):\n            result.push(x)\n    result\n"
val COLL020_PREFILLED_SRC = "fn distinct_prefilled(xs: [i64]) -> [i64]:\n    var result: [i64] = [0]\n    for x in xs:\n        if not result.contains(x):\n            result.push(x)\n    result\n"

fn coll020_fix_of(path: text, src: text) -> EasyFix?:
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == "COLL020":
            match result.lint.easy_fix:
                case Some(fix): return Some(fix)
                case nil: val _ = 0
    nil

fn coll020_warned(path: text, src: text) -> bool:
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == "COLL020":
            return true
    false

describe "COLL020 manual_distinct — Certain fix under §10.3 preconditions":
    it "adds a membership Dict kept in step with the growing array":
        step("adds a membership Dict kept in step with the growing array")
        match coll020_fix_of("/tmp/coll020_fix.spl", COLL020_FIX_SRC):
            case Some(fix):
                val replacements = easyfix_replacements(fix)
                assert_equal(replacements.len(), 3)
                val sorted = easyfix_sort_replacements_descending(replacements)
                val applied = easyfix_apply_sorted_replacements(COLL020_FIX_SRC, sorted)
                expect(applied).to_contain("var result_set: Dict<i64, bool> = {}")
                expect(applied).to_contain("if not result_set.contains_key(x):")
                expect(applied).to_contain("result.push(x)")
                expect(applied).to_contain("result_set[x] = true")
                assert_false(applied.contains("result.contains(x)"))
            case nil:
                assert_true(false)

    it "stays hint-only when the array is not a fresh empty-literal local":
        step("stays hint-only when the array is not a fresh empty-literal local")
        """§10.3 requires `result` to start as `[]`; a prefilled literal means
        the array already has content the hoisted Dict would not have been
        built from, so it must not get a machine-applied fix."""
        assert_true(coll020_warned("/tmp/coll020_prefilled.spl", COLL020_PREFILLED_SRC))
        match coll020_fix_of("/tmp/coll020_prefilled.spl", COLL020_PREFILLED_SRC):
            case Some(_): assert_true(false)
            case nil: val _ = 0
