# Proof-gated fixes for collection-efficiency lints.
use std.spec.*
use compiler.tools.lint.main.{Linter, lint_cli_source}
use std.tooling.easy_fix.*

val CONCAT_SRC = "fn build(xs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for x in xs:\n        out = out + [x]\n    out\n"
val MULTI_SRC = "fn build2(xs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for x in xs:\n        out = out + [x, x]\n    out\n"
val POP_SRC = "fn drain(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[0:arr.len()-1]\n    arr\n"

describe "collection lint auto-fix":

    it "reports COLL001 on the offending line, not the enclosing function":
        """A quadratic concat inside a loop should point at the concat itself,
        so the reader lands on the defect rather than the function header."""
        step("Lint a function whose loop body grows an array by concatenation")
        var line = 0
        var count = 0
        for result in lint_cli_source(Linter.new(), "/tmp/coll_push.spl", CONCAT_SRC):
            if result.lint.code == "COLL001":
                count = count + 1
                line = result.line
        assert_equal(count, 1)
        # `out = out + [x]` is line 4; `fn build` is line 1.
        assert_equal(line, 4)

    it "keeps the AST fallback advisory and exposes its uncertainty":
        """A source-shape match lacks the typed/effect/alias proof required for
        a machine-applicable rewrite."""
        step("Inspect the COLL001 evidence contract")
        var found = false
        for result in lint_cli_source(Linter.new(), "/tmp/coll_push2.spl", CONCAT_SRC):
            if result.lint.code == "COLL001":
                found = true
                expect(result.lint.easy_fix).to_be_nil()
                expect(result.lint.uncertainty.is_some()).to_equal(true)
                expect(result.lint.evidence).to_contain("item=build")
        assert_true(found)

    it "warns without a fix when the concat appends more than one element":
        """`arr + [a, b]` needs one push per element, which is not a
        statement-local rewrite, so the warning stands alone."""
        step("Lint a loop body appending a two-element literal")
        var warned = false
        var replacements = 0
        for result in lint_cli_source(Linter.new(), "/tmp/coll_multi.spl", MULTI_SRC):
            if result.lint.code == "COLL001":
                warned = true
                match result.lint.easy_fix:
                    case Some(fix):
                        replacements = replacements + easyfix_replacements(fix).len()
                    case nil:
                        val _ = 0
        assert_true(warned)
        assert_equal(replacements, 0)

    it "keeps the array-rebuild fallback hint-only":
        """The bug report and this rule's own header comment wrote the
        fixture with `..` (arr[0..arr.len()-1]); that is not valid slice
        syntax. The rule fires on the real colon form, but typed proof is still
        required before rewriting it."""
        step("Lint a loop that rebuilds arr via arr[0:arr.len()-1]")
        var found = false
        for result in lint_cli_source(Linter.new(), "/tmp/coll_pop.spl", POP_SRC):
            if result.lint.code == "COLL007":
                found = true
                expect(result.lint.easy_fix).to_be_nil()
                expect(result.lint.uncertainty.is_some()).to_equal(true)
        assert_true(found)
