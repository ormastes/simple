use compiler.tools.fix.main.{FixToolApplicator}
use std.tooling.easy_fix.{EasyFix, Replacement, FixConfidence}
use std.io_runtime.{dir_create, dir_exists, dir_remove_all, getpid}

extern fn rt_exit(code: i32)

# Retained filename for existing callers. This oracle now covers invalid disk
# source admission: the directory cannot match the analyzed text snapshot.
# It does not reach file_atomic_write or qualify its failure branch.
val target = "/tmp/simple_fix_write_failure_{getpid()}"
dir_remove_all(target)
if not dir_create(target, false):
    print "FAIL: could not create write-failure target"
    rt_exit(1)

var fix = EasyFix.create("TEST001", "exercise invalid disk source", FixConfidence.Certain)
fix.add_replacement(Replacement.create(target, 0, 1, 1, 1, "b"))
var sources: Dict<text, text> = {}
sources[target] = "a"

val result = FixToolApplicator.apply_to_disk([fix], sources, false)
match result:
    case Ok(_report):
        dir_remove_all(target)
        print "FAIL: invalid disk source was reported as applied"
        rt_exit(1)
    case Err(_error):
        if not dir_exists(target):
            print "FAIL: source refusal removed the directory"
            rt_exit(1)

dir_remove_all(target)
print "PASS: invalid disk source is rejected without removing the directory"
rt_exit(0)
