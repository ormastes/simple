# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

# Bug: mir_json_hole_followed_by_closers_unbalanced_2026-11-26.
# The detector compared a 3-char slice against "{{{" / "}}}", which decode to
# 2 chars, so it never matched and the raw-HTML lint was dead.

use std.spec.step
use compiler.semantics.lint.security_raw_html.{_has_triple_brace}

val TRIPLE = "<p>{{{{{{body}}}}}}</p>"

describe "raw html triple-brace detector":
    # @manual scenario evidence
    it "matches a triple-brace span":
        # @req REQ-SSPEC-UNIT
        step("triple open and close braces are detected")
        expect(_has_triple_brace(TRIPLE)).to_equal(true)
        expect(_has_triple_brace("<p>plain</p>")).to_equal(false)
