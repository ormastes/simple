#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
lint_root="$repo_root/src/compiler/35.semantics/lint"

consumers='closure_capture concurrency_share_nothing deprecated duplicate_typed_args ignored_return match_exhaustiveness unreachable_code unused_vars required_comment stub_impl collection_patterns'

for name in $consumers; do
    source_file="$lint_root/$name.spl"
    test -f "$source_file"
    grep -F 'STMT_IF_CHAIN' "$source_file" >/dev/null
    grep -F 'EXPR_IF_CHAIN' "$source_file" >/dev/null
    grep -F 'flat_if_chain_first_arm_get' "$source_file" >/dev/null
    grep -F 'flat_if_chain_arm_count_get' "$source_file" >/dev/null
    grep -F 'flat_if_arm_next_get' "$source_file" >/dev/null
    grep -F 'flat_if_arm_init_get' "$source_file" >/dev/null
    grep -F 'flat_if_arm_body_at' "$source_file" >/dev/null
    grep -F 'flat_if_chain_else_stmt_at' "$source_file" >/dev/null
    grep -F 'flat_if_chain_else_expr_get' "$source_file" >/dev/null
done

# Binding heads are declarations/patterns, not evaluated reads. The generic
# walkers must gate head traversal to condition arms, while the two scope-aware
# consumers must copy the enclosing map before installing arm-local bindings.
for name in $consumers; do
    grep -F 'flat_if_arm_kind_get' "$lint_root/$name.spl" >/dev/null
    grep -F 'ARM_CONDITION' "$lint_root/$name.spl" >/dev/null
done
grep -F 'copy_capture_scope' "$lint_root/closure_capture.spl" >/dev/null
grep -F 'add_if_arm_bindings' "$lint_root/closure_capture.spl" >/dev/null
grep -F 'copy_share_scope' "$lint_root/concurrency_share_nothing.spl" >/dev/null
grep -F 'add_share_arm_bindings' "$lint_root/concurrency_share_nothing.spl" >/dev/null

echo 'raw if-chain lint walkers source contract: PASS'
