"""
## Purpose and audience
Purpose: Prove that W0407 severity routes through the WP-3 policy resolver (WP-10).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINT-001 — stable requirement identity for this spec.

"""
# W0407 Severity Promotion Under `critical` (WP-10)

Plan: doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md
WP-10.

`check_use_resolution` (use_resolution.spl) emits W0407 for a `use` import
that does not resolve to an existing `.spl` file. Every profile used to get
the same WARNING severity, including `critical` -- an unresolved import
could reach import-admission (module_loader_core.spl) with no ERROR
anywhere in the diagnostic chain. Severity is now routed through the WP-3
canonical policy resolver (`strictness_for_profile_name`) and promoted to
ERROR only at the `critical` rung.
"""

use compiler.core.ast.{ast_reset, decl_fn, decl_use_import}
use compiler.semantics.lint.use_resolution.{check_use_resolution, UseResolutionWarning}
use std.nogc_sync_mut.io_runtime.{read_file_text}

fn probe_file_path() -> text:
    "src/compiler/35.semantics/lint/use_resolution.spl"

fn make_unresolvable_use() -> i64:
    ast_reset()
    decl_use_import("compiler.wp10.definitely_does_not_exist_zzz", ["zzz"], 0)

use std.spec.step

describe "W0407 severity routes through the WP-3 policy resolver (WP-10)":
    it "defaults to WARNING for the permissive profile (\"\")":
        val d = make_unresolvable_use()
        val ws = check_use_resolution([d], probe_file_path(), "")
        expect(ws.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ws[0].code).to_equal("W0407")
        expect(ws[0].severity).to_equal("WARNING")

    it "stays WARNING for strict and robust (not critical)":
        step("Verify: stays WARNING for strict and robust (not critical)")
        # @req: REQ-COMPILER-LINT-001
        val d1 = make_unresolvable_use()
        val ws1 = check_use_resolution([d1], probe_file_path(), "strict")
        expect(ws1[0].severity).to_equal("WARNING")
        val d2 = make_unresolvable_use()
        val ws2 = check_use_resolution([d2], probe_file_path(), "robust")
        expect(ws2[0].severity).to_equal("WARNING")

    it "promotes to ERROR under critical":
        step("Verify: promotes to ERROR under critical")
        val d = make_unresolvable_use()
        val ws = check_use_resolution([d], probe_file_path(), "critical")
        expect(ws.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ws[0].severity).to_equal("ERROR")

    it "promotes to ERROR under the deprecated mission-critical alias too (WP-3 table)":
        step("Verify: promotes to ERROR under the deprecated mission-critical alias too (WP-3 table)")
        val d = make_unresolvable_use()
        val ws = check_use_resolution([d], probe_file_path(), "mission-critical")
        expect(ws[0].severity).to_equal("ERROR")

    it "accepts a direct module file without probing it as unresolved":
        step("Verify: a direct module.spl file resolves")
        ast_reset()
        val d = decl_use_import("compiler.semantics.lint.star_import", [], 0)
        val ws = check_use_resolution([d], probe_file_path(), "critical")
        expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "accepts a directory module through its __init__.spl fallback":
        step("Verify: module/__init__.spl is the fallback after module.spl is absent")
        ast_reset()
        val d = decl_use_import("compiler.semantics.lint", [], 0)
        val ws = check_use_resolution([d], probe_file_path(), "critical")
        expect(ws.len()).to_equal(0)

    it "skips declarations that are not use imports":
        step("Verify: non-use declarations do not trigger filesystem resolution")
        ast_reset()
        val d = decl_fn("ordinary_function", [], [], 0, [], 0, [], 0)
        val ws = check_use_resolution([d], probe_file_path(), "critical")
        expect(ws.len()).to_equal(0)

    it "uses only the canonical file facade and retains exactly two ordered probes":
        step("Verify: direct runtime ownership is absent and both facade probes remain")
        val source = read_file_text(probe_file_path())
        expect(source).to_contain("use std.nogc_sync_mut.io_runtime.{file_exists}")
        expect(source.contains("rt_file_exists")).to_equal(false)
        expect(source.split("file_exists(").len()).to_equal(3)
        expect(source).to_contain("if (not file_exists(target_file) and not file_exists(dir_init)):")
        val direct_probe = source.index_of("not file_exists(target_file)")
        val init_probe = source.index_of("not file_exists(dir_init)")
        expect(direct_probe).to_be_greater_than(-1)
        expect(init_probe).to_be_greater_than(direct_probe)
