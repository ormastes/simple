use std.io.{file_read}

describe "lint traceability primitive boundaries":
    it "uses concrete owners and primitive annotations":
        val source = file_read("src/compiler/90.tools/lint/_LintMain/traceability_and_assertions.spl")

        expect(source.contains("use compiler.tools.lint.main.*")).to_equal(false)
        expect(source).to_contain("use compiler.tools.lint._LintMain.config_and_model.{Lint, LintResult, Linter}")
        expect(source).to_contain("LintLevel, LintCategory")
        expect(source).to_contain("fn lint_is_feature_tracking_db(path: String) -> bool:")
        expect(source).to_contain("fn lint_field_index(header: [String], name: String) -> i64:")
        expect(source).to_contain("byte_offset: i64, line_num: i64")
        expect(source.contains(": Bool")).to_equal(false)
        expect(source.contains(": Int")).to_equal(false)
        expect(source.contains("-> Bool")).to_equal(false)
        expect(source.contains("-> Int")).to_equal(false)
