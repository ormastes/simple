use compiler.semantics.lint.raw_rt_access.{check_raw_rt_access}

extern fn rt_exit(code: i32)

val source = "u" + "se runtime.primitive.{\n    r" + "t_memcpy as memory_copy\n}\nfn f(): memory_copy(a, b, n)\n"
val findings = check_raw_rt_access(source, "src/app/product/copy.spl")
