# @req KPM-REQ-005
# Pins `lint_parse_memo.lint_parse_module_memo`: linting one file parses it
# once, but the memo must never serve decls for a DIFFERENT (path, source).
# Exercised through `check_param_object_rules`, the rule that owns the first
# parse of every lint run.
use std.spec.*
use compiler.tools.lint.param_object_rules.{check_param_object_rules}

fn memo_codes(source: text, path: text) -> [text]:
    [finding.code for finding in check_param_object_rules(source, path)]

describe "Lint parse memo":
    it "re-parses when the source changes under the same path":
        val invalid = "struct DemoParamsV1:\n    enabled: bool\n    ext: [ParamExt]\n"
        val valid = "struct DemoParamsV1:\n    hdr: ParamHeader\n    enabled: bool\n    ext: [ParamExt]\n"
        expect(memo_codes(invalid, "src/compiler/demo.spl")).to_contain("PARAM-001")
        expect(memo_codes(valid, "src/compiler/demo.spl").len()).to_equal(0)
        expect(memo_codes(invalid, "src/compiler/demo.spl")).to_contain("PARAM-001")

    it "re-parses when the path changes under the same source":
        val source = "fn enabled() -> text?:\n    env_get_opt(\"SIMPLE_AOP_LOG_CALLS\")\n"
        expect(memo_codes(source, "src/compiler/demo.spl")).to_contain("PARAM-003")
        expect(memo_codes(source, "src/app/io/demo.spl").len()).to_equal(0)
        expect(memo_codes(source, "src/compiler/demo.spl")).to_contain("PARAM-003")
