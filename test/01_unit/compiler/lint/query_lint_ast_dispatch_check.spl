use app.cli.query_lint.{_collect_lint_diagnostics_json}

extern fn rt_exit(code: i32)

# Direct top-level oracle because query diagnostic collection uses module-level
# state that the interpreter does not reliably share with BDD `it` closures.
# Run: bin/simple run test/01_unit/compiler/lint/query_lint_ast_dispatch_check.spl

val source = "fn ast_stub_probe() -> i64:\n    0\n\nfn ast_arg_probe(a: i8, b: i16, c: i32, d: i64, e: u8, f: u16, g: u32, h: u64) -> i8:\n    a\n"
val result = _collect_lint_diagnostics_json("/tmp/query_lint_ast_dispatch_probe.spl", source)
val diagnostics = result.1.join("\n")

if result.0 != 2 or result.1.len() != 2 or not diagnostics.contains("\"code\":\"STUB002\"") or not diagnostics.contains("\"code\":\"ARG001\""):
    print "FAIL: query lint did not run the AST-backed lint suite exactly once"
    rt_exit(1)

val exact_stub_location = _collect_lint_diagnostics_json(
    "/tmp/query_lint_ast_dispatch_stub_location.spl",
    "# decoy: fn ast_stub_probe() -> i64:\nfn ast_stub_probe() -> i64:\n    0\n")
val exact_stub_diagnostics = exact_stub_location.1.join("\n")
if exact_stub_location.0 != 1 or exact_stub_location.1.len() != 1 or not exact_stub_diagnostics.contains("\"code\":\"STUB002\"") or not exact_stub_diagnostics.contains("\"line\":2"):
    print "FAIL: query lint STUB diagnostics must use the exact AST declaration line"
    rt_exit(1)

val allowed = _collect_lint_diagnostics_json(
    "/tmp/query_lint_ast_dispatch_allow.spl",
    "@allow(stub_impl)\nfn allowed_stub() -> i64:\n    0\n")
if allowed.0 != 0 or allowed.1.len() != 0:
    print "FAIL: suppressed AST lint changed the diagnostic count"
    rt_exit(1)

val collection_source = "# decoy: fn collect_values<T>():\nasync fn collect_values<T>():\n    var values = []\n    var i = 0\n    while i < 2:\n        values = values + [i]\n        i = i + 1\n\nasync fn collect_more<T>():\n    var values = []\n    var i = 0\n    while i < 2:\n        values = values + [i]\n        i = i + 1\n"
val collection = _collect_lint_diagnostics_json(
    "/tmp/query_lint_ast_dispatch_collection.spl", collection_source)
val collection_diagnostics = collection.1.join("\n")
if (not collection_diagnostics.contains("\"code\":\"COLL001\"") or
    not collection_diagnostics.contains("\"severity\":2") or
    not collection_diagnostics.contains("\"confidence\":\"source-pattern\"") or
    not collection_diagnostics.contains("\"evidence\":[") or
    not collection_diagnostics.contains("\"uncertainty\":") or
    not collection_diagnostics.contains("\"line\":2") or
    not collection_diagnostics.contains("\"line\":9")):
    print "FAIL: query collection diagnostics lost advisory structured evidence"
    rt_exit(1)

val allowed_collection = _collect_lint_diagnostics_json(
    "/tmp/query_lint_ast_dispatch_collection_allow.spl",
    "@allow(collection_performance)\n" + collection_source)
if allowed_collection.1.join("\n").contains("\"code\":\"COLL001\""):
    print "FAIL: query collection suppression was ignored"
    rt_exit(1)

val robust_collection = _collect_lint_diagnostics_json(
    "/tmp/query_lint_ast_dispatch_collection_robust.spl",
    "@lint_profile(robust)\n" + collection_source)
val robust_collection_diagnostics = robust_collection.1.join("\n")
if (not robust_collection_diagnostics.contains("\"code\":\"COLL001\"") or
    not robust_collection_diagnostics.contains("\"severity\":2")):
    print "FAIL: robust profile promoted untyped query collection evidence"
    rt_exit(1)

var gc_lines: [text] = ["# decoy: use gc_async_mut.task"]
var gc_i = 0
while gc_i < 64:
    gc_lines.push("use common.fixture_{gc_i}")
    gc_i = gc_i + 1
gc_lines.push("use gc_async_mut.task")
val gc_result = _collect_lint_diagnostics_json(
    "src/lib/nogc_sync_mut/query_lint_location_probe.spl",
    gc_lines.join("\n"))
val gc_diagnostics = gc_result.1.join("\n")
if (gc_result.0 != 0 or
    not gc_diagnostics.contains("\"code\":\"gc_boundary_crossing\"") or
    not gc_diagnostics.contains("\"line\":66")):
    print "FAIL: GC-boundary diagnostic lost indexed import location"
    rt_exit(1)

var unused_lines: [text] = ["fn unused_many():"]
var unused_i = 0
while unused_i < 32:
    unused_lines.push("    val unused_{unused_i} = {unused_i}")
    unused_i = unused_i + 1
val unused_result = _collect_lint_diagnostics_json(
    "/tmp/query_lint_unused_cardinality.spl", unused_lines.join("\n"))
val unused_diagnostics = unused_result.1.join("\n")
if (unused_result.0 != 0 or
    not unused_diagnostics.contains("variable 'unused_0' is declared but never used") or
    not unused_diagnostics.contains("variable 'unused_31' is declared but never used") or
    not unused_diagnostics.contains("\"line\":2") or
    not unused_diagnostics.contains("\"line\":33")):
    print "FAIL: UNUSED001 linear index lost high-cardinality diagnostics"
    rt_exit(1)

val malformed = _collect_lint_diagnostics_json(
    "/tmp/query_lint_ast_dispatch_malformed.spl",
    "fn broken(\n")
if malformed.0 != 0 or malformed.1.len() != 0:
    print "FAIL: malformed source leaked partial AST diagnostics"
    rt_exit(1)

print "PASS: query lint runs and governs AST-backed diagnostics"
rt_exit(0)
