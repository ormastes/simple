"""
SPL-BOOL-001: a public bool parameter or return is a primitive_api finding with
its own ID, one per type slot. The all-same-primitive exemption must not swallow
`pub fn f(b: bool) -> bool`. Numeric all-same math helpers stay exempt.
Run: bin/simple test test/01_unit/compiler/lint/primitive_api_bool_spec.spl
"""

use std.spec.*
use compiler.tools.fix.rules.impl_.lint_primitive_api.{primitive_api_findings}

fn _codes(source: text) -> [text]:
    var out: [text] = []
    for f in primitive_api_findings("sample.spl", source.split("\n")):
        out.push("{f.code}:{f.type_path}")
    out

describe "SPL-BOOL-001 public bool":
    it "flags both the bool parameter and bool return once each":
        val codes = _codes("pub fn f(b: bool) -> bool:\n    b\n")
        expect(codes.len()).to_equal(2)
        expect(codes[0]).to_equal("SPL-BOOL-001:f.param.b")
        expect(codes[1]).to_equal("SPL-BOOL-001:f.return")

    it "flags a bool-only return with a text param":
        expect(_codes("pub fn k(a: text) -> bool:\n    true\n").len()).to_equal(1)

    it "keeps numeric all-same math helpers exempt":
        expect(_codes("pub fn add(a: i64, b: i64) -> i64:\n    a + b\n").len()).to_equal(0)

    it "flags a numeric param once under primitive_api":
        val codes = _codes("pub fn g(n: i64) -> text:\n    \"x\"\n")
        expect(codes.len()).to_equal(1)
        expect(codes[0]).to_equal("primitive_api:g.param.n")
