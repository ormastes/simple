"""
## Purpose and audience
Executable spec of the owner decision "requiring a unit for every `text` is too
much" for lint maintainers: a bare text/str/String parameter or return on a
public API gets no primitive_api finding, ranked fix, hint or audit entry,
while a bare numeric primitive is still flagged exactly once.
## Operator workflow
Run: bin/simple test test/01_unit/compiler/lint/primitive_api_text_exempt_spec.spl
## Compatibility and limitations
Single-line `pub fn` heads only, like the text scanner itself.
## Verification guidance and troubleshooting
A failing text case means the rule diverged from the canonical classifier in
compiler.semantics.lint.primitive_types (text family: classified, not flagged).
"""
# @feature: primitive-api-lint
# @manual_section: primitive-api-text-exempt

use std.spec.*
use compiler.tools.fix.rules.impl_.lint_primitive_api.{primitive_api_findings, primitive_api_audit_source}

fn _findings(source: text) -> i64:
    primitive_api_findings("sample.spl", source.split("\n")).len()

describe "primitive_api text exemption":
    """
    text-family APIs are valid shapes; numeric primitives still need a unit.
    """
    it "does not flag a bare text parameter and return":
        # @req REQ-DPOL-006
        # @capture(statistics): finding and audit counts for greet
        step("Scan pub fn greet(name: text) -> text")
        val source = "pub fn greet(name: text) -> text:\n    name\n"
        expect(_findings(source)).to_equal(0)  # oracle: text is classified, not flagged
        expect(primitive_api_audit_source(source, "sample.spl").len()).to_equal(0)  # oracle: no audit hint either

    it "does not flag str or String":
        # @req REQ-DPOL-006
        # @capture(statistics): finding counts for str and String signatures
        step("Scan pub fns using str and String")
        expect(_findings("pub fn a(name: str) -> String:\n    name\n")).to_equal(0)  # oracle: whole text family exempt

    it "still flags a bare numeric parameter":
        # @req REQ-DPOL-006
        # @capture(statistics): finding count for open
        step("Scan pub fn open(port: i64)")
        expect(_findings("pub fn open(port: i64):\n    pass\n")).to_equal(1)  # oracle: numeric primitive unchanged
