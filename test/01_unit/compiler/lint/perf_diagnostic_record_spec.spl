"""
## Purpose and audience
Purpose: Prove structured evidence and uncertainty survive lint formatting.
Audience: lint CLI, LSP, and machine-output maintainers.
"""
# @req: REQ-009, REQ-010

use std.spec.*
use compiler.tools.lint._LintMain.config_and_model.{LintDiag, LintRunResult, LintLevel, LintCategory}

describe "performance diagnostic records":
    it "renders stable evidence and uncertainty without claiming a proven fix":
        step("Report actionable performance and memory diagnostics")
        val lint = LintDiag.new(
            "COLL010", LintLevel.Warn, LintCategory.Warning,
            "repeated linear lookup inside a dynamic loop"
        ).with_fix("consider building an index")
         .with_evidence(["outer=orders.len", "lookup=users.len", "cost=O(orders.len*users.len)"])
         .with_uncertainty("receiver mutation summary unavailable")
        val rendered = LintRunResult.new("fixture.spl", 7, 3, lint).format()
        expect(rendered).to_contain("warning[COLL010]")
        expect(rendered).to_contain("evidence: cost=O(orders.len*users.len)")
        expect(rendered).to_contain("uncertainty: receiver mutation summary unavailable")
        expect(lint.easy_fix).to_be_nil()
