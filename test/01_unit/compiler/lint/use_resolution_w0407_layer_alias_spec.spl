"""
## Purpose and audience
Purpose: Prove that W0407 use resolution maps logical module paths onto the
physical source layout: numbered layer directories, the `compiler.core`
frontend alias and the `std` -> `lib` root. A real import must not be
reported as unresolved, and a missing one must still be reported.
Audience: compiler lint maintainers.
"""
# @req: REQ-COMPILER-LINT-W0407-005

use std.spec.*
use compiler.core.ast.{ast_reset, decl_use_import}
use compiler.semantics.lint.use_resolution.{check_use_resolution}

fn probe_file_path() -> text:
    "src/compiler/35.semantics/lint/use_resolution.spl"

fn warnings_for(module_path: text) -> i64:
    ast_reset()
    val d = decl_use_import(module_path, [], 0)
    check_use_resolution([d], probe_file_path(), "critical").len()

describe "W0407 resolves logical module paths onto the layered tree":
    it "resolves the compiler.core alias of the frontend core layer":
        step("Lint `use compiler.core.ast`, stored in compiler/10.frontend/core/ast.spl")
        expect(warnings_for("compiler.core.ast")).to_equal(0)

    it "resolves a std module through the lib root":
        step("Lint `use std.nogc_sync_mut.io_runtime`, stored in lib/nogc_sync_mut/io_runtime.spl")
        expect(warnings_for("std.nogc_sync_mut.io_runtime")).to_equal(0)

    it "still reports a missing module under a resolved layer":
        step("Lint a module that does not exist under the resolved frontend core layer")
        expect(warnings_for("compiler.core.zzz_nope")).to_equal(1)
