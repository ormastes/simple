"""
SPL-TEXT-001 (owner decision 2026-11-19): EVERY public text param/return/field is
flagged once as a warning. A name that reads as a semantic domain (url, uri, path,
host, hostname, sql, query, html, digest, hash, token, secret, password, key, cmd,
command; also `<x>_<domain>`) adds the domain type to the help.
Run: bin/simple test test/01_unit/compiler/lint/primitive_api_text_domain_spec.spl
"""

use std.spec.*
use compiler.tools.fix.rules.impl_.lint_primitive_api.{primitive_api_findings, primitive_api_fix_hint}

fn _scan(source: text) -> [text]:
    var out: [text] = []
    for f in primitive_api_findings("sample.spl", source.split("\n")):
        out.push("{f.code}:{f.type_path}")
    out

describe "SPL-TEXT-001 domain-named public text":
    it "flags a url parameter":
        val got = _scan("pub fn fetch(url: text):\n    pass\n")
        expect(got.len()).to_equal(1)
        expect(got[0]).to_equal("SPL-TEXT-001:fetch.param.url")

    it "flags a suffixed domain name and a domain-named return":
        expect(_scan("pub fn open(file_path: text):\n    pass\n").len()).to_equal(1)
        val got = _scan("pub fn digest() -> text:\n    \"\"\n")
        expect(got.len()).to_equal(1)
        expect(got[0]).to_equal("SPL-TEXT-001:digest.return")

    it "names the domain type in the help":
        val fs = primitive_api_findings("sample.spl", "pub fn f(host: text):\n    pass\n".split("\n"))
        expect(primitive_api_fix_hint(fs[0]).contains("HostName")).to_equal(true)

    it "flags ordinary text too, without a domain hint":
        val got = _scan("pub fn greet(name: text) -> text:\n    name\n")
        expect(got.len()).to_equal(2)
        expect(got[0]).to_equal("SPL-TEXT-001:greet.param.name")
        expect(got[1]).to_equal("SPL-TEXT-001:greet.return")
        val fs = primitive_api_findings("sample.spl", "pub fn f(keyboard: text):\n    pass\n".split("\n"))
        expect(primitive_api_fix_hint(fs[0]).contains("must carry a domain")).to_equal(true)
        expect(_scan("pub fn a(name: str) -> String:\n    name\n").len()).to_equal(2)

    it "flags public text fields only":
        val src = "pub struct Rec:\n    pub file: text\n    pub n: i64\n    hidden: text\n    pub fn name():\n        pass\n"
        val got = _scan(src)
        expect(got.len()).to_equal(1)
        expect(got[0]).to_equal("SPL-TEXT-001:Rec.field.file")

    it "does not flag public text fields outside a struct or class":
        expect(_scan("fn f():\n    pub x: text\n").len()).to_equal(0)

    it "honours @allow(primitive_api)":
        expect(_scan("@allow(primitive_api)\npub fn f(url: text):\n    pass\n").len()).to_equal(0)
