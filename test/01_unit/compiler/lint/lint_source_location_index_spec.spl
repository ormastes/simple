"""
## Purpose and audience
Purpose: Pin single-pass fallback source-location indexing for lint diagnostics.
Audience: lint and compiler-tool maintainers.
"""
# @req: REQ-007, REQ-017

use std.spec.*
use compiler.tools.lint.main.{
    lint_source_location_index, lint_source_function_line,
    lint_source_collection_fix_line
}

describe "lint fallback source location index":
    it "indexes ordinary generic and async function declarations in one view":
        step("Index lint fallback source locations")
        val index = lint_source_location_index([
            "# fn decoy()",
            "fn first():",
            "pub async fn fetch<T>(value: T):",
            "static fn final():"
        ])
        expect(lint_source_function_line(index, "first")).to_equal(2)
        expect(lint_source_function_line(index, "fetch")).to_equal(3)
        expect(lint_source_function_line(index, "final")).to_equal(4)
        expect(lint_source_function_line(index, "missing")).to_equal(0)

    it "retains only a file-unique machine-fix location":
        step("Reject ambiguous lint fix locations")
        val unique = lint_source_location_index([
            "fn append_one():",
            "    items = items + [value]"
        ])
        expect(lint_source_collection_fix_line(unique, "COLL001")).to_equal(1)
        val duplicate = lint_source_location_index([
            "items = items + [first]",
            "items = items + [second]"
        ])
        expect(lint_source_collection_fix_line(duplicate, "COLL001")).to_equal(-1)
