"""
SPL-TEXT-001 severity split: public text that is not domain-named is the
`bare_text` lint and is warn in EVERY profile. Domain-named text keeps the
`bare_text_domain` lint, which stays deny in robust/critical.
Run: bin/simple test test/01_unit/compiler/lint/primitive_api_text_severity_spec.spl
"""

use std.spec.*
use compiler.tools.lint.main.{LintProfile, profile_default_levels, Linter}

fn _text_lint_codes(source: text) -> [text]:
    var out: [text] = []
    var linter = Linter.new()
    for r in linter.lint_source("sample.spl", source):
        if r.lint.code == "bare_text" or r.lint.code == "bare_text_domain":
            out.push(r.lint.code)
    out

describe "SPL-TEXT-001 severity by profile":
    it "keeps ordinary public text at warn in every profile":
        # @req REQ-DPOL-006
        expect(profile_default_levels(LintProfile.Moderate)["bare_text"]).to_equal("warn")
        expect(profile_default_levels(LintProfile.Strict)["bare_text"]).to_equal("warn")
        expect(profile_default_levels(LintProfile.Robust)["bare_text"]).to_equal("warn")
        expect(profile_default_levels(LintProfile.Critical)["bare_text"]).to_equal("warn")

    it "keeps domain-named text at deny in robust and critical":
        # @req REQ-DPOL-006
        expect(profile_default_levels(LintProfile.Robust)["bare_text_domain"]).to_equal("deny")
        expect(profile_default_levels(LintProfile.Critical)["bare_text_domain"]).to_equal("deny")
        expect(profile_default_levels(LintProfile.Moderate)["bare_text_domain"]).to_not_equal("deny")

describe "SPL-TEXT-001 lint routing":
    it "routes plain public text to bare_text":
        # @req REQ-DPOL-006
        expect(_text_lint_codes("pub fn greet(name: text):\n    pass\n")).to_equal(["bare_text"])

    it "routes domain-named public text to bare_text_domain":
        # @req REQ-DPOL-006
        expect(_text_lint_codes("pub fn fetch(url: text):\n    pass\n")).to_equal(["bare_text_domain"])
