# OPTME001 Lint Specification
#
# Locks the measured idiom table from
# doc/08_tracking/bug/me_method_mutation_through_optional_binding_discarded_2026-08-04.md
# into an executable contract: every idiom that PROVABLY discards the mutation
# must warn, and every idiom that provably writes back must stay silent.
#
# The two families differ by a handful of characters and read identically, so
# a regression in either direction is invisible without this spec.

use std.spec.*
use compiler.semantics.lint.option_me_call.{
    OptionMeCallWarning,
    check_option_me_call_source
}

fn _optme_join(lines: [text]) -> text:
    var out = ""
    for l in lines:
        out = out + l + "\n"
    out

fn _optme_backend_decl() -> [text]:
    """A class with one mutating `me` method and one read-only `fn`."""
    [
        "class Backend:",
        "    var n: i64 = 0",
        "    me bump():",
        "        self.n = self.n + 1",
        "    fn peek() -> i64:",
        "        self.n",
        ""
    ]

fn _optme_source(body: [text]) -> text:
    var lines = _optme_backend_decl()
    for l in body:
        lines.push(l)
    _optme_join(lines)

fn _optme_check(body: [text]) -> [OptionMeCallWarning]:
    check_option_me_call_source("src/app/probe/engine.spl", _optme_source(body))


describe "OPTME001: mutating `me` call through an option-typed receiver":
    """
    ## Silent loss of a `me` mutation

    A `me` method invoked on a binding whose static type is `T?` mutates a
    temporary unwrap that is discarded. The rule flags exactly that shape.
    """

    context "when the receiver is an option-typed alias (BROKEN)":
        """
        ### Scenario: `val`/`var` alias of a `T?` field

        Measured arms A/G/H: the mutation is lost, and re-storing the alias
        afterwards does not rescue it.
        """

        it "flags a `val` alias chained off an optional field":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        val b = active",
                "        b.bump()"
            ])
            expect(warnings.len()).to_equal(1)
            expect(warnings[0].code).to_equal("OPTME001")
            expect(warnings[0].severity).to_equal("WARNING")
            expect(warnings[0].binding).to_equal("b")
            expect(warnings[0].class_name).to_equal("Backend")
            expect(warnings[0].method).to_equal("bump")
            expect(warnings[0].line_num).to_equal(13)

        it "flags a `var` alias — `var` is no safer than `val`":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        var active = self.backend",
                "        active.bump()"
            ])
            expect(warnings.len()).to_equal(1)
            expect(warnings[0].binding).to_equal("active")

        it "flags an explicitly annotated `Backend?` local":
            val warnings = _optme_check([
                "fn drive(src: Backend?):",
                "    val active: Backend? = src",
                "    active.bump()"
            ])
            expect(warnings.len()).to_equal(1)
            expect(warnings[0].class_name).to_equal("Backend")

        it "flags every lost call when the alias is never re-stored":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        active.bump()",
                "        active.bump()"
            ])
            expect(warnings.len()).to_equal(2)

        it "flags a `me fn` declared method too":
            val source = _optme_join([
                "class Backend:",
                "    var n: i64 = 0",
                "    me fn bump():",
                "        self.n = self.n + 1",
                "",
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        active.bump()"
            ])
            val warnings = check_option_me_call_source("src/app/probe/e.spl", source)
            expect(warnings.len()).to_equal(1)

    context "when the option is only TESTED, not unwrapped (BROKEN)":
        """
        ### Scenario: `!= nil` and `.?`

        Measured arms K/L: a nil-test and an exists-check narrow nothing —
        the receiver's static type is still `T?` inside the branch.
        """

        it "flags a call guarded by `!= nil`":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        if active != nil:",
                "            active.bump()"
            ])
            expect(warnings.len()).to_equal(1)
            expect(warnings[0].method).to_equal("bump")

        it "flags a call guarded by an `.?` exists-check":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        if active.?:",
                "            active.bump()"
            ])
            expect(warnings.len()).to_equal(1)

    context "when the option is genuinely unwrapped (SAFE)":
        """
        ### Scenario: `.?`, `?` and `if val Some(x) =`

        Measured arms B/D/E/F/I/J: these all write back correctly and must
        never be flagged — a false positive here would push authors away from
        the only correct form.
        """

        it "stays silent on a `.?` explicit unwrap":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend.?",
                "        active.bump()"
            ])
            expect(warnings.len()).to_equal(0)

        it "stays silent on a `.?` unwrap of an already-optional local":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val opt = self.backend",
                "        val active = opt.?",
                "        active.bump()"
            ])
            expect(warnings.len()).to_equal(0)

        it "stays silent on a `?` try-operator unwrap of a `T?`-returning call":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    fn pick() -> Backend?:",
                "        self.backend",
                "    me flush():",
                "        val active = self.pick()?",
                "        active.bump()"
            ])
            expect(warnings.len()).to_equal(0)

        it "stays silent on `if val Some(x) =` — the correct form":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        if val Some(active) = self.backend:",
                "            active.bump()",
                "            self.backend = Some(active)"
            ])
            expect(warnings.len()).to_equal(0)

    context "when the receiver is not an option or the method does not mutate":
        """
        ### Scenario: the rule's two necessary conditions

        The defect needs BOTH an option-typed receiver AND a `me` declaration.
        Dropping either must silence the rule.
        """

        it "stays silent on a non-optional field of the same class":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    var solo: Backend = Backend()",
                "    me flush():",
                "        val s = self.solo",
                "        s.bump()"
            ])
            expect(warnings.len()).to_equal(0)

        it "stays silent on a read-only `fn` invoked through the option":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        active.peek()"
            ])
            expect(warnings.len()).to_equal(0)

        it "stays silent when the method name belongs to a different class":
            val source = _optme_join([
                "class Backend:",
                "    var n: i64 = 0",
                "    fn bump():",
                "        self.n",
                "",
                "class Other:",
                "    var n: i64 = 0",
                "    me bump():",
                "        self.n = self.n + 1",
                "",
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        active.bump()"
            ])
            val warnings = check_option_me_call_source("src/app/probe/e.spl", source)
            expect(warnings.len()).to_equal(0)

    context "message contract":
        """
        ### Scenario: the warning must name the fix

        The two idioms differ by six characters; a message that does not spell
        out the destructure is not actionable.
        """

        it "names the method, the option type and the destructure fix":
            val warnings = _optme_check([
                "class Engine:",
                "    var backend: Backend? = nil",
                "    me flush():",
                "        val active = self.backend",
                "        active.bump()"
            ])
            expect(warnings.len()).to_equal(1)
            expect(warnings[0].message.contains("`bump`")).to_equal(true)
            expect(warnings[0].message.contains("Backend?")).to_equal(true)
            expect(warnings[0].message.contains("discarded temporary")).to_equal(true)
            expect(warnings[0].hint.contains("if val Some(active) =")).to_equal(true)
