use std.io.{file_read}

describe "lint checks primitive and EasyFix boundaries":
    it "imports concrete owners and uses concrete primitive annotations":
        val source = file_read("src/compiler/90.tools/lint/_LintMain/lint_checks.spl")
        val facade = file_read("src/compiler/90.tools/lint/main.spl")

        expect(source.contains("use compiler.tools.lint.main.*")).to_equal(false)
        expect(source).to_contain("use compiler.tools.lint._LintMain.config_and_model.{")
        expect(source).to_contain("easyfix_id, easyfix_description, easyfix_replacements")
        expect(source).to_contain("line_num: i64")
        expect(source).to_contain("fn required_comment_is_weak(text_value: String) -> bool:")
        expect(source).to_contain("fn is_pascal_case(name: String) -> bool:")
        expect(source.contains("-> Bool")).to_equal(false)
        expect(source.contains(": Int")).to_equal(false)
        expect(facade).to_contain("export use compiler.tools.lint._LintMain.lint_checks.*")
