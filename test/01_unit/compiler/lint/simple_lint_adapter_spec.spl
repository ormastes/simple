use compiler.tools.lint.main.{simple_lint_adapter_result, simple_lint_human_summary}
use common.lint_kernel.model.{LintVerdict}

describe "Simple lint KPF compatibility adapter":
    it "does not render a warning-only run as clean":
        val result = simple_lint_adapter_result(1, 1, 0, 4, 4, 1, 0, 1)
        assert_equal(result.kernel_result.verdict, LintVerdict.CompleteWithFindings)
        assert_true(not simple_lint_human_summary(result.kernel_result).contains("all files clean"))

    it "reports parse failure as not analyzed":
        val result = simple_lint_adapter_result(1, 0, 1, 4, 0, 1, 1, 0)
        assert_equal(result.kernel_result.verdict, LintVerdict.NotAnalyzed)
        assert_equal(result.exit_code, 1)

    it "rejects vacuous zero-input success":
        val result = simple_lint_adapter_result(0, 0, 0, 4, 0, 0, 0, 0)
        assert_true(result.kernel_result.verdict != LintVerdict.CompleteClean)
        assert_equal(result.exit_code, 1)

    it "renders a complete finding-free run as clean":
        val result = simple_lint_adapter_result(1, 1, 0, 4, 4, 0, 0, 0)
        assert_equal(result.kernel_result.verdict, LintVerdict.CompleteClean)
        assert_true(simple_lint_human_summary(result.kernel_result).contains("all files clean"))

    it "fails closed when not-analyzed units exceed requested units":
        val result = simple_lint_adapter_result(1, 0, 2, 4, 0, 0, 0, 0)
        assert_equal(result.kernel_result.verdict, LintVerdict.Failed)
        assert_equal(result.kernel_result.coverage.admitted_unit_count, 0)
        assert_equal(result.exit_code, 1)

    it "fails closed when completed units exceed requested units":
        val result = simple_lint_adapter_result(1, 2, 0, 4, 4, 0, 0, 0)
        assert_equal(result.kernel_result.verdict, LintVerdict.Failed)
        assert_equal(result.kernel_result.coverage.partial_unit_count, 0)
        assert_equal(result.exit_code, 1)

    it "fails closed when completed rules exceed requested rules":
        val result = simple_lint_adapter_result(1, 1, 0, 4, 5, 0, 0, 0)
        assert_equal(result.kernel_result.verdict, LintVerdict.Failed)
        assert_equal(result.kernel_result.coverage.skipped_rule_count, 0)
        assert_equal(result.exit_code, 1)
