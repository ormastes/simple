# @feature: compiler-performance-memory-efficiency
# @req: REQ-011

use std.spec.*
use app.cli.query_lint_checks.{_check_match_exhaustiveness_text}
use app.cli.query_rich_common.{_DIAG_COLLECT_MODE, _DIAG_COLLECTED}
use compiler.core.ast.{ast_reset, arm_new}
use compiler.core.ast_expr.{expr_ident}
use compiler.semantics.lint.match_exhaustiveness.{analyze_match}

fn _mexh_query(lines: [text]) -> [text]:
    _DIAG_COLLECT_MODE = true
    _DIAG_COLLECTED = []
    val count = _check_match_exhaustiveness_text(lines, "fixture.spl", "json")
    val result = _DIAG_COLLECTED
    _DIAG_COLLECTED = []
    _DIAG_COLLECT_MODE = false
    expect(count).to_equal(result.len())
    result

fn _mexh_arm(name: text) -> i64:
    arm_new(expr_ident(name, 0), -1, [])

describe "MEXH004 one diagnostic per unreachable arm":
    it "deduplicates query diagnostics after a wildcard in source order":
        val diagnostics = _mexh_query([
            "match value:",
            "    case _: 0",
            "    case _: 1",
            "    case value: 2",
            "    case value: 3"
        ])
        expect(diagnostics.len()).to_equal(3)
        expect(diagnostics[0]).to_contain("duplicate wildcard")
        expect(diagnostics[0]).to_contain("\"line\":3")
        expect(diagnostics[1]).to_contain("after wildcard")
        expect(diagnostics[1]).to_contain("\"line\":4")
        expect(diagnostics[2]).to_contain("after wildcard")
        expect(diagnostics[2]).to_contain("\"line\":5")

    it "retains one pre-wildcard duplicate-pattern diagnostic":
        val diagnostics = _mexh_query([
            "match value:",
            "    case value: 0",
            "    case value: 1",
            "    case _: 2"
        ])
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("duplicate pattern 'value'")
        expect(diagnostics[0]).to_contain("\"line\":3")

    it "does not classify a multiline wildcard body as another arm":
        val diagnostics = _mexh_query([
            "match value:",
            "    case _:",
            "        do_work()"
        ])
        expect(diagnostics.len()).to_equal(0)

    it "reports only the later sibling after a multiline wildcard body":
        val diagnostics = _mexh_query([
            "match value:",
            "    case _:",
            "        do_work()",
            "    case value: 1"
        ])
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("after wildcard")
        expect(diagnostics[0]).to_contain("\"line\":4")

    it "does not treat a nested case as an outer sibling arm":
        val diagnostics = _mexh_query([
            "match value:",
            "    case _:",
            "        case nested: 1"
        ])
        expect(diagnostics.len()).to_equal(0)

    it "emits the indented arm token span":
        val diagnostics = _mexh_query([
            "match value:",
            "    case _: 0",
            "    case _: 1"
        ])
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("\"col\":5")
        expect(diagnostics[0]).to_contain("\"end_col\":13")

    it "emits the indented match token span for missing default":
        val diagnostics = _mexh_query([
            "    match value:",
            "        case value: 1"
        ])
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("\"code\":\"MEXH002\"")
        expect(diagnostics[0]).to_contain("\"col\":5")
        expect(diagnostics[0]).to_contain("\"end_col\":16")

    it "keeps semantic MEXH004 precedence aligned with query lint":
        ast_reset()
        val warnings = analyze_match(-1, [
            _mexh_arm("_"),
            _mexh_arm("_"),
            _mexh_arm("value"),
            _mexh_arm("value")
        ], "fixture", {})
        expect(warnings.len()).to_equal(3)
        expect(warnings[0].message).to_contain("duplicate wildcard")
        expect(warnings[1].message).to_contain("after wildcard")
        expect(warnings[2].message).to_contain("after wildcard")

    it "keeps semantic duplicate-pattern reporting before a wildcard":
        ast_reset()
        val warnings = analyze_match(-1, [
            _mexh_arm("value"),
            _mexh_arm("value"),
            _mexh_arm("_")
        ], "fixture", {})
        expect(warnings.len()).to_equal(1)
        expect(warnings[0].message).to_contain("duplicate pattern 'value'")
