"""
One primitive_api finding per type slot: the quick scanner and the semantic
MC-API-001 pass spell the same slot differently; api_slot_key_of_message maps
both to "<fn>.param.<name>" / "<fn>.return" so the lint driver keeps one owner.
Run: bin/simple test test/01_unit/compiler/lint/primitive_api_slot_dedupe_spec.spl
"""

use std.spec.*
use compiler.tools.lint._LintMain.entry_and_fixes.{api_slot_key_of_message}

describe "primitive_api slot key":
    it "matches quick and semantic spellings of a parameter":
        val quick = api_slot_key_of_message("public API parameter 'n' of 'g' uses bare primitive type 'i64'")
        val sem = api_slot_key_of_message("MC-API-001: public API param 'n' of 'g' exposes bare primitive 'i64' (declared 'i64')")
        expect(quick).to_equal("g.param.n")
        expect(sem).to_equal("g.param.n")

    it "matches quick and semantic spellings of a return":
        val quick = api_slot_key_of_message("SPL-BOOL-001: public API return type of 'f' uses bare primitive type 'bool'")
        val sem = api_slot_key_of_message("MC-API-001: public API return of 'f' exposes bare primitive 'i64' (declared 'i64')")
        expect(quick).to_equal("f.return")
        expect(sem).to_equal("f.return")

    it "keeps a param and a return of one fn distinct":
        val a = api_slot_key_of_message("public API parameter 'b' of 'f' uses bare primitive type 'bool'")
        val b = api_slot_key_of_message("public API return type of 'f' uses bare primitive type 'bool'")
        expect(a == b).to_equal(false)

    it "returns empty for unrelated messages":
        expect(api_slot_key_of_message("trivial string return")).to_equal("")
