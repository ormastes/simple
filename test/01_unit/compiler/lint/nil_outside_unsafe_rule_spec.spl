# @req REQ-SSPEC-COMPILER
"""
# `nil` is allowed only inside `unsafe`

Safe code spells absence `None` (Option). The NIL-UNSAFE-001 lint flags a
`nil` literal outside an `unsafe:` / `danger:` block. It skips comments,
strings and docstrings, and a name that merely contains `nil`.
"""

# @tag: unit, compiler, lint

use std.spec.*
use compiler.tools.lint.static_rules.{LintParamsV1, LintUnit, StaticLintFinding, static_lint_rule_table, run_static_lint_rule_table}
use compiler.tools.lint.rules.nil_outside_unsafe_rule.{nil_outside_unsafe_lint_rule}

fn nil_findings(src: text) -> [StaticLintFinding]:
    val run = run_static_lint_rule_table(LintParamsV1.defaults(), LintUnit("fixture.spl", src), [nil_outside_unsafe_lint_rule()])
    run.findings

describe "nil_outside_unsafe lint":
    it "flags nil in safe code and suggests None":
        val found = nil_findings("fn f() -> i64?:\n    nil\n")
        expect(found.len()).to_equal(1)
        expect(found[0].code).to_equal("NIL-UNSAFE-001")
        expect(found[0].line_num).to_equal(2)
        expect(found[0].hint.contains("None")).to_equal(true)

    it "accepts nil inside an unsafe or danger block":
        expect(nil_findings("fn f() -> i64?:\n    unsafe:\n        nil\n").len()).to_equal(0)
        expect(nil_findings("fn f():\n    danger(reason: \"ffi\"):\n        val p = nil\n").len()).to_equal(0)

    it "flags nil again after the unsafe block ends":
        val found = nil_findings("fn f():\n    unsafe:\n        val a = nil\n    val b = nil\n")
        expect(found.len()).to_equal(1)
        expect(found[0].line_num).to_equal(4)

    it "accepts None and ignores comments, strings, docstrings and names":
        expect(nil_findings("fn f() -> i64?:\n    None\n").len()).to_equal(0)
        expect(nil_findings("fn f():\n    # nil here is prose\n    print \"nil\"\n    val nil_count = 0\n").len()).to_equal(0)
        expect(nil_findings("fn f():\n    \"\"\"Returns nil\n    when absent.\"\"\"\n    None\n").len()).to_equal(0)

    it "reports the column and handles one-line strings and inline unsafe":
        val found = nil_findings("fn f():\n    val a = nil\n")
        expect(found[0].column).to_equal(13)
        expect(nil_findings("fn f():\n    val s = \"\"\"doc\"\"\"; val a = nil\n").len()).to_equal(1)
        expect(nil_findings("fn f():\n    val p = unsafe: nil\n").len()).to_equal(0)
        expect(nil_findings("fn f():\n    val q = nil; val p = unsafe: nil\n").len()).to_equal(1)

    it "leaves presence tests alone (None and nil differ natively)":
        expect(nil_findings("fn f(x: i64?) -> bool:\n    x != nil\n").len()).to_equal(0)
        expect(nil_findings("fn f(x: i64?) -> bool:\n    nil == x\n").len()).to_equal(0)
        expect(nil_findings("fn f(x: i64?) -> i64:\n    match x:\n        case nil: 0\n        case _: 1\n").len()).to_equal(0)

    it "is registered in the static lint table":
        expect([r.id() for r in static_lint_rule_table()]).to_contain("nil_outside_unsafe")
