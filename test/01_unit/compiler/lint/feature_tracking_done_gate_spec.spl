"""
## Purpose and audience
Purpose: Prove that feature tracking done gate lint.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-COMPILER-LINT-001
doc/01_research/local/REQ-COMPILER-LINT-001.md
doc/03_plan/sys_test/REQ-COMPILER-LINT-001.md
doc/04_architecture/REQ-COMPILER-LINT-001.md
doc/05_design/REQ-COMPILER-LINT-001.md
"""
# @req: REQ-COMPILER-LINT-001

"""
Feature tracking done-gate lint coverage.
"""

use compiler.tools.lint.main.{Linter, LintLevel}

fn feature_tracking_header() -> text:
    "features |id, group, device, component, title, description, status, priority, source_file, requirement, research, plan, architecture, design, system_spec, spec_doc, implementation, unit_tests, integration_tests, guide, external_system, external_id, external_url, last_synced_at, created_at, updated_at, valid|\n"

fn count_feature_tracking_lint(source: text, code: text) -> i64:
    var linter = Linter.new()
    val results = linter.lint_source("doc/08_tracking/feature/feature_db.sdn", source)
    var count = 0
    for result in results:
        if result.lint.code == code:
            count = count + 1
    count

fn count_feature_tracking_lint_with_level(source: text, code: text, level: LintLevel) -> i64:
    var linter = Linter.new()
    val results = linter.lint_source("doc/08_tracking/feature/feature_db.sdn", source)
    var count = 0
    for result in results:
        if result.lint.code == code and result.lint.level == level:
            count = count + 1
    count

fn first_feature_tracking_lint_message(source: text, code: text) -> text:
    var linter = Linter.new()
    val results = linter.lint_source("doc/08_tracking/feature/feature_db.sdn", source)
    for result in results:
        if result.lint.code == code:
            return result.lint.message
    ""

use std.spec.step

describe "feature tracking done gate lint":
    """Verifies traceability enforcement for canonical feature_db.sdn rows."""

    it "flags done feature rows missing traceability evidence":
        # @req: REQ-COMPILER-LINT-001
        step("Verify: flags done feature rows missing traceability evidence")
        val source = feature_tracking_header() +
            "    \"FR-TRACK-001\",core,device,component,\"Done bad\",\"Missing evidence\",done,P1,doc/08_tracking/feature/source.md,none,none,none,none,none,none,none,none,none,none,none,none,none,none,2026-06-04,2026-06-04,2026-06-04,true\n"

        expect(count_feature_tracking_lint(source, "TRK001")).to_equal(1)
        expect(count_feature_tracking_lint_with_level(source, "TRK001", LintLevel.Deny)).to_equal(1)

    it "flags done feature rows missing unit, integration, and guide evidence":
        # @req: REQ-COMPILER-LINT-001
        step("Verify: flags done feature rows missing unit, integration, and guide evidence")
        val source = feature_tracking_header() +
            "    \"FR-TRACK-005\",core,device,component,\"Done without tests\",\"Missing final evidence\",done,P1,doc/08_tracking/feature/source.md,doc/02_requirements/feature/good.md,doc/01_research/local/good.md,doc/03_plan/good.md,doc/04_architecture/good.md,doc/05_design/good.md,test/03_system/app/good_spec.spl,doc/06_spec/system/app/good_spec.md,src/app/good/main.spl,none,none,none,github,123,https://example.invalid/123,2026-06-04,2026-06-04,2026-06-04,true\n"

        expect(count_feature_tracking_lint(source, "TRK001")).to_equal(1)

    it "preserves quoted commas and doubled quotes in tracking rows":
        # @req: REQ-COMPILER-LINT-001
        step("Verify: preserves quoted commas and doubled quotes in tracking rows")
        val source = feature_tracking_header() +
            "    \"FR-\"\"TRACK\"\",006\",core,device,component,\"Done, quoted\",\"Owner said \"\"ship it\"\"\",done,P1,doc/08_tracking/feature/source.md,none,none,none,none,none,none,none,none,none,none,none,github,123,https://example.invalid/123,2026-06-04,2026-06-04,2026-06-04,true\n"

        expect(count_feature_tracking_lint(source, "TRK001")).to_equal(1)
        expect(count_feature_tracking_lint_with_level(
            source, "TRK001", LintLevel.Deny)).to_equal(1)
        expect(first_feature_tracking_lint_message(source, "TRK001")).to_equal(
            "Done feature 'FR-\"TRACK\",006' missing required traceability fields: requirement, research, plan, architecture, design, system_spec, spec_doc, implementation, unit_tests, integration_tests, guide")

    it "accepts done feature rows with complete traceability evidence":
        # @req: REQ-COMPILER-LINT-001
        step("Verify: accepts done feature rows with complete traceability evidence")
        val source = feature_tracking_header() +
            "    \"FR-TRACK-002\",core,device,component,\"Done good\",\"Complete evidence\",done,P1,doc/08_tracking/feature/source.md,doc/02_requirements/feature/good.md,doc/01_research/local/good.md,doc/03_plan/good.md,doc/04_architecture/good.md,doc/05_design/good.md,test/03_system/app/good_spec.spl,doc/06_spec/system/app/good_spec.md,src/app/good/main.spl,test/01_unit/app/good_spec.spl,test/02_integration/app/good_spec.spl,doc/07_guide/app/good.md,github,123,https://example.invalid/123,2026-06-04,2026-06-04,2026-06-04,true\n"

        expect(count_feature_tracking_lint(source, "TRK001")).to_equal(0)

    it "does not require traceability evidence for requested feature rows":
        # @req: REQ-COMPILER-LINT-001
        step("Verify: does not require traceability evidence for requested feature rows")
        val source = feature_tracking_header() +
            "    \"FR-TRACK-003\",core,device,component,\"Requested\",\"Not complete\",request,P2,doc/08_tracking/feature/source.md,none,none,none,none,none,none,none,none,none,none,none,none,none,none,2026-06-04,2026-06-04,2026-06-04,true\n"

        expect(count_feature_tracking_lint(source, "TRK001")).to_equal(0)

    it "ignores invalid done rows":
        # @req: REQ-COMPILER-LINT-001
        step("Verify: ignores invalid done rows")
        val source = feature_tracking_header() +
            "    \"FR-TRACK-004\",core,device,component,\"Invalid done\",\"Superseded\",done,P2,doc/08_tracking/feature/source.md,none,none,none,none,none,none,none,none,none,none,none,none,none,none,2026-06-04,2026-06-04,2026-06-04,false\n"

        expect(count_feature_tracking_lint(source, "TRK001")).to_equal(0)
