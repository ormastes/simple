"""
## Purpose and audience
Purpose: Prove that DCA001: acquisition outside @init_phase, severity by mode.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINT-001 — stable requirement identity for this spec.

# Dynamic Capability Acquisition Lint Specification
#
# Covers DCA001 (capability-group acquisition outside an `@init_phase`
# function) across the three configured modes, and DCA002 (critical mode
# requires a manifest-pinned gpu.backend).
#
# The acquisition call under test is the one the trait-group desugar generates:
# `trait G with A, B:` produces `fn G__from(src) -> Option<G>`, spelled either
# `G__from(src)` or `G.from(src)` at the call site.

use std.spec.*
use compiler.semantics.lint.dynamic_capability_acquire.{
    DynCapAcquireFinding,
    check_dynamic_capability_acquire,
    check_gpu_backend_pin,
    dca_mode_is_valid,
    dca_backend_is_pinned,
    dca_file_is_init_phase
}

# ============================================================================
# Test Group 1: DCA001 severity follows `critical.dynamic_acquire`
# ============================================================================

describe "DCA001: acquisition outside @init_phase, severity by mode":
    """
    ## Warning now, error later

    The same source produces no diagnostic under `allow`, a WARNING under
    `warn`, and an ERROR under `error`. Promoting the lint is a config change,
    not a code change.
    """

    context "when a group is acquired in an ordinary function":
        """
        ### Scenario: `.from()` in a control-loop function

        `render_frame` is not marked `@init_phase`, so acquiring the capability
        there is a mid-flight acquisition with no safe failure path.
        """

        it "is silent under mode `allow`":
            step("Verify: is silent under mode `allow`")
            # @req: REQ-COMPILER-LINT-001
            val source = "fn render_frame(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "allow")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "reports a WARNING under mode `warn`":
            step("Verify: reports a WARNING under mode `warn`")
            val source = "fn render_frame(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].code).to_equal("DCA001")
            expect(findings[0].severity).to_equal("WARNING")
            expect(findings[0].name).to_equal("GpuCaps")
            expect(findings[0].line_num).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "reports an ERROR under mode `error`":
            step("Verify: reports an ERROR under mode `error`")
            val source = "fn render_frame(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "error")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].code).to_equal("DCA001")
            expect(findings[0].severity).to_equal("ERROR")

        it "names the call site and the manifest alternative in the note":
            step("Verify: names the call site and the manifest alternative in the note")
            val source = "fn render_frame(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].note.contains("src/app/render.spl:2")).to_be_true()
            expect(findings[0].note.contains("manifest")).to_be_true()

    context "when the generated static is called directly":
        """
        ### Scenario: `G__from(src)` spelling

        The desugar emits `fn G__from(src) -> Option<G>`; calling it by its
        generated name must be flagged exactly like the `.from()` spelling.
        """

        it "detects the G__from(...) spelling":
            step("Verify: detects the G__from(...) spelling")
            val source = "fn tick(src: Host):\n    val g = GpuCaps__from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/tick.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].name).to_equal("GpuCaps")

    context "when the per-backend interim helper is used":
        """
        ### Scenario: `<backend>_debug_profiler(session)`

        Until P0's desugar emits the single-accessor `.from()`, each backend
        supplies `<backend>_debug_profiler(session) -> Option<DebugProfiler>`
        (P2 landed `ref_debug_profiler`). It acquires the SINGLE value carrying
        both capabilities, so it is an acquisition site like any other.
        """

        it "flags ref_debug_profiler(...) outside @init_phase":
            step("Verify: flags ref_debug_profiler(...) outside @init_phase")
            val source = "fn tick(s: RefDebugSession):\n    val dp = ref_debug_profiler(s)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/tick.spl", [], "warn")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].code).to_equal("DCA001")
            expect(findings[0].name).to_equal("ref_debug_profiler")

        it "flags it even when a group_names list is supplied that omits it":
            step("Verify: flags it even when a group_names list is supplied that omits it")
            val source = "fn tick(s: RefDebugSession):\n    val dp = ref_debug_profiler(s)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/tick.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].name).to_equal("ref_debug_profiler")

        it "is clean inside an @init_phase function":
            step("Verify: is clean inside an @init_phase function")
            val source = "@init_phase\nfn boot(s: RefDebugSession):\n    val dp = ref_debug_profiler(s)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/boot.spl", [], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "is silent under mode `allow`":
            step("Verify: is silent under mode `allow`")
            val source = "fn tick(s: RefDebugSession):\n    val dp = ref_debug_profiler(s)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/tick.spl", [], "allow")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "does not flag the helper's own declaration":
            step("Verify: does not flag the helper's own declaration")
            val source = "pub fn ref_debug_profiler(s: RefDebugSession) -> Option<DebugProfiler>:\n    pass\n"
            val findings = check_dynamic_capability_acquire(source, "src/lib/common/debug/ref_debug_session.spl", [], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "accessor pairing is deliberately NOT linted":
        """
        ### Scenario: the unsound shape belongs to a bug report, not this lint

        Pairing `session.debug()` and `session.profile()` into a group struct
        is a correctness defect under value semantics (the two halves diverge),
        tracked in capability_group_from_unsound_under_value_semantics_2026-08-09.
        Reporting it here at WARNING would imply it is merely discouraged.
        """

        it "produces no DCA001 for paired member accessors":
            step("Verify: produces no DCA001 for paired member accessors")
            val source = "fn tick(s: RefDebugSession):\n    val d = s.debug()\n    val p = s.profile()\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/tick.spl", [], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# Test Group 2: @init_phase marking rules
# ============================================================================

describe "DCA001: @init_phase marking rules":
    """
    ## What counts as boot code

    Rule 1: the attribute directly above a declaration marks that function.
    Rule 2: a bare `@init_phase` at the top of a file marks the whole module.
    Rule 3: the marking does not propagate to other functions.
    """

    context "when the acquiring function is marked":

        it "is clean under `warn` (rule 1, @ spelling)":
            step("Verify: is clean under `warn` (rule 1, @ spelling)")
            val source = "@init_phase\nfn boot(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/boot.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "is clean under `error` too (rule 1)":
            step("Verify: is clean under `error` too (rule 1)")
            val source = "@init_phase\nfn boot(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/boot.spl", ["GpuCaps"], "error")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "accepts the #[init_phase] bracket spelling":
            step("Verify: accepts the #[init_phase] bracket spelling")
            val source = "#[init_phase]\nfn boot(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/boot.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "survives another attribute stacked between it and the fn":
            step("Verify: survives another attribute stacked between it and the fn")
            val source = "@init_phase\n@inline\nfn boot(src: Host):\n    val g = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/boot.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when only a sibling function is marked (rule 3)":
        """
        ### Scenario: marking must not leak to the next function

        This is the case that decides whether the lint is worth anything: a
        marked `boot` sitting above an unmarked `render_frame` must not silence
        the acquisition in `render_frame`.
        """

        it "still flags the unmarked function that follows":
            step("Verify: still flags the unmarked function that follows")
            val source = "@init_phase\nfn boot(src: Host):\n    val a = GpuCaps.from(src)\n\nfn render_frame(src: Host):\n    val b = GpuCaps.from(src)\n"
            val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(findings[0].line_num).to_equal(6)  # oracle: 6 — named expected value from the requirement

    context "when the whole file is a composition root (rule 2)":

        it "treats a bare top-of-file @init_phase as marking the module":
            step("Verify: treats a bare top-of-file @init_phase as marking the module")
            val source = "# composition root\n@init_phase\n\nuse std.io\n\nfn wire(src: Host):\n    val g = GpuCaps.from(src)\n"
            expect(dca_file_is_init_phase(source)).to_be_true()
            val findings = check_dynamic_capability_acquire(source, "src/app/main.spl", ["GpuCaps"], "warn")
            expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "does NOT treat an attribute attached to the first fn as file-level":
            step("Verify: does NOT treat an attribute attached to the first fn as file-level")
            val source = "@init_phase\nfn boot(src: Host):\n    pass\n"
            expect(dca_file_is_init_phase(source)).to_be_false()

# ============================================================================
# Test Group 3: what must NOT be flagged
# ============================================================================

describe "DCA001: non-findings":
    """
    ## Precision

    With an explicit group list only those names match, and commented-out code
    is not a call site.
    """

    it "ignores a `.from()` on a type that is not a declared group":
        step("Verify: ignores a `.from()` on a type that is not a declared group")
        val source = "fn parse(s: text):\n    val b = Bytes.from(s)\n"
        val findings = check_dynamic_capability_acquire(source, "src/app/parse.spl", ["GpuCaps"], "warn")
        expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ignores a lowercase receiver even with no group list":
        step("Verify: ignores a lowercase receiver even with no group list")
        val source = "fn parse(s: text):\n    val b = bytes.from(s)\n"
        val findings = check_dynamic_capability_acquire(source, "src/app/parse.spl", [], "warn")
        expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ignores a commented-out acquisition":
        step("Verify: ignores a commented-out acquisition")
        val source = "fn render_frame(src: Host):\n    # val g = GpuCaps.from(src)\n    pass\n"
        val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "warn")
        expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "flags an uppercase receiver when no group list is supplied (heuristic mode)":
        step("Verify: flags an uppercase receiver when no group list is supplied (heuristic mode)")
        val source = "fn render_frame(src: Host):\n    val g = GpuCaps.from(src)\n"
        val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", [], "warn")
        expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# Test Group 4: DCA002 manifest pin
# ============================================================================

describe "DCA002: gpu.backend must be manifest-pinned in critical mode":
    """
    ## No `auto` in a critical build

    `auto` defers the backend choice to a boot probe, which is exactly what the
    boot gate is meant to check against.
    """

    it "accepts a concrete backend":
        step("Verify: accepts a concrete backend")
        expect(dca_backend_is_pinned("cuda(sm80)")).to_be_true()
        val findings = check_gpu_backend_pin("cuda(sm80)", true)
        expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects `auto` under critical mode with an ERROR":
        step("Verify: rejects `auto` under critical mode with an ERROR")
        expect(dca_backend_is_pinned("auto")).to_be_false()
        val findings = check_gpu_backend_pin("auto", true)
        expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(findings[0].code).to_equal("DCA002")
        expect(findings[0].severity).to_equal("ERROR")

    it "rejects an unset backend under critical mode":
        step("Verify: rejects an unset backend under critical mode")
        val findings = check_gpu_backend_pin("", true)
        expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(findings[0].code).to_equal("DCA002")

    it "allows `auto` outside critical mode":
        step("Verify: allows `auto` outside critical mode")
        val findings = check_gpu_backend_pin("auto", false)
        expect(findings.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# Test Group 5: mode validation
# ============================================================================

describe "critical.dynamic_acquire mode values":

    it "accepts exactly allow/warn/error":
        step("Verify: accepts exactly allow/warn/error")
        expect(dca_mode_is_valid("allow")).to_be_true()
        expect(dca_mode_is_valid("warn")).to_be_true()
        expect(dca_mode_is_valid("error")).to_be_true()
        expect(dca_mode_is_valid("Warn")).to_be_false()
        expect(dca_mode_is_valid("")).to_be_false()

    it "treats an invalid mode as `warn` rather than silently disabling the lint":
        step("Verify: treats an invalid mode as `warn` rather than silently disabling the lint")
        val source = "fn render_frame(src: Host):\n    val g = GpuCaps.from(src)\n"
        val findings = check_dynamic_capability_acquire(source, "src/app/render.spl", ["GpuCaps"], "wrn")
        expect(findings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(findings[0].severity).to_equal("WARNING")
