use std.io.{file_read}

describe "lint config model primitive type boundary":
    it "uses concrete primitive annotations without importing its facade":
        val source = file_read("src/compiler/90.tools/lint/_LintMain/config_and_model.spl")

        expect(source.contains("use compiler.tools.lint.main.*")).to_equal(false)
        expect(source).to_contain("fn should_keep_lint_result(config: LintConfig, lint_code: String) -> bool:")
        expect(source).to_contain("line: i64")
        expect(source).to_contain("column: i64")
        expect(source).to_contain("fn has_easy_fix() -> bool:")
        expect(source.contains("-> Bool")).to_equal(false)
        expect(source.contains(": Int")).to_equal(false)
