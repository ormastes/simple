describe "Stub Impl Lint — classify_trivial":
    """
    ## Expression Classification

    Unit tests for the classify_trivial helper.
    """

    it "classifies int literal":
        # @req REQ-COMPILER-LINT-STUB-041
        # @capture(statistics): retained verdict for scenario 'classifies int literal'
        step("Verify: classifies int literal")
        ast_reset()
        val e = expr_int_lit(0, 0)
        val kind = classify_trivial(e)
        expect(kind).to_contain("integer")

    it "classifies empty string":
        # @req REQ-COMPILER-LINT-STUB-042
        # @capture(statistics): retained verdict for scenario 'classifies empty string'
        step("Verify: classifies empty string")
        ast_reset()
        val e = expr_string_lit("", 0)
        val kind = classify_trivial(e)
        expect(kind).to_contain("empty string")

    it "classifies non-empty string":
        # @req REQ-COMPILER-LINT-STUB-043
        # @capture(statistics): retained verdict for scenario 'classifies non-empty string'
        step("Verify: classifies non-empty string")
        ast_reset()
        val e = expr_string_lit("hello", 0)
        val kind = classify_trivial(e)
        expect(kind).to_contain("string")

    it "classifies bool false":
        # @req REQ-COMPILER-LINT-STUB-044
        # @capture(statistics): retained verdict for scenario 'classifies bool false'
        step("Verify: classifies bool false")
        ast_reset()
        val e = expr_bool_lit(0, 0)
        val kind = classify_trivial(e)
        expect(kind).to_equal("false")

    it "classifies bool true":
        # @req REQ-COMPILER-LINT-STUB-045
        # @capture(statistics): retained verdict for scenario 'classifies bool true'
        step("Verify: classifies bool true")
        ast_reset()
        val e = expr_bool_lit(1, 0)
        val kind = classify_trivial(e)
        expect(kind).to_equal("true")

    it "classifies nil":
        # @req REQ-COMPILER-LINT-STUB-046
        # @capture(statistics): retained verdict for scenario 'classifies nil'
        step("Verify: classifies nil")
        ast_reset()
        val e = expr_nil_lit(0)
        val kind = classify_trivial(e)
        expect(kind).to_equal("nil")

    it "classifies empty array":
        # @req REQ-COMPILER-LINT-STUB-047
        # @capture(statistics): retained verdict for scenario 'classifies empty array'
        step("Verify: classifies empty array")
        ast_reset()
        val e = expr_array_lit([], 0)
        val kind = classify_trivial(e)
        expect(kind).to_contain("empty array")

    it "rejects non-empty array":
        # @req REQ-COMPILER-LINT-STUB-048
        # @capture(statistics): retained verdict for scenario 'rejects non-empty array'
        step("Verify: rejects non-empty array")
        ast_reset()
        val elem = expr_int_lit(1, 0)
        val e = expr_array_lit([elem], 0)
        val kind = classify_trivial(e)
        expect(kind).to_equal("")

    it "classifies unit":
        # @req REQ-COMPILER-LINT-STUB-049
        # @capture(statistics): retained verdict for scenario 'classifies unit'
        step("Verify: classifies unit")
        ast_reset()
        val e = expr_unit(0)
        val kind = classify_trivial(e)
        expect(kind).to_contain("unit")

    it "classifies pass":
        # @req REQ-COMPILER-LINT-STUB-050
        # @capture(statistics): retained verdict for scenario 'classifies pass'
        step("Verify: classifies pass")
        ast_reset()
        val e = expr_pass(0)
        val kind = classify_trivial(e)
        expect(kind).to_equal("pass")

    it "rejects complex expression (binary)":
        # @req REQ-COMPILER-LINT-STUB-051
        # @capture(statistics): retained verdict for scenario 'rejects complex expression (binary)'
        step("Verify: rejects complex expression (binary)")
        ast_reset()
        val left = expr_int_lit(1, 0)
        val right = expr_int_lit(2, 0)
        val e = expr_binary(60, left, right, 0)
        val kind = classify_trivial(e)
        expect(kind).to_equal("")

describe "Stub Impl Lint — is_default_value":
    """
    ## Default Value Detection

    Unit tests for distinguishing zero/default values from meaningful constants.
    """

    it "0 is default":
        # @req REQ-COMPILER-LINT-STUB-052
        # @capture(statistics): retained verdict for scenario '0 is default'
        step("Verify: 0 is default")
        ast_reset()
        val e = expr_int_lit(0, 0)
        expect(is_default_value(e)).to_equal(true)

    it "42 is NOT default":
        # @req REQ-COMPILER-LINT-STUB-053
        # @capture(statistics): retained verdict for scenario '42 is NOT default'
        step("Verify: 42 is NOT default")
        ast_reset()
        val e = expr_int_lit(42, 0)
        expect(is_default_value(e)).to_equal(false)

    it "empty string is default":
        # @req REQ-COMPILER-LINT-STUB-054
        # @capture(statistics): retained verdict for scenario 'empty string is default'
        step("Verify: empty string is default")
        ast_reset()
        val e = expr_string_lit("", 0)
        expect(is_default_value(e)).to_equal(true)

    it "non-empty string is NOT default":
        # @req REQ-COMPILER-LINT-STUB-055
        # @capture(statistics): retained verdict for scenario 'non-empty string is NOT default'
        step("Verify: non-empty string is NOT default")
        ast_reset()
        val e = expr_string_lit("hello", 0)
        expect(is_default_value(e)).to_equal(false)

    it "false is default":
        # @req REQ-COMPILER-LINT-STUB-056
        # @capture(statistics): retained verdict for scenario 'false is default'
        step("Verify: false is default")
        ast_reset()
        val e = expr_bool_lit(0, 0)
        expect(is_default_value(e)).to_equal(true)

    it "true is NOT default":
        # @req REQ-COMPILER-LINT-STUB-057
        # @capture(statistics): retained verdict for scenario 'true is NOT default'
        step("Verify: true is NOT default")
        ast_reset()
        val e = expr_bool_lit(1, 0)
        expect(is_default_value(e)).to_equal(false)

    it "nil is default":
        # @req REQ-COMPILER-LINT-STUB-058
        # @capture(statistics): retained verdict for scenario 'nil is default'
        step("Verify: nil is default")
        ast_reset()
        val e = expr_nil_lit(0)
        expect(is_default_value(e)).to_equal(true)

    it "empty array is default":
        # @req REQ-COMPILER-LINT-STUB-059
        # @capture(statistics): retained verdict for scenario 'empty array is default'
        step("Verify: empty array is default")
        ast_reset()
        val e = expr_array_lit([], 0)
        expect(is_default_value(e)).to_equal(true)

    it "non-empty array is NOT default":
        # @req REQ-COMPILER-LINT-STUB-060
        # @capture(statistics): retained verdict for scenario 'non-empty array is NOT default'
        step("Verify: non-empty array is NOT default")
        ast_reset()
        val elem = expr_int_lit(1, 0)
        val e = expr_array_lit([elem], 0)
        expect(is_default_value(e)).to_equal(false)
