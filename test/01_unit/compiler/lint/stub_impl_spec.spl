"""
## Purpose and audience
Purpose: Prove that STUB001 — Trivial return with unused params.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINT-001 — stable requirement identity for this spec.

"""
# Stub Implementation Lint Specification

**Feature IDs:** #STUB-001
**Category:** Tooling
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Tests the STUB001/STUB002 lint that detects functions with trivial/dummy
implementations — bare literals like 0, "", false, nil without parameter usage.

## Key Concepts

| Concept | Description |
|---------|-------------|
| STUB001 | Function with params returns trivial value, params unused |
| STUB002 | Zero-param function returns default value (possible stub) |
| Trivial | A bare literal or default value as entire function body |
| Default | Zero-values: 0, "", false, nil, [], {} |
"""

use compiler.core.ast.{
    ast_reset, decl_fn, decl_extern_fn, module_add_decl, module_get_decls,
    DECL_FN, DECL_EXTERN_FN
}
use compiler.core.ast_expr.{
    expr_int_lit, expr_string_lit, expr_bool_lit, expr_nil_lit,
    expr_array_lit, expr_unit, expr_dict_lit, expr_ident,
    expr_return_expr, expr_call, expr_pass,
    expr_pass_todo, expr_pass_do_nothing, expr_pass_dn, expr_binary, expr_method_call
}
use compiler.core.ast_stmt.{
    stmt_expr_stmt, stmt_return_stmt
}
use compiler.semantics.lint.stub_impl.{
    check_stub_impl, StubImplWarning,
    classify_trivial, is_default_value,
    body_has_pass_marker, body_references_any_param,
    get_single_trivial_expr,
    string_lit_references_param
}

# ============================================================================
# Helpers: Build minimal AST for a function
# ============================================================================

fn make_fn_with_body(name: text, param_names: [text], body_expr_id: i64) -> i64:
    """Create a function decl with a single STMT_EXPR body."""
    val s = stmt_expr_stmt(body_expr_id, 0)
    var param_types: [i64] = []
    for _ in param_names:
        param_types.push(0)
    decl_fn(name, param_names, param_types, 0, [s], 0, [], 0)

fn make_fn_with_return(name: text, param_names: [text], body_expr_id: i64) -> i64:
    """Create a function decl with a single STMT_RETURN body."""
    val s = stmt_return_stmt(body_expr_id, 0)
    var param_types: [i64] = []
    for _ in param_names:
        param_types.push(0)
    decl_fn(name, param_names, param_types, 0, [s], 0, [], 0)

fn find_warnings_by_code(warnings: [StubImplWarning], code: text) -> [StubImplWarning]:
    var result: [StubImplWarning] = []
    for w in warnings:
        if w.code == code:
            result.push(w)
    result

# ============================================================================
# Test Group 1: STUB001 — Functions with unused params
# ============================================================================

use std.spec.step

describe "STUB001 — Trivial return with unused params":
    """
    ## Unused Parameters

    Detect functions that accept parameters but return a trivial literal
    without referencing any of them.
    """

    context "when function returns bare 0 with unused params":
        it "emits STUB001 warning":
            step("Verify: emits STUB001 warning")
            # @req: REQ-COMPILER-LINT-001
            ast_reset()
            val e = expr_int_lit(0, 0)
            val d = make_fn_with_body("gc_malloc", ["size"], e)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_be_greater_than(0)
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(stub001[0].fn_name).to_equal("gc_malloc")

    context "when function returns empty string with unused params":
        it "emits STUB001 warning":
            step("Verify: emits STUB001 warning")
            ast_reset()
            val e = expr_string_lit("", 0)
            val d = make_fn_with_body("load_config", ["path"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function returns false with unused params":
        it "emits STUB001 warning":
            step("Verify: emits STUB001 warning")
            ast_reset()
            val e = expr_bool_lit(0, 0)
            val d = make_fn_with_body("is_supported", ["feature"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function returns nil with unused params":
        it "emits STUB001 warning":
            step("Verify: emits STUB001 warning")
            ast_reset()
            val e = expr_nil_lit(0)
            val d = make_fn_with_body("find_item", ["name"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function returns empty array with unused params":
        it "emits STUB001 warning":
            step("Verify: emits STUB001 warning")
            ast_reset()
            val e = expr_array_lit([], 0)
            val d = make_fn_with_body("tokenize", ["src"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function returns non-zero literal with unused params":
        it "emits STUB001 for any literal when params unused":
            step("Verify: emits STUB001 for any literal when params unused")
            ast_reset()
            val e = expr_int_lit(42, 0)
            val d = make_fn_with_body("compute", ["x"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function returns non-empty string with unused params":
        it "emits STUB001 (constant string ignoring params)":
            step("Verify: emits STUB001 (constant string ignoring params)")
            ast_reset()
            val e = expr_string_lit("GET", 0)
            val d = make_fn_with_body("get_method", ["request"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function returns true with unused params":
        it "emits STUB001":
            step("Verify: emits STUB001")
            ast_reset()
            val e = expr_bool_lit(1, 0)
            val d = make_fn_with_body("supports_target", ["target"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when explicit return with unused params":
        it "emits STUB001 for return 0":
            step("Verify: emits STUB001 for return 0")
            ast_reset()
            val e = expr_int_lit(0, 0)
            val d = make_fn_with_return("process", ["data"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when Ok(nil) with unused params":
        it "emits STUB001":
            step("Verify: emits STUB001")
            ast_reset()
            val nil_e = expr_nil_lit(0)
            val ok_callee = expr_ident("Ok", 0)
            val ok_call = expr_call(ok_callee, [nil_e], 0)
            val d = make_fn_with_body("run_backend", ["module"], ok_call)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# Test Group 1b: STUB001 — parameter used only via string interpolation
# ============================================================================
#
# Regression coverage for
# doc/08_tracking/bug/lint_stub001_false_positive_on_string_interpolation_param_2026-07-29.md:
# a parameter referenced only inside a `{...}` interpolation hole of the
# body's string-literal return must count as "used".

describe "STUB001 — parameter used only via string interpolation":
    """
    ## Interpolation-Only Parameter Use

    A string-literal AST node stores its raw template text verbatim
    (`"literal-{x}"` keeps the `{x}` unexpanded). The parameter-usage walk
    must look inside `{...}` holes, not just at AST child expressions.
    """

    context "when the only param reference is inside a `{...}` hole":
        it "does NOT emit STUB001 (param is used via interpolation)":
            step("Verify: does NOT emit STUB001 (param is used via interpolation)")
            ast_reset()
            # Built via concatenation (not a single literal token) so the
            # *outer* compiler compiling THIS spec never sees "{index}" as
            # its own interpolation hole -- we want the raw, unexpanded
            # runtime text "SPDXRef-Package-File-{index}" handed to
            # expr_string_lit, exactly as the parser would store it for the
            # buggy source `"SPDXRef-Package-File-{index}"`.
            val raw = "SPDXRef-Package-File-" + "{" + "index" + "}"
            val e = expr_string_lit(raw, 0)
            val d = make_fn_with_body("file_package_id", ["index"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when the param is truly unused (single-statement literal body)":
        it "still emits STUB001":
            step("Verify: still emits STUB001")
            ast_reset()
            val e = expr_string_lit("literal", 0)
            val d = make_fn_with_body("label_for", ["index"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when the braces are escaped (`{{x}}` is literal, not a hole)":
        it "still emits STUB001 (x is not counted as used)":
            step("Verify: still emits STUB001 (x is not counted as used)")
            ast_reset()
            # Built char-by-char via concatenation for the same reason as
            # above: avoid the outer compiler treating "{{x}}" as ITS OWN
            # interpolation source when compiling this spec file.
            val escaped = "{" + "{" + "x" + "}" + "}"
            val e = expr_string_lit(escaped, 0)
            val d = make_fn_with_body("escaped_literal", ["x"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when a hole references two identifiers (`{a + b}`)":
        it "does NOT emit STUB001 (both a and b count as used)":
            step("Verify: does NOT emit STUB001 (both a and b count as used)")
            ast_reset()
            val hole = "{" + "a + b" + "}"
            val e = expr_string_lit(hole, 0)
            val d = make_fn_with_body("combine", ["a", "b"], e)
            val ws = check_stub_impl([d])
            val stub001 = find_warnings_by_code(ws, "STUB001")
            expect(stub001.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "string_lit_references_param finds 'a' alone in the hole":
            step("Verify: string_lit_references_param finds 'a' alone in the hole")
            ast_reset()
            val hole = "{" + "a + b" + "}"
            expect(string_lit_references_param(hole, ["a"])).to_equal(true)

        it "string_lit_references_param finds 'b' alone in the hole":
            step("Verify: string_lit_references_param finds 'b' alone in the hole")
            ast_reset()
            val hole = "{" + "a + b" + "}"
            expect(string_lit_references_param(hole, ["b"])).to_equal(true)

        it "string_lit_references_param rejects a name not present in the hole":
            step("Verify: string_lit_references_param rejects a name not present in the hole")
            ast_reset()
            val hole = "{" + "a + b" + "}"
            expect(string_lit_references_param(hole, ["zzz"])).to_equal(false)

    context "when the literal has no interpolation at all":
        it "string_lit_references_param returns false for a plain literal":
            step("Verify: string_lit_references_param returns false for a plain literal")
            ast_reset()
            expect(string_lit_references_param("plain text", ["x"])).to_equal(false)

# ============================================================================
# Test Group 2: STUB002 — Zero-param functions with default values
# ============================================================================

describe "STUB002 — Zero-param default return":
    """
    ## Default Value Returns

    Detect zero-parameter functions that return type default values.
    These are lower confidence — could be stubs or legitimate constants.
    """

    context "when zero-param function returns 0":
        it "emits STUB002 info":
            step("Verify: emits STUB002 info")
            ast_reset()
            val e = expr_int_lit(0, 0)
            val d = make_fn_with_body("get_count", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(stub002[0].severity).to_equal("INFO")

    context "when zero-param function returns empty string":
        it "emits STUB002 info":
            step("Verify: emits STUB002 info")
            ast_reset()
            val e = expr_string_lit("", 0)
            val d = make_fn_with_body("get_name", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when zero-param function returns false":
        it "emits STUB002 info":
            step("Verify: emits STUB002 info")
            ast_reset()
            val e = expr_bool_lit(0, 0)
            val d = make_fn_with_body("is_ready", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when zero-param function returns nil":
        it "emits STUB002 info":
            step("Verify: emits STUB002 info")
            ast_reset()
            val e = expr_nil_lit(0)
            val d = make_fn_with_body("get_cache", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when zero-param function returns non-zero constant":
        it "does NOT emit STUB002 (legitimate constant)":
            step("Verify: does NOT emit STUB002 (legitimate constant)")
            ast_reset()
            val e = expr_int_lit(42, 0)
            val d = make_fn_with_body("max_retries", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when zero-param function returns non-empty string":
        it "does NOT emit STUB002 (legitimate constant)":
            step("Verify: does NOT emit STUB002 (legitimate constant)")
            ast_reset()
            val e = expr_string_lit("GET", 0)
            val d = make_fn_with_body("method_get", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when zero-param function returns true":
        it "does NOT emit STUB002 (legitimate constant)":
            step("Verify: does NOT emit STUB002 (legitimate constant)")
            ast_reset()
            val e = expr_bool_lit(1, 0)
            val d = make_fn_with_body("is_enabled", [], e)
            val ws = check_stub_impl([d])
            val stub002 = find_warnings_by_code(ws, "STUB002")
            expect(stub002.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# Test Group 3: Non-flagged cases (should NOT warn)
# ============================================================================

describe "Stub Impl Lint — No Warning Cases":
    """
    ## Suppressed Warnings

    These cases should NOT emit any warnings.
    """

    context "when function uses its parameters":
        it "does NOT warn":
            step("Verify: does NOT warn")
            ast_reset()
            val param_ref = expr_ident("x", 0)
            val d = make_fn_with_body("identity", ["x"], param_ref)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when function body is bare pass (unchanged, out of WP-8 scope)":
        it "does NOT warn":
            step("Verify: does NOT warn")
            ast_reset()
            val e = expr_pass(0)
            val d = make_fn_with_body("not_yet", ["data"], e)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when function body is the typed NoOp contract (pass_do_nothing with a reason)":
        it "does NOT warn — pass_do_nothing is the sanctioned no-op marker, not a placeholder":
            step("Verify: does NOT warn — pass_do_nothing is the sanctioned no-op marker, not a placeholder")
            ast_reset()
            val e = expr_pass_do_nothing("intentional", 0)
            val d = make_fn_with_body("noop_handler", ["event"], e)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when function body is pass_do_nothing with NO reason (empty message)":
        it "emits STUB003 — an unexplained marker is never a contract, same as a bare name":
            step("Verify: emits STUB003 — an unexplained marker is never a contract, same as a bare name")
            ast_reset()
            val e = expr_pass_do_nothing("", 0)
            val d = make_fn_with_body("unexplained_noop", ["event"], e)
            val ws = check_stub_impl([d])
            val stub003 = find_warnings_by_code(ws, "STUB003")
            expect(stub003.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function body is explicit pass_todo placeholder":
        it "emits STUB003":
            step("Verify: emits STUB003")
            ast_reset()
            val placeholder = expr_pass_todo("todo migration marker", 0)
            val d = make_fn_with_body("not_done_yet", ["value"], placeholder)
            val ws = check_stub_impl([d])
            val stub003 = find_warnings_by_code(ws, "STUB003")
            expect(stub003.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "when function body is explicit pass_dn placeholder":
        it "emits STUB003":
            step("Verify: emits STUB003")
            ast_reset()
            val placeholder = expr_pass_dn("shorthand marker", 0)
            val d = make_fn_with_body("still_dn", ["value"], placeholder)
            val ws = check_stub_impl([d])
            val stub003 = find_warnings_by_code(ws, "STUB003")
            expect(stub003.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# Test Group 3b: NoOp Contract — name is never sufficient (WP-8)
# ============================================================================
#
# Regression coverage for the aerospace hardening plan WP-8: the `_noop_`
# name prefix used to be a self-documenting exemption on its own. It is not
# anymore — a `_noop_x` function and a `helper_noop_x` function (same body
# shape, unrelated names) must be treated IDENTICALLY, based only on whether
# the body satisfies the typed NoOp contract.

describe "Stub Impl Lint — NoOp contract is name-independent (WP-8)":
    """
    ## Typed NoOp Contract

    A name is never sufficient to exempt a function from stub detection —
    only a body that is exactly one `pass_do_nothing("reason")` call is a
    genuine, typed no-op. `_noop_x` and `helper_noop_x` must behave
    identically for the same body shape.
    """

    context "both a `_noop_`-prefixed and an unrelated-named function with a trivial unused-param body":
        it "flags both identically with STUB001 — the name grants no exemption":
            step("Verify: flags both identically with STUB001 — the name grants no exemption")
            ast_reset()
            val e1 = expr_int_lit(0, 0)
            val d1 = make_fn_with_body("_noop_load", ["path"], e1)
            val ws1 = check_stub_impl([d1])
            val stub001_a = find_warnings_by_code(ws1, "STUB001")
            expect(stub001_a.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

            ast_reset()
            val e2 = expr_int_lit(0, 0)
            val d2 = make_fn_with_body("helper_noop_load", ["path"], e2)
            val ws2 = check_stub_impl([d2])
            val stub001_b = find_warnings_by_code(ws2, "STUB001")
            expect(stub001_b.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "both a `_noop_`-prefixed and an unrelated-named function with the typed NoOp contract body":
        it "exempts both identically — the contract, not the name, decides":
            step("Verify: exempts both identically — the contract, not the name, decides")
            ast_reset()
            val e1 = expr_pass_do_nothing("deliberately does nothing", 0)
            val d1 = make_fn_with_body("_noop_flush", ["buf"], e1)
            val ws1 = check_stub_impl([d1])
            expect(ws1.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

            ast_reset()
            val e2 = expr_pass_do_nothing("deliberately does nothing", 0)
            val d2 = make_fn_with_body("helper_noop_flush", ["buf"], e2)
            val ws2 = check_stub_impl([d2])
            expect(ws2.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# Test Group 3c: Empty concrete body under `critical` (WP-8)
# ============================================================================

describe "Stub Impl Lint — empty concrete body severity (WP-8)":
    """
    ## Empty Body Under `critical`

    An empty concrete function body (no statements at all) used to be
    silently skipped under every profile. Under `critical` it must be a hard
    STUB003 ERROR instead of invisible; every other profile keeps the
    pre-WP-8 silent skip so this is not a repo-wide regression.
    """

    context "when body has zero statements and profile is critical":
        it "emits STUB003 ERROR":
            step("Verify: emits STUB003 ERROR")
            ast_reset()
            var param_types: [i64] = [0]
            val d = decl_fn("empty_body_fn", ["x"], param_types, 0, [], 0, [], 0)
            val ws = check_stub_impl([d], "critical")
            val stub003 = find_warnings_by_code(ws, "STUB003")
            expect(stub003.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(stub003[0].severity).to_equal("ERROR")

    context "when body has zero statements and no profile is resolved (default)":
        it "does NOT warn — matches the pre-WP-8 behavior":
            step("Verify: does NOT warn — matches the pre-WP-8 behavior")
            ast_reset()
            var param_types: [i64] = [0]
            val d = decl_fn("empty_body_fn2", ["x"], param_types, 0, [], 0, [], 0)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when body has zero statements and profile is moderate":
        it "does NOT warn":
            step("Verify: does NOT warn")
            ast_reset()
            var param_types: [i64] = [0]
            val d = decl_fn("empty_body_fn3", ["x"], param_types, 0, [], 0, [], 0)
            val ws = check_stub_impl([d], "moderate")
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when function has multi-statement body":
        it "does NOT warn (not a single-expression stub)":
            step("Verify: does NOT warn (not a single-expression stub)")
            ast_reset()
            val e1 = expr_int_lit(1, 0)
            val e2 = expr_int_lit(0, 0)
            val s1 = stmt_expr_stmt(e1, 0)
            val s2 = stmt_expr_stmt(e2, 0)
            val param_types: [i64] = [0]
            val d = decl_fn("multi_stmt", ["x"], param_types, 0, [s1, s2], 0, [], 0)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when extern fn (no body)":
        it "does NOT warn":
            step("Verify: does NOT warn")
            ast_reset()
            val d = decl_extern_fn("rt_read", ["path"], [0], 0, [], 0)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when function body is complex expression":
        it "does NOT warn for binary op":
            step("Verify: does NOT warn for binary op")
            ast_reset()
            val left = expr_ident("x", 0)
            val right = expr_int_lit(2, 0)
            val e = expr_binary(60, left, right, 0)
            val d = make_fn_with_body("double", ["x"], e)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "when function body is method call":
        it "does NOT warn":
            step("Verify: does NOT warn")
            ast_reset()
            val recv = expr_ident("items", 0)
            val e = expr_method_call(recv, "len", [], 0)
            val d = make_fn_with_body("count", ["items"], e)
            val ws = check_stub_impl([d])
            expect(ws.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

