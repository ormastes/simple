# @req REQ-LINT-DESCRIBED-SUPPRESSION
# Actual public lint/configuration APIs; authored execution UNRUN.
use std.spec.{describe, it, expect, step}
use compiler.tools.lint.main.{Linter, LintConfig, LintLevel, LintRunResult}

fn suppression_profile_results(profile: text, source: text, warning_phase: bool = false) -> [LintRunResult]:
    var config = LintConfig.new()
    config.set_warning_phase(warning_phase)
    if profile != "": config.set_profile_from_string(profile)
    var linter = Linter.new(false)
    linter.config = config
    linter.lint_source("/tmp/suppression_profile_spec.spl", source)

fn suppression_profile_issues(results: [LintRunResult]) -> [LintRunResult]:
    var issues: [LintRunResult] = []
    for result in results:
        if result.lint.code == "LINTALLOW001": issues.push(result)
    issues

describe "described suppression admission under explicit lint profiles":
    it "keeps missing descriptions advisory in unset moderate and strict profiles":
        step("Compare the same malformed suppression through each ordinary profile")
        for profile in ["", "moderate", "strict"]:
            val issues = suppression_profile_issues(suppression_profile_results(profile, "@allow(print_in_test_spec)\nprint(1)\n"))
            expect(issues.len()).to_equal(1)
            expect(issues[0].lint.level == LintLevel.Warn).to_be(true)

    it "rejects missing descriptions in robust and critical including existing aliases":
        step("Resolve canonical and deprecated names through the existing configuration API")
        for profile in ["robust", "critical", "reliable", "mission-critical"]:
            val issues = suppression_profile_issues(suppression_profile_results(profile, "@allow(print_in_test_spec)\nprint(1)\n"))
            expect(issues.len()).to_equal(1)
            expect(issues[0].lint.level == LintLevel.Deny).to_be(true)

    it "reports the precise attribute location without fabricating a reason fix":
        step("An author must supply intent; the tool retains an actionable explanation")
        val issues = suppression_profile_issues(suppression_profile_results("robust", "# header\n  @allow(print_in_test_spec)\nprint(1)\n"))
        expect(issues.len()).to_equal(1)
        expect(issues[0].line).to_equal(2)
        expect(issues[0].column).to_equal(3)
        expect(issues[0].lint.message).to_contain("# reason:")
        expect(issues[0].lint.message).to_contain("warning remains enabled")
        expect(issues[0].has_easy_fix()).to_be(false)

    it "accepts described named suppression while retaining the profile":
        step("This fixture deliberately exercises console-output suppression")
        val results = suppression_profile_results("robust", "@allow(print_in_test_spec) # reason: this fixture demonstrates console output\nprint(1)\n")
        expect(suppression_profile_issues(results).len()).to_equal(0)
        var underlying = 0
        for result in results:
            if result.lint.code == "print_in_test_spec": underlying = underlying + 1
        expect(underlying).to_equal(0)

    it "rejects whitespace-only descriptions and described blanket targets":
        step("Whitespace is not intent and a description does not make blanket suppression scoped")
        for source in ["@allow(print_in_test_spec) # reason:   \nprint(1)\n", "@allow(all) # reason: intentional\nprint(1)\n"]:
            val issues = suppression_profile_issues(suppression_profile_results("critical", source))
            expect(issues.len()).to_equal(1)
            expect(issues[0].lint.level == LintLevel.Deny).to_be(true)

    it "does not let a malformed suppression silence its own diagnostic":
        step("The admission diagnostic is not a suppressible lint-family mapping")
        val issues = suppression_profile_issues(suppression_profile_results("robust", "@allow(LINTALLOW001)\n"))
        expect(issues.len()).to_equal(1)
        expect(issues[0].lint.level == LintLevel.Deny).to_be(true)
        val attempted = "@allow(LINTALLOW001) # reason: this fixture tests self-suppression refusal\n@allow(print_in_test_spec)\nprint(1)\n"
        val retained = suppression_profile_issues(suppression_profile_results("robust", attempted))
        expect(retained.len()).to_equal(1)
        expect(retained[0].line).to_equal(2)
        expect(retained[0].lint.level == LintLevel.Deny).to_be(true)

    it "preserves the existing warning-phase migration downgrade":
        step("The shared warning-phase knob lowers denial to an emitted warning")
        val issues = suppression_profile_issues(suppression_profile_results("robust", "@allow(print_in_test_spec)\nprint(1)\n", true))
        expect(issues.len()).to_equal(1)
        expect(issues[0].lint.level == LintLevel.Warn).to_be(true)

    it "uses the final resolved file profile independent of attribute order":
        step("A later file profile is resolved before suppression diagnostics are emitted")
        val robust = suppression_profile_issues(suppression_profile_results("strict", "@allow(print_in_test_spec)\n@lint_profile(robust)\nprint(1)\n"))
        expect(robust.len()).to_equal(1)
        expect(robust[0].lint.level == LintLevel.Deny).to_be(true)
        val moderate = suppression_profile_issues(suppression_profile_results("robust", "@allow(print_in_test_spec)\n@lint_profile(moderate)\nprint(1)\n"))
        expect(moderate.len()).to_equal(1)
        expect(moderate[0].lint.level == LintLevel.Warn).to_be(true)

    it "retains the underlying warning without promoting unrelated diagnostics":
        step("Only malformed suppression admission changes severity")
        val results = suppression_profile_results("robust", "@allow(print_in_test_spec)\nprint(1)\n")
        var underlying = 0
        for result in results:
            if result.lint.code == "print_in_test_spec":
                underlying = underlying + 1
                expect(result.lint.level == LintLevel.Warn).to_be(true)
        expect(underlying).to_be_greater_than(0)

    it "keeps comments and multiline string lookalikes inert in robust mode":
        step("Use the existing lexical admission rather than interpreting text as attributes")
        val source = "# @allow(print_in_test_spec)\n\"\"\"\n@allow(print_in_test_spec)\n\"\"\"\n"
        expect(suppression_profile_issues(suppression_profile_results("robust", source)).len()).to_equal(0)
