use std.spec.*
use compiler.semantics.lint.linear_scan_in_loop.{check_linear_scan_in_loop}

# Purpose and audience: executable spec of PERF-SCAN-001, the linear-scan-in-loop
# hot-path lint, for compiler-tooling maintainers.
# Scope: detection of a whole-container scan invoked inside a loop body, and the
# negative cases that must NOT fire. Out of scope: severity escalation policy and
# the ratchet that freezes the existing population — neither is this file's job.
# @req REQ-LINT-PERF-SCAN
#
# Regression guard for
# doc/08_tracking/bug/stage3_quadratic_transient_heap_promote_2026-09-02.md
#
# The defect this rule exists to catch: `rt_transient_heap_promote` ends in
# `scope.objects.retain(...)` (O(|scope.objects|)) and was called once per module
# surface. Across 760 modules Stage 3 stopped progressing entirely — 6,600
# objects, zero new in 90 seconds — while emitting NO error and NO diagnostic.
# `sample` showed 100% of frames in that one chain. Nothing in the toolchain
# flagged it; that gap is what this rule closes.

describe "PERF-SCAN-001 linear scan in loop":

    it "flags the Stage-3 defect shape: promote called per loop item":
        val src = "me module_surfaces_promote(self):\n" +
                  "    for surface in self.surfaces:\n" +
                  "        rt_transient_heap_promote(surface)\n"
        val found = check_linear_scan_in_loop(src, "fixture.spl")
        expect(found.len()).to_equal(1)
        expect(found[0].code).to_equal("PERF-SCAN-001")
        expect(found[0].line_num).to_equal(3)

    it "flags .retain( inside a while body":
        val src = "fn compact(xs):\n" +
                  "    while i < n:\n" +
                  "        xs.retain(pred)\n"
        expect(check_linear_scan_in_loop(src, "f.spl").len()).to_equal(1)

    it "does NOT flag the same call OUTSIDE any loop":
        val src = "fn once(xs):\n" +
                  "    xs.retain(pred)\n"
        expect(check_linear_scan_in_loop(src, "f.spl").len()).to_equal(0)

    it "does NOT flag after the loop is dedented out of":
        val src = "fn after(xs):\n" +
                  "    for x in xs:\n" +
                  "        touch(x)\n" +
                  "    xs.retain(pred)\n"
        expect(check_linear_scan_in_loop(src, "f.spl").len()).to_equal(0)

    it "resets at a function header so a loop cannot capture the next function":
        val src = "fn a(xs):\n" +
                  "    for x in xs:\n" +
                  "        touch(x)\n" +
                  "fn b(xs):\n" +
                  "    xs.retain(pred)\n"
        expect(check_linear_scan_in_loop(src, "f.spl").len()).to_equal(0)

    it "reports each offending line once, not once per matching primitive":
        val src = "fn m(xs):\n" +
                  "    for x in xs:\n" +
                  "        xs.retain(a).contains(b)\n"
        expect(check_linear_scan_in_loop(src, "f.spl").len()).to_equal(1)

    it "carries an actionable hint naming the remedy":
        val src = "fn m(xs):\n" +
                  "    for x in xs:\n" +
                  "        xs.retain(p)\n"
        val f = check_linear_scan_in_loop(src, "f.spl")
        expect(f[0].hint.contains("after the loop")).to_equal(true)
