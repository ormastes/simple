# The Certain COLL002/COLL020 rewrites must PROVE safety or refuse.
#
# A review ran the original and the rewritten program for each fixture below
# and found three classes of Certain auto-fix that turn a working program into
# a wrong one. Full record, with the measured outputs:
# doc/08_tracking/bug/
# coll_certain_fix_rewrites_working_programs_wrongly_2026-09-19.md
#
#   (a) The Dict is hoisted in front of the INNERMOST loop while the array
#       lives outside an enclosing one, so membership resets every outer
#       iteration.       nested   [1,2,3,4] -> [1,2,2,3,1,3,4]
#                        outer_mut [1,2,9,9] -> [1,2,9,2,9,9]
#   (b) `collection_is_mutation_of` is a line-PREFIX whitelist, so a mutation
#       anywhere but the start of a line is invisible.
#                        pop_expr    [1,2,3,3] -> [1,2,3]
#                        coll002_pop [3,1]     -> [3,3,3,1]
#   (c) The generated `{receiver}_set` collides with a user binding of that
#       name.            setname_clash  1 -> 2
#
# (a) and (c) were offered at BASE too — this is a pre-existing correctness
# defect in the shipped auto-fix, not only a regression of the widened
# detector. (b) was lint-silent at base and is newly exposed by it.
#
# Fixtures below are byte-identical to the review's
# scratchpad/d2/fx/{nested,outer_mut,pop_expr,coll002_pop,setname_clash}.spl,
# minus the trailing `print` driver line (which no generator reads).
use std.spec.*
use compiler.tools.lint.main.{collection_002_fix, collection_020_fix, collection_certain_fixes}
use std.tooling.easy_fix.*

fn fix002(src: text) -> EasyFix?:
    collection_002_fix("/tmp/certain_safety.spl", src.split("\n"))

fn fix020(src: text) -> EasyFix?:
    collection_020_fix("/tmp/certain_safety.spl", src.split("\n"))

fn is_some(fix: EasyFix?) -> bool:
    match fix:
        case Some(_): true
        case nil: false

fn applied020(src: text) -> text:
    match fix020(src):
        case Some(fix):
            easyfix_apply_sorted_replacements(
                src, easyfix_sort_replacements_descending(easyfix_replacements(fix)))
        case nil:
            ""

val F_NESTED_SRC = "fn dedup_all(groups: [[i64]]) -> [i64]:\n    var seen: [i64] = []\n    for g in groups:\n        for x in g:\n            if not seen.contains(x):\n                seen.push(x)\n    seen\n"
val F_OUTER_MUT_SRC = "fn dedup_all(groups: [[i64]], extra: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for g in groups:\n        for x in g:\n            if not seen.contains(x):\n                seen.push(x)\n        for e in extra:\n            seen.push(e)\n    seen\n"
val F_POP_EXPR_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        if seen.len() > 2:\n            val dropped = seen.pop()\n    out\n"
val F_COLL002_POP_SRC = "fn keep(xs: [i64]) -> [i64]:\n    var allowed: [i64] = [1, 2, 3]\n    var out: [i64] = []\n    for x in xs:\n        if allowed.contains(x):\n            out.push(x)\n            val used = allowed.pop()\n    out\n"
val F_SETNAME_CLASH_SRC = "fn dedup(xs: [i64]) -> i64:\n    var seen: [i64] = []\n    var seen_set: Dict<i64, bool> = " + "{" + "}" + "\n    seen_set[99] = true\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n    seen_set.len()\n"

describe "class (a): the declaration must dominate the hoisted loop":
    it "nested: fixes, with the Dict beside the declaration":
        step("nested: fixes, with the Dict beside the declaration")
        """FLIPPED round 4, and this is the hazard being REMOVED rather than
        detected. The Dict used to be emitted in front of the innermost loop
        while `seen` was declared outside the outer one, so membership reset
        every outer iteration: [1,2,3,4] -> [1,2,2,3,1,3,4]. Emitting it
        immediately after the declaration gives the two exactly the same
        lifetime, so nesting stops mattering. Verified by execution:
        [1,2,3,4] -> [1,2,3,4]. This shape accounted for ~16 of the 68 real
        dedup sites in the tree."""
        val applied = applied020(F_NESTED_SRC)
        expect(applied).to_contain("    var seen: [i64] = []\n    var seen_set: Dict<i64, bool> = {}\n    for g in groups:")
        expect(applied).to_contain("if not seen_set.contains_key(x):")
        expect(applied).to_contain("seen_set[x] = true")

    it "outer_mut: refuses the same shape with an outer-loop push as well":
        step("outer_mut: refuses the same shape with an outer-loop push as well")
        """Two independent failures in one fixture: the non-dominating
        declaration above, plus `seen.push(e)` after the inner loop, outside
        the old range scan. Measured: [1,2,9,9] -> [1,2,9,2,9,9]."""
        assert_false(is_some(fix020(F_OUTER_MUT_SRC)))

describe "class (b): mutation anywhere in the function disqualifies":
    it "pop_expr: refuses a `.pop()` that is not at the start of its line":
        step("pop_expr: refuses a `.pop()` that is not at the start of its line")
        """`val dropped = seen.pop()` mutates the tracked array where the
        line-prefix whitelist cannot see it, so the Dict would keep entries
        the array no longer has. Measured: [1,2,3,3] -> [1,2,3]."""
        assert_false(is_some(fix020(F_POP_EXPR_SRC)))

    it "coll002_pop: the COLL002 sibling refuses it too":
        step("coll002_pop: the COLL002 sibling refuses it too")
        """`val used = allowed.pop()` shrinks the hoisted array after the
        membership Dict was built from it. Measured: [3,1] -> [3,3,3,1]."""
        assert_false(is_some(fix002(F_COLL002_POP_SRC)))

describe "class (c): generated names must be fresh":
    it "setname_clash: picks an unused name instead of shadowing the user's":
        step("setname_clash: picks an unused name instead of shadowing the user's")
        """The file already declares `var seen_set` and returns its length.
        Emitting `seen_set` blindly changed the result from 1 to 2. A fresh
        name is a PROVEN-equivalent rewrite rather than a refusal, so this
        example asserts the rewrite and checks it leaves the user's binding
        and the returned expression alone. Verified by execution: original
        and rewritten both print 1."""
        match fix020(F_SETNAME_CLASH_SRC):
            case Some(_):
                val applied = applied020(F_SETNAME_CLASH_SRC)
                # The user's own binding and its one key survive untouched.
                expect(applied).to_contain("var seen_set: Dict<i64, bool> =")
                expect(applied).to_contain("seen_set[99] = true")
                expect(applied).to_contain("seen_set.len()")
                # The generated one is a different, fresh name.
                expect(applied).to_contain("var seen_set2: Dict<i64, bool> =")
                expect(applied).to_contain("if not seen_set2.contains_key(x):")
                expect(applied).to_contain("seen_set2[x] = true")
            case nil:
                # Refusing is also acceptable under the envelope; what is not
                # acceptable is emitting the colliding name.
                val applied = applied020(F_SETNAME_CLASH_SRC)
                expect(applied).to_equal("")

    it "refuses when every candidate name is already taken":
        step("refuses when every candidate name is already taken")
        """`collection_fresh_name` tries `seen_set` then `seen_set2`..
        `seen_set10` against the AST's own identifier set; with every one of
        them BOUND there is no safe name left and the fix must not be
        offered. The names have to be real bindings, not text: freshness is
        proved on the parsed module now, so a comment mentioning `seen_set`
        correctly does not reserve it."""
        var taken = ""
        var n = 1
        while n <= 10:
            val suffix = if n == 1: "" else: n.to_text()
            taken = taken + "    val seen_set" + suffix + ": i64 = " + n.to_text() + "\n"
            n = n + 1
        val src = "fn dedup(xs: [i64]) -> [i64]:\n" + taken + "    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n    seen\n"
        assert_false(is_some(fix020(src)))

# ---------------------------------------------------------------------------
# Round 2: seven more wrong rewrites, every one of them a TEXTUAL proof
# disagreeing with the parser about statement or block extent. They are not
# seven missing cases — they are one structural defect, and the response was
# to move all four proofs (dominance, site containment, whole-function
# mutation, name freshness) onto the AST the detector already walks. Record:
# doc/08_tracking/bug/
# coll_certain_fix_textual_proofs_disagree_with_parser_2026-09-19.md
#
# Fixtures byte-identical to the review's scratchpad/d2/r2/*.spl minus the
# trailing `print` driver. The TAB in b3 is written with an escape so that no
# editor or formatter can silently turn it into spaces and make the example
# vacuous.
# ---------------------------------------------------------------------------

val B1_WHILE_PAREN_SRC = "fn dedup_all(groups: [[i64]]) -> [i64]:\n    var seen: [i64] = []\n    var gi = 0\n    while(gi < groups.len()):\n        val g = groups[gi]\n        for x in g:\n            if not seen.contains(x):\n                seen.push(x)\n        gi = gi + 1\n    seen\n"
val B2_COL0_COMMENT_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n# keep the window small\n        if seen.len() > 2:\n            val dropped = seen.pop()\n    out\n"
val B3_TAB_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n\t\tif seen.len() > 2:\n\t\t\tval dropped = seen.pop()\n    out\n"
val B4_CONTINUATION_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        if seen.len() > 2:\n            val dropped = (seen\n                .pop())\n    out\n"
val B5_NAMED_ARG_SRC = "fn grow(a: [i64], k: i64):\n    a.push(k)\n\nfn collect(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        grow(k=x + 100, a=seen)\n    out\n"
val B6_MULTILINE_CALL_SRC = "fn grow(a: [i64], k: i64):\n    a.push(k)\n\nfn collect(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        grow(\n            seen, x + 100)\n    out\n"
val B7_FOR_SHADOW_SRC = "fn count_hits(groups: [[i64]]) -> i64:\n    var allowed: [i64] = [1, 2]\n    var n = 0\n    for allowed in groups:\n        if allowed.contains(5):\n            n = n + 1\n    n\n"

describe "round 2: statement and block extent is the parser's answer":
    it "b1: `while(...)` with no space is still a loop":
        step("b1: `while(...)` with no space is still a loop")
        """The textual dominance scan looked for a line starting `"while "`,
        so `while(gi < groups.len()):` was not a loop header and the array's
        declaration appeared to dominate the INNER `for`. The Dict was hoisted
        there and membership reset every outer iteration:
        [1,2,3,4] -> [1,2,2,3,1,3,4].

        FLIPPED round 4 for the same reason as `nested`: the Dict is now
        emitted beside the declaration, so the nesting this fixture was built
        around is no longer a hazard and the rewrite is correct. Verified by
        execution: [1,2,3,4] -> [1,2,3,4]. What the fixture still proves is
        that the loop is RECOGNISED — the spelling `while(` no longer decides
        anything, because the statement is a STMT_WHILE on the AST."""
        val applied = applied020(B1_WHILE_PAREN_SRC)
        expect(applied).to_contain("    var seen: [i64] = []\n    var seen_set: Dict<i64, bool> = {}")
        expect(applied).to_contain("if not seen_set.contains_key(x):")

    it "b2: a column-0 comment does not end a block":
        step("b2: a column-0 comment does not end a block")
        """The block scan stopped at the first line indented no further than
        the header, and a comment at column 0 qualified — so the
        `val dropped = seen.pop()` after it was never examined:
        [1,2,3,3] -> [1,2,3]. The parser does not end a block at a comment."""
        assert_false(is_some(fix020(B2_COL0_COMMENT_SRC)))

    it "b3: a tab is indentation":
        step("b3: a tab is indentation")
        """`collection_line_indent` counted spaces only, so tab-indented lines
        measured as indent 0 and fell outside every range: same corruption,
        [1,2,3,3] -> [1,2,3]. Indentation is now nobody's business here."""
        assert_false(is_some(fix020(B3_TAB_SRC)))

    it "b4: a statement split across lines is one statement":
        step("b4: a statement split across lines is one statement")
        """`val dropped = (seen` / `.pop())` is a single STMT_VAL_DECL whose
        initializer is a `.pop()` on the tracked array. To a line scan it was
        two lines, neither of which was a `.pop()`: [1,2,3,3] -> [1,2,3]."""
        assert_false(is_some(fix020(B4_CONTINUATION_SRC)))

    it "b5: a named argument is an argument":
        step("b5: a named argument is an argument")
        """Alias detection required the name to be immediately flanked by `(`
        or `,`, so `grow(k=x + 100, a=seen)` passed the array to a mutating
        callee unseen: [1,2] -> [1,101,2]. On the AST an argument is an
        argument whatever its surface syntax."""
        assert_false(is_some(fix020(B5_NAMED_ARG_SRC)))

    it "b6: a call split across lines is one call":
        step("b6: a call split across lines is one call")
        """Same alias hand-off as b5, hidden by a newline instead of a name:
        [1,2] -> [1,101,2]."""
        assert_false(is_some(fix020(B6_MULTILINE_CALL_SRC)))

    it "b7: a `for` binding shadows the array it is named after":
        step("b7: a `for` binding shadows the array it is named after")
        """`for allowed in groups` binds `allowed`, but the declaration search
        only recognised `val`/`var` lines, so `allowed.contains(5)` inside the
        loop was resolved to the OUTER array and the Dict was built from the
        wrong value: 1 -> 0. Bindings are counted on the AST now, and a name
        bound more than once in a function is refused outright."""
        assert_false(is_some(fix002(B7_FOR_SHADOW_SRC)))
        assert_false(is_some(fix020(B7_FOR_SHADOW_SRC)))

# ---------------------------------------------------------------------------
# Round 3: four more wrong rewrites, one cause — the proofs were ALLOW-lists
# over enumerated cases, so anything not enumerated defaulted to "safe". The
# AST move in round 2 was right; the DEFAULTS were still inverted. Every
# default is now fail-closed: block traversal is generic over each statement
# kind's child lists, an unknown kind or unreadable binding form makes the
# whole function uninspectable, method calls on the array are unsafe unless
# the name is a proven reader, and a receiver that merely mentions the array
# is a mutation. Record: doc/08_tracking/bug/
# coll_certain_fix_textual_proofs_disagree_with_parser_2026-09-19.md
#
# Fixtures byte-identical to the review's r3/**/*.spl minus the `print`
# driver.
# ---------------------------------------------------------------------------

val C1_ELSE_MUT_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        if x > 100:\n            out.push(0)\n        else:\n            val dropped = seen.pop()\n    out\n"
val C1B_ELIF_MUT_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        if x > 100:\n            out.push(0)\n        elif x > 0:\n            val dropped = seen.pop()\n    out\n"
val C1C_ELSE_COLL002_SRC = "fn keep(xs: [i64]) -> [i64]:\n    var allowed: [i64] = [1, 2, 3]\n    var out: [i64] = []\n    for x in xs:\n        if allowed.contains(x):\n            out.push(x)\n        if x > 100:\n            out.push(0)\n        else:\n            val dropped = allowed.pop()\n    out\n"
val C2_FILL_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n        if seen.len() > 0:\n            val r = seen.fill(99)\n    out\n"
val C3_DESTRUCTURE_SRC = "fn bounded(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var out: [i64] = []\n    for x in xs:\n        var (seen, k) = ([], 0)\n        if not seen.contains(x):\n            seen.push(x)\n            out.push(x)\n    out\n"
val C4_INDEX_RECEIVER_SRC = "fn bounded(groups: [[i64]]) -> i64:\n    var seen: [[i64]] = []\n    for g in groups:\n        if not seen.contains(g):\n            seen.push(g)\n        seen[0].push(7)\n    seen.len()\n"

describe "round 3: every default is fail-closed":
    it "c1: an `else` body is walked":
        step("c1: an `else` body is walked")
        """`stmts_have_unsafe_use` visited only `stmt_get_body(if)`, the
        then-branch, so `val dropped = seen.pop()` in an `else` was never
        seen: [1,2,1,3,3] -> [1,2,3]. Traversal is generic over each
        statement kind's child statement lists now, so `else` is covered by
        construction rather than by being listed."""
        assert_false(is_some(fix020(C1_ELSE_MUT_SRC)))

    it "c1b: an `elif` body is walked":
        step("c1b: an `elif` body is walked")
        assert_false(is_some(fix020(C1B_ELIF_MUT_SRC)))

    it "c1c: the COLL002 sibling walks `else` too":
        step("c1c: the COLL002 sibling walks `else` too")
        """`allowed.pop()` in an `else` shrank the array the Dict was built
        from: [1,2] -> [1,2,3,1]."""
        assert_false(is_some(fix002(C1C_ELSE_COLL002_SRC)))

    it "c2: an unknown method on the array is a mutation, not a read":
        step("c2: an unknown method on the array is a mutation, not a read")
        """`fill` is a real runtime mutator that was absent from the mutating
        whitelist, so it read as harmless: [1,2,1,2] -> [1,2]. The list is
        now an allow-list of proven readers and the default is UNSAFE, so a
        method nobody has vetted refuses the fix instead of permitting it."""
        assert_false(is_some(fix020(C2_FILL_SRC)))

    it "c3: a destructuring binding counts as a binding":
        step("c3: a destructuring binding counts as a binding")
        """`var (seen, k) = ([], 0)` rebinds `seen` inside the loop. It does
        NOT yield an empty `stmt_get_name` as first assumed — the name is the
        literal `"(seen,k)"`, a pattern rendered as text — so an emptiness
        test missed it and the Dict was built from the wrong array:
        [1,1,2] -> [1,2]. The pattern's bound names are read out of the
        parser's rendering and each counts as a binding."""
        assert_false(is_some(fix020(C3_DESTRUCTURE_SRC)))

    it "c3b: but a destructuring that binds OTHER names does not refuse":
        step("c3b: but a destructuring that binds OTHER names does not refuse")
        """NARROWED round 4. Round 3 asked for destructuring to COUNT AS A
        BINDING; what landed was stricter — any non-plain binding made the
        whole FUNCTION uninspectable, so `val (a, b) = pair()` refused a fix
        for an array the pattern does not bind at all. That was the single
        largest remaining cause of refusals across the tree's real dedup
        sites. Only the names the pattern actually binds count now, and a
        pattern this cannot read still refuses the function (c3c)."""
        val other_names = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        val (a, b) = (x, x + 1)\n        if not seen.contains(a):\n            seen.push(a)\n    seen\n"
        assert_true(is_some(fix020(other_names)))

    it "c3c: a pattern form this cannot read still refuses the function":
        step("c3c: a pattern form this cannot read still refuses the function")
        """The relaxation is bounded by a charset: identifiers, `(`, `)`, `,`
        and spaces. A list pattern contains `[`, is not modelled, and takes
        the whole function with it — the fail-closed default is unchanged for
        everything outside what can be read."""
        val list_pattern = "fn f(xs: [[i64]]) -> [i64]:\n    var seen: [i64] = []\n    for g in xs:\n        val [p, q] = g\n        if not seen.contains(p):\n            seen.push(p)\n    seen\n"
        assert_false(is_some(fix020(list_pattern)))

    it "c4: a call on an indexed receiver mutates the array":
        step("c4: a call on an indexed receiver mutates the array")
        """`seen[0].push(7)` has receiver EXPR_INDEX, not EXPR_IDENT, so the
        old check saw a call on nothing at all: 1 -> 3. A receiver that
        MENTIONS the tracked array without BEING it reaches the same storage
        through a shape this analysis does not model, and is unsafe."""
        assert_false(is_some(fix020(C4_INDEX_RECEIVER_SRC)))

    it "still fixes the plain single-array dedup (non-vacuity)":
        step("still fixes the plain single-array dedup (non-vacuity)")
        """Fail-closed defaults are only worth having if something still
        passes them; six refusals in a row prove nothing on their own."""
        val plain = "fn dedup(xs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for x in xs:\n        if not out.contains(x):\n            out.push(x)\n    out\n"
        assert_true(is_some(fix020(plain)))

# ---------------------------------------------------------------------------
# Round 4: five more, one level down. The STATEMENT traversal was generic;
# the EXPRESSION traversal was still an allow-list, and `expr_child_exprs`
# yields neither child STATEMENTS (a `do:`/`unsafe:` block, a block-bodied
# lambda) nor MATCH ARMS. Plus string interpolation, which is opaque at this
# stage. Every expression walker now also recurses through
# `expr_child_stmts` / `expr_child_arms`, `coll_expr_kind_known` mirrors
# `coll_stmt_kind_known` so an unknown expression kind makes the function
# uninspectable, and a string literal with an interpolation hole that names
# the array counts as a use. Record: doc/08_tracking/bug/
# coll_certain_fix_textual_proofs_disagree_with_parser_2026-09-19.md
#
# The `{` in the two interpolation fixtures is built by concatenation: a
# literal brace in this spec's own source is interpolated HERE, in the spec's
# scope, and never reaches the linter.
# ---------------------------------------------------------------------------

val D1_INTERP_PRINT_SRC = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        if x == 2:\n            print \"" + "{" + "seen.pop()" + "}" + "\"\n    seen\n"
val D1B_INTERP_VAL_SRC = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        if x == 2:\n            val m = \"last=" + "{" + "seen.pop()" + "}" + "\"\n    seen\n"
val D1C_INTERP_COLL002_SRC = "fn f(xs: [i64]) -> [i64]:\n    var allowed: [i64] = [1, 2]\n    var out: [i64] = []\n    for x in xs:\n        if allowed.contains(x):\n            out.push(x)\n        if x == 2:\n            print \"" + "{" + "allowed.pop()" + "}" + "\"\n    out\n"
val D2_UNSAFE_BLOCK_SRC = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        if x == 2:\n            unsafe:\n                val d = seen.pop()\n    seen\n"
val D3_MATCH_EXPR_SRC = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        val r = match x:\n            case 2: seen.pop()\n            case _: 0\n    seen\n"

describe "round 4: expression traversal is generic too":
    it "d1: an interpolation hole that names the array is a use":
        step("d1: an interpolation hole that names the array is a use")
        """`print "{seen.pop()}"` parses as a plain EXPR_STRING_LIT whose text
        is the literal `{seen.pop()}`, with zero child expressions, so the
        mutation was invisible to every AST walk: [1,3] -> [3]. Interim rule,
        fail-closed: a literal with a hole that mentions the name as a bare
        token counts as a use. The real fix is for the parser to expose holes
        as child expressions — filed as doc/02_requirements/feature/
        parser_interpolation_holes_as_child_expressions.md."""
        assert_false(is_some(fix020(D1_INTERP_PRINT_SRC)))

    it "d1b: the same hole inside a `val` initializer":
        step("d1b: the same hole inside a `val` initializer")
        assert_false(is_some(fix020(D1B_INTERP_VAL_SRC)))

    it "d1c: the COLL002 sibling refuses an interpolated mutation too":
        step("d1c: the COLL002 sibling refuses an interpolated mutation too")
        """`print "{allowed.pop()}"` shrank the array the Dict was built
        from: [1,2] -> [1,2,2]."""
        assert_false(is_some(fix002(D1C_INTERP_COLL002_SRC)))

    it "d2: an `unsafe:` block body is walked":
        step("d2: an `unsafe:` block body is walked")
        """An expression-level block carries STATEMENTS, and
        `expr_child_exprs` yields none of them, so `val d = seen.pop()`
        inside `unsafe:` was invisible: [1,3] -> [3]. Every expression walker
        now recurses through `expr_child_stmts` as well."""
        assert_false(is_some(fix020(D2_UNSAFE_BLOCK_SRC)))

    it "d3: a `match` EXPRESSION's arms are walked":
        step("d3: a `match` EXPRESSION's arms are walked")
        """`val r = match x: case 2: seen.pop()` hangs its arms off an
        EXPRESSION, not a statement, and `expr_child_arms` was never
        consulted: [1,3] -> [3]."""
        assert_false(is_some(fix020(D3_MATCH_EXPR_SRC)))

    it "a reader result may flow into a call argument":
        step("a reader result may flow into a call argument")
        """Coverage, not safety. `print(seen.len())` passes a FRESH value, so
        it tells the callee nothing about `seen` and cannot mutate it — but
        the old rule refused any argument that merely mentioned the name, and
        that alone accounted for ~24 of the 68 real dedup sites in the tree.
        Passing the array ITSELF is still refused, immediately below."""
        val reader_arg = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        print(seen.len())\n    seen\n"
        assert_true(is_some(fix020(reader_arg)))

    it "but the array itself may not":
        step("but the array itself may not")
        val escapes = "fn grow(a: [i64], v: i64):\n    a.push(v)\n\nfn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        grow(seen, x)\n    seen\n"
        assert_false(is_some(fix020(escapes)))

# ---------------------------------------------------------------------------
# Per-site rendering: one Dict per DECLARATION, not per site.
#
# Round 4 replaced the old "exactly one candidate in the whole file" admission
# rule — obsolete once proofs carry exact lines — with per-site rendering, and
# that alone took coverage from 5/68 real dedup sites to 8/68. For COLL020 two
# safe candidates on the same array cannot coexist (the second's push is a
# mutation the first does not permit), but for COLL002 they can: `contains` is
# a READER, so a lookup table read in two loops proves safe at both, and
# rendering both inserted `var known_set: Dict<...>` after the SAME declaration
# twice — a duplicate binding, i.e. exactly the class of wrong rewrite this
# whole file exists to stop. Safe proofs are therefore deduped by
# (receiver, declaration line): the first site renders, the rest keep their
# warning and get no fix.
# ---------------------------------------------------------------------------

fn all_certain_replacements(src: text) -> [Replacement]:
    var all: [Replacement] = []
    for fix in collection_certain_fixes("/tmp/certain_safety.spl", src):
        for r in easyfix_replacements(fix):
            all.push(r)
    all

fn applied_all(src: text) -> text:
    easyfix_apply_sorted_replacements(
        src, easyfix_sort_replacements_descending(all_certain_replacements(src)))

describe "per-site rendering inserts one Dict per declaration":
    it "two COLL002 reads of one un-mutated table hoist the Dict once":
        step("two COLL002 reads of one un-mutated table hoist the Dict once")
        """`known` is never mutated, so BOTH loops yield a safe COLL002 proof.
        Rendering both would emit two `var known_set` declarations after the
        one `val known` — a duplicate binding. Exactly one is emitted."""
        val two_reads = "fn f(xs: [i64], ys: [i64]) -> i64:\n    val known: [i64] = [1, 2, 3]\n    var n = 0\n    for x in xs:\n        if known.contains(x):\n            n = n + 1\n    for y in ys:\n        if known.contains(y):\n            n = n + 1\n    n\n"
        val out = applied_all(two_reads)
        assert_equal(1, out.split("var known_set").len() - 1)

    it "two independent arrays each get their own Dict":
        step("two independent arrays each get their own Dict")
        """Per-site rendering must still be a net gain: distinct receivers
        have distinct declarations, distinct generated names and disjoint
        edits, so both sites are fixed in one pass."""
        val two_arrays = "fn f(xs: [i64], ys: [i64]) -> i64:\n    val alpha: [i64] = [1, 2, 3]\n    val beta: [i64] = [4, 5, 6]\n    var n = 0\n    for x in xs:\n        if alpha.contains(x):\n            n = n + 1\n    for y in ys:\n        if beta.contains(y):\n            n = n + 1\n    n\n"
        val out = applied_all(two_arrays)
        assert_equal(1, out.split("var alpha_set").len() - 1)
        assert_equal(1, out.split("var beta_set").len() - 1)

# ---------------------------------------------------------------------------
# Aliasing the array into a second binding.
#
# Found by re-running the fixture corpus through the real CLI after the
# per-site and destructuring changes: `var alias = seen` and `d["k"] = seen`
# were NOT treated as escapes, and a fix was offered. A/B by execution says
# every one of them is harmless — Simple copies an array on assignment, so
# `alias.pop()` leaves `seen` at [1,2,3]. That is a language fact this proof
# would be INHERITING rather than establishing, and an unstated language
# assumption is the exact shape that produced the earlier wrong rewrites. So
# it fails closed like any other escape: a bare mention of the array on the
# right of an assignment, or as a binding's initializer, is a use.
# ---------------------------------------------------------------------------

describe "handing the array to a second binding is an escape":
    it "e1: `var alias = seen` refuses, even though it copies today":
        step("e1: `var alias = seen` refuses, even though it copies today")
        val var_alias = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        if x == 2:\n            var alias = seen\n            alias.pop()\n    seen\n"
        assert_false(is_some(fix020(var_alias)))

    it "e2: `d[\"k\"] = seen` refuses too":
        step("e2: `d[\"k\"] = seen` refuses too")
        """The array on the RIGHT of an assignment, where the target is an
        index into something else. The old rule checked only the assignment
        TARGET, so this was invisible."""
        val dict_alias = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var d: Dict<text, [i64]> = " + "{" + "}" + "\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        d[\"k\"] = seen\n        d[\"k\"].push(x + 10)\n    seen\n"
        assert_false(is_some(fix020(dict_alias)))

    it "e3: a reader result may still be bound (non-vacuity)":
        step("e3: a reader result may still be bound (non-vacuity)")
        """`val n = seen.len()` binds a FRESH value, not a handle to the
        array, so it stays fixable — the rule is about the array itself."""
        val reader_bound = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n        val n = seen.len()\n    seen\n"
        assert_true(is_some(fix020(reader_bound)))

    it "e4: iterating the array is a read, not a handle":
        step("e4: iterating the array is a read, not a handle")
        """A `for` statement's expression is the ITERABLE and its binding is
        the ELEMENT, so `for v in seen:` hands nothing to anyone. The first
        cut of e1/e2 applied the escape rule to every binding form and
        refused two real sites in the tree for a hazard that is not there;
        it applies to declarations only."""
        val iterate = "fn f(xs: [i64]) -> i64:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n    var n = 0\n    for v in seen:\n        n = n + v\n    n\n"
        assert_true(is_some(fix020(iterate)))

# ---------------------------------------------------------------------------
# Methods, and an honest correction.
#
# Round 4's commit message claimed the method walk was "warning-only; the
# Certain fix envelope is untouched". That was WRONG, and an adversarial
# review caught it: a method-local `var seen` that no rule could previously
# see now gets a COLL020 fix, because the proofs run over whatever function
# bodies the walk hands them. The rewrites are output-identical, so the
# widening is sound — but it happened incidentally, and something the fix
# envelope covers must be pinned deliberately.
# ---------------------------------------------------------------------------

describe "method bodies are inside the fix envelope, deliberately":
    it "m1: a method-local dedup is proven and fixed":
        step("m1: a method-local dedup is proven and fixed")
        val method_local = "class Box:\n    var items: [text]\n\n    fn uniq(self) -> [text]:\n        var seen: [text] = []\n        for it in self.items:\n            if not seen.contains(it):\n                seen.push(it)\n        seen\n"
        assert_true(is_some(fix020(method_local)))

    it "m2: and the same proofs still refuse inside a method":
        step("m2: and the same proofs still refuse inside a method")
        """The envelope must not be weaker in a method than at top level: the
        proofs are whole-FUNCTION, and a method body is a function body. A
        mutation elsewhere in the method refuses exactly as it would in a
        free function."""
        val method_mutated = "class Box:\n    var items: [text]\n\n    fn uniq(self) -> [text]:\n        var seen: [text] = []\n        for it in self.items:\n            if not seen.contains(it):\n                seen.push(it)\n            if it == \"x\":\n                val d = seen.pop()\n        seen\n"
        assert_false(is_some(fix020(method_mutated)))

    it "m3: a method receiver field is not a local, so it is not fixed":
        step("m3: a method receiver field is not a local, so it is not fixed")
        """`self.items` is not a local declaration the proof can find, and
        the dominance proof requires one."""
        val field_recv = "class Box:\n    var items: [text]\n\n    fn add(self, xs: [text]):\n        for x in xs:\n            if not self.items.contains(x):\n                self.items.push(x)\n"
        assert_false(is_some(fix020(field_recv)))
