use std.nogc_sync_mut.io.file_ops.{file_read}

describe "query lint AST projection contract":
    it "fails closed through the checked parser boundary":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain("parse_module_silent_checked(source, file)")
        expect(source).to_contain("error[PARSE001]")
        expect(source).to_contain("return 1")
        expect(source).not.to_contain("use compiler.core.ast.{ast_reset")

    it "keeps untyped collection findings advisory and explains uncertainty":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain("source-pattern fallback; receiver type, effects, aliasing, and mutation version are unresolved")
        expect(source).to_contain("warning[{w.code}]: {w.message}")
        expect(source).to_contain("{\\\"severity\\\":2,\\\"code\\\":\\\"{w.code}\\\"")
        expect(source).to_contain("\\\"confidence\\\":\\\"source-pattern\\\"")
        expect(source).to_contain("\\\"evidence\\\":[")
        expect(source).to_contain("\\\"uncertainty\\\":\\\"")

    it "governs collection suppression without profile escalation":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain("\"COLL001\"")
        expect(source).to_contain("\"COLL019\"")
        expect(source).to_contain("if not code.starts_with(\"COLL\")")

    it "reuses one source view and indexed AST fallback locations":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain(
            "source, source_locations, file, format)")
        expect(source).to_contain("_query_ast_lint_location_index(lines)")
        expect(source).to_contain("_query_callable_line(locations, w.item_name)")
        expect(source).to_contain("_query_wildcard_line(locations, keyword, w.module_path)")
        expect(source).not.to_contain("val lines = source.split(\"\\n\")")
        expect(source).not.to_contain("fn _find_fn_line_in_source")

    it "projects GC-boundary imports from the same indexed source view":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain(
            "source_module, source_locations.imported_modules")
        expect(source).to_contain(
            "source_locations.import_lines[imported] ?? 1")
        expect(source).not.to_contain("fn _find_use_line_in_source")
