use std.nogc_sync_mut.io.file_ops.{file_read}

describe "query lint AST projection contract":
    it "fails closed through the checked parser boundary":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain("parse_module_silent_checked(source, file)")
        expect(source).to_contain("error[PARSE001]")
        expect(source).to_contain("return 1")
        expect(source).not.to_contain("use compiler.core.ast.{ast_reset")

    it "keeps untyped collection findings advisory and explains uncertainty":
        val source = file_read("src/app/cli/query_lint.spl")
        expect(source).to_contain("source-pattern fallback; receiver type, effects, aliasing, and mutation version are unresolved")
        expect(source).to_contain("warning[{w.code}]: {advisory_message}")
        expect(source).to_contain("{\\\"severity\\\":2,\\\"code\\\":\\\"{w.code}\\\"")
