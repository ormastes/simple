# Regression: len() counts scalars but slice() takes byte offsets.
# Bug: doc/08_tracking/bug/summary_store_publish_read_absent_2026-11-26.md
use std.spec.*
use std.spec.step
use compiler.semantics.lint.riscv_rtl_debuggability_lint.{_replace_suffix, _after, _extract_json_string, _extract_manifest_text_value, _count_substring, _extract_vhdl_header_value}
use compiler.tools.fix.rules.impl_.lint_bool.{_bool_param_name}

describe "riscv rtl debuggability lint helpers on non-ASCII text":
    it "replaces a suffix of a non-ASCII path":
        step("replace .vhd on a non-ASCII path")
        expect(_replace_suffix("é한😀/core.vhd", ".vhd", ".json")).to_equal("é한😀/core.json")

    it "slices after a non-ASCII needle":
        step("after/header/json/manifest extraction with non-ASCII keys")
        expect(_after("aé한😀b", "é한")).to_equal("😀b")
        expect(_extract_vhdl_header_value("-- é한😀: v1;", "é한😀: ", ";")).to_equal("v1")
        expect(_extract_json_string("{{\"é한😀\":\"v\"}", "é한😀")).to_equal("v")
        expect(_extract_manifest_text_value("é한😀 = \"v\"", "é한😀")).to_equal("v")

    it "counts every occurrence in non-ASCII text":
        step("count x in non-ASCII text")
        expect(_count_substring("é한😀xé한😀xé한😀x", "x")).to_equal(3)

describe "lint_bool param name on non-ASCII path":
    it "keeps the full non-ASCII param name":
        step("param name after .param.")
        expect(_bool_param_name("mod.é한😀.param.é한😀")).to_equal("é한😀")
