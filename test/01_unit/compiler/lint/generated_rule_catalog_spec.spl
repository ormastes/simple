# Purpose and audience: executable generated lint catalog evidence for lint maintainers.
# @req REQ-KPF-009
# @tag: unit, lint, catalog, generated, non_vacuous

use std.spec
use std.spec.step
use compiler.tools.lint._LintMain.config_and_model.*

describe "generated lint rule catalog":
    it "projects every canonical rule into every profile":
        step("uses one catalog for names defaults and profile levels")
        val rules = canonical_lint_rule_profile_descriptors()
        assert_true(rules.len() > 50)
        assert_equal(rules.len(), canonical_lint_rule_descriptors().len())
        var found_nonexistent_type = false
        var found_collection_performance = false
        for rule in rules:
            if rule.name == "nonexistent_type":
                found_nonexistent_type = true
                assert_equal(rule.strict_level, "warn")
            if rule.name == "collection_performance":
                found_collection_performance = true
                assert_equal(rule.moderate_level, "warn")
                assert_equal(rule.robust_level, "deny")
                assert_equal(rule.critical_level, "deny")
        assert_true(found_nonexistent_type)
        assert_true(found_collection_performance)

    it "rejects unknown names without a second authority table":
        step("proves catalog membership includes the formerly omitted rule")
        val defaults = build_default_levels()
        assert_true(defaults.contains_key("nonexistent_type"))
        assert_false(defaults.contains_key("not_a_real_lint"))
