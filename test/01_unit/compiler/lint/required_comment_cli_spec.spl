# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Required Comment CLI Lint Coverage

WP-7 (aerospace hardening plan): `bin/simple lint`'s real output path
(`lint_cli_source`) is wired to the AST-based semantic checker
(`compiler.semantics.lint.required_comment.check_required_comment`), not the
former per-line text scanner. `Linter.lint_source` alone (no AST decls) can
no longer emit REQC001-004 — the loop lives in `lint_cli_source`
(entry_and_fixes.spl), same as STUB001/STUB002. See
doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md WP-7.
"""

use compiler.tools.lint.main.{Linter, lint_cli_source}

fn has_code(results, code: text) -> bool:
    for r in results:
        if r.lint.code == code:
            return true
    false

fn count_code(results, code: text) -> i64:
    var n = 0
    for r in results:
        if r.lint.code == code:
            n = n + 1
    n

describe "required comment lint CLI path":
    """
    Proves `lint_cli_source` — the entry point `bin/simple lint` actually
    calls — is wired to the AST-based `check_required_comment` semantic
    checker for REQC001-004, and that the deleted text reimplementation's
    per-line blind spots (multi-line calls) no longer false-positive.
    """
    it "emits REQC001 through lint_cli_source for a bare pass_todo":
        var linter = Linter.new()
        val results = lint_cli_source(linter, "sample.spl", "fn f():\n    pass_todo\n")
        assert_true(has_code(results, "REQC001"))

    it "emits REQC003 (not REQC001) through lint_cli_source for a weak bare todo(...)":
        # Fixed finding, filed as
        # doc/08_tracking/bug/todo_call_collapses_to_pass_todo_node_reqc003_unreachable_2026-08-07.md:
        # the parser (parser_stmts.spl / primary_expr.spl, `ident_text ==
        # "todo"`) desugars `todo(...)` into the same `expr_pass_todo` AST
        # node (tag 40) as bare `pass_todo(...)`, but now via
        # `expr_pass_todo_call`, which marks the node's `extra` field with 1
        # to record it came from a real `todo(...)` call rather than the
        # `pass_todo` keyword. `check_required_comment` reads that marker and
        # applies the todo-specific two-string (what-remains + hint) check,
        # so a weak `todo("fix")` is now REQC003, not REQC001.
        # `required_comment_lint_spec.spl` still separately proves the
        # hand-constructed `expr_call` shape's REQC003 branch is correct too.
        var linter = Linter.new()
        val results = lint_cli_source(linter, "sample.spl", "fn f():\n    todo(\"fix\")\n")
        assert_true(has_code(results, "REQC003"))
        assert_false(has_code(results, "REQC001"))

    it "emits no REQC003 through lint_cli_source for a well-formed todo(...) with both strings":
        var linter = Linter.new()
        val results = lint_cli_source(linter, "sample_ok.spl", "fn f():\n    todo(\"finish the parser change\", \"see bug doc for the plan\")\n")
        assert_false(has_code(results, "REQC003"))
        assert_false(has_code(results, "REQC001"))

    it "still emits REQC001 (not REQC003) through lint_cli_source for the bare pass_todo keyword":
        # The pass_todo KEYWORD (not the todo(...) call) must keep its
        # existing REQC001 semantics -- only real todo(...) calls get the
        # extra==1 marker and the REQC003 two-string check.
        var linter = Linter.new()
        val results = lint_cli_source(linter, "sample_kw.spl", "fn f():\n    pass_todo(\"fix\")\n")
        assert_true(has_code(results, "REQC001"))
        assert_false(has_code(results, "REQC003"))

    it "emits REQC004 through lint_cli_source for an unrationalized wildcard arm":
        var linter = Linter.new()
        val results = lint_cli_source(linter, "sample.spl", "fn f():\n    match x:\n        case _: 0\n")
        assert_true(has_code(results, "REQC004"))

    it "emits REQC004 through the production lint path for if val wildcard binding":
        var linter = Linter.new()
        val source = "fn f(value: i64?):\n    if val _ = value:\n        return\n"
        val results = lint_cli_source(linter, "if_val_wildcard.spl", source)
        assert_true(has_code(results, "REQC004"))

    it "emits REQC004 through the production lint path for if var wildcard binding":
        var linter = Linter.new()
        val source = "fn f(value: i64?):\n    if var _ = value:\n        return\n"
        val results = lint_cli_source(linter, "if_var_wildcard.spl", source)
        assert_true(has_code(results, "REQC004"))

    it "accepts a rationalized wildcard if-binding through the production lint path":
        var linter = Linter.new()
        val source = "fn f(value: i64?):\n    if val _(\"all values intentionally ignored here\") = value:\n        return\n"
        val results = lint_cli_source(linter, "if_val_rationale.spl", source)
        assert_false(has_code(results, "REQC004"))

    it "emits exactly ONE REQC001 for a single-violation probe, not two":
        # Acceptance criterion (c): with the old text reimplementation
        # deleted, only the AST-based checker can fire REQC001 — a bare
        # pass_todo must produce exactly one diagnostic, not one from each
        # of two live implementations.
        var linter = Linter.new()
        val results = lint_cli_source(linter, "sample_single.spl", "fn g():\n    pass_todo\n")
        expect(count_code(results, "REQC001")).to_equal(1)

    it "does NOT false-positive REQC001 on a multi-line pass_todo with a real rationale":
        # The disagreement case: the deleted text scanner checked ONE
        # physical line at a time. `normalized.starts_with("pass_todo(")`
        # on the opening-paren line alone (nothing else on that line) found
        # no quoted string on THAT line and reported REQC001 even though the
        # call carries a perfectly good rationale on the next line. The
        # AST-based checker reads the real string-literal argument node
        # regardless of which line it is printed on, so it must NOT flag
        # this call.
        var linter = Linter.new()
        val source = "fn h():\n    pass_todo(\n        \"long enough rationale for this deferred work\",\n        \"tracked by SIMPLE-999\"\n    )\n"
        val results = lint_cli_source(linter, "sample_multiline.spl", source)
        assert_false(has_code(results, "REQC001"))
