# @req: REQ-COMPILER-LINT-001

# PARSE001 False-Positive on Spec-DSL Files Specification
#
# Verifies the fix for doc/08_tracking/bug/
# lint_parse001_false_positive_on_spec_files_2026-07-29.md: `bin/simple lint`
# reported `error[PARSE001]: Source did not parse` on ANY `_spec.spl` file
# using the `describe`/`it` DSL, because the pure-Simple frontend parser
# (src/compiler/10.frontend/core) never implemented two grammar shapes the
# Rust seed parser (src/compiler_rust/parser) already had:
#
#   1. Trailing colon-block sugar: `callee(args):` / `recv.method(args):`
#      with an indented body becoming an implicit lambda argument
#      (`describe("x"): ...` -> `describe("x", fn(): ...)`). Fixed in
#      src/compiler/10.frontend/core/parser_stmts.spl
#      (parse_trailing_colon_block_arg) and
#      src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl
#      (module-level fallback).
#   2. No-paren calls with a single string argument: `describe "x":` (the
#      dominant DSL shape — ~24k spec files use this form vs. ~80 using
#      `describe("x"):`). Fixed via
#      parser_stmts.spl's try_parse_bare_ident_string_call.
#
# This spec drives the lint parser directly (compiler.core.parser's
# parse_module_silent_checked) rather than the full lint tool graph — running
# the lint tool's module graph and the real frontend driver in one
# interpreter session is a known landmine ("cannot convert dict to int");
# keeping this probe to the parser entry point alone avoids it.

use std.spec.*
use compiler.core.parser.{parse_module_silent_checked, parser_has_errors, parser_set_had_error}

fn parses_clean(source: text) -> bool:
    val previous = parser_has_errors()
    val failed = parse_module_silent_checked(source, "parse001_spec_files_spec_fixture.spl")
    parser_set_had_error(previous)
    not failed


describe "PARSE001 on describe/it spec-DSL sources":
    """
    ## PARSE001 false positive on spec-DSL files

    The lint parser must accept the `describe`/`it` block-call DSL (both the
    paren and no-paren-with-trailing-colon-block forms) that the real
    compiler and test runner already execute green, while still rejecting
    genuinely malformed sources.
    """

    context "minimal describe/it fixtures":

        it "accepts the no-paren `describe \"x\":` / `it \"x\":` form (the dominant spec-file shape)":
            # @req: REQ-COMPILER-LINT-001
            step("Verify: accepts the no-paren describe")
            val source = "use std.spec.*\n\ndescribe \"d\":\n    it \"passes\":\n        expect(1).to_equal(1)\n"  # oracle: 1 — named expected value from the requirement
            expect(parses_clean(source)).to_be_true()

        it "accepts the paren `describe(\"x\"):` / `it(\"x\"):` form":
            # @req: REQ-COMPILER-LINT-001
            step("Verify: accepts the paren describe(")
            val source = "use std.spec.*\n\ndescribe(\"d\"):\n    it(\"passes\"):\n        expect(1).to_equal(1)\n"  # oracle: 1 — named expected value from the requirement
            expect(parses_clean(source)).to_be_true()

        it "accepts a bare module-level call-with-block unrelated to spec (general grammar, not a special case)":
            # @req: REQ-COMPILER-LINT-001
            step("Verify: accepts a bare module-level call-with-block unrelated to spec (general grammar, not a special case)")
            val source = "fn my_block(name: text, body: fn() -> void):\n    body()\n\nmy_block(\"d\"):\n    print(1)\n"
            expect(parses_clean(source)).to_be_true()

        it "accepts nested context blocks with step()/assert_* calls (bug doc's original repro shape)":
            # @req: REQ-COMPILER-LINT-001
            step("Verify: accepts nested context blocks with step()/assert_* calls (bug doc's original repro shape)")
            val source = "use std.spec.*\n\ndescribe \"Stage-4 memory gate sampler\":\n    it \"records rows\":\n        step(\"Prepare\")\n        val rc = 0\n        assert_equal(rc, 0)\n"
            expect(parses_clean(source)).to_be_true()

    context "genuinely broken sources (the rule must not be neutered)":

        it "still reports PARSE001 on an unclosed call (missing paren)":
            # @req: REQ-COMPILER-LINT-001
            step("Verify: still reports PARSE001 on an unclosed call (missing paren)")
            val source = "use std.spec.*\n\ndescribe \"d\":\n    it \"broken\":\n        expect(1.to_equal(1)\n"  # oracle: 1 — named expected value from the requirement
            expect(parses_clean(source)).to_be_false()

        it "still reports PARSE001 on a dangling colon with no block at all":
            # @req: REQ-COMPILER-LINT-001
            step("Verify: still reports PARSE001 on a dangling colon with no block at all")
            val source = "use std.spec.*\n\ndescribe(\"d\"):"
            expect(parses_clean(source)).to_be_false()
