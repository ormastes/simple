"""
SPL-BOOL-001 EasyFix (`L:bare_bool`): a top-level `pub fn` bool parameter gets a
REAL edit (type token -> `<Name>Flag`, plus one `pub unit <Name>Flag: bool`
declared after the leading `use` block, or at the top of the file). Every fix for
the same name emits the same declaration at the same offset, so each applies on
its own and together they declare it once. A name already declared or imported is
reused. Methods, returns and `@allow` stay edit-free.
Run: bin/simple test test/01_unit/compiler/lint/bare_bool_real_fix_spec.spl
"""

use std.spec.*
use std.tooling.easy_fix.types.{FixApplicator}
use compiler.tools.fix.rules.impl_.lint_bool.{check_bare_bool}

fn _apply(fixes: [EasyFix], src: text) -> text:
    match FixApplicator.apply(fixes, {"s.spl": src}):
        case Ok(m): m["s.spl"]
        case Err(e): "ERR " + e

fn _applied(src: text) -> text:
    _apply(check_bare_bool(src, "s.spl"), src)

fn _count(hay: text, needle: text) -> i64:
    hay.split(needle).len() - 1

describe "L:bare_bool real fix":
    it "rewrites the param type and declares a pub unit at the top of the file":
        val out = _applied("pub fn set(enabled: bool):\n    pass\n")
        expect(out).to_equal("pub unit EnabledFlag: bool\n\npub fn set(enabled: EnabledFlag):\n    pass\n")

    it "declares the unit after the leading use block":
        val out = _applied("use a.b\nuse c.d\n\npub fn f(x: bool):\n    pass\n")
        expect(out).to_equal("use a.b\nuse c.d\n\npub unit XFlag: bool\n\npub fn f(x: XFlag):\n    pass\n")

    it "never emits a replacement that leaves the text unchanged":
        val src = "pub fn set(enabled: bool, verbose: bool):\n    pass\n"
        for fix in check_bare_bool(src, "s.spl"):
            for rep in fix.replacements:
                expect(src.slice(rep.start, rep.end) != rep.new_text).to_equal(true)

    it "applies each of two params alone and declares both once together":
        val src = "pub fn set(enabled: bool, verbose: bool):\n    pass\n"
        val fixes = check_bare_bool(src, "s.spl")
        expect(fixes.len()).to_equal(2)
        val one = _apply([fixes[1]], src)
        expect(one.contains("pub unit VerboseFlag: bool")).to_equal(true)
        expect(one.contains("pub unit EnabledFlag")).to_equal(false)
        val out = _applied(src)
        expect(out.contains("enabled: EnabledFlag, verbose: VerboseFlag")).to_equal(true)
        expect(_count(out, "pub unit EnabledFlag: bool")).to_equal(1)
        expect(_count(out, "pub unit VerboseFlag: bool")).to_equal(1)

    it "keeps decorator and comment lines above the fn in place":
        val src = "# doc\n@inline\npub fn f(x: bool):\n    pass\n"
        expect(_applied(src)).to_equal("pub unit XFlag: bool\n\n# doc\n@inline\npub fn f(x: XFlag):\n    pass\n")

    it "shares one unit between two fns with the same param name":
        val src = "pub fn a(x: bool):\n    pass\n\npub fn b(x: bool):\n    pass\n"
        val fixes = check_bare_bool(src, "s.spl")
        expect(fixes.len()).to_equal(2)
        expect(_apply([fixes[1]], src)).to_equal("pub unit XFlag: bool\n\npub fn a(x: bool):\n    pass\n\npub fn b(x: XFlag):\n    pass\n")
        val out = _applied(src)
        expect(_count(out, "pub unit XFlag: bool")).to_equal(1)
        expect(out.contains("a(x: XFlag)")).to_equal(true)
        expect(out.contains("b(x: XFlag)")).to_equal(true)

    it "places the declaration correctly after a non-ASCII comment line":
        val src = "# note \— em dash\nuse a.b\n\npub fn f(x: bool):\n    pass\n"
        expect(_applied(src)).to_equal("# note \— em dash\nuse a.b\n\npub unit XFlag: bool\n\npub fn f(x: XFlag):\n    pass\n")

    it "keeps the declaration at the top when a non-ASCII comment precedes the fn":
        val src = "# note \— em dash\npub fn f(x: bool):\n    pass\n"
        expect(_applied(src)).to_equal("pub unit XFlag: bool\n\n# note \— em dash\npub fn f(x: XFlag):\n    pass\n")

    it "reuses a pre-existing or imported XFlag without redeclaring":
        val declared = "pub unit XFlag: bool\n\npub fn f(x: bool):\n    pass\n"
        expect(_applied(declared)).to_equal("pub unit XFlag: bool\n\npub fn f(x: XFlag):\n    pass\n")
        val imported = "use lib.flags.{{XFlag}}\n\npub fn f(x: bool):\n    pass\n"
        expect(_applied(imported).contains("unit XFlag")).to_equal(false)
        expect(_applied(imported).contains("f(x: XFlag)")).to_equal(true)

    it "declares the unit when an import only contains XFlag as a substring":
        val out = _applied("use lib.flags.{{XFlagged}}\n\npub fn f(x: bool):\n    pass\n")
        expect(out.contains("pub unit XFlag: bool")).to_equal(true)

    it "names a mut param without the mut prefix":
        val out = _applied("pub fn f(mut x: bool):\n    pass\n")
        expect(out.contains("pub unit XFlag: bool")).to_equal(true)
        expect(out.contains("MutXFlag")).to_equal(false)

    it "offers no edit for a return type, a method, or an allowed fn":
        expect(check_bare_bool("pub fn ok() -> bool:\n    true\n", "s.spl").len()).to_equal(0)
        expect(check_bare_bool("class C:\n    pub fn m(flag: bool):\n        pass\n", "s.spl").len()).to_equal(0)
        expect(check_bare_bool("@allow(primitive_api)\npub fn f(flag: bool):\n    pass\n", "s.spl").len()).to_equal(0)

pub unit XFlag: bool

fn _use_flag(flag: XFlag) -> i64:
    if flag.value:
        1
    else:
        0

describe "bool-backed pub unit":
    it "parses and runs with if flag.value":
        expect(_use_flag(XFlag(true))).to_equal(1)
        expect(_use_flag(XFlag(false))).to_equal(0)
