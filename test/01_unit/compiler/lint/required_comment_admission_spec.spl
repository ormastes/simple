use std.spec.*
use std.io_runtime.{file_read}
use compiler.semantics.lint.required_comment.{required_comment_source_may_match}

describe "required-comment lint admission":
    it "skips the deep AST walk for the large Zca builder when no REQC token exists":
        val source = file_read("src/compiler/50.mir/hwir/zca_rows.spl")
        assert_true(source.len() > 100000)
        assert_false(required_comment_source_may_match(source))

    it "keeps wildcard and registered dangerous-keyword inputs admitted":
        assert_true(required_comment_source_may_match("match x:\n    case _:\n        0"))
        assert_true(required_comment_source_may_match("unsafe_cast(value)"))

describe "required-comment admission helper is defined":
    it "source_may_contain_dangerous_keyword exists in the registry it is imported from":
        # 2026-08-21 regression: required_comment.spl imported this helper but
        # dangerous_keywords.spl had lost it to a stale-snapshot clobber, so
        # the lint chain failed with `semantic: function
        # source_may_contain_dangerous_keyword not found`.
        extern fn rt_file_read_text(path: text) -> text
        val reg = rt_file_read_text("src/compiler/10.frontend/core/dangerous_keywords.spl") ?? ""
        expect(reg).to_contain("fn source_may_contain_dangerous_keyword(")
