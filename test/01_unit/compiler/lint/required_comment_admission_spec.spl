use std.spec.*
use std.io_runtime.{file_read}
use compiler.semantics.lint.required_comment.{required_comment_source_may_match}
use compiler.tools.lint.main.{Linter, lint_cli_source}

fn admission_has_code(results, code: text) -> bool:
    for result in results:
        if result.lint.code == code:
            return true
    false

describe "required-comment lint admission":
    it "skips the deep AST walk for the large Zca builder when no REQC token exists":
        val source = file_read("src/compiler/50.mir/hwir/zca_rows.spl")
        assert_true(source.len() > 100000)
        assert_false(required_comment_source_may_match(source))

    it "keeps wildcard, formatted binding, and dangerous-keyword inputs admitted":
        assert_true(required_comment_source_may_match("match x:\n    case _:\n        0"))
        assert_true(required_comment_source_may_match("if val _ = value:\n    0"))
        assert_true(required_comment_source_may_match("if  val _ = value:\n    0"))
        assert_true(required_comment_source_may_match("if\tval _ = value:\n    0"))
        assert_true(required_comment_source_may_match("if var _ = value:\n    0"))
        assert_true(required_comment_source_may_match("if  var _ = value:\n    0"))
        assert_true(required_comment_source_may_match("if\tvar _ = value:\n    0"))
        assert_true(required_comment_source_may_match("elif val _ = fallback:\n    0"))
        assert_true(required_comment_source_may_match("elif  val _ = fallback:\n    0"))
        assert_true(required_comment_source_may_match("elif\tval _ = fallback:\n    0"))
        assert_true(required_comment_source_may_match("elif  var _ = fallback:\n    0"))
        assert_true(required_comment_source_may_match("elif\tvar _ = fallback:\n    0"))
        assert_true(required_comment_source_may_match("unsafe_cast(value)"))

    it "does not confuse substrings, longer identifiers, or newlines with if-binding tokens":
        assert_false(required_comment_source_may_match("different val _ = value"))
        assert_false(required_comment_source_may_match("if value"))
        assert_false(required_comment_source_may_match("elif variant"))
        assert_false(required_comment_source_may_match("if\nval _ = value"))

    it "preserves REQC004 through production admission for a spaced if-val binding":
        var linter = Linter.new()
        val spaced_if = lint_cli_source(linter, "spaced_if.spl", "fn f(value: i64?):\n    if  val _ = value:\n        return\n")
        assert_true(admission_has_code(spaced_if, "REQC004"))

    it "preserves REQC004 through production admission for a tabbed if-val binding":
        var linter = Linter.new()
        val tabbed_if = lint_cli_source(linter, "tabbed_if.spl", "fn f(value: i64?):\n    if\tval _ = value:\n        return\n")
        assert_true(admission_has_code(tabbed_if, "REQC004"))

    it "preserves REQC004 through production admission for a spaced elif-var binding":
        var linter = Linter.new()
        val spaced_elif = lint_cli_source(linter, "spaced_elif.spl", "fn f(value: i64?):\n    if false:\n        return\n    elif  var _ = value:\n        return\n")
        assert_true(admission_has_code(spaced_elif, "REQC004"))
