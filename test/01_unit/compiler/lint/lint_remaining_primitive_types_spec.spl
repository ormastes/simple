use std.io.{file_read}

describe "remaining lint module primitive boundaries":
    it "uses concrete imports and primitive annotations":
        val entry = file_read("src/compiler/90.tools/lint/_LintMain/entry_and_fixes.spl")
        val names = file_read("src/compiler/90.tools/lint/_LintMain/name_lints.spl")
        val os_lints = file_read("src/compiler/90.tools/lint/_LintMain/os_freestanding_lints.spl")
        val combined = entry + names + os_lints

        expect(combined.contains("use compiler.tools.lint.main.*")).to_equal(false)
        expect(entry).to_contain("easyfix_id, easyfix_description, easyfix_replacements")
        expect(names).to_contain("use compiler.tools.lint._LintMain.traceability_and_assertions.{indent_width}")
        expect(os_lints).to_contain("use compiler.tools.lint._LintMain.traceability_and_assertions.{indent_width}")
        expect(combined.contains(": Bool")).to_equal(false)
        expect(combined.contains(": Int")).to_equal(false)
        expect(combined.contains("-> Bool")).to_equal(false)
        expect(combined.contains("-> Int")).to_equal(false)
        expect(combined.contains("[Bool]")).to_equal(false)
        expect(combined.contains("[Int]")).to_equal(false)
        expect(names).to_contain("var prev: [i64] = []")
