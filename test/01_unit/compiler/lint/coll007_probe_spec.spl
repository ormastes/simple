use std.spec.*
use compiler.tools.lint.main.{Linter, lint_cli_source}

val DOTDOT_SRC = "fn drain(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[0..arr.len()-1]\n    arr\n"
val COLON_OPEN_SRC = "fn drain2(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[:-1]\n    arr\n"
val COLON_FULL_SRC = "fn drain3(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[0:arr.len()-1]\n    arr\n"

fn coll007_count(path: text, src: text) -> i64:
    var count = 0
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == "COLL007":
            count = count + 1
    count

describe "COLL007 probe":

    it "dotdot form":
        step("probe dotdot")
        print "DOTDOT count = {coll007_count(\"/tmp/coll007_dotdot.spl\", DOTDOT_SRC)}"

    it "colon open form":
        step("probe colon open")
        print "COLON_OPEN count = {coll007_count(\"/tmp/coll007_colon_open.spl\", COLON_OPEN_SRC)}"

    it "colon full form":
        step("probe colon full")
        print "COLON_FULL count = {coll007_count(\"/tmp/coll007_colon_full.spl\", COLON_FULL_SRC)}"
