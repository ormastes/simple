use std.spec
use compiler.interp.interpreter.{PatternRepr, PatternAnalysis}

describe "Pattern analysis exhaustiveness classification":

    it "preserves registered enum variant order while ignoring other enum names":
        val analysis = PatternAnalysis.create()
        analysis.register_enum("Direction", ["North", "East", "South", "West"])
        val result = analysis.analyze_match("Direction", [
            PatternRepr.Enum("Elsewhere", nil),
            PatternRepr.Enum("East", nil),
            PatternRepr.Enum("West", nil)
        ])

        expect(result.is_exhaustive).to_equal(false)
        expect(result.missing_patterns).to_equal(["North", "South"])

    it "classifies bool arms without changing missing-value order":
        val analysis = PatternAnalysis.create()
        val only_false = analysis.analyze_match("bool", [PatternRepr.LitBool(false)])
        val neither = analysis.analyze_match("bool", [PatternRepr.LitInt(1)])

        expect(only_false.missing_patterns).to_equal(["true"])
        expect(neither.missing_patterns).to_equal(["true", "false"])

    it "keeps wildcard and identifier arms exhaustive":
        val analysis = PatternAnalysis.create()
        analysis.register_enum("Direction", ["North", "South"])

        expect(analysis.analyze_match("Direction", [PatternRepr.Wildcard]).is_exhaustive).to_equal(true)
        expect(analysis.analyze_match("bool", [PatternRepr.Identifier("value")]).is_exhaustive).to_equal(true)
