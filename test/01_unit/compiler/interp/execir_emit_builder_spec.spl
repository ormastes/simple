"""Regression coverage for ExecIR's single-owner code emitter."""

# @req: REQ-COMPILER-INTERP-001

use std.spec.*
use std.io_runtime.{file_read}
use compiler.interp.execir.{
    ExecIrEncoder, ExecIrFnPlan, ExecIrCodeBuilder,
    execir_emit4, execir_emit_function, execir_encode_call
}
use compiler.mir.mir_instructions.*
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default}

fn xe_local(id: i64, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: MirType.i64(),
             kind: kind, is_ghost: false)

fn xe_lid(id: i64) -> LocalId:
    LocalId(id: id)

fn xe_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn xe_block(id: i64, insts: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId.new(id), label: nil, instructions: insts,
             terminator: term)

fn xe_fn(name: text, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId.new(-1), name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(),
                                is_variadic: false),
        locals: locals, blocks: blocks, entry_block: BlockId.new(0),
        span: nil, generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil,
        is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0,
        verification_contract: nil
    )

fn xe_callee(name: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name), MirType.i64()))

fn xe_all_opcodes_entry() -> MirFunction:
    var locals: [MirLocal] = []
    locals.push(xe_local(0, LocalKind.Arg(0)))
    var li = 1
    while li <= 24:
        locals.push(xe_local(li, LocalKind.Temp))
        li = li + 1

    var insts: [MirInst] = [
        xe_inst(MirInstKind.Const(xe_lid(1), MirConstValue.Int(7), MirType.i64())),
        xe_inst(MirInstKind.Const(xe_lid(2), MirConstValue.Bool(true), MirType.bool())),
        xe_inst(MirInstKind.Copy(xe_lid(3), xe_lid(1))),
        xe_inst(MirInstKind.Move(xe_lid(4), xe_lid(3)))
    ]
    val ops = [
        MirBinOp.Add, MirBinOp.Sub, MirBinOp.Mul, MirBinOp.Div, MirBinOp.Rem,
        MirBinOp.Eq, MirBinOp.Ne, MirBinOp.Lt, MirBinOp.Le, MirBinOp.Gt,
        MirBinOp.Ge, MirBinOp.BitAnd, MirBinOp.BitOr, MirBinOp.BitXor,
        MirBinOp.Shl, MirBinOp.Shr
    ]
    var oi = 0
    while oi < ops.len():
        insts.push(xe_inst(MirInstKind.BinOp(
            xe_lid(5 + oi), ops[oi], mir_operand_copy(xe_lid(1)),
            mir_operand_copy(xe_lid(2)))))
        oi = oi + 1
    insts.push(xe_inst(MirInstKind.UnaryOp(
        xe_lid(21), MirUnaryOp.Neg, mir_operand_copy(xe_lid(1)))))
    insts.push(xe_inst(MirInstKind.UnaryOp(
        xe_lid(22), MirUnaryOp.Not, mir_operand_copy(xe_lid(1)))))
    insts.push(xe_inst(MirInstKind.UnaryOp(
        xe_lid(23), MirUnaryOp.BitNot, mir_operand_copy(xe_lid(1)))))
    insts.push(xe_inst(MirInstKind.Call(
        Some(xe_lid(24)), xe_callee("callee"),
        [mir_operand_copy(xe_lid(1)), mir_operand_move(xe_lid(2))])))
    insts.push(xe_inst(MirInstKind.Call(nil, xe_callee("callee"), [])))

    xe_fn("entry", locals, [
        xe_block(0, insts, MirTerminator.Goto(BlockId.new(1))),
        xe_block(1, [], MirTerminator.If(
            mir_operand_copy(xe_lid(2)), BlockId.new(2), BlockId.new(3))),
        xe_block(2, [], MirTerminator.Ret(Some(mir_operand_copy(xe_lid(24))))),
        xe_block(3, [], MirTerminator.Ret(nil))
    ])

fn xe_callee_fn() -> MirFunction:
    xe_fn("callee", [xe_local(0, LocalKind.Arg(0))], [
        xe_block(0, [], MirTerminator.Ret(Some(mir_operand_copy(xe_lid(0)))))
    ])

fn xe_manual_plan(func: MirFunction, regs: {i64: i64}, rel: {i64: i64}) -> ExecIrFnPlan:
    var enc = ExecIrEncoder.create()
    enc.reg_of = regs
    enc.next_reg = regs.keys().len()
    ExecIrFnPlan(func: func, enc: enc, rel_pc: rel, callees: [],
                 prologue: 0, size: 0, base: 0,
                 frame_size: enc.next_reg)

fn xe_emit_is_nil(func: MirFunction, regs: {i64: i64}, rel: {i64: i64}) -> bool:
    val plan = xe_manual_plan(func, regs, rel)
    execir_emit_function(plan, {}, [plan]) == nil

describe "ExecIR code builder emission":
    it "appends exact records through one owned array and preserves helper API":
        # @req: REQ-COMPILER-INTERP-001
        var builder = ExecIrCodeBuilder.create()
        builder.emit4(1, 2, 3, 4)
        builder.emit4(5, 6, 7, 8)
        expect(builder.code).to_equal([1, 2, 3, 4, 5, 6, 7, 8])
        expect(execir_emit4([], 9, 10, 11, 12)).to_equal([9, 10, 11, 12])

    it "emits every supported opcode in exact slot order across empty and nonempty blocks":
        # @req: REQ-COMPILER-INTERP-001
        val encoded = execir_encode_call(
            xe_all_opcodes_entry(), {"callee": xe_callee_fn()})
        assert_true(encoded != nil)
        val expected = [
            42, 0, 0, 0, 1, 25, 0, 0, 3, 12, 0, 0,
            1, 1, 7, 0, 1, 2, 1, 0, 2, 3, 1, 0, 2, 4, 3, 0,
            10, 5, 1, 2, 11, 6, 1, 2, 12, 7, 1, 2, 13, 8, 1, 2,
            14, 9, 1, 2, 15, 10, 1, 2, 16, 11, 1, 2, 17, 12, 1, 2,
            18, 13, 1, 2, 19, 14, 1, 2, 20, 15, 1, 2, 21, 16, 1, 2,
            22, 17, 1, 2, 23, 18, 1, 2, 24, 19, 1, 2, 25, 20, 1, 2,
            30, 21, 1, 0, 31, 22, 1, 0, 32, 23, 1, 0,
            41, 0, 1, 0, 41, 1, 2, 0, 40, 24, 136, 1,
            40, -1, 136, 1, 3, 124, 0, 0, 4, 2, 128, 132,
            5, 24, 0, 0, 5, 25, 0, 0,
            42, 0, 0, 0, 3, 144, 0, 0, 5, 0, 0, 0
        ]
        expect(encoded.unwrap().code).to_equal(expected)

        # The large fixture takes Bool(true); pin the other value arm exactly.
        val bool_false = xe_fn("bool_false", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Const(
                xe_lid(0), MirConstValue.Bool(false), MirType.bool()))],
                MirTerminator.Ret(Some(mir_operand_copy(xe_lid(0)))))
        ])
        val encoded_false = execir_encode_call(bool_false, {})
        assert_true(encoded_false != nil)
        expect(encoded_false.unwrap().code).to_equal([
            3, 4, 0, 0, 1, 0, 0, 0, 5, 0, 0, 0
        ])

    it "keeps instruction fallback branches fail closed":
        # Missing entry block, missing Arg register, and unsupported instruction.
        val ret0 = MirTerminator.Ret(Some(mir_operand_copy(xe_lid(0))))
        val empty = xe_fn("empty", [xe_local(0, LocalKind.Temp)], [xe_block(0, [], ret0)])
        assert_true(xe_emit_is_nil(empty, {0: 0}, {}) )
        val arg = xe_fn("arg", [xe_local(7, LocalKind.Arg(0))], [xe_block(0, [], ret0)])
        assert_true(xe_emit_is_nil(arg, {0: 0}, {0: 0}))
        val unsupported = xe_fn("unsupported", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Alloc(xe_lid(0), MirType.i64()))], ret0)
        ])
        assert_true(xe_emit_is_nil(unsupported, {0: 0}, {0: 0}))

        val bad_const = xe_fn("bad_const", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Const(
                xe_lid(0), MirConstValue.Str("bad"), MirType.i64()))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_const, {0: 0}, {0: 0}))
        val missing_const_dest = xe_fn("missing_const_dest", [], [
            xe_block(0, [xe_inst(MirInstKind.Const(
                xe_lid(9), MirConstValue.Int(1), MirType.i64()))], MirTerminator.Ret(nil))
        ])
        assert_true(xe_emit_is_nil(missing_const_dest, {}, {0: 0}))

    it "keeps operand, callee, destination, and terminator conditions fail closed":
        # Copy/Move validate both local operands.
        val ret0 = MirTerminator.Ret(Some(mir_operand_copy(xe_lid(0))))
        val bad_copy = xe_fn("bad_copy", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Copy(xe_lid(0), xe_lid(9)))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_copy, {0: 0}, {0: 0}))
        val bad_copy_dest = xe_fn("bad_copy_dest", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Copy(xe_lid(9), xe_lid(0)))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_copy_dest, {0: 0}, {0: 0}))
        val bad_move = xe_fn("bad_move", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Move(xe_lid(9), xe_lid(0)))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_move, {0: 0}, {0: 0}))
        val bad_move_src = xe_fn("bad_move_src", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Move(xe_lid(0), xe_lid(9)))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_move_src, {0: 0}, {0: 0}))

        val bad_binop = xe_fn("bad_binop", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.BinOp(
                xe_lid(0), MirBinOp.Pow, mir_operand_copy(xe_lid(0)),
                mir_operand_copy(xe_lid(0))))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_binop, {0: 0}, {0: 0}))
        val bad_bin_dest = xe_fn("bad_bin_dest", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.BinOp(
                xe_lid(9), MirBinOp.Add, mir_operand_copy(xe_lid(0)),
                mir_operand_copy(xe_lid(0))))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_bin_dest, {0: 0}, {0: 0}))
        val bad_bin_left = xe_fn("bad_bin_left", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.BinOp(
                xe_lid(0), MirBinOp.Add, mir_operand_const_float(1.0),
                mir_operand_copy(xe_lid(0))))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_bin_left, {0: 0}, {0: 0}))
        val bad_bin_operand = xe_fn("bad_bin_operand", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.BinOp(
                xe_lid(0), MirBinOp.Add, mir_operand_copy(xe_lid(0)),
                mir_operand_const_float(1.0)))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_bin_operand, {0: 0}, {0: 0}))
        val bad_unary = xe_fn("bad_unary", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.UnaryOp(
                xe_lid(0), MirUnaryOp.Transpose, mir_operand_copy(xe_lid(0))))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_unary, {0: 0}, {0: 0}))
        val bad_unary_dest = xe_fn("bad_unary_dest", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.UnaryOp(
                xe_lid(9), MirUnaryOp.Neg, mir_operand_copy(xe_lid(0))))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_unary_dest, {0: 0}, {0: 0}))
        val bad_unary_operand = xe_fn("bad_unary_operand", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.UnaryOp(
                xe_lid(0), MirUnaryOp.Neg, mir_operand_const_float(1.0)))], ret0)
        ])
        assert_true(xe_emit_is_nil(bad_unary_operand, {0: 0}, {0: 0}))

        val missing_callee = xe_fn("missing_callee", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Call(
                Some(xe_lid(0)), xe_callee("absent"), []))], ret0)
        ])
        assert_true(xe_emit_is_nil(missing_callee, {0: 0}, {0: 0}))
        val bad_call_arg = xe_fn("bad_call_arg", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Call(
                Some(xe_lid(0)), xe_callee("callee"), [mir_operand_const_float(1.0)]))], ret0)
        ])
        val call_plan = xe_manual_plan(bad_call_arg, {0: 0}, {0: 0})
        val callee_plan = xe_manual_plan(xe_callee_fn(), {0: 0}, {0: 0})
        assert_true(execir_emit_function(
            call_plan, {"callee": 1}, [call_plan, callee_plan]) == nil)
        val bad_call_dest = xe_fn("bad_call_dest", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [xe_inst(MirInstKind.Call(
                Some(xe_lid(9)), xe_callee("callee"), []))], ret0)
        ])
        val dest_plan = xe_manual_plan(bad_call_dest, {0: 0}, {0: 0})
        assert_true(execir_emit_function(
            dest_plan, {"callee": 1}, [dest_plan, callee_plan]) == nil)

        val bad_goto = xe_fn("bad_goto", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [], MirTerminator.Goto(BlockId.new(9)))
        ])
        assert_true(xe_emit_is_nil(bad_goto, {0: 0}, {0: 0}))
        val bad_if_operand = xe_fn("bad_if_operand", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [], MirTerminator.If(
                mir_operand_const_float(1.0), BlockId.new(0), BlockId.new(0)))
        ])
        assert_true(xe_emit_is_nil(bad_if_operand, {0: 0}, {0: 0}))
        val bad_if_target = xe_fn("bad_if_target", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [], MirTerminator.If(
                mir_operand_copy(xe_lid(0)), BlockId.new(0), BlockId.new(9)))
        ])
        assert_true(xe_emit_is_nil(bad_if_target, {0: 0}, {0: 0}))
        val bad_if_then = xe_fn("bad_if_then", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [], MirTerminator.If(
                mir_operand_copy(xe_lid(0)), BlockId.new(9), BlockId.new(0)))
        ])
        assert_true(xe_emit_is_nil(bad_if_then, {0: 0}, {0: 0}))
        val bad_ret = xe_fn("bad_ret", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [], MirTerminator.Ret(Some(mir_operand_copy(xe_lid(9)))))
        ])
        assert_true(xe_emit_is_nil(bad_ret, {0: 0}, {0: 0}))
        val bad_term = xe_fn("bad_term", [xe_local(0, LocalKind.Temp)], [
            xe_block(0, [], MirTerminator.Unreachable)
        ])
        assert_true(xe_emit_is_nil(bad_term, {0: 0}, {0: 0}))

    it "pins owner mutation and rejects prefix-return reassignment in the hot emitter":
        # @req: REQ-COMPILER-INTERP-001
        val source = file_read("src/compiler/95.interp/execir.spl")
        val owner_start = source.index_of("class ExecIrCodeBuilder:")
        val emit_start = source.index_of("fn execir_emit_function(", owner_start)
        val emit_end = source.index_of("\nfn execir_encode_call(", emit_start)
        expect(owner_start).to_be_greater_than(-1)
        expect(emit_start).to_be_greater_than(owner_start)
        expect(emit_end).to_be_greater_than(emit_start)
        val owner = source.substring(owner_start, emit_start)
        val emit = source.substring(emit_start, emit_end)
        expect(owner.split("self.code.push(").len() - 1).to_equal(4)
        expect(emit.split("ExecIrCodeBuilder.create()").len() - 1).to_equal(1)
        expect(emit.split("builder.emit4(").len() - 1).to_equal(14)
        expect(emit).to_contain("Some(builder.code)")
        expect(emit.contains("execir_emit4(")).to_equal(false)
        expect(emit.contains(".push(")).to_equal(false)
