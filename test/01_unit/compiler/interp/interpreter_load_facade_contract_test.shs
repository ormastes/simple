#!/bin/sh
set -eu

facade=src/compiler/95.interp/load_facade/facade.spl

test -f "$facade"
grep -q 'PackageIndexRouteV1' "$facade"
grep -q 'pinned_archive_open_verified_v1' "$facade"
grep -q 'dirty_package_requires_compile' "$facade"
grep -q 'ImportSnapshotIdentityV1' "$facade"
! grep -Eq 'read_file|file_exists|walk|scan_dir|src/app/interpreter|compiler\.loader\.(loader|module_resolver)' "$facade"
! rg -n 'use compiler\.interp\.(interpreter|execution)|use compiler\.loader\.(loader|module_resolver)' src/compiler/95.interp/load_facade

printf '%s\n' IL1_INTERPRETER_LOAD_FACADE_STATIC_PASS
