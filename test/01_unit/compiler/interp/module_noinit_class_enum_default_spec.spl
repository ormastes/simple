# @req bug noinit_module_var_nonlocal_type_nil_fallback_needs_hir_zero_2026-11-09
# Owner decision 2026-11-09 (item 14): a module var of class/enum type with no
# initializer is NOT nil in the interpreter — enum defaults to its first
# variant, class to its default (zero-field) construction. Robust/compile
# mode still requires an explicit initializer (covered by
# test/01_unit/compiler/parser/module_noinit_zero_default_spec.spl).
use std.spec
use test.fixtures.compiler.noinit.imported_types_v1.{Remote, RemoteKind}

enum Light:
    Red
    Green
    Blue

class Counter:
    count: i64
    label: text
    on: bool

var light: Light
var counter: Counter
var remote: Remote
var remote_kind: RemoteKind
var later: Later

class Later:
    depth: i64

fn light_name(l: Light) -> text:
    match l:
        Light.Red: "red"
        Light.Green: "green"
        Light.Blue: "blue"

describe "module var without initializer (interpreter default)":
    it "enum var defaults to the first variant":
        expect(light_name(light)).to_equal("red")
        expect(light == Light.Red).to_equal(true)
    it "class var defaults to the default construction, not nil":
        expect(counter.count).to_equal(0)
        expect(counter.label).to_equal("")
        expect(counter.on).to_equal(false)
    it "imported class var defaults to the default construction":
        expect(remote.id).to_equal(0)
        expect(remote.name).to_equal("")
    it "imported enum var defaults to the first variant":
        expect(remote_kind == RemoteKind.Idle).to_equal(true)
    it "later-declared class var defaults to the default construction":
        expect(later.depth).to_equal(0)
