"""
## Purpose and audience
Purpose: Prove that MIR interpreter complex constants.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERP-001 — stable requirement identity for this spec.

# MIR interpreter complex-constant spec.
#
# Oracle for _eval_const in src/compiler/95.interp/mir_interpreter.spl:
# Str constants register in string_table under stable negative ids
# (readable via get_const_string); Array/Tuple constants materialize as
# aggregates (base address >= the 100000 aggregate base, size recorded).
# Previously these fell to the `case _: 0` stub.

use std.spec
use compiler.interp.mir_interpreter.{MirInterpreter}
use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.*
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default}

fn cc_local(id: i64, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: MirType.i64(), kind: kind, is_ghost: false)

fn cc_fn(name: text, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId.new(-1),
        name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: locals,
        blocks: blocks,
        entry_block: BlockId.new(0),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false,
        unroll_factor: 0,
        pipeline_ii: 0,
        memory_banks: 0,
        verification_contract: nil
    )

fn cc_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn cc_blk(id: i64, insts: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId.new(id), label: nil, instructions: insts, terminator: term)

fn cc_lid(id: i64) -> LocalId:
    LocalId(id: id)

# fn: l0 = <const>; ret l0
fn cc_const_fn(value: MirConstValue) -> MirFunction:
    val locals = [cc_local(0, LocalKind.Var)]
    val b0 = cc_blk(0, [
        cc_inst(MirInstKind.Const(cc_lid(0), value, MirType.i64()))
    ], MirTerminator.Ret(Some(mir_operand_copy(cc_lid(0)))))
    cc_fn("const_fn", locals, [b0])

describe "MIR interpreter complex constants":
    it "string constant registers under a negative id and reads back":
        step("Verify: string constant registers under a negative id and reads back")
        # @req: REQ-COMPILER-INTERP-001
        var interp = MirInterpreter.create()
        val res = interp.execute_function(cc_const_fn(MirConstValue.Str("hello const")))
        expect(res[1]).to_be_nil()
        val id = res[0] ?? 0
        assert_true(id < 0)
        val back = interp.get_const_string(id)
        expect(back ?? "").to_equal("hello const")

    it "two string constants get distinct ids and both read back":
        step("Verify: two string constants get distinct ids and both read back")
        var interp = MirInterpreter.create()
        val r1 = interp.execute_function(cc_const_fn(MirConstValue.Str("first")))
        val r2 = interp.execute_function(cc_const_fn(MirConstValue.Str("second")))
        val id1 = r1[0] ?? 0
        val id2 = r2[0] ?? 0
        assert_true(id1 != id2)
        expect(interp.get_const_string(id1) ?? "").to_equal("first")
        expect(interp.get_const_string(id2) ?? "").to_equal("second")

    it "array constant materializes at an aggregate base address":
        step("Verify: array constant materializes at an aggregate base address")
        var interp = MirInterpreter.create()
        val elems = [MirConstValue.Int(10), MirConstValue.Int(20), MirConstValue.Int(30)]
        val res = interp.execute_function(cc_const_fn(MirConstValue.Array(elems)))
        expect(res[1]).to_be_nil()
        val base = res[0] ?? -1
        assert_true(base >= 100000)

    it "nested array registers its inner string constant":
        step("Verify: nested array registers its inner string constant")
        var interp = MirInterpreter.create()
        val elems = [MirConstValue.Str("inner"), MirConstValue.Int(7)]
        val res = interp.execute_function(cc_const_fn(MirConstValue.Array(elems)))
        expect(res[1]).to_be_nil()
        val base = res[0] ?? -1
        assert_true(base >= 100000)
        # The inner string was registered during recursive const eval:
        # ids grow downward from -1, so the first registered string is -1.
        expect(interp.get_const_string(-1) ?? "").to_equal("inner")

    it "tuple constant materializes with its element count recorded":
        step("Verify: tuple constant materializes with its element count recorded")
        var interp = MirInterpreter.create()
        val elems = [MirConstValue.Int(1), MirConstValue.Int(2)]
        val res = interp.execute_function(cc_const_fn(MirConstValue.Tuple(elems)))
        expect(res[1]).to_be_nil()
        val base = res[0] ?? -1
        assert_true(base >= 100000)
        expect(interp.aggregate_sizes[base] ?? -1).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "struct constant materializes with one slot per field":
        step("Verify: struct constant materializes with one slot per field")
        var interp = MirInterpreter.create()
        val fields = {"a": MirConstValue.Int(11), "b": MirConstValue.Int(22)}
        val res = interp.execute_function(cc_const_fn(MirConstValue.Struct(fields)))
        expect(res[1]).to_be_nil()
        val base = res[0] ?? -1
        assert_true(base >= 100000)
        # Field order follows keys() order (implementation-defined), so only
        # the guaranteed contract is asserted: base address and recorded size.
        expect(interp.aggregate_sizes[base] ?? -1).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "struct containing a string registers the string constant":
        step("Verify: struct containing a string registers the string constant")
        var interp = MirInterpreter.create()
        val fields = {"name": MirConstValue.Str("deep")}
        val res = interp.execute_function(cc_const_fn(MirConstValue.Struct(fields)))
        expect(res[1]).to_be_nil()
        val base = res[0] ?? -1
        assert_true(base >= 100000)
        expect(interp.aggregate_sizes[base] ?? -1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(interp.get_const_string(-1) ?? "").to_equal("deep")

    it "float constant returns the same bits at top level and inside an array":
        step("Verify: float constant returns the same bits at top level and inside an array")
        var interp = MirInterpreter.create()
        val top = interp.execute_function(cc_const_fn(MirConstValue.Float(2.5)))
        expect(top[1]).to_be_nil()
        val top_bits = top[0] ?? 0
        assert_true(top_bits != 0)
        # Nested Float goes through _eval_const's Float arm; the slot must
        # carry the identical bit pattern.
        val res = interp.execute_function(cc_const_fn(MirConstValue.Array([MirConstValue.Float(2.5)])))
        expect(res[1]).to_be_nil()
        val base = res[0] ?? -1
        assert_true(base >= 100000)
        expect(interp.get_local(cc_lid(base))).to_equal(top_bits)

    it "bool constant evaluates to 1 at top level and in an array slot":
        step("Verify: bool constant evaluates to 1 at top level and in an array slot")
        var interp = MirInterpreter.create()
        val top = interp.execute_function(cc_const_fn(MirConstValue.Bool(true)))
        expect(top[1]).to_be_nil()
        expect(top[0] ?? -1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val res = interp.execute_function(cc_const_fn(MirConstValue.Array([MirConstValue.Bool(true)])))
        val base = res[0] ?? -1
        assert_true(base >= 100000)
        expect(interp.get_local(cc_lid(base))).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "empty array constant gets a base address and size 0":
        step("Verify: empty array constant gets a base address and size 0")
        var interp = MirInterpreter.create()
        val r1 = interp.execute_function(cc_const_fn(MirConstValue.Array([])))
        expect(r1[1]).to_be_nil()
        val b1 = r1[0] ?? -1
        assert_true(b1 >= 100000)
        expect(interp.aggregate_sizes[b1] ?? -1).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # A second empty aggregate still gets a distinct base (counter advances).
        val r2 = interp.execute_function(cc_const_fn(MirConstValue.Array([])))
        val b2 = r2[0] ?? -1
        assert_true(b2 >= 100000)
        assert_true(b1 != b2)

    it "array nested inside an array materializes both aggregates":
        step("Verify: array nested inside an array materializes both aggregates")
        var interp = MirInterpreter.create()
        val inner = MirConstValue.Array([MirConstValue.Int(5), MirConstValue.Int(6), MirConstValue.Int(7)])
        val outer = MirConstValue.Array([inner, MirConstValue.Int(9)])
        val res = interp.execute_function(cc_const_fn(outer))
        expect(res[1]).to_be_nil()
        val outer_base = res[0] ?? -1
        assert_true(outer_base >= 100000)
        expect(interp.aggregate_sizes[outer_base] ?? -1).to_equal(2)  # oracle: 2 — named expected value from the requirement
        # Slot 0 of the outer aggregate holds the inner aggregate's base.
        val inner_base = interp.get_local(cc_lid(outer_base))
        assert_true(inner_base >= 100000)
        assert_true(inner_base != outer_base)
        expect(interp.aggregate_sizes[inner_base] ?? -1).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "scalar zero constant still returns 0":
        step("Verify: scalar zero constant still returns 0")
        var interp = MirInterpreter.create()
        val res = interp.execute_function(cc_const_fn(MirConstValue.Zero))
        expect(res[1]).to_be_nil()
        expect(res[0] ?? -1).to_equal(0)  # oracle: 0 — named expected value from the requirement
