"""
## Purpose and audience
Purpose: Prove that Miri-mode strict interpreter (SIMPLE_STRICT_INTERP).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERP-001 — stable requirement identity for this spec.

# Miri-mode: strict interpreter checks gated behind SIMPLE_STRICT_INTERP=1.
#
# The MIR interpreter (src/compiler/95.interp/mir_interpreter.spl) already
# traps loudly and unconditionally on OOB (`bounds_check` intrinsic, SF3) and
# on integer division/modulo by zero. This spec covers the two NEW dynamic
# checks added for the Miri-mode lane, both read-once-at-create() and OFF by
# default so normal interpreter performance/behavior is untouched:
#
#   1. Uninitialized-local read trap on Copy/Move (locals that were never
#      written silently fail-closed to -1 today; under strict mode this is a
#      loud error instead).
#   2. Real i64 overflow detection on CheckedBinOp Add/Sub/Mul (today a
#      complete no-op stub that silently wraps, same as plain BinOp).
#
# Harness mirrors the sibling mir_interp_bounds_check_spec.spl: construct a
# MirInst by hand and call interp.execute_instruction(inst) directly — the
# MIR interpreter is a self-contained class with no other production caller
# (verified: `grep -rl MirInterpreter src/` only finds its own module files
# and unit specs), so direct construction is the only honest way to exercise
# it; `bin/simple run` does not reach this class at all.

use std.spec
use compiler.interp.mir_interpreter.{MirInterpreter, InterpError}
use compiler.mir.mir_instructions.{MirInst, MirInstKind, MirOperand, MirOperandKind, MirBinOp, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId}

extern fn rt_env_set(key: text, value: text) -> bool

fn si_local(id: i64) -> LocalId:
    LocalId(id: id)

fn si_copy_inst(dest: LocalId, src: LocalId) -> MirInst:
    MirInst(kind: MirInstKind.Copy(dest, src), span: nil)

fn si_move_inst(dest: LocalId, src: LocalId) -> MirInst:
    MirInst(kind: MirInstKind.Move(dest, src), span: nil)

fn si_checked_binop_inst(dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand) -> MirInst:
    MirInst(kind: MirInstKind.CheckedBinOp(dest, op, left, right), span: nil)

describe "Miri-mode strict interpreter (SIMPLE_STRICT_INTERP)":

    describe "uninitialized-local read trap":
        it "fires on Copy from a never-written local when the env var is set":
            step("Verify: fires on Copy from a never-written local when the env var is set")
            # @req: REQ-COMPILER-INTERP-001
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_copy_inst(si_local(2), si_local(1))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err.unwrap().message()).to_contain("uninitialized-local-read")

        it "fires on Move from a never-written local when the env var is set":
            step("Verify: fires on Move from a never-written local when the env var is set")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_move_inst(si_local(2), si_local(1))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err.unwrap().message()).to_contain("uninitialized-local-read")

        it "stays silent (fail-closed -1, no error) on the same program without the env var":
            step("Verify: stays silent (fail-closed -1, no error) on the same program without the env var")
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            var interp = MirInterpreter.create()
            val inst = si_copy_inst(si_local(2), si_local(1))
            val err = interp.execute_instruction(inst)
            expect(err).to_be_nil()
            expect(interp.get_local(si_local(2))).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "does not fire on a clean program (local written before it is read)":
            step("Verify: does not fire on a clean program (local written before it is read)")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            interp.set_local(si_local(1), 42)
            val inst = si_copy_inst(si_local(2), si_local(1))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err).to_be_nil()
            expect(interp.get_local(si_local(2))).to_equal(42)  # oracle: 42 — named expected value from the requirement

    describe "integer overflow detection on CheckedBinOp":
        it "fires on i64 Add overflow when the env var is set":
            step("Verify: fires on i64 Add overflow when the env var is set")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_checked_binop_inst(si_local(3), MirBinOp.Add, mir_operand_const_int(9223372036854775807), mir_operand_const_int(1))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err.unwrap().message()).to_contain("integer-overflow")

        it "fires on i64 Sub overflow when the env var is set":
            step("Verify: fires on i64 Sub overflow when the env var is set")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_checked_binop_inst(si_local(3), MirBinOp.Sub, mir_operand_const_int(-9223372036854775808), mir_operand_const_int(1))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err.unwrap().message()).to_contain("integer-overflow")

        it "fires on i64 Mul overflow when the env var is set":
            step("Verify: fires on i64 Mul overflow when the env var is set")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_checked_binop_inst(si_local(3), MirBinOp.Mul, mir_operand_const_int(9223372036854775807), mir_operand_const_int(2))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err.unwrap().message()).to_contain("integer-overflow")

        it "fires on the i64::MIN * -1 edge case when the env var is set":
            step("Verify: fires on the i64::MIN * -1 edge case when the env var is set")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_checked_binop_inst(si_local(3), MirBinOp.Mul, mir_operand_const_int(-9223372036854775808), mir_operand_const_int(-1))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err.unwrap().message()).to_contain("integer-overflow")

        it "silently wraps (no error) on the same overflowing Add without the env var":
            step("Verify: silently wraps (no error) on the same overflowing Add without the env var")
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            var interp = MirInterpreter.create()
            val inst = si_checked_binop_inst(si_local(3), MirBinOp.Add, mir_operand_const_int(9223372036854775807), mir_operand_const_int(1))
            val err = interp.execute_instruction(inst)
            expect(err).to_be_nil()

        it "does not fire on a clean, non-overflowing CheckedBinOp under strict mode":
            step("Verify: does not fire on a clean, non-overflowing CheckedBinOp under strict mode")
            rt_env_set("SIMPLE_STRICT_INTERP", "1")
            var interp = MirInterpreter.create()
            val inst = si_checked_binop_inst(si_local(3), MirBinOp.Add, mir_operand_const_int(2), mir_operand_const_int(3))
            val err = interp.execute_instruction(inst)
            rt_env_set("SIMPLE_STRICT_INTERP", "0")
            expect(err).to_be_nil()
            expect(interp.get_local(si_local(3))).to_equal(5)  # oracle: 5 — named expected value from the requirement
