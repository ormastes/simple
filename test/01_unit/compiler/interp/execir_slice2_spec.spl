# ExecIR slice 2 spec (startup-perf Phase E).
#
# Differential oracle vs MirInterpreter for: direct calls (caller + add1),
# a loop of calls, self-recursion depth 2, div/rem-by-zero error parity
# (result shape (i64?, InterpError?) with the interpreter's exact messages),
# and the fallback contract for a non-encodable callee. Loops kept small:
# MirInterpreter caps block transitions at max_iterations = 10000.
#
# Plan: doc/03_plan/compiler/startup_performance/startup_perf_plan_2026-08-17.md

use std.spec
use compiler.interp.mir_interpreter.{MirInterpreter, InterpError}
use compiler.interp.execir.{ExecIrModule, execir_encode, execir_encode_call, execir_run_result, execir_run_module}
use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.*
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default}

extern fn rt_time_ms() -> i64

fn x2_local(id: i64, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: MirType.i64(), kind: kind, is_ghost: false)

fn x2_fn(name: text, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId.new(-1),
        name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
        locals: locals,
        blocks: blocks,
        entry_block: BlockId.new(0),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false,
        unroll_factor: 0,
        pipeline_ii: 0,
        memory_banks: 0,
        verification_contract: nil
    )

fn x2_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn x2_blk(id: i64, insts: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId.new(id), label: nil, instructions: insts, terminator: term)

fn x2_lid(id: i64) -> LocalId:
    LocalId(id: id)

fn x2_callee_name(s: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(s), MirType.i64()))

# fn add1(x) = x + 1
fn x2_add1_fn() -> MirFunction:
    val locals = [x2_local(0, LocalKind.Arg(0)), x2_local(1, LocalKind.Temp)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.BinOp(x2_lid(1), MirBinOp.Add, mir_operand_copy(x2_lid(0)), mir_operand_const_int(1)))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(1)))))
    x2_fn("add1", locals, [b0])

# fn caller() = add1(41)
fn x2_caller_fn() -> MirFunction:
    val locals = [x2_local(0, LocalKind.Var)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.Call(Some(x2_lid(0)), x2_callee_name("add1"), [mir_operand_const_int(41)]))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(0)))))
    x2_fn("caller", locals, [b0])

# fn call_loop(n) = sum of add1(i) for i in 0..n-1
fn x2_call_loop_fn(n: i64) -> MirFunction:
    val locals = [x2_local(0, LocalKind.Var), x2_local(1, LocalKind.Var),
                  x2_local(2, LocalKind.Temp), x2_local(3, LocalKind.Temp)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.Const(x2_lid(0), MirConstValue.Int(0), MirType.i64())),
        x2_inst(MirInstKind.Const(x2_lid(1), MirConstValue.Int(0), MirType.i64()))
    ], MirTerminator.Goto(BlockId.new(1)))
    val b1 = x2_blk(1, [
        x2_inst(MirInstKind.BinOp(x2_lid(2), MirBinOp.Lt, mir_operand_copy(x2_lid(0)), mir_operand_const_int(n)))
    ], MirTerminator.If(mir_operand_copy(x2_lid(2)), BlockId.new(2), BlockId.new(3)))
    val b2 = x2_blk(2, [
        x2_inst(MirInstKind.Call(Some(x2_lid(3)), x2_callee_name("add1"), [mir_operand_copy(x2_lid(0))])),
        x2_inst(MirInstKind.BinOp(x2_lid(1), MirBinOp.Add, mir_operand_copy(x2_lid(1)), mir_operand_copy(x2_lid(3)))),
        x2_inst(MirInstKind.BinOp(x2_lid(0), MirBinOp.Add, mir_operand_copy(x2_lid(0)), mir_operand_const_int(1)))
    ], MirTerminator.Goto(BlockId.new(1)))
    val b3 = x2_blk(3, [], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(1)))))
    x2_fn("call_loop", locals, [b0, b1, b2, b3])

# fn rec(n) = if n > 0: n + rec(n - 1) else: 0   (self-recursive)
fn x2_rec_fn() -> MirFunction:
    val locals = [x2_local(0, LocalKind.Arg(0)), x2_local(1, LocalKind.Temp),
                  x2_local(2, LocalKind.Temp), x2_local(3, LocalKind.Temp),
                  x2_local(4, LocalKind.Temp)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.BinOp(x2_lid(1), MirBinOp.Gt, mir_operand_copy(x2_lid(0)), mir_operand_const_int(0)))
    ], MirTerminator.If(mir_operand_copy(x2_lid(1)), BlockId.new(1), BlockId.new(2)))
    val b1 = x2_blk(1, [
        x2_inst(MirInstKind.BinOp(x2_lid(2), MirBinOp.Sub, mir_operand_copy(x2_lid(0)), mir_operand_const_int(1))),
        x2_inst(MirInstKind.Call(Some(x2_lid(3)), x2_callee_name("rec"), [mir_operand_copy(x2_lid(2))])),
        x2_inst(MirInstKind.BinOp(x2_lid(4), MirBinOp.Add, mir_operand_copy(x2_lid(0)), mir_operand_copy(x2_lid(3))))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(4)))))
    val b2 = x2_blk(2, [], MirTerminator.Ret(Some(mir_operand_const_int(0))))
    x2_fn("rec", locals, [b0, b1, b2])

# fn rec_entry() = rec(2)  — recursion depth 2
fn x2_rec_entry_fn() -> MirFunction:
    val locals = [x2_local(0, LocalKind.Var)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.Call(Some(x2_lid(0)), x2_callee_name("rec"), [mir_operand_const_int(2)]))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(0)))))
    x2_fn("rec_entry", locals, [b0])

# non-encodable callee: body contains a Str const instruction
fn x2_bad_callee_fn() -> MirFunction:
    val locals = [x2_local(0, LocalKind.Var)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.Const(x2_lid(0), MirConstValue.Str("nope"), MirType.i64()))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(0)))))
    x2_fn("bad", locals, [b0])

fn x2_call_bad_fn() -> MirFunction:
    val locals = [x2_local(0, LocalKind.Var)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.Call(Some(x2_lid(0)), x2_callee_name("bad"), []))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(0)))))
    x2_fn("call_bad", locals, [b0])

# fn divz(d) = 7 / d  or  7 % d
fn x2_div_fn(op: MirBinOp, denom: i64) -> MirFunction:
    val locals = [x2_local(0, LocalKind.Temp)]
    val b0 = x2_blk(0, [
        x2_inst(MirInstKind.BinOp(x2_lid(0), op, mir_operand_const_int(7), mir_operand_const_int(denom)))
    ], MirTerminator.Ret(Some(mir_operand_copy(x2_lid(0)))))
    x2_fn("divz", locals, [b0])

fn x2_interp(f: MirFunction, table: {text: MirFunction}) -> (i64?, InterpError?):
    var interp = MirInterpreter.create()
    interp.set_function_table(table)
    interp.execute_function(f)

fn x2_run_call(entry: MirFunction, table: {text: MirFunction}) -> (i64?, InterpError?):
    val m = execir_encode_call(entry, table)
    if m == nil:
        return (nil, Some(InterpError.RuntimeError(message: "encode failed")))
    execir_run_module(m ?? ExecIrModule(code: [], entry_pc: 0, entry_frame: 0, total_arena_slots: 0, max_frame: 0, recursion_possible: false))

describe "ExecIR slice 2 (calls + error channel)":
    it "direct call chain caller -> add1: both 42, matches interpreter":
        val table = {"add1": x2_add1_fn()}
        val er = x2_run_call(x2_caller_fn(), table)
        val ir = x2_interp(x2_caller_fn(), table)
        expect(er[0] ?? -1).to_equal(42)
        expect(er[0] ?? -1).to_equal(ir[0] ?? -2)
        assert_true(er[1] == nil)
        assert_true(ir[1] == nil)

    it "loop of calls: sum add1(i) i in 0..199 == 20100, matches interpreter":
        val table = {"add1": x2_add1_fn()}
        val f = x2_call_loop_fn(200)
        val er = x2_run_call(f, table)
        val ir = x2_interp(f, table)
        expect(er[0] ?? -1).to_equal(20100)
        expect(er[0] ?? -1).to_equal(ir[0] ?? -2)

    it "self-recursion depth 2: rec(2) == 3, matches interpreter":
        val table = {"rec": x2_rec_fn()}
        val er = x2_run_call(x2_rec_entry_fn(), table)
        val ir = x2_interp(x2_rec_entry_fn(), table)
        expect(er[0] ?? -1).to_equal(3)
        expect(er[0] ?? -1).to_equal(ir[0] ?? -2)

    it "non-encodable callee: execir_encode_call returns nil — fallback contract":
        val table = {"bad": x2_bad_callee_fn()}
        val m = execir_encode_call(x2_call_bad_fn(), table)
        assert_true(m == nil)

    it "div by zero: nil value + DivisionByZero, message-exact vs interpreter":
        val f = x2_div_fn(MirBinOp.Div, 0)
        val prog = execir_encode(f)
        assert_true(prog != nil)
        val er = execir_run_result(prog.unwrap())
        val ir = x2_interp(f, {})
        assert_true(er[0] == nil)
        assert_true(ir[0] == nil)
        assert_true(er[1].?)
        assert_true(ir[1].?)
        expect(er[1].unwrap().message()).to_equal(ir[1].unwrap().message())
        expect(er[1].unwrap().message()).to_equal("Division by zero: Integer division")

    it "rem by zero: nil value + DivisionByZero, message-exact vs interpreter":
        val f = x2_div_fn(MirBinOp.Rem, 0)
        val prog = execir_encode(f)
        assert_true(prog != nil)
        val er = execir_run_result(prog.unwrap())
        val ir = x2_interp(f, {})
        assert_true(er[0] == nil)
        assert_true(er[1].?)
        assert_true(ir[1].?)
        expect(er[1].unwrap().message()).to_equal(ir[1].unwrap().message())
        expect(er[1].unwrap().message()).to_equal("Division by zero: Integer modulo")

    it "non-zero div/rem still produce values differentially":
        val fd = x2_div_fn(MirBinOp.Div, 2)
        val er = execir_run_result((execir_encode(fd)).unwrap())
        val ir = x2_interp(fd, {})
        expect(er[0] ?? -1).to_equal(3)
        expect(er[0] ?? -1).to_equal(ir[0] ?? -2)

    it "microbench: ExecIR vs MirInterpreter on call_loop(200)":
        val table = {"add1": x2_add1_fn()}
        val f = x2_call_loop_fn(200)
        val m0 = execir_encode_call(f, table)
        assert_true(m0 != nil)
        val m = m0 ?? ExecIrModule(code: [], entry_pc: 0, entry_frame: 0, total_arena_slots: 0, max_frame: 0, recursion_possible: false)
        val t0 = rt_time_ms()
        val er = execir_run_module(m)
        val t1 = rt_time_ms()
        var interp = MirInterpreter.create()
        interp.set_function_table(table)
        val ir = interp.execute_function(f)
        val t2 = rt_time_ms()
        expect(er[0] ?? -1).to_equal(20100)
        expect(er[0] ?? -1).to_equal(ir[0] ?? -2)
        print "BENCH execir_run_module call_loop(200) ms: " + str(t1 - t0)
        print "BENCH MirInterpreter call_loop(200) ms: " + str(t2 - t1)
