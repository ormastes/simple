use std.spec
use compiler.interp.interpreter.{eval_int_int}

describe "interpreter integer shift-count masking":
    it "masks negative shift counts to the i64 width":
        expect(eval_int_int("<<", 1, -64).unwrap()).to_equal(1)
        expect(eval_int_int(">>", -2, -1).unwrap()).to_equal(-1)

    it "wraps shift counts at and above the i64 width":
        expect(eval_int_int("<<", 1, 64).unwrap()).to_equal(1)
        expect(eval_int_int("<<", 1, 65).unwrap()).to_equal(2)
        expect(eval_int_int(">>", 8, 65).unwrap()).to_equal(4)

    it "keeps adjacent in-range shift counts unchanged":
        expect(eval_int_int("<<", 1, 0).unwrap()).to_equal(1)
        expect(eval_int_int(">>", -1, 63).unwrap()).to_equal(-1)
