# @tag:in-development
# Purpose and audience: regression spec for enum values in string interpolation.
# @req REQ-SSPEC-UNIT
"""
# Enum Interpolation Text Specification

Interpolating an enum value must print the variant name, never an address
(bug dupcheck_enum_interpolation_erased_value).
"""
use std.spec.step

enum Color:
    Red
    Green

enum Shape:
    Circle(r: i64)
    Dot

struct Tok:
    kind: Color
    value: text

describe "enum interpolation":
    it "prints the variant name for a simple enum":
        step("local enum value")
        val c = Color.Green
        expect("{c}").to_equal("Green")

    it "prints the variant name for an enum struct field":
        step("enum field of a struct")
        val t = Tok(kind: Color.Red, value: "x")
        expect("{t.kind}:{t.value}").to_equal("Red:x")

    it "prints the variant for payload and unit variants":
        step("payload variant")
        val s = Shape.Circle(r: 3)
        val d = Shape.Dot
        expect("{d}").to_equal("Dot")
        expect("{s}").to_start_with("Circle")
