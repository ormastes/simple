# FIXTURE (not a spec). Deliberately ill-formed: the impl of `greet` takes ONE
# parameter where the trait declares TWO. A conforming compiler must reject this
# file. If it compiles, trait conformance is unenforced and every call through
# the trait passes the wrong argument count with no diagnostic.

trait Greeter:
    fn greet(name: text, punctuation: text) -> text

struct Rude:
    tag: text

impl Greeter for Rude:
    fn greet(name: text) -> text:
        "hi " + name

fn main():
    val r = Rude(tag: "x")
    print(r.greet("bob"))
    print("FIXTURE_RAN_WRONG_ARITY")
