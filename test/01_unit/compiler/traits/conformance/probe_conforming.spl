# FIXTURE (not a spec). CONTROL arm: a correct impl that must keep compiling and
# running. Without this, a spec asserting "violations are rejected" would also
# pass against a compiler that rejects every trait impl.

trait Greeter:
    fn greet(name: text, punctuation: text) -> text

struct Polite:
    tag: text

impl Greeter for Polite:
    fn greet(name: text, punctuation: text) -> text:
        "hi " + name + punctuation

fn main():
    val p = Polite(tag: "x")
    print(p.greet("bob", "!"))
    print("FIXTURE_RAN_CONFORMING")
