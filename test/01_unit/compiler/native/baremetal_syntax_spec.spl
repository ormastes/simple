"""Baremetal syntax contracts against the self-hosted frontend.

Each snippet is parsed by the same core frontend used by native-build. The
scenarios inspect AST facts and parser outcomes. Missing support is a failing
assertion, including features previously claimed by literal-only checks.
"""
# codex-system-test
# @cover src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl
# @cover src/compiler/10.frontend/core/parser_stmts.spl
# @cover src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl

use std.spec.{describe, it, expect, step}
use compiler.frontend.core.frontend.{core_frontend_parse_reset}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.core.parser.{parser_has_errors}
use compiler.common.attributes.{parse_layout_attrs}
use compiler.types.type_layout.{TypeLayoutKind}
use compiler.core.ast.{
    module_get_decls, decl_get_name, decl_get_asm_placement,
    decl_get_is_comptime, decl_get_field_bits, decl_is_packed
}
use compiler.core.ast_expr.{expr_tag, expr_stmts, EXPR_UNSAFE_BLOCK}

fn parse_named_decl(source: text, path: text, name: text) -> i64:
    if not core_frontend_parse_reset(source, path):
        return -1
    for decl in module_get_decls():
        if decl_get_name(decl) == name:
            return decl
    -1

fn unsafe_expr_index() -> i64:
    var i = 0
    while i < expr_tag.len():
        if expr_tag[i] == EXPR_UNSAFE_BLOCK:
            return i
        i = i + 1
    -1

describe "Volatile Syntax":
    it "preserves @volatile on a parsed register field":
        step("Parse a register field and inspect its volatility flag")
        val module = parse_and_build_module("struct Mmio:\n    @volatile reg: u32\n", "volatile_field.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.structs.contains("Mmio")).to_equal(true)
        if module.structs.contains("Mmio"):
            expect(module.structs["Mmio"].fields.len()).to_equal(1)
            if module.structs["Mmio"].fields.len() == 1:
                expect(module.structs["Mmio"].fields[0].is_volatile).to_equal(true)

    it "preserves @volatile on a module variable":
        step("Parse a volatile binding and inspect the constant AST")
        val module = parse_and_build_module("@volatile\nval reg: u32 = 1\n", "volatile_binding.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.constants.contains("reg")).to_equal(true)
        if module.constants.contains("reg"):
            expect(module.constants["reg"].is_volatile).to_equal(true)

describe "Unsafe Syntax":
    it "lowers the unsafe keyword to its own expression tag":
        step("Parse an unsafe block through the core frontend")
        val decl = parse_named_decl("fn access():\n    unsafe:\n        pass\n", "unsafe_keyword.spl", "access")
        expect(decl).to_be_greater_than(-1)
        expect(unsafe_expr_index()).to_be_greater_than(-1)

    it "retains statements inside an unsafe block":
        step("Inspect the unsafe block body in the expression arena")
        val decl = parse_named_decl("fn access():\n    unsafe:\n        val mask = 3\n", "unsafe_body.spl", "access")
        expect(decl).to_be_greater_than(-1)
        val unsafe_idx = unsafe_expr_index()
        expect(unsafe_idx).to_be_greater_than(-1)
        if unsafe_idx >= 0:
            expect(expr_stmts[unsafe_idx].len()).to_equal(1)

describe "Interrupt Syntax":
    it "records a bare @interrupt handler attribute":
        step("Parse an interrupt function and inspect placement metadata")
        val decl = parse_named_decl("@interrupt\nfn irq():\n    pass\n", "interrupt_bare.spl", "irq")
        expect(decl).to_be_greater_than(-1)
        if decl >= 0:
            expect(decl_get_asm_placement(decl)).to_equal("interrupt")

    it "retains the authored interrupt vector argument":
        step("Parse @interrupt(32) and inspect the AST spelling")
        val decl = parse_named_decl("@interrupt(32)\nfn timer_handler():\n    pass\n", "interrupt_vector.spl", "timer_handler")
        expect(decl).to_be_greater_than(-1)
        if decl >= 0:
            expect(decl_get_asm_placement(decl)).to_equal("interrupt(32)")

    it "selects the nil arm of an option match":
        step("Execute a nil match as a control case")
        val opt = nil
        var chosen = 1
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(-1)

describe "Memory Layout Attributes":
    it "retains @repr(C) on a parsed struct":
        step("Parse a C representation decorator and inspect struct attributes")
        val module = parse_and_build_module("@repr(C)\nstruct Register:\n    value: u32\n", "repr_c.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.structs.contains("Register")).to_equal(true)
        if module.structs.contains("Register"):
            val layout = parse_layout_attrs(module.structs["Register"].attributes)
            expect(layout.layout_kind).to_equal(TypeLayoutKind.C)

    it "marks a packed struct in the flat declaration arena":
        step("Parse width-annotated fields under @packed")
        val decl = parse_named_decl("@packed\nstruct Flags:\n    ready: u32:1\n    reserved: u32:31\n", "packed_flags.spl", "Flags")
        expect(decl).to_be_greater_than(-1)
        if decl >= 0:
            expect(decl_is_packed[decl]).to_equal(1)
            expect(decl_get_field_bits(decl)).to_equal([1, 31])

    it "records @align(16) on a function declaration":
        step("Inspect the parsed function placement metadata")
        val decl = parse_named_decl("@align(16)\nfn aligned():\n    pass\n", "aligned_fn.spl", "aligned")
        expect(decl).to_be_greater_than(-1)
        if decl >= 0:
            expect(decl_get_asm_placement(decl)).to_equal("align(16)")

    it "executes bitwise operators as a control case":
        step("Compare each operator with its fixed arithmetic result")
        expect(6 & 3).to_equal(2)
        expect(6 | 3).to_equal(7)
        expect(6 ^ 3).to_equal(5)
        expect(1 << 4).to_equal(16)
        expect(-8 >> 1).to_equal(-4)

describe "Bitfield Syntax":
    it "recognizes the bitfield declaration in the module AST":
        step("Parse a bitfield with an explicit backing type")
        val module = parse_and_build_module("bitfield ControlReg(u32):\n    ready: u1\n    mode: u3\n", "bitfield_decl.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.bitfields.contains("ControlReg")).to_equal(true)

    it "retains the bit widths of bitfield members":
        step("Inspect the flat declaration field-width vector")
        val decl = parse_named_decl("bitfield ControlReg(u32):\n    ready: u1\n    mode: u3\n", "bitfield_widths.spl", "ControlReg")
        expect(decl).to_be_greater_than(-1)
        if decl >= 0:
            expect(decl_get_field_bits(decl)).to_equal([-1, 1, 3])

describe "Address Syntax":
    it "retains a fixed address on a register declaration":
        step("Parse a fixed-address binding and inspect the address fact")
        val module = parse_and_build_module("val REG: u32 @ 0x40000000 = 0\n", "fixed_address.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.constants.contains("REG")).to_equal(true)
        if module.constants.contains("REG"):
            expect(module.constants["REG"].has_fixed_address).to_equal(true)
            expect(module.constants["REG"].fixed_address).to_equal(0x40000000)

describe "Static Assert":
    it "records the authored static assertion as a compile-time node":
        step("Parse static assert and inspect the module assertion list")
        val module = parse_and_build_module("static assert 4 == 4\n", "static_assert.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(module.static_asserts.len()).to_equal(1)

describe "Const Functions":
    it "marks a parsed const fn as compile-time callable":
        step("Parse a const function and inspect its declaration flag")
        val decl = parse_named_decl("const fn compute() -> i64:\n    4\n", "const_fn.spl", "compute")
        expect(decl).to_be_greater_than(-1)
        if decl >= 0:
            expect(decl_get_is_comptime(decl)).to_equal(true)
