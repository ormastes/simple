use std.spec.*
use std.spec.step
use std.io_runtime.process_run

describe "SimpleOS text receiver keeps its runtime owner", tag: ["only-compiled"]:
    it "runs split-element and trimmed text with a colliding Path method":
        step("Compile and execute the text receiver fixture with native lowering")
        val cmd = "set +e; d=$(mktemp -d); env SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_SCV_FREEZE_FALLBACK=1 SIMPLE_NO_STUB_FALLBACK=1 bin/simple native-build --source test/fixtures/simpleos_decode_string_owner --entry test/fixtures/simpleos_decode_string_owner/main.spl --entry-closure --output \"$d/probe\" >\"$d/build.log\" 2>&1; rc=$?; if [ \"$rc\" -eq 0 ]; then \"$d/probe\"; else echo BUILD_FAILED; tail -n 8 \"$d/build.log\"; fi; rm -rf \"$d\""
        val (output, _err, _rc) = process_run("/bin/sh", ["-c", cmd])
        expect(output).to_contain("DECODE_OWNER_OK")
        expect(output.contains("DECODE_OWNER_BAD")).to_equal(false)
        expect(output.contains("BUILD_FAILED")).to_equal(false)
