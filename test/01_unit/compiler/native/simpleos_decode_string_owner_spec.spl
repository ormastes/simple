use std.spec.*
use std.spec.step
use std.io_runtime.process_run

describe "SimpleOS text receiver keeps its runtime owner":
    it "executes the production theme parser with a colliding Path method":
        step("Execute the fixture that imports production theme_package")
        val cmd = "bin/simple run test/fixtures/simpleos_decode_string_owner/main.spl"
        val (output, _err, rc) = process_run("/bin/sh", ["-c", cmd])
        expect(rc).to_equal(0)
        expect(output).to_contain("DECODE_OWNER_OK")
        expect(output.contains("DECODE_OWNER_BAD")).to_equal(false)
