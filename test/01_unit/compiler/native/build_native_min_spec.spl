# @req: REQ-COMPILER-NATIVE-001

# # Build Native Minimum Specification
#
# **Feature IDs:** #TBD
# **Category:** Compiler
# **Status:** In Progress
#
# ## Overview
#
# Tests that the linker and driver modules can be imported successfully.

use linker.*
use driver.*


use std.spec.step

describe "Build Native Minimum":
    it "imports linker module successfully":
        # @req: REQ-COMPILER-NATIVE-001
        step("Verify: imports linker module successfully")
        val imported_module = "linker"
        expect(imported_module).to_equal("linker")

    it "imports driver module successfully":
        # @req: REQ-COMPILER-NATIVE-001
        step("Verify: imports driver module successfully")
        val imported_module = "driver"
        expect(imported_module).to_equal("driver")
