"""Bounded-copy contract for bootstrap HIR interpolation fragments."""

use std.spec.*
use std.io_runtime.{file_read}

describe "bootstrap HIR interpolation fragment slicing":
    it "records source bounds and materializes each completed region once":
        val source = file_read(
            "src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl")
        val begin = source.index_of("me build_bootstrap_interpolations(")
        val finish = source.index_of("me lower_bootstrap_flat_if_stmt(")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body.count("inner_start = i + 1")).to_equal(1)
        expect(body.count("value.substring(inner_start, i)")).to_equal(1)
        expect(body.count("inner = inner + ch")).to_equal(0)
        expect(body.count("var inner = \"\"")).to_equal(0)

    it "retains nested-brace depth and completed-region ordering":
        val source = file_read(
            "src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl")
        val begin = source.index_of("me build_bootstrap_interpolations(")
        val finish = source.index_of("me lower_bootstrap_flat_if_stmt(")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        val open_nested = body.index_of("elif depth > 0 and ch == \"{\":")
        val close_nested = body.index_of("elif depth > 0 and ch == \"}\":")
        val slice = body.index_of("val inner = value.substring(inner_start, i)")
        val append = body.index_of("parts = parts.push(HirInterpolation(")
        expect(open_nested >= 0 and close_nested > open_nested).to_equal(true)
        expect(slice > close_nested and append > slice).to_equal(true)
        expect(body).to_contain("depth = depth + 1")
        expect(body).to_contain("depth = depth - 1")
        expect(body).to_contain("if depth == 0:")
