# @req: REQ-COMPILER-HIR-001
extern fn rt_file_read_text(path: text) -> text?

describe "bootstrap flat HIR atomic owner":
    it "publishes through one BootstrapHirStore owner and aligns before advancing committed_count":
        val store = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/bootstrap_hir_store.spl") ?? ""
        val helpers = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/lowering_helpers.spl") ?? ""
        val mir = rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""
        expect(store).to_contain("class BootstrapHirStore:")
        expect(helpers).to_contain("var _bootstrap_hir_store: BootstrapHirStore = bootstrap_hir_store_with_port(hir_publish_port_runtime())")
        expect(store).to_contain("if not self.aligned(module_index + 1):")
        expect(store).to_contain("self.committed_count = module_index + 1")
        expect(store).to_contain("me publish_pending() -> bool:")
        expect(store).to_contain("fn promote_last_legacy() -> bool:")
        expect(helpers.contains("var _bootstrap_hir_module_functions: [[HirFunction]]")).to_equal(false)
        expect(mir).to_contain("val prescan_fn = bootstrap_hir_module_function_at(module_index, flat_prescan_index)")
        expect(mir).to_contain("val hir_fn = bootstrap_hir_module_function_at(module_index, function_index)")
        expect(mir).to_contain("if bootstrap_reject_fatal_mir_errors(lowering):")
