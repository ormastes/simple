# @req: REQ-COMPILER-HIR-001
extern fn rt_file_read_text(path: text) -> text

describe "bootstrap flat HIR atomic owner":
    it "publishes one promoted owner and performs one production function load":
        val store = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/lowering_helpers.spl") ?? ""
        val mir = rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""
        expect(store).to_contain("class BootstrapHirModuleOwner:")
        expect(store).to_contain("var _bootstrap_hir_modules: [BootstrapHirModuleOwner] = []")
        expect(store).to_contain("if not rt_transient_heap_promote(_bootstrap_hir_modules):")
        expect(store).to_contain("_bootstrap_hir_module_committed_count = committed + 1")
        expect(store).to_contain("_bootstrap_hir_pending_is_entry = false\n        return false\n    _bootstrap_hir_module_committed_count = committed + 1")
        expect(store.contains("rt_transient_heap_promote(_bootstrap_hir_modules[last])")).to_equal(false)
        expect(store).to_contain("fn bootstrap_hir_modules_commit_pending_process_owned()")
        expect(store).to_contain("if not bootstrap_hir_modules_commit_pending_process_owned():")
        expect(store).to_contain("Cache replay owns decoded HIR for process lifetime")
        expect(store).to_contain("_bootstrap_hir_pending_index = module_index")
        expect(store).to_contain("Readers validate\n    # only against committed_count")
        expect(store.contains("var _bootstrap_hir_module_functions: [[HirFunction]]")).to_equal(false)
        expect(mir).to_contain("lowering.lower_function_from_module_owner(owner, function_index)")
        expect(mir.contains("val hir_fn = owner.functions[function_index]")).to_equal(false)
        expect(mir.contains("lower_function(hir_fn)")).to_equal(false)
        expect(mir.contains("prescan_block_for_struct_types(owner.functions[flat_prescan_index].body)")).to_equal(false)
        expect(mir.contains("bootstrap_hir_module_function_at(module_index, function_index)")).to_equal(false)
        expect(mir).to_contain("[hir-owner] consumed")
