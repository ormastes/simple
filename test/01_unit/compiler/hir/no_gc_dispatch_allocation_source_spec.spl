use std.io_runtime.{file_read}
use std.spec.*

describe "no-GC compiler dispatch allocation":
    it "uses stable tags without constructing recursive enum exemplars":
        val types = file_read("src/compiler/20.hir/hir_lowering/types.spl")
        val statements = file_read("src/compiler/20.hir/hir_lowering/statements.spl")
        val mir_statements = file_read("src/compiler/50.mir/mir_lowering_stmts.spl")
        val mir_modules = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        val block_helpers = file_read("src/compiler/15.blocks/blocks/builtin_blocks_helpers.spl")
        val mir_literals = file_read("src/compiler/50.mir/_MirLoweringExpr/literals.spl")

        expect(types).to_contain("if kind_disc_v == 2288079638:  # hash(\"Named\")")
        expect(types).to_contain("elif kind_disc_v == 2452922934:  # hash(\"Function\")")
        expect(types.contains("hir_type_kind_disc(TypeKind.")).to_equal(false)
        expect(statements).to_contain("if sk_disc == 2118877809:  # hash(\"Val\")")
        expect(statements).to_contain("if sk_disc == 4119164143:  # hash(\"Expr\")")
        expect(statements.contains("sk_dummy")).to_equal(false)
        expect(mir_statements).to_contain("if stmt_disc == 2163764024:  # hash(\"Let\")")
        expect(mir_statements.contains("fallback_expr")).to_equal(false)
        expect(mir_modules).to_contain("if stmt_disc == 3431341068:  # hash(\"Assign\")")
        expect(mir_modules).to_contain("if rt_enum_discriminant(expr_kind) == 1138084884:  # hash(\"Block\")")
        expect(mir_modules.contains("val nil_expr = HirExpr")).to_equal(false)
        expect(block_helpers).to_contain("ConstValue.String(json_value)")
        expect(block_helpers.contains("ConstValue.Text(json_value)")).to_equal(false)
        expect(mir_literals).to_contain("MirTypeKind.Opaque(\"Set\")")
        expect(mir_literals.contains("MirTypeKind.Named(\"Set\"")).to_equal(false)
