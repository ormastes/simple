# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




# @tag: unit, compiler, hir, source-contract

use std.spec.step

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

# expressions.spl is a re-export shim since the _Expressions split; the
# collectors this contract guards live in match_desugaring.spl.
val SOURCE = "src/compiler/20.hir/hir_lowering/_Expressions/match_desugaring.spl"

describe "HIR pattern condition collection mutability":
    # @manual scenario evidence
    it "keeps all five recursive pattern collectors mutable":
        # @req REQ-SSPEC-COMPILER
        step("keeps all five recursive pattern collectors mutable")
        val source = file_read(SOURCE)
        expect(source.split("var conditions: [HirExpr] = []").len() - 1).to_equal(5)
        expect(source.contains("val conditions: [HirExpr] = []")).to_equal(false)
