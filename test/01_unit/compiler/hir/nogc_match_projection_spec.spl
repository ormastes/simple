# @req ACOWN03
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirPattern, HirPatternKind, HirStmtKind}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering._Expressions.match_desugaring.*
use compiler.common.dependency.visibility.{Visibility}

fn projection_owner(span: Span) -> HirType:
    HirType(kind: HirTypeKind.Unique(HirType(kind: HirTypeKind.Named(SymbolId(id: 321), []), span: span)), span: span)

fn is_projection_owner(type_: HirType) -> bool:
    match type_.kind:
        case HirTypeKind.Unique(inner):
            match inner.kind:
                case HirTypeKind.Named(owner, _): owner.id == 321
                case _: false
        case _: false

describe "typed match projections":
    it "retains an authoritative tuple owner and registers its binding":
        val span = Span.empty()
        val owner = projection_owner(span)
        var lowering = HirLowering.with_filename("match.spl")
        val source = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Tuple([owner]), span: span), span: span)
        val projected = lowering.match_index_projection(source, 0, span)
        expect(projected.has_type_).to_equal(true)
        expect(is_projection_owner(projected.type_)).to_equal(true)
        val symbol = lowering.symbols.define("bound", SymbolKind.Variable, nil, span, Visibility.Private, false, nil)
        val pattern = HirPattern(kind: HirPatternKind.Binding(symbol, false), has_type_: false, type_: nil, span: span)
        val statements = lowering.destructure_pattern_prelude(projected, pattern, span)
        expect(statements.len()).to_equal(1)
        match statements[0].kind:
            case HirStmtKind.Let(_, binding_type, _): expect(is_projection_owner(binding_type)).to_equal(true)
            case _: expect(false).to_equal(true)
        val registered = lowering.symbols.get_symbol_type_raw(symbol.id).unwrap()
        expect(is_projection_owner(registered)).to_equal(true)

    it "retains declared array and slice element owners":
        val span = Span.empty()
        val owner = projection_owner(span)
        var lowering = HirLowering.with_filename("match.spl")
        val array = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Array(owner, None), span: span), span: span)
        val slice = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Slice(owner), span: span), span: span)
        expect(is_projection_owner(lowering.match_index_projection(array, 0, span).type_)).to_equal(true)
        expect(is_projection_owner(lowering.match_index_projection(slice, 0, span).type_)).to_equal(true)

    it "does not invent an owner for an unknown source or invalid tuple index":
        val span = Span.empty()
        var lowering = HirLowering.with_filename("match.spl")
        val unknown = HirExpr(kind: HirExprKind.NilLit, has_type_: false, type_: projection_owner(span), span: span)
        expect(lowering.match_index_projection(unknown, 0, span).has_type_).to_equal(false)
        val tuple = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Tuple([projection_owner(span)]), span: span), span: span)
        expect(lowering.match_index_projection(tuple, 1, span).has_type_).to_equal(false)

    it "uses the declaring struct field table for nested owner projections":
        val span = Span.empty()
        var lowering = HirLowering.with_filename("match.spl")
        val owner = projection_owner(span)
        val structure = lowering.symbols.define("Envelope", SymbolKind.Struct, nil, span, Visibility.Private, false, nil)
        lowering.struct_field_types_by_name["Envelope"] = {"payload": owner}
        val source = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Named(structure, []), span: span), span: span)
        val projected = lowering.match_field_projection(source, "payload", span)
        expect(projected.has_type_).to_equal(true)
        expect(is_projection_owner(projected.type_)).to_equal(true)
        expect(lowering.match_field_projection(source, "absent", span).has_type_).to_equal(false)
