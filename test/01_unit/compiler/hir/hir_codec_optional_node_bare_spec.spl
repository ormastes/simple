# Regression for hir_cache_warm_decode_mir_divergence_core_c_2026-10-19.
# The generated decoder wrapped an already-optional node local as
# `field = Some(ov)`. Fresh HIR lowering stores the bare node (Range in
# expression_core.spl), so a consumer that passes the optional field through
# unwrapped -- MIR's struct_construct_spread_base returns Range.end straight
# into lower_expr -- read an Option box as a HirExpr on warm (decoded) builds
# only. Decoded optional node fields must have the lowered (bare) shape.
use std.spec.*
use std.io_runtime.{read_file_text}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirEnumPayload}
use compiler.hir.generated.hir_codec.{hc_enc_hir_expr_kind, hc_dec_hir_expr_kind}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use compiler.common.diagnostics.span.{Span}

fn spread_end_like_mir(kind: HirExprKind) -> HirExpr?:
    # Same shape as struct_construct_spread_base: no unwrap of `end`.
    match kind:
        case HirExprKind.Range(start, end, _, _):
            if start == nil and end != nil:
                return end
            return nil
        case _:
            return nil

fn passed_line(e: HirExpr) -> i64:
    e.span.line

fn decode_roundtrip(kind: HirExprKind) -> HirExprKind:
    var writer = HirCodecWriter.create()
    hc_enc_hir_expr_kind(writer, kind)
    expect(writer.ok).to_equal(true)
    var reader = FlatPoolReader.new(writer.finish())
    val decoded = hc_dec_hir_expr_kind(reader)
    expect(reader.ok).to_equal(true)
    decoded

describe "HIR codec decodes optional node fields in the lowered (bare) shape":
    it "passes a decoded Range end through unwrapped as a live HirExpr":
        val base = HirExpr(kind: HirExprKind.NilLit, has_type_: false, type_: nil,
            span: Span(start: 0, end: 0, line: 41, col: 7, file: "probe.spl", length: 0))
        val decoded = decode_roundtrip(HirExprKind.Range(nil, base, false, nil))
        val passed = spread_end_like_mir(decoded)
        expect(passed != nil).to_equal(true)
        # Pass the optional straight through, exactly as lower_expr(spread_base)
        # does; an `if val` unwrap would hide the boxed shape.
        expect(passed_line(passed)).to_equal(41)
        if val e = passed:
            expect(passed_line(e)).to_equal(41)
            match e.kind:
                case HirExprKind.NilLit: expect(true).to_equal(true)
                case _: fail("decoded Range.end is not the original NilLit node")

    it "passes a decoded EnumLit payload through unwrapped":
        val value = HirExpr(kind: HirExprKind.IntLit(5, nil), has_type_: false, type_: nil,
            span: Span(start: 0, end: 0, line: 9, col: 3, file: "probe.spl", length: 0))
        val decoded = decode_roundtrip(HirExprKind.EnumLit(nil, "Copy", HirEnumPayload.Tuple([value])))
        match decoded:
            case HirExprKind.EnumLit(_, variant, payload):
                expect(variant).to_equal("Copy")
                if val p = payload:
                    match p:
                        case HirEnumPayload.Tuple(values):
                            expect(values.len()).to_equal(1)
                            expect(passed_line(values[0])).to_equal(9)
                        case _: fail("decoded EnumLit payload lost its Tuple variant")
                else:
                    fail("decoded EnumLit payload is absent")
            case _: fail("expected EnumLit")

    it "generates bare assignment for optional node fields":
        val generated = read_file_text("src/compiler/20.hir/generated/hir_codec.spl")
        expect(generated.contains("f_end = Some(")).to_equal(false)
        expect(generated.contains("f_payload = Some(")).to_equal(false)
        expect(generated.contains("f_else_ = Some(")).to_equal(false)
