# @manual: primary
# @req: REQ-C2-UNION-BINDER-001
# Execution status: UNRUN. Exercises the public parse -> HIR path.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.semantics.union_normalize.canonical.{union_normalize, union_member_key, union_variant_name}

fn union_binder_expect_owner(lowering: HirLowering, pattern: HirPattern, subject_type: HirType) -> i64:
    var members: [HirType] = []
    match subject_type.kind:
        case HirTypeKind.Union(types): members = types
        case _: assert(false)
    val normalized = union_normalize(members)
    match pattern.kind:
        case HirPatternKind.Enum(enum_type, variant, payload):
            match enum_type.kind:
                case HirTypeKind.Named(owner, args):
                    expect(args.len()).to_equal(0)
                    expect(lowering.symbols.structural_union_symbols.contains_key(normalized.name)).to_be(true)
                    expect(lowering.symbols.structural_union_symbols[normalized.name]).to_equal(owner.id)
                    expect(lowering.symbols.structural_union_owners.contains_key(owner.id)).to_be(true)
                    expect(lowering.symbols.structural_union_owners[owner.id]).to_equal(normalized.name)
                    expect(payload != nil).to_be(true)
                    match payload.unwrap():
                        case HirPatternPayload.Tuple(children):
                            expect(children.len()).to_equal(1)
                            expect(children[0].has_type_).to_be(true)
                            val member_key = union_member_key(children[0].type_)
                            expect(normalized.keys.contains(member_key)).to_be(true)
                            expect(variant).to_equal(union_variant_name(member_key))
                            match children[0].kind:
                                case HirPatternKind.Binding(symbol, _):
                                    val declared = lowering.symbols.get_symbol_type_raw(symbol.id)
                                    expect(declared != nil).to_be(true)
                                    expect(union_member_key(declared.unwrap())).to_equal(member_key)
                                case _: assert(false)
                        case _: assert(false)
                    return owner.id
                case _: assert(false)
        case _: assert(false)
    -1

fn union_binder_payload_symbol(pattern: HirPattern) -> i64:
    match pattern.kind:
        case HirPatternKind.Enum(_, _, payload):
            expect(payload != nil).to_be(true)
            match payload.unwrap():
                case HirPatternPayload.Tuple(children):
                    expect(children.len()).to_equal(1)
                    match children[0].kind:
                        case HirPatternKind.Binding(symbol, _): return symbol.id
                        case _: assert(false)
                case _: assert(false)
        case _: assert(false)
    -1

fn union_binder_var_id(expr: HirExpr) -> i64:
    match expr.kind:
        case HirExprKind.Var(symbol): symbol.id
        case HirExprKind.NamedVar(symbol, _): symbol.id
        case _: -1

fn union_binder_match_arms(expr: HirExpr) -> [HirMatchArm]:
    match expr.kind:
        case HirExprKind.MatchCase(_, arms): arms
        case HirExprKind.Block(block):
            expect(block.has).to_be(true)
            union_binder_match_arms(block.value)
        case _:
            assert(false)
            []

fn union_binder_diagnostics(source: text, name: text) -> [text]:
    val parsed = parse_full_frontend(source, name, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(name)
    lowering.lower_module(parsed)
    var messages: [text] = []
    for diagnostic in lowering.errors:
        messages = messages.push(diagnostic.message)
    messages

describe "source union type patterns bind before arm expressions":
    it "uses one typed payload symbol in both guard and body, shadowing an outer parameter":
        step("Parse a guarded narrowing arm that shadows an existing parameter")
        val source = "fn pick(x: i64 | text, v: i64) -> i64:\n    match x:\n        case i64 v if v > 0: v\n        case text s: 0\n        case _: 0\n"
        val parsed = parse_full_frontend(source, "binder_guard", "binder_guard", Logger(level: 0))
        var lowering = HirLowering.with_filename("binder_guard")
        val lowered = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var inspected = 0
        for function in lowered.functions.values():
            if function.name == "pick":
                inspected = inspected + 1
                expect(function.body.has).to_be(true)
                val arms = union_binder_match_arms(function.body.value)
                expect(arms.len()).to_equal(3)
                val arm = arms[0]
                val owner = union_binder_expect_owner(lowering, arm.pattern, function.params[0].type_)
                expect(union_binder_expect_owner(lowering, arms[1].pattern, function.params[0].type_)).to_equal(owner)
                match arm.pattern.kind:
                    case HirPatternKind.Enum(_, variant, payload):
                        expect(variant).to_equal("I64")
                        expect(payload != nil).to_be(true)
                        match payload.unwrap():
                            case HirPatternPayload.Tuple(children):
                                expect(children.len()).to_equal(1)
                                expect(children[0].has_type_).to_be(true)
                                match children[0].type_.kind:
                                    case HirTypeKind.Int(bits, signed):
                                        expect(bits).to_equal(64)
                                        expect(signed).to_be(true)
                                    case _: assert(false)
                                match children[0].kind:
                                    case HirPatternKind.Binding(symbol, mutable):
                                        expect(mutable).to_be(false)
                                        expect(symbol.id == function.params[1].symbol.id).to_be(false)
                                        expect(arm.has_guard).to_be(true)
                                        match arm.guard.kind:
                                            case HirExprKind.Binary(_, left, _):
                                                expect(union_binder_var_id(left)).to_equal(symbol.id)
                                            case _: assert(false)
                                        expect(arm.body.has).to_be(true)
                                        expect(union_binder_var_id(arm.body.value)).to_equal(symbol.id)
                                        val declared = lowering.symbols.get_symbol_type_raw(symbol.id)
                                        expect(declared != nil).to_be(true)
                                        match declared.unwrap().kind:
                                            case HirTypeKind.Int(bits, signed):
                                                expect(bits).to_equal(64)
                                                expect(signed).to_be(true)
                                            case _: assert(false)
                                    case _: assert(false)
                            case _: assert(false)
                    case _: assert(false)
        expect(inspected).to_equal(1)

    it "resolves a text payload reference to the pattern binding":
        step("Lower a text narrowing body through the public frontend")
        val source = "fn pick(x: i64 | text) -> text:\n    match x:\n        case i64 v: \"integer\"\n        case text s: s\n"
        val parsed = parse_full_frontend(source, "binder_text", "binder_text", Logger(level: 0))
        var lowering = HirLowering.with_filename("binder_text")
        val lowered = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var inspected = 0
        for function in lowered.functions.values():
            if function.name == "pick":
                inspected = inspected + 1
                val arms = union_binder_match_arms(function.body.value)
                expect(arms.len()).to_equal(2)
                val owner = union_binder_expect_owner(lowering, arms[0].pattern, function.params[0].type_)
                expect(union_binder_expect_owner(lowering, arms[1].pattern, function.params[0].type_)).to_equal(owner)
                match arms[1].pattern.kind:
                    case HirPatternKind.Enum(_, variant, payload):
                        expect(variant).to_equal("Text")
                        expect(payload != nil).to_be(true)
                        match payload.unwrap():
                            case HirPatternPayload.Tuple(children):
                                expect(children.len()).to_equal(1)
                                match children[0].kind:
                                    case HirPatternKind.Binding(symbol, _):
                                        expect(union_binder_var_id(arms[1].body.value)).to_equal(symbol.id)
                                        match children[0].type_.kind:
                                            case HirTypeKind.Str: ()
                                            case _: assert(false)
                                    case _: assert(false)
                            case _: assert(false)
                    case _: assert(false)
        expect(inspected).to_equal(1)

    it "reports the exact absent-member diagnostic without introducing its binder":
        step("Reject bool as a member of i64 | text and keep its name unresolved")
        val messages = union_binder_diagnostics("fn pick(x: i64 | text) -> i64:\n    match x:\n        case bool absent: absent\n        case _: 0\n", "binder_wrong")
        expect(messages).to_contain("E-NARROW-002: `case bool absent:` is not a member of union __Union_i64_text")
        var unresolved = false
        for message in messages:
            if message.contains("unresolved name: absent"):
                unresolved = true
        expect(unresolved).to_be(true)

    it "keeps nested match descriptions separate and restores the enclosing arm identity":
        step("Inspect actual registry owners and scoped guard/body symbols across nested matches")
        val source = "fn pick(x: i64 | text, y: bool | text) -> bool:\n    match x:\n        case i64 v if v > 0:\n            match y:\n                case bool b if b: b\n                case text s: false\n                case _: false\n        case text s: false\n        case _: false\n"
        val parsed = parse_full_frontend(source, "binder_nested", "binder_nested", Logger(level: 0))
        var lowering = HirLowering.with_filename("binder_nested")
        val lowered = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var inspected = 0
        for function in lowered.functions.values():
            if function.name == "pick":
                inspected = inspected + 1
                val outer = union_binder_match_arms(function.body.value)
                expect(outer.len()).to_equal(3)
                val owner = union_binder_expect_owner(lowering, outer[0].pattern, function.params[0].type_)
                expect(union_binder_expect_owner(lowering, outer[1].pattern, function.params[0].type_)).to_equal(owner)
                val outer_binder = union_binder_payload_symbol(outer[0].pattern)
                match outer[0].guard.kind:
                    case HirExprKind.Binary(_, left, _):
                        expect(union_binder_var_id(left)).to_equal(outer_binder)
                    case _: assert(false)
                val inner = union_binder_match_arms(outer[0].body.value)
                expect(inner.len()).to_equal(3)
                val inner_owner = union_binder_expect_owner(lowering, inner[0].pattern, function.params[1].type_)
                expect(inner_owner == owner).to_be(false)
                expect(union_binder_expect_owner(lowering, inner[1].pattern, function.params[1].type_)).to_equal(inner_owner)
                val inner_binder = union_binder_payload_symbol(inner[0].pattern)
                expect(inner_binder == outer_binder).to_be(false)
                expect(union_binder_var_id(inner[0].guard)).to_equal(inner_binder)
                expect(union_binder_var_id(inner[0].body.value)).to_equal(inner_binder)
                expect(union_binder_payload_symbol(inner[1].pattern) == union_binder_payload_symbol(outer[1].pattern)).to_be(false)
        expect(inspected).to_equal(1)

    it "binds a nominal member using its actual declaration and registry owner":
        step("Parse a same-module nominal union member and compare declaration, payload, guard and body identities")
        val source = "struct Packet:\n    number: i64\nfn pick(x: Packet | text, fallback: Packet) -> Packet:\n    match x:\n        case Packet p if p == p: p\n        case text s: fallback\n        case _: fallback\n"
        val parsed = parse_full_frontend(source, "binder_nominal", "binder_nominal", Logger(level: 0))
        var lowering = HirLowering.with_filename("binder_nominal")
        val lowered = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var declaration_id = -1
        for declaration in lowered.structs.values():
            if declaration.name == "Packet":
                declaration_id = declaration.symbol.id
        expect(declaration_id >= 0).to_be(true)
        var inspected = 0
        for function in lowered.functions.values():
            if function.name == "pick":
                inspected = inspected + 1
                val arms = union_binder_match_arms(function.body.value)
                val owner = union_binder_expect_owner(lowering, arms[0].pattern, function.params[0].type_)
                expect(union_binder_expect_owner(lowering, arms[1].pattern, function.params[0].type_)).to_equal(owner)
                val binder = union_binder_payload_symbol(arms[0].pattern)
                val declared = lowering.symbols.get_symbol_type_raw(binder)
                expect(declared != nil).to_be(true)
                match declared.unwrap().kind:
                    case HirTypeKind.Named(actual, args):
                        expect(actual.id).to_equal(declaration_id)
                        expect(args.len()).to_equal(0)
                    case _: assert(false)
                match arms[0].guard.kind:
                    case HirExprKind.Binary(_, left, right):
                        expect(union_binder_var_id(left)).to_equal(binder)
                        expect(union_binder_var_id(right)).to_equal(binder)
                    case _: assert(false)
                expect(union_binder_var_id(arms[0].body.value)).to_equal(binder)
        expect(inspected).to_equal(1)

    it "rejects a visible named declaration absent from the union without binding it":
        step("Resolve Other to its real declaration and refuse it as a Packet union member")
        val messages = union_binder_diagnostics("struct Packet:\n    number: i64\nstruct Other:\n    number: i64\nfn pick(x: Packet | text) -> i64:\n    match x:\n        case Other absent: absent\n        case _: 0\n", "binder_wrong_nominal")
        var narrow = false
        var unresolved = false
        for message in messages:
            if message.starts_with("E-NARROW-002: `case Other absent:` is not a member of union __Union_"):
                narrow = true
            if message.contains("unresolved name: absent"):
                unresolved = true
        expect(narrow).to_be(true)
        expect(unresolved).to_be(true)

    it "preserves nonunion rejection without inventing a binder":
        step("Leave the existing nonunion type-pattern diagnostic path active")
        val messages = union_binder_diagnostics("fn pick(x: i64) -> i64:\n    match x:\n        case i64 absent: absent\n        case _: 0\n", "binder_nonunion")
        var narrow = false
        var unresolved = false
        for message in messages:
            if message.contains("E-NARROW-001"):
                narrow = true
            if message.contains("unresolved name: absent"):
                unresolved = true
        expect(narrow).to_be(true)
        expect(unresolved).to_be(true)

    it "does not leak a narrowed binder into the next arm":
        step("Resolve each union arm in its own lexical scope")
        val messages = union_binder_diagnostics("fn pick(x: i64 | text) -> i64:\n    match x:\n        case i64 v: v\n        case text s: v\n", "binder_scope")
        var unresolved = false
        for message in messages:
            if message.contains("unresolved name: v"):
                unresolved = true
        expect(unresolved).to_be(true)
