# B01: typed canonical key ordering.  This is primitive coverage only; it does
# not admit the closed canonical codec or provide a golden-byte oracle.
# @req REQ-CSM-024

use std.spec.*
use std.spec.step
use test.fixtures.compiler.completeness95.hir_cases_v1.{fixture_hir_module_v1}
use compiler.hir.hir_types.{SymbolId}
use compiler.hir.hir_codec_key_order.{hc_i64_key_before_v1,
    hc_symbol_id_key_before_v1, hc_text_key_before_v1,
    hc_order_i64_keys_v1, hc_order_symbol_id_keys_v1, hc_order_text_keys_v1}

describe "B01 canonical HIR key ordering [OPT-L07-T001]":
    it "should order signed integer keys without changing equal-key order":
        step("Freeze the exact source and required case universe")
        val values = [4, -2, 4, 0, -9223372036854775807 - 1,
            9223372036854775807]
        expect(hc_order_i64_keys_v1(values)).to_equal(
            [-9223372036854775807 - 1, -2, 0, 4, 4, 9223372036854775807])
        expect(hc_i64_key_before_v1(-2, 0)).to_equal(true)
        expect(hc_i64_key_before_v1(4, 4)).to_equal(false)

    it "should order symbol and UTF-8 text keys by their typed contract":
        step("Exercise the production owner with a real typed input")
        val symbols = [SymbolId.new(9), SymbolId.new(1), SymbolId.new(1),
            SymbolId.new(4)]
        expect(hc_order_symbol_id_keys_v1(symbols)).to_equal(
            [SymbolId.new(1), SymbolId.new(1), SymbolId.new(4), SymbolId.new(9)])
        val names = ["z", "한", "a", "aa"]
        expect(hc_order_text_keys_v1(names)).to_equal(["a", "aa", "z", "한"])
        expect(hc_text_key_before_v1("a", "aa")).to_equal(true)
        val shared = ["shared-prefix-z", "shared-prefix-a", "shared-prefix"]
        expect(hc_order_text_keys_v1(shared)).to_equal(
            ["shared-prefix", "shared-prefix-a", "shared-prefix-z"])

    it "should preserve reverse odd merge runs and equal-key stability":
        step("Exercise the production owner with a real typed input")
        expect(hc_order_i64_keys_v1([9, 1, 7, 3, 5])).to_equal([1, 3, 5, 7, 9])
        val equal_values = [4, 4, 4]
        expect(hc_order_i64_keys_v1(equal_values)).to_equal(equal_values)
        expect(hc_symbol_id_key_before_v1(SymbolId.new(4),
            SymbolId.new(4))).to_equal(false)

    it "should preserve nil-before-present and singleton edge ordering":
        step("Inject one missing case or invalid boundary")
        val values: [i64] = [nil, 7]
        expect(hc_order_i64_keys_v1(values)).to_equal([nil, 7])
        expect(hc_order_i64_keys_v1([])).to_equal([])
        expect(hc_order_i64_keys_v1([3])).to_equal([3])
        expect(hc_i64_key_before_v1(nil, 7)).to_equal(true)
        expect(hc_i64_key_before_v1(7, nil)).to_equal(false)

    it "should keep opposite typed-module insertion orders byte-identical after admission":
        step("Require the exact refusal before publication or execution")
        val forward = fixture_hir_module_v1(false)
        val reverse = fixture_hir_module_v1(true)
        # Canonical availability is intentionally closed until independent
        # regeneration/golden admission.  This RED case must remain explicit.
        fail("MissingEvidence: B01 canonical codec admission and golden oracle")
        _ = forward
        _ = reverse

    it "should bind executed ordering hits to the admitted build":
        step("Bind executed branch hits to the admitted build")
        fail("MissingEvidence: B01 qualified branch instrumentation and runner")
