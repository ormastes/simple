# @tag: unit, compiler, hir, native-safe
# Reproduce for doc/08_tracking/bug/module_surface_projected_type_shape_undefined_e1002_2026-08-22.md:
# 50feb3ba227 landed the CALLERS of module_surface_projected_type_shape /
# module_surface_projected_type_name but never their definitions, so every
# --hir-shard worker died at `surface_build 5/687` with E1002. Importing the
# pair by name from the defining module fails pre-fix with the same E1002.

use std.spec.{describe, it, expect}
use compiler.frontend.parser_types.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.module_surface_declarations.{
    module_surface_projected_type_shape,
    module_surface_projected_type_name,
    module_surface_callable_from_function
}

val span = Span.empty()
val cell = Type(kind: TypeKind.Named("Cell", []), span: span)
val cells = Type(kind: TypeKind.Array(cell, nil), span: span)
val infer = Type(kind: TypeKind.Infer, span: span)

describe "module_surface_projected_type_shape":
    it "classifies a named field type as named and projects its name":
        val shape = module_surface_projected_type_shape(cell)
        expect(shape).to_equal("named")
        expect(module_surface_projected_type_name(cell, shape)).to_equal("Cell")

    it "classifies an array field type as array and projects the element name":
        val shape = module_surface_projected_type_shape(cells)
        expect(shape).to_equal("array")
        expect(module_surface_projected_type_name(cells, shape)).to_equal("Cell")

    it "projects an empty name for a type with no scalar identity":
        val shape = module_surface_projected_type_shape(infer)
        expect(shape).to_equal("other")
        expect(module_surface_projected_type_name(infer, shape)).to_equal("")

describe "module_surface_declarations neighbors resolve by name":
    it "keeps the callable projection helper importable":
        expect(module_surface_callable_from_function != nil).to_be(true)
