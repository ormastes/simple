# Actual production parser inventory plus canonical cross-module HIR visibility.
# Authored UNRUN. No source-text matching is used as a semantic oracle.
use std.spec.*
use compiler.common.config.Logger
use compiler.common.driver_core_types.SourceFile
use compiler.frontend.frontend.parse_full_frontend
use compiler.core.parser.parser_has_errors
use compiler.frontend.parser_types.{ParserClass, ParserModule}
use compiler.hir.hir_lowering.types.hirlowering_for_module
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use std.nogc_sync_mut.io_runtime.file_read

fn session_class(path: text, name: text) -> ParserClass:
    val source = file_read(path)
    expect(source.len()).to_be_greater_than(0)
    val parsed = parse_full_frontend(source, path, "session_inventory", Logger(level: 0))
    expect(parser_has_errors()).to_equal(false)
    expect(parsed.classes.contains_key(name)).to_equal(true)
    parsed.classes[name]

fn session_factory_visibility(consumer_source: text) -> [text]:
    val provider_path = "src/network/provider.spl"
    val provider_source = "pub class Session:\n    _stream: i64\n    pub static fn connect() -> Session:\n        Session(_stream: 7)\n"
    val provider = parse_full_frontend(provider_source, provider_path, "network.provider", Logger(level: 0))
    expect(parser_has_errors()).to_equal(false)
    var modules: Dict<text, ParserModule> = {}
    modules["network.provider"] = provider
    val surfaces = module_surfaces_from_modules(modules, [SourceFile(path: provider_path, content: provider_source, module_name: "network.provider")]).unwrap()
    val consumer_path = "src/client/consumer.spl"
    val consumer = parse_full_frontend(consumer_source, consumer_path, "client.consumer", Logger(level: 0))
    expect(parser_has_errors()).to_equal(false)
    var lowering = hirlowering_for_module(consumer_path, surfaces)
    val module = lowering.lower_module(consumer)
    lowering.diagnostic_messages

fn session_message_present(messages: [text], text_: text) -> bool:
    for message in messages:
        if message.contains(text_): return true
    false

describe "network sessions expose owning factories only":
    it "parses the actual TCP owner and finds no raw adoption method or public state":
        val owner = session_class("src/lib/nogc_sync_mut/io/tcp_text_session.spl", "TcpTextSession")
        expect(owner.methods.keys().len()).to_equal(6)
        for name in ["connect", "accept", "read_chunk", "read_text", "write_text", "close"]:
            expect(owner.methods.contains_key(name)).to_equal(true)
            expect(owner.methods[name].is_public).to_equal(true)
        expect(owner.methods.contains_key("create")).to_equal(false)
        expect(owner.methods.contains_key("admit_owned")).to_equal(false)
        expect(owner.fields.len()).to_be_greater_than(0)
        for field in owner.fields: expect(field.is_public).to_equal(false)

    it "parses the actual UDP owner and finds no raw adoption method or public state":
        val owner = session_class("src/lib/nogc_sync_mut/io/udp_text_session.spl", "UdpTextSession")
        expect(owner.methods.keys().len()).to_equal(5)
        for name in ["bind", "local_addr", "recv_text", "send_text", "close"]:
            expect(owner.methods.contains_key(name)).to_equal(true)
            expect(owner.methods[name].is_public).to_equal(true)
        expect(owner.methods.contains_key("create")).to_equal(false)
        for field in owner.fields: expect(field.is_public).to_equal(false)

    it "rejects cross-module aggregate forging of private transport state":
        val errors = session_factory_visibility(r"use network.provider.{Session}" + "\nfn forge() -> Session:\n    Session(_stream: 9)\n")
        expect(session_message_present(errors, "aggregate constructor `Session` is not visible")).to_equal(true)

    it "rejects cross-module access to the transport field":
        val errors = session_factory_visibility(r"use network.provider.{Session}" + "\nfn expose(value: Session) -> i64:\n    value._stream\n")
        expect(session_message_present(errors, "field `_stream` is not visible")).to_equal(true)

    it "keeps a public owning factory available across modules":
        val errors = session_factory_visibility(r"use network.provider.{Session}" + "\nfn open() -> Session:\n    Session.connect()\n")
        expect(errors.len()).to_equal(0)
