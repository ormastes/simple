fn find_opt(xs: [i64], want: i64) -> i64?:
    for x in xs:
        if x == want:
            return Some(x)
    None

fn wrap(n: i64) -> Option<i64>:
    Some(n)

fn main() -> i64:
    var a = -1
    match find_opt([4, 7, 9], 7):
        Some(j): a = j
        None: a = -2
    var b = -1
    match find_opt([4, 7, 9], 5):
        Some(j): b = j
        None: b = -2
    var c = -1
    match wrap(11):
        Some(j): c = j
        None: c = -2
    var d = -1
    if val j = find_opt([3], 3):
        d = j
    print "a={a} b={b} c={c} d={d}"
    0
