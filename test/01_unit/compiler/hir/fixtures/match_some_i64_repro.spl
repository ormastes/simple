fn main() -> i64:
    val json = "{{\"value\":\"alpha\"}}"
    val r = json.index_of("\"value\":")
    print "r={r}"
    var a = -1
    match r:
        Some(j): a = j
        nil: a = -2
    print "a={a}"
    var b = -1
    match r:
        Some(j):
            b = j
        nil:
            b = -2
    print "b={b}"
    0
