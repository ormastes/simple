use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_end}
use compiler.hir.hir_types.{HirModule, HirImport, SymbolTable}
use compiler.hir.target_hir.hir_snapshot.{hir_snapshot_id_new, hir_snapshot_id_equals}
use compiler.hir.target_hir.hir_freeze.{
    HirSnapshot,
    HirSnapshotSessionCacheV1,
    hir_snapshot_freeze,
    hir_snapshot_verify,
    hir_snapshot_read,
    hir_snapshot_read_in_session,
    hir_snapshot_session_epoch_v1,
    hir_snapshot_session_invalidate_v1,
    hir_snapshot_verify_count_v1,
    hir_snapshot_session_cache_hits_v1
}

fn fixture(name: text, path: text) -> HirModule:
    HirModule(name: name, path: path, imports: [], exports: [],
        domain_blocks: [], symbols: SymbolTable.new(), functions: {},
        gpu_function_targets: {}, gpu_function_backend_orders: {}, classes: {},
        structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [], constants: {},
        static_asserts: [], aop_advices: [], di_bindings: [], arch_rules: [],
        mock_decls: [], types: [], extend_enums: [])

describe "HirSnapshot deep freeze (TargetHIR PR-B)":
    it "derives a canonical id that is stable for identical HIR":
        val a = hir_snapshot_freeze(fixture("app.main", "a.spl"), 0).unwrap()
        val b = hir_snapshot_freeze(fixture("app.main", "a.spl"), 0).unwrap()
        expect(hir_snapshot_id_equals(a.id, b.id)).to_be(true)
        expect(a.id.content_digest.len()).to_equal(64)
        expect(hir_snapshot_verify(a)).to_be(true)

    it "gives different HIR content a different id":
        val a = hir_snapshot_freeze(fixture("app.main", "a.spl"), 0).unwrap()
        val c = hir_snapshot_freeze(fixture("app.main", "c.spl"), 0).unwrap()
        expect(a.id.content_digest == c.id.content_digest).to_be(false)

    it "is not affected by mutating the source module after freezing":
        var m = fixture("app.main", "a.spl")
        val snap = hir_snapshot_freeze(m, 1).unwrap()
        val before = snap.frozen_bytes
        m.path = "mutated.spl"
        m.exports = ["leak"]
        expect(snap.frozen_bytes).to_equal(before)
        expect(hir_snapshot_verify(snap)).to_be(true)
        val again = hir_snapshot_freeze(m, 1).unwrap()
        expect(hir_snapshot_id_equals(snap.id, again.id)).to_be(false)

    it "hands out independent copies on read and rejects tampered bytes":
        val snap = hir_snapshot_freeze(fixture("app.main", "a.spl"), 0).unwrap()
        var first = hir_snapshot_read(snap).unwrap()
        expect(first.path).to_equal("a.spl")
        first.path = "changed.spl"
        expect(hir_snapshot_read(snap).unwrap().path).to_equal("a.spl")
        val tampered = HirSnapshot(id: snap.id, frozen_bytes: snap.frozen_bytes + " ", codec: snap.codec)
        expect(hir_snapshot_verify(tampered)).to_be(false)
        expect(hir_snapshot_read(tampered).unwrap_err()).to_start_with("hir_snapshot_digest_mismatch:")

    it "verifies SHA-256 once per (epoch, id, codec), reuses verified bytes safely, and re-verifies on epoch reset":
        val epoch0 = hir_snapshot_session_invalidate_v1()
        val snap_gen0 = hir_snapshot_freeze(fixture("app.session_mod", "s0.spl"), 0).unwrap()
        val snap_gen1 = hir_snapshot_freeze(fixture("app.session_mod", "s0.spl"), 1).unwrap()

        val verifies_before = hir_snapshot_verify_count_v1()
        val hits_before = hir_snapshot_session_cache_hits_v1()

        var view1 = hir_snapshot_read_in_session(snap_gen0).unwrap()
        expect(hir_snapshot_verify_count_v1()).to_equal(verifies_before + 1)
        expect(hir_snapshot_session_cache_hits_v1()).to_equal(hits_before)
        view1.path = "mutated_caller_view.spl"
        view1.exports.push("mutated_export")

        val view2 = hir_snapshot_read(snap_gen0).unwrap()
        expect(hir_snapshot_verify_count_v1()).to_equal(verifies_before + 1)
        expect(hir_snapshot_session_cache_hits_v1()).to_equal(hits_before + 1)
        expect(view2.path).to_equal("s0.spl")
        expect(view2.exports.len()).to_equal(0)

        # Different generation is a distinct cache key and verifies independently.
        val view_gen1 = hir_snapshot_read(snap_gen1).unwrap()
        expect(view_gen1.path).to_equal("s0.spl")
        expect(hir_snapshot_verify_count_v1()).to_equal(verifies_before + 2)

        # Advancing session epoch invalidates prior verified entries and forces fresh SHA-256.
        val epoch1 = hir_snapshot_session_invalidate_v1()
        expect(epoch1).to_equal(epoch0 + 1)
        expect(hir_snapshot_session_epoch_v1()).to_equal(epoch1)
        val view_after_reset = hir_snapshot_read(snap_gen0).unwrap()
        expect(view_after_reset.path).to_equal("s0.spl")
        expect(hir_snapshot_verify_count_v1()).to_equal(verifies_before + 3)

    it "supports explicit HirSnapshotSessionCacheV1 and rejects corrupted or unknown-codec payloads":
        var cache = HirSnapshotSessionCacheV1.new()
        val snap = hir_snapshot_freeze(fixture("app.cache_mod", "c.spl"), 2).unwrap()

        var m1 = cache.read(snap).unwrap()
        expect(cache.sha256_verifications).to_equal(1)
        expect(cache.cache_hits).to_equal(0)
        m1.path = "dirty.spl"

        val m2 = cache.read(snap).unwrap()
        expect(cache.sha256_verifications).to_equal(1)
        expect(cache.cache_hits).to_equal(1)
        expect(m2.path).to_equal("c.spl")

        # Global epoch bump invalidates explicit cache instances on next read.
        val _bumped = hir_snapshot_session_invalidate_v1()
        val m3 = cache.read(snap).unwrap()
        expect(cache.sha256_verifications).to_equal(2)
        expect(m3.path).to_equal("c.spl")

        # Corrupted payload with matching SHA-256 digest is rejected and never cached.
        val garbage = "corrupted-hir-header\nnot-a-valid-frame\n"
        val forged_id = hir_snapshot_id_new("app.corrupt", sha256_text(garbage), 0).unwrap()
        val corrupt_snap = HirSnapshot(id: forged_id, frozen_bytes: garbage, codec: "legacy")
        expect(cache.read(corrupt_snap).unwrap_err()).to_equal("hir_snapshot_decode_failed: app.corrupt")
        expect(hir_snapshot_read(corrupt_snap).unwrap_err()).to_equal("hir_snapshot_decode_failed: app.corrupt")

        val bad_codec = HirSnapshot(id: snap.id, frozen_bytes: snap.frozen_bytes, codec: "bogus")
        expect(cache.read(bad_codec).unwrap_err()).to_equal("hir_snapshot_codec_unknown: bogus")
        expect(hir_snapshot_read(bad_codec).unwrap_err()).to_equal("hir_snapshot_codec_unknown: bogus")

    it "does not retain transient-scope frozen_bytes in HirSnapshotSessionCacheV1":
        """Verify HirSnapshotSessionCacheV1.read skips storing verified_bytes when transient_array_scope_state_v1() == 1."""
        var cache = HirSnapshotSessionCacheV1.new()
        val snap = hir_snapshot_freeze(fixture("app.transient_mod", "t.spl"), 5).unwrap()
        val entered = transient_scope_begin()
        val decoded = cache.read(snap).unwrap()
        expect(decoded.path).to_equal("t.spl")
        if entered:
            transient_scope_end()
            expect(cache.verified_bytes.keys().len()).to_equal(0)
