# Purpose and audience: executable evidence for self-hosted compiler engineers
# that HIR lowering forwards a field write `recv.x = v` with no real field `x`
# to recv.set_x(v), that a real field write stays a field assignment, and that
# a compound write `recv.x op= v` lowers to one getter read and one setter
# write after the right-hand side (owner decision 2026-11-06), and is a hard
# error when no getter exists.
# @req REQ-SELFHOST-ACCESSOR-003
# requirements: doc/02_requirements/compiler/mdsoc_matrix_visibility_requirements.md

use std.spec
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*

val DECLS = "class Temp:\n" +
    "    level: i64\n" +
    "    me set_celsius(v: i64):\n" +
    "        self.level = v\n" +
    "    me set_level(v: i64):\n" +
    "        self.level = v + 1\n" +
    "    me set__hidden(v: i64):\n" +
    "        self.level = v\n" +
    "    fn get_kelvin() -> i64:\n" +
    "        self.level\n" +
    "    me set_kelvin(v: i64):\n" +
    "        self.level = v\n" +
    "class Holder:\n" +
    "    inner: Temp\n"

fn stmt_tag(s: HirStmt) -> text:
    match s.kind:
        case HirStmtKind.Expr(ex):
            match ex.kind:
                case HirExprKind.MethodCall(_, method, args, _): "method:{method}/{args.len()}"
                case _: "expr"
        case HirStmtKind.Assign(_, _, _): "assign"
        case HirStmtKind.Let(_, _, _): "let"
        case HirStmtKind.Block(b):
            var inner: [text] = []
            for st in b.stmts:
                inner.push(stmt_tag(st))
            "block[" + inner.join(",") + "]"
        case _: "other"

fn probe_first(probe_body: text) -> [text]:
    # Returns [first statement tag, error count, joined diagnostics].
    val src = DECLS + "\nfn probe(t: Temp, h: Holder) -> i64:\n    " + probe_body + "\n    0\n"
    val parsed = parse_full_frontend(src, "testdata/accessor_set.spl", "accessor_set", Logger(level: 0))
    var lowering = HirLowering.with_filename("testdata/accessor_set.spl")
    val hir = lowering.lower_module(parsed)
    var tag = "missing"
    for fn_ in hir.functions.values():
        if fn_.name == "probe":
            tag = "empty"
            if fn_.body.stmts.len() > 0:
                tag = stmt_tag(fn_.body.stmts[0])
    var msgs = ""
    for m in lowering.diagnostic_messages:
        msgs = msgs + m + ";"
    [tag, "{lowering.errors.len()}", msgs]

describe "HIR accessor forwarding for field writes":
    it "forwards recv.celsius = v to set_celsius(v)":
        step("given no field celsius but set_celsius when writing t.celsius = 5 then a set_celsius call is lowered")
        val r = probe_first("t.celsius = 5")
        expect(r[0]).to_equal("method:set_celsius/1")
        expect(r[2]).to_equal("")
        expect(r[1]).to_equal("0")

    it "keeps a real field write as an assignment":
        step("given a real field level and set_level when writing t.level = 5 then the field is assigned")
        val r = probe_first("t.level = 5")
        expect(r[0]).to_equal("assign")

    it "does not forward underscore-prefixed names":
        step("given set__hidden when writing t._hidden = 5 then no setter call is lowered")
        val r = probe_first("t._hidden = 5")
        expect(r[0]).to_equal("assign")

    it "rejects compound assignment through a forwarded name with no getter":
        step("given set_celsius and no getter when writing t.celsius += 1 then lowering reports an error")
        val r = probe_first("t.celsius += 1")
        expect(r[1] == "0").to_equal(false)

    it "lowers compound assignment through a getter/setter pair to rhs, get, set":
        step("given get_kelvin and set_kelvin when writing t.kelvin += 1 then the rhs is bound first and set_kelvin is called once")
        # Bug: doc/08_tracking/bug/compound_assign_through_property_setter_fails_seed_2026-11-06.md
        val r = probe_first("t.kelvin += 1")
        expect(r[0]).to_equal("block[let,method:set_kelvin/1]")
        expect(r[1]).to_equal("0")

    it "rejects compound assignment through an accessor on a dotted receiver":
        step("given Holder.inner: Temp when writing h.inner.kelvin += 1 then lowering reports an error instead of naming the receiver twice")
        val r = probe_first("h.inner.kelvin += 1")
        expect(r[1] == "0").to_equal(false)

    it "forwards a nested receiver h.inner.celsius = v to set_celsius(v)":
        step("given Holder.inner: Temp when writing h.inner.celsius = 5 then a set_celsius call is lowered")
        val r = probe_first("h.inner.celsius = 5")
        expect(r[0]).to_equal("method:set_celsius/1")
        expect(r[1]).to_equal("0")

    it "keeps a nested real field write as an assignment":
        step("given Holder.inner.level when writing h.inner.level = 5 then the field is assigned")
        val r = probe_first("h.inner.level = 5")
        expect(r[0]).to_equal("assign")
