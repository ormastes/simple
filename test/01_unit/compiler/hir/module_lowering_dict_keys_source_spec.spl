# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "HIR module lowering Dict key traversal source":
    # @manual scenario evidence
    it "uses deterministic sorted .keys() traversal across split _Items lowering files instead of bucket-order rt_dict_keys":
        # @req REQ-SSPEC-COMPILER
        step("uses deterministic sorted .keys() traversal across split _Items lowering files instead of bucket-order rt_dict_keys")
        val items_src = rt_file_read_text("src/compiler/20.hir/hir_lowering/items.spl") ?? ""
        val bootstrap_src = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl") ?? ""
        val build_src = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_build.spl") ?? ""
        val helpers_src = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/lowering_helpers.spl") ?? ""
        val import_reg_src = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl") ?? ""
        val mod_lower_src = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""

        expect(items_src).to_contain("export use compiler.hir.hir_lowering._Items.module_declarations_bootstrap.*")
        expect(bootstrap_src).to_contain("var cls_keys = module_classes.keys()")
        expect(bootstrap_src).to_contain("cls_keys.sort()")
        expect(build_src).to_contain("var flat_symbol_keys = self.symbols.symbols.keys()")
        expect(build_src).to_contain("flat_symbol_keys.sort()")
        expect(build_src).to_contain("val lowered_impl_function_keys = self.lowered_impl_functions.keys()")
        expect(helpers_src).to_contain("var symbol_keys = module.symbols.symbols.keys()")
        expect(helpers_src).to_contain("symbol_keys.sort()")
        expect(import_reg_src).to_contain("for enum_key in self.imported_enums.keys():")
        expect(bootstrap_src.contains("= rt_dict_keys(")).to_equal(false)
        expect(build_src.contains("= rt_dict_keys(")).to_equal(false)
        expect(helpers_src.contains("= rt_dict_keys(")).to_equal(false)
        expect(import_reg_src.contains("= rt_dict_keys(")).to_equal(false)
        expect(mod_lower_src.contains("= rt_dict_keys(")).to_equal(false)
