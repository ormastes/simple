"""
## Purpose and audience
Purpose: Prove that seed-parity container and Self type names lower without error.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-HIR-001 — stable requirement identity for this spec.

# @cover src/compiler/20.hir/hir_lowering/types.spl 4%
# @tag: unit, compiler, hir, types, seed-parity, self, tuple, dict

# Seed-parity regression for `HirLowering.lower_named_kind`
# (src/compiler/20.hir/hir_lowering/types.spl), continuing the campaign started
# by seed_parity_scalar_type_names_spec.spl.
#
# The Rust seed's type resolver
# (src/compiler_rust/compiler/src/hir/lower/type_resolver.rs) accepts several
# further spellings that this compiler's strict gate rejected outright:
#
#   * `Self`               -> the enclosing class / trait-impl type   (seed:8)
#   * `has_X`              -> Optional(X)                             (seed:128)
#   * a single uppercase   -> Any                                     (seed:141)
#     letter (T / K / V)
#   * `tuple`              -> the empty tuple type                    (seed:178)
#   * `Map` / `HashMap`    -> Dict(K,V) with 2 args, else Any    (seed:459/182)
#   * `dict` / `set`       -> Any                                     (seed:182)
#
# These are NOT source defects -- the seed already accepts them, so the sources
# spelling them are legal. The fix belongs in the resolver, never in the ~1,000
# call sites.
#
# MEASUREMENT NOTE: no seed-driven probe can gate any of this. Both
# `simple_seed run` and `simple_seed compile -o out.smf` resolve a deliberately
# bogus type to ANY under `lenient_types`, exit 0, and emit a present artifact.
# Only driving HirLowering IN-PROCESS and asserting on `lowering.errors` gates
# it. (Running THIS spec under the seed as a host interpreter is fine and is
# not that trap: the seed merely executes the spec, while the resolver under
# test is the pure-Simple `lower_named_kind`. Proven by sabotage -- deleting an
# arm turns these examples RED.)

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.{HirFunction}

describe "seed-parity container and Self type names lower without error":
    it "resolves a bare tuple annotation to the empty tuple type":
        step("Verify: resolves a bare tuple annotation to the empty tuple type")
        # @req: REQ-COMPILER-HIR-001
        # Seed: `"tuple" => register(HirType::Tuple(vec![]))`. The annotation
        # carries no element types, so an EMPTY element list is the faithful
        # mapping -- widening to Any here would lose the tuple-ness that MIR
        # keys aggregate layout off.
        val source = "fn pair(a: tuple):\n    ()\n"
        val parsed = parse_full_frontend(source, "pair.spl", "pair", Logger(level: 0))
        var lowering = HirLowering.with_filename("pair.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("pair"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Tuple(elements):
                    expect(elements.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "resolves bare Map, HashMap, dict and set annotations":
        step("Verify: resolves bare Map, HashMap, dict and set annotations")
        # Seed maps every argless container spelling to ANY (type_resolver:182).
        val source = "fn bag(a: Map, b: HashMap, c: dict, d: set):\n    ()\n"
        val parsed = parse_full_frontend(source, "bag.spl", "bag", Logger(level: 0))
        var lowering = HirLowering.with_filename("bag.spl")
        lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "resolves a bare single uppercase letter to Any":
        step("Verify: resolves a bare single uppercase letter to Any")
        # Seed: `name.len() == 1 && all ascii_uppercase => TypeId::ANY`.
        # These are type-parameter spellings the generic binder did not
        # register.
        val source = "fn generic(a: T, b: K, c: V):\n    ()\n"
        val parsed = parse_full_frontend(source, "generic.spl", "generic", Logger(level: 0))
        var lowering = HirLowering.with_filename("generic.spl")
        lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "resolves has_X as an optional X":
        step("Verify: resolves has_X as an optional X")
        # Seed strips the `has_` prefix and re-resolves the base as
        # Type::Optional(base). Assert the STRUCTURE, not just the absence of
        # an error: a rule that merely swallowed the name to Any would leave
        # `.unwrap_or(default)` mistyped exactly the way the Option bug did.
        val source = "fn maybe(a: has_i64):\n    ()\n"
        val parsed = parse_full_frontend(source, "maybe.spl", "maybe", Logger(level: 0))
        var lowering = HirLowering.with_filename("maybe.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("maybe"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Optional(inner):
                    match inner.kind:
                        case Int(bits, signed_):
                            expect(bits).to_equal(64)  # oracle: 64 — named expected value from the requirement
                            expect(signed_).to_equal(true)
                        case _:
                            expect(false).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "resolves Self inside a class method to the enclosing class type":
        step("Verify: resolves Self inside a class method to the enclosing class type")
        # Seed: resolve_self_type() returns current_class_type. This layer
        # already tracks the identical context in `current_method_self_type`,
        # so this is real self-type resolution rather than a scalar table entry.
        val source = "class Widget:\n    val n: i64\n\n    me clone_it() -> Self:\n        me\n"
        val parsed = parse_full_frontend(source, "widget.spl", "widget", Logger(level: 0))
        var lowering = HirLowering.with_filename("widget.spl")
        lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        for e in lowering.errors:
            expect(e.message.contains("unresolved type")).to_equal(false)

    it "still rejects a type name that is genuinely declared nowhere":
        step("Verify: still rejects a type name that is genuinely declared nowhere")
        # LIVE CONTROL. Without it, every example above would pass just as well
        # against a lower_named_kind weakened to accept any unknown name --
        # which is precisely the seed's own `lenient_types` failure mode.
        # Asserted by error IDENTITY, not count: the same annotation is
        # reported once per lowering pass that visits it.
        val source = "fn bogus(a: ZzzNotARealTypeQqq):\n    ()\n"
        val parsed = parse_full_frontend(source, "bogus.spl", "bogus", Logger(level: 0))
        var lowering = HirLowering.with_filename("bogus.spl")
        lowering.lower_module(parsed)

        var saw_unresolved = false
        for e in lowering.errors:
            if e.message == "unresolved type: ZzzNotARealTypeQqq":
                saw_unresolved = true
        expect(saw_unresolved).to_equal(true)

    it "still rejects a multi-letter uppercase name that is declared nowhere":
        step("Verify: still rejects a multi-letter uppercase name that is declared nowhere")
        # Guards the single-letter rule's BOUNDARY. `TK` is two uppercase
        # letters, so the seed's `name.len() == 1` guard must keep rejecting
        # it. A rule implemented as "all uppercase" without the length check
        # would erase whole undeclared type names to Any and pass the control
        # above.
        val source = "fn two(a: TK):\n    ()\n"
        val parsed = parse_full_frontend(source, "two.spl", "two", Logger(level: 0))
        var lowering = HirLowering.with_filename("two.spl")
        lowering.lower_module(parsed)

        var saw_unresolved = false
        for e in lowering.errors:
            if e.message == "unresolved type: TK":
                saw_unresolved = true
        expect(saw_unresolved).to_equal(true)

    it "lets a really declared Map struct win over the bare-container rule":
        step("Verify: lets a really declared Map struct win over the bare-container rule")
        # ORDERING GATE. The bare-container rules sit AFTER the symbol lookup,
        # exactly where the seed puts them. This tree really does declare
        # `Map`, `HashMap` and `Set` types, so a hoisted rule would shadow them
        # and silently retype their annotations to Any. Assert the declared
        # struct still resolves to a Named type.
        val source = "struct Map:\n    k: i64\n\nfn use_map(a: Map):\n    ()\n"
        val parsed = parse_full_frontend(source, "realmap.spl", "realmap", Logger(level: 0))
        var lowering = HirLowering.with_filename("realmap.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("use_map"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Named(_sym, _args):
                    expect(true).to_equal(true)
                case _:
                    # Any here would mean the bare-container rule shadowed a
                    # genuinely declared struct.
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)
