# Source ownership ratchet only; native lifecycle validation is still pending.
use std.spec
use std.io.{file_read}

val TYPES = "src/compiler/20.hir/hir_lowering/types.spl"

fn memo_body(source: text) -> text:
    val start = source.find("    me promote_phase_memo_transient_owners()")
    val finish = source.find("    me lower_type(")
    if start < 0 or finish <= start:
        return ""
    source.substring(start, finish)

describe "phase memo promotion owner parity":
    it "keeps every original owner and excludes module-local graphs":
        val body = memo_body(file_read(TYPES))
        expect(body.len() > 0).to_equal(true)
        for owner in [
            "field_package_dep_memo", "surface_package_name_memo",
            "surface_package_name_memo_keys", "surface_package_name_memo_values",
            "surface_package_name_memo_hash_buckets", "surface_package_name_memo_hash_next",
            "surface_decl_pair_names", "surface_decl_pair_surfaces",
            "surface_decl_pair_hash_buckets", "surface_decl_pair_hash_next",
            "package_sibling_names", "package_sibling_canons", "surface_index_by_name",
            "explicit_dep_target_memo", "explicit_dep_item_memo",
            "explicit_dep_target_memo_keys", "explicit_dep_target_memo_target_values",
            "explicit_dep_target_memo_item_values", "explicit_dep_target_memo_hash_buckets",
            "explicit_dep_target_memo_hash_next", "payload_origin_miss_memo",
            "payload_origin_miss_memo_keys", "payload_origin_miss_memo_hash_buckets",
            "payload_origin_miss_memo_hash_next", "impl_index_built", "impl_index_positions",
            "impl_method_name_index", "impl_trait_name_index", "name_index_built",
            "name_index_positions", "name_index_keys", "name_index_positions_values",
            "name_index_hash_buckets", "name_index_hash_next", "name_index_built_keys",
            "name_index_built_buckets", "name_index_built_next", "glob_reachable_miss_memo",
            "glob_reachable_miss_memo_keys", "glob_reachable_miss_memo_hash_buckets",
            "glob_reachable_miss_memo_hash_next", "glob_reachable_importer_owner",
            "reexport_root_memo_index", "reexport_root_memo_item", "reexport_root_memo_keys",
            "reexport_root_memo_index_values", "reexport_root_memo_item_values",
            "reexport_root_memo_hash_buckets", "reexport_root_memo_hash_next"
        ]:
            expect(body.contains("(self.{owner})")).to_equal(true)
        expect(body.contains("rt_transient_heap_promote(self)")).to_equal(false)
        expect(body.contains("self.module_surfaces")).to_equal(false)
        expect(body.contains("self.symbols")).to_equal(false)

    it "preserves the scalar text guard and propagates either owner failure":
        val body = memo_body(file_read(TYPES))
        expect(body.len() > 0).to_equal(true)
        expect(body.contains("val memos_ok = hir_phase_memo_promote_roots(roots)")).to_equal(true)
        expect(body.contains("self.glob_reachable_importer_owner == \"\" or")).to_equal(true)
        expect(body.contains("rt_transient_heap_promote(self.glob_reachable_importer_owner)")).to_equal(true)
        expect(body.contains("memos_ok and glob_importer_owner_ok")).to_equal(true)
