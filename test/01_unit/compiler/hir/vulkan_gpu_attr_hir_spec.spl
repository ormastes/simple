"""
## Purpose and audience
Purpose: Prove that Vulkan GPU attributes survive HIR lowering.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-HIR-001 — stable requirement identity for this spec.

# @cover src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl 3%
# @tag: unit, compiler, hir, gpu, vulkan, regression

use std.spec
use compiler.common.attributes.{parse_function_attrs}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*

describe "Vulkan GPU attributes survive HIR lowering":
    it "preserves kernel and target metadata from source":
        step("Verify: preserves kernel and target metadata from source")
        # @req: REQ-COMPILER-HIR-001
        val source = "@gpu(\"vulkan\")\nfn kernel(input: [u32]):\n    ()\n"
        val parsed = parse_full_frontend(source, "vulkan_gpu_attr.spl", "vulkan_gpu_attr", Logger(level: 0))
        val parser_function = parsed.functions.values()[0]
        val parser_attr = parse_function_attrs(parser_function.attributes)
        var lowering = HirLowering.with_filename("vulkan_gpu_attr.spl")
        val hir = lowering.lower_module(parsed)

        expect(parser_function.is_kernel).to_equal(true)
        expect(parser_attr.is_gpu_kernel).to_equal(true)
        expect(parser_attr.gpu_target).to_equal("vulkan")
        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(hir.functions.values().len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(hir.functions.contains_key(hir.symbols.lookup_or_invalid("kernel"))).to_equal(true)
        val function = hir.functions.values()[0]
        expect(function.func_attr.is_gpu_kernel).to_equal(true)
        expect(function.func_attr.gpu_target).to_equal("vulkan")
        expect(function.is_gpu_kernel).to_equal(true)
        expect(function.gpu_target).to_equal("vulkan")

    it "preserves named target metadata from source":
        step("Verify: preserves named target metadata from source")
        val source = "@gpu(target=\"vulkan\")\nfn kernel(input: [u32]):\n    ()\n"
        val parsed = parse_full_frontend(source, "vulkan_gpu_named_attr.spl", "vulkan_gpu_named_attr", Logger(level: 0))
        val parser_function = parsed.functions.values()[0]
        val parser_attr = parse_function_attrs(parser_function.attributes)
        var lowering = HirLowering.with_filename("vulkan_gpu_named_attr.spl")
        val hir = lowering.lower_module(parsed)

        expect(parser_attr.gpu_target).to_equal("vulkan")
        val function = hir.functions.values()[0]
        expect(function.func_attr.gpu_target).to_equal("vulkan")

    it "preserves CUDA and Metal target metadata from source":
        step("Verify: preserves CUDA and Metal target metadata from source")
        for target in ["cuda", "metal"]:
            val source = "@gpu(\"{target}\")\nfn kernel(input: [u32]):\n    ()\n"
            val parsed = parse_full_frontend(source, "{target}_gpu_attr.spl", "{target}_gpu_attr", Logger(level: 0))
            var lowering = HirLowering.with_filename("{target}_gpu_attr.spl")
            val hir = lowering.lower_module(parsed)

            expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            val function = hir.functions.values()[0]
            expect(function.func_attr.is_gpu_kernel).to_equal(true)
            expect(function.func_attr.gpu_target).to_equal(target)

    it "lowers an explicit Unit return without a Tuple receiver error":
        step("Verify: lowers an explicit Unit return without a Tuple receiver error")
        val source = "@gpu(\"vulkan\")\nfn kernel(input: [u32], n: u32) -> ():\n    ()\n"
        val parsed = parse_full_frontend(source, "vulkan_gpu_unit_return.spl", "vulkan_gpu_unit_return", Logger(level: 0))
        var lowering = HirLowering.with_filename("vulkan_gpu_unit_return.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(hir.functions.values().len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
