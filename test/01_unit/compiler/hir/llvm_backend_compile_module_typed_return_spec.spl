"""
# llvm_backend.compile_module keeps its `-> Result<LlvmCompileResult, text>`

Reproduce for the bootstrap-closure untyped-return fatal reintroduced by
f858c7cf32e (2026-08-22): that commit was a stale-snapshot clobber of
src/compiler/70.backend/backend/llvm_backend.spl which silently dropped the
return annotation that f9a7b5cb296 had added. On the native path the module
then fatals with `untyped function returns a value: function
'compile_module' ...` (the method returns `Ok(...)`/`Err(...)` on every
branch). The tree-wide guard `scripts/check/check-untyped-return-value.shs`
flags it as a hard-scope offender; this spec pins the one declaration so the
revert is caught by `simple test` as well.
"""

use std.nogc_sync_mut.io.file_ops.{file_read_text}

describe "llvm_backend compile_module return annotation":
    it "declares -> Result<LlvmCompileResult, text>":
        val src = file_read_text("src/compiler/70.backend/backend/llvm_backend.spl")
        expect(src.contains("fn compile_module(module: MirModule) -> Result<LlvmCompileResult, text>:")).to_equal(true)
        expect(src.contains("fn compile_module(module: MirModule):")).to_equal(false)
