# @cover src/compiler/20.hir/hir_lowering/_Expressions/match_desugaring.spl
# @cover src/compiler/10.frontend/core/parser_stmts.spl
#
# EXECUTION companion to enum_payload_nested_range_or_lowering_spec.spl, which
# only greps the lowering SOURCE. This one runs the real
# parse_full_frontend -> HirLowering.lower_module pipeline in-process and
# asserts the pure-Simple frontend both PARSES and LOWERS an `Or` / `Range`
# sub-pattern inside an enum payload with zero lowering errors.
#
# The Rust seed's own parser still rejects `case V(2 | 3):`
# ("expected Comma, found Pipe"), which is why
# test/fixtures/compiler/enum_payload_range_or_matrix.spl cannot run on the
# seed lane; that is a seed-parser gap, not a pure-Simple one.
#
# HARNESS NOTE: `use compiler.hir.hir_lowering.statements.*` is REQUIRED --
# without it lower_module fails with
# "method `lower_hir_stmt_multi` not found on type `HirLowering`".
# tag: unit
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*

describe "pure-Simple frontend: or/range enum payload sub-patterns":
    it "lowers an Or payload sub-pattern without errors":
        val src = "enum Shape:\n    Square(i64)\n\npub fn f(s: Shape) -> i64:\n    match s:\n        case Shape.Square(2 | 3): 100\n        case _: 0\n"
        val parsed = parse_full_frontend(src, "testdata/or.spl", "or", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/or.spl")
        val hir = hl.lower_module(parsed)
        for err in hl.errors:
            print("ERR: " + err.message)
        expect(hl.errors.len()).to_equal(0)

    it "lowers a Range payload sub-pattern without errors":
        val src = "enum Shape:\n    Square(i64)\n\npub fn g(s: Shape) -> i64:\n    match s:\n        case Shape.Square(1..5): 100\n        case _: 0\n"
        val parsed = parse_full_frontend(src, "testdata/rg.spl", "rg", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/rg.spl")
        val hir = hl.lower_module(parsed)
        for err in hl.errors:
            print("ERR2: " + err.message)
        expect(hl.errors.len()).to_equal(0)
