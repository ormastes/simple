use std.spec.*
use std.io_runtime.{read_file_text}

describe "HIR import-registration scalar profiler source contract":
    it "retains only scalar registration state and samples at powers of two":
        val source = read_file_text("src/compiler/20.hir/hir_lowering/hir_phase_profile.spl")
        val state_start = source.index_of("var _hir_prof_imported_symbol_attempts: i64 = 0")
        val state_end = source.index_of("fn hir_phase_profile_enabled()", state_start)
        expect(state_start).to_be_greater_than(-1)
        expect(state_end).to_be_greater_than(state_start)
        val state = source.substring(state_start, state_end)
        expect(state).to_contain("var _hir_prof_imported_symbol_completed: i64 = 0")
        expect(state).to_contain("var _hir_prof_imported_symbol_active_depth: i64 = 0")
        expect(state).to_contain("var _hir_prof_imported_symbol_max_depth: i64 = 0")
        expect(state).to_contain("var _hir_prof_imported_symbol_alias_attempts: i64 = 0")
        expect(state).to_contain("var _hir_prof_imported_symbol_max_key_length: i64 = 0")
        expect(state).to_contain("var _hir_prof_imported_symbol_next_sample: i64 = 1")
        expect(state.contains("[text]")).to_equal(false)
        expect(state.contains("{text:")).to_equal(false)

        val enter_start = source.index_of("fn hir_phase_profile_imported_symbol_enter(key_len: i64, alias_local: bool)")
        val enter_end = source.index_of("fn hir_phase_profile_imported_symbol_complete()", enter_start)
        expect(enter_start).to_be_greater_than(-1)
        expect(enter_end).to_be_greater_than(enter_start)
        val enter = source.substring(enter_start, enter_end)
        expect(enter).to_contain("_hir_prof_imported_symbol_attempts == _hir_prof_imported_symbol_next_sample")
        expect(enter).to_contain("_hir_prof_imported_symbol_next_sample = _hir_prof_imported_symbol_next_sample * 2")
        expect(enter).to_contain("eprint(\"[hir-prof-reg] attempts=")
        expect(enter).to_contain("rt_stderr_flush()")

    it "balances registration depth on skip and completed-inner paths":
        val source = read_file_text("src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl")
        val start = source.index_of("me register_imported_symbol(imported_index: i64")
        val end = source.index_of("me ensure_surface_name_index(", start)
        expect(start).to_be_greater_than(-1)
        expect(end).to_be_greater_than(start)
        val body = source.substring(start, end)
        val enter = body.index_of("hir_phase_profile_imported_symbol_enter(registered_key.len(), local_name != imported_name)")
        val skip = body.index_of("hir_phase_profile_count_imported_symbol_skip()")
        val skip_exit = body.index_of("hir_phase_profile_imported_symbol_exit()", skip)
        val inner = body.index_of("self.register_imported_symbol_inner(")
        val memo_store = body.index_of("self.registered_import_memo[registered_key] = true", inner)
        val complete = body.index_of("hir_phase_profile_imported_symbol_complete()")
        val completed_exit = body.index_of("hir_phase_profile_imported_symbol_exit()", complete)
        expect(enter).to_be_greater_than(-1)
        expect(skip).to_be_greater_than(enter)
        expect(skip_exit).to_be_greater_than(skip)
        expect(inner).to_be_greater_than(skip_exit)
        expect(memo_store).to_be_greater_than(inner)
        expect(complete).to_be_greater_than(memo_store)
        expect(completed_exit).to_be_greater_than(complete)
        expect(body).to_contain("[registered_key] = true")

    it "emits a flushed final per-module registration row":
        val source = read_file_text("src/compiler/20.hir/hir_lowering/hir_phase_profile.spl")
        val start = source.index_of("fn hir_phase_profile_module_end(module_name: text)")
        expect(start).to_be_greater_than(-1)
        val body = source.substring(start, source.index_of("# ============================================================================", start))
        expect(body).to_contain("eprint(\"[hir-prof-reg] module={module_name}\"")
        expect(body).to_contain("attempts={_hir_prof_imported_symbol_attempts}")
        expect(body).to_contain("completed={_hir_prof_imported_symbol_completed}")
        expect(body).to_contain("skips={_hir_prof_imported_symbol_skips}")
        expect(body).to_contain("max_depth={_hir_prof_imported_symbol_max_depth}")
        expect(body).to_contain("aliases={_hir_prof_imported_symbol_alias_attempts}")
        expect(body).to_contain("max_key_len={_hir_prof_imported_symbol_max_key_length}")
        expect(body).to_contain("rt_stderr_flush()")
