# @tag: unit, compiler, hir, perf, source-contract

use std.spec.{describe, it, expect}
use std.io_runtime.{read_file_text}

val MODULE_SURFACE_REGISTRY = "src/compiler/20.hir/hir_lowering/module_surface_registry.spl"
val MODULE_SURFACE_REGISTRY_INDEX = "src/compiler/20.hir/hir_lowering/module_surface_registry_index.spl"

describe "module surface registry linear construction guard":
    it "uses scalar dictionary lookups instead of nested alias scans":
        val registry_source = read_file_text(MODULE_SURFACE_REGISTRY)
        expect(registry_source).to_contain("if self.index_by_name.contains_key(name):")
        expect(registry_source.index_of("while existing_position < self.ordered_names.len()"))\
            .to_equal(-1)
        expect(registry_source.index_of("while position < self.ordered_names.len()"))\
            .to_equal(-1)

        val index_source = read_file_text(MODULE_SURFACE_REGISTRY_INDEX)
        expect(index_source).to_contain("var seen_names: Dict<text, bool> = {}")
        expect(index_source).to_contain("if not index_by_name.contains_key(ordered_names[i]):")
        expect(index_source.index_of("while prior < i:"))\
            .to_equal(-1)
        expect(index_source.index_of("while dict_position < dict_names.len():"))\
            .to_equal(-1)
