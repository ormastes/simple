# Singleton key ordering must preserve the exact text without a comparison.
use std.spec.*
use compiler.hir.hir_codec_key_order.{hc_order_text_keys_v1}

describe "HIR text key ordering without comparisons":
    it "preserves empty and singleton key snapshots":
        val empty: [text] = []
        expect(hc_order_text_keys_v1(empty)).to_equal([])
        val nil_key: [text] = [nil]
        expect(hc_order_text_keys_v1(nil_key)).to_equal([nil])
        expect(hc_order_text_keys_v1([""])).to_equal([""])
        val key = "한\n\\shared-prefix"
        val original = [key]
        expect(hc_order_text_keys_v1(original)).to_equal([key])
        expect(original).to_equal([key])

    it "keeps the UTF-8 merge path for multiple keys":
        val original: [text] = ["한", "aa", "", "a", "a"]
        expect(hc_order_text_keys_v1(original)).to_equal(
            ["", "a", "a", "aa", "한"])
        expect(original).to_equal(["한", "aa", "", "a", "a"])
