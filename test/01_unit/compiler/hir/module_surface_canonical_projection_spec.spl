use std.spec.{describe, it, expect}
use compiler.hir.hir_lowering.module_surface.{ModuleSurface, ModuleSurfacesByName}

describe "frozen module surface canonical projections":
    it "computes tier-free canonical and package names once at freeze":
        var surface = ModuleSurface.empty(
            "src/compiler/20.hir/hir_lowering/cache_probe.spl")
        surface.canonical_path =
            "src/compiler/20.hir/hir_lowering/cache_probe.spl"
        surface.module_name =
            "src/compiler/20.hir/hir_lowering/cache_probe.spl"
        val result = ModuleSurfacesByName.from_parts(
            [surface],
            {"src/compiler/20.hir/hir_lowering/cache_probe.spl": 0},
            ["src/compiler/20.hir/hir_lowering/cache_probe.spl"],
            [0])
        expect(result.is_ok()).to_equal(true)
        val frozen = result.unwrap().surfaces[0]
        expect(frozen.canonical_name).to_equal(
            "compiler.hir.hir_lowering.cache_probe")
        expect(frozen.package_name).to_equal(
            "compiler.hir.hir_lowering")
