# @cover src/compiler/10.frontend/core/parser_stmts.spl
# @cover src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl
#
# Regression: `_` inside a match-arm SUB-pattern must stay a wildcard pattern
# and must not be eaten by the placeholder-lambda shorthand.
#
# BACKGROUND (2026-08-01, lane no-import-resolution). Match patterns are parsed
# with the general expression parser (see convert_flat_pattern's docstring in
# _FlatAstBridge/convert_nodes.spl). `parse_expr` runs
# transform_placeholder_lambda, which rewrites any expression containing a `_`
# placeholder into a lambda. So `case Ok((selected, _)):` had its
# `(selected, _)` tuple sub-pattern rewritten into an EXPR_LAMBDA (tag 26) --
# a tag convert_flat_pattern has no case for, so it fell through to the
# catch-all and became an UNCONDITIONAL `Wildcard` that binds NOTHING.
#
# Two failures, one cause:
#   1. loud: the arm body's `selected` failed HIR lowering with
#      "unresolved name: selected" -- for a name declared in the very same
#      file (src/compiler/70.backend/backend/stage4_symbol_closure.spl:831,
#      the shape reproduced verbatim below).
#   2. silent: the arm became an unconditional wildcard, so it matched every
#      scrutinee including `Err`.
#
# The fix suppresses the placeholder transform for the duration of match-arm
# PATTERN parsing only (parse_match_arms_common, both the `case`-keyword and
# the caseless arm paths); guards and arm bodies are parsed outside the
# suppressed region and keep normal `_`-placeholder semantics.
#
# HARNESS NOTE (per me_field_resolution_spec.spl): the
# parse_full_frontend -> HirLowering -> lower_module pipeline is inlined in
# every `it` block on purpose -- do not factor this into a shared helper.
#
# tag: unit

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*

describe "match-arm `_` sub-patterns stay wildcards and do not drop sibling bindings":
    it "binds a tuple sub-pattern whose second element is `_` (stage4_symbol_closure shape)":
        val src = "fn produce() -> Result<([i64], text), text>:\n" +
            "    var selected: [i64] = []\n" +
            "    selected = selected.push(1)\n" +
            "    Ok((selected, \"rows\"))\n" +
            "\n" +
            "pub fn take() -> Result<[i64], text>:\n" +
            "    match produce():\n" +
            "        case Ok((selected, _)): Ok(selected)\n" +
            "        case Err(err): Err(err)\n"
        val parsed = parse_full_frontend(src, "testdata/match_underscore_tuple.spl", "match_underscore_tuple", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/match_underscore_tuple.spl")
        val hir = hl.lower_module(parsed)

        var unresolved_selected = false
        for err in hl.errors:
            if err.message.contains("unresolved name: selected"):
                unresolved_selected = true
        expect(unresolved_selected).to_equal(false)
        expect(hl.errors.len()).to_equal(0)

    it "binds the FIRST element when the `_` comes first":
        val src = "fn produce() -> Result<(text, [i64]), text>:\n" +
            "    Ok((\"rows\", [1]))\n" +
            "\n" +
            "pub fn take() -> Result<[i64], text>:\n" +
            "    match produce():\n" +
            "        case Ok((_, chosen)): Ok(chosen)\n" +
            "        case Err(err): Err(err)\n"
        val parsed = parse_full_frontend(src, "testdata/match_underscore_first.spl", "match_underscore_first", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/match_underscore_first.spl")
        val hir = hl.lower_module(parsed)

        var unresolved_chosen = false
        for err in hl.errors:
            if err.message.contains("unresolved name: chosen"):
                unresolved_chosen = true
        expect(unresolved_chosen).to_equal(false)
        expect(hl.errors.len()).to_equal(0)

    it "binds a bare tuple arm pattern containing `_`":
        val src = "pub fn take(pair: (i64, text)) -> i64:\n" +
            "    match pair:\n" +
            "        case (n, _): n\n"
        val parsed = parse_full_frontend(src, "testdata/match_underscore_bare_tuple.spl", "match_underscore_bare_tuple", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/match_underscore_bare_tuple.spl")
        val hir = hl.lower_module(parsed)

        var unresolved_n = false
        for err in hl.errors:
            if err.message.contains("unresolved name: n"):
                unresolved_n = true
        expect(unresolved_n).to_equal(false)
        expect(hl.errors.len()).to_equal(0)

    it "control: the same shape WITHOUT `_` was never broken and still lowers clean":
        val src = "fn produce() -> Result<([i64], text), text>:\n" +
            "    Ok(([1], \"rows\"))\n" +
            "\n" +
            "pub fn take() -> Result<[i64], text>:\n" +
            "    match produce():\n" +
            "        case Ok((selected, rows)): Ok(selected)\n" +
            "        case Err(err): Err(err)\n"
        val parsed = parse_full_frontend(src, "testdata/match_underscore_control.spl", "match_underscore_control", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/match_underscore_control.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)

    it "regression: a `_`-placeholder lambda in an ARM BODY still desugars (suppression is scoped)":
        val src = "pub fn take(xs: [i64]) -> text:\n" +
            "    match xs.len():\n" +
            "        case 0: \"\"\n" +
            "        case _: xs.map(int_to_text(_)).join(\",\")\n" +
            "\n" +
            "fn int_to_text(v: i64) -> text:\n" +
            "    v.to_text()\n"
        val parsed = parse_full_frontend(src, "testdata/match_underscore_body_lambda.spl", "match_underscore_body_lambda", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/match_underscore_body_lambda.spl")
        val hir = hl.lower_module(parsed)

        var unresolved_underscore = false
        for err in hl.errors:
            if err.message.contains("unresolved name: _"):
                unresolved_underscore = true
        expect(unresolved_underscore).to_equal(false)
        expect(hl.errors.len()).to_equal(0)
