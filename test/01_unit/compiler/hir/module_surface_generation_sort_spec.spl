use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry_index.{
    module_surface_resolution_rows_sorted_v1,
    module_surface_stable_resolution_generation_v1
}

# The previous production algorithm is an independent byte-order oracle.
fn legacy_generation_rows(rows: [text]) -> [text]:
    var sorted: [text] = []
    for row in rows:
        var inserted = false
        var next: [text] = []
        for current in sorted:
            if not inserted and row < current:
                next.push(row)
                inserted = true
            next.push(current)
        if not inserted: next.push(row)
        sorted = next
    sorted

fn expect_generation_order(rows: [text]):
    val original = rows.copy()
    val expected = legacy_generation_rows(rows)
    val actual = module_surface_resolution_rows_sorted_v1(rows)
    expect(actual).to_equal(expected)
    expect(actual.len()).to_equal(rows.len())
    expect(rows).to_equal(original)
    expect(sha256_text(actual.join("\n"))).to_equal(sha256_text(expected.join("\n")))

fn generation_registry(names: [text], indices: [i64]) -> ModuleSurfacesByName:
    var first = ModuleSurface.empty("first")
    first.canonical_path = "src/α.spl"
    var second = ModuleSurface.empty("second")
    second.canonical_path = "src/second.spl"
    ModuleSurfacesByName(surfaces: [first, second], index_by_name: {},
        ordered_names: names, ordered_indices: indices, generation: 0, frozen: false)

describe "surface generation stable merge ordering":
    it "preserves empty, singleton, sorted, reverse, duplicate and Unicode rows":
        expect_generation_order([])
        expect_generation_order(["one=src/one.spl"])
        expect_generation_order(["a=1", "b=2", "c=3", "d=4"])
        expect_generation_order(["d=4", "c=3", "b=2", "a=1"])
        expect_generation_order(["same=path", "same=path", "a=path", "same=path"])
        expect_generation_order(["λ=δ", "é=é", "e=ascii", "😀=emoji", "α=path", "é=é", ""])

    it "handles incomplete merge runs and several doubling boundaries":
        for count in [2, 3, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 128, 256]:
            var rows: [text] = []
            var index = 0
            while index < count:
                rows.push("alias.{(count - index) % 11}=src/{index % 7}.spl")
                index = index + 1
            expect_generation_order(rows)

    it "keeps exact generation bytes independent of alias insertion order":
        val rows = ["z=src/second.spl", "α=src/α.spl", "a=src/α.spl", "z=src/second.spl"]
        val expected = sha256_text(legacy_generation_rows(rows).join("\n"))
        val registry = generation_registry(["z", "α", "a", "z"], [1, 0, 0, 1])
        val reordered = generation_registry(["a", "z", "z", "α"], [0, 1, 1, 0])
        expect(module_surface_stable_resolution_generation_v1(registry)).to_equal(expected)
        expect(module_surface_stable_resolution_generation_v1(reordered)).to_equal(expected)

    it "preserves filtering of invalid indices and unmatched names":
        val registry = generation_registry(["a", "negative", "large", "unmatched"], [0, -1, 2])
        expect(module_surface_stable_resolution_generation_v1(registry)).to_equal(
            sha256_text("a=src/α.spl"))
        expect(module_surface_stable_resolution_generation_v1(
            generation_registry([], []))).to_equal(sha256_text(""))
        expect(module_surface_stable_resolution_generation_v1(
            generation_registry(["invalid"], [-1]))).to_equal(sha256_text(""))
