use compiler.hir.hir_types.{SymbolId, SymbolTable}

extern fn rt_exit(code: i32)

var symbols = SymbolTable.new()
for index in 0..512:
    symbols.bind_qualified_function(
        "module{index}", "call{index}", SymbolId(id: index))
    symbols.bind_qualified_type(
        "module{index}", "Type{index}", SymbolId(id: index + 1000))

if symbols.lookup_qualified_function_raw("module0", "call0") != 0 or
   symbols.lookup_qualified_function_raw("module511", "call511") != 511 or
   symbols.lookup_qualified_type_raw("module0", "Type0") != 1000 or
   symbols.lookup_qualified_type_raw("module511", "Type511") != 1511 or
   symbols.lookup_qualified_function_raw("module511", "missing") != -1 or
   symbols.lookup_qualified_type_raw("missing", "Type511") != -1:
    print "FAIL: scalar qualified symbol index returned an incorrect id"
    rt_exit(1)

print "PASS: scalar qualified symbol index preserves exact ids"
rt_exit(0)
