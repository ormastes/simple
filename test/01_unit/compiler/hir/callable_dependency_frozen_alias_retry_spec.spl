# @cover src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl
# @req REQ-HIR-CALLABLE-OWNER-RETRY-001
# AUTHORED_UNEXECUTED: requires a compiler built from the matching source epoch.
# This controls a negative owner projection against an actually frozen registry.
# It does not reproduce how a genuine bootstrap acquired that negative carrier.
use std.spec.{describe, it, expect}
use std.spec.step
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.parser_types.{ParserImport, ImportItem, Variant, VariantKind}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering._Items.module_reexport_materialization.*
use compiler.hir.hir_lowering._Items.module_import_registration.*
use compiler.hir.hir_lowering._Items.module_lowering.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurface, ModuleSurfaceEnum, ModuleSurfacesByName}

fn retry_provider(name: text, declaration: text) -> ModuleSurface:
    var surface = ModuleSurface.empty(name)
    val enum_decl = ModuleSurfaceEnum(
        name: declaration, type_params: [],
        variants: [Variant(name: "Zero", kind: VariantKind.Tuple([]), span: Span.empty())],
        visibility: Visibility.Public, is_public: true, span: Span.empty())
    surface.enums[declaration] = enum_decl
    surface.enum_names = [declaration]
    surface.enum_values = [enum_decl]
    surface

fn retry_named_owner(module_name: text, target: text) -> ModuleSurface:
    var owner = ModuleSurface.empty(module_name)
    owner.preferred_registry_name = module_name
    owner.imports = [ParserImport(module: target,
        items: [ImportItem(name: "Payload", has_alias: false, alias: "")],
        is_lazy: false, span: Span.empty())]
    owner.import_target_indices = [-1]
    owner.import_target_names = [""]
    owner.import_item_offsets = [0, 1]
    owner.import_item_names = ["Payload"]
    owner.import_item_aliases = [""]
    owner.import_item_has_alias = [false]
    owner

fn retry_registry(owner: ModuleSurface, provider: ModuleSurface) -> ModuleSurfacesByName:
    val consumer = ModuleSurface.empty("retry.consumer")
    val built = ModuleSurfacesByName.from_parts([provider, owner, consumer],
        {provider.module_name: 0, owner.module_name: 1, "retry.consumer": 2},
        [provider.module_name, owner.module_name, "retry.consumer"], [0, 1, 2])
    built.unwrap()

# ModuleSurface is a class: never clear indices on an alias of a frozen row.
# This independently allocated carrier models the negative projection input.
fn retry_unresolved_carrier(original: ModuleSurface) -> ModuleSurface:
    var carrier = ModuleSurface.empty(original.module_name)
    carrier.preferred_registry_name = original.preferred_registry_name
    carrier.imports = original.imports.copy()
    carrier.import_item_offsets = original.import_item_offsets.copy()
    carrier.import_item_names = original.import_item_names.copy()
    carrier.import_item_aliases = original.import_item_aliases.copy()
    carrier.import_item_has_alias = original.import_item_has_alias.copy()
    var index = 0
    while index < carrier.imports.len():
        carrier.import_target_indices = carrier.import_target_indices.push(-1)
        carrier.import_target_names = carrier.import_target_names.push("")
        index = index + 1
    carrier

fn retry_selected_target(lowering: HirLowering, owner_name: text) -> i64:
    val slot = lowering.explicit_dep_memo_lookup(owner_name + " Payload")
    if slot < 0: return -99
    lowering.explicit_dep_target_memo_target_values[slot]

describe("callable dependency retry from an unresolved owner projection", fn():
    it("resolves the admitted package initializer alias without changing frozen indices", fn():
        step("Resolve a negative owner row against the frozen registry")
        val original_owner = retry_named_owner("retry.owner", "retry.provider")
        val registry = retry_registry(original_owner,
            retry_provider("retry.provider.__init__", "Payload"))
        expect(registry.frozen).to_be(true)
        val stale_owner = retry_unresolved_carrier(original_owner)
        val admitted_target = registry.surfaces[1].import_target_indices[0]
        expect(admitted_target).to_equal(0)
        var lowering = hirlowering_for_module("retry.consumer", registry)
        lowering.materialize_imported_callable_explicit_dependency(stale_owner,
            "Payload", Span.empty(), true)
        expect(retry_selected_target(lowering, "retry.owner")).to_equal(0)
        expect(registry.surfaces[1].import_target_indices[0]).to_equal(admitted_target)
        expect(stale_owner.import_target_indices[0]).to_equal(-1)
        expect(lowering.symbols.lookup_qualified_type_raw("retry.provider.__init__", "Payload"))
            .to_be_greater_than(-1)
    )

    it("keeps an absent written owner unresolved even when a sibling has the type", fn():
        step("Reject a same-leaf declaration in an unrelated owner")
        val owner = retry_named_owner("retry.owner", "retry.missing")
        val registry = retry_registry(owner, retry_provider("retry.sibling", "Payload"))
        var lowering = hirlowering_for_module("retry.consumer", registry)
        lowering.materialize_imported_callable_explicit_dependency(retry_unresolved_carrier(owner),
            "Payload", Span.empty(), true)
        expect(retry_selected_target(lowering, "retry.owner")).to_equal(-1)
        expect(lowering.symbols.lookup_qualified_type_raw("retry.sibling", "Payload")).to_equal(-1)
    )

    it("does not replace a resolved wrong-owner route with a sibling declaration", fn():
        step("Preserve an existing target index and reject its absent item")
        val owner = retry_named_owner("retry.owner", "retry.missing")
        val registry = retry_registry(owner, retry_provider("retry.sibling", "Payload"))
        var wrong_owner = retry_unresolved_carrier(owner)
        wrong_owner.import_target_indices = [1]
        var lowering = hirlowering_for_module("retry.consumer", registry)
        lowering.materialize_imported_callable_explicit_dependency(wrong_owner,
            "Payload", Span.empty(), true)
        expect(retry_selected_target(lowering, "retry.owner")).to_equal(-1)
        expect(lowering.symbols.lookup_qualified_type_raw("retry.sibling", "Payload")).to_equal(-1)
    )

    it("does not expose a facade's private import as a transitive export", fn():
        step("Reject private-import traversal after alias recovery")
        val owner = retry_named_owner("retry.owner", "retry.facade")
        val facade = retry_named_owner("retry.facade.__init__", "retry.leaf")
        val leaf = retry_provider("retry.leaf", "Payload")
        val consumer = ModuleSurface.empty("retry.consumer")
        val registry = ModuleSurfacesByName.from_parts([leaf, facade, owner, consumer],
            {"retry.leaf": 0, "retry.facade.__init__": 1, "retry.owner": 2, "retry.consumer": 3},
            ["retry.leaf", "retry.facade.__init__", "retry.owner", "retry.consumer"], [0, 1, 2, 3]).unwrap()
        var lowering = hirlowering_for_module("retry.consumer", registry)
        lowering.materialize_imported_callable_explicit_dependency(retry_unresolved_carrier(owner),
            "Payload", Span.empty(), true)
        expect(retry_selected_target(lowering, "retry.owner")).to_equal(-1)
        expect(lowering.symbols.lookup_qualified_type_raw("retry.leaf", "Payload")).to_equal(-1)
    )

    it("retains explicit-over-glob rank when both targets need alias recovery", fn():
        step("Choose the written named route over a competing glob")
        var owner = retry_named_owner("retry.owner", "retry.named")
        owner.imports = [ParserImport(module: "retry.glob", items: [], is_lazy: false, span: Span.empty()),
            ParserImport(module: "retry.named", items: [ImportItem(name: "Payload", has_alias: false, alias: "")], is_lazy: false, span: Span.empty())]
        owner.import_target_indices = [-1, -1]
        owner.import_target_names = ["", ""]
        owner.import_item_offsets = [0, 0, 1]
        val consumer = ModuleSurface.empty("retry.consumer")
        val registry = ModuleSurfacesByName.from_parts(
            [retry_provider("retry.glob.__init__", "Payload"), retry_provider("retry.named.__init__", "Payload"), owner, consumer],
            {"retry.glob.__init__": 0, "retry.named.__init__": 1, "retry.owner": 2, "retry.consumer": 3},
            ["retry.glob.__init__", "retry.named.__init__", "retry.owner", "retry.consumer"], [0, 1, 2, 3]).unwrap()
        var lowering = hirlowering_for_module("retry.consumer", registry)
        lowering.materialize_imported_callable_explicit_dependency(retry_unresolved_carrier(owner),
            "Payload", Span.empty(), true)
        expect(retry_selected_target(lowering, "retry.owner")).to_equal(1)
    )

    it("keeps two disagreeing explicit owners ambiguous after alias recovery", fn():
        step("Reject competing named declarations rather than pick a sibling")
        var owner = retry_named_owner("retry.owner", "retry.first")
        owner.imports = [ParserImport(module: "retry.first", items: [ImportItem(name: "Payload", has_alias: false, alias: "")], is_lazy: false, span: Span.empty()),
            ParserImport(module: "retry.second", items: [ImportItem(name: "Payload", has_alias: false, alias: "")], is_lazy: false, span: Span.empty())]
        owner.import_target_indices = [-1, -1]
        owner.import_target_names = ["", ""]
        owner.import_item_offsets = [0, 1, 2]
        owner.import_item_names = ["Payload", "Payload"]
        owner.import_item_aliases = ["", ""]
        owner.import_item_has_alias = [false, false]
        val consumer = ModuleSurface.empty("retry.consumer")
        val registry = ModuleSurfacesByName.from_parts(
            [retry_provider("retry.first.__init__", "Payload"), retry_provider("retry.second.__init__", "Payload"), owner, consumer],
            {"retry.first.__init__": 0, "retry.second.__init__": 1, "retry.owner": 2, "retry.consumer": 3},
            ["retry.first.__init__", "retry.second.__init__", "retry.owner", "retry.consumer"], [0, 1, 2, 3]).unwrap()
        var lowering = hirlowering_for_module("retry.consumer", registry)
        lowering.materialize_imported_callable_explicit_dependency(retry_unresolved_carrier(owner),
            "Payload", Span.empty(), true)
        expect(retry_selected_target(lowering, "retry.owner")).to_equal(-2)
        expect(lowering.symbols.lookup_qualified_type_raw("retry.first.__init__", "Payload")).to_equal(-1)
        expect(lowering.symbols.lookup_qualified_type_raw("retry.second.__init__", "Payload")).to_equal(-1)
    )
)
