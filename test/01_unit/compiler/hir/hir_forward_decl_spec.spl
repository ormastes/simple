# Spec for HirForwardDecl (C2 / M4 first slice — data shape only, zero pass
# wiring). Runs under the Rust seed bin/simple — noted per measurement policy.
#
# doc/05_design/language/forwarding/layer_forwarding_and_layer_eq_types.md §4
# doc/03_plan/compiler/forwarding/zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md M4

use std.spec.{describe, it, expect, assert_true}
use compiler.hir.hir_forward_decl.{HirForwardDecl}
use app.desugar.forwarding.{desugar_forwarding}

fn plain_symbol_decl() -> HirForwardDecl:
    HirForwardDecl(
        logical_symbol: "widget.draw",
        receiver_projection: "",
        target_symbol: "draw.rect_draw",
        layer_view_map: 0,
        effect_summary: 0,
        logical_join_point_id: 1)

fn field_path_decl() -> HirForwardDecl:
    HirForwardDecl(
        logical_symbol: "gui_widget.draw",
        receiver_projection: "draw",
        target_symbol: "draw.rect_draw",
        layer_view_map: 3,
        effect_summary: 7,
        logical_join_point_id: 42)

describe "HirForwardDecl (C2 data shape, unwired)":
    it "constructs a plain-symbol forward decl (design doc's simplest phase)":
        val d = plain_symbol_decl()
        expect(d.logical_symbol).to_equal("widget.draw")
        expect(d.receiver_projection).to_equal("")
        expect(d.target_symbol).to_equal("draw.rect_draw")
        expect(d.layer_view_map).to_equal(0)
        expect(d.effect_summary).to_equal(0)
        expect(d.logical_join_point_id).to_equal(1)

    it "constructs a field-path forward decl and reads every field back":
        val d = field_path_decl()
        expect(d.logical_symbol).to_equal("gui_widget.draw")
        expect(d.receiver_projection).to_equal("draw")
        expect(d.target_symbol).to_equal("draw.rect_draw")
        expect(d.layer_view_map).to_equal(3)
        expect(d.effect_summary).to_equal(7)
        expect(d.logical_join_point_id).to_equal(42)

    it "distinguishes join points by id (AOP advice targets this field, M5)":
        val a = plain_symbol_decl()
        val b = field_path_decl()
        assert_true(a.logical_join_point_id != b.logical_join_point_id)

describe "T15 gate: plain-symbol `fn name = target` has no HIR-lowering site (characterization, not a wiring)":
    it "desugar_forwarding still emits a one-hop text wrapper — HirForwardDecl is not consulted":
        # This records the CURRENT behavior of the offline `simple desugar`
        # text pass (src/app/desugar/forwarding.spl), which is NOT part of
        # the live compile pipeline (src/compiler/** never calls
        # app.desugar.mod — see doc/08_tracking/bug/
        # t15_hir_forward_decl_target_pass_does_not_exist_2026-08-07.md).
        # No production .spl file exercises this syntax, so there is no
        # live hop count for HirForwardDecl to shrink. This assertion is a
        # tripwire: if this pass is ever wired into the real pipeline and
        # HirForwardDecl starts being consulted, this wrapper-body shape
        # should disappear and this spec should be revisited.
        val src = "fn target(x: i64) -> i64:\n    x + 1\n\nfn alias_name = target\n"
        val out = desugar_forwarding(src)
        expect(out.contains("# DEPRECATED: fn alias_name = target")).to_equal(true)
        expect(out.contains("fn alias_name(x):")).to_equal(true)
        expect(out.contains("    target(x)")).to_equal(true)
