# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/hir/enum_shortname_collision_two_owners_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/enum_shortname_collision_two_owners_spec.md
# doc-path: doc/03_plan/sys_test/enum_shortname_collision_two_owners_spec.md
# doc-path: doc/04_architecture/enum_shortname_collision_two_owners_spec.md
# doc-path: doc/05_design/enum_shortname_collision_two_owners_spec_oracles.md
# @manual: primary

"""
# Enum Short-Name Collision Across Two Owners — Unit Spec

Regression guard for the Stage-1 HIR fatal

    HIR lowering error in src/compiler/driver/driver.spl:
    enum payload dependency `AdviceForm` conflicts:
    `compiler.frontend.core.aop::AdviceForm::enum`
    vs `compiler.mdsoc.weaving.advice_form::AdviceForm::enum`

Two GENUINELY DISTINCT enums are declared under one short name —
`enum AdviceForm` in `src/compiler/10.frontend/core/aop.spl` and another
`enum AdviceForm` in `src/compiler/85.mdsoc/weaving/advice_form.spl`. Neither
is a duplicate of the other and neither is dead. A module that transitively
reaches both (`src/compiler/80.driver/driver.spl`) must import both.

`materialized_payload_bindings` is keyed on the LOCAL SHORT NAME, so the second
claimant could only ever lose that slot. Losing it used to be a hard
`self.error(...)` plus a bare `return` — so the second enum got no symbol at all
AND the whole module failed to lower. A short-name collision is not a defect; it
only means the unqualified spelling is already taken. The loser is now
re-registered under `{owner_module}::{name}`, which `register_imported_symbol`
also `bind_qualified_type`s, exactly as
`materialize_imported_callable_declared_dependency` already did for signature
dependencies.
"""
use std.spec.step

use std.spec.step

use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.{HirEnum, HirVariantKind}
use compiler.hir.hir_types.{HirTypeKind}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}


fn dual_enum_spec_logger() -> Logger:
    Logger(level: 0)

fn dual_enum_spec_surfaces(modules: Dict<text, Module>, sources: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_modules(modules, sources):
        case Ok(value): value
        case Err(error):
            assert_true(false)
            ModuleSurfacesByName.empty()

describe "two distinct enums sharing one short name":
    # @manual scenario evidence
    """The importer reaches both owners; only one can hold the short name."""
    it "lowers a module that imports both without a conflict error":
        # @req REQ-SSPEC-COMPILER
        step("lowers a module that imports both without a conflict error")
        val log = dual_enum_spec_logger()
        # Two unrelated owners, each declaring its own `AdviceForm`. The
        # variants differ so the two terminal identities genuinely disagree.
        val aop_source = "enum AdviceForm:\n    Before\n    After"
        val weave_source = "enum AdviceForm:\n    Around\n    Wrap"
        val consumer_source =
            "use dual.aop.\{AdviceForm\}\nuse dual.weave.\{AdviceForm\}\n\nfn pick() -> i64:\n    1"
        val aop = parse_full_frontend(aop_source, "dual.aop", "dual.aop", log)
        val weave = parse_full_frontend(weave_source, "dual.weave", "dual.weave", log)
        val consumer = parse_full_frontend(consumer_source, "dual.consumer", "dual.consumer", log)

        var modules: Dict<text, Module> = {}
        modules["dual.aop"] = aop
        modules["dual.weave"] = weave
        val sources = [
            SourceFile(path: "dual/aop.spl", content: aop_source, module_name: "dual.aop"),
            SourceFile(path: "dual/weave.spl", content: weave_source, module_name: "dual.weave")
        ]
        val surfaces = dual_enum_spec_surfaces(modules, sources)
        var lowering = hirlowering_for_module("dual.consumer", surfaces)
        val hir = lowering.lower_module(consumer)
        # Pre-fix: one `enum payload dependency `AdviceForm` conflicts:
        # `dual.aop::AdviceForm::enum` vs `dual.weave::AdviceForm::enum``,
        # attributed to the CONSUMER.
        var conflicts: i64 = 0
        for error in lowering.errors:
            if error.message.contains("conflicts"):
                conflicts = conflicts + 1
        expect(conflicts).to_equal(0)
        expect(lowering.errors.len()).to_equal(0)

    it "keeps both enums reachable, the loser under its qualified name":
        # @req REQ-SSPEC-COMPILER
        step("keeps both enums reachable, the loser under its qualified name")
        val log = dual_enum_spec_logger()
        val aop_source = "enum AdviceForm:\n    Before\n    After"
        val weave_source = "enum AdviceForm:\n    Around\n    Wrap"
        val consumer_source =
            "use dual.aop.\{AdviceForm\}\nuse dual.weave.\{AdviceForm\}\n\nfn pick() -> i64:\n    1"
        val aop = parse_full_frontend(aop_source, "dual.aop", "dual.aop", log)
        val weave = parse_full_frontend(weave_source, "dual.weave", "dual.weave", log)
        val consumer = parse_full_frontend(consumer_source, "dual.consumer", "dual.consumer", log)

        var modules: Dict<text, Module> = {}
        modules["dual.aop"] = aop
        modules["dual.weave"] = weave
        val sources = [
            SourceFile(path: "dual/aop.spl", content: aop_source, module_name: "dual.aop"),
            SourceFile(path: "dual/weave.spl", content: weave_source, module_name: "dual.weave")
        ]
        val surfaces = dual_enum_spec_surfaces(modules, sources)
        var lowering = hirlowering_for_module("dual.consumer", surfaces)
        val hir = lowering.lower_module(consumer)
        # Both owners keep a qualified binding; the short name resolves to
        # whichever claimed it first, and the other stays addressable.
        expect(lowering.symbols.lookup_qualified_type_raw("dual.aop", "AdviceForm") >= 0).to_be_true()
        expect(lowering.symbols.lookup_qualified_type_raw("dual.weave", "AdviceForm") >= 0).to_be_true()

    it "projects an imported enum payload through its declaring owner":
        # @req REQ-SSPEC-COMPILER
        step("projects an imported enum payload through its declaring owner")
        val log = dual_enum_spec_logger()
        val hir_source =
            "struct Effect:\n    kind: i64\nenum HirTypeKind:\n    Function(params: [i64], effects: [Effect])\nexport Effect, HirTypeKind"
        val other_source = "enum Effect:\n    Sync\n    Async\nexport Effect"
        # Import the unrelated Effect first so it owns the consumer's short
        # name. HirTypeKind's payload dependency is therefore reachable only
        # through the declaring owner's qualified type index.
        val consumer_source =
            "use effects.other.\{Effect\}\nuse hir.owner.\{HirTypeKind\}\n\nfn pick() -> i64:\n    1"
        val hir_owner = parse_full_frontend(hir_source, "hir.owner", "hir.owner", log)
        val other = parse_full_frontend(other_source, "effects.other", "effects.other", log)
        val consumer = parse_full_frontend(consumer_source, "payload.consumer", "payload.consumer", log)

        var modules: Dict<text, Module> = {}
        modules["hir.owner"] = hir_owner
        modules["effects.other"] = other
        val surfaces = dual_enum_spec_surfaces(modules, [
            SourceFile(path: "hir/owner.spl", content: hir_source, module_name: "hir.owner"),
            SourceFile(path: "effects/other.spl", content: other_source, module_name: "effects.other")
        ])
        var lowering = hirlowering_for_module("payload.consumer", surfaces)
        val hir = lowering.lower_module(consumer)
        val owner_effect = lowering.symbols.lookup_qualified_type_raw("hir.owner", "Effect")
        val other_effect = lowering.symbols.lookup_qualified_type_raw("effects.other", "Effect")
        var payload_effect = -1
        for enum_ in hir.enums.values():
            # Dict.values() elements are Any-erased on the bootstrap seed.
            val imported_enum: HirEnum = enum_
            if imported_enum.runtime_name == "hir.owner.HirTypeKind":
                for variant in imported_enum.variants:
                    if variant.name == "Function":
                        match variant.kind:
                            case HirVariantKind.Struct(fields):
                                for field in fields:
                                    if field.name == "effects":
                                        match field.type_.kind:
                                            case HirTypeKind.Array(element, _):
                                                match element.kind:
                                                    case HirTypeKind.Named(symbol, _): payload_effect = symbol.id
                                                    case _: ()
                                            case _: ()
                            case _: ()
        expect(lowering.errors.len()).to_equal(0)
        expect(owner_effect >= 0).to_be_true()
        expect(other_effect >= 0).to_be_true()
        expect(payload_effect).to_equal(owner_effect)
        expect(payload_effect == other_effect).to_be_false()
