# Generalization guard for the defect class in
# doc/08_tracking/bug/hir_flat_ast_impl_lowering_lost_self_symbol_id_2026-08-11.md:
# a refactor silently deleting one leg of a save/set/restore triple of
# `current_method_self_symbol_id` from ANY of the three lowering paths that
# enter method bodies. Each path must both SET the id (owner installed) and
# RESTORE a previously saved value; a deletion of either leg turns a
# contain-assertion RED immediately.

use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "method self-context save/restore across all lowering paths":
    it "declaration_lowering saves and restores current_method_self_symbol_id":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl") ?? ""
        expect(source).to_contain("self.current_method_self_symbol_id = symbol.id")
        expect(source).to_contain("self.current_method_self_symbol_id = previous_self_symbol_id")

    it "trait_impl_lowering saves and restores current_method_self_symbol_id":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/trait_impl_lowering.spl") ?? ""
        expect(source).to_contain("self.current_method_self_symbol_id = match type_.kind:")
        expect(source).to_contain("self.current_method_self_symbol_id = previous_self_symbol_id")

    it "module_lowering (flat-AST impl path) saves and restores current_method_self_symbol_id":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""
        expect(source).to_contain("self.current_method_self_symbol_id = impl_owner_symbol.id")
        expect(source).to_contain("self.current_method_self_symbol_id = previous_impl_self_symbol_id")

    it "the field itself still exists and initialises to -1":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/types.spl") ?? ""
        expect(source).to_contain("current_method_self_symbol_id: i64")
        expect(source).to_contain("current_method_self_symbol_id: -1")
