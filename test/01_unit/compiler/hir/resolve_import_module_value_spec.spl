use std.spec
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}

fn _resolved_import_module(source_name: text, import_name: text, provider_name: text) -> text:
    val logger = Logger(level: 0)
    val provider = parse_full_frontend("pub fn answer() -> i64:\n    42", provider_name, provider_name, logger)
    val open = "{"
    val close = "}"
    val consumer_source = "use " + import_name + "." + open + "answer" + close
    val consumer = parse_full_frontend(consumer_source, source_name, source_name, logger)
    var surfaces = ModuleSurfaceBuilder.new()
    val provider_source = SourceFile(path: provider_name + ".spl", content: "pub fn answer() -> i64:\n    42", module_name: provider_name)
    val _ = surfaces.add_parsed(provider, provider_source, 0)
    var lowering = hirlowering_for_module(source_name, surfaces.finish())
    val hir = lowering.lower_module(consumer)

    if val answer_id = hir.symbols.lookup("answer"):
        if val answer = hir.symbols.get_symbol(answer_id):
            return answer.defining_module.unwrap()
    ""

describe "immutable HIR import module resolution":
    it "registers a direct imported function from its provider":
        expect(_resolved_import_module("consumer", "provider", "provider")).to_equal("provider")

    it "registers a relative imported function under its canonical provider":
        expect(_resolved_import_module("pkg.consumer", ".provider", "pkg.provider")).to_equal("pkg.provider")
