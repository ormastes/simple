# HIR confirms a `class X with Trait:` candidate as a trait impl only when the
# name is a trait and X defines every required (body-less) method -- the
# seed's #3981 rule. Anything else keeps the old inherent-impl behaviour.
# doc/08_tracking/bug/trait_receiver_cross_unit_bare_call_stubbed_2026-10-20.md
#
# @cover src/compiler/20.hir/hir_lowering/_Items/trait_impl_lowering.spl
use std.spec.*
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*

fn with_impl_has_trait(source: text) -> text:
    """`has_trait_` of the lowered impl that defines `probe_marker`."""
    val parsed = parse_and_build_module(source, "class_with_trait_conformance.spl")
    var lowering = HirLowering.with_filename("class_with_trait_conformance.spl")
    val hir = lowering.lower_module(parsed)
    for impl_ in hir.impls:
        if impl_.methods.contains_key("probe_marker"):
            return "{impl_.has_trait_}"
    "missing"

val IDENT = "trait Ident:\n    fn identity() -> text\n    fn label() -> text\n    fn greet() -> text: \"hi\"\n\n"

describe "class with Trait conformance in HIR":
    it "makes a class defining every required method a trait impl":
        val src = IDENT + "class Alpha with Ident:\n    tag: text\n    fn identity() -> text: self.tag\n    fn label() -> text: self.tag\n    fn probe_marker() -> i64: 1\n"
        expect(with_impl_has_trait(src)).to_equal("true")

    it "keeps a class missing a required method an inherent impl":
        val src = IDENT + "class Partial with Ident:\n    tag: text\n    fn identity() -> text: self.tag\n    fn probe_marker() -> i64: 1\n"
        expect(with_impl_has_trait(src)).to_equal("false")

    it "keeps a with-name that is not a trait an inherent impl":
        val src = "class Mixed with NotATrait:\n    tag: text\n    fn probe_marker() -> i64: 1\n"
        expect(with_impl_has_trait(src)).to_equal("false")

    it "keeps two with-names an inherent impl":
        val src = IDENT + "trait Other:\n    fn other() -> text\n\nclass Both with Ident, Other:\n    tag: text\n    fn identity() -> text: self.tag\n    fn label() -> text: self.tag\n    fn other() -> text: self.tag\n    fn probe_marker() -> i64: 1\n"
        expect(with_impl_has_trait(src)).to_equal("false")
