# @req REQ-SSPEC-COMPILER
"""
# Builtin-container spellings in the cross-module materialization walk

The walk (src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl)
asks the DECLARING module for a declaration, re-export hop, or explicit import
of every name a signature or enum payload mentions. Container spellings were
deliberately not filtered by hir_dependency_is_builtin_type because user modules
may declare them and must win -- but the unqualified chase then emitted
`[hir-payload-origin-unresolved]` / `[hir-callable-dep-origin-unresolved]` /
`[hir-reexport-chase-unresolved]` advisories for every builtin-container
occurrence (measured: Dict 14,847 / Option 9,857 / Result 7,015 in one stage-1
run; the dominant residual advisory storm of the manual stage3 per-module
object sweep) and, in closures where the name is load-bearing, a
fabricated-position hard `unresolved name/type: Result|Option|Dict` against an
innocent importer (site-19: doc/08_tracking/bug/stage2_matrix_remaining_rows_sdnvalue_cli_imports_2026-10-15.md).

Policy (2026-10-16): a container spelling is resolved-without-owner ONLY when
NO module surface in the current compilation declares it
(hir_compilation_declares_nominal over composite/enum/trait names). That keeps
the user-declaration-wins rule exactly: a declared container is still chased
and materialized; an undeclared Option/Result/Dict/Map/HashMap resolves in
lower_named_kind without any owner, so the miss can never change a lowering
outcome. Spellings lower_named_kind CANNOT resolve without a symbol
(Array/List/Set/Vec) are excluded: an undeclared one is a genuine error and
stays fail-closed, attributed at the real annotation site.

These probes pin the policy in source (the harness idiom of the neighboring
walk specs) and exercise the pure spelling predicate directly.
"""

# @tag: unit, compiler, hir, materialization, builtin

use std.spec
use std.io_runtime.{file_read}
use compiler.hir.hir_lowering._Items.module_reexport_materialization.{hir_dependency_is_builtin_container}
# Importing the chase module forces the seed to compile it: the gate this
# spec pins (hir-reexport-chase-unresolved quieting) must itself parse and
# lower with the new predicate in scope.
use compiler.hir.hir_lowering._Items.module_import_registration.*

describe "builtin container materialization policy":
    it "resolves exactly the no-symbol container spellings":
        expect(hir_dependency_is_builtin_container("Option")).to_equal(true)
        expect(hir_dependency_is_builtin_container("Result")).to_equal(true)
        expect(hir_dependency_is_builtin_container("Dict")).to_equal(true)
        expect(hir_dependency_is_builtin_container("Map")).to_equal(true)
        expect(hir_dependency_is_builtin_container("HashMap")).to_equal(true)
        expect(hir_dependency_is_builtin_container("Array")).to_equal(false)
        expect(hir_dependency_is_builtin_container("List")).to_equal(false)
        expect(hir_dependency_is_builtin_container("Set")).to_equal(false)
        expect(hir_dependency_is_builtin_container("Vec")).to_equal(false)
        expect(hir_dependency_is_builtin_container("BackendKind")).to_equal(false)
        expect(hir_dependency_is_builtin_container("text")).to_equal(false)

    it "pins the spelling set and the declared-wins predicate in the walk":
        val source = file_read("src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl")
        # The set is exactly the no-symbol spellings; Array/List/Set/Vec must
        # NOT appear (fail-closed for genuine errors).
        expect(source).to_contain("dependency == \"Option\" or dependency == \"Result\" or dependency == \"Dict\" or")
        expect(source).to_contain("dependency == \"Map\" or dependency == \"HashMap\"")
        expect(source).to_contain("fn hir_compilation_declares_nominal(surfaces: ModuleSurfacesByName, name: text) -> bool:")
        # The predicate scans declaration-name lists (never values) across all
        # three nominal kinds a user type can take.
        expect(source).to_contain("module_surface_name_position(nominal_scan_surface.composite_names, name) >= 0")
        expect(source).to_contain("module_surface_name_position(nominal_scan_surface.enum_names, name) >= 0")
        expect(source).to_contain("module_surface_name_position(nominal_scan_surface.trait_names, name) >= 0")

    it "quiets both miss handlers only for undeclared container spellings":
        val source = file_read("src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl")
        # Both advisory gates now consult the compilation-wide declaration
        # predicate; a declared spelling and non-builtin names keep the
        # receipt (the eprints stay, behind the guard).
        expect(source).to_contain("hir-payload-origin-unresolved]")
        expect(source).to_contain("hir-callable-dep-origin-unresolved]")
        expect(source).to_contain("not hir_compilation_declares_nominal(self.module_surfaces, dependency):")
        # The docstring on the primitive filter records the new rule and its
        # measured evidence (the sweep's container failure family).
        expect(source).to_contain("en-masse per-module")
        expect(source).to_contain("unresolved name: Result/Option/Dict")

    it "quiets the re-export chase receipt for undeclared container spellings":
        val source = file_read("src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl")
        expect(source).to_contain("use compiler.hir.hir_lowering._Items.module_reexport_materialization.{hir_dependency_is_builtin_container, hir_compilation_declares_nominal}")
        expect(source).to_contain("hir-reexport-chase-unresolved]")
        expect(source).to_contain("not hir_compilation_declares_nominal(self.module_surfaces, imported_name):")
