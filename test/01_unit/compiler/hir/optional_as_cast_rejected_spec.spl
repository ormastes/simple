# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-ERR-01-NIL-ONLY-IN-UNSAFE

use std.spec.step

use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*

"""
# `T? as <numeric>` is rejected outside `unsafe`

Bug `optional_as_cast_yields_zero_2026_11_09`: on the Rust seed, `mk() as u64`
on a function-returned `u64?` silently evaluated to `0` (interpreter: the
`Option.Some` variant ordinal) or to a reinterpreted heap word (JIT), which
masked two months of acpi zero reads. Per nil-only-in-unsafe (ERR-01) an
optional must be narrowed with `?? <default>`, `if val x = ...` or `match`
before it is used as `T`; `T? as T` is a compile error outside `unsafe`.

The self-hosted HIR lowerer diagnoses the same shape as `[E-OPT-CAST-001]`
whenever the operand's HIR type is known to be `Optional(_)` and the cast
target is an integer or float type.
"""

fn lowering_errors(source: text) -> text:
    val ast = parse_full_frontend(source, "optional_cast.spl", "optional_cast.spl", Logger(level: 0))
    var lowering = HirLowering.with_filename("optional_cast.spl")
    val _hir = lowering.lower_module(ast)
    var errors = ""
    var idx = 0
    while idx < lowering.lowering_error_count():
        if not lowering.lowering_error_is_recovered_at(idx):
            errors = errors + lowering.lowering_error_message_at(idx, "optional_cast.spl") + "\n"
        idx = idx + 1
    errors

fn opt_cast_error_count(errors: text) -> i64:
    errors.split("[E-OPT-CAST-001]").len() - 1

describe "optional `as` numeric cast policy":
    it "rejects `T? as <int>` on a local optional outside unsafe and admits the narrowed and unsafe forms":
        val local_opt = "fn f() -> u32:\n    val r: u32? = 45064\n    r as u32\n"
        val float_opt = "fn f() -> f64:\n    val r: f64? = 1.5\n    r as f64\n"
        val narrowed = "fn f() -> u32:\n    val r: u32? = 45064\n    (r ?? 0) as u32\n"
        val in_unsafe = "fn f() -> u32:\n    val r: u32? = 45064\n    unsafe:\n        r as u32\n"
        val plain = "fn f(v: i64) -> u8:\n    v as u8\n"

        step("a locally typed optional cast to an integer is an error")
        assert_equal(opt_cast_error_count(lowering_errors(local_opt)), 1)
        step("a float target is rejected the same way")
        assert_equal(opt_cast_error_count(lowering_errors(float_opt)), 1)
        step("narrowing with ?? first is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(narrowed)), 0)
        step("the cast inside an unsafe block is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(in_unsafe)), 0)
        step("a non-optional numeric cast is untouched")
        assert_equal(opt_cast_error_count(lowering_errors(plain)), 0)

    it "rejects the cast of a function-returned optional (the acpi shape) and restores the depth after unsafe":
        val returned = "fn mk(v: u64) -> u64?:\n    if v != 0:\n        v\n    else:\n        nil\n\n" +
            "fn bad() -> u64:\n    mk(1) as u64\n"
        val after_unsafe = "fn f() -> u32:\n    val r: u32? = 1\n    unsafe:\n        val x = r as u32\n    r as u32\n"

        step("a function-returned T? cast with `as` is an error")
        assert_equal(opt_cast_error_count(lowering_errors(returned)), 1)
        step("the unsafe depth does not leak past the block")
        assert_equal(opt_cast_error_count(lowering_errors(after_unsafe)), 1)

    it "admits the cast of an `if val` binding narrowed from a generic T? and still rejects the un-narrowed one":
        # Bug: if_val_binding_from_generic_optional_stays_optional_err01_2026-11-13
        # (a seed-only defect). This lowerer reads the DECLARED type of a named
        # local, and an `if val` binder has none, so the generic `if val` steps
        # pin the absence of a false positive rather than a payload type; the
        # `typed_*` pair pins the narrowing against the declared optional `r`.
        val pick = "fn pick<T>(v: T, ok: bool) -> T?:\n    if ok:\n        v\n    else:\n        nil\n\n"
        val narrowed = pick + "fn f() -> i64:\n    if val m = pick(41, true):\n        return (m as i64) + 1\n    0\n"
        val elif_narrowed = pick + "fn f(b: bool) -> i64:\n    if b:\n        return 1\n    elif val m = pick(41, true):\n        return m as i64\n    0\n"
        val direct = pick + "fn f() -> i64:\n    pick(41, true) as i64\n"
        val typed_narrowed = "fn f() -> u32:\n    val r: u32? = 7\n    if val m = r:\n        return m as u32\n    0\n"
        val typed_direct = "fn f() -> u32:\n    val r: u32? = 7\n    if val m = r:\n        return m as u32\n    r as u32\n"

        step("`if val` over a generic optional binds the payload")
        assert_equal(opt_cast_error_count(lowering_errors(narrowed)), 0)
        step("`elif val` over a generic optional binds the payload")
        assert_equal(opt_cast_error_count(lowering_errors(elif_narrowed)), 0)
        step("the un-narrowed generic optional cast is still an error")
        assert_equal(opt_cast_error_count(lowering_errors(direct)), 1)
        step("`if val` over a declared optional binds the payload")
        assert_equal(opt_cast_error_count(lowering_errors(typed_narrowed)), 0)
        step("the same optional cast outside the `if val` is still an error")
        assert_equal(opt_cast_error_count(lowering_errors(typed_direct)), 1)

    # Bug: pure_err01_untyped_local_of_optional_call_not_rejected_2026-11-13.
    # A generic `T?` call result is not given a symbol type (its payload is
    # not substituted), so the local's optional-ness comes from the callee's
    # declared `T?` return; the cast is rejected exactly where the annotated
    # `val m: T? = ...` twin is.
    it "rejects the cast of an unannotated `val` initialised from a generic optional call":
        val pick = "fn pick<T>(v: T, ok: bool) -> T?:\n    if ok:\n        v\n    else:\n        nil\n\n"
        val generic_val = pick + "fn f() -> i64:\n    val m = pick(41, true)\n    m as i64\n"
        val annotated = pick + "fn f() -> i64:\n    val m: i64? = pick(41, true)\n    m as i64\n"
        step("the annotated twin is an error")
        assert_equal(opt_cast_error_count(lowering_errors(annotated)), 1)
        step("an unannotated `val` of a generic `T?` call cast with `as` is an error")
        assert_equal(opt_cast_error_count(lowering_errors(generic_val)), 1)

    it "rejects the cast of an unannotated `var` initialised from a generic optional call":
        val pick = "fn pick<T>(v: T, ok: bool) -> T?:\n    if ok:\n        v\n    else:\n        nil\n\n"
        val generic_var = pick + "fn f() -> i64:\n    var m = pick(41, true)\n    m as i64\n"
        step("an unannotated `var` of a generic `T?` call cast with `as` is an error")
        assert_equal(opt_cast_error_count(lowering_errors(generic_var)), 1)

    it "rejects the cast of an unannotated `val` initialised from a non-generic optional call":
        val mk = "fn mk(v: u64) -> u64?:\n    if v != 0:\n        v\n    else:\n        nil\n\n"
        val plain_val = mk + "fn f() -> u64:\n    val m = mk(1)\n    m as u64\n"
        step("an unannotated `val` of a non-generic `T?` call cast with `as` is an error")
        assert_equal(opt_cast_error_count(lowering_errors(plain_val)), 1)

    it "does not leak an optional-call local mark into the next module lowered by the same lowerer":
        # Symbol ids restart at zero per module; a mark from module A must not
        # reject module B's same-id narrowed local.
        val pick = "fn pick<T>(v: T, ok: bool) -> T?:\n    if ok:\n        v\n    else:\n        nil\n\n"
        val first = pick + "fn f() -> i64:\n    val m = pick(41, true)\n    0\n"
        val second = pick + "fn f() -> i64:\n    val m = pick(41, true) ?? 0\n    m as i64\n"
        var lowering = HirLowering.with_filename("optional_cast_a.spl")
        lowering.begin_module("optional_cast_a.spl")
        val _a = lowering.lower_module(parse_full_frontend(first, "optional_cast_a.spl", "optional_cast_a.spl", Logger(level: 0)))
        # begin_module restarts SymbolIds at zero, as the driver does per module.
        lowering.begin_module("optional_cast_b.spl")
        val _b = lowering.lower_module(parse_full_frontend(second, "optional_cast_b.spl", "optional_cast_b.spl", Logger(level: 0)))
        var errors = ""
        var idx = 0
        while idx < lowering.lowering_error_count():
            if not lowering.lowering_error_is_recovered_at(idx):
                errors = errors + lowering.lowering_error_message_at(idx, "optional_cast_b.spl") + "\n"
            idx = idx + 1
        step("the second module's `??`-defaulted local is accepted")
        assert_equal(opt_cast_error_count(errors), 0)

    it "admits narrowed, defaulted, non-optional and unsafe forms of an optional-call local":
        val pick = "fn pick<T>(v: T, ok: bool) -> T?:\n    if ok:\n        v\n    else:\n        nil\n\n"
        val if_val = pick + "fn f() -> i64:\n    if val m = pick(41, true):\n        return m as i64\n    0\n"
        val while_val = pick + "fn f() -> i64:\n    while val m = pick(41, true):\n        return m as i64\n    0\n"
        val coalesced = pick + "fn f() -> i64:\n    val m = pick(41, true) ?? 0\n    m as i64\n"
        val coalesced_later = pick + "fn f() -> i64:\n    val m = pick(41, true)\n    (m ?? 0) as i64\n"
        val non_optional = "fn id(v: i64) -> i64:\n    v\n\nfn f() -> u8:\n    val m = id(3)\n    m as u8\n"
        val in_unsafe = pick + "fn f() -> i64:\n    val m = pick(41, true)\n    unsafe:\n        m as i64\n"
        val shadowed = pick + "fn f() -> i64:\n    val m = pick(41, true)\n    val m = m ?? 0\n    m as i64\n"

        step("an `if val` binding of the call is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(if_val)), 0)
        step("a `while val` binding of the call is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(while_val)), 0)
        step("a `??`-defaulted initialiser is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(coalesced)), 0)
        step("narrowing the local with `??` at the cast is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(coalesced_later)), 0)
        step("a local of a non-optional call is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(non_optional)), 0)
        step("the cast inside an unsafe block is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(in_unsafe)), 0)
        step("a `??`-defaulted shadowing rebind is accepted")
        assert_equal(opt_cast_error_count(lowering_errors(shadowed)), 0)
