"""Enum payload dependencies preserve their declaring owner's type namespace."""
# @req REQ-SSPEC-COMPILER
use std.spec.*
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}

fn check_enum_payload_owner_bindings(alias_name: text):
    val logger = Logger(level: 0)
    val payload_source = "struct Payload:\n    value: i64"
    val first_source = "use payloads.leaf.\{Payload\}\n\nenum First:\n    Item(value: Payload)"
    val second_source = "use payloads.leaf.\{Payload as " + alias_name + "\}\n\nenum Second:\n    Item(value: " + alias_name + ")"
    var modules: Dict<text, Module> = {}
    modules["payloads.leaf"] = parse_full_frontend(payload_source, "payloads.leaf", "payloads.leaf", logger)
    modules["payloads.first"] = parse_full_frontend(first_source, "payloads.first", "payloads.first", logger)
    modules["payloads.second"] = parse_full_frontend(second_source, "payloads.second", "payloads.second", logger)
    val sources = [
        SourceFile(path: "payloads/leaf.spl", content: payload_source, module_name: "payloads.leaf"),
        SourceFile(path: "payloads/first.spl", content: first_source, module_name: "payloads.first"),
        SourceFile(path: "payloads/second.spl", content: second_source, module_name: "payloads.second")
    ]
    val surfaces_result = module_surfaces_from_modules(modules, sources)
    expect(surfaces_result.is_ok()).to_equal(true)
    val surfaces = surfaces_result.unwrap()
    var lowering = hirlowering_for_module("payloads.consumer", surfaces)
    val first_index = surfaces.index_by_name["payloads.first"]
    val second_index = surfaces.index_by_name["payloads.second"]
    val skipped: Dict<text, bool> = {}
    val span = Span.new(0, 0, 1, 1)
    lowering.register_materialized_payload_named_dependency(
        surfaces.surfaces[first_index], "payloads.first", "Payload", skipped, span)
    val terminal_id = lowering.symbols.lookup_qualified_type_raw("payloads.leaf", "Payload")
    expect(terminal_id >= 0).to_equal(true)
    expect(lowering.symbols.lookup_qualified_type_raw("payloads.first", "Payload")).to_equal(terminal_id)
    # The terminal is already expanded; a second owner still needs its alias.
    lowering.register_materialized_payload_named_dependency(
        surfaces.surfaces[second_index], "payloads.second", alias_name, skipped, span)
    expect(lowering.symbols.lookup_qualified_type_raw("payloads.second", alias_name)).to_equal(terminal_id)
    expect(lowering.errors.len()).to_equal(0)

describe "enum payload owner-qualified bindings":
    it "binds one terminal in both declaring owners after expansion":
        step("materialize the same payload through two enum owners")
        check_enum_payload_owner_bindings("Payload")

    it "preserves the second owner's renamed import after expansion":
        step("materialize a renamed payload without exporting it from the enum owner")
        check_enum_payload_owner_bindings("RenamedPayload")
