# @req REQ-HIR-RECEIVER-OWNER
use std.spec.{describe, it, expect, step, fail}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.core.parser.parser_has_errors
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind}
use compiler.hir.hir_definitions.HirFunction

fn receiver_module(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "receiver_owner.spl", "receiver_owner", Logger(level: 0))
    expect(parser_has_errors()).to_be(false)
    var lowering = HirLowering.with_filename("receiver_owner.spl")
    val lowered = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    lowered

fn receiver_function(module: HirModule, name: text) -> HirFunction:
    for function in module.functions.values():
        if function.name == name: return function
    fail("missing actual lowered method " + name)
    nil

fn receiver_is_text(function: HirFunction):
    expect(function.params.len()).to_equal(1)
    match function.params[0].type_.kind:
        case HirTypeKind.Str: ()
        case _: fail("primitive receiver lost text owner")

describe "authoritative unannotated method receiver":
    it "retains primitive text and char impl owners":
        step("Lower original implicit receiver source without annotations")
        val module = receiver_module("impl text:\n    fn text_probe() -> text:\n        self\nimpl char:\n    fn char_probe() -> char:\n        self\n")
        receiver_is_text(receiver_function(module, "text_probe"))
        val function = receiver_function(module, "char_probe")
        expect(function.params.len()).to_equal(1)
        match function.params[0].type_.kind:
            case HirTypeKind.Char: ()
            case _: fail("primitive receiver lost char owner")

    it "preserves the explicit bootstrap bridge without duplicate self":
        step("Use existing annotated receiver grammar")
        val module = receiver_module("impl text:\n    fn explicit_probe(self: text) -> text:\n        self\n")
        receiver_is_text(receiver_function(module, "explicit_probe"))

    it "retains named owner identity":
        step("Compare receiver with actual enclosing impl symbol")
        val module = receiver_module("struct Boxed:\n    value: i64\nimpl Boxed:\n    fn named_probe() -> i64:\n        1\n")
        val function = receiver_function(module, "named_probe")
        expect(module.impls.len()).to_equal(1)
        match module.impls[0].type_.kind:
            case HirTypeKind.Named(owner, _):
                match function.params[0].type_.kind:
                    case HirTypeKind.Named(actual, _): expect(actual).to_equal(owner)
                    case _: fail("receiver lost nominal owner")
            case _: fail("impl lost nominal owner")

    it "does not replace explicit receiver or ordinary parameter types":
        step("Explicit annotations remain authoritative")
        val module = receiver_module("impl text:\n    fn annotated_probe(self: i64, other: bool) -> i64:\n        self\nfn ordinary_probe(self: char) -> char:\n    self\n")
        val function = receiver_function(module, "annotated_probe")
        expect(function.params.len()).to_equal(2)
        match function.params[0].type_.kind:
            case HirTypeKind.Int(bits, signed):
                expect(bits).to_equal(64)
                expect(signed).to_be(true)
            case _: fail("explicit receiver was overwritten")
        match function.params[1].type_.kind:
            case HirTypeKind.Bool: ()
            case _: fail("ordinary parameter was overwritten")
        match receiver_function(module, "ordinary_probe").params[0].type_.kind:
            case HirTypeKind.Char: ()
            case _: fail("ordinary self parameter was overwritten")

    it "does not inject a receiver into a static method":
        step("Keep static method parameter ABI")
        val module = receiver_module("impl text:\n    static fn static_probe(value: i64) -> i64:\n        value\n")
        val function = receiver_function(module, "static_probe")
        expect(function.params.len()).to_equal(1)
        expect(function.params[0].name).to_equal("value")

    it "refuses an unresolved declared receiver instead of erasing it":
        step("Exercise authoritative lower_param with unresolved owner")
        val parsed = parse_full_frontend("fn param_probe(value) -> i64:\n    1\n", "bad_owner.spl", "bad_owner", Logger(level: 0))
        expect(parser_has_errors()).to_be(false)
        val parameter = parsed.functions["param_probe"].params[0]
        var lowering = HirLowering.with_filename("bad_owner.spl")
        val result = lowering.lower_param(parameter, nil, Some(HirType(kind: HirTypeKind.Infer(0, 0), span: parameter.span)))
        expect(lowering.errors.len()).to_be_greater_than(0)
        match result.type_.kind:
            case HirTypeKind.Error: ()
            case _: fail("unresolved receiver accepted")
