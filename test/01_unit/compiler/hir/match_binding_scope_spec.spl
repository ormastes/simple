use std.spec.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}

fn lower_match_source(source: text, name: text) -> HirLowering:
    val logger = Logger(level: 0)
    val module = parse_full_frontend(source, name, name, logger)
    var lowering = HirLowering.with_filename(name)
    lowering.lower_module(module)
    lowering

describe "HIR match payload binding scope":
    it "lowers the scrutinee before scoped payload bindings":
        step("Lower guards and bodies after their pattern")
        val valid = lower_match_source(
            "fn consume(result: Result<i64, text>) -> i64:\n" +
            "    match result:\n" +
            "        case Ok(value) if value > 0:\n" +
            "            value\n" +
            "        case Err(message):\n" +
            "            message.len()\n",
            "match_binding_valid"
        )
        expect(valid.errors.len()).to_equal(0)

        step("Keep a same-named payload binder out of the scrutinee")
        val shadow = lower_match_source(
            "fn consume(value: Result<i64, text>) -> i64:\n" +
            "    match value:\n" +
            "        case Ok(value):\n" +
            "            value\n" +
            "        case Err(message):\n" +
            "            message.len()\n",
            "match_binding_shadow"
        )
        expect(shadow.errors.len()).to_equal(0)

        step("Remove payload bindings after their arm")
        val leaked = lower_match_source(
            "fn consume(result: Result<i64, text>) -> i64:\n" +
            "    match result:\n" +
            "        case Ok(value):\n" +
            "            value\n" +
            "        case Err(message):\n" +
            "            message.len()\n" +
            "    message.len()\n",
            "match_binding_leak"
        )
        var found_unresolved = false
        for diagnostic in leaked.diagnostic_messages:
            if diagnostic.contains("unresolved name: message"):
                found_unresolved = true
        expect(found_unresolved).to_be(true)
