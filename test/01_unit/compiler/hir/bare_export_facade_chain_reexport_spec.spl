"""
## Purpose and audience
Purpose: Pin resolution of a bare `export Name` re-export (no `use`/alias) whose
target is reached only via a glob import of a package sibling, AND a deeper
2-hop NAMED `export use` re-export chain through an unrelated facade
directory (the `MirInstKind` shape: declared in one file, re-exported by a
named `export use` in a package sibling, then re-exported again by a named
`export use` in a parent-package `__init__`-style facade).
Audience: compiler engineers maintaining HIR import/re-export materialization
(src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl).
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec. See
doc/08_tracking/bug/ (stage3 unresolved-name-via-facade class, 2026-08-28)
and the v2/v3 stage3 fix lane reports under the session scratchpad for the
originating sweep evidence (top offender: MirInstKind, 82 occurrences).
# @manual: primary
REQ-COMPILER-HIR-001
doc/01_research/local/REQ-COMPILER-HIR-001.md
doc/03_plan/sys_test/REQ-COMPILER-HIR-001.md
doc/04_architecture/REQ-COMPILER-HIR-001.md
doc/05_design/REQ-COMPILER-HIR-001.md
"""
# @req: REQ-COMPILER-HIR-001

use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}

fn befc_logger() -> Logger:
    Logger(level: 0)

fn befc_module(source: text, name: text, log: Logger) -> Module:
    parse_full_frontend(source, name, name, log)

fn expect_bare_export_through_glob_sibling_resolves():
    # pkg.leaf declares Widget. pkg.mid globs pkg.leaf and bare-exports
    # Widget with no `use`/alias -- the exact shape flagged in
    # module_reexport_materialization.spl's "BARE `export Name`" branch.
    val leaf_source = "pub struct Widget:\n    tag: i64"
    val mid_source = "use bare.pkg.leaf.*\nexport Widget"
    val consumer_source = "use bare.pkg.mid.\{Widget\}\nfn main() -> i64:\n    0"

    val log = befc_logger()
    var modules: Dict<text, Module> = {}
    modules["bare.pkg.leaf"] = befc_module(leaf_source, "bare.pkg.leaf", log)
    modules["bare.pkg.mid"] = befc_module(mid_source, "bare.pkg.mid", log)
    modules["bare.pkg.consumer"] = befc_module(consumer_source, "bare.pkg.consumer", log)

    val sources = [
        SourceFile(path: "bare/pkg/leaf.spl", content: leaf_source, module_name: "bare.pkg.leaf"),
        SourceFile(path: "bare/pkg/mid.spl", content: mid_source, module_name: "bare.pkg.mid"),
        SourceFile(path: "bare/pkg/consumer.spl", content: consumer_source, module_name: "bare.pkg.consumer")
    ]
    val surfaces_result = module_surfaces_from_modules(modules, sources)
    expect(surfaces_result.is_ok()).to_be_truthy()
    val surfaces = surfaces_result.unwrap()

    var lowering = hirlowering_for_module("bare.pkg.consumer", surfaces)
    val hir = lowering.lower_module(modules["bare.pkg.consumer"])

    var unresolved_count = 0
    var error_index = 0
    while error_index < lowering.errors.len():
        if lowering.errors[error_index].message.contains("unresolved"):
            unresolved_count = unresolved_count + 1
        error_index = error_index + 1
    # oracle: 0 -- resolved via package_sibling_registry_names fallback
    # (ae175d5ec54, landed on this tree)
    expect(unresolved_count).to_equal(0)

fn expect_named_export_use_two_hop_chain_resolves():
    # Mirrors the real MirInstKind shape: leaf declares the enum; mid
    # re-exports it with a NAMED `export use leaf.{Name}` (no glob, no bare
    # export); a THIRD, unrelated facade module re-exports it again with a
    # second named `export use mid.{Name}` hop, exactly like
    # src/compiler/50.mir/__init__.spl chaining through mir_instructions.spl
    # to mir_instruction_kinds.spl.
    val leaf_source = "pub enum Kind:\n    A\n    B"
    val mid_source = "export use chain.pkg.leaf.\{Kind\}"
    val facade_source = "export use chain.pkg.mid.\{Kind\}"
    val consumer_source = "use chain.pkg.facade.\{Kind\}\nfn main() -> i64:\n    0"

    val log = befc_logger()
    var modules: Dict<text, Module> = {}
    modules["chain.pkg.leaf"] = befc_module(leaf_source, "chain.pkg.leaf", log)
    modules["chain.pkg.mid"] = befc_module(mid_source, "chain.pkg.mid", log)
    modules["chain.pkg.facade"] = befc_module(facade_source, "chain.pkg.facade", log)
    modules["chain.pkg.consumer"] = befc_module(consumer_source, "chain.pkg.consumer", log)

    val sources = [
        SourceFile(path: "chain/pkg/leaf.spl", content: leaf_source, module_name: "chain.pkg.leaf"),
        SourceFile(path: "chain/pkg/mid.spl", content: mid_source, module_name: "chain.pkg.mid"),
        SourceFile(path: "chain/pkg/facade.spl", content: facade_source, module_name: "chain.pkg.facade"),
        SourceFile(path: "chain/pkg/consumer.spl", content: consumer_source, module_name: "chain.pkg.consumer")
    ]
    val surfaces_result = module_surfaces_from_modules(modules, sources)
    expect(surfaces_result.is_ok()).to_be_truthy()
    val surfaces = surfaces_result.unwrap()

    var lowering = hirlowering_for_module("chain.pkg.consumer", surfaces)
    val hir = lowering.lower_module(modules["chain.pkg.consumer"])

    var unresolved_count = 0
    var error_index = 0
    while error_index < lowering.errors.len():
        if lowering.errors[error_index].message.contains("unresolved"):
            unresolved_count = unresolved_count + 1
        error_index = error_index + 1
    # oracle: 0 -- a 2-hop named export-use chain must resolve without
    # needing the bare-export package-sibling fallback at all
    expect(unresolved_count).to_equal(0)

describe("bare-export and named export-use facade re-export resolution"):
    it("resolves a bare `export Name` reached only through a glob-imported package sibling"):
        # @req: REQ-COMPILER-HIR-001
        expect_bare_export_through_glob_sibling_resolves()
    it("resolves a 2-hop named `export use` re-export chain across facades"):
        expect_named_export_use_two_hop_chain_resolves()
