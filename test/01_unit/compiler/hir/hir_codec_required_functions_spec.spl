# Required function entries must never become a stable, bodyless cache hit.
use std.spec.*
use std.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_definitions.{HirFunction, HirExprKind}
use compiler.hir.hir_codec.{hir_codec_header, hir_canonical_codec_header,
    hir_module_encode, hir_module_encode_canonical, hir_module_decode,
    hir_module_decode_stable, hir_module_decode_bounded, HirDecodeLimits,
    HirDecodeError}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_function}

fn required_function_module() -> HirModule:
    val parsed = parse_full_frontend("fn answer() -> i64:\n    41\n",
        "required_functions.spl", "required_functions", Logger(level: 0))
    var lowering = HirLowering.with_filename("required_functions.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.functions.len()).to_equal(1)
    module

fn required_function_body(module: HirModule):
    val keys = module.functions.keys()
    expect(keys.len()).to_equal(1)
    val function: HirFunction = module.functions[keys[0]]
    expect(function.name).to_equal("answer")
    expect(function.body != nil).to_equal(true)
    expect(function.body.value != nil).to_equal(true)
    match function.body.value.kind:
        case HirExprKind.IntLit(value, _): expect(value).to_equal(41)
        case _: assert(false)

fn required_entry_wire(header: text, key_present: bool, value_present: bool) -> text:
    # Explicit HirModule schema: two names; empty imports/exports/domains;
    # absent optional wire symbol table; ONE function entry; 16 empty tails.
    # The function payload itself comes from the real generated encoder.
    var body = "required\nrequired.spl\n0\n0\n0\n0\n1\n"
    body = body + (if key_present: "1\n0\n" else: "0\n")
    if value_present:
        val module = required_function_module()
        val keys = module.functions.keys()
        var writer = HirCodecWriter.create()
        hc_enc_hir_function(writer, module.functions[keys[0]])
        expect(writer.ok).to_equal(true)
        body = body + "1\n" + writer.finish()
    else:
        body = body + "0\n"
    var tail = 0
    while tail < 16:
        body = body + "0\n"
        tail = tail + 1
    header + "\n" + body

fn required_entry_bounded_refuses(blob: text):
    val decoded = hir_module_decode_bounded(blob, HirDecodeLimits.standard())
    match decoded:
        case Err(error):
            match error:
                case HirDecodeError.Malformed(detail):
                    expect(detail).to_equal("missing_required_hir_module_function_entry")
                case _: assert(false)
        case _: assert(false)

describe "HIR module function entries are required":
    it "roundtrips a real parsed function and preserves its literal body":
        val module = required_function_module()
        val encoded = hir_module_encode(module)
        expect(encoded != "").to_equal(true)
        val decoded = hir_module_decode_stable(encoded)
        expect(decoded != nil).to_equal(true)
        required_function_body(decoded.unwrap())
        expect(hir_module_encode(decoded.unwrap())).to_equal(encoded)

    it "preserves a real function through canonical encoding and bounded decoding":
        val encoded = hir_module_encode_canonical(required_function_module())
        expect(encoded.is_ok()).to_equal(true)
        val decoded = hir_module_decode_bounded(encoded.unwrap(), HirDecodeLimits.standard())
        expect(decoded.is_ok()).to_equal(true)
        required_function_body(decoded.unwrap())
        expect(hir_module_encode_canonical(decoded.unwrap()).unwrap()).to_equal(encoded.unwrap())

    it "accepts the explicit wire fixture when both entry members are present":
        val decoded = hir_module_decode(required_entry_wire(hir_codec_header(), true, true))
        expect(decoded != nil).to_equal(true)
        required_function_body(decoded.unwrap())
        val bounded = hir_module_decode_bounded(
            required_entry_wire(hir_canonical_codec_header(), true, true), HirDecodeLimits.standard())
        expect(bounded.is_ok()).to_equal(true)
        required_function_body(bounded.unwrap())

    it "rejects a present key with absent function instead of making a stable nil entry":
        val blob = required_entry_wire(hir_codec_header(), true, false)
        expect(hir_module_decode(blob)).to_equal(nil)
        expect(hir_module_decode_stable(blob)).to_equal(nil)

    it "rejects an absent key even when the function payload is valid":
        val blob = required_entry_wire(hir_codec_header(), false, true)
        expect(hir_module_decode(blob)).to_equal(nil)
        expect(hir_module_decode_stable(blob)).to_equal(nil)

    it "rejects absent values and keys through the canonical bounded owner":
        required_entry_bounded_refuses(required_entry_wire(hir_canonical_codec_header(), true, false))
        required_entry_bounded_refuses(required_entry_wire(hir_canonical_codec_header(), false, true))

    it "retains legitimate empty function dictionaries":
        var module = required_function_module()
        module.functions = {}
        val encoded = hir_module_encode(module)
        expect(encoded != "").to_equal(true)
        val decoded = hir_module_decode_stable(encoded)
        expect(decoded != nil).to_equal(true)
        expect(decoded.unwrap().functions.len()).to_equal(0)
