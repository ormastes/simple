use std.spec
use test.fixtures.compiler.cross_module_method_default_owner.{XmodDefaultTable}

# Regression: the seed filled omitted default args only for same-module
# methods, so a cross-module call like `symbols.define(...)` read an unset
# argument (native stage-2: every same-module name "unresolved").
describe "cross-module method default arguments":
    it "fills an omitted bool default declared on the class body":
        val t = XmodDefaultTable(count: 0)
        expect(t.bind_flag(1)).to_be(true)
        expect(t.bind_flag(1, false)).to_be(false)

    it "fills an omitted text default declared in an impl block":
        val t = XmodDefaultTable(count: 0)
        expect(t.tag_of(1)).to_be("dflt")
        expect(t.tag_of(1, "given")).to_be("given")
