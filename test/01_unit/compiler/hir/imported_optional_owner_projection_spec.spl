"""Production-API ownership regression for rich-parser Optional nodes (#3025).

This isolates projection after qualified dependency registration. It does not
claim module discovery, re-export materialization, or full CLI qualification.
"""
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.parser_types_expr.*
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.hir.hir_lowering._Items.module_callable_types.*

fn optional_projection_lowerer(collide: bool) -> HirLowering:
    var lowering = hirlowering_for_module("consumer", ModuleSurfacesByName.empty())
    val span = Span.empty()
    val provider = lowering.symbols.define_with_binding(
        "provider::Payload", SymbolKind.Struct, nil, span,
        Visibility.Public, false, Some("provider"), false)
    lowering.symbols.bind_qualified_type("provider", "Payload", provider)
    expect(lowering.symbols.lookup_qualified_type_raw("provider", "Payload")).to_equal(provider.id)
    expect(lowering.symbols.lookup_or_invalid("Payload").is_valid()).to_equal(false)
    if collide:
        val consumer = lowering.symbols.define_with_binding(
            "Payload", SymbolKind.Struct, nil, span,
            Visibility.Public, false, Some("consumer"), true)
        expect(consumer.id == provider.id).to_equal(false)
        expect(lowering.symbols.lookup_or_invalid("Payload").id).to_equal(consumer.id)
    lowering

fn optional_projection_payload() -> Type:
    Type(kind: TypeKind.Named("Payload", []), span: Span.empty())

fn optional_projection_named_id(value: HirType) -> i64:
    match value.kind:
        case HirTypeKind.Named(symbol, arguments):
            if arguments.len() != 0:
                return -1
            symbol.id
        case _: -1

fn optional_projection_payload_id(value: HirType) -> i64:
    match value.kind:
        case HirTypeKind.Optional(inner): optional_projection_named_id(inner)
        case _: -1

describe "imported Optional retains its registered provider payload":
    it "resolves a qualified-only rich Optional in both production projection APIs":
        var lowering = optional_projection_lowerer(false)
        val expected = lowering.symbols.lookup_qualified_type_raw("provider", "Payload")
        val type_ = Type(kind: TypeKind.Optional(optional_projection_payload()), span: Span.empty())
        val direct = lowering.imported_surface_type(type_, "provider")
        val projected = lowering.imported_surface_type_projected(type_, "", "", "provider")
        expect(optional_projection_payload_id(direct)).to_equal(expected)
        expect(optional_projection_payload_id(projected)).to_equal(expected)
        expect(lowering.errors.len()).to_equal(0)

    it "does not capture a consumer type with the same spelling":
        var lowering = optional_projection_lowerer(true)
        val expected = lowering.symbols.lookup_qualified_type_raw("provider", "Payload")
        val type_ = Type(kind: TypeKind.Optional(optional_projection_payload()), span: Span.empty())
        val direct = lowering.imported_surface_type(type_, "provider")
        val projected = lowering.imported_surface_type_projected(type_, "", "", "provider")
        expect(optional_projection_payload_id(direct)).to_equal(expected)
        expect(optional_projection_payload_id(projected)).to_equal(expected)
        expect(lowering.errors.len()).to_equal(0)

    it "preserves the existing Named Option representation under a collision":
        var lowering = optional_projection_lowerer(true)
        val expected = lowering.symbols.lookup_qualified_type_raw("provider", "Payload")
        val type_ = Type(kind: TypeKind.Named("Option", [optional_projection_payload()]), span: Span.empty())
        val actual = lowering.imported_surface_type(type_, "provider")
        expect(optional_projection_payload_id(actual)).to_equal(expected)
        expect(lowering.errors.len()).to_equal(0)

    it "preserves plain Named provider projection under a collision":
        var lowering = optional_projection_lowerer(true)
        val expected = lowering.symbols.lookup_qualified_type_raw("provider", "Payload")
        val actual = lowering.imported_surface_type(optional_projection_payload(), "provider")
        expect(optional_projection_named_id(actual)).to_equal(expected)
        expect(lowering.errors.len()).to_equal(0)

    it "rejects an Error payload instead of treating it as inference":
        var lowering = optional_projection_lowerer(false)
        val inner = Type(kind: TypeKind.Error, span: Span.empty())
        val type_ = Type(kind: TypeKind.Optional(inner), span: Span.empty())
        val actual = lowering.imported_surface_type(type_, "provider")
        val is_error = match actual.kind:
            case HirTypeKind.Error: true
            case _: false
        expect(is_error).to_equal(true)
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].message).to_equal("invalid imported Optional payload type")

    it "retains a legitimate inferred Optional payload without a diagnostic":
        var lowering = optional_projection_lowerer(false)
        val inner = Type(kind: TypeKind.Infer, span: Span.empty())
        val type_ = Type(kind: TypeKind.Optional(inner), span: Span.empty())
        val actual = lowering.imported_surface_type(type_, "provider")
        val is_optional_infer = match actual.kind:
            case HirTypeKind.Optional(payload):
                match payload.kind:
                    case HirTypeKind.Infer(_, _): true
                    case _: false
            case _: false
        expect(is_optional_infer).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)
