# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




# @tag: unit, compiler, hir, native-safe
#
# Pins the MECHANISM behind the 2026-08-21 HIR per-module cost fix
# (doc/08_tracking/bug/hir_phase_per_module_cost_2026-08-21.md): the
# package-sibling field-dependency fallback used to re-scan the ENTIRE frozen
# module-surface registry for every unresolved dependency of every importing
# module. The registry is frozen for the whole HIR phase, so the answer is a
# constant; the memo makes the scan happen once per (declaring module,
# dependency) pair. The observable is the scan counter, not a wall clock, so
# this spec discriminates the algorithm rather than the machine.

use std.spec.step

use std.spec.{describe, it, expect}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering._Items.module_reexport_materialization.*
use compiler.hir.hir_lowering._Items.module_lowering.*
use compiler.hir.hir_lowering.module_surface.{
    ModuleSurface,
    ModuleSurfacesByName
}

fn package_registry() -> ModuleSurfacesByName:
    val a = ModuleSurface.empty("pkg.a")
    val b = ModuleSurface.empty("pkg.b")
    val c = ModuleSurface.empty("pkg.c")
    val built = ModuleSurfacesByName.from_parts(
        [a, b, c],
        {"pkg.a": 0, "pkg.b": 1, "pkg.c": 2},
        ["pkg.a", "pkg.b", "pkg.c"],
        [0, 1, 2])
    built.unwrap()

fn declaration_owner_registry() -> ModuleSurfacesByName:
    var first = ModuleSurface.empty("pkg.first")
    first.callable_names = ["Shared", "FirstOnly"]
    first.composite_names = ["Shared"]
    var second = ModuleSurface.empty("pkg.second")
    second.enum_names = ["Shared"]
    second.type_alias_names = ["SecondOnly"]
    val built = ModuleSurfacesByName.from_parts(
        [first, second],
        {"pkg.first": 0, "pkg.second": 1},
        ["pkg.first", "pkg.second"], [0, 1])
    built.unwrap()

fn bounded_decl_owner_registry(count: i64) -> ModuleSurfacesByName:
    var surfaces: [ModuleSurface] = []
    var names: [text] = []
    var source_indices: [i64] = []
    var index_by_name: {text: i64} = {}
    var index = 0
    while index < count:
        val name = "pkg.owner_{index}"
        var surface = ModuleSurface.empty(name)
        surface.callable_names = ["Shared", "Owner-{index}"]
        surface.composite_names = ["Shared"]
        surfaces = surfaces.push(surface)
        names = names.push(name)
        source_indices = source_indices.push(index)
        index_by_name[name] = index
        index = index + 1
    val built = ModuleSurfacesByName.from_parts(
        surfaces, index_by_name, names, source_indices)
    built.unwrap()

describe("HIR package-dependency scan memo", fn():
    it("scans the frozen registry once per (module, dependency) pair", fn():
        # @req REQ-SSPEC-UNIT
        # @req REQ-SSPEC-UNIT
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        val span = Span.empty()
        lowering.materialize_imported_field_package_dependency(
            0, "Missing", span, false)
        expect(lowering.field_package_dep_scan_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        lowering.materialize_imported_field_package_dependency(
            0, "Missing", span, false)
        lowering.materialize_imported_field_package_dependency(
            0, "Missing", span, false)
        expect(lowering.field_package_dep_scan_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
    )

    it("still scans for a different dependency name", fn():
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        val span = Span.empty()
        lowering.materialize_imported_field_package_dependency(
            0, "One", span, false)
        lowering.materialize_imported_field_package_dependency(
            0, "Two", span, false)
        expect(lowering.field_package_dep_scan_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
    )

    it("memoizes each surface's package name", fn():
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        expect(lowering.cached_surface_package_name("pkg.a")).to_equal("pkg")
        expect(lowering.cached_surface_package_name("pkg.a")).to_equal("pkg")
        expect(lowering.surface_package_name_memo.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
    )

    it("builds the declaration-owner index once, then answers from it", fn():
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        expect(lowering.surface_decl_index_build_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val first = lowering.surface_decl_owner_indices("Missing")
        expect(first.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lowering.surface_decl_index_build_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val second = lowering.surface_decl_owner_indices("Other")
        expect(second.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # The second name resolves from the retained hash chains without
        # rebuilding the registry index.
        expect(lowering.surface_decl_index_build_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
    )

    it("returns declaration owners in registry order without duplicate surfaces", fn():
        step("Place the same name in two declaration kinds on one surface")
        val registry = declaration_owner_registry()
        var lowering = hirlowering_for_module("pkg/consumer.spl", registry)
        expect(lowering.surface_decl_owner_indices("Shared")).to_equal([0, 1])
        expect(lowering.surface_decl_owner_indices("FirstOnly")).to_equal([0])
        expect(lowering.surface_decl_owner_indices("SecondOnly")).to_equal([1])
        expect(lowering.surface_decl_owner_indices("Missing").len()).to_equal(0)
        expect(lowering.surface_decl_index_build_count).to_equal(1)
    )

    it("bounds a 64-surface owner build and repeated lookup workload", fn():
        step("Build one frozen index for a bounded multi-surface workload")
        val registry = bounded_decl_owner_registry(64)
        var lowering = hirlowering_for_module("pkg/consumer.spl", registry)
        var expected: [i64] = []
        var index = 0
        while index < 64:
            expected = expected.push(index)
            index = index + 1
        expect(lowering.surface_decl_owner_indices("Shared")).to_equal(expected)
        expect(lowering.surface_decl_pair_names.len()).to_equal(192)
        index = 0
        while index < 64:
            expect(lowering.surface_decl_owner_indices("Owner-{index}")).to_equal([index])
            index = index + 1
        expect(lowering.surface_decl_index_build_count).to_equal(1)
    )

    it("builds the package-sibling index once and lists direct members", fn():
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        expect(lowering.package_sibling_index_build_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val members = lowering.package_sibling_registry_names("pkg")
        expect(members.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(lowering.package_sibling_canonical_names("pkg").len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(lowering.package_sibling_registry_names("other").len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lowering.package_sibling_index_build_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
    )

    it("resolves registry keys from retained scalar authority", fn():
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        expect(lowering.surface_index_by_name_build_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lowering.surface_index_for_name("pkg.b")).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(lowering.surface_index_for_name("pkg.c")).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(lowering.surface_index_for_name("pkg.absent")).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(lowering.surface_index_by_name_build_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
    )

    it("falls back to retained scalar registry keys after a cache miss", fn():
        val registry = package_registry()
        var lowering = hirlowering_for_module("pkg/a.spl", registry)
        lowering.surface_index_by_name = {}
        lowering.surface_index_by_name_built = true
        expect(lowering.surface_index_for_name("pkg.c")).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(lowering.surface_index_for_name("pkg.absent")).to_equal(-1)  # oracle: -1 — named expected value from the requirement
    )
)
