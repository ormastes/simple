# Requires the real native transient provider. Interpreter extern stubs are
# not acceptance evidence for this ownership contract.
use std.spec
use compiler.hir.hir_lowering.phase_memo_ownership.{HirPhaseMemoRoot, hir_phase_memo_promote_roots}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

describe "phase memo batch native lifetime":
    it "retains every payload type, aliases and growth across scope resets":
        expect(rt_transient_array_scope_begin()).to_equal(true)
        var indices: {text: i64} = {"index": 7}
        val texts: {text: text} = {"text": "retained"}
        val index_lists: {text: [i64]} = {"indices": [7, 11]}
        val text_lists: {text: [text]} = {"texts": ["retained", "shared"]}
        val flags: {text: bool} = {"flag": true}
        val text_values: [text] = ["shared", "retained"]
        val int_values: [i64] = [7, 11]
        expect(rt_transient_array_scope_pause()).to_equal(true)
        val first: [HirPhaseMemoRoot] = [
            HirPhaseMemoRoot.IndexMap(indices), HirPhaseMemoRoot.TextMap(texts),
            HirPhaseMemoRoot.IndexLists(index_lists), HirPhaseMemoRoot.TextLists(text_lists),
            HirPhaseMemoRoot.FlagMap(flags), HirPhaseMemoRoot.Texts(text_values),
            HirPhaseMemoRoot.Ints(int_values), HirPhaseMemoRoot.IndexMap(indices)
        ]
        expect(hir_phase_memo_promote_roots(first)).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(indices["index"]).to_equal(7)
        expect(texts["text"]).to_equal("retained")
        expect(index_lists["indices"]).to_equal([7, 11])
        expect(text_lists["texts"]).to_equal(["retained", "shared"])
        expect(flags["flag"]).to_equal(true)
        expect(text_values[1]).to_equal("retained")
        expect(int_values[1]).to_equal(11)
        expect(rt_transient_array_scope_begin()).to_equal(true)
        indices["next"] = 19
        expect(rt_transient_array_scope_pause()).to_equal(true)
        val second: [HirPhaseMemoRoot] = [HirPhaseMemoRoot.IndexMap(indices)]
        expect(hir_phase_memo_promote_roots(second)).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(indices["index"]).to_equal(7)
        expect(indices["next"]).to_equal(19)

    it "returns provider refusal when no transient scope is active":
        val indices: {text: i64} = {"persistent": 23}
        val roots: [HirPhaseMemoRoot] = [HirPhaseMemoRoot.IndexMap(indices)]
        expect(hir_phase_memo_promote_roots(roots)).to_equal(false)
        expect(indices["persistent"]).to_equal(23)
