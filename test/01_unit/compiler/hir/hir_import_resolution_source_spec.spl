use std.io.{file_read}
use std.spec.{describe, it, expect}

describe "HIR import resolution source":
    it "prefers exact keys before repeated compiler tier paths":
        val source = file_read("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl")
        val exact = source.index_of("if self.modules_by_name.contains_key(name):")
        val package = source.index_of("cands = cands.push(name + \".__init__\")")
        val nested = source.index_of("var nested_tier = \"compiler.\" + name_parts[1] + \".\" + name_parts[1]")

        expect(exact).to_be_greater_than(-1)
        expect(package).to_be_greater_than(exact)
        expect(nested).to_be_greater_than(package)
        expect(source).to_contain("cands = cands.push(nested_tier)")
        expect(source).to_contain("cands = cands.push(nested_tier + \".__init__\")")

    it "lowers imported traits after the complete import surface":
        val source = file_read("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl")
        val resolve_pos = source.index_of("self.resolve_import_symbols(module)") ?? -1
        val drain_pos = source.index_of("for imported_trait_name in self.imported_traits.keys():") ?? -1
        val done_pos = source.index_of("self.registering_import_symbols = false") ?? -1

        expect(resolve_pos).to_be_greater_than(-1)
        expect(drain_pos).to_be_greater_than(resolve_pos)
        expect(done_pos).to_be_greater_than(drain_pos)
