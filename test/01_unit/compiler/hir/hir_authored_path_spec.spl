use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.types.{HirLowering}

fn authored_path_test_logger() -> Logger:
    Logger(level: 0)

describe "HIR authored source identity":
    it "keeps physical and authored paths distinct through lowering":
        val physical_path = "/tmp/simple_cov_42/module.spl"
        val authored_path = "src/product/module.spl"
        val parsed = parse_full_frontend(
            "fn answer() -> i64:\n    42",
            physical_path,
            "product.module",
            authored_path_test_logger()
        )
        var lowering = HirLowering.with_filename(physical_path)
        lowering.begin_module_with_authored_path(physical_path, authored_path)
        val hir = lowering.lower_module(parsed)

        expect(hir.path).to_equal(physical_path)
        expect(hir.authored_path).to_equal(authored_path)

    it "keeps begin_module backward compatible with physical identity":
        var lowering = HirLowering.with_filename("first.spl")
        lowering.begin_module_with_authored_path("wrapped.spl", "authored.spl")
        lowering.begin_module("second.spl")

        expect(lowering.module_filename).to_equal("second.spl")
        expect(lowering.module_authored_path).to_equal("second.spl")
