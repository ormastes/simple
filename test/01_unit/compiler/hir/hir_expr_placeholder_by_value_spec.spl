use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_lowering._Expressions.expression_components.*
use compiler.hir.hir_lowering._Expressions.union_narrow_arms.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.function_lowering.*

fn _unit_placeholder(kind: HirExprKind) -> HirExpr:
    HirExpr(
        kind: kind,
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()),
        span: Span.empty()
    )

describe "HirExpr placeholder and by-value transport (stage2_struct_param_deep_copy_packed_span_2026-11-03)":
    it "keeps a concrete non-nil HirType placeholder on array range index expressions":
        val source = "fn tail(xs: [i64]) -> [i64]:\n    val sub = xs[1..]\n    sub\n"
        val parsed = parse_full_frontend(source, "range_index_placeholder", "range_index_placeholder", Logger(level: 0))
        var hir = HirLowering.with_filename("range_index_placeholder")
        val module_ = hir.lower_module(parsed)
        expect(hir.errors.len()).to_equal(0)
        var found_let = false
        for fn_id in module_.functions.keys():
            val f = module_.functions[fn_id]
            for stmt in f.body.stmts:
                match stmt.kind:
                    case HirStmtKind.Let(_, _, init):
                        match init.kind:
                            case HirExprKind.Index(_, _):
                                found_let = true
                                expect(init.has_type_).to_equal(false)
                                match init.type_.kind:
                                    case HirTypeKind.Unit: pass
                                    case _: assert(false)
                            case _: ()
                    case _: ()
        expect(found_let).to_equal(true)

    it "delegates binding_payload_type through hir_binding_type_or_infer for untyped and typed HirExpr":
        var hir = HirLowering.new()
        val untyped = _unit_placeholder(HirExprKind.IntLit(7, None))
        val inferred = hir.binding_payload_type(untyped, false)
        match inferred.kind:
            case HirTypeKind.Infer(_, _): pass
            case _: assert(false)
        val opt_text = HirType(
            kind: HirTypeKind.Optional(HirType(kind: HirTypeKind.Str, span: Span.empty())),
            span: Span.empty()
        )
        val typed = HirExpr(
            kind: HirExprKind.NilLit,
            has_type_: true,
            type_: opt_text,
            span: Span.empty()
        )
        val projected = hir.binding_payload_type(typed, true)
        match projected.kind:
            case HirTypeKind.Str: pass
            case _: assert(false)

    it "accepts by-value HirExpr in union_narrow_arms and declared_match_subject_type":
        var hir = HirLowering.new()
        val union_ty = HirType(
            kind: HirTypeKind.Union([
                HirType(kind: HirTypeKind.Int(64, true), span: Span.empty()),
                HirType(kind: HirTypeKind.Str, span: Span.empty())
            ]),
            span: Span.empty()
        )
        val sym = hir.symbols.define("u", SymbolKind.Variable, Some(union_ty), Span.empty(), Visibility.Private, false, nil)
        val scrutinee = _unit_placeholder(HirExprKind.Var(sym))
        val members = hir.scrutinee_union_members(scrutinee)
        expect(members.len()).to_equal(2)
        val subject_ty = hir.declared_match_subject_type(scrutinee)
        expect(subject_ty.is_some()).to_equal(true)
        val arms = hir.union_narrow_arms(scrutinee, [], Span.empty())
        expect(arms.len()).to_equal(0)

    it "lowers tuple field positional access and union match through HIR and MIR":
        val source = "fn pair() -> (i64, text):\n    (42, \"ok\")\nfn use_pair() -> i64:\n    val p = pair()\n    val n = p.0\n    val s = p.1\n    if s == \"ok\": n else: 0\n"
        val parsed = parse_full_frontend(source, "tuple_field_by_val", "tuple_field_by_val", Logger(level: 0))
        var hir = HirLowering.with_filename("tuple_field_by_val")
        val module_ = hir.lower_module(parsed)
        expect(hir.errors.len()).to_equal(0)
        var lowering = MirLowering.new(module_.symbols)
        lowering.use_explicit_semantic_policy()
        val mir = lowering.lower_module(module_)
        expect(lowering.errors.len()).to_equal(0)
        expect(mir.functions.len()).to_be_greater_than(0)
