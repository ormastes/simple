# @req: REQ-COMPILER-HIR-001

# @tag: unit, compiler, hir, source-contract

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

val SOURCE = "src/compiler/20.hir/hir_lowering/statements.spl"

use std.spec.step

describe "HIR tuple destructure collection mutability":
    it "keeps statement and element-type collectors mutable":
        # @req: REQ-COMPILER-HIR-001
        step("Verify: keeps statement and element-type collectors mutable")
        val source = file_read(SOURCE)
        expect(source).to_contain("var stmts: [HirStmt] = []")
        expect(source).to_contain("var td_elem_types: [HirType] = []")
        expect(source.contains("val stmts: [HirStmt] = []")).to_equal(false)
        expect(source.contains("val td_elem_types: [HirType] = []")).to_equal(false)
