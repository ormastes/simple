"""
## Purpose and audience
Purpose: Prove that seed-parity bare scalar type names lower without error.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-HIR-001 — stable requirement identity for this spec.

# @cover src/compiler/20.hir/hir_lowering/types.spl 3%
# @tag: unit, compiler, hir, types, seed-parity, usize, capitalized-dialect

# Seed-parity regression for `HirLowering.lower_named_kind`
# (src/compiler/20.hir/hir_lowering/types.spl).
#
# The Rust seed's type resolver
# (src/compiler_rust/compiler/src/hir/lower/type_resolver.rs) accepts
# `usize` / `isize` / `u128` / `i128` / `unit` as bare scalar type names, and
# this compiler's own `HirType.named` (hir_types.spl) maps `usize` and `isize`
# to 64-bit Int kinds. But `lower_named_kind` -- the single strict gate that
# emits `unresolved type: {name}` -- was missing those arms, so every such
# annotation hard-errored and collapsed the declaration to HirTypeKind.Error.
#
# `usize` alone had 779 type-position uses across 132 files at the time this
# spec was written, including the load-bearing src/lib/*/allocator.spl and
# src/lib/*/mimalloc.spl tiers. Neither the seed's `run` nor its `compile`
# path can catch the regression: both resolve unknown type names to ANY under
# `lenient_types`, so a seed-based probe false-greens. Driving HirLowering
# directly and asserting `errors.len() == 0` is what actually gates it.

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.{HirFunction}

fn expect_int_param(fn_: HirFunction, index: i64, bits: i64, signed_: bool):
    match fn_.params[index].type_.kind:
        case Int(actual_bits, actual_signed):
            expect(actual_bits).to_equal(bits)
            expect(actual_signed).to_equal(signed_)
        case _:
            expect(false).to_equal(true)

describe "seed-parity bare scalar type names lower without error":
    it "resolves usize and isize to 64-bit Int kinds":
        step("Verify: resolves usize and isize to 64-bit Int kinds")
        # @req: REQ-COMPILER-HIR-001
        val source = "fn sizes(a: usize, b: isize):\n    ()\n"
        val parsed = parse_full_frontend(source, "sizes.spl", "sizes", Logger(level: 0))
        var lowering = HirLowering.with_filename("sizes.spl")
        val hir = lowering.lower_module(parsed)

        # The gate: before the fix this was 2 ("unresolved type: usize",
        # "unresolved type: isize").
        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("sizes"):
            val fn_ = hir.functions[fn_id]
            # usize follows HirType.named: unsigned 64.
            expect_int_param(fn_, 0, 64, false)
            # isize follows HirType.named: signed 64.
            expect_int_param(fn_, 1, 64, true)
        else:
            expect(false).to_equal(true)

    it "resolves u128 and i128 to a signed 64-bit Int, matching the seed":
        step("Verify: resolves u128 and i128 to a signed 64-bit Int, matching the seed")
        # BUG-U128-64BIT: neither engine has a 128-bit integer. The seed
        # resolves both spellings to a SIGNED I64 on purpose so the JIT's
        # arithmetic shift stays byte-identical to the interpreter's `i64 >>`.
        # Picking an unsigned 64 here would make `>>` emit ushr and silently
        # diverge on high-bit-set limbs.
        val source = "fn wide(a: u128, b: i128):\n    ()\n"
        val parsed = parse_full_frontend(source, "wide.spl", "wide", Logger(level: 0))
        var lowering = HirLowering.with_filename("wide.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("wide"):
            val fn_ = hir.functions[fn_id]
            expect_int_param(fn_, 0, 64, true)
            expect_int_param(fn_, 1, 64, true)
        else:
            expect(false).to_equal(true)

    it "resolves a bare unit return annotation":
        step("Verify: resolves a bare unit return annotation")
        val source = "fn nothing() -> unit:\n    ()\n"
        val parsed = parse_full_frontend(source, "nothing.spl", "nothing", Logger(level: 0))
        var lowering = HirLowering.with_filename("nothing.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("nothing"):
            val fn_ = hir.functions[fn_id]
            match fn_.return_type.kind:
                case Unit:
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "still rejects a type name that is genuinely declared nowhere":
        step("Verify: still rejects a type name that is genuinely declared nowhere")
        # Live control. Without this, the three cases above would pass just as
        # well against a lower_named_kind that had been weakened to accept
        # every unknown name -- which is exactly the failure mode the seed's
        # `lenient_types` mode exhibits (both `seed run` and `seed compile`
        # resolve an undeclared annotation to ANY and exit 0, so neither can
        # be used to gate this).
        #
        # Asserted by error IDENTITY, not by count: the same undeclared
        # annotation is reported once per lowering pass that visits it, so a
        # fixed count is brittle. What must hold is that the unresolved-type
        # diagnostic naming this symbol is still produced.
        val source = "fn bogus(a: ZzzNotARealTypeQqq):\n    ()\n"
        val parsed = parse_full_frontend(source, "bogus.spl", "bogus", Logger(level: 0))
        var lowering = HirLowering.with_filename("bogus.spl")
        val hir = lowering.lower_module(parsed)

        var saw_unresolved = false
        for e in lowering.errors:
            if e.message == "unresolved type: ZzzNotARealTypeQqq":
                saw_unresolved = true
        expect(saw_unresolved).to_equal(true)

    it "does not report an unresolved-type error for any seed-parity name":
        step("Verify: does not report an unresolved-type error for any seed-parity name")
        # The mirror of the control above: prove the accepted names produce no
        # unresolved-type diagnostic at all, by message, so a future change
        # that "recovers" instead of erroring is still caught.
        val source = "fn every(a: usize, b: isize, c: u128, d: i128) -> unit:\n    ()\n"
        val parsed = parse_full_frontend(source, "every.spl", "every", Logger(level: 0))
        var lowering = HirLowering.with_filename("every.spl")
        val hir = lowering.lower_module(parsed)

        for e in lowering.errors:
            expect(e.message.contains("unresolved type")).to_equal(false)
        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "capitalized type dialect lowers via alias arms":
    # A second family in the same gate, and the one that is NOT seed parity.
    # `Int` / `Bool` / `Char` are a capitalized dialect that NEITHER resolver
    # accepts as a bare name, yet `String` from that same dialect already
    # resolves via the `case "text" | "str" | "String"` arm -- and the two
    # spellings occur in a single signature
    # (`fn name_lint_parse_class(trimmed: String, indent: Int, ..)`), so
    # `String` lowered while `Int` hard-errored on the same line.
    # `src/type/simple_lang/` already blesses the dialect as real declarations
    # (`type Bool = bool`, `type I64 = i64`, `type Text = text`).
    #
    # The seed's type_resolver.rs has no arm for any of these, so it returns
    # TypeId::ANY under `lenient_types` and UnknownType under strict mode. The
    # alias makes this compiler STRICTER than the seed (a real i64/bool/char
    # instead of ANY), never looser -- and means no seed-driven probe can gate
    # it: a `.spl` using `Int` compiles and runs clean through the seed either
    # way. Driving HirLowering in-process is the only thing that does.
    #
    # `Float` and `Vec` are deliberately NOT aliased; the last two examples are
    # the live controls that keep them unaliased.

    it "resolves Int to a signed 64-bit Int kind":
        step("Verify: resolves Int to a signed 64-bit Int kind")
        # 524 type-position uses under src/ alone. Before the fix this reported
        # "unresolved type: Int" and collapsed the decl to HirTypeKind.Error.
        # Signed 64 matches the tree's own `type I64 = i64` alias and the i64
        # that a rewrite of these sites would have produced.
        val source = "fn counts(a: Int) -> Int:\n    a\n"
        val parsed = parse_full_frontend(source, "counts.spl", "counts", Logger(level: 0))
        var lowering = HirLowering.with_filename("counts.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("counts"):
            val fn_ = hir.functions[fn_id]
            expect_int_param(fn_, 0, 64, true)
            match fn_.return_type.kind:
                case Int(bits, signed_):
                    expect(bits).to_equal(64)  # oracle: 64 — named expected value from the requirement
                    expect(signed_).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "resolves Bool and Char to the primitive Bool and Char kinds":
        step("Verify: resolves Bool and Char to the primitive Bool and Char kinds")
        # Bool: 208 type-position uses under src/. Char: 3 (the
        # `is_identifier_char(c: Char) -> Bool` helper mirrored across the
        # three lsp handler tiers).
        val source = "fn flags(a: Bool, b: Char):\n    ()\n"
        val parsed = parse_full_frontend(source, "flags.spl", "flags", Logger(level: 0))
        var lowering = HirLowering.with_filename("flags.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("flags"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Bool:
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
            match fn_.params[1].type_.kind:
                case Char:
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "mixes the capitalized dialect with the lowercase one in one signature":
        step("Verify: mixes the capitalized dialect with the lowercase one in one signature")
        # The incoherence that motivated the alias, reproduced directly: before
        # the fix `String` lowered and `Int` errored on the same line.
        val source = "fn mixed(trimmed: String, indent: Int, ok: Bool) -> Bool:\n    ok\n"
        val parsed = parse_full_frontend(source, "mixed.spl", "mixed", Logger(level: 0))
        var lowering = HirLowering.with_filename("mixed.spl")
        val hir = lowering.lower_module(parsed)

        for e in lowering.errors:
            expect(e.message.contains("unresolved type")).to_equal(false)
        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("mixed"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Str:
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
            expect_int_param(fn_, 1, 64, true)
        else:
            expect(false).to_equal(true)

    it "does NOT shadow a user-declared type of the same name":
        step("Verify: does NOT shadow a user-declared type of the same name")
        # THE ordering gate, the same rule the Map/HashMap/Set arms rely on.
        # The alias arms sit AFTER the symbol lookup, not beside the primitive
        # arms at the top of the match, precisely so a declared `Bool` still
        # wins. Such a type really exists in the tree: `struct Bool: value:
        # bool` in src/lib/*/ndarray/mod.spl (all three tiers), returned by
        # `flat_bool(..) -> Bool` and `get_bool_at(..) -> Bool`. A top-level
        # `case "Bool"` arm would silently retype those returns from the boxed
        # struct to a primitive bool. This example fails if the arms are ever
        # hoisted.
        val source = "struct Bool:\n    value: bool\n\nfn flat_bool(linear: i64) -> Bool:\n    Bool(value: true)\n"
        val parsed = parse_full_frontend(source, "nd.spl", "nd", Logger(level: 0))
        var lowering = HirLowering.with_filename("nd.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("flat_bool"):
            val fn_ = hir.functions[fn_id]
            # Must be the declared struct (Named), NOT HirTypeKind.Bool.
            match fn_.return_type.kind:
                case Named(_, _):
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "still rejects Float, which is a declared trait and has no scalar uses":
        step("Verify: still rejects Float, which is a declared trait and has no scalar uses")
        # Live control keeping `Float` OUT of the alias set. `Float` has ZERO
        # genuine type-position uses in owned .spl -- every apparent hit is a
        # comment or Rust source inside a string literal in the ffi_gen code
        # generator -- and it IS declared as a marker `trait Float` in
        # src/lib/*/simd/vector.spl (three tiers). Aliasing it to f64 would be
        # dead code that could only shadow that trait.
        val source = "fn scalar(a: Float):\n    ()\n"
        val parsed = parse_full_frontend(source, "flt.spl", "flt", Logger(level: 0))
        var lowering = HirLowering.with_filename("flt.spl")
        val hir = lowering.lower_module(parsed)

        var saw_unresolved = false
        for e in lowering.errors:
            if e.message == "unresolved type: Float":
                saw_unresolved = true
        expect(saw_unresolved).to_equal(true)

    it "still rejects bare Vec, whose real uses never reach this gate as Vec":
        step("Verify: still rejects bare Vec, whose real uses never reach this gate as Vec")
        # Live control keeping `Vec` OUT of the alias set. Bare `Vec` has ZERO
        # type-position uses in owned .spl; every real use is `Vec<T>`, and the
        # generic-argument path collapses the name before it gets here -- a
        # `Vec<i64>` annotation fails as `unresolved type: Any`, not
        # `unresolved type: Vec`, so a `case "Vec"` arm would never fire for a
        # single real site. (`list<i64>` fails identically, which is a separate
        # pre-existing defect recorded in the bug doc.) `Vec` is also
        # SIMD-shaped in src/lib/*/simd (`Vec<f32,4>`,
        # `Vec<T, const N: usize>`), so `list` would be the wrong meaning there
        # even if the arm could fire.
        val source = "fn v(a: Vec):\n    ()\n"
        val parsed = parse_full_frontend(source, "vec.spl", "vec", Logger(level: 0))
        var lowering = HirLowering.with_filename("vec.spl")
        val hir = lowering.lower_module(parsed)

        var saw_unresolved = false
        for e in lowering.errors:
            if e.message == "unresolved type: Vec":
                saw_unresolved = true
        expect(saw_unresolved).to_equal(true)

describe "generic applications keep the base name the parser preserved":
    # Class C of the bug doc
    # (doc/08_tracking/bug/unresolved_type_declared_nowhere_family_2026-08-01.md).
    #
    # A generic application reaches `lower_named_kind` spelled `Any` whenever
    # its base is absent from the PARSER's per-file named-type registry --
    # `parser_parse_type_impl` returns TYPE_ANY there, and the AST bridge
    # decodes TYPE_ANY as `Named("Any", [])`. So `list<i64>`, `Vec<i64>` and
    # `Map<text,i64>` all die as `unresolved type: Any`, naming a type nobody
    # wrote, while bare `list` resolves. No arm added to `lower_named_kind` --
    # a `Vec -> list` alias included -- can fire for those, because the name is
    # already gone when the gate runs.
    #
    # These examples do NOT assert that defect (that would enshrine it and go
    # red the day it is fixed). They pin the three paths that DO work, which is
    # what a fix must not break:
    #   - the Dict/Result side tables, the only two bases that keep arguments;
    #   - the bare container name;
    #   - the declared-base path, whose hit/miss on `named_type_find` is the
    #     single variable that decides whether a name survives at all.
    #
    # NOTE for whoever fixes Class C: the erasure is in the PARSER, and the
    # pure-Simple core parser is NOT executed when the frontend is driven
    # in-process -- `compiler.core.parser` resolves to an implementation baked
    # into the binary. A parser-layer change is invisible to this spec until a
    # bootstrap rebuild. Only the HIR layer below is read from .spl at runtime.

    it "keeps K and V for the two bases that have argument side tables":
        step("Verify: keeps K and V for the two bases that have argument side tables")
        # Dict<K,V> and Result<T,E> are special-cased in the parser ahead of the
        # erasing branch and carry their arguments through dedicated registries.
        # Every other generic base loses its arguments even when its NAME
        # survives, so these two are the only positive evidence that argument
        # threading works at all -- and the regression gate for it.
        val source = "fn pairs(a: Dict<text, i64>, b: Result<i64, text>):\n    ()\n"
        val parsed = parse_full_frontend(source, "pairs.spl", "pairs", Logger(level: 0))
        var lowering = HirLowering.with_filename("pairs.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("pairs"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Dict(k, v):
                    match k.kind:
                        case Str: expect(true).to_equal(true)
                        case _: expect(false).to_equal(true)
                    match v.kind:
                        case Int(_, _): expect(true).to_equal(true)
                        case _: expect(false).to_equal(true)
                case _:
                    expect(false).to_equal(true)
            match fn_.params[1].type_.kind:
                case Result(o, e):
                    match o.kind:
                        case Int(_, _): expect(true).to_equal(true)
                        case _: expect(false).to_equal(true)
                    match e.kind:
                        case Str: expect(true).to_equal(true)
                        case _: expect(false).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "resolves a bare container name to a dynamic array":
        step("Verify: resolves a bare container name to a dynamic array")
        # The other half of the diagnostic contrast: bare `list` resolves via
        # the `case "list"` arm, so a failure of `list<i64>` is never the arm
        # missing -- it is the name never arriving.
        val source = "fn items(a: list):\n    ()\n"
        val parsed = parse_full_frontend(source, "items.spl", "items", Logger(level: 0))
        var lowering = HirLowering.with_filename("items.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("items"):
            val fn_ = hir.functions[fn_id]
            match fn_.params[0].type_.kind:
                case Array(_, _):
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)

    it "keeps the base name when the base is declared in the same file":
        step("Verify: keeps the base name when the base is declared in the same file")
        # THE discriminating control for Class C. Identical shape to
        # `Baz<i64>`, which fails as `unresolved type: Any`; the only variable
        # is that the base is declared here, so the parser's `named_type_find`
        # hits and returns the real name instead of TYPE_ANY. Whatever fixes
        # Class C must keep this hit path intact -- and this example is what
        # localises the defect to the registry miss rather than to the gate.
        val source = "struct Bar:\n    x: i64\n\nfn holder(a: Bar<i64>):\n    ()\n"
        val parsed = parse_full_frontend(source, "bar.spl", "bar", Logger(level: 0))
        var lowering = HirLowering.with_filename("bar.spl")
        val hir = lowering.lower_module(parsed)

        for e in lowering.errors:
            expect(e.message.contains("unresolved type")).to_equal(false)
        expect(lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        if val fn_id = hir.symbols.lookup("holder"):
            val fn_ = hir.functions[fn_id]
            # The declared struct, NOT an erased Any.
            match fn_.params[0].type_.kind:
                case Named(_, _):
                    expect(true).to_equal(true)
                case _:
                    expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)
