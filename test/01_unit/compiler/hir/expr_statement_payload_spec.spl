use std.spec.*
use expr_statement_payload_fixture.{expr_statement_payload_value_control_v1, expr_statement_payload_variant_control_v1, expr_statement_payload_nil_control_v1}

describe "HIR expression statement payload":
    it "preserves the actual single expression payload and source span":
        expect(expr_statement_payload_value_control_v1()).to_equal("")

    it "rejects other statement variants carrying expressions or no value":
        expect(expr_statement_payload_variant_control_v1()).to_equal("")

    it "rejects absent statement and expression payloads":
        expect(expr_statement_payload_nil_control_v1()).to_equal("")
