"""
Canonical module-surface path parent-component coverage.

Exercises the public path normalizer with shallow and deep parent traversal so
the in-place stack unwind cannot change lexical normalization behavior.
"""

# @cover src/compiler/20.hir/hir_lowering/module_surface_source_identity.spl
# @tag: unit, compiler, hir, performance

use std.spec.*
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_path}

describe "Module surface canonical path parent traversal":
    it "preserves sibling order around parent components":
        val normalized = module_surface_canonical_path(
            "/workspace/pkg/old/../current/./module.spl"
        )
        expect(normalized).to_equal("/workspace/pkg/current/module.spl")

    it "collapses a deep balanced path back to the absolute root":
        var path = ""
        var i = 0
        while i < 256:
            path = path + "/segment" + i.to_text()
            i = i + 1
        i = 0
        while i < 256:
            path = path + "/.."
            i = i + 1

        expect(module_surface_canonical_path(path)).to_equal("/")

    it "does not let absolute parent traversal escape root":
        val normalized = module_surface_canonical_path(
            "/../../workspace/../module.spl"
        )
        expect(normalized).to_equal("/module.spl")
