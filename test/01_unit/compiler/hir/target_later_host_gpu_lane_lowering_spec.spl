# Canonical `target.later(...) gpu \:` / `host \:` HIR lowering regression.
#
# @cover src/compiler/20.hir/hir_lowering/statements.spl 5%

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}

fn make_logger() -> Logger:
    Logger(level: 0)

fn target_later_hir_score(src: text, fname: text) -> i64:
    val log = make_logger()
    val module = parse_full_frontend(src, fname + ".spl", fname + ".spl", log)
    var lowering = HirLowering.with_filename(fname + ".spl")
    val hir = lowering.lower_module(module)
    val fn_id = hir.symbols.lookup(fname)
    expect(fn_id.?).to_equal(true)
    val fn_ = hir.functions[fn_id.unwrap()]
    for stmt in fn_.body.stmts:
        match stmt.kind:
            case HirStmtKind.Expr(expr):
                match expr.kind:
                    case HirExprKind.HostGpuLane(lane_code, payload_size, _, body):
                        var score = lane_code * 1000
                        score = score + payload_size * 10
                        score = score + body.stmts.len()
                        return score
                    case _:
                        pass
            case _:
                pass
    0

describe "TargetLater statement HIR lowering", tag: ["only-compiled"]:
    it "lowers target.later gpu lane statement to HostGpuLane HIR expr":
        val src = "fn f():\n    target.later(max_packet: 512) gpu \\:\n        val draw_ir_batch = \"batch\"\n"
        expect(target_later_hir_score(src, "f")).to_equal(7121)

    it "lowers target.later host lane statement to HostGpuLane HIR expr":
        val src = "fn g():\n    target.later() host \\:\n        val ack = 1\n"
        expect(target_later_hir_score(src, "g")).to_equal(1001)
