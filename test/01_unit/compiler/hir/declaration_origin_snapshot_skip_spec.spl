"""
## Purpose and audience
Purpose: Pin that the SCV-snapshot skip in `bind_declaration_origin_v1` is
distinguishable from a genuine "did not retain its source identity" failure,
so module-build lowering of a snapshot-rooted source (Stage 2 bootstrap-mode
p2_add) does not report the skip as an error.
Audience: compiler engineers maintaining HIR declaration-origin binding
(src/compiler/20.hir/hir_symbol_table_methods.spl,
src/compiler/20.hir/hir_lowering/_Items/module_build.spl).
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
See doc/08_tracking/bug/native_hir_defining_module_empty_local_decls_2026-11-17.md
# @manual: primary
REQ-COMPILER-HIR-001
"""
# @req: REQ-COMPILER-HIR-001

use std.spec.{describe, it, expect}
use compiler.hir.hir_symbol_table_methods.{hir_declaration_origin_snapshot_skipped_v1}

val SNAP = "C:/dev/simple/build/scv/snapshots/scv-revision-v2-abc123/src/compiler/bootstrap_admission/p2_add.spl"
val OWNER = "compiler.bootstrap_admission.p2_add"

describe "declaration origin snapshot skip":
    it "is a skip, not a retention failure, for a snapshot-rooted source with an owner mismatch":
        expect(hir_declaration_origin_snapshot_skipped_v1("", OWNER, SNAP)).to_equal(true)

    it "is not a skip for a real source path":
        expect(hir_declaration_origin_snapshot_skipped_v1("", OWNER, "/project/src/compiler/bootstrap_admission/p2_add.spl")).to_equal(false)

    it "is not a skip when the owner already matches":
        expect(hir_declaration_origin_snapshot_skipped_v1(OWNER, OWNER, SNAP)).to_equal(false)
