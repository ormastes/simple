# Actual owner differential coverage; runtime/native qualification is separate.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.common.attributes.{FunctionAttr}
use compiler.hir.hir_codec.{hir_fn_scalars_in_v1,
    hir_module_function_keys_in_v1, hir_fn_scalars_with_keys_in_v1}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.{mir_provider_callable_key,
    mir_provider_callable_identity}

fn inventory_module(source: text, expected_count: i64) -> HirModule:
    val parsed = parse_full_frontend(source, "prescan_inventory.spl",
        "prescan_inventory", Logger(level: 0))
    var lowering = HirLowering.with_filename("prescan_inventory.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.functions.len()).to_equal(expected_count)
    module

fn inventory_many() -> HirModule:
    var module = inventory_module(
        "fn zeta(value: i64 = 7) -> i64:\n    value\n\n" +
        "fn alpha(flag: bool) -> bool:\n    flag\n\n" +
        "fn middle() -> i64:\n    9\n", 3)
    val keys = module.functions.keys()
    var names: [text] = []
    for raw_key in keys:
        names.push(module.functions[raw_key].name)
    expect(names).to_contain("zeta")
    expect(names).to_contain("alpha")
    expect(names).to_contain("middle")
    var reversed: Dict<SymbolId, HirFunction> = {}
    var position = keys.len() - 1
    while position >= 0:
        reversed[keys[position]] = module.functions[keys[position]]
        position = position - 1
    module.functions = reversed
    module

fn inventory_compare_row(modules: Dict<text, HirModule>, key: text,
        keys: [SymbolId], position: i64):
    val original = hir_fn_scalars_in_v1(modules, key, position)
    val frozen = hir_fn_scalars_with_keys_in_v1(modules, key, keys, position)
    if modules.has(key) and position >= 0 and position < keys.len():
        if modules[key].functions[keys[position]] != nil:
            expect(original[1] != "").to_equal(true)
            expect(original[1]).to_equal(modules[key].functions[keys[position]].name)
            expect(frozen[0].id).to_equal(modules[key].functions[keys[position]].symbol.id)
    # All nine scalar-bridge fields, including complete attribute/type/params
    # payloads rather than only the name or a modeled accessor.
    expect(frozen[0]).to_equal(original[0])
    expect(frozen[1]).to_equal(original[1])
    expect(frozen[2]).to_equal(original[2])
    expect(frozen[3]).to_equal(original[3])
    expect(frozen[4]).to_equal(original[4])
    expect(frozen[5]).to_equal(original[5])
    expect(frozen[6]).to_equal(original[6])
    expect(frozen[7]).to_equal(original[7])
    expect(frozen[8]).to_equal(original[8])

fn inventory_compare_all(module: HirModule):
    var modules: Dict<text, HirModule> = {}
    modules["fixture"] = module
    val keys = hir_module_function_keys_in_v1(modules, "fixture")
    expect(keys.len()).to_equal(module.functions.len())
    var position = 0
    while position < keys.len():
        if position > 0:
            expect(keys[position].id >= keys[position - 1].id).to_equal(true)
        inventory_compare_row(modules, "fixture", keys, position)
        position = position + 1
    inventory_compare_row(modules, "fixture", keys, -1)
    inventory_compare_row(modules, "fixture", keys, keys.len())
    inventory_compare_row(modules, "fixture", keys, keys.len() + 7)

describe "Invocation-local MIR function inventory":
    it "matches every scalar field for zero, one and many real functions":
        inventory_compare_all(inventory_module("", 0))
        val singleton = inventory_module("fn only() -> i64:\n    1\n", 1)
        val singleton_keys = singleton.functions.keys()
        expect(singleton.functions[singleton_keys[0]].name).to_equal("only")
        inventory_compare_all(singleton)
        inventory_compare_all(inventory_many())

    it "preserves nondefault scalar flags and attributes":
        var module = inventory_many()
        val keys = module.functions.keys()
        var position = 0
        while position < keys.len():
            var function: HirFunction = module.functions[keys[position]]
            function.is_extern = position == 0
            function.is_method = position == 1
            function.is_static = position == 2
            function.has_export_attr = position != 0
            var attr = FunctionAttr.default()
            attr.is_global = position == 1
            attr.is_entry = position == 2
            function.func_attr = attr
            module.functions[keys[position]] = function
            position = position + 1
        inventory_compare_all(module)

    it "preserves missing-module and nil-function fallback tuples":
        var modules: Dict<text, HirModule> = {}
        expect(hir_module_function_keys_in_v1(modules, "absent").len()).to_equal(0)
        inventory_compare_row(modules, "absent", [], 0)
        inventory_compare_row(modules, "absent", [SymbolId(id: 77)], 0)
        var module = inventory_many()
        val keys = module.functions.keys()
        module.functions[keys[0]] = nil
        inventory_compare_all(module)

    it "preserves original handles for equal numeric SymbolIds when representable":
        var module = inventory_many()
        val keys = module.functions.keys()
        var collisions: Dict<SymbolId, HirFunction> = {}
        collisions[SymbolId(id: 41)] = module.functions[keys[0]]
        collisions[SymbolId(id: 41)] = module.functions[keys[1]]
        # Value-keyed engines coalesce these rows; identity-keyed native
        # engines retain both handles. Both execute the real differential.
        expect(collisions.len() >= 1 and collisions.len() <= 2).to_equal(true)
        module.functions = collisions
        inventory_compare_all(module)

    it "matches the old provider-registration sequence through the actual prescan":
        val module = inventory_many()
        var modules: Dict<text, HirModule> = {}
        modules["fixture"] = module
        val before = hir_module_function_keys_in_v1(modules, "fixture")
        var original = MirLowering.new(module.symbols)
        var position = 0
        while position < module.functions.len():
            val row = hir_fn_scalars_in_v1(modules, "fixture", position)
            original.prescan_one_function_v1(module.name, module.symbols,
                row[0], row[1], row[2], row[3], row[4], row[5], row[6], row[7], row[8])
            position = position + 1
        var frozen = MirLowering.new(module.symbols)
        frozen.prescan_module_functions_v1(modules, "fixture", module.name, module.symbols)
        expect(original.callable_link_names.len() >= 3).to_equal(true)
        expect(frozen.callable_link_names.len()).to_equal(original.callable_link_names.len())
        expect(frozen.callable_link_names.keys()).to_equal(original.callable_link_names.keys())
        for expected_name in ["zeta", "alpha", "middle"]:
            val expected_key = mir_provider_callable_key(module.name, expected_name)
            expect(original.callable_link_names.has(expected_key)).to_equal(true)
            expect(frozen.callable_link_names.has(expected_key)).to_equal(true)
            expect(frozen.callable_link_names[expected_key]).to_equal(
                mir_provider_callable_identity(module.name, expected_name))
            expect(frozen.callable_text_value_abi[expected_key]).to_equal(true)
        for name in original.callable_link_names.keys():
            expect(frozen.callable_link_names[name]).to_equal(original.callable_link_names[name])
            expect(frozen.callable_text_value_abi[name]).to_equal(original.callable_text_value_abi[name])
        expect(hir_module_function_keys_in_v1(modules, "fixture")).to_equal(before)
        inventory_compare_all(module)
