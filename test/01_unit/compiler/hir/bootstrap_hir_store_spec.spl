use std.spec

use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirSymbol, SymbolId, SymbolKind, ScopeId, Visibility}
use compiler.hir.hir_lowering.items.{
    bootstrap_hir_modules_reset,
    bootstrap_hir_modules_add,
    bootstrap_hir_modules_promote_last,
    bootstrap_hir_modules_rollback_last,
    bootstrap_hir_module_count,
    bootstrap_hir_entry_index,
    bootstrap_hir_module_name_at,
    bootstrap_hir_module_symbol_count,
    bootstrap_hir_module_symbol_at,
    bootstrap_hir_module_function_count,
    bootstrap_hir_module_constant_count
}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

fn bootstrap_store_symbol(id: i64, name: text) -> HirSymbol:
    HirSymbol(
        id: SymbolId(id: id), name: name, kind: SymbolKind.Variable,
        type_: nil, scope: ScopeId(id: 0), span: Span.empty(),
        visibility: Visibility.Private, is_public: false, is_mutable: false,
        defining_module: nil)

describe "bootstrap HIR store publishes complete module rows":
    it "commits distinct nonempty rows and the entry identity together":
        bootstrap_hir_modules_reset()
        val support_symbol = bootstrap_store_symbol(11, "support_value")
        val entry_symbol = bootstrap_store_symbol(29, "entry_value")
        bootstrap_hir_modules_add("support", false, [support_symbol], [], [], [], [], [])
        bootstrap_hir_modules_add("entry", true, [entry_symbol], [], [], [], [], [])

        expect(bootstrap_hir_module_count()).to_equal(2)
        expect(bootstrap_hir_entry_index()).to_equal(1)
        expect(bootstrap_hir_module_name_at(0)).to_equal("support")
        expect(bootstrap_hir_module_name_at(1)).to_equal("entry")
        expect(bootstrap_hir_module_symbol_count(0)).to_equal(1)
        expect(bootstrap_hir_module_symbol_count(1)).to_equal(1)
        expect(bootstrap_hir_module_symbol_at(0, 0).id.id).to_equal(11)
        expect(bootstrap_hir_module_symbol_at(0, 0).name).to_equal("support_value")
        expect(bootstrap_hir_module_symbol_at(1, 0).id.id).to_equal(29)
        expect(bootstrap_hir_module_symbol_at(1, 0).name).to_equal("entry_value")
        expect(bootstrap_hir_module_function_count(1)).to_equal(0)
        expect(bootstrap_hir_module_constant_count(1)).to_equal(0)

    it "reset revokes the prior generation and invalid reads fail closed":
        bootstrap_hir_modules_reset()
        bootstrap_hir_modules_add("old", true, [bootstrap_store_symbol(7, "old_value")], [], [], [], [], [])
        bootstrap_hir_modules_reset()

        expect(bootstrap_hir_module_count()).to_equal(0)
        expect(bootstrap_hir_entry_index()).to_equal(-1)
        expect(bootstrap_hir_module_name_at(-1)).to_equal("")
        expect(bootstrap_hir_module_name_at(0)).to_equal("")
        expect(bootstrap_hir_module_function_count(0)).to_equal(0)

    it "fails closed without a committed row to promote":
        bootstrap_hir_modules_reset()
        expect(bootstrap_hir_modules_promote_last()).to_equal(false)

    it "keeps the committed row readable after its transient scope ends":
        bootstrap_hir_modules_reset()
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add(
            "scoped", true, [bootstrap_store_symbol(31, "scoped_value")],
            [], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(bootstrap_hir_module_name_at(0)).to_equal("scoped")
        expect(bootstrap_hir_module_symbol_at(0, 0).name).to_equal("scoped_value")
        bootstrap_hir_modules_reset()

    it "rolls back exactly the newly appended row":
        bootstrap_hir_modules_reset()
        bootstrap_hir_modules_add(
            "kept", true, [bootstrap_store_symbol(41, "kept_value")],
            [], [], [], [], [])
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add(
            "discarded", false, [bootstrap_store_symbol(42, "discarded_value")],
            [], [], [], [], [])
        expect(bootstrap_hir_modules_rollback_last(1)).to_equal(true)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(bootstrap_hir_module_count()).to_equal(1)
        expect(bootstrap_hir_entry_index()).to_equal(0)
        expect(bootstrap_hir_module_name_at(0)).to_equal("kept")
        expect(bootstrap_hir_modules_rollback_last(1)).to_equal(false)
        bootstrap_hir_modules_reset()
