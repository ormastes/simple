use std.spec

use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirSymbol, SymbolId, SymbolKind, ScopeId, Visibility}
use compiler.hir.hir_definitions.{HirConst, HirEnum, HirStruct, HirClass, HirFunction, HirBlock, HirStmt, HirStmtKind, HirExpr, HirExprKind, HirType, HirTypeKind}
use compiler.common.attributes.{FunctionAttr, vhdl_hardware_metadata_default}
use compiler.hir.hir_lowering._Items.bootstrap_hir_store.{BootstrapHirStore, HirPublishPort, bootstrap_hir_store_with_port, hir_publish_port_runtime}
use compiler.driver.driver_hir_pipeline_support.{driver_publish_flat_hir_row_v1}
use compiler.hir.hir_lowering.items.{
    bootstrap_hir_modules_reset,
    bootstrap_hir_modules_add,
    bootstrap_hir_modules_promote_last_legacy,
    bootstrap_hir_modules_publish_pending,
    bootstrap_hir_modules_has_pending,
    bootstrap_hir_modules_discard_pending,
    bootstrap_hir_store_install,
    bootstrap_hir_store,
    bootstrap_hir_module_function_at,
    bootstrap_hir_modules_rollback_last,
    bootstrap_hir_module_count,
    bootstrap_hir_entry_index,
    bootstrap_hir_module_name_at,
    bootstrap_hir_module_symbol_count,
    bootstrap_hir_module_symbol_at,
    bootstrap_hir_module_function_count,
    bootstrap_hir_module_constant_count
}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool
extern fn rt_enum_discriminant(value: Any) -> i64

fn bootstrap_store_symbol(id: i64, name: text) -> HirSymbol:
    HirSymbol(
        id: SymbolId(id: id), name: name, kind: SymbolKind.Variable,
        type_: nil, scope: ScopeId(id: 0), span: Span.empty(),
        visibility: Visibility.Private, is_public: false, is_mutable: false,
        defining_module: nil)

fn bootstrap_store_function(name: text) -> HirFunction:
    val span = Span.empty()
    val value = HirExpr(kind: HirExprKind.IntLit(7, nil), has_type_: true,
        type_: HirType(kind: HirTypeKind.Int(64, true), span: span), span: span)
    HirFunction(
        symbol: SymbolId(id: 77), name: name, type_params: [], params: [],
        return_type: HirType(kind: HirTypeKind.Int(64, true), span: span),
        body: HirBlock(stmts: [HirStmt(kind: HirStmtKind.Expr(value), span: span)],
            has: true, value: value, span: span),
        effects: [], visibility: Visibility.Private, is_async: false,
        is_static: false, is_public: false, is_method: false,
        is_mutable: false, is_const: false, is_extern: false,
        func_attr: FunctionAttr.default(), has_export_attr: false,
        export_attr: nil, has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_doc_comment: false, doc_comment: "", span: span,
        is_gpu_kernel: false, gpu_target: "", gpu_backend_order: "",
        verification_contract: nil)

describe "bootstrap HIR store publishes complete module rows":
    it "commits distinct nonempty rows and the entry identity together":
        bootstrap_hir_modules_reset()
        val support_symbol = bootstrap_store_symbol(11, "support_value")
        val entry_symbol = bootstrap_store_symbol(29, "entry_value")
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add("support", false, [support_symbol], [], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add("entry", true, [entry_symbol], [], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)

        expect(bootstrap_hir_module_count()).to_equal(2)
        expect(bootstrap_hir_entry_index()).to_equal(1)
        expect(bootstrap_hir_module_name_at(0)).to_equal("support")
        expect(bootstrap_hir_module_name_at(1)).to_equal("entry")
        expect(bootstrap_hir_module_symbol_count(1)).to_equal(1)
        expect(bootstrap_hir_module_symbol_count(0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bootstrap_hir_module_symbol_count(1)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bootstrap_hir_module_symbol_at(0, 0).id.id).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(bootstrap_hir_module_symbol_at(0, 0).name).to_equal("support_value")
        expect(bootstrap_hir_module_symbol_at(1, 0).id.id).to_equal(29)
        expect(bootstrap_hir_module_symbol_at(1, 0).name).to_equal("entry_value")
        expect(bootstrap_hir_module_function_count(1)).to_equal(0)
        expect(bootstrap_hir_module_constant_count(1)).to_equal(0)

    it "reset revokes the prior generation and invalid reads fail closed":
        bootstrap_hir_modules_reset()
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add("old", true, [bootstrap_store_symbol(7, "old_value")], [], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        bootstrap_hir_modules_reset()

        expect(bootstrap_hir_module_count()).to_equal(0)
        expect(bootstrap_hir_entry_index()).to_equal(-1)
        expect(bootstrap_hir_module_name_at(-1)).to_equal("")
        expect(bootstrap_hir_module_name_at(0)).to_equal("")
        expect(bootstrap_hir_module_function_count(0)).to_equal(0)

    it "fails closed without a committed row to promote":
        bootstrap_hir_modules_reset()
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(false)

    it "keeps the committed row readable after its transient scope ends":
        bootstrap_hir_modules_reset()
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add(
            "scoped", true, [bootstrap_store_symbol(31, "scoped_value")],
            [], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(bootstrap_hir_module_name_at(0)).to_equal("scoped")
        expect(bootstrap_hir_module_symbol_at(0, 0).name).to_equal("scoped_value")
        bootstrap_hir_modules_reset()

    it "keeps a published function body readable after scope end":
        bootstrap_hir_modules_reset()
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add("body-owner", true, [],
            [bootstrap_store_function("owned_body")], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(bootstrap_hir_module_function_count(0)).to_equal(1)
        val owned: HirFunction = bootstrap_hir_module_function_at(0, 0)
        expect(owned.name).to_equal("owned_body")
        expect(owned.body.has).to_equal(true)
        expect(owned.body.stmts.len()).to_equal(1)
        expect(rt_enum_discriminant(owned.body.value.kind)).to_equal(
            rt_enum_discriminant(HirExprKind.IntLit(0, nil)))
        bootstrap_hir_modules_reset()

    it "rolls back exactly the newly appended row":
        bootstrap_hir_modules_reset()
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add(
            "kept", true, [bootstrap_store_symbol(41, "kept_value")],
            [], [], [], [], [])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add(
            "discarded", false, [bootstrap_store_symbol(42, "discarded_value")],
            [], [], [], [], [])
        expect(bootstrap_hir_modules_rollback_last(1)).to_equal(true)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(bootstrap_hir_module_count()).to_equal(1)
        expect(bootstrap_hir_entry_index()).to_equal(0)
        expect(bootstrap_hir_module_name_at(0)).to_equal("kept")
        expect(bootstrap_hir_modules_rollback_last(1)).to_equal(false)
        bootstrap_hir_modules_reset()

# Fake session port: the deployed seed predates the rt_session_* externs, so
# the publish ORDER (I1 adopt -> I3 append under session alloc -> commit) is
# observed through an injected port, as global_dataset.spl does for rt_rc_*.
var _fake_session_log: [text] = []
var _fake_scope_running: bool = true
var _fake_adopt_ok: bool = true

fn fake_adopt_row(name: text, symbols: [HirSymbol], functions: [HirFunction], constants: [HirConst], enums: [HirEnum], structs: [HirStruct], classes: [HirClass]) -> bool:
    _fake_session_log = _fake_session_log.push("adopt@{bootstrap_hir_module_count()}")
    _fake_adopt_ok

fn fake_alloc_begin() -> bool:
    _fake_session_log = _fake_session_log.push("alloc_begin@{bootstrap_hir_module_count()}")
    true

fn fake_alloc_end() -> bool:
    _fake_session_log = _fake_session_log.push("alloc_end@{bootstrap_hir_module_count()}")
    true

fn fake_scope_running() -> bool:
    _fake_scope_running

fn install_fake_session_store():
    _fake_session_log = []
    _fake_scope_running = true
    _fake_adopt_ok = true
    var store = bootstrap_hir_store_with_port(HirPublishPort(adopt_row: fake_adopt_row,
        alloc_begin: fake_alloc_begin, alloc_end: fake_alloc_end,
        scope_running: fake_scope_running))
    store.session_on = true
    bootstrap_hir_store_install(store)

fn restore_runtime_store():
    bootstrap_hir_store_install(bootstrap_hir_store_with_port(hir_publish_port_runtime()))

describe "bootstrap HIR store session publish protocol (BSM P2)":
    it "stages a row in a running scope and commits it only after adopt + session append":
        install_fake_session_store()
        bootstrap_hir_modules_add("staged", true, [bootstrap_store_symbol(5, "staged_value")], [], [], [], [], [])
        expect(bootstrap_hir_modules_has_pending()).to_equal(true)
        expect(bootstrap_hir_module_count()).to_equal(0)
        expect(bootstrap_hir_store().aligned(0)).to_equal(true)
        expect(bootstrap_hir_modules_publish_pending()).to_equal(true)
        expect(bootstrap_hir_modules_has_pending()).to_equal(false)
        expect(bootstrap_hir_module_count()).to_equal(1)
        expect(bootstrap_hir_entry_index()).to_equal(0)
        expect(bootstrap_hir_module_symbol_at(0, 0).name).to_equal("staged_value")
        # One typed row adopt (name + 6 payload arrays) before the append, inside
        # the session allocator, committed_count advanced last; no promote.
        expect(_fake_session_log.len()).to_equal(3)
        expect(_fake_session_log[0]).to_equal("adopt@0")

        expect(_fake_session_log[1]).to_equal("alloc_begin@0")
        expect(_fake_session_log[2].starts_with("alloc_end")).to_equal(true)
        expect(_fake_session_log.contains("promote")).to_equal(false)
        restore_runtime_store()

    it "does not publish when adopt is refused, and rollback drops the staged row":
        install_fake_session_store()
        _fake_adopt_ok = false
        bootstrap_hir_modules_add("refused", false, [], [], [], [], [], [])
        expect(bootstrap_hir_modules_publish_pending()).to_equal(false)
        expect(bootstrap_hir_module_count()).to_equal(0)
        expect(_fake_session_log.contains("alloc_begin@0")).to_equal(false)
        bootstrap_hir_modules_discard_pending()
        expect(bootstrap_hir_modules_has_pending()).to_equal(false)
        expect(bootstrap_hir_store().aligned(0)).to_equal(true)
        restore_runtime_store()

    it "appends immediately outside a running scope (cache replay) even with a session":
        install_fake_session_store()
        _fake_scope_running = false
        bootstrap_hir_modules_add("replayed", false, [], [], [], [], [], [])
        expect(bootstrap_hir_modules_has_pending()).to_equal(false)
        expect(bootstrap_hir_module_count()).to_equal(1)
        expect(_fake_session_log.len()).to_equal(0)
        restore_runtime_store()

    it "without a session keeps the legacy append + promote_last_legacy path":
        install_fake_session_store()
        var legacy_store = bootstrap_hir_store()
        legacy_store.session_on = false
        bootstrap_hir_store_install(legacy_store)
        expect(rt_transient_array_scope_begin()).to_equal(true)
        bootstrap_hir_modules_add("legacy", false, [], [], [], [], [], [])
        expect(bootstrap_hir_modules_has_pending()).to_equal(false)
        expect(bootstrap_hir_module_count()).to_equal(1)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(bootstrap_hir_modules_promote_last_legacy()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(_fake_session_log.len()).to_equal(0)
        restore_runtime_store()

    it "publishes an immediately appended row with a session and no running scope":
        install_fake_session_store()
        _fake_scope_running = false
        val before = bootstrap_hir_module_count()
        bootstrap_hir_modules_add("unscoped", false, [], [], [], [], [], [])
        expect(bootstrap_hir_modules_has_pending()).to_equal(false)
        expect(driver_publish_flat_hir_row_v1(true, before)).to_equal(true)
        expect(bootstrap_hir_module_count()).to_equal(before + 1)
        expect(_fake_session_log.len()).to_equal(0)
        restore_runtime_store()
