# Source facts must reject explicit-private leakage even when canonical aliases
# share nominal identities. These regressions use the production frontend/HIR.
use std.spec.*
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.common.driver_core_types.{SourceFile}

fn alias_privacy_errors_v1(source: text) -> [text]:
    val path = "alias_privacy.spl"
    val parsed = parse_and_build_module(source, path)
    val lowering = HirLowering.with_filename(path)
    val lowered = lowering.lower_module(parsed)
    var messages: [text] = []
    for diagnostic in lowering.errors: messages.push(diagnostic.message)
    messages

fn alias_private_error_v1(messages: [text]) -> bool:
    for message in messages:
        if message.contains("public alias") and message.contains("explicitly private declaration"):
            return true
    false

describe "explicit private targets cannot escape through transparent aliases":
    it "diagnoses an unused public alias whose declaration target is explicit pri":
        val messages = alias_privacy_errors_v1("pri struct Target:\n    value: i64\npub type Alias = Target\n")
        expect(alias_private_error_v1(messages)).to_equal(true)

    it "finds a private declaration nested in a generic alias template":
        val messages = alias_privacy_errors_v1("pri struct Target:\n    value: i64\npub type Alias<T> = (T, Target)\n")
        expect(alias_private_error_v1(messages)).to_equal(true)

    it "rejects a private default even when no caller instantiates the alias":
        val messages = alias_privacy_errors_v1("pri struct Target:\n    value: i64\npub type Alias<T = Target> = T\n")
        expect(alias_private_error_v1(messages)).to_equal(true)

    it "rejects a private bound in the alias declaration":
        val messages = alias_privacy_errors_v1("pri trait Hidden:\n    fn hidden(self) -> i64\npub type Alias<T: Hidden> = T\n")
        expect(alias_private_error_v1(messages)).to_equal(true)

    it "checks private intermediate aliases before transparent expansion":
        val messages = alias_privacy_errors_v1("pri type Hidden = i64\npub type Alias = Hidden\n")
        expect(alias_private_error_v1(messages)).to_equal(true)

    it "keeps earlier neutral formals visible to defaults without module capture":
        val messages = alias_privacy_errors_v1("pri struct T:\n    value: i64\npub type Alias<T, U = T> = U\n")
        expect(messages.len()).to_equal(0)

    it "does not mistake caller-private generic arguments for exported targets":
        val messages = alias_privacy_errors_v1("pri struct Target:\n    value: i64\npub type Alias<T> = T\nfn local_use(value: Alias<Target>) -> i64:\n    1\n")
        expect(messages.len()).to_equal(0)

    it "retains a public target without changing private classification elsewhere":
        val messages = alias_privacy_errors_v1("pub struct Target:\n    value: i64\npub type Alias = Target\n")
        expect(messages.len()).to_equal(0)

    it "rejects directly selecting the private target from a different source file":
        step("Build real frozen declaration authority for an owner and requester")
        val owner_path = "privacy/owner.spl"
        val requester_path = "privacy/requester.spl"
        val owner_text = "pri struct Target:\n    value: i64\n"
        val requester_text = "use privacy.owner.\{Target\}\nfn read(value: Target) -> i64:\n    1\n"
        val owner = parse_and_build_module(owner_text, owner_path)
        val requester = parse_and_build_module(requester_text, requester_path)
        val surfaces = module_surfaces_from_modules({"privacy.owner": owner, "privacy.requester": requester},
            [SourceFile(path: owner_path, content: owner_text, module_name: "privacy.owner"),
             SourceFile(path: requester_path, content: requester_text, module_name: "privacy.requester")])
        expect(surfaces.is_ok()).to_equal(true)
        val lowering = HirLowering.with_filename(requester_path)
        lowering.module_surfaces = surfaces.unwrap()
        val lowered = lowering.lower_module(requester)
        var rejected = false
        for diagnostic in lowering.errors:
            if diagnostic.message.contains("cannot import explicitly private declaration"):
                rejected = true
        expect(rejected).to_equal(true)
