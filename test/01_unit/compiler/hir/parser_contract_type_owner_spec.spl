use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirContractClause, HirContractClauseKind,
    HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.hir_verification.{hir_verification_append_clause,
    hir_verification_decreases_type_valid}
use std.spec.{describe, expect, it}

fn verification_span() -> Span:
    Span.empty()

fn verification_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: verification_span())

fn verification_clause(kind: HirContractClauseKind) -> HirContractClause:
    val bool_type = verification_type(HirTypeKind.Bool)
    HirContractClause(
        kind: kind,
        predicate: HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true,
            type_: bool_type, span: verification_span()),
        binding_name: "",
        span: verification_span())

describe "HIR verification contract aggregation":
    it "retains every clause kind in deterministic source order":
        var clauses: [HirContractClause] = []
        clauses = hir_verification_append_clause(clauses,
            verification_clause(HirContractClauseKind.Requires))
        clauses = hir_verification_append_clause(clauses,
            verification_clause(HirContractClauseKind.StatePredicate))
        clauses = hir_verification_append_clause(clauses,
            verification_clause(HirContractClauseKind.EnsuresNormal))
        clauses = hir_verification_append_clause(clauses,
            verification_clause(HirContractClauseKind.EnsuresError))
        clauses = hir_verification_append_clause(clauses,
            verification_clause(HirContractClauseKind.Decreases))

        expect(clauses.len()).to_equal(5)
        expect(clauses[0].kind == HirContractClauseKind.Requires).to_equal(true)
        expect(clauses[1].kind == HirContractClauseKind.StatePredicate).to_equal(true)
        expect(clauses[2].kind == HirContractClauseKind.EnsuresNormal).to_equal(true)
        expect(clauses[3].kind == HirContractClauseKind.EnsuresError).to_equal(true)
        expect(clauses[4].kind == HirContractClauseKind.Decreases).to_equal(true)

    it "admits only exact supported unsigned decreases types":
        expect(hir_verification_decreases_type_valid(
            verification_type(HirTypeKind.Int(8, false)))).to_equal(true)
        expect(hir_verification_decreases_type_valid(
            verification_type(HirTypeKind.Int(128, false)))).to_equal(true)
        expect(hir_verification_decreases_type_valid(
            verification_type(HirTypeKind.Int(32, true)))).to_equal(false)
        expect(hir_verification_decreases_type_valid(
            verification_type(HirTypeKind.Int(7, false)))).to_equal(false)
        expect(hir_verification_decreases_type_valid(
            verification_type(HirTypeKind.Bool))).to_equal(false)
