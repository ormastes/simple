use std.io.{file_read}

val PARSER_TYPES = "src/compiler/10.frontend/parser_types.spl"
val DECL_LOWERING = "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl"

describe "Parser contract type ownership":
    it "keeps every verification-contract field on a concrete parser owner":
        val source = file_read(PARSER_TYPES)
        expect(source).to_contain("struct ContractClause:")
        expect(source).to_contain("struct ContractBlock:")
        expect(source).to_contain("decrease_measure: ContractClause?")
        expect(source).to_contain("contract: ContractBlock")
        expect(source).to_contain("fn contract_block_empty() -> ContractBlock:")

    it "lowers optional decreases only from the typed ContractBlock boundary":
        val source = file_read(DECL_LOWERING)
        expect(source).to_contain(
            "me lower_verification_contract(contract: ContractBlock")
        expect(source).to_contain("if val measure = contract.decrease_measure:")
        expect(source.contains("contract: ANY")).to_equal(false)
