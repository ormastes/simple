use std.spec.*
use std.io_runtime.{read_file_text}

fn file_text(path: text) -> text:
    read_file_text(path)

# Regression guard for the "unresolved type: ByteOrder" Stage-3 self-host
# blocker: doc/08_tracking/bug/t3_full_bootstrap_stage3_unresolved_type_byteorder_cache_validator_2026-08-06.md
#
# `try_register_bootstrap_global_symbol` performs a genuine import
# registration lazily, reached from body lowering (a function-local `use`
# is discarded by the parser, so the name falls through here). Unlike Pass 0
# (`resolve_import_symbols`), it did not set `registering_import_symbols`,
# so `register_imported_type_methods` fully lowered the owner's method
# signatures in the consumer's scope, and any type referenced by those
# signatures but absent from the consumer's `use` list died as
# `unresolved type: X`. The fix saves/sets/restores the flag around the
# lazy registration, mirroring what Pass 0 already does.
describe "HIR lazy import-symbol registration flag regression":
    it "sets registering_import_symbols before the lazy bootstrap-global registration and restores it after":
        val module_lowering = file_text("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl")

        expect(module_lowering).to_contain("try_register_bootstrap_global_symbol")
        expect(module_lowering).to_contain("val saved_registering_import_symbols = self.registering_import_symbols")
        expect(module_lowering).to_contain("self.registering_import_symbols = true")
        expect(module_lowering).to_contain("self.registering_import_symbols = saved_registering_import_symbols")

        val fn_start = module_lowering.index_of("try_register_bootstrap_global_symbol(name: text, span: Span)")
        val save_idx = module_lowering.index_of("val saved_registering_import_symbols = self.registering_import_symbols")
        val register_idx = module_lowering.index_of("self.register_imported_symbol(owner, owner.module_name, name, name, span, true)")
        val restore_idx = module_lowering.index_of("self.registering_import_symbols = saved_registering_import_symbols")

        expect(fn_start).to_be_greater_than(-1)
        expect(save_idx).to_be_greater_than(fn_start)
        expect(register_idx).to_be_greater_than(save_idx)
        expect(restore_idx).to_be_greater_than(register_idx)
