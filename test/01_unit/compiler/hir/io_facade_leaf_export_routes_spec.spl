# Parse the actual production facade; no network call or process exit occurs.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.{ParserModule}

fn io_facade_named_import_owner(module: ParserModule, name: text) -> text:
    for imported in module.imports:
        for item in imported.items:
            if item.name == name:
                return imported.module
    ""

describe "IO facade concrete leaf export routes":
    it "routes all five Phase3 unresolved names to their declaring owners":
        val path = "src/lib/nogc_sync_mut/io.spl"
        val source = file_read(path)
        expect(source.len()).to_be_greater_than(0)
        val parsed = parse_and_build_module(source, path)
        for name in ["http_request", "http_get", "http_post", "url_encode"]:
            expect(io_facade_named_import_owner(parsed, name)).to_equal("std.nogc_sync_mut.io.http_client_core")
        expect(io_facade_named_import_owner(parsed, "exit_i32")).to_equal("std.nogc_sync_mut.io.signal_handlers")
        expect(io_facade_named_import_owner(parsed, "not_an_io_export")).to_equal("")
