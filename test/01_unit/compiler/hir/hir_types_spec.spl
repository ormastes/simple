# # HIR Types Unit Tests
#
# **Feature ID:** #HIR-TYPES-001
# **Category:** HIR | Types
# **Status:** Active
#
# Tests for HIR type system: TypeId, BinOp, UnaryOp, HirExprKind, HirStmtKind.
#
# Every case pairs the positive property with a negative/neighbour case so the
# spec fails if the implementation returns a constant (bug
# non_discriminating_spec_family_2026-08-08; owner decision 2026-11-06 ported
# TypeId and the HIR type model into src/lib/common/hir/types.spl).

use std.common.hir.types.{TypeId, BinOp, UnaryOp, DispatchMode, CaptureMode}
use std.common.hir.types.{LocalVar, CapturedVar, HirExprKind, HirStmtKind}
use std.common.hir.types.{HirPatternKind, HirLiteral, HirExprNode, HirStmtNode}


# ============================================================================
# Test Group 1: TypeId Factory Functions
# ============================================================================

describe "TypeId Factory Functions":
    it "void_ty returns id 0":
        expect(TypeId.void_ty().id).to_equal(0)

    it "bool_ty returns id 1":
        expect(TypeId.bool_ty().id).to_equal(1)

    it "i64_ty returns id 5":
        expect(TypeId.i64_ty().id).to_equal(5)

    it "f64_ty returns id 11":
        expect(TypeId.f64_ty().id).to_equal(11)

    it "string_ty returns id 12":
        expect(TypeId.string_ty().id).to_equal(12)

    it "nil_ty returns id 13":
        expect(TypeId.nil_ty().id).to_equal(13)

    it "all primitive factories yield distinct ids":
        val ids = [TypeId.void_ty().id, TypeId.bool_ty().id, TypeId.i8_ty().id, TypeId.i16_ty().id, TypeId.i32_ty().id, TypeId.i64_ty().id, TypeId.u8_ty().id, TypeId.u16_ty().id, TypeId.u32_ty().id, TypeId.u64_ty().id, TypeId.f32_ty().id, TypeId.f64_ty().id, TypeId.string_ty().id, TypeId.nil_ty().id]
        var i = 0
        while i < ids.len():
            expect(ids[i]).to_equal(i)
            i = i + 1


describe "TypeId Predicates":
    it "is_void returns true for void_ty":
        expect(TypeId.void_ty().is_void()).to_equal(true)
        expect(TypeId.bool_ty().is_void()).to_equal(false)

    it "is_bool returns true for bool_ty":
        expect(TypeId.bool_ty().is_bool()).to_equal(true)
        expect(TypeId.i8_ty().is_bool()).to_equal(false)

    it "is_integer returns true for i64_ty":
        expect(TypeId.i64_ty().is_integer()).to_equal(true)
        expect(TypeId.i8_ty().is_integer()).to_equal(true)
        expect(TypeId.u64_ty().is_integer()).to_equal(true)
        expect(TypeId.bool_ty().is_integer()).to_equal(false)
        expect(TypeId.f32_ty().is_integer()).to_equal(false)

    it "is_signed_integer returns true for i32_ty":
        expect(TypeId.i32_ty().is_signed_integer()).to_equal(true)
        expect(TypeId.u8_ty().is_signed_integer()).to_equal(false)

    it "is_unsigned_integer returns true for u64_ty":
        expect(TypeId.u64_ty().is_unsigned_integer()).to_equal(true)
        expect(TypeId.u8_ty().is_unsigned_integer()).to_equal(true)
        expect(TypeId.i64_ty().is_unsigned_integer()).to_equal(false)
        expect(TypeId.f32_ty().is_unsigned_integer()).to_equal(false)

    it "is_float returns true for f64_ty":
        expect(TypeId.f64_ty().is_float()).to_equal(true)
        expect(TypeId.f32_ty().is_float()).to_equal(true)
        expect(TypeId.u64_ty().is_float()).to_equal(false)
        expect(TypeId.string_ty().is_float()).to_equal(false)

    it "is_numeric returns true for integers":
        expect(TypeId.i64_ty().is_numeric()).to_equal(true)
        expect(TypeId.bool_ty().is_numeric()).to_equal(false)

    it "is_numeric returns true for floats":
        expect(TypeId.f64_ty().is_numeric()).to_equal(true)
        expect(TypeId.string_ty().is_numeric()).to_equal(false)

    it "is_string returns true for string_ty":
        expect(TypeId.string_ty().is_string()).to_equal(true)
        expect(TypeId.nil_ty().is_string()).to_equal(false)

    it "is_nil returns true for nil_ty":
        expect(TypeId.nil_ty().is_nil()).to_equal(true)
        expect(TypeId.void_ty().is_nil()).to_equal(false)

    it "is_primitive returns true for all primitives":
        expect(TypeId.void_ty().is_primitive()).to_equal(true)
        expect(TypeId.bool_ty().is_primitive()).to_equal(true)
        expect(TypeId.i64_ty().is_primitive()).to_equal(true)
        expect(TypeId.string_ty().is_primitive()).to_equal(true)
        expect(TypeId.nil_ty().is_primitive()).to_equal(true)
        expect(TypeId(id: 14).is_primitive()).to_equal(false)


describe "TypeId Names":
    it "name returns correct string for primitives":
        expect(TypeId.void_ty().name()).to_equal("void")
        expect(TypeId.bool_ty().name()).to_equal("bool")
        expect(TypeId.i64_ty().name()).to_equal("i64")
        expect(TypeId.u32_ty().name()).to_equal("u32")
        expect(TypeId.f64_ty().name()).to_equal("f64")
        expect(TypeId.string_ty().name()).to_equal("text")
        expect(TypeId.nil_ty().name()).to_equal("nil")

    it "name falls back to type_<id> for user types":
        expect(TypeId(id: 42).name()).to_equal("type_42")


# ============================================================================
# Test Group 2: Binary Operators
# ============================================================================

describe "BinOp Arithmetic":
    it "Add is arithmetic":
        expect(BinOp.Add.is_arithmetic()).to_equal(true)

    it "Sub is arithmetic":
        expect(BinOp.Sub.is_arithmetic()).to_equal(true)

    it "Mul is arithmetic":
        expect(BinOp.Mul.is_arithmetic()).to_equal(true)

    it "Div is arithmetic":
        expect(BinOp.Div.is_arithmetic()).to_equal(true)

    it "Mod is arithmetic":
        expect(BinOp.Mod.is_arithmetic()).to_equal(true)

    it "Pow is arithmetic":
        expect(BinOp.Pow.is_arithmetic()).to_equal(true)

    it "non-arithmetic operators are rejected":
        expect(BinOp.Eq.is_arithmetic()).to_equal(false)
        expect(BinOp.And.is_arithmetic()).to_equal(false)
        expect(BinOp.BitAnd.is_arithmetic()).to_equal(false)


describe "BinOp Comparison":
    it "Eq is comparison":
        expect(BinOp.Eq.is_comparison()).to_equal(true)

    it "NotEq is comparison":
        expect(BinOp.NotEq.is_comparison()).to_equal(true)

    it "Lt is comparison":
        expect(BinOp.Lt.is_comparison()).to_equal(true)

    it "Gt is comparison":
        expect(BinOp.Gt.is_comparison()).to_equal(true)

    it "non-comparison operators are rejected":
        expect(BinOp.Add.is_comparison()).to_equal(false)
        expect(BinOp.Or.is_comparison()).to_equal(false)

    it "comparison operators return bool":
        expect(BinOp.Eq.returns_bool()).to_equal(true)
        expect(BinOp.Lt.returns_bool()).to_equal(true)
        expect(BinOp.Add.returns_bool()).to_equal(false)
        expect(BinOp.BitOr.returns_bool()).to_equal(false)


describe "BinOp Logical":
    it "And is logical":
        expect(BinOp.And.is_logical()).to_equal(true)

    it "Or is logical":
        expect(BinOp.Or.is_logical()).to_equal(true)

    it "bitwise and is not logical":
        expect(BinOp.BitAnd.is_logical()).to_equal(false)

    it "logical operators return bool":
        expect(BinOp.And.returns_bool()).to_equal(true)
        expect(BinOp.Or.returns_bool()).to_equal(true)


describe "BinOp Bitwise":
    it "BitAnd is bitwise":
        expect(BinOp.BitAnd.is_bitwise()).to_equal(true)

    it "BitOr is bitwise":
        expect(BinOp.BitOr.is_bitwise()).to_equal(true)

    it "ShiftLeft is bitwise":
        expect(BinOp.ShiftLeft.is_bitwise()).to_equal(true)

    it "non-bitwise operators are rejected":
        expect(BinOp.And.is_bitwise()).to_equal(false)
        expect(BinOp.Mul.is_bitwise()).to_equal(false)


describe "BinOp to_string":
    it "Add to_string is +":
        expect(BinOp.Add.to_string()).to_equal("+")

    it "Eq to_string is ==":
        expect(BinOp.Eq.to_string()).to_equal("==")

    it "And to_string is and":
        expect(BinOp.And.to_string()).to_equal("and")

    it "distinct operators render distinctly":
        expect(BinOp.Sub.to_string()).to_equal("-")
        expect(BinOp.NotEq.to_string()).to_equal("!=")
        expect(BinOp.ShiftLeft.to_string()).to_equal("<<")
        expect(BinOp.FloorDiv.to_string()).to_equal("//")


# ============================================================================
# Test Group 3: Unary Operators
# ============================================================================

describe "UnaryOp":
    it "Neg is negation":
        expect(UnaryOp.Neg.is_neg()).to_equal(true)
        expect(UnaryOp.Not.is_neg()).to_equal(false)

    it "Not is logical not":
        expect(UnaryOp.Not.is_not()).to_equal(true)
        expect(UnaryOp.BitNot.is_not()).to_equal(false)

    it "Neg to_string is -":
        expect(UnaryOp.Neg.to_string()).to_equal("-")

    it "Not to_string is not":
        expect(UnaryOp.Not.to_string()).to_equal("not")

    it "BitNot to_string is ~":
        expect(UnaryOp.BitNot.to_string()).to_equal("~")


# ============================================================================
# Test Group 4: Dispatch and Capture Modes
# ============================================================================

describe "DispatchMode":
    it "Static is_static returns true":
        expect(DispatchMode.Static.is_static()).to_equal(true)
        expect(DispatchMode.Static.is_dynamic()).to_equal(false)

    it "Dynamic is_dynamic returns true":
        expect(DispatchMode.Dynamic.is_dynamic()).to_equal(true)
        expect(DispatchMode.Dynamic.is_static()).to_equal(false)

    it "Static to_string is static":
        expect(DispatchMode.Static.to_string()).to_equal("static")
        expect(DispatchMode.Dynamic.to_string()).to_equal("dynamic")


describe "CaptureMode":
    it "ByValue is_by_value returns true":
        expect(CaptureMode.ByValue.is_by_value()).to_equal(true)
        expect(CaptureMode.ByValue.is_reference()).to_equal(false)

    it "ByRef is_reference returns true":
        expect(CaptureMode.ByRef.is_reference()).to_equal(true)
        expect(CaptureMode.ByRef.is_mutable()).to_equal(false)

    it "ByMutRef is_mutable returns true":
        expect(CaptureMode.ByMutRef.is_mutable()).to_equal(true)
        expect(CaptureMode.ByMutRef.is_reference()).to_equal(true)
        expect(CaptureMode.ByMutRef.to_string()).to_equal("by_mut_ref")


# ============================================================================
# Test Group 5: LocalVar and CapturedVar
# ============================================================================

describe "LocalVar":
    it "creates immutable local":
        val local = LocalVar.immutable("x", TypeId.i64_ty(), 0)
        expect(local.name).to_equal("x")
        expect(local.is_mutable).to_equal(false)
        expect(local.index).to_equal(0)
        expect(local.ty.id).to_equal(5)

    it "creates mutable local":
        val local = LocalVar.mutable_var("y", TypeId.f64_ty(), 1)
        expect(local.name).to_equal("y")
        expect(local.is_mutable).to_equal(true)
        expect(local.index).to_equal(1)
        expect(local.ty.is_float()).to_equal(true)


describe "CapturedVar":
    it "creates by_value capture":
        val cap = CapturedVar.by_value(0)
        expect(cap.local_index).to_equal(0)
        expect(cap.capture_mode.is_by_value()).to_equal(true)

    it "creates by_ref capture":
        val cap = CapturedVar.by_ref(1)
        expect(cap.local_index).to_equal(1)
        expect(cap.capture_mode.is_reference()).to_equal(true)
        expect(cap.capture_mode.is_by_value()).to_equal(false)


# ============================================================================
# Test Group 6: HirExprKind
# ============================================================================

describe "HirExprKind Literals":
    it "Integer is literal":
        expect(HirExprKind.Integer.is_literal()).to_equal(true)

    it "Float is literal":
        expect(HirExprKind.Float.is_literal()).to_equal(true)

    it "Bool is literal":
        expect(HirExprKind.Bool.is_literal()).to_equal(true)

    it "String is literal":
        expect(HirExprKind.String.is_literal()).to_equal(true)

    it "Nil is literal":
        expect(HirExprKind.Nil.is_literal()).to_equal(true)

    it "non-literal kinds are rejected":
        expect(HirExprKind.Local.is_literal()).to_equal(false)
        expect(HirExprKind.Call.is_literal()).to_equal(false)


describe "HirExprKind Variables":
    it "Local is variable":
        expect(HirExprKind.Local.is_variable()).to_equal(true)

    it "Global is variable":
        expect(HirExprKind.Global.is_variable()).to_equal(true)

    it "literal is not variable":
        expect(HirExprKind.Integer.is_variable()).to_equal(false)


describe "HirExprKind Control Flow":
    it "If is control flow":
        expect(HirExprKind.If.is_control_flow()).to_equal(true)

    it "Match is control flow":
        expect(HirExprKind.Match.is_control_flow()).to_equal(true)

    it "Block is not control flow":
        expect(HirExprKind.Block.is_control_flow()).to_equal(false)


# ============================================================================
# Test Group 7: HirExprNode
# ============================================================================

describe "HirExprNode Factory":
    it "integer creates Integer node":
        val node = HirExprNode.integer(TypeId.i64_ty())
        expect(node.kind == HirExprKind.Integer).to_equal(true)
        expect(node.kind == HirExprKind.Float).to_equal(false)
        expect(node.get_type().id).to_equal(TypeId.i64_ty().id)

    it "bool_node creates Bool node":
        val node = HirExprNode.bool_node()
        expect(node.kind == HirExprKind.Bool).to_equal(true)
        expect(node.get_type().is_bool()).to_equal(true)

    it "nil_node creates Nil node":
        val node = HirExprNode.nil_node()
        expect(node.kind == HirExprKind.Nil).to_equal(true)
        expect(node.get_type().is_nil()).to_equal(true)

    it "local creates Local node":
        val node = HirExprNode.local(TypeId.i64_ty())
        expect(node.is_variable()).to_equal(true)
        expect(node.is_literal()).to_equal(false)


describe "HirExprNode Predicates":
    it "is_literal delegates to kind":
        val int_node = HirExprNode.integer(TypeId.i64_ty())
        expect(int_node.is_literal()).to_equal(true)
        expect(int_node.is_variable()).to_equal(false)

    it "is_variable delegates to kind":
        val local_node = HirExprNode.local(TypeId.i64_ty())
        expect(local_node.is_variable()).to_equal(true)
        val call_node = HirExprNode.call(TypeId.void_ty())
        expect(call_node.is_variable()).to_equal(false)


# ============================================================================
# Test Group 8: HirStmtKind
# ============================================================================

describe "HirStmtKind":
    it "Let is_let returns true":
        expect(HirStmtKind.Let.is_let()).to_equal(true)
        expect(HirStmtKind.Assign.is_let()).to_equal(false)

    it "Return is_return returns true":
        expect(HirStmtKind.Return.is_return()).to_equal(true)
        expect(HirStmtKind.Expr.is_return()).to_equal(false)

    it "If is_control_flow returns true":
        expect(HirStmtKind.If.is_control_flow()).to_equal(true)
        expect(HirStmtKind.Let.is_control_flow()).to_equal(false)

    it "While is_control_flow returns true":
        expect(HirStmtKind.While.is_control_flow()).to_equal(true)

    it "Break is_loop_control returns true":
        expect(HirStmtKind.Break.is_loop_control()).to_equal(true)
        expect(HirStmtKind.Loop.is_loop_control()).to_equal(false)

    it "Continue is_loop_control returns true":
        expect(HirStmtKind.Continue.is_loop_control()).to_equal(true)


# ============================================================================
# Test Group 9: HirStmtNode
# ============================================================================

describe "HirStmtNode Factory":
    it "let_stmt creates Let node":
        val node = HirStmtNode.let_stmt()
        expect(node.is_let()).to_equal(true)
        expect(node.is_return()).to_equal(false)

    it "return_stmt creates Return node":
        val node = HirStmtNode.return_stmt()
        expect(node.is_return()).to_equal(true)
        expect(node.is_let()).to_equal(false)

    it "if_stmt creates If node":
        val node = HirStmtNode.if_stmt()
        expect(node.is_control_flow()).to_equal(true)
        expect(HirStmtNode.expr_stmt().is_control_flow()).to_equal(false)


# ============================================================================
# Test Group 10: HirPatternKind
# ============================================================================

describe "HirPatternKind":
    it "Wildcard is_wildcard returns true":
        expect(HirPatternKind.Wildcard.is_wildcard()).to_equal(true)
        expect(HirPatternKind.Binding.is_wildcard()).to_equal(false)

    it "Binding is_binding returns true":
        expect(HirPatternKind.Binding.is_binding()).to_equal(true)
        expect(HirPatternKind.Literal.is_binding()).to_equal(false)

    it "Literal is_literal returns true":
        expect(HirPatternKind.Literal.is_literal()).to_equal(true)
        expect(HirPatternKind.Wildcard.is_literal()).to_equal(false)


# ============================================================================
# Test Group 11: HirLiteral
# ============================================================================

describe "HirLiteral":
    it "Int has correct type_name":
        expect(HirLiteral.Int(42).type_name()).to_equal("int")

    it "Float has correct type_name":
        expect(HirLiteral.Float(3.14).type_name()).to_equal("float")
        expect(HirLiteral.Bool(true).type_name()).to_equal("bool")
        expect(HirLiteral.String("s").type_name()).to_equal("string")

    it "Nil is_nil returns true":
        expect(HirLiteral.Nil.is_nil()).to_equal(true)
        expect(HirLiteral.Int(0).is_nil()).to_equal(false)

    it "is_number returns true for Int":
        expect(HirLiteral.Int(42).is_number()).to_equal(true)
        expect(HirLiteral.Bool(true).is_number()).to_equal(false)

    it "is_number returns true for Float":
        expect(HirLiteral.Float(3.14).is_number()).to_equal(true)
        expect(HirLiteral.String("1").is_number()).to_equal(false)

    it "to_bool returns correct values":
        expect(HirLiteral.Bool(true).to_bool()).to_equal(true)
        expect(HirLiteral.Bool(false).to_bool()).to_equal(false)
        expect(HirLiteral.Nil.to_bool()).to_equal(false)
        expect(HirLiteral.Int(0).to_bool()).to_equal(false)
        expect(HirLiteral.Int(1).to_bool()).to_equal(true)
        expect(HirLiteral.String("").to_bool()).to_equal(false)
        expect(HirLiteral.String("x").to_bool()).to_equal(true)
