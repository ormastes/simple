"""
# Layered facade export-origin routing

Frozen export origins use logical module names. Native-build registries may
retain numeric compiler tiers or the physical `std` spelling, so HIR must map
only a unique canonical owner and reject ambiguous physical providers.
"""

use std.spec.{describe, it, expect}
use compiler.hir.hir_lowering._Items.module_lowering.*
use compiler.hir.hir_lowering.module_surface.{
    ModuleSurface, ModuleSurfaceBuilder
}

extern fn rt_hash_text(content: text) -> i64

describe "layered export-origin routing":
    it "registers compiler tiers 10 20 70 and 80 as canonical aliases":
        var builder = ModuleSurfaceBuilder.new()
        val frontend_name = "compiler.10.frontend.core.alloc_inference"
        val hir_name = "compiler.20.hir.hir_lowering.types"
        val backend_name = "compiler.70.backend.backend.llvm_backend"
        val driver_name = "compiler.80.driver.driver_bootstrap"
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(frontend_name), frontend_name,
            "src/compiler/10.frontend/core/alloc_inference.spl").is_ok())\
            .to_equal(true)
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(hir_name), hir_name,
            "src/compiler/20.hir/hir_lowering/types.spl").is_ok())\
            .to_equal(true)
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(backend_name), backend_name,
            "src/compiler/70.backend/backend/llvm_backend.spl").is_ok())\
            .to_equal(true)
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(driver_name), driver_name,
            "src/compiler/80.driver/driver_bootstrap.spl").is_ok())\
            .to_equal(true)
        val registry = builder.finish().unwrap()
        expect(hir_export_origin_surface_index(
            registry, "compiler.frontend.core.alloc_inference")).to_equal(0)
        expect(hir_export_origin_surface_index(
            registry, "compiler.hir.hir_lowering.types")).to_equal(1)
        expect(hir_export_origin_surface_index(
            registry, "compiler.backend.backend.llvm_backend")).to_equal(2)
        expect(hir_export_origin_surface_index(
            registry, "compiler.driver.driver_bootstrap")).to_equal(3)

    it "maps the LLVM async facade origin from lib to its std sync surface":
        val physical = "std.nogc_sync_mut.sffi.llvm_loader"
        var builder = ModuleSurfaceBuilder.new()
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(physical), physical,
            "src/std/nogc_sync_mut/sffi/llvm_loader.spl").is_ok())\
            .to_equal(true)
        val registry = builder.finish().unwrap()
        # std.nogc_async_mut.sffi.llvm_loader exports this logical owner.
        expect(hir_export_origin_surface_index(
            registry, "lib.nogc_sync_mut.sffi.llvm_loader")).to_equal(0)

    it "canonicalizes a layered alias discovered after a legacy first name":
        val path = "src/compiler/10.frontend/core/error.spl"
        var surface = ModuleSurface.empty("compiler.core.error")
        surface.canonical_path = path
        surface.content_hash = rt_hash_text("")
        var builder = ModuleSurfaceBuilder.new()
        expect(builder.add_surface_canonical_identity(
            surface, "compiler.core.error", path).is_ok()).to_equal(true)
        expect(builder.add_alias_canonical_identity(
            "compiler.10.frontend.core.error", "", path).is_ok())\
            .to_equal(true)
        val registry = builder.finish().unwrap()
        expect(hir_export_origin_surface_index(
            registry, "compiler.frontend.core.error")).to_equal(0)

    it "recovers a canonical origin from a retained legacy registry":
        val legacy_name = "compiler.10.frontend.core.error"
        var builder = ModuleSurfaceBuilder.new()
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(legacy_name), legacy_name,
            "src/compiler/10.frontend/core/error.spl").is_ok())\
            .to_equal(true)
        var registry = builder.finish().unwrap()
        # Reproduce a Stage-2 carrier frozen before canonical aliases were
        # published. The physical surface remains authoritative.
        registry.index_by_name = {legacy_name: 0}
        registry.ordered_names = [legacy_name]
        registry.ordered_indices = [0]
        # Native teardown may retain scalar aliases while class payload fields
        # are no longer safe lookup authorities.
        registry.surfaces[0] = ModuleSurface.empty("")
        expect(hir_export_origin_surface_index(
            registry, "compiler.frontend.core.error")).to_equal(0)

    it "canonicalizes a std filesystem alias discovered after a short name":
        val path = "src/std/nogc_async_mut/file_system/dir_ops.spl"
        var surface = ModuleSurface.empty("std.file_system.dir_ops")
        surface.canonical_path = path
        surface.content_hash = rt_hash_text("")
        var builder = ModuleSurfaceBuilder.new()
        expect(builder.add_surface_canonical_identity(
            surface, "std.file_system.dir_ops", path).is_ok()).to_equal(true)
        expect(builder.add_alias_canonical_identity(
            "std.nogc_async_mut.file_system.dir_ops", "", path).is_ok())\
            .to_equal(true)
        val registry = builder.finish().unwrap()
        expect(hir_export_origin_surface_index(
            registry, "lib.nogc_async_mut.file_system.dir_ops")).to_equal(0)

    it "rejects two physical surfaces with one canonical identity":
        val first = "compiler.10.frontend.core.alloc_inference"
        val second = "compiler.20.frontend.core.alloc_inference"
        var builder = ModuleSurfaceBuilder.new()
        expect(builder.add_surface_canonical_identity(
            ModuleSurface.empty(first), first,
            "src/compiler/10.frontend/core/alloc_inference.spl").is_ok())\
            .to_equal(true)
        val collision = builder.add_surface_canonical_identity(
            ModuleSurface.empty(second), second,
            "src/compiler/20.frontend/core/alloc_inference.spl")
        expect(collision.is_err()).to_equal(true)
        expect(collision.unwrap_err()).to_contain(
            "compiler.frontend.core.alloc_inference")
