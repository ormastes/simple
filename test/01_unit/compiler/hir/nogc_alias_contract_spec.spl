# @req REQ-NOGC-FOREIGN-001
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.parser_types.{ParserTypeParam}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_types.*
use compiler.hir.hir_symbol_table_methods.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.type_aliases.*
use compiler.hir.hir_lowering.items.*
use test.helpers.module_surface_owner_fixture.{module_surfaces_from_test_modules}

fn alias_contract_name(name: text) -> Type:
    Type(kind: TypeKind.Named(name, []), span: Span.empty())

fn alias_contract_kind(owner_strict: bool, importer_strict: bool, owner: text, target: Type, parameters: [ParserTypeParam], arguments: [HirType]) -> [text]:
    val source = "pub fn marker() -> i64:\n    0\n"
    var module = parse_and_build_module(source, "provider.spl")
    module.nogc_strict = owner_strict
    val registry = module_surfaces_from_test_modules({"provider": module}, [SourceFile(path: "provider.spl", content: source, module_name: "provider")]).unwrap()
    var lowering = HirLowering.with_filename("consumer.spl")
    lowering.nogc_strict = importer_strict
    lowering.module_surfaces = registry
    val symbol = lowering.symbols.define("Alias", SymbolKind.TypeAlias, nil, Span.empty(), Visibility.Public, false, Some(owner))
    lowering.register_type_alias_template(symbol, target, parameters, owner)
    val kind = lowering.lower_named_symbol_kind(symbol, arguments, Span.empty())
    var result: [text] = []
    match kind:
        case HirTypeKind.Error: result.push("error")
        case _: result.push(hir_type_kind_ownership_name(kind))
    if lowering.errors.len() > 0: result.push("diagnostic")
    result

describe "imported alias ownership contracts":
    it "rejects legacy unique, shared and weak templates":
        val inner = alias_contract_name("i64")
        for target in [Type(kind: TypeKind.Unique(inner), span: Span.empty()), Type(kind: TypeKind.Shared(inner), span: Span.empty()), Type(kind: TypeKind.Weak(inner), span: Span.empty())]:
            expect(alias_contract_kind(false, true, "provider", target, [], [])).to_equal(["error", "diagnostic"])

    it "rejects missing ownership contracts and preserves checked or local aliases":
        val target = Type(kind: TypeKind.Unique(alias_contract_name("i64")), span: Span.empty())
        expect(alias_contract_kind(false, true, "missing", target, [], [])).to_equal(["error", "diagnostic"])
        expect(alias_contract_kind(true, true, "provider", target, [], [])).to_equal(["unique"])
        expect(alias_contract_kind(false, true, "consumer.spl", target, [], [])).to_equal(["unique"])
        expect(alias_contract_kind(false, false, "provider", target, [], [])).to_equal(["ref"])

    it "rejects ownership hidden in a composite template":
        val owner = Type(kind: TypeKind.Unique(alias_contract_name("i64")), span: Span.empty())
        val nested = Type(kind: TypeKind.Optional(Type(kind: TypeKind.Array(owner, nil), span: Span.empty())), span: Span.empty())
        expect(alias_contract_kind(false, true, "provider", nested, [], [])).to_equal(["error", "diagnostic"])

    it "checks a default only when the caller uses it":
        val default_type = Type(kind: TypeKind.Unique(alias_contract_name("i64")), span: Span.empty())
        val parameter = ParserTypeParam(name: "T", bounds: [], has_default: true, default: default_type, span: Span.empty())
        expect(alias_contract_kind(false, true, "provider", alias_contract_name("T"), [parameter], [])).to_equal(["error", "diagnostic"])
        val checked_argument = HirType(kind: HirTypeKind.Unique(HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())), span: Span.empty())
        expect(alias_contract_kind(false, true, "provider", alias_contract_name("T"), [parameter], [checked_argument])).to_equal(["unique"])
