use std.spec.*
use compiler.hir.target_hir.target_hir_flags.{target_hir_mode_parse_strict, target_hir_mode_parse, target_hir_verify_parse, target_hir_storage_parse, stage3_compiler_path_parse, target_hir_mode, target_hir_storage}

describe "TargetHIR flags (U0)":
    it "defaults mode to legacy when unset or empty":
        expect(target_hir_mode_parse(nil)).to_equal("legacy")
        expect(target_hir_mode_parse("")).to_equal("legacy")
        expect(target_hir_mode_parse("legacy")).to_equal("legacy")

    it "accepts shadow and typed case-insensitively":
        expect(target_hir_mode_parse(" Shadow ")).to_equal("shadow")
        expect(target_hir_mode_parse("TYPED")).to_equal("typed")

    it "maps an invalid mode to legacy, but strict parse names the error":
        expect(target_hir_mode_parse("typo")).to_equal("legacy")
        val r = target_hir_mode_parse_strict("typo")
        expect(r.is_err()).to_be(true)
        expect(r.unwrap_err()).to_equal("target_hir_mode_unknown: typo")

    it "parses verify as a boolean, default false":
        expect(target_hir_verify_parse(nil)).to_be(false)
        expect(target_hir_verify_parse("0")).to_be(false)
        expect(target_hir_verify_parse("1")).to_be(true)
        expect(target_hir_verify_parse("On")).to_be(true)

    it "parses storage with auto default":
        expect(target_hir_storage_parse(nil)).to_equal("auto")
        expect(target_hir_storage_parse("dense")).to_equal("dense")
        expect(target_hir_storage_parse("SPARSE")).to_equal("sparse")
        expect(target_hir_storage_parse("bogus")).to_equal("auto")

    it "returns nil stage3 path when unset or blank":
        expect(stage3_compiler_path_parse(nil) == nil).to_be(true)
        expect(stage3_compiler_path_parse("  ") == nil).to_be(true)
        expect(stage3_compiler_path_parse(" /x/simple ") ?? "").to_equal("/x/simple")

    it "env readers return a valid value in any environment":
        val m = target_hir_mode()
        expect(m == "legacy" or m == "shadow" or m == "typed").to_be(true)
        val s = target_hir_storage()
        expect(s == "auto" or s == "dense" or s == "sparse").to_be(true)
