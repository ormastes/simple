use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

# Phase-3 stage3 bootstrap: the frozen stage2 (ef0681fc0e1) mis-binds
# `if val x = <struct-typed Option>` (bug
# stage2_if_val_struct_option_binding_as_int_wide_2026-11-03). In
# `SymbolTable.symbol_display_name` that shape sat on the HIR path that names
# EVERY NamedVar, so stage3 reported `undefined variable (false, )` for any
# local read (bug stage2_symbol_display_name_option_transport_2026-11-03).
# The name must come through the scalar accessor that exists for this hazard.

describe "symbol_display_name reads the stored name without transporting HirSymbol?":
    it "no longer returns the name of an `if val`-bound HirSymbol payload":
        # `return sym.name` was unique to symbol_display_name; the sibling
        # mutators (mark_generic_callable, rename_symbol) keep their own
        # `if val payload = found` and are out of this record's scope.
        val src = file_read("src/compiler/20.hir/hir_symbol_table_methods.spl")
        expect(src).not_to_contain("return sym.name")

    it "routes through symbol_name_scalar_raw and keeps the fallback":
        val src = file_read("src/compiler/20.hir/hir_symbol_table_methods.spl")
        expect(src).to_contain("val display_name: text = self.symbol_name_scalar_raw(id.id)")
        expect(src).to_contain("if display_name != \"\":")
        expect(src).to_contain("return display_name")
