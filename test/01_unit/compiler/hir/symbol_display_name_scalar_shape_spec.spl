use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolTable, SymbolId, SymbolKind}

# `SymbolTable.symbol_display_name` restores idiomatic `HirSymbol?` / `if val`
# binding after removing the frozen-stage2 workaround
# (`stage2_symbol_display_name_option_transport_2026-11-03`).

describe "symbol_display_name transports HirSymbol? through if val":
    it "removes the frozen-stage2 workaround and binds HirSymbol? with if val":
        val src = file_read("src/compiler/20.hir/hir_symbol_table_methods.spl")
        expect(src).to_contain("return sym.name")
        expect(src).not_to_contain("stage2_symbol_display_name_option_transport_2026-11-03")

    it "returns stored and renamed symbol names and falls back when absent":
        var table = SymbolTable.new()
        val span = Span.empty()
        val sym_id = table.define("alpha", SymbolKind.Variable, nil, span, Visibility.Private, false, Some("mod"))
        expect(table.symbol_display_name(sym_id, "fallback")).to_equal("alpha")
        table.rename_symbol(sym_id, "mod.alpha")
        expect(table.symbol_display_name(sym_id, "fallback")).to_equal("mod.alpha")
        expect(table.symbol_display_name(SymbolId(id: -1), "fallback")).to_equal("fallback")
        expect(table.symbol_display_name(SymbolId(id: 9999), "fallback")).to_equal("fallback")
