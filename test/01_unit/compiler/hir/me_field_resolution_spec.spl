"""
## Purpose and audience
Purpose: Prove that me.field resolves inside me-prefix method bodies.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-HIR-001 — stable requirement identity for this spec.

# @cover src/compiler/20.hir/hir_lowering/expressions.spl
# Lane ME1 (me-field-resolution), mission-critical robustness campaign.
#
# BACKGROUND: the 2026-07-27 fix (commit 8af2dc555960, bug doc
# stage4_me_receiver_unresolved_in_class_methods_2026-07-27.md) added a
# `me` <-> `self` receiver-aliasing block to
# `HirLowering.lower_unresolved_ident` in expressions.spl: a `me`-prefix
# method (`me foo():`) synthesizes its receiver parameter as "self", so a
# body that reads `me.field` looked up a name that was never defined and
# hard-errored "unresolved name: me". That block was accidentally deleted
# the next day by commit 55db1d3d92016 ("fix(compiler): harden
# source-matched native worker") -- an unrelated refactor's diff hunk
# swallowed it. Lane CLSM re-discovered the regression on 2026-07-29 while
# writing class_method_bodies_reachable_spec.spl: a class with 2 me-methods
# whose bodies read `me.field` produced 4 "unresolved name: me" errors.
#
# HARNESS NOTE (per class_method_bodies_reachable_spec.spl and
# enum_match_unknown_variant_diagnostic_spec.spl headers): the
# parse_full_frontend -> HirLowering -> lower_module pipeline is inlined in
# every `it` block on purpose -- do not factor this into a shared helper.

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*

describe "me.field resolves inside me-prefix method bodies":
    it "lowers a single me-method reading me.field with zero errors":
        step("Verify: lowers a single me-method reading me.field with zero errors")
        # @req: REQ-COMPILER-HIR-001
        val src = "class Box:\n" +
            "    value: i64\n" +
            "    me get_value() -> i64:\n" +
            "        val v = me.value\n" +
            "        v\n"
        val parsed = parse_full_frontend(src, "testdata/me_field_single.spl", "me_field_single", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/me_field_single.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var found_get_value = false
        for fn_ in hir.functions.values():
            if fn_.name == "get_value":
                found_get_value = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
        expect(found_get_value).to_equal(true)

    it "keeps self.field working inside a me-method (regression)":
        step("Verify: keeps self.field working inside a me-method (regression)")
        val src = "class Box:\n" +
            "    value: i64\n" +
            "    me get_value() -> i64:\n" +
            "        self.value\n"
        val parsed = parse_full_frontend(src, "testdata/me_field_self_regression.spl", "me_field_self_regression", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/me_field_self_regression.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var found_get_value = false
        for fn_ in hir.functions.values():
            if fn_.name == "get_value":
                found_get_value = true
        expect(found_get_value).to_equal(true)

    it "lowers 2 me-methods both reading me.field with zero errors (CLSM's exact failing shape)":
        step("Verify: lowers 2 me-methods both reading me.field with zero errors (CLSM's exact failing shape)")
        val src = "class Box:\n" +
            "    value: i64\n" +
            "    me set_value(next: i64) -> i64:\n" +
            "        me.value = next\n" +
            "        me.value\n" +
            "    me double(next: i64) -> i64:\n" +
            "        me.value = next * 2\n" +
            "        me.value\n"
        val parsed = parse_full_frontend(src, "testdata/me_field_two_methods.spl", "me_field_two_methods", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/me_field_two_methods.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var found_set_value = false
        var found_double = false
        for fn_ in hir.functions.values():
            if fn_.name == "set_value":
                found_set_value = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
            if fn_.name == "double":
                found_double = true
                expect(fn_.body.stmts.len() > 0).to_equal(true)
        expect(found_set_value).to_equal(true)
        expect(found_double).to_equal(true)

    it "still errors on a bare me reference outside any method body (no global alias)":
        step("Verify: still errors on a bare me reference outside any method body (no global alias)")
        val src = "fn helper() -> i64:\n" +
            "    me\n"
        val parsed = parse_full_frontend(src, "testdata/me_field_bare_outside_method.spl", "me_field_bare_outside_method", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/me_field_bare_outside_method.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len() > 0).to_equal(true)

        var has_unresolved_me = false
        for err in hir_lowering.errors:
            if err.message.contains("unresolved name: me"):
                has_unresolved_me = true
        expect(has_unresolved_me).to_equal(true)
