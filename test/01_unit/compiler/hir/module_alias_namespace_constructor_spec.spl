"""
# Module Alias Namespace and Constructor Regression Spec

Qualified module aliases must retain same-named functions/constants from
different providers, and imported function signatures must retain class record
types used by constructors and returned arrays.
"""

use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use test.helpers.module_surface_owner_fixture.{module_surfaces_from_test_modules}
use compiler.hir.hir_definitions.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}

fn mans_logger() -> Logger:
    Logger(level: 0)

fn mans_surfaces(modules: Dict<text, Module>, sources: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_test_modules(modules, sources):
        case Ok(value): value
        case Err(_):
            assert_true(false)
            ModuleSurfacesByName.empty()

describe "module alias namespace and imported constructors":
    it "keeps qualified same-name functions and constants in separate module views":
        val log = mans_logger()
        val left_source = "pub const shared_value: i64 = 11\npub fn shared() -> i64:\n    11"
        val right_source = "pub const shared_value: i64 = 29\npub fn shared() -> i64:\n    29"
        val left = parse_full_frontend(left_source, "leftpkg.provider", "leftpkg.provider", log)
        val right = parse_full_frontend(right_source, "rightpkg.provider", "rightpkg.provider", log)
        val consumer_source = "use leftpkg.provider as lhs\nuse rightpkg.provider as rhs\nfn answer() -> i64:\n    lhs.shared() + rhs.shared() + lhs.shared_value + rhs.shared_value"
        val consumer = parse_full_frontend(consumer_source, "consumerpkg.main", "consumerpkg.main", log)
        var modules: Dict<text, Module> = {}
        modules["leftpkg.provider"] = left
        modules["rightpkg.provider"] = right
        val surfaces = mans_surfaces(modules, [
            SourceFile(path: "leftpkg/provider.spl", content: left_source, module_name: "leftpkg.provider"),
            SourceFile(path: "rightpkg/provider.spl", content: right_source, module_name: "rightpkg.provider")
        ])
        var lowering = hirlowering_for_module("consumerpkg.main", surfaces)
        val hir = lowering.lower_module(consumer)

        expect(lowering.errors.len()).to_equal(0)
        val left_fn = hir.symbols.lookup_or_invalid("lhs.shared")
        val right_fn = hir.symbols.lookup_or_invalid("rhs.shared")
        val left_value = hir.symbols.lookup_or_invalid("lhs.shared_value")
        val right_value = hir.symbols.lookup_or_invalid("rhs.shared_value")
        expect(left_fn.is_valid()).to_equal(true)
        expect(right_fn.is_valid()).to_equal(true)
        expect(left_value.is_valid()).to_equal(true)
        expect(right_value.is_valid()).to_equal(true)
        expect(left_fn.id == right_fn.id).to_equal(false)
        expect(left_value.id == right_value.id).to_equal(false)
        expect(hir.symbols.lookup_or_invalid("shared").is_valid()).to_equal(false)
        expect(hir.symbols.lookup_or_invalid("shared_value").is_valid()).to_equal(false)

    it "retains a provider class in imported constructor and array return types":
        val log = mans_logger()
        val provider_source = "pub class ImportedRecord:\n    name: text\npub fn make_record(name: text) -> ImportedRecord:\n    ImportedRecord(name: name)\npub fn records() -> [ImportedRecord]:\n    [make_record(\"ok\")]"
        val provider = parse_full_frontend(provider_source, "records.provider", "records.provider", log)
        val open = "\{"
        val close = "\}"
        val consumer_source = "use records.provider." + open + "make_record, records" + close + "\nfn answer() -> text:\n    val direct = make_record(\"direct\")\n    val all = records()\n    direct.name + all[0].name"
        val consumer = parse_full_frontend(consumer_source, "records.consumer", "records.consumer", log)
        var modules: Dict<text, Module> = {}
        modules["records.provider"] = provider
        val surfaces = mans_surfaces(modules, [
            SourceFile(path: "records/provider.spl", content: provider_source, module_name: "records.provider")
        ])
        var lowering = hirlowering_for_module("records.consumer", surfaces)
        val hir = lowering.lower_module(consumer)

        expect(lowering.errors.len()).to_equal(0)
        val record_type = hir.symbols.lookup_or_invalid("ImportedRecord")
        expect(record_type.is_valid()).to_equal(true)
        val make_symbol = hir.symbols.lookup_or_invalid("make_record")
        val records_symbol = hir.symbols.lookup_or_invalid("records")
        expect(make_symbol.is_valid()).to_equal(true)
        expect(records_symbol.is_valid()).to_equal(true)
        if val make_def = hir.symbols.get_symbol_raw(make_symbol.id):
            if make_def.type_ != nil:
                match (make_def.type_ ?? HirType(kind: HirTypeKind.Error, span: make_def.span)).kind:
                    case HirTypeKind.Function(_, HirType(kind: HirTypeKind.Named(owner, _), span: _), _):
                        expect(owner.id).to_equal(record_type.id)
                    case _:
                        assert_true(false)
            else:
                assert_true(false)
        else:
            assert_true(false)
        if val records_def = hir.symbols.get_symbol_raw(records_symbol.id):
            if records_def.type_ != nil:
                match (records_def.type_ ?? HirType(kind: HirTypeKind.Error, span: records_def.span)).kind:
                    case HirTypeKind.Function(_, HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Named(owner, _), span: _), _), span: _), _):
                        expect(owner.id).to_equal(record_type.id)
                    case _:
                        assert_true(false)
            else:
                assert_true(false)
        else:
            assert_true(false)
