"""

# doc-path: doc/01_research/local/imported_tuple_signature_dependency_spec.md
# doc-path: doc/03_plan/sys_test/imported_tuple_signature_dependency_spec.md
# doc-path: doc/04_architecture/imported_tuple_signature_dependency_spec.md
# doc-path: doc/05_design/imported_tuple_signature_dependency_spec_oracles.md
# @manual: primary

"""
# Imported Tuple Signature Dependency — Unit Spec

Regression guard for the Stage-1 HIR fatal

    HIR lowering error in src/compiler/driver/driver.spl:
    unresolved type: ResolveError

`src/compiler/80.driver/driver.spl` never names `ResolveError` (0 hits in all
156 lines). `struct ResolveError` is declared in
`src/compiler/35.semantics/resolve.spl:762`, and `resolve_methods` there returns
the TUPLE `(HirModule, [ResolveError])`.

Cross-module signature dependencies are materialized under the QUALIFIED local
name `{module}::{name}` (`materialize_imported_callable_declared_dependency`),
never the bare one. `imported_surface_type_projected` projects an imported
signature back through that qualified scope, but only for two SCALAR shapes:
a top-level named type (`return_type_name`) and an array-of-named
(`return_array_element_name`). A tuple populates NEITHER, so it fell through to
`imported_surface_type`, which also only projected a top-level Named kind, and
finally to `lower_type` — which resolves names in the IMPORTER's scope, where
`ResolveError` is bound only as `sem.resolve::ResolveError`. Result: the hard,
non-recovered `unresolved type: ResolveError` blamed on the importer.

The defect is SHAPE-specific, not type-specific: the identical signature written
as a bare `[ResolveError]` always worked, which is what made it look arbitrary.
"""
use std.spec.step

use std.spec.step

use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module, Type, TypeKind}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}


fn tuple_dep_spec_logger() -> Logger:
    Logger(level: 0)

fn tuple_dep_spec_surfaces(modules: Dict<text, Module>, sources: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_modules(modules, sources):
        case Ok(value): value
        case Err(error):
            assert_true(false)
            ModuleSurfacesByName.empty()

fn tuple_dep_spec_lower(owner_return: text) -> HirLowering:
    val log = tuple_dep_spec_logger()
    val sem_source =
        "struct ResolveError:\n    message: text\n\nfn resolve_methods(m: i64) -> " +
        owner_return + ":\n    " + (if owner_return == "[ResolveError]": "[]" else: "(m, [])")
    val mid_source =
        "use sem.resolve.\{resolve_methods\}\n\nfn run_pass(m: i64) -> i64:\n    m"
    val cons_source =
        "use sem.resolve.\{resolve_methods\}\n\nfn go() -> i64:\n    1"
    val sem = parse_full_frontend(sem_source, "sem.resolve", "sem.resolve", log)
    val mid = parse_full_frontend(mid_source, "drv.passes", "drv.passes", log)
    val cons = parse_full_frontend(cons_source, "drv.driver", "drv.driver", log)
    var modules: Dict<text, Module> = {}
    modules["sem.resolve"] = sem
    modules["drv.passes"] = mid
    val sources = [
        SourceFile(path: "sem/resolve.spl", content: sem_source, module_name: "sem.resolve"),
        SourceFile(path: "drv/passes.spl", content: mid_source, module_name: "drv.passes")
    ]
    val surfaces = tuple_dep_spec_surfaces(modules, sources)
    var lowering = hirlowering_for_module("drv.driver", surfaces)
    val hir = lowering.lower_module(cons)
    lowering

fn projection_parser_type(kind: TypeKind) -> Type:
    Type(kind: kind, span: Span.empty())

fn projection_named(name: text) -> Type:
    projection_parser_type(TypeKind.Named(name, []))

fn projection_hir_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn projection_owner_type(id: i64) -> HirType:
    projection_hir_type(HirTypeKind.Named(SymbolId.new(id), []))

fn project_owner_shape(type_: Type) -> HirType:
    var lowering = tuple_dep_spec_lower("[ResolveError]")
    lowering.symbols.bind_qualified_type("shape.owner", "OwnerType", SymbolId.new(901))
    lowering.symbols.bind_qualified_type("shape.owner", "OtherType", SymbolId.new(902))
    lowering.imported_surface_type(type_, "shape.owner")

describe "imported callable whose signature dependency sits inside a tuple":
    # @manual scenario evidence
    it "resolves a tuple-return element type through the declaring module":
        # @req REQ-SSPEC-COMPILER
        step("resolves a tuple-return element type through the declaring module")
        # Pre-fix: `unresolved type: ResolveError`, attributed to drv.driver.
        val lowering = tuple_dep_spec_lower("(i64, [ResolveError])")
        for error in lowering.errors:
            eprint("[tuple-dep-error] {error.message}")
        expect(lowering.errors.len()).to_equal(0)

    it "still resolves the array-only shape that always worked":
        # @req REQ-SSPEC-COMPILER
        step("still resolves the array-only shape that always worked")
        # Control: proves the defect was the SHAPE, not the type name.
        val lowering = tuple_dep_spec_lower("[ResolveError]")
        expect(lowering.errors.len()).to_equal(0)

describe "recursive imported surface type projection":
    it "preserves owner-qualified names through nested arrays and array-of-tuple":
        val owner = projection_owner_type(901)
        val other = projection_owner_type(902)
        val nested = projection_parser_type(TypeKind.Array(
            projection_parser_type(TypeKind.Array(projection_named("OwnerType"), nil)), nil))
        val nested_expected = projection_hir_type(HirTypeKind.Array(
            projection_hir_type(HirTypeKind.Array(owner, nil)), nil))
        expect(hir_types_equal(project_owner_shape(nested), nested_expected)).to_equal(true)

        val array_tuple = projection_parser_type(TypeKind.Array(
            projection_parser_type(TypeKind.Tuple([
                projection_named("OtherType"), projection_named("OwnerType")
            ])), nil))
        val array_tuple_expected = projection_hir_type(HirTypeKind.Array(
            projection_hir_type(HirTypeKind.Tuple([other, owner])), nil))
        expect(hir_types_equal(
            project_owner_shape(array_tuple), array_tuple_expected)).to_equal(true)

    it "preserves immutable and mutable pointer projection":
        val owner = projection_owner_type(901)
        val immutable = projection_parser_type(TypeKind.Pointer(projection_named("OwnerType"), false))
        val mutable = projection_parser_type(TypeKind.Pointer(projection_named("OwnerType"), true))
        expect(hir_types_equal(project_owner_shape(immutable),
            projection_hir_type(HirTypeKind.Ptr(owner, false)))).to_equal(true)
        expect(hir_types_equal(project_owner_shape(mutable),
            projection_hir_type(HirTypeKind.Ptr(owner, true)))).to_equal(true)

    it "preserves every union position and its order":
        val owner = projection_owner_type(901)
        val other = projection_owner_type(902)
        val union = projection_parser_type(TypeKind.Union([
            projection_named("OtherType"), projection_named("OwnerType"),
            projection_named("OtherType")
        ]))
        val expected = projection_hir_type(HirTypeKind.Union([other, owner, other]))
        expect(hir_types_equal(project_owner_shape(union), expected)).to_equal(true)

    it "preserves function parameters and return type":
        val owner = projection_owner_type(901)
        val other = projection_owner_type(902)
        val function = projection_parser_type(TypeKind.Function([
            projection_named("OtherType"), projection_named("OwnerType")
        ], projection_named("OwnerType")))
        val expected = projection_hir_type(HirTypeKind.Function(
            [other, owner], owner, []))
        expect(hir_types_equal(project_owner_shape(function), expected)).to_equal(true)

    it "projects a mixed array function pointer union shape recursively":
        val owner = projection_owner_type(901)
        val mixed = projection_parser_type(TypeKind.Array(
            projection_parser_type(TypeKind.Function([
                projection_parser_type(TypeKind.Union([
                    projection_parser_type(TypeKind.Pointer(
                        projection_named("OwnerType"), true)),
                    projection_named("text")
                ]))
            ], projection_parser_type(TypeKind.Array(
                projection_named("OwnerType"), nil)))), nil))
        val expected = projection_hir_type(HirTypeKind.Array(
            projection_hir_type(HirTypeKind.Function([
                projection_hir_type(HirTypeKind.Union([
                    projection_hir_type(HirTypeKind.Ptr(owner, true)),
                    projection_hir_type(HirTypeKind.Str)
                ]))
            ], projection_hir_type(HirTypeKind.Array(owner, nil)), [])), nil))
        expect(hir_types_equal(project_owner_shape(mixed), expected)).to_equal(true)
