use std.io_runtime.{file_read}
use std.spec.*

describe "HIR match binding scope":
    it "binds each arm pattern before lowering its guard and body":
        val source = file_read("src/compiler/20.hir/hir_lowering/expressions.spl")
        val arm_start = source.find("            case ExprKind.MatchCase(scrutinee, arms):") ?? -1
        val arm_source = source[arm_start:]
        val push_pos = arm_source.find("self.symbols.push_scope(ScopeKind.Block)") ?? -1
        val pattern_pos = arm_source.find("val hir_pattern = self.lower_pattern(typed_arm.pattern)") ?? -1
        val guard_pos = arm_source.find("val hir_guard = self.lower_hir_expr(typed_arm.guard)") ?? -1
        val body_pos = arm_source.find("var coverage_body = self.lower_hir_block(typed_arm.body)") ?? -1
        val pop_pos = arm_source.find("self.symbols.pop_scope()") ?? -1

        expect(arm_start).to_be_greater_than(-1)
        expect(push_pos).to_be_less_than(pattern_pos)
        expect(pattern_pos).to_be_less_than(guard_pos)
        expect(guard_pos).to_be_less_than(body_pos)
        expect(body_pos).to_be_less_than(pop_pos)
