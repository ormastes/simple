use std.io_runtime.{read_file_text}
use std.spec.*

val MODULE_IMPORT_REGISTRATION = "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl"
val MODULE_REEXPORT_MATERIALIZATION = "src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl"
val MODULE_CALLABLE_TYPES = "src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl"

describe "Imported callable surface projection":
    it "projects free-function signatures through the defining module identity":
        val source = read_file_text(MODULE_IMPORT_REGISTRATION)
        expect(source).to_contain(
            "val fn_type = self.declared_imported_surface_callable_type(\n" +
            "                imported_mod.callable_values[callable_position],\n" +
            "                imported_mod.module_name, nil)")

    it "projects concrete and trait method signatures through the defining module identity":
        val reexports = read_file_text(MODULE_REEXPORT_MATERIALIZATION)
        val callable_types = read_file_text(MODULE_CALLABLE_TYPES)
        expect(reexports).to_contain(
            "method_type = self.declared_imported_owner_callable_type(\n" +
            "                            method, imported_mod.module_name, local_owner, owner_type_params)")
        expect(reexports).to_contain(
            "val method_type = self.declared_imported_owner_callable_type(\n" +
            "                                    trait_method, trait_module.module_name,\n" +
            "                                    local_owner, trait_.type_params)")
        expect(callable_types).to_contain(
            "self.declared_imported_surface_callable_type(\n" +
            "                callable, imported_module_name, Some(owner_symbol))")

    it "does not route imported callables through the generic nested-Type lowering path":
        val imports = read_file_text(MODULE_IMPORT_REGISTRATION)
        val reexports = read_file_text(MODULE_REEXPORT_MATERIALIZATION)
        val callable_types = read_file_text(MODULE_CALLABLE_TYPES)
        expect(imports.index_of(
            "declared_surface_callable_type(imported_mod.callable_values[callable_position], nil)")).to_equal(-1)
        expect(reexports.index_of(
            "declared_surface_callable_type(")).to_equal(-1)
        expect(callable_types.index_of(
            "declared_surface_callable_type(imported_mod.callables[imported_name], nil)")).to_equal(-1)
