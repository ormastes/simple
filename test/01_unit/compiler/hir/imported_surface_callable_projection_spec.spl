use std.io_runtime.{read_file_text}
use std.spec.*

val MODULE_LOWERING = "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl"

describe "Imported callable surface projection":
    it "projects free-function signatures through the defining module identity":
        val source = read_file_text(MODULE_LOWERING)
        expect(source).to_contain(
            "self.declared_imported_surface_callable_type(\n" +
            "                imported_mod.callables[imported_name], imported_mod.module_name, nil)")

    it "projects concrete and trait method signatures through the defining module identity":
        val source = read_file_text(MODULE_LOWERING)
        expect(source).to_contain(
            "self.declared_imported_surface_callable_type(\n" +
            "                        method, imported_mod.module_name, Some(local_owner))")
        expect(source).to_contain(
            "self.declared_imported_surface_callable_type(\n" +
            "                                    trait_method, imported_mod.module_name, Some(local_owner))")

    it "does not route imported callables through the generic nested-Type lowering path":
        val source = read_file_text(MODULE_LOWERING)
        expect(source.index_of(
            "declared_surface_callable_type(imported_mod.callables[imported_name], nil)")).to_equal(-1)
