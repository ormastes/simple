"""
Actual compiler-source HIR regression for bidirectional_checking dependencies.
Authored but not executed: a passing import subset does not establish zero HIR errors.
Run using the qualified pure-Simple runtime from the repository root.
"""
use std.spec.{describe, it, expect}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirTypeKind}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}
use compiler.types.bidirectional_types.{BidirHirType, BidirHirExpr, BidirHirExprKind, BidirHirFunction, BidirOption}
use compiler.types.bidirectional_inferencer.TypeInferencer

extern fn rt_file_read_text(path: text) -> text

fn bidirectional_actual_source_lowering(target: text) -> HirLowering:
    val names = ["bidirectional_types", "bidirectional_inferencer", "bidirectional_checking"]
    var modules: Dict<text, Module> = {}
    var sources: [SourceFile] = []
    for name in names:
        val path = "src/compiler/30.types/" + name + ".spl"
        val source = rt_file_read_text(path) ?? ""
        assert source.len() > 0, "Real compiler source must exist"
        val module_name = "compiler.types." + name
        modules[module_name] = parse_full_frontend(source, module_name, path, Logger(level: 0))
        sources.push(SourceFile(path: path, content: source, module_name: module_name))
    val surfaces = match module_surfaces_from_modules(modules, sources):
        case Ok(value): value
        case Err(error):
            assert false, "Real compiler module surface generation failed"
            ModuleSurfacesByName.empty()
    val module_name = "compiler.types." + target
    var lowering = hirlowering_for_module(module_name, surfaces)
    lowering.lower_module(modules[module_name])
    lowering

describe "bidirectional checker actual source imports":
    it "lowers the real checker without unresolved providers or other HIR errors":
        val lowering = bidirectional_actual_source_lowering("bidirectional_checking")
        expect(lowering.symbols.lookup_or_invalid("TypeInferencer").is_valid()).to_equal(true)
        expect(lowering.symbols.lookup_or_invalid("BidirHirExpr").is_valid()).to_equal(true)
        expect(lowering.symbols.lookup_or_invalid("BidirHirFunction").is_valid()).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "lowers the real nominal type and expression factory bodies":
        val lowering = bidirectional_actual_source_lowering("bidirectional_types")
        expect(lowering.symbols.lookup_or_invalid("BidirOption").is_valid()).to_equal(true)
        expect(lowering.symbols.lookup_or_invalid("BidirHirExprKind").is_valid()).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)
        val option_owner = lowering.symbols.lookup_or_invalid("BidirOption")
        val function_fields = lowering.struct_field_types_by_name["BidirHirFunction"]
        val annotation = function_fields["return_type"]
        match annotation.kind:
            case HirTypeKind.Named(owner, args):
                expect(owner.id).to_equal(option_owner.id)
                expect(args.len()).to_equal(1)
            case _: assert false, "Annotation must retain its nominal BidirOption owner"

    it "lowers the real inferencer bodies with explicit providers":
        val lowering = bidirectional_actual_source_lowering("bidirectional_inferencer")
        expect(lowering.symbols.lookup_or_invalid("BidirHirExpr").is_valid()).to_equal(true)
        expect(lowering.symbols.lookup_or_invalid("BidirHirExprKind").is_valid()).to_equal(true)
        expect(lowering.symbols.lookup_or_invalid("BidirHirFunction").is_valid()).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

describe "bidirectional nominal annotation option semantics":
    it "distinguishes the custom Some and None_ variants":
        val present: BidirOption<BidirHirType> = BidirOption.Some(BidirHirType.Bool)
        val absent: BidirOption<BidirHirType> = BidirOption.None_
        expect(present.is_some()).to_equal(true)
        expect(present.is_none()).to_equal(false)
        expect(absent.is_some()).to_equal(false)
        expect(absent.is_none()).to_equal(true)

    it "preserves annotation variants through let construction and inference":
        val value = BidirHirExpr.int_lit(42)
        val body = BidirHirExpr.bool_lit(true)
        val annotated = BidirHirExpr.let_bind("x", BidirOption.Some(BidirHirType.Int), value, body)
        val unannotated = BidirHirExpr.let_bind("x", BidirOption.None_, value, body)
        match annotated.kind:
            case Let(_, annotation, _, _): expect(annotation.is_some()).to_equal(true)
            case _: assert false, "Expected Let expression"
        match unannotated.kind:
            case Let(_, annotation, _, _): expect(annotation.is_none()).to_equal(true)
            case _: assert false, "Expected Let expression"
        var infer = TypeInferencer.empty()
        val annotated_type = infer.synthesize_expr(annotated)
        val unannotated_type = infer.synthesize_expr(unannotated)
        expect(infer.types_equal(annotated_type, BidirHirType.Bool)).to_equal(true)
        expect(infer.types_equal(unannotated_type, BidirHirType.Bool)).to_equal(true)

    it "checks annotated returns and synthesizes unannotated returns":
        var infer = TypeInferencer.empty()
        val body = BidirHirExpr.return_expr(BidirHirExpr.bool_lit(true))
        val annotated = BidirHirFunction.create("annotated", [], [], BidirOption.Some(BidirHirType.Bool), body)
        val unannotated = BidirHirFunction.create("unannotated", [], [], BidirOption.None_, body)
        val expected = BidirHirType.Function(params: [], ret: BidirHirType.Bool)
        val annotated_type = infer.infer_function(annotated)
        expect(infer.types_equal(annotated_type, expected)).to_equal(true)
        expect(infer.expected_return_type.is_none()).to_equal(true)
        val unannotated_type = infer.infer_function(unannotated)
        expect(infer.types_equal(unannotated_type, expected)).to_equal(true)
