# @tag: unit, compiler, hir, native-safe
# @cover src/compiler/20.hir/hir_lowering/_Expressions/block_and_asm_lowering.spl
use std.spec

extern fn rt_file_read_text(path: text) -> text

fn mode_from_args(args: [text], i: i64) -> text:
    if i >= args.len():
        ""
    elif args[i] == "--mode" and i + 1 < args.len():
        args[i + 1]
    elif args[i].starts_with("--mode="):
        args[i].substring(7)
    else:
        mode_from_args(args, i + 1)

describe "implicit recursive text if-chain tail":
    it "returns the empty-string base value":
        expect(mode_from_args([], 0)).to_equal("")

    it "returns split and joined option values":
        expect(mode_from_args(["--mode", "release"], 0)).to_equal("release")
        expect(mode_from_args(["prefix", "--mode=debug"], 0)).to_equal("debug")

    it "decodes guarded Expr tails without aggregate kind matching":
        val source = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Expressions/block_and_asm_lowering.spl") ?? ""
        val start = source.index_of("me lower_hir_block(b: Block)")
        val finish = source.index_of("me lower_hir_block_unit(b: Block)")
        val body = source[start:finish]
        expect(source).to_contain("extern fn rt_enum_payload(value: HirStmtKind) -> HirExpr")
        expect(body).to_contain("val expr: HirExpr = rt_enum_payload(lowered_scalar.kind)")
        expect(body).to_contain("val expr: HirExpr = rt_enum_payload(lowered.kind)")
        expect(body.contains("match lowered_scalar.kind")).to_equal(false)
        expect(body.contains("match lowered.kind")).to_equal(false)
