# @tag: unit, compiler, hir, native-safe
# Executable ABI parity: these constructions exist only in the test. Production
# classification never allocates exemplar enum payloads.
use std.spec.{describe, it, expect}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirPattern, HirPatternKind}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId}
use compiler.hir.hir_pattern_tags.*

extern fn rt_enum_discriminant(value: HirPatternKind) -> i64

val pattern_tag_span = Span.empty()
val pattern_tag_expr = HirExpr(
    kind: HirExprKind.IntLit(1, nil), type_: nil, span: pattern_tag_span)
val pattern_tag_type = HirType(kind: HirTypeKind.Int(64, true), span: pattern_tag_span)
val pattern_tag_symbol = SymbolId(id: 7)
val pattern_tag_child = HirPattern(
    kind: HirPatternKind.Wildcard, type_: nil, span: pattern_tag_span)

describe "HirPatternKind scalar ABI tags":
    it "matches every runtime discriminant":
        expect(rt_enum_discriminant(HirPatternKind.Wildcard)).to_equal(HIR_PATTERN_WILDCARD_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Literal(pattern_tag_expr))).to_equal(HIR_PATTERN_LITERAL_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Binding(pattern_tag_symbol, false))).to_equal(HIR_PATTERN_BINDING_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Tuple([pattern_tag_child]))).to_equal(HIR_PATTERN_TUPLE_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Array([pattern_tag_child], nil))).to_equal(HIR_PATTERN_ARRAY_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Struct(pattern_tag_type, [("field", pattern_tag_child)]))).to_equal(HIR_PATTERN_STRUCT_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Enum(pattern_tag_type, "Some", nil))).to_equal(HIR_PATTERN_ENUM_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Or([pattern_tag_child]))).to_equal(HIR_PATTERN_OR_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Range(pattern_tag_expr, pattern_tag_expr, true))).to_equal(HIR_PATTERN_RANGE_TAG)
        expect(rt_enum_discriminant(HirPatternKind.Error)).to_equal(HIR_PATTERN_ERROR_TAG)
        expect(rt_enum_discriminant(HirPatternKind.CompleteRegion("region"))).to_equal(HIR_PATTERN_COMPLETE_REGION_TAG)
        expect(rt_enum_discriminant(HirPatternKind.DynRegion("region"))).to_equal(HIR_PATTERN_DYN_REGION_TAG)
        expect(rt_enum_discriminant(HirPatternKind.TypeTest("i64", "value"))).to_equal(HIR_PATTERN_TYPE_TEST_TAG)
