# @tag: unit, compiler, hir, codec, source-contract
use std.spec.*
use std.io_runtime.{read_file_text}

fn receipt_source(path: text) -> text:
    read_file_text(path)

describe "HIR qualified receipt and expression codec source contract":
    it "keeps qualified expression receipts destination-only":
        val definitions = receipt_source("src/compiler/20.hir/hir_definitions.spl")
        expect(definitions).to_contain("Spawn(value: HirExpr)")
        expect(definitions).to_contain("DictComprehension(key: HirExpr, value: HirExpr, clauses: [HirCompClause])")
        expect(definitions).to_contain("ArrayLitSuffix(elements: [HirExpr], suffix: HirTensorSuffix)")
        expect(definitions).to_contain("KernelLaunch(kernel: HirExpr, grid: HirExpr, block: HirExpr, args: [HirCallArg])")
        expect(definitions).to_contain("GpuIntrinsic(kind: HirGpuIntrinsicKind, dimension: i64?, args: [HirExpr])")
        expect(definitions).not_to_contain("QualifiedNamedVar(")
        expect(definitions).not_to_contain("ResolvedField(")

    it "assigns lossless non-overlapping codec tags 58 through 62":
        val codec = receipt_source("src/compiler/20.hir/generated/hir_codec.spl")
        val names = ["Spawn", "DictComprehension", "ArrayLitSuffix", "KernelLaunch", "GpuIntrinsic"]
        var tag = 58
        for name in names:
            expect(codec).to_contain("case {name}(")
            expect(codec).to_contain("w.put_i64({tag})")
            expect(codec).to_contain("if tag == {tag}")
            tag = tag + 1
        expect(codec).to_contain("fn hc_enc_hir_tensor_suffix")
        expect(codec).to_contain("fn hc_dec_hir_tensor_suffix")
        expect(codec).to_contain("fn hc_enc_hir_gpu_intrinsic_kind")
        expect(codec).to_contain("fn hc_dec_hir_gpu_intrinsic_kind")
        expect(codec).not_to_contain("case QualifiedNamedVar(")
        expect(codec).not_to_contain("case ResolvedField(")
        expect(codec).not_to_contain("HirExprKind.QualifiedNamedVar(")
        expect(codec).not_to_contain("HirExprKind.ResolvedField(")

    it "covers every generated tree consumer losslessly":
        val paths = [
            "src/compiler/20.hir/generated/hir_children.spl",
            "src/compiler/20.hir/generated/hir_hash.spl",
            "src/compiler/20.hir/generated/hir_visit.spl",
            "src/compiler/20.hir/generated/hir_visitor.spl"
        ]
        val names = ["Spawn(", "DictComprehension(", "ArrayLitSuffix(", "KernelLaunch(", "GpuIntrinsic("]
        for path in paths:
            val source = receipt_source(path)
            for name in names: expect(source).to_contain(name)

    it "preserves weak and atomic ownership in canonical and destination schemas":
        val canonical = receipt_source("src/compiler/20.hir/hir_types.spl")
        val lowering = receipt_source("src/compiler/20.hir/hir_lowering/types.spl")
        val destination = receipt_source("src/compiler/20.hir/hir_lowering/hir_destination_types_patterns.spl")
        val equality = receipt_source("src/compiler/20.hir/hir_lowering/type_equality.spl")
        val codec = receipt_source("src/compiler/20.hir/generated/hir_codec.spl")
        val mir_types = receipt_source("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        val mir_ownership = receipt_source("src/compiler/50.mir/mir_lowering_stmts.spl")
        val mono_subst = receipt_source("src/compiler/40.mono/monomorphize/type_subst.spl")
        val mono_key = receipt_source("src/compiler/40.mono/monomorphize/mono_key.spl")
        val mono_integration = receipt_source("src/compiler/40.mono/monomorphize_integration.spl")
        val mono_verify = receipt_source("src/compiler/40.mono/verify/post_mono_verify.spl")
        val driver_types = receipt_source("src/compiler/80.driver/driver_types.spl")
        expect(canonical).to_contain("Weak(inner: HirType)")
        expect(canonical).to_contain("Atomic(inner: HirType)")
        expect(canonical).to_contain("QualifiedDynTrait(defining_module: i64, trait_: SymbolId)")
        expect(lowering).to_contain("kind = HirTypeKind.Atomic(self.lower_type(ainner))")
        expect(equality).to_contain("case (Weak(inner_a), Weak(inner_b)):")
        expect(equality).to_contain("case (Atomic(inner_a), Atomic(inner_b)):")
        expect(codec).to_contain("case Weak(b_inner):")
        expect(codec).to_contain("w.put_i64(27)")
        expect(codec).to_contain("if tag == 27: return HirTypeKind.Weak(hc_dec_hir_type(r))")
        expect(codec).to_contain("case Atomic(b_inner):")
        expect(codec).to_contain("w.put_i64(28)")
        expect(codec).to_contain("if tag == 28: return HirTypeKind.Atomic(hc_dec_hir_type(r))")
        expect(destination).to_contain("HD_TYPE_WEAK, child, false")
        expect(destination).to_contain("write_type_atomic(i: i64, child: i64)")
        expect(destination).to_contain("HD_TYPE_ATOMIC")
        expect(destination).to_contain("write_type_qualified_dyn_trait(i: i64, defining_module: i64, symbol: i64)")
        expect(mir_types).to_contain("E-MIR-TYPE-Atomic: atomic ownership requires exact atomic retain/release MIR operations; wrapper erasure is unsafe")
        expect(mir_types).to_contain("case HirTypeKind.Weak(inner):")
        expect(mir_types).to_contain("excluded from resource_owned_locals and from pending Drop")
        expect(mir_ownership).to_contain("case HirTypeKind.Isolated(inner):")
        expect(mir_ownership).to_contain("`-R` remains a distinct")
        expect(mir_ownership).to_contain("non-owning weak capability and is not admitted by this predicate")
        expect(mono_subst).to_contain("HirTypeKind.Weak(substitute_type(inner, subst))")
        expect(mono_key).to_contain("weak<{canonical_type_id_of_hir(inner)}>")
        expect(mono_integration).to_contain("case Weak(inner): 1 + hir_type_depth(inner)")
        expect(mono_integration).to_contain("case Weak(inner): hir_type_is_concrete(inner)")
        expect(mono_integration).to_contain("case Weak(inner): \"weak_{hir_type_key(inner)}\"")
        expect(mono_integration).to_contain("case Weak(pi):")
        expect(mono_integration).to_contain("case Weak(ai): bind_type_params(pi, ai, bindings)")
        expect(mono_verify).to_contain("case HirTypeKind.Weak(inner): self.walk_type(inner)")
        expect(driver_types).to_contain("case Weak(inner): \"weak:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}\"")
        expect(lowering).not_to_contain("# Infer / Atomic / Error")

    it "requires exact module-qualified destination receipts":
        val payloads = receipt_source("src/compiler/20.hir/hir_lowering/hir_destination_expr_payloads.spl")
        val hot = receipt_source("src/compiler/20.hir/hir_lowering/hir_destination_expr_hot.spl")
        val writer = receipt_source("src/compiler/20.hir/hir_lowering/hir_destination_registry_writer.spl")
        val reader = receipt_source("src/compiler/20.hir/hir_lowering/hir_destination_registry_reader.spl")
        expect(hot).to_contain("write_qualified_named_var")
        expect(payloads).to_contain("write_resolved_field")
        expect(payloads).to_contain("write_qualified_method_resolution")
        expect(payloads).to_contain("self.module_generation[defining_module] != self.generation")
        expect(writer).to_contain("hdw_qualified_named_var")
        expect(writer).to_contain("hdw_resolved_field")
        expect(writer).to_contain("hdw_qualified_method_resolution")
        expect(reader).to_contain("hdr_expr_defining_module")
        expect(reader).to_contain("hdr_method_resolution_defining_module")
        expect(writer).to_contain("hdw_type_qualified_dyn_trait")
        expect(reader).to_contain("hdr_type_qualified_dyn_trait_module")

    it "never reinterprets qualified method symbols in requester authority":
        val resolve = receipt_source("src/compiler/35.semantics/resolve.spl")
        val inference = receipt_source("src/compiler/30.types/type_infer/inference_expr_calls.spl")
        val mir = receipt_source("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
        val calls = receipt_source("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")
        val interpreter = receipt_source("src/compiler/70.backend/backend/interpreter_expr.spl")
        for name in ["QualifiedInstanceMethod", "QualifiedTraitMethod", "QualifiedFreeFunction", "QualifiedStaticMethod"]:
            expect(resolve).to_contain("case {name}(")
            expect(inference).to_contain("case {name}(")
            expect(mir).to_contain("case MethodResolution.{name}(")
            expect(interpreter).to_contain("case MethodResolution.{name}(")
        expect(resolve).to_contain("val resolved_method_module: i64?")
        expect(resolve).to_contain("case Some(_): fallback_type")
        expect(calls).to_contain("fn mir_flat_resolution_symbol")
        expect(mir).to_contain("reject_qualified_method_resolution")
