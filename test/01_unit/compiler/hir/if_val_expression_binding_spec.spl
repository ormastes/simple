"""
## Purpose and audience
Purpose: Prove that if val binding in expression position.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-HIR-001 — stable requirement identity for this spec.

# Regression: `if val PAT = subject: a else: b` used as an EXPRESSION must bind.
#
# Bug: doc/08_tracking/bug/if_val_expression_binding_lost_hir_2026-08-01.md
#
# The AST node `Expr::If` carries a `let_pattern` field. The HIR lowering
# dispatcher matched it with `..` and dropped that field on the floor, so
# `lower_if` never registered the bound name as a local. Under `lenient_types`
# (which bootstrap builds enable) the now-unresolved name silently became
# `HirExprKind::Global`, which lowers to `MirInst::GlobalLoad` and finally dies
# in LLVM codegen with:
#
#     llvm global load referenced undeclared symbol `interp_list`
#
# That aborted the stage4 build on
# src/compiler/20.hir/hir_lowering/module_surface.spl.
#
# The STATEMENT form (`if val x = e:` on its own line with an indented block)
# was always handled correctly, which is why this hid for so long -- only the
# value/expression position was broken.
#
# The wrong-answer half matters more than the build break: before the fix the
# JIT did not error at all, it read a non-existent global and returned garbage
# (`-93` for every branch). Any spec that exercises this through the JIT would
# have caught it, so this file exists to keep that path pinned.

use std.spec.*

# Tail-expression position: the shape that appears in module_surface.spl.
fn pick(xs: [i64]?) -> i64:
    if val v = xs: v.len() * 100 + 7 else: -42

# Assigned-to-a-val position.
fn pick_assigned(xs: [i64]?) -> i64:
    val r = if val v = xs: v.len() * 100 + 7 else: -42
    r

# The exact predicate module_surface.spl computes: an interpolated string
# literal carries sub-expressions, so it is NOT a constant leaf.
fn is_leaf(interps: [i64]?) -> bool:
    if val interp_list = interps: interp_list.len() == 0 else: true

describe "if val binding in expression position":

    it "binds and unwraps the payload in the then-arm":
        step("Verify: binds and unwraps the payload in the then-arm")
        # @req: REQ-COMPILER-HIR-001
        expect(pick([1, 2, 3])).to_equal(307)  # oracle: 307 — named expected value from the requirement
        expect(pick_assigned([1, 2, 3])).to_equal(307)  # oracle: 307 — named expected value from the requirement

    it "takes the else-arm when the subject is absent":
        step("Verify: takes the else-arm when the subject is absent")
        expect(pick(nil)).to_equal(-42)  # oracle: -42 — named expected value from the requirement
        expect(pick_assigned(nil)).to_equal(-42)  # oracle: -42 — named expected value from the requirement

    it "does not collapse both arms to one garbage value":
        step("Verify: does not collapse both arms to one garbage value")
        # The pre-fix defect returned the SAME wrong number for present and
        # absent subjects, so assert the two arms actually differ.
        expect(pick([1, 2, 3]) == pick(nil)).to_equal(false)

    it "computes the module_surface const-leaf predicate correctly":
        step("Verify: computes the module_surface const-leaf predicate correctly")
        # No interpolation list at all -> a plain literal -> a leaf.
        expect(is_leaf(nil)).to_equal(true)
        # An empty interpolation list is still a leaf.
        expect(is_leaf([])).to_equal(true)
        # A non-empty interpolation list is NOT a leaf.
        expect(is_leaf([1, 2])).to_equal(false)
