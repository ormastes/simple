"""
## Purpose and audience
Regression specification for
doc/08_tracking/bug/seed_match_some_on_plain_i64_binds_wrong_value_2026_11_12.md.
Written for compiler engineers who own HIR pattern lowering: a `Some(j)`
pattern over a bare `i64` / `text` scrutinee must bind the scrutinee itself
(flat Option encoding), the same value the interpreter and `if val` bind.

## Operator workflow
Run `bin/simple test test/01_unit/compiler/hir/match_some_on_plain_i64_binds_subject_spec.spl`.

## Compatibility and limitations
Covers the statement form (`match` arm assigning a local) and the expression
form (`val x = match ...`). A plain `i64` is never nil, so the `nil` arm is
never selected for it; that is asserted rather than assumed.

## Verification guidance and troubleshooting
Before the fix the compiled lane bound the nil sentinel (`a = 3`, `j = nil`).
If a scenario fails again, inspect `build_pattern_binding_stmts` in
src/compiler_rust/compiler/src/hir/lower/stmt_lowering.rs.
"""

# @manual_section: match Some over a non-Option scrutinee
use std.spec.step
use app.io.mod (shell)

fn bind_stmt_form(r: i64) -> i64:
    var a = -1
    match r:
        Some(j): a = j
        nil: a = -2
    a

fn bind_block_form(r: i64) -> i64:
    var b = -1
    match r:
        Some(j):
            b = j + 100
        nil:
            b = -2
    b

fn bind_expr_form(r: i64) -> i64:
    val v = match r:
        Some(j): j * 2
        nil: -2
    v

fn bind_text_form(s: text) -> text:
    var out = "unset"
    match s:
        Some(t): out = t
        nil: out = "nil"
    out

describe "match Some(j) over a plain i64 scrutinee":

    it "binds the index_of result from the bug repro":
        # @req BUG-SEED-MATCH-SOME-I64-001
        step("Match the i64 returned by text.index_of with Some(j)")
        val json = "{{\"value\":\"alpha\"}}"
        val r = json.index_of("\"value\":")
        expect(r).to_equal(1)
        expect(bind_stmt_form(r)).to_equal(1)

    it "binds the subject value in a block-bodied arm":
        # @req BUG-SEED-MATCH-SOME-I64-001
        step("Bind j in a multi-line arm and use it in arithmetic")
        expect(bind_block_form(7)).to_equal(107)
        expect(bind_block_form(0)).to_equal(100)

    it "binds a negative miss value instead of taking the nil arm":
        # @req BUG-SEED-MATCH-SOME-I64-001
        step("A plain i64 -1 is not nil, so Some(j) binds -1")
        expect(bind_stmt_form(-1)).to_equal(-1)

    it "binds the subject in the expression form":
        # @req BUG-SEED-MATCH-SOME-I64-001
        step("Use Some(j) inside val v = match r")
        expect(bind_expr_form(21)).to_equal(42)

    it "binds the subject for a text scrutinee":
        # @req BUG-SEED-MATCH-SOME-I64-001
        step("Match a plain text value with Some(t)")
        expect(bind_text_form("alpha")).to_equal("alpha")

describe "match Some(j) over a plain i64 in the default compiled engine":

    it "prints the bound index, not the nil sentinel":
        # @req BUG-SEED-MATCH-SOME-I64-001
        step("Run the bug repro through `simple run` (HIR -> MIR -> JIT lane)")
        val cmd = "if [ -x bin/simple.exe ]; then S=bin/simple.exe; else S=bin/simple; fi; SIMPLE_RUST_SEED_WARNING=0 $S run test/01_unit/compiler/hir/fixtures/match_some_i64_repro.spl 2>&1"
        val result = shell(cmd)
        val out = result.stdout
        expect(result.exit_code).to_equal(0)
        expect(out).to_contain("r=1")
        expect(out).to_contain("a=1")
        expect(out).to_contain("b=1")
