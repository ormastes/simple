use std.spec.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_types.{HirTypeKind}
use compiler.frontend.parser_types.{ParserTypeParam}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.common.diagnostics.span.{Span}

describe "HIR generic default presence":
    it "does not lower an absent inference sentinel as a default":
        val span = Span.new(0, 0, 0, 0)
        var lowering = HirLowering.new()
        val lowered = lowering.lower_type_param(ParserTypeParam(
            name: "T", bounds: [], has_default: false,
            default: Type(kind: TypeKind.Infer, span: span), span: span))
        expect(lowered.has_default).to_be(false)
        val inactive_is_unit = match lowered.default.kind:
            case Unit: true
            case _: false
        expect(inactive_is_unit).to_be(true)

    it "preserves a present default and a following absent parameter":
        val span = Span.new(0, 0, 0, 0)
        var lowering = HirLowering.new()
        val present = lowering.lower_type_param(ParserTypeParam(
            name: "T", bounds: [], has_default: true,
            default: Type(kind: TypeKind.Named("i64", []), span: span), span: span))
        val absent = lowering.lower_type_param(ParserTypeParam(
            name: "U", bounds: [], has_default: false,
            default: Type(kind: TypeKind.Named("text", []), span: span), span: span))
        expect(present.has_default).to_be(true)
        val default_is_i64 = match present.default.kind:
            case Int(bits, signed): bits == 64 and signed
            case _: false
        expect(default_is_i64).to_be(true)
        expect(absent.has_default).to_be(false)
        expect(present.name).to_equal("T")
        expect(absent.name).to_equal("U")
