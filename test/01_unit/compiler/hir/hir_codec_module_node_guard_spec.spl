# @req REQ-SSPEC-COMPILER
"""
Purpose: a freshly lowered HirModule must pass the generated encoder's node
guard, so a canonical module is stored and only a genuinely unencodable
payload is refused (with its reason named).

Phase 3 (2026-10-19, core-c-bootstrap lane, Windows) refused EVERY module:
`[hir-cache] stores=0 refused=1351 reason=codec`, and
SIMPLE_HIR_CODEC_ROUNDTRIP=1 named the reason
`unregistered HirModule node`. The standalone Core-C public
`rt_heap_ref_registered` consulted only the C immortal registry, while AOT
lowering allocates structs as raw, never-registered rt_alloc blocks. The
Rust provider had already become a formation-only probe; the C lane now
mirrors it (runtime_native.c, pinned natively by
src/runtime/test/rt_heap_ref_wellformed_selfcheck.c).

The interpreter lane uses the Rust provider, so these examples pin the
contract for every lane that runs them; the native red/green is the C
selfcheck plus the producer repro recorded in the PR.
"""

use std.spec.*
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_encode_reason}

fn lower(src: text) -> HirModule:
    val parsed = parse_full_frontend(src, "spec.spl", "spec", Logger(level: 0))
    var hl = HirLowering.with_filename("spec.spl")
    hl.lower_module(parsed)

val HELLO = "fn main() -> i64:\n    print \"hello\"\n    0\n"

describe "HIR codec module node guard":
    it "encodes a lowered hello-world module with no refusal reason":
        step("The top-level HirModule passes the encoder node guard")
        val hm = lower(HELLO)
        expect(hir_module_encode_reason(hm)).to_equal("")
        expect(hir_module_encode(hm).len()).to_be_greater_than(0)
