use std.spec.{describe, it, expect}
use compiler.hir.hir_owner_name.{hir_symbol_owner_module}
use compiler.hir.hir_types.{SymbolTable, SymbolId}

describe "HIR canonical owner fast path":
    it "preserves canonical names and folds aliases and numeric tiers":
        expect(hir_symbol_owner_module("compiler.hir.hir_types")).to_equal("compiler.hir.hir_types")
        expect(hir_symbol_owner_module("_Owner9._field2")).to_equal("_Owner9._field2")
        expect(hir_symbol_owner_module("std.text")).to_equal("lib.text")
        expect(hir_symbol_owner_module("owner.123.Type")).to_equal("owner.Type")
        expect(hir_symbol_owner_module("owner.spl")).to_equal("owner")
        expect(hir_symbol_owner_module("owner.sdn")).to_equal("owner")

    it "keeps qualified hit miss and first binding across owner spellings":
        var symbols = SymbolTable.new()
        symbols.bind_qualified_type("src/compiler/20.hir/hir_types.spl", "Item", SymbolId(id: 0))
        symbols.bind_qualified_type("compiler.hir.hir_types", "Item", SymbolId(id: 9))
        expect(symbols.lookup_qualified_type_raw("compiler.hir.hir_types", "Item")).to_equal(0)
        expect(symbols.lookup_qualified_type_raw("./src/compiler/20.hir/hir_types.spl", "Item")).to_equal(0)
        expect(symbols.lookup_qualified_type_raw("compiler.hir.hir_types", "Missing")).to_equal(-1)
        expect(symbols.lookup_qualified_type_raw("compiler.hir.other", "Item")).to_equal(-1)
        symbols.reset_module()
        expect(symbols.lookup_qualified_type_raw("compiler.hir.hir_types", "Item")).to_equal(-1)

    it "unifies the loader core alias with its physical declaration owner":
        val canonical = "compiler.frontend.core.types"
        expect(hir_symbol_owner_module("compiler.core.types")).to_equal(canonical)
        expect(hir_symbol_owner_module("compiler.frontend.core.types")).to_equal(canonical)
        expect(hir_symbol_owner_module("src/compiler/10.frontend/core/types.spl")).to_equal(canonical)
        var symbols = SymbolTable.new()
        symbols.bind_qualified_type("compiler.core.types", "FlatPoolState", SymbolId(id: 17))
        expect(symbols.lookup_qualified_type_raw(canonical, "FlatPoolState")).to_equal(17)
        expect(symbols.lookup_qualified_type_raw("compiler.frontend.core.other", "FlatPoolState")).to_equal(-1)
        expect(hir_symbol_owner_module("other.compiler.core.types")).to_equal("other.compiler.core.types")
        expect(hir_symbol_owner_module("compiler.core_extra.types")).to_equal("compiler.core_extra.types")
