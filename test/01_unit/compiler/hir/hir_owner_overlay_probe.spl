# Exact compiler/core source roots outrank the numbered compatibility route.
# This probes owner normalization, not filesystem resolution or full RTI.
use compiler.hir.hir_owner_name.{hir_symbol_owner_module}

fn main() -> i64:
    val logical_overlay = hir_symbol_owner_module("compiler.core.overlay")
    val physical_overlay = hir_symbol_owner_module("src/compiler/core/overlay.spl")
    val logical_frontend = hir_symbol_owner_module("compiler.frontend.core.overlay")
    val physical_frontend = hir_symbol_owner_module("src/compiler/10.frontend/core/overlay.spl")
    print "overlay logical={logical_overlay} physical={physical_overlay} frontend={physical_frontend}"
    if logical_overlay != "compiler.core.overlay": return 1
    if physical_overlay != logical_overlay: return 2
    if logical_frontend != "compiler.frontend.core.overlay": return 3
    if physical_frontend != logical_frontend: return 4
    if logical_overlay == logical_frontend: return 5
    if hir_symbol_owner_module("std.text") != "lib.text": return 6
    if hir_symbol_owner_module("compiler.corex.overlay") != "compiler.corex.overlay": return 7
    print "HIR owner overlay probe PASS checks=7"
    0
