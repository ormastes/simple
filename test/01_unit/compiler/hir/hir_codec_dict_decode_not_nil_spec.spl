# Guards e606125a541 by behaviour: every module.functions dict entry decoded
# from the HIR cache is a real HirFunction stored under its own key. Storing
# the decoded optional instead left nil values after a cache-hit decode
# (stage2 p2_add SIGSEGV). Twin: hir_codec_dict_decode_roundtrip_spec.spl.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode}

val FIVE_FUNCTIONS = "fn a1() -> i64:\n    1\nfn a2() -> i64:\n    2\nfn a3() -> i64:\n    3\nfn a4() -> i64:\n    4\nfn a5() -> i64:\n    5\n"

fn lowered(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "dict_decode_many.spl", "dict_decode_many", Logger(level: 0))
    var lowering = HirLowering.with_filename("dict_decode_many.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    module

describe "HIR codec decode stores present dict values":
    it "keeps every decoded function non-nil and under its original key":
        val original = lowered(FIVE_FUNCTIONS)
        val decoded = hir_module_decode(hir_module_encode(original)).unwrap()
        expect(decoded.functions.len()).to_equal(5)
        for key in original.functions.keys():
            val function: HirFunction = decoded.functions[key]
            expect(function != nil).to_equal(true)
            expect(function.name).to_equal(original.functions[key].name)

    it "decodes the same functions after a second cache round trip":
        val once = hir_module_decode(hir_module_encode(lowered(FIVE_FUNCTIONS))).unwrap()
        val twice = hir_module_decode(hir_module_encode(once)).unwrap()
        expect(twice.functions.len()).to_equal(5)
        for key in once.functions.keys():
            expect(twice.functions[key].name).to_equal(once.functions[key].name)
