# @cover src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl 5%
# @cover src/compiler/20.hir/hir_types.spl 5%
"""
# HIR symbol table: all top-level functions resolve, including when interleaved
# with other declaration kinds (lane HIR1 symbol-table-all-functions)

**Category:** Compiler / HIR
**Lane:** HIR1 symbol-table-all-functions

## Overview

Filed bug `doc/08_tracking/bug/hir_symbol_table_only_records_first_function_2026-07-28.md`
claimed the HIR module symbol table records only the FIRST top-level function
per module. Lane SYM1 traced the full path
(`declare_module_symbols` in `module_lowering.spl:1690-1709`,
`SymbolTable.define`/`lookup` in `hir_types.spl:219-309`) and found it
structurally correct on HEAD as of 2026-07-29: `declare_module_symbols` walks
`module.functions.keys()` in a `while` loop and calls `self.symbols.define(...)`
once per function; `define` only first-write-wins for Class/Struct/Enum/Trait
kinds, never for `SymbolKind.Function`, so every function gets its own new
symbol id. A 3-function guard spec already lives at
`test/01_unit/compiler/hir/hir_symbol_table_all_functions_spec.spl` (1/1
green).

This spec adds the two scenarios HIR1 was asked to cover that the existing
guard does not:

(b) top-level functions interleaved with a struct, a class, and an enum
    between them -- confirms the per-kind declaration passes in
    `declare_module_symbols` (classes/structs/enums declared before functions,
    all keyed by their own dict) don't disturb function registration order or
    identity.

(c) `extern fn` mixed with an ordinary `fn` -- the parser stores externs in
    `Module.functions` with `is_extern=true` (see the comment at
    `module_lowering.spl:84-88`), so they go through the exact same
    `declare_module_symbols` loop as regular functions.

## Harness note

Per the enum-match-diagnostic lane's discriminated finding (2026-07-29): the
parse -> HIR pipeline is inlined in each `it` block ON PURPOSE. Running the
identical code inside a shared module-level helper fn loses recorded state on
this interpreter (struct-mutation-visibility family). Do not refactor this
into a shared helper.

`Option.?` yields the PAYLOAD on this interpreter, not a bool -- use
`match`/`if val`, never `expect(x.?)...`.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*

fn make_logger() -> Logger:
    Logger(level: 0)

describe "HIR module symbol table resolves every top-level function regardless of what is interleaved":
    it "resolves all three functions when a struct, a class, and an enum sit between them":
        val src = "fn first_fn() -> i64:\n" +
            "    1\n" +
            "struct Point:\n" +
            "    x: i64\n" +
            "    y: i64\n" +
            "fn second_fn() -> i64:\n" +
            "    2\n" +
            "class Counter:\n" +
            "    n: i64\n" +
            "fn third_fn() -> i64:\n" +
            "    3\n" +
            "enum Color:\n" +
            "    Red\n" +
            "    Green\n"
        val path = "src/hir_symbol_table_interleaved_fixture.spl"
        val log = make_logger()
        val module = parse_full_frontend(src, path, "hir_symbol_table_interleaved_fixture", log)
        var lowering = HirLowering.with_filename(path)
        val hir = lowering.lower_module(module)

        match hir.symbols.lookup("first_fn"):
            case Some(first_id):
                expect(hir.functions.contains_key(first_id)).to_equal(true)
            case nil:
                expect(false).to_equal(true)

        match hir.symbols.lookup("second_fn"):
            case Some(second_id):
                expect(hir.functions.contains_key(second_id)).to_equal(true)
            case nil:
                expect(false).to_equal(true)

        match hir.symbols.lookup("third_fn"):
            case Some(third_id):
                expect(hir.functions.contains_key(third_id)).to_equal(true)
            case nil:
                expect(false).to_equal(true)

        # Interleaved declarations resolve too (own dicts, own SymbolKind).
        expect(hir.symbols.lookup("Point") != nil).to_equal(true)
        expect(hir.symbols.lookup("Counter") != nil).to_equal(true)
        expect(hir.symbols.lookup("Color") != nil).to_equal(true)

    it "resolves the ordinary fn when an extern fn precedes it in the same module":
        # `extern fn` is stored in Module.functions with is_extern=true (see
        # module_lowering.spl:84-88), so it walks the identical
        # declare_module_symbols loop as a regular fn. This scenario is
        # DISTINCT from the run_vs_test_harness_divergence_2026-07-28 gap
        # (that gap is about the target PROGRAM's JIT-vs-interpreter
        # execution engine, not about HIR symbol-table registration, which
        # runs identically under both `run` and `test`). No divergence was
        # observed here; both symbols resolve.
        val src = "extern fn rt_symbol_table_probe_extern(key: text) -> text\n" +
            "fn normal_fn() -> i64:\n" +
            "    7\n"
        val path = "src/hir_symbol_table_extern_fixture.spl"
        val log = make_logger()
        val module = parse_full_frontend(src, path, "hir_symbol_table_extern_fixture", log)
        var lowering = HirLowering.with_filename(path)
        val hir = lowering.lower_module(module)

        match hir.symbols.lookup("normal_fn"):
            case Some(normal_id):
                expect(hir.functions.contains_key(normal_id)).to_equal(true)
            case nil:
                expect(false).to_equal(true)

        expect(hir.symbols.lookup("rt_symbol_table_probe_extern") != nil).to_equal(true)
