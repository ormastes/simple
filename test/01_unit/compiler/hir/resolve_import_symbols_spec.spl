"""
# Resolve Import Symbols Unit Spec

Verifies that explicit, glob, and aliased imports register symbols from the
requested source module even when another loaded module exports the same name.
"""

use compiler.hir.hir_lowering.types.{HirLowering, HirModulesByName, hir_package_sibling_index}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.{SymbolKind}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}

fn make_logger() -> Logger:
    Logger(level: 0)

describe "resolve_import_symbols 2-pass import resolver":
    """The import pre-pass must preserve module identity before HIR lowering resolves symbol uses."""
    it "registers an explicitly imported public function":
        val log = make_logger()
        val provider = parse_full_frontend("pub fn answer() -> i64:\n    42", "provider", "provider", log)
        val consumer = parse_full_frontend("use provider.{answer}\nfn main() -> i64:\n    if answer() == 42: 0 else: 1", "consumer_fn", "consumer_fn", log)
        var modules: Dict<text, any> = {}
        modules["provider"] = provider
        var lowering = HirLowering.with_filename("consumer_fn")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)
        expect(hir.symbols.lookup("answer").?).to_equal(true)

    it "resolves package sibling names without eagerly registering unused declarations":
        val log = make_logger()
        val provider = parse_full_frontend("pub struct Box:\n    value: i64\npub fn answer() -> i64:\n    42\npub fn unused() -> i64:\n    0", "pkg.types", "pkg.types", log)
        val nested = parse_full_frontend("pub fn nested_only() -> i64:\n    7", "pkg.nested.shadow", "pkg.nested.shadow", log)
        val consumer = parse_full_frontend("fn pass(box: Box) -> Box:\n    box\nfn main() -> i64:\n    answer()", "pkg.consumer", "pkg.consumer", log)
        var modules: HirModulesByName = {}
        modules["pkg.types"] = provider
        modules["pkg.nested.shadow"] = nested
        modules["pkg.consumer"] = consumer
        val sibling_index = hir_package_sibling_index(modules)
        expect(sibling_index["pkg"].len()).to_equal(2)
        expect(sibling_index["pkg.nested"].len()).to_equal(1)
        var lowering = HirLowering.with_filename("pkg.consumer")
        lowering.modules_by_name = modules
        lowering.package_sibling_index = sibling_index
        val hir = lowering.lower_module(consumer)

        expect(lowering.errors.len()).to_equal(0)
        expect(hir.symbols.lookup("Box").?).to_equal(true)
        expect(hir.symbols.lookup("answer").?).to_equal(true)
        expect(hir.symbols.lookup("unused").?).to_equal(false)
        expect(hir.symbols.lookup("nested_only").?).to_equal(false)

    it "named import from module A wins over same-named symbol from module B":
        val log = make_logger()

        # Module A: CompileOptions has only_in_a (unique sentinel field)
        val src_a = "struct CompileOptions:\n    input_files: [text]\n    only_in_a: i64"
        val path_a = "a"
        val module_a = parse_full_frontend(src_a, path_a, path_a, log)

        # Module B: CompileOptions has only_in_b (unique sentinel field)
        val src_b = "struct CompileOptions:\n    mode: text\n    only_in_b: i64"
        val path_b = "b"
        val module_b = parse_full_frontend(src_b, path_b, path_b, log)

        # Consumer: explicitly imports CompileOptions from module A
        val open = "{"
        val close = "}"
        val src_consumer = "use a." + open + "CompileOptions" + close
        val path_consumer = "consumer"
        val module_consumer = parse_full_frontend(src_consumer, path_consumer, path_consumer, log)

        # Wire up modules map — both modules available to resolve_import_symbols
        var modules_map: Dict<text, any> = {}
        modules_map[path_a] = module_a
        modules_map[path_b] = module_b

        # Lower the consumer with modules_by_name set
        # resolve_import_symbols must pre-register A's CompileOptions first
        var lowering = HirLowering.with_filename(path_consumer)
        lowering.modules_by_name = modules_map
        val hir_consumer = lowering.lower_module(module_consumer)

        # CompileOptions must resolve to the entry registered from module A
        val resolved_id = hir_consumer.symbols.lookup("CompileOptions")
        expect(resolved_id.?).to_equal(true)

        val sym = hir_consumer.symbols.get_symbol(resolved_id)
        expect(sym.?).to_equal(true)
        expect(sym.unwrap().defining_module.?).to_equal(true)
        # Must resolve to module A (the explicit import target), not B
        expect(sym.unwrap().defining_module.unwrap()).to_equal(path_a)

    it "glob import pre-registers all type symbols from imported module":
        val log = make_logger()

        # Library module with two types
        val src_lib = "struct Foo:\n    x: i64\nstruct Bar:\n    y: text"
        val path_lib = "mylib"
        val module_lib = parse_full_frontend(src_lib, path_lib, path_lib, log)

        # Consumer uses glob import
        val src_consumer2 = "use mylib.*"
        val path_consumer2 = "consumer2"
        val module_consumer2 = parse_full_frontend(src_consumer2, path_consumer2, path_consumer2, log)

        var modules_map2: Dict<text, any> = {}
        modules_map2[path_lib] = module_lib

        var lowering2 = HirLowering.with_filename(path_consumer2)
        lowering2.modules_by_name = modules_map2
        val hir2 = lowering2.lower_module(module_consumer2)

        # Both Foo and Bar must be resolvable in the consumer's symbol table
        val foo_id = hir2.symbols.lookup("Foo")
        val bar_id = hir2.symbols.lookup("Bar")
        expect(foo_id.?).to_equal(true)
        expect(bar_id.?).to_equal(true)

    it "glob import follows a facade's named re-exports":
        val log = make_logger()
        val inner = parse_full_frontend("struct InnerType:\n    value: i64\npub fn inner_fn() -> i64:\n    42", "pkg.inner", "pkg.inner", log)
        val facade = parse_full_frontend("use pkg.inner.*\nexport InnerType, inner_fn", "pkg.facade", "pkg.facade", log)
        val consumer = parse_full_frontend("use pkg.facade.*\nfn main() -> i64:\n    inner_fn()", "consumer_facade", "consumer_facade", log)
        var modules: Dict<text, any> = {}
        modules["pkg.inner"] = inner
        modules["pkg.facade"] = facade
        var lowering = HirLowering.with_filename("consumer_facade")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("InnerType").?).to_equal(true)
        expect(hir.symbols.lookup("inner_fn").?).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "follows an aliased compatibility re-export to its defining class":
        val log = make_logger()
        val provider = parse_full_frontend("class AccessResult:\n    value: text", "shared.access", "shared.access", log)
        val facade = parse_full_frontend("export use shared.access.{AccessResult as T32BridgeResult}", "compat.types", "compat.types", log)
        val consumer = parse_full_frontend("use compat.types.{T32BridgeResult}\nfn main(value: T32BridgeResult) -> T32BridgeResult:\n    value", "compat.consumer", "compat.consumer", log)
        var modules: Dict<text, any> = {}
        modules["shared.access"] = provider
        modules["compat.types"] = facade
        var lowering = HirLowering.with_filename("compat.consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("T32BridgeResult").?).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "binds the mutable me receiver in a prefixed class method":
        val log = make_logger()
        val module = parse_full_frontend("class Box:\n    value: i64\n    me set(next: i64) -> i64:\n        me.value = next\n        me.value", "me_receiver", "me_receiver", log)
        var lowering = HirLowering.with_filename("me_receiver")
        val hir = lowering.lower_module(module)

        expect(lowering.errors.len()).to_equal(0)

    it "glob import traverses a facade star import":
        val log = make_logger()
        val leaf = parse_full_frontend("struct FacadeType:\n    value: i64\npub fn facade_answer() -> i64:\n    42", "leaf", "leaf", log)
        val facade = parse_full_frontend("use leaf.*", "facade", "facade", log)
        val consumer = parse_full_frontend("use facade.*", "facade_consumer", "facade_consumer", log)
        var modules: Dict<text, any> = {}
        modules["leaf"] = leaf
        modules["facade"] = facade
        var lowering = HirLowering.with_filename("facade_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("FacadeType").?).to_equal(true)
        expect(hir.symbols.lookup("facade_answer").?).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "named import resolves through a dotted bare child glob export":
        val log = make_logger()
        val child = parse_full_frontend("pub fn child_answer() -> i64:\n    42", "pkg.nested.child", "pkg.nested.child", log)
        val facade = parse_full_frontend("export nested.child.*", "pkg.__init__", "pkg.__init__", log)
        val consumer = parse_full_frontend("use pkg." + "{" + "child_answer" + "}", "export_consumer", "export_consumer", log)
        var modules: Dict<text, any> = {}
        modules["pkg.__init__"] = facade
        modules["pkg.nested.child"] = child
        var lowering = HirLowering.with_filename("export_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("child_answer").?).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "resolves a sibling export from a non-init facade":
        val log = make_logger()
        val sibling = parse_full_frontend("pub fn sibling_answer() -> i64:\n    42", "pkg.args", "pkg.args", log)
        val facade = parse_full_frontend("export args.*", "pkg.mod", "pkg.mod", log)
        val consumer = parse_full_frontend("use pkg.mod.{sibling_answer}", "sibling_consumer", "sibling_consumer", log)
        var modules: Dict<text, any> = {}
        modules["pkg.args"] = sibling
        modules["pkg.mod"] = facade
        var lowering = HirLowering.with_filename("sibling_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("sibling_answer").?).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "aliased trait import lowers defaults with the local symbol":
        val log = make_logger()
        val provider = parse_full_frontend("trait Greeter:\n    fn greet(self) -> i64:\n        42", "trait_provider", "trait_provider", log)
        val consumer = parse_full_frontend("use trait_provider." + "{" + "Greeter as G" + "}", "trait_consumer", "trait_consumer", log)
        var modules: Dict<text, any> = {}
        modules["trait_provider"] = provider
        var lowering = HirLowering.with_filename("trait_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("G").?).to_equal(true)
        expect(lowering.lowered_traits.contains_key("G")).to_equal(true)
        val trait_hir = lowering.lowered_traits["G"]
        expect(trait_hir.defaults.len()).to_equal(1)
        expect(trait_hir.defaults[0].name).to_equal("greet")
        expect(lowering.errors.len()).to_equal(0)

    it "keeps an alias distinct after an unaliased trait collision":
        val log = make_logger()
        val left = parse_full_frontend("trait Shared:\n    fn left(self) -> i64:\n        1", "left_traits", "left_traits", log)
        val right = parse_full_frontend("trait Shared:\n    fn right(self) -> i64:\n        2", "right_traits", "right_traits", log)
        val consumer = parse_full_frontend("use left_traits.{Shared}\nuse right_traits.{Shared}\nuse right_traits.{Shared as RightShared}", "trait_aliases", "trait_aliases", log)
        var modules: Dict<text, any> = {}
        modules["left_traits"] = left
        modules["right_traits"] = right
        var lowering = HirLowering.with_filename("trait_aliases")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        val left_id = hir.symbols.lookup("Shared")
        val right_id = hir.symbols.lookup("RightShared")
        expect(left_id.?).to_equal(true)
        expect(right_id.?).to_equal(true)
        expect(left_id.unwrap().id == right_id.unwrap().id).to_equal(false)
        expect(lowering.lowered_traits.contains_key("Shared")).to_equal(true)
        expect(lowering.lowered_traits.contains_key("RightShared")).to_equal(true)
        expect(lowering.lowered_traits["Shared"].defaults[0].name).to_equal("left")
        expect(lowering.lowered_traits["RightShared"].defaults[0].name).to_equal("right")
        expect(lowering.errors.len()).to_equal(0)

    it "resolves a named export alias":
        val log = make_logger()
        val provider = parse_full_frontend("pub struct Foo:\n    value: i64\nexport Foo as Bar", "export_alias", "export_alias", log)
        val consumer = parse_full_frontend("use export_alias.{Bar}", "export_alias_consumer", "export_alias_consumer", log)
        var modules: Dict<text, any> = {}
        modules["export_alias"] = provider
        var lowering = HirLowering.with_filename("export_alias_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        val bar_id = hir.symbols.lookup("Bar")
        expect(bar_id.?).to_equal(true)
        val bar = hir.symbols.get_symbol(bar_id)
        expect(bar.?).to_equal(true)
        expect(bar.unwrap().kind).to_equal(SymbolKind.Struct)
        expect(bar.unwrap().defining_module.unwrap()).to_equal("export_alias")
        expect(lowering.errors.len()).to_equal(0)

    it "resolves an aliased enum":
        val log = make_logger()
        val provider = parse_full_frontend("pub enum Color:\n    Red\n    Blue", "enum_provider", "enum_provider", log)
        val other = parse_full_frontend("pub enum Hue:\n    Light\n    Dark", "enum_other", "enum_other", log)
        val consumer = parse_full_frontend("use enum_provider.{Color as Shade}\nuse enum_other.{Hue as Shade}", "enum_consumer", "enum_consumer", log)
        var modules: Dict<text, any> = {}
        modules["enum_provider"] = provider
        modules["enum_other"] = other
        var lowering = HirLowering.with_filename("enum_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        val shade_id = hir.symbols.lookup("Shade")
        expect(shade_id.?).to_equal(true)
        val shade = hir.symbols.get_symbol(shade_id)
        expect(shade.?).to_equal(true)
        expect(shade.unwrap().name).to_equal("Color")
        expect(shade.unwrap().kind).to_equal(SymbolKind.Enum)
        expect(shade.unwrap().defining_module.unwrap()).to_equal("enum_provider")
        expect(hir.enums.contains_key(shade_id.unwrap())).to_equal(true)
        expect(hir.enums[shade_id.unwrap()].name).to_equal("Color")
        expect(lowering.errors.len()).to_equal(0)

    it "resolves an enum through a facade":
        val log = make_logger()
        val leaf = parse_full_frontend("pub enum LeafState:\n    Ready\n    Done", "enum_leaf", "enum_leaf", log)
        val facade = parse_full_frontend("use enum_leaf.{LeafState}", "enum_facade", "enum_facade", log)
        val consumer = parse_full_frontend("use enum_facade.{LeafState}", "enum_facade_consumer", "enum_facade_consumer", log)
        var modules: Dict<text, any> = {}
        modules["enum_leaf"] = leaf
        modules["enum_facade"] = facade
        var lowering = HirLowering.with_filename("enum_facade_consumer")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        val state_id = hir.symbols.lookup("LeafState")
        expect(state_id.?).to_equal(true)
        val state = hir.symbols.get_symbol(state_id)
        expect(state.?).to_equal(true)
        expect(state.unwrap().kind).to_equal(SymbolKind.Enum)
        expect(state.unwrap().defining_module.unwrap()).to_equal("enum_leaf")
        expect(hir.enums.contains_key(state_id.unwrap())).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "aliased imports keep same-named structs from different modules distinct":
        val log = make_logger()

        val src_driver = "struct CompileOptions:\n    input_files: [text]\n    low_memory: bool"
        val path_driver = "driver_types"
        val module_driver = parse_full_frontend(src_driver, path_driver, path_driver, log)

        val src_backend = "struct CompileOptions:\n    target: text\n    verify_output: bool"
        val path_backend = "backend_types"
        val module_backend = parse_full_frontend(src_backend, path_backend, path_backend, log)

        val open = "{"
        val close = "}"
        val src_consumer = "use driver_types." + open + "CompileOptions as DriverOptions" + close + "\n" +
            "use backend_types." + open + "CompileOptions as BackendOptions" + close
        val path_consumer = "consumer_aliases"
        val module_consumer = parse_full_frontend(src_consumer, path_consumer, path_consumer, log)

        var modules_map: Dict<text, any> = {}
        modules_map[path_driver] = module_driver
        modules_map[path_backend] = module_backend

        var lowering = HirLowering.with_filename(path_consumer)
        lowering.modules_by_name = modules_map
        val hir = lowering.lower_module(module_consumer)

        val driver_id = hir.symbols.lookup("DriverOptions")
        val backend_id = hir.symbols.lookup("BackendOptions")
        expect(driver_id.?).to_equal(true)
        expect(backend_id.?).to_equal(true)

        val driver_sym = hir.symbols.get_symbol(driver_id)
        val backend_sym = hir.symbols.get_symbol(backend_id)
        expect(driver_sym.?).to_equal(true)
        expect(backend_sym.?).to_equal(true)
        expect(driver_sym.unwrap().defining_module.unwrap()).to_equal(path_driver)
        expect(backend_sym.unwrap().defining_module.unwrap()).to_equal(path_backend)
        expect(driver_id.unwrap().id == backend_id.unwrap().id).to_equal(false)

    it "resolves a module-qualified imported function call":
        val log = make_logger()
        val provider = parse_full_frontend("pub fn answer() -> i64:\n    42", "provider", "provider", log)
        val consumer = parse_full_frontend("import provider\nfn answer() -> i64:\n    7\nfn main() -> i64:\n    provider.answer()", "consumer_qualified", "consumer_qualified", log)
        var modules: Dict<text, any> = {}
        modules["provider"] = provider
        var lowering = HirLowering.with_filename("consumer_qualified")
        lowering.modules_by_name = modules
        val hir = lowering.lower_module(consumer)

        expect(hir.symbols.lookup("provider").?).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)
        var found_main = false
        for fn_ in hir.functions.values():
            if fn_.name == "main":
                found_main = true
                match fn_.body.stmts[0].kind:
                    case HirStmtKind.Expr(expr):
                        match expr.kind:
                            case HirExprKind.Call(callee, _, _):
                                match callee.kind:
                                    case HirExprKind.NamedVar(symbol, _):
                                        val callable = hir.symbols.get_symbol(symbol)
                                        expect(callable.?).to_equal(true)
                                        expect(callable.unwrap().defining_module.unwrap()).to_equal("provider")
                                    case _:
                                        expect(false).to_equal(true)
                            case _:
                                expect(false).to_equal(true)
                    case _:
                        expect(false).to_equal(true)
        expect(found_main).to_equal(true)
