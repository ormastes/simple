# Physical sibling identity must survive asymmetric repeated-tier collapsing.
# @req REQ-COMPILER-HIR-001
use std.spec.{describe, it, expect}
use std.spec.step
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.module_path_naming.{module_logical_name_from_path}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*

fn sibling_importer_source() -> text:
    "use .object_mapper.\{InnerMapper, inner_only\}\n" +
        "pub class SweeperWitness:\n    count: i64\n" +
        "fn chosen(value: InnerMapper) -> i64:\n    inner_only()\n"

fn sibling_inner_source() -> text:
    "use .generation_sweeper.\{SweeperWitness\}\n" +
        "pub class InnerMapper:\n    size: i32\n" +
        "class MapperPrivateState:\n    count: i64\n" +
        "pub fn inner_only() -> i64:\n    2\n" +
        "fn reverse(value: SweeperWitness) -> i64:\n    3\n"

fn sibling_owner_registry(include_inner: bool):
    val log = Logger(level: 0)
    val root = "src/compiler/99.loader/object_mapper.spl"
    val inner = "src/compiler/99.loader/loader/object_mapper.spl"
    val importer = "src/compiler/99.loader/loader/generation_sweeper.spl"
    var paths = [root, importer]
    var texts = ["pub class RootMapper:\n    size: i64\npub fn root_only() -> i64:\n    1\n",
        sibling_importer_source()]
    if include_inner:
        paths.push(inner)
        texts.push(sibling_inner_source())
    var builder = ModuleSurfaceBuilder.new()
    var index = 0
    while index < paths.len():
        val path = paths[index]
        val source = texts[index]
        val name = module_logical_name_from_path(path)
        val parsed = parse_full_frontend(source, path, name, log)
        expect(builder.add_parsed(parsed,
            SourceFile(path: path, content: source, module_name: name), index).is_ok()).to_equal(true)
        index = index + 1
    builder.finish().unwrap()

describe "relative imports preserve the physical tier sibling":
    it "uses the inner owner in frozen traces and live HIR when both twins exist":
        step("Freeze both mapper owners and resolve the physical sibling")
        val registry = sibling_owner_registry(true)
        val importer = registry.surfaces[registry.index_by_name["compiler.loader.generation_sweeper"]]
        expect(importer.import_target_names[0]).to_equal("compiler.loader.loader.object_mapper")
        val trace = importer.import_resolution_traces[0]
        expect(trace.selected).to_equal("compiler.loader.loader.object_mapper")
        expect(trace.probes[0].path).to_equal("compiler.loader.loader.object_mapper")
        expect(trace.probes[0].found).to_equal(true)
        var lowering = hirlowering_for_module("compiler.loader.generation_sweeper", registry)
        expect(lowering.resolve_module_key_relative(".object_mapper",
            "compiler.loader.generation_sweeper", importer.canonical_path)).to_equal("compiler.loader.loader.object_mapper")
        val path = "src/compiler/99.loader/loader/generation_sweeper.spl"
        val module = parse_full_frontend(
            sibling_importer_source(),
            path, "compiler.loader.generation_sweeper", Logger(level: 0))
        val hir = lowering.lower_module(module)
        expect(lowering.errors.len()).to_equal(0)
        expect(hir.symbols.lookup("inner_only") != nil).to_equal(true)
        expect(hir.symbols.lookup("InnerMapper") != nil).to_equal(true)

    it "resolves the reverse physical sibling without exporting private declarations":
        step("Lower a doubled-name owner importing its collapsed-name sibling")
        val registry = sibling_owner_registry(true)
        val inner = registry.surfaces[registry.index_by_name["compiler.loader.loader.object_mapper"]]
        expect(inner.import_target_names[0]).to_equal("compiler.loader.generation_sweeper")
        expect(inner.composites["InnerMapper"].fields[0].type_name).to_equal("i32")
        expect(inner.composites["MapperPrivateState"].is_public).to_equal(false)
        val root = registry.surfaces[registry.index_by_name["compiler.loader.object_mapper"]]
        expect(root.composites["RootMapper"].fields[0].type_name).to_equal("i64")
        var lowering = hirlowering_for_module("compiler.loader.loader.object_mapper", registry)
        val module = parse_full_frontend(sibling_inner_source(),
            "src/compiler/99.loader/loader/object_mapper.spl",
            "compiler.loader.loader.object_mapper", Logger(level: 0))
        val hir = lowering.lower_module(module)
        expect(lowering.errors.len()).to_equal(0)
        expect(hir.symbols.lookup("SweeperWitness") != nil).to_equal(true)
        expect(lowering.resolve_module_key_relative("..object_mapper",
            "compiler.loader.loader.object_mapper", inner.canonical_path)).to_equal("compiler.loader.object_mapper")

    it "keeps a lexical import's physical owner when its context is logical":
        step("Resolve a lexical alias with both physical mapper counterparts present")
        val registry = sibling_owner_registry(true)
        val inner = registry.surfaces[registry.index_by_name["compiler.loader.loader.object_mapper"]]
        val root = registry.surfaces[registry.index_by_name["compiler.loader.object_mapper"]]
        # This is the production lexical gateway. Its logical module_filename
        # requires the retained path; the lexical alias is absent from the
        # importer's module-level item-offset rows.
        var lowering = hirlowering_for_module("compiler.loader.generation_sweeper", registry)
        lowering.resolve_lexical_import(".object_mapper",
            ["InnerMapper:LocalMapper"], false, Span.empty())
        expect(lowering.errors.len()).to_equal(0)
        val symbol_id = lowering.symbols.lookup_or_invalid("LocalMapper")
        expect(symbol_id.is_valid()).to_equal(true)
        val symbol = lowering.symbols.symbols[symbol_id.id]
        expect(symbol.defining_module.unwrap()).to_equal(inner.module_name)
        expect(symbol.defining_module.unwrap() == root.module_name).to_equal(false)
        expect(lowering.symbols.lookup_or_invalid("MapperPrivateState").is_valid()).to_equal(false)
        expect(lowering.registering_lexical_import).to_equal(false)

    it "does not replace a missing physical sibling with the root twin":
        step("Keep the root counterpart but omit the required inner owner")
        val registry = sibling_owner_registry(false)
        val importer = registry.surfaces[registry.index_by_name["compiler.loader.generation_sweeper"]]
        expect(importer.import_target_names[0]).to_equal("")
        expect(importer.import_resolution_traces[0].selected_count).to_equal(0)
        var lowering = hirlowering_for_module("compiler.loader.generation_sweeper", registry)
        expect(lowering.resolve_module_key_relative(".object_mapper",
            "compiler.loader.generation_sweeper", importer.canonical_path)).to_equal("")
        lowering.resolve_lexical_import(".object_mapper",
            ["InnerMapper:LocalMapper"], false, Span.empty())
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].message).to_contain("missing module surface for .object_mapper")
        expect(lowering.symbols.lookup_or_invalid("LocalMapper").is_valid()).to_equal(false)
        # Absolute imports retain their independent root-owner meaning.
        expect(lowering.resolve_module_key_relative("compiler.loader.object_mapper",
            "compiler.loader.generation_sweeper")).to_equal("compiler.loader.object_mapper")
