# @tag: unit, compiler, hir, source-contract, perf

use std.spec.{describe, it, expect}
use std.io_runtime.{read_file_text}

val IMPORT_RESOLUTION = "src/compiler/20.hir/hir_lowering/_Items/module_import_resolution.spl"
val MODULE_LOWERING = "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl"

describe "package sibling surface lookup guard":
    it "consumes aligned registry names and indices in one ordered pass":
        val resolution_source = read_file_text(IMPORT_RESOLUTION)
        val lowering_source = read_file_text(MODULE_LOWERING)
        expect(resolution_source).to_contain(
            "val sibling_names: [text] = self.package_sibling_registry_names(canon_pkg)")
        expect(resolution_source).to_contain(
            "val sibling_canons: [text] = self.package_sibling_canonical_names(canon_pkg)")
        expect(resolution_source.index_of(
            "val sibling_index = hir_module_surface_index(self.module_surfaces, sibling_name)"))
            .to_equal(-1)
        expect(lowering_source).to_contain(
            "while key_index < self.module_surfaces.ordered_names.len():")
        expect(lowering_source).to_contain(
            "val registry_name = self.module_surfaces.ordered_names[key_index]")
