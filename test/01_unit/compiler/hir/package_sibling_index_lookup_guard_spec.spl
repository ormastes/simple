# @tag: unit, compiler, hir, source-contract, perf

use std.spec.{describe, it, expect}
use std.io_runtime.{read_file_text}

val IMPORT_RESOLUTION = "src/compiler/20.hir/hir_lowering/_Items/module_import_resolution.spl"

describe "package sibling surface lookup guard":
    it "consumes aligned registry names and indices in one ordered pass":
        val source = read_file_text(IMPORT_RESOLUTION)
        expect(source).to_contain(
            "val sibling_names = self.module_surfaces.ordered_names")
        expect(source).to_contain(
            "val sibling_indices = self.module_surfaces.ordered_indices")
        expect(source).to_contain(
            "val sibling_index: i64 = sibling_indices[sibling_position]")
        expect(source).to_contain(
            "sibling_position < sibling_names.len() and sibling_position < sibling_indices.len()")
        expect(source.index_of(
            "val sibling_index = hir_module_surface_index(self.module_surfaces, sibling_name)"))\
            .to_equal(-1)
