# The HIR codec's scalar writers must never mistake a value for nil.
#
# Under staged-native codegen `v == nil` on an i64-typed slot is true for the
# integer 3 and, on a bool-typed slot, for `true`. The writers used exactly that
# test, so a stage-2 compiler wrote every 3 and every true as `N`: the i64 case
# desynchronised the decoder (every HIR cache load missed and all HIR shard work
# was discarded), the bool case silently decoded true flags as nil.
# doc/08_tracking/bug/hir_codec_put_i64_three_encoded_as_nil_native_2026-10-10.md
#
# These examples pin the encoded bytes. They hold on every engine; the native
# evidence that the old expressions failed and the new ones pass is recorded in
# the bug record, because this suite runs interpreted.

use std.spec.*
use compiler.hir.hir_codec_support.{HirCodecWriter, hc_read_f64}
use compiler.hir.hir_codec_key_order.{hc_i64_key_before_v1, hc_order_i64_keys_v1}
use std.common.binary_io.{f64_to_bits, f64_from_bits}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

describe "HIR codec scalar writers":
    it "should write every small integer as digits, including 3":
        var w = HirCodecWriter.create()
        var v: i64 = 0
        while v < 6:
            w.put_i64(v)
            v = v + 1
        expect(w.ok).to_equal(true)
        expect(w.finish()).to_equal("0\n1\n2\n3\n4\n5\n")

    it "should write a length of three as 3":
        val items: [i64] = [7, 8, 9]
        var w = HirCodecWriter.create()
        w.put_i64(items.len())
        expect(w.finish()).to_equal("3\n")

    it "should write true as 1 and false as 0":
        var w = HirCodecWriter.create()
        w.put_bool(false)
        w.put_bool(true)
        val flags: [bool] = [true, false]
        for flag in flags:
            w.put_bool(flag)
        expect(w.finish()).to_equal("0\n1\n1\n0\n")

    it "should read the written scalars back unchanged":
        var w = HirCodecWriter.create()
        w.put_i64(3)
        w.put_bool(true)
        w.put_i64(-3)
        var r = FlatPoolReader.new(w.finish())
        expect(r.next_i64()).to_equal(3)
        expect(r.next()).to_equal("1")
        expect(r.next_i64()).to_equal(-3)
        expect(r.ok).to_equal(true)

    it "should write negative and extreme integers as digits":
        val i64_max: i64 = 9223372036854775807
        val i64_min: i64 = -9223372036854775807 - 1
        var w = HirCodecWriter.create()
        w.put_i64(-1)
        w.put_i64(-3)
        w.put_i64(i64_max)
        w.put_i64(i64_min)
        val body = w.finish()
        expect(body).to_equal("-1\n-3\n9223372036854775807\n-9223372036854775808\n")
        var r = FlatPoolReader.new(body)
        expect(r.next_i64()).to_equal(-1)
        expect(r.next_i64()).to_equal(-3)
        expect(r.next_i64()).to_equal(i64_max)
        expect(r.next_i64()).to_equal(i64_min)
        expect(r.ok).to_equal(true)

    it "should still write a real nil scalar as N":
        val absent: i64? = nil
        val nested: Option<i64?> = nil
        var w = HirCodecWriter.create()
        w.put_i64(nil)
        w.put_i64(absent)
        w.put_i64(nested)
        expect(w.ok).to_equal(true)
        expect(w.finish()).to_equal("N\nN\nN\n")

    # A nil handed to a bool-typed parameter is coerced to false by the
    # interpreter (measured: `0` both before and after the fix). Whatever the
    # engine, it is one line and never `1`.
    it "should never write a nil bool as true":
        var w = HirCodecWriter.create()
        w.put_bool(nil)
        val line = w.finish()
        expect(w.ok).to_equal(true)
        expect(line == "0\n" or line == "N\n").to_equal(true)

    it "should write a present optional integer three as 3":
        val present: i64? = 3
        val nested: Option<i64?> = 3
        var w = HirCodecWriter.create()
        w.put_i64(present)
        w.put_i64(nested)
        expect(w.finish()).to_equal("3\n3\n")

    it "should keep f64 zero signs bit-exact and NaN a NaN":
        val pos_zero: f64 = 0.0
        val neg_zero: f64 = f64_from_bits(0x8000000000000000u64)
        val nan: f64 = f64_from_bits(0x7FF8000000000000u64)
        var w = HirCodecWriter.create()
        w.put_f64(pos_zero)
        w.put_f64(neg_zero)
        w.put_f64(nan)
        w.put_f64(3.0)
        var r = FlatPoolReader.new(w.finish())
        expect(f64_to_bits(hc_read_f64(r)) == f64_to_bits(pos_zero)).to_equal(true)
        expect(f64_to_bits(hc_read_f64(r)) == f64_to_bits(neg_zero)).to_equal(true)
        # NaN's sign bit is not stable through the interpreter's f64 values
        # (0x7FF8... and 0xFFF8... were both observed for this one value), so
        # only NaN-ness is asserted.
        val nan_back = hc_read_f64(r)
        expect(nan_back != nan_back).to_equal(true)
        expect(hc_read_f64(r)).to_equal(3.0)
        expect(r.ok).to_equal(true)

describe "HIR codec i64 key order":
    it "should order key 3 as an integer, not as nil":
        expect(hc_i64_key_before_v1(3, 2)).to_equal(false)
        expect(hc_i64_key_before_v1(2, 3)).to_equal(true)
        expect(hc_i64_key_before_v1(3, 4)).to_equal(true)
        expect(hc_i64_key_before_v1(3, 3)).to_equal(false)
        expect(hc_order_i64_keys_v1([5, 3, 4, 1, 3])).to_equal([1, 3, 3, 4, 5])

    it "should keep a real nil key first":
        expect(hc_i64_key_before_v1(nil, 3)).to_equal(true)
        expect(hc_i64_key_before_v1(3, nil)).to_equal(false)
        expect(hc_i64_key_before_v1(nil, nil)).to_equal(false)
