# The HIR codec's scalar writers must never mistake a value for nil.
#
# Under staged-native codegen `v == nil` on an i64-typed slot is true for the
# integer 3 and, on a bool-typed slot, for `true`. The writers used exactly that
# test, so a stage-2 compiler wrote every 3 and every true as `N`: the i64 case
# desynchronised the decoder (every HIR cache load missed and all HIR shard work
# was discarded), the bool case silently decoded true flags as nil.
# doc/08_tracking/bug/hir_codec_put_i64_three_encoded_as_nil_native_2026-10-10.md
#
# These examples pin the encoded bytes. They hold on every engine; the native
# evidence that the old expressions failed and the new ones pass is recorded in
# the bug record, because this suite runs interpreted.

use std.spec.*
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

describe "HIR codec scalar writers":
    it "should write every small integer as digits, including 3":
        var w = HirCodecWriter.create()
        var v: i64 = 0
        while v < 6:
            w.put_i64(v)
            v = v + 1
        expect(w.ok).to_equal(true)
        expect(w.finish()).to_equal("0\n1\n2\n3\n4\n5\n")

    it "should write a length of three as 3":
        val items: [i64] = [7, 8, 9]
        var w = HirCodecWriter.create()
        w.put_i64(items.len())
        expect(w.finish()).to_equal("3\n")

    it "should write true as 1 and false as 0":
        var w = HirCodecWriter.create()
        w.put_bool(false)
        w.put_bool(true)
        val flags: [bool] = [true, false]
        for flag in flags:
            w.put_bool(flag)
        expect(w.finish()).to_equal("0\n1\n1\n0\n")

    it "should read the written scalars back unchanged":
        var w = HirCodecWriter.create()
        w.put_i64(3)
        w.put_bool(true)
        w.put_i64(-3)
        var r = FlatPoolReader.new(w.finish())
        expect(r.next_i64()).to_equal(3)
        expect(r.next()).to_equal("1")
        expect(r.next_i64()).to_equal(-3)
        expect(r.ok).to_equal(true)
