# Source contract for the directly owned runner-closure HIR failures.
use std.io_runtime.{read_file_text}

describe "runner closure direct HIR owners":
    it "imports frozen surface alignment from its defining package module":
        val importer = read_file_text("src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl")
        val owner = read_file_text("src/compiler/20.hir/hir_lowering/module_surface_registry_index.spl")
        expect(importer).to_contain("use compiler.hir.hir_lowering.module_surface_registry_index.{module_surfaces_frozen_alignment}")
        expect(owner).to_contain("pub(package) fn module_surfaces_frozen_alignment(")

    it "uses the already imported optional environment facade in MIR lowering":
        val source = read_file_text("src/compiler/50.mir/mir_lowering_stmts.spl")
        expect(source).to_contain("use std.io_runtime.{env_get_opt}")
        expect(source).to_contain("env_get_opt(\"SIMPLE_ANYQ_PROBE\") == Some(\"1\")")
        expect(source.contains("rt_env_get(\"SIMPLE_ANYQ_PROBE\")")).to_equal(false)

    it "declares the unit return of finally transfer emission":
        val source = read_file_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        expect(source).to_contain("me emit_pending_finally_for_transfer() -> ():")
        expect(source).to_contain("return ()")

    it "declares result types on seven async array helpers":
        val source = read_file_text("src/lib/nogc_async_mut/array.spl")
        expect(source).to_contain("fn array_position<T>(arr: [T], predicate: fn(T) -> bool) -> i64:")
        expect(source).to_contain("fn array_find<T>(arr: [T], predicate: fn(T) -> bool) -> T?:")
        expect(source).to_contain("fn array_find_or<T>(arr: [T], predicate: fn(T) -> bool, default_val: T) -> T:")
        expect(source).to_contain("fn array_take_while<T>(arr: [T], predicate: fn(T) -> bool) -> [T]:")
        expect(source).to_contain("fn array_drop_while<T>(arr: [T], predicate: fn(T) -> bool) -> [T]:")
        expect(source).to_contain("fn array_sort_by<T>(arr: [T], comparator: fn(T, T) -> i64) -> [T]:")
        expect(source).to_contain("fn array_intersperse<T>(arr: [T], separator: T) -> [T]:")
