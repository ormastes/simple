"""
Imported primitive fields must not search module export tables. These tests
exercise real parser surfaces and the same materialization owner used by
lower_module. Re-export counters observe the path that emits the advisory;
no wall-clock threshold or source-text matching is used.
"""
use std.spec
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}

fn field_dependency_registry(provider: text, owner: text, consumer: text) -> ModuleSurfacesByName:
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    modules["probe.provider"] = parse_full_frontend(provider, "probe/provider.spl", "probe.provider", log)
    modules["probe.owner"] = parse_full_frontend(owner, "probe/owner.spl", "probe.owner", log)
    modules["probe.consumer"] = parse_full_frontend(consumer, "probe/consumer.spl", "probe.consumer", log)
    val sources = [
        SourceFile(path: "probe/provider.spl", content: provider, module_name: "probe.provider"),
        SourceFile(path: "probe/owner.spl", content: owner, module_name: "probe.owner"),
        SourceFile(path: "probe/consumer.spl", content: consumer, module_name: "probe.consumer")
    ]
    module_surfaces_from_modules(modules, sources).unwrap()

fn field_dependency_owner_index(registry: ModuleSurfacesByName) -> i64:
    for surface in registry.surfaces:
        if surface.module_name == "probe.owner":
            return surface.physical_index
    -1

fn lower_field_consumer(provider: text, owner: text, consumer: text) -> HirLowering:
    val registry = field_dependency_registry(provider, owner, consumer)
    var lowering = hirlowering_for_module("probe.consumer", registry)
    val module = parse_full_frontend(consumer, "probe/consumer.spl", "probe.consumer", Logger(level: 0))
    val hir = lowering.lower_module(module)
    lowering

describe "imported composite primitive field dependencies", tag: ["only-compiled"]:
    it "does not enter the advisory-producing re-export chase for primitive spellings":
        val registry = field_dependency_registry("", "pub struct Holder:\n    value: i64\n", "")
        val owner = field_dependency_owner_index(registry)
        expect(owner).to_be_greater_than(-1)
        var lowering = hirlowering_for_module("probe.consumer", registry)
        for name in ["i64", "u8", "text", "bool", "f64", "has_i64", "has_text"]:
            lowering.materialize_imported_composite_field_dependency(
                [], owner, "probe.owner", name, Span.empty(), true)
            expect(lowering.symbols.lookup_qualified_type_raw("probe.owner", name)).to_equal(-1)
        expect(lowering.reexport_chase_calls).to_equal(0)
        expect(lowering.errors.len()).to_equal(0)

    it "lowers real scalar array optional and nested primitive fields":
        val owner = "pub struct Holder:\n    count: i64\n    bytes: [u8]\n    name: text\n    enabled: bool\n    maybe: i64?\n    nested: [[u8]]\n"
        val consumer = "use probe.owner.\{Holder\}\n\nfn read(holder: Holder) -> i64:\n    holder.count\n"
        val lowering = lower_field_consumer("", owner, consumer)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.symbols.lookup_qualified_type_raw("probe.owner", "Holder")).to_be_greater_than(-1)
        expect(lowering.reexport_chase_calls).to_equal(0)

    it "preserves foreign nominal and capitalized container-name declarations":
        val provider = "pub struct ForeignPayload:\n    value: i64\n\npub struct Option:\n    value: i64\n\npub struct Result:\n    value: i64\n\npub struct Dict:\n    value: i64\n\npub struct Bool:\n    value: i64\n"
        val owner_src = "use probe.provider.\{ForeignPayload, Option, Result, Dict, Bool\}\n\npub struct Holder:\n    payload: ForeignPayload\n"
        val registry = field_dependency_registry(provider, owner_src, "")
        val owner = field_dependency_owner_index(registry)
        expect(owner).to_be_greater_than(-1)
        var lowering = hirlowering_for_module("probe.consumer", registry)
        for name in ["ForeignPayload", "Option", "Result", "Dict", "Bool"]:
            lowering.materialize_imported_composite_field_dependency(
                [], owner, "probe.owner", name, Span.empty(), true)
            val terminal = lowering.symbols.lookup_qualified_type_raw("probe.provider", name)
            expect(terminal).to_be_greater_than(-1)
            expect(lowering.symbols.lookup_qualified_type_raw("probe.owner", name)).to_equal(terminal)
        expect(lowering.errors.len()).to_equal(0)

    it "keeps a foreign declaration imported under an alias bound to its owner":
        val provider = "pub struct ForeignPayload:\n    value: i64\n"
        val owner_src = "use probe.provider.\{ForeignPayload as PayloadAlias\}\n\npub struct Holder:\n    payload: PayloadAlias\n"
        val registry = field_dependency_registry(provider, owner_src, "")
        val owner = field_dependency_owner_index(registry)
        expect(owner).to_be_greater_than(-1)
        var lowering = hirlowering_for_module("probe.consumer", registry)
        lowering.materialize_imported_composite_field_dependency(
            [], owner, "probe.owner", "PayloadAlias", Span.empty(), true)
        val terminal = lowering.symbols.lookup_qualified_type_raw("probe.provider", "ForeignPayload")
        expect(terminal).to_be_greater_than(-1)
        expect(lowering.symbols.lookup_qualified_type_raw("probe.owner", "PayloadAlias")).to_equal(terminal)
        expect(lowering.errors.len()).to_equal(0)

    it "retains real missing nominal type diagnostics":
        val owner = "pub struct Holder:\n    payload: MissingPayload\n"
        val consumer = "use probe.owner.\{Holder\}\n\nfn read(holder: Holder) -> i64:\n    0\n"
        val lowering = lower_field_consumer("", owner, consumer)
        var saw_missing = false
        for error in lowering.errors:
            if error.message.contains("MissingPayload"):
                saw_missing = true
        expect(saw_missing).to_be(true)
        expect(lowering.reexport_chase_calls).to_be_greater_than(0)
        expect(lowering.symbols.lookup_qualified_type_raw("probe.owner", "MissingPayload")).to_equal(-1)

    it "does not hide an invalid field owner even for a primitive":
        val registry = field_dependency_registry("", "pub struct Holder:\n    value: i64\n", "")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        lowering.materialize_imported_field_dependency(-1, "probe.owner", "i64", Span.empty(), true)
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].message).to_contain("invalid imported module surface index")
