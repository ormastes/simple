"""
HIR codec scalar writers after retyping their parameters to `i64?` / `bool?`
(doc/08_tracking/bug/native_scalar_nil_compare_payload_bits_2026-10-10.md):
a nil scalar is a REAL value the codec must encode as `N`, and a non-optional
scalar slot cannot hold one natively (nil and the integer 3 share the word 3;
`v == nil` on a non-optional scalar folds to false). With `i64?`/`bool?` the
nil test runs through the Option handle predicates on every engine, so
`put_i64(nil)` writes `N` and `put_i64(3)` writes `3` -- the two cases the
old `i64` signature could not keep apart under stage-2 native code.
"""

use std.spec.*
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.hir_codec_key_order.{hc_i64_key_before_v1}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

fn opt_i64(v: i64?) -> i64?:
    v

fn opt_bool(v: bool?) -> bool?:
    v

describe "HIR codec scalar writers keep nil distinct from every payload":
    it "writes nil as N and every integer, including 3, as digits":
        var w = HirCodecWriter.create()
        w.put_i64(nil)
        w.put_i64(3)
        w.put_i64(0)
        w.put_i64(opt_i64(nil))
        w.put_i64(opt_i64(3))
        val n: i64 = 3
        w.put_i64(n)
        expect(w.ok).to_equal(true)
        expect(w.finish()).to_equal("N\n3\n0\nN\n3\n3\n")

    it "writes nil as N, true as 1 and false as 0":
        var w = HirCodecWriter.create()
        w.put_bool(nil)
        w.put_bool(true)
        w.put_bool(false)
        w.put_bool(opt_bool(nil))
        w.put_bool(opt_bool(true))
        val t: bool = true
        w.put_bool(t)
        expect(w.finish()).to_equal("N\n1\n0\nN\n1\n1\n")

    it "reads a written 3 back as 3 and a written nil back as nil":
        var w = HirCodecWriter.create()
        w.put_i64(3)
        w.put_i64(nil)
        w.put_bool(true)
        var r = FlatPoolReader.new(w.finish())
        expect(r.next_i64()).to_equal(3)
        expect(r.next()).to_equal("N")
        expect(r.next()).to_equal("1")
        expect(r.ok).to_equal(true)

    it "orders a nil key before every integer key, including 3":
        expect(hc_i64_key_before_v1(nil, 3)).to_equal(true)
        expect(hc_i64_key_before_v1(nil, 0)).to_equal(true)
        expect(hc_i64_key_before_v1(3, nil)).to_equal(false)
        expect(hc_i64_key_before_v1(nil, nil)).to_equal(false)
        expect(hc_i64_key_before_v1(3, 3)).to_equal(false)
        expect(hc_i64_key_before_v1(2, 3)).to_equal(true)
        expect(hc_i64_key_before_v1(3, 2)).to_equal(false)
