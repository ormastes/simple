"""
# Imported Signature Generic-Argument Projection — Unit Spec

Follow-up (c) of `hir_unresolved_type_owner_missing_import_2026-08-22.md`
recorded, but did not fix, the last known asymmetry between the two walks over
a parser `Type`:

| walk | generic arguments |
|---|---|
| MATERIALIZATION `parser_type_named_dependencies` | recursed, bound |
| PROJECTION `imported_surface_type` / `..._projected` | **dropped** |

Both projection scalar branches called `lower_named_kind(name, [], span)` /
built `Named(sym, [])` with an EMPTY argument list. Unlike the array-of-tuple,
pointer and union arms fixed in the same lane, this one does NOT error — which
is precisely why the follow-up's `Dict<K, MirType>` probe measured 0 errors and
why the record warned in writing that 0 must not be read as "handled".

The WRONG OUTCOME, exhibited below rather than argued: `Dict<text, MirType>`
projects to an argument-less `Dict`, and `lower_named_kind`'s zero-argument
`Dict` arm recovers that to `Dict<any, any>` (hir_lowering/types.spl). So the
importer's symbol table records the imported callable as taking a
`Dict<any, any>` — key AND cross-module value type both erased, silently, with
no diagnostic anywhere. Any later phase that reads that signature (inference,
MIR lowering, layout) sees `any`, not `MirType`.

See doc/08_tracking/bug/hir_unresolved_type_owner_missing_import_2026-08-22.md
"""

use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}

fn generic_arg_surfaces(mods: Dict<text, Module>, srcs: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_modules(mods, srcs):
        case Ok(value): value
        case Err(error):
            assert_true(false)
            ModuleSurfacesByName.empty()

fn generic_arg_lower(owner_param: text) -> HirLowering:
    generic_arg_lower_with(owner_param, "text", true)

fn generic_arg_lower_with(owner_param: text, owner_ret: text, owner_imports: bool) -> HirLowering:
    val log = Logger(level: 0)
    val mir_src = "struct MirType:\n    width: i64\n"
    # The owner explicitly imports MirType, exactly as type_mapper.spl:8 does.
    val import_line = if owner_imports: "use mir.mir_types.\{MirType\}\n\n" else: ""
    val body = if owner_ret == "text": "    \"x\"" else: "    {}"
    val own_src = import_line + "fn map_struct(" + owner_param + ") -> " + owner_ret + ":\n" + body
    # The victim: imports only the CALLABLE, never the type in its signature.
    val cons_src = "use be.type_mapper.\{map_struct\}\n\nfn go() -> i64:\n    1"
    var mods: Dict<text, Module> = {}
    mods["mir.mir_types"] = parse_full_frontend(mir_src, "mir.mir_types", "mir.mir_types", log)
    mods["be.type_mapper"] = parse_full_frontend(own_src, "be.type_mapper", "be.type_mapper", log)
    val cons = parse_full_frontend(cons_src, "be.backend_port", "be.backend_port", log)
    mods["be.backend_port"] = cons
    val srcs = [
        SourceFile(path: "mir/mir_types.spl", content: mir_src, module_name: "mir.mir_types"),
        SourceFile(path: "be/type_mapper.spl", content: own_src, module_name: "be.type_mapper"),
        SourceFile(path: "be/backend_port.spl", content: cons_src, module_name: "be.backend_port")
    ]
    var lowering = hirlowering_for_module("be.backend_port", generic_arg_surfaces(mods, srcs))
    val hir = lowering.lower_module(cons)
    lowering

fn generic_arg_first_param_kind(lowering: HirLowering) -> text:
    """Describe the FIRST parameter of the imported `map_struct` as the
    importer's own symbol table records it. Returns a stable tag so the
    assertion names the observed shape rather than a bare boolean."""
    if val fn_sym_id = lowering.symbols.lookup("map_struct"):
        if val fn_sym = lowering.symbols.get_symbol(Some(fn_sym_id)):
            if val fn_type = fn_sym.type_:
                match fn_type.kind:
                    case HirTypeKind.Function(params, ret, effects):
                        if params.len() == 0: return "no-params"
                        match params[0].kind:
                            case HirTypeKind.Dict(key, value):
                                var key_tag = "other"
                                match key.kind:
                                    case HirTypeKind.Any: key_tag = "any"
                                    case HirTypeKind.Str: key_tag = "text"
                                    case _: key_tag = "other"
                                var value_tag = "other"
                                match value.kind:
                                    case HirTypeKind.Any: value_tag = "any"
                                    case HirTypeKind.Named(symbol, args): value_tag = "named"
                                    case _: value_tag = "other"
                                return "Dict<" + key_tag + "," + value_tag + ">"
                            case HirTypeKind.Named(symbol, args):
                                return "Named/args=" + "{args.len()}"
                            case _: return "other-kind"
                    case _: return "not-a-function"
    "missing"


fn generic_arg_lower_ret() -> HirLowering:
    generic_arg_lower_with("d: i64", "Dict<text, MirType>", true)

fn generic_arg_lower_unimported() -> HirLowering:
    generic_arg_lower_with("d: Dict<text, MirType>", "text", false)

describe "generic arguments in an imported cross-module signature":
    it "projects Dict<text, MirType> with BOTH arguments, not as Dict<any, any>":
        # Pre-fix this reads `Dict<any,any>` — no error, total fidelity loss.
        val lowering = generic_arg_lower("d: Dict<text, MirType>")
        val shape = generic_arg_first_param_kind(lowering)
        eprint("[generic-arg-shape] {shape}")
        expect(shape).to_equal("Dict<text,named>")

    it "reports no unresolved-type error for the generic-argument shape":
        val lowering = generic_arg_lower("d: Dict<text, MirType>")
        for error in lowering.errors:
            eprint("[generic-arg-error] {error.message}")
        expect(lowering.errors.len()).to_equal(0)

    it "projects generic arguments in the RETURN type too":
        # The materialization dispatcher had the identical scalar shortcut on
        # the return-type path; both halves are fixed.
        val lowering = generic_arg_lower_ret()
        for error in lowering.errors:
            eprint("[generic-arg-ret-error] {error.message}")
        expect(lowering.errors.len()).to_equal(0)

    it "guards the guard: the fixture is not vacuously green":
        # Strip the owner's import and the SAME signature must still fail.
        # Without this, a future change that resolved MirType in the IMPORTER's
        # scope would make every assertion above pass for the wrong reason.
        val lowering = generic_arg_lower_unimported()
        expect(lowering.errors.len() > 0).to_equal(true)
