# Actual-source route regression; authored, not execution-qualified.
use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserModule}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_lowering._Items.module_reexport_materialization.*

fn conversion_owner_source(content: text, repaired: bool) -> text:
    val direct_import = "use compiler.traits.trait_impl.\{ImplBlock\}\n"
    var occurrences = 0
    for line in content.split("\n"):
        if line + "\n" == direct_import: occurrences = occurrences + 1
    assert(occurrences <= 1)
    val baseline = content.replace(direct_import, "")
    if repaired: direct_import + baseline else: baseline

fn owner_route_sources(repaired: bool) -> [SourceFile]:
    val paths = [
        "src/compiler/25.traits/trait_impl.spl",
        "src/compiler/25.traits/trait_method_resolution.spl",
        "src/compiler/25.traits/traits.spl",
        "src/compiler/30.types/type_infer/traits.spl"
    ]
    val names = [
        "compiler.traits.trait_impl",
        "compiler.traits.trait_method_resolution",
        "compiler.traits.traits",
        "compiler.types.type_infer.traits"
    ]
    var sources: [SourceFile] = []
    for index in 0..paths.len():
        var content = read_file(paths[index])
        if names[index] == "compiler.types.type_infer.traits":
            content = conversion_owner_source(content, repaired)
        assert(content != "")
        sources.push(SourceFile(path: paths[index], content: content, module_name: names[index]))
    sources

describe "actual trait owner routes preserve terminal identity":
    it "rejects private facade traversal and distinguishes the two real ImplBlock owners":
        val sources = owner_route_sources(false)
        var modules: Dict<text, ParserModule> = {}
        for source in sources:
            modules[source.module_name] = parse_full_frontend(
                source.content, source.path, source.module_name, Logger(level: 0))
        val result = module_surfaces_from_modules(modules, sources)
        expect(result.is_ok()).to_equal(true)
        val surfaces = result.unwrap()
        var lowering = hirlowering_for_module("probe.owner.consumer", surfaces)
        var solver_index = -1
        var method_index = -1
        var facade_index = -1
        for index in 0..surfaces.surfaces.len():
            val surface = surfaces.surfaces[index]
            if surface.module_name == "compiler.traits.trait_impl": solver_index = index
            if surface.module_name == "compiler.traits.trait_method_resolution": method_index = index
            if surface.module_name == "compiler.traits.traits": facade_index = index
        expect(solver_index >= 0).to_equal(true)
        expect(method_index >= 0).to_equal(true)
        expect(facade_index >= 0).to_equal(true)
        val solver = lowering.canonical_callable_dependency_candidate(solver_index, "ImplBlock")
        val methods = lowering.canonical_callable_dependency_candidate(method_index, "ImplBlock")
        val private_facade = lowering.canonical_callable_dependency_candidate(facade_index, "ImplBlock")
        expect(solver.found).to_equal(true)
        expect(methods.found).to_equal(true)
        expect(solver.module_index == methods.module_index).to_equal(false)
        expect(solver.item_name).to_equal("ImplBlock")
        expect(methods.item_name).to_equal("ImplBlock")
        expect(private_facade.found).to_equal(false)
        expect(solver.module_name).to_equal("compiler.traits.trait_impl")
        val solver_surface = surfaces.surfaces[solver.module_index]
        var solver_kind = ""
        for composite in solver_surface.composite_values:
            if composite.name == "ImplBlock": solver_kind = composite.kind
        expect(solver_kind).to_equal("struct")
        val method_surface = surfaces.surfaces[methods.module_index]
        var method_kind = ""
        for composite in method_surface.composite_values:
            if composite.name == "ImplBlock": method_kind = composite.kind
        expect(method_kind).to_equal("class")
        for owner in surfaces.surfaces:
            if owner.module_name == "compiler.types.type_infer.traits":
                for item_name in owner.import_item_names:
                    expect(item_name == "ImplBlock").to_equal(false)

    it "the repaired actual conversion owner exposes a named route to solver ImplBlock":
        val sources = owner_route_sources(true)
        var modules: Dict<text, ParserModule> = {}
        for source in sources:
            modules[source.module_name] = parse_full_frontend(
                source.content, source.path, source.module_name, Logger(level: 0))
        val result = module_surfaces_from_modules(modules, sources)
        expect(result.is_ok()).to_equal(true)
        val surfaces = result.unwrap()
        var lowering = hirlowering_for_module("probe.owner.consumer", surfaces)
        var named_routes = 0
        for owner in surfaces.surfaces:
            if owner.module_name == "compiler.types.type_infer.traits":
                for route in 0..owner.imports.len():
                    val start = owner.import_item_offsets[route]
                    val end = owner.import_item_offsets[route + 1]
                    for item in start..end:
                        if owner.import_item_names[item] == "ImplBlock":
                            val candidate = lowering.canonical_callable_dependency_candidate(
                                owner.import_target_indices[route], "ImplBlock")
                            expect(candidate.found).to_equal(true)
                            expect(candidate.module_name).to_equal("compiler.traits.trait_impl")
                            named_routes = named_routes + 1
        expect(named_routes).to_equal(1)
