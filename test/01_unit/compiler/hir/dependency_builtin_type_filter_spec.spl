# @cover src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl
# Class A (callable half) regression for
# doc/08_tracking/bug/hir_unresolved_type_owner_missing_import_2026-08-22.md
#
# Payload- and callable-dependency materialization asked every DECLARING module
# to own every name a signature mentions, including primitives. No module
# declares `text` or `i64`, so each one resolved to not-found and printed a
# `[hir-payload-origin-unresolved]` advisory: 12,171 of 12,364 advisory lines in
# stage-1 run13 (98.4%), burying the ONE genuine finding (BlockValue, 193).
#
# The filter is deliberately lowercase-only plus `Any`. The capitalized dialect
# aliases and container spellings are NOT filtered, because lower_named_kind
# places their arms AFTER the symbol lookup so a DECLARED type of the same name
# wins -- and such declarations exist in this tree (`struct Bool` in
# */ndarray/mod.spl, 42 `Result`, 14 `Option`, 10 `Array`, 1 `Dict`). Filtering
# those would silently stop materializing a real user type: a correctness
# regression, not noise reduction.
#
# FAILS pre-fix: `hir_dependency_is_builtin_type` does not exist.
use std.spec.{describe, it, expect}
use compiler.hir.hir_lowering.items.{hir_dependency_is_builtin_type}

describe "signature-dependency builtin filter":
    it "filters the primitive spellings that flooded the run13 advisories":
        expect(hir_dependency_is_builtin_type("text")).to_be_true()
        expect(hir_dependency_is_builtin_type("i64")).to_be_true()
        expect(hir_dependency_is_builtin_type("i32")).to_be_true()
        expect(hir_dependency_is_builtin_type("u8")).to_be_true()
        expect(hir_dependency_is_builtin_type("bool")).to_be_true()
        expect(hir_dependency_is_builtin_type("f64")).to_be_true()
        expect(hir_dependency_is_builtin_type("char")).to_be_true()
        expect(hir_dependency_is_builtin_type("Any")).to_be_true()
        expect(hir_dependency_is_builtin_type("")).to_be_true()

    it "does NOT filter names a user module can really declare":
        # Every one of these has at least one real declaration in the tree.
        expect(hir_dependency_is_builtin_type("Bool")).to_be_false()
        expect(hir_dependency_is_builtin_type("Int")).to_be_false()
        expect(hir_dependency_is_builtin_type("Char")).to_be_false()
        expect(hir_dependency_is_builtin_type("String")).to_be_false()
        expect(hir_dependency_is_builtin_type("Float")).to_be_false()
        expect(hir_dependency_is_builtin_type("Option")).to_be_false()
        expect(hir_dependency_is_builtin_type("Result")).to_be_false()
        expect(hir_dependency_is_builtin_type("Dict")).to_be_false()
        expect(hir_dependency_is_builtin_type("Array")).to_be_false()
        expect(hir_dependency_is_builtin_type("CodegenTarget")).to_be_false()
        expect(hir_dependency_is_builtin_type("BlockValue")).to_be_false()
