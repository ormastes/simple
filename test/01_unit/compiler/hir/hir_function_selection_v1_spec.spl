use std.spec.{describe, it, expect}
use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}
use compiler.hir.hir_function_selection_v1.{sorted_function_indices,
    is_generic_function, hir_prune_published_templates_v1}

fn selection_function_v1(id: i64, name: text, type_params: [HirTypeParam],
        is_generic_template: bool = false) -> HirFunction:
    HirFunction(symbol: SymbolId(id: id), name: name,
        type_params: type_params, params: [],
        return_type: HirType(kind: HirTypeKind.Unit, span: Span.empty()),
        body: HirBlock(stmts: [], has: false,
            value: HirExpr(kind: HirExprKind.NilLit, has_type_: false,
                type_: nil, span: Span.empty()), span: Span.empty()),
        effects: [], visibility: Visibility.Public, is_async: false,
        is_static: false, is_public: true, is_method: false, is_mutable: false,
        is_const: false, is_extern: false, func_attr: FunctionAttr.default(),
        has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false, vhdl_metadata: nil,
        has_doc_comment: false, doc_comment: "", span: Span.empty(),
        is_gpu_kernel: false, gpu_target: "", gpu_backend_order: "",
        verification_contract: nil, is_generic_template: is_generic_template)

fn selection_type_parameter_v1(id: i64) -> HirTypeParam:
    HirTypeParam(symbol: SymbolId(id: id), name: "T", bounds: [],
        has_default: false, default: nil, span: Span.empty())

fn selection_module_v1(functions: [HirFunction]) -> HirModule:
    var by_symbol: Dict<SymbolId, HirFunction> = {}
    for function in functions:
        by_symbol[function.symbol] = function
    HirModule(name: "selection", path: "selection.spl", imports: [],
        exports: [], domain_blocks: [], symbols: SymbolTable.new(),
        functions: by_symbol, gpu_function_targets: {},
        gpu_function_backend_orders: {}, classes: {}, structs: {}, enums: {},
        bitfields: {}, traits: {}, impls: [], constants: {}, static_asserts: [],
        aop_advices: [], di_bindings: [], arch_rules: [], mock_decls: [],
        types: [], extend_enums: [])

fn selection_count_named_v1(module: HirModule, name: text) -> i64:
    var count = 0
    for symbol in module.functions.keys():
        if module.functions[symbol] != nil and module.functions[symbol].name == name:
            count = count + 1
    count

describe "HIR function selection and published template pruning":
    it "orders real HIR function value indices by ascending symbol id stably":
        val functions = [
            selection_function_v1(9, "late", []),
            selection_function_v1(2, "first", []),
            selection_function_v1(2, "second", []),
            selection_function_v1(5, "middle", [])]
        expect(sorted_function_indices(functions)).to_equal([1, 2, 3, 0])

    it "classifies generic declarations by a non-empty type parameter list":
        val generic = selection_function_v1(1, "generic",
            [selection_type_parameter_v1(11)])
        val plain = selection_function_v1(2, "plain", [])
        expect(is_generic_function(generic)).to_equal(true)
        expect(is_generic_function(plain)).to_equal(false)

    it "returns the unchanged real module when there are no emitted templates":
        val unused = selection_function_v1(20, "unused",
            [selection_type_parameter_v1(21)])
        val ordinary = selection_function_v1(22, "ordinary", [])
        val input = selection_module_v1([unused, ordinary])
        val output = hir_prune_published_templates_v1(input, [], ["unused"])
        expect(output.functions.keys().len()).to_equal(2)
        expect(selection_count_named_v1(output, "unused")).to_equal(1)
        expect(selection_count_named_v1(output, "ordinary")).to_equal(1)

    it "removes only exact emitted generic definitions and keeps unresolved, ordinary and specialized functions":
        val consumed = selection_function_v1(1, "consumed",
            [selection_type_parameter_v1(11)])
        val unresolved = selection_function_v1(2, "unresolved",
            [selection_type_parameter_v1(12)])
        val mismatched = selection_function_v1(3, "mismatched",
            [selection_type_parameter_v1(13)])
        val ordinary = selection_function_v1(4, "ordinary", [])
        val flag_only = selection_function_v1(5, "flag_only", [], true)
        val specialization = selection_function_v1(6, "flag_only$i64", [])
        var input = selection_module_v1([consumed, unresolved, mismatched,
            ordinary, flag_only, specialization])
        input.gpu_function_targets["kernel"] = "cuda"

        val output = hir_prune_published_templates_v1(input,
            ["consumed", "unresolved", "mismatched_from_elsewhere",
                "flag_only", "ordinary", "unknown"],
            ["unresolved"])

        expect(selection_count_named_v1(output, "consumed")).to_equal(0)
        expect(selection_count_named_v1(output, "unresolved")).to_equal(1)
        expect(selection_count_named_v1(output, "mismatched")).to_equal(1)
        expect(selection_count_named_v1(output, "ordinary")).to_equal(1)
        expect(selection_count_named_v1(output, "flag_only")).to_equal(0)
        expect(selection_count_named_v1(output, "flag_only$i64")).to_equal(1)
        expect(selection_count_named_v1(output, "unknown")).to_equal(0)
        expect(output.functions.keys().len()).to_equal(4)
        expect(output.gpu_function_targets["kernel"]).to_equal("cuda")
        expect(output.name).to_equal(input.name)
        expect(input.functions.keys().len()).to_equal(6)
        expect(selection_count_named_v1(input, "consumed")).to_equal(1)
