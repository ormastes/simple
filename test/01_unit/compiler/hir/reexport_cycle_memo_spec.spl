use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}
use std.spec.{describe, it, expect}

fn cycle_memo_logger() -> Logger:
    Logger(level: 0)

describe "HIR re-export cycle memo":
    it "terminates a cyclic miss and retains the root result for reuse":
        val log = cycle_memo_logger()
        val a_source = "use cycle.b.*"
        val b_source = "use cycle.a.*"
        val a = parse_full_frontend(a_source, "cycle.a", "cycle.a", log)
        val b = parse_full_frontend(b_source, "cycle.b", "cycle.b", log)
        var modules: Dict<text, Module> = {}
        modules["cycle.a"] = a
        modules["cycle.b"] = b
        val sources = [
            SourceFile(path: "cycle/a.spl", content: a_source, module_name: "cycle.a"),
            SourceFile(path: "cycle/b.spl", content: b_source, module_name: "cycle.b")
        ]
        val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
        val facade = surfaces.surfaces[surfaces.index_by_name["cycle.a"]]
        var lowering = hirlowering_for_module("cycle.consumer", surfaces)
        val first = lowering.find_reexport_source(facade, "cycle.a", "NeverThere", 0)
        expect(first.found).to_equal(false)
        var first_snapshot = lowering.module_surfaces
        expect(first_snapshot.reexport_count()).to_equal(1)

        # Thread the persisted snapshot into a second lowering.  The seed
        # interpreter is Arc/COW and cannot prove live cross-copy class alias
        # mutation; the MIR class prescan covers that native ABI path.
        var second_lowering = hirlowering_for_module("cycle.other_consumer", first_snapshot)
        var second_snapshot = second_lowering.module_surfaces
        expect(second_snapshot.reexport_count()).to_equal(1)
        val second = second_lowering.find_reexport_source(facade, "cycle.a", "NeverThere", 0)
        expect(second.found).to_equal(false)
        second_snapshot = second_lowering.module_surfaces
        expect(second_snapshot.reexport_count()).to_equal(1)

    it "retains a positive result reached through a cyclic facade graph":
        val log = cycle_memo_logger()
        val owner_source = "pub fn Stable() -> i64:\n    1"
        val a_source = "use cycle.b.*"
        val b_source = "use cycle.a.*\nuse cycle.owner.*"
        val owner = parse_full_frontend(owner_source, "cycle.owner", "cycle.owner", log)
        val a = parse_full_frontend(a_source, "cycle.a", "cycle.a", log)
        val b = parse_full_frontend(b_source, "cycle.b", "cycle.b", log)
        var modules: Dict<text, Module> = {}
        modules["cycle.owner"] = owner
        modules["cycle.a"] = a
        modules["cycle.b"] = b
        val sources = [
            SourceFile(path: "cycle/owner.spl", content: owner_source, module_name: "cycle.owner"),
            SourceFile(path: "cycle/a.spl", content: a_source, module_name: "cycle.a"),
            SourceFile(path: "cycle/b.spl", content: b_source, module_name: "cycle.b")
        ]
        val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
        val facade = surfaces.surfaces[surfaces.index_by_name["cycle.a"]]
        var lowering = hirlowering_for_module("cycle.consumer", surfaces)
        val resolved = lowering.find_reexport_source(facade, "cycle.a", "Stable", 0)
        expect(resolved.found).to_equal(true)
        expect(resolved.module_name).to_equal("cycle.owner")
        expect(resolved.item_name).to_equal("Stable")
        var persisted_snapshot = lowering.module_surfaces
        expect(persisted_snapshot.reexport_count()).to_equal(1)

        # Exercise the completed positive cache entry through a second
        # lowering.  Stage4 previously corrupted the aggregate cache payload
        # at exactly this native ABI boundary.
        var cached_lowering = hirlowering_for_module("cycle.cached_consumer", persisted_snapshot)
        val cached = cached_lowering.find_reexport_source(facade, "cycle.a", "Stable", 0)
        expect(cached.found).to_equal(true)
        expect(cached.module_name).to_equal("cycle.owner")
        expect(cached.item_name).to_equal("Stable")
        persisted_snapshot = cached_lowering.module_surfaces
        expect(persisted_snapshot.reexport_count()).to_equal(1)

    it "does not carry a completed lookup into a fresh surface snapshot":
        val log = cycle_memo_logger()
        val owner_source = "pub fn Stable() -> i64:\n    1"
        val changed_owner_source = "pub fn Replaced() -> i64:\n    2"
        val a_source = "use cycle.b.*"
        val b_source = "use cycle.a.*\nuse cycle.owner.*"
        val owner = parse_full_frontend(owner_source, "cycle.owner", "cycle.owner", log)
        val a = parse_full_frontend(a_source, "cycle.a", "cycle.a", log)
        val b = parse_full_frontend(b_source, "cycle.b", "cycle.b", log)
        var modules: Dict<text, Module> = {}
        modules["cycle.owner"] = owner
        modules["cycle.a"] = a
        modules["cycle.b"] = b
        val sources = [
            SourceFile(path: "cycle/owner.spl", content: owner_source, module_name: "cycle.owner"),
            SourceFile(path: "cycle/a.spl", content: a_source, module_name: "cycle.a"),
            SourceFile(path: "cycle/b.spl", content: b_source, module_name: "cycle.b")
        ]
        val first_surfaces = module_surfaces_from_modules(modules, sources).unwrap()
        val first_facade = first_surfaces.surfaces[first_surfaces.index_by_name["cycle.a"]]
        var first_lowering = hirlowering_for_module("cycle.first_consumer", first_surfaces)
        val first = first_lowering.find_reexport_source(first_facade, "cycle.a", "Stable", 0)
        expect(first.found).to_equal(true)
        expect(first_lowering.module_surfaces.reexport_count()).to_equal(1)

        val changed_owner = parse_full_frontend(changed_owner_source, "cycle.owner", "cycle.owner", log)
        var changed_modules: Dict<text, Module> = {}
        changed_modules["cycle.owner"] = changed_owner
        changed_modules["cycle.a"] = a
        changed_modules["cycle.b"] = b
        val changed_sources = [
            SourceFile(path: "cycle/owner.spl", content: changed_owner_source, module_name: "cycle.owner"),
            SourceFile(path: "cycle/a.spl", content: a_source, module_name: "cycle.a"),
            SourceFile(path: "cycle/b.spl", content: b_source, module_name: "cycle.b")
        ]
        val fresh_surfaces = module_surfaces_from_modules(changed_modules, changed_sources).unwrap()
        val fresh_facade = fresh_surfaces.surfaces[fresh_surfaces.index_by_name["cycle.a"]]
        var fresh_lowering = hirlowering_for_module("cycle.fresh_consumer", fresh_surfaces)
        val fresh = fresh_lowering.find_reexport_source(fresh_facade, "cycle.a", "Stable", 0)
        expect(fresh.found).to_equal(false)
        expect(fresh_lowering.module_surfaces.reexport_count()).to_equal(1)
