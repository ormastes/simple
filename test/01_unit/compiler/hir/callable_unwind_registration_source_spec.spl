# @cover src/compiler/10.frontend/parser_extensions.spl
# @cover src/compiler/20.hir/hir_lowering/module_surface.spl
# @cover src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl
# @cover src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl

extern fn rt_file_read_text(path: text) -> text

use std.spec.*

fn source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "Parser attributes reach registered HIR callable types":
    it "keeps generic parser attributes on functions":
        val parser = source("src/compiler/10.frontend/parser_extensions.spl")
        expect(parser).to_contain("val attr_name = self.current().text")
        expect(parser).to_contain("attributes: attributes")

    it "derives the declaration and symbol type effect rows from the same attributes":
        val declarations = source(
            "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl")
        val modules = source(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl")
        expect(declarations).to_contain(
            "hir_function_effects_from_attributes(")
        expect(declarations).to_contain(
            "fn_.attributes, fn_.is_async, fn_.span")
        expect(modules).to_contain(
            "fn_decl.attributes, fn_decl.is_async, fn_decl.span")

    it "retains attributes across local and imported module surfaces":
        val surface = source(
            "src/compiler/20.hir/hir_lowering/module_surface.spl")
        val modules = source(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl")
        expect(surface).to_contain("unwind_attribute: text")
        expect(surface).to_contain("for attribute in function_.attributes")
        expect(modules).to_contain(
            "declared_surface_callable_effects(self, callable)")
