# Own declarations and imported dependencies must share one nominal ID.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.optional_record_owner.*

describe "Own struct dependency identity":
    it "reuses WalEntry when its return dependency is materialized in its owner":
        val owner = "probe.wal"
        val source = "pub struct WalEntry:\n    sequence: i64\n    data: text\nfn parse_entry() -> WalEntry?:\n    nil\n"
        val parsed = parse_full_frontend(source, owner, owner, Logger(level: 0))
        var modules: Dict<text, Module> = {}
        modules[owner] = parsed
        val registry = module_surfaces_from_modules(modules, [SourceFile(path: owner, content: source, module_name: owner)]).unwrap()
        var lowering = hirlowering_for_module(owner, registry)
        lowering.declare_module_symbols(parsed)
        val original = lowering.symbols.local_type_binding_raw("WalEntry")
        expect(original).to_be_greater_than(-1)
        expect(lowering.symbols.lookup_qualified_type_raw(owner, "WalEntry")).to_equal(original)
        val allocated = lowering.symbols.next_symbol_id
        lowering.register_imported_symbol(registry.index_by_name[owner], owner, "WalEntry", "probe.wal::WalEntry", Span.empty(), true)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.symbols.next_symbol_id).to_equal(allocated)
        expect(lowering.symbols.local_type_binding_raw("probe.wal::WalEntry")).to_equal(original)
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var mir = MirLowering.new(hir.symbols)
        var prescan_mods: Dict<text, HirModule> = {}
        prescan_mods["hir"] = hir
        mir.prescan_module_struct_names(prescan_mods, "hir")
        val lowered = mir.lower_module(hir, [hir])
        expect(lowered.functions.len()).to_be_greater_than(0)
        # Synthetic local exercises only the owner lookup contract; this is
        # not an execution test of a generated Optional payload or match.
        mir.optional_record_owners[9000] = "probe.wal::WalEntry"
        match mir.checked_optional_record_type(9000, Span.empty()).kind:
            case HirTypeKind.Named(id, _): expect(id.id).to_equal(original)
            case _: fail("own Optional record dependency lost its declaration")
        expect(mir.errors.len()).to_equal(0)

    it "adopts a same-owner dependency materialized before own declarations":
        val owner = "probe.wal"
        val source = "pub struct WalEntry:\n    sequence: i64\n    data: text\n"
        val parsed = parse_full_frontend(source, owner, owner, Logger(level: 0))
        var modules: Dict<text, Module> = {}
        modules[owner] = parsed
        val registry = module_surfaces_from_modules(modules, [SourceFile(path: owner, content: source, module_name: owner)]).unwrap()
        var lowering = hirlowering_for_module(owner, registry)
        lowering.register_imported_symbol(registry.index_by_name[owner], owner, "WalEntry", "probe.wal::WalEntry", Span.empty(), true)
        val dependency = lowering.symbols.lookup_qualified_type_raw(owner, "WalEntry")
        expect(dependency).to_be_greater_than(-1)
        val allocated = lowering.symbols.next_symbol_id
        lowering.declare_module_symbols(parsed)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.symbols.next_symbol_id).to_equal(allocated)
        expect(lowering.symbols.local_type_binding_raw("WalEntry")).to_equal(dependency)
        expect(lowering.symbols.lookup_qualified_type_raw(owner, "WalEntry")).to_equal(dependency)
        lowering.declare_module_symbols(parsed)
        expect(lowering.symbols.next_symbol_id).to_equal(allocated)
        expect(lowering.errors.len()).to_equal(0)

    it "publishes bitfield declaration identity":
        val owner = "probe.flags"
        val source = "bitfield ControlReg(u32):\n    ready: u1\n    mode: u3\n"
        val parsed = parse_full_frontend(source, owner, owner, Logger(level: 0))
        var modules: Dict<text, Module> = {}
        modules[owner] = parsed
        val registry = module_surfaces_from_modules(modules, [SourceFile(path: owner, content: source, module_name: owner)]).unwrap()
        var lowering = hirlowering_for_module(owner, registry)
        lowering.declare_module_symbols(parsed)
        val declaration = lowering.symbols.local_type_binding_raw("ControlReg")
        expect(declaration).to_be_greater_than(-1)
        expect(lowering.symbols.lookup_qualified_type_raw(owner, "ControlReg")).to_equal(declaration)
        expect(lowering.symbols.symbols[declaration].kind).to_equal(SymbolKind.Struct)
        expect(lowering.errors.len()).to_equal(0)

    it "keeps rejecting a conflicting qualified declaration":
        var lowering = hirlowering_for_module("probe.wal", module_surfaces_from_modules({}, []).unwrap())
        val original = lowering.define_own_module_type("WalEntry", SymbolKind.Struct, Span.empty(), Visibility.Public, Some("probe.wal"))
        lowering.publish_own_struct_identity("WalEntry", original, Span.empty())
        val duplicate = lowering.symbols.define_with_binding("duplicate", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, Some("probe.wal"), false)
        var declaration: HirSymbol = lowering.symbols.symbols[duplicate.id]
        declaration.name = "WalEntry"
        lowering.symbols.symbols[duplicate.id] = declaration
        lowering.publish_own_struct_identity("WalEntry", duplicate, Span.empty())
        expect(lowering.symbols.lookup_qualified_type_raw("probe.wal", "WalEntry")).to_equal(original.id)
        var rejected = false
        for error in lowering.errors:
            if error.message.contains("conflicting qualified declarations"): rejected = true
        expect(rejected).to_be(true)

    it "rejects a distinct own lexical declaration instead of merging IDs":
        var lowering = hirlowering_for_module("probe.wal", module_surfaces_from_modules({}, []).unwrap())
        val original = lowering.define_own_module_type("WalEntry", SymbolKind.Struct, Span.empty(), Visibility.Public, Some("probe.wal"))
        lowering.publish_own_struct_identity("WalEntry", original, Span.empty())
        val duplicate = lowering.symbols.define_with_binding("duplicate", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, Some("probe.wal"), false)
        var declaration: HirSymbol = lowering.symbols.symbols[duplicate.id]
        declaration.name = "WalEntry"
        lowering.symbols.symbols[duplicate.id] = declaration
        lowering.symbols.rebind_local_type("WalEntry", duplicate)
        val returned = lowering.define_own_module_type("WalEntry", SymbolKind.Struct, Span.empty(), Visibility.Public, Some("probe.wal"))
        expect(returned.id).to_equal(duplicate.id)
        expect(lowering.symbols.local_type_binding_raw("WalEntry")).to_equal(duplicate.id)
        expect(lowering.symbols.lookup_qualified_type_raw("probe.wal", "WalEntry")).to_equal(original.id)
        var rejected = false
        for error in lowering.errors:
            if error.message.contains("conflicting lexical declarations"): rejected = true
        expect(rejected).to_be(true)
