use std.io.{file_read}
use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.core.ast.{ast_reset, decl_count, expr_count, stmt_count}
use compiler.core.parser.{parser_error_count, parser_release_parse_globals}
use compiler.frontend.core.lexer.{
    lexer_release_parse_source_globals,
    lex_cur_kind_get,
    lex_cur_text_get,
    lex_cur_line_get,
    lex_cur_col_get
}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.flat_ast_bridge.{frontend_prepare_transient_parse_scope}
use compiler.frontend.frontend_parse_ownership.{frontend_discard_failed_parse_registries, frontend_promote_compilation_registries}
use compiler.hir.hir_lowering.module_surface.{
    ModuleSurfaceParserOwner,
    module_surface_promote
}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

fn dict_key_count<T>(values: Dict<text, T>) -> i64:
    # Dict.len() is intentionally not a native cardinality API. Materialize the
    # exact keys boundary that regressed, then count the resulting array.
    val keys = values.keys()
    keys.len()

fn finish_transient_surface_scope() -> bool:
    # Idempotent pause makes this helper cover success and pre-pause parse
    # errors with the production ordering.
    val paused = rt_transient_array_scope_pause()
    parser_release_parse_globals()
    lexer_release_parse_source_globals()
    val promoted = if paused: frontend_promote_compilation_registries() else: false
    val ended = rt_transient_array_scope_end()
    # Match the production driver's load-bearing cleanup order: reset the
    # process-lifetime parser arenas only after transient allocations are gone.
    ast_reset()
    paused and promoted and ended

describe "module surface parser owner transient value semantics":
    it "retains ordinary surfaces and bounds an import-only facade extraction":
        val first_content = "pub fn first_value() -> i64:\n    11\n"
        val second_content = "pub struct SecondValue:\n    count: i64\n"
        val facade_path = "src/compiler/00.common/driver_core_types.spl"
        val facade_content = file_read(facade_path)
        val logger = Logger(level: 0)

        # First-touch process-lifetime AST/parser/lexer owners outside every
        # transient scope, matching both production streaming phases.
        frontend_prepare_transient_parse_scope()

        # Ordinary module 1: extract, promote, and tear down its parse arena.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val first_module = parse_full_frontend(
            first_content, "owner_transient_first.spl", "owner_transient.first", logger)
        var first_owner = ModuleSurfaceParserOwner(
            parsed_path: first_module.name,
            imports: first_module.imports,
            exports: first_module.exports,
            functions: first_module.functions,
            function_headers: first_module.function_headers,
            classes: first_module.classes,
            actors: first_module.actors,
            structs: first_module.structs,
            enums: first_module.enums,
            traits: first_module.traits,
            impls: first_module.impls,
            type_aliases: first_module.type_aliases,
            constants: first_module.constants)
        val first_result = first_owner.surface(
            SourceFile(
                path: "owner_transient_first.spl",
                content: first_content,
                module_name: "owner_transient.first"),
            0)
        expect(first_result.is_ok()).to_equal(true)
        val first_surface = first_result.unwrap()
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(module_surface_promote(first_surface)).to_equal(true)
        expect(finish_transient_surface_scope()).to_equal(true)
        expect(dict_key_count(first_surface.callables)).to_equal(1)
        expect(dict_key_count(first_surface.composites)).to_equal(0)

        # Ordinary module 2 proves that the prior promoted surface survives a
        # later parse/reset before the import-only facade reaches extraction.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val second_module = parse_full_frontend(
            second_content, "owner_transient_second.spl", "owner_transient.second", logger)
        # Reading every persistent frontend owner family on the second parse is
        # the focused UAF regression: the first scope has already been ended.
        val second_decl_count = decl_count()
        val second_expr_count = expr_count()
        val second_stmt_count = stmt_count()
        val second_parser_errors = parser_error_count()
        val second_lex_kind = lex_cur_kind_get()
        val second_lex_text_len = lex_cur_text_get().len()
        val second_lex_line = lex_cur_line_get()
        val second_lex_col = lex_cur_col_get()
        expect(second_decl_count).to_be_greater_than(0)
        expect(second_expr_count).to_be_greater_than(-1)
        expect(second_stmt_count).to_be_greater_than(-1)
        expect(second_parser_errors).to_equal(0)
        expect(second_lex_kind).to_be_greater_than(-2)
        expect(second_lex_text_len).to_be_greater_than(-1)
        expect(second_lex_line).to_be_greater_than(0)
        expect(second_lex_col).to_be_greater_than(-1)
        var second_owner = ModuleSurfaceParserOwner(
            parsed_path: second_module.name,
            imports: second_module.imports,
            exports: second_module.exports,
            functions: second_module.functions,
            function_headers: second_module.function_headers,
            classes: second_module.classes,
            actors: second_module.actors,
            structs: second_module.structs,
            enums: second_module.enums,
            traits: second_module.traits,
            impls: second_module.impls,
            type_aliases: second_module.type_aliases,
            constants: second_module.constants)
        val second_result = second_owner.surface(
            SourceFile(
                path: "owner_transient_second.spl",
                content: second_content,
                module_name: "owner_transient.second"),
            1)
        expect(second_result.is_ok()).to_equal(true)
        val second_surface = second_result.unwrap()
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(module_surface_promote(second_surface)).to_equal(true)
        expect(finish_transient_surface_scope()).to_equal(true)
        expect(dict_key_count(first_surface.callables)).to_equal(1)
        expect(dict_key_count(second_surface.callables)).to_equal(0)
        expect(dict_key_count(second_surface.composites)).to_equal(1)

        # The Stage3 failure appeared here: after two ordinary modules, this
        # import-only facade had empty declaration dictionaries. Copying the
        # whole ParserModule through ModuleSurfaceParserOwner.new(module)
        # corrupted the first empty keys() walk and materialized geometric
        # transient arrays. Capture every consumed field on both sides of the
        # owner construction before asking extraction to walk those keys.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val facade_module = parse_full_frontend(
            facade_content, facade_path, "compiler.common.driver_core_types", logger)
        val before_imports = facade_module.imports.len()
        val before_exports = facade_module.exports.len()
        val before_functions = dict_key_count(facade_module.functions)
        val before_headers = dict_key_count(facade_module.function_headers)
        val before_classes = dict_key_count(facade_module.classes)
        val before_actors = dict_key_count(facade_module.actors)
        val before_structs = dict_key_count(facade_module.structs)
        val before_enums = dict_key_count(facade_module.enums)
        val before_traits = dict_key_count(facade_module.traits)
        val before_impls = facade_module.impls.len()
        val before_aliases = dict_key_count(facade_module.type_aliases)
        val before_constants = dict_key_count(facade_module.constants)

        var facade_owner = ModuleSurfaceParserOwner(
            parsed_path: facade_module.name,
            imports: facade_module.imports,
            exports: facade_module.exports,
            functions: facade_module.functions,
            function_headers: facade_module.function_headers,
            classes: facade_module.classes,
            actors: facade_module.actors,
            structs: facade_module.structs,
            enums: facade_module.enums,
            traits: facade_module.traits,
            impls: facade_module.impls,
            type_aliases: facade_module.type_aliases,
            constants: facade_module.constants)
        val owner_imports = facade_owner.imports.len()
        val owner_exports = facade_owner.exports.len()
        val owner_functions = dict_key_count(facade_owner.functions)
        val owner_headers = dict_key_count(facade_owner.function_headers)
        val owner_classes = dict_key_count(facade_owner.classes)
        val owner_actors = dict_key_count(facade_owner.actors)
        val owner_structs = dict_key_count(facade_owner.structs)
        val owner_enums = dict_key_count(facade_owner.enums)
        val owner_traits = dict_key_count(facade_owner.traits)
        val owner_impls = facade_owner.impls.len()
        val owner_aliases = dict_key_count(facade_owner.type_aliases)
        val owner_constants = dict_key_count(facade_owner.constants)

        val facade_result = facade_owner.surface(
            SourceFile(
                path: facade_path,
                content: facade_content,
                module_name: "compiler.common.driver_core_types"),
            2)
        expect(facade_result.is_ok()).to_equal(true)
        val facade_surface = facade_result.unwrap()
        val surface_imports = facade_surface.imports.len()
        val surface_exports = facade_surface.exports.len()
        val surface_callables = dict_key_count(facade_surface.callables)
        val surface_composites = dict_key_count(facade_surface.composites)
        val surface_enums = dict_key_count(facade_surface.enums)
        val surface_traits = dict_key_count(facade_surface.traits)
        val surface_impls = facade_surface.impls.len()
        val surface_aliases = dict_key_count(facade_surface.type_aliases)
        val surface_constants = dict_key_count(facade_surface.constants)
        val surface_origins = dict_key_count(facade_surface.export_origins)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(module_surface_promote(facade_surface)).to_equal(true)
        expect(finish_transient_surface_scope()).to_equal(true)

        # Scalar snapshots prove construction and extraction preserved the
        # import-only shape. The bounded empty-map walks are also the regression
        # gate: the old geometric allocation never reached these assertions.
        expect(before_imports).to_equal(4)
        expect(before_exports).to_equal(0)
        expect(before_functions).to_equal(0)
        expect(before_headers).to_equal(0)
        expect(before_classes).to_equal(0)
        expect(before_actors).to_equal(0)
        expect(before_structs).to_equal(0)
        expect(before_enums).to_equal(0)
        expect(before_traits).to_equal(0)
        expect(before_impls).to_equal(0)
        expect(before_aliases).to_equal(0)
        expect(before_constants).to_equal(0)
        expect(owner_imports).to_equal(before_imports)
        expect(owner_exports).to_equal(before_exports)
        expect(owner_functions).to_equal(before_functions)
        expect(owner_headers).to_equal(before_headers)
        expect(owner_classes).to_equal(before_classes)
        expect(owner_actors).to_equal(before_actors)
        expect(owner_structs).to_equal(before_structs)
        expect(owner_enums).to_equal(before_enums)
        expect(owner_traits).to_equal(before_traits)
        expect(owner_impls).to_equal(before_impls)
        expect(owner_aliases).to_equal(before_aliases)
        expect(owner_constants).to_equal(before_constants)
        expect(surface_imports).to_equal(before_imports)
        expect(surface_exports).to_equal(before_exports)
        expect(surface_callables).to_equal(before_functions)
        expect(surface_composites).to_equal(0)
        expect(surface_enums).to_equal(before_enums)
        expect(surface_traits).to_equal(before_traits)
        expect(surface_impls).to_equal(before_impls)
        expect(surface_aliases).to_equal(before_aliases)
        expect(surface_constants).to_equal(before_constants)
        expect(surface_origins).to_equal(0)

        # All three promoted surfaces remain readable after the facade arena
        # has been reclaimed and parser globals have been reset for a reparse.
        expect(dict_key_count(first_surface.callables)).to_equal(1)
        expect(dict_key_count(second_surface.composites)).to_equal(1)
        expect(facade_surface.imports.len()).to_equal(4)
        expect(dict_key_count(facade_surface.callables)).to_equal(0)
        expect(first_surface.callable_names).to_equal(["first_value"])
        expect(second_surface.composite_names).to_equal(["SecondValue"])
        expect(facade_surface.callable_names).to_equal([])
        expect(facade_surface.composite_names).to_equal([])
        expect(facade_surface.imports[0].module).to_equal(
            "compiler.common.driver_core_modes")
        expect(facade_surface.imports[3].module).to_equal(
            "compiler.common.driver_source_file")

    it "recovers after a malformed first module without stale frontend owners":
        val logger = Logger(level: 0)
        val failed_path = "owner_transient_malformed.spl"
        val valid_path = "owner_transient_recovered.spl"
        frontend_prepare_transient_parse_scope()

        # This exits before the normal success-path pause.  Snapshot every
        # owner family while live, discard the failed module's registry rows,
        # then close through the same promotion/detach boundary as production.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val _failed_module = parse_full_frontend(
            "fn malformed(\n", failed_path, "owner_transient.malformed", logger)
        val failed_parser_errors = parser_error_count()
        val failed_decl_count = decl_count()
        val failed_expr_count = expr_count()
        val failed_stmt_count = stmt_count()
        val failed_lex_kind = lex_cur_kind_get()
        val failed_lex_text_len = lex_cur_text_get().len()
        expect(failed_parser_errors).to_be_greater_than(0)
        expect(failed_decl_count).to_be_greater_than(-1)
        expect(failed_expr_count).to_be_greater_than(-1)
        expect(failed_stmt_count).to_be_greater_than(-1)
        expect(failed_lex_kind).to_be_greater_than(-2)
        expect(failed_lex_text_len).to_be_greater_than(-1)
        frontend_discard_failed_parse_registries(failed_path)
        expect(finish_transient_surface_scope()).to_equal(true)
        expect(decl_count()).to_equal(0)
        expect(expr_count()).to_equal(0)
        expect(stmt_count()).to_equal(0)
        expect(lex_cur_kind_get()).to_equal(0)
        expect(lex_cur_text_get()).to_equal("")

        # A valid second file must populate the same durable shells and remain
        # readable; this is the exact stale-slot/UAF recovery edge.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val recovered_module = parse_full_frontend(
            "pub fn recovered() -> i64:\n    7\n",
            valid_path,
            "owner_transient.recovered",
            logger)
        val recovered_decl_count = decl_count()
        val recovered_expr_count = expr_count()
        val recovered_stmt_count = stmt_count()
        val recovered_lex_line = lex_cur_line_get()
        val recovered_lex_col = lex_cur_col_get()
        expect(parser_error_count()).to_equal(0)
        expect(recovered_module.functions.contains("recovered")).to_equal(true)
        expect(recovered_decl_count).to_be_greater_than(0)
        expect(recovered_expr_count).to_be_greater_than(-1)
        expect(recovered_stmt_count).to_be_greater_than(-1)
        expect(recovered_lex_line).to_be_greater_than(0)
        expect(recovered_lex_col).to_be_greater_than(-1)
        expect(finish_transient_surface_scope()).to_equal(true)
        expect(decl_count()).to_equal(0)
        expect(lex_cur_kind_get()).to_equal(0)
