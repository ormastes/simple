"""
# Imported GENERIC Callable Signature Projection — Unit Spec

Third mechanism behind the stage-1 `unresolved type` / lost-signature population
tracked in `hir_unresolved_type_owner_missing_import_2026-08-22.md`.

`declared_imported_surface_callable_type` opened with

    if callable.type_params.len() > 0 or not callable.has_return_type:
        return nil

so a GENERIC callable's signature was never projected AT ALL. The importing
module got a `SymbolKind.Function` entry with a `nil` type — no parameter types,
no return type, and no projected identity for any cross-module type the
signature names. The population is dominated by the generated fold visitors and
codecs, whose every walker is generic:

    fn walk_ast_asm_location<C>(node: AsmLocation, ctx: C, f: fn(AstWalkNode, C) -> C) -> C

The non-generic sibling in the same module projects fine, which is what makes
this a distinct third mechanism rather than the array/pointer/union projection
gap (fixed in 9f11967564b) or the owner-missing-import gap (eeaf35d3be0).

Projecting a generic callable requires treating the callable's OWN type
parameters (`C`, `T`, ...) as bound in scope: they are not names the owner
module declares, and looking them up would trade a lost signature for a bogus
`unresolved type: C`. This spec pins both halves.

This is dependency PROJECTION, not instantiation — monomorphization stays
where the hardening plan §9 puts it.
"""

use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolKind}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}

fn generic_callable_surfaces(mods: Dict<text, Module>, srcs: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_modules(mods, srcs):
        case Ok(value): value
        case Err(error):
            assert_true(false)
            ModuleSurfacesByName.empty()

fn generic_callable_lower(owner_decl: text, imported: text) -> HirLowering:
    val log = Logger(level: 0)
    # The dependency's real owner, exactly as parser_types_expr.spl declares it.
    val ty_src = "enum AsmLocation:\n    Reg(name: text)\n"
    # The generated-visitor shape: glob-imports its dependency, declares the
    # fold node enum, and exposes one generic walker per node kind.
    val own_src =
        "use fe.parser_types_expr.*\n\nenum AstWalkNode:\n    Loc(node: AsmLocation)\n\n" + owner_decl
    val cons_src = "use vis.ast_visitor.\{" + imported + "\}\n\nfn go() -> i64:\n    1"
    var mods: Dict<text, Module> = {}
    mods["fe.parser_types_expr"] = parse_full_frontend(ty_src, "fe.parser_types_expr", "fe.parser_types_expr", log)
    mods["vis.ast_visitor"] = parse_full_frontend(own_src, "vis.ast_visitor", "vis.ast_visitor", log)
    val cons = parse_full_frontend(cons_src, "vis.consumer", "vis.consumer", log)
    mods["vis.consumer"] = cons
    val srcs = [
        SourceFile(path: "fe/parser_types_expr.spl", content: ty_src, module_name: "fe.parser_types_expr"),
        SourceFile(path: "vis/ast_visitor.spl", content: own_src, module_name: "vis.ast_visitor"),
        SourceFile(path: "vis/consumer.spl", content: cons_src, module_name: "vis.consumer")
    ]
    var lowering = hirlowering_for_module("vis.consumer", generic_callable_surfaces(mods, srcs))
    val hir = lowering.lower_module(cons)
    lowering

fn generic_callable_param_count(lowering: HirLowering, local_name: text) -> i64:
    """Parameter count of the projected signature, or -1 when NOTHING was projected."""
    val sym_id = lowering.symbols.lookup_or_invalid(local_name)
    if not sym_id.is_valid():
        return -2
    if not lowering.symbols.symbols.has(sym_id.id):
        return -3
    val sym = lowering.symbols.symbols[sym_id.id]
    if val t = sym.type_:
        match t.kind:
            case HirTypeKind.Function(params, ret, effects): params.len()
            case _: -4
    else:
        -1

val GENERIC_WALKER: text =
    "fn walk_ast_asm_location<C>(node: AsmLocation, ctx: C, f: fn(AstWalkNode, C) -> C) -> C:\n    ctx\n"
val PLAIN_WALKER: text =
    "fn walk_ast_asm_location_plain(node: AsmLocation, ctx: i64) -> i64:\n    ctx\n"

describe "imported generic callable signature projection":
    it "projects a generic callable's signature instead of dropping it":
        # Pre-fix: `declared_imported_surface_callable_type` returns nil on
        # `type_params.len() > 0`, so the imported symbol carries NO type at
        # all and this reads -1.
        val lowering = generic_callable_lower(GENERIC_WALKER, "walk_ast_asm_location")
        for error in lowering.errors:
            eprint("[generic-callable-error] {error.message}")
        expect(generic_callable_param_count(lowering, "walk_ast_asm_location")).to_equal(3)

    it "still projects the non-generic sibling that already worked":
        # Control: proves the defect is the GENERIC guard, not the module shape.
        val lowering = generic_callable_lower(PLAIN_WALKER, "walk_ast_asm_location_plain")
        expect(generic_callable_param_count(lowering, "walk_ast_asm_location_plain")).to_equal(2)

    it "does not report the callable's own type parameter as unresolved":
        # The trap the `type_params.len() > 0` bail was avoiding: `C` is bound
        # by the callable, not declared by the owner, so projecting it through
        # the owner's qualified scope would trade a lost signature for a bogus
        # `unresolved type: C`.
        val lowering = generic_callable_lower(GENERIC_WALKER, "walk_ast_asm_location")
        var type_param_errors = 0
        for error in lowering.errors:
            if error.message.contains("unresolved type: C") or
               error.message.contains("unresolved name: C"):
                eprint("[type-param-leak] {error.message}")
                type_param_errors = type_param_errors + 1
        expect(type_param_errors).to_equal(0)

    it "reports no lowering error for either shape":
        expect(generic_callable_lower(GENERIC_WALKER, "walk_ast_asm_location").errors.len()).to_equal(0)
        expect(generic_callable_lower(PLAIN_WALKER, "walk_ast_asm_location_plain").errors.len()).to_equal(0)
