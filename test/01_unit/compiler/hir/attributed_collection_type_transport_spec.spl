# @tag: unit, compiler, hir, collection
# @req REQ-PSC-002 REQ-PSC-005
use std.spec.{describe, it, expect, step}
use compiler.core.parser.{parser_init, parser_has_errors, parser_initialization_generation_v1, parser_note_use_import}
use compiler.core.parser_stmts.{parse_statement}
use compiler.frontend.flat_ast_bridge.{convert_flat_stmt, flat_pools_dump_all, flat_pools_restore_all}
use compiler.frontend.parser_types_expr.{TypeKind, StmtKind}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolKind}
use compiler.hir.hir_definitions.{HirStmtKind, HirExprKind}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.statements.*
use compiler.core.types.{named_type_register, named_type_apply, named_type_update,
    named_type_fields, named_type_field_type_tags, option_generic_type_register,
    named_generic_instance_register, function_type_register, TYPE_NAMED_BASE,
    TYPE_OPTION_GENERIC_BASE, TYPE_I64, TYPE_TEXT}
use compiler.frontend.core.flat_pool_codec.{FLAT_POOL_CODEC_VERSION}

fn expect_map_annotation(source: text):
    parser_init(source)
    val parsed = parse_statement()
    expect(parser_has_errors()).to_equal(false)
    val snapshot = flat_pools_dump_all()
    parser_init("val unrelated = 1")
    val generation = parser_initialization_generation_v1()
    expect(flat_pools_restore_all(snapshot)).to_equal(true)
    expect(parser_initialization_generation_v1()).to_equal(generation)
    val statement = convert_flat_stmt(parsed)
    match statement.kind:
        case StmtKind.Val(_, type_, _) | StmtKind.Var(_, type_, _):
            expect(type_.?).to_equal(true)
            match type_.kind:
                case TypeKind.Named(name, args):
                    expect(name).to_equal("AdaptiveMap")
                    expect(args.len()).to_equal(2)
                    match args[0].kind:
                        case TypeKind.Named(key, _): expect(key).to_equal("i64")
                        case _: expect("key metadata lost").to_equal("i64")
                    match args[1].kind:
                        case TypeKind.Named(value, _): expect(value).to_equal("text")
                        case _: expect("payload metadata lost").to_equal("text")
                case _: expect("type metadata lost").to_equal("AdaptiveMap")
        case _: expect("declaration lost").to_equal("val or var")

describe "attributed collection parsed type transport":
    # UNRUN: authored against the unavailable pure-Simple test runtime in this lane.
    it "rejects a corrupt pool cache with an indirect Option cycle before conversion":
        step("Construct AdaptiveSet<Option<Self>> using a forged forward named argument")
        parser_init("")
        val owner = named_type_register("AdaptiveSet", [], [])
        val future_application = TYPE_NAMED_BASE + owner + 1
        val cyclic_option = option_generic_type_register(future_application)
        val application = named_type_apply("AdaptiveSet", [cyclic_option])
        expect(application).to_equal(future_application)
        val corrupted = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(corrupted)).to_equal(false)

    it "roundtrips a callable nested in a named type argument":
        step("Restore the callable parameter and return tags before converting the named type")
        parser_init("val selected: CallableBox<fn(i64) -> text> = make_box()")
        val parsed = parse_statement()
        expect(parser_has_errors()).to_equal(false)
        val snapshot = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(snapshot)).to_equal(true)
        val statement = convert_flat_stmt(parsed)
        match statement.kind:
            case StmtKind.Val(_, type_, _):
                expect(type_.?).to_equal(true)
                match type_.kind:
                    case TypeKind.Named(name, args):
                        expect(name).to_equal("CallableBox")
                        expect(args.len()).to_equal(1)
                        match args[0].kind:
                            case TypeKind.Function(parameters, returned):
                                expect(parameters.len()).to_equal(1)
                                match parameters[0].kind:
                                    case TypeKind.Named(param_name, _): expect(param_name).to_equal("i64")
                                    case _: expect("callable parameter lost").to_equal("i64")
                                match returned.kind:
                                    case TypeKind.Named(return_name, _): expect(return_name).to_equal("text")
                                    case _: expect("callable return lost").to_equal("text")
                            case _: expect("callable argument lost").to_equal("Function")
                    case _: expect("named argument lost").to_equal("Named")
            case _: expect("declaration lost").to_equal("val")

    it "rejects forward named references hidden in callable parameters and returns":
        step("Reject a self-reference hidden in a callable return tag")
        parser_init("")
        val return_owner = named_type_register("FunctionGraphReturn", [], [])
        val return_future = TYPE_NAMED_BASE + return_owner + 1
        val return_function = function_type_register([TYPE_I64], return_future)
        val return_application = named_type_apply("FunctionGraphReturn", [return_function])
        expect(return_application).to_equal(return_future)
        val bad_return = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(bad_return)).to_equal(false)

        step("Reject a self-reference hidden in a callable parameter tag")
        parser_init("")
        val param_owner = named_type_register("FunctionGraphParameter", [], [])
        val param_future = TYPE_NAMED_BASE + param_owner + 1
        val param_function = function_type_register([param_future], TYPE_I64)
        val param_application = named_type_apply("FunctionGraphParameter", [param_function])
        expect(param_application).to_equal(param_future)
        val bad_parameter = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(bad_parameter)).to_equal(false)

    it "shares canonical layout updates without modifying unrelated types":
        step("Instantiate two key types and update their canonical owner once")
        parser_init("")
        val owner = named_type_register("AdaptiveSet", ["old"], [TYPE_I64])
        val unrelated = named_type_register("Unrelated", ["untouched"], [TYPE_TEXT])
        val integers = named_type_apply("AdaptiveSet", [TYPE_I64]) - TYPE_NAMED_BASE
        val strings = named_type_apply("AdaptiveSet", [TYPE_TEXT]) - TYPE_NAMED_BASE
        named_type_update(owner, ["current"], [TYPE_TEXT])
        expect(named_type_fields(integers)).to_equal(["current"])
        expect(named_type_fields(strings)).to_equal(["current"])
        expect(named_type_field_type_tags(integers)).to_equal([TYPE_TEXT])
        expect(named_type_fields(unrelated)).to_equal(["untouched"])

    it "rejects a corrupt wrapper-only cycle reached from an adaptive argument":
        step("Prevent Option registry cycles from consuming unbounded bridge recursion")
        parser_init("")
        # The first Option slot points to the next slot, which
        # points back to the first. No named tag exposes this cycle directly.
        val first = option_generic_type_register(TYPE_OPTION_GENERIC_BASE + 1)
        val second = option_generic_type_register(first)
        expect(first).to_equal(TYPE_OPTION_GENERIC_BASE)
        expect(second).to_equal(TYPE_OPTION_GENERIC_BASE + 1)
        val application = named_type_apply("AdaptiveSet", [first])
        val corrupted = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(corrupted)).to_equal(false)

    it "retains nested adaptive type applications and rejects stale codec snapshots":
        step("Roundtrip a nested type while rejecting the previous schema before restoration")
        parser_init("@collection_algorithm(\"auto\")\nval nested: AdaptiveMap<i64, AdaptiveSet<text>> = make_map()")
        val parsed = parse_statement()
        expect(parser_has_errors()).to_equal(false)
        val snapshot = flat_pools_dump_all()
        val stale = snapshot.replace(FLAT_POOL_CODEC_VERSION, "spl-flatpool-v6")
        expect(flat_pools_restore_all(stale)).to_equal(false)
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(snapshot)).to_equal(true)
        val statement = convert_flat_stmt(parsed)
        match statement.kind:
            case StmtKind.Val(_, type_, _):
                expect(type_.?).to_equal(true)
                match type_.kind:
                    case TypeKind.Named(name, args):
                        expect(name).to_equal("AdaptiveMap")
                        expect(args.len()).to_equal(2)
                        match args[1].kind:
                            case TypeKind.Named(inner_name, inner_args):
                                expect(inner_name).to_equal("AdaptiveSet")
                                expect(inner_args.len()).to_equal(1)
                                match inner_args[0].kind:
                                    case TypeKind.Named(key, _): expect(key).to_equal("text")
                                    case _: expect("nested key lost").to_equal("text")
                            case _: expect("nested type lost").to_equal("AdaptiveSet")
                    case _: expect("outer type lost").to_equal("AdaptiveMap")
            case _: expect("declaration lost").to_equal("val")

    it "roundtrips imported AdaptiveMap arguments through the instance registry":
        step("Parse an explicitly imported generic collection type and cache its registry")
        val source = "val selected: AdaptiveMap<i64, text> = make_map()"
        parser_init(source)
        parser_note_use_import("AdaptiveMap", [], false)
        val parsed = parse_statement()
        expect(parser_has_errors()).to_equal(false)
        val snapshot = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(snapshot)).to_equal(true)
        val statement = convert_flat_stmt(parsed)
        match statement.kind:
            case StmtKind.Val(_, type_, _):
                expect(type_.?).to_equal(true)
                match type_.kind:
                    case TypeKind.Named(name, args):
                        expect(name).to_equal("AdaptiveMap")
                        expect(args.len()).to_equal(2)
                        match args[0].kind:
                            case TypeKind.Named(key, _): expect(key).to_equal("i64")
                            case _: expect("imported key lost").to_equal("i64")
                        match args[1].kind:
                            case TypeKind.Named(value, _): expect(value).to_equal("text")
                            case _: expect("imported payload lost").to_equal("text")
                    case _: expect("imported type metadata lost").to_equal("AdaptiveMap")
            case _: expect("imported declaration lost").to_equal("val")

    it "rejects an imported generic forward type argument":
        step("Forge a valid-range imported registry row that points forward")
        parser_init("")
        val owner = named_type_register("ImportedForwardOwner", [], [])
        val future = TYPE_NAMED_BASE + owner + 2
        named_generic_instance_register("ImportedForward", [future])
        named_type_register("ImportedForwardTarget", [], [])
        val snapshot = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(snapshot)).to_equal(false)

    it "rejects an imported generic self type argument":
        step("Forge an imported instance whose argument points back to itself")
        parser_init("")
        val owner = named_type_register("ImportedSelfOwner", [], [])
        val self_tag = TYPE_NAMED_BASE + owner + 1
        named_generic_instance_register("ImportedSelf", [self_tag])
        val snapshot = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(snapshot)).to_equal(false)

    it "rejects an imported generic cycle through an Option wrapper":
        step("Make an Option argument lead back to its imported instance")
        parser_init("")
        val owner = named_type_register("ImportedCycleOwner", [], [])
        val self_tag = TYPE_NAMED_BASE + owner + 1
        val wrapped_self = option_generic_type_register(self_tag)
        named_generic_instance_register("ImportedCycle", [wrapped_self])
        val snapshot = flat_pools_dump_all()
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(snapshot)).to_equal(false)

    it "rejects an imported registry row with a noncanonical name":
        step("Change the synthetic owner name while preserving its registry metadata")
        parser_init("")
        named_generic_instance_register("ImportedCanonical", [TYPE_I64])
        val snapshot = flat_pools_dump_all()
        val forged = snapshot.replace("ImportedCanonical<", "WrongCanonical<")
        expect(forged == snapshot).to_equal(false)
        parser_init("val unrelated = 1")
        expect(flat_pools_restore_all(forged)).to_equal(false)

    it "retains a generic immutable declaration through parser cache restoration":
        step("Parse the real attribute syntax and roundtrip the complete flat arena")
        expect_map_annotation("@collection_algorithm(\"hash\")\nval selected: AdaptiveMap<i64, text> = make_map()")

    it "retains a generic mutable declaration through parser cache restoration":
        step("Preserve generic key and payload types independently of declaration mutability")
        expect_map_annotation("@collection_algorithm(\"ordered\")\nvar selected: AdaptiveMap<i64, text> = make_map()")

    it "rejects a parsed declaration whose factory returns another payload type":
        step("Lower actual parsed attribute syntax against a resolved factory signature")
        parser_init("@collection_algorithm(\"hash\")\nval selected: AdaptiveMap<i64, text> = make_map()")
        val parsed = convert_flat_stmt(parse_statement())
        expect(parser_has_errors()).to_equal(false)
        val span = Span.empty()
        var lowering = HirLowering.new()
        val map_id = lowering.symbols.define("AdaptiveMap", SymbolKind.Struct, nil,
            span, Visibility.Private, false, Some("lib.nogc_sync_mut.src.collections.adaptive_map"))
        val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val returned = HirType(kind: HirTypeKind.Named(map_id, [integer, integer]), span: span)
        lowering.symbols.define("make_map", SymbolKind.Function,
            HirType(kind: HirTypeKind.Function([], returned, []), span: span),
            span, Visibility.Private, false, nil)
        val lowered = lowering.lower_hir_stmt(parsed)
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.diagnostic_messages[0]).to_contain("generic arguments do not match AdaptiveMap")
        match lowered.kind:
            case HirStmtKind.Let(_, _, initializer):
                match initializer.kind:
                    case HirExprKind.MethodCall(receiver, method, args, _):
                        expect(receiver.has_type_).to_equal(true)
                        expect(method).to_equal("attributed_at_site")
                        expect(args.len()).to_equal(3)
                        match receiver.type_.kind:
                            case HirTypeKind.Named(_, parameters): expect(parameters.len()).to_equal(2)
                            case _: expect("receiver type lost").to_equal("Named")
                    case _: expect("initializer changed").to_equal("MethodCall")
            case _: expect("declaration changed").to_equal("Let")


describe "parser import state cache transport":
    it "restores whether List denotes an imported type before parsing resumes":
        step("Snapshot identical tokens with and without an imported List owner")
        val source = "val selected: List<i64> = make_list()"
        parser_init(source)
        val builtin_snapshot = flat_pools_dump_all()
        parser_note_use_import("collections", ["List"], false)
        val imported_snapshot = flat_pools_dump_all()
        expect(imported_snapshot == builtin_snapshot).to_equal(false)
        step("Restore the imported owner across a parser reset and parse its annotation")
        parser_init(source)
        expect(flat_pools_restore_all(imported_snapshot)).to_equal(true)
        val parsed = parse_statement()
        expect(parser_has_errors()).to_equal(false)
        val statement = convert_flat_stmt(parsed)
        match statement.kind:
            case StmtKind.Val(_, type_, _):
                expect(type_.?).to_equal(true)
                match type_.kind:
                    case TypeKind.Named(name, args):
                        expect(name).to_equal("List")
                        expect(args.len()).to_equal(1)
                    case _: expect("imported List owner lost").to_equal("List")
            case _: expect("declaration lost").to_equal("val")
        step("Restoring the unimported snapshot clears the prior file's import flag")
        parser_init(source)
        parser_note_use_import("collections", ["List"], false)
        expect(flat_pools_restore_all(builtin_snapshot)).to_equal(true)
        expect(flat_pools_dump_all()).to_equal(builtin_snapshot)
