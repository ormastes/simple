use std.spec.*
use std.io_runtime.{read_file_text}

fn source(path: text) -> text:
    read_file_text(path)

describe "imported type method registration memo":
    it "retains the scalar owner key after the first full signature scan":
        val registration = source("src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl")
        expect(registration).to_contain("if self.imported_type_methods_in_progress_has(reentry_key):")
        expect(registration).to_contain("self.imported_type_methods_in_progress_push(reentry_key)")
        expect(registration).to_contain("self.register_imported_type_methods_inner(")
        expect(registration).to_not_contain("self.imported_type_methods_in_progress_pop(reentry_key)")

    it "uses a scalar-safe list memo and resets it at the module boundary":
        val types = source("src/compiler/20.hir/hir_lowering/types.spl")
        val lifecycle = source("src/compiler/20.hir/hir_lowering/context_helpers.spl")
        expect(types).to_contain("imported_type_methods_in_progress: [text]")
        expect(lifecycle).to_contain("self.imported_type_methods_in_progress = []")
        expect(lifecycle).to_not_contain("me imported_type_methods_in_progress_pop(")
