# Purpose and audience: executable evidence for MDSOC compiler engineers that
# member visibility enforcement works correctly in HIR lowering.
# @req REQ-MDSOC-MEMBER-VIS-001
# requirements: doc/02_requirements/compiler/mdsoc_matrix_visibility_requirements.md

use std.spec
use std.spec.step
use compiler.common.config.Logger
use compiler.common.driver_core_types.SourceFile
use compiler.frontend.frontend.parse_full_frontend
use compiler.frontend.parser_types.ParserModule
use compiler.hir.hir_lowering.types.hirlowering_for_module
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering._Expressions.member_visibility_check.{member_visibility_strict_force, member_visibility_strict_reset}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}

fn lower_consumer_errors(
    provider_name: text,
    provider_path: text,
    provider_source: text,
    consumer_name: text,
    consumer_path: text,
    consumer_source: text,
    strict: bool = true
) -> [text]:
    val log = Logger(level: 0)
    member_visibility_strict_force(strict)
    val provider = parse_full_frontend(
        provider_source, provider_path, provider_name, log)
    val consumer = parse_full_frontend(
        consumer_source, consumer_path, consumer_name, log)
    var modules: Dict<text, ParserModule> = {}
    modules[provider_name] = provider
    val surfaces_result = module_surfaces_from_modules(modules, [
        SourceFile(path: provider_path, content: provider_source, module_name: provider_name)
    ])
    if surfaces_result.is_err():
        return ["surface error: " + surfaces_result.unwrap_err()]
    val surfaces: ModuleSurfacesByName = surfaces_result.unwrap()
    var lowering = hirlowering_for_module(consumer_path, surfaces)
    lowering.lower_module(consumer)
    member_visibility_strict_reset()
    lowering.diagnostic_messages

fn messages_contain(messages: [text], wanted: text) -> bool:
    for message in messages:
        if message.contains(wanted):
            return true
    false

fn lower_reexport_consumer_errors() -> [text]:
    val log = Logger(level: 0)
    member_visibility_strict_force(true)
    val leaf_source = "pub struct Vault:\n    secret: i64"
    val facade_source = "export use vault.leaf.\{Vault\}"
    val consumer_source = "use vault.facade.\{Vault\}\nfn steal(v: Vault) -> i64:\n    v.secret"
    var modules: Dict<text, ParserModule> = {}
    modules["vault.leaf"] = parse_full_frontend(
        leaf_source, "src/vault/leaf.spl", "vault.leaf", log)
    modules["vault.facade"] = parse_full_frontend(
        facade_source, "src/vault/facade.spl", "vault.facade", log)
    val surfaces_result = module_surfaces_from_modules(modules, [
        SourceFile(path: "src/vault/leaf.spl", content: leaf_source, module_name: "vault.leaf"),
        SourceFile(path: "src/vault/facade.spl", content: facade_source, module_name: "vault.facade")
    ])
    if surfaces_result.is_err():
        return ["surface error: " + surfaces_result.unwrap_err()]
    var lowering = hirlowering_for_module(
        "src/client/consumer.spl", surfaces_result.unwrap())
    val consumer = parse_full_frontend(
        consumer_source, "src/client/consumer.spl", "client.consumer", log)
    lowering.lower_module(consumer)
    member_visibility_strict_reset()
    lowering.diagnostic_messages

describe "HIR member and aggregate constructor visibility enforcement":
    it "compile-allows a defining-module impl to read its private field":
        step("given private field in defining module when reading in impl then access is allowed")
        val errors = lower_consumer_errors(
            "fixture.placeholder", "src/fixture/placeholder.spl",
            "fn placeholder():\n    ()",
            "records.local", "src/records/local.spl",
            "struct LocalRecord:\n    value: i64\n\nimpl LocalRecord:\n    fn read() -> i64:\n        self.value")
        expect(messages_contain(errors, "field `value` is not visible")).to_be(false)

    it "compile-rejects a private imported field read":
        step("given private field in imported module when reading then access is rejected")
        val errors = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault\}\nfn steal(v: Vault) -> i64:\n    v.secret")
        expect(messages_contain(errors, "field `secret` is not visible")).to_be(true)

    it "compile-rejects aggregate construction when private state exists":
        step("given struct with private field when constructing aggregate then construction is rejected")
        val errors = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault\}\nfn forge() -> Vault:\n    Vault(secret: 7)")
        expect(messages_contain(errors, "aggregate constructor `Vault` is not visible")).to_be(true)

    it "compile-rejects private aggregate construction through an import alias":
        step("given private struct with alias when constructing aggregate then construction is rejected")
        val errors = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault as AliasVault\}\nfn forge() -> AliasVault:\n    AliasVault(secret: 7)")
        expect(messages_contain(errors, "aggregate constructor `AliasVault` is not visible")).to_be(true)

    it "compile-allows public fields and aggregate construction":
        step("given struct with public fields when constructing aggregate then construction is allowed")
        val errors = lower_consumer_errors(
            "records.provider", "src/records/provider.spl",
            "pub struct Record:\n    pub value: i64",
            "client.consumer", "src/client/consumer.spl",
            "use records.provider.\{Record\}\nfn build() -> i64:\n    val r = Record(value: 7)\n    r.value")
        expect(messages_contain(errors, "is not visible")).to_be(false)

    it "compile-allows package fields only for a same-package consumer":
        step("given pub(package) field when accessing from same package then access is allowed")
        val errors = lower_consumer_errors(
            "pkg.provider", "src/pkg/provider.spl",
            "pub struct PackageRecord:\n    pub(package) value: i64",
            "pkg.consumer", "src/pkg/consumer.spl",
            "use pkg.provider.\{PackageRecord\}\nfn build() -> i64:\n    val r = PackageRecord(value: 9)\n    r.value")
        expect(messages_contain(errors, "is not visible")).to_be(false)

    it "compile-rejects an SFFI authority carrier with private state":
        step("given SFFI struct with private state when constructing aggregate then construction is rejected")
        val errors = lower_consumer_errors(
            "std.sffi.provider", "src/lib/nogc_sync_mut/sffi/provider.spl",
            "pub struct AdmissionToken:\n    generation: i64\n\nimpl AdmissionToken:\n    pub fn generation_value() -> i64:\n        self.generation",
            "app.plugin", "src/app/plugin.spl",
            "use std.sffi.provider.\{AdmissionToken\}\nfn forge() -> AdmissionToken:\n    AdmissionToken(generation: 1)")
        expect(messages_contain(
            errors, "aggregate constructor `AdmissionToken` is not visible")).to_be(true)

    it "compile-allows an internally exported field to a declared friend":
        step("given internal_export and pub(friend) when accessing from friend module then access is allowed")
        val errors = lower_consumer_errors(
            "server.provider", "src/server/provider.spl",
            "friend client\ninternal_export FriendRecord\npub struct FriendRecord:\n    pub(friend) value: i64",
            "client.consumer", "src/client/consumer.spl",
            "use server.provider.\{FriendRecord\}\nfn read(v: FriendRecord) -> i64:\n    v.value")
        expect(messages_contain(errors, "is not visible")).to_be(false)

    it "compile-rejects an internal field when the type is not internally exported":
        step("given pub(friend) without internal_export when accessing then field access is rejected")
        val errors = lower_consumer_errors(
            "server.provider", "src/server/provider.spl",
            "friend client\npub struct FriendRecord:\n    pub(friend) value: i64",
            "client.consumer", "src/client/consumer.spl",
            "use server.provider.\{FriendRecord\}\nfn read(v: FriendRecord) -> i64:\n    v.value")
        expect(messages_contain(errors, "field `value` is not visible")).to_be(true)

    it "compile-allows up fields from the immediate parent facade":
        step("given pub(up) field when accessing from parent facade then field access is allowed")
        val errors = lower_consumer_errors(
            "pkg.child", "src/pkg/child.spl",
            "pub struct ParentRecord:\n    pub(up) value: i64",
            "pkg.__init__", "src/pkg/__init__.spl",
            "use pkg.child.\{ParentRecord\}\nfn read(v: ParentRecord) -> i64:\n    v.value")
        expect(messages_contain(errors, "is not visible")).to_be(false)

    it "compile-rejects up fields from a non-parent sibling":
        step("given pub(up) field when accessing from sibling module then field access is rejected")
        val errors = lower_consumer_errors(
            "pkg.child", "src/pkg/child.spl",
            "pub struct ParentRecord:\n    pub(up) value: i64",
            "pkg.sibling", "src/pkg/sibling.spl",
            "use pkg.child.\{ParentRecord\}\nfn read(v: ParentRecord) -> i64:\n    v.value")
        expect(messages_contain(errors, "field `value` is not visible")).to_be(true)

    it "compile-allows peer fields at the same logical path in another compiler layer":
        step("given pub(peer) field in different layer at same logical path when accessing then access is allowed")
        val errors = lower_consumer_errors(
            "compiler.10.frontend.shared.node", "src/compiler/10.frontend/shared/node.spl",
            "pub struct PeerRecord:\n    pub(peer) value: i64",
            "compiler.20.hir.shared.node", "src/compiler/20.hir/shared/node.spl",
            "use compiler.10.frontend.shared.node.\{PeerRecord\}\nfn read(v: PeerRecord) -> i64:\n    v.value")
        expect(messages_contain(errors, "is not visible")).to_be(false)

    it "compile-rejects peer fields at a different logical path":
        step("given pub(peer) field at different logical path when accessing then field access is rejected")
        val errors = lower_consumer_errors(
            "compiler.10.frontend.shared.node", "src/compiler/10.frontend/shared/node.spl",
            "pub struct PeerRecord:\n    pub(peer) value: i64",
            "compiler.20.hir.other.node", "src/compiler/20.hir/other/node.spl",
            "use compiler.10.frontend.shared.node.\{PeerRecord\}\nfn read(v: PeerRecord) -> i64:\n    v.value")
        expect(messages_contain(errors, "field `value` is not visible")).to_be(true)

    it "compile-rejects a private field on a nominal function-call result":
        step("given private field accessed from function call result when reading then access is rejected")
        val errors = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64\npub fn make_vault() -> Vault:\n    Vault(secret: 1)",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault, make_vault\}\nfn steal() -> i64:\n    make_vault().secret")
        expect(messages_contain(errors, "field `secret` is not visible")).to_be(true)

    it "compile-rejects a private field after storing a nominal call result":
        step("given private field accessed from stored nominal value when reading then access is rejected")
        val errors = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64\npub fn make_vault() -> Vault:\n    Vault(secret: 1)",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault, make_vault\}\nfn steal() -> i64:\n    val v = make_vault()\n    v.secret")
        expect(messages_contain(errors, "field `secret` is not visible")).to_be(true)

    it "compile-rejects a qualified private aggregate constructor":
        step("given private struct with qualified constructor when constructing then construction is rejected")
        val errors = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault\}\nfn forge():\n    vault.provider.Vault(secret: 1)")
        expect(messages_contain(errors, "aggregate constructor `Vault` is not visible")).to_be(true)

    it "compile-rejects private members using the terminal re-export owner":
        step("given private field accessed through re-export chain when reading then access is rejected")
        val errors = lower_reexport_consumer_errors()
        expect(messages_contain(errors, "field `secret` is not visible")).to_be(true)

    # @req REQ-MEMBER-VIS-002
    it "default mode warns W-HIR-VIS-001 for a private imported field and still lowers":
        step("given private field when default (non-strict) mode reads it then a warning, not an error, is emitted")
        val messages = lower_consumer_errors(
            "vault.provider", "src/vault/provider.spl",
            "pub struct Vault:\n    secret: i64",
            "client.consumer", "src/client/consumer.spl",
            "use vault.provider.\{Vault\}\nfn steal(v: Vault) -> i64:\n    v.secret",
            false)
        expect(messages_contain(messages, "W-HIR-VIS-001")).to_be(true)
        expect(messages_contain(messages, "HIR lowering error")).to_be(false)

    # @req REQ-MEMBER-VIS-002
    it "default mode emits no warning for a pub field":
        step("given pub field when default mode reads it then no visibility diagnostic is emitted")
        val messages = lower_consumer_errors(
            "records.provider", "src/records/provider.spl",
            "pub struct Record:\n    pub value: i64",
            "client.consumer", "src/client/consumer.spl",
            "use records.provider.\{Record\}\nfn read(r: Record) -> i64:\n    r.value",
            false)
        expect(messages_contain(messages, "W-HIR-VIS-001")).to_be(false)
