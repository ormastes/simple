# @req REQ-SSPEC-COMPILER
"""
Purpose: the HIR codec must look every Dict<SymbolId, _> value up with the
dictionary's OWN key objects.

Under native codegen a struct-keyed Dict is identity-keyed (the C runtime
hashes the key pointer, see
doc/08_tracking/bug/dict_struct_key_identity_keyed_copied_key_misses_2026-09-13.md)
and binding a struct to a typed local copies it. hc_order_symbol_id_keys_v1
bound each key to `val key: SymbolId` before pushing it, so the generated
encoder's `node.structs[k]` missed for EVERY key: functions were refused
(`missing_required_hir_module_function_entry`, silent `codec` refusal) and
structs/enums/classes were written value-absent, so decode -> re-encode
printed `field=1 expected=<n> got=0`. Only declaration-free re-export
facades survived, which is why the Stage 3 HIR cache held 25 entries after
771 lowered modules.
doc/08_tracking/bug/stage3_hir_cache_reencode_selfcheck_and_low_store_rate_2026_10_19.md

The interpreter compares struct keys structurally, so in that lane these
examples pass with or without the fix; the native-lane red/green is the
standalone probe recorded in the bug file. The examples pin the contract
for every lane that runs them.
"""

use std.spec.*
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode_stable}
use compiler.hir.hir_codec_key_order.{hc_order_symbol_id_keys_v1}

fn lower(src: text) -> HirModule:
    val parsed = parse_full_frontend(src, "spec.spl", "spec", Logger(level: 0))
    var hl = HirLowering.with_filename("spec.spl")
    hl.lower_module(parsed)

# src/lib/common/plugin/iface_id.spl: structs only (Stage 3 got=0 at the
# structs count, expected=3).
val STRUCTS_ONLY = "struct IfaceId:\n    name: text\n    major: i64\n\nstruct ParamHeader:\n    schema_name: text\n    present: i64\n\nstruct ParamExt:\n    ext_name: text\n    payload: [u8]\n"
# src/compiler/70.backend/backend/static_backend_types.spl: enum + struct.
val ENUM_AND_STRUCT = "enum LinkClass:\n    KernelLinked\n    PluginStatic\n\nstruct Entry:\n    link_class: LinkClass\n    output: i64\n"
val WITH_FUNCTIONS = "struct Point:\n    x: i64\n\nfn get_x(p: Point) -> i64:\n    p.x\n\nfn twice(v: i64) -> i64:\n    v * 2\n"

fn expect_stable_roundtrip(hm: HirModule):
    val blob = hir_module_encode(hm)
    expect(blob.len()).to_be_greater_than(0)
    val decoded = hir_module_decode_stable(blob)
    expect(decoded != nil).to_equal(true)
    val back = decoded.unwrap()
    expect(back.structs.len()).to_equal(hm.structs.len())
    expect(back.enums.len()).to_equal(hm.enums.len())
    expect(back.functions.len()).to_equal(hm.functions.len())
    expect(hir_module_encode(back)).to_equal(blob)

describe "HIR codec struct-key identity":
    it "returns the dictionary's own SymbolId keys from the canonical order":
        step("Every ordered key must resolve in the dict it came from")
        var d: Dict<SymbolId, text> = {}
        d[SymbolId(id: 9)] = "c"
        d[SymbolId(id: 1)] = "a"
        d[SymbolId(id: 5)] = "b"
        var hits = 0
        var order: [i64] = []
        for k in hc_order_symbol_id_keys_v1(d.keys()):
            if d[k] != nil:
                hits = hits + 1
            order.push(k.id)
        expect(hits).to_equal(3)
        expect(order).to_equal([1, 5, 9])

    it "round-trips a structs-only module with every struct present":
        step("iface_id shape: three structs, no functions")
        val hm = lower(STRUCTS_ONLY)
        expect(hm.structs.len()).to_equal(3)
        expect_stable_roundtrip(hm)

    it "round-trips an enum plus struct module":
        step("static_backend_types shape: one enum, one struct")
        val hm = lower(ENUM_AND_STRUCT)
        expect(hm.enums.len()).to_equal(1)
        expect(hm.structs.len()).to_equal(1)
        expect_stable_roundtrip(hm)

    it "encodes a module with functions instead of refusing it":
        step("Functions dict: an absent value is a codec refusal (empty blob)")
        val hm = lower(WITH_FUNCTIONS)
        expect(hm.functions.len()).to_equal(2)
        expect_stable_roundtrip(hm)
