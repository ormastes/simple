"""
## Purpose and audience
Purpose: Pin that module-declaration lowering builds the `defining_module`
option it hands to `SymbolTable.define` as an explicitly typed `text?`
(`Some(..)` / `None`), never as an UNTYPED `if c: Some(x) else: nil` join.
Audience: compiler engineers maintaining HIR module-declaration lowering
(src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl).
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
A native producer older than the MIR optional-arm join fix
(doc/08_tracking/bug/untyped_optional_arm_join_typed_as_i64_2026-11-06.md)
types an untyped Some/nil join as the first arm's raw word, so every local
declaration of the module lost its defining_module in Stage 2.
See doc/08_tracking/bug/native_hir_defining_module_empty_local_decls_2026-11-17.md
# @manual: primary
REQ-COMPILER-HIR-001
"""
# @req: REQ-COMPILER-HIR-001

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

val DECL_SRC = "src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl"

fn typed_mod_name(filename: text) -> text?:
    val mod_name: text? = if filename != "": Some(filename) else: None
    mod_name

describe "module declaration defining_module option":
    it "builds mod_name as an annotated text? with None absence":
        val src = file_read(DECL_SRC) ?? ""
        expect(src.contains("val mod_name: text? = if self.module_filename != \"\": Some(self.module_filename) else: None")).to_equal(true)
        expect(src.contains("Some(self.module_filename) else: nil")).to_equal(false)

    it "keeps the module name through the typed join":
        expect(typed_mod_name("compiler.bootstrap_admission.p2_add") ?? "").to_equal("compiler.bootstrap_admission.p2_add")
        expect(typed_mod_name("").?).to_equal(false)
