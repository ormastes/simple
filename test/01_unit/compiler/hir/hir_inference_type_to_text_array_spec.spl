"""
HIR Inference `type_to_text` Array Regression

`type_to_text` in src/compiler/20.hir/inference/serialize.spl's `Array(elem,
size)` match arm referenced two undefined identifiers, `has_size` and
`size_value`, instead of the pattern-bound `size: i64?`. Any call to
`type_to_text` on a `Type.Array` value raised `error: semantic: variable
'has_size' not found` (confirmed via `bin/simple run` before the fix) —
so no array type could ever be serialized to SDN inference hints or rendered
in a diagnostic. Fixed by binding `size` via `if val size_value = size:`.
"""

# Feature: HIR inference type-to-text serialization for Array types
# **Feature ID:** #HIR-INFER-ARRAY-001

use compiler.hir.inference.types.*
use compiler.hir.inference.serialize.*

describe "type_to_text for Type.Array":
    it "renders a sized array without crashing on an undefined variable":
        val ty = Type.Array(elem: Type.Int(bits: 64, signed: true), size: Some(5))
        expect(type_to_text(ty)).to_equal("[i64; 5]")

    it "renders an unsized array without crashing on an undefined variable":
        val ty = Type.Array(elem: Type.Int(bits: 64, signed: true), size: nil)
        expect(type_to_text(ty)).to_equal("[i64]")
