# @cover src/compiler/20.hir/hir_lowering/_Items/trait_impl_lowering.spl
# @cover src/compiler/10.frontend/core/parser_decls_use.spl
# tag: unit
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*

describe "generic impl head type params reach HIR template lowering (#158 Phase C)":
    it "records impl head type params and marks impl methods as generic templates":
        val src = "struct Stack<T>:\n    items: [T]\n\nimpl Stack<T>:\n    me push_it(v: T):\n        ()\n"
        val parsed = parse_full_frontend(src, "testdata/gi.spl", "gi", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/gi.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        expect(hir.impls.len()).to_equal(1)
        expect(hir.impls[0].type_params.len()).to_equal(1)
        var push_template = false
        for sym in hir.functions.keys():
            val f = hir.functions[sym]
            if f.name == "push_it":
                push_template = f.is_generic_template
        expect(push_template).to_equal(true)

    it "marks the generic struct itself as a template without hard errors":
        val src = "struct Bare<T>:\n    items: [T]\n"
        val parsed = parse_full_frontend(src, "testdata/bare.spl", "bare", Logger(level: 0))
        var hl = HirLowering.with_filename("testdata/bare.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        var bare_template = false
        for sym in hir.structs.keys():
            val s = hir.structs[sym]
            if s.name == "Bare":
                bare_template = s.is_generic_template
        expect(bare_template).to_equal(true)
