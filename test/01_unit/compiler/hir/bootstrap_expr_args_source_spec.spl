# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.*
use std.env.variables.{env_get, env_has, env_set, env_unset}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.{HirExprKind}

extern fn rt_file_read_text(path: text) -> text?

fn hir_expression_lowering_source() -> text:
    rt_file_read_text("src/compiler/20.hir/hir_lowering/_Expressions/expression_core.spl") ?? ""

describe "bootstrap HIR expression lowering source":
    it "preserves call and method-call arguments in bootstrap mode":
        # @req REQ-SSPEC-COMPILER
        step("preserves call and method-call arguments in bootstrap mode")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        val source = hir_expression_lowering_source()

        expect(source).to_contain("HirExprKind.Call(lowered_call_callee, hir_args, hir_type_args)")
        expect(source.split("val method_receiver_t: Expr = receiver").len() - 1).to_equal(2)  # oracle: source.split("val method_receiver_t: Expr = receiver").len() - 1 must equal 2 — authoritative contract constant
        expect(source.split("val method_name_t: text = method").len() - 1).to_equal(2)  # oracle: source.split("val method_name_t: text = method").len() - 1 must equal 2 — authoritative contract constant
        expect(source.split("val method_args_t: [CallArg] = args").len() - 1).to_equal(2)  # oracle: source.split("val method_args_t: [CallArg] = args").len() - 1 must equal 2 — authoritative contract constant
        expect(source.split("for arg in method_args_t:").len() - 1).to_equal(2)  # oracle: source.split("for arg in method_args_t:").len() - 1 must equal 2 — authoritative contract constant
        expect(source).to_contain("HirExprKind.MethodCall(lowered_method_receiver, method_name_t, hir_args, fallback_resolution)")

        val had_bootstrap = env_has("SIMPLE_BOOTSTRAP")
        val prior_bootstrap = env_get("SIMPLE_BOOTSTRAP")
        val had_entry = env_has("SIMPLE_NATIVE_BUILD_ENTRY")
        val prior_entry = env_get("SIMPLE_NATIVE_BUILD_ENTRY")
        val _ = env_set("SIMPLE_BOOTSTRAP", "1")
        val _ = env_set("SIMPLE_NATIVE_BUILD_ENTRY", "boot_args.spl")
        val src = "class Box:\n    fn add(self, a: i64, b: i64) -> i64:\n        a + b\nfn pair(x: i64, y: i64) -> i64:\n    x + y\nfn run(b: Box) -> i64:\n    pair(1, 2) + b.add(3, 4)\n"
        val parsed = parse_full_frontend(src, "boot_args.spl", "boot_args", Logger(level: 0))
        var lowering = HirLowering.with_filename("boot_args.spl")
        val hir = lowering.lower_module(parsed)
        if had_bootstrap:
            val _ = env_set("SIMPLE_BOOTSTRAP", prior_bootstrap)
        else:
            val _ = env_unset("SIMPLE_BOOTSTRAP")
        if had_entry:
            val _ = env_set("SIMPLE_NATIVE_BUILD_ENTRY", prior_entry)
        else:
            val _ = env_unset("SIMPLE_NATIVE_BUILD_ENTRY")
        var checked = false
        for fn_val in hir.functions.values():
            if fn_val.name == "run":
                match fn_val.body.value.kind:
                    case HirExprKind.Binary(_, left, right):
                        var call_ok = false
                        var method_ok = false
                        match left.kind:
                            case HirExprKind.Call(_, cargs, _):
                                call_ok = cargs.len() == 2
                            case _: ()
                        match right.kind:
                            case HirExprKind.MethodCall(_, "add", margs, _):
                                method_ok = margs.len() == 2
                            case _: ()
                        expect(call_ok).to_equal(true)
                        expect(method_ok).to_equal(true)
                        checked = true
                    case _: ()
        expect(checked).to_equal(true)
