# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

fn read_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

use std.spec.step

describe "HIR statement dispatch source":
    it "uses runtime discriminants before struct-shadowed Expr dispatch":
        # @req REQ-SSPEC-COMPILER
        step("uses runtime discriminants before struct-shadowed Expr dispatch")
        val source = read_source("src/compiler/20.hir/hir_lowering/statements.spl")
        expect(source).to_contain("fn hir_stmt_kind_disc(k: StmtKind) -> i64:\n    rt_enum_discriminant(k)")
        expect(source.contains("fn hir_stmt_kind_disc(k: StmtKind) -> i64:\n    match k:")).to_equal(false)

    it "compares runtime tags for bootstrap statement predispatch":
        # @req REQ-SSPEC-COMPILER
        step("compares runtime tags for bootstrap statement predispatch")
        val source = read_source("src/compiler/20.hir/hir_lowering/statements.spl")

        expect(source).to_contain("hir_stmt_kind_disc(StmtKind.Val(\"\", None, sk_dummy))")
        expect(source).to_contain("hir_stmt_kind_disc(StmtKind.Var(\"\", None, None))")
        expect(source).to_contain("hir_stmt_kind_disc(StmtKind.Return(None))")
        expect(source).to_contain("hir_stmt_kind_disc(StmtKind.Assign(sk_dummy, None, sk_dummy))")
        expect(source).to_contain("hir_stmt_kind_disc(StmtKind.Expr(sk_dummy))")

    it "unwraps initialized Var before local shape registration":
        # @req REQ-SSPEC-COMPILER
        step("unwraps initialized Var before local shape registration")
        val source = read_source("src/compiler/20.hir/hir_lowering/statements.spl")

        expect(source).to_contain("if vr_init.?:\n                val vr_init_present = vr_init ?? sk_dummy")
        expect(source.contains("if val vr_init_present = vr_init:")).to_equal(false)

    it "unwraps HIR symbol lookups without pattern binding":
        # @req REQ-SSPEC-COMPILER
        step("unwraps HIR symbol lookups without pattern binding")
        val types_source = read_source("src/compiler/20.hir/hir_types.spl")
        val module_source = read_source("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl")
        val declaration_source = read_source("src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl")

        expect(types_source.contains("if val sym = found:")).to_equal(false)
        expect(module_source.contains("if val found_symbol = found:")).to_equal(false)
        expect(declaration_source.contains("if val found_symbol = fn_symbol_lookup:")).to_equal(false)
        expect(declaration_source).to_contain("if fn_symbol_lookup.?:\n            val found_symbol = fn_symbol_lookup.unwrap()")

    it "unwraps optional SymbolIds without compact pattern binding":
        # @req REQ-SSPEC-COMPILER
        step("unwraps optional SymbolIds without compact pattern binding")
        val expr_source = read_source("src/compiler/20.hir/hir_lowering/_Expressions/expression_core.spl")
        val stmt_source = read_source("src/compiler/20.hir/hir_lowering/statements.spl")
        val async_source = read_source("src/compiler/20.hir/hir_lowering/async.spl")
        val mir_fn_source = read_source("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        val mir_expr_source = read_source("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        val inline_policy_source = read_source("src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl")
        val symbol_source = read_source("src/compiler/20.hir/hir_symbol_table_methods.spl")

        expect(expr_source.contains("if val fld_tb_sym3 = fld_tuple_base_sym:")).to_equal(false)
        expect(expr_source.contains("if val fld_base_sym = fld_base_sym_opt:")).to_equal(false)
        expect(stmt_source.contains("if val td_bs = td_base_sym:")).to_equal(false)
        expect(async_source.contains("if val future_symbol = future_symbol_opt:")).to_equal(false)
        expect(stmt_source).to_contain("if sk_disc == hir_stmt_kind_disc(StmtKind.Expr(sk_dummy)):")
        expect(stmt_source).to_contain("case ExprKind.Assign(assign_target, assign_op, assign_value):")
        expect(mir_fn_source.contains("if val found_symbol = param.symbol:")).to_equal(false)
        expect(mir_fn_source).to_contain("val param_symbol_id = param.symbol.id")
        expect(mir_fn_source).to_contain("LocalId(id: pli + parameter_local_offset)")
        expect(mir_expr_source).to_contain("use compiler.common.value_access.{compiler_value_discriminant, compiler_value_payload, compiler_value_tuple_at}")
        expect(mir_expr_source.contains("extern fn rt_enum_payload")).to_equal(false)
        expect(inline_policy_source).to_contain("case Const(value, _):\n                match value:")
        expect(inline_policy_source.contains("match type_.kind:")).to_equal(false)
        expect(symbol_source).to_contain("val symbol: HirSymbol = found")
        expect(symbol_source).to_contain("if not type_sym.?:\n            return methods")

    it "predispatches struct-shadowed variants in return inference":
        # @req REQ-SSPEC-COMPILER
        step("predispatches struct-shadowed variants in return inference")
        val callable_source = read_source("src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl")
        val build_source = read_source("src/compiler/20.hir/hir_lowering/_Items/module_build.spl")
        val mir_source = read_source("src/compiler/50.mir/_MirLowering/module_lowering.spl")

        expect(callable_source).to_contain("if val expr = hir_ast_expr_statement_payload_v1(s.kind):")
        expect(callable_source).to_contain("if rt_enum_discriminant(e_kind_for_if) == rt_enum_discriminant(if_exemplar):")
        expect(callable_source).to_contain("val if_cond: Expr = unsafe")
        expect(callable_source).to_contain("val if_then: Block = unsafe")
        expect(callable_source).to_contain("val if_else: Block? = unsafe")
        expect(callable_source).to_contain("case ExprKind.Block(block):")
        expect(callable_source).to_contain("case ExprKind.Field(base, _):")
        expect(callable_source).to_contain("return self.scan_ast_expr_for_returns(expr, params)")
        expect(callable_source).to_contain("self.scan_ast_block_for_returns(body_block, params)")
        expect(callable_source).to_contain("self.scan_ast_expr_for_returns(base_expr, params)")
        expect(build_source).to_contain("hir_module_phase_probe(\"phase3:hir:function:start")
        expect(mir_source).to_contain("val stmt_disc = rt_enum_discriminant(stmt_kind)")
        expect(mir_source).to_contain("val expr_stmt_disc = rt_enum_discriminant(HirStmtKind.Expr(nil_expr))")
        expect(mir_source).to_contain("if stmt_disc == expr_stmt_disc:")
        expect(mir_source).to_contain("eprint(\"[mir-prescan] HirStmtKind.Expr\")")
        expect(mir_source).to_contain("val expr_t: HirExpr = expr")
        expect(mir_source).to_contain("val block_disc = rt_enum_discriminant(HirExprKind.Block(HirBlock(stmts: [], has: false, value: nil_expr, span: nil_span)))")
        expect(mir_source).to_contain("eprint(\"[mir-prescan] HirExprKind.Block\")")
