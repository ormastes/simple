# @req REQ-MC-008 — compiler-resolved reference prerequisite, no rename admission.
# @manual: primary
# Runtime: UNRUN; execute only with the qualified engine authorized by the parent.
use std.spec.{describe, it, expect}
use std.spec.step
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.parser_types.{ParserModule}
use compiler.frontend._FlatAstBridge.module_assembly.{parse_and_build_module_checked_reference_v1}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_reference_snapshot_v1.*

# Each row is (configured module identity, original source). Both parse and
# lowering are real production owners; no fabricated symbol table or HIR.
fn collect_reference_fixture_v1(rows: [(text, text)], consumer: i64, nodes: i64 = 10000, refs: i64 = 10000) -> Result<HirReferenceModuleFactsV1, text>:
    var modules: Dict<text, ParserModule> = {}
    var parsed_modules: [ParserModule] = []
    var sources: [SourceFile] = []
    var indexes: [HirReferenceSourceIndexV1] = []
    var declarations: [[HirReferenceDeclarationV1]] = []
    var all_declarations: [HirReferenceDeclarationV1] = []
    var ordinal = 0
    for row in rows:
        val path = "/reference-unit/" + row.0.replace(".", "/") + ".spl"
        var parsed: ParserModule = parse_and_build_module_checked_reference_v1(row.1, path)?
        parsed.name = row.0
        modules[row.0] = parsed
        parsed_modules.push(parsed)
        sources.push(SourceFile(path: path, content: row.1, module_name: row.0, authored_path: path))
        val index = HirReferenceSourceIndexV1.build(row.1, path, "unit-owned-original", 10000)?
        indexes.push(index)
        val local_declarations = hir_reference_declarations_v1(parsed, index, ordinal, row.0)?
        declarations.push(local_declarations)
        for declaration in local_declarations:
            all_declarations.push(declaration)
        ordinal = ordinal + 1
    val surfaces = module_surfaces_from_modules(modules, sources)?
    var lowering = hirlowering_for_module(sources[consumer].path, surfaces)
    lowering.use_explicit_semantic_policy()
    lowering.reference_origins_v1.begin_module(consumer)
    val consumer_module: ParserModule = parsed_modules[consumer]
    val hir = lowering.lower_parser_module_unstub(consumer_module, false)
    if lowering.errors.len() != 0:
        return Err("lowering: " + lowering.diagnostic_messages.join("; "))
    var collector = HirReferenceCollectorV1.new(nodes, refs)
    collector.prepare_declarations(all_declarations)?
    collector.collect(hir, indexes[consumer], consumer, rows[consumer].0,
        declarations[consumer], lowering.reference_origins_v1)

fn reference_role_count_v1(facts: HirReferenceModuleFactsV1, origin: text, role: text) -> i64:
    var count = 0
    for row in facts.references:
        if row.origin_key == origin and row.role == role:
            count = count + 1
    count

describe("resolved HIR reference facts v1", fn():
    it("walks a deep actual HIR expression without an artificial depth ceiling", fn():
        step("Parse and lower 192 nested unary expressions around one actual callable reference")
        val depth = 192
        var expression = "target()"
        for position in 0..depth:
            expression = "(-" + expression + ")"
        val source = "fn target() -> i64:\n    return 1\nfn caller() -> i64:\n    return " + expression + "\n"
        val result = collect_reference_fixture_v1([("pkg.deep", source)], 0)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        expect(reference_role_count_v1(facts, "8:pkg.deep:0", "call")).to_equal(1)
        expect(facts.visited_nodes).to_be_greater_than(depth)
        expect(facts.visited_nodes).to_be_less_than(depth * 4 + 32)
    )
    it("walks each wide-body statement and call once under the supplied node budget", fn():
        step("Resolve 128 independent source calls and refuse a genuinely exhausted node budget")
        val width = 128
        var source = "fn target() -> i64:\n    return 1\nfn caller() -> i64:\n"
        for position in 0..width:
            source = source + "    val value_{position} = target()\n"
        source = source + "    return target()\n"
        val rows = [("pkg.wide", source)]
        val result = collect_reference_fixture_v1(rows, 0)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        expect(reference_role_count_v1(facts, "8:pkg.wide:0", "call")).to_equal(width + 1)
        expect(facts.visited_nodes).to_be_greater_than(width)
        expect(facts.visited_nodes).to_be_less_than(width * 6 + 32)
        val bounded = collect_reference_fixture_v1(rows, 0, width, 10000)
        expect(bounded.is_err()).to_equal(true)
        expect(bounded.unwrap_err()).to_start_with("capacity:")
    )
    it("binds declaration, recursive call and caller by actual SymbolId", fn():
        step("Parse and lower recursive primitive functions through production owners")
        val result = collect_reference_fixture_v1([("pkg.local", "fn target(x: i64) -> i64:\n    if x > 0:\n        return target(x - 1)\n    return x\nfn caller() -> i64:\n    return target(2)\n")], 0)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        val origin = facts.declarations[0].origin_key
        expect(reference_role_count_v1(facts, origin, "declaration")).to_equal(1)
        expect(reference_role_count_v1(facts, origin, "call")).to_equal(2)
        expect(facts.visited_nodes > 0).to_equal(true)
        var declaration_id = -1
        for row in facts.references:
            if row.origin_key == origin and row.role == "declaration":
                declaration_id = row.local_symbol_id
        for row in facts.references:
            if row.origin_key == origin and row.role == "call":
                expect(row.local_symbol_id).to_equal(declaration_id)
    )
    it("keeps parameter and nested-block shadows separate from callable origins", fn():
        step("Resolve real parameter/local bindings and ignore comments and strings")
        val result = collect_reference_fixture_v1([("pkg.shadow", "fn target() -> i64:\n    return 1\nfn caller(target: i64) -> i64:\n    # target()\n    val message = \"target\"\n    if target > 0:\n        val target = 9\n        return target\n    return target\n")], 0)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        val origin = facts.declarations[0].origin_key
        expect(reference_role_count_v1(facts, origin, "call")).to_equal(0)
        expect(reference_role_count_v1(facts, origin, "value-use")).to_equal(0)
    )
    it("owns original UTF8 coordinates across subsequent lexer invocations", fn():
        step("Index original Unicode bytes, parse another file, then collect the first")
        val result = collect_reference_fixture_v1([("pkg.unicode", "# λ\nfn target() -> i64:\n    return 1\nfn caller() -> i64:\n    return target()\n"), ("pkg.other", "fn target() -> i64:\n    return 2\n")], 0)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        expect(facts.declarations[0].token.codepoint_start).to_equal(7)
        expect(facts.declarations[0].token.byte_start).to_equal(8)
        expect(facts.declarations[0].token.byte_end).to_equal(14)
        expect(reference_role_count_v1(facts, facts.declarations[0].origin_key, "call")).to_equal(1)
    )
    it("preserves import source, alias declaration and alias call roles", fn():
        step("Resolve two same-spelled functions and a selective alias through frozen surfaces")
        val result = collect_reference_fixture_v1([("pkg.one", "pub fn target() -> i64:\n    return 1\n"), ("pkg.two", "pub fn target() -> i64:\n    return 2\n"), ("pkg.consumer", "use pkg.one.\{target as chosen\}\nfn caller() -> i64:\n    return chosen()\n")], 2)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        var source_origin = ""
        var source_count = 0
        var alias_count = 0
        for row in facts.references:
            if row.role == "import-source":
                source_origin = row.origin_key
                source_count = source_count + 1
                expect(row.spelling).to_equal("target")
            if row.role == "alias-declaration":
                alias_count = alias_count + 1
                expect(row.spelling).to_equal("chosen")
        expect(source_count).to_equal(1)
        expect(alias_count).to_equal(1)
        expect(source_origin).to_equal("7:pkg.one:0")
        expect(reference_role_count_v1(facts, source_origin, "alias-use")).to_equal(1)
    )
    it("rejects unsupported loops instead of publishing partial facts", fn():
        step("Visit every body node and fail closed for an unsupported while")
        val result = collect_reference_fixture_v1([("pkg.loop", "fn target(x: i64) -> i64:\n    while x > 0:\n        return x\n    return 0\n")], 0)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_start_with("unsupported_syntax:")
    )
    it("refuses frontend metadata outside the actual admitted declaration ranges", fn():
        step("Reject original decorator tokens even when another frontend feature consumes their typed metadata")
        val source = "@representation_boundary(kind: \"layout\", reason: \"Encode a device word\", reviewers: [\"layout-owner\"], capabilities: [])\nfn encode() -> i64:\n    return 1\n"
        val result = collect_reference_fixture_v1([("pkg.decorated", source)], 0)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_start_with("unsupported_syntax:")
    )
    it("binds both list delimiters and multiple original import boundaries", fn():
        step("Align parsed item order including Unicode, trivia, repeated source spellings and EOF")
        val source = "# λ\nuse pkg.one.\{target as first, other\} # trivia\nuse pkg.two.(target as second)\nfn caller() -> i64:\n    return first() + second() + other()"
        val result = collect_reference_fixture_v1([("pkg.one", "pub fn target() -> i64:\n    return 1\npub fn other() -> i64:\n    return 3\n"), ("pkg.two", "pub fn target() -> i64:\n    return 2\n"), ("pkg.consumer", source)], 2)
        expect(result.is_ok()).to_equal(true)
        val facts = result.unwrap()
        var imports = 0
        var aliases = 0
        for row in facts.references:
            expect(source[row.byte_start:row.byte_end]).to_equal(row.spelling)
            if row.role == "import-source":
                imports = imports + 1
                expect(row.line == 2 or row.line == 3).to_equal(true)
                if row.line == 2 and row.spelling == "target":
                    expect(row.byte_start).to_equal(18)
                    expect(row.origin_key).to_equal("7:pkg.one:0")
                if row.line == 3:
                    expect(row.origin_key).to_equal("7:pkg.two:0")
            if row.role == "alias-declaration":
                aliases = aliases + 1
        expect(imports).to_equal(3)
        expect(aliases).to_equal(2)
        expect(reference_role_count_v1(facts, "7:pkg.one:0", "alias-use")).to_equal(1)
        expect(reference_role_count_v1(facts, "7:pkg.two:0", "alias-use")).to_equal(1)
        expect(reference_role_count_v1(facts, "7:pkg.one:1", "call")).to_equal(1)
    )
    it("refuses recovered or unsupported import grammar without a complete fact set", fn():
        step("Exercise malformed import trivia and wildcard grammar through real parser and lowerer")
        val malformed = collect_reference_fixture_v1([("pkg.one", "pub fn target() -> i64:\n    return 1\n"), ("pkg.consumer", "use pkg.one.\{target @\}\nfn caller() -> i64:\n    return target()\n")], 1)
        expect(malformed.is_err()).to_equal(true)
        val wildcard = collect_reference_fixture_v1([("pkg.one", "pub fn target() -> i64:\n    return 1\n"), ("pkg.consumer", "use pkg.one.*\nfn caller() -> i64:\n    return target()\n")], 1)
        expect(wildcard.is_err()).to_equal(true)
        expect(wildcard.unwrap_err()).to_start_with("unsupported_syntax:")
    )
    it("retains genuine consumed spans for both wildcard parser exits", fn():
        step("Inspect actual parser import spans before the following declaration or EOF")
        val source = "# λ\nuse pkg.one.*\nuse pkg.two*"
        val parsed = parse_and_build_module_checked_reference_v1(source, "/reference-unit/wildcards.spl")
        expect(parsed.is_ok()).to_equal(true)
        val module = parsed.unwrap()
        expect(module.imports.len()).to_equal(2)
        val index = HirReferenceSourceIndexV1.build(source, "/reference-unit/wildcards.spl", "original", 100).unwrap()
        for import_ in module.imports:
            val first = index.token_at(import_.span.start).unwrap()
            expect(first.spelling).to_equal("use")
            var final_token = first
            for token in index.tokens:
                if token.codepoint_start >= import_.span.start and token.codepoint_end <= import_.span.end:
                    final_token = token
            expect(final_token.spelling).to_equal("*")
            expect(final_token.codepoint_end).to_equal(import_.span.end)
        expect(module.imports[0].span.end < module.imports[1].span.start).to_equal(true)
    )
    it("refuses a candidate whose new spelling captures a parameter binding", fn():
        step("Independently resolve original and candidate source through actual HIR")
        val original = collect_reference_fixture_v1([("pkg.capture", "fn target() -> i64:\n    return 1\nfn caller(chosen: i64) -> i64:\n    return target()\n")], 0)
        expect(original.is_ok()).to_equal(true)
        expect(reference_role_count_v1(original.unwrap(), "11:pkg.capture:0", "call")).to_equal(1)
        val candidate = collect_reference_fixture_v1([("pkg.capture", "fn chosen() -> i64:\n    return 1\nfn caller(chosen: i64) -> i64:\n    return chosen()\n")], 0)
        expect(candidate.is_err()).to_equal(true)
    )
    it("rejects node and reference exhaustion without a truncated success", fn():
        step("Apply independent node and fact limits to real HIR")
        val rows = [("pkg.limit", "fn target() -> i64:\n    return 1\nfn caller() -> i64:\n    return target()\n")]
        val node_result = collect_reference_fixture_v1(rows, 0, 1, 100)
        expect(node_result.is_err()).to_equal(true)
        expect(node_result.unwrap_err()).to_start_with("capacity:")
        val fact_result = collect_reference_fixture_v1(rows, 0, 100, 1)
        expect(fact_result.is_err()).to_equal(true)
        expect(fact_result.unwrap_err()).to_start_with("capacity:")
    )
    it("rejects a checked parse error and recovers for the next real request", fn():
        step("Exercise valid, invalid and valid requests without parser-state admission")
        val rows = [("pkg.sequence", "fn target() -> i64:\n    return 1\n")]
        expect(collect_reference_fixture_v1(rows, 0).is_ok()).to_equal(true)
        val invalid = collect_reference_fixture_v1([("pkg.bad", "fn broken(:\n")], 0)
        expect(invalid.is_err()).to_equal(true)
        expect(collect_reference_fixture_v1(rows, 0).is_ok()).to_equal(true)
    )
)
