# Imported aliases are bindings of one physical struct declaration.
use std.spec.*
use std.io_runtime.{file_read}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.hir.hir_owner_name.{hir_symbol_owner_module}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.optional_record_owner.*

val canonical_struct_source = "pub struct Holder:\n    tools: [Tool]\npub struct Tool:\n    name: text\n    path: text\n"
val canonical_struct_other = "pub struct Tool:\n    path: i64\n    name: i64\n"

fn canonical_struct_registry(source: text, owner: text) -> ModuleSurfacesByName:
    val logger = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    modules[owner] = parse_full_frontend(source, owner, owner, logger)
    modules["probe.other"] = parse_full_frontend(canonical_struct_other, "probe/other.spl", "probe.other", logger)
    val files = [SourceFile(path: owner, content: source, module_name: owner), SourceFile(path: "probe/other.spl", content: canonical_struct_other, module_name: "probe.other")]
    module_surfaces_from_modules(modules, files).unwrap()

fn canonical_struct_count(symbols: SymbolTable, owner: text, name: text) -> i64:
    var count = 0
    for declaration in symbols.symbols.values():
        if declaration.kind == SymbolKind.Struct and declaration.name == name and hir_symbol_owner_module(declaration.defining_module ?? "") == owner:
            count = count + 1
    count

fn canonical_struct_has_error(lowering: HirLowering, message: text) -> bool:
    for error in lowering.errors:
        if error.message.contains(message): return true
    false

fn canonical_struct_mir_fixture() -> MirLowering:
    val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
    val consumer_source = "use probe.owner.\{Holder, Tool as Alias, Tool as Again\}\nfn pick(tool: Alias) -> Again?:\n    Some(tool)\nfn inspect(tool: Again) -> text:\n    val stored = pick(tool)\n    val copied = stored\n    match copied:\n        case Some(value): value.path\n        case nil: \"missing\"\n"
    var provider_lowering = hirlowering_for_module("probe.owner", registry)
    val provider = provider_lowering.lower_module(parse_full_frontend(canonical_struct_source, "probe.owner", "probe.owner", Logger(level: 0)))
    var consumer_lowering = hirlowering_for_module("probe.consumer", registry)
    val consumer = consumer_lowering.lower_module(parse_full_frontend(consumer_source, "probe.consumer", "probe.consumer", Logger(level: 0)))
    expect(provider_lowering.errors.len()).to_equal(0)
    expect(consumer_lowering.errors.len()).to_equal(0)
    expect(canonical_struct_count(consumer.symbols, "probe.owner", "Tool")).to_equal(1)
    var lowering = MirLowering.new(consumer.symbols)
    var prescan_mods: Dict<text, HirModule> = {}
    prescan_mods["provider"] = provider
    prescan_mods["consumer"] = consumer
    lowering.prescan_module_struct_names(prescan_mods, "provider")
    lowering.prescan_module_struct_names(prescan_mods, "consumer")
    val mir = lowering.lower_module(consumer, [provider, consumer])
    expect(lowering.errors.len()).to_equal(0)
    expect(mir.functions.len()).to_be_greater_than(0)
    lowering

describe "canonical imported struct declarations":
    it "binds two explicit aliases to one current qualified ID":
        val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        val index = registry.index_by_name["probe.owner"]
        lowering.register_imported_symbol(index, "probe.owner", "Tool", "Alias", Span.empty(), true)
        val first = lowering.symbols.lookup_qualified_type_raw("probe.owner", "Tool")
        val allocated = lowering.symbols.next_symbol_id
        lowering.register_imported_symbol(index, "probe.owner", "Tool", "Again", Span.empty(), true)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.symbols.local_type_binding_raw("Alias")).to_equal(first)
        expect(lowering.symbols.local_type_binding_raw("Again")).to_equal(first)
        expect(lowering.symbols.next_symbol_id).to_equal(allocated)
        expect(canonical_struct_count(lowering.symbols, "probe.owner", "Tool")).to_equal(1)
        expect(lowering.symbols.symbols[first].visibility).to_equal(Visibility.Public)

    it "reuses a transitive field dependency after explicit import supersedes its bare binding":
        val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        val index = registry.index_by_name["probe.owner"]
        lowering.register_imported_symbol(index, "probe.owner", "Holder", "Holder", Span.empty(), true)
        val dependency = lowering.symbols.lookup_qualified_type_raw("probe.owner", "Tool")
        expect(dependency).to_be_greater_than(-1)
        lowering.register_imported_symbol(index, "probe.owner", "Tool", "Tool", Span.empty(), true)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.symbols.local_type_binding_raw("Tool")).to_equal(dependency)
        expect(lowering.symbols.lookup_qualified_type_raw("probe.owner", "Tool")).to_equal(dependency)
        expect(canonical_struct_count(lowering.symbols, "probe.owner", "Tool")).to_equal(1)
        match lowering.struct_field_types_by_name["probe.owner.Holder"]["tools"].kind:
            case HirTypeKind.Array(element, _):
                match element.kind:
                    case HirTypeKind.Named(id, _): expect(id.id).to_equal(dependency)
                    case _: fail("field dependency lost nominal owner")
            case _: fail("field dependency lost array type")

    it "keeps different physical providers distinct despite the same leaf name":
        val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        lowering.register_imported_symbol(registry.index_by_name["probe.owner"], "probe.owner", "Tool", "First", Span.empty(), true)
        lowering.register_imported_symbol(registry.index_by_name["probe.other"], "probe.other", "Tool", "Second", Span.empty(), true)
        val first = lowering.symbols.local_type_binding_raw("First")
        val second = lowering.symbols.local_type_binding_raw("Second")
        expect(first != second).to_be(true)
        expect(first).to_equal(lowering.symbols.lookup_qualified_type_raw("probe.owner", "Tool"))
        expect(second).to_equal(lowering.symbols.lookup_qualified_type_raw("probe.other", "Tool"))
        expect(lowering.errors.len()).to_equal(0)

    it "rejects a stale qualified declaration before publishing an alias":
        val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        lowering.symbols.qualified_types["probe.owner#Tool"] = 999999
        lowering.register_imported_symbol(registry.index_by_name["probe.owner"], "probe.owner", "Tool", "Alias", Span.empty(), true)
        expect(canonical_struct_has_error(lowering, "stale qualified declaration")).to_be(true)
        expect(lowering.symbols.local_type_binding_raw("Alias")).to_equal(-1)

    it "rejects a qualified declaration of the wrong kind":
        val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        val wrong = lowering.symbols.define("Tool", SymbolKind.Enum, nil, Span.empty(), Visibility.Public, false, Some("probe.owner"))
        lowering.symbols.bind_qualified_type("probe.owner", "Tool", wrong)
        lowering.register_imported_symbol(registry.index_by_name["probe.owner"], "probe.owner", "Tool", "Alias", Span.empty(), true)
        expect(canonical_struct_has_error(lowering, "mismatched qualified declaration")).to_be(true)
        expect(lowering.symbols.local_type_binding_raw("Alias")).to_equal(-1)

    it "rejects a valid foreign declaration stored under the provider key":
        val registry = canonical_struct_registry(canonical_struct_source, "probe.owner")
        var lowering = hirlowering_for_module("probe.consumer", registry)
        lowering.register_imported_symbol(registry.index_by_name["probe.other"], "probe.other", "Tool", "Foreign", Span.empty(), true)
        val foreign = lowering.symbols.lookup_qualified_type_raw("probe.other", "Tool")
        lowering.symbols.qualified_types["probe.owner#Tool"] = foreign
        lowering.register_imported_symbol(registry.index_by_name["probe.owner"], "probe.owner", "Tool", "Alias", Span.empty(), true)
        expect(canonical_struct_has_error(lowering, "mismatched qualified declaration")).to_be(true)
        expect(lowering.symbols.local_type_binding_raw("Alias")).to_equal(-1)

    it "keeps the actual EnvAccessPlan dependency canonical through glob import":
        val source = file_read("src/lib/common/env_access/model.spl")
        expect(source.len()).to_be_greater_than(0)
        val owner = "lib.common.env_access.model"
        val registry = canonical_struct_registry(source, owner)
        var lowering = hirlowering_for_module("probe.consumer", registry)
        val index = registry.index_by_name[owner]
        lowering.register_imported_symbol(index, owner, "EnvAccessPlan", "EnvAccessPlan", Span.empty(), true)
        val dependency = lowering.symbols.lookup_qualified_type_raw(owner, "EnvToolIdentity")
        expect(dependency).to_be_greater_than(-1)
        lowering.register_glob_imported_symbols(registry.surfaces[index], owner, Span.empty())
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.symbols.local_type_binding_raw("EnvToolIdentity")).to_equal(dependency)
        expect(canonical_struct_count(lowering.symbols, owner, "EnvToolIdentity")).to_equal(1)
        match lowering.struct_field_types_by_name[owner + ".EnvAccessPlan"]["allowed_tools"].kind:
            case HirTypeKind.Array(element, _):
                match element.kind:
                    case HirTypeKind.Named(id, _): expect(id.id).to_equal(dependency)
                    case _: fail("actual plan field lost its tool owner")
            case _: fail("actual plan field lost its array shape")

    it "lowers stored Optional records reached through transitive imports and aliases":
        var lowering = canonical_struct_mir_fixture()
        lowering.optional_record_owners[9000] = "probe.owner::Tool"
        val type_ = lowering.checked_optional_record_type(9000, Span.empty())
        match type_.kind:
            case HirTypeKind.Named(id, _): expect(id.id).to_equal(lowering.symbols.lookup_qualified_type_raw("probe.owner", "Tool"))
            case _: fail("canonical imported Optional record rejected")
        expect(lowering.errors.len()).to_equal(0)

    it "retains rejection of a genuine second declaration with the same owner":
        var lowering = canonical_struct_mir_fixture()
        val duplicate = lowering.symbols.define_with_binding("conflict", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, Some("probe.owner"), false)
        var declaration: HirSymbol = lowering.symbols.symbols[duplicate.id]
        declaration.name = "Tool"
        lowering.symbols.symbols[duplicate.id] = declaration
        lowering.symbols.exact_symbols["ConflictingTool"] = duplicate.id
        lowering.optional_record_owners[9000] = "probe.owner::Tool"
        expect(lowering.checked_optional_record_type(9000, Span.empty()).kind).to_equal(HirTypeKind.Error)
        var rejected = false
        for error in lowering.errors:
            if error.fatal and error.message.contains("ambiguous current provider declaration"): rejected = true
        expect(rejected).to_be(true)
