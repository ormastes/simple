use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{Expr, ExprKind, StmtKind}
use compiler.hir.hir_lowering._Items.module_callable_types.{hir_ast_expr_statement_payload_v1}

fn expr_statement_payload_value_control_v1() -> text:
    val span = Span.new(7, 12, 3, 4)
    val expression = Expr(kind: ExprKind.StringLit("abc", nil), span: span)
    val statement = StmtKind.Expr(expression)
    if val projected = hir_ast_expr_statement_payload_v1(statement):
        if projected.span.start != 7 or projected.span.end != 12:
            return "source offsets changed"
        if projected.span.line != 3 or projected.span.col != 4:
            return "source position changed"
        if projected.span.length != 5 or projected.span.file != "":
            return "source span metadata changed"
        match projected.kind:
            case ExprKind.StringLit(value, interpolations):
                if value != "abc" or interpolations != nil:
                    return "string payload changed"
            case _: return "expression variant changed"
        return ""
    "expression statement lost its payload"

fn expr_statement_payload_variant_control_v1() -> text:
    val expression = Expr(kind: ExprKind.IntLit(41), span: Span.empty())
    if hir_ast_expr_statement_payload_v1(StmtKind.Return(Some(expression))) != nil:
        return "return statement admitted as expression"
    if hir_ast_expr_statement_payload_v1(StmtKind.Break(nil)) != nil:
        return "break statement admitted as expression"
    ""

fn expr_statement_payload_nil_control_v1() -> text:
    val expression = Expr(kind: ExprKind.NilLit, span: Span.empty())
    if hir_ast_expr_statement_payload_v1(StmtKind.Return(nil)) != nil:
        return "empty return statement admitted as expression"
    if val projected = hir_ast_expr_statement_payload_v1(StmtKind.Expr(expression)):
        match projected.kind:
            case ExprKind.NilLit: return ""
            case _: return "nil literal expression variant changed"
    "nil literal expression lost its payload"

export expr_statement_payload_value_control_v1, expr_statement_payload_variant_control_v1, expr_statement_payload_nil_control_v1
