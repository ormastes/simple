"""
Purpose: Check explicit target transport and refusal through real watcher/driver/cache owners.
Audience: loader, watcher and compiler engineers. Runtime/docgen UNRUN.
"""
# @req: REQ-GENERIC-CONFIG-TARGET-002
use std.spec
use std.spec.step
use compiler.driver.watcher.watcher_types.{WatcherRequestKind, watcher_request_new,
    watcher_config_default, watcher_request_for_config, watcher_request_to_daemon, daemon_request_to_watcher}
use compiler.driver.watcher.smf_manifest.{smf_manifest_new, smf_manifest_entry_new,
    smf_manifest_update, smf_manifest_to_sdn, smf_manifest_from_sdn_checked, smf_manifest_find}
use compiler.driver.driver_api_compile_single.{smf_compile_options}
use compiler.driver.driver_types.{compute_options_hash}
use compiler.driver.cache.compile_options_hash.{compile_options_hash_validate}
use compiler.driver.cache.cache_types.{CACHE_FRESH, CACHE_STALE}
use std.daemon_sdk.types.{daemon_request_new}
use std.daemon_sdk.protocol.{parse_request_file}
use compiler.driver.watcher.watcher_protocol.{write_request}
use std.io_runtime.{file_delete, getpid}
use app.watch.watcher_daemon.{watcher_request_from_manifest_entry}

fn target_request_options(target: text):
    smf_compile_options("fixture.spl", "fixture.smf", "cranelift", 0, false, false, false, "dev", [], target)

describe "REQ-GENERIC-CONFIG-TARGET-002 target transport":
    it "should preserve explicit config target through actual daemon wire":
        step("Serialize and parse the real watcher request using its existing wire owner")
        var config = watcher_config_default()
        config.native_target = "aarch64-unknown-linux-gnu"
        val request = watcher_request_for_config("fixture.spl", WatcherRequestKind.Smf, config)
        val path = write_request(request, "/tmp/simple_target_wire_{getpid()}")
        expect(path != "").to_equal(true)
        val parsed = parse_request_file(path)
        val restored = daemon_request_to_watcher(parsed)
        expect(restored.native_target).to_equal(config.native_target)
        expect(file_delete(path)).to_equal(true)

    it "should read legacy requests without target as unspecified":
        step("Decode an actual legacy field map without inventing host target")
        var daemon = daemon_request_new(1)
        daemon.fields["source_path"] = "fixture.spl"
        val restored = daemon_request_to_watcher(daemon)
        expect(restored.native_target).to_equal("")
        expect(watcher_request_new("fixture.spl", WatcherRequestKind.Smf).native_target).to_equal("")

    it "should preserve target in the real normalized SMF compile options":
        step("Construct the same driver options used by SMF generation")
        val result = target_request_options("aarch64-unknown-linux-gnu")
        expect(result.is_ok()).to_equal(true)
        val options = result.unwrap()
        expect(options.native_target).to_equal("aarch64-unknown-linux-gnu")
        expect(options.input_files).to_equal(["fixture.spl"])
        expect(options.output_file).to_equal("fixture.smf")

    it "should reject unrepresentable target before compilation":
        step("Refuse line injection and silent whitespace trimming at the wire boundary")
        expect(target_request_options("aarch64\nfield.backend=llvm").is_err()).to_equal(true)
        expect(target_request_options(" aarch64 ").is_err()).to_equal(true)

    it "should reject cross-target hashes from actual driver options":
        step("Change only the transported target and compare actual production hashes")
        val first = target_request_options("x86_64-unknown-linux-gnu").unwrap()
        val second = target_request_options("aarch64-unknown-linux-gnu").unwrap()
        val stored = compute_options_hash(first)
        val current = compute_options_hash(second)
        expect(compile_options_hash_validate(stored, current).status).to_equal(CACHE_STALE)
        expect(compile_options_hash_validate(current, compute_options_hash(second)).status).to_equal(CACHE_FRESH)

    it "should preserve legacy fifteen-column manifests with unspecified targets":
        step("Roundtrip the actual legacy-shaped manifest through the checked owner")
        val entry = smf_manifest_entry_new("fixture.spl", "fixture.smf", 42, "cranelift", 0, false, false, false, "dev", [])
        val manifest = smf_manifest_update(smf_manifest_new(), entry)
        val text = smf_manifest_to_sdn(manifest)
        expect(text.contains("requires, native_target|")).to_equal(false)
        val parsed = smf_manifest_from_sdn_checked(text)
        expect(parsed.is_ok()).to_equal(true)
        val restored = smf_manifest_find(parsed.unwrap(), "fixture.spl").unwrap()
        expect(restored.native_target).to_equal("")

    it "should retain explicit target in the checked sixteen-column manifest":
        step("Roundtrip explicit target used for later source-change regeneration")
        val entry = smf_manifest_entry_new("fixture.spl", "fixture.smf", 42, "cranelift", 0, false, false, false, "dev", [], "aarch64-unknown-linux-gnu")
        val manifest = smf_manifest_update(smf_manifest_new(), entry)
        val text = smf_manifest_to_sdn(manifest)
        expect(text.contains("requires, native_target|")).to_equal(true)
        val parsed = smf_manifest_from_sdn_checked(text)
        expect(parsed.is_ok()).to_equal(true)
        val restored = smf_manifest_find(parsed.unwrap(), "fixture.spl").unwrap()
        expect(restored.native_target).to_equal("aarch64-unknown-linux-gnu")

    it "should reject a target column with an old-shaped row":
        step("Change header alone so exact schema and row count disagree")
        val entry = smf_manifest_entry_new("fixture.spl", "fixture.smf", 42, "cranelift", 0, false, false, false, "dev", [])
        val manifest = smf_manifest_update(smf_manifest_new(), entry)
        val old = smf_manifest_to_sdn(manifest)
        val malformed = old.replace("provides, requires|", "provides, requires, native_target|")
        expect(smf_manifest_from_sdn_checked(malformed).is_err()).to_equal(true)

    it "should retain manifest target for source-change regeneration":
        step("Restore the checked manifest and call the daemon's real change-request adapter")
        val entry = smf_manifest_entry_new("fixture.spl", "fixture.smf", 42, "cranelift", 0, false, false, false, "dev", [], "aarch64-unknown-linux-gnu")
        val text = smf_manifest_to_sdn(smf_manifest_update(smf_manifest_new(), entry))
        val restored = smf_manifest_from_sdn_checked(text).unwrap()
        val request = watcher_request_from_manifest_entry("fixture.spl", smf_manifest_find(restored, "fixture.spl").unwrap())
        expect(request.native_target).to_equal("aarch64-unknown-linux-gnu")
        val options = smf_compile_options(request.source_path, "fixture.smf", request.backend,
            request.opt_level, request.release, request.debug_info, request.gc_off,
            request.profile, request.allowed_families, request.native_target).unwrap()
        expect(options.native_target).to_equal(request.native_target)

    it "should refuse target line injection in the real watcher writer":
        step("Reject before the existing file-based protocol publishes a request")
        var request = watcher_request_new("fixture.spl", WatcherRequestKind.Smf)
        request.native_target = "aarch64\nfield.backend=llvm"
        expect(write_request(request, "/tmp/simple_target_reject_{getpid()}")).to_equal("")
