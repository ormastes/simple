"""
## MC/DC watcher transport specification

Proves that daemon requests preserve the canonical policy and that requests
created by older clients default safely to static-off.
"""

use std.spec.*
use std.daemon_sdk.types.{daemon_request_new}
use compiler.driver.watcher.watcher_types.{
    WatcherRequestKind, watcher_request_new,
    watcher_request_to_daemon, daemon_request_to_watcher
}

describe "MC/DC watcher request transport":
    it "round trips dynamic policy explicitly":
        var request = watcher_request_new("src/demo.spl", WatcherRequestKind.Smf)
        request.mcdc_policy = "dynamic"
        val restored = daemon_request_to_watcher(watcher_request_to_daemon(request))
        expect(restored.mcdc_policy).to_equal("dynamic")

    it "defaults an old request without a policy field to off":
        var legacy = daemon_request_new(2)
        legacy.fields["source_path"] = "src/legacy.spl"
        val restored = daemon_request_to_watcher(legacy)
        expect(restored.mcdc_policy).to_equal("off")
