extern fn rt_file_read_text(path: text) -> text

describe("backend codegen JIT ownership"):
    it("binds JIT and file cleanup owners at module scope"):
        val source = rt_file_read_text("src/compiler/backend/codegen.spl") ?? ""
        expect(source.contains("use compiler.loader.jit_instantiator.{JitInstantiator, JitInstantiatorConfig}")).to_equal(true)
        expect(source.contains("use std.nogc_sync_mut.io.file_ops.{file_delete}")).to_equal(true)
        expect(source.contains("rt_file_delete(")).to_equal(false)

    it("constructs every concrete compatibility JIT config field"):
        val source = rt_file_read_text("src/compiler/backend/codegen.spl") ?? ""
        expect(source.contains("update_smf: false")).to_equal(true)
        expect(source.contains("max_depth: 50")).to_equal(true)
        expect(source.contains("enabled: true")).to_equal(true)
        expect(source.contains("cache_dir:")).to_equal(false)
