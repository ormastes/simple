"""
# Unit construction from a primitive

Repro and prevention spec for
doc/08_tracking/bug/unit_from_primitive_construction_unsupported_runtime_2026-11-15.md.

A standalone `unit Name: T as sfx` must be constructible from a runtime
primitive, both as `Name(raw)` and as `raw as Name`, and the value must stay
extractable with `.value` / `.value()` / `.to_f64()`.
"""

unit FreeBytes: i64 as fbytes
unit Ratio: f64 as ratio

fn bytes_of(n: i64) -> FreeBytes:
    FreeBytes(n)

fn ratio_of(x: f64) -> Ratio:
    x as Ratio

describe "unit construction from a primitive":
    # @req BUG-unit_from_primitive_construction
    it "constructs an i64 unit with Name(raw)":
        step("call the unit name as a constructor")
        val n = 5
        val b = FreeBytes(n)
        expect(b.value()).to_equal(5)
        expect(b.value).to_equal(5)

    # @req BUG-unit_from_primitive_construction
    it "constructs an i64 unit with raw as Name":
        step("cast a runtime i64 to the unit")
        val n = 7
        val b = n as FreeBytes
        expect(b.value()).to_equal(7)
        expect(b.to_f64()).to_equal(7.0)

    # @req BUG-unit_from_primitive_construction
    it "matches the literal suffix form":
        step("compare constructor result with the literal")
        val b = FreeBytes(9)
        expect(b.value()).to_equal(9_fbytes.value())

    # @req BUG-unit_from_primitive_construction
    it "constructs an f64 unit both ways":
        step("build an f64 unit by call and by cast")
        val x = 0.5
        expect(Ratio(x).value()).to_equal(0.5)
        expect((x as Ratio).value()).to_equal(0.5)

    # @req BUG-unit_from_primitive_construction
    it "returns a unit from a function":
        step("construct inside a function and return it")
        expect(bytes_of(11).value()).to_equal(11)
        expect(ratio_of(1.5).value()).to_equal(1.5)
