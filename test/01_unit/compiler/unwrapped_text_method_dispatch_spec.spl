# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
# Text methods on a value unwrapped from `text?` (`!` and `??`)

**Category:** Compiler / HIR lowering
**Status:** Implemented

## Purpose and Audience

Compiler engineers who own the seed's HIR method result-type tables, and
reviewers of the caret storage path. `opt(x)!` and `opt(x) ?? d` must yield a
plain text receiver: `.starts_with` / `.ends_with` / `.find` / `.rfind` /
`.len` on it answer the same values as on a text literal, on every engine.

## Scope and Preconditions

The defect was Cranelift-JIT only (the tree-walking interpreter was always
correct), so the first describe pins the interpreter values in-process and
the second spawns `unwrapped_text_method_dispatch_jit_probe.spl` under each
NAMED engine and scores its verdict line.

Mechanism: `src/lib/nogc_sync_mut/spec/engine_probe.spl`
Pattern:   `doc/07_guide/infra/testing/spec_engine_reach.md`
Bug row:   `interp_option_unwrapped_text_starts_with_nil_2026_10_19`
"""

use std.spec.step

use std.spec
use std.spec.engine_probe.{engine_stdout}


fn opt(s: text) -> text?:
    Some(s)


describe "text methods on an unwrapped text? (interpreter lane)":
    it "answers starts_with/ends_with on a ! unwrap":
        # @req REQ-SSPEC-COMPILER
        step("unwrap with ! and call bool text methods")
        val b = opt("/h/s/tmp")!
        expect(b.starts_with("/h/s/")).to_equal(true)
        expect(b.starts_with("zz")).to_equal(false)
        expect(b.ends_with("tmp")).to_equal(true)
        expect(b.len()).to_equal(8)

    it "answers starts_with/ends_with on a ?? coalesce":
        # @req REQ-SSPEC-COMPILER
        step("coalesce with ?? and call bool text methods")
        val d = opt("/h/s/tmp") ?? "d"
        expect(d.starts_with("/h/s/")).to_equal(true)
        expect(d.ends_with("zz")).to_equal(false)
        expect(d.len()).to_equal(8)


val _PROBE = "test/01_unit/compiler/unwrapped_text_method_dispatch_jit_probe.spl"
val _PASS = "PROBE VERDICT: PASS"

describe "text methods on an unwrapped text? (out of process, named engines)":
    it "passes the probe under the interpreter":
        # @req REQ-SSPEC-COMPILER
        step("run the probe under the interpreter")
        expect(engine_stdout(_PROBE, "interpret")).to_contain(_PASS)

    it "passes the probe under the cranelift JIT":
        # @req REQ-SSPEC-COMPILER
        step("run the probe under the cranelift JIT")
        expect(engine_stdout(_PROBE, "jit")).to_contain(_PASS)
