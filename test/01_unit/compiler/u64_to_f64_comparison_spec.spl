# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


use std.spec.step

use std.spec.{describe, it, expect}


# Regression for bug u64_to_f64_comparison_uses_signed_conversion_2026-07-25:
# a mixed u64/f64 comparison (or arithmetic promotion) used a SIGNED int->float
# conversion, so a high-bit u64 (>= 2^63) was read as its negative two's-
# complement value. `(2^63 as u64) > 0.0` wrongly returned false. Fixed in the
# interpreter (interp_int_to_f64) and MIR lowering (retype-to-U64 before the f64
# promotion so backends select uitofp / fcvt_from_uint). 2^63 as f64 is exactly
# 9223372036854775808.0.

describe "u64 vs f64 comparison uses unsigned int->float conversion":
    # @manual scenario evidence
    it "2^63 compares as a positive number against f64":
        # @req REQ-SSPEC-UNIT
        step("2^63 compares as a positive number against f64")
        val high: u64 = 0x8000000000000000u64
        expect(high > 0.0).to_equal(true)
        expect(0.0 < high).to_equal(true)
        expect(high < 9223372036854775808.0).to_equal(false)
        expect(high <= 9223372036854775808.0).to_equal(true)
        expect(high >= 9223372036854775808.0).to_equal(true)
        expect(high == 9223372036854775808.0).to_equal(true)

    it "2^63+1 compares as a positive number against f64":
        # @req REQ-SSPEC-UNIT
        step("2^63+1 compares as a positive number against f64")
        val h1: u64 = 0x8000000000000001u64
        expect(h1 > 0.0).to_equal(true)
        expect(h1 >= 9223372036854775808.0).to_equal(true)
        expect(0.0 < h1).to_equal(true)

    it "u64::MAX compares as a large positive number against f64":
        # @req REQ-SSPEC-UNIT
        step("u64::MAX compares as a large positive number against f64")
        val umax: u64 = 0xFFFFFFFFFFFFFFFFu64
        expect(umax > 0.0).to_equal(true)
        expect(umax > 9000000000000000000.0).to_equal(true)
        expect(0.0 < umax).to_equal(true)

    it "mixed u64/f64 arithmetic promotes the u64 as unsigned":
        # @req REQ-SSPEC-UNIT
        step("mixed u64/f64 arithmetic promotes the u64 as unsigned")
        val high: u64 = 0x8000000000000000u64
        expect(high + 0.0 > 0.0).to_equal(true)
        expect(high - 1.0 > 0.0).to_equal(true)

describe "signed i64 vs f64 comparison is unchanged (negatives stay negative)":
    it "negative i64 compares as negative against f64":
        # @req REQ-SSPEC-UNIT
        step("negative i64 compares as negative against f64")
        val neg: i64 = -5
        expect(neg < 0.0).to_equal(true)
        expect(0.0 > neg).to_equal(true)
        expect(neg > -10.0).to_equal(true)
        expect(neg == -5.0).to_equal(true)

    it "positive i64 in the shared range is unaffected":
        # @req REQ-SSPEC-UNIT
        step("positive i64 in the shared range is unaffected")
        val pos: i64 = 42
        expect(pos > 0.0).to_equal(true)
        expect(pos < 100.0).to_equal(true)
