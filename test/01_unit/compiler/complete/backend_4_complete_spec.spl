"""
## Purpose and audience
Purpose: Verify Compiler backend target model through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/compiler/complete/backend_4_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-CMP-COMPILER_BACKEND-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/compiler_backend_behavior.md
# doc-path: doc/03_plan/sys_test/compiler_backend_behavior.md
# doc-path: doc/04_architecture/lib/compiler_backend.md
# doc-path: doc/05_design/lib/compiler_backend_oracles.md
# @manual: primary

use std.spec
use compiler.backend.backend.backend_types.{CodegenTarget}
use std.spec.step

describe "Compiler backend target model":
    it "codegen targets are distinct model values":
        step("Verify: codegen targets are distinct model values")
        # @req: REQ-CMP-COMPILER_BACKEND-001
        expect((CodegenTarget.X86_64 == CodegenTarget.Riscv32)).to_equal(false)  # oracle: different architectures are different targets
        expect((CodegenTarget.Host == CodegenTarget.Host)).to_equal(true)  # oracle: target equality is by value

    it "the enum exposes the expected architecture variants":
        step("Verify: the enum exposes the expected architecture variants")
        # @req: REQ-CMP-COMPILER_BACKEND-001
        val variants = [CodegenTarget.X86_64, CodegenTarget.Riscv32, CodegenTarget.Riscv64]
        expect(variants.len()).to_equal(3)  # oracle: three named targets collected

