# @req: REQ-COMPILER-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/complete/lowering_3_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/lowering_3_complete.md
# doc-path: doc/03_plan/sys_test/lowering_3_complete.md
# doc-path: doc/04_architecture/lowering_3_complete.md
# doc-path: doc/05_design/lowering_3_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-COMPILER-COMPLETE-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-COMPILER-COMPLETE-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "boolean operators short-circuit to expected truth table":
        step("Verify: boolean operators short-circuit to expected truth table")
        # @req: REQ-COMPILER-COMPLETE-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not true).to_equal(false)

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-COMPILER-COMPLETE-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

    it "integer conversion helpers":
        step("Verify: integer conversion helpers")
        # @req: REQ-COMPILER-COMPLETE-001
        expect(42.to_text()).to_equal("42")
        expect("42".parse_int()).to_equal(42)  # oracle: decimal parse

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-COMPILER-COMPLETE-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first
