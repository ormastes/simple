use std.common.bytes.concat_copy_v1.{bytes_concat_copy_v1}

fn bytes_equal_v1(actual: [u8], expected: [u8]) -> bool:
    if actual.len() != expected.len():
        return false
    var index: i64 = 0
    while index < actual.len():
        if actual[index] != expected[index]:
            return false
        index = index + 1
    true

fn main() -> i32:
    val empty: [u8] = []
    val left: [u8] = [0.to_u8(), 127.to_u8()]
    val right: [u8] = [128.to_u8(), 255.to_u8()]
    if not bytes_equal_v1(bytes_concat_copy_v1(empty, empty), empty):
        print "FAIL empty-empty"
        return 1
    if not bytes_equal_v1(bytes_concat_copy_v1(empty, right), right):
        print "FAIL empty-left"
        return 2
    if not bytes_equal_v1(bytes_concat_copy_v1(left, empty), left):
        print "FAIL empty-right"
        return 3
    val expected: [u8] = [0.to_u8(), 127.to_u8(), 128.to_u8(), 255.to_u8()]
    var joined: [u8] = bytes_concat_copy_v1(left, right)
    if not bytes_equal_v1(joined, expected):
        print "FAIL high-byte-order"
        return 4
    joined[0] = 9.to_u8()
    joined[2] = 10.to_u8()
    if left[0] != 0.to_u8() or right[0] != 128.to_u8():
        print "FAIL input-storage-alias"
        return 5
    val aliased: [u8] = bytes_concat_copy_v1(left, left)
    val alias_expected: [u8] = [0.to_u8(), 127.to_u8(), 0.to_u8(), 127.to_u8()]
    if not bytes_equal_v1(aliased, alias_expected):
        print "FAIL same-input-alias"
        return 6
    var empty_right: [u8] = bytes_concat_copy_v1(left, empty)
    empty_right[0] = 11.to_u8()
    var empty_left: [u8] = bytes_concat_copy_v1(empty, right)
    empty_left[0] = 12.to_u8()
    if left[0] != 0.to_u8() or right[0] != 128.to_u8():
        print "FAIL empty-case-storage-alias"
        return 7
    val chained: [u8] = bytes_concat_copy_v1(bytes_concat_copy_v1(left, right), left)
    val chain_expected: [u8] = [0.to_u8(), 127.to_u8(), 128.to_u8(), 255.to_u8(), 0.to_u8(), 127.to_u8()]
    if not bytes_equal_v1(chained, chain_expected):
        print "FAIL chained-order"
        return 8
    if left.len() != 2 or right.len() != 2 or empty.len() != 0:
        print "FAIL input-length-mutated"
        return 9
    print "PASS bytes-concat-copy 9 controls"
    0
