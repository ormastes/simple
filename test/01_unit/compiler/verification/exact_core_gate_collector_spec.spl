"""
## Purpose and audience
Purpose: Prove that FV2 exact-core semantics gate collector.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-VERIFICATION-001 — stable requirement identity for this spec.

use std.spec
use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.verification_effects.{VerificationEffectV1}
use compiler.mir.verification_ir.{SemanticClass, VerificationIrType,
    VerificationIrProvenance, VerificationIrFunction, VerificationIrModuleV1}
use compiler.tools.verify.formal_gate_collectors.{ExactCoreCheckKindV1,
    ExecutedCheckOutcomeV1, ExecutedExactCoreCheckV1,
    VirConstructionEvidenceV1, CompilerCertificateValidationV1,
    ExecutedWeaveClosureV1,
    collect_exact_core_semantics_gate_v1,
    collect_vir_compiler_relation_gate_v1,
    collect_aop_macro_closure_gate_v1,
    runtime_assumption_monitor_binding_diagnostic_v1}
use compiler.common.assurance.formal_interfaces.{CompilerCertificateV1,
    CompilerRefinementRelationV1, WeaveJoinPointV1, WeaveManifestV1,
    AspectCertificateV1, AspectEvidenceClassV1, RuntimeMonitorFailStopV1,
    RuntimeAssumptionMonitorReceiptV1}
use compiler.common.assurance.formal_delivery_gates.{FormalDeliveryReceiptFileV1}

fn exact_core_vir(type_: VerificationIrType = VerificationIrType(
    "i32", "bitvec:32:signed", SemanticClass.Exact, "", "")
) -> VerificationIrModuleV1:
    val provenance = VerificationIrProvenance(sha256_text("source"),
        sha256_text("expanded"), sha256_text("woven"), sha256_text("mir"),
        sha256_text("contract"), sha256_text("policy"))
    val function_draft = VerificationIrFunction("VerificationIR-v1",
        SymbolId(id: 7), "increment", [type_], type_,
        [VerificationEffectV1.Pure], [], provenance, "", "")
    val function = VerificationIrFunction(function_draft.schema,
        function_draft.symbol, function_draft.name, function_draft.parameters,
        function_draft.return_type, function_draft.effects,
        function_draft.called_symbols, function_draft.provenance,
        function_draft.expected_semantic_hash(), "")
    val module_draft = VerificationIrModuleV1("VerificationIRModule-v1",
        "exact_core", sha256_text("effects"), [function], "", "")
    VerificationIrModuleV1(module_draft.schema, module_draft.module_name,
        module_draft.effect_closure_hash, module_draft.functions,
        module_draft.expected_semantic_hash(), "")

fn exact_core_checks(vir_hash: text) -> [ExecutedExactCoreCheckV1]:
    val kinds = [ExactCoreCheckKindV1.TypedLeanLowering,
        ExactCoreCheckKindV1.UnsupportedNegative,
        ExactCoreCheckKindV1.GeneratedFallbackScan,
        ExactCoreCheckKindV1.FixedWidthIntegerEdges,
        ExactCoreCheckKindV1.ResultOutcomeSeparation]
    var checks: [ExecutedExactCoreCheckV1] = []
    for kind in kinds:
        checks.push(ExecutedExactCoreCheckV1("ExecutedExactCoreCheck-v1", kind,
            vir_hash, sha256_text("tool-" + kind.name()),
            sha256_text("policy-" + kind.name()), "PASS " + kind.name(),
            ExecutedCheckOutcomeV1.Passed, ""))
    checks

fn relation_certificate(pass_id: text, before: text,
    after: text) -> CompilerCertificateV1:
    val draft = CompilerCertificateV1(pass_id, before, after,
        CompilerRefinementRelationV1.BehaviorInclusion, "validator-v1", "", true)
    CompilerCertificateV1(draft.pass_id, draft.before_semantic_hash,
        draft.after_semantic_hash, draft.relation, draft.validator_version,
        draft.expected_certificate_hash(), true)

fn relation_validation(certificate: CompilerCertificateV1
) -> CompilerCertificateValidationV1:
    CompilerCertificateValidationV1("CompilerCertificateValidation-v1",
        certificate.certificate_hash, sha256_text("validator-binary"),
        sha256_text("validator-policy"), "PASS " + certificate.pass_id,
        ExecutedCheckOutcomeV1.Passed, "")

fn aop_manifest(point_symbol: text = "7",
    introduced: [text] = []) -> WeaveManifestV1:
    WeaveManifestV1(sha256_text("source"), sha256_text("expanded"),
        [WeaveJoinPointV1(point_symbol, ["audit-advice"])], introduced,
        sha256_text("woven"))

fn aop_execution(vir_hash: text, manifest: WeaveManifestV1
) -> ExecutedWeaveClosureV1:
    val weaver = sha256_text("weaver")
    val policy = sha256_text("weave-policy")
    val output = "PASS canonical weave"
    var introduced_parts: [text] = []
    for symbol in manifest.introduced_symbol_ids:
        introduced_parts.push(symbol.len().to_string() + ":" + symbol)
    val introduced = sha256_text("IntroducedSymbolClosure-v1" +
        manifest.introduced_symbol_ids.len().to_string() + ":[" +
        introduced_parts.join("") + "]" +
        vir_hash.len().to_string() + ":" + vir_hash)
    val manifest_hash = manifest.hash()
    val post_vir = sha256_text("PostVirTransformSequence-v1" +
        manifest_hash.len().to_string() + ":" + manifest_hash +
        vir_hash.len().to_string() + ":" + vir_hash +
        "1:0")
    val lock = sha256_text("DynamicTransformLock-v1" +
        manifest_hash.len().to_string() + ":" + manifest_hash +
        vir_hash.len().to_string() + ":" + vir_hash +
        weaver.len().to_string() + ":" + weaver +
        policy.len().to_string() + ":" + policy +
        post_vir.len().to_string() + ":" + post_vir +
        sha256_text(output).len().to_string() + ":" + sha256_text(output))
    ExecutedWeaveClosureV1("ExecutedWeaveClosure-v1", manifest_hash,
        vir_hash, weaver, policy, introduced, 0, post_vir, lock, output,
        ExecutedCheckOutcomeV1.Passed, "")

fn ghost_aspect(manifest: WeaveManifestV1) -> AspectCertificateV1:
    AspectCertificateV1("audit-advice",
        AspectEvidenceClassV1.GhostNoninterference,
        manifest.base_program_hash, manifest.woven_program_hash,
        sha256_text("aspect-proof"), true, true)

fn aspect_proof_material() -> [FormalDeliveryReceiptFileV1]:
    [FormalDeliveryReceiptFileV1(sha256_text("aspect-proof"), "aspect-proof")]

fn monitor_receipt(vir_hash: text, artifact_hash: text
) -> RuntimeAssumptionMonitorReceiptV1:
    RuntimeAssumptionMonitorReceiptV1("audit-advice", "timer_monotonic",
        vir_hash, artifact_hash, sha256_text("monitor-binary"),
        sha256_text("monitor-proof"), 32, RuntimeMonitorFailStopV1.Trap)

fn monitor_proof_material() -> [FormalDeliveryReceiptFileV1]:
    [FormalDeliveryReceiptFileV1(sha256_text("monitor-proof"), "monitor-proof")]

describe "FV2 exact-core semantics gate collector":
    it "derives exact receipt material from self-consistent VIR and executed checks":
        step("Verify: derives exact receipt material from self-consistent VIR and executed checks")
        # @req: REQ-COMPILER-VERIFICATION-001
        val vir = exact_core_vir()
        val collection = collect_exact_core_semantics_gate_v1(vir,
            exact_core_checks(vir.semantic_hash))
        expect(collection.gate_evidence.status.name()).to_equal("passed")
        expect(collection.receipt_files.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        for index in 0..collection.receipt_files.len():
            expect(sha256_text(collection.receipt_files[index].content)).to_equal(
                collection.gate_evidence.receipt_hashes[index])

    it "rejects unsupported or abstracted reachable type semantics":
        step("Verify: rejects unsupported or abstracted reachable type semantics")
        val unsupported = exact_core_vir(VerificationIrType("f64",
            "ieee754:binary64", SemanticClass.Unsupported, "",
            "exact floating point semantics unavailable"))
        expect(collect_exact_core_semantics_gate_v1(unsupported,
            exact_core_checks(unsupported.semantic_hash)).gate_evidence.diagnostic).to_contain("VIR")
        val abstracted = exact_core_vir(VerificationIrType("struct",
            "struct:9", SemanticClass.AbstractedWithRefinement,
            sha256_text("refinement"), ""))
        expect(collect_exact_core_semantics_gate_v1(abstracted,
            exact_core_checks(abstracted.semantic_hash)).gate_evidence.diagnostic).to_contain("TYPE")

    it "rejects forged VIR identity provenance and missing negative evidence":
        step("Verify: rejects forged VIR identity provenance and missing negative evidence")
        var forged = exact_core_vir()
        forged.semantic_hash = sha256_text("forged")
        expect(collect_exact_core_semantics_gate_v1(forged,
            exact_core_checks(forged.semantic_hash)).gate_evidence.diagnostic).to_contain("VIR")
        var weak_provenance = exact_core_vir()
        weak_provenance.functions[0].provenance.source_hash = "weak"
        weak_provenance.functions[0].semantic_hash =
            weak_provenance.functions[0].expected_semantic_hash()
        weak_provenance.semantic_hash = weak_provenance.expected_semantic_hash()
        expect(collect_exact_core_semantics_gate_v1(weak_provenance,
            exact_core_checks(weak_provenance.semantic_hash)).gate_evidence.diagnostic).to_contain("PROVENANCE")
        val vir = exact_core_vir()
        var checks = exact_core_checks(vir.semantic_hash)
        checks[1].outcome = ExecutedCheckOutcomeV1.Failed
        checks[1].diagnostic = "unsupported case escaped"
        expect(collect_exact_core_semantics_gate_v1(vir,
            checks).gate_evidence.diagnostic).to_contain("OUTCOME")

    it "rejects missing reordered stale and output-free executed checks":
        step("Verify: rejects missing reordered stale and output-free executed checks")
        val vir = exact_core_vir()
        var missing = exact_core_checks(vir.semantic_hash)
        missing.pop()
        expect(collect_exact_core_semantics_gate_v1(vir,
            missing).gate_evidence.diagnostic).to_contain("CHECK-COUNT")
        var reordered = exact_core_checks(vir.semantic_hash)
        val temporary = reordered[0]
        reordered[0] = reordered[1]
        reordered[1] = temporary
        expect(collect_exact_core_semantics_gate_v1(vir,
            reordered).gate_evidence.diagnostic).to_contain("CHECK-ORDER")
        var stale = exact_core_checks(vir.semantic_hash)
        stale[0].vir_semantic_hash = sha256_text("old-vir")
        expect(collect_exact_core_semantics_gate_v1(vir,
            stale).gate_evidence.diagnostic).to_contain("VIR-BINDING")
        var empty = exact_core_checks(vir.semantic_hash)
        empty[0].retained_output = ""
        expect(collect_exact_core_semantics_gate_v1(vir,
            empty).gate_evidence.diagnostic).to_contain("OUTPUT")

describe "FV2 VIR/compiler relation gate collector":
    it "materializes a gap-free checked compiler chain ending at the artifact":
        step("Verify: materializes a gap-free checked compiler chain ending at the artifact")
        val vir = exact_core_vir()
        val middle = sha256_text("lowered-ir")
        val artifact = sha256_text("artifact")
        val first = relation_certificate("lower", vir.semantic_hash, middle)
        val second = relation_certificate("select", middle, artifact)
        val construction = VirConstructionEvidenceV1(
            "VirConstructionEvidence-v1", sha256_text("woven"),
            vir.semantic_hash, sha256_text("vir-generator"),
            sha256_text("vir-policy"), "PASS deterministic VIR",
            ExecutedCheckOutcomeV1.Passed, "")
        val collection = collect_vir_compiler_relation_gate_v1(vir,
            construction, [first, second],
            [relation_validation(first), relation_validation(second)], artifact)
        expect(collection.gate_evidence.status.name()).to_equal("passed")
        expect(collection.receipt_files.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        for index in 0..collection.receipt_files.len():
            expect(sha256_text(collection.receipt_files[index].content)).to_equal(
                collection.gate_evidence.receipt_hashes[index])

    it "rejects woven drift chain gaps validator mismatch and wrong artifact":
        step("Verify: rejects woven drift chain gaps validator mismatch and wrong artifact")
        val vir = exact_core_vir()
        val middle = sha256_text("middle")
        val artifact = sha256_text("artifact")
        val first = relation_certificate("lower", vir.semantic_hash, middle)
        val second = relation_certificate("select", middle, artifact)
        val construction = VirConstructionEvidenceV1(
            "VirConstructionEvidence-v1", sha256_text("woven"),
            vir.semantic_hash, sha256_text("generator"), sha256_text("policy"),
            "PASS", ExecutedCheckOutcomeV1.Passed, "")
        var woven_drift = construction
        woven_drift.woven_program_hash = sha256_text("other-woven")
        expect(collect_vir_compiler_relation_gate_v1(vir, woven_drift,
            [first, second], [relation_validation(first),
                relation_validation(second)], artifact).gate_evidence.diagnostic).to_contain("WOVEN-BINDING")
        val gap = relation_certificate("select", sha256_text("gap"), artifact)
        expect(collect_vir_compiler_relation_gate_v1(vir, construction,
            [first, gap], [relation_validation(first), relation_validation(gap)],
            artifact).gate_evidence.diagnostic).to_contain("CHAIN")
        var wrong_validation = relation_validation(first)
        wrong_validation.certificate_hash = second.certificate_hash
        expect(collect_vir_compiler_relation_gate_v1(vir, construction,
            [first, second], [wrong_validation, relation_validation(second)],
            artifact).gate_evidence.diagnostic).to_contain("VALIDATOR-BINDING")
        expect(collect_vir_compiler_relation_gate_v1(vir, construction,
            [first, second], [relation_validation(first),
                relation_validation(second)], sha256_text("other-artifact")).gate_evidence.diagnostic).to_contain("TARGET")

    it "rejects missing output timeout and stale construction identity":
        step("Verify: rejects missing output timeout and stale construction identity")
        val vir = exact_core_vir()
        val artifact = sha256_text("artifact")
        val certificate = relation_certificate("lower", vir.semantic_hash,
            artifact)
        var construction = VirConstructionEvidenceV1(
            "VirConstructionEvidence-v1", sha256_text("woven"),
            vir.semantic_hash, sha256_text("generator"), sha256_text("policy"),
            "", ExecutedCheckOutcomeV1.Passed, "")
        expect(collect_vir_compiler_relation_gate_v1(vir, construction,
            [certificate], [relation_validation(certificate)],
            artifact).gate_evidence.diagnostic).to_contain("OUTPUT")
        construction.retained_output = "PASS"
        var timed_out = relation_validation(certificate)
        timed_out.outcome = ExecutedCheckOutcomeV1.Timeout
        expect(collect_vir_compiler_relation_gate_v1(vir, construction,
            [certificate], [timed_out], artifact).gate_evidence.diagnostic).to_contain("OUTCOME")
        construction.vir_semantic_hash = sha256_text("stale-vir")
        expect(collect_vir_compiler_relation_gate_v1(vir, construction,
            [certificate], [relation_validation(certificate)],
            artifact).gate_evidence.diagnostic).to_contain("CONSTRUCTION-VIR")

describe "FV2 AOP and macro closure gate collector":
    it "binds exact pointcuts aspects macro closure and transformation lock to VIR":
        step("Verify: binds exact pointcuts aspects macro closure and transformation lock to VIR")
        val vir = exact_core_vir()
        val manifest = aop_manifest()
        val collection = collect_aop_macro_closure_gate_v1(vir, manifest,
            [ghost_aspect(manifest)], aspect_proof_material(),
            aop_execution(vir.semantic_hash, manifest))
        expect(collection.gate_evidence.status.name()).to_equal("passed")
        expect(collection.receipt_files.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        for index in 0..collection.receipt_files.len():
            expect(sha256_text(collection.receipt_files[index].content)).to_equal(
                collection.gate_evidence.receipt_hashes[index])

    it "rejects absent join points introduced symbols and advice certificates":
        step("Verify: rejects absent join points introduced symbols and advice certificates")
        val vir = exact_core_vir()
        val absent_point = aop_manifest("99")
        expect(collect_aop_macro_closure_gate_v1(vir, absent_point,
            [ghost_aspect(absent_point)], aspect_proof_material(),
            aop_execution(vir.semantic_hash,
                absent_point)).gate_evidence.diagnostic).to_contain("JOIN-POINT")
        val absent_introduced = aop_manifest("7", ["8"])
        expect(collect_aop_macro_closure_gate_v1(vir, absent_introduced,
            [ghost_aspect(absent_introduced)], aspect_proof_material(),
            aop_execution(vir.semantic_hash,
                absent_introduced)).gate_evidence.diagnostic).to_contain(
            "INTRODUCED-SYMBOL")
        val manifest = aop_manifest()
        expect(collect_aop_macro_closure_gate_v1(vir, manifest, [],
            [],
            aop_execution(vir.semantic_hash,
                manifest)).gate_evidence.diagnostic).to_contain("CERTIFICATE-COUNT")

    it "rejects behavior-changing advice provenance drift and an unsealed runtime":
        step("Verify: rejects behavior-changing advice provenance drift and an unsealed runtime")
        val vir = exact_core_vir()
        val manifest = aop_manifest()
        var behavior = ghost_aspect(manifest)
        behavior.evidence_class = AspectEvidenceClassV1.BehaviorRefinement
        expect(collect_aop_macro_closure_gate_v1(vir, manifest, [behavior],
            aspect_proof_material(),
            aop_execution(vir.semantic_hash,
                manifest)).gate_evidence.diagnostic).to_contain("BEHAVIOR")
        var drifted_vir = exact_core_vir()
        drifted_vir.functions[0].provenance.expanded_hash = sha256_text("other")
        drifted_vir.functions[0].semantic_hash =
            drifted_vir.functions[0].expected_semantic_hash()
        drifted_vir.semantic_hash = drifted_vir.expected_semantic_hash()
        expect(collect_aop_macro_closure_gate_v1(drifted_vir, manifest,
            [ghost_aspect(manifest)], aspect_proof_material(),
            aop_execution(drifted_vir.semantic_hash,
                manifest)).gate_evidence.diagnostic).to_contain("PROVENANCE")
        var unlocked = aop_execution(vir.semantic_hash, manifest)
        unlocked.dynamic_transform_lock_hash = sha256_text("forged-lock")
        expect(collect_aop_macro_closure_gate_v1(vir, manifest,
            [ghost_aspect(manifest)], aspect_proof_material(),
            unlocked).gate_evidence.diagnostic).to_contain(
            "DYNAMIC")

    it "does not promote an unbound runtime monitor certificate":
        step("Verify: does not promote an unbound runtime monitor certificate")
        val vir = exact_core_vir()
        val manifest = aop_manifest()
        val monitor = AspectCertificateV1("audit-advice",
            AspectEvidenceClassV1.BoundedRuntimeMonitor,
            manifest.base_program_hash, manifest.woven_program_hash,
            sha256_text("aspect-proof"), true, true)
        expect(collect_aop_macro_closure_gate_v1(vir, manifest, [monitor],
            aspect_proof_material(),
            aop_execution(vir.semantic_hash, manifest)).gate_evidence.diagnostic).to_contain(
            "MONITOR-BOUNDARY")

    it "binds a materialized runtime monitor to one exact artifact without promoting the legacy certificate":
        step("Verify: binds a materialized runtime monitor to one exact artifact without promoting the legacy certificate")
        val vir = exact_core_vir()
        val artifact_hash = sha256_text("artifact")
        val receipt = monitor_receipt(vir.semantic_hash, artifact_hash)
        expect(runtime_assumption_monitor_binding_diagnostic_v1(receipt,
            vir.semantic_hash, artifact_hash, "audit-advice",
            ["timer_monotonic"], monitor_proof_material())).to_equal("")
        expect(runtime_assumption_monitor_binding_diagnostic_v1(receipt,
            vir.semantic_hash, sha256_text("other-artifact"), "audit-advice",
            ["timer_monotonic"], monitor_proof_material())).to_contain("TARGET")
        expect(runtime_assumption_monitor_binding_diagnostic_v1(receipt,
            vir.semantic_hash, artifact_hash, "audit-advice", ["other"],
            monitor_proof_material())).to_contain("ASSUMPTION")
        expect(runtime_assumption_monitor_binding_diagnostic_v1(receipt,
            vir.semantic_hash, artifact_hash, "other-advice",
            ["timer_monotonic"], monitor_proof_material())).to_contain("ADVICE")
        expect(runtime_assumption_monitor_binding_diagnostic_v1(receipt,
            vir.semantic_hash, artifact_hash, "audit-advice",
            ["timer_monotonic"], [])).to_contain("PROOF-MATERIAL")

    it "rejects every post-VIR transform even when a weave lock is otherwise valid":
        step("Verify: rejects every post-VIR transform even when a weave lock is otherwise valid")
        val vir = exact_core_vir()
        val manifest = aop_manifest()
        var transformed = aop_execution(vir.semantic_hash, manifest)
        transformed.post_vir_transform_count = 1
        expect(collect_aop_macro_closure_gate_v1(vir, manifest,
            [ghost_aspect(manifest)], aspect_proof_material(),
            transformed).gate_evidence.diagnostic).to_contain("POST-VIR")
        var forged_empty_sequence = aop_execution(vir.semantic_hash, manifest)
        forged_empty_sequence.post_vir_transform_hash = sha256_text("forged-empty-sequence")
        expect(collect_aop_macro_closure_gate_v1(vir, manifest,
            [ghost_aspect(manifest)], aspect_proof_material(),
            forged_empty_sequence).gate_evidence.diagnostic).to_contain("POST-VIR")

    it "rejects an aspect proof hash without exact truthfulness receipt material":
        step("Verify: rejects an aspect proof hash without exact truthfulness receipt material")
        val vir = exact_core_vir()
        val manifest = aop_manifest()
        expect(collect_aop_macro_closure_gate_v1(vir, manifest,
            [ghost_aspect(manifest)], [],
            aop_execution(vir.semantic_hash,
                manifest)).gate_evidence.diagnostic).to_contain("PROOF-MATERIAL")
