use std.spec
use compiler.tools.verify.lake_runner.{lean_axiom_audit_source, declared_axiom_roots}

fn audit_text(result: Result<text, text>) -> text:
    match result:
        case Ok(value): value
        case Err(_): ""

fn audit_error(result: Result<text, text>) -> text:
    match result:
        case Ok(_): ""
        case Err(message): message

describe "Lean transitive axiom audit source":
    it "appends one kernel-audited command for every declared proof root":
        val generated = audit_text(lean_axiom_audit_source("theorem safe : True := by trivial\n", ["Simple.safe", "Simple.refined"]))
        expect(generated).to_contain("#print axioms Simple.safe")
        expect(generated).to_contain("#print axioms Simple.refined")

    it "rejects missing and shell-shaped proof roots":
        expect(audit_error(lean_axiom_audit_source("", []))).to_contain("no exported proof roots")
        expect(audit_error(lean_axiom_audit_source("", ["Safe; touch forged"]))).to_contain("invalid Lean proof root")

    it "extracts unique explicitly declared audit roots":
        val source = "#print axioms Safe.one\n#print axioms Safe.one\n#print axioms Safe.two\n"
        expect(declared_axiom_roots(source)).to_equal(["Safe.one", "Safe.two"])

    it "keeps invalid declarations out of the generated Lean audit source":
        val malformed = "#print axioms Safe; touch forged\n#print axioms Safe.valid\n"
        expect(declared_axiom_roots(malformed)).to_equal(["Safe.valid"])
        expect(audit_error(lean_axiom_audit_source("theorem safe : True := by trivial\n",
            ["Safe.valid", "Safe; touch forged"]))).to_contain("invalid Lean proof root")
