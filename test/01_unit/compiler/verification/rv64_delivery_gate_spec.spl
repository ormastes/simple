# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_delivery_gates.{FormalDeliveryReceiptFileV1}
use compiler.tools.verify.formal_gate_collectors.{ExecutedCheckOutcomeV1}
use compiler.tools.verify.formal_product_gate_collectors.{

    Rv64ProductIdentityV1, Rv64ProductCheckKindV1, Rv64EvidenceClassV1,
    ExecutedRv64ProductCheckV1, collect_rv64_privilege_mmu_linux_gate_v1,
    produce_executed_rv64_product_check_v1,
    collect_executed_rv64_privilege_mmu_linux_gate_v1}

fn rv64_identity() -> Rv64ProductIdentityV1:
    Rv64ProductIdentityV1(sha256_text("rv64-hwir"), sha256_text("rv64-rtl"),
        sha256_text("rv64-netlist"), sha256_text("simpleos-image"),
        sha256_text("platform"), sha256_text("assumptions"))

fn rv64_kind(index: i64) -> Rv64ProductCheckKindV1:
    match index:
        case 0: Rv64ProductCheckKindV1.SharedXlenRefinement
        case 1: Rv64ProductCheckKindV1.PrivilegeCsrProof
        case 2: Rv64ProductCheckKindV1.MmuPageWalkProof
        case 3: Rv64ProductCheckKindV1.PreciseTrapInterruptProof
        case 4: Rv64ProductCheckKindV1.PostSynthesisEquivalence
        case 5: Rv64ProductCheckKindV1.LinuxBootValidation
        case _: Rv64ProductCheckKindV1.ArchitecturalCompatibilityValidation

fn rv64_class(index: i64) -> Rv64EvidenceClassV1:
    if index == 4: return Rv64EvidenceClassV1.IndependentlyCheckedRefinement
    if index >= 5: return Rv64EvidenceClassV1.ExecutedValidation
    Rv64EvidenceClassV1.KernelReplayedProof

fn rv64_proof_material() -> [FormalDeliveryReceiptFileV1]:
    var files: [FormalDeliveryReceiptFileV1] = []
    for index in 0..5:
        val content = "rv64-proof-or-certificate-" + index.to_string()
        files.push(FormalDeliveryReceiptFileV1(sha256_text(content), content))
    files

fn rv64_checks() -> [ExecutedRv64ProductCheckV1]:
    val identity_hash = rv64_identity().hash()
    val proofs = rv64_proof_material()
    var checks: [ExecutedRv64ProductCheckV1] = []
    for index in 0..7:
        checks.push(ExecutedRv64ProductCheckV1(
            "ExecutedRv64ProductCheck-v1", rv64_kind(index), rv64_class(index),
            identity_hash, if index < 5: proofs[index].receipt_hash else: "",
            sha256_text("tool-" + index.to_string()),
            sha256_text("policy-" + index.to_string()),
            "retained-rv64-output-" + index.to_string(),
            ExecutedCheckOutcomeV1.Passed, ""))
    checks

fn rv64_receipt_schema(index: i64) -> text:
    match index:
        case 0: "fv2-rv64-shared-xlen-refinement-receipt-v1"
        case 1: "fv2-rv64-privilege-csr-proof-receipt-v1"
        case 2: "fv2-rv64-mmu-page-walk-proof-receipt-v1"
        case 3: "fv2-rv64-precise-trap-interrupt-proof-receipt-v1"
        case 4: "fv2-rv64-post-synthesis-equivalence-receipt-v1"
        case 5: "fv2-rv64-linux-boot-validation-receipt-v1"
        case _: "fv2-rv64-architectural-compatibility-validation-receipt-v1"

fn rv64_receipt_authority(index: i64) -> text:
    match index:
        case 0: "kernel-replayed-shared-xlen"
        case 1: "kernel-replayed-privilege-csr"
        case 2: "kernel-replayed-mmu-page-walk"
        case 3: "kernel-replayed-precise-trap-interrupt"
        case 4: "independent-rtl-netlist-equivalence"
        case 5: "bounded-linux-boot-execution"
        case _: "independent-isa-oracle-execution"

fn rv64_executed_receipt(index: i64) -> text:
    val material = rv64_proof_material()
    val output = "rv64-executed-output-" + index.to_string()
    val schema = rv64_receipt_schema(index)
    "schema " + schema + "\n" +
        "authority " + rv64_receipt_authority(index) + "\n" +
        "product_identity_sha256 " + rv64_identity().hash() + "\n" +
        "proof_or_certificate_sha256 " +
            (if index < 5: material[index].receipt_hash else: "none") + "\n" +
        "tool_identity_sha256 " + sha256_text("tool-" + index.to_string()) + "\n" +
        "command_policy_sha256 " + sha256_text("policy-" + index.to_string()) + "\n" +
        "output_evidence " + output + "\n" +
        "output_sha256 " + sha256_text(output) + "\n" +
        "status passed\n"

fn rv64_executed_receipts() -> [text]:
    var receipts: [text] = []
    for index in 0..7: receipts.push(rv64_executed_receipt(index))
    receipts

describe "FV2 RV64 privilege MMU and Linux delivery gate":
    # @manual scenario evidence
    it "keeps formal refinement and executed validation evidence distinct":
        # @req REQ-SSPEC-COMPILER
        step("keeps formal refinement and executed validation evidence distinct")
        val collection = collect_rv64_privilege_mmu_linux_gate_v1(
            rv64_identity(), rv64_checks(), rv64_proof_material())
        expect(collection.gate_evidence.status.name()).to_equal("failed")
        expect(collection.gate_evidence.diagnostic).to_contain(
            "EXECUTION-AUTHORITY")
        expect(collection.gate_evidence.receipt_hashes.len()).to_equal(0)
        expect(collection.receipt_files.len()).to_equal(0)

    it "rejects reorder product drift missing proof and validation impersonation":
        # @req REQ-SSPEC-COMPILER
        step("rejects reorder product drift missing proof and validation impersonation")
        var reordered = rv64_checks()
        val temporary = reordered[0]
        reordered[0] = reordered[1]
        reordered[1] = temporary
        expect(collect_rv64_privilege_mmu_linux_gate_v1(rv64_identity(),
            reordered, rv64_proof_material()).gate_evidence.diagnostic).to_contain(
                "ORDER")
        var drift = rv64_checks()
        drift[2].product_identity_hash = sha256_text("other-product")
        expect(collect_rv64_privilege_mmu_linux_gate_v1(rv64_identity(), drift,
            rv64_proof_material()).gate_evidence.diagnostic).to_contain("BINDING")
        var missing = rv64_proof_material()
        missing.pop()
        expect(collect_rv64_privilege_mmu_linux_gate_v1(rv64_identity(),
            rv64_checks(), missing).gate_evidence.diagnostic).to_contain(
                "PROOF-COUNT")
        var impersonated = rv64_checks()
        impersonated[5].proof_or_certificate_hash = sha256_text("fake-proof")
        expect(collect_rv64_privilege_mmu_linux_gate_v1(rv64_identity(),
            impersonated, rv64_proof_material()).gate_evidence.diagnostic).to_contain(
                "VALIDATION-CLASS")

    it "rejects timeout and output substitution":
        # @req REQ-SSPEC-COMPILER
        step("rejects timeout and output substitution")
        var timed_out = rv64_checks()
        timed_out[6].outcome = ExecutedCheckOutcomeV1.Timeout
        expect(collect_rv64_privilege_mmu_linux_gate_v1(rv64_identity(),
            timed_out, rv64_proof_material()).gate_evidence.status.name()).to_equal(
                "failed")
        var duplicate_output = rv64_checks()
        duplicate_output[6].retained_output = duplicate_output[5].retained_output
        expect(collect_rv64_privilege_mmu_linux_gate_v1(rv64_identity(),
            duplicate_output, rv64_proof_material()).gate_evidence.diagnostic).to_contain(
                "OUTPUT-DUPLICATE")

    it "rejects caller-built receipt text and public receipt assembly":
        val receipts = rv64_executed_receipts()
        for index in 0..receipts.len():
            val produced = produce_executed_rv64_product_check_v1(
                rv64_identity(), index, receipts[index])
            expect(produced.outcome.name()).to_equal("failed")
            expect(produced.diagnostic).to_contain("EXECUTION-AUTHORITY")
        val collection = collect_executed_rv64_privilege_mmu_linux_gate_v1(
            rv64_identity(), receipts, rv64_proof_material())
        expect(collection.gate_evidence.status.name()).to_equal("failed")
        expect(collection.gate_evidence.diagnostic).to_contain(
            "EXECUTION-AUTHORITY")
        expect(collection.gate_evidence.receipt_hashes.len()).to_equal(0)

    it "rejects missing rows and product or output drift before Gate 6":
        var missing = rv64_executed_receipts()
        missing.pop()
        expect(collect_executed_rv64_privilege_mmu_linux_gate_v1(
            rv64_identity(), missing, rv64_proof_material()).gate_evidence.diagnostic).to_contain(
                "RECEIPT-COUNT")
        var drift = rv64_executed_receipts()
        drift[2] = drift[2].replace(rv64_identity().hash(), sha256_text("drift"))
        expect(collect_executed_rv64_privilege_mmu_linux_gate_v1(
            rv64_identity(), drift, rv64_proof_material()).gate_evidence.status.name()).to_equal(
                "failed")
        var stale = rv64_executed_receipts()
        stale[5] = stale[5].replace("rv64-executed-output-5", "other-output")
        expect(collect_executed_rv64_privilege_mmu_linux_gate_v1(
            rv64_identity(), stale, rv64_proof_material()).gate_evidence.status.name()).to_equal(
                "failed")
