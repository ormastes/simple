use std.spec
use test.fixtures.replay_authority.checks.{replay_authority_fixture_checks_v1}
use test.fixtures.replay_authority.owner_checks.{retained_directory_owner_fixture_checks_v1}

describe "FV2 replay authority candidate resolver":
    it "validates signed candidates and never claims unpinned replay authority":
        val policy_checks = replay_authority_fixture_checks_v1()
        val owner_checks = retained_directory_owner_fixture_checks_v1()
        expect(policy_checks + owner_checks).to_equal(21)
