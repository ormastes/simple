# BUG-2026-10-12-CONTEXT-COMPARISON: a statement that BEGINS with the identifier
# `context` must parse as an expression (not a `context` DSL block) when the next
# token is a binary operator. Rust seed parser_impl/core.rs dispatched every
# `context` statement to parse_context unless the next token was whitelisted, and
# NotEq was not (fix 9fc4b70a52c). Each case below is a distinct next-token arm.
use std.spec
use std.spec.step

fn tail_not_eq_and(context: text, actual: text) -> bool:
    context != "" and context == actual

fn tail_eq(context: text, actual: text) -> bool:
    context == actual

fn tail_lt(context: i64, limit: i64) -> bool:
    context < limit

fn tail_gt(context: i64, limit: i64) -> bool:
    context > limit

fn tail_method(context: text) -> i64:
    context.len()

describe "context identifier at statement start":
    it "parses the NotEq tail that the seed rejected (reproducer)":
        step("context != \"\" and context == actual")
        expect(tail_not_eq_and("a", "a")).to_equal(true)
        expect(tail_not_eq_and("", "a")).to_equal(false)
        expect(tail_not_eq_and("a", "b")).to_equal(false)

    it "parses sibling comparison tails":
        step("==, <, > after context")
        expect(tail_eq("x", "x")).to_equal(true)
        expect(tail_eq("x", "y")).to_equal(false)
        expect(tail_lt(1, 2)).to_equal(true)
        expect(tail_gt(1, 2)).to_equal(false)

    it "parses sibling method tails":
        step(".len() after context; + * / % and or are covered by the Rust parser test")
        expect(tail_method("abc")).to_equal(3)
