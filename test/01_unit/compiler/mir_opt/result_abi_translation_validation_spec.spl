use std.spec
use compiler.mir_opt.mir_opt.result_abi_translation_validation.{
    ResultSemanticOutcomeV1,
    ResultTaggedHandleProjectionV1,
    ResultAbiObservationV1,
    validate_result_abi_translation_v1
}

fn valid_result_abi_observations() -> [ResultAbiObservationV1]:
    [
        ResultAbiObservationV1(
            ResultSemanticOutcomeV1.Normal(0x1020304050607080),
            ResultTaggedHandleProjectionV1(7, 0, 0x1020304050607080)),
        ResultAbiObservationV1(
            ResultSemanticOutcomeV1.Error(-17),
            ResultTaggedHandleProjectionV1(7, 1, -17))
    ]

describe "Result tagged-ABI translation validation":
    it "uses SHA-256 semantic identities with unambiguous observation framing":
        val first = validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", valid_result_abi_observations(),
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true)
        val observations = [
            ResultAbiObservationV1(
                ResultSemanticOutcomeV1.Normal(1),
                ResultTaggedHandleProjectionV1(7, 0, 1)),
            ResultAbiObservationV1(
                ResultSemanticOutcomeV1.Error(-123),
                ResultTaggedHandleProjectionV1(7, 1, -123))
        ]
        val second = validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", observations,
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true)
        expect(first.source_semantic_hash.len()).to_equal(64)
        expect(first.target_semantic_hash.len()).to_equal(64)
        expect(first.source_semantic_hash == second.source_semantic_hash).to_equal(false)

    it "certificates exact normal and error observations against the runtime artifact":
        val result = validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", valid_result_abi_observations(),
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true)
        expect(result.accepted).to_equal(true)
        expect(result.diagnostic).to_equal("")
        expect(result.certificate.unwrap().matches_edge(
            "result-tagged-abi-v1", result.source_semantic_hash,
            result.target_semantic_hash)).to_equal(true)

    it "rejects a variant mutation that maps Error to the Ok discriminant":
        val observations = [
            valid_result_abi_observations()[0],
            ResultAbiObservationV1(
                ResultSemanticOutcomeV1.Error(-17),
                ResultTaggedHandleProjectionV1(7, 0, -17))
        ]
        val result = validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", observations,
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true)
        expect(result.accepted).to_equal(false)
        expect(result.diagnostic).to_contain("DISCRIMINANT")

    it "rejects payload corruption and enum-identity substitution":
        var observations = valid_result_abi_observations()
        observations[0] = ResultAbiObservationV1(
            ResultSemanticOutcomeV1.Normal(41),
            ResultTaggedHandleProjectionV1(7, 0, 42))
        val payload_result = validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", observations,
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true)
        expect(payload_result.diagnostic).to_contain("PAYLOAD")

        observations = valid_result_abi_observations()
        observations[1] = ResultAbiObservationV1(
            ResultSemanticOutcomeV1.Error(-17),
            ResultTaggedHandleProjectionV1(8, 1, -17))
        val enum_result = validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", observations,
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true)
        expect(enum_result.diagnostic).to_contain("ENUM")

    it "rejects one-sided coverage and missing trust or artifact identity":
        val normal_only = [valid_result_abi_observations()[0]]
        expect(validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", normal_only,
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true).diagnostic).to_contain("COVERAGE")
        expect(validate_result_abi_translation_v1(
            7, "", valid_result_abi_observations(),
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", true).diagnostic).to_contain("ARTIFACT")
        expect(validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", valid_result_abi_observations(),
            "", "axiom-audit-hash", true).diagnostic).to_contain("AUDIT")
        expect(validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", valid_result_abi_observations(),
            "SomeOther.refines", "axiom-audit-hash", true).diagnostic).to_contain("ROOT")
        expect(validate_result_abi_translation_v1(
            7, "runtime-artifact-hash", valid_result_abi_observations(),
            "ResultTaggedAbi.validate_sound", "axiom-audit-hash", false).diagnostic).to_contain("CHECK")
