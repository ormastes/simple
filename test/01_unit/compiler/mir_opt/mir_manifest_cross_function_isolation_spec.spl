use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.{
    BlockId, LocalId, MirBuilder, MirExceptionCleanupContractKind,
    MirExceptionCleanupContract, MirFunction,
    MirInstKind, MirOperand, MirOperandKind, MirSignature, MirType,
    MirTypeKind, MirConstValue, mir_operand_copy
}
use compiler.mir_opt.mir_opt.mod.{
    OptLevel, PassKind, PassScope, passmanager_new,
    apply_bulk_recognizers, passmanager_run_on_module, run_pass_on_module
}
use compiler.mir_opt.optimizer_plugin.{
    ApplyMode, optimizer_plugin_mir, optimizer_plugin_run_on_module
}
use compiler.mir_opt.mir_opt.dce.{create_dce_pass, dce_run_on_function}
use compiler.mir_opt.mir_opt.copy_prop.{create_copy_prop_pass, copypropagation_run_on_function}
use compiler.mir_opt.mir_opt.cse.{create_cse_pass, cse_run_on_function}
use compiler.mir_opt.mir_opt.predicate_promote.{
    promote_function_predicate, run_predicate_promote
}
use compiler.mir_opt.mir_opt._AutoVectorize.rewrite.{run_auto_vectorize}
use compiler.mir_opt.mir_opt.pattern_dispatch.{run_pattern_idiom_pass}

extern fn rt_file_read_text(path: text) -> text

fn isolation_function(symbol_id: i64, name: text, callee: text?) -> MirFunction:
    var builder = MirBuilder.new()
    builder.begin_function(
        SymbolId(id: symbol_id), name,
        MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        Span.empty())
    if callee == nil:
        val value = builder.emit_const_int(41)
        builder.terminate_return(Some(mir_operand_copy(value)))
    else:
        val function = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(callee.unwrap()),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                params: [], return_type: MirType.unit(), is_variadic: false)))))
        builder.emit_call(function, [], MirType.unit())
        builder.terminate_return(nil)
    builder.end_function()

fn mark_manifested(function: MirFunction) -> MirFunction:
    var result = function
    result.exception_cleanup_contracts = [MirExceptionCleanupContract(
        kind: MirExceptionCleanupContractKind.OrdinaryUnwind,
        unwind_entry: BlockId(id: 70),
        token: LocalId(id: 71),
        entries: [])]
    result

fn isolation_module(first: MirFunction, second: MirFunction):
    var builder = MirBuilder.new()
    builder.add_function(first)
    builder.add_function(second)
    builder.module

fn function_call_count(function: MirFunction) -> i64:
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case Call(_, _, _): count = count + 1
                case _: ()
    count

describe "manifested MIR cross-function optimizer isolation":
    it "does not copy a manifested callee into an unmanifested caller":
        val callee = mark_manifested(isolation_function(701, "sealed", nil))
        val caller = isolation_function(702, "caller", Some("sealed"))
        val optimized = run_pass_on_module(
            "inline_functions", isolation_module(callee, caller))
        expect(function_call_count(optimized.functions[caller.symbol])).to_equal(1)
        expect(optimized.functions[callee.symbol].exception_cleanup_contracts.len()).to_equal(1)

    it "does not copy an unmanifested callee into a manifested caller":
        val callee = isolation_function(703, "ordinary", nil)
        val caller = mark_manifested(
            isolation_function(704, "sealed_caller", Some("ordinary")))
        val optimized = run_pass_on_module(
            "inline_aggressive", isolation_module(callee, caller))
        expect(function_call_count(optimized.functions[caller.symbol])).to_equal(1)
        expect(optimized.functions[caller.symbol].exception_cleanup_contracts.len()).to_equal(1)

    it "filters manifested owners before inlining and outlining":
        val source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/mod.spl") ?? ""
        expect(source).to_contain("mir_opt_unmanifested_function_slice")
        expect(source).to_contain(
            "outline_run_on_module(ol, filtered)")
        val inline_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/_Inline/driver.spl") ?? ""
        expect(inline_source).to_contain(
            "if func.exception_cleanup_contracts.len() > 0:")

    it "identity-preserves manifested functions across representative named passes":
        val sealed = mark_manifested(
            isolation_function(705, "sealed_named_passes", Some("external")))
        val ordinary = isolation_function(706, "ordinary_named_passes", nil)
        for pass_name in [
            "dead_code_elimination", "copy_propagation", "common_subexpr_elim",
            "predicate_promote", "auto_vectorize", "pattern_idiom"]:
            val optimized = run_pass_on_module(
                pass_name, isolation_module(sealed, ordinary))
            val preserved = optimized.functions[sealed.symbol]
            expect(function_call_count(preserved)).to_equal(1)
            expect(preserved.exception_cleanup_contracts.len()).to_equal(1)

    it "identity-preserves manifested functions through pass manager and plugin adapters":
        val sealed = mark_manifested(
            isolation_function(707, "sealed_adapters", Some("external")))
        val ordinary = isolation_function(708, "ordinary_adapters", nil)
        val module = isolation_module(sealed, ordinary)

        var manager = passmanager_new()
        manager.passes = ["dead_code_elimination", "copy_propagation"]
        val managed = manager.passmanager_run_on_module(module)
        expect(function_call_count(managed.functions[sealed.symbol])).to_equal(1)
        expect(managed.functions[sealed.symbol].exception_cleanup_contracts.len()).to_equal(1)

        val plugin = optimizer_plugin_mir(
            "adversarial_dce", [], PassKind.DeadCodeElimination,
            PassScope.Function, ApplyMode.Static, OptLevel.Speed, "cheap")
        val plugged = optimizer_plugin_run_on_module(plugin, module)
        expect(function_call_count(plugged.functions[sealed.symbol])).to_equal(1)
        expect(plugged.functions[sealed.symbol].exception_cleanup_contracts.len()).to_equal(1)

    it "identity-preserves manifested functions through raw exported module transforms":
        val sealed = mark_manifested(
            isolation_function(709, "sealed_raw_exports", Some("external")))
        val ordinary = isolation_function(710, "ordinary_raw_exports", nil)
        val module = isolation_module(sealed, ordinary)
        for transformed in [
            run_predicate_promote(module),
            run_auto_vectorize(module),
            run_pattern_idiom_pass(module)]:
            val preserved = transformed.functions[sealed.symbol]
            expect(function_call_count(preserved)).to_equal(1)
            expect(preserved.exception_cleanup_contracts.len()).to_equal(1)

        val bulk = apply_bulk_recognizers(module)
        expect(function_call_count(bulk.functions[sealed.symbol])).to_equal(1)
        expect(bulk.functions[sealed.symbol].exception_cleanup_contracts.len()).to_equal(1)

    it "identity-preserves manifested functions through raw exported function transforms":
        val sealed = mark_manifested(
            isolation_function(711, "sealed_raw_functions", Some("external")))
        val after_dce = dce_run_on_function(create_dce_pass(), sealed)
        val after_copy = copypropagation_run_on_function(
            create_copy_prop_pass(), sealed)
        val after_cse = cse_run_on_function(create_cse_pass(), sealed)
        val after_predicate = promote_function_predicate(sealed)
        for preserved in [after_dce, after_copy, after_cse, after_predicate]:
            expect(function_call_count(preserved)).to_equal(1)
            expect(preserved.exception_cleanup_contracts.len()).to_equal(1)

    it "routes all module adapters through universal filtering and reinsertion":
        val mod_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/mod.spl") ?? ""
        expect(mod_source).to_contain(
            "var result_module = mir_opt_unmanifested_function_slice(module)")
        expect(mod_source).to_contain(
            "mir_opt_reinsert_manifested_functions(original_module, result_module)")
        val plugin_source = rt_file_read_text(
            "src/compiler/60.mir_opt/optimizer_plugin.spl") ?? ""
        expect(plugin_source).to_contain(
            "run_typed_pass_on_module(kind, module)")
        val pattern_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/pattern/pattern_rule_pass.spl") ?? ""
        expect(pattern_source).to_contain(
            "if func.exception_cleanup_contracts.len() > 0:")
        expect(pattern_source).to_contain(
            "result.functions[sym] = func")

    it "guards every public raw optimizer function boundary":
        val boundary_cases = [
            ["src/compiler/60.mir_opt/mir_opt/collection_opt.spl",
             "fn collection_opt_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/const_fold.spl",
             "fn cf_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/_Inline/driver.spl",
             "fn inline_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/loop_opt.spl",
             "fn loop_opt_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/bounds_check_elim.spl",
             "fn bounds_check_elim_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/loop_strength.spl",
             "fn strength_reduction_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/outline.spl",
             "fn outline_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/generator_sm.spl",
             "fn generator_sm_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/string_builder_opt.spl",
             "fn string_builder_opt_run_on_function"],
            ["src/compiler/60.mir_opt/mir_opt/mir_visitor.spl",
             "fn mir_rewriter_apply_to_function"]]
        for boundary in boundary_cases:
            val source = rt_file_read_text(boundary[0]) ?? ""
            expect(source).to_contain(boundary[1])
            expect(source).to_contain(
                "if func.exception_cleanup_contracts.len() > 0:")

    it "guards vector rewrite and hides block-only transforms from public APIs":
        val vector_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/_AutoVectorize/rewrite.spl") ?? ""
        expect(vector_source).to_contain(
            "fn rewrite_elementwise_add(recipe: VectorRecipe, func: MirFunction) -> MirFunction:\n")
        expect(vector_source).to_contain(
            "if func.exception_cleanup_contracts.len() > 0:")
        val predicate_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/predicate_promote.spl") ?? ""
        expect(predicate_source).to_contain("export promote_function_predicate")
        expect(predicate_source).not_to_contain(
            "export promote_function_predicate, promote_block_predicate")
        val init_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/__init__.spl") ?? ""
        expect(init_source).not_to_contain("export lower_block_simd")
        val visitor_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/mir_visitor.spl") ?? ""
        expect(visitor_source).not_to_contain(
            "export mir_rewriter_apply_to_function, mir_rewriter_apply_to_block")
        val rules_source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/pattern/pattern_rule_pass.spl") ?? ""
        expect(rules_source).not_to_contain(
            "export apply_rules_to_block, apply_rules_to_function")

    it "guards every public raw IO optimizer boundary":
        val source = rt_file_read_text(
            "src/compiler/60.mir_opt/_OptimizationPasses/io_passes.spl") ?? ""
        for signature in [
            "fn optimize_write_coalesce(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn optimize_read_ahead_hoist(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:",
            "fn optimize_syscall_batch(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn optimize_bulk_copy(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn elide_bulk_copy(func: MirFunction, stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn optimize_bulk_fill(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn optimize_bulk_cmp(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn optimize_endian_load(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:",
            "fn optimize_endian_store(func: MirFunction, mut stats: OptimizationStats) -> MirFunction:\n    if func.exception_cleanup_contracts.len() > 0:"]:
            expect(source).to_contain(signature)
