use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use std.fs.{read_file}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir_opt.mir_opt.storage_access_analysis.{
    MirStorageAccessFactV1, MirStorageAccessSummaryV1,
    analyze_mir_storage_access_summary, mir_storage_region_binding_v1
}
use compiler.mir_opt.mir_opt.storage_layout_access_advisory.{
    storage_layout_access_advisory_v1,
    storage_layout_access_advisory_with_memory_policy_v1
}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.common.parallel_policy.policy_schema.{ResolvedMemoryPolicyV1}
use std.common.structural.parallel_commit.access_contracts.{
    ParallelAccessMode, parallel_access_path_v1, parallel_access_paths_conflict
}
use std.common.structural.storage_layout.planner.{storage_layout_plan_auto}
use std.common.structural.storage_layout.storage_layout_contracts.{
    StorageLayoutKind, storage_layout_kind_to_u8
}

fn advisory_copy(local_id: i64) -> MirOperand:
    MirOperand.copy(LocalId(id: local_id))

fn advisory_index(value: i64) -> MirOperand:
    MirOperand.const_int(value)

fn advisory_function(reverse_order: bool, dynamic_index: bool) -> MirFunction:
    val first_index = if dynamic_index:
        advisory_copy(30)
    else:
        advisory_index(3)
    val first = [
        MirInst(kind: MirInstKind.GetElementPtr(
            LocalId(id: 1), advisory_copy(10), [first_index]), span: nil),
        MirInst(kind: MirInstKind.Load(
            LocalId(id: 2), advisory_copy(1)), span: nil),
        MirInst(kind: MirInstKind.GetField(
            LocalId(id: 3), advisory_copy(2), 4), span: nil)
    ]
    val second = [
        MirInst(kind: MirInstKind.GetElementPtr(
            LocalId(id: 4), advisory_copy(10), [advisory_index(5)]), span: nil),
        MirInst(kind: MirInstKind.Load(
            LocalId(id: 5), advisory_copy(4)), span: nil),
        MirInst(kind: MirInstKind.GetField(
            LocalId(id: 6), advisory_copy(5), 7), span: nil)
    ]
    val instructions = if reverse_order: second + first else: first + second
    var locals: [MirLocal] = []
    var local_id = 0
    while local_id <= 30:
        locals.push(MirLocal(LocalId(id: local_id), Some("l{local_id}"),
            MirType.i64(), LocalKind.Temp, false))
        local_id = local_id + 1
    MirFunction(symbol: SymbolId.new(951), name: "layout_advisory",
        signature: MirSignature(params: [], return_type: MirType.unit(),
            is_variadic: false), locals: locals, blocks: [MirBlock(
                id: BlockId.new(0), label: Some("entry"),
                instructions: instructions, terminator: MirTerminator.Ret(nil))],
        entry_block: BlockId.new(0), span: nil, generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})

fn advisory_for(function: MirFunction, simd_width: i64,
                gpu: bool, abi: bool):
    val summary = analyze_mir_storage_access_summary(function,
        [mir_storage_region_binding_v1(10, 200)])
    storage_layout_access_advisory_v1(summary, 9201, 3, 32, 16,
        simd_width, gpu, abi, "access-policy-v1")

fn advisory_layout_tag(function: MirFunction, simd_width: i64,
                       gpu: bool, abi: bool) -> i64:
    storage_layout_kind_to_u8(
        storage_layout_plan_auto(
            advisory_for(function, simd_width, gpu, abi).request).layout)

fn advisory_fact(region_id: i64, start: i64, end: i64,
                 field_id: i64, known_range: bool = true,
                 mode: ParallelAccessMode = ParallelAccessMode.Read
) -> MirStorageAccessFactV1:
    val path = parallel_access_path_v1(region_id, start, end, known_range,
        "field:{field_id}", mode)
    MirStorageAccessFactV1(path: path, has_field: true,
        field_id: field_id, structural_record_load: false)

fn advisory_summary(facts: [MirStorageAccessFactV1],
                    complete: bool = true) -> MirStorageAccessSummaryV1:
    MirStorageAccessSummaryV1(accesses: [], typed_facts: facts,
        address_observed: false, unknown_access: false, complete: complete)

fn advisory_from_facts(facts: [MirStorageAccessFactV1],
                       complete: bool = true):
    storage_layout_access_advisory_v1(advisory_summary(facts, complete),
        9201, 3, 32, 16, 1, false, false, "access-policy-v1")

describe "typed storage access layout advisory":
    it "advises SoA SIMD AoSoA explicit GPU grouping and pinned ABI":
        val function = advisory_function(false, false)
        assert_equal(advisory_layout_tag(function, 1, false, false),
            storage_layout_kind_to_u8(StorageLayoutKind.SoA))
        assert_equal(advisory_layout_tag(function, 8, false, false),
            storage_layout_kind_to_u8(StorageLayoutKind.AoSoA))
        assert_equal(advisory_layout_tag(function, 1, true, false),
            storage_layout_kind_to_u8(StorageLayoutKind.Grouped))
        assert_equal(advisory_layout_tag(function, 1, true, true),
            storage_layout_kind_to_u8(StorageLayoutKind.ExternalFixed))

    it "falls back to AoS for dynamic unknown and empty evidence":
        val dynamic = advisory_for(advisory_function(false, true), 1, false, false)
        assert_false(dynamic.complete)
        assert_false(dynamic.independent_field_access)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(dynamic.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

        val unknown_summary = analyze_mir_storage_access_summary(
            advisory_function(false, false), [])
        val unknown = storage_layout_access_advisory_v1(unknown_summary,
            9201, 3, 32, 16, 1, false, false, "access-policy-v1")
        assert_false(unknown.complete)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(unknown.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

        val empty_function = MirFunction(..advisory_function(false, false),
            blocks: [MirBlock(id: BlockId.new(0), label: Some("entry"),
                instructions: [], terminator: MirTerminator.Ret(nil))])
        val empty = advisory_for(empty_function, 1, false, false)
        assert_false(empty.complete)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(empty.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

        val observed_function = MirFunction(..advisory_function(false, false),
            blocks: [MirBlock(id: BlockId.new(0), label: Some("entry"),
                instructions: [MirInst(kind: MirInstKind.Cast(
                    LocalId(id: 50), advisory_copy(10), MirType.i64()), span: nil)],
                terminator: MirTerminator.Ret(nil))])
        val observed = advisory_for(observed_function, 1, false, false)
        assert_false(observed.complete)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(observed.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

    it "keeps co-accessing field paths conflicting and identity order stable":
        val forward_summary = analyze_mir_storage_access_summary(
            advisory_function(false, false),
            [mir_storage_region_binding_v1(10, 200)])
        assert_false(parallel_access_paths_conflict(
            forward_summary.accesses[1], forward_summary.accesses[3]))
        val forward = storage_layout_access_advisory_v1(forward_summary,
            9201, 3, 32, 16, 1, false, false, "access-policy-v1")
        val reversed = advisory_for(advisory_function(true, false),
            1, false, false)
        assert_true(forward.complete)
        assert_equal(forward.identity, reversed.identity)

        val coaccess_function = MirFunction(..advisory_function(false, false),
            blocks: [MirBlock(id: BlockId.new(0), label: Some("entry"),
                instructions: [
                    MirInst(kind: MirInstKind.GetField(
                        LocalId(id: 1), advisory_copy(10), 4), span: nil),
                    MirInst(kind: MirInstKind.SetField(
                        advisory_copy(10), 7, advisory_copy(40)), span: nil)
                ], terminator: MirTerminator.Ret(nil))])
        val coaccess_summary = analyze_mir_storage_access_summary(
            coaccess_function, [mir_storage_region_binding_v1(10, 200)])
        assert_true(parallel_access_paths_conflict(
            coaccess_summary.accesses[0], coaccess_summary.accesses[1]))
        val coaccess = storage_layout_access_advisory_v1(coaccess_summary,
            9201, 3, 32, 16, 1, false, false, "access-policy-v1")
        assert_false(coaccess.complete)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(coaccess.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

    it "preserves half-open region and field overlap semantics":
        val adjacent = advisory_from_facts([
            advisory_fact(200, 0, 2, 4),
            advisory_fact(200, 2, 4, 7)
        ])
        assert_true(adjacent.complete)
        assert_true(adjacent.independent_field_access)

        val separate_regions = advisory_from_facts([
            advisory_fact(200, 0, 4, 4),
            advisory_fact(201, 0, 4, 7)
        ])
        assert_true(separate_regions.complete)
        assert_true(separate_regions.independent_field_access)

        val repeated_field = advisory_from_facts([
            advisory_fact(200, 0, 4, 4),
            advisory_fact(200, 1, 3, 4),
            advisory_fact(200, 5, 6, 7)
        ])
        assert_true(repeated_field.complete)
        assert_true(repeated_field.independent_field_access)

    it "rejects nested equal-start and incomplete overlap evidence":
        val nested = advisory_from_facts([
            advisory_fact(200, 0, 8, 4),
            advisory_fact(200, 2, 4, 7)
        ])
        assert_false(nested.complete)

        val equal_start = advisory_from_facts([
            advisory_fact(200, 0, 4, 4),
            advisory_fact(200, 0, 2, 7)
        ])
        assert_false(equal_start.complete)
        assert_false(equal_start.independent_field_access)

        val repeated_field_then_overlap = advisory_from_facts([
            advisory_fact(200, 0, 100, 4),
            advisory_fact(200, 1, 90, 4),
            advisory_fact(200, 95, 110, 7)
        ])
        assert_false(repeated_field_then_overlap.complete)
        assert_false(repeated_field_then_overlap.independent_field_access)

        val unknown_range = advisory_from_facts([
            advisory_fact(200, 0, 4, 4, false),
            advisory_fact(200, 5, 6, 7)
        ])
        assert_false(unknown_range.complete)
        assert_false(unknown_range.independent_field_access)

        val incomplete = advisory_from_facts([
            advisory_fact(200, 0, 1, 4),
            advisory_fact(200, 2, 3, 7)
        ], false)
        assert_false(incomplete.complete)
        assert_false(incomplete.independent_field_access)

    it "preserves the legacy predicate for malformed known ranges":
        val contained_inverted = advisory_from_facts([
            advisory_fact(200, 0, 10, 4),
            advisory_fact(200, 5, 3, 7)
        ])
        assert_false(contained_inverted.complete)

        val separated_inverted = advisory_from_facts([
            advisory_fact(200, 5, 3, 4),
            advisory_fact(200, 6, 10, 7)
        ])
        assert_true(separated_inverted.complete)

    it "keeps multi-row identity independent of fact order":
        val forward = advisory_from_facts([
            advisory_fact(200, 0, 1, 4),
            advisory_fact(200, 3, 4, 7, true, ParallelAccessMode.Write),
            advisory_fact(200, 6, 7, 4)
        ])
        val reverse = advisory_from_facts([
            advisory_fact(200, 6, 7, 4),
            advisory_fact(200, 3, 4, 7, true, ParallelAccessMode.Write),
            advisory_fact(200, 0, 1, 4)
        ])
        assert_equal(forward.identity, reverse.identity)

    it "denies all-field and non-field record uses":
        val clean_summary = analyze_mir_storage_access_summary(
            advisory_function(false, false),
            [mir_storage_region_binding_v1(10, 200)])
        val all_fields = storage_layout_access_advisory_v1(clean_summary,
            9201, 2, 32, 16, 1, false, false, "access-policy-v1")
        assert_false(all_fields.complete)
        assert_false(all_fields.independent_field_access)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(all_fields.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

        val base = advisory_function(false, false)
        val block = base.blocks[0]
        var instructions = block.instructions
        val call_type = MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [MirType.i64()], return_type: MirType.unit(),
            is_variadic: false)))
        instructions.push(MirInst(kind: MirInstKind.Call(nil,
            MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("consume_record"), call_type)),
            [advisory_copy(2)]), span: nil))
        val escaped_record = MirFunction(..base, blocks: [
            MirBlock(..block, instructions: instructions)
        ])
        val escaped = advisory_for(escaped_record, 1, false, false)
        assert_false(escaped.complete)
        assert_false(escaped.independent_field_access)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(escaped.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

    it "uses memory policy to pin observed storage and deny critical conversion":
        val observed_function = MirFunction(..advisory_function(false, false),
            blocks: [MirBlock(id: BlockId.new(0), label: Some("entry"),
                instructions: [MirInst(kind: MirInstKind.Cast(
                    LocalId(id: 50), advisory_copy(10), MirType.i64()), span: nil)],
                terminator: MirTerminator.Ret(nil))])
        val observed_summary = analyze_mir_storage_access_summary(
            observed_function, [mir_storage_region_binding_v1(10, 200)])
        val balanced = storage_layout_access_advisory_with_memory_policy_v1(
            observed_summary, 9201, 3, 32, 16, 8, true, false,
            "access-policy-v1", ResolvedMemoryPolicyV1.balanced())
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(balanced.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.ExternalFixed))

        val clean_summary = analyze_mir_storage_access_summary(
            advisory_function(false, false), [mir_storage_region_binding_v1(10, 200)])
        val critical = storage_layout_access_advisory_with_memory_policy_v1(
            clean_summary, 9201, 3, 32, 16, 8, true, false,
            "access-policy-v1", ResolvedMemoryPolicyV1.for_assurance(
                AssuranceStrictness.Critical))
        assert_false(critical.independent_field_access)
        assert_equal(storage_layout_kind_to_u8(
            storage_layout_plan_auto(critical.request).layout),
            storage_layout_kind_to_u8(StorageLayoutKind.AoS))

    it "indexes field identity and uses the standard deterministic sort":
        val source = read_file(
            "src/compiler/60.mir_opt/mir_opt/storage_layout_access_advisory.spl")
        assert_true(source.contains("field_id_set.contains_key(fact.field_id)"))
        assert_true(source.contains("identity_rows.sort()"))
        assert_false(source.contains("for existing in field_ids"))
        assert_false(source.contains("while j < identity_rows.len()"))
        assert_true(source.contains("fn storage_layout_sort_intervals("))
        assert_true(source.contains("fn storage_layout_has_cross_field_overlap("))
        assert_false(source.contains("while right < summary.typed_facts.len()"))
