# OptimizationPipeline aggregate transport regression.
#
# The source-matched native driver currently crashes while returning or
# projecting this aggregate. Keep this test red until the optimizer repair
# removes the temporary aggregate projection and the native AOT probe passes.
#
# @cover src/compiler/60.mir_opt/mir_opt/mod.spl

use std.io.{file_read}

describe "OptimizationPipeline aggregate transport":
    it "removes the crashing aggregate return from backend optimization":
        val source = file_read("src/compiler/60.mir_opt/mir_opt/mod.spl")
        val consumer_start = source.index_of(
            "fn optimize_module_for_backend(module: MirModule, level: OptLevel, backend_name: text) -> MirModule:"
        )
        val consumer_end = source.index_of(
            "fn optimize_module_for_backend_budget(", consumer_start
        )
        val consumer = source.slice(consumer_start, consumer_end)
        expect(consumer.contains(
            "optimizationpipeline_for_backend(level, backend_name)"
        )).to_equal(false)
