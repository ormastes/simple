use std.spec.*
use compiler.mir_opt.optimizer_kernel_contract.*

fn identity(name: text, version: text, implementation: text) -> OptimizerPluginIdentityV1:
    OptimizerPluginIdentityV1(name, version, "simple.opt.mir.v1", implementation)

describe "versioned optimizer kernel contract":
    it "selects deterministically and rejects conflicting identities":
        val a = identity("core", "1", "impl-a")
        val b = identity("other", "1", "impl-b")
        val selected = optimizer_kernel_select([b, a], "core", false, b)
        match selected:
            case Ok(value): expect(value.identity.digest()).to_equal(a.digest())
            case Err(message): fail(message)
        match optimizer_kernel_select([a, identity("core", "2", "impl-c")], "core", false, b):
            case Ok(_): fail("conflicting identities were admitted")
            case Err(message): expect(message).to_contain("conflicting")

    it "uses legacy only when explicitly admitted":
        val legacy = identity("legacy", "1", "builtin")
        match optimizer_kernel_select([], "missing", false, legacy):
            case Ok(_): fail("implicit fallback was admitted")
            case Err(message): expect(message).to_contain("unavailable")
        val selected = optimizer_kernel_select([], "missing", true, legacy)
        match selected:
            case Ok(value): expect(value.used_legacy_fallback).to_equal(true)
            case Err(message): fail(message)

    it "keys producer target plugin version implementation and normalized flags":
        val plugin = identity("core", "1", "impl-a")
        val base = OptimizerKernelCacheIdentityV1("phase3", "x86_64", plugin, "O2", ["debug=false", "cpu=v3"])
        val reordered = OptimizerKernelCacheIdentityV1("phase3", "x86_64", plugin, "O2", ["cpu=v3", "debug=false"])
        expect(optimizer_kernel_cache_key(base)).to_equal(optimizer_kernel_cache_key(reordered))
        val bumped = OptimizerKernelCacheIdentityV1("phase3", "x86_64", identity("core", "2", "impl-a"), "O2", reordered.profile_flags)
        expect(optimizer_kernel_cache_key(base) == optimizer_kernel_cache_key(bumped)).to_equal(false)

    it "treats mismatched or corrupt cache material as misses":
        val plugin = identity("core", "1", "impl-a")
        match optimizer_kernel_select([plugin], "core", false, plugin):
            case Ok(selection):
                expect(optimizer_kernel_receipt("key", "key", true, selection).cache_hit).to_equal(true)
                expect(optimizer_kernel_receipt("key", "old", true, selection).reason).to_equal("identity-mismatch")
                expect(optimizer_kernel_receipt("key", "key", false, selection).reason).to_equal("corrupt-content")
            case Err(message): fail(message)
