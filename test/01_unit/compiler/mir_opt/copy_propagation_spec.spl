## Overview

    it "contains no partial copy or move rewrite helpers":
        step("Prevent activation without exhaustive ownership-safe coverage")
        val source = read_file(
            "src/compiler/60.mir_opt/mir_opt/copy_prop.spl")
        expect(source).not.to_contain("copychain_get_root")
        expect(source).not.to_contain("copypropagation_propagate_block")
        expect(source).not.to_contain("copypropagation_propagate_instruction")
        expect(source).not.to_contain("copypropagation_propagate_operand")
        expect(source).not.to_contain("copypropagation_propagate_terminator")
        expect(source).not.to_contain("MirInstKind.Move")
