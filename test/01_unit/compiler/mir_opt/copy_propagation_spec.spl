# @cover src/compiler/60.mir_opt/mir_opt/copy_prop.spl 80%
"""
Copy-propagation quarantine contracts.

**Feature IDs:** #web-server-optimizer-complete
**Category:** Compiler / MIR Optimization
**Difficulty:** 2/5
**Status:** Draft

## Overview

The copy-propagation pass stays quarantined until it has exhaustive
ownership-safe coverage; no partial rewrite helpers may ship.
"""

use std.spec
use std.fs.{read_file}

describe "copy propagation quarantine":
    it "contains no partial copy or move rewrite helpers":
        step("Prevent activation without exhaustive ownership-safe coverage")
        val source = read_file(
            "src/compiler/60.mir_opt/mir_opt/copy_prop.spl")
        expect(source.contains("copychain_get_root")).to_equal(false)
        expect(source.contains("copypropagation_propagate_block")).to_equal(false)
        expect(source.contains("copypropagation_propagate_instruction")).to_equal(false)
        expect(source.contains("copypropagation_propagate_operand")).to_equal(false)
        expect(source.contains("copypropagation_propagate_terminator")).to_equal(false)
        expect(source.contains("MirInstKind.Move")).to_equal(false)
