# @tag: unit, compiler, mir
# @bug: copy_propagation_stripped_method_regression_2026-10-11
use std.spec
use compiler.mir.mir_types.{LocalId}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instructions.{MirInst}
use compiler.mir_opt.copy_prop.{copypropagation_new, copypropagation_propagate_instruction, copypropagation_propagate_terminator}

describe "copy propagation resolves declared helper names":
    it "preserves a load destination and its uncopied pointer operand":
        val original = MirInst(kind: MirInstKind.Load(LocalId(id: 17), MirOperand.copy(LocalId(id: 7))), span: nil)
        val rewritten = copypropagation_propagate_instruction(copypropagation_new(), original)
        match rewritten.kind:
            case MirInstKind.Load(dest, pointer):
                expect(dest.id).to_equal(17)
                match pointer.kind:
                    case MirOperandKind.Copy(local):
                        expect(local.id).to_equal(7)
                    case _:
                        expect(false).to_equal(true)
            case _:
                expect(false).to_equal(true)

    it "preserves an uncopied return operand through the named helper":
        val original = MirTerminator.Ret(MirOperand.copy(LocalId(id: 5)))
        val rewritten = copypropagation_propagate_terminator(copypropagation_new(), original)
        match rewritten:
            case MirTerminator.Ret(value):
                match value.kind:
                    case MirOperandKind.Copy(local):
                        expect(local.id).to_equal(5)
                    case _:
                        expect(false).to_equal(true)
            case _:
                expect(false).to_equal(true)
