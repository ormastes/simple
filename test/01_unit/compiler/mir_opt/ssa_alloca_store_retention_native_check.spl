use compiler.mir.mir_instructions.{
    BlockId, MirBlock, MirInst, MirInstKind, MirOperand, MirOperandKind,
    MirTerminator
}
use compiler.mir.mir_types.{LocalId, LocalKind, MirConstValue, MirLocal, MirType}
use compiler.mir_opt.mir_opt.var_reassign_ssa.{ssa_alloca_transform_blocks}

extern fn rt_exit(code: i32)

fn local(id: i64) -> LocalId:
    LocalId(id: id)

fn copy_operand(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(local(id)))

fn retained_cross_block_store(value: MirConstValue, type_: MirType) -> bool:
    val blocks = [
        MirBlock(
            id: BlockId.new(0),
            label: "entry",
            instructions: [MirInst(kind: MirInstKind.Const(local(5), value, type_), span: nil)],
            terminator: MirTerminator.Goto(BlockId.new(1))
        ),
        MirBlock(
            id: BlockId.new(1),
            label: "return",
            instructions: [],
            terminator: MirTerminator.Ret(Some(copy_operand(5)))
        )
    ]
    val locals = [MirLocal(id: local(5), name: nil, type_: type_, kind: LocalKind.Var, is_ghost: false)]
    val result = ssa_alloca_transform_blocks(blocks, locals, BlockId.new(0))
    if not result.applied or result.blocks.len() != 2:
        return false
    val entry = result.blocks[0].instructions
    val ret = result.blocks[1]
    if entry.len() != 3 or ret.instructions.len() != 1:
        return false

    var slot_id = -1
    var value_id = -1
    match entry[0].kind:
        case Alloc(dest, _): slot_id = dest.id
        case _: return false
    match entry[1].kind:
        case Const(dest, _, _): value_id = dest.id
        case _: return false
    match entry[2].kind:
        case Store(ptr, stored):
            match ptr.kind:
                case Copy(local_):
                    if local_.id != slot_id: return false
                case _: return false
            match stored.kind:
                case Copy(local_):
                    if local_.id != value_id: return false
                case _: return false
        case _: return false

    var loaded_id = -1
    match ret.instructions[0].kind:
        case Load(dest, ptr):
            loaded_id = dest.id
            match ptr.kind:
                case Copy(local_):
                    if local_.id != slot_id: return false
                case _: return false
        case _: return false
    match ret.terminator:
        case Ret(returned):
            if returned == nil: return false
            match returned.unwrap().kind:
                case Copy(local_): local_.id == loaded_id
                case _: false
        case _: false

val exact_bool = retained_cross_block_store(MirConstValue.Bool(true), MirType.bool())
val adjacent_text = retained_cross_block_store(
    MirConstValue.Str("linux"),
    MirType.ptr(MirType.i64(), false)
)
if not exact_bool or not adjacent_text:
    print "FAIL: alloca rewrite dropped a defining instruction or its slot store"
    rt_exit(1)

print "PASS: alloca rewrite retains bool and text-pointer definitions and stores"
rt_exit(0)
