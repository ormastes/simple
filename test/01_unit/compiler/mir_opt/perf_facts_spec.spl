"""
## Purpose and audience
Purpose: Prove that shared MIR performance facts build one reusable CFG view.
Audience: compiler analysis and optimizer maintainers.
"""
# @req: REQ-013

use std.spec.*
use std.fs.{read_file}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction, MirBlock}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.mir_opt.mir_opt.perf_facts.{
    PerfFactKind, PerfFactPreservation,
    perf_instruction_access,
    perf_facts_build, perf_facts_build_for_verification,
    perf_facts_successors, perf_facts_predecessors,
    perf_facts_dominates, perf_facts_definitions, perf_facts_uses,
    perf_facts_is_live_in, perf_facts_is_live_out,
    perf_fact_preservation_all, perf_fact_preservation_cfg_only,
    perf_fact_preservation_integrity_errors, perf_facts_invalidated
}
use compiler.mir_opt.mir_opt.loop_detect.{LoopDetector}
use compiler.mir_opt.mir_opt.dce.{create_dce_pass}

fn _pf_block(id: i64, term: MirTerminator) -> MirBlock:
    MirBlock(BlockId(id: id), Some("b{id}"), [], term)

fn _pf_block_with(id: i64, instructions: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(BlockId(id: id), Some("b{id}"), instructions, term)

fn _pf_manifest() -> DriverManifestAttr:
    DriverManifestAttr(DriverManifestAttrKind.Driver, 0, 0, [], "", "")

fn _pf_function_with_blocks(blocks: [MirBlock]) -> MirFunction:
    _pf_function_with_locals_blocks([], blocks)

fn _pf_function_with_locals_blocks(locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        SymbolId(id: 91), "perf_facts_fixture",
        MirSignature([], MirType.unit(), false), locals,
        blocks,
        BlockId(id: 0), Span(0, 0, 1, 1), [], false, nil, {}, nil,
        false, false, "", false, _pf_manifest(), false,
        vhdl_hardware_metadata_default(), false
    )

fn _pf_function() -> MirFunction:
    _pf_function_with_blocks([
        _pf_block(0, MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 1), BlockId(id: 2))),
        _pf_block(1, MirTerminator.Goto(BlockId(id: 2))),
        _pf_block(2, MirTerminator.Ret(nil))
    ])

describe "shared MIR PerfFacts":
    it "indexes successors, predecessors, and storage order in one build":
        step("Analyze one function with shared performance facts")
        val facts = perf_facts_build(_pf_function())
        expect(facts.block_count).to_equal(3)
        expect(facts.block_index[0]).to_equal(0)
        expect(perf_facts_successors(facts, BlockId(id: 0)).len()).to_equal(2)
        expect(perf_facts_predecessors(facts, BlockId(id: 2)).len()).to_equal(2)
        expect(perf_facts_dominates(facts, BlockId(id: 0), BlockId(id: 2))).to_equal(true)
        expect(perf_facts_dominates(facts, BlockId(id: 1), BlockId(id: 2))).to_equal(false)

    it "returns empty adjacency for an unknown block without inventing facts":
        step("Reject unavailable CFG facts")
        val facts = perf_facts_build(_pf_function())
        expect(perf_facts_successors(facts, BlockId(id: 99)).len()).to_equal(0)
        expect(perf_facts_predecessors(facts, BlockId(id: 99)).len()).to_equal(0)

    it "derives dominance from CFG rather than block storage order":
        step("Analyze blocks stored out of control-flow order")
        val func = _pf_function_with_locals_blocks([
            MirLocal(local0, Some("left"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(local1, Some("sum"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block(2, MirTerminator.Ret(nil)),
            _pf_block(0, MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 1), BlockId(id: 2))),
            _pf_block(1, MirTerminator.Goto(BlockId(id: 2)))
        ])
        val facts = perf_facts_build(func)
        expect(facts.reverse_postorder[0].id).to_equal(0)
        expect(perf_facts_dominates(facts, BlockId(id: 0), BlockId(id: 2))).to_equal(true)
        expect(perf_facts_dominates(facts, BlockId(id: 1), BlockId(id: 2))).to_equal(false)

    it "records complete loop exit edges and leaves unproved trip counts unknown":
        step("Reject incomplete induction facts")
        val func = _pf_function_with_blocks([
            _pf_block(0, MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 1), BlockId(id: 2))),
            _pf_block(1, MirTerminator.Goto(BlockId(id: 0))),
            _pf_block(2, MirTerminator.Ret(nil))
        ])
        var detector = LoopDetector.new()
        detector.detect_loops(func)
        expect(detector.loops.len()).to_equal(1)
        expect(detector.loops[0].exit_edges.len()).to_equal(1)
        expect(detector.loops[0].exit_edges[0].from.id).to_equal(0)
        expect(detector.loops[0].exit_edges[0].to.id).to_equal(2)
        expect(detector.loops[0].trip_count).to_be_nil()

    it "keeps unknown trip counts free of a dormant comparison recognizer":
        step("Prevent mechanical activation of unproved trip-count inference")
        val source = read_file("src/compiler/60.mir_opt/mir_opt/loop_detect.spl")
        expect(source).not.to_contain("Unreachable reference recognizer")
        expect(source).not.to_contain("extract_comparison_bound")
        expect(source).not.to_contain("operand_const_int")

    it "keeps an inner natural loop from absorbing its outer cycle":
        step("Build dominance-scoped nested natural loops")
        val func = _pf_function_with_blocks([
            _pf_block(0, MirTerminator.Goto(BlockId(id: 1))),
            _pf_block(1, MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 2), BlockId(id: 5))),
            _pf_block(2, MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 3), BlockId(id: 4))),
            _pf_block(3, MirTerminator.Goto(BlockId(id: 2))),
            _pf_block(4, MirTerminator.Goto(BlockId(id: 1))),
            _pf_block(5, MirTerminator.Ret(nil))
        ])
        var detector = LoopDetector.new()
        detector.detect_loops(func)
        expect(detector.loops.len()).to_equal(2)

        var inner_body: [i64] = []
        var inner_exits: [i64] = []
        var outer_body: [i64] = []
        var outer_exits: [i64] = []
        for loop_info in detector.loops:
            if loop_info.header.id == 2:
                for block in loop_info.body: inner_body.push(block.id)
                for edge in loop_info.exit_edges: inner_exits.push(edge.to.id)
            elif loop_info.header.id == 1:
                for block in loop_info.body: outer_body.push(block.id)
                for edge in loop_info.exit_edges: outer_exits.push(edge.to.id)

        expect(inner_body).to_equal([3])
        expect(inner_exits).to_equal([4])
        expect(outer_body).to_equal([2, 3, 4])
        expect(outer_exits).to_equal([5])

    it "unions multiple dominance-proven latches once":
        step("Build one natural loop from multiple backedges")
        val func = _pf_function_with_blocks([
            _pf_block(0, MirTerminator.Goto(BlockId(id: 1))),
            _pf_block(1, MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 2), BlockId(id: 3))),
            _pf_block(2, MirTerminator.Goto(BlockId(id: 1))),
            _pf_block(3, MirTerminator.Goto(BlockId(id: 1)))
        ])
        var detector = LoopDetector.new()
        detector.detect_loops(func)
        expect(detector.loops.len()).to_equal(1)
        expect(detector.loops[0].header.id).to_equal(1)
        expect(detector.loops[0].backedges.len()).to_equal(2)
        var body: [i64] = []
        for block in detector.loops[0].body: body.push(block.id)
        expect(body).to_equal([2, 3])

    it "builds linear definition and use sites including terminators":
        step("Reuse one function-local def-use index")
        val local0 = LocalId(id: 0)
        val local1 = LocalId(id: 1)
        val func = _pf_function_with_locals_blocks([
            MirLocal(local0, Some("left"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(local1, Some("sum"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block_with(0, [
                MirInst(MirInstKind.Const(local0, MirConstValue.Int(4), MirType.i64()), nil),
                MirInst(MirInstKind.BinOp(local1, MirBinOp.Add,
                    mir_operand_copy(local0), mir_operand_copy(local0)), nil)
            ], MirTerminator.Ret(Some(mir_operand_copy(local1))))
        ])
        val facts = perf_facts_build(func)
        expect(facts.def_use_complete).to_equal(true)
        expect(perf_facts_definitions(facts, local0).len()).to_equal(1)
        expect(perf_facts_definitions(facts, local1).len()).to_equal(1)
        expect(perf_facts_uses(facts, local0).len()).to_equal(2)
        expect(perf_facts_uses(facts, local1).len()).to_equal(1)
        expect(perf_facts_uses(facts, local1)[0].is_terminator).to_equal(true)

    it "propagates block liveness through a branch without rescanning MIR":
        step("Reuse shared block liveness")
        val local0 = LocalId(id: 0)
        val local1 = LocalId(id: 1)
        val func = _pf_function_with_locals_blocks([
            MirLocal(local0, Some("value"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(local1, Some("copy"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block_with(0, [
                MirInst(MirInstKind.Const(local0, MirConstValue.Int(4), MirType.i64()), nil)
            ], MirTerminator.If(mir_operand_const_bool(true), BlockId(id: 1), BlockId(id: 2))),
            _pf_block_with(1, [
                MirInst(MirInstKind.Copy(local1, local0), nil)
            ], MirTerminator.Goto(BlockId(id: 3))),
            _pf_block(2, MirTerminator.Goto(BlockId(id: 3))),
            _pf_block(3, MirTerminator.Ret(nil))
        ])
        val facts = perf_facts_build(func)
        expect(facts.liveness_complete).to_equal(true)
        expect(facts.liveness_budget_exhausted).to_equal(false)
        expect(perf_facts_is_live_out(facts, BlockId(id: 0), local0)).to_equal(true)
        expect(perf_facts_is_live_in(facts, BlockId(id: 1), local0)).to_equal(true)
        expect(perf_facts_is_live_in(facts, BlockId(id: 2), local0)).to_equal(false)
        expect(perf_facts_is_live_in(facts, BlockId(id: 0), local0)).to_equal(false)

    it "marks use before definition live at block entry":
        step("Preserve use-before-definition semantics")
        val local0 = LocalId(id: 0)
        val local1 = LocalId(id: 1)
        val func = _pf_function_with_locals_blocks([
            MirLocal(local0, Some("input"), MirType.i64(), LocalKind.Var, false),
            MirLocal(local1, Some("copy"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block_with(0, [
                MirInst(MirInstKind.Copy(local1, local0), nil),
                MirInst(MirInstKind.Const(local0, MirConstValue.Int(9), MirType.i64()), nil)
            ], MirTerminator.Ret(nil))
        ])
        val facts = perf_facts_build(func)
        expect(facts.liveness_complete).to_equal(true)
        expect(perf_facts_is_live_in(facts, BlockId(id: 0), local0)).to_equal(true)

    it "covers ownership SIMD and nested-place local accesses":
        step("Model representative MIR access families")
        val base = LocalId(id: 0)
        val index = LocalId(id: 1)
        val right = LocalId(id: 2)
        val vector = LocalId(id: 3)
        val reference = LocalId(id: 4)
        val freeze_access = perf_instruction_access(
            MirInst(MirInstKind.FreezeRegion(base), nil))
        expect(freeze_access.covered).to_equal(true)
        expect(freeze_access.uses).to_equal([base])
        val simd_access = perf_instruction_access(MirInst(
            MirInstKind.SimdAddF32x4(vector, mir_operand_copy(base), mir_operand_copy(right)), nil))
        expect(simd_access.defs).to_equal([vector])
        expect(simd_access.uses).to_equal([base, right])
        val ref_access = perf_instruction_access(MirInst(MirInstKind.Ref(
            reference, MirBorrowKind.Shared,
            MirPlace(base, [MirProjection.Deref, MirProjection.Index(index)])), nil))
        expect(ref_access.covered).to_equal(true)
        expect(ref_access.defs).to_equal([reference])
        expect(ref_access.uses).to_equal([base, index])

    it "fails def-use completeness closed for semantically unadmitted metadata":
        step("Reject incomplete def-use coverage")
        val func = _pf_function_with_locals_blocks([
            MirLocal(LocalId(id: 0), Some("scrutinee"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(LocalId(id: 1), Some("destination"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(LocalId(id: 2), Some("ok_payload"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(LocalId(id: 3), Some("err_payload"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block_with(0, [
                MirInst(MirInstKind.ResultMatchSemantic(
                    LocalId(id: 0), LocalId(id: 1), BlockId(id: 1), BlockId(id: 2),
                    BlockId(id: 3), LocalId(id: 2), LocalId(id: 3)), nil)
            ], MirTerminator.Ret(nil))
        ])
        val facts = perf_facts_build(func)
        expect(facts.def_use_complete).to_equal(false)
        expect(facts.uncovered_instruction_count).to_equal(1)
        expect(facts.liveness_complete).to_equal(false)
        expect(perf_facts_is_live_in(facts, BlockId(id: 0), LocalId(id: 0))).to_equal(false)
        expect(perf_instruction_access(MirInst(MirInstKind.GpuLaunch([]), nil)).covered).to_be(false)
        expect(perf_instruction_access(MirInst(MirInstKind.VhdlProcess(
            VhdlProcessKind.Combinational([]), BlockId(id: 1)), nil)).covered).to_be(false)

    it "fails liveness closed for a dangling CFG edge":
        step("Reject incomplete CFG liveness")
        val facts = perf_facts_build(_pf_function_with_blocks([
            _pf_block(0, MirTerminator.Goto(BlockId(id: 99)))
        ]))
        expect(facts.cfg_complete).to_equal(false)
        expect(facts.invalid_block_reference_count).to_equal(1)
        expect(facts.liveness_complete).to_equal(false)

    it "keeps DCE Skeleton unchanged even when shared liveness is complete":
        step("Keep analysis facts separate from transformation authority")
        val dead = LocalId(id: 0)
        val returned = LocalId(id: 1)
        val func = _pf_function_with_locals_blocks([
            MirLocal(dead, Some("dead"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(returned, Some("returned"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block_with(0, [
                MirInst(MirInstKind.Const(dead, MirConstValue.Int(1), MirType.i64()), nil),
                MirInst(MirInstKind.Const(returned, MirConstValue.Int(2), MirType.i64()), nil)
            ], MirTerminator.Ret(Some(mir_operand_copy(returned))))
        ])
        var dce = create_dce_pass()
        val optimized = dce.run_on_function(func)
        expect(optimized.blocks[0].instructions.len()).to_equal(2)
        expect(dce.removed_instructions).to_equal(0)
        expect(dce.iterations).to_equal(0)

    it "keeps DCE Skeleton unchanged when shared liveness is incomplete":
        step("Fail DCE closed on uncovered MIR")
        val local0 = LocalId(id: 0)
        val local1 = LocalId(id: 1)
        val local2 = LocalId(id: 2)
        val local3 = LocalId(id: 3)
        val func = _pf_function_with_locals_blocks([
            MirLocal(local0, Some("scrutinee"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(local1, Some("destination"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(local2, Some("ok_payload"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(local3, Some("err_payload"), MirType.i64(), LocalKind.Temp, false)
        ], [
            _pf_block_with(0, [
                MirInst(MirInstKind.ResultMatchSemantic(
                    local0, local1, BlockId(id: 1), BlockId(id: 2),
                    BlockId(id: 3), local2, local3), nil)
            ], MirTerminator.Ret(nil))
        ])
        var dce = create_dce_pass()
        val optimized = dce.run_on_function(func)
        expect(optimized.blocks[0].instructions.len()).to_equal(1)
        expect(dce.removed_instructions).to_equal(0)
        expect(dce.iterations).to_equal(0)

    it "makes fact invalidation explicit and internally consistent":
        step("Invalidate stale performance facts")
        val cfg_only = perf_fact_preservation_cfg_only()
        expect(perf_fact_preservation_integrity_errors(cfg_only).len()).to_equal(0)
        expect(perf_facts_invalidated(cfg_only)).to_equal([
            PerfFactKind.DefUse, PerfFactKind.Liveness])
        expect(perf_facts_invalidated(perf_fact_preservation_all()).len()).to_equal(0)
        val invalid = PerfFactPreservation(false, true, false, true)
        expect(perf_fact_preservation_integrity_errors(invalid).len()).to_equal(2)

    it "omits dense liveness matrices from verifier facts":
        step("Bound verifier memory independently of blocks times locals")
        val local0 = LocalId(id: 0)
        val facts = perf_facts_build_for_verification(
            _pf_function_with_locals_blocks([
                MirLocal(local0, Some("value"), MirType.i64(), LocalKind.Temp, false)
            ], [
                _pf_block_with(0, [
                    MirInst(MirInstKind.Const(local0, MirConstValue.Int(1), MirType.i64()), nil)
                ], MirTerminator.Ret(Some(mir_operand_copy(local0))))
            ]))
        expect(facts.cfg_complete).to_equal(true)
        expect(facts.def_use_complete).to_equal(true)
        expect(facts.live_in_bits.len()).to_equal(0)
        expect(facts.live_out_bits.len()).to_equal(0)
        expect(facts.block_definition_bits.len()).to_equal(0)
        expect(facts.block_use_before_definition_bits.len()).to_equal(0)
        expect(facts.liveness_complete).to_equal(false)
