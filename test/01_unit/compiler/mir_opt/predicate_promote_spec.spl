"""
## Purpose and audience
Purpose: Prove that predicate_promote is quarantined until sole-use legality exists.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-MIR-OPT-001 — stable requirement identity for this spec.

# test/unit/compiler/mir_opt/predicate_promote_spec.spl
#
# Feature ID: #COMPILER-MIROPT-PP-I2
# Category:   Compiler | MIR Optimization | Predicate Promotion
# Status:     Disabled — function-wide sole-use/dominance proof is incomplete
#
# Test plan:
#   Quarantine cases: every public adapter preserves exact instruction sequences
#   No-op case   (1):   empty module passes through unchanged
#
# Interpreter-mode note (per .claude/rules/testing.md):
#   The test runner in interpreter mode only verifies file loading and describe/it
#   block reachability.  The assertions inside it-blocks are not executed.
#   All assertions use built-in matchers only: to_equal, to_be_nil, to_be.

use compiler.mir.mir_data.{MirInst, MirInstKind, MirOperand, MirOperandKind,
    MirBinOp, MirTerminator, LocalId, BlockId}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}
use compiler.mir_opt.mir_opt.predicate_promote.{
    run_predicate_promote,
    promote_function_predicate, promote_block_predicate,
    operand_is_local, try_fuse_binary, try_fuse_ternary
}
use compiler.mir_opt.mir_opt.mod.{PassKind, run_typed_pass_on_function}

# ============================================================================
# Helpers — minimal MIR construction for tests
# ============================================================================

fn make_local(id: i64) -> LocalId:
    LocalId(id: id)

fn make_block_id(id: i64) -> BlockId:
    BlockId.new(id)

fn make_copy_op(local_id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(make_local(local_id)))

fn make_jump_terminator() -> MirTerminator:
    MirTerminator.Goto(make_block_id(0))

fn make_mask_from_cmp_inst(dest_id: i64, a_id: i64, b_id: i64) -> MirInst:
    MirInst(kind: MirInstKind.MaskFromCmp(
        make_local(dest_id), "CmpLt",
        make_copy_op(a_id), make_copy_op(b_id)
    ))

fn make_masked_add_inst(dest_id: i64, mask_id: i64, a_id: i64, b_id: i64) -> MirInst:
    MirInst(kind: MirInstKind.MaskedAdd(
        make_local(dest_id),
        make_copy_op(mask_id),
        make_copy_op(a_id),
        make_copy_op(b_id)
    ))

fn make_masked_mul_inst(dest_id: i64, mask_id: i64, a_id: i64, b_id: i64) -> MirInst:
    MirInst(kind: MirInstKind.MaskedMul(
        make_local(dest_id),
        make_copy_op(mask_id),
        make_copy_op(a_id),
        make_copy_op(b_id)
    ))

fn make_masked_fma_inst(dest_id: i64, mask_id: i64, a_id: i64, b_id: i64, c_id: i64) -> MirInst:
    MirInst(kind: MirInstKind.MaskedFma(
        make_local(dest_id),
        make_copy_op(mask_id),
        make_copy_op(a_id),
        make_copy_op(b_id),
        make_copy_op(c_id)
    ))

fn make_binop_inst(dest_id: i64) -> MirInst:
    MirInst(kind: MirInstKind.BinOp(
        make_local(dest_id), MirBinOp.Add,
        make_copy_op(0), make_copy_op(0)
    ))

fn make_test_block(id: i64, insts: [MirInst]) -> MirBlock:
    MirBlock(
        id: make_block_id(id),
        label: nil,
        instructions: insts,
        terminator: make_jump_terminator()
    )

fn inst_is_mask_from_cmp(inst: MirInst) -> bool:
    match inst.kind:
        case MaskFromCmp(_, _, _, _): true
        case _: false

fn inst_is_masked_add(inst: MirInst) -> bool:
    match inst.kind:
        case MaskedAdd(_, _, _, _): true
        case _: false

# ============================================================================
# Former positive candidates — quarantine must preserve exact MIR
# ============================================================================

use std.spec.step

describe "predicate_promote — adjacent MaskFromCmp+MaskedAdd is quarantined":
    it "two-instruction block remains unchanged":
        step("Verify: adjacent pair remains unchanged without a sole-use receipt")
        # @req: REQ-COMPILER-MIR-OPT-001
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_add_inst(20, 10, 3, 4)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(2)
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)
        expect(inst_is_masked_add(result.instructions[1])).to_equal(true)

describe "predicate_promote — MaskFromCmp+MaskedMul is quarantined":
    it "two-instruction block remains unchanged":
        step("Verify: MaskedMul pair remains unchanged")
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_mul_inst(20, 10, 3, 4)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(2)
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)

describe "predicate_promote — MaskFromCmp+MaskedFma is quarantined":
    it "two-instruction block remains unchanged":
        step("Verify: MaskedFma pair remains unchanged")
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_fma_inst(20, 10, 3, 4, 5)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(2)
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)

describe "predicate_promote — multiple adjacent pairs remain exact":
    it "block with two pairs preserves all four instructions":
        step("Verify: quarantine does not partially transform a block")
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_add_inst(20, 10, 3, 4),
            make_mask_from_cmp_inst(11, 5, 6),
            make_masked_add_inst(21, 11, 7, 8)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(4)
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)
        expect(inst_is_masked_add(result.instructions[1])).to_equal(true)
        expect(inst_is_mask_from_cmp(result.instructions[2])).to_equal(true)
        expect(inst_is_masked_add(result.instructions[3])).to_equal(true)

describe "predicate_promote — later mask use cannot be orphaned":
    it "adjacent candidate followed by another mask consumer remains exact":
        step("Verify: later same-block mask use prevents undefined-local MIR")
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_add_inst(20, 10, 3, 4),
            make_masked_mul_inst(21, 10, 5, 6)
        ]
        val result = promote_block_predicate(make_test_block(1, insts))
        expect(result.instructions.len()).to_equal(3)
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)

describe "predicate_promote — function and typed routes are identities":
    it "preserves a non-empty function through both public routes":
        step("Verify: direct and typed function adapters retain the mask definition")
        val block = make_test_block(1, [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_add_inst(20, 10, 3, 4)
        ])
        val func = MirFunction(name: "predicate_identity", blocks: [block], locals: [])
        val direct = promote_function_predicate(func)
        val typed = run_typed_pass_on_function(PassKind.PredicatePromote, func)
        expect(direct.blocks[0].instructions.len()).to_equal(2)
        expect(typed.blocks[0].instructions.len()).to_equal(2)
        expect(inst_is_mask_from_cmp(typed.blocks[0].instructions[0])).to_equal(true)
        expect(inst_is_masked_add(typed.blocks[0].instructions[1])).to_equal(true)

describe "predicate_promote — compatibility helpers cannot construct rewrites":
    it "retains operand matching but returns nil for both fuse helpers":
        step("Verify: exported compatibility helpers are fail-closed")
        val mask = make_copy_op(10)
        expect(operand_is_local(mask, make_local(10))).to_equal(true)
        expect(try_fuse_binary(Some(make_local(10)), "CmpLt", Some(make_copy_op(1)), Some(make_copy_op(2)), mask, make_local(20), make_copy_op(3), make_copy_op(4), "add")).to_be_nil()
        expect(try_fuse_ternary(Some(make_local(10)), "CmpLt", Some(make_copy_op(1)), Some(make_copy_op(2)), mask, make_local(20), make_copy_op(3), make_copy_op(4), make_copy_op(5))).to_be_nil()

# ============================================================================
# Negative cases — no fusion when conditions are not met
# ============================================================================

describe "predicate_promote — wrong mask local: both instructions preserved":
    it "MaskedAdd referencing a different local yields 2 instructions":
        step("Verify: MaskedAdd referencing a different local yields 2 instructions")
        # MaskFromCmp produces %10, MaskedAdd consumes %11 (mismatch)
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_masked_add_inst(20, 11, 3, 4)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)
        expect(inst_is_masked_add(result.instructions[1])).to_equal(true)

describe "predicate_promote — non-adjacent: intervening instruction blocks fusion":
    it "MaskFromCmp, BinOp, MaskedAdd yields 3 instructions unchanged":
        step("Verify: MaskFromCmp, BinOp, MaskedAdd yields 3 instructions unchanged")
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2),
            make_binop_inst(99),
            make_masked_add_inst(20, 10, 3, 4)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)

describe "predicate_promote — standalone MaskedAdd without prior MaskFromCmp":
    it "single MaskedAdd in block is passed through unchanged":
        step("Verify: single MaskedAdd in block is passed through unchanged")
        val insts = [
            make_masked_add_inst(20, 10, 3, 4)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(inst_is_masked_add(result.instructions[0])).to_equal(true)

# ============================================================================
# No-op / structural invariant
# ============================================================================

describe "predicate_promote — empty module passes through unchanged":
    it "run_predicate_promote on empty module returns 0 functions":
        step("Verify: run_predicate_promote on empty module returns 0 functions")
        val result = run_predicate_promote(MirModule(name: "empty", functions: {}, statics: {}, constants: {}, types: {}))
        expect(result.functions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "predicate_promote — trailing MaskFromCmp with no following Masked* is preserved":
    it "lone MaskFromCmp at end of block is kept":
        step("Verify: lone MaskFromCmp at end of block is kept")
        val insts = [
            make_mask_from_cmp_inst(10, 1, 2)
        ]
        val blk = make_test_block(1, insts)
        val result = promote_block_predicate(blk)
        expect(result.instructions.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(inst_is_mask_from_cmp(result.instructions[0])).to_equal(true)
