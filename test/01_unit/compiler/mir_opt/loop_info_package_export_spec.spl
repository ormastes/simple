use compiler.mir_opt.mir_opt.{LoopInfo, VectorLoopInfo}

describe "MIR optimizer LoopInfo package exports":
    extern fn rt_file_read_text(path: text) -> text

    it "resolves both package types without an ambiguous provider":
        val detected_loop: LoopInfo? = nil
        val vector_loop: VectorLoopInfo? = nil
        expect(detected_loop == nil).to_equal(true)
        expect(vector_loop == nil).to_equal(true)

    it "keeps LoopInfo uniquely owned by loop detection":
        val vector_types = rt_file_read_text("src/compiler/60.mir_opt/mir_opt/auto_vectorize_types.spl") ?? ""
        val loop_types = rt_file_read_text("src/compiler/60.mir_opt/mir_opt/loop_detect.spl") ?? ""
        expect(vector_types.contains("struct VectorLoopInfo:")).to_equal(true)
        expect(vector_types.contains("struct LoopInfo:")).to_equal(false)
        expect(loop_types.contains("class LoopInfo:")).to_equal(true)
