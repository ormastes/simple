"""Fail-closed contracts for disabled bounds-check elimination."""
# @req: REQ-COMPILER-MIR-OPT-001

use std.spec.*
use std.fs.{read_file}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirBlock}
use compiler.mir_opt.mir_opt.bounds_check_elim.{create_bounds_check_elim_pass}

describe "BoundsCheckElimination skeleton":
    it "keeps direct block calls from bypassing disabled dispatch":
        val block = MirBlock(
            id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(
                nil, "bounds_check", [MirOperand.const_int(0), MirOperand.const_int(1)]),
                span: nil)], terminator: MirTerminator.Ret(nil))
        var pass = create_bounds_check_elim_pass()
        val result = pass.eliminate_in_block(block)
        expect(result.instructions.len()).to_equal(1)
        expect(pass.removed_checks).to_equal(0)

    it "contains no global proof seeding or key-based check removal":
        val source = read_file(
            "src/compiler/60.mir_opt/mir_opt/bounds_check_elim.spl")
        expect(source).not.to_contain("collect_loop_bounds_proofs")
        expect(source).not.to_contain("eliminate_in_block_with_seen")
        expect(source).not.to_contain("bounds_check_key")
        expect(source).not.to_contain("seen_checks")
