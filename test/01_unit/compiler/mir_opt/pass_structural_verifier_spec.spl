"""
## Purpose and audience
Purpose: Prove optimizer boundaries reject malformed MIR and distinguish no-change runs.
Audience: compiler and optimizer maintainers.
"""
# @req: REQ-003, REQ-004

use std.spec.*
use std.fs.{read_file}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock, MirInst}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.mir_opt.mir_opt.mod.{
    PassRunDisposition, mir_structural_verification_receipt,
    mir_module_structural_verification_receipt, run_named_pass_with_record,
    run_pass_on_module_checked
}

fn _pv_block(id: i64, terminator: MirTerminator) -> MirBlock:
    MirBlock(BlockId(id: id), Some("b{id}"), [], terminator)

fn _pv_block_with(id: i64, instructions: [MirInst], terminator: MirTerminator) -> MirBlock:
    MirBlock(BlockId(id: id), Some("b{id}"), instructions, terminator)

fn _pv_local(id: i64) -> LocalId:
    LocalId(id: id)

fn _pv_copy(id: i64) -> MirOperand:
    mir_operand_copy(_pv_local(id))

fn _pv_const(value: i64) -> MirOperand:
    MirOperand(MirOperandKind.Const(MirConstValue.Int(value), MirType.i64()))

fn _pv_manifest() -> DriverManifestAttr:
    DriverManifestAttr(DriverManifestAttrKind.Driver, 0, 0, [], "", "")

fn _pv_function(blocks: [MirBlock], entry: i64) -> MirFunction:
    _pv_function_with_local_ids(blocks, entry, [])

fn _pv_function_with_local_ids(blocks: [MirBlock], entry: i64, ids: [i64]) -> MirFunction:
    var locals: [MirLocal] = []
    for id in ids:
        locals.push(MirLocal(_pv_local(id), Some("v{id}"), MirType.i64(), LocalKind.Temp, false))
    _pv_function_with_locals(blocks, entry, locals)

fn _pv_function_with_locals(
    blocks: [MirBlock], entry: i64, locals: [MirLocal]
) -> MirFunction:
    MirFunction(
        SymbolId(id: 193), "pass_verifier_fixture",
        MirSignature([], MirType.unit(), false), locals, blocks,
        BlockId(id: entry), Span(0, 0, 1, 1), [], false, nil, {}, nil,
        false, false, "", false, _pv_manifest(), false,
        vhdl_hardware_metadata_default(), false
    )

fn _pv_function_with_abi(
    signature: MirSignature, locals: [MirLocal]
) -> MirFunction:
    MirFunction(
        SymbolId(id: 194), "pass_verifier_abi_fixture",
        signature, locals, [_pv_block(0, MirTerminator.Ret(nil))],
        BlockId(id: 0), Span(0, 0, 1, 1), [], false, nil, {}, nil,
        false, false, "", false, _pv_manifest(), false,
        vhdl_hardware_metadata_default(), false
    )

describe "MIR optimizer structural verifier":
    it "accepts a structurally closed function":
        step("Verify MIR before optimizer dispatch")
        val receipt = mir_structural_verification_receipt(_pv_function([
            _pv_block(0, MirTerminator.Goto(BlockId(id: 1))),
            _pv_block(1, MirTerminator.Ret(nil))
        ], 0))
        expect(receipt.valid).to_equal(true)
        expect(receipt.block_count).to_equal(2)
        expect(receipt.errors.len()).to_equal(0)

    it "rejects duplicate identities and dangling CFG targets":
        step("Reject malformed optimizer output")
        val receipt = mir_structural_verification_receipt(_pv_function([
            _pv_block(0, MirTerminator.Goto(BlockId(id: 99))),
            _pv_block(0, MirTerminator.Ret(nil))
        ], 0))
        expect(receipt.valid).to_equal(false)
        expect(receipt.errors.join("|")).to_contain("duplicate block identity")
        expect(receipt.errors.join("|")).to_contain("targets missing block 99")
        expect(receipt.error_codes.len()).to_equal(receipt.errors.len())
        expect(receipt.error_codes.contains("MIRV010")).to_equal(true)
        expect(receipt.error_codes.contains("MIRV019")).to_equal(true)

    it "rejects undeclared instruction and terminator locals":
        step("Reject malformed optimizer operands")
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block_with(0, [
                    MirInst(MirInstKind.Copy(_pv_local(0), _pv_local(91)), nil)
                ], MirTerminator.Ret(Some(_pv_copy(92))))
            ], 0, [0]))
        expect(receipt.valid).to_equal(false)
        expect(receipt.errors.join("|")).to_contain("uses missing local 91")
        expect(receipt.errors.join("|")).to_contain("terminator uses missing local 92")
        expect(receipt.error_codes.contains("MIRV014")).to_equal(true)
        expect(receipt.error_codes.contains("MIRV017")).to_equal(true)

    it "uses indexed identity membership for large receipts":
        step("Keep structural verification linear")
        var ids: [i64] = []
        var id = 0
        while id < 512:
            ids.push(id)
            id = id + 1
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block(0, MirTerminator.Ret(nil))
            ], 0, ids))
        expect(receipt.valid).to_equal(true)
        val source = read_file("src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(source).to_contain("var local_ids: Dict<i64, bool> = {}")
        expect(source).to_contain("perf_instruction_access(instruction)")
        expect(source).to_contain("perf_terminator_access(block.terminator)")
        expect(source).not.to_contain("local_ids.contains")
        expect(source).not.to_contain("block_ids.contains")

    it "rejects a same-block use before its definition":
        step("Verify instruction order without a definitions-by-uses scan")
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block_with(0, [
                    MirInst(MirInstKind.Copy(_pv_local(1), _pv_local(0)), nil),
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(7), MirType.i64()), nil)
                ], MirTerminator.Ret(nil))
            ], 0, [0, 1]))
        expect(receipt.valid).to_equal(false)
        expect(receipt.error_codes.contains("MIRV022")).to_equal(true)

    it "rejects undefined and multiply-defined SSA locals":
        step("Reject ambiguous or absent value origins")
        val undefined_receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block(0, MirTerminator.Ret(Some(_pv_copy(0))))
            ], 0, [0]))
        expect(undefined_receipt.error_codes.contains("MIRV020")).to_equal(true)

        val multiple_receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block_with(0, [
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(1), MirType.i64()), nil),
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(2), MirType.i64()), nil)
                ], MirTerminator.Ret(nil))
            ], 0, [0]))
        expect(multiple_receipt.error_codes.contains("MIRV021")).to_equal(true)

    it "rejects a definition that does not dominate a cross-block use":
        step("Use shared CFG dominance for SSA validation")
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block(0, MirTerminator.If(_pv_const(1), BlockId(id: 1), BlockId(id: 2))),
                _pv_block_with(1, [
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(7), MirType.i64()), nil)
                ], MirTerminator.Goto(BlockId(id: 3))),
                _pv_block(2, MirTerminator.Goto(BlockId(id: 3))),
                _pv_block(3, MirTerminator.Ret(Some(_pv_copy(0))))
            ], 0, [0]))
        expect(receipt.valid).to_equal(false)
        expect(receipt.error_codes.contains("MIRV023")).to_equal(true)

    it "rejects cross-block value flow when dominance is unavailable":
        step("Fail closed for unreachable cross-block SSA flow")
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block(0, MirTerminator.Ret(nil)),
                _pv_block_with(1, [
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(7), MirType.i64()), nil)
                ], MirTerminator.Goto(BlockId(id: 2))),
                _pv_block(2, MirTerminator.Ret(Some(_pv_copy(0))))
            ], 0, [0]))
        expect(receipt.valid).to_equal(false)
        expect(receipt.error_codes.contains("MIRV024")).to_equal(true)

    it "accepts a single definition that dominates its use":
        step("Admit a valid SSA value flow")
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block_with(0, [
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(7), MirType.i64()), nil)
                ], MirTerminator.Goto(BlockId(id: 1))),
                _pv_block(1, MirTerminator.Ret(Some(_pv_copy(0))))
            ], 0, [0]))
        expect(receipt.valid).to_equal(true)

    it "checks exact local opcode type contracts in the existing traversal":
        step("Reject explicit destination and copy type disagreement")
        val locals = [
            MirLocal(_pv_local(0), Some("left"), MirType.i64(), LocalKind.Temp, false),
            MirLocal(_pv_local(1), Some("right"), MirType.bool(), LocalKind.Temp, false),
            MirLocal(_pv_local(2), Some("cast"), MirType.i64(), LocalKind.Temp, false)
        ]
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_locals([
                _pv_block_with(0, [
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(1), MirType.bool()), nil),
                    MirInst(MirInstKind.Copy(_pv_local(1), _pv_local(0)), nil),
                    MirInst(MirInstKind.Cast(_pv_local(2), _pv_copy(1), MirType.bool()), nil)
                ], MirTerminator.Ret(nil))
            ], 0, locals))
        expect(receipt.valid).to_equal(false)
        expect(receipt.error_codes.contains("MIRV025")).to_equal(true)
        expect(receipt.error_codes.contains("MIRV026")).to_equal(true)
        expect(receipt.error_codes.contains("MIRV027")).to_equal(true)
        expect(receipt.type_checked_instruction_count).to_equal(3)
        expect(receipt.type_unchecked_instruction_count).to_equal(0)

    it "reports partial opcode type coverage honestly":
        step("Distinguish checked from unproved opcode typing")
        val receipt = mir_structural_verification_receipt(
            _pv_function_with_local_ids([
                _pv_block_with(0, [
                    MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(1), MirType.i64()), nil),
                    MirInst(MirInstKind.DebugValue(_pv_local(0), "value"), nil)
                ], MirTerminator.Ret(nil))
            ], 0, [0]))
        expect(receipt.valid).to_equal(true)
        expect(receipt.type_checked_instruction_count).to_equal(1)
        expect(receipt.type_unchecked_instruction_count).to_equal(1)

    it "validates high-fanout switch edges without a target buffer":
        step("Validate CFG edges in place")
        var cases: [SwitchCase] = []
        var blocks: [MirBlock] = []
        var target = 1
        while target <= 128:
            cases.push(SwitchCase(value: target, target: BlockId(id: target)))
            blocks.push(_pv_block(target, MirTerminator.Ret(nil)))
            target = target + 1
        blocks.push(_pv_block(129, MirTerminator.Ret(nil)))
        var all_blocks: [MirBlock] = [
            _pv_block(0, MirTerminator.Switch(_pv_const(0), cases, BlockId(id: 129)))
        ]
        for block in blocks: all_blocks.push(block)
        val receipt = mir_structural_verification_receipt(
            _pv_function(all_blocks, 0))
        expect(receipt.valid).to_equal(true)
        val source = read_file("src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(source).not.to_contain("var targets: [BlockId] = []")
        expect(source).to_contain("block_ids.has(switch_case.target.id)")

    it "rejects missing, duplicate, and mistyped ABI locals":
        step("Verify function ABI locals")
        val signature = MirSignature([MirType.i64()], MirType.i64(), false)
        val missing = mir_structural_verification_receipt(
            _pv_function_with_abi(signature, []))
        expect(missing.valid).to_equal(false)
        expect(missing.errors.join("|")).to_contain("missing argument local index: 0")

        val malformed = mir_structural_verification_receipt(
            _pv_function_with_abi(signature, [
                MirLocal(_pv_local(0), Some("arg0"), MirType.bool(), LocalKind.Arg(0), false),
                MirLocal(_pv_local(1), Some("arg0_copy"), MirType.i64(), LocalKind.Arg(0), false),
                MirLocal(_pv_local(2), Some("ret"), MirType.bool(), LocalKind.Return, false),
                MirLocal(_pv_local(3), Some("ret2"), MirType.i64(), LocalKind.Return, false)
            ]))
        expect(malformed.valid).to_equal(false)
        val errors = malformed.errors.join("|")
        expect(errors).to_contain("argument local 0 type does not match signature")
        expect(errors).to_contain("duplicate argument local index: 0")
        expect(errors).to_contain("return local type does not match function signature")
        expect(errors).to_contain("multiple return locals")
        expect(malformed.error_codes.contains("MIRV004")).to_equal(true)
        expect(malformed.error_codes.contains("MIRV005")).to_equal(true)
        expect(malformed.error_codes.contains("MIRV007")).to_equal(true)
        expect(malformed.error_codes.contains("MIRV008")).to_equal(true)
        expect(malformed.error_codes.contains("MIRV999")).to_equal(false)

    it "aggregates deterministic module receipts and key mismatches":
        step("Verify a module before module-pass dispatch")
        var functions: Dict<SymbolId, MirFunction> = {}
        functions[SymbolId(id: 7)] = _pv_function([], 0)
        functions[SymbolId(id: 193)] = _pv_function([
            _pv_block(0, MirTerminator.Ret(nil))
        ], 0)
        val receipt = mir_module_structural_verification_receipt(MirModule(
            "verifier_module", functions, {}, {}, {}))
        expect(receipt.valid).to_equal(false)
        expect(receipt.function_count).to_equal(2)
        expect(receipt.block_count).to_equal(1)
        expect(receipt.errors.len()).to_equal(receipt.error_codes.len())
        expect(receipt.error_codes.contains("MIRVM001")).to_equal(true)
        expect(receipt.error_codes.contains("MIRV011")).to_equal(true)
        expect(receipt.errors[0]).to_contain("function map key 7")

    it "rejects a malformed module before checked pass dispatch":
        step("Fail closed at the checked module boundary")
        var functions: Dict<SymbolId, MirFunction> = {}
        functions[SymbolId(id: 193)] = _pv_function([], 0)
        val result = run_pass_on_module_checked("write_coalesce", MirModule(
            "invalid_checked_module", functions, {}, {}, {}))
        expect(result.is_err()).to_equal(true)
        expect(result.err().unwrap()).to_contain("MIRV011")

    it "runs a valid module through the recorded function boundary":
        step("Preserve a valid unchanged module through checked dispatch")
        var functions: Dict<SymbolId, MirFunction> = {}
        functions[SymbolId(id: 193)] = _pv_function([
            _pv_block(0, MirTerminator.Ret(nil))
        ], 0)
        val result = run_pass_on_module_checked("write_coalesce", MirModule(
            "valid_checked_module", functions, {}, {}, {}))
        expect(result.is_ok()).to_equal(true)
        val receipt = mir_module_structural_verification_receipt(result.ok().unwrap())
        expect(receipt.valid).to_equal(true)
        expect(receipt.function_count).to_equal(1)

    it "records an honest unchanged active function pass":
        step("Record a verified optimizer outcome")
        val result = run_named_pass_with_record("write_coalesce", _pv_function([
            _pv_block(0, MirTerminator.Ret(nil))
        ], 0))
        expect(result.is_ok()).to_equal(true)
        match result:
            case Ok(outcome):
                expect(outcome.verifier.valid).to_equal(true)
                expect(outcome.record.functions_seen).to_equal(1)
                expect(outcome.record.disposition).to_equal(PassRunDisposition.Unchanged)
                expect(outcome.record.candidates).to_equal(0)
                expect(outcome.record.transformed).to_equal(0)
                expect(outcome.record.rejected).to_equal(0)
                expect(outcome.record.instructions_before).to_equal(outcome.record.instructions_after)
                expect(outcome.record.reasons.len()).to_equal(1)
                expect(outcome.record.reasons[0].code).to_equal("no_change")
                expect(outcome.record.reasons[0].count).to_equal(1)
            case Err(message):
                fail("unexpected verifier rejection: " + message)

    it "rejects malformed MIR before executing a pass":
        step("Fail closed before optimizer dispatch")
        val result = run_named_pass_with_record("write_coalesce", _pv_function([], 0))
        expect(result.is_err()).to_equal(true)

    it "records every write-coalesce candidate instead of a changed Boolean":
        step("Record exact active-pass candidate counts")
        val instructions = [
            MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(0), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(1), MirConstValue.Int(1), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(2), MirConstValue.Int(2), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(5), MirConstValue.Int(5), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(6), MirConstValue.Int(6), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(9), MirConstValue.Int(9), MirType.i64()), nil),
            MirInst(MirInstKind.GetElementPtr(_pv_local(10), _pv_copy(0), [_pv_copy(1)]), nil),
            MirInst(MirInstKind.Store(_pv_copy(10), _pv_copy(5)), nil),
            MirInst(MirInstKind.GetElementPtr(_pv_local(11), _pv_copy(0), [_pv_copy(2)]), nil),
            MirInst(MirInstKind.Store(_pv_copy(11), _pv_copy(6)), nil),
            MirInst(MirInstKind.GetElementPtr(_pv_local(20), _pv_copy(9), [_pv_copy(1)]), nil),
            MirInst(MirInstKind.Store(_pv_copy(20), _pv_copy(5)), nil),
            MirInst(MirInstKind.GetElementPtr(_pv_local(21), _pv_copy(9), [_pv_copy(2)]), nil),
            MirInst(MirInstKind.Store(_pv_copy(21), _pv_copy(6)), nil)
        ]
        val result = run_named_pass_with_record("write_coalesce", _pv_function_with_local_ids([
            _pv_block_with(0, instructions, MirTerminator.Ret(nil))
        ], 0, [0, 1, 2, 5, 6, 9, 10, 11, 20, 21]))
        expect(result.is_ok()).to_equal(true)
        val outcome = result.ok().unwrap()
        expect(outcome.record.disposition).to_equal(PassRunDisposition.Transformed)
        expect(outcome.record.candidates).to_equal(2)
        expect(outcome.record.transformed).to_equal(2)
        expect(outcome.record.rejected).to_equal(0)
        expect(outcome.record.instructions_after - outcome.record.instructions_before).to_equal(2)
        expect(outcome.record.reasons.len()).to_equal(1)
        expect(outcome.record.reasons[0].code).to_equal("fs.two_stores_same_base")
        expect(outcome.record.reasons[0].count).to_equal(2)

    it "records every syscall-batch candidate instead of a changed Boolean":
        step("Record exact syscall batching outcomes")
        val instructions = [
            MirInst(MirInstKind.Const(_pv_local(0), MirConstValue.Int(0), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(1), MirConstValue.Int(1), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(2), MirConstValue.Int(2), MirType.i64()), nil),
            MirInst(MirInstKind.Const(_pv_local(9), MirConstValue.Int(9), MirType.i64()), nil),
            MirInst(MirInstKind.Call(nil, _pv_copy(0), [_pv_copy(1)]), nil),
            MirInst(MirInstKind.Call(nil, _pv_copy(0), [_pv_copy(2)]), nil),
            MirInst(MirInstKind.Nop, nil),
            MirInst(MirInstKind.Call(nil, _pv_copy(9), [_pv_copy(1)]), nil),
            MirInst(MirInstKind.Call(nil, _pv_copy(9), [_pv_copy(2)]), nil)
        ]
        val result = run_named_pass_with_record("syscall_batch", _pv_function_with_local_ids([
            _pv_block_with(0, instructions, MirTerminator.Ret(nil))
        ], 0, [0, 1, 2, 9]))
        expect(result.is_ok()).to_equal(true)
        val outcome = result.ok().unwrap()
        expect(outcome.record.disposition).to_equal(PassRunDisposition.Transformed)
        expect(outcome.record.candidates).to_equal(2)
        expect(outcome.record.transformed).to_equal(2)
        expect(outcome.record.rejected).to_equal(0)
        expect(outcome.record.instructions_after - outcome.record.instructions_before).to_equal(2)
        expect(outcome.record.reasons.len()).to_equal(1)
        expect(outcome.record.reasons[0].code).to_equal("fs.two_calls_same_callee")
        expect(outcome.record.reasons[0].count).to_equal(2)
