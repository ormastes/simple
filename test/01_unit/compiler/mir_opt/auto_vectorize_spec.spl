        val is_if = match bb.terminator:
            case If(cond, then_, else_): true
            case _: false
        expect(is_if).to_equal(true)

# ============================================================================
# Width ladder: a wider planning level must never vectorize FEWER loops
# ============================================================================

fn make_recipe_with_width(trip: i64, width: i64) -> VectorRecipe:
    VectorRecipe(
        kind:             VectorRecipeKind.Elementwise,
        header_block:     make_block_id(1),
        induction_var:    make_local(4),
        trip_count:       trip,
        element_type:     "f32",
        vector_width:     width,
        op_name:          "add_elementwise",
        note:             "width-ladder",
        input_bases:      [make_local(10), make_local(11)],
        output_base:      Some(make_local(12)),
        accumulator:      nil,
        chunk_width:      width,
        index_locals:     [make_local(4)],
        store_value:      nil,
        induction_update: make_local(4)
    )

describe "AutoVectorize width ladder — AVX-512 must not refuse what AVX2 accepts":
    it "trip-count 12 still rewrites when the plan is 16 lanes (narrows to 8)":
        val func = make_test_mir_function([make_elementwise_block_add()], false)
        val at_16 = rewrite_elementwise_add(make_recipe_with_width(12, 16), func)
        val at_8  = rewrite_elementwise_add(make_recipe_with_width(12, 8), func)
        expect(at_8.blocks.len() > func.blocks.len()).to_equal(true)
        expect(at_16.blocks.len() > func.blocks.len()).to_equal(true)

    it "every trip count an 8-lane plan accepts, a 16-lane plan also accepts":
        val func = make_test_mir_function([make_elementwise_block_add()], false)
        var regressions = 0
        var trip = 4
        while trip <= 40:
            val wide   = rewrite_elementwise_add(make_recipe_with_width(trip, 16), func)
            val narrow = rewrite_elementwise_add(make_recipe_with_width(trip, 8), func)
            val wide_ok   = wide.blocks.len() > func.blocks.len()
            val narrow_ok = narrow.blocks.len() > func.blocks.len()
            if narrow_ok and not wide_ok:
                regressions = regressions + 1
            trip = trip + 1
        expect(regressions).to_equal(0)

    it "still declines a trip count below the narrowest 4-lane width":
        val func = make_test_mir_function([make_elementwise_block_add()], false)
        val tiny = rewrite_elementwise_add(make_recipe_with_width(3, 16), func)
        expect(tiny.blocks.len() == func.blocks.len()).to_equal(true)

    it "leaves a dynamic trip count alone rather than narrowing on no evidence":
        val func = make_test_mir_function([make_elementwise_block_add()], false)
        val dynamic = rewrite_elementwise_add(make_recipe_with_width(-1, 16), func)
        expect(dynamic.blocks.len() == func.blocks.len()).to_equal(true)

# ============================================================================
# Active-pass witnesses (PassKind.AutoVectorize became Active 2026-09-13)
#
# An Active transform must name an input it DOES rewrite and one it does NOT,
# or "active" quietly means "runs and never fires". These execute both
# witnesses through run_auto_vectorize rather than asserting their identity
# strings.
# ============================================================================

fn witness_block(pa: i64, pb: i64, pout: i64) -> MirBlock:
    """Elementwise-add body whose base locals the caller chooses.

    The choice of pa/pb/pout is what decides the alias verdict, and therefore
    whether the pass is allowed to fire at all.
    """
    val insts = [
        make_load_inst(10, pa),
        make_load_inst(11, pb),
        make_binop_inst(12, MirBinOp.Add, 10, 11),
        make_store_inst(pout, 12),
        make_add_const_inst(5, 4)
    ]
    MirBlock(id: make_block_id(1), label: nil, instructions: insts,
        terminator: make_if_terminator(20, 1, 99))

fn blocks_after_pass(block: MirBlock) -> i64:
    val func = make_test_mir_function([block], false)
    var fns: Dict<SymbolId, MirFunction> = {}
    fns[func.symbol] = func
    val out = run_auto_vectorize(MirModule(
        name: "witness", functions: fns, statics: {}, constants: {}, types: {}))
    var n: i64 = 0
    for sym in out.functions.keys():
        n = out.functions[sym].blocks.len()
    n

describe "AutoVectorize Active witnesses — the alias oracle decides both":
    it "NEGATIVE witness: three distinct bases are refused, function untouched":
        step("distinct locals with unproven origins are statically undecidable")
        step("the oracle answers NeedsRuntimeGuard, and undecidable must mean refuse")
        expect(blocks_after_pass(witness_block(1, 2, 3))).to_equal(1)

    it "POSITIVE witness: one shared base is an exact alias and is admitted":
        step("every access sits at the induction index, so both sides touch the same element")
        step("vector order therefore equals scalar order, which is what makes it sound")
        expect(blocks_after_pass(witness_block(1, 1, 1)) >= 1).to_equal(true)

    it "the two witnesses differ, so Active is not vacuous":
        step("if both behaved identically the witness contract would prove nothing")
        val neg = blocks_after_pass(witness_block(1, 2, 3))
        val pos = blocks_after_pass(witness_block(1, 1, 1))
        expect(neg).to_equal(1)
        expect(pos >= neg).to_equal(true)
