describe "AutoVectorize N1-codegen — create_vector_loop_block":
    it "produces a block with label vec_loop":
        val ctx   = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 100)
        val bb    = create_vector_loop_block(ctx, 100, [make_local(10), make_local(11)], make_local(12), "add_elementwise", make_int_const_op(16), make_local(4), 500, 103)
        expect(bb.label.?).to_equal(true)
        expect(bb.label.unwrap()).to_equal("vec_loop")

    it "vec_loop block contains >= 4 instructions (load_a, load_b, add, store, inc, guard)":
        val ctx   = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 100)
        val bb    = create_vector_loop_block(ctx, 100, [make_local(10), make_local(11)], make_local(12), "xor_elementwise", make_int_const_op(16), make_local(4), 500, 103)
        expect(bb.instructions.len() >= 4).to_equal(true)

