fn make_test_loop_info() -> VectorLoopInfo:
    VectorLoopInfo(
        header_block:  make_block_id(0),
        body_blocks:   [make_block_id(1)],
        exit_block:    make_block_id(2),
        induction_var: make_local(4),
        start_value:   0,
        end_value:     100,
        step:          1
    )

fn make_test_vectorize_ctx() -> VectorizeContext:
    VectorizeContext(
        vector_width: 8,
        element_type: "f32",
        next_local:   200
    )

describe "AutoVectorize W-cfg — create_alignment_check_block":
    it "produces a block with label align_check":
        val li  = make_test_loop_info()
        val ctx = make_test_vectorize_ctx()
        val bb  = create_alignment_check_block(ctx, li, make_int_const_op(16), make_local(4), 500, 99)
        expect(bb.label.?).to_equal(true)
        expect(bb.label.unwrap()).to_equal("align_check")

    it "alignment-check terminator is If":
        val li  = make_test_loop_info()
        val ctx = make_test_vectorize_ctx()
        val bb  = create_alignment_check_block(ctx, li, make_int_const_op(16), make_local(4), 500, 99)
        val is_if = match bb.terminator:
            case If(cond, then_, else_): true
            case _: false
        expect(is_if).to_equal(true)

describe "AutoVectorize W-cfg — create_peeling_block":
    it "produces a block with label peel_loop":
        val li  = make_test_loop_info()
        val ctx = make_test_vectorize_ctx()
        val bb  = create_peeling_block(ctx, li, [])
        expect(bb.label.?).to_equal(true)
        expect(bb.label.unwrap()).to_equal("peel_loop")

# ============================================================================
# N1 Wave — rewrite_elementwise_add tests
# ============================================================================
#
# MirFunction construction helpers.
# In interpreter mode assertions are not executed; these tests verify that
# the rewriter API compiles and describe/it blocks are reachable.
# Structural invariants checked: block count changes, label presence, recipe
# refuse conditions.

fn make_driver_manifest_attr_default() -> DriverManifestAttr:
    DriverManifestAttr(
        kind:       DriverManifestAttrKind.Driver,
        driver_class: 0,
        vendor:     0,
        device_ids: [],
        version:    "",
        abi:        ""
    )

fn make_test_mir_function(blocks: [MirBlock], has_fast_math: bool) -> MirFunction:
    """Minimal MirFunction for rewriter tests."""
    val sig = MirSignature(
        params:       [],
        return_type:  MirType(kind: MirTypeKind.Unit),
        is_variadic:  false
    )
    MirFunction(
        symbol:                 SymbolId(id: 1),
        name:                   "test_fn",
        signature:              sig,
        locals:                 [],
        blocks:                 blocks,
        entry_block:            make_block_id(0),
        span:                   Span(start: 0, end: 0, line: 1, col: 1),
        generic_params:         [],
        is_generic_template:    false,
        specialization_of:      nil,
        type_bindings:          {},
        layout_phase:           nil,
        is_kernel:              false,
        is_export_c:            false,
        export_name:            "",
        has_driver_manifest_attr: false,
        driver_manifest_attr:   make_driver_manifest_attr_default(),
        has_vhdl_metadata:      false,
        vhdl_metadata:          vhdl_hardware_metadata_default(),
        has_fast_math:          has_fast_math
    )

fn make_elementwise_add_recipe_for_rewrite() -> VectorRecipe:
    """Recipe for: for i in 0..16: out[i] = a[i] + b[i]  (trip_count=16, chunk_width=4)"""
    VectorRecipe(
        kind:             VectorRecipeKind.Elementwise,
        header_block:     make_block_id(1),
        induction_var:    make_local(4),
        trip_count:       16,
        element_type:     "i32",
        vector_width:     4,
        op_name:          "add_elementwise",
        note:             "test recipe",
        input_bases:      [make_local(10), make_local(11)],
        output_base:      Some(make_local(12)),
        accumulator:      nil,
        chunk_width:      4,
        index_locals:     [make_local(4)],
        store_value:      nil,
        induction_update: make_local(4)
    )

fn make_elementwise_add_recipe_dynamic_n() -> VectorRecipe:
    """Recipe for: for i in 0..n: out[i] = a[i] + b[i]  (trip_count=-1, dynamic)"""
    VectorRecipe(
        kind:             VectorRecipeKind.Elementwise,
        header_block:     make_block_id(1),
        induction_var:    make_local(4),
        trip_count:       -1,
        element_type:     "i32",
        vector_width:     4,
        op_name:          "add_elementwise",
        note:             "test recipe dynamic",
        input_bases:      [make_local(10), make_local(11)],
        output_base:      Some(make_local(12)),
        accumulator:      nil,
        chunk_width:      4,
        index_locals:     [make_local(4)],
        store_value:      nil,
        induction_update: make_local(4)
    )

fn make_elementwise_mul_recipe() -> VectorRecipe:
    """Recipe for: for i in 0..16: out[i] = a[i] * b[i]

    header_block is 2 because `make_elementwise_block_mul` IS block 2. It used
    to say 1, naming a block that does not exist in that function — the rewrite
    only appeared to work because the old code invented an exit at header + 3
    instead of resolving the real one.
    """
    VectorRecipe(
        kind:             VectorRecipeKind.Elementwise,
        header_block:     make_block_id(2),
        induction_var:    make_local(4),
        trip_count:       16,
        element_type:     "f32",
        vector_width:     4,
        op_name:          "mul_elementwise",
        note:             "test recipe mul",
        input_bases:      [make_local(10), make_local(11)],
        output_base:      Some(make_local(12)),
        accumulator:      nil,
        chunk_width:      4,
        index_locals:     [make_local(4)],
        store_value:      nil,
        induction_update: make_local(4)
    )

fn make_unsupported_div_recipe() -> VectorRecipe:
    """Recipe for an unsupported div rewrite in phase 1."""
    VectorRecipe(
        kind:             VectorRecipeKind.Elementwise,
        header_block:     make_block_id(1),
        induction_var:    make_local(4),
        trip_count:       16,
        element_type:     "f32",
        vector_width:     4,
        op_name:          "div_elementwise",
        note:             "test recipe div",
        input_bases:      [make_local(10), make_local(11)],
        output_base:      Some(make_local(12)),
        accumulator:      nil,
        chunk_width:      4,
        index_locals:     [make_local(4)],
        store_value:      nil,
        induction_update: make_local(4)
    )

fn make_elementwise_add_recipe_f32_no_fastmath() -> VectorRecipe:
    """Recipe for f32 add but function lacks has_fast_math"""
    VectorRecipe(
        kind:             VectorRecipeKind.Elementwise,
        header_block:     make_block_id(1),
        induction_var:    make_local(4),
        trip_count:       16,
        element_type:     "f32",
        vector_width:     4,
        op_name:          "add_elementwise",
        note:             "test recipe f32",
        input_bases:      [make_local(10), make_local(11)],
        output_base:      Some(make_local(12)),
        accumulator:      nil,
        chunk_width:      4,
        index_locals:     [make_local(4)],
        store_value:      nil,
        induction_update: make_local(4)
    )

# ============================================================================
# N1 positive: end-to-end block structure for divisible trip count (0..16, VF=4)
#
# Verifies the three-block output of the rewrite by testing each codegen helper
# in isolation — same structural invariants without needing a full MirFunction.
# (MirFunction construction requires HirType/LayoutPhase; deferred to compiled mode.)
# ============================================================================

describe "AutoVectorize N1-rewrite — elementwise-add divisible trip count (0..16) via codegen":
    it "alignment-check block has If terminator (branches to vec_loop or peel)":
        val ctx = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 1)
        val li  = VectorLoopInfo(
            header_block:  make_block_id(1),
            body_blocks:   [],
            exit_block:    make_block_id(4),
            induction_var: make_local(4),
            start_value:   0,
            end_value:     16,
            step:          1
        )
        val align = create_alignment_check_block(ctx, li, make_int_const_op(16), make_local(4), 500, 99)
        val is_if = match align.terminator:
            case If(cond, then_, else_): true
            case _: false
        expect(is_if).to_equal(true)

    it "vec_loop block for i32x4 recipe has label vec_loop":
        val ctx = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 1)
        val bb  = create_vector_loop_block(ctx, 1,
            [make_local(10), make_local(11)], make_local(12), "add_elementwise",
            make_int_const_op(16), make_local(4), 500, 4)
        expect(bb.label.?).to_equal(true)
        expect(bb.label.unwrap()).to_equal("vec_loop")

    it "vec_loop block for i32x4 has >= 4 SIMD instructions":
        val ctx = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 1)
        val bb  = create_vector_loop_block(ctx, 1,
            [make_local(10), make_local(11)], make_local(12), "add_elementwise",
            make_int_const_op(16), make_local(4), 500, 4)
        # load_a + load_b + simd_add + simd_store + vi_inc + guard = 6 instructions
        expect(bb.instructions.len() >= 4).to_equal(true)

    it "peel_loop block for trip_count=16 divisible trip has label peel_loop":
        val ctx = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 1)
        val li  = VectorLoopInfo(
            header_block:  make_block_id(1),
            body_blocks:   [],
            exit_block:    make_block_id(4),
            induction_var: make_local(4),
            start_value:   0,
            end_value:     16,
            step:          1
        )
        val peel = create_peeling_block(ctx, li, [])
        expect(peel.label.?).to_equal(true)
        expect(peel.label.unwrap()).to_equal("peel_loop")

# ============================================================================
# N1 positive: dynamic trip count (0..n, VF=4) → alignment_check is runtime
# ============================================================================

describe "AutoVectorize N1-rewrite — elementwise-add dynamic trip count (0..n) via codegen":
    it "alignment-check block for dynamic n (end_value=0 sentinel) still has If terminator":
        # When trip_count = -1 (unknown), rewriter uses end_value=0 as sentinel.
        # The alignment-check block still produces a runtime If terminator.
        val ctx = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 1)
        val li  = VectorLoopInfo(
            header_block:  make_block_id(1),
            body_blocks:   [],
            exit_block:    make_block_id(4),
            induction_var: make_local(4),
            start_value:   0,
            end_value:     0,
            step:          1
        )
        val align = create_alignment_check_block(ctx, li, make_int_const_op(16), make_local(4), 500, 99)
        val is_if = match align.terminator:
            case If(cond, then_, else_): true
            case _: false
        expect(is_if).to_equal(true)

    it "peel_loop block for dynamic n has Goto terminator (no body clone when body_blocks empty)":
        val ctx = VectorizeContext(vector_width: 4, element_type: "i32", next_local: 1)
        val li  = VectorLoopInfo(
            header_block:  make_block_id(1),
            body_blocks:   [],
            exit_block:    make_block_id(4),
            induction_var: make_local(4),
            start_value:   0,
            end_value:     0,
            step:          1
        )
        val peel = create_peeling_block(ctx, li, [])
        val is_goto = match peel.terminator:
            case Goto(target): true
            case _: false
        expect(is_goto).to_equal(true)

# ============================================================================
# N1 negative: trip count < chunk_width → rewriter refuses
# ============================================================================

describe "AutoVectorize N1-rewrite — refuses trip count < chunk_width (0..3, VF=4)":
    it "trip-count=3 < VF=4 returns function unchanged (same block count)":
        val orig_block = make_elementwise_block_add()
        val func       = make_test_mir_function([orig_block], false)
        val recipe     = VectorRecipe(
            kind:             VectorRecipeKind.Elementwise,
            header_block:     make_block_id(1),
            induction_var:    make_local(4),
            trip_count:       3,
            element_type:     "i32",
            vector_width:     4,
            op_name:          "add_elementwise",
            note:             "too short",
            input_bases:      [make_local(10), make_local(11)],
            output_base:      Some(make_local(12)),
            accumulator:      nil,
            chunk_width:      4,
            index_locals:     [make_local(4)],
            store_value:      nil,
            induction_update: make_local(4)
        )
        val result = rewrite_elementwise_add(recipe, func)
        expect(result.blocks.len()).to_equal(func.blocks.len())

# ============================================================================
# N1 positive: a dynamic (runtime) trip count is VECTORIZED.
#
# This asserted the opposite until the loop bound became an operand. Refusing a
# runtime length meant refusing essentially all real code — a request body, a
# row set, a framebuffer sized at runtime — so the pass could be Active and
# still never fire on anything a server runs. The guard is `i <= n - VF`, which
# does not care whether `n` is a constant or a local, and whatever is left over
# is finished by the scalar clone.
# ============================================================================

describe "AutoVectorize N1-rewrite — vectorizes a dynamic trip count (trip_count=-1)":
    it "trip-count=-1 (runtime bound) is rewritten, not refused":
        step("this is the case that decides whether real code is vectorized at all")
        val orig_block = make_elementwise_block_add()
        val func       = make_test_mir_function([orig_block], false)
        val recipe     = make_elementwise_add_recipe_dynamic_n()
        val result     = rewrite_elementwise_add(recipe, func)
        expect(result.blocks.len() > func.blocks.len()).to_equal(true)

# ============================================================================
# N1 positive: misaligned trip count → rewriter now accepts (Wave L3b Defect C fix)
# trip_count=6, chunk_width=4: 6 % 4 = 2 → peel block gets 2-iteration scalar clone
# ============================================================================

# This spec used to assert the OPPOSITE — that trip 6 with VF 4 is accepted
# "with peel body (Wave L3b)". Running the rewrite showed the peel body writes
# one element and jumps to a block that does not exist, so what this pinned was
# a miscompile. R4b now refuses it; see the trip-count sweep in the step-6
# section for the execution evidence.
describe "AutoVectorize N1-rewrite — vectorizes a misaligned trip count (6 % 4 != 0)":
    it "trip-count=6 with VF=4 vectorizes the first chunk and leaves 2 to the remainder":
        val orig_block = make_elementwise_block_add()
        val func       = make_test_mir_function([orig_block], false)
        val recipe     = VectorRecipe(
            kind:             VectorRecipeKind.Elementwise,
            header_block:     make_block_id(1),
            induction_var:    make_local(4),
            trip_count:       6,
            element_type:     "i32",
            vector_width:     4,
            op_name:          "add_elementwise",
            note:             "misaligned",
            input_bases:      [make_local(10), make_local(11)],
            output_base:      Some(make_local(12)),
            accumulator:      nil,
            chunk_width:      4,
            index_locals:     [make_local(4)],
            store_value:      nil,
            induction_update: make_local(4)
        )
        val result = rewrite_elementwise_add(recipe, func)
        expect(result.blocks.len() > func.blocks.len()).to_equal(true)

# ============================================================================
# N1 positive: divisible trip count (0..16, VF=4) → rewriter should rewrite
# ============================================================================

describe "AutoVectorize N1-rewrite — accepts divisible trip count (0..16, VF=4)":
    it "trip-count=16 divisible with VF=4 rewrites function (block count increases)":
        val orig_block = make_elementwise_block_add()
        val func       = make_test_mir_function([orig_block], false)
        val recipe     = make_elementwise_add_recipe_for_rewrite()
        val result     = rewrite_elementwise_add(recipe, func)
