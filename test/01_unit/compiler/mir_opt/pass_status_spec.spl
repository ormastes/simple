"""
## Purpose and audience
Purpose: Prove that registered MIR passes expose truthful operational status.
Audience: compiler and optimizer maintainers.
"""
# @req: REQ-001, REQ-002, REQ-003

use std.spec.*
use compiler.mir_opt.mir_opt.mod.{
    PassKind, PassScope, PassStatus, PassExpectation, PassRunDisposition,
    pass_status, pass_expectation, pass_status_allows_transform,
    mir_pass_fact_preservation,
    pass_witness_contract, pass_witness_registry_integrity_errors,
    pass_run_record_new, pass_run_record_add_reason,
    pass_run_record_integrity_errors, pass_run_record_for_unavailable_request,
    optimizationpipeline_passes_for_level,
    optimizationpipeline_effective_passes_for_level,
    optimizationpipeline_for_level,
    mir_pass_registry_integrity_errors,
    OptLevel
}

describe "MIR pass operational status":
    it "keeps identity scalar adapters out of effective transformation dispatch":
        step("Classify an identity adapter")
        expect(pass_status(PassKind.DeadCodeElimination)).to_equal(PassStatus.Skeleton)
        expect(pass_expectation(PassKind.DeadCodeElimination)).to_equal(PassExpectation.NeverTransforms)
        expect(pass_status_allows_transform(pass_status(PassKind.DeadCodeElimination))).to_equal(false)

    it "keeps proof-incomplete safety transforms disabled":
        step("Classify a proof-incomplete bounds transform")
        val status = pass_status(PassKind.BoundsCheckElimination)
        expect(pass_status_allows_transform(status)).to_equal(false)
        expect(pass_expectation(PassKind.BoundsCheckElimination)).to_equal(PassExpectation.NeverTransforms)

    it "keeps the proof-incomplete collection optimizer out of dispatch":
        step("Classify a proof-incomplete collection transform")
        expect(pass_status_allows_transform(pass_status(PassKind.CollectionOpt))).to_equal(false)
        expect(pass_expectation(PassKind.CollectionOpt)).to_equal(PassExpectation.NeverTransforms)

    it "keeps vectorization analysis-only":
        step("Classify the vector analysis")
        expect(pass_status(PassKind.AutoVectorize)).to_equal(PassStatus.AnalysisOnly)
        expect(pass_status_allows_transform(pass_status(PassKind.AutoVectorize))).to_equal(false)

    it "keeps active identity and analysis routes out of transformation dispatch":
        step("Reject an active identity route")
        expect(pass_status(PassKind.TargetNarrowForm)).to_equal(PassStatus.Skeleton)
        expect(pass_status(PassKind.ReadAheadHoist)).to_equal(PassStatus.AnalysisOnly)
        expect(pass_status(PassKind.InlineFunctions)).to_equal(PassStatus.Skeleton)

    it "invalidates shared facts conservatively after any admitted transform":
        step("Invalidate facts after a MIR rewrite")
        val active = mir_pass_fact_preservation(PassKind.WriteCoalesce)
        expect(active.cfg).to_equal(false)
        expect(active.dominators).to_equal(false)
        expect(active.def_use).to_equal(false)
        val analysis = mir_pass_fact_preservation(PassKind.AutoVectorize)
        expect(analysis.cfg).to_equal(true)
        expect(analysis.dominators).to_equal(true)
        expect(analysis.def_use).to_equal(true)

    it "distinguishes requested passes from the effective pipeline":
        step("Load requested and effective optimizer plans")
        val requested = optimizationpipeline_passes_for_level(OptLevel.Speed)
        val effective = optimizationpipeline_effective_passes_for_level(OptLevel.Speed)
        expect(requested.contains("dead_code_elimination")).to_equal(true)
        expect(effective.contains("dead_code_elimination")).to_equal(false)
        expect(effective.contains("collection_opt")).to_equal(false)
        expect(optimizationpipeline_for_level(OptLevel.Speed).passes).to_equal(effective)

    it "passes the structural optimizer registry self-check":
        step("Reject dishonest active transforms")
        expect(mir_pass_registry_integrity_errors().len()).to_equal(0)
        expect(pass_witness_registry_integrity_errors().len()).to_equal(0)

    it "binds every retained active transform to positive and negative witnesses":
        step("Reject an active pass without both witness identities")
        val pattern = pass_witness_contract(PassKind.PatternIdiom)
        expect(pattern.?).to_be(true)
        expect(pattern.unwrap().positive_id).to_equal("pattern.supported_aes_call")
        expect(pattern.unwrap().negative_id).to_equal("pattern.unsupported_target")
        expect(pass_witness_contract(PassKind.TargetNarrowForm)).to_be_nil()

    it "fails closed when a requested pass is unknown or inactive":
        step("Reject an unknown requested pass")
        val unknown = pass_run_record_for_unavailable_request("not_a_pass")
        expect(unknown.disposition).to_equal(PassRunDisposition.Failed)
        expect(unknown.reasons[0].code).to_equal("unknown_pass")
        expect(pass_run_record_integrity_errors(unknown).len()).to_equal(0)

        val inactive = pass_run_record_for_unavailable_request("collection_opt")
        expect(inactive.disposition).to_equal(PassRunDisposition.Skipped)
        expect(inactive.reasons[0].code).to_equal("inactive_status")
        expect(pass_run_record_integrity_errors(inactive).len()).to_equal(0)

    it "rejects internally contradictory pass-run records":
        step("Validate a pass-run record")
        var invalid = pass_run_record_new(
            "pattern_idiom", "pattern_idiom", PassStatus.Active,
            PassExpectation.MustTransformSentinel, PassScope.Module,
            PassRunDisposition.Transformed
        )
        invalid.candidates = 1
        invalid.transformed = 2
        invalid = pass_run_record_add_reason(invalid, "legality_unproved", 1)
        invalid = pass_run_record_add_reason(invalid, "legality_unproved", 2)
        expect(invalid.reasons[0].count).to_equal(3)
        expect(pass_run_record_integrity_errors(invalid).len()).to_be_greater_than(1)
