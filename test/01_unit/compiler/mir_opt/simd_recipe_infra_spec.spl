"""
## Purpose and audience
Purpose: Pin SIMD recipe report ordering and byte shape.
Audience: compiler optimizer and performance-report maintainers.
"""
# @req: REQ-002, REQ-003

use std.spec.*
use compiler.mir_opt.mir_opt.simd_recipe_infra.{SimdRecipeTable}

describe "SIMD recipe report":
    it "renders entries in insertion order with one trailing newline each":
        step("Render deterministic SIMD recipe metadata")
        var table = SimdRecipeTable.create()
        expect(table.add("add4", "add", 128, "always", 2, false, "sse2")).to_equal("ok")
        expect(table.add("mul8", "mul", 256, "fast_math_only", 3, true, "avx2")).to_equal("ok")
        val report = table.report()
        expect(report).to_start_with("SimdRecipeTable count=2\n  [0] recipe=add4")
        expect(report).to_contain("\n  [1] recipe=mul8 op=mul width=256")
        expect(report).to_end_with("fm=true feats=[avx2]\n")
