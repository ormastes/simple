"""
# MIR optimization capsule immutability, storage fast-path, and scoping

Tests four invariants for MIR optimization and backend lowering:
1. `lower_mir_storage_project_fields_v1` takes a zero-clone read-only fast-path
   when no `MIR_STORAGE_PROJECT_FIELD_V1` intrinsic exists, while still failing
   closed on missing bindings when a projection intrinsic is present.
2. `run_pass_on_module_checked` and `run_typed_pass_on_module` never mutate
   `module.functions` in-place via shallow struct copies, preserving frozen
   capsule MIR identity across passes.
3. `g_provider_report` bounds retained events and resets cleanly at backend/driver
   transient scope boundaries without leaving freed pointers or open scopes.
4. `CompilerDriver.optimize_mir_level` isolates per-module optimization inside
   transient scratch scopes and promotes the resulting `MirModule`.
"""
# @req REQ-MIR-OPT-CAPSULE-IMMUTABILITY
# @cover src/compiler/60.mir_opt/mir_opt/storage_projection_lowering.spl
# @cover src/compiler/60.mir_opt/mir_opt/mod.spl
# @cover src/compiler/60.mir_opt/mir_opt/simd_opt_metadata.spl
# @cover src/compiler/70.backend/backend/backend_helpers.spl
# @cover src/compiler/80.driver/driver_pipeline_passes.spl

use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.common.driver_compile_options.{CompileOptions, driver_core_compile_options_default}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}
use compiler.mir_opt.storage_projection_lowering.{
    MIR_STORAGE_PROJECT_FIELD_V1,
    lower_mir_storage_project_fields_v1
}
use compiler.mir_opt.mod.{
    PassKind, run_typed_pass_on_module, run_pass_on_module_checked,
    pipeline_optimize, optimizationpipeline_for_backend, OptLevel,
    mir_opt_module_with_replaced_function
}
use compiler.mir_opt.simd_opt_metadata.{
    g_provider_report, reset_provider_report, plugin_hook_vectorize_event
}
use compiler.backend.backend.backend_types.{CodegenTarget, OptimizationLevel, BackendCompileOptions}
use compiler.backend.backend_helpers.{
    compile_llvm_module_to_object_path, compile_module_with_backend_scoped_v1
}
use compiler.driver.native_capsule_mir_identity.{compute_native_capsule_mir_identity_v1}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_types.{CompileContext}
use compiler.driver.driver_pipeline_passes.*

fn _make_local(id: i64) -> LocalId:
    LocalId(id: id)

fn _make_block_id(id: i64) -> BlockId:
    BlockId.new(id)

fn _make_int_const_op(v: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Int(v),
        MirType(kind: MirTypeKind.I64)))

fn _make_copy_op(local_id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(_make_local(local_id)))

fn _probe_span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1, file: "fastpath_probe.spl", length: 1)

fn _make_fn_from_blocks(id: i64, name: text, blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: id),
        name: name,
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: blocks,
        entry_block: _make_block_id(0),
        span: _probe_span(),
        generic_params: [],
        is_generic_template: false,
        specialization_of: None,
        type_bindings: {},
        layout_phase: None,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: DriverManifestAttr(DriverManifestAttrKind.Driver, 0, 0, [], "", ""),
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false,
        unroll_factor: 0,
        pipeline_ii: 0,
        memory_banks: 0,
        verification_contract: None
    )

fn _make_noop_module() -> MirModule:
    val sym = SymbolId(id: 11)
    val inst = MirInst(
        kind: MirInstKind.Const(_make_local(0), MirConstValue.Int(7), MirType.i64()),
        span: _probe_span())
    val block = MirBlock(
        id: _make_block_id(0), label: None, instructions: [inst],
        terminator: MirTerminator.Ret(None))
    var func = _make_fn_from_blocks(11, "noop_fn", [block])
    func.locals = [
        MirLocal(id: _make_local(0), name: Some("c0"), type_: MirType.i64(), kind: LocalKind.Temp)
    ]
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[sym] = func
    MirModule(name: "fastpath_probe", functions: functions, statics: {}, constants: {}, types: {})

fn _make_projection_module() -> MirModule:
    val sym = SymbolId(id: 12)
    val base_op = _make_copy_op(1)
    val idx_op = _make_copy_op(2)
    val field_op = _make_int_const_op(0)
    val inst = MirInst(
        kind: MirInstKind.Intrinsic(
            Some(_make_local(3)), MIR_STORAGE_PROJECT_FIELD_V1, [base_op, idx_op, field_op]),
        span: _probe_span())
    val block = MirBlock(
        id: _make_block_id(0), label: None, instructions: [inst],
        terminator: MirTerminator.Ret(None))
    val func = _make_fn_from_blocks(12, "proj_fn", [block])
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[sym] = func
    MirModule(name: "projection_probe", functions: functions, statics: {}, constants: {}, types: {})

fn _make_vectorizable_module() -> (MirModule, SymbolId):
    val sym = SymbolId(id: 21)
    val header = MirBlock(
        id: _make_block_id(0), label: None, instructions: [],
        terminator: MirTerminator.Goto(_make_block_id(1)))
    val body_insts = [
        MirInst(kind: MirInstKind.BinOp(_make_local(20), MirBinOp.Lt,
            _make_copy_op(4), _make_copy_op(40)), span: _probe_span()),
        MirInst(kind: MirInstKind.Load(_make_local(10), _make_copy_op(1)), span: _probe_span()),
        MirInst(kind: MirInstKind.Load(_make_local(11), _make_copy_op(2)), span: _probe_span()),
        MirInst(kind: MirInstKind.BinOp(_make_local(12), MirBinOp.Add,
            _make_copy_op(10), _make_copy_op(11)), span: _probe_span()),
        MirInst(kind: MirInstKind.Store(_make_copy_op(3), _make_copy_op(12)), span: _probe_span()),
        MirInst(kind: MirInstKind.BinOp(_make_local(5), MirBinOp.Add,
            _make_copy_op(4), _make_int_const_op(1)), span: _probe_span())
    ]
    val body = MirBlock(
        id: _make_block_id(1), label: None, instructions: body_insts,
        terminator: MirTerminator.Goto(_make_block_id(0)))
    val locals = [
        MirLocal(id: _make_local(1), name: Some("a"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(2), name: Some("b"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(3), name: Some("out"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(4), name: Some("i"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(5), name: Some("i_next"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(10), name: Some("va"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(11), name: Some("vb"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(12), name: Some("vc"), type_: MirType.i64(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(20), name: Some("cmp"), type_: MirType.bool(), kind: LocalKind.Temp),
        MirLocal(id: _make_local(40), name: Some("n"), type_: MirType.i64(), kind: LocalKind.Temp)
    ]
    var func = _make_fn_from_blocks(21, "vec_loop", [header, body])
    func.locals = locals
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[sym] = func
    (MirModule(name: "vec_probe", functions: functions, statics: {}, constants: {}, types: {}), sym)

describe "storage projection lowering fast-path":
    it "returns the input module untouched with zero Dict clones when no projection intrinsic exists":
        step("Run lower_mir_storage_project_fields_v1 on a module without projections")
        val module = _make_noop_module()
        val before_digest = compute_native_capsule_mir_identity_v1(module)
        val result = lower_mir_storage_project_fields_v1(module, [])
        expect(result.ok).to_equal(true)
        expect(result.rewritten_count).to_equal(0)
        expect(result.reason).to_equal("ok")

        step("Verify zero Dict clone: output module keeps identical capsule identity and fast-path returns before Dict allocation")
        expect(result.module.functions.len()).to_equal(1)
        expect(compute_native_capsule_mir_identity_v1(result.module)).to_equal(before_digest)
        val lowering_src = file_read("src/compiler/60.mir_opt/mir_opt/storage_projection_lowering.spl")
        expect(lowering_src).to_contain("if not _mir_module_has_storage_project_field_v1(module):")
        expect(lowering_src).to_contain("module: module,")

    it "still fails closed when MIR_STORAGE_PROJECT_FIELD_V1 is present and bindings are empty":
        step("Run lower_mir_storage_project_fields_v1 on a projection module with no bindings")
        val module = _make_projection_module()
        val result = lower_mir_storage_project_fields_v1(module, [])
        expect(result.ok).to_equal(false)
        expect(result.reason).to_equal("missing-storage-view-site-binding")

describe "MIR pass module immutability":
    it "never mutates input module.functions in run_typed_pass_on_module or run_pass_on_module_checked":
        step("Snapshot capsule MIR identity before running optimization passes and replacement")
        val orig_module = _make_noop_module()
        val sym = orig_module.functions.keys()[0]
        val before_digest = compute_native_capsule_mir_identity_v1(orig_module)
        expect(before_digest.len()).to_equal(64)

        step("Verify immutable function replacement clones Dict and preserves capsule MIR identity")
        var alt_fn = orig_module.functions[sym]
        alt_fn.name = "noop_fn_replaced"
        val replaced_mod = mir_opt_module_with_replaced_function(orig_module, sym, alt_fn)
        expect(compute_native_capsule_mir_identity_v1(orig_module)).to_equal(before_digest)
        expect(orig_module.functions[sym].name).to_equal("noop_fn")
        expect(replaced_mod.functions[sym].name).to_equal("noop_fn_replaced")

        step("Run AutoVectorize through run_typed_pass_on_module, pipeline_optimize, and checked dispatch")
        val typed_out = run_typed_pass_on_module(PassKind.AutoVectorize, orig_module)
        expect(compute_native_capsule_mir_identity_v1(orig_module)).to_equal(before_digest)
        expect(typed_out.functions.contains_key(sym)).to_equal(true)

        val pipe = optimizationpipeline_for_backend(OptLevel.Speed, "llvm")
        val pipe_out = pipeline_optimize(pipe, orig_module)
        expect(compute_native_capsule_mir_identity_v1(orig_module)).to_equal(before_digest)
        expect(pipe_out.functions.contains_key(sym)).to_equal(true)

        val checked_res = run_pass_on_module_checked("auto_vectorize", orig_module)
        expect(checked_res.is_ok()).to_equal(true)
        expect(compute_native_capsule_mir_identity_v1(orig_module)).to_equal(before_digest)

        step("Verify source contains no in-place result_module.functions/updated.functions write")
        val mod_src = file_read("src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(mod_src.contains("result_module.functions[")).to_equal(false)
        expect(mod_src.contains("updated.functions[")).to_equal(false)
        expect(mod_src).to_contain("_mir_opt_clone_module_functions")

describe "simd_opt_metadata and scoped backend boundaries":
    it "bounds retained provider events while preserving unit-test visibility":
        step("Reset report and record two events directly")
        reset_provider_report()
        plugin_hook_vectorize_event("k_unit_1", true)
        plugin_hook_vectorize_event("k_unit_2", false)
        expect(g_provider_report.total_hits).to_equal(2)
        expect(g_provider_report.total_changes).to_equal(1)
        expect(g_provider_report.events.len()).to_equal(2)

        step("Verify event list is bounded above cap without dropping hit counters")
        var idx = 0
        while idx < 300:
            plugin_hook_vectorize_event("k_burst_{idx}", false)
            idx = idx + 1
        expect(g_provider_report.total_hits).to_equal(302)
        expect(g_provider_report.events.len() <= 256).to_equal(true)
        reset_provider_report()

    it "resets g_provider_report and closes transient scopes around backend/driver boundaries":
        step("Trigger vectorize event and run compile_llvm_module_to_object_path on a projection refusal path and noop path")
        val _mk = dir_create_all("build/test_tmp")
        plugin_hook_vectorize_event("stale_before_backend", true)
        val proj = _make_projection_module()
        val proj_status = compile_llvm_module_to_object_path(
            proj, true, 0, "", [],
            "build/test_tmp/g2_proj_obj.o", "build/test_tmp/g2_proj_obj.diag")
        expect(proj_status).to_equal(1)
        expect(transient_array_scope_state_v1()).to_equal(0)
        expect(g_provider_report.events.len()).to_equal(0)

        plugin_hook_vectorize_event("stale_before_noop_backend", true)
        val noop = _make_noop_module()
        val _status = compile_llvm_module_to_object_path(
            noop, true, 0, "", [],
            "build/test_tmp/g2_noop_obj.o", "build/test_tmp/g2_noop_obj.diag")
        expect(transient_array_scope_state_v1()).to_equal(0)
        expect(g_provider_report.events.len()).to_equal(0)

    it "wraps per-module MIR optimization in transient scopes in optimize_mir_level":
        step("Create driver with one MIR module and invoke optimize_mir_level")
        var options: CompileOptions = driver_core_compile_options_default()
        options.input_files = ["optimize_mir_level_probe.spl"]
        options.backend = "llvm"
        var ctx = CompileContext.create(options)
        ctx.mir_modules["vec_probe"] = _make_vectorizable_module().0
        var driver = CompilerDriver(ctx: ctx)

        plugin_hook_vectorize_event("stale_before_driver_opt", true)
        driver.optimize_mir_level(2)
        expect(transient_array_scope_state_v1()).to_equal(0)
        expect(g_provider_report.events.len()).to_equal(0)

        val passes_src = file_read("src/compiler/80.driver/driver_pipeline_passes.spl")
        expect(passes_src).to_contain("transient_scope_begin")
        expect(passes_src).to_contain("transient_promote<MirModule>")
        expect(passes_src).to_contain("transient_scope_end")
