"""Owner modules for the CUDA optimizer payload types resolve and construct.

Prevention for cuda_optimizer_surface_owner_2026_10_10: inline/loop_opt/
loop_licm/auto_vectorize_cost import LocalId/BlockId from their declaring owner
as a workaround for imported-surface projection losing ownership. This spec
imports the same owners and the four optimizer modules together, so a drift in
either owner path or a dependency-surface regression fails here first.
"""
# @req REQ-MIR-OPT-OWNER
# @cover src/compiler/60.mir_opt/mir_opt/auto_vectorize_cost.spl

use std.spec
use compiler.mir.mir_types.{LocalId}
use compiler.mir.mir_instruction_support.{BlockId}
use compiler.mir_opt.inline.*
use compiler.mir_opt.loop_opt.*
use compiler.mir_opt.loop_licm.*
use compiler.mir_opt.auto_vectorize_cost.*

describe "CUDA optimizer payload owners":
    it "constructs LocalId from its declaring owner":
        val l = LocalId(id: 7)
        expect(l.id).to_equal(7)

    it "constructs BlockId from its declaring owner":
        val b = BlockId(id: 3)
        expect(b.id).to_equal(3)
