"""MIR dead-code-elimination quarantine contracts."""

use std.spec.*
use std.fs.{read_file}
use compiler.mir.mir_data.*
use compiler.mir_opt.mir_opt.dce.{create_dce_pass}
use compiler.mir_opt.mir_opt.mod.{
    OptLevel, PassKind, PassStatus, PassExpectation,
    pass_status, pass_expectation, optimizationpipeline_passes_for_level,
    optimizationpipeline_effective_passes_for_level}

describe "MIR DeadCodeElimination Skeleton":
    it "is requested for compatibility but excluded from effective pipelines":
        step("Keep requested and executable optimizer truth separate")
        val requested = optimizationpipeline_passes_for_level(OptLevel.Speed)
        val effective = optimizationpipeline_effective_passes_for_level(OptLevel.Speed)
        expect(requested.contains("dead_code_elimination")).to_equal(true)
        expect(effective.contains("dead_code_elimination")).to_equal(false)
        expect(pass_status(PassKind.DeadCodeElimination)).to_equal(PassStatus.Skeleton)
        expect(pass_expectation(PassKind.DeadCodeElimination)).to_equal(
            PassExpectation.NeverTransforms)

    it "fails observability and intrinsic purity closed":
        step("Do not delete instructions from incomplete opcode/effect facts")
        var dce = create_dce_pass()
        val copy = MirInst(kind: MirInstKind.Copy(
            LocalId(id: 1), LocalId(id: 0)), span: nil)
        expect(dce.instruction_has_side_effects(copy)).to_equal(true)
        expect(dce.is_pure_intrinsic("sqrt")).to_equal(false)
        expect(dce.removed_instructions).to_equal(0)
        expect(dce.removed_blocks).to_equal(0)
        expect(dce.iterations).to_equal(0)

    it "contains no liveness sweep or instruction deletion body":
        step("Prevent direct activation before exhaustive DCE proofs")
        val source = read_file("src/compiler/60.mir_opt/mir_opt/dce.spl")
        expect(source).not.to_contain("perf_facts_build")
        expect(source).not.to_contain("remove_dead_instructions")
        expect(source).not.to_contain("reachable_set")
        expect(source).not.to_contain("var keep: [bool]")
        expect(source).not.to_contain("optimized_blocks")
