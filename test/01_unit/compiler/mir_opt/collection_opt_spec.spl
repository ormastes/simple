"""
## Purpose and audience
Executable evidence for the engineers who own
`src/compiler/60.mir_opt/mir_opt/collection_opt.spl`: which collection
queries count as pure and hoistable, when duplicate reads are reused, when
mutating calls fence reuse, and why loop hoisting fails closed until a
preheader/speculatability proof exists. Operators gating an optimizer change
rerun this spec to catch legality regressions in the collection pass.
## Operator workflow
Run
`<admitted-self-hosted-runtime> test test/01_unit/compiler/mir_opt/collection_opt_spec.spl`
from the repo root; each scenario builds a real MIR function from the helpers
at the top of the file, runs `create_collection_opt_pass` over it, and censuses
the optimized instructions.
## Compatibility and limitations
The scenarios drive the pass API directly on hand-built MIR, so they prove the
pass's own legality rules, not the driver's pass-pipeline ordering or
whole-program effects. Pass counters (`pure_queries_reused`,
`len_queries_reused`, `calls_hoisted`, `scalar_ops_hoisted`,
`dead_append_arrays_elided`) are part of the asserted surface.
## Verification guidance and troubleshooting
A failing census count means the pass retained one call too many or too few —
compare the scenario's instruction list against the count and check whether a
mutating call between the duplicates should have fenced the reuse. A failing
`*_hoisted`/`*_elided` counter means the fail-closed hoisting or dead-array
elision legality proof changed.
"""
# Lifecycle: doc/01_research/domain/runtime_facade_optimization.md ;
# doc/03_plan/compiler/optimization/simple_optimization_architecture_roadmap_2026-06-01.md ;
# doc/04_architecture/compiler/optimization/optimization_plugin_jit_hotspot.md ;
# doc/05_design/compiler/optimization/executable_size_reduction.md
# @manual_section: mir-collection-optimization

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirBlock}
use compiler.mir_opt.mir_opt.collection_opt.{create_collection_opt_pass}
use compiler.mir_opt.mir_opt.collection_opt_core.{CollectionOptimization}
use compiler.mir_opt.mir_opt.loop_detect.{LoopInfo}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}

fn _co_admitted_pass() -> CollectionOptimization:
    var opt = create_collection_opt_pass()
    # This test fixture supplies authority explicitly; the production caller
    # must prove these exact runtime identities before using the same API.
    opt.admit_collection_runtime_reads([
        "rt_array_get", "rt_array_len", "rt_dict_get", "rt_array_contains",
        "rt_dict_contains_key", "rt_array_data_ptr", "rt_array_first",
        "rt_typed_bytes_u8_data_at", "rt_typed_words_u64_at"
    ])
    opt

fn _co_lid(id: i64) -> LocalId:
    LocalId(id: id)

fn _co_copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(_co_lid(id)))

fn _co_int(value: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), MirType.i64()))

fn _co_string(value: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(value), MirType.ptr(MirType(kind: MirTypeKind.I8), false)))

fn _co_query(dest: i64, args: [MirOperand]) -> MirInst:
    MirInst(kind: MirInstKind.Call(_co_lid(dest), _co_func("rt_array_get"), args), span: nil)

fn _co_local(id: i64, type_: MirType) -> MirLocal:
    MirLocal(
        id: _co_lid(id),
        name: nil,
        type_: type_,
        kind: LocalKind.Temp,
        is_ghost: false
    )

fn _co_func(name: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(name),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
    ))

fn _co_block(instructions: [MirInst]) -> MirBlock:
    MirBlock(
        id: BlockId(id: 0),
        label: Some("entry"),
        instructions: instructions,
        terminator: MirTerminator.Ret(nil)
    )

fn _co_block_with(id: i64, instructions: [MirInst], terminator: MirTerminator) -> MirBlock:
    MirBlock(
        id: BlockId(id: id),
        label: Some("b{id}"),
        instructions: instructions,
        terminator: terminator
    )

fn _co_loop(header: i64, body: [i64]) -> LoopInfo:
    var body_blocks: [BlockId] = []
    for id in body:
        body_blocks.push(BlockId(id: id))
    LoopInfo(
        header: BlockId(id: header),
        body: body_blocks,
        backedges: body_blocks,
        exit_edges: [],
        trip_count: nil
    )

fn _co_driver_manifest_attr_default() -> DriverManifestAttr:
    DriverManifestAttr(
        kind: DriverManifestAttrKind.Driver,
        driver_class: 0,
        vendor: 0,
        device_ids: [],
        version: "",
        abi: ""
    )

fn _co_function(blocks: [MirBlock]) -> MirFunction:
    _co_function_with_locals(blocks, [])

fn _co_function_with_locals(blocks: [MirBlock], locals: [MirLocal]) -> MirFunction:
    val sig = MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)
    MirFunction(
        SymbolId(id: 1), "test_fn", sig, locals, blocks,
        BlockId(id: 0),
        Span(0, 0, 1, 1),
        [], false, nil, {}, nil, false, false, "",
        false, _co_driver_manifest_attr_default(),
        false, vhdl_hardware_metadata_default(),
        false
    )

fn _co_count_rt_array_len(block: MirBlock) -> i64:
    _co_count_named_call(block, "rt_array_len")

fn _co_count_named_call(block: MirBlock, expected: text) -> i64:
    var count = 0
    for inst in block.instructions:
        match inst.kind:
            case Call(_, func, _):
                match func.kind:
                    case Const(value, _):
                        match value:
                            case Str(name):
                                if name == expected:
                                    count = count + 1
                            case _:
                                ()
                    case _:
                        ()
            case _:
                ()
    count

fn _co_count_bounds_checks(block: MirBlock) -> i64:
    var count = 0
    for inst in block.instructions:
        match inst.kind:
            case Intrinsic(_, name, _):
                if name == "bounds_check":
                    count = count + 1
            case _:
                ()
    count

fn _co_count_copy_from(block: MirBlock, src_id: i64) -> i64:
    var count = 0
    for inst in block.instructions:
        match inst.kind:
            case Copy(_, src):
                if src.id == src_id:
                    count = count + 1
            case _:
                ()
    count

fn _co_count_binop(block: MirBlock, expected: MirBinOp) -> i64:
    var count = 0
    for inst in block.instructions:
        match inst.kind:
            case BinOp(_, op, _, _):
                if op == expected:
                    count = count + 1
            case _:
                ()
    count

fn _co_count_bitcast(block: MirBlock) -> i64:
    var count = 0
    for inst in block.instructions:
        match inst.kind:
            case Bitcast(_, _, _):
                count = count + 1
            case _:
                ()
    count

describe "MIR Collection Optimization":
    it "REQ-MIR-COLLOPT-046 does not skip a length consumer that redefines the receiver":
        val first = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        val second = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        val redefine = MirInst(kind: MirInstKind.BinOp(_co_lid(1), MirBinOp.Add, _co_copy(11), _co_int(1)), span: nil)
        val third = MirInst(kind: MirInstKind.Call(_co_lid(12), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_len_queries_block(_co_block([first, second, redefine, third]))
        expect(_co_count_rt_array_len(block)).to_equal(2)
        expect(_co_count_binop(block, MirBinOp.Add)).to_equal(1)
        expect(opt.len_queries_reused).to_equal(1)

    it "REQ-MIR-COLLOPT-047 handles length destinations that overwrite their receiver":
        val first = MirInst(kind: MirInstKind.Call(_co_lid(1), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        val second = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_len_queries_block(_co_block([first, second]))
        expect(_co_count_rt_array_len(block)).to_equal(2)
        expect(opt.len_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-048 fences reads across unknown intrinsics and drops":
        val barriers = [MirInst(kind: MirInstKind.Intrinsic(nil, "unknown_effect", [_co_copy(1)]), span: nil),
            MirInst(kind: MirInstKind.Drop(_co_lid(1)), span: nil)]
        for barrier in barriers:
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_pure_queries_block(_co_block([
                _co_query(10, [_co_copy(1), _co_copy(2)]), barrier,
                _co_query(11, [_co_copy(1), _co_copy(2)])]))
            expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
            expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-049 does not use formatted float text as exact constant identity":
        val positive = MirOperand(kind: MirOperandKind.Const(MirConstValue.Float(0.0), MirType(kind: MirTypeKind.F64)))
        val negative = MirOperand(kind: MirOperandKind.Const(MirConstValue.Float(-0.0), MirType(kind: MirTypeKind.F64)))
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_copy(1), positive]), _co_query(11, [_co_copy(1), negative])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-050 rejects argument-vector arity collisions":
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_string("a:const:str:b")]),
            _co_query(11, [_co_string("a"), _co_string("b")])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-044 does not infer runtime authority from an rt name":
        var opt = create_collection_opt_pass()
        val reads = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_copy(1), _co_copy(2)]), _co_query(11, [_co_copy(1), _co_copy(2)])]))
        expect(_co_count_named_call(reads, "rt_array_get")).to_equal(2)
        val first = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        val second = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
        val lengths = opt.canonicalize_collection_len_queries_block(_co_block([first, second]))
        expect(_co_count_rt_array_len(lengths)).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)
        expect(opt.len_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-045 replaces authority without admitting unknown names":
        var opt = _co_admitted_pass()
        opt.admit_collection_runtime_reads(["rt_array_len", "get", "user_query"])
        val reads = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_copy(1), _co_copy(2)]), _co_query(11, [_co_copy(1), _co_copy(2)])]))
        expect(_co_count_named_call(reads, "rt_array_get")).to_equal(2)
        val user_first = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("get"), [_co_copy(1)]), span: nil)
        val user_second = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("get"), [_co_copy(1)]), span: nil)
        val users = opt.canonicalize_collection_pure_queries_block(_co_block([user_first, user_second]))
        expect(_co_count_named_call(users, "get")).to_equal(2)

    it "REQ-MIR-COLLOPT-032 retains distinct aggregate constant queries":
        val left_values = [MirConstValue.Array([MirConstValue.Int(1)]),
            MirConstValue.Tuple([MirConstValue.Int(1)]), MirConstValue.Struct({"x": MirConstValue.Int(1)})]
        val right_values = [MirConstValue.Array([MirConstValue.Int(2)]),
            MirConstValue.Tuple([MirConstValue.Int(2)]), MirConstValue.Struct({"x": MirConstValue.Int(2)})]
        val types = [MirType(kind: MirTypeKind.Array(MirType.i64(), 1)),
            MirType(kind: MirTypeKind.Tuple([MirType.i64()])), MirType(kind: MirTypeKind.Struct(SymbolId(id: 42)))]
        for index in 0..3:
            val left = MirOperand(kind: MirOperandKind.Const(left_values[index], types[index]))
            val right = MirOperand(kind: MirOperandKind.Const(right_values[index], types[index]))
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_pure_queries_block(_co_block([
                _co_query(10, [left, _co_int(0)]), _co_query(11, [right, _co_int(0)])]))
            expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
            expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-033 frames string payloads and argument boundaries":
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_string("a:const:str:b"), _co_string("c")]),
            _co_query(11, [_co_string("a"), _co_string("b:const:str:c")])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-034 reuses equal supported scalar and string constants":
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_string("x:const:str:y"), _co_int(7)]),
            _co_query(11, [_co_string("x:const:str:y"), _co_int(7)])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(1)
        expect(_co_count_copy_from(block, 10)).to_equal(1)
        expect(opt.pure_queries_reused).to_equal(1)

    it "REQ-MIR-COLLOPT-035 distinguishes identical constant payloads with different types":
        val unsigned = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(7), MirType(kind: MirTypeKind.U64)))
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_copy(1), _co_int(7)]), _co_query(11, [_co_copy(1), unsigned])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-036 invalidates receiver index and cached result definitions":
        for changed_local in [1, 2, 10]:
            val redefine = MirInst(kind: MirInstKind.Const(_co_lid(changed_local), MirConstValue.Int(99), MirType.i64()), span: nil)
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_pure_queries_block(_co_block([
                _co_query(10, [_co_copy(1), _co_copy(2)]), redefine,
                _co_query(11, [_co_copy(1), _co_copy(2)])]))
            expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
            expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-037 tracks a known runtime query overwriting a dependency":
        for changed_local in [1, 2, 10]:
            val overwrite = MirInst(kind: MirInstKind.Call(_co_lid(changed_local), _co_func("rt_array_len"), [_co_copy(3)]), span: nil)
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_pure_queries_block(_co_block([
                _co_query(10, [_co_copy(1), _co_copy(2)]), overwrite,
                _co_query(11, [_co_copy(1), _co_copy(2)])]))
            expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
            expect(_co_count_rt_array_len(block)).to_equal(1)
            expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-038 treats bare and unknown calls as query barriers":
        for name in ["contains", "get", "user_query"]:
            val unknown = MirInst(kind: MirInstKind.Call(_co_lid(20), _co_func(name), [_co_copy(1)]), span: nil)
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_pure_queries_block(_co_block([
                _co_query(10, [_co_copy(1), _co_copy(2)]), unknown,
                _co_query(11, [_co_copy(1), _co_copy(2)])]))
            expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
            expect(_co_count_named_call(block, name)).to_equal(1)
            expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-039 retains consuming query operands":
        val moving = MirOperand(kind: MirOperandKind.Move(_co_lid(1)))
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [moving, _co_int(0)]), _co_query(11, [moving, _co_int(0)])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-040 invalidates a consumed cached result":
        val consume = MirInst(kind: MirInstKind.Move(_co_lid(20), _co_lid(10)), span: nil)
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(10, [_co_copy(1), _co_copy(2)]), consume,
            _co_query(11, [_co_copy(1), _co_copy(2)])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-041 revalidates length receiver and result definitions":
        for changed_local in [1, 10]:
            val first = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
            val redefine = MirInst(kind: MirInstKind.Const(_co_lid(changed_local), MirConstValue.Int(99), MirType.i64()), span: nil)
            val second = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("rt_array_len"), [_co_copy(1)]), span: nil)
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_len_queries_block(_co_block([first, redefine, second]))
            expect(_co_count_rt_array_len(block)).to_equal(2)
            expect(opt.len_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-042 never caches unsupported or consuming length keys":
        val unsupported = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Array([MirConstValue.Int(1)]), MirType(kind: MirTypeKind.Array(MirType.i64(), 1))))
        val operands = [unsupported, _co_copy(-1), MirOperand(kind: MirOperandKind.Move(_co_lid(1)))]
        for operand in operands:
            val first = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("rt_array_len"), [operand]), span: nil)
            val second = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("rt_array_len"), [operand]), span: nil)
            var opt = _co_admitted_pass()
            val block = opt.canonicalize_collection_len_queries_block(_co_block([first, second]))
            expect(_co_count_rt_array_len(block)).to_equal(2)
            expect(opt.len_queries_reused).to_equal(0)

    it "REQ-MIR-COLLOPT-043 invalidates self-overwriting query arguments":
        var opt = _co_admitted_pass()
        val block = opt.canonicalize_collection_pure_queries_block(_co_block([
            _co_query(1, [_co_copy(1), _co_copy(2)]), _co_query(11, [_co_copy(1), _co_copy(2)])]))
        expect(_co_count_named_call(block, "rt_array_get")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "identifies text pointers without nested enum pattern binding":
        # @req REQ-MIR-COLLOPT-001
        # @capture(bit_table): outcome of "identifies text pointers without nested enum pattern binding"
        step("Identifies text pointers without nested enum pattern binding")
        expect(mir_type_is_text(MirType.ptr(MirType(kind: MirTypeKind.I8), false))).to_equal(true)
        expect(mir_type_is_text(MirType.ptr(MirType.i64(), false))).to_equal(false)
        expect(mir_type_is_text(MirType.i64())).to_equal(false)

    it "retains legacy method classification without using it as a CSE proof":
        # @req REQ-MIR-COLLOPT-002
        # @capture(bit_table): outcome of "retains legacy method classification without using it as a CSE proof"
        step("Inspect legacy classification separately from CSE admission")
        var opt = _co_admitted_pass()

        expect(opt.is_pure_method("contains")).to_equal(true)
        expect(opt.is_pure_method("has")).to_equal(true)
        expect(opt.is_pure_method("size")).to_equal(true)
        expect(opt.is_pure_method("get")).to_equal(true)
        expect(opt.is_pure_method("contains_key")).to_equal(true)
        expect(opt.is_pure_method("is_subset")).to_equal(true)
        expect(opt.is_pure_method("is_superset")).to_equal(true)
        expect(opt.is_pure_method("is_disjoint")).to_equal(true)
        expect(opt.is_collection_runtime_read("rt_array_get")).to_equal(true)
        expect(opt.is_pure_method("insert")).to_equal(false)

    it "retains repeated bare set relationship calls without a purity proof":
        # @req REQ-MIR-COLLOPT-003
        # @capture(bit_table): outcome of "retains repeated bare set relationship calls without a purity proof"
        step("Retains repeated bare set relationship calls without a purity proof")
        val subset1 = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("is_subset"), [_co_copy(1), _co_copy(2)]), span: nil)
        val cmp = MirInst(kind: MirInstKind.BinOp(_co_lid(20), MirBinOp.Eq, _co_copy(10), _co_copy(3)), span: nil)
        val subset2 = MirInst(kind: MirInstKind.Call(_co_lid(11), _co_func("is_subset"), [_co_copy(1), _co_copy(2)]), span: nil)
        val disjoint1 = MirInst(kind: MirInstKind.Call(_co_lid(12), _co_func("is_disjoint"), [_co_copy(1), _co_copy(4)]), span: nil)
        val disjoint2 = MirInst(kind: MirInstKind.Call(_co_lid(13), _co_func("is_disjoint"), [_co_copy(1), _co_copy(4)]), span: nil)
        val func = _co_function([_co_block([subset1, cmp, subset2, disjoint1, disjoint2])])

        var opt = _co_admitted_pass()
        val optimized = opt.optimize_function(func)
        val block = optimized.blocks[0]

        expect(_co_count_named_call(block, "is_subset")).to_equal(2)
        expect(_co_count_named_call(block, "is_disjoint")).to_equal(2)
        expect(opt.pure_queries_reused).to_equal(0)

    it "retains repeated bare has calls without a purity proof":
        # @req REQ-MIR-COLLOPT-004
        # @capture(bit_table): outcome of "retains repeated bare has calls without a purity proof"
        step("Retains repeated bare has calls without a purity proof")
        val has1 = MirInst(kind: MirInstKind.Call(_co_lid(10), _co_func("has"), [_co_copy(1), _co_copy(2)]), span: nil)
        val cmp = MirInst(kind: MirInstKind.BinOp(_co_lid(20), MirBinOp.Eq, _co_copy(10), _co_copy(3)), span: nil)
