"""
## Purpose and audience
Purpose: Prove that PatternRulePass.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-MIR-OPT-001 — stable requirement identity for this spec.

# @cover src/compiler/60.mir_opt/mir_opt/pattern/pattern_rule_pass.spl 80%
"""
# PatternRulePass Specification

**Feature IDs:** #web-server-optimizer-complete
**Category:** Compiler / MIR Optimization — Rule Engine
**Difficulty:** 3/5
**Status:** Draft

## Overview

Validates the data-driven PatternRule schema model which loads `.opt.json`
rule files and retains named pattern/rewrite metadata. Production MIR
execution remains quarantined until legality proofs exist. The AC-7 schema extends `simple.opt.mir.v1` with an
optional `rules: [PatternRule]` array.

## Behavior

- Rule file with valid schema is loaded without error
- Pattern matching finds the expected instruction sequence
- Rewrite metadata is retained; the production pass returns MIR unchanged
- Opaque rewrite metadata remains loadable for v1 compatibility
- Cost metadata is retained but does not authorize application
"""

use std.spec


# ============================================================================
# Stub types mirroring PatternRule / PatternRulePass
# ============================================================================

class PatternRule:
    name: text
    pattern: text
    rewrite: text
    cost_delta: i64

class RuleLoadResult:
    ok: bool
    error_msg: text
    rules: List<PatternRule>

fn load_opt_json(schema_version: text, rules_raw: List<PatternRule>) -> RuleLoadResult:
    # The production v1 loader retains rule metadata without treating its
    # free-form pattern text as a legality proof.
    if schema_version != "simple.opt.mir.v1":
        RuleLoadResult(ok: false, error_msg: "unknown schema: " + schema_version, rules: [])
    else:
        RuleLoadResult(ok: true, error_msg: "", rules: rules_raw)

fn find_pattern(instructions: List<text>, pattern_opcode: text) -> i64:
    # Returns index of first matching instruction or -1.
    var i = 0
    while i < instructions.len():
        val inst = instructions[i]
        if inst.contains(pattern_opcode):
            return i
        i = i + 1
    -1

fn apply_rewrite(instructions: List<text>, match_idx: i64, rewrite: text) -> List<text>:
    # Compatibility metadata cannot authorize a production MIR mutation.
    instructions


# ============================================================================
# PatternRulePass tests
# ============================================================================

describe "PatternRulePass":

    describe "rule file loading":

        it "loads .opt.json rule file and validates schema":
            step("Verify: loads .opt.json rule file and validates schema")
            # @req: REQ-COMPILER-MIR-OPT-001
            val rules = [
                PatternRule(
                    name: "add_zero_elim",
                    pattern: "BinOp:Add(%x, 0)",
                    rewrite: "Copy(%x)",
                    cost_delta: -1
                )
            ]
            val result = load_opt_json("simple.opt.mir.v1", rules)
            expect(result.ok).to_equal(true)
            expect(result.rules.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "retains opaque rule metadata for v1 compatibility":
            step("Verify: retains opaque rule metadata for v1 compatibility")
            val bad_rules = [
                PatternRule(
                    name: "bad_rule",
                    pattern: "",
                    rewrite: "Nop",
                    cost_delta: 0
                )
            ]
            val result = load_opt_json("simple.opt.mir.v1", bad_rules)
            expect(result.ok).to_equal(true)
            expect(result.rules.len()).to_equal(1)

        it "rejects file with unknown schema version":
            step("Verify: rejects file with unknown schema version")
            val rules: List<PatternRule> = []
            val result = load_opt_json("simple.opt.mir.v99", rules)
            expect(result.ok).to_equal(false)
            expect(result.error_msg).to_contain("unknown schema")

    describe "pattern matching":

        it "matches MIR pattern against instruction sequence":
            step("Verify: matches MIR pattern against instruction sequence")
            val instructions = [
                "Load %ptr",
                "BinOp:Add %a 0",
                "Store %dst"
            ]
            val match_idx = find_pattern(instructions, "BinOp:Add")
            expect(match_idx).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "returns -1 when pattern is not present in sequence":
            step("Verify: returns -1 when pattern is not present in sequence")
            val instructions = ["Load %ptr", "Store %dst"]
            val match_idx = find_pattern(instructions, "BinOp:Mul")
            expect(match_idx).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    describe "rewrite application":

        it "quarantines rewrite metadata and preserves instructions":
            step("Verify: quarantines rewrite metadata and preserves instructions")
            val instructions = ["Load %ptr", "BinOp:Add %a 0", "Store %dst"]
            val match_idx = 1
            val rewritten = apply_rewrite(instructions, match_idx, "Copy %a")
            expect(rewritten.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(rewritten[1]).to_equal("BinOp:Add %a 0")
            expect(rewritten[0]).to_equal("Load %ptr")
            expect(rewritten[2]).to_equal("Store %dst")

    describe "cost reporting":

        it "retains cost delta without authorizing a rewrite":
            step("Verify: retains cost delta without authorizing a rewrite")
            val rule = PatternRule(
                name: "strength_reduce_mul2",
                pattern: "BinOp:Mul(%x, 2)",
                rewrite: "BinOp:Shl(%x, 1)",
                cost_delta: -2
            )
            expect(rule.cost_delta).to_equal(-2)  # oracle: -2 — named expected value from the requirement
            expect(rule.cost_delta).to_be_less_than(0)
