# Pattern Rule Engine + Cipher Rule Table — Schema Contract Tests
#
# Feature ID: #COMPILER-MIROPT-PATTERN-ENGINE
# Category:   Compiler | MIR Optimization | Pattern Rule Engine
# Status:     Schema only — Rule struct fields, cipher_rule_table registry,
#             lookup_rule_for_callee dispatch, PatternCost comparator
#
# Interpreter-mode note (per .claude/rules/testing.md):
#   The test runner in interpreter mode only verifies file loading and
#   describe/it block reachability.  The assertions inside it-blocks are not
#   executed.  Compiled-mode execution will exercise them.

use compiler.mir_opt.pattern.rule_engine.{
    Rule, MatchHit, OptimizerRuleLoadMode, OptimizerRuleLookupKind, OptimizerProviderKind,
    OptimizationRuleProvider, create_rule, rule_summary,
    optimization_rule_provider_builtin_with_contract,
    optimization_rule_provider_dynamic, optimization_rule_provider_should_embed,
    optimization_rule_provider_uses_direct_lookup, create_exact_rule_binding,
    optimization_rule_provider_is_pipeline_pass, optimization_rule_provider_has_required_fact,
    optimization_fact_list_contains, optimization_rule_provider_missing_fact,
    optimization_rule_provider_can_run,
    lookup_exact_rule_binding, rule_lookup_stats_zero,
    rule_lookup_stats_record, optimization_provider_stats_zero,
    optimization_provider_stats_record_scope
}
use compiler.mir_opt.pattern.rules_crypto.{
    cipher_rule_table, cipher_rule_provider, lookup_rule_for_callee
}
use compiler.mir_opt.pattern.cost_model.{
    PatternCost, pattern_cost_default, pattern_cost_better, pattern_cost_total
}
use compiler.mir.intrinsics.{
    CRYPTO_AES_ROUND, CRYPTO_SHA256_RNDS2, CRC32_U64
}

# ============================================================================
# Rule schema — create_rule + rule_summary
# ============================================================================

describe "Rule schema — create_rule + rule_summary":
    it "create_rule fills name, intrinsic, requires, cost_delta correctly":
        val r = create_rule("test_rule_aes", "crypto_aes_round", "aes", -3)
        expect r.name == "test_rule_aes"
        expect r.intrinsic == "crypto_aes_round"
        expect r.required_fact == "aes"
        expect r.cost_delta == -3

    it "rule_summary contains rule name and intrinsic substring":
        val r = create_rule("match_aes_round_software", "crypto_aes_round", "aes", -3)
        val summary = rule_summary(r)
        expect summary.len() > 0 == true
        expect (summary).contains("match_aes_round_software")
        expect (summary).contains("crypto_aes_round")

# ============================================================================
# cipher_rule_table — registry contents
# ============================================================================

describe "cipher_rule_table — registry contents":
    it "returns at least 5 rules":
        val table = cipher_rule_table()
        expect table.len() >= 5 == true

    it "each rule has non-empty name, non-empty intrinsic, non-empty requires":
        val table = cipher_rule_table()
        var i = 0
        while i < table.len():
            val r = table[i]
            expect r.name.len() > 0 == true
            expect r.intrinsic.len() > 0 == true
            expect r.required_fact.len() > 0 == true
            i = i + 1

    it "first rule is the AES round rule with intrinsic crypto_aes_round":
        val table = cipher_rule_table()
        val first = table[0]
        expect first.intrinsic == CRYPTO_AES_ROUND

    it "each rule cost_delta is negative (cheaper than scalar software)":
        val table = cipher_rule_table()
        var i = 0
        while i < table.len():
            val r = table[i]
            expect r.cost_delta < 0 == true
            i = i + 1

# ============================================================================
# lookup_rule_for_callee — known and unknown callees
# ============================================================================

describe "lookup_rule_for_callee — known software callees":
    it "aes_round_software callee returns Some(rule) with intrinsic crypto_aes_round":
        val result = lookup_rule_for_callee("std.common.aes.cipher.aes_round_software")
        expect result != nil
        val r = result.unwrap()
        expect r.intrinsic == CRYPTO_AES_ROUND

    it "sha256 compress_block callee returns Some with crypto_sha256_rounds2":
        val result = lookup_rule_for_callee("std.common.crypto.sha256.compress_block")
        expect result != nil
        val r = result.unwrap()
        expect r.intrinsic == CRYPTO_SHA256_RNDS2

    it "os crc32 update_u64 callee returns Some with crc32_u64":
        val result = lookup_rule_for_callee("os.crypto.crc32.update_u64")
        expect result != nil
        val r = result.unwrap()
        expect r.intrinsic == CRC32_U64

    it "unrecognised symbol returns nil":
        val result = lookup_rule_for_callee("std.common.totally.unknown.callee")
        expect result == nil

    it "cipher provider is built in for hot-path lookup":
        val provider = cipher_rule_provider()
        expect provider.name == "cipher-pattern-rules"
        expect provider.version == "1.0.0"
        expect provider.kind == OptimizerProviderKind.Pattern
        expect provider.load_mode == OptimizerRuleLoadMode.Builtin
        expect provider.lookup_kind == OptimizerRuleLookupKind.DirectExact
        expect optimization_rule_provider_should_embed(provider) == true
        expect optimization_rule_provider_uses_direct_lookup(provider) == true
        expect provider.safety_class == "pure"

    it "dynamic providers are not embedded into the hot lookup path":
        val provider = optimization_rule_provider_dynamic("rare-extra-rules", "build/plugins/rare-rules.so")
        expect provider.load_mode == OptimizerRuleLoadMode.DynamicLibrary
        expect provider.lookup_kind == OptimizerRuleLookupKind.DynamicExact
        expect optimization_rule_provider_should_embed(provider) == false
        expect provider.safety_class == "experimental"

    it "pipeline providers declare facts and are distinguishable from direct lookup providers":
        val provider = optimization_rule_provider_builtin_with_contract(
            "simple.opt.server.io",
            OptimizerProviderKind.Mir,
            OptimizerRuleLookupKind.PipelinePass,
            true,
            ["typed_mir", "io_alias_summary"],
            ["canonical_mir"],
            "pure"
        )
        expect provider.name == "simple.opt.server.io"
        expect provider.kind == OptimizerProviderKind.Mir
        expect optimization_rule_provider_is_pipeline_pass(provider) == true
        expect optimization_rule_provider_has_required_fact(provider, "io_alias_summary") == true
        expect optimization_rule_provider_has_required_fact(provider, "missing_fact") == false

    it "provider planning rejects missing facts without changing semantics":
        val provider = optimization_rule_provider_builtin_with_contract(
            "simple.opt.server.io",
            OptimizerProviderKind.Mir,
            OptimizerRuleLookupKind.PipelinePass,
            true,
            ["typed_mir", "io_alias_summary"],
            ["canonical_mir"],
            "pure"
        )
        expect optimization_fact_list_contains(["typed_mir"], "typed_mir") == true
        expect optimization_rule_provider_can_run(provider, ["typed_mir"]) == false
        val missing = optimization_rule_provider_missing_fact(provider, ["typed_mir"])
        expect missing != nil
        expect missing.unwrap() == "io_alias_summary"
        expect optimization_rule_provider_can_run(provider, ["typed_mir", "io_alias_summary"]) == true

    it "exact lookup bindings support reusable non-cipher rule providers":
        val rule = create_rule("match_custom_abs", "math_abs", "scalar", -1)
        val bindings = [create_exact_rule_binding("std.math.abs_software", rule)]
        val hit = lookup_exact_rule_binding(bindings, "std.math.abs_software")
        expect hit != nil
        expect hit.unwrap().intrinsic == "math_abs"
        val miss = lookup_exact_rule_binding(bindings, "std.math.sqrt")
        expect miss == nil

    it "lookup stats count hit and miss without touching rule data":
        val zero = rule_lookup_stats_zero()
        val one = rule_lookup_stats_record(zero, true)
        val two = rule_lookup_stats_record(one, false)
        expect two.lookups == 2
        expect two.hits == 1
        expect two.misses == 1

    it "provider stats count changed and skipped scopes":
        val zero = optimization_provider_stats_zero()
        val changed = optimization_provider_stats_record_scope(zero, 3)
        val skipped = optimization_provider_stats_record_scope(changed, 0)
        expect skipped.scopes == 2
        expect skipped.rewrites == 3
        expect skipped.skipped == 1

# ============================================================================
# PatternCost — comparator and scalar summary
# ============================================================================

describe "PatternCost — comparator":
    it "lower-latency cost ranks better than higher-latency":
        val cheap = PatternCost(latency: 2, code_size: 0, reg_pressure: 0, tail_cost: 0)
        val expensive = PatternCost(latency: 8, code_size: 0, reg_pressure: 0, tail_cost: 0)
        expect pattern_cost_better(cheap, expensive) == true
        expect pattern_cost_better(expensive, cheap) == false

    it "identical costs are not better than each other":
        val a = PatternCost(latency: 4, code_size: 1, reg_pressure: 2, tail_cost: 0)
        val b = PatternCost(latency: 4, code_size: 1, reg_pressure: 2, tail_cost: 0)
        expect pattern_cost_better(a, b) == false

    it "pattern_cost_total weights latency more than reg_pressure":
        val high_latency = PatternCost(latency: 4, code_size: 0, reg_pressure: 0, tail_cost: 0)
        val high_pressure = PatternCost(latency: 0, code_size: 0, reg_pressure: 4, tail_cost: 0)
        # latency weight=4, reg_pressure weight=2 → 4*4=16 vs 4*2=8
        val total_lat = pattern_cost_total(high_latency)
        val total_pres = pattern_cost_total(high_pressure)
        expect total_lat > total_pres == true

    it "pattern_cost_default returns a zero-cost tuple":
        val c = pattern_cost_default()
        expect c.latency == 0
        expect c.code_size == 0
        expect c.reg_pressure == 0
        expect c.tail_cost == 0

    it "pattern_cost_total of default is zero":
        val c = pattern_cost_default()
        expect pattern_cost_total(c) == 0
