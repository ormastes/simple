"""Fail-closed contracts for disabled general loop transforms."""
# @req: REQ-COMPILER-MIR-OPT-001

use std.spec.*
use std.fs.{read_file}

describe "general loop transform skeletons":
    it "contains no LICM preheader synthesis or instruction movement":
        val source = read_file("src/compiler/60.mir_opt/mir_opt/loop_licm.spl")
        expect(source).not.to_contain("redirect_to_preheader")
        expect(source).not.to_contain("invariant_insts")
        expect(source).not.to_contain("preheader_id")

    it "contains no unroll duplication or combined direct-call chain":
        val source = read_file("src/compiler/60.mir_opt/mir_opt/loop_opt.spl")
        expect(source).not.to_contain("body_insts")
        expect(source).not.to_contain("partial_unroll_loop(optimized_blocks")
        expect(source).not.to_contain("current = self.licm.optimize_function")
        expect(source).not.to_contain("current = self.unroller.optimize_function")
