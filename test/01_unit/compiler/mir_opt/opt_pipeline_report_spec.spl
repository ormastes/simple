"""
## Purpose and audience
Purpose: Pin deterministic requested/effective optimizer planning records.
Audience: compiler, CI, and tooling maintainers.
"""
# @req: REQ-002, REQ-003, REQ-004

use std.spec.*
use compiler.mir_opt.mir_opt.mod.{
    OptLevel, optimizationpipeline_report_json
}

describe "optimizer pipeline machine report":
    it "reports requested effective status backend and not-run outcome distinctly":
        step("Load the effective optimizer pipeline")
        val report = optimizationpipeline_report_json(OptLevel.Speed, "cranelift", "high")
        expect(report).to_start_with("{\"schema\":\"simple.opt-pipeline-report/v1\"")
        expect(report).to_contain("\"requested_name\":\"dead_code_elimination\"")
        expect(report).to_contain("\"status\":\"skeleton\"")
        expect(report).to_contain("\"requested_name\":\"collection_opt\"")
        expect(report).to_contain("\"status_reason\":\"ownership, alias, effect, and semantic-equivalence proofs incomplete\"")
        expect(report).to_contain("\"run_outcome\":\"not-run\"")
        expect(report).to_contain("\"functions_seen\":null")

    it "records LLVM backend delegation as a typed outcome":
        step("Explain an unavailable effective pass")
        val report = optimizationpipeline_report_json(OptLevel.Aggressive, "llvm", "high")
        expect(report).to_contain("\"requested_name\":\"predicate_promote\"")
        expect(report).to_contain("\"backend_outcome\":\"delegated\"")
        expect(report).to_contain("\"backend_reason\":\"llvm_runs_if_conversion_and_select_promotion\"")

    it "preserves canonical requested occurrence order":
        step("Compare deterministic optimizer inventory")
        val first = optimizationpipeline_report_json(OptLevel.Size, "cranelift", "medium")
        val second = optimizationpipeline_report_json(OptLevel.Size, "cranelift", "medium")
        expect(first).to_equal(second)
        expect(first).to_contain("\"ordinal\":0")
        expect(first).to_contain("\"ordinal\":8")
