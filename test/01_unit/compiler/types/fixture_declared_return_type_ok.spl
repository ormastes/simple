# Control fixture for declared_return_type_not_enforced_2026-08-09.
#
# Identical in shape to fixture_declared_return_type_violation.spl, but the
# return value actually matches the declared type. This is the control arm: it
# must compile and run cleanly under EVERY profile, including the enforcing
# ones. Without it, a "no diagnostic" assertion cannot distinguish a working
# checker from a checker that never ran.

fn ret_bool() -> bool:
    return true

fn main():
    val b = ret_bool()
    print("ret_bool => " + b.to_text())
