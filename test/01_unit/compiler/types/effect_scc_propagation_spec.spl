use std.spec.*
use compiler.types.type_system.*

fn effect_scc_function(
    name: text,
    is_async: bool,
    calls: [text]
) -> FunctionInfo:
    FunctionInfo(
        name: name,
        is_sync: false,
        has_async_annotation: is_async,
        contains_suspension: false,
        called_functions: calls
    )

describe "SCC effect propagation":
    it "propagates an external async effect across a multi-node component":
        val functions = [
            effect_scc_function("source", true, []),
            effect_scc_function("alpha", false, ["beta", "source"]),
            effect_scc_function("beta", false, ["gamma"]),
            effect_scc_function("gamma", false, ["alpha"]),
            effect_scc_function("independent", false, [])
        ]

        val effects = propagate_effects_transitive(functions)

        expect(effects["alpha"] == Effect.Async).to_be(true)
        expect(effects["beta"] == Effect.Async).to_be(true)
        expect(effects["gamma"] == Effect.Async).to_be(true)
        expect(effects["independent"] == Effect.Sync).to_be(true)
