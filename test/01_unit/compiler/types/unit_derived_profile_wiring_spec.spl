# Unit derived-op profile wiring (RB6): the active diagnostic profile selects
# unit_ops strict mode through the SPL-UNIT-004 policy row, and default-mode
# SPL-UNIT-004 warnings are drained into typecheck diagnostics.
use std.spec
use compiler.core.types.{reset_all_pools}
use std.nogc_sync_mut.io.env_ops.{cwd}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_write, secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use compiler.core.parser.{parser_init_with_path}
use compiler.core.parser_decls.{parse_module_body}
use compiler.common.diagnostics.diagnostic_rule_policy.{DiagnosticPolicySnapshot}
use compiler.types.units.unit_ops.{UnitOpVerdict, unit_op_verdict, unit_op_default_profile, unit_op_take_warnings}
use compiler.driver.driver_unit_profile.{
    unit_profile_strict_for, unit_profile_strict_for_edition, unit_profile_policy, unit_profile_apply,
    unit_profile_apply_for_sdn, unit_profile_drain_diagnostics, unit_profile_policy_path_from
}

fn world():
    reset_all_pools()
    unit_op_default_profile()
    unit_op_take_warnings()
    parser_init_with_path("unit Hertz: f64 as hz\nunit Meter: f64 as m\nunit Second: f64 as s\nunit Speed = Meter / Second\n", "wiring_world.spl")
    parse_module_body()

fn v(op: text, l: text, r: text) -> text:
    match unit_op_verdict(op, l, r):
        case NotUnit: "notunit"
        case Allow(x): "allow:" + x
        case Deny(m): if m.starts_with("SPL-UNIT-004"): "deny4" else: "deny"

describe "SPL-UNIT-004 profile wiring":
    it "policy row selects strict mode for robust/critical/verified only":
        val p = unit_profile_policy()
        expect(p.?).to_equal(true)
        expect(unit_profile_strict_for(p, "")).to_equal(false)
        expect(unit_profile_strict_for(p, "moderate")).to_equal(false)
        expect(unit_profile_strict_for(p, "strict")).to_equal(false)
        expect(unit_profile_strict_for(p, "robust")).to_equal(true)
        expect(unit_profile_strict_for(p, "reliable")).to_equal(true)
        expect(unit_profile_strict_for(p, "critical")).to_equal(true)
        expect(unit_profile_strict_for(p, "verified")).to_equal(true)

    # Fable #9845 (#9965): a missing policy must not silently downgrade an
    # assured profile (fail closed); default/moderate/strict keep warning mode.
    it "no policy snapshot fails closed for robust/critical/verified":
        val none: DiagnosticPolicySnapshot? = None
        expect(unit_profile_strict_for(none, "robust")).to_equal(true)
        expect(unit_profile_strict_for(none, "reliable")).to_equal(true)
        expect(unit_profile_strict_for(none, "critical")).to_equal(true)
        expect(unit_profile_strict_for(none, "verified")).to_equal(true)
        expect(unit_profile_strict_for(none, "")).to_equal(false)
        expect(unit_profile_strict_for(none, "moderate")).to_equal(false)
        expect(unit_profile_strict_for(none, "strict")).to_equal(false)
        expect(unit_profile_strict_for_edition(none, "robust", "2027.2")).to_equal(true)

    it "policy path resolves from a subdirectory of the repo, not only cwd":
        val root = cwd()
        val p = unit_profile_policy_path_from(root + "/test/01_unit/compiler")
        expect(p.ends_with("config/policy/diagnostic_policy.sdn")).to_equal(true)
        expect(file_exists(p)).to_equal(true)

    it "applying the robust profile denies an undeclared quotient":
        world()
        val dir = secure_temp_dir(".", "unit-profile-wiring-robust").unwrap()
        val sdn = dir + "/simple.sdn"
        file_write(sdn, "project:\n  name: demo\n  edition: 2026.11\n")
        unit_profile_apply_for_sdn("robust", sdn)
        expect(v("div", "Hertz", "Hertz")).to_equal("deny4")
        expect(v("div", "Meter", "Second")).to_equal("allow:Speed")
        unit_profile_apply_for_sdn("", sdn)
        expect(v("div", "Hertz", "Hertz")).to_equal("allow:f64")
        unit_op_take_warnings()
        dir_remove_all(dir)

    it "default-mode warnings drain into tagged typecheck diagnostics once":
        world()
        val dir = secure_temp_dir(".", "unit-profile-wiring-warn").unwrap()
        val sdn = dir + "/simple.sdn"
        file_write(sdn, "project:\n  name: demo\n  edition: 2026.11\n")
        unit_profile_apply_for_sdn("", sdn)
        expect(v("mul", "Hertz", "Hertz")).to_equal("allow:f64")
        val d = unit_profile_drain_diagnostics("app.main")
        expect(d.len()).to_equal(1)
        expect(d[0].starts_with("[unit SPL-UNIT-004] app.main: ")).to_equal(true)
        expect(d[0].contains("unit <Name> = Hertz * Hertz")).to_equal(true)
        expect(unit_profile_drain_diagnostics("app.main").len()).to_equal(0)
        dir_remove_all(dir)

    it "SPL-UNIT-002 distinct-unit product is an error in compiled code for every profile (owner Q1=b)":
        world()
        for profile in ["", "moderate", "robust", "critical", "verified"]:
            step("profile " + profile)
            unit_profile_apply(profile)
            expect(v("mul", "Hertz", "Second")).to_equal("deny")
            expect(v("div", "Hertz", "Second")).to_equal("deny")
            expect(unit_profile_drain_diagnostics("app.main").len()).to_equal(0)
        unit_profile_apply("")

    it "script mode (CompileMode.Interpret) drains SPL-UNIT-002 as a warning with its own code":
        world()
        unit_profile_apply("", true)
        expect(v("mul", "Hertz", "Second")).to_equal("allow:f64")
        val d = unit_profile_drain_diagnostics("app.main")
        expect(d.len()).to_equal(1)
        expect(d[0].starts_with("[unit SPL-UNIT-002] app.main: ")).to_equal(true)
        expect(d[0].contains("unit <Name> = Hertz * Second")).to_equal(true)
        step("add/sub of distinct units stay errors in script mode")
        expect(v("add", "Hertz", "Second")).to_equal("deny")
        expect(v("sub", "Hertz", "Second")).to_equal("deny")
        step("script mode with the robust profile: SPL-UNIT-004 strict, SPL-UNIT-002 still a warning")
        unit_profile_apply("robust", true)
        expect(v("div", "Hertz", "Hertz")).to_equal("deny4")
        expect(v("mul", "Hertz", "Second")).to_equal("allow:f64")
        expect(unit_profile_drain_diagnostics("app.main")[0].starts_with("[unit SPL-UNIT-002]")).to_equal(true)
        step("leaving script mode restores the error")
        unit_profile_apply("")
        expect(v("mul", "Hertz", "Second")).to_equal("deny")
        unit_op_take_warnings()
