# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



class HardwareAttr:
    kind: text
    is_clocked: bool
    entity_name: text
    label_count: i32
    l0_name: text
    l1_name: text

class ReturnLabel:
    name: text
    bit_width: i32
    is_output: bool

class CallLowerResult:
    success: bool
    error_reason: text
    is_indirect: bool

class BitSlice:
    source_width: i32
    high_bit: i32
    low_bit: i32
    result_width: i32

class InstructionFormat:
    format_name: text
    has_rd: bool
    has_rs1: bool
    has_rs2: bool
    imm_width: i32

class AluControl:
    op_name: text
    funct3: i32
    is_immediate: bool

class DecodeResult:
    alu_op: text
    has_writeback: bool
    mem_read: bool
    branch: bool

class RegisterFile:
    depth: i32
    width: i32
    read_ports: i32
    write_ports: i32
    has_zero_reg: bool

class MemoryInference:
    kind: text
    depth: i32
    width: i32
    is_readonly: bool
    is_synchronous: bool

class ClockDomain:
    name: text
    reset_kind: text
    is_async_reset: bool

class PortBundle:
    bundle_name: text
    port_count: i32
    p0_name: text
    p0_dir: text
    p1_name: text
    p1_dir: text

class TestbenchSpec:
    entity_name: text
    clock_period_ns: i32
    sim_cycles: i32
    has_assertions: bool

class SimulationResult:
    entity_name: text
    passed: bool
    cycles_run: i32
    ghdl_exit_code: i32

use std.spec.step

fn test_hardware_attr_kind() -> bool:
    var attr = HardwareAttr(kind: "hardware", is_clocked: false, entity_name: "alu", label_count: 0, l0_name: "", l1_name: "")
    var is_hardware = attr.kind == "hardware"
    if is_hardware:
        print("PASS: test_hardware_attr_kind")
        return true
    else:
        print("FAIL: test_hardware_attr_kind")
        return false

fn test_hardware_clocked() -> bool:
    var attr = HardwareAttr(kind: "hardware", is_clocked: true, entity_name: "reg", label_count: 0, l0_name: "", l1_name: "")
    if attr.is_clocked:
        print("PASS: test_hardware_clocked")
        return true
    else:
        print("FAIL: test_hardware_clocked")
        return false

fn test_duplicate_label() -> bool:
    var attr = HardwareAttr(kind: "hardware", is_clocked: false, entity_name: "comp", label_count: 2, l0_name: "sum", l1_name: "sum")
    var has_dup = attr.l0_name == attr.l1_name
    if has_dup:
        print("PASS: test_duplicate_label")
        return true
    else:
        print("FAIL: test_duplicate_label")
        return false

fn test_return_label_output() -> bool:
    var lbl = ReturnLabel(name: "result", bit_width: 8, is_output: true)
    var dir = "in"
    if lbl.is_output:
        dir = "out"
    if dir == "out":
        print("PASS: test_return_label_output")
        return true
    else:
        print("FAIL: test_return_label_output")
        return false

fn test_return_label_vhdl_1bit() -> bool:
    var lbl = ReturnLabel(name: "flag", bit_width: 1, is_output: true)
    if lbl.bit_width == 1:
        print("PASS: test_return_label_vhdl_1bit")
        return true
    else:
        print("FAIL: test_return_label_vhdl_1bit")
        return false

fn test_call_lower_ok() -> bool:
    var r = CallLowerResult(success: true, error_reason: "", is_indirect: false)
    if r.success:
        print("PASS: test_call_lower_ok")
        return true
    else:
        print("FAIL: test_call_lower_ok")
        return false

fn test_call_lower_indirect_reject() -> bool:
    var r = CallLowerResult(success: false, error_reason: "indirect not supported", is_indirect: true)
    var is_rejected = r.is_indirect == true and r.success == false
    if is_rejected:
        print("PASS: test_call_lower_indirect_reject")
        return true
    else:
        print("FAIL: test_call_lower_indirect_reject")
        return false

fn test_bit_slice_opcode() -> bool:
    var s = BitSlice(source_width: 32, high_bit: 6, low_bit: 0, result_width: 7)
    var valid = s.high_bit >= s.low_bit and s.result_width == (s.high_bit - s.low_bit + 1)
    if valid:
        print("PASS: test_bit_slice_opcode")
        return true
    else:
        print("FAIL: test_bit_slice_opcode")
        return false

fn test_bit_slice_funct3() -> bool:
    var s = BitSlice(source_width: 32, high_bit: 14, low_bit: 12, result_width: 3)
    var valid = s.high_bit >= s.low_bit and s.result_width == (s.high_bit - s.low_bit + 1)
    if valid:
        print("PASS: test_bit_slice_funct3")
        return true
    else:
        print("FAIL: test_bit_slice_funct3")
        return false

fn test_instruction_r_type() -> bool:
    var f = InstructionFormat(format_name: "R", has_rd: true, has_rs1: true, has_rs2: true, imm_width: 0)
    var ok = f.has_rd and f.has_rs1 and f.has_rs2 and f.imm_width == 0
    if ok:
        print("PASS: test_instruction_r_type")
        return true
    else:
        print("FAIL: test_instruction_r_type")
        return false

fn test_instruction_i_type() -> bool:
    var f = InstructionFormat(format_name: "I", has_rd: true, has_rs1: true, has_rs2: false, imm_width: 12)
    var has_immediate = f.imm_width > 0
    if has_immediate:
        print("PASS: test_instruction_i_type")
        return true
    else:
        print("FAIL: test_instruction_i_type")
        return false

fn test_alu_add() -> bool:
    var a = AluControl(op_name: "ADD", funct3: 0, is_immediate: false)
    var is_add = a.op_name == "ADD"
    if is_add:
        print("PASS: test_alu_add")
        return true
    else:
        print("FAIL: test_alu_add")
        return false

fn test_decode_load() -> bool:
    var d = DecodeResult(alu_op: "ADD", has_writeback: true, mem_read: true, branch: false)
    var is_memory = d.mem_read
    if is_memory:
        print("PASS: test_decode_load")
        return true
    else:
        print("FAIL: test_decode_load")
        return false

fn test_decode_branch() -> bool:
    var d = DecodeResult(alu_op: "SUB", has_writeback: false, mem_read: false, branch: true)
    var is_control_flow = d.branch
    if is_control_flow:
        print("PASS: test_decode_branch")
        return true
    else:
        print("FAIL: test_decode_branch")
        return false

fn test_regfile_rv32() -> bool:
    var rf = RegisterFile(depth: 32, width: 32, read_ports: 2, write_ports: 1, has_zero_reg: true)
    var is_rv32 = rf.depth == 32 and rf.width == 32 and rf.has_zero_reg
    if is_rv32:
        print("PASS: test_regfile_rv32")
        return true
    else:
        print("FAIL: test_regfile_rv32")
        return false

fn test_regfile_synthesizable() -> bool:
    var rf = RegisterFile(depth: 32, width: 32, read_ports: 2, write_ports: 1, has_zero_reg: true)
    var synthesizable = rf.read_ports == 2 and rf.write_ports == 1
    if synthesizable:
        print("PASS: test_regfile_synthesizable")
        return true
    else:
        print("FAIL: test_regfile_synthesizable")
        return false

fn test_memory_rom() -> bool:
    var m = MemoryInference(kind: "rom", depth: 1024, width: 32, is_readonly: true, is_synchronous: true)
    var is_rom = m.kind == "rom" and m.is_readonly
    if is_rom:
        print("PASS: test_memory_rom")
        return true
    else:
        print("FAIL: test_memory_rom")
        return false

fn test_clock_default() -> bool:
    var c = ClockDomain(name: "clk", reset_kind: "sync", is_async_reset: false)
    var has_reset = c.reset_kind == "none" == false
    if has_reset:
        print("PASS: test_clock_default")
        return true
    else:
        print("FAIL: test_clock_default")
        return false

fn test_port_bundle_imem() -> bool:
    var pb = PortBundle(bundle_name: "imem", port_count: 3, p0_name: "addr", p0_dir: "out", p1_name: "data", p1_dir: "in")
    var has_outputs = pb.p0_dir == "out"
    if has_outputs:
        print("PASS: test_port_bundle_imem")
        return true
    else:
        print("FAIL: test_port_bundle_imem")
        return false

fn test_simulation_pass() -> bool:
    var sr = SimulationResult(entity_name: "alu_tb", passed: true, cycles_run: 100, ghdl_exit_code: 0)
    var is_pass = sr.passed and sr.ghdl_exit_code == 0
    if is_pass:
        print("PASS: test_simulation_pass")
        return true
    else:
        print("FAIL: test_simulation_pass")
        return false

fn main() -> i64:
    var failed = 0
    if not test_hardware_attr_kind():
        failed = failed + 1
    if not test_hardware_clocked():
        failed = failed + 1
    if not test_duplicate_label():
        failed = failed + 1
    if not test_return_label_output():
        failed = failed + 1
    if not test_return_label_vhdl_1bit():
        failed = failed + 1
    if not test_call_lower_ok():
        failed = failed + 1
    if not test_call_lower_indirect_reject():
        failed = failed + 1
    if not test_bit_slice_opcode():
        failed = failed + 1
    if not test_bit_slice_funct3():
        failed = failed + 1
    if not test_instruction_r_type():
        failed = failed + 1
    if not test_instruction_i_type():
        failed = failed + 1
    if not test_alu_add():
        failed = failed + 1
    if not test_decode_load():
        failed = failed + 1
    if not test_decode_branch():
        failed = failed + 1
    if not test_regfile_rv32():
        failed = failed + 1
    if not test_regfile_synthesizable():
        failed = failed + 1
    if not test_memory_rom():
        failed = failed + 1
    if not test_clock_default():
        failed = failed + 1
    if not test_port_bundle_imem():
        failed = failed + 1
    if not test_simulation_pass():
        failed = failed + 1
    print("DONE")
    return failed
