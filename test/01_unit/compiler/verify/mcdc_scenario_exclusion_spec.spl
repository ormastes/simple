# @feature mcdc_hal_runtime_hardening
# @req REQ-004 REQ-005 REQ-018

use std.spec.*
use compiler.tools.verify.mcdc_scenario_exclusion.*
use std.common.structural.mcdc.contracts.*

val DIGEST = "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn exclusion_kind(kind: text, code: text, predicate: text,
                  observed: i64, reviewed: i64, expires: i64) -> text:
    "# @mcdc-exclude: scenario=rt.clock.monotonic.rollback | kind={kind} | code={code} | predicate={predicate} | producible=false | reason=host cannot produce the governed clock scenario | evidence={DIGEST} | observed={observed} | owner=runtime.safety | reviewed={reviewed} | expires={expires}"

fn exclusion(reviewed: i64, expires: i64) -> text:
    exclusion_kind("capability-unavailable", "clock.rollback.inject",
        "capability.unavailable", reviewed, reviewed, expires)

fn bound_exclusion(scenario: text, decision: text, source: text,
                   mask: text, kind: text, code: text, capability: text,
                   predicate: text) -> text:
    "# @mcdc-exclude: scenario={scenario} | decision={decision} | source={source} | conditions={mask} | condition-count=2 | kind={kind} | code={code} | capability={capability} | predicate={predicate} | producible=false | reason=host cannot produce the governed clock scenario | evidence={DIGEST} | observed=1700000000 | owner=runtime.safety | reviewed=1700000100 | expires=1705000000"

describe "reason-bearing MC/DC scenario exclusions":
    it "accepts only a fresh capability-unproducible scenario expression":
        val parsed = parse_mcdc_scenario_exclusion_v1(
            exclusion(1700000000, 1705000000), 1701000000)
        expect(mcdc_scenario_exclusion_accepted_v1(parsed)).to_be(true)
        expect(parsed.scenario_id).to_equal("rt.clock.monotonic.rollback")
        expect(parsed.code).to_equal("clock.rollback.inject")
        expect(parsed.kind == McdcScenarioExclusionKindV1.CapabilityUnavailable).to_be(true)

    it "accepts every REQ-018 kind only with its registered predicate":
        val rows = [
            exclusion_kind("capability-unavailable", "clock.inject", "capability.unavailable", 1700000000, 1700000100, 1705000000),
            exclusion_kind("fixture-unavailable", "board.fixture", "fixture.unavailable", 1700000000, 1700000100, 1705000000),
            exclusion_kind("platform-inapplicable", "target.platform", "platform.inapplicable", 1700000000, 1700000100, 1705000000),
            exclusion_kind("safety-prohibited", "voltage.damage", "safety.prohibited", 1700000000, 1700000100, 1705000000),
            exclusion_kind("uncontrollable-nondeterminism", "cosmic.event", "nondeterminism.uncontrollable", 1700000000, 1700000100, 1705000000)
        ]
        for row in rows:
            expect(mcdc_scenario_exclusion_accepted_v1(
                parse_mcdc_scenario_exclusion_v1(row, 1701000000))).to_be(true)

    it "rejects mismatched predicates and scenarios claimed producible":
        val mismatch = exclusion_kind("fixture-unavailable", "board.fixture",
            "platform.inapplicable", 1700000000, 1700000100, 1705000000)
        val producible = exclusion(1700000000, 1705000000).replace(
            "producible=false", "producible=true")
        expect(mcdc_scenario_exclusion_accepted_v1(
            parse_mcdc_scenario_exclusion_v1(mismatch, 1701000000))).to_be(false)
        expect(mcdc_scenario_exclusion_accepted_v1(
            parse_mcdc_scenario_exclusion_v1(producible, 1701000000))).to_be(false)

    it "reports an exclusion explicitly and never as covered or passed":
        val parsed = parse_mcdc_scenario_exclusion_v1(
            exclusion(1700000000, 1705000000), 1701000000)
        val report = mcdc_scenario_exclusion_report_v1(parsed)
        expect(report).to_start_with("EXCLUDED scenario=")
        expect(report.contains("reason=host clock cannot produce")).to_be(true)
        expect(report.contains("PASS")).to_be(false)
        expect(report.contains("covered")).to_be(false)

    it "rejects missing reasons evidence and unstable identities":
        val missing_reason = exclusion(1700000000, 1705000000).replace(
            "reason=host cannot produce the governed clock scenario", "reason=")
        val missing_evidence = exclusion(1700000000, 1705000000).replace(
            DIGEST, "sha256:0")
        val unstable = exclusion(1700000000, 1705000000).replace(
            "scenario=rt.clock.monotonic.rollback", "scenario=RT clock rollback")
        expect(mcdc_scenario_exclusion_accepted_v1(
            parse_mcdc_scenario_exclusion_v1(missing_reason, 1701000000))).to_be(false)
        expect(mcdc_scenario_exclusion_accepted_v1(
            parse_mcdc_scenario_exclusion_v1(missing_evidence, 1701000000))).to_be(false)
        expect(mcdc_scenario_exclusion_accepted_v1(
            parse_mcdc_scenario_exclusion_v1(unstable, 1701000000))).to_be(false)

    it "rejects expired future-reviewed and overlong review windows":
        val stale = parse_mcdc_scenario_exclusion_v1(
            exclusion(1700000000, 1700500000), 1701000000)
        val future = parse_mcdc_scenario_exclusion_v1(
            exclusion(1702000000, 1705000000), 1701000000)
        val too_long = parse_mcdc_scenario_exclusion_v1(
            exclusion(1700000000, 1800000000), 1701000000)
        expect(stale.status == McdcScenarioExclusionStatusV1.Stale).to_be(true)
        expect(mcdc_scenario_exclusion_accepted_v1(future)).to_be(false)
        expect(mcdc_scenario_exclusion_accepted_v1(too_long)).to_be(false)

    it "rejects future and stale predicate observations":
        val future_observation = exclusion_kind(
            "capability-unavailable", "clock.inject", "capability.unavailable",
            1702000000, 1702000000, 1705000000)
        val stale_observation = exclusion_kind(
            "capability-unavailable", "clock.inject", "capability.unavailable",
            1700000000, 1707000000, 1714000000)
        expect(mcdc_scenario_exclusion_accepted_v1(
            parse_mcdc_scenario_exclusion_v1(future_observation, 1701000000))).to_be(false)
        expect(parse_mcdc_scenario_exclusion_v1(
            stale_observation, 1708000000).status == McdcScenarioExclusionStatusV1.Stale).to_be(true)

    it "fails the normal-mode audit on any malformed or stale directive":
        var audit = mcdc_scenario_exclusion_audit_v1()
        audit = mcdc_scenario_exclusion_audit_add_v1(
            audit, parse_mcdc_scenario_exclusion_v1(
                exclusion(1700000000, 1705000000), 1701000000))
        expect(mcdc_scenario_exclusion_normal_gate_v1(audit)).to_be(true)
        audit = mcdc_scenario_exclusion_audit_add_v1(
            audit, parse_mcdc_scenario_exclusion_v1(
                exclusion(1700000000, 1700500000), 1701000000))
        expect(mcdc_scenario_exclusion_normal_gate_v1(audit)).to_be(false)

    it "composes the directive audit with the exact normal-mode denominator gate":
        var audit = mcdc_scenario_exclusion_audit_v1()
        audit = mcdc_scenario_exclusion_audit_add_v1(
            audit, parse_mcdc_scenario_exclusion_v1(
                exclusion(1700000000, 1705000000), 1701000000))
        val exact = mcdc_normal_gate_v1(
            McdcReportModeV1.Normal, true,
            mcdc_coverage_summary_v1(10, 2, 8), 2, 2, 0)
        val incomplete = mcdc_normal_gate_v1(
            McdcReportModeV1.Normal, true,
            mcdc_coverage_summary_v1(10, 2, 7), 2, 2, 0)
        expect(mcdc_audited_normal_gate_v1_passes(exact, audit)).to_be(true)
        expect(mcdc_audited_normal_gate_v1_passes(incomplete, audit)).to_be(false)

    it "ignores ordinary source lines instead of treating them as exclusions":
        val parsed = parse_mcdc_scenario_exclusion_v1(
            "it \"executes a normal scenario\":", 1701000000)
        val audit = mcdc_scenario_exclusion_audit_add_v1(
            mcdc_scenario_exclusion_audit_v1(), parsed)
        expect(audit.directive_count).to_equal(0)
        expect(mcdc_scenario_exclusion_normal_gate_v1(audit)).to_be(true)

    it "scans once with bounded storage and rejects duplicate stable scenarios":
        var source = exclusion(1700000000, 1705000000)
        source = source + "\n  " + exclusion(1700000000, 1705000000)
        val audit = scan_mcdc_scenario_exclusions_v1(source, 1701000000)
        expect(audit.directive_count).to_equal(2)
        expect(audit.accepted_count).to_equal(1)
        expect(audit.rejected_count).to_equal(1)
        expect(mcdc_scenario_exclusion_normal_gate_v1(audit)).to_be(false)

    it "rejects an oversized candidate before copying or parsing it":
        var source = MCDC_EXCLUSION_PREFIX
        while source.len() <= MCDC_EXCLUSION_MAX_LINE_BYTES:
            source = source + "x"
        val audit = scan_mcdc_scenario_exclusions_v1(source, 1701000000)
        expect(audit.directive_count).to_equal(1)
        expect(audit.accepted_count).to_equal(0)
        expect(audit.rejected_count).to_equal(1)

    it "binds every source field to the exact binary exclusion row":
        val source = bound_exclusion(
            "rt.clock.rollback", "u64:0000000000000009",
            "u64:0000000000000063", "u64:0000000000000002",
            "capability-unavailable", "clock.rollback.inject", "clock.injector",
            "capability.unavailable")
        val parsed = parse_mcdc_scenario_exclusion_v1(source, 1701000000)
        val rows = encode_mcdc_scenario_exclusion_v1(parsed)
        val binding = bind_mcdc_scenario_exclusions_v1(source, rows, 1701000000)
        expect(parsed.binding_ready).to_be(true)
        expect(rows.len()).to_equal(376)
        expect(binding.exact).to_be(true)
        expect(binding.bound_count).to_equal(1)

    it "fails closed on missing extra duplicate reordered and tampered rows":
        val first = bound_exclusion(
            "rt.clock.rollback", "u64:0000000000000009",
            "u64:0000000000000063", "u64:0000000000000002",
            "capability-unavailable", "clock.rollback.inject", "clock.injector",
            "capability.unavailable")
        val second = bound_exclusion(
            "rt.irq.edge", "u64:000000000000000a",
            "u64:0000000000000064", "u64:0000000000000001",
            "fixture-unavailable", "irq.fixture", "irq.fixture.v1",
            "fixture.unavailable")
        val first_row = encode_mcdc_scenario_exclusion_v1(
            parse_mcdc_scenario_exclusion_v1(first, 1701000000))
        val second_row = encode_mcdc_scenario_exclusion_v1(
            parse_mcdc_scenario_exclusion_v1(second, 1701000000))
        var tampered = first_row
        tampered[120] = tampered[120] + 1u8
        expect(bind_mcdc_scenario_exclusions_v1(first, [], 1701000000).exact).to_be(false)
        expect(bind_mcdc_scenario_exclusions_v1("", first_row, 1701000000).exact).to_be(false)
        expect(bind_mcdc_scenario_exclusions_v1(first + "\n" + first,
            first_row + first_row, 1701000000).exact).to_be(false)
        expect(bind_mcdc_scenario_exclusions_v1(first + "\n" + second,
            second_row + first_row, 1701000000).exact).to_be(false)
        expect(bind_mcdc_scenario_exclusions_v1(first, tampered, 1701000000).exact).to_be(false)

    it "never promotes a legacy unbound directive through the binary gate":
        val legacy = exclusion(1700000000, 1705000000)
        val parsed = parse_mcdc_scenario_exclusion_v1(legacy, 1701000000)
        expect(parsed.status == McdcScenarioExclusionStatusV1.Accepted).to_be(true)
        expect(parsed.binding_ready).to_be(false)
        expect(encode_mcdc_scenario_exclusion_v1(parsed).len()).to_equal(0)
        expect(bind_mcdc_scenario_exclusions_v1(legacy, [], 1701000000).exact).to_be(false)
