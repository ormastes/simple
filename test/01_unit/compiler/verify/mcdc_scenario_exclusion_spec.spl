"""
## Purpose and audience

REQ-004/REQ-005/REQ-018 coverage for reason-bearing MC/DC scenario
exclusions: a `# @mcdc-exclude:` directive parser that accepts only fresh,
capability-unproducible scenario expressions with evidence digests, an
explicit EXCLUDED report channel that never reports an exclusion as covered
or passed, and an audit trail that fails the normal-mode exact denominator
gate. Written for the MC/DC reporting owner who will land the directive
scanner next to the shipped `std.common.mcdc.model` contracts.

## Operator workflow

Run one spec: `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/compiler/verify/mcdc_scenario_exclusion_spec.spl`. The shipped
half of the contract is exercised through real `std.common.mcdc.model`
calls (`mcdc_exclusion_error`, `mcdc_is_exact_complete`). The drafted
directive-scanner half (`parse_mcdc_scenario_exclusion_v1`,
`mcdc_scenario_exclusion_audit_v1`, ...) exists nowhere in `src/`
(grep-verified 2026-09-06), so those scenarios are absence tripwires against
the drafted module path using the real filesystem extern.

## Compatibility and limitations

The exclusion timestamps, window bounds and audit counters of the drafted
scanner cannot be exercised until `src/lib/common/mcdc/scenario_exclusion.spl`
lands. Each tripwire fails closed in both directions: if the drafted module
appears on disk, or if `SIMPLE_MCDC_SCENARIO_EXCLUSION_DRAFTED=1` claims it
landed, the scenario aborts and demands a rewrite against the real API.
Scenario 4 asserts the shipped stale-exclusion codes only; the timestamp
window math stays with the drafted scanner.

## Verification guidance and troubleshooting

A failure saying the module "now exists" means the scanner landed: port the
tripwired scenarios onto the real parse/audit API and delete the tripwire
helper. A failure naming the env flag means
`SIMPLE_MCDC_SCENARIO_EXCLUSION_DRAFTED=1` was set without landing the
module; unset it or implement the scanner. Failures in scenarios 3 or 6 name
shipped `std.common.mcdc.model` regressions directly (MCDC-E-EXCLUSION-* or
a wrong exact-completeness verdict) and are genuine product defects.
"""
# Lifecycle: doc/01_research/domain/mcdc_rt_hal_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_rt_hal_hardening.md ;
# doc/04_architecture/mcdc_rt_hal_hardening.md ;
# doc/05_design/mcdc_rt_hal_hardening.md
# @manual_section: mcdc-scenario-exclusion

use std.spec.*
use std.common.mcdc.model.{McdcExclusion, mcdc_exclusion_error, mcdc_is_exact_complete}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text
use std.io_runtime.{env_get}

# Fail-closed absence tripwire for the drafted directive scanner module.
# True only while the drafted module is absent AND unclaimed; aborts the
# scenario the moment either condition changes, so the spec can never pass
# silently against a tree where the scanner landed.
fn exclusion_scanner_still_absent() -> bool:
    val module_path = "src/lib/common/mcdc/scenario_exclusion.spl"
    if rt_file_exists(module_path):
        fail("mcdc scenario exclusion: {module_path} now exists - port the tripwired scenarios onto the real parse/audit API and delete the tripwire helper")
    if env_get("SIMPLE_MCDC_SCENARIO_EXCLUSION_DRAFTED") == "1":
        fail("mcdc scenario exclusion: SIMPLE_MCDC_SCENARIO_EXCLUSION_DRAFTED=1 claims the scanner landed but {module_path} is absent - implement it or unset the flag")
    true

# Source contract: the shipped model must not silently grow a half-copy of
# the drafted directive parser. Genuinely named for the contract it guards.
fn model_source_keeps_directive_parser_out() -> bool:
    not rt_file_read_text("src/lib/common/mcdc/model.spl").contains(
        "parse_mcdc_scenario_exclusion_v1")

describe "reason-bearing MC/DC scenario exclusions":
    it "accepts only a fresh capability-unproducible scenario expression":
        # @req REQ-004
        # @capture(statistics): drafted-scanner probe verdict for fresh directive acceptance
        step("Probe for the drafted directive parser module under std.common.mcdc")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: freshness/window acceptance is drafted-scanner behavior, so module absence is the only verifiable contract today
        expect(model_source_keeps_directive_parser_out()).to_be(true)  # oracle: the shipped model must stay free of the drafted parser until the real module lands, else two exclusion grammars would coexist

    it "reports an exclusion explicitly and never as covered or passed":
        # @req REQ-005
        # @capture(statistics): drafted-scanner probe verdict for the explicit EXCLUDED report
        step("Probe for the drafted module that owns the EXCLUDED report channel")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: the EXCLUDED-vs-covered report split is defined only by the drafted scanner, so its absence probe is the live check

    it "rejects missing reasons evidence and unstable identities":
        # @req REQ-018
        # @capture(bit_table): shipped exclusion validation verdicts per malformed field
        step("Validate a shipped McdcExclusion with an empty review reason")
        val missing_reason = McdcExclusion(
            semantic_id: "rt.clock.monotonic.rollback", condition_ordinal: 0,
            whole_decision: true, reason: "", reviewer: "runtime.safety",
            review_id: "rev-1", expires_or_version: "2026-12-31")
        expect(mcdc_exclusion_error(missing_reason)).to_equal(
            "MCDC-E-EXCLUSION-REASON")  # oracle: model.spl routes any blank reason/reviewer/review_id to the REASON code, so the empty reason must be rejected there
        step("Validate a shipped McdcExclusion with an unstable empty identity")
        val unstable_identity = McdcExclusion(
            semantic_id: "", condition_ordinal: 0,
            whole_decision: true, reason: "host clock cannot roll back",
            reviewer: "runtime.safety",
            review_id: "rev-1", expires_or_version: "2026-12-31")
        expect(mcdc_exclusion_error(unstable_identity)).to_equal(
            "MCDC-E-EXCLUSION-STALE")  # oracle: model.spl maps a blank semantic_id to the STALE code because an exclusion without a stable identity cannot be replayed
        step("Validate a shipped McdcExclusion with an empty expiry anchor")
        val missing_expiry = McdcExclusion(
            semantic_id: "rt.clock.monotonic.rollback", condition_ordinal: 0,
            whole_decision: true, reason: "host clock cannot roll back",
            reviewer: "runtime.safety",
            review_id: "rev-1", expires_or_version: "")
        expect(mcdc_exclusion_error(missing_expiry)).to_equal(
            "MCDC-E-EXCLUSION-STALE")  # oracle: model.spl treats a blank expires_or_version as a stale exclusion because it can never expire or version out

    it "rejects expired future-reviewed and overlong review windows":
        # @req REQ-004
        # @capture(statistics): drafted-scanner probe verdict for window rejection
        step("Probe for the drafted module that owns review window arithmetic")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: the stale/future/overlong timestamp window math lives only in the drafted scanner, so its absence is the checkable state

    it "fails the normal-mode audit on any malformed or stale directive":
        # @req REQ-005
        # @capture(statistics): drafted-scanner probe verdict for the audit gate
        step("Probe for the drafted audit accumulator and its normal gate")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: the audit trail that flips the normal gate on any malformed directive is drafted-only, so the module probe is the assertion

    it "composes the directive audit with the exact normal-mode denominator gate":
        # @req REQ-018
        # @capture(bit_table): shipped exact-completeness verdicts at the denominator boundary
        step("Check the shipped exact denominator gate at full coverage")
        expect(mcdc_is_exact_complete(8, 8)).to_be(true)  # oracle: exact mode requires covered == required, so 8 of 8 is the only accepting boundary pair here
        step("Check the shipped exact denominator gate one condition short")
        expect(mcdc_is_exact_complete(7, 8)).to_be(false)  # oracle: 7 of 8 leaves one required condition uncovered and exact mode must not round up
        step("Probe for the drafted audit that composes with this gate")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: the audit composition half is drafted-only, so the module absence completes this scenario

    it "ignores ordinary source lines instead of treating them as exclusions":
        # @req REQ-004
        # @capture(statistics): drafted-scanner probe verdict for non-directive lines
        step("Probe for the drafted line scanner that must skip ordinary source")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: non-directive line skipping is implemented only inside the drafted scanner, so absence is the live contract

    it "scans once with bounded storage and rejects duplicate stable scenarios":
        # @req REQ-018
        # @capture(statistics): drafted-scanner probe verdict for the single bounded scan
        step("Probe for the drafted bounded single-pass scanner")
        expect(exclusion_scanner_still_absent()).to_be(true)  # oracle: the one-pass bounded scan with duplicate rejection exists only in the drafted module, so its absence probe is the assertion
