# @manual: show
# @req: C2, REQ-C2-UNION-TRANSPORT-001
# Test-first source-stage contract. All scenarios UNRUN.
# A Result refusal fails every positive below; refusal is not union support.
use std.spec.{describe, it, expect, fail}
use std.spec.step
use compiler.tools.verify.source_model_v1.{source_model_from_source_v1}
use std.common.crypto.sha256.{sha256_text}

use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.enum_semantic_lowering_v1.{lower_module_with_enum_semantics_v1}
use compiler.mir.mir_instruction_graph.{MirModule}
use compiler.mir.mir_types.{MirTypeKind, MirTypeDefKind}
use compiler.mir.mir_enum_semantic_types.{MirEnumDeclarationIdentityV1}
use compiler.tools.verify.source_calls_v1.{source_calls_target_v1}
use compiler.semantics.union_normalize.source_union_admission_v1.{SourceUnionLimitsV1}
use compiler.semantics.union_normalize.source_union_normalization_v1.{source_union_normalize_v1}
use compiler.semantics.union_normalize.canonical.{union_member_key, union_variant_name}

fn union_model_export(source: text, target: text) -> text:
    match source_model_from_source_v1(source, "source_model_union.spl", target):
        case Ok(model):
            expect(model).to_start_with("-- formal_status=NOT_CHECKED\n")
            expect(model).to_contain("-- source_hash=" + sha256_text(source) + "\n")
            expect(model).to_contain("-- target=" + target + "\n")
            expect(model.contains("formal_status=PASS")).to_equal(false)
            expect(model.contains("rt_enum_discriminant")).to_equal(false)
            expect(model.contains("rt_enum_payload")).to_equal(false)
            model
        case Err(message):
            fail("positive structural union source did not export: " + message)
            ""

fn union_model_positive(source: text, target: text) -> text:
    val model = union_model_export(source, target)
    expect(model).to_contain("«__Union_bool_i64»")
    expect(model).to_contain("«Bool»")
    expect(model).to_contain("«I64»")
    model

fn union_model_capture(source: text) -> (HirModule, HirModule, MirModule):
    val parsed = parse_full_frontend(source, "source_model_union.spl", "source_model_union.spl", Logger(level: 0))
    var lowering = HirLowering.with_filename("source_model_union.spl")
    lowering.preserve_enum_semantic_arms_v1 = true
    val before = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    val normalized = source_union_normalize_v1(before, SourceUnionLimitsV1()).unwrap().module
    val context = source_calls_target_v1("x86_64-unknown-linux-gnu").unwrap()
    val mir = lower_module_with_enum_semantics_v1(normalized, context).unwrap()
    (before, normalized, mir)

fn union_model_function(module: HirModule, name: text) -> HirFunction:
    var found: [HirFunction] = []
    for function in module.functions.values():
        if function.name == name: found.push(function)
    expect(found.len()).to_equal(1)
    found[0]

fn union_model_named(type_: HirType) -> SymbolId:
    match type_.kind:
        case Named(symbol, args):
            expect(args.len()).to_equal(0)
            symbol
        case _:
            fail("union carrier lacks its actual named enum")
            SymbolId.new(-1)

fn union_model_declaration(module: HirModule, mir: MirModule, owner: SymbolId
) -> MirEnumDeclarationIdentityV1:
    val name = module.symbols.structural_union_owners[owner.id]
    expect(module.symbols.structural_union_symbols[name]).to_equal(owner.id)
    expect(module.enums[owner].symbol.id).to_equal(owner.id)
    var found: [MirEnumDeclarationIdentityV1] = []
    for declaration in mir.enum_semantic_declarations:
        if declaration.source_owner.id == owner.id: found.push(declaration)
    expect(found.len()).to_equal(1)
    expect(found[0].variants.len()).to_equal(module.enums[owner].variants.len())
    for index in 0..found[0].variants.len():
        expect(found[0].variants[index].discriminant).to_equal(index)
        expect(found[0].variants[index].slot_types.len()).to_equal(1)
    found[0]

describe "source-model structural union introduction transport and elimination":
    it "introduces a bool member and eliminates the actual local union":
        step("Compile an annotated union local with a concrete member and both narrowing arms")
        val source = "fn select() -> i64:\n    val value: bool | i64 = true\n    match value:\n        case bool flag: 31\n        case i64 number: number\n"
        val model = union_model_positive(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("(BitVec.ofInt 64 31)")
        expect(model).to_contain("true")

    it "introduces an integer member through the declared return union":
        step("Require a real closed-sum constructor in a union-returning function")
        val source = "fn produce(value: i64) -> bool | i64:\n    value\n"
        val model = union_model_positive(source, "x86_64-unknown-linux-gnu")
        # This checks actual generated constructor application, not only the
        # declaration containing the I64 variant name.
        expect(model).to_contain(".«I64» ")

    it "transports an already tagged argument through a local before narrowing":
        step("Preserve the original tag while assigning a union-typed value")
        val source = "fn select(input: i64 | bool) -> i64:\n    val value: bool | i64 = input\n    match value:\n        case bool flag: 53\n        case i64 number: number\n"
        val model = union_model_positive(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("(BitVec.ofInt 64 53)")

    it "exports retained-default introduction and member-dependent narrowing":
        step("Preserve a parsed union default while exporting the actual typed arm body")
        val source = "fn select(value: bool | i64 = true) -> i64:\n    match value:\n        case bool flag: 59\n        case i64 number: number\n"
        val model = union_model_positive(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("(BitVec.ofInt 64 59)")

    it "uses canonical member identity for reversed and duplicate source spellings":
        step("Export complete source functions for each existing canonical-union spelling")
        for spelling in ["bool | i64", "i64 | bool", "i64 | bool | i64"]:
            val source = "fn select(value: " + spelling + ") -> i32:\n    match value:\n        case bool flag: 83\n        case i64 number: 97\n"
            val model = union_model_positive(source, "x86_64-unknown-linux-gnu")
            expect(model).to_contain("(BitVec.ofInt 32 83)")
            expect(model).to_contain("(BitVec.ofInt 32 97)")
            expect(model.contains("«__Union_i64_bool»")).to_equal(false)

    it "keeps source-selected target identity through the union stage":
        step("Use the existing target-aware public source-model route")
        val source = "fn select(value: bool | i64) -> i32:\n    match value:\n        case bool flag: 101\n        case i64 number: 103\n"
        for target in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]:
            val model = union_model_positive(source, target)
            expect(model).to_contain("(BitVec.ofInt 32 101)")
            expect(model).to_contain("(BitVec.ofInt 32 103)")

    it "exports Optional-member nil with a real Tuple1 Unit payload and canonical tag":
        step("Carry parsed nil through normalization, actual MIR capture and public Lean export")
        val source = "fn select() -> i64:\n    val value: i64? | bool = nil\n    match value:\n        case i64 number: number\n        case bool flag: 1\n        case nil: 2\n"
        val model = union_model_export(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("«__Union_bool_i64_nil»")
        expect(model).to_contain(".«Nil» ")
        val (_, module, mir) = union_model_capture(source)
        val selected = union_model_function(module, "select")
        var owner = SymbolId.new(-1)
        match selected.body.stmts[0].kind:
            case Let(_, type_, init):
                owner = union_model_named(type_)
                match init.kind:
                    case EnumLit(type_, variant, payload):
                        expect(union_model_named(type_).id).to_equal(owner.id)
                        expect(variant).to_equal("Nil")
                        match payload.unwrap():
                            case Tuple(values):
                                expect(values.len()).to_equal(1)
                                match values[0].kind:
                                    case UnitLit: ()
                                    case _: fail("nil introduction lost Unit")
                            case _: fail("nil introduction lost Tuple1")
                    case _: fail("nil introduction lost constructor")
            case _: fail("actual nil local absent")
        val captured = union_model_declaration(module, mir, owner)
        expect(captured.variants.len()).to_equal(3)
        match captured.variants[2].slot_types[0].kind:
            case MirTypeKind.Unit: ()
            case _: fail("Nil canonical tag does not carry Unit")
        match selected.body.value.kind:
            case MatchCase(_, arms):
                match arms[2].pattern.kind:
                    case Enum(_, variant, payload):
                        expect(variant).to_equal("Nil")
                        match payload.unwrap():
                            case Tuple(values): expect(values.len()).to_equal(1)
                            case _: fail("nil elimination lost Tuple1")
                    case _: fail("nil elimination lost actual enum pattern")
            case _: fail("nil elimination absent")
        var matches = 0
        for function in mir.functions.values():
            for site in function.enum_matches:
                expect(site.enum_owner.id).to_equal(captured.owner.id)
                expect(site.arms.len()).to_equal(3)
                expect(site.sites.len()).to_be_greater_than(0)
                matches = matches + 1
        expect(matches).to_equal(1)

    it "flattens a genuine parsed nested union and exports its one canonical sum":
        step("Retain grouped type structure until the real structural normalization owner")
        val source = "fn select(value: (bool | i64) | bool) -> i64:\n    match value:\n        case bool flag: 7\n        case i64 number: number\n"
        val model = union_model_positive(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("(BitVec.ofInt 64 7)")
        val (before, module, mir) = union_model_capture(source)
        match union_model_function(before, "select").params[0].type_.kind:
            case Union(members):
                expect(members.len()).to_equal(2)
                match members[0].kind:
                    case Union(nested): expect(nested.len()).to_equal(2)
                    case _: fail("fixture did not actually retain nested source union")
            case _: fail("fixture did not retain source union")
        val owner = union_model_named(union_model_function(module, "select").params[0].type_)
        val captured = union_model_declaration(module, mir, owner)
        expect(captured.variants.len()).to_equal(2)
        expect(module.enums[owner].variants[0].name).to_equal("Bool")
        expect(module.enums[owner].variants[1].name).to_equal("I64")

    it "keeps a duplicate-only source union as a one-variant exported sum":
        step("Do not erase singleton union introduction or payload elimination")
        val source = "fn produce(value: i64) -> i64 | i64:\n    value\nfn select(value: i64 | i64) -> i64:\n    match value:\n        case i64 number: number\n"
        val model = union_model_export(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("«__Union_i64»")
        expect(model).to_contain(".«I64» ")
        val (_, module, mir) = union_model_capture(source)
        val producer = union_model_function(module, "produce")
        val owner = union_model_named(producer.return_type)
        val captured = union_model_declaration(module, mir, owner)
        expect(captured.variants.len()).to_equal(1)
        match captured.variants[0].slot_types[0].kind:
            case MirTypeKind.I64: ()
            case _: fail("singleton payload erased")
        expect(union_model_named(union_model_function(module, "select").params[0].type_).id).to_equal(owner.id)
        match producer.body.value.kind:
            case EnumLit(_, variant, payload):
                expect(variant).to_equal("I64")
                match payload.unwrap():
                    case Tuple(values):
                        expect(values.len()).to_equal(1)
                        match values[0].kind:
                            case Var(id) | NamedVar(id, _): expect(id.id).to_equal(producer.params[0].symbol.id)
                            case _: fail("singleton operand changed")
                    case _: fail("singleton payload not Tuple1")
            case _: fail("singleton sum erased")

    it "exports a closed same-module nominal member with its actual payload owner":
        step("Use the parsed declaration rather than a forged nominal label or symbol number")
        val source = "struct Token:\n    value: i64\nfn produce(value: Token) -> bool | Token:\n    value\nfn select(value: bool | Token) -> i64:\n    match value:\n        case bool flag: 0\n        case Token item: item.value\n"
        val model = union_model_export(source, "x86_64-unknown-linux-gnu")
        expect(model).to_contain("Token")
        val (_, module, mir) = union_model_capture(source)
        val producer = union_model_function(module, "produce")
        val nominal_owner = union_model_named(producer.params[0].type_)
        expect(module.structs.has(nominal_owner)).to_equal(true)
        expect(module.structs[nominal_owner].name).to_equal("Token")
        val nominal_key = union_member_key(producer.params[0].type_)
        val nominal_variant = union_variant_name(nominal_key)
        expect(model).to_contain(".«" + nominal_variant + "» ")
        val owner = union_model_named(producer.return_type)
        val captured = union_model_declaration(module, mir, owner)
        expect(captured.variants.len()).to_equal(2)
        var member_index: i64 = -1
        for index in 0..module.enums[owner].variants.len():
            if module.enums[owner].variants[index].name == nominal_variant: member_index = index
        expect(member_index).to_be_greater_than(-1)
        match module.enums[owner].variants[member_index].kind:
            case Tuple(types):
                expect(types.len()).to_equal(1)
                expect(union_model_named(types[0]).id).to_equal(nominal_owner.id)
            case _: fail("nominal payload lost its declaration")
        match captured.variants[member_index].slot_types[0].kind:
            case MirTypeKind.Struct(symbol):
                expect(mir.types.has(symbol)).to_equal(true)
                expect(mir.types[symbol].symbol.id).to_equal(symbol.id)
                match mir.types[symbol].kind:
                    case MirTypeDefKind.Struct(fields):
                        expect(fields.len()).to_equal(1)
                        expect(fields[0].name).to_equal("value")
                        match fields[0].type_.kind:
                            case MirTypeKind.I64: ()
                            case _: fail("nominal MIR field type drifted")
                    case _: fail("nominal MIR payload lacks its actual struct schema")
            case _: fail("nominal payload erased to a scalar")
        match union_model_function(module, "select").body.value.kind:
            case MatchCase(_, arms):
                match arms[1].pattern.kind:
                    case Enum(_, _, payload):
                        match payload.unwrap():
                            case Tuple(patterns):
                                expect(patterns.len()).to_equal(1)
                                match patterns[0].kind:
                                    case Binding(id, _):
                                        expect(union_model_named(module.symbols.symbols[id.id].type_.unwrap()).id).to_equal(nominal_owner.id)
                                    case _: fail("nominal binder missing")
                            case _: fail("nominal pattern payload missing")
                    case _: fail("nominal narrowing not an enum arm")
            case _: fail("nominal narrowing absent")
