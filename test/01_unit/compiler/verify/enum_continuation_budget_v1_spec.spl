# @manual: show
# @req: EE-01, EE-CONS-01
# Source-authored boundary oracles. Execution UNRUN.
use std.spec.{describe, it, expect, fail}
use std.spec.step
use compiler.common.config.{Logger}
use compiler.common.mir_target_context.{mir_target_context_from}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.enum_semantic_lowering_v1.{lower_module_with_enum_semantics_v1}
use compiler.mir.enum_semantic_validation_v1.{validate_enum_semantics_v1}
use compiler.mir.enum_pattern_totality_v1.{EnumPatternDecisionKindV1, EnumPatternDecisionTestV1}
use plugins.backend_lean.lean_enum_continuations_v1.{LeanEnumFlowGraphV1}

fn enum_budget_graph_v1(memoize_decisions: bool = true) -> LeanEnumFlowGraphV1:
    val source = "enum Flag:\n    Off\n    On\nfn select(value: Flag, gate: bool) -> i32:\n    match value:\n        case Flag.Off if gate: 11\n        case Flag.Off: 22\n        case Flag.On: 33\n"
    val parsed = parse_full_frontend(source, "enum_budget.spl", "enum_budget.spl", Logger(level: 0))
    var lowering = HirLowering.with_filename("enum_budget.spl")
    val hir = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    val target = mir_target_context_from("x86_64-unknown-linux-gnu", "unknown", "unknown", "llvm", 1)
    val module = lower_module_with_enum_semantics_v1(hir, target).unwrap()
    for function in module.functions.values():
        if function.enum_matches.len() == 0: continue
        val plan = validate_enum_semantics_v1(module, function).unwrap()
        expect(plan.matches.len()).to_equal(1)
        var graph = LeanEnumFlowGraphV1(function: plan.semantic_function, plan: plan,
            nodes: [], keys: {}, order: [], entry: -1, remaining: plan.work_remaining)
        graph.entry = graph.cursor(function.entry_block.id, 0).unwrap()
        val decisions = plan.decision_plans[plan.matches[0].match_id]
        # Every target already exists. Expansion must charge edge growth even
        # when decision() returns its memoized node without allocating a node.
        if memoize_decisions:
            for index in 0..decisions.nodes.len():
                val _existing = graph.decision(0, index).unwrap()
        return graph
    fail("actual producer emitted no enum function")

describe "enum continuation edge budget":
    it "refuses memoized decision edges before growing the successor array":
        step("Exhaust remaining work after precreating actual checked decision targets")
        var graph = enum_budget_graph_v1()
        val semantic = graph.plan.matches[0]
        val decisions = graph.plan.decision_plans[semantic.match_id]
        val index = graph.keys["d{semantic.match_id}:{decisions.root_node}"]
        match decisions.nodes[decisions.root_node].kind:
            case Test(_, edges): expect(edges.len()).to_be_greater_than(0)
            case _: fail("fixture requires the actual constructor decision")
        val before_nodes = graph.nodes.len()
        expect(graph.nodes[index].successors.len()).to_equal(0)
        graph.remaining = 0
        match graph.expand(index):
            case Ok(_): fail("edge growth succeeded without available work")
            case Err(error): expect(error.message).to_contain("EE-E-LIMIT")
        expect(graph.remaining).to_equal(0)
        expect(graph.nodes.len()).to_equal(before_nodes)
        expect(graph.nodes[index].successors.len()).to_equal(0)

    it "charges exactly before each memoized edge and preserves the checked targets":
        step("Supply one work unit per edge and retain constructor order and typed paths")
        var graph = enum_budget_graph_v1()
        val semantic = graph.plan.matches[0]
        val decisions = graph.plan.decision_plans[semantic.match_id]
        val index = graph.keys["d{semantic.match_id}:{decisions.root_node}"]
        match decisions.nodes[decisions.root_node].kind:
            case Test(path, edges):
                val before_nodes = graph.nodes.len()
                graph.remaining = edges.len()
                graph.expand(index).unwrap()
                expect(graph.remaining).to_equal(0)
                expect(graph.nodes.len()).to_equal(before_nodes)
                expect(graph.nodes[index].successors.len()).to_equal(edges.len())
                for offset in 0..edges.len():
                    val expected = edges[offset]
                    val actual = graph.nodes[index].successors[offset]
                    expect(actual.target).to_equal(graph.keys["d{semantic.match_id}:{expected.target_node}"])
                    expect(actual.kind).to_equal(1)
                    expect(actual.path.unwrap().key).to_equal(path.key)
                    match expected.test:
                        case Constructor(owner, discriminant):
                            match actual.test.unwrap():
                                case Constructor(actual_owner, actual_discriminant):
                                    expect(actual_owner.id).to_equal(owner.id)
                                    expect(actual_discriminant).to_equal(discriminant)
                                case _: fail("constructor edge changed test kind")
                        case _: fail("fixture root must split the declared constructors")
            case _: fail("fixture requires the actual constructor decision")

    it "retains the actual guarded false transfer with a sufficient shared budget":
        step("Build the complete graph from the producer and validator plan")
        var graph = enum_budget_graph_v1(false)
        val before_work = graph.remaining
        graph.finish().unwrap()
        expect(graph.remaining).to_be_less_than(before_work)
        expect(graph.order.len()).to_equal(graph.nodes.len())
        var false_edges = 0
        for node in graph.nodes:
            if node.guard_match < 0: continue
            val semantic = graph.plan.matches[node.guard_match]
            val decisions = graph.plan.decision_plans[semantic.match_id]
            for edge in node.successors:
                if edge.kind != 2: continue
                false_edges = false_edges + 1
                val leaf = graph.nodes[edge.source_leaf]
                match decisions.nodes[leaf.decision_index].kind:
                    case SelectArm(arm_index, _, guard_false):
                        expect(arm_index).to_equal(node.guard_arm)
                        expect(guard_false != nil).to_equal(true)
                        expect(edge.target).to_equal(graph.keys["d{semantic.match_id}:{guard_false.unwrap()}"])
                    case _: fail("guard false transfer lost its checked selected arm")
        expect(false_edges).to_equal(1)
