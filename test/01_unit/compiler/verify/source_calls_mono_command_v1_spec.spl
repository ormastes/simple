# @manual: show
# @req: REQ-FV2-C1-SM
# Actual command worker and real regular files; all scenarios UNRUN.
# App dispatcher/process execution remains a separate qualification obligation.
use std.spec.{describe, it, expect, fail}
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_create_exclusive,
    file_is_regular_no_follow}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.io_runtime.{dir_exists}
use compiler.mir.verification_call_identity.{validate_resolved_direct_call_manifest_v1}
use compiler.tools.verify.source_calls_v1.{source_calls_from_source_v1,
    source_calls_command_v1, source_calls_inventory_v1}

fn mono_command_report(source: text, target: text) -> Result<text, text>:
    val scope = secure_temp_dir(".", "c1-sm-command-")?
    val path = scope + "/generic input.spl"
    if not file_create_exclusive(path, source) or not file_is_regular_no_follow(path):
        val removed = dir_remove_all(scope)
        return Err("C1-SM-TEST-FILE: exclusive regular-file setup failed; cleanup=" + removed.to_string())
    val command = source_calls_command_v1([path, target])
    val direct = source_calls_from_source_v1(source, path, target)
    # Clean the exclusively owned fixture before any result assertion can fail.
    val removed = dir_remove_all(scope)
    if not removed or dir_exists(scope): return Err("C1-SM-TEST-CLEANUP: temporary scope remains")
    val report = command?
    val result = direct?
    expect(report).to_equal(source_calls_inventory_v1(result))
    expect(validate_resolved_direct_call_manifest_v1(result.lowered.module,
        result.lowered.calls).closed()).to_equal(true)
    expect(report).to_start_with("schema=SourceResolvedCalls-v2\n")
    expect(report).to_contain("formal_status=NOT_CHECKED\n")
    expect(report.contains("formal_status=PASS")).to_equal(false)
    expect(report.contains("schema=SourceResolvedCalls-v1")).to_equal(false)
    expect(report).to_contain("source_hash=" + sha256_text(source))
    expect(report).to_contain("target=" + target)
    expect(report).to_contain("cfg_preprocessed_hash=" + result.cfg_receipt.preprocessed_digest)
    expect(report).to_contain("cfg_decision_hash=" + result.cfg_receipt.decision_digest)
    expect(report).to_contain("mir_hash=" + result.lowered.calls.module_hash)
    expect(report).to_contain("resolver_receipt_hash=" + result.lowered.calls.resolver_receipt_hash)
    expect(report).to_contain("manifest_hash=" + result.lowered.calls.hash())
    expect(report).to_contain("binding_count=" + result.lowered.calls.bindings.len().to_string())
    expect(result.mono_input_hir_digest == "").to_equal(false)
    expect(result.mono_output_hir_digest == "").to_equal(false)
    expect(report).to_contain("mono_input_hir_hash=" + result.mono_input_hir_digest)
    expect(report).to_contain("mono_output_hir_hash=" + result.mono_output_hir_digest)
    expect(report).to_contain("mono_specializations=" + result.mono_specializations.to_string())
    Ok(report)

# Refusal helper intentionally invokes only the real file command. It does not
# simulate a read failure using a directory, a missing file, or a fabricated IO API.
fn mono_command_refusal(source: text, target: text) -> Result<text, text>:
    val scope = secure_temp_dir(".", "c1-sm-refusal-")?
    val path = scope + "/generic input.spl"
    if not file_create_exclusive(path, source) or not file_is_regular_no_follow(path):
        val removed = dir_remove_all(scope)
        return Err("C1-SM-TEST-FILE: exclusive regular-file setup failed; cleanup=" + removed.to_string())
    val result = source_calls_command_v1([path, target])
    val removed = dir_remove_all(scope)
    if not removed or dir_exists(scope): return Err("C1-SM-TEST-CLEANUP: temporary scope remains")
    result

describe "canonical source monomorphization command inventory":
    it "reads an actual generic source file and emits the v2 stage identities":
        step("compare the real command report with the direct API at the identical path and target")
        val source = "fn identity<T>(value: T) -> T:\n    value\n\nfn caller() -> i64:\n    identity<i64>(17)\n"
        match mono_command_report(source, "x86_64-unknown-linux-gnu"):
            case Ok(report):
                expect(report).to_contain("binding_count=1")
                expect(report).to_contain("mono_specializations=1")
            case Err(message): fail(message)

    it "includes a specialization discovered only in a file's omitted default":
        step("execute canonical default discovery before actual command capture and finalization")
        val source = "fn identity<T>(value: T) -> T:\n    value\n\nfn consume(value: i64 = identity<i64>(31)) -> i64:\n    value\n\nfn caller() -> i64:\n    consume()\n"
        match mono_command_report(source, "x86_64-unknown-linux-gnu"):
            case Ok(report):
                expect(report).to_contain("binding_count=2")
                expect(report).to_contain("mono_specializations=1")
            case Err(message): fail(message)

    it "keeps the nongeneric command behavior with explicit v2 versioning":
        step("retain every existing report key when no specialization is requested")
        val source = "fn leaf() -> i64:\n    7\n\nfn caller() -> i64:\n    leaf()\n"
        match mono_command_report(source, "x86_64-unknown-linux-gnu"):
            case Ok(report):
                expect(report).to_contain("binding_count=1")
                expect(report).to_contain("mono_specializations=0")
            case Err(message): fail(message)

    it "uses the requested target to select actual generic call requests":
        step("select one x86 specialization and two aarch64 specializations from the same source bytes")
        val source = "fn identity<T>(value: T) -> T:\n    value\n\n@cfg(\"target_arch\", \"x86_64\")\nfn caller() -> i64:\n    identity<i64>(31)\n\n@cfg(\"target_arch\", \"aarch64\")\nfn caller() -> i64:\n    val enabled = identity<bool>(true)\n    identity<i64>(47)\n"
        match mono_command_report(source, "x86_64-unknown-linux-gnu"):
            case Ok(report):
                expect(report).to_contain("target=x86_64-unknown-linux-gnu")
                expect(report).to_contain("binding_count=1")
                expect(report).to_contain("mono_specializations=1")
            case Err(message): fail(message)
        match mono_command_report(source, "aarch64-unknown-linux-gnu"):
            case Ok(report):
                expect(report).to_contain("target=aarch64-unknown-linux-gnu")
                expect(report).to_contain("binding_count=2")
                expect(report).to_contain("mono_specializations=2")
            case Err(message): fail(message)

    it "returns a parser refusal for malformed bytes in an actual regular file":
        step("refuse the real file without emitting a partial v2 inventory")
        match mono_command_refusal("fn broken<T>( -> T:\n    1\n", "x86_64-unknown-linux-gnu"):
            case Ok(_): fail("malformed file unexpectedly published an inventory")
            case Err(message):
                expect(message).to_contain("SOURCE-CALLS-E-PARSE")
                expect(message.contains("schema=SourceResolvedCalls-v2")).to_equal(false)
                expect(message.contains("formal_status=NOT_CHECKED")).to_equal(false)

    it "rejects an implicit target even when the source is a real regular file":
        step("preserve explicit target refusal ahead of frontend and monomorphization work")
        val source = "fn identity<T>(value: T) -> T:\n    value\n\nfn caller() -> i64:\n    identity<i64>(17)\n"
        match mono_command_refusal(source, "native"):
            case Ok(_): fail("implicit target unexpectedly published an inventory")
            case Err(message):
                expect(message).to_contain("SOURCE-CALLS-E-TARGET")
                expect(message.contains("schema=SourceResolvedCalls-v2")).to_equal(false)
