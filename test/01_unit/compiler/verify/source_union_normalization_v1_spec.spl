# @manual: show
# @req: REQ-C2-UNION-TRANSPORT-001
# Actual parsed HIR -> production normalization API. All scenarios UNRUN.
use std.spec.{describe, it, expect, fail}
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.tools.verify.source_calls_v1.{source_calls_target_v1}
use compiler.mir.enum_semantic_lowering_v1.{lower_module_with_enum_semantics_v1}
use compiler.mir.mir_types.{MirTypeKind}
use compiler.semantics.union_normalize.source_union_admission_v1.{
    SourceUnionLimitsV1, SourceUnionUsageV1
}
use compiler.semantics.union_normalize.source_union_normalization_v1.{
    source_union_normalize_v1, SourceUnionOutputV1
}

fn union_stage_parse(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "union_stage.spl", "union_stage", Logger(level: 0))
    var lowering = HirLowering.with_filename("union_stage.spl")
    lowering.preserve_enum_semantic_arms_v1 = true
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    module

fn union_stage_success(module: HirModule, limits: SourceUnionLimitsV1) -> SourceUnionOutputV1:
    match source_union_normalize_v1(module, limits):
        case Ok(output): output
        case Err(error):
            fail(error.code + ": " + error.message)
            SourceUnionOutputV1(module: module, usage: SourceUnionUsageV1())

fn union_stage_function(module: HirModule, name: text) -> HirFunction:
    var matches: [HirFunction] = []
    for function in module.functions.values():
        if function.name == name: matches.push(function)
    expect(matches.len()).to_equal(1)
    matches[0]

fn union_stage_source() -> text:
    "fn select() -> i64:\n    val value: bool | i64 = true\n    match value:\n        case bool flag: 31\n        case i64 number: number\n"

fn union_stage_named(type_: HirType) -> SymbolId:
    match type_.kind:
        case Named(symbol, args):
            expect(args.len()).to_equal(0)
            symbol
        case _:
            fail("carrier remains raw union instead of registered enum")
            SymbolId.new(-1)

describe "complete source union stage artifact oracles":
    it "introduces one bool payload and keeps arm binder references exact":
        step("Inspect actual parsed normalized declaration, constructor and narrowed body")
        val input = union_stage_parse(union_stage_source())
        val before = hir_module_encode(input)
        val output = union_stage_success(input, SourceUnionLimitsV1())
        expect(hir_module_encode(input)).to_equal(before)
        val function = union_stage_function(output.module, "select")
        var subject = SymbolId.new(-1)
        match function.body.stmts[0].kind:
            case Let(symbol, type_, init):
                subject = union_stage_named(type_)
                match init.kind:
                    case EnumLit(owner, variant, payload):
                        expect(union_stage_named(owner).id).to_equal(subject.id)
                        expect(variant).to_equal("Bool")
                        match payload.unwrap():
                            case Tuple(values):
                                expect(values.len()).to_equal(1)
                                match values[0].kind:
                                    case BoolLit(value): expect(value).to_equal(true)
                                    case _: fail("introduced payload changed")
                            case _: fail("constructor payload shape changed")
                    case _: fail("scalar introduction did not produce an enum literal")
            case _: fail("annotated source local disappeared")
        val declaration = output.module.enums[subject]
        expect(declaration.variants.len()).to_equal(2)
        expect(declaration.variants[0].name).to_equal("Bool")
        expect(declaration.variants[1].name).to_equal("I64")
        expect(declaration.variants[0].has_discriminant).to_equal(false)
        expect(declaration.variants[1].has_discriminant).to_equal(false)
        match function.body.value.kind:
            case MatchCase(_, arms):
                expect(arms.len()).to_equal(2)
                match arms[1].pattern.kind:
                    case Enum(owner, variant, payload):
                        expect(union_stage_named(owner).id).to_equal(subject.id)
                        expect(variant).to_equal("I64")
                        match payload.unwrap():
                            case Tuple(patterns):
                                expect(patterns.len()).to_equal(1)
                                match patterns[0].kind:
                                    case Binding(id, _):
                                        val row = output.module.symbols.symbols[id.id]
                                        match row.type_.unwrap().kind:
                                            case Int(bits, signed):
                                                expect(bits).to_equal(64)
                                                expect(signed).to_equal(true)
                                            case _: fail("binder lost its member type")
                                        match arms[1].body.value.kind:
                                            case Var(body_id) | NamedVar(body_id, _):
                                                expect(body_id.id).to_equal(id.id)
                                            case _: fail("body no longer references its actual binder")
                                    case _: fail("payload binder absent")
                            case _: fail("payload pattern arity missing")
                    case _: fail("union arm lost named-enum representation")
            case _: fail("actual source match was not retained")
        expect(output.usage.injections).to_equal(1)
        # Continue through the real producer, not hand-authored MIR records.
        val context = source_calls_target_v1("x86_64-unknown-linux-gnu").unwrap()
        val mir = lower_module_with_enum_semantics_v1(output.module, context).unwrap()
        expect(mir.enum_semantic_declarations.len()).to_equal(1)
        val captured = mir.enum_semantic_declarations[0]
        expect(captured.source_owner.id).to_equal(subject.id)
        expect(captured.variants.len()).to_equal(2)
        expect(captured.variants[0].discriminant).to_equal(0)
        expect(captured.variants[1].discriminant).to_equal(1)
        expect(captured.variants[0].slot_types.len()).to_equal(1)
        expect(captured.variants[1].slot_types.len()).to_equal(1)
        match captured.variants[0].slot_types[0].kind:
            case MirTypeKind.Bool: ()
            case _: fail("captured bool payload type drifted")
        match captured.variants[1].slot_types[0].kind:
            case MirTypeKind.I64: ()
            case _: fail("captured integer payload type drifted")
        var matches = 0
        for emitted in mir.functions.values():
            for site in emitted.enum_matches:
                matches = matches + 1
                expect(site.enum_owner.id).to_equal(captured.owner.id)
                expect(site.arms.len()).to_equal(2)
                expect(site.sites.len()).to_be_greater_than(0)
        expect(matches).to_equal(1)

    it "forwards already tagged locals without another constructor":
        step("Normalize an identity transport and assert it remains the original variable")
        val input = union_stage_parse("fn identity(input: i64 | bool) -> bool | i64:\n    val output: bool | i64 = input\n    output\n")
        val output = union_stage_success(input, SourceUnionLimitsV1())
        val function = union_stage_function(output.module, "identity")
        expect(union_stage_named(function.params[0].type_).id).to_equal(union_stage_named(function.return_type).id)
        match function.body.stmts[0].kind:
            case Let(_, _, init):
                match init.kind:
                    case Var(id) | NamedVar(id, _):
                        expect(id.id).to_equal(function.params[0].symbol.id)
                    case _: fail("identity transport rewrapped the tagged input")
            case _: fail("identity local absent")
        expect(output.usage.injections).to_equal(0)

    it "normalizes a retained default once without selecting or executing it":
        step("Keep default presence and install exactly one member constructor in the retained expression")
        val input = union_stage_parse("fn identity(input: bool | i64 = true) -> bool | i64:\n    input\n")
        val output = union_stage_success(input, SourceUnionLimitsV1())
        val function = union_stage_function(output.module, "identity")
        expect(function.params.len()).to_equal(1)
        expect(function.params[0].has_default).to_equal(true)
        match function.params[0].default.kind:
            case EnumLit(_, variant, payload):
                expect(variant).to_equal("Bool")
                match payload.unwrap():
                    case Tuple(values):
                        expect(values.len()).to_equal(1)
                        match values[0].kind:
                            case BoolLit(value): expect(value).to_equal(true)
                            case _: fail("default expression was replaced")
                    case _: fail("default payload shape changed")
            case _: fail("default union introduction was skipped")
        match function.body.value.kind:
            case Var(id) | NamedVar(id, _):
                expect(id.id).to_equal(function.params[0].symbol.id)
            case _: fail("default was eagerly substituted into the function body")
        expect(output.usage.injections).to_equal(1)

    it "uses one Unit payload for both nil introduction and nil narrowing":
        step("Normalize Optional as a union member without changing outer Optional semantics")
        val input = union_stage_parse("fn select() -> i64:\n    val value: i64? | bool = nil\n    match value:\n        case i64 number: number\n        case bool flag: 1\n        case nil: 2\n")
        val output = union_stage_success(input, SourceUnionLimitsV1())
        val function = union_stage_function(output.module, "select")
        match function.body.stmts[0].kind:
            case Let(_, _, init):
                match init.kind:
                    case EnumLit(_, variant, payload):
                        expect(variant).to_equal("Nil")
                        match payload.unwrap():
                            case Tuple(values):
                                expect(values.len()).to_equal(1)
                                match values[0].kind:
                                    case UnitLit: ()
                                    case _: fail("nil constructor payload is not Unit")
                            case _: fail("nil constructor is not Tuple1")
                    case _: fail("nil introduction absent")
            case _: fail("nil local absent")
        match function.body.value.kind:
            case MatchCase(_, arms):
                match arms[2].pattern.kind:
                    case Enum(_, variant, payload):
                        expect(variant).to_equal("Nil")
                        match payload.unwrap():
                            case Tuple(patterns): expect(patterns.len()).to_equal(1)
                            case _: fail("nil pattern is not Tuple1")
                    case _: fail("nil arm lost its enum pattern")
            case _: fail("nil match absent")

    it "accepts exact ledger boundaries and refuses one less without changing the caller":
        step("Reuse actual stage debits as tightened public API limits")
        val input = union_stage_parse(union_stage_source())
        val before = hir_module_encode(input)
        val measured = union_stage_success(input, SourceUnionLimitsV1()).usage
        for counter in ["nodes", "depth", "members", "key", "registry", "injections", "copy", "work"]:
            var exact = SourceUnionLimitsV1()
            var amount: i64 = 0
            match counter:
                case "nodes":
                    amount = measured.nodes
                    exact.max_nodes = amount
                case "depth":
                    amount = measured.max_depth_seen
                    exact.max_depth = amount
                case "members":
                    amount = measured.members
                    exact.max_members = amount
                case "key":
                    amount = measured.key_bytes
                    exact.max_key_bytes = amount
                case "registry":
                    amount = measured.registry_rows
                    exact.max_registry_rows = amount
                case "injections":
                    amount = measured.injections
                    exact.max_injections = amount
                case "copy":
                    amount = measured.copy_units
                    exact.max_copy_units = amount
                case "work":
                    amount = measured.work
                    exact.max_work = amount
            expect(amount).to_be_greater_than(0)
            val _ = union_stage_success(input, exact)
            var short = exact
            match counter:
                case "nodes": short.max_nodes = amount - 1
                case "depth": short.max_depth = amount - 1
                case "members": short.max_members = amount - 1
                case "key": short.max_key_bytes = amount - 1
                case "registry": short.max_registry_rows = amount - 1
                case "injections": short.max_injections = amount - 1
                case "copy": short.max_copy_units = amount - 1
                case "work": short.max_work = amount - 1
            match source_union_normalize_v1(input, short):
                case Ok(_): fail("one-short resource limit published a partial module")
                case Err(error): expect(error.code).to_start_with("UNION-E-")
            expect(hir_module_encode(input)).to_equal(before)

    it "preserves complete caller state after late unsupported expression failure":
        step("Fail after an earlier sorted function has allocated its real union constructor")
        val source = "fn a_first() -> bool | i64:\n    true\nfn z_late(input: bool | i64) -> i64:\n    while true:\n        1\n    2\n"
        val input = union_stage_parse(source)
        val before = hir_module_encode(input)
        match source_union_normalize_v1(input, SourceUnionLimitsV1()):
            case Ok(_): fail("unsupported loop published a module")
            case Err(error):
                expect(error.code).to_equal("UNION-E-CARRIER")
                expect(error.usage.injections).to_be_greater_than(0)
        expect(hir_module_encode(input)).to_equal(before)
        val next = union_stage_success(union_stage_parse(union_stage_source()), SourceUnionLimitsV1())
        expect(next.usage.injections).to_equal(1)

    it "keeps omitted defaults omitted and supplied operands present exactly once":
        step("Normalize actual parsed local direct calls without acting as a default evaluator")
        val source = "fn identity(input: bool | i64 = true) -> bool | i64:\n    input\nfn omitted() -> bool | i64:\n    identity()\nfn supplied(value: i64) -> bool | i64:\n    identity(value)\n"
        val input = union_stage_parse(source)
        val before = hir_module_encode(input)
        val output = union_stage_success(input, SourceUnionLimitsV1())
        val omitted = union_stage_function(output.module, "omitted")
        match omitted.body.value.kind:
            case Call(_, args, _): expect(args.len()).to_equal(0)
            case _: fail("omitted call replaced by an evaluated default")
        val supplied = union_stage_function(output.module, "supplied")
        match supplied.body.value.kind:
            case Call(_, args, _):
                expect(args.len()).to_equal(1)
                match args[0].value.kind:
                    case EnumLit(_, variant, payload):
                        expect(variant).to_equal("I64")
                        match payload.unwrap():
                            case Tuple(values):
                                expect(values.len()).to_equal(1)
                                match values[0].kind:
                                    case Var(id) | NamedVar(id, _):
                                        expect(id.id).to_equal(supplied.params[0].symbol.id)
                                    case _: fail("supplied operand was evaluated or duplicated")
                            case _: fail("supplied operand payload changed")
                    case _: fail("supplied member was not injected")
            case _: fail("supplied call was dropped")
        expect(hir_module_encode(input)).to_equal(before)
        # General call export is a separate downstream obligation; this test
        # claims only the actual normalization API's calling/default contract.

    it "rejects operations on an unnarrowed value instead of casting its tag":
        step("Prevent a raw union from acquiring a scalar type through a cast")
        val input = union_stage_parse("fn convert(value: bool | i64) -> i64:\n    i64(value)\n")
        val before = hir_module_encode(input)
        match source_union_normalize_v1(input, SourceUnionLimitsV1()):
            case Ok(_): fail("unnarrowed union operation published a module")
            case Err(error):
                expect(error.code).to_equal("UNION-E-CARRIER")
                expect(error.message).to_contain("narrowing")
        expect(hir_module_encode(input)).to_equal(before)

    it "returns byte-identical HIR for ordinary union-free named enum source":
        step("Retain the existing named-enum route without rebuilding its symbol graph")
        val input = union_stage_parse("enum Flag:\n    Off\n    On\nfn select(value: Flag) -> i64:\n    match value:\n        case Flag.Off: 1\n        case Flag.On: 2\n")
        val before = hir_module_encode(input)
        val output = union_stage_success(input, SourceUnionLimitsV1())
        expect(hir_module_encode(output.module)).to_equal(before)
        expect(hir_module_encode(input)).to_equal(before)
        expect(output.usage.injections).to_equal(0)

    it "refuses a known bool payload returned from an integer arm at its exact span":
        step("Reject contradictory resolved member evidence without changing the caller")
        val input = union_stage_parse("fn select(value: bool | i64) -> i64:\n    match value:\n        case bool flag: flag\n        case i64 number: number\n")
        val before = hir_module_encode(input)
        val function = union_stage_function(input, "select")
        var conflict = function.span
        match function.body.value.kind:
            case MatchCase(_, arms): conflict = arms[0].body.value.span
            case _: fail("parsed union match missing")
        match source_union_normalize_v1(input, SourceUnionLimitsV1()):
            case Ok(_): fail("known bool was relabeled as an integer")
            case Err(error):
                expect(error.code).to_equal("UNION-E-CARRIER")
                expect(error.message).to_contain("known expression type")
                expect(error.span.start).to_equal(conflict.start)
                expect(error.span.end).to_equal(conflict.end)
        expect(hir_module_encode(input)).to_equal(before)

    it "refuses a known integer guard and accepts a correctly typed bool guard":
        step("Apply the same resolved-type boundary to actual parsed arm guards")
        val input = union_stage_parse("fn select(value: bool | i64) -> i64:\n    match value:\n        case i64 number if number: number\n        case bool flag: 1\n        case _: 0\n")
        val before = hir_module_encode(input)
        val function = union_stage_function(input, "select")
        var conflict = function.span
        match function.body.value.kind:
            case MatchCase(_, arms): conflict = arms[0].guard.span
            case _: fail("parsed guarded union match missing")
        match source_union_normalize_v1(input, SourceUnionLimitsV1()):
            case Ok(_): fail("known integer was relabeled as a Bool guard")
            case Err(error):
                expect(error.message).to_contain("known expression type")
                expect(error.span.start).to_equal(conflict.start)
                expect(error.span.end).to_equal(conflict.end)
        expect(hir_module_encode(input)).to_equal(before)
        val valid = union_stage_parse("fn select(value: bool | i64) -> i64:\n    match value:\n        case bool flag if flag: 1\n        case i64 number: number\n        case _: 0\n")
        val output = union_stage_success(valid, SourceUnionLimitsV1())
        match union_stage_function(output.module, "select").body.value.kind:
            case MatchCase(_, arms):
                match arms[0].guard.type_.kind:
                    case Bool: ()
                    case _: fail("valid bool guard lost its actual type")
            case _: fail("valid guarded match missing")

    it "refuses a known direct-call argument mismatch without inventing a coercion":
        step("Keep actual formal evidence authoritative for scalar arguments in a union module")
        val input = union_stage_parse("fn accept(value: i64) -> i64:\n    value\nfn select(input: bool | i64, flag: bool) -> i64:\n    accept(flag)\n")
        val before = hir_module_encode(input)
        val function = union_stage_function(input, "select")
        var conflict = function.span
        match function.body.value.kind:
            case Call(_, args, _): conflict = args[0].value.span
            case _: fail("actual local call missing")
        match source_union_normalize_v1(input, SourceUnionLimitsV1()):
            case Ok(_): fail("known bool argument was relabeled as the integer formal")
            case Err(error):
                expect(error.message).to_contain("known expression type")
                expect(error.span.start).to_equal(conflict.start)
                expect(error.span.end).to_equal(conflict.end)
        expect(hir_module_encode(input)).to_equal(before)
        val valid = union_stage_parse("fn accept(value: i64) -> i64:\n    value\nfn select(input: bool | i64, number: i64) -> i64:\n    accept(number)\n")
        val output = union_stage_success(valid, SourceUnionLimitsV1())
        val selected = union_stage_function(output.module, "select")
        match selected.body.value.kind:
            case Call(_, args, _):
                expect(args.len()).to_equal(1)
                match args[0].value.kind:
                    case Var(id) | NamedVar(id, _): expect(id.id).to_equal(selected.params[1].symbol.id)
                    case _: fail("valid operand was replaced")
            case _: fail("valid direct call was replaced")

    it "preserves an admitted external signature with no body in a union module":
        step("Do not dereference or synthesize a body for a real parsed extern declaration")
        val input = union_stage_parse("extern fn external(value: i64) -> i64\nfn produce(value: i64) -> bool | i64:\n    value\n")
        var external = union_stage_function(input, "external")
        expect(external.is_extern).to_equal(true)
        # Canonical HIR permits signature-only externs to carry no body.
        external.body = nil
        var owned = input
        owned.functions[external.symbol] = external
        val before = hir_module_encode(owned)
        val output = union_stage_success(owned, SourceUnionLimitsV1())
        val retained = union_stage_function(output.module, "external")
        expect(retained.is_extern).to_equal(true)
        expect(retained.body == nil).to_equal(true)
        expect(retained.params.len()).to_equal(1)
        expect(hir_module_encode(owned)).to_equal(before)
        expect(output.usage.injections).to_equal(1)
