# @manual: show
# @req: C2, REQ-C2-RV-002, REQ-C2-RV-003
# Authored before contextual-field producer repair. All execution UNRUN.
use std.spec
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use compiler.common.config.{Logger}
use compiler.common.mir_target_context.{mir_target_context_from}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.{HirModule, HirTypeKind, SymbolId}
use compiler.hir.hir_definitions.{HirExprKind}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode_stable}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.enum_semantic_lowering_v1.{lower_module_with_enum_semantics_v1}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirInstKind, AggregateKind, MirOperandKind}
use compiler.mir.mir_types.{MirTypeKind, MirTypeDefKind, MirConstValue}
use compiler.mir.mir_json.{serialize_mir_module, serialize_mir_type}
use compiler.tools.verify.source_model_v1.{source_model_from_source_v1}
use plugins.backend_lean.lean_backend.{LeanBackend, VerificationLevel}
use compiler.backend.backend.lean_backend.{LeanBackend as CompilerLeanBackend, VerificationLevel as CompilerVerificationLevel}

fn rv_comp_hir(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "recursive_composition.spl", "recursive_composition.spl", Logger(level: 0))
    var lowering = HirLowering.with_filename("recursive_composition.spl")
    lowering.preserve_enum_semantic_arms_v1 = true
    val hir = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    hir

fn rv_comp_mir(hir: HirModule) -> MirModule:
    val target = mir_target_context_from("x86_64-unknown-linux-gnu", "unknown", "unknown", "llvm", 1)
    lower_module_with_enum_semantics_v1(hir, target).unwrap()

fn rv_comp_function(module: MirModule, name: text) -> MirFunction?:
    for function in module.functions.values():
        if function.name == name or function.name == "recursive_composition." + name: return Some(function)
    nil

fn rv_comp_outputs(module: MirModule) -> [text]:
    val before = serialize_mir_module(module)
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    val outputs = [plugin.export_module(module).unwrap().lean_code, plugin.export_generated_module(module).unwrap().lean_code,
        compiler.export_module(module).unwrap().lean_code, compiler.export_generated_module(module).unwrap().lean_code]
    expect(serialize_mir_module(module)).to_equal(before)
    outputs

fn rv_comp_source_output(source: text) -> text:
    val code = source_model_from_source_v1(source, "recursive_composition.spl", "x86_64-unknown-linux-gnu").unwrap()
    expect(code).to_start_with("-- formal_status=NOT_CHECKED\n")
    expect(code).to_contain("-- source_hash=" + sha256_text(source) + "\n")
    expect(code.contains("formal_status=PASS")).to_equal(false)
    code

fn rv_comp_default_source(call: text = "Node()") -> text:
    "struct Node:\n    children: [Node; 0] = []\n    tag: i64 = 7\nfn make() -> Node:\n    " + call + "\n"

fn rv_comp_retained_default(hir: HirModule):
    var found = 0
    for definition in hir.structs.values():
        for field in definition.fields:
            if field.name == "children":
                expect(field.has_default).to_equal(true)
                match field.type_.kind:
                    case HirTypeKind.Array(element, size):
                        expect(size.unwrap()).to_equal(0)
                        match element.kind:
                            case HirTypeKind.Named(owner, arguments):
                                expect(owner).to_equal(definition.symbol)
                                expect(arguments.len()).to_equal(0)
                            case _: fail("declared recursive default element lost its nominal owner")
                    case _: fail("declared recursive default is not a fixed Array")
                match field.default.kind:
                    case HirExprKind.ArrayLit(elements, _): expect(elements.len()).to_equal(0)
                    case _: fail("source default expression was replaced or discarded")
                found = found + 1
    expect(found).to_equal(1)

fn rv_comp_materialized_default(module: MirModule, expected_tag: i64):
    val function = rv_comp_function(module, "make").unwrap()
    var node_owner = SymbolId(id: -1)
    for definition in module.types.values():
        match definition.kind:
            case Struct(fields):
                for field in fields:
                    if field.name == "children":
                        match field.type_.kind:
                            case Array(element, size):
                                expect(size).to_equal(0)
                                expect(element.kind).to_equal(MirTypeKind.Struct(definition.symbol))
                                node_owner = definition.symbol
                            case _: fail("canonical default field lost fixed-array metadata")
            case _: ()
    expect(node_owner.id).to_be_greater_than(-1)
    var array_local = -1
    var array_count = 0
    var struct_count = 0
    var tag_count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Aggregate(dest, AggregateKind.Array(element), operands):
                    expect(element.kind).to_equal(MirTypeKind.Struct(node_owner))
                    expect(operands.len()).to_equal(0)
                    var retained = false
                    for local in function.locals:
                        if local.id == dest:
                            match local.type_.kind:
                                case Array(actual, size):
                                    expect(actual.kind).to_equal(element.kind)
                                    expect(size).to_equal(0)
                                    retained = true
                                case _: fail("materialized default local has no exact Array type")
                    expect(retained).to_equal(true)
                    array_local = dest.id
                    array_count = array_count + 1
                case MirInstKind.Aggregate(_, AggregateKind.Struct(owner), operands):
                    if owner == node_owner:
                        expect(operands.len()).to_equal(2)
                        match operands[0].kind:
                            case MirOperandKind.Copy(local) | MirOperandKind.Move(local): expect(local.id).to_equal(array_local)
                            case _: fail("struct did not consume the actual materialized default array")
                        struct_count = struct_count + 1
                case MirInstKind.Const(_, MirConstValue.Int(value), type_):
                    if value == expected_tag:
                        expect(type_.kind).to_equal(MirTypeKind.I64)
                        tag_count = tag_count + 1
                case _: ()
    expect(array_count).to_equal(1)
    expect(struct_count).to_equal(1)
    expect(tag_count).to_equal(1)
    for code in rv_comp_outputs(module):
        expect(code).to_contain("_root_.Fin 0 →")
        expect(code).to_contain("#[]")
        expect(code).to_contain(".mk (")
        expect(code).to_contain("BitVec.ofInt 64 " + expected_tag.to_text())

describe "source defaults and mutual recursive finite-array composition":
    it "should preserve a real field default through HIR codec and materialize its declared recursive array":
        step("Preserve source and declaration authority")
        val source = rv_comp_default_source()
        val hir = rv_comp_hir(source)
        rv_comp_retained_default(hir)
        val decoded = hir_module_decode_stable(hir_module_encode(hir)).unwrap()
        rv_comp_retained_default(decoded)
        rv_comp_materialized_default(rv_comp_mir(hir), 7)
        rv_comp_materialized_default(rv_comp_mir(decoded), 7)
        val code = rv_comp_source_output(source)
        expect(code).to_contain("_root_.Fin 0 →")
        expect(code).to_contain("#[]")
        expect(code).to_contain("BitVec.ofInt 64 7")

    it "should use explicit array and scalar fields instead of evaluating their defaults again":
        val source = rv_comp_default_source("Node(children: [], tag: 9)")
        rv_comp_materialized_default(rv_comp_mir(rv_comp_hir(source)), 9)
        val code = rv_comp_source_output(source)
        expect(code).to_contain("BitVec.ofInt 64 9")
        expect(code.contains("BitVec.ofInt 64 7")).to_equal(false)

    it "should reject a materialized fixed-array default with the wrong declared length":
        val source = "struct Node:\n    children: [Node; 1] = []\nfn make() -> Node:\n    Node()\n"
        val hir = rv_comp_hir(source)
        val target = mir_target_context_from("x86_64-unknown-linux-gnu", "unknown", "unknown", "llvm", 1)
        match lower_module_with_enum_semantics_v1(hir, target):
            case Err(message): expect(message).to_contain("array length mismatch")
            case Ok(_): fail("wrong-length default was materialized with an invented field type")
        match source_model_from_source_v1(source, "recursive_composition.spl", "x86_64-unknown-linux-gnu"):
            case Err(message): expect(message).to_contain("array length mismatch")
            case Ok(_): fail("public source model accepted a wrong-length default")

    it "should lower parsed mutually recursive struct and enum declarations with exact array owner":
        step("Plan exact recursive carriers")
        val source = "struct Left:\n    children: [Right; 0]\nenum Right:\n    End\n    Back(Left)\nfn keep(value: Left) -> Left:\n    value\n"
        val module = rv_comp_mir(rv_comp_hir(source))
        var right = SymbolId(id: -1)
        var left = SymbolId(id: -1)
        for definition in module.types.values():
            if definition.name == "Right" or definition.name.ends_with(".Right"): right = definition.symbol
            if definition.name == "Left" or definition.name.ends_with(".Left"): left = definition.symbol
        expect(right.id).to_be_greater_than(-1)
        expect(left.id).to_be_greater_than(-1)
        match module.types[left].kind:
            case Struct(fields):
                expect(fields.len()).to_equal(1)
                match fields[0].type_.kind:
                    case Array(element, size):
                        expect(size).to_equal(0)
                        expect(element.kind).to_equal(MirTypeKind.Enum(right))
                    case _: fail("mutual source array edge disappeared")
            case _: fail("Left changed declaration kind")
        match module.types[right].kind:
            case Enum(variants):
                expect(variants.len()).to_equal(2)
                expect(variants[1].payload.unwrap().kind).to_equal(MirTypeKind.Struct(left))
            case _: fail("Right changed declaration kind")
        for code in rv_comp_outputs(module):
            expect(code).to_contain("mutual")
            expect(code).to_contain("_root_.Fin 0 →")
            expect(code).to_contain("«Left»")
            expect(code).to_contain("«Right»")
            expect(code).to_contain("«Back»")
        expect(rv_comp_source_output(source)).to_contain("_root_.Fin 0 →")

    it "should preserve ordinary uncontextualized empty-array inference":
        val module = rv_comp_mir(rv_comp_hir("fn empty():\n    []\n"))
        val function = rv_comp_function(module, "empty").unwrap()
        var found = 0
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Aggregate(_, AggregateKind.Array(element), operands):
                        expect(element.kind).to_equal(MirTypeKind.I64)
                        expect(operands.len()).to_equal(0)
                        found = found + 1
                    case _: ()
        expect(found).to_equal(1)
