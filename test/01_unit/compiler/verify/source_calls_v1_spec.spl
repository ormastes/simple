# REQ-FV2-C1: real source-to-call inventory. All scenarios UNRUN.
use std.spec.{describe, it, expect, fail}
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.{DiBinding}
use compiler.mir.verification_call_identity.{validate_resolved_direct_call_manifest_v1}
use compiler.tools.verify.source_calls_v1.{source_calls_from_source_v1,
    source_calls_command_v1, source_calls_inventory_v1, source_calls_transform_error_v1}

fn source_calls_expect_error(source: text, target: text, fragment: text):
    match source_calls_from_source_v1(source, "source_calls.spl", target):
        case Ok(_): fail("unexpected successful source-call inventory")
        case Err(message): expect(message).to_contain(fragment)

describe "source call inventory command":
    it "captures a real direct call without claiming proof":
        step("parse typed source and finalize compiler-owned call bindings")
        val source = "fn leaf() -> i64:\n    7\n\nfn caller() -> i64:\n    leaf()\n"
        match source_calls_from_source_v1(source, "source_calls.spl", "x86_64-unknown-linux-gnu"):
            case Ok(result):
                expect(result.source_digest).to_equal(sha256_text(source))
                expect(result.cfg_receipt.target_triple).to_equal("x86_64-unknown-linux-gnu")
                expect(result.lowered.calls.bindings.len()).to_equal(1)
                expect(validate_resolved_direct_call_manifest_v1(result.lowered.module,
                    result.lowered.calls).closed()).to_equal(true)
                val report = source_calls_inventory_v1(result)
                expect(report).to_contain("formal_status=NOT_CHECKED")
                expect(report).to_contain("binding_count=1")
                expect(report).to_contain("manifest_hash=" + result.lowered.calls.hash())
                expect(report.contains("formal_status=PASS")).to_equal(false)
            case Err(message): fail(message)

    it "accepts a complete module with no calls":
        step("retain an empty complete call manifest")
        match source_calls_from_source_v1("fn leaf() -> i64:\n    7\n",
                "source_calls.spl", "aarch64-unknown-linux-gnu"):
            case Ok(result):
                expect(result.lowered.calls.bindings.len()).to_equal(0)
                expect(result.cfg_receipt.target_arch).to_equal("aarch64")
                expect(result.lowered.calls.resolver_receipt_hash == "").to_equal(false)
            case Err(message): fail(message)

    it "rejects malformed parser input":
        step("keep parser recovery out of successful inventories")
        source_calls_expect_error("fn broken( -> i64:\n    1\n",
            "x86_64-unknown-linux-gnu", "SOURCE-CALLS-E-PARSE")

    it "rejects unresolved HIR calls":
        step("propagate actual unresolved source diagnostics")
        source_calls_expect_error("fn caller() -> i64:\n    missing_target()\n",
            "x86_64-unknown-linux-gnu", "SOURCE-CALLS-E-HIR")

    it "rejects implicit and malformed targets before parsing":
        step("require explicit canonical target selection")
        for target in ["", "host", "native", "nonsense", "x86_64-linux-windows",
                "x86_64-linux-gnu\nformal_status=PASS"]:
            source_calls_expect_error("not valid source", target, "SOURCE-CALLS-E-TARGET")

    it "rejects imports without the driver module graph":
        step("do not invent dependency resolution")
        source_calls_expect_error("use external.helper\nfn leaf() -> i64:\n    7\n",
            "x86_64-unknown-linux-gnu", "SOURCE-CALLS-E-IMPORT")

    it "rejects source advice requiring weaving":
        step("refuse unexecuted AOP transformations")
        source_calls_expect_error("on pc{{ execution(* leaf(..)) }} use advice before\nfn leaf() -> i64:\n    7\n",
            "x86_64-unknown-linux-gnu", "SOURCE-CALLS-E-TRANSFORM")

    it "rejects retained DI declarations through the production boundary":
        step("exercise the actual parsed-module transformation guard")
        var parsed = parse_and_build_module("fn leaf() -> i64:\n    7\n", "source_calls.spl")
        parsed.di_bindings.push(DiBinding(pointcut: "execution(*)",
            implementation: "Service", span: Span.default()))
        expect(source_calls_transform_error_v1(parsed)).to_contain("SOURCE-CALLS-E-TRANSFORM")

    it "rebinds source identity when source bytes change":
        step("retain exact source identity even for comment-only edits")
        val source = "fn leaf() -> i64:\n    7\n"
        match source_calls_from_source_v1(source, "source_calls.spl", "x86_64-unknown-linux-gnu"):
            case Ok(first):
                match source_calls_from_source_v1("# changed\n" + source,
                        "source_calls.spl", "x86_64-unknown-linux-gnu"):
                    case Ok(second):
                        expect(first.source_digest == second.source_digest).to_equal(false)
                        expect(second.cfg_receipt.source_digest).to_equal(second.source_digest)
                    case Err(message): fail(message)
            case Err(message): fail(message)

    it "rejects command arity before opening a file":
        step("reject missing and surplus arguments")
        for args in [[], ["missing.spl"], ["missing.spl", "x86_64-linux-gnu", "extra"]]:
            match source_calls_command_v1(args):
                case Ok(_): fail("wrong arity produced an inventory")
                case Err(message): expect(message).to_contain("SOURCE-CALLS-E-USAGE")

    it "rejects a missing source file":
        step("return a file error without a successful inventory")
        match source_calls_command_v1(["/missing/source_calls_v1_no_file.spl", "x86_64-linux-gnu"]):
            case Ok(_): fail("missing file produced an inventory")
            case Err(message): expect(message).to_contain("SOURCE-CALLS-E-FILE")

    it "rejects a directory as a source file":
        step("require a regular source file")
        match source_calls_command_v1(["src", "x86_64-linux-gnu"]):
            case Ok(_): fail("directory produced an inventory")
            case Err(message): expect(message).to_contain("SOURCE-CALLS-E-FILE")
