# compound_assign_place_spec
# @req: REQ-COMP-COMPOUND-ASSIGNMENT-ON-A-STRUCT-FIELD-ON-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove that compound assignment on a struct field (one hop).
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""


"""
# Compound Assignment Resolves One Place (Load + Store)

**Category:** Compiler
**Status:** In Progress

Regression guard for
`doc/08_tracking/bug/jit_struct_field_compound_assign_loads_zero_2026-07-27.md`.

`place <op>= rhs` must read the CURRENT value of `place`, combine it with
`rhs`, and store the result back through the SAME place -- resolving that
place exactly once.

The MIR lowering (`src/compiler/50.mir/mir_lowering_stmts.spl`,
`MirLowering.lower_assign`) used to ignore the `op` for `Field` and `Index`
targets and hand the bare RHS local straight to `emit_set_field` /
`rt_array_set`. The load side was simply absent, so on the JIT/native path
(the DEFAULT engine) `obj.f += v` computed an observable `0 <op> v`:

| expression (n starts at 5) | before | expected |
|---|---|---|
| `s.n += 2` (one hop)                | 2  | 7  |
| `c.mid.inner.n += 4` then `+= 3`    | 3  | 7  |
| `arr[1] += 10` on `[1, 2, 3]`       | 10 | 12 |
| `t.n = t.n + 2` (explicit control)  | 7  | 7  |

## Engine coverage

These run on the DEFAULT engine (JIT/native), which is where the defect lives
and which accepts every form below. The tree-walking interpreter accepts only
the one-hop field form today: `SIMPLE_EXECUTION_MODE=interpreter` rejects both
`c.mid.inner.n += 4` ("invalid assignment: deeply nested augmented field
access requires intermediate variables") and `arr[i] += v` at the semantic
check, a separate frontend restriction outside this fix's scope. Where the
interpreter does support the form -- one-hop field, plain local, and every
explicit `t.n = t.n + 2` control -- it already produces these same absolute
values, so the two engines agree wherever they can be compared.

## Measured baseline before the fix (2026-07-27, Rust seed `bin/simple`)

`bin/simple run` on a probe: `s.n += 2` -> 2, `arr[1] += 10` -> 10,
`c.mid.inner.n += 4; += 3` -> 3. Under `bin/simple test` (a DIFFERENT
evaluator than `run` -- a long-standing landmine) this file scored 9/17:
the one-hop and two-hop field arms already pass there, while `arr[i] += v`
fails even though the explicit `arr[1] = arr[1] + 10` control passes -- which
isolates the dropped compound READ precisely. The two three-hop arms fail
together with their own explicit control `c.mid.inner.n = c.mid.inner.n + 2`,
so those two belong to the separate three-hop place-chain defect, not to this
one; they are kept here as absolute-value guards and are expected to go green
only once BOTH defects are fixed.

Every expectation below is an ABSOLUTE value, never a comparison against a
re-derived expression -- a lowering that drops the load must not be able to
drop it from both sides of an assertion and stay green. The explicit
`t.n = t.n + 2` control pins the same absolute answers through the path that
was never broken, so a regression is localised to the compound form.
"""

use std.spec


struct CaCounter:
    n: i64

struct CaInner:
    n: i64

struct CaMid:
    inner: CaInner

struct CaOuter:
    mid: CaMid


describe "compound assignment on a struct field (one hop)":

    it "adds to the field's current value, not to zero":
        step("Verify: adds to the field's current value, not to zero")
        # @req: REQ-COMP-COMPOUND-ASSIGNMENT-ON-A-STRUCT-FIELD-ON-001
        var s = CaCounter(n: 5)
        s.n += 2
        expect(s.n).to_equal(7)

    it "accumulates across repeated compound adds":
        step("Verify: accumulates across repeated compound adds")
        var s = CaCounter(n: 0)
        s.n += 4
        s.n += 3
        expect(s.n).to_equal(7)

    it "subtracts from the field's current value":
        step("Verify: subtracts from the field's current value")
        var s = CaCounter(n: 10)
        s.n -= 4
        expect(s.n).to_equal(6)

    it "multiplies the field's current value":
        step("Verify: multiplies the field's current value")
        var s = CaCounter(n: 6)
        s.n *= 7
        expect(s.n).to_equal(42)

    it "divides the field's current value":
        step("Verify: divides the field's current value")
        var s = CaCounter(n: 84)
        s.n /= 4
        expect(s.n).to_equal(21)


describe "compound assignment on a nested struct field (two and three hops)":

    it "two hops: mid.inner reads the current value":
        step("Verify: two hops: mid.inner reads the current value")
        var m = CaMid(inner: CaInner(n: 5))
        m.inner.n += 2
        expect(m.inner.n).to_equal(7)

    it "three hops: outer.mid.inner accumulates from zero":
        step("Verify: three hops: outer.mid.inner accumulates from zero")
        var c = CaOuter(mid: CaMid(inner: CaInner(n: 0)))
        c.mid.inner.n += 4
        c.mid.inner.n += 3
        expect(c.mid.inner.n).to_equal(7)

    it "three hops: outer.mid.inner starting non-zero":
        step("Verify: three hops: outer.mid.inner starting non-zero")
        var c = CaOuter(mid: CaMid(inner: CaInner(n: 5)))
        c.mid.inner.n += 2
        expect(c.mid.inner.n).to_equal(7)


describe "compound assignment on an array element":

    it "adds to the element's current value, not to zero":
        step("Verify: adds to the element's current value, not to zero")
        var arr = [1, 2, 3]
        arr[1] += 10
        expect(arr[1]).to_equal(12)

    it "leaves the untouched elements alone":
        step("Verify: leaves the untouched elements alone")
        var arr = [1, 2, 3]
        arr[1] += 10
        expect(arr[0]).to_equal(1)
        expect(arr[2]).to_equal(3)

    it "accumulates across repeated compound adds on one element":
        step("Verify: accumulates across repeated compound adds on one element")
        var arr = [0, 0, 0]
        arr[2] += 4
        arr[2] += 3
        expect(arr[2]).to_equal(7)

    it "subtracts from the element's current value":
        step("Verify: subtracts from the element's current value")
        var arr = [10, 20, 30]
        arr[0] -= 4
        expect(arr[0]).to_equal(6)


describe "compound assignment evaluates the place subexpression exactly once":

    it "does not double-apply the index when the index comes from a var":
        step("Verify: does not double-apply the index when the index comes from a var")
        # A lowering that resolved the place twice (once for the load, once
        # for the store) would show up here as a write to the wrong slot.
        var arr = [1, 2, 3]
        var i = 1
        arr[i] += 10
        expect(arr[0]).to_equal(1)
        expect(arr[1]).to_equal(12)
        expect(arr[2]).to_equal(3)


describe "explicit read-modify-write control (never broken)":

    it "one hop: t.n = t.n + 2":
        step("Verify: one hop: t.n = t.n + 2")
        var t = CaCounter(n: 5)
        t.n = t.n + 2
        expect(t.n).to_equal(7)

    it "three hops: c.mid.inner.n = c.mid.inner.n + 2":
        step("Verify: three hops: c.mid.inner.n = c.mid.inner.n + 2")
        var c = CaOuter(mid: CaMid(inner: CaInner(n: 5)))
        c.mid.inner.n = c.mid.inner.n + 2
        expect(c.mid.inner.n).to_equal(7)

    it "array element: arr[1] = arr[1] + 10":
        step("Verify: array element: arr[1] = arr[1] + 10")
        var arr = [1, 2, 3]
        arr[1] = arr[1] + 10
        expect(arr[1]).to_equal(12)

    it "local variable compound assign (the arm that already worked)":
        step("Verify: local variable compound assign (the arm that already worked)")
        var n = 5
        n += 2
        expect(n).to_equal(7)
