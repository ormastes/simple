extern fn rt_file_read_text(path: text) -> text

describe("parser types Lexer ownership"):
    it("imports Lexer from the concrete frontend owner"):
        val source = rt_file_read_text("src/compiler/frontend/parser_types.spl") ?? ""
        expect(source.contains("use compiler.frontend.core.lexer.{Lexer}")).to_equal(true)
        expect(source.contains("lexer: Lexer")).to_equal(true)
