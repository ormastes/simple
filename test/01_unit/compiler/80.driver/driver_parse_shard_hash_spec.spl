use std.spec
use compiler.driver.driver_parse_shard_hash.{driver_parse_shard_hash}

# Shard ownership is `hash % count == index`; a negative hash owns no shard
# but 0, which silently dropped ~45% of modules from an 8-way static split.
describe "driver_parse_shard_hash":
    it "is non-negative and covers every shard of an 8-way split":
        var seen: [i64] = [0, 0, 0, 0, 0, 0, 0, 0]
        var negatives = 0
        var i = 0
        while i < 256:
            val h = driver_parse_shard_hash("src/compiler/m{i}.spl")
            if h < 0:
                negatives = negatives + 1
            else:
                seen[h % 8] = seen[h % 8] + 1
            i = i + 1
        expect(negatives).to_equal(0)
        for s in seen:
            expect(s > 0).to_equal(true)

    it "is a pure function of the path":
        val a = driver_parse_shard_hash("src/app/cli/bootstrap_main.spl")
        val b = driver_parse_shard_hash("src/app/cli/bootstrap_main.spl")
        expect(a).to_equal(b)
