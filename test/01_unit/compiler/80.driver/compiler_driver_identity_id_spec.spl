# @req REQ-SSPEC-COMPILER
"""
# CompilerDriver identity id

Per-compilation pins and holds key on `driver.identity_id`, a process-unique
non-zero id, not on an object address (`driver as i64` is not castable in the
seed interpreter: `cannot cast object to i64`). The id must be distinct per
driver, non-zero, and unchanged by field writes.
"""

# @tag:unit
# @tag:compiler
# @tag:driver

use std.spec.{describe, it, expect}
use compiler.driver.driver_compiler_type.{CompilerDriver, compiler_driver_next_identity_v1}
use compiler.common.driver_compile_options.{CompileOptions}

describe "CompilerDriver identity id":
    it "hands out strictly increasing non-zero ids":
        val a = compiler_driver_next_identity_v1()
        val b = compiler_driver_next_identity_v1()
        expect(a > 0).to_equal(true)
        expect(b > a).to_equal(true)

    it "gives each created driver a distinct id that survives a field write":
        val d1 = CompilerDriver.create(CompileOptions.default())
        val d2 = CompilerDriver.create(CompileOptions.default())
        expect(d1.identity_id > 0).to_equal(true)
        expect(d1.identity_id == d2.identity_id).to_equal(false)
        val before = d1.identity_id
        d1.streaming_surface_owner_ready = true
        d1.hir_archive_schedule = nil
        expect(d1.identity_id).to_equal(before)
