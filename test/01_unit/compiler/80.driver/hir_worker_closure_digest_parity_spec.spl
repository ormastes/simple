# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

"""
## Purpose and audience
A HIR shard worker builds every module surface from the SURFACE SKELETON
(`module_surface_skeleton_v1`: non-generic bodies blanked) while MIR shard
workers and the final worker build them from the full source. All three fold
every frozen surface into `hir_cache_closure_digest`, the closure half of the
HIR cache key, so the skeleton surface must equal the full-parse surface or
the HIR pool warms entries nobody can read.

Four surface facts are derived from a function BODY and were lost with it:
the implicit-static promotion of `fn new|create|default|from_*` (static only
when the body text never mentions `self`, parser_decls_use.spl), body-level
contract clauses (`in:`, `out(r):`, ... retained on the function), body-level
`extern fn` (registered as a MODULE declaration) and the await points of an
`async fn` (the desugarer generates a state enum and a poll function from
them). The skeleton keeps every such body verbatim, so the parser reads the
same text on both sides whatever its rule is. Bootstrap run 31 (2026-11-14):
one such method in a 1664-module closure moved the closure digest, so the MIR
shard worker missed all 1664 warm entries and lowered the whole closure a
second time.
Audience: compiler engineers maintaining the HIR cache and the shard route.
"""

# @tag: unit, compiler, driver, cache

use std.spec.{describe, it, expect}
use std.spec.step
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserModule}
use compiler.driver.driver_hir_cache.{hir_cache_closure_digest, hir_cache_closure_fallback_count_v1}
use compiler.driver.cache.module_surface_skeleton_v1.{module_surface_skeleton_v1}
use compiler.driver.cache.tldr_frozen_projection_v1.{tldr_frozen_span_projection_v1}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_canonical_digest_v1.{module_surface_canonical_digest_v1}
use test.helpers.module_surface_owner_fixture.{module_surfaces_from_test_modules}

# `create` is an implicitly-static NAME; its body decides: `body` mentioning
# `self` keeps it an instance method, any other body makes it static.
fn wcd_event(body: text) -> text:
    "pub class Ev:\n    backend: i64\n\n    fn create() -> i64:\n        {body}\n\n    fn new() -> i64:\n        val seven = 7\n        seven\n"

val WCD_USER: text = "use wcd.ev.\{Ev\}\n\npub fn run() -> i64:\n    val out = Ev.new()\n    out\n"
val WCD_CONTRACT_IN: text = "pub fn div(a: i64, b: i64) -> i64:\n    in: b != 0\n    val q = a / b\n    q\n"
val WCD_CONTRACT_OUT: text = "pub fn inc(a: i64) -> i64:\n    out(ret): ret > a\n    val next = a + 1\n    next\n"

# Same class with the method under test named `name`; its body uses `self`.
fn wcd_named(name: text) -> text:
    "pub class Ev:\n    backend: i64\n\n    fn {name}() -> i64:\n        self.backend + 1\n"

val WCD_EXTERN_BODY: text = "pub fn now() -> i64:\n    extern fn rt_time_millis() -> i64\n    rt_time_millis()\n"
val WCD_ASYNC_AWAIT: text = "pub async fn inner() -> i64:\n    7\n\npub async fn outer() -> i64:\n    val a = await inner()\n    a + 1\n"
val WCD_PLAIN_SELF_COMMENT: text = "pub fn run() -> i64:\n    # self-check of the runner\n    7\n"

# Module-level declaration names after desugaring: what an importer can see.
fn wcd_decl_names(source: text) -> text:
    val module = parse_full_frontend(source, "wcd/ev.spl", "wcd.ev", Logger(level: 0))
    "fns=" + module.functions.keys().join(",") + " enums=" + module.enums.keys().join(",")

fn wcd_digest(source: text) -> text:
    module_surface_canonical_digest_v1(parse_full_frontend(source, "wcd/ev.spl", "wcd.ev", Logger(level: 0)))

fn wcd_skeleton_digest(source: text) -> text:
    wcd_digest(module_surface_skeleton_v1(source))

# Frozen two-module closure. `worker` true parses every module's skeleton, as
# a HIR shard worker does; identity fields always come from the real source.
fn wcd_registry(event_source: text, worker: bool) -> ModuleSurfacesByName:
    val log = Logger(level: 0)
    val ev_text = if worker: module_surface_skeleton_v1(event_source) else: event_source
    val user_text = if worker: module_surface_skeleton_v1(WCD_USER) else: WCD_USER
    var modules: Dict<text, ParserModule> = {}
    modules["wcd.ev"] = parse_full_frontend(ev_text, "wcd/ev.spl", "wcd.ev", log)
    modules["wcd.user"] = parse_full_frontend(user_text, "wcd/user.spl", "wcd.user", log)
    val sources = [
        SourceFile(path: "wcd/ev.spl", content: event_source, module_name: "wcd.ev"),
        SourceFile(path: "wcd/user.spl", content: WCD_USER, module_name: "wcd.user")
    ]
    module_surfaces_from_test_modules(modules, sources).unwrap()

describe "surface skeleton keeps body-derived function facts":
    it "keeps an implicitly-static-named method that uses self an instance method":
        val source = wcd_event("self.backend + 1")
        expect(wcd_skeleton_digest(source)).to_equal(wcd_digest(source))

    it "keeps a self mention that exists only in a body comment":
        step("The parser is conservative: `self` anywhere in the body text counts")
        val source = wcd_event("1  # self is unused here")
        expect(wcd_skeleton_digest(source)).to_equal(wcd_digest(source))

    it "leaves a body that never mentions self static and unmarked":
        val source = wcd_event("41 + 1")
        expect(wcd_skeleton_digest(source)).to_equal(wcd_digest(source))
        expect(module_surface_skeleton_v1(source).contains("self")).to_equal(false)

    it "leaves the decision on an identifier containing self to the parser":
        step("The body is kept verbatim, so skeleton and source cannot disagree")
        val source = wcd_event("val selfish = 2\n        selfish")
        expect(wcd_skeleton_digest(source)).to_equal(wcd_digest(source))
        expect(module_surface_skeleton_v1(source).contains("val selfish = 2")).to_equal(true)

    it "agrees with the parser when multibyte text precedes a self-prefixed identifier":
        step("The parser's self check mixes byte and code-point offsets on such a body")
        val source = wcd_event("val note = \"ééééééééééééééééééééééééé\"\n        val selfx = 2\n        selfx")
        expect(wcd_skeleton_digest(source)).to_equal(wcd_digest(source))

    it "keeps one stub form for every blanked body":
        step("tldr_frozen_span_projection_v1 matches the stub line exactly")
        val skeleton = module_surface_skeleton_v1(WCD_PLAIN_SELF_COMMENT)
        expect(skeleton.split("\n")[1]).to_equal("    pass_do_nothing")
        expect(tldr_frozen_span_projection_v1(WCD_PLAIN_SELF_COMMENT).is_some()).to_equal(true)

    it "agrees with the parser for every constructor-like method name":
        step("A name the parser starts promoting must be kept by the skeleton too")
        for name in ["new", "create", "default", "from_text", "with_fix", "init", "of", "empty", "make", "build", "open", "value"]:
            val source = wcd_named(name)
            expect(wcd_skeleton_digest(source)).to_equal(wcd_digest(source))

    it "keeps a precondition clause written in the body":
        expect(wcd_skeleton_digest(WCD_CONTRACT_IN)).to_equal(wcd_digest(WCD_CONTRACT_IN))

    it "keeps a postcondition clause with a binding":
        expect(wcd_skeleton_digest(WCD_CONTRACT_OUT)).to_equal(wcd_digest(WCD_CONTRACT_OUT))

    it "keeps a body-level extern fn, which declares a module-level symbol":
        expect(wcd_skeleton_digest(WCD_EXTERN_BODY)).to_equal(wcd_digest(WCD_EXTERN_BODY))
        expect(module_surface_skeleton_v1(WCD_EXTERN_BODY)).to_equal(WCD_EXTERN_BODY)

    it "keeps an async fn body, whose await points generate declarations":
        step("Awaiting: state enum + poll function; not awaiting: one ready-body helper")
        expect(wcd_decl_names(module_surface_skeleton_v1(WCD_ASYNC_AWAIT))).to_equal(wcd_decl_names(WCD_ASYNC_AWAIT))
        expect(module_surface_skeleton_v1(WCD_ASYNC_AWAIT)).to_equal(WCD_ASYNC_AWAIT)

    it "still blanks ordinary bodies and keeps every line on its source line":
        step("Only the self-mentioning constructor-like body is kept")
        val source = wcd_event("self.backend + 1") + "\n    fn value() -> i64:\n        self.backend + 2\n"
        val skeleton = module_surface_skeleton_v1(source)
        expect(skeleton.contains("self.backend + 1")).to_equal(true)
        expect(skeleton.contains("self.backend + 2")).to_equal(false)
        expect(skeleton.contains("val seven = 7")).to_equal(false)
        expect(skeleton.split("\n").len()).to_equal(source.split("\n").len())

describe "HIR shard worker closure digest equals the full-surface digest":
    it "matches when a closure module has a self-using create method":
        step("Worker surfaces come from skeletons, consumer surfaces from full sources")
        val source = wcd_event("self.backend + 1")
        val fallbacks_before = hir_cache_closure_fallback_count_v1()
        val consumer = hir_cache_closure_digest(wcd_registry(source, false))
        val worker = hir_cache_closure_digest(wcd_registry(source, true))
        expect(consumer.len()).to_equal(64)
        expect(worker).to_equal(consumer)
        step("Both closures were keyed by interface, none fell back to bytes")
        expect(hir_cache_closure_fallback_count_v1()).to_equal(fallbacks_before)

    it "still moves in the worker when the method really becomes static":
        step("Same class; only whether create's body mentions self differs")
        val instance = wcd_event("self.backend + 1")
        val promoted = wcd_event("41 + 1")
        expect(hir_cache_closure_digest(wcd_registry(promoted, false))).to_not_equal(hir_cache_closure_digest(wcd_registry(instance, false)))
        expect(hir_cache_closure_digest(wcd_registry(promoted, true))).to_not_equal(hir_cache_closure_digest(wcd_registry(instance, true)))
