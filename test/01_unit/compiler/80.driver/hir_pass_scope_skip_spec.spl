# @req: hir_semantic_pass_scope_dangling_hirtype_2026-11-24 - per-pass scope bisect switch.
"""
Purpose: SIMPLE_HIR_SEMANTIC_PASS_SCOPE_SKIP names passes that run unscoped.
Audience: compiler memory maintainers.
"""
# @tag: unit, compiler, memory

use std.spec.*
use compiler.driver.driver_hir_pipeline_passes.{hir_pass_scope_skipped_v1}

describe "hir semantic pass scope skip list":
    it "matches a named pass in a comma list":
        expect(hir_pass_scope_skipped_v1("typecheck,representation_manifest", "representation_manifest")).to_equal(true)
    it "tolerates spaces":
        expect(hir_pass_scope_skipped_v1("typecheck, any_escape", "any_escape")).to_equal(true)
    it "does not match prefixes or other passes":
        expect(hir_pass_scope_skipped_v1("representation_manifest", "representation_bind")).to_equal(false)
    it "empty list skips nothing":
        expect(hir_pass_scope_skipped_v1("", "typecheck")).to_equal(false)
