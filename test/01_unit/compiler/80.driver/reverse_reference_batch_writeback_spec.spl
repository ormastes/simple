# @req REQ-SSPEC-COMPILER
"""
# Reverse-reference module batch survives mutation through unwrap()

`reverse_reference_facts` mutates its module batch via
`_reverse_reference_module_batch_v1.unwrap()`. Once the driver pipeline is
loaded, the seed interpreter hands `unwrap()` a copy, so every mutation must be
stored back. Measured before the fix (through
`driver_publish_reverse_reference_parse_scope_v1`): seal-only write-back gave
publish=true but facts=0, known=0, aliases=0 and a falsely complete family.
"""

# @tag:unit
# @tag:compiler
# @tag:driver

use std.spec.{describe, it, expect, step}
use compiler.common.cache.reverse_reference_facts.{reverse_reference_owner_begin_v1,
    reverse_reference_owner_end_v1, reverse_reference_module_begin_v1,
    reverse_reference_module_seal_v1, reverse_reference_module_publish_v1,
    reverse_reference_module_abort_v1,
    reverse_reference_owner_register_v1, reverse_reference_owner_snapshot_v1,
    reverse_reference_owner_register_source_alias_v1,
    reverse_reference_owner_source_aliases_v1,
    reverse_reference_owner_mark_incomplete_v1,
    reverse_reference_owner_family_complete_v1}
use compiler.driver.driver_hir_pipeline_support.{driver_publish_reverse_reference_parse_scope_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

describe "reverse-reference module batch write-back":
    it "publishes every fact, family and alias recorded in the batch":
        # @req REQ-SSPEC-COMPILER-RRBATCH-001
        expect(reverse_reference_owner_begin_v1()).to_equal(true)
        expect(transient_scope_begin()).to_equal(true)
        val token = reverse_reference_module_begin_v1()
        reverse_reference_owner_register_v1("fam", "subject", "consumer", "evidence")
        reverse_reference_owner_register_source_alias_v1("id1", "src1")
        reverse_reference_owner_mark_incomplete_v1("famx")
        expect(transient_scope_pause()).to_equal(true)
        step("Publish through seal, parse-scope end and publication, then read back every array the batch owned")
        expect(driver_publish_reverse_reference_parse_scope_v1(token)).to_equal(true)
        val snapshot = reverse_reference_owner_snapshot_v1()
        expect(snapshot.facts.len()).to_equal(1)
        expect(snapshot.known_families.len()).to_equal(1)
        expect(reverse_reference_owner_source_aliases_v1("id1").len()).to_equal(1)
        expect(reverse_reference_owner_family_complete_v1("famx")).to_equal(false)
        reverse_reference_owner_end_v1()

    it "keeps the seal: a second seal is refused and late registration invalidates":
        expect(reverse_reference_owner_begin_v1()).to_equal(true)
        expect(transient_scope_begin()).to_equal(true)
        val token = reverse_reference_module_begin_v1()
        reverse_reference_owner_register_v1("fam", "subject", "consumer", "evidence")
        expect(transient_scope_pause()).to_equal(true)
        expect(reverse_reference_module_seal_v1(token)).to_equal(true)
        expect(reverse_reference_module_seal_v1(token)).to_equal(false)
        reverse_reference_owner_register_v1("late", "subject", "consumer", "evidence")
        expect(transient_scope_end()).to_equal(true)
        expect(reverse_reference_module_publish_v1(token)).to_equal(false)
        # The refused batch is still pending (snapshot includes it); abort drops it.
        expect(reverse_reference_module_abort_v1(token)).to_equal(true)
        expect(reverse_reference_owner_snapshot_v1().facts.len()).to_equal(0)
        reverse_reference_owner_end_v1()
