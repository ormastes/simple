# @tag:phase3
use std.spec.*
use std.io_runtime.{cwd}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.test_runner.test_executor_parsing.{find_simple_binary}

# optional_array_payload_narrowing_native_2026_10_21.
# Native lowering must unwrap an optional-array receiver after an authored nil
# guard. -- the defect is native-only; the seed interpreter cannot
# reproduce it, so these examples pin the SEMANTICS the native build must match.
# Native verification (stage3, expected: no diff, exit 0):
#   bin/simple native-build --entry test/fixtures/compiler/n88b_native_producer_idioms_native.spl -o build/n88b_idioms.exe && build/n88b_idioms.exe | diff - test/fixtures/compiler/n88b_native_producer_idioms_native.spl.expected

fn run_fixture(path: text) -> text:
    val (out, _err, _code) = process_run_bounded(find_simple_binary(), ["run", cwd() + "/" + path], 120000, 65536)
    out

describe "optional array payload narrowing":
    it "REPRO/parity: original idioms produce the expected output (native lane compares the same file)":
        val out = run_fixture("test/fixtures/compiler/n88b_native_producer_idioms_native.spl")
        expect(out).to_contain("NARROW_3_-1")
        expect(out).to_contain("BINDER_6_0")

    it "PREVENTION: nil-guard narrowing semantics for len/is_empty/for-in on [T]? hold for several shapes":
        val out = run_fixture("test/fixtures/compiler/optional_array_narrowing_shapes.spl")
        expect(out).to_contain("LEN_3_-1")
        expect(out).to_contain("EMPTY_false_true")
        expect(out).to_contain("SUM_6_0")
