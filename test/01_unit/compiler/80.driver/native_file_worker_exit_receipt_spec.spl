# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @cover src/compiler/80.driver/driver_build/native_file_worker_v1.spl 0%
"""
# Shard child exit receipt (BUG-WIN-HIR-WORKER-DIAGNOSTICS-20261010)

A shard child that exits nonzero without its own reason leaves a receipt so the
coordinator's first-error line is never empty when stderr is not transported.
"""
use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use compiler.driver.driver_build.native_file_worker_v1.{
    native_file_worker_error_reason_publish_v1, native_file_worker_error_reason_read_v1,
    native_file_worker_exit_receipt_publish_v1}
use std.io_runtime.{dir_create_all, dir_remove_all}

fn fresh_queue(name: text) -> text:
    val dir = "build/spec_{name}"
    val _removed = dir_remove_all(dir)
    val _made = dir_create_all(dir)
    dir

describe "shard child exit receipt":
    it "publishes a receipt for a nonzero exit with no reason":
        val queue = fresh_queue("exit_receipt_a")
        assert_true(native_file_worker_exit_receipt_publish_v1(queue, "0/8@0", "hir-shard", 1))
        val reason = native_file_worker_error_reason_read_v1(queue, "0/8@0")
        assert_true(reason.contains("hir-shard child exited 1"))

    it "keeps a reason the child published itself":
        val queue = fresh_queue("exit_receipt_b")
        assert_true(native_file_worker_error_reason_publish_v1(queue, "1/8@0", "module=x failed"))
        assert_true(native_file_worker_exit_receipt_publish_v1(queue, "1/8@0", "hir-shard", 1))
        assert_equal(native_file_worker_error_reason_read_v1(queue, "1/8@0"), "module=x failed")

    it "publishes nothing for a clean exit or a missing queue":
        val queue = fresh_queue("exit_receipt_c")
        assert_false(native_file_worker_exit_receipt_publish_v1(queue, "2/8@0", "hir-shard", 0))
        assert_equal(native_file_worker_error_reason_read_v1(queue, "2/8@0"), "")
        assert_false(native_file_worker_exit_receipt_publish_v1("", "2/8@0", "hir-shard", 1))
