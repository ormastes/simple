use std.spec
use std.io_runtime.{file_exists, file_write, file_delete, mkdir_p, process_run}
use compiler.backend.llvm_capability.{find_archive_portable}
use compiler.driver.driver_build.library_unit_plan_v1.{library_unit_cache_key_v1}
use compiler.driver.driver_build.library_unit_archive_v1.{
    LibraryUnitReceiptV1, library_unit_archive_dir_v1, library_unit_archive_path_v1,
    library_unit_receipt_path_v1, library_unit_iface_path_v1,
    library_unit_receipt_encode_v1, library_unit_receipt_decode_v1,
    library_unit_archive_write_v1, library_unit_receipt_publish_v1,
    library_unit_receipt_read_v1, library_unit_archive_complete_v1}

# Design: doc/05_design/compiler/incremental_build/library_unit_build_and_link.md §3-4
# Slice 3: archive writer (reuses archive_command_build) + write-once receipt.sdn.

val PRODUCER = "exe=4:abcd;compiler=1:x"
val SCOPE = "lane=7:default;backend=4:llvm"
val DEPS = [("simple-rust-runtime", "ifaceA"), ("simple.runtime", "ifaceB")]

fn receipt(unit: text, verdict: text) -> LibraryUnitReceiptV1:
    val key = library_unit_cache_key_v1(PRODUCER, "src-digest", DEPS)
    LibraryUnitReceiptV1(unit: unit, unit_key: key, scope_key: SCOPE, producer_identity: PRODUCER,
        source_digest: "src-digest", iface_digest: "iface-digest", deps: DEPS,
        objects: ["a.o", "sub_b.o"], verdict: verdict, failed_modules: [])

describe "library unit archive layout":
    it "places every artifact under <cache_root>/units/<unit>/<unit_key>":
        val dir = library_unit_archive_dir_v1("build/cache/lane", "simple-std", "k1")
        expect(dir).to_equal("build/cache/lane/units/simple-std/k1")
        expect(library_unit_archive_path_v1(dir, "simple-std")).to_equal("build/cache/lane/units/simple-std/k1/libsimple-std.a")
        expect(library_unit_receipt_path_v1(dir)).to_equal("build/cache/lane/units/simple-std/k1/receipt.sdn")
        expect(library_unit_iface_path_v1(dir)).to_equal("build/cache/lane/units/simple-std/k1/iface.sdn")

describe "library_unit_receipt encode/decode":
    it "round-trips through SDN text":
        val r = receipt("simple-std", "ok")
        match library_unit_receipt_decode_v1(library_unit_receipt_encode_v1(r)):
            case Ok(back):
                expect(back.unit).to_equal("simple-std")
                expect(back.unit_key).to_equal(r.unit_key)
                expect(back.scope_key).to_equal(SCOPE)
                expect(back.producer_identity).to_equal(PRODUCER)
                expect(back.deps.len()).to_equal(2)
                val (dep_name, dep_iface) = back.deps[1]
                expect(dep_name).to_equal("simple.runtime")
                expect(dep_iface).to_equal("ifaceB")
                expect(back.objects.len()).to_equal(2)
                expect(back.verdict).to_equal("ok")
            case Err(e):
                expect(e).to_equal("")

    it "fails closed on a unit_key that does not match producer+source+deps, a bad verdict, or a foreign format":
        val r = receipt("simple-std", "ok")
        val forged = LibraryUnitReceiptV1(unit: r.unit, unit_key: "0000", scope_key: r.scope_key,
            producer_identity: r.producer_identity, source_digest: r.source_digest, iface_digest: r.iface_digest,
            deps: r.deps, objects: r.objects, verdict: r.verdict, failed_modules: [])
        expect(library_unit_receipt_decode_v1(library_unit_receipt_encode_v1(forged)).is_err()).to_equal(true)
        val odd = receipt("simple-std", "maybe")
        expect(library_unit_receipt_decode_v1(library_unit_receipt_encode_v1(odd)).is_err()).to_equal(true)
        val foreign = library_unit_receipt_encode_v1(r).replace("simple/library-unit-receipt/v1", "simple/other/v1")
        expect(library_unit_receipt_decode_v1(foreign).is_err()).to_equal(true)
        expect(library_unit_receipt_decode_v1("").is_err()).to_equal(true)

    it "requires a failed verdict to name at least one failed module":
        val r = receipt("simple-std", "failed")
        expect(library_unit_receipt_decode_v1(library_unit_receipt_encode_v1(r)).is_err()).to_equal(true)

describe "library_unit_archive_write_v1 + receipt publish":
    val ROOT = "build/spec_library_unit_archive_v1"

    it "archives the unit objects with the portable archiver and lists them back":
        val dir = library_unit_archive_dir_v1(ROOT, "unit-a", "key-archive")
        expect(mkdir_p("{dir}/objects")).to_equal(true)
        expect(file_write("{dir}/objects/a.o", "object a\n")).to_equal(true)
        expect(file_write("{dir}/objects/sub_b.o", "object b\n")).to_equal(true)
        val archive = library_unit_archive_path_v1(dir, "unit-a")
        val _removed = file_delete(archive)
        val archiver = find_archive_portable()
        match library_unit_archive_write_v1(dir, "unit-a", ["a.o", "sub_b.o"]):
            case Ok(path):
                expect(archiver == "").to_equal(false)
                expect(path).to_equal(archive)
                expect(file_exists(archive)).to_equal(true)
                val (listing, _err, code) = process_run(archiver, ["t", archive])
                expect(code).to_equal(0)
                expect(listing.contains("a.o")).to_equal(true)
                expect(listing.contains("sub_b.o")).to_equal(true)
            case Err(e):
                # No archiver on this host: the writer must say so, never pass silently.
                expect(archiver).to_equal("")
                expect(e.contains("archiver")).to_equal(true)

    it "refuses an empty object list and a missing object":
        val dir = library_unit_archive_dir_v1(ROOT, "unit-a", "key-empty")
        expect(mkdir_p("{dir}/objects")).to_equal(true)
        expect(library_unit_archive_write_v1(dir, "unit-a", []).is_err()).to_equal(true)
        expect(library_unit_archive_write_v1(dir, "unit-a", ["missing.o"]).is_err()).to_equal(true)

    it "publishes a receipt once and reports completeness only with archive + ok verdict":
        val dir = library_unit_archive_dir_v1(ROOT, "unit-a", "key-receipt")
        expect(mkdir_p("{dir}/objects")).to_equal(true)
        val _r = file_delete(library_unit_receipt_path_v1(dir))
        val _a = file_delete(library_unit_archive_path_v1(dir, "unit-a"))
        expect(library_unit_archive_complete_v1(dir, "unit-a").is_err()).to_equal(true)
        expect(library_unit_receipt_publish_v1(dir, receipt("unit-a", "ok")).is_ok()).to_equal(true)
        # write-once: a second publish under the same key is refused, first content stays
        expect(library_unit_receipt_publish_v1(dir, receipt("unit-a", "ok")).is_err()).to_equal(true)
        match library_unit_receipt_read_v1(dir):
            case Ok(back):
                expect(back.unit).to_equal("unit-a")
            case Err(e):
                expect(e).to_equal("")
        # receipt ok but no archive file yet -> not complete
        expect(library_unit_archive_complete_v1(dir, "unit-a").is_err()).to_equal(true)
        expect(file_write(library_unit_archive_path_v1(dir, "unit-a"), "!<arch>\n")).to_equal(true)
        match library_unit_archive_complete_v1(dir, "unit-a"):
            case Ok(path):
                expect(path).to_equal(library_unit_archive_path_v1(dir, "unit-a"))
            case Err(e):
                expect(e).to_equal("")

    it "a failed receipt is never complete even with an archive present":
        val dir = library_unit_archive_dir_v1(ROOT, "unit-a", "key-failed")
        expect(mkdir_p(dir)).to_equal(true)
        val _r = file_delete(library_unit_receipt_path_v1(dir))
        val failed = receipt("unit-a", "failed")
        val named = LibraryUnitReceiptV1(unit: failed.unit, unit_key: failed.unit_key, scope_key: failed.scope_key,
            producer_identity: failed.producer_identity, source_digest: failed.source_digest,
            iface_digest: failed.iface_digest, deps: failed.deps, objects: [], verdict: "failed",
            failed_modules: ["broken.spl"])
        expect(library_unit_receipt_publish_v1(dir, named).is_ok()).to_equal(true)
        expect(file_write(library_unit_archive_path_v1(dir, "unit-a"), "!<arch>\n")).to_equal(true)
        match library_unit_archive_complete_v1(dir, "unit-a"):
            case Ok(_):
                expect("complete").to_equal("Err expected")
            case Err(e):
                expect(e.contains("failed")).to_equal(true)
