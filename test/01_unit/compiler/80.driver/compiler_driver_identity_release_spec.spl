# @req REQ-SSPEC-COMPILER
"""
# CompilerDriver identity teardown

Per-compilation holds and pins key on the never-reused `driver.identity_id`.
`driver_hir_archive_production_release_v1` (called at the end of
`CompilerDriver.compile()`) must remove every entry the driver created, so
long-lived processes (daemon, LSP, MCP) do not grow one entry per driver.
`begin` alone populates the production hold; current/semantic pins need real
archive owners, so here they are only checked to stay at baseline.
"""

# @tag:unit
# @tag:compiler
# @tag:driver

use std.spec.{describe, it, expect}
use compiler.driver.driver_compiler_type.{CompilerDriver, compiler_driver_next_identity_v1}
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.driver.driver_hir_archive_production_controller_v1.{
    driver_hir_archive_production_begin_v1, driver_hir_archive_production_finish_v1,
    driver_hir_archive_production_release_v1, driver_hir_archive_production_hold_count_v1}
use compiler.driver.cache.driver_hir_archive_current_boundary_v1.{driver_hir_archive_current_boundary_pin_count_v1}
use compiler.driver.cache.driver_hir_archive_semantic_prerequisite_v1.{driver_hir_archive_semantic_prerequisite_pin_count_v1}

describe "CompilerDriver identity teardown":
    it "returns the hold and pin dicts to baseline after N drivers are released":
        val holds = driver_hir_archive_production_hold_count_v1()
        val current = driver_hir_archive_current_boundary_pin_count_v1()
        val semantic = driver_hir_archive_semantic_prerequisite_pin_count_v1()
        var last_id: i64 = 0
        for i in 0..8:
            val driver = CompilerDriver.create(CompileOptions.default())
            expect(driver.identity_id > last_id).to_equal(true)
            last_id = driver.identity_id
            expect(driver_hir_archive_production_begin_v1(driver)).to_equal(true)
            expect(driver_hir_archive_production_hold_count_v1()).to_equal(holds + 1)
            expect(driver_hir_archive_production_finish_v1(driver)).to_equal(true)
            # finish leaves a phase -2 tombstone; release drops it.
            expect(driver_hir_archive_production_hold_count_v1()).to_equal(holds + 1)
            expect(driver_hir_archive_production_release_v1(driver)).to_equal(true)
            expect(driver_hir_archive_production_hold_count_v1()).to_equal(holds)
        expect(driver_hir_archive_current_boundary_pin_count_v1()).to_equal(current)
        expect(driver_hir_archive_semantic_prerequisite_pin_count_v1()).to_equal(semantic)
        # Released ids are never handed out again.
        expect(compiler_driver_next_identity_v1() > last_id).to_equal(true)

    it "is a no-op for a driver that never compiled":
        val holds = driver_hir_archive_production_hold_count_v1()
        val driver = CompilerDriver.create(CompileOptions.default())
        expect(driver_hir_archive_production_release_v1(driver)).to_equal(true)
        expect(driver_hir_archive_production_hold_count_v1()).to_equal(holds)
