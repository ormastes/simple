use std.spec.*
use compiler.driver.driver_hir_cache.{hir_cache_key}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_scope}
use std.io_runtime.{env_get, env_set, env_remove_process}

val SRC = "test/fixtures/compiler/hir_cache_source_identity/left.spl"
val CLOSURE = "same-frozen-closure"

# Run a cache key function with an env var set, then restore its exact prior state
# (unset when it was previously absent).
fn _hir_key_with_env(name: text, value: text) -> text:
    val old = env_get(name)
    env_set(name, value)
    val key = hir_cache_key(SRC, CLOSURE, false)
    _restore_env(name, old)
    key

fn _restore_env(name: text, old: text?):
    if old.?:
        env_set(name, old ?? "")
    else:
        env_remove_process(name)

describe "SIMPLE_HIR_CFG_SELECT cache key separation":
    it "HIR cache key differs when SIMPLE_HIR_CFG_SELECT is set vs unset":
        val off = _hir_key_with_env("SIMPLE_HIR_CFG_SELECT", "")
        val on = _hir_key_with_env("SIMPLE_HIR_CFG_SELECT", "1")
        expect(off.len()).to_equal(64)
        expect(on.len()).to_equal(64)
        expect(off == on).to_equal(false)

    it "HIR cache key is stable with the same SIMPLE_HIR_CFG_SELECT value":
        val key1 = _hir_key_with_env("SIMPLE_HIR_CFG_SELECT", "1")
        val key2 = _hir_key_with_env("SIMPLE_HIR_CFG_SELECT", "1")
        expect(key1).to_equal(key2)

    it "frontend parse cache scope folds in SIMPLE_HIR_CFG_SELECT when set":
        val old_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE")
        val old_flag = env_get("SIMPLE_HIR_CFG_SELECT")

        env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "test-scope")
        env_set("SIMPLE_HIR_CFG_SELECT", "1")
        val scoped = frontend_parse_cache_scope()

        if old_scope.?:
            env_set("SIMPLE_FRONTEND_CACHE_SCOPE", old_scope ?? "")
        else:
            env_remove_process("SIMPLE_FRONTEND_CACHE_SCOPE")
        if old_flag.?:
            env_set("SIMPLE_HIR_CFG_SELECT", old_flag ?? "")
        else:
            env_remove_process("SIMPLE_HIR_CFG_SELECT")

        expect(scoped.contains("hir-cfg-select=1")).to_equal(true)
