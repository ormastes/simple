# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

"""
## Purpose and audience
Pins the PM3 per-file unit-lane import contract. A unit resolves imports
through TLDR summary surfaces and held HIR only for its targets, so MIR's
prescan never saw an imported provider: struct construction failed with
`missing exact struct construction layout 'SiSpan'` / 'HostTextByteSpanV1'
(native repro, frozen Stage 2, structimp fixture) and calls failed
unproven-call-origin. The unit now holds the provider's INTERFACE-ONLY HIR
(hir_module_interface_only_v1, loaded from the provider unit's cache entry).
This spec proves that projection alone fills the MIR prescan tables a
consumer needs (struct field order, call origin, scalar return type), that
nothing is registered without it, and that the driver performs the load.
Audience: compiler engineers maintaining the per-file driver and MIR prescan.
"""

# @tag: unit, compiler, driver

use std.spec.*

use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.{mir_provider_callable_key}
use compiler.mir.mir_data.{bootstrap_fn_ret_hir_type_lookup}
use compiler.driver.driver_mir_shard_hir_residency_v1.{hir_module_interface_only_v1}
use compiler.driver.driver_hir_cache.{hir_cache_store, hir_cache_parser_binding_v1, hir_shard_key_sidecar_write_v1, hir_shard_key_sidecar_path_v1, hir_unit_import_interface_load_v1, hir_shard_provider_settle_wait_v1, hir_unit_import_iface_wait_ms_v1}
use compiler.driver.driver_mir_physical_owners.{driver_mir_owner_disposition_v1}
use app.io.env_ops.{env_get, env_set}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_remove_all(path: text) -> bool
extern fn rt_getpid() -> i64

fn uih_provider() -> HirModule:
    val parsed = parse_full_frontend(
        "pub struct UihSpan:\n    a: i64\n    b: i64\n\n" +
        "pub enum UihColor:\n    Red\n    Green\n\n" +
        "pub fn uih_make(a: i64) -> UihSpan:\n    UihSpan(a: a, b: a + 1)\n\n" +
        "pub fn uih_count(a: i64) -> i64:\n    a + 1\n",
        "uih_core.spl", "uih_core", Logger(level: 0))
    var lowering = HirLowering.with_filename("uih_core.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    module

fn uih_has_layout(lowering: MirLowering, name: text) -> bool:
    for key in lowering.struct_field_order.keys():
        if key == name or key.ends_with("." + name) or key.ends_with("::" + name):
            return true
    false

describe "unit-lane imports hold interface-only provider HIR":
    it "without provider HIR the consumer's MIR has no layout and no call origin":
        val provider = uih_provider()
        var lowering = MirLowering.new(provider.symbols)
        expect(uih_has_layout(lowering, "UihSpan")).to_equal(false)
        expect(lowering.callable_text_value_abi.has(mir_provider_callable_key(provider.name, "uih_make"))).to_equal(false)

    it "the interface projection strips bodies but keeps the declarations":
        val provider = uih_provider()
        val (projected, stripped) = hir_module_interface_only_v1(provider)
        expect(stripped >= 1).to_equal(true)
        expect(projected.structs.len()).to_equal(provider.structs.len())
        expect(projected.enums.len()).to_equal(provider.enums.len())
        expect(projected.functions.len()).to_equal(provider.functions.len())

    it "prescan over the interface projection fills struct layout, call origin and return type":
        val provider = uih_provider()
        val (projected, _stripped) = hir_module_interface_only_v1(provider)
        var modules: Dict<text, HirModule> = {}
        modules["uih_core"] = projected
        var lowering = MirLowering.new(projected.symbols)
        lowering.prescan_module_struct_names(modules, "uih_core")
        expect(uih_has_layout(lowering, "UihSpan")).to_equal(true)
        expect(lowering.callable_text_value_abi.has(mir_provider_callable_key(projected.name, "uih_make"))).to_equal(true)
        expect(lowering.callable_text_value_abi[mir_provider_callable_key(projected.name, "uih_count")]).to_equal(true)
        expect(bootstrap_fn_ret_hir_type_lookup("uih_count") != nil).to_equal(true)


describe "provider .hirkey sidecar drives the unit import lookup":
    it "round-trips: the provider's sidecar yields its interface-only HIR, which fills the prescan":
        val dir = "build/uih_sidecar_{rt_getpid()}"
        expect(rt_dir_create_all(dir + "/cache")).to_be(true)
        expect(rt_dir_create_all(dir + "/queue")).to_be(true)
        val old_dir = env_get("SIMPLE_HIR_CACHE_DIR") ?? ""
        expect(env_set("SIMPLE_HIR_CACHE_DIR", dir + "/cache")).to_be(true)
        val old_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? ""
        expect(env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "uih-sidecar-spec")).to_be(true)
        val provider = uih_provider()
        # The provider's digest is private to its unit: the importer never rebuilds it.
        val key = sha256_text("provider-unit-private-digest")
        val binding = hir_cache_parser_binding_v1(key, "uih_core", "uih_core.spl", sha256_text("provider source"))
        expect(hir_cache_store(key, provider, [], "bodyful:" + binding)).to_be(true)
        expect(hir_shard_key_sidecar_write_v1(dir + "/queue", "uih_core.spl", key, binding)).to_be(true)
        val loaded = hir_unit_import_interface_load_v1(dir + "/queue", "uih_core.spl")
        expect(loaded.?).to_be(true)
        val iface: HirModule = loaded.unwrap()
        expect(iface.structs.len()).to_equal(provider.structs.len())
        expect(iface.enums.len()).to_equal(provider.enums.len())
        var modules: Dict<text, HirModule> = {}
        modules["uih_core"] = iface
        var lowering = MirLowering.new(iface.symbols)
        lowering.prescan_module_struct_names(modules, "uih_core")
        expect(uih_has_layout(lowering, "UihSpan")).to_equal(true)
        expect(lowering.callable_text_value_abi.has(mir_provider_callable_key(iface.name, "uih_make"))).to_equal(true)
        expect(env_set("SIMPLE_HIR_CACHE_DIR", old_dir)).to_be(true)
        expect(env_set("SIMPLE_FRONTEND_CACHE_SCOPE", old_scope)).to_be(true)
        expect(rt_dir_remove_all(dir)).to_be(true)

    it "misses safely on a missing, corrupt or stale sidecar":
        val dir = "build/uih_sidecar_miss_{rt_getpid()}"
        expect(rt_dir_create_all(dir + "/cache")).to_be(true)
        expect(rt_dir_create_all(dir + "/queue")).to_be(true)
        val old_dir = env_get("SIMPLE_HIR_CACHE_DIR") ?? ""
        expect(env_set("SIMPLE_HIR_CACHE_DIR", dir + "/cache")).to_be(true)
        val old_scope = env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? ""
        expect(env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "uih-sidecar-spec")).to_be(true)
        val q = dir + "/queue"
        expect(hir_unit_import_interface_load_v1(q, "absent.spl").?).to_be(false)
        expect(file_atomic_write(hir_shard_key_sidecar_path_v1(q, "corrupt.spl"), "garbage\n")).to_be(true)
        expect(hir_unit_import_interface_load_v1(q, "corrupt.spl").?).to_be(false)
        val key = sha256_text("never-stored")
        expect(hir_shard_key_sidecar_write_v1(q, "stale.spl", key, sha256_text("b"))).to_be(true)
        expect(hir_unit_import_interface_load_v1(q, "stale.spl").?).to_be(false)
        expect(hir_shard_key_sidecar_write_v1(q, "bad.spl", key, "short")).to_be(false)
        expect(hir_shard_key_sidecar_write_v1("", "bad.spl", key, sha256_text("b"))).to_be(false)
        expect(env_set("SIMPLE_HIR_CACHE_DIR", old_dir)).to_be(true)
        expect(env_set("SIMPLE_FRONTEND_CACHE_SCOPE", old_scope)).to_be(true)
        expect(rt_dir_remove_all(dir)).to_be(true)

describe "interface-only rows never reach MIR emission":
    it "a held non-target row of a scoped unit is a placeholder, so it feeds zero MIR functions":
        expect(driver_mir_owner_disposition_v1(true, false, true)).to_equal("placeholder")
        expect(driver_mir_owner_disposition_v1(true, true, true)).to_equal("hir")
        expect(driver_mir_owner_disposition_v1(false, false, true)).to_equal("hir")

describe "importer waits for an in-flight provider, never for an unscheduled one":
    it "settles immediately when unclaimed, finished or published; times out while in flight":
        val q = "build/uih_settle_{rt_getpid()}"
        expect(rt_dir_create_all(q)).to_be(true)
        val base = q + "/" + sha256_text("p.spl")
        # Unclaimed and not in a frozen inventory: nobody will run it; do not wait.
        expect(hir_shard_provider_settle_wait_v1(q, "p.spl", 60000)).to_equal(false)
        expect(file_atomic_write(base + ".claim", "owner\np.spl\nx\n")).to_be(true)
        # In flight, nothing published: bounded wait, then a miss.
        expect(hir_shard_provider_settle_wait_v1(q, "p.spl", 300)).to_equal(false)
        # Published sidecar: hit path.
        expect(hir_shard_key_sidecar_write_v1(q, "p.spl", sha256_text("k"), sha256_text("b"))).to_be(true)
        expect(hir_shard_provider_settle_wait_v1(q, "p.spl", 60000)).to_equal(true)
        # Finished without a sidecar (codec refusal / failure): no wait.
        expect(file_atomic_write(base + ".claim", "owner\nr.spl\nx\n")).to_be(true)
        val rbase = q + "/" + sha256_text("r.spl")
        expect(file_atomic_write(rbase + ".claim", "owner\nr.spl\nx\n")).to_be(true)
        expect(file_atomic_write(rbase + ".terminal", "FAILED\n")).to_be(true)
        expect(hir_shard_provider_settle_wait_v1(q, "r.spl", 60000)).to_equal(false)
        expect(rt_dir_remove_all(q)).to_be(true)

# lib.nogc_sync_mut.database.wal constructs SdnRow from core.spl. Its unit ran
# before core's unit claimed (log: no-sidecar at wal, hit for later importers),
# the summary-only fallback carries no struct layout, and MIR failed with
# "missing exact struct construction layout 'SdnRow'". A provider listed in the
# queue's frozen inventory is scheduled work: wait (bounded) for it.
describe "importer waits for an unclaimed provider this build will run":
    it "waits on an inventoried unclaimed provider, not on an unknown one":
        val q = "build/uih_settle_inv_{rt_getpid()}"
        expect(rt_dir_create_all(q)).to_be(true)
        expect(file_atomic_write(q + "/inventory", "identity\ncore.spl\nwal.spl")).to_be(true)
        # Not in the inventory: nobody will run it; return at once.
        val t0 = current_time_ms()
        expect(hir_shard_provider_settle_wait_v1(q, "other.spl", 60000)).to_equal(false)
        expect(current_time_ms() - t0 < 5000).to_equal(true)
        # Inventoried, unclaimed: wait out the budget instead of giving up at once.
        val t1 = current_time_ms()
        expect(hir_shard_provider_settle_wait_v1(q, "core.spl", 400)).to_equal(false)
        expect(current_time_ms() - t1 >= 400).to_equal(true)
        # Inventoried and published: hit.
        expect(hir_shard_key_sidecar_write_v1(q, "core.spl", sha256_text("k"), sha256_text("b"))).to_be(true)
        expect(hir_shard_provider_settle_wait_v1(q, "core.spl", 60000)).to_equal(true)
        # Inventoried but finished without a sidecar: no wait.
        val wbase = q + "/" + sha256_text("wal.spl")
        expect(file_atomic_write(wbase + ".terminal", "FAILED\n")).to_be(true)
        val t2 = current_time_ms()
        expect(hir_shard_provider_settle_wait_v1(q, "wal.spl", 60000)).to_equal(false)
        expect(current_time_ms() - t2 < 5000).to_equal(true)
        expect(rt_dir_remove_all(q)).to_be(true)

# The wait above only runs when the unit has a budget. Native repro (frozen
# Stage 2 0d8a3269bec): `"".to_i64() ?? 60000` is 0, so with the variable unset
# no importer waited; a mutual-import fixture took 28 s unset and 36 s with
# SIMPLE_UNIT_IMPORT_IFACE_WAIT_MS=8000.
describe "interface import wait budget":
    it "defaults to 60 s when unset, blank or not a number":
        expect(hir_unit_import_iface_wait_ms_v1("")).to_equal(60000)
        expect(hir_unit_import_iface_wait_ms_v1(" ")).to_equal(60000)
        expect(hir_unit_import_iface_wait_ms_v1("abc")).to_equal(60000)
        expect(hir_unit_import_iface_wait_ms_v1("-5")).to_equal(60000)

    it "takes an explicit budget, zero included":
        expect(hir_unit_import_iface_wait_ms_v1("250")).to_equal(250)
        expect(hir_unit_import_iface_wait_ms_v1("0")).to_equal(0)
