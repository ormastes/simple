# @req REQ-SSPEC-COMPILER
"""
# Unit TLDR plan binds imports to their admitted row across std./lib. aliases

Regression for FILE-WORKER-E-CLOSURE-INCOMPLETE on every Linux cross build
(text_bytes <-> string_core, 2026-11-15). The frozen inventory registers a
`src/lib` file under its canonical `lib.*` name first; a `use std.*` import
spells the `std.*` twin. The unit TLDR plan looked the import up by the import
spelling only (skipped -> no summary, no fallback), and the streaming loop
looked the summary surface up by the ROW's module name (miss -> placeholder),
so the partner was never built and the target's closure was never ready.
"""

# @tag:unit
# @tag:compiler
# @tag:driver

use std.spec.{describe, it, expect}
use compiler.driver.driver_unit_tldr_imports_v1.{unit_tldr_plan_v1, unit_tldr_module_paths_v1,
    unit_tldr_surface_for_row_v1}
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_path}

val FXA = "test/fixtures/unit_tldr_alias/"

fn _inventory() -> Dict<text, text>:
    # Canonical lib.* rows only, as the closure loader admits a src/lib file.
    unit_tldr_module_paths_v1(["lib.fxalias.cyc_a", "lib.fxalias.cyc_b"],
        [FXA + "cyc_a.spl", FXA + "cyc_b.spl"])

describe "unit_tldr_plan_v1 std./lib. alias binding":
    it "resolves a use std.* import to the canonical lib.* inventory row":
        val plan = unit_tldr_plan_v1("u", "build/unit_tldr_alias_spec", [FXA + "cyc_a.spl"], _inventory())
        expect(plan.summaries + plan.fallbacks).to_be_greater_than(0)

    it "the partner row finds its summary surface under its own row name":
        val plan = unit_tldr_plan_v1("u", "build/unit_tldr_alias_spec", [FXA + "cyc_a.spl"], _inventory())
        val b_path = FXA + "cyc_b.spl"
        if plan.fallbacks == 0:
            expect(unit_tldr_surface_for_row_v1(plan, "lib.fxalias.cyc_b",
                module_surface_canonical_path(b_path)).is_some()).to_equal(true)
        else:
            expect(plan.parse_paths.contains(b_path)).to_equal(true)
