# Purpose and audience: pins the repaired source shapes for n88_b rows 27-33
# (native-producer workarounds) so they cannot be silently reverted before a
# rebuilt stage3 producer verifies the underlying fixes.
# @req REQ-SSPEC-UNIT
# bug: doc/08_tracking/bug/native_optional_array_pattern_binder_i64_2026_10_21.md

use std.io.{file_read}
use std.spec.{describe, it, expect}

fn src_has(path: text, needle: text) -> bool:
    file_read(path).contains(needle)

describe "n88_b repaired source shapes":
    it "ui Result payloads use canonical unit, not nominal Unit":
        for p in ["src/app/ui.web/bounded_channel.spl", "src/app/ui.web/wm_bridge.spl", "src/app/ui.web/_HostTaskbarRuntime/host_taskbar_runtime.spl"]:
            expect(src_has(p, "Result<unit,")).to_equal(true)
            expect(src_has(p, "Result<Unit,")).to_equal(false)

    it "runtime Value option/result factories bind typed Value? locals":
        val p = "src/compiler/00.common/runtime_value_v1.spl"
        expect(src_has(p, "val optional_value: Value? = Some(value)")).to_equal(true)
        expect(src_has(p, "val absent_value: Value? = nil")).to_equal(true)

    it "semantic hash writes the stream back to the receiver":
        val p = "src/compiler/10.frontend/generated/ast_semantic_value.spl"
        expect(src_has(p, "val stream: Sha256StreamV1 = state.stream")).to_equal(true)
        expect(src_has(p, "state.stream = stream")).to_equal(true)

    it "incremental SDN arrays are typed [SdnValue] in their present branches":
        val p = "src/compiler/80.driver/driver_build/incremental.spl"
        expect(src_has(p, "val entries_array: [SdnValue] = entries_array_raw")).to_equal(true)
        expect(src_has(p, "val dep_items: [SdnValue] = dep_items_raw")).to_equal(true)
        expect(src_has(p, "val out_items: [SdnValue] = out_items_raw")).to_equal(true)

    it "optional payloads are unwrapped explicitly after nil guards":
        expect(src_has("src/app/io/native_build_cache.spl", "if val present = previous:")).to_equal(true)
        expect(src_has("src/app/compiler_schema/fold_gen.spl", "semantic_present")).to_equal(true)

    it "reverse-reference facts keep the scalar mirrors":
        expect(src_has("src/compiler/00.common/cache/reverse_reference_facts.spl", "stage2_sanity_reverse_reference_publish_refused_2026_10_22")).to_equal(true)

    it "source change contract keeps its explicit-type native control and the plain native fixture":
        expect(src_has("test/fixtures/compiler/source_change_contract_native.spl", "SOURCE_CONTRACT_RETURN_INFERRED_OK")).to_equal(true)
        expect(src_has("src/lib/common/source_change/contracts_v1.spl", "well_formed_change_batch")).to_equal(true)

    it "idiom fixture and its expected output exist":
        expect(src_has("test/fixtures/compiler/n88b_native_producer_idioms_native.spl", "BINDER_")).to_equal(true)
        expect(file_read("test/fixtures/compiler/n88b_native_producer_idioms_native.spl.expected").contains("UNIT_OK")).to_equal(true)
