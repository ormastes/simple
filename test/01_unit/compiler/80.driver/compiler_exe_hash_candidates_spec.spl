# @req REQ-SSPEC-COMPILER
"""
# Compiler executable identity: Windows `.exe` spelling

A bare-name Windows launch leaves argv[0] / SIMPLE_BINARY without `.exe`, so
the compiler hash came back "" and the HIR cache scope became a per-process
`uncacheable-` token: every repeat build rejected its entry as `header`.
Bug: hir_cache_never_hits_header_rejected_2026_10_26.
"""
# @tag: unit, compiler, driver

use std.spec.{describe, it, expect}
use compiler.driver.driver_build.incremental.{native_build_compiler_exe_candidates_v1}

describe "native_build_compiler_exe_candidates_v1":
    it "adds the .exe spelling for a suffix-less SIMPLE_BINARY and argv0":
        val c = native_build_compiler_exe_candidates_v1("C:/t/stage2", "stage2")
        expect(c.len()).to_equal(4)
        expect(c[0]).to_equal("C:/t/stage2")
        expect(c[1]).to_equal("C:/t/stage2.exe")
        expect(c[3]).to_equal("stage2.exe")
    it "does not double an existing .exe suffix":
        val c = native_build_compiler_exe_candidates_v1("C:/t/stage2.exe", "")
        expect(c.len()).to_equal(1)
    it "is empty when nothing names the compiler":
        expect(native_build_compiler_exe_candidates_v1("", "").len()).to_equal(0)
