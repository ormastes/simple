"""
## Purpose and audience
Purpose: Verify that an omitted parameter whose default is a unit enum variant
is filled with that variant at the call site.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec. The seed
HIR lowering check lives in
src/compiler_rust/compiler/src/hir/lower/tests/const_default_callsite_tests.rs.
Troubleshooting: a red scenario here means the pinned contract changed —
see doc/08_tracking/bug/seed_native_build_per_file_compile_minutes_windows_2026-11-23.md.
# @manual: primary
REQ-GEN-COMPILER-001
doc/01_research/local/REQ-GEN-COMPILER-001.md
doc/03_plan/sys_test/REQ-GEN-COMPILER-001.md
doc/04_architecture/REQ-GEN-COMPILER-001.md
doc/05_design/REQ-GEN-COMPILER-001.md
"""
# @req: REQ-GEN-COMPILER-001
# tag: unit

use std.spec.step

enum Eligibility:
    Eligible
    Ineligible

fn eligibility_code(e: Eligibility) -> i64:
    match e:
        case Eligibility.Eligible: 1
        case Eligibility.Ineligible: 2

fn record(run: i64, cohort: text = "", eligible: Eligibility = Eligibility.Eligible) -> i64:
    return run * 10 + eligibility_code(eligible)

class Recorder:
    total: i64
    me add(run: i64, eligible: Eligibility = Eligibility.Ineligible):
        self.total = self.total + run * 10 + eligibility_code(eligible)

describe "default param: enum variant call-site fill":
    # @manual scenario evidence
    it "fills an omitted enum-variant default":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: fills an omitted enum-variant default")
        expect record(4) == 41
        expect record(4, "c") == 41

    it "keeps an explicit enum argument":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: keeps an explicit enum argument")
        expect record(4, "c", Eligibility.Ineligible) == 42

    it "fills an omitted enum-variant default on a method":
        # @req: REQ-GEN-COMPILER-001
        step("Verify: fills an omitted enum-variant default on a method")
        var r = Recorder(total: 0)
        r.add(3)
        expect r.total == 32
