# Purpose and audience: regression spec for array-literal match patterns.
# @req REQ-SSPEC-UNIT
# UNEXECUTED: written with the compiler fix; the Stage-2 binary predates the fix, so it was not run.
# Bug: doc/08_tracking/bug/match_array_literal_patterns_multiple_wildcard_arms_2026-10-24.md

use std.spec

fn spirv_of(v: [i64]) -> [i64]:
    match v:
        case [1, 0]: [1, 0]
        case [1, 1]: [1, 3]
        case [1, 2]: [1, 5]
        case _: [1, 6]

describe("array-literal case patterns"):
    it("test length and elements instead of lowering to wildcards"):
        assert_equal(spirv_of([1, 1]), [1, 3])
        assert_equal(spirv_of([1, 2]), [1, 5])
        assert_equal(spirv_of([1, 0]), [1, 0])
        assert_equal(spirv_of([2, 0]), [1, 6])
