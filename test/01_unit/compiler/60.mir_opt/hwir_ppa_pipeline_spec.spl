use std.spec.*
use compiler.mir.hwir.types.{HwCostModel, HwModule}
use compiler.mir_opt.hwir_opt.{HwirOptPassConfig, HwirStructuralStats,
    HwirResourceBindingPlan, HwirPpaEvidenceRefs, HwirPpaPipelineInput,
    plan_hwir_ppa_pipeline}

fn module() -> HwModule:
    HwModule(name: "scalar_ppa", profile: "speed", port_count: 4,
        signal_count: 8, register_count: 4, memory_count: 0,
        comb_op_count: 6, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel(lut_count: 100, ff_count: 40, dsp_count: 1,
            bram_count: 0, latency_cycles: 2, fmax_mhz: 100))

fn config(structural: bool, resources: bool) -> HwirOptPassConfig:
    HwirOptPassConfig(width_narrowing: false, structural_simplify: structural,
        resource_binding: resources, fsm_opt: false, memory_inference: false,
        dsp_inference: false, profile: "speed")

fn input(config_: HwirOptPassConfig, structural_proof: text,
    retirement_proof: text) -> HwirPpaPipelineInput:
    HwirPpaPipelineInput(config: config_, width_ranges: [],
        structural_stats: HwirStructuralStats(constant_folds: 1,
            dead_signals: 1, dead_registers: 0, redundant_muxes: 0, cse_hits: 0),
        resource_plan: HwirResourceBindingPlan(profile: "speed",
            multiplier_count: 1, shared_multiplier_count: 0,
            divider_count: 0, pipeline_stage_count: 1),
        fsm_plans: [], memory_patterns: [], dsp_patterns: [],
        evidence: HwirPpaEvidenceRefs(
            structural_equivalence_sha256: structural_proof,
            retirement_equivalence_sha256: retirement_proof))

describe "evidence-referenced deterministic HWIR PPA pipeline":
    it "chains pass costs and records a deterministic development receipt":
        val proof = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val retirement = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        val first = plan_hwir_ppa_pipeline(module(), input(config(true, true), proof, retirement))
        val second = plan_hwir_ppa_pipeline(module(), input(config(true, true), proof, retirement))
        expect(first.success).to_equal(true)
        expect(first.pass_results.map(_.pass_name)).to_equal(
            ["structural_simplify", "resource_binding"])
        expect(first.cost_after.lut_count).to_equal(102)
        expect(first.cost_after.ff_count).to_equal(48)
        expect(first.cost_after.dsp_count).to_equal(2)
        expect(first.cost_after.latency_cycles).to_equal(3)
        expect(first.inserted_pipeline_stages).to_equal(1)
        expect(first.graph_rewrite_complete).to_equal(false)
        expect(first.receipt_sha256.len()).to_equal(64)
        expect(first.receipt_sha256).to_equal(second.receipt_sha256)

    it "rejects changed structure without structural equivalence evidence":
        val result = plan_hwir_ppa_pipeline(module(), input(config(true, false), "", ""))
        expect(result.success).to_equal(false)
        expect(result.diagnostic).to_contain("structural equivalence evidence reference")
        expect(result.receipt_sha256).to_equal("")

    it "rejects inserted pipeline latency without retirement equivalence evidence":
        val proof = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val result = plan_hwir_ppa_pipeline(module(), input(config(false, true), proof, ""))
        expect(result.success).to_equal(false)
        expect(result.diagnostic).to_contain("retirement equivalence evidence reference")
        expect(result.inserted_pipeline_stages).to_equal(1)

    it "keeps the disabled optimization pipeline zero change and explicitly unrewritten":
        val result = plan_hwir_ppa_pipeline(module(), input(config(false, false), "", ""))
        expect(result.success).to_equal(true)
        expect(result.pass_results.len()).to_equal(0)
        expect(result.cost_after.lut_count).to_equal(module().cost.lut_count)
        expect(result.graph_rewrite_complete).to_equal(false)

    it "binds module QoR and rejects plans that produce impossible negative costs":
        val disabled = input(config(false, false), "", "")
        val first = plan_hwir_ppa_pipeline(module(), disabled)
        var changed_module = module()
        changed_module.cost = HwCostModel(lut_count: 100, ff_count: 40,
            dsp_count: 1, bram_count: 0, latency_cycles: 2, fmax_mhz: 101)
        val changed = plan_hwir_ppa_pipeline(changed_module, disabled)
        expect(first.success).to_equal(true)
        expect(changed.success).to_equal(true)
        expect(first.receipt_sha256 == changed.receipt_sha256).to_equal(false)
        var negative_input = input(config(true, false),
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "")
        negative_input.structural_stats = HwirStructuralStats(constant_folds: 200,
            dead_signals: 0, dead_registers: 0, redundant_muxes: 0, cse_hits: 0)
        val rejected = plan_hwir_ppa_pipeline(module(), negative_input)
        expect(rejected.success).to_equal(false)
        expect(rejected.diagnostic).to_contain("negative cost")
