# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec
use std.spec.step
use compiler.mir_opt.mir_opt.mod.{

    OptLevel,
    mir_pass_cost_allowed,
    mir_pass_cost_class,
    mir_pass_backend_decision,
    mir_pass_applies_to_backend_budget,
    optimizationpipeline_backend_plan_for_budget,
    optimizationpipeline_passes_for_backend,
    optimizationpipeline_passes_for_backend_budget,
    optimizationpipeline_skipped_decisions_for_backend_budget
}

describe "MIR built-in pass backend cost budget":
    # @manual scenario evidence
    it "classifies high-cost aggressive passes separately from cleanup passes":
        # @req REQ-SSPEC-UNIT
        step("classifies high-cost aggressive passes separately from cleanup passes")
        expect(mir_pass_cost_class("dead_code_elimination")).to_equal("low")
        expect(mir_pass_cost_class("inline_aggressive")).to_equal("high")
        expect(mir_pass_cost_class("auto_vectorize")).to_equal("high")
        expect(mir_pass_cost_allowed("medium", "medium")).to_equal(true)
        expect(mir_pass_cost_allowed("high", "medium")).to_equal(false)

    it "filters Cranelift aggressive pipelines by compile-cost budget":
        # @req REQ-SSPEC-UNIT
        step("filters Cranelift aggressive pipelines by compile-cost budget")
        val normal = optimizationpipeline_passes_for_backend(OptLevel.Aggressive, "cranelift")
        val medium = optimizationpipeline_passes_for_backend_budget(OptLevel.Aggressive, "cranelift", "medium")
        val high = optimizationpipeline_passes_for_backend_budget(OptLevel.Aggressive, "cranelift", "high")

        # Only Active passes are planned: auto_vectorize is the sole Active
        # aggressive pass; inline_aggressive is Skeleton and planned out.
        expect(normal.contains("auto_vectorize")).to_equal(true)
        expect(normal.contains("inline_aggressive")).to_equal(false)
        expect(medium.contains("auto_vectorize")).to_equal(false)
        expect(medium.len()).to_equal(0)
        expect(high.contains("auto_vectorize")).to_equal(true)

    it "combines LLVM backend skips with compile-cost budget skips":
        # @req REQ-SSPEC-UNIT
        step("combines LLVM backend skips with compile-cost budget skips")
        val medium = optimizationpipeline_passes_for_backend_budget(OptLevel.Aggressive, "llvm-lib", "medium")

        # Every aggressive pass is either delegated to LLVM, over the medium
        # budget, or not transform-ready, so the planned pipeline is empty.
        expect(medium.len()).to_equal(0)
        expect(mir_pass_applies_to_backend_budget("auto_vectorize", "llvm", "high")).to_equal(false)
        expect(mir_pass_applies_to_backend_budget("auto_vectorize", "cranelift", "medium")).to_equal(false)
        expect(mir_pass_applies_to_backend_budget("auto_vectorize", "cranelift", "high")).to_equal(true)

    it "uses shared backend aliases without treating future backends as LLVM":
        # @req REQ-SSPEC-UNIT
        step("uses shared backend aliases without treating future backends as LLVM")
        expect(mir_pass_applies_to_backend_budget("strength_reduction", "llvmlib", "high")).to_equal(false)
        expect(mir_pass_applies_to_backend_budget("strength_reduction", "wasm", "high")).to_equal(true)
        val wasm = optimizationpipeline_passes_for_backend_budget(OptLevel.Aggressive, "wasm", "high")
        # strength_reduction is Disabled (proof debt), so it applies at the
        # skip/cost level but is still planned out of the wasm pipeline.
        expect(wasm.contains("strength_reduction")).to_equal(false)
        expect(wasm.contains("auto_vectorize")).to_equal(true)

    it "explains backend and cost decisions for individual passes":
        val llvm_skip = mir_pass_backend_decision("auto_vectorize", "llvm", "high")
        expect(llvm_skip.applies).to_equal(false)
        expect(llvm_skip.reason).to_equal("llvm_runs_vectorizer_pipeline")
        expect(llvm_skip.cost_class).to_equal("high")

        val cost_skip = mir_pass_backend_decision("auto_vectorize", "cranelift", "medium")
        expect(cost_skip.applies).to_equal(false)
        expect(cost_skip.reason).to_equal("cost budget exceeded")

        val status_skip = mir_pass_backend_decision("predicate_promote", "cranelift", "high")
        expect(status_skip.applies).to_equal(false)
        expect(status_skip.reason).to_equal("disabled: mask single-use, dominance, and span proof incomplete")

        val ready = mir_pass_backend_decision("auto_vectorize", "cranelift", "high")
        expect(ready.applies).to_equal(true)
        expect(ready.reason).to_equal("ready")

    it "reports skipped pipeline decisions with stable reasons":
        # @req REQ-SSPEC-UNIT
        step("reports skipped pipeline decisions with stable reasons")
        val cranelift_skips = optimizationpipeline_skipped_decisions_for_backend_budget(OptLevel.Aggressive, "cranelift", "medium")
        var found_cost_skip = false
        for decision in cranelift_skips:
            if decision.pass_name == "auto_vectorize" and decision.reason == "cost budget exceeded":
                found_cost_skip = true
        expect(found_cost_skip).to_equal(true)

        val llvm_skips = optimizationpipeline_skipped_decisions_for_backend_budget(OptLevel.Aggressive, "llvm-lib", "high")
        var found_llvm_skip = false
        for decision in llvm_skips:
            if decision.pass_name == "auto_vectorize" and decision.reason == "llvm_runs_vectorizer_pipeline":
                found_llvm_skip = true
        expect(found_llvm_skip).to_equal(true)

    it "builds applied and skipped backend pass plans in one decision pass":
        # @req REQ-SSPEC-UNIT
        step("builds applied and skipped backend pass plans in one decision pass")
        val plan = optimizationpipeline_backend_plan_for_budget(OptLevel.Aggressive, "llvm", "medium")
        # Every aggressive pass is delegated, over budget, or not
        # transform-ready for llvm/medium, so nothing is applied.
        expect(plan.passes.len()).to_equal(0)
        expect(plan.passes.contains("auto_vectorize")).to_equal(false)

        var found_backend_skip = false
        var found_cost_skip = false
        for decision in plan.skipped_passes:
            if decision.pass_name == "auto_vectorize" and decision.reason == "llvm_runs_vectorizer_pipeline":
                found_backend_skip = true
            if decision.pass_name == "predicate_promote" and decision.reason == "disabled: mask single-use, dominance, and span proof incomplete":
                found_cost_skip = true
        expect(found_backend_skip).to_equal(true)
        expect(found_cost_skip).to_equal(true)
