# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use compiler.common.di.{di_is_system_test_locked, get_container, set_container, DiContainer}

describe "compiler dependency injection core":
    # @manual scenario evidence
    it "system test lock is unset outside the system-test environment":
        # @req REQ-SSPEC-UNIT
        step("system test lock is unset outside the system-test environment")
        expect(di_is_system_test_locked()).to_equal(false)

    it "container round-trips through set_container and get_container":
        # @req REQ-SSPEC-UNIT
        step("container round-trips through set_container and get_container")
        val before = get_container()
        val fresh = DiContainer(bindings: {}, singletons: {}, profile: "spec", all_bindings: [])
        set_container(fresh)
        val got = get_container()
        expect(got.bindings.len()).to_equal(0)
        set_container(before)
        expect(get_container()).to_equal(before)
