# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use compiler.common.effects.{EffectTag, effect_tag_to_string}

describe "compiler effects":
    # @manual scenario evidence
    it "pure and suspending tags combine to suspending":
        # @req REQ-SSPEC-UNIT
        step("pure and suspending tags combine to suspending")
        val pure = EffectTag.PureTag
        val susp = EffectTag.SuspendingTag
        expect(pure.combine(pure)).to_equal(EffectTag.PureTag)
        expect(pure.combine(susp)).to_equal(EffectTag.SuspendingTag)
        expect(susp.combine(pure)).to_equal(EffectTag.SuspendingTag)
        expect(susp.combine(susp)).to_equal(EffectTag.SuspendingTag)

    it "combine_all folds a list to suspending when any tag suspends":
        # @req REQ-SSPEC-UNIT
        step("combine_all folds a list to suspending when any tag suspends")
        expect(EffectTag.combine_all([])).to_equal(EffectTag.PureTag)
        expect(EffectTag.combine_all([EffectTag.PureTag, EffectTag.PureTag])).to_equal(EffectTag.PureTag)
        expect(EffectTag.combine_all([EffectTag.SuspendingTag, EffectTag.PureTag])).to_equal(EffectTag.SuspendingTag)

    it "tag predicates and to_string agree with the tag kind":
        # @req REQ-SSPEC-UNIT
        step("tag predicates and to_string agree with the tag kind")
        expect(EffectTag.PureTag.is_sync()).to_equal(true)
        expect(EffectTag.PureTag.is_async()).to_equal(false)
        expect(EffectTag.SuspendingTag.is_async()).to_equal(true)
        expect(EffectTag.SuspendingTag.is_sync()).to_equal(false)
        expect(effect_tag_to_string(EffectTag.PureTag)).to_equal("sync")
        expect(effect_tag_to_string(EffectTag.SuspendingTag)).to_equal("async")
