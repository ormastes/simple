# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.spec.{describe, it, expect}

use compiler.common.config.{CompilerProfile, Config}

fn main() -> ():
    describe("compiler common config", fn() -> ():
        it("round-trips profile names through to_text and from_text", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("convert each profile to text and back")
            expect(CompilerProfile.Dev.to_text()).to_equal("dev")
            expect(CompilerProfile.Test.to_text()).to_equal("test")
            expect(CompilerProfile.Prod.to_text()).to_equal("prod")
            expect(CompilerProfile.Sdn.to_text()).to_equal("sdn")
            expect(CompilerProfile.from_text("prod")).to_equal(CompilerProfile.Prod)
            expect(CompilerProfile.from_text("development")).to_equal(CompilerProfile.Dev)
            expect(CompilerProfile.from_text("data")).to_equal(CompilerProfile.Sdn)
            step("unknown names fall back to dev")
            expect(CompilerProfile.from_text("nope")).to_equal(CompilerProfile.Dev)
        )

        it("stores and reads config values", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("set a key and read it back")
            var cfg = Config.default()
            cfg.set("mode", "fast")
            expect(cfg.get("mode") ?? "").to_equal("fast")
            step("missing keys read as nil")
            expect(cfg.get("absent")).to_be_nil()
        )
    )
