# @req REQ-SSPEC-UNIT
# Bug: scv_frozen_entry_outside_src_never_native_entry_2026-11-03
# An entry under test/ keeps its absolute (frozen snapshot / worktree) name, so
# it never equals the logical name of SIMPLE_NATIVE_BUILD_ENTRY and no
# `__simple_main` is emitted. Native fixture: test/04_smoke/fixtures/native_test_entry_hello.spl
use std.spec.{describe, it, expect}
use compiler.common.module_path_naming.{module_logical_name_from_path, module_source_relative_path}

describe "entry module under test/":
    it "anchors a relative test/ path as itself":
        expect(module_source_relative_path("test/04_smoke/fixtures/native_test_entry_hello.spl")).to_equal("test/04_smoke/fixtures/native_test_entry_hello.spl")
        expect(module_logical_name_from_path("test/04_smoke/fixtures/native_test_entry_hello.spl")).to_equal("test.04_smoke.fixtures.native_test_entry_hello")

    it "gives an absolute worktree path the same repo-relative identity (entry symbol naming)":
        val abs = "C:/dev/wt/p3-envpol/test/04_smoke/fixtures/native_test_entry_hello.spl"
        expect(module_source_relative_path(abs)).to_equal("test/04_smoke/fixtures/native_test_entry_hello.spl")
        expect(module_logical_name_from_path(abs)).to_equal(module_logical_name_from_path("test/04_smoke/fixtures/native_test_entry_hello.spl"))

    it "gives a frozen SCV snapshot test/ path the same identity":
        val frozen = "/w/build/scv_snapshots/rev_1/test/04_smoke/fixtures/native_test_entry_hello.spl"
        expect(module_logical_name_from_path(frozen)).to_equal("test.04_smoke.fixtures.native_test_entry_hello")
