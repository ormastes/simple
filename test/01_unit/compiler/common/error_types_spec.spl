# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use compiler.common.error.{module_not_found, failed_to_read_file, CompileError, Severity}

describe "compiler error types":
    # @manual scenario evidence
    it "factory errors carry the offending names in their messages":
        # @req REQ-SSPEC-UNIT
        step("factory errors carry the offending names in their messages")
        val nf = module_not_found("mymod")
        expect(nf.message()).to_contain("mymod")
        expect(nf.message()).to_contain("not found")
        val rf = failed_to_read_file("a/b.spl", "enoent")
        expect(rf.message()).to_contain("a/b.spl")
        expect(rf.message()).to_contain("enoent")

    it "special constructors format structured context into the message":
        # @req REQ-SSPEC-UNIT
        step("special constructors format structured context into the message")
        val so = CompileError.stack_overflow(11, 5, "rec_fn")
        expect(so.message()).to_contain("depth 11")
        expect(so.message()).to_contain("limit 5")
        expect(so.message()).to_contain("rec_fn")
        val to = CompileError.timeout_exceeded(7)
        expect(to.message()).to_contain("7 second")

    it "severity renders canonical lowercase names":
        # @req REQ-SSPEC-UNIT
        step("severity renders canonical lowercase names")
        expect(Severity.Error.to_string()).to_equal("error")
        expect(Severity.Warning.to_string()).to_equal("warning")
        expect(Severity.Note.to_string()).to_equal("note")
        expect(Severity.Help.to_string()).to_equal("help")
