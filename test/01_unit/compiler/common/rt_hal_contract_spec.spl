        # expect(lower.diagnostic).to_contain("rationale")
        # expect(unknown.valid).to_be(false)
        # expect(unknown.diagnostic).to_contain("unknown")

    it "allows a reasoned lower declaration but never promotes it to sealed Critical":
        # @req REQ-013
        # @capture(protocol_json): tripwire probe over the drafted module path
        step("prove the drafted contract module is still absent, then pin the drafted reasoned-downgrade rule")
