        # expect(contract.preferred_provider).to_equal(0)  # oracle: no preferred clause selects the first provider
        # expect(contract.trace_bytes).to_equal(4096)  # oracle: drafted default trace ring is one 4 KiB page
        # expect(rt_hal_contract_requires_sealed_archive(contract)).to_be(true)
        # expect(rt_hal_contract_canonical_v1(contract)).to_start_with("rt-hal-v1|")

    it "accepts explicit Pure C Rust compare metadata and capacities":
        # @req REQ-010
        # @capture(protocol_json): tripwire probe over the drafted module path
        step("prove the drafted contract module is still absent, then pin the drafted explicit-metadata grammar")
        expect(drafted_module_absent()).to_equal(true)
