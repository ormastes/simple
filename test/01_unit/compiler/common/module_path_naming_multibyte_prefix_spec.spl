"""
## Purpose and audience
Pins that a workspace prefix holding a multibyte character does not shift
module identity: `module_source_relative_path` scans bytes to find `/src/`
but `substring` is character-indexed, so the byte index must be converted
before slicing. Audience: whoever touches `_module_path_naming_text_index_of`
or the Stage 2 admission fixture that mirrors it.
## Operator workflow
bin/simple test test/01_unit/compiler/common/module_path_naming_multibyte_prefix_spec.spl
## Compatibility and limitations
Observed 2026-11-12 (bootstrap-fable-8, aarch64): the seed interpreter and
the seed-native lane both derived `rc.app.cli.main` for
`/tmp/café/simple/src/app/cli/main.spl`; the Stage 2 gate expects
`app.cli.main`. Red before the fix (seed interpreter): `expected rc.app.cli.main
to equal app.cli.main`.
## Verification guidance and troubleshooting
A failure here means the byte index leaked into the character slice again;
fix `_module_path_naming_char_index_of_byte`, never the expected value.
"""
# @manual_section: module-path-naming
use std.spec.*
use compiler.common.module_path_naming.{module_source_relative_path, module_logical_name_from_path}

describe "module path naming with a multibyte workspace prefix":
    it "keeps the repo-relative path and logical name intact past a multibyte directory name":
        # @req REQ-MODULE-PATH-NAMING-MULTIBYTE-001
        step("Derive the repo-relative path from an absolute path whose prefix holds one multibyte character")
        val relative = module_source_relative_path("/tmp/café/simple/src/app/cli/main.spl")
        # @capture(text): relative path and logical module name derived from the multibyte-prefixed path
        step("Compare with the ASCII-prefixed derivation")
        expect(relative).to_equal("src/app/cli/main.spl")
        expect(module_logical_name_from_path("/tmp/café/simple/src/app/cli/main.spl")).to_equal("app.cli.main")
        expect(module_logical_name_from_path("/tmp/plain/simple/src/app/cli/main.spl")).to_equal("app.cli.main")
