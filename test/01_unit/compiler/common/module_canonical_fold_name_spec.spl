# @req REQ-SSPEC-UNIT
# Bug: native_build_entry_main_undefined_when_source_path_has_dot_2026_10_20
# The driver canonicalizes module names by dropping all-digit segments; the
# native entry predicate must agree, or `__simple_main` is never emitted for an
# entry under a dotted numeric directory (test/s3sanity/dot.1/hello.spl).
use std.spec.{describe, it, expect}
use compiler.common.module_path_naming.{module_logical_name_from_path, module_canonical_fold_name}

describe "module_canonical_fold_name":
    it "agrees with itself for an entry path under a dotted numeric dir":
        val logical = module_logical_name_from_path("test/s3sanity/dot.1/hello.spl")
        expect(module_canonical_fold_name(logical)).to_equal("test.s3sanity.dot.hello")
        expect(module_canonical_fold_name(logical)).to_equal(module_canonical_fold_name("test.s3sanity.dot.hello"))

    it "handles multiple and trailing numeric segments":
        expect(module_canonical_fold_name("a.1.b.22.c")).to_equal("a.b.c")
        expect(module_canonical_fold_name(module_logical_name_from_path("test/x.2/y.3/z.spl"))).to_equal("test.x.y.z")

    it "still strips numbered tier layers":
        expect(module_canonical_fold_name("compiler.10.frontend.core.lexer")).to_equal("compiler.frontend.core.lexer")
        expect(module_canonical_fold_name("compiler.00.common.types")).to_equal("compiler.common.types")

    it "folds std to lib and keeps empty leading segment":
        expect(module_canonical_fold_name("std.text")).to_equal("lib.text")
        expect(module_canonical_fold_name("std")).to_equal("lib")
        expect(module_canonical_fold_name("plain.name")).to_equal("plain.name")
