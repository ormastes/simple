# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec.{describe, it, expect}
use compiler.common.module_path_naming.{module_logical_name_from_path, module_source_relative_path}


describe "module_logical_name_from_path":
    # @manual scenario evidence
    """Regression guard for the single shared path->logical-module-name
    derivation (src/compiler/00.common/module_path_naming.spl).

    This derivation used to be four hand-kept byte-identical copies across
    80.driver / 70.backend / 50.mir / 20.hir; a drift between two of them
    (70a29867bc2) made `entry_main_symbol` false for every out-of-tree entry,
    so no `__simple_main` was emitted and the whole native-smoke-matrix went
    0/19. The copies are now one function, but nothing pinned its actual
    input->output behaviour, so a future edit to the shared copy could break
    all four call sites at once with no test failing. These cases pin each
    branch of the derivation with concrete inputs.
    """

    it "strips a leading src/ and the .spl extension":
        # @req REQ-SSPEC-UNIT
        step("strips a leading src/ and the .spl extension")
        expect(module_logical_name_from_path("src/_wallB_mod_a.spl")).to_equal("_wallB_mod_a")

    it "dots nested directory separators":
        # @req REQ-SSPEC-UNIT
        step("dots nested directory separators")
        expect(module_logical_name_from_path("src/compiler/foo/bar.spl")).to_equal("compiler.foo.bar")

    it "keeps the Stage 3 entry and driver module names nonempty and distinct":
        val bootstrap = module_logical_name_from_path("src/app/cli/bootstrap_main.spl")
        val driver = module_logical_name_from_path("src/compiler/driver/driver.spl")
        expect(bootstrap).to_equal("app.cli.bootstrap_main")
        expect(driver).to_equal("compiler.driver.driver")
        expect(bootstrap.len()).to_be_greater_than(0)
        expect(driver.len()).to_be_greater_than(0)
        expect(bootstrap == driver).to_be(false)
    it "keeps an absolute path repo-relative by cutting at /src/":
        # @req REQ-SSPEC-UNIT
        step("keeps an absolute path repo-relative by cutting at /src/")
        expect(module_logical_name_from_path("/home/u/work/simple/src/app/cli/main.spl")).to_equal("app.cli.main")

    it "cuts an absolute path after a non-ASCII workspace prefix":
        expect(module_logical_name_from_path("/tmp/café/simple/src/app/cli/main.spl")).to_equal("app.cli.main")

    it "normalizes backslashes before cutting at /src/":
        # @req REQ-SSPEC-UNIT
        step("normalizes backslashes before cutting at /src/")
        expect(module_logical_name_from_path("C:\\work\\simple\\src\\app\\cli\\main.spl")).to_equal("app.cli.main")

    it "strips leading ./ and ../ segments":
        # @req REQ-SSPEC-UNIT
        step("strips leading ./ and ../ segments")
        expect(module_logical_name_from_path("../../src/lib/text.spl")).to_equal("lib.text")
        expect(module_logical_name_from_path("./src/lib/text.spl")).to_equal("lib.text")

    it "keeps the examples/ segment when there is no /src/":
        # @req REQ-SSPEC-UNIT
        step("keeps the examples/ segment when there is no /src/")
        expect(module_logical_name_from_path("/home/u/simple/examples/demo.spl")).to_equal("examples.demo")

    it "sanitizes host-path punctuation into underscores":
        # @req REQ-SSPEC-UNIT
        step("sanitizes host-path punctuation into underscores")
        # A path with neither /src/ nor /examples/ keeps its leading "/",
        # which the "/" -> "." rewrite turns into a leading dot. Pinned as-is:
        # this is the shape the entry_main_symbol comparison actually sees for
        # out-of-tree entries, so it must not change silently.
        expect(module_logical_name_from_path("/tmp/probe-dir/entry.spl")).to_equal(".tmp.probe_dir.entry")

    it "strips the .sdn extension too":
        # @req REQ-SSPEC-UNIT
        step("strips the .sdn extension too")
        expect(module_logical_name_from_path("src/config/app.sdn")).to_equal("config.app")

    it "keeps the logical name host-independent under an SCV snapshot root":
        # @req REQ-SSPEC-UNIT
        step("keeps the logical name host-independent under an SCV snapshot root")
        val frozen = "/home/u/simple/build/scv_snapshots/scv_revision_v1_372ff06fa9d9/src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl"
        expect(module_logical_name_from_path(frozen)).to_equal("os.kernel.arch.cortex_m33.scalar_parser_fs_policy")

describe "module_source_relative_path":
    # @manual scenario evidence
    """The repo-relative path identity that native symbols are derived from.
    Regression guard for bug simpleos_cm33_policy_symbols_mangled_2026-09-26:
    under SIMPLE_SCV_FREEZE_FALLBACK=1 the entry is parsed from an absolute
    `build/scv_snapshots/<revision>/src/...` path, and `__module_init_*` was
    derived from that raw path, so it embedded the host directory and a
    content hash and could never match the fixed name cm33_shim.c declares."""

    it "strips an absolute SCV snapshot prefix down to src/":
        # @req REQ-SSPEC-UNIT
        step("strips an absolute SCV snapshot prefix down to src/")
        val frozen = "/home/u/simple/build/scv_snapshots/scv_revision_v1_372ff06fa9d9/src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl"
        expect(module_source_relative_path(frozen)).to_equal("src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl")

    it "leaves a repo-relative path and a dotted logical name untouched":
        # @req REQ-SSPEC-UNIT
        step("leaves a repo-relative path and a dotted logical name untouched")
        expect(module_source_relative_path("src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl")).to_equal("src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl")
        expect(module_source_relative_path("./src/app/cli/bootstrap_main.spl")).to_equal("src/app/cli/bootstrap_main.spl")
        expect(module_source_relative_path("os.kernel.arch.cortex_m33.access_policy")).to_equal("os.kernel.arch.cortex_m33.access_policy")

    it "keeps an absolute examples/ path repo-relative":
        # @req REQ-SSPEC-UNIT
        step("keeps an absolute examples/ path repo-relative")
        expect(module_source_relative_path("/w/simple/examples/hello/main.spl")).to_equal("examples/hello/main.spl")
