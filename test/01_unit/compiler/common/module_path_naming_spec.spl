use std.spec.{describe, it, expect}
use compiler.common.module_path_naming.{module_logical_name_from_path}

describe "module_logical_name_from_path":
    """Regression guard for the single shared path->logical-module-name
    derivation (src/compiler/00.common/module_path_naming.spl).

    This derivation used to be four hand-kept byte-identical copies across
    80.driver / 70.backend / 50.mir / 20.hir; a drift between two of them
    (70a29867bc2) made `entry_main_symbol` false for every out-of-tree entry,
    so no `__simple_main` was emitted and the whole native-smoke-matrix went
    0/19. The copies are now one function, but nothing pinned its actual
    input->output behaviour, so a future edit to the shared copy could break
    all four call sites at once with no test failing. These cases pin each
    branch of the derivation with concrete inputs.
    """

    it "strips a leading src/ and the .spl extension":
        expect(module_logical_name_from_path("src/_wallB_mod_a.spl")).to_equal("_wallB_mod_a")

    it "dots nested directory separators":
        expect(module_logical_name_from_path("src/compiler/foo/bar.spl")).to_equal("compiler.foo.bar")

    it "makes numbered resolver directories transparent":
        expect(module_logical_name_from_path("src/compiler/00.common/module_path_naming.spl")).to_equal("compiler.common.module_path_naming")
        expect(module_logical_name_from_path("src/std/editor/00.common/types.spl")).to_equal("std.editor.common.types")

    it "keeps an absolute path repo-relative by cutting at /src/":
        expect(module_logical_name_from_path("/home/u/work/simple/src/app/cli/main.spl")).to_equal("app.cli.main")

    it "normalizes backslashes before cutting at /src/":
        expect(module_logical_name_from_path("C:\\work\\simple\\src\\app\\cli\\main.spl")).to_equal("app.cli.main")

    it "strips leading ./ and ../ segments":
        expect(module_logical_name_from_path("../../src/lib/text.spl")).to_equal("lib.text")
        expect(module_logical_name_from_path("./src/lib/text.spl")).to_equal("lib.text")

    it "keeps the examples/ segment when there is no /src/":
        expect(module_logical_name_from_path("/home/u/simple/examples/demo.spl")).to_equal("examples.demo")

    it "sanitizes host-path punctuation into underscores":
        # A path with neither /src/ nor /examples/ keeps its leading "/",
        # which the "/" -> "." rewrite turns into a leading dot. Pinned as-is:
        # this is the shape the entry_main_symbol comparison actually sees for
        # out-of-tree entries, so it must not change silently.
        expect(module_logical_name_from_path("/tmp/probe-dir/entry.spl")).to_equal(".tmp.probe_dir.entry")

    it "strips the .sdn extension too":
        expect(module_logical_name_from_path("src/config/app.sdn")).to_equal("config.app")
