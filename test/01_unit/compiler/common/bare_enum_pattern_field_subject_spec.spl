# @req REQ-SSPEC-LIB
# Pins bare_enum_pattern_binding_in_compiler_2026_10_14: a bare variant name
# shared by two enums, matched over an enum-typed struct FIELD of an
# optional-unwrapped value, must be a variant test, not a catch-all binding.
use std.spec.step
use std.spec.{describe, it, assert_equal}

enum KindA:
    Function
    Other

enum KindB:
    Function
    Method

struct Holder:
    kind: KindA

fn holder_is_function(h: Holder?) -> bool:
    if val found = h:
        match found.kind:
            case Function: true
            case _: false
    else:
        false

describe "bare enum pattern over struct field subject":
    it "does not treat shared bare Function as a binding":
        step("Other is not Function")
        assert_equal(holder_is_function(Some(Holder(kind: KindA.Other))), false)
        assert_equal(holder_is_function(Some(Holder(kind: KindA.Function))), true)
        assert_equal(holder_is_function(nil), false)
