# @req REQ-SSPEC-LIB
# Pins BUG-MIR-ENUM-FIELD-RECEIVER-20261010: `audit.status.name()` (method call
# on an enum-typed struct FIELD of a parameter) must lower and hash correctly
# for every TrustAuditStatus. Expected digests are derived independently from
# the frozen framing contract with sha256sum.
use std.spec.step
use std.spec.{describe, it, assert_equal}
use compiler.common.assurance.trust_audit.{TrustAuditResult, TrustAuditStatus, canonical_trust_audit_hash_v1}

fn _mk(status: TrustAuditStatus) -> TrustAuditResult:
    TrustAuditResult(status: status, root_count: 1, audited_root_count: 1,
        project_axioms: [], approved_axioms: [], rejected_axioms: [], reason: "ok")

describe "TrustAuditResult status field receiver":
    it "hashes every status via audit.status.name()":
        step("four statuses")
        assert_equal(canonical_trust_audit_hash_v1(_mk(TrustAuditStatus.Closed), "abc"), "8af2c59e869c7f15d6dfe0cb1da4e9a3ff9830fb5d26f22117bc4c50bc86f657")
        assert_equal(canonical_trust_audit_hash_v1(_mk(TrustAuditStatus.BoundedTcb), "abc"), "eab47346da15688f270436b830feb1e2d0326d827fd076272357131189a010c4")
        assert_equal(canonical_trust_audit_hash_v1(_mk(TrustAuditStatus.Rejected), "abc"), "c621299f3d2e9f2c963d3fe100875facc873cabe8aaa05699e6c5706dd1da48a")
        assert_equal(canonical_trust_audit_hash_v1(_mk(TrustAuditStatus.Missing), "abc"), "f28b1a6ddf74ffe5bf476d59b843a95cdbb4013ee04a6244935d972e23088c5f")
