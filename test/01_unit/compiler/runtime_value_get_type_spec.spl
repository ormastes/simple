use std.spec
use runtime_value_get_type_native.{value_get_type_aggregates, value_get_type_controls}

describe "runtime Value.get_type production aggregate arity":
    it "accepts empty and populated structs and absent tuple and record enum payloads":
        expect(value_get_type_aggregates()).to_equal(true)
    it "preserves integer and nil types and rejects the wrong opaque kind":
        expect(value_get_type_controls()).to_equal(true)
