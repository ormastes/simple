enum Color:
    Red
    Green
    Blue

fn main():
    val n = 7
    match n:
        case 1:
            print "one"
        case _:
            pass
    print "wildcard_silent=ok"
    match n:
        case 7:
            print "matched_arm=seven"
        case 8:
            print "eight"
    val c = Color.Blue
    match c:
        case Color.Red:
            print "red"
        case Color.Green:
            print "green"
        case Color.Blue:
            print "exhaustive_enum=blue"
    match n:
        case x if x > 100:
            print "big"
        case x:
            print "binder_catch_all={x}"
    val o: i64? = None
    match o:
        case Some(v):
            print "some {v}"
        case None:
            print "none_arm=ok"
    extra()
    print "done"

fn scale(n: i64, big: bool) -> f64:
    if big:
        match n:
            case 1: 1.5
            case 2: 2.5
    else:
        0.25

fn label(n: i64) -> text:
    val s = match n:
        case 1: "one"
        case x if x > 5: "big"
        case _: "other"
    s

fn loop_arms() -> i64:
    var total = 0
    for i in [1, 2, 3, 4, 5]:
        match i:
            case 2:
                continue
            case 4:
                break
            case _:
                total = total + i
    total

fn extra():
    print "float_nested_tail={scale(2, true)}"
    print "float_else={scale(2, false)}"
    print "expr_arms={label(1)},{label(9)},{label(3)}"
    print "loop_arms={loop_arms()}"
