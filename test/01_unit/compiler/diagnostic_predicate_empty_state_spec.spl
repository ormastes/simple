# Regression spec for `dotq_tail_position_in_bool_returning_fns_2026-08-09`.
#
# The compiler-diagnostic predicates below used to be written as a bare
# `self.errors.?` / `self.violations.?` / `self.bindings.?` in tail position of
# a `-> bool` function. `.?` returns `T?`, not `bool`, so under the seed/JIT the
# payload collapsed to scalar truthiness and an EMPTY container answered `true`:
# "did this phase produce errors?" said yes when it produced none.
#
# These cases pin the empty/zero state to `false` and the populated state to
# `true`, for the real compiler types, under whichever engine runs the spec.

use compiler.common.effects_cache.{CachedFunctionEffectInfo}
use compiler.semantics.verification_checker.{VerificationChecker, VerificationRule}
use compiler.mono.monomorphize.binding_specializer.{BindingSpecializer}

describe "compiler diagnostic predicates report false on empty state":
    it "CachedFunctionEffectInfo.has_violations is false for an empty violation list":
        val info = CachedFunctionEffectInfo.empty("f")
        expect info.violations.len() == 0
        expect info.has_violations() == false

    it "CachedFunctionEffectInfo.has_violations is true once a violation is recorded":
        var info = CachedFunctionEffectInfo.empty("f")
        info.violations = info.violations.push("io escapes pure fn")
        expect info.has_violations() == true

    it "VerificationChecker.has_violations is false for a fresh checker":
        val checker = VerificationChecker.create(true)
        expect checker.has_violations() == false

    it "VerificationChecker.has_violations is true after add_violation":
        var checker = VerificationChecker.create(true)
        checker.add_violation(VerificationRule.VTrusted, "f", "no contract")
        expect checker.has_violations() == true

    it "BindingSpecializer.has_bindings is false for an empty binding map":
        val spec = BindingSpecializer.create()
        expect spec.has_bindings() == false

    it "BindingSpecializer.has_bindings is true after add_binding":
        var spec = BindingSpecializer.create()
        spec.add_binding("Writer", "FileWriter")
        expect spec.has_bindings() == true
