"""
# Module Name vs Match Binding Spec

Regression spec verifying that importing a module whose leaf name matches a
pattern binder (`std.common.json.value` vs `case Ok(value): value`) does not
shadow the local match arm binding in the Rust seed interpreter.
"""

use std.spec.*
use std.common.json.value.{JsonValue}

fn pick(r: Result<i64, text>) -> i64:
    match r:
        case Ok(value): value
        case Err(e): -1

describe "shadow":
    it "binds value":
        expect(pick(Ok(42))).to_equal(42)
