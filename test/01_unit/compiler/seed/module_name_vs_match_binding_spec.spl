# Regression for seed_module_name_shadows_match_binding_2026_10_31: importing a module named `value` must not shadow `case Ok(value): value`.
use std.spec.*
use std.common.json.value.{JsonValue}

fn pick(r: Result<i64, text>) -> i64:
    match r:
        case Ok(value): value
        case Err(e): -1

describe "shadow":
    it "binds value":
        expect(pick(Ok(42))).to_equal(42)
