# Hidden imported return types must retain their exact provider identity.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLoweringExpr.optional_record_owner.*

class OptionalDependencyFixture:
    lowering: MirLowering
    provider_id: i64
    decoy_id: i64

fn optional_dependency_fixture() -> OptionalDependencyFixture:
    val source = "pub class SdnTable:\n    name: text\n    rows: [[text]]\n"
    val ast = parse_full_frontend(source, "app/optional/provider.spl", "app.optional.provider", Logger(level: 0))
    var hir = HirLowering.with_filename("app/optional/provider.spl")
    val provider = hir.lower_module(ast)
    expect(hir.errors.len()).to_equal(0)
    var symbols = SymbolTable.new()
    val decoy = symbols.define("SdnTable", SymbolKind.Struct, nil, Span.empty(), Visibility.Private, false, Some("app.optional.consumer"))
    var lowering = MirLowering.new(symbols)
    var prescan_mods: Dict<text, HirModule> = {}
    prescan_mods["provider"] = provider
    for prescan_key in prescan_mods.keys():
        lowering.prescan_module_struct_names(prescan_mods, prescan_key)
    for record in provider.classes.values():
        if record.name == "SdnTable":
            val relocated = lowering.relocate_provider_type_symbol(record.symbol, provider.symbols)
            expect(relocated.id).to_be_greater_than(-1)
            val owner = "app.optional.provider.SdnTable"
            lowering.register_composite_field_metadata(owner, record.fields, provider.symbols, false)
            lowering.optional_record_owners[0] = owner
            expect(lowering.errors.len()).to_equal(0)
            return OptionalDependencyFixture(lowering: lowering, provider_id: relocated.id, decoy_id: decoy.id)
    fail("parsed provider did not contain SdnTable")

fn optional_dependency_rejected(lowering: MirLowering, message: text) -> bool:
    for error in lowering.errors:
        if error.fatal and error.message.contains(message): return true
    false

describe "Optional record qualified return-type dependencies":
    it "uses the nonlexical relocated provider instead of a local homonym":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        expect(lowering.symbols.exact_symbols["SdnTable"]).to_equal(fixture.decoy_id)
        expect(lowering.symbols.lookup_qualified_type_raw("app.optional.provider", "SdnTable")).to_equal(fixture.provider_id)
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(lowering.errors.len()).to_equal(0)
        match type_.kind:
            case HirTypeKind.Named(symbol, _): expect(symbol.id).to_equal(fixture.provider_id)
            case _: fail("provider dependency did not resolve to its nominal type")

    it "accepts a lexical alias of the same qualified declaration":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        lowering.symbols.exact_symbols["ImportedTable"] = fixture.provider_id
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(lowering.errors.len()).to_equal(0)
        match type_.kind:
            case HirTypeKind.Named(symbol, _): expect(symbol.id).to_equal(fixture.provider_id)
            case _: fail("alias of the same provider was rejected")

    it "rejects a distinct lexical declaration with the same provider identity":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        val duplicate = lowering.symbols.define_with_binding("duplicate", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, Some("app.optional.provider"), false)
        var declaration: HirSymbol = lowering.symbols.symbols[duplicate.id]
        declaration.name = "SdnTable"
        lowering.symbols.symbols[duplicate.id] = declaration
        lowering.symbols.exact_symbols["DuplicateTable"] = duplicate.id
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(type_.kind).to_equal(HirTypeKind.Error)
        expect(optional_dependency_rejected(lowering, "ambiguous current provider declaration")).to_be(true)

    it "rejects a stale qualified entry rather than trusting layout metadata":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        lowering.symbols.qualified_types["app.optional.provider#SdnTable"] = lowering.symbols.next_symbol_id + 100
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(type_.kind).to_equal(HirTypeKind.Error)
        expect(optional_dependency_rejected(lowering, "stale qualified provider declaration")).to_be(true)

    it "rejects a qualified entry pointing at a different owner":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        lowering.symbols.qualified_types["app.optional.provider#SdnTable"] = fixture.decoy_id
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(type_.kind).to_equal(HirTypeKind.Error)
        expect(optional_dependency_rejected(lowering, "mismatched qualified provider declaration")).to_be(true)

    it "retains rejection of conflicting provider field types":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        lowering.result_err_layout_types["app.optional.provider::SdnTable"] = ""
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(type_.kind).to_equal(HirTypeKind.Error)
        expect(optional_dependency_rejected(lowering, "conflicting or unknown provider field types")).to_be(true)

    it "rejects a nonrecord declaration at the qualified provider entry":
        val fixture = optional_dependency_fixture()
        var lowering = fixture.lowering
        var declaration: HirSymbol = lowering.symbols.symbols[fixture.provider_id]
        declaration.kind = SymbolKind.Function
        lowering.symbols.symbols[fixture.provider_id] = declaration
        val type_ = lowering.checked_optional_record_type(0, Span.empty())
        expect(type_.kind).to_equal(HirTypeKind.Error)
        expect(optional_dependency_rejected(lowering, "mismatched qualified provider declaration")).to_be(true)
