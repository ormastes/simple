use std.spec.describe
use std.spec.it
use std.spec.expect

# Reproducer for
# doc/08_tracking/bug/sspec_test_path_value_semantics_divergence_2026-07-20.md
#
# `expr.?` is documented as an existence check returning a bool, but the
# evaluator yields the PRESENT PAYLOAD (or nil when absent) so that
# `if val v = opt.?:` can bind it. Condition sites recover the boolean via
# `is_condition_present`; an assertion is a VALUE position and never did, so
# `expect(...)` silently asserted on the payload instead of on presence:
#
#   expect(dict.get("missing").?).to_equal(false)  -> "expected nil to equal false"
#   expect(err.? == true).to_equal(true)           -> "expected false to equal true"
#
# Fixed in interpreter_call/bdd.rs::eval_assertion_operand.
describe "exists-check in an assertion position":
    it "reports present for a var reassigned from nil to a string":
        var error = nil
        val invalid_input = ""
        if invalid_input.len() == 0:
            error = "Empty input"
        expect(error.? == true).to_equal(true)

    it "reports absent for a dict miss":
        val d = {"a": 1}
        val r = d.get("b")
        expect(r.?).to_equal(false)

    it "reports present for a dict hit":
        val d2 = {"a": 1}
        val hit = d2.get("a")
        expect(hit.?).to_equal(true)

    it "yields a strict bool, not the payload":
        val d3 = {"k": 42}
        val got = d3.get("k")
        expect(got.? == true).to_equal(true)
