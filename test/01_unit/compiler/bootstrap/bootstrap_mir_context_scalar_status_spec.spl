use std.spec
use std.io_runtime.{file_read}

describe "bootstrap MIR context status ownership":
    it "derives status from the returned context instead of a tuple payload":
        val bootstrap = file_read("src/compiler/80.driver/driver_bootstrap.spl")
        val pipeline = file_read("src/compiler/80.driver/driver_aot_pipeline.spl")

        expect(bootstrap.contains("pub fn bootstrap_lower_to_mir_context(ctx: CompileContext) -> CompileContext:")).to_equal(true)
        expect(bootstrap.contains("-> (CompileContext, bool)")).to_equal(false)
        expect(pipeline.contains("self.ctx = bootstrap_lower_to_mir_context(self.ctx)")).to_equal(true)
        expect(pipeline.contains("mir_ok = self.ctx.error_count_value == 0")).to_equal(true)
