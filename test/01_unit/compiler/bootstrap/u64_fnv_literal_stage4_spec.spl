use std.spipe
use std.fs.{read_file}

describe "Stage 4 unsigned hash literals":
    it "uses a parser-safe hexadecimal u64 offset basis in the exact compositor path":
        val source = read_file("src/os/compositor/background_image_provider.spl")
        expect(source).to_contain("0xCBF29CE484222325u64")
        expect(source).to_not_contain("14695981039346656037u64")

    it "uses the same bits in the adjacent GPU event hash owner":
        val source = read_file("src/lib/common/ui/gpu_event_core.spl")
        expect(source).to_contain("0xCBF29CE484222325u64")
        expect(source).to_not_contain("14695981039346656037u64")
