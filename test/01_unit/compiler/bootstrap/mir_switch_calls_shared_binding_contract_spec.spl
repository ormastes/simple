# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "MIR switch/call strict shared bindings":
    it "derives enum and optional payload values without reassignment":
        # @req REQ-SSPEC-COMPILER
        step("derives enum and optional payload values without reassignment")
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")

        expect(source).to_contain("val payload_hir_type: HirType? = match result_payload_type:")
        # 51a7b28e220 (float Option payloads decode): the bound payload is
        # still one value, now matched on `effective_payload_type`, which
        # starts from `payload_hir_type` and only recovers a Float inner type
        # from the scrutinee when every declared source is absent.
        expect(source).to_contain("var effective_payload_type: HirType? = payload_hir_type")
        expect(source).to_contain("effective_payload_type = Some(option_inner)")
        expect(source).to_contain("val bound_payload = match effective_payload_type:")
        expect(source).to_contain("case Some(found_payload_type): self.enum_payload_value(pl, self.lower_type(found_payload_type))")
        expect(source).to_contain("val payload_local = match inner.kind:")
        expect(source).to_contain("val payload_local = match self.enum_match_expr_type(base):")
        expect(source).to_contain("val disc_local = match disc_res:")
        expect(source).to_contain("val str_rendered: LocalId? = match str_src.kind:")
        expect(source).to_not_contain("var payload_hir_type = result_payload_type")
        expect(source).to_not_contain("var bound_payload = pl")
        expect(source).to_not_contain("var payload_local = raw_payload_local")
        expect(source).to_not_contain("var payload_local = pl")
        expect(source).to_not_contain("var str_rendered: LocalId? = nil")