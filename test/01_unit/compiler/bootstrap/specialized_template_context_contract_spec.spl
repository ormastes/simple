# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "specialized template context contract":
    it "routes six-argument context calls through the default wrapper":
        # @req REQ-SSPEC-COMPILER
        step("routes six-argument context calls through the default wrapper")
        for path in [
            "src/compiler/70.backend/linker/linker_context.spl",
            "src/compiler/80.driver/pipeline/compiler_context.spl"
        ]:
            val source = file_read(path)
            expect(source).to_contain("use compiler.driver.pipeline_fn.compile_specialized_template_default")
            expect(source).to_contain("compile_specialized_template_default(")
            expect(source).to_not_contain("pipeline_fn.compile_specialized_template\n")