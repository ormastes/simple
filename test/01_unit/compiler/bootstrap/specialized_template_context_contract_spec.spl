use std.spec
use std.io_runtime.{file_read}

describe "specialized template context contract":
    it "routes six-argument context calls through the default wrapper":
        for path in [
            "src/compiler/70.backend/linker/linker_context.spl",
            "src/compiler/80.driver/pipeline/compiler_context.spl"
        ]:
            val source = file_read(path)
            expect(source).to_contain("use compiler.driver.pipeline_fn.compile_specialized_template_default")
            expect(source).to_contain("compile_specialized_template_default(")
            expect(source.contains("pipeline_fn.compile_specialized_template\n")).to_equal(false)
