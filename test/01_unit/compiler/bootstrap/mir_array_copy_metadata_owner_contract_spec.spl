use std.spec
use std.io_runtime.{file_read}

describe "MIR array copy metadata ownership":
    it "copies HIR metadata without an optional payload boundary":
        val statements = file_read("src/compiler/50.mir/mir_lowering_stmts.spl")
        val types = file_read("src/compiler/50.mir/mir_lowering_types.spl")

        expect(statements.contains("self.copy_local_hir_type_metadata(init_local.id, result_arr.id)")).to_equal(true)
        expect(statements.contains("if val init_hir_type = self.find_local_hir_type(init_local.id):\n            self.remember_local_hir_type(result_arr.id")).to_equal(false)
        expect(types.contains("me copy_local_hir_type_metadata(source_local_id: i64, destination_local_id: i64):")).to_equal(true)
        expect(types.contains("self.local_hir_type_values[i]")).to_equal(true)
