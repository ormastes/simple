use std.spec
use std.io_runtime.{file_read}

describe "bootstrap runtime name collision ordering":
    it "rejects runtime-owned names that lack an exact authored signature":
        val core = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        val method_start = core.index_of("    me bootstrap_llvm_function_index_for_name(func_name: text) -> i64:")
        val method_end = core.index_of("fn bootstrap_llvm_static_index(module_index: i64, symbol_id: i64) -> i64:")
        expect(method_start >= 0 and method_end > method_start).to_equal(true)

        val method = core.substring(method_start, method_end)
        val exact_scan = method.index_of("val exact_index = bootstrap_llvm_exact_function_index(lookup_name)")
        val runtime_guard = method.index_of("if mir_runtime_owned_call_name(lookup_name):\n            return -1")

        expect(exact_scan >= 0).to_equal(true)
        expect(runtime_guard > exact_scan).to_equal(true)
