# Actual owner-lifecycle scenario shared by SSpec and standalone native control.
use compiler.core.types.{reset_all_pools, type_pools_promote_hir_owners,
    custom_primitive_register, custom_primitive_underlying_type_tag_by_name,
    dict_type_register, dict_type_get_key, dict_type_get_value, TYPE_DICT_BASE,
    union_type_register, union_type_get_members, TYPE_UNION_BASE,
    named_generic_instance_register, named_generic_instance_index,
    named_generic_instance_base, named_generic_instance_arg_tags, TYPE_I64, TYPE_TEXT}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

fn type_pool_root_rank_finish_scope_v1() -> text:
    if not rt_transient_array_scope_pause():
        val _ended = rt_transient_array_scope_end()
        return "scope-pause"
    val promoted = type_pools_promote_hir_owners()
    val ended = rt_transient_array_scope_end()
    if not promoted: return "pool-promotion"
    if not ended: return "scope-end"
    ""

fn type_pool_root_rank_control_v1() -> text:
    reset_all_pools()
    if not rt_transient_array_scope_begin(): return "first-scope-begin"
    val primitive = custom_primitive_register("RootRankWord", TYPE_I64)
    val dictionary = dict_type_register(TYPE_TEXT, TYPE_I64)
    val union = union_type_register([TYPE_I64, TYPE_TEXT])
    val generic = named_generic_instance_register("RootRankBox", [TYPE_I64])
    val first = type_pool_root_rank_finish_scope_v1()
    if first != "": return "first:" + first
    if primitive < 0: return "primitive-registration"
    if custom_primitive_underlying_type_tag_by_name("RootRankWord") != TYPE_I64:
        return "first-text-owner"
    if dict_type_get_key(dictionary - TYPE_DICT_BASE) != TYPE_TEXT:
        return "first-scalar-key-owner"
    if dict_type_get_value(dictionary - TYPE_DICT_BASE) != TYPE_I64:
        return "first-scalar-value-owner"
    # Preserve the original std.spec.to_equal content assertion. Direct typed
    # array != compares pointers on 0CD6. Evidence:
    # doc/08_tracking/bug/type_pool_fixture_content_assertion_conversion_2026_10_16.md
    val first_union = union_type_get_members(union - TYPE_UNION_BASE)
    if first_union.len() != 2: return "first-nested-union-length"
    if first_union[0] != TYPE_I64 or first_union[1] != TYPE_TEXT:
        return "first-nested-union-owner"
    val index = named_generic_instance_index(generic)
    if index < 0: return "generic-registry-index"
    if named_generic_instance_base(index) != "RootRankBox": return "first-generic-text-owner"
    val first_args = named_generic_instance_arg_tags(index)
    if first_args.len() != 1: return "first-nested-generic-length"
    if first_args[0] != TYPE_I64: return "first-nested-generic-owner"

    if not rt_transient_array_scope_begin(): return "second-scope-begin"
    custom_primitive_register("RootRankOther", TYPE_TEXT)
    dict_type_register(TYPE_I64, TYPE_TEXT)
    union_type_register([TYPE_TEXT])
    named_generic_instance_register("RootRankOtherBox", [TYPE_TEXT])
    val second = type_pool_root_rank_finish_scope_v1()
    if second != "": return "second:" + second
    if custom_primitive_underlying_type_tag_by_name("RootRankWord") != TYPE_I64:
        return "second-lost-first-text-owner"
    if custom_primitive_underlying_type_tag_by_name("RootRankOther") != TYPE_TEXT:
        return "second-text-owner"
    if dict_type_get_key(dictionary - TYPE_DICT_BASE) != TYPE_TEXT:
        return "second-lost-scalar-owner"
    val second_union = union_type_get_members(union - TYPE_UNION_BASE)
    if second_union.len() != 2: return "second-lost-union-length"
    if second_union[0] != TYPE_I64 or second_union[1] != TYPE_TEXT:
        return "second-lost-nested-union-owner"
    val second_args = named_generic_instance_arg_tags(index)
    if second_args.len() != 1: return "second-lost-generic-length"
    if second_args[0] != TYPE_I64: return "second-lost-generic-owner"
    ""

export type_pool_root_rank_control_v1
