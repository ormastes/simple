# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "HIR symbol table strict shared bindings":
    it "returns raw symbol lookups without a mutable optional accumulator":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: returns raw symbol lookups without a mutable optional accumulator")
        val source = file_read("src/compiler/20.hir/hir_types.spl")

        expect(source).to_contain("fn get_symbol_raw(raw: i64) -> HirSymbol?:")
        expect(source).to_contain("if self.symbols.has(raw):\n            return self.symbols[raw]\n        nil")
        expect(source.contains("var found: HirSymbol? = nil")).to_equal(false)
        expect(source).to_contain("val found: HirSymbol? = self.symbols[raw]")
        expect(source).to_contain("val renamed = HirSymbol(")
        expect(source).to_contain("name: new_name,")
        expect(source.contains("var renamed = sym")).to_equal(false)
        expect(source.contains("renamed.name = new_name")).to_equal(false)
        expect(source).to_contain("fn _hir_symbol_owner_module(path: text) -> text:")
        expect(source).to_contain("return _hir_symbol_owner_module(path.substring(3))")
        expect(source).to_contain("val owner_module = _hir_symbol_owner_module(type_symbol.defining_module ?? \"\")")
        expect(source.contains("var owner_module = type_symbol.defining_module")).to_equal(false)
