# Direct compiler executable check results must contribute to its exit status.

use std.spec.{describe, it, expect}
use compiler.frontend.core.test_core_checks.{check_eq_int, check_eq_str, check_true}
use compiler.frontend.core.test_verdict.{test_exit_code}

describe "direct compiler check accounting":
    it "accepts equal integers and rejects unequal integers":
        expect(check_eq_int("equal", 7, 7)).to_equal(0)
        expect(check_eq_int("unequal", 7, 8)).to_equal(1)

    it "accepts equal text and rejects unequal text":
        expect(check_eq_str("equal", "fn", "fn")).to_equal(0)
        expect(check_eq_str("unequal", "fn", "val")).to_equal(1)

    it "accepts true and rejects false":
        expect(check_true("true", true)).to_equal(0)
        expect(check_true("false", false)).to_equal(1)

    it "preserves early failures when later checks pass":
        var failed = check_eq_int("first fails", 1, 2)
        failed = failed + check_eq_str("second passes", "ok", "ok")
        failed = failed + check_true("last fails", false)
        expect(failed).to_equal(2)
        expect(test_exit_code(3 - failed, failed)).to_equal(1)

    it "reports success when every executed check passes":
        val failed = check_eq_int("integer", 2, 2) + check_eq_str("text", "ok", "ok") + check_true("boolean", true)
        expect(failed).to_equal(0)
        expect(test_exit_code(3 - failed, failed)).to_equal(0)
