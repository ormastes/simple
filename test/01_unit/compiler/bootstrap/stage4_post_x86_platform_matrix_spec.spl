use std.spec.*
use std.io_runtime.{file_read}

describe "Stage 4 post-x86 platform handoff":
    it "retains native, QEMU, and target-lane acceptance commands":
        val plan = file_read("doc/03_plan/infra/agent_sessions/stage4_spdev.md")

        expect(plan).to_contain("ST4-PLAT-A64-LINUX")
        expect(plan).to_contain("ST4-PLAT-MAC")
        expect(plan).to_contain("ST4-PLAT-WIN")
        expect(plan).to_contain("check-freebsd-bootstrap-qemu.shs --full")
        expect(plan).to_contain("--target=simpleos-x86_64")
        expect(plan).to_contain("build-simpleos-arm64-desktop-engine2d-attested.shs")
        expect(plan).to_contain("ST4-CPU-RISCV64")
        expect(plan).to_contain("Hosted target unsupported")
        expect(plan).to_contain("Merge owner is the primary Codex integration agent")
