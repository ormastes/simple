# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use compiler.tools.fix.rules.{check_short_grammar_refactor}
use std.tooling.easy_fix.types.{FixApplicator}
use std.tooling.easy_fix.{easyfix_replacements}

use std.spec.step

use std.spec
use std.io_runtime.{file_read}

# Retargeted 2026-09-26: e73a417cfd6 (perf(lint): reuse lines across easyfix
# rules) removed the rule's own line split and byte-offset counter
# (`_lint_text_index_len`); offsets now come from the shared per-line
# `LineContext` built once by `line_contexts`, so the rule keeps no counter
# of its own and still never reaches for `compiler_fix_text_index_len`.
describe "lint short grammar text indexing":
    it "takes byte offsets from the shared line contexts, not a rule-local counter":
        # @req REQ-SSPEC-COMPILER
        step("takes byte offsets from the shared line contexts, not a rule-local counter")
        val source = file_read("src/compiler/90.tools/fix/rules/impl_/lint_short_grammar.spl")
        val helpers = file_read("src/lib/nogc_sync_mut/tooling/easy_fix/rules_helpers.spl")

        expect(source).to_contain("use compiler.tools.fix.rules.helpers.*")
        expect(source).to_contain("check_short_grammar_refactor_with_contexts(file, line_contexts(source))")
        expect(source).to_contain("fn check_short_grammar_refactor_with_contexts(file: text, contexts: [LineContext]) -> [EasyFix]:")
        expect(source).to_contain("start: ctx.byte_offset + lambda_start,")
        expect(source.contains("var byte_offset")).to_equal(false)
        expect(source.contains("_lint_text_index_len")).to_equal(false)
        expect(source.contains("compiler_fix_text_index_len")).to_equal(false)
        expect(helpers).to_contain("fn line_contexts(source: text) -> [LineContext]:")
        expect(helpers).to_contain("    byte_offset: i64")
