# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use compiler.tools.fix.rules.{check_short_grammar_refactor}
use std.tooling.easy_fix.types.{FixApplicator}
use std.tooling.easy_fix.{easyfix_replacements}

use std.spec.step

use std.spec
use std.io_runtime.{file_read}

describe "lint short grammar text indexing":
    it "keeps its byte-offset counter local to the flattened rule":
        # @req REQ-SSPEC-COMPILER
        step("keeps its byte-offset counter local to the flattened rule")
        val source = file_read("src/compiler/90.tools/fix/rules/impl_/lint_short_grammar.spl")

        expect(source).to_contain("use compiler.tools.fix.rules.helpers.*")
        expect(source).to_contain("fn _lint_text_index_len(value: text) -> i64:")
        expect(source).to_contain("_lint_text_index_len(line)")
        expect(source.contains("compiler_fix_text_index_len")).to_equal(false)
        expect(source.contains("compiler_fix_text_index_len")).to_equal(false)

    it "keeps full-cli lint helpers at concrete lazy owners":
        val cli = file_read("src/app/io/cli_lint_commands.spl")
        val run_cli = file_read("src/app/io/_CliCommands/run_commands.spl")
        val simd = file_read("src/compiler/tools/fix/rules/impl_/lint_simd.spl")
        val short_grammar = file_read("src/compiler/tools/fix/rules/impl_/lint_short_grammar.spl")

        expect(cli).to_contain("rules.impl_.lint_simd.{check_simd_opportunities")
        expect(cli).to_contain("rules.impl_.lint_short_grammar.{check_short_grammar_refactor}")
        expect(run_cli).to_contain("rules.impl_.lint_simd.{check_simd_opportunities")
        expect(simd).to_contain("pub fn check_simd_opportunities")
        expect(short_grammar).to_contain("pub fn check_short_grammar_refactor")
