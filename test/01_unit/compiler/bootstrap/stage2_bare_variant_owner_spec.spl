use std.spipe
use std.fs.{read_file}

describe "Stage 2 variant owners":
    it "pins exact current unit and return variants":
        val effects = read_file("src/compiler/30.types/type_infer/inference_effects.spl")
        val mir_json = read_file("src/compiler/50.mir/mir_json.spl")
        expect(effects).to_contain("CharLit(_) | UnitLit | NilLit")
        expect(mir_json).to_contain("case Return: \"\\\"Return\\\"\"")

    it "qualifies the ambiguous wildcard family in both consumers":
        val hir = read_file("src/compiler/20.hir/hir_lowering/expressions.spl")
        val mir = read_file("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")
        expect(hir).to_contain("case PatternKind.Wildcard:")
        expect(mir).to_contain("case HirPatternKind.Wildcard:")
        expect(hir).to_not_contain("case Wildcard:")
        expect(mir).to_not_contain("case Wildcard:")
        expect(mir).to_not_contain("case PatternKind.Wildcard:")

    it "keeps both adjacent native macOS targets owned by the backend enum":
        val targets = read_file("src/compiler/70.backend/backend/backend_types.spl")
        expect(targets).to_contain("AArch64_MacOS")
        expect(targets).to_contain("X86_64_MacOS")
