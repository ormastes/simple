use std.spec
use std.io_runtime.{file_read}

describe "native entry closure mode transport":
    it "keeps explicit native entries bounded without CompileOptions mode transport":
        # Phase-1 source loading moved out of driver.spl into
        # driver_source_pipeline_loading.spl (56afd1d0123); the entry-closure
        # decision became `entry_closure_walk` (4717bf886af) and every entry
        # walk publishes the closure env channel (ca716186466).
        val source = file_read("src/compiler/80.driver/driver_source_pipeline_loading.spl")

        expect(source).to_contain("val explicit_entry_closure = explicit_entry_input != \"\"")
        expect(source).to_contain("val entry_closure_walk = explicit_entry_closure or (\n            native_entry_input != \"\" and not native_entry_closure_pre)")
        expect(source).to_not_contain("not native_entry_closure_pre and self.ctx.options.mode == CompileMode.Aot")
        expect(source).to_contain("# Every entry walk is now a closure, including the compiler-owned")
        expect(source).to_contain("rt_env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"1\")")
        expect(source).to_not_contain("if self.ctx.errors.len() == 0:\n                # A successful explicit-entry walk is a closure")
