use std.spec
use std.io_runtime.{file_read}

describe "native entry closure mode transport":
    it "keeps explicit native entries bounded without CompileOptions mode transport":
        val source = file_read("src/compiler/80.driver/driver.spl")

        expect(source).to_contain("if nb_entry_env != \"\" and not nb_entry_closure_pre:")
        expect(source).to_not_contain("not nb_entry_closure_pre and self.ctx.options.mode == CompileMode.Aot")
        expect(source).to_contain("# An explicit-entry walk is a closure even when import resolution")
        expect(source).to_not_contain("if self.ctx.errors.len() == 0:\n                # A successful explicit-entry walk is a closure")
