use std.spec
use std.io_runtime.{file_read}

describe "native entry closure mode transport":
    it "keeps explicit native entries bounded with CompileOptions mode transport":
        val loading = file_read("src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val parsing = file_read("src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        val orchestration = file_read("src/compiler/80.driver/driver_orchestration.spl")
        val lowering = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        val bootstrap = file_read("src/compiler/80.driver/driver_bootstrap.spl")
        val cli = file_read("src/app/io/_CliCompile/compile_targets.spl")

        expect(loading).to_contain("val entry_closure_requested = self.ctx.options.entry_closure or nb_entry_env != \"\"")
        expect(parsing).to_contain("val native_entry_closure = self.ctx.options.entry_closure or (")
        expect(parsing).to_contain(r"var entry_modules: Dict<text, ParserModule> = {}")
        expect(parsing).to_contain("for retained_source in unique_entry_sources:")
        expect(parsing).to_contain("val parsed_alias_module: ParserModule = parsed_entry_modules[parsed_idx]")
        expect(parsing).to_contain("val retained_module: ParserModule = parsed_entry_modules[retained_idx]")
        expect(parsing).to_contain("entry_modules[retained_source.module_name] = retained_module")
        expect(parsing).to_contain("entry-closure module alias registration failed:")
        expect(orchestration).to_contain("(ctx.options.entry_closure or")
        expect(lowering).to_contain("val native_entry_closure_mir = self.ctx.options.entry_closure or")
        expect(bootstrap).to_contain("val closure_mode = ctx.options.entry_closure or")
        expect(cli).to_contain("options.entry_closure = effective_entry_closure")
        expect(loading).to_contain("if nb_entry_env != \"\" and not nb_entry_closure_pre:")
        expect(loading).to_not_contain("not nb_entry_closure_pre and self.ctx.options.mode == CompileMode.Aot")
        expect(loading).to_contain("# An explicit-entry walk is a closure even when import resolution")
