use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

fn stage4_entry_source_contract(driver: text, wrapper: text) -> bool:
    val begin = wrapper.index_of("pub fn run_native_build_bootstrap(")
    val end = wrapper.index_of("fn bootstrap_compile_option_takes_value(")
    if begin < 0 or end <= begin:
        return false
    val route = wrapper.substring(begin, end)
    driver.contains("val entry_closure_walk = explicit_entry_closure or (\n            native_entry_input != \"\" and not native_entry_closure_pre)") and
        driver.contains("if entry_closure_walk:\n            if not package_index_routed:\n                driver_inputs = [requested_entry_input]") and
        driver.contains("if entry_closure_walk and not package_index_routed:") and
        route.contains("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"0\")") and
        route.contains("options.input_files = [entry_path]") and
        route.contains("options.bootstrap_input_count = 1") and
        route.contains("options.bootstrap_input_0 = entry_path")

describe "native entry closure mode transport":
    it "keeps explicit native entries bounded at the current source owners":
        val driver = file_read("src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val wrapper = file_read("src/app/cli/bootstrap_main.spl")
        expect(stage4_entry_source_contract(driver, wrapper)).to_equal(true)

    it "rejects the historical location guard before closure discovery":
        val driver = file_read("src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val wrapper = file_read("src/app/cli/bootstrap_main.spl")
        val reverted = driver.replace(
            "native_entry_input != \"\" and not native_entry_closure_pre)",
            "native_entry_input != \"\" and not has_project_source and not native_entry_closure_pre)")
        expect(stage4_entry_source_contract(reverted, wrapper)).to_equal(false)

    it "rejects pre-enabled closure and whole-tree wrapper seeds independently":
        val driver = file_read("src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val wrapper = file_read("src/app/cli/bootstrap_main.spl")
        val pre_enabled = wrapper.replace(
            "env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"0\")",
            "env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"1\")")
        expect(stage4_entry_source_contract(driver, pre_enabled)).to_equal(false)
        val whole_tree = wrapper.replace("options.input_files = [entry_path]",
            "options.input_files = [\"src/compiler\", \"src/app\", \"src/lib\", \"examples/10_tooling\"]")
        expect(stage4_entry_source_contract(driver, whole_tree)).to_equal(false)

    it "fails closed when the route owner is absent":
        val driver = file_read("src/compiler/80.driver/driver_source_pipeline_loading.spl")
        expect(stage4_entry_source_contract(driver, "")).to_equal(false)
