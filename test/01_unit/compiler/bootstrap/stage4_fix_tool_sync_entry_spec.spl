use std.io.{file_read}
use std.spec.{describe, it, expect}

describe "Stage4 fix tool entry":
    it "keeps the synchronous fix CLI out of the Future closure":
        val source = file_read("src/compiler/tools/fix/main.spl")

        expect(source).to_contain("fn main() -> Int:")
        expect(source.contains("async fn main() -> Int:")).to_be(false)
        expect(source.contains("await ")).to_be(false)

    it "uses the native-lowerable text substring API":
        val source = file_read("src/compiler/tools/fix/main.spl")
        expect(source.contains(".slice(")).to_be(false)
        expect(source).to_contain(".substring(")
