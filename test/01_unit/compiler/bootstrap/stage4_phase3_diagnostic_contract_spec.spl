extern fn rt_file_read_text(path: text) -> text

describe "Stage4 Phase 3 diagnostic contract":
    it "prints every buffered HIR diagnostic before either failure result":
        # Retargeted to the reporting loop landed by bc5abc26ce0 (#320): phase 3
        # reads each recorded diagnostic through `error_message_at`, logs it,
        # names the hidden remainder past the 20-line cap, and only then picks
        # ResolveError vs TypeError from the diagnostics it actually read.
        val source = rt_file_read_text("src/compiler/80.driver/driver_orchestration.spl") ?? ""
        val count_at = source.index_of("val phase3_recorded_count: i64 = self.ctx.error_count()")
        val loop_start = source.index_of("while phase3_report_idx < phase3_show_cap:")
        val log_at = source.index_of("log_error(\"  \{phase3_message}\")")
        val hidden_at = source.index_of("log_error(\"  ... and \{phase3_hidden} further phase 3 error(s)\")")
        val resolve_error = source.index_of("if phase3_surviving_errors[0].contains(\"Method resolution\"):")
        val resolve_return = source.index_of("return CompileResult.ResolveError(phase3_surviving_errors)")
        val type_error = source.index_of("return CompileResult.TypeError(phase3_surviving_errors)")

        expect(count_at).to_be_greater_than(-1)
        expect(loop_start).to_be_greater_than(count_at)
        expect(source).to_contain("val phase3_message: text = self.ctx.error_message_at(phase3_report_idx)")
        expect(log_at).to_be_greater_than(loop_start)
        expect(hidden_at).to_be_greater_than(log_at)
        expect(resolve_error).to_be_greater_than(hidden_at)
        expect(resolve_return).to_be_greater_than(resolve_error)
        expect(type_error).to_be_greater_than(resolve_return)
