use std.spec
use std.io_runtime.{file_read}

describe "backend and driver owner imports":
    it "binds each backend name at its canonical owner":
        val backend = file_read(
            "src/compiler/70.backend/backend/compiler.spl")
        val vhdl = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")

        expect(backend).to_contain(
            "use compiler.backend.codegen.{CodegenMode, CodegenPipeline, CraneliftTarget}")
        expect(vhdl).to_contain(
            "use compiler.hir.hir_types.{HirModule, HirFunction, SymbolKind, SymbolId}")
        expect(vhdl).to_contain(
            "use compiler.mir.mir_types.{MirConstant, MirFieldDef, MirStatic, MirTypeDefKind, MirVariantDef}")
        expect(vhdl.contains("var found: SymbolId? = nil")).to_equal(false)

    it "binds each driver name at module scope":
        val loading = file_read(
            "src/compiler/80.driver/driver_source_pipeline_loading.spl")
        val smf = file_read(
            "src/compiler/80.driver/driver_aot_smf_output.spl")

        expect(loading).to_contain(
            "use compiler.common.driver_core_modes.{CompileMode}")
        expect(smf).to_contain(
            "use compiler.driver.cache.cache_validator.{get_shb_interface_hash}")
        expect(smf.contains("fn smf_collect_dependency_hashes(ctx: CompileContext) -> [SmfDependencyEntry]:\n    use compiler.driver.cache.cache_validator")).to_equal(false)

    it "keeps the four source files in the strict compiler closure":
        val fixture = file_read(
            "test/fixtures/native_backend_driver_owner_imports/main.spl")
        expect(fixture).to_contain(
            "use compiler.backend.backend.compiler.{CompilerBackendImpl}")
        expect(fixture).to_contain(
            "use compiler.backend.backend.vhdl.vhdl_design_catalog.*")
        expect(fixture).to_contain(
            "use compiler.driver.driver_source_pipeline_loading.*")
        expect(fixture).to_contain(
            "use compiler.driver.driver_aot_smf_output.*")
        expect(fixture).to_contain("fn main() -> i64:")
