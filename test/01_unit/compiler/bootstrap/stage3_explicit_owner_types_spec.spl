extern fn rt_file_read_text(path: text) -> text

describe "Stage3 explicit owner types":
    it "imports LLVM constants explicitly at their consumers":
        val backend = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_backend.spl") ?? ""
        val module_translate = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_translate.spl") ?? ""
        val expr_translate = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_translate_expr.spl") ?? ""
        expect(backend).to_contain("use std.sffi.llvm.{LLVM_CODE_GEN_LEVEL_NONE, LLVM_CODE_GEN_LEVEL_DEFAULT, LLVM_CODE_GEN_LEVEL_AGGRESSIVE}")
        expect(module_translate).to_contain("use std.sffi.llvm.{LLVM_EXTERNAL_LINKAGE}")
        expect(expr_translate).to_contain("use std.sffi.llvm.{LLVM_PRIVATE_LINKAGE}")

    it "keeps nested field receivers nominally typed":
        val target = rt_file_read_text("src/compiler/70.backend/backend/mir_target_context_provider.spl") ?? ""
        val watcher = rt_file_read_text("src/compiler/80.driver/watcher/watcher_client.spl") ?? ""
        expect(target).to_contain("val capabilities: LlvmCapabilityReport = get_llvm_capabilities()")
        expect(watcher).to_contain("val resp: DaemonResponse = daemon_submit_and_wait")
