# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

use std.spec
use std.io_runtime.{file_read}

describe "VHDL entity strict shared bindings":
    # @manual scenario evidence
    it "derives referenced global symbols without reassignment":
        # @req REQ-SSPEC-COMPILER
        step("derives referenced global symbols without reassignment")
        val source = file_read("src/compiler/70.backend/backend/vhdl_entity_compile.spl")

        expect(source).to_contain("val symbol: SymbolId? = match inst.kind:")
        expect(source.contains("var symbol: SymbolId? = nil")).to_equal(false)
