# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "VHDL entity strict shared bindings":
    it "derives referenced global symbols without reassignment":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: derives referenced global symbols without reassignment")
        val source = file_read("src/compiler/70.backend/backend/vhdl_entity_compile.spl")

        expect(source).to_contain("val symbol: SymbolId? = match inst.kind:")
        expect(source.contains("var symbol: SymbolId? = nil")).to_equal(false)
