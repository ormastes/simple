"""Native entry discovery prefers a package's export facade to legacy mod.spl."""
use std.spec.*
use app.io.env_ops.{env_set}
use app.io.file_ops.{path_absolute}
use app.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{dir_create_all, file_write, file_read, env_get_nullable, env_remove_process}
use compiler.driver.driver_source_loading.{_driver_resolve_entry_import, _driver_entry_import_module_paths}

fn package_facade_fixture() -> text:
    val root = path_absolute("build/native_probe/package-facade-" + time_now_unix_micros().to_string()).replace("\\", "/")
    expect(dir_create_all(root + "/src/app/probe")).to_be(true)
    for package_name in ["env", "header_projection"]:
        val base = root + "/src/lib/nogc_async_mut/" + package_name
        expect(dir_create_all(base)).to_be(true)
        expect(file_write(base + "/mod.spl", "# Legacy directory carrier has no exports.\n")).to_be(true)
        expect(file_write(base + "/__init__.spl", "export use std." + package_name + ".variables.{env_get_or}\n")).to_be(true)
        expect(file_write(base + "/variables.spl", "pub fn env_get_or(key: text, default_value: text) -> text: default_value\n")).to_be(true)
    expect(dir_create_all(root + "/src/lib/nogc_async_mut/legacy_only")).to_be(true)
    expect(file_write(root + "/src/lib/nogc_async_mut/legacy_only/mod.spl", "pub fn legacy_value() -> i64: 7\n")).to_be(true)
    root

fn package_facade_restore_snapshot(previous: text?):
    if val saved = previous:
        expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", saved)).to_be(true)
    else:
        expect(env_remove_process("SIMPLE_SCV_SNAPSHOT_ROOT")).to_be(true)

describe "entry package facade selection preserves provider closure":
    it "finds env_get_or through __init__ when legacy mod also exists":
        val root = package_facade_fixture()
        val previous = env_get_nullable("SIMPLE_SCV_SNAPSHOT_ROOT")
        expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", root)).to_be(true)
        val facade = _driver_resolve_entry_import("std.env", root + "/src/app/probe")
        val provider = _driver_resolve_entry_import("std.env.variables.env_get_or", root + "/src/app/probe")
        package_facade_restore_snapshot(previous)
        expect(facade).to_equal(root + "/src/lib/nogc_async_mut/env/__init__.spl")
        expect(_driver_entry_import_module_paths(file_read(facade))).to_contain("std.env.variables")
        expect(provider).to_equal(root + "/src/lib/nogc_async_mut/env/variables.spl")
        expect(file_read(provider)).to_contain("pub fn env_get_or(")

    it "applies the same rule to an unrelated package":
        val root = package_facade_fixture()
        val previous = env_get_nullable("SIMPLE_SCV_SNAPSHOT_ROOT")
        expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", root)).to_be(true)
        val facade = _driver_resolve_entry_import("std.header_projection", root + "/src/app/probe")
        package_facade_restore_snapshot(previous)
        expect(facade).to_equal(root + "/src/lib/nogc_async_mut/header_projection/__init__.spl")
        expect(_driver_entry_import_module_paths(file_read(facade))).to_contain("std.header_projection.variables")

    it "retains the legacy fallback when no __init__ exists":
        val root = package_facade_fixture()
        val previous = env_get_nullable("SIMPLE_SCV_SNAPSHOT_ROOT")
        expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", root)).to_be(true)
        val legacy = _driver_resolve_entry_import("std.legacy_only", root + "/src/app/probe")
        package_facade_restore_snapshot(previous)
        expect(legacy).to_equal(root + "/src/lib/nogc_async_mut/legacy_only/mod.spl")

    it "keeps direct .spl precedence when both directory carriers exist":
        val root = package_facade_fixture()
        val direct = root + "/src/lib/nogc_async_mut/header_projection.spl"
        expect(file_write(direct, "pub fn direct_value() -> i64: 11\n")).to_be(true)
        val previous = env_get_nullable("SIMPLE_SCV_SNAPSHOT_ROOT")
        expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", root)).to_be(true)
        val selected = _driver_resolve_entry_import("std.header_projection", root + "/src/app/probe")
        package_facade_restore_snapshot(previous)
        expect(selected).to_equal(direct)
