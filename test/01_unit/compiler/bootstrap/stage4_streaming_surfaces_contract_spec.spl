use std.io.{file_read}
use std.spec.{describe, it, expect}

val SURFACE = "src/compiler/20.hir/hir_lowering/module_surface.spl"
val LOWERING = "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl"
val ORCHESTRATION = "src/compiler/80.driver/driver_orchestration.spl"
val SOURCE_PARSING = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"
val HIR_LOWERING = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
val HIR_PASSES = "src/compiler/80.driver/driver_hir_pipeline_passes.spl"
val MIR_BOOTSTRAP = "src/compiler/50.mir/_MirLowering/bootstrap_globals.spl"
val PRODUCER = "scripts/bootstrap/bootstrap-from-scratch.sh"
val RUNTIME = "src/runtime/runtime_native.c"
val RUNTIME_CHECK = "src/runtime/test/rt_transient_heap_scope_selfcheck.c"
val RUST_RUNTIME = "src/compiler_rust/runtime/src/value/collections.rs"
val RUST_MEMORY = "src/runtime/runtime_memory.c"

describe "Stage4 streaming surface ownership":
    it "derives HIR phase status from scalar state without method dispatch":
        val driver = file_read(HIR_LOWERING)
        expect(driver).to_contain("if self.ctx.error_count_value > 0 or phase_ctx.error_count_value > 0:")
        expect(driver).to_contain("(phase_ctx, self.ctx.error_count_value == 0 and phase_ctx.error_count_value == 0)")
        expect(driver).to_not_contain("phase_ctx.has_errors()")
        expect(driver).to_not_contain("bootstrap_ctx.has_errors()")

    it "does not re-read stale context status after the successful HIR phase return":
        val passes = file_read(HIR_PASSES)
        expect(passes).to_contain("Phase 3 is the authoritative fail-closed error gate")
        expect(passes).to_not_contain("if self.ctx.error_count_value > 0:\n            return false")

    it "resets the flat HIR closure once at the driver phase owner":
        val driver = file_read(HIR_LOWERING)
        val lowering = file_read(LOWERING)
        expect(driver).to_contain("bootstrap_hir_modules_reset()")
        expect(driver).to_contain("This phase owns the flat-HIR accumulator lifecycle")
        expect(lowering).to_not_contain("if bootstrap_flat_mode and (not bootstrap_closure or hir_module_is_bootstrap_entry(module.name))")
        expect(driver).to_contain("bootstrap_hir_modules_add_alias(source.module_name, flat_source_index)")
        expect(driver).to_contain("flat_index_by_surface")
        expect(driver).to_contain("bootstrap_hir_modules_has_exact_name(requested_entry_name)")
        expect(driver).to_contain("Flat HIR entry ownership was not captured after exact re-lowering")
        expect(driver).to_contain("bootstrap_hir_modules_add_alias(requested_entry_name, flat_count_before_entry)")
        expect(driver).to_contain("Flat HIR entry source was not found")
        expect(driver).to_contain("val requested_bootstrap_entry_name: text = bootstrap_entry_module_name(self.ctx)")
        expect(driver).to_contain("Non-streaming flat HIR entry ownership was not captured")
        expect(driver).to_contain("Bootstrap logical ParserModule owner is missing")
        expect(driver).to_contain("bootstrap_hir_set_requested_entry_name(requested_bootstrap_entry_name)")
        expect(driver).to_contain("bootstrap_hir_set_current_module_is_entry(is_requested_bootstrap_entry)")
        expect(driver).to_contain("bootstrap_hir_set_current_module_is_entry(false)")
        expect(lowering).to_contain("bootstrap_use_flat_entry_functions")
        expect(lowering).to_contain("flat_bootstrap_function_at(bootstrap_decl_idx)")

    it "resolves a physical entry alias only through one exact bootstrap signature":
        val mir = file_read(MIR_BOOTSTRAP)
        expect(mir).to_contain("fn bootstrap_flat_entry_signature_matches")
        expect(mir).to_contain("has_main and has_help and has_output_parser and has_native_build")
        expect(mir).to_contain("if signature_matches != 1:")
        expect(mir).to_contain("[bootstrap-entry-alias]")
        expect(mir).to_contain("val hir_fn: HirFunction = functions[hir_function_index]")
        expect(mir).to_contain("val mir_block: MirBlock = mir_fn.blocks[mir_block_index]")
        expect(mir).to_contain("[flat-mir-function] start")

    it "binds the requested entry from a fresh Phase 2 parser owner":
        val parsing = file_read(SOURCE_PARSING)
        expect(parsing).to_contain("Physical dedup fan-out above intentionally reuses one boxed")
        expect(parsing).to_contain("entry_modules[requested_source.module_name] = requested_module")
        expect(parsing).to_contain("requested native entry parse owner is not unique")

    it "keeps bootstrap native dispatch in the focused owner":
        val producer = file_read("src/app/cli/bootstrap_main.spl")
        val focused = file_read("src/app/cli/bootstrap_focused_native_build.spl")
        expect(producer).to_contain("run_bootstrap_native_build_dispatch(args)")
        expect(focused).to_contain("extern fn rt_path_stem(path: text) -> text")
        expect(focused).to_contain("Keep indexed text values at their array owner")
        expect(producer).to_not_contain("val bundle = args[i + 1]")
        expect(focused).to_contain("extern fn rt_bootstrap_native_build(args: [text]) -> i64")
        expect(focused).to_contain("rt_bootstrap_native_build(args)")
        expect(focused).to_contain("rt_bootstrap_native_build_single_spl_positional(args)")

    it "retains type aliases and required declaration carriers":
        val surface = file_read(SURFACE)
        val lowering = file_read(LOWERING)
        expect(surface).to_contain("type_aliases: Dict<text, ModuleSurfaceTypeAlias>")
        expect(surface).to_contain("for name in module.type_aliases.keys():")
        expect(surface).to_contain("default_methods: [Function]")
        expect(surface).to_contain("variants: [Variant]")
        expect(lowering).to_contain("if m.type_aliases.contains_key(name):")
        expect(lowering).to_contain("keys = imported_mod.type_aliases.keys()")

    it "requires every explicit Stage4 admission condition without a resource-profile gate":
        val driver = file_read(ORCHESTRATION)
        val producer = file_read(PRODUCER)
        val selector_start = driver.index_of("pub fn driver_streaming_surface_enabled")
        val selector_end = driver.index_of("impl CompilerDriver:")
        expect(selector_start).to_be_greater_than(0)
        expect(selector_end).to_be_greater_than(selector_start)
        val selector = driver.substring(selector_start, selector_end)
        expect(selector).to_contain("ctx.options.mode == CompileMode.Aot")
        expect(selector.contains("ctx.options.low_memory")).to_equal(false)
        expect(selector).to_contain("SIMPLE_BOOTSTRAP")
        expect(selector).to_contain("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
        expect(selector).to_contain("SIMPLE_BOOTSTRAP_STAGE4")
        expect(selector).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES")
        expect(selector).to_contain("ctx.options.backend != \"vhdl\"")
        expect(producer).to_contain("SIMPLE_BOOTSTRAP_LOW_MEMORY=1")
        expect(producer).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES=1")
        expect(producer).to_contain("SIMPLE_NATIVE_ARENA_DECLS=1")
        expect(producer).to_contain("Stage 4 emitted stale flat-AST index diagnostics")

    it "keeps structural streaming enabled for the unlimited incremental profile":
        val producer = file_read(PRODUCER)
        expect(producer).to_contain("execution_profile=incremental-unlimited")
        expect(producer).to_contain("jobs=")
        expect(producer).to_contain("host_cpus")
        expect(producer).to_contain("--threads")
        expect(producer).to_contain("selfhost_jobs")
        expect(producer).to_contain("--low-memory")
        expect(producer).to_contain("SIMPLE_BOOTSTRAP_LOW_MEMORY=1")
        expect(producer.contains("stage4_low_memory=0")).to_equal(false)

    it "keeps streaming opt-in and Stage4-specific":
        val driver = file_read(ORCHESTRATION)
        val selector_start = driver.index_of("pub fn driver_streaming_surface_enabled")
        val selector_end = driver.index_of("impl CompilerDriver:")
        val selector = driver.substring(selector_start, selector_end)
        expect(selector).to_contain("SIMPLE_BOOTSTRAP_STAGE4")
        expect(selector).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES")
        expect(selector).to_contain("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
        expect(selector).to_contain("ctx.options.mode == CompileMode.Aot")
        expect(selector).to_contain("ctx.options.backend != \"vhdl\"")

    it "enables native declaration arenas in the Stage3 transcribed build":
        val producer = file_read(PRODUCER)
        val hash_start = producer.index_of("stage3_build_args_sha256=$(")
        val stage3_start = producer.index_of("# Stage 3: stage2 recompiles bootstrap_main.spl")
        val stage3_end = producer.index_of("stage3_status=$?")
        expect(hash_start).to_be_greater_than(0)
        expect(stage3_start).to_be_greater_than(hash_start)
        expect(stage3_end).to_be_greater_than(stage3_start)
        val hash_block = producer.substring(hash_start, stage3_start)
        val stage3_block = producer.substring(stage3_start, stage3_end)
        expect(hash_block).to_contain("\"SIMPLE_NATIVE_ARENA_DECLS=1\"")
        expect(hash_block).to_contain("\"SIMPLE_BOOTSTRAP_STAGE4=0\"")
        expect(hash_block).to_contain("\"SIMPLE_STAGE4_STREAMING_SURFACES=0\"")
        expect(stage3_block).to_contain("SIMPLE_NATIVE_ARENA_DECLS=1")
        expect(stage3_block).to_contain("SIMPLE_BOOTSTRAP_STAGE4=0")
        expect(stage3_block).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES=0")

    it "promotes only the retained surface before reclaiming the rich module":
        val driver = file_read(SOURCE_PARSING)
        val start = driver.index_of("me add_streaming_module_surface")
        val end = driver.index_of("me parse_all_streaming_surfaces_impl")
        val body = driver.substring(start, end)
        val begin = body.index_of("rt_transient_array_scope_begin()")
        val parse = body.index_of("parse_full_frontend(")
        val pause = body.index_of("rt_transient_array_scope_pause()")
        val add = body.index_of("builder.add_parsed(")
        val promote = body.index_of("module_surface_promote(")
        val reclaim = body.last_index_of("driver_end_transient_parse_scope()")
        expect(begin).to_be_greater_than(0)
        expect(parse).to_be_greater_than(begin)
        expect(pause).to_be_greater_than(parse)
        expect(add).to_be_greater_than(pause)
        expect(promote).to_be_greater_than(add)
        expect(reclaim).to_be_greater_than(promote)
        expect(body.contains("rt_transient_heap_promote(module)")).to_equal(false)

    it "walks retained graphs through raw struct allocations":
        val runtime = file_read(RUNTIME)
        val check = file_read(RUNTIME_CHECK)
        val rust_runtime = file_read(RUST_RUNTIME)
        val rust_memory = file_read(RUST_MEMORY)
        expect(runtime).to_contain("RT_CORE_TRANSIENT_RAW")
        expect(runtime).to_contain("rt_core_transient_raw_lookup(raw_ptr)")
        expect(runtime).to_contain("offset + sizeof(int64_t) <= node.bytes")
        expect(check).to_contain("tagged raw root promotes through collection and raw aggregate edges")
        expect(check).to_contain("a second promotion of the retained graph succeeds")
        expect(rust_runtime).to_contain("rt_transient_raw_words")
        expect(rust_runtime).to_contain("reachable_raw")
        expect(rust_memory).to_contain("rt_transient_raw_scope_end")
        expect(rust_memory).to_contain("RT_TRANSIENT_RAW_OWNED_BIT")

    it "reclaims each reparsed AST after persistent HIR lowering":
        val driver = file_read(HIR_LOWERING)
        val start = driver.index_of("me lower_streaming_surface_source")
        val end = driver.index_of("me lower_and_check_streaming_surfaces_impl")
        val body = driver.substring(start, end)
        val begin = body.index_of("rt_transient_array_scope_begin()")
        val parse = body.index_of("parse_full_frontend(")
        val pause = body.index_of("rt_transient_array_scope_pause()")
        val lower = body.index_of("lowering.lower_parser_module_unstub(module)")
        val promote = body.index_of("rt_transient_heap_promote(hir_module)")
        val diagnostic_promote = body.index_of("rt_transient_heap_promote(lowering.errors)")
        val reclaim = body.last_index_of("driver_end_transient_parse_scope()")
        expect(parse).to_be_greater_than(begin)
        expect(pause).to_be_greater_than(parse)
        expect(lower).to_be_greater_than(pause)
        expect(promote).to_be_greater_than(lower)
        expect(diagnostic_promote).to_be_greater_than(promote)
        expect(reclaim).to_be_greater_than(diagnostic_promote)
        expect(body.contains("rt_transient_heap_promote(lowering)")).to_equal(false)

    it "clears parser roots before ending a transient scope":
        val driver = file_read(SOURCE_PARSING)
        val start = driver.index_of("fn driver_end_transient_parse_scope")
        val end = driver.index_of("impl CompilerDriver:")
        val body = driver.substring(start, end)
        val lexer_clear = body.index_of("lexer_release_parse_source_globals()")
        val ast_clear = body.index_of("ast_reset()")
        val scope_end = body.index_of("rt_transient_array_scope_end()")
        expect(ast_clear).to_be_greater_than(lexer_clear)
        expect(scope_end).to_be_greater_than(ast_clear)
