# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.io.{file_read}
use std.spec.{describe, it, expect}
use compiler.driver.driver_phase_gates.{driver_streaming_surface_gate_values}


val SURFACE = "src/compiler/20.hir/hir_lowering/module_surface.spl"
val PARSER_TYPES = "src/compiler/10.frontend/parser_types.spl"
val PARSER = "src/compiler/10.frontend/core/parser.spl"
val FN_STRUCT_DECLS = "src/compiler/10.frontend/core/_ParserDecls/fn_struct_decls.spl"
val MODULE_ASSEMBLY = "src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl"
val DESUGAR_ASYNC = "src/compiler/10.frontend/desugar/desugar_async.spl"
val SOURCE_11 = "src/compiler/70.backend/backend/interpreter.spl"
val SOURCE_11_EXPR = "src/compiler/70.backend/backend/interpreter_expr.spl"
val SOURCE_11_BINOP = "src/compiler/70.backend/backend/interpreter_binop.spl"
val LOWERING = "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl"
val LOWERING_TYPES = "src/compiler/20.hir/hir_lowering/types.spl"
val LOWERING_HELPERS = "src/compiler/20.hir/hir_lowering/_Items/lowering_helpers.spl"
val ORCHESTRATION = "src/compiler/80.driver/driver_orchestration.spl"
val SOURCE_PARSING = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"
val SOURCE_LOADING = "src/compiler/80.driver/driver_source_pipeline_loading.spl"
val HIR_LOWERING = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
val LOG_HELPERS = "src/compiler/80.driver/driver_log_helpers.spl"
val PRODUCER = "scripts/bootstrap/bootstrap-from-scratch.sh"
val RUNTIME = "src/runtime/runtime_native.c"
val RUNTIME_CHECK = "src/runtime/test/rt_transient_heap_scope_selfcheck.c"
val RUST_RUNTIME = "src/compiler_rust/runtime/src/value/collections.rs"
val RUST_MEMORY = "src/runtime/runtime_memory.c"

describe "Stage4 streaming surface ownership":
    it "keeps the complete module surface registry reference-owned":
        val surface = file_read(SURFACE)
        expect(surface).to_contain("class ModuleSurfacesByName:")
        expect(surface.contains("struct ModuleSurfacesByName:")).to_equal(false)

    it "bounds source 11 and projects it through compact headers and a sliced owner":
        val parser_types = file_read(PARSER_TYPES)
        val assembly = file_read(MODULE_ASSEMBLY)
        val desugar = file_read(DESUGAR_ASYNC)
        val surface = file_read(SURFACE)
        val driver = file_read(SOURCE_PARSING)
        val source_11 = file_read(SOURCE_11)
        val source_11_expr = file_read(SOURCE_11_EXPR)
        val source_11_binop = file_read(SOURCE_11_BINOP)
        expect(source_11.len()).to_be_less_than(35000)
        expect(source_11_expr.len()).to_be_less_than(30000)
        expect(source_11_binop.len()).to_be_less_than(20000)
        expect(source_11.contains("fn eval_expr(")).to_equal(false)
        expect(source_11.contains("fn eval_binop(")).to_equal(false)
        expect(source_11).to_contain("use compiler.backend.backend.interpreter_expr.*")
        expect(source_11).to_contain("use compiler.backend.backend.interpreter_binop.*")
        expect(source_11_expr).to_contain("fn eval_expr(")
        expect(source_11_binop).to_contain("fn eval_binop(")
        expect(parser_types).to_contain("function_headers: Dict<text, ParserFunctionHeader>")
        expect(parser_types).to_contain("fn parser_function_header(function_: ParserFunction)")
        expect(assembly).to_contain("function_headers[fn_.name] = parser_function_header(fn_)")
        expect(assembly).to_contain("built_module.function_headers = function_headers")
        expect(desugar).to_contain("function_headers: desugared_function_headers")
        expect(surface).to_contain("class ModuleSurfaceParserOwner:")
        expect(surface).to_contain("me surface(source: SourceFile, source_index: i64)")
        expect(surface).to_contain("parser_function_headers.contains_key(name)")
        expect(surface.contains("value: ParserModule")).to_equal(false)
        expect(surface.contains("ModuleSurfaceParserOwner.new(")).to_equal(false)
        expect(driver).to_contain("var module_owner = ModuleSurfaceParserOwner(")
        expect(driver).to_contain("module_owner.surface(source, source_index)")
        expect(driver).to_contain("log_module_surface_stage(source.path, \"parse-start\")")
        expect(driver).to_contain("log_module_surface_stage(source.path, \"surface-done\")")

    it "retains type aliases and required declaration carriers":
        # @req REQ-SSPEC-UNIT
        step("retains type aliases and required declaration carriers")
        val surface = file_read(SURFACE)
        val lowering = file_read(LOWERING)
        expect(surface).to_contain("type_aliases: Dict<text, ModuleSurfaceTypeAlias>")
        expect(surface).to_contain("for name in parser_type_aliases.keys():")
        expect(surface).to_contain("default_methods: [Function]")
        expect(surface).to_contain("variants: [Variant]")
        expect(lowering).to_contain("if m.type_aliases.contains_key(name):")
        expect(lowering).to_contain("imported_mod.type_aliases.contains_key(imported_name)")

    it "keeps the global export owner index out of native text dictionaries":
        val surface = file_read(SURFACE)
        val driver = file_read(SOURCE_PARSING)
        expect(surface).to_contain("class ModuleSurfaceOwnerIndex:")
        expect(surface).to_contain("fn module_surface_owner_index_slot(")
        expect(surface).to_contain("val owner_index = module_surface_owner_index_new(owner_entry_count)")
        expect(surface).to_contain("counted_surface.export_route_sources.len()")
        expect(surface.contains("var owner_by_package_name: Dict<text, i64>")).to_equal(false)
        expect(surface.contains("val owner_key =")).to_equal(false)
        expect(surface).to_contain("while existing_index < origin_index.names.len()")
        expect(surface).to_contain("Scalar origin arrays are the sole native-safe authority")
        expect(surface.contains("if origin_index.index_by_name.contains_key(name)")).to_equal(false)
        expect(surface.contains("var compatibility_origins:")).to_equal(false)
        val resolve_start = surface.index_of("me resolve_export_origins()")
        val resolve_end = surface.index_of("fn module_surfaces_validate_index_alignment(")
        val resolve_body = surface.substring(resolve_start, resolve_end)
        expect(resolve_body.contains(".export_origins =")).to_equal(false)
        expect(resolve_body).to_contain("var owner_canonical_names: [text] = []")
        expect(resolve_body).to_contain("var owner_package_names: [text] = []")
        expect(resolve_body).to_contain("owner_package_names[exported_owner_index]")
        expect(resolve_body).to_contain("The lattice is monotonic")
        expect(resolve_body.contains("previous_origin.owner_module !=")).to_equal(false)
        expect(resolve_body.contains("previous_origin.source_name !=")).to_equal(false)
        expect(resolve_body).to_contain("[phase2:export-origin:pass]")
        expect(resolve_body).to_contain("[phase2:export-origin:direct]")
        expect(resolve_body).to_contain("Leave origin hints")
        expect(resolve_body).to_contain("return Ok(())\n\n        var surface_index = 0")
        expect(resolve_body).to_contain("val stage3_direct_origins_complete =")
        expect(resolve_body).to_contain("var origin_changed = not stage3_direct_origins_complete")
        expect(resolve_body).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES")
        expect(resolve_body).to_contain("Do not enter a semantically no-op legacy scan")
        expect(resolve_body).to_contain("return Ok(())\n\n        # Plain file-facade exports")
        expect(driver.contains("builder.resolve_export_origins()")).to_equal(false)
        expect(driver).to_contain("Streaming lowering consumes compact import/export route arrays")

    it "requires every explicit Stage4 admission condition without a resource-profile gate":
        # @req REQ-SSPEC-UNIT
        step("requires every explicit Stage4 admission condition without a resource-profile gate")
        val driver = file_read(ORCHESTRATION)
        val producer = file_read(PRODUCER)
        val selector_start = driver.index_of("pub fn driver_streaming_surface_enabled")
        val selector_end = driver.index_of("impl CompilerDriver:")
        expect(selector_start).to_be_greater_than(0)
        expect(selector_end).to_be_greater_than(selector_start)
        val selector = driver.substring(selector_start, selector_end)
        expect(selector).to_contain("ctx.options.mode == CompileMode.Aot")
        expect(selector.contains("ctx.options.low_memory")).to_equal(false)
        expect(selector).to_contain("SIMPLE_BOOTSTRAP")
        expect(selector).to_contain("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
        expect(selector).to_contain("SIMPLE_BOOTSTRAP_STAGE4")
        expect(selector).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES")
        expect(selector).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES")
        expect(selector).to_contain("ctx.options.backend != \"vhdl\"")
        expect(producer).to_contain("SIMPLE_BOOTSTRAP_LOW_MEMORY=1")
        expect(producer).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES=1")
        expect(producer).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES=1")
        expect(producer).to_contain("SIMPLE_NATIVE_ARENA_DECLS=1")
        expect(producer).to_contain("Stage 4 emitted stale flat-AST index diagnostics")

    it "keeps structural streaming enabled for the unlimited incremental profile":
        # @req REQ-SSPEC-UNIT
        step("keeps structural streaming enabled for the unlimited incremental profile")
        val producer = file_read(PRODUCER)
        expect(producer).to_contain("execution_profile=incremental-unlimited")
        expect(producer).to_contain("jobs=")
        expect(producer).to_contain("host_cpus")
        expect(producer).to_contain("--threads")
        expect(producer).to_contain("selfhost_jobs")
        expect(producer).to_contain("--low-memory")
        expect(producer).to_contain("SIMPLE_BOOTSTRAP_LOW_MEMORY=1")
        expect(producer.contains("stage4_low_memory=0")).to_equal(false)

    it "keeps streaming opt-in with Stage3 and legacy Stage4 producers":
        val driver = file_read(ORCHESTRATION)
        val selector_start = driver.index_of("pub fn driver_streaming_surface_enabled")
        val selector_end = driver.index_of("impl CompilerDriver:")
        val selector = driver.substring(selector_start, selector_end)
        expect(selector).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES")
        expect(selector).to_contain("SIMPLE_BOOTSTRAP_STAGE4")
        expect(selector).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES")
        expect(selector).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES")
        expect(selector).to_contain("stage4_streaming or stage3_streaming")
        expect(selector).to_contain("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
        expect(selector).to_contain("ctx.options.mode == CompileMode.Aot")
        expect(selector).to_contain("ctx.options.backend != \"vhdl\"")

    it "switches Stage3 declaration arenas on after compact surfaces":
        val producer = file_read(PRODUCER)
        val hash_start = producer.index_of("stage3_build_args_sha256=$(")
        val stage3_start = producer.index_of("# Stage 3: stage2 recompiles bootstrap_main.spl")
        val stage3_end = producer.index_of("stage3_status=$?")
        expect(hash_start).to_be_greater_than(0)
        expect(stage3_start).to_be_greater_than(hash_start)
        expect(stage3_end).to_be_greater_than(stage3_start)
        val hash_block = producer.substring(hash_start, stage3_start)
        val stage3_block = producer.substring(stage3_start, stage3_end)
        expect(hash_block).to_contain("\"SIMPLE_STAGE3_STREAMING_SURFACES=1\"")
        expect(stage3_block).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES=1")
        expect(hash_block).to_contain("\"MALLOC_ARENA_MAX=2\"")
        expect(hash_block).to_contain("\"MALLOC_TRIM_THRESHOLD_=0\"")
        expect(stage3_block).to_contain("MALLOC_ARENA_MAX=2")
        expect(stage3_block).to_contain("MALLOC_TRIM_THRESHOLD_=0")
        expect(hash_block).to_contain("\"SIMPLE_NATIVE_ARENA_DECLS=1\"")
        expect(stage3_block).to_contain("SIMPLE_NATIVE_ARENA_DECLS=1")
        val parsing = file_read(SOURCE_PARSING)
        expect(parsing).to_not_contain("rt_env_set(\"SIMPLE_NATIVE_ARENA_DECLS\"")

    it "reclaims Stage3 closure import scanner scratch per source":
        val loading = file_read(SOURCE_LOADING)
        val scan_start = loading.index_of("val closure_scan_scoped =")
        val scan_end = loading.index_of("closure_idx = closure_idx + 1")
        val scan = loading.substring(scan_start, scan_end)
        expect(scan_start).to_be_greater_than(0)
        expect(scan_end).to_be_greater_than(scan_start)
        expect(scan).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES")
        expect(scan).to_contain("rt_transient_array_scope_begin()")
        expect(scan).to_contain("rt_transient_array_scope_pause()")
        expect(scan).to_contain("rt_transient_heap_promote(closure_imports)")
        expect(scan).to_not_contain("rt_transient_heap_promote(all_sources)")
        expect(scan).to_contain("rt_transient_array_scope_end()")

    it "builds the retained surface after pausing the discard-only parser arena":
        val driver = file_read(SOURCE_PARSING)
        val start = driver.index_of("me parse_all_streaming_surfaces_impl")
        val end = driver.index_of("me parse_all_impl")
        val body = driver.substring(start, end)
        val begin = body.index_of("rt_transient_discard_scope_begin()")
        val parse = body.index_of("parse_full_frontend(")
        val owner = body.index_of("ModuleSurfaceParserOwner(")
        val build = body.index_of("module_owner.surface(")
        val surface_unwrap = body.index_of("surface_result.unwrap()")
        val pause = body.index_of("rt_transient_array_scope_pause()")
        val promote = body.index_of("module_surface_promote(")
        val publish = body.index_of("builder.add_surface_canonical(")
        val reclaim = body.last_index_of("driver_end_transient_parse_scope()")
        expect(begin).to_be_greater_than(0)
        expect(parse).to_be_greater_than(begin)
        expect(owner).to_be_greater_than(parse)
        expect(build).to_be_greater_than(owner)
        expect(surface_unwrap).to_be_greater_than(build)
        expect(pause).to_be_greater_than(surface_unwrap)
        expect(promote).to_be_greater_than(pause)
        expect(publish).to_be_greater_than(promote)
        expect(reclaim).to_be_greater_than(publish)
        expect(body.contains("rt_transient_heap_promote(module)")).to_equal(false)
        val frontend = file_read("src/compiler/10.frontend/frontend.spl")
        val owner_start = frontend.index_of(
            "pub fn parse_full_frontend_streaming_owner_diagnostic(")
        val owner_body = frontend.substring(owner_start, frontend.len())
        expect(owner_body).to_contain(
            "frontend_parse_or_restore(parse_source, file_path, false)")
        expect(owner_body).not_to_contain(
            "frontend_parse_or_restore(parse_source, file_path, true)")

    it "walks retained graphs through raw struct allocations":
        # @req REQ-SSPEC-UNIT
        step("walks retained graphs through raw struct allocations")
        val runtime = file_read(RUNTIME)
        val check = file_read(RUNTIME_CHECK)
        val rust_runtime = file_read(RUST_RUNTIME)
        val rust_memory = file_read(RUST_MEMORY)
        expect(runtime).to_contain("RT_CORE_TRANSIENT_RAW")
        expect(runtime).to_contain("rt_core_transient_raw_lookup(raw_ptr)")
        expect(runtime).to_contain("offset + sizeof(int64_t) <= node.bytes")
        expect(runtime).to_contain("rt_core_transient_raw_alloc_cap > 262144")
        expect(runtime).to_contain("free(rt_core_transient_raw_allocs)")
        expect(runtime).to_contain("rt_core_transient_raw_allocs = NULL")
        expect(runtime).to_contain("rt_core_transient_raw_alloc_cap = 0")
        expect(runtime).to_contain("#if defined(__GLIBC__)")
        expect(runtime).to_contain("malloc_trim(0)")
        expect(runtime).to_contain("rt_core_transient_pages_released = 1")
        expect(runtime).to_contain("if (rt_core_transient_pages_released) malloc_trim(0)")
        expect(runtime).to_contain("if (released) rt_core_transient_pages_released = 1")
        expect(runtime).to_contain("if (!ptr) return rt_core_scope_malloc(bytes)")
        expect(runtime).to_contain("rt_core_discard_realloc(ptr, bytes)")
        expect(runtime).to_contain("return rt_core_discard_alloc(total)")
        expect(runtime).to_contain("rt_core_transient_array_scope_paused")
        expect(runtime).to_contain("array->transient_scope_id == 0")
        expect(runtime).to_contain("array->cap = 0")
        expect(check).to_contain("tagged raw root promotes through collection and raw aggregate edges")
        expect(check).to_contain("a second promotion of the retained graph succeeds")
        expect(rust_runtime).to_contain("rt_transient_raw_words")
        expect(rust_runtime).to_contain("reachable_raw")
        expect(rust_memory).to_contain("rt_transient_raw_scope_end")
        expect(rust_memory).to_contain("rt_transient_raw_discard_scope_begin")
        expect(rust_memory).to_contain("rt_transient_discard_alloc")
        expect(rust_runtime).to_contain("rt_transient_raw_discard_scope_begin")
        expect(rust_runtime).to_contain("[STAGE2-HEAP-SCOPE]")
        expect(rust_memory).to_contain("[STAGE2-RAW-ARENA]")
        expect(rust_memory).to_contain("RT_TRANSIENT_RAW_OWNED_BIT")

    it "reclaims each reparsed AST after persistent HIR lowering":
        val driver = file_read(HIR_LOWERING)
        val lowering_types = file_read(LOWERING_TYPES)
        val lowering_helpers = file_read(LOWERING_HELPERS)
        val log_helpers = file_read(LOG_HELPERS)
        val start = driver.index_of("me lower_streaming_surface_source")
        val end = driver.index_of("me lower_and_check_streaming_surfaces_impl")
        val body = driver.substring(start, end)
        val begin = body.index_of("rt_transient_array_scope_begin()")
        val parse = body.index_of("parse_full_frontend(")
        val lower = body.index_of(
            "lowering.lower_parser_module_unstub(module, is_entry)")
        val pause = body.index_of("rt_transient_array_scope_pause()")
        val promote = body.index_of("rt_transient_heap_promote(hir_module)")
        val owner_promote = body.index_of(
            "lowering.promote_transient_compilation_roots()")
        val bootstrap_promote = body.index_of(
            "bootstrap_hir_modules_promote_transient_roots()")
        val detach = body.index_of(
            "lowering.detach_transient_module_scratch()")
        val reclaim = body.last_index_of("driver_end_transient_parse_scope()")
        expect(parse).to_be_greater_than(begin)
        expect(lower).to_be_greater_than(parse)
        expect(pause).to_be_greater_than(lower)
        expect(promote).to_be_greater_than(pause)
        expect(owner_promote).to_be_greater_than(promote)
        expect(bootstrap_promote).to_be_greater_than(owner_promote)
        expect(detach).to_be_greater_than(bootstrap_promote)
        expect(reclaim).to_be_greater_than(detach)
        expect(body.contains("rt_transient_heap_promote(lowering)")).to_equal(false)
        expect(body).to_contain("log_hir_transient_scope_released(")
        expect(log_helpers).to_contain("phase3:hir:file:released")
        expect(log_helpers).to_contain("scope_end=1")
        expect(log_helpers).to_contain("heap_live_bytes=")
        expect(log_helpers.contains("rt_process_rss_kib")).to_equal(false)
        expect(log_helpers.contains("rt_process_hwm_kib")).to_equal(false)

        val owner_start = lowering_types.index_of(
            "me promote_transient_compilation_roots() -> bool:")
        val owner_end = lowering_types.index_of(
            "me detach_transient_module_scratch():", owner_start)
        val owner = lowering_types.substring(owner_start, owner_end)
        for root in [
            "self.errors", "self.diagnostic_messages",
            "self.diagnostic_recovered", "self.lowered_traits",
            "self.reexport_root_surface_indices",
            "self.reexport_root_wanted", "self.reexport_root_found",
            "self.reexport_root_terminal_indices",
            "self.reexport_root_items"
        ]:
            expect(owner).to_contain("rt_transient_heap_promote(" + root + ")")
        expect(owner.contains("rt_transient_heap_promote(self)")).to_equal(false)

    it "promotes only new aggregate tails and rolls back every appended shell on failure":
        val lowering_helpers = file_read(LOWERING_HELPERS)
        val lowering = file_read(LOWERING)
        val assembly = file_read(MODULE_ASSEMBLY)
        val driver = file_read(HIR_LOWERING)
        val reset_start = lowering_helpers.index_of("fn bootstrap_hir_modules_reset()")
        val add_start = lowering_helpers.index_of("fn bootstrap_hir_modules_add(")
        val clear_start = lowering_helpers.index_of(
            "fn bootstrap_hir_modules_clear_pending_append()")
        val commit_start = lowering_helpers.index_of(
            "pub fn bootstrap_hir_modules_commit_pending_tail()")
        val bootstrap_start = lowering_helpers.index_of(
            "fn bootstrap_hir_modules_promote_transient_roots() -> bool:")
        val rollback_start = lowering_helpers.index_of(
            "fn bootstrap_hir_modules_rollback_pending_tail()")
        val bootstrap_end = lowering_helpers.index_of(
            "fn bootstrap_hir_entry_index()", bootstrap_start)
        val bootstrap = lowering_helpers.substring(
            bootstrap_start, bootstrap_end)
        val reset_body = lowering_helpers.substring(reset_start, add_start)
        val add_body = lowering_helpers.substring(add_start, rollback_start)
        val rollback = lowering_helpers.substring(rollback_start, bootstrap_start)
        val mutable_helpers = lowering_helpers.substring(reset_start, bootstrap_end)

        # Transaction metadata is process-lifetime storage. Scalar module vars
        # and whole-slot rebinds are forbidden because staged cross-module
        # reads can otherwise observe stale register-backed values after the
        # transient HIR scope is reclaimed.
        for metadata in [
            "entry_index", "pending_names_len", "pending_symbols_len",
            "pending_functions_len", "pending_constants_len",
            "pending_enums_len", "pending_structs_len",
            "pending_classes_len", "pending_previous_entry_index"
        ]:
            val scalar = "_bootstrap_hir_" + metadata
            val slot = scalar + "_slot"
            expect(lowering_helpers).to_contain(
                "var " + slot + ": [i64] = [-1]")
            expect(lowering_helpers.contains(
                "var " + scalar + ": i64")).to_equal(false)
            expect(mutable_helpers.contains(slot + " =")).to_equal(false)
            expect(reset_body).to_contain(slot + "[0] = -1")

        val baseline_at = add_body.index_of(
            "_bootstrap_hir_pending_names_len_slot[0] = module_index")
        val first_append_at = add_body.index_of(
            "_bootstrap_hir_module_names = _bootstrap_hir_module_names.push(name)")
        expect(baseline_at).to_be_greater_than(0)
        expect(first_append_at).to_be_greater_than(baseline_at)
        for root in ["symbols", "functions", "constants", "enums", "structs", "classes"]:
            val captured_at = add_body.index_of(
                "_bootstrap_hir_pending_" + root + "_len_slot[0] = " +
                "_bootstrap_hir_module_" + root + ".len()")
            expect(captured_at).to_be_greater_than(baseline_at)
            expect(first_append_at).to_be_greater_than(captured_at)
        expect(add_body).to_contain(
            "_bootstrap_hir_pending_previous_entry_index_slot[0] = " +
            "_bootstrap_hir_entry_index_slot[0]")
        expect(add_body).to_contain(
            "_bootstrap_hir_entry_index_slot[0] = module_index")
        expect(add_body).to_contain(
            "# `name` is a scalar reference to the pre-scope ParserModule.name string.")
        for root in ["names", "symbols", "functions", "constants", "enums", "structs", "classes"]:
            expect(rollback).to_contain(
                "while _bootstrap_hir_module_" + root +
                ".len() > _bootstrap_hir_pending_" + root + "_len_slot[0]:")
            expect(rollback).to_contain(
                "_bootstrap_hir_module_" + root + ".pop()")
        expect(rollback).to_contain(
            "_bootstrap_hir_entry_index_slot[0] = " +
            "_bootstrap_hir_pending_previous_entry_index_slot[0]")
        val clear_pending = lowering_helpers.substring(clear_start, rollback_start)
        val commit_pending = lowering_helpers.substring(commit_start, rollback_start)
        for metadata in [
            "names", "symbols", "functions", "constants",
            "enums", "structs", "classes"
        ]:
            expect(clear_pending).to_contain(
                "_bootstrap_hir_pending_" + metadata + "_len_slot[0] = -1")
        expect(clear_pending).to_contain(
            "_bootstrap_hir_pending_previous_entry_index_slot[0] = -1")
        expect(commit_pending).to_contain(
            "bootstrap_hir_modules_clear_pending_append()")
        expect(commit_pending.contains(".pop()")).to_equal(false)
        expect(commit_pending.contains("rt_transient_heap_promote(")).to_equal(false)
        expect(commit_pending.contains(
            "bootstrap_hir_modules_rollback_pending_tail()")).to_equal(false)

        expect(bootstrap).to_contain(
            "val expected_len = _bootstrap_hir_pending_names_len_slot[0] + 1")
        for parity in [
            "_bootstrap_hir_pending_symbols_len_slot[0] != _bootstrap_hir_pending_names_len_slot[0]",
            "_bootstrap_hir_pending_functions_len_slot[0] != _bootstrap_hir_pending_names_len_slot[0]",
            "_bootstrap_hir_pending_constants_len_slot[0] != _bootstrap_hir_pending_names_len_slot[0]",
            "_bootstrap_hir_pending_enums_len_slot[0] != _bootstrap_hir_pending_names_len_slot[0]",
            "_bootstrap_hir_pending_structs_len_slot[0] != _bootstrap_hir_pending_names_len_slot[0]",
            "_bootstrap_hir_pending_classes_len_slot[0] != _bootstrap_hir_pending_names_len_slot[0]",
            "names_len != expected_len", "symbols_len != expected_len",
            "functions_len != expected_len", "constants_len != expected_len",
            "enums_len != expected_len", "structs_len != expected_len",
            "classes_len != expected_len"
        ]:
            expect(bootstrap).to_contain(parity)
        var previous = bootstrap.index_of("names_len <= 0")
        expect(previous).to_be_greater_than(0)

        val last_at = bootstrap.index_of("val last = names_len - 1")
        expect(last_at).to_be_greater_than(previous)
        previous = last_at
        for root in [
            "_bootstrap_hir_module_symbols",
            "_bootstrap_hir_module_functions",
            "_bootstrap_hir_module_constants",
            "_bootstrap_hir_module_enums",
            "_bootstrap_hir_module_structs",
            "_bootstrap_hir_module_classes"
        ]:
            val tail_call = "rt_transient_heap_promote(" + root + "[last])"
            val tail_at = bootstrap.index_of(tail_call)
            expect(tail_at).to_be_greater_than(previous)
            val rollback_at = bootstrap.index_of(
                "bootstrap_hir_modules_rollback_pending_tail()", tail_at)
            expect(rollback_at).to_be_greater_than(tail_at)
            expect(bootstrap.contains(
                "rt_transient_heap_promote(" + root + ")")).to_equal(false)
            previous = tail_at
        expect(bootstrap.contains(
            "rt_transient_heap_promote(_bootstrap_hir_module_names")).to_equal(false)
        expect(bootstrap.contains(
            "bootstrap_hir_modules_clear_pending_append()")).to_equal(false)

        # The name shell is a scalar reference to the persistent SourceFile
        # path. It is never reconstructed inside the HIR transient scope.
        expect(driver).to_contain(
            "parse_full_frontend(source.content, source.path, source.module_name")
        expect(assembly).to_contain("name: path")
        expect(lowering).to_contain("val registry_module_name = module.name")
        expect(lowering).to_contain(
            "bootstrap_hir_modules_add(registry_module_name, is_entry")
        expect(lowering.contains(
            "val registry_module_name = if is_entry:")).to_equal(false)

        # The rollback owner crosses from HIR items into the driver. Both
        # fatal exits that can follow an append must detach the tail before
        # driver_end_transient_parse_scope reclaims its graph. The common path
        # deliberately calls the idempotent helper even when promotion already
        # performed its own local rollback.
        expect(driver).to_contain(
            "bootstrap_hir_modules_rollback_pending_tail,")
        expect(driver).to_contain(
            "bootstrap_hir_modules_commit_pending_tail,")
        val pause_start = driver.index_of(
            "if not rt_transient_array_scope_pause():")
        val lifecycle_start = driver.index_of(
            "var lifecycle_failure: DriverStage3HirFailure? = nil", pause_start)
        val pause_failure = driver.substring(pause_start, lifecycle_start)
        val pause_rollback = pause_failure.index_of(
            "bootstrap_hir_modules_rollback_pending_tail()")
        val pause_scope_end = pause_failure.index_of(
            "driver_end_transient_parse_scope()")
        expect(pause_rollback).to_be_greater_than(0)
        expect(pause_scope_end).to_be_greater_than(pause_rollback)

        val common_start = driver.index_of(
            "if val failure = lifecycle_failure:", lifecycle_start)
        val success_log_start = driver.index_of(
            "source.path, \"attempt-complete\"", common_start)
        val common_failure = driver.substring(common_start, success_log_start)
        val common_rollback = common_failure.index_of(
            "bootstrap_hir_modules_rollback_pending_tail()")
        val common_scope_end = common_failure.index_of(
            "driver_end_transient_parse_scope()")
        expect(common_rollback).to_be_greater_than(0)
        expect(common_scope_end).to_be_greater_than(common_rollback)

        # A successful tail promotion remains provisional while frontend
        # registry promotion runs. Thus frontend failure reaches the common
        # rollback with pending metadata still active.
        val bootstrap_promote = driver.index_of(
            "if not lifecycle_failure.? and not bootstrap_hir_modules_promote_transient_roots():",
            lifecycle_start)
        val frontend_promote = driver.index_of(
            "if not lifecycle_failure.? and not frontend_promote_compilation_registries():",
            bootstrap_promote)
        expect(bootstrap_promote).to_be_greater_than(lifecycle_start)
        expect(frontend_promote).to_be_greater_than(bootstrap_promote)
        expect(common_start).to_be_greater_than(frontend_promote)

        # Tail commit is the final owner transition: scope-end failure rolls
        # back first, and only successful scope end can clear pending slots.
        val failure_return = driver.index_of("return Err(failure)", common_start)
        val success_scope_start = driver.index_of(
            "if not driver_end_transient_parse_scope():", failure_return)
        val success_commit = driver.index_of(
            "bootstrap_hir_modules_commit_pending_tail()", success_scope_start)
        val success_log = driver.index_of(
            "source.path, \"attempt-complete\"", success_commit)
        val scope_failure = driver.substring(success_scope_start, success_commit)
        val end_failure_rollback = scope_failure.index_of(
            "bootstrap_hir_modules_rollback_pending_tail()")
        val fatal_scope_end = scope_failure.index_of(
            "DriverStage3HirFailure.FatalScopeEnd(")
        expect(failure_return).to_be_greater_than(common_start)
        expect(success_scope_start).to_be_greater_than(failure_return)
        expect(end_failure_rollback).to_be_greater_than(0)
        expect(fatal_scope_end).to_be_greater_than(end_failure_rollback)
        expect(success_commit).to_be_greater_than(success_scope_start)
        expect(success_log).to_be_greater_than(success_commit)

    it "prepares persistent frontend owners before both streaming phases":
        val assembly = file_read(MODULE_ASSEMBLY)
        val source_driver = file_read(SOURCE_PARSING)
        val hir_driver = file_read(HIR_LOWERING)
        val prep_start = assembly.index_of("pub fn frontend_prepare_transient_parse_scope")
        val prep_end = assembly.index_of("pub fn parse_and_build_module_scoped")
        val prep = assembly.substring(prep_start, prep_end)
        val pools = prep.index_of("reset_all_pools()")
        val parser = prep.index_of("parser_init_with_path(\"\", \"\")")
        val lexer = prep.index_of("lexer_release_parse_source_globals()")
        expect(prep_start).to_be_greater_than(0)
        expect(pools).to_be_greater_than(0)
        expect(parser).to_be_greater_than(pools)
        expect(lexer).to_be_greater_than(parser)

        val source_start = source_driver.index_of("me parse_all_streaming_surfaces_impl")
        val source_end = source_driver.index_of("me parse_all_impl")
        val source_body = source_driver.substring(source_start, source_end)
        val source_prep = source_body.index_of("frontend_prepare_transient_parse_scope()")
        val source_parse = source_body.index_of("parse_full_frontend(")
        expect(source_prep).to_be_greater_than(0)
        expect(source_parse).to_be_greater_than(source_prep)

        val hir_start = hir_driver.index_of("me lower_and_check_streaming_surfaces_impl")
        val hir_end = hir_driver.index_of("me lower_and_check_impl")
        val hir_body = hir_driver.substring(hir_start, hir_end)
        val hir_prep = hir_body.index_of("frontend_prepare_transient_parse_scope()")
        val hir_parse = hir_body.index_of("self.lower_streaming_surface_source(")
        expect(hir_prep).to_be_greater_than(0)
        expect(hir_parse).to_be_greater_than(hir_prep)

    it "clears parser roots after ending a transient scope":
        val driver = file_read(SOURCE_PARSING)
        val start = driver.index_of("fn driver_end_transient_parse_scope")
        val end = driver.index_of("impl CompilerDriver:")
        val body = driver.substring(start, end)
        val lexer_clear = body.last_index_of("lexer_release_parse_source_globals()")
        val ast_clear = body.last_index_of("ast_reset()")
        val scope_end = body.last_index_of("rt_transient_array_scope_end()")
        expect(ast_clear).to_be_greater_than(lexer_clear)
        expect(scope_end).to_be_greater_than(lexer_clear)
        expect(ast_clear).to_be_greater_than(scope_end)
