"""
# Canonical signature type parser parity

Exercises the exact compiled-check failure shapes plus adjacent valid and
invalid syntax. The authoritative Rust parser accepts `mut T`, `[]`, and
empty-array annotations; the pure-Simple flat parser must agree.
"""

use std.spec
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.core.parser.{parser_has_errors}

fn parses_without_errors(source: text, path: text) -> bool:
    val _module = parse_and_build_module(source, path)
    not parser_has_errors()

describe "canonical signature types":
    it "accepts exact exclusive capability and empty-array type forms":
        val source = "class EditorController:\n" +
            "    value: i64\n" +
            "fn ctrl_handle_key(ctrl: mut EditorController, items: []) -> []:\n" +
            "    items\n"
        expect(parses_without_errors(source, "testdata/type_signature_exact.spl")).to_equal(true)

    it "accepts adjacent nested exclusive and optional empty-array types":
        val source = "fn update(values: mut Dict<text, []>, fallback: []?) -> []?:\n" +
            "    fallback\n"
        expect(parses_without_errors(source, "testdata/type_signature_adjacent.spl")).to_equal(true)

    it "still rejects a missing type after the exclusive modifier":
        val source = "fn broken(value: mut) -> i64:\n" +
            "    0\n"
        expect(parses_without_errors(source, "testdata/type_signature_invalid.spl")).to_equal(false)
