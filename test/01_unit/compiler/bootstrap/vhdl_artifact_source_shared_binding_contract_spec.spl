# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "VHDL artifact source strict shared bindings":
    it "selects the stable source through a scalar index":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: selects the stable source through a scalar index")
        val source = file_read("src/compiler/80.driver/driver_vhdl_artifact_build.spl")

        expect(source).to_contain("var selected_index = -1")
        expect(source).to_contain("Some(sources[selected_index])")
        expect(source.contains("var selected: SourceFile? = nil")).to_equal(false)
