# Direct subsystem executables must fail closed on empty or failed runs.
# @cover src/compiler/10.frontend/core/test_verdict.spl
use std.spec.*
use compiler.frontend.core.test_verdict.{test_exit_code}

describe "Direct compiler subsystem test verdict":
    it "accepts a nonempty successful run":
        expect(test_exit_code(1, 0)).to_equal(0)
        expect(test_exit_code(103, 0)).to_equal(0)

    it "rejects zero executed checks":
        expect(test_exit_code(0, 0)).to_equal(1)

    it "rejects failure even after passing checks":
        expect(test_exit_code(102, 1)).to_equal(1)

    it "rejects a run with only failures":
        expect(test_exit_code(0, 1)).to_equal(1)

    it "rejects invalid negative counters":
        expect(test_exit_code(-1, 0)).to_equal(1)
        expect(test_exit_code(1, -1)).to_equal(1)
