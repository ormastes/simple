extern fn rt_file_read_text(path: text) -> text

use std.spec.{describe, it, expect}

describe "Stage 2 capability probe Stage4 guard":
    it "clears inherited Stage4 mode without changing the probe entry":
        val script = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val probe_pos: i64 = script.find("stage2_capability_ok=0")
        val selection_pos: i64 = script.find("# Decide which compiler to use for stage 4")
        val probe = script.substring(probe_pos, selection_pos)

        expect(probe_pos).to_be_greater_than(-1)
        expect(selection_pos).to_be_greater_than(probe_pos)
        expect(probe).to_contain("SIMPLE_BOOTSTRAP_STAGE4=0")
        expect(probe).to_contain("--entry test/04_smoke/windows_native_hello.spl")
        expect(probe.contains("--entry src/app/cli/main.spl")).to_equal(false)
        expect(probe).to_contain("Stage 4 remains bound to verified Stage 3")
        expect(probe.contains("using seed for stage 4")).to_equal(false)
