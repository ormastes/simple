use std.io.{file_read}
use std.spec.{describe, it, expect}

val TYPES_SOURCE = "src/compiler/10.frontend/core/types.spl"
val DRIVER_SOURCE = "src/compiler/80.driver/driver_source_pipeline_parsing.spl"
val ASSEMBLY_SOURCE = "src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl"

fn occurrences(haystack: text, needle: text) -> i64:
    if needle == "": return 0
    haystack.split(needle).len() - 1

fn function_body(source: text, start_marker: text, end_marker: text) -> text:
    val start = source.index_of(start_marker)
    val end = source.index_of(end_marker, start + start_marker.len())
    if start < 0 or end <= start: return ""
    source.substring(start, end)

describe "newunit flat-pool reset completeness":
    it "replaces every dumped newunit owner exactly once before the next parse":
        val source = file_read(TYPES_SOURCE)
        val reset = function_body(source, "fn reset_all_pools():", "export TYPE_VOID")
        val dump = function_body(source, "pub fn flat_type_pools_dump()", "pub fn flat_type_pools_restore")

        expect(occurrences(reset, "newunit_names = []")).to_equal(1)
        expect(occurrences(reset, "newunit_suffixes = []")).to_equal(1)
        expect(occurrences(reset, "newunit_underlying_type_tags = []")).to_equal(1)
        expect(occurrences(dump, "flat_pool_enc_text(newunit_names)")).to_equal(1)
        expect(occurrences(dump, "flat_pool_enc_text(newunit_suffixes)")).to_equal(1)
        expect(occurrences(dump, "flat_pool_enc_i64(newunit_underlying_type_tags)")).to_equal(1)

    it "uses whole-owner replacement rather than stale-backing clear":
        val source = file_read(TYPES_SOURCE)
        val reset = function_body(source, "fn reset_all_pools():", "export TYPE_VOID")
        expect(reset.contains("newunit_names.clear()")).to_equal(false)
        expect(reset.contains("newunit_suffixes.clear()")).to_equal(false)
        expect(reset.contains("newunit_underlying_type_tags.clear()")).to_equal(false)

    it "promotes before transient teardown and commits only after surface success":
        val driver = file_read(DRIVER_SOURCE)
        val add = function_body(
            driver,
            "me add_streaming_module_surface(",
            "me parse_all_streaming_surfaces_in_place_impl()")
        val promote = add.index_of("newunit_project_promote_current()")
        val end_scope = add.index_of("driver_end_transient_parse_scope()", promote)
        val surface_commit = add.index_of("builder_owner.add_surface(", end_scope)
        val project_commit = add.index_of("newunit_project_commit_current()", surface_commit)
        expect(promote).to_be_greater_than(0)
        expect(end_scope).to_be_greater_than(promote)
        expect(surface_commit).to_be_greater_than(end_scope)
        expect(project_commit).to_be_greater_than(surface_commit)

    it "resets project authority once at each compile route entry":
        val driver = file_read(DRIVER_SOURCE)
        val streaming = function_body(
            driver,
            "me parse_all_streaming_surfaces_in_place_impl()",
            "me parse_all_streaming_surfaces_impl()")
        val legacy = function_body(
            driver,
            "me parse_all_legacy_impl()",
            "fn parse_source(source:")
        expect(occurrences(streaming, "newunit_project_reset()")).to_equal(1)
        expect(occurrences(legacy, "newunit_project_reset()")).to_equal(1)

    it "centralizes legacy durable commit after the successful-file verdict":
        val driver = file_read(DRIVER_SOURCE)
        val legacy = function_body(
            driver,
            "me parse_all_legacy_impl()",
            "fn parse_source(source:")
        val entry_success = legacy.index_of(
            "if not newunit_project_commit_current():")
        val entry_store = legacy.index_of(
            "parsed_entry_modules = parsed_entry_modules.push(", entry_success)
        expect(entry_success).to_be_greater_than(0)
        expect(entry_store).to_be_greater_than(entry_success)
        # Entry-closure and plain loops each have one success boundary.
        expect(occurrences(legacy, "newunit_project_commit_current()")).to_equal(2)

        val assembly = file_read(ASSEMBLY_SOURCE)
        val scoped = function_body(
            assembly,
            "pub fn parse_and_build_module_scoped(",
            "fn parse_and_build_module(source:")
        expect(occurrences(scoped, "newunit_project_promote_current()")).to_equal(1)
        expect(occurrences(scoped, "newunit_project_commit_current()")).to_equal(0)
