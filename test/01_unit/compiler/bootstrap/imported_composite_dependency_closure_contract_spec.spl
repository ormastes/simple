# Retargeted 2026-11-12: the composite branch is now gated on the NAMEIDX
# position `if composite_position >= 0:` (4576fa62184) and the prebound probe
# goes through `import_binding_or_invalid`, which wraps
# `self.symbols.lookup_or_invalid(local_name)` (76c993305da). The branch is
# bounded by `val fields_started = hir_phase_profile_now()` because the first
# `for raw_field in composite.fields:` belongs to an earlier function.
"""Bootstrap contract for idempotent imported-composite dependency closure."""

use std.io_runtime.{read_file_text}

describe "imported composite dependency closure":
    it "does not return before walking fields when a symbol is prebound":
        val source = read_file_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl")
        val branch_start = source.find("if composite_position >= 0:")
        val field_walk = source.find("val fields_started = hir_phase_profile_now()")
        val branch = source.slice(branch_start, field_walk)
        expect(source).to_contain("self.symbols.lookup_or_invalid(local_name)")
        expect(branch).to_contain("self.import_binding_or_invalid(local_name)")
        expect(branch).to_contain("self.symbols.bind_qualified_type(imported_mod.module_name, imported_name, imported_type)")
        expect(branch.contains("else:\n                return")).to_equal(false)
