use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*

describe "Stage 4 bootstrap range visibility":
    it "lowers repeated range calls to HIR ranges without a prelude symbol":
        val source = "fn first() -> i64:\n" +
            "    for i in range(0, 2):\n" +
            "        print i\n" +
            "    0\n" +
            "fn second() -> i64:\n" +
            "    for j in range(1, 3):\n" +
            "        print j\n" +
            "    0\n"
        val parsed = parse_full_frontend(source, "range_bootstrap.spl", "range_bootstrap", Logger(level: 0))
        var lowering = HirLowering.with_filename("range_bootstrap.spl")
        val hir = lowering.lower_module(parsed)

        expect(lowering.errors.len()).to_equal(0)
        expect(hir.functions.len()).to_equal(2)

        var range_count = 0
        for function in hir.functions.values():
            for stmt in function.body.stmts:
                match stmt.kind:
                    case HirStmtKind.For(_, iter, _, _):
                        match iter.kind:
                            case HirExprKind.Range(_, _, false, nil): range_count = range_count + 1
                            case _: ()
                    case _: ()
        expect(range_count).to_equal(2)
