# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

use std.spec.step

use std.spec

use compiler.driver.driver_source_loading.{driver_spec_prelude_source}

describe "implicit SSpec prelude for an in-process spec run":
    it "appends a std.spec glob without moving any line":
        step("appends a std.spec glob without moving any line")
        val src = "use std.io_runtime.{file_read}\n\ndescribe \"x\":\n    it \"y\":\n        expect(1).to_equal(1)\n"
        val out = driver_spec_prelude_source(src)
        expect(out).to_equal(src + "use std.spec.*\n")

    it "treats std.spec.step alone as not importing the spec module":
        step("treats std.spec.step alone as not importing the spec module")
        expect(driver_spec_prelude_source("use std.spec.step\n")).to_equal("use std.spec.step\nuse std.spec.*\n")

    it "leaves a spec that already imports std.spec unchanged":
        step("leaves a spec that already imports std.spec unchanged")
        val src = "use std.spec.step\nuse std.spec\n"
        expect(driver_spec_prelude_source(src)).to_equal(src)

    it "rewrites the nonexistent std.test DSL import in place":
        step("rewrites the nonexistent std.test DSL import in place")
        expect(driver_spec_prelude_source("use std.test.{describe, it, expect}\n")).to_equal("use std.spec.{describe, it, expect}\n")
        expect(driver_spec_prelude_source("use std.test.*\n")).to_equal("use std.spec.*\n")
