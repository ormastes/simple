"""Bootstrap contract for scalar-indexed callable surface payloads."""

use std.nogc_sync_mut.io.file_ops.{rt_file_read_text}

describe "module surface callable projection":
    it "constructs aligned callable names and payloads":
        val types = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/module_surface_types.spl") ?? ""
        val declarations = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/module_surface_declarations.spl") ?? ""
        expect(types).to_contain("callable_values: [ModuleSurfaceCallable]")
        expect(declarations).to_contain("callable_names = callable_names.push(name)")
        expect(declarations).to_contain("callable_values = callable_values.push(callable)")

    it "does not recover imported callable payloads through Dict indexing":
        val registration = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl") ?? ""
        expect(registration).to_contain("imported_mod.callable_values[callable_index]")
        expect(registration.contains("imported_mod.callables[imported_name]")).to_equal(false)
