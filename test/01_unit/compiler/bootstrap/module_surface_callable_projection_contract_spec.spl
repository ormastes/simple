# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""Bootstrap contract for module-surface callable and type projection."""
use std.spec.step

use std.nogc_sync_mut.io.file_ops.{rt_file_read_text}

describe "module surface callable projection":
    it "does not consume an undeclared scalar signature projection":
        val callable_types = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl") ?? ""
        val lowering = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""
        expect(callable_types.contains("surface.signature_names")).to_equal(false)
        expect(lowering.contains("module_surface_signature_index")).to_equal(false)

    it "discovers declaration kinds through frozen scalar names":
        # @req REQ-SSPEC-UNIT
        step("discovers declaration kinds through frozen scalar names")
        # 88146e0e7e5 (NAMEIDX) indexes every kind's frozen name array once per
        # surface; 6cc204c1325 (BOOT-20) answers lookups from a scalar hash
        # chain instead of the Dict. No retained payload dictionary is opened.
        val registration = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl") ?? ""
        expect(registration).to_contain("self.index_surface_names(surface_key + \" C \", imported_mod.composite_names)")
        expect(registration).to_contain("self.index_surface_names(surface_key + \" E \", imported_mod.enum_names)")
        expect(registration).to_contain("self.index_surface_names(surface_key + \" T \", imported_mod.trait_names)")
        expect(registration).to_contain("self.index_surface_names(surface_key + \" A \", imported_mod.type_alias_names)")
        expect(registration).to_contain("self.index_surface_names(surface_key + \" F \", imported_mod.callable_names)")
        expect(registration).to_contain("self.index_surface_names(surface_key + \" K \", imported_mod.constant_names)")
        expect(registration).to_contain("val enum_position = self.surface_name_position(surface_key, \"E\", imported_name)")
        expect(registration).to_contain("val constant_position = self.surface_name_position(surface_key, \"K\", imported_name)")
        expect(registration).to_contain("imported_mod.callable_values[callable_position]")
        val position_start = registration.index_of("fn surface_name_position(", 0)
        val position_end = registration.index_of("\n    me ", position_start)
        expect(position_start).to_be_greater_than(0)
        expect(position_end).to_be_greater_than(position_start)
        val position_fn = registration.substring(position_start, position_end)
        expect(position_fn).to_contain("val slot = self.name_index_lookup(key)")
        expect(position_fn.contains("self.name_index_positions[")).to_be(false)
        for kind in ["enums", "traits", "type_aliases", "constants", "composites", "callables"]:
            expect(registration.contains("imported_mod." + kind + "[")).to_be(false)

    it "uses scalar qualified symbol indexes for staged lookup":
        # 5c38b388a53 (QTYPEIDX) replaced the O(bindings) parallel-array scan
        # with an injective "module#member" -> raw i64 id index.
        val symbols = rt_file_read_text("src/compiler/20.hir/hir_types.spl") ?? ""
        expect(symbols).to_contain("qualified_functions: Dict<text, i64>")
        expect(symbols).to_contain("qualified_types: Dict<text, i64>")
        expect(symbols).to_contain("fn qualified_symbol_key(module_name: text, member_name: text) -> text:")
        val function_lookup = symbols.substring(
            symbols.index_of("fn lookup_qualified_function_raw", 0),
            symbols.index_of("me bind_qualified_type", 0))
        expect(function_lookup).to_contain("val key = qualified_symbol_key(module_name, member_name)")
        expect(function_lookup).to_contain("if self.qualified_functions.contains_key(key):\n            return self.qualified_functions[key]\n        -1")
        expect(function_lookup.contains("while ")).to_be(false)
        expect(function_lookup.contains("for ")).to_be(false)
        expect(function_lookup.contains("module_name +")).to_be(false)

    it "projects imported aggregate types through staged-safe branch assignment":
        # @req REQ-SSPEC-UNIT
        step("projects imported aggregate types through staged-safe branch assignment")
        # 66ccf79f57f staged the projected-type routes; the generic
        # imported_surface_type array branch is not covered (see the retired
        # todo for that site).
        val lowering = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl") ?? ""
        val projected_start = lowering.index_of("me imported_surface_type_projected(", 0)
        val projected_end = lowering.index_of("me declared_imported_surface_callable_type(", projected_start)
        val named_start = lowering.index_of("me imported_surface_projected_name_type(", 0)
        val named_end = lowering.index_of("me infer_simple_type_name_ast(", named_start)
        expect(projected_start).to_be_greater_than(0)
        expect(projected_end).to_be_greater_than(projected_start)
        expect(named_start).to_be_greater_than(0)
        expect(named_end).to_be_greater_than(named_start)
        val projected = lowering.substring(projected_start, projected_end)
        val named = lowering.substring(named_start, named_end)
        expect(projected).to_contain(
            "var element: HirType = HirType(kind: HirTypeKind.Error, span: type_.span)")
        expect(projected).to_contain("element = HirType(")
        expect(projected.contains("val element = if ")).to_be(false)
        expect(named).to_contain(
            "var element: HirType = HirType(kind: HirTypeKind.Error, span: span)")
        expect(named).to_contain("element = HirType(")
        expect(named).to_contain("var projected: HirType = element")
        expect(named.contains("val element = if ")).to_be(false)

    it "binds daemon closure primitives from their canonical owner":
        # @req REQ-SSPEC-UNIT
        step("binds daemon closure primitives from their canonical owner")
        # The daemon SDK lives under src/lib; src/std/ was never a tracked tree.
        val protocol = rt_file_read_text(
            "src/lib/nogc_sync_mut/daemon_sdk/protocol.spl") ?? ""
        expect(protocol).to_contain(
            "use std.nogc_sync_mut.io_runtime.\{dir_list}")
        expect(protocol).to_contain(
            "use std.nogc_sync_mut.io_runtime.\{time_now_unix_micros}")
