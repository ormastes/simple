# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""Rust and pure-Simple parsers accept the same multiline source shapes."""

use std.spec.step

use std.spec
use std.spec.step
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.core.parser.{parser_has_errors}


fn multiline_shape_parses(source: text, name: text) -> bool:
    val _module = parse_and_build_module(source, "testdata/{name}.spl")
    not parser_has_errors()

describe "bootstrap multiline parser parity":
    # @manual scenario evidence
    it "accepts a nested continuation that rejoins its outer chain":
        # @req REQ-SSPEC-UNIT
        step("accepts a nested continuation that rejoins its outer chain")
        val source = "fn g(x: text) -> text:\n    x\n" +
            "fn f(a: text, b: text) -> bool:\n" +
            "    a == b and\n" +
            "        a ==\n" +
            "            g(b) and\n" +
            "        a ==\n" +
            "            g(b)\n"
        expect(multiline_shape_parses(source, "rejoined_continuation")).to_equal(true)

    it "accepts consecutive trailing assignment continuations":
        # @req REQ-SSPEC-UNIT
        step("accepts consecutive trailing assignment continuations")
        val source = "struct C:\n    a: text\n    b: text\n" +
            "fn f(c: C, v: text):\n" +
            "    c.a =\n        v\n" +
            "    c.b =\n        v\n"
        expect(multiline_shape_parses(source, "trailing_assignments")).to_equal(true)

    it "accepts a return type after a trailing arrow":
        # @req REQ-SSPEC-UNIT
        step("accepts a return type after a trailing arrow")
        val source = "fn f(\n" +
            "        a: text,\n" +
            "        b: text) ->\n" +
            "        Result<text, text>:\n" +
            "    Ok(a)\n"
        expect(multiline_shape_parses(source, "trailing_return_arrow")).to_equal(true)

    it "accepts inline if assignment statements":
        # @req REQ-SSPEC-UNIT
        step("accepts inline if assignment statements")
        val source = "fn f(d: {text: bool}, k: text):\n" +
            "    if k == \"t\": d[k] = true\n" +
            "    else: d[k] = false\n"
        expect(multiline_shape_parses(source, "inline_if_assignment")).to_equal(true)

    it "accepts an if expression with a multiline condition":
        # @req REQ-SSPEC-UNIT
        step("accepts an if expression with a multiline condition")
        val source = "fn f(a: text, b: text) -> text:\n" +
            "    val r = if a == \"x\" and\n" +
            "            b == \"y\":\n" +
            "        a\n" +
            "    else:\n" +
            "        b\n" +
            "    r\n"
        expect(multiline_shape_parses(source, "multiline_if_expression")).to_equal(true)

    it "keeps a var local after a continued inline guard in an impl method":
        val source = "struct VerificationGate:\n" +
            "    flags: [bool]\n" +
            "impl VerificationGate:\n" +
            "    fn closure_ready() -> bool:\n" +
            "        if self.flags.is_empty() or\n" +
            "                self.flags[0] == false: return false\n" +
            "        var flag_index = 0\n" +
            "        while flag_index < self.flags.len():\n" +
            "            flag_index = flag_index + 1\n" +
            "        true\n"
        expect(multiline_shape_parses(source, "continued_inline_impl_guard_then_var")).to_equal(true)

    it "keeps a val local after an adjacent continued inline guard":
        val source = "fn adjacent_guard(a: bool, b: bool) -> i64:\n" +
            "    if a and\n" +
            "            b: return 1\n" +
            "    val fallback = 2\n" +
            "    fallback\n"
        expect(multiline_shape_parses(source, "continued_inline_guard_then_val")).to_equal(true)
