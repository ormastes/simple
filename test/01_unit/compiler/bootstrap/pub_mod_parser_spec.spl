use std.spec.{describe, it, expect}
use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}

describe "bootstrap public module parser":
    it "accepts public module declarations":
        parser_set_had_error(false)
        parse_module("pub mod child\nmod internal\n", "pub_mod_parser_spec.spl")

        expect(parser_has_errors()).to_equal(false)
