use std.spec.{describe, it, expect}
use compiler.core.parser.{parse_module, parser_has_errors}

describe "module declaration annotation continuation":
    it "accepts a continued array annotation and preserves the following declaration":
        parse_module("var adapters:\n    [i64] = []\nvar generation: u64 = 0u64\n",
            "continued_var_array.spl")
        expect(parser_has_errors()).to_equal(false)

    it "accepts a continued optional annotation":
        parse_module("var context:\n    i64? = nil\nfn read() -> i64:\n    1\n",
            "continued_var_optional.spl")
        expect(parser_has_errors()).to_equal(false)

    it "accepts immutable and lazy binding annotations consistently":
        parse_module("val answer:\n    i64 = 42\nlazy val cached:\n    i64 = 43\n",
            "continued_values.spl")
        expect(parser_has_errors()).to_equal(false)

    it "rejects a missing type on the continuation line":
        parse_module("var invalid:\n    = 1\n", "continued_missing_type.spl")
        expect(parser_has_errors()).to_equal(true)

    it "rejects an unindented annotation continuation":
        parse_module("var invalid:\ni64 = 1\n", "continued_missing_indent.spl")
        expect(parser_has_errors()).to_equal(true)
