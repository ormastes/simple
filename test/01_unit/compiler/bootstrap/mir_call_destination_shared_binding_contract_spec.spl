# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "MIR call destination strict shared bindings":
    it "builds direct and indirect optional destinations as values":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: builds direct and indirect optional destinations as values")
        val source = file_read("src/compiler/50.mir/mir_data.spl")
        val immutable_dest = "val dest: LocalId? = if return_type.kind != MirTypeKind.Unit: self.new_temp(return_type) else: nil"

        expect(source.count(immutable_dest)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(source.contains("var dest: LocalId? = nil")).to_equal(false)
