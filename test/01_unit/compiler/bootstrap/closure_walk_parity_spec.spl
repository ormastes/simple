"""The CLI coordinator closure walk and the driver worker closure walk must
compile the same module set.

They used to resolve imports with different resolvers: the coordinator
(`_native_build_entry_closure`) with a dotted-segment root probe, the worker
(driver_source_pipeline_loading) with the source-root resolver plus a checkout
fallback, de-duplicated by import SPELLING. Each fixture shape below is one
observed divergence: bare `use types` binding a numbered `30.types` instead of
the importer's sibling, `common.string_builder` binding src/app instead of
src/lib, `compiler.mir_opt.X` binding a src/lib stub, a bare `export X from mod`
binding src/os/mod.spl, and one spelling shared by two importers whose siblings
differ. Both walks now call driver_resolve_closure_import_v1.
"""
use std.spec.*
use app.io.env_ops.{env_set}
use app.io.file_ops.{path_absolute}
use app.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{dir_create_all, file_write, env_get_nullable, env_remove_process}
use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use compiler.driver.driver_source_loading.{
    driver_resolve_closure_import_v1, driver_closure_native_owner_v1,
    driver_closure_import_specs_v1, driver_closure_importer_module_v1,
    driver_closure_set_digest_v1, _driver_entry_import_dirname,
    _driver_physical_source_key}
use app.io._CliCompile.native_build_closure.{_native_build_entry_closure}

fn _put(root: text, rel: text, content: text):
    val path = root + "/" + rel
    expect(dir_create_all(_driver_entry_import_dirname(path))).to_be(true)
    expect(file_write(path, content)).to_be(true)

fn parity_fixture() -> text:
    val root = path_absolute("build/native_probe/closure-walk-parity-" + time_now_unix_micros().to_string()).replace("\\", "/")
    _put(root, "src/app/probe/main.spl",
        "use compiler.tools.leak.main.\{leak_entry}\n" +
        "use common.text_adv.\{adv}\n" +
        "use compiler.mir_opt.foo.\{foo}\n" +
        "use compiler.borrow.borrow_check.\{BorrowChecker}\n" +
        "use plugins.reg.full.\{full}\n" +
        "use lib.alpha.m.\{a}\n" +
        "use lib.beta.m.\{b}\n" +
        "fn main(): 0\n")
    # bare `use types`: sibling beats the numbered compiler package
    _put(root, "src/compiler/30.types/__init__.spl", "pub fn numbered_types() -> i64: 1\n")
    _put(root, "src/compiler/90.tools/leak/main.spl", "use types.\{Leak}\npub fn leak_entry() -> i64: 0\n")
    _put(root, "src/compiler/90.tools/leak/types.spl", "pub struct Leak:\n    n: i64\n")
    # common.string_builder: src/lib owns it, not src/app/common
    _put(root, "src/lib/common/text_adv.spl", "use common.string_builder.\{SB}\npub fn adv() -> i64: 0\n")
    _put(root, "src/lib/common/string_builder.spl", "pub struct SB:\n    n: i64\n")
    _put(root, "src/app/common/string_builder.spl", "pub struct SB:\n    n: i64\n")
    # compiler.mir_opt.X: the nested compiler owner, not a src/lib stub
    _put(root, "src/compiler/60.mir_opt/mir_opt/foo.spl", "pub fn foo() -> i64: 0\n")
    _put(root, "src/lib/compiler/mir_opt/foo.spl", "# stub facade\n")
    # bare export-from: the package sibling, never src/os/mod.spl
    _put(root, "src/compiler/55.borrow/borrow_check/__init__.spl", "export BorrowChecker from mod\n")
    _put(root, "src/compiler/55.borrow/borrow_check/mod.spl", "pub struct BorrowChecker:\n    n: i64\n")
    _put(root, "src/os/mod.spl", "use os.kernel.boot.\{boot}\n")
    _put(root, "src/os/kernel/boot.spl", "pub fn boot() -> i64: 0\n")
    # composition overlay stays authoritative
    _put(root, "src/plugins/reg/full.spl", "use plugins.reg.sel.\{sel}\npub fn full() -> i64: 0\n")
    _put(root, "src/plugins/reg/sel.spl", "pub fn sel() -> i64: 1\n")
    _put(root, "src/compositions/cuda_disabled/plugins/reg/sel.spl", "pub fn sel() -> i64: 2\n")
    # one spelling, two importers, two different siblings
    _put(root, "src/lib/alpha/m.spl", "use types.\{A}\npub fn a() -> i64: 0\n")
    _put(root, "src/lib/alpha/types.spl", "pub struct A:\n    n: i64\n")
    _put(root, "src/lib/beta/m.spl", "use types.\{B}\npub fn b() -> i64: 0\n")
    _put(root, "src/lib/beta/types.spl", "pub struct B:\n    n: i64\n")
    root

fn parity_roots(root: text) -> [text]:
    [root + "/src/compositions/cuda_disabled", root + "/src/compiler", root + "/src/app",
        root + "/src/lib", root + "/src/os", root + "/src/plugins"]

fn worker_walk(seeds: [text], roots: [text]) -> [text]:
    # The driver worker loop's traversal (driver_source_pipeline_loading.spl):
    # shared specs, shared resolver, native-owner preference, dedup by
    # (importer directory, spelling) and by physical file.
    var queue: [text] = []
    var queued: {text: bool} = {}
    for seed in seeds:
        val key = _driver_physical_source_key(seed)
        if not queued.has(key):
            queued[key] = true
            queue.push(seed)
    var seen: {text: bool} = {}
    var qi = 0
    while qi < queue.len():
        val file = queue[qi]
        qi = qi + 1
        val dir = _driver_entry_import_dirname(file)
        val module = driver_closure_importer_module_v1(file)
        for spec in driver_closure_import_specs_v1(file):
            val spelling = if spec.starts_with(".") and not spec.starts_with(".."): module + spec else: spec
            if seen.has(dir + "|" + spelling): continue
            seen[dir + "|" + spelling] = true
            match driver_resolve_closure_import_v1(spec, roots, dir):
                case SourceRootResolutionV1.Found(path):
                    val owner = driver_closure_native_owner_v1(path, spelling, dir)
                    val key = _driver_physical_source_key(owner)
                    if not queued.has(key):
                        queued[key] = true
                        queue.push(owner)
                case _: ()
    queue

fn keyset(paths: [text]) -> [text]:
    var keys: [text] = []
    for path in paths:
        keys.push(_driver_physical_source_key(path))
    keys.sort()

fn with_snapshot(root: text) -> text?:
    val previous = env_get_nullable("SIMPLE_SCV_SNAPSHOT_ROOT")
    expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", root)).to_be(true)
    expect(env_set("SIMPLE_SCV_FREEZE_FALLBACK", "1")).to_be(true)
    previous

fn restore_snapshot(previous: text?):
    if val saved = previous:
        expect(env_set("SIMPLE_SCV_SNAPSHOT_ROOT", saved)).to_be(true)
    else:
        expect(env_remove_process("SIMPLE_SCV_SNAPSHOT_ROOT")).to_be(true)

describe "closure walk parity":
    it "binds each divergent shape to the checkout owner":
        val root = parity_fixture()
        val previous = with_snapshot(root)
        val roots = parity_roots(root)
        val leak_dir = root + "/src/compiler/90.tools/leak"
        val types = driver_resolve_closure_import_v1("types", roots, leak_dir)
        val sb = driver_resolve_closure_import_v1("common.string_builder", roots, root + "/src/lib/common")
        val overlay = driver_resolve_closure_import_v1("plugins.reg.sel", roots, root + "/src/plugins/reg")
        val mod_sibling = driver_resolve_closure_import_v1(".mod", roots, root + "/src/compiler/55.borrow/borrow_check")
        restore_snapshot(previous)
        expect(types).to_equal(SourceRootResolutionV1.Found(leak_dir + "/types.spl"))
        expect(sb).to_equal(SourceRootResolutionV1.Found(root + "/src/lib/common/string_builder.spl"))
        expect(overlay).to_equal(SourceRootResolutionV1.Found(root + "/src/compositions/cuda_disabled/plugins/reg/sel.spl"))
        expect(mod_sibling).to_equal(SourceRootResolutionV1.Found(root + "/src/compiler/55.borrow/borrow_check/mod.spl"))

    it "computes identical module sets in the coordinator and worker walks":
        val root = parity_fixture()
        val previous = with_snapshot(root)
        val roots = parity_roots(root)
        val coordinator = _native_build_entry_closure(root + "/src/app/probe/main.spl", roots)
        val worker = worker_walk(coordinator, roots)
        val worker_from_entry = worker_walk([root + "/src/app/probe/main.spl"], roots)
        restore_snapshot(previous)
        expect(keyset(worker)).to_equal(keyset(coordinator))
        expect(keyset(worker_from_entry)).to_equal(keyset(coordinator))
        expect(driver_closure_set_digest_v1(worker)).to_equal(driver_closure_set_digest_v1(coordinator))
        val keys = keyset(coordinator)
        val canon = _driver_physical_source_key(root)
        expect(keys).to_contain(canon + "/src/compiler/90.tools/leak/types.spl")
        # The fixture lies outside the checkout's src/, so its lib file is not a
        # native `common.*` owner and both walks prefer the checkout's own;
        # either way src/app/common never owns the spelling.
        var lib_builder = false
        for key in keys:
            if key.ends_with("/src/lib/common/string_builder.spl"): lib_builder = true
        expect(lib_builder).to_be(true)
        expect(keys).to_contain(canon + "/src/compiler/60.mir_opt/mir_opt/foo.spl")
        expect(keys).to_contain(canon + "/src/compiler/55.borrow/borrow_check/mod.spl")
        expect(keys).to_contain(canon + "/src/compositions/cuda_disabled/plugins/reg/sel.spl")
        expect(keys).to_contain(canon + "/src/lib/alpha/types.spl")
        expect(keys).to_contain(canon + "/src/lib/beta/types.spl")
        expect(keys.contains(canon + "/src/compiler/30.types/__init__.spl")).to_be(false)
        expect(keys.contains(canon + "/src/app/common/string_builder.spl")).to_be(false)
        expect(keys.contains(canon + "/src/lib/compiler/mir_opt/foo.spl")).to_be(false)
        expect(keys.contains(canon + "/src/os/mod.spl")).to_be(false)
        expect(keys.contains(canon + "/src/plugins/reg/sel.spl")).to_be(false)

    it "digests a closure independent of order and spelling":
        val a = driver_closure_set_digest_v1(["src/app/cli/main.spl", "src/app/cli/../cli/bootstrap_main.spl"])
        val b = driver_closure_set_digest_v1(["src/app/cli/bootstrap_main.spl", "src/app/cli/main.spl", "src/app/cli/main.spl"])
        expect(a).to_equal(b)
