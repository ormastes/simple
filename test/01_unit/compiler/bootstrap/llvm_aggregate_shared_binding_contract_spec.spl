# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec
use std.io_runtime.{file_read}

describe "LLVM aggregate strict shared bindings":
    # @manual scenario evidence
    it "derives indirect-call destination and return type without reassignment":
        # @req REQ-SSPEC-COMPILER
        step("derives indirect-call destination and return type without reassignment")
        val source = file_read("src/compiler/70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl")

        expect(source).to_contain("val dest_name: text? = if dest != nil:")
        expect(source).to_contain("val ret_ty: text = if dest != nil:")
        expect(source.contains("var dest_name: text? = nil")).to_equal(false)
        expect(source.contains("var ret_ty: text = if sig.return_type")).to_equal(false)
