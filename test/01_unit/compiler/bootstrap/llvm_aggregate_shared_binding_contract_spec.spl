use std.spec
use std.io_runtime.{file_read}

describe "LLVM aggregate strict shared bindings":
    it "derives indirect-call destination and return type without reassignment":
        val source = file_read("src/compiler/70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl")

        expect(source).to_contain("val dest_name: text? = if dest != nil:")
        expect(source).to_contain("val ret_ty: text = if dest != nil:")
        expect(source.contains("var dest_name: text? = nil")).to_equal(false)
        expect(source.contains("var ret_ty: text = if sig.return_type")).to_equal(false)
