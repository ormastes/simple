"""
# Stage 4 Manual Stage 3 Admission Contract

Locks the operational checks that prevent a stub-bearing full CLI from being
mistaken for the bootstrap compiler used to produce Stage 4.
"""

extern fn rt_file_read_text(path: text) -> text?

describe "Stage 4 manual Stage 3 admission":
    it "requires the canonical bootstrap entry and strict stub mode":
        val plan = rt_file_read_text("doc/03_plan/infra/agent_sessions/stage4_spdev.md") ?? ""
        expect(plan).to_contain("src/app/cli/bootstrap_main.spl")
        expect(plan).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(plan).to_contain("Generating [1-9][0-9]* stub functions")

    it "requires identity, unsupported-command, and frontend admission":
        val plan = rt_file_read_text("doc/03_plan/infra/agent_sessions/stage4_spdev.md") ?? ""
        expect(plan).to_contain("simple-bootstrap 1.0.0-RC")
        expect(plan).to_contain("unknown command 'run'")
        expect(plan).to_contain("canonical candidate frontend admission passes")
        expect(plan).to_contain("candidate hash")
