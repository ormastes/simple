use std.spec
use std.io_runtime.{file_read}

describe "HIR statement strict shared bindings":
    it "builds tuple and return values without shared binding reassignment":
        val source = file_read("src/compiler/20.hir/hir_lowering/statements.spl")

        expect(source).to_contain("val td_base_sym: SymbolId? = match hir_init.kind:")
        expect(source).to_contain("val td_idx_type: HirType? = if i < td_elem_types.len(): td_elem_types[i] else: nil")
        expect(source).to_contain("val rt_hir: HirExpr? = match rt_val:")
        expect(source).to_contain("val return_value: HirExpr? = self.lower_hir_expr(value)")
        expect(source.contains("var td_base_sym: SymbolId? = nil")).to_equal(false)
        expect(source.contains("var td_idx_type: HirType? = nil")).to_equal(false)
        expect(source.contains("var rt_hir: HirExpr? = nil")).to_equal(false)
        expect(source.contains("var return_value: HirExpr? = nil")).to_equal(false)
