# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "driver phase-entry strict shared bindings":
    it "derives the final entry HIR from a scalar source index":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: derives the final entry HIR from a scalar source index")
        val source = file_read("src/compiler/80.driver/driver.spl")

        expect(source).to_contain("var phase_entry_source_index = -1")
        expect(source).to_contain("phase_entry_source_index = source_idx")
        expect(source).to_contain("val phase_entry_hir: HirModule? = if phase_entry_source_index >= 0:")
        expect(source).to_contain("self.ctx.bootstrap_entry_hir")
        expect(source.contains("var phase_entry_hir: HirModule? = self.ctx.bootstrap_entry_hir")).to_equal(false)
