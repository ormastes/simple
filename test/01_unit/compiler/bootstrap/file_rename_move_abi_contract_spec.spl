extern fn rt_file_read_text(path: text) -> text

use std.spec.{describe, it, expect}

describe "file rename and move runtime ABI":
    it "keeps both LLVM lanes on the four-word text ABI":
        val backend = rt_file_read_text("src/compiler/70.backend/backend/llvm_backend.spl") ?? ""
        val library = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_translate.spl") ?? ""

        expect(backend).to_contain("declare i1 @rt_file_rename(ptr, i64, ptr, i64)")
        expect(backend).to_contain("declare i1 @rt_file_move(ptr, i64, ptr, i64)")
        expect(backend.contains("declare i1 @rt_file_move(ptr, ptr)")).to_equal(false)
        expect(library).to_contain("declare_fn(mod_, \"rt_file_rename\", llvm_function_type(i1_ty, [ptr_ty, i64_ty, ptr_ty, i64_ty], false))")
        expect(library).to_contain("declare_fn(mod_, \"rt_file_move\", llvm_function_type(i1_ty, [ptr_ty, i64_ty, ptr_ty, i64_ty], false))")

    it "keeps generated bindings and native fallback honest":
        val compiler_spec = rt_file_read_text("src/compiler/90.tools/sffi_gen/specs/file_io.spl") ?? ""
        val app_spec = rt_file_read_text("src/app/ffi_gen.specs/file_io.spl") ?? ""
        val stubs = rt_file_read_text("src/compiler_rust/compiler/src/linker/native_binary/stubs.rs") ?? ""

        expect(compiler_spec).to_contain("return_type: \"bool\", runtime_fn: \"rt_file_rename\"")
        expect(app_spec).to_contain("return_type: \"bool\", runtime_fn: \"rt_file_rename\"")
        expect(stubs.contains("RT_KEEP!(rt_file_rename)")).to_equal(false)
        expect(stubs.contains("bool rt_file_rename(const char*")).to_equal(false)
