use std.spec
use std.io_runtime.{file_read}

describe "interpreter function lookup strict shared bindings":
    it "shares indexed and fallback name resolution without optional reassignment":
        val calls_source = file_read("src/compiler/70.backend/backend/interpreter_calls.spl")
        val interpreter_source = file_read("src/compiler/70.backend/backend/interpreter.spl")

        expect(calls_source).to_contain("fn resolve_function_by_name(name: text, ctx: EvalContext) -> HirFunction?:")
        expect(calls_source).to_contain("val cf_target_hit = self.resolve_function_by_name(f_t.name, ctx)")
        expect(interpreter_source).to_contain("val cf_named_hit = self.resolve_function_by_name(cname_t, ctx)")
        expect(calls_source.contains("var cf_target_hit: HirFunction? = nil")).to_equal(false)
        expect(interpreter_source.contains("var cf_named_hit: HirFunction? = nil")).to_equal(false)
