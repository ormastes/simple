# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec
use std.io_runtime.{file_read}

describe "MIR module lowering strict shared bindings":
    # @manual scenario evidence
    it "derives static initializers and call symbols without reassignment":
        # @req REQ-SSPEC-COMPILER
        step("derives static initializers and call symbols without reassignment")
        val source = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")

        expect(source).to_contain("val init_const: MirConstant? = match folded:")
        expect(source).to_contain("val callee_symbol: SymbolId? = match callee.kind:")
        expect(source.contains("var init_const: MirConstant? = nil")).to_equal(false)
        expect(source.contains("var callee_symbol: SymbolId? = nil")).to_equal(false)
