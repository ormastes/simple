# @tag:macos
# Bug stage3_macos_full_graph_hir_sigsegv_2026_09_21. Leading hypothesis: the
# admitted Stage2 was built by a seed lacking 2c89727c11c, whose LLVM backend
# copied a nil Optional<aggregate> into a non-nil all-zero aggregate on
# aarch64. Mac checker: build this spec NATIVELY with the stage2 under test on
# aarch64-apple-darwin; every example must report nil. It also passes on any
# correct host (interpreter / Windows), which is the platform-neutral contract.
use std.spec.{describe, it, expect}

struct SlotTy:
    name: text
    kind: i64

struct Holder:
    slot: SlotTy?

fn pass_through(s: SlotTy?) -> SlotTy?:
    s

fn is_nil(s: SlotTy?) -> bool:
    match s:
        case Some(_): false
        case nil: true

describe "nil Optional<aggregate> survives copies":
    it "keeps a nil local nil after a call round-trip":
        val s: SlotTy? = nil
        expect(is_nil(pass_through(s))).to_equal(true)

    it "keeps a nil struct field nil after copying the holder":
        val h = Holder(slot: nil)
        val h2 = h
        expect(is_nil(h2.slot)).to_equal(true)

    it "keeps nil array elements nil":
        var xs: [SlotTy?] = []
        xs.push(nil)
        xs.push(Some(SlotTy(name: "a", kind: 1)))
        expect(is_nil(xs[0])).to_equal(true)
        expect(is_nil(xs[1])).to_equal(false)
