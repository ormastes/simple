use std.spec
use std.io_runtime.{file_read}

describe "MIR and VHDL owner import contracts":
    it "keeps each strict-stage owner named at its declaring module":
        val function_lowering = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        val module_lowering = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        val method_calls = file_read("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
        val optimizer = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val process_codegen = file_read("src/compiler/70.backend/backend/_VhdlProcess/process_codegen.spl")

        expect(function_lowering).to_contain("use compiler.mir.mir_types.{MirConstant}")
        expect(module_lowering).to_contain("use compiler.common._Attributes.decl_attrs.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}")
        expect(module_lowering).to_contain("use compiler.common.dependency.visibility.{Visibility}")
        expect(module_lowering).to_contain("use compiler.mir.mir_types.{MirConstant, MirFieldDef, MirStatic, MirTypeDefKind}")
        expect(method_calls).to_contain("use compiler.mir.mir_instruction_support.{GpuMemoryScope, GpuBarrierScope}")
        expect(optimizer).to_contain("use compiler.mir.mir_instruction_graph.{mir_fold_binop}")
        expect(process_codegen).to_contain("use compiler.mir.mir_instruction_support.{vhdl_clock_domain_from_metadata}")

        expect(function_lowering).to_contain("MirConstant(")
        expect(module_lowering).to_contain("DriverManifestAttr(")
        expect(module_lowering).to_contain("MirFieldDef(")
        expect(method_calls).to_contain("GpuMemoryScope.")
        expect(optimizer).to_contain("mir_fold_binop(")
        expect(optimizer).to_contain("case Add: result = l + r")
        expect(optimizer).to_contain("case Div:")
        expect(optimizer).to_contain("if r != 0:")
        expect(process_codegen).to_contain("vhdl_clock_domain_from_metadata(")
