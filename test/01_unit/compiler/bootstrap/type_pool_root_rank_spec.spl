# @req REQ-SSPEC-COMPILER
use std.spec
use compiler.core.types.{reset_all_pools, type_pools_promote_hir_owners,
    custom_primitive_register, custom_primitive_underlying_type_tag_by_name,
    dict_type_register, dict_type_get_key, dict_type_get_value, TYPE_DICT_BASE,
    union_type_register, union_type_get_members, TYPE_UNION_BASE,
    named_generic_instance_register, named_generic_instance_index,
    named_generic_instance_base, named_generic_instance_arg_tags, TYPE_I64, TYPE_TEXT}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

describe "type pool singleton promotion roots":
    it "retains text, scalar and nested pool owners after releasing only wrappers":
        reset_all_pools()
        expect(rt_transient_array_scope_begin()).to_equal(true)
        val primitive = custom_primitive_register("RootRankWord", TYPE_I64)
        val dictionary = dict_type_register(TYPE_TEXT, TYPE_I64)
        val union = union_type_register([TYPE_I64, TYPE_TEXT])
        val generic = named_generic_instance_register("RootRankBox", [TYPE_I64])
        expect(primitive >= 0).to_equal(true)
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(type_pools_promote_hir_owners()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)

        expect(custom_primitive_underlying_type_tag_by_name("RootRankWord")).to_equal(TYPE_I64)
        expect(dict_type_get_key(dictionary - TYPE_DICT_BASE)).to_equal(TYPE_TEXT)
        expect(dict_type_get_value(dictionary - TYPE_DICT_BASE)).to_equal(TYPE_I64)
        expect(union_type_get_members(union - TYPE_UNION_BASE)).to_equal([TYPE_I64, TYPE_TEXT])
        val index = named_generic_instance_index(generic)
        expect(named_generic_instance_base(index)).to_equal("RootRankBox")
        expect(named_generic_instance_arg_tags(index)).to_equal([TYPE_I64])

        # Reusing the pools after wrapper disposal must not free their actual
        # global containers, and a second scope must retain prior entries.
        expect(rt_transient_array_scope_begin()).to_equal(true)
        custom_primitive_register("RootRankOther", TYPE_TEXT)
        dict_type_register(TYPE_I64, TYPE_TEXT)
        union_type_register([TYPE_TEXT])
        named_generic_instance_register("RootRankOtherBox", [TYPE_TEXT])
        expect(rt_transient_array_scope_pause()).to_equal(true)
        expect(type_pools_promote_hir_owners()).to_equal(true)
        expect(rt_transient_array_scope_end()).to_equal(true)
        expect(custom_primitive_underlying_type_tag_by_name("RootRankWord")).to_equal(TYPE_I64)
        expect(custom_primitive_underlying_type_tag_by_name("RootRankOther")).to_equal(TYPE_TEXT)
        expect(dict_type_get_key(dictionary - TYPE_DICT_BASE)).to_equal(TYPE_TEXT)
        expect(union_type_get_members(union - TYPE_UNION_BASE)).to_equal([TYPE_I64, TYPE_TEXT])
        expect(named_generic_instance_arg_tags(index)).to_equal([TYPE_I64])
