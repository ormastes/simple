# Phase 2 full-CLI native link: every referenced Simple helper must be imported
# from its declaring module, not a similarly named backend facade.
use std.spec
use std.io_runtime.{file_read}

describe "Phase 2 Simple helper import contracts":
    it "resolves editor SDL calls through the optional SDL bridge":
        val shell = file_read("src/app/editor/gui_shell.spl")
        val core = file_read("src/app/editor/gui_shell_core.spl")
        val render = file_read("src/app/editor/gui_shell_render.spl")
        val bridge = file_read("src/lib/editor/70.backend/gui_sdl_bridge.spl")

        expect(shell).to_contain("use std.editor.backend.gui_sdl_bridge.\{gui_sdl_init, gui_sdl_shutdown, gui_sdl_present_frame, gui_sdl_poll}")
        expect(core).to_contain("use std.editor.backend.gui_sdl_bridge.\{gui_sdl_init, gui_sdl_shutdown}")
        expect(render).to_contain("use std.editor.backend.gui_sdl_bridge.\{gui_sdl_present_frame, gui_sdl_poll}")
        expect(bridge).to_contain("fn gui_sdl_init(")
        expect(bridge).to_contain("fn gui_sdl_shutdown(")
        expect(bridge).to_contain("fn gui_sdl_present_frame(")
        expect(bridge).to_contain("fn gui_sdl_poll(")

    it "keeps the lazy loader provider and its constructor on one owner type":
        val loader = file_read("src/compiler/99.loader/loader/module_loader.spl")
        val services = file_read("src/compiler/99.loader/loader/module_loader_services.spl")
        val provider = file_read("src/compiler/99.loader/loader/object_provider.spl")

        expect(loader).to_contain("use compiler.loader.loader.object_provider.\{ObjectProvider, ObjectProviderConfig}")
        expect(services).to_contain("use compiler.loader.loader.object_provider.\{ObjectProvider, ObjectProviderConfig, objectprovider_with_obj_taker}")
        expect(services).to_contain("objectprovider_with_obj_taker(provider_config, obj_taker)")
        expect(provider).to_contain("fn objectprovider_with_obj_taker(config: ObjectProviderConfig, obj_taker: ObjTaker) -> ObjectProvider:")

    it "imports the SIMD substring helper from its declaring module":
        val checks = file_read("src/compiler/35.semantics/lint/_SimdOpportunityLint/byte_checks.spl")
        val helper = file_read("src/compiler/35.semantics/lint/_SimdOpportunityLint/loop_analysis.spl")

        expect(checks).to_contain("use compiler.semantics.lint._SimdOpportunityLint.loop_analysis.\{_find_substr}")
        expect(helper).to_contain("fn _find_substr(")
