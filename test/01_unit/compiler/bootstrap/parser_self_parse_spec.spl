# Exact regression for the Stage4 parser.spl self-parse failure.
# @cover src/compiler/10.frontend/core/parser.spl

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.core.parser.{parser_has_errors}
use std.io_runtime.{read_file_text}

describe "bootstrap parser self-parse":
    it "parses the compiler parser including guarded integer text":
        val path = "src/compiler/10.frontend/core/parser.spl"
        val source = read_file_text(path)
        val module = parse_and_build_module(source, path)

        expect(source.len()).to_be_greater_than(0)
        expect(parser_has_errors()).to_equal(false)
        expect(module.functions.contains("parser_guarded_int_text")).to_equal(true)

    it "keeps the second Stage4 source intact":
        val first_path = "src/app/cli/main.spl"
        val first_source = read_file_text(first_path)
        val first = parse_and_build_module(first_source, first_path)
        expect(first_source.len()).to_be_greater_than(0)
        expect(first.functions.len()).to_be_greater_than(0)
        expect(parser_has_errors()).to_equal(false)

        val second_path = "src/lib/nogc_async_mut/cli/log_modes.spl"
        val second_source = read_file_text(second_path)
        val second = parse_and_build_module(second_source, second_path)
        expect(second_source.len()).to_be_greater_than(0)
        expect(second.functions.contains("parse_log_options")).to_equal(true)
        expect(parser_has_errors()).to_equal(false)
