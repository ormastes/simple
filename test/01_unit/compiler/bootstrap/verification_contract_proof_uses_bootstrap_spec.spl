"""Bootstrap regression for optional contract scalar-field typing."""

use app.io.mod.{file_read_text}

describe "verification contract proof root bootstrap typing":
    it "retains parser contract owners in the declaration lowering entry closure":
        val parser_types = file_read_text(
            "src/compiler/10.frontend/parser_types.spl")
        val lowering = file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl")
        expect(parser_types).to_contain("struct ContractClause:")
        expect(parser_types).to_contain("struct ContractBlock:")
        expect(parser_types).to_contain("decrease_measure: ContractClause?")
        expect(lowering).to_contain(
            "Param, ContractBlock, ContractClause}")
        expect(lowering).to_contain(
            "if val measure = contract.decrease_measure:")

    it "preserves the MIR contract type after optional unwrapping":
        val source = file_read_text(
            "src/compiler/50.mir/verification_contract_bridge.spl")
        expect(source).to_contain(
            "if val retained_value = func.verification_contract:")
        expect(source).to_contain(
            "val retained: HirContractBlock = retained_value")
        expect(source).to_contain("proof_root: retained.proof_uses")

    it "preserves the Lean contract type after optional unwrapping":
        val source = file_read_text(
            "src/plugins/backend_lean/lean_backend.spl")
        expect(source).to_contain(
            "if val present_value = contract:")
        expect(source).to_contain(
            "val present: HirContractBlock = present_value")
        expect(source).to_contain("result.proof_reference = present.proof_uses")
