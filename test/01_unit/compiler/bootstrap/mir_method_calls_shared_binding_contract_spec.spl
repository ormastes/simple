# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "MIR method-call strict shared bindings":
    it "derives Result payload types without optional reassignment":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: derives Result payload types without optional reassignment")
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")

        expect(source).to_contain("val result_ok_type: HirType? = if method == \"unwrap\" or method == \"unwrap_or\":")
        expect(source).to_contain("val result_err_type: HirType? = if method == \"unwrap_err\":")
        expect(source).to_contain("val static_method_id: SymbolId? = if static_receiver_name != \"\"")
        expect(source).to_contain("val unresolved_method_id: SymbolId? = if self.struct_method_syms.contains(unresolved_method_key):")
        expect(source.contains("var result_ok_type: HirType? = nil")).to_equal(false)
        expect(source.contains("var result_err_type: HirType? = nil")).to_equal(false)
        expect(source.contains("var static_method_id: SymbolId? = nil")).to_equal(false)
        expect(source.contains("var unresolved_method_id: SymbolId? = nil")).to_equal(false)
