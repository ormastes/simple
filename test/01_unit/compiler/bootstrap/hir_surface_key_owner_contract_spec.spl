use std.spec
use std.io_runtime.{file_read}

describe "HIR surface key ownership":
    it "carries a scalar surface index across nested lowering":
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")

        expect(source.contains("if native_entry_closure_hir:\n                retained_surface_index = source_idx")).to_equal(true)
        expect(source.contains("elif retained_module_surfaces.index_by_name.contains_key(name):")).to_equal(true)
        expect(source.contains("Missing module surface alias before HIR lowering")).to_equal(true)
        expect(source.contains("val stable_module_name: text = hir_module.name")).to_equal(true)
        expect(source.contains("phase_hir_modules[stable_module_name] = hir_module")).to_equal(true)
        expect(source.contains("phase_hir_modules[name] = hir_module\n            if not retained_module_surfaces.index_by_name.contains_key(name)")).to_equal(false)
