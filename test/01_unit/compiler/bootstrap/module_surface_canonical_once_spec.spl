"""Source contract for canonicalize-once ModuleSurfaceBuilder callers."""

use std.io_runtime.{file_read}

fn count_occurrences(haystack: text, needle: text) -> i64:
    haystack.split(needle).len() - 1

describe "module surface canonical path ownership":
    it "normalizes once in the streaming source loop and passes canonical identity":
        # 4b88aebf00b froze the source inventory: every source path is
        # canonicalized exactly once into `canonical_paths`, and the loop hands
        # that identity to both the alias and the parse branch.
        val driver = file_read(
            "src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        val stream_start = driver.find(
            "me parse_all_streaming_surfaces_in_place_impl() -> bool:") ?? -1
        val stream_end = driver.find(
            "me parse_all_streaming_surfaces_impl() -> (CompileContext, bool):") ?? -1
        expect(stream_start).to_be_greater_than(-1)
        expect(stream_end).to_be_greater_than(stream_start)
        val stream = driver.substring(stream_start, stream_end)
        expect(count_occurrences(stream, "module_surface_canonical_path(")).to_equal(1)
        expect(stream).to_contain("val frozen_path = module_surface_canonical_path(source_path)")
        expect(stream).to_contain("canonical_paths = canonical_paths.push(frozen_path)")
        expect(stream).to_contain("val canonical_path = canonical_paths[source_index]")
        expect(stream).to_contain("if builder.has_canonical_path(canonical_path):")
        expect(stream).to_contain("builder.add_alias_canonical_identity(")
        expect(stream).to_contain("val parsed_result = self.add_streaming_module_surface(")
        expect(stream).to_contain("source_index, canonical_path)")
        expect(stream.contains("builder.has_path(")).to_equal(false)
        expect(stream.contains("builder.add_alias(")).to_equal(false)

        # The per-source helper receives the frozen identity and never
        # re-normalizes it.
        val helper_start = driver.find("    me add_streaming_module_surface(") ?? -1
        val helper_end = driver.find("me parse_all_streaming_surfaces_in_place_impl() -> bool:") ?? -1
        expect(helper_start).to_be_greater_than(-1)
        expect(helper_end).to_be_greater_than(helper_start)
        val helper = driver.substring(helper_start, helper_end)
        expect(helper).to_contain("        canonical_path: text\n    ) -> Result<ModuleSurfaceBuilder, text>:")
        expect(helper).to_contain("builder.index_by_path.contains_key(canonical_path)")
        expect(helper.contains("module_surface_canonical_path(")).to_equal(false)

        val registry = file_read(
            "src/compiler/20.hir/hir_lowering/module_surface_types.spl")
        expect(registry).to_contain("struct ModuleSurfaceBuilder:")
        expect(registry).to_not_contain("class ModuleSurfaceBuilder:")
