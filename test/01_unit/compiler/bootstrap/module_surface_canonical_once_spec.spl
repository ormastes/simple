"""Source contract for canonicalize-once ModuleSurfaceBuilder callers."""

use std.io_runtime.{file_read}

describe "module surface canonical path ownership":
    it "normalizes once in each source loop and passes canonical identity":
        val driver = file_read(
            "src/compiler/80.driver/driver_source_pipeline_parsing.spl")
        val stream_start = driver.find(
            "me parse_all_streaming_surfaces_impl() -> bool:")
        val stream_end = driver.find("me parse_all_impl() -> (CompileContext, bool):")
        val stream = if stream_start >= 0 and stream_end > stream_start:
            driver.substring(stream_start, stream_end)
        else:
            ""
        expect(stream).to_contain("if source.physical_path != \"\":")
        expect(stream).to_contain("source.physical_path")
        expect(stream).to_contain("module_surface_canonical_path(source.path)")
        expect(stream).to_contain("builder.has_canonical_path(canonical_path)")
        expect(stream).to_contain("log_module_surface_alias(")
        expect(stream).to_contain(
            "builder.add_alias_canonical(\n                    source, canonical_path)")
        expect(stream).to_contain("val module = parse_full_frontend(")
        expect(stream).to_contain("val add_result = builder.add_surface_canonical(")
        expect(driver).to_not_contain("me add_streaming_module_surface(")
        expect(stream).to_not_contain("Result<ModuleSurfaceBuilder, text>")
        expect(stream).to_not_contain("builder = parsed_result.unwrap()")
        expect(stream).to_not_contain("if builder.frozen:")
        expect(stream).to_not_contain(
            "if builder.index_by_path.contains_key(canonical_path):")
        expect(stream.contains("builder.has_path(source.path)")).to_equal(false)
        expect(stream.contains("builder.add_alias(source)")).to_equal(false)

        val hir_driver = file_read(
            "src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        expect(hir_driver).to_contain(
            "val physical_surface_index = _driver_module_surface_index_for_source(")
        expect(hir_driver).to_contain(
            "module_surface_index_by_name(\n                    surfaces.ordered_names, surfaces.ordered_indices")
        expect(hir_driver).to_contain(
            "surface.canonical_path == module_surface_canonical_path(source.path)")
        expect(hir_driver.contains(
            "surfaces.index_by_name.contains_key(source.module_name)"
        )).to_equal(false)

        val surface = file_read(
            "src/compiler/20.hir/hir_lowering/module_surface.spl")
        expect(surface).to_contain("struct ModuleSurfaceBuilder:")
        expect(surface).to_not_contain("class ModuleSurfaceBuilder:")
        val batch_start = surface.find(
            "fn module_surfaces_from_owners(owners: Dict<text, ModuleSurfaceParserOwner>")
        val batch_end = surface.find("for alias in owners.keys():")
        val batch = if batch_start >= 0 and batch_end > batch_start:
            surface.substring(batch_start, batch_end)
        else:
            ""
        expect(batch).to_contain("builder.add_parsed_or_alias(")
        expect(batch.contains("builder.has_path(source.path)")).to_equal(false)
        expect(batch).to_not_contain("ParserModule")
        expect(batch).to_not_contain("modules[source.module_name]")

        val owner_add_start = surface.find(
            "me add_parsed_or_alias(owner: ModuleSurfaceParserOwner")
        val owner_add_end = surface.find(
            "# Commit an already-built surface", owner_add_start)
        val owner_add = if owner_add_start >= 0 and owner_add_end > owner_add_start:
            surface.substring(owner_add_start, owner_add_end)
        else:
            ""
        expect(owner_add).to_contain(
            "val canonical_path = module_surface_canonical_path(source.path)")
        expect(owner_add).to_contain("self.has_canonical_path(canonical_path)")
        expect(owner_add).to_contain(
            "self.add_alias_canonical(source, canonical_path)")
        expect(owner_add).to_contain("self.add_parsed_canonical(")

    it "keeps path-taking owner wrappers without whole parser modules":
        val surface = file_read(
            "src/compiler/20.hir/hir_lowering/module_surface.spl")
        expect(surface).to_contain("me has_path(path: text) -> bool:")
        expect(surface).to_contain(
            "me add_parsed(owner: ModuleSurfaceParserOwner, source: SourceFile, source_index: i64)")
        expect(surface).to_contain("me add_alias(source: SourceFile)")
        expect(surface).to_contain(
            "self.add_parsed_canonical(owner, source, source_index, canonical_path)")
        expect(surface).to_contain(
            "self.add_alias_canonical(source, canonical_path)")
        expect(surface).to_not_contain("add_parsed(module: ParserModule")
        expect(surface).to_not_contain("add_parsed_canonical(module: ParserModule")
        expect(surface).to_not_contain("module_surface_from_module")
