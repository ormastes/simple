use std.spec.*
use std.io_runtime.{file_read}

describe "entry-closure bucket count contract":
    it "bounds persistent bucket copies while retaining exact bucket sets":
        val native_build = file_read("src/app/io/_CliCompile/compile_targets.spl")
        val driver = file_read("src/compiler/80.driver/driver.spl")
        val loading = file_read("src/compiler/80.driver/driver_source_loading.spl")

        expect(native_build).to_contain("var discovered = _driver_text_bucket_set_new(512)")
        expect(driver).to_contain("var seen_sources = _driver_text_bucket_set_new(512)")
        expect(driver).to_contain("var closure_loaded_mods = _driver_text_bucket_set_new(512)")
        expect(driver).to_contain("var closure_seen_mods = _driver_text_bucket_set_new(512)")
        expect(driver).to_contain("var closure_queued_paths = _driver_text_bucket_set_new(512)")
        expect(driver).to_contain("var closure_scan_sources = _driver_unique_physical_sources(all_sources)")
        expect(loading).to_contain("var seen = _driver_text_bucket_set_new(512)")
        expect(loading).to_contain("bucket.starts_with(marker) or bucket.contains(\"\\n\" + marker)")
        expect(loading).to_contain("var _driver_entry_import_module_paths_cache: Dict<text, [text]> = {}")
        expect(loading).to_contain("if _driver_entry_import_module_paths_cache.contains_key(content):")
        expect(loading).to_contain("_driver_entry_import_module_paths_cache[content] = module_paths")
