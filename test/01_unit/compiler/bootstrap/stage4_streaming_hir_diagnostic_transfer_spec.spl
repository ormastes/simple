use std.io.{file_read}
use std.spec.{describe, it, expect}

val HIR_LOWERING = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"

describe "Stage4 streaming HIR diagnostic transfer":
    it "uses flat HIR diagnostic projections before retaining a module":
        # Pins the scalar/text projection loop as landed on main by 4b88aebf00b:
        # the per-module poison decision is made from this module's fatal count
        # (`module_fatal_error_count`), not from the aggregate context error list.
        val driver = file_read(HIR_LOWERING)
        val start = driver.index_of("me lower_and_check_streaming_surfaces_impl")
        val end = driver.index_of("me lower_and_check_impl")
        expect(start).to_be_greater_than(-1)
        expect(end).to_be_greater_than(start)
        val body = driver.substring(start, end)
        val count = body.index_of("val module_error_count: i64 = lowering.lowering_error_count()")
        val loop = body.index_of("while module_error_index < module_error_count:")
        val message = body.index_of("val module_error_message = lowering.lowering_error_message_at(")
        val recovered = body.index_of("val module_error_recovered = lowering.lowering_error_is_recovered_at(")
        val fatal = body.index_of("self.ctx.add_error(module_error_message)")
        val stop = body.index_of("if module_fatal_error_count > 0:")
        val poison = body.find("poisoned_by_surface[surface_index] = true", stop) ?? -1
        expect(count).to_be_greater_than(0)
        expect(loop).to_be_greater_than(count)
        expect(message).to_be_greater_than(loop)
        expect(recovered).to_be_greater_than(message)
        expect(fatal).to_be_greater_than(recovered)
        expect(stop).to_be_greater_than(fatal)
        expect(poison).to_be_greater_than(stop)
        expect(body.contains("_driver_collect_hir_errors(")).to_be(false)
        expect(body.contains("lowering.errors)")).to_be(false)
        expect(body.contains("lowering.errors.len()")).to_be(false)
