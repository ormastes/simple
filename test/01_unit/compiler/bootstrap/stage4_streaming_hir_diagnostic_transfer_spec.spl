use std.io.{file_read}
use std.spec.{describe, it, expect}

val HIR_LOWERING = "src/compiler/80.driver/driver_hir_pipeline_lowering.spl"

describe "Stage4 streaming HIR diagnostic transfer":
    it "uses flat HIR diagnostic projections before retaining a module":
        val driver = file_read(HIR_LOWERING)
        val start = driver.index_of("me lower_and_check_streaming_surfaces_impl")
        val end = driver.index_of("me lower_and_check_impl")
        val body = driver.substring(start, end)
        val count = body.index_of("val module_error_count: i64 = lowering.lowering_error_count()")
        val message = body.index_of("lowering.lowering_error_message_at(")
        val recovered = body.index_of("val module_error_recovered: bool = lowering.lowering_error_is_recovered_at(")
        val fatal = body.index_of("self.ctx.add_error(module_error_message)")
        val stop = body.index_of("if self.ctx.errors.len() > 0:")
        expect(count).to_be_greater_than(0)
        expect(message).to_be_greater_than(count)
        expect(recovered).to_be_greater_than(message)
        expect(fatal).to_be_greater_than(recovered)
        expect(stop).to_be_greater_than(fatal)
        expect(body.contains("_driver_collect_hir_errors(self.ctx, source.module_name, lowering.errors)")).to_be(false)
