"""
## Purpose and audience
Regression coverage for the bootstrap-flat lowering surface that main
actually ships: the Stage-3 reproducer shape in the bootstrap CLI entry, and
the flat-arena block lowering accepting a shared expression DAG node.
Audience: HIR-lowering and bootstrap-lane maintainers.

## Operator workflow
Run the file with the self-hosted runner from the repo root:
`bin/simple test test/01_unit/compiler/bootstrap/bootstrap_flat_if_tail_lowering_spec.spl`.

## Compatibility and limitations
Retired 2026-09-26 (owner decision, bootstrap46 triage): the flat if/elif/else
IfChain lowering, loop/continue/for lowering, and the fail-closed checks this
file used to pin exist only on a share-history branch squashed into
e274cd33719; main's `lower_bootstrap_flat_stmt` lowers only STMT_EXPR,
STMT_RETURN and declarations. Those scenarios are tracked as a todo under
doc/08_tracking/ for re-landing, not asserted here.

## Verification guidance and troubleshooting
A failure means the reproducer shape moved or the flat block lowering stopped
de-duplicating a shared node; compare against `lower_bootstrap_flat_block` in
`src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl`.
"""
# Lifecycle: doc/01_research/compiler/bootstrap/bootstrap_strategy_research_2026-02-23.md ;
# doc/03_plan/compiler/bootstrap/bootstrap_lane_plan_2026-08-19.md ;
# doc/04_architecture/compiler/bootstrap_build_modes.md ;
# doc/05_design/compiler/bootstrap/pure_simple_full_cli_bootstrap_recovery.md
# @manual_section: bootstrap-flat-if-tail-lowering

extern fn rt_file_read_text(path: text) -> text

use compiler.core.ast.{ast_reset, stmt_expr_stmt, expr_int_lit}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*

fn source(path: text) -> text:
    rt_file_read_text(path) ?? ""

use std.spec.step

describe "bootstrap-flat if tail lowering":
    it "keeps the bootstrap output parser as a non-unit if-chain tail":
        # @req REQ-COMPILER-HIR-FLATIF-003
        # @capture(bit_table): retained verdict for scenario 'keeps the bootstrap output parser as a non-unit if-chain tail'
        step("Pin the Stage3 reproducer shape")
        val entry = source("src/app/cli/bootstrap_main.spl")

        expect(entry).to_contain("fn bootstrap_output_from_args(args: [text], i: i64) -> text:")
        expect(entry).to_contain("elif args[i].starts_with(\"--output=\"):")
        expect(entry).to_contain("bootstrap_output_from_args(args, i + 1)")

    it "accepts repeated references to one shared expression DAG node":
        # @req REQ-COMPILER-HIR-FLATIF-015
        # @capture(bit_table): retained verdict for scenario 'accepts repeated references to one shared expression DAG node'
        step("Verify: accepts repeated references to one shared expression DAG node")
        ast_reset()
        val shared = expr_int_lit(7, 0)
        val first = stmt_expr_stmt(shared, 0)
        val second = stmt_expr_stmt(shared, 0)
        var lowering = HirLowering.new()
        val lowered = lowering.lower_bootstrap_flat_block([first, second])
        expect(lowering.errors.len()).to_equal(0)  # oracle: the well-formed fixture must lower without diagnostics
        expect(lowered.stmts.len()).to_equal(1)  # oracle: one shared DAG node lowers to exactly one statement
        expect(lowered.has).to_equal(true)
        ast_reset()

