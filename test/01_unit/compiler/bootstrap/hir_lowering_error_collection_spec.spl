use std.spec.{describe, it, expect, step}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.common.diagnostics.span.{Span}
use compiler.driver.driver.{_driver_collect_hir_errors}
use compiler.driver.driver_types.{CompileContext}
use compiler.hir.hir_lowering.types.{HirLowering}

describe "bootstrap HIR lowering error collection", tag: ["only-compiled"]:
    it "collects empty, recovered, and fatal typed errors":
        var ctx = CompileContext.create(driver_core_compile_options_default())
        var lowering = HirLowering.with_filename("bootstrap_error_fixture.spl")

        step("Keep an empty lowering result empty")
        _driver_collect_hir_errors(ctx, "empty_fixture", lowering.errors)
        expect(ctx.warnings.len()).to_equal(0)
        expect(ctx.errors.len()).to_equal(0)

        step("Collect copied struct values through the shared driver path")
        lowering.recovered("recoverable fixture", Span.empty())
        lowering.error("fatal fixture", Span.empty())
        _driver_collect_hir_errors(ctx, "typed_fixture", lowering.errors)

        expect(ctx.warnings.len()).to_equal(1)
        expect(ctx.warnings[0]).to_contain("HIR lowering error in typed_fixture")
        expect(ctx.warnings[0]).to_contain("recoverable fixture")
        expect(ctx.errors.len()).to_equal(1)
        expect(ctx.errors[0]).to_contain("HIR lowering error in typed_fixture")
        expect(ctx.errors[0]).to_contain("fatal fixture")
