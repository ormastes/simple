extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create(path: text, recursive: bool) -> bool
extern fn rt_path_absolute(path: text) -> text
extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool

use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.core.interpreter.hashmap.{hm_hash_text}
use compiler.driver.driver.{compiler_driver_create}
use compiler.driver.driver_source_loading.{
    DriverTextBucketSet,
    _driver_canonical_source_path, _driver_module_name_from_path, _driver_unique_physical_sources,
    _driver_module_name_collision,
    _driver_text_bucket_set_new, _driver_text_bucket_set_has, _driver_text_bucket_set_add,
    _driver_collect_sources_via_find, _driver_entry_import_module_paths,
    _driver_entry_sibling_module_paths
}

fn module_name_normalizer_body(source: text) -> text:
    val start = source.find("    var mod_path = path.replace(\"\\\\\", \"/\")") ?? -1
    if start < 0:
        return ""
    val tail = source.substring(start)
    val marker = "    mod_path.replace(\"/\", \".\")"
    val end = tail.find(marker) ?? -1
    if end < 0:
        return ""
    tail.substring(0, end + marker.len())

describe "entry-closure physical source deduplication":
    it "normalizes aliases to one physical parse source":
        val content = "fn shared() -> i64: 1\n"
        val sources = [
            SourceFile(path: "./src/lib/common/../common/shared.spl", content: content, module_name: "std.shared"),
            SourceFile(path: "src/lib/common/shared.spl", content: content, module_name: "lib.common.shared")
        ]

        expect(_driver_canonical_source_path(sources[0].path)).to_equal("src/lib/common/shared.spl")
        expect(_driver_unique_physical_sources(sources).len()).to_equal(1)

    it "registers two logical aliases after one physical parse":
        val old_closure = rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
        expect(rt_env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "1")).to_equal(true)
        val content = "fn shared() -> i64: 1\n"
        var driver = compiler_driver_create(driver_core_compile_options_default())
        var ctx = driver.ctx
        ctx.sources = [
            SourceFile(path: "./src/lib/common/../common/shared.spl", content: content, module_name: "std.shared"),
            SourceFile(path: "src/lib/common/shared.spl", content: content, module_name: "lib.common.shared")
        ]
        driver.ctx = ctx

        val (parsed, ok) = driver.parse_all_impl()
        expect(rt_env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", old_closure)).to_equal(true)

        expect(ok).to_be(true)
        expect(parsed.modules.contains_key("std.shared")).to_be(true)
        expect(parsed.modules.contains_key("lib.common.shared")).to_be(true)
        expect(parsed.sources.len()).to_equal(1)

    it "keeps absolute workspace punctuation out of native module symbols":
        val driver = rt_file_read_text("src/compiler/80.driver/driver_source_loading.spl") ?? ""
        val bootstrap_mir = rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""
        val hir = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""
        val llvm = rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl") ?? ""
        expect(_driver_module_name_from_path("/private/tmp/simple-main-bootstrap/src/compiler/80.driver/driver.spl")).to_equal("compiler.80.driver.driver")
        expect(_driver_module_name_from_path("/private/tmp/simple-main-bootstrap/examples/10_tooling/trace32_tools/t32_cli/cli_shell.spl")).to_equal("examples.10_tooling.trace32_tools.t32_cli.cli_shell")
        expect(_driver_module_name_from_path("plugins/my-tool/main.spl")).to_equal("plugins.my_tool.main")
        expect(_driver_module_name_from_path("plugins/tool+kit/naïve@entry.spl")).to_equal("plugins.tool_kit.na_ve_entry")
        val canonical_body = module_name_normalizer_body(driver)
        expect(canonical_body == "").to_be(false)
        expect(module_name_normalizer_body(bootstrap_mir)).to_equal(canonical_body)
        expect(module_name_normalizer_body(hir)).to_equal(canonical_body)
        expect(module_name_normalizer_body(llvm)).to_equal(canonical_body)

    it "rejects distinct physical files with one sanitized module name":
        val dashed = SourceFile(path: "plugins/my-tool/main.spl", content: "", module_name: _driver_module_name_from_path("plugins/my-tool/main.spl"))
        val underscored = SourceFile(path: "plugins/my_tool/main.spl", content: "", module_name: _driver_module_name_from_path("plugins/my_tool/main.spl"))
        val same_file = SourceFile(path: "plugins/my-tool/../my-tool/main.spl", content: "", module_name: dashed.module_name)
        val absolute_same_file = SourceFile(path: rt_path_absolute(dashed.path), content: "", module_name: dashed.module_name)

        expect(_driver_module_name_collision([dashed, underscored])).to_contain("both map to 'plugins.my_tool.main'")
        expect(_driver_module_name_collision([dashed, same_file])).to_equal("")
        expect(_driver_module_name_collision([dashed, absolute_same_file])).to_equal("")

    it "keeps colliding bucket keys exact and persistent":
        var buckets: DriverTextBucketSet = _driver_text_bucket_set_new(1)
        buckets = _driver_text_bucket_set_add(buckets, "std.alpha")
        buckets = _driver_text_bucket_set_add(buckets, "std.alphabet")
        buckets = _driver_text_bucket_set_add(buckets, "std.alpha")
        val loading = rt_file_read_text("src/compiler/80.driver/driver_source_loading.spl") ?? ""

        expect(_driver_text_bucket_set_has(buckets, "std.alpha")).to_be(true)
        expect(_driver_text_bucket_set_has(buckets, "std.alphabet")).to_be(true)
        expect(_driver_text_bucket_set_has(buckets, "std.alph")).to_be(false)
        expect(loading).to_contain("use compiler.core.interpreter.hashmap.{hm_hash_text}")
        expect(loading).to_contain("val raw = hm_hash_text(key) % bucket_count")
        expect(loading.contains("extern fn rt_hash_text")).to_be(false)
        expect(loading).to_contain("bucket.starts_with(marker) or bucket.contains(\"\\n\" + marker)")
        expect(loading.contains("for existing in bucket.split(\"\\n\")")).to_be(false)
        expect(loading).to_contain("class DriverTextBucketSet:")
        expect(loading).to_contain("var buckets: [text] = []")
        expect(loading.contains("rt_array_new_with_cap")).to_be(false)
        expect(loading).to_contain("pub class DriverTextBucketSet:")
        expect(loading).to_contain("var seen: DriverTextBucketSet")
        expect(loading).to_contain("self.buckets[index] = self.buckets[index] + key + \"\\n\"")
        expect(loading.contains("var updated = buckets")).to_be(false)

    it "hashes every UTF-8 byte without indexed text ord lowering":
        val hashmap = rt_file_read_text("src/compiler/10.frontend/core/interpreter/hashmap.spl") ?? ""

        expect(hm_hash_text("a") == hm_hash_text("g")).to_be(false)
        expect(hashmap).to_contain("val bytes = s.bytes()")
        expect(hashmap).to_contain("h = h xor (bytes[i] as i64)")
        expect(hashmap.contains("s[i].ord()")).to_be(false)

    it "registers every logical alias from one cached module result":
        val driver = rt_file_read_text("src/compiler/80.driver/driver.spl") ?? ""

        expect(driver).to_contain("val unique_entry_sources = _driver_unique_physical_sources(entry_sources)")
        expect(driver).to_contain("var parsed_entry_index: Dict<text, i64> = {}")
        expect(driver).to_contain("parsed_entry_index[physical_key] = parsed_entry_modules.len()")
        expect(driver).to_contain("if not parsed_entry_index.contains_key(physical_key):")
        expect(driver).to_contain("parsed_entry_modules = parsed_entry_modules.push(entry_module)")
        expect(driver).to_contain("entry_modules = entry_modules.set(source.module_name, parsed_entry_modules[parsed_idx])")
        expect(driver).to_not_contain("entry_modules[source.module_name] = parsed_entry_modules[parsed_idx]")
        expect(driver).to_contain("val closure_physical_key = _driver_physical_source_key(closure_src.path)")
        expect(driver).to_contain("val physical_key = _driver_physical_source_key(source.path)")
        expect(driver.split("val physical_key = _driver_physical_source_key(source.path)").len()).to_equal(3)
        expect(driver.contains("_driver_text_list_index(parsed_entry_paths, physical_key)")).to_be(false)
        expect(driver).to_contain("entry_ctx.sources = unique_entry_sources")
        expect(driver).to_contain(r"phase2:parse:closure:sources collected={entry_sources.len()} unique={unique_entry_sources.len()}")

    it "uses bucket sets for every phase-one closure membership role":
        val driver = rt_file_read_text("src/compiler/80.driver/driver.spl") ?? ""

        expect(driver).to_contain("var seen_sources = _driver_text_bucket_set_new(8192)")
        expect(driver).to_contain("var closure_loaded_mods = _driver_text_bucket_set_new(8192)")
        expect(driver).to_contain("var closure_seen_mods = _driver_text_bucket_set_new(8192)")
        expect(driver).to_contain("var closure_scanned_paths = _driver_text_bucket_set_new(8192)")
        expect(driver.contains("var closure_seen_mods: [text]")).to_be(false)

    it "scans imports through native text operations":
        val imports = _driver_entry_import_module_paths("use std.real\n\"\"\"\nuse fake.block\n\"\"\"\n\"\"\"use fake.inline\"\"\"\nexport use app.live.*\nimport third.party\nuse app.module.Func\n")
        val long_imports = _driver_entry_import_module_paths(("# filler\n").repeat(8192) + "use std.tail." + "{" + "Thing}\n")
        val ordinary_imports = _driver_entry_import_module_paths("val x = 1\n".repeat(4096) + "\timport app.final\n")
        val unicode_imports = _driver_entry_import_module_paths("é\n# 文\n\tuse std.unicode\n")
        val comment_imports = _driver_entry_import_module_paths("# docs mention \"\"\"\nuse std.comment\nval x = 1 # \"\"\"\nimport std.after_inline\n")
        val doc_comment_close = _driver_entry_import_module_paths("\"\"\"\n# \"\"\"\nuse std.after_doc\n")
        val siblings = _driver_entry_sibling_module_paths("mod pkg.real\n\"\"\"\nmod pkg.fake\nexport fake.deep.*\n\"\"\"\n# mod pkg.comment\nexport sibling.deep.*\nexport A, B\nexport use app.live.*\n")
        val loading = rt_file_read_text("src/compiler/80.driver/driver_source_loading.spl") ?? ""

        expect(imports).to_equal(["std.real", "app.live", "third.party", "app.module.Func"])
        expect(long_imports).to_equal(["std.tail"])
        expect(ordinary_imports).to_equal(["app.final"])
        expect(unicode_imports).to_equal(["std.unicode"])
        expect(comment_imports).to_equal(["std.comment", "std.after_inline"])
        expect(doc_comment_close).to_equal(["std.after_doc"])
        expect(siblings).to_equal([".real", ".sibling.deep"])
        expect(loading).to_contain('for raw_line in content.split("\n"):')
        expect(loading).to_contain('if scan_line.contains("\\\"\\\"\\\""):')
        expect(loading).to_contain("_driver_import_path_is_valid(module_path)")
        expect(loading).to_contain("_driver_entry_import_module_paths_text_fallback")

    it "keeps command-only tools out of the ordinary CLI entry closure":
        val cli_entry = rt_file_read_text("src/app/cli/_CliMain/main_and_help.spl") ?? ""
        val json_wrapper = rt_file_read_text("src/app/test_runner_new/json_wrapper.spl") ?? ""
        val imports = _driver_entry_import_module_paths(cli_entry)

        expect(imports.contains("app.test_runner_new.test_runner_main")).to_be(false)
        expect(imports.contains("app.test_runner_new.json_wrapper")).to_be(false)
        expect(imports.contains("compiler.tools.leak_check.main")).to_be(false)
        expect(cli_entry).to_contain("use lazy app.test_runner_new.test_runner_main.{run_test_cli}")
        expect(cli_entry).to_contain("use lazy app.test_runner_new.json_wrapper.{run_test_json_wrapper, test_json_requested, test_json_worker_requested}")
        expect(cli_entry).to_contain("use lazy compiler.tools.leak_check.main.{run_leak_check}")
        expect(cli_entry).to_contain("return run_test_cli()")
        expect(cli_entry).to_contain("elif str_eq(first, \"leak-check\"):\n        return run_leak_check()")
        expect(json_wrapper).to_contain("return [\"run\", \"src/app/test_runner_new/main.spl\", TEST_JSON_WORKER_ARG] + test_args")
        expect(json_wrapper.contains("return [\"run\", arg, \"test\", TEST_JSON_WORKER_ARG]")).to_be(false)

    it "uses the HIR call type arguments already bound by inference":
        val inference = rt_file_read_text("src/compiler/30.types/type_infer/inference_expr.spl") ?? ""

        expect(inference).to_contain("case Call(callee, args, type_args):")
        expect(inference).to_contain("self.generate_obligations_for_function_call(func_symbol, type_args, span)")
        expect(inference.contains("call_type_args")).to_be(false)

    it "keeps a zero-import explicit entry out of whole-workspace loading":
        val driver = rt_file_read_text("src/compiler/80.driver/driver.spl") ?? ""

        expect(driver).to_contain("if self.ctx.errors.len() == 0:\n                # A successful explicit-entry walk is a closure")
        expect(driver).to_contain("rt_env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"1\")")
        expect(driver).to_contain("if has_project_source and self.ctx.options.mode != CompileMode.Check and not nb_entry_closure:")
        expect(driver.contains("closure_added")).to_be(false)

    it "fails required closure load parse and HIR errors before later phases":
        val driver = rt_file_read_text("src/compiler/80.driver/driver.spl") ?? ""
        val compile_start = driver.find("    me compile() -> CompileResult:") ?? -1
        val load_start = driver.find("    me load_sources_impl() -> (CompileContext, bool):") ?? -1
        val parse_start = driver.find("    me parse_all_impl() -> (CompileContext, bool):") ?? -1
        val hir_start = driver.find("    me lower_and_check_impl() -> (CompileContext, bool):") ?? -1
        val hir_end = driver.find("    fn lower_to_hir_impl() -> (CompileContext, bool):") ?? -1
        expect(compile_start).to_be_greater_than(-1)
        expect(load_start).to_be_greater_than(compile_start)
        expect(parse_start).to_be_greater_than(load_start)
        expect(hir_start).to_be_greater_than(parse_start)
        expect(hir_end).to_be_greater_than(hir_start)

        val compile_body = driver.substring(compile_start, load_start)
        val load_body = driver.substring(load_start, parse_start)
        val parse_body = driver.substring(parse_start, hir_start)
        val hir_body = driver.substring(hir_start, hir_end)
        expect(compile_body).to_contain("val (loaded_ctx, load_ok) = self.load_sources_impl()\n        self.ctx = loaded_ctx\n        if not load_ok:")
        expect(compile_body).to_contain("val (parsed_ctx, parse_ok) = self.parse_all_impl()\n        self.ctx = parsed_ctx\n        if not parse_ok:")
        expect(compile_body).to_contain("if not analyze_ok:\n            log_error(\"phase 3 FAILED\")")
        val type_error_return = compile_body.index_of("return CompileResult.TypeError(self.ctx.errors)") ?? -1
        val phase4_start = compile_body.index_of("phase4:monomorphize:start") ?? -1
        expect(type_error_return).to_be_greater_than(-1)
        expect(phase4_start).to_be_greater_than(type_error_return)
        val unresolved_error = load_body.index_of("self.ctx.add_error(\"unresolved import '") ?? -1
        val empty_import_error = load_body.index_of("self.ctx.add_error(\"import '") ?? -1
        val sources_commit = load_body.index_of("self.ctx.sources = all_sources") ?? -1
        expect(unresolved_error).to_be_greater_than(-1)
        expect(empty_import_error).to_be_greater_than(unresolved_error)
        expect(sources_commit).to_be_greater_than(empty_import_error)
        expect(load_body.substring(sources_commit)).to_contain("self.ctx.errors.len() == 0")
        expect(parse_body).to_contain("if par_had_error_get():\n                    self.ctx.errors.push(\"parse error in {source.path} (see [parser_error] output above)\")\n                    return false")
        val hir_loop_start = hir_body.index_of("var source_idx = 0") ?? -1
        expect(hir_loop_start).to_be_greater_than(-1)
        val hir_loop = hir_body.substring(hir_loop_start)
        val hir_error_collect = hir_loop.index_of("_driver_collect_hir_errors(self.ctx, name, lowering.errors)") ?? -1
        val hir_final_status = hir_loop.index_of("\n        self.ctx.errors.len() == 0") ?? -1
        expect(hir_error_collect).to_be_greater_than(-1)
        expect(hir_final_status).to_be_greater_than(hir_error_collect)

    it "collects only the source roots supplied by its caller":
        val loading = rt_file_read_text("src/compiler/80.driver/driver_source_loading.spl") ?? ""
        val helpers = rt_file_read_text("src/compiler/80.driver/driver_helpers.spl") ?? ""

        expect(loading).to_contain("for path in paths:\n        val loaded = _driver_collect_sources(path)")
        expect(helpers).to_contain("for path in paths:\n        val loaded = _driver_collect_sources(path)")
        expect(loading.contains("find src/app src/lib src/compiler src/runtime")).to_be(false)
        expect(helpers.contains("find src/app src/lib src/compiler src/runtime")).to_be(false)

    it "uses the canonical numbered-layer MIR module in legacy optimization passes":
        val engine = rt_file_read_text("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl") ?? ""
        val io_passes = rt_file_read_text("src/compiler/60.mir_opt/_OptimizationPasses/io_passes.spl") ?? ""
        val legacy_spec = rt_file_read_text("src/compiler/60.mir_opt/optimization_passes.spipe") ?? ""
        expect(engine).to_contain("use compiler.mir.mir_data.*")
        expect(io_passes).to_contain("use compiler.mir.mir_data.*")
        expect(legacy_spec).to_contain("use compiler.mir.mir_data.*")
        expect(engine.contains("use mir_data.*")).to_be(false)
        expect(io_passes.contains("use mir_data.*")).to_be(false)
        expect(legacy_spec.contains("use mir_data.*")).to_be(false)

    it "does not scan a sibling root omitted by its caller":
        val fixture = "/tmp/simple-entry-closure-source-roots"
        val included = fixture + "/included"
        val omitted = fixture + "/omitted"
        expect(rt_dir_create(included, true)).to_be(true)
        expect(rt_dir_create(omitted, true)).to_be(true)
        expect(rt_file_write_text(included + "/main.spl", "fn main() -> i64: 0\n")).to_be(true)
        expect(rt_file_write_text(omitted + "/database.spl", "fn unrelated() -> i64: 1\n")).to_be(true)

        val sources = _driver_collect_sources_via_find([included])
        expect(sources.len()).to_be_greater_than(0)
        for source in sources:
            expect(source.path).to_start_with(included)
