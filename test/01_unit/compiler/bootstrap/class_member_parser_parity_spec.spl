use std.spec.{describe, it, expect}
use compiler.core.parser.{parse_module, parser_has_errors}

describe "bootstrap class-member parser parity":
    it "accepts keyword-named fields without stealing contextual declarations":
        val source = (
            "struct KeywordFields:\n" +
            "    type: text\n" +
            "    pass: bool\n" +
            "    after: i64\n" +
            "    val: text\n" +
            "    var mutable_name: i64\n"
        )

        parse_module(source, "class_member_keyword_fields.spl")
        expect(parser_has_errors()).to_equal(false)

    it "accepts public static, instance, and mutable methods next to associated types and placeholders":
        val source = (
            "class PublicMethods:\n" +
            "    pub static fn new() -> PublicMethods:\n" +
            "        PublicMethods()\n" +
            "    pub fn read() -> i64:\n" +
            "        1\n" +
            "    pub me write(value: i64):\n" +
            "        pass\n" +
            "\n" +
            "trait Associated:\n" +
            "    type Item = text\n" +
            "    pass\n"
        )

        parse_module(source, "class_member_public_methods.spl")
        expect(parser_has_errors()).to_equal(false)

    it "still rejects an invalid class-body member":
        parse_module("class Broken:\n    +\n", "class_member_invalid.spl")
        expect(parser_has_errors()).to_equal(true)
