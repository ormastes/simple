# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "VHDL call-definition strict shared bindings":
    it "finds the last local definition without optional reassignment":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: finds the last local definition without optional reassignment")
        val source = file_read("src/compiler/70.backend/backend/vhdl/vhdl_call_lowering.spl")

        expect(source).to_contain("fn local_definition(func: MirFunction, local: LocalId) -> MirInst?:")
        expect(source).to_contain("val definition = self.local_definition(func, local)")
        expect(source.contains("var definition: MirInst? = nil")).to_equal(false)
