# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "VHDL call-definition strict shared bindings":
    it "finds the last local definition without optional reassignment":
        # @req REQ-SSPEC-COMPILER
        step("finds the last local definition without optional reassignment")
        val source = file_read("src/plugins/backend_vhdl/vhdl/vhdl_call_lowering.spl")

        expect(source).to_contain("fn local_definition(func: MirFunction, local: LocalId) -> MirInst?:")
        expect(source).to_contain("val definition = self.local_definition(func, local)")
        expect(source).to_not_contain("var definition: MirInst? = nil")
