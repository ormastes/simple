use std.io.{file_read}
use std.spec.{describe, it, expect}

describe "Stage 4 CLI stderr facade":
    it "routes CLI diagnostics through the canonical stderr owner":
        val source = file_read("src/app/io/cli_ops.spl")
        expect(source).to_contain("use std.nogc_sync_mut.io.stderr_ops.{stderr_write}")
        expect(source).to_contain("stderr_write(msg)")
        expect(source).to_contain("if not msg.ends_with(\"\\n\"):")
        expect(source).to_contain("stderr_write(\"\\n\")")
        expect(source.contains("fn _cli_eprint(msg: text):\n    eprint(msg)")).to_be(false)
