# Bug: seed_rust_build_not_reproducible_2026-11-02
# Two `cargo build --profile bootstrap -p simple-driver --features llvm` runs of
# identical seed source produced different simple.exe bytes. The native object
# cache keys on the seed binary, so this invalidated every stage2 object.
#
# Root cause (2026-11-09, two builds + byte diff): lld-link stamped the COFF
# TimeDateStamp, debug-directory timestamp and CodeView GUID from the clock and
# from the PDB (which records rustc's random temp link dir). Fix: `/Brepro` in
# .cargo/config.toml and `/DEBUG:NONE` for bootstrap-profile bins in
# driver/build.rs. Verified: two relinks -> identical sha256 85dca91a...
# A full two-build compare needs ~1h of cargo; these guards pin the fix inputs.

extern fn rt_file_read_text(path: text) -> text?

fn read_src(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "seed Rust build reproducibility":
    it "records the observed non-reproducible seed digests":
        val first = "36336a97feec0a521cc88f9ca15d53fa0ba3f01d3797a6dd9efe59b9627a990e"
        val second = "34884dbd5a6cd6488b386612ac94a846450282bf8363dcb34cc1a623d9c72553"
        expect(first == second).to_equal(false)

    it "links msvc seed binaries with /Brepro":
        val cfg = read_src("src/compiler_rust/.cargo/config.toml")
        expect(cfg.contains("link-arg=/Brepro")).to_equal(true)

    it "drops the nondeterministic PDB for bootstrap-profile bins":
        val b = read_src("src/compiler_rust/driver/build.rs")
        expect(b.contains("emit_reproducible_msvc_link_args(&out_dir)")).to_equal(true)
        expect(b.contains("cargo:rustc-link-arg-bins=/DEBUG:NONE")).to_equal(true)
