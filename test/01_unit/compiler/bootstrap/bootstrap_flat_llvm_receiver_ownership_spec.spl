use std.spec
use std.io_runtime.{file_read}

describe "bootstrap flat LLVM receiver ownership":
    it "resolves user signatures through scalar bootstrap ids":
        val core = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        val class_def = file_read("src/compiler/70.backend/backend/_MirToLlvm/class_def.spl")

        expect(core.contains("me bootstrap_llvm_function_index_for_name(func_name: text) -> i64:")).to_equal(true)
        val method_pos = core.index_of("    me bootstrap_llvm_function_index_for_name(func_name: text) -> i64:")
        val impl_end = core.index_of("fn bootstrap_llvm_static_index(module_index: i64, symbol_id: i64) -> i64:")
        expect(method_pos >= 0 and impl_end > method_pos).to_equal(true)
        expect(core.contains("lookup_name == name or lookup_name == emitted_name")).to_equal(true)
        expect(core.contains("bootstrap_mir_function_module_at(local_scan) == self.current_bootstrap_module")).to_equal(true)
        expect(core.contains("if local_index >= 0:\n                            return -1")).to_equal(true)
        expect(core.contains("bootstrap_mir_function_param_type_tag_at(bootstrap_index, index)")).to_equal(true)
        expect(core.contains("if ir_handle < 0:\n            self.remember_function_param_types(name, param_types)")).to_equal(true)
        expect(core.contains("self.index_bootstrap_function_signatures()")).to_equal(false)
        expect(class_def.contains("bootstrap_function_exact_indices")).to_equal(false)
        expect(class_def.contains("bootstrap_function_local_indices")).to_equal(false)

    it "keeps static and function emission on one receiver":
        val core = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        val driver = file_read("src/compiler/80.driver/driver_bootstrap.spl")
        val owner_start = driver.index_of("pub fn bootstrap_emit_real_llvm_object(")
        val owner_end = driver.index_of("pub fn bootstrap_emit_real_llvm_module_object(")
        val owner = if owner_start >= 0 and owner_end > owner_start: driver.substring(owner_start, owner_end) else: ""

        expect(core.contains("me emit_bootstrap_signatures_statics_and_functions(ir_handle: i64):")).to_equal(true)
        expect(core.contains("self.translate_bootstrap_function_at(function_index, ir_handle)")).to_equal(true)
        expect(owner_start >= 0 and owner_end > owner_start).to_equal(true)
        expect(owner.contains("translator.emit_bootstrap_signatures_statics_and_functions(bootstrap_ir_handle)")).to_equal(true)
        expect(owner.contains("translator.register_bootstrap_signatures()")).to_equal(false)
        expect(owner.contains("translator.emit_bootstrap_statics(bootstrap_ir_handle)")).to_equal(false)
        expect(owner.contains("llvm_bootstrap_string_globals_reset()\n    val detected_arch")).to_equal(true)
        expect(owner.contains("var translator: MirToLlvm = MirToLlvm(\n        builder:")).to_equal(true)
        expect(owner.contains("MirToLlvm.create(\"app.cli.bootstrap_main\"")).to_equal(false)
        expect(owner.contains("log_phase(\"aot:bootstrap_real_llvm:functions\")\n    # Construct the staged receiver only after diagnostics.")).to_equal(true)

    it "does not retain mutable static or string collections on the staged receiver":
        val core = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")
        val helpers = file_read("src/compiler/70.backend/backend/_MirToLlvm/asm_constraints_helpers.spl")

        expect(core.contains("while emitted_index < index:")).to_equal(true)
        expect(core.contains("var emitted_names: Dict<text, bool> = {}")).to_equal(false)
        expect(core.contains("print \"[bootstrap-real-llvm] statics")).to_equal(false)
        expect(helpers.contains("llvm_bootstrap_string_globals_add(decl)\n            # The flat bootstrap emitter consumes")).to_equal(true)
        expect(helpers.contains("return global_name\n        self.string_globals = self.string_globals.push(decl)")).to_equal(true)

    it "keeps runtime names out of local suffix ownership":
        val core = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")

        expect(core.contains("if mir_runtime_owned_call_name(lookup_name):\n            return -1")).to_equal(true)
        expect(core.contains("bootstrap_mir_function_module_at(local_scan) == self.current_bootstrap_module")).to_equal(true)
        expect(core.contains("if basename == lookup_name:")).to_equal(true)

    it "attributes rejected call conversions to their exact owner":
        val core = file_read("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")

        expect(core.contains("unsupported LLVM value conversion from")).to_equal(true)
        expect(core.contains("function=" + "{" + "self.current_function_name} value=" + "{" + "value}")).to_equal(true)
        expect(core.contains("LLVM call argument type mismatch caller=")).to_equal(true)
        expect(core.contains("callee=" + "{" + "call_func_name} instruction=" + "{" + "index} argument=" + "{" + "arg_i}")).to_equal(true)
