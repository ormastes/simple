# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "flat parser transient array scope":
    it "reclaims parse arrays only after owned module conversion starts":
        # @req REQ-SSPEC-COMPILER
        step("reclaims parse arrays only after owned module conversion starts")
        val source = file_read("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")
        # 242cc757860 moved the scope into parse_and_build_module_scoped, routed
        # it through the _sffi_ wrappers, and added graph promotion before the
        # scope ends. The body is bounded to that one function.
        val fn_pos = source.find("pub fn parse_and_build_module_scoped(source: text, path: text, streaming_scope: bool) -> ParserModule:") ?? -1
        val rest = if fn_pos >= 0: source.substring(fn_pos, source.len()) else: ""
        val next_fn = rest.find("\npub fn ", 1) ?? -1
        val body = if next_fn > 0: rest.substring(0, next_fn) else: rest
        val begin_pos = body.find("val transient_scope = if streaming_scope: _sffi_transient_array_scope_begin() else: false") ?? -1
        val parse_pos = body.find("parse_module_body()", begin_pos) ?? -1
        val desugar_pos = body.find("desugar_collections(0, 0)", parse_pos) ?? -1
        val pause_pos = body.find("_sffi_transient_array_scope_pause()", desugar_pos) ?? -1
        val convert_pos = body.find("val built_module = flat_ast_to_module(path)", pause_pos) ?? -1
        val promote_pos = body.find("_sffi_transient_heap_promote(built_module)", convert_pos) ?? -1
        val end_pos = body.find("_sffi_transient_array_scope_end()", promote_pos) ?? -1

        expect(fn_pos).to_be_greater_than(0)
        expect(next_fn).to_be_greater_than(0)
        expect(begin_pos).to_be_greater_than(0)
        expect(parse_pos).to_be_greater_than(begin_pos)
        expect(desugar_pos).to_be_greater_than(parse_pos)
        expect(pause_pos).to_be_greater_than(desugar_pos)
        expect(convert_pos).to_be_greater_than(pause_pos)
        expect(promote_pos).to_be_greater_than(convert_pos)
        expect(end_pos).to_be_greater_than(promote_pos)

    it "does not run the arena rewrite after transient arrays are reclaimed":
        # @req REQ-SSPEC-COMPILER
        step("does not run the arena rewrite after transient arrays are reclaimed")
        val source = file_read("src/compiler/10.frontend/frontend.spl")
        expect(source).to_not_contain("desugar_collections(0, 0)")