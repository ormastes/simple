# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec
use std.io_runtime.{file_read}

describe "backend helper strict shared bindings":
    it "derives compiled output optionals without reassignment":
        # @req REQ-SSPEC-COMPILER
        step("derives compiled output optionals without reassignment")
        val source = file_read("src/compiler/70.backend/backend/backend_helpers.spl")

        expect(source).to_contain("val oc: [u8]? = if output.has_object_code: output.object_code else: nil")
        expect(source).to_contain("val asm_opt: text? = if output.has_text_output: output.text_output else: nil")
        expect(source).to_not_contain("var oc: [u8]? = nil")        expect(source).to_not_contain("var asm_opt: text? = nil")