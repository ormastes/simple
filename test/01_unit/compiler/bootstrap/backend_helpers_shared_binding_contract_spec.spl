# @req: REQ-COMPILER-BOOTSTRAP-001

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "backend helper strict shared bindings":
    it "derives compiled output optionals without reassignment":
        # @req: REQ-COMPILER-BOOTSTRAP-001
        step("Verify: derives compiled output optionals without reassignment")
        val source = file_read("src/compiler/70.backend/backend/backend_helpers.spl")

        expect(source).to_contain("val oc: [u8]? = if output.has_object_code: output.object_code else: nil")
        expect(source).to_contain("val asm_opt: text? = if output.has_text_output: output.text_output else: nil")
        expect(source.contains("var oc: [u8]? = nil")).to_equal(false)
        expect(source.contains("var asm_opt: text? = nil")).to_equal(false)
