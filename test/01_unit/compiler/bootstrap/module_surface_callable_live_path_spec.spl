"""Regression for the live callable surface path used by bootstrap HIR."""

use std.nogc_sync_mut.io.file_ops.{rt_file_read_text}

describe "module surface callable live path":
    it "retains callable payloads in aligned surface storage":
        val types = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/module_surface_types.spl") ?? ""
        expect(types).to_contain("struct ModuleSurfaceCallable:")
        expect(types).to_contain("callable_values: [ModuleSurfaceCallable]")

    it "uses the existing aligned callable payload path":
        val registration = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl") ?? ""
        expect(registration.contains("imported_mod.callables[imported_name]")).to_equal(false)
        expect(registration).to_contain("imported_mod.callable_values[callable_position]")
        expect(registration).to_contain("declared_imported_surface_callable_type(")

    it "does not consume undeclared scalar signature projections":
        val callable_types = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl") ?? ""
        val lowering = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""
        val registration = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl") ?? ""
        val reexport = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl") ?? ""
        expect(callable_types.contains("declared_imported_surface_signature_type")).to_equal(false)
        # main still DEFINES `imported_surface_projected_name_type` (added with
        # 659134f5762 "freeze callable signatures") but no lowering path calls
        # it: declared callable types go through `imported_surface_type_projected`
        # over the callable's own params / return type.
        expect(callable_types.split("imported_surface_projected_name_type").len()).to_equal(2)
        expect(callable_types).to_contain("me imported_surface_projected_name_type(")
        expect(callable_types.contains("self.imported_surface_projected_name_type(")).to_equal(false)
        expect(registration.contains("imported_surface_projected_name_type")).to_equal(false)
        expect(reexport.contains("imported_surface_projected_name_type")).to_equal(false)
        expect(lowering.contains("imported_surface_projected_name_type")).to_equal(false)
        expect(callable_types).to_contain("param_types = param_types.push(self.imported_surface_type_projected(\n                param.type_, param.type_name, param.array_element_name, imported_module_name))")
        expect(callable_types.contains("surface.signature_")).to_equal(false)
        expect(lowering.contains("module_surface_signature_index")).to_equal(false)
