# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "VHDL design-catalog strict shared bindings":
    it "tracks the resolved symbol as a scalar id":
        # @req REQ-SSPEC-COMPILER
        step("tracks the resolved symbol as a scalar id")
        val source = file_read("src/plugins/backend_vhdl/vhdl/vhdl_design_catalog.spl")

        expect(source).to_contain("var found_id = -1")
        expect(source).to_contain("Ok(Some(SymbolId(id: found_id)))")
        expect(source).to_contain("fn vhdl_catalog_mark_type(ty: MirType, mut needed: Dict<i64, bool>):")
        expect(source).to_contain("fn vhdl_catalog_mark_inst_types(inst: MirInst, mut needed: Dict<i64, bool>):")
        expect(source).to_contain("fn vhdl_catalog_type_def_mark_dependencies(type_def: MirTypeDef, mut needed: Dict<i64, bool>):")
        expect(source).to_not_contain("var found: SymbolId? = nil")        expect(source).to_not_contain("needed: mut Dict<i64, bool>")
