extern fn rt_file_read_text(path: text) -> text

use std.spec.*

describe "entry-closure module map update":
    it "retains one whole module and gives surfaces only field slices":
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_source_pipeline_parsing.spl") ?? ""

        expect(driver).to_contain(
            "entry_modules[source.module_name] = entry_module")
        expect(driver).to_contain(
            "val parsed_surface_owner = ModuleSurfaceParserOwner(")
        expect(driver).to_contain(
            "var parsed_entry_surface_owners: [ModuleSurfaceParserOwner] = []")
        expect(driver).to_not_contain("ParsedEntryModuleBox")
        expect(driver).to_not_contain("parsed_box.value")
        expect(driver).to_not_contain(
            "entry_surface_builder.add_parsed(\n                    entry_module")
        expect(driver).to_not_contain(
            "entry_modules = entry_modules.set(source.module_name")

    it "prebuilds owner-backed surfaces on every successful parse branch":
        val driver = rt_file_read_text(
            "src/compiler/80.driver/driver_source_pipeline_parsing.spl") ?? ""
        val entry_start = driver.find(
            "if native_entry_closure or native_entry != \"\":")
        val bootstrap_start = driver.find(
            "if ((rt_env_get(\"SIMPLE_BOOTSTRAP\") ?? \"\") == \"1\"")
        val plain_start = driver.find(
            "var parsed_modules: Dict<text, ParserModule> = self.ctx.modules")
        val parse_source_start = driver.find(
            "fn parse_source(source: SourceFile) -> ParserModule:")
        expect(entry_start).to_be_greater_than(-1)
        expect(bootstrap_start).to_be_greater_than(entry_start)
        expect(plain_start).to_be_greater_than(bootstrap_start)
        expect(parse_source_start).to_be_greater_than(plain_start)

        val entry_branch = driver.substring(entry_start, bootstrap_start)
        val bootstrap_branch = driver.substring(bootstrap_start, plain_start)
        val plain_branch = driver.substring(plain_start, parse_source_start)

        val entry_owner_at = entry_branch.find(
            "val parsed_surface_owner = ModuleSurfaceParserOwner(")
        val entry_retention_at = entry_branch.find(
            "entry_modules[source.module_name] = entry_module")
        val bootstrap_owner_at = bootstrap_branch.find(
            "val entry_owner = ModuleSurfaceParserOwner(")
        val bootstrap_retention_at = bootstrap_branch.find(
            "bootstrap_modules[source.module_name] = entry_module")
        val placeholder_owner_at = bootstrap_branch.find(
            "val placeholder_owner = ModuleSurfaceParserOwner(")
        val placeholder_retention_at = bootstrap_branch.find(
            "bootstrap_modules[source.module_name] = placeholder_module")
        val plain_owner_at = plain_branch.find(
            "val module_owner = ModuleSurfaceParserOwner(")
        val plain_retention_at = plain_branch.find(
            "parsed_modules[source.module_name] = module")
        expect(entry_owner_at).to_be_greater_than(-1)
        expect(entry_retention_at).to_be_greater_than(-1)
        expect(bootstrap_owner_at).to_be_greater_than(-1)
        expect(bootstrap_retention_at).to_be_greater_than(-1)
        expect(placeholder_owner_at).to_be_greater_than(-1)
        expect(placeholder_retention_at).to_be_greater_than(-1)
        expect(plain_owner_at).to_be_greater_than(-1)
        expect(plain_retention_at).to_be_greater_than(-1)
        expect(entry_owner_at).to_be_less_than(entry_retention_at)
        expect(bootstrap_owner_at).to_be_less_than(bootstrap_retention_at)
        expect(placeholder_owner_at).to_be_less_than(placeholder_retention_at)
        expect(plain_owner_at).to_be_less_than(plain_retention_at)

        expect(entry_branch).to_contain(
            "entry_ctx.module_surfaces = Some(entry_surfaces_result.unwrap())")
        expect(bootstrap_branch).to_contain(
            "bootstrap_parse_ctx.module_surfaces = Some(")
        expect(plain_branch).to_contain(
            "parsed_all_ctx.module_surfaces = Some(parsed_surfaces_result.unwrap())")
        expect(entry_branch).to_not_contain("module_surfaces_from_modules")
        expect(bootstrap_branch).to_not_contain("module_surfaces_from_modules")
        expect(plain_branch).to_not_contain("module_surfaces_from_modules")
        expect(driver).to_not_contain(".add_parsed(entry_module")
        expect(driver).to_not_contain(".add_parsed_or_alias(entry_module")
        expect(driver).to_not_contain(".add_parsed_or_alias(placeholder_module")
        expect(driver).to_not_contain(".add_parsed_or_alias(module, source")
