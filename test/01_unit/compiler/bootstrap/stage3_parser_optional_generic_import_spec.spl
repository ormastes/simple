@unsafe(reason: "fixture reads repository source; nil is the unreadable or provider-failure sentinel", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text?

describe "Stage3 parser optional generic owner":
    it "imports the optional generic predicate used by the parser":
        val parser = unsafe(capabilities: [ffi]):
            rt_file_read_text("src/compiler/10.frontend/core/parser.spl") ?? ""
        expect(parser).to_contain("use compiler.core.types.{option_generic_type_register, is_option_generic_tag}")
        expect(parser).to_contain("if is_option_generic_tag(base):")
