# Purpose and audience: executable evidence for MDSOC compiler engineers that the
# numbered layer dependency rules are enforced (layer N can only import layers with number <= N).
# @req REQ-MDSOC-LAYER-ENFORCEMENT-001
# requirements: doc/02_requirements/compiler/mdsoc_matrix_visibility_requirements.md

use std.spec
use std.spec.step

# ============================================================================
# Test Group 1: Layer Number Extraction
# ============================================================================

describe "Layer Number Extraction":
    # ## Extract Layer Numbers
    #
    # Tests extract_layer_number() from numbered directory names.
    # Uses inline parsing since extract_layer_number may not be available
    # in interpreter mode.

    it "extracts 0 from 00.common":
        step("given directory name 00.common when extracting layer number then 0 is returned")
        val dir = "00.common"
        val dot_idx = dir.index_of(".")
        val idx = dot_idx ?? 0
        val prefix = dir.substring(0, idx)
        var num: i64 = 0
        for ch in prefix:
            num = num * 10 + (ch.to_i64() - "0".to_i64())
        expect(num).to_equal(0)

    it "extracts 10 from 10.frontend":
        step("given directory name 10.frontend when extracting layer number then 10 is returned")
        val dir = "10.frontend"
        val dot_idx = dir.index_of(".")
        val idx = dot_idx ?? 0
        val prefix = dir.substring(0, idx)
        var num: i64 = 0
        for ch in prefix:
            num = num * 10 + (ch.to_i64() - "0".to_i64())
        expect(num).to_equal(10)

    it "extracts 50 from 50.mir":
        step("given directory name 50.mir when extracting layer number then 50 is returned")
        val dir = "50.mir"
        val dot_idx = dir.index_of(".")
        val idx = dot_idx ?? 0
        val prefix = dir.substring(0, idx)
        var num: i64 = 0
        for ch in prefix:
            num = num * 10 + (ch.to_i64() - "0".to_i64())
        expect(num).to_equal(50)

    it "extracts 99 from 99.loader":
        step("given directory name 99.loader when extracting layer number then 99 is returned")
        val dir = "99.loader"
        val dot_idx = dir.index_of(".")
        val idx = dot_idx ?? 0
        val prefix = dir.substring(0, idx)
        var num: i64 = 0
        for ch in prefix:
            num = num * 10 + (ch.to_i64() - "0".to_i64())
        expect(num).to_equal(99)

    it "returns -1 for non-numbered directory":
        step("given non-numbered directory name when checking for dot separator then -1 is returned")
        val dir = "backend"
        val dot_idx = dir.index_of(".")
        val idx = dot_idx ?? -1
        expect(idx).to_equal(-1)

    it "returns -1 for invalid prefix":
        step("given directory name with non-digit prefix when validating then all_digits is false")
        val dir = "abc.frontend"
        val dot_idx = dir.index_of(".")
        val idx = dot_idx ?? 0
        val prefix = dir.substring(0, idx)
        var all_digits = true
        for ch in prefix:
            if ch < "0" or ch > "9":
                all_digits = false
        expect(all_digits).to_equal(false)


# ============================================================================
# Test Group 2: Layer Dependency Checking
# ============================================================================

describe "Numbered Layer Dependency Checking":
    # ## check_numbered_layer_dep
    #
    # Tests the layer dependency rule: layer N can import layers <= N.
    # Uses inline logic since check_numbered_layer_dep may not be
    # available in interpreter mode.

    it "allows same-layer imports":
        step("given same layer number when checking rule then import is allowed")
        # Layer 50 -> Layer 50: allowed (50 >= 50)
        val from_layer = 50
        val to_layer = 50
        expect(from_layer >= to_layer).to_equal(true)

    it "allows lower-layer imports":
        step("given higher layer importing lower layer when checking rule then import is allowed")
        # Layer 70 -> Layer 50: allowed (70 >= 50)
        val from_layer = 70
        val to_layer = 50
        expect(from_layer >= to_layer).to_equal(true)

    it "allows importing layer 0 from any layer":
        step("given any layer importing layer 0 when checking rule then import is allowed")
        # Layer 10 -> Layer 0: allowed
        val from_layer = 10
        val to_layer = 0
        expect(from_layer >= to_layer).to_equal(true)

    it "rejects higher-layer imports":
        step("given lower layer importing higher layer when checking rule then import is rejected")
        # Layer 10 -> Layer 50: VIOLATION (10 < 50)
        val from_layer = 10
        val to_layer = 50
        val violation = from_layer < to_layer
        expect(violation).to_equal(true)

    it "rejects lower importing higher":
        step("given lowest layer importing highest layer when checking rule then import is rejected")
        # Layer 00 -> Layer 99: VIOLATION
        val from_layer = 0
        val to_layer = 99
        val violation = from_layer < to_layer
        expect(violation).to_equal(true)

    it "no constraint for non-numbered directories":
        step("given non-numbered source and numbered target when checking rule then no constraint applies")
        # Both have layer -1 (non-numbered)
        val from_layer = -1
        val to_layer = 50
        # Non-numbered dirs have no constraint
        val has_constraint = from_layer >= 0 and to_layer >= 0
        expect(has_constraint).to_equal(false)

    it "no constraint when both non-numbered":
        step("given both non-numbered directories when checking rule then no constraint applies")
        val from_layer = -1
        val to_layer = -1
        val has_constraint = from_layer >= 0 and to_layer >= 0
        expect(has_constraint).to_equal(false)
