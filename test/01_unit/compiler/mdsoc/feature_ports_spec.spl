# Purpose and audience: executable evidence for MDSOC compiler engineers that
# feature stage port structs can be constructed and their fields are accessible.
# @req REQ-MDSOC-FEATURE-PORTS-001
# requirements: doc/02_requirements/compiler/mdsoc_matrix_visibility_requirements.md
# Each struct is imported from its own per-struct file to avoid the runtime
# limitation where only the first struct in each imported module supports
# direct field construction.

use std.spec
use std.spec.step
use compiler.mdsoc.feature.lexing.app.lexer_input_port.{LexerInputPort}
use compiler.mdsoc.feature.lexing.app.lexer_output_port.{LexerOutputPort}
use compiler.mdsoc.feature.parsing.app.parse_error.{ParseError}
use compiler.mdsoc.feature.parsing.app.parser_input_port.{ParserInputPort}
use compiler.mdsoc.feature.parsing.app.parser_output_port.{ParserOutputPort}
use compiler.mdsoc.feature.desugaring.app.desugar_input_port.{DesugarInputPort}
use compiler.mdsoc.feature.desugaring.app.desugar_output_port.{DesugarOutputPort}
use compiler.mdsoc.feature.codegen.app.codegen_input_port.{CodegenInputPort}
use compiler.mdsoc.feature.codegen.app.codegen_output_port.{CodegenOutputPort}
use compiler.mdsoc.feature.monomorphization.app.mono_input_port.{MonomorphizeInputPort}
use compiler.mdsoc.feature.monomorphization.app.mono_output_port.{MonomorphizeOutputPort}
use compiler.mdsoc.feature.optimization.app.optimize_input_port.{OptimizeInputPort}
use compiler.mdsoc.feature.optimization.app.optimize_output_port.{OptimizeOutputPort}
use compiler.mdsoc.feature.linking.app.linker_input_port.{LinkerInputPort}
use compiler.mdsoc.feature.linking.app.linker_output_port.{LinkerOutputPort}
use common.compute.placement_contracts.handles.{ArenaResidency, object_ref}
use common.compute.placement_contracts.semantic.{AnyObject}
use common.structural.identity.entity_id.{entity_ref}

fn feature_port_residency(
    object_slot: u32, entity_count: u64, byte_len: u64
) -> ArenaResidency<AnyObject>:
    ArenaResidency(
        object: object_ref<AnyObject>(object_slot, 1u32),
        entity_count: entity_count,
        byte_len: byte_len
    )

# ============================================================================
# LexerInputPort - from lexing/app/lexer_input_port.spl
# ============================================================================

describe "LexerInputPort":
    it "constructs with source_text":
        step("given source text when constructing LexerInputPort then source_text field is accessible")
        val port = LexerInputPort(source_text: "val x = 1")
        expect(port.source_text).to_equal("val x = 1")

    it "constructs with empty source":
        step("given empty source text when constructing LexerInputPort then empty source is handled")
        val port = LexerInputPort(source_text: "")
        expect(port.source_text).to_equal("")

    it "constructs with multiline source":
        step("given multiline source text when constructing LexerInputPort then multiline source is accessible")
        val port = LexerInputPort(source_text: "fn foo():\n    1")
        expect(port.source_text).to_start_with("fn foo")

# ============================================================================
# LexerOutputPort - from lexing/app/lexer_output_port.spl
# ============================================================================

describe "LexerOutputPort":
    it "constructs with token data":
        step("given token arrays when constructing LexerOutputPort then token_count is accessible")
        val port = LexerOutputPort(
            token_tags: [1, 2, 3],
            token_texts: ["val", "x", "="],
            token_lines: [1, 1, 1],
            token_cols: [1, 5, 7],
            token_count: 3
        )
        expect(port.token_count).to_equal(3)

    it "constructs with empty token arrays":
        step("given empty token arrays when constructing LexerOutputPort then empty state is handled")
        val port = LexerOutputPort(
            token_tags: [],
            token_texts: [],
            token_lines: [],
            token_cols: [],
            token_count: 0
        )
        expect(port.token_count).to_equal(0)

# ============================================================================
# ParseError - from parsing/app/parse_error.spl
# ============================================================================

describe "ParseError":
    it "constructs with message and location":
        step("given error message and location when constructing ParseError then message and location are accessible")
        val err = ParseError(message: "unexpected token", line: 5, col: 12)
        expect(err.message).to_equal("unexpected token")
        expect(err.line).to_equal(5)
        expect(err.col).to_equal(12)

    it "stores zero location for start of file":
        step("given start of file location when constructing ParseError then location 1,1 is stored")
        val err = ParseError(message: "syntax error", line: 1, col: 1)
        expect(err.line).to_equal(1)
        expect(err.col).to_equal(1)

    it "stores large line numbers":
        step("given large line number when constructing ParseError then line number is stored")
        val err = ParseError(message: "eof", line: 9999, col: 80)
        expect(err.line).to_equal(9999)

# ============================================================================
# ParserInputPort - from parsing/app/parser_input_port.spl
# ============================================================================

describe "ParserInputPort":
    it "constructs with token stream data":
        step("given token stream data when constructing ParserInputPort then token_count is accessible")
        val port = ParserInputPort(
            token_tags: [1, 2],
            token_texts: ["val", "x"],
            token_lines: [1, 1],
            token_cols: [1, 5],
            token_count: 2,
            source_text: "val x",
            token_residency: feature_port_residency(1u32, 2u64, 32u64)
        )
        expect(port.token_count).to_equal(2)

# ============================================================================
# ParserOutputPort - from parsing/app/parser_output_port.spl
# ============================================================================

describe "ParserOutputPort":
    it "constructs empty output":
        step("given empty parser output when constructing ParserOutputPort then error_count is zero")
        val port = ParserOutputPort(
            expr_count: 0,
            stmt_count: 0,
            decl_count: 0,
            root_decls: [],
            errors: [],
            error_count: 0,
            syntax_residency: feature_port_residency(2u32, 0u64, 0u64)
        )
        expect(port.error_count).to_equal(0)

    it "constructs output with counts":
        step("given parser counts when constructing ParserOutputPort then all counts are accessible")
        val port = ParserOutputPort(
            expr_count: 10,
            stmt_count: 5,
            decl_count: 3,
            root_decls: [entity_ref(2u32, 0u32), entity_ref(2u32, 1u32), entity_ref(2u32, 2u32)],
            errors: [],
            error_count: 0,
            syntax_residency: feature_port_residency(2u32, 3u64, 96u64)
        )
        expect(port.expr_count).to_equal(10)
        expect(port.stmt_count).to_equal(5)
        expect(port.decl_count).to_equal(3)

# ============================================================================
# DesugarInputPort - from desugaring/app/desugar_input_port.spl
# ============================================================================

describe "DesugarInputPort":
    it "constructs with source and module name":
        step("given source and module name when constructing DesugarInputPort then module_name is accessible")
        val port = DesugarInputPort(source_text: "fn foo(): 1", module_name: "test")
        expect(port.module_name).to_equal("test")
        expect(port.source_text).to_equal("fn foo(): 1")

    it "holds the module name":
        step("given module name when constructing DesugarInputPort then module_name is preserved")
        val port = DesugarInputPort(source_text: "", module_name: "my_module")
        expect(port.module_name).to_equal("my_module")

# ============================================================================
# DesugarOutputPort - from desugaring/app/desugar_output_port.spl
# ============================================================================

describe "DesugarOutputPort":
    it "constructs with desugared source":
        step("given desugared source when constructing DesugarOutputPort then pass_count is accessible")
        val port = DesugarOutputPort(
            desugared_source: "fn foo(): 1",
            injected_fn_names: [],
            pass_count: 5
        )
        expect(port.pass_count).to_equal(5)

    it "constructs with injected function names":
        step("given injected function names when constructing DesugarOutputPort then pass_count is preserved")
        val port = DesugarOutputPort(
            desugared_source: "fn foo(): 1\nfn __foo_impl(): 1",
            injected_fn_names: ["__foo_impl"],
            pass_count: 5
        )
        expect(port.pass_count).to_equal(5)

# ============================================================================
# CodegenInputPort - from codegen/app/codegen_input_port.spl
# ============================================================================

describe "CodegenInputPort":
    it "constructs with function counts":
        step("given function counts when constructing CodegenInputPort then counts are accessible")
        val port = CodegenInputPort(
            function_count: 3,
            extern_fn_count: 1,
            string_literal_count: 2
        )
        expect(port.function_count).to_equal(3)
        expect(port.extern_fn_count).to_equal(1)
        expect(port.string_literal_count).to_equal(2)

    it "constructs with zero counts":
        step("given zero counts when constructing CodegenInputPort then zero state is handled")
        val port = CodegenInputPort(
            function_count: 0,
            extern_fn_count: 0,
            string_literal_count: 0
        )
        expect(port.function_count).to_equal(0)

# ============================================================================
# CodegenOutputPort - from codegen/app/codegen_output_port.spl
# ============================================================================

describe "CodegenOutputPort":
    it "reports success":
        step("given success flag when constructing CodegenOutputPort then success and target_triple are accessible")
        val port = CodegenOutputPort(
            object_byte_count: 1024,
            symbol_count: 5,
            target_triple: "x86_64-linux-gnu",
            success: true
        )
        expect(port.success).to_equal(true)
        expect(port.target_triple).to_equal("x86_64-linux-gnu")

    it "reports failure":
        step("given failure flag when constructing CodegenOutputPort then success is false")
        val port = CodegenOutputPort(
            object_byte_count: 0,
            symbol_count: 0,
            target_triple: "x86_64-linux-gnu",
            success: false
        )
        expect(port.success).to_equal(false)

    it "stores object byte count":
        step("given object byte count when constructing CodegenOutputPort then byte count and symbol count are stored")
        val port = CodegenOutputPort(
            object_byte_count: 4096,
            symbol_count: 10,
            target_triple: "aarch64-linux-gnu",
            success: true
        )
        expect(port.object_byte_count).to_equal(4096)
        expect(port.symbol_count).to_equal(10)

# ============================================================================
# MonomorphizeInputPort - from monomorphization/app/mono_input_port.spl
# ============================================================================

describe "MonomorphizeInputPort":
    it "constructs with generic function count":
        step("given generic function count when constructing MonomorphizeInputPort then counts are accessible")
        val port = MonomorphizeInputPort(
            typed_decl_count: 10,
            generic_fn_count: 3,
            has_generics: true
        )
        expect(port.typed_decl_count).to_equal(10)
        expect(port.generic_fn_count).to_equal(3)
        expect(port.has_generics).to_equal(true)

    it "constructs with no generics":
        step("given no generics when constructing MonomorphizeInputPort then has_generics is false")
        val port = MonomorphizeInputPort(
            typed_decl_count: 5,
            generic_fn_count: 0,
            has_generics: false
        )
        expect(port.generic_fn_count).to_equal(0)
        expect(port.has_generics).to_equal(false)

    it "stores typed declaration count":
        step("given typed declaration count when constructing MonomorphizeInputPort then count is stored")
        val port = MonomorphizeInputPort(
            typed_decl_count: 42,
            generic_fn_count: 7,
            has_generics: true
        )
        expect(port.typed_decl_count).to_equal(42)

# ============================================================================
# MonomorphizeOutputPort - from monomorphization/app/mono_output_port.spl
# ============================================================================

describe "MonomorphizeOutputPort":
    it "constructs with specialization counts":
        step("given specialization counts when constructing MonomorphizeOutputPort then counts are accessible")
        val port = MonomorphizeOutputPort(
            mono_decl_count: 15,
            specialized_count: 6
        )
        expect(port.mono_decl_count).to_equal(15)
        expect(port.specialized_count).to_equal(6)

    it "constructs with zero specializations":
        step("given zero specializations when constructing MonomorphizeOutputPort then specialized_count is zero")
        val port = MonomorphizeOutputPort(
            mono_decl_count: 5,
            specialized_count: 0
        )
        expect(port.specialized_count).to_equal(0)

# ============================================================================
# OptimizeInputPort - from optimization/app/optimize_input_port.spl
# ============================================================================

describe "OptimizeInputPort":
    it "constructs with basic optimization level":
        step("given basic optimization level when constructing OptimizeInputPort then all counts are accessible")
        val port = OptimizeInputPort(
            mir_fn_count: 8,
            mir_inst_count: 120,
            optimization_level: 1
        )
        expect(port.mir_fn_count).to_equal(8)
        expect(port.mir_inst_count).to_equal(120)
        expect(port.optimization_level).to_equal(1)

    it "constructs with no optimization":
        step("given zero optimization level when constructing OptimizeInputPort then level is zero")
        val port = OptimizeInputPort(
            mir_fn_count: 3,
            mir_inst_count: 40,
            optimization_level: 0
        )
        expect(port.optimization_level).to_equal(0)

    it "constructs with aggressive optimization":
        step("given aggressive optimization level when constructing OptimizeInputPort then counts and level are accessible")
        val port = OptimizeInputPort(
            mir_fn_count: 20,
            mir_inst_count: 500,
            optimization_level: 3
        )
        expect(port.optimization_level).to_equal(3)
        expect(port.mir_fn_count).to_equal(20)

# ============================================================================
# OptimizeOutputPort - from optimization/app/optimize_output_port.spl
# ============================================================================

describe "OptimizeOutputPort":
    it "constructs with eliminated instruction count":
        step("given eliminated instruction count when constructing OptimizeOutputPort then all counts are accessible")
        val port = OptimizeOutputPort(
            mir_fn_count: 8,
            mir_inst_count: 90,
            eliminated_count: 30
        )
        expect(port.mir_fn_count).to_equal(8)
        expect(port.mir_inst_count).to_equal(90)
        expect(port.eliminated_count).to_equal(30)

    it "constructs with no eliminated instructions":
        step("given no eliminated instructions when constructing OptimizeOutputPort then eliminated_count is zero")
        val port = OptimizeOutputPort(
            mir_fn_count: 3,
            mir_inst_count: 40,
            eliminated_count: 0
        )
        expect(port.eliminated_count).to_equal(0)

# ============================================================================
# LinkerInputPort - from linking/app/linker_input_port.spl
# ============================================================================

describe "LinkerInputPort":
    it "constructs for executable output":
        step("given executable output type when constructing LinkerInputPort then all fields are accessible")
        val port = LinkerInputPort(
            object_file_count: 3,
            library_count: 2,
            output_type: "exe",
            output_path: "/tmp/out",
            input_residency: feature_port_residency(3u32, 5u64, 4096u64)
        )
        expect(port.object_file_count).to_equal(3)
        expect(port.library_count).to_equal(2)
        expect(port.output_type).to_equal("exe")
        expect(port.output_path).to_equal("/tmp/out")

    it "constructs for library output":
        step("given library output type when constructing LinkerInputPort then output_type is accessible")
        val port = LinkerInputPort(
            object_file_count: 1,
            library_count: 0,
            output_type: "lib",
            output_path: "/tmp/libfoo.a",
            input_residency: feature_port_residency(3u32, 1u64, 1024u64)
        )
        expect(port.output_type).to_equal("lib")

    it "constructs for smf output":
        step("given smf output type when constructing LinkerInputPort then type and counts are accessible")
        val port = LinkerInputPort(
            object_file_count: 2,
            library_count: 1,
            output_type: "smf",
            output_path: "/tmp/mod.smf",
            input_residency: feature_port_residency(3u32, 3u64, 2048u64)
        )
        expect(port.output_type).to_equal("smf")
        expect(port.object_file_count).to_equal(2)

# ============================================================================
# LinkerOutputPort - from linking/app/linker_output_port.spl
# ============================================================================

describe "LinkerOutputPort":
    it "constructs successful link result":
        step("given successful link when constructing LinkerOutputPort then output path and size are accessible")
        val port = LinkerOutputPort(
            output_path: "/tmp/out",
            output_size_bytes: 65536,
            success: true,
            error_message: "",
            output_residency: feature_port_residency(4u32, 1u64, 65536u64)
        )
        expect(port.output_path).to_equal("/tmp/out")
        expect(port.output_size_bytes).to_equal(65536)
        expect(port.success).to_equal(true)

    it "constructs failed link result":
        step("given failed link when constructing LinkerOutputPort then success is false and error message is stored")
        val port = LinkerOutputPort(
            output_path: "",
            output_size_bytes: 0,
            success: false,
            error_message: "undefined symbol: main",
            output_residency: feature_port_residency(4u32, 0u64, 0u64)
        )
        expect(port.success).to_equal(false)
        expect(port.error_message).to_equal("undefined symbol: main")
