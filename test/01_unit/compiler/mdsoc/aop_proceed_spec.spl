"""
## Purpose and audience
Purpose: Prove that Aop Proceed.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-MDSOC-001 — stable requirement identity for this spec.

use std.spec
use compiler.tools.aop_proceed_minimal.{create_proceed_context_minimal}

describe "Aop Proceed":
    it "starts with zero proceed calls":
        step("Verify: starts with zero proceed calls")
        # @req: REQ-COMPILER-MDSOC-001
        val ctx = create_proceed_context_minimal("trace_around")
        expect(ctx.was_called()).to_equal(false)
        expect(ctx.call_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(ctx.has_error).to_equal(false)

    it "records a single proceed call and verifies successfully":
        step("Verify: records a single proceed call and verifies successfully")
        val ctx = create_proceed_context_minimal("trace_around")
        ctx.mark_proceed_called()
        expect(ctx.was_called()).to_equal(true)
        expect(ctx.call_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        val result = ctx.verify()
        expect(result.is_ok()).to_equal(true)

    it "fails verification when proceed is never called":
        step("Verify: fails verification when proceed is never called")
        val ctx = create_proceed_context_minimal("trace_around")
        val result = ctx.verify()

        expect(result.is_err()).to_equal(true)
        val err_val = result.err.unwrap()
        val err_msg = err_val.format()
        expect(err_msg).to_equal(
            "Around advice 'trace_around' must call proceed() exactly once (called 0 times)"
        )

    it "fails verification when proceed is called multiple times":
        step("Verify: fails verification when proceed is called multiple times")
        val ctx = create_proceed_context_minimal("trace_around")
        ctx.mark_proceed_called()
        ctx.mark_proceed_called()
        ctx.mark_proceed_called()

        val result = ctx.verify()
        expect(result.is_err()).to_equal(true)
        expect(ctx.call_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val err_val = result.err.unwrap()
        val err_msg = err_val.format()
        expect(err_msg).to_equal(
            "Around advice 'trace_around' must call proceed() exactly once (called 3 times)"
        )
