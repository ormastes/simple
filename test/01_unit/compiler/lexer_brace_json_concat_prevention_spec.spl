# Prevention for doc/08_tracking/bug/string_literal_nested_json_drops_closing_brace_silently_2026-11-12.md
# Nested JSON closers in test fixtures are appended one at a time from a
# constant so no `}}` ever appears inside a literal; the result must parse
# strictly and serialize back to the intended bytes.
use std.spec
use std.spec.step
use std.common.string_core.{str_len}
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_field}

val CLOSE = "}"

describe "nested JSON built by closer concatenation":
    it "parses strictly and keeps every closing brace":
        step("build a two-level nested params/arguments/path object with one closer per append")
        val wire = "{\"params\":{\"arguments\":{\"path\":\"a.spl\"}" + CLOSE + CLOSE
        expect(str_len(wire)).to_equal(41)
        val parsed = json_parse_value_strict(wire).unwrap()
        val path = json_value_field(json_value_field(json_value_field(parsed, "params"), "arguments"), "path")
        expect(path).to_equal(JsonValue.Str("a.spl"))

    it "builds an empty nested object without relying on a literal }}":
        step("append the inner and outer closers separately")
        val wire = "{\"params\":{" + CLOSE + CLOSE
        expect(str_len(wire)).to_equal(13)
        expect(json_parse_value_strict(wire).is_ok()).to_equal(true)
