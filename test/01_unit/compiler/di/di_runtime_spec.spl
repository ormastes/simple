# DI Runtime Specification
#
# Tests for the lazy DI runtime engine: factory registration,
# singleton caching, cascade forcing, and cycle detection.
#
# Restored 2026-11-28 from a placeholder stub. The original body predated the
# current API: factories now return `DiToolHandler?` (not arbitrary values),
# a missing/cyclic service resolves to `None` (not nil), and closures capture
# by value, so call counting uses di_force_count() instead of mutating a
# captured local.

use compiler.common.di_runtime.{DiToolHandler, di_register, di_resolve, di_reset, di_stats, di_is_registered, di_force_count, di_service_names}

fn _handler(tag: text) -> DiToolHandler?:
    Some(DiToolHandler(handle_fn: fn(tool: text, id: text, body: text): tag))

fn _call(resolved: DiToolHandler?) -> text:
    match resolved:
        case Some(h): h.handle_fn("tool", "1", "")
        case None: "<none>"

describe "DI Runtime":

    describe "registration and resolution":
        it "registers and resolves an eager service":
            di_reset()
            di_register("svc_a", fn(): _handler("hello_a"), false)
            expect(_call(di_resolve("svc_a"))).to_equal("hello_a")

        it "registers and resolves a lazy service":
            di_reset()
            di_register("svc_b", fn(): _handler("hello_b"), true)
            expect(_call(di_resolve("svc_b"))).to_equal("hello_b")

        it "reports registered services":
            di_reset()
            di_register("svc_c", fn(): _handler("c"), false)
            expect(di_is_registered("svc_c")).to_equal(true)
            expect(di_is_registered("nonexistent")).to_equal(false)

    describe "singleton caching":
        it "runs a lazy factory once across repeated resolves":
            di_reset()
            di_register("cached", fn(): _handler("instance"), true)
            expect(di_force_count()).to_equal(0)
            val first = _call(di_resolve("cached"))
            val second = _call(di_resolve("cached"))
            expect(first).to_equal(second)
            expect(di_force_count()).to_equal(1)

        it "eager services are instantiated at registration":
            di_reset()
            di_register("eager_svc", fn(): _handler("eager_val"), false)
            # Cached at registration: resolving forces nothing.
            expect(_call(di_resolve("eager_svc"))).to_equal("eager_val")
            expect(di_force_count()).to_equal(0)

    describe "cascade forcing":
        it "forces transitive dependencies":
            di_reset()
            di_register("dep_c", fn(): _handler("leaf_value"), true)
            di_register("dep_b", fn(): _handler("b_uses_{_call(di_resolve("dep_c"))}"), true)
            di_register("dep_a", fn(): _handler("a_uses_{_call(di_resolve("dep_b"))}"), true)
            expect(_call(di_resolve("dep_a"))).to_equal("a_uses_b_uses_leaf_value")
            expect(di_force_count()).to_equal(3)

    describe "cycle detection":
        it "detects circular dependencies":
            di_reset()
            di_register("cycle_a", fn(): di_resolve("cycle_b"), true)
            di_register("cycle_b", fn(): di_resolve("cycle_a"), true)
            # Re-entry is reported and resolves to None instead of looping.
            expect(_call(di_resolve("cycle_a"))).to_equal("<none>")

    describe "reset":
        it "clears all registered services":
            di_reset()
            di_register("temp", fn(): _handler("temp_val"), false)
            expect(di_is_registered("temp")).to_equal(true)
            di_reset()
            expect(di_is_registered("temp")).to_equal(false)

        it "resets force count":
            di_reset()
            di_register("lazy_svc", fn(): _handler("val"), true)
            di_resolve("lazy_svc")
            expect(di_force_count() > 0).to_equal(true)
            di_reset()
            expect(di_force_count()).to_equal(0)

    describe "stats":
        it "returns diagnostic info":
            di_reset()
            di_register("s1", fn(): _handler("v1"), true)
            di_register("s2", fn(): _handler("v2"), false)
            val info = di_stats()
            expect(info.contains("2 registered")).to_equal(true)
            expect(info.contains("1 lazy")).to_equal(true)
            expect(info.contains("1 eager")).to_equal(true)

    describe "service_names":
        it "lists registered service names":
            di_reset()
            di_register("alpha", fn(): _handler("1"), true)
            di_register("beta", fn(): _handler("2"), false)
            expect(di_service_names()).to_equal(["alpha", "beta"])

    describe "missing service":
        it "returns None for unregistered service":
            di_reset()
            expect(_call(di_resolve("nonexistent"))).to_equal("<none>")
