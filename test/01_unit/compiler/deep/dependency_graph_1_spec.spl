# @req: REQ-COMPILER-DEEP-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/deep/dependency_graph_1_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-CMP-COMPILER_ANALYSIS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/compiler_analysis_behavior.md
# doc-path: doc/03_plan/sys_test/compiler_analysis_behavior.md
# doc-path: doc/04_architecture/lib/compiler_analysis.md
# doc-path: doc/05_design/lib/compiler_analysis_oracles.md
# @manual: primary

use std.spec
use compiler.35.semantics.lint.semantic_api.alias_registry.{alias_registry_clear, alias_registry_resolve}
use std.spec.step

# doc-path: doc/01_research/local/dependency_graph_1.md
# doc-path: doc/03_plan/sys_test/dependency_graph_1.md
# doc-path: doc/04_architecture/dependency_graph_1.md
# doc-path: doc/05_design/dependency_graph_1.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-COMPILER-DEEP-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])

    it "dict literal access":
        step("Verify: dict literal access")
        # @req: REQ-COMPILER-DEEP-001
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

    it "boolean operators short-circuit to expected truth table":
        step("Verify: boolean operators short-circuit to expected truth table")
        # @req: REQ-COMPILER-DEEP-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not true).to_equal(false)

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "chained comparison yields a boolean":
        step("Verify: chained comparison yields a boolean")
        # @req: REQ-COMPILER-DEEP-001
        expect(1 < 2).to_equal(true)
        expect(2 <= 2).to_equal(true)
        expect(3 != 3).to_equal(false)

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-COMPILER-DEEP-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-COMPILER-DEEP-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign
