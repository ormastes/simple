extern fn rt_file_read_text(path: text) -> text

describe("module loader concrete return contracts"):
    it("imports the SMF symbol type from its concrete owner"):
        val source = rt_file_read_text("src/compiler/loader/module_loader.spl") ?? ""
        expect(source.contains("use compiler.backend.linker.obj_taker.{SmfSymbol, SymbolType}")).to_equal(true)

    it("types optional symbol and module lookups explicitly"):
        val source = rt_file_read_text("src/compiler/loader/module_loader.spl") ?? ""
        expect(source.contains("fn get_symbol(name: text) -> Option<LoadedSymbol>:")).to_equal(true)
        expect(source.contains("fn get_module(path: text) -> Option<LoadedModule>:")).to_equal(true)
