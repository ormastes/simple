# @req REQ-PHASE1-NEGATIVE-CONTAINMENT-CONSUMERS
# @workaround bug=BUG-PHASE1-BDD-NEGATED-MATCHERS-20261011 reason=direct grammar regression remains unchanged.
extern fn rt_file_read_text(path: text) -> text

describe "negative containment consumer predicate":
    it "reads the retained direct grammar regression and distinguishes present text":
        val source = rt_file_read_text("test/01_unit/compiler/bdd_negated_matcher_chain_lowering_spec.spl")
        expect(source.len()).to_be_greater_than(0)
        expect(source.contains("expect(s).not.to_contain(\"zzz\")")).to_equal(true)
        expect(source.contains("BUG-PHASE1-IMPOSSIBLE-CONSUMER-SENTINEL")).to_equal(false)
