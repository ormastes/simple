# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/compiler/parser/gpu_frontend_offload_switch_gap_2026-09-05.md ; design: doc/05_design/compiler/frontend/gpu_frontend_offload_switch_design.md

"""
# Parser: `auto` is an ordinary name in named-argument position

**Category:** Syntax / Seed parser keyword hygiene
**Bug:** doc/08_tracking/bug/auto_keyword_rejected_as_named_argument_label_2026-09-05.md

## Overview

`auto` lexes as a hard keyword (`TokenKind::Auto`, for `auto` modules). A
struct field named `auto` declared, read, and constructed positionally, but the
named-argument form `P(auto: true)` failed with "expected Comma, found Colon".
The named-argument parser now accepts `auto` as a label, exactly like
`examples`, `and_then`, and `grid`.

A parse error means this file will not load, so the constructions below are
themselves the grammar coverage; the `it` blocks assert the values round-trip.
Requires a seed built at or after the fix; an older binary still reports the
Colon error.

## Syntax

```simple
val p = P(auto: true, n: 1)   # keyword token as a named-arg label
print(p.auto)
```
"""

use std.spec.*

struct P:
    auto: bool
    n: i64

fn make(auto: bool) -> P:
    P(auto: auto, n: 7)

describe "auto as a named-argument label":
    it "constructs a struct with auto as a named argument":
        step("Construct with the keyword-named field")
        val p = P(auto: true, n: 1)
        expect(p.auto).to_equal(true)
        expect(p.n).to_equal(1)

    it "passes auto through a function whose parameter is also named auto":
        step("Forward the label through a helper")
        val p = make(false)
        expect(p.auto).to_equal(false)
        expect(p.n).to_equal(7)

    it "round-trips auto through a second named-argument construction":
        step("Read the field back after a normal construction")
        val p = P(auto: true, n: 2)
        val flipped = P(auto: not p.auto, n: p.n + 1)
        expect(flipped.auto).to_equal(false)
        expect(flipped.n).to_equal(3)
