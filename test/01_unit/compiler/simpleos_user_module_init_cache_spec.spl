# Content identity for durable SimpleOS userspace initializer objects.
use testing.{describe, it, expect}
use compiler.backend.backend.simpleos_native_linkers.{simpleos_x86_64_user_module_init_cache_key}

describe "SimpleOS userspace module initializer cache identity":
    it "reuses the same generated source and compiler inputs":
        val first = simpleos_x86_64_user_module_init_cache_key("void init(void) {}", "clang", "clang 23", 2)
        val second = simpleos_x86_64_user_module_init_cache_key("void init(void) {}", "clang", "clang 23", 2)
        expect(first).to_equal(second)
        expect(first.len()).to_equal(64)

    it "invalidates changed initializer source, compiler, version, and optimization":
        val original = simpleos_x86_64_user_module_init_cache_key("void init(void) {}", "clang", "clang 23", 2)
        expect(simpleos_x86_64_user_module_init_cache_key("void init(void) { module_init(); }", "clang", "clang 23", 2) == original).to_equal(false)
        expect(simpleos_x86_64_user_module_init_cache_key("void init(void) {}", "/other/clang", "clang 23", 2) == original).to_equal(false)
        expect(simpleos_x86_64_user_module_init_cache_key("void init(void) {}", "clang", "clang 24", 2) == original).to_equal(false)
        expect(simpleos_x86_64_user_module_init_cache_key("void init(void) {}", "clang", "clang 23", 0) == original).to_equal(false)
