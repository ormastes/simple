# @cover src/lib/common/structural/storage_layout/storage_layout_contracts.spl
"""
## Purpose and audience
Census of the existing names the data-attribute plan builds on: the frozen
storage layout vocabulary, the `@collection_algorithm` values, the deferred
AOP field selectors, the frozen trace event kinds and the accepted `.sprof`
schema versions. Readers are anyone changing one of those owners; this spec is
GREEN today and goes RED on drift, so the change updates the plan in the same PR.
Plan: doc/03_plan/compiler/data/data_attributes_layout_containers_xray_2026-11-06.md
(W0, section 17.3). Category: Infrastructure.
## Operator workflow
bin/simple test test/01_unit/compiler/data/data_authority_census_spec.spl
## Compatibility and limitations
Characterization only: it asserts current behavior and adds none. The
`@collection_algorithm` values are checked through the real statement parser.
## Verification guidance and troubleshooting
A RED here is expected exactly when an owner renames or extends one of these
names; update the plan section that relies on it, then this census.
"""
# Lifecycle: doc/03_plan/compiler/data/data_attributes_layout_containers_xray_2026-11-06.md ;
# doc/03_plan/compiler/data/adaptive_collections_c0_census_2026-11-06.md
# @manual_section: Data authority census

use std.spec.*
use std.common.structural.storage_layout.storage_layout_contracts.*
use std.common.trace.observer_contract_v1.{TraceEventKindV1, trace_event_kind_code_v1}
use std.common.trace.observer_event_codec_v1.{trace_event_kind_from_code_v1}
use compiler.core.parser.{parser_init, parser_has_errors}
use compiler.core.parser_stmts.{parse_statement}
use compiler.frontend.core.aop_predicate_parser.{validate_predicate}
use app.optimize.sprof_loader.{sprof_load_profile_text}

describe "Data authority census":
    it "pins the current layout, collection, selector and trace names this plan builds on":
        # @req REQ-W0-01
        step("Read the storage layout vocabulary and the trace event kind table")
        val layout_count = STORAGE_LAYOUT_KIND_COUNT
        val last_code = trace_event_kind_code_v1(TraceEventKindV1.Completion)
        val kind_eleven = trace_event_kind_from_code_v1(11)
        step("Validate the deferred field selectors")
        val get_sel = validate_predicate("get(field)")
        val set_sel = validate_predicate("set(field)")
        step("Parse @collection_algorithm with each documented value and one unknown value")
        var accepted: [text] = []
        for name in ["auto", "linear", "hash", "ordered", "swiss"]:
            parser_init("@collection_algorithm(\"" + name + "\")\nvar chosen = AdaptiveTextSet.new()")
            parse_statement()
            if not parser_has_errors():
                accepted.push(name)
        step("Load a sprof-v2 header through the profile loader")
        val loaded = sprof_load_profile_text("header;schema=sprof-v2;module=m;workload=w", "m", "w")
        # @capture(exec): census values
        step("Verify every pinned name is unchanged")
        expect(layout_count).to_equal(8)  # oracle: StorageLayoutKind AoS..ExternalFixed
        val kinds = [storage_layout_kind_to_u8(StorageLayoutKind.AoS), storage_layout_kind_to_u8(StorageLayoutKind.SoA),
            storage_layout_kind_to_u8(StorageLayoutKind.AoSoA), storage_layout_kind_to_u8(StorageLayoutKind.Grouped),
            storage_layout_kind_to_u8(StorageLayoutKind.Tiled), storage_layout_kind_to_u8(StorageLayoutKind.Packed),
            storage_layout_kind_to_u8(StorageLayoutKind.FactoredIndex), storage_layout_kind_to_u8(StorageLayoutKind.ExternalFixed)]
        for i in 0..8:
            expect(kinds[i]).to_equal(i)  # oracle: frozen V1 ordinals 0..7 in declaration order
        expect(storage_layout_kind_valid(8)).to_equal(false)
        expect(last_code).to_equal(10)  # oracle: Completion is the last frozen V1 kind
        expect(kind_eleven.is_err()).to_equal(true)
        expect(get_sel).to_start_with("E1507")
        expect(set_sel).to_start_with("E1507")
        expect(accepted.len()).to_equal(4)  # oracle: auto, linear, hash, ordered
        expect(accepted[3]).to_equal("ordered")
        expect(loaded.schema_version).to_equal("sprof-v2")
        expect(loaded.diagnostic_count).to_equal(0)  # oracle: sprof-v2 is a compatible schema

    it "rejects a trace event kind outside the frozen V1 range":
        # @req REQ-W0-01
        step("Decode the kind codes just outside the frozen V1 range")
        # @capture(exec): decode outcomes
        step("Verify neither boundary is accepted as a kind")
        expect(trace_event_kind_from_code_v1(0).is_err()).to_equal(true)
        expect(trace_event_kind_from_code_v1(11).is_err()).to_equal(true)
