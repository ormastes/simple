use std.spec

# doc-path: doc/01_research/local/test_mir_parse.md
# doc-path: doc/03_plan/sys_test/test_mir_parse.md
# doc-path: doc/04_architecture/test_mir_parse.md
# doc-path: doc/05_design/test_mir_parse.md

# @manual: primary

class SpirvBuilder:
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-COMPILER-COMPILER-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-COMPILER-COMPILER-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right


use std.spec.step

use compiler.core.parser.{parse_module, parser_has_errors, parser_get_errors}
use std.io_runtime.{file_read}

describe "parse test":
    # @manual scenario evidence
    it "loads":
        # @req REQ-SSPEC-COMPILER
        step("parse this very file (class + Dict generics) through the real parser")
        val source = file_read("test/01_unit/compiler/test_mir_parse_spec.spl")
        parse_module(source, "test_mir_parse_spec.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)

    it "reports errors for a syntactically broken module":
        # @req REQ-SSPEC-COMPILER
        step("parse a broken fixture, assert the parser reports it")
        parse_module("fn broken( <<< !!\n", "broken_fixture.spl")
        expect(parser_has_errors()).to_equal(true)
