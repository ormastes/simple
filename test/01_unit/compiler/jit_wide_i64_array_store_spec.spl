"""
## Purpose and audience

Executable evidence that storing full-width i64 values into a statically typed
`[i64]` array neither leaks nor corrupts. Written for the compiler and runtime
engineers who own array lowering and the packed array layouts, and for
reviewers deciding whether an array change may land.

## Operator workflow

Run this spec. Each scenario spawns `jit_wide_i64_array_store_jit_probe.spl`
-- a runnable program -- under a NAMED engine and scores its verdict line; the
memory scenario also measures the JIT run's peak RSS from outside with
`/usr/bin/time`.

## Compatibility and limitations

A spec body cannot run under the JIT (see `std.spec.engine_probe`), hence the
out-of-process probe. The RSS bound is the probe's peak minus an empty JIT
program's peak, set between the fixed build and the leaking one; it is a guard
against the ~48 B/store box leak, not a precise allocator measurement.

Bug: doc/08_tracking/bug/jit_array_store_wide_i64_leak_2026-10-20.md
Pattern: doc/07_guide/infra/testing/spec_engine_reach.md

## Verification guidance and troubleshooting

If the JIT verdict fails, read the `PROBE FAIL` lines in the probe output. If
only the RSS scenario fails, a wide store is heap-boxing again: check that the
`[i64]` index-set/get/push lowering still routes through
`rt_typed_words_i64_*` and that those still pack the array in place.
"""
# Lifecycle: research: doc/08_tracking/bug/jit_array_store_wide_i64_leak_2026-10-20.md ; plan: doc/08_tracking/bug/jit_array_store_wide_i64_leak_2026-10-20.md ; architecture: doc/04_architecture/compiler/misc/file_class_structure.md ; design: doc/08_tracking/bug/jit_array_store_wide_i64_leak_2026-10-20.md
# @cover src/compiler_rust/runtime/src/value/collections.rs
# @manual_section: wide i64 array store

use std.spec.step

use std.spec
use std.spec.engine_probe.{engine_stdout, engine_max_rss_kb}

val _PROBE = "test/01_unit/compiler/jit_wide_i64_array_store_jit_probe.spl"
val _BASELINE = "test/01_unit/compiler/jit_wide_i64_array_store_baseline_jit_probe.spl"
val _PASS = "PROBE VERDICT: PASS"
# Growth of the probe's peak RSS over an empty JIT run. The probe appends 1M
# i64 (an ~8-16 MB buffer); the boxing path added ~100 MB on top of that, so the
# bound sits between the two.
val _JIT_RSS_GROWTH_BUDGET_KB = 45000

describe "Wide i64 stored into [i64] (out of process)":
    """
    As a runtime maintainer, I need a million full-width i64 array stores to
    keep the right values and bounded memory under every engine, so that
    64-bit hash and cipher code can keep its state in arrays.
    """

    it "keeps overwrite, append and signed-order values correct on the interpreter":
        # @req REQ-JIT-WIDE-I64-ARRAY-001
        step("run the probe under the interpreter")
        expect(engine_stdout(_PROBE, "interpret")).to_contain(_PASS)

    it "keeps overwrite, append and signed-order values correct on the JIT":
        # @req REQ-JIT-WIDE-I64-ARRAY-001
        step("run the probe under the JIT")
        expect(engine_stdout(_PROBE, "jit")).to_contain(_PASS)

    it "does not leak a heap box per wide store on the JIT":
        # @req REQ-JIT-WIDE-I64-ARRAY-002
        step("measure the JIT peak RSS of the probe and of an empty program with /usr/bin/time")
        val baseline_kb = engine_max_rss_kb(_BASELINE, "jit")
        val rss_kb = engine_max_rss_kb(_PROBE, "jit")
        expect(baseline_kb).to_be_greater_than(0)
        expect(rss_kb).to_be_greater_than(0)
        expect(rss_kb - baseline_kb).to_be_less_than(_JIT_RSS_GROWTH_BUDGET_KB)
