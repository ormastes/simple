#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT HUP INT TERM
abi="$root/src/compiler/70.backend/backend_plugin/abi"; fixtures="$root/test/01_unit/compiler/backend_plugin/fixtures"
cc -std=c11 -Wall -Wextra -Werror -fPIC -shared -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/provider.so"
cc -std=c11 -Wall -Wextra -Werror -I"$root/src/runtime" -I"$abi" "$root/src/runtime/runtime_backend_plugin.c" "$fixtures/backend_plugin_v1_bridge_host.c" -ldl -o "$tmp/host"
marker="$tmp/unloaded"
SBP_FIXTURE_UNLOAD_MARKER="$marker" "$tmp/host" "$tmp/provider.so" 0
grep -q 'closed=1 releases=3' "$marker"
for stage_status in '1 31 0 0' '2 32 0 1' '3 33 1 1' '4 34 2 1'; do
    set -- $stage_status; stage=$1; expected=$2; releases=$3; closed=$4
    cc -std=c11 -Wall -Wextra -Werror -fPIC -shared -DSBP_FAIL_STAGE="$stage" -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/provider-$stage.so"
    rm -f "$marker"
    SBP_FIXTURE_UNLOAD_MARKER="$marker" "$tmp/host" "$tmp/provider-$stage.so" "$expected"
    grep -q "closed=$closed releases=$releases" "$marker"
done
cc -std=c11 -Wall -Wextra -Werror -fPIC -shared -DSBP_DESCRIPTOR_ABI=2 -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/bad-abi.so"
"$tmp/host" "$tmp/bad-abi.so" 105
cc -std=c11 -Wall -Wextra -Werror -fPIC -shared -DSBP_DESCRIPTOR_SIZE=8 -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/bad-size.so"
"$tmp/host" "$tmp/bad-size.so" 105
"$tmp/host" "$tmp/provider.so" 100 bad-request
"$tmp/host" "$tmp/provider.so" 100 bad-mir
printf '%s\n' 'int absent_symbol(void){return 0;}' | cc -std=c11 -Wall -Wextra -Werror -x c -fPIC -shared - -o "$tmp/missing.so"
"$tmp/host" "$tmp/missing.so" 104
grep -q '"runtime_backend_plugin"' "$root/src/compiler/70.backend/backend/runtime_compiler.spl"
grep -q '"runtime_backend_plugin.c"' "$root/src/compiler_rust/runtime/build.rs"
grep -q 'spl_backend_plugin_run_v1' "$root/src/runtime/runtime.h"
