use std.spec.*
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use compiler.backend.backend.interpreter_calls.*
use compiler.backend.backend_types.{Value}
use std.nogc_sync_mut.sffi.collection_capture.{collection_capture_begin, collection_capture_finish}
use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}
use compiler.backend.backend.env.{Environment, EvalContext}

fn run_abi_advice_function(id: SymbolId, name: text, increment: i64) -> HirFunction:
    val span = Span.empty()
    val type_ = HirType(kind: HirTypeKind.Int(64, true), span: span)
    val target = HirExpr(kind: HirExprKind.NamedVar(SymbolId(id: 999), "events"), has_type_: true, type_: type_, span: span)
    val value = HirExpr(kind: HirExprKind.IntLit(increment, nil), has_type_: true, type_: type_, span: span)
    val statement = HirStmt(kind: HirStmtKind.Assign(target, HirAssignOp.Add, value), span: span)
    HirFunction(symbol: id, name: name, type_params: [], params: [], return_type: type_,
        body: HirBlock(stmts: [statement], has: false, value: value, span: span), effects: [],
        visibility: Visibility.Public, is_async: false, is_static: false, is_public: true,
        is_method: false, is_mutable: false, is_const: false, is_extern: false,
        func_attr: FunctionAttr.default(), has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil, has_suspension: false,
        has_vhdl_metadata: false, vhdl_metadata: nil, has_doc_comment: false,
        doc_comment: "", span: span)

describe "interpreter collection run context":
    it "isolates empty and Unicode application arguments between interpreters":
        val outer = InterpreterBackendImpl.with_program_args(["outer.spl", "unchanged"])
        val inner = InterpreterBackendImpl.with_program_args(["inner.spl", "", "한글", "--", "--collection-target=application"])
        val result = inner.try_owned_run_abi("rt_get_args", "lib.nogc_sync_mut.sffi.system", true, []).unwrap()
        match result:
            case Ok(Value.Array(args)):
                expect(args.len()).to_equal(5)
                expect(args[1]).to_equal(Value.String(""))
                expect(args[2]).to_equal(Value.String("한글"))
                expect(args[4]).to_equal(Value.String("--collection-target=application"))
            case _: fail("application arguments were not returned")
        match outer.try_owned_run_abi("rt_get_args", "lib.nogc_sync_mut.sffi.system", true, []).unwrap():
            case Ok(Value.Array(args)): expect(args.len()).to_equal(2)
            case _: fail("outer arguments changed")

    it "dispatches interpreted measurement calls into the shared capture channel":
        val interpreter = InterpreterBackendImpl.new()
        expect(collection_capture_begin("test-target")).to_be(true)
        val site = Value.String("ast://interpreter/site#1")
        val target = Value.String("test-target")
        match interpreter.try_owned_run_abi("spl_collection_capture_note_size", "lib.nogc_sync_mut.sffi.collection_capture", true, [site, target, Value.Int(3)]).unwrap():
            case Ok(Value.Int(result)): expect(result).to_equal(1)
            case _: fail("measurement ABI was not called")
        val snapshot = collection_capture_finish() ?? ""
        expect(snapshot).to_contain("size_p95=3")
        expect(snapshot).to_contain("target=test-target")

    it "does not replace same-name user functions or non-owner externs":
        val interpreter = InterpreterBackendImpl.with_program_args(["app.spl"])
        expect(interpreter.try_owned_run_abi("rt_get_args", "app.user", true, [])).to_be_nil()
        expect(interpreter.try_owned_run_abi("rt_get_args", "lib.nogc_sync_mut.sffi.system", false, [])).to_be_nil()

    it "rejects malformed ABI arguments without changing outer arguments":
        val interpreter = InterpreterBackendImpl.with_program_args(["app.spl", "outer"])
        match interpreter.try_owned_run_abi("spl_collection_capture_note_lookup", "lib.nogc_sync_mut.sffi.collection_capture", true, [Value.String("ast://a/b#1"), Value.Int(1), Value.Int(1)]).unwrap():
            case Err(_): ()
            case _: fail("numeric target was accepted")
        match interpreter.try_owned_run_abi("rt_get_args", "lib.nogc_sync_mut.sffi.system", true, []).unwrap():
            case Ok(Value.Array(args)): expect(args[1]).to_equal(Value.String("outer"))
            case _: fail("context changed after failure")

    it "runs before and success advice but preserves execution-error hook semantics":
        val span = Span.empty()
        var symbols = SymbolTable.new()
        val id = symbols.define("rt_get_args", SymbolKind.Function, nil, span, Visibility.Public, false, Some("lib.nogc_sync_mut.sffi.system"))
        var target = run_abi_advice_function(id, "rt_get_args", 1000)
        target.is_extern = true
        val before = run_abi_advice_function(SymbolId(id: 100), "before_args", 1)
        val after = run_abi_advice_function(SymbolId(id: 101), "after_args", 10)
        val error = run_abi_advice_function(SymbolId(id: 102), "error_args", 100)
        var functions: Dict<SymbolId, HirFunction> = {}
        functions[before.symbol] = before
        functions[after.symbol] = after
        functions[error.symbol] = error
        val predicate = "execution ( * rt_get_args ( .. ) )"
        val module = HirModule(name: "run_abi_hooks", path: "run_abi_hooks.spl", imports: [], exports: [], domain_blocks: [],
            symbols: symbols, functions: functions, classes: {}, structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [],
            constants: {}, static_asserts: [], di_bindings: [], arch_rules: [], mock_decls: [], types: [],
            aop_advices: [
                HirAopAdvice(predicate_text: predicate, advice_function: "before_args", form: "before", priority: 1, span: span),
                HirAopAdvice(predicate_text: predicate, advice_function: "after_args", form: "after_success", priority: 1, span: span),
                HirAopAdvice(predicate_text: predicate, advice_function: "error_args", form: "after_error", priority: 1, span: span)
            ])
        val interpreter = InterpreterBackendImpl.with_program_args(["app.spl"])
        var env = Environment.new()
        env.define("events", Value.Int(0))
        val ctx = EvalContext(env: env, module: module, backend: interpreter, names: {}, fn_by_name: {}, has_fn_index: false, strict_mem: false)
        match interpreter.call_hir_function(target, [], ctx):
            case Ok(_): ()
            case _: fail("owned extern did not succeed")
        expect(env.lookup("events").unwrap()).to_equal(Value.Int(11))
        match interpreter.call_hir_function(target, [Value.Int(1)], ctx):
            case Err(_): ()
            case _: fail("invalid extern arguments did not fail")
        # The second call executes before advice; BackendError does not become
        # a returned Value.Result and must not fire either after advice.
        expect(env.lookup("events").unwrap()).to_equal(Value.Int(12))
