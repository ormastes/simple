# Purpose: focused REQ-006/REQ-009 backend plugin contract evidence.

use std.spec
use std.spec.step
use compiler.common.backend_plugin.*

fn test_capabilities() -> [BackendCapability]:
    [BackendCapability.ObjectEmit, BackendCapability.DebugInfo,
        BackendCapability.Optimization]

fn test_request(
    role: BackendRole = BackendRole.CompilerAot,
    target: text = "x86_64-unknown-linux-gnu",
    features: [text] = ["sse4.2", "avx2"]
) -> BackendPluginRequestV1:
    BackendPluginRequestV1(
        role, "llvm", target, "x86-64-v3", features, "release-o2",
        "mir-v1-test-digest", test_capabilities(), "", false)

fn test_descriptor(
    abi_version: i64 = BACKEND_PLUGIN_ABI_VERSION_V1,
    descriptor_size: i64 = BACKEND_PLUGIN_DESCRIPTOR_MIN_SIZE_V1,
    mir_digest: text = "mir-v1-test-digest",
    roles: [BackendRole] = [BackendRole.CompilerAot, BackendRole.InterpreterJit],
    targets: [text] = ["x86_64-unknown-linux-gnu"],
    capabilities: [BackendCapability] = test_capabilities(),
    vtable: BackendPluginVTableV1 = backend_plugin_vtable_v1_all_operations()
) -> BackendPluginDescriptorV1:
    BackendPluginDescriptorV1(
        abi_version, descriptor_size, "llvm", "19.1.7", "llvm-build-42",
        mir_digest, roles, targets, capabilities, vtable)

fn error_code(result: Result<BackendProviderReceipt, BackendPluginError>) -> text:
    match result:
        case Err(error): error.code()
        case Ok(_): "ok"

describe "versioned codegen backend plugin common contract":
    it "REQ-006 admits compatible metadata and rejects ABI and size mismatches":
        step("admit the v1 prefix and reject incompatible ABI metadata")
        val admitted = admit_backend_plugin_descriptor(test_request(), test_descriptor())
        expect(admitted.is_ok()).to_equal(true)
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(abi_version: 2)))).to_equal("BACKEND_PLUGIN_ABI_MISMATCH")
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(descriptor_size: 8)))).to_equal("BACKEND_PLUGIN_DESCRIPTOR_SIZE")

    it "REQ-006 rejects MIR, role, target, and capability mismatches":
        step("reject semantically incompatible provider metadata")
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(mir_digest: "other")))).to_equal("BACKEND_PLUGIN_MIR_DIGEST")
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(roles: [BackendRole.InterpreterJit])))).to_equal("BACKEND_PLUGIN_ROLE")
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(targets: ["aarch64-unknown-linux-gnu"])))).to_equal("BACKEND_PLUGIN_TARGET")
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(capabilities: [BackendCapability.ObjectEmit])))).to_equal("BACKEND_PLUGIN_CAPABILITY")

    it "REQ-006 rejects missing role-specific operations":
        step("require finalize for AOT and execute for JIT")
        var aot = backend_plugin_vtable_v1_all_operations()
        aot.supports_finalize_object = false
        expect(error_code(admit_backend_plugin_descriptor(test_request(),
            test_descriptor(vtable: aot)))).to_equal("BACKEND_PLUGIN_PROVIDER_REJECTED")
        var jit = backend_plugin_vtable_v1_all_operations()
        jit.supports_execute = false
        expect(error_code(admit_backend_plugin_descriptor(
            test_request(role: BackendRole.InterpreterJit),
            test_descriptor(vtable: jit)))).to_equal("BACKEND_PLUGIN_PROVIDER_REJECTED")

    it "REQ-006 rejects malformed plugin-path and feature requests":
        step("validate immutable request metadata before admission")
        var missing_path = test_request()
        missing_path.has_plugin_path = true
        expect(error_code(admit_backend_plugin_descriptor(missing_path,
            test_descriptor()))).to_equal("BACKEND_PLUGIN_PROVIDER_REJECTED")
        expect(error_code(admit_backend_plugin_descriptor(
            test_request(features: ["avx2", "avx2"]),
            test_descriptor()))).to_equal("BACKEND_PLUGIN_PROVIDER_REJECTED")

    it "REQ-009 emits stable order-independent receipts bound to provider and target":
        step("canonicalize CPU features and bind provenance fields")
        val first = admit_backend_plugin_descriptor(
            test_request(features: ["sse4.2", "avx2"]), test_descriptor()).ok().unwrap()
        val reordered = admit_backend_plugin_descriptor(
            test_request(features: ["avx2", "sse4.2"]), test_descriptor()).ok().unwrap()
        expect(first.hash()).to_equal(reordered.hash())
        var changed = test_descriptor()
        changed.build_id = "llvm-build-43"
        val changed_receipt = admit_backend_plugin_descriptor(test_request(), changed).ok().unwrap()
        expect(first.hash() == changed_receipt.hash()).to_equal(false)
        expect(first.canonical_text()).to_contain("llvm-build-42")
