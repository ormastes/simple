#!/bin/sh
# Native Windows fixture ABI proof; not production LLVM/Cranelift qualification.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
case "$(uname -s)" in MINGW*|MSYS*) ;; *) echo 'Windows host required' >&2; exit 2;; esac
. "$root/scripts/setup/windows-msvc-bootstrap-env.shs"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
abi="$root/src/compiler/70.backend/backend_plugin/abi"
fixtures="$root/test/01_unit/compiler/backend_plugin/fixtures"
cc="${SIMPLE_LLVM_WIN_ROOT_23:?LLVM root required}/bin/clang.exe"
"$cc" -std=c11 -Wall -Wextra -Werror -shared -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/provider.dll"
for host in bridge batch; do
    "$cc" -std=c11 -Wall -Wextra -Werror -D_CRT_NONSTDC_NO_WARNINGS -I"$root/src/runtime" -I"$abi" \
        "$root/src/runtime/runtime_backend_plugin.c" "$fixtures/backend_plugin_v1_${host}_host.c" -o "$tmp/$host.exe"
done
provider=$(cygpath -aw "$tmp/provider.dll")
marker="$tmp/unloaded"
marker_win=$(cygpath -aw "$marker")
for retained in path handle; do
    unset SBP_TEST_RETAINED_HANDLE
    if [ "$retained" = handle ]; then export SBP_TEST_RETAINED_HANDLE=1; fi
    SBP_FIXTURE_UNLOAD_MARKER="$marker_win" "$tmp/bridge.exe" "$provider" 0
    grep -q 'closed=1 releases=3 opens=1 closes=1' "$marker"
    rm "$marker"
    SBP_FIXTURE_UNLOAD_MARKER="$marker_win" "$tmp/batch.exe" "$provider"
    grep -q 'closed=1 releases=4 opens=1 closes=1' "$marker"
    rm "$marker"
done
unset SBP_TEST_RETAINED_HANDLE
for spec in '1 31 0 0' '2 32 1 1' '3 33 2 1' '4 34 2 1'; do
    set -- $spec
    "$cc" -std=c11 -Wall -Wextra -Werror -shared -DSBP_FAIL_STAGE="$1" -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/fail-$1.dll"
    SBP_FIXTURE_UNLOAD_MARKER="$marker_win" "$tmp/bridge.exe" "$(cygpath -aw "$tmp/fail-$1.dll")" "$2"
    grep -q "closed=$4 releases=$3" "$marker"
    rm "$marker"
done
for spec in 'ABI 2' 'SIZE 8'; do
    set -- $spec
    "$cc" -std=c11 -Wall -Wextra -Werror -shared "-DSBP_DESCRIPTOR_$1=$2" -I"$abi" "$fixtures/backend_plugin_v1_fixture.c" -o "$tmp/bad-$1.dll"
    "$tmp/bridge.exe" "$(cygpath -aw "$tmp/bad-$1.dll")" 105
done
"$tmp/bridge.exe" "$provider" 100 bad-request
"$tmp/bridge.exe" "$provider" 100 bad-mir
"$tmp/bridge.exe" "$(cygpath -aw "$tmp/absent.dll")" 103
printf '%s\n' 'PASS Windows backend bridge: real DLL path/retained handle, session/buffer ownership, failure cleanup, descriptor and input rejection'
