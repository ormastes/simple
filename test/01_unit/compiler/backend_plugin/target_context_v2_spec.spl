# @req REQ-010
use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir_raw}
use std.nogc_sync_mut.io_runtime.{file_read_bytes, file_exists, dir_remove_all}
use compiler.common.backend_plugin.model.{BackendRole, BackendCapability, BackendPluginRequestV1}
use compiler.backend.backend_plugin.registry.{BUILTIN_MIR_ABI_DIGEST_V1}
use compiler.backend.backend_plugin.builtin_adapter.{BuiltinBackendCompileAdapter, create_builtin_backend_compile_adapter}
use compiler.backend.backend_plugin.target_context_v2.*
use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget, BackendCompileOptions, OptimizationLevel, compileoptions_default_options}
use compiler.backend.backend.llvm_target.{LlvmTargetConfig, llvm_explicit_target_config}
use compiler.backend.backend.llvm_codegen_adapter.{llvm_translate_module_direct_ir}
use compiler.backend.backend.backend_helpers.{backend_helper_aot_opt_level}
use compiler.backend.backend.llvm_backend_tools.{llvm_llc_opt_flag}
use compiler.mir.mir_instructions.{MirModule}
use compiler.driver.driver_backend_plugin_selection.{driver_aot_backend_plugin_request_v1}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.backend.backend.static_backend_registry.{
    BackendLinkClass, install_k1_static_backend_table_v1, static_backend_entry_v1
}
use compiler.backend.backend.static_backend_cranelift_port.{cranelift_backend_port_v1}
use compiler.backend.backend.static_backend_interpreter_port.{interpreter_backend_port_v1}
use compiler.backend.backend.static_backend_llvm_port.{llvm_backend_port_v1}

# `simple test` runs under the interpreter, where the K1 composition root is
# not shadowed in; install the same "llvm-cranelift" table the CLI installs.
fn install_context_k1_table_v2() -> bool:
    install_k1_static_backend_table_v1("llvm-cranelift", [
        static_backend_entry_v1(BackendKind.Cranelift,
            BackendLinkClass.KernelLinked, cranelift_backend_port_v1(),
            CodegenOutputKind.ObjectCode),
        static_backend_entry_v1(BackendKind.Interpreter,
            BackendLinkClass.KernelLinked, interpreter_backend_port_v1(),
            CodegenOutputKind.InterpretedResult),
        static_backend_entry_v1(BackendKind.Llvm,
            BackendLinkClass.KernelLinked, llvm_backend_port_v1(),
            CodegenOutputKind.ObjectCode)
    ])

fn context_probe_options_v2() -> BackendCompileOptions:
    val defaults = compileoptions_default_options()
    BackendCompileOptions(target: CodegenTarget.X86_64,
        opt_level: OptimizationLevel.None_, debug_info: false,
        emit_assembly: false, emit_llvm_ir: false, emit_mir: false,
        verify_output: true, target_opt_ctx: defaults.target_opt_ctx,
        backend_kind: Some("llvm"), allowed_families: [])

fn context_probe_module_v2() -> MirModule:
    MirModule(name: "retained_target_probe", functions: {}, statics: {}, constants: {}, types: {})

fn context_probe_adapter_v2() -> BuiltinBackendCompileAdapter:
    val explicit = llvm_explicit_target_config("x86_64-unknown-linux-gnu", false).ok().unwrap()
    val config = LlvmTargetConfig(explicit.triple, "x86-64", [], explicit.abi)
    val context = BuiltinBackendTargetContextV2(context_probe_options_v2(), "x86-64", [], config)
    BuiltinBackendCompileAdapter(kind: BackendKind.Llvm, target_context: context)

describe "retained builtin target context V2":
    it "preserves the driver's empty CPU default without admitting a changed CPU":
        step("Construct the normal driver request with an empty CPU")
        val request = driver_aot_backend_plugin_request_v1("llvm", "x86_64", "", 0)
        val context = builtin_backend_target_context_v2(request, context_probe_options_v2())
        expect(context.cpu).to_equal("generic")
        expect(builtin_backend_context_diagnostic_v2(context, BackendKind.Llvm, "")).to_equal("")
        expect(builtin_backend_context_diagnostic_v2(context, BackendKind.Llvm, "generic")).to_equal("")
        expect(builtin_backend_context_diagnostic_v2(context, BackendKind.Llvm, "native")).to_contain("differs")

    it "retains feature request bytes but refuses to emit unconfirmed features":
        var features = ["avx2"]
        val request = BackendPluginRequestV1(BackendRole.CompilerAot, "llvm",
            "x86_64", "generic", features, "o0", BUILTIN_MIR_ABI_DIGEST_V1,
            [BackendCapability.ObjectEmit], "", false)
        val context = builtin_backend_target_context_v2(request, context_probe_options_v2())
        features.push("fma")
        expect(context.requested_features.len()).to_equal(1)
        expect(context.requested_features[0]).to_equal("avx2")
        val adapter = BuiltinBackendCompileAdapter(kind: BackendKind.Llvm, target_context: context)
        step("Reject before a backend can ignore the requested SIMD feature")
        expect(adapter.compile_module(context_probe_module_v2()).is_err()).to_equal(true)
        expect(adapter.compile_aot_module(context_probe_module_v2(), true, 0, "", []).is_err()).to_equal(true)

    it "does not silently configure a Cranelift CPU through its triple-only ISA API":
        val llvm = context_probe_adapter_v2()
        val cranelift = BuiltinBackendCompileAdapter(kind: BackendKind.Cranelift, target_context: llvm.target_context)
        expect(cranelift.compile_module(context_probe_module_v2()).is_err()).to_equal(true)
        expect(cranelift.compile_aot_module(context_probe_module_v2(), true, 0, "x86-64", []).is_err()).to_equal(true)

    it "uses the retained triple in the generated LLVM module header":
        val adapter = context_probe_adapter_v2()
        val context = adapter.target_context
        val ir = llvm_translate_module_direct_ir(context.options, context_probe_module_v2(), Some(context.llvm_config))
        expect(ir).to_contain("target triple = \"x86_64-unknown-linux-gnu\"")

    it "preserves admitted O1 through AOT preparation and rejects changed optimization":
        expect(install_context_k1_table_v2()).to_equal(true)
        val request = driver_aot_backend_plugin_request_v1("llvm", "x86_64", "", 1)
        val adapter = create_builtin_backend_compile_adapter(request).ok().unwrap()
        val options = adapter.target_context.options
        expect(options.opt_level).to_equal(OptimizationLevel.Basic)
        expect(backend_helper_aot_opt_level(1, Some(options))).to_equal(OptimizationLevel.Basic)
        expect(llvm_llc_opt_flag(options.opt_level)).to_equal("-O1")
        expect(backend_helper_aot_opt_level(1)).to_equal(OptimizationLevel.Size)
        expect(adapter.compile_aot_module(context_probe_module_v2(), true, 2, "", []).is_err()).to_equal(true)

    it "emits the same retained x86-64 ELF target through module and AOT paths":
        step("Emit a real LLVM object using a retained explicit Linux target")
        val adapter = context_probe_adapter_v2()
        val module = context_probe_module_v2()
        val emitted = adapter.compile_module(module).ok().unwrap()
        val aot = adapter.compile_aot_module(module, true, 0, "x86-64", []).ok().unwrap()
        val aot_bytes = aot.object_code.unwrap()
        expect(emitted.object_code.len()).to_be_greater_than(64)
        expect(aot_bytes.len()).to_be_greater_than(64)
        expect(emitted.object_code[0]).to_equal(127u8)
        expect(aot_bytes[0]).to_equal(127u8)
        expect(emitted.object_code[4]).to_equal(2u8)
        expect(aot_bytes[4]).to_equal(2u8)
        expect(emitted.object_code[18]).to_equal(62u8)
        expect(aot_bytes[18]).to_equal(62u8)

    it "keeps the scalar object-path emitter on the retained target and rejects CPU substitution":
        val stage_dir = secure_temp_dir_raw(".", "retained-target-spec")
        expect(stage_dir == "").to_equal(false)
        val object_path = stage_dir + "/probe.o"
        val diagnostic_path = stage_dir + "/message"
        val adapter = context_probe_adapter_v2()
        val module = context_probe_module_v2()
        step("A different operation CPU fails before publishing an object")
        expect(adapter.compile_aot_into_path(module, true, 0, "native", [],
            object_path, diagnostic_path)).to_equal(1)
        expect(file_exists(object_path)).to_equal(false)
        step("Matching CPU emits a real x86-64 ELF object through the scalar path")
        expect(adapter.compile_aot_into_path(module, true, 0, "x86-64", [],
            object_path, diagnostic_path)).to_equal(0)
        val object_bytes = file_read_bytes(object_path)
        expect(object_bytes.len()).to_be_greater_than(64)
        expect(object_bytes[0]).to_equal(127u8)
        expect(object_bytes[4]).to_equal(2u8)
        expect(object_bytes[18]).to_equal(62u8)
        expect(dir_remove_all(stage_dir)).to_equal(true)
