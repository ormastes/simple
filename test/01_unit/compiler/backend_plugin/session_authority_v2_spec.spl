# @req REQ-010

use std.spec.*
use std.spec.step
use compiler.common.backend_plugin.model.{
    BackendRole, BackendCapability, BackendPluginRequestV1
}
use compiler.backend.backend_plugin.registry.{BUILTIN_MIR_ABI_DIGEST_V1}
use compiler.backend.backend_plugin.session_authority_v2.{
    BackendSessionAuthorityV2, BackendSessionAuthorityErrorV2,
    BackendSessionAuthorityStateV2, BackendSessionOwnedLeaseV2,
    backend_session_authority_open_v2, backend_session_authority_project_v2,
    backend_session_authority_use_acquire_v2,
    backend_session_authority_compile_module_v2,
    backend_session_authority_use_release_v2,
    backend_session_authority_close_v2, backend_session_authority_release_v2,
    BACKEND_SESSION_AUTHORITY_SCHEMA_V2, BackendSessionResultTokenV2,
    BackendSessionCompileKindV2, BackendSessionFeatureAcceptanceV2,
    BackendSessionResultTerminalStatusV2,
    backend_session_authority_compile_module_result_v2,
    backend_session_authority_compile_aot_result_v2,
    backend_session_authority_compile_aot_into_path_v2,
    backend_session_authority_result_project_v2,
    backend_session_authority_result_release_v2
}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.backend.backend.backend_types.{BackendKind}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.backend.backend.static_backend_registry.{
    BackendLinkClass, install_k1_static_backend_table_v1, static_backend_entry_v1
}
use compiler.backend.backend.static_backend_cranelift_port.{cranelift_backend_port_v1}
use compiler.backend.backend.static_backend_interpreter_port.{interpreter_backend_port_v1}
use compiler.backend.backend.static_backend_llvm_port.{llvm_backend_port_v1}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir.*
use std.io_runtime.{file_exists, file_size_raw}
use std.common.crypto.sha256.{sha256_u8_hex}

# `simple test` runs under the interpreter, where the K1 composition root
# (src/compositions/kernel_llvm_cranelift) is not shadowed in and
# compiler.driver.bootstrap_k1_selected is the fail-closed stub. Install the
# same "llvm-cranelift" table the CLI composition root installs; repeat calls
# with the same policy are idempotent.
fn install_authority_k1_table() -> bool:
    install_k1_static_backend_table_v1("llvm-cranelift", [
        static_backend_entry_v1(BackendKind.Cranelift,
            BackendLinkClass.KernelLinked, cranelift_backend_port_v1(),
            CodegenOutputKind.ObjectCode),
        static_backend_entry_v1(BackendKind.Interpreter,
            BackendLinkClass.KernelLinked, interpreter_backend_port_v1(),
            CodegenOutputKind.InterpretedResult),
        static_backend_entry_v1(BackendKind.Llvm,
            BackendLinkClass.KernelLinked, llvm_backend_port_v1(),
            CodegenOutputKind.ObjectCode)
    ])

fn authority_request(provider: text = "llvm") -> BackendPluginRequestV1:
    BackendPluginRequestV1(
        BackendRole.CompilerAot, provider, "host", "generic", [], "debug",
        BUILTIN_MIR_ABI_DIGEST_V1, [BackendCapability.ObjectEmit], "", false)

fn authority_feature_request() -> BackendPluginRequestV1:
    BackendPluginRequestV1(
        BackendRole.CompilerAot, "llvm", "host", "generic", ["avx2"], "debug",
        BUILTIN_MIR_ABI_DIGEST_V1, [BackendCapability.ObjectEmit], "", false)

fn authority_probe_module() -> MirModule:
    val function = MirFunction(
        symbol: SymbolId(id: 1),
        name: "authority_probe",
        signature: MirSignature(
            params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: [MirBlock(
            id: BlockId.entry(), label: Some("entry"), instructions: [],
            terminator: MirTerminator.Ret(nil)
        )],
        entry_block: BlockId.entry(),
        span: Span.empty(),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(
        name: "backend_session_authority_probe",
        functions: functions, statics: {}, constants: {}, types: {})

describe "backend session generation and compile-use authority V2":
    it "retains exact object bytes with explicit unknown feature acceptance":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var owner = BackendSessionAuthorityV2.create()
        val token = backend_session_authority_open_v2(
            owner, authority_request()).ok().unwrap()
        val use_token = backend_session_authority_use_acquire_v2(
            owner, token).ok().unwrap()
        val result_token = backend_session_authority_compile_module_result_v2(
            owner, token, use_token, authority_probe_module()).ok().unwrap()
        val projected = backend_session_authority_result_project_v2(
            owner, token, use_token, result_token).ok().unwrap()
        expect(projected.schema_version).to_equal(BACKEND_SESSION_AUTHORITY_SCHEMA_V2)
        expect(projected.provider_identity).to_equal("llvm")
        expect(projected.backend_build_id.len()).to_be_greater_than(0)
        expect(projected.receipt_hash).to_equal(token.receipt_hash)
        expect(projected.target).to_equal("host")
        expect(projected.cpu).to_equal("generic")
        expect(projected.optimization).to_equal("debug")
        expect(projected.compile_kind).to_equal(BackendSessionCompileKindV2.Module)
        expect(projected.compile_cpu_request).to_equal("generic")
        expect(projected.compile_opt_level_request).to_equal(-1)
        expect(projected.requested_features.len()).to_equal(0)
        expect(projected.accepted_features.len()).to_equal(0)
        expect(projected.feature_acceptance).to_equal(
            BackendSessionFeatureAcceptanceV2.Unknown)
        expect(projected.terminal_status).to_equal(
            BackendSessionResultTerminalStatusV2.Emitted)
        expect(projected.object_byte_count).to_be_greater_than(0)
        expect(projected.object_sha256).to_equal(
            sha256_u8_hex(projected.object_bytes))
        expect(projected.envelope_sha256.len()).to_equal(64)

        step("A caller byte mutation cannot change the owner's retained object")
        val first_byte = projected.object_bytes[0]
        var caller_bytes = projected.object_bytes
        caller_bytes[0] = if first_byte == 0u8: 1u8 else: 0u8
        val again = backend_session_authority_result_project_v2(
            owner, token, use_token, result_token).ok().unwrap()
        expect(again.object_bytes[0]).to_equal(first_byte)
        expect(again.object_sha256).to_equal(projected.object_sha256)
        expect(again.envelope_sha256).to_equal(projected.envelope_sha256)

        step("The result must retire before its compile use and session")
        expect(backend_session_authority_use_release_v2(
            owner, token, use_token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.ResultsLive))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.UsesLive))
        val draining = backend_session_authority_result_project_v2(
            owner, token, use_token, result_token).ok().unwrap()
        expect(draining.object_sha256).to_equal(projected.object_sha256)
        expect(draining.envelope_sha256).to_equal(projected.envelope_sha256)
        expect(backend_session_authority_result_release_v2(
            owner, token, use_token, result_token)).to_equal(Ok(()))
        expect(backend_session_authority_result_project_v2(
            owner, token, use_token, result_token).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.ResultUnknownOrReleased)
        expect(backend_session_authority_use_release_v2(
            owner, token, use_token)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(owner, token)).to_equal(Ok(()))

    it "retains the in-memory Cranelift AOT object with its compile inputs":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var owner = BackendSessionAuthorityV2.create()
        val token = backend_session_authority_open_v2(
            owner, authority_request("cranelift")).ok().unwrap()
        val use_token = backend_session_authority_use_acquire_v2(
            owner, token).ok().unwrap()
        val result_token = backend_session_authority_compile_aot_result_v2(
            owner, token, use_token, authority_probe_module(),
            false, 0, "generic", []).ok().unwrap()
        val projected = backend_session_authority_result_project_v2(
            owner, token, use_token, result_token).ok().unwrap()
        expect(projected.compile_kind).to_equal(BackendSessionCompileKindV2.Aot)
        expect(projected.compile_cpu_request).to_equal("generic")
        expect(projected.compile_opt_level_request).to_equal(0)
        expect(projected.compile_is_release).to_equal(false)
        expect(projected.feature_acceptance).to_equal(
            BackendSessionFeatureAcceptanceV2.Unknown)
        expect(projected.object_byte_count).to_be_greater_than(0)
        expect(projected.object_sha256).to_equal(
            sha256_u8_hex(projected.object_bytes))
        expect(backend_session_authority_result_release_v2(
            owner, token, use_token, result_token)).to_equal(Ok(()))
        expect(backend_session_authority_use_release_v2(
            owner, token, use_token)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(owner, token)).to_equal(Ok(()))

    it "rejects substituted and replayed object-result tokens":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var first = BackendSessionAuthorityV2.create()
        var second = BackendSessionAuthorityV2.create()
        val first_token = backend_session_authority_open_v2(
            first, authority_request()).ok().unwrap()
        val second_token = backend_session_authority_open_v2(
            second, authority_request()).ok().unwrap()
        val first_use = backend_session_authority_use_acquire_v2(
            first, first_token).ok().unwrap()
        val second_use = backend_session_authority_use_acquire_v2(
            second, second_token).ok().unwrap()
        val result_token = backend_session_authority_compile_module_result_v2(
            first, first_token, first_use, authority_probe_module()).ok().unwrap()
        val substituted = BackendSessionResultTokenV2(
            result_token.owner_identity, result_token.generation,
            result_token.use_id, result_token.result_id + 1u64)
        expect(backend_session_authority_result_project_v2(
            first, first_token, first_use, substituted).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.ResultUnknownOrReleased)
        expect(backend_session_authority_result_project_v2(
            second, second_token, second_use, result_token).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.ResultUnknownOrReleased)
        expect(backend_session_authority_result_release_v2(
            first, first_token, first_use, result_token)).to_equal(Ok(()))
        expect(backend_session_authority_result_release_v2(
            first, first_token, first_use, result_token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.ResultUnknownOrReleased))
        expect(backend_session_authority_use_release_v2(
            first, first_token, first_use)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(first, first_token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(first, first_token)).to_equal(Ok(()))
        expect(backend_session_authority_result_project_v2(
            first, first_token, first_use, result_token).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.UnknownOrSubstituted)
        expect(backend_session_authority_use_release_v2(
            second, second_token, second_use)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(second, second_token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(second, second_token)).to_equal(Ok(()))

    it "retains a compiled object until its use drains and close completes":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var owner = BackendSessionAuthorityV2.create()
        val token = backend_session_authority_open_v2(
            owner, authority_request()).ok().unwrap()
        val projected = backend_session_authority_project_v2(
            owner, token).ok().unwrap()
        expect(projected.state).to_equal(BackendSessionAuthorityStateV2.Accepting)
        expect(projected.provider_identity).to_equal("llvm")
        expect(projected.receipt_hash.len()).to_equal(64)

        step("Acquire one use and compile through the retained provider")
        val use_token = backend_session_authority_use_acquire_v2(
            owner, token).ok().unwrap()
        val output = backend_session_authority_compile_module_v2(
            owner, token, use_token, authority_probe_module()).ok().unwrap()
        expect(output.has_object_code).to_equal(true)
        expect(output.object_code.len()).to_be_greater_than(0)
        expect(backend_session_authority_compile_module_v2(
            owner, token, use_token, authority_probe_module()).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.UseUnknownOrSpent)

        step("Close stops new uses but keeps the provider until the use drains")
        expect(backend_session_authority_close_v2(owner, token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.UsesLive))
        expect(backend_session_authority_use_acquire_v2(
            owner, token).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.NotAccepting)
        expect(backend_session_authority_use_release_v2(
            owner, token, use_token)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_project_v2(
            owner, token).ok().unwrap().state).to_equal(
            BackendSessionAuthorityStateV2.Closed)
        expect(backend_session_authority_release_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_project_v2(
            owner, token).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.UnknownOrSubstituted)

    it "refuses every compile entrypoint for an unused token after close begins":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var owner = BackendSessionAuthorityV2.create()
        val token = backend_session_authority_open_v2(
            owner, authority_request()).ok().unwrap()
        val use_token = backend_session_authority_use_acquire_v2(
            owner, token).ok().unwrap()

        step("Begin close with a reserved use that has not compiled")
        expect(backend_session_authority_close_v2(owner, token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.UsesLive))
        expect(backend_session_authority_project_v2(
            owner, token).ok().unwrap().state).to_equal(
            BackendSessionAuthorityStateV2.Closing)

        step("The reserved use cannot start module or AOT provider work")
        val module = authority_probe_module()
        expect(backend_session_authority_compile_module_v2(
            owner, token, use_token, module).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.NotAccepting)
        expect(backend_session_authority_compile_module_result_v2(
            owner, token, use_token, module).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.NotAccepting)
        expect(backend_session_authority_compile_aot_result_v2(
            owner, token, use_token, module, false, 0, "generic", []).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.NotAccepting)
        expect(backend_session_authority_compile_aot_into_path_v2(
            owner, token, use_token, module, false, 0, "generic", [],
            "", "").err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.NotAccepting)

        step("Drain the unused reservation and retry close before releasing")
        expect(backend_session_authority_project_v2(
            owner, token).ok().unwrap().live_uses).to_equal(1)
        expect(backend_session_authority_release_v2(owner, token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.NotClosed))
        expect(backend_session_authority_use_release_v2(
            owner, token, use_token)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(owner, token)).to_equal(Ok(()))

    it "rejects foreign tokens and a revoked compile use":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var first = BackendSessionAuthorityV2.create()
        var second = BackendSessionAuthorityV2.create()
        val first_token = backend_session_authority_open_v2(
            first, authority_request()).ok().unwrap()
        val second_token = backend_session_authority_open_v2(
            second, authority_request()).ok().unwrap()
        val first_use = backend_session_authority_use_acquire_v2(
            first, first_token).ok().unwrap()
        val second_use = backend_session_authority_use_acquire_v2(
            second, second_token).ok().unwrap()

        step("A matching generation in a different owner grants no authority")
        expect(backend_session_authority_use_acquire_v2(
            first, second_token).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.UnknownOrSubstituted)
        expect(backend_session_authority_compile_module_v2(
            first, first_token, second_use, authority_probe_module()).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.UseUnknownOrSpent)
        expect(backend_session_authority_use_release_v2(
            first, first_token, first_use)).to_equal(Ok(()))
        expect(backend_session_authority_use_release_v2(
            first, first_token, first_use)).to_equal(
            Err(BackendSessionAuthorityErrorV2.UseUnknownOrSpent))
        expect(backend_session_authority_close_v2(first, first_token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(first, first_token)).to_equal(Ok(()))
        expect(backend_session_authority_use_release_v2(
            second, second_token, second_use)).to_equal(Ok(()))
        expect(backend_session_authority_close_v2(second, second_token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(second, second_token)).to_equal(Ok(()))

    it "does not publish a generation when loader admission fails":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        var owner = BackendSessionAuthorityV2.create()
        expect(backend_session_authority_open_v2(
            owner, authority_request("missing")).is_err()).to_equal(true)
        expect(backend_session_authority_open_v2(
            owner, authority_feature_request()).err().unwrap()).to_equal(
            BackendSessionAuthorityErrorV2.LoadRejected(
                "backend feature acceptance is unavailable for V2 sessions"))
        val token = backend_session_authority_open_v2(
            owner, authority_request()).ok().unwrap()
        expect(token.generation).to_equal(1u64)
        expect(backend_session_authority_release_v2(owner, token)).to_equal(
            Err(BackendSessionAuthorityErrorV2.NotClosed))
        expect(backend_session_authority_close_v2(owner, token)).to_equal(Ok(()))
        expect(backend_session_authority_release_v2(owner, token)).to_equal(Ok(()))

    it "routes object-path AOT through an owned compile use":
        # @req REQ-010
        expect(install_authority_k1_table()).to_equal(true)
        val stage_dir = "/tmp/unit_backend_session_owned_lease_v2"
        _ = shell("rm -rf '{stage_dir}' && mkdir -p '{stage_dir}'")
        val object_path = "{stage_dir}/probe.o"
        val diagnostic_path = "{stage_dir}/message"
        var lease = BackendSessionOwnedLeaseV2.open(
            authority_request("cranelift")).ok().unwrap()
        expect(lease.backend_name).to_equal("cranelift")
        expect(lease.receipt_hash.len()).to_equal(64)

        step("A failed object publication retires the result and permits another use")
        expect(lease.compile_aot_into_path(
            authority_probe_module(), false, 0, "generic", [],
            "", diagnostic_path)).to_equal(1)
        expect(file_exists(diagnostic_path)).to_equal(true)

        step("The retained provider emits a real object via the driver facade")
        expect(lease.compile_aot_into_path(
            authority_probe_module(), false, 0, "generic", [],
            object_path, diagnostic_path)).to_equal(0)
        expect(file_exists(object_path)).to_equal(true)
        expect(file_size_raw(object_path)).to_be_greater_than(0)

        step("Closing retires the facade and forbids another provider call")
        expect(lease.close()).to_equal(true)
        expect(lease.close()).to_equal(true)
        expect(lease.compile_aot_into_path(
            authority_probe_module(), false, 0, "generic", [],
            object_path, diagnostic_path)).to_equal(1)
        _ = shell("rm -rf '{stage_dir}'")
