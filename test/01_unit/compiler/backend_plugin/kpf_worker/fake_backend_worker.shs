#!/bin/sh
set -eu

IFS='|' read -r prefix version kind generation session slot epoch capabilities length payload
printf 'KPFW1|%s|1|%s|%s|-1|0|%s|0|x\n' \
  "$version" "$generation" "$session" "$capabilities"

module_ok='x53425031010000000000000001000000090000000000000000000000000000006d6f64756c652d6f6b'

while IFS='|' read -r prefix version kind generation session slot epoch capabilities length payload; do
  case "$kind" in
    2) printf 'KPFW1|%s|3|%s|%s|%s|%s|%s|41|%s\n' \
         "$version" "$generation" "$session" "$slot" "$epoch" \
         "$capabilities" "$module_ok" ;;
    5) printf 'KPFW1|%s|6|%s|%s|-1|0|0|0|x\n' \
         "$version" "$generation" "$session" ;;
    7) printf 'KPFW1|%s|8|%s|%s|-1|0|0|0|x\n' \
         "$version" "$generation" "$session"; exit 0 ;;
    *) exit 26 ;;
  esac
done

exit 27
