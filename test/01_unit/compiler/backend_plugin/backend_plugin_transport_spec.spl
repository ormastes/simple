use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use compiler.common.backend_plugin.model.{BackendRole, BackendCapability,
    BackendPluginRequestV1}
use compiler.backend_plugin.transport.{BACKEND_PLUGIN_BRIDGE_MAGIC_V1,
    BACKEND_PLUGIN_BRIDGE_VERSION_V1, BACKEND_PLUGIN_BRIDGE_HEADER_SIZE_V1,
    BACKEND_PLUGIN_REQUEST_SIZE_V1, backend_plugin_request_encode_v1, backend_plugin_request_decode_v1,
    backend_plugin_envelope_encode_v1, backend_plugin_envelope_decode_v1}

fn transport_request() -> BackendPluginRequestV1:
    BackendPluginRequestV1(
        BackendRole.CompilerAot, "dynamic", "host", "generic", ["+sse2", "-avx"], "debug",
        "mir-v1", [BackendCapability.ObjectEmit, BackendCapability.Optimization],
        "/tmp/provider.so", true)

fn transport_request_backend_bytes(bytes: [u8]) -> [u8]:
    # Keep the rest of a valid request and its field lengths intact so each
    # negative case reaches text validation rather than failing packet bounds.
    val valid = backend_plugin_request_encode_v1(transport_request())
    var wire: [u8] = []
    for index in 0..BACKEND_PLUGIN_REQUEST_SIZE_V1: wire.push(valid[index])
    wire[24] = bytes.len().to_u8()
    wire[25] = 0
    wire[26] = 0
    wire[27] = 0
    for byte in bytes: wire.push(byte)
    for index in (BACKEND_PLUGIN_REQUEST_SIZE_V1 + 7)..valid.len(): wire.push(valid[index])
    wire

describe "backend plugin packed transport":
    it "rejects malformed UTF8 rather than accepting raw byte roundtrips":
        val malformed: [[u8]] = [
            [128], [192, 175], [224, 128, 175], [240, 128, 128, 175],
            [237, 160, 128], [244, 144, 128, 128], [245, 128, 128, 128],
            [194], [226, 130], [240, 159, 146], [226, 65, 130]]
        for bytes in malformed:
            match backend_plugin_request_decode_v1(transport_request_backend_bytes(bytes)):
                case Err(reason): expect(reason).to_equal("request-text-utf8")
                case Ok(_): expect(false).to_equal(true)
        match backend_plugin_request_decode_v1(transport_request_backend_bytes([0])):
            case Err(reason): expect(reason).to_equal("request-text-nul")
            case Ok(_): expect(false).to_equal(true)

    it "preserves valid multibyte text and byte lengths across provider fields":
        var request = transport_request()
        request.backend_name = "백엔드"
        request.cpu = "cpu-é"
        request.features = ["+기능", "-😀"]
        val wire = backend_plugin_request_encode_v1(request)
        val decoded = backend_plugin_request_decode_v1(wire).unwrap()
        expect(decoded.backend_name).to_equal(request.backend_name)
        expect(decoded.cpu).to_equal(request.cpu)
        expect(decoded.features).to_equal(request.features)
        expect(backend_plugin_request_encode_v1(decoded)).to_equal(wire)
        # U+10FFFF is the highest accepted scalar; the next value is rejected
        # in the malformed table above, matching the native bridge boundary.
        expect(backend_plugin_request_decode_v1(
            transport_request_backend_bytes([244, 143, 191, 191])).is_ok()).to_equal(true)

    it "round trips every provider configuration field without provider path leakage":
        val wire = backend_plugin_request_encode_v1(transport_request())
        expect(wire.len()).to_be_greater_than(BACKEND_PLUGIN_REQUEST_SIZE_V1)
        val decoded = backend_plugin_request_decode_v1(wire).unwrap()
        expect(decoded.backend_name).to_equal("dynamic")
        expect(decoded.target).to_equal("host")
        expect(decoded.cpu).to_equal("generic")
        expect(decoded.features).to_equal(["+sse2", "-avx"])
        expect(decoded.optimization).to_equal("debug")
        expect(decoded.mir_abi_digest).to_equal("mir-v1")
        expect(decoded.required_capabilities).to_equal([BackendCapability.ObjectEmit, BackendCapability.Optimization])
        expect(decoded.has_plugin_path).to_equal(false)
        expect(backend_plugin_request_encode_v1(decoded)).to_equal(wire)

    it "rejects incomplete legacy requests unsupported versions and malformed lengths":
        expect(backend_plugin_request_decode_v1([1, 0, 0, 0]).is_err()).to_equal(true)
        var version = backend_plugin_request_encode_v1(transport_request())
        version[4] = 2
        expect(backend_plugin_request_decode_v1(version).is_err()).to_equal(true)
        var length = backend_plugin_request_encode_v1(transport_request())
        length[27] = 255
        expect(backend_plugin_request_decode_v1(length).is_err()).to_equal(true)
        var trailing = backend_plugin_request_encode_v1(transport_request())
        trailing.push(0)
        expect(backend_plugin_request_decode_v1(trailing).is_err()).to_equal(true)

    it "preserves empty CPU and ordered feature boundaries and rejects empty required fields":
        var request = transport_request()
        request.cpu = ""
        request.features = ["a,b", "c"]
        val decoded = backend_plugin_request_decode_v1(backend_plugin_request_encode_v1(request)).unwrap()
        expect(decoded.cpu).to_equal("")
        expect(decoded.features).to_equal(["a,b", "c"])
        request.target = ""
        expect(backend_plugin_request_encode_v1(request).len()).to_equal(0)

    it "round trips payload and diagnostic through the frozen envelope":
        val wire = backend_plugin_envelope_encode_v1(-7, 3, [1, 2, 255], "bad provider")
        expect(wire.len()).to_equal(BACKEND_PLUGIN_BRIDGE_HEADER_SIZE_V1 + 15)
        val decoded = backend_plugin_envelope_decode_v1(wire)
        expect(decoded.valid).to_equal(true)
        expect(decoded.status).to_equal(-7)
        expect(decoded.result_kind).to_equal(3)
        expect(decoded.payload).to_equal([1, 2, 255])
        expect(decoded.diagnostic).to_equal("bad provider")

    it "fails closed for bad magic, truncation, and trailing bytes":
        var valid = backend_plugin_envelope_encode_v1(0, 1, [9], "")
        var bad_magic = valid
        bad_magic[0] = 0
        expect(backend_plugin_envelope_decode_v1(bad_magic).reason).to_equal(
            "bad-envelope-magic")
        expect(backend_plugin_envelope_decode_v1([1, 2]).reason).to_equal(
            "truncated-envelope")
        valid.push(0)
        expect(backend_plugin_envelope_decode_v1(valid).reason).to_equal(
            "trailing-envelope-bytes")

    it "keeps the wrapper on canonical MIR serialization and the boxed byte extern":
        val source = file_read("src/compiler/70.backend/backend_plugin/transport.spl")
        expect(source).to_contain(
            "extern fn spl_backend_plugin_run_v1(")
        expect(source).to_contain(
            "path_bytes: [u8], request_bytes: [u8], mir_bytes: [u8]")
        expect(source).to_contain(
            "text_to_bytes(serialize_mir_module(module))")
        expect(source).to_contain(
            "backend_plugin_envelope_decode_v1(response)")
        expect(source).to_contain("unsafe(capabilities: [ffi])")

    it "matches the frozen C header constants and field order":
        val header = file_read(
            "src/compiler/70.backend/backend_plugin/abi/simple_backend_plugin_v1.h")
        expect(header).to_contain("0x31504253")
        expect(header).to_contain("SIMPLE_BACKEND_BRIDGE_VERSION_V1 UINT32_C(1)")
        expect(header).to_contain("SIMPLE_BACKEND_BRIDGE_HEADER_SIZE_V1 UINT32_C(32)")
        expect(header).to_contain(
            "magic:u32, version:u32, status:i32, result_kind:u32, payload_len:u64")

    it "admits only finalized object envelopes in the dynamic adapter":
        val source = file_read(
            "src/compiler/70.backend/backend_plugin/dynamic_adapter.spl")
        expect(source).to_contain(
            "BACKEND_PLUGIN_FINAL_OBJECT_RESULT_KIND_V1: i64 = 2")
        expect(source).to_contain("if not envelope.valid:")
        expect(source).to_contain("if envelope.status != 0:")
        expect(source).to_contain(
            "envelope.result_kind != BACKEND_PLUGIN_FINAL_OBJECT_RESULT_KIND_V1")
        expect(source).to_contain("if envelope.payload.len() == 0:")
        expect(source).to_contain("CodegenOutput.object(module.name, envelope.payload)")
