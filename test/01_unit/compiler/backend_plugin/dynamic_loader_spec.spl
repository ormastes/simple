# Focused Milestone 4 evidence for the checked dynamic provider lease.

use std.spec
use std.spec.step
use std.fs.{read_file}
use compiler.backend_plugin.dynamic_loader.*
use common.plugin.iface_id.{ParamHeader}
use common.plugin.negotiation.{HostOfferV1}

val DYNAMIC_LOADER_SOURCE =
    "src/compiler/70.backend/backend_plugin/dynamic_loader.spl"

describe "dynamic backend provider library lease":
    it "retains only a mandatory negotiated v1 plugin entry":
        step("inspect the checked load and symbol-resolution boundary")
        val source = read_file(DYNAMIC_LOADER_SOURCE)
        expect(DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1).to_equal(
            "spl_plugin_entry_v1"
        )
        expect(source).to_contain("VersionedDynLib.load_plugin_path")
        expect(source).to_contain("HostOfferV1")
        expect(source).to_contain(
            "library.lib.sym_checked(DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1)"
        )
        expect(source.contains("extern fn")).to_be(false)
        expect(source.contains(".call0(")).to_be(false)
        expect(source.contains(".call_n(")).to_be(false)
        expect(source.contains("spl_wffi_call")).to_be(false)

    it "fails closed and closes the library when the entry symbol is missing":
        step("inspect missing-symbol cleanup before returning the typed error")
        val source = read_file(DYNAMIC_LOADER_SOURCE)
        val missing_branch = source.split("case Err(detail):")[2]
        expect(missing_branch).to_contain("library.lib.close()")
        expect(missing_branch).to_contain(
            "DynamicBackendPluginLoadError.MissingSymbol"
        )

    it "retains the raw address only as a lease for the typed bridge":
        step("keep raw invocation out of the Simple lease owner")
        val source = read_file(DYNAMIC_LOADER_SOURCE)
        val empty_path = unsafe(capabilities: [ffi, raw_ptr]):
            load_dynamic_backend_plugin_lease("", "fixture", HostOfferV1(
                ParamHeader("simple.plugin.HostOfferV1", 1, 0, 0),
                0, true, "test", [], [], [], []))
        val empty_path_code = match empty_path:
            case Err(error): error.code()
            case Ok(_): "ok"
        expect(empty_path_code).to_equal("PLUG-E-OPEN")
        expect(source).to_contain("Ok(true)")
        expect(source).to_contain("provider negotiation refused")
        val unsupported = DynamicBackendPluginLoadError.Unsupported(
            "typed descriptor ABI is unavailable"
        )
        expect(unsupported.code()).to_equal(
            "PLUG-E-ENTRY"
        )
        expect(source.contains("admit_backend_plugin_descriptor(")).to_be(false)
