#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
# A tiny native ABI test, independent of compiler/bootstrap build artifacts.
${CC:-cc} -std=c11 -Wall -Wextra -Werror -fsanitize="${SBP_SANITIZERS:-undefined}" \
    -fno-omit-frame-pointer -I"$root/src/runtime" \
    "$root/test/01_unit/compiler/backend_plugin/fixtures/backend_plugin_v1_batch_diagnostics_host.c" \
    -ldl -o "$tmp/batch-diagnostics"
(ulimit -c 0; ulimit -t 10; "$tmp/batch-diagnostics")
