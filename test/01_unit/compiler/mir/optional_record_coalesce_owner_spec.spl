use std.spec
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable, HirSymbol, SymbolKind, ScopeId}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*

fn lower_coalesce_placeholder(present: bool, placeholder: HirType) -> (i64, i64, i64):
    val span = Span.empty()
    val owner = SymbolId(id: 77)
    val record = HirType(kind: HirTypeKind.Named(owner, []), span: span)
    val optional = HirType(kind: HirTypeKind.Optional(record), span: span)
    var symbols = SymbolTable.new()
    symbols.register_preserved_symbol(HirSymbol(id: owner, name: "Record",
        kind: SymbolKind.Struct, type_: nil, scope: ScopeId(id: 0), span: span,
        visibility: Visibility.Public, is_public: true, is_mutable: false,
        defining_module: Some("provider")))
    var lowering = MirLowering.new(symbols)
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 90), "probe", MirSignature(params: [],
        return_type: MirType.unit(), is_variadic: false), span)
    val left_local = builder.new_temp(MirType.i64())
    val right_local = builder.new_temp(MirType(kind: MirTypeKind.Struct(owner)))
    lowering.builder = builder
    lowering.bind_local(20, left_local)
    lowering.bind_local(21, right_local)
    lowering.remember_local_hir_type(left_local.id, optional, 0, 0)
    lowering.remember_local_hir_type(right_local.id, record, 0, 0)
    val left = HirExpr(kind: HirExprKind.Var(SymbolId(id: 20)),
        has_type_: false, type_: placeholder, span: span)
    val right = HirExpr(kind: HirExprKind.Var(SymbolId(id: 21)),
        has_type_: false, type_: placeholder, span: span)
    val expression = HirExpr(kind: HirExprKind.NullCoalesce(left, right),
        has_type_: present, type_: placeholder, span: span)
    val result = lowering.lower_expr(expression)
    var hir_owner = -1
    if val retained = lowering.find_local_hir_type(result.id):
        match retained.kind:
            case HirTypeKind.Named(symbol, _): hir_owner = symbol.id
            case _: ()
    var mir_owner = -1
    if val retained = lowering.local_mir_type_of(result):
        match retained.kind:
            case MirTypeKind.Struct(symbol): mir_owner = symbol.id
            case _: ()
    (lowering.errors.len(), hir_owner, mir_owner)

fn coalesce_owner_diagnostics(source: text) -> text:
    val filename = "coalesce_owner.spl"
    val parsed = parse_full_frontend(source, filename, filename, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(filename)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var errors: [text] = []
    for error in hir_lowering.errors:
        errors = errors.push("HIR: " + error.message)
    for error in lowering.errors:
        errors = errors.push("MIR: " + error.message)
    if mir.functions.len() == 0:
        errors = errors.push("no lowered functions")
    errors.join("\n")

describe "optional record coalesce owner":
    it "ignores absent nonnil type placeholders in transported HIR":
        for kind in [HirTypeKind.Bool, HirTypeKind.Error]:
            val result = lower_coalesce_placeholder(false, HirType(kind: kind, span: Span.empty()))
            expect(result.0).to_equal(0)
            expect(result.1).to_equal(77)
            expect(result.2).to_equal(77)
    it "treats a present Error annotation as unresolved rather than authoritative":
        val result = lower_coalesce_placeholder(true, HirType(kind: HirTypeKind.Error, span: Span.empty()))
        expect(result.0).to_equal(0)
        expect(result.1).to_equal(77)
        expect(result.2).to_equal(77)
    it "retains the enum field owner when another enum has the same variants":
        val source = "enum Value:\n    Int(i64)\n    Text(text)\nenum Other:\n    Int(i64)\n    Text(text)\nstruct Operand:\n    prefix: text\n    kind: Value\nfn fallback() -> Operand:\n    Operand(prefix: \"prefix\", kind: Value.Int(7))\nfn read(value: Operand?) -> i64:\n    val payload = value ?? fallback()\n    match payload.kind:\n        case Int(number): number\n        case Text(_): 0\n"
        expect(coalesce_owner_diagnostics(source)).to_equal("")
    it "rejects a fallback with a different record owner":
        val source = "struct First:\n    value: i64\nstruct Second:\n    value: i64\nfn read(value: First?) -> i64:\n    val payload = value ?? Second(value: 3)\n    payload.value\n"
        expect(coalesce_owner_diagnostics(source)).to_contain("null coalesce fallback does not match declared record owner")
