use std.spec.*
use compiler.mir.text_extern_abi.{boxed_text_arg_indices, text_arg_indices}

describe "atomic publication text ownership":
    it "keeps path and complete content tagged for both atomic variants":
        expect(boxed_text_arg_indices("rt_file_atomic_write").unwrap()).to_equal([0, 1])
        expect(boxed_text_arg_indices("rt_file_atomic_write_mode").unwrap()).to_equal([0, 1])
        expect(text_arg_indices("rt_file_atomic_write")).to_be_nil()
        expect(text_arg_indices("rt_file_atomic_write_mode")).to_be_nil()
    it "does not rewrite foreign homonymous providers":
        expect(boxed_text_arg_indices("other.rt_file_atomic_write")).to_be_nil()
        expect(boxed_text_arg_indices("other.rt_file_atomic_write_mode")).to_be_nil()
