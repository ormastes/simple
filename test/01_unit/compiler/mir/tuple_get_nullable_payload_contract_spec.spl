use std.io_runtime.{file_read}

use std.spec.step

describe "compiler tuple projection SFFI contract":
    it "keeps arbitrary and nil tuple payloads representable":
        step("uses Any at both compiler tuple projection boundaries")
        for path in [
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl",
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl"
        ]:
            val source = file_read(path)
            expect(source).to_contain("extern fn rt_tuple_get(tuple: i64, index: i64) -> Any")
            expect(source).to_contain("fn _sffi_tuple_get(tuple: i64, index: i64) -> Any:")
            expect(source.contains("fn _sffi_tuple_get(tuple: i64, index: i64) -> i64:")).to_be(false)
