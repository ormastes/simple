"""Unsupported expressions retain recovery locals but must block code publication."""
use std.spec.*
use std.spec.step
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolTable}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_types.{MirTypeKind}

describe "Unsupported MIR expressions fail closed":
    it "records a fatal diagnostic and preserves its code and source span":
        step("Invoke the actual unsupported-expression owner with a source location")
        var lowering = MirLowering.new(SymbolTable.new())
        var source_span = Span.empty()
        source_span.file = "unsupported_fixture.spl"
        source_span.line = 7
        source_span.col = 3
        val recovered = lowering.unsupported_expr_kind("E-MIR-EXPR-Lambda", "lambda expression", source_span)
        expect(lowering.errors.len()).to_equal(1)
        val diagnostic = lowering.errors[0]
        expect(diagnostic.fatal).to_equal(true)
        expect(diagnostic.message).to_equal("E-MIR-EXPR-Lambda: MIR lowering does not support this lambda expression")
        expect(diagnostic.span.?).to_equal(true)
        if val recorded = diagnostic.span:
            expect(recorded.file).to_equal("unsupported_fixture.spl")
            expect(recorded.line).to_equal(7)
            expect(recorded.col).to_equal(3)
        expect(recovered.id >= 0).to_equal(true)
        expect(recovered.id < lowering.builder.locals.len()).to_equal(true)
        if recovered.id >= 0 and recovered.id < lowering.builder.locals.len():
            val local = lowering.builder.locals[recovered.id]
            expect(local.id.id).to_equal(recovered.id)
            expect(local.type_.kind == MirTypeKind.Unit).to_equal(true)

    it "drains more than one unsupported expression while keeping each fatal":
        step("Recover from two expressions without losing either blocking diagnostic")
        var lowering = MirLowering.new(SymbolTable.new())
        val first = lowering.unsupported_expr_kind("E-MIR-EXPR-Lambda", "lambda expression", Span.empty())
        val second = lowering.unsupported_expr_kind("E-MIR-EXPR-StaticCall", "static call", Span.empty())
        expect(lowering.errors.len()).to_equal(2)
        expect(lowering.errors[0].fatal).to_equal(true)
        expect(lowering.errors[1].fatal).to_equal(true)
        expect(first.id >= 0).to_equal(true)
        expect(second.id > first.id).to_equal(true)
        expect(second.id < lowering.builder.locals.len()).to_equal(true)
        if first.id >= 0 and second.id > first.id and second.id < lowering.builder.locals.len():
            expect(lowering.builder.locals[first.id].type_.kind == MirTypeKind.Unit).to_equal(true)
            expect(lowering.builder.locals[second.id].type_.kind == MirTypeKind.Unit).to_equal(true)

    it "keeps ordinary advisory diagnostics nonfatal":
        step("Use the separate advisory API as a negative control")
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.error("advisory control", nil)
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].message).to_equal("advisory control")
        expect(lowering.errors[0].fatal).to_equal(false)
