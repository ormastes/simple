use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir._MirLoweringExpr.source_region_result_payload_codec_v1.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir.mir_lowering_stmts.*

fn codec_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn codec_owner() -> MirLowering:
    var owner = MirLowering.new(SymbolTable.new())
    var builder = owner.builder
    builder.begin_function(SymbolId(id: 90), "actual_codec_owner", MirSignature(params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
    owner.builder = builder
    owner

describe "source Result codec uses actual owning lowering":
    it "preserves floating payload bits with canonical bitcasts":
        var owner = codec_owner()
        val floating = codec_type(HirTypeKind.Float(64))
        var builder = owner.builder
        val value = builder.new_temp(MirType.f64())
        builder.emit_const(value, MirConstValue.Float(2.5), MirType.f64())
        owner.builder = builder
        owner.remember_local_hir_type(value.id, floating, 0, 0)
        match owner.encode_source_region_result_payload_v1(value, floating):
            case Ok(encoded):
                expect(encoded.id > value.id).to_equal(true)
                match owner.decode_source_region_result_payload_v1(encoded, floating):
                    case Ok(decoded):
                        val actual = owner.local_mir_type_of(decoded) ?? MirType.unit()
                        expect(actual.kind == MirTypeKind.F64).to_equal(true)
                    case Err(message): fail(message)
            case Err(message): fail(message)
        var finished = owner.builder
        val function = finished.end_function()
        var bitcasts = 0
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Bitcast(_, _, _): bitcasts = bitcasts + 1
                    case _: ()
        expect(bitcasts).to_equal(2)

    it "retains nested Result identity through encode and decode":
        var owner = codec_owner()
        val integer = codec_type(HirTypeKind.Int(64, true))
        val inner = codec_type(HirTypeKind.Result(integer, integer))
        var builder = owner.builder
        val handle = builder.new_temp(MirType(kind: MirTypeKind.Result(MirType.i64(), MirType.i64())))
        owner.builder = builder
        owner.remember_local_hir_type(handle.id, inner, 0, 0)
        match owner.encode_source_region_result_payload_v1(handle, inner):
            case Ok(encoded): expect(encoded.id).to_equal(handle.id)
            case Err(message): fail(message)
        match owner.decode_source_region_result_payload_v1(handle, inner):
            case Ok(decoded):
                expect(decoded.id).to_equal(handle.id)
                expect(owner.find_local_hir_type(decoded.id).is_some()).to_equal(true)
            case Err(message): fail(message)

    it "restores collection provenance and exact tuple layout in the real owner":
        var owner = codec_owner()
        var builder = owner.builder
        val raw = builder.emit_const_int(0)
        owner.builder = builder
        val integer = codec_type(HirTypeKind.Int(64, true))
        val array_type = codec_type(HirTypeKind.Array(integer, nil))
        match owner.decode_source_region_result_payload_v1(raw, array_type):
            case Ok(decoded):
                expect(owner.runtime_array_locals.has(decoded.id)).to_equal(true)
                expect(owner.runtime_elem_value_type.has(decoded.id)).to_equal(true)
                expect(owner.find_local_hir_type(decoded.id).is_some()).to_equal(true)
            case Err(message): fail(message)
        val tuple_type = codec_type(HirTypeKind.Tuple([integer, codec_type(HirTypeKind.Bool)]))
        match owner.decode_source_region_result_payload_v1(raw, tuple_type):
            case Ok(decoded):
                expect(decoded.id > raw.id).to_equal(true)
                val actual = owner.local_mir_type_of(decoded) ?? MirType.unit()
                match actual.kind:
                    case MirTypeKind.Tuple(fields):
                        expect(fields.len()).to_equal(2)
                        expect(fields[0].kind == MirTypeKind.I64).to_equal(true)
                        expect(fields[1].kind == MirTypeKind.Bool).to_equal(true)
                    case _: fail("canonical tuple recovery lost layout")
            case Err(message): fail(message)

    it "rejects missing local ownership and contradictory HIR provenance":
        var owner = codec_owner()
        val integer = codec_type(HirTypeKind.Int(64, true))
        expect(owner.decode_source_region_result_payload_v1(LocalId(id: 999), integer).is_err()).to_equal(true)
        var builder = owner.builder
        val local = builder.emit_const_int(7)
        owner.builder = builder
        expect(owner.encode_source_region_result_payload_v1(local, integer).is_err()).to_equal(true)
        owner.remember_local_hir_type(local.id, codec_type(HirTypeKind.Bool), 0, 0)
        expect(owner.encode_source_region_result_payload_v1(local, integer).is_err()).to_equal(true)
