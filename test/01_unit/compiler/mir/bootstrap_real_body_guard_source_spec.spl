extern fn rt_file_read_text(path: text) -> text?

fn bootstrap_globals_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""

describe "bootstrap real body guard source":
    it "rejects zero-instruction bootstrap entry modules on both lowering paths":
        val source = bootstrap_globals_source()

        expect(source).to_contain("var instruction_total = 0")
        expect(source).to_contain("if entry_instruction_total == 0:")
        expect(source).to_contain("if real_instr_total == 0:")
        expect(source).to_contain("error: bootstrap entry lowered to 0 MIR instructions (ret-0 stub module)")
        expect(source).to_contain("error: refusing to emit a stub-only bootstrap binary; real Simple lowering produced no bodies")
