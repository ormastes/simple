extern fn rt_file_read_text(path: text) -> text

fn bootstrap_globals_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""

fn method_calls_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""

describe "bootstrap real body guard source":
    it "counts terminators as real bootstrap MIR body operations":
        val source = bootstrap_globals_source()

        expect(source).to_contain("var real_term_total = 0")
        expect(source).to_contain("case MirTerminator.Unreachable:")
        expect(source).to_contain("real_term_total = real_term_total + 1")
        expect(source).to_contain("real_instr_total == 0 and real_term_total == 0")

    it "fails closed when flat bootstrap MIR lowering reports a fatal error":
        val bootstrap_source = bootstrap_globals_source()
        val method_source = method_calls_source()

        expect(method_source).to_contain("self.error_fatal(\"unresolved method call: {method}\", nil)")
        expect(bootstrap_source).to_contain("fn bootstrap_abort_on_fatal_mir_errors(errors: [MirError], module_name: text):")
        expect(bootstrap_source).to_contain("if err.fatal:")
        expect(bootstrap_source).to_contain("bootstrap_abort_on_fatal_mir_errors(lowering.errors, module_name)")
        expect(bootstrap_source).to_contain("bootstrap_abort_on_fatal_mir_errors(lowering.errors, hir_module.name)")
