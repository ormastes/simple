# Struct copy / structural eq over generic + Option-typed fields.
# Exercises the MIR paths that read struct_field_hir_type elements and pass
# them to native_trait_value_type -> native_trait_owner_for_type
# (s3_fable45 F3 AV at native_trait_owner_for_type+0x202e).

struct Pair<T>:
    first: T?
    rest: [T]

struct Holder:
    inner: Pair<text>
    count: i64

describe "struct field trait copy bare rebuild":
    it "copies a struct with generic Option/array fields by value":
        val a = Holder(inner: Pair(first: Some("x"), rest: ["y", "z"]), count: 2)
        val b = a
        expect(b.count).to_equal(2)
        expect(b.inner.rest.len()).to_equal(2)
        expect(b.inner.first ?? "").to_equal("x")

    it "compares structs with generic fields structurally":
        val a = Pair(first: Some(1), rest: [2, 3])
        val b = Pair(first: Some(1), rest: [2, 3])
        expect(a.rest == b.rest).to_equal(true)
