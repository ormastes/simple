"""
Returned array element metadata must survive calls into field projections.
The test always builds and executes a native binary; running this SSpec in
the interpreter does not replace the native assertions. Set SIMPLE_NATIVE_COMPILER
to an admitted self-hosted compiler with its source inventory initialized.
"""
use std.spec.*
use std.io_runtime.{env_get, process_run_timeout, dir_create_all, getpid, time_now_unix_micros}
use compiler.mir.mir_data.{
    bootstrap_fn_ret_array_element_shape_register,
    bootstrap_fn_ret_array_element_shape_lookup
}

describe "native returned struct array provenance":
    it "keeps bytewise sorting, text fields and nonzero field offsets":
        val compiler = env_get("SIMPLE_NATIVE_COMPILER") ?? ""
        # Missing native tooling is a failure, never an interpreter fallback.
        expect(compiler.len()).to_be_greater_than(0)
        val directory = "build/test/returned_struct_array_native_{getpid()}_{time_now_unix_micros()}"
        val output = directory + "/probe"
        expect(dir_create_all(directory)).to_equal(true)
        val (build_out, build_err, build_code) = process_run_timeout(compiler, [
            "native-build", "--backend", "llvm", "--threads", "1",
            "--mode", "dynload", "-o", output,
            "test/fixtures/native_returned_struct_array_sort/main.spl"
        ], 360000)
        expect(build_code).to_equal(0)
        val (native_out, native_err, native_code) = process_run_timeout("./" + output, [], 10000)
        expect(native_code).to_equal(0)
        expect(native_out).to_equal(
            "count=3\nfirst=src/app/B.spl:10\nsecond=src/app/__init__.spl:20\nthird=src/app/audit/ffi_analyzer.spl:30\n")

# These are metadata API tests; the preceding native execution remains required.
describe "returned array element identity collisions":
    it "rejects same-named structs owned by distinct modules":
        val name = "returned_array_collision_probe"
        bootstrap_fn_ret_array_element_shape_register(name, "Row", "module_a::Row")
        bootstrap_fn_ret_array_element_shape_register(name, "Row", "module_b::Row")
        expect(bootstrap_fn_ret_array_element_shape_lookup(name)).to_be_nil()

    it "keeps repeated registrations of the same owner":
        val name = "returned_array_repeat_probe"
        bootstrap_fn_ret_array_element_shape_register(name, "Row", "module_a::Row")
        bootstrap_fn_ret_array_element_shape_register(name, "Row", "module_a::Row")
        expect(bootstrap_fn_ret_array_element_shape_lookup(name) ?? "").to_equal("Row")

    it "rejects a scalar array sharing a struct array call name":
        val name = "returned_array_scalar_collision_probe"
        bootstrap_fn_ret_array_element_shape_register(name, "Row", "module_a::Row")
        bootstrap_fn_ret_array_element_shape_register(name, "__no_struct_element__", "__no_struct_element__")
        expect(bootstrap_fn_ret_array_element_shape_lookup(name)).to_be_nil()
