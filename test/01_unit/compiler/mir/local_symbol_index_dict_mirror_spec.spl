use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

# stage2_local_symbol_index_bucket_tagged_id_2026-11-03 RETIRED:
# The `local_map` Dict mirror and `mirror_binding` / `restore_mirror_bindings`
# workaround are retired now that uniform P3 resolves `[i64]` hashed buckets
# directly without tagged-id corruption. This spec pins the retired contract.
fn fn_body(src: text, header: text, stop: text) -> text:
    val start = src.index_of(header)
    if start < 0:
        return ""
    val rest = src.substring(start, src.len())
    val end = rest.index_of(stop)
    if end < 0:
        return rest
    rest.substring(0, end)

describe "MIR local-symbol index local_map mirror is retired":
    it "MirLowering no longer carries local_map, mirror_binding, or restore_mirror_bindings":
        val src = file_read("src/compiler/50.mir/mir_lowering_types.spl")
        expect(src.contains("local_map: Dict<i64, LocalId>")).to_equal(false)
        expect(src.contains("mirror_binding(")).to_equal(false)
        expect(src.contains("restore_mirror_bindings(")).to_equal(false)
        expect(src.contains("@workaround bug=stage2_local_symbol_index_bucket_tagged_id_2026-11-03")).to_equal(false)

    it "bind_local and find_local use the hashed index directly without local_map":
        val src = file_read("src/compiler/50.mir/mir_lowering_types.spl")
        val bind_body = fn_body(src, "me bind_local(symbol_id: i64, local: LocalId):", "fn find_local(")
        val find_body = fn_body(src, "fn find_local(symbol_id: i64) -> LocalId:", "fn hir_type_mentions_type_param(")
        expect(bind_body.len() > 0).to_equal(true)
        expect(find_body.len() > 0).to_equal(true)
        expect(bind_body.contains("self.local_map")).to_equal(false)
        expect(find_body.contains("self.local_map")).to_equal(false)
        expect(find_body).to_contain("self.local_symbol_slot(symbol_id)")

    it "every wholesale array rollback site restores arrays without mirror rollback":
        val calls = file_read("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")
        val named_lambda = fn_body(calls, "me try_inline_lambda_call(symbol: SymbolId, args: [HirCallArg]) -> LocalId?:", "me lower_inline_lambda_with_locals(")
        val inline_lambda = fn_body(calls, "me lower_inline_lambda_with_locals(", "me lower_iife_call(")
        val extras = file_read("src/compiler/50.mir/_MirLoweringExpr/builtin_method_extras.spl")
        val comprehension = fn_body(extras, "# The comprehension variable is scoped to the comprehension.", "var value_array_hir: HirType? = nil")
        for body in [named_lambda, inline_lambda, comprehension]:
            expect(body.len() > 0).to_equal(true)
            expect(body.contains("@workaround bug=stage2_local_symbol_index_bucket_tagged_id_2026-11-03")).to_equal(false)
            expect(body.contains("self.mirror_binding(")).to_equal(false)
            expect(body.contains("self.restore_mirror_bindings(")).to_equal(false)
            expect(body).to_contain("self.local_symbol_index_slots = saved_index_slots")

    it "function reset no longer clears local_map":
        val src = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(src.contains("self.local_map = {}")).to_equal(false)
        expect(src).to_contain("self.local_symbol_ids = []")
