use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn copy_function_mir(source: text, target: text) -> text:
    val ast = parse_full_frontend(source, "typed_array_copy.spl", "typed_array_copy.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("typed_array_copy.spl")
    val hir = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var serialized = ""
    for error in hir_lowering.errors:
        serialized = serialized + "HIR_ERROR:" + error.message + "\n"
    for error in mir_lowering.errors:
        serialized = serialized + "MIR_ERROR:" + error.message + "\n"
    for function in mir.functions.values():
        if function.name == target or function.name.ends_with("." + target):
            serialized = serialized + serialize_mir_function(function)
    serialized

describe "typed byte-array value copy lowering":
    it "normalizes packed byte reads before storing them in the copied generic array":
        val mir = copy_function_mir(
            "fn copy_bytes(data: [u8]) -> [u8]:\n    val copied = data\n    copied\n", "copy_bytes")
        expect(mir.contains("HIR_ERROR:")).to_equal(false)
        expect(mir.contains("MIR_ERROR:")).to_equal(false)
        expect(mir).to_contain("rt_bytes_u8_at")
        expect(mir).to_contain("rt_value_int_wide")
        expect(mir).to_contain("rt_array_push")
        expect(mir.contains("rt_array_get")).to_equal(false)

    it "keeps the source U8 element type when the destination is erased Any":
        val mir = copy_function_mir(
            "fn copy_bytes_through_any(data: [u8]) -> Any:\n    val source: Any = data\n    source\n",
            "copy_bytes_through_any")
        expect(mir.contains("HIR_ERROR:")).to_equal(false)
        expect(mir.contains("MIR_ERROR:")).to_equal(false)
        expect(mir).to_contain("rt_bytes_u8_at")
        expect(mir).to_contain("rt_value_int_wide")
        expect(mir).to_contain("rt_array_push")

    it "preserves the bit-for-bit tagged-word copy path for other element types":
        val mir = copy_function_mir(
            "fn copy_words(data: [i64]) -> [i64]:\n    val copied = data\n    copied\n", "copy_words")
        expect(mir.contains("HIR_ERROR:")).to_equal(false)
        expect(mir.contains("MIR_ERROR:")).to_equal(false)
        expect(mir).to_contain("rt_array_get")
        expect(mir.contains("rt_bytes_u8_at")).to_equal(false)
