# Regression: text .bytes() on a receiver whose type is inferred from trim()
# bug: mir_text_bytes_unresolved_inferred_trim_receiver_2026-10-23 (UNEXECUTED)
use std.spec.*

fn _bytes_len_of_trimmed(source: text) -> i64:
    val trimmed = source.trim()
    val bytes = trimmed.bytes()
    bytes.len()

describe "text bytes on inferred trim receiver":
    it "lowers and returns the byte length":
        expect(_bytes_len_of_trimmed("  123  ")).to_equal(3)
