use std.spec
use compiler.frontend.parser_types_expr.{AsmConstraintKind, AsmLocation}
use compiler.mir.mir_instructions.{
    BlockId, LocalId, MirAsmOperand, MirBorrowKind, MirConstValue, MirInstKind,
    MirOperand, MirOperandKind, MirPlace, MirProjection, MirTerminator, MirType
}
use compiler.mir.mir_used_local_collector.{
    mir_used_local_ids_instruction_v1, mir_used_local_ids_operand_v1,
    mir_used_local_ids_place_v1, mir_used_local_ids_terminator_v1
}

fn used_local(id: i64) -> LocalId:
    LocalId(id: id)

fn used_copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(used_local(id)))

fn used_move(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Move(used_local(id)))

fn expect_used_ids(actual: [LocalId], expected: [i64]):
    expect(actual.len()).to_equal(expected.len())
    var index = 0
    while index < expected.len():
        expect(actual[index].id).to_equal(expected[index])
        index = index + 1

describe "MIR used-local collector V1":
    it "collects only local-bearing operand forms":
        expect_used_ids(mir_used_local_ids_operand_v1(used_copy(3)), [3])
        expect_used_ids(mir_used_local_ids_operand_v1(used_move(4)), [4])
        expect_used_ids(mir_used_local_ids_operand_v1(MirOperand(
            kind: MirOperandKind.Const(MirConstValue.Int(7), MirType.i64())
        )), [])

    it "collects a place root and every dynamic index projection":
        val place = MirPlace(
            local: used_local(1),
            projection: [
                MirProjection.Deref,
                MirProjection.Field(2),
                MirProjection.Index(used_local(3)),
                MirProjection.Downcast(1),
                MirProjection.Index(used_local(4))
            ]
        )
        expect_used_ids(mir_used_local_ids_place_v1(place), [1, 3, 4])

    it "covers scalar, aggregate, call, probe, and SIMD operand matrices":
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.GetElementPtr(used_local(0), used_copy(1), [used_move(2), used_copy(3)])
        ), [1, 2, 3])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.Call(nil, used_copy(4), [used_move(5), used_copy(6)])
        ), [4, 5, 6])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.ConditionProbe(8, "condition:8", 7, "decision:7", used_copy(9), "src/a.spl", 1, 0)
        ), [9])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.MaskedFma(used_local(10), used_copy(11), used_copy(12), used_move(13), used_copy(14))
        ), [11, 12, 13, 14])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.PredicatedFma(used_local(15), "eq", used_copy(16), used_copy(17), used_copy(18), used_move(19), used_copy(20))
        ), [16, 17, 18, 19, 20])

    it "conservatively collects both inline-assembly input and output operands":
        val input = MirAsmOperand(
            name: "in", kind: AsmConstraintKind.In, location: AsmLocation.Reg,
            operand: used_copy(21)
        )
        val output = MirAsmOperand(
            name: "out", kind: AsmConstraintKind.Out, location: AsmLocation.Reg,
            operand: used_move(22)
        )
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.InlineAsm("", true, [input], [output], [])
        ), [21, 22])

    it "covers optional operands, place references, and port-map pairs":
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.Yield(Some(used_copy(23)))
        ), [23])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.Receive(used_local(24), nil)
        ), [])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.Ref(used_local(25), MirBorrowKind.Shared, MirPlace.local_place(used_local(26)))
        ), [26])
        expect_used_ids(mir_used_local_ids_instruction_v1(
            MirInstKind.VhdlPortMap("entity", "instance", [("port", used_copy(27))])
        ), [27])

    it "covers every terminator operand-bearing shape":
        expect_used_ids(mir_used_local_ids_terminator_v1(MirTerminator.Goto(BlockId.entry())), [])
        expect_used_ids(mir_used_local_ids_terminator_v1(MirTerminator.Ret(Some(used_copy(28)))), [28])
        expect_used_ids(mir_used_local_ids_terminator_v1(
            MirTerminator.If(used_move(29), BlockId.entry(), BlockId.entry())
        ), [29])
        expect_used_ids(mir_used_local_ids_terminator_v1(
            MirTerminator.CallTerminator(nil, used_copy(30), [used_move(31)], BlockId.entry(), nil)
        ), [30, 31])
