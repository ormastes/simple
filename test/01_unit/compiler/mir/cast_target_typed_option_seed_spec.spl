# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
Stage 2 (Rust seed native-build of the self-hosted compiler) failed with
`hir: Cannot infer field type: struct 'ANY' field 'kind'` in
`src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl`: the seed types an
`if val x = _sffi_tuple_get<HirType>(...)` binding as ANY, and `x.kind` is
ambiguous across many structs. The Cast/ConvertCall target reads must go
through an explicitly typed `HirType?` local before the `if val` rebuild.
"""

use std.spec.step

describe "MIR cast target decode stays seed-typeable":
    extern fn rt_file_read_text(path: text) -> text?

    fn dispatch_source() -> text:
        rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""

    it "reads Cast/ConvertCall targets through typed HirType? locals":
        val source = dispatch_source()
        expect(source).to_contain("val present_target_opt: HirType? = _sffi_tuple_get<HirType>(cast_payload, 1)")
        expect(source).to_contain("val present_cast_target_opt: HirType? = _sffi_tuple_get<HirType>(cast_payload, 1)")
        expect(source).to_contain("val present_convert_target_opt: HirType? = _sffi_tuple_get<HirType>(convert_payload, 1)")

    it "has no untyped if-val binding of a generic HirType tuple read":
        val source = dispatch_source()
        expect(source.contains("= _sffi_tuple_get<HirType>(cast_payload, 1):")).to_equal(false)
        expect(source.contains("= _sffi_tuple_get<HirType>(convert_payload, 1):")).to_equal(false)
