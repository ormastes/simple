# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use std.io_runtime.{file_read}
use compiler.mir.mir_instructions.{

    BlockId,
    LocalId,
    MirType,
    MirConstValue,
    MirOperand,
    MirOperandKind,
    MirInst,
    MirInstKind,
    MirBlock,
    MirTerminator,
    mir_operand_const_int
}

describe "split MIR instruction ownership":
    # @manual scenario evidence
    it "keeps the compatibility facade and owners bounded":
        # @req REQ-SSPEC-COMPILER
        step("keeps the compatibility facade and owners bounded")
        val facade = file_read("src/compiler/50.mir/mir_instructions.spl")
        val support = file_read("src/compiler/50.mir/mir_instruction_support.spl")
        val kinds = file_read("src/compiler/50.mir/mir_instruction_kinds.spl")
        val graph = file_read("src/compiler/50.mir/mir_instruction_graph.spl")

        expect(facade.len()).to_be_less_than(2000)
        expect(support.len()).to_be_less_than(12000)
        expect(kinds.len()).to_be_less_than(15000)
        expect(graph.len()).to_be_less_than(9000)

    it "constructs instructions and blocks through compatibility exports":
        # @req REQ-SSPEC-COMPILER
        step("constructs instructions and blocks through compatibility exports")
        val operand = mir_operand_const_int(41)
        val inst = MirInst(
            kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Int(42), MirType.i64()),
            span: nil
        )
        val block = MirBlock(
            id: BlockId.entry(),
            label: Some("entry"),
            instructions: [inst],
            terminator: MirTerminator.Ret(Some(operand))
        )

        expect(block.id.id).to_equal(0)
        expect(block.instructions.len()).to_equal(1)
        match operand.kind:
            case MirOperandKind.Const(value, _):
                match value:
                    case MirConstValue.Int(int_value):
                        expect(int_value).to_equal(41)
                    case _:
                        expect(false).to_equal(true)
            case _:
                expect(false).to_equal(true)
