use std.spec.{describe, it, expect}
use compiler.hir.hir_types.{SymbolTable, SymbolKind}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.mir._MirLowering.provider_metadata.{mir_provider_declares_value_method_owner}

describe "provider value methods require their exact declaration owner":
    it "admits a struct declaration without a class layout":
        var provider = SymbolTable.new()
        val declaration = provider.define("Counter", SymbolKind.Struct, nil,
            Span.empty(), Visibility.Public, false, Some("fixture.owner"))
        expect(declaration.id >= 0).to_equal(true)
        expect(mir_provider_declares_value_method_owner(provider,
            "fixture.owner", "Counter", "fixture.owner.Counter")).to_equal(true)

    it "preserves enum ownership admission":
        var provider = SymbolTable.new()
        val declaration = provider.define("State", SymbolKind.Enum, nil,
            Span.empty(), Visibility.Public, false, Some("fixture.owner"))
        expect(declaration.id >= 0).to_equal(true)
        expect(mir_provider_declares_value_method_owner(provider,
            "fixture.owner", "State", "fixture.owner.State")).to_equal(true)

    it "rejects absent declarations and another owner's same-name fallback":
        var provider = SymbolTable.new()
        val declaration = provider.define("Counter", SymbolKind.Struct, nil,
            Span.empty(), Visibility.Public, false, Some("fixture.other"))
        expect(declaration.id >= 0).to_equal(true)
        expect(mir_provider_declares_value_method_owner(provider,
            "fixture.owner", "Counter", "fixture.owner.Counter")).to_equal(false)
        expect(mir_provider_declares_value_method_owner(provider,
            "fixture.other", "Missing", "fixture.other.Missing")).to_equal(false)
        expect(mir_provider_declares_value_method_owner(provider,
            "fixture.other", "Counter", "fixture.owner.Counter")).to_equal(false)

    it "does not admit a class through the value-owner fallback":
        var provider = SymbolTable.new()
        val declaration = provider.define("Counter", SymbolKind.Class, nil,
            Span.empty(), Visibility.Public, false, Some("fixture.owner"))
        expect(declaration.id >= 0).to_equal(true)
        expect(mir_provider_declares_value_method_owner(provider,
            "fixture.owner", "Counter", "fixture.owner.Counter")).to_equal(false)
