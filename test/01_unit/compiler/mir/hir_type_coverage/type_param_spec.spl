use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.TypeParam":
    it "lowers an erased T slot to the tagged runtime word":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.TypeParam(_, _):")
        expect(source).to_contain("Generics = ONE ERASED BODY per generic fn")
