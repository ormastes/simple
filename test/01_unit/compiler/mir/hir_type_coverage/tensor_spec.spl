use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Tensor":
    it "normalizes Tensor to MirTypeKind.Opaque(\"tensor\")":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Tensor(_, _, _):")
        expect(source).to_contain("MirType(kind: MirTypeKind.Opaque(\"tensor\"))")
