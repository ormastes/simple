use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Projection":
    it "raises the named diagnostic E-MIR-TYPE-Projection with the source span":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Projection(_, assoc_name):")
        expect(source).to_contain("E-MIR-TYPE-Projection: unresolved associated type projection")
        expect(source).to_contain("reached MIR lowering\", Some(type_.span))")
