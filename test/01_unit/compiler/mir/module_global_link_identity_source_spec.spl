use std.spec.{describe, it, expect}

fn read_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "module-global link identity":
    it "uses defining-module identity instead of compile-local SymbolId":
        val lowering = read_source("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        val cranelift = read_source("src/compiler/70.backend/backend/cranelift_codegen_adapter.spl")

        expect(lowering).to_contain("symbol_info.defining_module")
        expect(lowering).to_contain("global_link_name")
        expect(lowering).to_contain("name: global_link_name")
        expect(cranelift).to_contain("val name = \"__simple_global_")
        expect(cranelift).to_not_contain("static_.name}_" + "static_.symbol.id")

    it "maps per-module aliases to one bootstrap LLVM storage slot":
        # The bootstrap statics are emitted by the MIR->LLVM translator that
        # driver_bootstrap.spl drives via `emit_bootstrap_statics`.
        val emitter = read_source("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl")

        expect(emitter).to_contain("var emitted_names: Dict<text, bool> = {}")
        expect(emitter).to_contain("val g_name = \"@g_")
        expect(emitter).to_contain("if not emitted_names.contains(g_name):")
        expect(emitter).to_not_contain("@g_" + "module_idx" + "_symbol_id")
