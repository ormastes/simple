"""Strict ownership metadata survives MIR body owner constructors."""
use std.spec
use compiler.mir.mir_instruction_graph.{MirBody, MirFunction}
use compiler.mir.mir_types.{MirType, MirSignature}
use compiler.mir.mir_data.{MirBuilder}
use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}

describe "NoGC call contract transport":
    it "keeps verified exact-symbol effects in an ordinary body":
        val contracts: Dict<text, [text]> = {"sample.owner.borrow": ["read-short", "mutate-short"]}
        val body = MirBody.from_parts("sample.owner.caller", [], [], 0, MirType.unit(), true, contracts)
        expect(body.nogc_strict).to_equal(true)
        expect(body.short_call_contracts["sample.owner.borrow"]).to_equal(["read-short", "mutate-short"])
        expect(body.short_call_contracts.has("borrow")).to_equal(false)

    it "keeps strict policy in the flat bootstrap body route":
        val contracts: Dict<text, [text]> = {"sample.owner.take": ["consume"]}
        val body = MirBody.from_bootstrap_parts("sample.owner.caller", [], [], 0, true, contracts)
        expect(body.nogc_strict).to_equal(true)
        expect(body.short_call_contracts["sample.owner.take"]).to_equal(["consume"])

    it "keeps legacy defaults explicit":
        val body = MirBody.from_parts("legacy", [], [], 0, MirType.unit())
        expect(body.nogc_strict).to_equal(false)
        expect(body.short_call_contracts.len()).to_equal(0)

    it "preserves metadata across optimizer block replacement and body conversion":
        var builder = MirBuilder.new()
        builder.begin_function(SymbolId(id: 7), "sample.owner.caller",
            MirSignature(params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
        builder.terminate_return(nil)
        var function = builder.end_function()
        function.nogc_strict = true
        function.short_call_contracts = {"sample.owner.read": ["read-short"]}
        val rewritten = MirFunction.with_blocks(function, function.blocks)
        val body = MirBody.from_function(rewritten)
        expect(body.nogc_strict).to_equal(true)
        expect(body.short_call_contracts["sample.owner.read"]).to_equal(["read-short"])
