use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "erased Dict view MIR lowering source":
    it "routes unresolved keys and values through tag-safe Dict runtimes":
        val source = (rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? "").replace("\r\n", "\n")

        expect(source).to_contain("if not receiver_is_dict and not resolution_is_static_method and is_dict_method_name and static_receiver_name == \"\" and (resolution_is_unresolved or resolved_dict_probe_is_safe):")
        expect(source).to_contain("if receiver_is_dict and (method == \"values\" or method == \"keys\") and args.len() == 0:")
        expect(source).to_contain("if method == \"values\": \"rt_dict_values\" else: \"rt_dict_keys\"")
