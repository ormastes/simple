use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.enum_constructor_payload.*

fn payload_authority_array_v1(element: HirType) -> HirType:
    HirType(kind: HirTypeKind.Array(element, nil), span: Span.empty())

fn payload_authority_accepts_v1(symbols: SymbolTable, expected: HirType,
        remembered: HirType?, source: HirType?, storage: MirType) -> bool:
    var lowering = MirLowering.new(symbols)
    var builder = lowering.builder
    val local = builder.new_temp(storage)
    lowering.builder = builder
    if val remembered_type = remembered:
        lowering.remember_local_hir_type(local.id, remembered_type, 0, 0)
    val expression = HirExpr(kind: HirExprKind.Error, has_type_: source.?,
        type_: source ?? HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty())
    lowering.enum_payload_local_compatible(expected, expression, local)

fn enum_payload_negative_authority_controls_v1() -> text:
    val symbols = SymbolTable.new()
    val integers = payload_authority_array_v1(HirType.i64())
    val texts = payload_authority_array_v1(HirType.str())
    val any_values = payload_authority_array_v1(HirType(kind: HirTypeKind.Any, span: Span.empty()))
    val unsigned_values = payload_authority_array_v1(HirType(kind: HirTypeKind.Int(64, false), span: Span.empty()))
    val erased = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
    if payload_authority_accepts_v1(symbols, integers, Some(any_values), nil, erased):
        return "concrete Any container contradiction ignored"
    if payload_authority_accepts_v1(symbols, integers, Some(texts), nil, erased):
        return "concrete text container contradiction ignored"
    if payload_authority_accepts_v1(symbols, integers, Some(unsigned_values), nil, MirType(kind: MirTypeKind.Array(MirType(kind: MirTypeKind.U64), 0))):
        return "container signedness contradiction ignored"
    if not payload_authority_accepts_v1(symbols, integers, Some(texts), Some(integers), erased):
        return "independent source-positive recovery lost"
    if payload_authority_accepts_v1(symbols, integers, nil, Some(texts), erased):
        return "independent source-negative ignored"
    if not payload_authority_accepts_v1(symbols, any_values, Some(any_values), Some(any_values), erased):
        return "exact declared Any container rejected"

    var owners = SymbolTable.new()
    val expected_id = owners.define("Expected", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, Some("lib.expected"))
    val foreign_id = owners.define("Foreign", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, Some("lib.foreign"))
    val expected_nominal = payload_authority_array_v1(HirType(kind: HirTypeKind.Named(expected_id, []), span: Span.empty()))
    val foreign_nominal = payload_authority_array_v1(HirType(kind: HirTypeKind.Named(foreign_id, []), span: Span.empty()))
    val expected_storage = MirType(kind: MirTypeKind.Array(MirType(kind: MirTypeKind.Struct(expected_id)), 0))
    val foreign_storage = MirType(kind: MirTypeKind.Array(MirType(kind: MirTypeKind.Struct(foreign_id)), 0))
    if payload_authority_accepts_v1(owners, expected_nominal, Some(foreign_nominal), nil, expected_storage):
        return "concrete foreign owner contradiction ignored"
    if not payload_authority_accepts_v1(owners, expected_nominal, nil, nil, expected_storage):
        return "genuine missing-metadata nominal fallback rejected"
    if payload_authority_accepts_v1(owners, expected_nominal, nil, nil, foreign_storage):
        return "foreign owner admitted by missing-metadata fallback"
    val unknown = HirType(kind: HirTypeKind.Error, span: Span.empty())
    if not payload_authority_accepts_v1(owners, expected_nominal, Some(unknown), nil, expected_storage):
        return "Error metadata no longer permits existing nominal fallback"
    val inferred = HirType(kind: HirTypeKind.Infer(91, 0), span: Span.empty())
    if not payload_authority_accepts_v1(owners, expected_nominal, Some(inferred), nil, expected_storage):
        return "Infer metadata no longer permits existing nominal fallback"
    ""

export enum_payload_negative_authority_controls_v1
