# EE-01 schema/canonical-serialization unit contract. Execution: UNRUN.
# These deliberately constructed records test serialization, not semantic admission.
# Producer/consumer acceptance is covered by the separate frontend/API suite.
use std.spec.{describe, it, expect}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{DriverManifestAttr, DriverManifestAttrKind,
    vhdl_hardware_metadata_default}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirConstValue, MirSignature}
use compiler.mir.mir_instruction_support.{BlockId, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_instruction_graph.{MirFunction, MirBlock, MirModule}
use compiler.mir.mir_enum_semantic_types.{MirEnumPatternKindV1, MirEnumPatternNodeV1,
    MirEnumSiteKindV1, MirEnumSiteV1, MirEnumArmSemanticV1, MirEnumMatchSemanticV1,
    MirEnumVariantSlotsV1, MirEnumDeclarationIdentityV1}
use compiler.mir.mir_json.{serialize_mir_function, serialize_mir_function_subject_v1,
    serialize_mir_enum_match_v1, serialize_mir_enum_pattern_v1, serialize_mir_enum_declaration_v1}
use compiler.mir.mir_serialization.{serialize_mir_module}

fn enum_serialization_function() -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 7), name: "plain", signature: MirSignature(
            params: [], return_type: MirType.i64(), is_variadic: false),
        locals: [], blocks: [], entry_block: BlockId(id: 0), span: Span.empty(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "",
        gpu_backend_order: "", is_export_c: false, export_name: "",
        has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(
            kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0,
            device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0,
        verification_contract: nil)

fn enum_serialization_span() -> Span:
    Span(start: 3, end: 9, line: 2, col: 4, file: "quote\"\\\n.spl", length: 6)

fn enum_serialization_pattern(kind: MirEnumPatternKindV1) -> MirEnumPatternNodeV1:
    MirEnumPatternNodeV1(kind: kind, expected_type: MirType.i64(),
        source_span: enum_serialization_span())

fn enum_serialization_match() -> MirEnumMatchSemanticV1:
    val operand = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 6)))
    val arm = MirEnumArmSemanticV1(
        source_arm_id: 2, expanded_alternative_index: 3, pattern_root: 0,
        guard_entry: nil, guard_result: nil, body_entry: BlockId(id: 4),
        body_exit_blocks: [BlockId(id: 4), BlockId(id: 5)],
        pattern_failure_entry: BlockId(id: 8), guard_failure_entry: BlockId(id: 9),
        source_span: enum_serialization_span())
    val site = MirEnumSiteV1(kind: MirEnumSiteKindV1.PayloadDecode,
        block_id: BlockId(id: 4), instruction_index: 2,
        exact_instruction_identity: "instruction\"\\\n",
        semantic_input_type: MirType.i64(), semantic_output_type: MirType.bool(),
        related_pattern_node: 0)
    MirEnumMatchSemanticV1(match_id: 10, enum_owner: SymbolId(id: 11),
        scrutinee_operand: operand, scrutinee_semantic_type: MirType.i64(),
        entry_block: BlockId(id: 1), result_local: LocalId(id: 7),
        merge_block: BlockId(id: 12),
        pattern_nodes: [enum_serialization_pattern(MirEnumPatternKindV1.Wildcard)],
        arms: [arm], sites: [site], source_span: enum_serialization_span(),
        declaration_identity: "decl\"\\\n", subject_identity: "subject\"\\\n")

fn enum_serialization_declaration() -> MirEnumDeclarationIdentityV1:
    MirEnumDeclarationIdentityV1(owner: SymbolId(id: 11), source_owner: SymbolId(id: 21),
        runtime_name: "owner.Choice\"\\\n", runtime_identity: 314,
        variants: [MirEnumVariantSlotsV1(discriminant: 7, source_variant: SymbolId(id: 31),
            slot_types: [MirType.bool(), MirType(kind: MirTypeKind.Tuple([MirType.i64()]))],
            slot_names: ["flag", "tuple"])])

fn enum_serialization_module() -> MirModule:
    MirModule(name: "plain_module", functions: {}, statics: {}, constants: {}, types: {})

describe "EE-01 canonical enum metadata serialization":
    it "preserves the previous exact canonical bytes for empty metadata":
        val function = enum_serialization_function()
        val expected = "{\"symbol\":7,\"name\":\"plain\",\"signature\":{\"params\":[],\"return_type\":\"I64\",\"is_variadic\":false,\"params_known\":false},\"locals\":[],\"blocks\":[],\"entry_block\":0}"
        expect(function.enum_matches.len()).to_equal(0)
        expect(serialize_mir_function(function)).to_equal(expected)
        expect(serialize_mir_function_subject_v1(function)).to_equal(expected)

    it "serializes every pattern constructor with ordered flat references":
        val wildcard = serialize_mir_enum_pattern_v1(enum_serialization_pattern(
            MirEnumPatternKindV1.Wildcard))
        expect(wildcard).to_equal("{\"kind\":\"Wildcard\",\"expected_type\":\"I64\",\"source_span\":{\"start\":3,\"end\":9,\"line\":2,\"col\":4,\"file\":\"quote\\\"\\\\\\n.spl\",\"length\":6}}")
        expect(serialize_mir_enum_pattern_v1(enum_serialization_pattern(
            MirEnumPatternKindV1.Bind(SymbolId(id: 21), LocalId(id: 22))))).to_contain(
                "\"kind\":{\"Bind\":{\"source_symbol\":21,\"destination_local\":22}}")
        expect(serialize_mir_enum_pattern_v1(enum_serialization_pattern(
            MirEnumPatternKindV1.Variant(SymbolId(id: 23), -4, [2, 1])))).to_contain(
                "\"kind\":{\"Variant\":{\"owner_symbol\":23,\"discriminant\":-4,\"children\":[2,1]}}")
        expect(serialize_mir_enum_pattern_v1(enum_serialization_pattern(
            MirEnumPatternKindV1.Tuple([3, 1])))).to_contain("\"kind\":{\"Tuple\":[3,1]}")
        expect(serialize_mir_enum_pattern_v1(enum_serialization_pattern(
            MirEnumPatternKindV1.Literal(MirConstValue.Bool(true), MirType.bool()))))).to_contain(
                "\"kind\":{\"Literal\":{\"value\":true,\"exact_type\":\"Bool\"}}")
        expect(serialize_mir_enum_pattern_v1(enum_serialization_pattern(
            MirEnumPatternKindV1.Or([4, 0])))).to_contain("\"kind\":{\"Or\":[4,0]}")

    it "retains record identity, sites, separate failure edges and escaped spans":
        val encoded = serialize_mir_enum_match_v1(enum_serialization_match())
        expect(encoded).to_start_with("{\"schema\":\"MirEnumMatchSemantic-v1\",\"match_id\":10,\"enum_owner\":11,")
        expect(encoded).to_contain("\"scrutinee_operand\":{\"Copy\":6},\"scrutinee_semantic_type\":\"I64\"")
        expect(encoded).to_contain("\"entry_block\":1,\"entry_instruction_index\":0,\"result_local\":7,\"merge_block\":12")
        expect(encoded).to_contain("\"source_arm_id\":2,\"expanded_alternative_index\":3,\"pattern_root\":0")
        expect(encoded).to_contain("\"pattern_entry_block\":-1,\"pattern_entry_instruction_index\":0")
        expect(encoded).to_contain("\"guard_entry\":null,\"guard_entry_instruction_index\":0,\"guard_result\":null")
        expect(encoded).to_contain("\"body_entry\":4,\"body_entry_instruction_index\":0,\"body_exit_blocks\":[4,5],\"pattern_failure_entry\":8,\"guard_failure_entry\":9")
        expect(encoded).to_contain("\"kind\":\"PayloadDecode\",\"block_id\":4,\"instruction_index\":2")
        expect(encoded).to_contain("\"exact_instruction_identity\":\"instruction\\\"\\\\\\n\"")
        expect(encoded).to_contain("\"semantic_input_type\":\"I64\",\"semantic_output_type\":\"Bool\",\"related_pattern_node\":0")
        expect(encoded).to_end_with("\"declaration_identity\":\"decl\\\"\\\\\\n\",\"subject_identity\":\"subject\\\"\\\\\\n\"}")

    it "excludes metadata only from the function subject":
        var function = enum_serialization_function()
        val subject = serialize_mir_function_subject_v1(function)
        var record = enum_serialization_match()
        function.enum_matches = [record]
        val ordinary = serialize_mir_function(function)
        expect(serialize_mir_function_subject_v1(function)).to_equal(subject)
        expect(ordinary).to_contain("\"enum_matches\":{\"schema\":\"MirEnumMatches-v1\",\"matches\":[")
        expect(ordinary).to_contain(serialize_mir_enum_match_v1(record))
        record.subject_identity = "mutated"
        function.enum_matches = [record]
        expect(serialize_mir_function_subject_v1(function)).to_equal(subject)
        expect(serialize_mir_function(function) == ordinary).to_equal(false)
        record.declaration_identity = "other declaration"
        val after_subject_change = serialize_mir_function(function)
        function.enum_matches = [record]
        expect(serialize_mir_function(function) == after_subject_change).to_equal(false)

    it "serializes guards, every site kind and ordered records without filtering":
        var record = enum_serialization_match()
        var arm = record.arms[0]
        arm.guard_entry = Some(BlockId(id: 13))
        arm.guard_entry_instruction_index = 3
        arm.guard_result = Some(MirOperand(kind: MirOperandKind.Move(LocalId(id: 14))))
        arm.body_entry_instruction_index = 5
        record.arms = [arm]
        var sites: [MirEnumSiteV1] = []
        val kinds = [MirEnumSiteKindV1.Discriminant, MirEnumSiteKindV1.VariantIdentityCheck,
            MirEnumSiteKindV1.Payload, MirEnumSiteKindV1.PayloadSlot,
            MirEnumSiteKindV1.PayloadDecode, MirEnumSiteKindV1.Guard, MirEnumSiteKindV1.ArmResult,
            MirEnumSiteKindV1.PatternInstruction, MirEnumSiteKindV1.PatternTerminator]
        for kind in kinds:
            var site = record.sites[0]
            site.kind = kind
            sites.push(site)
        record.sites = sites
        val encoded = serialize_mir_enum_match_v1(record)
        expect(encoded).to_contain("\"guard_entry\":13,\"guard_entry_instruction_index\":3,\"guard_result\":{\"Move\":14}")
        expect(encoded).to_contain("\"body_entry\":4,\"body_entry_instruction_index\":5,")
        expect(record.sites.len()).to_equal(9)
        for name in ["Discriminant", "VariantIdentityCheck", "Payload", "PayloadSlot",
                "PayloadDecode", "Guard", "ArmResult", "PatternInstruction", "PatternTerminator"]:
            expect(encoded).to_contain("\"kind\":\"" + name + "\"")
        var second = enum_serialization_match()
        second.match_id = 20
        var function = enum_serialization_function()
        function.enum_matches = [record, second]
        expect(serialize_mir_function(function)).to_contain(
            serialize_mir_enum_match_v1(record) + "," + serialize_mir_enum_match_v1(second))

    it "binds cursor mutations in metadata while preserving the physical subject":
        var function = enum_serialization_function()
        var record = enum_serialization_match()
        var arm = record.arms[0]
        function.enum_matches = [record]
        val subject = serialize_mir_function_subject_v1(function)
        val before = serialize_mir_function(function)
        arm.guard_entry_instruction_index = 2
        record.arms = [arm]
        function.enum_matches = [record]
        val after_guard = serialize_mir_function(function)
        expect(after_guard == before).to_equal(false)
        expect(serialize_mir_function_subject_v1(function)).to_equal(subject)
        arm.body_entry_instruction_index = 4
        record.arms = [arm]
        function.enum_matches = [record]
        expect(serialize_mir_function(function) == after_guard).to_equal(false)
        expect(serialize_mir_function_subject_v1(function)).to_equal(subject)
        val after_body = serialize_mir_function(function)
        arm.pattern_entry_block = BlockId(id: 6)
        arm.pattern_entry_instruction_index = 8
        record.arms = [arm]
        record.entry_instruction_index = 1
        function.enum_matches = [record]
        val after_pattern = serialize_mir_function(function)
        expect(after_pattern == after_body).to_equal(false)
        expect(after_pattern).to_contain("\"pattern_entry_block\":6,\"pattern_entry_instruction_index\":8")
        expect(after_pattern).to_contain("\"entry_block\":1,\"entry_instruction_index\":1,")
        expect(serialize_mir_function_subject_v1(function)).to_equal(subject)

    it "preserves exact legacy module bytes when declarations are empty":
        val module = enum_serialization_module()
        expect(module.enum_semantic_declarations.len()).to_equal(0)
        expect(serialize_mir_module(module)).to_equal(
            "{\"name\":\"plain_module\",\"functions\":[],\"collection_plan_explanations\":[]}")

    it "serializes exact source and runtime declaration identity and ordered slots":
        val record = enum_serialization_declaration()
        expect(serialize_mir_enum_declaration_v1(record)).to_equal(
            "{\"schema\":\"MirEnumDeclarationIdentity-v1\",\"owner\":11,\"source_owner\":21,\"runtime_name\":\"owner.Choice\\\"\\\\\\n\",\"runtime_identity\":314,\"variants\":[{\"discriminant\":7,\"source_variant\":31,\"slot_types\":[\"Bool\",{\"Tuple\":[\"I64\"]}],\"slot_names\":[\"flag\",\"tuple\"]}]}")
        var changed = record
        changed.runtime_identity = 315
        expect(serialize_mir_enum_declaration_v1(changed) == serialize_mir_enum_declaration_v1(record)).to_equal(false)

    it "appends nonempty module declarations in supplied canonical order":
        var module = enum_serialization_module()
        val first = enum_serialization_declaration()
        var second = enum_serialization_declaration()
        second.owner = SymbolId(id: 12)
        second.source_owner = SymbolId(id: 22)
        module.enum_semantic_declarations = [first, second]
        val prefix = "{\"name\":\"plain_module\",\"functions\":[],\"collection_plan_explanations\":[],\"enum_semantic_declarations\":{\"schema\":\"MirEnumDeclarations-v1\",\"declarations\":["
        val ordered = serialize_mir_enum_declaration_v1(first) + "," + serialize_mir_enum_declaration_v1(second)
        expect(serialize_mir_module(module)).to_equal(prefix + ordered + "]}}")
        module.enum_semantic_declarations = [second, first]
        val reversed = serialize_mir_enum_declaration_v1(second) + "," + serialize_mir_enum_declaration_v1(first)
        expect(serialize_mir_module(module)).to_equal(prefix + reversed + "]}}")

    it "preserves stale metadata across with_blocks without resealing":
        var function = enum_serialization_function()
        var record = enum_serialization_match()
        val original_subject = serialize_mir_function_subject_v1(function)
        record.subject_identity = original_subject
        function.enum_matches = [record]
        val changed = MirFunction.with_blocks(function, [MirBlock(id: BlockId(id: 0),
            label: nil, instructions: [], terminator: MirTerminator.Unreachable)])
        expect(changed.enum_matches.len()).to_equal(1)
        expect(serialize_mir_enum_match_v1(changed.enum_matches[0])).to_equal(
            serialize_mir_enum_match_v1(record))
        expect(changed.enum_matches[0].subject_identity).to_equal(original_subject)
        expect(serialize_mir_function_subject_v1(changed) == original_subject).to_equal(false)
        expect(function.blocks.len()).to_equal(0)
