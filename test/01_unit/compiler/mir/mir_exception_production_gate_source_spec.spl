use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn exception_gate_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "MIR exception CFG production gate":
    it "validates every function before and after module optimization":
        val source = exception_gate_source(
            "src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(source).to_contain(
            "validate_mir_exception_module_gate_or_panic(module, phase)")
        expect(source).to_contain(
            "validate_mir_exception_module_or_panic(module, \"before optimization\")")
        expect(source).to_contain(
            "validate_mir_exception_module_or_panic(optimized_module, \"after optimization\")")
        expect(source).to_contain(
            "validate_mir_exception_module_or_panic(module, \"before backend\")")
        expect(source).to_contain("optimized, \"after bulk optimization\"")

    it "keeps LandingPad destinations visible to visitor and outlining analyses":
        val visitor = exception_gate_source(
            "src/compiler/60.mir_opt/mir_opt/mir_visitor.spl")
        val outline = exception_gate_source(
            "src/compiler/60.mir_opt/mir_opt/outline.spl")
        expect(visitor).to_contain(
            "case LandingPad(dest):\n            visitor.visit_local(dest)")
        expect(outline).to_contain("case LandingPad(dest): Some(dest)")

    it "gates direct JIT and AOT compilation at entry and final handoff":
        val source = exception_gate_source(
            "src/compiler/70.backend/codegen.spl")
        expect(source).to_contain(
            "validate_mir_exception_module(\n            mir, \"at CodegenPipeline entry\")")
        expect(source).to_contain(
            "validate_mir_exception_module(\n            mir, \"at final backend handoff\")")

    it "gates public backend, direct adapters, and final VHDL handoff":
        val public_api = exception_gate_source(
            "src/compiler/70.backend/backend/backend_api.spl")
        val adapters = exception_gate_source(
            "src/compiler/70.backend/backend/backend_helpers.spl")
        val vhdl = exception_gate_source(
            "src/compiler/80.driver/driver_aot_vhdl_output.spl")
        expect(public_api).to_contain(
            "at public CompilerBackend.compile boundary")
        expect(adapters).to_contain("at shared direct-adapter handoff")
        expect(vhdl).to_contain(
            "at post-weave/debug/prepared VHDL boundary")
        expect(vhdl).to_contain("at final VHDL backend handoff")
        expect(public_api).to_contain("compileerror_backend_error")
        expect(adapters).to_contain("compileerror_backend_error")
        expect(vhdl).to_contain("CompileResult.CodegenError")
