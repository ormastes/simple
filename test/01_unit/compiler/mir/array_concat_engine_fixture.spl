use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn array_concat_engine_case(source: text, expected_calls: i64, expect_error: bool) -> text:
    val filename = "array_concat_control.spl"
    val parsed = parse_full_frontend(source, filename, filename, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(filename)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var calls = 0
    var bad_signature = false
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(destination, callee, arguments):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str("rt_array_concat"), signature_type):
                                calls = calls + 1
                                if arguments.len() != 2 or not destination.?:
                                    bad_signature = true
                                if val result_local = destination:
                                    if val element_note = lowering.noted_runtime_elem_type(result_local):
                                        if element_note.kind != MirTypeKind.U8:
                                            bad_signature = true
                                    else:
                                        bad_signature = true
                                    for local in function.locals:
                                        if local.id.id == result_local.id:
                                            match local.type_.kind:
                                                case MirTypeKind.Array(element, extent):
                                                    if element.kind != MirTypeKind.U8 or extent != 0:
                                                        bad_signature = true
                                                case _: bad_signature = true
                                match signature_type.kind:
                                    case MirTypeKind.FuncPtr(signature):
                                        if signature.params.len() != 2:
                                            bad_signature = true
                                        match signature.return_type.kind:
                                            case MirTypeKind.Array(element, extent):
                                                if element.kind != MirTypeKind.U8 or extent != 0:
                                                    bad_signature = true
                                            case _: bad_signature = true
                                        for parameter in signature.params:
                                            match parameter.kind:
                                                case MirTypeKind.Array(element, extent):
                                                    if element.kind != MirTypeKind.U8 or extent != 0:
                                                        bad_signature = true
                                                case _: bad_signature = true
                                    case _: bad_signature = true
                            case MirOperandKind.Const(MirConstValue.Str("rt_array_extend_i64"), _):
                                return "concat emitted mutating extend"
                            case _: ()
                    case _: ()
    if calls != expected_calls: return "wrong fresh concat call count"
    if bad_signature: return "wrong concat pointer/element signature"
    val has_errors = hir_lowering.errors.len() > 0 or lowering.errors.len() > 0
    if has_errors != expect_error: return "wrong diagnostic outcome"
    if mir.functions.len() == 0: return "no lowered functions"
    ""

fn array_concat_engine_controls() -> text:
    val positive = array_concat_engine_case("fn make(left: [u8], right: [u8]) -> [u8]:\n    left.concat(right).concat(left)\n", 2, false)
    if positive != "": return positive
    val negative = array_concat_engine_case("fn make(left: i64, right: i64) -> i64:\n    left.concat(right)\n", 0, true)
    if negative != "": return negative
    val mixed = array_concat_engine_case("fn make(left: [u8], right: [text]) -> [u8]:\n    left.concat(right)\n", 0, true)
    if mixed != "": return mixed
    val scalar_argument = array_concat_engine_case("fn make(left: [u8]) -> [u8]:\n    left.concat(7)\n", 0, true)
    if scalar_argument != "": return scalar_argument
    array_concat_composite_engine_control()

fn array_concat_composite_engine_control() -> text:
    val filename = "array_concat_composite.spl"
    val source = "struct Payload:\n    number: i64\nfn read(right: [Payload]) -> i64:\n    val combined = [].concat(right).concat(right)\n    combined[0].number\n"
    val parsed = parse_full_frontend(source, filename, filename, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(filename)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    if hir_lowering.errors.len() > 0 or lowering.errors.len() > 0:
        return "empty/composite chain lost its nominal owner"
    var calls = 0
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(destination, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str("rt_array_concat"), _):
                                calls = calls + 1
                                if val result_local = destination:
                                    if val element = lowering.noted_runtime_elem_type(result_local):
                                        match element.kind:
                                            case MirTypeKind.Struct(owner):
                                                if owner.id < 0: return "invalid composite owner"
                                            case _: return "composite result lost element metadata"
                                    else: return "missing composite element metadata"
                                else: return "missing composite concat result"
                            case _: ()
                    case _: ()
    if calls != 2: return "wrong empty/composite chain call count"
    ""
