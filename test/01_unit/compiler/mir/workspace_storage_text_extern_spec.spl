use std.spec.{describe, it, expect}
use std.spec.step
use compiler.mir.text_extern_abi.{tagged_text_value_arg_indices, text_arg_indices, boxed_text_arg_indices}

describe "Workspace storage tagged text ABI":
    it "preserves all six scope strings and leaves scalar quota and hard bytes unchanged":
        step("Use the real MIR registry to retain complete native storage text values")
        expect(tagged_text_value_arg_indices("rt_workspace_storage_open_v1").unwrap()).to_equal([0, 1, 2, 3, 4, 7])
        expect(tagged_text_value_arg_indices("rt_workspace_storage_recover_v1").unwrap()).to_equal([0, 1, 2, 3, 4, 7])
        expect(text_arg_indices("rt_workspace_storage_open_v1")).to_be_nil()
        expect(boxed_text_arg_indices("rt_workspace_storage_open_v1")).to_be_nil()

    it "does not reinterpret unrelated names or token-only observation":
        step("Keep nontext native ownership operands outside the text bridge")
        expect(tagged_text_value_arg_indices("other.rt_workspace_storage_open_v1")).to_be_nil()
        expect(tagged_text_value_arg_indices("rt_workspace_storage_observe_v1")).to_be_nil()

    it "preserves native observation cgroup and binding text through every owner operation":
        step("Keep native user-observation scope and close-binding bytes intact")
        expect(tagged_text_value_arg_indices("rt_linux_container_user_open_v1").unwrap()).to_equal([1, 2])
        expect(tagged_text_value_arg_indices("rt_linux_container_user_observe_v1").unwrap()).to_equal([1])
        expect(tagged_text_value_arg_indices("rt_linux_container_user_close_v1").unwrap()).to_equal([1])
        expect(text_arg_indices("rt_linux_container_user_open_v1")).to_be_nil()
