"""Actual frontend lambda producers and filter consumers; authored, unexecuted.
These inspect calling convention only, not typed element execution correctness.
"""
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

fn filter_callback_reachable(function: MirFunction, blocked_from: i64, blocked_to: i64) -> bool:
    var work: [i64] = [function.entry_block.id]
    var visited: [i64] = []
    while work.len() > 0:
        val id = work.pop()
        if not visited.contains(id):
            visited.push(id)
            for block in function.blocks:
                if block.id.id == id:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.CallIndirect(_, _, _, _): return true
                            case _: pass
                    var next: [i64] = []
                    match block.terminator:
                        case MirTerminator.Goto(target): next.push(target.id)
                        case MirTerminator.If(_, yes, no):
                            next.push(yes.id)
                            next.push(no.id)
                        case _: pass
                    for target in next:
                        if id != blocked_from or target != blocked_to:
                            work.push(target)
    false

fn filter_assert_null_target_guard(function: MirFunction):
    var target_id: i64 = -1
    var zero_id: i64 = -1
    var guard_id: i64 = -1
    var guard_block: i64 = -1
    var success_block: i64 = -1
    var failure_block: i64 = -1
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(dest, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str("rt_closure_func_ptr"), _): target_id = dest.unwrap().id
                        case _: pass
                case MirInstKind.Const(dest, MirConstValue.Int(0), _): zero_id = dest.id
                case MirInstKind.BinOp(dest, MirBinOp.Ne, left, right):
                    match (left.kind, right.kind):
                        case (MirOperandKind.Copy(target), MirOperandKind.Copy(zero)):
                            if target.id == target_id and zero.id == zero_id and target_id >= 0:
                                guard_id = dest.id
                                guard_block = block.id.id
                        case _: pass
                case _: pass
        match block.terminator:
            case MirTerminator.If(condition, yes, no):
                match condition.kind:
                    case MirOperandKind.Copy(local):
                        if local.id == guard_id and block.id.id == guard_block:
                            success_block = yes.id
                            failure_block = no.id
                    case _: pass
            case _: pass
    expect(success_block).to_be_greater_than(-1)
    expect(failure_block).to_be_greater_than(-1)
    var panic_found = false
    for block in function.blocks:
        if block.id.id == failure_block:
            expect(block.terminator).to_equal(MirTerminator.Unreachable)
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str("rt_panic"), _): panic_found = true
                            case _: pass
                    case _: pass
    expect(panic_found).to_equal(true)
    expect(filter_callback_reachable(function, -1, -1)).to_equal(true)
    # Removing the nonzero edge must disconnect every indirect callback call.
    expect(filter_callback_reachable(function, guard_block, success_block)).to_equal(false)

fn filter_abi_check(source: text, captured: bool):
    val ast = parse_full_frontend(source, "filter_abi.spl", "filter_abi", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("filter_abi.spl")
    val hir = hir_lowering.lower_module(ast)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    var producer_count = 0
    var producer = MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)
    for function in mir.functions.values():
        if function.name.starts_with("__lambda_lift_"):
            producer_count = producer_count + 1
            producer = function.signature
    expect(producer_count).to_equal(1)
    val expected_arity = if captured: 2 else: 1
    expect(producer.params.len()).to_equal(expected_arity)
    for param in producer.params:
        expect(param).to_equal(MirType.i64())
    expect(producer.return_type).to_equal(MirType.i64())

    var handle_id: i64 = -1
    var target_id: i64 = -1
    var closure_creations = 0
    var target_resolutions = 0
    var raw_calls = 0
    var closure_calls = 0
    var array_reads = 0
    var array_pushes = 0
    for function in mir.functions.values():
        if not function.name.starts_with("__lambda_lift_"):
            if captured:
                filter_assert_null_target_guard(function)
            for block in function.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Call(dest, callee, args):
                            match callee.kind:
                                case MirOperandKind.Const(MirConstValue.Str(name), _):
                                    if name == "rt_closure_new":
                                        closure_creations = closure_creations + 1
                                        handle_id = dest.unwrap().id
                                    elif name == "rt_closure_func_ptr":
                                        target_resolutions = target_resolutions + 1
                                        target_id = dest.unwrap().id
                                        expect(args.len()).to_equal(1)
                                        match args[0].kind:
                                            case MirOperandKind.Copy(local): expect(local.id).to_equal(handle_id)
                                            case _: fail("closure target must be resolved from its handle")
                                    elif name.starts_with("__lambda_lift_"):
                                        raw_calls = raw_calls + 1
                                        expect(args.len()).to_equal(producer.params.len())
                                    elif name == "rt_array_get": array_reads = array_reads + 1
                                    elif name == "rt_array_push": array_pushes = array_pushes + 1
                                case _: fail("filter must never directly call a closure handle")
                        case MirInstKind.CallIndirect(_, callee, args, signature):
                            closure_calls = closure_calls + 1
                            expect(signature).to_equal(producer)
                            expect(args.len()).to_equal(2)
                            match callee.kind:
                                case MirOperandKind.Copy(local): expect(local.id).to_equal(target_id)
                                case _: fail("indirect target must be the resolved closure function")
                            match args[0].kind:
                                case MirOperandKind.Copy(local): expect(local.id).to_equal(handle_id)
                                case _: fail("captured callback requires its environment first")
                        case _: pass
    expect(closure_creations).to_equal(if captured: 1 else: 0)
    expect(target_resolutions).to_equal(if captured: 1 else: 0)
    expect(closure_calls).to_equal(if captured: 1 else: 0)
    expect(raw_calls).to_equal(if captured: 0 else: 1)
    # One instruction in the existing loop, not a runtime invocation count.
    expect(array_reads).to_equal(1)
    expect(array_pushes).to_equal(1)

describe "array filter lambda ABI":
    it "retains the noncapturing raw producer convention":
        step("Lower a real inline predicate with an inferred parameter")
        filter_abi_check("fn select(values: [i64]) -> [i64]:\n    values.filter(\\x: x > 1)\n", false)

    it "passes the captured environment to the actual lifted target":
        step("Construct a captured predicate before the filter loop")
        filter_abi_check("fn select(values: [i64], threshold: i64) -> [i64]:\n    values.filter(\\x: x > threshold)\n", true)

    it "keeps existing text eligibility while checking its actual word ABI":
        step("Lower a text predicate without claiming element representation parity")
        filter_abi_check("fn select(values: [text], wanted: text) -> [text]:\n    values.filter(fn(x: text): x == wanted)\n", true)

    it "keeps existing narrow integer eligibility and producer agreement":
        step("Lower an explicitly typed narrow predicate")
        filter_abi_check("fn select(values: [i32], threshold: i32) -> [i32]:\n    values.filter(fn(x: i32): x > threshold)\n", true)
