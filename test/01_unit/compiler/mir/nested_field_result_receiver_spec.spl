"""
Parsed MIR regressions for declared local, direct-field and nested-field Result
method receivers. Native effect/count assertions live in the standalone fixture;
these examples inspect actual parsed/lowered calls, not source substrings.
# @manual: primary
# @capture: log
Execution and SPipe generation remain pending an admitted matching producer.
"""
use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

class ParsedFieldResults:
    bodies: {text: text}
    errors: text

# @inline
fn lower_field_results(source: text) -> ParsedFieldResults:
    val parsed = parse_full_frontend(source, "nested_field_results.spl", "nested_field_results", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("nested_field_results.spl")
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var errors = ""
    for error in hir_lowering.errors:
        errors = errors + "HIR: " + error.message + "\n"
    for error in lowering.errors:
        errors = errors + "MIR: " + error.message + "\n"
    var bodies: {text: text} = {}
    for function in mir.functions.values():
        for target in ["local_control", "direct_ok", "direct_err", "nested_ok", "nested_err", "unknown"]:
            if function.name == target or function.name.ends_with("." + target):
                bodies[target] = serialize_mir_function(function)
    ParsedFieldResults(bodies: bodies, errors: errors)

describe "MIR nested-field Result receiver recovery", tag: ["only-compiled"]:
    it "should recover the exact close Result owner for local and field-chain controls":
        step("Parse and lower the actual standalone positive fixture")
        val source = file_read("test/fixtures/compiler_entrypoint/nested_field_result_receiver/main.spl")
        expect(source.len()).to_be_greater_than(0)
        val lowered = lower_field_results(source)
        expect(lowered.errors).to_equal("")
        step("Require one real close call and one Result discriminant per predicate")
        for target in ["local_control", "direct_ok", "direct_err", "nested_ok", "nested_err"]:
            val body = lowered.bodies.get(target) ?? ""
            expect(body.len()).to_be_greater_than(0)
            expect(body.split("FieldResultEndpoint.close").len() - 1).to_equal(1)
            expect(body.split("rt_enum_discriminant").len() - 1).to_equal(1)
            expect(body).to_contain("\"op\":\"Eq\"")

    it "should keep Ok and Err predicates distinct after nested owner recovery":
        step("Lower both predicate spellings from the parsed field fixture")
        val source = file_read("test/fixtures/compiler_entrypoint/nested_field_result_receiver/main.spl")
        expect(source.len()).to_be_greater_than(0)
        val lowered = lower_field_results(source)
        expect(lowered.errors).to_equal("")
        for target in ["direct_ok", "nested_ok"]:
            expect(lowered.bodies.get(target) ?? "").to_contain("\"value\":0,\"type\":\"I64\"")
        for target in ["local_control", "direct_err", "nested_err"]:
            expect(lowered.bodies.get(target) ?? "").to_contain("\"value\":1,\"type\":\"I64\"")

    it "should reject an unknown field instead of borrowing the stream field's Result type":
        step("Parse a receiver with a known stream field and an absent requested field")
        val source = file_read("test/fixtures/compiler_entrypoint/nested_field_result_receiver_unknown/main.spl")
        expect(source.len()).to_be_greater_than(0)
        val lowered = lower_field_results(source)
        expect(lowered.errors.len()).to_be_greater_than(0)
        step("Require rejection before a fabricated Result predicate is emitted")
        val body = lowered.bodies.get("unknown") ?? ""
        expect(body.contains("rt_enum_discriminant")).to_equal(false)
