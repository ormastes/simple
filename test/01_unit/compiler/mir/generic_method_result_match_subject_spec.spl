# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
A generic class method's declared `Result<T, E>` owns bare `Ok`/`Err` arms,
and owning them changes nothing else.

Failure (Stage 3 native build, compiler.frontend.core._AstExpr.nodes:509/560):
`match expr_attr_extra_stores[0].get(idx): case Ok(v): ... case Err(_): ...`
with `expr_attr_extra_stores: [AttributeStoreV1<i64>]` reported
"bare variant 'Ok' is ambiguous ... subject method call unknown
receiver.get() has type unresolved": the subject is untyped and another enum
declares `Ok`/`Err`, so the owner search had several candidates.

Fix: when the owner search is ambiguous, enum_match_declared_owner_key reads
the callee's declared return (receiver's declared type or declared element
type -> lookup_method_in_type -> resolved_call_hir_return_type) and keeps
only the Result/Option owner. Nothing else is typed. Two earlier attempts
typed the subject or the method symbol and changed value conventions (42 read
as 336, then as 5): doc/08_tracking/bug/native_generic_class_result_payload_times_8_2026-11-15.md.
So the proof here is MIR identity: every function lowers byte-identically to
the same program with the competing enum removed, and no i64 path gains a
tag/untag call.

Ordinary HIR only: under SIMPLE_BOOTSTRAP=1 a same-module generic-owner
method keeps no declared return (HirFunction.return_type is erased, symbol
untyped), which is an open gap; cross-module the importer's symbol carries
the declared return. Native oracle:
test/fixtures/native_generic_method_result_match/main.spl.
"""

use std.spec
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_json.{serialize_mir_function}

val PROGRAM: text = "class Store<T>:\n    name: text\n    slots: [T?]\n\n" +
    "impl Store<T>:\n    fn get(node: i64) -> Result<T, text>:\n" +
    "        if node >= 0 and node < self.slots.len():\n            match self.slots[node]:\n" +
    "                case Some(v): return Ok(v)\n                case None: pass\n" +
    "        Err(\"absent\")\n" +
    "    fn find(node: i64) -> T?:\n" +
    "        if node >= 0 and node < self.slots.len():\n            return self.slots[node]\n" +
    "        None\n" +
    "    me put(node: i64, value: T) -> bool:\n        self.slots[node] = Some(value)\n        true\n\n" +
    "fn int_get(xs: [Store<i64>], i: i64) -> i64:\n    match xs[0].get(i):\n        case Ok(v): v\n        case Err(_): -1\n\n" +
    "fn text_get(xs: [Store<text>], i: i64) -> text:\n    match xs[0].get(i):\n        case Ok(v): v\n        case Err(_): \"<none>\"\n\n" +
    "fn bool_get(xs: [Store<bool>], i: i64) -> bool:\n    match xs[0].get(i):\n        case Ok(v): v\n        case Err(_): false\n\n" +
    "fn err_text(xs: [Store<i64>], i: i64) -> text:\n    match xs[0].get(i):\n        case Ok(_): \"ok\"\n        case Err(e): e\n\n" +
    "fn int_find(xs: [Store<i64>], i: i64) -> i64:\n    match xs[0].find(i):\n        case Some(v): v\n        case None: -1\n\n" +
    "fn bound_get(xs: [Store<i64>], i: i64) -> i64:\n    val q = xs[0].get(i)\n    match q:\n        case Ok(v): v + 1000\n        case Err(_): -7\n\n" +
    "fn try_get(xs: [Store<i64>], i: i64) -> Result<i64, text>:\n    val v = xs[0].get(i)?\n    Ok(v + 1)\n\n" +
    "fn put_one(xs: [Store<i64>]) -> bool:\n    xs[0].put(1, 7)\n"

val COMPETING_RESULT: text = "\nenum Probe:\n    Ok\n    Err\n"

# A Some/None competitor also puts Option in enum_bare_name_collisions, which
# (by the existing collision policy) drops the total-match trap block from every
# Option match, so MIR identity is asserted against the Ok/Err competitor only.
val COMPETING_OPTION: text = "\nenum Probe2:\n    Some\n    None\n"

val FUNCTIONS: [text] = ["int_get", "text_get", "bool_get", "err_text", "int_find", "bound_get", "try_get", "put_one"]

fn without_own_symbol_id(mir: text) -> text:
    # The competing enum shifts symbol numbering, so only the function's own
    # leading `{"symbol":N,` header may differ; everything after it must not.
    val comma = mir.index_of(",")
    if comma < 0: mir else: mir.substring(comma, mir.len())

fn lower_errors_and_mir(src: text) -> (Dict<text, text>, [text]):
    val module = parse_and_build_module(src, "generic_match.spl")
    var hir_lowering = HirLowering.with_filename("generic_match.spl")
    val hir = hir_lowering.lower_module(module)
    var errors: [text] = []
    for error in hir_lowering.errors:
        errors.push("hir: " + error.message)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    for error in mir_lowering.errors:
        errors.push("mir: " + error.message)
    var out: Dict<text, text> = {}
    for function in mir.functions.values():
        val dot = function.name.rfind(".")
        val short = if dot >= 0: function.name.substring(dot + 1, function.name.len()) else: function.name
        out[short] = serialize_mir_function(function)
    (out, errors)

describe "generic class method Result subject owns bare Ok/Err arms":
    it "lowers every consumer with competing Ok/Err and Some/None enums":
        val (fns, errors) = lower_errors_and_mir(PROGRAM + COMPETING_RESULT + COMPETING_OPTION)
        expect(errors.join(" | ")).to_equal("")
        for name in FUNCTIONS:
            expect((fns[name] ?? "").len() > 0).to_equal(true)

    it "lowers each function byte-identically to the program without the competing Ok/Err enum":
        val (plain, plain_errors) = lower_errors_and_mir(PROGRAM)
        expect(plain_errors.join(" | ")).to_equal("")
        val (ambiguous, _) = lower_errors_and_mir(PROGRAM + COMPETING_RESULT)
        for name in FUNCTIONS:
            expect(without_own_symbol_id(ambiguous[name] ?? "")).to_equal(without_own_symbol_id(plain[name] ?? ""))

    it "adds no tag or untag call on the i64 paths":
        val (fns, _) = lower_errors_and_mir(PROGRAM + COMPETING_RESULT + COMPETING_OPTION)
        for name in ["int_get", "int_find", "bound_get", "try_get", "put_one"]:
            val mir = fns[name] ?? ""
            expect(mir.contains("rt_value_int_wide")).to_equal(false)
            expect(mir.contains("rt_value_as_int_wide")).to_equal(false)
