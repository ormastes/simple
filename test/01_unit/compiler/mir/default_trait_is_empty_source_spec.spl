extern fn rt_file_read_text(path: text) -> text?
describe "pure-Simple default-trait is_empty compatibility source":
    it "keeps affected built-in collection checks on direct length lowering":
        val lean_backend = rt_file_read_text("src/plugins/backend_lean/lean_backend.spl") ?? ""
        val lean_translate = rt_file_read_text("src/plugins/backend_lean/lean_mir_translate.spl") ?? ""
        val lean_type_decls = rt_file_read_text("src/plugins/backend_lean/lean_type_declarations.spl") ?? ""

        expect(lean_backend.contains(".is_empty()")).to_equal(false)
        expect(lean_translate.contains(".is_empty()")).to_equal(false)
        expect(lean_backend).to_contain("if param_types.len() == 0:")
        expect(lean_type_decls).to_contain("if context.array_policy.keys.len() == 0:")
