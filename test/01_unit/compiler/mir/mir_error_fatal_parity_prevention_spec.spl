"""Prevention guard for CompFix-2 (#5372): high-risk MIR failures must never revert to non-fatal self.error."""

# @req REQ-MIR-ERROR-FATAL-PARITY

use std.spec.*
use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

fn read_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "CompFix-2 MIR error_fatal parity prevention":
    it "forbids non-fatal self.error at any of the 4 fail-open MIR sites":
        step("Assert old non-fatal self.error patterns remain absent")
        val asm_src = read_source("src/compiler/50.mir/_MirLowering/asm_and_targets.spl")
        val expr_src = read_source("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")

        expect(asm_src.contains("self.error(\"asm match is non-exhaustive")).to_equal(false)
        expect(expr_src.contains("self.error(\"enum-to-integer cast could not read runtime discriminant\"")).to_equal(false)
        expect(expr_src.contains("self.error(\"catch pattern is not supported by recoverable MIR lowering\"")).to_equal(false)
        expect(expr_src.contains("self.error(\"typed catch uses a type without a collision-free runtime tag\"")).to_equal(false)
