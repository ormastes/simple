# @req REQ-SSPEC-COMPILER
# Bug: mir_match_lambda_capture_scope_2026_10_17
# Execution/docgen: TEST_BLOCKED pending a qualified producer containing fix.
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.hir.hir_definitions.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.lambda_match_scope.*

fn scope_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())

fn scope_expr(kind: HirExprKind) -> HirExpr:
    HirExpr(kind: kind, has_type_: true, type_: scope_type(), span: Span.empty())

fn scope_var(symbol: i64) -> HirExpr:
    scope_expr(HirExprKind.Var(SymbolId(id: symbol)))

fn scope_pattern(kind: HirPatternKind) -> HirPattern:
    HirPattern(kind: kind, has_type_: false, type_: scope_type(), span: Span.empty())

fn scope_binding(symbol: i64) -> HirPattern:
    scope_pattern(HirPatternKind.Binding(SymbolId(id: symbol), false))

fn scope_arm(pattern: HirPattern, value: HirExpr, guard: HirExpr? = nil) -> HirMatchArm:
    var has_guard = false
    var guard_value = scope_expr(HirExprKind.BoolLit(true))
    if val present = guard:
        has_guard = true
        guard_value = present
    HirMatchArm(pattern: pattern, has_guard: has_guard, guard: guard_value,
        body: HirBlock(stmts: [], has: true, value: value, span: Span.empty()), span: Span.empty())

describe "match closure pattern scopes":
    it "collects nested enum tuple array-rest and struct symbols exactly":
        val array = scope_pattern(HirPatternKind.Array([scope_binding(21)], Some(SymbolId(id: 22))))
        val record = scope_pattern(HirPatternKind.Struct(scope_type(), [("field", scope_binding(23))]))
        val payload = HirPatternPayload.Tuple([scope_pattern(HirPatternKind.Tuple([array, record]))])
        val pattern = scope_pattern(HirPatternKind.Enum(scope_type(), "Box", Some(payload)))
        val scope = lambda_match_pattern_scope_v1(pattern)
        expect(scope.supported).to_equal(true)
        expect(scope.bindings).to_equal([21, 22, 23])
        expect(scope.expressions.len()).to_equal(0)

    it "collects enum struct payload bindings":
        val payload = HirPatternPayload.Struct([("value", scope_binding(24))])
        val scope = lambda_match_pattern_scope_v1(scope_pattern(HirPatternKind.Enum(scope_type(), "Record", Some(payload))))
        expect(scope.supported).to_equal(true)
        expect(scope.bindings).to_equal([24])

    it "accepts Or binder sets independent of their traversal order":
        val first = scope_pattern(HirPatternKind.Tuple([scope_binding(21), scope_binding(22)]))
        val second = scope_pattern(HirPatternKind.Tuple([scope_binding(22), scope_binding(21)]))
        val scope = lambda_match_pattern_scope_v1(scope_pattern(HirPatternKind.Or([first, second])))
        expect(scope.supported).to_equal(true)
        expect(scope.bindings).to_equal([21, 22])

    it "refuses inconsistent and empty Or bindings":
        val invalid = scope_pattern(HirPatternKind.Or([scope_binding(21), scope_binding(22)]))
        expect(lambda_match_pattern_scope_v1(invalid).supported).to_equal(false)
        expect(lambda_match_pattern_scope_v1(scope_pattern(HirPatternKind.Or([]))).supported).to_equal(false)

    it "captures scrutinee and guard outer symbols but excludes arm bindings":
        var lowering = MirLowering.new(SymbolTable.new())
        val arm = scope_arm(scope_binding(21), scope_var(21), Some(scope_var(11)))
        val body = scope_expr(HirExprKind.MatchCase(scope_var(10), [arm]))
        expect(lowering.collect_free_var_syms(body, [], [])).to_equal([10, 11])
        expect(lowering.lambda_body_captures(body, [])).to_equal(true)
        expect(lowering.lambda_capture_scan_supported(body)).to_equal(true)

    it "does not capture a match parameter or its arm-local shadow":
        var lowering = MirLowering.new(SymbolTable.new())
        val body = scope_expr(HirExprKind.MatchCase(scope_var(10), [scope_arm(scope_binding(21), scope_var(21))]))
        expect(lowering.collect_free_var_syms(body, [10], [])).to_equal([])
        expect(lowering.lambda_body_captures(body, [10])).to_equal(false)

    it "does not leak a first arm binding into another arm":
        var lowering = MirLowering.new(SymbolTable.new())
        val first = scope_arm(scope_binding(21), scope_var(21))
        val second = scope_arm(scope_pattern(HirPatternKind.Wildcard), scope_var(21))
        val body = scope_expr(HirExprKind.MatchCase(scope_var(10), [first, second]))
        expect(lowering.collect_free_var_syms(body, [10], [])).to_equal([21])

    it "scans range endpoints in outer scope before pattern bindings":
        var lowering = MirLowering.new(SymbolTable.new())
        val pattern = scope_pattern(HirPatternKind.Range(scope_var(11), scope_var(12), true))
        val body = scope_expr(HirExprKind.MatchCase(scope_var(10), [scope_arm(pattern, scope_var(10))]))
        expect(lowering.collect_free_var_syms(body, [10], [])).to_equal([11, 12])
        expect(lowering.lambda_body_captures(body, [10])).to_equal(true)

    it "preserves nested-match arm scopes and captures":
        var lowering = MirLowering.new(SymbolTable.new())
        val inner = scope_expr(HirExprKind.MatchCase(scope_var(21), [scope_arm(scope_binding(22), scope_var(13), Some(scope_var(22)))]))
        val outer = scope_expr(HirExprKind.MatchCase(scope_var(10), [scope_arm(scope_binding(21), inner)]))
        expect(lowering.collect_free_var_syms(outer, [10], [])).to_equal([13])
        expect(lowering.lambda_capture_scan_supported(outer)).to_equal(true)

    it "scans literal pattern dependencies and arm statements without a block value":
        var lowering = MirLowering.new(SymbolTable.new())
        val statement = HirStmt(kind: HirStmtKind.Expr(scope_var(12)), span: Span.empty())
        val arm = HirMatchArm(pattern: scope_pattern(HirPatternKind.Literal(scope_var(11))),
            has_guard: false, guard: scope_expr(HirExprKind.BoolLit(true)),
            body: HirBlock(stmts: [statement], has: false, value: scope_var(99), span: Span.empty()), span: Span.empty())
        val body = scope_expr(HirExprKind.MatchCase(scope_var(10), [arm]))
        expect(lowering.collect_free_var_syms(body, [10], [])).to_equal([11, 12])
        expect(lowering.lambda_body_captures(body, [10])).to_equal(true)
        expect(lowering.lambda_capture_scan_supported(body)).to_equal(true)

    it "keeps invalid and unlowered patterns on the refusal path even without captures":
        var lowering = MirLowering.new(SymbolTable.new())
        val invalid = scope_expr(HirExprKind.MatchCase(scope_var(10), [scope_arm(scope_pattern(HirPatternKind.Error), scope_var(10))]))
        expect(lowering.lambda_body_captures(invalid, [10])).to_equal(true)
        expect(lowering.lambda_capture_scan_supported(invalid)).to_equal(false)
        expect(lambda_match_pattern_scope_v1(scope_pattern(HirPatternKind.CompleteRegion("region"))).supported).to_equal(false)
        expect(lambda_match_pattern_scope_v1(scope_pattern(HirPatternKind.DynRegion("region"))).supported).to_equal(false)
        expect(lambda_match_pattern_scope_v1(scope_pattern(HirPatternKind.TypeTest("i64", "value"))).supported).to_equal(false)

    it "does not admit an unsupported expression hidden inside a match arm":
        var lowering = MirLowering.new(SymbolTable.new())
        val body = scope_expr(HirExprKind.MatchCase(scope_var(10), [scope_arm(scope_binding(21), scope_expr(HirExprKind.Error))]))
        expect(lowering.lambda_body_captures(body, [10])).to_equal(true)
        expect(lowering.lambda_capture_scan_supported(body)).to_equal(false)
