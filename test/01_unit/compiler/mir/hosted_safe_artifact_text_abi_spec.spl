use std.spec
use compiler.mir.text_extern_abi.{text_arg_indices}

describe "hosted safe artifact native text arguments":
    it "expands only the root pathname of acquisition":
        expect(text_arg_indices("rt_hosted_safe_artifact_root_open_v1")).to_equal(Some([0]))

    it "keeps the retained handle and payload as single ABI values":
        expect(text_arg_indices("rt_hosted_safe_artifact_read_v1")).to_equal(Some([1]))
        expect(text_arg_indices("rt_hosted_safe_artifact_publish_v1")).to_equal(Some([1]))

    it "does not expand the opaque close token":
        expect(text_arg_indices("rt_hosted_safe_artifact_root_close_v1")).to_be_nil()
