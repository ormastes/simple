use std.spec.*
use test.fixtures.compiler.mir_json_fragment_owner.probe.{empty_graph_bytes_match, escaped_graph_bytes_match, large_graph_bytes_match}

describe "MIR JSON fragment assembly":
    it "preserves exact empty function field order and empty arrays":
        expect(empty_graph_bytes_match()).to_equal(true)
    it "preserves exact escaping, local order, block order and terminators":
        expect(escaped_graph_bytes_match()).to_equal(true)
    it "preserves all 2048 instructions and 32 block identities":
        expect(large_graph_bytes_match()).to_equal(true)
