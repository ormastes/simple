"""ACOWN03: ownership reaches the actual struct aggregate operand.

These inspect lowered MIR rather than relying on runtime handle identity.
Runtime drop/reference-count qualification is a separate gate.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn struct_transfer_counts(field_type: text, strict: bool) -> [i64]:
    val source = "class Holder:\n    value: {field_type}\n\nfn pack(value: {field_type}) -> Holder:\n    Holder(value: value)\n"
    var parsed = parse_full_frontend(source, "struct_transfer.spl", "struct_transfer.spl", Logger(level: 0))
    parsed.nogc_strict = strict
    var hir_lowering = HirLowering.with_filename("struct_transfer.spl")
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var moves = 0
    var copies = 0
    var aggregates = 0
    for function in mir.functions.values():
        if function.name != "pack" and not function.name.ends_with(".pack"): continue
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Aggregate(_, _, operands):
                        aggregates = aggregates + 1
                        for operand in operands:
                            match operand.kind:
                                case MirOperandKind.Move(_): moves = moves + 1
                                case MirOperandKind.Copy(_): copies = copies + 1
                                case _: ()
                    case _: ()
    # The constructor must exist: zero transfers cannot satisfy a copy test.
    expect(aggregates).to_equal(1)
    expect(lowering.errors.len()).to_equal(0)
    [moves, copies]

describe "ACOWN03 struct fields transfer owners":
    it "moves a unique field exactly once":
        val counts = struct_transfer_counts("&i64", true)
        expect(counts[0]).to_equal(1)
        expect(counts[1]).to_equal(0)

    it "moves nested optional unique payload ownership":
        val counts = struct_transfer_counts("(&i64)?", true)
        expect(counts[0]).to_equal(1)
        expect(counts[1]).to_equal(0)

    it "preserves shared and weak handle copies":
        val shared = struct_transfer_counts("*i64", true)
        val weak = struct_transfer_counts("-i64", true)
        expect(shared[0]).to_equal(0)
        expect(shared[1]).to_equal(1)
        expect(weak[0]).to_equal(0)
        expect(weak[1]).to_equal(1)

    it "preserves ordinary scalar copies in strict mode":
        val counts = struct_transfer_counts("i64", true)
        expect(counts[0]).to_equal(0)
        expect(counts[1]).to_equal(1)

    it "preserves legacy reference field behavior":
        val counts = struct_transfer_counts("&i64", false)
        expect(counts[0]).to_equal(0)
        expect(counts[1]).to_equal(1)
