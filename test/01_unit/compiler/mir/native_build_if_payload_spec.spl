# Regression: native-build's pure-Simple MIR lowerer decodes HirExprKind.If's
# payload tuple with `_sffi_tuple_get`, whose `-> Any` (non-optional) return
# contract rejected the nil that slot 2 legitimately holds when an `if` has no
# `else`. Every program containing a bare `if` therefore failed native-build
# with `nil is forbidden by the non-optional return contract of
# '_sffi_tuple_get'`. Fixed by declaring the helper `-> Any?` at both
# definition sites (50.mir/_MirLoweringExpr/expr_dispatch.spl,
# 70.backend/backend/_MirToLlvm/core_codegen.spl).
#
# Pre-fix this shape failed `native-build` (rc=1); post-fix it builds and runs.

fn if_without_else(op: i64) -> i64:
    var x = 0
    if op > 0:
        x = 1
    x

fn main():
    describe("native-build if payload"):
        it("lowers an if without else"):
            expect(if_without_else(3)).to_equal(1)
            expect(if_without_else(-1)).to_equal(0)
    return ()
