use std.spec.{describe, it, expect}
use compiler.mir.text_extern_abi.{boxed_text_arg_indices, text_arg_indices}

describe "atomic writer owned text ABI":
    it "boxes the path and full content without changing call arity":
        expect(boxed_text_arg_indices("rt_file_atomic_write").unwrap()).to_equal([0, 1])
        expect(text_arg_indices("rt_file_atomic_write")).to_be_nil()

    it "boxes only the two text arguments of the mode writer":
        # Index 2 is the untagged i32 permission mode, never a text handle.
        expect(boxed_text_arg_indices("rt_file_atomic_write_mode").unwrap()).to_equal([0, 1])
        expect(text_arg_indices("rt_file_atomic_write_mode")).to_be_nil()

    it "does not classify foreign or qualified names as runtime writers":
        expect(boxed_text_arg_indices("write")).to_be_nil()
        expect(boxed_text_arg_indices("other.rt_file_atomic_write")).to_be_nil()
        expect(boxed_text_arg_indices("other.rt_file_atomic_write_mode")).to_be_nil()

    it "preserves existing boxed and pointer-plus-length argument positions":
        expect(boxed_text_arg_indices("rt_string_builder_push").unwrap()).to_equal([1])
        expect(boxed_text_arg_indices("rt_file_write_text_at").unwrap()).to_equal([0, 2])
        expect(boxed_text_arg_indices("rt_file_write_text_at_cached").unwrap()).to_equal([1])
        expect(boxed_text_arg_indices("rt_file_write_text_at_cached_repeat").unwrap()).to_equal([1])
        expect(boxed_text_arg_indices("rt_io_tcp_write_text").unwrap()).to_equal([1])
        expect(boxed_text_arg_indices("rt_env_get")).to_be_nil()
        expect(text_arg_indices("rt_env_get").unwrap()).to_equal([0])
