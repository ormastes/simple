# REQ-MC-003: the extracted HIR literal folder retains MIR's existing subset.
use std.spec.*
use std.spec.step
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirBinOp, HirUnaryOp, HirInterpolation}
use compiler.hir.hir_literal_constant_v1.{HirLiteralConstantV1, hir_fold_literal_constant_v1}
use compiler.mir.mir.*

fn literal_expr_v1(kind: HirExprKind) -> HirExpr:
    val span = Span.default()
    HirExpr(kind: kind, has_type_: false, type_: HirType(kind: HirTypeKind.Unit, span: span), span: span)

fn literal_int_v1(value: i64) -> HirExpr:
    literal_expr_v1(HirExprKind.IntLit(value, nil))

fn neutral_text_v1(value: HirLiteralConstantV1) -> text:
    match value:
        case Int(v): "int:" + v.to_text()
        case Float(v): "float:" + v.to_text()
        case FloatLexeme(v): "lexeme:" + v
        case Bool(v): if v: "bool:true" else: "bool:false"
        case Str(v): "str:" + v

fn mir_literal_text_v1(value: MirConstValue) -> text:
    match value:
        case Int(v): "int:" + v.to_text()
        case Float(v): "float:" + v.to_text()
        case FloatLexeme(v): "lexeme:" + v
        case Bool(v): if v: "bool:true" else: "bool:false"
        case Str(v): "str:" + v
        case _: "unexpected MIR constant kind"

fn expect_literal_pair_v1(expr: HirExpr, expected: text):
    val folded = hir_fold_literal_constant_v1(expr)
    expect(folded == nil).to_equal(false)
    expect(neutral_text_v1(folded.unwrap())).to_equal(expected)
    var lowering = MirLowering.new(SymbolTable.new())
    val mirrored = lowering.lower_const_expr(expr)
    expect(mirrored == nil).to_equal(false)
    expect(mir_literal_text_v1(mirrored.unwrap())).to_equal(expected)

fn expect_binary_pair_v1(op: HirBinOp, left: i64, right: i64, expected: i64):
    val expr = literal_expr_v1(HirExprKind.Binary(op, literal_int_v1(left), literal_int_v1(right)))
    expect_literal_pair_v1(expr, "int:" + expected.to_text())

fn expect_unavailable_pair_v1(expr: HirExpr):
    expect(hir_fold_literal_constant_v1(expr) == nil).to_equal(true)
    var lowering = MirLowering.new(SymbolTable.new())
    expect(lowering.lower_const_expr(expr) == nil).to_equal(true)

describe "shared literal constant owner preserves MIR compatibility":
    it "retains the exact integer arithmetic and bitwise operator subset":
        step("Compare every supported integer operator through the HIR owner and MIR wrapper")
        expect_binary_pair_v1(HirBinOp.Add, 7, 3, 10)
        expect_binary_pair_v1(HirBinOp.Sub, 7, 3, 4)
        expect_binary_pair_v1(HirBinOp.Mul, 7, 3, 21)
        expect_binary_pair_v1(HirBinOp.Div, 7, 3, 2)
        expect_binary_pair_v1(HirBinOp.Mod, 7, 3, 1)
        expect_binary_pair_v1(HirBinOp.Shl, 7, 2, 28)
        expect_binary_pair_v1(HirBinOp.Shr, 28, 2, 7)
        expect_binary_pair_v1(HirBinOp.BitAnd, 7, 3, 3)
        expect_binary_pair_v1(HirBinOp.BitOr, 4, 3, 7)
        expect_binary_pair_v1(HirBinOp.BitXor, 7, 3, 4)

    it "recursively retains nested arithmetic and unary Neg and BitNot":
        val sum = literal_expr_v1(HirExprKind.Binary(HirBinOp.Add, literal_int_v1(2), literal_int_v1(3)))
        val product = literal_expr_v1(HirExprKind.Binary(HirBinOp.Mul, sum, literal_int_v1(4)))
        expect_literal_pair_v1(product, "int:20")
        val inverted = literal_expr_v1(HirExprKind.Unary(HirUnaryOp.BitNot, literal_int_v1(1)))
        expect_literal_pair_v1(inverted, "int:-2")
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.Unary(HirUnaryOp.Neg, inverted)), "int:2")

    it "keeps division and modulo by zero unavailable":
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Binary(
            HirBinOp.Div, literal_int_v1(1), literal_int_v1(0))))
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Binary(
            HirBinOp.Mod, literal_int_v1(1), literal_int_v1(0))))

    it "retains noninteger constant kinds used outside enum discriminants":
        step("Keep Bool, Str, Float and exact FloatLexeme text available to existing MIR callers")
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.BoolLit(true)), "bool:true")
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.StringLit("plain", nil)), "str:plain")
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.StringLit("plain", Some([]))), "str:plain")
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.FloatLit(1.5, nil)), "float:1.5")
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.FloatLexeme("1.2500e+2", nil)), "lexeme:1.2500e+2")

    it "toggles one FloatLexeme sign without numeric conversion":
        for lexeme in ["2.500", "+2.500"]:
            val expr = literal_expr_v1(HirExprKind.FloatLexeme(lexeme, nil))
            expect_literal_pair_v1(literal_expr_v1(HirExprKind.Unary(HirUnaryOp.Neg, expr)), "lexeme:-2.500")
        val negative = literal_expr_v1(HirExprKind.FloatLexeme("-0.0", nil))
        expect_literal_pair_v1(literal_expr_v1(HirExprKind.Unary(HirUnaryOp.Neg, negative)), "lexeme:0.0")

    it "preserves the sign bit when negating float zero":
        val zero = literal_expr_v1(HirExprKind.FloatLit(0.0, nil))
        val negated = literal_expr_v1(HirExprKind.Unary(HirUnaryOp.Neg, zero))
        val shared = hir_fold_literal_constant_v1(negated)
        expect(shared == nil).to_equal(false)
        var shared_negative_zero = false
        match shared.unwrap():
            case Float(v): shared_negative_zero = v == 0.0 and 1.0 / v < 0.0
            case _: ()
        expect(shared_negative_zero).to_equal(true)
        var lowering = MirLowering.new(SymbolTable.new())
        val mirrored = lowering.lower_const_expr(negated)
        expect(mirrored == nil).to_equal(false)
        var mir_negative_zero = false
        match mirrored.unwrap():
            case Float(v): mir_negative_zero = v == 0.0 and 1.0 / v < 0.0
            case _: ()
        expect(mir_negative_zero).to_equal(true)

    it "does not broaden acceptance to variables calls casts or comparisons":
        val variable = literal_expr_v1(HirExprKind.Var(SymbolId(id: 1)))
        val named = literal_expr_v1(HirExprKind.NamedVar(SymbolId(id: 1), "LIMIT"))
        expect_unavailable_pair_v1(variable)
        expect_unavailable_pair_v1(named)
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Call(named, [], [])))
        val span = Span.default()
        val target = HirType(kind: HirTypeKind.Int(64, true), span: span)
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Cast(literal_int_v1(1), target)))
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Binary(
            HirBinOp.Eq, literal_int_v1(1), literal_int_v1(1))))
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Binary(
            HirBinOp.Pow, literal_int_v1(2), literal_int_v1(3))))

    it "keeps boolean Not interpolated strings and mixed numeric arithmetic unavailable":
        val boolean = literal_expr_v1(HirExprKind.BoolLit(true))
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Unary(HirUnaryOp.Not, boolean)))
        val part = HirInterpolation(expr: literal_int_v1(1), has_format: false,
                                    format: "", span: Span.default())
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.StringLit("value", Some([part]))))
        val floating = literal_expr_v1(HirExprKind.FloatLit(1.5, nil))
        expect_unavailable_pair_v1(literal_expr_v1(HirExprKind.Binary(HirBinOp.Add, floating, literal_int_v1(1))))
