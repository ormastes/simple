use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.{HirFunction, HirExpr, HirExprKind, HirStmtKind}
use compiler.hir.generated.hir_codec.{hc_dec_hir_expr}
use compiler.mir.hir_expression_artifact_v1.{mir_hir_expression_encode_v1,
    mir_hir_expression_header_v1}

fn declaration_actual_lambda() -> HirExpr:
    val ast = parse_full_frontend("fn evaluate() -> i64:\n    val bias = 3\n    val callback = \\value: value + bias\n    callback(5)\n",
        "expression.spl", "expression", Logger(level: 0))
    var frontend = HirLowering.with_filename("expression.spl")
    val module = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    val function: HirFunction = module.functions.values()[0]
    match function.body.stmts[1].kind:
        case HirStmtKind.Let(_, _, expression): expression
        case _: panic("actual lambda declaration was not lowered as Let")

describe "declaration expression artifacts preserve complete actual HIR":
    it "retains a captured lambda body and binding identities in legacy codec bytes":
        val actual: HirExpr = declaration_actual_lambda()
        val encoded = mir_hir_expression_encode_v1(actual)
        expect(encoded.is_ok()).to_equal(true)
        var reader = FlatPoolReader.new(encoded.unwrap())
        expect(reader.next()).to_equal(mir_hir_expression_header_v1())
        val decoded: HirExpr = hc_dec_hir_expr(reader)
        expect(reader.ok).to_equal(true)
        expect(reader.pos).to_equal(reader.lines.len() - 1)
        match actual.kind:
            case HirExprKind.Lambda(params, _, captures):
                match decoded.kind:
                    case HirExprKind.Lambda(decoded_params, _, decoded_captures):
                        expect(decoded_params.len()).to_equal(params.len())
                        expect(decoded_params[0].symbol.id).to_equal(params[0].symbol.id)
                        expect(decoded_captures).to_equal(captures)
                    case _: panic("expression artifact dropped lambda body")
            case _: panic("fixture did not produce a real lambda")
        expect(mir_hir_expression_encode_v1(decoded).unwrap()).to_equal(encoded.unwrap())

    it "refuses an incomplete real expression record through the generated reader":
        val actual: HirExpr = declaration_actual_lambda()
        val encoded = mir_hir_expression_encode_v1(actual).unwrap()
        # Cut the record itself, beyond merely removing its terminal newline.
        var reader = FlatPoolReader.new(encoded.substring(0, encoded.len() / 2))
        reader.next()
        hc_dec_hir_expr(reader)
        expect(reader.ok).to_equal(false)
