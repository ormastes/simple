# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

"""
# Class-typed let from an existing local gets its own slot (MIR early-Let)

Owning bug: doc/08_tracking/bug/stage2_class_var_place_alias_clobbers_source_2026-11-16.md

The early-Let arm in `mir_lowering_stmts.spl` bound a new name straight to
the initializer's MIR local whenever that local carried a record
(`struct_value_syms`) or bitfield owner. `maybe_copy_struct_value` copies a
STRUCT place read, but it returns nil for a CLASS (reference semantics), so a
class place read fell through to the alias. The two names then shared one
local, and assigning either one overwrote the other:

    var trait_module = imported_mod       # same local as imported_mod
    trait_module = surfaces[i]            # also rebinds imported_mod

Measured on the integ2 Stage 2 (typed path, llvm):
`test/fixtures/compiler/native_class_var_place_alias/main.spl` printed
`param a=tm`, `loop a=llvm,tm,tm len=4`, `reverse a=tm t=tm`. In Stage 3 it
broke HIR lowering of every module importing `LlvmTypeMapper`
("stale surface index [impls] ... live_len=0").

The alias stays only for a FRESH aggregate (not a place read). A place read
that reaches that point gets a new local, a copy of the handle, and keeps the
record and bitfield owner, so field reads still resolve.

The interpreter never aliased, so the behaviour block below is the oracle and
passes either way. The lowering-shape block is the red/green check. A native
proof needs a Stage 2 rebuilt with this change, or a Stage 3 relinked with a
recompiled `mir_lowering_stmts` object.
"""

use std.spec.step
use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

class AliasSurf:
    impls: [i64]
    name: text

fn alias_param_case(a: AliasSurf, all: [AliasSurf]) -> text:
    var t = a
    t = all[1]
    "{a.name}/{t.name}"

fn alias_reverse_case(all: [AliasSurf]) -> text:
    var a = all[0]
    val t = a
    a = all[1]
    "{a.name}/{t.name}"

describe "class-typed let from an existing local":
    it "keeps the source binding when the new var is reassigned (oracle)":
        # @req REQ-SSPEC-COMPILER
        step("keeps the source binding when the new var is reassigned")
        val s0 = AliasSurf(impls: [1, 2, 3, 4], name: "llvm")
        val s1 = AliasSurf(impls: [], name: "tm")
        val all = [s0, s1]
        expect(alias_param_case(s0, all)).to_equal("llvm/tm")
        expect(alias_reverse_case(all)).to_equal("tm/llvm")

    it "aliases only fresh aggregates in the early-Let arm":
        # @req REQ-SSPEC-COMPILER
        step("aliases only fresh aggregates in the early-Let arm")
        val stmts = rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(stmts.len() > 0).to_equal(true)
        expect(stmts).to_contain("elif (bf_sym != None or struct_sym != None) and not initializer_is_short and not mir_expr_kind_is_place(let_init.kind):")
        # The old unconditional alias arms are gone (early-Let and its twin).
        expect(stmts).to_not_contain("elif (bf_sym != None or struct_sym != None) and not initializer_is_short:\n")
        expect(stmts).to_not_contain("elif bf_sym != None or struct_sym != None:\n")
        expect(stmts).to_contain("elif (bf_sym != None or struct_sym != None) and not init_is_place:")

    it "keeps the record and bitfield owner on the fresh local":
        # @req REQ-SSPEC-COMPILER
        step("keeps the record and bitfield owner on the fresh local")
        val stmts = rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(stmts).to_not_contain("if initializer_is_short and struct_sym != None:")
        expect(stmts).to_not_contain("if initializer_is_short and bf_sym != None:")

    it "keeps the executable native fixture":
        # @req REQ-SSPEC-COMPILER
        step("keeps the executable native fixture")
        val entry = rt_file_read_text("test/fixtures/compiler/native_class_var_place_alias/main.spl") ?? ""
        expect(entry.len() > 0).to_equal(true)
        expect(entry).to_contain("    var t = a\n    t = all[1]")
        expect(entry).to_contain("    val t = a\n    a = all[1]")
        expect(entry).to_contain("#   loop a=llvm,llvm,llvm len=12")
