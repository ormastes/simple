# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
use std.spec.step

use std.spec.{describe, it, expect}
use compiler.mir._MirLowering.module_lowering.{mir_dynamic_module_init_name}

describe "mir_dynamic_module_init_name":
    # @manual scenario evidence
    """The per-module initializer is an EXTERNAL symbol: cm33_shim.c declares
    `__module_init_src_os_kernel_arch_cortex_m33_scalar_parser_fs_policy_spl_dynamic`
    by that fixed name and scripts/check/check-cm33-scalar-parser-fs-object.shs
    pins it. Bug simpleos_cm33_policy_symbols_mangled_2026-09-26: the name was
    derived from the raw parsed path, which under SIMPLE_SCV_FREEZE_FALLBACK=1
    is the absolute snapshot path, so the object carried
    `__module_init__home_<user>_simple_build_scv_snapshots_scv_revision_v1_<sha>_src_..._dynamic`
    and the Cortex-M link failed."""

    it "derives the same symbol from a frozen SCV snapshot path as from the repo path":
        # @req REQ-SSPEC-UNIT
        step("derives the same symbol from a frozen SCV snapshot path as from the repo path")
        val expected = "__module_init_src_os_kernel_arch_cortex_m33_scalar_parser_fs_policy_spl_dynamic"
        val frozen = "/home/u/simple/build/scv_snapshots/scv_revision_v1_372ff06fa9d9/src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl"
        expect(mir_dynamic_module_init_name("src/os/kernel/arch/cortex_m33/scalar_parser_fs_policy.spl")).to_equal(expected)
        expect(mir_dynamic_module_init_name(frozen)).to_equal(expected)

    it "never embeds a host directory or content hash":
        # @req REQ-SSPEC-UNIT
        step("never embeds a host directory or content hash")
        val frozen = "/home/u/simple/build/scv_snapshots/scv_revision_v1_372ff06fa9d9/src/os/kernel/arch/cortex_m33/access_policy.spl"
        val name = mir_dynamic_module_init_name(frozen)
        expect(name.contains("scv_snapshots")).to_equal(false)
        expect(name.contains("home")).to_equal(false)
        expect(name).to_equal("__module_init_src_os_kernel_arch_cortex_m33_access_policy_spl_dynamic")

    it "keeps the bootstrap module index suffix on the repo-relative name":
        # @req REQ-SSPEC-UNIT
        step("keeps the bootstrap module index suffix on the repo-relative name")
        val frozen = "/w/build/scv_snapshots/scv_revision_v1_0/src/app/x.spl"
        expect(mir_dynamic_module_init_name(frozen, 3)).to_equal("__module_init_src_app_x_spl_3_dynamic")
