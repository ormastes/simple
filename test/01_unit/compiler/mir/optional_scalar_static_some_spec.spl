"""
A statically non-optional scalar flowing into a `T?` slot is boxed as Some
UNCONDITIONALLY; a scalar Optional used as its payload type is unwrapped first
(doc/08_tracking/bug/optional_scalar_runtime_classified_three_becomes_none_2026-10-11.md).

Before this, `take(3)`, `w.put(x + 1)`, `val o: i64? = 3` and `return 3` from a
`-> i64?` function went through normalize_option_handle, which classifies the
raw word at RUNTIME: the word 3 is the nil sentinel, so the integer 3 became
None. That is the original defect (`== nil` true for 3) moved to the boxing
site. And inside a callee, `v + 1` after `if v != nil:` read the Option HANDLE.

Two kinds of example:

- SHAPE: the lowered MIR of a static source has `rt_enum_new` and no
  `option_norm_raw` block / `rt_enum_id` probe; a source of unknown
  provenance keeps the runtime classification.
- VALUE: the lowered MIR is executed by the MIR interpreter. That interpreter
  has no runtime library (an unknown callee yields 0), so the five Option
  runtime entry points are MODELLED in Simple source, lowered by the same
  lowering and bound under their runtime names: a handle is `2^60 + payload *
  2 + discriminant`, the nil sentinel is the word 3, a small integer is itself.
  The model covers small non-negative integer and bool payloads only.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_json.{serialize_mir_function}
use compiler.interp.mir_interpreter.{MirInterpreter}

val MODEL = (
    "fn m_enum_new(id: i64, disc: i64, payload: i64) -> i64:\n    1152921504606846976 + payload * 2 + disc\n\n" +
    "fn m_enum_id(v: i64) -> i64:\n    if v >= 1152921504606846976:\n        return 1\n    0\n\n" +
    "fn m_is_none(v: i64) -> i64:\n    if v == 3:\n        return 1\n    if v >= 1152921504606846976:\n        return (v - 1152921504606846976) % 2\n    0\n\n" +
    "fn m_is_some(v: i64) -> i64:\n    1 - m_is_none(v)\n\n" +
    "fn m_payload(v: i64) -> i64:\n    if v >= 1152921504606846976:\n        return (v - 1152921504606846976) / 2\n    v\n\n"
)

val SHAPES = (
    "extern fn ext_early() -> i64\n\n" +
    "struct B:\n    i: i64\n\n" +
    "fn plain() -> i64:\n    7\n\n" +
    "fn take(o: i64?) -> bool:\n    o == nil\n\n" +
    "fn takeb(o: bool?) -> bool:\n    o == nil\n\n" +
    "fn takef(o: f64?) -> bool:\n    o == nil\n\n" +
    "fn s_lit() -> bool:\n    take(3)\n\n" +
    "fn s_bool_lit() -> bool:\n    takeb(true)\n\n" +
    "fn s_float_lit() -> bool:\n    takef(2.5)\n\n" +
    "fn s_add(x: i64) -> bool:\n    take(x + 1)\n\n" +
    "fn s_mul_lits() -> bool:\n    take(1 * 3)\n\n" +
    "fn s_neg(x: i64) -> bool:\n    take(-x)\n\n" +
    "fn s_cmp(x: i64) -> bool:\n    takeb(x == 1)\n\n" +
    "fn s_cast(x: i32) -> bool:\n    take(x as i64)\n\n" +
    "fn s_ifexpr(c: bool) -> bool:\n    take(if c: 1 else: 3)\n\n" +
    "fn s_coalesce(a: i64?) -> bool:\n    take(a ?? 3)\n\n" +
    "fn s_param(x: i64) -> bool:\n    take(x)\n\n" +
    "fn s_local_typed() -> bool:\n    val n: i64 = 3\n    take(n)\n\n" +
    "fn s_local_untyped_expr(x: i64) -> bool:\n    val n = x + 1\n    take(n)\n\n" +
    "fn s_field(b: B) -> bool:\n    take(b.i)\n\n" +
    "fn s_call() -> bool:\n    take(plain())\n\n" +
    "fn s_array(xs: [i64]) -> bool:\n    take(xs[0])\n\n" +
    "fn s_bind_lit() -> bool:\n    val o: i64? = 3\n    o == nil\n\n" +
    "fn s_bind_add(x: i64) -> bool:\n    val o: i64? = x + 1\n    o == nil\n\n" +
    "fn s_ret_lit() -> i64?:\n    3\n\n" +
    "fn s_ret_add(x: i64) -> i64?:\n    return x + 1\n\n" +
    "fn a_extern() -> bool:\n    take(zz_ext_late())\n\n" +
    "fn r_extern_early() -> bool:\n    take(ext_early())\n\n" +
    "fn a_extern_cmp() -> bool:\n    zz_ext_late() == nil\n\n" +
    "fn a_extern_local_cmp() -> bool:\n    val p = zz_ext_late()\n    p == nil\n\n" +
    "fn r_untyped(v) -> bool:\n    take(v)\n\n" +
    "fn r_dict(d: Dict<text, i64>) -> bool:\n    take(d[\"k\"])\n\n" +
    "fn r_len(xs: [i64]) -> bool:\n    take(xs.len())\n\n" +
    "fn p_opt(o: i64?) -> bool:\n    take(o)\n\n" +
    "fn n_nil() -> bool:\n    take(nil)\n\n" +
    "extern fn zz_ext_late() -> i64\n"
)

val VALUES = (
    "class W:\n    n: i64\n\n    me put(v: i64?) -> i64:\n        if v == nil:\n            return -1\n        v ?? -2\n\n" +
    "fn g(x: i64) -> i64:\n    x + 10\n\n" +
    "fn take(o: i64?) -> i64:\n    if o == nil:\n        return -1\n    o ?? -2\n\n" +
    "fn takeb(o: bool?) -> i64:\n    if o == nil:\n        return -1\n    1\n\n" +
    "fn n_add(v: i64?) -> i64:\n    if v != nil:\n        return v + 1\n    -1\n\n" +
    "fn n_mul(v: i64?) -> i64:\n    if v == nil:\n        return -1\n    2 * v\n\n" +
    "fn n_cmp(v: i64?) -> i64:\n    if v != nil:\n        if v > 4:\n            return 1\n        return 0\n    -1\n\n" +
    "fn n_pass(v: i64?) -> i64:\n    if v != nil:\n        return g(v)\n    -1\n\n" +
    "fn n_ret(v: i64?) -> i64:\n    if v != nil:\n        return v\n    -1\n\n" +
    "fn n_tail(v: i64?) -> i64:\n    if v == nil:\n        return -1\n    v\n\n" +
    "fn n_bind(v: i64?) -> i64:\n    if v != nil:\n        val x: i64 = v\n        return x + 1\n    -1\n\n" +
    "fn n_ifval(v: i64?) -> i64:\n    if val x = v:\n        return x + 1\n    -1\n\n" +
    "fn n_eq3(v: i64?) -> i64:\n    if v == 3:\n        return 1\n    0\n\n" +
    "fn n_ne3(v: i64?) -> i64:\n    if v != 3:\n        return 1\n    0\n\n" +
    "fn e_take3() -> i64:\n    take(3)\n\n" +
    "fn e_take0() -> i64:\n    take(0)\n\n" +
    "fn e_take_add() -> i64:\n    val x = 2\n    take(x + 1)\n\n" +
    "fn e_take_nil() -> i64:\n    take(nil)\n\n" +
    "fn e_takeb_true() -> i64:\n    takeb(true)\n\n" +
    "fn e_takeb_false() -> i64:\n    takeb(false)\n\n" +
    "fn e_bind3() -> i64:\n    val o: i64? = 3\n    if o == nil:\n        return -1\n    o ?? -2\n\n" +
    "fn e_put3() -> i64:\n    var w = W(n: 0)\n    w.put(3)\n\n" +
    "fn e_put_add() -> i64:\n    var w = W(n: 0)\n    val x = 2\n    w.put(x + 1)\n\n" +
    "fn e_put_nil() -> i64:\n    var w = W(n: 0)\n    w.put(nil)\n\n" +
    "fn e_add() -> i64:\n    n_add(5)\n\n" +
    "fn e_add3() -> i64:\n    n_add(3)\n\n" +
    "fn e_add_nil() -> i64:\n    n_add(nil)\n\n" +
    "fn e_mul() -> i64:\n    n_mul(5)\n\n" +
    "fn e_cmp() -> i64:\n    n_cmp(5)\n\n" +
    "fn e_cmp_small() -> i64:\n    n_cmp(3)\n\n" +
    "fn e_pass() -> i64:\n    n_pass(5)\n\n" +
    "fn e_ret() -> i64:\n    n_ret(5)\n\n" +
    "fn e_tail() -> i64:\n    n_tail(5)\n\n" +
    "fn e_bind() -> i64:\n    n_bind(5)\n\n" +
    "fn e_ifval() -> i64:\n    n_ifval(5)\n\n" +
    "fn e_eq3_some3() -> i64:\n    n_eq3(3)\n\n" +
    "fn e_eq3_some5() -> i64:\n    n_eq3(5)\n\n" +
    "fn e_eq3_none() -> i64:\n    n_eq3(nil)\n\n" +
    "fn e_ne3_some3() -> i64:\n    n_ne3(3)\n\n" +
    "fn e_ne3_none() -> i64:\n    n_ne3(nil)\n"
)

fn lower_all(src: text) -> {text: MirFunction}:
    val module = parse_full_frontend(src, "oss.spl", "oss.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("oss.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var table: {text: MirFunction} = {}
    for function in mir.functions.values():
        table[function.name] = function
    table

# "STATIC" = boxed with a fixed discriminant; "RUNTIME" = sentinel-classified;
# "NOBOX" = passed through; "MISSING" = the function was not lowered.
fn shape(table: {text: MirFunction}, name: text) -> text:
    if not table.contains("oss.{name}"):
        return "MISSING"
    val j = serialize_mir_function(table["oss.{name}"])
    if j.contains("option_norm_raw") or j.contains("rt_enum_id"):
        return "RUNTIME"
    if j.contains("rt_enum_new"):
        return "STATIC"
    "NOBOX"

fn run(table: {text: MirFunction}, entry: text) -> i64:
    var bound = table
    bound["rt_enum_new"] = table["oss.m_enum_new"]
    bound["rt_enum_id"] = table["oss.m_enum_id"]
    bound["rt_is_none"] = table["oss.m_is_none"]
    bound["rt_is_some"] = table["oss.m_is_some"]
    bound["rt_unwrap_or_self"] = table["oss.m_payload"]
    bound["rt_enum_payload"] = table["oss.m_payload"]
    var interp = MirInterpreter.create()
    interp.set_function_table(bound)
    val res = interp.execute_function(bound["oss.{entry}"])
    if res[1].?:
        return -777
    res[0] ?? -778

describe "a statically non-optional scalar is boxed as Some without runtime classification", tag: ["only-compiled"]:
    it "boxes literals, arithmetic, comparison, negation, cast, if and ?? results statically":
        val t = lower_all(SHAPES)
        for name in ["s_lit", "s_bool_lit", "s_float_lit", "s_add", "s_mul_lits", "s_neg", "s_cmp", "s_cast", "s_ifexpr", "s_coalesce"]:
            expect("{name}={shape(t, name)}").to_equal("{name}=STATIC")

    it "boxes declared scalar locals, params, fields, call results and array elements statically":
        val t = lower_all(SHAPES)
        for name in ["s_param", "s_local_typed", "s_local_untyped_expr", "s_field", "s_call", "s_array"]:
            expect("{name}={shape(t, name)}").to_equal("{name}=STATIC")

    it "boxes statically at an annotated binding and at both return forms":
        val t = lower_all(SHAPES)
        for name in ["s_bind_lit", "s_bind_add", "s_ret_lit", "s_ret_add"]:
            expect("{name}={shape(t, name)}").to_equal("{name}=STATIC")

    it "keeps runtime classification for extern results, untyped values, Dict reads and builtin method results":
        val t = lower_all(SHAPES)
        # Functions are lowered in name order: `a_extern` is lowered BEFORE the
        # extern it calls (`zz_ext_late`) is reached, `r_extern_early` after
        # `ext_early`. The result must be recognised as an extern result either
        # way (externs are marked in the prescan); before, `a_extern` boxed a
        # possible nil word as Some.
        for name in ["a_extern", "r_extern_early", "r_untyped", "r_dict", "r_len"]:
            expect("{name}={shape(t, name)}").to_equal("{name}=RUNTIME")

    it "does not fold `ext() == nil` when the caller is lowered before the extern declaration":
        val t = lower_all(SHAPES)
        for name in ["a_extern_cmp", "a_extern_local_cmp"]:
            val j = serialize_mir_function(t["oss.{name}"])
            val kept = j.contains("rt_is_none") or j.contains("rt_native_eq") or j.contains("Eq")
            expect("{name} runtime-compare={kept}").to_equal("{name} runtime-compare=true")

    it "passes an optional through and builds None for a nil literal":
        val t = lower_all(SHAPES)
        expect(shape(t, "p_opt")).to_equal("NOBOX")
        expect(shape(t, "n_nil")).to_equal("STATIC")

describe "executed: scalars 3 / 0 / true / false arrive present, nil arrives absent", tag: ["only-compiled"]:
    it "free function arguments":
        val t = lower_all(MODEL + VALUES)
        expect(run(t, "e_take3")).to_equal(3)
        expect(run(t, "e_take0")).to_equal(0)
        expect(run(t, "e_take_add")).to_equal(3)
        expect(run(t, "e_take_nil")).to_equal(-1)
        expect(run(t, "e_takeb_true")).to_equal(1)
        expect(run(t, "e_takeb_false")).to_equal(1)

    it "annotated binding and method arguments":
        val t = lower_all(MODEL + VALUES)
        expect(run(t, "e_bind3")).to_equal(3)
        expect(run(t, "e_put3")).to_equal(3)
        expect(run(t, "e_put_add")).to_equal(3)
        expect(run(t, "e_put_nil")).to_equal(-1)

describe "executed: a scalar optional used as its payload type is unwrapped", tag: ["only-compiled"]:
    it "arithmetic and ordering after a nil test":
        val t = lower_all(MODEL + VALUES)
        expect(run(t, "e_add")).to_equal(6)
        expect(run(t, "e_add3")).to_equal(4)
        expect(run(t, "e_add_nil")).to_equal(-1)
        expect(run(t, "e_mul")).to_equal(10)
        expect(run(t, "e_cmp")).to_equal(1)
        expect(run(t, "e_cmp_small")).to_equal(0)

    it "argument, return, tail and binding into a plain scalar slot":
        val t = lower_all(MODEL + VALUES)
        expect(run(t, "e_pass")).to_equal(15)
        expect(run(t, "e_ret")).to_equal(5)
        expect(run(t, "e_tail")).to_equal(5)
        expect(run(t, "e_bind")).to_equal(6)
        expect(run(t, "e_ifval")).to_equal(6)

    it "equality with a plain scalar is present-and-equal, never the handle word":
        val t = lower_all(MODEL + VALUES)
        expect(run(t, "e_eq3_some3")).to_equal(1)
        expect(run(t, "e_eq3_some5")).to_equal(0)
        expect(run(t, "e_eq3_none")).to_equal(0)
        expect(run(t, "e_ne3_some3")).to_equal(0)
        expect(run(t, "e_ne3_none")).to_equal(1)
