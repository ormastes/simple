use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.{
    BlockId, LocalId, MirBody, MirBuilder, MirCallUnwindContract,
    MirConstValue, MirExceptionCleanupContract, MirFacetCleanupEntryContract,
    MirFunction, MirInst, MirInstKind, MirInstructionSite, MirModule,
    MirOperand, MirOperandKind,
    MirSignature, MirTerminator, MirType, MirTypeDef, MirTypeDefKind, MirTypeKind,
    mir_call_terminator_create, mir_operand_const_int, mir_operand_copy,
    mir_operand_move, validate_mir_exception_cfg,
    validate_mir_exception_module
}

fn cleanup_manifest_builder(name: text, symbol_id: i64) -> MirBuilder:
    var builder = MirBuilder.new()
    builder.begin_function(
        SymbolId(id: symbol_id), name,
        MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        Span.empty())
    builder

fn cleanup_release_operand() -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(
            "aspect_execution_context_release_facet_descriptor_or_panic"),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [
                MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")),
                MirType(kind: MirTypeKind.Opaque(
                    "__simple_facet_descriptor_lease_abi"))],
            return_type: MirType.unit(), is_variadic: false)))))

fn cleanup_manifest_entry(
    owner: LocalId, lease: LocalId, block: BlockId, instruction_index: i64
) -> MirFacetCleanupEntryContract:
    MirFacetCleanupEntryContract(
        owner: owner, lease: lease, present: nil, guard_block: nil,
        release_site: MirInstructionSite(
            block: block, instruction_index: instruction_index),
        continue_block: nil,
        release_symbol:
            "aspect_execution_context_release_facet_descriptor_or_panic")

fn reverse_cleanup_body(name: text, symbol_id: i64) -> MirBody:
    var builder = cleanup_manifest_builder(name, symbol_id)
    val normal = builder.new_block(Some("normal"))
    val unwind = builder.new_block(Some("unwind"))
    val outer_context = builder.new_temp(MirType(kind: MirTypeKind.Struct(
        SymbolId(id: 8001))))
    val outer_owner = builder.emit_bitcast(
        mir_operand_copy(outer_context),
        MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")))
    val outer_lease = builder.new_temp(MirType(kind: MirTypeKind.Opaque(
        "__simple_facet_descriptor_lease_abi")))
    builder.emit_const(outer_lease, MirConstValue.Zero,
        MirType(kind: MirTypeKind.Opaque("__simple_facet_descriptor_lease_abi")))
    val inner_context = builder.new_temp(MirType(kind: MirTypeKind.Struct(
        SymbolId(id: 8001))))
    val inner_owner = builder.emit_bitcast(
        mir_operand_copy(inner_context),
        MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")))
    val inner_lease = builder.new_temp(MirType(kind: MirTypeKind.Opaque(
        "__simple_facet_descriptor_lease_abi")))
    builder.emit_const(inner_lease, MirConstValue.Zero,
        MirType(kind: MirTypeKind.Opaque("__simple_facet_descriptor_lease_abi")))
    builder.set_terminator(mir_call_terminator_create(
        nil, mir_operand_const_int(1), [], normal,
        MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
    builder.switch_to_block(unwind)
    val token = builder.emit_landing_pad()
    builder.emit_call(cleanup_release_operand(),
        [mir_operand_copy(inner_owner), mir_operand_copy(inner_lease)],
        MirType.unit())
    builder.emit_call(cleanup_release_operand(),
        [mir_operand_copy(outer_owner), mir_operand_copy(outer_lease)],
        MirType.unit())
    builder.terminate_resume(mir_operand_move(token))
    builder.switch_to_block(normal)
    builder.terminate_return(nil)
    var body = MirBody.from_function(builder.end_function())
    body.exception_cleanup_contracts = [MirExceptionCleanupContract(
        unwind_entry: unwind, token: token,
        entries: [
            cleanup_manifest_entry(inner_owner, inner_lease, unwind, 1),
            cleanup_manifest_entry(outer_owner, outer_lease, unwind, 2)])]
    body

fn cleanup_block_index(body: MirBody, block: BlockId) -> i64:
    var index = 0
    while index < body.blocks.len():
        if body.blocks[index].id.id == block.id:
            return index
        index = index + 1
    -1

fn cleanup_manifest_function(body: MirBody) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 1201), name: body.name,
        signature: MirSignature(
            params: [], return_type: MirType.unit(), is_variadic: false),
        locals: body.locals, blocks: body.blocks,
        entry_block: BlockId.entry(), span: Span.empty(),
        generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {},
        exception_cleanup_contracts: body.exception_cleanup_contracts)

describe "MIR cleanup manifest exact acceptance":
    it "accepts nested unconditional entries only in reverse release order":
        val body = reverse_cleanup_body("nested_reverse", 1101)
        expect(body.exception_cleanup_contracts[0].entries.len()).to_equal(2)
        expect(validate_mir_exception_cfg(body).is_ok()).to_be(true)

    it "rejects reordered and duplicate extra release execution":
        var reordered = reverse_cleanup_body("reordered", 1102)
        var contract = reordered.exception_cleanup_contracts[0]
        val first = contract.entries[0]
        contract.entries[0] = contract.entries[1]
        contract.entries[1] = first
        reordered.exception_cleanup_contracts[0] = contract
        expect(validate_mir_exception_cfg(reordered).unwrap_err()).to_contain(
            "missing or reordered")

        var duplicate_extra = reverse_cleanup_body("duplicate_extra", 1103)
        val unwind = duplicate_extra.exception_cleanup_contracts[0].unwind_entry
        val block_index = cleanup_block_index(duplicate_extra, unwind)
        var block = duplicate_extra.blocks[block_index]
        block.instructions.push(block.instructions[2])
        duplicate_extra.blocks[block_index] = block
        expect(validate_mir_exception_cfg(
            duplicate_extra).unwrap_err()).to_contain("extra release")

    it "rejects paired cleanup and manifest deletion":
        var deleted = reverse_cleanup_body("paired_deleted", 1111)
        val unwind = deleted.exception_cleanup_contracts[0].unwind_entry
        val unwind_index = cleanup_block_index(deleted, unwind)
        var unwind_block = deleted.blocks[unwind_index]
        unwind_block.instructions = [unwind_block.instructions[0]]
        deleted.blocks[unwind_index] = unwind_block
        deleted.exception_cleanup_contracts = []
        expect(validate_mir_exception_cfg(deleted).unwrap_err()).to_contain(
            "facet cleanup landing pad has no manifest")

    it "accepts a mandatory empty manifest for a zero-release landing pad":
        var builder = cleanup_manifest_builder("empty_cleanup", 1116)
        val normal = builder.new_block(Some("normal"))
        val unwind = builder.new_block(Some("unwind"))
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(unwind)
        val token = builder.emit_landing_pad()
        builder.terminate_resume(mir_operand_move(token))
        builder.switch_to_block(normal)
        builder.terminate_return(nil)
        var body = MirBody.from_function(builder.end_function())
        body.exception_cleanup_contracts = [MirExceptionCleanupContract(
            unwind_entry: unwind, token: token, entries: [])]
        expect(validate_mir_exception_cfg(body).is_ok()).to_be(true)

    it "rejects fabricated, missing, repeated, and post-call local definitions":
        var fabricated = reverse_cleanup_body("fabricated_owner", 1112)
        val fabricated_owner = fabricated.exception_cleanup_contracts[0].entries[0].owner
        var fabricated_entry = fabricated.blocks[0]
        fabricated_entry.instructions[2] = MirInst(kind: MirInstKind.Const(
            fabricated_owner, MirConstValue.Zero,
            MirType(kind: MirTypeKind.Opaque("AspectExecutionContext"))), span: nil)
        fabricated.blocks[0] = fabricated_entry
        expect(validate_mir_exception_cfg(fabricated).unwrap_err()).to_contain(
            "owner is not a canonical context Bitcast")

        var missing = reverse_cleanup_body("missing_lease_definition", 1113)
        var missing_entry = missing.blocks[0]
        missing_entry.instructions.pop()
        missing.blocks[0] = missing_entry
        expect(validate_mir_exception_cfg(missing).unwrap_err()).to_contain(
            "local must have exactly one definition")

        var repeated = reverse_cleanup_body("repeated_lease_definition", 1114)
        var repeated_entry = repeated.blocks[0]
        repeated_entry.instructions.push(repeated_entry.instructions[3])
        repeated.blocks[0] = repeated_entry
        expect(validate_mir_exception_cfg(repeated).unwrap_err()).to_contain(
            "local must have exactly one definition")

        var global_redefined = reverse_cleanup_body(
            "load_global_lease_redefinition", 1116)
        val global_lease = global_redefined.exception_cleanup_contracts[0].entries[0].lease
        var global_entry = global_redefined.blocks[0]
        global_entry.instructions.push(MirInst(kind: MirInstKind.LoadGlobal(
            global_lease, SymbolId(id: 9916)), span: nil))
        global_redefined.blocks[0] = global_entry
        expect(validate_mir_exception_cfg(
            global_redefined).unwrap_err()).to_contain(
            "local must have exactly one definition")

        var simd_redefined = reverse_cleanup_body(
            "simd_lease_redefinition", 1117)
        val simd_lease = simd_redefined.exception_cleanup_contracts[0].entries[0].lease
        var simd_entry = simd_redefined.blocks[0]
        simd_entry.instructions.push(MirInst(kind: MirInstKind.SimdHminF32x4(
            simd_lease, mir_operand_const_int(0)), span: nil))
        simd_redefined.blocks[0] = simd_entry
        expect(validate_mir_exception_cfg(
            simd_redefined).unwrap_err()).to_contain(
            "local must have exactly one definition")

        var late = reverse_cleanup_body("post_call_lease_definition", 1115)
        var late_entry = late.blocks[0]
        val late_definition = late_entry.instructions.pop()
        late.blocks[0] = late_entry
        var late_normal = late.blocks[cleanup_block_index(late, BlockId(id: 1))]
        late_normal.instructions.push(late_definition)
        late.blocks[cleanup_block_index(late, BlockId(id: 1))] = late_normal
        expect(validate_mir_exception_cfg(late).unwrap_err()).to_contain(
            "local definition does not dominate unwind call")

    it "roots dominance at the explicit entry when blocks are not entry-first":
        var body = reverse_cleanup_body("non_first_entry", 1118)
        body.blocks = [body.blocks[1], body.blocks[2], body.blocks[0]]
        expect(body.blocks[0].id.id == body.entry_block.id).to_be(false)
        expect(validate_mir_exception_cfg(body).is_ok()).to_be(true)

    it "rejects stale locals and blocks plus wrong lease and presence types":
        var stale_local = reverse_cleanup_body("stale_local", 1104)
        var stale_local_contract = stale_local.exception_cleanup_contracts[0]
        var stale_local_entry = stale_local_contract.entries[0]
        stale_local_entry.lease = LocalId(id: 99999)
        stale_local_contract.entries[0] = stale_local_entry
        stale_local.exception_cleanup_contracts[0] = stale_local_contract
        expect(validate_mir_exception_cfg(stale_local).unwrap_err()).to_contain(
            "stale local")

        var stale_block = reverse_cleanup_body("stale_block", 1105)
        var stale_block_contract = stale_block.exception_cleanup_contracts[0]
        var stale_block_entry = stale_block_contract.entries[0]
        stale_block_entry.release_site = MirInstructionSite(
            block: BlockId(id: 99999), instruction_index: 1)
        stale_block_contract.entries[0] = stale_block_entry
        stale_block.exception_cleanup_contracts[0] = stale_block_contract
        expect(validate_mir_exception_cfg(stale_block).unwrap_err()).to_contain(
            "stale release block")

        var wrong_lease = reverse_cleanup_body("wrong_lease", 1106)
        var wrong_lease_contract = wrong_lease.exception_cleanup_contracts[0]
        var wrong_lease_entry = wrong_lease_contract.entries[0]
        wrong_lease_entry.lease = wrong_lease_entry.owner
        wrong_lease_contract.entries[0] = wrong_lease_entry
        wrong_lease.exception_cleanup_contracts[0] = wrong_lease_contract
        expect(validate_mir_exception_cfg(wrong_lease).unwrap_err()).to_contain(
            "owner or lease type is not exact")

        var wrong_present = reverse_cleanup_body("wrong_present", 1107)
        var wrong_present_contract = wrong_present.exception_cleanup_contracts[0]
        var wrong_present_entry = wrong_present_contract.entries[0]
        wrong_present_entry.present = Some(wrong_present_entry.owner)
        wrong_present_entry.guard_block = Some(
            wrong_present_contract.unwind_entry)
        wrong_present_entry.continue_block = Some(
            wrong_present_contract.unwind_entry)
        wrong_present_contract.entries[0] = wrong_present_entry
        wrong_present.exception_cleanup_contracts[0] = wrong_present_contract
        expect(validate_mir_exception_cfg(wrong_present).unwrap_err()).to_contain(
            "presence guard is not Bool")

    it "rejects a join reached with different manifest cursors":
        var builder = cleanup_manifest_builder("cursor_join", 1108)
        val normal = builder.new_block(Some("normal"))
        val unwind = builder.new_block(Some("unwind"))
        val release = builder.new_block(Some("release"))
        val bypass = builder.new_block(Some("bypass"))
        val join = builder.new_block(Some("join"))
        val context = builder.new_temp(MirType(kind: MirTypeKind.Struct(
            SymbolId(id: 8003))))
        val owner = builder.emit_bitcast(
            mir_operand_copy(context),
            MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")))
        val lease = builder.new_temp(MirType(kind: MirTypeKind.Opaque(
            "__simple_facet_descriptor_lease_abi")))
        builder.emit_const(lease, MirConstValue.Zero,
            MirType(kind: MirTypeKind.Opaque("__simple_facet_descriptor_lease_abi")))
        val condition = builder.new_temp(MirType.bool())
        builder.emit_const(condition, MirConstValue.Bool(true), MirType.bool())
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(unwind)
        val token = builder.emit_landing_pad()
        builder.terminate_if(mir_operand_copy(condition), release, bypass)
        builder.switch_to_block(release)
        builder.emit_call(cleanup_release_operand(),
            [mir_operand_copy(owner), mir_operand_copy(lease)], MirType.unit())
        builder.terminate_goto(join)
        builder.switch_to_block(bypass)
        builder.terminate_goto(join)
        builder.switch_to_block(join)
        builder.terminate_resume(mir_operand_move(token))
        builder.switch_to_block(normal)
        builder.terminate_return(nil)
        var body = MirBody.from_function(builder.end_function())
        body.exception_cleanup_contracts = [MirExceptionCleanupContract(
            unwind_entry: unwind, token: token,
            entries: [cleanup_manifest_entry(owner, lease, release, 0)])]
        expect(validate_mir_exception_cfg(body).unwrap_err()).to_contain(
            "join has inconsistent manifest order")

    it "checks dominance against every MayUnwind call sharing one target":
        var builder = cleanup_manifest_builder("shared_unwind_target", 1117)
        val defined_call = builder.new_block(Some("defined_call"))
        val bypass_call = builder.new_block(Some("bypass_call"))
        val defined_normal = builder.new_block(Some("defined_normal"))
        val bypass_normal = builder.new_block(Some("bypass_normal"))
        val unwind = builder.new_block(Some("unwind"))
        val condition = builder.new_temp(MirType.bool())
        builder.emit_const(condition, MirConstValue.Bool(true), MirType.bool())
        builder.terminate_if(
            mir_operand_copy(condition), defined_call, bypass_call)
        builder.switch_to_block(defined_call)
        val context = builder.new_temp(MirType(kind: MirTypeKind.Struct(
            SymbolId(id: 8010))))
        val owner = builder.emit_bitcast(
            mir_operand_copy(context),
            MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")))
        val lease = builder.new_temp(MirType(kind: MirTypeKind.Opaque(
            "__simple_facet_descriptor_lease_abi")))
        builder.emit_const(lease, MirConstValue.Zero,
            MirType(kind: MirTypeKind.Opaque("__simple_facet_descriptor_lease_abi")))
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], defined_normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(bypass_call)
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(2), [], bypass_normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(unwind)
        val token = builder.emit_landing_pad()
        builder.emit_call(cleanup_release_operand(),
            [mir_operand_copy(owner), mir_operand_copy(lease)], MirType.unit())
        builder.terminate_resume(mir_operand_move(token))
        builder.switch_to_block(defined_normal)
        builder.terminate_return(nil)
        builder.switch_to_block(bypass_normal)
        builder.terminate_return(nil)
        var body = MirBody.from_function(builder.end_function())
        body.exception_cleanup_contracts = [MirExceptionCleanupContract(
            unwind_entry: unwind, token: token,
            entries: [cleanup_manifest_entry(owner, lease, unwind, 1)])]
        expect(validate_mir_exception_cfg(body).unwrap_err()).to_contain(
            "local definition does not dominate unwind call")

    it "resolves owner source nominal identity through module types":
        val body = reverse_cleanup_body("nominal_owner", 1118)
        val function = cleanup_manifest_function(body)
        var canonical_types: Dict<SymbolId, MirTypeDef> = {}
        canonical_types[SymbolId(id: 8001)] = MirTypeDef(
            symbol: SymbolId(id: 8001), name: "AspectExecutionContext",
            kind: MirTypeDefKind.Struct([]), is_export_c: false,
            export_name: "")
        val canonical = MirModule(
            name: "canonical_owner", functions: {function.symbol: function},
            statics: {}, constants: {}, types: canonical_types,
            facet_binding_plans: [], prepared_advice_slots: [])
        expect(validate_mir_exception_module(
            canonical, "at final backend handoff").is_ok()).to_be(true)

        var wrong_types: Dict<SymbolId, MirTypeDef> = {}
        wrong_types[SymbolId(id: 8001)] = MirTypeDef(
            symbol: SymbolId(id: 8001), name: "ArbitraryStruct",
            kind: MirTypeDefKind.Struct([]), is_export_c: false,
            export_name: "")
        val wrong = MirModule(
            name: "wrong_owner", functions: {function.symbol: function},
            statics: {}, constants: {}, types: wrong_types,
            facet_binding_plans: [], prepared_advice_slots: [])
        expect(validate_mir_exception_module(
            wrong, "at final backend handoff").unwrap_err()).to_contain(
            "owner source is not canonical AspectExecutionContext")

        var wrong_kind_types: Dict<SymbolId, MirTypeDef> = {}
        wrong_kind_types[SymbolId(id: 8001)] = MirTypeDef(
            symbol: SymbolId(id: 8001), name: "AspectExecutionContext",
            kind: MirTypeDefKind.Enum([]), is_export_c: false,
            export_name: "")
        val wrong_kind = MirModule(
            name: "wrong_owner_kind", functions: {function.symbol: function},
            statics: {}, constants: {}, types: wrong_kind_types,
            facet_binding_plans: [], prepared_advice_slots: [])
        expect(validate_mir_exception_module(
            wrong_kind, "at final backend handoff").unwrap_err()).to_contain(
            "owner source is not canonical AspectExecutionContext")

    it "rejects an orphan manifest and rejects stale metadata at the final typed gate":
        var orphan = reverse_cleanup_body("orphan", 1109)
        var orphan_contract = orphan.exception_cleanup_contracts[0]
        orphan_contract.unwind_entry = BlockId(id: 99999)
        orphan.exception_cleanup_contracts[0] = orphan_contract
        expect(validate_mir_exception_cfg(orphan).unwrap_err()).to_contain(
            "orphan facet cleanup manifest")

        var stale = reverse_cleanup_body("final_gate_stale", 1110)
        var stale_contract = stale.exception_cleanup_contracts[0]
        var stale_entry = stale_contract.entries[0]
        stale_entry.release_site = MirInstructionSite(
            block: BlockId(id: 99999), instruction_index: 1)
        stale_contract.entries[0] = stale_entry
        stale.exception_cleanup_contracts[0] = stale_contract
        val function = cleanup_manifest_function(stale)
        val module = MirModule(
            name: "final_gate_stale",
            functions: {function.symbol: function},
            statics: {}, constants: {}, types: {},
            facet_binding_plans: [], prepared_advice_slots: [])
        expect(validate_mir_exception_module(
            module, "at final backend handoff").unwrap_err()).to_contain(
            "stale release block")
