"""
The retained MIR return-type diagnostic must keep its raw enum probes behind
the debug gate and under the canonical FFI capability.
"""

use std.spec.*
use std.io.{file_read}

describe "MIR return-type diagnostic SFFI authority":
    it "documents and scopes all four debug-only enum probes":
        val source = file_read(
            "src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""
        expect(source).to_contain("@unsafe(reason: \"raw enum-tag probe; -1 denotes a non-enum")
        expect(source).to_contain("if mir_rettype_probe_on():")
        expect(source.count("val hir_ret_disc = unsafe(capabilities: [ffi]):")).to_equal(1)
        expect(source.count("val hir_unit_disc = unsafe(capabilities: [ffi]):")).to_equal(1)
        expect(source.count("val mir_ret_disc = unsafe(capabilities: [ffi]):")).to_equal(1)
        expect(source.count("val mir_unit_disc = unsafe(capabilities: [ffi]):")).to_equal(1)
