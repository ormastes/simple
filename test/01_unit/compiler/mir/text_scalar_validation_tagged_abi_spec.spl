# Pin for bug native_text_scalar_validation_failure_2026_10_18.
#
# rt_text_validate_utf8 / rt_text_count_codepoints_cached are strict
# tagged-value decoders (runtime_simd_utf8.c takes int64_t value). Before
# 4c2cb77f466 native lowering passed the char* bridge, so the decoder rejected
# plain ASCII "a" (fixture exit 13). They must stay tagged-value arguments and
# must never be routed through the char*/ptr-len text bridge.
use std.spec.*
use compiler.mir.text_extern_abi.{tagged_text_value_arg_indices, text_arg_indices}

fn tagged_first_arg(name: text) -> bool:
    val idx = tagged_text_value_arg_indices(name)
    if idx == None:
        return false
    val v = idx.unwrap()
    v.len() == 1 and v[0] == 0

describe "native text scalar validation tagged ABI":
    it "passes rt_text_validate_utf8 as a tagged text value":
        expect(tagged_first_arg("rt_text_validate_utf8")).to_equal(true)

    it "passes rt_text_count_codepoints_cached as a tagged text value":
        expect(tagged_first_arg("rt_text_count_codepoints_cached")).to_equal(true)

    it "passes rt_text_count_codepoints as a tagged text value":
        expect(tagged_first_arg("rt_text_count_codepoints")).to_equal(true)

    it "does not route the validators through the char* bridge":
        expect(text_arg_indices("rt_text_validate_utf8") == None).to_equal(true)
        expect(text_arg_indices("rt_text_count_codepoints_cached") == None).to_equal(true)
