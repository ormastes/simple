use std.spec.{describe, it, expect}
use compiler.mir.mir_types.{
    MirType,
    MirTypeKind,
    mir_type_probe_text,
    mir_type_probe_shallow
}

describe "MIR type diagnostic probe exports":
    it "renders scalar and one-level composite shapes through explicit imports":
        expect(mir_type_probe_text(MirType.i64())).to_equal("I64")
        expect(mir_type_probe_text(MirType(
            kind: MirTypeKind.Array(MirType.i64(), 0)
        ))).to_equal("Array(I64,0)")
        expect(mir_type_probe_text(MirType(
            kind: MirTypeKind.Opaque("str")
        ))).to_equal("Opaque(str)")
        expect(mir_type_probe_shallow(MirType(
            kind: MirTypeKind.Array(MirType.i64(), 0)
        ))).to_equal("Array")
