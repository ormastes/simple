"""FileHandle path ABI registry contracts.

The C providers take pointer + byte length, followed by mode for open.
These registry checks do not substitute for compiled file read/write tests:
the prebuilt r17 producer must be rebuilt before it consumes this source fix.
"""

use std.spec.*
use compiler.mir.text_extern_abi.{text_arg_indices, text_extern_semantic_arity, boxed_text_arg_indices}

describe "FileHandle text extern ABI":
    it "splits the path while keeping open mode as a scalar operand":
        expect(text_arg_indices("rt_io_file_open").unwrap()).to_equal([0])
        expect(text_extern_semantic_arity("rt_io_file_open").unwrap()).to_equal(2)
        expect(boxed_text_arg_indices("rt_io_file_open")).to_be_nil()

    it "registers the one-path existence and deletion providers":
        expect(text_arg_indices("rt_io_file_exists").unwrap()).to_equal([0])
        expect(text_arg_indices("rt_io_file_delete").unwrap()).to_equal([0])
        expect(text_extern_semantic_arity("rt_io_file_exists").unwrap()).to_equal(1)
        expect(text_extern_semantic_arity("rt_io_file_delete").unwrap()).to_equal(1)
        expect(boxed_text_arg_indices("rt_io_file_exists")).to_be_nil()
        expect(boxed_text_arg_indices("rt_io_file_delete")).to_be_nil()

    it "does not classify foreign homonyms or unrelated descriptor calls as text":
        expect(text_arg_indices("other.rt_io_file_open")).to_be_nil()
        expect(text_extern_semantic_arity("other.rt_io_file_open")).to_be_nil()
        expect(text_arg_indices("rt_io_file_open_extra")).to_be_nil()
        expect(text_arg_indices("rt_io_file_read")).to_be_nil()
        expect(text_arg_indices("rt_io_file_write")).to_be_nil()

    it "distinguishes facade arities from already expanded raw calls":
        expect(text_extern_semantic_arity("rt_io_file_open").unwrap() == 3).to_equal(false)
        expect(text_extern_semantic_arity("rt_io_file_exists").unwrap() == 2).to_equal(false)
        expect(text_extern_semantic_arity("rt_io_file_delete").unwrap() == 2).to_equal(false)
