# The per-module transient MIR scope promotes the `_bootstrap_fn_*` flat
# registries. Those dicts accumulate across every closure module, so promoting
# them wholesale re-walked the whole accumulated registry once per module
# (Stage 3 closure step ~700 -> ~150 modules/min after #3919). The promote must
# touch only what the module inserted, and must leave the registry contents
# identical to the unscoped path.
use std.spec.*
use compiler.mir.mir_types.*
use compiler.mir.mir_data.*
use compiler.hir.hir_types.{HirType}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

extern fn rt_file_read_text(path: text) -> text

val DELTA_MODULES = 24
val DELTA_ENTRIES = 6

fn delta_key(prefix: text, module_index: i64, entry_index: i64) -> text:
    "{prefix}_mod{module_index}.fn{entry_index}"

fn delta_shape(prefix: text, module_index: i64, entry_index: i64) -> text:
    "{prefix}.Shape{module_index}_{entry_index}"

# One synthetic closure module: DELTA_ENTRIES fresh names (text-valued and
# MirType-valued rows) plus one name that collides with module 0's first row,
# which drives the ambiguity rebuild path.
fn delta_register_module(prefix: text, module_index: i64, with_conflicts: bool):
    var entry_index = 0
    while entry_index < DELTA_ENTRIES:
        val name = delta_key(prefix, module_index, entry_index)
        bootstrap_fn_ret_shape_register(name, delta_shape(prefix, module_index, entry_index))
        bootstrap_fn_ret_err_shape_register(name, "err.{delta_shape(prefix, module_index, entry_index)}")
        bootstrap_fn_ret_type_register(name, MirType.i64())
        entry_index = entry_index + 1
    if with_conflicts and module_index > 0 and module_index % 8 == 0:
        bootstrap_fn_ret_shape_register(delta_key(prefix, 0, 1), "{prefix}.Conflict{module_index}")

# Returns the promoted-root counts, one per module.
fn delta_lower_modules_scoped(prefix: text, modules: i64, with_conflicts: bool) -> [i64]:
    var counts: [i64] = []
    var module_index = 0
    while module_index < modules:
        expect(transient_scope_begin()).to_equal(true)
        delta_register_module(prefix, module_index, with_conflicts)
        val paused = transient_scope_pause()
        val promoted = if paused: bootstrap_fn_registries_promote() else: false
        val ended = transient_scope_end()
        expect(paused and promoted and ended).to_equal(true)
        counts.push(bootstrap_fn_registries_last_promote_roots_v1())
        module_index = module_index + 1
    counts

fn delta_window_has(lines: [text], center: i64, before: i64, after: i64, needle: text) -> bool:
    var line_index = center - before
    if line_index < 0:
        line_index = 0
    while line_index <= center + after and line_index < lines.len():
        if lines[line_index].contains(needle):
            return true
        line_index = line_index + 1
    false

fn delta_is_registry_name(trimmed: text) -> bool:
    (trimmed.starts_with("_bootstrap_fn_") or trimmed.starts_with("_bootstrap_default_provider_")) and
        not trimmed.starts_with("_bootstrap_fn_journal_") and not trimmed.starts_with("_bootstrap_fn_replaced_") and
        not trimmed.starts_with("_bootstrap_fn_dirty_") and
        not trimmed.starts_with("_bootstrap_fn_registries_adopted") and not trimmed.starts_with("_bootstrap_fn_promote_last_roots") and
        not trimmed.starts_with("_bootstrap_fn_delta_")

# Static coverage: an in-scope registry write that is not journaled is a
# dangling row after scope end, and the interpreter's runtime twin does not
# reclaim, so the dynamic examples above cannot see it. Every keyed write must
# journal its key (and its non-immediate value) next to the write, and every
# handle replacement must raise its replaced flag.
fn delta_unjournaled_writes() -> [text]:
    val lines = (rt_file_read_text("src/compiler/50.mir/mir_data.spl") ?? "").split("\n")
    var missing: [text] = []
    var in_reset = false
    var line_index = 0
    while line_index < lines.len():
        val line = lines[line_index]
        val trimmed = line.trim()
        if line.starts_with("fn "):
            in_reset = line.starts_with("fn _bootstrap_fn_delta_reset")
        if not in_reset and delta_is_registry_name(trimmed):
            if trimmed.contains("] = "):
                val key = trimmed.split("[")[1].split("]")[0]
                val value = trimmed.split("] = ")[1]
                val actual_key_owner = trimmed.starts_with("_bootstrap_fn_ret_hir_ambig[") and
                    delta_window_has(lines, line_index, 0, 2, "_bootstrap_fn_dirty_ret_hir_ambig =")
                if not actual_key_owner and not delta_window_has(lines, line_index, 3, 3, "_bootstrap_fn_delta_text({key})"):
                    missing.push("key:{line_index + 1}:{trimmed}")
                if value != "true" and value != "\"\"" and
                        not delta_window_has(lines, line_index, 0, 3, "({value})"):
                    missing.push("value:{line_index + 1}:{trimmed}")
            elif trimmed.contains(" = ") and not trimmed.contains("("):
                if not delta_window_has(lines, line_index, 0, 6, "_bootstrap_fn_replaced_"):
                    missing.push("replace:{line_index + 1}:{trimmed}")
        line_index = line_index + 1
    missing

describe "bootstrap fn registry promotion is per-module delta":
    it "keeps every registered row identical to the unscoped registry after N scoped modules":
        val counts = delta_lower_modules_scoped("same", DELTA_MODULES, true)
        expect(counts.len()).to_equal(DELTA_MODULES)
        expect(transient_array_scope_state_v1()).to_equal(0)
        var module_index = 0
        while module_index < DELTA_MODULES:
            var entry_index = 0
            while entry_index < DELTA_ENTRIES:
                val name = delta_key("same", module_index, entry_index)
                val shape = bootstrap_fn_ret_shape_lookup(name)
                if module_index == 0 and entry_index == 1:
                    # Conflicting definitions are ambiguous and never answered.
                    expect(shape == nil).to_equal(true)
                else:
                    expect(shape ?? "").to_equal(delta_shape("same", module_index, entry_index))
                expect(bootstrap_fn_ret_err_shape_lookup(name) ?? "").to_equal("err.{delta_shape("same", module_index, entry_index)}")
                val ret = bootstrap_fn_ret_type_lookup(name)
                expect(ret != nil).to_equal(true)
                entry_index = entry_index + 1
            module_index = module_index + 1

    it "promotes a bounded number of roots per module, independent of the accumulated registry":
        val counts = delta_lower_modules_scoped("scale", DELTA_MODULES, false)
        # Each module inserts DELTA_ENTRIES x (2 text keys + 2 text values +
        # 1 MirType). A whole-registry walk grows
        # with the module index instead; compare the last module with the
        # first so the check is about scaling, not an exact constant.
        # Index 0 may carry the once-per-process wholesale adoption.
        var max_count = 0
        var count_index = 1
        while count_index < counts.len():
            if counts[count_index] > max_count:
                max_count = counts[count_index]
            count_index = count_index + 1
        expect(max_count <= counts[1] * 2 + DELTA_MODULES).to_equal(true)
        expect(counts[DELTA_MODULES - 1] <= counts[1] + DELTA_ENTRIES).to_equal(true)

    it "journals every registry write in mir_data.spl":
        val missing = delta_unjournaled_writes()
        expect(missing.len()).to_equal(0)
        if missing.len() > 0:
            print missing.join("\n")

    it "keeps ambiguity promotion independent of unrelated HIR metadata growth":
        expect(transient_scope_begin()).to_equal(true)
        for index in 0..64:
            val name = "delta.hir.retained.{index}"
            val scalar = HirType.named("i32")
            bootstrap_fn_ret_hir_type_register(name, scalar)
            bootstrap_fn_param_hir_types_register(name, [scalar])
        val initially_paused = transient_scope_pause()
        val initially_promoted = if initially_paused: bootstrap_fn_registries_promote() else: false
        val initially_ended = transient_scope_end()
        expect(initially_paused and initially_promoted and initially_ended).to_equal(true)

        expect(transient_scope_begin()).to_equal(true)
        val conflict = "delta.hir.retained.0"
        bootstrap_fn_ret_hir_type_register(conflict, HirType.named("i64"))
        bootstrap_fn_param_hir_types_register(conflict, [HirType.named("i64")])
        val paused = transient_scope_pause()
        val promoted = if paused: bootstrap_fn_registries_promote() else: false
        val ended = transient_scope_end()
        expect(paused and promoted and ended).to_equal(true)
        # Native stores box keys independently of the text journal, so the
        # actual ambiguity dictionary must be promoted. Its cost must not
        # grow with unrelated return/parameter metadata dictionaries.
        val ambiguity_roots = bootstrap_fn_registries_last_promote_roots_v1()
        expect(bootstrap_fn_ret_hir_type_lookup(conflict) == nil).to_equal(true)
        expect(bootstrap_fn_param_hir_types_lookup(conflict) == nil).to_equal(true)
        for index in 1..64:
            val name = "delta.hir.retained.{index}"
            expect(bootstrap_fn_ret_hir_type_lookup(name) != nil).to_equal(true)
            expect(bootstrap_fn_param_hir_types_lookup(name) != nil).to_equal(true)

        for index in 0..64:
            val name = "delta.hir.unrelated-growth.{index}"
            val scalar = HirType.named("i32")
            bootstrap_fn_ret_hir_type_register(name, scalar)
            bootstrap_fn_param_hir_types_register(name, [scalar])
        expect(transient_scope_begin()).to_equal(true)
        val next_conflict = "delta.hir.retained.1"
        bootstrap_fn_ret_hir_type_register(next_conflict, HirType.named("i64"))
        bootstrap_fn_param_hir_types_register(next_conflict, [HirType.named("i64")])
        val growth_paused = transient_scope_pause()
        val growth_promoted = if growth_paused: bootstrap_fn_registries_promote() else: false
        val growth_ended = transient_scope_end()
        expect(growth_paused and growth_promoted and growth_ended).to_equal(true)
        val growth_roots = bootstrap_fn_registries_last_promote_roots_v1()
        expect(growth_roots <= ambiguity_roots + 1).to_equal(true)
        expect(bootstrap_fn_ret_hir_type_lookup(next_conflict) == nil).to_equal(true)
        expect(bootstrap_fn_param_hir_types_lookup(next_conflict) == nil).to_equal(true)
        for index in 0..64:
            val name = "delta.hir.unrelated-growth.{index}"
            expect(bootstrap_fn_ret_hir_type_lookup(name) != nil).to_equal(true)
            expect(bootstrap_fn_param_hir_types_lookup(name) != nil).to_equal(true)

        expect(transient_scope_begin()).to_equal(true)
        bootstrap_fn_ret_hir_type_register(conflict, HirType.named("i32"))
        bootstrap_fn_param_hir_types_register(conflict, [HirType.named("i32")])
        val repeated_paused = transient_scope_pause()
        val repeated_promoted = if repeated_paused: bootstrap_fn_registries_promote() else: false
        val repeated_ended = transient_scope_end()
        expect(repeated_paused and repeated_promoted and repeated_ended).to_equal(true)
        expect(bootstrap_fn_registries_last_promote_roots_v1()).to_equal(0)
        expect(bootstrap_fn_ret_hir_type_lookup(conflict) == nil).to_equal(true)
        expect(bootstrap_fn_param_hir_types_lookup(conflict) == nil).to_equal(true)
