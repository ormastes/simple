# stage2_receiver_bootstrap_fn_registry_promotion_failed_2026-09-13: a failed
# `_bootstrap_fn_*` promotion must name WHICH registry failed. A failing verdict
# is injected through bootstrap_fn_note_promote_result_v1 (the single recorder
# every promote goes through).
use std.spec.*
use compiler.mir.mir_data.*

describe "bootstrap fn registry promote failure names":
    it "names the injected failing registry in the error":
        bootstrap_fn_registries_failed_names_reset_v1()
        val kept = bootstrap_fn_note_promote_result_v1("_bootstrap_fn_ret_shapes", true)
        val failed = bootstrap_fn_note_promote_result_v1("_bootstrap_fn_param_defaults", false)
        expect(kept).to_equal(true)
        expect(failed).to_equal(false)
        val msg = bootstrap_fn_registry_promotion_error_v1("m.x")
        expect(msg.contains("_bootstrap_fn_param_defaults")).to_equal(true)
        expect(msg.contains("_bootstrap_fn_ret_shapes")).to_equal(false)
        expect(msg.contains("m.x")).to_equal(true)

    it "lists every failing registry and resets":
        bootstrap_fn_registries_failed_names_reset_v1()
        val a = bootstrap_fn_note_promote_result_v1("r1", false)
        val b = bootstrap_fn_note_promote_result_v1("r2", false)
        expect(bootstrap_fn_registries_failed_names_v1()).to_equal("r1,r2")
        bootstrap_fn_registries_failed_names_reset_v1()
        expect(bootstrap_fn_registries_failed_names_v1()).to_equal("")
