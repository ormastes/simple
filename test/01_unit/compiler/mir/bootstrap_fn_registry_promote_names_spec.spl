# stage2_receiver_bootstrap_fn_registry_promotion_failed_2026-09-13: a failed
# `_bootstrap_fn_*` promotion must name WHICH registry failed instead of the
# bare "bootstrap fn registry promotion failed".
use std.spec.*
use compiler.mir.mir_data.*

extern fn rt_file_read_text(path: text) -> text?

describe "bootstrap fn registry promote failure names":
    it "reports no failed registries before any promotion fails":
        expect(bootstrap_fn_registries_failed_names_v1()).to_equal("")

    it "never calls the raw promote for a registry without a name":
        val lines = (rt_file_read_text("src/compiler/50.mir/mir_data.spl") ?? "").split("\n")
        var raw = 0
        for line in lines:
            if line.contains("_promote_bootstrap_registry(") and not line.trim().starts_with("fn ") and not line.contains("val promoted ="):
                raw = raw + 1
        expect(raw).to_equal(0)

    it "includes the failed names in the lowering error":
        val src = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""
        # The needle carries literal braces. Build it by concatenation: a plain
        # "...{bootstrap_fn_registries_failed_names_v1()}..." string would
        # INTERPOLATE the (currently empty) failed-names value and never match
        # the source text, so this assertion must not be written inline.
        val needle = "failed registries [{" + "bootstrap_fn_registries_failed_names_v1()" + "}]"
        expect(src.contains(needle)).to_equal(true)
