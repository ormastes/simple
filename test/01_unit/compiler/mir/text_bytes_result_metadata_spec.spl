use std.io_runtime.{file_read}
use std.spec.*

describe "MIR text bytes result metadata":
    it "records the u8 element type for the typed bytes result local":
        # `text.bytes()` lowers to a typed runtime array local. Marking it as a
        # runtime array without its element type leaves the LLVM/Cranelift
        # array-length lane without the metadata it uses for typed reads; the
        # Cranelift encoding fixture returned length 0 for a six-byte text.
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
        val marker = "self.runtime_array_locals[bytes_array.id] = true\n                    self.mark_runtime_value_local(bytes_array.id)\n                    self.runtime_elem_value_type[bytes_array.id] = bytes_element_type"
        expect(source).to_contain(marker)
