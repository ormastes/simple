use std.spec
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable, HirSymbol, SymbolKind, ScopeId}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirField, HirCallArg}
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.mir_class_identity_raw
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*

# Generalization of bug runner_callback_field_owner_2026_10_11 beyond the
# exact `(port.execute_fn)(x)` shape: the projected callee may carry an
# ERASED scalar type instead of none, the field may sit behind a nested
# record chain (`host.port.execute_fn`), and a callee local that already
# proves its own callable type must keep it rather than be overridden.

fn cfg_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn cfg_symbol(id: i64, name: text, kind: SymbolKind, module_name: text?, type_: HirType?) -> HirSymbol:
    HirSymbol(id: SymbolId(id: id), name: name, kind: kind, type_: type_,
        scope: ScopeId(id: 0), span: Span.empty(), visibility: Visibility.Public,
        is_public: true, is_mutable: false, defining_module: module_name)

fn cfg_field(name: text, type_: HirType) -> HirField:
    val placeholder = HirExpr(kind: HirExprKind.IntLit(0), has_type_: false,
        type_: cfg_type(HirTypeKind.Error), span: Span.empty())
    HirField(symbol: SymbolId(id: 9), name: name, type_: type_,
        has_default: false, default: placeholder, visibility: Visibility.Public,
        is_public: true, is_volatile: false, has_bits_attr: false, bits_width: 0,
        has_fixed_address: false, fixed_address: 0, span: Span.empty())

fn cfg_i64() -> HirType:
    cfg_type(HirTypeKind.Int(64, true))

fn cfg_reply() -> HirType:
    cfg_type(HirTypeKind.Named(SymbolId(id: 7), []))

struct CfgHarness:
    lowering: MirLowering
    reply_key: text

fn cfg_harness() -> CfgHarness:
    var symbols = SymbolTable.new()
    val port_type = cfg_type(HirTypeKind.Named(SymbolId(id: 8), []))
    val host_type = cfg_type(HirTypeKind.Named(SymbolId(id: 6), []))
    symbols.register_preserved_symbol(cfg_symbol(6, "Host", SymbolKind.Struct, Some("src/provider.spl"), nil))
    symbols.register_preserved_symbol(cfg_symbol(7, "Reply", SymbolKind.Struct, Some("src/provider.spl"), nil))
    symbols.register_preserved_symbol(cfg_symbol(8, "Port", SymbolKind.Struct, Some("src/provider.spl"), nil))
    symbols.register_preserved_symbol(cfg_symbol(20, "port", SymbolKind.Parameter, nil, Some(port_type)))
    symbols.register_preserved_symbol(cfg_symbol(21, "value", SymbolKind.Parameter, nil, Some(cfg_i64())))
    symbols.register_preserved_symbol(cfg_symbol(22, "host", SymbolKind.Parameter, nil, Some(host_type)))
    val signature = cfg_type(HirTypeKind.Function([cfg_i64()], cfg_reply(), []))
    var lowering = MirLowering.new(symbols)
    val reply_key = lowering.declared_struct_layout_key(lowering.composite_layout_key(cfg_symbol(7, "Reply", SymbolKind.Struct, Some("src/provider.spl"), nil)))
    lowering.struct_field_order[reply_key] = ["status", "stdout", "stderr"]
    lowering.register_composite_field_metadata(mir_class_identity_raw(symbols, 8), [cfg_field("execute_fn", signature)], symbols, true)
    lowering.register_composite_field_metadata(mir_class_identity_raw(symbols, 6), [cfg_field("port", port_type)], symbols, true)
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 90), "probe", MirSignature(params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
    val port_local = builder.new_temp(MirType.i64())
    val arg_local = builder.new_temp(MirType.i64())
    val host_local = builder.new_temp(MirType.i64())
    lowering.builder = builder
    lowering.bind_local(20, port_local)
    lowering.remember_local_hir_type(port_local.id, port_type, 0, 0)
    lowering.bind_local(21, arg_local)
    lowering.remember_local_hir_type(arg_local.id, cfg_i64(), 0, 0)
    lowering.bind_local(22, host_local)
    lowering.remember_local_hir_type(host_local.id, host_type, 0, 0)
    CfgHarness(lowering: lowering, reply_key: reply_key)

fn cfg_var(id: i64, type_: HirType) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(SymbolId(id: id)), has_type_: true, type_: type_, span: Span.empty())

fn cfg_untyped_field(base: HirExpr, name: text) -> HirExpr:
    HirExpr(kind: HirExprKind.Field(base, name, nil), has_type_: false,
        type_: cfg_type(HirTypeKind.Error), span: Span.empty())

fn cfg_arg() -> HirCallArg:
    HirCallArg(value: cfg_var(21, cfg_i64()), has_name: false, name: "", span: Span.empty())

fn cfg_owner_of(lowering: MirLowering, local_id: i64) -> i64:
    if val type_ = lowering.find_local_hir_type(local_id):
        match type_.kind:
            case HirTypeKind.Named(symbol, _): return symbol.id
            case _: return -1
    -1

describe "declared callback field signature generalization":
    it "overrides an erased scalar type on the projected callee with the declared signature":
        var harness = cfg_harness()
        var lowering = harness.lowering
        var builder = lowering.builder
        val projected = builder.new_temp(MirType.i64())
        lowering.builder = builder
        lowering.remember_local_hir_type(projected.id, cfg_i64(), 0, 0)
        val callee = cfg_untyped_field(cfg_var(20, cfg_type(HirTypeKind.Named(SymbolId(id: 8), []))), "execute_fn")
        val result = lowering.lower_call_with_value(callee, [cfg_arg()], Some(projected))
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.struct_value_syms.get(result.id) ?? "").to_equal(harness.reply_key)
        expect(cfg_owner_of(lowering, result.id)).to_equal(7)

    it "recovers the signature through a nested record field chain":
        var harness = cfg_harness()
        var lowering = harness.lowering
        var builder = lowering.builder
        val projected = builder.new_temp(MirType.i64())
        lowering.builder = builder
        val inner = cfg_untyped_field(cfg_var(22, cfg_type(HirTypeKind.Named(SymbolId(id: 6), []))), "port")
        val callee = cfg_untyped_field(inner, "execute_fn")
        val result = lowering.lower_call_with_value(callee, [cfg_arg()], Some(projected))
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.struct_value_syms.get(result.id) ?? "").to_equal(harness.reply_key)
        expect(cfg_owner_of(lowering, result.id)).to_equal(7)

    it "keeps a callee local's own proven callable type over the declared field type":
        var harness = cfg_harness()
        var lowering = harness.lowering
        var builder = lowering.builder
        val projected = builder.new_temp(MirType.i64())
        lowering.builder = builder
        # The local already proves `fn(i64) -> bool`; the declared record
        # return must not be grafted onto it.
        lowering.remember_local_hir_type(projected.id, cfg_type(HirTypeKind.Function([cfg_i64()], cfg_type(HirTypeKind.Bool), [])), 0, 0)
        val callee = cfg_untyped_field(cfg_var(20, cfg_type(HirTypeKind.Named(SymbolId(id: 8), []))), "execute_fn")
        val result = lowering.lower_call_with_value(callee, [cfg_arg()], Some(projected))
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.struct_value_syms.contains(result.id)).to_equal(false)
        val actual = lowering.local_mir_type_of(result)
        expect(actual.?).to_equal(true)
        if val type_ = actual:
            expect(type_.kind).to_equal(MirTypeKind.Bool)
