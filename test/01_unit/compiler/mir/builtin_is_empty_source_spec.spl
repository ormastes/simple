extern fn rt_file_read_text(path: text) -> text

describe "built-in collection is_empty MIR lowering source":
    it "preserves self field collection types before selecting the bootstrap predicate ABI":
        val inference = rt_file_read_text("src/compiler/10.frontend/core/compiler/cg_helpers.spl") ?? ""
        val codegen = rt_file_read_text("src/compiler/10.frontend/core/compiler/cg_expr.spl") ?? ""

        expect(inference).to_contain("if fa_var == \"self\":")
        expect(inference).to_contain("val fa_self_type = vt_find(\"self_\" + fa_field)")
        expect(inference).to_contain("if fa_self_type >= 0:")
        expect(inference).to_contain("return fa_self_type")
        expect(codegen).to_contain("if method_name == \"is_empty\":")
        expect(codegen).to_contain("if is_array_type(ie_inferred):")
        expect(codegen).to_contain("return \"(spl_array_len(\" + recv_c + \") == 0)\"")
