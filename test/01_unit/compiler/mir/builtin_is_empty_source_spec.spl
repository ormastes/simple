extern fn rt_file_read_text(path: text) -> text?

describe "built-in collection is_empty MIR lowering source":
    it "compares a typed collection runtime length with zero":
        val source = (rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? "").replace("\r\n", "\n")

        expect(source).to_contain("method == \"len\" or method == \"length\" or method == \"is_empty\"")
        expect(source).to_contain("if self.local_is_runtime_array(receiver_local):")
        expect(source).to_contain("elif self.local_is_str(receiver_local):")
        expect(source).to_contain("if len_symbol == \"\" and len_recovery_allowed and method != \"is_empty\":")
        expect(source).to_contain("if has_prelowered_method_receiver:")
        expect(source).to_contain("val empty = b_empty.emit_binop(")
        expect(source).to_contain("MirBinOp.Eq,")
