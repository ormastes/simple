"""C7 exact one-pass relation against the frozen recursive implementation."""
# @req REQ-C7-DCE-ACTUAL
use std.spec.*
use compiler.mir_opt.dce_translation_validation.*

# Frozen from d9e177; this reference is deliberately independent of keep flags.
fn c7_reference_live(instructions: [DceTvInstructionV1], start: i64, register: i64, result: i64) -> bool:
    if start >= instructions.len(): return register == result
    val instruction = instructions[start]
    instruction.reads(register) or (register != instruction.destination() and
        c7_reference_live(instructions, start + 1, register, result))

fn c7_reference_validate(source: DceTvProgramV1, target: DceTvProgramV1) -> bool:
    if source.diagnostic() != "" or target.diagnostic() != "": return false
    if source.result_register != target.result_register: return false
    var target_index = 0
    for index in 0..source.instructions.len():
        if not c7_reference_live(source.instructions, index + 1,
                source.instructions[index].destination(), source.result_register): continue
        if target_index >= target.instructions.len(): return false
        if not source.instructions[index].same_as(target.instructions[target_index]): return false
        target_index = target_index + 1
    target_index == target.instructions.len()

fn c7_flags_program(source: DceTvProgramV1) -> DceTvProgramV1:
    val flags = dce_tv_keep_flags_v1(source)
    var kept: [DceTvInstructionV1] = []
    for index in 0..source.instructions.len():
        if flags[source.instructions.len() - 1 - index]: kept.push(source.instructions[index])
    DceTvProgramV1(kept, source.result_register)

fn c7_small_programs() -> [DceTvProgramV1]:
    val pool = [DceTvInstructionV1.Const(0, 4), DceTvInstructionV1.Const(1, -1),
        DceTvInstructionV1.Copy(0, 1), DceTvInstructionV1.Copy(1, 0),
        DceTvInstructionV1.Add(0, 0, 1), DceTvInstructionV1.Add(1, 1, 0),
        DceTvInstructionV1.Copy(0, -1), DceTvInstructionV1.Copy(1, 9)]
    var programs = [DceTvProgramV1([], 0)]
    for first in pool:
        programs.push(DceTvProgramV1([first], 0))
        for second in pool: programs.push(DceTvProgramV1([first, second], 0))
    programs

describe "C7 linear DCE validator compatibility":
    it "matches the frozen validator for every pair of bounded abstract programs":
        step("Compare actual production acceptance and full retained sequences for 73 programs and 5329 pairs")
        val programs = c7_small_programs()
        expect(programs.len()).to_equal(73)
        for source in programs:
            expect(c7_flags_program(source).canonical_text()).to_equal(dce_tv_optimize(source).canonical_text())
            for target in programs:
                expect(dce_tv_validate(source, target)).to_equal(c7_reference_validate(source, target))

    it "preserves non-SSA redefinition suffix reads and one-pass dead-chain behavior":
        step("Read-before-write and reads of removed instructions remain live in the source suffix")
        val sources = [DceTvProgramV1([DceTvInstructionV1.Const(1, 5),
                DceTvInstructionV1.Add(1, 1, 1), DceTvInstructionV1.Copy(0, 1)], 0),
            DceTvProgramV1([DceTvInstructionV1.Const(1, 5),
                DceTvInstructionV1.Copy(2, 1), DceTvInstructionV1.Const(0, 8)], 0),
            DceTvProgramV1([DceTvInstructionV1.Const(7, 5),
                DceTvInstructionV1.Const(7, 8), DceTvInstructionV1.Copy(9, 7)], 9)]
        for source in sources:
            val target = c7_flags_program(source)
            expect(target.canonical_text()).to_equal(dce_tv_optimize(source).canonical_text())
            expect(dce_tv_validate(source, target)).to_equal(c7_reference_validate(source, target))
        val first = c7_flags_program(sources[1])
        val second = c7_flags_program(first)
        expect(first.instructions.len()).to_equal(2)
        expect(second.instructions.len()).to_equal(1)
        expect(dce_tv_validate(sources[1], second)).to_equal(false)

    it "preserves invalid-domain helper behavior and wrapper diagnostic precedence":
        step("Diagnostic-invalid abstract programs retain legacy optimize behavior but cannot validate")
        for source in [DceTvProgramV1([DceTvInstructionV1.Const(-1, 4)], 0),
                DceTvProgramV1([DceTvInstructionV1.Copy(2, -1)], -1)]:
            val target = dce_tv_optimize(source)
            expect(c7_flags_program(source).canonical_text()).to_equal(target.canonical_text())
            expect(dce_tv_validate(source, target)).to_equal(false)
            val missing = validate_dce_translation_v1(source, target, "")
            expect(missing.diagnostic).to_equal("FV2-E-DCE-TV-AUDIT: MirDceTv.validate_sound axiom audit is required")
            expect(missing.certificate.?).to_equal(false)
            val rejected = validate_dce_translation_v1(source, target, "reference-only-not-proof")
            expect(rejected.diagnostic).to_equal("FV2-E-DCE-TV-REJECTED: target is not an accepted DCE refinement")
            expect(rejected.certificate.?).to_equal(false)
        val empty = DceTvProgramV1([], 0)
        expect(dce_tv_validate(empty, DceTvProgramV1([], 1))).to_equal(false)
