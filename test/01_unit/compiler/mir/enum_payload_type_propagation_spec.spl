# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# Regression pins for the Phase-3 run-11 enum-payload / module-static MIR
# failures (doc/08_tracking/bug/*_2026-10-24.md). The behavioural evidence is
# the fixtures under test/fixtures/compiler/p3fix_mir/<case>/main.spl (each
# carries `# EXPECT stdout:`), native-built by a producer that contains these
# fixes. UNEXECUTED: written in a lane that could not rebuild the producer, so
# neither this spec nor the fixtures were run against the fixed compiler.

use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "MIR enum payload type propagation":
    # @manual scenario evidence
    it "types the Ok payload of ? from the lowered call result":
        # @req REQ-SSPEC-COMPILER
        step("types the Ok payload of ? from the lowered call result")
        val source = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl") ?? ""
        expect(source).to_contain("if val lowered_base = self.find_local_hir_type(res_local.id):")
        expect(rt_file_read_text("test/fixtures/compiler/p3fix_mir/try/main.spl") ?? "").to_contain("val result = self.call_fn(k)?")

    it "decodes an if-val text binder on the present edge":
        # @req REQ-SSPEC-COMPILER
        step("decodes an if-val text binder on the present edge")
        val dispatch = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        val stmts = rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(dispatch).to_contain("val optional_text = HirType(kind: HirTypeKind.Optional(exists_payload_type), span: base.span)")
        expect(stmts).to_contain("val narrowed = self.option_text_value(extracted, self.bootstrap_text_type())")

    it "settles an imported non-generic record module static":
        # @req REQ-SSPEC-COMPILER
        step("settles an imported non-generic record module static")
        val source = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl") ?? ""
        expect(source).to_contain("self.nongeneric_record_owners[imported_type.id] = true")
        expect(rt_file_read_text("test/fixtures/compiler/p3fix_mir/ms/main.spl") ?? "").to_contain("var g_lb = LB(authority: 0, xs: [])")

    it "keeps unannotated Let bindings out of the Infer marker":
        # @req REQ-SSPEC-COMPILER
        step("keeps unannotated Let bindings out of the Infer marker")
        val stmts = rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(stmts).to_contain("fn mir_let_type_unsettled(t: HirType) -> bool:")
        expect(stmts).to_contain("let_type_settled = not mir_let_type_unsettled(settled_probe)")

    it "joins None and empty-array arms of a value-position match":
        # @req REQ-SSPEC-COMPILER
        step("joins None and empty-array arms of a value-position match")
        val stmts = rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(stmts).to_contain("self.option_none_locals.contains(arm_local.id)")
        expect(stmts).to_contain("saw_empty_array = true")

    it "admits a native enum Err payload for Result.err()":
        # @req REQ-SSPEC-COMPILER
        step("admits a native enum Err payload for Result.err()")
        val source = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/builtin_method_extras.spl") ?? ""
        expect(source).to_contain("bug=result_err_unwrap_unsupported_payload_2026-10-24")
