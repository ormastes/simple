# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

fn expr_dispatch_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""

fn mir_lowering_stmts_source() -> text:
    rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""

fn switch_operators_calls_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl") ?? ""

fn mir_to_llvm_core_source() -> text:
    rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl") ?? ""

fn hir_items_module_build_source() -> text:
    rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_build.spl") ?? ""

fn mir_llvm_asm_helpers_source() -> text:
    rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/asm_constraints_helpers.spl") ?? ""

fn hir_items_module_lowering_source() -> text:
    rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""

fn mir_module_lowering_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

fn mir_function_lowering_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""

fn method_calls_literals_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""

describe "bootstrap MIR binary lowering source":
    it "guards optional metadata before nil-comparison lowering":
        # @req REQ-SSPEC-COMPILER
        step("guards optional metadata before nil-comparison lowering")
        val source = expr_dispatch_source()

        expect(source).to_contain("me nil_compare_operand_is_declared_optional(e: HirExpr, local: LocalId) -> bool:")
        expect(source).to_contain("if e != None and e.has_type_:")
        expect(source).to_contain("if t != None:")
        expect(source).to_contain("self.nil_compare_operand_is_declared_optional(left, left_local) or self.option_value_locals.contains(left_local.id)")
        expect(source).to_contain("self.nil_compare_operand_is_declared_optional(right, right_local) or self.option_value_locals.contains(right_local.id)")
        expect(source.contains("match left.type_.kind:")).to_equal(false)
        expect(source.contains("match right.type_.kind:")).to_equal(false)

    it "lowers normal binary operators without optional special-op nil checks":
        # @req REQ-SSPEC-COMPILER
        step("lowers normal binary operators without optional special-op nil checks")
        val source = expr_dispatch_source()

        expect(source).to_contain("case PipeForward | Compose | ComposeBack | Parallel | LayerConnect:")
        expect(source).to_contain("case _:")
        expect(source).to_contain("val binop_result = b.emit_binop(mir_op, mir_operand_copy(left_binop), mir_operand_copy(right_binop), result_type)")

    it "defaults only unknown bootstrap indexes to text values":
        # @req REQ-SSPEC-COMPILER
        step("defaults only unknown bootstrap indexes to text values")
        val source = expr_dispatch_source()

        expect(source).to_contain("if (mir_expr_env_get(\"SIMPLE_BOOTSTRAP\") ?? \"\") == \"1\" and not result_type_from_base and not is_tuple_base:")
        expect(source).to_contain("result_type = self.bootstrap_text_type()")
        expect(source).to_contain("var base_local = self.lower_expr(base)")

        val helper_source = switch_operators_calls_source()
        expect(helper_source).to_contain("me bootstrap_text_type() -> MirType:")
        expect(helper_source).to_contain("if name == \"get_args\" or name == \"get_cli_args\":")
        expect(helper_source).to_contain("return MirType.ptr(self.bootstrap_text_array_type(), false)")

    it "preserves explicit branch terminators in lowered if blocks":
        # @req REQ-SSPEC-COMPILER
        step("preserves explicit branch terminators in lowered if blocks")
        val source = mir_lowering_stmts_source()

        expect(source).to_contain("if not b3.current_block_has_explicit_terminator():")
        expect(source).to_contain("if not b5.current_block_has_explicit_terminator():")
        expect(source).to_contain("b3.terminate_goto(merge_block)")
        expect(source).to_contain("b5.terminate_goto(merge_block)")

    it "preserves inferred float and bool locals through shared MIR type predicates":
        # @req REQ-SSPEC-COMPILER
        step("preserves inferred float and bool locals through shared MIR type predicates")
        val stmt_source = mir_lowering_stmts_source()

        expect(stmt_source).to_contain("fn local_is_float(local: LocalId) -> bool:")
        expect(stmt_source).to_contain("MirTypeKind.F64")
        expect(stmt_source).to_contain("MirTypeKind.F32")
        expect(stmt_source).to_contain("self.local_is_float(init_local)")
        expect(stmt_source).to_contain("fn local_is_bool(local: LocalId) -> bool:")
        expect(stmt_source).to_contain("case MirTypeKind.Bool: return true")
        expect(stmt_source.split("self.local_is_bool(init_local)").len() - 1).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "preserves class array-field metadata and mutating projection provenance":
        # @req REQ-SSPEC-COMPILER
        step("preserves class array-field metadata and mutating projection provenance")
        val hir_build_source = hir_items_module_build_source()
        val mir_source = mir_module_lowering_source()
        val expr_source = expr_dispatch_source()
        val method_source = method_calls_literals_source()

        expect(hir_build_source).to_contain("self.prescan_composite_field_types(prescan_name, prescan_struct.fields, prescan_struct.type_params)")
        expect(hir_build_source).to_contain("self.prescan_composite_field_types(prescan_name, prescan_class.fields, prescan_class.type_params)")
        expect(mir_source).to_contain("self.register_composite_field_metadata(struct_def.name, struct_def.fields, module_symbols, false)")
        expect(mir_source).to_contain("self.register_composite_field_metadata(class_def.name, class_def.fields, module.symbols, true)")
        expect(mir_source).to_contain("if overwrite or not self.struct_field_order.has(name):")
        expect(mir_source).to_contain("if overwrite or not self.struct_field_array_element_type_name.has(name):")
        expect(mir_source).to_contain("field_array_element_type_name = \"__runtime_array__\"")
        expect(mir_source).to_contain("self.struct_field_array_element_type_name[name] = field_array_element_type_names")
        expect(mir_source).to_contain("if overwrite or not self.struct_field_array_elem_type.has(name):")
        expect(mir_source).to_contain("self.struct_field_array_elem_type[name] = field_elem_types")
        expect(expr_source).to_contain("if self.struct_field_array_element_type_name.contains(name):")
        expect(expr_source).to_contain("case HirTypeKind.Array(_, _):")
        expect(expr_source.split("self.remember_field_projection_provenance(base, base_local, field_idx").len() - 1).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(method_source).to_contain("self.remember_field_projection_provenance(base, wb_base, wb_field_idx, wb_receiver)")

    it "lowers pointer text equality through runtime string compare":
        # @req REQ-SSPEC-COMPILER
        step("lowers pointer text equality through runtime string compare")
        val expr_source = expr_dispatch_source()
        val llvm_source = mir_to_llvm_core_source()
        val llvm_asm_source = mir_llvm_asm_helpers_source()

        expect(expr_source).to_contain("if self.local_is_str(left_local) or self.local_is_str(right_local):")
        expect(expr_source).to_contain("MirConstValue.Str(\"rt_text_eq_any\")")
        expect(llvm_asm_source).to_contain("declare ptr @rt_get_args()")
        expect(llvm_asm_source).to_contain("declare i64 @rt_text_eq_any(i64, i64)")
        expect(llvm_source).to_contain("elif bare_func_name == \"rt_get_args\":")
        expect(llvm_source).to_contain("known_ret_ty = \"ptr\"")

    it "lowers raw-pointer offset as a typed, element-scaled MIR operation":
        # @req REQ-SSPEC-COMPILER
        step("lowers raw-pointer offset as a typed, element-scaled MIR operation")
        val type_source = mir_function_lowering_source()
        val method_source = method_calls_literals_source()
        val llvm_source = mir_to_llvm_core_source()

        expect(type_source).to_contain("case HirTypeKind.Ptr(inner, mutable):")
        expect(type_source).to_contain("MirType.ptr(self.lower_type(inner), mutable)")
        expect(method_source).to_contain("if method == \"offset\" and args.len() == 1 and resolution_is_unresolved:")
        expect(method_source).to_contain("case MirTypeKind.Ptr(pointee, _):")
        expect(method_source).to_contain("val pointee_size = pointee.size_bytes()")
        expect(method_source).to_contain("MirBinOp.Mul")
        expect(method_source).to_contain("MirBinOp.Offset")
        expect(llvm_source).to_contain("{{dest_name}} = getelementptr i8, ptr {{left_val}}, {{nit}} {{right_val}}")
        expect(llvm_source.contains("ptrtoint ptr {{offset_ptr}}")).to_equal(false)

    it "lowers bootstrap print calls through runtime println":
        # @req REQ-SSPEC-COMPILER
        step("lowers bootstrap print calls through runtime println")
        val source = switch_operators_calls_source()
        val llvm_source = mir_to_llvm_core_source()
        val llvm_asm_source = mir_llvm_asm_helpers_source()

        expect(source).to_contain("me lower_bootstrap_print_call(args: [HirCallArg], rt_name: text) -> LocalId:")
        expect(source).to_contain("val writer = if rt_name == \"rt_print\": \"rt_print_str\" elif rt_name == \"rt_eprintln\": \"rt_eprintln_str\" else: \"rt_println_str\"")
        expect(source).to_contain("b.emit_call(func_operand, [print_arg], MirType.unit())")
        expect(llvm_asm_source).to_contain("declare void @rt_println(ptr)")
        expect(llvm_asm_source).to_contain("declare void @rt_println_str(ptr, i64)")
        expect(llvm_source).to_contain("elif imported_eprint:")

    it "qualifies enum-payload sub-pattern Wildcard arms against the HirPatternKind subject, not the parser's PatternKind":
        # @req REQ-SSPEC-COMPILER
        step("qualifies enum-payload sub-pattern Wildcard arms against the HirPatternKind subject, not the parser's PatternKind")
        # doc/08_tracking/bug/stage3_selfhost_nil_receiver_sigill_in_lower_expr_caller_2026-08-05.md
        # Rank 2: emit_deep_subpattern / emit_enum_payload_deep match on
        # `pat.kind` / `pats[i].kind`, whose static type is HirPatternKind, but
        # bare `Wildcard` arms were written qualified as the PARSER's
        # `PatternKind` -- a different enum with a different enum_id (only its
        # low ordinals happen to coincide with HirPatternKind). A native-codegen
        # match compares by enum_id, so a wrong-enum-qualified arm is either
        # dead or matches by ordinal coincidence -- either way it is not the
        # subject's own enum and must not appear in this lowering file.
        val source = switch_operators_calls_source()

        expect(source.contains("case PatternKind.Wildcard:")).to_equal(false)
        expect(source).to_contain("case HirPatternKind.Wildcard:")

    it "gates a level-gated stmt-caller probe naming the statement discriminant and span, default OFF":
        # @req REQ-SSPEC-COMPILER
        step("gates a level-gated stmt-caller probe naming the statement discriminant and span, default OFF")
        # Rank 4: lower_expr itself always completes cleanly on the observed
        # crashing runs (the last probe line before the fault is inside
        # lower_expr's own span-restore tail); the fault is in whatever
        # CONSUMES a statement's lowering result, and no existing probe names
        # the statement (discriminant + file:line:col) being lowered around
        # the crash. This probe closes that instrumentation gap; it must stay
        # env-gated (default OFF) so it costs nothing on a normal build.
        val source = mir_lowering_stmts_source()

        expect(source).to_contain("fn mir_stmt_caller_debug_enabled() -> bool:")
        expect(source).to_contain("env_get_opt(\"SIMPLE_MIR_STMT_CALLER_DEBUG\") == Some(\"1\")")
        expect(source).to_contain("fn mir_stmt_caller_probe(tag: text, stmt: HirStmt):")
        expect(source).to_contain("mir_stmt_caller_probe(\"before\", stmt)")
        expect(source).to_contain("self.lower_stmt_impl(stmt)")
        expect(source).to_contain("mir_stmt_caller_probe(\"after\", stmt)")
