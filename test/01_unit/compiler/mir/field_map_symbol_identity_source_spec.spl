extern fn rt_file_read_text(path: text) -> text

fn module_lowering_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

fn function_lowering_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""

describe "MIR field map symbol identity source":
    it "keys definitions and lookups by the direct SymbolId value":
        val module_source = module_lowering_source()
        val function_source = function_lowering_source()

        expect(module_source).to_contain("self.field_map[sym_id.id] = field_names")
        expect(module_source.contains("self.field_map[self.symbol_id_value(sym_id)] = field_names")).to_equal(false)
        expect(function_source).to_contain("val sym_id = found_type_sym.id")
