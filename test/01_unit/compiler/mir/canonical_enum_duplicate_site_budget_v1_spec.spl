# Authored UNRUN: tests the actual duplicate-check helper, not SOURCE admission.
use std.spec.{describe, it, expect, fail}
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1, MirLoopResourceLimitsV1}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{MirType}
use compiler.mir.mir_instruction_support.{BlockId, MirOperand, MirOperandKind}
use compiler.mir.mir_types.{MirConstValue}
use compiler.mir.canonical_enum_builtin_site_v1.*
use compiler.mir.canonical_enum_builtin_finalizer_v1.{canonical_enum_unique_site_v1, canonical_enum_duplicate_site_work_v1}

fn duplicate_account_v1(work: i64) -> MirLoopResourceAccountV1:
    var limits = MirLoopResourceLimitsV1()
    limits.max_work = work
    match MirLoopResourceAccountV1.create(limits):
        case Ok(account): account
        case Err(_): fail("duplicate-check test account unavailable")

fn duplicate_site_v1(block: i64, index: i64) -> CanonicalEnumBuiltinSiteV1:
    CanonicalEnumBuiltinSiteV1(owner: SymbolId(id: 1), block: BlockId(id: block),
        instruction_index: index, operation: CanonicalEnumBuiltinOperationV1.Payload,
        abi: 1, enum_runtime_id: 1, discriminant: 0,
        callee: MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), MirType.i64())),
        operands: [], operand_types: [], result: nil, result_type: MirType.i64())

describe("canonical enum duplicate-site prepayment"):
    it("refuses one-short before scanning and preserves failed reservation ledger"):
        val account = duplicate_account_v1(27)
        val before = account.snapshot().work_used
        val rejected = match canonical_enum_unique_site_v1([duplicate_site_v1(0, 0), duplicate_site_v1(0, 1)], 1, account):
            case Err(_): true
            case _: false
        expect(rejected).to_equal(true)
        expect(account.snapshot().work_used).to_equal(before)

    it("accepts exact boundary and distinguishes integer site coordinates"):
        val account = duplicate_account_v1(40)
        val rows = [duplicate_site_v1(0, 0), duplicate_site_v1(0, 1), duplicate_site_v1(1, 0)]
        val first = match canonical_enum_unique_site_v1(rows, 1, account):
            case Ok(_): true
            case _: false
        val second = match canonical_enum_unique_site_v1(rows, 2, account):
            case Ok(_): true
            case _: false
        expect(first).to_equal(true)
        expect(second).to_equal(true)
        expect(account.snapshot().work_used).to_equal(40)

    it("rejects a repeated pair after paying its full scan"):
        val account = duplicate_account_v1(28)
        val rejected = match canonical_enum_unique_site_v1([duplicate_site_v1(2, 9), duplicate_site_v1(2, 9)], 1, account):
            case Err(_): true
            case _: false
        expect(rejected).to_equal(true)
        expect(account.snapshot().work_used).to_equal(28)

    it("rejects overflow and negative scan bounds before multiplication"):
        val overflow = match canonical_enum_duplicate_site_work_v1(9223372036854775807):
            case Err(_): true
            case _: false
        val negative = match canonical_enum_duplicate_site_work_v1(-1):
            case Err(_): true
            case _: false
        expect(overflow).to_equal(true)
        expect(negative).to_equal(true)
