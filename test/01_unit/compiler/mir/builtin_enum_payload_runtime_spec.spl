use std.spec.*
use test.fixtures.compiler.builtin_enum_metadata.provider.{builtin_metadata_success, builtin_metadata_error, builtin_metadata_present, builtin_metadata_absent, builtin_metadata_fraction, builtin_metadata_values}

describe "builtin enum payloads across module boundaries":
    it "retains the integer success payload":
        step("Construct Result in a provider and match its payload in the importer")
        val actual = builtin_metadata_success(37)
        match actual:
            case Ok(value): expect(value).to_equal(37)
            case Err(_): fail("success became an error")

    it "retains the distinct text error payload":
        step("Construct Result error using the E parameter rather than T")
        val actual = builtin_metadata_error("payload retained")
        match actual:
            case Ok(_): fail("error became a success")
            case Err(value): expect(value).to_equal("payload retained")

    it "retains a present Option text payload":
        step("Extract a provider's Some payload without losing its text identity")
        val actual = builtin_metadata_present("present")
        match actual:
            case Some(value): expect(value).to_equal("present")
            case None: fail("present payload became absent")

    it "preserves a typed absent Option":
        step("Match provider-created None as the nullary Option variant")
        val actual = builtin_metadata_absent()
        expect(actual.is_none()).to_equal(true)

    it "decodes a float payload using the instantiated Option type":
        step("Match a provider Option f64 without replacing its inner type with template T")
        val actual = builtin_metadata_fraction(2.5)
        match actual:
            case Some(value): expect(value).to_equal(2.5)
            case None: fail("fraction became absent")

    it "retains collection element identity across the provider boundary":
        step("Match a provider Option array and read actual elements")
        val actual = builtin_metadata_values([13, 29])
        match actual:
            case Some(values):
                expect(values.len()).to_equal(2)
                expect(values[0]).to_equal(13)
                expect(values[1]).to_equal(29)
            case None: fail("array became absent")
