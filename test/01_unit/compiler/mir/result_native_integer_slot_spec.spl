# @req REQ-CLI-005
# @cover src/compiler/50.mir/_MirLoweringExpr/result_tuple_payload.spl
use std.spec.*
use std.spec.step
use compiler.mir.mir_data.{MirTypeKind}
use compiler.mir._MirLoweringExpr.result_tuple_payload.{native_result_tuple_integer_type}

describe "Native Result tuple integer slots":
    it "should preserve signed scalar widths":
        step("Classify each native signed integer width")
        expect(native_result_tuple_integer_type(8, true)!.kind).to_equal(MirTypeKind.I8)
        expect(native_result_tuple_integer_type(16, true)!.kind).to_equal(MirTypeKind.I16)
        expect(native_result_tuple_integer_type(32, true)!.kind).to_equal(MirTypeKind.I32)
        expect(native_result_tuple_integer_type(64, true)!.kind).to_equal(MirTypeKind.I64)

    it "should preserve unsigned scalar widths including bytes and full words":
        step("Classify each native unsigned integer width")
        expect(native_result_tuple_integer_type(8, false)!.kind).to_equal(MirTypeKind.U8)
        expect(native_result_tuple_integer_type(16, false)!.kind).to_equal(MirTypeKind.U16)
        expect(native_result_tuple_integer_type(32, false)!.kind).to_equal(MirTypeKind.U32)
        expect(native_result_tuple_integer_type(64, false)!.kind).to_equal(MirTypeKind.U64)

    it "should reject integer representations wider than a native word":
        step("Refuse widths without a native tuple-slot representation")
        expect(native_result_tuple_integer_type(128, false)).to_be_nil()
        expect(native_result_tuple_integer_type(128, true)).to_be_nil()
        expect(native_result_tuple_integer_type(0, true)).to_be_nil()
