# @req REQ-SSPEC-COMPILER
# bug: mir_ret_optional_operand_owner_2026_10_11 (verification pending: needs native mir_verify replay)
use std.spec
use std.spec.step
use std.io_runtime.{file_read}
use compiler.mir.mir_types.{MirType, LocalId}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, MirTerminator, BlockId}
use compiler.mir.mir_instruction_graph.{MirBlock, MirInst}

describe "Optional return operand keeps its MIR owner":
    it "return operand projection through MirBlock has an owner":
        step("Ret(Some(copy)) projects kind and local id")
        val instructions: [MirInst] = []
        val operand = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 17)))
        val subject = MirBlock(id: BlockId(id: 5), label: nil, instructions: instructions, terminator: MirTerminator.Ret(Some(operand)))
        expect(subject.bootstrap_ret_kind()).to_equal(1)
        expect(subject.bootstrap_ret_local_id()).to_equal(17)

    it "null-coalesce lowering falls back to the default operand's nominal owner":
        step("source contract for the owner fallback")
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        expect(source).to_contain("me null_coalesce_default_owner_type(right: HirExpr) -> HirType?:")
        expect(source).to_contain("elif val default_owner = self.null_coalesce_default_owner_type(right):")
        expect(source).to_contain("self.remember_local_hir_type(result_local.id, default_owner, 0, 0)")
