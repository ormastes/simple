# @req REQ-SSPEC-COMPILER
"""
Brace struct literal admission (mcp_native_source_form_gaps_2026_10_11, sub-gap 1).
lower_struct_construct evaluates named fields in declaration order, so the
StructLit arm must reject duplicate/unknown fields and out-of-order literals
whose values are not order-insensitive instead of silently reordering effects.
Native proof: test/fixtures/compiler/struct_literal_order/main.spl (needs stage3).
"""
use std.spec.step
use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "brace struct literal order admission":
    # @manual scenario evidence
    it "gates the StructLit arm on the order admission helper":
        # @req REQ-SSPEC-COMPILER
        step("gates the StructLit arm on the order admission helper")
        val dispatch = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        expect(dispatch).to_contain("struct_literal_order_problem(fields, self.struct_field_order[struct_name])")
        expect(dispatch).to_contain("return self.unsupported_expr_kind(\"E-MIR-EXPR-StructLit\", literal_problem, expr_value.span)")

    it "rejects duplicate, unknown and effectful reordered fields":
        # @req REQ-SSPEC-COMPILER
        step("rejects duplicate, unknown and effectful reordered fields")
        val helper = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/struct_literal_order.spl") ?? ""
        expect(helper).to_contain("in struct literal")
        expect(helper).to_contain("duplicate field")
        expect(helper).to_contain("unknown field")
        expect(helper).to_contain("if reordered and not all_insensitive:")
