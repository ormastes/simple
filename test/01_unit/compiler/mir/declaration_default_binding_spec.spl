# These are binder mechanics on actual frontend HIR. They neither manufacture
# final archive authority nor qualify the still inactive production route.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.*
use compiler.mir.hir_declaration_types_v1.*
use compiler.mir.hir_declaration_binding_contract_v1.*
use compiler.mir._MirLowering.declaration_default_bindings_v1.*
use compiler.mir._MirLowering.declaration_default_rewrite_v1.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*

fn default_binding_actual_module(name: text) -> HirModule:
    val source = "fn evaluate(base: i64) -> i64:\n    val callback = \\value: value + base\n    callback(5)\n"
    val ast = parse_full_frontend(source, "{name}.spl", name, Logger(level: 0))
    var frontend = HirLowering.with_filename("{name}.spl")
    val module = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    module

fn default_binding_provider(module: HirModule) -> MirHirModuleDeclarationsV1:
    # This intentionally has no final-stage seals and cannot be admitted by
    # mir_hir_module_declarations_valid_v1. The pure binder only needs symbols.
    MirHirModuleDeclarationsV1(name: module.name, path: module.path,
        final_repository_authority: "", final_archive_key: "", final_body_digest: "",
        symbols: module.symbols, functions: [], structs: [], classes: [], enums: [],
        bitfields: [], traits: [], impls: [], globals: [], needs_initialization: false,
        declaration_digest: "", stage: "binder-mechanics-only")

describe "complete foreign default lexical binding on actual HIR":
    it "allocates fresh symbols and retains the actual prior argument operand":
        val provider = default_binding_actual_module("provider")
        val consumer = default_binding_actual_module("consumer")
        val function: HirFunction = provider.functions.values()[0]
        val consumer_function: HirFunction = consumer.functions.values()[0]
        val original_counter = provider.symbols.next_symbol_id
        val consumer_counter = consumer.symbols.next_symbol_id
        var lowering = MirLowering.new(consumer.symbols)
        lowering.current_module_id = consumer.name
        var builder = lowering.builder
        builder.begin_function(consumer_function.symbol, consumer_function.name,
            MirSignature(params: [MirType.i64()], return_type: MirType.i64(), is_variadic: false), consumer_function.span)
        val supplied = builder.emit_const_int(6)
        lowering.builder = builder
        val frame = MirHirDefaultBindingFrameV1(provider: default_binding_provider(provider),
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        lowering.declaration_default_bind_operand_v1(function.params[0].symbol,
            mir_operand_copy(supplied), frame)
        val target_base = frame.lexical_ids[function.params[0].symbol.id]
        expect(target_base >= consumer_counter).to_equal(true)
        expect(lowering.lambda_binding_local(target_base).id).to_equal(supplied.id)
        match function.body.stmts[0].kind:
            case HirStmtKind.Let(_, _, expression):
                val remapped = lowering.remap_declaration_default_expr_v1(expression, frame)
                match expression.kind:
                    case HirExprKind.Lambda(params, _, _):
                        match remapped.kind:
                            case HirExprKind.Lambda(mapped_params, _, _):
                                expect(mapped_params[0].symbol.id != params[0].symbol.id).to_equal(true)
                                expect(lowering.symbols.symbols.has(mapped_params[0].symbol.id)).to_equal(true)
                            case _: panic("binder lost the actual lambda")
                    case _: panic("frontend did not produce a lambda")
            case _: panic("frontend did not produce the callback binding")
        expect(frame.failed).to_equal(false)
        expect(lowering.errors.len()).to_equal(0)
        expect(provider.symbols.next_symbol_id).to_equal(original_counter)

    it "rejects a binder without an actual provider declaration before emission":
        val provider = default_binding_actual_module("provider")
        val consumer = default_binding_actual_module("consumer")
        var lowering = MirLowering.new(consumer.symbols)
        val frame = MirHirDefaultBindingFrameV1(provider: default_binding_provider(provider),
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        val missing = SymbolId(id: provider.symbols.next_symbol_id)
        expect(provider.symbols.symbols.has(missing.id)).to_equal(false)
        val mapped = lowering.declaration_default_allocate_lexical_v1(missing, frame)
        expect(mapped.id).to_equal(-1)
        expect(frame.failed).to_equal(true)
        expect(lowering.errors.len()).to_equal(1)
        expect(frame.lexical_ids.len()).to_equal(0)

fn default_binding_actual_callable(function: HirFunction) -> MirHirFunctionDeclarationV1:
    var params: [MirHirParamDeclarationV1] = []
    for raw in function.params:
        val param: HirParam = raw
        expect(param.has_default).to_equal(false)
        params.push(MirHirParamDeclarationV1(symbol: param.symbol, name: param.name,
            type_: param.type_, has_default: false, default_artifact: nil,
            span: param.span, is_mutable: param.is_mutable))
    MirHirFunctionDeclarationV1(symbol: function.symbol, name: function.name,
        type_params: function.type_params, params: params, return_type: function.return_type,
        effects: function.effects, visibility: function.visibility, is_async: function.is_async,
        is_static: function.is_static, is_public: function.is_public, is_method: function.is_method,
        is_mutable: function.is_mutable, is_const: function.is_const, is_extern: function.is_extern,
        func_attr: function.func_attr, has_export_attr: function.has_export_attr,
        export_attr: function.export_attr, is_generic_template: function.is_generic_template,
        span: function.span)

describe "foreign callable records retain actual declaration ownership":
    it "uses the exact callable signature despite a nil-owner stale predeclaration":
        val actual = default_binding_actual_module("provider")
        val consumer = default_binding_actual_module("consumer")
        val function: HirFunction = actual.functions.values()[0]
        var provider = default_binding_provider(actual)
        val record = default_binding_actual_callable(function)
        provider.functions = [record]
        var declaration: HirSymbol = provider.symbols.symbols[function.symbol.id]
        declaration.defining_module = nil
        declaration.type_ = Some(HirType(kind: HirTypeKind.Unit, span: function.span))
        provider.symbols.symbols[function.symbol.id] = declaration
        expect(mir_hir_callable_record_binding_valid_v1(provider, record)).to_equal(true)
        var lowering = MirLowering.new(consumer.symbols)
        lowering.current_module_id = consumer.name
        val frame = MirHirDefaultBindingFrameV1(provider: provider,
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        val mapped = lowering.declaration_default_reference_v1(function.symbol, frame)
        expect(mapped.id >= 0).to_equal(true)
        expect(frame.failed).to_equal(false)
        val target: HirSymbol = lowering.symbols.symbols[mapped.id]
        match target.type_.unwrap().kind:
            case HirTypeKind.Function(params, result, effects):
                expect(params.len()).to_equal(1)
                expect(params[0].kind).to_equal(function.params[0].type_.kind)
                expect(result.kind).to_equal(function.return_type.kind)
                expect(effects.len()).to_equal(function.effects.len())
            case _: panic("binder published the stale predeclaration type")
        expect(provider.symbols.symbols[function.symbol.id].defining_module).to_equal(nil)
        expect(lowering.errors.len()).to_equal(0)

    it "rejects a record whose name does not identify its retained table row":
        val actual = default_binding_actual_module("provider")
        val consumer = default_binding_actual_module("consumer")
        val function: HirFunction = actual.functions.values()[0]
        var provider = default_binding_provider(actual)
        var record = default_binding_actual_callable(function)
        record.name = "different_callable"
        provider.functions = [record]
        expect(mir_hir_callable_record_binding_valid_v1(provider, record)).to_equal(false)
        var lowering = MirLowering.new(consumer.symbols)
        val frame = MirHirDefaultBindingFrameV1(provider: provider,
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        expect(lowering.declaration_default_reference_v1(function.symbol, frame).id).to_equal(-1)
        expect(frame.failed).to_equal(true)
        expect(frame.declaration_ids.len()).to_equal(0)

    it "rejects an unresolved nested signature through the actual type diagnostics":
        val actual = default_binding_actual_module("provider")
        val consumer = default_binding_actual_module("consumer")
        val function: HirFunction = actual.functions.values()[0]
        var provider = default_binding_provider(actual)
        var record = default_binding_actual_callable(function)
        record.return_type = HirType(kind: HirTypeKind.Tuple([
            function.return_type, HirType(kind: HirTypeKind.Infer(91, 0), span: function.span)
        ]), span: function.span)
        provider.functions = [record]
        var lowering = MirLowering.new(consumer.symbols)
        val frame = MirHirDefaultBindingFrameV1(provider: provider,
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        expect(lowering.declaration_default_reference_v1(function.symbol, frame).id).to_equal(-1)
        expect(frame.failed).to_equal(true)
        expect(lowering.errors.len() > 0).to_equal(true)
        expect(frame.declaration_ids.len()).to_equal(0)

    it "rejects a missing provider nominal inside a nested callable Throws effect":
        val actual = default_binding_actual_module("provider")
        val consumer = default_binding_actual_module("consumer")
        val function: HirFunction = actual.functions.values()[0]
        var provider = default_binding_provider(actual)
        var record = default_binding_actual_callable(function)
        val missing = HirType(kind: HirTypeKind.Named(SymbolId(id: actual.symbols.next_symbol_id), []), span: function.span)
        record.return_type = HirType(kind: HirTypeKind.Function([], function.return_type,
            [Effect(kind: EffectKind.Throws(missing), span: function.span)]), span: function.span)
        provider.functions = [record]
        var lowering = MirLowering.new(consumer.symbols)
        val frame = MirHirDefaultBindingFrameV1(provider: provider,
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        expect(lowering.declaration_default_reference_v1(function.symbol, frame).id).to_equal(-1)
        expect(frame.failed).to_equal(true)
        expect(lowering.errors.len() > 0).to_equal(true)
        expect(frame.declaration_ids.len()).to_equal(0)

    it "retains a real nominal Throws owner through a nested callable signature":
        val source = "class DefaultFailure:\n    code: i64\n\nfn evaluate(base: i64) -> i64:\n    base\n"
        val ast = parse_full_frontend(source, "effect_provider.spl", "effect_provider", Logger(level: 0))
        var frontend = HirLowering.with_filename("effect_provider.spl")
        val actual = frontend.lower_module(ast)
        expect(frontend.errors.len()).to_equal(0)
        val function: HirFunction = actual.functions.values()[0]
        val class_: HirClass = actual.classes.values()[0]
        var provider = default_binding_provider(actual)
        var record = default_binding_actual_callable(function)
        val thrown = HirType(kind: HirTypeKind.Named(class_.symbol, []), span: function.span)
        record.return_type = HirType(kind: HirTypeKind.Function([], function.return_type,
            [Effect(kind: EffectKind.Throws(thrown), span: function.span)]), span: function.span)
        provider.functions = [record]
        val consumer = default_binding_actual_module("consumer")
        var lowering = MirLowering.new(consumer.symbols)
        val frame = MirHirDefaultBindingFrameV1(provider: provider,
            links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        val mapped = lowering.declaration_default_reference_v1(function.symbol, frame)
        expect(mapped.id >= 0).to_equal(true)
        expect(frame.failed).to_equal(false)
        val target: HirSymbol = lowering.symbols.symbols[mapped.id]
        match target.type_.unwrap().kind:
            case HirTypeKind.Function(_, result, _):
                match result.kind:
                    case HirTypeKind.Function(_, _, effects):
                        expect(effects.len()).to_equal(1)
                        match effects[0].kind:
                            case EffectKind.Throws(type_):
                                match type_.kind:
                                    case HirTypeKind.Named(owner, _):
                                        val definition: HirSymbol = lowering.symbols.symbols[owner.id]
                                        expect(definition.name).to_equal("DefaultFailure")
                                        expect(definition.kind).to_equal(SymbolKind.Class)
                                    case _: panic("lost the real nominal Throws owner")
                            case _: panic("discarded the actual Throws effect")
                    case _: panic("lost the nested callable signature")
            case _: panic("lost the callable signature")
