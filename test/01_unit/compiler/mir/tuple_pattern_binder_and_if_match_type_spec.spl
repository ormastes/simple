# @req REQ-SSPEC-COMPILER
"""
# MIR typing: tuple-pattern variant binders, if-expression with match arm

Bugs: enum_payload_type_mismatch_tuple_pattern_binders_2026-10-24 (binders from
`case (Function(a, b, _), Function(c, d, _))` must carry the variant payload
types) and for_in_unresolved_if_match_route_type_2026-10-24 (`val r = if c:
match ..: Ok(v): v / Err(e): return .. else: call()` must type `r` from the
payload, not I64, so `for x in r.items` lowers).
"""

# @tag: unit, compiler, mir, match, types

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn mir_errors(src: text) -> [text]:
    val parsed = parse_full_frontend(src, "testdata/mir_typing.spl", "mir_typing", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/mir_typing.spl")
    val hir = hir_lowering.lower_module(parsed)
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    var out: [text] = []
    for err in lowering.errors:
        if not err.fatal:
            continue
        out = out.push(err.message)
    out

val TYPES: text = "enum Ty:\n    Function(params: [i64], ret: i64, n: i64)\n    Layer(a: i64, b: i64, c: i64)\n    Unit\n\n"

describe "tuple-pattern variant binders carry payload types":
    it "lowers a two-variant tuple pattern and uses the binders as typed values":
        val src = TYPES + "fn f(x: Ty, y: Ty) -> i64:\n    val r = match (x, y):\n        case (Ty.Function(a, b, _), Ty.Function(c, d, _)):\n            a.len() + b + c.len() + d\n        case _:\n            0\n    r\n"
        expect(mir_errors(src).join(" | ")).to_equal("")
    it "lowers the bare-variant spelling of the same tuple pattern":
        val src = TYPES + "fn f(x: Ty, y: Ty) -> i64:\n    val r = match (x, y):\n        case (Function(a, b, _), Function(c, d, _)):\n            a.len() + b + c.len() + d\n        case _:\n            0\n    r\n"
        expect(mir_errors(src).join(" | ")).to_equal("")
    it "lowers a mixed-variant tuple pattern":
        val src = TYPES + "fn f(x: Ty, y: Ty) -> i64:\n    val r = match (x, y):\n        case (Ty.Layer(a, b, _), Ty.Function(c, d, _)):\n            a + b + c.len() + d\n        case _:\n            0\n    r\n"
        expect(mir_errors(src).join(" | ")).to_equal("")

val ROUTE: text = "struct Route:\n    items: [i64]\n    n: i64\n\nenum RouteLoad:\n    Loaded(v: Route)\n    Failed(e: text)\n\nfn mk() -> Route:\n    Route(items: [1, 2], n: 2)\n\n"

describe "if-expression whose arm is a match with early-return Err":
    it "types the initializer so for-in over a field lowers":
        val src = ROUTE + "fn f(c: bool, r: RouteLoad) -> i64:\n    val route = if c:\n        match r:\n            case RouteLoad.Loaded(v): v\n            case RouteLoad.Failed(e): return 0\n    else:\n        mk()\n    var t = 0\n    for x in route.items:\n        t = t + x\n    t\n"
        expect(mir_errors(src).join(" | ")).to_equal("")
    it "types the initializer without early return":
        val src = ROUTE + "fn f(c: bool, r: RouteLoad) -> i64:\n    val route = if c:\n        match r:\n            case RouteLoad.Loaded(v): v\n            case RouteLoad.Failed(e): mk()\n    else:\n        mk()\n    var t = 0\n    for x in route.items:\n        t = t + x\n    t\n"
        expect(mir_errors(src).join(" | ")).to_equal("")
