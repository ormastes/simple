use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io_runtime.{env_get_opt, env_set}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_definitions.{HirBlock, HirEnum, HirExpr, HirExprKind, HirMatchArm, HirPattern, HirPatternKind, HirVariant, HirVariantKind}
use compiler.hir.hir_types.{HirSymbol, HirType, HirTypeKind, ScopeId, SymbolId, SymbolKind, SymbolTable}
use compiler.mir.mir_data.{MirSignature, MirType}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_lowering_types.{MirError}

# codex-system-test

fn collision_type(symbol_id: i64) -> HirType:
    HirType(kind: HirTypeKind.Named(SymbolId(id: symbol_id), []), span: Span.empty())

fn collision_body(value: i64) -> HirBlock:
    HirBlock(
        stmts: [],
        has: true,
        value: HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: false,
            type_: HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty()),
        span: Span.empty())

fn collision_enum(symbol_id: i64, runtime_name: text, variants: [text]) -> HirEnum:
    var rows: [HirVariant] = []
    var i = 0
    while i < variants.len():
        rows.push(HirVariant(
            symbol: SymbolId(id: symbol_id * 100 + i),
            name: variants[i],
            kind: HirVariantKind.Unit,
            has_discriminant: false,
            discriminant: HirExpr(kind: HirExprKind.NilLit, has_type_: false,
                type_: HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty()),
            span: Span.empty()))
        i = i + 1
    HirEnum(
        symbol: SymbolId(id: symbol_id),
        name: "Style",
        runtime_name: runtime_name,
        type_params: [],
        variants: rows,
        visibility: Visibility.Public,
        is_public: true,
        doc_comment: nil,
        span: Span.empty(),
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {})

fn collision_symbol(symbol_id: i64, owner_path: text) -> HirSymbol:
    HirSymbol(
        id: SymbolId(id: symbol_id),
        name: "Style",
        kind: SymbolKind.Enum,
        type_: nil,
        scope: ScopeId(id: 0),
        span: Span.empty(),
        visibility: Visibility.Public,
        is_public: true,
        is_mutable: false,
        defining_module: Some(owner_path))

fn collision_arm(owner_id: i64, variant: text, value: i64) -> HirMatchArm:
    val enum_type = collision_type(owner_id)
    val pattern = HirPattern(
        kind: HirPatternKind.Enum(enum_type, variant, nil),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Error, span: Span.empty()),
        span: Span.empty())
    HirMatchArm(
        pattern: pattern,
        has_guard: false,
        guard: HirExpr(kind: HirExprKind.UnitLit, has_type_: false,
            type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()), span: Span.empty()),
        body: collision_body(value),
        span: Span.empty())

fn fatal_messages(errors: [MirError]) -> [text]:
    var out: [text] = []
    for error in errors:
        if error.fatal:
            out.push(error.message)
    out

# Exercise lower_enum_match, including the critical-profile gate and its real
# enum registrations. This deliberately does not call build_match_coverage:
# the defect is the owner key selected while MIR assembles that record.
fn lower_collision_match(
    matched_owner_id: i64,
    omitted_variant: text,
    a_then_b: bool,
) -> [MirError]:
    val symbols = SymbolTable.new()
    symbols.register_preserved_symbol(collision_symbol(801, "src/a.spl"))
    symbols.register_preserved_symbol(collision_symbol(802, "src/b.spl"))
    var lowering = MirLowering.new(symbols)
    val style_a = collision_enum(801, "a.Style", ["Bold", "Italic", "Underline"])
    val style_b = collision_enum(802, "b.Style", ["Plain", "Reverse"])
    if a_then_b:
        lowering.register_enum_variants(style_a)
        lowering.register_enum_runtime_id(style_a)
        lowering.register_enum_variants(style_b)
        lowering.register_enum_runtime_id(style_b)
    else:
        lowering.register_enum_variants(style_b)
        lowering.register_enum_runtime_id(style_b)
        lowering.register_enum_variants(style_a)
        lowering.register_enum_runtime_id(style_a)

    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 890), "qualified_style_match_probe",
        MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), Span.empty())
    lowering.builder = builder

    val owner = if matched_owner_id == 801: style_a else: style_b
    var arms: [HirMatchArm] = []
    for variant in owner.variants:
        if variant.name != omitted_variant:
            arms.push(collision_arm(matched_owner_id, variant.name, 1))
    val scrutinee = HirExpr(
        kind: HirExprKind.IntLit(0, nil),
        has_type_: true,
        type_: collision_type(matched_owner_id),
        span: Span.empty())

    val previous_profile = env_get_opt("SIMPLE_SAFETY_PROFILE")
    env_set("SIMPLE_SAFETY_PROFILE", "critical")
    val _result = lowering.lower_enum_match(scrutinee, arms, nil)
    if previous_profile != nil:
        env_set("SIMPLE_SAFETY_PROFILE", previous_profile ?? "")
    else:
        env_set("SIMPLE_SAFETY_PROFILE", "")
    lowering.errors

describe "critical MIR coverage keeps same-named enum owners separate":
    it "accepts each complete qualified match in both registration orders":
        step("Lower complete qualified matches after both enum registration orders")
        for a_then_b in [true, false]:
            val a_errors = fatal_messages(lower_collision_match(801, "", a_then_b))
            expect(a_errors.len()).to_equal(0)
            val b_errors = fatal_messages(lower_collision_match(802, "", a_then_b))
            expect(b_errors.len()).to_equal(0)

    it "reports only the omitted variant from the selected owner":
        step("Lower incomplete qualified matches and inspect the owner-specific missing variant")
        for a_then_b in [true, false]:
            val a_errors = fatal_messages(lower_collision_match(801, "Italic", a_then_b))
            expect(a_errors.len()).to_equal(1)
            expect(a_errors[0]).to_contain("critical-profile match coverage")
            expect(a_errors[0]).to_contain("Italic")
            expect(a_errors[0].contains("Plain")).to_equal(false)
            expect(a_errors[0].contains("Reverse")).to_equal(false)

            val b_errors = fatal_messages(lower_collision_match(802, "Reverse", a_then_b))
            expect(b_errors.len()).to_equal(1)
            expect(b_errors[0]).to_contain("critical-profile match coverage")
            expect(b_errors[0]).to_contain("Reverse")
            expect(b_errors[0].contains("Bold")).to_equal(false)
            expect(b_errors[0].contains("Italic")).to_equal(false)
            expect(b_errors[0].contains("Underline")).to_equal(false)
