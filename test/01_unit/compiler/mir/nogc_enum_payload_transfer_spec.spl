"""AC-OWN-03: actual runtime enum construction receives an owning operand.

The oracle inspects emitted calls, including per-slot multi-payload stores.
This does not qualify runtime destruction or reference counting.
"""
use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn enum_transfer_counts(field_type: text, multi: bool) -> [i64]:
    val declaration = if multi: "Pair({field_type}, i64)" else: "One({field_type})"
    val constructor = if multi: "Packet.Pair(value, 7)" else: "Packet.One(value)"
    val source = "enum Packet:\n    {declaration}\n\nfn pack(value: {field_type}) -> Packet:\n    {constructor}\n"
    var parsed = parse_full_frontend(source, "enum_transfer.spl", "enum_transfer.spl", Logger(level: 0))
    parsed.nogc_strict = true
    var hl = HirLowering.with_filename("enum_transfer.spl")
    val hir = hl.lower_module(parsed)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var new_moves = 0
    var new_copies = 0
    var slot_moves = 0
    var slot_copies = 0
    for function in mir.functions.values():
        if function.name != "pack" and not function.name.ends_with(".pack"): continue
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, arguments):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                if name == "rt_enum_new" or name == "rt_tuple_set":
                                    expect(arguments.len()).to_equal(3)
                                    match arguments[2].kind:
                                        case MirOperandKind.Move(_):
                                            if name == "rt_enum_new": new_moves = new_moves + 1
                                            else: slot_moves = slot_moves + 1
                                        case MirOperandKind.Copy(_):
                                            if name == "rt_enum_new": new_copies = new_copies + 1
                                            else: slot_copies = slot_copies + 1
                                        case _: expect(false).to_equal(true)
                            case _: ()
                    case _: ()
    expect(lowering.errors.len()).to_equal(0)
    [new_moves, new_copies, slot_moves, slot_copies]

describe "AC-OWN-03 enum payload transfer":
    it "moves a unique single payload into its enum":
        val counts = enum_transfer_counts("&i64", false)
        expect(counts).to_equal([1, 0, 0, 0])

    it "copies a shared single payload handle":
        val counts = enum_transfer_counts("*i64", false)
        expect(counts).to_equal([0, 1, 0, 0])

    it "moves an owning tuple slot and its newly allocated payload container once":
        val counts = enum_transfer_counts("&i64", true)
        expect(counts).to_equal([1, 0, 1, 1])
