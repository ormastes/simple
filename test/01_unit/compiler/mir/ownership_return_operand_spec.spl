use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId}
use compiler.mir.mir_types.{LocalId}
use compiler.mir.mir_data.{MirOperand, MirOperandKind}
use compiler.mir.mir_lowering_stmts.{mir_ownership_return_operand}

fn return_operand_moves(operand: MirOperand) -> bool:
    match operand.kind:
        case MirOperandKind.Move(local):
            expect(local.id).to_equal(71)
            true
        case MirOperandKind.Copy(local):
            expect(local.id).to_equal(71)
            false
        case _:
            assert(false, "return operand unexpectedly became a constant")
            false

describe "Ownership return operands":
    it "moves explicit and nested owners while retaining source identity":
        val span = Span.empty()
        val scalar = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val unique = HirType(kind: HirTypeKind.Unique(scalar), span: span)
        val nested = HirType(kind: HirTypeKind.Tuple([scalar, unique]), span: span)
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), unique, false, false))).to_equal(true)
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), nested, false, false))).to_equal(true)

    it "uses the active strict contract for bare named owners":
        val named = HirType(kind: HirTypeKind.Named(SymbolId(id: 19), []), span: Span.empty())
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), named, true, false))).to_equal(true)
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), named, false, false))).to_equal(false)

    it "preserves short borrow provenance for escape validation":
        val named = HirType(kind: HirTypeKind.Named(SymbolId(id: 19), []), span: Span.empty())
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), named, true, true))).to_equal(false)

    it "copies scalar and shared handles without consuming their pointees":
        val scalar = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        val unique = HirType(kind: HirTypeKind.Unique(scalar), span: Span.empty())
        val shared = HirType(kind: HirTypeKind.Shared(unique), span: Span.empty())
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), scalar, true, false))).to_equal(false)
        expect(return_operand_moves(mir_ownership_return_operand(
            LocalId(id: 71), shared, true, false))).to_equal(false)
