use std.spec
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
# `lower_module` is a `me` method defined in _Items/module_lowering.spl and
# re-exported via hir_lowering.items; types.spl alone does not bring it in scope.
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
# `MirLowering` is NOT re-exported from `compiler.mir` / `compiler.mir.mir`
# (see 50.mir/__init__.spl): import it from its own module.
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/mir/fn_typed_parameter_indirect_call_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/fn_typed_parameter_indirect_call_spec.md
# doc-path: doc/03_plan/sys_test/fn_typed_parameter_indirect_call_spec.md
# doc-path: doc/04_architecture/fn_typed_parameter_indirect_call_spec.md
# doc-path: doc/05_design/fn_typed_parameter_indirect_call_spec_oracles.md
# @manual: primary


# Bug stage1_lexer_hir_fatals_eprint_and_generic_len_helper_2026-08-22 (fn-param
# call half): `fn apply(f: fn(i64) -> i64, x: i64) -> i64: f(x)` lowered `f(x)`
# as a DIRECT symbol call to the parameter's NAME, so the native link died with
# `undefined symbol: f`. Three defects stacked behind it, each pinned here:
#   1. MIR call lowering demoted to an indirect call only when the callee was
#      in `local_map`, but params/locals are bound via `bind_local` into
#      `local_symbol_ids` (`find_local`), so a fn-typed PARAM stayed direct.
#   2. The indirect-call closure/raw diamond merged its result by writing one
#      temp from both arms -- a multi-def SSA local no transform repaired for
#      a value-returning function (llc: multiple definition of local value).
#   3. The LLVM emitter rendered a `Const(Str(name), FuncPtr)` INSTRUCTION as
#      a string literal, so `Op(f: double)` stored the address of "double\0"
#      and the later indirect call jumped into .rodata (SIGSEGV).

fn lower_source(src: text) -> MirModule:
    val ast = parse_full_frontend(src, "fn_param.spl", "fn_param.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("fn_param.spl")
    val hir = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.lower_module(hir)

fn find_function(mir: MirModule, name: text) -> MirFunction?:
    for function in mir.functions.values():
        if function.name == name:
            return Some(function)
    nil

fn count_indirect_calls(function: MirFunction) -> i64:
    var n = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.CallIndirect(_, _, _, _):
                    n = n + 1
                case _:
                    pass
    n

fn has_direct_call_named(function: MirFunction, callee: text) -> bool:
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, operand, _):
                    match operand.kind:
                        case MirOperandKind.Const(MirConstValue.Str(name), _):
                            if name == callee:
                                return true
                        case _:
                            pass
                case _:
                    pass
    false

# Count how many blocks write a given local via Copy -- the multi-def shape
# (defect 2) is the same dest copied in two different blocks.
fn max_copy_dest_block_count(function: MirFunction) -> i64:
    var dest_ids: [i64] = []
    var dest_blocks: [i64] = []
    var bi = 0
    for block in function.blocks:
        var seen_in_block: [i64] = []
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Copy(dest, _):
                    val id = dest.id
                    if not seen_in_block.contains(id):
                        seen_in_block = seen_in_block.push(id)
                        var found = false
                        var i = 0
                        while i < dest_ids.len():
                            if dest_ids[i] == id:
                                dest_blocks[i] = dest_blocks[i] + 1
                                found = true
                            i = i + 1
                        if not found:
                            dest_ids = dest_ids.push(id)
                            dest_blocks = dest_blocks.push(1)
                case _:
                    pass
        bi = bi + 1
    var worst = 0
    for c in dest_blocks:
        if c > worst:
            worst = c
    worst

val apply_source = "fn apply(f: fn(i64) -> i64, x: i64) -> i64:\n    f(x)\n\nfn double(v: i64) -> i64:\n    v * 2\n\nfn main():\n    print(apply(double, 21))\n"

describe "fn-typed parameter call MIR lowering", tag: ["only-compiled"]:
    it "calls a fn-typed parameter indirectly, never as a direct symbol call to its name":
        step("Verify: calls a fn-typed parameter indirectly, never as a direct symbol call to its name")
        # @req: REQ-SSPEC-LOCAL-001
        val mir = lower_source(apply_source)
        val apply_fn = find_function(mir, "apply")
        assert_true(apply_fn.?)
        val f = apply_fn.unwrap()
        expect_not(has_direct_call_named(f, "f"))
        # closure arm + raw-fn arm of the existing indirect-call diamond
        expect(count_indirect_calls(f)).to_equal(2)

    it "merges the indirect-call result through one slot, not a multi-def temp":
        step("Verify: merges the indirect-call result through one slot, not a multi-def temp")
        # @req: REQ-SSPEC-LOCAL-001
        val mir = lower_source(apply_source)
        val f = find_function(mir, "apply").unwrap()
        assert_true(max_copy_dest_block_count(f) <= 1)
        var saw_alloc = false
        var saw_load = false
        var stores = 0
        for block in f.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Alloc(_, _):
                        saw_alloc = true
                    case MirInstKind.Store(_, _):
                        stores = stores + 1
                    case MirInstKind.Load(_, _):
                        saw_load = true
                    case _:
                        pass
        assert_true(saw_alloc)
        expect(stores).to_equal(2)
        assert_true(saw_load)

    it "passes a named function as the argument, keeping the outer call direct":
        step("Verify: passes a named function as the argument, keeping the outer call direct")
        # @req: REQ-SSPEC-LOCAL-001
        val mir = lower_source(apply_source)
        val main_fn = find_function(mir, "main").unwrap()
        assert_true(has_direct_call_named(main_fn, "apply"))
        expect(count_indirect_calls(main_fn)).to_equal(0)

    # Neighbour: a fn-typed LOCAL bound from a named function is the same
    # defect class (bound through bind_local, not local_map).
    it "calls a fn-typed local holding a named function indirectly":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: calls a fn-typed local holding a named function indirectly")
        val source = "fn double(v: i64) -> i64:\n    v * 2\n\nfn run() -> i64:\n    val g: fn(i64) -> i64 = double\n    g(4)\n"
        val mir = lower_source(source)
        val run_fn = find_function(mir, "run").unwrap()
        expect_not(has_direct_call_named(run_fn, "g"))
        expect(count_indirect_calls(run_fn)).to_equal(2)

    # Over-demotion guard: an ordinary call to a top-level function whose name
    # is NOT a local stays direct.
    it "keeps an ordinary top-level function call direct":
        step("Verify: keeps an ordinary top-level function call direct")
        # @req: REQ-SSPEC-LOCAL-001
        val mir = lower_source(apply_source)
        val main_fn = find_function(mir, "main").unwrap()
        assert_true(has_direct_call_named(main_fn, "apply"))

    # A val-bound lambda keeps its existing beta-reduction path (it is also
    # reachable through find_local now, but must not be demoted).
    it "still inlines a val-bound lambda call instead of demoting it":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: still inlines a val-bound lambda call instead of demoting it")
        val source = "fn run() -> i64:\n    val inc = \\v: v + 1\n    inc(4)\n"
        val mir = lower_source(source)
        val run_fn = find_function(mir, "run").unwrap()
        expect_not(has_direct_call_named(run_fn, "inc"))
        expect(count_indirect_calls(run_fn)).to_equal(0)

describe "fn reference constant LLVM emission", tag: ["only-compiled"]:
    it "emits a struct-literal fn field as a function reference, not a string literal":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: emits a struct-literal fn field as a function reference, not a string literal")
        val source = "struct Op:\n    f: fn(i64) -> i64\n\nfn double(v: i64) -> i64:\n    v * 2\n\nfn run() -> i64:\n    val op = Op(f: double)\n    (op.f)(4)\n"
        val mir = lower_source(source)
        val llvm = MirToLlvm.create("test.fn_param.struct_field", CodegenTarget.X86_64, nil).translate_module(mir)
        assert_true(llvm.contains("ptr @double"))
        expect_not(llvm.contains("c\"double\\00\""))

    it "emits the indirect-call diamond as SSA-valid IR with a single merge load":
        step("Verify: emits the indirect-call diamond as SSA-valid IR with a single merge load")
        # @req: REQ-SSPEC-LOCAL-001
        val mir = lower_source(apply_source)
        val llvm = MirToLlvm.create("test.fn_param.apply", CodegenTarget.X86_64, nil).translate_module(mir)
        assert_true(llvm.contains("call i64 @rt_closure_func_ptr"))
        # the two arms store into one alloca slot and the join loads it
        assert_true(llvm.contains("store i64"))
        assert_true(llvm.contains("= load i64, ptr"))
        expect_not(llvm.contains("undefined symbol"))
