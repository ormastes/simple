"""
Purpose: Pin that a bare, unimported call to an interpreter-only builtin
(`env_get`, admitted by HIR's `is_interp_builtin_fn` unresolved-name fallback)
is rejected at MIR lowering with a call-site diagnostic, instead of lowering to
a `MirCallOrigin.Unknown` callee that aborts the native backend with SIGABRT
("MIR call target lacks proven source/runtime/foreign origin: callee=env_get",
Phase 3 codegen of compiler.driver.driver_pipeline_lowering, run 21).
Audience: compiler engineers maintaining HIR builtin fallback and MIR callable authority.
"""

use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn lower_function(src: text, target_name: text) -> text:
    val filename = "interp_builtin_origin_" + target_name + ".spl"
    val module = parse_full_frontend(src, filename, filename, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(filename)
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var result = ""
    for error in hir_lowering.errors:
        result = result + "HIR_ERROR:" + error.message + "\n"
    for error in mir_lowering.errors:
        result = result + "MIR_ERROR:" + error.message + "\n"
    for function in mir.functions.values():
        if function.name == target_name or function.name.ends_with("." + target_name):
            result = result + serialize_mir_function(function)
    result

val BARE_ENV_GET_SRC = """
fn read_home() -> text:
    env_get("HOME") ?? ""
"""

val DEFINED_ENV_GET_SRC = """
fn env_get(key: text) -> text:
    key

fn read_home() -> text:
    env_get("HOME")
"""

describe "interpreter-only builtin called without an import":
    it "is a MIR lowering error naming the builtin, not an Unknown-origin call":
        val mir = lower_function(BARE_ENV_GET_SRC, "read_home")
        expect(mir).to_contain("MIR_ERROR:interpreter-only builtin `env_get`")
        expect(mir.contains("\"call_origin\":\"unknown\"")).to_be(false)

    it "keeps a module-defined env_get a proven Source call":
        val mir = lower_function(DEFINED_ENV_GET_SRC, "read_home")
        expect(mir.contains("MIR_ERROR:")).to_be(false)
        expect(mir.contains("HIR_ERROR:")).to_be(false)
        expect(mir).to_contain("\"call_origin\":\"source\"")
        expect(mir.contains("\"call_origin\":\"unknown\"")).to_be(false)
