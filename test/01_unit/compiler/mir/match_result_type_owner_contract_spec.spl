# codex-system-test
# Regression for Stage-2 native HirType? corruption observed in the positional
# Stage-3 admission fixture on 2026-09-04.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read}

fn occurrences(source: text, needle: text) -> i64:
    if needle == "": return 0
    var count = 0
    var rest = source
    while rest.contains(needle):
        val at = rest.index_of(needle)
        count = count + 1
        rest = rest.substring(at + needle.len())
    count

describe "MIR match result type owner contract":
    it "keeps optional HirType extraction inside each lowering owner":
        step("Read match and if lowering sources")
        val switches = file_read(
            "src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")
        val statements = file_read(
            "src/compiler/50.mir/mir_lowering_stmts.spl")

        step("Reject the aggregate-crossing helper")
        expect(switches.contains("me match_result_mir_type(")).to_be(false)
        expect(switches.contains("self.match_result_mir_type(")).to_be(false)
        expect(statements.contains("self.match_result_mir_type(")).to_be(false)

        step("Require all five owners to extract and lower in place")
        val inline_marker = "if val expected_found = expected_type:"
        expect(occurrences(switches, inline_marker)).to_equal(3)
        expect(occurrences(statements, inline_marker)).to_equal(2)
