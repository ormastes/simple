# @cover src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl
# Pattern-truth lane (user decision 2026-07-29: "fix silent pattern acceptance").
#
# A `case` arm naming a variant the scrutinee's enum does not declare was
# previously accepted silently: the resolver borrowed a same-named variant's
# discriminant from an UNRELATED enum, producing a permanently-dead arm that
# fell through to `case _` — the exact mechanism behind three structurally
# dead compiler passes (SafetyChecker's Val/Var/AssignOp being the worst; see
# doc/08_tracking/bug/option_pattern_accepted_on_non_option_scrutinee_2026-07-27.md).
# Now: known enum + unknown variant = loud MIR lowering error listing the
# enum's real variants; bare unknown variants with no owning enum are loud too.
#
# HARNESS NOTE (discriminated 2026-07-29 via three probes): the
# parse→HIR→MIR pipeline is inlined in each `it` block ON PURPOSE. Running
# the IDENTICAL code inside a module-level helper fn loses the recorded
# errors — `lowering.errors` reads back EMPTY from the helper while the
# inline form returns 1 error for the same fixture (interpreter
# struct-mutation-visibility family; same family as the SafetyChecker
# struct-self bug). Do not "clean this up" into a shared helper.
#
# CompileOptions note: `CompileOptions.default()` cannot resolve on
# erased-receiver paths (Task #145 note at driver_core_types.spl:150) — use
# the free function driver_core_compile_options_default().

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn any_contains(messages: [text], needle: text) -> bool:
    for m in messages:
        if m.contains(needle):
            return true
    false

describe "enum match: unknown variant on a known scrutinee enum":
    it "fires a diagnostic naming the bad variant and the enum's real variants":
        val src = "enum Color:\n" +
            "    Red\n" +
            "    Green\n" +
            "    Blue\n" +
            "\n" +
            "fn describe(c: Color) -> text:\n" +
            "    match c:\n" +
            "        case Color.Red: \"red\"\n" +
            "        case Color.Bloo: \"blue-typo\"\n" +
            "        case _: \"other\"\n"
        val parsed = parse_full_frontend(src, "testdata/fixture_bad_variant.spl", "fixture_bad_variant", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/fixture_bad_variant.spl")
        val hir = hir_lowering.lower_module(parsed)
        val target_context = driver_mir_target_context(driver_core_compile_options_default())
        var lowering = MirLowering.new_for_target(hir.symbols, target_context)
        val _mir = lowering.lower_module(hir)
        var messages: [text] = []
        for e in lowering.errors:
            messages = messages.push(e.message)
        expect(any_contains(messages, "no variant 'Bloo'")).to_equal(true)
        expect(any_contains(messages, "Red")).to_equal(true)
        expect(any_contains(messages, "Green")).to_equal(true)
        expect(any_contains(messages, "Blue")).to_equal(true)

    it "is silent when every arm names a real variant of the scrutinee's enum":
        val src = "enum Color:\n" +
            "    Red\n" +
            "    Green\n" +
            "    Blue\n" +
            "\n" +
            "fn describe(c: Color) -> text:\n" +
            "    match c:\n" +
            "        case Color.Red: \"red\"\n" +
            "        case Color.Green: \"green\"\n" +
            "        case Color.Blue: \"blue\"\n"
        val parsed = parse_full_frontend(src, "testdata/fixture_good_variant.spl", "fixture_good_variant", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/fixture_good_variant.spl")
        val hir = hir_lowering.lower_module(parsed)
        val target_context = driver_mir_target_context(driver_core_compile_options_default())
        var lowering = MirLowering.new_for_target(hir.symbols, target_context)
        val _mir = lowering.lower_module(hir)
        var messages: [text] = []
        for e in lowering.errors:
            messages = messages.push(e.message)
        expect(any_contains(messages, "has no variant")).to_equal(false)

    it "is silent when the scrutinee's type is not a known enum (Option builtin, not module enum)":
        # Reproduces the shape from the filed bug: a bare i64 matched with
        # Option's Some/None. This never resolves the scrutinee to a module
        # enum via `enum_variant_index`, so the new known-enum check must not
        # fire here (that defect stays filed separately -- see the doc header
        # above).
        val src = "fn describe(n: i64) -> text:\n" +
            "    match n:\n" +
            "        case Some(i): \"some\"\n" +
            "        case None: \"none\"\n" +
            "        case _: \"other\"\n"
        val parsed = parse_full_frontend(src, "testdata/fixture_unknown_scrutinee.spl", "fixture_unknown_scrutinee", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/fixture_unknown_scrutinee.spl")
        val hir = hir_lowering.lower_module(parsed)
        val target_context = driver_mir_target_context(driver_core_compile_options_default())
        var lowering = MirLowering.new_for_target(hir.symbols, target_context)
        val _mir = lowering.lower_module(hir)
        var messages: [text] = []
        for e in lowering.errors:
            messages = messages.push(e.message)
        expect(any_contains(messages, "has no variant")).to_equal(false)
