extern fn rt_file_read_text(path: text) -> text

describe "declared bytes receiver ownership":
    it "records every parameter type and prefers the bound local declaration":
        val functions = rt_file_read_text("src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""
        val calls = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl") ?? ""

        val parameter_binding = functions.split("self.bind_local(param_symbol_id, local)")[1].split("# Bug (native_me_receiver_no_mutate):")[0]
        expect(parameter_binding.index_of("self.remember_local_hir_type(local.id, param.type_)"))
            .to_be_less_than(parameter_binding.index_of("match param.type_.kind:"))
        val receiver_lookup = calls.split("me receiver_declared_type(receiver: HirExpr) -> HirType?:")[1]
        val var_lookup = receiver_lookup.split("case Var(rsym):")[1].split("case NamedVar(rsym, _):")[0]
        val named_var_lookup = receiver_lookup.split("case NamedVar(rsym, _):")[1].split("case _:")[0]
        expect(var_lookup.index_of("self.find_local_hir_type(rlocal.id)"))
            .to_be_less_than(var_lookup.index_of("self.symbols.get_symbol_raw(rsym.id)"))
        expect(named_var_lookup.index_of("self.find_local_hir_type(rlocal.id)"))
            .to_be_less_than(named_var_lookup.index_of("self.symbols.get_symbol_raw(rsym.id)"))

    it "uses one lowered MIR receiver when no declaration is available":
        val calls = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        val fixture = rt_file_read_text("test/fixtures/compiler/text_bytes_owner_collision.spl") ?? ""
        val bytes_gate = calls.split("if method == \"bytes\" and args.len() == 0:")[1].split("# Bug #138:")[0]

        expect(bytes_gate).to_contain("var bytes_receiver_has_declaration = false")
        expect(bytes_gate).to_contain("bytes_receiver_has_declaration = true")
        expect(bytes_gate).to_contain("if not bytes_receiver_has_declaration:")
        expect(bytes_gate).to_contain("prelowered_method_receiver = self.lower_expr(receiver)")
        expect(bytes_gate).to_contain("bytes_receiver_is_text = self.local_is_str(prelowered_method_receiver)")
        expect(bytes_gate).to_contain("MirConstValue.Str(\"rt_string_bytes\")")
        expect(fixture).to_contain("(left + right).bytes().len()")
        expect(fixture).to_contain("make_text().bytes().len()")
        expect(fixture).to_contain("fn user_bytes(value: UserType) -> i64:")
        expect(fixture).to_contain("fn pointer_bytes(value: PointerSize) -> i64:")
        expect(fixture).to_contain("fn array_len(value: [i64]) -> i64:")
