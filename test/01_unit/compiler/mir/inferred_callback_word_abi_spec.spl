# Actual frontend/HIR/MIR boundaries; native qualification is separate.
use std.spec.*
use std.env.variables.{env_set}
use std.io_runtime.{env_get_nullable}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_lowering.{MirLowering}

fn callback_hir(source: text, name: text) -> HirFunction:
    val ast = parse_full_frontend(source, "callback.spl", "callback", Logger(level: 0))
    var frontend = HirLowering.with_filename("callback.spl")
    val hir = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    for function in hir.functions.values():
        if function.name == name: return function
    panic("missing callback function {name}")

fn callback_mir_errors(source: text, runtime_bundle: text = "core-c-bootstrap") -> text:
    val ast = parse_full_frontend(source, "callback.spl", "callback", Logger(level: 0))
    var frontend = HirLowering.with_filename("callback.spl")
    val hir = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val previous_bundle = env_get_nullable("SIMPLE_NATIVE_RUNTIME_BUNDLE") ?? ""
    env_set("SIMPLE_NATIVE_RUNTIME_BUNDLE", runtime_bundle)
    lowering.lower_module(hir)
    env_set("SIMPLE_NATIVE_RUNTIME_BUNDLE", previous_bundle)
    var errors = ""
    for error in lowering.errors:
        errors = errors + error.message + "\n"
    errors

describe "inferred callback callable authority":
    it "retains a dynamic tail with its proven single argument callable shape":
        val function = callback_hir("fn invoke(callback, value):\n    callback(value)\n", "invoke")
        expect(function.return_type.kind).to_equal(HirTypeKind.Any)
        expect(function.body.has).to_equal(true)
        match function.params[0].type_.kind:
            case HirTypeKind.Function(params, result, _):
                expect(params.len()).to_equal(1)
                expect(params[0].kind).to_equal(HirTypeKind.Any)
                expect(result.kind).to_equal(HirTypeKind.Any)
            case _: panic("callback lost its proven callable shape")
        expect(function.params[1].type_.kind).to_equal(HirTypeKind.Any)

    it "retains explicit Unit rather than promoting the callback tail":
        val function = callback_hir("fn invoke(callback, value) -> ():\n    callback(value)\n", "invoke")
        expect(function.return_type.kind).to_equal(HirTypeKind.Unit)
        expect(function.body.has).to_equal(false)

    it "keeps a non-tail call and subsequent side effect in statement order":
        val function = callback_hir("fn invoke(callback, value):\n    callback(value)\n    print(\"after\")\n", "invoke")
        expect(function.return_type.kind).to_equal(HirTypeKind.Unit)
        expect(function.body.has).to_equal(false)
        expect(function.body.stmts.len()).to_equal(2)

    it "keeps declared typed callee return authority":
        val function = callback_hir("fn invoke(callback: fn(f64) -> f64, value: f64) -> f64:\n    callback(value)\n", "invoke")
        expect(function.return_type.kind).to_equal(HirTypeKind.Float(64))

    it "adapts integer and float named and materialized function values":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn integer(value: i64) -> i64:\n    value\nfn floating(value: f64) -> f64:\n    value\nfn main():\n    val local: fn(f64) -> f64 = floating\n    print(invoke(integer, 5))\n    print(invoke(floating, 2.5))\n    print(invoke(local, 2.5))\n"
        expect(callback_mir_errors(source)).to_equal("")

    it "rejects a typed callback with incompatible arity":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn pair(left: i64, right: i64) -> i64:\n    left\nfn main():\n    print(invoke(pair, 5))\n"
        expect(callback_mir_errors(source)).to_contain("dynamic callback arity differs")

    it "rejects an unknown Any callable before tagged indirect emission":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn relay(unknown: Any, value: Any) -> Any:\n    invoke(unknown, value)\n"
        expect(callback_mir_errors(source)).to_contain("dynamic callback requires a callable with proven arity")

    it "retains the default parameter route instead of publishing mismatched slots":
        val function = callback_hir("fn invoke(callback, value = 5):\n    callback(value)\n", "invoke")
        expect(function.return_type.kind).to_equal(HirTypeKind.Unit)
        expect(function.params[1].type_.kind).to_equal(HirTypeKind.Int(64, true))

    it "rejects an effectful raw extern callback rather than erasing its protocol":
        val source = "extern fn raw(value: i64) -> i64\nfn invoke(callback, value):\n    callback(value)\nfn main():\n    print(invoke(raw, 5))\n"
        expect(callback_mir_errors(source)).to_contain("dynamic callback effect protocol has no admitted adapter")

    it "rejects a lambda call body without a proven effect adapter":
        val source = "extern fn raw(value: i64) -> i64\nfn invoke(callback, value):\n    callback(value)\nfn main():\n    print(invoke(\\value: raw(value), 5))\n"
        expect(callback_mir_errors(source)).to_contain("dynamic callback lambda body has no admitted scalar effect adapter")

    it "adapts a known scalar call inside a contextual lambda":
        val source = "fn integer(value: i64) -> i64:\n    value\nfn invoke(callback, value):\n    callback(value)\nfn main():\n    print(invoke(\\value: integer(value), 5))\n"
        expect(callback_mir_errors(source)).to_equal("")

    it "rejects an Any callee with no proven callable signature":
        val source = "fn illegal(callable: Any, value: Any) -> Any:\n    callable(value)\n"
        expect(callback_mir_errors(source)).to_contain("dynamic callable requires proven arity before indirect emission")

    it "rejects a Float32 capture without a proven environment decoder":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn main():\n    val shift: f32 = 0.5\n    print(invoke(\\value: shift, 2.5))\n"
        expect(callback_mir_errors(source)).to_contain("unable to materialize admitted dynamic callback adapter")

    it "rejects a UInt64 typed callback without a proven unsigned adapter":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn unsigned(value: u64) -> i64:\n    5\nfn main():\n    print(invoke(unsigned, 5))\n"
        expect(callback_mir_errors(source)).to_contain("dynamic callback parameter type has no admitted tagged scalar adapter")

    it "rejects a raw UInt64 capture without an unsigned environment contract":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn main():\n    val captured: u64 = 5\n    print(invoke(\\value: captured, 5))\n"
        expect(callback_mir_errors(source)).to_contain("unable to materialize admitted dynamic callback adapter")

    it "rejects an unqualified pure runtime owner for contextual adapters":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn main():\n    print(invoke(\\value: value, 5))\n"
        expect(callback_mir_errors(source, "pure-core")).to_contain("tagged callback adapter requires the admitted core-c-bootstrap runtime owner")

    it "lowers tagged addition using the actual binary expression span":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn main():\n    print(invoke(\\value: value + 3, 5))\n"
        expect(callback_mir_errors(source)).to_equal("")

    it "visits concretely typed interpolation expressions in contextual lambdas":
        val source = "fn invoke(callback, value):\n    callback(value)\nfn main():\n    print(invoke(\\value: \"n={value}\", 5))\n"
        expect(callback_mir_errors(source)).to_equal("")
