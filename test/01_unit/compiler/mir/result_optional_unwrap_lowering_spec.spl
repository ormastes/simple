"""Actual MIR APIs for Result payloads that retain an Optional carrier."""
# @req REQ-ENUM-RESULT-OPTIONAL
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolKind, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_graph.{MirFunction}
use compiler.mir.mir_types.{MirType, MirSignature, MirConstValue}
use compiler.mir.mir_instruction_support.{MirOperandKind, MirBinOp, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLoweringExpr.method_calls_literals.*

struct ResultOptionalProbe:
    function: MirFunction
    diagnostics: [text]
    fatal: bool
    output_type: MirType?
    payload_type: HirType?
    optional: bool
    tagged: bool
    output_local: i64

fn result_optional_integer_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())

fn result_optional_payload(inner: HirType) -> HirType:
    HirType(kind: HirTypeKind.Optional(inner), span: Span.empty())

fn result_optional_probe(payload: HirType, unwrap_err: bool, fallback: HirExpr?,
        symbols: SymbolTable) -> ResultOptionalProbe:
    var lowering = MirLowering.new(symbols)
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 71), "result_optional_probe",
        MirSignature(params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
    val prelowered = builder.emit_const_int(71)
    lowering.builder = builder
    val text_type = HirType(kind: HirTypeKind.Str, span: Span.empty())
    val receiver_type = if unwrap_err:
        HirType(kind: HirTypeKind.Result(text_type, payload), span: Span.empty())
    else:
        HirType(kind: HirTypeKind.Result(payload, text_type), span: Span.empty())
    # Lowering this sentinel would report an error: the supplied receiver local
    # must be used once, as on the real chained-method path.
    val receiver = HirExpr(kind: HirExprKind.Error, has_type_: true,
        type_: receiver_type, span: Span.empty())
    val output = lowering.lower_result_unwrap_core(receiver, payload, fallback, unwrap_err, prelowered, true)
    var diagnostics: [text] = []
    var fatal = false
    for error in lowering.errors:
        diagnostics.push(error.message)
        fatal = fatal or error.fatal
    val output_type = lowering.local_mir_type_of(output)
    val payload_type = lowering.find_local_hir_type(output.id)
    val optional = lowering.option_value_locals.get(output.id) ?? false
    val tagged = lowering.is_runtime_value_local(output.id)
    var finished = lowering.builder
    finished.terminate_return(nil)
    ResultOptionalProbe(function: finished.end_function(), diagnostics: diagnostics,
        fatal: fatal, output_type: output_type, payload_type: payload_type,
        optional: optional, tagged: tagged, output_local: output.id)

fn result_optional_calls(function: MirFunction) -> [text]:
    var calls: [text] = []
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(name), _): calls.push(name)
                        case _: fail("unexpected indirect call in Result Optional unwrap")
                case _: ()
    calls

fn result_optional_raw_copy(probe: ResultOptionalProbe) -> bool:
    var payload = -1
    var copied = -1
    for block in probe.function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(dest, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str("rt_enum_payload"), _):
                            if val local = dest: payload = local.id
                        case _: ()
                case MirInstKind.Copy(dest, source):
                    if dest.id == probe.output_local: copied = source.id
                case _: ()
    payload >= 0 and copied == payload

fn result_optional_tag(function: MirFunction) -> i64:
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.BinOp(_, MirBinOp.Eq, _, right):
                    match right.kind:
                        case MirOperandKind.Copy(local):
                            for candidate in block.instructions:
                                match candidate.kind:
                                    case MirInstKind.Const(dest, MirConstValue.Int(value), _):
                                        if dest.id == local.id: return value
                                    case _: ()
                        case _: fail("Result discriminant key is not a constant local")
                case _: ()
    panic("Result unwrap did not compare a discriminant")

describe "Result Optional payload ownership":
    it "retains scalar Optional handles and types without decoding or allocating":
        step("Lower supported Optional payloads through the actual Result unwrap owner")
        for inner in [result_optional_integer_type(),
                HirType(kind: HirTypeKind.Bool, span: Span.empty()),
                HirType(kind: HirTypeKind.Float(64), span: Span.empty()),
                HirType(kind: HirTypeKind.Str, span: Span.empty())]:
            val payload = result_optional_payload(inner)
            val probe = result_optional_probe(payload, false, nil, SymbolTable.new())
            expect(probe.diagnostics.len()).to_equal(0)
            expect(probe.fatal).to_equal(false)
            expect(probe.output_type).to_equal(Some(MirType.i64()))
            expect(probe.payload_type).to_equal(Some(payload))
            expect(probe.optional).to_equal(true)
            expect(probe.tagged).to_equal(true)
            expect(result_optional_raw_copy(probe)).to_equal(true)
            val calls = result_optional_calls(probe.function)
            expect(calls.len()).to_equal(3)
            expect(calls).to_contain("rt_enum_discriminant")
            expect(calls).to_contain("rt_enum_payload")
            expect(calls).to_contain("rt_panic")

    it "retains a declared nominal inner owner through the Optional boundary":
        step("Use actual symbol-table declarations for Struct Class and Enum payloads")
        for kind in [SymbolKind.Struct, SymbolKind.Class, SymbolKind.Enum]:
            var symbols = SymbolTable.new()
            val symbol = symbols.define("Payload", kind, nil, Span.empty(),
                Visibility.Public, false, Some("result_optional_probe"))
            val inner = HirType(kind: HirTypeKind.Named(symbol, []), span: Span.empty())
            val payload = result_optional_payload(inner)
            val probe = result_optional_probe(payload, false, nil, symbols)
            expect(probe.diagnostics.len()).to_equal(0)
            expect(probe.payload_type).to_equal(Some(payload))
            expect(probe.optional).to_equal(true)
            expect(probe.tagged).to_equal(true)
            expect(result_optional_raw_copy(probe)).to_equal(true)

    it "selects only the exact requested Result tag and aborts every mismatch":
        step("Inspect unwrap and unwrap_err gates including their nonmatching-tag successor")
        for unwrap_err in [false, true]:
            val probe = result_optional_probe(result_optional_payload(result_optional_integer_type()),
                unwrap_err, nil, SymbolTable.new())
            expect(probe.diagnostics.len()).to_equal(0)
            expect(result_optional_tag(probe.function)).to_equal(if unwrap_err: 1 else: 0)
            val expected = if unwrap_err: "called `.unwrap_err()` on an Ok Result" else: "called `.unwrap()` on an Err Result"
            var mismatches = 0
            var payload_block = -1
            var mismatch_block = -1
            for block in probe.function.blocks:
                if block.label == Some("result_unwrap_payload"): payload_block = block.id.id
                if block.label == Some("result_unwrap_mismatch"):
                    mismatches = mismatches + 1
                    mismatch_block = block.id.id
                    expect(block.terminator).to_equal(MirTerminator.Abort(expected))
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.Copy(dest, _):
                                expect(dest.id == probe.output_local).to_equal(false)
                            case _: ()
            expect(mismatches).to_equal(1)
            expect(payload_block).to_be_greater_than(-1)
            match probe.function.blocks[0].terminator:
                case MirTerminator.If(_, matching, other):
                    expect(matching.id).to_equal(payload_block)
                    expect(other.id).to_equal(mismatch_block)
                case _: fail("Result tag equality must gate payload access")

    it "keeps Any unknown owners nested forms and defaults outside this route":
        step("Reject unsupported Optional inner shapes before reading the receiver")
        for inner in [HirType(kind: HirTypeKind.Any, span: Span.empty()),
                HirType(kind: HirTypeKind.Error, span: Span.empty()),
                HirType(kind: HirTypeKind.Int(32, true), span: Span.empty()),
                HirType(kind: HirTypeKind.Int(64, false), span: Span.empty()),
                HirType(kind: HirTypeKind.Float(32), span: Span.empty()),
                HirType(kind: HirTypeKind.Named(SymbolId(id: -77), []), span: Span.empty()),
                result_optional_payload(result_optional_integer_type()),
                HirType(kind: HirTypeKind.Array(result_optional_integer_type(), nil), span: Span.empty())]:
            for unwrap_err in [false, true]:
                val probe = result_optional_probe(result_optional_payload(inner), unwrap_err, nil, SymbolTable.new())
                val operation = if unwrap_err: "unwrap_err" else: "unwrap"
                expect(probe.diagnostics.len()).to_equal(1)
                expect(probe.diagnostics[0]).to_equal(
                    "unsupported Result {operation} payload type: payload is Optional, not a tuple")
                expect(probe.fatal).to_equal(true)
                expect(probe.optional).to_equal(false)
                expect(result_optional_calls(probe.function).len()).to_equal(0)
        val fallback = HirExpr(kind: HirExprKind.NilLit, has_type_: true,
            type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()), span: Span.empty())
        val rejected = result_optional_probe(result_optional_payload(result_optional_integer_type()),
            false, Some(fallback), SymbolTable.new())
        expect(rejected.fatal).to_equal(true)
        expect(rejected.diagnostics.len()).to_equal(1)
        expect(rejected.diagnostics[0]).to_equal(
            "unsupported Result unwrap payload type: payload is Optional, not a tuple")
        expect(result_optional_calls(rejected.function).len()).to_equal(0)

    it "rejects a non-type declaration and unapplied nominal generic metadata":
        step("Keep a function symbol and generic arguments out of nominal payload admission")
        var symbols = SymbolTable.new()
        val function = symbols.define("not_a_type", SymbolKind.Function, nil, Span.empty(),
            Visibility.Public, false, Some("result_optional_probe"))
        val record = symbols.define("Record", SymbolKind.Struct, nil, Span.empty(),
            Visibility.Public, false, Some("result_optional_probe"))
        for inner in [HirType(kind: HirTypeKind.Named(function, []), span: Span.empty()),
                HirType(kind: HirTypeKind.Named(record, [result_optional_integer_type()]), span: Span.empty())]:
            val probe = result_optional_probe(result_optional_payload(inner), false, nil, symbols)
            expect(probe.fatal).to_equal(true)
            expect(probe.optional).to_equal(false)
            expect(result_optional_calls(probe.function).len()).to_equal(0)
