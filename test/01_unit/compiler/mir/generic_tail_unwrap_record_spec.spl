# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
An erased generic `-> T` tail `.unwrap()`, `if val`, and `match` keep the tagged `T` word.

Bug: doc/08_tracking/bug/stage2_generic_tail_unwrap_reboxes_record_2026-11-19.md

Inside a free erased generic function, every `Option` (`T?`) payload (from a `T?`
parameter, an `rt_tuple_get<T>` / `tuple_at<T>` call, a `[T]` helper `first(xs)`,
or a `fn() -> T?` callable) carries the tagged `T` word:
- Callers encode scalar payloads of `T?` arguments (`encode_erased_scalar_opt_arg_v1`),
  scalar `fn(...) -> T?` callable returns (`adapt_erased_opt_callable_arg_v1`),
  and multi-field enum tuple slots (`encode_enum_tuple_payload_slot_v1`).
- Unwrapping `T?` inside a free generic function (`.unwrap()`, `!`, `if val`,
  `match Some(x)`) marks the extracted `T` word as a runtime value so the `-> T`
  tail does not emit `rt_value_int_wide` (no `ptr << 3` SIGSEGV on records and
  no `x8` double-boxing on scalars).
- Concrete `-> T` callers decode scalars via `rt_value_as_int_wide` /
  `rt_value_as_u64` / `rt_value_as_float` and pass records through directly.

HIR is lowered with SIMPLE_BOOTSTRAP=1 and SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE=1
(how native-build lowers a module). The native oracle is
test/fixtures/native_generic_tail_unwrap_record/main.spl.
"""

use std.spec
use std.io_runtime.{env_get, env_set, env_remove_process}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*
use compiler.mir.mir_instruction_graph.{mir_module_functions_sorted}
use compiler.mir.mir_lowering.{MirLowering, bootstrap_mir_function_count, bootstrap_mir_function_at, bootstrap_mir_function_name_at}

fn _extract_mir_calls(function: MirFunction) -> text:
    var calls: [text] = []
    for block in function.blocks:
        for inst in block.instructions:
            match inst.kind:
                case Call(_, func, _):
                    match func.kind:
                        case Const(value, _):
                            match value:
                                case Str(s): calls = calls.push(s)
                                case _: ()
                        case _: ()
                case Intrinsic(_, name, _):
                    calls = calls.push(name)
                case _: ()
        match block.terminator:
            case CallTerminator(_, func, _, _, _, _, _):
                match func.kind:
                    case Const(value, _):
                        match value:
                            case Str(s): calls = calls.push(s)
                            case _: ()
                    case _: ()
            case _: ()
    calls.join("|")

val SOURCE: text = "class Bag2<T>:\n    xs: [T]\n\nimpl Bag2<T>:\n    fn top() -> T:\n        first(self.xs).unwrap()\n\n" +
    "fn use_first_rec() -> i64:\n    val p: Pair = first([Pair(a: 1, b: \"x\")]).unwrap()\n    p.a\n\n" +
    "fn use_first_text() -> text:\n    first([\"x\"]).unwrap()\n\nstruct Pair:\n    a: i64\n    b: text\n\n" +
    "fn req<T>(v: T?) -> T:\n    v.unwrap()\n\n" +
    "fn req_if<T>(v: T?) -> T:\n    if val p = v:\n        return p\n    panic(\"none\")\n\n" +
    "fn use_rec() -> i64:\n    val p: Pair = req(Some(Pair(a: 1, b: \"x\")))\n    p.a\n\n" +
    "fn use_int() -> i64:\n    req(Some(5))\n\n" +
    "fn use_int_if() -> i64:\n    req_if(Some(5))\n\n" +
    "@unsafe(reason: \"fixture raw tuple ABI\", capabilities: [ffi])\nextern fn rt_tuple_get<TElement>(tuple: i64, index: i64) -> TElement?\n\n" +
    "fn tuple_at<TElement>(tuple: i64, index: i64) -> TElement?:\n    unsafe(capabilities: [ffi]):\n        rt_tuple_get<TElement>(tuple, index)\n\n" +
    "fn get_req<T>(tuple: i64, index: i64) -> T:\n    tuple_at<T>(tuple, index).unwrap()\n\n" +
    "fn first<T>(xs: [T]) -> T?:\n    Some(xs[0])\n\n" +
    "fn head<T>(xs: [T]) -> T:\n    first(xs).unwrap()\n\n" +
    "fn use_get_rec(t: i64) -> i64:\n    val p: Pair = get_req<Pair>(t, 0)\n    p.a\n\n" +
    "fn use_get_int(t: i64) -> i64:\n    get_req<i64>(t, 0)\n\n" +
    "fn use_head_int() -> i64:\n    head([5])\n\n" +
    "fn use_first_int() -> i64:\n    first([5]).unwrap()\n\n" +
    "fn get_or<T>(f: fn() -> T?) -> T:\n    f().unwrap()\n\n" +
    "fn mk_opt_int() -> i64?:\n    Some(42)\n\n" +
    "fn use_get_or_int() -> i64:\n    get_or<i64>(\\: Some(42))\n\n" +
    "fn use_get_or_named_int() -> i64:\n    get_or<i64>(mk_opt_int)\n\n" +
    "fn use_get_or_rec() -> i64:\n    val p: Pair = get_or<Pair>(\\: Some(Pair(a: 11, b: \"y\")))\n    p.a\n"

var _cached_gtu_mir: Dict<text, text>? = nil

fn _restore_gtu_env(name: text, old: text?):
    if old.?:
        env_set(name, old ?? "")
    else:
        env_remove_process(name)

fn _restore_gtu_envs(saved_bs: text?, saved_ec: text?):
    _restore_gtu_env("SIMPLE_BOOTSTRAP", saved_bs)
    _restore_gtu_env("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", saved_ec)

fn lower_bootstrap_mir() -> Dict<text, text>:
    if val cached = _cached_gtu_mir:
        return cached
    val saved_bs = env_get("SIMPLE_BOOTSTRAP")
    val saved_ec = env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
    defer _restore_gtu_envs(saved_bs, saved_ec)
    val module = parse_and_build_module(SOURCE, "gtu.spl")
    var hir_lowering = HirLowering.with_filename("gtu.spl")
    env_set("SIMPLE_BOOTSTRAP", "1")
    env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "1")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    var hir_map: Dict<text, HirModule> = {}
    hir_map[hir.name] = hir
    mir_lowering.prescan_module_struct_names(hir_map, hir.name)
    mir_lowering.preseed_canonical_type_symbols_v1([hir])
    mir_lowering.register_module_enum_bootstrap_inventory_v1([hir])
    val mir = mir_lowering.lower_module(hir, [], true, None, None, [])
    var out: Dict<text, text> = {}
    var errors = ""
    for error in mir_lowering.errors:
        errors = errors + error.message + "\n"
    out["__errors__"] = errors
    val bs_count = bootstrap_mir_function_count()
    var bi = 0
    while bi < bs_count:
        val function = bootstrap_mir_function_at(bi)
        val prefix = "gtu."
        var short = bootstrap_mir_function_name_at(bi)
        if short.starts_with(prefix):
            short = short.substring(prefix.len(), short.len())
        elif short.starts_with("main."):
            short = short.substring(5, short.len())
        out[short] = _extract_mir_calls(function)
        bi = bi + 1
    for function in mir_module_functions_sorted(mir):
        val prefix = "gtu."
        var short = function.name
        if short.starts_with(prefix):
            short = short.substring(prefix.len(), short.len())
        elif short.starts_with("main."):
            short = short.substring(5, short.len())
        if not out.contains_key(short):
            out[short] = _extract_mir_calls(function)
    _cached_gtu_mir = Some(out)
    out

describe "erased generic tail unwrap (bootstrap HIR)":
    it "lowers the probe module without MIR errors":
        expect(lower_bootstrap_mir()["__errors__"] ?? "missing").to_equal("")

    it "does not re-box the tagged payload of tuple_at<T>(t, i).unwrap() at the tail":
        val mir = lower_bootstrap_mir()["get_req"] ?? ""
        expect(mir).to_contain("rt_unwrap_or_self")
        expect(mir.contains("rt_value_int_wide")).to_equal(false)

    it "does not re-box the tagged payload of an erased generic-call unwrap":
        val mir = lower_bootstrap_mir()["head"] ?? ""
        expect(mir).to_contain("rt_unwrap_or_self")
        expect(mir.contains("rt_value_int_wide")).to_equal(false)

    it "does not re-box the tagged payload of a T? parameter unwrap at the tail":
        val mir = lower_bootstrap_mir()["req"] ?? ""
        expect(mir).to_contain("rt_unwrap_or_self")
        expect(mir.contains("rt_value_int_wide")).to_equal(false)

    it "does not re-box the tagged payload of a closure-call unwrap and encodes scalar fn() -> T? callables":
        val fns = lower_bootstrap_mir()
        val mir = fns["get_or"] ?? ""
        expect(mir).to_contain("rt_unwrap_or_self")
        expect(mir.contains("rt_value_int_wide")).to_equal(false)
        expect(fns["use_get_or_int"] ?? "").to_contain("rt_value_as_int_wide")
        expect(fns["use_get_or_named_int"] ?? "").to_contain("rt_value_as_int_wide")
        expect((fns["use_get_or_rec"] ?? "").contains("rt_value_int_wide")).to_equal(false)
        expect((fns["use_get_or_rec"] ?? "").contains("rt_value_as_int_wide")).to_equal(false)
        var encoded_lambda_lifts = 0
        for fname in fns.keys():
            if fname.contains("__lambda_lift_") and (fns[fname] ?? "").contains("rt_value_int_wide"):
                encoded_lambda_lifts = encoded_lambda_lifts + 1
        expect(encoded_lambda_lifts).to_be_greater_than(1)

    it "concrete callers encode scalar T? args and decode the erased -> T result":
        val fns = lower_bootstrap_mir()
        expect(fns["use_int"] ?? "").to_contain("rt_value_int_wide")
        expect(fns["use_int"] ?? "").to_contain("rt_value_as_int_wide")
        expect(fns["use_int_if"] ?? "").to_contain("rt_value_int_wide")
        expect(fns["use_int_if"] ?? "").to_contain("rt_value_as_int_wide")
        expect(fns["use_get_int"] ?? "").to_contain("rt_value_as_int_wide")
        expect(fns["use_head_int"] ?? "").to_contain("rt_value_as_int_wide")
        expect((fns["use_get_rec"] ?? "").contains("rt_value_as_int_wide")).to_equal(false)
        expect((fns["use_rec"] ?? "").contains("rt_value_int_wide")).to_equal(false)
        expect((fns["use_rec"] ?? "").contains("rt_value_as_int_wide")).to_equal(false)

    it "a generic-class method (plain T) keeps the tail box":
        val mir = lower_bootstrap_mir()["Bag2.top"] ?? ""
        expect(mir).to_contain("rt_value_int_wide")

    it "concrete record and text first(xs).unwrap() never int-box":
        val fns = lower_bootstrap_mir()
        expect((fns["use_first_rec"] ?? "missing").contains("rt_value_int_wide")).to_equal(false)
        expect((fns["use_first_rec"] ?? "").contains("rt_value_as_int_wide")).to_equal(false)
        expect((fns["use_first_text"] ?? "missing").contains("rt_value_int_wide")).to_equal(false)

    it "a concrete first(xs).unwrap() keeps its decode":
        val mir = lower_bootstrap_mir()["use_first_int"] ?? ""
        expect(mir).to_contain("rt_value_as_int_wide")
        expect(mir).to_contain("rt_unwrap_or_self")
