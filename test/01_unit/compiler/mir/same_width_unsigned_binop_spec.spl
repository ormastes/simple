# @req REQ-MIR-SAME-WIDTH-UNSIGNED-ARITHMETIC
# UNRUN: requires an admitted current-source pure-Simple test runner.
# Calls the actual MIR expression lowerer and inspects its real instruction.
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirBlock, HirStmt, HirStmtKind}
use compiler.hir.hir_operators.{HirBinOp, HirUnaryOp}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_data.{MirBuilder}
use compiler.mir.mir_types.{MirType, MirTypeKind, LocalId}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{MirOperandKind, MirBinOp}
use compiler.mir.mir_lowering_stmts.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*

struct UnsignedBinopProbe:
    result_kind: MirTypeKind
    operand_kinds: [MirTypeKind]

fn unsigned_binop_var(symbol: i64, kind: MirTypeKind) -> HirExpr:
    val bits = match kind:
        case MirTypeKind.I8 | MirTypeKind.U8: 8
        case MirTypeKind.I16 | MirTypeKind.U16: 16
        case MirTypeKind.I32 | MirTypeKind.U32: 32
        case _: 64
    val signed = match kind:
        case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: false
        case _: true
    HirExpr(kind: HirExprKind.Var(SymbolId(id: symbol)), has_type_: true,
        type_: HirType(kind: HirTypeKind.Int(bits, signed), span: Span.empty()),
        span: Span.empty())

fn unsigned_binop_probe(left_kind: MirTypeKind, right_kind: MirTypeKind,
    op: HirBinOp
) -> UnsignedBinopProbe:
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_simple_function("same_width_unsigned", "unit")
    val left_local = builder.new_temp(MirType(kind: left_kind))
    val right_local = builder.new_temp(MirType(kind: right_kind))
    lowering.builder = builder
    lowering.local_map[101] = left_local
    lowering.local_map[102] = right_local
    val left = unsigned_binop_var(101, left_kind)
    val right = unsigned_binop_var(102, right_kind)
    val expression = HirExpr(kind: HirExprKind.Binary(op, left, right),
        has_type_: false, type_: None, span: Span.empty())
    val result = lowering.lower_binary_expr(expression, op, left, right)
    expect(lowering.errors.len()).to_equal(0)
    val result_type = lowering.local_mir_type_of(result)
    if result_type == None:
        fail("real binary lowering did not retain its result type")
        return UnsignedBinopProbe(result_kind: MirTypeKind.Unit, operand_kinds: [])
    var operands: [MirTypeKind] = []
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.BinOp(destination, lowered_op, lhs, rhs):
                if destination.id == result.id:
                    if op == HirBinOp.Is: expect(lowered_op).to_equal(MirBinOp.Eq)
                    if op == HirBinOp.IsNot: expect(lowered_op).to_equal(MirBinOp.Ne)
                    for operand in [lhs, rhs]:
                        match operand.kind:
                            case MirOperandKind.Copy(local):
                                val operand_type = lowering.local_mir_type_of(local)
                                if operand_type == None:
                                    fail("lowered comparison operand has no MIR type")
                                else:
                                    operands.push(operand_type.unwrap().kind)
                            case _: fail("expected lowered local operand")
            case _: ()
    expect(operands.len()).to_equal(2)
    UnsignedBinopProbe(result_kind: result_type.unwrap().kind, operand_kinds: operands)

fn unsigned_unary_result(kind: MirTypeKind, op: HirUnaryOp) -> MirTypeKind:
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_simple_function("unsigned_unary", "unit")
    val local = builder.new_temp(MirType(kind: kind))
    lowering.builder = builder
    lowering.local_map[101] = local
    val operand = unsigned_binop_var(101, kind)
    val expression = HirExpr(kind: HirExprKind.Unary(op, operand),
        has_type_: false, type_: None, span: Span.empty())
    val result = lowering.lower_expr(expression)
    expect(lowering.errors.len()).to_equal(0)
    val result_type = lowering.local_mir_type_of(result)
    if result_type == None:
        fail("real unary lowering did not retain its result type")
        return MirTypeKind.Unit
    result_type.unwrap().kind

fn unsigned_unknown_comparison_casts(unknown_left: bool) -> i64:
    # An unresolved recovery local has no registered MIR type. Preserve that
    # missing metadata instead of treating the i64 fallback as proof of type.
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_simple_function("unknown_comparison", "unit")
    val narrow = builder.new_temp(MirType(kind: MirTypeKind.U8))
    lowering.builder = builder
    lowering.local_map[101] = if unknown_left: LocalId(id: 9999) else: narrow
    lowering.local_map[102] = if unknown_left: narrow else: LocalId(id: 9999)
    val left = unsigned_binop_var(101, if unknown_left: MirTypeKind.I64 else: MirTypeKind.U8)
    val right = unsigned_binop_var(102, if unknown_left: MirTypeKind.U8 else: MirTypeKind.I64)
    val expression = HirExpr(kind: HirExprKind.Binary(HirBinOp.Lt, left, right),
        has_type_: false, type_: None, span: Span.empty())
    lowering.lower_binary_expr(expression, HirBinOp.Lt, left, right)
    var casts = 0
    var comparisons = 0
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.Cast(_, _, _): casts = casts + 1
            case MirInstKind.BinOp(_, _, _, _): comparisons = comparisons + 1
            case _: ()
    expect(comparisons).to_equal(1)
    casts

fn unsigned_match_body(value: i64) -> HirBlock:
    val expression = HirExpr(kind: HirExprKind.IntLit(value, None),
        has_type_: false, type_: None, span: Span.empty())
    HirBlock(stmts: [], has: true, value: expression, span: Span.empty())

fn unsigned_sparse_match_operands(kind: MirTypeKind) -> [MirTypeKind]:
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_simple_function("unsigned_sparse_match", "unit")
    val scrutinee = builder.new_temp(MirType(kind: kind))
    lowering.builder = builder
    lowering.emit_if_chain_dispatch(scrutinee, [(256, unsigned_match_body(1))],
        unsigned_match_body(0), None,
        Some(HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())))
    expect(lowering.errors.len()).to_equal(0)
    var finished = lowering.builder
    val function = finished.end_function()
    var compared: [MirTypeKind] = []
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.BinOp(_, MirBinOp.Eq, left, right):
                    for operand in [left, right]:
                        match operand.kind:
                            case MirOperandKind.Copy(id):
                                for local in function.locals:
                                    if local.id.id == id.id:
                                        compared.push(local.type_.kind)
                            case _: fail("sparse match comparison lost its local")
                case _: ()
    expect(compared.len()).to_equal(2)
    compared

fn unsigned_annotated_binding_probe(kind: MirTypeKind, signed_word: bool, op: HirBinOp):
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_simple_function("annotated_unsigned_binding", "unit")
    val left_local = builder.new_temp(MirType(kind: kind))
    val right_local = builder.new_temp(MirType(kind: kind))
    val word_kind = if signed_word: MirTypeKind.I64 else: MirTypeKind.U64
    val peer = builder.new_temp(MirType(kind: word_kind))
    lowering.builder = builder
    lowering.local_map[101] = left_local
    lowering.local_map[102] = right_local
    lowering.local_map[104] = peer
    val sum = HirExpr(kind: HirExprKind.Binary(HirBinOp.Add,
        unsigned_binop_var(101, kind), unsigned_binop_var(102, kind)),
        has_type_: false, type_: None, span: Span.empty())
    val declared = HirType(kind: HirTypeKind.Int(64, signed_word), span: Span.empty())
    lowering.lower_stmt(HirStmt(kind: HirStmtKind.Let(SymbolId(id: 103), declared, sum), span: Span.empty()))
    expect(lowering.errors.len()).to_equal(0)
    var widened_initializer = false
    var copied_wide_initializer = false
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.Cast(_, source, target):
                match source.kind:
                    case MirOperandKind.Copy(local):
                        if val source_type = lowering.local_mir_type_of(local):
                            if source_type.kind == kind and target.kind == word_kind:
                                widened_initializer = true
                    case _: ()
            case MirInstKind.Copy(destination, source):
                if val source_type = lowering.local_mir_type_of(source):
                    if val destination_type = lowering.local_mir_type_of(destination):
                        if source_type.kind == word_kind and destination_type.kind == word_kind:
                            copied_wide_initializer = true
            case _: ()
    expect(widened_initializer).to_equal(true)
    expect(copied_wide_initializer).to_equal(true)
    val left = unsigned_binop_var(103, word_kind)
    val right = unsigned_binop_var(104, word_kind)
    val comparison = HirExpr(kind: HirExprKind.Binary(op, left, right),
        has_type_: false, type_: None, span: Span.empty())
    val result = lowering.lower_binary_expr(comparison, op, left, right)
    var checked_comparison = false
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.BinOp(destination, _, lhs, rhs):
                if destination.id == result.id:
                    for operand in [lhs, rhs]:
                        match operand.kind:
                            case MirOperandKind.Copy(local):
                                expect(lowering.local_mir_type_of(local).unwrap().kind).to_equal(word_kind)
                            case _: fail("annotated binding comparison lost its local")
                    checked_comparison = true
            case _: ()
    expect(checked_comparison).to_equal(true)

describe "same-width unsigned MIR arithmetic":
    it "retains each unsigned width at every arithmetic operation":
        for op in [HirBinOp.Add, HirBinOp.Sub, HirBinOp.Mul]:
            for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                val result = unsigned_binop_probe(kind, kind, op)
                expect(result.result_kind).to_equal(kind)
                expect(result.operand_kinds).to_equal([kind, kind])

    it "materializes declared word bindings before their later comparisons":
        for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
            for signed_word in [false, true]:
                for op in [HirBinOp.Lt, HirBinOp.Eq, HirBinOp.NotEq]:
                    unsigned_annotated_binding_probe(kind, signed_word, op)

    it "preserves the existing mixed-width and signed arithmetic policies":
        for op in [HirBinOp.Add, HirBinOp.Sub, HirBinOp.Mul]:
            expect(unsigned_binop_probe(MirTypeKind.U8, MirTypeKind.U16, op).result_kind).to_equal(MirTypeKind.I64)
            expect(unsigned_binop_probe(MirTypeKind.U8, MirTypeKind.I64, op).result_kind).to_equal(MirTypeKind.I64)
            expect(unsigned_binop_probe(MirTypeKind.I8, MirTypeKind.I8, op).result_kind).to_equal(MirTypeKind.I64)

    it "widens narrow unsigned comparisons without discarding signed values or bounds":
        for op in [HirBinOp.Eq, HirBinOp.NotEq, HirBinOp.Is, HirBinOp.IsNot, HirBinOp.Lt, HirBinOp.LtEq, HirBinOp.Gt, HirBinOp.GtEq]:
            for narrow in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                for other in [MirTypeKind.I8, MirTypeKind.I16, MirTypeKind.I32, MirTypeKind.I64, MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                    val forward = unsigned_binop_probe(narrow, other, op)
                    val reverse = unsigned_binop_probe(other, narrow, op)
                    expect(forward.result_kind).to_equal(MirTypeKind.Bool)
                    expect(forward.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
                    expect(reverse.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
                val wide = unsigned_binop_probe(narrow, MirTypeKind.U64, op)
                val wide_reverse = unsigned_binop_probe(MirTypeKind.U64, narrow, op)
                expect(wide.operand_kinds).to_equal([MirTypeKind.U64, MirTypeKind.U64])
                expect(wide_reverse.operand_kinds).to_equal([MirTypeKind.U64, MirTypeKind.U64])

    it "promotes mixed numeric consumers without changing their inferred result":
        for op in [HirBinOp.Add, HirBinOp.Sub, HirBinOp.Mul, HirBinOp.Div, HirBinOp.Mod, HirBinOp.Pow, HirBinOp.BitAnd, HirBinOp.BitOr, HirBinOp.BitXor, HirBinOp.Shl, HirBinOp.Shr]:
            for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                val forward = unsigned_binop_probe(kind, MirTypeKind.I64, op)
                val reverse = unsigned_binop_probe(MirTypeKind.I64, kind, op)
                expect(forward.result_kind).to_equal(MirTypeKind.I64)
                expect(forward.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
                expect(reverse.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
        val division = unsigned_binop_probe(MirTypeKind.U16, MirTypeKind.U16, HirBinOp.Div)
        expect(division.result_kind).to_equal(MirTypeKind.I64)
        expect(division.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])

    it "retains operand width for unsigned negation and complement":
        for op in [HirUnaryOp.Neg, HirUnaryOp.BitNot]:
            for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                expect(unsigned_unary_result(kind, op)).to_equal(kind)
            expect(unsigned_unary_result(MirTypeKind.I64, op)).to_equal(MirTypeKind.I64)

    it "does not manufacture casts from missing operand type metadata":
        expect(unsigned_unknown_comparison_casts(true)).to_equal(0)
        expect(unsigned_unknown_comparison_casts(false)).to_equal(0)

    it "compares sparse literal-match keys at a lossless word width":
        for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
            expect(unsigned_sparse_match_operands(kind)).to_equal([MirTypeKind.I64, MirTypeKind.I64])
