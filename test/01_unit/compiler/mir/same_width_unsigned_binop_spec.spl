# @req REQ-MIR-SAME-WIDTH-UNSIGNED-ARITHMETIC
# UNRUN: requires an admitted current-source pure-Simple test runner.
# Calls the actual MIR expression lowerer and inspects its real instruction.
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.hir.hir_operators.{HirBinOp}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_data.{MirBuilder}
use compiler.mir.mir_types.{MirType, MirTypeKind}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{MirOperandKind}
use compiler.mir.mir_lowering_stmts.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*

struct UnsignedBinopProbe:
    result_kind: MirTypeKind
    operand_kinds: [MirTypeKind]

fn unsigned_binop_var(symbol: i64, kind: MirTypeKind) -> HirExpr:
    val bits = match kind:
        case MirTypeKind.I8 | MirTypeKind.U8: 8
        case MirTypeKind.I16 | MirTypeKind.U16: 16
        case MirTypeKind.I32 | MirTypeKind.U32: 32
        case _: 64
    val signed = match kind:
        case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: false
        case _: true
    HirExpr(kind: HirExprKind.Var(SymbolId(id: symbol)), has_type_: true,
        type_: HirType(kind: HirTypeKind.Int(bits, signed), span: Span.empty()),
        span: Span.empty())

fn unsigned_binop_probe(left_kind: MirTypeKind, right_kind: MirTypeKind,
    op: HirBinOp
) -> UnsignedBinopProbe:
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_simple_function("same_width_unsigned", "unit")
    val left_local = builder.new_temp(MirType(kind: left_kind))
    val right_local = builder.new_temp(MirType(kind: right_kind))
    lowering.builder = builder
    lowering.local_map[101] = left_local
    lowering.local_map[102] = right_local
    val left = unsigned_binop_var(101, left_kind)
    val right = unsigned_binop_var(102, right_kind)
    val expression = HirExpr(kind: HirExprKind.Binary(op, left, right),
        has_type_: false, type_: nil, span: Span.empty())
    val result = lowering.lower_binary_expr(expression, op, left, right)
    expect(lowering.errors.len()).to_equal(0)
    val result_type = lowering.local_mir_type_of(result)
    if result_type == nil:
        fail("real binary lowering did not retain its result type")
        return UnsignedBinopProbe(result_kind: MirTypeKind.Unit, operand_kinds: [])
    var operands: [MirTypeKind] = []
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.BinOp(destination, _, lhs, rhs):
                if destination.id == result.id:
                    for operand in [lhs, rhs]:
                        match operand.kind:
                            case MirOperandKind.Copy(local):
                                val operand_type = lowering.local_mir_type_of(local)
                                if operand_type == nil:
                                    fail("lowered comparison operand has no MIR type")
                                else:
                                    operands.push(operand_type.unwrap().kind)
                            case _: fail("expected lowered local operand")
            case _: ()
    expect(operands.len()).to_equal(2)
    UnsignedBinopProbe(result_kind: result_type.unwrap().kind, operand_kinds: operands)

describe "same-width unsigned MIR arithmetic":
    it "retains each unsigned width at every arithmetic operation":
        for op in [HirBinOp.Add, HirBinOp.Sub, HirBinOp.Mul]:
            for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                val result = unsigned_binop_probe(kind, kind, op)
                expect(result.result_kind).to_equal(kind)
                expect(result.operand_kinds).to_equal([kind, kind])

    it "preserves the existing mixed-width and signed arithmetic policies":
        for op in [HirBinOp.Add, HirBinOp.Sub, HirBinOp.Mul]:
            expect(unsigned_binop_probe(MirTypeKind.U8, MirTypeKind.U16, op).result_kind).to_equal(MirTypeKind.I64)
            expect(unsigned_binop_probe(MirTypeKind.U8, MirTypeKind.I64, op).result_kind).to_equal(MirTypeKind.I64)
            expect(unsigned_binop_probe(MirTypeKind.I8, MirTypeKind.I8, op).result_kind).to_equal(MirTypeKind.I64)

    it "widens narrow unsigned comparisons without discarding signed values or bounds":
        for op in [HirBinOp.Eq, HirBinOp.NotEq, HirBinOp.Is, HirBinOp.IsNot, HirBinOp.Lt, HirBinOp.LtEq, HirBinOp.Gt, HirBinOp.GtEq]:
            for narrow in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                for other in [MirTypeKind.I8, MirTypeKind.I16, MirTypeKind.I32, MirTypeKind.I64, MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                    val forward = unsigned_binop_probe(narrow, other, op)
                    val reverse = unsigned_binop_probe(other, narrow, op)
                    expect(forward.result_kind).to_equal(MirTypeKind.Bool)
                    expect(forward.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
                    expect(reverse.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
                val wide = unsigned_binop_probe(narrow, MirTypeKind.U64, op)
                val wide_reverse = unsigned_binop_probe(MirTypeKind.U64, narrow, op)
                expect(wide.operand_kinds).to_equal([MirTypeKind.U64, MirTypeKind.U64])
                expect(wide_reverse.operand_kinds).to_equal([MirTypeKind.U64, MirTypeKind.U64])

    it "promotes mixed numeric consumers without changing their inferred result":
        for op in [HirBinOp.Add, HirBinOp.Sub, HirBinOp.Mul, HirBinOp.Div, HirBinOp.Mod, HirBinOp.Pow, HirBinOp.BitAnd, HirBinOp.BitOr, HirBinOp.BitXor, HirBinOp.Shl, HirBinOp.Shr]:
            for kind in [MirTypeKind.U8, MirTypeKind.U16, MirTypeKind.U32]:
                val forward = unsigned_binop_probe(kind, MirTypeKind.I64, op)
                val reverse = unsigned_binop_probe(MirTypeKind.I64, kind, op)
                expect(forward.result_kind).to_equal(MirTypeKind.I64)
                expect(forward.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
                expect(reverse.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
        val division = unsigned_binop_probe(MirTypeKind.U16, MirTypeKind.U16, HirBinOp.Div)
        expect(division.result_kind).to_equal(MirTypeKind.I64)
        expect(division.operand_kinds).to_equal([MirTypeKind.I64, MirTypeKind.I64])
