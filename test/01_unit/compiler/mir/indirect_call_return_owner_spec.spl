use std.spec
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable, HirSymbol, SymbolKind, ScopeId}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirField}
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*

fn indirect_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn indirect_record(id: i64, module_name: text) -> HirSymbol:
    HirSymbol(id: SymbolId(id: id), name: "Reply", kind: SymbolKind.Struct,
        type_: nil, scope: ScopeId(id: 0), span: Span.empty(),
        visibility: Visibility.Public, is_public: true, is_mutable: false,
        defining_module: Some(module_name))

fn indirect_signature(result: HirType) -> HirType:
    indirect_type(HirTypeKind.Function([], result, []))

fn indirect_return_owner(signature: HirType) -> i64:
    match signature.kind:
        case HirTypeKind.Function(_, result, _):
            match result.kind:
                case HirTypeKind.Named(owner, _): return owner.id
                case HirTypeKind.Error: return -2
                case _: return -1
        case _: return -1

fn indirect_lowering() -> MirLowering:
    var symbols = SymbolTable.new()
    # The foreign provider ID collides with the other owner's short binding.
    symbols.register_preserved_symbol(indirect_record(7, "other"))
    symbols.register_preserved_symbol(indirect_record(77, "provider"))
    symbols.bind_qualified_type("provider", "Reply", SymbolId(id: 77))
    symbols.bind_local_type_if_free("ActualReply", SymbolId(id: 77))
    var lowering = MirLowering.new(symbols)
    lowering.struct_field_order["src/provider.spl::Reply"] = ["status", "stdout", "stderr"]
    lowering.struct_identity_layout_key["provider::Reply"] = "src/provider.spl::Reply"
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 90), "probe", MirSignature(params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
    lowering.builder = builder
    lowering

describe "indirect call declared return owner":
    it "prescans and rebinds an imported callback return despite a competing short name":
        var provider_symbols = SymbolTable.new()
        provider_symbols.register_preserved_symbol(indirect_record(7, "src/provider.spl"))
        val signature = indirect_signature(indirect_type(HirTypeKind.Named(SymbolId(id: 7), [])))
        val placeholder = HirExpr(kind: HirExprKind.IntLit(0), has_type_: false,
            type_: indirect_type(HirTypeKind.Error), span: Span.empty())
        val field = HirField(symbol: SymbolId(id: 8), name: "reply_fn", type_: signature,
            has_default: false, default: placeholder, visibility: Visibility.Public,
            is_public: true, is_volatile: false, has_bits_attr: false, bits_width: 0,
            has_fixed_address: false, fixed_address: 0, span: Span.empty())
        var lowering = indirect_lowering()
        lowering.register_composite_field_metadata("provider::Port", [field], provider_symbols, true)
        expect(lowering.struct_field_type_ownership_key["provider::Port"][0]).to_equal("src/provider.spl::Reply")
        val rebound = lowering.declared_field_type_in_current_table("provider::Port", 0, signature)
        expect(indirect_return_owner(rebound)).to_equal(77)

    it "does not trust a colliding foreign ID without an exact owner":
        var lowering = indirect_lowering()
        val signature = indirect_signature(indirect_type(HirTypeKind.Named(SymbolId(id: 7), [])))
        expect(indirect_return_owner(lowering.declared_field_type_in_current_table("missing", 0, signature))).to_equal(-2)
        lowering.struct_field_type_ownership_key["port"] = ["absent::Reply"]
        expect(indirect_return_owner(lowering.declared_field_type_in_current_table("port", 0, signature))).to_equal(-2)
        lowering.struct_field_type_ownership_key["port"] = ["provider::Reply"]
        expect(indirect_return_owner(lowering.declared_field_type_in_current_table("port", 2, signature))).to_equal(-2)

    it "emits a record result with the declared HIR owner and canonical layout":
        var lowering = indirect_lowering()
        val signature = indirect_signature(indirect_type(HirTypeKind.Named(SymbolId(id: 77), [])))
        var builder = lowering.builder
        val callable = builder.new_temp(MirType.i64())
        lowering.builder = builder
        val result = lowering.emit_typed_function_value_call(callable, [], Some(signature), Span.empty())
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.struct_value_syms[result.id]).to_equal("src/provider.spl::Reply")
        val retained = lowering.find_local_hir_type(result.id)
        expect(retained.?).to_equal(true)
        if val type_ = retained:
            expect(indirect_return_owner(indirect_signature(type_))).to_equal(77)
        val actual = lowering.local_mir_type_of(result)
        expect(actual.?).to_equal(true)
        if val type_ = actual:
            var is_record = false
            match type_.kind:
                case MirTypeKind.Struct(_): is_record = true
                case _: ()
            expect(is_record).to_equal(true)

    it "shares argument lowering without re-evaluating an already-projected callee":
        var lowering = indirect_lowering()
        val signature = indirect_signature(indirect_type(HirTypeKind.Bool))
        val invalid_base = HirExpr(kind: HirExprKind.Var(SymbolId(id: -500)), has_type_: false,
            type_: indirect_type(HirTypeKind.Error), span: Span.empty())
        val field = HirExpr(kind: HirExprKind.Field(invalid_base, "callback", nil),
            has_type_: true, type_: signature, span: Span.empty())
        var builder = lowering.builder
        val callable = builder.new_temp(MirType.i64())
        lowering.builder = builder
        lowering.remember_local_hir_type(callable.id, signature, 0, 0)
        val result = lowering.lower_call_with_value(field, [], Some(callable))
        expect(lowering.errors.len()).to_equal(0)
        val actual = lowering.local_mir_type_of(result)
        expect(actual.?).to_equal(true)
        if val type_ = actual:
            expect(type_.kind).to_equal(MirTypeKind.Bool)

    it "rejects unresolved declared callback results instead of guessing a record":
        var lowering = indirect_lowering()
        var builder = lowering.builder
        val callable = builder.new_temp(MirType.i64())
        lowering.builder = builder
        val result = lowering.emit_typed_function_value_call(callable, [], Some(indirect_signature(indirect_type(HirTypeKind.Error))), Span.empty())
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].message).to_contain("unresolved declared return type")
