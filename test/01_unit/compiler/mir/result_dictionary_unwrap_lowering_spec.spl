"""Real MIR lowering probes for Result dictionary handle and failure paths."""
# @req REQ-ENUM-RESULT-DICT
# @cover src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_graph.{MirFunction}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirSignature, MirConstValue}
use compiler.mir.mir_instruction_support.{MirOperandKind, MirBinOp, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLoweringExpr.method_calls_literals.*

struct ResultDictionaryProbe:
    function: MirFunction
    diagnostics: [text]
    fatal: bool
    output_type: MirType?
    payload_type: HirType?
    dictionary: bool
    tagged: bool
    element_type: MirType?
    output_local: i64

fn dictionary_integer_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())

fn dictionary_text_type() -> HirType:
    HirType(kind: HirTypeKind.Str, span: Span.empty())

fn dictionary_payload_type(value: HirType) -> HirType:
    HirType(kind: HirTypeKind.Dict(dictionary_text_type(), value), span: Span.empty())

fn dictionary_unwrap_probe(payload: HirType, unwrap_err: bool, fallback: HirExpr?) -> ResultDictionaryProbe:
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 71), "dictionary_unwrap_probe",
        MirSignature(params: [], return_type: MirType.unit(), is_variadic: false), Span.empty())
    val prelowered = builder.emit_const_int(71)
    lowering.builder = builder
    val receiver_type = if unwrap_err:
        HirType(kind: HirTypeKind.Result(dictionary_text_type(), payload), span: Span.empty())
    else:
        HirType(kind: HirTypeKind.Result(payload, dictionary_text_type()), span: Span.empty())
    # This receiver must not be lowered again: the call-site already supplied
    # its local, as chained method lowering does in production.
    val receiver = HirExpr(kind: HirExprKind.Error, has_type_: true,
        type_: receiver_type, span: Span.empty())
    val output = lowering.lower_result_unwrap_core(receiver, payload, fallback, unwrap_err, prelowered, true)
    var diagnostics: [text] = []
    var fatal = false
    for error in lowering.errors:
        diagnostics.push(error.message)
        fatal = fatal or error.fatal
    val output_type = lowering.local_mir_type_of(output)
    val remembered = lowering.find_local_hir_type(output.id)
    val dictionary = lowering.runtime_dict_locals.get(output.id) ?? false
    val tagged = lowering.is_runtime_value_local(output.id)
    val element_type: MirType? = if lowering.runtime_elem_value_type.has(output.id):
        Some(lowering.runtime_elem_value_type[output.id])
    else:
        nil
    var finished = lowering.builder
    finished.terminate_return(nil)
    ResultDictionaryProbe(function: finished.end_function(), diagnostics: diagnostics,
        fatal: fatal, output_type: output_type, payload_type: remembered,
        dictionary: dictionary, tagged: tagged, element_type: element_type, output_local: output.id)

fn dictionary_probe_raw_copy(function: MirFunction, output: i64) -> bool:
    var payload = -1
    var copied = -1
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(dest, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str("rt_enum_payload"), _):
                            if val local = dest: payload = local.id
                        case _: ()
                case MirInstKind.Copy(dest, source):
                    if dest.id == output: copied = source.id
                case _: ()
    payload >= 0 and copied == payload

fn dictionary_probe_calls(function: MirFunction) -> [text]:
    var calls: [text] = []
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(name), _): calls.push(name)
                        case _: fail("unexpected indirect call in Result unwrap probe")
                case _: ()
    calls

fn dictionary_probe_tag(function: MirFunction) -> i64:
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.BinOp(_, MirBinOp.Eq, _, right):
                    match right.kind:
                        case MirOperandKind.Copy(local):
                            for candidate in block.instructions:
                                match candidate.kind:
                                    case MirInstKind.Const(dest, MirConstValue.Int(value), _):
                                        if dest.id == local.id: return value
                                    case _: ()
                        case _: fail("Result discriminant comparison lost its constant local")
                case _: ()
    panic("missing Result discriminant comparison")

describe "Result dictionary lowering ownership":
    it "retains exact dictionary value types and emits no collection allocation or clone":
        step("Lower raw dictionary payload words with declared text and floating metadata")
        val text_type = MirType(kind: MirTypeKind.Tuple([
            MirType.ptr(MirType(kind: MirTypeKind.U8), false), MirType(kind: MirTypeKind.U64)]))
        val source_values = [dictionary_integer_type(), HirType(kind: HirTypeKind.Float(64), span: Span.empty()), dictionary_text_type()]
        val expected_values = [MirType.i64(), MirType.f64(), text_type]
        for index in 0..3:
            val payload = dictionary_payload_type(source_values[index])
            val probe = dictionary_unwrap_probe(payload, false, nil)
            expect(probe.diagnostics.len()).to_equal(0)
            expect(probe.fatal).to_equal(false)
            expect(probe.dictionary).to_equal(true)
            expect(probe.tagged).to_equal(true)
            expect(probe.payload_type).to_equal(Some(payload))
            expect(probe.output_type).to_equal(Some(MirType(kind: MirTypeKind.Dict(text_type, expected_values[index]))))
            expect(probe.element_type).to_equal(Some(expected_values[index]))
            expect(dictionary_probe_raw_copy(probe.function, probe.output_local)).to_equal(true)
            val calls = dictionary_probe_calls(probe.function)
            expect(calls.len()).to_equal(3)
            expect(calls).to_contain("rt_enum_discriminant")
            expect(calls).to_contain("rt_enum_payload")
            expect(calls).to_contain("rt_panic")

    it "selects exact Ok and Err tags and makes each mismatch edge diverge":
        step("Inspect both unwrap directions without executing an expected process abort")
        for unwrap_err in [false, true]:
            val probe = dictionary_unwrap_probe(dictionary_payload_type(dictionary_integer_type()), unwrap_err, nil)
            expect(probe.diagnostics.len()).to_equal(0)
            expect(dictionary_probe_tag(probe.function)).to_equal(if unwrap_err: 1 else: 0)
            val expected = if unwrap_err: "called `.unwrap_err()` on an Ok Result" else: "called `.unwrap()` on an Err Result"
            var mismatches = 0
            for block in probe.function.blocks:
                if block.label == Some("result_unwrap_mismatch"):
                    mismatches = mismatches + 1
                    expect(block.terminator).to_equal(MirTerminator.Abort(expected))
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.Const(_, MirConstValue.Zero, _): fail("mismatch fabricated a successful zero payload")
                            case _: ()
            expect(mismatches).to_equal(1)

    it "keeps unsupported and default-bearing dictionary forms fatal":
        step("Reject unqualified payload shapes instead of treating arbitrary words as dictionaries")
        val nil_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true,
            type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()), span: Span.empty())
        val with_default = dictionary_unwrap_probe(dictionary_payload_type(dictionary_integer_type()), false, Some(nil_expr))
        expect(with_default.diagnostics).to_contain("unsupported Result unwrap payload type")
        expect(with_default.fatal).to_equal(true)
        expect(dictionary_probe_calls(with_default.function).len()).to_equal(0)
        for unwrap_err in [false, true]:
            val unsupported = dictionary_unwrap_probe(HirType(kind: HirTypeKind.Optional(dictionary_integer_type()), span: Span.empty()), unwrap_err, nil)
            expect(unsupported.diagnostics).to_contain(if unwrap_err: "unsupported Result unwrap_err payload type" else: "unsupported Result unwrap payload type")
            expect(unsupported.fatal).to_equal(true)
            expect(unsupported.dictionary).to_equal(false)
            expect(dictionary_probe_calls(unsupported.function).len()).to_equal(0)

    it "retains a scalar default's merge edge while scalar no-default mismatch aborts":
        step("Preserve existing default semantics when making panic-only paths divergent")
        val fallback = HirExpr(kind: HirExprKind.IntLit(7, nil), has_type_: true,
            type_: dictionary_integer_type(), span: Span.empty())
        for has_default in [false, true]:
            val default_value = if has_default: Some(fallback) else: nil
            val probe = dictionary_unwrap_probe(dictionary_integer_type(), false, default_value)
            expect(probe.diagnostics.len()).to_equal(0)
            var mismatches = 0
            for block in probe.function.blocks:
                if block.label == Some("result_unwrap_mismatch"):
                    mismatches = mismatches + 1
                    match block.terminator:
                        case MirTerminator.Goto(_): expect(has_default).to_equal(true)
                        case MirTerminator.Abort(message):
                            expect(has_default).to_equal(false)
                            expect(message).to_equal("called `.unwrap()` on an Err Result")
                        case _: fail("unexpected Result mismatch terminator")
            expect(mismatches).to_equal(1)
