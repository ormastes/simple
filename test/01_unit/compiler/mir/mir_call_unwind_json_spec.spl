use std.spec.*
use compiler.mir.mir_instructions.{
    BlockId, MirCallUnwindContract, MirOperand, MirOperandKind, MirTerminator
}
use compiler.mir.mir_types.{MirConstValue, MirType}
use compiler.mir.mir_json.{serialize_mir_terminator}

fn unwind_json_callee() -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("known_callee"), MirType.unit()))

describe "MIR call unwind JSON contract":
    it "serializes known nounwind calls explicitly before a null unwind edge":
        val json = serialize_mir_terminator(MirTerminator.CallTerminator(
            nil, unwind_json_callee(), [], BlockId(id: 1),
            MirCallUnwindContract.NoUnwind, nil))
        expect(json).to_contain("\"unwind_contract\":\"NoUnwind\"")
        expect(json).to_contain("\"unwind\":null")
        expect(json.index_of("\"unwind_contract\"")).to_be_less_than(
            json.index_of("\"unwind\""))

    it "serializes potentially unwinding calls with their exact unwind edge":
        val json = serialize_mir_terminator(MirTerminator.CallTerminator(
            nil, unwind_json_callee(), [], BlockId(id: 1),
            MirCallUnwindContract.MayUnwind, Some(BlockId(id: 2))))
        expect(json).to_contain("\"unwind_contract\":\"MayUnwind\"")
        expect(json).to_contain("\"unwind\":2")
