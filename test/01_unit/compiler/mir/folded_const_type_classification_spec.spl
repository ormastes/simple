use compiler.mir.mir_types.{MirConstValue}

fn classify_folded_value(value: MirConstValue) -> text:
    match value:
        case Int(_): "int"
        case Float(_): "float"
        case Bool(_): "bool"
        case Str(_): "text"
        case Array(_): "array"
        case Tuple(_): "tuple"
        case Struct(_): "struct"
        case Zero: "zero"

describe "MIR folded constant payload classification":
    it "keeps every scalar payload variant distinct":
        expect(classify_folded_value(MirConstValue.Int(1))).to_equal("int")
        expect(classify_folded_value(MirConstValue.Float(2.5))).to_equal("float")
        expect(classify_folded_value(MirConstValue.Bool(true))).to_equal("bool")
        expect(classify_folded_value(MirConstValue.Str("value"))).to_equal("text")

    it "does not confuse aggregate or zero variants with scalars":
        expect(classify_folded_value(MirConstValue.Array([]))).to_equal("array")
        expect(classify_folded_value(MirConstValue.Tuple([]))).to_equal("tuple")
        expect(classify_folded_value(MirConstValue.Struct(
            Dict<text, MirConstValue>()))).to_equal("struct")
        expect(classify_folded_value(MirConstValue.Zero)).to_equal("zero")
