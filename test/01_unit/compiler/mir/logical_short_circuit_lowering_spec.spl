use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{source_file_coverage_identity}
use compiler.semantics.resolve.{resolve_methods}

extern fn rt_file_read_text(path: text) -> text

fn lower_source_function(src: text, target_name: text) -> text:
    val module = parse_full_frontend(src, "logic.spl", "logic.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("logic.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    for function in mir.functions.values():
        if function.name == target_name or function.name.ends_with(".{target_name}"):
            return serialize_mir_function(function)
    ""

fn lower_logic_function(expr: text) -> text:
    val src = "fn rhs() -> bool:\n    true\n\nfn check(flag: bool, other: bool) -> bool:\n    {expr}\n"
    lower_source_function(src, "check")

fn lower_coverage_constructs(source: text) -> (text, text, text):
    val source_path = "coverage_constructs.spl"
    val module = parse_full_frontend(source, source_path, source_path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(source_path)
    val hir = hir_lowering.lower_module(module)
    val (resolved_hir, resolve_errors) = resolve_methods(hir)
    expect(resolve_errors.len()).to_equal(0)

    var mir_lowering = MirLowering.new(resolved_hir.symbols)
    mir_lowering.enable_coverage_inventory(true)
    val mir = mir_lowering.lower_module(resolved_hir)
    var for_rendered = ""
    var match_rendered = ""
    for function in mir.functions.values():
        if function.name == "counted" or function.name.ends_with(".counted"):
            for_rendered = serialize_mir_function(function)
        if function.name == "choose" or function.name.ends_with(".choose"):
            match_rendered = serialize_mir_function(function)
    (for_rendered, match_rendered, mir_lowering.coverage_manifest_sdn())

fn lower_coverage_function(source: text, target_name: text) -> (text, text):
    val source_path = "coverage_route.spl"
    val module = parse_full_frontend(source, source_path, source_path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(source_path)
    val hir = hir_lowering.lower_module(module)
    val (resolved_hir, resolve_errors) = resolve_methods(hir)
    expect(resolve_errors.len()).to_equal(0)
    var mir_lowering = MirLowering.new(resolved_hir.symbols)
    mir_lowering.enable_coverage_inventory(true)
    val mir = mir_lowering.lower_module(resolved_hir)
    var rendered = ""
    for function in mir.functions.values():
        if function.name == target_name or function.name.ends_with(".{target_name}"):
            rendered = serialize_mir_function(function)
    (rendered, mir_lowering.coverage_manifest_sdn())

fn expect_conditional_rhs(mir: text):
    val if_pos = mir.index_of("\"terminator\":{\"If\"") ?? -1
    val rhs_pos = mir.index_of("\"label\":\"logic_rhs\"") ?? -1
    val call_pos = mir.index_of("\"value\":\"rhs\"") ?? -1
    val short_pos = mir.index_of("\"label\":\"logic_short\"") ?? -1
    val merge_pos = mir.index_of("\"label\":\"logic_merge\"") ?? -1
    val load_pos = mir.index_of("\"Load\"") ?? -1
    expect(if_pos).to_be_greater_than(-1)
    expect(rhs_pos).to_be_greater_than(if_pos)
    expect(call_pos).to_be_greater_than(rhs_pos)
    expect(short_pos).to_be_greater_than(call_pos)
    expect(merge_pos).to_be_greater_than(short_pos)
    expect(load_pos).to_be_greater_than(merge_pos)
    expect(mir.split("\"Alloc\"").len()).to_equal(2)
    expect(mir.split("\"Store\"").len()).to_equal(3)
    expect(mir.split("\"Load\"").len()).to_equal(2)
    expect(mir.contains("\"BitAnd\"")).to_equal(false)
    expect(mir.contains("\"BitOr\"")).to_equal(false)

describe "MIR logical short-circuit lowering", tag: ["only-compiled"]:
    it "branches to the RHS only when an and-left value is true":
        val mir = lower_logic_function("flag and rhs()")
        expect_conditional_rhs(mir)
        expect(mir).to_contain("\"then\":1,\"else\":2")

    it "branches to the RHS only when an or-left value is false":
        val mir = lower_logic_function("flag or rhs()")
        expect_conditional_rhs(mir)
        expect(mir).to_contain("\"then\":2,\"else\":1")

    it "uses independent slots for nested short-circuit expressions":
        val mir = lower_logic_function("flag and (other or rhs())")
        expect(mir.split("\"Alloc\"").len()).to_equal(3)
        expect(mir.split("\"Store\"").len()).to_equal(5)
        expect(mir.split("\"Load\"").len()).to_equal(3)

    it "hoists a loop-body logical merge slot to function entry":
        val src = "fn rhs() -> bool:\n    true\n\nfn check(flag: bool) -> bool:\n    var result = false\n    while flag:\n        result = flag and rhs()\n        break\n    result\n"
        val mir = lower_source_function(src, "check")
        val alloc_pos = mir.index_of("\"Alloc\"")
        val cond_pos = mir.index_of("\"label\":\"while_cond\"")
        val body_pos = mir.index_of("\"label\":\"while_body\"")
        expect(alloc_pos).to_be_greater_than(-1)
        expect(cond_pos).to_be_greater_than(alloc_pos)
        expect(body_pos).to_be_greater_than(cond_pos)
        expect(mir.split("\"Alloc\"").len()).to_equal(2)

describe "MIR block terminator lowering", tag: ["only-compiled"]:
    it "lowers a bare return without an optional payload crash":
        val mir = lower_source_function("fn stop():\n    return\n", "stop")

        expect(mir).to_contain("\"terminator\":{\"Return\":null}")

    it "does not lower a Dict traversal after return":
        val source = "fn check(values: Dict<text, i64>) -> i64:\n    return 7\n    values.values()\n"
        val mir = lower_source_function(source, "check")

        expect(mir).to_contain("\"terminator\":{\"Return\":{\"Copy\"")
        expect(mir).to_contain("\"value\":7")
        expect(mir.contains("rt_dict_values")).to_equal(false)
        expect(mir.contains("Map.values")).to_equal(false)
        expect(mir.contains("Dict.values")).to_equal(false)
        expect(mir.contains("MethodCallStatic")).to_equal(false)

describe "compiler decision inventory", tag: ["only-compiled"]:
    it "keeps the source path and inventories only source decisions and conditions":
        val source = "fn check(left: bool, right: bool) -> bool:\n    if left and right:\n        true\n    else:\n        false\n\nfn choose(value: i64) -> bool:\n    match value:\n        case 1 | 2: true\n        case _: false\n"
        val module = parse_full_frontend(source, "dir/100%,coverage_logic.spl", "coverage_logic", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("dir/100%,coverage_logic.spl")
        val hir = hir_lowering.lower_module(module)
        expect(hir.path).to_equal("dir/100%,coverage_logic.spl")
        val (resolved_hir, resolve_errors) = resolve_methods(hir)
        expect(resolve_errors.len()).to_equal(0)

        var mir_lowering = MirLowering.new(resolved_hir.symbols)
        mir_lowering.enable_coverage_inventory(true)
        val mir = mir_lowering.lower_module(resolved_hir)
        var rendered = ""
        var generated_match = ""
        for function in mir.functions.values():
            if function.name == "check" or function.name.ends_with(".check"):
                rendered = serialize_mir_function(function)
            if function.name == "choose" or function.name.ends_with(".choose"):
                generated_match = serialize_mir_function(function)
        val manifest = mir_lowering.coverage_manifest_sdn()

        expect(rendered.split("__simple_coverage_decision_probe").len()).to_equal(2)
        expect(rendered.split("__simple_coverage_condition_probe").len()).to_equal(3)
        # Or alternatives converge on one authored body marker. Static body
        # duplication is route-dependent; the manifest below proves that it
        # still contributes only two authored-arm IDs.
        expect(generated_match.contains("__simple_coverage_decision_probe")).to_equal(true)
        expect(generated_match.contains("__simple_coverage_condition_probe")).to_equal(false)
        expect(manifest).to_start_with("version: 1.0\ndecisions |id, file, line, column, true_count, false_count|")
        expect(rendered).to_contain("dir/100%,coverage_logic.spl")
        expect(manifest).to_contain("dir/100%25%2Ccoverage_logic.spl")
        expect(manifest.contains("100%2525")).to_equal(false)
        expect(manifest).to_contain("conditions |decision_id, condition_id, file, line, column, true_count, false_count|")
        expect(manifest.split(", 0, 0").len()).to_equal(6)

        val lowering_source = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""
        expect(lowering_source).to_contain("print \"__SIMPLE_COMPILER_COVERAGE_MANIFEST_BEGIN__\"")
        expect(lowering_source).to_contain("print \"__SIMPLE_COMPILER_COVERAGE_MANIFEST_END__\"")
        expect(lowering_source.contains("eprint(\"__SIMPLE_COMPILER_COVERAGE_MANIFEST_BEGIN__\")")).to_equal(false)

        val wrapper_builder_source = rt_file_read_text("src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl") ?? ""
        expect(wrapper_builder_source).to_contain("lines.push(\"# simple-coverage-source: \" + file_path)")
        expect(wrapper_builder_source.contains("lines.push(\"    if not rt_coverage_enabled():\")")).to_equal(false)

    it "emits a valid empty inventory and excludes the reserved runner wrapper":
        val branchless_module = parse_full_frontend("fn answer() -> i64:\n    42\n", "branchless.spl", "branchless.spl", Logger(level: 0))
        var branchless_hir_lowering = HirLowering.with_filename("branchless.spl")
        val branchless_hir = branchless_hir_lowering.lower_module(branchless_module)
        var branchless_mir_lowering = MirLowering.new(branchless_hir.symbols)
        branchless_mir_lowering.enable_coverage_inventory(true)
        branchless_mir_lowering.lower_module(branchless_hir)
        val branchless_manifest = branchless_mir_lowering.coverage_manifest_sdn()
        expect(branchless_manifest).to_equal("version: 1.0\ndecisions |id, file, line, column, true_count, false_count|\nconditions |decision_id, condition_id, file, line, column, true_count, false_count|")

        val wrapper_source = "fn authored(flag: bool) -> bool:\n    if flag:\n        true\n    else:\n        false\n\nfn __simple_cov_dump(flag: bool):\n    if not flag:\n        return\n"
        val (authored_path, recovered_source) = source_file_coverage_identity(
            "/tmp/simple_cov_branchless.spl",
            "# simple-coverage-source: src/authored_branchless.spl\n{wrapper_source}"
        )
        expect(authored_path).to_equal("src/authored_branchless.spl")
        expect(recovered_source).to_equal(wrapper_source)
        val wrapper_module = parse_full_frontend(recovered_source, authored_path, authored_path, Logger(level: 0))
        var wrapper_hir_lowering = HirLowering.with_filename(authored_path)
        val wrapper_hir = wrapper_hir_lowering.lower_module(wrapper_module)
        var wrapper_mir_lowering = MirLowering.new(wrapper_hir.symbols)
        wrapper_mir_lowering.enable_coverage_inventory(true)
        val wrapper_mir = wrapper_mir_lowering.lower_module(wrapper_hir)
        var authored_rendered = ""
        var wrapper_rendered = ""
        for function in wrapper_mir.functions.values():
            if function.name == "authored" or function.name.ends_with(".authored"):
                authored_rendered = serialize_mir_function(function)
            if function.name == "__simple_cov_dump" or function.name.ends_with(".__simple_cov_dump"):
                wrapper_rendered = serialize_mir_function(function)
        expect(authored_rendered.contains("__simple_coverage_decision_probe")).to_equal(true)
        expect(authored_rendered.contains("__simple_coverage_condition_probe")).to_equal(true)
        expect(wrapper_rendered.contains("__simple_coverage_decision_probe")).to_equal(false)
        expect(wrapper_rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
        val wrapper_manifest = wrapper_mir_lowering.coverage_manifest_sdn()
        expect(wrapper_manifest.split(", 0, 0").len()).to_equal(3)
        expect(wrapper_manifest).to_contain("src/authored_branchless.spl")
        expect(wrapper_manifest.contains("/tmp/simple_cov_branchless.spl")).to_equal(false)

    it "counts authored for and match roots without generated condition probes":
        val source = "fn counted() -> i64:\n    var total = 0\n    for i in 0..3:\n        total = total + i\n    total\n\nfn choose(value: i64) -> i64:\n    match value:\n        case 1: 10\n        case 2: 20\n        case _: 30\n"
        val (for_rendered, match_rendered, manifest) = lower_coverage_constructs(source)
        val (_, _, repeated_manifest) = lower_coverage_constructs(source)

        expect(for_rendered.split("__simple_coverage_decision_probe").len()).to_equal(2)
        expect(for_rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
        # Three authored bodies, each carrying one three-arm selection vector.
        expect(match_rendered.split("__simple_coverage_decision_probe").len()).to_equal(10)
        expect(match_rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
        expect(match_rendered).to_contain("\"value\":true")
        expect(match_rendered).to_contain("\"value\":false")
        expect(manifest).to_equal(repeated_manifest)

        var decision_ids: [text] = []
        for line in manifest.split("\n"):
            if line.contains(", coverage_constructs.spl, "):
                val fields = line.split(", ")
                decision_ids = decision_ids.push(fields[0])
        expect(decision_ids.len()).to_equal(4)
        var left = 0
        while left < decision_ids.len():
            var right = left + 1
            while right < decision_ids.len():
                expect(decision_ids[left] == decision_ids[right]).to_equal(false)
                right = right + 1
            left = left + 1

    it "retains Switch dispatch while recording one selection vector per authored body":
        val source = "fn choose(value: i64) -> i64:\n    match value:\n        case 1: 10\n        case 2: 20\n        case 3: 30\n        case 4: 40\n        case _: 50\n"
        val (rendered, manifest) = lower_coverage_function(source, "choose")
        expect(rendered).to_contain("\"Switch\"")
        expect(rendered.split("__simple_coverage_decision_probe").len()).to_equal(26)
        expect(rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
        expect(manifest.split(", coverage_route.spl, ").len()).to_equal(6)

    it "preserves authored-arm markers through enum and general fallback routes":
        val enum_source = "union Choice:\n    A(value: i64)\n    B(value: i64)\n\nfn choose(value: Choice) -> i64:\n    match value:\n        case Choice.A(v): v\n        case Choice.B(v): v\n"
        val (enum_rendered, enum_manifest) = lower_coverage_function(enum_source, "choose")
        expect(enum_rendered.split("__simple_coverage_decision_probe").len()).to_equal(5)
        expect(enum_rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
        expect(enum_manifest.split(", coverage_route.spl, ").len()).to_equal(3)

        val fallback_source = "fn choose(value: text) -> i64:\n    match value:\n        case \"yes\": 1\n        case _: 0\n"
        val (fallback_rendered, fallback_manifest) = lower_coverage_function(fallback_source, "choose")
        expect(fallback_rendered.split("__simple_coverage_decision_probe").len()).to_equal(5)
        expect(fallback_rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
        expect(fallback_manifest.split(", coverage_route.spl, ").len()).to_equal(3)

    it "uses one authored decision for range array and text for loops":
        val source = "fn range_loop() -> i64:\n    var total = 0\n    for i in 0..3:\n        total = total + i\n    total\n\nfn array_loop(values: [i64]) -> i64:\n    var total = 0\n    for value in values:\n        total = total + value\n    total\n\nfn text_loop(value: text) -> i64:\n    var total = 0\n    for ch in value:\n        total = total + 1\n    total\n"
        for target in ["range_loop", "array_loop", "text_loop"]:
            val (rendered, _) = lower_coverage_function(source, target)
            expect(rendered.split("__simple_coverage_decision_probe").len()).to_equal(2)
            expect(rendered.contains("__simple_coverage_condition_probe")).to_equal(false)
