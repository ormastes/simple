use std.spec

use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_data.*
use compiler.mir.mir.*
use compiler.common._Attributes.decl_attrs.{DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.mir._MirLowering.bootstrap_mir_store.{BootstrapMirStore, MirPublishPort, bootstrap_mir_store_with_port, BOOTSTRAP_MIR_STORE_OUTER_COUNT}

# BSM P3: the flat bootstrap MIR registries are one owner. With a session
# the per-module rows are staged while the scope runs and published
# adopt -> session-alloc append -> committed count LAST; the outer arrays are
# never walked. Without a session every add appends and promote_legacy walks
# the outer arrays exactly as the old bootstrap_mir_registries_promote did.

fn store_test_function(name: text, param_count: i64) -> MirFunction:
    var params: [MirType] = []
    var i = 0
    while i < param_count:
        params = params.push(MirType.i64())
        i = i + 1
    MirFunction(
        symbol: SymbolId(id: 0), name: name,
        signature: MirSignature(params: params, return_type: MirType.unit(), is_variadic: false),
        locals: [], blocks: [], entry_block: BlockId(id: 0), span: Span.empty(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "",
        gpu_backend_order: "", is_export_c: false, export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0,
        verification_contract: nil)

var _fake_log: [text] = []
var _fake_scope_running: bool = true
var _fake_adopt_ok: bool = true
var _fake_nodes_adopted: i64 = 0
var _fake_committed_probe: i64 = 0

fn fake_adopt_function(name: text, function: MirFunction) -> bool:
    _fake_nodes_adopted = _fake_nodes_adopted + 2
    _fake_log = _fake_log.push("adopt_fn:{name}")
    _fake_adopt_ok

fn fake_adopt_text(value: text) -> bool:
    _fake_nodes_adopted = _fake_nodes_adopted + 1
    _fake_log = _fake_log.push("adopt_text:{value}")
    _fake_adopt_ok

fn fake_alloc_begin() -> bool:
    _fake_log = _fake_log.push("alloc_begin")
    true

fn fake_alloc_end() -> bool:
    _fake_log = _fake_log.push("alloc_end")
    true

fn fake_scope_running() -> bool:
    _fake_scope_running

fn fake_session_store() -> BootstrapMirStore:
    _fake_log = []
    set_fake_scope_running(true)
    _fake_adopt_ok = true
    _fake_nodes_adopted = 0
    var store = bootstrap_mir_store_with_port(MirPublishPort(
        adopt_function: fake_adopt_function, adopt_text: fake_adopt_text,
        alloc_begin: fake_alloc_begin, alloc_end: fake_alloc_end,
        scope_running: fake_scope_running))
    store.session_on = true
    store

fn stage_module(store: BootstrapMirStore, module_index: i64, function_count: i64):
    var f = 0
    while f < function_count:
        store.add_function("m{module_index}_f{f}", store_test_function("m{module_index}_f{f}", 2), module_index, 1, false, [1, 7])
        f = f + 1
    store.add_module_statics(module_index, [module_index], [module_index], ["s{module_index}"], [1], [1], ["{module_index}"], [8], [0], [false])

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

# Module vars are only written from module-level fns (spec closures do not
# write module vars back).
fn set_fake_scope_running(value: bool):
    _fake_scope_running = value

fn set_fake_adopt_ok(value: bool):
    _fake_adopt_ok = value

# Legacy promotion runs with a real module scope paused, as in production.
fn legacy_module(store: BootstrapMirStore, module_index: i64, function_count: i64) -> bool:
    val began = rt_transient_array_scope_begin()
    stage_module(store, module_index, function_count)
    val paused = rt_transient_array_scope_pause()
    val promoted = store.publish_module()
    val ended = rt_transient_array_scope_end()
    began and paused and promoted and ended

describe "BootstrapMirStore session publish":
    it "stages rows while the scope runs and reads them through":
        var store = fake_session_store()
        stage_module(store, 0, 2)
        expect(store.has_pending).to_equal(true)
        expect(store.committed_function_count).to_equal(0)
        expect(store.functions.len()).to_equal(0)
        expect(store.function_count()).to_equal(2)
        expect(store.function_name_at(1)).to_equal("m0_f1")
        expect(store.param_type_tag_at(store.function_param_start_at(1) + 1)).to_equal(7)
        expect(store.static_count()).to_equal(1)
        expect(store.current_module_count()).to_equal(1)

    it "publishes adopt first, then appends under the session allocator":
        var store = fake_session_store()
        stage_module(store, 0, 2)
        set_fake_scope_running(false)
        expect(store.publish_module()).to_equal(true)
        expect(_fake_log[0]).to_equal("adopt_fn:m0_f0")
        expect(_fake_log[1]).to_equal("adopt_fn:m0_f1")
        expect(_fake_log[2]).to_equal("adopt_text:s0")
        expect(_fake_log[3]).to_equal("adopt_text:0")
        expect(_fake_log[4]).to_equal("alloc_begin")
        expect(_fake_log[5]).to_equal("alloc_end")
        expect(_fake_log.len()).to_equal(6)
        expect(store.has_pending).to_equal(false)
        expect(store.committed_function_count).to_equal(2)
        expect(store.committed_static_count).to_equal(1)
        expect(store.module_count).to_equal(1)
        expect(store.legacy_outer_walks).to_equal(0)
        expect(store.function_name_at(0)).to_equal("m0_f0")
        expect(store.function_param_count_at(1)).to_equal(2)
        expect(store.param_type_tag_at(store.function_param_start_at(1) + 1)).to_equal(7)
        expect(store.static_init_payload_at(0)).to_equal("0")

    it "keeps the committed count unchanged when adoption fails":
        var store = fake_session_store()
        stage_module(store, 0, 1)
        set_fake_scope_running(false)
        set_fake_adopt_ok(false)
        expect(store.publish_pending()).to_equal(false)
        expect(_fake_log.contains("alloc_begin")).to_equal(false)
        expect(store.committed_function_count).to_equal(0)
        expect(store.functions.len()).to_equal(0)

    it "discards staged rows on abort without touching committed rows":
        var store = fake_session_store()
        stage_module(store, 0, 1)
        set_fake_scope_running(false)
        expect(store.publish_module()).to_equal(true)
        set_fake_scope_running(true)
        stage_module(store, 1, 3)
        expect(store.function_count()).to_equal(4)
        store.discard_pending()
        expect(store.has_pending).to_equal(false)
        expect(store.function_count()).to_equal(1)
        expect(store.static_count()).to_equal(1)
        expect(store.current_module_count()).to_equal(1)

    it "keeps param starts consistent across several published modules":
        var store = fake_session_store()
        var m = 0
        while m < 3:
            set_fake_scope_running(true)
            stage_module(store, m, 2)
            set_fake_scope_running(false)
            expect(store.publish_module()).to_equal(true)
            m = m + 1
        expect(store.function_count()).to_equal(6)
        expect(store.function_param_start_at(5)).to_equal(10)
        expect(store.function_module_at(5)).to_equal(2)
        expect(store.module_count).to_equal(3)
        expect(store.published_modules).to_equal(3)

describe "BootstrapMirStore legacy path":
    it "appends immediately and promotes the outer owners":
        var store = fake_session_store()
        store.session_on = false
        expect(legacy_module(store, 0, 2)).to_equal(true)
        expect(store.has_pending).to_equal(false)
        expect(store.committed_function_count).to_equal(2)
        expect(store.functions.len()).to_equal(2)
        expect(store.module_count).to_equal(1)
        expect(store.legacy_outer_walks).to_equal(BOOTSTRAP_MIR_STORE_OUTER_COUNT)
        expect(_fake_log.len()).to_equal(0)

    it "appends immediately with a session when no scope is running":
        var store = fake_session_store()
        set_fake_scope_running(false)
        stage_module(store, 0, 1)
        expect(store.has_pending).to_equal(false)
        expect(store.committed_function_count).to_equal(1)

describe "BootstrapMirStore publish cost":
    it "walks outer arrays zero times on the session path, once per module on legacy":
        val modules = 40
        val per_module = 10
        var session = fake_session_store()
        var m = 0
        while m < modules:
            set_fake_scope_running(true)
            stage_module(session, m, per_module)
            set_fake_scope_running(false)
            expect(session.publish_module()).to_equal(true)
            m = m + 1
        expect(session.legacy_outer_walks).to_equal(0)
        expect(_fake_nodes_adopted).to_equal(modules * (per_module * 2 + 2))
        var legacy = fake_session_store()
        legacy.session_on = false
        m = 0
        while m < modules:
            expect(legacy_module(legacy, m, per_module)).to_equal(true)
            m = m + 1
        expect(legacy.legacy_outer_walks).to_equal(modules * BOOTSTRAP_MIR_STORE_OUTER_COUNT)
        expect(legacy.function_count()).to_equal(session.function_count())
