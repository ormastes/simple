"""Selective MIR admission refuses parser/semantic globals not in its bundle."""

use std.spec
use compiler.frontend.resource_registry.{resource_registry_reset,
    resource_registry_declare, resource_registry_note_ownership,
    resource_registry_selective_mir_safe_v1}
use compiler.semantics.rt_hal_tag.{validate_rt_hal_tags,
    rt_hal_selective_mir_safe_v1}

describe "selective MIR parser global boundaries":
    it "accepts an empty resource registry and refuses declared metadata":
        resource_registry_reset()
        expect(resource_registry_selective_mir_safe_v1()).to_equal(true)
        resource_registry_declare("Handle", "release=close;invalid=-1")
        expect(resource_registry_selective_mir_safe_v1()).to_equal(false)
        resource_registry_reset()
        expect(resource_registry_selective_mir_safe_v1()).to_equal(true)

    it "refuses ownership metadata even without a declared resource":
        resource_registry_reset()
        resource_registry_note_ownership("Handle", "atomic")
        expect(resource_registry_selective_mir_safe_v1()).to_equal(false)
        resource_registry_reset()

    it "refuses a configured RT HAL plan even without a boundary function":
        val empty_errors = validate_rt_hal_tags({})
        expect(empty_errors.len()).to_equal(0)
        expect(rt_hal_selective_mir_safe_v1()).to_equal(true)
        val configured_errors = validate_rt_hal_tags({}, "/tmp/hal-plan.sdn")
        expect(configured_errors.len()).to_equal(0)
        expect(rt_hal_selective_mir_safe_v1()).to_equal(false)
        val reset_errors = validate_rt_hal_tags({})
        expect(reset_errors.len()).to_equal(0)
        expect(rt_hal_selective_mir_safe_v1()).to_equal(true)
