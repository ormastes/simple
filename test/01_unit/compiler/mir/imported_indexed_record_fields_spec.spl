# Bug: phase2_imported_history_record_fields_2026_10_27 — indexed fields of an
# imported record array all read the FIRST field (command text came back for
# result and request_id). The record and the array are declared/built in an
# imported module; the importer binds the array from the imported call result
# and indexes it. MIR lowering now propagates the array's element struct name
# onto the decoded indexed element (expr_dispatch.spl array-index arm,
# `struct_value_syms[decoded_elem.id] = esn`) and recovers the element owner
# from the base's Array HIR type when `array_element_struct_syms` has no row
# (imported call results), fail-closed through `struct_field_order` —
# otherwise every `.field` on the element silently defaulted to field index 0.
use std.spec
use test.fixtures.compiler.phase2_native_repro.hist_rec.{HistItem, make_hist}

describe "indexed fields of an imported record array":
    it "reads every distinct field of the last element":
        val items = make_hist(500)
        val last: HistItem = items[499]
        expect(last.command).to_equal("cmd-499")
        expect(last.result).to_equal("value-499")
        expect(last.session).to_equal("session")
        expect(last.core).to_equal("core")
        expect(last.request_id).to_equal("request-499")

    it "reads distinct fields of an early element, not the first field":
        val items = make_hist(500)
        expect(items[3].command).to_equal("cmd-3")
        expect(items[3].result).to_equal("value-3")
        expect(items[3].request_id).to_equal("request-3")
        expect(items[7].result).to_equal("value-7")

    it "reads distinct fields through an explicitly typed indexed local":
        val typed: [HistItem] = make_hist(500)
        val last: HistItem = typed[499]
        expect(last.command).to_equal("cmd-499")
        expect(last.result).to_equal("value-499")
        expect(last.request_id).to_equal("request-499")
