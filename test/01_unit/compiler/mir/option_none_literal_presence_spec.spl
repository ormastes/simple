# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
`opt == None` / `opt != None` on an Optional operand is a presence test.

Stage-2 native class (mir_verify.spl check_call): `val callee_opt: T? =
fn_by_name[name]` then `if callee_opt == None: return` never returned on a
miss, and the following `callee_opt!` panicked.

The built-in `None` VALUE lowers to a fresh `rt_enum_new(1, None, 0)`
(option_none_locals) and the comparison was a raw word `Eq` against it. That
is only right when the other operand happens to be the very same None box:
a dict miss is classified into a None box whose payload is the nil word (3),
an `.first()` miss, a `nil` flowing into `T?` and a `?.` miss carry the raw
nil word itself, so `== None` was false and `!= None` true for all of them.
`opt == nil` on the same operand was already correct: it lowers to
`rt_is_none`, which classifies every None representation (the nil word, and
an Option box with the None discriminant whatever its payload) in both
runtimes. `None` is now the same presence test whenever the other operand is
statically Optional; a plain non-optional scalar never reaches it, so
`x == None` on an `i64` does not start accepting the nil word.

Bootstrap row: HIR lowered with SIMPLE_BOOTSTRAP=1 (the erasing arm), MIR
without it, as in implicit_tail_optional_return_handle_spec. Native oracle:
test/fixtures/native_option_none_equality/main.spl.
"""

use std.spec
use std.io_runtime.{env_set}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_json.{serialize_mir_function}

fn lower_module_json(src: text, bootstrap_hir: bool) -> Dict<text, text>:
    val module = parse_full_frontend(src, "none_eq.spl", "none_eq.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("none_eq.spl")
    if bootstrap_hir:
        env_set("SIMPLE_BOOTSTRAP", "1")
    val hir = hir_lowering.lower_module(module)
    if bootstrap_hir:
        env_set("SIMPLE_BOOTSTRAP", "")
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var out: Dict<text, text> = {}
    for function in mir.functions.values():
        val dot = function.name.rfind(".")
        val short = if dot >= 0: function.name.substring(dot + 1, function.name.len()) else: function.name
        out[short] = serialize_mir_function(function)
    out

val SOURCE: text = "struct F:\n    id: i64\n    name: text\n\n" +
    "fn dict_eq(d: Dict<text, F>, k: text) -> bool:\n    val o: F? = d[k]\n    o == None\n\n" +
    "fn dict_ne(d: Dict<text, F>, k: text) -> bool:\n    val o: F? = d[k]\n    o != None\n\n" +
    "fn dict_rev(d: Dict<text, F>, k: text) -> bool:\n    val o: F? = d[k]\n    None == o\n\n" +
    "fn first_eq(xs: [F]) -> bool:\n    val o: F? = xs.first()\n    o == None\n\n" +
    "fn param_eq(o: F?) -> bool:\n    o == None\n\n" +
    "fn scalar_eq(x: i64) -> bool:\n    x == None\n\n" +
    "fn guard_unwrap(d: Dict<text, F>, k: text) -> i64:\n    val o: F? = d[k]\n    if o == None:\n        return -1\n    val f: F = o!\n    f.id\n\n" +
    "fn get_eq(d: Dict<text, F>, k: text) -> bool:\n    val o: F? = d.get(k)\n    o == None\n\n" +
    "fn nil_bound_eq(hit: bool) -> bool:\n    val o: F? = if hit: Some(F(id: 1, name: \"a\")) else: nil\n    o == None\n\n" +
    "struct Holder:\n    inner: F?\n\n" +
    "fn safe_nav_eq(h: Holder?) -> bool:\n    val o: F? = h?.inner\n    o == None\n\n" +
    "fn generic_eq<T>(o: T?) -> bool:\n    o == None\n\n" +
    "fn i64_get_eq(d: Dict<text, i64>, k: text) -> bool:\n    val o: i64? = d.get(k)\n    o == None\n\n" +
    "fn i64_nil_eq(hit: bool) -> bool:\n    val o: i64? = if hit: Some(4) else: nil\n    o == None\n\n" +
    "fn text_index_eq(d: Dict<text, text>, k: text) -> bool:\n    val o: text? = d[k]\n    o == None\n"

fn expect_presence(fns: Dict<text, text>, name: text, predicate: text):
    val mir = fns[name] ?? ""
    expect(mir.len() > 0).to_equal(true)
    expect(mir).to_contain(predicate)

fn expect_all(fns: Dict<text, text>):
    expect_presence(fns, "dict_eq", "rt_is_none")
    expect_presence(fns, "dict_ne", "rt_is_some")
    expect_presence(fns, "dict_rev", "rt_is_none")
    expect_presence(fns, "first_eq", "rt_is_none")
    expect_presence(fns, "param_eq", "rt_is_none")
    expect_presence(fns, "guard_unwrap", "rt_is_none")
    expect_presence(fns, "get_eq", "rt_is_none")
    expect_presence(fns, "nil_bound_eq", "rt_is_none")
    expect_presence(fns, "safe_nav_eq", "rt_is_none")
    expect_presence(fns, "generic_eq", "rt_is_none")
    expect_presence(fns, "i64_get_eq", "rt_is_none")
    expect_presence(fns, "i64_nil_eq", "rt_is_none")
    expect_presence(fns, "text_index_eq", "rt_is_none")
    # A plain scalar can never be None: no presence test, so the nil word
    # (3) is not accepted as None there.
    val scalar = fns["scalar_eq"] ?? ""
    expect(scalar.len() > 0).to_equal(true)
    expect(scalar.contains("rt_is_none")).to_equal(false)
    expect(scalar.contains("rt_is_some")).to_equal(false)

describe "opt == None on an Optional operand tests presence":
    it "lowers to rt_is_none / rt_is_some (ordinary HIR)":
        expect_all(lower_module_json(SOURCE, false))

    it "lowers to rt_is_none / rt_is_some (bootstrap HIR)":
        expect_all(lower_module_json(SOURCE, true))
