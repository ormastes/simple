use std.io_runtime.{file_read}
use std.spec.*

describe "MIR function-local scratch reuse":
    it "reuses every safely initialized scratch container":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        val fields = [
            "local_symbol_ids", "local_symbol_values",
            "local_hir_type_ids", "local_hir_type_values",
            "bitfield_value_syms", "struct_value_syms", "runtime_array_locals",
            "runtime_dict_locals",
            "array_element_struct_syms", "runtime_value_local_ids",
            "option_value_locals", "nil_locals",
        ]
        for field in fields:
            expect(source).to_contain("self.{field}.clear()")
        expect(source).to_contain("self.local_map = {}")
        expect(source).to_contain("self.runtime_elem_value_type = {}")
