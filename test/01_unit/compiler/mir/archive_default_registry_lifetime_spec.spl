# Compatibility registry lifetime controls on actual frontend defaults.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_data.*

fn archive_registry_actual_default_function() -> HirFunction:
    val source = "fn archived_default(value: i64 = 7) -> i64:\n    value\n"
    val ast = parse_full_frontend(source, "archive_registry.spl", "archive_registry", Logger(level: 0))
    var frontend = HirLowering.with_filename("archive_registry.spl")
    val module = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    module.functions.values()[0]

describe "complete archive handoff detaches legacy expression roots":
    it "drops actual default rows while preserving callable return and parameter types":
        val function = archive_registry_actual_default_function()
        val key = "archive-registry-lifetime::default"
        bootstrap_fn_param_defaults_register(key, function.params)
        bootstrap_fn_ret_hir_type_register(key, function.return_type)
        bootstrap_fn_param_hir_types_register(key, [function.params[0].type_])
        expect(bootstrap_fn_param_defaults_lookup(key).unwrap()[0].has_default).to_equal(true)
        bootstrap_fn_param_defaults_detach_for_archive_v1()
        expect(bootstrap_fn_param_defaults_lookup(key)).to_equal(nil)
        expect(bootstrap_fn_ret_hir_type_lookup(key).unwrap().kind).to_equal(function.return_type.kind)
        expect(bootstrap_fn_param_hir_types_lookup(key).unwrap()[0].kind).to_equal(function.params[0].type_.kind)

    it "allows the ordinary prescan route to register real defaults again":
        val function = archive_registry_actual_default_function()
        val key = "archive-registry-lifetime::ordinary"
        bootstrap_fn_param_defaults_register(key, function.params)
        bootstrap_fn_param_defaults_detach_for_archive_v1()
        bootstrap_fn_param_defaults_register(key, function.params)
        val actual: HirParam = bootstrap_fn_param_defaults_lookup(key).unwrap()[0]
        expect(actual.has_default).to_equal(true)
        match actual.default.kind:
            case HirExprKind.IntLit(value, _): expect(value).to_equal(7)
            case _: panic("compatibility route lost its actual default expression")
        bootstrap_fn_param_defaults_detach_for_archive_v1()
