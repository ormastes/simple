extern fn rt_file_read_text(path: text) -> text

describe "module-global MIR static / find_global_static mirror contract":
    # Root cause fixed 2026-09-03: `find_global_static` (expr_dispatch.spl)
    # reads ONLY the i64-keyed mirror `global_statics_by_id`, but the two
    # producers of module statics never wrote it. Every module-level `var` was
    # therefore invisible to the write hook in `lower_assign_var`, and any
    # `G = x` aborted the build with "assignment target has no local binding".
    # Measured: `var G: text = ""` + `G = "abc"` reproduced it in three lines.
    #
    # Companion behavioural gate: module_dict_global_reassign_native_test.shs.
    it "mirrors every lowered module static into the i64-keyed index":
        val source = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

        # lower_static: the folded / annotated producer.
        expect(source).to_contain("self.global_statics_by_id[sym_id] = lowered_static")
        # lower_runtime_module_initializers_named: the runtime-init producer,
        # which OVERWRITES the static with the lowered initializer's type.
        expect(source).to_contain("self.global_statics_by_id[const_.symbol.id] = runtime_static")

    it "reads the mirror rather than rescanning module.statics":
        val dispatch = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""

        expect(dispatch).to_contain("if self.global_statics_by_id.contains(symbol_id):")
        expect(dispatch).to_contain("return Some(self.global_statics_by_id[symbol_id])")

    it "admits a dict-literal module initializer for runtime initialization":
        val source = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

        # Narrower second instance of the same failure message: a dict global
        # matched no arm of `runtime_module_initializer_supported`, so it never
        # received a static to mirror in the first place.
        expect(source).to_contain("case ArrayLit(_, _): true")
        expect(source).to_contain("case DictLit(_, _, _): true")

    it "reports the source location of a fatal bootstrap MIR lowering error":
        val globals = rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""

        # A bare `{err.message}` names no file/line, so a fatal on a 60-module
        # closure cost a full rebuild cycle to localize. The driver path
        # (driver_pipeline_lowering.spl) already formats the span.
        expect(globals).to_contain("bootstrap MIR lowering")
        expect(globals).to_contain("err_span.file")

    it "sanitizes windows path characters out of a global link name":
        val source = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

        # A drive colon or backslash in the owner name produced invalid LLVM IR
        # ("expected '=' in global variable"). Purely additive: it only widens
        # the set of characters already replaced by '_'.
        expect(source).to_contain("val owner_colons = owner_dashes.replace(\":\", \"_\")")
        expect(source).to_contain("val owner_safe = owner_colons.replace(\"\\\\\", \"_\")")
