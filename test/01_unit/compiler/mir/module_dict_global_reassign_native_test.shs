#!/bin/sh
# Regression gate: assigning to a module-level `var` must lower to a
# StoreGlobal, never fall through to the per-function local path.
#
# Root cause (2026-09-03): `find_global_static`
# (src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl) reads ONLY the
# i64-keyed mirror `global_statics_by_id` -- it stopped scanning
# `module.statics` to dodge the seed's struct-keyed SymbolId lookup defect --
# but neither producer of a module static (`lower_static` and
# `lower_runtime_module_initializers_named`, module_lowering.spl) ever wrote
# that mirror. So EVERY module-level `var` was invisible to the write hook in
# `lower_assign_var`, whose guard is
#     global_symbol_ids.contains(id) and find_global_static(id).?
# and every `G = x` aborted the build with
#     assignment target has no local binding
# whatever the global's type. That is the fatal that blocked
# `native-build src/app/mcp/main.spl`. A `var G: text = ""` reproduces it.
#
# A second, narrower instance of the same message: a DICT-literal global was
# not admitted by `runtime_module_initializer_supported` at all, so it never
# received a static to mirror. Both halves are covered below.
#
# This gate is behavioural on purpose -- the sibling
# `module_global_static_mirror_source_spec.spl` pins the source text, but the
# failure mode here is that a real binary does not build.
#
# Verdict line is the last line of stdout:
#   PASS  - the lowering defect is absent (and, where the host can link, the
#           binaries run and compute the real value)
#   FAIL  - a fixture reproduced "assignment target has no local binding", or
#           built and then computed the wrong value
#   ERROR - nothing was checked (no binary, no fixture built)
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
cd "$root"

verdict_error() { echo "ERROR — nothing was checked ($1)"; exit 2; }

simple=""
for cand in bin/simple bin/simple.exe; do
  if [ -x "$root/$cand" ]; then simple="$root/$cand"; break; fi
done
[ -n "$simple" ] || verdict_error "no runnable simple binary at bin/simple[.exe]"

work=$(mktemp -d 2>/dev/null || mktemp -d -t modglobal)
trap 'rm -rf "$work"' EXIT

# text_global / array_global exercise the mirror defect (these globals DO get a
# static; it was simply never mirrored). annotated / inferred additionally
# exercise the dict-literal admission.
cat > "$work/text_global.spl" <<'EOF'
var G_S: text = ""

fn setit():
    G_S = "abc"

fn main() -> i64:
    setit()
    print "value=abc-{G_S}"
    0
EOF

cat > "$work/array_global.spl" <<'EOF'
var G_ARR: [i64] = []

fn bump(v: i64):
    var d = G_ARR
    d.push(v)
    G_ARR = d

fn main() -> i64:
    bump(5)
    bump(6)
    print "value=abc-{G_ARR.len()}"
    0
EOF

cat > "$work/annotated.spl" <<'EOF'
var G_DICT: Dict<text, i64> = {}

fn bump(k: text):
    var d = G_DICT
    d[k] = 7
    G_DICT = d

fn main() -> i64:
    bump("a")
    bump("b")
    print "value=abc-{G_DICT.len()}"
    0
EOF

cat > "$work/inferred.spl" <<'EOF'
var G2 = {}

fn bump(k: text):
    var d = G2
    d[k] = 7
    G2 = d

fn main() -> i64:
    bump("a")
    bump("b")
    print "value=abc-{G2.len()}"
    0
EOF

# name:expected-stdout-fragment
fixtures='text_global:value=abc-abc array_global:value=abc-2 annotated:value=abc-2 inferred:value=abc-2'

checked=0
executed=0
failed=""
unrelated=""

for entry in $fixtures; do
  name=${entry%%:*}
  want=${entry#*:}
  exe="$work/$name.exe"
  log="$work/$name.build.log"
  set +e
  "$simple" native-build -o "$exe" "$work/$name.spl" > "$log" 2>&1
  build_rc=$?
  set -e
  checked=$((checked + 1))

  # The gated regression, whether or not this host can finish a link.
  if grep -Fq 'assignment target has no local binding' "$log"; then
    failed="$failed $name(no-local-binding)"
    continue
  fi

  if [ "$build_rc" -ne 0 ] || [ ! -f "$exe" ]; then
    # Some other build stage failed. That is NOT this gate's subject, but it
    # must never be silently reported as a pass either -- it is named in the
    # verdict so a reader can see how much was actually executed.
    unrelated="$unrelated $name"
    continue
  fi

  set +e
  "$exe" > "$work/$name.out" 2>&1
  run_rc=$?
  set -e
  executed=$((executed + 1))
  if [ "$run_rc" -ne 0 ]; then
    failed="$failed $name(run-rc=$run_rc)"
    continue
  fi
  # A placeholder/const-0 lowering would print the wrong count here, so the
  # value is checked, not merely the exit status.
  grep -Fq "$want" "$work/$name.out" ||
    failed="$failed $name(wrong-value:$(tr -d '\r\n' < "$work/$name.out"))"
done

[ "$checked" -gt 0 ] || verdict_error "no fixture was built"

if [ -n "$failed" ]; then
  echo "FAIL — $checked fixture(s) checked,$failed"
  exit 1
fi

note=""
[ -n "$unrelated" ] && note=" ($executed executed; not linkable on this host:$unrelated)"
echo "PASS — $checked fixture(s) checked, 0 module-global assignment lowering failures$note"
