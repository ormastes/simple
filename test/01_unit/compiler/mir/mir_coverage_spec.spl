use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use compiler.mir.mir_coverage.{MirCoverageModeV1, MirCoverageSiteKindV1,
    MirCoverageSourceV1, MirCoverageSiteKeyV1, MirCoverageConditionSiteV1,
    MirCoverageCatalogV1, mir_coverage_render_zero_count_sdn_v1,
    mir_coverage_site_id_v1, mir_coverage_condition_id_v1,
    mir_coverage_finalize_v1,
    mir_coverage_catalog_publication_guard_v1}
use std.test_runner.test_runner_coverage.{
    record_compiler_decision_manifest_sdn, reset_coverage_state}

fn coverage_source(path: text, source_text: text) -> MirCoverageSourceV1:
    MirCoverageSourceV1(path, sha256_text(source_text), source_text)

fn coverage_site(
    source: MirCoverageSourceV1,
    function_name: text,
    start: i64,
    end: i64,
    line: i64,
    column: i64,
    kind: MirCoverageSiteKindV1,
    occurrence: i64
) -> MirCoverageSiteKeyV1:
    MirCoverageSiteKeyV1(
        source.authored_path, source.source_sha256, function_name,
        start, end, line, column, kind, occurrence,
        sha256_text(source.source_text.substring(start, end)))

fn coverage_ok(result: Result<text, text>) -> text:
    match result:
        case Ok(value): value
        case Err(_): ""

fn coverage_error(result: Result<text, text>) -> text:
    match result:
        case Ok(_): ""
        case Err(message): message

fn catalog_ok(result: Result<MirCoverageCatalogV1, text>) -> MirCoverageCatalogV1:
    match result:
        case Ok(value): value
        case Err(_): MirCoverageCatalogV1(
            MirCoverageModeV1.Disabled, [], [], [], "", "", "", false)

fn catalog_error(result: Result<MirCoverageCatalogV1, text>) -> text:
    match result:
        case Ok(_): ""
        case Err(message): message

fn publication_error(result: Result<bool, text>) -> text:
    match result:
        case Ok(_): ""
        case Err(message): message

describe "MIR coverage V1 inventory foundation":
    it "renders a deterministic zero-count decision and condition manifest":
        val source_b = coverage_source("src/product/zeta.spl", "while ready")
        val source_a = coverage_source("src/product/alpha.spl", "if left and right")
        val decision_b = coverage_site(source_b, "product.zeta.poll", 0, 11,
            1, 1, MirCoverageSiteKindV1.WhileDecision, 0)
        val decision_a = coverage_site(source_a, "product.alpha.choose", 0, 17,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val condition_a = coverage_site(source_a, "product.alpha.choose", 3, 7,
            1, 4, MirCoverageSiteKindV1.AndCondition, 0)
        val binding = MirCoverageConditionSiteV1(decision_a, condition_a)

        val forward = coverage_ok(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions,
            [source_b, source_a], [decision_b, decision_a], [binding]))
        val reverse = coverage_ok(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions,
            [source_a, source_b], [decision_a, decision_b], [binding]))

        expect(forward).to_equal(reverse)
        expect(forward).to_contain("# Compiler MIR zero-count coverage manifest")
        expect(forward).to_contain("decisions |id, file, line, column, true_count, false_count|")
        expect(forward).to_contain("conditions |decision_id, condition_id, file, line, column, true_count, false_count|")
        expect(forward).to_contain("    1, src/product/zeta.spl, 1, 1, 0, 0")
        expect(forward).to_contain("    2, src/product/alpha.spl, 1, 1, 0, 0")
        expect(forward).to_contain("    2, 1, src/product/alpha.spl, 1, 4, 0, 0")
        expect(forward.contains("mir-v1-d-")).to_be(false)
        expect(forward.contains("mir-v1-c-")).to_be(false)
        expect(mir_coverage_site_id_v1(decision_a)).to_start_with("mir-v1-d-")
        expect(mir_coverage_site_id_v1(condition_a)).to_start_with("mir-v1-c-")

    it "binds a nested condition identity to its intended parent decision":
        val body = "if outer then if inner and ready"
        val source = coverage_source("src/product/nested.spl", body)
        val outer = coverage_site(source, "product.nested.step", 0, body.len(),
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val inner = coverage_site(source, "product.nested.step", 14, body.len(),
            1, 15, MirCoverageSiteKindV1.IfDecision, 1)
        val condition = coverage_site(source, "product.nested.step", 17, 22,
            1, 18, MirCoverageSiteKindV1.AndCondition, 0)
        val catalog = catalog_ok(mir_coverage_finalize_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [outer, inner],
            [MirCoverageConditionSiteV1(inner, condition)]))

        expect(catalog.conditions[0].semantic_id).to_equal(
            mir_coverage_condition_id_v1(inner, condition))
        expect(catalog.conditions[0].semantic_id ==
            mir_coverage_condition_id_v1(outer, condition)).to_be(false)

    it "emits decimal runtime IDs accepted by the runtime manifest parser":
        val source = coverage_source("src/product/core.spl", "if left and right")
        val decision = coverage_site(source, "product.core.step", 0, 11,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val condition = coverage_site(source, "product.core.step", 3, 7,
            1, 4, MirCoverageSiteKindV1.AndCondition, 0)
        val rendered = coverage_ok(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [decision],
            [MirCoverageConditionSiteV1(decision, condition)]))

        expect(rendered).to_contain("    1, src/product/core.spl, 1, 1, 0, 0")
        expect(rendered).to_contain("    1, 1, src/product/core.spl, 1, 4, 0, 0")
        reset_coverage_state()
        expect(record_compiler_decision_manifest_sdn(rendered)).to_be(true)
        reset_coverage_state()

    it "renders decision-only coverage and disables with no residual manifest":
        val source = coverage_source("src/product/core.spl", "if ready")
        val decision = coverage_site(source, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val enabled = coverage_ok(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [decision], []))
        val disabled = coverage_ok(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Disabled, [source], [], []))
        expect(enabled).to_contain("    1, src/product/core.spl, 1, 1, 0, 0")
        expect(disabled).to_equal("")

    it "rejects absolute traversal ambiguous and delimiter-injected paths":
        for path in ["/src/core.spl", "src/../core.spl", "src//core.spl",
                "src\\core.spl", "C:/core.spl", "src/core,spl"]:
            val source = coverage_source(path, "if ready")
            val decision = coverage_site(source, "product.core.step", 0, 8,
                1, 1, MirCoverageSiteKindV1.IfDecision, 0)
            expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
                MirCoverageModeV1.Decisions, [source], [decision], []))).to_contain("PATH")

    it "rejects source hash mismatches and non-lowercase hashes":
        val bad = MirCoverageSourceV1("src/product/core.spl",
            sha256_text("different"), "if ready")
        val decision = coverage_site(bad, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [bad], [decision], []))).to_contain("SOURCE-HASH")

        val upper = MirCoverageSourceV1("src/product/core.spl",
            "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "if ready")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Disabled, [upper], [], []))).to_contain("SOURCE-HASH")

    it "rejects duplicate source bindings and duplicate decision keys":
        val source = coverage_source("src/product/core.spl", "if ready")
        val decision = coverage_site(source, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source, source], [decision], []))).to_contain("SOURCE-DUPLICATE")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [decision, decision], []))).to_contain("DECISION-DUPLICATE")

    it "rejects missing invalid and out-of-bounds spans":
        val source = coverage_source("src/product/core.spl", "if ready")
        for bounds in [(0, 0), (-1, 2), (0, 99)]:
            val site = MirCoverageSiteKeyV1(
                source.authored_path, source.source_sha256, "product.core.step",
                bounds.0, bounds.1, 1, 1, MirCoverageSiteKindV1.IfDecision, 0,
                sha256_text(""))
            expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
                MirCoverageModeV1.Decisions, [source], [site], []))).to_contain("SITE-SPAN")

    it "rejects an anchor hash that does not identify the exact source span":
        val source = coverage_source("src/product/core.spl", "if ready")
        val site = MirCoverageSiteKeyV1(
            source.authored_path, source.source_sha256, "product.core.step",
            0, 8, 1, 1, MirCoverageSiteKindV1.IfDecision, 0,
            sha256_text("if wrong"))
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [site], []))).to_contain("SITE-ANCHOR")

    it "rejects missing and conflicting source identities":
        val source = coverage_source("src/product/core.spl", "if ready")
        val missing = coverage_source("src/product/missing.spl", "if ready")
        val missing_site = coverage_site(missing, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [missing_site], []))).to_contain("SITE-SOURCE")

        val valid = coverage_site(source, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val conflict = MirCoverageSiteKeyV1(
            valid.authored_path, sha256_text("different"), valid.canonical_function_name,
            valid.byte_start, valid.byte_end, valid.line, valid.column,
            valid.kind, valid.source_preorder_occurrence, valid.anchor_sha256)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [conflict], []))).to_contain("SITE-SOURCE")

    it "rejects wrong site kinds orphan conditions and duplicate conditions":
        val source = coverage_source("src/product/core.spl", "if left and right")
        val decision = coverage_site(source, "product.core.step", 0, 11,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val other_decision = coverage_site(source, "product.core.step", 0, 17,
            1, 1, MirCoverageSiteKindV1.IfDecision, 1)
        val condition = coverage_site(source, "product.core.step", 3, 7,
            1, 4, MirCoverageSiteKindV1.AndCondition, 0)
        val wrong_kind = coverage_site(source, "product.core.step", 3, 7,
            1, 4, MirCoverageSiteKindV1.IfDecision, 0)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [condition], []))).to_contain("SITE-KIND")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [decision],
            [MirCoverageConditionSiteV1(decision, wrong_kind)]))).to_contain("SITE-KIND")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [decision],
            [MirCoverageConditionSiteV1(other_decision, condition)]))).to_contain("CONDITION-PARENT")
        val binding = MirCoverageConditionSiteV1(decision, condition)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [decision],
            [binding, binding]))).to_contain("CONDITION-DUPLICATE")

    it "rejects cross-source cross-function and out-of-span conditions":
        val source = coverage_source("src/product/core.spl", "if left and right")
        val other_source = coverage_source("src/product/other.spl", "left")
        val decision = coverage_site(source, "product.core.step", 0, 11,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val cross_source = coverage_site(other_source, "product.core.step", 0, 4,
            1, 1, MirCoverageSiteKindV1.AndCondition, 0)
        val cross_function = coverage_site(source, "product.core.other", 3, 7,
            1, 4, MirCoverageSiteKindV1.AndCondition, 0)
        val outside = coverage_site(source, "product.core.step", 12, 17,
            1, 13, MirCoverageSiteKindV1.AndCondition, 0)

        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source, other_source],
            [decision], [MirCoverageConditionSiteV1(decision, cross_source)]))).to_contain("CONDITION-OWNER")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [decision],
            [MirCoverageConditionSiteV1(decision, cross_function)]))).to_contain("CONDITION-OWNER")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.DecisionsAndConditions, [source], [decision],
            [MirCoverageConditionSiteV1(decision, outside)]))).to_contain("CONDITION-SPAN")

    it "rejects enabled empty inventory and mode conflicts":
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [], [], []))).to_contain("EMPTY")
        val source = coverage_source("src/product/core.spl", "if left and right")
        val decision = coverage_site(source, "product.core.step", 0, 17,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val condition = coverage_site(source, "product.core.step", 3, 7,
            1, 4, MirCoverageSiteKindV1.AndCondition, 0)
        val binding = MirCoverageConditionSiteV1(decision, condition)
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Decisions, [source], [decision], [binding]))).to_contain("MODE")
        expect(coverage_error(mir_coverage_render_zero_count_sdn_v1(
            MirCoverageModeV1.Disabled, [source], [decision], []))).to_contain("MODE")

    it "finalizes one closure-global catalog independent of module discovery order":
        val source_b = coverage_source("src/product/zeta.spl", "while ready")
        val source_a = coverage_source("src/product/alpha.spl", "if left and right")
        val decision_b = coverage_site(source_b, "product.zeta.poll", 0, 11,
            1, 1, MirCoverageSiteKindV1.WhileDecision, 0)
        val decision_a = coverage_site(source_a, "product.alpha.choose", 0, 17,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val condition_a = coverage_site(source_a, "product.alpha.choose", 3, 7,
            1, 4, MirCoverageSiteKindV1.AndCondition, 0)
        val binding = MirCoverageConditionSiteV1(decision_a, condition_a)
        val forward = catalog_ok(mir_coverage_finalize_v1(
            MirCoverageModeV1.DecisionsAndConditions,
            [source_b, source_a], [decision_b, decision_a], [binding]))
        val reverse = catalog_ok(mir_coverage_finalize_v1(
            MirCoverageModeV1.DecisionsAndConditions,
            [source_a, source_b], [decision_a, decision_b], [binding]))

        expect(forward.catalog_sha256).to_equal(reverse.catalog_sha256)
        expect(forward.zero_count_sdn).to_equal(reverse.zero_count_sdn)
        expect(forward.decisions.len()).to_equal(2)
        expect(forward.decisions[0].runtime_id).to_equal(1)
        expect(forward.decisions[1].runtime_id).to_equal(2)
        expect(forward.conditions[0].decision_runtime_id).to_equal(2)
        expect(forward.conditions[0].runtime_id).to_equal(1)
        expect(forward.zero_count_sdn_sha256).to_equal(
            sha256_text(forward.zero_count_sdn))

    it "retains source identities but never source text in the finalized catalog":
        val secret_text = "if private_payload"
        val source = coverage_source("src/product/core.spl", secret_text)
        val decision = coverage_site(source, "product.core.step", 0,
            secret_text.len(), 1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val catalog = catalog_ok(mir_coverage_finalize_v1(
            MirCoverageModeV1.Decisions, [source], [decision], []))

        expect(catalog.sources.len()).to_equal(1)
        expect(catalog.sources[0].authored_path).to_equal(source.authored_path)
        expect(catalog.sources[0].source_sha256).to_equal(source.source_sha256)
        expect(catalog.zero_count_sdn.contains(secret_text)).to_be(false)
        expect(catalog.catalog_sha256.contains(secret_text)).to_be(false)

    it "rejects duplicates through the closure finalizer":
        val source = coverage_source("src/product/core.spl", "if ready")
        val decision = coverage_site(source, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        expect(catalog_error(mir_coverage_finalize_v1(
            MirCoverageModeV1.Decisions, [source, source], [decision],
            []))).to_contain("SOURCE-DUPLICATE")
        expect(catalog_error(mir_coverage_finalize_v1(
            MirCoverageModeV1.Decisions, [source], [decision, decision],
            []))).to_contain("DECISION-DUPLICATE")

    it "finalizes disabled mode as an empty nonpublishable catalog":
        val source = coverage_source("src/product/core.spl", "if ready")
        val catalog = catalog_ok(mir_coverage_finalize_v1(
            MirCoverageModeV1.Disabled, [source], [], []))
        expect(catalog.sources.len()).to_equal(0)
        expect(catalog.decisions.len()).to_equal(0)
        expect(catalog.conditions.len()).to_equal(0)
        expect(catalog.zero_count_sdn).to_equal("")
        expect(catalog.publishable).to_be(false)

    it "fails publication closed while MIR probe emission is absent":
        val source = coverage_source("src/product/core.spl", "if ready")
        val decision = coverage_site(source, "product.core.step", 0, 8,
            1, 1, MirCoverageSiteKindV1.IfDecision, 0)
        val catalog = catalog_ok(mir_coverage_finalize_v1(
            MirCoverageModeV1.Decisions, [source], [decision], []))
        expect(catalog.publishable).to_be(false)
        expect(publication_error(
            mir_coverage_catalog_publication_guard_v1(catalog))).to_contain(
                "MIRCOV-E-PROBES-ABSENT")
