"""
## Purpose and audience
Prove semantics-preserving MC/DC control-decision MIR lowering for the
compiler and coverage-infrastructure maintainers who own
`src/compiler/50.mir`. Scope: static-off suppression, static recorder
grouping of short-circuit decisions, and the dynamic capsule-protocol call
sequence, including its fail-closed configuration on `main`.
## Operator workflow
Run: ./src/compiler_rust/target/bootstrap/simple run
test/01_unit/compiler/mir/mcdc_control_lowering_spec.spl — the shared helpers
lower a two-condition `if flag and rhs()` fixture through the full frontend
under each MC/DC mode and assert on the serialized MIR of `check` / `main`.
## Compatibility and limitations
Scenarios are tagged `only-compiled`: the interpreter lane cannot resolve the
compiler-module imports, so a RED run in that lane is a lane limitation, not
a lowering defect. Assertions match serialized MIR text, which couples them
to the probe-symbol spelling.
## Verification guidance and troubleshooting
A failure means probes leaked into static-off mode, static begin/condition/end
lost the short-circuit grouping or ordering, the dynamic sequence dropped a
configure/load call, or dormancy fired without the explicit option. Each
scenario name names which contract broke.
"""
# Lifecycle: doc/01_research/domain/mcdc_rt_hal_hardening.md ;
# doc/03_plan/sys_test/mcdc_rt_hal_hardening.md ;
# doc/04_architecture/mcdc_rt_hal_hardening.md ;
# doc/05_design/app/coverage/MCDC_COVERAGE_DESIGN.md
# @manual_section: mcdc-control-lowering

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*

fn lower_mcdc_source(mode: i64) -> text:
    val source = "fn rhs() -> bool:\n    true\n\nfn check(flag: bool) -> bool:\n    if flag and rhs():\n        true\n    else:\n        false\n"
    val module = parse_full_frontend(
        source, "mcdc_logic.spl", "mcdc_logic.spl", Logger(level: 0)
    )
    var hir_lowering = HirLowering.with_filename("mcdc_logic.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.configure_mcdc_mode(mode)
    val mir = mir_lowering.lower_module(hir)
    for function in mir.functions.values():
        if function.name == "check" or function.name.ends_with(".check"):
            return serialize_mir_function(function)
    ""

fn lower_mcdc_main(mode: i64, dynamic_dormant: bool = false) -> text:
    val module = parse_full_frontend(
        "fn main() -> i64:\n    0\n", "mcdc_main.spl", "mcdc_main.spl",
        Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("mcdc_main.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.configure_mcdc_mode(
        mode, dynamic_dormant: dynamic_dormant)
    val mir = mir_lowering.lower_module(hir)
    for function in mir.functions.values():
        if function.name == "main" or function.name.ends_with(".main"):
            return serialize_mir_function(function)
    ""

describe "MC/DC control-decision MIR lowering", tag: ["only-compiled"]:
    it "emits no probes in static-off mode":
        # @req REQ-MCDC-STATIC-OFF-001
        # @capture(statistics): probe-symbol occurrence count in the static-off MIR
        step("Verify: static-off has no MIR instrumentation")
        val mir = lower_mcdc_source(0)
        expect(mir.contains("DecisionProbe")).to_equal(false)
        expect(mir.contains("ConditionProbe")).to_equal(false)

    it "groups evaluated logical leaves under one static recorder decision":
        # @req REQ-MCDC-SHORT-CIRCUIT-002
        # @capture(statistics): begin/condition/end probe counts and operand ordering
        step("Verify: static begin/condition/end preserve short-circuit grouping")
        val mir = lower_mcdc_source(1)
        expect(mir.split("mcdc_static_probe_begin").len()).to_equal(2)  # oracle: one begin probe means one split piece before plus one after
        expect(mir.split("mcdc_static_probe_condition").len()).to_equal(3)  # oracle: two leaf conditions in the `flag and rhs()` decision, so two probes plus the tail piece
        expect(mir.split("mcdc_static_probe_end").len()).to_equal(2)  # oracle: the recorder closes the single decision exactly once
        expect(mir.contains("mcdc_static_probe_mask_range")).to_equal(true)
        val rhs_block = mir.index_of("logic_rhs")
        val rhs_call = mir.index_of("rhs")
        val rhs_probe = mir.last_index_of("mcdc_static_probe_condition")
        expect(rhs_call).to_be_greater_than(rhs_block)
        expect(rhs_probe).to_be_greater_than(rhs_call)  # oracle: the leaf probe must be emitted after the short-circuit call it records

    it "uses the pinned Pure-Simple capsule protocol in dynamic mode":
        # @req REQ-MCDC-SHORT-CIRCUIT-002
        # @capture(statistics): begin/condition/end call ordering in the dynamic MIR
        step("Verify: dynamic begin/condition/end calls bracket one decision")
        val mir = lower_mcdc_source(2)
        val begin_pos = mir.index_of("mcdc_dynamic_probe_begin")
        val first_condition = mir.index_of("mcdc_dynamic_probe_condition")
        val end_pos = mir.index_of("mcdc_dynamic_probe_end")
        expect(begin_pos).to_be_greater_than(-1)
        expect(first_condition).to_be_greater_than(begin_pos)
        expect(end_pos).to_be_greater_than(first_condition)
        expect(mir.contains("DecisionProbe")).to_equal(false)
        expect(mir.contains("ConditionProbe")).to_equal(false)

    it "cold-loads and fails closed for an explicitly selected dynamic main":
        # @req REQ-MCDC-STATIC-OFF-001
        # @capture(statistics): configure-before-load call ordering in main's MIR
        step("Lower a dynamic-mode main and check the fail-closed load sequence")
        val mir = lower_mcdc_main(2)
        val configure = mir.index_of("mcdc_dynamic_probe_configure")
        val load = mir.index_of("mcdc_dynamic_probe_controller_load_builtin_current_owner_or_fail")
        expect(configure).to_be_greater_than(-1)
        expect(load).to_be_greater_than(configure)

    it "keeps dynamic configuration dormant only under the explicit option":
        # @req REQ-MCDC-STATIC-OFF-001
        # @capture(statistics): configure/load presence under the dormant option
        step("Lower main with the dormant flag and check the load call is withheld")
        val mir = lower_mcdc_main(2, dynamic_dormant: true)
        expect(mir.contains("mcdc_dynamic_probe_configure")).to_equal(true)
        expect(mir.contains("mcdc_dynamic_probe_controller_load_builtin_current_owner_or_fail")).to_equal(false)

    it "keeps static main configuration and omits all off-mode setup":
        # @req REQ-MCDC-STATIC-OFF-001
        # @capture(statistics): configure-symbol presence per MC/DC mode
        step("Lower static-mode main and off-mode main and compare their setup")
        expect(lower_mcdc_main(1).contains("mcdc_static_probe_configure_bytes")).to_equal(true)
        val off = lower_mcdc_main(0)
        expect(off.contains("mcdc_static_probe_configure_bytes")).to_equal(false)
        expect(off.contains("mcdc_dynamic_probe_configure")).to_equal(false)
