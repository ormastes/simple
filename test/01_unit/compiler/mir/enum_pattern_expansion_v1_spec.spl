# Direct public helper fixtures use a fresh real lowerer and begun MIR function.
# These check expansion only, not source semantic admission. Execution: UNRUN.
use std.spec.{describe, it, expect}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId, SymbolTable, HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirPattern, HirPatternKind, HirPatternPayload, HirExpr, HirExprKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_types.{MirSignature, MirType}
use compiler.mir._MirLoweringExpr.enum_pattern_expansion_v1.*

fn epe_lowerer() -> MirLowering:
    var lowering = MirLowering.new(SymbolTable.new())
    lowering.enum_semantic_capture_enabled = true
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 901), "expand",
        MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        Span.empty())
    lowering.builder = builder
    lowering

fn epe_pattern(kind: HirPatternKind) -> HirPattern:
    HirPattern(kind: kind, has_type_: true,
        type_: HirType(kind: HirTypeKind.Named(SymbolId(id: 701), []), span: Span.empty()),
        span: Span.new(17, 29, 3, 5))

fn epe_literal(value: i64) -> HirPattern:
    epe_pattern(HirPatternKind.Literal(HirExpr(kind: HirExprKind.IntLit(value, nil),
        has_type_: false, type_: nil, span: Span.new(value, value + 1, 1, 1))))

fn epe_shape(pattern: HirPattern) -> text:
    match pattern.kind:
        case HirPatternKind.Wildcard: "_"
        case HirPatternKind.Binding(symbol, mutable):
            "b{symbol.id}:{mutable}"
        case HirPatternKind.Literal(value):
            match value.kind:
                case HirExprKind.IntLit(integer, _): integer.to_string()
                case _: "unexpected_literal"
        case HirPatternKind.Tuple(children):
            var parts: [text] = []
            for child in children: parts.push(epe_shape(child))
            "(" + parts.join(",") + ")"
        case HirPatternKind.Or(_): "unexpanded_Or"
        case HirPatternKind.Enum(_, variant, payload):
            if payload == nil: return variant
            match payload.unwrap():
                case HirPatternPayload.Tuple(children):
                    var parts: [text] = []
                    for child in children: parts.push(epe_shape(child))
                    variant + "[" + parts.join(",") + "]"
                case HirPatternPayload.Struct(fields):
                    var parts: [text] = []
                    for field in fields: parts.push(field.0 + "=" + epe_shape(field.1))
                    variant + "[" + parts.join(",") + "]"
        case _: "unsupported"

fn epe_shapes(patterns: [HirPattern]) -> [text]:
    var result: [text] = []
    for pattern in patterns: result.push(epe_shape(pattern))
    result

fn epe_failure(result: Result<[HirPattern], text>) -> text:
    match result:
        case Err(message): message
        case Ok(_): "unexpected acceptance"

describe "EE-01 nested Or source-pattern expansion":
    it "expands nested tuple products in leftmost-slot-major order":
        val left = epe_pattern(HirPatternKind.Or([epe_literal(1), epe_literal(2)]))
        val right = epe_pattern(HirPatternKind.Or([epe_literal(10), epe_literal(20)]))
        val tuple = epe_pattern(HirPatternKind.Tuple([left, right]))
        val source = epe_pattern(HirPatternKind.Enum(tuple.type_, "Wrap",
            Some(HirPatternPayload.Tuple([tuple]))))
        val before = epe_shape(source)
        var lowering = epe_lowerer()
        val expanded = lowering.enum_semantic_expand_pattern_v1(source, 1).unwrap()
        expect(epe_shapes(expanded)).to_equal(["Wrap[(1,10)]", "Wrap[(1,20)]",
            "Wrap[(2,10)]", "Wrap[(2,20)]"])
        expect(epe_shape(source)).to_equal(before)
        expect(expanded[0].has_type_).to_equal(true)
        expect(expanded[0].span.start).to_equal(17)
        expect(expanded[0].span.end).to_equal(29)
        match expanded[0].type_.kind:
            case HirTypeKind.Named(symbol, _): expect(symbol.id).to_equal(701)
            case _: expect("lost named annotation").to_equal("Named")

    it "preserves named field order and actual binding symbols":
        val choice = epe_pattern(HirPatternKind.Or([epe_literal(7), epe_literal(8)]))
        val binding = epe_pattern(HirPatternKind.Binding(SymbolId(id: 123), true))
        val source = epe_pattern(HirPatternKind.Enum(choice.type_, "Record",
            Some(HirPatternPayload.Struct([("left", choice), ("right", binding)]))))
        var lowering = epe_lowerer()
        val expanded = lowering.enum_semantic_expand_pattern_v1(source, 1).unwrap()
        expect(epe_shapes(expanded)).to_equal(["Record[left=7,right=b123:true]",
            "Record[left=8,right=b123:true]"])
        expect(epe_shape(source)).to_equal("Record[left=unexpanded_Or,right=b123:true]")

    it "flattens nested Or alternatives without changing their order":
        val inner = epe_pattern(HirPatternKind.Or([epe_literal(2), epe_literal(3)]))
        val source = epe_pattern(HirPatternKind.Or([epe_literal(1), inner]))
        var lowering = epe_lowerer()
        expect(epe_shapes(lowering.enum_semantic_expand_pattern_v1(source, 1).unwrap())).to_equal(["1", "2", "3"])

    it "keeps the single empty product and absent enum payload distinct":
        var lowering = epe_lowerer()
        val empty_tuple = epe_pattern(HirPatternKind.Tuple([]))
        val absent = epe_pattern(HirPatternKind.Enum(empty_tuple.type_, "End", nil))
        val present = epe_pattern(HirPatternKind.Enum(empty_tuple.type_, "Empty",
            Some(HirPatternPayload.Tuple([]))))
        expect(epe_shapes(lowering.enum_semantic_expand_pattern_v1(empty_tuple, 1).unwrap())).to_equal(["()"])
        expect(epe_shapes(lowering.enum_semantic_expand_pattern_v1(absent, 1).unwrap())).to_equal(["End"])
        expect(epe_shapes(lowering.enum_semantic_expand_pattern_v1(present, 1).unwrap())).to_equal(["Empty[]"])

    it "rejects missing empty erroneous and unsupported pattern forms":
        var lowering = epe_lowerer()
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(nil, 1))).to_start_with("EE-E-PATTERN:")
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(epe_pattern(HirPatternKind.Or([])), 1))).to_start_with("EE-E-PATTERN:")
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(epe_pattern(HirPatternKind.Error), 1))).to_start_with("EE-E-PATTERN:")
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(epe_pattern(HirPatternKind.Array([], nil)), 1))).to_start_with("EE-E-PATTERN:")

    it "accepts the depth boundary and refuses a child beyond it":
        var lowering = epe_lowerer()
        val leaf = epe_pattern(HirPatternKind.Wildcard)
        expect(epe_shapes(lowering.enum_semantic_expand_pattern_v1(leaf, 128).unwrap())).to_equal(["_"])
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(leaf, 129))).to_start_with("EE-E-LIMIT:")
        val nested = epe_pattern(HirPatternKind.Or([leaf]))
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(nested, 128))).to_start_with("EE-E-LIMIT:")

    it "charges the same function budget before publishing even a leaf":
        var lowering = epe_lowerer()
        lowering.enum_semantic_function_work[901] = 65535
        val source = epe_pattern(HirPatternKind.Binding(SymbolId(id: 321), false))
        val result = lowering.enum_semantic_expand_pattern_v1(source, 1)
        expect(epe_failure(result)).to_start_with("EE-E-LIMIT:")
        expect(lowering.enum_semantic_function_work[901]).to_equal(65536)
        expect(epe_shape(source)).to_equal("b321:false")

    it "bounds Cartesian growth without allocating the complete product":
        var slots: [HirPattern] = []
        for index in 0..20:
            slots.push(epe_pattern(HirPatternKind.Or([epe_literal(0), epe_literal(1)])))
        val source = epe_pattern(HirPatternKind.Tuple(slots))
        var lowering = epe_lowerer()
        expect(epe_failure(lowering.enum_semantic_expand_pattern_v1(source, 1))).to_start_with("EE-E-LIMIT:")
        expect(lowering.enum_semantic_function_work[901]).to_equal(65536)
        match source.kind:
            case HirPatternKind.Tuple(children):
                expect(children.len()).to_equal(20)
                expect(epe_shape(children[0])).to_equal("unexpanded_Or")
            case _: expect("changed source").to_equal("Tuple")

    it "retains work already spent by an earlier expansion in the function":
        var lowering = epe_lowerer()
        val leaf = epe_pattern(HirPatternKind.Wildcard)
        lowering.enum_semantic_expand_pattern_v1(leaf, 1).unwrap()
        val first = lowering.enum_semantic_function_work[901]
        lowering.enum_semantic_expand_pattern_v1(leaf, 1).unwrap()
        expect(lowering.enum_semantic_function_work[901]).to_be_greater_than(first)
