# @req: REQ-COMPILER-HIR-DESTINATION-MIR-001
extern fn rt_file_read_text(path: text) -> text

describe "destination HIR graph to MIR scalar consumer":
    it "uses frozen scalar receipts and retains failures for diagnostics":
        val receipt = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_receipt.spl") ?? ""
        expect(receipt).to_contain("hdr_function_root(slot, generation, function_row)")
        expect(receipt).to_contain("hdr_function_token(slot, generation, function_row)")
        expect(receipt).to_contain("hdr_function_module(slot, generation, function_row)")
        expect(receipt).to_contain("hdr_token_active(slot, generation, token)")
        expect(receipt).to_contain("hdr_release_function(r.slot, r.generation, r.token)")
        expect(receipt.contains("HirExpr")).to_equal(false)
        expect(receipt.contains("HirStmt")).to_equal(false)
        expect(receipt.contains("HirBlock")).to_equal(false)
        expect(receipt.contains("HirType")).to_equal(false)

    it "covers every dense schema family including shared GPU and BlockValue":
        val dispatch = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_dispatch.spl") ?? ""
        expect(dispatch).to_contain("shape >= HD_EXPR_INT and shape <= HD_EXPR_RESOLVED_FIELD")
        expect(dispatch).to_contain("shape >= HD_STMT_EXPR and shape <= HD_STMT_GPU_LAUNCH")
        expect(dispatch).to_contain("shape >= HD_TYPE_INT and shape <= HD_TYPE_QUALIFIED_DYN_TRAIT")
        expect(dispatch).to_contain("shape >= HD_PATTERN_WILDCARD and shape <= HD_PATTERN_AS")
        expect(dispatch).to_contain("shape >= HD_BV_EXPR and shape <= HD_BV_ERROR")

    it "validates function rows once without graph copies or generic selectors":
        val validation = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_validation.spl") ?? ""
        expect(validation).to_contain("fn mir_destination_function_graph_supported")
        expect(validation).to_contain("hdr_block_stmt_range")
        expect(validation).to_contain("hdr_function_return_type")
        expect(validation.contains("HirDestinationGraph")).to_equal(false)
        expect(validation.contains("owner.functions")).to_equal(false)

    it "releases all active tokens only after module-wide MIR success":
        val lifetime = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_module_lifetime.spl") ?? ""
        expect(lifetime).to_contain("if lowering_failed")
        expect(lifetime).to_contain("if lowered_function_count != count: return false")
        expect(lifetime).to_contain("# Preflight prevents a stale row from causing a partial release.")
        expect(lifetime).to_contain("mir_destination_release_function_once(active)")
        expect(lifetime.contains("[MirDestinationFunctionReceipt]")).to_equal(false)

    it "lowers destination type rows without materializing HIR types":
        val types = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_types.spl") ?? ""
        expect(types).to_contain("fn mir_destination_lower_type")
        expect(types).to_contain("HD_TYPE_QUALIFIED_DYN_TRAIT")
        expect(types).to_contain("MirTypeKind.FuncPtr")
        expect(types).to_contain("MirTypeKind.Result")
        expect(types.contains("HirType")).to_equal(false)

    it "routes graph receipts while preserving the flat MIR path":
        val globals = rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""
        val driver = rt_file_read_text("src/compiler/80.driver/driver_bootstrap.spl") ?? ""
        expect(globals).to_contain("fn bootstrap_lower_destination_hir_modules_to_mir_for_target")
        expect(globals).to_contain("# Lower the complete frozen compile before releasing any HIR token.")
        expect(globals).to_contain("# Compile-wide preflight prevents an avoidable partial release.")
        expect(driver).to_contain("val graph_route = entry_index >= 0 and bootstrap_hir_module_graph_mode(entry_index)")
        expect(driver).to_contain("bootstrap_lower_destination_hir_modules_to_mir_for_target")
        expect(driver).to_contain("bootstrap_lower_flat_hir_modules_to_mir_for_target")

    it "aggregates module-local declarations without flattening SymbolId keys":
        val globals = rt_file_read_text("src/compiler/50.mir/_MirLowering/bootstrap_globals.spl") ?? ""
        val preflight = rt_file_read_text("src/compiler/70.backend/backend/common/declaration_preflight.spl") ?? ""
        expect(globals).to_contain("mir_append_declaration_shard")
        expect(globals).to_contain("declaration_aggregate.declaration_shards")
        expect(globals).to_contain("declaration_aggregate.declaration_shard_index")
        expect(globals).to_contain("bootstrap_mir_destination_qualified_name")
        expect(globals).to_contain("bootstrap_mir_destination_name_reserve")
        expect(preflight).to_contain("backend_declaration_shard_preflight")
        expect(preflight).to_contain("for shard in module.declaration_shards")

    it "emits functions blocks and statements through scalar row readers":
        val functions = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_function_emit.spl") ?? ""
        val statements = rt_file_read_text("src/compiler/50.mir/_MirLowering/hir_destination_stmt_emit.spl") ?? ""
        expect(functions).to_contain("me lower_destination_function")
        expect(functions).to_contain("self.lower_destination_root_block(r, return_type)")
        expect(statements).to_contain("me lower_destination_stmt_row")
        expect(statements).to_contain("HD_STMT_SHARED_VAL")
        expect(statements).to_contain("HD_STMT_GPU_LAUNCH")
        expect(functions.contains("HirFunction")).to_equal(false)
        expect(statements.contains("HirStmt")).to_equal(false)
