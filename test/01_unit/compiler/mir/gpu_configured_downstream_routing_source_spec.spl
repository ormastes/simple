# @tag: unit, compiler, mir, gpu, source-contract
use std.spec.*
use std.io_runtime.{read_file_text}

fn downstream_source(path: text) -> text:
    read_file_text(path)

fn expect_gpu_configured_routes(path: text):
    val source = downstream_source(path)
    expect(source).to_contain("GpuLaunchConfigured")
    expect(source).to_contain("GpuSharedAllocInit")
    expect(source).not_to_contain("case GpuLaunchConfigured(_, _, _): ()")
    expect(source).not_to_contain("case GpuSharedAllocInit(_, _, _, _): ()")

describe "configured GPU MIR downstream routing source contract":
    it "should keep both payload-bearing variants visible to MIR core consumers":
        step("Inspect the canonical MIR variants and semantic identity owner")
        val kinds = downstream_source("src/compiler/50.mir/mir_instruction_kinds.spl")
        val coverage = downstream_source("src/compiler/50.mir/verification_semantic_coverage.spl")
        val names = downstream_source("src/compiler/70.backend/backend/common/mir_inst_variant_name.spl")
        expect(kinds).to_contain("GpuLaunchConfigured(grid: [MirOperand], block: [MirOperand], body: BlockId)")
        expect(kinds).to_contain("GpuSharedAllocInit(dest: LocalId, type_: MirType, size: i64, init: MirOperand)")
        expect(coverage).to_contain("case GpuLaunchConfigured(")
        expect(coverage).to_contain("case GpuSharedAllocInit(")
        expect(names).to_contain("case GpuLaunchConfigured(")
        expect(names).to_contain("case GpuSharedAllocInit(")
        expect(names).to_contain(": \"GpuLaunchConfigured\"")
        expect(names).to_contain(": \"GpuSharedAllocInit\"")

    it "should route both variants through every predecessor MIR and backend dispatcher":
        step("Inspect all consumers that dispatch legacy GPU launch or shared allocation")
        val consumers = [
            "src/compiler/60.mir_opt/mir_opt/perf_facts.spl",
            "src/plugins/backend_c/_CBackendTranslate/instruction_lowering.spl",
            "src/compiler/70.backend/backend/common/mir_text_codegen.spl",
            "src/plugins/backend_cuda/cuda_backend.spl",
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl",
            "src/compiler/70.backend/backend/native/isel_x86_64.spl",
            "src/plugins/backend_opencl/opencl_backend.spl",
            "src/plugins/backend_vhdl/vhdl/vhdl_kernel_entity.spl",
            "src/plugins/backend_vulkan/vulkan_backend.spl",
            "src/compiler/95.interp/mir_interpreter.spl"
        ]
        for path in consumers:
            expect_gpu_configured_routes(path)

    it "should route initialized shared allocation through C destination prepasses":
        step("Inspect the stack-slot prepasses without requiring launch execution there")
        val prepasses = [
            "src/plugins/backend_c/_CBackendTranslate/class_core.spl",
            "src/plugins/backend_c/c_backend_translate_ops.spl"
        ]
        for path in prepasses:
            val source = downstream_source(path)
            expect(source).to_contain("case GpuSharedAllocInit(")
            expect(source).not_to_contain("case GpuSharedAllocInit(_, _, _, _): ()")

    it "should encode every configured launch and initialized allocation payload losslessly":
        step("Inspect MIR JSON payload field encoding")
        val json = downstream_source("src/compiler/50.mir/mir_json.spl")
        expect(json).to_contain("case GpuLaunchConfigured(grid, block, body):")
        expect(json).to_contain("for dimension in grid:")
        expect(json).to_contain("for dimension in block:")
        expect(json).to_contain("serialize_operand(dimension)")
        expect(json).to_contain("block_id_value(body)")
        expect(json).to_contain("case GpuSharedAllocInit(dest, element_type, size, init):")
        expect(json).to_contain("type_json = serialize_mir_type(element_type)")
        expect(json).to_contain("init_json = serialize_operand(init)")
        expect(json).to_contain("local_id_value(dest)")

    it "should expose configured GPU definitions and uses to optimizer analyses":
        step("Inspect visitor, def-use, destination, and performance-fact consumers")
        val optimizer_consumers = [
            "src/compiler/60.mir_opt/mir_opt/mir_visitor.spl",
            "src/compiler/60.mir_opt/mir_opt/auto_vectorize_analysis.spl",
            "src/compiler/60.mir_opt/mir_opt/generator_sm.spl",
            "src/compiler/60.mir_opt/mir_opt/perf_facts.spl"
        ]
        for path in optimizer_consumers:
            val source = downstream_source(path)
            expect(source).to_contain("GpuSharedAllocInit")
        val visitor = downstream_source("src/compiler/60.mir_opt/mir_opt/mir_visitor.spl")
        val def_use = downstream_source("src/compiler/60.mir_opt/mir_opt/auto_vectorize_analysis.spl")
        val facts = downstream_source("src/compiler/60.mir_opt/mir_opt/perf_facts.spl")
        expect(visitor).to_contain("case GpuLaunchConfigured(grid, block, _):")
        expect(visitor).to_contain("visitor.visit_operand(init)")
        expect(def_use).to_contain("case GpuLaunchConfigured(grid, block, _):")
        expect(def_use).to_contain("case GpuSharedAllocInit(_, _, _, init):")
        expect(facts).to_contain("case GpuLaunchConfigured(grid, block, _):")
        expect(facts).to_contain("case GpuSharedAllocInit(dest, _, _, init):")

    it "should retain configured launch bodies as structured region CFG edges":
        step("Inspect the shared region-target and successor authorities")
        val facts = downstream_source("src/compiler/60.mir_opt/mir_opt/perf_facts.spl")
        expect(facts).to_contain("fn perf_facts_instruction_region_target(inst: MirInst) -> BlockId?:")
        expect(facts).to_contain("case GpuLaunchConfigured(_, _, body): Some(body)")
        expect(facts).to_contain("region_target = perf_facts_instruction_region_target(instruction)")
        expect(facts).to_contain("block_successors.push(target)")
        expect(facts).to_contain("successors[block.id.id] = block_successors")
        expect(facts).not_to_contain("case GpuLaunchConfigured(_, _, _): nil")

    it "should reject configured launch bodies that target missing MIR blocks":
        step("Inspect MIR validation and stable diagnostic classification")
        val validation = downstream_source("src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(validation).to_contain("case GpuLaunchConfigured(_, _, body):")
        expect(validation).to_contain("if not block_ids.has(body.id):")
        expect(validation).to_contain("GPU region targets missing block")
        expect(validation).to_contain("if message.contains(\" targets missing block \"): return \"MIRV019\"")

    it "should register both append-only MIR variants in the closed schema":
        step("Inspect registry count, stable IDs, and payload schemas")
        val registry = downstream_source("spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn")
        expect(registry).to_contain("variant_count: 128")
        expect(registry).to_contain("id: spl:variant@compiler.mir.MirInstKind.GpuLaunchConfigured")
        expect(registry).to_contain("payload_schema: GpuLaunchConfigured(grid: [MirOperand], block: [MirOperand], body: BlockId)")
        expect(registry).to_contain("id: spl:variant@compiler.mir.MirInstKind.GpuSharedAllocInit")
        expect(registry).to_contain("payload_schema: GpuSharedAllocInit(dest: LocalId, type_: MirType, size: i64, init: MirOperand)")

    it "should mark all non-GPU execution transition tables explicitly unsupported":
        step("Inspect C, LLVM, native instruction selection, and interpreter transitions")
        val transitions = [
            "spec/compiler_schema/transitions/mir_inst_to_c_backend.sdn",
            "spec/compiler_schema/transitions/mir_inst_to_llvm.sdn",
            "spec/compiler_schema/transitions/mir_inst_to_native_isel.sdn",
            "spec/compiler_schema/transitions/mir_inst_to_interp.sdn"
        ]
        for path in transitions:
            val source = downstream_source(path)
            expect(source).to_contain("from: MirInstKind.GpuLaunchConfigured")
            expect(source).to_contain("from: MirInstKind.GpuSharedAllocInit")
            expect(source).to_contain("state: unsupported")
            expect(source).to_contain("GpuLaunchConfigured\"")
            expect(source).to_contain("GpuSharedAllocInit\"")

    it "should diagnose configured GPU instructions in non-GPU execution consumers":
        step("Inspect interpreter, native x86, and C fail-closed routes")
        val interpreter = downstream_source("src/compiler/95.interp/mir_interpreter.spl")
        val native = downstream_source("src/compiler/70.backend/backend/native/isel_x86_64.spl")
        val c_backend = downstream_source("src/plugins/backend_c/_CBackendTranslate/instruction_lowering.spl")
        expect(interpreter).to_contain("_unsupported_inst(\"GpuLaunchConfigured\"")
        expect(interpreter).to_contain("_unsupported_inst(\"GpuSharedAllocInit\"")
        expect(native).to_contain("x86_unsupported_inst(ctx, \"GpuLaunchConfigured\"")
        expect(native).to_contain("x86_unsupported_inst(ctx, \"GpuSharedAllocInit\"")
        expect(c_backend).to_contain("_unsupported_c_inst(\"GpuLaunchConfigured\", inst.span)")
        expect(c_backend).to_contain("_unsupported_c_inst(\"GpuSharedAllocInit\", inst.span)")

    it "should preserve named diagnostics for unsupported VHDL payloads":
        step("Inspect VHDL rejection messages for both payload-bearing variants")
        val vhdl = downstream_source("src/plugins/backend_vhdl/vhdl/vhdl_kernel_entity.spl")
        expect(vhdl).to_contain("case GpuLaunchConfigured(")
        expect(vhdl).to_contain("GpuLaunchConfigured is a host launch instruction")
        expect(vhdl).to_contain("case GpuSharedAllocInit(")
        expect(vhdl).to_contain("GpuSharedAllocInit is not supported")

    it "should never encode either new variant as an intentional silent no-op":
        step("Inspect all downstream compiler sources for forbidden empty routes")
        val consumers = [
            "src/compiler/50.mir/verification_semantic_coverage.spl",
            "src/compiler/60.mir_opt/mir_opt/perf_facts.spl",
            "src/plugins/backend_c/_CBackendTranslate/instruction_lowering.spl",
            "src/compiler/70.backend/backend/common/mir_inst_variant_name.spl",
            "src/compiler/70.backend/backend/common/mir_text_codegen.spl",
            "src/plugins/backend_cuda/cuda_backend.spl",
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl",
            "src/compiler/70.backend/backend/native/isel_x86_64.spl",
            "src/plugins/backend_opencl/opencl_backend.spl",
            "src/plugins/backend_vhdl/vhdl/vhdl_kernel_entity.spl",
            "src/plugins/backend_vulkan/vulkan_backend.spl",
            "src/compiler/95.interp/mir_interpreter.spl"
        ]
        for path in consumers:
            val source = downstream_source(path)
            expect(source).not_to_contain("GpuLaunchConfigured(_, _, _): ()")
            expect(source).not_to_contain("GpuSharedAllocInit(_, _, _, _): ()")
