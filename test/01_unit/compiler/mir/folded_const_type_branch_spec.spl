# @req bootstrap_stage3_folded_module_const_type_2026_08_14
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirExpr, HirExprKind, HirType, HirTypeKind, HirBinOp}
use compiler.mir.mir_data.{MirConstValue, MirType, MirTypeKind}
use compiler.mir.mir_lowering.{mir_folded_const_type}

fn span0() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1, file: "folded.spl", length: 0)

fn hir_i64() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: span0())

fn int_expr(value: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: true,
        type_: hir_i64(), span: span0())

fn type_label(value: MirType?) -> text:
    match value:
        case Some(type_):
            match type_.kind:
                case MirTypeKind.I64: "i64"
                case MirTypeKind.F64: "f64"
                case MirTypeKind.Bool: "bool"
                case MirTypeKind.Opaque(name): "opaque:" + name
                case _: "other"
        case _: "nil"

describe "folded module constant type branch matrix":
    it "covers every authoritative HIR scalar and binary branch":
        val binary = HirExprKind.Binary(HirBinOp.Add, int_expr(1), int_expr(2))
        expect(type_label(mir_folded_const_type(HirExprKind.IntLit(0, nil), MirConstValue.Zero))).to_equal("i64")
        expect(type_label(mir_folded_const_type(HirExprKind.FloatLit(2.5, nil), MirConstValue.Zero))).to_equal("f64")
        expect(type_label(mir_folded_const_type(HirExprKind.BoolLit(true), MirConstValue.Zero))).to_equal("bool")
        expect(type_label(mir_folded_const_type(HirExprKind.StringLit("x", nil), MirConstValue.Zero))).to_equal("opaque:str")
        expect(type_label(mir_folded_const_type(binary, MirConstValue.Zero))).to_equal("i64")

    it "covers every folded-value compatibility and rejection branch":
        val other = HirExprKind.NilLit
        expect(type_label(mir_folded_const_type(other, MirConstValue.Int(1)))).to_equal("i64")
        expect(type_label(mir_folded_const_type(other, MirConstValue.Float(1.0)))).to_equal("f64")
        expect(type_label(mir_folded_const_type(other, MirConstValue.Bool(false)))).to_equal("bool")
        expect(type_label(mir_folded_const_type(other, MirConstValue.Str("x")))).to_equal("opaque:str")
        expect(type_label(mir_folded_const_type(other, MirConstValue.Zero))).to_equal("i64")
        expect(type_label(mir_folded_const_type(other, MirConstValue.Array([])))).to_equal("nil")
