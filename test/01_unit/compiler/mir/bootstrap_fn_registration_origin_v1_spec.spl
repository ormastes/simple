# Actual frontend registration/lifetime controls. Constructed binding metadata
# is mechanics-only; no retained repository or SOURCE admission is fabricated.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.mir.hir_declaration_types_v1.*
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn origin_actual_declaration_fixture_v1() -> MirHirModuleDeclarationsV1:
    val source = "fn actual_origin(value: i64) -> i64:\n    value\n"
    val ast = parse_full_frontend(source, "origin_fixture.spl", "origin_fixture", Logger(level: 0))
    var frontend = HirLowering.with_filename("origin_fixture.spl")
    val actual = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    val function: HirFunction = actual.functions.values()[0]
    var params: [MirHirParamDeclarationV1] = []
    for raw in function.params:
        val param: HirParam = raw
        params.push(MirHirParamDeclarationV1(symbol: param.symbol, name: param.name,
            type_: param.type_, has_default: false, default_artifact: nil,
            span: param.span, is_mutable: param.is_mutable))
    val record = MirHirFunctionDeclarationV1(symbol: function.symbol, name: function.name,
        type_params: function.type_params, params: params, return_type: function.return_type,
        effects: function.effects, visibility: function.visibility, is_async: function.is_async,
        is_static: function.is_static, is_public: function.is_public, is_method: function.is_method,
        is_mutable: function.is_mutable, is_const: function.is_const, is_extern: function.is_extern,
        func_attr: function.func_attr, has_export_attr: function.has_export_attr,
        export_attr: function.export_attr, is_generic_template: function.is_generic_template,
        span: function.span, complete_function_digest: mono_complete_function_digest_v1(function))
    expect(record.complete_function_digest.len()).to_equal(64)
    MirHirModuleDeclarationsV1(name: actual.name, path: actual.path,
        final_repository_authority: sha256_text("origin-unit-binding-mechanics"),
        final_archive_key: "", final_body_digest: sha256_text(source), symbols: actual.symbols,
        functions: [record], structs: [], classes: [], enums: [], bitfields: [], traits: [],
        impls: [], globals: [], needs_initialization: false,
        declaration_digest: sha256_text("origin-unit-declaration-mechanics:" + source),
        stage: "unit-binding-mechanics-not-admission",
        source_binding: Some(MirHirDeclarationSourceV1(logical_key: "origin_fixture",
            physical_path: actual.path, source_digest: sha256_text(source),
            source_bytes: source.len(), input_archive_key: "")))

fn origin_actual_lifecycle_module_v1(name: text) -> HirModule:
    val source = "fn {name}(value: i64) -> i64:\n    value\n"
    val ast = parse_full_frontend(source, "{name}.spl", name, Logger(level: 0))
    var frontend = HirLowering.with_filename("{name}.spl")
    val actual = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    actual

describe "bootstrap actual-write declaration provenance":
    it "captures the declaration selector only beside its actual typed registration":
        val module = origin_actual_declaration_fixture_v1()
        val function: MirHirFunctionDeclarationV1 = module.functions[0]
        val key = "origin.controls.bound-return"
        bootstrap_fn_ret_hir_type_register_declaration_v1(key, module, 0)
        val origin = bootstrap_fn_registry_origin_v1("return_hir", key)
        expect(origin != nil).to_equal(true)
        if val value = origin:
            expect(value.module_key).to_equal("origin_fixture")
            expect(value.function_digest).to_equal(function.complete_function_digest)
            expect(value.selector).to_equal("return_type")
            expect(value.row_name).to_equal(key)
            expect(value.write_event).to_be_greater_than(0)
        expect(bootstrap_fn_ret_hir_type_lookup(key).unwrap().kind).to_equal(function.return_type.kind)

    it "preserves the original winner on an identical write and revokes a changed legacy write":
        val module = origin_actual_declaration_fixture_v1()
        val function: MirHirFunctionDeclarationV1 = module.functions[0]
        val key = "origin.controls.parameters"
        bootstrap_fn_param_hir_types_register_declaration_v1(key, module, 0)
        val first = bootstrap_fn_registry_origin_v1("parameter_hir", key).unwrap()
        bootstrap_fn_param_hir_types_register(key, [function.params[0].type_])
        val identical = bootstrap_fn_registry_origin_v1("parameter_hir", key).unwrap()
        expect(identical.write_event).to_equal(first.write_event)
        val changed = HirType(kind: HirTypeKind.Int(bits: 32, signed: true), span: Span.empty())
        bootstrap_fn_param_hir_types_register(key, [changed])
        expect(bootstrap_fn_registry_origin_v1("parameter_hir", key)).to_equal(nil)
        expect(bootstrap_fn_param_hir_types_lookup(key).unwrap()[0].kind).to_equal(changed.kind)

    it "preserves ambiguity and never lends an origin to the next unrelated registration":
        val module = origin_actual_declaration_fixture_v1()
        val function: MirHirFunctionDeclarationV1 = module.functions[0]
        val key = "origin.controls.ambiguous"
        bootstrap_fn_ret_hir_type_register_declaration_v1(key, module, 0)
        bootstrap_fn_ret_hir_type_register(key, function.return_type)
        expect(bootstrap_fn_ret_hir_type_lookup(key)).to_equal(nil)
        expect(bootstrap_fn_registry_origin_v1("return_hir", key)).to_equal(nil)
        val unrelated = "origin.controls.unrelated"
        bootstrap_fn_ret_hir_type_register(unrelated, function.return_type)
        expect(bootstrap_fn_ret_hir_type_lookup(unrelated) != nil).to_equal(true)
        expect(bootstrap_fn_registry_origin_v1("return_hir", unrelated)).to_equal(nil)

    it "rejects missing origin metadata without changing the ordinary registration result":
        var module = origin_actual_declaration_fixture_v1()
        var function: MirHirFunctionDeclarationV1 = module.functions[0]
        function.complete_function_digest = ""
        module.functions = [function]
        val key = "origin.controls.missing"
        bootstrap_fn_ret_hir_type_register_declaration_v1(key, module, 0)
        expect(bootstrap_fn_ret_hir_type_lookup(key) != nil).to_equal(true)
        expect(bootstrap_fn_registry_origin_v1("return_hir", key)).to_equal(nil)

    it "promotes the real registration evidence before ending a transient scope":
        val module = origin_actual_declaration_fixture_v1()
        val function: MirHirFunctionDeclarationV1 = module.functions[0]
        val key = "origin.controls.scoped"
        expect(transient_scope_begin()).to_equal(true)
        bootstrap_fn_param_hir_types_register_declaration_v1(key, module, 0)
        expect(transient_scope_pause()).to_equal(true)
        expect(bootstrap_fn_registries_promote()).to_equal(true)
        expect(transient_scope_end()).to_equal(true)
        val origin = bootstrap_fn_registry_origin_v1("parameter_hir", key).unwrap()
        expect(origin.function_digest).to_equal(function.complete_function_digest)
        expect(origin.selector).to_equal("parameter_types")
        expect(bootstrap_fn_param_hir_types_lookup(key).unwrap()[0].kind).to_equal(function.params[0].type_.kind)

    it "retains a captured origin through two real ordinary module scope lifecycles":
        val declaration = origin_actual_declaration_fixture_v1()
        val key = "origin.controls.real-normal-lifecycle"
        bootstrap_fn_param_hir_types_register_declaration_v1(key, declaration, 0)
        val before = bootstrap_fn_registry_origin_v1("parameter_hir", key).unwrap()
        for name in ["origin_real_first", "origin_real_second"]:
            val actual = origin_actual_lifecycle_module_v1(name)
            var lowering = MirLowering.new(actual.symbols)
            val lowered = lowering.lower_module_transient_scoped(actual, [], false)
            expect(lowered.is_ok()).to_equal(true)
            expect(lowering.errors.len()).to_equal(0)
            val after = bootstrap_fn_registry_origin_v1("parameter_hir", key).unwrap()
            expect(after.function_digest).to_equal(before.function_digest)
            expect(after.write_event).to_equal(before.write_event)
