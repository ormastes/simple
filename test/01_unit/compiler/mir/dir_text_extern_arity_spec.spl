"""Directory text-extern facade arities.

Repro for the SimpleOS x86_64 core archive failure: core_fs.spl defines the raw
(path_ptr, path_len) providers `rt_dir_exists` / `rt_dir_create_all` itself and
calls them with two integer words. Without a semantic-arity row the MIR text
split re-expanded the first word as a `text` into (ptr, len), producing a
3-operand call to a 2-parameter function, which cranelift's verifier rejects
("Failed to compile function: rt_dir_create"). The split must only apply to the
one-text facade arity.
"""

use std.spec.*
use compiler.mir.text_extern_abi.{text_arg_indices, text_extern_semantic_arity}

describe "directory text extern arity":
    it "splits only the one-path facade, not the raw (ptr, len) call":
        for name in ["rt_dir_exists", "rt_dir_list", "rt_dir_remove_all", "rt_dir_walk", "rt_set_current_dir", "rt_dir_is_real_no_follow", "rt_dir_create_all"]:
            expect(text_arg_indices(name).unwrap()).to_equal([0])
            expect(text_extern_semantic_arity(name).unwrap()).to_equal(1)

    it "keeps the recursive flag out of the split for create/remove":
        for name in ["rt_dir_create", "rt_dir_remove"]:
            expect(text_arg_indices(name).unwrap()).to_equal([0])
            expect(text_extern_semantic_arity(name).unwrap()).to_equal(2)
