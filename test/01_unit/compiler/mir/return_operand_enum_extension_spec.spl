"""
Return operand classification preserves current values while naming every
MirOperandKind variant. The existing critical wildcard coverage specification
checks that a newly added closed-enum variant produces a missing witness.
"""
use std.spec.*
use compiler.mir.mir_instruction_graph.{MirBlock}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator, MirOperand, MirOperandKind}
use compiler.mir.mir_types.{LocalId, MirConstValue, MirType}

fn return_block(value: MirOperand?) -> MirBlock:
    MirBlock(id: BlockId(id: 0), label: nil, instructions: [], terminator: MirTerminator.Ret(value))

describe "return operand enum classification":
    it "preserves copy and move local IDs and nonconstant sentinels":
        for kind in [MirOperandKind.Copy(LocalId(id: 7)), MirOperandKind.Move(LocalId(id: 11))]:
            val block = return_block(Some(MirOperand(kind: kind)))
            val expected = if block.bootstrap_ret_kind() == 1: 7 else: 11
            expect(block.bootstrap_ret_local_id()).to_equal(expected)
            expect(block.bootstrap_ret_const_kind()).to_equal(0)
            expect(block.bootstrap_ret_const_scalar_text()).to_equal("0")

    it "preserves absent-return sentinels":
        val block = return_block(nil)
        expect(block.bootstrap_ret_kind()).to_equal(0)
        expect(block.bootstrap_ret_local_id()).to_equal(-1)
        expect(block.bootstrap_ret_const_kind()).to_equal(0)
        expect(block.bootstrap_ret_const_scalar_text()).to_equal("0")

    it "preserves integer constants and the nonlocal sentinel":
        val op = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(37), MirType.i64()))
        val block = return_block(Some(op))
        expect(block.bootstrap_ret_kind()).to_equal(3)
        expect(block.bootstrap_ret_local_id()).to_equal(-1)
        expect(block.bootstrap_ret_const_kind()).to_equal(1)
        expect(block.bootstrap_ret_const_scalar_text()).to_equal("37")
