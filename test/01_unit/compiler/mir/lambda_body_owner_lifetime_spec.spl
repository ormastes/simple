use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.mir.mir_lowering.{MirLowering}

fn lambda_owner_module(source: text, name: text) -> HirModule:
    val path = "{name}.spl"
    val ast = parse_full_frontend(source, path, name, Logger(level: 0))
    var frontend = HirLowering.with_filename(path)
    val module = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    module

describe "MIR lambda body ownership across real function lowering":
    it "keeps captured lambda calls valid and releases their HIR after emission":
        val module = lambda_owner_module("fn evaluate() -> i64:\n    val bias = 3\n    val callback = \\value: value + bias\n    callback(5)\n", "first")
        var lowering = MirLowering.new(module.symbols)
        val emitted = lowering.lower_module(module)
        expect(lowering.errors.len()).to_equal(0)
        expect(emitted.functions.len() > 0).to_equal(true)
        expect(lowering.lambda_bindings.len()).to_equal(0)
        expect(lowering.lambda_capture_snapshot.len()).to_equal(0)

    it "does not lend an old module lambda body to a named local callable":
        val first = lambda_owner_module("fn shifted(value: i64) -> i64:\n    value + 3\nfn evaluate() -> i64:\n    val callback = \\value: value + 3\n    callback(5)\n", "first")
        val second = lambda_owner_module("fn shifted(value: i64) -> i64:\n    value + 9\nfn evaluate() -> i64:\n    val callback: fn(i64) -> i64 = shifted\n    callback(5)\n", "second")
        var lowering = MirLowering.new(first.symbols)
        lowering.lower_module(first)
        lowering.lower_module(second)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.lambda_bindings.len()).to_equal(0)
        expect(lowering.lambda_capture_snapshot.len()).to_equal(0)

    it "preserves enclosing remembered bindings during an explicit child function lowering":
        val parent = lambda_owner_module("fn evaluate() -> i64:\n    val callback = \\value: value + 3\n    callback(5)\n", "parent")
        val child = lambda_owner_module("fn evaluate() -> i64:\n    val callback = \\value: value + 9\n    callback(5)\n", "child")
        var lowering = MirLowering.new(parent.symbols)
        # Seed a real parent Lambda from its actual HIR, never a guessed body.
        val parent_function: HirFunction = parent.functions.values()[0]
        match parent_function.body.stmts[0].kind:
            case Let(symbol, _, expression):
                lowering.lambda_bindings[symbol.id] = expression
                val remembered = lowering.lambda_bindings
                lowering.lower_function(child.functions.values()[0])
                expect(lowering.lambda_bindings.len()).to_equal(remembered.len())
                expect(lowering.lambda_bindings[symbol.id]).to_equal(expression)
            case _: panic("actual callback declaration was not lowered as Let")
