use std.spec.*
use compiler.mir.call_argument_slots_v1.{mir_call_argument_slots_v1}

describe "Declared call slot planning":
    it "maps sparse middle and tail arguments without filling their slots":
        expect(mir_call_argument_slots_v1(["a", "b", "c", "d"], [false, true, true, true], ["", "d"])).to_equal(Ok([0, 3]))
        expect(mir_call_argument_slots_v1(["a", "b", "c"], [false, true, true], ["", "b"])).to_equal(Ok([0, 1]))

    it "retains source ordering in the slot map":
        expect(mir_call_argument_slots_v1(["a", "b", "c"], [false, false, false], ["c", "a", "b"])).to_equal(Ok([2, 0, 1]))
        expect(mir_call_argument_slots_v1(["a", "b", "c"], [false, false, false], ["", "", ""])).to_equal(Ok([0, 1, 2]))

    it "rejects duplicate unknown missing and excess arguments before lowering":
        expect(mir_call_argument_slots_v1(["a"], [true], ["a", "a"]).is_err()).to_equal(true)
        expect(mir_call_argument_slots_v1(["a"], [true], ["q"]).is_err()).to_equal(true)
        expect(mir_call_argument_slots_v1(["a", "b"], [false, true], ["b"]).is_err()).to_equal(true)
        expect(mir_call_argument_slots_v1(["a"], [true], ["", ""]).is_err()).to_equal(true)

    it "rejects incomplete or ambiguous declaration metadata":
        expect(mir_call_argument_slots_v1(["a"], [], ["a"]).is_err()).to_equal(true)
        expect(mir_call_argument_slots_v1(["a", "a"], [true, true], ["a"]).is_err()).to_equal(true)
