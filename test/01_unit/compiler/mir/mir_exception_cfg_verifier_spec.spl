use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.{
    BlockId, LocalId, MirBody, MirBuilder, MirCallUnwindContract,
    MirConstValue, MirInst, MirInstKind, MirOperand, MirOperandKind,
    MirExceptionCleanupContract, MirFacetCleanupEntryContract,
    MirInstructionSite, MirSignature, MirTerminator, MirType, MirTypeKind,
    mir_call_terminator_create, mir_operand_const_int,
    mir_operand_copy, mir_operand_move, validate_mir_exception_cfg
}

extern fn rt_file_read_text(path: text) -> text

fn exception_cfg_builder(name: text, symbol_id: i64) -> MirBuilder:
    var builder = MirBuilder.new()
    builder.begin_function(
        SymbolId(id: symbol_id), name,
        MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        Span.empty())
    builder

fn exception_cfg_body(builder: MirBuilder) -> MirBody:
    MirBody.from_function(builder.end_function())

fn exact_facet_release_operand() -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(
            "aspect_execution_context_release_facet_descriptor_or_panic"),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [
                MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")),
                MirType(kind: MirTypeKind.Opaque(
                    "__simple_facet_descriptor_lease_abi"))],
            return_type: MirType.unit(), is_variadic: false)))))

fn defined_cleanup_owner(builder: MirBuilder, symbol_id: i64) -> LocalId:
    val context = builder.new_temp(MirType(kind: MirTypeKind.Struct(
        SymbolId(id: symbol_id))))
    builder.emit_bitcast(
        mir_operand_copy(context),
        MirType(kind: MirTypeKind.Opaque("AspectExecutionContext")))

fn defined_cleanup_lease(builder: MirBuilder) -> LocalId:
    val lease = builder.new_temp(MirType(kind: MirTypeKind.Opaque(
        "__simple_facet_descriptor_lease_abi")))
    builder.emit_const(lease, MirConstValue.Zero,
        MirType(kind: MirTypeKind.Opaque("__simple_facet_descriptor_lease_abi")))
    lease

fn install_single_release_manifest(
    body: MirBody, unwind: BlockId, token: LocalId,
    owner: LocalId, lease: LocalId, instruction_index: i64
) -> MirBody:
    var result = body
    result.exception_cleanup_contracts = [MirExceptionCleanupContract(
        unwind_entry: unwind,
        token: token,
        entries: [MirFacetCleanupEntryContract(
            owner: owner,
            lease: lease,
            present: nil,
            guard_block: nil,
            release_site: MirInstructionSite(
                block: unwind, instruction_index: instruction_index),
            continue_block: nil,
            release_symbol:
                "aspect_execution_context_release_facet_descriptor_or_panic")])]
    result

fn install_empty_manifest(
    body: MirBody, unwind: BlockId, token: LocalId
) -> MirBody:
    var result = body
    result.exception_cleanup_contracts = [MirExceptionCleanupContract(
        unwind_entry: unwind, token: token, entries: [])]
    result

fn install_valid_unwind_shape(builder: MirBuilder) -> MirBody:
    val normal = builder.new_block(Some("normal"))
    val unwind = builder.new_block(Some("unwind"))
    builder.set_terminator(mir_call_terminator_create(
        nil, mir_operand_const_int(1), [], normal,
        MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
    builder.switch_to_block(unwind)
    val token = builder.emit_landing_pad()
    builder.terminate_resume(mir_operand_move(token))
    builder.switch_to_block(normal)
    builder.terminate_return(nil)
    exception_cfg_body(builder)

describe "MIR exception CFG verifier":
    it "rejects an unwind-only LandingPad without its mandatory manifest":
        val body = install_valid_unwind_shape(
            exception_cfg_builder("valid_unwind", 981))
        expect(validate_mir_exception_cfg(body).unwrap_err()).to_contain(
            "facet cleanup landing pad has no manifest")

    it "rejects duplicate block and local identities":
        var duplicate_block = install_valid_unwind_shape(
            exception_cfg_builder("duplicate_block", 988))
        duplicate_block.blocks.push(duplicate_block.blocks[0])
        expect(validate_mir_exception_cfg(duplicate_block).unwrap_err()).to_contain(
            "duplicate MIR block id")

        var duplicate_local = install_valid_unwind_shape(
            exception_cfg_builder("duplicate_local", 989))
        duplicate_local.locals.push(duplicate_local.locals[0])
        expect(validate_mir_exception_cfg(duplicate_local).unwrap_err()).to_contain(
            "duplicate MIR local id")

    it "rejects every call contract mismatch including NoUnwind stray edges":
        var builder = exception_cfg_builder("stray_unwind", 990)
        val normal = builder.new_block(Some("normal"))
        val stray = builder.new_block(Some("stray"))
        builder.set_terminator(MirTerminator.CallTerminator(
            nil, mir_operand_const_int(1), [], normal,
            MirCallUnwindContract.NoUnwind, Some(stray)))
        builder.switch_to_block(normal)
        builder.terminate_return(nil)
        builder.switch_to_block(stray)
        builder.terminate_return(nil)
        expect(validate_mir_exception_cfg(
            exception_cfg_body(builder)).unwrap_err()).to_contain(
            "NoUnwind call terminator cannot carry an unwind edge")

    it "rejects token destination redefinition and forged release calls":
        var redefine = exception_cfg_builder("redefine_token", 991)
        val redefine_normal = redefine.new_block(Some("normal"))
        val redefine_unwind = redefine.new_block(Some("unwind"))
        redefine.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], redefine_normal,
            MirCallUnwindContract.MayUnwind, Some(redefine_unwind)).unwrap())
        redefine.switch_to_block(redefine_unwind)
        val redefine_token = redefine.emit_landing_pad()
        redefine.emit(MirInst(kind: MirInstKind.Const(
            redefine_token, MirConstValue.Zero, MirType.exception_token()), span: nil))
        redefine.terminate_resume(mir_operand_move(redefine_token))
        redefine.switch_to_block(redefine_normal)
        redefine.terminate_return(nil)
        expect(validate_mir_exception_cfg(
            exception_cfg_body(redefine)).unwrap_err()).to_contain(
            "redefines an ExceptionToken local")

        var forged = exception_cfg_builder("forged_release", 992)
        val forged_normal = forged.new_block(Some("normal"))
        val forged_unwind = forged.new_block(Some("unwind"))
        forged.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], forged_normal,
            MirCallUnwindContract.MayUnwind, Some(forged_unwind)).unwrap())
        forged.switch_to_block(forged_unwind)
        val forged_token = forged.emit_landing_pad()
        forged.emit_call(MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("aspect_execution_context_release_facet_descriptor_or_panic"),
            MirType.i64())), [], MirType.unit())
        forged.terminate_resume(mir_operand_move(forged_token))
        forged.switch_to_block(forged_normal)
        forged.terminate_return(nil)
        val forged_body = install_empty_manifest(
            exception_cfg_body(forged), forged_unwind, forged_token)
        expect(validate_mir_exception_cfg(forged_body).unwrap_err()).to_contain(
            "exact NoUnwind facet release ABI")

    it "rejects swapped and arbitrary facet release argument locals":
        var exact = exception_cfg_builder("exact_release_args", 995)
        val exact_normal = exact.new_block(Some("normal"))
        val exact_unwind = exact.new_block(Some("unwind"))
        val exact_owner = defined_cleanup_owner(exact, 8201)
        val exact_lease = defined_cleanup_lease(exact)
        exact.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], exact_normal,
            MirCallUnwindContract.MayUnwind, Some(exact_unwind)).unwrap())
        exact.switch_to_block(exact_unwind)
        val exact_token = exact.emit_landing_pad()
        exact.emit_call(exact_facet_release_operand(),
            [mir_operand_copy(exact_owner), mir_operand_copy(exact_lease)],
            MirType.unit())
        exact.terminate_resume(mir_operand_move(exact_token))
        exact.switch_to_block(exact_normal)
        exact.terminate_return(nil)
        val exact_body = install_single_release_manifest(
            exception_cfg_body(exact), exact_unwind, exact_token,
            exact_owner, exact_lease, 1)
        expect(validate_mir_exception_cfg(exact_body).is_ok()).to_be(true)

        var swapped = exception_cfg_builder("swapped_release_args", 993)
        val swapped_normal = swapped.new_block(Some("normal"))
        val swapped_unwind = swapped.new_block(Some("unwind"))
        val swapped_owner = swapped.new_temp(MirType(kind: MirTypeKind.Opaque(
            "AspectExecutionContext")))
        val swapped_lease = swapped.new_temp(MirType(kind: MirTypeKind.Opaque(
            "__simple_facet_descriptor_lease_abi")))
        swapped.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], swapped_normal,
            MirCallUnwindContract.MayUnwind, Some(swapped_unwind)).unwrap())
        swapped.switch_to_block(swapped_unwind)
        val swapped_token = swapped.emit_landing_pad()
        swapped.emit_call(exact_facet_release_operand(),
            [mir_operand_copy(swapped_lease), mir_operand_copy(swapped_owner)],
            MirType.unit())
        swapped.terminate_resume(mir_operand_move(swapped_token))
        swapped.switch_to_block(swapped_normal)
        swapped.terminate_return(nil)
        val swapped_body = install_empty_manifest(
            exception_cfg_body(swapped), swapped_unwind, swapped_token)
        expect(validate_mir_exception_cfg(swapped_body).unwrap_err()).to_contain(
            "exact NoUnwind facet release ABI")

        var arbitrary = exception_cfg_builder("arbitrary_release_args", 994)
        val arbitrary_normal = arbitrary.new_block(Some("normal"))
        val arbitrary_unwind = arbitrary.new_block(Some("unwind"))
        val arbitrary_left = arbitrary.new_temp(MirType.i64())
        val arbitrary_right = arbitrary.new_temp(MirType.i64())
        arbitrary.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], arbitrary_normal,
            MirCallUnwindContract.MayUnwind, Some(arbitrary_unwind)).unwrap())
        arbitrary.switch_to_block(arbitrary_unwind)
        val arbitrary_token = arbitrary.emit_landing_pad()
        arbitrary.emit_call(exact_facet_release_operand(),
            [mir_operand_copy(arbitrary_left), mir_operand_copy(arbitrary_right)],
            MirType.unit())
        arbitrary.terminate_resume(mir_operand_move(arbitrary_token))
        arbitrary.switch_to_block(arbitrary_normal)
        arbitrary.terminate_return(nil)
        val arbitrary_body = install_empty_manifest(
            exception_cfg_body(arbitrary), arbitrary_unwind, arbitrary_token)
        expect(validate_mir_exception_cfg(arbitrary_body).unwrap_err()).to_contain(
            "exact NoUnwind facet release ABI")

    it "rejects missing duplicate stale and mismatched cleanup manifests":
        var builder = exception_cfg_builder("manifest_adversarial", 996)
        val normal = builder.new_block(Some("normal"))
        val unwind = builder.new_block(Some("unwind"))
        val owner = defined_cleanup_owner(builder, 8202)
        val lease = defined_cleanup_lease(builder)
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(unwind)
        val token = builder.emit_landing_pad()
        builder.emit_call(exact_facet_release_operand(),
            [mir_operand_copy(owner), mir_operand_copy(lease)], MirType.unit())
        builder.terminate_resume(mir_operand_move(token))
        builder.switch_to_block(normal)
        builder.terminate_return(nil)
        val bare = exception_cfg_body(builder)
        expect(validate_mir_exception_cfg(bare).unwrap_err()).to_contain(
            "has no manifest")

        var valid = install_single_release_manifest(
            bare, unwind, token, owner, lease, 1)
        expect(validate_mir_exception_cfg(valid).is_ok()).to_be(true)

        var duplicate = valid
        duplicate.exception_cleanup_contracts.push(
            duplicate.exception_cleanup_contracts[0])
        expect(validate_mir_exception_cfg(duplicate).unwrap_err()).to_contain(
            "multiple manifests")

        var stale = valid
        var stale_contract = stale.exception_cleanup_contracts[0]
        var stale_entry = stale_contract.entries[0]
        stale_entry.release_site = MirInstructionSite(
            block: unwind, instruction_index: 99)
        stale_contract.entries[0] = stale_entry
        stale.exception_cleanup_contracts[0] = stale_contract
        expect(validate_mir_exception_cfg(stale).unwrap_err()).to_contain(
            "stale release instruction index")

        var mismatched = valid
        var mismatch_contract = mismatched.exception_cleanup_contracts[0]
        var mismatch_entry = mismatch_contract.entries[0]
        mismatch_entry.owner = lease
        mismatch_contract.entries[0] = mismatch_entry
        mismatched.exception_cleanup_contracts[0] = mismatch_contract
        expect(validate_mir_exception_cfg(mismatched).unwrap_err()).to_contain(
            "owner or lease type is not exact")

    it "proves guarded true-release false-bypass joins by manifest cursor":
        var builder = exception_cfg_builder("guarded_manifest", 997)
        val normal = builder.new_block(Some("normal"))
        val unwind = builder.new_block(Some("unwind"))
        val release = builder.new_block(Some("release"))
        val continuation = builder.new_block(Some("continuation"))
        val owner = defined_cleanup_owner(builder, 8203)
        val lease = defined_cleanup_lease(builder)
        val present = builder.new_temp(MirType.bool())
        builder.emit_const(present, MirConstValue.Bool(true), MirType.bool())
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(unwind)
        val token = builder.emit_landing_pad()
        builder.terminate_if(mir_operand_copy(present), release, continuation)
        builder.switch_to_block(release)
        builder.emit_call(exact_facet_release_operand(),
            [mir_operand_copy(owner), mir_operand_copy(lease)], MirType.unit())
        builder.terminate_goto(continuation)
        builder.switch_to_block(continuation)
        builder.terminate_resume(mir_operand_move(token))
        builder.switch_to_block(normal)
        builder.terminate_return(nil)
        var body = exception_cfg_body(builder)
        body.exception_cleanup_contracts = [MirExceptionCleanupContract(
            unwind_entry: unwind,
            token: token,
            entries: [MirFacetCleanupEntryContract(
                owner: owner,
                lease: lease,
                present: Some(present),
                guard_block: Some(unwind),
                release_site: MirInstructionSite(
                    block: release, instruction_index: 0),
                continue_block: Some(continuation),
                release_symbol:
                    "aspect_execution_context_release_facet_descriptor_or_panic")])]
        expect(validate_mir_exception_cfg(body).is_ok()).to_be(true)

        var wrong_guard = body
        var contract = wrong_guard.exception_cleanup_contracts[0]
        var entry = contract.entries[0]
        entry.guard_block = Some(release)
        contract.entries[0] = entry
        wrong_guard.exception_cleanup_contracts[0] = contract
        expect(validate_mir_exception_cfg(wrong_guard).unwrap_err()).to_contain(
            "guard block is not If")

        var wrong_continuation = body
        var continuation_contract = wrong_continuation.exception_cleanup_contracts[0]
        var continuation_entry = continuation_contract.entries[0]
        continuation_entry.continue_block = Some(normal)
        continuation_contract.entries[0] = continuation_entry
        wrong_continuation.exception_cleanup_contracts[0] = continuation_contract
        expect(validate_mir_exception_cfg(
            wrong_continuation).unwrap_err()).to_contain(
            "true-release false-bypass CFG")

    it "rejects a LandingPad reached by a normal successor":
        var builder = exception_cfg_builder("normal_pad", 982)
        val pad = builder.new_block(Some("shared_pad"))
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], pad,
            MirCallUnwindContract.MayUnwind, Some(pad)).unwrap())
        builder.switch_to_block(pad)
        val token = builder.emit_landing_pad()
        builder.terminate_resume(mir_operand_move(token))
        expect(validate_mir_exception_cfg(
            exception_cfg_body(builder)).unwrap_err()).to_contain(
            "LandingPad block 1 has a normal predecessor")

    it "requires Resume to consume a LandingPad ExceptionToken":
        var builder = exception_cfg_builder("bad_resume", 983)
        val normal = builder.new_block(Some("normal"))
        val unwind = builder.new_block(Some("unwind"))
        builder.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], normal,
            MirCallUnwindContract.MayUnwind, Some(unwind)).unwrap())
        builder.switch_to_block(unwind)
        val _token = builder.emit_landing_pad()
        builder.terminate_resume(mir_operand_const_int(9))
        builder.switch_to_block(normal)
        builder.terminate_return(nil)
        val bad_resume_body = install_empty_manifest(
            exception_cfg_body(builder), unwind, _token)
        expect(validate_mir_exception_cfg(bad_resume_body).unwrap_err()).to_contain(
            "Resume operand is not a LandingPad token")

        var wrong_type = exception_cfg_builder("wrong_token_type", 987)
        val wrong_normal = wrong_type.new_block(Some("normal"))
        val wrong_unwind = wrong_type.new_block(Some("unwind"))
        wrong_type.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], wrong_normal,
            MirCallUnwindContract.MayUnwind, Some(wrong_unwind)).unwrap())
        wrong_type.switch_to_block(wrong_unwind)
        val integer_local = wrong_type.new_temp(MirType.i64())
        wrong_type.emit(MirInst(
            kind: MirInstKind.LandingPad(integer_local), span: nil))
        wrong_type.terminate_resume(mir_operand_move(integer_local))
        wrong_type.switch_to_block(wrong_normal)
        wrong_type.terminate_return(nil)
        expect(validate_mir_exception_cfg(
            exception_cfg_body(wrong_type)).unwrap_err()).to_contain(
            "is not ExceptionToken")

    it "rejects ordinary token use and duplicate Resume consumption":
        var ordinary = exception_cfg_builder("ordinary_token_use", 984)
        val ordinary_normal = ordinary.new_block(Some("normal"))
        val ordinary_unwind = ordinary.new_block(Some("unwind"))
        ordinary.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], ordinary_normal,
            MirCallUnwindContract.MayUnwind, Some(ordinary_unwind)).unwrap())
        ordinary.switch_to_block(ordinary_unwind)
        val ordinary_token = ordinary.emit_landing_pad()
        ordinary.emit_call(
            mir_operand_const_int(2), [mir_operand_copy(ordinary_token)],
            MirType.unit())
        ordinary.terminate_resume(mir_operand_move(ordinary_token))
        ordinary.switch_to_block(ordinary_normal)
        ordinary.terminate_return(nil)
        val ordinary_body = install_empty_manifest(
            exception_cfg_body(ordinary), ordinary_unwind, ordinary_token)
        expect(validate_mir_exception_cfg(ordinary_body).unwrap_err()).to_contain(
            "exception token passed to ordinary call")

        var duplicate = exception_cfg_builder("duplicate_resume", 985)
        val duplicate_normal = duplicate.new_block(Some("normal"))
        val duplicate_unwind = duplicate.new_block(Some("unwind"))
        val duplicate_second = duplicate.new_block(Some("second_resume"))
        duplicate.set_terminator(mir_call_terminator_create(
            nil, mir_operand_const_int(1), [], duplicate_normal,
            MirCallUnwindContract.MayUnwind, Some(duplicate_unwind)).unwrap())
        duplicate.switch_to_block(duplicate_unwind)
        val duplicate_token = duplicate.emit_landing_pad()
        duplicate.terminate_resume(mir_operand_move(duplicate_token))
        duplicate.switch_to_block(duplicate_second)
        duplicate.terminate_resume(mir_operand_move(duplicate_token))
        duplicate.switch_to_block(duplicate_normal)
        duplicate.terminate_return(nil)
        expect(validate_mir_exception_cfg(
            exception_cfg_body(duplicate)).unwrap_err()).to_contain(
            "must have exactly one linear consumer")

    it "keeps NoUnwind on the ordinary instruction path":
        var builder = exception_cfg_builder("ordinary_call", 986)
        val _result = builder.emit_call(
            mir_operand_const_int(1), [], MirType.unit())
        builder.terminate_return(nil)
        val body = exception_cfg_body(builder)
        expect(validate_mir_exception_cfg(body).is_ok()).to_be(true)
        var saw_call = false
        for instruction in body.blocks[0].instructions:
            match instruction.kind:
                case Call(_, _, _): saw_call = true
                case _: ()
        expect(saw_call).to_be(true)
        match body.blocks[0].terminator:
            case Ret(_): ()
            case _: fail("NoUnwind call was not retained as an ordinary instruction")

    it "retains typed backend rejection while native exception CFG is unsupported":
        val source = rt_file_read_text(
            "src/compiler/70.backend/backend/llvm_lib_translate_expr.spl") ?? ""
        expect(source).to_contain("case LandingPad(_):")
        expect(source).to_contain("E-MIR-UNWIND002")
