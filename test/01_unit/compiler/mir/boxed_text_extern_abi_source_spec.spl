extern fn rt_file_read_text(path: text) -> text

describe "boxed text extern ABI":
    it "boxes string-builder text through the shared MIR call choke point":
        val registry = rt_file_read_text("src/compiler/50.mir/text_extern_abi.spl") ?? ""
        val lowering = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl") ?? ""
        expect(registry).to_contain("fn boxed_text_arg_indices(func_name: text) -> [i64]?:")
        expect(registry).to_contain("case \"rt_string_builder_push\": return Some([1])")
        expect(lowering).to_contain("me box_text_abi_args(func: MirOperand, args: [MirOperand]) -> [MirOperand]:")
        expect(lowering).to_contain("self.text_extern_abi_helper_operand(\"rt_string_new\")")
        expect(lowering).to_contain("val boxed_args = self.box_text_abi_args(func, args_in)")
        expect(lowering).to_contain("val args = self.expand_text_abi_args(func, boxed_args)")
