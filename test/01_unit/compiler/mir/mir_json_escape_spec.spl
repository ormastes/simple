"""
## Purpose and audience

Behavior and allocation-shape coverage for MIR JSON string escaping — for
compiler owners changing `escape_json_string` in
`src/compiler/50.mir/mir_json.spl` or its callers in the MIR JSON emitter.

## Operator workflow

Run this spec with the repo test runner and confirm zero failed scenarios.
The first two scenarios call `escape_json_string` directly with real input
text; the third reads the production helper's own source to pin its
allocation shape.

## Compatibility and limitations

The allocation-shape scenario is a source-contract check: it confirms the
helper builds its result with a single `parts.join("")` pass rather than
repeated string reassignment, without re-measuring wall-clock allocation
cost. Escaping behavior itself is covered by the first two scenarios.

## Verification guidance and troubleshooting

Re-run after any change to `escape_json_string`. A behavior failure means an
escape sequence's output changed; an allocation-shape failure means the
helper regressed back to a quadratic per-character reassignment pattern.
"""
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: MIR JSON string escaping

use compiler.mir.mir_json.{escape_json_string}
use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "MIR JSON string escaping":
    it "preserves plain, empty, and ordered escaped text":
        # @req REQ-MIR-JSON-ESCAPE-001
        # @capture(statistics): escaped output for empty, plain, and all-special-character input retained
        step("Escape every supported JSON special character in source order")
        expect(escape_json_string("")).to_equal("")
        expect(escape_json_string("plain text")).to_equal("plain text")
        expect(escape_json_string("say \"x\"\\path\nrow\rcol\tend")).to_equal("say \\\"x\\\"\\\\path\\nrow\\rcol\\tend")

    it "preserves non-ASCII text around escapes":
        # @req REQ-MIR-JSON-ESCAPE-002
        # @capture(statistics): escaped output for a non-ASCII string retained
        step("Keep the existing text-slice semantics while escaping JSON syntax")
        expect(escape_json_string("lambda λ: \"ok\"\n")).to_equal("lambda λ: \\\"ok\\\"\\n")

    it "assembles fragments once instead of copying every prior prefix":
        # @req REQ-MIR-JSON-ESCAPE-003
        # @capture(statistics): presence of single-pass assembly markers and absence of quadratic reassignment retained
        step("Pin the linear output assembly contract on the production helper")
        val source = rt_file_read_text("src/compiler/50.mir/mir_json.spl") ?? ""
        val open_brace = "{"
        val close_brace = "}"
        val declares_the_helper_signature =
            source.contains("fn escape_json_string(s: text) -> text:")
        val builds_a_parts_list =
            source.contains("var parts: [text] = []")
        val joins_parts_in_one_pass =
            source.contains("parts.join(\"\")")
        val still_reassigns_result_with_escaped_quote = source.contains(
            "result = \"" + open_brace + "result" + close_brace + "\\\\\\\"")
        val still_reassigns_result_by_appending_one_char = source.contains(
            "result = \"" + open_brace + "result" + close_brace +
                open_brace + "c" + close_brace + "\"")
        expect(declares_the_helper_signature).to_equal(true)
        expect(builds_a_parts_list).to_equal(true)
        expect(joins_parts_in_one_pass).to_equal(true)
        expect(still_reassigns_result_with_escaped_quote).to_equal(false)
        expect(still_reassigns_result_by_appending_one_char).to_equal(false)
