# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
A record payload bound out of a user GENERIC enum keeps its record owner.

Bug: doc/08_tracking/bug/stage2_payload_bind_and_tail_option_wrap_2026-11-16.md (defect B)

`case Full(item): item.id` over `Box<Lid>` (`enum Box<T>: Full(item: T)`)
decoded the payload through the declared slot `T`, so struct_value_syms never
named `Lid`. `item.id` lowered to a Unit-typed GetField, the arm copied
nothing into the match result, and the function returned an uninitialised
slot (cranelift printed the payload pointer).
Native oracle: test/fixtures/native_generic_enum_struct_payload_bind/main.spl.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_json.{serialize_mir_function}

fn lower_module_json(src: text) -> Dict<text, text>:
    val module = parse_full_frontend(src, "gen_enum.spl", "gen_enum.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("gen_enum.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var out: Dict<text, text> = {}
    for function in mir.functions.values():
        val dot = function.name.rfind(".")
        val short = if dot >= 0: function.name.substring(dot + 1, function.name.len()) else: function.name
        out[short] = serialize_mir_function(function)
    out

fn get_field_dest(mir: text) -> text:
    val at = mir.index_of("\"GetField\":")
    if at < 0:
        return ""
    val rest = mir.substring(at, mir.len())
    val dest_tail = rest.substring(rest.index_of("\"dest\":") + 7, rest.len())
    dest_tail.substring(0, dest_tail.index_of(","))

# Two fields so a field-0 fallback (`pad`) cannot pass for `id`.
val SOURCE: text = "struct Lid:\n    pad: i64\n    id: i64\n\n" +
    "enum Box<T>:\n    Full(item: T)\n    Empty\n\n" +
    "enum Two<A, B>:\n    Both(a: A, b: B)\n    Neither\n\n" +
    "fn free_first(b: Box<Lid>) -> i64:\n    match b:\n        case Full(item): item.id\n        case Empty: -1\n\n" +
    "fn multi_first(t: Two<Lid, i64>) -> i64:\n    match t:\n        case Both(a, b): a.id\n        case Neither: -1\n\n" +
    "fn multi_second(t: Two<i64, Lid>) -> i64:\n    match t:\n        case Both(a, b): b.id\n        case Neither: -1\n\n" +
    "enum Mix<T>:\n    M(a: T, l: Lid)\n    MNone\n\n" +
    "fn mixed_concrete(m: Mix<i64>) -> i64:\n    match m:\n        case M(a, l): l.id\n        case MNone: -1\n\n" +
    "class Cl:\n    pad: i64\n    id: i64\n\n" +
    "enum MixC<T>:\n    MC(a: T, c: Cl)\n    MCNone\n\n" +
    "fn mixed_class(m: MixC<i64>) -> i64:\n    match m:\n        case MC(a, c): c.id\n        case MCNone: -1\n"

fn expect_reads_id(mir: text):
    val dest = get_field_dest(mir)
    expect(dest != "").to_equal(true)
    expect(mir).to_contain("\"field\":1}")
    expect(mir.contains("\"field\":0}")).to_equal(false)
    expect(mir).to_contain("\"id\":{dest},\"name\":null,\"type\":\"I64\"")
    expect(mir).to_contain("\"src\":{dest}")

describe "record payload of a user generic enum":
    it "reads the field as i64 and copies it into the arm result":
        expect_reads_id(lower_module_json(SOURCE)["free_first"] ?? "")

    it "tags the first binder of a multi-slot generic variant":
        expect_reads_id(lower_module_json(SOURCE)["multi_first"] ?? "")

    it "tags the second binder of a multi-slot generic variant":
        expect_reads_id(lower_module_json(SOURCE)["multi_second"] ?? "")

    it "tags a concrete record slot of a generic multi-slot variant":
        # `l: Lid` is declared concrete inside `Mix<T>`; the generic owner
        # still withholds the declared-slot decode, so `l.id` read field 0.
        expect_reads_id(lower_module_json(SOURCE)["mixed_concrete"] ?? "")

    it "tags a concrete class slot of a generic multi-slot variant":
        expect_reads_id(lower_module_json(SOURCE)["mixed_class"] ?? "")
