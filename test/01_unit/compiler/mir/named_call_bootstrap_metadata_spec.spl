# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/stage2_bootstrap_parameter_metadata_gap_2026-11-16.md
use std.spec.*
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLowering.named_call_arguments_v1.*
use compiler.hir.hir_definitions.{HirParam, HirExpr, HirExprKind, HirCallArg}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}

fn ncm_span() -> Span:
    Span(start: 0, end: 0, line: 0, col: 1, file: "synthetic", length: 0)

fn ncm_text_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: ncm_span())

fn ncm_nil() -> HirExpr:
    HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: ncm_text_type(), span: ncm_span())

fn ncm_param(id: i64, name: text) -> HirParam:
    HirParam(symbol: SymbolId(id: id), name: name, type_: ncm_text_type(), has_default: false, default: ncm_nil(), span: ncm_span(), is_mutable: false)

fn ncm_arg(name: text) -> HirCallArg:
    HirCallArg(has_name: true, name: name, value: ncm_nil(), span: ncm_span())

describe "Named call bootstrap parameter metadata":
    it "registers parameters of a callee that has no defaults":
        bootstrap_fn_param_defaults_register("ncm.mod.env_set", [ncm_param(1, "key"), ncm_param(2, "value")], "ncm.mod")
        val found = bootstrap_fn_param_defaults_lookup("ncm.mod.env_set")
        expect(found.?).to_equal(true)
        expect((found ?? []).len()).to_equal(2)

    it "binds a named call to a no-default callee through bootstrap lowering":
        bootstrap_fn_param_defaults_register("ncm.mod.pair", [ncm_param(1, "key"), ncm_param(2, "value")], "ncm.mod")
        var lowering = MirLowering.new(SymbolTable.new())
        expect(lowering.named_call_slots_v1("ncm.mod.pair", [ncm_arg("value"), ncm_arg("key")])).to_equal(Ok([1, 0]))
