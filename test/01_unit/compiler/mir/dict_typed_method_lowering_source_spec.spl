extern fn rt_file_read_text(path: text) -> text

describe "typed Dict method lowering":
    it "routes typed receivers through the shared runtime owner":
        val types = rt_file_read_text("src/compiler/20.hir/hir_lowering/types.spl") ?? ""
        val source = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        val dispatch = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        val harness = rt_file_read_text("scripts/check/check-native-seed-parity.shs") ?? ""

        expect(types).to_contain("case \"Dict\":")
        expect(types).to_contain("HirTypeKind.Dict(hir_args[0], hir_args[1])")
        expect(source).to_contain("case Dict(_, _): receiver_is_dict = true")
        expect(source).to_contain("resolution_is_unresolved or resolved_dict_probe_is_safe")
        expect(source).to_contain("dict_recv_local = prelowered_method_receiver")
        expect(source).to_contain("self.build_args_from_receiver(prelowered_method_receiver, args)")
        expect(source).to_contain("MirConstValue.Str(\"rt_dict_contains\")")
        expect(dispatch).to_contain("case HirTypeKind.Dict(_, _):")
        expect(dispatch).to_contain("self.runtime_dict_locals[result.id] = true")
        expect(harness).to_contain("fn has_key(d: Dict<text, i64>, key: text) -> bool:")
        expect(harness).to_contain("print(has_key(d, \"z\"))")

    it "lowers resolved primitive method markers before generic calls":
        val source = rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        val llvm_lib = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_translate.spl") ?? ""
        val harness = rt_file_read_text("scripts/check/check-native-seed-parity.shs") ?? ""

        expect(source).to_contain("method == \"byte_at\" and args.len() == 1 and primitive_receiver_is_text")
        expect(source).to_contain("val byte_index = byte_index_builder.emit_cast(mir_operand_copy(byte_index_raw), MirType.i64())")
        expect(source).to_contain("MirBinOp.Offset")
        expect(source).to_contain("val byte_mask = byte_load_builder.emit_const_int(255)")
        expect(source).to_contain("method == \"to_f32\" and args.len() == 0 and primitive_receiver_is_numeric")
        expect(source).to_contain("MirType(kind: MirTypeKind.F32)")
        expect(source).to_contain("method == \"round\" and args.len() == 0 and primitive_receiver_is_f64")
        expect(source).to_contain("MirConstValue.Str(\"round\")")
        expect(source.contains("MirConstValue.Str(\"f64.round\")")).to_equal(false)
        expect(llvm_lib).to_contain("declare_fn(mod_, \"round\", llvm_function_type(double_ty, [double_ty], false))")
        expect(harness).to_contain("write_case_primitive_method_lowering()")
        expect(harness).to_contain("run_native_authoritative_case primitive_method_lowering write_case_primitive_method_lowering \"11111111\"")

    it "keeps the first self-host stage off ambiguous has dispatch":
        val source = rt_file_read_text("src/compiler/20.hir/hir_lowering/expressions.spl") ?? ""

        expect(source).to_contain("extern fn rt_dict_contains(dict: i64, key: Any) -> bool")
        expect(source.contains("self.local_tuple_types.has(")).to_equal(false)
        expect(source.contains("self.local_struct_types.has(")).to_equal(false)
        expect(source.contains("self.struct_field_types_by_name.has(")).to_equal(false)
        expect(source.contains("fld_struct_fields.has(")).to_equal(false)
        expect(source.contains("fld_owner_fields.has(")).to_equal(false)

    it "keeps JSON object has receivers statically typed":
        val source = rt_file_read_text("src/lib/common/json/object_ops.spl") ?? ""

        expect(source.split("val map: Dict<text, any> = json_to_object(obj)").len() - 1).to_equal(3)
        expect(source.split("map.has(key)").len() - 1).to_equal(3)
