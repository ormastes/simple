# Actual imported HIR/MIR paths; native execution has separate SDN coverage.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLoweringExpr.result_tuple_payload.*
use compiler.mir._MirLoweringExpr.result_err_record_owner.{result_err_layout_identity}
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*

class ProviderTupleFixture:
    lowering: MirLowering
    function: MirFunction
    payload: HirType
    producer: MirFunction
    provider_symbols: SymbolTable
    provider_payload: HirType

val provider_tuple_source = "pub enum Value:\n    Token(i64)\npub class Location:\n    line: i64\n    column: i64\npub struct Issue:\n    kind: i64\n    detail: i64\npub fn produce() -> Result<(Value, Dict<text, Location>, [Issue]), text>:\n    Ok((Value.Token(31), \{\"item\": Location(line: 2, column: 5)\}, [Issue(kind: 3, detail: 7)]))\n"
val provider_tuple_consumer = "use app.tuple.provider.\{produce, Value as ProviderValue\}\nenum Value:\n    Token(text)\nclass Location:\n    column: text\n    line: text\nstruct Issue:\n    detail: text\n    kind: text\nfn inspect() -> Result<i64, text>:\n    val parsed = produce()?\n    var assigned = parsed\n    val copied = assigned\n    assigned = copied\n    val root = assigned.0\n    val spans = assigned.1\n    val issues = assigned.2\n    var value = 0\n    match root:\n        case ProviderValue.Token(number): value = number\n    var total = 0\n    for issue in issues:\n        total = total + issue.detail\n    Ok(value + spans[\"item\"].column + total)\n"

fn provider_tuple_fixture() -> ProviderTupleFixture:
    val log = Logger(level: 0)
    val provider_ast = parse_full_frontend(provider_tuple_source, "app/tuple/provider.spl", "app.tuple.provider", log)
    val consumer_ast = parse_full_frontend(provider_tuple_consumer, "app/tuple/consumer.spl", "app.tuple.consumer", log)
    var modules: Dict<text, Module> = {}
    modules["app.tuple.provider"] = provider_ast
    val files = [SourceFile(path: "app/tuple/provider.spl", content: provider_tuple_source, module_name: "app.tuple.provider")]
    if val surfaces = module_surfaces_from_modules(modules, files):
        var provider_hir = hirlowering_for_module("app/tuple/provider.spl", surfaces)
        var consumer_hir = hirlowering_for_module("app/tuple/consumer.spl", surfaces)
        val provider = provider_hir.lower_module(provider_ast)
        val consumer = consumer_hir.lower_module(consumer_ast)
        expect(provider_hir.errors.len()).to_equal(0)
        expect(consumer_hir.errors.len()).to_equal(0)
        var producer_lowering = MirLowering.new(provider.symbols)
        val producer_mir = producer_lowering.lower_module(provider, [provider])
        expect(producer_lowering.errors.len()).to_equal(0)
        var lowering = MirLowering.new(consumer.symbols)
        var prescan_mods: Dict<text, HirModule> = {}
        prescan_mods["consumer"] = consumer
        prescan_mods["provider"] = provider
        lowering.prescan_module_struct_names(prescan_mods, "consumer")
        lowering.prescan_module_struct_names(prescan_mods, "provider")
        val mir = lowering.lower_module(consumer, [consumer, provider])
        expect(lowering.errors.len()).to_equal(0)
        for function in mir.functions.values():
            if function.name.ends_with(".inspect") or function.name == "inspect":
                for source_function in provider.functions.values():
                    if source_function.name == "produce":
                        val relocated = lowering.relocate_provider_type(source_function.return_type, provider.symbols)
                        match relocated.kind:
                            case HirTypeKind.Result(payload, _):
                                val imported = consumer.symbols.exact_symbols["produce"]
                                if val callable_return = lowering.resolved_call_hir_return_type(SymbolId(id: imported)):
                                    expect(callable_return.kind).to_equal(relocated.kind)
                                else: fail("imported callable lost its consumer-owned signature")
                                match source_function.return_type.kind:
                                    case HirTypeKind.Result(provider_payload, _):
                                        for producer in producer_mir.functions.values():
                                            if producer.name == "produce" or producer.name.ends_with(".produce"):
                                                return ProviderTupleFixture(lowering: lowering, function: function, payload: payload, producer: producer, provider_symbols: provider.symbols, provider_payload: provider_payload)
                                    case _: fail("producer lost its source tuple")
                            case _: fail("producer lost its declared Result return type")
        fail("missing lowered consumer or declared producer")
    fail("provider surfaces could not be constructed")

fn provider_tuple_fields(type_: HirType) -> [HirType]:
    match type_.kind:
        case HirTypeKind.Tuple(fields): fields
        case _: fail("expected declared tuple")

fn provider_tuple_local_type(function: MirFunction, id: i64) -> MirType:
    for local in function.locals:
        if local.id.id == id: return local.type_
    fail("missing producer local")

fn provider_tuple_call_count(function: MirFunction, name: text) -> i64:
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(actual), _):
                            if actual == name or actual.ends_with("." + name): count = count + 1
                        case _: ()
                case _: ()
    count

describe "Result try tuples with imported provider handles":
    it "uses the producer's actual collection handle fields in the raw tuple":
        val fixture = provider_tuple_fixture()
        var tuples = 0
        for block in fixture.producer.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Aggregate(destination, AggregateKind.Tuple, operands):
                        match provider_tuple_local_type(fixture.producer, destination.id).kind:
                            case MirTypeKind.Tuple(fields):
                                expect(fields.len()).to_equal(3)
                                expect(operands.len()).to_equal(3)
                                match fields[0].kind:
                                    case MirTypeKind.I64 | MirTypeKind.Struct(_) | MirTypeKind.Opaque(_): ()
                                    case _: fail("enum must occupy a runtime handle word")
                                match fields[1].kind:
                                    case MirTypeKind.Dict(_, _): ()
                                    case _: fail("dictionary producer lost its typed runtime handle")
                                match fields[2].kind:
                                    case MirTypeKind.Array(_, count): expect(count).to_equal(1)
                                    case _: fail("array producer lost its typed runtime handle")
                                tuples = tuples + 1
                            case _: fail("tuple aggregate lost its field types")
                    case _: ()
        expect(tuples).to_equal(1)
        expect(provider_tuple_call_count(fixture.producer, "rt_dict_new")).to_equal(1)
        expect(provider_tuple_call_count(fixture.producer, "rt_enum_new")).to_be_greater_than(0)

    it "relocates a real producer signature despite a valid foreign ID collision":
        val fixture = provider_tuple_fixture()
        val source_fields = provider_tuple_fields(fixture.provider_payload)
        match source_fields[0].kind:
            case HirTypeKind.Named(foreign_id, _):
                var current = SymbolTable.new()
                current.next_symbol_id = foreign_id.id
                val decoy = current.define("Value", SymbolKind.Enum, nil, Span.empty(), Visibility.Public, false, Some("app.unrelated"))
                current.bind_qualified_type("app.unrelated", "Value", decoy)
                expect(decoy.id).to_equal(foreign_id.id)
                var lowering = MirLowering.new(current)
                val relocated = lowering.relocate_provider_type(fixture.provider_payload, fixture.provider_symbols)
                val fields = provider_tuple_fields(relocated)
                match fields[0].kind:
                    case HirTypeKind.Named(actual, _):
                        expect(actual.id != decoy.id).to_be(true)
                        expect(actual.id).to_equal(lowering.symbols.lookup_qualified_type_raw("app.tuple.provider", "Value"))
                        expect(lowering.symbols.symbols[actual.id].defining_module).to_equal(Some("app.tuple.provider"))
                    case _: fail("relocation lost the provider enum")
                match fields[1].kind:
                    case HirTypeKind.Dict(_, value):
                        match value.kind:
                            case HirTypeKind.Named(actual, _): expect(actual.id).to_equal(lowering.symbols.lookup_qualified_type_raw("app.tuple.provider", "Location"))
                            case _: fail("relocation lost dictionary owner")
                    case _: fail("relocation lost dictionary type")
                match fields[2].kind:
                    case HirTypeKind.Array(value, _):
                        match value.kind:
                            case HirTypeKind.Named(actual, _): expect(actual.id).to_equal(lowering.symbols.lookup_qualified_type_raw("app.tuple.provider", "Issue"))
                            case _: fail("relocation lost array owner")
                    case _: fail("relocation lost array type")
            case _: fail("producer lost enum signature")

    it "lowers the imported tuple without guessing names or evaluating the call twice":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        val fields = provider_tuple_fields(fixture.payload)
        expect(fields.len()).to_equal(3)
        expect(lowering.result_try_tuple_nominal_owner(fields[0], false)).to_equal("app.tuple.provider.Value")
        expect(provider_tuple_call_count(fixture.function, "produce")).to_equal(1)
        expect(provider_tuple_call_count(fixture.function, "rt_enum_payload")).to_be_greater_than(0)
        expect(lowering.result_try_tuple_payload_type(fixture.payload) != nil).to_be(true)

    it "restores exact HIR and collection owners after tuple copying and assignment":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        var enum_projection = false
        var dict_projection = false
        var array_projection = false
        for block in fixture.function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.GetField(destination, _, field):
                        if val remembered = lowering.find_local_hir_type(destination.id):
                            match remembered.kind:
                                case HirTypeKind.Named(_, _):
                                    if field == 0 and lowering.result_try_tuple_nominal_owner(remembered, false) == "app.tuple.provider.Value":
                                        enum_projection = true
                                case HirTypeKind.Dict(_, _):
                                    if field == 1:
                                        dict_projection = lowering.runtime_dict_locals.has(destination.id)
                                        expect(lowering.array_element_struct_syms[destination.id]).to_equal("app.tuple.provider.Location")
                                case HirTypeKind.Array(element, _):
                                    if field == 2:
                                        array_projection = lowering.runtime_array_locals.has(destination.id)
                                        val owner = lowering.result_try_tuple_nominal_owner(element, true)
                                        expect(result_err_layout_identity(owner)).to_equal("app.tuple.provider::Issue")
                                        expect(lowering.array_element_struct_syms[destination.id]).to_equal(owner)
                                        expect(lowering.runtime_elem_value_type.has(destination.id)).to_be(true)
                                case _: ()
                    case _: ()
        expect(enum_projection and dict_projection and array_projection).to_be(true)

    it "rejects a missing current declaration even if the name was registered":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        val fields = provider_tuple_fields(fixture.payload)
        val absent = HirType(kind: HirTypeKind.Named(SymbolId(id: lowering.symbols.next_symbol_id + 100), []), span: Span.empty())
        val bad = HirType(kind: HirTypeKind.Tuple([absent, fields[1], fields[2]]), span: Span.empty())
        expect(lowering.result_try_tuple_payload_type(bad)).to_be_nil()

    it "rejects a qualified entry pointing to the consumer homonym":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        val decoy = lowering.symbols.exact_symbols["Value"]
        lowering.symbols.qualified_types["app.tuple.provider#Value"] = decoy
        expect(lowering.result_try_tuple_payload_type(fixture.payload)).to_be_nil()

    it "rejects a non-enum declaration at the otherwise valid current ID":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        val id = lowering.symbols.lookup_qualified_type_raw("app.tuple.provider", "Value")
        var declaration: HirSymbol = lowering.symbols.symbols[id]
        declaration.kind = SymbolKind.Function
        lowering.symbols.symbols[id] = declaration
        expect(lowering.result_try_tuple_payload_type(fixture.payload)).to_be_nil()

    it "rejects conflicting record layout and semantic field metadata":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        lowering.composite_layout_owner_counts["app.tuple.provider::Issue"] = 2
        expect(lowering.result_try_tuple_payload_type(fixture.payload)).to_be_nil()
        lowering.composite_layout_owner_counts["app.tuple.provider::Issue"] = 1
        lowering.result_err_layout_types["app.tuple.provider::Issue"] = ""
        expect(lowering.result_try_tuple_payload_type(fixture.payload)).to_be_nil()

    it "keeps direct text and Dict of value-record tuple fields unsupported":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        val span = Span.empty()
        val text_type = HirType(kind: HirTypeKind.Str, span: span)
        val text_tuple = HirType(kind: HirTypeKind.Tuple([text_type]), span: span)
        expect(lowering.result_try_tuple_payload_type(text_tuple)).to_be_nil()
        val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val fixed = HirType(kind: HirTypeKind.Array(integer, Some(2)), span: span)
        val slice = HirType(kind: HirTypeKind.Slice(integer), span: span)
        expect(lowering.result_try_tuple_payload_type(HirType(kind: HirTypeKind.Tuple([fixed]), span: span))).to_be_nil()
        expect(lowering.result_try_tuple_payload_type(HirType(kind: HirTypeKind.Tuple([slice]), span: span))).to_be_nil()
        val fields = provider_tuple_fields(fixture.payload)
        match fields[2].kind:
            case HirTypeKind.Array(issue, _):
                val dict = HirType(kind: HirTypeKind.Dict(text_type, issue), span: span)
                val dict_tuple = HirType(kind: HirTypeKind.Tuple([dict]), span: span)
                expect(lowering.result_try_tuple_payload_type(dict_tuple)).to_be_nil()
            case _: fail("fixture lost its record array")

    it "preserves numeric tuple admission and the Err cleanup edge":
        val fixture = provider_tuple_fixture()
        var lowering = fixture.lowering
        val span = Span.empty()
        val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val boolean = HirType(kind: HirTypeKind.Bool, span: span)
        val float_type = HirType(kind: HirTypeKind.Float(64), span: span)
        val pair = HirType(kind: HirTypeKind.Tuple([integer, integer]), span: span)
        val numeric = HirType(kind: HirTypeKind.Tuple([boolean, float_type, pair]), span: span)
        expect(lowering.result_try_tuple_payload_type(numeric)).to_equal(result_tuple_payload_type(numeric))
        val result_type = HirType(kind: HirTypeKind.Result(fixture.payload, HirType(kind: HirTypeKind.Str, span: span)), span: span)
        val symbol = lowering.symbols.define("pending", SymbolKind.Parameter, result_type, span, Visibility.Private, false, Some("app.tuple.consumer"))
        var builder = lowering.builder
        builder.begin_function(SymbolId(id: 9001), "cleanup", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), span)
        val pending = builder.emit_const_int(0)
        val owned = builder.emit_const_int(17)
        lowering.builder = builder
        lowering.bind_local(symbol.id, pending)
        lowering.remember_local_hir_type(pending.id, result_type, 0, 0)
        lowering.resource_owned_locals = [owned]
        val receiver = HirExpr(kind: HirExprKind.Var(symbol), has_type_: true, type_: result_type, span: span)
        lowering.lower_try_expr(receiver)
        expect(lowering.errors.len()).to_equal(0)
        var finished = lowering.builder
        val function = finished.end_function()
        var drops = 0
        var returns_original = 0
        for block in function.blocks:
            if block.label == Some("try_err"):
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Drop(local):
                            expect(local.id).to_equal(owned.id)
                            drops = drops + 1
                        case _: ()
                if block.bootstrap_ret_kind() == 1 and block.bootstrap_ret_local_id() == pending.id:
                    returns_original = returns_original + 1
        expect(drops).to_equal(1)
        expect(returns_original).to_equal(1)
