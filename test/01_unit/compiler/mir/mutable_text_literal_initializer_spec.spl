# Mutable literal text uses the existing once-only module initializer.
use std.spec.*
use std.io_runtime.{file_read}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserConst}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_globals.*
use compiler.mir._MirLowering.global_initializer_guard.*
use compiler.backend.cranelift_codegen_adapter.{cranelift_static_init_supported}

val mutable_text_source = "var mode = \"framed\"\nvar last: text = \"\"\nvar unicode_text: text = \"한🙂\"\nvar nul_text: text = \"a\\0b\"\nvar snapshot: text = mode + \":\" + last\nval immutable_text = \"constant\"\nvar numeric: i64 = 19\npub fn get_mode() -> text:\n    mode\nfn set_mode():\n    mode = \"jsonl\"\n"

class MutableTextFixture:
    hir: HirModule
    mir: MirModule

fn mutable_text_fixture() -> MutableTextFixture:
    val parsed = parse_full_frontend(mutable_text_source, "literal_provider.spl", "literal_provider", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("literal_provider.spl")
    val hir = hir_lowering.lower_module(parsed)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    MutableTextFixture(hir: hir, mir: mir)

fn mutable_text_const(hir: HirModule, name: text) -> HirConst:
    for constant in hir.constants.values():
        if constant.name == name: return constant
    fail("missing literal global " + name)

fn actual_lsp_literal(path: text, name: text, value: text):
    val source = file_read(path)
    expect(source.len()).to_be_greater_than(0)
    val parsed = parse_full_frontend(source, path, path, Logger(level: 0))
    expect(parsed.constants.has(name)).to_be(true)
    val declaration: ParserConst = parsed.constants[name]
    var lowering = HirLowering.with_filename(path)
    lowering.symbols.define(name, SymbolKind.Const, nil, declaration.span, Visibility.Private, declaration.is_mutable, Some(path))
    val constant = lowering.lower_hir_const_decl(declaration)
    expect(lowering.errors.len()).to_equal(0)
    expect(constant.is_mutable).to_be(true)
    expect(constant.type_.kind).to_equal(HirTypeKind.Str)
    match constant.value.kind:
        case HirExprKind.StringLit(text_value, _): expect(text_value).to_equal(value)
        case _: fail("LSP initializer stopped being a text literal")
    expect(runtime_module_initializer_supported(constant)).to_be(true)

describe "mutable text literal module initialization":
    it "admits both actual LSP mutable declarations through their parsed HIR":
        actual_lsp_literal("src/app/simple_lsp_mcp/json_helpers.spl", "_TRANSPORT_MODE", "framed")
        actual_lsp_literal("src/app/simple_lsp_mcp/session_state.spl", "_LSP_LAST_FILE", "")

    it "preserves exact symbols owner names mutability and boxed storage type":
        val fixture = mutable_text_fixture()
        for name in ["mode", "last", "unicode_text", "nul_text"]:
            val constant = mutable_text_const(fixture.hir, name)
            var found = 0
            for storage in fixture.mir.statics.values():
                if storage.symbol.id == constant.symbol.id:
                    found = found + 1
                    expect(storage.name).to_equal(mir_global_storage_name("literal_provider.spl", name))
                    expect(storage.is_mutable).to_be(true)
                    expect(storage.visibility).to_equal(constant.visibility)
                    expect(storage.type_.kind).to_equal(MirTypeKind.Opaque("str"))
                    expect(storage.init).to_be_nil()
                    expect(cranelift_static_init_supported(storage)).to_be(true)
            expect(found).to_equal(1)

    it "stores literals once in declaration order before dependent initialization":
        val fixture = mutable_text_fixture()
        val names = ["mode", "last", "unicode_text", "nul_text", "snapshot"]
        var expected: [i64] = []
        for name in names: expected.push(mutable_text_const(fixture.hir, name).symbol.id)
        var writes: [i64] = []
        var initializers = 0
        var guarded_done = false
        var guard_start = false
        var literals = 0
        val literal_values = ["framed", "", "한🙂", "a\0b"]
        for function in fixture.mir.functions.values():
            if function.name.starts_with("__module_init_"):
                initializers = initializers + 1
                for block in function.blocks:
                    if block.label == Some("initializer_done"):
                        guarded_done = true
                        expect(block.instructions.len()).to_equal(0)
                        expect(block.bootstrap_ret_kind()).to_equal(0)
                    if block.label == Some("initializer_start"): guard_start = true
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.Const(_, MirConstValue.Str(value), type_):
                                if literal_values.contains(value):
                                    expect(type_.kind).to_equal(MirTypeKind.Opaque("str"))
                                    literals = literals + 1
                            case MirInstKind.StoreGlobal(symbol, _):
                                if expected.contains(symbol.id): writes.push(symbol.id)
                            case _: ()
        expect(initializers).to_equal(1)
        expect(writes).to_equal(expected)
        expect(literals).to_equal(4)
        expect(guarded_done and guard_start).to_be(true)

    it "keeps ordinary getters as global loads instead of replaying the literal":
        val fixture = mutable_text_fixture()
        val symbol = mutable_text_const(fixture.hir, "mode").symbol.id
        var loads = 0
        var writes = 0
        var calls = 0
        var found = false
        for function in fixture.mir.functions.values():
            if function.name == "get_mode" or function.name.ends_with(".get_mode"):
                found = true
                for block in function.blocks:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.LoadGlobal(_, target):
                                if target.id == symbol: loads = loads + 1
                            case MirInstKind.StoreGlobal(target, _):
                                if target.id == symbol: writes = writes + 1
                            case MirInstKind.Call(_, _, _): calls = calls + 1
                            case _: ()
        expect(found).to_be(true)
        expect(loads).to_equal(1)
        expect(writes).to_equal(0)
        expect(calls).to_equal(0)

    it "retains provider callable initialization binding for mutable literals":
        val fixture = mutable_text_fixture()
        var lowering = MirLowering.new(SymbolTable.new())
        var callables: Dict<text, [i64]> = {}
        callables["literal_provider"] = [77]
        # Only the literal is supplied: the dependent Binary initializer
        # must not make this test pass under the old interpolation-only rule.
        val constants = [mutable_text_const(fixture.hir, "mode")]
        lowering.register_provider_global_bindings("literal_provider", fixture.hir.symbols, constants, {}, {}, callables)
        expect(lowering.imported_global_initializers[77]).to_equal(mir_global_initializer_wrapper_name("literal_provider"))
        expect(lowering.errors.len()).to_equal(0)

    it "does not broaden immutable numeric or mismatched literal declarations":
        val fixture = mutable_text_fixture()
        expect(runtime_module_initializer_supported(mutable_text_const(fixture.hir, "immutable_text"))).to_be(false)
        expect(runtime_module_initializer_supported(mutable_text_const(fixture.hir, "numeric"))).to_be(false)
        var mismatched = mutable_text_const(fixture.hir, "mode")
        mismatched.type_ = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        expect(runtime_module_initializer_supported(mismatched)).to_be(false)
        val integer = mutable_text_const(fixture.hir, "numeric")
        var numeric_present = false
        for storage in fixture.mir.statics.values():
            if storage.symbol.id == integer.symbol.id:
                numeric_present = true
                expect(storage.init.?).to_be(true)
                expect(storage.type_.kind).to_equal(MirTypeKind.I64)
        expect(numeric_present).to_be(true)
