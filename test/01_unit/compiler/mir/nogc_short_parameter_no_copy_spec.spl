"""AC-OWN-02: readonly and mutable short parameters keep the incoming owner.

This exercises parsed HIR and actual MIR function lowering. Production driver
admission and native execution remain separate verification gates.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.function_lowering.*

fn short_parameter_lowering_counts(mutable: bool, strict: bool) -> [i64]:
    val parameter = if mutable: "mut Pair" else: "Pair"
    val source = "struct Pair:\n    value: i64\n\nfn inspect(input: {parameter}) -> i64:\n    input.value\n"
    val parsed = parse_full_frontend(source, "short_parameter.spl", "short_parameter.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("short_parameter.spl")
    val hir = hir_lowering.lower_module(parsed)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    # Populate real declaration/layout registries through ordinary module
    # lowering, then exercise the parameter entry path with explicit policy.
    lowering.lower_module(hir)
    lowering.nogc_strict = strict
    var found = 0
    var allocations = 0
    var aggregates = 0
    var incoming_reads = 0
    var marked = 0
    for declaration in hir.functions.values():
        if declaration.name != "inspect": continue
        found = found + 1
        val function = lowering.lower_function(declaration)
        var argument_id = -1
        for local in function.locals:
            match local.kind:
                case LocalKind.Arg(0):
                    argument_id = local.id.id
                    if local.short_borrow and local.short_mutable == mutable and local.short_boundary == declaration.symbol.id:
                        marked = marked + 1
                case _: ()
        expect(argument_id >= 0).to_equal(true)
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Alloc(_, _): allocations = allocations + 1
                    case MirInstKind.Aggregate(_, _, _): aggregates = aggregates + 1
                    case MirInstKind.GetField(_, operand, _):
                        match operand.kind:
                            case MirOperandKind.Copy(local):
                                if local.id == argument_id: incoming_reads = incoming_reads + 1
                            case _: ()
                    case _: ()
    expect(found).to_equal(1)
    expect(lowering.errors.len()).to_equal(0)
    [allocations, aggregates, incoming_reads, marked]

describe "AC-OWN-02 short parameter entry":
    it "reads a strict readonly struct directly without a hidden copy":
        val counts = short_parameter_lowering_counts(false, true)
        expect(counts[0]).to_equal(0)
        expect(counts[1]).to_equal(0)
        expect(counts[2]).to_equal(1)
        expect(counts[3]).to_equal(1)

    it "keeps a strict mutable struct on its original incoming place":
        val counts = short_parameter_lowering_counts(true, true)
        expect(counts[0]).to_equal(0)
        expect(counts[1]).to_equal(0)
        expect(counts[2]).to_equal(1)
        expect(counts[3]).to_equal(1)

    it "preserves legacy readonly value-copy behavior":
        val counts = short_parameter_lowering_counts(false, false)
        expect(counts[0] > 0 or counts[1] > 0).to_equal(true)
        expect(counts[3]).to_equal(0)
