# MIR-only: builtin Array.extend must lower (bug mcp_native_array_extend_2026_10_12).
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

fn extend_errors(source: text) -> text:
    val filename = "array_extend_lowering.spl"
    val module = parse_full_frontend(source, filename, filename, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(filename)
    val hir = hir_lowering.lower_module(module)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var out = ""
    for error in hir_lowering.errors:
        out = out + "HIR_ERROR:" + error.message + "\n"
    for error in lowering.errors:
        out = out + "MIR_ERROR:" + error.message + "\n"
    out + "FUNCTIONS:" + mir.functions.len().to_text()

describe "Array.extend MIR lowering":
    it "lowers text-array extend without an unresolved method error":
        val out = extend_errors("fn build(base: [text], more: [text]) -> [text]:\n    var argv: [text] = base\n    argv.extend(more)\n    argv\n")
        expect(out.contains("MIR_ERROR:")).to_be(false)
        expect(out.contains("unresolved")).to_be(false)
        expect(out).to_contain("FUNCTIONS:")
