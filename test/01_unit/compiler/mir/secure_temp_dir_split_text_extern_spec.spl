"""(ptr, len) split registry for the cycle-170 secure_temp_dir crossing.

runtime_native.c: rt_secure_temp_dir_set_parent(ptr, len) and
rt_secure_temp_dir_set_prefix(ptr, len) each take ONE text argument;
rt_secure_temp_dir_make(void) takes none. A `[0]` entry for make would ask
the MIR to split an argument that does not exist; a missing entry for
set_prefix would pass its text as one collapsed word.
"""
use std.spec.*
use compiler.mir.text_extern_abi.{text_arg_indices}

describe "secure_temp_dir split crossing text ABI":
    it "splits the single text argument of each set call":
        expect(text_arg_indices("rt_secure_temp_dir_set_parent").unwrap()).to_equal([0])
        expect(text_arg_indices("rt_secure_temp_dir_set_prefix").unwrap()).to_equal([0])
    it "leaves the zero-argument make alone":
        expect(text_arg_indices("rt_secure_temp_dir_make")).to_be_nil()
    it "keeps the two-argument form":
        expect(text_arg_indices("rt_secure_temp_dir").unwrap()).to_equal([0, 1])
