"""Text ABI registry for the cycle-170 secure_temp_dir split crossing.

runtime_native.c: rt_secure_temp_dir_set_parent(value) and
rt_secure_temp_dir_set_prefix(value) each take ONE boxed text RuntimeValue;
rt_secure_temp_dir_make(void) takes none. None of the three may carry a
(ptr, len) row: a row made the machine ABI depend on whether the seed's own
table had it, and a tracked seed that predated the row passed the handle
plus an unrelated register, which the C admission refused (see
doc/08_tracking/bug/tracked_seed_cranelift_split_secure_temp_dir_refuses_20261019.md).
"""
use std.spec.*
use compiler.mir.text_extern_abi.{text_arg_indices}

describe "secure_temp_dir split crossing text ABI":
    it "passes each setter's text as one boxed value":
        expect(text_arg_indices("rt_secure_temp_dir_set_parent")).to_be_nil()
        expect(text_arg_indices("rt_secure_temp_dir_set_prefix")).to_be_nil()
    it "leaves the zero-argument make alone":
        expect(text_arg_indices("rt_secure_temp_dir_make")).to_be_nil()
    it "keeps the two-argument form":
        expect(text_arg_indices("rt_secure_temp_dir").unwrap()).to_equal([0, 1])
