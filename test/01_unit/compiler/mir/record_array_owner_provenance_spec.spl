use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirBlock}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable, HirSymbol, SymbolKind, ScopeId}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_lowering_stmts.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirSignature}

fn row_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn row_symbols(include_provider: bool) -> SymbolTable:
    var symbols = SymbolTable.new()
    symbols.register_preserved_symbol(HirSymbol(id: SymbolId(id: 77), name: "Row",
        kind: SymbolKind.Class, type_: nil, scope: ScopeId(id: 0), span: Span.empty(),
        visibility: Visibility.Public, is_public: true, is_mutable: false,
        defining_module: Some("src/decoy.spl")))
    if include_provider:
        symbols.register_preserved_symbol(HirSymbol(id: SymbolId(id: 78), name: "Row",
            kind: SymbolKind.Class, type_: nil, scope: ScopeId(id: 0), span: Span.empty(),
            visibility: Visibility.Public, is_public: true, is_mutable: false,
            defining_module: Some("src/provider.spl")))
    symbols

fn array_row_owner(value: HirType?) -> i64:
    if val known = value:
        match known.kind:
            case HirTypeKind.Array(element, _) | HirTypeKind.Slice(element):
                match element.kind:
                    case HirTypeKind.Named(owner, _): return owner.id
                    case _: return -1
            case _: return -1
    -1

describe "record array ownership across provider fields and loop bindings":
    it "rebinds array and slice elements to the exact provider instead of a colliding raw ID":
        var lowering = MirLowering.new(row_symbols(true))
        lowering.struct_field_type_ownership_key["Table"] = ["provider.Row"]
        val foreign = row_type(HirTypeKind.Named(SymbolId(id: 77), []))
        for declared in [row_type(HirTypeKind.Array(foreign, nil)), row_type(HirTypeKind.Slice(foreign))]:
            val rebound = lowering.declared_field_type_in_current_table("Table", 0, declared)
            expect(array_row_owner(rebound)).to_equal(78)

    it "does not borrow a same-named decoy when the provider is absent":
        var lowering = MirLowering.new(row_symbols(false))
        lowering.struct_field_type_ownership_key["Table"] = ["provider.Row"]
        val declared = row_type(HirTypeKind.Array(row_type(HirTypeKind.Named(SymbolId(id: 77), [])), nil))
        val rebound = lowering.declared_field_type_in_current_table("Table", 0, declared)
        expect(array_row_owner(rebound)).to_equal(-1)
        expect(lowering.errors.len()).to_be_greater_than(0)
        expect(lowering.errors[0].fatal).to_equal(true)
        expect(lowering.errors[0].message).to_contain("owner=provider.Row")
        expect(lowering.errors[0].message).to_contain("declared_symbol=77")
        expect(lowering.errors[0].message).to_contain("consumer_symbol=Row")
        expect(lowering.errors[0].message).to_contain("consumer_symbol_owner=src/decoy.spl")

    it "rejects a named field element with no provider ownership key":
        var lowering = MirLowering.new(row_symbols(true))
        val declared = row_type(HirTypeKind.Array(row_type(HirTypeKind.Named(SymbolId(id: 77), [])), nil))
        val rebound = lowering.declared_field_type_in_current_table("UnknownTable", 0, declared)
        expect(array_row_owner(rebound)).to_equal(-1)
        expect(lowering.errors.len()).to_be_greater_than(0)
        expect(lowering.errors[0].fatal).to_equal(true)

    it "rejects generic element arguments whose provider IDs cannot be relocated":
        var lowering = MirLowering.new(row_symbols(true))
        lowering.struct_field_type_ownership_key["Table"] = ["provider.Row"]
        val foreign_arg = row_type(HirTypeKind.Named(SymbolId(id: 77), []))
        val generic = row_type(HirTypeKind.Named(SymbolId(id: 78), [foreign_arg]))
        val rebound = lowering.declared_field_type_in_current_table("Table", 0, row_type(HirTypeKind.Slice(generic)))
        expect(array_row_owner(rebound)).to_equal(-1)
        expect(lowering.errors.len()).to_be_greater_than(0)
        expect(lowering.errors[0].fatal).to_equal(true)

    it "retains the exact element declaration on an indexed for binding":
        var lowering = MirLowering.new(row_symbols(true))
        var builder = lowering.builder
        builder.begin_function(SymbolId(id: 90), "probe", MirSignature(params: [],
            return_type: MirType.unit(), is_variadic: false), Span.empty())
        val collection = builder.new_temp(MirType.i64())
        lowering.builder = builder
        lowering.runtime_array_locals[collection.id] = true
        lowering.array_element_struct_syms[collection.id] = "provider.Row"
        val element = row_type(HirTypeKind.Named(SymbolId(id: 78), []))
        lowering.remember_local_hir_type(collection.id, row_type(HirTypeKind.Array(element, nil)), 0, 0)
        val empty = HirExpr(kind: HirExprKind.NilLit, has_type_: false, type_: nil, span: Span.empty())
        val body = HirBlock(stmts: [], has: false, value: empty, span: Span.empty())
        lowering.lower_for_array_indexed(SymbolId(id: 21), collection, MirType.i64(), body, Span.empty())
        val bound = lowering.symbol_bound_local(21)
        expect(bound.id).to_be_greater_than(-1)
        val binding_type = lowering.find_local_hir_type(bound.id)
        var owner = -1
        if val known = binding_type:
            match known.kind:
                case HirTypeKind.Named(symbol, _): owner = symbol.id
                case _: ()
        expect(owner).to_equal(78)
        expect(lowering.struct_value_syms[bound.id]).to_equal("provider.Row")

    it "does not attach record or array ownership to a scalar element":
        var lowering = MirLowering.new(row_symbols(true))
        lowering.remember_local_hir_type(10, row_type(HirTypeKind.Array(row_type(HirTypeKind.Int(64, true)), nil)), 0, 0)
        lowering.remember_array_index_projection_provenance(LocalId(id: 10), LocalId(id: 11))
        expect(lowering.struct_value_syms.contains(11)).to_equal(false)
        expect(lowering.runtime_array_locals.contains(11)).to_equal(false)
