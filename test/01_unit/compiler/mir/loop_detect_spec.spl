use std.spec.*
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_instructions.{
    MirFunction, MirBlock, MirTerminator, MirOperand, MirOperandKind,
    BlockId, LocalId
}
use compiler.mir.mir_types.{MirType, MirSignature}
use compiler.mir_opt.mir_opt.loop_detect.{LoopInfo, LoopDetector, loop_detector_detect_loops}

fn loop_test_block(id: i64, terminator: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId.new(id), label: nil, instructions: [], terminator: terminator)

fn loop_test_function() -> MirFunction:
    val condition = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0)))
    val blocks = [
        loop_test_block(0, MirTerminator.Goto(BlockId.new(1))),
        loop_test_block(1, MirTerminator.If(condition, BlockId.new(2), BlockId.new(4))),
        loop_test_block(2, MirTerminator.Goto(BlockId.new(3))),
        loop_test_block(3, MirTerminator.Goto(BlockId.new(1))),
        loop_test_block(4, MirTerminator.Ret(nil))
    ]
    MirFunction(
        symbol: SymbolId.new(0),
        name: "natural_loop",
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: blocks,
        entry_block: BlockId.new(0),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )

fn loop_self_function() -> MirFunction:
    MirFunction(
        symbol: SymbolId.new(1),
        name: "self_loop",
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: [loop_test_block(0, MirTerminator.Goto(BlockId.new(0)))],
        entry_block: BlockId.new(0),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )

fn loop_shared_exit_function() -> MirFunction:
    val condition = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0)))
    val blocks = [
        loop_test_block(0, MirTerminator.Goto(BlockId.new(1))),
        loop_test_block(1, MirTerminator.If(condition, BlockId.new(2), BlockId.new(3))),
        loop_test_block(2, MirTerminator.If(condition, BlockId.new(1), BlockId.new(3))),
        loop_test_block(3, MirTerminator.Ret(nil))
    ]
    MirFunction(
        symbol: SymbolId.new(2),
        name: "shared_exit_loop",
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: blocks,
        entry_block: BlockId.new(0),
        span: nil,
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )

describe "MIR natural loop detection":
    it "includes predecessors between the header and backedge source":
        val func = loop_test_function()
        val loops = loop_detector_detect_loops(func)

        expect(loops.len()).to_equal(1)
        val loop_info: LoopInfo = loops[0]
        expect(loop_info.backedges.len()).to_equal(1)
        val backedge: BlockId = loop_info.backedges[0]
        expect(backedge.id).to_equal(3)
        expect(loop_info.body.len()).to_equal(2)
        expect(loop_info.contains_block(BlockId.new(2))).to_equal(true)
        expect(loop_info.contains_block(BlockId.new(3))).to_equal(true)

        var detector = LoopDetector.new()
        detector.detect_loops(func)
        expect(detector.loops.len()).to_equal(1)
        val receiver_loop: LoopInfo = detector.loops[0]
        expect(receiver_loop.contains_block(BlockId.new(2))).to_equal(true)

    it "retains a self-loop backedge without duplicating its header in the body":
        val loops = loop_detector_detect_loops(loop_self_function())

        expect(loops.len()).to_equal(1)
        val loop_info: LoopInfo = loops[0]
        expect(loop_info.backedges.len()).to_equal(1)
        val backedge: BlockId = loop_info.backedges[0]
        expect(backedge.id).to_equal(0)
        expect(loop_info.body.len()).to_equal(0)

    it "keeps distinct exit edges that share a destination":
        val loops = loop_detector_detect_loops(loop_shared_exit_function())

        expect(loops.len()).to_equal(1)
        val loop_info: LoopInfo = loops[0]
        expect(loop_info.exit_edges.len()).to_equal(2)
