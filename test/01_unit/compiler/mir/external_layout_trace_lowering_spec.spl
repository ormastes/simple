use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.driver.cache.native_module_witness_facts.{
    native_external_layout_facts_from_mir_v1
}

describe "external layout witness instrumentation":
    it "records the canonical layout actually referenced during consumer MIR lowering":
        val log = Logger(level: 0)
        val provider_source = "pub struct External:\n    tag: u8\n    value: i64"
        val consumer_source = "use lib.dep.\{External\}\n\nfn accept(value: External) -> External:\n    value"
        val provider_ast = parse_full_frontend(
            provider_source, "lib/dep.spl", "lib.dep", log)
        val consumer_ast = parse_full_frontend(
            consumer_source, "app/main.spl", "app.main", log)
        var modules: Dict<text, Module> = {}
        modules["lib.dep"] = provider_ast
        val sources = [SourceFile(
            path: "lib/dep.spl", content: provider_source,
            module_name: "lib.dep")]
        val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
        var provider_lowering = hirlowering_for_module("lib.dep", surfaces)
        var consumer_lowering = hirlowering_for_module("app.main", surfaces)
        val provider_hir = provider_lowering.lower_module(provider_ast)
        val consumer_hir = consumer_lowering.lower_module(consumer_ast)
        expect(consumer_lowering.errors.len()).to_equal(0)

        var mir_lowering = MirLowering.new(consumer_hir.symbols)
        mir_lowering.prescan_module_struct_names(provider_hir)
        mir_lowering.prescan_module_struct_names(consumer_hir)
        val consumer_mir = mir_lowering.lower_module(consumer_hir)
        expect(consumer_mir.external_layout_traces.len()).to_equal(1)
        if consumer_mir.external_layout_traces.len() == 0:
            return
        expect(consumer_mir.external_layout_traces[0].owner_module_id).to_equal(
            "lib.dep")
        expect(consumer_mir.external_layout_traces[0].type_id).to_equal(
            "External")
        expect(consumer_mir.external_layout_traces[0].layout_digest == "").to_equal(
            false)
        expect(consumer_mir.external_layout_traces[0].owner_count).to_equal(1)

        val facts = native_external_layout_facts_from_mir_v1(
            consumer_mir, true)
        expect(facts.valid).to_equal(true)
        expect(facts.layouts.len()).to_equal(1)
        expect(facts.layouts[0].layout_digest).to_equal(
            consumer_mir.external_layout_traces[0].layout_digest)
