extern fn rt_file_read_text(path: text) -> text

fn read_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "pure MIR array destructuring assignment lowering":
    it "routes array-pattern targets through bounded recursive extraction":
        val source = read_source("src/compiler/50.mir/mir_lowering_stmts.spl")
        val helper = source.split("me lower_array_destructuring_assign(")[1].split("me lower_assign(")[0]

        expect(source).to_contain("case ArrayLit(elements, _):")
        expect(source).to_contain("self.lower_array_destructuring_assign(elements, value_local, op)")
        expect(helper).to_contain("while element_index < elements.len():")
        expect(helper).to_contain("MirConstValue.Str(\"rt_array_get\")")
        expect(helper).to_contain("self.decode_runtime_value(raw_element, element_type)")
        expect(helper).to_contain("self.lower_assign(target_element, nil, decoded_element, target_element.kind)")
        expect(helper.contains("rt_array_copy")).to_equal(false)

    it "keeps exact, adjacent pair, and nested source reproducers":
        val fixture = read_source("test/fixtures/compiler/array_destructuring_assignment.spl")

        expect(fixture).to_contain("[only] = values")
        expect(fixture).to_contain("[left, right] = values")
        expect(fixture).to_contain("[[a, b], [c, d]] = values")
