# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
Integer literals inside a collection literal whose DECLARED element type is
f32/f64 are float values (int->f64 is allowed on all backends).

`val fs: [f64] = [1, 2]` boxed each element as a tagged INT
(`rt_value_int_wide`), and `fs[0] + fs[1]` read them back as floats:
native and the seed JIT printed `fsint 0.000…0012` instead of 3. A typed
replay of script top-level bindings routes the same shape through this path,
so the rows cover both a function and a script top level. Bootstrap HIR
(native-build) is used, as the native compiler does.
"""

use std.spec.*
use std.io_runtime.{env_set}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_json.{serialize_mir_function}

val INT_BOX = "rt_value_int_wide"
val FLOAT_BOX = "rt_value_float"

class Lowered:
    errors: text
    functions: [text]
    mirs: [text]

fn lower_bootstrap(src: text) -> Lowered:
    val parsed = parse_and_build_module(src, "float_probe.spl")
    var hir_lowering = HirLowering.with_filename("float_probe.spl")
    env_set("SIMPLE_BOOTSTRAP", "1")
    env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "1")
    val hir = hir_lowering.lower_module(parsed)
    env_set("SIMPLE_BOOTSTRAP", "")
    env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "")
    var errors = ""
    for e in hir_lowering.errors:
        errors = errors + "hir: " + e.message + "\n"
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    for e in lowering.errors:
        errors = errors + "mir: " + e.message + "\n"
    var names: [text] = []
    var mirs: [text] = []
    for function in mir.functions.values():
        names.push(function.name)
        mirs.push(serialize_mir_function(function))
    Lowered(errors: errors, functions: names, mirs: mirs)

fn mir_of(l: Lowered, suffix: text) -> text:
    var i = 0
    while i < l.functions.len():
        if l.functions[i].ends_with(suffix): return l.mirs[i]
        i = i + 1
    ""

fn count(m: text, needle: text) -> i64:
    m.split(needle).len() - 1

fn floats_only(src: text, function: text, boxes: i64):
    val l = lower_bootstrap(src)
    expect(l.errors).to_equal("")
    val m = mir_of(l, function)
    expect(count(m, INT_BOX)).to_equal(0)
    expect(count(m, FLOAT_BOX)).to_equal(boxes)

describe "int literals in a declared float collection are floats":
    it "[f64] in a function":
        floats_only("fn fa() -> f64:\n    val fs: [f64] = [1, 2]\n    fs[0] + fs[1]\n", "fa", 2)

    it "[f64] at a script top level":
        floats_only("val fs: [f64] = [1, 2]\nprint \"fsint {{fs[0] + fs[1]}}\"\n", "main", 2)

    it "mixed [1, 2.5]":
        floats_only("fn fm() -> f64:\n    val m: [f64] = [1, 2.5]\n    m[0] + m[1]\n", "fm", 2)

    it "nested [[f64]]":
        val l = lower_bootstrap("fn fn_n() -> f64:\n    val n: [[f64]] = [[1, 2]]\n    n[0][0]\n")
        expect(l.errors).to_equal("")
        expect(count(mir_of(l, "fn_n"), INT_BOX)).to_equal(0)

    it "[f32]":
        val l = lower_bootstrap("fn fn_g() -> f32:\n    val g: [f32] = [1, 2]\n    g[0]\n")
        expect(l.errors).to_equal("")
        expect(count(mir_of(l, "fn_g"), INT_BOX)).to_equal(0)

    it "a {text: f64} dict value":
        val l = lower_bootstrap("fn fn_d() -> f64:\n    val d: {{text: f64}} = {{\"a\": 1}}\n    d[\"a\"]\n")
        expect(l.errors).to_equal("")
        expect(count(mir_of(l, "fn_d"), INT_BOX)).to_equal(0)

    # Already right (scalar slot path); pinned so the collection rewrite
    # cannot disturb it.
    it "keeps `val o: f64? = 3` a float payload":
        val l = lower_bootstrap("fn fn_o() -> f64:\n    val o: f64? = 3\n    o ?? 0.0\n")
        expect(l.errors).to_equal("")
        val m = mir_of(l, "fn_o")
        expect(count(m, INT_BOX)).to_equal(0)
        expect(count(m, "\"type\":\"F64\"}")).to_equal(2)

    # An int collection is untouched.
    it "leaves [i64] elements as ints":
        val l = lower_bootstrap("fn fi() -> i64:\n    val xs: [i64] = [1, 2]\n    xs[0] + xs[1]\n")
        expect(l.errors).to_equal("")
        expect(count(mir_of(l, "fi"), FLOAT_BOX)).to_equal(0)
