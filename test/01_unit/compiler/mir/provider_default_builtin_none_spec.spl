"""Provider struct field defaults a consumer may omit: `None`, literals, `[]`.

Phase 4 full-CLI native build (integ9): `HostAgentAttachmentV4.helper:
Option<HostHelperLeaseV1> = None` (orchestration/host_agent_attachment_v4.spl:112)
constructed in host_linux_service_agent_v4.spl with the field omitted raised
"unsupported provider default ...; supply the field explicitly". HIR spells the
built-in `None` as a module-less Function symbol in the PROVIDER table;
relocate_provider_default sent it down the callable route, which has no link
name for it, and returned Error.
"""
# @cover src/compiler/50.mir/_MirLowering/provider_metadata.spl
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolKind, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.declaration_inventory_barriers_v1.*
use compiler.mir._MirLowering.declaration_default_bindings_v1.{MirHirDefaultBindingFrameV1}
use compiler.mir._MirLowering.declaration_default_bindings_v1.*
use compiler.mir._MirLowering.declaration_default_rewrite_v1.*
use compiler.mir.hir_declaration_types_v1.{MirHirModuleDeclarationsV1, MirHirNominalDeclarationV1, MirHirFieldDeclarationV1}
use compiler.types.type_layout.{layoutattr_default_}

fn default_expr(kind: HirExprKind) -> HirExpr:
    HirExpr(kind: kind, has_type_: false, type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()), span: Span.empty())

fn provider_builtin_none(provider: SymbolTable) -> SymbolId:
    # Exactly what HIR lowering defines for a bare `None`.
    provider.define("None", SymbolKind.Function, None, Span.empty(), Visibility.Private, false, None)

describe "provider field default `None` and literal forms":
    it "relocates the built-in None to the consumer's built-in None symbol":
        var provider = SymbolTable.new()
        # Shift provider ids so a raw provider id is not valid by accident.
        provider.define("pad", SymbolKind.Function, None, Span.empty(), Visibility.Private, false, Some("app.provider"))
        val none_symbol = provider_builtin_none(provider)
        var lowering = MirLowering.new(SymbolTable.new())
        val relocated = lowering.relocate_provider_default(
            default_expr(HirExprKind.NamedVar(none_symbol, "None")), provider, {})
        match relocated.kind:
            case HirExprKind.NamedVar(target, name):
                expect(name).to_equal("None")
                expect(target.id >= 0).to_equal(true)
                expect(lowering.symbols.lookup_or_invalid("None").id).to_equal(target.id)
                expect(lowering.symbols.symbol_defining_module_scalar_raw(target.id)).to_equal("")
            case _: fail("built-in None provider default was not relocated")
        expect(lowering.errors.len()).to_equal(0)

    it "reuses one consumer None symbol across defaults":
        var provider = SymbolTable.new()
        val none_symbol = provider_builtin_none(provider)
        var lowering = MirLowering.new(SymbolTable.new())
        var ids: [i64] = []
        for round in [0, 1]:
            match lowering.relocate_provider_default(default_expr(HirExprKind.Var(none_symbol)), provider, {}).kind:
                case HirExprKind.NamedVar(target, _): ids = ids.push(target.id)
                case _: fail("built-in None provider default was not relocated")
        expect(ids.len()).to_equal(2)
        expect(ids[0]).to_equal(ids[1])

    it "keeps literal and empty-array defaults as they are":
        val provider = SymbolTable.new()
        var lowering = MirLowering.new(SymbolTable.new())
        match lowering.relocate_provider_default(default_expr(HirExprKind.NilLit), provider, {}).kind:
            case HirExprKind.NilLit: ()
            case _: fail("NilLit default changed")
        match lowering.relocate_provider_default(default_expr(HirExprKind.IntLit(7, None)), provider, {}).kind:
            case HirExprKind.IntLit(value, _): expect(value).to_equal(7)
            case _: fail("int default changed")
        match lowering.relocate_provider_default(default_expr(HirExprKind.FloatLit(1.5, None)), provider, {}).kind:
            case HirExprKind.FloatLit(value, _): expect(value).to_equal(1.5)
            case _: fail("float default changed")
        match lowering.relocate_provider_default(default_expr(HirExprKind.BoolLit(true)), provider, {}).kind:
            case HirExprKind.BoolLit(value): expect(value).to_equal(true)
            case _: fail("bool default changed")
        match lowering.relocate_provider_default(default_expr(HirExprKind.StringLit("web", None)), provider, {}).kind:
            case HirExprKind.StringLit(value, _): expect(value).to_equal("web")
            case _: fail("text default changed")
        match lowering.relocate_provider_default(default_expr(HirExprKind.ArrayLit([], None)), provider, {}).kind:
            case HirExprKind.ArrayLit(elements, _): expect(elements.len()).to_equal(0)
            case _: fail("empty array default changed")
        expect(lowering.errors.len()).to_equal(0)

    it "still refuses a provider-owned callable named None that has no link":
        var provider = SymbolTable.new()
        val owned = provider.define("None", SymbolKind.Function, None, Span.empty(),
            Visibility.Private, false, Some("app.provider"))
        var lowering = MirLowering.new(SymbolTable.new())
        match lowering.relocate_provider_default(default_expr(HirExprKind.NamedVar(owned, "None")), provider, {}).kind:
            case HirExprKind.Error: ()
            case _: fail("a module-owned None is a provider callable, not the built-in")

    it "still refuses a call to an unlinked provider-private function":
        var provider = SymbolTable.new()
        val helper = provider.define("make_default", SymbolKind.Function, None, Span.empty(),
            Visibility.Private, false, Some("app.provider"))
        var lowering = MirLowering.new(SymbolTable.new())
        val call = default_expr(HirExprKind.Call(default_expr(HirExprKind.Var(helper)), [], []))
        match lowering.relocate_provider_default(call, provider, {}).kind:
            case HirExprKind.Error: ()
            case _: fail("an arbitrary provider call must stay fatal at use")

    it "does not bind the built-in None to a consumer symbol owned by a module":
        var provider = SymbolTable.new()
        val none_symbol = provider_builtin_none(provider)
        var consumer = SymbolTable.new()
        consumer.define("None", SymbolKind.Function, None, Span.empty(), Visibility.Private, false, Some("app.consumer"))
        var lowering = MirLowering.new(consumer)
        match lowering.relocate_provider_default(default_expr(HirExprKind.NamedVar(none_symbol, "None")), provider, {}).kind:
            case HirExprKind.Error: ()
            case _: fail("a consumer symbol named None owned by a module is not the built-in")

    it "relocates built-in None when the consumer binds an unrelated EnumVariant named None":
        var provider = SymbolTable.new()
        val none_symbol = provider_builtin_none(provider)
        var consumer = SymbolTable.new()
        val variant_none = consumer.define("None", SymbolKind.EnumVariant, None, Span.empty(),
            Visibility.Public, false, Some("std.common.contracts.provider_cli.adapter_types_v1"))
        var lowering = MirLowering.new(consumer)
        val relocated = lowering.relocate_provider_default(
            default_expr(HirExprKind.NamedVar(none_symbol, "None")), provider, {})
        match relocated.kind:
            case HirExprKind.NamedVar(target, name):
                expect(name).to_equal("None")
                expect(target.id >= 0).to_equal(true)
                expect(target.id != variant_none.id).to_equal(true)
                expect(lowering.symbols.lookup_or_invalid("None").id).to_equal(variant_none.id)
                expect(lowering.symbols.symbol_defining_module_scalar_raw(target.id)).to_equal("")
            case _: fail("consumer EnumVariant None must not turn Option.None provider default into Error")
        expect(lowering.errors.len()).to_equal(0)

    it "relocates an Optional-typed EnumVariant None from a provider that also declared enum variant None":
        var provider = SymbolTable.new()
        val provider_variant = provider.define("None", SymbolKind.EnumVariant, None, Span.empty(),
            Visibility.Public, false, None)
        val opt_i64 = HirType(kind: HirTypeKind.Optional(HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())), span: Span.empty())
        val typed_default = HirExpr(kind: HirExprKind.NamedVar(provider_variant, "None"),
            has_type_: true, type_: opt_i64, span: Span.empty())
        var lowering = MirLowering.new(SymbolTable.new())
        val relocated = lowering.relocate_provider_default(typed_default, provider, {})
        match relocated.kind:
            case HirExprKind.NamedVar(target, name):
                expect(name).to_equal("None")
                expect(target.id >= 0).to_equal(true)
                expect(lowering.symbols.symbol_defining_module_scalar_raw(target.id)).to_equal("")
            case _: fail("Optional-typed provider EnumVariant None must relocate as built-in Option.None")

    it "registers declaration-repository struct defaults under both bare name and composite_layout_key":
        var provider_syms = SymbolTable.new()
        val struct_sym = provider_syms.define("HostAgentAttachmentV4", SymbolKind.Struct, None,
            Span.empty(), Visibility.Public, false, Some("lib.nogc_sync_mut.orchestration.host_agent_attachment_v4"))
        val field_sym = provider_syms.define("helper", SymbolKind.Field, None,
            Span.empty(), Visibility.Public, false, None)
        val opt_type = HirType(kind: HirTypeKind.Optional(HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())), span: Span.empty())
        val field_decl = MirHirFieldDeclarationV1(
            symbol: field_sym, name: "helper", type_: opt_type,
            has_default: true, default_artifact: None, visibility: Visibility.Public,
            is_public: true, is_volatile: false, has_bits_attr: false, bits_width: 0,
            has_fixed_address: false, fixed_address: 0, span: Span.empty())
        val struct_decl = MirHirNominalDeclarationV1(
            symbol: struct_sym, name: "HostAgentAttachmentV4", kind: SymbolKind.Struct,
            type_params: [], fields: [field_decl], methods: {},
            has_layout_attr: false, layout_attr: layoutattr_default_(), layout_digest: "",
            has_export_attr: false, export_attr: None, visibility: Visibility.Public,
            is_public: true, is_generic_template: false, span: Span.empty())
        val mod_decl = MirHirModuleDeclarationsV1(
            name: "lib.nogc_sync_mut.orchestration.host_agent_attachment_v4",
            path: "src/lib/nogc_sync_mut/orchestration/host_agent_attachment_v4.spl",
            final_repository_authority: "", final_archive_key: "", final_body_digest: "",
            symbols: provider_syms, functions: [], structs: [struct_decl], classes: [],
            enums: [], bitfields: [], traits: [], impls: [], globals: [],
            needs_initialization: false, declaration_digest: "", stage: "mir-hir-declarations-v1")
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.register_declaration_composite_inventory_v1(mod_decl)
        val exact_key = "lib.nogc_sync_mut.orchestration.host_agent_attachment_v4::HostAgentAttachmentV4"
        expect(lowering.struct_field_has_default.has("HostAgentAttachmentV4")).to_equal(true)
        expect(lowering.struct_field_has_default.has(exact_key)).to_equal(true)
        expect(lowering.declaration_field_defaults.has("HostAgentAttachmentV4")).to_equal(true)
        expect(lowering.declaration_field_defaults.has(exact_key)).to_equal(true)

    it "remap_declaration_default_expr_v1 relocates Optional-typed EnumVariant None to Option.None":
        var provider_syms = SymbolTable.new()
        val variant_none = provider_syms.define("None", SymbolKind.EnumVariant, None,
            Span.empty(), Visibility.Public, false, Some("app.provider"))
        val mod_decl = MirHirModuleDeclarationsV1(
            name: "app.provider", path: "src/app/provider.spl",
            final_repository_authority: "", final_archive_key: "", final_body_digest: "",
            symbols: provider_syms, functions: [], structs: [], classes: [],
            enums: [], bitfields: [], traits: [], impls: [], globals: [],
            needs_initialization: false, declaration_digest: "", stage: "mir-hir-declarations-v1")
        var consumer_syms = SymbolTable.new()
        val consumer_variant = consumer_syms.define("None", SymbolKind.EnumVariant, None,
            Span.empty(), Visibility.Public, false, Some("app.consumer_enum"))
        var lowering = MirLowering.new(consumer_syms)
        val frame = MirHirDefaultBindingFrameV1(
            provider: mod_decl, links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        val opt_i64 = HirType(kind: HirTypeKind.Optional(HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())), span: Span.empty())
        val opt_expr = HirExpr(kind: HirExprKind.NamedVar(variant_none, "None"),
            has_type_: true, type_: opt_i64, span: Span.empty())
        val remapped = lowering.remap_declaration_default_expr_v1(opt_expr, frame)
        expect(frame.failed).to_equal(false)
        match remapped.kind:
            case HirExprKind.NamedVar(target, name):
                expect(name).to_equal("None")
                expect(target.id >= 0).to_equal(true)
                expect(target.id != consumer_variant.id).to_equal(true)
                expect(lowering.symbols.symbol_defining_module_scalar_raw(target.id)).to_equal("")
            case _: fail("Optional-typed EnumVariant None should remap to built-in Option.None")

    it "remap_declaration_default_expr_v1 rejects non-Optional EnumVariant None without substituting Option.None":
        var provider_syms = SymbolTable.new()
        val color_enum = provider_syms.define("Color", SymbolKind.Enum, None,
            Span.empty(), Visibility.Public, false, Some("app.provider"))
        val color_none = provider_syms.define("None", SymbolKind.EnumVariant, None,
            Span.empty(), Visibility.Public, false, Some("app.provider"))
        val mod_decl = MirHirModuleDeclarationsV1(
            name: "app.provider", path: "src/app/provider.spl",
            final_repository_authority: "", final_archive_key: "", final_body_digest: "",
            symbols: provider_syms, functions: [], structs: [], classes: [],
            enums: [], bitfields: [], traits: [], impls: [], globals: [],
            needs_initialization: false, declaration_digest: "", stage: "mir-hir-declarations-v1")
        var consumer_syms = SymbolTable.new()
        val _consumer_color = consumer_syms.define("Color", SymbolKind.Enum, None,
            Span.empty(), Visibility.Public, false, Some("app.provider"))
        var lowering = MirLowering.new(consumer_syms)
        val frame = MirHirDefaultBindingFrameV1(
            provider: mod_decl, links: {}, lexical_ids: {}, declaration_ids: {}, failed: false)
        val color_type = HirType(kind: HirTypeKind.Named(color_enum, []), span: Span.empty())
        val non_opt_expr = HirExpr(kind: HirExprKind.NamedVar(color_none, "None"),
            has_type_: true, type_: color_type, span: Span.empty())
        val remapped = lowering.remap_declaration_default_expr_v1(non_opt_expr, frame)
        expect(frame.failed).to_equal(true)
        match remapped.kind:
            case HirExprKind.Error: ()
            case _: fail("non-Optional EnumVariant None must fail closed rather than substitute Option.None")
        match lowering.relocate_provider_default(non_opt_expr, provider_syms, {}).kind:
            case HirExprKind.Error: ()
            case _: fail("relocate_provider_default must also reject non-Optional EnumVariant None")
