# @req REQ-AF-008 REQ-AF-010
# @cover src/compiler/00.common/structural_contracts/aop.spl 80%
# @cover src/compiler/50.mir/mir_serialization.spl 70%

use std.spec.*
use compiler.common.structural_contracts.aop.{
    PREPARED_ADVICE_SLOT_SCHEMA_ID, PREPARED_ADVICE_SLOT_SCHEMA_VERSION,
    PreparedAdviceSlotPlan, prepared_advice_slot_plan_create
}
use compiler.mir.mir_data.{MirModule}
use compiler.mir.mir_instructions.{
    MirBlock, MirFunction, MirInst, MirInstKind, MirSignature, MirTerminator,
    BlockId, LocalId, MirOperand, MirOperandKind
}
use compiler.mir.mir_types.{
    LocalKind, MirConstValue, MirLocal, MirType, MirTypeDef, MirTypeDefKind,
    MirTypeKind
}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_serialization.{
    serialize_mir_module, serialize_mir_prepared_advice_slots
}
use compiler.mir_opt.mir_opt.{
    run_simd_lowering, run_predicate_promote, run_auto_vectorization
}
use compiler.driver.prepared_advice_slot_handoff.{
    collect_prepared_advice_slot_table_bytes,
    prepared_advice_slot_artifact_gate,
    prepared_advice_driver_bridge,
    prepared_advice_execution_admission
}
use compiler.common.driver_core_types.{CompileOptions}
use compiler.backend.backend.backend_helpers.{backend_prepared_advice_rejection}

fn prepared_slot(id: text, target: text, forms: [text]) -> PreparedAdviceSlotPlan:
    prepared_advice_slot_plan_create(
        PREPARED_ADVICE_SLOT_SCHEMA_ID,
        PREPARED_ADVICE_SLOT_SCHEMA_VERSION,
        id, target, forms).unwrap()

fn prepared_slot_module(name: text, plans: [PreparedAdviceSlotPlan]) -> MirModule:
    MirModule(
        name: name, functions: {}, statics: {}, constants: {}, types: {},
        prepared_advice_slots: plans)

fn prepared_intrinsic_only_module() -> MirModule:
    val entry = MirBlock(
        id: BlockId.entry(), label: Some("entry"),
        instructions: [MirInst(kind: MirInstKind.Intrinsic(
            nil, "simple.prepared_advice_dispatch.v1", []), span: nil)],
        terminator: MirTerminator.Ret(nil))
    val function = MirFunction(
        symbol: SymbolId.new(0), name: "submit",
        signature: MirSignature(
            params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [], blocks: [entry], entry_block: BlockId.entry(), span: nil,
        generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(
        name: "direct", functions: functions, statics: {},
        constants: {}, types: {}, prepared_advice_slots: [])

fn prepared_v2_module() -> MirModule:
    val context_symbol = SymbolId.new(99)
    val context_type = MirType(kind: MirTypeKind.Struct(context_symbol))
    val slot = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("orders.submit.prepared"),
        MirType(kind: MirTypeKind.Opaque("str"))))
    val phase = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("before"), MirType(kind: MirTypeKind.Opaque("str"))))
    val entry = MirBlock(
        id: BlockId.entry(), label: Some("entry"),
        instructions: [MirInst(kind: MirInstKind.Intrinsic(
            nil, "simple.prepared_advice_dispatch.v2", [
                MirOperand(kind: MirOperandKind.Copy(LocalId(0))), slot, phase]),
            span: nil)],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Int(7), MirType.i64())))))
    val function = MirFunction(
        symbol: SymbolId.new(1), name: "submit",
        signature: MirSignature(
            params: [context_type], return_type: MirType.i64(), is_variadic: false),
        locals: [MirLocal(
            id: LocalId(0), name: Some("context"), type_: context_type,
            kind: LocalKind.Arg(0), is_ghost: false)],
        blocks: [entry], entry_block: BlockId.entry(), span: nil,
        generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[context_symbol] = MirTypeDef(
        symbol: context_symbol, name: "AspectExecutionContext",
        kind: MirTypeDefKind.Struct([]), is_export_c: false, export_name: "")
    MirModule(
        name: "orders", functions: functions, statics: {}, constants: {},
        types: types, prepared_advice_slots: [prepared_slot(
            "orders.submit.prepared", "orders::submit", ["before"])])

fn prepared_dispatcher_module() -> MirModule:
    val context_symbol = SymbolId.new(99)
    val context_type = MirType(kind: MirTypeKind.Struct(context_symbol))
    val text_type = MirType(kind: MirTypeKind.Opaque("str"))
    val entry = MirBlock(
        id: BlockId.entry(), label: Some("entry"), instructions: [],
        terminator: MirTerminator.Ret(nil))
    val function = MirFunction(
        symbol: SymbolId.new(2),
        name: "prepared_advice_dispatch_context_invoke_or_panic",
        signature: MirSignature(
            params: [context_type, text_type, text_type],
            return_type: MirType.unit(), is_variadic: false),
        locals: [], blocks: [entry], entry_block: BlockId.entry(), span: nil,
        generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[context_symbol] = MirTypeDef(
        symbol: context_symbol, name: "AspectExecutionContext",
        kind: MirTypeDefKind.Struct([]), is_export_c: false, export_name: "")
    MirModule(
        name: "app.startup.aspect_application_runtime",
        functions: functions, statics: {}, constants: {}, types: types,
        prepared_advice_slots: [])

fn prepared_v2_modules() -> Dict<text, MirModule>:
    {
        "orders": prepared_v2_module(),
        "app.startup.aspect_application_runtime": prepared_dispatcher_module()
    }

describe "Prepared dynamic advice-slot MIR metadata":
    it "admits only versioned before and after phase plans":
        val plan = prepared_slot(
            "orders.submit.prepared", "orders::submit",
            ["before", "after_success", "after_error"])
        expect(plan.schema_id).to_equal("simple.prepared-advice-slot")
        expect(plan.schema_version).to_equal(1)
        expect(plan.slot_id).to_equal("orders.submit.prepared")
        expect(plan.target_function_id).to_equal("orders::submit")
        expect(plan.admitted_forms.len()).to_equal(3)

        expect(prepared_advice_slot_plan_create(
            PREPARED_ADVICE_SLOT_SCHEMA_ID, 99, "slot", "target",
            ["before"]).unwrap_err()).to_contain("unsupported prepared advice slot schema")
        expect(prepared_advice_slot_plan_create(
            PREPARED_ADVICE_SLOT_SCHEMA_ID,
            PREPARED_ADVICE_SLOT_SCHEMA_VERSION, "slot", "target",
            ["around"]).unwrap_err()).to_contain("unsupported")
        expect(prepared_advice_slot_plan_create(
            PREPARED_ADVICE_SLOT_SCHEMA_ID,
            PREPARED_ADVICE_SLOT_SCHEMA_VERSION, "slot", "target",
            ["before", "before"]).unwrap_err()).to_contain("duplicate")

    it "serializes slots and forms deterministically":
        val a = prepared_slot("slot.z", "orders::z", ["before", "after_error"])
        val b = prepared_slot("slot.a", "orders::a", ["after_success", "before"])
        val forward = serialize_mir_prepared_advice_slots([a, b])
        val reverse = serialize_mir_prepared_advice_slots([b, a])
        expect(forward).to_equal(reverse)
        expect(forward).to_contain("\"slotId\":\"slot.a\"")
        expect(forward).to_contain("\"targetFunctionId\":\"orders::z\"")
        expect(serialize_mir_module(
            prepared_slot_module("orders", [a]))).to_contain("preparedAdviceSlots")

    it "survives optimizer module reconstruction without becoming executable":
        val plan = prepared_slot("orders.submit.prepared", "orders::submit", ["before"])
        val original = prepared_slot_module("orders", [plan])
        val simd = run_simd_lowering(original)
        val predicate = run_predicate_promote(simd)
        val vectorized = run_auto_vectorization(predicate)
        expect(vectorized.prepared_advice_slots.len()).to_equal(1)
        expect(vectorized.prepared_advice_slots[0].slot_id).to_equal("orders.submit.prepared")
        expect(vectorized.functions.keys().len()).to_equal(0)

    it "hands a stable table to the driver and rejects unrewritten artifacts":
        val plan = prepared_slot("orders.submit.prepared", "orders::submit", ["before"])
        val module = prepared_slot_module("orders", [plan])
        val bytes = collect_prepared_advice_slot_table_bytes({"orders": module}).unwrap()
        expect(bytes.len()).to_be_greater_than(0)
        expect(prepared_advice_slot_artifact_gate({"orders": module}).unwrap_err()).to_contain(
            "dispatcher is absent from the entry closure")

        expect(prepared_advice_slot_artifact_gate({
            "orders": module,
            "other": prepared_slot_module("other", [plan])}).unwrap_err()).to_contain(
                "duplicate prepared advice slot ID")

    it "centrally rejects unsupported check interpreter jit and aot surfaces":
        var options = CompileOptions.default()
        options.prepared_dynamic_advice = true
        expect(prepared_advice_execution_admission(
            options, {}, "check").unwrap_err()).to_contain(
                "no MIR dispatch may be ignored")
        expect(prepared_advice_execution_admission(
            options, {}, "interpret").unwrap_err()).to_contain(
                "no MIR dispatch may be ignored")
        expect(prepared_advice_execution_admission(
            options, {}, "jit").unwrap_err()).to_contain(
                "hosted CPU AOT entry-closure is required")

        val module = prepared_slot_module("orders", [prepared_slot(
            "orders.submit.prepared", "orders::submit", ["before"])])
        expect(prepared_advice_execution_admission(
            options, {"orders": module}, "jit").unwrap_err()).to_contain(
                "hosted CPU AOT entry-closure is required")
        expect(prepared_advice_execution_admission(
            options, {"orders": module}, "aot:llvm").unwrap_err()).to_contain(
                "hosted CPU AOT entry-closure is required")
        for backend in [
            "auto", "llvm", "llvm-lib", "cranelift", "native", "c",
            "interpreter", "wasm", "lean", "byl", "lua", "vhdl", "irtc",
            "mllvm-qemu",
            "cuda", "hip", "opencl", "vulkan"
        ]:
            expect(backend_prepared_advice_rejection(
                prepared_intrinsic_only_module(), backend).unwrap()).to_contain(
                    "cannot execute prepared dynamic advice")

        # A direct backend caller cannot evade the backstop by stripping the
        # slot table while retaining the side-effecting MIR operation.
        expect(backend_prepared_advice_rejection(
            prepared_intrinsic_only_module(), "native").unwrap()).to_contain(
                "cannot execute prepared dynamic advice")

    it "rewrites validated v2 through the exact fail-stop unit dispatcher":
        var options = CompileOptions.default()
        options.prepared_dynamic_advice = true
        val input = prepared_v2_module()
        expect(prepared_advice_driver_bridge(
            {"orders": input}, "aot:llvm").unwrap_err()).to_contain(
                "hosted CPU AOT entry-closure is required")
        expect(prepared_advice_driver_bridge(
            {"orders": input},
            "aot-entry-closure-host:wasm").unwrap_err()).to_contain(
                "hosted CPU AOT entry-closure is required")

        expect(prepared_advice_driver_bridge(
            {"orders": input},
            "aot-entry-closure-host:llvm").unwrap_err()).to_contain(
                "dispatcher is absent from the entry closure")
        expect(prepared_advice_driver_bridge({
            "orders": prepared_slot_module("orders", [prepared_slot(
                "orders.submit.prepared", "orders::submit", ["before"])]),
            "app.startup.aspect_application_runtime": prepared_dispatcher_module()
        }, "aot-entry-closure-host:llvm").unwrap_err()).to_contain(
            "has no rewritten ordinary call")
        var shadow = prepared_dispatcher_module()
        shadow.name = "other.dispatcher"
        var shadowed_modules = prepared_v2_modules()
        shadowed_modules["other.dispatcher"] = shadow
        expect(prepared_advice_driver_bridge(
            shadowed_modules,
            "aot-entry-closure-host:llvm").unwrap_err()).to_contain(
                "shadowed outside its source owner")
        val bridged = prepared_advice_driver_bridge(
            prepared_v2_modules(),
            "aot-entry-closure-host:llvm").unwrap()
        val artifact_gate = prepared_advice_slot_artifact_gate(bridged)
        if artifact_gate.is_err():
            fail(artifact_gate.unwrap_err())
        val rewritten = bridged["orders"].functions.values()[0]
        match rewritten.blocks[0].instructions[0].kind:
            case Call(destination, callee, args):
                expect(destination).to_be_nil()
                expect(args.len()).to_equal(3)
                match callee.kind:
                    case Const(Str(name), callee_type):
                        expect(name).to_equal(
                            "prepared_advice_dispatch_context_invoke_or_panic")
                        match callee_type.kind:
                            case FuncPtr(signature):
                                expect(signature.return_type.kind).to_equal(
                                    MirTypeKind.Unit)
                            case _: fail("expected unit FuncPtr ABI")
                    case _: fail("expected exact fail-stop dispatcher operand")
            case _: fail("expected ordinary dispatcher Call")
        match rewritten.blocks[0].terminator:
            case Ret(Some(value)):
                match value.kind:
                    case Const(Int(result), _): expect(result).to_equal(7)
                    case _: fail("expected preserved target return value")
            case _: fail("expected preserved arbitrary-return terminator")
        expect(prepared_advice_execution_admission(
            options, bridged,
            "aot-entry-closure-host:llvm").is_ok()).to_equal(true)
        expect(backend_prepared_advice_rejection(
            bridged["orders"], "llvm")).to_be_nil()

        var residual_v2 = input
        residual_v2.prepared_advice_slots = []
        expect(backend_prepared_advice_rejection(
            residual_v2, "llvm").unwrap()).to_contain(
                "cannot execute prepared dynamic advice")
        expect(prepared_advice_execution_admission(
            options, {"direct": prepared_intrinsic_only_module()},
            "aot-entry-closure-host:llvm").unwrap_err()).to_contain(
                "residual intrinsic")
