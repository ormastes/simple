"""Dynamic GPU dimensions must not publish MIR that silently selects X."""
use std.spec.*
use std.spec.step
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolKind, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirCallArg}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_types.{MirType, MirSignature, MirConstValue, LocalId}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind}
use compiler.backend.gpu_intrinsics.{is_gpu_intrinsic}
use compiler.mir._MirLoweringExpr.method_calls_literals.*
use compiler.driver.driver_mir_error_owner.{driver_mir_error_is_fatal_owned_v1}

fn gpu_dimension_span() -> Span:
    var span = Span.empty()
    span.file = "gpu_dimension.spl"
    span.line = 12
    span.col = 7
    span

fn gpu_dimension_argument(value: HirExpr) -> HirCallArg:
    HirCallArg(has_name: false, name: "", value: value, span: value.span)

fn gpu_dimension_lowering(symbols: SymbolTable, parameters: [MirType]) -> MirLowering:
    var lowering = MirLowering.new(symbols)
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 100), "dimension_probe",
        MirSignature(params: parameters, return_type: MirType.unit(), is_variadic: false), Span.empty())
    lowering.builder = builder
    lowering

fn gpu_dimension_instruction_name(kind: MirInstKind) -> text:
    match kind:
        case GpuGlobalId(_, _): "gpu_global_id"
        case GpuLocalId(_, _): "gpu_local_id"
        case GpuBlockId(_, _): "gpu_block_id"
        case GpuBlockDim(_, _): "gpu_block_dim"
        case GpuGridDim(_, _): "gpu_grid_dim"
        case _: ""

fn gpu_dimension_instruction_value(kind: MirInstKind) -> i64:
    match kind:
        case GpuGlobalId(_, dimension) | GpuLocalId(_, dimension) | GpuBlockId(_, dimension) | GpuBlockDim(_, dimension) | GpuGridDim(_, dimension): dimension
        case _: -1

describe "GPU index dimensions fail closed":
    it "rejects a dynamic HIR parameter through the actual driver fatal gate":
        step("Invoke the production owner")
        var symbols = SymbolTable.new()
        val symbol = symbols.define("dimension", SymbolKind.Parameter, HirType.i64(),
            Span.empty(), Visibility.Private, false, nil)
        var lowering = gpu_dimension_lowering(symbols, [MirType.i64()])
        val parameter = lowering.builder.locals[0].id
        lowering.bind_local(symbol.id, parameter)
        val dimension = HirExpr(kind: HirExprKind.NamedVar(symbol, "dimension"),
            has_type_: true, type_: HirType.i64(), span: gpu_dimension_span())
        lowering.lower_gpu_intrinsic_call("gpu_global_id", [gpu_dimension_argument(dimension)])
        expect(lowering.errors.len()).to_equal(1)
        val diagnostic = lowering.errors[0]
        expect(diagnostic.message).to_equal("GPU thread-index dimension must be a compile-time constant")
        expect(diagnostic.fatal).to_equal(true)
        expect(driver_mir_error_is_fatal_owned_v1(diagnostic)).to_equal(true)
        expect(diagnostic.span.?).to_equal(true)
        if val span = diagnostic.span:
            expect(span.file).to_equal("gpu_dimension.spl")
            expect(span.line).to_equal(12)
            expect(span.col).to_equal(7)

    it "preserves literal X Y and Z dimensions for every index intrinsic":
        step("Invoke the production owner")
        for name in ["gpu_global_id", "gpu_local_id", "gpu_block_id", "gpu_block_dim", "gpu_grid_dim"]:
            for dimension in [0, 1, 2]:
                var lowering = gpu_dimension_lowering(SymbolTable.new(), [])
                val value = HirExpr(kind: HirExprKind.IntLit(dimension, nil),
                    has_type_: true, type_: HirType.i64(), span: gpu_dimension_span())
                lowering.lower_gpu_intrinsic_call(name, [gpu_dimension_argument(value)])
                expect(lowering.errors.len()).to_equal(0)
                expect(lowering.builder.instructions.len()).to_equal(1)
                val instruction = lowering.builder.instructions[0]
                expect(gpu_dimension_instruction_name(instruction.kind)).to_equal(name)
                expect(gpu_dimension_instruction_value(instruction.kind)).to_equal(dimension)

    it "preserves the omitted dimension default":
        step("Invoke the production owner")
        var lowering = gpu_dimension_lowering(SymbolTable.new(), [])
        lowering.lower_gpu_intrinsic_call("gpu_global_id", [])
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.builder.instructions.len()).to_equal(1)
        val instruction = lowering.builder.instructions[0]
        expect(gpu_dimension_instruction_name(instruction.kind)).to_equal("gpu_global_id")
        expect(gpu_dimension_instruction_value(instruction.kind)).to_equal(0)

    it "lowers a dimension expression once before rejecting its runtime value":
        step("Invoke the production owner")
        var symbols = SymbolTable.new()
        val signature = HirType(kind: HirTypeKind.Function([], HirType.i64(), []), span: Span.empty())
        val symbol = symbols.define("dimension_effect", SymbolKind.Function, signature,
            Span.empty(), Visibility.Public, false, nil)
        var lowering = gpu_dimension_lowering(symbols, [])
        lowering.current_function_names = ["dimension_effect"]
        val callee = HirExpr(kind: HirExprKind.NamedVar(symbol, "dimension_effect"),
            has_type_: true, type_: signature, span: gpu_dimension_span())
        val dimension = HirExpr(kind: HirExprKind.Call(callee, [], []),
            has_type_: true, type_: HirType.i64(), span: gpu_dimension_span())
        lowering.lower_gpu_intrinsic_call("gpu_global_id", [gpu_dimension_argument(dimension)])
        expect(lowering.errors.len()).to_equal(1)
        expect(driver_mir_error_is_fatal_owned_v1(lowering.errors[0])).to_equal(true)
        var calls = 0
        var call_index = -1
        var gpu_index = -1
        var index = 0
        for instruction in lowering.builder.instructions:
            match instruction.kind:
                case Call(_, _, _):
                    calls = calls + 1
                    call_index = index
                case GpuGlobalId(_, _): gpu_index = index
                case _: ()
            index = index + 1
        expect(calls).to_equal(1)
        expect(call_index).to_be_greater_than(-1)
        expect(gpu_index).to_be_greater_than(call_index)

fn gpu_operand_local(operand: MirOperand) -> i64:
    match operand.kind:
        case MirOperandKind.Copy(local): local.id
        case _: -1

fn gpu_call_name(operand: MirOperand) -> text:
    match operand.kind:
        case MirOperandKind.Const(value, _):
            match value:
                case MirConstValue.Str(name): name
                case _: ""
        case _: ""

fn gpu_effect_argument(symbol: SymbolId, name: text, signature: HirType, result_type: HirType) -> HirCallArg:
    val callee = HirExpr(kind: HirExprKind.NamedVar(symbol, name),
        has_type_: true, type_: signature, span: gpu_dimension_span())
    gpu_dimension_argument(HirExpr(kind: HirExprKind.Call(callee, [], []),
        has_type_: true, type_: result_type, span: gpu_dimension_span()))

describe "GPU non-index arguments retain their owning lowering path":
    it "accepts real pointer and data parameters for CAS and every ordinary atomic":
        step("Prepare the real fixture")
        val pointer_type = HirType(kind: HirTypeKind.Ptr(HirType.i64(), true), span: Span.empty())
        for name in ["gpu_atomic_cas", "gpu_atomic_add", "gpu_atomic_sub", "gpu_atomic_min", "gpu_atomic_max", "gpu_atomic_and", "gpu_atomic_or", "gpu_atomic_xor", "gpu_atomic_exchange"]:
            expect(is_gpu_intrinsic(name)).to_equal(true)
            var symbols = SymbolTable.new()
            val pointer = symbols.define("pointer", SymbolKind.Parameter, pointer_type,
                Span.empty(), Visibility.Private, false, nil)
            val data = symbols.define("data", SymbolKind.Parameter, HirType.i64(),
                Span.empty(), Visibility.Private, false, nil)
            var lowering = gpu_dimension_lowering(symbols, [MirType.ptr(MirType.i64(), true), MirType.i64()])
            val pointer_local = lowering.builder.locals[0].id
            val data_local = lowering.builder.locals[1].id
            lowering.bind_local(pointer.id, pointer_local)
            lowering.bind_local(data.id, data_local)
            val pointer_arg = gpu_dimension_argument(HirExpr(kind: HirExprKind.NamedVar(pointer, "pointer"),
                has_type_: true, type_: pointer_type, span: gpu_dimension_span()))
            val data_arg = gpu_dimension_argument(HirExpr(kind: HirExprKind.NamedVar(data, "data"),
                has_type_: true, type_: HirType.i64(), span: gpu_dimension_span()))
            val arguments = if name == "gpu_atomic_cas": [pointer_arg, data_arg, data_arg] else: [pointer_arg, data_arg]
            step("Invoke the production owner")
            lowering.lower_gpu_intrinsic_call(name, arguments)
            step("Check the observed contract")
            expect(lowering.errors.len()).to_equal(0)
            var operations = 0
            for instruction in lowering.builder.instructions:
                match instruction.kind:
                    case GpuAtomicCas(_, ptr, expected, desired):
                        expect(name).to_equal("gpu_atomic_cas")
                        expect(gpu_operand_local(ptr)).to_equal(pointer_local.id)
                        expect(gpu_operand_local(expected)).to_equal(data_local.id)
                        expect(gpu_operand_local(desired)).to_equal(data_local.id)
                        operations = operations + 1
                    case Call(_, callee, operands):
                        expect(gpu_call_name(callee)).to_equal(name)
                        expect(operands.len()).to_equal(2)
                        expect(gpu_operand_local(operands[0])).to_equal(pointer_local.id)
                        expect(gpu_operand_local(operands[1])).to_equal(data_local.id)
                        operations = operations + 1
                    case _: ()
            expect(operations).to_equal(1)

    it "evaluates each CAS atomic and shuffle argument once in source order":
        step("Prepare the real fixture")
        for name in ["gpu_atomic_cas", "gpu_atomic_add", "gpu_warp_shuffle"]:
            expect(is_gpu_intrinsic(name)).to_equal(true)
            var symbols = SymbolTable.new()
            val first_type = if name == "gpu_warp_shuffle": HirType.i64() else:
                HirType(kind: HirTypeKind.Ptr(HirType.i64(), true), span: Span.empty())
            val first_signature = HirType(kind: HirTypeKind.Function([], first_type, []), span: Span.empty())
            val data_signature = HirType(kind: HirTypeKind.Function([], HirType.i64(), []), span: Span.empty())
            val first_symbol = symbols.define("gpu_probe_first", SymbolKind.Function, first_signature,
                Span.empty(), Visibility.Public, false, nil)
            val second_symbol = symbols.define("gpu_probe_second", SymbolKind.Function, data_signature,
                Span.empty(), Visibility.Public, false, nil)
            val third_symbol = symbols.define("gpu_probe_third", SymbolKind.Function, data_signature,
                Span.empty(), Visibility.Public, false, nil)
            expect(first_symbol.id == second_symbol.id).to_equal(false)
            expect(first_symbol.id == third_symbol.id).to_equal(false)
            expect(second_symbol.id == third_symbol.id).to_equal(false)
            expect(symbols.symbols[first_symbol.id].name).to_equal("gpu_probe_first")
            expect(symbols.symbols[second_symbol.id].name).to_equal("gpu_probe_second")
            expect(symbols.symbols[third_symbol.id].name).to_equal("gpu_probe_third")
            val first = gpu_effect_argument(first_symbol, "gpu_probe_first", first_signature, first_type)
            val second = gpu_effect_argument(second_symbol, "gpu_probe_second", data_signature, HirType.i64())
            val third = gpu_effect_argument(third_symbol, "gpu_probe_third", data_signature, HirType.i64())
            var lowering = gpu_dimension_lowering(symbols, [])
            lowering.current_function_names = ["gpu_probe_first", "gpu_probe_second", "gpu_probe_third"]
            val arguments = if name == "gpu_atomic_cas": [first, second, third] else: [first, second]
            step("Invoke the production owner")
            lowering.lower_gpu_intrinsic_call(name, arguments)
            step("Check the observed contract")
            expect(lowering.errors.len()).to_equal(0)
            var observed: [text] = []
            var results: [i64] = []
            var operations = 0
            for instruction in lowering.builder.instructions:
                match instruction.kind:
                    case Call(dest, callee, operands):
                        val called = gpu_call_name(callee)
                        if called == name:
                            expect(observed).to_equal(["gpu_probe_first", "gpu_probe_second"])
                            expect(operands.len()).to_equal(2)
                            expect(gpu_operand_local(operands[0])).to_equal(results[0])
                            expect(gpu_operand_local(operands[1])).to_equal(results[1])
                            operations = operations + 1
                        else:
                            expect(dest.?).to_equal(true)
                            expect(operations).to_equal(0)
                            observed.push(called)
                            results.push(dest.unwrap().id)
                    case GpuAtomicCas(_, ptr, expected, desired):
                        expect(name).to_equal("gpu_atomic_cas")
                        expect(observed).to_equal(["gpu_probe_first", "gpu_probe_second", "gpu_probe_third"])
                        expect(gpu_operand_local(ptr)).to_equal(results[0])
                        expect(gpu_operand_local(expected)).to_equal(results[1])
                        expect(gpu_operand_local(desired)).to_equal(results[2])
                        operations = operations + 1
                    case _: ()
            expect(operations).to_equal(1)
            expect(observed.len()).to_equal(arguments.len())
