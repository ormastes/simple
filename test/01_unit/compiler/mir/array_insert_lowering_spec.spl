"""
`[T].insert(i, v)` lowers natively to `rt_array_insert(arr, i, v)`.

Before: no native lowering existed, so since PR #4752 the call hit
reject_unresolved_method_call_v1 and was a FATAL MIR error.
"""
# @cover src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl

use std.spec.*
use std.env.variables.{env_set}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*

struct InsertOutcome:
    unresolved: i64
    fatal: i64
    insert_calls: i64

fn callee_is_insert(func: MirOperand) -> bool:
    match func.kind:
        case Const(value, _):
            match value:
                case Str(s): s == "rt_array_insert"
                case _: false
        case _: false

fn lower_src(source: text, name: text) -> InsertOutcome:
    val filename = "array_insert_" + name + ".spl"
    env_set("SIMPLE_BOOTSTRAP", "0")
    val module = parse_full_frontend(source, filename, filename, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(filename)
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var unresolved = 0
    var fatal = 0
    for err in mir_lowering.errors:
        if err.message.contains("unresolved method call"):
            unresolved = unresolved + 1
        if err.fatal:
            fatal = fatal + 1
    var calls = 0
    for fn_ in mir.functions.values():
        for block in fn_.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case Call(_, func, args):
                        if callee_is_insert(func) and args.len() == 3:
                            calls = calls + 1
                    case _: ()
    InsertOutcome(unresolved: unresolved, fatal: fatal, insert_calls: calls)

val TEXT_INSERT_SOURCE = """
fn main():
    var names: [text] = ["a", "c"]
    names.insert(1, "b")
    print names.len()
"""

val I64_INSERT_SOURCE = """
fn main():
    var xs: [i64] = [1, 3]
    xs.insert(1, 2)
    xs.insert(3, 4)
    print xs.len()
"""

describe "array insert native lowering":
    it "lowers [text].insert to rt_array_insert without a fatal error":
        val o = lower_src(TEXT_INSERT_SOURCE, "text")
        expect(o.unresolved).to_equal(0)
        expect(o.fatal).to_equal(0)
        expect(o.insert_calls).to_equal(1)

    it "lowers [i64].insert to rt_array_insert without a fatal error":
        val o = lower_src(I64_INSERT_SOURCE, "i64")
        expect(o.unresolved).to_equal(0)
        expect(o.fatal).to_equal(0)
        expect(o.insert_calls).to_equal(2)
