# bug: result_tuple_unwrap_payload_2026_10_11
# Real frontend/MIR and cleanup-edge probes; compiled execution pending.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.method_calls_literals.*
use compiler.mir.mir_lowering_stmts.*

fn tuple_result_function(source: text, target: text) -> (MirFunction, text, bool):
    val parsed = parse_full_frontend(source, "tuple_result.spl", "tuple_result", Logger(level: 0))
    var frontend = HirLowering.with_filename("tuple_result.spl")
    val hir = frontend.lower_module(parsed)
    expect(frontend.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    var errors = ""
    var fatal = false
    for error in lowering.errors:
        errors = errors + error.message + "\n"
        fatal = fatal or error.fatal
    for function in mir.functions.values():
        if function.name == target or function.name.ends_with(".{target}"):
            return (function, errors, fatal)
    panic("missing actual MIR function {target}: {errors}")

fn tuple_result_call_count(function: MirFunction, name: text) -> i64:
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(actual), _):
                            if actual == name or actual.ends_with(".{name}"):
                                count = count + 1
                        case _: ()
                case _: ()
    count

fn tuple_result_local_type(function: MirFunction, id: i64) -> MirType:
    for local in function.locals:
        if local.id.id == id:
            return local.type_
    panic("missing MIR local {id}")

fn tuple_result_bridge_count(function: MirFunction, fields: [MirType]) -> i64:
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Cast(address, source, target):
                    match target.kind:
                        case MirTypeKind.Ptr(pointee, _):
                            if pointee.kind == MirTypeKind.Tuple(fields):
                                # The cast source is the real enum payload word.
                                match source.kind:
                                    case MirOperandKind.Copy(raw):
                                        expect(tuple_result_local_type(function, raw.id).kind == MirTypeKind.I64).to_be(true)
                                    case _: panic("tuple bridge source is not a payload local")
                                for copy_block in function.blocks:
                                    for copy_inst in copy_block.instructions:
                                        match copy_inst.kind:
                                            case MirInstKind.Copy(dest, src):
                                                if src.id == address.id and tuple_result_local_type(function, dest.id).kind == MirTypeKind.Tuple(fields):
                                                    count = count + 1
                                            case _: ()
                        case MirTypeKind.Tuple(_):
                            panic("aggregate-size numeric cast is forbidden at tuple payload boundary")
                        case _: ()
                case _: ()
    count

fn tuple_result_projection_count(function: MirFunction, index: i64) -> i64:
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.GetField(_, _, field):
                    if field == index:
                        count = count + 1
                case _: ()
    count

describe "Result tuple payload transport", tag: ["only-compiled"]:
    it "recovers the ranking pair as a typed tuple and preserves both projections":
        val source = "fn choose(value: Result<(i64, i64), text>) -> i64:\n    val pair = value.unwrap()\n    pair.0 * 100 + pair.1\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        expect(tuple_result_bridge_count(function, [MirType.i64(), MirType.i64()])).to_equal(1)
        expect(tuple_result_projection_count(function, 0)).to_equal(1)
        expect(tuple_result_projection_count(function, 1)).to_equal(1)
        expect(tuple_result_call_count(function, "rt_enum_payload")).to_equal(1)
        expect(serialize_mir_function(function)).to_contain("called `.unwrap()` on an Err Result")

    it "evaluates a Result-producing call once and retains the normal panic branch":
        val source = "fn make() -> Result<(i64, i64), text>:\n    Ok((31, 47))\nfn choose() -> i64:\n    make().unwrap().1\n"
        val (function, errors, _) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(tuple_result_call_count(function, "make")).to_equal(1)
        expect(tuple_result_call_count(function, "rt_enum_discriminant")).to_equal(1)
        expect(tuple_result_call_count(function, "rt_enum_payload")).to_equal(1)
        expect(tuple_result_call_count(function, "rt_panic")).to_equal(1)

    it "unwraps nested bool float and integer error payload fields without erasure":
        val source = "fn choose(value: Result<i64, (bool, f64, (i64, i64))>) -> i64:\n    val tuple = value.unwrap_err()\n    val pair = tuple.2\n    pair.1\n"
        val (function, errors, _) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        val nested = MirType(kind: MirTypeKind.Tuple([MirType.i64(), MirType.i64()]))
        expect(tuple_result_bridge_count(function, [MirType.bool(), MirType.f64(), nested])).to_equal(1)
        expect(tuple_result_projection_count(function, 2)).to_equal(1)
        expect(tuple_result_projection_count(function, 1)).to_equal(1)
        expect(serialize_mir_function(function)).to_contain("called `.unwrap_err()` on an Ok Result")

    it "uses a pointer-width bridge even for a pair of one-byte booleans":
        val source = "fn choose(value: Result<(bool, bool), text>) -> bool:\n    val pair = value.unwrap()\n    pair.1\n"
        val (function, errors, _) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(tuple_result_bridge_count(function, [MirType.bool(), MirType.bool()])).to_equal(1)

    it "preserves tuple shape across question-mark and a new Ok constructor":
        val source = "fn forward(value: Result<(i64, i64), text>) -> Result<(i64, i64), text>:\n    val pair = value?\n    Ok(pair)\n"
        val (function, errors, _) = tuple_result_function(source, "forward")
        expect(errors).to_equal("")
        expect(tuple_result_bridge_count(function, [MirType.i64(), MirType.i64()])).to_equal(1)
        expect(tuple_result_call_count(function, "rt_enum_new")).to_equal(1)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(0)
        expect(tuple_result_call_count(function, "rt_tuple_new")).to_equal(0)

    it "drops the owned resource once on the unchanged Err propagation edge":
        val span = Span.empty()
        val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val pair = HirType(kind: HirTypeKind.Tuple([integer, integer]), span: span)
        val result_type = HirType(kind: HirTypeKind.Result(pair, HirType(kind: HirTypeKind.Str, span: span)), span: span)
        var symbols = SymbolTable.new()
        val receiver_symbol = symbols.define("pending", SymbolKind.Parameter, result_type, span, Visibility.Private, false, "tuple_result")
        var lowering = MirLowering.new(symbols)
        var builder = lowering.builder
        builder.begin_function(SymbolId(id: 90), "cleanup", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), span)
        val pending = builder.emit_const_int(0)
        val owned = builder.emit_const_int(17)
        lowering.builder = builder
        lowering.bind_local(receiver_symbol.id, pending)
        lowering.remember_local_hir_type(pending.id, result_type, 0, 0)
        lowering.resource_owned_locals = [owned]
        val receiver = HirExpr(kind: HirExprKind.Var(receiver_symbol), has_type_: true, type_: result_type, span: span)
        val payload = lowering.lower_try_expr(receiver)
        expect(lowering.errors.len()).to_equal(0)
        if val payload_type = lowering.local_mir_type_of(payload):
            expect(payload_type.kind == MirTypeKind.Tuple([MirType.i64(), MirType.i64()])).to_be(true)
        else:
            panic("question-mark lost its tuple payload type")
        var finished = lowering.builder
        val function = finished.end_function()
        var drops = 0
        var returns_original = 0
        for block in function.blocks:
            if block.label == Some("try_err"):
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Drop(local):
                            expect(local.id).to_equal(owned.id)
                            drops = drops + 1
                        case _: ()
                if block.bootstrap_ret_kind() == 1 and block.bootstrap_ret_local_id() == pending.id:
                    returns_original = returns_original + 1
        expect(drops).to_equal(1)
        expect(returns_original).to_equal(1)

    it "keeps text record and collection tuple fields fatal instead of guessing i64":
        val sources = [
            "fn bad(value: Result<(i64, text), text>) -> i64:\n    value.unwrap().0\n",
            "struct Record:\n    value: i64\nfn bad(value: Result<(i64, Record), text>) -> i64:\n    value.unwrap().0\n",
            "fn bad(value: Result<(i64, [i64]), text>) -> i64:\n    value.unwrap().0\n"
        ]
        for source in sources:
            val (function, errors, fatal) = tuple_result_function(source, "bad")
            expect(fatal).to_be(true)
            expect(errors).to_contain("unsupported Result unwrap payload type")
            expect(tuple_result_call_count(function, "rt_enum_payload")).to_equal(0)

    it "rejects unsupported question-mark tuple fields explicitly":
        val source = "fn bad(value: Result<(i64, text), text>) -> Result<i64, text>:\n    val pair = value?\n    Ok(pair.0)\n"
        val (_, errors, fatal) = tuple_result_function(source, "bad")
        expect(fatal).to_be(true)
        expect(errors).to_contain("unsupported Result tuple payload element type")

    it "retains scalar boolean Result unwrap and wrong-variant panic":
        val source = "fn choose(value: Result<bool, text>) -> bool:\n    not value.unwrap()\n"
        val (function, errors, _) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(tuple_result_bridge_count(function, [MirType.bool(), MirType.bool()])).to_equal(0)
        expect(tuple_result_call_count(function, "rt_enum_payload")).to_equal(1)
        expect(tuple_result_call_count(function, "rt_panic")).to_equal(1)

    it "reuses the release core's prelowered receiver for both enum runtime calls":
        val span = Span.empty()
        val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
        val pair = HirType(kind: HirTypeKind.Tuple([integer, integer]), span: span)
        val result_type = HirType(kind: HirTypeKind.Result(pair, HirType(kind: HirTypeKind.Str, span: span)), span: span)
        var symbols = SymbolTable.new()
        val receiver_symbol = symbols.define("pending", SymbolKind.Parameter, result_type, span, Visibility.Private, false, "tuple_result")
        var lowering = MirLowering.new(symbols)
        var builder = lowering.builder
        builder.begin_function(SymbolId(id: 91), "prelowered", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), span)
        val variable_local = builder.emit_const_int(17)
        val prelowered = builder.emit_const_int(29)
        lowering.builder = builder
        lowering.bind_local(receiver_symbol.id, variable_local)
        lowering.remember_local_hir_type(variable_local.id, result_type, 0, 0)
        lowering.remember_local_hir_type(prelowered.id, result_type, 0, 0)
        val receiver = HirExpr(kind: HirExprKind.Var(receiver_symbol), has_type_: true, type_: result_type, span: span)
        lowering.lower_result_unwrap_core(receiver, pair, nil, false, prelowered, true)
        expect(lowering.errors.len()).to_equal(0)
        var finished = lowering.builder
        val function = finished.end_function()
        var checked = 0
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, args):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                if name == "rt_enum_discriminant" or name == "rt_enum_payload":
                                    expect(args.len()).to_equal(1)
                                    match args[0].kind:
                                        case MirOperandKind.Copy(actual):
                                            expect(actual.id).to_equal(prelowered.id)
                                            expect(actual.id == variable_local.id).to_be(false)
                                        case _: panic("enum call lost its prelowered receiver")
                                    checked = checked + 1
                            case _: ()
                    case _: ()
        expect(checked).to_equal(2)
        expect(tuple_result_bridge_count(function, [MirType.i64(), MirType.i64()])).to_equal(1)

    it "matches a Result tuple using exact native fields and array provenance":
        val source = "fn choose(value: Result<(i64, [i64]), text>) -> i64:\n    match value:\n        case Err(_): -1\n        case Ok((number, items)): number + items[0]\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        val array_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
        expect(tuple_result_bridge_count(function, [MirType.i64(), array_type])).to_equal(1)
        expect(tuple_result_projection_count(function, 0)).to_equal(1)
        expect(tuple_result_projection_count(function, 1)).to_equal(1)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(0)
        expect(tuple_result_call_count(function, "rt_array_get")).to_equal(1)

    it "keeps a single Result tuple bind typed before ordinary tuple indexing":
        val source = "fn choose(value: Result<(i64, [i64]), text>) -> i64:\n    match value:\n        case Err(_): -1\n        case Ok(payload): payload[0] + payload[1][0]\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        val array_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
        expect(tuple_result_bridge_count(function, [MirType.i64(), array_type])).to_equal(1)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(0)
        expect(tuple_result_call_count(function, "rt_array_get")).to_equal(1)

    it "reads the correct native slot when a wrapper tuple pattern skips a field":
        val source = "fn choose(value: Result<(i64, [i64]), text>) -> i64:\n    match value:\n        case Err(_): -1\n        case Ok((_, items)): items[0]\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        expect(tuple_result_projection_count(function, 0)).to_equal(0)
        expect(tuple_result_projection_count(function, 1)).to_equal(1)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(0)
        expect(tuple_result_call_count(function, "rt_array_get")).to_equal(1)

    it "keeps multiargument custom enum payloads on the headered tuple accessor":
        val source = "enum CompetingWrapper:\n    Ok(i64, [i64])\n    Err(text)\nfn choose(value: CompetingWrapper) -> i64:\n    match value:\n        case CompetingWrapper.Err(_): -1\n        case CompetingWrapper.Ok(number, items): number + items[0]\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(2)
        val array_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
        expect(tuple_result_bridge_count(function, [MirType.i64(), array_type])).to_equal(0)

    it "uses the exact Optional tuple signature for Some pattern fields":
        val source = "fn choose(value: Option<(i64, [i64])>) -> i64:\n    match value:\n        case None: -1\n        case Some((number, items)): number + items[0]\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        val array_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
        expect(tuple_result_bridge_count(function, [MirType.i64(), array_type])).to_equal(1)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(0)
        expect(tuple_result_call_count(function, "rt_array_get")).to_equal(1)

    it "preserves native word stride for bool float and nested tuple fields":
        val source = "fn choose(value: Result<(bool, f64, (i64, i64)), text>) -> i64:\n    match value:\n        case Err(_): -1\n        case Ok((flag, score, pair)):\n            if flag and score == 2.5: pair[1] else: 0\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        val pair_type = MirType(kind: MirTypeKind.Tuple([MirType.i64(), MirType.i64()]))
        expect(tuple_result_bridge_count(function, [MirType.bool(), MirType.f64(), pair_type])).to_equal(1)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(0)
        var saw_bool = false
        var saw_float = false
        var saw_pair = false
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.GetField(dest, _, field):
                        val type_ = tuple_result_local_type(function, dest.id)
                        if field == 0 and type_.kind == MirTypeKind.Bool: saw_bool = true
                        if field == 1 and type_.kind == MirTypeKind.F64: saw_float = true
                        if field == 2 and type_.kind == pair_type.kind: saw_pair = true
                    case _: ()
        expect(saw_bool and saw_float and saw_pair).to_be(true)

    it "adds no rejection or guessed native representation for text tuple fields":
        val source = "fn choose(value: Result<(i64, text), text>) -> i64:\n    match value:\n        case Err(_): -1\n        case Ok((number, label)): number\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(2)

    it "does not erase Any tuple fields into the native wrapper plan":
        val source = "fn choose(value: Result<(i64, Any), text>) -> i64:\n    match value:\n        case Err(_): -1\n        case Ok((number, other)): number\n"
        val (function, errors, fatal) = tuple_result_function(source, "choose")
        expect(errors).to_equal("")
        expect(fatal).to_be(false)
        expect(tuple_result_call_count(function, "rt_tuple_get")).to_equal(2)
