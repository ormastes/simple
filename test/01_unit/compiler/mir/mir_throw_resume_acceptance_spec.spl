use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.{
    MirSignature, MirTerminator, MirType, mir_operand_const_int
}
use compiler.mir.mir_data.{MirBuilder}
use compiler.mir.mir_json.{serialize_mir_terminator}

extern fn rt_file_read_text(path: text) -> text

fn terminator_kind(term: MirTerminator) -> text:
    match term:
        case Throw(_): "throw"
        case Resume(_): "resume"
        case _: "other"

describe "MIR Throw and Resume acceptance":
    it "serializes Throw and Resume deterministically with kind before value":
        val thrown = MirTerminator.Throw(mir_operand_const_int(17))
        val resumed = MirTerminator.Resume(mir_operand_const_int(23))
        val throw_json = serialize_mir_terminator(thrown)
        val resume_json = serialize_mir_terminator(resumed)
        expect(throw_json).to_start_with("{\"kind\":\"throw\",\"value\":")
        expect(resume_json).to_start_with("{\"kind\":\"resume\",\"value\":")
        expect(serialize_mir_terminator(thrown)).to_equal(throw_json)
        expect(serialize_mir_terminator(resumed)).to_equal(resume_json)

    it "installs Throw and Resume through their canonical builder methods":
        var throw_builder = MirBuilder.new()
        throw_builder.begin_function(
            SymbolId(id: 971), "throw_probe",
            MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
            Span.empty())
        throw_builder.terminate_throw(mir_operand_const_int(17))
        val throw_function = throw_builder.end_function()
        expect(terminator_kind(throw_function.blocks[0].terminator)).to_equal("throw")

        var resume_builder = MirBuilder.new()
        resume_builder.begin_function(
            SymbolId(id: 972), "resume_probe",
            MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
            Span.empty())
        resume_builder.terminate_resume(mir_operand_const_int(23))
        val resume_function = resume_builder.end_function()
        expect(terminator_kind(resume_function.blocks[0].terminator)).to_equal("resume")

    it "keeps unsupported backend and interpreter paths typed and fail closed":
        val paths = [
            "src/compiler/70.backend/backend/_MirToLlvm/core_codegen.spl",
            "src/compiler/70.backend/backend/llvm_lib_translate.spl",
            "src/compiler/70.backend/backend/native/isel_x86_64.spl",
            "src/compiler/70.backend/backend/cranelift_codegen_adapter.spl",
            "src/compiler/95.interp/mir_interpreter.spl"
        ]
        for path in paths:
            val source = rt_file_read_text(path) ?? ""
            expect(source).to_contain("case Throw(_) | Resume(_):")
            expect(source).to_contain("E-MIR-UNWIND002")

    it "lowers HIR Throw without the former unsupported-expression fatal":
        val source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl") ?? ""
        expect(source).to_contain("case Throw(value):")
        expect(source).to_contain("self.emit_facet_cleanup_from(0)")
        expect(source).to_contain(
            "terminate_throw(mir_operand_move(thrown_local))")
        expect(source.contains("unsupported MIR expression: Throw")).to_be(false)
