"""
MIR method tracing reads environment configuration once per trace family and
keeps the raw provider calls inside lexical FFI authority.
"""

use std.spec.*
use std.io.{file_read}

describe "MIR method trace environment authority":
    it "caches both trace flags behind scoped raw reads":
        val source = file_read(
            "src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""
        expect(source).to_contain("@unsafe(reason: \"raw debug-environment read")
        expect(source).to_contain("rt_env_get(\"SIMPLE_TRACE_DICT_ELEM\")")
        expect(source).to_contain("rt_env_get(\"SIMPLE_MIR_LOG_CONV\")")
        expect(source).to_not_contain("if (rt_env_get(")
        expect(source).to_contain("fn mir_dict_elem_trace_on() -> bool:")
        expect(source).to_contain("fn mir_log_conv_trace_on() -> bool:")
        expect(source).to_contain("val configured = unsafe(capabilities: [ffi]):")
        expect(source).to_contain("if mir_dict_elem_trace_on():")
        expect(source).to_contain("if mir_log_conv_trace_on():")
