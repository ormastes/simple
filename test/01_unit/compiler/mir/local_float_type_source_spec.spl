use std.io_runtime.{file_read}
use std.spec.*

describe "MIR local float typing":
    it "defines the float-local helper used by statement lowering":
        val source = file_read("src/compiler/50.mir/mir_lowering_stmts.spl")
        expect(source).to_contain("fn local_is_float(local: LocalId) -> bool:")

    it "classifies F32/F64 by discriminant, not a match arm (stage-2 mis-dispatch)":
        val source = file_read("src/compiler/50.mir/mir_lowering_stmts.spl")
        expect(source).to_contain("compiler_value_discriminant<MirTypeKind>(MirTypeKind.F64)")
        expect(source).to_contain("compiler_value_discriminant<MirTypeKind>(MirTypeKind.F32)")
        expect(source).not_to_contain("case MirTypeKind.F32: return true")
