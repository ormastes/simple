# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
Implicit-tail `-> T?` returns must build the canonical Option handle.

Bug: doc/08_tracking/bug/stage2_implicit_tail_optional_return_takes_scalar_arm_2026-11-15.md

Stage 2 dispatched the implicit tail of a `-> T?` function into the
Int|Float|Bool|Char arm of the broad `match fn_.return_type.kind` in
lower_function (`_MirLowering/function_lowering.spl`). The disassembly of
`fn f(x: f64) -> f64?: Some(x)` showed `rt_enum_new` followed by
`rt_unwrap_or_trap`: the handle was unwrapped again, so Cranelift refused the
function (`return v31: result 0 has type f64, must match function signature of
i64`, blocking `lib.common.sdn.value.SdnValue.as_f64`) and LLVM silently
returned `fptosi(payload)`. `-> i64?` tails returned the raw payload, and a
`None` arm of an `-> i64?` tail trapped (`.unwrap() called on None`).

The seed interpreter dispatches that match correctly, so the MIR rows below
pass before and after the fix (they pin the intended shape). The source row is
the red->green guard: it requires the discriminant predispatch the fix uses.
The native oracle is test/fixtures/native_option_f64_enum_payload/main.spl.
"""

use std.spec
use std.io_runtime.{file_read}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_json.{serialize_mir_function}

val FUNCTION_FILE: text = "src/compiler/50.mir/_MirLowering/function_lowering.spl"

fn lower_module_json(src: text) -> Dict<text, text>:
    val module = parse_full_frontend(src, "tail_opt.spl", "tail_opt.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("tail_opt.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var out: Dict<text, text> = {}
    for function in mir.functions.values():
        val dot = function.name.rfind(".")
        val short = if dot >= 0: function.name.substring(dot + 1, function.name.len()) else: function.name
        out[short] = serialize_mir_function(function)
    out

val SOURCE: text = "enum Val:\n    Float(f64)\n    Int(i64)\n    Str(text)\n\n" +
    "fn as_f64(v: Val) -> f64?:\n    match v:\n        case Val.Float(f): Some(f)\n        case Val.Int(i): Some(i.to_float())\n        case _: None\n\n" +
    "fn some_f64(x: f64) -> f64?:\n    Some(x)\n\n" +
    "fn cond_f64(b: bool) -> f64?:\n    if b:\n        Some(1.5)\n    else:\n        None\n\n" +
    "fn some_i64(x: i64) -> i64?:\n    Some(x)\n\n" +
    "fn none_i64() -> i64?:\n    None\n"

describe "implicit-tail optional returns keep the Option handle":
    it "builds rt_enum_new and never unwraps the tail of a `-> T?` function":
        val fns = lower_module_json(SOURCE)
        for name in ["as_f64", "some_f64", "cond_f64", "some_i64", "none_i64"]:
            val mir = fns[name] ?? ""
            expect(mir.len() > 0).to_equal(true)
            expect(mir).to_contain("rt_enum_new")
            expect(mir.contains("rt_unwrap_or_trap")).to_equal(false)

    it "dispatches the tail-return kind by discriminant, not a broad match":
        val source = file_read(FUNCTION_FILE)
        expect(source).to_contain("val tail_return_disc = _sffi_hir_type_discriminant(fn_.return_type.kind)")
        expect(source).to_contain("elif tail_return_disc == tail_optional_disc:")
        expect(source.contains("                match fn_.return_type.kind:\n                    case HirTypeKind.Any | HirTypeKind.TypeParam(_, _):")).to_equal(false)
