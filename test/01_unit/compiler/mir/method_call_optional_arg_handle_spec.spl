"""
Method-call arguments must be promoted to Option handles for scalar `T?`
parameters, exactly as free-function call arguments are
(doc/08_tracking/bug/method_call_optional_param_arg_not_boxed_2026-10-11.md).

The representation rule is: an Optional value is ALWAYS the enum-id-1 handle
or the nil sentinel, never a raw payload word. A callee tests its `i64?`
parameter with `rt_is_none`, and `rt_is_none(3)` is true, so a raw `3` passed
by `w.put(3)` read as nil.

Two lowering lanes are pinned, because they reach different arms of
`lower_method_call`: without the method resolver every receiver call takes the
`Unresolved` arm (owner recovered by name) and `W.make(..)` the `StaticMethod`
arm; with `resolve_methods` the receiver calls take the `InstanceMethod` arm
(a call of a trait method on a concrete implementor resolves as an instance
method too). The `TraitMethod` and `FreeFunction` (receiver-syntax call of a
free function) arms use the same `lower_method_call_arg` helper but are not
reachable from this in-process harness: after `resolve_methods` it lowers the
`W.make(3)` / `w.ufcs_take(3)` callers to an empty body.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_json.{serialize_mir_function}
use compiler.semantics.resolve.{resolve_methods_quiet}

fn lower_function_json(src: text, target: text, resolved: bool) -> text:
    val module = parse_full_frontend(src, "method_opt_arg.spl", "method_opt_arg.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("method_opt_arg.spl")
    var hir = hir_lowering.lower_module(module)
    if resolved:
        val (resolved_hir, _errors) = resolve_methods_quiet(hir)
        hir = resolved_hir
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    for function in mir.functions.values():
        if function.name == target or function.name.ends_with(".{target}"):
            return serialize_mir_function(function)
    ""

fn count_of(hay: text, needle: text) -> i64:
    var n = 0
    var i = 0
    while i + needle.len() <= hay.len():
        if hay.substring(i, i + needle.len()) == needle:
            n = n + 1
            i = i + needle.len()
        else:
            i = i + 1
    n

val SRC = (
    "trait Sink:\n    me sink(v: i64?)\n\n" +
    "class W:\n    n: i64\n\n" +
    "    me put(v: i64?):\n        if v == nil:\n            self.n = self.n + 1\n\n" +
    "    me putb(v: bool?):\n        if v == nil:\n            self.n = self.n + 1\n\n" +
    "    me putf(v: f64?):\n        if v == nil:\n            self.n = self.n + 1\n\n" +
    "    me plain(v: i64):\n        self.n = self.n + v\n\n" +
    "    me two(a: i64, b: i64?):\n        if b == nil:\n            self.n = self.n + a\n\n" +
    "    static fn make(v: i64?) -> W:\n        W(n: v ?? 0)\n\n" +
    "impl Sink for W:\n    me sink(v: i64?):\n        if v == nil:\n            self.n = self.n + 1\n\n" +
    "fn inst_lit(w: W):\n    w.put(3)\n\n" +
    "fn inst_var(w: W, x: i64):\n    w.put(x)\n\n" +
    "fn inst_bool(w: W, x: bool):\n    w.putb(x)\n\n" +
    "fn inst_float(w: W, x: f64):\n    w.putf(x)\n\n" +
    "fn inst_nil(w: W):\n    w.put(nil)\n\n" +
    "fn inst_second(w: W):\n    w.two(1, 3)\n\n" +
    "fn inst_opt(w: W, o: i64?):\n    w.put(o)\n\n" +
    "fn inst_plain(w: W):\n    w.plain(3)\n\n" +
    "fn static_lit() -> W:\n    W.make(3)\n\n" +
    "fn trait_lit(w: W):\n    w.sink(3)\n"
)

# Number of STATIC boxings: `rt_enum_new` calls with a discriminant fixed at
# compile time. -1 = the function was not lowered; -2 = the argument went
# through the runtime sentinel classification (normalize_option_handle), which
# reads the integer 3 as nil -- counting `rt_enum_new` alone passed for that
# shape too and proved nothing about Some.
fn boxes(name: text, resolved: bool) -> i64:
    val j = lower_function_json(SRC, name, resolved)
    if j.len() == 0:
        return -1
    if j.contains("option_norm_raw") or j.contains("rt_enum_id"):
        return -2
    count_of(j, "rt_enum_new")

describe "method-call arguments reach scalar optional parameters as Option handles (unresolved lane)", tag: ["only-compiled"]:
    it "boxes a plain scalar argument of a receiver call recovered by name":
        for name in ["inst_lit", "inst_var", "inst_bool", "inst_float", "inst_second", "trait_lit"]:
            expect(boxes(name, false)).to_equal(1)

    it "materializes a nil literal argument as the None handle":
        expect(boxes("inst_nil", false)).to_equal(1)

    it "boxes the argument of a static method call":
        expect(boxes("static_lit", false)).to_equal(1)

    it "passes an already-optional argument through and leaves non-optional parameters raw":
        expect(boxes("inst_opt", false)).to_equal(0)
        expect(boxes("inst_plain", false)).to_equal(0)
        expect(count_of(lower_function_json(SRC, "inst_plain", false), "rt_enum_id")).to_equal(0)

describe "method-call arguments reach scalar optional parameters as Option handles (resolved lane)", tag: ["only-compiled"]:
    it "boxes a plain scalar argument of a resolved instance method call":
        for name in ["inst_lit", "inst_var", "inst_bool", "inst_float", "inst_second"]:
            expect(boxes(name, true)).to_equal(1)
        expect(boxes("inst_nil", true)).to_equal(1)

    it "boxes the argument of a trait method called on its implementor":
        expect(boxes("trait_lit", true)).to_equal(1)

    it "passes an already-optional argument through and leaves non-optional parameters raw":
        expect(boxes("inst_opt", true)).to_equal(0)
        expect(boxes("inst_plain", true)).to_equal(0)
