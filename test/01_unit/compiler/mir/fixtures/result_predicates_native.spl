# Exit codes are semantic assertions; no assertion-runtime ABI is required.
var result_predicate_evaluations: i64 = 0

fn result_predicate_make(ok: bool) -> Result<i64, text>:
    result_predicate_evaluations = result_predicate_evaluations + 1
    if ok: return Ok(37)
    Err("failed")

struct ResultPredicateCustom:
    value: i64

impl ResultPredicateCustom:
    fn is_ok(self) -> bool: self.value == 9

fn main() -> i64:
    if not result_predicate_make(true).is_ok(): return 11
    if result_predicate_make(true).is_err(): return 12
    if result_predicate_make(false).is_ok(): return 13
    if not result_predicate_make(false).is_err(): return 14
    if result_predicate_evaluations != 4: return 15
    val custom = ResultPredicateCustom(value: 9)
    if not custom.is_ok(): return 16
    val rejected = ResultPredicateCustom(value: 8)
    if rejected.is_ok(): return 17
    print "result-predicate-truth-table-pass"
    0
