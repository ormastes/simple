# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "backend MIR optimization pipeline optional descriptor handling":
    # @manual scenario evidence
    it "matches optional pass descriptors explicitly before reading the payload":
        # @req REQ-SSPEC-COMPILER
        step("matches optional pass descriptors explicitly before reading the payload")
        val source = rt_file_read_text("src/compiler/60.mir_opt/mir_opt/mod.spl") ?? ""

        expect(source).to_contain("match descriptor:\n            case Some(d):")
        expect(source).to_contain("if pass_status_allows_transform(d.status) and mir_pass_applies_to_backend(pass_name, backend_name):")
        expect(source).to_contain("case nil:\n                pass")

    it "does not use the bootstrap-unsafe truthiness plus unwrap form":
        # @req REQ-SSPEC-COMPILER
        step("does not use the bootstrap-unsafe truthiness plus unwrap form")
        val source = rt_file_read_text("src/compiler/60.mir_opt/mir_opt/mod.spl") ?? ""

        expect(source.contains("if descriptor.? and pass_status_allows_transform(descriptor.unwrap().status) and mir_pass_applies_to_backend(pass_name, backend_name):")).to_equal(false)
