use std.spec.*
use compiler.mir.text_extern_abi.{boxed_text_arg_indices, text_arg_indices}

describe "owned Redis text extern contracts":
    it "keeps text-to-bytes and TCP bind/write arguments as complete text values":
        expect(boxed_text_arg_indices("rt_text_to_bytes").unwrap()).to_equal([0])
        expect(boxed_text_arg_indices("rt_io_tcp_bind").unwrap()).to_equal([0])
        expect(boxed_text_arg_indices("rt_io_tcp_write_text").unwrap()).to_equal([1])

    it "keeps the environment pointer-plus-length ABI separate":
        expect(text_arg_indices("rt_env_get").unwrap()).to_equal([0])
        expect(boxed_text_arg_indices("rt_env_get")).to_be_nil()
        expect(text_arg_indices("rt_text_to_bytes")).to_be_nil()
        expect(text_arg_indices("rt_io_tcp_bind")).to_be_nil()
        expect(text_arg_indices("rt_io_tcp_write_text")).to_be_nil()

    it "does not rewrite foreign C strings or homonymous providers":
        expect(boxed_text_arg_indices("strlen")).to_be_nil()
        expect(boxed_text_arg_indices("other.rt_io_tcp_bind")).to_be_nil()
        expect(boxed_text_arg_indices("other.rt_text_to_bytes")).to_be_nil()
        expect(boxed_text_arg_indices("other.rt_io_tcp_write_text")).to_be_nil()

    it "preserves existing boxed argument positions":
        expect(boxed_text_arg_indices("rt_string_builder_push").unwrap()).to_equal([1])
        expect(boxed_text_arg_indices("rt_file_write_text_at").unwrap()).to_equal([0, 2])
