# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/mir/mir_span_thread_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""
use std.spec.step

# doc-path: doc/01_research/local/mir_span_thread_spec.md
# doc-path: doc/03_plan/sys_test/mir_span_thread_spec.md
# doc-path: doc/04_architecture/mir_span_thread_spec.md
# doc-path: doc/05_design/mir_span_thread_spec_oracles.md
# @manual: primary

"""
# MIR Per-Instruction Span Threading Specification

**Feature IDs:** #TBD
**Category:** Compiler / MIR
**Lane:** DS5 mir-span-thread

## Overview

Before this change, every `emit_*` helper on `MirBuilder`
(`src/compiler/50.mir/mir_data.spl`) hardcoded `span: nil` on the `MirInst`
it built, so no MIR instruction ever carried a real source location -- the
missing input for debugger line maps, replay locations, coverage, and
per-instruction DWARF `!dbg` emission.

`MirBuilder` now carries a `current_span: Span?` field, seeded per-function
from `begin_function`'s span, and pushed/popped by save-set-restore
wrappers around `lower_stmt` (`mir_lowering_stmts.spl`) and `lower_expr`
(`_MirLoweringExpr/expr_dispatch.spl`) using each HIR node's own `.span`.

## Span sources covered

The hand-built HIR case assigns distinct line numbers to integer literals
and nested `Binary` expressions. It checks that recursive lowering restores
the compound expression's own span before emitting its instruction. The
parsed-source case runs source through `parse_full_frontend`, `HirLowering`,
and `MirLowering`; it compares each array, nested-array, and text bounds
check with the corresponding HIR `Index` span, including its source line and
column.
"""

use std.spec.step

use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_definitions.{HirFunction, HirBlock, HirExpr, HirExprKind, HirBinOp}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.{MirFunction, MirModule}

fn mk_span(line: i64) -> Span:
    """A span whose only load-bearing field for this spec is `line` --
    distinct, hand-chosen values stand in for "distinct source locations"
    since no real parser is involved."""
    Span(start: 0, end: 0, line: line, col: 1, file: "synthetic", length: 0)

fn i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: mk_span(0))

fn int_lit(value: i64, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn add(left: HirExpr, right: HirExpr, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Binary(HirBinOp.Add, left, right), has_type_: true, type_: i64_type(), span: mk_span(line))

fn make_main_fn() -> HirFunction:
    # (1 @ line 10) + (2 @ line 20)   -- inner Binary emitted @ line 30
    # inner_result + (3 @ line 40)    -- outer Binary emitted @ line 50
    val lit1 = int_lit(1, 10)
    val lit2 = int_lit(2, 20)
    val inner = add(lit1, lit2, 30)
    val lit3 = int_lit(3, 40)
    val outer = add(inner, lit3, 50)
    val body = HirBlock(stmts: [], has: true, value: outer, span: mk_span(5))
    HirFunction(
        symbol: SymbolId(id: 1),
        name: "main",
        type_params: [],
        params: [],
        return_type: i64_type(),
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: nil,
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(1)
    )

fn make_hir_module() -> HirModule:
    var functions: Dict<SymbolId, HirFunction> = {}
    val main_fn = make_main_fn()
    functions[main_fn.symbol] = main_fn
    HirModule(
        name: "mir_span_thread_test",
        path: "synthetic/mir_span_thread_test.spl",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

fn collect_index_spans(expr: HirExpr, spans: [Span]) -> [Span]:
    match expr.kind:
        case HirExprKind.Index(base, index):
            val after_base = collect_index_spans(base, spans)
            val after_index = collect_index_spans(index, after_base)
            after_index.push(expr.span)
        case HirExprKind.Binary(_, left, right):
            val after_left = collect_index_spans(left, spans)
            collect_index_spans(right, after_left)
        case _:
            spans

fn lower_parsed_index_source(source: text) -> (HirModule, MirModule, i64):
    val parsed = parse_full_frontend(source, "mir_span_thread_parsed.spl", "mir_span_thread_parsed", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("mir_span_thread_parsed.spl")
    val hir = hir_lowering.lower_module(parsed)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    (hir, mir, hir_lowering.errors.len() + mir_lowering.errors.len())

fn hir_function_index_spans(module: HirModule, target: text) -> ([SymbolId], [Span]):
    var symbols: [SymbolId] = []
    var spans: [Span] = []
    for function in module.functions.values():
        if function.name == target:
            symbols = symbols.push(function.symbol)
            if function.body.has:
                spans = collect_index_spans(function.body.value, spans)
    (symbols, spans)

fn mir_bounds_check_spans(function: MirFunction) -> ([Span], i64):
    var spans: [Span] = []
    var missing_spans: i64 = 0
    for block in function.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Intrinsic(_, "bounds_check", _):
                    if val span = inst.span:
                        spans = spans.push(span)
                    else:
                        missing_spans = missing_spans + 1
                case _:
                    ()
    (spans, missing_spans)

fn mir_function_bounds_check_spans(module: MirModule, hir_symbols: [SymbolId]) -> ([Span], i64, i64):
    if hir_symbols.len() != 1:
        return ([], 0, 0)
    val target_symbol = hir_symbols[0]
    var spans: [Span] = []
    var missing_spans: i64 = 0
    var selected_functions: i64 = 0
    for function in module.functions.values():
        if function.symbol.id == target_symbol.id:
            selected_functions = selected_functions + 1
            val (function_spans, function_missing) = mir_bounds_check_spans(function)
            for span in function_spans:
                spans = spans.push(span)
            missing_spans = missing_spans + function_missing
    (spans, missing_spans, selected_functions)

fn span_location_matches(left: Span, right: Span) -> bool:
    left.start == right.start and left.end == right.end and left.line == right.line and left.col == right.col

describe "MIR instructions carry real per-instruction source spans (DS5)":
    # @manual scenario evidence
    it "gives each hand-spanned HIR leaf its OWN span in the lowered MIR, and gives each compound Binary node ITS OWN span back rather than its last-lowered operand's":
        # @req REQ-SSPEC-UNIT
        step("gives each hand-spanned HIR leaf its OWN span in the lowered MIR, and gives each compound Binary node ITS OWN span back rather than its last-lowered operand's")
        val hir_module = make_hir_module()
        var mir_lowering = MirLowering.new(hir_module.symbols)
        val mir_module = mir_lowering.lower_module(hir_module)

        val fns = mir_module.functions.values()
        expect(fns.len() > 0).to_equal(true)
        val mir_fn = fns[0]

        var const1_line: i64 = -1
        var const1_has_span = false
        var const2_line: i64 = -1
        var const2_has_span = false
        var const3_line: i64 = -1
        var const3_has_span = false
        var binop_lines: [i64] = []

        for block in mir_fn.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Const(_, value, _):
                        match value:
                            case MirConstValue.Int(n):
                                if n == 1:
                                    if val sp = inst.span:
                                        const1_has_span = true
                                        const1_line = sp.line
                                if n == 2:
                                    if val sp = inst.span:
                                        const2_has_span = true
                                        const2_line = sp.line
                                if n == 3:
                                    if val sp = inst.span:
                                        const3_has_span = true
                                        const3_line = sp.line
                            case _:
                                nil
                    case MirInstKind.BinOp(_, _, _, _):
                        if val sp = inst.span:
                            binop_lines = binop_lines.push(sp.line)
                    case _:
                        nil

        # Leaves: each integer-literal Const must carry its OWN hand-chosen
        # span line, not nil and not another leaf's line.
        expect(const1_has_span).to_equal(true)
        expect(const1_line).to_equal(10)
        expect(const2_has_span).to_equal(true)
        expect(const2_line).to_equal(20)
        expect(const3_has_span).to_equal(true)
        expect(const3_line).to_equal(40)

        # Compound nodes: exactly 2 BinOp instructions (inner then outer, in
        # lowering/emission order -- operands are lowered before the node's
        # own instruction is emitted). The inner Binary must read back its
        # OWN span (30), not operand 2's span (20) it just finished
        # recursing through. The outer Binary must read back ITS OWN span
        # (50), not the inner result's span (30) or literal 3's span (40).
        # This is exactly the case the lower_expr save/restore wrapper
        # exists for: a broken (non-stacking) implementation would leak the
        # last-processed child's span into the parent's own instruction.
        expect(binop_lines.len()).to_equal(2)
        expect(binop_lines[0]).to_equal(30)
        expect(binop_lines[1]).to_equal(50)

    it "preserves parsed array, nested-array, and text access spans on their bounds checks":
        step("preserves parsed array, nested-array, and text access spans on their bounds checks")
        val source = (
            "fn array_case(values: [i64], index: i64) -> i64:\n    values[index]\n\n" +
            "fn nested_case(values: [[i64]], row: i64, col: i64) -> i64:\n    values[row][col] + values[col][row]\n\n" +
            "fn text_case(value: text, index: i64) -> text:\n    value[index]\n"
        )
        val (hir, mir, lowering_errors) = lower_parsed_index_source(source)
        val (array_hir_symbols, array_hir_spans) = hir_function_index_spans(hir, "array_case")
        val (nested_hir_symbols, nested_hir_spans) = hir_function_index_spans(hir, "nested_case")
        val (text_hir_symbols, text_hir_spans) = hir_function_index_spans(hir, "text_case")
        val (array_mir_spans, array_missing, array_mir_matches) = mir_function_bounds_check_spans(mir, array_hir_symbols)
        val (nested_mir_spans, nested_missing, nested_mir_matches) = mir_function_bounds_check_spans(mir, nested_hir_symbols)
        val (text_mir_spans, text_missing, text_mir_matches) = mir_function_bounds_check_spans(mir, text_hir_symbols)

        expect(lowering_errors).to_equal(0)
        expect(array_hir_symbols.len()).to_equal(1)
        expect(nested_hir_symbols.len()).to_equal(1)
        expect(text_hir_symbols.len()).to_equal(1)
        expect(array_mir_matches).to_equal(1)
        expect(nested_mir_matches).to_equal(1)
        expect(text_mir_matches).to_equal(1)
        expect(array_hir_spans.len()).to_equal(1)
        expect(nested_hir_spans.len()).to_equal(4)
        expect(text_hir_spans.len()).to_equal(1)
        expect(array_mir_spans.len()).to_equal(1)
        expect(nested_mir_spans.len()).to_equal(4)
        expect(text_mir_spans.len()).to_equal(1)
        expect(array_missing + nested_missing + text_missing).to_equal(0)

        # Parsed source must supply a real line and column, and each emitted
        # check must carry the precise HIR Index span. Nested accesses emit
        # each base check first, restore the outer Index span, then continue
        # into the following sibling expression without leaking that span.
        expect(array_hir_spans[0].line).to_equal(2)
        expect(array_hir_spans[0].col).to_be_greater_than(0)
        expect(span_location_matches(array_mir_spans[0], array_hir_spans[0])).to_equal(true)
        expect(nested_hir_spans[0].line).to_equal(5)
        expect(nested_hir_spans[0].col).to_be_greater_than(0)
        expect(nested_hir_spans[1].line).to_equal(5)
        expect(nested_hir_spans[1].end).to_be_greater_than(nested_hir_spans[0].end)
        expect(nested_hir_spans[2].line).to_equal(5)
        expect(nested_hir_spans[2].start).to_be_greater_than(nested_hir_spans[1].end)
        expect(nested_hir_spans[3].line).to_equal(5)
        expect(nested_hir_spans[3].end).to_be_greater_than(nested_hir_spans[2].end)
        expect(span_location_matches(nested_mir_spans[0], nested_hir_spans[0])).to_equal(true)
        expect(span_location_matches(nested_mir_spans[1], nested_hir_spans[1])).to_equal(true)
        expect(span_location_matches(nested_mir_spans[2], nested_hir_spans[2])).to_equal(true)
        expect(span_location_matches(nested_mir_spans[3], nested_hir_spans[3])).to_equal(true)
        expect(text_hir_spans[0].line).to_equal(8)
        expect(text_hir_spans[0].col).to_be_greater_than(0)
        expect(span_location_matches(text_mir_spans[0], text_hir_spans[0])).to_equal(true)
