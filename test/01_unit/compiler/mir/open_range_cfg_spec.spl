# @req REQ-SSPEC-COMPILER
use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_lowering_stmts.*

fn range_condition_shape(end: HirExpr?) -> text:
    val start = HirExpr(kind: HirExprKind.IntLit(1, nil), has_type_: false, type_: nil, span: Span.empty())
    val body = HirBlock(stmts: [], has: false, value: nil, span: Span.empty())
    var lowering = MirLowering.new(SymbolTable.new())
    lowering.lower_for_range(SymbolId(id: 1), start, end, false, nil, body, Span.empty())
    for block in lowering.builder.blocks:
        if block.label == Some("for_range_cond"):
            match block.terminator:
                case MirTerminator.Goto(_): return "goto"
                case MirTerminator.If(_, _, _): return "if"
                case _: return "other"
    "missing"

describe "Real MIR condition for open-ended ranges":
    it "enters an open-ended body without comparing to a fabricated zero":
        expect(range_condition_shape(nil)).to_equal("goto")
    it "retains the bound condition for a present end":
        val end = HirExpr(kind: HirExprKind.IntLit(4, nil), has_type_: false, type_: nil, span: Span.empty())
        expect(range_condition_shape(end)).to_equal("if")
