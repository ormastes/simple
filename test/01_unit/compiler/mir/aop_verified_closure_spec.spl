use std.spec
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.common.assurance.flight_rules.{assurance_text_hash}
use compiler.common.assurance.formal_interfaces.{AspectEvidenceClassV1, AspectCertificateV1}
use compiler.hir.hir_types.{SymbolId}
use compiler.frontend.core.aop.{AdviceCallInfo, AdviceForm, JoinPointKind, WeavingResult}
use compiler.mir.mir_instructions.{BlockId, MirBlock, MirFunction, MirTerminator}
use compiler.mir.mir_types.{MirSignature, MirType}
use compiler.mir.mir_json.{serialize_mir_function}
use compiler.mir.mir_aop_injection.{apply_weaving_result, apply_weaving_result_verified}

fn empty_aop_function() -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 1), name: "target",
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [], blocks: [MirBlock(BlockId(id: 0), nil, [], MirTerminator.Ret(nil))],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {}, layout_phase: nil,
        is_kernel: false, is_export_c: false, export_name: "",
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

describe "verified AOP closure":
    it "rejects around advice while MIR only implements a pre-hook":
        val call = AdviceCallInfo(JoinPointKind.Execution, "around_target", AdviceForm.Around, 0, 0)
        val weaving = WeavingResult(1, 1, [call], [])
        val checked = apply_weaving_result_verified(empty_aop_function(), weaving, [])
        expect(checked.is_err()).to_equal(true)

    it "rejects ordinary advice when no typed noninterference or monitor certificate is attached":
        val call = AdviceCallInfo(JoinPointKind.Execution, "before_target", AdviceForm.Before, 0, 0)
        val weaving = WeavingResult(1, 1, [call], [])
        val checked = apply_weaving_result_verified(empty_aop_function(), weaving, [])
        val message = match checked:
            case Ok(_): ""
            case Err(error): error
        expect(message).to_contain("CERTIFICATE")

    it "accepts a ghost aspect certificate only for the exact woven identity":
        val base = empty_aop_function()
        val call = AdviceCallInfo(JoinPointKind.Execution, "ghost_trace", AdviceForm.Before, 0, 0)
        val weaving = WeavingResult(1, 1, [call], [])
        val woven = apply_weaving_result(base, weaving)
        val certificate = AspectCertificateV1(
            "ghost_trace", AspectEvidenceClassV1.GhostNoninterference,
            assurance_text_hash(serialize_mir_function(base)),
            assurance_text_hash(serialize_mir_function(woven)),
            "proof-receipt", true, false)
        expect(apply_weaving_result_verified(base, weaving, [certificate]).is_ok()).to_equal(true)
