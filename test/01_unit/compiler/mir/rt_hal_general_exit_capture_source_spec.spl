# @cover src/compiler/50.mir/mir_rt_hal_boundary.spl 70%

use std.spec.*
use std.fs

describe "RT/HAL general exit capture source contract":
    it "uses sealed resolved-call provenance rather than a callable spelling":
        val lowering = fs.read_text("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")
        val boundary = fs.read_text("src/compiler/50.mir/mir_rt_hal_boundary.spl")
        val semantics = fs.read_text("src/compiler/35.semantics/rt_hal_tag.spl")
        val json = fs.read_text("src/compiler/50.mir/mir_json.spl")
        expect(lowering.contains("rt_hal_env_executor_kind_for_symbol")).to_equal(true)
        expect(lowering.contains("resolved.defining_module")).to_equal(true)
        expect(lowering.contains("RtHalEnvExecutorProvenance")).to_equal(true)
        expect(boundary.contains("rt_hal_env_access_marked_plan")).to_equal(true)
        expect(boundary.contains("marker -> Call")).to_equal(true)
        expect(boundary.contains("rt_hal_env_access_same_direct_operand")).to_equal(true)
        expect(boundary.contains("rt_hal_env_access_same_plan_operand")).to_equal(true)
        expect(boundary.contains("rt_hal_env_access_provenance_record_matches")).to_equal(true)
        expect(boundary.contains("rt_hal_env_executor_provenance_register")).to_equal(true)
        expect(boundary.contains("rt_hal_env_access_executor_name")).to_equal(false)
        expect(json.contains("E-MIR-RTHAL-UNSTRIPPED-PROVENANCE")).to_equal(true)
        expect(semantics.contains("RT_HAL_ENV_CAPABILITY_EDGE_CAP")).to_equal(true)
        expect(semantics.contains("fixed-degree reverse graph")).to_equal(true)

    it "keeps the cold staged installer compiler-private and orders its real seal":
        val boundary = fs.read_text("src/compiler/50.mir/mir_rt_hal_boundary.spl")
        val app_surface = fs.read_text("src/app/io/__init__.spl")
        val compat_surface = fs.read_text("src/app/io/mod.spl")
        val host = fs.read_text("src/app/io/rt_hal_isolated_host.spl")
        val environment_host = fs.read_text("src/app/io/env_access_host.spl")
        # MIR owns the linker symbol; neither user-facing app.io facade may
        # re-export it for source calls that could leave an arena Installing.
        expect(boundary.contains("rt_hal_compiler_stage_isolated_exact_host_from_plan_path_or_fail")).to_equal(true)
        expect(app_surface.contains("rt_hal_compiler_stage_isolated_exact_host_from_plan_path")).to_equal(false)
        expect(compat_surface.contains("rt_hal_compiler_stage_isolated_exact_host_from_plan_path")).to_equal(false)
        expect(environment_host.contains("pub(package) fn rt_hal_compiler_stage_isolated_exact_host_from_plan_path")).to_equal(true)
        expect(host.contains("pub(package) fn rt_hal_install_isolated_exact_host_from_plan_v3")).to_equal(true)
        expect(host.contains("export rt_hal_install_isolated_exact_host_from_plan_v3")).to_equal(false)
        # The controller prefix must stage the complete plan, install its
        # bounded exit arena, then bind schemas and perform the controller
        # seal, whose runtime owner is the only Ready publication point.
        expect(boundary.contains("rt_hal_exact_exit_arena_install_or_fail")).to_equal(true)
        expect(boundary.contains("rt_hal_exact_exit_schema_bind_descriptors")).to_equal(true)
        expect(boundary.contains("rt_hal_exact_exit_controller_seal")).to_equal(true)

    it "preserves typed terminal exits for the V2 bounded encoder":
        val source = fs.read_text("src/compiler/50.mir/mir_rt_hal_boundary.spl")
        expect(source.contains("RtHalExitCapture")).to_equal(true)
        expect(source.contains("rt_hal_exit_type_descriptor_v2")).to_equal(true)
        expect(source.contains("rt_hal_exit_schema_id_v2")).to_equal(true)
        expect(source.contains("rt_hal_exit_codec_plan_v2")).to_equal(true)
        expect(source.contains("RtHalExitCodecPlan.Utf8Text(4096)")).to_equal(true)
        expect(source.contains("value_type: MirType")).to_equal(true)
        expect(source.contains("case Throw(_, _)")).to_equal(true)
        expect(source.contains("case Resume(_, _)")).to_equal(true)
        expect(source.contains("case Abort(_)")).to_equal(true)
        expect(source.contains("v2;array;" )).to_equal(true)
        expect(source.contains("v2;tuple;" )).to_equal(true)
        expect(source.contains("v2;result;" )).to_equal(true)
        expect(source.contains("case Vec4f | Vec8f | Vec4d | Vec4i | Vec8i | Ptr(_, _) | Ref(_, _) |")).to_equal(true)
