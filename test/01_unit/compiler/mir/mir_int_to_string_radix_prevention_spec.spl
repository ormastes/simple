"""
## Purpose and audience
Purpose: Prevent regression of Pure-Simple MIR lowering for 1-arg `int.to_string(radix)`.
Audience: Compiler engineers maintaining MIR expression lowering.
"""
# @cover src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl
# @req REQ-COMPFIX-1

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

fn read_source_text(path: text) -> text:
    match rt_file_read_text(path):
        case Some(content): content
        case None: ""

describe "Integer.to_string(radix) regression guard":
    it "keeps 1-arg radix dispatch and bounds guard in method_calls_literals":
        step("Inspect MIR method_calls_literals lowering for lower_int_to_string_radix_v1")
        val source = read_source_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")

        expect(source).to_contain("me lower_int_to_string_radix_v1(")
        expect(source).to_contain("if method == \"to_string\" and args.len() == 1:")
        expect(source).to_contain("to_string radix must be between 2 and 36")
        expect(source).to_contain("emit_radix_digit_char_v1")
        expect(source).to_contain("MirTypeKind.U64")
