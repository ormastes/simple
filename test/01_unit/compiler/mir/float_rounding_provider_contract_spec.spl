use std.spec
use std.io.{file_read}

describe "primitive float rounding provider contract":
    it "uses only the shared native-host and hosted-SoSIX f64 ABI":
        val lowering = file_read(
            "src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
        val runtime = file_read("src/runtime/runtime_native.c")
        val library = file_read("src/lib/nogc_sync_mut/io/math.spl")
        val runtime_compiler = file_read(
            "src/compiler/70.backend/backend/runtime_compiler.spl")
        val sosix_admission = file_read("src/os/_QemuRunner/os_build_run.spl")
        val executable_spec = file_read(
            "test/02_integration/compiler/native_float_rounding_method_resolution_spec.spl")

        expect(lowering).to_contain("rt_math_floor")
        expect(lowering).to_contain("rt_math_ceil")
        expect(lowering.contains("MirConstValue.Str(\"rt_math_round\")")).to_equal(false)
        expect(runtime).to_contain("double rt_math_floor(double x)")
        expect(runtime).to_contain("double rt_math_ceil(double x)")
        expect(runtime.contains("double rt_math_round(double x)")).to_equal(false)
        expect(library).to_contain("extern fn rt_math_floor(x: f64) -> f64")
        expect(library).to_contain("extern fn rt_math_ceil(x: f64) -> f64")
        expect(library).to_contain("Round to nearest integer (pure Simple, rt_math_round not in runtime)")
        # The hosted SoSIX admission probe links and executes this exact
        # runtime bundle.  The executable regression uses the same bundle and
        # LLVM backend, so it tests the provider path instead of merely naming
        # SoSIX in a source comment.
        expect(runtime_compiler).to_contain("runtime_native.c")
        expect(sosix_admission).to_contain(
            "\"--runtime-bundle\", \"core-c-bootstrap\"")
        expect(sosix_admission).to_contain("process_run_timeout(probe_output")
        expect(executable_spec).to_contain(
            "\"--runtime-bundle\", \"core-c-bootstrap\"")
        expect(executable_spec).to_contain(
            "\"native-build\", \"--backend\", \"llvm\"")
        expect(executable_spec).to_contain("rt_process_run(candidate, [])")
