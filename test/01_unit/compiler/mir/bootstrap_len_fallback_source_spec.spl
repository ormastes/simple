extern fn rt_file_read_text(path: text) -> text?

fn method_call_lowering_source() -> text:
    rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl") ?? ""

describe "bootstrap MIR method-call lowering source":
    it "defines untyped bootstrap len calls through the unified runtime helper":
        val source = method_call_lowering_source().replace("\r\n", "\n")

        expect(source).to_contain("if len_symbol == \"\" and len_recovery_allowed and method != \"is_empty\":")
        expect(source).to_contain("len_symbol = \"rt_len\"")
