use std.spec.*
use std.io_runtime.{file_read}
use compiler.common.value_access.{compiler_value_discriminant, compiler_value_payload, compiler_value_tuple_at}

# Ownership of the raw runtime value accessors (rt_enum_discriminant /
# rt_enum_payload / rt_tuple_get) inside the compiler. The canonical owner is
# src/compiler/00.common/value_access.spl; routed modules import the typed
# compiler_value_* wrappers and declare no runtime extern of their own.
# Record: doc/08_tracking/bug/value_access_ownership_spec_never_executes_2026-09-18.md
# (its "remaining debt" section lists the modules that still read the raw ABI
# directly and are not yet asserted here).

enum CompilerValueAccessProbe:
    Empty
    Single(text)
    Pair(i64, text)

fn expect_no_direct_runtime_value_access(path: text):
    val source = file_read(path)
    expect(source.contains("extern fn rt_enum_discriminant")).to_equal(false)
    expect(source.contains("extern fn rt_enum_payload")).to_equal(false)
    expect(source.contains("extern fn rt_tuple_get")).to_equal(false)
    expect(source.contains("rt_enum_discriminant(")).to_equal(false)
    expect(source.contains("rt_enum_payload(")).to_equal(false)
    expect(source.contains("rt_tuple_get(")).to_equal(false)

describe "compiler runtime-value accessor ownership":
    it "preserves typed enum discriminant and tuple-payload semantics":
        val pair = CompilerValueAccessProbe.Pair(41, "owned")
        val pair_disc = compiler_value_discriminant(pair)
        val empty_disc = compiler_value_discriminant(CompilerValueAccessProbe.Empty)
        val single: text = compiler_value_payload(CompilerValueAccessProbe.Single("direct"))
        val payload: i64 = compiler_value_payload(pair)
        val number: i64 = compiler_value_tuple_at(payload, 0)
        val label: text = compiler_value_tuple_at(payload, 1)

        expect(pair_disc >= 0).to_equal(true)
        expect(pair_disc == empty_disc).to_equal(false)
        expect(single).to_equal("direct")
        expect(number).to_equal(41)
        expect(label).to_equal("owned")

    it "keeps the representation ABI private to one inline facade":
        val facade = file_read("src/compiler/00.common/value_access.spl")
        val allowlist = file_read("scripts/check/no_direct_rt_allowlist.txt")

        expect(facade.split("extern fn rt_enum_discriminant<").len() - 1).to_equal(1)
        expect(facade.split("extern fn rt_enum_payload<").len() - 1).to_equal(1)
        expect(facade.split("extern fn rt_tuple_get<").len() - 1).to_equal(1)
        expect(facade).to_contain("@inline\nfn compiler_value_discriminant<TEnum>")
        expect(facade).to_contain("@inline\nfn compiler_value_payload<TEnum, TPayload>")
        expect(facade).to_contain("@inline\nfn compiler_value_tuple_at<TElement>")
        expect(facade.contains("pub fn compiler_value_")).to_equal(false)
        expect(allowlist.split("\nsrc/compiler/00.common/value_access.spl\n").len() - 1).to_equal(1)

    it "routes the MIR expression lowering batch through the canonical owner":
        val dispatch = file_read("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        val method_calls = file_read("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")

        expect(dispatch).to_contain("use compiler.common.value_access.{{compiler_value_discriminant, compiler_value_payload, compiler_value_tuple_at}}")
        expect(method_calls).to_contain("use compiler.common.value_access.{{compiler_value_discriminant}}")
        expect_no_direct_runtime_value_access("src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl")
        expect_no_direct_runtime_value_access("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
