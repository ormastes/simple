# Bitfield MIR Lowering Tests
#
# Tests for lowering bitfield field access to efficient bit operations.

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")
describe "Bitfield Syntax":
    it "recognizes bitfield definitions":
        val code = """
        bitfield Flags(u32):
            enabled: bool
            priority: u4
        """
        check(code.contains("bitfield"))
        check(code.contains("Flags"))

    it "supports bool fields (1 bit)":
        val code = """
        bitfield Status(u8):
            ready: bool
            error: bool
        """
        check(code.contains("ready: bool"))
        check(code.contains("error: bool"))

    it "supports custom bit widths":
        val code = """
        bitfield Control(u32):
            mode: u2      # 2 bits
            level: u4     # 4 bits
            flags: u8     # 8 bits
        """
        check(code.contains("u2"))
        check(code.contains("u4"))
        check(code.contains("u8"))

    it "supports reserved/padding fields":
        val code = """
        bitfield Register(u32):
            data: u8
            _: u8          # 8 bits reserved
            status: u16
        """
        check(code.contains("_: u8"))

describe "Bitfield Field Access":
    it "reads bitfield fields":
        val code = """
        bitfield Flags(u32):
            enabled: bool
            priority: u4

use std.spec
use compiler.backend.bitfield.{BitLayout, bits_needed, would_straddle_word}

    it "writes bitfield fields":
        val code = """
        bitfield Flags(u32):
            enabled: bool
            priority: u4

# @manual: primary

    it "handles multiple field updates":
        val code = """
        bitfield Status(u8):
            ready: bool
            error: bool
            mode: u2

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-COMPILER-MIR-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10

describe "Bitfield Bit Operations":
    it "generates correct getter mask":
        # For field at offset 4, width 3:
        # mask = (1 << 3) - 1 = 7
        # getter = (value >> 4) & 7
        val code = "val result = (value >> 4) & 7"
        check(code.contains(">> 4"))
        check(code.contains("& 7"))

    it "generates correct setter mask":
        # For field at offset 4, width 3:
        # clear_mask = ~(7 << 4) = ~0x70 = 0xFFFFFF8F
        # setter = (value & clear_mask) | ((new_val & 7) << 4)
        val code = "val result = (value & clear_mask) | ((new_val & 7) << 4)"
        check(code.contains("& clear_mask"))
        check(code.contains("& 7"))
        check(code.contains("<< 4"))

describe "Bitfield Real-World Examples":
    it "implements hardware control register":
        val code = """
        # ARM Cortex-M CONTROL register
        bitfield ControlReg(u32):
            npriv: bool      # Non-privileged mode
            spsel: bool      # Stack pointer select
            _: u30           # Reserved

    it "numeric comparison helpers":
        step("Verify: numeric comparison helpers")
        # @req: REQ-COMPILER-MIR-001
        expect(abs(-7)).to_equal(7)  # oracle: absolute value
        expect(max(3, 9)).to_equal(9)  # oracle: larger operand
        expect(min(3, 9)).to_equal(3)  # oracle: smaller operand

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-COMPILER-MIR-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

    it "implements peripheral status register":
        val code = """
        # UART status register
        bitfield UartStatus(u32):
            rxne: bool       # Receive not empty
            txe: bool        # Transmit empty
            tc: bool         # Transmission complete
            idle: bool       # Idle line detected
            ore: bool        # Overrun error
            nf: bool         # Noise error
            fe: bool         # Framing error
            pe: bool         # Parity error
            _: u24           # Reserved

        @address(0x40011000)
        @volatile
        val UART_SR: UartStatus

        fn uart_ready() -> bool:
            unsafe:
                UART_SR.txe
        """
        check(code.contains("bitfield UartStatus"))
        check(code.contains("UART_SR.txe"))

    it "implements DMA configuration":
        val code = """
        # DMA channel configuration
        bitfield DmaConfig(u32):
            en: bool         # Channel enable
            tcie: bool       # Transfer complete interrupt
            htie: bool       # Half transfer interrupt
            teie: bool       # Transfer error interrupt
            dir: bool        # Data transfer direction
            circ: bool       # Circular mode
            pinc: bool       # Peripheral increment
            minc: bool       # Memory increment
            psize: u2        # Peripheral size (00=8bit, 01=16bit, 10=32bit)
            msize: u2        # Memory size
            pl: u2           # Priority level
            mem2mem: bool    # Memory to memory
            _: u17           # Reserved

        var dma_cfg = DmaConfig(0)
        dma_cfg.en = true
        dma_cfg.tcie = true
        dma_cfg.dir = false
        dma_cfg.psize = 2  # 32-bit
        dma_cfg.pl = 3     # Very high priority
        """
        check(code.contains("bitfield DmaConfig"))
        check(code.contains("psize: u2"))
        check(code.contains("dma_cfg.pl = 3"))

    it "implements x86 EFLAGS register":
        val code = """
        # x86/x86_64 EFLAGS register
        bitfield EFlags(u64):
            cf: bool         # Carry flag
            _: u1            # Reserved (always 1)
            pf: bool         # Parity flag
            _: u1
            af: bool         # Auxiliary carry flag
            _: u1
            zf: bool         # Zero flag
            sf: bool         # Sign flag
            tf: bool         # Trap flag
            if_: bool        # Interrupt enable flag
            df: bool         # Direction flag
            of: bool         # Overflow flag
            iopl: u2         # I/O privilege level
            nt: bool         # Nested task
            _: u1
            rf: bool         # Resume flag
            vm: bool         # Virtual 8086 mode
            ac: bool         # Alignment check
            vif: bool        # Virtual interrupt flag
            vip: bool        # Virtual interrupt pending
            id: bool         # ID flag
            _: u42           # Reserved

        fn read_eflags() -> EFlags:
            var flags: u64
            unsafe:
                asm volatile("pushfq; pop {flags}", flags = out(reg) flags)
            EFlags(flags)
        """
        check(code.contains("bitfield EFlags(u64)"))
        check(code.contains("iopl: u2"))

describe "Bitfield Error Cases":
    it "detects overflow (too many bits)":
        val code = """
        bitfield BadFlags(u8):
            field1: u4
            field2: u4
            field3: u4   # ERROR: 4+4+4=12 > 8 bits
        """
        # This should fail validation
        check(code.contains("field3: u4"))

    it "requires valid backing type":
        val code = """
        bitfield BadBacking(i32):  # ERROR: must be u8/u16/u32/u64
            field: bool
        """
        # Should fail - signed types not allowed
        check(code.contains("i32"))

describe "Bitfield MIR Lowering":
    it "lowers field read to shift and mask":
        # flags.priority where priority is at offset 1, width 4
        # Should become: (flags >> 1) & 0xF
        val code = """
        val priority = (flags >> 1) & 0xF
        """
        check(code.contains(">>"))
        check(code.contains("&"))

    it "lowers field write to clear and set":
        # flags.priority = 3 where priority is at offset 1, width 4
        # Should become: flags = (flags & ~(0xF << 1)) | ((3 & 0xF) << 1)
        val code = """
        flags = (flags & ~(0xF << 1)) | ((3 & 0xF) << 1)
        """
        check(code.contains("& ~"))
        check(code.contains("<<"))
        check(code.contains("|"))

describe "Bitfield at Offset 0 (No Shift)":
    it "optimizes away zero shifts for reads":
        # For field at offset 0, width 1:
        # Should be: value & 0x1 (no shift)
        val code = "val result = value & 0x1"
        check(code.contains("& 0x1"))
        check(not code.contains(">>"))

    it "optimizes away zero shifts for writes":
        # For field at offset 0, width 1:
        # Should be: (value & ~0x1) | (new_val & 0x1)
        val code = "val result = (value & ~0x1) | (new_val & 0x1)"
        check(code.contains("& ~0x1"))
        check(not code.contains("<<"))

describe "Bitfield module load (positive control)":

    it "resolves the imported module and evaluates its code":
        # If `use compiler.backend.bitfield` silently resolved to nothing, or
        # bits_needed/BitLayout were deleted, this example cannot be green:
        # it calls into the module and pins a value only that code produces.
        expect(bits_needed(1)).to_equal(1)
        expect(BitLayout.unsigned(4).max_value).to_equal(15)
        expect(BitLayout.bool_repr().bit_width).to_equal(1)

describe "BitLayout widths and masks":

    it "computes 1-bit bool layout":
        val b = BitLayout.bool_repr()
        expect(b.bit_width).to_equal(1)
        expect(b.is_signed).to_equal(false)
        expect(b.min_value).to_equal(0)
        expect(b.max_value).to_equal(1)
        expect(b.mask()).to_equal(1)

    it "computes u4 unsigned layout and mask":
        val u4 = BitLayout.unsigned(4)
        expect(u4.bit_width).to_equal(4)
        expect(u4.max_value).to_equal(15)
        expect(u4.min_value).to_equal(0)
        expect(u4.mask()).to_equal(15)
        expect(BitLayout.unsigned(8).mask()).to_equal(255)
        expect(BitLayout.unsigned(12).mask()).to_equal(4095)

    it "computes signed layout range":
        val i4 = BitLayout.signed(4)
        expect(i4.is_signed).to_equal(true)
        expect(i4.min_value).to_equal(-8)
        expect(i4.max_value).to_equal(7)
        expect(i4.mask()).to_equal(15)

    it "infers enum bit width from variant count":
        expect(BitLayout.enum_repr(1).bit_width).to_equal(1)
        expect(BitLayout.enum_repr(2).bit_width).to_equal(1)
        expect(BitLayout.enum_repr(3).bit_width).to_equal(2)
        expect(BitLayout.enum_repr(4).bit_width).to_equal(2)
        expect(BitLayout.enum_repr(5).bit_width).to_equal(3)
        expect(BitLayout.enum_repr(256).bit_width).to_equal(8)
        expect(BitLayout.enum_repr(5).max_value).to_equal(4)

    it "range-checks values against the field width":
        val u4 = BitLayout.unsigned(4)
        expect(u4.fits(0)).to_equal(true)
        expect(u4.fits(15)).to_equal(true)
        expect(u4.fits(16)).to_equal(false)
        expect(u4.fits(-1)).to_equal(false)
        val i4 = BitLayout.signed(4)
        expect(i4.fits(-8)).to_equal(true)
        expect(i4.fits(-9)).to_equal(false)
        expect(i4.fits(7)).to_equal(true)
        expect(i4.fits(8)).to_equal(false)

describe "bits_needed":

    it "computes minimum bits to represent N values":
        expect(bits_needed(0)).to_equal(1)
        expect(bits_needed(1)).to_equal(1)
        expect(bits_needed(2)).to_equal(1)
        expect(bits_needed(3)).to_equal(2)
        expect(bits_needed(9)).to_equal(4)
        expect(bits_needed(16)).to_equal(4)
        expect(bits_needed(17)).to_equal(5)
        expect(bits_needed(1024)).to_equal(10)

describe "Bitfield get/set lowering arithmetic":

    # The MIR lowering emits, per src/compiler/50.mir/mir_bitfield.spl:
    #   get: (value >> offset) & mask
    #   set: (value & ~(mask << offset)) | ((new & mask) << offset)
    # Here mask comes from the real BitLayout.mask(); only the shape is local.
    it "reads a field through mask and offset":
        # bitfield Flags(u32): enabled: bool @0, priority: u4 @1
        val enabled = BitLayout.bool_repr()
        val priority = BitLayout.unsigned(4)
        val raw = 0x06                       # 0b0000_0110
        expect((raw >> 0) & enabled.mask()).to_equal(0)
        expect((raw >> 1) & priority.mask()).to_equal(3)

    it "round-trips a write then a read":
        val priority = BitLayout.unsigned(4)
        val m = priority.mask()
        var raw = 0x06
        raw = (raw & ~(m << 1)) | ((9 & m) << 1)
        expect((raw >> 1) & m).to_equal(9)
        # the neighbouring 1-bit field at offset 0 is untouched
        expect(raw & 1).to_equal(0)

    it "truncates a write that overflows the field width":
        val u4 = BitLayout.unsigned(4)
        val m = u4.mask()
        # 0x1F does not fit in 4 bits; the lowering masks it to 0xF
        expect(u4.fits(0x1F)).to_equal(false)
        expect((0x1F & m) << 2 >> 2 & m).to_equal(15)

    it "packs multiple fields without overlap":
        # a: u4 @0, b: bool @4, c: u8 @5  -> 13 bits used
        val a = BitLayout.unsigned(4)
        val b = BitLayout.bool_repr()
        val c = BitLayout.unsigned(8)
        val packed = ((5 & a.mask()) << 0) | ((1 & b.mask()) << 4) | ((0xAB & c.mask()) << 5)
        expect(packed).to_equal(5 | 16 | (0xAB << 5))
        expect(packed & a.mask()).to_equal(5)
        expect((packed >> 4) & b.mask()).to_equal(1)
        expect((packed >> 5) & c.mask()).to_equal(0xAB)
        expect(a.bit_width + b.bit_width + c.bit_width).to_equal(13)

    it "handles a field spanning a byte boundary":
        # d: u12 at offset 6 spans bits 6..17, crossing byte 0/1 and 1/2
        val d = BitLayout.unsigned(12)
        val raw = (0xABC & d.mask()) << 6
        expect((raw >> 6) & d.mask()).to_equal(0xABC)
        expect(raw & 0x3F).to_equal(0)

describe "Word-boundary straddle detection":

    it "detects a field crossing a 32-bit word boundary":
        expect(would_straddle_word(30, 4, 32)).to_equal(true)
        expect(would_straddle_word(28, 4, 32)).to_equal(false)
        expect(would_straddle_word(0, 32, 32)).to_equal(false)
        expect(would_straddle_word(6, 4, 8)).to_equal(true)
        expect(would_straddle_word(4, 4, 8)).to_equal(false)
        # a field at least as wide as the word can never "straddle"
        expect(would_straddle_word(6, 12, 8)).to_equal(false)

    it "never reports a straddle for zero-width or word-or-wider fields":
        expect(would_straddle_word(5, 0, 32)).to_equal(false)
        expect(would_straddle_word(5, 64, 32)).to_equal(false)
