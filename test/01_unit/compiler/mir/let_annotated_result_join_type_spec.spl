# Bug: mir_let_annotated_result_overwritten_by_join_metadata_2026-11-12
# @cover src/compiler/50.mir/mir_lowering_stmts.spl
#
# `val r: Result<i64, text> = if/match ...` whose typed arm is a
# `Result<u8, text>` call joined with an untyped `Err(..)`: the join type
# `Result<u8, text>` used to overwrite the annotation, so `r.unwrap()` lowered
# with MIR type U8 instead of I64. Let locals are unnamed in MIR, so the probe
# reads the lowering's per-local HIR metadata for the unnamed temporaries of
# `pick`: the annotated binding must carry the declared wrapper type and no
# unnamed integer temporary may be u8 (the only u8 is the named parameter).
use std.spec
use compiler.common.config.Logger
use compiler.common.driver_core_types.driver_core_compile_options_default
use compiler.driver.driver_mir_target.driver_mir_target_context
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_lowering.expressions.*
use compiler.hir.hir_lowering._Expressions.expression_core.*
use compiler.hir.hir_lowering._Expressions.expression_support.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.MirLowering

struct LetResultProbe:
    errors: [text]
    # Unnamed temporaries carrying the probed wrapper type.
    wrapper_locals: i64
    # Unnamed temporaries with integer HIR metadata, by shape.
    u8_temps: i64
    i64_temps: i64
    # Unnamed temporaries whose MIR type is U8 / I64 with int HIR metadata.
    u8_mir_temps: i64

fn let_result_hir_shape(t: HirType) -> text:
    match t.kind:
        case HirTypeKind.Int(bits, signed):
            if signed: "i{bits}" else: "u{bits}"
        case HirTypeKind.Str: "text"
        case HirTypeKind.Result(ok, err): "Result<{let_result_hir_shape(ok)}, {let_result_hir_shape(err)}>"
        case HirTypeKind.Optional(inner): "{let_result_hir_shape(inner)}?"
        case _: "other"

fn let_result_hir_is_int(t: HirType) -> bool:
    match t.kind:
        case HirTypeKind.Int(_, _): true
        case _: false

fn let_result_mir_is_u8(t: MirType) -> bool:
    match t.kind:
        case MirTypeKind.U8: true
        case _: false

fn let_result_probe(source: text, wrapper: text) -> LetResultProbe:
    val parsed = parse_full_frontend(source, "let_result.spl", "let_result", Logger(level: 0))
    var hir_owner = HirLowering.with_filename("let_result.spl")
    val hir = hir_owner.lower_module(parsed)
    var mir_owner = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = mir_owner.lower_module(hir)
    var errors: [text] = []
    for error in hir_owner.errors:
        errors.push("HIR: " + error.message)
    for error in mir_owner.errors:
        errors.push("MIR: " + error.message)
    var wrapper_locals = 0
    var u8_temps = 0
    var i64_temps = 0
    var u8_mir_temps = 0
    for function in mir.functions.values():
        if function.name.ends_with(".pick"):
            for local in function.locals:
                if local.name == None:
                    if val local_hir = mir_owner.find_local_hir_type(local.id.id):
                        val shape = let_result_hir_shape(local_hir)
                        if shape == wrapper:
                            wrapper_locals = wrapper_locals + 1
                        if let_result_hir_is_int(local_hir):
                            if shape == "u8": u8_temps = u8_temps + 1
                            if shape == "i64": i64_temps = i64_temps + 1
                            if let_result_mir_is_u8(local.type_): u8_mir_temps = u8_mir_temps + 1
    LetResultProbe(errors: errors, wrapper_locals: wrapper_locals, u8_temps: u8_temps,
        i64_temps: i64_temps, u8_mir_temps: u8_mir_temps)

fn let_result_expect_declared(probe: LetResultProbe):
    expect(probe.errors).to_equal([])
    expect(probe.wrapper_locals).to_be_greater_than(0)
    expect(probe.u8_temps).to_equal(0)
    expect(probe.u8_mir_temps).to_equal(0)
    expect(probe.i64_temps).to_be_greater_than(0)

val LET_RESULT_MK = "fn mk(x: u8) -> Result<u8, text>:\n    Ok(x)\n"
val LET_RESULT_MKO = "fn mko(x: u8) -> u8?:\n    Some(x)\n"

describe "annotated Let keeps its declared Result type over the join type":
    it "if-join of a Result<u8, text> call and Err(text) under val Result<i64, text>":
        step("Lower the annotated if-join and its unwrap through HIR and MIR")
        val probe = let_result_probe(LET_RESULT_MK + "fn pick(c: bool, x: u8) -> i64:\n    val r: Result<i64, text> = if c: mk(x) else: Err(\"e\")\n    val n = r.unwrap()\n    n + 300\n", "Result<i64, text>")
        let_result_expect_declared(probe)

    it "match-join of a Result<u8, text> call and Err(text) under val Result<i64, text>":
        step("Lower the annotated match-join and its unwrap through HIR and MIR")
        val probe = let_result_probe(LET_RESULT_MK + "fn pick(c: bool, x: u8) -> i64:\n    val r: Result<i64, text> = match c:\n        case true: mk(x)\n        case false: Err(\"e\")\n    val n = r.unwrap()\n    n + 300\n", "Result<i64, text>")
        let_result_expect_declared(probe)

    it "if-join under var Result<i64, text>":
        step("Lower the var-annotated if-join and its unwrap through HIR and MIR")
        val probe = let_result_probe(LET_RESULT_MK + "fn pick(c: bool, x: u8) -> i64:\n    var r: Result<i64, text> = if c: mk(x) else: Err(\"e\")\n    val n = r.unwrap()\n    n + 300\n", "Result<i64, text>")
        let_result_expect_declared(probe)

    it "pins an annotated Optional if-join of a u8? call and nil as i64?":
        step("Already declared before the fix: the nil join does not adopt u8?")
        val probe = let_result_probe(LET_RESULT_MKO + "fn pick(c: bool, x: u8) -> i64:\n    val o: i64? = if c: mko(x) else: nil\n    val n = o.unwrap()\n    n + 300\n", "i64?")
        let_result_expect_declared(probe)

    it "pins the filed literal repro (untyped Ok(u8) arm) as declared":
        step("The untyped-constructor join is withheld under an annotation already")
        val probe = let_result_probe("fn pick(c: bool, x: u8) -> i64:\n    val r: Result<i64, text> = if c: Ok(x + 0u8) else: Err(\"e\")\n    val n = r.unwrap()\n    n + 300\n", "Result<i64, text>")
        expect(probe.errors).to_equal([])
        expect(probe.wrapper_locals).to_be_greater_than(0)
        expect(probe.i64_temps).to_be_greater_than(0)

    it "an unannotated join still adopts the typed arm's Result type":
        step("Negative control: without an annotation the join type is the only evidence")
        val probe = let_result_probe(LET_RESULT_MK + "fn pick(c: bool, x: u8) -> i64:\n    val r = if c: mk(x) else: Err(\"e\")\n    val n = r.unwrap()\n    n + 300\n", "Result<i64, text>")
        expect(probe.errors).to_equal([])
        expect(probe.wrapper_locals).to_equal(0)
        expect(probe.u8_temps).to_be_greater_than(0)
        expect(probe.u8_mir_temps).to_be_greater_than(0)
