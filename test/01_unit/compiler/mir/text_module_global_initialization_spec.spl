use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.MirLowering

fn lower_text_globals(source: text) -> MirModule:
    val path = "text_module_globals.spl"
    val parsed = parse_full_frontend(source, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(parsed)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    mir

describe "text module global initialization":
    it "creates empty runtime handle slots and initializes stored literal text once":
        val mir = lower_text_globals("pub val EXPORTED: text = \"public\"\nvar MUTABLE: text = \"\"\nvar INFERRED = \"inferred\"\nval PRIVATE: text = \"inline\"\nfn main() -> i64:\n    0\n")
        var text_slots = 0
        var private_slots = 0
        var symbols: [i64] = []
        for static_ in mir.statics.values():
            if static_.name.ends_with("PRIVATE"):
                private_slots = private_slots + 1
            if static_.name.ends_with("EXPORTED") or static_.name.ends_with("MUTABLE") or static_.name.ends_with("INFERRED"):
                text_slots = text_slots + 1
                expect(static_.init.?).to_equal(false)
                expect(static_.type_.kind).to_equal(MirTypeKind.Opaque("str"))
                symbols = symbols.push(static_.symbol.id)
        expect(text_slots).to_equal(3)
        expect(private_slots).to_equal(0)
        for symbol in symbols:
            var stores = 0
            for function in mir.functions.values():
                if function.name.starts_with("__module_init_") and function.name.ends_with("_dynamic"):
                    for block in function.blocks:
                        for instruction in block.instructions:
                            match instruction.kind:
                                case MirInstKind.StoreGlobal(target, _):
                                    if target.id == symbol:
                                        stores = stores + 1
                                case _: ()
            expect(stores).to_equal(1)

    it "keeps a private immutable plain literal out of runtime initialization":
        val mir = lower_text_globals("val PRIVATE = \"inline\"\nfn main() -> i64:\n    PRIVATE.len()\n")
        expect(mir.statics.len()).to_equal(0)
        var dynamic_initializers = 0
        for function in mir.functions.values():
            if function.name.starts_with("__module_init_") and function.name.ends_with("_dynamic"):
                dynamic_initializers = dynamic_initializers + 1
        expect(dynamic_initializers).to_equal(0)
