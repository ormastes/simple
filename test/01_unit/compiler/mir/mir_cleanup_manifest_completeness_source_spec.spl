use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn cleanup_completeness_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "MIR cleanup manifest completeness wiring":
    it "requires one manifest for every current unwind LandingPad":
        val source = cleanup_completeness_source(
            "src/compiler/50.mir/mir_exception_cfg.spl")
        expect(source).to_contain("for unwind_id in unwind_targets.keys():")
        expect(source).to_contain("if not manifest_entries.has(unwind_id):")
        expect(source).to_contain(
            "facet cleanup landing pad has no manifest")

    it "wires definition and dominance proofs for owner lease and presence locals":
        val source = cleanup_completeness_source(
            "src/compiler/50.mir/mir_exception_cfg.spl")
        expect(source).to_contain("exception_definition_count(body, entry.owner)")
        expect(source).to_contain("exception_definition_count(body, entry.lease)")
        expect(source).to_contain("exception_definition_count(body, present)")
        expect(source).to_contain(
            "exception_owner_has_canonical_bitcast(body, entry.owner)")
        expect(source).to_contain(
            "exception_definition_dominates_unwind_calls(\n                body, entry.owner")
        expect(source).to_contain(
            "exception_definition_dominates_unwind_calls(\n                body, entry.lease")
        expect(source).to_contain(
            "exception_definition_dominates_unwind_calls(\n                body, present")

    it "counts every current destination family and roots dominance explicitly":
        val source = cleanup_completeness_source(
            "src/compiler/50.mir/mir_exception_cfg.spl")
        expect(source).to_contain("case LoadGlobal(dest, _): dest.id")
        expect(source).to_contain("case SimdAddF32x4(dest, _, _)")
        expect(source).to_contain("case MirSimdSplat(dest, _, _)")
        expect(source).to_contain("case MirWarpShfl(dest, _, _, _, _)")
        expect(source).to_contain(
            "exception_inst_definition_count_for_local")
        expect(source).to_contain("case Out | LateOut | InOut:")
        expect(source).to_contain(
            "var worklist: [i64] = [body.entry_block.id]")

        val owner = cleanup_completeness_source(
            "src/compiler/50.mir/mir_instruction_graph.spl")
        expect(owner).to_contain("entry_block: BlockId")
        expect(owner).to_contain("entry_block: func.entry_block")

    it "routes module passes through universal manifested-function isolation":
        val source = cleanup_completeness_source(
            "src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(source).to_contain(
            "var result_module = mir_opt_unmanifested_function_slice(module)")
        expect(source).to_contain(
            "mir_opt_reinsert_manifested_functions(original_module, result_module)")
        expect(source).to_contain(
            "optimized_module.functions[symbol] = original")

    it "guards exported raw optimizer transform boundaries":
        for path in [
            "src/compiler/60.mir_opt/mir_opt/dce.spl",
            "src/compiler/60.mir_opt/mir_opt/copy_prop.spl",
            "src/compiler/60.mir_opt/mir_opt/cse.spl",
            "src/compiler/60.mir_opt/mir_opt/predicate_promote.spl",
            "src/compiler/60.mir_opt/mir_opt/pattern/pattern_rule_pass.spl"]:
            expect(cleanup_completeness_source(path)).to_contain(
                "if func.exception_cleanup_contracts.len() > 0:")
        val module_source = cleanup_completeness_source(
            "src/compiler/60.mir_opt/mir_opt/mod.spl")
        expect(module_source).to_contain(
            "if result.functions[sym].exception_cleanup_contracts.len() > 0:")
