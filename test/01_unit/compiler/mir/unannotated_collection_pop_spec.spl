"""Unannotated array-literal receivers must pop the same as annotated ones.

Prevention for mir_unannotated_collection_element_type_lost_2026_10_20. Pins
both forms (text and i64 elements, 1 and 2 element literals) so the
coordinator.spl annotation workaround can be retired once a producer builds the
unannotated form natively (fixture: test/fixtures/compiler/unannotated_collection_pop).
"""
# @req REQ-MIR-COLLECTION-ELEM
# @cover src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl

use std.spec

fn pop_text_unannotated(x: text) -> text:
    var pending = [x]
    val got = pending.pop()
    if got.?:
        return got.unwrap()
    ""

fn pop_text_annotated(x: text) -> text:
    var pending: [text] = [x]
    val got = pending.pop()
    if got.?:
        return got.unwrap()
    ""

fn pop_int_unannotated(a: i64, b: i64) -> i64:
    var pending = [a, b]
    val got = pending.pop()
    if got.?:
        return got.unwrap()
    -1

describe "unannotated collection element type":
    it "pops a single-element text literal like the annotated form":
        expect(pop_text_unannotated("a")).to_equal("a")
        expect(pop_text_annotated("a")).to_equal("a")

    it "pops the last element of an i64 literal":
        expect(pop_int_unannotated(1, 2)).to_equal(2)

    it "drains to empty":
        var pending = ["x"]
        pending.pop()
        expect(pending.len()).to_equal(0)
