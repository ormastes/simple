"""Unannotated array-literal receivers must pop like annotated ones.

Prevention for mir_unannotated_collection_element_type_lost_2026_10_20. Native
fixture: test/fixtures/compiler/unannotated_collection_pop/main.spl. Lets the
coordinator.spl annotation workaround be retired once a producer builds the
unannotated form natively.
"""
# @req REQ-MIR-COLLECTION-ELEM
# @cover src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl

use std.spec

fn pop_text(x: text) -> text:
    var pending = [x]
    pending.pop() ?? ""

fn pop_int(a: i64, b: i64) -> i64:
    var pending = [a, b]
    pending.pop() ?? -1

fn drain_count(x: text) -> i64:
    var pending = [x]
    var visited = 0
    while pending.len() > 0:
        val cur = pending[pending.len() - 1]
        pending.pop()
        visited = visited + 1
    visited

describe "unannotated collection element type":
    it "pops a single-element text literal":
        expect(pop_text("a")).to_equal("a")

    it "pops the last element of an i64 literal":
        expect(pop_int(1, 2)).to_equal(2)

    it "drains a worklist like coordinator.spl":
        expect(drain_count("z")).to_equal(1)
