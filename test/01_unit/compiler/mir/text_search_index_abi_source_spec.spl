# Source contract complements the native fixture; it is not native evidence.
use std.io.file_read
use std.spec

describe "text search raw index ABI":
    it "decodes tagged index operands by producer provenance":
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
        val begin = source.index_of("    me lower_text_index_operand(")
        val finish = source.index_of("    fn array_slice_bound_is_integer(")
        expect(begin).to_be_greater_than(-1)
        expect(finish).to_be_greater_than(begin)
        val helper = source.substring(begin, finish)
        expect(helper).to_contain("self.is_runtime_value_local(lowered.id)")
        expect(helper).to_contain("self.decode_runtime_value(lowered, MirType.i64())")
        expect(helper.contains("lowered ??")).to_equal(false)
        expect(source).to_contain("val tf_start = self.lower_text_index_operand(args[1].value)")
        expect(source).to_contain("val sub_arg_local = self.lower_text_index_operand(arg.value)")
        expect(source).to_contain("val arg_local = self.lower_text_index_operand(arg.value)")
        expect(source).to_contain("self.remember_local_hir_type(tf_local.id, HirType(kind: HirTypeKind.Int(64, true)")

    it "keeps range bounds on the same raw index owner":
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/text_index_ranges.spl")
        expect(source).to_contain("start_local = self.lower_text_index_operand(start_expr)")
        expect(source).to_contain("end_local = self.lower_text_index_operand(end_expr)")
