# Run-path mirror of test/01_unit/compiler/typed_array_variable_binding_spec.spl
#
# The spec is GREEN under `bin/simple test` (tree-walk interpreter) but the
# typed-array copy defect reproduces under `bin/simple run`. The spec therefore
# does not bite today; THIS probe is the biting evidence. Keep both.
#
#   bin/simple run test/01_unit/compiler/probe_typed_array_variable_binding.spl
#
# Bug: doc/08_tracking/bug/typed_array_variable_binding_zeroes_elements_2026-08-17.md

fn source() -> [u64]:
    [5u64, 6u64]

fn check(label: text, got: i64, want: i64) -> i64:
    if got == want:
        print("PASS {label}: got {got}")
        return 0
    print("FAIL {label}: got {got} want {want}")
    1

fn main():
    var fails = 0

    val from_call = source()
    fails = fails + check("val<-call", from_call[0].to_i64(), 5)

    val val_to_val = from_call
    fails = fails + check("val<-val", val_to_val[0].to_i64(), 5)

    var val_to_var = from_call
    fails = fails + check("var<-val", val_to_var[0].to_i64(), 5)

    var src2 = source()
    var var_to_var = src2
    fails = fails + check("var<-var", var_to_var[0].to_i64(), 5)

    val literal: [u64] = [3u64, 4u64]
    val literal_copy = literal
    fails = fails + check("val<-literal", literal_copy[0].to_i64(), 3)

    # length survives the defect, so it is the assertion that would MISS it
    fails = fails + check("length-preserved", val_to_val.length(), 2)

    # the ordinary swap idiom
    var first = source()
    var second: [u64] = [9u64, 8u64]
    val carried = first
    first = second
    second = carried
    fails = fails + check("swap-carries-value", second[0].to_i64(), 5)

    if fails == 0:
        print("TYPED_ARRAY_BINDING PROBE: ALL PASS")
    else:
        print("TYPED_ARRAY_BINDING PROBE: {fails} FAILED")
