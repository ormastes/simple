# Regression pin: the f32 SIMD entry points rejected their own element type.
#
# `require_f64_field` accepted Value::Float and Value::Int but not
# Value::Float32, so rt_simd_add/sub/mul_f32x4 and rt_simd_fma_f32x8 all
# failed with "field x must be a float, got Float32(1.0)" -- while the
# runtime's own Value::matches_type("float") returns TRUE for Float32.
# One extractor, six specs.

use std.simd

describe "f32 SIMD accepts Float32 elements":
    it "adds four f32 lanes":
        val a = Vec4f { x: 1.0f32, y: 2.0f32, z: 3.0f32, w: 4.0f32 }
        val b = Vec4f { x: 10.0f32, y: 20.0f32, z: 30.0f32, w: 40.0f32 }
        val r = simd_add_f32x4(a, b)
        expect r.x == 11.0f32
        expect r.w == 44.0f32

    it "multiplies four f32 lanes":
        val a = Vec4f { x: 2.0f32, y: 3.0f32, z: 4.0f32, w: 5.0f32 }
        val b = Vec4f { x: 2.0f32, y: 2.0f32, z: 2.0f32, w: 2.0f32 }
        val r = simd_mul_f32x4(a, b)
        expect r.x == 4.0f32
        expect r.w == 10.0f32
