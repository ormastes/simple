# @req REQ-SSPEC-COMPILER
"""
Purpose: pin the struct-key lookup shapes compiler code relies on.

Native struct values are headerless word blocks (aggregate_intrinsics.spl
Struct case), so neither runtime can hash them by value: a struct-keyed Dict
is identity-keyed under JIT/native codegen. Binding a struct to a typed local
(`val k: Sid = keys[i]`, `val k: Sid = h.sym`, `val k: Sid = item[1]`)
copies it (maybe_copy_struct_value), and a lookup with the copy misses.
doc/08_tracking/bug/dict_struct_key_identity_keyed_copied_key_misses_2026-09-13.md

Compiler sites therefore look a struct key up with the stored element itself
(array element, field read, tuple element). Those three shapes must hit in
every lane; these examples pin them. The copied-local miss is lane-dependent
(the interpreter compares structurally) and is deliberately not asserted.
"""

# @tag: unit, compiler, runtime, dict

use std.spec

struct Sid:
    id: i64

struct Holder:
    sym: Sid
    name: text

describe "struct dict key lookup shapes":
    it "hits with the keys() element read in place":
        var d: Dict<Sid, i64> = {}
        d[Sid(id: 7)] = 70
        d[Sid(id: 9)] = 90
        val keys: [Sid] = d.keys()
        var hits = 0
        var total = 0
        var i = 0
        while i < keys.len():
            if d.contains_key(keys[i]):
                hits = hits + 1
            total = total + d[keys[i]]
            i = i + 1
        expect(hits).to_equal(2)
        expect(total).to_equal(160)

    it "hits with a struct field read in place":
        val a = Sid(id: 3)
        var holders: [Holder] = []
        holders.push(Holder(sym: a, name: "a"))
        var d: Dict<Sid, text> = {}
        d[holders[0].sym] = "A"
        expect(d.contains_key(holders[0].sym)).to_equal(true)
        expect(d[holders[0].sym]).to_equal("A")

    it "hits with a dict-iteration tuple element read in place":
        val a = Sid(id: 5)
        val by_name: Dict<text, Sid> = {"x": a}
        var d: Dict<Sid, i64> = {}
        d[a] = 1
        var hits = 0
        for item in by_name:
            if d.contains_key(item[1]):
                hits = hits + d[item[1]]
        expect(hits).to_equal(1)
