"""
# `resource` invariant 3 -- borrow pinning across foreign calls

**WP:** WP-G (`doc/03_plan/language/resource/resource_parallel_agent_plan_2026-08-06.md`).
**Architecture:** `doc/04_architecture/language/resource/resource_declaration_architecture_2026-08-06.md`
§8, invariant 3: "a borrowed resource stays live through the entire foreign
call, including blocking calls."

Verifies:
- `BorrowChecker` rejects `Drop(l0)` when borrowed reference `l1` flows to a `MirCallOrigin.Foreign` call.
- `BorrowGraph.record_move` rejects moving/dropping a place that has an active borrow at the same point.
- NLL permits `Ref(l0)` followed by `Drop(l0)` when the borrow has no remaining use.
"""

use std.spec
use compiler.borrow.borrow_check.*
use compiler.borrow.borrow_check.borrow_graph.{BorrowGraph, BorrowKind, Place}
use compiler.borrow.borrow_check.mod.{BorrowChecker}
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_support.{MirCallOrigin, MirSignature}
use compiler.mir.mir_types.{MirTypeKind, MirConstValue}

fn mk_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn mk_body(insts: [MirInst]) -> MirBody:
    val block = MirBlock(
        id: BlockId.new(0),
        label: nil,
        instructions: insts,
        terminator: MirTerminator.Ret(nil)
    )
    MirBody(
        name: "resource_borrow_pinning_spec_fn",
        blocks: [block],
        locals: [],
        arg_count: 0,
        return_ty: MirType.i64()
    )

fn mk_foreign_callee() -> MirOperand:
    val signature = MirSignature(params: [MirType.i64()], return_type: MirType.unit(), is_variadic: false, params_known: true)
    MirOperand(
        kind: MirOperandKind.Const(MirConstValue.Str("foreign_sink"), MirType(kind: MirTypeKind.FuncPtr(signature))),
        call_origin: MirCallOrigin.Foreign
    )

fn checker_messages(checker: BorrowChecker) -> text:
    var msgs: [text] = []
    for err in checker.errors:
        msgs = msgs.push(err.message)
    msgs.join("\n")

describe "invariant 3 (resource borrow pinning): dropping a resource while a foreign call or live loan holds a borrow is rejected":
    it "rejects Drop(l0) when a borrowed reference l1 is later passed to a foreign call":
        val l0 = LocalId(id: 0)
        val l1 = LocalId(id: 1)
        val place = MirPlace(local: l0, projection: [])
        val insts = [
            mk_inst(MirInstKind.Ref(l1, MirBorrowKind.Shared, place)),
            mk_inst(MirInstKind.Drop(l0)),
            mk_inst(MirInstKind.Call(nil, mk_foreign_callee(), [MirOperand.copy(l1)]))
        ]
        var checker = BorrowChecker.create()
        checker.check_function(mk_body(insts))
        val combined = checker_messages(checker)
        expect(checker.errors.len()).to_be_greater_than(0)
        expect(combined).to_contain("because it is borrowed")
        expect(combined).to_contain("short borrow escapes")

    it "rejects BorrowGraph.record_move when an active borrow exists at the point":
        var graph = BorrowGraph.create()
        val place = Place.local(0)
        val _b = graph.record_borrow(1, place, BorrowKind.Shared)
        graph.record_move(1, place)
        expect(graph.errors.len()).to_be_greater_than(0)
        expect(graph.errors[0].message).to_contain("Cannot consume borrowed value")

    it "permits Ref(l0) followed by Drop(l0) when NLL proves the borrow is never used":
        val l0 = LocalId(id: 0)
        val place = MirPlace(local: l0, projection: [])
        val insts = [
            mk_inst(MirInstKind.Ref(LocalId(id: 1), MirBorrowKind.Shared, place)),
            mk_inst(MirInstKind.Drop(l0))
        ]
        var checker = BorrowChecker.create()
        checker.check_function(mk_body(insts))
        expect(checker.errors.len()).to_equal(0)
