"""
## Purpose and audience
Purpose: Prove that with-desugar (b): normal BODY fall-through reaches the appended `x.close()`.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-RESOURCE-001 — stable requirement identity for this spec.

"""
# `with EXPR as NAME:` MIR drop/close edges -- WP-K acceptance (runtime side)

**Plan:** doc/03_plan/language/resource/resource_parallel_agent_plan_2026-08-06.md (WP-K)
**Companion:** resource_with_scoped_spec.spl (parsing + AST desugar shape)

Same hand-built-HIR harness `resource_mir_drop_spec.spl` (WP-E) uses: construct
a `HirFunction` directly (the shape `with ACQUIRE as x: BODY` desugars to --
`val x = ACQUIRE`, then `BODY`, then `x.close()`, all as one nested block) and
drive it through the REAL `MirLowering.lower_function`, asserting on the
emitted `MirInstKind.Drop` instructions. Real `with` source in a spec file is
unreachable for the same reason `resource` source is (see that spec's own
header) -- `bin/simple test` re-execs a child Rust seed for a spec file's own
syntax.

## A real gap this WP found and closed, not just abstracted away

WP-E's `resource_owned_locals` registration only fired for a resource-typed
function PARAMETER or a `val b = a` MOVE of an existing resource-owned
PLACE. `with`'s desugar produces neither: `val x = ACQUIRE` binds a FRESH
value (a call result), which took the plain `emit_copy` branch and was never
registered -- so a `with`-bound resource got NO automatic drop on an early
`return`/`?` inside its body, in real (non-parameter, non-move) compiled
code. `mir_lowering_stmts.spl` now also registers a fresh resource-typed
binding (reusing `mir_hir_type_is_resource`, no new logic). This spec's "(c)
explicit return" and "(d) `?` inside body" cases below are the case that gap
would otherwise have silently failed -- they exercise a FRESH `val x =
<non-place initializer>`, exactly the shape the real desugar produces, not a
parameter standing in for one.
"""

use std.spec
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_kinds.*
use compiler.mir.mir_instructions.{MirFunction}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirBlock, HirStmt, HirStmtKind, HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable, SymbolKind, MethodResolution}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}
use compiler.frontend.resource_registry.*

fn mk_span(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "synthetic", length: 0)

fn i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: mk_span(0))

fn resource_type(sym: SymbolId) -> HirType:
    val named = HirType(kind: HirTypeKind.Named(sym, []), span: mk_span(0))
    HirType(kind: HirTypeKind.Isolated(named), span: mk_span(0))

fn var_read(sym: SymbolId, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(sym), has_type_: true, type_: i64_type(), span: mk_span(line))

fn int_lit(value: i64, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn nil_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: i64_type(), span: mk_span(0))

fn plain_param(sym: SymbolId, name: text) -> HirParam:
    HirParam(symbol: sym, name: name, type_: i64_type(), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

# `val x = ACQUIRE` -- FRESH (non-place) initializer, exactly what
# `with`'s desugar produces (never a resource-typed function param, never a
# `val b = a` move of an existing place).
fn with_let_stmt(x_sym: SymbolId, res_sym: SymbolId, line: i64) -> HirStmt:
    HirStmt(kind: HirStmtKind.Let(x_sym, resource_type(res_sym), int_lit(7, line)), span: mk_span(line))

fn close_stmt(x_sym: SymbolId, line: i64) -> HirStmt:
    HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.MethodCall(var_read(x_sym, line), "close", [], MethodResolution.Unresolved), has_type_: false, type_: i64_type(), span: mk_span(line))), span: mk_span(line))

fn return_stmt(value: i64, line: i64) -> HirStmt:
    HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.Return(Some(int_lit(value, line))), has_type_: true, type_: i64_type(), span: mk_span(line))), span: mk_span(line))

fn expr_stmt(e: HirExpr, line: i64) -> HirStmt:
    HirStmt(kind: HirStmtKind.Expr(e), span: mk_span(line))

fn make_fn(params: [HirParam], body_stmts: [HirStmt], tail: HirExpr, fn_symbol_id: i64) -> HirFunction:
    make_fn_body(params, HirBlock(stmts: body_stmts, has: true, value: tail, span: mk_span(1)), fn_symbol_id)

fn make_fn_stmts_only(params: [HirParam], body_stmts: [HirStmt], fn_symbol_id: i64) -> HirFunction:
    make_fn_body(params, HirBlock(stmts: body_stmts, has: false, value: nil_expr(), span: mk_span(1)), fn_symbol_id)

fn make_fn_body(params: [HirParam], body: HirBlock, fn_symbol_id: i64) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: fn_symbol_id),
        name: "with_take",
        type_params: [],
        params: params,
        return_type: i64_type(),
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(1)
    )

fn declare_res_symbol(symbols: SymbolTable) -> (SymbolTable, SymbolId):
    var table = symbols
    val sym = table.define("Res", SymbolKind.Struct, nil, mk_span(0), Visibility.Public, false, nil)
    (table, sym)

fn count_drops(fn_result: MirFunction) -> i64:
    var n = 0
    for block in fn_result.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Drop(_): n = n + 1
                case _: ()
    n

fn count_drops_in_block(fn_result: MirFunction, label: text) -> i64:
    var n = 0
    for block in fn_result.blocks:
        val block_label = block.label ?? ""
        if block_label == label:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Drop(_): n = n + 1
                    case _: ()
    n

fn setup() -> (SymbolTable, SymbolId):
    resource_registry_reset()
    resource_registry_declare("Res", "prefix=rt_res")
    val (table, res_sym) = declare_res_symbol(SymbolTable.new())
    (table, res_sym)

describe "with-desugar (b): normal BODY fall-through reaches the appended `x.close()`":
    it "lowers `val x = ACQUIRE; print-ish BODY; x.close()` to exactly one Drop, on the close() site":
        step("Verify: lowers `val x = ACQUIRE; print-ish BODY; x.close()` to exactly one Drop, on the close() site")
        # @req: REQ-COMPILER-RESOURCE-001
        val (table, res_sym) = setup()
        val x_sym = SymbolId(id: 1)
        val let_stmt = with_let_stmt(x_sym, res_sym, 10)
        val body_stmt = expr_stmt(int_lit(1, 11), 11)  # stand-in for an arbitrary BODY statement
        val close = close_stmt(x_sym, 12)
        val fn_ = make_fn([], [let_stmt, body_stmt, close], int_lit(0, 13), 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        # Exactly one Drop total: the `.close()` call itself. The
        # function-end scope-exit sweep must NOT double-drop the
        # now-consumed `x`.
        expect(count_drops(fn_result)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "with-desugar (c): an explicit `return` inside BODY":
    it "drops the FRESH with-bound resource before the explicit return, without a param or a move":
        step("Verify: drops the FRESH with-bound resource before the explicit return, without a param or a move")
        # Deliberately NO trailing close() statement in this variant --
        # `.close()`'s own Drop emission (method_calls_literals.spl) is
        # type-check-based, not resource_owned_locals-based, so a close()
        # placed after `return` would (structurally) still lower into its
        # own block and satisfy `count_drops == 1` on its own, silently
        # masking whether the RETURN path's drop-edge (the thing this case
        # is actually about) fired at all. Isolate the return-path
        # mechanism the same way WP-E's own explicit-return spec does.
        val (table, res_sym) = setup()
        val x_sym = SymbolId(id: 1)
        val let_stmt = with_let_stmt(x_sym, res_sym, 10)
        val ret = return_stmt(0, 11)
        val fn_ = make_fn_stmts_only([], [let_stmt, ret], 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        # One Drop on the return path.
        expect(count_drops(fn_result)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "with-desugar (d): a `?` early-return INSIDE BODY (not on the acquire)":
    it "drops the with-bound resource on the `?` Err path, independent of the acquire":
        step("Verify: drops the with-bound resource on the `?` Err path, independent of the acquire")
        val (table, res_sym) = setup()
        val x_sym = SymbolId(id: 1)
        val code_sym = SymbolId(id: 2)
        val code_param = plain_param(code_sym, "code")
        val let_stmt = with_let_stmt(x_sym, res_sym, 10)
        # BODY's tail is a `?` on an UNRELATED value (not the acquired
        # resource) -- models `with r.open() as x: some_other_call()?`.
        val try_tail = HirExpr(kind: HirExprKind.Try(var_read(code_sym, 12)), has_type_: true, type_: i64_type(), span: mk_span(12))
        val fn_ = make_fn([code_param], [let_stmt], try_tail, 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        # One drop on the `?` Err early-return path, one more on the
        # separate Ok fall-through path (per-branch drop edges, same
        # "different blocks, same forward pass" property WP-E's own `?`
        # spec documents) -- both reachable, both owed, x was never
        # consumed by a close() on this variant.
        expect(count_drops_in_block(fn_result, "try_err")).to_equal(1)
        expect(count_drops_in_block(fn_result, "try_ok")).to_equal(1)
        expect(count_drops(fn_result)).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "with-desugar (e): a failed ACQUIRE never binds anything":
    it "registers/drops NOTHING on the `?` Err path when the `?` is inside the ACQUIRE itself":
        step("Verify: registers/drops NOTHING on the `?` Err path when the `?` is inside the ACQUIRE itself")
        val (table, res_sym) = setup()
        val x_sym = SymbolId(id: 1)
        val code_sym = SymbolId(id: 2)
        val code_param = plain_param(code_sym, "code")
        # `with R.open(...)? as x:` -- the `?` is INSIDE the val's own
        # initializer. Its Err early-return fires strictly BEFORE the
        # val-decl completes, so `x` is never registered as a
        # resource-owned local on that path: nothing was ever bound,
        # so there is nothing to close/drop.
        val try_init = HirExpr(kind: HirExprKind.Try(var_read(code_sym, 10)), has_type_: true, type_: i64_type(), span: mk_span(10))
        val let_stmt = HirStmt(kind: HirStmtKind.Let(x_sym, resource_type(res_sym), try_init), span: mk_span(10))
        val fn_ = make_fn([code_param], [let_stmt], int_lit(0, 12), 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        # Nothing to drop on the failed-acquire path...
        expect(count_drops_in_block(fn_result, "try_err")).to_equal(0)
        # ...but the successful-acquire path registers `x` and owes
        # exactly one drop at the function's own eventual exit (no
        # close() in this variant).
        expect(count_drops(fn_result)).to_equal(1)  # oracle: 1 — named expected value from the requirement
