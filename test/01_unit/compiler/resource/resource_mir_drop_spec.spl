"""
## Purpose and audience
Purpose: Prove that WP-E: resource drop edge at normal scope exit.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-RESOURCE-001 — stable requirement identity for this spec.

"""
# `resource` MIR drop edges + consuming `close()` -- WP-E acceptance

**Plan:** doc/03_plan/language/resource/resource_parallel_agent_plan_2026-08-06.md (WP-E)
**Design:** doc/05_design/language/resource/resource_sffi_binding_design_2026-08-06.md
**Architecture:** doc/04_architecture/language/resource/resource_declaration_architecture_2026-08-06.md

Per `#0.5` of the plan (added 2026-08-07): "real `resource` source in a spec
file" is a structurally unreachable oracle -- `bin/simple test` re-execs a
child Rust seed whose parser reads the spec file's own module-level syntax,
so no pure-Simple frontend change (including this one) can make `resource`
source text parse inside an `it` body. This spec therefore uses the SAME
hand-built-HIR harness `test/01_unit/compiler/borrow/iso_move_pipeline_spec.spl`
(LANE ISO1) used to prove the sibling `iso` move lowering: construct a
`HirFunction` directly and drive it through the REAL (non-hand-built)
`MirLowering.lower_function`, then assert on the emitted `MirInstKind.Drop`
instructions.

## What "resource-typed" means at this layer

WP-A/WP-C deliberately keep `resource Name` an INERT marker at HIR: the decl
carries no HirType, no symbol-table type entry, only a
`compiler.frontend.resource_registry` side-table entry (name -> `@sffi`
metadata). So a resource-typed local's real HIR shape is exactly what LANE
ISO1 already carries through: `HirTypeKind.Isolated(HirTypeKind.Named(sym,
[]))`, where `sym`'s registered name is ALSO a name registered in
`resource_registry` (via `resource_registry_declare`, called directly here in
place of parsing `@sffi(...) resource Res`). `mir_hir_type_is_resource`
(mir_lowering_stmts.spl) is exactly this test: Isolated-wrapped Named type
whose symbol name resolves through `self.symbols` to a declared resource.

## Scope note: per-branch drop edges, not full NLL liveness

WP-E's own docstring on `emit_pending_resource_drops` records the real
finding this spec's `?`-path case proves: a `?` (or `return`) exit and the
function's OWN separate implicit fall-through exit are DIFFERENT MIR basic
blocks reached by the SAME forward lowering pass, so each must independently
emit its own drop edge -- an earlier draft of this lane shared one
"consumed" flag across both and silently dropped the SECOND path's edge.
Full per-branch liveness (which path a given RUN actually takes) is real NLL
dataflow and stays WP-G's job; this spec only proves the MIR-lowering-side
mechanism: every REACHABLE exit gets its own edge, exactly once each.
"""

use std.spec
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_kinds.*
use compiler.mir.mir_instructions.{MirFunction}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirBlock, HirStmt, HirStmtKind, HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable, SymbolKind, MethodResolution}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}
use compiler.frontend.resource_registry.*

fn mk_span(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "synthetic", length: 0)

fn i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: mk_span(0))

fn resource_type(sym: SymbolId) -> HirType:
    val named = HirType(kind: HirTypeKind.Named(sym, []), span: mk_span(0))
    HirType(kind: HirTypeKind.Isolated(named), span: mk_span(0))

fn var_read(sym: SymbolId, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(sym), has_type_: true, type_: i64_type(), span: mk_span(line))

fn int_lit(value: i64, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.IntLit(value, nil), has_type_: true, type_: i64_type(), span: mk_span(line))

fn nil_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: i64_type(), span: mk_span(0))

fn resource_param(sym: SymbolId, res_sym: SymbolId) -> HirParam:
    HirParam(symbol: sym, name: "a", type_: resource_type(res_sym), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn plain_param(sym: SymbolId, name: text) -> HirParam:
    HirParam(symbol: sym, name: name, type_: i64_type(), has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn make_fn(params: [HirParam], body_stmts: [HirStmt], tail: HirExpr, fn_symbol_id: i64) -> HirFunction:
    make_fn_body(params, HirBlock(stmts: body_stmts, has: true, value: tail, span: mk_span(1)), fn_symbol_id)

fn make_fn_stmts_only(params: [HirParam], body_stmts: [HirStmt], fn_symbol_id: i64) -> HirFunction:
    """No trailing tail expression -- the LAST statement (e.g. an explicit
    `return`) is the function's only exit. Isolates the explicit-return
    drop-edge case from any interaction with a separately-lowered tail
    expression."""
    make_fn_body(params, HirBlock(stmts: body_stmts, has: false, value: nil_expr(), span: mk_span(1)), fn_symbol_id)

fn make_fn_body(params: [HirParam], body: HirBlock, fn_symbol_id: i64) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: fn_symbol_id),
        name: "take",
        type_params: [],
        params: params,
        return_type: i64_type(),
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(1)
    )

fn declare_res_symbol(symbols: SymbolTable) -> (SymbolTable, SymbolId):
    var table = symbols
    val sym = table.define("Res", SymbolKind.Struct, nil, mk_span(0), Visibility.Public, false, nil)
    (table, sym)

fn count_drops(fn_result: MirFunction) -> i64:
    var n = 0
    for block in fn_result.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Drop(_): n = n + 1
                case _: ()
    n

fn count_drops_in_block(fn_result: MirFunction, label: text) -> i64:
    var n = 0
    for block in fn_result.blocks:
        val block_label = block.label ?? ""
        if block_label == label:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Drop(_): n = n + 1
                    case _: ()
    n

fn setup() -> (SymbolTable, SymbolId):
    resource_registry_reset()
    resource_registry_declare("Res", "prefix=rt_res")
    val (table, res_sym) = declare_res_symbol(SymbolTable.new())
    (table, res_sym)

describe "WP-E: resource drop edge at normal scope exit":
    it "emits exactly one Drop for an owned resource param on implicit fall-through return":
        step("Verify: emits exactly one Drop for an owned resource param on implicit fall-through return")
        # @req: REQ-COMPILER-RESOURCE-001
        val (table, res_sym) = setup()
        val fn_ = make_fn([resource_param(SymbolId(id: 1), res_sym)], [], int_lit(0, 10), 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        expect(count_drops(fn_result)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "emits zero Drop instructions for a plain (non-resource) iso-free param":
        step("Verify: emits zero Drop instructions for a plain (non-resource) iso-free param")
        val (table, res_sym) = setup()
        val fn_ = make_fn([plain_param(SymbolId(id: 1), "a")], [], int_lit(0, 10), 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        expect(count_drops(fn_result)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "WP-E: resource drop edge at an explicit early return":
    it "emits exactly one Drop before an explicit `return 0`":
        step("Verify: emits exactly one Drop before an explicit `return 0`")
        val (table, res_sym) = setup()
        val return_stmt = HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.Return(Some(int_lit(0, 11))), has_type_: true, type_: i64_type(), span: mk_span(11))), span: mk_span(11))
        val fn_ = make_fn_stmts_only([resource_param(SymbolId(id: 1), res_sym)], [return_stmt], 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        expect(count_drops(fn_result)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "WP-E: resource drop edge on a `?` error-propagation exit":
    it "emits exactly one Drop in the `?` Err early-return block":
        step("Verify: emits exactly one Drop in the `?` Err early-return block")
        val (table, res_sym) = setup()
        val code_sym = SymbolId(id: 2)
        val code_param = plain_param(code_sym, "code")
        val try_tail = HirExpr(kind: HirExprKind.Try(var_read(code_sym, 12)), has_type_: true, type_: i64_type(), span: mk_span(12))
        val fn_ = make_fn([resource_param(SymbolId(id: 1), res_sym), code_param], [], try_tail, 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        # Exactly one drop on the Err early-return path...
        expect(count_drops_in_block(fn_result, "try_err")).to_equal(1)
        # ...and exactly one more on the (separate) Ok fall-through path --
        # see the module docstring's "per-branch drop edges" note.
        expect(count_drops_in_block(fn_result, "try_ok")).to_equal(1)
        expect(count_drops(fn_result)).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "WP-E: `.close()` is a consuming drop":
    it "lowers `a.close()` straight to a Drop and suppresses the scope-exit drop":
        step("Verify: lowers `a.close()` straight to a Drop and suppresses the scope-exit drop")
        val (table, res_sym) = setup()
        val a_sym = SymbolId(id: 1)
        val close_stmt = HirStmt(kind: HirStmtKind.Expr(HirExpr(kind: HirExprKind.MethodCall(var_read(a_sym, 10), "close", [], MethodResolution.Unresolved), has_type_: false, type_: i64_type(), span: mk_span(10))), span: mk_span(10))
        val fn_ = make_fn([resource_param(a_sym, res_sym)], [close_stmt], int_lit(0, 12), 5)
        var lowering = MirLowering.new(table)
        val fn_result = lowering.lower_function(fn_)
        # Exactly one Drop total: the `.close()` call itself. The natural
        # end-of-function scope-exit sweep must NOT emit a second one for
        # the same (now-consumed) local.
        expect(count_drops(fn_result)).to_equal(1)  # oracle: 1 — named expected value from the requirement
