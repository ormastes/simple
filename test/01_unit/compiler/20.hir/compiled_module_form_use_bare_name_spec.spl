# @tag:in-development
# Pure-Simple HIR+MIR is fixed and verified in-process by
# `test/01_unit/compiler/hir/hir_module_form_use_bare_name_spec.spl`; keep
# `@tag:in-development` on this CLI subprocess spec until Phase 4 full-CLI
# `bin/simple` (rather than the Rust bootstrap seed) is promoted to `bin/simple`.
# @req compiled_hir_module_form_use_bare_names_2026-11-19
use std.spec.{describe, it, expect}
use std.io.{env_get, process_run}

describe "Compiled HIR binds bare names from a module-form use":
    """The interpreter resolves `mfu_provider_fn` through `use provider`; the
    compiled (LLVM) path does too once `SIMPLE_BIN` is a Phase 4 pure-Simple
    full-CLI binary built with the HIR sibling-surface fix."""

    it "compiles a call to a function imported only by module-form use":
        val bin = env_get("SIMPLE_BIN") ?? "bin/simple"
        val (_out, err, code) = process_run(bin, ["compile", "--backend", "llvm",
            "test/fixtures/compiled_module_form_use/main.spl",
            "-o", "build/compiled_module_form_use.o"])
        expect(err.contains("undefined identifier: mfu_provider_fn")).to_equal(false)
        expect(code).to_equal(0)
