# @req: REQ-COMP-HIR-CFG-SELECT-001 - CfgSelect survives the HIR codec, target-independently.
"""
## Purpose and audience
Purpose: HirExprKind.CfgSelect encodes/decodes losslessly and its bytes do not depend on
SIMPLE_TARGET_OS. Audience: COMP maintainers.
NOTE: needs a runtime that registers rt_tuple_len (enum_wire.spl); the deployed
bin/simple.exe of 2026-10-25 does not, which fails every hir_module_encode spec
(e.g. driver/hir_module_encode_retained_scope_spec.spl) identically.
"""
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io_runtime.{env_get, env_set}
use test.fixtures.compiler.completeness95.hir_cases_v1.{fixture_hir_module_v1}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.hir.hir_definitions.*

fn first_function(module: HirModule) -> HirFunction:
    val keys = module.functions.keys()
    module.functions[keys[0]]

val CONDS: [text] = ["os = \"linux\"", "os = \"windows\""]

fn module_with_cfg_select() -> HirModule:
    val module = fixture_hir_module_v1(false)
    val keys = module.functions.keys()
    var f = module.functions[keys[0]]
    val base = f.body
    val kind = HirExprKind.CfgSelect(CONDS, [base, base], Some(base))
    val sel = HirExpr(kind: kind, has_type_: false, type_: f.return_type, span: base.span)
    f.body = HirBlock(stmts: [HirStmt(kind: HirStmtKind.Expr(sel), span: base.span)], has: false, value: base.value, span: base.span)
    module.functions[keys[0]] = f
    module

fn first_select(module: HirModule) -> HirExprKind:
    val keys = module.functions.keys()
    val f = module.functions[keys[0]]
    match f.body.stmts[0].kind:
        case HirStmtKind.Expr(e): e.kind
        case _: HirExprKind.Error

fn encode_under_os(os: text) -> text:
    val old = env_get("SIMPLE_TARGET_OS")
    env_set("SIMPLE_TARGET_OS", os)
    val blob = hir_module_encode(module_with_cfg_select())
    env_set("SIMPLE_TARGET_OS", old)
    blob

describe "HIR CfgSelect codec":
    it "round-trips through the HIR codec":
        val blob = hir_module_encode(module_with_cfg_select())
        val decoded = hir_module_decode(blob)
        expect(decoded != nil).to_equal(true)
        expect(hir_module_encode(decoded!)).to_equal(blob)
        match first_select(decoded!):
            case HirExprKind.CfgSelect(conds, arms, else_):
                expect(conds[0]).to_equal(CONDS[0])
                expect(conds[1]).to_equal(CONDS[1])
                expect(arms.len()).to_equal(2)
                expect(else_.?).to_equal(true)
            case _:
                expect("CfgSelect").to_equal("other")

    it "encodes byte-identically under SIMPLE_TARGET_OS=linux and windows":
        expect(encode_under_os("linux")).to_equal(encode_under_os("windows"))

    it "round-trips HirFunction cfg, cfg_group and cfg_arm":
        val module = fixture_hir_module_v1(false)
        val keys = module.functions.keys()
        var f = module.functions[keys[0]]
        f.cfg = ["os=linux", "arch=x86_64"]
        f.cfg_group = 3
        f.cfg_arm = 1
        module.functions[keys[0]] = f
        val blob = hir_module_encode(module)
        val decoded = hir_module_decode(blob)
        expect(decoded != nil).to_equal(true)
        val g = decoded!.functions[keys[0]]
        expect(g.cfg.len()).to_equal(2)
        expect(g.cfg[0]).to_equal("os=linux")
        expect(g.cfg[1]).to_equal("arch=x86_64")
        expect(g.cfg_group).to_equal(3)
        expect(g.cfg_arm).to_equal(1)

    it "mono identity digest differs by cfg, cfg_group and cfg_arm and is stable for equal guards":
        val module = fixture_hir_module_v1(false)
        val base = first_function(module)
        val d0 = mono_complete_function_digest_v1(base)
        expect(d0 != "").to_equal(true)
        expect(mono_complete_function_digest_v1(first_function(module))).to_equal(d0)
        var a = first_function(module)
        a.cfg = ["os=linux"]
        var a2 = first_function(module)
        a2.cfg = ["os=windows"]
        var b = first_function(module)
        b.cfg_group = 1
        var c = first_function(module)
        c.cfg_arm = 0
        val da = mono_complete_function_digest_v1(a)
        expect(da != d0).to_equal(true)
        expect(da != mono_complete_function_digest_v1(a2)).to_equal(true)
        expect(mono_complete_function_digest_v1(b) != d0).to_equal(true)
        expect(mono_complete_function_digest_v1(c) != d0).to_equal(true)
