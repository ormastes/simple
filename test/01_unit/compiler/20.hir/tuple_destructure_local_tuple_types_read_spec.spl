# Static source assertion, sibling of tuple_field_element_type_read_spec (#7170):
# statements.spl tuple-destructure paths (ta_/td_ element types) iterated
# `self.local_tuple_types[...]`, a class-field array-valued Dict bracket read
# that native codegen mis-reads (dict_native_pitfalls.md). They must read via
# `.get(k) ?? []`. Class-wide ratchet:
# scripts/check/check-class-field-dict-bracket-read.shs.
use std.spec

extern fn rt_file_read_text(path: text) -> text?

describe "statements.spl local_tuple_types native-safe reads":
    it "has no bracket read of local_tuple_types in a for loop":
        val src = rt_file_read_text("src/compiler/20.hir/hir_lowering/statements.spl") ?? ""
        expect(src.len() > 0).to_equal(true)
        expect(src.contains("in self.local_tuple_types[")).to_equal(false)
    it "reads both sites via get into annotated locals":
        val src = rt_file_read_text("src/compiler/20.hir/hir_lowering/statements.spl") ?? ""
        expect(src.contains("val ta_found: [HirType] = self.local_tuple_types.get(ta_bs.id) ?? []")).to_equal(true)
        expect(src.contains("val td_found: [HirType] = self.local_tuple_types.get(td_bs.id) ?? []")).to_equal(true)
    it "class-field dict bracket-read ratchet script exists":
        val s = rt_file_read_text("scripts/check/check-class-field-dict-bracket-read.shs") ?? ""
        expect(s).to_contain("class_field_dict_bracket_read_baseline.txt")
