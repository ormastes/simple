| 896 | `v.has_discriminant` | c1 | L896 T / F |
| 932, 934 | `f.has_bits` / `f.is_reserved` | c1 | L932 T / L934 T / L934 F |
| 943 | `idx < fields.len()` | c1 | loop 0 / n |
| 948 | `not is_preserve_order` | c1 | L948 T / F |
| 950 | `i < indices.len()` | c1 | one field (F at entry) / several |
| 952 | `j > 0 and widths[j-1] < widths[j]` | c1, c2 | L952 TT / c1 F / c2 F |
| 967 | `not compactq and w > 0 and w < word_bits` | c1, c2, c3 | L967 TTT / c1 F / c2 F / c3 F |
| 969 | `(bit_offset + w) > word_end` | c1 | L969 T / F |
| 996 | `name == "self" or name == "me"` | c1, c2 | L996 c1 T / c2 T / FF |
| 998 | `not param_.has_type_` | c1 | L998 T / F |

Documented gaps:
- L244 true outcome: `found_symbol` is bound by `if val` on a `SymbolId?`,
  so it is never nil inside that branch.
- L697 c3 (`layout.is_packed`) true: `parse_layout_attrs` sets
  `layout_kind = Packed` whenever it sets `is_packed`, so c1 masks c3.

Harness notes: the flat frontend bridge
(`10.frontend/_FlatAstBridge/module_assembly.spl`) builds every ParserStruct
and ParserClass with `attributes: []`, gives every bitfield field `has_bits`,
and always attaches `@preserve_order` to bitfields. The L697 and L932-L969
examples that need other inputs attach attributes / reset field flags on the
parsed declaration and call `lower_struct` / `lower_bitfield` directly.
`lower_bootstrap_flat_function` has no in-tree caller; it is driven with
`decl_fn` arena declarations.
Bug suspects: struct/class layout decorators (`@repr`, `@align`, `@packed`)
written in source never reach HIR through the flat bridge (see final report).
"""

# @tag:unit
# @tag:compiler
# @tag:hir
# @tag:generics
# @tag:coverage

use std.spec.*
use std.io_runtime.{env_get, env_set}
use compiler.common.config.Logger
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.parse_full_frontend
use compiler.frontend.parser_types.{ParserModule, ParserFunction, Param, Attribute, BitfieldField}
use compiler.frontend.parser_types_expr.{Expr, ExprKind}
use compiler.frontend.core.ast.{decl_fn, decl_is_gpu_kernel_set_at}
use compiler.frontend.core.types.{flat_span_new, TYPE_I64, custom_primitive_register, custom_primitive_bind_symbol, custom_primitive_underlying_type_tag_by_symbol}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_lowering._Items.declaration_lowering.{fn_has_untyped_value_param}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolKind, ScopeKind}
use compiler.hir.hir_definitions.{HirFunction, HirStruct, HirEnum, HirBitfield, HirVariantKind}

fn cov_parse(src: text) -> ParserModule:
    parse_full_frontend(src, "dl_cov.spl", "dl_cov", Logger(level: 0))

fn lower_in(src: text, file: text) -> HirModule:
    var hl = HirLowering.with_filename(file)
    hl.lower_module(cov_parse(src))

fn lower(src: text) -> HirModule:
    lower_in(src, "dl_cov.spl")

fn diags_in(src: text, file: text) -> text:
    var hl = HirLowering.with_filename(file)
    hl.lower_module(cov_parse(src))
    hl.diagnostic_messages.join("\n")

fn diags(src: text) -> text:
    diags_in(src, "dl_cov.spl")

fn func(m: HirModule, name: text) -> HirFunction:
    for f in m.functions.values():
        if f.name == name:
            return f
    fail("missing lowered function " + name)
    nil

fn struct_of(m: HirModule, name: text) -> HirStruct:
    for s in m.structs.values():
        if s.name == name:
            return s
    fail("missing lowered struct " + name)
    nil

fn bitfield_of(m: HirModule, name: text) -> HirBitfield:
    for b in m.bitfields.values():
        if b.name == name:
            return b
    fail("missing lowered bitfield " + name)
    nil

fn kind_name(t: HirType) -> text:
    match t.kind:
        case HirTypeKind.Any: "any"
        case HirTypeKind.Int(_, _): "int"
        case HirTypeKind.Str: "str"
        case HirTypeKind.Named(_, args): "named/{args.len()}"
        case HirTypeKind.Error: "error"
        case HirTypeKind.Unit: "unit"
        case HirTypeKind.Infer(_, _): "infer"
        case _: "other"

fn param_names(f: HirFunction) -> text:
    var names: [text] = []
    for p in f.params:
        names.push(p.name)
    names.join(",")

fn with_env(key: text, value: text) -> text:
    val old = env_get(key)
    env_set(key, value)
    old

fn lower_env(src: text, bootstrap: text, trace: text, diag: text) -> HirModule:
    """Parse with the caller's env, then lower with SIMPLE_BOOTSTRAP /
    SIMPLE_COMPILER_TRACE / SIMPLE_BOOTSTRAP_DIAG set; always restore."""
    val parsed = cov_parse(src)
    val old_b = with_env("SIMPLE_BOOTSTRAP", bootstrap)
    val old_t = with_env("SIMPLE_COMPILER_TRACE", trace)
    val old_d = with_env("SIMPLE_BOOTSTRAP_DIAG", diag)
    var hl = HirLowering.with_filename("dl_env.spl")
    val m = hl.lower_module(parsed)
    env_set("SIMPLE_BOOTSTRAP_DIAG", old_d)
    env_set("SIMPLE_COMPILER_TRACE", old_t)
    env_set("SIMPLE_BOOTSTRAP", old_b)
    m

fn bit_offsets(b: HirBitfield) -> text:
    var parts: [text] = []
    for f in b.fields:
        parts.push("{f.name}@{f.bit_offset}")
    parts.join(",")

fn attr_str(name: text, arg: text) -> Attribute:
    Attribute(name: name, args: [Expr(kind: ExprKind.StringLit(arg, None), span: Span.empty())], span: Span.empty())

fn attr_int(name: text, arg: i64) -> Attribute:
    Attribute(name: name, args: [Expr(kind: ExprKind.IntLit(arg), span: Span.empty())], span: Span.empty())

fn plain_attr(name: text) -> Attribute:
    Attribute(name: name, args: [], span: Span.empty())

fn struct_with_attrs(attrs: [Attribute]) -> HirStruct:
    val pm = cov_parse("struct Host:\n    v: i64\n")
    var st = pm.structs["Host"]
    st.attributes = attrs
    var hl = HirLowering.with_filename("dl_attrs.spl")
    hl.lower_struct(st)

fn bf_direct(src: text, name: text, attrs: [Attribute], has_bits: [bool], reserved: [bool]) -> HirBitfield:
    """Lower a parsed bitfield directly after replacing its attributes and
    each field's has_bits / is_reserved flags (fields beyond the flag list
    are dropped)."""
    val pm = cov_parse(src)
    var bf = pm.bitfields[name]
    var fs: [BitfieldField] = []
    var i = 0
    while i < has_bits.len():
        var fld = bf.fields[i]
        fld.has_bits = has_bits[i]
        fld.is_reserved = reserved[i]
        fs.push(fld)
        i = i + 1
    bf.fields = fs
    bf.attributes = attrs
    var hl = HirLowering.with_filename("dl_bf.spl")
    hl.lower_bitfield(bf)

fn direct_fn(src: text, name: text) -> ParserFunction:
    val pm = cov_parse(src)
    pm.functions[name]

fn method_direct(src: text, name: text) -> HirFunction:
    """Lower a parsed top-level fn as a nonstatic method of owner symbol 3."""
    var pf = direct_fn(src, name)
    pf.is_method = true
    var hl = HirLowering.with_filename("dl_method.spl")
    hl.current_method_self_type = Some(HirType(kind: HirTypeKind.Named(SymbolId(id: 3), []), span: Span.empty()))
    hl.lower_function(pf)

describe "MC/DC lower_function name, owner and receiver decisions":
    # @req REQ-GEN-COV-HIRDECL-110
    it "declaration_lowering.spl:187 T :189 T reserved char_code_at alias outside its owner is rejected":
        expect(diags("fn __simple_rt_string_char_code_at(s: text, i: i64) -> i64:\n    0\n")).to_contain("is reserved for compiler-generated text calls")

    # @req REQ-GEN-COV-HIRDECL-111
    it "declaration_lowering.spl:189 F reserved char_code_at alias inside core_string is allowed":
        expect(diags_in("fn __simple_rt_string_char_code_at(s: text, i: i64) -> i64:\n    0\n", "src/runtime/simple_core/core_string.spl")).to_equal("")

    # @req REQ-GEN-COV-HIRDECL-112
    it "declaration_lowering.spl:191 T :193 T reserved byte_at alias outside its owner is rejected":
        expect(diags("fn __simple_rt_string_byte_at(s: text, i: i64) -> i64:\n    0\n")).to_contain("'__simple_rt_string_byte_at' is reserved")

    # @req REQ-GEN-COV-HIRDECL-113
    it "declaration_lowering.spl:193 F reserved byte_at alias inside core_string is allowed":
        expect(diags_in("fn __simple_rt_string_byte_at(s: text, i: i64) -> i64:\n    0\n", "src\\runtime\\simple_core\\core_string.spl")).to_equal("")

    # @req REQ-GEN-COV-HIRDECL-114
    it "declaration_lowering.spl:204 FF, :210 c1 F, :232 F free function is a plain Function symbol":
        val f = func(lower("fn free_fn() -> i64:\n    1\n"), "free_fn")
        expect(f.is_method).to_equal(false)
        expect(f.params.len()).to_equal(0)

    # @req REQ-GEN-COV-HIRDECL-115
    it "declaration_lowering.spl:204 c1 T, :210 TT, :331 T, :335 T method with no params gets implicit self":
        step("The flat bridge already inserts `self`; lower a bare ParserFunction flagged as a method")
        val f = method_direct("fn get() -> i64:\n    0\n", "get")
        expect(param_names(f)).to_equal("self")
        expect(kind_name(f.params[0].type_)).to_equal("named/0")

    # @req REQ-GEN-COV-HIRDECL-116
    it "declaration_lowering.spl:204 c2 T, :210 c2 F, :232 T static method has no receiver":
        val f = func(lower("class Box:\n    v: i64\n    static fn make(x: i64) -> i64:\n        x\n"), "make")
        expect(f.is_static).to_equal(true)
        expect(param_names(f)).to_equal("x")

    # @req REQ-GEN-COV-HIRDECL-117
    it "declaration_lowering.spl:331 F, :333 TT, :335 T, :356 TTT then c1 F, :357 FF first non-self param gets implicit self":
        val f = method_direct("fn put(x: i64, y: i64) -> i64:\n    x\n", "put")
        expect(param_names(f)).to_equal("self,x,y")
        expect(kind_name(f.params[1].type_)).to_equal("int")

    # @req REQ-GEN-COV-HIRDECL-118
    it "declaration_lowering.spl:333 c1 F, :335 F, :357 c1 T explicit self is not duplicated":
        val f = func(lower("class Box:\n    v: i64\n    fn take(self, x: i64) -> i64:\n        x\n"), "take")
        expect(param_names(f)).to_equal("self,x")
        expect(kind_name(f.params[0].type_)).to_equal("named/0")

    # @req REQ-GEN-COV-HIRDECL-119
    it "declaration_lowering.spl:333 c2 F, :357 c2 T explicit me receiver is not duplicated":
        step("The parser spells receivers `self`; rename the first param to `me` and lower as a method")
        var pf = direct_fn("fn take(self, x: i64) -> i64:\n    x\n", "take")
        var ps = pf.params
        var p0 = ps[0]
        p0.name = "me"
        ps[0] = p0
        pf.params = ps
        pf.is_method = true
        var hl = HirLowering.with_filename("dl_me.spl")
        hl.current_method_self_type = Some(HirType(kind: HirTypeKind.Named(SymbolId(id: 3), []), span: Span.empty()))
        val f = hl.lower_function(pf)
        expect(param_names(f)).to_equal("me,x")
        expect(kind_name(f.params[0].type_)).to_equal("named/0")

    # @req REQ-GEN-COV-HIRDECL-120
    it "declaration_lowering.spl:356 c2 F free function first param is never a receiver":
        val f = func(lower("fn first(self: i64) -> i64:\n    self\n"), "first")
        expect(kind_name(f.params[0].type_)).to_equal("int")

    # @req REQ-GEN-COV-HIRDECL-121
    it "declaration_lowering.spl:356 c3 F static method first param is never a receiver":
        step("A static ParserFunction flagged is_method too must still skip the receiver path")
        var pf = direct_fn("fn smake(self: i64) -> i64:\n    self\n", "smake")
        pf.is_method = true
        pf.is_static = true
        var hl = HirLowering.with_filename("dl_static.spl")
        val f = hl.lower_function(pf)
        expect(param_names(f)).to_equal("self")
        expect(kind_name(f.params[0].type_)).to_equal("int")

    # @req REQ-GEN-COV-HIRDECL-122
    it "declaration_lowering.spl:269 one type param, :92 F, :570 TT generic function is a template":
        val f = func(lower("fn ident<T>(x: T) -> T:\n    x\n"), "ident")
        expect(f.type_params.len()).to_equal(1)
        expect(f.is_generic_template).to_equal(true)

    # @req REQ-GEN-COV-HIRDECL-123
    it "declaration_lowering.spl:570 c1 F generic function without return type":
        val f = func(lower("fn sink<T>(x: T):\n    pass\n"), "sink")
        expect(f.is_generic_template).to_equal(true)
        expect(kind_name(f.return_type)).to_equal("unit")

    # @req REQ-GEN-COV-HIRDECL-124
    it "declaration_lowering.spl:570 c2 F and :92 T plain function is not a template":
        val f = func(lower("fn plain(x: i64) -> i64:\n    x\n"), "plain")
        expect(f.is_generic_template).to_equal(false)

