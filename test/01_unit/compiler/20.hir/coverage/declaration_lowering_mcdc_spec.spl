    # @req REQ-GEN-COV-HIRDECL-130
    it "declaration_lowering.spl:491 c1 F registered value-returning signature skips the scan":
        step("Pre-register the function symbol with an i64-returning Function type")
        var pf = direct_fn("fn pre(x):\n    pass\n", "pre")
        var hl = HirLowering.with_filename("dl_pre.spl")
        val ret = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        hl.symbols.define("pre", SymbolKind.Function, Some(HirType(kind: HirTypeKind.Function([], ret, []), span: Span.empty())), Span.empty(), Visibility.Public, false, nil)
        val f = hl.lower_function(pf)
        expect(kind_name(f.return_type)).to_equal("int")

