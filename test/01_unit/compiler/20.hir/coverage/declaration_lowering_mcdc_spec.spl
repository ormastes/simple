describe "MC/DC lower_struct and lower_field_with_type":
    # @req REQ-GEN-COV-HIRDECL-139
    it "declaration_lowering.spl:651 T custom primitive struct rebinds its symbol":
        step("Parse first (a fresh parse resets the primitive registry), then seed a sentinel symbol id; lower_struct must replace it")
        val pm = cov_parse("struct CovPrimWord:\n    v: i64\n")
        custom_primitive_register("CovPrimWord", TYPE_I64)
        custom_primitive_bind_symbol("CovPrimWord", 424242)
        expect(custom_primitive_underlying_type_tag_by_symbol(424242)).to_equal(TYPE_I64)
        var hl = HirLowering.with_filename("dl_prim.spl")
        val s = hl.lower_struct(pm.structs["CovPrimWord"])
        expect(s.name).to_equal("CovPrimWord")
        expect(custom_primitive_underlying_type_tag_by_symbol(424242)).to_equal(-1)

    # @req REQ-GEN-COV-HIRDECL-140
    it "declaration_lowering.spl:651 F, :697 FFF, :760 F plain struct":
        val s = struct_of(lower("struct Pt:\n    x: i64\n"), "Pt")
        expect(custom_primitive_underlying_type_tag_by_symbol(s.symbol.id)).to_equal(-1)
        expect(s.has_layout_attr).to_equal(false)
        expect(s.fields[0].has_default).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-141
    it "declaration_lowering.spl:697 c1 T repr C layout":
        step("The flat frontend bridge builds ParserStruct with `attributes: []`; attach the decorator")
        val s = struct_with_attrs([attr_str("repr", "C")])
        expect(s.has_layout_attr).to_equal(true)
        expect(s.layout_attr.has_explicit_align).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-142
    it "declaration_lowering.spl:697 c2 T explicit align alone":
        val s = struct_with_attrs([attr_int("align", 16)])
        expect(s.has_layout_attr).to_equal(true)
        expect(s.layout_attr.has_explicit_align).to_equal(true)

    # @req REQ-GEN-COV-HIRDECL-143
    it "declaration_lowering.spl:760 T field default is lowered":
        val s = struct_of(lower("struct Df:\n    x: i64 = 3\n"), "Df")
        expect(s.fields[0].has_default).to_equal(true)

describe "MC/DC lower_enum_with_symbol and lower_variant":
    # @req REQ-GEN-COV-HIRDECL-144
    it "declaration_lowering.spl:798 c1 F, :800 c1 F, :823 T, :845 F, :896 T local enum":
        var hl = HirLowering.with_filename("dl_enum.spl")
        val pm = cov_parse("enum Lvl:\n    Lo = 1\n    Hi(i64)\n")
        val e = hl.lower_enum(pm.enums["Lvl"], "cov.mod")
        expect(e.runtime_name).to_equal("cov.mod.Lvl")
        expect(e.variants[0].has_discriminant).to_equal(true)
        expect(e.variants[1].has_discriminant).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-145
    it "declaration_lowering.spl:823 F empty owner keeps the bare runtime name":
        var hl = HirLowering.with_filename("dl_enum.spl")
        val pm = cov_parse("enum Bare:\n    One\n")
        val e = hl.lower_enum(pm.enums["Bare"], "")
        expect(e.runtime_name).to_equal("Bare")

    # @req REQ-GEN-COV-HIRDECL-146
    it "declaration_lowering.spl:798 TT, :800 c2 F, :845 T imported enum uses the materialized id":
        var hl = HirLowering.with_filename("dl_imp.spl")
        hl.imported_enum_symbol_ids["Imp"] = 5
        val pm = cov_parse("enum Imp:\n    A(i64)\n")
        val e = hl.lower_enum_with_symbol(pm.enums["Imp"], "cov.other", "Imp", true)
        expect(e.symbol.id).to_equal(5)
        expect(hl.diagnostic_messages.join("\n").contains("no materialized symbol")).to_equal(false)
        match e.variants[0].kind:
            case HirVariantKind.Tuple(tys): expect(tys.len()).to_equal(1)
            case _: fail("imported tuple variant lost its payload")

    # @req REQ-GEN-COV-HIRDECL-147
    it "declaration_lowering.spl:798 c2 F and :800 TT imported enum without a symbol is reported":
        var hl = HirLowering.with_filename("dl_imp.spl")
        val pm = cov_parse("enum Ghost:\n    G\n")
        val e = hl.lower_enum_with_symbol(pm.enums["Ghost"], "cov.other", "Ghost", true)
        expect(e.symbol.is_valid()).to_equal(false)
        expect(hl.diagnostic_messages.join("\n")).to_contain("imported enum `Ghost` has no materialized symbol")

    # @req REQ-GEN-COV-HIRDECL-148
    it "declaration_lowering.spl:853 T unbound name is not a type binding":
        var hl = HirLowering.with_filename("dl_scope.spl")
        expect(hl.scope_binds_type_symbol("Nobody")).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-149
    it "declaration_lowering.spl:853 F bound struct is a type binding, bound variable is not":
        var hl = HirLowering.with_filename("dl_scope.spl")
        hl.symbols.define("Shape", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, nil)
        hl.symbols.define("count", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, false, nil)
        expect(hl.scope_binds_type_symbol("Shape")).to_equal(true)
        expect(hl.scope_binds_type_symbol("count")).to_equal(false)

describe "MC/DC lower_bitfield":
    # The flat frontend bridge gives every parsed bitfield field `has_bits`
    # (from its uN/bool type) and always attaches `@preserve_order`. Examples
    # that need the width-sorting path or inferred widths reset those on the
    # parsed Bitfield and lower it directly.

    # @req REQ-GEN-COV-HIRDECL-150
    it "declaration_lowering.spl:932 F inferred width, :948 T, :950 several, :952 TT and c1 F, :967 TTT, :969 F widest first":
        step("The inferred-width field (bool type, has_bits reset) is narrower than the explicit 3-bit field, so it sorts last")
        val b = bf_direct("bitfield Fl(u32):\n    on: bool\n    mode: u3\n", "Fl", [], [false, true], [false, false])
        expect(bit_offsets(b)).to_equal("mode@0,on@3")

    # @req REQ-GEN-COV-HIRDECL-151
    it "declaration_lowering.spl:952 c2 F already-sorted fields keep order":
        val b = bf_direct("bitfield So(u32):\n    wide: u5\n    narrow: u2\n", "So", [], [true, true], [false, false])
        expect(bit_offsets(b)).to_equal("wide@0,narrow@5")

    # @req REQ-GEN-COV-HIRDECL-152
    it "declaration_lowering.spl:932 T and :948 F parsed bitfield keeps declaration order":
        val b = bitfield_of(lower("bitfield Po(u32):\n    on: bool\n    mode: u3\n"), "Po")
        expect(bit_offsets(b)).to_equal("on@0,mode@1")

    # @req REQ-GEN-COV-HIRDECL-153
    it "declaration_lowering.spl:943 zero fields and :950 F empty bitfield":
        val b = bf_direct("bitfield Em(u32):\n    only: u3\n", "Em", [], [], [])
        expect(b.fields.len()).to_equal(0)
        expect(b.total_bits).to_equal(0)

    # @req REQ-GEN-COV-HIRDECL-154
    it "declaration_lowering.spl:950 F single field skips sorting":
        val b = bf_direct("bitfield One(u32):\n    only: u3\n", "One", [], [true], [false])
        expect(bit_offsets(b)).to_equal("only@0")

    # @req REQ-GEN-COV-HIRDECL-155
    it "declaration_lowering.spl:969 T field crossing a 32-bit word moves to the next word":
        val b = bitfield_of(lower("bitfield Cross(u64):\n    a: u20\n    b: u20\n"), "Cross")
        expect(bit_offsets(b)).to_equal("a@0,b@32")
        expect(b.total_bits).to_equal(52)

    # @req REQ-GEN-COV-HIRDECL-156
    it "declaration_lowering.spl:967 c1 F compactq packs across the word boundary":
        val b = bf_direct("bitfield Cq(u64):\n    a: u20\n    b: u20\n", "Cq", [plain_attr("preserve_order"), plain_attr("compactq")], [true, true], [false, false])
        expect(bit_offsets(b)).to_equal("a@0,b@20")

    # @req REQ-GEN-COV-HIRDECL-157
    it "declaration_lowering.spl:967 c3 F full-word field is not word-aligned again":
        val b = bitfield_of(lower("bitfield Wd(u64):\n    w: u32\n    t: u4\n"), "Wd")
        expect(bit_offsets(b)).to_equal("w@0,t@32")

    # @req REQ-GEN-COV-HIRDECL-158
    it "declaration_lowering.spl:934 T and :967 c2 F reserved field without bits is zero width":
        val b = bf_direct("bitfield Rs(u32):\n    a: u3\n    pad: u2\n", "Rs", [plain_attr("preserve_order")], [true, false], [false, true])
        expect(bit_offsets(b)).to_equal("a@0,pad@3")
        expect(b.total_bits).to_equal(3)

describe "MC/DC fn_has_untyped_value_param":
    # @req REQ-GEN-COV-HIRDECL-159
    it "declaration_lowering.spl:996 c1 T and :998 F self is skipped and typed params are not untyped":
        val pf = direct_fn("fn u(self, x: i64) -> i64:\n    x\n", "u")
        expect(fn_has_untyped_value_param(pf.params)).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-160
    it "declaration_lowering.spl:996 c2 T me is skipped":
        var pf = direct_fn("fn u(self) -> i64:\n    0\n", "u")
        var ps = pf.params
        var p0 = ps[0]
        p0.name = "me"
        ps[0] = p0
        expect(fn_has_untyped_value_param(ps)).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-161
    it "declaration_lowering.spl:996 FF and :998 T untyped value param is detected":
        val pf = direct_fn("fn u(x) -> i64:\n    0\n", "u")
        expect(fn_has_untyped_value_param(pf.params)).to_equal(true)

describe "MC/DC lower_bootstrap_flat_function":
    # @req REQ-GEN-COV-HIRDECL-108
    it "declaration_lowering.spl:101 T and :124 zero params invalid span falls back to empty":
        var hl = HirLowering.with_filename("dl_flat.spl")
        val idx = decl_fn("flat_zero", [], [], TYPE_I64, [], 0, [], 0)
        val f = hl.lower_bootstrap_flat_function(idx)
        expect(f.name).to_equal("flat_zero")
        expect(f.params.len()).to_equal(0)
        expect(f.span.line).to_equal(0)
        expect(f.is_gpu_kernel).to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-109
    it "declaration_lowering.spl:101 F, :124 n, :126 T/F and :138 T real span, short type list, gpu kernel":
        var hl = HirLowering.with_filename("dl_flat.spl")
        val span_id = flat_span_new(4, 20, 7, 3)
        val idx = decl_fn("flat_two", ["a", "b"], [TYPE_I64], TYPE_I64, [], 0, [], span_id)
        decl_is_gpu_kernel_set_at(idx, 1)
        val f = hl.lower_bootstrap_flat_function(idx)
        expect(f.span.line).to_equal(7)
        expect(param_names(f)).to_equal("a,b")
        expect(kind_name(f.params[0].type_)).to_equal("int")
        expect(kind_name(f.params[1].type_)).to_equal("infer")
        expect(f.is_gpu_kernel).to_equal(true)

describe "MC/DC env-gated bootstrap diagnostics":
    # Parsing happens before the env change: the frontend itself switches
    # paths under SIMPLE_BOOTSTRAP, and only HIR lowering is under test.

    # @req REQ-GEN-COV-HIRDECL-101
    it "declaration_lowering.spl:195 c1 F without SIMPLE_BOOTSTRAP diag stays off and :394 F keeps declared return":
        val f = func(lower_env("fn f() -> [i64]:\n    [1]\n", "0", "0", "0"), "f")
        expect(kind_name(f.return_type) == "int").to_equal(false)

    # @req REQ-GEN-COV-HIRDECL-102
    it "declaration_lowering.spl:195 TT and :71 T SIMPLE_COMPILER_TRACE enables the diag trace":
        step("Bootstrap on, trace on: every bootstrap_diag site prints and lowering still succeeds")
        val f = func(lower_env("fn traced(a: i64) -> text:\n    \"x\"\n", "1", "1", "0"), "traced")
        expect(f.name).to_equal("traced")
        expect(kind_name(f.return_type)).to_equal("str")

    # @req REQ-GEN-COV-HIRDECL-103
    it "declaration_lowering.spl:71 F SIMPLE_BOOTSTRAP_DIAG alone enables the diag trace":
        val f = func(lower_env("fn diagged() -> bool:\n    true\n", "1", "0", "1"), "diagged")
        expect(f.name).to_equal("diagged")
        expect(kind_name(f.return_type)).to_equal("other")

    # @req REQ-GEN-COV-HIRDECL-104
    it "declaration_lowering.spl:195 c2 F bootstrap without trace or diag and :394 T erases non-primitive returns":
        val f = func(lower_env("fn quiet() -> [i64]:\n    [1]\n", "1", "0", "0"), "quiet")
        expect(kind_name(f.return_type)).to_equal("int")

    # @req REQ-GEN-COV-HIRDECL-105
    it "declaration_lowering.spl:431 TT and :438 T bootstrap untyped value return gets the builtin type":
        val f = func(lower_env("fn helper(a: i64):\n    return a\n", "1", "0", "0"), "helper")
        expect(kind_name(f.return_type)).to_equal("int")

    # @req REQ-GEN-COV-HIRDECL-106
    it "declaration_lowering.spl:438 F and :468 c2 F bootstrap untyped body without value return stays unit":
        val f = func(lower_env("fn noop(a: i64):\n    pass\n", "1", "0", "0"), "noop")
        expect(kind_name(f.return_type)).to_equal("unit")

    # @req REQ-GEN-COV-HIRDECL-107
    it "declaration_lowering.spl:431 c2 F bootstrap main is not return-scanned":
        val f = func(lower_env("fn main():\n    return 0\n", "1", "0", "0"), "main")
        expect(kind_name(f.return_type)).to_equal("unit")
