# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
"""
# HIR imports: an explicit import supersedes a transitive bare binding cleanly

A composite FIELD dependency the importer never named is bound under its bare
name only while that name is free ("transitive"). These examples pin what
happens when the same bare name is then claimed by something stronger:

- an explicitly imported ENUM replacing a transitive enum must also replace
  the enum-owner row (`imported_enum_owner_module` returns the FIRST row for
  a name, so a leftover transitive row named the wrong owner);
- an explicitly imported CLASS replacing a transitive enum must drop the
  enum materialization keyed by that short name;
- a later conflicting transitive pull must never unbind a binding that is no
  longer the recorded transitive symbol -- here the module's OWN declaration
  -- and never from a nested (function-local import) scope.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}

fn lowered_consumer(provider_names: [text], provider_sources: [text], consumer: text) -> HirLowering:
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    var sources: [SourceFile] = []
    var i = 0
    while i < provider_names.len():
        val path = provider_names[i].replace(".", "/") + ".spl"
        modules[provider_names[i]] = parse_full_frontend(provider_sources[i], path, provider_names[i], log)
        sources.push(SourceFile(path: path, content: provider_sources[i], module_name: provider_names[i]))
        i = i + 1
    val consumer_ast = parse_full_frontend(consumer, "app/main.spl", "app.main", log)
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val _hir = consumer_lowering.lower_module(consumer_ast)
    consumer_lowering

fn errors_mentioning(lowering: HirLowering, needle: text) -> i64:
    var n = 0
    for e in lowering.errors:
        if e.message.contains(needle):
            n = n + 1
    n

val mode_a_src = "pub enum Mode:\n    Lo\n    Hi\n\npub struct Cfg:\n    mode: Mode\n"
val mode_b_enum_src = "pub enum Mode:\n    Up\n    Down\n"
val mode_b_class_src = "pub class Mode:\n    n: i64\n"
val mode_enum_consumer = "use lib.a.\{Cfg\}\nuse lib.b.\{Mode\}\n\nfn f(m: Mode) -> i64:\n    match m:\n        case Mode.Up: return 1\n        case Mode.Down: return 2\n    0\n"
val mode_class_consumer = "use lib.a.\{Cfg\}\nuse lib.b.\{Mode\}\n\nfn get(m: Mode) -> i64:\n    m.n\n"

val gap_a_src = "pub struct Gap:\n    a: i64\n\npub struct HolderA:\n    gap: Gap\n"
val gap_b_src = "pub struct Gap:\n    b: i64\n\npub struct HolderB:\n    gap: Gap\n"
val own_gap_consumer = "use lib.a.\{HolderA\}\n\nstruct Gap:\n    z: i64\n\nfn local_pull() -> i64:\n    use lib.b.\{HolderB\}\n    1\n\nfn own() -> i64:\n    val g = Gap(z: 3)\n    g.z\n"

describe "explicit import over a transitive bare binding":
    it "re-owns the enum row when an explicit enum replaces a transitive enum":
        val lowering = lowered_consumer(["lib.a", "lib.b"], [mode_a_src, mode_b_enum_src], mode_enum_consumer)
        expect(lowering.imported_enum_owner_module("Mode")).to_equal("lib.b")
        expect(errors_mentioning(lowering, "Mode")).to_equal(0)

    it "drops transitive enum state when an explicit class replaces it":
        val lowering = lowered_consumer(["lib.a", "lib.b"], [mode_a_src, mode_b_class_src], mode_class_consumer)
        expect(lowering.imported_enums.contains_key("Mode")).to_equal(false)
        var mode_rows = 0
        for owner_row in lowering.imported_enum_owner_rows:
            if owner_row.starts_with("Mode\u001f"):
                mode_rows = mode_rows + 1
        expect(mode_rows).to_equal(0)
        expect(errors_mentioning(lowering, "Mode")).to_equal(0)

    it "keeps the module's own declaration across a later conflicting transitive pull":
        val lowering = lowered_consumer(["lib.a", "lib.b"], [gap_a_src, gap_b_src], own_gap_consumer)
        expect(errors_mentioning(lowering, "Gap")).to_equal(0)
        expect(errors_mentioning(lowering, "unresolved")).to_equal(0)
