# Purpose and audience: compiler engineers who own HIR name resolution and the
# phase-4 bootstrap lane.
# @req REQ-SSPEC-COMPILER
"""
# HIR name resolution is eager: an undefined name fails lowering wherever it sits

The phase-4 bootstrap (p4-phase2 lane, 2026-10-20, both llvm and cranelift
backends) stopped in HIR on 27 `src/os` files with 67 errors such as
`unresolved name: pci_bdf_bus`, `unresolved name: draw_text_shadow`,
`unresolved name: spawn_binary_with_args`, `unresolved name: _inc32` and
`unresolved type: SurfaceDesc`. The names fall into three groups:

- defined nowhere in the tree (`pci_bdf_bus`, `draw_text_shadow`,
  `spawn_binary_with_args`, `FbCompositorBackend`);
- defined in another module but never imported (`_inc32` lives in
  `aes256_gcm.spl` and is called from `aes128_gcm.spl`; `log_raw_println`
  in `wm_service_protocol.spl`; `_map_user_process_image` in
  `scheduler_exec.spl`);
- types that only exist in a module that does not exist
  (`DisplayMode` / `SurfaceDesc` from `common.display_protocol`).

Several of the first group are imported by name from a provider that lost
the declaration (`use os.compositor.text_render.{draw_text_shadow}`; the
p4p2 lane restored or stubbed them in 2830694a792).

They lived in the tree because earlier lanes resolved names lazily: a call
that never ran was never looked up. HIR lowering is the gate that catches
them, so this spec pins the gate itself. A missing name must fail HIR with
an `unresolved name: <name>` / `unresolved type: <name>` diagnostic:

- in a function nobody calls,
- in every body position (branch, loop, lambda, method, match arm,
  interpolation, module initializer, after a field read),
- in a provider module of a closure, not only in the entry,
- when the name exists in a sibling module that the consumer did not import.

Every example also lowers a clean control, so a lowering that reports
nothing because it lowered nothing cannot pass.

Fixing the `src/os` names themselves is a separate lane (worktree
`wt-p4p2-oshir`); this spec does not depend on those sources.
"""

# @tag:unit
# @tag:compiler
# @tag:hir
# @tag:name_resolution

use std.spec.{describe, it, expect, step}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.core.parser.{parser_has_errors}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule}

struct EagerLowered:
    errors: [text]
    function_count: i64

fn eager_lower_single(source: text) -> EagerLowered:
    val parsed = parse_full_frontend(source, "eager_fixture.spl", "eager_fixture", Logger(level: 0))
    expect(parser_has_errors()).to_equal(false)
    var lowering = HirLowering.with_filename("eager_fixture.spl")
    val hir: HirModule = lowering.lower_module(parsed)
    var errors: [text] = []
    for e in lowering.errors:
        errors.push(e.message)
    EagerLowered(errors: errors, function_count: hir.functions.len())

fn eager_lower_closure(names: [text], sources: [text]) -> EagerLowered:
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    var files: [SourceFile] = []
    var i = 0
    while i < names.len():
        val path = names[i].replace(".", "/") + ".spl"
        modules[names[i]] = parse_full_frontend(sources[i], path, names[i], log)
        files.push(SourceFile(path: path, content: sources[i], module_name: names[i]))
        i = i + 1
    val surfaces_result = module_surfaces_from_modules(modules, files)
    if surfaces_result.is_err():
        return EagerLowered(errors: ["surface build failed: " + surfaces_result.unwrap_err()], function_count: 0)
    val surfaces = surfaces_result.unwrap()
    var errors: [text] = []
    var functions = 0
    for name in names:
        var lowering = hirlowering_for_module(name, surfaces)
        val hir: HirModule = lowering.lower_module(modules[name])
        functions = functions + hir.functions.len()
        for e in lowering.errors:
            errors.push(name + ": " + e.message)
    EagerLowered(errors: errors, function_count: functions)

fn eager_joined(errors: [text]) -> text:
    var out = ""
    for e in errors:
        out = out + e + "\n"
    out

fn eager_count(errors: [text], needle: text) -> i64:
    var n = 0
    for e in errors:
        if e.contains(needle):
            n = n + 1
    n

fn expect_unresolved(source: text, needle: text):
    val lowered = eager_lower_single(source)
    expect(lowered.function_count).to_be_greater_than(0)
    expect(eager_joined(lowered.errors)).to_contain(needle)
    expect(eager_count(lowered.errors, needle)).to_be_greater_than(0)

val eager_clean_src = "fn helper(x: i64) -> i64:\n    x + 1\n\nfn main() -> i64:\n    helper(1)\n"

describe "HIR name resolution: phase-4 src/os reproducers":
    it "lowers the clean control with zero diagnostics":
        step("Control: a module with only defined names must lower clean")
        val lowered = eager_lower_single(eager_clean_src)
        expect(lowered.function_count).to_equal(2)
        expect(lowered.errors.len()).to_equal(0)

    it "fails on a call to pci_bdf_bus that is defined nowhere, inside a never-called function":
        step("The pci_bdf_* shape: the caller is dead code, the name is still checked")
        expect_unresolved("fn bdf_of(dev: i64) -> i64:\n    pci_bdf_bus(dev)\n\nfn main() -> i64:\n    0\n", "unresolved name: pci_bdf_bus")

    it "fails on draw_text_shadow called as a statement":
        step("window_effects.spl shape: a unit-returning helper call that was never defined")
        expect_unresolved("fn paint(x: i64):\n    draw_text_shadow(x, 1, \"title\")\n\nfn main() -> i64:\n    0\n", "unresolved name: draw_text_shadow")

    it "fails on spawn_binary_with_args used as a value":
        step("A missing function bound to a local is as unresolved as one that is called")
        expect_unresolved("fn launch(path: text) -> i64:\n    val pid = spawn_binary_with_args(path, [\"-v\"])\n    pid\n\nfn main() -> i64:\n    0\n", "unresolved name: spawn_binary_with_args")

    it "fails on a constructor call of a class that does not exist":
        step("fb_backend.spl shape: FbCompositorBackend(...) with no declaration")
        expect_unresolved("fn make() -> i64:\n    val b = FbCompositorBackend(width: 1)\n    0\n\nfn main() -> i64:\n    0\n", "unresolved name: FbCompositorBackend")

    it "fails on a parameter typed with an undeclared type":
        step("display_service.spl shape: SurfaceDesc has no declaration")
        expect_unresolved("fn present(s: SurfaceDesc) -> i64:\n    0\n\nfn main() -> i64:\n    0\n", "unresolved type: SurfaceDesc")

describe "HIR name resolution is eager in every body position":
    it "checks a name inside an if branch":
        expect_unresolved("fn f(x: i64) -> i64:\n    if x > 0:\n        return undef_in_if(x)\n    0\n", "unresolved name: undef_in_if")

    it "checks a name inside a while loop body":
        expect_unresolved("fn f(x: i64) -> i64:\n    var n = 0\n    while n < x:\n        n = n + undef_in_loop(n)\n    n\n", "unresolved name: undef_in_loop")

    it "checks a name inside a lambda body":
        expect_unresolved("fn f(xs: [i64]) -> [i64]:\n    xs.map(\\x: undef_in_lambda(x))\n", "unresolved name: undef_in_lambda")

    it "checks a name inside an impl method":
        expect_unresolved("class C:\n    v: i64\n\nimpl C:\n    fn g() -> i64:\n        undef_in_method(self.v)\n", "unresolved name: undef_in_method")

    it "checks a name inside a match arm":
        expect_unresolved("enum E:\n    A\n    B(i64)\n\nfn f(e: E) -> i64:\n    match e:\n        case E.A: 0\n        case E.B(n): undef_in_arm(n)\n", "unresolved name: undef_in_arm")

    it "checks a name inside a text interpolation":
        expect_unresolved("fn f(x: i64) -> text:\n    \"v=\{undef_in_interp(x)\}\"\n", "unresolved name: undef_in_interp")

    it "checks a name in a module-level initializer":
        expect_unresolved("val GLOBAL_X: i64 = undef_in_global(1)\n\nfn main() -> i64:\n    0\n", "unresolved name: undef_in_global")

    it "checks an undefined constant-style name":
        expect_unresolved("fn f() -> i64:\n    UNDEF_CONSTANT + 1\n", "unresolved name: UNDEF_CONSTANT")

    it "checks a name that follows a field read":
        expect_unresolved("struct S:\n    v: i64\n\nfn f(s: S) -> i64:\n    s.v + undef_after_field(s.v)\n", "unresolved name: undef_after_field")

val eager_lib_src = "pub fn map_image(n: i64) -> i64:\n    n + 1\n\npub fn other_helper() -> i64:\n    2\n"

describe "HIR name resolution across an entry closure":
    it "resolves an imported provider function (control)":
        step("Control: the same call lowers clean once it is imported")
        val consumer = "use lib.eager_img.\{map_image\}\n\nfn run() -> i64:\n    map_image(1)\n"
        val lowered = eager_lower_closure(["lib.eager_img", "app.eager_main"], [eager_lib_src, consumer])
        expect(lowered.function_count).to_be_greater_than(2)
        expect(eager_joined(lowered.errors)).to_equal("")

    it "fails when the name exists in a sibling module that was never imported":
        step("_inc32 / _map_user_process_image shape: defined elsewhere, called without a use")
        val consumer = "fn run() -> i64:\n    map_image(1)\n"
        val lowered = eager_lower_closure(["lib.eager_img", "app.eager_main"], [eager_lib_src, consumer])
        expect(eager_joined(lowered.errors)).to_contain("app.eager_main: unresolved name: map_image")

    it "fails when the module imports other names from the provider but not this one":
        step("A partial import list does not make every provider name visible")
        val consumer = "use lib.eager_img.\{other_helper\}\n\nfn run() -> i64:\n    other_helper() + map_image(1)\n"
        val lowered = eager_lower_closure(["lib.eager_img", "app.eager_main"], [eager_lib_src, consumer])
        expect(eager_joined(lowered.errors)).to_contain("app.eager_main: unresolved name: map_image")
        expect(eager_count(lowered.errors, "other_helper")).to_equal(0)

    it "fails at the use of a name imported from a provider that does not declare it":
        step("window_effects.spl shape: `use os.compositor.text_render.\{draw_text_shadow}` after the provider lost it")
        val consumer = "use lib.eager_img.\{draw_text_shadow\}\n\nfn paint() -> i64:\n    draw_text_shadow(1)\n"
        val lowered = eager_lower_closure(["lib.eager_img", "app.eager_main"], [eager_lib_src, consumer])
        expect(eager_joined(lowered.errors)).to_contain("app.eager_main: unresolved name: draw_text_shadow")

    it "fails in a provider module's dead function, attributed to the provider":
        step("A provider of the closure is checked as eagerly as the entry")
        val provider = "pub fn ok_fn() -> i64:\n    1\n\nfn dead() -> i64:\n    draw_text_shadow(1)\n"
        val consumer = "use lib.eager_dead.\{ok_fn\}\n\nfn main() -> i64:\n    ok_fn()\n"
        val lowered = eager_lower_closure(["lib.eager_dead", "app.eager_main"], [provider, consumer])
        expect(eager_joined(lowered.errors)).to_contain("lib.eager_dead: unresolved name: draw_text_shadow")
        expect(eager_count(lowered.errors, "app.eager_main:")).to_equal(0)
