# Purpose and audience: compiler engineers who own the flat type parser
# (10.frontend/core/parser.spl), the flat-AST bridge and HIR type lowering.
# @req REQ-SSPEC-COMPILER
"""
# `Option<T>` keeps its inner type through the flat parser into HIR

Reproducer for the `Option<fn(..)>` flattening fixed in PR #3914
(bug native_optional_fn_payload_binding_arity_mir_2026_10_20). The flat
parser only registered an `Option<T>` inner tag when the tag was
`>= TYPE_NAMED_BASE`; a callable inner (interned in
`TYPE_FUNCTION_BASE..`) fell through to bare `TYPE_OPTION`, the bridge
produced an argless `Option`, and HIR lowered it to `Optional(Any)`. MIR then
had no proven arity for `if val cb = self.f: cb(..)` (elf_operation_bindings,
macho.provider_closure in phase 3).

This file pins the shapes that keep their inner type today:

- `Option<fn(text) -> i64>` -> `Optional(Function([Str], Int))` (the fix),
- `Option<i64>` and `Option<text>` (dedicated primitive tags),
- `Option<UserStruct>` (named inner).

It also asserts the MIR-visible behaviour: the callable is invoked with a
proven arity, and `[i64]?` iterates as an array. The shapes that still
collapse are in `option_generic_inner_type_gaps_spec.spl`.
"""

# @tag:unit
# @tag:compiler
# @tag:hir
# @tag:types

use std.spec.{describe, it, expect, step, fail}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{parser_has_errors}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn opt_kind_name(t: HirType) -> text:
    # Binding patterns only (see seed_built_producer_literal_payload_pattern_never_matches_2026_10_20).
    match t.kind:
        case HirTypeKind.Int(bits, signed):
            if signed:
                return "i{bits}"
            "u{bits}"
        case HirTypeKind.Str: "text"
        case HirTypeKind.Any: "any"
        case HirTypeKind.Named(_, _): "named"
        case HirTypeKind.Array(element, _): "array<" + opt_kind_name(element) + ">"
        case HirTypeKind.Dict(k, v): "dict<" + opt_kind_name(k) + "," + opt_kind_name(v) + ">"
        case HirTypeKind.Tuple(elements):
            var parts: [text] = []
            for e in elements:
                parts.push(opt_kind_name(e))
            "tuple<" + parts.join(",") + ">"
        case HirTypeKind.Optional(inner): "optional<" + opt_kind_name(inner) + ">"
        case HirTypeKind.Function(params, ret, _):
            var parts: [text] = []
            for p in params:
                parts.push(opt_kind_name(p))
            "fn(" + parts.join(",") + ")->" + opt_kind_name(ret)
        case _: "other"

fn opt_field_type(source: text, struct_name: text, field: text) -> text:
    val parsed = parse_full_frontend(source, "opt_inner.spl", "opt_inner", Logger(level: 0))
    expect(parser_has_errors()).to_equal(false)
    var lowering = HirLowering.with_filename("opt_inner.spl")
    val hir: HirModule = lowering.lower_module(parsed)
    for s in hir.structs.values():
        if s.name == struct_name:
            for f in s.fields:
                if f.name == field:
                    return opt_kind_name(f.type_)
    fail("missing lowered field " + struct_name + "." + field)
    ""

fn opt_mir_messages(source: text) -> text:
    val file = "testdata/opt_inner_mir.spl"
    val parsed = parse_full_frontend(source, file, "opt_inner_mir", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    lowering.lower_module(hir)
    var out = ""
    for e in hir_lowering.errors:
        out = out + "hir: " + e.message + "\n"
    for e in lowering.errors:
        out = out + "mir: " + e.message + "\n"
    out

describe "Option<T> inner type through the flat parser":
    it "keeps Option<fn(text) -> i64> as Optional(Function) (PR #3914 reproducer)":
        step("elf_operation_bindings shape: an optional callback field")
        val src = "struct H:\n    cb: Option<fn(text) -> i64>\n"
        expect(opt_field_type(src, "H", "cb")).to_equal("optional<fn(text)->i64>")

    it "calls an Option<fn> payload bound by if-val with a proven arity":
        val src = "struct H:\n    cb: Option<fn(text) -> i64>\n\nfn call(h: H) -> i64:\n    if val f = h.cb:\n        return f(\"x\")\n    0\n"
        val messages = opt_mir_messages(src)
        expect(messages.contains("proven arity")).to_equal(false)
        expect(messages).to_equal("")

    it "keeps Option<i64> and Option<text> inner types":
        val src = "struct H:\n    n: Option<i64>\n    s: Option<text>\n"
        expect(opt_field_type(src, "H", "n")).to_equal("optional<i64>")
        expect(opt_field_type(src, "H", "s")).to_equal("optional<text>")

    it "keeps a named inner type":
        val src = "struct Inner:\n    v: i64\n\nstruct H:\n    inner: Option<Inner>\n"
        expect(opt_field_type(src, "H", "inner")).to_equal("optional<named>")

    it "iterates a postfix [i64]? payload as an array":
        step("Contrast with Option<[i64]>, which still collapses (gaps spec)")
        val src = "struct H:\n    xs: [i64]?\n\nfn total(h: H) -> i64:\n    var n = 0\n    if val xs = h.xs:\n        for x in xs:\n            n = n + x\n    n\n"
        val messages = opt_mir_messages(src)
        expect(messages.contains("#143")).to_equal(false)
        expect(messages).to_equal("")
