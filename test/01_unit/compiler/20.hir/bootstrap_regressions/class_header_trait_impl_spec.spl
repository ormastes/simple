# Purpose and audience: compiler engineers who own class declaration parsing,
# HIR impl registration and MIR native trait registration.
# @req REQ-SSPEC-COMPILER
# @tag:in-development
# Tracks: doc/08_tracking/bug/compiler_compilation_context_class_header_trait_no_impl_2026_10_20.md
"""
# `class X(Trait):` is either a real trait impl or a diagnostic, never silent

Phase-3 MIR (other.txt, 2026-10-20) failed
`LinkerCompilationContext` with `missing native trait implementation:
compiler.common.compilation_context::CompilationContext for ...`. The class
was declared `class LinkerCompilationContext(CompilationContext):`. The
parser's `ParserClass` has no parent/trait field, so the parenthesised name
is dropped, no `impl CompilationContext for LinkerCompilationContext` is
registered, and MIR native trait registration (which reads only
`module.impls` with `has_trait_`) finds nothing. PR #3914 fixed that one
class by rewriting it; `CompilerCompilationContext` in
`src/compiler/80.driver/pipeline/compiler_context.spl:16` has the same shape
(latent).

Reproduced with the phase-2 producer (producer8, 2026-10-20, `compile`):

- `class X(T)` + `impl X:` + `use_t(X(v: 1))` -> `missing native trait
  implementation: ...::T for ...::X`;
- `class X(NoSuchTrait):` compiles with no diagnostic at all;
- the control `class X:` + `impl T for X:` compiles clean.

Which fix is right (lower the header to a trait impl, or reject the form) is
the owner's call; this spec accepts either for the known-trait case, and
requires a diagnostic naming the trait for an unknown one either way. It is
in-development: it fails until the header form stops being accepted
silently.
"""

# @tag:unit
# @tag:compiler
# @tag:hir
# @tag:traits

use std.spec.{describe, it, expect, step}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{parser_has_errors}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

struct HeaderLowered:
    parse_failed: bool
    hir_errors: text
    mir_errors: text
    trait_impl_for_x: bool

fn header_impl_target_name(hir: HirModule, t: HirType) -> text:
    match t.kind:
        case HirTypeKind.Named(sym, _):
            val found = hir.symbols.get_symbol(sym)
            if found == nil:
                return ""
            found.unwrap().name
        case _: ""

fn header_lower(source: text) -> HeaderLowered:
    val file = "testdata/class_header.spl"
    val parsed = parse_full_frontend(source, file, "class_header", Logger(level: 0))
    if parser_has_errors():
        return HeaderLowered(parse_failed: true, hir_errors: "", mir_errors: "", trait_impl_for_x: false)
    var hir_lowering = HirLowering.with_filename(file)
    val hir: HirModule = hir_lowering.lower_module(parsed)
    var hir_errors = ""
    for e in hir_lowering.errors:
        hir_errors = hir_errors + e.message + "\n"
    var trait_impl = false
    for im in hir.impls:
        if im.has_trait_ and header_impl_target_name(hir, im.type_) == "X":
            trait_impl = true
    var mir_errors = ""
    if hir_errors == "":
        var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
        lowering.lower_module(hir)
        for e in lowering.errors:
            mir_errors = mir_errors + e.message + "\n"
    HeaderLowered(parse_failed: false, hir_errors: hir_errors, mir_errors: mir_errors, trait_impl_for_x: trait_impl)

val header_trait = "trait T:\n    fn f() -> i64\n\n"

val header_use = "\nfn use_t(t: T) -> i64:\n    t.f()\n\nfn make() -> i64:\n    use_t(X(v: 1))\n"

describe "class header trait form":
    it "registers a trait impl for the control `impl T for X`":
        step("Control: the spelled-out impl is what MIR needs")
        val src = header_trait + "class X:\n    v: i64\n\nimpl T for X:\n    fn f() -> i64:\n        self.v\n" + header_use
        val lowered = header_lower(src)
        expect(lowered.parse_failed).to_equal(false)
        expect(lowered.hir_errors).to_equal("")
        expect(lowered.trait_impl_for_x).to_equal(true)
        expect(lowered.mir_errors.contains("missing native trait implementation")).to_equal(false)

    it "does not silently drop the trait in `class X(T):`":
        step("LinkerCompilationContext / CompilerCompilationContext shape")
        val src = header_trait + "class X(T):\n    v: i64\n\nimpl X:\n    fn f() -> i64:\n        self.v\n" + header_use
        val lowered = header_lower(src)
        val rejected = lowered.parse_failed or lowered.hir_errors != ""
        val lowered_as_impl = lowered.trait_impl_for_x and not lowered.mir_errors.contains("missing native trait implementation")
        expect(rejected or lowered_as_impl).to_equal(true)

    it "reports an unknown trait named in a class header":
        step("Today `class X(NoSuchTrait):` compiles with no diagnostic")
        val lowered = header_lower("class X(NoSuchTrait):\n    v: i64\n")
        val rejected_by_parser = lowered.parse_failed
        val named_by_hir = lowered.hir_errors.contains("NoSuchTrait")
        expect(rejected_by_parser or named_by_hir).to_equal(true)
