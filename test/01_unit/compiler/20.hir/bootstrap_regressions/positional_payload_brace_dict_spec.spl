# Purpose and audience: compiler engineers who own enum declaration parsing and
# HIR enum lowering.
# @req REQ-SSPEC-COMPILER
# @tag:in-development
# Tracks: doc/08_tracking/bug/positional_brace_dict_payload_parsed_as_struct_field_2026-10-20.md
"""
# A positional enum payload keeps the type it spells, for every type spelling

Phase-3 MIR (enum_payload cluster, producer6 1622d7c0c7a, 2026-10-20) failed
`HirPhaseMemoRoot.IndexMap(self.field_package_dep_memo)` with
`enum construction 'E.IndexMap': payload type mismatch at 0`. The variant was
declared `IndexMap({text: i64})`; the brace was read as a named field
`text: i64`, so the variant got one `i64` slot instead of one
`Dict<text, i64>` slot. Spelling it `IndexMap(Dict<text, i64>)` works.

The class is "a positional payload type spelling that is not a bare name".
Probing the neighbours with the phase-2 producer (producer8, 2026-10-20)
found two more members of the same class that do not even parse:

- `T((i64, text))` -> `expected enum variant name, got )`
- `F(fn(i64) -> i64)` -> `expected enum variant name, got ->`

This spec covers the failing spellings. Its passing sibling,
`positional_payload_spelling_spec.spl`, pins the spellings that work today.
It is in-development: it fails until the variant payload parser takes a
full type in positional position.
"""

# @tag:unit
# @tag:compiler
# @tag:hir
# @tag:enum_payload

use std.spec.{describe, it, expect, step, fail}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{parser_has_errors}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirEnum, HirVariant, HirVariantKind}

fn brace_kind_name(t: HirType) -> text:
    # Binding patterns only: literal payload sub-patterns are not reliable in
    # seed-built lanes (seed_built_producer_literal_payload_pattern_never_matches_2026_10_20).
    match t.kind:
        case HirTypeKind.Int(bits, signed):
            if signed:
                return "i{bits}"
            "u{bits}"
        case HirTypeKind.Str: "text"
        case HirTypeKind.Dict(k, v): "dict<" + brace_kind_name(k) + "," + brace_kind_name(v) + ">"
        case HirTypeKind.Tuple(elements):
            var parts: [text] = []
            for e in elements:
                parts.push(brace_kind_name(e))
            "tuple<" + parts.join(",") + ">"
        case HirTypeKind.Function(params, ret, _):
            var parts: [text] = []
            for p in params:
                parts.push(brace_kind_name(p))
            "fn(" + parts.join(",") + ")->" + brace_kind_name(ret)
        case _: "other"

fn brace_variant_shape(source: text, variant: text) -> text:
    val parsed = parse_full_frontend(source, "brace_payload.spl", "brace_payload", Logger(level: 0))
    if parser_has_errors():
        return "parse-error"
    var lowering = HirLowering.with_filename("brace_payload.spl")
    val hir: HirModule = lowering.lower_module(parsed)
    for en in hir.enums.values():
        for v in en.variants:
            if v.name == variant:
                match v.kind:
                    case HirVariantKind.Tuple(types):
                        var parts: [text] = []
                        for t in types:
                            parts.push(brace_kind_name(t))
                        return "positional[" + parts.join(";") + "]"
                    case HirVariantKind.Struct(fields):
                        var parts: [text] = []
                        for f in fields:
                            parts.push(f.name + ":" + brace_kind_name(f.type_))
                        return "named[" + parts.join(";") + "]"
                    case _: return "unit"
    fail("missing lowered variant " + variant)
    ""

describe "positional enum payload spellings that are not bare names":
    it "registers {text: i64} as one Dict<text, i64> slot, not a named i64 field":
        step("HirPhaseMemoRoot.IndexMap shape")
        val shape = brace_variant_shape("enum Memo:\n    IndexMap(\{text: i64\})\n", "IndexMap")
        expect(shape).to_equal("positional[dict<text,i64>]")

    it "registers {text: [i64]} as one Dict slot":
        step("HirPhaseMemoRoot.IndexLists shape")
        val shape = brace_variant_shape("enum Memo:\n    IndexLists(\{text: [i64]\})\n", "IndexLists")
        expect(shape.starts_with("positional[dict<text,")).to_equal(true)

    it "parses and registers a parenthesised tuple payload as one tuple slot":
        val shape = brace_variant_shape("enum P:\n    T((i64, text))\n", "T")
        expect(shape).to_equal("positional[tuple<i64,text>]")

    it "parses and registers a function-typed payload as one function slot":
        val shape = brace_variant_shape("enum P:\n    F(fn(i64) -> i64)\n", "F")
        expect(shape).to_equal("positional[fn(i64)->i64]")
