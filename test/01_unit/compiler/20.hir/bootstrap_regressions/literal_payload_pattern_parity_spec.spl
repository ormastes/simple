# Purpose and audience: compiler engineers who own pattern lowering, and the
# bootstrap owners who decide which producer lane may build the compiler.
# @req REQ-SSPEC-COMPILER
"""
# Literal and binding payload patterns select the same arm

Reproducer and prevention spec for
seed_built_producer_literal_payload_pattern_never_matches_2026_10_20. A
producer built by the Rust seed (cranelift, strict link) rejected
`Result<(text, i64), text>` with `unsupported Result tuple payload element
type: slot 1 is Int(64, true)`: the HIR kind WAS `Int(64, true)`, but the arm
`case HirTypeKind.Int(64, true):` in `result_try_tuple_field_type` never
matched. Rewritten as `case HirTypeKind.Int(bits, signed): if bits == 64 and
signed:` it matched. That is also why phase 3 rejected plain
`Result<(i64, i64), text>`.

Reproduced 2026-10-20: `compile` of a `Result<(i64, i64), text>` + `?`
fixture fails on producer6 (pre-#3914) with `unsupported Result tuple payload
element type`, and passes on producer8 (post-workaround). A user-code fixture
with the same literal arms, native-built by producer8 (llvm) and by
producer7-cl (cranelift), RUNS with 0 literal/binding mismatches, so the
defect is in seed-generated compiler code, not in the language.

Literal-payload arms still live in compiler source
(`20.hir/hir_verification.spl:8-12`,
`50.mir/_MirLowering/function_lowering.spl:929`,
`50.mir/_MirLoweringExpr/switch_operators_calls.spl:6481`). Each example here
classifies the same values twice, once with literal sub-patterns and once
with bindings, and requires the answers to agree. The examples pass in a
correctly built lane; a run in a seed-built lane fails them, which is what
this spec is for.
"""

# @tag:unit
# @tag:compiler
# @tag:hir
# @tag:patterns

use std.spec.{describe, it, expect, step}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.hir_verification.{hir_verification_decreases_type_valid}

fn lit_span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1, file: "literal_parity.spl", length: 0)

fn lit_ty(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: lit_span())

fn hir_by_literal(t: HirType) -> i64:
    match t.kind:
        case HirTypeKind.Int(64, true): 1
        case HirTypeKind.Int(32, false): 2
        case HirTypeKind.Int(8, false): 3
        case HirTypeKind.Float(64): 4
        case HirTypeKind.Float(32): 5
        case _: 0

fn hir_by_binding(t: HirType) -> i64:
    match t.kind:
        case HirTypeKind.Int(bits, signed):
            if bits == 64 and signed:
                return 1
            if bits == 32 and not signed:
                return 2
            if bits == 8 and not signed:
                return 3
            0
        case HirTypeKind.Float(bits):
            if bits == 64:
                return 4
            if bits == 32:
                return 5
            0
        case _: 0

fn hir_parity_samples() -> [HirType]:
    [lit_ty(HirTypeKind.Int(64, true)), lit_ty(HirTypeKind.Int(64, false)), lit_ty(HirTypeKind.Int(32, false)),
     lit_ty(HirTypeKind.Int(32, true)), lit_ty(HirTypeKind.Int(8, false)), lit_ty(HirTypeKind.Int(8, true)),
     lit_ty(HirTypeKind.Float(64)), lit_ty(HirTypeKind.Float(32)), lit_ty(HirTypeKind.Bool), lit_ty(HirTypeKind.Str)]

enum ParityKind:
    Int(bits: i64, signed: bool)
    Name(label: text)
    Pair(a: i64, b: i64)
    Unit

fn user_by_literal(k: ParityKind) -> i64:
    match k:
        case ParityKind.Int(64, true): 1
        case ParityKind.Int(8, false): 2
        case ParityKind.Name("x"): 3
        case ParityKind.Pair(1, 2): 4
        case _: 0

fn user_by_binding(k: ParityKind) -> i64:
    match k:
        case ParityKind.Int(bits, signed):
            if bits == 64 and signed:
                return 1
            if bits == 8 and not signed:
                return 2
            0
        case ParityKind.Name(label):
            if label == "x":
                return 3
            0
        case ParityKind.Pair(a, b):
            if a == 1 and b == 2:
                return 4
            0
        case _: 0

describe "literal payload patterns in compiler code":
    it "accepts unsigned Int(32, false) in hir_verification_decreases_type_valid":
        step("A literal-arm compiler helper: Int(N, false) must match")
        expect(hir_verification_decreases_type_valid(lit_ty(HirTypeKind.Int(32, false)))).to_equal(true)
        expect(hir_verification_decreases_type_valid(lit_ty(HirTypeKind.Int(64, false)))).to_equal(true)

    it "rejects signed and non-integer types in hir_verification_decreases_type_valid":
        expect(hir_verification_decreases_type_valid(lit_ty(HirTypeKind.Int(64, true)))).to_equal(false)
        expect(hir_verification_decreases_type_valid(lit_ty(HirTypeKind.Float(64)))).to_equal(false)

describe "literal and binding payload patterns agree":
    it "classifies every HirTypeKind sample identically":
        step("Int(bits, signed) with bool and int literals, Float(bits) with an int literal")
        var mismatches = 0
        var literal_hits = 0
        for t in hir_parity_samples():
            val a = hir_by_literal(t)
            if a != hir_by_binding(t):
                mismatches = mismatches + 1
            if a != 0:
                literal_hits = literal_hits + 1
        expect(mismatches).to_equal(0)
        # Five samples are listed by a literal arm: Int(64,true), Int(32,false),
        # Int(8,false), Float(64), Float(32). Zero hits would mean no literal arm matched.
        expect(literal_hits).to_equal(5)

    it "classifies every user enum sample identically":
        step("bool, int, text and multi-int literal payloads on a user enum")
        val samples = [ParityKind.Int(64, true), ParityKind.Int(8, false), ParityKind.Int(64, false),
                       ParityKind.Name("x"), ParityKind.Name("y"), ParityKind.Pair(1, 2), ParityKind.Pair(2, 1), ParityKind.Unit]
        var mismatches = 0
        var literal_hits = 0
        for k in samples:
            val a = user_by_literal(k)
            if a != user_by_binding(k):
                mismatches = mismatches + 1
            if a != 0:
                literal_hits = literal_hits + 1
        expect(mismatches).to_equal(0)
        # Int(64,true), Int(8,false), Name("x") and Pair(1,2) are the four literal-arm samples.
        expect(literal_hits).to_equal(4)
