use std.spec
use compiler.hir.hir_codec.{hir_module_decode_reason, hir_codec_header}

# `reason=decode` store self-check refusals must name why decode failed.
describe "hir_module_decode_reason":
    it "names empty, headerless and wrong-header blobs":
        expect(hir_module_decode_reason("")).to_equal("empty")
        expect(hir_module_decode_reason("no newline")).to_equal("no_header_line")
        expect(hir_module_decode_reason("not-a-header\n")).to_equal("header_mismatch len=12")

    it "names the reader failure for a truncated frame":
        val reason = hir_module_decode_reason(hir_codec_header() + "\n")
        expect(reason != "").to_equal(true)
