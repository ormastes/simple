# Every HirSymbol(...) construction must pass generic_param_count explicitly.
# Under staged-native codegen the field default (`= 0`) is not applied to a
# named construction that omits it; the slot stays nil, put_i64 writes `N`, and
# the HIR cache self-check refuses the module (`nil_in_non_optional_scalar`).
# Exact failing shape: a module declaring `struct P: x: i64` or `class K: x: i64`
# (stage2 f9d07913dcc: SELFCHECK FAILED line=496/527 token=N).
# doc/08_tracking/bug/hir_cache_selfcheck_nil_in_non_optional_scalar_2026-10-25.md
use std.spec.*
use std.io_runtime.{file_read}

fn count_of(hay: text, needle: text) -> i64:
    hay.split(needle).len() - 1

fn constructions_covered(path: text) -> bool:
    val src = file_read("src/compiler/" + path)
    val passed = count_of(src, "generic_param_count:") - count_of(src, "generic_param_count: i64")
    passed >= count_of(src, "HirSymbol(")

describe "HirSymbol constructions set generic_param_count":
    it "20.hir sites":
        expect(constructions_covered("20.hir/hir_symbol_table_methods.spl")).to_equal(true)
        expect(constructions_covered("20.hir/hir_types.spl")).to_equal(true)
        expect(constructions_covered("20.hir/nominal_type_relocation.spl")).to_equal(true)

    it "25.traits and 40.mono sites":
        expect(constructions_covered("25.traits/trait_validation.spl")).to_equal(true)
        expect(constructions_covered("40.mono/mono_archive_nominal_v2.spl")).to_equal(true)
        expect(constructions_covered("40.mono/monomorphize_integration.spl")).to_equal(true)

    it "50.mir and 80.driver sites":
        expect(constructions_covered("50.mir/verification_source_environment_v1.spl")).to_equal(true)
        expect(constructions_covered("80.driver/cache/hir_mono_nominal_rewrite_v1.spl")).to_equal(true)
        expect(constructions_covered("80.driver/cache/hir_mono_replay_selection_v1.spl")).to_equal(true)
