# @req: REQ-COMP-HIR-CFG-DECL-001 - HirFunction cfg fields (design hir_cfg_decl_select_design.md)
"""
## Purpose and audience
Purpose: HirFunction cfg guard fields (cfg, cfg_group, cfg_arm) are readable,
preserve identity (affect hir hash), survive codec round-trip, and have correct defaults.
Audience: COMP maintainers.
Plan: doc/05_design/compiler/frontend/hir_cfg_decl_select_design.md (step 1)
"""
use std.spec.{describe, it, expect}
use test.fixtures.compiler.completeness95.hir_cases_v1.{fixture_hir_module_v1}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.*

fn first_function(module: HirModule) -> HirFunction:
    val keys = module.functions.keys()
    module.functions[keys[0]]

describe "HirFunction cfg guard fields":
    it "has cfg, cfg_group, cfg_arm readable with values set":
        var module = fixture_hir_module_v1(false)
        val keys = module.functions.keys()
        var f = module.functions[keys[0]]
        # Mutate the function with cfg fields
        f.cfg = ["os=linux"]
        f.cfg_group = 1
        f.cfg_arm = 0
        module.functions[keys[0]] = f

        val func = first_function(module)
        expect(func.cfg.len()).to_equal(1)
        expect(func.cfg[0]).to_equal("os=linux")
        expect(func.cfg_group).to_equal(1)
        expect(func.cfg_arm).to_equal(0)

    it "has default values: cfg=[], cfg_group=0, cfg_arm=-1":
        val module = fixture_hir_module_v1(false)
        val func = first_function(module)
        expect(func.cfg.len()).to_equal(0)
        expect(func.cfg_group).to_equal(0)
        expect(func.cfg_arm).to_equal(-1)

