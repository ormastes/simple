# Bug: doc/08_tracking/bug/unit_decl_table_name_keyed_2026-11-16.md
# Module A declares `unit Meters`; module B declares `class Meters`. `x as Meters`
# in B resolves to B's CLASS symbol and must not take the unit-construction path.
use std.spec
use compiler.core.types.{unit_decl_register_origin, unit_decl_pool_reset}
use compiler.hir.hir_types.{SymbolKind}
use compiler.hir.hir_lowering._Expressions.unit_cast_target.{unit_cast_symbol_is_unit}

describe "unit cast target resolution":
    it "same-named class in another module is not a unit":
        unit_decl_pool_reset()
        unit_decl_register_origin("Meters", "nominal", "m", 0, "", "")
        expect(unit_cast_symbol_is_unit(SymbolKind.Class, "Meters")).to_equal(false)

    it "the unit's own lowered struct is a unit":
        unit_decl_pool_reset()
        unit_decl_register_origin("Meters", "nominal", "m", 0, "", "")
        expect(unit_cast_symbol_is_unit(SymbolKind.Struct, "Meters")).to_equal(true)

    it "similar patterns: enum, alias, trait of a unit's name are not units":
        unit_decl_pool_reset()
        unit_decl_register_origin("Meters", "nominal", "m", 0, "", "")
        expect(unit_cast_symbol_is_unit(SymbolKind.Enum, "Meters")).to_equal(false)
        expect(unit_cast_symbol_is_unit(SymbolKind.TypeAlias, "Meters")).to_equal(false)
        expect(unit_cast_symbol_is_unit(SymbolKind.Trait, "Meters")).to_equal(false)

    it "a struct with no unit declaration is not a unit":
        unit_decl_pool_reset()
        expect(unit_cast_symbol_is_unit(SymbolKind.Struct, "Meters")).to_equal(false)
