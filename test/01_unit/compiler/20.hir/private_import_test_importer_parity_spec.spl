# Bug: test_private_access_closure_attribution_2026-11-14
#
# The self-hosted HIR's test-importer predicate must answer exactly like the
# seed's `is_test_caller` (interpreter_module/module_loader.rs), which the seed
# uses for the import rule, the call rule and closure attribution. The same
# predicate now also exempts test importers from the opt-in member-visibility
# denials (`record_imported_member_visibility`).
# `private_import_is_test_importer` is a private fn: importing it here is itself
# the owner rule ("test can access private") at work.
use std.spec.{describe, it, expect}
use compiler.hir.hir_lowering._Items.module_import_resolution.{private_import_is_test_importer}

describe "private_import_is_test_importer matches the seed's is_test_caller":
    it "accepts test/ prefixes and /test/ components":
        expect(private_import_is_test_importer("test/01_unit/app/lib_mod_spec.spl")).to_equal(true)
        expect(private_import_is_test_importer("/repo/test/system/lib_mod_spec.spl")).to_equal(true)
        expect(private_import_is_test_importer("test\\01_unit\\app\\lib_mod_spec.spl")).to_equal(true)
        expect(private_import_is_test_importer("./test/01_unit/app/lib_mod_spec.spl")).to_equal(true)

    it "rejects product paths, including test-like names":
        expect(private_import_is_test_importer("zz_fx/src/app/other/main.spl")).to_equal(false)
        expect(private_import_is_test_importer("zz_fx/src/app/contest/main.spl")).to_equal(false)
        expect(private_import_is_test_importer("scripts/check/tool.spl")).to_equal(false)
        expect(private_import_is_test_importer("src/app/test_runner_new/main.spl")).to_equal(false)
