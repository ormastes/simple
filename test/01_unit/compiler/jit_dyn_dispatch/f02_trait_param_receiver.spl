# Trait-typed parameter receiver (the `smf_reader: SmfReader` shape): two
# implementors, method called through the trait-typed parameter.
trait Reader:
    fn lookup(name: text) -> i64:
        pass

struct MemReader(Reader):
    base: i64
    fn lookup(name: text) -> i64: self.base + name.len()

struct FileReader(Reader):
    fn lookup(name: text) -> i64: 1000 + name.len()

fn take(reader: Reader, name: text) -> i64:
    reader.lookup(name)

fn main() -> i64:
    print take(MemReader(base: 5), "abc")
    print take(FileReader(), "abcd")
    0
