# Any-typed receiver whose concrete types all implement one trait: the JIT
# must dispatch `kind()` by the receiver's vtable identity, not bail.
trait Kinded:
    fn kind() -> text:
        pass
    fn weight(n: i64) -> i64:
        pass

struct ShellDef(Kinded):
    fn kind() -> text: "shell"
    fn weight(n: i64) -> i64: n + 1

struct SqlDef(Kinded):
    fn kind() -> text: "sql"
    fn weight(n: i64) -> i64: n * 10

struct JsonDef(Kinded):
    fn kind() -> text: "json"
    fn weight(n: i64) -> i64: n - 1

class Registry:
    names: [text]

    me register(self, block_def: Any):
        val kind = block_def.kind()
        self.names.push(kind)

fn describe(block_def: Any) -> text:
    block_def.kind()

fn weigh(block_def: Any, n: i64) -> i64:
    block_def.weight(n)

fn main() -> i64:
    val reg = Registry(names: [])
    reg.register(ShellDef())
    reg.register(SqlDef())
    reg.register(JsonDef())
    print "{reg.names[0]} {reg.names[1]} {reg.names[2]}"
    print describe(SqlDef())
    print "{weigh(ShellDef(), 4)} {weigh(SqlDef(), 4)} {weigh(JsonDef(), 4)}"
    0
