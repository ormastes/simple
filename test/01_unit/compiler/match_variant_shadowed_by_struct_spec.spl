# Purpose and audience: regression spec for a bare variant arm whose name is also a struct.
# @req REQ-SSPEC-UNIT
# UNEXECUTED: written with the compiler fix; the Stage-2 binary predates the fix, so it was not run.
# Bug: doc/08_tracking/bug/match_variant_pattern_shadowed_by_struct_name_2026-10-24.md

use std.spec

struct Expr:
    kind: i64
    span: i64

enum Kind:
    Expr(v: i64)
    Return(v: i64)
    Other

fn pick(k: Kind) -> i64:
    match k:
        case Expr(e): e
        case Return(e): e + 100
        case _: -1

describe("bare variant arm shadowed by a struct name"):
    it("selects the enum variant, not the struct"):
        assert_equal(pick(Kind.Expr(5)), 5)
        assert_equal(pick(Kind.Return(5)), 105)
        assert_equal(pick(Kind.Other), -1)
