"""
Live HM inference (HmInferContext.infer_binary_op): only `+` concatenates text;
`-`, `*`, `/` on two text operands are type errors.
Run: bin/simple test test/01_unit/compiler/30.types/text_arith_infer_spec.spl
"""

use std.spec.*
use compiler.hir.hir.*
use compiler.types.type_infer_types.{HmInferContext}
use compiler.types.type_infer.context.*
use compiler.types.type_infer.core.*
use compiler.types.type_infer.inference_expr_ops.*

fn _text_op(op: HirBinOp) -> bool:
    var ctx = HmInferContext.new()
    val sp = Span.new(0, 1, 1, 1)
    val t = HirType(kind: HirTypeKind.Str, span: sp)
    match ctx.infer_binary_op(op, t, t, sp):
        case Ok(_): true
        case Err(_): false

describe "text binary operator inference (HM)":
    it "accepts text + text":
        expect(_text_op(HirBinOp.Add)).to_equal(true)
    it "rejects text - text":
        expect(_text_op(HirBinOp.Sub)).to_equal(false)
    it "rejects text * text":
        expect(_text_op(HirBinOp.Mul)).to_equal(false)
    it "rejects text / text":
        expect(_text_op(HirBinOp.Div)).to_equal(false)
