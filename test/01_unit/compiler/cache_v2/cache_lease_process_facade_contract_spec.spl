"""Cache leases must use the canonical process-liveness provider."""

use std.spec.step
use std.io_runtime.{read_file_text}

describe "cache lease process ownership":
    it "routes liveness through the canonical runtime facade":
        step("Load the production lease owner")
        val source = read_file_text("src/compiler/80.driver/cache/lease/lease.spl")
        expect(source).to_contain("if lease.process_id == getpid():")
        expect(source).to_contain("process_is_running(pid)")
        expect(source).to_contain("file_write_exact(path, content)")
        expect(source).to_not_contain("std.file_system.{file_write_text}")
        expect(source).to_not_contain("extern fn rt_process_exists")
        expect(source).to_not_contain("rt_process_exists(pid)")
