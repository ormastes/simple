extern fn rt_file_read_text(path: text) -> text?

describe "action index bounded decode source contract":
    it "does not materialize an array for ignored trailing fields":
        val source = rt_file_read_text("src/compiler/80.driver/cache/action_index/action_index.spl") ?? ""
        val start = source.index_of("fn action_index_read_raw(")
        val finish = source.index_of("fn action_index_serialize(", start)
        expect(start).to_be_greater_than(-1)
        expect(finish).to_be_greater_than(start)
        val body = source.substring(start, finish)
        val compact = body.replace(" ", "").replace("\n", "").replace("\t", "").replace("\r", "")
        # Local names and formatting are intentionally irrelevant.  The owner
        # must retain exactly three delimiter searches, derive four field
        # slices from those bounds, and never recreate a full-field array or a
        # full-content slice.
        expect(compact.count("content.index_of(\"\\n\"")).to_equal(3)
        expect(compact.count("content.substring(")).to_equal(4)
        expect(compact.count("split(")).to_equal(0)
        expect(compact.contains("content.substring(0,content.len())")).to_equal(false)
