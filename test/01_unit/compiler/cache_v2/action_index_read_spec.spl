use compiler.driver.cache.action_index.action_index.{
    CacheNamespace, action_index_path, action_index_read_raw
}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_getpid() -> i64
extern fn rt_time_now_unix_micros() -> i64

fn fixture_root(tag: text) -> text:
    "/tmp/action_index_read_spec_{tag}_{rt_getpid()}_{rt_time_now_unix_micros()}"

fn write_entry(root: text, action: text, content: text):
    val path = action_index_path(root, CacheNamespace.WorkspaceLocal, action)
    val slash = path.last_index_of("/")
    expect(rt_dir_create_all(path.substring(0, slash))).to_equal(true)
    expect(rt_file_write_text(path, content)).to_equal(true)

describe "action index bounded decoder":
    it "reads the digest with and without a trailing newline":
        val action = "abcdef"
        val root_plain = fixture_root("plain")
        write_entry(root_plain, action, "simple-action-index-v1\nabcdef\nresult")
        expect(action_index_read_raw(root_plain, CacheNamespace.WorkspaceLocal, action)).to_equal("result")

        val root_newline = fixture_root("newline")
        write_entry(root_newline, action, "simple-action-index-v1\nabcdef\nresult\n")
        expect(action_index_read_raw(root_newline, CacheNamespace.WorkspaceLocal, action)).to_equal("result")

    it "preserves empty result and ignores all later fields":
        val action = "abcdef"
        val root_empty = fixture_root("empty")
        write_entry(root_empty, action, "simple-action-index-v1\nabcdef\n")
        expect(action_index_read_raw(root_empty, CacheNamespace.WorkspaceLocal, action)).to_equal("")

        val root_extra = fixture_root("extra")
        write_entry(root_extra, action, "simple-action-index-v1\nabcdef\nresult\nignored\nfields")
        expect(action_index_read_raw(root_extra, CacheNamespace.WorkspaceLocal, action)).to_equal("result")

        val root_empty_extra = fixture_root("empty_extra")
        write_entry(root_empty_extra, action, "simple-action-index-v1\nabcdef\n\nignored")
        expect(action_index_read_raw(root_empty_extra, CacheNamespace.WorkspaceLocal, action)).to_equal("")

    it "preserves every byte of the result field":
        val action = "abcdef"
        val cases = ["  padded  ", "result\r", "héllo-世界"]
        var i = 0
        for digest in cases:
            val root = fixture_root("bytes_{i}")
            write_entry(root, action, "simple-action-index-v1\nabcdef\n{digest}\nignored")
            expect(action_index_read_raw(root, CacheNamespace.WorkspaceLocal, action)).to_equal(digest)
            i = i + 1

    it "rejects every truncated or mismatched prefix":
        val action = "abcdef"
        val malformed = [
            "",
            "simple-action-index-v1",
            "simple-action-index-v1\n",
            "simple-action-index-v1\n\nresult",
            "simple-action-index-v1\nabcdef",
            "wrong-header\nabcdef\nresult",
            " simple-action-index-v1\nabcdef\nresult",
            "simple-action-index-v1 \nabcdef\nresult",
            "simple-action-index-v1\r\nabcdef\nresult",
            "simple-action-index-v1-extra\nabcdef\nresult",
            "simple-action-index-v\nabcdef\nresult",
            "simple-action-index-v1\nwrong-action\nresult",
            "simple-action-index-v1\n abcdef\nresult",
            "simple-action-index-v1\nabcdef \nresult",
            "simple-action-index-v1\nabcdef\r\nresult",
            "simple-action-index-v1\nabcdef-extra\nresult",
            "simple-action-index-v1\nabcde\nresult",
            "simple-action-index-v1\nhéllo-世界\nresult"
        ]
        var i = 0
        for content in malformed:
            val root = fixture_root("bad_{i}")
            write_entry(root, action, content)
            expect(action_index_read_raw(root, CacheNamespace.WorkspaceLocal, action)).to_be_nil()
            i = i + 1
