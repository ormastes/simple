"""Fresh leases must round-trip through the active-root listing."""

use std.spec.step
use compiler.driver.cache.cas_store.{cas_open}
use compiler.driver.cache.lease.lease.{lease_acquire, lease_list_active}
use std.io_runtime.{dir_remove_all, getpid, time_now_unix_micros}

describe "cache lease active round trip":
    it "lists a lease acquired by the current process":
        val root = "build/cache_lease_roundtrip_{getpid()}_{time_now_unix_micros()}"
        step("Create a cache and acquire one manifest lease")
        cas_open(root)
        val acquired = lease_acquire(root, ["manifest-xyz"], [])
        expect(acquired == nil).to_equal(false)

        step("Read the active lease set through the production parser and liveness facade")
        val active = lease_list_active(root)
        expect(active.len()).to_equal(1)
        if active.len() == 1:
            expect(active[0].referenced_manifests).to_contain("manifest-xyz")
        dir_remove_all(root)
