"""Cache admission uses canonical one-call traversal and size providers."""

use std.spec.step
use std.io_runtime.{read_file_text}

describe "cache admission I/O ownership":
    it "preserves missing-size semantics without local runtime hooks":
        step("Load the production admission source")
        val source = read_file_text("src/compiler/80.driver/cache/gc/admission.spl")
        expect(source).to_contain("use std.io_runtime.{dir_exists, dir_walk, file_exists}")
        expect(source).to_contain("file_size_signed(path)")
        expect(source).to_contain("if size >= 0:")
        expect(source).to_not_contain("extern fn rt_file_size")
        expect(source).to_not_contain("extern fn rt_dir_walk")
