# CI promotion gateway specification (Agent C9, slice 1).
#
"""
As a release engineer, I need the promotion gateway CI runs before anything
reaches the trusted remote-main cache to approve only requests that satisfy
every remote-main eligibility rule, and to tell me by NAME which rule a
rejected request broke — so a promotion failure is diagnosable instead of a
bare boolean, and a malformed or absent request can never read as approval.

Plan: doc/03_plan/compiler/cache/semantic_incremental_build_v2_plan_2026-08-09.md (C9)
Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §15
"""
#
# The validation functions are driven DIRECTLY (no subprocess), with a local
# fake ancestry oracle, so no test depends on real repo state or the network.
#
# **Feature IDs:** #CACHEV2-GATEWAY-001 to #CACHEV2-GATEWAY-004

use compiler.driver.cache.promotion.promotion_receipt.{PromotionReceipt}
use compiler.driver.cache.promotion.git_ancestry.{MainSnapshot, GitAncestryOracle}
use app.cache_gateway.request.{PromotionRequest, RequestParse, parse_promotion_request}
use app.cache_gateway.validate.{
    GatewayVerdict, validate_promotion, gateway_verdict_line, gateway_exit_code
}

val NOW: i64 = 2000000000
val ON_MAIN_COMMIT: text = "1111111111111111111111111111111111111111"
val OFF_MAIN_COMMIT: text = "2222222222222222222222222222222222222222"
val MAIN_TIP: text = "3333333333333333333333333333333333333333"

# ============================================================================
# Fake ancestry oracle — local only, no git, no network.
# ============================================================================

struct FakeOracle:
    snapshot: MainSnapshot
    ancestors: [text]

impl GitAncestryOracle for FakeOracle:
    fn fetch_main_snapshot() -> MainSnapshot:
        self.snapshot

    fn is_ancestor(commit: text, snapshot: MainSnapshot) -> bool:
        val _ = snapshot
        for c in self.ancestors:
            if c == commit:
                return true
        false

fn fresh_oracle() -> FakeOracle:
    FakeOracle(
        snapshot: MainSnapshot(
            remote_url: "https://example.invalid/repo.git",
            repository_id: "repo-id-digest",
            ref_name: "refs/remotes/origin/main",
            tip_commit: MAIN_TIP,
            fetched_at_unix_micros: NOW - 1000,
            fetch_authenticated: true
        ),
        ancestors: [ON_MAIN_COMMIT]
    )

# ============================================================================
# Request fixtures, built as real SDN text and decoded through the real
# parser — never hand-constructed structs, so a decode regression is caught.
# ============================================================================

fn request_sdn(commit: text, attestation_block: text) -> text:
    "receipt:\n" +
    "  repository_id: \"repo-id-digest\"\n" +
    "  source_commit: \"{commit}\"\n" +
    "  source_tree: \"tree-digest\"\n" +
    "  trusted_ref: \"refs/remotes/origin/main\"\n" +
    "  trusted_ref_tip: \"{MAIN_TIP}\"\n" +
    "  clean_tree_digest: \"clean-digest\"\n" +
    "  action_digest: \"action-digest\"\n" +
    "  result_manifest_digest: \"manifest-digest\"\n" +
    "  builder_id: \"trusted-main-ci\"\n" +
    "  workflow_digest: \"workflow-digest\"\n" +
    "  toolchain_digest: \"toolchain-digest\"\n" +
    "  external_parameters_digest: \"params-digest\"\n" +
    "  timestamp: 1000\n" +
    "  signature: \"sig-bytes\"\n" +
    attestation_block +
    "closure:\n" +
    "  digests: [\"blob-a\", \"blob-b\"]\n"

fn full_attestation() -> text:
    "attestation:\n" +
    "  ci_run_id: \"run-4711\"\n" +
    "  ci_builder_id: \"trusted-main-ci\"\n" +
    "  ci_workflow_ref: \"refs/heads/main\"\n" +
    "  required_checks_passed: true\n"

# No ci_run_id / ci_builder_id: the run is not attested at all.
fn missing_attestation() -> text:
    "attestation:\n" +
    "  ci_workflow_ref: \"refs/heads/main\"\n" +
    "  required_checks_passed: true\n"

fn decode(source: text) -> PromotionRequest:
    match parse_promotion_request(source):
        case RequestParse.Parsed(req):
            req
        case RequestParse.Invalid(reason):
            panic("fixture failed to decode: {reason}")

fn verdict_of(source: text) -> GatewayVerdict:
    validate_promotion(decode(source), fresh_oracle(), NOW)

describe "cache promotion gateway":

    it "approves a fully attested request for a commit on main":
        # @req REQ-CACHEV2-GATEWAY-001
        val verdict = verdict_of(request_sdn(ON_MAIN_COMMIT, full_attestation()))
        assert_equal(gateway_verdict_line(verdict, 1), "PASS — promoted 1")
        assert_equal(gateway_exit_code(verdict), 0)

    it "rejects a request whose CI attestation is missing, naming the rule":
        # @req REQ-CACHEV2-GATEWAY-002
        val verdict = verdict_of(request_sdn(ON_MAIN_COMMIT, missing_attestation()))
        assert_equal(gateway_verdict_line(verdict, 0), "FAIL — trusted_ci_builder_and_protected_workflow")
        assert_equal(gateway_exit_code(verdict), 1)

    it "rejects a receipt for a commit that is not on main":
        # @req REQ-CACHEV2-GATEWAY-003
        val verdict = verdict_of(request_sdn(OFF_MAIN_COMMIT, full_attestation()))
        assert_equal(gateway_verdict_line(verdict, 0), "FAIL — source_commit_reachable_from_snapshot")
        assert_equal(gateway_exit_code(verdict), 1)

    it "reports ERROR rather than approval when there is nothing to check":
        # @req REQ-CACHEV2-GATEWAY-004
        # An empty request directory yields an empty request body; an absent
        # file yields no body at all. Both must fail closed, never PASS.
        match parse_promotion_request(""):
            case RequestParse.Parsed(_):
                assert_true(false)
            case RequestParse.Invalid(reason):
                assert_equal(reason, "empty request")
        val err = GatewayVerdict.Errored("empty request")
        assert_equal(gateway_exit_code(err), 2)
        assert_contains(gateway_verdict_line(err, 0), "ERROR — nothing was checked")

    it "rejects unparsable and receipt-less requests rather than approving them":
        # @req REQ-CACHEV2-GATEWAY-004
        match parse_promotion_request("closure:\n  digests: [\"blob-a\"]\n"):
            case RequestParse.Parsed(_):
                assert_true(false)
            case RequestParse.Invalid(reason):
                assert_contains(reason, "no receipt.source_commit")
