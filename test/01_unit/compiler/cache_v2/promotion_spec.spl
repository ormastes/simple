# Remote-main promotion policy specification (Agent C2).
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md
# §15 (remote-main admission and branch promotion).
#
# Covers:
#  - each §15.1 eligibility condition failing individually is reported as
#    that specific condition (not a generic boolean),
#  - the §15.3 merge-strategy table row by row via a local fake ancestry
#    oracle (no dependency on real repo state),
#  - dirty worktree / clean developer branch can never write remote-main,
#  - a stale or unauthenticated origin/main snapshot is rejected even when
#    the raw ancestry bit would say "reachable".
#
# **Feature IDs:** #CACHEV2-PROMOTION-001 to #CACHEV2-PROMOTION-004

use compiler.driver.cache.promotion.promotion_receipt.{PromotionReceipt}
use compiler.driver.cache.promotion.eligibility.{
    EligibilityCondition, EligibilityInput, EligibilityResult,
    eligibility_check, eligibility_input_all_pass
}
use compiler.driver.cache.promotion.git_ancestry.{
    MainSnapshot, GitAncestryOracle, AncestryCheckResult,
    snapshot_is_fresh, check_commit_reachable_from_main
}
use compiler.driver.cache.remote.remote_policy.{
    ProducerClass, remote_read_main_allowed, remote_write_branch_allowed,
    remote_write_main_allowed, developer_machine_write_main_is_always_false
}

fn sample_receipt() -> PromotionReceipt:
    PromotionReceipt(
        repository_id: "repo-digest",
        source_commit: "commit-abc",
        source_tree: "tree-abc",
        trusted_ref: "refs/remotes/origin/main",
        trusted_ref_tip: "commit-main-tip",
        clean_tree_digest: "clean-digest",
        action_digest: "action-digest",
        result_manifest_digest: "manifest-digest",
        builder_id: "trusted-ci",
        workflow_digest: "workflow-digest",
        toolchain_digest: "toolchain-digest",
        external_parameters_digest: "params-digest",
        timestamp: 1000,
        signature: "sig-bytes"
    )

# ============================================================================
# Fake ancestry oracle — no real git/repo dependency.
# ============================================================================

struct FakeAncestryOracle:
    snapshot: MainSnapshot
    ancestors: [text]   # commits this fake considers reachable from `snapshot`

impl GitAncestryOracle for FakeAncestryOracle:
    fn fetch_main_snapshot() -> MainSnapshot:
        self.snapshot

    fn is_ancestor(commit: text, snapshot: MainSnapshot) -> bool:
        val _ = snapshot
        for c in self.ancestors:
            if c == commit:
                return true
        false

fn fresh_snapshot(now: i64) -> MainSnapshot:
    MainSnapshot(
        remote_url: "https://example.invalid/repo.git",
        repository_id: "repo-digest",
        ref_name: "refs/remotes/origin/main",
        tip_commit: "commit-main-tip",
        fetched_at_unix_micros: now,
        fetch_authenticated: true
    )

fn stale_snapshot(now: i64) -> MainSnapshot:
    MainSnapshot(
        remote_url: "https://example.invalid/repo.git",
        repository_id: "repo-digest",
        ref_name: "refs/remotes/origin/main",
        tip_commit: "commit-main-tip",
        fetched_at_unix_micros: now - (60 * 60 * 1000000),
        fetch_authenticated: true
    )

fn unauthenticated_snapshot(now: i64) -> MainSnapshot:
    MainSnapshot(
        remote_url: "https://example.invalid/repo.git",
        repository_id: "repo-digest",
        ref_name: "refs/remotes/origin/main",
        tip_commit: "commit-main-tip",
        fetched_at_unix_micros: now,
        fetch_authenticated: false
    )

describe "Eligibility gate (§15.1)":
    it "accepts an input where every condition passes":
        val input = eligibility_input_all_pass(sample_receipt())
        val result = eligibility_check(input)
        match result:
            case EligibilityResult.Eligible:
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects a dirty tree as CleanSourceTree":
        var input = eligibility_input_all_pass(sample_receipt())
        input.clean_tree = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.CleanSourceTree):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects a non-exact commit as ExactImmutableSourceCommit":
        var input = eligibility_input_all_pass(sample_receipt())
        input.exact_commit_pinned = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.ExactImmutableSourceCommit):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects unauthenticated repository identity":
        var input = eligibility_input_all_pass(sample_receipt())
        input.repository_identity_authenticated = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.AuthenticatedRepositoryIdentity):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects an untrusted origin/main snapshot":
        var input = eligibility_input_all_pass(sample_receipt())
        input.origin_main_snapshot_trusted = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.TrustedOriginMainSnapshot):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects a stale origin/main snapshot even if marked trusted":
        var input = eligibility_input_all_pass(sample_receipt())
        input.origin_main_snapshot_fresh = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.TrustedOriginMainSnapshot):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects a commit not reachable from the snapshot":
        var input = eligibility_input_all_pass(sample_receipt())
        input.commit_reachable_from_snapshot = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.SourceCommitReachableFromSnapshot):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects an untrusted CI builder":
        var input = eligibility_input_all_pass(sample_receipt())
        input.builder_is_trusted_ci = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.TrustedCiBuilderAndProtectedWorkflow):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects an unprotected workflow":
        var input = eligibility_input_all_pass(sample_receipt())
        input.workflow_is_protected = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.TrustedCiBuilderAndProtectedWorkflow):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects non-hermetic/undeclared inputs":
        var input = eligibility_input_all_pass(sample_receipt())
        input.inputs_are_hermetic_and_declared = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.HermeticDeclaredActionInputs):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects unverified manifest/artifacts":
        var input = eligibility_input_all_pass(sample_receipt())
        input.manifest_and_artifacts_strictly_verified = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.StrictManifestAndArtifactVerification):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects when required tests/proofs did not pass":
        var input = eligibility_input_all_pass(sample_receipt())
        input.required_tests_or_proofs_passed = false
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.SuccessfulRequiredTestsOrProofs):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects a missing receipt":
        var input = eligibility_input_all_pass(sample_receipt())
        input.receipt = nil
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.SignedPromotionReceipt):
                assert_true(true)
            case _:
                assert_true(false)

    it "rejects an unsigned receipt":
        var input = eligibility_input_all_pass(sample_receipt())
        var r = sample_receipt()
        r.signature = ""
        input.receipt = r
        match eligibility_check(input):
            case EligibilityResult.Rejected(EligibilityCondition.SignedPromotionReceipt):
                assert_true(true)
            case _:
                assert_true(false)

describe "Merge strategy consequences (§15.3), via a local fake ancestry oracle":
    it "fast-forward merge: branch tip reachable -> promotable":
        val now: i64 = 10000000
        val oracle = FakeAncestryOracle(snapshot: fresh_snapshot(now), ancestors: ["commit-ff"])
        val result = check_commit_reachable_from_main(oracle, "commit-ff", now)
        assert_true(result.reachable)

    it "normal merge commit: branch tip reachable -> promotable":
        val now: i64 = 10000000
        val oracle = FakeAncestryOracle(snapshot: fresh_snapshot(now), ancestors: ["commit-merge"])
        val result = check_commit_reachable_from_main(oracle, "commit-merge", now)
        assert_true(result.reachable)

    it "rebase-then-fast-forward: OLD branch commit not reachable -> not promotable":
        val now: i64 = 10000000
        val oracle = FakeAncestryOracle(snapshot: fresh_snapshot(now), ancestors: ["commit-rebased-new"])
        val result = check_commit_reachable_from_main(oracle, "commit-old-branch-tip", now)
        assert_false(result.reachable)

    it "squash merge: original branch commit not reachable -> not promotable":
        val now: i64 = 10000000
        val oracle = FakeAncestryOracle(snapshot: fresh_snapshot(now), ancestors: ["commit-squash-result"])
        val result = check_commit_reachable_from_main(oracle, "commit-original-branch-tip", now)
        assert_false(result.reachable)

    it "cherry-pick: original commit not reachable -> not promotable":
        val now: i64 = 10000000
        val oracle = FakeAncestryOracle(snapshot: fresh_snapshot(now), ancestors: ["commit-cherry-picked"])
        val result = check_commit_reachable_from_main(oracle, "commit-original", now)
        assert_false(result.reachable)

    it "force-pushed main removing the commit: not reachable in new snapshot -> not promotable":
        val now: i64 = 10000000
        val oracle = FakeAncestryOracle(snapshot: fresh_snapshot(now), ancestors: ["commit-new-main-tip"])
        val result = check_commit_reachable_from_main(oracle, "commit-removed-by-force-push", now)
        assert_false(result.reachable)

describe "Stale/unauthenticated snapshot cannot authorize promotion (§15.1)":
    it "rejects even a truly-ancestor commit when the snapshot is stale":
        val now: i64 = 100000000
        val oracle = FakeAncestryOracle(snapshot: stale_snapshot(now), ancestors: ["commit-real-ancestor"])
        val result = check_commit_reachable_from_main(oracle, "commit-real-ancestor", now)
        assert_false(result.reachable)
        assert_false(result.snapshot_fresh)

    it "rejects an unauthenticated fetch even if timestamp looks fresh":
        val now: i64 = 100000000
        val oracle = FakeAncestryOracle(snapshot: unauthenticated_snapshot(now), ancestors: ["commit-real-ancestor"])
        val result = check_commit_reachable_from_main(oracle, "commit-real-ancestor", now)
        assert_false(result.reachable)

    it "snapshot_is_fresh is false for a snapshot older than the max age":
        val now: i64 = 100000000
        val snap = stale_snapshot(now)
        assert_false(snapshot_is_fresh(snap, now))

    it "snapshot_is_fresh is true for a just-fetched authenticated snapshot":
        val now: i64 = 100000000
        val snap = fresh_snapshot(now)
        assert_true(snapshot_is_fresh(snap, now))

describe "Remote read/write policy matrix (§15.4)":
    it "dirty developer worktree cannot write remote-main":
        assert_false(remote_write_main_allowed(ProducerClass.DirtyDeveloperWorktree))

    it "clean developer branch cannot write remote-main":
        assert_false(remote_write_main_allowed(ProducerClass.CleanDeveloperBranch))

    it "untrusted PR/fork cannot write remote-main":
        assert_false(remote_write_main_allowed(ProducerClass.UntrustedPullRequestOrFork))

    it "trusted branch CI cannot write remote-main":
        assert_false(remote_write_main_allowed(ProducerClass.TrustedBranchCi))

    it "trusted main CI CAN write remote-main":
        assert_true(remote_write_main_allowed(ProducerClass.TrustedMainCi))

    it "release CI CAN write remote-main":
        assert_true(remote_write_main_allowed(ProducerClass.ReleaseCi))

    it "every producer class can read remote-main":
        assert_true(remote_read_main_allowed(ProducerClass.DirtyDeveloperWorktree))
        assert_true(remote_read_main_allowed(ProducerClass.CleanDeveloperBranch))
        assert_true(remote_read_main_allowed(ProducerClass.UntrustedPullRequestOrFork))
        assert_true(remote_read_main_allowed(ProducerClass.TrustedBranchCi))
        assert_true(remote_read_main_allowed(ProducerClass.TrustedMainCi))
        assert_true(remote_read_main_allowed(ProducerClass.ReleaseCi))

    it "only trusted branch CI can write the branch namespace":
        assert_true(remote_write_branch_allowed(ProducerClass.TrustedBranchCi))
        assert_false(remote_write_branch_allowed(ProducerClass.DirtyDeveloperWorktree))
        assert_false(remote_write_branch_allowed(ProducerClass.CleanDeveloperBranch))
        assert_false(remote_write_branch_allowed(ProducerClass.TrustedMainCi))

    it "the unconditional developer-machine guard holds for both developer classes":
        assert_true(developer_machine_write_main_is_always_false(ProducerClass.DirtyDeveloperWorktree))
        assert_true(developer_machine_write_main_is_always_false(ProducerClass.CleanDeveloperBranch))
