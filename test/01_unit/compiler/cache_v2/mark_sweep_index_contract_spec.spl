"""Full cache GC indexes roots and marked artifact paths exactly once."""

use std.spec.step
use std.io_runtime.{read_file_text}

describe "mark-and-sweep indexed membership":
    it "uses exact sets and a production move owner":
        step("Load the production full-GC source")
        val source = read_file_text("src/compiler/80.driver/cache/gc/mark_sweep.spl")
        expect(source).to_contain("reader_pin_gc_authoritative_delete_available()")
        expect(source).to_contain("var seen: Dict<text, bool> = {}")
        expect(source).to_contain("var marked_artifact_paths: Dict<text, bool> = {}")
        expect(source).to_contain("if not marked_artifact_paths.contains_key(blob_path):")
        expect(source).to_contain("file_move_cross_device(old_path, new_path)")
        expect(source).to_not_contain("for digest in marked_artifacts:")
        expect(source).to_not_contain("use std.file_system")
        expect(source).to_not_contain("extern fn rt_dir_walk")
