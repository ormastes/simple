# Regression spec: the negation link and the paren-less nil matcher in a BDD
# matcher chain must lower to a real `rt_bdd_expect_*` assertion.
#
# Surface bug (suite4, 2026-08-31): 43 coverage wrappers failed native compile
# with
#   HIR lowering: Unsupported feature: cannot infer field type while lowering
#   main: struct 'Void' field 'not'          (39 wrappers)
#   ... struct 'Void' field 'to_be_nil'      (4 wrappers)
#
# Cause: `try_lower_bdd_matcher_statement` only destructured
# `MethodCall { receiver: Call(expect, [x]), .. }` with a comparison matcher.
#   - `expect(x).not.to_contain(y)` arrives as a MethodCall whose RECEIVER is
#     `FieldAccess { Call(expect), "not" }` — the peel was missing, so the
#     `.not` field access fell through to generic lowering and asked for field
#     `not` on `expect()`'s Void return type.
#   - `expect(x).to_be_nil` arrives as a bare `FieldAccess`, which the function
#     never matched at all.
#
# Acceptance (native compile, `bin/simple compile <this file>`):
#   pre-fix  rc=1 with the two diagnostics above
#   post-fix rc=0 and all four examples pass.
#
# Each example is a discriminator, not a tautology: if the negation link were
# dropped rather than honoured, `not.to_contain("zzz")` and `to_not_be_nil`
# would evaluate their positive form and FAIL.

describe "negated matcher chain lowers to a real assertion":
    it "not.to_contain is honoured":
        val s = "hello world"
        expect(s).not.to_contain("zzz")

    it "to_contain still asserts positively":
        val s = "hello world"
        expect(s).to_contain("world")

    it "to_be_nil paren-less":
        val v = nil
        expect(v).to_be_nil

    it "to_not_be_nil is the negated arg-less form":
        expect("present").to_not_be_nil
