#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
canonical="$repo_root/test/01_unit/compiler/stats_bug_schema_spec.spl"
mirror="$repo_root/test/unit/compiler/stats_bug_schema_spec.spl"

check_spec() {
    spec=$1
    if grep -q '/home/ormastes/dev/pub/simple' "$spec"; then
        return 1
    fi
    grep -q 'val repo_root = cwd()' "$spec" || return 1
    grep -q 'stats_schema_simple_bin(repo_root)' "$spec" || return 1
    grep -q 'stats_schema_simple_src(repo_root)' "$spec" || return 1
    grep -q 'shell("cd {stats_schema_shell_quote(root)} && SIMPLE_LIB=' "$spec" || return 1
    grep -q 'stats_schema_shell_quote(simple_src)' "$spec" || return 1
    grep -q 'stats_schema_shell_quote(simple_bin)' "$spec" || return 1
    grep -q 'stats_schema_shell_quote(script_path)' "$spec" || return 1
    grep -q 'rm -rf -- {stats_schema_shell_quote(root)}' "$spec" || return 1
    grep -q "/tmp/simple repo/owner's tree" "$spec" || return 1
    grep -Fq 'value.replace(' "$spec" || return 1
    grep -Fq "to_equal(\"'/tmp/simple repo/owner'" "$spec" || return 1
}

check_spec "$canonical"
check_spec "$mirror"
cmp -s "$canonical" "$mirror"

mutation_root=$(mktemp -d)
trap 'rm -rf "$mutation_root"' EXIT HUP INT TERM
legacy_mutant="$mutation_root/legacy.spl"
sed 's/val repo_root = cwd()/val repo_root = "\/home\/ormastes\/dev\/pub\/simple"/' "$canonical" > "$legacy_mutant"
if check_spec "$legacy_mutant"; then
    echo "error: accepted legacy-root mutant" >&2
    exit 1
fi

unquoted_mutant="$mutation_root/unquoted.spl"
sed 's/{stats_schema_shell_quote(simple_bin)}/{simple_bin}/' "$canonical" > "$unquoted_mutant"
if check_spec "$unquoted_mutant"; then
    echo "error: accepted unquoted-path mutant" >&2
    exit 1
fi

unquoted_root_mutant="$mutation_root/unquoted_root.spl"
sed 's/cd {stats_schema_shell_quote(root)}/cd {root}/' "$canonical" > "$unquoted_root_mutant"
if check_spec "$unquoted_root_mutant"; then
    echo "error: accepted unquoted subprocess-root mutant" >&2
    exit 1
fi

broken_escape_mutant="$mutation_root/broken_escape.spl"
sed 's/value\.replace/value/' "$canonical" > "$broken_escape_mutant"
if check_spec "$broken_escape_mutant"; then
    echo "error: accepted broken apostrophe-escape mutant" >&2
    exit 1
fi

echo "stats bug schema path contract: PASS"
