use std.spec

extern fn rt_file_read_text(path: text) -> text

describe "compiler coverage probe source contract":
    it "pins LLVM coverage routing, fail-closed validation, and the core-C owner":
        val llvm = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_translate_expr.spl") ?? ""
        val declarations = rt_file_read_text("src/compiler/70.backend/backend/llvm_lib_translate.spl") ?? ""
        val text_llvm = rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl") ?? ""
        val text_declarations = rt_file_read_text("src/compiler/70.backend/backend/_MirToLlvm/asm_constraints_helpers.spl") ?? ""
        val wrappers = rt_file_read_text("src/lib/nogc_sync_mut/io/coverage_simple.spl") ?? ""
        val runner = rt_file_read_text("src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl") ?? ""
        val driver = rt_file_read_text("src/compiler/80.driver/driver.spl") ?? ""
        val core_runtime = rt_file_read_text("src/runtime/runtime_coverage_core.c") ?? ""
        val capsule = rt_file_read_text("scripts/check/build-core-c-bootstrap-runtime-capsule.shs") ?? ""
        val runtime_compiler = rt_file_read_text("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        val mir_lowering = rt_file_read_text("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

        expect(llvm).to_contain("coverage_runtime_name = \"rt_coverage_decision_probe\"")
        expect(llvm).to_contain("coverage_runtime_name = \"rt_coverage_condition_probe\"")
        expect(llvm).to_contain("panic(\"[llvm-lib] malformed {name} intrinsic\")")
        expect(llvm.contains("rt_string_data")).to_equal(false)
        expect(declarations).to_contain("[i32_ty, i1_ty, ptr_ty, i32_ty, i32_ty]")
        expect(declarations).to_contain("[i32_ty, i32_ty, i1_ty, ptr_ty, i32_ty, i32_ty]")
        expect(declarations).to_contain("\"rt_coverage_enabled\", llvm_function_type(i1_ty, [], false)")
        expect(declarations).to_contain("\"rt_coverage_dump_sdn\", llvm_function_type(ptr_ty, [], false)")
        expect(declarations).to_contain("\"rt_coverage_free_sdn\", llvm_function_type(void_ty, [ptr_ty], false)")
        expect(text_llvm).to_contain("self.emit_coverage_probe_intrinsic(dest, name, args)")
        expect(text_llvm).to_contain("panic(\"compile error: malformed coverage probe intrinsic {name}\")")
        expect(text_llvm).to_contain("call void @{runtime_name}")
        expect(text_declarations).to_contain("declare void @rt_coverage_decision_probe(i32, i1, ptr, i32, i32)")
        expect(text_declarations).to_contain("declare void @rt_coverage_condition_probe(i32, i32, i1, ptr, i32, i32)")
        expect(text_declarations).to_contain("declare i1 @rt_coverage_enabled()")
        expect(text_declarations).to_contain("declare void @rt_coverage_clear()")
        expect(text_declarations).to_contain("declare ptr @rt_coverage_dump_sdn()")
        expect(text_declarations).to_contain("declare void @rt_coverage_free_sdn(ptr)")
        expect(wrappers).to_contain("val file_z = file + \"\\0\"")
        expect(wrappers).to_contain("fn coverage_condition_for_decision")
        expect(runner).to_contain("if options.coverage:\n        return run_test_file_native(file_path, options)")
        expect(runner).to_contain("\"native-build\", \"--backend\", \"llvm\"")
        expect(runner).to_contain("val run_binary = if options.coverage: smf_path else: binary")
        expect(runner).to_contain("var run_args: [text] = if options.coverage: [] else: [smf_path]")
        expect(runner).to_contain("cleanup_native_generated_files(smf_path, source_path, wrapped_path, cleanup_path, file_path, options.keep_artifacts)")
        expect(driver).to_contain("coverage instrumentation requires LLVM native execution")
        expect(driver).to_contain("coverage instrumentation requires the LLVM backend")
        expect(driver).to_contain("coverage instrumentation requires an explicit LLVM backend")
        expect(core_runtime).to_contain("void rt_coverage_decision_probe")
        expect(core_runtime).to_contain("void rt_coverage_condition_probe")
        expect(core_runtime).to_contain("INIT_ONCE g_coverage_lock_once")
        expect(core_runtime).to_contain("coverage_mul_size")
        expect(core_runtime).to_contain("if (*p == '%') escape = \"%25\"")
        expect(capsule).to_contain("runtime_coverage_core.c")
        expect(capsule).to_contain("runtime-coverage-core-selfcheck.receipt")
        expect(runtime_compiler).to_contain("\"runtime_coverage_core\"")
        expect(runtime_compiler).to_contain("{object_prefix}runtime_coverage_core{ext}")
        expect(mir_lowering).to_contain("file.replace(\"%\", \"%25\").replace(\",\", \"%2C\")")
        expect(mir_lowering).to_contain("MirConstValue.Str(self.coverage_file())")
