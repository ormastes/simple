# @req: REQ-COMP-MIR-CFG-TARGET-SELECT-001
# bug: doc/08_tracking/bug/seed_cfg_strip_ignores_compound_arch_cfg_2026-11-20.md
"""
## Purpose and audience
Purpose: Regression spec for the seed (Rust) cfg_strip compound arch `@cfg` parity.
`@cfg(not(x86_64 or x86))` is evaluated identically by pure Simple (mir_cfg_select)
and by the seed's `cfg_compound_arch_verdict` in `cfg_strip.rs`.
Audience: COMP / seed maintainers.
"""
use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}
use compiler.common.mir_target_context.{MirTargetContext}
use compiler.mir.mir_cfg_select.{mir_cfg_eval_for_target}

fn tgt(arch: text) -> MirTargetContext:
    MirTargetContext(arch: arch, os: "simpleos", abi: "gnu", backend: "llvm", version: 1)

describe "compound arch @cfg parity (seed vs pure Simple)":
    it "pure Simple evaluates not(x86_64 or x86) per target":
        step("mir_cfg_eval_for_target handles not/or")
        val none: [text] = []
        expect(mir_cfg_eval_for_target("not (x86_64 or x86)", tgt("x86_64"), none).value).to_equal(false)
        expect(mir_cfg_eval_for_target("not (x86_64 or x86)", tgt("riscv64"), none).value).to_equal(true)

    it "seed cfg_attr_arch_verdict handles or/and inside not":
        step("cfg_strip.rs delegates to cfg_compound_arch_verdict for not/or/and/all/any")
        val src = file_read_text("src/compiler_rust/compiler/src/pipeline/cfg_strip.rs")
        expect(src.contains("cfg_compound_arch_verdict")).to_equal(true)
