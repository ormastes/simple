# Fixture (not a collected spec): std.spec wrappers that call `it` from
# inside spec.spl must keep the DSL. "a" fails on purpose where it runs.
# Review repro for seed_same_name_fn_binding_2026-11-27.
use std.spec.{skip_on_linux, skip_on_windows}
describe "wrap":
    skip_on_linux "a", fn():
        expect(1).to_equal(2)
    it "b":
        expect(1).to_equal(1)
