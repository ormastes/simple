# Fixture, error case: declares `same_name(a, b: text)` and imports delta's
# `same_name(a: text, b)`. ("x", "y") fits both equally -> compile error.
use same_name_delta.{same_name}

pub fn same_name(a, b: text) -> text:
    "gamma:" + b

pub fn gamma_calls_ambiguous() -> text:
    same_name("x", "y")
