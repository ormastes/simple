# A spec file's own function named like a spec-DSL word (`context`) is that
# file's function: the DSL must not intercept the call and yield nil.
# Bug: doc/08_tracking/bug/seed_same_name_fn_binding_2026-11-27.md (form 2).
use std.spec

struct CtxBox:
    v: i64

fn context(v: i64) -> CtxBox:
    CtxBox(v: v)

describe "local fn named like a spec-DSL word":
    it "calls the file's own context":
        # @req REQ-SSPEC-UNIT
        val b = context(5)
        expect(b.v).to_equal(5)

    it "binds the own context inside a nested expression":
        # @req REQ-SSPEC-UNIT
        expect(context(2).v).to_equal(2)

