"""
# Baseline for jit_wide_i64_array_store_jit_probe.spl

Same program shape with no array work. The spec subtracts this process's peak
RSS from the probe's, so the memory bound measures the stores and not the
engine start-up, which differs by architecture and build.
"""

fn main():
    var w: [i64] = [0; 80]
    w[0] = 1
    print "PROBE VERDICT: PASS {w[0]}"

main()
