use std.spec

extern fn rt_file_read_text(path: text) -> text

fn source(path: text) -> text:
    rt_file_read_text(path)

describe "Stage2 source return annotations":
    it "annotates the context SQLite opener with its concrete connection type":
        val src = source("src/app/io/context_ops.spl")
        expect(src.contains("fn _context_sql_open(db_path: text) -> SqliteConnection:")).to_equal(true)

    it "annotates JIT symbol lookup as an optional mapped record":
        val src = source("src/compiler/99.loader/jit_instantiator.spl")
        expect(src.contains("fn lookup(symbol: text) -> MappedRecord?:")).to_equal(true)

    it "annotates actor lookup and empty queue results as optional values":
        val src = source("src/lib/nogc_async_mut/actor_scheduler.spl")
        expect(src.contains("me dequeue() -> i64?:")).to_equal(true)
        expect(src.contains("fn get_actor(id: i64) -> ActorContext?:")).to_equal(true)

    it "keeps the HIR function import explicit for the type checker":
        val src = source("src/compiler/30.types/type_check/mod.spl")
        expect(src.contains("use compiler.hir.hir_definitions.{HirFunction}")).to_equal(true)
