"""
Only `+` concatenates text. infer_binary_op_type used to return TYPE_TEXT for
`-`, `*`, `/` on two text operands; those are now a type error (TYPE_ANY result
plus binary_op_get_error()). The interpreter agrees: eval_sub/mul/div have no
text arm and return TypeError, only eval_add concatenates.
"""

use std.spec.{describe, it, expect}
use compiler.core.type_inference.{infer_binary_op_type, binary_op_get_error}
use compiler.core.types.{TYPE_TEXT, TYPE_ANY, TYPE_I64}

describe "text binary operator inference":
    it "accepts text + text as text":
        expect(infer_binary_op_type("+", TYPE_TEXT, TYPE_TEXT)).to_equal(TYPE_TEXT)
        expect(binary_op_get_error()).to_equal("")

    it "rejects text - text":
        expect(infer_binary_op_type("-", TYPE_TEXT, TYPE_TEXT)).to_equal(TYPE_ANY)
        expect(binary_op_get_error().contains("'-'")).to_equal(true)

    it "rejects text * text":
        expect(infer_binary_op_type("*", TYPE_TEXT, TYPE_TEXT)).to_equal(TYPE_ANY)
        expect(binary_op_get_error().contains("'*'")).to_equal(true)

    it "rejects text / text":
        expect(infer_binary_op_type("/", TYPE_TEXT, TYPE_TEXT)).to_equal(TYPE_ANY)
        expect(binary_op_get_error().contains("'/'")).to_equal(true)

    it "still infers i64 arithmetic and clears the error":
        expect(infer_binary_op_type("-", TYPE_I64, TYPE_I64)).to_equal(TYPE_I64)
        expect(binary_op_get_error()).to_equal("")
