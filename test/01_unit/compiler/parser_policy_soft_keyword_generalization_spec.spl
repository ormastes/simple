# @cover src/compiler_rust/parser/src/parser_impl/core.rs 0%
# @req REQ-SSPEC-COMPILER
"""
# Policy soft keywords as ordinary names (generalization)

**Category:** Language / Parser
**Status:** Regression guard

## Purpose and Audience

Generalization of the `security` contextual-keyword fix. The same statement
dispatch in `parser/src/parser_impl/core.rs` also routed every statement
starting with `sandbox` or `ui_policy` to a declaration parser, so
`sandbox.level = 2` failed the same way. All three are now declarations only
in their declaration shape. This spec also probes `security` in parameter,
call-argument and compound-assignment positions.

Requires a seed built at or after 2026-11-15.
See doc/08_tracking/bug/security_identifier_parsed_as_policy_declaration_2026-11-15.md
"""
use std.spec.step
use std.spec

struct Knob:
    level: i64

fn bump(security: Knob) -> i64:
    security.level + 1

describe "policy soft keywords as ordinary names":
    it "assigns fields through variables named sandbox and ui_policy":
        # @req REQ-SSPEC-COMPILER
        step("Assign a field on a local named sandbox and one named ui_policy")
        var sandbox = Knob(level: 1)
        sandbox.level = 2
        var ui_policy = Knob(level: 3)
        ui_policy.level = 4
        expect(sandbox.level + ui_policy.level).to_equal(6)  # oracle: 6 — 2 + 4
    it "uses security as a parameter, argument and compound-assignment target":
        # @req REQ-SSPEC-COMPILER
        step("Pass a value named security and compound-assign its field")
        var security = Knob(level: 5)
        security.level += 1
        expect(bump(security)).to_equal(7)  # oracle: 7 — (5 + 1) + 1
