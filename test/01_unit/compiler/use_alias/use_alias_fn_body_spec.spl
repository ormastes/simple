# Regression: module-level `use <module> as <alias>` must be visible inside
# function and static-method bodies (bug interp_use_as_alias_not_visible_in_function_body_2026-07-20).
use std.spec
use std.common.base_encoding as benc

fn via_free_fn() -> i64:
    benc.bytes_to_text([104, 105]).len()

class AliasUser:
    static fn via_static() -> i64:
        benc.bytes_to_text([104, 105]).len()

describe "use-as alias in function bodies":
    it "resolves the alias inside a free fn":
        expect(via_free_fn()).to_equal(2)
    it "resolves the alias inside a static method":
        expect(AliasUser.via_static()).to_equal(2)
