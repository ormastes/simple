# Seed E1003 [u8]-into-word-array rule: the residual shapes admitted after
# the u8_array_into_word_array_unchecked_slots_2026-11-28 fix are rejected.
#
# Bug row: doc/08_tracking/bug/db/u8_array_into_word_array_residual_shapes_2026-11-28.sdn
# The rule lives in the Rust seed's HIR lowering
# (src/compiler_rust/compiler/src/hir/lower/module_lowering/function.rs and
# expr/mod.rs), so this spec drives the seed binary's CLI rather than the
# in-process pure-Simple lowering.
#
# Shapes pinned here (each must FAIL to compile with the E1003 [u8] diagnostic):
#   1. an optional VALUE: `[u8]?` into a `[i64]?` slot (let/return/parameter)
#   2. a callee/method/trait parameter spelled `Option<[i64]>`
#   3. a trait-typed receiver that is not a local (`self.store.put(b)`,
#      `self.inner.store.keep_words(b)`)
#   4. a `[u8]` pushed into a `[[i64]]` via the builtin push/append
# Shape 5 of the record (an untyped `list` relay erases the element type to
# ANY) is deliberately pinned as still admitted: no provenance design yet.
#
# Re-verification after the next seed deploy:
#   bin/simple test test/01_unit/compiler/seed_u8_word_array_residual_shapes_spec.spl
# (direct run works too: bin/simple run test/01_unit/compiler/seed_u8_word_array_residual_shapes_spec.spl)
# Against a scratch seed (pre-deploy), invoke the scratch seed directly so
# both the spec runner and the child compile use it:
#   SEED=$PWD/src/build/p3cache/u8resid/cargo-target/release/simple.exe
#   SIMPLE_U8_RESID_SEED_BIN=$SEED "$SEED" test \
#     test/01_unit/compiler/seed_u8_word_array_residual_shapes_spec.spl --mode=interpreter --no-cache

use std.spec.{describe, it, expect, skip}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive, file_exists}
use std.nogc_sync_mut.io.env_ops.{cwd}
use std.env.variables.{env_get}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _repo_root() -> text:
    cwd().replace("\\", "/")

val SEED_BIN_DEFAULT = _repo_root() + "/src/compiler_rust/target/bootstrap/simple" + (if is_windows(): ".exe" else: "")
# Scratch builds (pre-deploy verification) point here instead of the
# not-yet-deployed bootstrap seed.
val SEED_BIN = env_get("SIMPLE_U8_RESID_SEED_BIN") ?? SEED_BIN_DEFAULT

fn _seed_it(name: text, block: fn()):
    if file_exists(SEED_BIN):
        it(name, block)
    else:
        skip(name, "seed binary not built at " + SEED_BIN + " (set SIMPLE_U8_RESID_SEED_BIN to override)")

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_u8_word_array_residual_shapes_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR):
        fail("could not create fixture dir " + FIXTURE_DIR)

fn _write_fixture(name: text, source: text):
    if not file_create_exclusive(FIXTURE_DIR + "/" + name, source):
        fail("could not write fixture " + name)

fn _seed_compile(name: text) -> (text, text, i64):
    val repo = _repo_root()
    val src = FIXTURE_DIR + "/" + name
    val out = FIXTURE_DIR + "/" + name + ".out"
    val cmd = SEED_BIN + " compile " + src + " -o " + out
    # The seed resolves its surroundings relative to the repo, so run from the
    # repo root exactly like the operator workflow does.
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        (sh, ["/d", "/c", "cd /d " + repo + " && " + cmd])
    else:
        ("/bin/sh", ["-c", "cd \"" + repo + "\" && \"" + SEED_BIN + "\" compile \"" + src + "\" -o \"" + out + "\""])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

fn _expect_u8_reject(name: text, label: text):
    step("compile " + name + " (" + label + ")")
    val (_out, err, code) = _seed_compile(name)
    step("verify: the compile fails with the E1003 [u8] diagnostic")
    expect(code).to_equal(1)
    expect(err).to_contain("error[E1003]")
    expect(err).to_contain("u8]")

describe "seed E1003 [u8]-into-word-array residual shapes":
    _seed_it "shape 1: an optional [u8]? value into a [i64]? slot is rejected":
        _setup_fixture()
        _write_fixture("shape1_optional_value.spl",
            "fn f(x: [u8]?) -> i64:\n"
                + "    val w: [i64]? = x\n"
                + "    return w.len()\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape1_optional_value.spl", "let slot")
        _write_fixture("shape1_optional_param.spl",
            "fn at(data: [i64]?) -> i64:\n"
                + "    return data.len()\n"
                + "\n"
                + "fn f(x: [u8]?) -> i64:\n"
                + "    return at(x)\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape1_optional_param.spl", "call parameter")

    _seed_it "shape 2: a parameter spelled Option<[i64]> is rejected":
        _setup_fixture()
        _write_fixture("shape2_late_callee.spl",
            "fn f(b: [u8]) -> i64:\n"
                + "    return at(b)\n"
                + "\n"
                + "fn at(data: Option<[i64]>) -> i64:\n"
                + "    return 0\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape2_late_callee.spl", "later-declared callee")
        _write_fixture("shape2_trait_row.spl",
            "trait Store:\n"
                + "    fn keep_words(data: Option<[i64]>) -> i64\n"
                + "\n"
                + "fn f(s: Store, b: [u8]) -> i64:\n"
                + "    return s.keep_words(b)\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape2_trait_row.spl", "trait row")

    _seed_it "shape 3: a trait method on a field receiver is rejected":
        _setup_fixture()
        _write_fixture("shape3_field_receiver.spl",
            "trait Store:\n"
                + "    fn put(data: [i64]) -> i64\n"
                + "\n"
                + "class Widget:\n"
                + "    val store: Store\n"
                + "    fn test(b: [u8]) -> i64:\n"
                + "        return self.store.put(b)\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape3_field_receiver.spl", "self.store.put(b)")
        _write_fixture("shape3_nested_field_receiver.spl",
            "trait Store:\n"
                + "    fn keep_words(data: [i64]) -> i64\n"
                + "\n"
                + "class Holder:\n"
                + "    val store: Store\n"
                + "\n"
                + "class Outer:\n"
                + "    val inner: Holder\n"
                + "    fn test(b: [u8]) -> i64:\n"
                + "        return self.inner.store.keep_words(b)\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape3_nested_field_receiver.spl", "self.inner.store.keep_words(b)")

    _seed_it "shape 4: a [u8] pushed into a [[i64]] is rejected":
        _setup_fixture()
        _write_fixture("shape4_builtin_push.spl",
            "fn f(b: [u8]) -> i64:\n"
                + "    var rows: [[i64]] = []\n"
                + "    rows.push(b)\n"
                + "    return rows.len()\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape4_builtin_push.spl", "builtin push")
        _write_fixture("shape4_builtin_append.spl",
            "fn f(b: [u8]) -> i64:\n"
                + "    var rows: List<[i64]> = []\n"
                + "    rows.append(b)\n"
                + "    return rows.len()\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        _expect_u8_reject("shape4_builtin_append.spl", "builtin append")

    _seed_it "controls: same-type and word-array shapes still compile":
        _setup_fixture()
        _write_fixture("control_ok.spl",
            "fn f(b: [u8]) -> i64:\n"
                + "    var rows: [[u8]] = []\n"
                + "    rows.push(b)\n"
                + "    var words: [[i64]] = []\n"
                + "    words.push([1, 2])\n"
                + "    val w: [i64]? = nil\n"
                + "    return rows.len() + words.len()\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        step("compile control_ok.spl (same-type push, literal rows, nil optional)")
        val (_out, err, code) = _seed_compile("control_ok.spl")
        step("verify: the control compiles clean")
        expect(code).to_equal(0)

    _seed_it "documented gap: an untyped list relay is still admitted":
        _setup_fixture()
        _write_fixture("gap_untyped_list_relay.spl",
            "fn relay(x: list) -> list:\n"
                + "    return x\n"
                + "\n"
                + "fn take(w: [i64]) -> i64:\n"
                + "    return w[0]\n"
                + "\n"
                + "fn f(b: [u8]) -> i64:\n"
                + "    return take(relay(b))\n"
                + "\n"
                + "fn main() -> i64:\n"
                + "    return 0\n")
        step("compile gap_untyped_list_relay.spl (record residual (5))")
        val (_out, _err, code) = _seed_compile("gap_untyped_list_relay.spl")
        step("verify: still admitted (pinned gap until a provenance design lands)")
        expect(code).to_equal(0)
