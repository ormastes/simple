# @req REQ-SSPEC-COMPILER
"""
# `case nil:` is forbidden outside `unsafe:` in src/

The language rule is that `nil` is only allowed inside `unsafe:`. The Rust seed
also miscompiled `case nil:` (lowered as rt_string_eq(subject, nil), so the nil
arm never matched). Option subjects must use `case None:`.

This spec pins that no pattern-position `case nil:` / `case nil =>` remains in
product source under src/ (vendored code excluded). The single allowlisted site
is inside an `unsafe:` block (FFI bridge).
"""

# @tag: unit, compiler, policy, nil

use std.spec
use std.io_runtime.{shell}

fn _case_nil_sites_cmd() -> text:
    "grep -rnE '^[[:space:]]*case[[:space:]]+nil[[:space:]]*(:|=>)' src --include='*.spl' --exclude-dir=vendor | grep -v '^src/app/interpreter/ffi/bridge.spl:' || true"

describe "case nil policy":
    it "has no `case nil:` pattern outside unsafe blocks in src/":
        val out = shell(_case_nil_sites_cmd()).stdout.trim()
        expect(out).to_equal("")
