# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @cover src/compiler_rust/compiler/src/mir/lower/lowering_core.rs 0%
"""
# Conditions on untyped (`ANY`) values

**Category:** Language / Control flow
**Status:** Regression guard (generalization of generic_bool_field_condition_spec)

## Purpose and Audience

Any expression the seed types as `ANY` carries a tagged runtime value: an
element of an untyped `list`, a value returned through an `any` parameter, a
generic field. A condition must use the value's truthiness, the same answer the
interpreter gives: `false` and `nil` are falsy, `0` is falsy, everything else
is truthy. Testing the raw word made tagged `false` and `nil` truthy under the
JIT.

The audience is anyone touching condition lowering in the Rust seed.
"""

use std.spec.step

use std.spec.*

fn spec_truth_count(v: any) -> i64:
    var n = 0
    if v:
        n = n + 1
    if v or false:
        n = n + 10
    if not v:
        n = n + 100
    n

describe "conditions on untyped values":
    # @manual scenario evidence

    it "reads false and nil as falsy and true as truthy":
        # @req REQ-SSPEC-COMPILER
        step("reads false and nil as falsy and true as truthy")
        expect(spec_truth_count(false)).to_equal(100)
        expect(spec_truth_count(nil)).to_equal(100)
        expect(spec_truth_count(true)).to_equal(11)

    it "reads zero as falsy and other numbers and text as truthy":
        # @req REQ-SSPEC-COMPILER
        step("reads zero as falsy and other numbers and text as truthy")
        expect(spec_truth_count(0)).to_equal(100)
        expect(spec_truth_count(7)).to_equal(11)
        expect(spec_truth_count("x")).to_equal(11)

    it "reads untyped list elements by truthiness":
        # @req REQ-SSPEC-COMPILER
        step("reads untyped list elements by truthiness")
        val xs: list = [false, true, nil]
        var taken = 0
        if xs[0]:
            taken = taken + 1
        if xs[1]:
            taken = taken + 10
        if xs[2]:
            taken = taken + 100
        expect(taken).to_equal(10)
