use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}

describe "frontend owner imports remain explicit":
    it "enum declaration parser imports the canonical token-name owner":
        val source = read_file("src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl")
        expect(source.contains("use compiler.core.tokens.{TOK_KW_AS, TOK_KW_CE, TOK_PIPE, TOK_ASSIGN, tok_kind_name}")).to_equal(true)
        expect(source.contains("tok_kind_name(par_kind_get())")).to_equal(true)

    it "function declaration parser imports the AST parameter-mutator owner":
        val source = read_file("src/compiler/10.frontend/core/_ParserDecls/fn_struct_decls.spl")
        expect(source.contains("use compiler.frontend.core._Ast.decl_nodes.{decl_set_param_muts}")).to_equal(true)
        expect(source.contains("decl_set_param_muts(fn_decl_idx, param_muts)")).to_equal(true)

    it "heuristic outline parser imports the canonical visibility owner":
        val source = read_file("src/compiler/10.frontend/treesitter/heuristic.spl")
        expect(source.contains("use compiler.common.dependency.visibility.{Visibility}")).to_equal(true)
        expect(source.contains("fn heuristic_parse_visibility(vis: text) -> Visibility:")).to_equal(true)
        expect(source.contains("if vis == \"pub\":\n            Visibility.Public")).to_equal(true)
        expect(source.contains("Visibility.Private")).to_equal(true)
