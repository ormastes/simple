# @req REQ-GENERIC-BOUND-TRANSPORT
# Requires reviewed generic-active-bound-inference revision2. No injected HIR.
use std.spec.{describe, it, expect, step, fail}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.core.parser.parser_has_errors
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.HirTypeKind
use compiler.types.type_infer.*
use compiler.types.type_infer_types.{HmInferContext, TypeInferError}

fn parsed_bound_infer(inline: bool, call: text, result: text) -> HmInferContext:
    val declaration = if inline:
        "fn choose<T, U: Marked>(first: T, second: U) -> U:\n    second\n"
    else:
        "fn choose<T, U>(first: T, second: U) -> U where U: Marked:\n    second\n"
    val source = "trait Marked:\n    fn mark(self) -> i64:\n        1\nimpl Marked for i64:\n    fn mark(self) -> i64:\n        1\n" + declaration + "fn entry() -> {result}:\n    {call}\n"
    val parsed = parse_full_frontend(source, "parsed_bounds.spl", "parsed_bounds", Logger(level: 0))
    expect(parser_has_errors()).to_be(false)
    var lowering = HirLowering.with_filename("parsed_bounds.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    var saw_bound = false
    for function in module.functions.values():
        if function.name == "choose":
            expect(function.type_params.len()).to_equal(2)
            expect(function.type_params[0].bounds.len()).to_equal(0)
            expect(function.type_params[1].bounds.len()).to_equal(1)
            saw_bound = true
    expect(saw_bound).to_be(true)
    var context = HmInferContext.with_builtins()
    context.infer_module(module)
    expect(context.pending_bound_calls.len()).to_equal(0)
    expect(context.trait_solver.obligations.len()).to_equal(0)
    context

describe "parsed generic bounds reach active inference":
    it "accepts inline and where bounds on the second explicit parameter":
        step("Collect real Marked for i64 and keep T=bool unconstrained")
        expect(parsed_bound_infer(true, "choose<bool, i64>(true, 1)", "i64").errors.len()).to_equal(0)
        expect(parsed_bound_infer(false, "choose<bool, i64>(true, 1)", "i64").errors.len()).to_equal(0)

    it "rejects inline and where bounds when the second parameter lacks the trait":
        step("Retain the source bound through parsing, lowering, and substitution")
        for inline in [true, false]:
            val context = parsed_bound_infer(inline, "choose<i64, bool>(1, true)", "bool")
            expect(context.errors.len()).to_equal(1)
            match context.errors[0]:
                case TypeInferError.TraitNotImplemented(type_, name, span):
                    expect(type_.kind == HirTypeKind.Bool).to_be(true)
                    expect(name).to_equal("Marked")
                    expect(span.line).to_be_greater_than(0)
                case _: fail("expected concrete unsatisfied parsed trait bound")

    it "checks an inferred bounded argument without explicit type arguments":
        step("Infer U then enforce the same parsed constraint")
        expect(parsed_bound_infer(false, "choose(true, 1)", "i64").errors.len()).to_equal(0)
        val context = parsed_bound_infer(false, "choose(1, true)", "bool")
        expect(context.errors.len()).to_equal(1)
        match context.errors[0]:
            case TypeInferError.TraitNotImplemented(_, name, _): expect(name).to_equal("Marked")
            case _: fail("expected inferred argument trait failure")
