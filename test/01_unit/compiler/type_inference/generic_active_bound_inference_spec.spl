# @req REQ-GENERIC-ACTIVE-BOUNDS
# Real infer_module entrypoint. Bounds are attached to actual lowered binders
# because flat-AST bound transport is a separately tracked prerequisite.
use std.spec.{describe, it, expect, step, fail}
use compiler.common.config.Logger
use compiler.common.diagnostics.span.Span
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, HirSymbol, SymbolKind}
use compiler.hir.hir_definitions.{HirFunction, HirExprKind, HirTypeParam, HirTraitBound}
use compiler.types.type_infer.*
use compiler.types.type_infer_types.{HmInferContext, TypeInferError}

fn active_bound_parse(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "active_bounds.spl", "active_bounds", Logger(level: 0))
    var lowering = HirLowering.with_filename("active_bounds.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.functions.len()).to_be_greater_than(0)
    module

fn active_bound_function(module: HirModule, name: text) -> HirFunction:
    for function in module.functions.values():
        if function.name == name: return function
    fail("missing actual lowered function {name}")
    nil

fn active_bound_trait(module: HirModule, name: text) -> HirSymbol:
    for declaration in module.traits.values():
        if declaration.name == name:
            if val symbol = module.symbols.get_symbol_raw(declaration.symbol.id): return symbol
    fail("missing actual lowered trait {name}")
    nil

fn active_bound_attach(module: HirModule, name: text, index: i64, trait_name: text) -> HirModule:
    var result = module
    var function = active_bound_function(module, name)
    expect(function.type_params.len()).to_be_greater_than(index)
    var parameter: HirTypeParam = function.type_params[index]
    val trait_symbol = active_bound_trait(module, trait_name)
    parameter.bounds = [HirType(kind: HirTypeKind.Named(trait_symbol.id, []), span: parameter.span)]
    function.type_params[index] = parameter
    result.functions[function.symbol] = function
    result

fn active_bound_fixture(call: text, result: text, conditional: bool = false, child_impl: bool = true) -> HirModule:
    val traits = "trait Marked:\n    fn mark(self) -> i64:\n        1\ntrait Other:\n    fn other(self) -> i64:\n        2\n"
    val marked_impl = if conditional:
        "impl<T> Marked for T:\n    fn mark(self) -> i64:\n        1\n"
    else:
        "impl Marked for i64:\n    fn mark(self) -> i64:\n        1\n"
    val other_impl = if child_impl: "impl Other for i64:\n    fn other(self) -> i64:\n        2\n" else: ""
    val source = traits + marked_impl + other_impl + "fn choose<T, U>(first: T, second: U) -> U:\n    second\nfn entry() -> {result}:\n    {call}\n"
    var module = active_bound_attach(active_bound_parse(source), "choose", 1, "Marked")
    expect(module.impls.len()).to_equal(if child_impl: 2 else: 1)
    if conditional:
        val other = active_bound_trait(module, "Other")
        var implementation = module.impls[0]
        expect(implementation.type_params.len()).to_equal(1)
        var parameter = implementation.type_params[0]
        parameter.bounds = [HirType(kind: HirTypeKind.Named(other.id, []), span: parameter.span)]
        implementation.type_params[0] = parameter
        module.impls[0] = implementation
    module

fn active_bound_infer(module: HirModule) -> HmInferContext:
    var context = HmInferContext.with_builtins()
    # No test-installed solver traits or impls: production infer_module owns it.
    context.infer_module(module)
    expect(context.pending_bound_calls.len()).to_equal(0)
    expect(context.trait_solver.obligations.len()).to_equal(0)
    context

fn active_bound_failure(context: HmInferContext, kind: HirTypeKind, name: text):
    expect(context.errors.len()).to_equal(1)
    match context.errors[0]:
        case TypeInferError.TraitNotImplemented(type_, trait_name, span):
            expect(type_.kind == kind).to_be(true)
            expect(trait_name).to_equal(name)
            expect(span.line).to_be_greater_than(0)
        case _: fail("expected concrete unsatisfied trait diagnostic")

fn active_bound_forwarding_metadata_fixture() -> HirModule:
    val source = "trait Marked:\n    fn mark(self) -> i64:\n        1\nfn choose<T, U>(first: T, second: U) -> U:\n    second\nfn forward<A, B>(first: A, second: B) -> B:\n    choose(first, second)\n"
    var module = active_bound_attach(active_bound_parse(source), "choose", 1, "Marked")
    active_bound_attach(module, "forward", 1, "Marked")

fn active_bound_metadata_failure(module: HirModule, message: text):
    val context = active_bound_infer(module)
    expect(context.errors.len()).to_equal(1)
    expect(context.function_bound_context).to_be_nil()
    expect(context.function_bounds.len()).to_equal(0)
    match context.errors[0]:
        case TypeInferError.Other(detail, _): expect(detail).to_contain(message)
        case _: fail("expected declaration-authority diagnostic before symbolic admission")

describe "active HM direct generic call bounds":
    it "instantiates identity<i64>(1) through infer_module":
        step("Preserve the declared binder and apply the explicit argument before checking values")
        val module = active_bound_parse("fn identity<T>(value: T) -> T:\n    value\nfn entry() -> i64:\n    identity<i64>(1)\n")
        val entry = active_bound_function(module, "entry")
        expect(entry.body.has).to_be(true)
        match entry.body.value.kind:
            case Call(_, _, type_args): expect(type_args.len()).to_equal(1)
            case _: fail("fixture must lower to an actual explicit generic call")
        expect(active_bound_infer(module).errors.len()).to_equal(0)

    it "accepts a bounded second explicit binder when the first has no impl":
        step("Collect Marked for i64 from HIR and check U=i64 independently of T=bool")
        val context = active_bound_infer(active_bound_fixture("choose<bool, i64>(true, 1)", "i64"))
        expect(context.errors.len()).to_equal(0)

    it "rejects a second explicit binder even when the first implements the trait":
        step("Require U=bool to implement Marked rather than using T=i64")
        active_bound_failure(active_bound_infer(active_bound_fixture("choose<i64, bool>(1, true)", "bool")), HirTypeKind.Bool, "Marked")

    it "accepts inferred arguments after unification":
        step("Infer T=bool and U=i64 from actual values before solving")
        expect(active_bound_infer(active_bound_fixture("choose(true, 1)", "i64")).errors.len()).to_equal(0)

    it "rejects inferred arguments after unification":
        step("Infer U=bool and retain the owning bound failure")
        active_bound_failure(active_bound_infer(active_bound_fixture("choose(1, true)", "bool")), HirTypeKind.Bool, "Marked")

    it "covers the retained Var call form with identical declaration identity":
        step("Change only the lowered callee representation from NamedVar to Var")
        var module = active_bound_fixture("choose(1, true)", "bool")
        var entry = active_bound_function(module, "entry")
        var body = entry.body
        var expression = body.value
        match expression.kind:
            case Call(callee, arguments, type_args):
                var variable = callee
                match variable.kind:
                    case NamedVar(symbol, _): variable.kind = HirExprKind.Var(symbol)
                    case Var(_): ()
                    case _: fail("fixture needs resolved variable callee")
                expression.kind = HirExprKind.Call(variable, arguments, type_args)
            case _: fail("fixture needs a direct call")
        body.value = expression
        entry.body = body
        module.functions[entry.symbol] = entry
        active_bound_failure(active_bound_infer(module), HirTypeKind.Bool, "Marked")

    it "solves a selected conditional impl before accepting the call":
        step("Marked<T> requires Other<T>; register the actual Other for i64 declaration")
        expect(active_bound_infer(active_bound_fixture("choose(true, 1)", "i64", true, true)).errors.len()).to_equal(0)

    it "reports an unsatisfied conditional child as an HM error":
        step("Omit Other for i64 and require synchronous closure failure")
        active_bound_failure(active_bound_infer(active_bound_fixture("choose(true, 1)", "i64", true, false)), HirTypeKind.Int(64, true), "Other")

    it "propagates ambiguity rather than dropping the solver error":
        step("Two actual impl candidates must reach the owning HM diagnostic collection")
        var module = active_bound_fixture("choose(true, 1)", "i64")
        module.impls = module.impls.push(module.impls[0])
        val context = active_bound_infer(module)
        expect(context.errors.len()).to_equal(1)
        match context.errors[0]:
            case TypeInferError.Other(message, _): expect(message).to_contain("ambiguous trait impl")
            case _: fail("expected propagated ambiguity")

    it "retains the parameterized-bound diagnostic at the active entrypoint":
        step("Do not erase Marked<i64> into an unparameterized obligation")
        var module = active_bound_fixture("choose(true, 1)", "i64")
        var function = active_bound_function(module, "choose")
        var parameter = function.type_params[1]
        val marked = active_bound_trait(module, "Marked")
        parameter.bounds = [HirType(kind: HirTypeKind.Named(marked.id, [HirType(kind: HirTypeKind.Int(64, true), span: parameter.span)]), span: parameter.span)]
        function.type_params[1] = parameter
        module.functions[function.symbol] = function
        val context = active_bound_infer(module)
        expect(context.errors.len()).to_equal(1)
        match context.errors[0]:
            case TypeInferError.Other(message, _): expect(message).to_contain("parameterized trait bounds")
            case _: fail("expected argument-aware bound admission failure")

    it "rejects excess explicit type arguments before checking the call":
        step("Identity has one declared binder and cannot consume two explicit types")
        val module = active_bound_parse("fn identity<T>(value: T) -> T:\n    value\nfn entry() -> i64:\n    identity<i64, bool>(1)\n")
        val context = active_bound_infer(module)
        expect(context.errors.len()).to_equal(1)
        match context.errors[0]:
            case TypeInferError.Other(message, _): expect(message).to_contain("type argument count exceeds")
            case _: fail("expected declared type-argument count diagnostic")

    it "accepts a generic forwarding body under its exact declared assumption":
        step("A symbolic caller U may use the same Marked obligation without a concrete fake impl")
        val source = "trait Marked:\n    fn mark(self) -> i64:\n        1\nimpl Marked for i64:\n    fn mark(self) -> i64:\n        1\nfn choose<T, U>(first: T, second: U) -> U:\n    second\nfn forward<A, B>(first: A, second: B) -> B:\n    choose(first, second)\nfn entry() -> i64:\n    forward(true, 1)\n"
        var module = active_bound_attach(active_bound_parse(source), "choose", 1, "Marked")
        module = active_bound_attach(module, "forward", 1, "Marked")
        expect(active_bound_infer(module).errors.len()).to_equal(0)

    it "rejects a forwarding body missing the caller assumption":
        step("Do not treat a rigid outer binder as a concrete implementor")
        val source = "trait Marked:\n    fn mark(self) -> i64:\n        1\nfn choose<T, U>(first: T, second: U) -> U:\n    second\nfn forward<A, B>(first: A, second: B) -> B:\n    choose(first, second)\n"
        val module = active_bound_attach(active_bound_parse(source), "choose", 1, "Marked")
        val context = active_bound_infer(module)
        expect(context.errors.len()).to_equal(1)
        match context.errors[0]:
            case TypeInferError.Other(message, _): expect(message).to_contain("matching caller bound")
            case _: fail("expected missing generic caller assumption")

    it "applies an unused declared default before solving its bound":
        step("An unconstrained U defaults to i64 after the explicit T and value inference")
        val source = "trait Marked:\n    fn mark(self) -> i64:\n        1\nimpl Marked for i64:\n    fn mark(self) -> i64:\n        1\nfn choose<T, U>(first: T) -> T:\n    first\nfn entry() -> bool:\n    choose<bool>(true)\n"
        var module = active_bound_attach(active_bound_parse(source), "choose", 1, "Marked")
        var function = active_bound_function(module, "choose")
        var parameter = function.type_params[1]
        parameter.has_default = true
        parameter.default = HirType(kind: HirTypeKind.Int(64, true), span: parameter.span)
        function.type_params[1] = parameter
        module.functions[function.symbol] = function
        expect(active_bound_infer(module).errors.len()).to_equal(0)

    it "refuses matching forwarding assumptions with a missing trait row":
        step("Matching IDs cannot replace an authoritative trait symbol")
        var module = active_bound_forwarding_metadata_fixture()
        val trait_symbol = active_bound_trait(module, "Marked")
        var remaining: Dict<i64, HirSymbol> = {}
        for key in module.symbols.symbols.keys():
            if key != trait_symbol.id.id: remaining[key] = module.symbols.symbols[key]
        module.symbols.symbols = remaining
        active_bound_metadata_failure(module, "missing trait symbol")

    it "refuses matching forwarding assumptions whose trait ID names a struct":
        step("The declaration kind must be Trait before the symbolic path can discharge it")
        var module = active_bound_forwarding_metadata_fixture()
        var symbol = active_bound_trait(module, "Marked")
        symbol.kind = SymbolKind.Struct
        module.symbols.symbols[symbol.id.id] = symbol
        active_bound_metadata_failure(module, "does not name a trait symbol")

    it "refuses a forwarding binder owned by another module":
        step("Same numeric binder ID does not authorize another module's parameter")
        var module = active_bound_forwarding_metadata_fixture()
        val function = active_bound_function(module, "forward")
        val parameter = function.type_params[1]
        var symbol = module.symbols.get_symbol_raw(parameter.symbol.id).unwrap()
        symbol.defining_module = Some("foreign_bounds")
        module.symbols.symbols[symbol.id.id] = symbol
        active_bound_metadata_failure(module, "type parameter owner mismatch")

    it "refuses a function declaration whose row no longer names a function":
        step("Only actual Function or Method rows can publish callable declaration metadata")
        var module = active_bound_forwarding_metadata_fixture()
        val function = active_bound_function(module, "forward")
        var symbol = module.symbols.get_symbol_raw(function.symbol.id).unwrap()
        symbol.kind = SymbolKind.Struct
        module.symbols.symbols[symbol.id.id] = symbol
        active_bound_metadata_failure(module, "does not name a function symbol")
