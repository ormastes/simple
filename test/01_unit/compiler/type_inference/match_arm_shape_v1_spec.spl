use std.spec.{describe, it, expect}
use compiler.tools.lint.semantic_check.{simple_semantic_check_source}

describe "resolved match arm block and guard presence":
    it "match_check_body_valid":
        val result = simple_semantic_check_source("fn example(code: i64) -> i64:\n    val number: i64 = match code:\n        case 0: 7\n        case _: 8\n    number\n", "match_check_body_valid.spl")
        expect(result.diagnostic_records.len()).to_equal(0)
    it "match_synth_body_valid":
        val result = simple_semantic_check_source("fn example(code: i64) -> i64:\n    val number = match code:\n        case 0: 7\n        case _: 8\n    number\n", "match_synth_body_valid.spl")
        expect(result.diagnostic_records.len()).to_equal(0)
    it "match_check_body_wrong":
        val result = simple_semantic_check_source("fn example(code: i64) -> i64:\n    val number: i64 = match code:\n        case 0: \"wrong\"\n        case _: 8\n    number\n", "match_check_body_wrong.spl")
        var exact_mismatch = false
        for record in result.diagnostic_records:
            if record.code == "E1003" and record.expected == "i64" and record.found == "text": exact_mismatch = true
        expect(exact_mismatch).to_equal(true)
    it "match_guard_valid":
        val result = simple_semantic_check_source("fn example(code: i64, flag: bool) -> i64:\n    val number: i64 = match code:\n        case 0 if flag: 7\n        case _: 8\n    number\n", "match_guard_valid.spl")
        expect(result.diagnostic_records.len()).to_equal(0)
    it "match_guard_wrong":
        val result = simple_semantic_check_source("fn example(code: i64) -> i64:\n    val number: i64 = match code:\n        case 0 if 7: 7\n        case _: 8\n    number\n", "match_guard_wrong.spl")
        var exact_mismatch = false
        for record in result.diagnostic_records:
            if record.code == "E1003" and record.expected == "bool" and record.found == "i64": exact_mismatch = true
        expect(exact_mismatch).to_equal(true)
