# @cover src/compiler/00.common/assurance/policy_names.spl 80%
# @req REQ-ASSURANCE-POLICY-NAMES-001
"""
## Assurance Policy Names Specification

Exercises canonical profile normalization, deprecated alias replacement hints,
ascending strictness enumeration, and fail-closed unknown spelling behavior
in `compiler.common.assurance.policy_names`.
"""

use std.spec.{describe, it, expect, step}
use compiler.common.assurance.policy_names.{
    normalize_profile_name,
    deprecated_profile_alias_replacement,
    canonical_profile_names,
    all_accepted_profile_spellings,
    valid_profile_names_help
}

describe "assurance policy name normalization":
    it "normalizes all canonical profile spellings case-insensitively":
        step("Verify exact and mixed-case canonical spellings map to lowercase canonical names")
        expect(normalize_profile_name("moderate")).to_equal("moderate")
        expect(normalize_profile_name("STRICT")).to_equal("strict")
        expect(normalize_profile_name("RoBuSt")).to_equal("robust")
        expect(normalize_profile_name("Critical")).to_equal("critical")
        expect(normalize_profile_name("VERIFIED")).to_equal("verified")

    it "normalizes deprecated profile aliases to canonical equivalents":
        step("Map deprecated aliases case-insensitively to canonical profiles")
        expect(normalize_profile_name("lib")).to_equal("strict")
        expect(normalize_profile_name("LIB")).to_equal("strict")
        expect(normalize_profile_name("reliable")).to_equal("robust")
        expect(normalize_profile_name("mission-critical")).to_equal("critical")
        expect(normalize_profile_name("mission_critical")).to_equal("critical")
        expect(normalize_profile_name("MISSION-CRITICAL")).to_equal("critical")

    it "reports deprecation replacements only for deprecated aliases":
        step("Verify canonical and unrecognized spellings emit empty replacement strings")
        expect(deprecated_profile_alias_replacement("lib")).to_equal("strict")
        expect(deprecated_profile_alias_replacement("reliable")).to_equal("robust")
        expect(deprecated_profile_alias_replacement("mission-critical")).to_equal("critical")
        expect(deprecated_profile_alias_replacement("mission_critical")).to_equal("critical")
        expect(deprecated_profile_alias_replacement("strict")).to_equal("")
        expect(deprecated_profile_alias_replacement("verified")).to_equal("")
        expect(deprecated_profile_alias_replacement("unknown-profile")).to_equal("")

    it "fails closed on empty and unrecognized profile spellings":
        step("Verify empty, padded, and unknown spellings yield empty string")
        expect(normalize_profile_name("")).to_equal("")
        expect(normalize_profile_name(" strict ")).to_equal("")
        expect(normalize_profile_name("nightly")).to_equal("")
        expect(normalize_profile_name("critical-v2")).to_equal("")

    it "lists canonical profile names in ascending strictness order":
        step("Verify the five canonical profiles preserve strictness order")
        val names = canonical_profile_names()
        expect(names).to_equal(["moderate", "strict", "robust", "critical", "verified"])

    it "ensures every accepted spelling normalizes to a canonical profile":
        step("Verify all accepted spellings resolve into canonical_profile_names")
        val canonical = canonical_profile_names()
        val spellings = all_accepted_profile_spellings()
        expect(spellings.len()).to_equal(9)
        for spelling in spellings:
            val normalized = normalize_profile_name(spelling)
            expect(canonical.contains(normalized)).to_be(true)

    it "includes canonical and deprecated names in help summary":
        step("Verify valid_profile_names_help lists user-facing and legacy names")
        val help = valid_profile_names_help()
        expect(help).to_contain("moderate")
        expect(help).to_contain("verified")
        expect(help).to_contain("mission-critical")
