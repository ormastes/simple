# @cover src/compiler_rust/parser/src/parser_impl/core.rs 0%
# @req REQ-SSPEC-COMPILER
"""
# `security` as an ordinary identifier

**Category:** Language / Parser
**Status:** Regression guard

## Purpose and Audience

`security` introduces a policy declaration (`security:` / `security <name>:`)
or a gate (`security gate ...`). Until 2026-11-15 the Rust seed treated ANY
statement starting with `security` as a policy declaration, so
`security.policy_bound = true` failed with `expected identifier, found Dot`.
It is now contextual. Audience: anyone touching statement dispatch in
`parser/src/parser_impl/core.rs`.

Requires a seed built at or after 2026-11-15.
See doc/08_tracking/bug/security_identifier_parsed_as_policy_declaration_2026-11-15.md
"""
use std.spec.step
use std.spec

struct SecFlags:
    policy_bound: bool
    level: i64

describe "security as an ordinary identifier":
    it "assigns a field through a variable named security":
        # @req REQ-SSPEC-COMPILER
        step("Declare a local named security and assign one of its fields")
        var security = SecFlags(policy_bound: false, level: 1)
        security.policy_bound = true
        expect(security.policy_bound).to_equal(true)  # oracle: true — the assignment took effect
    it "reassigns and reads a variable named security":
        # @req REQ-SSPEC-COMPILER
        step("Reassign the whole variable, then read it in expression position")
        var security = SecFlags(policy_bound: false, level: 1)
        security = SecFlags(policy_bound: true, level: 7)
        expect(security.level + 1).to_equal(8)  # oracle: 8 — 7 + 1
