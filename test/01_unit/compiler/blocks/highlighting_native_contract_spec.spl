# @req: REQ-SSPEC-COMPILER
# Actual public highlighting functions; no mock lexer or compile-only checks.
use std.spec
use compiler.blocks.highlighting.{highlight_keywords, highlight_strings, highlight_comments, highlight_numbers}
use compiler.blocks.definition.HighlightKind

describe "block highlighting source contracts":
    it "finds repeated whole keywords with offsets in the original text":
        val tokens = highlight_keywords("let outlet let", ["let"])
        expect(tokens.len()).to_equal(2)
        expect(tokens[0].start).to_equal(0)
        expect(tokens[0].end).to_equal(3)
        expect(tokens[1].start).to_equal(11)
        expect(tokens[1].end).to_equal(14)
        expect(tokens[1].kind).to_equal(HighlightKind.Keyword)

    it "terminates for missing and empty keywords and empty input":
        expect(highlight_keywords("alpha", ["missing", "zz", ""]).len()).to_equal(0)
        expect(highlight_keywords("", ["", "alpha"]).len()).to_equal(0)

    it "uses text length while finding a quoted string":
        val tokens = highlight_strings("say \"hi\" end")
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].start).to_equal(4)
        expect(tokens[0].end).to_equal(8)
        expect(tokens[0].kind).to_equal(HighlightKind.String)

    it "handles absent block delimiters and a line comment":
        val tokens = highlight_comments("a // x\nb", "//")
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].start).to_equal(2)
        expect(tokens[0].end).to_equal(6)
        expect(tokens[0].kind).to_equal(HighlightKind.Comment)

    it "unwraps both declared block delimiters":
        val tokens = highlight_comments("a /* x */ b", "//", Some(("/*", "*/")))
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].start).to_equal(2)
        expect(tokens[0].end).to_equal(9)
        expect(tokens[0].kind).to_equal(HighlightKind.Comment)

    it "retains integer hexadecimal and signed exponent spans":
        val tokens = highlight_numbers("x 12 0xFA -2.5e+1")
        expect(tokens.len()).to_equal(3)
        expect(tokens[0].start).to_equal(2)
        expect(tokens[0].end).to_equal(4)
        expect(tokens[1].start).to_equal(5)
        expect(tokens[1].end).to_equal(9)
        expect(tokens[2].start).to_equal(10)
        expect(tokens[2].end).to_equal(17)
        expect(tokens[2].kind).to_equal(HighlightKind.Number)

    it "skips an escaped quote inside a string":
        val tokens = highlight_strings("\"a\\\"b\"")
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].start).to_equal(0)
        expect(tokens[0].end).to_equal(6)
        expect(tokens[0].kind).to_equal(HighlightKind.String)
