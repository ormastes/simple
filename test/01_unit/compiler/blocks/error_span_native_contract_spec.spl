use compiler.blocks.context.BlockContext
use compiler.blocks.error_helpers.{error_at, error_span}
use compiler.common.diagnostics.span.Span

describe "real block error source span":
    it "preserves source file, offsets and length":
        val span = Span(start: 10, end: 30, line: 3, col: 5, file: "span.spl", length: 20)
        val ctx = BlockContext(source: "payload", block_kind: "test", span: span, payload_span: span)
        val error = error_span(ctx, "range", (3, 8))
        expect(error.span.start).to_equal(13)
        expect(error.span.end).to_equal(18)
        expect(error.span.file).to_equal("span.spl")
        expect(error.span.length).to_equal(5)
    it "preserves an empty span and source file":
        val span = Span(start: 10, end: 30, line: 3, col: 5, file: "span.spl", length: 20)
        val ctx = BlockContext(source: "payload", block_kind: "test", span: span, payload_span: span)
        val error = error_at(ctx, "empty", 0, 0)
        expect(error.span.start).to_equal(10)
        expect(error.span.end).to_equal(10)
        expect(error.span.file).to_equal("span.spl")
        expect(error.span.length).to_equal(0)
