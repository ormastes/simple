use compiler.blocks.highlighting.{highlight_keywords, highlight_comments}
use compiler.blocks.easy.{define_block}
use compiler.blocks.testing.{mock_block, blockcontext_test, test_parse, test_parse_error, assert_parse_fails, assert_parse_succeeds}
use compiler.blocks.builder.{blockbuilder_new, blockbuilder_parser, blockbuilder_simple_parser}
use compiler.blocks.registry.{register_block, unregister_block, get_block}
use compiler.blocks.definition.{BlockDefinition, HighlightKind}
use compiler.blocks.context.{BlockContext, BlockError, BlockErrorKind}
use compiler.blocks.value.{BlockValue}
use compiler.blocks.modes.{LexerMode}

fn simple_contract_parser(payload: text) -> Result<BlockValue, text>:
    if payload == "bad":
        Err("simple parser rejected bad")
    else:
        Ok(BlockValue.Raw("simple:{payload}"))

fn full_contract_parser(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
    if payload == "bad":
        Err(BlockError.parse("full parser rejected bad").with_span(ctx.payload_span))
    else:
        Ok(BlockValue.Raw("full:{ctx.source}:{payload}"))

fn public_context_contract_parser(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
    if ctx.block_kind != "test" or ctx.source != payload or
            ctx.span.start != 0 or ctx.span.end != payload.len() or
            ctx.payload_span.start != 0 or ctx.payload_span.end != payload.len():
        return Err(BlockError.parse("public helper changed context"))
    if payload == "bad":
        Err(BlockError.parse("context parser rejected bad").with_span(ctx.payload_span))
    else:
        Ok(BlockValue.Raw("{ctx.block_kind}:{ctx.span.length}:{ctx.payload_span.length}"))

struct PublicContextContractBlock:
    keyword: text

impl BlockDefinition for PublicContextContractBlock:
    fn kind() -> text:
        self.keyword

    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        public_context_contract_parser(payload, ctx)

fn expect_raw_result(result: Result<BlockValue, BlockError>, expected: text):
    match result:
        case Ok(value):
            match value:
                case Raw(raw): expect(raw).to_equal(expected)
                case _: panic("Expected Raw block value")
        case Err(error): panic("Unexpected parser failure: {error.message}")

fn expect_parse_error(result: Result<BlockValue, BlockError>, expected: text):
    match result:
        case Ok(_): panic("Expected parser failure")
        case Err(error):
            expect(error.kind).to_equal(BlockErrorKind.Parse)
            expect(error.message).to_equal(expected)

describe "Block highlighting positions":
    it "terminates empty keyword scans at the valid text boundary":
        val tokens = highlight_keywords(" ", [""])
        expect(tokens.len()).to_equal(2)
        expect(tokens[0].start).to_equal(0)
        expect(tokens[0].end).to_equal(0)
        expect(tokens[1].start).to_equal(1)
        expect(tokens[1].end).to_equal(1)
        expect(highlight_keywords("", [""]).len()).to_equal(1)
        expect(highlight_keywords("word", [""]).len()).to_equal(0)
    it "returns no tokens when a keyword is absent":
        expect(highlight_keywords("alpha", ["SELECT"]).len()).to_equal(0)

    it "advances past each repeated keyword and preserves exact positions":
        val tokens = highlight_keywords("SELECT SELECT", ["SELECT"])
        expect(tokens.len()).to_equal(2)
        expect(tokens[0].start).to_equal(0)
        expect(tokens[0].end).to_equal(6)
        expect(tokens[1].start).to_equal(7)
        expect(tokens[1].end).to_equal(13)
        expect(tokens[0].kind).to_equal(HighlightKind.Keyword)
        expect(tokens[1].kind).to_equal(HighlightKind.Keyword)

    it "rejects keyword prefixes and suffixes inside larger words":
        val tokens = highlight_keywords("SELECTOR SELECT SELECT2 SELECT", ["SELECT"])
        expect(tokens.len()).to_equal(2)
        expect(tokens[0].start).to_equal(9)
        expect(tokens[0].end).to_equal(15)
        expect(tokens[1].start).to_equal(24)
        expect(tokens[1].end).to_equal(30)

    it "highlights a configured block comment including its delimiters":
        val tokens = highlight_comments("aa /* hi */ zz", "//", Some(("/*", "*/")))
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].start).to_equal(3)
        expect(tokens[0].end).to_equal(11)
        expect(tokens[0].kind).to_equal(HighlightKind.Comment)

    it "leaves block-comment text alone when no block delimiters are configured":
        expect(highlight_comments("aa /* hi */ zz", "//", nil).len()).to_equal(0)

describe "Typed block parser callbacks":
    it "preserves full context and payload error extents through all public parse helpers":
        val keyword = "phase3_public_helper_context"
        expect(register_block(PublicContextContractBlock(keyword: keyword))).to_equal(true)
        test_parse(keyword, "ok", BlockValue.Raw("test:2:2"))
        test_parse_error(keyword, "bad", "context parser rejected bad")
        match assert_parse_succeeds(keyword, "ok"):
            case Raw(value): expect(value).to_equal("test:2:2")
            case _: panic("public context parser returned wrong value")
        val error = assert_parse_fails(keyword, "bad")
        expect(error.has_span).to_equal(true)
        expect(error.span.start).to_equal(0)
        expect(error.span.end).to_equal(3)
        expect(error.span.length).to_equal(3)
        expect(unregister_block(keyword)).to_equal(true)
    it "preserves simple parser Ok values and wraps text errors in BlockError":
        val parser: BlockDefinition = define_block("phase3_simple_contract", LexerMode.Raw, simple_contract_parser)
        val ctx = blockcontext_test("source")
        expect_raw_result(parser.parse_payload("ok", ctx), "simple:ok")
        expect_parse_error(parser.parse_payload("bad", ctx), "simple parser rejected bad")

    it "preserves mock parser Ok values and wraps text errors in BlockError":
        val parser = mock_block("phase3_mock_contract", simple_contract_parser)
        val ctx = blockcontext_test("source")
        expect_raw_result(parser.parse_payload("ok", ctx), "simple:ok")
        expect_parse_error(parser.parse_payload("bad", ctx), "simple parser rejected bad")

    it "keeps full-context builder callback values and error spans":
        val builder = blockbuilder_parser(blockbuilder_new("phase3_full_contract"), full_contract_parser)
        val ctx = blockcontext_test("source")
        expect_raw_result((builder._parser)("ok", ctx), "full:source:ok")
        val result: Result<BlockValue, BlockError> = (builder._parser)("bad", ctx)
        expect_parse_error(result, "full parser rejected bad")
        match result:
            case Err(error):
                expect(error.has_span).to_equal(true)
                expect(error.span.start).to_equal(0)
                expect(error.span.end).to_equal(6)
                expect(error.span.length).to_equal(6)
            case Ok(_): panic("Expected full-context error span")

    it "converts a simple callback through the builder's actual parser slot":
        val builder = blockbuilder_simple_parser(blockbuilder_new("phase3_builder_simple_contract"), simple_contract_parser)
        val ctx = blockcontext_test("source")
        expect_raw_result((builder._parser)("ok", ctx), "simple:ok")
        expect_parse_error((builder._parser)("bad", ctx), "simple parser rejected bad")

    it "returns Optional registry owners and keeps test helper error.message projections":
        val keyword = "phase3_registry_parser_contract"
        match get_block(keyword):
            case None: pass
            case Some(_): panic("Test registry keyword already registered")
        val parser = mock_block(keyword, simple_contract_parser)
        expect(register_block(parser)).to_equal(true)
        expect(register_block(parser)).to_equal(false)
        match get_block(keyword):
            case Some(owner):
                expect(owner.kind()).to_equal(keyword)
                expect_raw_result(owner.parse_payload("ok", blockcontext_test("source")), "simple:ok")
            case None: panic("Registered parser disappeared")
        test_parse(keyword, "ok", BlockValue.Raw("simple:ok"))
        test_parse_error(keyword, "bad", "rejected bad")
        val error = assert_parse_fails(keyword, "bad")
        expect(error.message).to_equal("simple parser rejected bad")
        expect(unregister_block(keyword)).to_equal(true)
        match get_block(keyword):
            case None: pass
            case Some(_): panic("Unregistered parser remained visible")
