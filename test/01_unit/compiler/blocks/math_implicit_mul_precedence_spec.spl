# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-FEATURE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Implicit Multiplication Precedence Regression

Reproduce case for the `m{}` implicit-multiplication defect: the math parser
decided whether an implicit `*` applied by inspecting the SHAPE of the already
parsed left operand instead of the current token. Shapes that were absent from
that enumeration (`Mul`, `Neg`) made the parser silently DROP the remaining
factors, producing wrong values rather than an error.

Companion defect: `m{ A @ x }` for a matrix and a vector errored with
"matmul requires 2D tensors" instead of applying the usual NumPy promotion of
a 1D operand.
"""

use std.spec.step

describe "m{} implicit multiplication precedence":
    context "chained factors":
        it "keeps every factor in a chain of groups":
            # @req REQ-SSPEC-FEATURE
            step("keeps every factor in a chain of groups")

            val a = 2
            # Before the fix the third group was dropped and this yielded 4.
            val result = m{ (a)(a)(a) }
            expect result == 8

        it "keeps every factor in a chain of identifiers":
            # @req REQ-SSPEC-FEATURE
            step("keeps every factor in a chain of identifiers")

            val x = 2
            val y = 3
            val z = 5
            val result = m{ x y z }
            expect result == 30

    context "negated left operand":
        it "applies a negative coefficient to the whole product":
            # @req REQ-SSPEC-FEATURE
            step("applies a negative coefficient to the whole product")

            val x = 3
            # Before the fix `x` was dropped and this yielded -2.
            val result = m{ -2x }
            expect result == -6

        it "multiplies a negated identifier by the next factor":
            # @req REQ-SSPEC-FEATURE
            step("multiplies a negated identifier by the next factor")

            val x = 3
            val y = 2
            # Before the fix `y` was dropped and this yielded -3.
            val result = m{ -x y }
            expect result == -6

    context "power still binds tighter than implicit multiplication":
        it "reads 2x^3 as 2*(x^3)":
            # @req REQ-SSPEC-FEATURE
            step("reads 2x^3 as 2*(x^3)")

            val x = 2
            val result = m{ 2x^3 }
            expect result == 16.0

    context "matrix times vector":
        it "promotes a 1D right operand and drops the promoted axis":
            # @req REQ-SSPEC-FEATURE
            step("promotes a 1D right operand and drops the promoted axis")

            val A = [[1.0, 0.0], [0.0, 1.0]]
            val x = [1.0, 2.0]
            val b = [3.0, 4.0]
            # Before the fix this errored with "matmul requires 2D tensors".
            val result = m{ 2(A @ x) + b }
            expect result == [5.0, 8.0]
