# The sql/shell block helpers return the payload types BlockValue.Sql/Shell
# declare (the pure-Simple MIR rejected the old raw-text returns).
use std.spec.*
use compiler.blocks.builtin_blocks_helpers.{parse_sql_query, parse_shell_commands}
use compiler.blocks.value.{SqlKind}

describe "builtin block helpers":
    it "builds typed SqlQuery and ShellCommands values that keep the raw payload":
        val q = parse_sql_query("  select a from t")
        expect(q.raw).to_equal("  select a from t")
        expect(q.kind == SqlKind.Select).to_equal(true)
        expect(parse_sql_query("VACUUM").kind == SqlKind.Other).to_equal(true)
        val s = parse_shell_commands("ls -la")
        expect(s.raw).to_equal("ls -la")
        expect(s.commands.len()).to_equal(0)
