# Purpose and audience: regression spec for nil sub-pattern inside Ok over Result<T?, E>.
# @req REQ-SSPEC-UNIT
# UNEXECUTED: written with the compiler fix; the Stage-2 binary predates the fix, so it was not run.
# Bug: doc/08_tracking/bug/match_nil_subpattern_requires_declared_optional_slot_2026-10-24.md

use std.spec

fn classify(r: Result<text?, text>) -> text:
    match r:
        case Ok(Some(code)): "some:" + code
        case Err(e): "err:" + e
        case Ok(nil): "none"

describe("Ok(nil) sub-pattern over Result<text?, text>"):
    it("matches the nil payload and keeps the other arms"):
        assert_equal(classify(Ok(Some("x"))), "some:x")
        assert_equal(classify(Ok(nil)), "none")
        assert_equal(classify(Err("bad")), "err:bad")
