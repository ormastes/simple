fn todo_message(calls: [text], wrappers: [text], spaces: text) -> text:
    val message = if calls.len() == 1:
        "{spaces}replace {calls[0]} with {wrappers[0]}"
    else:
        "{spaces}replace direct calls with wrappers"
    message

describe "nonempty multiline if assignment":
    it "parses and selects the exact single-call branch shape":
        expect(todo_message(["rt_open"], ["file_open"], "  ")).to_equal("  replace rt_open with file_open")

    it "keeps the adjacent nonempty else branch":
        expect(todo_message(["rt_open", "rt_close"], ["file_open", "file_close"], "")).to_equal("replace direct calls with wrappers")
