# @req REQ-GENERIC-OWNER-TRANSPORT
# @tag: unit, compiler, mir, generics
use std.spec.{describe, it, expect}
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.Span
use compiler.mir.mir_lowering_types.MirLowering
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLowering.module_lowering.*

describe "MIR consumes relocated generic return owners":
    it "rejects a missing caller declaration instead of assigning a layout":
        var lowering = MirLowering.new(SymbolTable.new())
        val type_ = HirType(kind: HirTypeKind.Named(SymbolId(id: 77), []), span: Span.empty())
        expect(lowering.mono_caller_return_owner(type_)).to_equal("")
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].fatal).to_be(true)
        expect(lowering.errors[0].message).to_contain("E-MIR-MONO-RETURN-OWNER")

    it "uses the declaration spelling despite a bare-name decoy layout":
        var symbols = SymbolTable.new()
        val id = symbols.define("Node", SymbolKind.Struct, nil, Span.empty(), Visibility.Public, false, "lib.nodes")
        var lowering = MirLowering.new(symbols)
        lowering.struct_field_order["Node"] = ["wrong"]
        lowering.struct_field_order["lib/nodes.spl::Node"] = ["id", "names"]
        lowering.struct_identity_layout_key["lib.nodes::Node"] = "lib/nodes.spl::Node"
        val type_ = HirType(kind: HirTypeKind.Named(id, []), span: Span.empty())
        expect(lowering.mono_caller_return_owner(type_)).to_equal("lib/nodes.spl::Node")
        expect(lowering.errors.len()).to_equal(0)
