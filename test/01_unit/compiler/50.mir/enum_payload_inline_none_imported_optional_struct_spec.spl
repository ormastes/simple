# Purpose and audience: compiler engineers owning MIR enum-constructor payload admission.
# @req REQ-SSPEC-COMPILER
"""
# Inline `None` into an imported `Struct?` enum payload slot lowers as the typed None word

Bug mir_enum_payload_inline_none_lowered_as_nil_2026-11-10. The failing site,
`src/compiler/60.mir_opt/mir_opt/string_builder_opt.spl:197`, constructs
`MirInstKind.Call(None, sb_fn_operand(..), [sb_op, p.suffix])` where every
type is IMPORTED through the `compiler.mir.mir` facade re-export, inside a
class `me` method, a `while` loop, an `if val` arm and a struct-literal field
initializer that is itself a method-call argument. The sibling prevention spec
(`enum_payload_inline_none_contexts_spec.spl`) declares the types in the
consumer module; this one mirrors the real cross-module shape and inspects the
lowered MIR instead of only the error list.
"""
# @cover src/compiler/50.mir/_MirLoweringExpr/enum_constructor_payload.spl
# @tag:unit
# @tag:compiler
# @tag:mir
use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val data_source = "pub struct LocalId:\n    id: i64\n\npub enum Op:\n    Copy(id: LocalId)\n    Const(v: i64)\n\npub struct Operand:\n    kind: Op\n\npub enum Kind:\n    Call(dest: LocalId?, func: Operand, args: [Operand])\n    Arr(elem: i64, size: i64?)\n    Both(a: LocalId?, b: LocalId?)\n    Nop\n\npub struct Inst:\n    kind: Kind\n    span: i64?\n\npub struct Pair:\n    s_id: i64\n    suffix: Operand\n\npub fn pair_of(i: i64) -> Pair?:\n    if i > 0: return Some(Pair(s_id: i, suffix: Operand(kind: Op.Const(i))))\n    None\n\npub fn fn_operand(name: text, t: i64) -> Operand:\n    Operand(kind: Op.Const(t))\n"

val facade_source = "use lib.data.*\n\nexport use lib.data.\{LocalId, Op, Operand, Kind, Inst, Pair, pair_of, fn_operand\}\n"

val apply_body = "class Opt:\n    n: i64\n\n    me apply(src: [i64], sb_op: Operand) -> [Inst]:\n        var insts: [Inst] = []\n        var i = 0\n        while i < src.len():\n            if i + 1 < src.len():\n                val pair = pair_of(src[i])\n                if val p = pair:\n                    if p.s_id == self.n:\n                        insts.push(Inst(kind: Kind.Call(None, fn_operand(\"push\", 1), [sb_op, p.suffix]), span: None))\n                        i = i + 2\n                        continue\n            i = i + 1\n        insts\n"

struct Probe:
    errors: text
    payload_consts: text

fn describe_type(t: MirType) -> text:
    match t.kind:
        case MirTypeKind.I64: "i64"
        case MirTypeKind.Unit: "unit"
        case MirTypeKind.Ptr(_): "ptr"
        case _: "other"

fn describe_const(value: MirConstValue, t: MirType) -> text:
    match value:
        case MirConstValue.Int(v): "Int({v}):" + describe_type(t)
        case MirConstValue.Str(s): "Str({s})"
        case _: "const"

fn probe(body: text) -> Probe:
    val consumer_source = "use lib.facade.*\n\n" + body
    val log = Logger(level: 0)
    val data_ast = parse_full_frontend(data_source, "lib/data.spl", "lib.data", log)
    val facade_ast = parse_full_frontend(facade_source, "lib/facade.spl", "lib.facade", log)
    val consumer_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.data"] = data_ast
    modules["lib.facade"] = facade_ast
    val sources = [SourceFile(path: "lib/data.spl", content: data_source, module_name: "lib.data"), SourceFile(path: "lib/facade.spl", content: facade_source, module_name: "lib.facade")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var data_lowering = hirlowering_for_module("lib.data", surfaces)
    var facade_lowering = hirlowering_for_module("lib.facade", surfaces)
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val data_hir = data_lowering.lower_module(data_ast)
    val facade_hir = facade_lowering.lower_module(facade_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    var prescan_mods: Dict<text, HirModule> = {}
    prescan_mods["data_hir"] = data_hir
    prescan_mods["facade_hir"] = facade_hir
    prescan_mods["consumer_hir"] = consumer_hir
    mir_lowering.prescan_module_struct_names(prescan_mods, "data_hir")
    mir_lowering.prescan_module_struct_names(prescan_mods, "facade_hir")
    mir_lowering.prescan_module_struct_names(prescan_mods, "consumer_hir")
    val mir = mir_lowering.lower_module(consumer_hir, [data_hir, facade_hir, consumer_hir])
    var out = ""
    for e in consumer_lowering.errors:
        out = out + "hir: " + e.message + "\n"
    for e in mir_lowering.errors:
        out = out + "mir: " + e.message + "\n"
    # Collect every integer const feeding the enum-payload tuple writer in the
    # consumer's `apply` function: `rt_tuple_set(tuple, index, word)`.
    var consts: Dict<i64, text> = {}
    var payload = ""
    for fn_entry in mir.functions:
        val f = fn_entry.1
        if not f.name.contains("apply"): continue
        for block in f.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Const(dest, value, t):
                        consts[dest.id] = describe_const(value, t)
                    case MirInstKind.Call(_, func, args):
                        var callee = ""
                        match func.kind:
                            case MirOperandKind.Const(fv, _):
                                match fv:
                                    case MirConstValue.Str(s): callee = s
                                    case _: ()
                            case _: ()
                        if callee != "rt_tuple_set" or args.len() != 3: continue
                        match args[2].kind:
                            case MirOperandKind.Copy(l) | MirOperandKind.Move(l):
                                payload = payload + (consts.get(l.id) ?? "local") + ";"
                            case MirOperandKind.Const(cv, ct):
                                payload = payload + describe_const(cv, ct) + ";"
                            case _: ()
                    case _: ()
    print "errors: [{out}] payload: [{payload}]"
    Probe(errors: out, payload_consts: payload)

describe "inline None into an imported LocalId? enum payload slot (string_builder_opt shape)":
    """Each payload argument of a 2+-arg constructor is bound once and lowered
    once; the `Struct?` slot word is the typed None constant `Int(3):i64`."""
    it "admits the constructor without a payload-type diagnostic":
        val r = probe(apply_body)
        expect(r.errors).to_equal("")

    it "lowers the None slot as the typed None word, not a nil literal rejection":
        val r = probe(apply_body)
        expect(r.payload_consts.contains("Int(3):i64")).to_be_true()

    it "rejects a bare nil in the same slot (non-vacuity)":
        val r = probe(apply_body.replace("Kind.Call(None,", "Kind.Call(nil,"))
        expect(r.errors.contains("nil outside unsafe into optional payload slot")).to_be_true()

    it "sibling shape: None in the trailing slot of a 2-arg imported payload (HirTypeKind.Array(elem, None))":
        val r = probe("fn apply(n: i64) -> Kind:\n    Kind.Arr(n, None)\n")
        expect(r.errors).to_equal("")
        expect(r.payload_consts.contains("Int(3):i64")).to_be_true()

    it "sibling shape: None in both slots of a 2-arg imported payload":
        val r = probe("fn apply() -> Kind:\n    Kind.Both(None, None)\n")
        expect(r.errors).to_equal("")
        expect(r.payload_consts).to_equal("Int(3):i64;Int(3):i64;")
