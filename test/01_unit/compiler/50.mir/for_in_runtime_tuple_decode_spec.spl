# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: for-in over RUNTIME tuples rebuilds native tuples

`for (i, x) in xs.enumerate()` printed garbage natively
(`acc=,258:2,258:2,258:2` for `["a", "b", "c"]`). The runtime builds each pair
with `rt_tuple_new` -- a HEAP object with a length/flags header -- while the
loop's `(i, x)` destructure reads its variable with `GetField`, which is only
valid on a NATIVE tuple (a bare block of fields built by an `Aggregate`).
Reading fields 0 and 1 of the heap object returned its header words.

The lowering must therefore convert every runtime tuple into a native one
before the loop sees it: one `rt_tuple_get` per slot, each slot decoded by its
own field type, then an `Aggregate`. The same holds for `for (k, v) in dict`,
whose `rt_dict_entries` pairs are the same heap tuples.
"""

# @tag: unit, compiler, mir, builtins, for-in

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

struct TupleLowered:
    messages: [text]
    fatal: [text]
    callees: [text]
    aggregates: i64
    get_fields: i64

fn tuple_lower(src: text) -> TupleLowered:
    val file = "testdata/fixture_runtime_tuple.spl"
    val parsed = parse_full_frontend(src, file, "fixture_runtime_tuple", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(hir)
    var messages: [text] = []
    var fatal: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
        if e.fatal:
            fatal = fatal.push(e.message)
    var callees: [text] = []
    var aggregates = 0
    var get_fields = 0
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                callees = callees.push(name)
                            case _: pass
                    case MirInstKind.Aggregate(_, aggregate_kind, _):
                        # Native TUPLES only: an array literal is an Aggregate too.
                        match aggregate_kind:
                            case AggregateKind.Tuple: aggregates = aggregates + 1
                            case _: pass
                    case MirInstKind.GetField(_, _, _):
                        get_fields = get_fields + 1
                    case _: pass
    TupleLowered(messages: messages, fatal: fatal, callees: callees, aggregates: aggregates, get_fields: get_fields)

fn tuple_count(items: [text], wanted: text) -> i64:
    var n = 0
    for item in items:
        if item == wanted:
            n = n + 1
    n

# The conversion contract: no diagnostics, both slots read through the
# runtime tuple accessor, a native tuple built, and the destructure still
# reading that native tuple's two fields.
fn tuple_expect_converted(low: TupleLowered, producer: text):
    for m in low.messages:
        print "diagnostic: {m}"
    expect(low.messages.len()).to_equal(0)
    print "shape: {producer}={tuple_count(low.callees, producer)} rt_tuple_get={tuple_count(low.callees, "rt_tuple_get")} aggregates={low.aggregates} get_fields={low.get_fields} int_renders={tuple_count(low.callees, "rt_raw_i64_to_string")}"
    expect(tuple_count(low.callees, producer)).to_equal(1)
    expect(tuple_count(low.callees, "rt_tuple_get")).to_equal(2)
    expect(low.aggregates).to_equal(1)
    expect(low.get_fields).to_equal(2)

describe "for-in over enumerate(): runtime pairs become native tuples":
    it "the differential fixture: an untyped text array literal, index and element interpolated":
        val low = tuple_lower("fn main() -> i64:\n" +
            "    val xs = [\"a\", \"b\", \"c\"]\n" +
            "    var acc = \"\"\n" +
            "    for (i, x) in xs.enumerate():\n" +
            "        if i > 0:\n" +
            "            acc = acc + \",\"\n" +
            "        acc = acc + \"\{i\}:\{x\}\"\n" +
            "    print \"acc=\{acc\}\"\n" +
            "    0\n")
        tuple_expect_converted(low, "rt_array_enumerate")
        # `i` is rendered as an integer; `x` is TEXT and must not be: an
        # element decoded as i64 would add a second integer render.
        expect(tuple_count(low.callees, "rt_raw_i64_to_string")).to_equal(1)

    it "i64 elements":
        val low = tuple_lower("fn f(xs: [i64]) -> i64:\n" +
            "    var s = 0\n" +
            "    for (i, x) in xs.enumerate():\n" +
            "        s = s + i + x\n" +
            "    s\n")
        tuple_expect_converted(low, "rt_array_enumerate")

    it "text elements of a declared [text]":
        val low = tuple_lower("fn f(ts: [text]) -> i64:\n" +
            "    var s = 0\n" +
            "    for (i, t) in ts.enumerate():\n" +
            "        s = s + i * t.len()\n" +
            "    s\n")
        tuple_expect_converted(low, "rt_array_enumerate")
        expect(tuple_count(low.callees, "rt_string_len") + tuple_count(low.callees, "rt_len")).to_equal(1)

    it "f64 elements":
        val low = tuple_lower("fn f(fs: [f64]) -> f64:\n" +
            "    var s = 0.0\n" +
            "    for (i, v) in fs.enumerate():\n" +
            "        s = s + v + i.to_f64()\n" +
            "    s\n")
        tuple_expect_converted(low, "rt_array_enumerate")

    it "bool elements":
        val low = tuple_lower("fn f(bs: [bool]) -> i64:\n" +
            "    var s = 0\n" +
            "    for (i, b) in bs.enumerate():\n" +
            "        if b:\n" +
            "            s = s + i\n" +
            "    s\n")
        tuple_expect_converted(low, "rt_array_enumerate")

    it "struct elements are rejected, fatally and with a panic placeholder":
        val low = tuple_lower("struct P:\n" +
            "    lo: i64\n" +
            "\n" +
            "fn f(ps: [P]) -> i64:\n" +
            "    var s = 0\n" +
            "    for (i, p) in ps.enumerate():\n" +
            "        s = s + i + p.lo\n" +
            "    s\n")
        var rejected = false
        for m in low.fatal:
            if m.contains("array.enumerate()") and m.contains("non-primitive"):
                rejected = true
        if not rejected:
            for m in low.messages:
                print "diagnostic: {m}"
        expect(rejected).to_equal(true)
        expect(tuple_count(low.callees, "rt_panic") > 0).to_equal(true)
        expect(tuple_count(low.callees, "rt_array_enumerate")).to_equal(0)

describe "for-in over a dict by pair: runtime entries become native tuples":
    it "text keys and i64 values":
        val low = tuple_lower("fn f(d: Dict<text, i64>) -> i64:\n" +
            "    var s = 0\n" +
            "    for (k, v) in d:\n" +
            "        s = s + k.len() + v\n" +
            "    s\n")
        tuple_expect_converted(low, "rt_dict_entries")

    it "i64 keys and text values":
        val low = tuple_lower("fn f(d: Dict<i64, text>) -> i64:\n" +
            "    var s = 0\n" +
            "    for (k, v) in d:\n" +
            "        s = s + k + v.len()\n" +
            "    s\n")
        tuple_expect_converted(low, "rt_dict_entries")
