use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_decoder.{strict_riscv_scalar_decoder_hwir}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{strict_hw_scalar_decoded_uop_interface}
use compiler.mir.hwir.riscv_scalar_completion_interface.{strict_hw_scalar_completion_interface}
use compiler.mir.hwir.riscv_scalar_pending_provider_protocol.{
    HwScalarPendingProviderProtocol, HwScalarPendingProviderTag,
    HwScalarPendingProtocolField, strict_hw_scalar_pending_provider_protocol}
use lib.hardware.riscv_common.isa.scalar_database.{riscv_scalar_decoder_plan}

fn fixture(config: CoreConfig):
    val plan = riscv_scalar_decoder_plan(config.isa_profile).unwrap()
    val decoder = strict_riscv_scalar_decoder_hwir("pending_protocol_decoder", config, plan).unwrap()
    val decoded = strict_hw_scalar_decoded_uop_interface(config, plan, decoder).unwrap()
    val completion = strict_hw_scalar_completion_interface(config,
        if config.xlen == 32: LsuConfig.rv32_product_default() else: LsuConfig.rv64_product_default()).unwrap()
    (plan, decoder, decoded, completion)

describe "frozen scalar pending-provider protocol v1":
    it "should bind four providers to exact schemas without duplicating payloads":
        val config = CoreConfig.rv64_zca_mission_critical()
        val (plan, decoder, decoded, completion) = fixture(config)
        val protocol = strict_hw_scalar_pending_provider_protocol(
            config, decoded, decoder, plan, completion).unwrap()
        expect(protocol.diagnostic_for_interfaces(decoded, decoder, plan, completion)).to_equal("")
        expect(protocol.provider_tag_width).to_equal(3)
        expect(protocol.provider_tags.len()).to_equal(4)
        expect(protocol.provider_tags[0].name).to_equal("lsu")
        expect(protocol.provider_tags[0].value).to_equal(1)
        expect(protocol.provider_tags[3].name).to_equal("fence")
        expect(protocol.provider_tags[3].value).to_equal(4)
        expect(protocol.fields.len()).to_equal(12)
        expect(protocol.fields[0].name).to_equal("request_valid")
        expect(protocol.fields[5].name).to_equal("completion_valid")
        expect(protocol.decoded_uop_schema_sha256).to_equal(decoded.structural_sha256())
        expect(protocol.completion_schema_sha256).to_equal(completion.structural_sha256())
        expect(protocol.state_owner).to_equal("sequential-dispatcher-and-provider-owners")
        expect(protocol.structural_sha256().len()).to_equal(64)

    it "should freeze plan config tag field and fault-rule identity":
        val config = CoreConfig.rv32()
        val (plan, decoder, decoded, completion) = fixture(config)
        val base = strict_hw_scalar_pending_provider_protocol(
            config, decoded, decoder, plan, completion).unwrap()
        var bad_tags = base.provider_tags
        bad_tags[1] = HwScalarPendingProviderTag(name: "muldiv", value: 3)
        val tag_drift = HwScalarPendingProviderProtocol(version: base.version, config: base.config,
            plan_sha256: base.plan_sha256, decoded_uop_schema_sha256: base.decoded_uop_schema_sha256,
            completion_schema_sha256: base.completion_schema_sha256,
            provider_tag_width: base.provider_tag_width, provider_tags: bad_tags,
            fields: base.fields, rules: base.rules, state_owner: base.state_owner)
        expect(tag_drift.diagnostic_for_interfaces(decoded, decoder, plan, completion)).to_contain("TAG")
        var bad_fields = base.fields
        bad_fields[2] = HwScalarPendingProtocolField(name: "request_provider_tag",
            direction: "dispatcher-to-provider", bit_width: 2,
            semantic: "accepted-provider-owner-zero-reserved-invalid")
        val field_drift = HwScalarPendingProviderProtocol(version: base.version, config: base.config,
            plan_sha256: base.plan_sha256, decoded_uop_schema_sha256: base.decoded_uop_schema_sha256,
            completion_schema_sha256: base.completion_schema_sha256,
            provider_tag_width: base.provider_tag_width, provider_tags: base.provider_tags,
            fields: bad_fields, rules: base.rules, state_owner: base.state_owner)
        expect(field_drift.diagnostic_for_interfaces(decoded, decoder, plan, completion)).to_contain("FIELD")
        var bad_rules = base.rules
        bad_rules[4] = "completion-may-ignore-lineage"
        val rule_drift = HwScalarPendingProviderProtocol(version: base.version, config: base.config,
            plan_sha256: base.plan_sha256, decoded_uop_schema_sha256: base.decoded_uop_schema_sha256,
            completion_schema_sha256: base.completion_schema_sha256,
            provider_tag_width: base.provider_tag_width, provider_tags: base.provider_tags,
            fields: base.fields, rules: bad_rules, state_owner: base.state_owner)
        expect(rule_drift.diagnostic_for_interfaces(decoded, decoder, plan, completion)).to_contain("RULE")
        val plan_drift = HwScalarPendingProviderProtocol(version: base.version, config: base.config,
            plan_sha256: "not-the-selected-plan", decoded_uop_schema_sha256: base.decoded_uop_schema_sha256,
            completion_schema_sha256: base.completion_schema_sha256,
            provider_tag_width: base.provider_tag_width, provider_tags: base.provider_tags,
            fields: base.fields, rules: base.rules, state_owner: base.state_owner)
        expect(plan_drift.diagnostic_for_interfaces(decoded, decoder, plan, completion)).to_contain("SCHEMA")
        val completion_drift = HwScalarPendingProviderProtocol(version: base.version, config: base.config,
            plan_sha256: base.plan_sha256, decoded_uop_schema_sha256: base.decoded_uop_schema_sha256,
            completion_schema_sha256: "not-the-shared-completion-schema",
            provider_tag_width: base.provider_tag_width, provider_tags: base.provider_tags,
            fields: base.fields, rules: base.rules, state_owner: base.state_owner)
        expect(completion_drift.diagnostic_for_interfaces(decoded, decoder, plan, completion)).to_contain("SCHEMA")

    it "should reject cross-plan and cross-config schema reuse":
        val rv32 = CoreConfig.rv32()
        val rv64 = CoreConfig.rv64()
        val (plan32, decoder32, decoded32, completion32) = fixture(rv32)
        val (plan64, decoder64, decoded64, completion64) = fixture(rv64)
        val protocol = strict_hw_scalar_pending_provider_protocol(
            rv32, decoded32, decoder32, plan32, completion32).unwrap()
        expect(protocol.diagnostic_for_interfaces(
            decoded64, decoder64, plan64, completion64)).to_contain("CONFIG")
