use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirEnum}
use compiler.mir.mir.*

fn membership_module(source: text) -> HirModule:
    val parsed = parse_full_frontend(source, "enum_membership.spl", "enum_membership", Logger(level: 0))
    expect(parsed.enums.len()).to_equal(1)
    var lowering = HirLowering.with_filename("enum_membership.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.enums.len()).to_equal(1)
    module

fn membership_enum(module: HirModule) -> HirEnum:
    val keys = module.enums.keys()
    module.enums[keys[0]]

describe "MIR discriminant membership preserves registration diagnostics":
    it "preserves implicit values, explicit resets, payload slots and quiet re-registration":
        val module = membership_module("enum Code:\n    A\n    B(i64) = 5\n    C\n    D = 2\n")
        val declaration = membership_enum(module)
        var lowering = MirLowering.new(module.symbols)
        lowering.register_enum_variants(declaration)
        lowering.register_enum_variants(declaration)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.enum_variant_names("Code")).to_equal(["A", "B", "C", "D"])
        expect(lowering.enum_variant_discriminants["Code"]).to_equal([0, 5, 6, 2])
        expect(lowering.enum_variant_discriminants_q[declaration.runtime_name]).to_equal([0, 5, 6, 2])
        expect(lowering.enum_variant_payload_arity("Code::B")).to_equal(1)

    it "reports one error per later duplicate in source order with original spans":
        val module = membership_module("enum Code:\n    A = 2\n    B = 2\n    C = 7\n    D = 2\n")
        val declaration = membership_enum(module)
        var lowering = MirLowering.new(module.symbols)
        lowering.register_enum_variants(declaration)
        expect(lowering.enum_variant_discriminants["Code"]).to_equal([2, 2, 7, 2])
        expect(lowering.errors.len()).to_equal(2)
        var i = 0
        for variant_index in [1, 3]:
            expect(lowering.errors[i].message).to_equal("enum 'Code' has duplicate discriminant 2")
            expect(lowering.errors[i].fatal).to_equal(true)
            expect(lowering.errors[i].span).to_equal(Some(declaration.variants[variant_index].span))
            i = i + 1

    it "retains invalid values in duplicate membership after range errors":
        val module = membership_module("enum Code:\n    A = -1\n    B = -1\n    C = 2147483647\n    D\n    E = 2147483648\n")
        var lowering = MirLowering.new(module.symbols)
        lowering.register_enum_variants(membership_enum(module))
        expect(lowering.enum_variant_discriminants["Code"]).to_equal([-1, -1, 2147483647, 2147483648, 2147483648])
        var messages: [text] = []
        for error in lowering.errors:
            expect(error.fatal).to_equal(true)
            messages.push(error.message)
        expect(messages).to_equal([
            "enum variant 'Code.A' discriminant -1 is outside portable runtime range 0..2147483647",
            "enum variant 'Code.B' discriminant -1 is outside portable runtime range 0..2147483647",
            "enum 'Code' has duplicate discriminant -1",
            "enum variant 'Code.D' discriminant 2147483648 is outside portable runtime range 0..2147483647",
            "enum variant 'Code.E' discriminant 2147483648 is outside portable runtime range 0..2147483647",
            "enum 'Code' has duplicate discriminant 2147483648"])

    it "preserves noninteger fold errors and the fallback effective discriminant":
        val module = membership_module("enum Code:\n    A = true\n    B = 0\n")
        var lowering = MirLowering.new(module.symbols)
        lowering.register_enum_variants(membership_enum(module))
        expect(lowering.enum_variant_discriminants["Code"]).to_equal([0, 0])
        expect(lowering.errors.len()).to_equal(2)
        expect(lowering.errors[0].message).to_equal("enum variant 'Code.A' discriminant must be an integer constant")
        expect(lowering.errors[1].message).to_equal("enum 'Code' has duplicate discriminant 0")

    it "registers a large implicit enum through the real parser and MIR consumer":
        var lines: [text] = ["enum Code:"]
        var i = 0
        while i < 2049:
            lines.push("    Variant" + i.to_text())
            i = i + 1
        val module = membership_module(lines.join("\n") + "\n")
        var lowering = MirLowering.new(module.symbols)
        lowering.register_enum_variants(membership_enum(module))
        expect(lowering.errors.len()).to_equal(0)
        val values = lowering.enum_variant_discriminants["Code"]
        expect(values.len()).to_equal(2049)
        i = 0
        while i < values.len():
            expect(values[i]).to_equal(i)
            i = i + 1
