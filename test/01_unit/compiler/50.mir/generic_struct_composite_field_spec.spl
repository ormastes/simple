# @req REQ-SSPEC-COMPILER
# @req REQ-GENERIC-ANNOTATION-FIELD
# @req REQ-GENERIC-ANNOTATION-DIAGNOSTIC
# @tag: unit, compiler, mir, mono, generics
#
# A generic struct's field can hold its type parameter directly (`item: T`,
# BUG-IT-6) or inside a container (`items: [T]`, `first: T?`). A value that
# leaves the instance through such a field -- an element load, a `??`
# default, a method's `self.item` -- must be typed by the INSTANTIATION, so
# `b.items[0] + b.items[1]` on a `Bag<text>` is a string concatenation and
# the same expression on a `Bag<i64>` is an integer add.
#
# The methods of a same-module `impl<T> Box<T>` (BUG-IT-3, stage2 micro_e)
# are specialized by the receiver the constructor builds: the call site must
# name `Box__get$<T>` and that specialization must be defined, with the
# return representation of the instantiation.
#
# Each example runs HIR -> 40.mono -> 50.mir -> MirToLlvm in-process and reads
# the LLVM text of ONE function (`probe`), so a runtime `declare` line or
# another function's body cannot satisfy an assertion.
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mono.monomorphize_integration.{run_monomorphization_with_report}

val MODULE = "gcf_probe"

val PRELUDE = "struct Box<T>:\n" +
    "    item: T\n" +
    "\n" +
    "impl<T> Box<T>:\n" +
    "    fn get(self) -> T:\n" +
    "        self.item\n" +
    "\n" +
    "struct Bag<T>:\n" +
    "    items: [T]\n" +
    "    first: T?\n" +
    "\n"

struct Shaped:
    ir: text
    errors: [text]
    warnings: [text]

fn shape(body: text) -> Shaped:
    val src = PRELUDE + body
    val file = "testdata/gcf_probe.spl"
    var hl = HirLowering.with_filename(file)
    val hir = hl.lower_module(parse_full_frontend(src, file, MODULE, Logger(level: 0)))
    var errors: [text] = []
    for e in hl.errors:
        errors.push("hir: " + e.message)
    var mods: Dict<text, HirModule> = {}
    mods[MODULE] = hir
    val (mono, _stats, diags, warnings) = run_monomorphization_with_report(mods)
    for d in diags:
        errors.push("mono: " + d)
    val m: HirModule = mono[MODULE]
    var lowering = MirLowering.new_for_target(m.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(m)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        errors.push("mir: " + e.message)
    val ir = MirToLlvm.create(MODULE, CodegenTarget.X86_64, nil).translate_module(mir)
    Shaped(ir: ir, errors: errors, warnings: warnings)

fn function_body(ir: text, fn_name: text) -> [text]:
    """Lines of the LLVM function whose `define` names `fn_name`."""
    var out: [text] = []
    var inside = false
    for line in ir.split("\n"):
        val l: text = line
        if l.starts_with("define ") and (l.contains("." + fn_name + "(") or l.contains("@" + fn_name + "(")):
            inside = true
        if inside:
            out = out.push(l)
            if l.len() == 1:
                inside = false
    out

fn concatenates(lines: [text]) -> bool:
    """True when these lines CALL a string concatenation (the runtime's
    `declare ... @rt_strcat` is in every module, so only a call counts)."""
    for line in lines:
        val l: text = line
        if l.contains("call ") and (l.contains("@rt_strcat") or l.contains("@rt_string_concat")):
            return true
    false

fn adds_integers(lines: [text]) -> bool:
    for line in lines:
        val l: text = line
        if l.contains(" = add ") and l.contains(" i64 %") and not l.contains("; "):
            return true
    false

fn verdict(s: Shaped, fn_name: text) -> text:
    """`concat`, `add`, or the first diagnostic."""
    if s.errors.len() > 0:
        return s.errors[0]
    val body = function_body(s.ir, fn_name)
    if body.len() == 0:
        return "no function {fn_name}"
    if concatenates(body):
        return "concat"
    if adds_integers(body):
        return "add"
    "neither"

fn define_of(s: Shaped, fn_name: text) -> text:
    val body = function_body(s.ir, fn_name)
    if body.len() == 0:
        return ""
    body[0]

fn calls(s: Shaped, caller: text, callee: text) -> bool:
    for line in function_body(s.ir, caller):
        val l: text = line
        if l.contains("call ") and l.contains(callee + "("):
            return true
    false

describe "methods of a same-module generic impl are specialized by the receiver (BUG-IT-3)":
    it "micro_e: Box<i64>(item: 7).get() calls a defined Box__get$i64 returning i64":
        val s = shape(
            "fn probe() -> i64:\n" +
            "    val bx = Box<i64>(item: 7)\n" +
            "    bx.get() + 1\n")
        expect(verdict(s, "probe")).to_equal("add")
        expect(define_of(s, "Box__get$i64").starts_with("define i64 ")).to_equal(true)
        expect(calls(s, "probe", "Box__get$i64")).to_equal(true)
        # No call may still name the unspecialized template.
        expect(s.ir.contains("Box.get(")).to_equal(false)

    it "the text instance returns a pointer and its result concatenates":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val bx = Box(item: \"a\")\n" +
            "    val v = bx.get()\n" +
            "    v + \"b\"\n")
        expect(verdict(s, "probe")).to_equal("concat")
        expect(define_of(s, "Box__get$str").starts_with("define ptr ")).to_equal(true)
        expect(calls(s, "probe", "Box__get$str")).to_equal(true)

    it "two instantiations in one function get two specializations":
        val s = shape(
            "fn probe() -> i64:\n" +
            "    val a = Box(item: 7)\n" +
            "    val b = Box(item: \"x\")\n" +
            "    a.get() + b.get().len()\n")
        expect(s.errors.len()).to_equal(0)
        expect(calls(s, "probe", "Box__get$i64")).to_equal(true)
        expect(calls(s, "probe", "Box__get$str")).to_equal(true)

describe "container fields of a generic struct take the element type of the instance":
    it "[T] at text: element + element is a string concatenation":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val b = Bag(items: [\"a\", \"b\"], first: \"a\")\n" +
            "    b.items[0] + b.items[1]\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "[T] at i64: element + element is an integer add":
        val s = shape(
            "fn probe() -> i64:\n" +
            "    val b = Bag(items: [1, 2], first: 1)\n" +
            "    b.items[0] + b.items[1]\n")
        expect(verdict(s, "probe")).to_equal("add")

    it "T? at text: the coalesced payload concatenates":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val b = Bag(items: [\"a\"], first: \"a\")\n" +
            "    val f = b.first ?? \"z\"\n" +
            "    f + f\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "T? at i64: the coalesced payload adds as an integer":
        val s = shape(
            "fn probe() -> i64:\n" +
            "    val b = Bag(items: [1], first: 1)\n" +
            "    val f = b.first ?? 0\n" +
            "    f + f\n")
        expect(verdict(s, "probe")).to_equal("add")

    it "a loop over a [T] field binds the element type":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val b = Bag(items: [\"a\", \"b\"], first: \"a\")\n" +
            "    var out = \"\"\n" +
            "    for s in b.items:\n" +
            "        out = out + s\n" +
            "    out\n")
        expect(verdict(s, "probe")).to_equal("concat")

fn call_line(s: Shaped, caller: text, callee: text) -> text:
    for line in function_body(s.ir, caller):
        val l: text = line
        if l.contains("call ") and l.contains(callee + "("):
            return l
    ""

fn return_type_of_define(line: text) -> text:
    """`define ptr @f(...)` -> `ptr`."""
    val words = line.split(" ")
    if words.len() < 2:
        return ""
    val w: text = words[1]
    w

fn return_type_of_call(line: text) -> text:
    """`  %l3 = call ptr @f(...)` -> `ptr`."""
    val at = line.index_of("call ")
    if at < 0:
        return ""
    val rest = line.substring(at + 5, line.len())
    val words = rest.split(" ")
    val w: text = words[0]
    w

val RET_PRELUDE = "struct Acc:\n" +
    "    n: i64\n" +
    "\n" +
    "fn wrap<T>(x: T) -> Acc:\n" +
    "    Acc(n: 1)\n" +
    "\n" +
    "fn rebox<T>(x: T) -> Box<T>:\n" +
    "    Box(item: x)\n" +
    "\n" +
    "fn listed<T>(x: T) -> [Acc]:\n" +
    "    [Acc(n: 1)]\n" +
    "\n"

fn expect_call_matches_define(s: Shaped, callee: text):
    for e in s.errors:
        print "error: {e}"
    expect(s.errors.len()).to_equal(0)
    val define = define_of(s, callee)
    val call = call_line(s, "probe", callee)
    print "define: {define}"
    print "call:   {call}"
    expect(define != "").to_equal(true)
    expect(call != "").to_equal(true)
    expect(return_type_of_call(call)).to_equal(return_type_of_define(define))

# The return type of a specialization can name a declared type the mangling
# does not (`wrap$str` returns `Acc`). The call used to be typed i64 against
# `define ptr` -- one word on 64-bit targets, wrong wherever a pointer is not
# an i64.
describe "a generic fn returning a declared type: caller and callee agree":
    it "-> Acc, a struct the type arguments do not mention":
        expect_call_matches_define(shape(RET_PRELUDE +
            "fn probe() -> i64:\n" +
            "    val a = wrap(\"s\")\n" +
            "    a.n\n"), "wrap$str")

    it "-> Box<T>, a generic instance of the type argument":
        expect_call_matches_define(shape(RET_PRELUDE +
            "fn probe() -> i64:\n" +
            "    val b = rebox(\"s\")\n" +
            "    0\n"), "rebox$str")

    it "-> [Acc], a container over a declared type":
        expect_call_matches_define(shape(RET_PRELUDE +
            "fn probe() -> i64:\n" +
            "    val xs = listed(\"s\")\n" +
            "    xs.len()\n"), "listed$str")

# Same-module annotations retain their arguments through the flat parser.
# These assertions used to accept E-MONO-040 plus an integer add of text.
describe "container field through an annotated generic receiver":
    it "[T] elements through a text parameter concatenate":
        val s = shape(
            "fn probe(b: Bag<text>) -> text:\n" +
            "    b.items[0] + b.items[1]\n")
        expect(s.errors.len()).to_equal(0)
        expect(s.warnings.len()).to_equal(0)
        expect(verdict(s, "probe")).to_equal("concat")

    it "T? payload through a text parameter concatenates":
        val s = shape(
            "fn probe(b: Bag<text>) -> text:\n" +
            "    (b.first ?? \"z\") + (b.first ?? \"y\")\n")
        expect(s.errors.len()).to_equal(0)
        expect(s.warnings.len()).to_equal(0)
        expect(verdict(s, "probe")).to_equal("concat")

    it "repeated text element reads stay typed without an unknown-instance warning":
        val s = shape(
            "fn probe(b: Bag<text>) -> text:\n" +
            "    b.items[0] + b.items[1] + b.items[2]\n")
        var count = 0
        for w in s.warnings:
            val wt: text = w
            if wt.contains("E-MONO-040"):
                count = count + 1
        expect(count).to_equal(0)
        expect(verdict(s, "probe")).to_equal("concat")

    it "integer parameter elements retain integer arithmetic":
        val s = shape(
            "fn probe(b: Bag<i64>) -> i64:\n" +
            "    b.items[0] + b.items[1]\n")
        expect(s.warnings.len()).to_equal(0)
        expect(verdict(s, "probe")).to_equal("add")

    it "a known instance is not flagged":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val b = Bag(items: [\"a\", \"b\"], first: \"a\")\n" +
            "    b.items[0] + b.items[1]\n")
        expect(s.warnings.len()).to_equal(0)

    it "a generic call result carries its instance arguments to a field read":
        val s = shape(
            "fn boxit<T>(x: T) -> Box<T>:\n" +
            "    Box(item: x)\n" +
            "\n" +
            "fn probe() -> text:\n" +
            "    val b = boxit(\"t\")\n" +
            "    b.item + b.item\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "does not erase an invalid local generic argument to Any":
        val file = "testdata/gcf_invalid_annotation.spl"
        val source = PRELUDE + "fn probe(b: Bag<MissingType>) -> i64:\n    0\n"
        var lowering = HirLowering.with_filename(file)
        lowering.lower_module(parse_full_frontend(source, file, MODULE, Logger(level: 0)))
        expect(lowering.errors.len()).to_be_greater_than(0)
        var messages: [text] = []
        for diagnostic in lowering.errors:
            messages.push(diagnostic.message)
        expect(messages.join("\n")).to_contain("MissingType")
