# @req REQ-SSPEC-COMPILER
"""
# Typed enum payload slots accept every proven value shape

Phase-3 MIR residue (enum_payload / enum_match clusters, producer6,
2026-10-20): ~330 "enum construction 'E.V': payload type mismatch at N"
errors. None need a second module's SymbolTable; each is a value whose type
was proven but never reached `enum_payload_local_compatible`:

- `o.unwrap()`, `o!`, `t.0`, `t[0]`, `val (a, b) = t` carry the payload's
  lower_type() Struct, whose id is a canonical MIR id, not a SymbolTable id.
- `nil` is allowed only inside `unsafe:`. Safe code spells absence `None`;
  nil into a declared optional slot outside unsafe is a MIR error that says
  "use None". nil into a non-optional class/struct/enum slot is a MIR error
  that names the declaration to fix, inside unsafe too.
- `Some(3)`, `Some(arr)`, `Some(t[0])`, `Some(o.unwrap())`: the Some witness
  only covered scalar/Named payload sources.
- `E.V(self.dict_field)`: a Dict field projection never retained its type.
- `match (r.kind, s.kind)` over method-call results: the desugared tuple
  scrutinee `tmp[i]` had no element type, so bare variants were ambiguous.
"""

# @tag: unit, compiler, mir, hir, enum, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val data_source = "pub struct Node:\n    v: i64\n\npub enum Wrap:\n    One(node: Node)\n\npub enum OS:\n    V(n: Node?)\n\npub enum OI:\n    V(x: i64?)\n\npub enum Lit:\n    S(v: text, parts: [Node]?)\n\npub enum MemoRoot:\n    IndexMap(Dict<text, i64>)\n\npub class Mh:\n    memo: {text: i64}\n\npub struct MaybeH:\n    maybe: Node?\n\npub enum K1:\n    Fn(x: i64)\n    Lit(v: i64)\n\npub enum K2:\n    Fn(y: i64)\n    Other\n\npub struct Ty1:\n    kind: K1\n\npub class Solver:\n    n: i64\n    fn resolve(t: Ty1) -> Ty1:\n        t\n\npub class Boxy:\n    n: i64\n    fn unwrap() -> Node:\n        Node(v: self.n)\n"

fn lower_consumer(body: text) -> (text, MirModule):
    val consumer_source = "use lib.data.*\n\n" + body
    val log = Logger(level: 0)
    val data_ast = parse_full_frontend(data_source, "lib/data.spl", "lib.data", log)
    val consumer_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.data"] = data_ast
    val sources = [SourceFile(path: "lib/data.spl", content: data_source, module_name: "lib.data")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var data_lowering = hirlowering_for_module("lib.data", surfaces)
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val data_hir = data_lowering.lower_module(data_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    var prescan_mods: Dict<text, HirModule> = {}
    prescan_mods["data_hir"] = data_hir
    prescan_mods["consumer_hir"] = consumer_hir
    mir_lowering.prescan_module_struct_names(prescan_mods, "data_hir")
    mir_lowering.prescan_module_struct_names(prescan_mods, "consumer_hir")
    val mir = mir_lowering.lower_module(consumer_hir, [data_hir, consumer_hir])
    var out = ""
    for e in consumer_lowering.errors:
        out = out + "hir: " + e.message + "\n"
    for e in mir_lowering.errors:
        out = out + "mir: " + e.message + "\n"
    (out, mir)

fn lower_consumer_errors(body: text) -> text:
    val (errors, _mir) = lower_consumer(body)
    errors

fn nil_word_const_count(body: text) -> i64:
    # Const Int(3) is the nil word (expr_dispatch.spl `case NilLit`).
    val (_errors, mir) = lower_consumer(body)
    var count = 0
    for func in mir.functions.values():
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Const(_, value, _):
                        match value:
                            case MirConstValue.Int(v):
                                if v == 3: count = count + 1
                            case _: ()
                    case _: ()
    count

describe "typed enum payload slots accept proven value shapes":
    it "Option unwrap forms carry the payload record":
        expect(lower_consumer_errors("fn a(o: Node?) -> Wrap:\n    Wrap.One(o.unwrap())\n")).to_equal("")
        expect(lower_consumer_errors("fn b(o: Node?) -> Wrap:\n    val x = o.unwrap()\n    Wrap.One(x)\n")).to_equal("")
        expect(lower_consumer_errors("fn c(o: Node?) -> Wrap:\n    Wrap.One(o!)\n")).to_equal("")
        expect(lower_consumer_errors("fn d(h: MaybeH) -> Wrap:\n    Wrap.One(h.maybe.unwrap())\n")).to_equal("")

    it "tuple element forms carry the element record":
        expect(lower_consumer_errors("fn a(r: (Node, i64)) -> Wrap:\n    Wrap.One(r.0)\n")).to_equal("")
        expect(lower_consumer_errors("fn b(r: (Node, i64)) -> Wrap:\n    Wrap.One(r[0])\n")).to_equal("")
        expect(lower_consumer_errors("fn c(r: (Node, i64)) -> Wrap:\n    val (x, y) = r\n    Wrap.One(x)\n")).to_equal("")

    it "nil into a non-optional record payload is rejected with a MIR error naming the fix":
        # Wrap.One(node: Node): Node is not nullable, so a later match or
        # field read on that nil would miscompile natively.
        val errors = lower_consumer_errors("fn a() -> Wrap:\n    Wrap.One(nil)\n")
        expect(errors.contains("Wrap.One': payload type mismatch at 0: nil into non-optional payload slot (declared 'Node'); declare it 'Node?'")).to_equal(true)
        # Strictness kept for non-nominal slots: nil is not text.
        expect(lower_consumer_errors("fn b() -> Lit:\n    Lit.S(nil, nil)\n").contains("payload type mismatch at 0")).to_equal(true)

    it "nil into an optional record payload is rejected in safe code; None is the accepted form":
        # nil is allowed only inside `unsafe:`. OS.V(n: Node?) declares
        # absence as valid, and safe code spells absence `None`.
        val errors = lower_consumer_errors("fn a() -> OS:\n    OS.V(nil)\n")
        expect(errors.contains("OS.V': payload type mismatch at 0: nil outside unsafe into optional payload slot (declared 'Node?'); use None")).to_equal(true)
        expect(lower_consumer_errors("fn b() -> OS:\n    OS.V(None)\n")).to_equal("")
        expect(lower_consumer_errors("fn c() -> OI:\n    OI.V(None)\n")).to_equal("")

    it "None in an optional payload slot lowers to the nil word, like nil did":
        # Natively a builtin None is an rt_enum_new Option object, which
        # rt_native_eq does not equate with nil; the payload slot keeps the
        # nil word so converted sites keep their native shape.
        val with_none = nil_word_const_count("fn a() -> OS:\n    OS.V(None)\n")
        val with_nil = nil_word_const_count("fn a() -> OS:\n    unsafe:\n        OS.V(nil)\n")
        val with_value = nil_word_const_count("fn a(x: Node?) -> OS:\n    OS.V(x)\n")
        expect(with_none).to_equal(with_nil)
        expect(with_none > with_value).to_equal(true)

    it "nil into an optional payload is accepted inside unsafe":
        expect(lower_consumer_errors("fn a() -> OS:\n    unsafe:\n        OS.V(nil)\n")).to_equal("")

    it "unsafe does not admit nil into a non-optional payload":
        val errors = lower_consumer_errors("fn a() -> Wrap:\n    unsafe:\n        Wrap.One(nil)\n")
        expect(errors.contains("Wrap.One': payload type mismatch at 0: nil into non-optional payload slot")).to_equal(true)

    it "Some witnesses literal, container and projected payloads":
        expect(lower_consumer_errors("fn a() -> OI:\n    OI.V(Some(3))\n")).to_equal("")
        expect(lower_consumer_errors("fn b(p: [Node]) -> Lit:\n    Lit.S(\"a\", Some(p))\n")).to_equal("")
        expect(lower_consumer_errors("fn c(p: [Node]) -> Lit:\n    val q = Some(p)\n    Lit.S(\"a\", q)\n")).to_equal("")
        expect(lower_consumer_errors("fn d(r: (Node, i64)) -> OS:\n    OS.V(Some(r[0]))\n")).to_equal("")
        expect(lower_consumer_errors("fn e(o: Node?) -> OS:\n    OS.V(Some(o.unwrap()))\n")).to_equal("")

    it "a symbol-free dict field keeps its declared type":
        expect(lower_consumer_errors("fn a(m: Mh) -> MemoRoot:\n    MemoRoot.IndexMap(m.memo)\n")).to_equal("")

    it "an unrelated payload type is still rejected":
        expect(lower_consumer_errors("fn a(o: Ty1?) -> Wrap:\n    Wrap.One(o.unwrap())\n").contains("payload type mismatch at 0")).to_equal(true)

    it "bare variants over a tuple of method-call result fields resolve per slot":
        expect(lower_consumer_errors("fn a(s: Solver, x: Ty1, y: Ty1) -> i64:\n    val rx = s.resolve(x)\n    val ry = s.resolve(y)\n    match (rx.kind, ry.kind):\n        case (Fn(p), Fn(q)): p + q\n        case _: 0\n")).to_equal("")

    it "an unwrapped enum payload compares as an enum, not a struct operator":
        expect(lower_consumer_errors("fn a(o: K2?) -> bool:\n    val k = o.unwrap()\n    k == K2.Other\n")).to_equal("")

    it "a user-defined unwrap() method keeps its declared return type":
        expect(lower_consumer_errors("fn a(b: Boxy) -> Wrap:\n    Wrap.One(b.unwrap())\n")).to_equal("")

    it "bare variants over an enum array element resolve through the element type":
        expect(lower_consumer_errors("fn a(ks: [K1]) -> i64:\n    match ks[0]:\n        case Fn(x): x\n        case _: 0\n")).to_equal("")
