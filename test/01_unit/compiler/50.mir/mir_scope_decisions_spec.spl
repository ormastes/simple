use std.spec.*
use compiler.mir._MirLowering.module_lowering.{mir_scope_trace_selected_v1, mir_scope_decision_trace_line_v1}

describe "MIR scope scalar diagnostic selection and records":
    it "is off with no selected module, including an empty module":
        expect(mir_scope_trace_selected_v1("", "compiler.example")).to_equal(false)
        expect(mir_scope_trace_selected_v1("", "")).to_equal(false)
    it "selects only the exact configured module":
        expect(mir_scope_trace_selected_v1("compiler.example", "compiler.example")).to_equal(true)
        expect(mir_scope_trace_selected_v1("compiler.example", "compiler.example.child")).to_equal(false)
        expect(mir_scope_trace_selected_v1("compiler.example", "other.example")).to_equal(false)
    it "renders the real unscoped and completed masks as bounded single records":
        expect(mir_scope_decision_trace_line_v1(0, 0)).to_equal("[mir-scope-decisions] decisions=0 outcome=0")
        expect(mir_scope_decision_trace_line_v1(511, 10)).to_equal("[mir-scope-decisions] decisions=511 outcome=10")
    it "retains a partial mask for a module promotion refusal":
        expect(mir_scope_decision_trace_line_v1(3, 3)).to_equal("[mir-scope-decisions] decisions=3 outcome=3")
