use std.spec.{describe, it, expect}
use std.common.string_core.{char_from_code}
use std.io_runtime.{file_read}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val _LB: text = char_from_code(123)
val _RB: text = char_from_code(125)

fn _lower_closure(target_idx: i64, names: [text], paths: [text], srcs: [text]) -> text:
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    var sources: [SourceFile] = []
    var asts: [Module] = []
    var i = 0
    while i < names.len():
        val ast = parse_full_frontend(srcs[i], paths[i], names[i], log)
        modules[names[i]] = ast
        asts.push(ast)
        sources.push(SourceFile(path: paths[i], content: srcs[i], module_name: names[i]))
        i = i + 1
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var deps: [HirModule] = []
    var target_hir: HirModule? = None
    var errs: [text] = []
    i = 0
    while i < names.len():
        var hl = hirlowering_for_module(paths[i], surfaces)
        val hm = hl.lower_module(asts[i])
        if i == target_idx:
            target_hir = Some(hm)
            for e in hl.errors:
                errs.push("HIR:" + e.message)
        else:
            deps.push(hm)
        i = i + 1
    val th = target_hir.unwrap()
    var mir_lowering = MirLowering.new(th.symbols)
    var prescan: Dict<text, HirModule> = {}
    i = 0
    while i < deps.len():
        prescan["dep_{i}"] = deps[i]
        mir_lowering.prescan_module_struct_names(prescan, "dep_{i}")
        i = i + 1
    prescan["target"] = th
    mir_lowering.prescan_module_struct_names(prescan, "target")
    val _mir = mir_lowering.lower_module(th, deps)
    for e in mir_lowering.errors:
        if e.fatal:
            errs.push("MIR_FATAL:" + e.message)
        else:
            errs.push("MIR_WARN:" + e.message)
    errs.join(" | ")

describe "WA-W2-4 trace32_tools workaround retirement audit":
    it "removes all 13 workaround markers and helper shims from trace32_tools":
        val stmts_src = file_read("examples/10_tooling/trace32_tools/cmm_lsp/cmm_parser_stmts.spl")
        expect(stmts_src.contains("@workaround")).to_equal(false)
        expect(stmts_src.contains("phase2_result_payload_native_crash_2026_10_26")).to_equal(false)

        val state_src = file_read("examples/10_tooling/trace32_tools/t32_mcp/session_state.spl")
        expect(state_src.contains("@workaround")).to_equal(false)
        expect(state_src.contains("native_array_range_slice_lowering_2026_10_26")).to_equal(false)
        expect(state_src.contains("phase2_imported_history_record_fields_2026_10_27")).to_equal(false)
        expect(state_src.contains("t32_history_fields")).to_equal(false)
        expect(state_src).to_contain("items[250..]")
        expect(state_src).to_contain("items[items.len() - limit..]")

        val main_src = file_read("examples/10_tooling/trace32_tools/t32_mcp/main.spl")
        expect(main_src.contains("@workaround")).to_equal(false)
        expect(main_src.contains("phase2_imported_history_record_fields_2026_10_27")).to_equal(false)
        expect(main_src.contains("t32_main_history_fields")).to_equal(false)
        expect(main_src).to_contain("h.result")

        val action_src = file_read("examples/10_tooling/trace32_tools/t32_mcp/action_tools.spl")
        expect(action_src.contains("t32_history_fields")).to_equal(false)
        expect(action_src).to_contain("h.result")

    it "lowers direct Result payload matching in statement parser cleanly through HIR and MIR":
        val ast_mod = "pub enum ExprAst:\n    Ident(text)\n    Empty\npub enum StmtAst:\n    DoCall(ExprAst, i64)\npub struct ParseErr:\n    message: text\n"
        val parser_mod = "use app.ast." + _LB + "ExprAst, StmtAst, ParseErr" + _RB + "\npub class StmtParser:\n    pos: i64\n    me parse_expr() -> Result<ExprAst, ParseErr>:\n        if self.pos < 0:\n            return Err(ParseErr(message: \"bad\"))\n        Ok(ExprAst.Ident(\"ok\"))\n    me parse_do() -> Result<StmtAst, ParseErr>:\n        match self.parse_expr():\n            case Ok(file_expr):\n                Ok(StmtAst.DoCall(file_expr, self.pos))\n            case Err(e): Err(e)\n"
        expect(_lower_closure(1, ["app.ast", "app.parser"], ["app/ast.spl", "app/parser.spl"], [ast_mod, parser_mod])).to_equal("")

    it "lowers open-ended array slices and direct imported history field reads cleanly":
        val state_mod = "pub class McpT32HistoryItem:\n    command: text\n    result: text\n    session_id: text\n    core_id: text\n    request_id: text\npub fn t32_compact_history(items: [McpT32HistoryItem]) -> [McpT32HistoryItem]:\n    if items.len() <= 500:\n        return items\n    items[250..]\npub fn t32_keep_recent_history(items: [McpT32HistoryItem], limit: i64) -> [McpT32HistoryItem]:\n    if limit <= 0:\n        return []\n    if items.len() <= limit:\n        return items\n    items[items.len() - limit..]\n"
        val caller_mod = "use app.state." + _LB + "McpT32HistoryItem, t32_compact_history, t32_keep_recent_history" + _RB + "\npub fn render_tail(items: [McpT32HistoryItem], limit: i64) -> text:\n    val kept = t32_compact_history(t32_keep_recent_history(items, limit))\n    var acc = \"\"\n    for h in kept:\n        acc = acc + h.command + \":\" + h.result + \":\" + h.session_id + \":\" + h.core_id + \":\" + h.request_id\n    acc\n"
        expect(_lower_closure(0, ["app.state", "app.caller"], ["app/state.spl", "app/caller.spl"], [state_mod, caller_mod])).to_equal("")
        expect(_lower_closure(1, ["app.state", "app.caller"], ["app/state.spl", "app/caller.spl"], [state_mod, caller_mod])).to_equal("")
