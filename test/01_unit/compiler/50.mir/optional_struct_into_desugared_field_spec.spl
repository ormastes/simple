# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# Regression spec for optional_struct_stored_into_desugared_field_keeps_option_box_2026-10-25.
# A `T?` struct value stored directly into a non-optional struct field must
# store the payload (Some) or nil (None), not the Option enum box. Stage 2
# stored the box, so reading the field back as `T` read the enum header.
"""
## Purpose and audience
Purpose: Prove an optional struct stored into a desugared field reads back as the payload or nil.
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""
use std.spec.step

use std.spec.*

struct OsfAttr:
    is_c: bool
    name: text

struct OsfHolder:
    id: i64
    has_attr: bool
    attr: OsfAttr

fn osf_parse(want: bool) -> OsfAttr?:
    if not want:
        return nil
    OsfAttr(is_c: true, name: "nm")

fn osf_exists(opt: OsfAttr?) -> bool:
    if val present = opt:
        true
    else:
        false

fn osf_direct(want: bool) -> i64:
    val parsed: OsfAttr? = osf_parse(want)
    val h = OsfHolder(id: 1, has_attr: osf_exists(parsed), attr: parsed)
    val e: OsfAttr = h.attr
    if not e.?:
        return 0
    e.name.len()

fn osf_assigned(want: bool) -> i64:
    val parsed: OsfAttr? = osf_parse(want)
    var h = OsfHolder(id: 1, has_attr: osf_exists(parsed), attr: nil)
    if val present = parsed:
        h.attr = present
    val e: OsfAttr = h.attr
    if not e.?:
        return 0
    e.name.len()

describe "optional struct stored into a desugared field":
    # @manual scenario evidence
    it "reads back nil or the payload when assigned after construction":
        step("reads back nil or the payload when assigned after construction")
        expect(osf_assigned(false)).to_equal(0)
        expect(osf_assigned(true)).to_equal(2)

    it "reads back nil or the payload when stored at construction":
        step("reads back nil or the payload when stored at construction")
        expect(osf_direct(false)).to_equal(0)
        expect(osf_direct(true)).to_equal(2)
