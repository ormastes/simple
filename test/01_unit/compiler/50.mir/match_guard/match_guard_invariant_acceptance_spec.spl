# @req REQ-SSPEC-COMPILER
"""
# Guard-count invariant (3a) -- acceptance

Every guard the parser produced must be evaluated by the lowered code.

  * HIR half (`HirLowering.build_match_expr`): a desugared match still carries
    every parsed guard, as a guarded `MatchCase` arm or as an if-chain test.
    Reported as `E-HIR-MATCH-GUARD`.
  * MIR half (`MirLowering.lower_match_case`): guarded arms handed over by HIR
    == guard branches emitted, for every arm shape and dispatch path.
    Reported as `E-MIR-MATCH-GUARD` with function, module and span.

Advisory id `E-MIR-MATCH-GUARD`, warn-first, level switch `SIMPLE_MIR_VERIFY_LEVELS`
(error | warning | off), same mechanism as the MIR verifier rules.

Must-fail source for the MIR half: an int-literal arm with a guard inside an
enum match. The enum lowering rejects that arm's pattern and skips it, so its
guard is never lowered -- exactly a parsed-but-not-lowered guard.
"""

# @tag: unit, compiler, mir, match, guard, acceptance

use std.spec
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_verify_levels.{mir_lowering_advisory_ids, mir_verify_rule_level_from_spec}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

val ENUMS: text = "enum D:\n    A\n    B\n    C\n\nenum S:\n    P(i64)\n    Q(i64)\n    R\n\n"

val CLEAN_SRC: text = "fn pick(d: D, s: S, c: bool) -> i64:\n    val a = match d:\n        case D.A if c:\n            1\n        case D.A:\n            2\n        case _:\n            3\n    val b = match s:\n        case S.P(v) | S.Q(v) if v > 3:\n            10\n        case _ if c:\n            20\n        case _:\n            30\n    a + b\n"

val DROPPED_SRC: text = "fn dropped(d: D, c: bool) -> i64:\n    match d:\n        case D.A:\n            1\n        case 5 if c:\n            2\n        case _:\n            3\n"

val UNREACHABLE_SRC: text = "fn after_default(d: D, c: bool) -> i64:\n    match d:\n        case D.A:\n            1\n        case _:\n            3\n        case D.B if c:\n            2\n\nfn after_default_int(n: i64, c: bool) -> i64:\n    match n:\n        case 1 if c:\n            1\n        case _:\n            3\n        case 2 if c:\n            2\n\nfn after_default_tuple(a: i64, b: i64, c: bool) -> i64:\n    match (a, b):\n        case (1, y) if c:\n            1\n        case _:\n            3\n        case (2, y) if c:\n            2\n"

val NESTED_SRC: text = "fn nested(d: D, n: i64, c: bool) -> i64:\n    match d:\n        case D.A if c:\n            match n:\n                case 1 if c:\n                    11\n                case x if x > 5:\n                    12\n                case _:\n                    13\n        case D.B if not c:\n            2\n        case _:\n            3\n"

struct Lowered:
    mir: MirModule
    hir_messages: [text]
    mir_messages: [text]      # advisories first, then errors
    mir_fatal: [bool]
    mir_span_lines: [i64]
    # E-MIR-MATCH-GUARD entries in `lowering.errors` (must be 0 unless level error)
    guard_in_errors: i64

fn lower_src(body: text) -> Lowered:
    val src = ENUMS + body
    val parsed = parse_full_frontend(src, "testdata/guard_invariant.spl", "guard_invariant", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/guard_invariant.spl")
    val hir = hir_lowering.lower_module(parsed)
    var hir_messages: [text] = []
    for he in hir_lowering.errors:
        hir_messages = hir_messages.push(he.message)
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    var mir_messages: [text] = []
    var mir_fatal: [bool] = []
    var mir_span_lines: [i64] = []
    var guard_in_errors = 0
    for plain in lowering.errors:
        if plain.message.contains("E-MIR-MATCH-GUARD"):
            guard_in_errors = guard_in_errors + 1
    var all_diagnostics: [MirError] = []
    for adv in lowering.mir_advisories:
        all_diagnostics = all_diagnostics.push(adv)
    for plain2 in lowering.errors:
        all_diagnostics = all_diagnostics.push(plain2)
    for e in all_diagnostics:
        mir_messages = mir_messages.push(e.message)
        mir_fatal = mir_fatal.push(e.fatal)
        var line = -1
        if val sp = e.span:
            line = sp.line
        mir_span_lines = mir_span_lines.push(line)
    Lowered(mir: mir, hir_messages: hir_messages, mir_messages: mir_messages, mir_fatal: mir_fatal, mir_span_lines: mir_span_lines, guard_in_errors: guard_in_errors)

fn lower_with_levels(body: text, levels: text, phase: text) -> Lowered:
    val saved_levels = env_get("SIMPLE_MIR_VERIFY_LEVELS")
    val saved_phase = env_get("SIMPLE_ASSURANCE_WARNING_PHASE")
    val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", levels)
    val _b = env_set("SIMPLE_ASSURANCE_WARNING_PHASE", phase)
    val out = lower_src(body)
    val _c = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved_levels)
    val _d = env_set("SIMPLE_ASSURANCE_WARNING_PHASE", saved_phase)
    out

fn index_of_message(messages: [text], needle: text) -> i64:
    var i = 0
    while i < messages.len():
        if messages[i].contains(needle):
            return i
        i = i + 1
    -1

fn count_messages(messages: [text], needle: text) -> i64:
    var n = 0
    for m in messages:
        if m.contains(needle):
            n = n + 1
    n

fn guard_pass_blocks(mir: MirModule, name: text) -> i64:
    var n = 0
    for function in mir.functions.values():
        if function.name.ends_with("." + name):
            for block in function.blocks:
                if (block.label ?? "").contains("guard_pass"):
                    n = n + 1
    n

describe "guard-count invariant: must pass":
    it "is silent when every guard is lowered (guarded variant, or-arm split, guarded catch-all)":
        val out = lower_with_levels(CLEAN_SRC, "", "")
        expect(count_messages(out.mir_messages, "E-MIR-MATCH-GUARD")).to_equal(0)
        expect(count_messages(out.hir_messages, "E-HIR-MATCH-GUARD")).to_equal(0)
        # 1 (D.A if c) + 2 (P | Q alternatives share one guard) + 1 (_ if c)
        expect(guard_pass_blocks(out.mir, "pick")).to_equal(4)

    it "does not call an unreachable arm's guard dropped (enum, int and tuple matches)":
        val out = lower_with_levels(UNREACHABLE_SRC, "", "")
        expect(count_messages(out.mir_messages, "E-MIR-MATCH-GUARD")).to_equal(0)
        expect(count_messages(out.hir_messages, "E-HIR-MATCH-GUARD")).to_equal(0)

    it "checks a match nested in a guarded arm on its own count":
        val out = lower_with_levels(NESTED_SRC, "", "")
        expect(count_messages(out.mir_messages, "E-MIR-MATCH-GUARD")).to_equal(0)
        expect(guard_pass_blocks(out.mir, "nested")).to_equal(4)

describe "guard-count invariant: must fail":
    it "reports a parsed-but-not-lowered guard with function, module, counts and span":
        val out = lower_with_levels(DROPPED_SRC, "", "")
        val at = index_of_message(out.mir_messages, "E-MIR-MATCH-GUARD")
        expect(at).to_be_greater_than(-1)
        val message = out.mir_messages[at]
        expect(message.contains("fn guard_invariant.dropped") or message.contains(".dropped")).to_equal(true)
        expect(message.contains("has 1 guard(s) to evaluate but lowered 0 guard branch(es)")).to_equal(true)
        expect(out.mir_span_lines[at]).to_be_greater_than(0)
        expect(count_messages(out.mir_messages, "E-MIR-MATCH-GUARD")).to_equal(1)

    it "is warn-first: the report is non-fatal by default":
        val out = lower_with_levels(DROPPED_SRC, "", "")
        val at = index_of_message(out.mir_messages, "E-MIR-MATCH-GUARD")
        expect(at).to_be_greater_than(-1)
        expect(out.mir_fatal[at]).to_equal(false)
        # Advisory channel: nothing lands in `lowering.errors` by default.
        expect(out.guard_in_errors).to_equal(0)

val BARE_TUPLE_SRC: text = "fn bare_tuple(a: S, b: S) -> i64:\n    match (a, b):\n        case (S.P(x), S.P(y)) if x == y:\n            1\n        case (R, R):\n            2\n        case (S.Q(x), _) if x > 5:\n            3\n        case _:\n            9\n"

describe "guard-count invariant: guarded arms that can never run":
    it "warns once per match when guarded arms follow an irrefutable unguarded arm":
        val out = lower_with_levels(UNREACHABLE_SRC, "", "")
        # Only the tuple match goes through the HIR if-chain; the enum match
        # reports through MIR's existing `unreachable match arm` warning.
        expect(count_messages(out.hir_messages, "W-HIR-MATCH-GUARD-UNREACHABLE")).to_equal(1)
        expect(count_messages(out.mir_messages, "unreachable match arm")).to_equal(1)

    it "exposes a bare unit variant that binds inside a tuple pattern (`case (R, R):`)":
        # `R` is not resolved as S.R in a tuple element, so arm 2 is a
        # catch-all and arm 3's guard never runs. Tracked in
        # doc/08_tracking/bug/bare_unit_variant_in_tuple_pattern_binds_2026-10-10.md;
        # when that is fixed this expectation becomes 0.
        val out = lower_with_levels(BARE_TUPLE_SRC, "", "")
        val at = index_of_message(out.hir_messages, "W-HIR-MATCH-GUARD-UNREACHABLE")
        expect(at).to_be_greater_than(-1)
        expect(out.hir_messages[at].contains("1 guarded match arm(s) follow arm 2")).to_equal(true)
        expect(count_messages(out.hir_messages, "E-HIR-MATCH-GUARD")).to_equal(0)

    it "E-MIR-MATCH-GUARD=off silences the warning too":
        val out = lower_with_levels(BARE_TUPLE_SRC, "E-MIR-MATCH-GUARD=off", "")
        expect(count_messages(out.hir_messages, "MATCH-GUARD")).to_equal(0)

describe "guard-count invariant: level switch (SIMPLE_MIR_VERIFY_LEVELS, advisory id E-MIR-MATCH-GUARD)":
    it "E-MIR-MATCH-GUARD=error makes the report fatal":
        val out = lower_with_levels(DROPPED_SRC, "E-MIR-MATCH-GUARD=error", "")
        val at = index_of_message(out.mir_messages, "E-MIR-MATCH-GUARD")
        expect(at).to_be_greater_than(-1)
        expect(out.mir_fatal[at]).to_equal(true)
        expect(out.guard_in_errors).to_equal(1)

    it "E-MIR-MATCH-GUARD=off reports nothing and leaves the lowering itself unchanged":
        val off = lower_with_levels(DROPPED_SRC, "E-MIR-MATCH-GUARD=off", "")
        expect(count_messages(off.mir_messages, "E-MIR-MATCH-GUARD")).to_equal(0)
        val clean_off = lower_with_levels(CLEAN_SRC, "E-MIR-MATCH-GUARD=off", "")
        expect(guard_pass_blocks(clean_off.mir, "pick")).to_equal(4)

    it "shares the advisory id E-MIR-MATCH-GUARD: wildcard applies, a typo rejects the whole spec":
        expect(mir_lowering_advisory_ids().contains("E-MIR-MATCH-GUARD")).to_equal(true)
        expect(mir_verify_rule_level_from_spec("E-MIR-MATCH-GUARD", "")).to_equal("warning")
        expect(mir_verify_rule_level_from_spec("E-MIR-MATCH-GUARD", "*=off")).to_equal("off")
        expect(mir_verify_rule_level_from_spec("E-MIR-MATCH-GUARD", "*=off,E-MIR-MATCH-GUARD=error")).to_equal("error")
        expect(mir_verify_rule_level_from_spec("E-MIR-MATCH-GUARD", "E-MIR-MATCH-GUARD=eror")).to_equal("warning")
