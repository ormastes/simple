# @req REQ-SSPEC-COMPILER
"""
# Match guard parity (3a): seed interpreter vs stage-2-path MIR

A guard that is parsed but not lowered makes its arm run whenever the pattern
matches. That is wrong code with no diagnostic, and it is what happened for
every guarded tuple / text / range arm (`build_if_chain` ignored `arm.guard`)
and, as a hard "not supported" error, for every guarded int-literal arm.

The functions between the two `SHAPES` markers below are REAL code in this
file, so the seed interpreter running this spec is the oracle. The same bytes
are then read back, lowered parse -> HIR -> MIR by the pure-Simple compiler
(the stage-2 path), and for each arm shape the spec asserts

  * the MIR contains the guard branch (a conditional edge whose false side
    continues with the next arm), and
  * where the MIR interpreter can execute the shape (int and tuple-of-int
    scrutinees), the MIR result equals the oracle result.

Enum and text scrutinees are checked structurally only: the MIR interpreter
has no enum-discriminant / text-equality runtime, so executing them proves
nothing (an unguarded enum match takes its default arm there too).
"""

# @tag: unit, compiler, mir, match, guard

use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.interp.mir_interpreter.{MirInterpreter}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

# SHAPES-BEGIN
enum Shape:
    Circle(i64)
    Rect(i64, i64)
    Dot

enum Wrap:
    Inner(Shape)
    Empty

# literal arm; `case 1 if c:` then `case 1:`
fn g_lit(n: i64, c: bool) -> i64:
    match n:
        case 1 if c:
            10
        case 1:
            11
        case 2 if not c:
            20
        case _:
            99

# enum variant with payload binding; guard references the binding
fn g_payload(s: Shape) -> i64:
    match s:
        case Shape.Circle(r) if r > 5:
            1
        case Shape.Circle(r):
            2
        case Shape.Rect(w, h) if w == h:
            3
        case _:
            4

# or-pattern with a shared binding + guard
fn g_orpat(s: Shape, c: bool) -> i64:
    match s:
        case Shape.Circle(v) | Shape.Rect(v, _) if v > 3:
            1
        case Shape.Dot if c:
            2
        case _:
            3

# nested pattern
fn g_nested(w: Wrap) -> i64:
    match w:
        case Wrap.Inner(Shape.Circle(r)) if r > 2:
            1
        case Wrap.Inner(Shape.Circle(r)):
            2
        case _:
            3

# tuple; guard references a tuple binding
fn g_tup(a: i64, b: i64) -> i64:
    match (a, b):
        case (1, y) if y > 10:
            1
        case (1, y):
            2
        case _:
            3

# guard on the default (binding) arm
fn g_dflt(n: i64) -> i64:
    match n:
        case 1:
            1
        case x if x > 100:
            2
        case _:
            4

# guard on the default (wildcard) arm
fn g_wild(n: i64, c: bool) -> i64:
    match n:
        case 1:
            1
        case _ if c:
            3
        case _:
            4

# `case A if c:` followed by an unguarded arm of the same variant
fn g_same(s: Shape, c: bool) -> i64:
    match s:
        case Shape.Dot if c:
            1
        case Shape.Dot:
            2
        case _:
            3

# text literal
fn g_txt(s: text, c: bool) -> i64:
    match s:
        case "a" if c:
            1
        case "a":
            2
        case _:
            3

# or-of-int-literals and a range, both guarded
fn g_alt(n: i64, c: bool) -> i64:
    match n:
        case 1 | 2 if c:
            1
        case 3..9 if c:
            5
        case _:
            3

fn r_lit() -> i64:
    g_lit(1, true) * 1000000 + g_lit(1, false) * 10000 + g_lit(2, false) * 100 + g_lit(2, true)

fn r_payload() -> i64:
    g_payload(Shape.Circle(9)) * 1000 + g_payload(Shape.Circle(1)) * 100 + g_payload(Shape.Rect(2, 2)) * 10 + g_payload(Shape.Rect(2, 3))

fn r_orpat() -> i64:
    g_orpat(Shape.Circle(9), false) * 10000 + g_orpat(Shape.Rect(9, 1), false) * 1000 + g_orpat(Shape.Rect(1, 1), false) * 100 + g_orpat(Shape.Dot, true) * 10 + g_orpat(Shape.Dot, false)

fn r_nested() -> i64:
    g_nested(Wrap.Inner(Shape.Circle(9))) * 100 + g_nested(Wrap.Inner(Shape.Circle(1))) * 10 + g_nested(Wrap.Empty)

fn r_tup() -> i64:
    g_tup(1, 20) * 100 + g_tup(1, 2) * 10 + g_tup(2, 20)

fn r_dflt() -> i64:
    g_dflt(1) * 100 + g_dflt(500) * 10 + g_dflt(5)

fn r_wild() -> i64:
    g_wild(1, false) * 100 + g_wild(5, true) * 10 + g_wild(5, false)

fn r_same() -> i64:
    g_same(Shape.Dot, true) * 100 + g_same(Shape.Dot, false) * 10 + g_same(Shape.Circle(1), true)

fn r_txt() -> i64:
    g_txt("a", true) * 100 + g_txt("a", false) * 10 + g_txt("b", true)

fn r_alt() -> i64:
    g_alt(2, true) * 1000 + g_alt(2, false) * 100 + g_alt(4, true) * 10 + g_alt(4, false)
# negative literal, unguarded and guarded, scalar and inside a tuple
fn g_negplain(n: i64) -> i64:
    match n:
        case -1:
            2
        case _:
            3

fn g_neg(n: i64, c: bool) -> i64:
    match n:
        case -1 if c:
            1
        case _:
            3

fn g_negtup(a: i64, b: i64, c: bool) -> i64:
    match (a, b):
        case (-1, y) if c:
            1
        case _:
            3

# statement match, no arm accepts: nothing runs
fn g_stmt(n: i64) -> i64:
    var r = 5
    match n:
        case 1:
            r = 1
        case x if x > 10:
            r = 2
    r

fn r_neg() -> i64:
    g_negplain(-1) * 100000 + g_negplain(1) * 10000 + g_neg(-1, true) * 1000 + g_neg(1, true) * 100 + g_neg(-1, false) * 10 + g_negtup(-1, 0, true)

fn r_negtup() -> i64:
    g_negtup(-1, 0, true) * 100 + g_negtup(1, 0, true) * 10 + g_negtup(-1, 0, false)

fn r_stmt() -> i64:
    g_stmt(1) * 100 + g_stmt(50) * 10 + g_stmt(3)
# SHAPES-END

val SELF_PATH: text = "test/01_unit/compiler/50.mir/match_guard/match_guard_parity_spec.spl"

fn shapes_source() -> text:
    val all = file_read(SELF_PATH)
    val begin_at = all.index_of("# SHAPES-BEGIN\n") ?? -1
    val end_at = all.index_of("# SHAPES-END\n") ?? -1
    if begin_at < 0 or end_at < begin_at:
        return ""
    all.substring(begin_at, end_at)

fn strip_guards(src: text) -> text:
    """The unguarded twin: every `case P if g:` becomes `case P:`."""
    var out = ""
    for line in src.split("\n"):
        val guard_at = line.index_of(" if ") ?? -1
        if line.trim().starts_with("case ") and guard_at > 0:
            out = out + line.substring(0, guard_at) + ":\n"
        else:
            out = out + line + "\n"
    out

fn lower_text(src: text) -> (MirModule, [text]):
    val parsed = parse_full_frontend(src, "testdata/guard_shapes.spl", "guard_shapes", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/guard_shapes.spl")
    val hir = hir_lowering.lower_module(parsed)
    var messages: [text] = []
    for he in hir_lowering.errors:
        messages = messages.push("HIR " + he.message)
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    for e in lowering.mir_advisories:
        messages = messages.push("MIR " + e.message)
    for e in lowering.errors:
        messages = messages.push("MIR " + e.message)
    (mir, messages)

fn find_fn(mir: MirModule, name: text) -> MirFunction?:
    for function in mir.functions.values():
        if function.name == name or function.name.ends_with("." + name):
            return Some(function)
    nil

fn block_label(function: MirFunction, id: i64) -> text:
    for block in function.blocks:
        if block.id.id == id:
            return block.label ?? ""
    ""

fn if_count(mir: MirModule, name: text) -> i64:
    val f = find_fn(mir, name)
    if not f.?:
        return -1
    var n = 0
    for block in f.unwrap().blocks:
        match block.terminator:
            case MirTerminator.If(_, _, _):
                n = n + 1
            case _:
                pass
    n

# Guard branches: a conditional edge into a `*guard_pass` block whose false
# side continues matching (next arm / default / guard-fail), never the merge.
fn guard_branches(mir: MirModule, name: text) -> i64:
    val f = find_fn(mir, name)
    if not f.?:
        return -1
    val function = f.unwrap()
    var n = 0
    for block in function.blocks:
        match block.terminator:
            case MirTerminator.If(_, then_, else_):
                val then_label = block_label(function, then_.id)
                val else_label = block_label(function, else_.id)
                if then_label.contains("guard_pass") and not else_label.contains("merge"):
                    n = n + 1
            case _:
                pass
    n

fn run_mir(mir: MirModule, name: text) -> i64:
    var table: {text: MirFunction} = {}
    for function in mir.functions.values():
        table[function.name] = function
    val f = find_fn(mir, name)
    if not f.?:
        return -1
    var interp = MirInterpreter.create()
    interp.set_function_table(table)
    val res = interp.execute_function(f.unwrap())
    if res.1.?:
        return -2
    res.0 ?? -3

fn guard_diagnostics(messages: [text]) -> [text]:
    var out: [text] = []
    for m in messages:
        if m.contains("MATCH-GUARD") or m.contains("match guards") or m.contains("B5b"):
            out = out.push(m)
    out

describe "match guard parity: the guard branch reaches stage-2-path MIR":
    it "lowers every shape with no guard diagnostic (invariant silent, nothing unsupported)":
        val src = shapes_source()
        expect(src.contains("fn g_lit")).to_equal(true)
        val (mir, messages) = lower_text(src)
        expect(guard_diagnostics(messages)).to_equal([])
        expect(find_fn(mir, "g_alt").?).to_equal(true)

    it "literal arms, incl. `case 1 if c:` then `case 1:`: two guard branches, MIR result == oracle":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_lit")).to_equal(2)
        expect(r_lit()).to_equal(10112099)
        expect(run_mir(mir, "r_lit")).to_equal(r_lit())

    it "enum variant with payload binding, guard reads the binding: two guard branches":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_payload")).to_equal(2)
        expect(r_payload()).to_equal(1234)

    it "or-pattern with shared binding + guard: one guard branch per alternative":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_orpat")).to_equal(3)
        expect(r_orpat()).to_equal(11323)

    it "nested pattern: the guard branch survives payload flattening":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_nested")).to_equal(1)
        expect(r_nested()).to_equal(123)

    it "`case A if c:` followed by an unguarded arm of the same variant: one guard branch":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_same")).to_equal(1)
        expect(r_same()).to_equal(123)

    it "guard on a binding default arm: MIR result == oracle":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_dflt")).to_equal(1)
        expect(r_dflt()).to_equal(124)
        expect(run_mir(mir, "r_dflt")).to_equal(r_dflt())

    it "guard on a wildcard default arm: MIR result == oracle":
        val (mir, messages) = lower_text(shapes_source())
        expect(guard_branches(mir, "g_wild")).to_equal(1)
        expect(r_wild()).to_equal(134)
        expect(run_mir(mir, "r_wild")).to_equal(r_wild())

    it "or-of-literals and range arms, both guarded: MIR result == oracle":
        val (mir, messages) = lower_text(shapes_source())
        expect(r_alt()).to_equal(1353)
        expect(run_mir(mir, "r_alt")).to_equal(r_alt())

describe "match guard parity: if-chain shapes (tuple, text) against their unguarded twin":
    it "tuple arm with a guard on its binding: more branches than the twin, MIR result == oracle":
        val src = shapes_source()
        val (mir, messages) = lower_text(src)
        val (twin, twin_messages) = lower_text(strip_guards(src))
        expect(if_count(twin, "g_tup")).to_be_greater_than(0)
        expect(if_count(mir, "g_tup")).to_be_greater_than(if_count(twin, "g_tup"))
        expect(r_tup()).to_equal(123)
        expect(run_mir(mir, "r_tup")).to_equal(r_tup())
        # The twin really is the wrong-code program: (1, 2) takes arm 1.
        expect(run_mir(twin, "r_tup")).to_equal(113)

    it "text literal arm with a guard: more branches than the twin":
        val src = shapes_source()
        val (mir, messages) = lower_text(src)
        val (twin, twin_messages) = lower_text(strip_guards(src))
        expect(if_count(twin, "g_txt")).to_be_greater_than(0)
        expect(if_count(mir, "g_txt")).to_be_greater_than(if_count(twin, "g_txt"))
        expect(r_txt()).to_equal(123)

describe "match guard parity: shapes that were silently wrong or diverged from the seed":
    it "negative literal arms test the value (`case -1:` and `case -1 if c:`), MIR result == oracle":
        val (mir, messages) = lower_text(shapes_source())
        expect(r_neg()).to_equal(231331)
        expect(run_mir(mir, "r_neg")).to_equal(r_neg())
        expect(r_negtup()).to_equal(133)
        expect(run_mir(mir, "r_negtup")).to_equal(r_negtup())

    it "a statement match no arm accepts falls through like the seed (no abort)":
        val (mir, messages) = lower_text(shapes_source())
        expect(r_stmt()).to_equal(125)
        expect(run_mir(mir, "r_stmt")).to_equal(r_stmt())
