# @req REQ-SSPEC-COMPILER
"""
# Match guard-count invariant (3a, advisory E-MIR-MATCH-GUARD) -- census on real modules

Single-file harness: each file is lowered on its own, parse -> HIR -> MIR,
with the pure-Simple compiler (the stage-2 path), and every
`E-HIR-MATCH-GUARD` / `E-MIR-MATCH-GUARD` the lowering records is a HIT: a
guard that was parsed but is not evaluated by the lowered code, i.e. a live
wrong-code site.

No import closure is loaded, so unresolved imports lower as error types; that
does not affect guard counting, which is structural.

Default file: `src/compiler/30.types/type_infer/core.spl` -- `unify` matches
on a tuple with nine guarded arms (`case (Int(b1, s1), Int(b2, s2)) if b1 ==
b2 and s1 == s2:` ...), all of which the if-chain desugaring used to drop.

Census over other files (run from the repo root, one process per batch):

    MATCH_GUARD_CENSUS_FILES=a.spl,b.spl <simple> test <this spec>

Output: `GUARD-CENSUS <path> guarded_arms=<n> hits=<n> ...` per file and one
`GUARD-HIT <path> <message>` per hit. Promotion criterion: see
doc/07_guide/compiler/robustness/match-guard-invariant.md.
"""

# @tag: unit, compiler, mir, match, guard, census

use std.spec
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

val DEFAULT_FILES: text = "src/compiler/30.types/type_infer/core.spl"

struct CensusRow:
    path: text
    guarded_arms: i64
    hits: i64

fn textual_guarded_arms(src: text) -> i64:
    # `case ... if ...:` lines; an upper bound (a guard spelled inside a
    # docstring is counted too).
    var n = 0
    for line in src.split("\n"):
        val t = line.trim()
        if t.starts_with("case ") and t.contains(" if "):
            n = n + 1
    n

fn census_file(path: text) -> CensusRow:
    val src = file_read(path)
    val parsed = parse_full_frontend(src, path, "guard_census", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(parsed)
    var hits = 0
    var unreachable = 0
    for he in hir_lowering.errors:
        if he.message.contains("W-HIR-MATCH-GUARD-UNREACHABLE"):
            unreachable = unreachable + 1
            print "GUARD-UNREACHABLE {path} {he.message}"
        if he.message.contains("E-HIR-MATCH-GUARD"):
            hits = hits + 1
            print "GUARD-HIT {path} {he.message}"
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    for e in lowering.mir_advisories:
        if e.message.contains("E-MIR-MATCH-GUARD"):
            hits = hits + 1
            var line = 0
            if val sp = e.span:
                line = sp.line
            print "GUARD-HIT {path}:{line} {e.message}"
    val arms = textual_guarded_arms(src)
    print "GUARD-CENSUS {path} guarded_arms={arms} hits={hits} unreachable={unreachable} hir_errors={hir_lowering.errors.len()} mir_errors={lowering.errors.len()}"
    CensusRow(path: path, guarded_arms: arms, hits: hits)

fn census_files() -> [text]:
    var spec = env_get("MATCH_GUARD_CENSUS_FILES")
    if spec == "":
        spec = DEFAULT_FILES
    var out: [text] = []
    for item in spec.split(","):
        val p = item.trim()
        if p != "":
            out = out.push(p)
    out

describe "match guard-count invariant: census on real compiler modules":
    it "no guard is dropped by the stage-2-path lowering of the census files":
        var total_hits = 0
        var total_arms = 0
        var files = 0
        for path in census_files():
            val row = census_file(path)
            total_hits = total_hits + row.hits
            total_arms = total_arms + row.guarded_arms
            files = files + 1
        print "GUARD-CENSUS-TOTAL files={files} guarded_arms={total_arms} hits={total_hits}"
        expect(files).to_be_greater_than(0)
        expect(total_arms).to_be_greater_than(0)
        expect(total_hits).to_equal(0)
