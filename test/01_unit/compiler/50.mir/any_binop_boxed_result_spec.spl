# Regression spec for seed_mir_any_binop_result_unboxed_2026-08-15.
# Binary bit/arith ops whose operand is an `any`-typed array element must
# return a value that decodes correctly downstream (boxed when the result is
# `any`). Before the fix, the seed's MIR/JIT lane returned the RAW integer,
# so `(d >> 24) & 0xFF` decoded as garbage (e.g. 10 instead of 80, or an
# f64 denormal). Exercises >>, &, |, ^, -, * plus a nested chain.
# @req: REQ-COMP-MIR-ANY-OPERAND-BINOP-BOXING-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove that MIR any-operand binop boxing.
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""


use std.spec.*

fn shr24(dst: any) -> i64:
    val d = dst[0]
    (d >> 24) as i64

fn and_ff(dst: any) -> i64:
    val d = dst[0]
    (d & 0xFF) as i64

fn nested(dst: any) -> i64:
    val d = dst[0]
    ((d >> 24) & 0xFF) as i64

fn or_zero(dst: any) -> i64:
    val d = dst[0]
    (d | 0) as i64

fn xor_zero(dst: any) -> i64:
    val d = dst[0]
    (d ^ 0) as i64

fn sub_base(dst: any) -> i64:
    val d = dst[0]
    (d - 1344853805) as i64

fn mul_masked(dst: any) -> i64:
    val d = dst[0]
    ((d & 0xFF) * 2) as i64

fn fsub(dst: any) -> f64:
    val a = dst[0]
    val b = dst[1]
    (a - b) as f64

fn fmul(dst: any) -> f64:
    val a = dst[0]
    val b = dst[1]
    (a * b) as f64

fn fdiv(dst: any) -> f64:
    val a = dst[0]
    val b = dst[1]
    (a / b) as f64

fn flt(dst: any) -> bool:
    val a = dst[0]
    val b = dst[1]
    a < b

fn fgt(dst: any) -> bool:
    val a = dst[0]
    val b = dst[1]
    a > b

fn fchain(dst: any) -> f64:
    val a = dst[0]
    val b = dst[1]
    ((a - b) * 2.0) as f64

describe "MIR any-operand binop boxing":
    # value 1344853885 == 0x5028D77D
    it "should shift an any element correctly":
        step("Verify: should shift an any element correctly")
        # @req: REQ-COMP-MIR-ANY-OPERAND-BINOP-BOXING-001
        var dst: [u32] = [1344853885]
        expect(shr24(dst)).to_equal(80)

    it "should mask an any element correctly":
        step("Verify: should mask an any element correctly")
        var dst: [u32] = [1344853885]
        expect(and_ff(dst)).to_equal(125)

    it "should chain shift-then-mask on an any element":
        step("Verify: should chain shift-then-mask on an any element")
        var dst: [u32] = [1344853885]
        expect(nested(dst)).to_equal(80)

    it "should bit-or an any element correctly":
        step("Verify: should bit-or an any element correctly")
        var dst: [u32] = [1344853885]
        expect(or_zero(dst)).to_equal(1344853885)

    it "should bit-xor an any element correctly":
        step("Verify: should bit-xor an any element correctly")
        var dst: [u32] = [1344853885]
        expect(xor_zero(dst)).to_equal(1344853885)

    it "should subtract from an any element correctly":
        step("Verify: should subtract from an any element correctly")
        var dst: [u32] = [1344853885]
        expect(sub_base(dst)).to_equal(80)

    it "should multiply a masked any element correctly":
        step("Verify: should multiply a masked any element correctly")
        var dst: [u32] = [1344853885]
        expect(mul_masked(dst)).to_equal(250)

    # Float ANY+ANY lane (rt_any_sub/mul/div/lt/gt tag dispatch; before the
    # helpers, UnboxInt on a float box computed on raw bits: sub=-64, div=0,
    # inverted comparisons).
    it "should subtract float any elements correctly":
        step("Verify: should subtract float any elements correctly")
        var dst: [f64] = [7.75, 2.5]
        expect(fsub(dst)).to_equal(5.25)

    it "should multiply float any elements correctly":
        step("Verify: should multiply float any elements correctly")
        var dst: [f64] = [7.75, 2.5]
        expect(fmul(dst)).to_equal(19.375)

    it "should divide float any elements correctly":
        step("Verify: should divide float any elements correctly")
        var dst: [f64] = [7.75, 2.5]
        expect(fdiv(dst)).to_equal(3.1)

    it "should compare float any elements correctly":
        step("Verify: should compare float any elements correctly")
        var dst: [f64] = [7.75, 2.5]
        assert_false(flt(dst))
        assert_true(fgt(dst))

    it "should chain float any-element arithmetic correctly":
        step("Verify: should chain float any-element arithmetic correctly")
        var dst: [f64] = [7.75, 2.5]
        expect(fchain(dst)).to_equal(10.5)
