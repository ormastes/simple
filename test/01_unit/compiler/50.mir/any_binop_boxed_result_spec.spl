# Regression spec for seed_mir_any_binop_result_unboxed_2026-08-15.
# Binary bit/arith ops whose operand is an `any`-typed array element must
# return a value that decodes correctly downstream (boxed when the result is
# `any`). Before the fix, the seed's MIR/JIT lane returned the RAW integer,
# so `(d >> 24) & 0xFF` decoded as garbage (e.g. 10 instead of 80, or an
# f64 denormal). Exercises >>, &, |, ^, -, * plus a nested chain.

use std.spec.*

fn shr24(dst: any) -> i64:
    val d = dst[0]
    (d >> 24) as i64

fn and_ff(dst: any) -> i64:
    val d = dst[0]
    (d & 0xFF) as i64

fn nested(dst: any) -> i64:
    val d = dst[0]
    ((d >> 24) & 0xFF) as i64

fn or_zero(dst: any) -> i64:
    val d = dst[0]
    (d | 0) as i64

fn xor_zero(dst: any) -> i64:
    val d = dst[0]
    (d ^ 0) as i64

fn sub_base(dst: any) -> i64:
    val d = dst[0]
    (d - 1344853805) as i64

fn mul_masked(dst: any) -> i64:
    val d = dst[0]
    ((d & 0xFF) * 2) as i64

describe "MIR any-operand binop boxing":
    # value 1344853885 == 0x5028D77D
    it "should shift an any element correctly":
        var dst: [u32] = [1344853885]
        expect(shr24(dst)).to_equal(80)

    it "should mask an any element correctly":
        var dst: [u32] = [1344853885]
        expect(and_ff(dst)).to_equal(125)

    it "should chain shift-then-mask on an any element":
        var dst: [u32] = [1344853885]
        expect(nested(dst)).to_equal(80)

    it "should bit-or an any element correctly":
        var dst: [u32] = [1344853885]
        expect(or_zero(dst)).to_equal(1344853885)

    it "should bit-xor an any element correctly":
        var dst: [u32] = [1344853885]
        expect(xor_zero(dst)).to_equal(1344853885)

    it "should subtract from an any element correctly":
        var dst: [u32] = [1344853885]
        expect(sub_base(dst)).to_equal(80)

    it "should multiply a masked any element correctly":
        var dst: [u32] = [1344853885]
        expect(mul_masked(dst)).to_equal(250)
