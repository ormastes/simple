use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v6_flat.{
    strict_riscv_scalar_runtime_pipeline_v6_flat_direct}

fn rv32_zmmul() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "riscv-gen2-rv32-zmmul", isa_profile: "rv32i_zmmul",
        compressed_decode_profile: "none")

fn rv64_zmmul() -> CoreConfig:
    CoreConfig(xlen: 64, physical_address_bits: 56, register_count: 32,
        profile: "riscv-gen2-rv64-zmmul", isa_profile: "rv64i_zmmul",
        compressed_decode_profile: "none")

describe "flattened runtime scalar pipeline v6":
    it "owns one V6 router, one dynamic multiply leaf, and a closed tag-two protocol":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_flat", rv64_zmmul(), LsuConfig.rv64_product_default()).unwrap()
        expect(pipeline.local_diagnostic()).to_equal("")
        expect(pipeline.diagnostic()).to_equal("")
        expect(pipeline.top_ports.len()).to_equal(61)
        expect(pipeline.router.entity_name).to_equal("runtime_v6_flat_router")
        expect(pipeline.muldiv.entity_name).to_equal("runtime_v6_flat_muldiv")
        expect(pipeline.global_fault_gate.ports.any(_.name == "muldiv_fault" and _.direction == "in")).to_equal(true)

    it "binds the pending tag-two request, completion, readiness, and fault paths":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_flat_edges", rv32_zmmul(), LsuConfig.rv32_product_default()).unwrap()
        for edge in [("pending", "muldiv_request_valid", "muldiv", "request_valid", 1),
                ("pending", "muldiv_request_provider_tag", "muldiv", "request_provider_tag", 3),
                ("muldiv", "request_accept", "pending", "muldiv_request_accept", 1),
                ("muldiv", "completion_valid", "pending", "muldiv_completion_valid", 1),
                ("pending", "muldiv_completion_ready", "muldiv", "completion_ready", 1),
                ("muldiv", "provider_protocol_fault", "global_fault_gate", "muldiv_fault", 1)]:
            expect(pipeline.bindings.any(_.source_owner == edge[0] and _.source_port == edge[1] and
                _.destination_owner == edge[2] and _.destination_port == edge[3] and
                _.bit_width == edge[4])).to_equal(true)

    it "changes structural identity when the dynamic multiply leaf is substituted":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_flat_hash", rv32_zmmul(), LsuConfig.rv32_product_default()).unwrap()
        expect(pipeline.structural_sha256().len()).to_equal(64)
        expect(pipeline.binding_list_sha256().len()).to_equal(64)

    it "rejects IM because its legal DIV/REM rows require the V7 runtime-M owner":
        expect(strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_im_rejected", CoreConfig.rv32im(), LsuConfig.rv32_product_default()).is_err()).to_equal(true)
