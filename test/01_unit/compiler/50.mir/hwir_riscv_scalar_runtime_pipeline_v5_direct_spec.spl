use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v5.{strict_riscv_scalar_runtime_pipeline_v5_direct}

describe "runtime scalar pipeline v5 direct construction":
    it "owns one public decoder/uop skid and every direct v5 child":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_direct", CoreConfig.rv64(), LsuConfig.rv64_product_default()).unwrap()
        expect(pipeline.local_diagnostic()).to_equal("")
        expect(pipeline.diagnostic()).to_equal("")
        expect(pipeline.decoder.summary.name).to_equal("runtime_v5_direct_immediate_decoder")
        expect(pipeline.uop_skid.summary.name).to_equal("runtime_v5_direct_immediate_uop_skid")
        expect(pipeline.router.summary.name).to_equal("runtime_v5_direct_router")
        expect(pipeline.immediate_adapter.summary.name).to_equal("runtime_v5_direct_immediate_adapter")
        expect(pipeline.completion_merge.summary.name).to_equal("runtime_v5_direct_completion_merge")
        expect(pipeline.global_fault_gate.summary.name).to_equal("runtime_v5_direct_global_fault_gate")
        expect(pipeline.top_ports[0].name).to_equal("clk")
        expect(pipeline.top_ports[20].name).to_equal("fence_effect_ready")
        expect(pipeline.top_ports[21].name).to_equal("in_ready")
        expect(pipeline.top_ports[45].name).to_equal("completion_provider_event_id")
        expect(pipeline.top_ports[47].name).to_equal("completion_illegal_valid")
        expect(pipeline.top_ports[48].name).to_equal("runtime_protocol_fault")
        expect(pipeline.top_ports[60].name).to_equal("fence_effect_succ")

    it "keeps required direct links and rejects endpoint promotion":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_binding", CoreConfig.rv64(), LsuConfig.rv64_product_default()).unwrap()
        var decode_link = false
        var gate_sticky_link = false
        var router_sticky_link = false
        var gate_sticky_count = 0
        var router_ready_link = false
        var skid_ready_link = false
        var promoted_private_port = false
        for binding in pipeline.bindings:
            if binding.source_owner == "composition" and binding.source_port == "instruction" and
                    binding.destination_owner == "decoder" and binding.destination_port == "instruction" and binding.bit_width == 32:
                decode_link = true
            if binding.source_owner == "fault_owner" and binding.source_port == "protocol_fault" and
                    binding.destination_owner == "global_fault_gate" and binding.destination_port == "sticky_fault" and binding.bit_width == 1:
                gate_sticky_link = true
                gate_sticky_count = gate_sticky_count + 1
            if binding.source_owner == "fault_owner" and binding.source_port == "protocol_fault" and
                    binding.destination_owner == "router" and binding.destination_port == "sticky_fault" and binding.bit_width == 1:
                router_sticky_link = true
            if binding.source_owner == "completion_merge" and binding.source_port == "immediate_ready" and
                    binding.destination_owner == "router" and binding.destination_port == "alu_ready" and binding.bit_width == 1:
                router_ready_link = true
            if binding.source_owner == "router" and binding.source_port == "uop_ready" and
                    binding.destination_owner == "uop_skid" and binding.destination_port == "uop_ready" and binding.bit_width == 1:
                skid_ready_link = true
        for port in pipeline.top_ports:
            if port.name == "pending_dispatch_tag" or port.name == "router_fault" or port.name == "selector_uop_valid":
                promoted_private_port = true
        expect(decode_link).to_equal(true)
        expect(gate_sticky_link).to_equal(true)
        expect(router_sticky_link).to_equal(true)
        expect(gate_sticky_count).to_equal(1)
        expect(router_ready_link).to_equal(true)
        expect(skid_ready_link).to_equal(true)
        expect(promoted_private_port).to_equal(false)

    it "has deterministic binding identity and validates its current direct closure":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_closure", CoreConfig.rv32(), LsuConfig.rv32_product_default()).unwrap()
        expect(pipeline.binding_list_sha256().len()).to_equal(64)
        expect(pipeline.binding_prefix_diagnostic()).to_equal("")

    it "records the exact stateful LSU and FENCE chains without private promotion":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_stateful", CoreConfig.rv64(), LsuConfig.rv64_product_default()).unwrap()
        var lsu_projection = false
        var lsu_return = false
        var fence_request = false
        var fence_return = false
        var gated_bus = false
        var gated_fence = false
        var pending_busy = false
        var lsu_completion_ready = false
        var fence_completion_ready = false
        var lsu_event_alias = false
        var fence_event_alias = false
        var lsu_illegal_zero = false
        var fence_illegal_zero = false
        for binding in pipeline.bindings:
            if binding.source_owner == "pending" and binding.source_port == "lsu_request_canonical_instruction" and binding.destination_owner == "projection" and binding.destination_port == "canonical_instruction" and binding.bit_width == 32:
                lsu_projection = true
            if binding.source_owner == "lsu" and binding.source_port == "completion_valid" and binding.destination_owner == "pending" and binding.destination_port == "lsu_completion_valid" and binding.bit_width == 1:
                lsu_return = true
            if binding.source_owner == "pending" and binding.source_port == "fence_request_valid" and binding.destination_owner == "fence" and binding.destination_port == "request_valid" and binding.bit_width == 1:
                fence_request = true
            if binding.source_owner == "fence" and binding.source_port == "completion_valid" and binding.destination_owner == "pending" and binding.destination_port == "fence_completion_valid" and binding.bit_width == 1:
                fence_return = true
            if binding.source_owner == "global_fault_gate" and binding.source_port == "bus_request_ready" and binding.destination_owner == "lsu" and binding.destination_port == "bus_request_ready" and binding.bit_width == 1:
                gated_bus = true
            if binding.source_owner == "global_fault_gate" and binding.source_port == "fence_effect_ready" and binding.destination_owner == "fence" and binding.destination_port == "fence_effect_ready" and binding.bit_width == 1:
                gated_fence = true
            if binding.source_owner == "pending" and binding.source_port == "busy" and binding.destination_owner == "router" and binding.destination_port == "pending_busy" and binding.bit_width == 1:
                pending_busy = true
            if binding.source_owner == "pending" and binding.source_port == "lsu_completion_ready" and binding.destination_owner == "lsu" and binding.destination_port == "completion_ready" and binding.bit_width == 1:
                lsu_completion_ready = true
            if binding.source_owner == "pending" and binding.source_port == "fence_completion_ready" and binding.destination_owner == "fence" and binding.destination_port == "completion_ready" and binding.bit_width == 1:
                fence_completion_ready = true
            if binding.source_owner == "lsu" and binding.source_port == "completion_provider_event_id" and binding.destination_owner == "pending" and binding.destination_port == "lsu_completion_event_id" and binding.bit_width == 64:
                lsu_event_alias = true
            if binding.source_owner == "fence" and binding.source_port == "completion_provider_event_id" and binding.destination_owner == "pending" and binding.destination_port == "fence_completion_event_id" and binding.bit_width == 64:
                fence_event_alias = true
            if binding.source_owner == "zero_defaults" and binding.source_port == "zero_1" and binding.destination_owner == "lsu" and binding.destination_port == "request_illegal_valid" and binding.bit_width == 1:
                lsu_illegal_zero = true
            if binding.source_owner == "zero_defaults" and binding.source_port == "zero_1" and binding.destination_owner == "fence" and binding.destination_port == "illegal_valid" and binding.bit_width == 1:
                fence_illegal_zero = true
        expect(lsu_projection).to_equal(true)
        expect(lsu_return).to_equal(true)
        expect(fence_request).to_equal(true)
        expect(fence_return).to_equal(true)
        expect(gated_bus).to_equal(true)
        expect(gated_fence).to_equal(true)
        expect(pending_busy).to_equal(true)
        expect(lsu_completion_ready).to_equal(true)
        expect(fence_completion_ready).to_equal(true)
        expect(lsu_event_alias).to_equal(true)
        expect(fence_event_alias).to_equal(true)
        expect(lsu_illegal_zero).to_equal(true)
        expect(fence_illegal_zero).to_equal(true)

    it "drives every disabled MulDiv and CSR pending input from typed zero capability":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_disabled_pending", CoreConfig.rv64(), LsuConfig.rv64_product_default()).unwrap()
        val fields = [("request_ready", 1), ("request_accept", 1),
            ("completion_valid", 1), ("provider_protocol_fault", 1),
            ("completion_tag", 3), ("completion_event_id", 64),
            ("completion_decode_event_id", 64), ("completion_privilege", 2),
            ("completion_original_instruction", 32), ("completion_canonical_instruction", 32),
            ("completion_instruction_length_bytes", 3), ("completion_pc_before", 64),
            ("completion_pc_after", 64), ("completion_rd", 5), ("completion_rd_write", 1),
            ("completion_rd_value", 64), ("completion_memory_address", 64),
            ("completion_memory_read_mask", 32), ("completion_memory_write_mask", 32),
            ("completion_memory_read_data", 64), ("completion_memory_write_data", 64),
            ("completion_execute_trap_valid", 1), ("completion_execute_trap_cause", 64),
            ("completion_execute_trap_tval", 64), ("completion_memory_trap_valid", 1),
            ("completion_memory_trap_cause", 64), ("completion_memory_trap_tval", 64),
            ("completion_redirect_valid", 1), ("completion_redirect_target", 64),
            ("completion_illegal_valid", 1)]
        expect(pipeline.zero_defaults.ports.len()).to_equal(6)
        for lane in ["muldiv", "csr"]:
            for field in fields:
                var found = false
                for binding in pipeline.bindings:
                    if binding.source_owner == "zero_defaults" and
                            binding.source_port == "zero_" + field[1].to_text() and
                            binding.destination_owner == "pending" and
                            binding.destination_port == lane + "_" + field[0] and
                            binding.bit_width == field[1]:
                        found = true
                expect(found).to_equal(true)

    it "materializes every immediate completion field through selector merge and skid":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_immediate_fields", CoreConfig.rv64(), LsuConfig.rv64_product_default()).unwrap()
        val fields = [("privilege", 2), ("original_instruction", 32),
            ("canonical_instruction", 32), ("instruction_length_bytes", 3),
            ("pc_before", 64), ("pc_after", 64), ("rd", 5), ("rd_write", 1),
            ("rd_value", 64), ("memory_address", 64), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", 64), ("memory_write_data", 64),
            ("execute_trap_valid", 1), ("execute_trap_cause", 64), ("execute_trap_tval", 64),
            ("memory_trap_valid", 1), ("memory_trap_cause", 64), ("memory_trap_tval", 64),
            ("redirect_valid", 1), ("redirect_target", 64), ("provider_event_id", 64),
            ("decode_event_id", 64), ("illegal_valid", 1)]
        var selected_to_merge = 0
        var merge_to_skid = 0
        var illegal_payload = false
        var unsupported_default = false
        for field in fields:
            for binding in pipeline.bindings:
                if binding.source_owner == "selector" and binding.source_port == "selected_" + field[0] and
                        binding.destination_owner == "completion_merge" and binding.destination_port == "immediate_" + field[0] and binding.bit_width == field[1]:
                    selected_to_merge = selected_to_merge + 1
                if binding.source_owner == "completion_merge" and binding.source_port == "selected_" + field[0] and
                        binding.destination_owner == "completion_skid" and binding.destination_port == "upstream_" + field[0] and binding.bit_width == field[1]:
                    merge_to_skid = merge_to_skid + 1
                if binding.source_owner == "illegal_provider" and binding.source_port == "completion_execute_trap_tval" and
                        binding.destination_owner == "selector" and binding.destination_port == "illegal_execute_trap_tval" and binding.bit_width == 64:
                    illegal_payload = true
                if binding.source_owner == "defaults" and binding.destination_owner == "selector" and
                        binding.destination_port == "alu_memory_write_data":
                    unsupported_default = true
        expect(selected_to_merge).to_equal(25)
        expect(merge_to_skid).to_equal(25)
        expect(illegal_payload).to_equal(true)
        expect(unsupported_default).to_equal(true)

    it "keeps immediate valid fault and ready ownership local to child links":
        val pipeline = strict_riscv_scalar_runtime_pipeline_v5_direct(
            "runtime_v5_immediate_control", CoreConfig.rv32(), LsuConfig.rv32_product_default()).unwrap()
        var adapter_valid = false
        var merge_valid = false
        var merge_fault = false
        var gated_input_ready = false
        var promoted_selector_port = false
        var control_selector_binding = false
        var system_selector_binding = false
        for binding in pipeline.bindings:
            if binding.source_owner == "immediate_adapter" and binding.source_port == "selector_uop_valid" and binding.destination_owner == "selector" and binding.destination_port == "uop_valid" and binding.bit_width == 1:
                adapter_valid = true
            if binding.source_owner == "selector" and binding.source_port == "selected_valid" and binding.destination_owner == "completion_merge" and binding.destination_port == "immediate_valid" and binding.bit_width == 1:
                merge_valid = true
            if binding.source_owner == "selector" and binding.source_port == "selector_fault" and binding.destination_owner == "completion_merge" and binding.destination_port == "immediate_fault" and binding.bit_width == 1:
                merge_fault = true
            if binding.source_owner == "global_fault_gate" and binding.source_port == "input_ready" and binding.destination_owner == "composition" and binding.destination_port == "in_ready" and binding.bit_width == 1:
                gated_input_ready = true
            if binding.destination_owner == "selector" and binding.destination_port.starts_with("control_"):
                control_selector_binding = true
            if binding.destination_owner == "selector" and binding.destination_port.starts_with("system_"):
                system_selector_binding = true
        for port in pipeline.top_ports:
            if port.name == "selector_fault" or port.name == "immediate_valid" or port.name == "skid_upstream_ready":
                promoted_selector_port = true
        expect(adapter_valid).to_equal(true)
        expect(merge_valid).to_equal(true)
        expect(merge_fault).to_equal(true)
        expect(gated_input_ready).to_equal(true)
        expect(promoted_selector_port).to_equal(false)
        expect(control_selector_binding).to_equal(true)
        expect(system_selector_binding).to_equal(true)

    it "is deterministic and rejects incompatible stateful transport":
        val first = strict_riscv_scalar_runtime_pipeline_v5_direct("runtime_v5_exact",
            CoreConfig.rv32(), LsuConfig.rv32_product_default()).unwrap()
        val second = strict_riscv_scalar_runtime_pipeline_v5_direct("runtime_v5_exact",
            CoreConfig.rv32(), LsuConfig.rv32_product_default()).unwrap()
        expect(first.structural_sha256()).to_equal(second.structural_sha256())
        expect(first.structural_sha256().len()).to_equal(64)
        expect(strict_riscv_scalar_runtime_pipeline_v5_direct("", CoreConfig.rv32(),
            LsuConfig.rv32_product_default()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_pipeline_v5_direct("runtime_v5_bad_bus",
            CoreConfig.rv32(), LsuConfig.rv64_product_default()).is_err()).to_equal(true)
