use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_runtime_m_provider.{strict_riscv_scalar_runtime_m_provider}
use compiler.mir.hwir.riscv_scalar_runtime_div_admission.{strict_riscv_scalar_runtime_div_admission}
use compiler.mir.hwir.riscv_scalar_runtime_div_normalizer.{strict_riscv_scalar_runtime_div_normalizer}
use compiler.mir.hwir.riscv_scalar_runtime_csr_admission.{strict_riscv_scalar_runtime_csr_admission}
use compiler.mir.hwir.riscv_scalar_runtime_csr_provider.{strict_riscv_scalar_runtime_csr_provider}
use lib.hardware.riscv_common.isa.scalar_database.{riscv_scalar_decoder_plan}

describe "V9 IM plus Zicsr admission scope":
    it "accepts only the canonical combined plans with every M and CSR row frozen":
        for product in [(CoreConfig.rv32im_zicsr_zifencei(), "rv32im_zicsr_zifencei", 8, 4, 32),
                (CoreConfig.rv64im_zicsr_zifencei(), "rv64im_zicsr_zifencei", 13, 8, 64)]:
            val plan = riscv_scalar_decoder_plan(product[1]).unwrap()
            val m_owner = strict_riscv_scalar_runtime_m_provider("v9_m_" + product[4].to_text(), product[0], plan).unwrap()
            val div = strict_riscv_scalar_runtime_div_admission(product[0], plan).unwrap()
            val normalizer = strict_riscv_scalar_runtime_div_normalizer(product[0], plan, product[4]).unwrap()
            val csr = strict_riscv_scalar_runtime_csr_admission(product[0], plan).unwrap()
            val csr_owner = strict_riscv_scalar_runtime_csr_provider("v9_csr_" + product[4].to_text(), product[0], plan).unwrap()
            expect(m_owner.diagnostic()).to_equal("")
            expect(m_owner.origins.filter(_.source_name.starts_with("rv.m.") or _.source_name.starts_with("rv64.m.")).len()).to_equal(product[2])
            expect(div.diagnostic()).to_equal("")
            expect(div.rows.len()).to_equal(product[3])
            expect(normalizer.diagnostic()).to_equal("")
            expect(csr.diagnostic()).to_equal("")
            expect(csr.rows.len()).to_equal(6)
            expect(csr_owner.diagnostic()).to_equal("")
        val rv32_v9 = CoreConfig.rv32im_zicsr_zifencei()
        expect(strict_riscv_scalar_runtime_m_provider("wrong_plan", rv32_v9,
            riscv_scalar_decoder_plan("rv32im").unwrap()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_csr_admission(rv32_v9,
            riscv_scalar_decoder_plan("rv32i_zicsr_zifencei").unwrap()).is_err()).to_equal(true)
