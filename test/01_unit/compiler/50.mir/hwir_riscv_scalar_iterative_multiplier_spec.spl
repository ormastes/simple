use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{strict_riscv_scalar_muldiv_projection}
use compiler.mir.hwir.riscv_scalar_iterative_multiplier.{strict_riscv_scalar_iterative_multiplier}
use compiler.backend.backend.hwir_to_vhdl.{render_strict_sequential_hwir}

fn config(xlen: i32, profile: text) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: xlen, register_count: 32,
        profile: "riscv-gen2-" + profile, isa_profile: profile,
        compressed_decode_profile: "none")

fn multiplier(name: text, xlen: i32, instruction: u32):
    val cfg = config(xlen, if xlen == 32: "rv32im" else: "rv64im")
    strict_riscv_scalar_iterative_multiplier(name, cfg,
        strict_riscv_scalar_muldiv_projection(cfg, "iterative", instruction).unwrap()).unwrap()

describe "RISC-V Gen2 clocked iterative multiplier":
    it "materializes W-cycle capture iterate finalize and held completion rules":
        val module = multiplier("rv32_iterative_mul", 32, 0x022081B3)
        expect(module.diagnostic()).to_equal("")
        expect(module.plan.rules.map(_.name)).to_equal([
            "consume", "finalize", "iterate", "identity_fault", "capture"])
        expect(module.plan.registers.any(_.name == "acc_reg" and _.bit_width == 64)).to_equal(true)
        expect(module.plan.rules[2].assignments.any(_.destination == "acc_reg" and
            _.value.value == "acc_next")).to_equal(true)
        expect(module.plan.outputs.any(_.result == "rd_value" and
            _.kind == "guarded")).to_equal(true)
        expect(module.ports.any(_.name == "privilege" and _.direction == "out" and
            _.bit_width == 2)).to_equal(true)

    it "emits a 128-bit RV64 high multiplier without runtime XLEN selection":
        val module = multiplier("rv64_iterative_mulh", 64, 0x022091B3)
        expect(module.plan.registers.any(_.name == "acc_reg" and _.bit_width == 128)).to_equal(true)
        val emitted = render_strict_sequential_hwir(module, "hwir-gen2-multiplier-v1")
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl).to_contain("signal acc_reg: std_logic_vector(127 downto 0)")
        expect(emitted.vhdl).to_contain("acc_reg <= acc_next")
        expect(emitted.vhdl).to_contain("canonical_instruction_reg")
        expect(emitted.vhdl.contains("xlen_select")).to_equal(false)

    it "rejects divide projection and forged register identity structurally":
        val cfg = config(64, "rv64im")
        val divide = strict_riscv_scalar_muldiv_projection(cfg, "iterative", 0x0220C1B3).unwrap()
        expect(strict_riscv_scalar_iterative_multiplier("bad_divide", cfg, divide).is_err()).to_equal(true)
        val module = multiplier("identity_guarded_mul", 64, 0x022081B3)
        expect(module.datapath_comb_ops.any(_.result == "original_match" and
            _.lhs == "dispatch_original_instruction" and _.op == "eq")).to_equal(true)
        expect(module.datapath_comb_ops.any(_.result == "rs1_match" and _.op == "eq")).to_equal(true)
        expect(module.plan.rules.any(_.name == "identity_fault" and
            _.guards.any(_.kind == "low" and _.lhs == "identity_final"))).to_equal(true)
