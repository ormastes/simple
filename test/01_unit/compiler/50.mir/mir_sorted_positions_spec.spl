# Purpose and audience: perf-budget regression spec for the MIR function/static
# sort used by every emit path (seed_emit_object_superlinear_hang_large_module_2026-07-20).
# @req REQ-SSPEC-COMPILER
"""
## Purpose and audience
Purpose: mir_sorted_positions orders by (name, id) stably and in O(N log N).
Audience: COMP maintainers.
"""
use std.spec.step
use compiler.mir.mir_instruction_graph.{mir_sorted_positions}

describe "mir_sorted_positions":
    it "orders by name then id":
        step("sort four entries with a duplicate name")
        val order = mir_sorted_positions(["b", "a", "b", "a"], [9, 5, 2, 1])
        expect(order).to_equal([3, 1, 2, 0])

    it "handles empty and single":
        step("empty and single")
        expect(mir_sorted_positions([], []).len()).to_equal(0)
        expect(mir_sorted_positions(["x"], [1])).to_equal([0])

    it "sorts 4000 reversed names within budget":
        step("build 4000 descending names")
        var names: [text] = []
        var ids: [i64] = []
        var i = 0
        while i < 4000:
            names = names.push("fn_{9999 - i}")
            ids = ids.push(i)
            i = i + 1
        step("sort")
        val order = mir_sorted_positions(names, ids)
        expect(order.len()).to_equal(4000)
        expect(order[0]).to_equal(3999)
        expect(order[3999]).to_equal(0)
