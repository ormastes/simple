# Purpose and audience: perf-budget regression spec for the MIR function/static
# sort used by every emit path (seed_emit_object_superlinear_hang_large_module_2026-07-20).
# @req REQ-SSPEC-COMPILER
"""
## Purpose and audience
Purpose: mir_sorted_positions orders by (name, id) stably and in O(N log N).
Audience: COMP maintainers.
"""
use std.spec.step
use compiler.mir.mir_instruction_graph.{mir_sorted_positions}

describe "mir_sorted_positions":
    it "orders by name then id":
        step("sort four entries with a duplicate name")
        val order = mir_sorted_positions(["b", "a", "b", "a"], [9, 5, 2, 1])
        expect(order).to_equal([3, 1, 2, 0])

    it "handles empty and single":
        step("empty and single")
        expect(mir_sorted_positions([], []).len()).to_equal(0)
        expect(mir_sorted_positions(["x"], [1])).to_equal([0])

    it "sorts 4000 reversed names within budget":
        step("build 4000 descending names")
        var names: [text] = []
        var ids: [i64] = []
        var i = 0
        while i < 4000:
            names = names.push("fn_{9999 - i}")
            ids = ids.push(i)
            i = i + 1
        step("sort")
        val order = mir_sorted_positions(names, ids)
        expect(order.len()).to_equal(4000)
        expect(order[0]).to_equal(3999)
        expect(order[3999]).to_equal(0)

extern fn rt_time_now_unix_micros() -> i64

fn sorted_positions_reversed_micros(n: i64) -> i64:
    var names: [text] = []
    var ids: [i64] = []
    var i = 0
    while i < n:
        names = names.push("fn_{100000 - i}")
        ids = ids.push(i)
        i = i + 1
    val t0 = rt_time_now_unix_micros()
    val order = mir_sorted_positions(names, ids)
    val t1 = rt_time_now_unix_micros()
    if order.len() != n:
        return -1
    t1 - t0

describe "mir_sorted_positions scaling budget":
    # Budget (bug seed_emit_object_superlinear_hang_large_module_2026-07-20):
    # the old selection sort was O(N^2) over whole MirFunction values. A 4x input
    # must cost < 8x (linear = 4x, N log N ~ 4.8x, quadratic = 16x), and 4000
    # entries must sort in < 30 s on the seed interpreter.
    it "4x input costs less than 8x time and 4000 entries finish in 30s":
        step("time 1000 vs 4000 reversed entries")
        val small = sorted_positions_reversed_micros(1000)
        val large = sorted_positions_reversed_micros(4000)
        expect(small > 0).to_equal(true)
        expect(large > 0).to_equal(true)
        expect(large < 30000000).to_equal(true)
        expect(large < 8 * small + 200000).to_equal(true)
