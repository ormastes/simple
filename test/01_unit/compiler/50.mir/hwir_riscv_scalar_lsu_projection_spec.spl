use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_lsu_projection.{strict_riscv_scalar_lsu_access_plan,
    strict_riscv_scalar_lsu_projection}

fn expect_access(config: CoreConfig, bus: LsuConfig, instruction: u32,
    bytes: i64, load_op: text):
    val built = strict_riscv_scalar_lsu_projection("lsu_projection", config, bus, instruction)
    expect(built.is_ok()).to_equal(true)
    if built.is_ok():
        val module = built.ok().unwrap()
        expect(module.shape_diagnostic()).to_equal("")
        expect(module.port_width("effective_address")).to_equal(config.physical_address_bits)
        var size = -1
        var found_load = false
        for constant in module.constants:
            if constant.name == "size_value": size = constant.value
        for operation in module.comb_ops:
            if operation.result == "load_extended" and operation.op == load_op: found_load = true
        expect(size).to_equal(bytes)
        expect(found_load).to_equal(true)

describe "typed scalar LSU access projection":
    it "should expose frozen compile-time dispatch identity by instruction class":
        val load = strict_riscv_scalar_lsu_access_plan(CoreConfig.rv64(), 0x0000B083).unwrap()
        expect(load.canonical_instruction).to_equal(0x0000B083)
        expect(load.rd_index).to_equal(1)
        expect(load.rs1_index).to_equal(1)
        expect(load.rs2_index).to_equal(0)
        expect(load.requires_rs2).to_equal(false)
        val store = strict_riscv_scalar_lsu_access_plan(CoreConfig.rv64(), 0x0020B023).unwrap()
        expect(store.rd_index).to_equal(0)
        expect(store.rs1_index).to_equal(1)
        expect(store.rs2_index).to_equal(2)
        expect(store.requires_rs2).to_equal(true)

    it "should cover every admitted base access width and signedness":
        val rv32 = CoreConfig.rv32(); val b32 = LsuConfig.rv32_product_default()
        expect_access(rv32, b32, 0x00008083, 1, "sext") # LB
        expect_access(rv32, b32, 0x0000C083, 1, "zext") # LBU
        expect_access(rv32, b32, 0x00009083, 2, "sext") # LH
        expect_access(rv32, b32, 0x0000D083, 2, "zext") # LHU
        expect_access(rv32, b32, 0x0000A083, 4, "sext") # LW
        expect_access(rv32, b32, 0x00208023, 1, "zext") # SB
        expect_access(rv32, b32, 0x00209023, 2, "zext") # SH
        expect_access(rv32, b32, 0x0020A023, 4, "zext") # SW
        val rv64 = CoreConfig.rv64(); val b64 = LsuConfig.rv64_product_default()
        expect_access(rv64, b64, 0x0000E083, 4, "zext") # LWU
        expect_access(rv64, b64, 0x0000B083, 8, "zext") # LD
        expect_access(rv64, b64, 0x0020B023, 8, "zext") # SD

    it "should expose address lane mask extension and local fault nodes":
        val built = strict_riscv_scalar_lsu_projection("lsu_lane", CoreConfig.rv64(),
            LsuConfig.rv64_product_default(), 0x0000B083)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val module = built.ok().unwrap()
            expect(module.port_width("request_byte_mask")).to_equal(8)
            expect(module.port_width("request_write_data")).to_equal(64)
            expect(module.port_width("local_tval")).to_equal(64)
            expect(module.comb_ops.len()).to_be_greater_than(10)
            expect(module.compare_ops.len()).to_equal(2)

    it "should fail closed for non-memory rows and access wider than the bus":
        expect(strict_riscv_scalar_lsu_projection("bad_add", CoreConfig.rv32(),
            LsuConfig.rv32_product_default(), 0x002082B3).is_err()).to_equal(true)
        expect(strict_riscv_scalar_lsu_projection("bad_ld", CoreConfig.rv64(),
            LsuConfig.rv32_product_default(), 0x0000B083).is_err()).to_equal(true)
