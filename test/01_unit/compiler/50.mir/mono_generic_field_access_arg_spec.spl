use std.spec.*

struct InnerProbeItem:
    tag: text
    counts: [i64]

struct OuterProbeContainer:
    values: [i64]
    names: [text]
    labels: Dict<i64, text>
    note: text?
    inner: InnerProbeItem

fn generic_field_sink<T>(item: T) -> bool:
    true

describe "mono_generic_field_access_arg_unspecialized regression":
    it "infers T directly from struct and nested struct field access arguments":
        val c = OuterProbeContainer(
            values: [1, 2, 3],
            names: ["a", "b"],
            labels: {10: "x"},
            note: Some("present"),
            inner: InnerProbeItem(tag: "t", counts: [9])
        )
        expect(generic_field_sink(c.values)).to_equal(true)
        expect(generic_field_sink(c.names)).to_equal(true)
        expect(generic_field_sink(c.labels)).to_equal(true)
        expect(generic_field_sink(c.note)).to_equal(true)
        expect(generic_field_sink(c.inner)).to_equal(true)
        expect(generic_field_sink(c.inner.counts)).to_equal(true)
