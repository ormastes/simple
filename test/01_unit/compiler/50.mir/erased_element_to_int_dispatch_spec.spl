# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: `.to_int()` on an erased receiver is a runtime-dispatched conversion, not a text parse

Bug: doc/08_tracking/bug/erased_receiver_to_int_lowered_as_text_parse_2026-11-23.md.
An UNTYPED receiver whose method name is in the primitive text table was admitted
to the erased-receiver text arm. `to_i64` already escaped to the tagged conversion
owner `rt_any_to_int` (parses text, unboxes numbers), but its alias `to_int` did
not, so `xs[i].to_int()` on an erased index read boxed the element and parsed it
with rt_string_to_int_lenient -- a numeric element became 0. Element types that
ARE known (`[i64]`, `[u8]`, `Dict<text, i64>`) already propagate and stay numeric;
those cases are pinned here as regressions. A declared text receiver must still parse.
"""

# @tag: unit, compiler, mir, builtins

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn lower_mir_module(src: text) -> MirModule:
    val file = "testdata/fixture_erased_to_int.spl"
    val parsed = parse_full_frontend(src, file, "fixture_erased_to_int", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    lowering.lower_module(hir)

fn callees_of(src: text) -> [text]:
    val mir = lower_mir_module(src)
    var callees: [text] = []
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                callees = callees.push(name)
                            case _: pass
                    case _: pass
    callees

fn block_callees(mir: MirModule, label: text) -> [text]:
    var callees: [text] = []
    for function in mir.functions.values():
        for block in function.blocks:
            if (block.label ?? "") == label:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Call(_, callee, _):
                            match callee.kind:
                                case MirOperandKind.Const(MirConstValue.Str(name), _):
                                    callees = callees.push(name)
                                case _: pass
                        case _: pass
    callees

fn block_has_float_const(mir: MirModule, label: text, expected: f64) -> bool:
    for function in mir.functions.values():
        for block in function.blocks:
            if (block.label ?? "") == label:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Const(_, MirConstValue.Float(v), _):
                            if v == expected:
                                return true
                        case _: pass
    false

fn has_callee(callees: [text], name: text) -> bool:
    for c in callees:
        if c == name:
            return true
    false

describe "to_int on an erased element read":
    it "erased index read xs[i].to_int() dispatches at runtime instead of parsing text":
        step("lower `xs[i].to_int()` where `xs` is an untyped parameter")
        val callees = callees_of("fn f(xs, i: i64) -> i64:\n    xs[i].to_int()\n")
        expect(has_callee(callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "an untyped local bound to an erased index read keeps the runtime dispatch":
        step("bind `val x = xs[i]` without a type, then call `x.to_int()`")
        val callees = callees_of("fn f(xs, i: i64) -> i64:\n    val x = xs[i]\n    x.to_int()\n")
        expect(has_callee(callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "to_i64 on the same erased read keeps its runtime dispatch":
        step("lower `xs[i].to_i64()` where `xs` is an untyped parameter")
        val callees = callees_of("fn f(xs, i: i64) -> i64:\n    xs[i].to_i64()\n")
        expect(has_callee(callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

describe "to_int / to_i64 near erased receivers":
    it "an untyped parameter's to_int dispatches at runtime":
        step("lower `x.to_int()` on an untyped parameter")
        val callees = callees_of("fn f(x) -> i64:\n    x.to_int()\n")
        expect(has_callee(callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "a typed [i64] element stays a numeric conversion":
        step("lower `xs[i].to_i64()` and `xs[i].to_int()` on `xs: [i64]`")
        val a = callees_of("fn f(xs: [i64], i: i64) -> i64:\n    xs[i].to_i64()\n")
        expect(has_callee(a, "rt_string_to_int_lenient")).to_equal(false)
        val b = callees_of("fn f(xs: [i64], i: i64) -> i64:\n    xs[i].to_int()\n")
        expect(has_callee(b, "rt_string_to_int_lenient")).to_equal(false)

    it "a typed [u8] element and a Dict<text, i64> value stay numeric":
        step("lower `.to_int()` on a `[u8]` element and a dict value")
        val a = callees_of("fn f(xs: [u8], i: i64) -> i64:\n    xs[i].to_int()\n")
        expect(has_callee(a, "rt_string_to_int_lenient")).to_equal(false)
        val b = callees_of("fn f(d: Dict<text, i64>) -> i64:\n    d[\"a\"].to_int()\n")
        expect(has_callee(b, "rt_string_to_int_lenient")).to_equal(false)

    it "a declared text receiver still parses through the text table":
        step("control: `s.to_int()` on text must keep rt_string_to_int_lenient")
        val callees = callees_of("fn f(s: text) -> i64:\n    s.to_int()\n")
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(true)

    it "a typed [text] element still parses through the text table":
        step("control: `xs[i].to_int()` on `xs: [text]` must keep rt_string_to_int_lenient")
        val callees = callees_of("fn f(xs: [text], i: i64) -> i64:\n    xs[i].to_int()\n")
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(true)
        expect(has_callee(callees, "rt_any_to_int")).to_equal(false)

describe "to_float / to_f64 / to_f32 / to_u8 on erased element reads":
    it "erased index read xs[i].to_float() decodes tagged runtime values without ensure_tagged_str or string-to-int fallback":
        step("lower `xs[i].to_float()` where `xs` is an untyped parameter")
        val mir = lower_mir_module("fn f(xs, i: i64) -> f64:\n    xs[i].to_float()\n")
        val callees = callees_of("fn f(xs, i: i64) -> f64:\n    xs[i].to_float()\n")
        expect(has_callee(callees, "rt_value_is_float")).to_equal(true)
        expect(has_callee(callees, "rt_value_is_nil")).to_equal(true)
        expect(has_callee(callees, "rt_string_eq")).to_equal(true)
        expect(has_callee(callees, "rt_value_as_float")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_float")).to_equal(true)
        expect(has_callee(callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(callees, "rt_interp_cstr")).to_equal(false)
        # Unparsable text ("a", "42abc") and nil must return 0.0 directly, never rt_any_to_int.
        expect(block_has_float_const(mir, "any_decode_text_invalid", 0.0)).to_equal(true)
        expect(has_callee(block_callees(mir, "any_decode_text_invalid"), "rt_any_to_int")).to_equal(false)
        expect(block_has_float_const(mir, "any_decode_nil", 0.0)).to_equal(true)
        expect(has_callee(block_callees(mir, "any_decode_nil"), "rt_any_to_int")).to_equal(false)

    it "erased index reads xs[i].to_f64() and xs[i].to_f32() decode tagged runtime values":
        step("lower `xs[i].to_f64()` and `xs[i].to_f32()` on untyped `xs`")
        val f64_callees = callees_of("fn f(xs, i: i64) -> f64:\n    xs[i].to_f64()\n")
        expect(has_callee(f64_callees, "rt_value_is_float")).to_equal(true)
        expect(has_callee(f64_callees, "rt_value_as_float")).to_equal(true)
        expect(has_callee(f64_callees, "rt_string_to_float")).to_equal(true)
        expect(has_callee(f64_callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(f64_callees, "rt_interp_cstr")).to_equal(false)
        val f32_callees = callees_of("fn f(xs, i: i64) -> f32:\n    xs[i].to_f32()\n")
        expect(has_callee(f32_callees, "rt_value_is_float")).to_equal(true)
        expect(has_callee(f32_callees, "rt_value_as_float")).to_equal(true)
        expect(has_callee(f32_callees, "rt_string_to_float")).to_equal(true)
        expect(has_callee(f32_callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(f32_callees, "rt_interp_cstr")).to_equal(false)

    it "erased index read xs[i].to_u8() decodes via rt_any_to_int before narrowing":
        step("lower `xs[i].to_u8()` on untyped `xs`")
        val callees = callees_of("fn f(xs, i: i64) -> u8:\n    xs[i].to_u8()\n")
        expect(has_callee(callees, "rt_any_to_int")).to_equal(true)
        expect(has_callee(callees, "__simple_rt_string_byte_at")).to_equal(false)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "typed [i64] and declared text controls preserve direct numeric and text paths":
        step("controls: [i64] stays numeric; text keeps text parsing / byte_at")
        val int_float_callees = callees_of("fn f(xs: [i64], i: i64) -> f64:\n    xs[i].to_float()\n")
        expect(has_callee(int_float_callees, "rt_value_is_float")).to_equal(false)
        expect(has_callee(int_float_callees, "rt_string_to_float")).to_equal(false)
        val int_u8_callees = callees_of("fn f(xs: [i64], i: i64) -> u8:\n    xs[i].to_u8()\n")
        expect(has_callee(int_u8_callees, "rt_any_to_int")).to_equal(false)
        val text_float_callees = callees_of("fn f(s: text) -> f64:\n    s.to_float()\n")
        expect(has_callee(text_float_callees, "rt_string_to_float")).to_equal(true)
        expect(has_callee(text_float_callees, "rt_value_is_float")).to_equal(false)
        val text_u8_callees = callees_of("fn f(s: text) -> u8:\n    s.to_u8()\n")
        expect(has_callee(text_u8_callees, "__simple_rt_string_byte_at")).to_equal(true)
        expect(has_callee(text_u8_callees, "rt_any_to_int")).to_equal(false)

    it "erased element conversions match interpreter runtime oracle":
        val mixed = [42, "3.5", "a", "42abc", ""]
        expect(mixed[0].to_float()).to_equal(42.0)
        expect(mixed[1].to_f64()).to_equal(3.5)
        expect(mixed[2].to_float()).to_equal(0.0)
        expect(mixed[3].to_f64()).to_equal(0.0)
        expect(mixed[4].to_float()).to_equal(0.0)
        expect((mixed[1].to_f32()) > 3.0).to_equal(true)
        val nums = [300, 42]
        expect(nums[0].to_u8()).to_equal(44u8)
        expect(nums[1].to_u8()).to_equal(42u8)
