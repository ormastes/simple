    it "handles single-impl devirtualized trait receiver `mut` primitive call and writeback":
        val parsed = parse_full_frontend(TRAIT_SRC, "devirt_trait_probe.spl", "devirt_trait_probe", Logger(level: 0))
        var hl = HirLowering.with_filename("devirt_trait_probe.spl")
        val hir = hl.lower_module(parsed)
        var ml = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
        ml.trait_impl_closure_complete = true
        val _init_mir = ml.lower_module(hir)
        var trait_sym = SymbolId(id: -1)
        for tr in hir.traits.values():
            if tr.name == "Bumper":
                trait_sym = tr.symbol
        var b = ml.builder
        val sig = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
        b.begin_function(SymbolId(id: 9901), "devirt_probe", sig, Span.empty())
        val trait_local = b.emit_const_int(0)
        val n_local = b.emit_const_int(41)
        ml.builder = b
        ml.bind_local(9902, n_local)
        ml.bind_local(9903, trait_local)
        val trait_hir = HirType(kind: HirTypeKind.Named(trait_sym, []), span: Span.empty())
        val i64_hir = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        val recv_expr = HirExpr(kind: HirExprKind.Var(SymbolId(id: 9903)), has_type_: true, type_: trait_hir, span: Span.empty())
        val arg_expr = HirExpr(kind: HirExprKind.Var(SymbolId(id: 9902)), has_type_: true, type_: i64_hir, span: Span.empty())
        val arg = HirCallArg(has_name: true, name: "x", value: arg_expr, span: Span.empty())
        val trait_key = ml.trait_receiver_identity(recv_expr, "bump")
        expect(trait_key).to_equal("devirt_trait_probe.Bumper")
        val before_devirt = ml.devirtualized_calls
        val _res = ml.lower_trait_receiver_method_call(trait_key, recv_expr, "bump", [arg])
        expect(ml.devirtualized_calls).to_equal(before_devirt + 1)
        var b_end = ml.builder
        b_end.set_terminator(MirTerminator.Ret(Some(mir_operand_copy(n_local))))
        val devirt_fn = b_end.end_function()
        ml.builder = b_end
        expect(count_in_fn(devirt_fn, "alloc")).to_equal(1)
        expect(count_in_fn(devirt_fn, "store")).to_equal(1)
        expect(count_in_fn(devirt_fn, "load")).to_equal(1)
        expect(has_copy_to_local(devirt_fn, n_local)).to_equal(true)
        expect(has_call_named_or_ptr(devirt_fn, false)).to_equal(true)

    it "resolves unambiguous qualified declaration_parameter_defaults before ambiguous bare entries":
        val template_ast = parse_full_frontend("fn tmpl(delta: i64, x: mut i64):\n    x = x + delta\n", "decl_tmpl.spl", "decl_tmpl", Logger(level: 0))
        var template_hl = HirLowering.with_filename("decl_tmpl.spl")
        val template_hir = template_hl.lower_module(template_ast)
        val template_fn: HirFunction = template_hir.functions.values()[0]
        val i64_hir = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        val mut_i64_hir = HirType(kind: HirTypeKind.Ref(i64_hir, true), span: Span.empty())
        val decl_params = [
            MirHirParamDeclarationV1(symbol: SymbolId(id: 1), name: "delta", type_: i64_hir, has_default: false, default_artifact: None, span: Span.empty(), is_mutable: false),
            MirHirParamDeclarationV1(symbol: SymbolId(id: 2), name: "x", type_: mut_i64_hir, has_default: false, default_artifact: None, span: Span.empty(), is_mutable: true)
        ]
        val decl_run = MirHirFunctionDeclarationV1(
            symbol: template_fn.symbol,
            name: "run",
            type_params: template_fn.type_params,
            params: decl_params,
            return_type: template_fn.return_type,
            effects: template_fn.effects,
            visibility: template_fn.visibility,
            is_async: template_fn.is_async,
            is_static: template_fn.is_static,
            is_public: template_fn.is_public,
            is_method: template_fn.is_method,
            is_mutable: template_fn.is_mutable,
            is_const: template_fn.is_const,
            is_extern: template_fn.is_extern,
            func_attr: template_fn.func_attr,
            has_export_attr: template_fn.has_export_attr,
            export_attr: template_fn.export_attr,
            is_generic_template: template_fn.is_generic_template,
            span: Span.empty()
        )
        var syms_decl = SymbolTable.new()
        val run_sym = syms_decl.define("run", SymbolKind.Function, None, Span.empty(), Visibility.Public, false, Some("mod_a"))
        val dup_sym = syms_decl.define("dup", SymbolKind.Function, None, Span.empty(), Visibility.Public, false, Some("mod_b"))
        var ml_decl = MirLowering.new_for_target(syms_decl, driver_mir_target_context(driver_core_compile_options_default()))
        ml_decl.declaration_repository = Some(MirHirDeclarationRepositoryV1(
            artifact_context: HirOwnedArtifactContextV1(directory: "", producer_header: "", enabled: false),
            final_repository_authority: "probe",
            ordered_modules: [],
            modules: {},
            authority: "probe"
        ))
        ml_decl.declaration_parameter_defaults["mod_a.run"] = MirHirCallableDefaultsV1(module_name: "mod_a", function: decl_run)
        ml_decl.declaration_parameter_defaults_ambiguous["run"] = true
        ml_decl.declaration_parameter_defaults_ambiguous["dup"] = true

        var bd = ml_decl.builder
        bd.begin_function(SymbolId(id: 9960), "decl_spec_probe", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), Span.empty())
        val n_d = bd.emit_const_int(10)
        val delta_d = bd.emit_const_int(5)
        ml_decl.builder = bd
        ml_decl.bind_local(9961, n_d)
        val arg_rx = HirCallArg(has_name: true, name: "x", value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 9961)), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val arg_rdelta = HirCallArg(has_name: true, name: "delta", value: HirExpr(kind: HirExprKind.IntLit(5, None), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val run_pack = ml_decl.lower_explicit_call_args_with_writebacks_v1([], [arg_rx, arg_rdelta], [i64_hir, mut_i64_hir], 0, run_sym)
        expect(ml_decl.errors.len()).to_equal(0)
        expect(run_pack.operands.len()).to_equal(2)
        expect(run_pack.writebacks.len()).to_equal(1)
        ml_decl.emit_mut_ref_primitive_writebacks_v1(run_pack.writebacks)
        expect(ml_decl.named_call_slots_v1("run", [arg_rx, arg_rdelta], run_sym)).to_equal(Ok([1, 0]))
        expect(ml_decl.named_call_slots_v1("mod_a.run", [arg_rx, arg_rdelta], SymbolId(id: -1))).to_equal(Ok([1, 0]))
        val completed = ml_decl.complete_named_call_operands_v1("run", [mir_operand_copy(n_d), mir_operand_copy(delta_d)], [1, 0], run_sym)
        expect(completed.len()).to_equal(2)
        expect(ml_decl.errors.len()).to_equal(0)

        var slot_is_ptr_0 = false
        var slot_is_ptr_1 = false
        var bd_mid = ml_decl.builder
        val probe_fn_ok = bd_mid.end_function()
        ml_decl.builder = bd_mid
        match run_pack.operands[0].kind:
            case MirOperandKind.Copy(l0) | MirOperandKind.Move(l0):
                for loc in probe_fn_ok.locals:
                    if loc.id.id == l0.id:
                        match loc.type_.kind:
                            case MirTypeKind.Ptr(_, _): slot_is_ptr_0 = true
                            case _: ()
            case _: ()
        match run_pack.operands[1].kind:
            case MirOperandKind.Copy(l1) | MirOperandKind.Move(l1):
                for loc in probe_fn_ok.locals:
                    if loc.id.id == l1.id:
                        match loc.type_.kind:
                            case MirTypeKind.Ptr(_, _): slot_is_ptr_1 = true
                            case _: ()
            case _: ()
        expect(slot_is_ptr_0).to_equal(false)
        expect(slot_is_ptr_1).to_equal(true)
        expect(count_in_fn(probe_fn_ok, "alloc")).to_equal(1)
        expect(count_in_fn(probe_fn_ok, "store")).to_equal(1)
        expect(count_in_fn(probe_fn_ok, "load")).to_equal(1)

        val dup_slots = ml_decl.named_call_slots_v1("dup", [arg_rx, arg_rdelta], dup_sym)
        expect(dup_slots.is_err()).to_equal(true)
        expect(dup_slots.unwrap_err()).to_contain("named call lacks unique declaration metadata")
        var bd_fail = ml_decl.builder
        bd_fail.begin_function(SymbolId(id: 9962), "decl_dup_probe", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), Span.empty())
        val n_dup = bd_fail.emit_const_int(1)
        ml_decl.builder = bd_fail
        ml_decl.bind_local(9963, n_dup)
        val arg_dx = HirCallArg(has_name: true, name: "x", value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 9963)), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val dup_pack = ml_decl.lower_explicit_call_args_with_writebacks_v1([], [arg_dx, arg_rdelta], [i64_hir, mut_i64_hir], 0, dup_sym)
        var bd_fail_end = ml_decl.builder
        val dup_fn = bd_fail_end.end_function()
        ml_decl.builder = bd_fail_end
        expect(ml_decl.errors.len()).to_be_greater_than(0)
        expect(ml_decl.errors[0].message).to_contain("named call lacks unique declaration metadata")
        expect(dup_pack.writebacks.len()).to_equal(0)
        expect(count_in_fn(dup_fn, "alloc")).to_equal(0)

    it "prioritizes same-module module_fn_params over prescanned bootstrap defaults for omitted non-literal defaults":
        val parsed = parse_full_frontend(PRESCAN_SAME_MOD_NONLIT_SRC, "prescan_same_mod_nonlit.spl", "prescan_same_mod_nonlit", Logger(level: 0))
        var hl = HirLowering.with_filename("prescan_same_mod_nonlit.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        var ml = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
        ml.trait_impl_closure_complete = true
        var prescan_mods: Dict<text, HirModule> = {}
        prescan_mods[hir.name] = hir
        ml.prescan_module_struct_names(prescan_mods, hir.name)
        val mod = ml.lower_module(hir)
        expect(ml.errors.len()).to_equal(0)
        val main_opt = find_fn_in_mir(mod, "main")
        expect(main_opt.?).to_equal(true)
        val main_fn = main_opt.unwrap()
        expect(count_in_fn(main_fn, "alloc")).to_equal(2)
        expect(count_in_fn(main_fn, "store")).to_equal(2)
        expect(count_in_fn(main_fn, "load")).to_equal(2)
        expect(call_has_arg_types(main_fn, "free_nonlit", [0], 2)).to_equal(true)
        expect(call_has_arg_types(main_fn, "NonLitWorker.add_nonlit", [1], 3)).to_equal(true)
        expect(mir_verify_module(mod).findings.len()).to_equal(0)

        var syms_xmod = SymbolTable.new()
        val xmod_sym = syms_xmod.define("cross_boot.mod.free_nonlit", SymbolKind.Function, None, Span.empty(), Visibility.Public, false, Some("cross_boot.mod"))
        val i64_hir = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        val mut_i64_hir = HirType(kind: HirTypeKind.Ref(i64_hir, true), span: Span.empty())
        val lit_zero = HirExpr(kind: HirExprKind.IntLit(0, None), has_type_: true, type_: i64_hir, span: Span.empty())
        val non_lit_callee = HirExpr(kind: HirExprKind.Var(SymbolId(id: 9975)), has_type_: true, type_: i64_hir, span: Span.empty())
        val non_lit_default = HirExpr(kind: HirExprKind.Call(non_lit_callee, [], []), has_type_: true, type_: i64_hir, span: Span.empty())
        bootstrap_fn_param_defaults_register("cross_boot.mod.free_nonlit", [
            HirParam(symbol: SymbolId(id: 1), name: "x", type_: mut_i64_hir, has_default: false, default: lit_zero, span: Span.empty(), is_mutable: true),
            HirParam(symbol: SymbolId(id: 2), name: "delta", type_: i64_hir, has_default: true, default: non_lit_default, span: Span.empty(), is_mutable: false)
        ], "cross_boot.mod")
        var ml_xmod = MirLowering.new_for_target(syms_xmod, driver_mir_target_context(driver_core_compile_options_default()))
        var bx = ml_xmod.builder
        bx.begin_function(SymbolId(id: 9970), "cross_boot_probe", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), Span.empty())
        val n_x = bx.emit_const_int(40)
        ml_xmod.builder = bx
        ml_xmod.bind_local(9971, n_x)
        val arg_xx = HirCallArg(has_name: true, name: "x", value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 9971)), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val xmod_slots = ml_xmod.named_call_slots_v1("cross_boot.mod.free_nonlit", [arg_xx], xmod_sym)
        expect(xmod_slots.is_err()).to_equal(true)
        expect(xmod_slots.unwrap_err()).to_contain("named default requires admitted declaration scope")
        val xmod_pack = ml_xmod.lower_explicit_call_args_with_writebacks_v1([], [arg_xx], [mut_i64_hir, i64_hir], 0, xmod_sym)
        var bx_end = ml_xmod.builder
        val xmod_fn = bx_end.end_function()
        ml_xmod.builder = bx_end
        expect(ml_xmod.errors.len()).to_be_greater_than(0)
        expect(ml_xmod.errors[0].message).to_contain("named default requires admitted declaration scope")
        expect(xmod_pack.writebacks.len()).to_equal(0)
        expect(count_in_fn(xmod_fn, "alloc")).to_equal(0)

    it "plain by-value param stays by value (control)":
        expect(count_kind(PLAIN_SRC, "main", "alloc")).to_equal(0)
        expect(count_kind(PLAIN_SRC, "keep", "store")).to_equal(0)

    it "mut struct param keeps the pointer path without a primitive alloc slot (control)":
        expect(count_kind(STRUCT_SRC, "main", "alloc")).to_equal(0)

    it "mut array param keeps the pointer path without a primitive alloc slot (control)":
        expect(count_kind(ARRAY_SRC, "main", "alloc")).to_equal(0)
