        val recv_l = bl.emit_const_int(0)
        val n_l = bl.emit_const_int(11)
        ml_lit.builder = bl
        ml_lit.bind_local(9951, n_l)
        val arg_lx = HirCallArg(has_name: true, name: "x", value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 9951)), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val lit_pack = ml_lit.lower_explicit_call_args_with_writebacks_v1([mir_operand_copy(recv_l)], [arg_lx], [i64_hir, mut_i64_hir, i64_hir], 1, lit_sym)
        var bl_end = ml_lit.builder
        val lit_fn = bl_end.end_function()
