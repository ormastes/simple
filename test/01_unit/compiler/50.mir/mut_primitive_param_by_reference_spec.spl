        expect(ir).to_contain("define void @mut_prim_param_probe.OptWorker.add_reordered(ptr %l0, i64 %l1, ptr %l2)")
        expect(ir).to_contain("define void @mut_prim_param_probe.free_opt(ptr %l0, i64 %l1)")

