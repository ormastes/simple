        val lit_seven = HirExpr(kind: HirExprKind.IntLit(7, None), has_type_: true, type_: i64_hir, span: Span.empty())
        bootstrap_fn_param_defaults_register("boot.mod.add_lit", [
            HirParam(symbol: SymbolId(id: 1), name: "self", type_: i64_hir, has_default: false, default: lit_zero, span: Span.empty(), is_mutable: false),
            HirParam(symbol: SymbolId(id: 2), name: "x", type_: mut_i64_hir, has_default: false, default: lit_zero, span: Span.empty(), is_mutable: true),
            HirParam(symbol: SymbolId(id: 3), name: "delta", type_: i64_hir, has_default: true, default: lit_seven, span: Span.empty(), is_mutable: false)
        ], "boot.mod")
