# @req REQ-SSPEC-COMPILER
"""
# MIR & LLVM: `x: mut <primitive>` is passed by reference across calls

Bug: mut_param_annotation_no_reference_propagation_2026-07-20

`fn bump(x: mut i64): x = x + 1` must write through to the caller's place.
HIR lowers `mut T` to Ref(T, true); MIR passes a stack-slot address
(`Alloc` + `Store`) at free calls, method calls (instance, static, UFCS),
field/index lvalues, and nested `mut` callers, then loads back (`Load`) and
writes back to the caller place; the callee loads on entry and stores back
before every return.
Struct and array `mut` params keep their existing pointer path.
"""
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{SymbolId, SymbolTable, SymbolKind}
use compiler.hir.hir_definitions.*
use compiler.common.dependency.visibility.{Visibility}
use compiler.mir.mir.*
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.{mir_verify_module}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_lowering_stmts.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.named_call_arguments_v1.*
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir.hir_declaration_types_v1.{MirHirDeclarationRepositoryV1, MirHirCallableDefaultsV1, MirHirFunctionDeclarationV1, MirHirParamDeclarationV1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}
use compiler.mir._MirLoweringExpr.method_calls_literals.*
use compiler.common.diagnostics.span.{Span}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}

val PRIM_SRC = "fn bump(x: mut i64):\n    x = x + 1\n\nfn main() -> i64:\n    var n = 41\n    bump(n)\n    n\n"
val EARLY_SRC = "fn bump2(x: mut i64) -> i64:\n    if x > 0:\n        x = x + 1\n        return 1\n    x = 7\n    0\n\nfn main() -> i64:\n    var n = 41\n    bump2(n)\n    n\n"
val PLAIN_SRC = "fn keep(x: i64) -> i64:\n    x + 1\n\nfn main() -> i64:\n    var n = 41\n    keep(n)\n    n\n"
val STRUCT_SRC = "struct P:\n    v: i64\n\nfn sbump(p: mut P):\n    p.v = p.v + 1\n\nfn main() -> i64:\n    var p = P(v: 1)\n    sbump(p)\n    p.v\n"
val ARRAY_SRC = "fn abump(xs: mut [i64]):\n    xs[0] = xs[0] + 1\n\nfn main() -> i64:\n    var xs = [1, 2]\n    abump(xs)\n    xs[0]\n"
val METHOD_SRC = "class Worker:\n    tag: i64\n    fn add_one(x: mut i64):\n        x = x + 1\n    static fn add_two(x: mut i64):\n        x = x + 2\n\nfn ufcs_bump(w: Worker, x: mut i64):\n    x = x + 3\n\nfn main() -> i64:\n    var a = 10\n    val w = Worker(tag: 1)\n    w.add_one(a)\n    Worker.add_two(a)\n    w.ufcs_bump(a)\n    a\n"
val LVALUE_SRC = "struct Box:\n    count: i64\n\nfn bump(x: mut i64):\n    x = x + 1\n\nfn outer(y: mut i64):\n    bump(y)\n\nfn main() -> i64:\n    var b = Box(count: 5)\n    var xs = [10, 20]\n    bump(b.count)\n    bump(xs[0])\n    var n = 40\n    outer(n)\n    b.count + xs[0] + n\n"
val DICT_TUPLE_SRC = "fn bump(x: mut i64):\n    x = x + 1\n\nfn dict_case() -> i64:\n    var d: Dict<text, i64> = {\"k\": 10}\n    bump(d[\"k\"])\n    d[\"k\"]\n\nfn tuple_case() -> i64:\n    var t = (10, 20)\n    bump(t.0)\n    t.0\n"
val NAMED_METHOD_SRC = "class Worker:\n    tag: i64\n    fn add_one(x: mut i64):\n        x = x + 1\n    fn add_pair(delta: i64, x: mut i64):\n        x = x + delta\n    static fn add_two(x: mut i64):\n        x = x + 2\n\nfn ufcs_bump(w: Worker, x: mut i64):\n    x = x + 3\n\nfn main() -> i64:\n    var a = 10\n    val w = Worker(tag: 1)\n    w.add_one(x: a)\n    w.add_pair(x: a, delta: 5)\n    Worker.add_two(x: a)\n    w.ufcs_bump(x: a)\n    a\n"
val NAMED_INDIRECT_FIELD_SRC = "struct Runner:\n    cb: fn(mut i64)\n    cb2: fn(i64, mut i64)\n\nfn apply_indirect(cb: fn(mut i64)) -> i64:\n    var n = 10\n    cb(x: n)\n    n\n\nfn apply_indirect_two(cb: fn(i64, mut i64)) -> i64:\n    var n = 15\n    cb(5, x: n)\n    n\n\nfn apply_field(r: Runner) -> i64:\n    var n = 20\n    r.cb(x: n)\n    n\n\nfn apply_field_two(r: Runner) -> i64:\n    var n = 25\n    r.cb2(5, x: n)\n    n\n\nfn apply_paren_field(r: Runner) -> i64:\n    var n = 30\n    (r.cb)(x: n)\n    n\n"
val DIRECT_NAMED_SRC = "fn add_pair(delta: i64, x: mut i64):\n    x = x + delta\n\nfn main() -> i64:\n    var n = 10\n    add_pair(x: n, delta: 5)\n    n\n"
val SAME_MOD_OPT_SRC = "class OptWorker:\n    tag: i64\n    fn add_opt(x: mut i64, delta: i64 = 5):\n        x = x + delta\n    fn add_reordered(delta: i64 = 7, x: mut i64):\n        x = x + delta\n\nfn free_opt(x: mut i64, delta: i64 = 9):\n    x = x + delta\n\nfn main() -> i64:\n    var a = 10\n    val w = OptWorker(tag: 1)\n    w.add_opt(x: a)\n    w.add_reordered(x: a)\n    free_opt(x: a)\n    a\n"
val PRESCAN_SAME_MOD_NONLIT_SRC = "fn default_delta() -> i64:\n    7\n\nfn free_nonlit(x: mut i64, delta: i64 = default_delta()):\n    x = x + delta\n\nclass NonLitWorker:\n    tag: i64\n    fn add_nonlit(x: mut i64, delta: i64 = -1):\n        x = x + delta\n\nfn main() -> i64:\n    var n = 10\n    free_nonlit(x: n)\n    var a = 20\n    val w = NonLitWorker(tag: 1)\n    w.add_nonlit(x: a)\n    n + a\n"
val TRAIT_SRC = "trait Bumper:\n    fn bump(x: mut i64)\n\nclass ImplBumper with Bumper:\n    tag: i64\n    fn bump(x: mut i64):\n        x = x + 1\n\nfn via_trait_pos(b: Bumper) -> i64:\n    var n = 41\n    b.bump(n)\n    n\n\nfn via_trait_named(b: Bumper) -> i64:\n    var n = 41\n    b.bump(x: n)\n    n\n"
val TRAIT_CAST_SRC = "trait Bumper:\n    fn bump(x: mut i64)\n\nclass ImplBumper with Bumper:\n    tag: i64\n    fn bump(x: mut i64):\n        x = x + 1\n\nfn via_trait(b: Bumper) -> i64:\n    var n = 41\n    b.bump(x: n)\n    n\n\nfn main() -> i64:\n    val imp = ImplBumper(tag: 1)\n    via_trait(imp)\n"
val MULTI_PRIM_SRC = "fn bump_f(x: mut f64):\n    x = x + 1.5\n\nfn flip_b(b: mut bool):\n    b = not b\n\nfn main() -> i64:\n    var f = 2.0\n    var flag = false\n    bump_f(f)\n    flip_b(flag)\n    if flag: 1 else: 0\n"

fn lower_src(src: text) -> MirModule:
    val parsed = parse_full_frontend(src, "mut_prim_param_probe.spl", "mut_prim_param_probe", Logger(level: 0))
    var hl = HirLowering.with_filename("mut_prim_param_probe.spl")
    val hir = hl.lower_module(parsed)
    var ml = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    ml.trait_impl_closure_complete = true
    ml.lower_module(hir)

fn has_call_named_or_ptr(f: MirFunction, check_indirect: bool) -> bool:
    for block in f.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Call(_, callee, args):
                    if not check_indirect:
                        for arg in args:
                            match arg.kind:
                                case MirOperandKind.Copy(l) | MirOperandKind.Move(l):
                                    for loc in f.locals:
                                        if loc.id.id == l.id:
                                            match loc.type_.kind:
                                                case MirTypeKind.Ptr(_, _): return true
                                                case _: ()
                                case _: ()
                case MirInstKind.CallIndirect(_, _, args, sig):
                    if check_indirect:
                        var sig_has_mut = false
                        for p in sig.params:
                            match p.kind:
                                case MirTypeKind.Ptr(_, _) | MirTypeKind.Ref(_, true): sig_has_mut = true
                                case _: ()
                        var arg_has_ptr = false
                        for arg in args:
                            match arg.kind:
                                case MirOperandKind.Copy(l) | MirOperandKind.Move(l):
                                    for loc in f.locals:
                                        if loc.id.id == l.id:
                                            match loc.type_.kind:
                                                case MirTypeKind.Ptr(_, _): arg_has_ptr = true
                                                case _: ()
                                case _: ()
                        if sig_has_mut and arg_has_ptr:
                            return true
                case _: ()
    false

fn has_copy_to_local(f: MirFunction, target: LocalId) -> bool:
    for block in f.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Copy(dest, _):
                    if dest.id == target.id:
                        return true
                case _: ()
    false

fn call_has_arg_types(f: MirFunction, callee_suffix: text, expected_ptr_indices: [i64], expected_arity: i64) -> bool:
    for block in f.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Call(_, callee, args):
                    var matched_name = false
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(name), _):
                            if name == callee_suffix or name.ends_with("." + callee_suffix):
                                matched_name = true
                        case _: ()
                    if matched_name and args.len() == expected_arity:
                        var all_ok = true
                        var ai = 0
                        while ai < args.len():
                            var want_ptr = false
                            for pi in expected_ptr_indices:
                                if pi == ai:
                                    want_ptr = true
                            var is_ptr = false
                            match args[ai].kind:
                                case MirOperandKind.Copy(l) | MirOperandKind.Move(l):
                                    for loc in f.locals:
                                        if loc.id.id == l.id:
                                            match loc.type_.kind:
                                                case MirTypeKind.Ptr(_, _): is_ptr = true
                                                case _: ()
                                case _: ()
                            if want_ptr and not is_ptr:
                                all_ok = false
                            elif not want_ptr and is_ptr and ai > 0:
                                all_ok = false
                            ai = ai + 1
                        if all_ok:
                            return true
                case _: ()
    false

fn count_inst_names(module: MirModule, fn_name: text, callee_needle: text, want_gep: bool) -> i64:
    var hits = 0
    for entry in module.functions.values():
        val f: MirFunction = entry
        if f.name == fn_name or f.name.ends_with("." + fn_name):
            for block in f.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case MirInstKind.Call(_, callee, _):
                            match callee.kind:
                                case MirOperandKind.Const(MirConstValue.Str(c), _):
                                    if callee_needle != "" and c == callee_needle:
                                        hits = hits + 1
                                case _: ()
                        case MirInstKind.GetElementPtr(_, _, _):
                            if want_gep:
                                hits = hits + 1
                        case _: ()
    hits

fn find_fn_in_mir(module: MirModule, name: text) -> MirFunction?:
    for entry in module.functions.values():
        val f: MirFunction = entry
        if f.name == name or f.name.ends_with("." + name):
            return Some(f)
    None

fn count_in_fn(f: MirFunction, kind: text) -> i64:
    var count = 0
    for block in f.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Alloc(_, _):
                    if kind == "alloc": count = count + 1
                case MirInstKind.Load(_, _):
                    if kind == "load": count = count + 1
                case MirInstKind.Store(_, _):
                    if kind == "store": count = count + 1
                case MirInstKind.Ref(_, _, _):
                    if kind == "ref": count = count + 1
                case _: ()
    count

fn emit_llvm_ir(src: text) -> text:
    val mir = lower_src(src)
    MirToLlvm.create("mut_prim_llvm_probe", CodegenTarget.X86_64, None).translate_module(mir).to_string()

# Count instructions of one kind ("alloc", "load", "store", "ref") in function `name`.
fn count_kind(src: text, name: text, kind: text) -> i64:
    val module = lower_src(src)
    var count = 0
    for entry in module.functions.values():
        val f: MirFunction = entry
        if f.name == name or f.name.ends_with("." + name):
            for block in f.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case MirInstKind.Alloc(_, _):
                            if kind == "alloc": count = count + 1
                        case MirInstKind.Load(_, _):
                            if kind == "load": count = count + 1
                        case MirInstKind.Store(_, _):
                            if kind == "store": count = count + 1
                        case MirInstKind.Ref(_, _, _):
                            if kind == "ref": count = count + 1
                        case _: ()
    count

# Number of Ret terminators in function `name`.
fn count_returns(src: text, name: text) -> i64:
    val module = lower_src(src)
    var count = 0
    for entry in module.functions.values():
        val f: MirFunction = entry
        if f.name == name or f.name.ends_with("." + name):
            for block in f.blocks:
                match block.terminator:
                    case MirTerminator.Ret(_): count = count + 1
                    case _: ()
    count

describe "MIR by-reference calling convention for `mut` primitive params":
    it "caller allocates stack slot, stores initial value, and reloads updated value":
        expect(count_kind(PRIM_SRC, "main", "alloc")).to_be_greater_than(0)
        expect(count_kind(PRIM_SRC, "main", "store")).to_be_greater_than(0)
        expect(count_kind(PRIM_SRC, "main", "load")).to_be_greater_than(0)
        expect(count_kind(PRIM_SRC, "main", "ref")).to_equal(0)

    it "callee loads the incoming value through the reference":
        expect(count_kind(PRIM_SRC, "bump", "load")).to_be_greater_than(0)

    it "callee stores the new value back through the reference":
        expect(count_kind(PRIM_SRC, "bump", "store")).to_be_greater_than(0)

    it "stores back on every return path":
        expect(count_returns(EARLY_SRC, "bump2")).to_be_greater_than(0)
        expect(count_kind(EARLY_SRC, "bump2", "store")).to_be_greater_than(count_returns(EARLY_SRC, "bump2") - 1)
        expect(count_kind(EARLY_SRC, "bump2", "store")).to_be_greater_than(1)

    it "handles instance, static, and UFCS method calls with `mut` primitive args":
        expect(count_kind(METHOD_SRC, "main", "alloc")).to_be_greater_than(2)
        expect(count_kind(METHOD_SRC, "main", "store")).to_be_greater_than(2)
        expect(count_kind(METHOD_SRC, "main", "load")).to_be_greater_than(2)

    it "handles field, array-index, and nested `mut` param forwarding":
        expect(count_kind(LVALUE_SRC, "main", "alloc")).to_be_greater_than(2)
        expect(count_kind(LVALUE_SRC, "outer", "alloc")).to_be_greater_than(0)
        expect(count_kind(LVALUE_SRC, "outer", "store")).to_be_greater_than(1)

    it "emits real pointer-based LLVM IR (alloca + call ptr) for mut primitives":
        val ir = emit_llvm_ir(PRIM_SRC)
        expect(ir).to_contain("alloca i64")
        expect(ir).to_contain("bump(ptr")
        expect(ir).to_contain("store i64")
        val method_ir = emit_llvm_ir(METHOD_SRC)
        expect(method_ir).to_contain("add_one(ptr")
        expect(method_ir).to_contain("add_two(ptr")
        expect(method_ir).to_contain("ufcs_bump(ptr")
        val multi_ir = emit_llvm_ir(MULTI_PRIM_SRC)
        expect(multi_ir).to_contain("alloca double")
        expect(multi_ir).to_contain("bump_f(ptr")
        expect(multi_ir).to_contain("alloca i1")
        expect(multi_ir).to_contain("flip_b(ptr")

    it "passes MIR verification cleanly for mut-primitive callers and callees":
        expect(mir_verify_module(lower_src(PRIM_SRC)).findings.len()).to_equal(0)
        expect(mir_verify_module(lower_src(EARLY_SRC)).findings.len()).to_equal(0)
        expect(mir_verify_module(lower_src(METHOD_SRC)).findings.len()).to_equal(0)
        expect(mir_verify_module(lower_src(LVALUE_SRC)).findings.len()).to_equal(0)
        expect(mir_verify_module(lower_src(MULTI_PRIM_SRC)).findings.len()).to_equal(0)

    it "handles dict and tuple `mut` primitive writebacks":
        val mod = lower_src(DICT_TUPLE_SRC)
        expect(count_kind(DICT_TUPLE_SRC, "dict_case", "alloc")).to_be_greater_than(0)
        expect(count_inst_names(mod, "dict_case", "rt_dict_get", false)).to_be_greater_than(0)
        expect(count_inst_names(mod, "dict_case", "rt_dict_set", false)).to_be_greater_than(0)
        expect(count_kind(DICT_TUPLE_SRC, "tuple_case", "alloc")).to_be_greater_than(0)
        expect(count_kind(DICT_TUPLE_SRC, "tuple_case", "store")).to_be_greater_than(0)
        expect(count_kind(DICT_TUPLE_SRC, "tuple_case", "load")).to_be_greater_than(0)
        expect(count_inst_names(mod, "tuple_case", "", true)).to_be_greater_than(0)
        expect(mir_verify_module(mod).findings.len()).to_equal(0)

    it "handles named `mut` primitive args on instance, out-of-order, static, and UFCS methods":
        val mod = lower_src(NAMED_METHOD_SRC)
        val main_opt = find_fn_in_mir(mod, "main")
        expect(main_opt.?).to_equal(true)
        val main_fn = main_opt.unwrap()
        expect(count_in_fn(main_fn, "alloc")).to_be_greater_than(3)
        expect(count_in_fn(main_fn, "store")).to_be_greater_than(3)
        expect(count_in_fn(main_fn, "load")).to_be_greater_than(3)
        expect(call_has_arg_types(main_fn, "Worker.add_pair", [2], 3)).to_equal(true)
        val ir = emit_llvm_ir(NAMED_METHOD_SRC)
        expect(ir).to_contain("add_one(ptr")
        expect(ir).to_contain("define void @mut_prim_param_probe.Worker.add_pair(ptr %l0, i64 %l1, ptr %l2)")
        var add_pair_call_line = ""
        for ir_line in ir.split("\n"):
            if ir_line.contains("call void @mut_prim_param_probe.Worker.add_pair("):
                add_pair_call_line = ir_line
        expect(add_pair_call_line).to_contain("(ptr ")
        expect(add_pair_call_line).to_contain(", i64 ")
        expect(add_pair_call_line).to_contain(", ptr ")
        expect(ir).to_contain("add_two(ptr")
        expect(ir).to_contain("ufcs_bump(ptr")
        expect(mir_verify_module(mod).findings.len()).to_equal(0)

    it "fails closed when named call omits a trailing default without declaration default metadata":
        var syms_surf = SymbolTable.new()
        val surf_sym = syms_surf.define("ext.mod.add_opt", SymbolKind.Method, None, Span.empty(), Visibility.Public, false, Some("ext.mod"))
        var ml_surf = MirLowering.new_for_target(syms_surf, driver_mir_target_context(driver_core_compile_options_default()))
        expect(ml_surf.register_surface_param_rows_v1(["ext.mod"], ["add_opt"], [3], ["self", "x", "delta"], [false, false, true])).to_equal(1)
        var bs = ml_surf.builder
        bs.begin_function(SymbolId(id: 9910), "surf_probe", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), Span.empty())
        val recv_s = bs.emit_const_int(0)
        val n_s = bs.emit_const_int(10)
        ml_surf.builder = bs
        ml_surf.bind_local(9911, n_s)
        val i64_hir = HirType(kind: HirTypeKind.Int(64, true), span: Span.empty())
        val mut_i64_hir = HirType(kind: HirTypeKind.Ref(i64_hir, true), span: Span.empty())
        val arg_x = HirCallArg(has_name: true, name: "x", value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 9911)), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val surf_pack = ml_surf.lower_explicit_call_args_with_writebacks_v1([mir_operand_copy(recv_s)], [arg_x], [i64_hir, mut_i64_hir, i64_hir], 1, surf_sym)
        var bs_end = ml_surf.builder
        val surf_fn = bs_end.end_function()
        ml_surf.builder = bs_end
        expect(ml_surf.errors.len()).to_be_greater_than(0)
        expect(ml_surf.errors[0].message).to_contain("named default requires admitted declaration scope")
        expect(surf_pack.writebacks.len()).to_equal(0)
        expect(count_in_fn(surf_fn, "alloc")).to_equal(0)

        var syms_boot = SymbolTable.new()
        val boot_sym = syms_boot.define("boot.mod.add_nonlit", SymbolKind.Method, None, Span.empty(), Visibility.Public, false, Some("boot.mod"))
        val non_lit_callee = HirExpr(kind: HirExprKind.Var(SymbolId(id: 9925)), has_type_: true, type_: i64_hir, span: Span.empty())
        val non_lit_default = HirExpr(kind: HirExprKind.Call(non_lit_callee, [], []), has_type_: true, type_: i64_hir, span: Span.empty())
        val lit_zero = HirExpr(kind: HirExprKind.IntLit(0, None), has_type_: true, type_: i64_hir, span: Span.empty())
        bootstrap_fn_param_defaults_register("boot.mod.add_nonlit", [
            HirParam(symbol: SymbolId(id: 1), name: "self", type_: i64_hir, has_default: false, default: lit_zero, span: Span.empty(), is_mutable: false),
            HirParam(symbol: SymbolId(id: 2), name: "x", type_: mut_i64_hir, has_default: false, default: lit_zero, span: Span.empty(), is_mutable: true),
            HirParam(symbol: SymbolId(id: 3), name: "delta", type_: i64_hir, has_default: true, default: non_lit_default, span: Span.empty(), is_mutable: false)
        ], "boot.mod")
        var ml_boot = MirLowering.new_for_target(syms_boot, driver_mir_target_context(driver_core_compile_options_default()))
        var bb = ml_boot.builder
        bb.begin_function(SymbolId(id: 9920), "boot_probe", MirSignature(params: [], return_type: MirType.i64(), is_variadic: false), Span.empty())
        val recv_b = bb.emit_const_int(0)
        val n_b = bb.emit_const_int(20)
        ml_boot.builder = bb
        ml_boot.bind_local(9921, n_b)
        val arg_bx = HirCallArg(has_name: true, name: "x", value: HirExpr(kind: HirExprKind.Var(SymbolId(id: 9921)), has_type_: true, type_: i64_hir, span: Span.empty()), span: Span.empty())
        val boot_pack = ml_boot.lower_explicit_call_args_with_writebacks_v1([mir_operand_copy(recv_b)], [arg_bx], [i64_hir, mut_i64_hir, i64_hir], 1, boot_sym)
        var bb_end = ml_boot.builder
        val boot_fn = bb_end.end_function()
        ml_boot.builder = bb_end
        expect(ml_boot.errors.len()).to_be_greater_than(0)
        expect(ml_boot.errors[0].message).to_contain("named default requires admitted declaration scope")
        expect(boot_pack.writebacks.len()).to_equal(0)
        expect(count_in_fn(boot_fn, "alloc")).to_equal(0)

    it "handles named `mut` primitive calls with omitted trailing defaults within same module":
        val mod = lower_src(SAME_MOD_OPT_SRC)
