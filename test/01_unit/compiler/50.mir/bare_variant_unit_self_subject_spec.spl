# @req REQ-SSPEC-COMPILER
"""
# Bare payload-less variant arm over `self` inside the enum's own impl

Bootstrap cycle-51 residue (test_runner_build, B5b family; cycle-52 sibling
symptom: unresolved SdnValue constructor calls): fn
`lib.common.sdn.value.SdnValue.is_null` —

    fn is_null(self) -> bool:
        match self:
            case Null: true
            case _: false

— failed MIR lowering with "B5b: match has multiple wildcard arms (arm 1)".
The source match is well-formed (exactly one wildcard arm); the defect is the
arm arriving at MIR in a default-class pattern carrier because the mono
archive lane handed MIR lowering a module whose enum declarations were
stripped (or whose symbol ids were remapped), leaving the MIR variant registry
without SdnValue, so the Binding -> Enum reclassification
(50.mir/_MirLoweringExpr/expr_dispatch.spl lower_match_case_unchecked) could
not prove `Null` a unit variant. This spec pins the well-formed shape so the
direct HIR->MIR lane must keep lowering it as a genuine two-arm enum match.
"""

# @tag: unit, compiler, mir, hir, enum, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val sdn_value_source = "pub enum SdnValue:\n    Null\n    Bool(bool)\n    Int(i64)\n    Float(f64)\n    String(text)\n    Array([SdnValue])\n    Dict(Dict<text, SdnValue>)\n    Table(headers: [text], rows: [[SdnValue]])\n\n    fn is_null(self) -> bool:\n        match self:\n            case Null:\n                true\n            case _:\n                false\n\n    fn is_number(self) -> bool:\n        match self:\n            case Int(_):\n                true\n            case Float(_):\n                true\n            case _:\n                false\n"

fn lower_sdn_value_provider() -> (text, MirModule):
    val log = Logger(level: 0)
    val provider_ast = parse_full_frontend(sdn_value_source, "lib/sdn_value.spl", "lib.sdn_value", log)
    var modules: Dict<text, Module> = {}
    modules["lib.sdn_value"] = provider_ast
    val sources = [SourceFile(path: "lib/sdn_value.spl", content: sdn_value_source, module_name: "lib.sdn_value")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var provider_lowering = hirlowering_for_module("lib.sdn_value", surfaces)
    val provider_hir = provider_lowering.lower_module(provider_ast)
    var mir_lowering = MirLowering.new(provider_hir.symbols)
    val mir = mir_lowering.lower_module(provider_hir, [provider_hir])
    var out = ""
    for e in provider_lowering.errors:
        out = out + "hir: " + e.message + "\n"
    for e in mir_lowering.errors:
        out = out + "mir: " + e.message + "\n"
    (out, mir)

fn find_fn(mir: MirModule, name: text) -> MirFunction?:
    for function in mir.functions.values():
        if function.name == name or function.name.ends_with("." + name):
            return Some(function)
    nil

fn label_count(function: MirFunction, needle: text) -> i64:
    var n = 0
    for block in function.blocks:
        val label = block.label ?? ""
        if label.contains(needle):
            n = n + 1
    n

describe "bare payload-less variant arm over self inside the enum's own impl (cycle-51/52 B5b pin)":
    it "is_null: case Null / case _ lowers without B5b and keeps two enum arms":
        val (errors, mir) = lower_sdn_value_provider()
        print "errors: [{errors}]"
        expect(errors.contains("B5b")).to_equal(false)
        expect(errors.contains("unresolved")).to_equal(false)
        expect(errors.contains("must bind the same variables")).to_equal(false)
        val f = find_fn(mir, "is_null")
        expect(f == nil).to_equal(false)
        expect(label_count(f.unwrap(), "ematch_arm")).to_equal(2)

    it "is_number: mixed payload arms plus wildcard lowers without B5b":
        val (errors, mir) = lower_sdn_value_provider()
        expect(errors.contains("B5b")).to_equal(false)
        val f = find_fn(mir, "is_number")
        expect(f == nil).to_equal(false)
        expect(label_count(f.unwrap(), "ematch_arm")).to_equal(3)
