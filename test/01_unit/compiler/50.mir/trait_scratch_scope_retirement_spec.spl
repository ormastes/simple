# Native execution is required to qualify the transient ownership boundary.
# Diagnostic serialization below compares surviving instruction graphs only;
# it is not a lossless MIR archive or evidence of an RSS improvement.
use std.spec
use compiler.common.config.Logger
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*

fn trait_scratch_hir(source: text, name: text) -> HirModule:
    val parsed = parse_full_frontend(source, name + ".spl", name, Logger(level: 0))
    var lowering = HirLowering.with_filename(name + ".spl")
    val hir = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    hir

describe "module trait scratch retirement":
    it "preserves emitted trait graphs and borrowed HIR across two scoped modules":
        val source = "trait ScratchReader:\n    me read() -> i64\n\nclass ScratchValue:\n    value: i64\n\nimpl ScratchReader for ScratchValue:\n    me read() -> i64:\n        self.value\n\nfn make() -> ScratchReader:\n    ScratchValue(value: 7)\n\nfn call(reader: ScratchReader) -> i64:\n    reader.read()\n"
        val provider = trait_scratch_hir(source, "trait_scratch_provider")
        val consumer = trait_scratch_hir("fn second() -> i64:\n    2\n", "trait_scratch_consumer")
        val providers: [HirModule] = [provider]
        val trait_count = provider.traits.len()
        val impl_count = provider.impls.len()
        expect(trait_count).to_be_greater_than(0)
        expect(impl_count).to_be_greater_than(0)
        val target = driver_mir_target_context(driver_core_compile_options_default())
        var lowering = MirLowering.new_for_target(provider.symbols, target)
        val first_result = lowering.lower_module_transient_scoped(provider, providers, true)
        expect(first_result.is_ok()).to_equal(true)
        val first = first_result.unwrap()
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.native_trait_layouts.len()).to_equal(0)
        expect(lowering.native_trait_implementations.len()).to_equal(0)
        val first_graph = serialize_mir_module(first)
        expect(first_graph).to_contain("__simple_trait_copy_")
        expect(first_graph).to_contain("__simple_trait_method_")
        expect(first_graph).to_contain("CallIndirect")
        expect(first_graph).to_contain("Aggregate")
        var method_thunks = 0
        for raw_function in first.functions.values():
            val function: MirFunction = raw_function
            if function.name.starts_with("__simple_trait_method_"):
                method_thunks = method_thunks + 1
                expect(function.signature.params.len()).to_equal(1)
                expect(function.signature.params_known).to_equal(true)
                expect(function.blocks.len()).to_be_greater_than(0)
        expect(method_thunks).to_be_greater_than(0)

        # The next consumer rebuilds its lookup tables from the same borrowed
        # provider. Its scope must not invalidate the first module or input.
        val second_result = lowering.lower_module_transient_scoped(consumer, providers, false)
        expect(second_result.is_ok()).to_equal(true)
        val second = second_result.unwrap()
        expect(second.functions.len()).to_be_greater_than(0)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.native_trait_layouts.len()).to_equal(0)
        expect(lowering.native_trait_implementations.len()).to_equal(0)
        expect(serialize_mir_module(first)).to_equal(first_graph)
        expect(provider.traits.len()).to_equal(trait_count)
        expect(providers[0].traits.len()).to_equal(trait_count)
        expect(provider.impls.len()).to_equal(impl_count)
        expect(providers[0].impls.len()).to_equal(impl_count)
