# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: for-in over an Optional-array variant payload binder

`case StringLit(_, interps)` with `interps: [T]?` iterated under a nil guard
bound I64 and failed "for-in over non-array iterables (#143)". The for-in
lowering now peels Optional(Array|Slice) and iterates the payload array.
"""

# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn opt_payload_messages(src: text) -> [text]:
    val file = "testdata/fixture_opt_payload.spl"
    val parsed = parse_full_frontend(src, file, "fixture_opt_payload", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    lowering.lower_module(hir)
    var messages: [text] = []
    for e in lowering.errors:
        messages = messages.push(e.message)
    messages

val src = "enum Lit:\n" +
    "    Str(text, [i64]?)\n" +
    "    Other\n" +
    "\n" +
    "fn total(l: Lit) -> i64:\n" +
    "    var s = 0\n" +
    "    match l:\n" +
    "        case Lit.Str(_, xs):\n" +
    "            if xs != nil:\n" +
    "                for x in xs:\n" +
    "                    s = s + x\n" +
    "        case _: ()\n" +
    "    s\n"

describe "MIR lowering: Optional array payload binder in for-in":
    it "iterates a nil-guarded [T]? variant payload":
        var bad = 0
        for m in opt_payload_messages(src):
            if m.contains("for-in over non-array"):
                bad = bad + 1
        expect(bad).to_equal(0)
