# @req REQ-SSPEC-COMPILER
"""
# Stage2: method calls on receivers typed with an imported generic class

`fn f(b: Box<i64>): b.get()` -- and a method an extension module adds with
`impl Box<T>:` -- had no callable target on the native path: the parser
collapsed an imported `Box<i64>` to `Any`, HIR flags every method of a generic
impl `is_generic_template`, MIR never emits a template, and 40.mono kept
instance calls untouched.

The parser now keeps `Name<args>` for a name the file imports by an explicit
`use` item, HIR retains each resolved declaration's arguments, and 40.mono
registers each instance method of a generic inherent impl as a function
template over the impl's type parameters (receiver first). A call whose
receiver is declared as a concrete instantiation -- matched by the class's
ownership identity -- is rewritten into a direct call of the specialization.
A method mono cannot bind positionally is reported as E-MONO-034 (a warning
by default, an error under `SIMPLE_MONO_LEVELS=E-MONO-034=error`; formerly a
build error) rather than left to bind the never-emitted template.

Each example runs HIR -> mono -> MIR in-process on a small fixture.

| Receiver / method | Outcome |
|-------------------|---------|
| parameter `b: Box<i64>`, the class's own `get` | calls `Box__get$i64` |
| parameter `b: Box<i64>`, `ext_peek` from an `impl Box<T>:` extension module | calls `Box__ext_peek$i64` |
| field `h.b` with `b: Box<i64>` | calls `Box__get$i64` |
| `if val b = ob` with `ob: Box<i64>?` | calls `Box__get$i64` |
| `b.conv(7)`, a method with its own type parameter | E-MONO-034 |
| `b.inner()` declared by `impl<T> Box<Option<T>>` | E-MONO-034 |
| `p.swapped()` declared by `impl<A, B> Pair<B, A>` | E-MONO-034 |
| parameters typed with an imported generic enum / trait | retain named arguments |
"""

# @tag: unit, compiler, mir, mono, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules, ModuleSurfacesByName}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mono.monomorphize_integration.{run_monomorphization_with_report}
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val dep_source = "pub class Box<T>:\n    v: T\n\nimpl Box<T>:\n    fn get() -> T:\n        self.v\n    fn conv<U>(x: U) -> U:\n        x\n\nimpl<T> Box<Option<T>>:\n    fn inner() -> i64:\n        1\n\npub class Pair<A, B>:\n    a: A\n    b: B\n\nimpl<A, B> Pair<B, A>:\n    fn swapped() -> i64:\n        2\n\npub enum Opt2<T>:\n    Has(T)\n    Empty\n\npub trait Shape<T>:\n    fn area() -> T\n"

val ext_source = "use lib.dep.\{Box\}\n\nimpl Box<T>:\n    fn ext_peek() -> bool:\n        true\n"

var _last_mir: MirModule? = nil
var _last_hir: HirModule? = nil
var _last_hir_errors: [text] = []

# Providers are parsed, surfaced and HIR-lowered once and shared (surface
# construction dominates under the spec runner's interpreter); each example
# re-runs mono over the shared providers plus its own consumer.
var _providers_ready = false
var _surfaces: ModuleSurfacesByName? = nil
var _dep_hir: HirModule? = nil
var _ext_hir: HirModule? = nil

fn ensure_providers():
    if _providers_ready:
        return
    val log = Logger(level: 0)
    val dep_ast = parse_full_frontend(dep_source, "lib/dep.spl", "lib.dep", log)
    val ext_ast = parse_full_frontend(ext_source, "lib/ext.spl", "lib.ext", log)
    var modules: Dict<text, Module> = {}
    modules["lib.dep"] = dep_ast
    modules["lib.ext"] = ext_ast
    val sources = [SourceFile(path: "lib/dep.spl", content: dep_source, module_name: "lib.dep"), SourceFile(path: "lib/ext.spl", content: ext_source, module_name: "lib.ext")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    _surfaces = Some(surfaces)
    var dep_lowering = hirlowering_for_module("lib.dep", surfaces)
    var ext_lowering = hirlowering_for_module("lib.ext", surfaces)
    _dep_hir = Some(dep_lowering.lower_module(dep_ast))
    _ext_hir = Some(ext_lowering.lower_module(ext_ast))
    _providers_ready = true

fn lower_consumer(consumer_source: text) -> text:
    ensure_providers()
    val consumer_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", Logger(level: 0))
    var consumer_lowering = hirlowering_for_module("app.main", _surfaces.unwrap())
    val consumer_before: HirModule = consumer_lowering.lower_module(consumer_ast)
    _last_hir = Some(consumer_before)
    var hir_errors: [text] = []
    for he in consumer_lowering.errors:
        hir_errors = hir_errors.push(he.message)
    _last_hir_errors = hir_errors
    var hir_modules: Dict<text, HirModule> = {}
    hir_modules["lib.dep"] = _dep_hir.unwrap()
    hir_modules["lib.ext"] = _ext_hir.unwrap()
    hir_modules["app.main"] = consumer_before
    val (mono, _stats, diags, warnings) = run_monomorphization_with_report(hir_modules)
    val dep_hir: HirModule = mono["lib.dep"]
    val ext_hir: HirModule = mono["lib.ext"]
    val consumer_hir: HirModule = mono["app.main"]
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    var prescan_mods: Dict<text, HirModule> = {}
    prescan_mods["dep_hir"] = dep_hir
    prescan_mods["ext_hir"] = ext_hir
    prescan_mods["consumer_hir"] = consumer_hir
    for prescan_key in prescan_mods.keys():
        mir_lowering.prescan_module_struct_names(prescan_mods, prescan_key)
    _last_mir = Some(mir_lowering.lower_module(consumer_hir, [dep_hir, ext_hir, consumer_hir]))
    var out = ""
    for d in diags:
        out = out + "error: " + d + "\n"
    # E-MONO-034 is leveled (SIMPLE_MONO_LEVELS), `warning` by default: a
    # module with such a call compiled before the check existed.
    for w in warnings:
        out = out + "warning: " + w + "\n"
    for e in mir_lowering.errors:
        out = out + e.message + "\n"
    out

fn callees_of(function_name: text) -> [text]:
    var out: [text] = []
    if val mir = _last_mir:
        for function in mir.functions.values():
            if function.name == function_name or function.name.ends_with(".{function_name}"):
                for block in function.blocks:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.Call(_, operand, _):
                                match operand.kind:
                                    case MirOperandKind.Const(MirConstValue.Str(name), _):
                                        out.push(name)
                                    case _: ()
                            case _: ()
    out

fn calls_specialization(prefix: text) -> bool:
    for callee in callees_of("f"):
        if callee.contains(prefix + "$"):
            return true
    false

fn param_kind_name(index: i64) -> text:
    """`any`, `named<argc>` or `other` for parameter `index` of consumer `f`."""
    if val hir = _last_hir:
        for raw_fn in hir.functions.values():
            val function: HirFunction = raw_fn
            if function.name == "f" and index < function.params.len():
                val param: HirParam = function.params[index]
                match param.type_.kind:
                    case HirTypeKind.Any: return "any"
                    case HirTypeKind.Named(_, args): return "named{args.len()}"
                    case _: return "other"
    "missing"

describe "imported generic class receivers bind to the specialization":
    it "the class's own method on a Box<i64> parameter":
        val errs = lower_consumer("use lib.dep.\{Box\}\n\nfn f(b: Box<i64>) -> i64:\n    b.get()\n")
        print "param_own: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("unresolved method call")).to_equal(false)
        expect(calls_specialization("Box__get")).to_equal(true)

    it "an extension-module method on a Box<i64> parameter":
        val errs = lower_consumer("use lib.dep.\{Box\}\nuse lib.ext\n\nfn f(b: Box<i64>) -> bool:\n    b.ext_peek()\n")
        print "param_ext: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("unresolved method call")).to_equal(false)
        expect(calls_specialization("Box__ext_peek")).to_equal(true)

    it "the class's own method on a Box<i64> field":
        val errs = lower_consumer("use lib.dep.\{Box\}\n\nstruct H:\n    b: Box<i64>\n\nfn f(h: H) -> i64:\n    h.b.get()\n")
        print "field_own: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("unresolved method call")).to_equal(false)
        expect(calls_specialization("Box__get")).to_equal(true)

    it "the payload of an `if val` over a Box<i64>? parameter":
        val errs = lower_consumer("use lib.dep.\{Box\}\n\nfn f(ob: Box<i64>?) -> i64:\n    if val b = ob:\n        return b.get()\n    0\n")
        print "ifval_opt: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("unresolved method call")).to_equal(false)
        expect(calls_specialization("Box__get")).to_equal(true)

describe "methods mono cannot bind positionally fail closed":
    it "reports a method with its own type parameter instead of binding the template":
        val errs = lower_consumer("use lib.dep.\{Box\}\n\nfn f(b: Box<i64>) -> i64:\n    b.conv(7)\n")
        print "own_tparam: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("warning: E-MONO-034")).to_equal(true)
        expect(errs.contains("error: E-MONO")).to_equal(false)
        expect(errs.contains("type parameters of its own")).to_equal(true)

    it "reports a method of an impl whose target nests its parameter":
        val errs = lower_consumer("use lib.dep.\{Box\}\n\nfn f(b: Box<i64>) -> i64:\n    b.inner()\n")
        print "nested_target: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("warning: E-MONO-034")).to_equal(true)
        expect(errs.contains("error: E-MONO")).to_equal(false)
        expect(errs.contains("impl target")).to_equal(true)

    it "reports a method of an impl whose target reorders its parameters":
        val errs = lower_consumer("use lib.dep.\{Pair\}\n\nfn f(p: Pair<i64, text>) -> i64:\n    p.swapped()\n")
        print "swapped_target: [{errs}] callees={callees_of(\"f\")}"
        expect(errs.contains("warning: E-MONO-034")).to_equal(true)
        expect(errs.contains("error: E-MONO")).to_equal(false)
        expect(errs.contains("impl target")).to_equal(true)

describe "imported declarations retain their generic arguments":
    it "keeps an imported generic enum, trait, and class as Named":
        val errs = lower_consumer("use lib.dep.\{Box, Opt2, Shape\}\n\nfn f(b: Box<i64>, o: Opt2<i64>, s: Shape<i64>) -> i64:\n    1\n")
        print "kinds: [{errs}] {param_kind_name(0)} {param_kind_name(1)} {param_kind_name(2)}"
        expect(param_kind_name(0)).to_equal("named1")
        expect(param_kind_name(1)).to_equal("named1")
        expect(param_kind_name(2)).to_equal("named1")
        expect(_last_hir_errors.len()).to_equal(0)

describe "invalid imported instance arguments remain diagnostics":
    it "reports a class argument that is not in scope":
        val errs = lower_consumer("use lib.dep.\{Box\}\n\nfn f(b: Box<NotInScope>) -> i64:\n    0\n")
        for e in _last_hir_errors:
            print "hir: {e}"
        expect(_last_hir_errors.len()).to_be_greater_than(0)
        expect(_last_hir_errors.join("\n")).to_contain("NotInScope")
        expect(param_kind_name(0)).to_equal("named1")

    it "reports an imported enum argument instead of erasing the whole instance":
        val _errs = lower_consumer("use lib.dep.\{Opt2\}\n\nfn f(o: Opt2<MissingPayload>) -> i64:\n    0\n")
        expect(_last_hir_errors.join("\n")).to_contain("MissingPayload")
        expect(param_kind_name(0)).to_equal("named1")

    it "reports an imported trait argument instead of erasing the whole instance":
        val _errs = lower_consumer("use lib.dep.\{Shape\}\n\nfn f(s: Shape<MissingOutput>) -> i64:\n    0\n")
        expect(_last_hir_errors.join("\n")).to_contain("MissingOutput")
        expect(param_kind_name(0)).to_equal("named1")

    it "still reports the same name as a plain annotation":
        val _errs = lower_consumer("use lib.dep.\{Box\}\n\nfn f(b: NotInScope) -> i64:\n    0\n")
        var reported = false
        for e in _last_hir_errors:
            val et: text = e
            if et.contains("unresolved type: NotInScope"):
                reported = true
        expect(reported).to_equal(true)
