# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: `for` iteration shapes stage2 does not lower yet (BUG-IT-9)

Measured 2026-10-10 on release/1.0 @ b68c0c65708: each shape below fails MIR
lowering with a clean diagnostic — `unresolved method call: step`,
`unresolved method call: enumerate`, `E-MIR-EXPR-Comprehension: MIR lowering
does not support this comprehension expression`, `unresolved method call:
reversed`. The examples assert the CORRECT behaviour (zero diagnostics) and
are expected to fail until each shape is wired; when one is, move its example
back to `for_in_variant_lowering_spec.spl`. Same harness and advisory
exclusion as that spec.
"""

# @tag:in-development
# Tracks: BUG-IT-9, doc/08_tracking/bug/stage2_mir_for_in_unsupported_shapes_2026-10-10.md

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

struct ForLowered:
    mir: MirModule
    messages: [text]

fn for_lower(src: text) -> ForLowered:
    val file = "testdata/fixture_for_in_unsupported.spl"
    val parsed = parse_full_frontend(src, file, "fixture_for_in_unsupported", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    ForLowered(mir: mir, messages: messages)

fn for_blocks(mir: MirModule, name: text) -> i64:
    for function in mir.functions.values():
        if function.name == name or function.name.ends_with("." + name):
            return function.blocks.len()
    -1

fn for_expect_clean(src: text, fn_name: text) -> ForLowered:
    val low = for_lower(src)
    var all = ""
    for m in low.messages:
        all = all + m + "\n"
    print "diagnostics: [{all}]"
    expect(low.messages.len()).to_equal(0)
    expect(for_blocks(low.mir, fn_name) > 1).to_equal(true)
    low

val stepped_src = "fn evens(n: i64) -> i64:\n" +
    "    var c = 0\n" +
    "    for i in (0..n).step(2):\n" +
    "        c = c + 1\n" +
    "    for j in (n..0).step(-1):\n" +
    "        c = c + j\n" +
    "    c\n"

val enumerate_src = "fn index_sum(xs: [text]) -> i64:\n" +
    "    var s = 0\n" +
    "    for (i, x) in xs.enumerate():\n" +
    "        s = s + i * x.len()\n" +
    "    s\n"

val comprehension_src = "fn squares(xs: [i64]) -> i64:\n" +
    "    val sq = [x * x for x in xs if x > 0]\n" +
    "    var s = 0\n" +
    "    for v in sq:\n" +
    "        s = s + v\n" +
    "    s\n"

val reversed_src = "fn make(n: i64) -> [i64]:\n" +
    "    var out: [i64] = []\n" +
    "    for i in 0..n:\n" +
    "        out.push(i)\n" +
    "    out\n" +
    "\n" +
    "fn consume(n: i64) -> i64:\n" +
    "    var s = 0\n" +
    "    for w in make(n).reversed():\n" +
    "        s = s + w\n" +
    "    s\n"

describe "MIR lowering: for-in shapes not lowered yet (BUG-IT-9)":
    it "BUG-IT-9: (a..b).step(n) ascending and descending ranges":
        for_expect_clean(stepped_src, "evens")

    it "BUG-IT-9: enumerate() with tuple destructuring":
        for_expect_clean(enumerate_src, "index_sum")

    it "BUG-IT-9: filtered list comprehension feeding a for loop":
        for_expect_clean(comprehension_src, "squares")

    it "BUG-IT-9: iteration over a reversed() view of a call result":
        for_expect_clean(reversed_src, "consume")
