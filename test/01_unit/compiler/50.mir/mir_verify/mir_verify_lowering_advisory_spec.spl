# @req REQ-SSPEC-COMPILER
"""
# MIR lowering advisories never enter `MirLowering.errors`

`E-MIR-TYPE-Error` (a `HirTypeKind.Error` type erased to i64 in `lower_type`)
and `E-MIR-MATCH-GUARD` (guard-count invariant in enum-match lowering) are
ADVISORIES. At their default level they are recorded in
`MirLowering.mir_advisories`, never in `MirLowering.errors`, because:

  * four routes abort on `lowering.errors.len() > 0` in default config
    (`_MirLowering/bootstrap_type_registration.spl`, `70.backend/backend/
    compiler.spl`, `jit_interpreter.spl`, `app/simpleos_tool/
    focused_pipeline.spl`);
  * array/dict literal lowering compares `errors.len()` around each element
    and replaces the whole literal with `const 0` when it grew.

Pinned here on real lowered source:

  * the reviewer's failing input (struct field of an unresolved imported
    type): `errors` is empty, one advisory is recorded;
  * array and dict literals whose elements have an unresolved type lower to
    exactly the MIR they lower to with the advisory switched `off`
    (= release behaviour), and to DIFFERENT MIR only when the advisory is
    explicitly promoted to `error` (non-vacuity: that is the regression);
  * the driver reports advisories as capped warnings, never errors.
"""

# @tag: unit, compiler, mir, verify

use std.spec
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use compiler.common.config.Logger
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_verify_levels.{mir_verify_warning_cap}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.driver.driver_pipeline_lowering.{driver_collect_mir_advisories}

fn count_const_zero(mir: MirModule) -> i64:
    var n = 0
    for f in mir.functions.values():
        for b in f.blocks:
            for i in b.instructions:
                match i.kind:
                    case MirInstKind.Const(_, value, _):
                        match value:
                            case MirConstValue.Int(v):
                                if v == 0:
                                    n = n + 1
                            case _: ()
                    case _: ()
    n

fn lower_with(src: text, levels: text) -> (i64, i64, i64, i64, text):
    """Returns (errors, advisories, instructions, const-0 instructions,
    first advisory-or-error message) for `src` lowered under `levels`."""
    val saved = env_get("SIMPLE_MIR_VERIFY_LEVELS")
    val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", levels)
    val parsed = parse_full_frontend(src, "testdata/mv_advisory.spl", "mv_advisory", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/mv_advisory.spl")
    val hir = hir_lowering.lower_module(parsed)
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    val _b = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved)
    var insts = 0
    for f in mir.functions.values():
        for b in f.blocks:
            insts = insts + b.instructions.len()
    var first = ""
    if lowering.mir_advisories.len() > 0:
        first = lowering.mir_advisories[0].message
    elif lowering.errors.len() > 0:
        first = lowering.errors[0].message
    (lowering.errors.len(), lowering.mir_advisories.len(), insts, count_const_zero(mir), first)

# The reviewer's failing input (review_mir_verify/probe_type_error_spec.spl).
val STRUCT_SRC: text = "use nowhere.missing.Missing\n\nstruct S:\n    a: i64\n    f: Missing\n\nfn g(s: S) -> i64:\n    s.a\n"

val ARRAY_SRC: text = "use nowhere.missing.Missing\n\nfn g(a: i64) -> i64:\n    val xs = [a as Missing, a as Missing]\n    xs.len()\n"

val DICT_SRC: text = "use nowhere.missing.Missing\n\nfn g(a: i64) -> i64:\n    val d = {\"k\": a as Missing}\n    d.len()\n"

describe "MIR lowering advisories: E-MIR-TYPE-Error stays out of lowering.errors":
    it "struct field of an unresolved imported type: errors is empty, the advisory is recorded":
        val (errors, advisories, _insts, _zeros, first) = lower_with(STRUCT_SRC, "")
        expect(errors).to_equal(0)
        expect(advisories).to_equal(1)
        expect(first.starts_with("E-MIR-TYPE-Error: unresolved HIR type")).to_equal(true)

    it "level off records nothing and leaves errors empty (the release behaviour)":
        val (errors, advisories, _insts, _zeros, _first) = lower_with(STRUCT_SRC, "E-MIR-TYPE-Error=off")
        expect(errors).to_equal(0)
        expect(advisories).to_equal(0)
        val (errors2, advisories2, _i2, _z2, _f2) = lower_with(STRUCT_SRC, "*=off")
        expect(errors2 + advisories2).to_equal(0)

    it "only an explicit `error` level makes it a real lowering error":
        val (errors, advisories, _insts, _zeros, first) = lower_with(STRUCT_SRC, "E-MIR-TYPE-Error=error")
        expect(errors).to_equal(1)
        expect(advisories).to_equal(0)
        expect(first.starts_with("E-MIR-TYPE-Error:")).to_equal(true)

    it "a rejected (mistyped) level spec leaves the advisory at its default, not at error or off":
        val (errors, advisories, _insts, _zeros, _first) = lower_with(STRUCT_SRC, "E-MIR-TYPE-Error=eror,*=off")
        expect(errors).to_equal(0)
        expect(advisories).to_equal(1)

describe "MIR lowering advisories: array/dict literal lowering is unchanged":
    it "array literal with unresolved-type elements lowers exactly as with the advisory off":
        val (errors, advisories, insts, zeros, _first) = lower_with(ARRAY_SRC, "")
        val (off_errors, off_advisories, off_insts, off_zeros, _f2) = lower_with(ARRAY_SRC, "E-MIR-TYPE-Error=off")
        expect(errors).to_equal(0)
        expect(off_errors).to_equal(0)
        expect(off_advisories).to_equal(0)
        expect(advisories > 0).to_equal(true)
        expect(insts).to_equal(off_insts)
        expect(zeros).to_equal(off_zeros)
        # Non-vacuity: with the diagnostic in `errors`, the `errors_before`
        # check replaces the literal by `const 0` and the MIR shrinks.
        val (err_errors, _a3, err_insts, _z3, _f3) = lower_with(ARRAY_SRC, "E-MIR-TYPE-Error=error")
        expect(err_errors > 0).to_equal(true)
        expect(err_insts < insts).to_equal(true)

    it "dict literal with an unresolved-type value lowers exactly as with the advisory off":
        val (errors, advisories, insts, zeros, _first) = lower_with(DICT_SRC, "")
        val (off_errors, _oa, off_insts, off_zeros, _f2) = lower_with(DICT_SRC, "E-MIR-TYPE-Error=off")
        expect(errors).to_equal(0)
        expect(off_errors).to_equal(0)
        expect(advisories > 0).to_equal(true)
        expect(insts).to_equal(off_insts)
        expect(zeros).to_equal(off_zeros)
        val (err_errors, _a3, err_insts, _z3, _f3) = lower_with(DICT_SRC, "E-MIR-TYPE-Error=error")
        expect(err_errors > 0).to_equal(true)
        expect(err_insts < insts).to_equal(true)

describe "MIR lowering advisories: driver reporting":
    it "advisories become capped driver warnings (first N per code plus one count line), never errors":
        val cap = mir_verify_warning_cap()
        var advisories: [MirError] = []
        var i = 0
        while i < cap + 7:
            advisories = advisories.push(MirError(message: "E-MIR-TYPE-Error: fixture {i}", span: nil, fatal: false))
            i = i + 1
        advisories = advisories.push(MirError(message: "E-MIR-MATCH-GUARD: fixture", span: nil, fatal: false))
        var driver = CompilerDriver.create(driver_core_compile_options_default())
        val errors_before = driver.ctx.error_count()
        val warnings_before = driver.ctx.warnings.len()
        driver_collect_mir_advisories(driver.ctx, advisories)
        expect(driver.ctx.error_count() - errors_before).to_equal(0)
        # cap lines + 1 count line for E-MIR-TYPE-Error, 1 line for E-MIR-MATCH-GUARD
        expect(driver.ctx.warnings.len() - warnings_before).to_equal(cap + 2)

fn guard_route(levels: text) -> text:
    """Drive `MirLowering.advisory` directly: the guard-count invariant
    cannot be violated from source (that is the point of the invariant)."""
    val saved = env_get("SIMPLE_MIR_VERIFY_LEVELS")
    val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", levels)
    val parsed = parse_full_frontend("fn z() -> i64:\n    0\n", "testdata/mv_guard.spl", "mv_guard", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/mv_guard.spl")
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    lowering.advisory("E-MIR-MATCH-GUARD", "enum match dispatches 2 guarded arm(s) but lowered 1 guard branch(es); a guard was dropped", nil)
    val _b = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved)
    var fatal = 0
    for e in lowering.errors:
        if e.fatal:
            fatal = fatal + 1
    "errors={lowering.errors.len()} fatal={fatal} advisories={lowering.mir_advisories.len()}"

describe "MIR lowering advisories: E-MIR-MATCH-GUARD routing":
    it "advisory by default, nothing when off, a fatal lowering error only when promoted to error":
        expect(guard_route("")).to_equal("errors=0 fatal=0 advisories=1")
        expect(guard_route("E-MIR-MATCH-GUARD=off")).to_equal("errors=0 fatal=0 advisories=0")
        expect(guard_route("E-MIR-MATCH-GUARD=error")).to_equal("errors=1 fatal=1 advisories=0")
        expect(guard_route("E-MIR-TYPE-Error=error")).to_equal("errors=0 fatal=0 advisories=1")

val MANY_SRC: text = "use nowhere.missing.Missing\n\nfn g(a: Missing, b: Missing, c: Missing, d: Missing, e: Missing, f: Missing) -> i64:\n    0\n"

fn hir_of(src: text, file: text, name: text) -> HirModule:
    val parsed = parse_full_frontend(src, file, name, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    hir_lowering.lower_module(parsed)

fn two_modules_same_fn_name() -> (i64, i64):
    """One lowering, two modules that both define `g` with unresolved types.
    Returns (advisories from the first module, advisories from the second)."""
    val saved = env_get("SIMPLE_MIR_VERIFY_LEVELS")
    val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", "")
    val first = hir_of(MANY_SRC, "testdata/mv_first.spl", "mv_first")
    val second = hir_of(MANY_SRC, "testdata/mv_second.spl", "mv_second")
    var lowering = MirLowering.new_for_target(first.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val _m1 = lowering.lower_module(first)
    val n1 = lowering.mir_advisories.len()
    val _m2 = lowering.lower_module(second)
    val n2 = lowering.mir_advisories.len() - n1
    val _b = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved)
    (n1, n2)

fn promoted_type_errors() -> (i64, i64, i64):
    """MANY_SRC under E-MIR-TYPE-Error=error.
    Returns (errors, errors that are not fatal, errors mentioning 'suppressed')."""
    val saved = env_get("SIMPLE_MIR_VERIFY_LEVELS")
    val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", "E-MIR-TYPE-Error=error")
    val hir = hir_of(MANY_SRC, "testdata/mv_many.spl", "mv_many")
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val _m = lowering.lower_module(hir)
    val _b = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved)
    var non_fatal = 0
    var summaries = 0
    for e in lowering.errors:
        if not e.fatal:
            non_fatal = non_fatal + 1
        if e.message.contains("suppressed"):
            summaries = summaries + 1
    (lowering.errors.len(), non_fatal, summaries)

describe "MIR lowering advisories: E-MIR-TYPE-Error rate limit":
    it "default level: at most 3 reports per function plus one summary line":
        val (errors, advisories, _insts, _zeros, _first) = lower_with(MANY_SRC, "")
        expect(errors).to_equal(0)
        expect(advisories).to_equal(4)

    it "the limit is per module + function: a same-named function in a later module is still reported":
        val (n1, n2) = two_modules_same_fn_name()
        expect(n1).to_equal(4)
        expect(n2).to_equal(4)

    it "promoted to error: every occurrence is flagged, nothing is rate-limited, and no summary line becomes an error":
        val (errors, non_fatal, summaries) = promoted_type_errors()
        expect(errors >= 6).to_equal(true)
        expect(non_fatal).to_equal(0)
        expect(summaries).to_equal(0)
