# @req REQ-SSPEC-COMPILER
"""
# Mandatory MIR verification — source snippets that used to produce invalid MIR

Runs real lowering (parse -> HIR -> MIR) on small sources and verifies the
result with `mir_verify_module`:

  * `buf.push(s[i] as u8)` — the exact `bytes_util.spl:16` shape that crashed
    the LLVM backend ("unsupported LLVM value conversion from ptr to i8").
    Since the text-cast fix (#2875) lowering emits a ConvertCall for it, so
    the verifier must find ZERO MIRV-002 here: this example is now the
    regression pin for that fix (a raw text -> u8 Cast coming back is caught).
  * `p as u8` with `p` a struct — a source shape that still lowers to a raw
    aggregate -> narrow-scalar Cast, kept as the source-level must-fail for
    MIRV-002 (the MIR-level must-fail lives in mir_verify_types_casts_spec).
  * a plain arithmetic / branching function verifies clean (no false positive).
  * an enum match with guards: the 3a lowering self-check
    (E-MIR-MATCH-GUARD) stays silent when every guard is lowered, and the
    verifier reports no fatal finding on the resulting CFG.
"""

# @tag: unit, compiler, mir, verify

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_verify.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn lower_src(src: text) -> (MirModule, [text]):
    val parsed = parse_full_frontend(src, "testdata/mv_source.spl", "mv_source", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/mv_source.spl")
    val hir = hir_lowering.lower_module(parsed)
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in lowering.errors:
        messages = messages.push(e.message)
    (mir, messages)

fn findings_for(report: MirVerifyReport, rule: text) -> [MirVerifyFinding]:
    var out: [MirVerifyFinding] = []
    for f in report.findings:
        if f.rule == rule:
            out = out.push(f)
    out

fn any_message_contains(messages: [text], needle: text) -> bool:
    for m in messages:
        if m.contains(needle):
            return true
    false

val TEXT_INDEX_CAST_SRC: text = "fn to_bytes(s: text) -> [u8]:\n    var buf: [u8] = []\n    var i = 0\n    while i < s.len():\n        buf = buf.push(s[i] as u8)\n        i = i + 1\n    buf\n"

val CLEAN_SRC: text = "fn pick(d: i64, c: bool) -> i64:\n    if d > 3 and c:\n        d * 2\n    else:\n        d + 1\n\nfn sum_to(n: i64) -> i64:\n    var acc = 0\n    var i = 0\n    while i < n:\n        acc = acc + i\n        i = i + 1\n    acc\n"

val GUARD_SRC: text = "enum D:\n    A\n    B\n    C\n\nfn pick(d: D, c: bool) -> i64:\n    match d:\n        case D.A if c:\n            1\n        case D.A | D.B if not c:\n            2\n        case _ if c:\n            3\n        case _:\n            4\n"

val STRUCT_NARROW_CAST_SRC: text = "struct P:\n    x: i64\n    y: i64\n\nfn squash(p: P) -> u8:\n    p as u8\n"

describe "MIR verify on lowered source: the ptr->i8 cast class (bug A)":
    it "`s[i] as u8` lowers through a conversion call: zero MIRV-002 (regression pin for the text-cast fix)":
        val (mir, messages) = lower_src(TEXT_INDEX_CAST_SRC)
        val report = mir_verify_module(mir)
        expect(findings_for(report, "MIRV-002").len()).to_equal(0)
        expect(report.fatal_count()).to_equal(0)

    it "reports an aggregate cast to a narrow scalar (`p as u8`) as warn-first (non-fatal) MIRV-002 naming squash":
        val (mir, messages) = lower_src(STRUCT_NARROW_CAST_SRC)
        val report = mir_verify_module(mir)
        val hits = findings_for(report, "MIRV-002")
        expect(hits.len()).to_equal(1)
        expect(hits[0].function.ends_with("squash")).to_equal(true)
        expect(hits[0].message.contains("aggregate")).to_equal(true)
        expect(hits[0].message.contains("-> u8")).to_equal(true)
        # Warn-first landing: reported, not fatal, until promoted in the registry.
        expect(hits[0].is_fatal()).to_equal(false)
        expect(report.fatal_count()).to_equal(0)

describe "MIR verify on lowered source: no false positives on plain code":
    it "a branching arithmetic module verifies with zero fatal findings":
        val (mir, messages) = lower_src(CLEAN_SRC)
        val report = mir_verify_module(mir)
        expect(report.functions_checked).to_equal(2)
        expect(report.fatal_count()).to_equal(0)

val GUARD_THEN_PLAIN_SRC: text = "enum D:\n    A\n    B\n\nfn pick(d: D, c: bool) -> i64:\n    match d:\n        case D.A if c:\n            1\n        case D.A:\n            2\n        case D.B:\n            3\n"

fn guard_branch_count(mir: MirModule) -> i64:
    var n = 0
    for f in mir.functions.values():
        for b in f.blocks:
            match b.terminator:
                case MirTerminator.If(_, then_, _):
                    for tb in f.blocks:
                        if tb.id.id == then_.id and (tb.label ?? "").contains("guard_pass"):
                            n = n + 1
                case _: ()
    n

describe "MIR verify on lowered source: enum-match guards (3a)":
    it "every guard is lowered: no E-MIR-MATCH-GUARD, no fatal verifier finding, no dropped-condition warning":
        val (mir, messages) = lower_src(GUARD_SRC)
        expect(any_message_contains(messages, "E-MIR-MATCH-GUARD")).to_equal(false)
        val report = mir_verify_module(mir)
        expect(report.fatal_count()).to_equal(0)
        expect(findings_for(report, "MIRV-005c").len()).to_equal(0)

    it "`case A if c:` followed by plain `case A:` lowers exactly one guard branch and the counter agrees":
        val (mir, messages) = lower_src(GUARD_THEN_PLAIN_SRC)
        expect(any_message_contains(messages, "E-MIR-MATCH-GUARD")).to_equal(false)
        expect(guard_branch_count(mir)).to_equal(1)
        val report = mir_verify_module(mir)
        expect(findings_for(report, "MIRV-005c").len()).to_equal(0)
