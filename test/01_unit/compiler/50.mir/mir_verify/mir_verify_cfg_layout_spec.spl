# @req REQ-SSPEC-COMPILER
"""
# Mandatory MIR verification — rule groups 5 (CFG / locals / variants) and 6 (layout)

Hand-built MIR asserting the exact rule id and fatality:

  * MIRV-005  branch to a block that does not exist, duplicate block ids,
             missing entry block, duplicate Switch case values.
  * MIRV-005b a local that is read but never declared / never defined.
  * MIRV-005c a comparison result computed and never consumed — the MIR
             shape of "match guards silently ignored" (warn-first).
  * MIRV-005d an enum construction / switch arm naming a variant the enum
             does not have.
  * MIRV-006  GetField/SetField index outside the struct or tuple layout
             (the "silently reads field 0" class).
  * MIRV-006b field projection whose struct layout owner is not in the
             module (warn-first: cross-module layouts).
"""

# @tag: unit, compiler, mir, verify

use std.spec
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.*

fn span_at(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "fixture/mv_cfg.spl", length: 0)

fn ty(kind: MirTypeKind) -> MirType:
    MirType(kind: kind)

fn i64_t() -> MirType:
    ty(MirTypeKind.I64)

fn bool_t() -> MirType:
    ty(MirTypeKind.Bool)

fn copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))

fn const_i64(v: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(v), i64_t()))

fn arg(id: i64, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some("a{id}"), type_: t, kind: LocalKind.Arg(id), is_ghost: false)

fn tmp(id: i64, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: t, kind: LocalKind.Temp, is_ghost: false)

fn inst(kind: MirInstKind, line: i64) -> MirInst:
    MirInst(kind: kind, span: Some(span_at(line)))

fn block(id: i64, instructions: [MirInst], term: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId(id: id), label: Some("b{id}"), instructions: instructions, terminator: term)

fn mk_fn(sym: i64, name: text, params: [MirType], ret: MirType, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: sym), name: name,
        signature: MirSignature(params: params, return_type: ret, is_variadic: false, params_known: true),
        locals: locals, blocks: blocks,
        entry_block: BlockId(id: 0), span: span_at(1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

val PAIR_SYM: i64 = 700
val COLOR_SYM: i64 = 701

fn pair_struct() -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: PAIR_SYM), name: "Pair",
        kind: MirTypeDefKind.Struct([
            MirFieldDef(name: "x", type_: i64_t(), offset: 0, has_bits_attr: false, bits_width: 0),
            MirFieldDef(name: "y", type_: i64_t(), offset: 8, has_bits_attr: false, bits_width: 0)
        ]), is_export_c: false, export_name: "")

fn color_enum() -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: COLOR_SYM), name: "Color",
        kind: MirTypeDefKind.Enum([
            MirVariantDef(name: "Red", discriminant: 0, payload: nil),
            MirVariantDef(name: "Green", discriminant: 1, payload: nil)
        ]), is_export_c: false, export_name: "")

fn mk_module(functions: [MirFunction]) -> MirModule:
    var fns: Dict<SymbolId, MirFunction> = {}
    for f in functions:
        fns[f.symbol] = f
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[SymbolId(id: PAIR_SYM)] = pair_struct()
    types[SymbolId(id: COLOR_SYM)] = color_enum()
    MirModule(name: "fixture.mv_cfg", functions: fns, statics: {}, constants: {}, types: types)

fn has_rule(report: MirVerifyReport, rule: text) -> bool:
    for f in report.findings:
        if f.rule == rule:
            return true
    false

fn count_rule(report: MirVerifyReport, rule: text) -> i64:
    var n = 0
    for f in report.findings:
        if f.rule == rule:
            n = n + 1
    n

fn first_message(report: MirVerifyReport, rule: text) -> text:
    for f in report.findings:
        if f.rule == rule:
            return f.message
    ""

describe "MIR verify: rule 5 — control flow structure":
    it "flags a Goto to a block that does not exist as MIRV-005 (warn-first)":
        val f = mk_fn(800, "fixture.goto_missing", [], i64_t(), [],
            [block(0, [], MirTerminator.Goto(BlockId(id: 7)))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-005")).to_equal(true)
        expect(first_message(report, "MIRV-005").contains("Goto targets block 7")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)

    it "flags a missing If else-target and names the edge":
        val f = mk_fn(801, "fixture.if_missing", [bool_t()], i64_t(), [arg(0, bool_t())],
            [block(0, [], MirTerminator.If(copy(0), BlockId(id: 1), BlockId(id: 9))),
             block(1, [], MirTerminator.Ret(Some(const_i64(1))))])
        val report = mir_verify_module(mk_module([f]))
        expect(count_rule(report, "MIRV-005")).to_equal(1)
        expect(first_message(report, "MIRV-005").contains("If.else")).to_equal(true)

    it "flags duplicate block ids and a missing entry block":
        val dup = mk_fn(802, "fixture.dup_blocks", [], i64_t(), [],
            [block(0, [], MirTerminator.Ret(Some(const_i64(0)))),
             block(0, [], MirTerminator.Ret(Some(const_i64(1))))])
        expect(first_message(mir_verify_module(mk_module([dup])), "MIRV-005").contains("duplicate block id 0")).to_equal(true)
        val no_entry = mk_fn(803, "fixture.no_entry", [], i64_t(), [],
            [block(3, [], MirTerminator.Ret(Some(const_i64(0))))])
        expect(first_message(mir_verify_module(mk_module([no_entry])), "MIRV-005").contains("entry block 0 does not exist")).to_equal(true)

    it "flags duplicate Switch case values and a missing Switch target":
        val f = mk_fn(804, "fixture.switch_dup", [i64_t()], i64_t(), [arg(0, i64_t())],
            [block(0, [], MirTerminator.Switch(copy(0),
                [SwitchCase(value: 1, target: BlockId(id: 1)), SwitchCase(value: 1, target: BlockId(id: 2))],
                BlockId(id: 1))),
             block(1, [], MirTerminator.Ret(Some(const_i64(0))))])
        val report = mir_verify_module(mk_module([f]))
        expect(count_rule(report, "MIRV-005")).to_equal(2)

    it "a well-formed diamond CFG verifies clean":
        val f = mk_fn(805, "fixture.diamond", [i64_t()], i64_t(), [arg(0, i64_t()), tmp(1, bool_t()), tmp(2, i64_t())],
            [block(0, [inst(MirInstKind.BinOp(LocalId(id: 1), MirBinOp.Gt, copy(0), const_i64(3)), 2)],
                   MirTerminator.If(copy(1), BlockId(id: 1), BlockId(id: 2))),
             block(1, [inst(MirInstKind.Const(LocalId(id: 2), MirConstValue.Int(1), i64_t()), 3)], MirTerminator.Goto(BlockId(id: 3))),
             block(2, [inst(MirInstKind.Const(LocalId(id: 2), MirConstValue.Int(2), i64_t()), 4)], MirTerminator.Goto(BlockId(id: 3))),
             block(3, [], MirTerminator.Ret(Some(copy(2))))])
        expect(mir_verify_module(mk_module([f])).is_clean()).to_equal(true)

describe "MIR verify: rule 5b/5c — local definitions and dropped conditions":
    it "defines TransferOut destinations for both runtime classification modes (#3022)":
        for runtime_classify in [false, true]:
            val f = mk_fn(830, "fixture.transfer_out", [i64_t()], i64_t(),
                [arg(0, i64_t()), tmp(1, i64_t())],
                [block(0, [inst(MirInstKind.TransferOut(
                    LocalId(id: 1), LocalId(id: 0), MirExecutionDomain.Thread,
                    MirTransferMode.Copy, MirTransferPayload.InlineCopy, runtime_classify), 2)],
                    MirTerminator.Ret(Some(copy(1))))])
            expect(mir_verify_module(mk_module([f])).is_clean()).to_equal(true)

    it "checks TransferOut source declarations for both runtime classification modes (#3022)":
        for runtime_classify in [false, true]:
            val f = mk_fn(831, "fixture.transfer_out_missing_source", [], i64_t(),
                [tmp(1, i64_t())],
                [block(0, [inst(MirInstKind.TransferOut(
                    LocalId(id: 1), LocalId(id: 5), MirExecutionDomain.Thread,
                    MirTransferMode.Copy, MirTransferPayload.InlineCopy, runtime_classify), 2)],
                    MirTerminator.Ret(Some(copy(1))))])
            val report = mir_verify_module(mk_module([f]))
            expect(count_rule(report, "MIRV-005b")).to_equal(1)
            expect(first_message(report, "MIRV-005b").contains("%5")).to_equal(true)
            expect(has_rule(report, "MIRV-005e")).to_equal(false)

    it "checks TransferOut destination declarations for both runtime classification modes (#3022)":
        for runtime_classify in [false, true]:
            val f = mk_fn(832, "fixture.transfer_out_missing_dest", [i64_t()], i64_t(),
                [arg(0, i64_t())],
                [block(0, [inst(MirInstKind.TransferOut(
                    LocalId(id: 5), LocalId(id: 0), MirExecutionDomain.Thread,
                    MirTransferMode.Copy, MirTransferPayload.InlineCopy, runtime_classify), 2)],
                    MirTerminator.Ret(Some(copy(0))))])
            val report = mir_verify_module(mk_module([f]))
            expect(count_rule(report, "MIRV-005b")).to_equal(1)
            expect(first_message(report, "MIRV-005b").contains("definition of local %5")).to_equal(true)

    it "flags a read of a local that is not declared in the function as MIRV-005b (warn-first)":
        val f = mk_fn(810, "fixture.undeclared", [], i64_t(), [tmp(0, i64_t())],
            [block(0, [inst(MirInstKind.Copy(LocalId(id: 0), LocalId(id: 5)), 2)], MirTerminator.Ret(Some(copy(0))))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-005b")).to_equal(true)
        expect(first_message(report, "MIRV-005b").contains("%5")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)

    it "warn-first: a declared temp that is read but never defined is MIRV-005e, not fatal":
        val f = mk_fn(811, "fixture.never_defined", [], i64_t(), [tmp(0, i64_t())],
            [block(0, [], MirTerminator.Ret(Some(copy(0))))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-005e")).to_equal(true)
        expect(first_message(report, "MIRV-005e").contains("read but never defined")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(mir_verify_rule_lifecycle("MIRV-005e")).to_equal("warning")

    it "MIRV-005e widening: a local whose address is taken by Ref counts as defined":
        val f = mk_fn(814, "fixture.ref_defined", [], i64_t(),
            [tmp(0, i64_t()), tmp(1, ty(MirTypeKind.Ref(i64_t(), true)))],
            [block(0, [inst(MirInstKind.Ref(LocalId(id: 1), MirBorrowKind.Mutable, MirPlace(local: LocalId(id: 0), projection: [])), 2)],
                   MirTerminator.Ret(Some(copy(0))))])
        expect(has_rule(mir_verify_module(mk_module([f])), "MIRV-005e")).to_equal(false)

    it "MIRV-005e widening: a GetElementPtr base counts as defined":
        val f = mk_fn(815, "fixture.gep_defined", [], i64_t(),
            [tmp(0, i64_t()), tmp(1, ty(MirTypeKind.Ptr(i64_t(), true)))],
            [block(0, [inst(MirInstKind.GetElementPtr(LocalId(id: 1), copy(0), [const_i64(0)]), 2)],
                   MirTerminator.Ret(Some(copy(0))))])
        expect(has_rule(mir_verify_module(mk_module([f])), "MIRV-005e")).to_equal(false)

    it "MIRV-005e widening: a Store target counts as defined":
        val f = mk_fn(816, "fixture.store_defined", [], i64_t(), [tmp(0, i64_t())],
            [block(0, [inst(MirInstKind.Store(copy(0), const_i64(7)), 2)],
                   MirTerminator.Ret(Some(copy(0))))])
        expect(has_rule(mir_verify_module(mk_module([f])), "MIRV-005e")).to_equal(false)

    it "MIRV-005e widening: an Intrinsic argument (out-parameter) counts as defined":
        val f = mk_fn(817, "fixture.intrinsic_defined", [], i64_t(), [tmp(0, i64_t())],
            [block(0, [inst(MirInstKind.Intrinsic(nil, "fixture_fill", [copy(0)]), 2)],
                   MirTerminator.Ret(Some(copy(0))))])
        expect(has_rule(mir_verify_module(mk_module([f])), "MIRV-005e")).to_equal(false)

    it "MIRV-005e widening is not a blanket pass: a plain Copy read of an undefined temp still reports":
        val f = mk_fn(818, "fixture.copy_undefined", [], i64_t(), [tmp(0, i64_t()), tmp(1, i64_t())],
            [block(0, [inst(MirInstKind.Copy(LocalId(id: 1), LocalId(id: 0)), 2)],
                   MirTerminator.Ret(Some(copy(1))))])
        expect(has_rule(mir_verify_module(mk_module([f])), "MIRV-005e")).to_equal(true)

    it "arguments and the return slot count as defined; a defined-later temp is fine":
        val f = mk_fn(812, "fixture.args_defined", [i64_t()], i64_t(),
            [arg(0, i64_t()), tmp(1, i64_t()),
             MirLocal(id: LocalId(id: 2), name: nil, type_: i64_t(), kind: LocalKind.Return, is_ghost: false)],
            [block(0, [inst(MirInstKind.Copy(LocalId(id: 1), LocalId(id: 0)), 2)], MirTerminator.Ret(Some(copy(2))))])
        expect(mir_verify_module(mk_module([f])).is_clean()).to_equal(true)

    it "warn-first: a comparison result never consumed by a branch is MIRV-005c (dropped guard shape), not fatal":
        val f = mk_fn(813, "fixture.dropped_guard", [i64_t()], i64_t(), [arg(0, i64_t()), tmp(1, bool_t())],
            [block(0, [inst(MirInstKind.BinOp(LocalId(id: 1), MirBinOp.Gt, copy(0), const_i64(0)), 2)],
                   MirTerminator.Ret(Some(const_i64(1))))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-005c")).to_equal(true)
        expect(first_message(report, "MIRV-005c").contains("%1")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(mir_verify_rule_lifecycle("MIRV-005c")).to_equal("warning")

describe "MIR verify: rule 5d — enum variants":
    it "flags an Aggregate constructing a variant the enum does not have as MIRV-005d (warn-first)":
        val enum_t = ty(MirTypeKind.Enum(SymbolId(id: COLOR_SYM)))
        val f = mk_fn(820, "fixture.bad_variant", [], enum_t, [tmp(0, enum_t)],
            [block(0, [inst(MirInstKind.Aggregate(LocalId(id: 0), AggregateKind.Enum(SymbolId(id: COLOR_SYM), 5), []), 2)],
                   MirTerminator.Ret(Some(copy(0))))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-005d")).to_equal(true)
        expect(first_message(report, "MIRV-005d").contains("variant 5")).to_equal(true)
        expect(first_message(report, "MIRV-005d").contains("Color")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)

    it "a valid variant is clean; a Switch over an enum-typed local with an unknown case is MIRV-005d":
        val enum_t = ty(MirTypeKind.Enum(SymbolId(id: COLOR_SYM)))
        val ok = mk_fn(821, "fixture.good_variant", [], enum_t, [tmp(0, enum_t)],
            [block(0, [inst(MirInstKind.Aggregate(LocalId(id: 0), AggregateKind.Enum(SymbolId(id: COLOR_SYM), 1), []), 2)],
                   MirTerminator.Ret(Some(copy(0))))])
        expect(mir_verify_module(mk_module([ok])).is_clean()).to_equal(true)
        val sw = mk_fn(822, "fixture.switch_variant", [enum_t], i64_t(), [arg(0, enum_t)],
            [block(0, [], MirTerminator.Switch(copy(0),
                [SwitchCase(value: 0, target: BlockId(id: 1)), SwitchCase(value: 3, target: BlockId(id: 1))], BlockId(id: 1))),
             block(1, [], MirTerminator.Ret(Some(const_i64(0))))])
        val report = mir_verify_module(mk_module([sw]))
        expect(count_rule(report, "MIRV-005d")).to_equal(1)

describe "MIR verify: rule 6 — field projections within layout":
    it "flags GetField index 2 on a two-field struct as MIRV-006 (warn-first) naming the struct":
        val pair_t = ty(MirTypeKind.Struct(SymbolId(id: PAIR_SYM)))
        val f = mk_fn(830, "fixture.field_oob", [pair_t], i64_t(), [arg(0, pair_t), tmp(1, i64_t())],
            [block(0, [inst(MirInstKind.GetField(LocalId(id: 1), copy(0), 2), 2)], MirTerminator.Ret(Some(copy(1))))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-006")).to_equal(true)
        expect(first_message(report, "MIRV-006").contains("index 2 outside struct 'Pair' layout of 2 field(s)")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)

    it "in-range fields through a value, a pointer and a tuple are clean; SetField is checked too":
        val pair_t = ty(MirTypeKind.Struct(SymbolId(id: PAIR_SYM)))
        val pair_p = ty(MirTypeKind.Ptr(pair_t, true))
        val tup = ty(MirTypeKind.Tuple([i64_t(), bool_t()]))
        val ok = mk_fn(831, "fixture.field_ok", [pair_t, pair_p, tup], i64_t(),
            [arg(0, pair_t), arg(1, pair_p), arg(2, tup), tmp(3, i64_t()), tmp(4, i64_t()), tmp(5, bool_t())],
            [block(0, [
                inst(MirInstKind.GetField(LocalId(id: 3), copy(0), 1), 2),
                inst(MirInstKind.GetField(LocalId(id: 4), copy(1), 0), 3),
                inst(MirInstKind.GetField(LocalId(id: 5), copy(2), 1), 4),
                inst(MirInstKind.SetField(copy(1), 1, copy(3)), 5)
             ], MirTerminator.Ret(Some(copy(4))))])
        expect(mir_verify_module(mk_module([ok])).is_clean()).to_equal(true)
        val bad_set = mk_fn(832, "fixture.setfield_oob", [pair_p, tup], i64_t(), [arg(0, pair_p), arg(1, tup)],
            [block(0, [inst(MirInstKind.SetField(copy(0), 3, const_i64(1)), 2),
                       inst(MirInstKind.SetField(copy(1), 2, const_i64(1)), 3)], MirTerminator.Ret(Some(const_i64(0))))])
        val report = mir_verify_module(mk_module([bad_set]))
        expect(count_rule(report, "MIRV-006")).to_equal(2)
        expect(first_message(report, "MIRV-006").contains("SetField")).to_equal(true)

    it "warn-first: a projection whose struct owner is not in the module is MIRV-006b, not fatal":
        val foreign = ty(MirTypeKind.Struct(SymbolId(id: 999)))
        val f = mk_fn(833, "fixture.foreign_owner", [foreign], i64_t(), [arg(0, foreign), tmp(1, i64_t())],
            [block(0, [inst(MirInstKind.GetField(LocalId(id: 1), copy(0), 0), 2)], MirTerminator.Ret(Some(copy(1))))])
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-006b")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(mir_verify_rule_lifecycle("MIRV-006b")).to_equal("warning")
