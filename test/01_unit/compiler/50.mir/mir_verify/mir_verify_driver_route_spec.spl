# @req REQ-SSPEC-COMPILER
"""
# Mandatory MIR verification — the driver route

Drives `CompilerDriver.verify_lowered_mir_v1` (the step both `lower_to_mir`
entry points call) on a hand-built invalid module placed in
`ctx.mir_modules`, and pins:

  * default (warn-first registry): the finding is a driver WARNING, the
    step returns true, no error is recorded;
  * `SIMPLE_MIR_VERIFY_LEVELS=MIRV-002=error`: the finding is a driver
    ERROR, the step returns false (nothing invalid reaches codegen);
  * the same override under SIMPLE_ASSURANCE_WARNING_PHASE=1: downgraded
    one level back to a warning, step returns true;
  * `MIRV-002=off`: nothing is reported at all;
  * a `mir_verify` pass receipt is recorded with the module count.
"""

# @tag: unit, compiler, mir, verify, driver

use std.spec
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.*
use compiler.mir.mir_verify_levels.{mir_verify_levels_from_spec, mir_verify_warning_cap}
use compiler.driver.driver.{CompilerDriver}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}

fn span() -> Span:
    Span(start: 0, end: 0, line: 4, col: 2, file: "fixture/mv_driver.spl", length: 0)

fn ty(kind: MirTypeKind) -> MirType:
    MirType(kind: kind)

fn copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))

fn cast_insts(n: i64, dst: MirType) -> [MirInst]:
    var out: [MirInst] = []
    var i = 0
    while i < n:
        out = out.push(MirInst(kind: MirInstKind.Cast(LocalId(id: 1), copy(0), dst), span: Some(span())))
        i = i + 1
    out

fn text_to_u8_module(casts: i64) -> MirModule:
    val src = ty(MirTypeKind.Opaque("str"))
    val dst = ty(MirTypeKind.U8)
    val f = MirFunction(
        symbol: SymbolId(id: 1), name: "fixture.to_bytes",
        signature: MirSignature(params: [src], return_type: dst, is_variadic: false, params_known: true),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("s"), type_: src, kind: LocalKind.Arg(0), is_ghost: false),
            MirLocal(id: LocalId(id: 1), name: nil, type_: dst, kind: LocalKind.Temp, is_ghost: false)
        ],
        blocks: [MirBlock(id: BlockId(id: 0), label: Some("entry"),
            instructions: cast_insts(casts, dst),
            terminator: MirTerminator.Ret(Some(copy(1))))],
        entry_block: BlockId(id: 0), span: span(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )
    var fns: Dict<SymbolId, MirFunction> = {}
    fns[f.symbol] = f
    MirModule(name: "fixture.mv_driver", functions: fns, statics: {}, constants: {}, types: {})

fn run_driver(casts: i64) -> (bool, i64, i64, text):
    """Returns (step_ok, errors, warnings, first error text)."""
    var driver = CompilerDriver.create(driver_core_compile_options_default())
    driver.ctx.mir_modules["fixture.mv_driver"] = text_to_u8_module(casts)
    val errors_before = driver.ctx.error_count()
    val warnings_before = driver.ctx.warnings.len()
    val ok = driver.verify_lowered_mir_v1()
    val first = if driver.ctx.error_count() > errors_before: driver.ctx.error_message_at(errors_before) else: ""
    (ok, driver.ctx.error_count() - errors_before, driver.ctx.warnings.len() - warnings_before, first)

fn with_env(levels: text, phase: text) -> (bool, i64, i64, text):
    val saved_levels = env_get("SIMPLE_MIR_VERIFY_LEVELS")
    val saved_phase = env_get("SIMPLE_ASSURANCE_WARNING_PHASE")
    val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", levels)
    val _b = env_set("SIMPLE_ASSURANCE_WARNING_PHASE", phase)
    val result = run_driver(1)
    val _c = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved_levels)
    val _d = env_set("SIMPLE_ASSURANCE_WARNING_PHASE", saved_phase)
    result

describe "MIR verify driver route (verify_lowered_mir_v1)":
    it "warn-first default: the finding is a driver warning and the step passes":
        val (ok, errors, warnings, _first) = with_env("", "")
        expect(ok).to_equal(true)
        expect(errors).to_equal(0)
        expect(warnings).to_equal(1)

    it "SIMPLE_MIR_VERIFY_LEVELS=MIRV-002=error makes it a driver error and fails the step":
        val (ok, errors, warnings, first) = with_env("MIRV-002=error", "")
        expect(ok).to_equal(false)
        expect(errors).to_equal(1)
        expect(warnings).to_equal(0)
        expect(first.contains("[MIRV-002]")).to_equal(true)
        expect(first.contains("fn fixture.to_bytes")).to_equal(true)
        expect(first.contains("fixture/mv_driver.spl:4:2")).to_equal(true)

    it "the global warning phase downgrades a promoted rule one level back to a warning":
        val (ok, errors, warnings, _first) = with_env("MIRV-002=error", "1")
        expect(ok).to_equal(true)
        expect(errors).to_equal(0)
        expect(warnings).to_equal(1)

    it "MIRV-002=off suppresses the finding entirely; `*=off` suppresses every rule":
        val (ok, errors, warnings, _first) = with_env("MIRV-002=off", "")
        expect(ok).to_equal(true)
        expect(errors).to_equal(0)
        expect(warnings).to_equal(0)
        val (ok2, errors2, warnings2, _f2) = with_env("*=off", "")
        expect(ok2 and errors2 == 0 and warnings2 == 0).to_equal(true)

    it "a mistyped level fails closed: the whole spec is rejected, nothing resolves to off, and the driver errors":
        val typo = mir_verify_levels_from_spec("MIRV-002=eror,*=off")
        expect(typo.config_error.contains("unknown level 'eror'")).to_equal(true)
        expect(typo.level_of("MIRV-002")).to_equal("warning")
        expect(typo.level_of("MIRV-005e")).to_equal("warning")
        expect(typo.level_of("E-MIR-TYPE-Error")).to_equal("warning")
        expect(typo.verifier_off).to_equal(false)
        expect(mir_verify_levels_from_spec("MIRV-02=off").config_error.contains("unknown rule id 'MIRV-02'")).to_equal(true)
        expect(mir_verify_levels_from_spec("MIRV-002").config_error != "").to_equal(true)
        expect(mir_verify_levels_from_spec("MIRV-002=off, *=warning,").config_error).to_equal("")
        val (ok, errors, warnings, first) = with_env("MIRV-002=eror,*=off", "")
        expect(ok).to_equal(false)
        expect(errors).to_equal(1)
        expect(warnings).to_equal(0)
        expect(first.contains("invalid SIMPLE_MIR_VERIFY_LEVELS")).to_equal(true)
        expect(first.contains("eror")).to_equal(true)

    it "`*=off` skips the walk itself: the receipt says state=skipped with zero modules":
        val sink = "build/test_tmp/mir_verify_driver_route_skip_receipt.txt"
        val _mk = dir_create_all("build/test_tmp")
        if file_exists(sink):
            val _rm = file_remove(sink)
        val saved_sink = env_get("SIMPLE_PASS_RECEIPT")
        val _s = env_set("SIMPLE_PASS_RECEIPT", sink)
        val (ok, errors, warnings, _first) = with_env("*=off", "")
        val _restore = env_set("SIMPLE_PASS_RECEIPT", saved_sink)
        expect(ok and errors == 0 and warnings == 0).to_equal(true)
        val lines = file_read(sink)
        expect(lines.contains("pass_executed name=mir_verify state=skipped")).to_equal(true)
        expect(lines.contains("modules=0")).to_equal(true)
        expect(mir_verify_levels_from_spec("*=off").verifier_off).to_equal(true)
        expect(mir_verify_levels_from_spec("*=off,MIRV-002=warning").verifier_off).to_equal(false)

    it "warning output is capped per rule per build: first N lines plus one count line; errors are never capped":
        val cap = mir_verify_warning_cap()
        val saved_levels = env_get("SIMPLE_MIR_VERIFY_LEVELS")
        val _a = env_set("SIMPLE_MIR_VERIFY_LEVELS", "")
        val (ok, errors, warnings, _first) = run_driver(cap + 15)
        val _b = env_set("SIMPLE_MIR_VERIFY_LEVELS", "MIRV-002=error")
        val (ok2, errors2, warnings2, _f2) = run_driver(cap + 15)
        val _c = env_set("SIMPLE_MIR_VERIFY_LEVELS", saved_levels)
        expect(ok).to_equal(true)
        expect(errors).to_equal(0)
        expect(warnings).to_equal(cap + 1)
        expect(ok2).to_equal(false)
        expect(errors2).to_equal(cap + 15)
        expect(warnings2).to_equal(0)

    it "an unknown level or unknown rule id never downgrades: the registry default stays":
        expect(mir_verify_rule_level_from_spec("MIRV-002", "MIRV-002=silent")).to_equal("warning")
        expect(mir_verify_rule_level_from_spec("MIRV-002", "MIRV-999=off")).to_equal("warning")
        expect(mir_verify_rule_level_from_spec("MIRV-002", "*=error,MIRV-002=off")).to_equal("off")
        expect(mir_verify_rule_level_from_spec("MIRV-005", "*=error,MIRV-002=off")).to_equal("error")

    it "records a mir_verify pass receipt (SIMPLE_PASS_RECEIPT sink) naming the modules checked":
        val sink = "build/test_tmp/mir_verify_driver_route_receipt.txt"
        val _mk = dir_create_all("build/test_tmp")
        if file_exists(sink):
            val _rm = file_remove(sink)
        val saved_sink = env_get("SIMPLE_PASS_RECEIPT")
        val _s = env_set("SIMPLE_PASS_RECEIPT", sink)
        val _r = with_env("", "")
        val _restore = env_set("SIMPLE_PASS_RECEIPT", saved_sink)
        expect(file_exists(sink)).to_equal(true)
        val lines = file_read(sink)
        expect(lines.contains("pass_executed name=mir_verify state=executed")).to_equal(true)
        expect(lines.contains("modules=1")).to_equal(true)
        expect(lines.contains("diagnostics=1")).to_equal(true)
