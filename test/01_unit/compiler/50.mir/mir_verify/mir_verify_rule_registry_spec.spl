# @req REQ-SSPEC-COMPILER
"""
# Mandatory MIR verification — rule registry and reference-baseline parity

`config/compiler/mir_verify_rules.sdn` is the policy record (id, family,
lifecycle, promotion_candidate, eventual_profiles, evidence) and
`mir_verify_rules()` is its in-binary projection. Parsed with the std SDN
parser, the two must agree exactly — same ids in the same order with the
same lifecycle and promotion flag — every `"MIRV-…"` literal the verifier
source reports must be a registered rule, and the reference baseline (a
recorded measurement; it is not enforced as a ratchet)
`config/compiler/mir_verify_baseline.sdn` must carry a count for every rule.
Configurable rules retain their warn-first lifecycle. Missing type carriers
are mandatory structural errors and are not represented in the historical baseline.
"""

# @tag: unit, compiler, mir, verify

use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read, file_exists}
use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}
use compiler.mir.mir_verify.*

val REGISTRY_PATH: text = "config/compiler/mir_verify_rules.sdn"
val BASELINE_PATH: text = "config/compiler/mir_verify_baseline.sdn"
val VERIFIER_PATH: text = "src/compiler/50.mir/mir_verify.spl"

fn load_sdn(path: text) -> SdnValue?:
    if not file_exists(path):
        return nil
    val parsed = parse(file_read(path))
    if parsed.is_err():
        print "sdn parse error in {path}: {parsed.unwrap_err()}"
        return nil
    Some(parsed.unwrap())

fn str_field(v: SdnValue, key: text) -> text:
    if val f = v.get(key):
        return f.as_str() ?? ""
    ""

fn bool_field(v: SdnValue, key: text) -> bool:
    if val f = v.get(key):
        return f.as_bool() ?? false
    false

fn reported_rule_ids(source: text) -> [text]:
    """Every distinct `"MIRV-…"` literal in the verifier source."""
    var ids: [text] = []
    var rest = source
    while true:
        val at = rest.index_of("\"MIRV-") ?? -1
        if at < 0:
            break
        val after = rest.substring(at + 1)
        val close = after.index_of("\"") ?? -1
        if close < 0:
            break
        val id = after.substring(0, close)
        # A rule id is `MIRV-` + alphanumerics only; anything else (e.g. the
        # SIMPLE_MIR_VERIFY_LEVELS example "MIRV-002=error,...") is prose.
        var well_formed = true
        var ci = 5
        while ci < id.len():
            val ch = id[ci]
            val ok_char = (ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z")
            if not ok_char:
                well_formed = false
            ci = ci + 1
        if not well_formed:
            rest = after.substring(close + 1)
            continue
        var seen = false
        for known in ids:
            if known == id:
                seen = true
        if not seen:
            ids = ids.push(id)
        rest = after.substring(close + 1)
    ids

describe "MIR verify rule registry (std SDN parser)":
    it "the registry parses and lists every in-binary rule in order with the same lifecycle and promotion flag":
        val doc = load_sdn(REGISTRY_PATH)
        expect(doc != nil).to_equal(true)
        if val d = doc:
            expect(str_field(d, "schema_version")).to_equal("simple.mir-verify-rules/v1")
            val rows = (d.get("rules") ?? SdnValue.Null).as_array() ?? []
            val rules = mir_verify_rules()
            expect(rows.len()).to_equal(rules.len())
            var i = 0
            while i < rules.len() and i < rows.len():
                expect(str_field(rows[i], "id")).to_equal(rules[i].id)
                expect(str_field(rows[i], "family")).to_equal(rules[i].family)
                expect(str_field(rows[i], "lifecycle")).to_equal(rules[i].lifecycle)
                expect(bool_field(rows[i], "promotion_candidate")).to_equal(rules[i].promotion_candidate)
                i = i + 1

    it "keeps configurable rules warn-first and missing carriers mandatory":
        for rule in mir_verify_rules():
            val expected = if rule.id == "MIRV-001n": "error" else: "warning"
            expect(rule.lifecycle).to_equal(expected)
            expect(mir_verify_rule_level_from_spec(rule.id, "")).to_equal(expected)

    it "an unregistered rule id fails closed to error":
        expect(mir_verify_rule_lifecycle("MIRV-999")).to_equal("")
        expect(mir_verify_rule_level_from_spec("MIRV-999", "")).to_equal("error")

    it "every rule id the verifier source reports is registered":
        val ids = reported_rule_ids(file_read(VERIFIER_PATH))
        expect(ids.len()).to_be_greater_than(10)
        for id in ids:
            val found = mir_verify_rule_lifecycle(id) != ""
            if not found:
                print "unregistered rule id reported by verifier: {id}"
            expect(found).to_equal(true)

    it "keeps historical baseline counts without fabricating evidence for the new structural rule":
        val doc = load_sdn(BASELINE_PATH)
        expect(doc != nil).to_equal(true)
        if val d = doc:
            expect(str_field(d, "schema_version")).to_equal("simple.mir-verify-baseline/v1")
            val counts = d.get("counts")
            expect(counts != nil).to_equal(true)
            if val c = counts:
                for rule in mir_verify_rules():
                    val entry = c.get(rule.id)
                    if rule.id == "MIRV-001n":
                        expect(entry == nil).to_equal(true)
                    else:
                        if entry == nil:
                            print "baseline missing rule {rule.id}"
                        expect(entry != nil).to_equal(true)
