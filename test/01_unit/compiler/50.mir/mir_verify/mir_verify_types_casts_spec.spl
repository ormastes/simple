# @req REQ-SSPEC-COMPILER
"""
# Mandatory MIR verification — rule groups 1 (types), 2 (casts), 3 (unit storage)

Hand-built invalid MIR, one function per case, asserting the exact rule id,
fatality and location text that `mir_verify_module` reports. Each case is the
MIR shape a real 2026-10-10 bug produced:

  * MIRV-002: `text[i] as u8` lowers to `Cast(opaque<str> -> u8)` and crashed
    the LLVM backend with "unsupported LLVM value conversion from ptr to i8".
  * MIRV-003: a `global void` static.
  * MIRV-001: an unresolved type surviving into a local / return slot.
"""

# @tag: unit, compiler, mir, verify

use std.spec
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.*

fn span_at(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 3, file: "fixture/mv_types.spl", length: 0)

fn ty(kind: MirTypeKind) -> MirType:
    MirType(kind: kind)

fn text_type() -> MirType:
    ty(MirTypeKind.Opaque("str"))

fn fat_text_type() -> MirType:
    ty(MirTypeKind.Tuple([ty(MirTypeKind.Ptr(ty(MirTypeKind.U8), false)), ty(MirTypeKind.U64)]))

fn copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))

fn arg(id: i64, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some("a{id}"), type_: t, kind: LocalKind.Arg(id), is_ghost: false)

fn tmp(id: i64, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: t, kind: LocalKind.Temp, is_ghost: false)

fn var_local(id: i64, name: text, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some(name), type_: t, kind: LocalKind.Var, is_ghost: false)

fn inst(kind: MirInstKind, line: i64) -> MirInst:
    MirInst(kind: kind, span: Some(span_at(line)))

fn mk_fn(sym: i64, name: text, params: [MirType], ret: MirType, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: sym), name: name,
        signature: MirSignature(params: params, return_type: ret, is_variadic: false, params_known: true),
        locals: locals, blocks: blocks,
        entry_block: BlockId(id: 0), span: span_at(1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

fn one_block(instructions: [MirInst], ret: MirOperand?) -> [MirBlock]:
    [MirBlock(id: BlockId(id: 0), label: Some("entry"), instructions: instructions,
              terminator: MirTerminator.Ret(ret))]

fn mk_module(functions: [MirFunction]) -> MirModule:
    var fns: Dict<SymbolId, MirFunction> = {}
    for f in functions:
        fns[f.symbol] = f
    MirModule(name: "fixture.mv_types", functions: fns, statics: {}, constants: {}, types: {})

fn cast_fn(name: text, src: MirType, dst: MirType) -> MirFunction:
    # a0: src -> %1 = cast a0 to dst ; ret %1
    mk_fn(100, name, [src], dst,
        [arg(0, src), tmp(1, dst)],
        one_block([inst(MirInstKind.Cast(LocalId(id: 1), copy(0), dst), 7)], Some(copy(1))))

fn bitcast_fn(name: text, src: MirType, dst: MirType) -> MirFunction:
    mk_fn(101, name, [src], dst,
        [arg(0, src), tmp(1, dst)],
        one_block([inst(MirInstKind.Bitcast(LocalId(id: 1), copy(0), dst), 8)], Some(copy(1))))

fn rules_of(report: MirVerifyReport) -> [text]:
    var out: [text] = []
    for f in report.findings:
        out = out.push(f.rule)
    out

fn has_rule(report: MirVerifyReport, rule: text) -> bool:
    for f in report.findings:
        if f.rule == rule:
            return true
    false

fn first_message(report: MirVerifyReport, rule: text) -> text:
    for f in report.findings:
        if f.rule == rule:
            return f.message
    ""

describe "MIR verify: rule 2 — cast legality":
    it "flags `text as u8` (the ptr->i8 LLVM crash) as fatal MIRV-002 naming the function":
        val report = mir_verify_module(mk_module([cast_fn("fixture.to_bytes", text_type(), ty(MirTypeKind.U8))]))
        expect(has_rule(report, "MIRV-002")).to_equal(true)
        expect(report.fatal_count()).to_equal(1)
        val f = report.findings[0]
        expect(f.function).to_equal("fixture.to_bytes")
        expect(f.block).to_equal(0)
        expect(f.inst).to_equal(0)
        expect(f.message.contains("text")).to_equal(true)
        expect(f.message.contains("opaque<str> -> u8")).to_equal(true)
        expect(f.is_fatal()).to_equal(true)

    it "flags a (ptr,len) fat-text tuple -> u8 cast as text/scalar MIRV-002 (both text lowerings are one type)":
        val report = mir_verify_module(mk_module([cast_fn("fixture.fat", fat_text_type(), ty(MirTypeKind.U8))]))
        expect(has_rule(report, "MIRV-002")).to_equal(true)
        expect(first_message(report, "MIRV-002").contains("text")).to_equal(true)
        val pair = ty(MirTypeKind.Tuple([ty(MirTypeKind.I64), ty(MirTypeKind.I64)]))
        val agg = mir_verify_module(mk_module([cast_fn("fixture.pair", pair, ty(MirTypeKind.U8))]))
        expect(first_message(agg, "MIRV-002").contains("aggregate")).to_equal(true)

    it "flags ptr -> u8 but accepts ptr -> i64 (handle convention)":
        val p = ty(MirTypeKind.Ptr(ty(MirTypeKind.U8), false))
        val bad = mir_verify_module(mk_module([cast_fn("fixture.ptr_narrow", p, ty(MirTypeKind.U8))]))
        expect(has_rule(bad, "MIRV-002")).to_equal(true)
        expect(first_message(bad, "MIRV-002").contains("narrow integer")).to_equal(true)
        val ok = mir_verify_module(mk_module([cast_fn("fixture.ptr_wide", p, ty(MirTypeKind.I64))]))
        expect(ok.is_clean()).to_equal(true)

    it "flags ptr <-> float casts":
        val p = ty(MirTypeKind.Ptr(ty(MirTypeKind.U8), false))
        val report = mir_verify_module(mk_module([cast_fn("fixture.ptr_f64", p, ty(MirTypeKind.F64))]))
        expect(has_rule(report, "MIRV-002")).to_equal(true)
        expect(first_message(report, "MIRV-002").contains("float")).to_equal(true)

    it "accepts int -> float Cast (Cast is the explicit conversion op) and int width changes":
        val report = mir_verify_module(mk_module([
            cast_fn("fixture.i2f", ty(MirTypeKind.I64), ty(MirTypeKind.F64)),
            cast_fn("fixture.narrow", ty(MirTypeKind.I64), ty(MirTypeKind.U8))
        ]))
        expect(report.is_clean()).to_equal(true)

    it "flags a width-changing Bitcast (MIRV-002b) but accepts same-width i64 <-> f64":
        val bad = mir_verify_module(mk_module([bitcast_fn("fixture.bc_bad", ty(MirTypeKind.I32), ty(MirTypeKind.F64))]))
        expect(has_rule(bad, "MIRV-002b")).to_equal(true)
        expect(first_message(bad, "MIRV-002b").contains("32 bits")).to_equal(true)
        val ok = mir_verify_module(mk_module([bitcast_fn("fixture.bc_ok", ty(MirTypeKind.I64), ty(MirTypeKind.F64))]))
        expect(ok.is_clean()).to_equal(true)

    it "flags a cast whose operand is a unit value":
        val report = mir_verify_module(mk_module([cast_fn("fixture.unit_cast", ty(MirTypeKind.Unit), ty(MirTypeKind.I64))]))
        expect(has_rule(report, "MIRV-002")).to_equal(true)

describe "MIR verify: rule 1 — unresolved types":
    it "flags an unresolved opaque local type as fatal MIRV-001 with the local id":
        val f = mk_fn(110, "fixture.unresolved_local", [], ty(MirTypeKind.I64),
            [var_local(0, "x", ty(MirTypeKind.Opaque("")))],
            one_block([], nil))
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-001")).to_equal(true)
        expect(first_message(report, "MIRV-001").contains("local %0")).to_equal(true)
        expect(report.fatal_count()).to_equal(1)

    it "flags an unresolved return type and parameter type":
        val f = mk_fn(111, "fixture.unresolved_sig", [ty(MirTypeKind.Opaque("<error>"))], ty(MirTypeKind.Ptr(ty(MirTypeKind.Opaque("<error>")), false)),
            [arg(0, ty(MirTypeKind.I64))],
            one_block([], nil))
        val report = mir_verify_module(mk_module([f]))
        var n = 0
        for fd in report.findings:
            if fd.rule == "MIRV-001":
                n = n + 1
        expect(n).to_equal(2)

    it "flags a nominal type with a negative symbol id":
        val f = mk_fn(112, "fixture.neg_struct", [], ty(MirTypeKind.I64),
            [tmp(0, ty(MirTypeKind.Struct(SymbolId(id: -1))))],
            one_block([], nil))
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-001")).to_equal(true)

    it "accepts the named opaque types lowering emits on purpose (tensor, layer, str)":
        val f = mk_fn(113, "fixture.named_opaque", [], ty(MirTypeKind.I64),
            [tmp(0, ty(MirTypeKind.Opaque("tensor"))), tmp(1, ty(MirTypeKind.Opaque("str")))],
            one_block([], nil))
        expect(mir_verify_module(mk_module([f])).is_clean()).to_equal(true)

describe "MIR verify: rule 3 — unit storage":
    it "flags a `global void` static as fatal MIRV-003":
        var module = mk_module([])
        var statics: Dict<SymbolId, MirStatic> = {}
        statics[SymbolId(id: 500)] = MirStatic(symbol: SymbolId(id: 500), name: "void_global",
            type_: ty(MirTypeKind.Unit), init: nil, is_mutable: true)
        module.statics = statics
        val report = mir_verify_module(module)
        expect(has_rule(report, "MIRV-003")).to_equal(true)
        expect(report.fatal_count()).to_equal(1)
        expect(first_message(report, "MIRV-003").contains("void_global")).to_equal(true)

    it "warn-first: a stored unit local is MIRV-003b and not fatal":
        val f = mk_fn(114, "fixture.unit_var", [], ty(MirTypeKind.I64),
            [var_local(0, "nothing", ty(MirTypeKind.Unit))],
            one_block([], nil))
        val report = mir_verify_module(mk_module([f]))
        expect(has_rule(report, "MIRV-003b")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(mir_verify_rule_lifecycle("MIRV-003b")).to_equal("warning")

describe "MIR verify: finding format":
    it "names rule, module, function, block, instruction and source span":
        val report = mir_verify_module(mk_module([cast_fn("fixture.to_bytes", text_type(), ty(MirTypeKind.U8))]))
        val line = report.findings[0].format()
        expect(line.starts_with("MIR verify [MIRV-002]:")).to_equal(true)
        expect(line.contains("module fixture.mv_types, fn fixture.to_bytes, block 0, inst 0")).to_equal(true)
        expect(line.contains("at fixture/mv_types.spl:7:3")).to_equal(true)
