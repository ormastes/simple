# @req REQ-SSPEC-COMPILER
"""
# Mandatory MIR verification — rule groups 4 (call sites) and 7 (module level)

Hand-built MIR asserting the exact rule id and fatality:

  * MIRV-004  call to a function still flagged `is_generic_template`
             (un-emitted template / unspecialised symbol).
  * MIRV-004b arity disagreement with the callee signature.
  * MIRV-004c argument type disagreement (warn-first).
  * MIRV-004d `Call` through a value whose type is not callable (closure
             aggregate used with the fn-pointer ABI).
  * MIRV-007  two functions lowering to one emitted name (the mono
             specialization symbol-id collision class).
  * MIRV-007b static initializer type disagrees with the declared type
             (warn-first).
"""

# @tag: unit, compiler, mir, verify

use std.spec
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.*

fn span_at(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "fixture/mv_calls.spl", length: 0)

fn ty(kind: MirTypeKind) -> MirType:
    MirType(kind: kind)

fn i64_t() -> MirType:
    ty(MirTypeKind.I64)

fn copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))

fn const_i64(v: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(v), i64_t()))

fn callee_operand(name: text, params: [MirType], ret: MirType) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
        ty(MirTypeKind.FuncPtr(MirSignature(params: params, return_type: ret, is_variadic: false, params_known: true)))))

fn arg(id: i64, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some("a{id}"), type_: t, kind: LocalKind.Arg(id), is_ghost: false)

fn tmp(id: i64, t: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: t, kind: LocalKind.Temp, is_ghost: false)

fn inst(kind: MirInstKind, line: i64) -> MirInst:
    MirInst(kind: kind, span: Some(span_at(line)))

fn mk_fn_full(sym: i64, name: text, params: [MirType], ret: MirType, locals: [MirLocal], blocks: [MirBlock], template: bool, params_known: bool) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: sym), name: name,
        signature: MirSignature(params: params, return_type: ret, is_variadic: false, params_known: params_known),
        locals: locals, blocks: blocks,
        entry_block: BlockId(id: 0), span: span_at(1), generic_params: [],
        is_generic_template: template, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

fn mk_fn(sym: i64, name: text, params: [MirType], ret: MirType, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    mk_fn_full(sym, name, params, ret, locals, blocks, false, true)

fn one_block(instructions: [MirInst], ret: MirOperand?) -> [MirBlock]:
    [MirBlock(id: BlockId(id: 0), label: Some("entry"), instructions: instructions,
              terminator: MirTerminator.Ret(ret))]

fn mk_module(functions: [MirFunction]) -> MirModule:
    var fns: Dict<SymbolId, MirFunction> = {}
    for f in functions:
        fns[f.symbol] = f
    MirModule(name: "fixture.mv_calls", functions: fns, statics: {}, constants: {}, types: {})

# callee `add2(a: i64, b: i64) -> i64` (a real, emitted function)
fn add2() -> MirFunction:
    mk_fn(200, "fixture.add2", [i64_t(), i64_t()], i64_t(),
        [arg(0, i64_t()), arg(1, i64_t()), tmp(2, i64_t())],
        one_block([inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, copy(0), copy(1)), 2)], Some(copy(2))))

fn caller(sym: i64, name: text, callee: MirOperand, args: [MirOperand], arg_locals: [MirLocal]) -> MirFunction:
    var locals = arg_locals
    locals = locals.push(tmp(9, i64_t()))
    mk_fn(sym, name, [], i64_t(), locals,
        one_block([inst(MirInstKind.Call(Some(LocalId(id: 9)), callee, args), 5)], Some(copy(9))))

fn has_rule(report: MirVerifyReport, rule: text) -> bool:
    for f in report.findings:
        if f.rule == rule:
            return true
    false

fn first_message(report: MirVerifyReport, rule: text) -> text:
    for f in report.findings:
        if f.rule == rule:
            return f.message
    ""

describe "MIR verify: rule 4 — call sites":
    it "a direct call to an in-module function with matching arity and types is clean":
        val m = mk_module([add2(), caller(201, "fixture.ok", callee_operand("fixture.add2", [i64_t(), i64_t()], i64_t()), [const_i64(1), const_i64(2)], [])])
        expect(mir_verify_module(m).is_clean()).to_equal(true)

    it "flags a call to an un-emitted generic template as MIRV-004 (warn-first)":
        val template = mk_fn_full(202, "fixture.ident", [i64_t()], i64_t(), [arg(0, i64_t())], one_block([], Some(copy(0))), true, true)
        val m = mk_module([template, caller(203, "fixture.calls_template", callee_operand("fixture.ident", [i64_t()], i64_t()), [const_i64(1)], [])])
        val report = mir_verify_module(m)
        expect(has_rule(report, "MIRV-004")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(first_message(report, "MIRV-004").contains("fixture.ident")).to_equal(true)
        expect(report.findings[0].function).to_equal("fixture.calls_template")

    it "flags an arity mismatch as MIRV-004b (warn-first) naming both counts":
        val m = mk_module([add2(), caller(204, "fixture.arity", callee_operand("fixture.add2", [i64_t(), i64_t()], i64_t()), [const_i64(1)], [])])
        val report = mir_verify_module(m)
        expect(has_rule(report, "MIRV-004b")).to_equal(true)
        expect(first_message(report, "MIRV-004b").contains("passes 1 argument(s) but the callee declares 2")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)

    it "does not judge arity when the callee's parameter list is not authoritative (params_known=false, empty)":
        val legacy = mk_fn_full(205, "fixture.legacy", [], i64_t(), [], one_block([], Some(const_i64(0))), false, false)
        val m = mk_module([legacy, caller(206, "fixture.calls_legacy", callee_operand("fixture.legacy", [], i64_t()), [const_i64(1), const_i64(2)], [])])
        expect(mir_verify_module(m).is_clean()).to_equal(true)

    it "warn-first: an aggregate argument of the wrong shape is MIRV-004c, not fatal":
        val pair = ty(MirTypeKind.Tuple([i64_t(), i64_t()]))
        val triple = ty(MirTypeKind.Tuple([i64_t(), i64_t(), i64_t()]))
        val takes_pair = mk_fn(207, "fixture.takes_pair", [pair], i64_t(), [arg(0, pair)], one_block([], Some(const_i64(0))))
        val m = mk_module([takes_pair, caller(208, "fixture.passes_triple", callee_operand("fixture.takes_pair", [pair], i64_t()), [copy(0)], [arg(0, triple)])])
        val report = mir_verify_module(m)
        expect(has_rule(report, "MIRV-004c")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(mir_verify_rule_lifecycle("MIRV-004c")).to_equal("warning")

    it "accepts int-width coercion and i64-handle-for-pointer arguments":
        val p = ty(MirTypeKind.Ptr(ty(MirTypeKind.U8), false))
        val takes = mk_fn(209, "fixture.takes_ptr_u8", [p, ty(MirTypeKind.U8)], i64_t(), [arg(0, p), arg(1, ty(MirTypeKind.U8))], one_block([], Some(const_i64(0))))
        val m = mk_module([takes, caller(210, "fixture.coerce", callee_operand("fixture.takes_ptr_u8", [p, ty(MirTypeKind.U8)], i64_t()), [copy(0), copy(1)], [arg(0, i64_t()), arg(1, ty(MirTypeKind.I32))])])
        expect(mir_verify_module(m).is_clean()).to_equal(true)

    it "warn-first: a Call through a closure aggregate is MIRV-004d (not fatal yet); fn-pointer and i64 handle callees are fine":
        val closure = ty(MirTypeKind.Tuple([ty(MirTypeKind.Ptr(ty(MirTypeKind.U8), false)), i64_t()]))
        val fnptr = ty(MirTypeKind.FuncPtr(MirSignature(params: [], return_type: i64_t(), is_variadic: false, params_known: true)))
        val bad = mk_module([caller(211, "fixture.call_closure", copy(0), [], [arg(0, closure)])])
        val report = mir_verify_module(bad)
        expect(has_rule(report, "MIRV-004d")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(mir_verify_rule_lifecycle("MIRV-004d")).to_equal("warning")
        val ok = mk_module([
            caller(212, "fixture.call_fnptr", copy(0), [], [arg(0, fnptr)]),
            caller(213, "fixture.call_handle", copy(0), [], [arg(0, i64_t())])
        ])
        expect(mir_verify_module(ok).is_clean()).to_equal(true)

    it "an extern / cross-module callee (not in this module) is not judged":
        val m = mk_module([caller(214, "fixture.calls_rt", callee_operand("rt_string_len", [i64_t()], i64_t()), [const_i64(1), const_i64(2)], [])])
        expect(mir_verify_module(m).is_clean()).to_equal(true)

describe "MIR verify: rule 7 — module-level symbol and static consistency":
    it "flags two functions with distinct symbols but one emitted name as MIRV-007 (warn-first)":
        val a = mk_fn(300, "fixture.walk.C", [], i64_t(), [], one_block([], Some(const_i64(0))))
        val b = mk_fn(301, "fixture.walk.C", [], i64_t(), [], one_block([], Some(const_i64(1))))
        val report = mir_verify_module(mk_module([a, b]))
        expect(has_rule(report, "MIRV-007")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)
        expect(first_message(report, "MIRV-007").contains("fixture.walk.C")).to_equal(true)

    it "warn-first: a static whose initializer type disagrees is MIRV-007b; agreeing and i64-handle initializers are clean":
        var module = mk_module([])
        var statics: Dict<SymbolId, MirStatic> = {}
        statics[SymbolId(id: 400)] = MirStatic(symbol: SymbolId(id: 400), name: "bad_init",
            type_: i64_t(),
            init: Some(MirConstant(symbol: SymbolId(id: 400), name: "bad_init", type_: ty(MirTypeKind.F64), value: MirConstValue.Float(1.5))),
            is_mutable: true)
        statics[SymbolId(id: 401)] = MirStatic(symbol: SymbolId(id: 401), name: "good_init",
            type_: i64_t(),
            init: Some(MirConstant(symbol: SymbolId(id: 401), name: "good_init", type_: ty(MirTypeKind.I32), value: MirConstValue.Int(1))),
            is_mutable: true)
        statics[SymbolId(id: 402)] = MirStatic(symbol: SymbolId(id: 402), name: "handle_init",
            type_: ty(MirTypeKind.Ptr(ty(MirTypeKind.U8), false)),
            init: Some(MirConstant(symbol: SymbolId(id: 402), name: "handle_init", type_: i64_t(), value: MirConstValue.Int(0))),
            is_mutable: false)
        module.statics = statics
        val report = mir_verify_module(module)
        expect(has_rule(report, "MIRV-007b")).to_equal(true)
        expect(report.findings.len()).to_equal(1)
        expect(first_message(report, "MIRV-007b").contains("bad_init")).to_equal(true)
        expect(report.fatal_count()).to_equal(0)

    it "flags two statics with one name as MIRV-007":
        var module = mk_module([])
        var statics: Dict<SymbolId, MirStatic> = {}
        statics[SymbolId(id: 410)] = MirStatic(symbol: SymbolId(id: 410), name: "dup", type_: i64_t(), init: nil, is_mutable: true)
        statics[SymbolId(id: 411)] = MirStatic(symbol: SymbolId(id: 411), name: "dup", type_: i64_t(), init: nil, is_mutable: true)
        module.statics = statics
        expect(has_rule(mir_verify_module(module), "MIRV-007")).to_equal(true)
