use std.spec.*
use compiler.mir.hwir.types.{CoreConfig, HwNodeId}
use compiler.mir.hwir.aspects.{HwAspectApplication, HwAspectManifest,
    HwAspectPlan, HwRetireObservation, hwir_aspect_lock_for_plan}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_product_composition.{HwScalarProductBinding,
    hwir_scalar_commit_retire_node_id,
    strict_riscv_scalar_product_composition,
    weave_hwir_scalar_commit_retire_observations_locked}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{compile_strict_riscv_scalar_product,
    compile_strict_riscv_scalar_product_with_retire_observations,
    scalar_product_driver_closure_diagnostic}

fn product(name: text, config: CoreConfig, instruction: u32):
    strict_riscv_scalar_product_composition(name, config, instruction,
        if config.xlen == 32: LsuConfig.rv32_product_default()
        else: LsuConfig.rv64_product_default())

fn m_config(xlen: i32) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: xlen, register_count: 32,
        profile: if xlen == 32: "riscv-gen2-rv32im" else: "riscv-gen2-rv64im",
        isa_profile: if xlen == 32: "rv32im" else: "rv64im",
        compressed_decode_profile: "none")

fn scalar_retire_manifest(port_count: i32) -> HwAspectManifest:
    HwAspectManifest(id: "debug.scalar.retire", version: "1.0.0",
        content_hash: "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
        stage: "Architecture", advice_kind: "observe", effect_class: "observational",
        required: true, required_capabilities: [], provided_capabilities: ["debug.scalar"],
        conflicts_with: [], join_point_selectors: ["commit.retire"],
        added_port_count: port_count, added_state_count: 0, latency_contract: "transparent",
        proof_obligations: ["architectural_noninterference"])

fn scalar_retire_plan(node_id: HwNodeId, port_count: i32) -> HwAspectPlan:
    HwAspectPlan(manifests: [scalar_retire_manifest(port_count)], applications: [
        HwAspectApplication(aspect_id: "debug.scalar.retire", matched_node_ids: [node_id],
            woven_node_count: port_count)])

describe "typed shared scalar product composition":
    it "selects one stateful M provider with a full held completion envelope":
        val multiply = product("scalar_mul", m_config(32), 0x022081B3)
        val divide = product("scalar_div", m_config(64), 0x0220C1B3)
        expect(multiply.is_ok()).to_equal(true)
        expect(divide.is_ok()).to_equal(true)
        if multiply.is_ok() and divide.is_ok():
            for composition in [multiply.ok().unwrap(), divide.ok().unwrap()]:
                expect(composition.provider_kind).to_equal("muldiv")
                expect(composition.muldiv_provider != nil).to_equal(true)
                expect(composition.provider == nil).to_equal(true)
                expect(composition.lsu_provider == nil).to_equal(true)
                expect(composition.completion_skid == nil).to_equal(true)
                expect(composition.top_port_direction("dispatch_valid")).to_equal("in")
                expect(composition.top_port_direction("in_ready")).to_equal("out")
                expect(composition.binding_diagnostic()).to_equal("")
                expect(composition.muldiv_provider.unwrap().ports.any(
                    _.name == "canonical_instruction" and _.direction == "out")).to_equal(true)

    it "weaves typed observations onto the scalar commit.retire receipt":
        val built = product("scalar_retire_aspect", CoreConfig.rv64_zca_mission_critical(),
            0x002081B3)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val composition = built.ok().unwrap()
            val node_id = hwir_scalar_commit_retire_node_id(composition)
            val plan = scalar_retire_plan(node_id, 2)
            val lock = hwir_aspect_lock_for_plan(plan)
            expect(lock.is_ok()).to_equal(true)
            if lock.is_ok():
                val valid = HwRetireObservation(aspect_id: "debug.scalar.retire",
                    target_node_id: node_id, receipt_value: "retire_valid",
                    output_port: "scalar_retire_valid", bit_width: 1)
                val order = HwRetireObservation(aspect_id: "debug.scalar.retire",
                    target_node_id: node_id, receipt_value: "retire_order",
                    output_port: "scalar_retire_order", bit_width: 64)
                val first = weave_hwir_scalar_commit_retire_observations_locked(
                    composition, plan, lock.ok().unwrap(), [valid, order])
                val second = weave_hwir_scalar_commit_retire_observations_locked(
                    composition, plan, lock.ok().unwrap(), [order, valid])
                expect(first.is_ok()).to_equal(true)
                expect(second.is_ok()).to_equal(true)
                if first.is_ok() and second.is_ok():
                    val woven = first.ok().unwrap()
                    expect(woven.route).to_equal("hwir-aspect-scalar-commit-retire-observe")
                    expect(woven.added_port_count).to_equal(2)
                    expect(woven.weave_sha256).to_equal(second.ok().unwrap().weave_sha256)
                    expect(woven.composition.structural_sha256()).to_equal(
                        second.ok().unwrap().composition.structural_sha256())
                    expect(woven.composition.top_ports.map(_.name)).to_equal(
                        second.ok().unwrap().composition.top_ports.map(_.name))
                    expect(woven.composition.top_port_direction("scalar_retire_valid")).to_equal("out")
                    expect(woven.composition.top_port_width("scalar_retire_order")).to_equal(64)
                    expect(woven.composition.retire_observations.len()).to_equal(2)
                    expect(woven.composition.aspect_lock_sha256).to_equal(woven.lock_sha256)
                    expect(woven.composition.aspect_weave_sha256).to_equal(woven.weave_sha256)
                    expect(woven.composition.diagnostic()).to_equal("")
                    expect(woven.composition.bindings.len()).to_equal(composition.bindings.len() + 2)
                    expect(woven.composition.retirement_owner.structural_sha256()).to_equal(
                        composition.retirement_owner.structural_sha256())
                val rendered = compile_strict_riscv_scalar_product_with_retire_observations(
                    "scalar_retire_aspect_rtl", CoreConfig.rv64_zca_mission_critical(),
                    0x002081B3, LsuConfig.rv64_product_default(), plan,
                    lock.ok().unwrap(), [valid, order])
                expect(rendered.is_success()).to_equal(true)
                if rendered.is_success():
                    expect(rendered.route).to_equal("hwir-gen2-scalar-product-aspect-v1")
                    expect(rendered.vhdl).to_contain("scalar_retire_valid : out std_logic")
                    expect(rendered.vhdl).to_contain("scalar_retire_order : out std_logic_vector(63 downto 0)")
                    expect(rendered.vhdl).to_contain(
                        "scalar_retire_valid <= source_retirement_owner_retire_valid")
                    expect(rendered.vhdl).to_contain("-- simple-hwir aspect-lock=")
                    expect(rendered.vhdl).to_contain("-- simple-hwir aspect-weave=")

    it "emits multiplier and divider children inside the scalar product closure":
        val multiply = compile_strict_riscv_scalar_product("scalar_mul_rtl",
            m_config(32), 0x022081B3, LsuConfig.rv32_product_default())
        val divide = compile_strict_riscv_scalar_product("scalar_div_rtl",
            m_config(64), 0x0220C1B3, LsuConfig.rv64_product_default())
        expect(multiply.is_success()).to_equal(true)
        expect(divide.is_success()).to_equal(true)
        if multiply.is_success() and divide.is_success():
            expect(multiply.route).to_equal("hwir-gen2-scalar-product-v2")
            expect(multiply.vhdl).to_contain("entity scalar_mul_rtl_provider is")
            expect(multiply.vhdl).to_contain("acc_reg <= acc_next")
            expect(divide.vhdl).to_contain("entity scalar_div_rtl_provider is")
            expect(divide.vhdl).to_contain("quotient_reg <= quotient_next")
            expect(divide.vhdl).to_contain("wire_provider_completion_ready <= source_acceptance_owner_provider_accept")

    it "rejects forged scalar retirement observation targets widths and top-port collisions":
        val built = product("scalar_retire_aspect_reject", CoreConfig.rv32_zca_mission_critical(),
            0x002081B3)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val composition = built.ok().unwrap()
            val node_id = hwir_scalar_commit_retire_node_id(composition)
            val plan = scalar_retire_plan(node_id, 1)
            val lock = hwir_aspect_lock_for_plan(plan)
            expect(lock.is_ok()).to_equal(true)
            if lock.is_ok():
                val wrong_width = HwRetireObservation(aspect_id: "debug.scalar.retire",
                    target_node_id: node_id, receipt_value: "retire_order",
                    output_port: "bad_width", bit_width: 32)
                val foreign = HwRetireObservation(aspect_id: "debug.scalar.retire",
                    target_node_id: HwNodeId.module_root("foreign"),
                    receipt_value: "retire_valid", output_port: "foreign_valid", bit_width: 1)
                val collision = HwRetireObservation(aspect_id: "debug.scalar.retire",
                    target_node_id: node_id, receipt_value: "retire_valid",
                    output_port: "PROTOCOL_FAULT", bit_width: 1)
                expect(weave_hwir_scalar_commit_retire_observations_locked(
                    composition, plan, lock.ok().unwrap(), [wrong_width]).is_err()).to_equal(true)
                expect(weave_hwir_scalar_commit_retire_observations_locked(
                    composition, plan, lock.ok().unwrap(), [foreign]).is_err()).to_equal(true)
                expect(weave_hwir_scalar_commit_retire_observations_locked(
                    composition, plan, lock.ok().unwrap(), [collision]).is_err()).to_equal(true)

    it "selects exactly one shared ALU provider and one retirement owner":
        val rv32 = product("scalar_add_rv32", CoreConfig.rv32_zca_mission_critical(),
            0x002081B3)
        val rv64 = product("scalar_add_rv64", CoreConfig.rv64_zca_mission_critical(),
            0x002081B3)
        expect(rv32.is_ok()).to_equal(true)
        expect(rv64.is_ok()).to_equal(true)
        if rv32.is_ok() and rv64.is_ok():
            val composition = rv32.ok().unwrap()
            expect(composition.diagnostic()).to_equal("")
            expect(composition.provider_kind).to_equal("alu")
            expect(composition.provider_count).to_equal(1)
            expect(composition.redirect_owner_count).to_equal(0)
            expect(composition.retirement_owner_count).to_equal(1)
            expect(composition.lsu_seam.enabled).to_equal(false)
            expect(composition.completion_skid != nil).to_equal(true)
            expect(composition.structural_sha256().len()).to_equal(64)
            expect(composition.fault_aggregator.port_direction("protocol_fault")).to_equal("out")
            expect(composition.structural_sha256() ==
                rv64.ok().unwrap().structural_sha256()).to_equal(false)

    it "routes a control provider through trap priority with one redirect owner":
        val built = product("scalar_beq", CoreConfig.rv64_zca_mission_critical(),
            0x00208463)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val composition = built.ok().unwrap()
            expect(composition.provider_kind).to_equal("control")
            expect(composition.redirect_owner_count).to_equal(1)
            var execute_to_trap = 0
            var trap_to_owner = 0
            var accepted_redirect_valid = 0
            var registered_redirect_target = 0
            for binding in composition.bindings:
                if binding.kind == "skid_to_trap" and
                    binding.destination_port.starts_with("execute_trap_"):
                    execute_to_trap = execute_to_trap + 1
                if binding.kind == "trap_to_owner": trap_to_owner = trap_to_owner + 1
                if binding.kind == "acceptance_to_composition" and
                    binding.source_port == "provider_accept" and binding.destination_port == "redirect_valid":
                    accepted_redirect_valid = accepted_redirect_valid + 1
                if binding.kind == "skid_to_composition" and
                    binding.source_port == "completion_redirect_target":
                    registered_redirect_target = registered_redirect_target + 1
            expect(execute_to_trap).to_equal(3)
            expect(trap_to_owner).to_equal(19)
            expect(accepted_redirect_valid).to_equal(1)
            expect(registered_redirect_target).to_equal(1)

    it "selects the LSU exclusively for memory rows and exposes typed handshakes":
        val built = product("scalar_load", CoreConfig.rv32_zca_mission_critical(),
            0x00012083)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val composition = built.ok().unwrap()
            expect(composition.provider_kind).to_equal("lsu")
            expect(composition.provider == nil).to_equal(true)
            expect(composition.lsu_provider != nil).to_equal(true)
            expect(composition.completion_skid == nil).to_equal(true)
            expect(composition.lsu_seam.enabled).to_equal(true)
            expect(composition.top_port_direction("memory_request_valid")).to_equal("out")
            expect(composition.top_port_direction("memory_request_ready")).to_equal("in")
            expect(composition.top_port_direction("memory_response_valid")).to_equal("in")
            expect(composition.top_port_direction("memory_response_ready")).to_equal("out")
            var completion_ready = 0
            var memory_faults = 0
            var response_ready = 0
            for binding in composition.bindings:
                if binding.destination_port == "completion_ready": completion_ready = completion_ready + 1
                if binding.source_owner == "provider" and binding.source_port == "response_ready" and
                    binding.destination_owner == "composition" and
                    binding.destination_port == "memory_response_ready": response_ready = response_ready + 1
                if binding.source_port == "memory_trap_valid" and binding.destination_port == "memory_trap_valid":
                    memory_faults = memory_faults + 1
            expect(completion_ready).to_equal(1)
            expect(response_ready).to_equal(1)
            expect(memory_faults).to_equal(1)
            var held_event_metadata = 0
            for binding in composition.bindings:
                if binding.source_owner == "provider" and binding.destination_owner == "acceptance_owner" and
                    (binding.source_port == "completion_event_id" or
                        binding.source_port == "completion_decode_event_id" or
                        binding.source_port == "completion_illegal_valid"):
                    held_event_metadata = held_event_metadata + 1
            expect(held_event_metadata).to_equal(3)

    it "closes memory geometry and provider selection into the product hash":
        val rv64 = CoreConfig.rv64_zca_mission_critical()
        val load = product("scalar_hash", rv64, 0x0000B083).unwrap()
        val store = product("scalar_hash", rv64, 0x0010B023).unwrap()
        val narrow_bus = strict_riscv_scalar_product_composition("scalar_hash", rv64,
            0x0000B083, LsuConfig.explicit(32, 4).unwrap()).unwrap()
        expect(load.structural_sha256().len()).to_equal(64)
        expect(load.structural_sha256() == store.structural_sha256()).to_equal(false)
        expect(load.structural_sha256() == narrow_bus.structural_sha256()).to_equal(false)

    it "detects duplicate ownership and any rewired retirement field":
        val built = product("scalar_contract", CoreConfig.rv32_zca_mission_critical(),
            0x002081B3)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val duplicate = built.ok().unwrap()
            duplicate.provider_count = 2
            expect(duplicate.diagnostic()).to_contain("one provider")
            val rewired = product("scalar_rewire", CoreConfig.rv32_zca_mission_critical(),
                0x002081B3).ok().unwrap()
            rewired.bindings[rewired.bindings.len() - 1] = HwScalarProductBinding(
                kind: "trap_to_owner", source_owner: "trap", source_port: "dispatch_tval",
                destination_owner: "retirement_owner", destination_port: "dispatch_cause",
                bit_width: 32)
            expect(rewired.binding_diagnostic()).to_contain("exact provider")

    it "rejects duplicate destinations and wrong typed LSU endpoints":
        val duplicate = product("scalar_duplicate", CoreConfig.rv64_zca_mission_critical(),
            0x0000B083).unwrap()
        duplicate.bindings[1] = duplicate.bindings[0]
        expect(duplicate.binding_diagnostic()).to_contain("exact unique typed wiring")
        val wrong_width = product("scalar_width", CoreConfig.rv64_zca_mission_critical(),
            0x0000B083).unwrap()
        var index = 0
        while wrong_width.bindings[index].destination_port != "response_data": index = index + 1
        wrong_width.bindings[index].bit_width = 32
        expect(wrong_width.binding_diagnostic()).to_contain("exact unique typed wiring")

    it "binds every normalized record field once and excludes projected order":
        val composition = product("scalar_mapping", CoreConfig.rv64_zca_mission_critical(),
            0x002081B3).ok().unwrap()
        var dispatch_order_bindings = 0
        var dispatch_tval_bindings = 0
        for binding in composition.bindings:
            if binding.destination_port == "dispatch_order":
                dispatch_order_bindings = dispatch_order_bindings + 1
            if binding.kind == "trap_to_owner" and binding.destination_port == "dispatch_tval":
                dispatch_tval_bindings = dispatch_tval_bindings + 1
        expect(dispatch_order_bindings).to_equal(0)
        expect(dispatch_tval_bindings).to_equal(1)

    it "closes execution inputs through accepted valid-ready flow":
        val composition = product("scalar_executable", CoreConfig.rv64_zca_mission_critical(),
            0x002081B3).unwrap()
        expect(composition.top_port_direction("in_valid")).to_equal("in")
        expect(composition.top_port_direction("in_ready")).to_equal("out")
        expect(composition.top_port_direction("in_pc")).to_equal("in")
        expect(composition.top_port_width("rs1_value")).to_equal(64)
        expect(composition.top_port_width("rs2_value")).to_equal(64)
        var accepted_valid = 0
        var owner_ready = 0
        var skid_ready = 0
        for binding in composition.bindings:
            if (binding.source_owner == "acceptance_owner" and
                binding.source_port == "normalized_accept" and
                binding.destination_owner == "trap"): accepted_valid = accepted_valid + 1
            if (binding.source_owner == "retirement_owner" and
                binding.source_port == "dispatch_ready" and
                binding.destination_port == "normalized_ready"): owner_ready = owner_ready + 1
            if binding.source_owner == "completion_skid" and binding.source_port == "upstream_ready" and
                binding.destination_owner == "composition" and binding.destination_port == "in_ready": skid_ready = skid_ready + 1
        expect(accepted_valid).to_equal(1)
        expect(owner_ready).to_equal(1)
        expect(skid_ready).to_equal(1)
        var registered_metadata = 0
        for binding in composition.bindings:
            if binding.source_owner == "completion_skid" and binding.destination_owner == "acceptance_owner" and
                (binding.destination_port == "provider_event_id" or binding.destination_port == "decode_event_id" or
                    binding.destination_port == "illegal_valid"):
                registered_metadata = registered_metadata + 1
        expect(registered_metadata).to_equal(3)

    it "uses real control exception ports and exports only owner retirement results":
        val composition = product("scalar_control_closed", CoreConfig.rv64_zca_mission_critical(),
            0x00208463).unwrap()
        var exception_valid = 0
        var exception_cause = 0
        var exception_tval = 0
        var retirement_outputs = 0
        for binding in composition.bindings:
            if binding.source_port == "execute_exception": exception_valid = exception_valid + 1
            val is_exception_cause = binding.source_port == "retire_cause" and binding.destination_port == "execute_trap_cause"
            if is_exception_cause: exception_cause = exception_cause + 1
            val is_exception_tval = binding.source_port == "retire_tval" and binding.destination_port == "execute_trap_tval"
            if is_exception_tval: exception_tval = exception_tval + 1
            if binding.kind == "owner_to_composition": retirement_outputs = retirement_outputs + 1
            expect(binding.source_port.starts_with("execute_exception_")).to_equal(false)
        expect(exception_valid).to_equal(1)
        expect(exception_cause).to_equal(1)
        expect(exception_tval).to_equal(1)
        expect(retirement_outputs).to_equal(23)
        expect(composition.top_port_direction("retire_valid")).to_equal("out")

    it "emits an executable ALU top with acceptance and retirement owners":
        val emitted = compile_strict_riscv_scalar_product("scalar_exec_rtl",
            CoreConfig.rv32_zca_mission_critical(), 0x002081B3,
            LsuConfig.rv32_product_default())
        expect(emitted.is_success()).to_equal(true)
        if emitted.is_success():
            expect(emitted.vhdl).to_contain("in_valid : in std_logic")
            expect(emitted.vhdl).to_contain("in_ready : out std_logic")
            expect(emitted.vhdl).to_contain("acceptance_owner: entity work")
            expect(emitted.vhdl).to_contain("completion_skid: entity work")
            expect(emitted.vhdl).to_contain("retirement_owner: entity work")
            expect(emitted.vhdl).to_contain("fault_aggregator: entity work")
            expect(emitted.vhdl).to_contain("arbitration_fault=>source_acceptance_owner_arbitration_fault")
            expect(emitted.vhdl).to_contain("protocol_fault=>source_fault_aggregator_protocol_fault")
            expect(emitted.vhdl).to_contain("in_ready <= source_completion_skid_upstream_ready;")
            expect(emitted.vhdl).to_contain("wire_fault_aggregator_acceptance_fault <= source_acceptance_owner_arbitration_fault;")

    it "renders one canonical child source with explicit fanout assignments":
        val composition = product("scalar_driver_closure",
            CoreConfig.rv32_zca_mission_critical(), 0x002081B3).unwrap()
        expect(scalar_product_driver_closure_diagnostic(composition)).to_equal("")
        val emitted = compile_strict_riscv_scalar_product("scalar_driver_closure",
            CoreConfig.rv32_zca_mission_critical(), 0x002081B3,
            LsuConfig.rv32_product_default()).vhdl
        expect(emitted).to_contain("signal source_completion_skid_completion_valid : std_logic;")
        expect(emitted).to_contain("wire_acceptance_owner_provider_valid <= source_completion_skid_completion_valid;")
        expect(emitted).to_contain("wire_trap_in_valid <= source_acceptance_owner_normalized_accept;")
        expect(emitted).to_contain("wire_provider_in_valid <= in_valid;")
        val broken = product("scalar_driver_duplicate",
            CoreConfig.rv32_zca_mission_critical(), 0x002081B3).unwrap()
        broken.bindings[1] = broken.bindings[0]
        expect(scalar_product_driver_closure_diagnostic(broken)).to_contain("exactly one concurrent driver")

    it "emits the exact LSU access projection before its stateful owner":
        val emitted = compile_strict_riscv_scalar_product("scalar_ld_rtl",
            CoreConfig.rv64_zca_mission_critical(), 0x0000B083,
            LsuConfig.rv64_product_default())
        expect(emitted.is_success()).to_equal(true)
        if emitted.is_success():
            val child_at = emitted.vhdl.index_of("entity scalar_ld_rtl_provider_access_projection")
            val owner_at = emitted.vhdl.index_of("entity scalar_ld_rtl_provider is")
            expect(child_at >= 0).to_equal(true)
            expect(owner_at > child_at).to_equal(true)
            expect(emitted.vhdl).to_contain("child: entity work.scalar_ld_rtl_provider_access_projection")
