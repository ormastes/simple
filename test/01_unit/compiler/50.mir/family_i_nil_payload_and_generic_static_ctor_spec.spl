# @req REQ-SSPEC-COMPILER
"""
# nil payload arms and methods on generic-static-constructed structs

Bugs:
- nil_payload_pattern_on_non_optional_slot_2026-11-05 -- `Some(nil)` /
  `Ok(nil)` / `Err(nil)` over a NON-optional payload slot. Policy: nil is only
  the `T?` absence literal, so such an arm can never match. HIR now rejects it
  with a named diagnostic instead of the generic MIR "nil sub-pattern requires
  a declared optional payload slot" (and the seed JIT, which silently TOOK the
  arm for `Some(4)`). Arms over a proven `T?` slot keep lowering cleanly.
- mir_generic_static_ctor_result_method_unresolved_2026-11-05 -- `val b =
  Box.of(4); b.get()` on a generic struct failed MIR with "unresolved method
  call: get ... owner=" because the StaticMethod arm never recorded the
  result's struct identity (a generic `Box<T>` has no concrete layout).
"""

# @tag: unit, compiler, mir, hir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn fi_lower(src: text) -> text:
    val file = "testdata/fixture_family_i.spl"
    val parsed = parse_full_frontend(src, file, "fixture_family_i", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    val target_context = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target_context)
    val mir = lowering.lower_module(hir)
    var out = ""
    for e in hir_lowering.errors:
        out = out + "HIR: " + e.message + "\n"
    for e in lowering.errors:
        out = out + "MIR: " + e.message + "\n"
    out

val box_src = "struct Box<T>:\n    v: T\n\nimpl Box<T>:\n    fn get() -> T:\n        self.v\n    static fn of(v: T) -> Box<T>:\n        Box(v: v)\n\n"

describe "nil payload arms":
    it "accepts Err(nil) over Result<i64, text?>":
        expect(fi_lower("fn f(r: Result<i64, text?>) -> i64:\n    match r:\n        case Ok(v): v\n        case Err(nil): 0\n        case Err(e): 1\n")).to_equal("")

    it "accepts Ok(nil) over Result<i64?, text>":
        expect(fi_lower("fn f(r: Result<i64?, text>) -> i64:\n    match r:\n        case Ok(nil): 0\n        case Ok(v): 1\n        case Err(e): 2\n")).to_equal("")

    it "accepts a nil arm in a user enum optional payload":
        expect(fi_lower("enum E:\n    A(i64?)\n    B\n\nfn f(e: E) -> i64:\n    match e:\n        case A(nil): 0\n        case A(v): 1\n        case B: 2\n")).to_equal("")

    it "accepts Err(nil) over a call result":
        expect(fi_lower("fn g() -> Result<i64, text?>:\n    Err(nil)\n\nfn f() -> i64:\n    match g():\n        case Err(nil): 0\n        case Err(e): 1\n        case Ok(v): v\n")).to_equal("")

    it "rejects Some(nil) over i64? with the policy diagnostic":
        val out = fi_lower("fn f(o: i64?) -> i64:\n    match o:\n        case Some(nil): 0\n        case Some(v): v\n        case nil: 2\n")
        expect(out.contains("HIR: `Some(nil)` can never match")).to_equal(true)

    it "rejects Ok(nil) over a non-optional Ok slot":
        val out = fi_lower("fn f(r: Result<i64, text>) -> i64:\n    match r:\n        case Ok(nil): 0\n        case Ok(v): v\n        case Err(e): 2\n")
        expect(out.contains("HIR: `Ok(nil)` can never match")).to_equal(true)

    it "rejects Err(nil) over a non-optional struct Err slot":
        val out = fi_lower("struct Bad:\n    code: i64\n\nfn f(r: Result<i64, Bad>) -> i64:\n    match r:\n        case Ok(v): v\n        case Err(nil): 0\n        case Err(e): 1\n")
        expect(out.contains("HIR: `Err(nil)` can never match")).to_equal(true)

describe "methods on struct instances":
    it "resolves a method on a generic static-constructor result":
        expect(fi_lower(box_src + "fn f() -> i64:\n    val b = Box.of(4)\n    b.get()\n")).to_equal("")

    it "resolves a method on a chained generic static-constructor call":
        expect(fi_lower(box_src + "fn f() -> i64:\n    Box.of(4).get()\n")).to_equal("")

    it "resolves a field read on a generic static-constructor result":
        expect(fi_lower(box_src + "fn f() -> i64:\n    val b = Box.of(4)\n    b.v\n")).to_equal("")

    it "keeps annotated and constructor-literal generic receivers working":
        expect(fi_lower(box_src + "fn f() -> i64:\n    val c: Box<i64> = Box(v: 2)\n    val d = Box(v: 3)\n    c.get() + d.get()\n")).to_equal("")

    it "keeps non-generic static, array element, field and loop receivers working":
        val src = "struct P:\n    x: i64\n\nimpl P:\n    fn get() -> i64:\n        self.x\n    static fn make(x: i64) -> P:\n        P(x: x)\n\nstruct W:\n    p: P\n\nfn f(ps: [P], w: W, o: P?) -> i64:\n    var s = P.make(1).get() + ps[0].get() + w.p.get()\n    for p in ps:\n        s = s + p.get()\n    if val q = o:\n        s = s + q.get()\n    s\n"
        expect(fi_lower(src)).to_equal("")
