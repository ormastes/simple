# @req REQ-SSPEC-COMPILER
# @tag: unit, compiler, mir

use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir.*

fn lower_two_modules(def_path: text, def_mod: text, def_src: text, main_path: text, main_mod: text, main_src: text) -> (MirModule, [text]):
    val log = Logger(level: 0)
    val def_ast = parse_full_frontend(def_src, def_path, def_mod, log)
    val main_ast = parse_full_frontend(main_src, main_path, main_mod, log)
    var modules: Dict<text, Module> = {}
    modules[def_mod] = def_ast
    modules[main_mod] = main_ast
    val sources = [
        SourceFile(path: def_path, content: def_src, module_name: def_mod),
        SourceFile(path: main_path, content: main_src, module_name: main_mod)
    ]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var def_hl = hirlowering_for_module(def_mod, surfaces)
    var main_hl = hirlowering_for_module(main_mod, surfaces)
    val def_hir = def_hl.lower_module(def_ast)
    val main_hir = main_hl.lower_module(main_ast)
    var errs: [text] = []
    for e in def_hl.errors:
        errs.push("hir-def: " + e.message)
    for e in main_hl.errors:
        errs.push("hir-main: " + e.message)
    var ml = MirLowering.new_for_target(main_hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    var prescan: Dict<text, HirModule> = {}
    prescan[def_mod] = def_hir
    prescan[main_mod] = main_hir
    ml.prescan_module_struct_names(prescan, def_mod)
    ml.prescan_module_struct_names(prescan, main_mod)
    val mir = ml.lower_module(main_hir, [def_hir, main_hir])
    for e in ml.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        errs.push(e.message)
    (mir, errs)

fn has_143_error(errs: [text]) -> bool:
    for e in errs:
        if e.contains("for-in over non-array"):
            return true
    false

fn fn_has_array_local(mir: MirModule, fn_name: text) -> bool:
    for fn_val in mir.functions.values():
        if fn_val.name == fn_name or fn_val.name.ends_with("." + fn_name):
            for loc in fn_val.locals:
                var is_arg = false
                match loc.kind:
                    case LocalKind.Arg(_): is_arg = true
                    case _: ()
                if not is_arg:
                    match loc.type_.kind:
                        case MirTypeKind.Array(_, _) | MirTypeKind.Slice(_):
                            return true
                        case _: ()
    false

fn fn_calls_rt_helper(mir: MirModule, fn_name: text, target: text) -> bool:
    for fn_val in mir.functions.values():
        if fn_val.name == fn_name or fn_val.name.ends_with("." + fn_name):
            for blk in fn_val.blocks:
                for inst in blk.instructions:
                    match inst.kind:
                        case MirInstKind.Call(_, func, _):
                            match func.kind:
                                case MirOperandKind.Const(MirConstValue.Str(cname), _):
                                    if cname == target:
                                        return true
                                case _: ()
                        case _: ()
    false

fn fn_has_143_panic(mir: MirModule, fn_name: text) -> bool:
    for fn_val in mir.functions.values():
        if fn_val.name == fn_name or fn_val.name.ends_with("." + fn_name):
            for blk in fn_val.blocks:
                for inst in blk.instructions:
                    match inst.kind:
                        case MirInstKind.Call(_, func, args):
                            match func.kind:
                                case MirOperandKind.Const(MirConstValue.Str(cname), _):
                                    if cname == "rt_panic" and args.len() > 0:
                                        match args[0].kind:
                                            case MirOperandKind.Const(MirConstValue.Str(msg), _):
                                                if msg.contains("for-in over non-array"):
                                                    return true
                                            case _: ()
                                case _: ()
                        case _: ()
    false

fn mir_ty_label(ty: MirType) -> text:
    match ty.kind:
        case MirTypeKind.I64: "i64"
        case MirTypeKind.Bool: "bool"
        case MirTypeKind.Array(_, _): "arr"
        case MirTypeKind.Slice(_): "slice"
        case MirTypeKind.Struct(_): "struct"
        case MirTypeKind.Enum(_): "enum"
        case _: "other"

fn debug_dump_locals(mir: MirModule, fn_name: text) -> text:
    var out = ""
    for fn_val in mir.functions.values():
        if fn_val.name == fn_name or fn_val.name.ends_with("." + fn_name):
            for loc in fn_val.locals:
                val nm = loc.name ?? "<tmp>"
                out = out + nm + "=" + mir_ty_label(loc.type_) + " "
    out

fn check_indexed_for(mir: MirModule, fn_name: text, require_array_local: bool):
    val has_len = fn_calls_rt_helper(mir, fn_name, "rt_array_len")
    val has_get = fn_calls_rt_helper(mir, fn_name, "rt_array_get")
    val has_143_panic = fn_has_143_panic(mir, fn_name)
    val has_arr = fn_has_array_local(mir, fn_name)
    if not has_len or not has_get or has_143_panic or (require_array_local and not has_arr):
        print "FAILED_MIR_CHECK {fn_name}: len={has_len} get={has_get} p143={has_143_panic} arr={has_arr} locals=[{debug_dump_locals(mir, fn_name)}]"
    expect(has_len).to_equal(true)
    expect(has_get).to_equal(true)
    expect(has_143_panic).to_equal(false)
    if require_array_local:
        expect(has_arr).to_equal(true)

fn make_item_struct_symbols() -> (SymbolTable, SymbolId, SymbolId):
    var st = SymbolTable.new()
    val sp = Span.empty()
    val ty = HirType(kind: HirTypeKind.Unit, span: sp)
    val sym_a = st.define("Item", SymbolKind.Struct, Some(ty), sp, Visibility.Public, false, Some("src/lib/items.spl"))
    val sym_b = st.define("Item", SymbolKind.Struct, Some(ty), sp, Visibility.Public, false, Some("lib.items"))
    (st, sym_a, sym_b)

val pos_defs_src =
    "pub struct CallArg:\n" +
    "    has_name: bool\n" +
    "    v: i64\n\n" +
    "pub enum ExprKind:\n" +
    "    IntLit(i64)\n" +
    "    Call(text, [CallArg])\n" +
    "    MethodCall(text, text, [CallArg])\n\n" +
    "pub struct Expr:\n" +
    "    kind: ExprKind\n\n" +
    "pub struct Effect:\n" +
    "    id: i64\n\n" +
    "pub enum HirTypeKind:\n" +
    "    Unit\n" +
    "    Function(params: [HirType], ret: HirType, effects: [Effect])\n\n" +
    "pub struct HirType:\n" +
    "    kind: HirTypeKind\n\n" +
    "pub enum HirEnumPayload:\n" +
    "    Tuple(values: [HirExpr])\n" +
    "    Struct(fields: [(text, HirExpr)])\n\n" +
    "pub enum HirExprKind:\n" +
    "    UnitLit\n" +
    "    StructLit(i64, [(text, HirExpr)])\n" +
    "    EnumLit(i64, i64, HirEnumPayload?)\n\n" +
    "pub struct HirExpr:\n" +
    "    id: i64\n" +
    "    kind: HirExprKind\n"

val pos_main_src =
    "use lib.pos_defs.*\n\n" +
    "fn case1_convert_nodes_shape(later_call: Expr) -> i64:\n" +
    "    val later_args = match later_call.kind:\n" +
    "        case ExprKind.MethodCall(_, _, args): args\n" +
    "        case ExprKind.Call(_, args): args\n" +
    "        case _: []\n" +
    "    var total = 0\n" +
    "    for a in later_args:\n" +
    "        if a.has_name:\n" +
    "            total = total + a.v\n" +
    "    total\n\n" +
    "fn case2_convert_nodes_annotated(later_call: Expr) -> i64:\n" +
    "    val later_args: [CallArg] = match later_call.kind:\n" +
    "        case ExprKind.MethodCall(_, _, args): args\n" +
    "        case ExprKind.Call(_, args): args\n" +
    "        case _: []\n" +
    "    var total = 0\n" +
    "    for a in later_args:\n" +
    "        total = total + a.v\n" +
    "    total\n\n" +
    "fn case3_empty_first_enum(later_call: Expr) -> i64:\n" +
    "    val later_args = match later_call.kind:\n" +
    "        case ExprKind.IntLit(_): []\n" +
    "        case ExprKind.MethodCall(_, _, args): args\n" +
    "        case ExprKind.Call(_, args): args\n" +
    "    var total = 0\n" +
    "    for a in later_args:\n" +
    "        total = total + a.v\n" +
    "    total\n\n" +
    "fn case4_inference_calls_shape(resolved_callee: HirType) -> i64:\n" +
    "    val callee_effects = match resolved_callee.kind:\n" +
    "        case HirTypeKind.Function(_, _, effects): effects\n" +
    "        case _: []\n" +
    "    var total = 0\n" +
    "    for eff in callee_effects:\n" +
    "        total = total + eff.id\n" +
    "    total\n\n" +
    "fn case5_inference_calls_annotated(resolved_callee: HirType) -> i64:\n" +
    "    val callee_effects: [Effect] = match resolved_callee.kind:\n" +
    "        case HirTypeKind.Function(_, _, effects): effects\n" +
    "        case _: []\n" +
    "    var total = 0\n" +
    "    for eff in callee_effects:\n" +
    "        total = total + eff.id\n" +
    "    total\n\n" +
    "fn case6_rt_criticality_nested(expr: HirExpr) -> bool:\n" +
    "    match expr.kind:\n" +
    "        case HirExprKind.StructLit(_, fields):\n" +
    "            val struct_fields: [(text, HirExpr)] = fields\n" +
    "            for field in struct_fields:\n" +
    "                if case6_rt_criticality_nested(field[1]): return true\n" +
    "            false\n" +
    "        case HirExprKind.EnumLit(_, _, payload):\n" +
    "            match payload:\n" +
    "                Some(HirEnumPayload.Tuple(values)):\n" +
    "                    val payload_values: [HirExpr] = values\n" +
    "                    for value in payload_values:\n" +
    "                        if case6_rt_criticality_nested(value): return true\n" +
    "                    false\n" +
    "                Some(HirEnumPayload.Struct(fields)):\n" +
    "                    val payload_fields: [(text, HirExpr)] = fields\n" +
    "                    for field in payload_fields:\n" +
    "                        if case6_rt_criticality_nested(field[1]): return true\n" +
    "                    false\n" +
    "                None: false\n" +
    "        case _:\n" +
    "            false\n\n" +
    "fn case6b_rt_criticality_unannotated(expr: HirExpr) -> bool:\n" +
    "    match expr.kind:\n" +
    "        case HirExprKind.EnumLit(_, _, payload):\n" +
    "            match payload:\n" +
    "                Some(HirEnumPayload.Tuple(values)):\n" +
    "                    for value in values:\n" +
    "                        if case6b_rt_criticality_unannotated(value): return true\n" +
    "                    false\n" +
    "                Some(HirEnumPayload.Struct(fields)):\n" +
    "                    for field in fields:\n" +
    "                        if case6b_rt_criticality_unannotated(field[1]): return true\n" +
    "                    false\n" +
    "                None: false\n" +
    "        case _:\n" +
    "            false\n\n" +
    "fn case7_int_match_dense_switch(n: i64, items: [CallArg]) -> i64:\n" +
    "    val picked = match n:\n" +
    "        case 0: []\n" +
    "        case 1: items\n" +
    "        case 2: items\n" +
    "        case 3: []\n" +
    "        case _: items\n" +
    "    var total = 0\n" +
    "    for a in picked:\n" +
    "        total = total + a.v\n" +
    "    total\n\n" +
    "fn case8_int_match_if_chain(n: i64, items: [CallArg]) -> i64:\n" +
    "    val picked = match n:\n" +
    "        case 1: items\n" +
    "        case 5000: []\n" +
    "        case _: []\n" +
    "    var total = 0\n" +
    "    for a in picked:\n" +
    "        total = total + a.v\n" +
    "    total\n\n" +
    "fn case9_text_match(tag: text, items: [CallArg]) -> i64:\n" +
    "    val picked = match tag:\n" +
    "        case \"empty\": []\n" +
    "        case \"some\": items\n" +
    "        case _: items\n" +
    "    var total = 0\n" +
    "    for a in picked:\n" +
    "        total = total + a.v\n" +
    "    total\n"

val neg_defs_src =
    "pub enum MixedVal:\n" +
    "    Numbers([i64])\n" +
    "    Words([text])\n" +
    "    Scalar(i64)\n"

val neg_div_src =
    "use lib.neg_defs.*\n\n" +
    "fn bad_divergent(v: MixedVal) -> i64:\n" +
    "    val xs = match v:\n" +
    "        case MixedVal.Numbers(items): items\n" +
    "        case MixedVal.Words(items): items\n" +
    "        case MixedVal.Scalar(_): []\n" +
    "    var count = 0\n" +
    "    for x in xs:\n" +
    "        count = count + 1\n" +
    "    count\n"

val neg_scalar_src =
    "use lib.neg_defs.*\n\n" +
    "fn bad_scalar_vs_empty(n: i64) -> i64:\n" +
    "    val xs = match n:\n" +
    "        case 0: 42\n" +
    "        case _: []\n" +
    "    var count = 0\n" +
    "    for x in xs:\n" +
    "        count = count + 1\n" +
    "    count\n"

describe "MIR match-bound arrays and enum tuple binders (#143)":
    it "lowers match-bound arrays across enum, switch, if-chain, text, and nested Option tuple binders without #143":
        val (mir, errs) = lower_two_modules("lib/pos_defs.spl", "lib.pos_defs", pos_defs_src, "app/pos_main.spl", "app.pos_main", pos_main_src)
        expect(errs.len()).to_equal(0)
        check_indexed_for(mir, "case1_convert_nodes_shape", true)
        check_indexed_for(mir, "case2_convert_nodes_annotated", true)
        check_indexed_for(mir, "case3_empty_first_enum", true)
        check_indexed_for(mir, "case4_inference_calls_shape", true)
        check_indexed_for(mir, "case5_inference_calls_annotated", true)
        check_indexed_for(mir, "case6_rt_criticality_nested", true)
        check_indexed_for(mir, "case6b_rt_criticality_unannotated", false)
        check_indexed_for(mir, "case7_int_match_dense_switch", true)
        check_indexed_for(mir, "case8_int_match_if_chain", true)
        check_indexed_for(mir, "case9_text_match", true)

    it "still rejects divergent array element arms paired with empty arm (#143)":
        val (mir, errs) = lower_two_modules("lib/neg_defs1.spl", "lib.neg_defs", neg_defs_src, "app/neg_div.spl", "app.neg_div", neg_div_src)
        expect(has_143_error(errs)).to_equal(true)
        expect(fn_calls_rt_helper(mir, "bad_divergent", "rt_panic")).to_equal(true)
        expect(fn_calls_rt_helper(mir, "bad_divergent", "rt_array_get")).to_equal(false)

    it "still rejects scalar arm paired with empty arm in int match (#143)":
        val (mir, errs) = lower_two_modules("lib/neg_defs2.spl", "lib.neg_defs", neg_defs_src, "app/neg_scalar.spl", "app.neg_scalar", neg_scalar_src)
        expect(has_143_error(errs)).to_equal(true)
        expect(fn_calls_rt_helper(mir, "bad_scalar_vs_empty", "rt_panic")).to_equal(true)
        expect(fn_calls_rt_helper(mir, "bad_scalar_vs_empty", "rt_array_get")).to_equal(false)

    it "merges cross-module nominal array aliases and empty arms while upgrading erased I64 merge slot":
        val (st, sym_a, sym_b) = make_item_struct_symbols()
        var ml = MirLowering.new_for_target(st, driver_mir_target_context(driver_core_compile_options_default()))
        val sig_i64 = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
        ml.builder.begin_function(SymbolId(id: 1), "merge_alias", sig_i64, Span.empty())
        val sp = Span.empty()
        val arm0 = ml.builder.new_temp(MirType.i64())
        val arm1 = ml.builder.new_temp(MirType.i64())
        val arm2 = ml.builder.new_temp(MirType(kind: MirTypeKind.Array(MirType.i64(), 0)))
        val dest = ml.builder.new_temp(MirType.i64())
        ml.remember_local_hir_type(arm0.id, HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Named(sym_a, []), span: sp), None), span: sp), 0, 0)
        ml.remember_local_hir_type(arm1.id, HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Named(sym_b, []), span: sp), None), span: sp), 0, 0)
        ml.empty_array_lit_locals[arm2.id] = true
        ml.join_untyped_optional_arms(dest, [arm0, arm1, arm2])
        expect(ml.find_local_hir_type(dest.id) != None).to_equal(true)
        expect(ml.local_is_runtime_array(dest)).to_equal(true)
        val dest_ty = ml.local_mir_type_of(dest) ?? MirType.i64()
        var upgraded_to_array = false
        match dest_ty.kind:
            case MirTypeKind.Array(_, _): upgraded_to_array = true
            case _: ()
        expect(upgraded_to_array).to_equal(true)

    it "recovers unambiguous Struct array type from MIR slot when arm HIR type is absent":
        val (st, sym_a, _sym_b) = make_item_struct_symbols()
        var ml = MirLowering.new_for_target(st, driver_mir_target_context(driver_core_compile_options_default()))
        val sig_i64 = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
        ml.builder.begin_function(SymbolId(id: 1), "merge_mir_struct", sig_i64, Span.empty())
        val arm0 = ml.builder.new_temp(MirType(kind: MirTypeKind.Array(MirType(kind: MirTypeKind.Struct(sym_a)), 0)))
        val arm1 = ml.builder.new_temp(MirType(kind: MirTypeKind.Array(MirType.i64(), 0)))
        val dest = ml.builder.new_temp(MirType.i64())
        ml.empty_array_lit_locals[arm1.id] = true
        ml.remember_merged_arm_identity(dest, [arm0, arm1], false)
        expect(ml.find_local_hir_type(dest.id) != None).to_equal(true)
        expect(ml.local_is_runtime_array(dest)).to_equal(true)

    it "refuses joining erased Array(I64) without HIR type against [text] and refuses F64 arms":
        val st = SymbolTable.new()
        var ml = MirLowering.new_for_target(st, driver_mir_target_context(driver_core_compile_options_default()))
        val sig_i64 = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
        ml.builder.begin_function(SymbolId(id: 1), "neg_direct", sig_i64, Span.empty())
        val sp = Span.empty()
        val arm_text = ml.builder.new_temp(MirType.i64())
        ml.remember_local_hir_type(arm_text.id, HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Str, span: sp), None), span: sp), 0, 0)
        val arm_erased = ml.builder.new_temp(MirType(kind: MirTypeKind.Array(MirType.i64(), 0)))
        val dest1 = ml.builder.new_temp(MirType.i64())
        ml.remember_merged_arm_identity(dest1, [arm_text, arm_erased], false)
        expect(ml.find_local_hir_type(dest1.id) == None).to_equal(true)

        val arm_float = ml.builder.new_temp(MirType.f64())
        ml.remember_local_hir_type(arm_float.id, HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Str, span: sp), None), span: sp), 0, 0)
        val dest2 = ml.builder.new_temp(MirType.f64())
        ml.remember_merged_arm_identity(dest2, [arm_float], false)
        expect(ml.local_is_runtime_array(dest2)).to_equal(false)

    it "recovers declared local_map array type when Var iterable carries an Infer placeholder":
        var st = SymbolTable.new()
        val sp = Span.empty()
        val str_arr_hir = HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Str, span: sp), None), span: sp)
        val infer_hir = HirType(kind: HirTypeKind.Infer(0, 0), span: sp)
        val xs_sym = st.define("xs", SymbolKind.Variable, Some(infer_hir), sp, Visibility.Private, false, Some("test.spl"))
        var ml = MirLowering.new_for_target(st, driver_mir_target_context(driver_core_compile_options_default()))
        val sig_unit = MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)
        ml.builder.begin_function(SymbolId(id: 1), "iter_infer", sig_unit, Span.empty())
        val bound_loc = ml.builder.new_temp(MirType.i64())
        val copy_loc = ml.builder.new_temp(MirType.i64())
        ml.local_map[xs_sym.id] = bound_loc
        ml.remember_local_hir_type(bound_loc.id, str_arr_hir, 0, 0)
        val iter_expr = HirExpr(kind: HirExprKind.Var(xs_sym), has_type_: true, type_: infer_hir, span: sp)
        val recovered = ml.for_collection_declared_type(copy_loc, iter_expr)
        expect(recovered != None).to_equal(true)
