# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
"""
# MIR: enum-typed module globals get a store target

A module `var G: E = E.Variant` initializer (an enum unit-variant value)
matches no arm of `runtime_module_initializer_supported`, and the type
fallback has no nominal-type case, so `lower_static` emits no static and every
`G = E.Other` in a function aborts with "assignment target has no local
binding" (stage2 run 15, lib.nogc_sync_mut.gpu.engine2d.simd_kernels
`_cached_simd_level`, 6 fatals).
"""

use std.spec
use std.io_runtime.{env_get, env_set}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserModule}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.mir.mir.*

val enum_src = "enum Level:\n    None_\n    Low\n    High\n\nvar CACHED: Level = Level.None_\n\nfn put(n: i64):\n    if n > 3:\n        CACHED = Level.High\n    else:\n        CACHED = Level.Low\n"
val unbound_src = "fn bad():\n    missing_name = 1\n"

fn bootstrap_lower_errors(src: text) -> i64:
    val log = Logger(level: 0)
    var modules: Dict<text, ParserModule> = {}
    var sources: [SourceFile] = []
    modules["app.level"] = parse_full_frontend(src, "app/level.spl", "app.level", log)
    sources.push(SourceFile(path: "app/level.spl", content: src, module_name: "app.level"))
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var hir_lowering = hirlowering_for_module("app/level.spl", surfaces)
    val hir = hir_lowering.lower_module(modules["app.level"])
    val providers: [HirModule] = []
    val old_bootstrap = env_get("SIMPLE_BOOTSTRAP")
    env_set("SIMPLE_BOOTSTRAP", "1")
    val target = driver_mir_target_context(driver_core_compile_options_default())
    var lowering = MirLowering.new_for_target(hir.symbols, target)
    lowering.register_module_enum_bootstrap_inventory_v1([hir])
    val mir = lowering.lower_bootstrap_closure_module(hir, providers)
    env_set("SIMPLE_BOOTSTRAP", old_bootstrap)
    lowering.errors.len() + (if mir.is_err(): 1 else: 0)

describe "enum-typed module global assignment":
    it "lowers assignments to a module-level enum var":
        expect(bootstrap_lower_errors(enum_src)).to_equal(0)

    it "still fails closed on a genuinely unbound assignment target":
        expect(bootstrap_lower_errors(unbound_src)).to_be_greater_than(0)
