# Purpose and audience: executable specification evidence for the owning engineering team.
# Regression spec for stage3_post_folded_const_diagnostics_sigsegv_2026_08_14
# (family: stage3_post_file_copy_exit139_2026-08-14, stage3_selfhost_exit_139_2026-08-14).
# The 2026-08-11 stage3 binary routed `MirInst.CallIndirect(...)` variant
# construction as an unresolved method call, lowered `case _:` with disc=-1,
# and still emitted a `call 0`. This pins the exact reproducer semantics.
# @req: REQ-COMP-MIR-ENUM-VARIANT-CALL-WILDCARD-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove enum tuple-variant construction and wildcard match arms lower to real values.
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""
use std.spec.*

enum OpfMirInst:
    CallIndirect(i64, i64, i64, i64)
    Intrinsic(i64, i64, i64)
    Other

fn opf_count_uses(inst: OpfMirInst) -> i64:
    match inst:
        case CallIndirect(_, ptr, args, _): return ptr + args
        case Intrinsic(_, _, args): return args
        case _: return -1

describe "enum variant call and wildcard arm (stage3 call-0 reproducer)":
    it "constructs a 4-field tuple variant and binds inner fields":
        expect(opf_count_uses(OpfMirInst.CallIndirect(1, 20, 3, 4))).to_equal(23)

    it "constructs a 3-field tuple variant and binds the last field":
        expect(opf_count_uses(OpfMirInst.Intrinsic(1, 2, 7))).to_equal(7)

    it "routes a unit variant to the wildcard arm":
        expect(opf_count_uses(OpfMirInst.Other)).to_equal(-1)
