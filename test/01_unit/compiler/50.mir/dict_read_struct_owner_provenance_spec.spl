# @req REQ-SSPEC-COMPILER
"""
# Dict-read struct value provenance carries the declaring module

Bug: doc/08_tracking/bug/mir_dict_read_bare_struct_provenance_2026-11-07.md.
Stage 2 bootstrap run 13 (5fdf9fa) failed 116 MIR field reads with
"ambiguous struct/class field owner 'DynSmfLoadedLibrary': no
module-qualified type provenance" (src/os/smf/smf_dynlib.spl) and the same
for 'LoadedModule' (src/compiler/99.loader/loader/module_loader.spl). Each
module declares its OWN private struct whose bare name is also declared, with
a different field list, by another module. The read `val x = DICT[k]` on a
`Dict<K, OwnStruct>` registered the value's bare struct name, so the field
read on `x` found only the contested bare layout and failed closed.

Through pure-Simple HIR+MIR in-process (seed-hosted), a field read on a
struct value read from a dict must resolve the module-qualified layout.
"""

# @tag: unit, compiler, mir, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

fn lines(xs: [text]) -> text:
    xs.join("\n") + "\n"

fn lower_closure(names: [text], srcs: [text]) -> text:
    """Lower every module through HIR, prescan all, then MIR-lower the last one.
    Returns the concatenated HIR/MIR diagnostics ("" when clean)."""
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    var sources: [SourceFile] = []
    var asts: [Module] = []
    var i = 0
    while i < names.len():
        val path = names[i].replace(".", "/") + ".spl"
        val ast = parse_full_frontend(srcs[i], path, names[i], log)
        modules[names[i]] = ast
        sources.push(SourceFile(path: path, content: srcs[i], module_name: names[i]))
        asts.push(ast)
        i = i + 1
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var hirs: [HirModule] = []
    var out = ""
    i = 0
    while i < names.len():
        var hl = hirlowering_for_module(names[i], surfaces)
        hirs.push(hl.lower_module(asts[i]))
        for e in hl.errors:
            out = out + "hir: " + e.message + "\n"
        i = i + 1
    val last = hirs.len() - 1
    var ml = MirLowering.new(hirs[last].symbols)
    var pre: Dict<text, HirModule> = {}
    i = 0
    while i < names.len():
        pre["m" + i.to_text()] = hirs[i]
        i = i + 1
    i = 0
    while i < names.len():
        ml.prescan_module_struct_names(pre, "m" + i.to_text())
        i = i + 1
    val mir = ml.lower_module(hirs[last], hirs)
    for e in ml.errors:
        if not e.message.contains("non-exhaustive enum match"):
            out = out + "mir: " + e.message + "\n"
    print "diagnostics: [" + out + "]"
    out

# Another module declares a same-named struct with a different field list.
val OTHER = lines(["pub struct Lib:", "    id: text", "    handle: i64", "    generation: i64"])

fn lower_owner(body: [text]) -> text:
    var all: [text] = ["struct Lib:", "    name: text", "    exports: Dict<text, i64>", "    close_pending: bool", ""]
    for l in body:
        all.push(l)
    lower_closure(["lib.other", "app.owner"], [OTHER, lines(all)])

describe "dict-read struct value provenance":
    it "module-global Dict<K, OwnStruct> read then field read lowers clean":
        val d = lower_owner(["var LIBS: Dict<i64, Lib> = \{\}", "", "fn pending(h: i64) -> bool:", "    val loaded = LIBS[h]", "    loaded.close_pending"])
        expect(d).to_equal("")

    it "class field Dict<K, OwnStruct> read then field read lowers clean":
        val d = lower_owner(["class Loader:", "    libs: Dict<text, Lib>", "", "    fn has_export(path: text, name: text) -> bool:", "        val loaded = self.libs[path]", "        loaded.exports.has(name)"])
        expect(d).to_equal("")

    it "Dict<K, OwnStruct> local read then field read lowers clean":
        val d = lower_owner(["fn name_of(libs: Dict<text, Lib>, k: text) -> text:", "    val loaded = libs[k]", "    loaded.name"])
        expect(d).to_equal("")

    it "field that only the OTHER same-named struct declares is rejected (exact layout, no bare borrow)":
        val d = lower_owner(["var LIBS: Dict<i64, Lib> = \{\}", "", "fn h(k: i64) -> i64:", "    val loaded = LIBS[k]", "    loaded.handle"])
        expect(d.contains("absent from exact value layout")).to_equal(true)

    it "uncontested struct dict read still lowers clean":
        val d = lower_closure(["app.solo"], [lines(["struct Solo:", "    a: i64", "    b: text", "", "var M: Dict<i64, Solo> = \{\}", "", "fn f(k: i64) -> text:", "    val s = M[k]", "    s.b"])])
        expect(d).to_equal("")

    it "var from Dict<K, OwnStruct> then field store and indexed field store lowers clean":
        val d = lower_owner(["var LIBS: Dict<i64, Lib> = \{\}", "", "fn close(h: i64):", "    var loaded = LIBS[h]", "    loaded.close_pending = true", "    loaded.exports[\"x\"] = 1", "    LIBS[h] = loaded"])
        expect(d).to_equal("")
