use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{strict_riscv_scalar_muldiv_projection}
use compiler.mir.hwir.riscv_scalar_iterative_divider.{strict_riscv_scalar_iterative_divider}
use compiler.backend.backend.hwir_to_vhdl.{render_strict_sequential_hwir}

fn config(xlen: i32, profile: text) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: xlen, register_count: 32,
        profile: "riscv-gen2-" + profile, isa_profile: profile,
        compressed_decode_profile: "none")

fn divider(name: text, xlen: i32, instruction: u32):
    val cfg = config(xlen, if xlen == 32: "rv32im" else: "rv64im")
    strict_riscv_scalar_iterative_divider(name, cfg,
        strict_riscv_scalar_muldiv_projection(cfg, "iterative", instruction).unwrap()).unwrap()

describe "RISC-V Gen2 clocked restoring divider":
    it "materializes capture iterate finalize consume and held completion rules":
        val module = divider("rv32_iterative_div", 32, 0x0220C1B3)
        expect(module.diagnostic()).to_equal("")
        expect(module.plan.rules.map(_.name)).to_equal([
            "consume", "finalize", "iterate", "identity_fault", "capture"])
        expect(module.plan.registers.any(_.name == "remainder_reg" and _.bit_width == 33)).to_equal(true)
        expect(module.plan.rules[2].assignments.any(_.destination == "quotient_reg" and
            _.value.value == "quotient_next")).to_equal(true)
        expect(module.plan.outputs.any(_.result == "rd_value" and
            _.kind == "guarded")).to_equal(true)
        expect(module.ports.any(_.name == "memory_trap_valid" and _.direction == "out" and
            _.bit_width == 1)).to_equal(true)

    it "emits concrete RV64 restoring division without runtime XLEN selection":
        val module = divider("rv64_iterative_divu", 64, 0x0220D1B3)
        expect(module.plan.registers.any(_.name == "remainder_reg" and _.bit_width == 65)).to_equal(true)
        val emitted = render_strict_sequential_hwir(module, "hwir-gen2-divider-v1")
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl).to_contain("signal remainder_reg: std_logic_vector(64 downto 0)")
        expect(emitted.vhdl).to_contain("quotient_reg <= quotient_next")
        expect(emitted.vhdl).to_contain("original_instruction_reg")
        expect(emitted.vhdl.contains("xlen_select")).to_equal(false)

    it "rejects multiply projection and preserves exact dispatch identity guards":
        val cfg = config(64, "rv64im")
        val multiply = strict_riscv_scalar_muldiv_projection(cfg, "iterative", 0x022081B3).unwrap()
        expect(strict_riscv_scalar_iterative_divider("bad_multiply", cfg, multiply).is_err()).to_equal(true)
        val module = divider("identity_guarded_div", 64, 0x0220C1B3)
        expect(module.datapath_comb_ops.any(_.result == "canonical_match" and _.op == "eq")).to_equal(true)
        expect(module.datapath_comb_ops.any(_.result == "original_match" and
            _.lhs == "dispatch_original_instruction" and _.op == "eq")).to_equal(true)
        expect(module.plan.rules.any(_.name == "identity_fault" and
            _.guards.any(_.kind == "low" and _.lhs == "identity_final"))).to_equal(true)
