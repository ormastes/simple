# @req REQ-SSPEC-COMPILER
# Tracks: nll_live_aliases_method_arg_corruption_2026_10_22
"""
# `state = self.m(state, dict[k])` keeps receiver/argument order in MIR

Shape of the pre-workaround `NLLChecker.solve_loans` call
`state = self.live_aliases(state, before[point])`: a `me` method calls a
`fn` method on `self` with an array local and a dict-indexed array. MIR must
pass `[self(Arg 0), state, dict_get result]` in declaration order, give the
callee a 3-param signature with the receiver first, and copy the call result
back into `state`.
"""
use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{parser_has_errors}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir_lowering.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_instruction_kinds.*
use compiler.mir.mir_instruction_support.*
use compiler.mir.mir_instruction_graph.*
use compiler.mir.mir_types.*

val SHAPE_SRC = "struct A:\n    v: i64\n\nclass C:\n    n: i64\n\n    fn keep(xs: [A], live: [i64]) -> [A]:\n        var out: [A] = []\n        for x in xs:\n            if live.contains(x.v): out = out.push(x)\n        out\n\n    me run(points: Dict<i64, [i64]>) -> i64:\n        var before: Dict<i64, [i64]> = {}\n        before[1] = [1, 3]\n        var st: [A] = [A(v: 1), A(v: 2)]\n        for p in points.keys():\n            st = self.keep(st, before[p])\n        st.len()\n"

fn shape_copy_id(o: MirOperand) -> i64:
    match o.kind:
        case MirOperandKind.Copy(l): l.id
        case MirOperandKind.Move(l): l.id
        case _: -1

fn shape_callee(o: MirOperand) -> text:
    match o.kind:
        case MirOperandKind.Const(v, _):
            match v:
                case MirConstValue.Str(s): s
                case _: ""
        case _: ""

# Returns "args=<n> recv_arg0=<bool> result_back=<bool> callee_params=<n>"
fn shape_summary() -> text:
    val file = "testdata/self_method_array_arg.spl"
    val parsed = parse_full_frontend(SHAPE_SRC, file, "self_method_array_arg", Logger(level: 0))
    if parser_has_errors(): return "parse-error"
    var hl = HirLowering.with_filename(file)
    val hir: HirModule = hl.lower_module(parsed)
    if hl.errors.len() != 0: return "hir-error"
    var lowering = MirLowering.new(hir.symbols)
    val m = lowering.lower_module(hir)
    var out = "missing"
    var callee_params = -1
    for f in m.functions.values():
        if f.name.ends_with("C.keep"): callee_params = f.signature.params.len()
    for f in m.functions.values():
        if f.name.ends_with("C.run"):
            for b in f.blocks:
                var i = 0
                while i < b.instructions.len():
                    match b.instructions[i].kind:
                        case MirInstKind.Call(dest, fnop, args):
                            if shape_callee(fnop).ends_with("C.keep"):
                                val recv = shape_copy_id(args[0])
                                val recv_is_self = match f.locals[recv].kind:
                                    case LocalKind.Arg(n): n == 0
                                    case _: false
                                var back = false
                                if i + 1 < b.instructions.len():
                                    match b.instructions[i + 1].kind:
                                        case MirInstKind.Copy(to, from):
                                            if val d = dest:
                                                back = from.id == d.id and to.id == shape_copy_id(args[1])
                                        case _: ()
                                out = "args={args.len()} recv_arg0={recv_is_self} result_back={back}"
                        case _: ()
                    i = i + 1
    "{out} callee_params={callee_params}"

describe "self method call with array arguments (nll_live_aliases shape)":
    it "passes receiver first, explicit array args in order, and writes the result back":
        expect(shape_summary()).to_equal("args=3 recv_arg0=true result_back=true callee_params=3")
