# @tag:in-development -- native MIR lowering of Result<(A, B)?, E>.unwrap() (bug resopt_result_optional_tuple_unwrap_2026-10-25)
describe "Result of optional tuple unwrap":
    it "unwraps Ok(Some(tuple)) and destructures":
        val r: Result<(text, text)?, text> = Ok(Some(("a", "b")))
        val (a, b) = r.unwrap().unwrap()
        expect(a).to_equal("a")
        expect(b).to_equal("b")
