# @req REQ-SSPEC-COMPILER
# A known Result Err enum payload must not inherit a different Result's record.
use std.spec
use compiler.common.config.Logger
use compiler.common.diagnostics.span.Span
use compiler.common.driver_core_types.driver_core_compile_options_default
use compiler.driver.driver_mir_target.driver_mir_target_context
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_lowering_types.MirLowering
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*

fn result_payload_record_probe(record_kind: text, stale_owner: text):
    val declaration = if record_kind == "enum":
        "enum PayloadError:\n    Rejected(code: i64)\n"
    elif record_kind == "unknown":
        ""
    else:
        record_kind + " PayloadError:\n    code: i64\n"
    val payload_name = if record_kind == "unknown": "any" else: "PayloadError"
    val construct = if record_kind == "enum": "PayloadError.Rejected(code: 0)" elif record_kind == "unknown": "0" else: "PayloadError(code: 0)"
    val source = declaration + "\nfn inspect(result: Result<(), " + payload_name + ">) -> " + payload_name + ":\n    match result:\n        case Result.Ok(_): " + construct + "\n        case Result.Err(error): error\n"
    val parsed = parse_full_frontend(source, "testdata/result_enum_record.spl", "result_enum_record", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/result_enum_record.spl")
    val hir = hir_lowering.lower_module(parsed)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val initial = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    # Keep all real module registries; alter only the shared legacy fallback.
    lowering.enum_payload_struct_names["Result::Err"] = stale_owner
    var functions = 0
    for raw_function in hir.functions.values():
        val function: HirFunction = raw_function
        if function.name == "inspect" or function.name.ends_with(".inspect"):
            val relowered = lowering.lower_function(function)
            expect(relowered.blocks.len()).to_be_greater_than(0)
            functions = functions + 1
    expect(functions).to_equal(1)
    expect(lowering.errors.len()).to_equal(0)
    var bindings = 0
    for raw_symbol in hir.symbols.symbols.values():
        val symbol: HirSymbol = raw_symbol
        if symbol.name == "error":
            bindings = bindings + 1
            val bound = lowering.symbol_bound_local(symbol.id.id)
            expect(bound.id).to_be_greater_than(-1)
            val remembered = lowering.find_local_hir_type(bound.id)
            if record_kind == "enum" or record_kind == "unknown":
                expect(remembered.?).to_equal(true)
                if val payload_type = remembered:
                    if record_kind == "enum":
                        val owner_name = match payload_type.kind:
                            case HirTypeKind.Named(owner, _): hir.symbols.symbol_name_scalar_raw(owner.id)
                            case _: ""
                        expect(owner_name).to_equal("PayloadError")
            val expression = HirExpr(kind: HirExprKind.Var(symbol.id), has_type_: false,
                type_: HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty())
            if record_kind == "enum":
                expect(lowering.struct_value_syms.contains(bound.id)).to_equal(false)
                expect(lowering.resolve_base_struct_name(expression, bound)).to_be_nil()
                expect(lowering.runtime_value_local_ids.contains(bound.id)).to_equal(true)
            elif record_kind == "unknown":
                expect(lowering.struct_value_syms.get(bound.id)).to_equal(Some(stale_owner))
            else:
                val owner = lowering.resolve_base_struct_name(expression, bound)
                expect(owner.?).to_equal(true)
                expect((owner ?? "").contains("PayloadError")).to_equal(true)
                expect(owner == Some(stale_owner)).to_equal(false)
    expect(bindings).to_equal(1)

describe "Result Err enum payload record provenance":
    it "rejects the unrelated record slot for a declared enum payload":
        result_payload_record_probe("enum", "ForeignReceipt")
    it "rejects the legacy text marker as a record owner for a declared enum":
        result_payload_record_probe("enum", enum_text_payload_marker())
    it "preserves an exact Struct Err payload owner":
        result_payload_record_probe("struct", "ForeignReceipt")
    it "preserves an exact Class Err payload owner":
        result_payload_record_probe("class", "ForeignReceipt")
    it "preserves the legacy fallback for an erased Any payload":
        result_payload_record_probe("unknown", "ForeignReceipt")
