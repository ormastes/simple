use std.spec.*

fn sample_path_result(ok: bool) -> Result<text, text>:
    if ok:
        Ok("/opt/simple/rt")
    else:
        Err("missing")

fn resolve_if_try_path(strict: bool) -> Result<text, text>:
    val base = if strict:
        sample_path_result(true)?
    elif false:
        "/alt"
    else:
        "/default"
    Ok("{base}/runtime_native.c")

fn strip_dos_prefix(raw: text) -> text:
    var cur: text = raw
    if cur.starts_with("//?/UNC/"):
        cur = "//" + cur[8:cur.len()]
    elif cur.starts_with("//?/"):
        cur = cur[4:cur.len()]
    var n = cur.len()
    while n > 1 and cur.ends_with("/"):
        cur = cur[0:n - 1]
        n = cur.len()
    cur

describe "wa_batch_f1_f2 lowering regressions":
    it "iterates Dict.values() directly in for-in":
        val names: Dict<i64, text> = {1: "alpha", 2: "beta"}
        var total_len = 0
        for v in names.values():
            total_len = total_len + v.len()
        expect(total_len).to_equal(9)

    it "preserves text across ? unwrap inside if-expression":
        match resolve_if_try_path(true):
            case Ok(resolved): expect(resolved).to_equal("/opt/simple/rt/runtime_native.c")
            case Err(_): expect(false).to_equal(true)

    it "preserves reassigned var text across if/elif and while":
        expect(strip_dos_prefix("//?/C:/repo/src///")).to_equal("C:/repo/src")
        expect(strip_dos_prefix("//?/UNC/srv/share/")).to_equal("//srv/share")
