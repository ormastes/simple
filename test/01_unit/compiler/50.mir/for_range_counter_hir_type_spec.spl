# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: for-range counter retains integer HIR type

`lower_for_range` and `lower_for_range_stepped` bound the loop counter MIR local
without recording its HIR type via `remember_local_hir_type`. As a result,
`var nodes = [start]` inside a `for start in 0..n:` loop left `nodes` without an
element type proof in `builtin_remember_array_literal_init`, causing `nodes.pop()`
to fail with `unresolved method call: pop`.

In addition, both lowerings must recover `u64` (and other integer) types from
typed bounds (including `Cast` literals like `0u64` and typed parameter/local
symbols) and retain both the MIR local type and recorded HIR integer type.
"""

# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir.*
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

struct RangeLoweringResult:
    errors: [text]
    var_local_mir_kinds: [text]
    var_local_hir_kinds: [text]

fn hir_int_kind_tag(ty: HirType) -> text:
    match ty.kind:
        case HirTypeKind.Int(bits, is_signed):
            "Int({bits},{is_signed})"
        case _:
            "{ty.kind}"

fn lower_range_src(src: text, fn_name: text) -> RangeLoweringResult:
    val file = "testdata/fixture_for_range_counter.spl"
    val parsed = parse_full_frontend(src, file, "fixture_for_range_counter", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    var var_mir: [text] = []
    var var_hir: [text] = []
    for function in mir.functions.values():
        if not (function.name == fn_name or function.name.ends_with("." + fn_name)):
            continue
        for local in function.locals:
            match local.kind:
                case LocalKind.Var:
                    var_mir.push("{local.type_.kind}")
                    if val recorded = lowering.find_local_hir_type(local.id.id):
                        val recorded_ty: HirType = recorded
                        var_hir.push(hir_int_kind_tag(recorded_ty))
                    else:
                        var_hir.push("None")
                case _: ()
    RangeLoweringResult(errors: messages, var_local_mir_kinds: var_mir, var_local_hir_kinds: var_hir)

val range_pop_src = "fn drain_nodes(n: i64) -> i64:\n" +
    "    var total = 0\n" +
    "    for start in 0..n:\n" +
    "        var nodes = [start]\n" +
    "        val popped = nodes.pop()\n" +
    "        if val v = popped:\n" +
    "            total = total + v\n" +
    "    total\n"

val stepped_range_pop_src = "fn drain_stepped(n: i64) -> i64:\n" +
    "    var total = 0\n" +
    "    for i in (0..n).step(2):\n" +
    "        var xs = [i]\n" +
    "        val popped = xs.pop()\n" +
    "        if val v = popped:\n" +
    "            total = total + v\n" +
    "    total\n"

val u64_range_src = "fn sum_u64(limit: u64) -> i64:\n" +
    "    var acc: i64 = 0\n" +
    "    for i in 0u64..limit:\n" +
    "        var xs = [i.to_i64()]\n" +
    "        if val v = xs.pop():\n" +
    "            acc = acc + v\n" +
    "    acc\n"

val u64_cast_start_untyped_end_src = "fn sum_u64_lit(dummy: i64) -> i64:\n" +
    "    var acc: i64 = 0\n" +
    "    for i in 0u64..10:\n" +
    "        var xs = [i.to_i64()]\n" +
    "        if val v = xs.pop():\n" +
    "            acc = acc + v\n" +
    "    acc\n"

val u64_stepped_range_src = "fn sum_u64_stepped(limit: u64) -> i64:\n" +
    "    var acc: i64 = 0\n" +
    "    for i in (0u64..limit).step(2):\n" +
    "        var xs = [i.to_i64()]\n" +
    "        if val v = xs.pop():\n" +
    "            acc = acc + v\n" +
    "    acc\n"

fn expect_range_counter(src: text, fn_name: text, expected_mir: text, expected_hir: text):
    val res = lower_range_src(src, fn_name)
    var joined = ""
    for m in res.errors:
        joined = joined + m + "\n"
    if res.errors.len() > 0:
        print "diagnostics: [{joined}]"
    expect(res.errors.len()).to_equal(0)
    expect(res.var_local_mir_kinds).to_contain(expected_mir)
    expect(res.var_local_hir_kinds).to_contain(expected_hir)

describe "MIR lowering: for-range loop counter HIR type":
    it "records i64 HIR type for unannotated for-range counter feeding array literal pop":
        expect_range_counter(range_pop_src, "drain_nodes", "MirTypeKind::I64", "Int(64,true)")

    it "records i64 HIR type for stepped for-range counter feeding array literal pop":
        expect_range_counter(stepped_range_pop_src, "drain_stepped", "MirTypeKind::I64", "Int(64,true)")

    it "preserves typed u64 for-range counter MIR and HIR types":
        expect_range_counter(u64_range_src, "sum_u64", "MirTypeKind::U64", "Int(64,false)")

    it "preserves u64 for-range counter when only start bound is Cast to u64":
        expect_range_counter(u64_cast_start_untyped_end_src, "sum_u64_lit", "MirTypeKind::U64", "Int(64,false)")

    it "preserves typed u64 for stepped for-range counter MIR and HIR types":
        expect_range_counter(u64_stepped_range_src, "sum_u64_stepped", "MirTypeKind::U64", "Int(64,false)")
