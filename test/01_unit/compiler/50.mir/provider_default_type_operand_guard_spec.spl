# @req REQ-SSPEC-COMPILER
# Guard for item5_phase3_early_mir_crash_2026_10_14: relocate_provider_default
# must pass an annotated HirType copy (not a nested `expr.type_` access) to
# relocate_provider_type; the nested form faulted in relocate_provider_type+244
# on the stage-native lane (register_provider_class -> default -> type).
use std.io_runtime.{file_read}

describe "provider default type operand":
    it "relocate_provider_default uses an annotated type copy":
        val src = file_read("src/compiler/50.mir/_MirLowering/provider_metadata.spl")
        expect(src.contains("val expr_declared_type: HirType = expr.type_")).to_equal(true)
        expect(src.contains("self.relocate_provider_type(expr.type_, provider)")).to_equal(false)
