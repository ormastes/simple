# @req REQ-SSPEC-COMPILER
# Guard for item5_phase3_early_mir_crash_2026_10_14: relocate_provider_default
# must not pass a nested `expr.type_` access to relocate_provider_type (it
# faulted in relocate_provider_type+244 on the stage-native lane). Since the
# 2026-11-04 stage2 sweep it passes a BARE rebuilt HirType (kind copied into a
# fresh HirType carrying the enclosing expr's span).
use std.io_runtime.{file_read}

describe "provider default type operand":
    it "relocate_provider_default passes a bare rebuilt type":
        val src = file_read("src/compiler/50.mir/_MirLowering/provider_metadata.spl")
        expect(src.contains("val expr_declared_type: HirType = HirType(kind: expr_declared_kind, span: expr.span)")).to_equal(true)
        expect(src.contains("self.relocate_provider_type(expr.type_, provider)")).to_equal(false)
