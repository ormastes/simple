use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_fence_owner.{strict_riscv_scalar_fence_owner}
use compiler.mir.hwir.riscv_scalar_product_composition.{strict_riscv_scalar_product_composition}
use compiler.backend.backend.riscv_scalar_fence_owner_to_vhdl.{
    compile_strict_riscv_scalar_fence_owner}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{
    compile_strict_riscv_scalar_product}

describe "RISC-V Gen2 accepted-effect fence owner":
    # @req REQ-G2-017 NFR-G2-018
    it "holds exact FENCE fields until the ordering effect is accepted":
        val owner = strict_riscv_scalar_fence_owner("fence_owner_rv32",
            CoreConfig.rv32(), 0x0FF0000F).unwrap()
        expect(owner.diagnostic()).to_equal("")
        expect(owner.plan.rules.map(fn(rule): rule.name)).to_contain("capture_effect")
        val valid = owner.plan.outputs.filter(
            fn(output): output.result == "fence_effect_valid")[0]
        expect(valid.source).to_equal("pending_reg")
        val pred = owner.plan.outputs.filter(fn(output): output.result == "fence_pred")[0]
        val succ = owner.plan.outputs.filter(fn(output): output.result == "fence_succ")[0]
        expect(pred.source).to_equal("effect_pred")
        expect(succ.source).to_equal("effect_succ")
        expect(owner.plan.rules[1].name).to_equal("effect_accept")

    # @req REQ-G2-017 NFR-G2-018
    it "makes FENCE.I an explicit instruction-stream invalidation effect":
        val owner = strict_riscv_scalar_fence_owner("fence_i_owner_rv64",
            CoreConfig.rv64_zicsr_zifencei(), 0x0000100F).unwrap()
        expect(owner.diagnostic()).to_equal("")
        val kind = owner.plan.outputs.filter(
            fn(output): output.result == "fence_effect_kind")[0]
        expect(kind.source).to_equal("effect_kind")
        expect(strict_riscv_scalar_fence_owner("fence_i_base",
            CoreConfig.rv64(), 0x0000100F).is_err()).to_equal(true)

    # @req REQ-G2-017 NFR-G2-018
    it "traps reserved encodings and runtime illegal events without effects":
        val reserved = strict_riscv_scalar_fence_owner("fence_reserved",
            CoreConfig.rv64(), 0x1000000F).unwrap()
        expect(reserved.plan.rules.map(fn(rule): rule.name)).to_contain(
            "capture_illegal_encoding")
        val legal = strict_riscv_scalar_fence_owner("fence_runtime_illegal",
            CoreConfig.rv64(), 0x0FF0000F).unwrap()
        val illegal_rule = legal.plan.rules.filter(
            fn(rule): rule.name == "capture_illegal_decode")[0]
        expect(illegal_rule.guards.map(fn(guard): guard.lhs)).to_contain("illegal_valid")
        val effect_rule = legal.plan.rules.filter(fn(rule): rule.name == "capture_effect")[0]
        expect(effect_rule.guards.map(fn(guard): guard.lhs)).to_contain("illegal_valid")

    # @req REQ-G2-017 NFR-G2-018
    it "emits and composes one stateful fence provider with no completion skid":
        val leaf = compile_strict_riscv_scalar_fence_owner("fence_emit",
            CoreConfig.rv32(), 0x0FF0000F)
        expect(leaf.is_success()).to_equal(true)
        expect(leaf.route).to_equal("hwir-gen2-scalar-fence-owner-v1")
        expect(leaf.vhdl).to_contain("fence_effect_valid <= pending_reg")
        val composition = strict_riscv_scalar_product_composition("fence_product",
            CoreConfig.rv32(), 0x0FF0000F, LsuConfig.rv32_product_default()).unwrap()
        expect(composition.provider_kind).to_equal("fence")
        expect(composition.fence_provider != nil).to_equal(true)
        expect(composition.completion_skid == nil).to_equal(true)
        expect(composition.binding_diagnostic()).to_equal("")
        val product = compile_strict_riscv_scalar_product("fence_product_emit",
            CoreConfig.rv32(), 0x0FF0000F, LsuConfig.rv32_product_default())
        expect(product.is_success()).to_equal(true)
        expect(product.vhdl).to_contain("fence_effect_ready")
        expect(product.vhdl).to_contain("fault_aggregator: entity work")
