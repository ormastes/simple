"""
# MirType.f32() static constructor regression spec
"""

# @tag: unit, compiler, mir

use compiler.mir.mir_types.{MirType, MirTypeKind}

describe "MirType static constructors":
    it "constructs F32 primitive type via MirType.f32()":
        val ty = MirType.f32()
        expect(ty.kind == MirTypeKind.F32).to_equal(true)
        expect(ty.primitive_size()).to_equal(Some(4))
