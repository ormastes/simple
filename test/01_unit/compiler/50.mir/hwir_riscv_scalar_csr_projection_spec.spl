use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.host_evaluator.{HwHostEvaluation, HwHostInput,
    prepare_strict_comb_hwir}
use compiler.mir.hwir.riscv_scalar_csr_projection.{strict_riscv_scalar_csr_projection_hwir}

fn csr_eval(instruction: u32, privilege: i64, rs1_index: i64,
    rs1_value: i64, present: i64, read_value: i64) -> HwHostEvaluation:
    val module = strict_riscv_scalar_csr_projection_hwir("csr_eval",
        CoreConfig.rv64_zicsr_zifencei(), instruction).unwrap()
    prepare_strict_comb_hwir(module).unwrap().evaluate([
        HwHostInput.bits("in_valid", 1), HwHostInput.bits("in_order", 7),
        HwHostInput.bits("in_privilege", privilege), HwHostInput.bits("in_pc", 0x100),
        HwHostInput.bits("rs1_index", rs1_index), HwHostInput.bits("rs1_value", rs1_value),
        HwHostInput.bits("csr_present", present), HwHostInput.bits("csr_read_value", read_value)]).unwrap()

describe "RISC-V Gen2 typed Zicsr access projection":
    # @req REQ-G2-016 NFR-G2-017
    it "constructs all six exact Zicsr operation rows for RV32 and RV64":
        val rows: [u32] = [0x300092F3, 0x3000A2F3, 0x3000B2F3,
            0x3000D2F3, 0x3000E2F3, 0x3000F2F3]
        for instruction in rows:
            expect(strict_riscv_scalar_csr_projection_hwir("csr32",
                CoreConfig.rv32_zicsr_zifencei(), instruction).is_ok()).to_equal(true)
            expect(strict_riscv_scalar_csr_projection_hwir("csr64",
                CoreConfig.rv64_zicsr_zifencei(), instruction).is_ok()).to_equal(true)
        expect(strict_riscv_scalar_csr_projection_hwir("not_csr",
            CoreConfig.rv64_zicsr_zifencei(), 0x00000073).is_err()).to_equal(true)
        expect(strict_riscv_scalar_csr_projection_hwir("wrong_profile",
            CoreConfig.rv64(), 0x300092F3).is_err()).to_equal(true)

    # @req REQ-G2-016 NFR-G2-017
    it "returns the old value and computes exact write set clear and immediate effects":
        val write = csr_eval(0x300092F3, 3, 1, 5, 1, 16)
        expect(write.value_of("csr_read_enable").unwrap()).to_equal(1)
        expect(write.value_of("csr_write_enable").unwrap()).to_equal(1)
        expect(write.value_of("csr_write_value").unwrap()).to_equal(5)
        expect(write.value_of("retire_rd_value").unwrap()).to_equal(16)
        val x0_write = csr_eval(0x300012F3, 3, 0, 99, 1, 16)
        expect(x0_write.value_of("csr_write_enable").unwrap()).to_equal(1)
        expect(x0_write.value_of("csr_write_value").unwrap()).to_equal(0)
        val set_value = csr_eval(0x3000A2F3, 3, 1, 5, 1, 16)
        expect(set_value.value_of("csr_write_value").unwrap()).to_equal(21)
        val clear_value = csr_eval(0x3000B2F3, 3, 1, 5, 1, 23)
        expect(clear_value.value_of("csr_write_value").unwrap()).to_equal(18)
        val immediate_set = csr_eval(0x3001E2F3, 3, 0, 99, 1, 16)
        expect(immediate_set.value_of("csr_write_value").unwrap()).to_equal(19)

    # @req REQ-G2-016 NFR-G2-017
    it "implements no-write forms and rejects privilege read-only identity and presence failures":
        val no_write = csr_eval(0x300022F3, 3, 0, 99, 1, 16)
        expect(no_write.value_of("csr_write_enable").unwrap()).to_equal(0)
        expect(no_write.value_of("retire_rd_value").unwrap()).to_equal(16)
        val read_without_rd = csr_eval(0x30002073, 3, 0, 99, 1, 16)
        expect(read_without_rd.value_of("csr_read_enable").unwrap()).to_equal(1)
        expect(read_without_rd.value_of("retire_rd_write").unwrap()).to_equal(0)
        val write_without_read = csr_eval(0x30009073, 3, 1, 7, 1, 16)
        expect(write_without_read.value_of("csr_read_enable").unwrap()).to_equal(0)
        expect(write_without_read.value_of("csr_write_enable").unwrap()).to_equal(1)
        val no_write_immediate = csr_eval(0x300072F3, 3, 0, 99, 1, 16)
        expect(no_write_immediate.value_of("csr_write_enable").unwrap()).to_equal(0)
        val read_only_write = csr_eval(0xF11092F3, 3, 1, 7, 1, 42)
        expect(read_only_write.value_of("retire_trap").unwrap()).to_equal(1)
        expect(read_only_write.value_of("csr_write_enable").unwrap()).to_equal(0)
        expect(read_only_write.value_of("retire_cause").unwrap()).to_equal(2)
        val underprivileged = csr_eval(0x100092F3, 0, 1, 7, 1, 42)
        expect(underprivileged.value_of("retire_trap").unwrap()).to_equal(1)
        val mismatched_rs1 = csr_eval(0x300092F3, 3, 2, 7, 1, 42)
        expect(mismatched_rs1.value_of("retire_trap").unwrap()).to_equal(1)
        val absent = csr_eval(0x300092F3, 3, 1, 7, 0, 42)
        expect(absent.value_of("retire_trap").unwrap()).to_equal(1)
        expect(absent.value_of("csr_lookup_address").unwrap()).to_equal(0x300)
        expect(absent.value_of("csr_read_enable").unwrap()).to_equal(0)
