    it "detects two-trait ambiguity and inherent precedence on eager provider methods path":
        val prov_ambig = """
pub trait MarkerA:
    fn mark() -> i64

pub trait MarkerB:
    fn mark() -> i64

pub struct P:
    x: i64

impl MarkerA for P:
    fn mark() -> i64:
        self.x + 1

impl MarkerB for P:
    fn mark() -> i64:
        self.x + 2
"""
        val cons_src = """
use lib.prov.{P}

fn use_p(p: P) -> i64:
    p.mark()

fn main() -> i64:
    use_p(P(x: 10))
"""
        val res_ambig = lower_two_modules_configured(prov_ambig, cons_src, true, false)
        expect(res_ambig.1.len() > 0).to_equal(true)
        var saw_ambig = false
        var saw_fatal = false
        var i = 0
        while i < res_ambig.1.len():
            if res_ambig.1[i].contains("ambiguous trait method") and res_ambig.1[i].contains("mark"):
                saw_ambig = true
                if res_ambig.2[i]:
                    saw_fatal = true
            i = i + 1
        expect(saw_ambig).to_equal(true)
        expect(saw_fatal).to_equal(true)

        val prov_inherent = """
pub trait MarkerA:
    fn mark() -> i64

pub struct P:
    x: i64

impl MarkerA for P:
    fn mark() -> i64:
        self.x + 1

impl P:
    fn mark() -> i64:
        self.x + 9
"""
        val res_ok = lower_two_modules_configured(prov_inherent, cons_src, true, false)
        expect(res_ok.0.functions.len() > 0).to_equal(true)
        expect(res_ok.1.len()).to_equal(0)
        expect(has_call_in_fn(res_ok.0, "use_p")).to_equal(true)

