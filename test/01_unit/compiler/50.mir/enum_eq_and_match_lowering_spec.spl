# Purpose and audience: MIR family-A regression spec — payload-free enum
# equality, payload-variant match, and bare payload-variant arms.
# @req REQ-SSPEC-UNIT
# Bugs: backend_plugin_enum_equality_mir_2026_10_12,
#       match_on_enum_native_lowering_status_2026-08-07,
#       match_unqualified_imported_enum_variant_default_arms_2026-10-24
# Native evidence (2026-11-05): the same bodies built with s3_fable44 via
# s3sanity run_case (mirp2a_enum) print CHECKS=10, rc=0.

use std.spec

enum Role:
    Producer
    Consumer

enum Cap:
    Emit
    Link
    Debug

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Point

fn role_is_producer(r: Role) -> bool:
    r == Role.Producer

fn cap_in(c: Cap, caps: [Cap]) -> bool:
    for x in caps:
        if x == c:
            return true
    false

fn shape_name(s: Shape) -> text:
    match s:
        case Shape.Circle(r): "circle"
        case Shape.Rect(w, h): "rect"
        case Shape.Point: "point"

describe("enum equality and match lowering"):
    it("compares payload-free enum variants directly"):
        assert_equal(role_is_producer(Role.Producer), true)
        assert_equal(role_is_producer(Role.Consumer), false)
        assert_equal(Role.Consumer != Role.Producer, true)

    it("finds a payload-free variant in a list by =="):
        assert_equal(cap_in(Cap.Link, [Cap.Emit, Cap.Link]), true)
        assert_equal(cap_in(Cap.Debug, [Cap.Emit, Cap.Link]), false)

    it("matches payload-bearing variants"):
        assert_equal(shape_name(Shape.Circle(2.5)), "circle")
        assert_equal(shape_name(Shape.Rect(3.0, 4.0)), "rect")
        assert_equal(shape_name(Shape.Point), "point")
