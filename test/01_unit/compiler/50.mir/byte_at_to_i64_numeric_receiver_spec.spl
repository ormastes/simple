# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: `.to_i64()` on a `byte_at` result is a numeric conversion, not a text parse

Bug: doc/08_tracking/bug/phase2_byte_at_to_i64_lowered_as_text_parse_2026-11-23.md.
`path.byte_at(0).to_i64()` reached the erased-receiver text-builtin arm because the
`byte_at` result local carried no HIR type and its expression was not proven numeric,
so `to_i64` (a name the text table owns) lowered as rt_string_to_int_lenient and the
byte 'C' became 0. `to_u8` / `to_u64` / `to_i32` are not text-table names, so they
already took the numeric arm. A `byte_at` result is a byte value and must stay numeric;
a real text receiver must still parse.
"""

# @tag: unit, compiler, mir, builtins

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn callees_of(src: text) -> [text]:
    val file = "testdata/fixture_byte_at_to_i64.spl"
    val parsed = parse_full_frontend(src, file, "fixture_byte_at_to_i64", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(hir)
    var callees: [text] = []
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                callees = callees.push(name)
                            case _: pass
                    case _: pass
    callees

fn has_callee(callees: [text], name: text) -> bool:
    for c in callees:
        if c == name:
            return true
    false

describe "to_i64 on a byte_at result":
    it "chained byte_at(0).to_i64() reads the byte and does not parse text":
        step("lower `s.byte_at(0).to_i64()` on a text parameter")
        val callees = callees_of("fn f(s: text) -> i64:\n    s.byte_at(0).to_i64()\n")
        expect(has_callee(callees, "__simple_rt_string_byte_at")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)
        expect(has_callee(callees, "rt_string_new")).to_equal(false)

    it "chained byte_at(i).to_int() with a variable index does not parse text":
        step("lower the `to_int` alias with a non-literal index")
        val callees = callees_of("fn f(s: text, i: i64) -> i64:\n    s.byte_at(i).to_int()\n")
        expect(has_callee(callees, "__simple_rt_string_byte_at")).to_equal(true)
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "an untyped local bound to byte_at keeps the numeric conversion":
        step("bind `val b = s.byte_at(1)` without a type, then call `b.to_i64()`")
        val callees = callees_of("fn f(s: text) -> i64:\n    val b = s.byte_at(1)\n    b.to_i64()\n")
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "byte_at arithmetic receivers stay numeric":
        step("lower `(s.byte_at(0) - 48).to_i64()`")
        val callees = callees_of("fn f(s: text) -> i64:\n    (s.byte_at(0) - 48).to_i64()\n")
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(false)

    it "a real text receiver still parses through the text table":
        step("control: `s.to_i64()` on text must keep rt_string_to_int_lenient")
        val callees = callees_of("fn f(s: text) -> i64:\n    s.to_i64()\n")
        expect(has_callee(callees, "rt_string_to_int_lenient")).to_equal(true)
