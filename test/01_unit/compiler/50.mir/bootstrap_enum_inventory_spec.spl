# @req REQ-SSPEC-COMPILER
"""
# Bootstrap-lane enum inventory: variants + runtime ids + builtin seeds

Stage3 frontier divergence (site-19, 2026-10-17): the bootstrap-fixed stage3
lane lowers app.cli.bootstrap_main through lower_module's bootstrap-flat
branch on a FRESH MirLowering instance. That branch returns before the
non-bootstrap tail, so none of the tail's registration exists there: not the
module's own module.enums loop, not the built-in Option/Result seeds, and —
with the empty provider list this lane passes — no dependency enums. The
stage3 build died with "enum construction: missing runtime identity for
'Option'" and "enum construction: unregistered declaration
'compiler.common.driver_core_modes.CompileMode'" at the entry's construction
sites, while stage2 — built by the Rust seed, which seeds a GLOBAL enum
sidecar across the whole closure (reserved Result/Option lane 0/1) before
lowering — compiled the same entry fine.

register_module_enum_bootstrap_inventory_v1 closes the gap the way the seed
does: register every scheduled module's own enums (variants AND runtime ids)
plus the built-in Result/Option seeds, up front, before the entry lowers.
register_enum_variants / register_enum_runtime_id read only the HirEnum (no
symbol table), the seeds guard on has() so re-runs are quiet, and any later
tail registration overwrites unconditionally. lower_module's own seed block
was extracted into register_builtin_enum_seeds so both lanes share it.

These probes contract-test the helper directly and pin the lane wiring.
"""

# @tag: unit, compiler, mir, enum, bootstrap, stage3

use std.spec
use std.io_runtime.{file_read}
# Importing the driver lane forces the seed to compile the module carrying
# the stage3 wiring this spec pins (the bootstrap-fixed enum inventory call).
use compiler.driver.driver_pipeline_lowering.*
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{SymbolTable}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn bootinv_hir(src: text, file: text) -> HirModule:
    val parsed = parse_full_frontend(src, file, "fixture_boot_enum_inventory", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    hir_lowering.lower_module(parsed)

describe "bootstrap enum inventory registration":
    it "registers every module's enum variants and runtime ids plus builtin seeds":
        val src = "enum Tone:\n    Low\n    High\n\nfn read(t: Tone) -> i64:\n    match t:\n        case Low:\n            0\n        case High:\n            1\n        case _:\n            -1\n"
        val hir = bootinv_hir(src, "testdata/fixture_boot_enum_inventory.spl")
        var lowering = MirLowering.new_for_target(SymbolTable.new(), driver_mir_target_context(driver_core_compile_options_default()))
        lowering.register_module_enum_bootstrap_inventory_v1([hir])
        expect(lowering.enum_variant_names("Tone")).to_equal(["Low", "High"])
        expect(lowering.enum_variant_discriminant("Tone", "High")).to_equal(1)
        # Runtime identity registered for the module's own enum...
        expect(lowering.enum_runtime_id_names.len() > 0).to_equal(true)
        # ...and the built-in seeds exist on a bare instance that never ran
        # lower_module's tail.
        expect(lowering.enum_variant_index.has("Option")).to_equal(true)
        expect(lowering.enum_variant_index.has("Result")).to_equal(true)
        expect(lowering.enum_runtime_id_index.has("Option")).to_equal(true)
        expect(lowering.enum_runtime_id_index.has("Result")).to_equal(true)
        expect(lowering.errors.len()).to_equal(0)

    it "a lowering that consumes the inventory constructs variants without registration errors":
        val src = "enum Tone:\n    Low\n    High\n\nimpl Tone:\n    static fn high() -> Tone:\n        Tone.High\n\nfn make() -> Tone:\n    Tone.high()\n"
        val hir = bootinv_hir(src, "testdata/fixture_boot_enum_inventory_make.spl")
        var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
        lowering.register_module_enum_bootstrap_inventory_v1([hir])
        val mir = lowering.lower_module(hir)
        var all = ""
        for e in lowering.errors:
            all = all + e.message + "\n"
        print "errors: [{all}]"
        expect(all.contains("missing runtime identity")).to_equal(false)
        expect(all.contains("unregistered declaration")).to_equal(false)
        var found = false
        for function in mir.functions.values():
            if function.name.ends_with(".make") or function.name == "make":
                found = true
        assert_true(found)

    it "pins the helper, the shared seed extraction, and the stage3 lane wiring":
        val lowering_source = file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl")
        expect(lowering_source).to_contain("me register_module_enum_bootstrap_inventory_v1(modules: [HirModule]):")
        expect(lowering_source).to_contain("me register_builtin_enum_seeds():")
        expect(lowering_source).to_contain("self.register_builtin_enum_seeds()")
        val driver_source = file_read("src/compiler/80.driver/driver_pipeline_lowering.spl")
        expect(driver_source).to_contain("bootstrap_lowering.register_module_enum_bootstrap_inventory_v1(bootstrap_enum_modules)")
        expect(driver_source).to_contain("bootstrap_lowering.lower_bootstrap_entry_module(bootstrap_hir, self.ctx.mir_feed_modules)")
        # The inventory call must precede the entry lowering in the lane.
        val inventory_pos = driver_source.index_of("register_module_enum_bootstrap_inventory_v1(bootstrap_enum_modules)")
        val lowering_pos = driver_source.index_of("lower_bootstrap_entry_module(bootstrap_hir, self.ctx.mir_feed_modules)")
        expect(inventory_pos >= 0 and lowering_pos > inventory_pos).to_equal(true)
