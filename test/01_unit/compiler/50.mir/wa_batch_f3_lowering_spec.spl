use std.spec.*

struct MockIfArm:
    id: i64
    name: text

fn maybe_arms(present: bool) -> [MockIfArm]?:
    if present:
        Some([MockIfArm(id: 1, name: "arm")])
    else:
        None

describe "wa_batch_f3 lowering regressions":
    it "coalesces optional struct list directly with ?? []":
        val present_arms: [MockIfArm] = maybe_arms(true) ?? []
        val empty_arms: [MockIfArm] = maybe_arms(false) ?? []
        expect(present_arms.len()).to_equal(1)
        expect(empty_arms.len()).to_equal(0)

    it "calls text methods directly on substring result":
        val full = "root/sub/file.spl"
        val rel = full.substring(5, full.len())
        expect(rel).to_equal("sub/file.spl")
        expect(rel.byte_len()).to_equal(12)
