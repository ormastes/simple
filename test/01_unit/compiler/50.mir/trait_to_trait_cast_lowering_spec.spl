# @req REQ-SSPEC-COMPILER
"""
# `trait_value as OtherTrait` lowers to a checked native trait-object cast

`self.inner as AsyncClose` (inner: AsyncRead) could not be compiled natively:
`x as T` reaches MIR as HirExprKind.Cast, and lower_cast_or_convert emitted a
raw scalar cast of the two-word trait object, so the result carried no trait
type and the next method call died with `unresolved method call: close_n`
(r16b Stage 2, 2026-10-20). The interpreter treats the cast as a checked
downcast: the target trait's object when the dynamic type implements it,
`nil` otherwise.

Native lowering: every trait-object vtable carries a trailing per-concrete
cast thunk `(data, target_trait_id) -> object | nil`, emitted where the
concrete type is converted to a trait object (the site that knows the
concrete type and its trait impls). `e as T` on a trait-typed `e` calls the
source vtable's thunk and yields `T?`.
"""

# @tag: unit, compiler, mir, trait

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_instruction_kinds.*

val cast_source = "trait Reader:\n    fn read_n() -> i64\n\ntrait Closer:\n    fn close_n() -> i64\n\nclass Both:\n    v: i64\n\nimpl Reader for Both:\n    fn read_n() -> i64:\n        self.v\n\nimpl Closer for Both:\n    fn close_n() -> i64:\n        self.v + 100\n\nclass ReadOnly:\n    v: i64\n\nimpl Reader for ReadOnly:\n    fn read_n() -> i64:\n        self.v\n\nfn close_via(r: Reader) -> i64:\n    if val c = r as Closer:\n        return c.close_n()\n    -1\n\nfn main() -> i64:\n    val b: Reader = Both(v: 7)\n    val o: Reader = ReadOnly(v: 3)\n    print \"both \{close_via(b)\}\"\n    print \"readonly \{close_via(o)\}\"\n    0\n"

fn lower_cast_module() -> MirLowering:
    val log = Logger(level: 0)
    val ast = parse_full_frontend(cast_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["app.main"] = ast
    val sources = [SourceFile(path: "app/main.spl", content: cast_source, module_name: "app.main")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var lowering = hirlowering_for_module("app.main", surfaces)
    val hir = lowering.lower_module(ast)
    var hm: Dict<text, HirModule> = {}
    hm["app.main"] = hir
    var ml = MirLowering.new(hir.symbols)
    ml.prescan_module_struct_names(hm, "app.main")
    ml.lower_module(hir, [], true)
    ml

fn errors_of(ml: MirLowering) -> text:
    var out = ""
    for e in ml.errors:
        out = out + e.message + "\n"
    out

describe "trait-object to trait-object cast":
    it "lowers `if val c = r as Closer` and dispatches c.close_n() through the target vtable":
        val ml = lower_cast_module()
        val errs = errors_of(ml)
        print "mir errors: [{errs}]"
        expect(errs.contains("unresolved method call")).to_equal(false)
        expect(errs).to_equal("")

    it "emits one cast thunk per concrete type converted to a trait object":
        val ml = lower_cast_module()
        var casts = 0
        for thunk in ml.native_trait_thunks:
            if thunk.name.starts_with("__simple_trait_cast_"):
                casts = casts + 1
        print "cast thunks: {casts}"
        expect(casts).to_equal(2)

fn close_via_indirect_calls() -> text:
    val log = Logger(level: 0)
    val ast = parse_full_frontend(cast_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["app.main"] = ast
    val sources = [SourceFile(path: "app/main.spl", content: cast_source, module_name: "app.main")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var lowering = hirlowering_for_module("app.main", surfaces)
    val hir = lowering.lower_module(ast)
    var hm: Dict<text, HirModule> = {}
    hm["app.main"] = hir
    var ml = MirLowering.new(hir.symbols)
    ml.prescan_module_struct_names(hm, "app.main")
    val mir = ml.lower_module(hir, [], true)
    var shape = "missing"
    for f in mir.functions.values():
        if f.name.ends_with("close_via"):
            var cast_calls = 0
            var other_calls = 0
            for block in f.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case MirInstKind.CallIndirect(_, _, _, sig):
                            # The cast thunk is the only (data, i64) slot.
                            if sig.params.len() == 2: cast_calls = cast_calls + 1
                            else: other_calls = other_calls + 1
                        case _: ()
            shape = "cast={cast_calls} other={other_calls}"
    shape

describe "trait cast dispatch shape":
    it "calls the source vtable's cast thunk, then the target vtable's close_n slot":
        val shape = close_via_indirect_calls()
        print "close_via indirect calls: {shape}"
        # other = the bound object's copy thunk + its close_n slot.
        expect(shape).to_equal("cast=1 other=2")
