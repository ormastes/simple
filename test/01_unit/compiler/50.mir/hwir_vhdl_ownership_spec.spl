# codex-system-test
# @manual_section RISC-V Gen2 HWIR VHDL ownership
"""Keep Gen2 semantic HWIR free of target-language serializer fragments."""

use std.spec.*
use std.io_runtime.{file_read}

fn hwir_semantic_source_files() -> [text]:
    ["src/compiler/50.mir/hwir/types.spl",
        "src/compiler/50.mir/hwir/mir_to_hwir.spl",
        "src/compiler/50.mir/hwir/predecode.spl",
        "src/compiler/50.mir/hwir/branch_predecode.spl",
        "src/compiler/50.mir/hwir/frontend.spl",
        "src/compiler/50.mir/hwir/trap_predecode.spl",
        "src/compiler/50.mir/hwir/trap_frontend.spl",
        "src/compiler/50.mir/hwir/stateful_frontend.spl",
        "src/compiler/50.mir/hwir/sequential.spl",
        "src/compiler/50.mir/hwir/aspects.spl"]

describe "RISC-V Gen2 HWIR VHDL ownership":
    # @req NFR-G2-004
    it "should keep VHDL grammar confined to the strict backend emitter":
        step("Scan each typed Gen2 semantic owner for target-language grammar")
        for path in hwir_semantic_source_files():
            val source = file_read(path)
            expect(source.contains("library ieee")).to_equal(false)
            expect(source.contains("std_logic")).to_equal(false)
            expect(source.contains("entity work.")).to_equal(false)
            expect(source.contains("architecture ")).to_equal(false)

    # @req NFR-G2-004
    it "should keep the strict VHDL backend as the designated serializer owner":
        step("Confirm the backend, rather than HWIR construction, owns VHDL prelude emission")
        val emitter = file_read("src/compiler/70.backend/backend/hwir_to_vhdl.spl")
        expect(emitter).to_contain("library ieee;")
        expect(emitter).to_contain("use ieee.std_logic_1164.all;")
