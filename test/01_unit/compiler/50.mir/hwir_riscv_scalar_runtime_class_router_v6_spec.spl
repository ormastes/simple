use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.host_evaluator.{HwHostInput, evaluate_strict_comb_hwir}
use compiler.mir.hwir.riscv_scalar_runtime_class_router_v6.{strict_riscv_scalar_runtime_class_router_v6}

fn v6_router_inputs(class_code: i64, legal: i64 = 1, illegal: i64 = 0,
    busy: i64 = 0, pending_ready: i64 = 1, sticky_fault: i64 = 0) -> [HwHostInput]:
    [HwHostInput.bits("uop_valid", 1), HwHostInput.bits("decode_legal", legal),
        HwHostInput.bits("illegal_valid", illegal), HwHostInput.bits("decoded_execution_class", class_code),
        HwHostInput.bits("alu_ready", 1), HwHostInput.bits("control_ready", 1),
        HwHostInput.bits("system_ready", 1), HwHostInput.bits("illegal_ready", 1),
        HwHostInput.bits("pending_ready", pending_ready), HwHostInput.bits("pending_busy", busy),
        HwHostInput.bits("sticky_fault", sticky_fault)]

describe("runtime pipeline v6 class router"):
    it("admits class four through pending tag two only"):
        val module = strict_riscv_scalar_runtime_class_router_v6("pipeline_v6_router", CoreConfig.rv64im()).unwrap()
        val result = evaluate_strict_comb_hwir(module, v6_router_inputs(4)).unwrap()
        expect(result.value_of("pending_dispatch_valid").unwrap()).to_equal(1)
        expect(result.value_of("pending_dispatch_tag").unwrap()).to_equal(2)
        expect(result.value_of("uop_ready").unwrap()).to_equal(1)
        expect(result.value_of("router_fault").unwrap()).to_equal(0)

    it("preserves pending backpressure and fail-closed decoder skew"):
        val module = strict_riscv_scalar_runtime_class_router_v6("pipeline_v6_router_closed", CoreConfig.rv32im()).unwrap()
        val held = evaluate_strict_comb_hwir(module, v6_router_inputs(4, 1, 0, 0, 0)).unwrap()
        expect(held.value_of("pending_dispatch_valid").unwrap()).to_equal(1)
        expect(held.value_of("uop_ready").unwrap()).to_equal(0)
        val skew = evaluate_strict_comb_hwir(module, v6_router_inputs(4, 0, 0)).unwrap()
        expect(skew.value_of("pending_dispatch_valid").unwrap()).to_equal(0)
        expect(skew.value_of("uop_ready").unwrap()).to_equal(0)
        expect(skew.value_of("router_fault").unwrap()).to_equal(1)

    it("keeps the previous stateful tags distinct"):
        val module = strict_riscv_scalar_runtime_class_router_v6("pipeline_v6_router_tags", CoreConfig.rv64im()).unwrap()
        for row in [(3, 1), (4, 2), (7, 4)]:
            val result = evaluate_strict_comb_hwir(module, v6_router_inputs(row[0])).unwrap()
            expect(result.value_of("pending_dispatch_valid").unwrap()).to_equal(1)
            expect(result.value_of("pending_dispatch_tag").unwrap()).to_equal(row[1])
        expect(module.shape_diagnostic()).to_equal("")
