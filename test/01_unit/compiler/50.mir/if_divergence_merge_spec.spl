# @req REQ-MIR-IF-DIVERGENCE-001
# UNEXECUTED: compiler runtime qualification awaits the bootstrap lane.
# @cover src/compiler/50.mir/mir_lowering_stmts.spl
use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.mir.mir.*
use compiler.mir.mir_verify.{mir_verify_module}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

# Count actual returns, mistyped return operands, and merges with live exits.
# An empty result or a failed lowering must not satisfy the shape assertions.
fn if_divergence_shape(source: text) -> [i64]:
    val ast = parse_full_frontend(source, "app/main.spl", "app.main", Logger(level: 0))
    var modules: Dict<text, Module> = {}
    modules["app.main"] = ast
    val sources = [SourceFile(path: "app/main.spl", content: source, module_name: "app.main")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var hir_lowering = hirlowering_for_module("app.main", surfaces)
    val hir = hir_lowering.lower_module(ast)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir, [hir])
    expect(lowering.errors.len()).to_equal(0)
    val verified = mir_verify_module(mir)
    var undefined_reads = ""
    for finding in verified.findings:
        if finding.rule == "MIRV-005e":
            undefined_reads = undefined_reads + finding.function + ": " + finding.message + "\n"
    expect(undefined_reads).to_equal("")
    var functions = 0
    var returns = 0
    var invalid = 0
    var live_merges = 0
    for function in mir.functions.values():
        if function.name == "target" or function.name.ends_with(".target"):
            functions = functions + 1
            for block in function.blocks:
                val label = block.label ?? ""
                if label == "merge" or label == "if_chain_merge":
                    match block.terminator:
                        case MirTerminator.Unreachable: ()
                        case _: live_merges = live_merges + 1
                match block.terminator:
                    case MirTerminator.Ret(value):
                        returns = returns + 1
                        var actual = MirTypeKind.Unit
                        if val operand = value:
                            match operand.kind:
                                case MirOperandKind.Copy(id) | MirOperandKind.Move(id):
                                    for local in function.locals:
                                        if local.id.id == id.id:
                                            actual = local.type_.kind
                                case MirOperandKind.Const(_, type_): actual = type_.kind
                                case _: ()
                        if actual != MirTypeKind.F64:
                            invalid = invalid + 1
                    case _: ()
    expect(functions).to_equal(1)
    [returns, invalid, live_merges]

describe "if merges preserve terminating paths":
    it "excludes a nested all-returning first arm from the outer float merge":
        val shape = if_divergence_shape("fn target(a: bool, b: bool) -> f64:\n    if a:\n        if b:\n            return 1.5\n        else:\n            return 2.5\n    else:\n        3.5\n")
        expect(shape).to_equal([3, 0, 1])

    it "excludes a nested all-returning chain from the outer float merge":
        val shape = if_divergence_shape("fn target(a: bool, b: bool, c: bool) -> f64:\n    if a:\n        if b:\n            return 1.5\n        elif c:\n            return 2.5\n        else:\n            return 3.5\n    else:\n        4.5\n")
        expect(shape).to_equal([4, 0, 1])

    it "does not lower an unreachable suffix after an all-returning if":
        val shape = if_divergence_shape("fn target(a: bool) -> f64:\n    if a:\n        return 1.5\n    else:\n        return 2.5\n    return 99.5\n")
        expect(shape).to_equal([2, 0, 0])

    it "does not lower an unreachable suffix after an all-returning chain":
        val shape = if_divergence_shape("fn target(a: bool, b: bool) -> f64:\n    if a:\n        return 1.5\n    elif b:\n        return 2.5\n    else:\n        return 3.5\n    return 99.5\n")
        expect(shape).to_equal([3, 0, 0])

    it "keeps the false edge of a no-else if live":
        val shape = if_divergence_shape("fn target(a: bool) -> f64:\n    if a:\n        return 1.5\n    return 9.5\n")
        expect(shape).to_equal([2, 0, 1])

    it "keeps the false edge of a no-else chain live":
        val shape = if_divergence_shape("fn target(a: bool, b: bool) -> f64:\n    if a:\n        return 1.5\n    elif b:\n        return 2.5\n    return 9.5\n")
        expect(shape).to_equal([3, 0, 1])

    it "keeps a live value arm beside an early return":
        val shape = if_divergence_shape("fn target(a: bool) -> f64:\n    if a:\n        return 1.5\n    else:\n        2.5\n")
        expect(shape).to_equal([2, 0, 1])
