use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{strict_riscv_scalar_muldiv_projection}
use compiler.mir.hwir.riscv_scalar_muldiv_iterative_contract.{
    strict_riscv_scalar_muldiv_iterative_contract}

fn config(xlen: i32, profile: text) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: xlen, register_count: 32,
        profile: "riscv-gen2-" + profile, isa_profile: profile,
        compressed_decode_profile: "none")

describe "RISC-V Gen2 iterative M/Zmmul state contract":
    it "freezes exact RV32 multiply and RV64 divide state widths":
        val multiply = strict_riscv_scalar_muldiv_iterative_contract(
            strict_riscv_scalar_muldiv_projection(
                config(32, "rv32im"), "iterative", 0x022081B3).unwrap()).unwrap()
        expect(multiply.family).to_equal("multiply")
        expect(multiply.count_width).to_equal(6)
        expect(multiply.multiply_width).to_equal(64)
        expect(multiply.registers().any(_.name == "acc_reg" and _.bit_width == 64)).to_equal(true)
        expect(multiply.structural_sha256().len()).to_equal(64)

        val divide = strict_riscv_scalar_muldiv_iterative_contract(
            strict_riscv_scalar_muldiv_projection(
                config(64, "rv64im"), "iterative", 0x0220C1B3).unwrap()).unwrap()
        expect(divide.family).to_equal("divide")
        expect(divide.count_width).to_equal(7)
        expect(divide.remainder_width).to_equal(65)
        expect(divide.registers().any(_.name == "remainder_reg" and _.bit_width == 65)).to_equal(true)

    it "rejects forged family and projection receipts":
        val projection = strict_riscv_scalar_muldiv_projection(
            config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        var contract = strict_riscv_scalar_muldiv_iterative_contract(projection).unwrap()
        contract.family = "divide"
        expect(contract.diagnostic()).to_start_with("HWIR-E-RISCV-MULDIV-ITERATIVE-FAMILY")
        contract.family = "multiply"
        contract.projection_sha256 = "0"
        expect(contract.diagnostic()).to_start_with("HWIR-E-RISCV-MULDIV-ITERATIVE-INTEGRITY")
