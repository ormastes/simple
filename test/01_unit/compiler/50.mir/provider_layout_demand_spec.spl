# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
"""
# MIR: provider struct/class layouts registered on demand

`lower_module` used to relocate every provider struct/class layout of the
closure into every consumer. It now registers a provider declaration's rows
only once the consumer can name it: seeded from the consumer table, then from
every relocation and every field-index read. These examples pin that a
provider struct reached ONLY transitively -- through a field of an imported
struct, an Option / Result payload, a provider function's return, and an enum
payload -- gets exactly the layout rows the eager pass produced.
"""

use std.spec
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.{mir_provider_layout_leaf_v1}

val deep_src = "pub struct Leaf:\n    v: i64\n\npub struct Inner:\n    x: i64\n    leaf: Leaf\n\npub struct Boxed:\n    y: i64\n\npub struct Ret:\n    z: i64\n\npub struct Payload:\n    w: i64\n\npub enum Carry:\n    Has(Payload)\n    Empty\n\npub fn make_ret() -> Ret:\n    Ret(z: 3)\n"
val mid_src = "use lib.c.\{Inner, Leaf, Boxed, Ret, Payload, Carry, make_ret\}\n\npub struct Outer:\n    inner: Inner\n    maybe: Boxed?\n    tried: Result<Boxed, text>\n    carry: Carry\n\npub fn outer_ret() -> Ret:\n    make_ret()\n"
val consumer_src = "use lib.b.\{Outer, outer_ret\}\n\nfn read_inner(o: Outer) -> i64:\n    o.inner.leaf.v + o.inner.x\n\nfn read_ret() -> i64:\n    outer_ret().z\n\nfn read_maybe(o: Outer) -> i64:\n    if val b = o.maybe:\n        b.y\n    else:\n        0\n\nfn read_tried(o: Outer) -> i64:\n    match o.tried:\n        case Ok(b): b.y\n        case Err(_): 0\n\nfn read_carry(o: Outer) -> i64:\n    match o.carry:\n        case Has(p): p.w\n        case Empty: 0\n"

val watched = ["Leaf", "Inner", "Boxed", "Ret", "Payload", "Outer"]

fn layout_fingerprint(lowering: MirLowering) -> text:
    """ID-free layout rows of the watched declarations, sorted by key."""
    var keys: [text] = []
    for key in lowering.struct_field_order.keys():
        val leaf = mir_provider_layout_leaf_v1(key)
        if watched.contains(leaf):
            keys.push(key)
    keys = keys.sort()
    var out = ""
    for key in keys:
        out = out + key + " order=" + lowering.struct_field_order[key].join(",")
        if lowering.struct_field_type_name.has(key):
            out = out + " types=" + lowering.struct_field_type_name[key].join(",")
        if lowering.struct_field_type_ownership_key.has(key):
            out = out + " owners=" + lowering.struct_field_type_ownership_key[key].join(",")
        if lowering.struct_field_repr_name.has(key):
            out = out + " repr=" + lowering.struct_field_repr_name[key].join(",")
        out = out + "\n"
    out

fn lower_with(eager: bool) -> text:
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    modules["lib.c"] = parse_full_frontend(deep_src, "lib/c.spl", "lib.c", log)
    modules["lib.b"] = parse_full_frontend(mid_src, "lib/b.spl", "lib.b", log)
    val sources = [
        SourceFile(path: "lib/c.spl", content: deep_src, module_name: "lib.c"),
        SourceFile(path: "lib/b.spl", content: mid_src, module_name: "lib.b")
    ]
    val consumer_ast = parse_full_frontend(consumer_src, "app/main.spl", "app.main", log)
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var deep_lowering = hirlowering_for_module("lib.c", surfaces)
    val deep_hir = deep_lowering.lower_module(modules["lib.c"])
    var mid_lowering = hirlowering_for_module("lib.b", surfaces)
    val mid_hir = mid_lowering.lower_module(modules["lib.b"])
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    mir_lowering.provider_layouts_eager = eager
    val mir = mir_lowering.lower_module(consumer_hir, [deep_hir, mid_hir, consumer_hir])
    var out = "functions=" + mir.functions.len().to_string() + "\n"
    for e in mir_lowering.errors:
        out = out + "MIR " + e.message + "\n"
    out + layout_fingerprint(mir_lowering)

describe "provider layout demand registration":
    it "registers transitively reached provider layouts exactly as the eager pass":
        val demand = lower_with(false)
        val eager = lower_with(true)
        expect(demand).to_equal(eager)

    it "reaches the field-, Option/Result-, return- and enum-payload-only structs":
        val demand = lower_with(false)
        expect(demand.contains("Leaf order=v")).to_equal(true)
        expect(demand.contains("Boxed order=y")).to_equal(true)
        expect(demand.contains("Ret order=z")).to_equal(true)
        expect(demand.contains("Payload order=w")).to_equal(true)
        expect(demand.contains("MIR ")).to_equal(false)

describe "mir_provider_layout_leaf_v1":
    it "strips module qualification":
        expect(mir_provider_layout_leaf_v1("a.b::C")).to_equal("C")
        expect(mir_provider_layout_leaf_v1("lib.c.Inner")).to_equal("Inner")
        expect(mir_provider_layout_leaf_v1("Plain")).to_equal("Plain")

    it "ignores generic arguments":
        expect(mir_provider_layout_leaf_v1("Map<a.B, c.D>")).to_equal("Map")
        expect(mir_provider_layout_leaf_v1("lib.c::Box<T>")).to_equal("Box")
