# @req REQ-SSPEC-COMPILER
"""
# A bare variant name inside Some(..) / Ok(..) / Err(..) is a variant test

`match binding.embedded_role: case Some(PriorModuleTld): .. case Some(PackageInitTld):`
(10.frontend/cache_artifact/three_payload_semantic_closure.spl:581,588) and
`case Err(ScopeGenerationMismatch):`
(80.driver/cache/reference/reverse_reference_coordinator_v1.spl:809): the seed
TESTS the variant (oracle example below, executed by the seed interpreter).
Stage2 lowered the wrapped bare name as a binding, so the first `Some(..)` arm
matched every `Some` and the later arms were dead -- silently.

The wrapped slot's type now comes from the generic instantiation: the
subject's `T?` / `Option<T>` / `Result<T, E>` for a top-level arm, and the
declared slot type (`o: Op?`, `r: Result<i64, Op>`) for a payload slot. A
name several enums share (`Eq`) is resolved by the slot, not reported as
ambiguous. The or-binding check makes the lowering observable: bound names
differ per alternative, tested names bind nothing.

Provider `lib.data` + glob facade `lib.facade` + consumer `app.main`.
"""

# @tag: unit, compiler, mir, hir, enum, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val data_source = "pub enum Op:\n    Eq\n    Ne\n    Lt\n\npub enum Cmp:\n    Eq\n    Gt\n\npub enum Kind:\n    Var\n    Temp\n    Return\n\npub enum Role:\n    PriorTld\n    InitTld\n\npub enum Wrap:\n    W(o: Op?)\n    G(o: Option<Op>)\n    R(r: Result<i64, Op>)\n    Z\n\npub enum Demand:\n    body\n    mir\n\npub enum Hold:\n    H(d: Demand)\n    NoHold\n\npub enum Tk:\n    module\n    lib\n\npub enum Tk2:\n    module\n    other2\n"

val facade_source = "use lib.data.*\n\nexport use lib.data.\{Op, Cmp, Kind, Role, Wrap, Demand, Hold, Tk, Tk2\}\n"

fn lower_facade_consumer(body: text) -> text:
    val consumer_source = "use lib.facade.*\n\n" + body
    val log = Logger(level: 0)
    val data_ast = parse_full_frontend(data_source, "lib/data.spl", "lib.data", log)
    val facade_ast = parse_full_frontend(facade_source, "lib/facade.spl", "lib.facade", log)
    val consumer_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.data"] = data_ast
    modules["lib.facade"] = facade_ast
    val sources = [SourceFile(path: "lib/data.spl", content: data_source, module_name: "lib.data"), SourceFile(path: "lib/facade.spl", content: facade_source, module_name: "lib.facade")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var data_lowering = hirlowering_for_module("lib.data", surfaces)
    var facade_lowering = hirlowering_for_module("lib.facade", surfaces)
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val data_hir = data_lowering.lower_module(data_ast)
    val facade_hir = facade_lowering.lower_module(facade_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    mir_lowering.prescan_module_struct_names(data_hir)
    mir_lowering.prescan_module_struct_names(facade_hir)
    mir_lowering.prescan_module_struct_names(consumer_hir)
    val mir = mir_lowering.lower_module(consumer_hir, [data_hir, facade_hir, consumer_hir])
    var out = ""
    for e in consumer_lowering.errors:
        out = out + "hir: " + e.message + "\n"
    for e in mir_lowering.errors:
        out = out + "mir: " + e.message + "\n"
    print "errors: [{out}]"
    out

enum OracleRole:
    PriorTld
    InitTld

fn oracle_role_code(role: OracleRole?) -> i64:
    match role:
        case Some(PriorTld):
            1
        case Some(InitTld):
            2
        case _:
            0

describe "seed oracle":
    it "the seed tests a bare variant wrapped in Some(..)":
        expect(oracle_role_code(Some(OracleRole.PriorTld))).to_equal(1)
        expect(oracle_role_code(Some(OracleRole.InitTld))).to_equal(2)
        expect(oracle_role_code(nil)).to_equal(0)

fn expect_variant_tests(all: text):
    # Bound (pre-fix), the alternatives bind different names, which the
    # or-binding check reports; tested, nothing is bound.
    expect(all.contains("must bind the same variables")).to_equal(false)
    expect(all.contains("ambiguous")).to_equal(false)
    expect(all.contains("no variant")).to_equal(false)
    expect(all.contains("unresolved")).to_equal(false)

describe "bare variant names through a generic instantiation":
    it "Some(PriorTld) | Some(InitTld) over a Role? subject":
        expect_variant_tests(lower_facade_consumer("fn a(r: Role?) -> i64:\n    match r:\n        case Some(PriorTld) | Some(InitTld):\n            1\n        case _:\n            0\n"))

    it "a name shared by two enums: Some(Eq) | Some(Ne) over an Op? subject":
        expect_variant_tests(lower_facade_consumer("fn b(o: Op?) -> i64:\n    match o:\n        case Some(Eq) | Some(Ne):\n            1\n        case _:\n            0\n"))

    it "Err(Eq) | Err(Ne) over a Result<i64, Op> subject":
        expect_variant_tests(lower_facade_consumer("fn c(r: Result<i64, Op>) -> i64:\n    match r:\n        case Err(Eq) | Err(Ne):\n            1\n        case _:\n            0\n"))

    it "payload slots declared Op? / Option<Op>: W(Some(Eq)) | G(Some(Ne))":
        expect_variant_tests(lower_facade_consumer("fn d(w: Wrap) -> i64:\n    match w:\n        case W(Some(Eq)) | G(Some(Ne)):\n            1\n        case _:\n            0\n"))

    it "a payload slot declared Result<i64, Op>: R(Err(Eq)) | R(Err(Lt))":
        expect_variant_tests(lower_facade_consumer("fn e(w: Wrap) -> i64:\n    match w:\n        case R(Err(Eq)) | R(Err(Lt)):\n            1\n        case _:\n            0\n"))

describe "wrapped names that must keep binding":
    it "a lowercase name an enum declares, call-result subject: case Ok(body): body":
        val all = lower_facade_consumer("fn mk2() -> Result<i64, text>:\n    Ok(1)\n\nfn b2() -> i64:\n    match mk2():\n        case Ok(body):\n            body\n        case Err(e):\n            0\n")
        expect(all.contains("unresolved name")).to_equal(false)
        expect(all.contains("ambiguous")).to_equal(false)

    it "a lowercase name two enums declare, untyped subject: case Some(module): module":
        val all = lower_facade_consumer("fn b5(x) -> i64:\n    match x:\n        case Some(module):\n            module\n        case _:\n            0\n")
        expect(all.contains("unresolved name")).to_equal(false)
        expect(all.contains("ambiguous")).to_equal(false)

    it "a Capitalized name two enums share, untyped subject: case Some(Eq) binds":
        val all = lower_facade_consumer("fn b8(x) -> i64:\n    match x:\n        case Some(Eq):\n            1\n        case _:\n            0\n")
        expect(all.contains("ambiguous")).to_equal(false)

    it "a lowercase name in a payload slot whose enum declares it, untyped subject, binds":
        # Slot `d` of `Hold.H` is declared `Demand`, which has a unit variant
        # `body`. The arm body reads `body`, so it must be a binding.
        val all = lower_facade_consumer("fn b9(x) -> i64:\n    match x:\n        case H(body):\n            if body == Demand.mir: 1 else: 2\n        case _:\n            0\n")
        expect(all.contains("unresolved name")).to_equal(false)
