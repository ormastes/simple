# @req REQ-SSPEC-COMPILER
"""
# Stage2 MIR: method call on a trait-typed receiver

Owner decision 2026-11-05: trait-typed (dyn) receivers use the native
trait-object ABI. A field or parameter whose static type IS a trait is a
(data, table) pair and `recv.method(..)` lowers via `lower_native_trait_method`
to a vtable load plus `CallIndirect`, independent of how many implementors the
build closure holds. Concrete-typed receivers stay direct calls. The legacy
whole-closure devirtualization (`lower_trait_receiver_method_call`) remains
only for receivers with no native trait owner (see
`option_trait_payload_receiver_spec.spl`).

Bug: doc/08_tracking/bug/mir_trait_devirt_dead_after_native_abi_2026-11-05.md
"""
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_definitions.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.driver.driver_pipeline_lowering.{driver_trait_devirtualization_allowed_v1}

val TRAIT_SRC = "trait Store:\n    fn list(n: i64) -> i64\n\n"
val CONSUMER_SRC = "struct Consumer:\n    store: Store\n\nimpl Consumer:\n    fn run(n: i64) -> i64:\n        self.store.list(n)\n\nfn via_param(s: Store) -> i64:\n    s.list(2)\n\nfn main() -> i64:\n    0\n"
val MEM_IMPL_SRC = "struct Mem:\n    base: i64\n\nimpl Store for Mem:\n    fn list(n: i64) -> i64:\n        self.base + n\n\n"
val DISK_IMPL_SRC = "struct Disk:\n    root: i64\n\nimpl Store for Disk:\n    fn list(n: i64) -> i64:\n        self.root * n\n\n"
val GENERIC_IMPL_SRC = "struct Boxed<T>:\n    item: T\n\nimpl<T> Store for Boxed<T>:\n    fn list(n: i64) -> i64:\n        n\n\n"
val CONCRETE_SRC = "fn via_concrete(m: Mem) -> i64:\n    m.list(1)\n\nfn main() -> i64:\n    0\n"

# Cross-module closure: trait in A, implementor in B, consumer in C.
val XM_A_SRC = "pub trait Store:\n    fn list(n: i64) -> i64\n"
val XM_B_SRC = "use pkg.xm_a.\{Store\}\n\npub struct Mem:\n    base: i64\n\nimpl Store for Mem:\n    fn list(n: i64) -> i64:\n        self.base + n\n"
val XM_C_SRC = "use pkg.xm_a.\{Store\}\n\nstruct Consumer:\n    store: Store\n\nimpl Consumer:\n    fn run(n: i64) -> i64:\n        self.store.list(n)\n\nfn main() -> i64:\n    0\n"

struct Lowered:
    errors: [text]
    fatal_count: i64
    callees: [text]
    indirect_calls: i64

fn collect(ml: MirLowering, mir: MirModule) -> Lowered:
    var errors: [text] = []
    var fatal_count = 0
    for e in ml.errors:
        if e.fatal:
            fatal_count = fatal_count + 1
        errors = errors.push(e.message)
    var callees: [text] = []
    var indirect_calls = 0
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                callees = callees.push(name)
                            case _: pass
                    case MirInstKind.CallIndirect(_, _, _, _):
                        indirect_calls = indirect_calls + 1
                    case _: pass
    Lowered(errors: errors, fatal_count: fatal_count, callees: callees, indirect_calls: indirect_calls)

fn lower_source(src: text, closure_complete: bool) -> Lowered:
    val parsed = parse_full_frontend(src, "trait_recv.spl", "trait_recv", Logger(level: 0))
    var hl = HirLowering.with_filename("trait_recv.spl")
    val hir = hl.lower_module(parsed)
    expect(hl.errors.len()).to_equal(0)
    var ml = MirLowering.new(hir.symbols)
    ml.trait_impl_closure_complete = closure_complete
    val mir = ml.lower_module(hir)
    collect(ml, mir)

fn lower_cross_module(include_impl_module: bool, consumer_first: bool) -> Lowered:
    val a = parse_and_build_module(XM_A_SRC, "pkg/xm_a.spl")
    val b = parse_and_build_module(XM_B_SRC, "pkg/xm_b.spl")
    val c = parse_and_build_module(XM_C_SRC, "pkg/xm_c.spl")
    val surfaces = module_surfaces_from_modules(
        {"pkg.xm_a": a, "pkg.xm_b": b, "pkg.xm_c": c},
        [SourceFile(path: "pkg/xm_a.spl", content: XM_A_SRC, module_name: "pkg.xm_a"),
         SourceFile(path: "pkg/xm_b.spl", content: XM_B_SRC, module_name: "pkg.xm_b"),
         SourceFile(path: "pkg/xm_c.spl", content: XM_C_SRC, module_name: "pkg.xm_c")])
    expect(surfaces.is_ok()).to_equal(true)
    var hl = hirlowering_for_module("", surfaces.unwrap())
    hl.begin_module("pkg/xm_a.spl")
    hl.module_filename = "pkg/xm_a.spl"
    val a_hir = hl.lower_module(a)
    hl.begin_module("pkg/xm_b.spl")
    hl.module_filename = "pkg/xm_b.spl"
    val b_hir = hl.lower_module(b)
    hl.begin_module("pkg/xm_c.spl")
    hl.module_filename = "pkg/xm_c.spl"
    val c_hir = hl.lower_module(c)
    expect(hl.errors.len()).to_equal(0)
    # consumer_first: the consumer itself and a type-less trait module precede
    # the implementor, so lower_module's per-provider link tables (reused by
    # the trait-receiver pass) must stay index-aligned across skipped slots.
    var providers = if include_impl_module: [a_hir, b_hir, c_hir] else: [a_hir, c_hir]
    if consumer_first:
        providers = [c_hir, a_hir, b_hir]
    var ml = MirLowering.new(c_hir.symbols)
    ml.trait_impl_closure_complete = true
    for provider in providers:
        var prescan_mods: Dict<text, HirModule> = {}
        prescan_mods["provider"] = provider
        ml.prescan_module_struct_names(prescan_mods, "provider")
    val mir = ml.lower_module(c_hir, providers, false)
    collect(ml, mir)

fn count_matching(names: [text], needle: text) -> i64:
    var n = 0
    for name in names:
        if name.contains(needle):
            n = n + 1
    n

describe "stage2 MIR trait-typed receiver dispatch (native trait-object ABI)":
    it "dispatches a trait-typed field and parameter call through the vtable even with one implementor":
        val lowered = lower_source(TRAIT_SRC + MEM_IMPL_SRC + CONSUMER_SRC, true)
        expect(lowered.errors.len()).to_equal(0)
        # `self.store.list(n)` and `s.list(2)` both load a vtable slot.
        # Each trait-typed call site emits 2 CallIndirect: the slot call plus
        # the copy thunk (native_trait_conversion.spl). 2 sites -> 4.
        expect(lowered.indirect_calls).to_equal(4)
        expect(count_matching(lowered.callees, "Mem.list")).to_equal(0)
        expect(count_matching(lowered.callees, "rt_panic")).to_equal(0)

    it "dispatches through the vtable when no implementor is in the closure":
        val lowered = lower_source(TRAIT_SRC + CONSUMER_SRC, true)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(4)
        expect(count_matching(lowered.callees, "rt_panic")).to_equal(0)

    it "supports several implementors without guessing one":
        val lowered = lower_source(TRAIT_SRC + MEM_IMPL_SRC + DISK_IMPL_SRC + CONSUMER_SRC, true)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(4)
        expect(count_matching(lowered.callees, "Mem.list")).to_equal(0)
        expect(count_matching(lowered.callees, "Disk.list")).to_equal(0)

    it "dispatches through the vtable when the lowering does not cover the whole closure":
        val lowered = lower_source(TRAIT_SRC + MEM_IMPL_SRC + CONSUMER_SRC, false)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(4)
        expect(count_matching(lowered.callees, "Mem.list")).to_equal(0)


    it "dispatches through the vtable for a generic implementor too":
        val lowered = lower_source(TRAIT_SRC + GENERIC_IMPL_SRC + CONSUMER_SRC, true)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(4)
    it "keeps a concrete-typed receiver a direct call":
        val lowered = lower_source(TRAIT_SRC + MEM_IMPL_SRC + CONCRETE_SRC, true)
        expect(lowered.errors.len()).to_equal(0)
        expect(count_matching(lowered.callees, "Mem.list")).to_equal(1)
        expect(lowered.indirect_calls).to_equal(0)

    it "dispatches through the vtable across modules: trait in A, implementor in B, consumer in C":
        val lowered = lower_cross_module(true, false)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(2)
        expect(count_matching(lowered.callees, "Mem.list")).to_equal(0)

    it "dispatches through the vtable when the implementing module is outside the closure":
        val lowered = lower_cross_module(false, false)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(2)
        expect(count_matching(lowered.callees, "rt_panic")).to_equal(0)

    it "dispatches through the vtable when the consumer and a type-less module come first":
        val lowered = lower_cross_module(true, true)
        expect(lowered.errors.len()).to_equal(0)
        expect(lowered.indirect_calls).to_equal(2)

describe "driver gate for trait-object devirtualization":
    # The gate still guards the legacy whole-closure fallback used by
    # receivers without a native trait owner (e.g. `Trait?` payloads).
    it "allows the fallback only in whole-closure lanes that never archive MIR":
        expect(driver_trait_devirtualization_allowed_v1(true, false, false)).to_equal(true)
        expect(driver_trait_devirtualization_allowed_v1(true, true, false)).to_equal(false)
        expect(driver_trait_devirtualization_allowed_v1(true, false, true)).to_equal(false)
        expect(driver_trait_devirtualization_allowed_v1(false, false, false)).to_equal(false)

describe "lifted trait dispatch":
    it "dispatches lifted-closure trait calls through the vtable":
        val lifted_source = "fn invoke(callback: fn(Store) -> i64, s: Store) -> i64:\n    callback(s)\nfn via_lifts(s: Store) -> i64:\n    invoke(\\item: item.list(2), s) + invoke(\\item: item.list(3), s)\nfn main() -> i64:\n    0\n"
        val parsed = parse_full_frontend(TRAIT_SRC + MEM_IMPL_SRC + lifted_source,
            "lifted_trait_recv.spl", "lifted_trait_recv", Logger(level: 0))
        var hl = HirLowering.with_filename("lifted_trait_recv.spl")
        val hir = hl.lower_module(parsed)
        expect(hl.errors.len()).to_equal(0)
        var ml = MirLowering.new(hir.symbols)
        ml.trait_impl_closure_complete = true
        val mir = ml.lower_module(hir)
        val lowered = collect(ml, mir)
        expect(lowered.errors.len()).to_equal(0)
        expect(count_matching(lowered.callees, "Mem.list")).to_equal(0)
        # 2 lifted sites x 2 (slot call + copy thunk) + 2 from the
        # `callback(s)` call through the fn value in `invoke`.
        expect(lowered.indirect_calls).to_equal(6)
        expect(ml.devirtualized_calls).to_equal(0)
