# @req REQ-SSPEC-COMPILER
# @req REQ-GENERIC-ANNOTATION-FIELD
# @tag: unit, compiler, mir, mono, generics
#
# A type-parameter field (`struct W<T>: v: T`) is typed by the INSTANCE it is
# read from: `r.v + r.v` is a string concatenation on a `W<text>` and an
# integer add on a `W<i64>`.
#
# Two regressions of the first BUG-IT-6 fix are pinned here:
# - the per-instance record was keyed by LocalId and never reset, so a
#   `W(v: "s")` built in one function typed the fields of whatever local
#   reused its id in the NEXT function;
# - a read whose instance was not built in the same function lost its type
#   silently: the pre-fix compiler refused `r.v + r.v` ("operator overload
#   for struct T"), the fix emitted an integer add of two field words.
#
# H-ANNOT regression: same-module generic annotations must retain arguments
# on parameters, returns, locals and fields. Only genuinely argumentless
# receivers remain unknown instances.
#
# Each example runs HIR -> 40.mono -> 50.mir -> MirToLlvm in-process.
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mono.monomorphize_integration.{run_monomorphization_with_diagnostics}

val MODULE = "gfp_probe"

val PRELUDE = "struct W<T>:\n" +
    "    v: T\n" +
    "\n" +
    "struct Holder:\n" +
    "    w: W<text>\n" +
    "    n: W<i64>\n" +
    "\n"

struct Shaped:
    ir: text
    errors: [text]

fn shape(body: text) -> Shaped:
    val src = PRELUDE + body
    val file = "testdata/gfp_probe.spl"
    var hl = HirLowering.with_filename(file)
    val hir = hl.lower_module(parse_full_frontend(src, file, MODULE, Logger(level: 0)))
    var errors: [text] = []
    for e in hl.errors:
        errors.push("hir: " + e.message)
    var mods: Dict<text, HirModule> = {}
    mods[MODULE] = hir
    val (mono, _stats, diags) = run_monomorphization_with_diagnostics(mods)
    for d in diags:
        errors.push("mono: " + d)
    val m: HirModule = mono[MODULE]
    var lowering = MirLowering.new_for_target(m.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(m)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        errors.push("mir: " + e.message)
    val ir = MirToLlvm.create(MODULE, CodegenTarget.X86_64, nil).translate_module(mir)
    Shaped(ir: ir, errors: errors)

fn function_body(ir: text, fn_name: text) -> [text]:
    """Lines of the LLVM function whose `define` names `fn_name`."""
    var out: [text] = []
    var inside = false
    for line in ir.split("\n"):
        val l: text = line
        if l.starts_with("define ") and (l.contains("." + fn_name + "(") or l.contains("@" + fn_name + "(")):
            inside = true
        if inside:
            out = out.push(l)
            if l.len() == 1:
                inside = false
    out

fn concatenates(lines: [text]) -> bool:
    """True when these lines CALL a string concatenation (the runtime's
    `declare ... @rt_strcat` is in every module, so only a call counts)."""
    for line in lines:
        val l: text = line
        if l.contains("call ") and (l.contains("@rt_strcat") or l.contains("@rt_string_concat")):
            return true
    false

fn adds_integers(lines: [text]) -> bool:
    for line in lines:
        val l: text = line
        if l.contains(" = add ") and l.contains(" i64 %") and not l.contains("; "):
            return true
    false

fn verdict(s: Shaped, fn_name: text) -> text:
    """`concat`, `add`, or the first diagnostic."""
    if s.errors.len() > 0:
        return s.errors[0]
    val body = function_body(s.ir, fn_name)
    if body.len() == 0:
        return "no function {fn_name}"
    if concatenates(body):
        return "concat"
    if adds_integers(body):
        return "add"
    "neither"

fn refused(s: Shaped, fn_name: text) -> bool:
    verdict(s, fn_name).contains("operator overload for struct T")

describe "type-param field: the instance record does not leak across functions":
    it "annotated parameters are not typed by text instances an earlier function built":
        # The leak made these integer parameters reuse build's text instance
        # record. Their own annotations must determine integer arithmetic.
        val s = shape(
            "fn build() -> i64:\n" +
            "    val a = W(v: \"a\")\n" +
            "    val b = W(v: \"b\")\n" +
            "    val c = W(v: \"c\")\n" +
            "    val d = W(v: \"d\")\n" +
            "    val e = W(v: \"e\")\n" +
            "    val f = W(v: \"f\")\n" +
            "    a.v.len() + b.v.len() + c.v.len() + d.v.len() + e.v.len() + f.v.len()\n" +
            "\n" +
            "fn zzz_rd(p0: W<i64>, p1: W<i64>) -> i64:\n" +
            "    p0.v + p1.v\n" +
            "\n" +
            "fn main() -> i64:\n" +
            "    build() + zzz_rd(W(v: 1), W(v: 2))\n")
        expect(verdict(s, "zzz_rd")).to_equal("add")

    it "an instance built in the next function is typed by that function alone":
        val s = shape(
            "fn build() -> i64:\n" +
            "    val a = W(v: \"a\")\n" +
            "    a.v.len()\n" +
            "\n" +
            "fn zzz_sum() -> i64:\n" +
            "    val n = W(v: 1)\n" +
            "    n.v + n.v\n")
        expect(verdict(s, "zzz_sum")).to_equal("add")

describe "type-param field: routes on which the instance is known":
    it "text instance constructed in this function":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val r = W(v: \"a\")\n" +
            "    r.v + r.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "integer instance constructed in this function":
        val s = shape(
            "fn probe() -> i64:\n" +
            "    val r = W(v: 1)\n" +
            "    r.v + r.v\n")
        expect(verdict(s, "probe")).to_equal("add")

    it "array element":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val xs = [W(v: \"a\"), W(v: \"b\")]\n" +
            "    xs[0].v + xs[1].v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "nested instance: W<W<text>>":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val r = W(v: W(v: \"a\"))\n" +
            "    r.v.v + r.v.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "var rebound to another instance of the same type":
        val s = shape(
            "fn probe() -> text:\n" +
            "    var r = W(v: \"a\")\n" +
            "    r = W(v: \"b\")\n" +
            "    r.v + r.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "copy of a constructed instance":
        val s = shape(
            "fn probe() -> text:\n" +
            "    val r = W(v: \"a\")\n" +
            "    val q = r\n" +
            "    q.v + q.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

describe "type-param field: annotated instances survive every source route":
    it "parameter annotated W<text>":
        val s = shape(
            "fn probe(r: W<text>) -> text:\n" +
            "    r.v + r.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "result of a call returning W<text>":
        val s = shape(
            "fn mk() -> W<text>:\n" +
            "    W(v: \"a\")\n" +
            "\n" +
            "fn probe() -> text:\n" +
            "    val r = mk()\n" +
            "    r.v + r.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "typed let bound to a parameter":
        val s = shape(
            "fn probe(p: W<text>) -> text:\n" +
            "    val q: W<text> = p\n" +
            "    q.v + q.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "field of a non-generic struct declared w: W<text>":
        val s = shape(
            "fn probe(h: Holder) -> text:\n" +
            "    h.w.v + h.w.v\n")
        expect(verdict(s, "probe")).to_equal("concat")

    it "parameter declared without type arguments":
        val s = shape(
            "fn probe(r: W) -> i64:\n" +
            "    r.v + r.v\n")
        expect(refused(s, "probe")).to_equal(true)

    it "moving such a field without operating on it still lowers":
        val s = shape(
            "fn probe(r: W<text>) -> text:\n" +
            "    r.v\n")
        expect(s.errors.len()).to_equal(0)
