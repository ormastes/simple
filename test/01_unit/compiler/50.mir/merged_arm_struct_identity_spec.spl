# @req REQ-SSPEC-COMPILER
"""
Direct contract for mir_merged_arm_struct_name (mir_lowering_stmts.spl).

Bug untyped_val_if_expr_struct_boxed_as_int_dict_key_2026-10-25: in
`val k = if c: pick(n) else: K(id: 99)` the call arm carried its struct only as
a HIR type (no struct_value_syms entry), so it disagreed with the constructor
arm and the merge slot became a plain i64 that was int-boxed as a Dict key.
An arm with no recorded struct name now falls back to the name recovered from
its HIR type; disagreeing names still leave the slot unknown.
"""
# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use std.spec.step
use compiler.mir.mir_lowering_stmts.{mir_merged_arm_struct_name}

describe "mir_merged_arm_struct_name":
    it "lets a call arm's HIR-recovered name agree with a constructor arm":
        step("recorded [K, ''] + hir ['', K] -> K")
        expect(mir_merged_arm_struct_name(["K", ""], ["", "K"])).to_equal("K")

    it "keeps a recorded name over the HIR fallback":
        step("recorded wins")
        expect(mir_merged_arm_struct_name(["K", "K"], ["Other", ""])).to_equal("K")

    it "stays unknown when arms disagree":
        step("K vs J -> ''")
        expect(mir_merged_arm_struct_name(["K", ""], ["", "J"])).to_equal("")

    it "stays unknown when an arm has no struct evidence at all":
        step("K vs nothing -> ''")
        expect(mir_merged_arm_struct_name(["K", ""], ["", ""])).to_equal("")

    it "is unknown for no arms":
        step("empty -> ''")
        expect(mir_merged_arm_struct_name([], [])).to_equal("")
