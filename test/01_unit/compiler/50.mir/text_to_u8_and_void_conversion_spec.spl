# @req REQ-SSPEC-COMPILER
"""
# Text receiver to_u8 lowering, void destination conversion, nested use provenance, and match pass arms

Regression coverage ensuring root compiler fixes eliminate caller workarounds:
1. Calling `.to_u8()` on a `text` receiver (e.g. `for ch in name: buf.push(ch.to_u8())`)
   extracts byte 0 via `__simple_rt_string_byte_at` before narrowing to `U8`.
2. `MirToLlvm.emit_value_type_conversion` with `dst_ty == "void"` or `"unit"`
   returns `"0"` cleanly without recording an unsupported conversion error.
3. Multi-line lexical `use` inside a function body preserves `MirCallOrigin.Source`
   provenance (0 unproven call-origin sites) and stays retained by skeleton scanning.
4. `match` arms ending in `pass` inside a `for` loop lower to LLVM IR with 0 errors.
"""

# @tag: unit, compiler, mir

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_instruction_graph.{mir_unproven_call_origin_sites_v1}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}

fn compile_snippet_ir(source: text) -> text:
    val log = Logger(level: 0)
    val ast = parse_full_frontend(source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["app.main"] = ast
    val sources = [
        SourceFile(path: "app/main.spl", content: source, module_name: "app.main")
    ]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var hir_lowering = hirlowering_for_module(ast.name, surfaces)
    val hir_mod = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir_mod.symbols)
    var prescan_mods: Dict<text, HirModule> = {}
    prescan_mods["app.main"] = hir_mod
    mir_lowering.prescan_module_struct_names(prescan_mods, "app.main")
    val mir_mod = mir_lowering.lower_module(hir_mod, [hir_mod])
    var translator = MirToLlvm.create("app.main", CodegenTarget.X86_64, None)
    val ir = translator.translate_module(mir_mod)
    if translator.codegen_errors.len() > 0:
        return "ERRORS:" + translator.codegen_errors.join("; ")
    ir

describe "text.to_u8(), void scalar conversion, nested use provenance, and match pass arms":
    it "lowers text.to_u8() through __simple_rt_string_byte_at without ptr->i8 cast error":
        val src = "fn first_byte(s: text) -> u8:\n    s.to_u8()\n\nfn loop_bytes(name: text) -> [u8]:\n    var out: [u8] = []\n    for ch in name:\n        out.push(ch.to_u8())\n    out\n"
        val ir = compile_snippet_ir(src)
        expect(ir.starts_with("ERRORS:")).to_equal(false)
        expect(ir).to_contain("__simple_rt_string_byte_at")

    it "discards non-void scalar conversion to void/unit without recording codegen error":
        var translator = MirToLlvm.create("probe.void.conv", CodegenTarget.X86_64, None)
        val void_res = translator.emit_value_type_conversion("%1", "i64", "void", false)
        val unit_res = translator.emit_value_type_conversion("%2", "i32", "unit", true)
        expect(void_res).to_equal("0")
        expect(unit_res).to_equal("0")
        expect(translator.codegen_errors.len()).to_equal(0)

    it "preserves proven MirCallOrigin.Source on multi-line lexical use inside a function body":
        val log = Logger(level: 0)
        val owner_src = "pub struct Receipt:\n    complete: bool\n\npub fn cleanup_retry_v1(id: u64, gen: u64) -> Receipt:\n    Receipt(complete: id == gen)\n"
        val caller_src = "fn run_retry(id: u64) -> bool:\n    use pkg.owner.{{\n        cleanup_retry_v1\n    }}\n    cleanup_retry_v1(id, 1u64).complete\n"
        val owner_ast = parse_full_frontend(owner_src, "pkg/owner.spl", "pkg.owner", log)
        val caller_ast = parse_full_frontend(caller_src, "pkg/caller.spl", "pkg.caller", log)
        var modules: Dict<text, Module> = {}
        modules["pkg.owner"] = owner_ast
        modules["pkg.caller"] = caller_ast
        val sources = [
            SourceFile(path: "pkg/owner.spl", content: owner_src, module_name: "pkg.owner"),
            SourceFile(path: "pkg/caller.spl", content: caller_src, module_name: "pkg.caller")
        ]
        val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
        var owner_hl = hirlowering_for_module(owner_ast.name, surfaces)
        val owner_hir = owner_hl.lower_module(owner_ast)
        var caller_hl = hirlowering_for_module(caller_ast.name, surfaces)
        val caller_hir = caller_hl.lower_module(caller_ast)
        expect(caller_hl.errors.len()).to_equal(0)
        var ml = MirLowering.new(caller_hir.symbols)
        var prescan: Dict<text, HirModule> = {}
        prescan["pkg.owner"] = owner_hir
        prescan["pkg.caller"] = caller_hir
        ml.prescan_module_struct_names(prescan, "pkg.owner")
        ml.prescan_module_struct_names(prescan, "pkg.caller")
        val caller_mir = ml.lower_module(caller_hir, [owner_hir, caller_hir])
        val unproven = mir_unproven_call_origin_sites_v1(caller_mir)
        expect(unproven.len()).to_equal(0)

    it "lowers match arms ending in pass inside a for loop without codegen error":
        val src = "enum Kind:\n    A(i64)\n    B\n\nfn scan(xs: [Kind]) -> i64:\n    var found = -1\n    for idx in 0..xs.len():\n        match xs[idx]:\n            case A(v):\n                if v == 7:\n                    found = idx\n                pass\n            case _: pass\n    found\n"
        val ir = compile_snippet_ir(src)
        expect(ir.starts_with("ERRORS:")).to_equal(false)
