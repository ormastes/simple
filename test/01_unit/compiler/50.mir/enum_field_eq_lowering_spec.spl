# @req REQ-SSPEC-COMPILER
"""
# Enum `==` on an imported struct-field projection lowers as an enum compare

Stage2 failed building simple_test_runner with
`unresolved method call: operator overload for struct ResourceEvidenceQuality`
on `left.evidence_quality == ResourceEvidenceQuality.Unavailable`, where both
the struct and the enum come from another module. The enum operand was routed
to the struct `__eq__` dispatch instead of the enum compare (rt_native_eq).

r13 Stage 2 (2026-10-19) reproduced the same error natively with THREE modules
when the compare sits in a NON-entry module: `lib.model` declares `enum Kind`,
`app.consumer` declares `struct LocalProv(kind: Kind)` and compares
`p.kind != Kind.PureSimple`, `app.main` only calls `prov_ok`. The native
pipeline lowers every module on ONE shared MirLowering after prescanning all
of them (driver_pipeline_lowering.spl), entry first; the rows below drive that
exact shape in-process, with and without a HIR codec round-trip of the enum
module (the shard-cache path dependency HIR takes natively).
"""

# @tag: unit, compiler, mir, enum

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode_stable}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val provider_source = "pub enum Quality:\n    Exact\n    Unavailable\n\npub struct Usage:\n    quality: Quality\n    n: i64\n"
val consumer_source = "use lib.dep.\{Quality, Usage\}\n\nfn is_missing(u: Usage) -> bool:\n    u.quality == Quality.Unavailable\n\nfn is_present(u: Usage) -> bool:\n    u.quality != Quality.Unavailable\n\nfn both(a: Usage, b: Usage) -> bool:\n    a.quality == b.quality and b.quality == Quality.Exact\n\nfn same(a: Usage, b: Usage) -> bool:\n    a.quality == b.quality\n"

fn consumer_mir_errors() -> text:
    val log = Logger(level: 0)
    val provider_ast = parse_full_frontend(provider_source, "lib/dep.spl", "lib.dep", log)
    val consumer_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.dep"] = provider_ast
    val sources = [SourceFile(path: "lib/dep.spl", content: provider_source, module_name: "lib.dep")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var provider_lowering = hirlowering_for_module("lib.dep", surfaces)
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val provider_hir = provider_lowering.lower_module(provider_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var hm: Dict<text, HirModule> = {}
    hm["lib.dep"] = provider_hir
    hm["app.main"] = consumer_hir
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    mir_lowering.prescan_module_struct_names(hm, "lib.dep")
    mir_lowering.prescan_module_struct_names(hm, "app.main")
    val consumer_mir = mir_lowering.lower_module(consumer_hir)
    var out = ""
    for e in mir_lowering.errors:
        out = out + e.message + "\n"
    out

describe "enum equality on an imported struct field":
    it "lowers field == Enum.Variant without struct operator dispatch":
        val errs = consumer_mir_errors()
        print "mir errors: [{errs}]"
        expect(errs.contains("operator overload for struct")).to_equal(false)

# Three modules, compare in the NON-entry module, one shared MirLowering.
val model_source = "pub enum Kind:\n    PureSimple\n    Other\n\nexport Kind\n"
val nonentry_source = "use lib.model.\{Kind\}\n\npub struct LocalProv:\n    kind: Kind\n    flag: bool\n\npub fn prov_ok(p: LocalProv) -> bool:\n    if p.kind != Kind.PureSimple or not p.flag:\n        return false\n    true\n\nexport LocalProv, prov_ok\n"
val entry_source = "use lib.model.\{Kind\}\nuse app.consumer.\{LocalProv, prov_ok\}\n\nfn main() -> i64:\n    if prov_ok(LocalProv(kind: Kind.PureSimple, flag: true)):\n        print \"ok\"\n    0\n"

# `std.`-spelled import of a `lib.`-keyed module: the native closure registers
# src/lib files under their path-derived `lib.common....` name while import
# lines say `std.common....` (resolve_module_key swaps the prefix). r13 p3b8
# failed in exactly this shape: `use std.common.zz_natfront_probe.model.{Kind}`.
val std_model_source = "pub enum Kind:\n    PureSimple\n    Other\n\nexport Kind\n"
val std_nonentry_source = "use std.common.zz.model.\{Kind\}\n\npub struct LocalProv:\n    kind: Kind\n    flag: bool\n\npub fn prov_ok(p: LocalProv) -> bool:\n    if p.kind != Kind.PureSimple or not p.flag:\n        return false\n    true\n\nexport LocalProv, prov_ok\n"
val std_entry_source = "use std.common.zz.model.\{Kind\}\nuse app.consumer.\{LocalProv, prov_ok\}\n\nfn main() -> i64:\n    if prov_ok(LocalProv(kind: Kind.PureSimple, flag: true)):\n        print \"ok\"\n    0\n"

fn shared_lowering_errors(roundtrip_model: bool) -> text:
    shared_lowering_errors_for(roundtrip_model, "lib.model", "lib/model.spl", model_source, nonentry_source, entry_source)

fn shared_lowering_errors_for(roundtrip_model: bool, model_key: text, model_path: text, model_src: text, consumer_src: text, entry_src: text) -> text:
    val log = Logger(level: 0)
    val model_ast = parse_full_frontend(model_src, model_path, model_key, log)
    val consumer_ast = parse_full_frontend(consumer_src, "app/consumer.spl", "app.consumer", log)
    val entry_ast = parse_full_frontend(entry_src, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules[model_key] = model_ast
    modules["app.consumer"] = consumer_ast
    modules["app.main"] = entry_ast
    val sources = [
        SourceFile(path: model_path, content: model_src, module_name: model_key),
        SourceFile(path: "app/consumer.spl", content: consumer_src, module_name: "app.consumer"),
        SourceFile(path: "app/main.spl", content: entry_src, module_name: "app.main"),
    ]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var model_lowering = hirlowering_for_module(model_key, surfaces)
    var consumer_lowering = hirlowering_for_module("app.consumer", surfaces)
    var entry_lowering = hirlowering_for_module("app.main", surfaces)
    var model_hir = model_lowering.lower_module(model_ast)
    if roundtrip_model:
        val decoded = hir_module_decode_stable(hir_module_encode(model_hir))
        if decoded == nil:
            return "codec: model module did not round-trip\n"
        model_hir = decoded.unwrap()
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    val entry_hir = entry_lowering.lower_module(entry_ast)
    var hm: Dict<text, HirModule> = {}
    hm[model_key] = model_hir
    hm["app.consumer"] = consumer_hir
    hm["app.main"] = entry_hir
    var ml = MirLowering.new(entry_hir.symbols)
    # Entry first in the prescan too: the native driver walks
    # ctx.hir_modules.keys() with the entry ahead of its dependencies, so the
    # NAME-keyed struct rows are first-wins filled from the entry's imported
    # copy of LocalProv (entry-local symbol ids), not from app.consumer.
    ml.prescan_module_struct_names(hm, "app.main")
    ml.prescan_module_struct_names(hm, "app.consumer")
    ml.prescan_module_struct_names(hm, model_key)
    # Entry first, then dependencies -- the native feed order.
    ml.lower_module(entry_hir, [], true)
    ml.lower_module(consumer_hir, [], false)
    ml.lower_module(model_hir, [], false)
    var out = ""
    for e in ml.errors:
        out = out + e.message + "\n"
    out

describe "enum equality in a non-entry module on the shared lowering":
    it "lowers p.kind != Kind.Variant in the non-entry module (in-process HIR)":
        val errs = shared_lowering_errors(false)
        print "mir errors: [{errs}]"
        expect(errs.contains("operator overload for struct")).to_equal(false)

    it "lowers it when the enum module is lib.-keyed but imported as std. (r13 p3b8 shape)":
        val errs = shared_lowering_errors_for(false, "lib.common.zz.model", "src/lib/common/zz/model.spl", std_model_source, std_nonentry_source, std_entry_source)
        print "mir errors (std import): [{errs}]"
        expect(errs.contains("operator overload for struct")).to_equal(false)


# Same-named types in different modules: the field type must be rebound by its
# module-qualified ownership key (`<module>::<Name>`), never by bare name. An
# owner the importer's table cannot name exactly degrades to unknown (Error)
# instead of capturing whichever `Status` the importer happens to see.
# (A full three-module fixture with two `Status` enums is blocked by a
# separate HIR surface bug: the provider's own `Status` field already binds to
# the other module's `Status` in its own SymbolTable.)
val owner_dep_source = "pub enum Status:\n    Ready\n    Done\n\npub struct Job:\n    status: Status\n    n: i64\n"
val owner_consumer_source = "use lib.dep.\{Job, Status\}\n\nfn probe(j: Job) -> bool:\n    j.status == Status.Done\n"

fn field_binding_for_owner_key(owner_key_override: text) -> text:
    val log = Logger(level: 0)
    val dep_ast = parse_full_frontend(owner_dep_source, "lib/dep.spl", "lib.dep", log)
    val consumer_ast = parse_full_frontend(owner_consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.dep"] = dep_ast
    val sources = [SourceFile(path: "lib/dep.spl", content: owner_dep_source, module_name: "lib.dep")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var dep_lowering = hirlowering_for_module("lib.dep", surfaces)
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val dep_hir = dep_lowering.lower_module(dep_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var hm: Dict<text, HirModule> = {}
    hm["lib.dep"] = dep_hir
    hm["app.main"] = consumer_hir
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    mir_lowering.prescan_module_struct_names(hm, "lib.dep")
    mir_lowering.prescan_module_struct_names(hm, "app.main")
    mir_lowering.lower_module(consumer_hir)
    if not mir_lowering.struct_field_hir_type.contains("Job"):
        return "no-layout"
    if owner_key_override != "":
        mir_lowering.struct_field_type_ownership_key["Job"] = [owner_key_override, ""]
    val declared = mir_lowering.struct_field_hir_type["Job"][0]
    val rebound = mir_lowering.declared_field_type_in_current_table("Job", 0, declared)
    match rebound.kind:
        case HirTypeKind.Named(sym, _):
            "named:{mir_lowering.symbols.symbol_name_scalar_raw(sym.id)}@{mir_lowering.symbols.symbol_defining_module_scalar_raw(sym.id)}"
        case HirTypeKind.Error: "unknown"
        case _: "other"

describe "same-named enums in different modules":
    it "binds an imported field type to its exact owning module":
        val binding = field_binding_for_owner_key("")
        print "owner binding: {binding}"
        expect(binding).to_equal("named:Status@lib.dep")

    it "does not capture a same-named enum when the owning module differs":
        val binding = field_binding_for_owner_key("lib.elsewhere::Status")
        print "foreign-owner binding: {binding}"
        expect(binding).to_equal("unknown")


# The native --entry-closure HIR of the entry module carries its OWN copy of
# an imported struct (`LocalProv`) whose field type names an ENTRY-table
# symbol id, and the driver prescans the entry first, so the name-keyed field
# rows can come from that copy. The rows above never build such a copy. Here
# the entry imports the consumer before the enum and declares extra structs,
# so the copy's `Kind` id (entry table) and the consumer's `Kind` id differ,
# and the consumer declares padding so the entry id names a different symbol
# in the consumer table. NOTE: this row is green on the r13 SOURCE as well
# (measured 2026-10-20) -- the in-process lowering does not reproduce the r13
# native failure; the native fixture
# test/fixtures/native_enum_eq_nonentry/ is the discriminating guard.
val padded_consumer_source = "use lib.model.\{Kind\}\n\npub struct PadA:\n    a: i64\n\npub struct PadB:\n    b: i64\n\npub struct LocalProv:\n    kind: Kind\n    flag: bool\n\npub fn prov_ok(p: LocalProv) -> bool:\n    if p.kind != Kind.PureSimple or not p.flag:\n        return false\n    true\n\nexport LocalProv, prov_ok, PadA, PadB\n"
val swapped_entry_source = "use app.consumer.\{LocalProv, prov_ok\}\nuse lib.model.\{Kind\}\n\nstruct E1:\n    x: i64\n\nstruct E2:\n    y: i64\n\nstruct E3:\n    z: i64\n\nfn main() -> i64:\n    if prov_ok(LocalProv(kind: Kind.PureSimple, flag: true)):\n        print \"ok\"\n    0\n"

fn materialize_entry_copy(entry_hir: HirModule, consumer_hir: HirModule) -> HirModule:
    """Insert the consumer's LocalProv into the entry module, rebound to the
    entry table's ids (what native import materialization produces)."""
    val kind_id = entry_hir.symbols.lookup_exact_type("Kind")
    val prov_id = entry_hir.symbols.lookup_exact_type("LocalProv")
    if kind_id == nil or prov_id == nil:
        return entry_hir
    val kind_sym = kind_id.unwrap()
    val prov_sym = prov_id.unwrap()
    for s in consumer_hir.structs.values():
        if s.name == "LocalProv":
            var copy = s
            var fields: [HirField] = []
            var rebound = false
            for f in s.fields:
                var nf = f
                match f.type_.kind:
                    case HirTypeKind.Named(sym, args):
                        if consumer_hir.symbols.symbol_name_scalar_raw(sym.id) == "Kind":
                            if sym.id == kind_sym.id:
                                return entry_hir
                            nf.type_ = HirType(kind: HirTypeKind.Named(kind_sym, args), span: f.type_.span)
                            rebound = true
                    case _: ()
                fields.push(nf)
            if not rebound:
                return entry_hir
            copy.fields = fields
            copy.symbol = prov_sym
            var out = entry_hir
            var structs = out.structs
            structs[prov_sym] = copy
            out.structs = structs
            return out
    entry_hir

fn materialized_copy_errors() -> text:
    val log = Logger(level: 0)
    val model_ast = parse_full_frontend(model_source, "lib/model.spl", "lib.model", log)
    val consumer_ast = parse_full_frontend(padded_consumer_source, "app/consumer.spl", "app.consumer", log)
    val entry_ast = parse_full_frontend(swapped_entry_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.model"] = model_ast
    modules["app.consumer"] = consumer_ast
    modules["app.main"] = entry_ast
    val sources = [
        SourceFile(path: "lib/model.spl", content: model_source, module_name: "lib.model"),
        SourceFile(path: "app/consumer.spl", content: padded_consumer_source, module_name: "app.consumer"),
        SourceFile(path: "app/main.spl", content: swapped_entry_source, module_name: "app.main"),
    ]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var model_lowering = hirlowering_for_module("lib.model", surfaces)
    var consumer_lowering = hirlowering_for_module("app.consumer", surfaces)
    var entry_lowering = hirlowering_for_module("app.main", surfaces)
    val model_hir = model_lowering.lower_module(model_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    val entry_plain = entry_lowering.lower_module(entry_ast)
    val entry_hir = materialize_entry_copy(entry_plain, consumer_hir)
    # The copy only exists when the ids really differ (see materialize_entry_copy).
    var copies = 0
    for s in entry_hir.structs.values():
        if s.name == "LocalProv": copies = copies + 1
    if copies != 1:
        return "setup: entry module carries no misaligned LocalProv copy\n"
    var hm: Dict<text, HirModule> = {}
    hm["lib.model"] = model_hir
    hm["app.consumer"] = consumer_hir
    hm["app.main"] = entry_hir
    var ml = MirLowering.new(entry_hir.symbols)
    ml.prescan_module_struct_names(hm, "app.main")
    ml.prescan_module_struct_names(hm, "app.consumer")
    ml.prescan_module_struct_names(hm, "lib.model")
    ml.lower_module(entry_hir, [], true)
    ml.lower_module(consumer_hir, [], false)
    ml.lower_module(model_hir, [], false)
    var out = ""
    for e in ml.errors:
        out = out + e.message + "\n"
    out

describe "enum equality with the entry's materialized import copy":
    it "lowers the non-entry compare when the entry copy's field ids are misaligned":
        val errs = materialized_copy_errors()
        print "mir errors (materialized copy): [{errs}]"
        expect(errs.contains("setup:")).to_equal(false)
        expect(errs.contains("operator overload for struct")).to_equal(false)
