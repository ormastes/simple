# @req: REQ-COMPILER-50MIR-001

# codex-system-test
# @manual_section RISC-V Gen2 bounded RV64 C.LD and C.SD typed-row contract
"""Exercise source-level typed-HWIR construction for the bounded RV64 C.LD/C.SD rows.

The checks inspect row shape, fixed conversion vectors, configuration rejection,
and explicit normalized effects. They do not run emitted RTL or qualify a
processor, memory subsystem, or complete compressed ISA.
"""

use std.spec.*
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef}
use compiler.mir.hwir.zca_rv64_ld_sd_rows.{strict_zca_cld_rv64_row_hwir, strict_zca_csd_rv64_row_hwir, strict_zca_cld_rv64_outcome_hwir, strict_zca_csd_rv64_outcome_hwir}

fn constant_value(module: HwModuleDef, name: text) -> i64:
    for constant in module.constants:
        if constant.name == name: return constant.value
    -1

fn has_comb(module: HwModuleDef, op_name: text, result: text, lhs: text, rhs: text) -> bool:
    for op in module.comb_ops:
        if op.op == op_name and op.result == result and op.lhs == lhs and op.rhs == rhs: return true
    false

fn unary_source(module: HwModuleDef, result: text) -> text:
    for op in module.comb_ops:
        if op.result == result: return op.lhs
    ""

fn has_select(module: HwModuleDef, result: text, condition: text, when_true: text) -> bool:
    for op in module.select_ops:
        if op.result == result and op.condition == condition and op.when_true == when_true: return true
    false

fn field(value: i64, divisor: i64, modulus: i64) -> i64:
    (value / divisor) % modulus

fn cld_reference(parcel: i64) -> i64:
    val rd = 8 + field(parcel, 4, 8)
    val rs1 = 8 + field(parcel, 128, 8)
    val immediate = field(parcel, 32, 4) * 64 + field(parcel, 1024, 8) * 8
    immediate * 1048576 + rs1 * 32768 + 3 * 4096 + rd * 128 + 3

fn csd_reference(parcel: i64) -> i64:
    val rs2 = 8 + field(parcel, 4, 8)
    val rs1 = 8 + field(parcel, 128, 8)
    val immediate = field(parcel, 32, 4) * 64 + field(parcel, 1024, 8) * 8
    (immediate / 32) * 33554432 + rs2 * 1048576 + rs1 * 32768 + 3 * 4096 + (immediate % 32) * 128 + 35

describe "mission-critical RV64 C.LD and C.SD rows":
    # @req REQ-G2-001 REQ-G2-002 NFR-G2-003 NFR-G2-012
    it "should pin C.LD vector 0x6480 to canonical LD x8,8(x9) 0x0084b403":
        # @req: REQ-G2-001
        step("Verify: should pin C.LD vector 0x6480 to canonical LD x8,8(x9) 0x0084b403")
        step("Elaborate the bounded RV64 C.LD row and inspect its typed conversion structure")
        val row = strict_zca_cld_rv64_row_hwir("rv64_cld", CoreConfig.rv64_zca_mission_critical()).ok().unwrap()
        expect(row.shape_diagnostic()).to_equal("")
        expect(constant_value(row, "opcode_tag_mask")).to_equal(57347)  # oracle: 57347 — named expected value from the requirement
        expect(constant_value(row, "expected_tag")).to_equal(24576)  # oracle: 24576 — named expected value from the requirement
        expect(constant_value(row, "dword_funct3")).to_equal(12288)  # oracle: 12288 — named expected value from the requirement
        expect(constant_value(row, "base_opcode")).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(has_comb(row, "shl", "imm_7_6", "imm_7_6_compact", "left_shift_6")).to_equal(true)
        expect(has_comb(row, "shl", "imm_5_3", "imm_5_3_compact", "left_shift_3")).to_equal(true)
        expect(has_select(row, "canonical_instruction", "is_c_ld", "ld_instruction")).to_equal(true)
        expect(cld_reference(25728)).to_equal(8696835)  # oracle: 8696835 — named expected value from the requirement
        expect(cld_reference(24576)).to_equal(275459)  # oracle: 275459 — named expected value from the requirement
        expect(cld_reference(32764)).to_equal(260552579)  # oracle: 260552579 — named expected value from the requirement

    # @req REQ-G2-001 REQ-G2-002 NFR-G2-003 NFR-G2-012
    it "should pin C.SD vector 0xe880 to canonical SD x8,16(x9) 0x0084b823":
        # @req: REQ-G2-002
        step("Verify: should pin C.SD vector 0xe880 to canonical SD x8,16(x9) 0x0084b823")
        step("Elaborate the bounded RV64 C.SD row and inspect its typed conversion structure")
        val row = strict_zca_csd_rv64_row_hwir("rv64_csd", CoreConfig.rv64_zca_mission_critical()).ok().unwrap()
        expect(row.shape_diagnostic()).to_equal("")
        expect(constant_value(row, "opcode_tag_mask")).to_equal(57347)  # oracle: 57347 — named expected value from the requirement
        expect(constant_value(row, "expected_tag")).to_equal(57344)  # oracle: 57344 — named expected value from the requirement
        expect(constant_value(row, "dword_funct3")).to_equal(12288)  # oracle: 12288 — named expected value from the requirement
        expect(constant_value(row, "base_opcode")).to_equal(35)  # oracle: 35 — named expected value from the requirement
        expect(has_comb(row, "shl", "imm_upper_field", "immediate_shifted_5", "left_shift_25")).to_equal(true)
        expect(has_comb(row, "shl", "imm_low_field", "imm_low_bits", "left_shift_7")).to_equal(true)
        expect(has_select(row, "canonical_instruction", "is_c_sd", "sd_instruction")).to_equal(true)
        expect(csd_reference(59520)).to_equal(8697891)  # oracle: 8697891 — named expected value from the requirement
        expect(csd_reference(57344)).to_equal(8663075)  # oracle: 8663075 — named expected value from the requirement
        expect(csd_reference(65532)).to_equal(251116579)  # oracle: 251116579 — named expected value from the requirement

    # @req REQ-G2-002 NFR-G2-002 NFR-G2-003
    it "should reject both rows during RV32 elaboration because encodings overlap Zcf":
        # @req: REQ-G2-011
        step("Verify: should reject both rows during RV32 elaboration because encodings overlap Zcf")
        step("Attempt to elaborate the RV64-only rows under the incompatible RV32 profile")
        val config = CoreConfig.rv32_zca_mission_critical()
        expect(strict_zca_cld_rv64_row_hwir("rv32_cld", config).err().unwrap()).to_contain("HWIR-E-ZCA-RV64-MEMORY")
        expect(strict_zca_csd_rv64_row_hwir("rv32_csd", config).err().unwrap()).to_contain("HWIR-E-ZCA-RV64-MEMORY")

    # @req REQ-G2-011 NFR-G2-012
    it "should gate truthful architectural effects with explicit match_legal":
        # @req: REQ-COMPILER-50MIR-001
        step("Verify: should gate truthful architectural effects with explicit match_legal")
        step("Construct normalized C.LD and C.SD outcomes and inspect their legality gates")
        val config = CoreConfig.rv64_zca_mission_critical()
        val load = strict_zca_cld_rv64_outcome_hwir("rv64_cld_outcome", config).ok().unwrap()
        val store = strict_zca_csd_rv64_outcome_hwir("rv64_csd_outcome", config).ok().unwrap()
        expect(load.shape_diagnostic()).to_equal("")
        expect(store.shape_diagnostic()).to_equal("")
        expect(unary_source(load, "legal")).to_equal("match_legal")
        expect(unary_source(load, "effect_register_write")).to_equal("match_legal")
        expect(unary_source(load, "effect_memory_read")).to_equal("match_legal")
        expect(unary_source(load, "effect_memory_write")).to_equal("zero_flag")
        expect(unary_source(store, "effect_register_write")).to_equal("zero_flag")
        expect(unary_source(store, "effect_memory_read")).to_equal("zero_flag")
        expect(unary_source(store, "effect_memory_write")).to_equal("match_legal")
        expect(has_select(load, "match_legal", "cld_is_c_ld", "one_flag")).to_equal(true)
        expect(has_select(store, "match_legal", "csd_is_c_sd", "one_flag")).to_equal(true)
