# @req REQ-SSPEC-COMPILER
# @tag: unit, compiler, mir, generics
#
# GREEN since the call-site encode of bare-T method params (Dict-valued generic classes).
# Scope items 2-3 of the bug doc (T? / T returns, bare-T fields) remain open.
#
# Erased <-> concrete i64 boundary of a generic-CLASS method
# (doc/08_tracking/bug/native_erased_generic_optional_return_2026-11-15.md,
# native_generic_payload_encoding_2026-11-15.md M2 "known_wrong" rows).
#
# A `Dict<K, T>` holds TAGGED words: concrete code boxes on write
# (rt_value_int_wide) and an erased method body decodes on read
# (rt_value_as_int_wide). The method's own write `self.hash[k] = value`
# must therefore store the same tagged word, otherwise the read divides the
# raw value by 8 (9000000000 -> 1125000000, 7 -> 0).
#
# Each example runs HIR -> 50.mir -> MirToLlvm in-process and reads the
# LLVM text of ONE function.
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}

val MODULE = "gmeb_probe"

val PRELUDE = "class Store<T>:\n" +
    "    hash: Dict<i64, T>\n" +
    "\n" +
    "impl Store<T>:\n" +
    "    fn get(node: i64) -> Result<T, text>:\n" +
    "        if self.hash.contains_key(node):\n" +
    "            return Ok(self.hash[node])\n" +
    "        Err(\"absent\")\n" +
    "\n" +
    "    me set(node: i64, value: T):\n" +
    "        self.hash[node] = value\n" +
    "\n"

struct Shaped:
    ir: text
    errors: [text]

fn shape(body: text) -> Shaped:
    val src = PRELUDE + body
    val file = "testdata/gmeb_probe.spl"
    var hl = HirLowering.with_filename(file)
    val hir = hl.lower_module(parse_full_frontend(src, file, MODULE, Logger(level: 0)))
    var errors: [text] = []
    for e in hl.errors:
        errors.push("hir: " + e.message)
    val m: HirModule = hir
    var lowering = MirLowering.new_for_target(m.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(m)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        errors.push("mir: " + e.message)
    val ir = MirToLlvm.create(MODULE, CodegenTarget.X86_64, nil).translate_module(mir)
    Shaped(ir: ir, errors: errors)

fn function_body(ir: text, fn_name: text) -> [text]:
    var out: [text] = []
    var inside = false
    for line in ir.split("\n"):
        val l: text = line
        if l.starts_with("define ") and (l.contains("." + fn_name + "(") or l.contains("@" + fn_name + "(")):
            inside = true
        if inside:
            out = out.push(l)
            if l.len() == 1:
                inside = false
    out

fn count_calls(lines: [text], callee: text) -> i64:
    var n = 0
    for line in lines:
        val l: text = line
        if l.contains("call ") and l.contains("@" + callee + "("):
            n = n + 1
    n

fn dump(s: Shaped, fn_name: text):
    if (env_get("GMEB_DUMP") ?? "") == "1":
        print "---- {fn_name}"
        for line in function_body(s.ir, fn_name):
            print line

val PROBE = "fn probe(v: i64) -> i64:\n" +
    "    val h: Dict<i64, i64> = {}\n" +
    "    var s = Store(hash: h)\n" +
    "    s.set(1, v)\n" +
    "    match s.get(1):\n" +
    "        case Ok(x): x\n" +
    "        case Err(_): -1\n"

describe "generic-class method: erased <-> concrete i64 Dict<K, T> boundary":
    it "lowers without diagnostics":
        val s = shape(PROBE)
        expect(s.errors.len()).to_equal(0)

    it "the erased read decodes the stored word exactly once":
        val s = shape(PROBE)
        dump(s, "Store.get")
        expect(count_calls(function_body(s.ir, "Store.get"), "rt_value_as_int_wide")).to_equal(1)

    it "the write path encodes the KEY and the VALUE (method body or its caller)":
        # Measured 2026-11-17 (bin/simple.exe 11-17 07:54): Store.set emits ONE
        # rt_value_int_wide -- for the key -- and stores the raw `value`
        # param (`rt_dict_set(h, key_enc, %value)`); probe passes `v` raw.
        # Expected 2 encodes on the write path (key + value).
        val s = shape(PROBE)
        dump(s, "Store.set")
        dump(s, "probe")
        val encodes = count_calls(function_body(s.ir, "Store.set"), "rt_value_int_wide") +
            count_calls(function_body(s.ir, "probe"), "rt_value_int_wide")
        expect(encodes).to_equal(2)
