# @req REQ-SSPEC-COMPILER
"""
# Up-front struct/class layout inventory registration for the direct MIR lane

Struct/class analog of module_enum_inventory_spec.spl (#3527 follow-up).

The driver's struct-name prescan (prescan_module_struct_names) registers
name-keyed struct field ORDER + declared field types for every module, but it
deliberately never fills the struct default-value rows
(struct_field_has_default / struct_field_default_expr) and never fills any
NAME-keyed class row: class_type_names (bare name, composite layout key, and
mir_class_identity) plus struct_field_order / struct_field_has_default /
struct_field_default_expr under the same three keys. Only each module's own
lower_module pass writes those -- and in the direct per-module lane the entry
lowers BEFORE its dependency modules, and an undemanded dependency's own pass
may be the only place its rows would ever come from. Param binding and
value-method dispatch consult class_type_names to tell a class from a
same-named value struct, so an empty map in that window degrades exactly the
receiver/constructor metadata the manual stage3 per-module object sweep keeps
losing (confirmed sweep failure family after #3527: payload-typed enum static
constructor sites and lingering B5b in sdn/value.spl contexts).

register_module_composite_inventory_v1 closes the gap the same way the enum
inventory does: read declaration data through the module's own SymbolTable,
write NAME-keyed maps only (field_map's per-module SymbolIds stay untouched),
keep-first on name collisions, and let the module's own lower_module pass
overwrite unconditionally when its turn comes.

These probes contract-test the helper directly: class rows under all three
keys, struct default rows, quiet idempotent re-registration, and a lowering
that consumes the inventory without errors.
"""

# @tag: unit, compiler, mir, struct, class, driver

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{SymbolTable, SymbolKind, HirTypeKind, HirSymbol}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirStruct}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn composite_hir(src: text, file: text) -> HirModule:
    val parsed = parse_full_frontend(src, file, "fixture_composite_inventory", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    hir_lowering.lower_module(parsed)

fn composite_ctx():
    driver_mir_target_context(driver_core_compile_options_default())

describe "module composite inventory registration":
    it "registers class name-keyed rows under bare, layout, and identity keys":
        val src = "class Meter:\n    ticks: i64\n\nfn read(m: Meter) -> i64:\n    m.ticks\n"
        val hir = composite_hir(src, "testdata/fixture_composite_inventory.spl")
        var lowering = MirLowering.new_for_target(SymbolTable.new(), composite_ctx())
        lowering.register_module_composite_inventory_v1([hir])
        expect(lowering.class_type_names.has("Meter")).to_equal(true)
        expect(lowering.struct_field_order.has("Meter")).to_equal(true)
        expect(lowering.struct_field_order["Meter"]).to_equal(["ticks"])
        expect(lowering.struct_field_has_default.has("Meter")).to_equal(true)
        expect(lowering.struct_field_has_default["Meter"]).to_equal([false])
        expect(lowering.struct_field_default_expr.has("Meter")).to_equal(true)

    it "registers struct default-value rows the struct-name prescan skips":
        val src = "struct Gauge:\n    level: i64\n\nfn level_of(g: Gauge) -> i64:\n    g.level\n"
        val hir = composite_hir(src, "testdata/fixture_composite_inventory_gauge.spl")
        var lowering = MirLowering.new_for_target(SymbolTable.new(), composite_ctx())
        lowering.register_module_composite_inventory_v1([hir])
        expect(lowering.struct_field_has_default.has("Gauge")).to_equal(true)
        expect(lowering.struct_field_has_default["Gauge"]).to_equal([false])
        expect(lowering.struct_field_default_expr.has("Gauge")).to_equal(true)
        expect(lowering.class_type_names.has("Gauge")).to_equal(false)

    it "re-registration is quiet and keeps the first module's rows":
        val src = "class Meter:\n    ticks: i64\n\nfn read(m: Meter) -> i64:\n    m.ticks\n"
        val hir = composite_hir(src, "testdata/fixture_composite_inventory.spl")
        var lowering = MirLowering.new_for_target(SymbolTable.new(), composite_ctx())
        lowering.register_module_composite_inventory_v1([hir])
        lowering.register_module_composite_inventory_v1([hir])
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.struct_field_order["Meter"]).to_equal(["ticks"])

    it "a lowering that consumes the inventory constructs the class without errors":
        val src = "class Meter:\n    ticks: i64\n\nimpl Meter:\n    me tick():\n        self.ticks = self.ticks + 1\n\nfn make() -> Meter:\n    val m = Meter(ticks: 0)\n    m.tick()\n    m\n"
        val hir = composite_hir(src, "testdata/fixture_composite_inventory_make.spl")
        var lowering = MirLowering.new_for_target(hir.symbols, composite_ctx())
        lowering.register_module_composite_inventory_v1([hir])
        val mir = lowering.lower_module(hir)
        var messages: [text] = []
        for e in lowering.errors:
            messages = messages.push(e.message)
        var all = ""
        for m in messages:
            all = all + m + "\n"
        print "errors: [{all}]"
        expect(all.contains("unresolved")).to_equal(false)
        expect(all.contains("missing native trait")).to_equal(false)
        var found_make = false
        for function in mir.functions.values():
            if function.name.ends_with(".make") or function.name == "make":
                found_make = true
        assert_true(found_make)

    # Bug llvmglobals_2026-10-25: a struct default expression carries its
    # PROVIDER's SymbolIds. `MirStatic.visibility: Visibility = Visibility.Private`
    # omitted at a consumer site lowered the enum id raw in the consumer table
    # ("unregistered declaration '...SymbolId::is_valid'"). Provider struct
    # registration must relocate defaults; EnumLit must survive relocation.
    it "relocates a provider struct's enum field default into the consumer table":
        val src = "enum Vis:\n    Private\n    Public\n\nstruct Holder:\n    n: i64\n    vis: Vis = Vis.Private\n"
        val hir = composite_hir(src, "testdata/fixture_composite_inventory_enum_default.spl")
        var holder_default: HirExpr? = nil
        var holder: HirStruct? = nil
        for s in hir.structs.values():
            if s.name == "Holder":
                holder = Some(s)
                holder_default = Some(s.fields[1].default)
        assert_true(holder.?)
        var consumer = SymbolTable.new()
        var pad = 0
        while pad < 40:
            consumer.define("consumer_pad_{pad}", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, false, nil)
            pad = pad + 1
        var lowering = MirLowering.new_for_target(consumer, composite_ctx())
        val relocated = lowering.relocate_provider_default(holder_default.unwrap(), hir.symbols, {})
        var relocated_name = ""
        match relocated.kind:
            case HirExprKind.EnumLit(ty, variant, _):
                expect(variant).to_equal("Private")
                match ty.kind:
                    case HirTypeKind.Named(symbol, _):
                        relocated_name = lowering.symbols.symbol_name_scalar_raw(symbol.id)
                    case _: ()
            case _: ()
        expect(relocated_name).to_equal("Vis")

    it "overwrites the raw bare-name default row only when the consumer does not own the name":
        val src = "enum Vis:\n    Private\n    Public\n\nstruct Holder:\n    n: i64\n    vis: Vis = Vis.Private\n"
        val hir = composite_hir(src, "testdata/fixture_composite_inventory_enum_default_row.spl")
        var holder: HirStruct? = nil
        for s in hir.structs.values():
            if s.name == "Holder":
                holder = Some(s)
        assert_true(holder.?)
        val holder_def: HirStruct = holder.unwrap()
        var consumer = SymbolTable.new()
        var pad = 0
        while pad < 40:
            consumer.define("consumer_pad_{pad}", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, false, nil)
            pad = pad + 1
        var lowering = MirLowering.new_for_target(consumer, composite_ctx())
        # Raw inventory row (provider ids), then the prescan-owned layout rows.
        lowering.register_module_composite_inventory_v1([hir])
        lowering.struct_field_order["Holder"] = ["n", "vis"]
        val holder_symbol: HirSymbol = hir.symbols.get_symbol_raw(holder_def.symbol.id).unwrap()
        lowering.struct_bare_layout_owner["Holder"] = lowering.composite_layout_key(holder_symbol)
        val raw_row: [HirExpr] = lowering.struct_field_default_expr["Holder"]
        val raw_kind_ok = match raw_row[1].kind:
            case HirExprKind.EnumLit(_, _, _): true
            case _: false
        expect(raw_kind_ok).to_equal(true)

        # A consumer that declares its own `Holder` keeps its row untouched.
        lowering.register_provider_struct(holder_def, hir.symbols, true)
        val kept: [HirExpr] = lowering.struct_field_default_expr["Holder"]
        var kept_name = ""
        match kept[1].kind:
            case HirExprKind.EnumLit(ty, _, _):
                match ty.kind:
                    case HirTypeKind.Named(symbol, _):
                        kept_name = lowering.symbols.symbol_name_scalar_raw(symbol.id)
                    case _: ()
            case _: ()
        expect(kept_name == "Vis").to_equal(false)

        # An importing consumer gets the relocated row under the bare name.
        lowering.register_provider_struct(holder_def, hir.symbols, false)
        val row: [HirExpr] = lowering.struct_field_default_expr["Holder"]
        expect(lowering.struct_field_has_default["Holder"]).to_equal([false, true])
        var row_name = ""
        match row[1].kind:
            case HirExprKind.EnumLit(ty, variant, _):
                expect(variant).to_equal("Private")
                match ty.kind:
                    case HirTypeKind.Named(symbol, _):
                        row_name = lowering.symbols.symbol_name_scalar_raw(symbol.id)
                    case _: ()
            case _: ()
        expect(row_name).to_equal("Vis")
