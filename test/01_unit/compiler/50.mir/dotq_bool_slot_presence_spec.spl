# Repro for doc/08_tracking/bug/stage2_dotq_presence_value_is_nil_sentinel_2026-11-03.
# `.?` into a DECLARED bool slot is the presence predicate (seed rule
# present_value_as_bool_arg); the native/stage2 lowering handed the slot the
# raw nil word / payload handle instead (0xC0000005 on text? payloads).
# Seed-side twin: test/01_unit/language/dotq_value_local_binding_spec.spl.
# Native fixture: test/fixtures/repro/verify_sweep2/b00_dotq.spl.
use std.spec

fn takes_flag(flag: bool) -> bool:
    flag

describe ".? into a declared bool slot (pointer payload)":
    it "absent text? binds false":
        val mp: text? = nil
        val hm: bool = mp.?
        expect(hm).to_equal(false)

    it "present text? binds true":
        val sp: text? = Some("x")
        val hs: bool = sp.?
        expect(hs).to_equal(true)

    it "absent and present compare as plain bools":
        val mp: text? = nil
        val sp: text? = Some("x")
        val hm: bool = mp.?
        val hs: bool = sp.?
        expect(hm == false and hs == true).to_equal(true)

    it "bool call argument takes presence":
        val mp: text? = nil
        val sp: text? = Some("x")
        expect(takes_flag(mp.?)).to_equal(false)
        expect(takes_flag(sp.?)).to_equal(true)

describe ".? into an untyped local keeps T?":
    it "present text? keeps the payload":
        val sp: text? = Some("x")
        val got = sp.?
        expect(got ?? "absent").to_equal("x")

    it "absent text? stays nil":
        val mp: text? = nil
        val got = mp.?
        expect(got ?? "absent").to_equal("absent")
