# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: `for b in bytes` over a `[u8]` reads through rt_bytes_u8_at

`lower_for_array_indexed` read every element with `rt_array_get` and decoded
it as a tagged value. The C `rt_array_get` hands back the RAW byte of a packed
`[u8]`, so the tagged decode (`>> 3`) turned 56 into 7. A `[u8]` element must
read through `rt_bytes_u8_at` -- the checked accessor the index read `arr[i]`
already uses (expr_dispatch.spl `typed_u8_runtime_read`) -- followed by a
plain i64 -> u8 cast. `rt_bytes_u8_at` returns one zero-extended octet for
both runtime layouts (packed bytes and tagged word slots), so no host
endianness or sign extension is involved. Non-u8 element types keep
`rt_array_get`.
"""

# @tag: unit, compiler, mir, for-in

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_data.*

struct ForBytesLowered:
    errors: text
    callees: [text]

fn for_bytes_lower(src: text) -> ForBytesLowered:
    val log = Logger(level: 0)
    val ast = parse_full_frontend(src, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["app.main"] = ast
    val sources = [SourceFile(path: "app/main.spl", content: src, module_name: "app.main")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var lowering = hirlowering_for_module("app.main", surfaces)
    val hir = lowering.lower_module(ast)
    var hir_modules: Dict<text, HirModule> = {}
    hir_modules["app.main"] = hir
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.prescan_module_struct_names(hir_modules, "app.main")
    val mir = mir_lowering.lower_module(hir)
    var errs = ""
    for e in lowering.errors:
        errs = errs + "hir: " + e.message + "\n"
    for e in mir_lowering.errors:
        errs = errs + "mir: " + e.message + "\n"
    var callees: [text] = []
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                callees.push(name)
                            case _: pass
                    case _: pass
    ForBytesLowered(errors: errs, callees: callees)

fn callee_count(items: [text], wanted: text) -> i64:
    var n = 0
    for item in items:
        if item == wanted:
            n = n + 1
    n

describe "for-in over a [u8] reads each byte through rt_bytes_u8_at":
    it "a [u8] param: one rt_bytes_u8_at, no rt_array_get":
        val low = for_bytes_lower("fn sum(bytes: [u8]) -> i64:\n" +
            "    var acc = 0\n" +
            "    for b in bytes:\n" +
            "        acc = acc + b\n" +
            "    acc\n")
        print "errors: [{low.errors}] rt_bytes_u8_at={callee_count(low.callees, "rt_bytes_u8_at")} rt_array_get={callee_count(low.callees, "rt_array_get")}"
        expect(low.errors).to_equal("")
        expect(callee_count(low.callees, "rt_bytes_u8_at")).to_equal(1)
        expect(callee_count(low.callees, "rt_array_get")).to_equal(0)

    it "an [i64] param keeps rt_array_get and never takes the byte accessor":
        val low = for_bytes_lower("fn sum(xs: [i64]) -> i64:\n" +
            "    var acc = 0\n" +
            "    for x in xs:\n" +
            "        acc = acc + x\n" +
            "    acc\n")
        print "errors: [{low.errors}] rt_bytes_u8_at={callee_count(low.callees, "rt_bytes_u8_at")} rt_array_get={callee_count(low.callees, "rt_array_get")}"
        expect(low.errors).to_equal("")
        expect(callee_count(low.callees, "rt_bytes_u8_at")).to_equal(0)
        expect(callee_count(low.callees, "rt_array_get")).to_equal(1)
