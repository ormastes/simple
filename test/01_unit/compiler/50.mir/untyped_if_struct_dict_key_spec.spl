# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# Regression spec for untyped_val_if_expr_struct_boxed_as_int_dict_key_2026-10-25.
# An UNANNOTATED `val k = if c: <struct call> else: <struct ctor>` used as a
# Dict<Struct, _> key must be stored as the struct handle. Stage 2 typed the
# binding as i64, so the index-set boxed the key via rt_value_int_wide
# (handle << 3) and reading the key back out of `.keys()` SEGVed.
"""
## Purpose and audience
Purpose: Prove an untyped if-expression struct binding keeps its struct type as a Dict key.
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""
use std.spec.step

use std.spec.*

struct UiKey:
    id: i64

impl UiKey:
    fn ok() -> bool:
        self.id >= 0

fn ui_pick(n: i64) -> UiKey:
    UiKey(id: n)

fn ui_untyped_call_arm(n: i64) -> i64:
    var d: Dict<UiKey, i64> = {}
    val real = ui_pick(n)
    val k = if real.ok(): real else: UiKey(id: 99)
    d[k] = 7
    var got = -1
    for kk in d.keys():
        val c: UiKey = kk
        got = c.id
    got

fn ui_typed_call_arm(n: i64) -> i64:
    var d: Dict<UiKey, i64> = {}
    val real = ui_pick(n)
    val k: UiKey = if real.ok(): real else: UiKey(id: 99)
    d[k] = 7
    var got = -1
    for kk in d.keys():
        val c: UiKey = kk
        got = c.id
    got

describe "untyped if-expression struct value as a Dict key":
    # @manual scenario evidence
    it "keeps the struct key when the binding is annotated":
        step("keeps the struct key when the binding is annotated")
        expect(ui_typed_call_arm(5)).to_equal(5)

    it "keeps the struct key when the binding is unannotated":
        step("keeps the struct key when the binding is unannotated")
        expect(ui_untyped_call_arm(5)).to_equal(5)
        expect(ui_untyped_call_arm(-3)).to_equal(99)
