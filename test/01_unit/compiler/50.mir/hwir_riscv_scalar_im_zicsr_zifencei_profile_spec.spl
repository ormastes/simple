use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use lib.hardware.riscv_common.isa.scalar_database.{riscv_scalar_decoder_plan,
    riscv_scalar_elaborate_provider, riscv_scalar_entries_for_isa_profile,
    riscv_scalar_lookup_profile}

describe "combined IM Zicsr Zifencei scalar profile":
    it "elaborates the complete RV32 and RV64 M, CSR, and FENCE.I row sets":
        val rv32 = riscv_scalar_entries_for_isa_profile("rv32im_zicsr_zifencei").unwrap()
        val rv64 = riscv_scalar_entries_for_isa_profile("rv64im_zicsr_zifencei").unwrap()
        expect(rv32.len()).to_equal(55)
        expect(rv64.len()).to_equal(72)
        for rows in [rv32, rv64]:
            expect(rows.any(_.id == "rv.m.mulhu")).to_equal(true)
            expect(rows.any(_.id == "rv.m.div")).to_equal(true)
            expect(rows.any(_.id == "rv.m.divu")).to_equal(true)
            expect(rows.any(_.id == "rv.m.rem")).to_equal(true)
            expect(rows.any(_.id == "rv.m.remu")).to_equal(true)
            expect(rows.any(_.id == "rv.zicsr.csrrw")).to_equal(true)
            expect(rows.any(_.id == "rv.zicsr.csrrci")).to_equal(true)
            expect(rows.any(_.id == "rv.i.fence_i")).to_equal(true)
        for word in ["rv64.m.mulw", "rv64.m.divw", "rv64.m.divuw", "rv64.m.remw", "rv64.m.remuw"]:
            expect(rv64.any(_.id == word)).to_equal(true)
            expect(rv32.any(_.id == word)).to_equal(false)

    it "binds concrete combined configurations, the M provider, and exact plans":
        val rv32_config = CoreConfig.rv32im_zicsr_zifencei()
        val rv64_config = CoreConfig.rv64im_zicsr_zifencei()
        expect(rv32_config.diagnostic()).to_equal("")
        expect(rv64_config.diagnostic()).to_equal("")
        val first = riscv_scalar_decoder_plan(rv64_config.isa_profile).unwrap()
        val second = riscv_scalar_decoder_plan(rv64_config.isa_profile).unwrap()
        expect(first.diagnostic()).to_equal("")
        expect(first.structural_sha256()).to_equal(second.structural_sha256())
        val provider = riscv_scalar_elaborate_provider(rv32_config.isa_profile, "iterative").unwrap()
        expect(provider.provider_for(riscv_scalar_lookup_profile(0x02004033,
            rv32_config.isa_profile).unwrap()).unwrap()).to_equal("iterative")
        expect(riscv_scalar_elaborate_provider(rv32_config.isa_profile, "none").is_err()).to_equal(true)
        val wrong_xlen = CoreConfig(xlen: 64, physical_address_bits: 56, register_count: 32,
            profile: "bad-im-combined", isa_profile: "rv32im_zicsr_zifencei",
            compressed_decode_profile: "none")
        expect(wrong_xlen.diagnostic()).to_contain("RV32")
