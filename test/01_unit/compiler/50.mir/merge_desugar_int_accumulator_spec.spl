use std.spec.{describe, it, expect}

# Bug optional_field_read_after_nil_check_reads_option_box_2026-10-25:
# collection_desugar rewrites `x = x + <ident>` into `x.merge(<ident>)`. MIR's
# scalar guard (mir_type_is_scalar_numeric) read `found.kind` through a `T?`
# after a nil check, which read the Option box in Stage-2-built compilers, so
# every int accumulator lowered to an array extend and the sum was lost.
# Red only when built natively by an affected compiler.

describe "x = x + y accumulators (merge desugar)":
    it "keeps an int accumulator whose addend is a variable":
        var a = 0
        var k = 0
        while k < 3:
            a = a + k
            k = k + 1
        expect(a).to_equal(3)
    it "keeps a for-loop accumulator":
        var s = 0
        for i in 0..5:
            s = s + i
        expect(s).to_equal(10)
    it "keeps a straight-line x = x + y":
        var c = 1
        val y = 2
        c = c + y
        expect(c).to_equal(3)
