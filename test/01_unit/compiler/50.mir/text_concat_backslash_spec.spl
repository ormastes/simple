# @req REQ-SSPEC-COMPILER
"""
# Text concat preserves backslashes

Regression: the seed dropped the backslash in `"x" + "\lld"`. Covers the
const-folded form and runtime (non-foldable) operands.
"""

# @tag:in-development -- bug text_concat_backslash_dropped_seed_2026-11-03
# @tag: unit, compiler, mir, text, native

use std.spec.{describe, it, expect}

fn cat_rt(a: text, b: text) -> text:
    a + b

describe "text concat with backslashes":
    it "const-folds with the backslash intact":
        val s = "x" + "\lld"
        expect(s.len()).to_equal(5)
        expect(s.substring(0, 1)).to_equal("x")
        expect(s.substring(1, 2)).to_equal("\\")
        expect(s.substring(2, 5)).to_equal("lld")

    it "keeps the backslash for runtime operands":
        val s = cat_rt("x", "\lld")
        expect(s.len()).to_equal(5)
        expect(s.substring(1, 2)).to_equal("\\")
        expect(s).to_equal("x\lld")

    it "keeps consecutive and trailing backslashes":
        expect(cat_rt("a\\", "\b").len()).to_equal(4)
        expect(cat_rt("C:\\", "tools\\").len()).to_equal(9)
        expect(("\\" + "\\").len()).to_equal(2)

    it "builds a Windows path":
        val p = cat_rt("C:\dev", "\simple")
        expect(p).to_equal("C:\dev\simple")
        expect(p.len()).to_equal(13)
