use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{evaluate_riscv_scalar_muldiv,
    strict_riscv_scalar_muldiv_projection}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    RiscvScalarIsaEntry, riscv_scalar_decoder_plan}

fn muldiv_config(xlen: i32, profile: text) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: xlen, register_count: 32,
        profile: "riscv-gen2-" + profile, isa_profile: profile,
        compressed_decode_profile: "none")

fn result(config: CoreConfig, provider: text, instruction: u32, lhs: i64, rhs: i64) -> i64:
    val plan = strict_riscv_scalar_muldiv_projection(config, provider, instruction).unwrap()
    evaluate_riscv_scalar_muldiv(plan, lhs, rhs).unwrap().rd_value

describe "RISC-V Gen2 M/Zmmul operation projection":
    it "freezes canonical decode, register, provider, and width identity":
        val plan = strict_riscv_scalar_muldiv_projection(
            muldiv_config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        expect(plan.entry_id).to_equal("rv.m.mul")
        expect(plan.provider).to_equal("iterative")
        expect(plan.canonical_instruction).to_equal(0x022081B3)
        expect(plan.rd_index).to_equal(3)
        expect(plan.rs1_index).to_equal(1)
        expect(plan.rs2_index).to_equal(2)
        expect(plan.operand_width).to_equal(64)
        expect(plan.diagnostic()).to_equal("")
        expect(plan.decoder_structural_sha256.len()).to_equal(64)
        expect(plan.structural_sha256().len()).to_equal(64)

    it "gates M and Zmmul operations through the selected profile":
        val base = strict_riscv_scalar_muldiv_projection(
            muldiv_config(32, "rv32i"), "none", 0x022081B3)
        val zmmul_mul = strict_riscv_scalar_muldiv_projection(
            muldiv_config(32, "rv32i_zmmul"), "dsp", 0x022081B3)
        val zmmul_div = strict_riscv_scalar_muldiv_projection(
            muldiv_config(32, "rv32i_zmmul"), "dsp", 0x0220C1B3)
        expect(base.is_err()).to_equal(true)
        expect(zmmul_mul.is_ok()).to_equal(true)
        expect(zmmul_div.is_err()).to_equal(true)

    it "admits every Zmmul product identity and rejects every divide identity":
        val rv32 = muldiv_config(32, "rv32i_zmmul")
        for instruction in [0x022081B3, 0x022091B3, 0x0220A1B3, 0x0220B1B3]:
            expect(strict_riscv_scalar_muldiv_projection(
                rv32, "iterative", instruction).is_ok()).to_equal(true)
        for instruction in [0x0220C1B3, 0x0220D1B3, 0x0220E1B3, 0x0220F1B3]:
            expect(strict_riscv_scalar_muldiv_projection(
                rv32, "iterative", instruction).is_err()).to_equal(true)

        val rv64 = muldiv_config(64, "rv64i_zmmul")
        expect(strict_riscv_scalar_muldiv_projection(
            rv64, "pipelined", 0x022081BB).is_ok()).to_equal(true)
        for instruction in [0x0220C1BB, 0x0220D1BB, 0x0220E1BB, 0x0220F1BB]:
            expect(strict_riscv_scalar_muldiv_projection(
                rv64, "pipelined", instruction).is_err()).to_equal(true)

    it "evaluates low and high multiply signedness for RV32 and RV64":
        for config in [muldiv_config(32, "rv32im"), muldiv_config(64, "rv64im")]:
            expect(result(config, "iterative", 0x022081B3, -2, 3)).to_equal(
                if config.xlen == 32: 0xFFFFFFFA else: -6)
            expect(result(config, "iterative", 0x022091B3, -2, 3)).to_equal(
                if config.xlen == 32: 0xFFFFFFFF else: -1)
            expect(result(config, "iterative", 0x0220A1B3, -2, 3)).to_equal(
                if config.xlen == 32: 0xFFFFFFFF else: -1)
            expect(result(config, "iterative", 0x0220B1B3, -1, 2)).to_equal(1)

    it "implements signed and unsigned division corner results":
        val rv32 = muldiv_config(32, "rv32im")
        expect(result(rv32, "iterative", 0x0220C1B3, -7, 3)).to_equal(0xFFFFFFFE)
        expect(result(rv32, "iterative", 0x0220E1B3, -7, 3)).to_equal(0xFFFFFFFF)
        expect(result(rv32, "iterative", 0x0220D1B3, -1, 2)).to_equal(0x7FFFFFFF)
        expect(result(rv32, "iterative", 0x0220F1B3, -1, 2)).to_equal(1)
        expect(result(rv32, "iterative", 0x0220C1B3, 123, 0)).to_equal(0xFFFFFFFF)
        expect(result(rv32, "iterative", 0x0220E1B3, 123, 0)).to_equal(123)
        expect(result(rv32, "iterative", 0x0220C1B3, -2147483648, -1)).to_equal(0x80000000)
        expect(result(rv32, "iterative", 0x0220E1B3, -2147483648, -1)).to_equal(0)

    it "pins every RV32 M operation at signed and unsigned boundaries":
        val rv32 = muldiv_config(32, "rv32im")
        expect(result(rv32, "iterative", 0x022081B3, 0xFFFFFFFF, 0xFFFFFFFF)).to_equal(1)
        expect(result(rv32, "iterative", 0x022091B3,
            -2147483648, -2147483648)).to_equal(0x40000000)
        expect(result(rv32, "iterative", 0x0220A1B3, -1, 0xFFFFFFFF)).to_equal(0xFFFFFFFF)
        expect(result(rv32, "iterative", 0x0220B1B3,
            0xFFFFFFFF, 0xFFFFFFFF)).to_equal(0xFFFFFFFE)
        expect(result(rv32, "iterative", 0x0220C1B3, -2147483648, 1)).to_equal(0x80000000)
        expect(result(rv32, "iterative", 0x0220D1B3,
            0xFFFFFFFF, 0xFFFFFFFF)).to_equal(1)
        expect(result(rv32, "iterative", 0x0220E1B3, -2147483648, 3)).to_equal(0xFFFFFFFE)
        expect(result(rv32, "iterative", 0x0220F1B3,
            0xFFFFFFFF, 0x80000000)).to_equal(0x7FFFFFFF)

    it "sign extends every RV64 M word result exactly once":
        val rv64 = muldiv_config(64, "rv64im")
        expect(result(rv64, "pipelined", 0x022081BB, 0x40000000, 2)).to_equal(-2147483648)
        expect(result(rv64, "pipelined", 0x0220C1BB, -2147483648, -1)).to_equal(-2147483648)
        expect(result(rv64, "pipelined", 0x0220D1BB, 0xFFFFFFFF, 2)).to_equal(2147483647)
        expect(result(rv64, "pipelined", 0x0220E1BB, -7, 3)).to_equal(-1)
        expect(result(rv64, "pipelined", 0x0220F1BB, 0xFFFFFFFF, 2)).to_equal(1)

    it "rejects forged dispatch and RV64 word identities":
        var forged = strict_riscv_scalar_muldiv_projection(
            muldiv_config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        forged.operation = "divide_signed"
        expect(evaluate_riscv_scalar_muldiv(forged, 4, 2).is_err()).to_equal(true)

        var bad_word = strict_riscv_scalar_muldiv_projection(
            muldiv_config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        bad_word.word_result = true
        bad_word.dispatch_identity_sha256 = bad_word.recomputed_identity_sha256()
        expect(bad_word.diagnostic()).to_equal(
            "HWIR-E-RISCV-MULDIV-WORD: word-result identity must match an RV64 32-bit operation")

    it "binds structural identity to the complete frozen decoder table":
        val original = strict_riscv_scalar_muldiv_projection(
            muldiv_config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        val repeated = strict_riscv_scalar_muldiv_projection(
            muldiv_config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        expect(original.structural_sha256()).to_equal(repeated.structural_sha256())

        val decoder = riscv_scalar_decoder_plan("rv64im").unwrap()
        var altered_entries: [RiscvScalarIsaEntry] = []
        var index = 0
        while index < decoder.entries.len():
            val row = decoder.entries[index]
            val changed_trap = if index == decoder.entries.len() - 1:
                row.trap_behavior + ":mutant" else: row.trap_behavior
            altered_entries.push(RiscvScalarIsaEntry(id: row.id,
                extension: row.extension, encoding_mask: row.encoding_mask,
                encoding_value: row.encoding_value, xlen_scope: row.xlen_scope,
                semantic_operation: row.semantic_operation,
                execution_class: row.execution_class,
                operand_width_bits: row.operand_width_bits,
                writeback_rule: row.writeback_rule, memory_effect: row.memory_effect,
                trap_behavior: changed_trap))
            index = index + 1
        val altered_decoder = RiscvScalarDecoderPlan(isa_profile: decoder.isa_profile,
            xlen: decoder.xlen, entries: altered_entries)
        expect(altered_decoder.structural_sha256() != decoder.structural_sha256()).to_equal(true)

        var forged = strict_riscv_scalar_muldiv_projection(
            muldiv_config(64, "rv64im"), "iterative", 0x022081B3).unwrap()
        forged.decoder_structural_sha256 = altered_decoder.structural_sha256()
        forged.dispatch_identity_sha256 = forged.recomputed_identity_sha256()
        expect(forged.diagnostic()).to_equal(
            "HWIR-E-RISCV-MULDIV-DECODER-RECEIPT: projection decoder receipt does not match the frozen ISA database")

    it "covers RV64 division and multiply boundary semantics":
        val rv64 = muldiv_config(64, "rv64im")
        expect(result(rv64, "iterative", 0x0220C1B3, -9223372036854775807 - 1, -1)).to_equal(
            -9223372036854775807 - 1)
        expect(result(rv64, "iterative", 0x0220E1B3, -9223372036854775807 - 1, -1)).to_equal(0)
        expect(result(rv64, "iterative", 0x0220D1B3, -1, 0)).to_equal(-1)
        expect(result(rv64, "iterative", 0x0220F1B3, -1, 0)).to_equal(-1)
        expect(result(rv64, "iterative", 0x0220B1B3, -1, -1)).to_equal(-2)

    it "pins every RV64 M operation at signed and unsigned boundaries":
        val rv64 = muldiv_config(64, "rv64im")
        val min = -9223372036854775807 - 1
        expect(result(rv64, "iterative", 0x022081B3, -1, -1)).to_equal(1)
        expect(result(rv64, "iterative", 0x022091B3, min, min)).to_equal(0x4000000000000000)
        expect(result(rv64, "iterative", 0x0220A1B3, -1, -1)).to_equal(-1)
        expect(result(rv64, "iterative", 0x0220B1B3, -1, -1)).to_equal(-2)
        expect(result(rv64, "iterative", 0x0220C1B3, min, 1)).to_equal(min)
        expect(result(rv64, "iterative", 0x0220D1B3, -1, -1)).to_equal(1)
        expect(result(rv64, "iterative", 0x0220E1B3, min, 3)).to_equal(-2)
        expect(result(rv64, "iterative", 0x0220F1B3, -1, min)).to_equal(0x7FFFFFFFFFFFFFFF)
