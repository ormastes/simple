# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: array `.slice(a, b)`, `.min()`, `.max()` on typed integer arrays

Phase 4 (full-CLI native build) failed MIR on
`lib.gc_async_mut.gpu.engine2d.backend_emu_adv` with
`unresolved method call: slice/min/max route=runtime-fallback`: the receiver
was `val src: [u32] = core.read_pixels_region(..).pixels` where `core` is a
trait-typed parameter. Two gaps:

- array `min()` / `max()` (interpreter builtins, `collections.rs`) had no
  arm in the pure-Simple MIR builtin table at all;
- `.slice` on an array that has a declared array type but no producer
  runtime-array mark (a field read off a trait-dispatch call result) fell to
  the runtime fallback.

Fixture: `test/fixtures/native_array_slice_min_max_u32/main.spl`.
"""

# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.Span
use std.env.variables.{env_get, env_has, env_set, env_unset}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn arr_messages(src: text) -> [text]:
    val file = "testdata/fixture_array_slice_min_max.spl"
    val parsed = parse_full_frontend(src, file, "fixture_array_slice_min_max", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val _mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    messages

fn arr_expect_clean(src: text):
    val messages = arr_messages(src)
    for m in messages:
        print "diagnostic: {m}"
    expect(messages.len()).to_equal(0)

fn arr_restore_env(name: text, had: bool, previous: text) -> bool:
    if had:
        return env_set(name, previous)
    env_unset(name)

fn arr_bootstrap_unresolved(src: text) -> i64:
    """Lower `src` the way Stage 2 `native-build --entry-closure` does
    (SIMPLE_BOOTSTRAP=1 + entry closure): HIR erases a declared `-> [u32]` /
    `-> Record` method result to the i64 default, so MIR must recover it.
    Counts only `unresolved method call` -- this harness registers no class
    provider metadata, so provider diagnostics are out of scope here."""
    val had_bootstrap = env_has("SIMPLE_BOOTSTRAP")
    val prev_bootstrap = env_get("SIMPLE_BOOTSTRAP")
    val had_closure = env_has("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
    val prev_closure = env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
    var env_ok = env_set("SIMPLE_BOOTSTRAP", "1") and env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "1")
    val messages = arr_messages(src)
    env_ok = arr_restore_env("SIMPLE_BOOTSTRAP", had_bootstrap, prev_bootstrap) and env_ok
    env_ok = arr_restore_env("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", had_closure, prev_closure) and env_ok
    # A failed set/restore must not read as a clean lowering.
    if not env_ok: return -1
    var unresolved = 0
    for m in messages:
        if m.contains("unresolved method call"):
            print "diagnostic: {m}"
            unresolved = unresolved + 1
    unresolved

val literal_src = "fn lit_u32() -> u32:\n" +
    "    val xs: [u32] = [7u32, 3u32, 9u32]\n" +
    "    val seg = xs.slice(0, 2)\n" +
    "    val argb: [u32] = [3u32, 0xFF000000u32]\n" +
    "    seg.min() + seg.max() + xs.min() + argb.max()\n" +
    "fn lit_i32() -> i32:\n" +
    "    val xs: [i32] = [5i32, -4i32, 8i32]\n" +
    "    xs.slice(1, 3).min() + xs.max()\n" +
    "fn lit_i64() -> i64:\n" +
    "    val xs: [i64] = [40, -11, 99]\n" +
    "    xs.slice(0, 2).max() + xs.min()\n"

val struct_field_src = "struct Region:\n" +
    "    pixels: [u32]\n" +
    "fn make() -> Region:\n" +
    "    Region(pixels: [1u32, 2u32, 3u32])\n" +
    "fn f() -> bool:\n" +
    "    val src: [u32] = make().pixels\n" +
    "    val seg = src.slice(0, 2)\n" +
    "    seg.min() == seg.max()\n"

val trait_field_src = "class Readback:\n" +
    "    pixels: [u32]\n" +
    "    source: text\n" +
    "trait PixelSource:\n" +
    "    me raw() -> [u32]\n" +
    "    me region(lo: i64, hi: i64) -> Readback:\n" +
    "        val all = self.raw()\n" +
    "        Readback(pixels: all.slice(lo, hi), source: \"region\")\n" +
    "fn f(mut core: PixelSource) -> bool:\n" +
    "    val src: [u32] = core.region(1, 7).pixels\n" +
    "    val seg = src.slice(2, 5)\n" +
    "    seg.min() == seg.max()\n"

# The full native fixture shape: an implementor in the unit, so the default
# method body (`self.raw()` -> `[u32]`) and the trait-typed parameter call to
# the DEFAULT method `region` (-> record) are both lowered.
val trait_impl_src = trait_field_src +
    "class Canvas:\n" +
    "    data: [u32]\n" +
    "impl PixelSource for Canvas:\n" +
    "    me raw() -> [u32]:\n" +
    "        self.data\n" +
    "fn main():\n" +
    "    var canvas = Canvas(data: [7u32, 3u32, 9u32])\n" +
    "    f(canvas)\n"

# Unannotated binding of a trait-typed call: the declared `[u32]` result of
# the trait slot must reach `.slice` without an annotation.
val trait_array_result_src = "trait Src:\n" +
    "    me raw() -> [u32]\n" +
    "class Buf:\n" +
    "    data: [u32]\n" +
    "impl Src for Buf:\n" +
    "    me raw() -> [u32]:\n" +
    "        self.data\n" +
    "fn g(mut s: Src) -> u32:\n" +
    "    val xs = s.raw()\n" +
    "    xs.slice(0, 2).min() + xs.max()\n" +
    "fn main():\n" +
    "    var b = Buf(data: [4u32, 2u32])\n" +
    "    print(g(b))\n"

val text_min_src = "fn f(xs: [text]) -> text:\n" +
    "    xs.min()\n"

describe "array slice/min/max MIR lowering":
    it "lowers slice/min/max on [u32]/[i32]/[i64] literal arrays":
        arr_expect_clean(literal_src)

    it "lowers slice/min/max on an annotated array read from a struct field of a call":
        arr_expect_clean(struct_field_src)

    it "lowers slice/min/max on an annotated array read off a trait-dispatch call result":
        arr_expect_clean(trait_field_src)

    it "lowers default-method self calls and trait-param default-method record results with an implementor":
        arr_expect_clean(trait_impl_src)

    it "records the declared array result of a trait-typed parameter call":
        arr_expect_clean(trait_array_result_src)

    it "an explicit [T] annotation marks a binding whose initializer type is unknown as a runtime array":
        val parsed = parse_full_frontend("fn f():\n    pass\n", "testdata/fixture_let_override.spl", "fixture_let_override", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/fixture_let_override.spl")
        val hir = hir_lowering.lower_module(parsed)
        var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
        val u32_type = HirType(kind: HirTypeKind.Int(32, false), span: Span.empty())
        val declared = HirType(kind: HirTypeKind.Array(u32_type, None), span: Span.empty())
        # Local 4242 carries no HIR type: the initializer's type is unknown.
        expect(lowering.let_declared_type_override_v1(4242, declared)).to_equal(2)

    it "fails closed (no silent runtime fallback) for min() over a non-numeric element type":
        val messages = arr_messages(text_min_src)
        var unsupported = 0
        for m in messages:
            print "diagnostic: {m}"
            if m.contains("unsupported in stage2: array.min()"):
                unsupported = unsupported + 1
        expect(unsupported).to_equal(1)

    # Bootstrap-mode lowering leaves process-global frontend state behind
    # (later non-bootstrap parses in the same process misparse), so these run last.
    it "bootstrap: recovers erased [u32] / record results of trait calls (self call in a default body, trait-param default method)":
        expect(arr_bootstrap_unresolved(trait_field_src)).to_equal(0)

    it "bootstrap: same shapes with an implementor in the unit (native fixture shape)":
        expect(arr_bootstrap_unresolved(trait_impl_src)).to_equal(0)

    it "bootstrap: unannotated binding of a trait-typed parameter's [u32] result":
        expect(arr_bootstrap_unresolved(trait_array_result_src)).to_equal(0)
