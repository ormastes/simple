# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: array `.slice(a, b)`, `.min()`, `.max()` on typed integer arrays

Phase 4 (full-CLI native build) failed MIR on
`lib.gc_async_mut.gpu.engine2d.backend_emu_adv` with
`unresolved method call: slice/min/max route=runtime-fallback`: the receiver
was `val src: [u32] = core.read_pixels_region(..).pixels` where `core` is a
trait-typed parameter. Two gaps:

- array `min()` / `max()` (interpreter builtins, `collections.rs`) had no
  arm in the pure-Simple MIR builtin table at all;
- `.slice` on an array that has a declared array type but no producer
  runtime-array mark (a field read off a trait-dispatch call result) fell to
  the runtime fallback.

Fixture: `test/fixtures/native_array_slice_min_max_u32/main.spl`.
"""

# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn arr_messages(src: text) -> [text]:
    val file = "testdata/fixture_array_slice_min_max.spl"
    val parsed = parse_full_frontend(src, file, "fixture_array_slice_min_max", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val _mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    messages

fn arr_expect_clean(src: text):
    val messages = arr_messages(src)
    for m in messages:
        print "diagnostic: {m}"
    expect(messages.len()).to_equal(0)

val literal_src = "fn lit_u32() -> u32:\n" +
    "    val xs: [u32] = [7u32, 3u32, 9u32]\n" +
    "    val seg = xs.slice(0, 2)\n" +
    "    val argb: [u32] = [3u32, 0xFF000000u32]\n" +
    "    seg.min() + seg.max() + xs.min() + argb.max()\n" +
    "fn lit_i32() -> i32:\n" +
    "    val xs: [i32] = [5i32, -4i32, 8i32]\n" +
    "    xs.slice(1, 3).min() + xs.max()\n" +
    "fn lit_i64() -> i64:\n" +
    "    val xs: [i64] = [40, -11, 99]\n" +
    "    xs.slice(0, 2).max() + xs.min()\n"

val struct_field_src = "struct Region:\n" +
    "    pixels: [u32]\n" +
    "fn make() -> Region:\n" +
    "    Region(pixels: [1u32, 2u32, 3u32])\n" +
    "fn f() -> bool:\n" +
    "    val src: [u32] = make().pixels\n" +
    "    val seg = src.slice(0, 2)\n" +
    "    seg.min() == seg.max()\n"

val trait_field_src = "class Readback:\n" +
    "    pixels: [u32]\n" +
    "    source: text\n" +
    "trait PixelSource:\n" +
    "    me raw() -> [u32]\n" +
    "    me region(lo: i64, hi: i64) -> Readback:\n" +
    "        val all = self.raw()\n" +
    "        Readback(pixels: all.slice(lo, hi), source: \"region\")\n" +
    "fn f(mut core: PixelSource) -> bool:\n" +
    "    val src: [u32] = core.region(1, 7).pixels\n" +
    "    val seg = src.slice(2, 5)\n" +
    "    seg.min() == seg.max()\n"

val text_min_src = "fn f(xs: [text]) -> text:\n" +
    "    xs.min()\n"

describe "array slice/min/max MIR lowering":
    it "lowers slice/min/max on [u32]/[i32]/[i64] literal arrays":
        arr_expect_clean(literal_src)

    it "lowers slice/min/max on an annotated array read from a struct field of a call":
        arr_expect_clean(struct_field_src)

    it "lowers slice/min/max on an annotated array read off a trait-dispatch call result":
        arr_expect_clean(trait_field_src)

    it "fails closed (no silent runtime fallback) for min() over a non-numeric element type":
        val messages = arr_messages(text_min_src)
        var unsupported = 0
        for m in messages:
            print "diagnostic: {m}"
            if m.contains("unsupported in stage2: array.min()"):
                unsupported = unsupported + 1
        expect(unsupported).to_equal(1)
