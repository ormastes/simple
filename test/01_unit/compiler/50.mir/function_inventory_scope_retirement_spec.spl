# Native execution is required; this specification does not establish RSS gains.
use std.spec
use compiler.common.config.Logger
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*

describe "completed module function inventory":
    it "retires emission scratch while preserving both MIR and input HIR":
        val source = "fn first(value: i64) -> i64:\n    value + 1\n\nfn second() -> i64:\n    first(4)\n"
        val parsed = parse_full_frontend(source, "inventory.spl", "inventory", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("inventory.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)
        expect(hir.functions.len()).to_equal(2)
        val next_parsed = parse_full_frontend("fn next() -> i64:\n    9\n", "next.spl", "next", Logger(level: 0))
        var next_hir_lowering = HirLowering.with_filename("next.spl")
        val next_hir = next_hir_lowering.lower_module(next_parsed)
        expect(next_hir_lowering.errors.len()).to_equal(0)
        val target = driver_mir_target_context(driver_core_compile_options_default())
        var lowering = MirLowering.new_for_target(hir.symbols, target)
        val result = lowering.lower_module_transient_scoped(hir, [], true)
        expect(result.is_ok()).to_equal(true)
        val first = result.unwrap()
        expect(first.functions.len()).to_equal(2)
        expect(lowering.lower_emit_fn_values.len()).to_equal(0)
        expect(lowering.errors.len()).to_equal(0)
        val graph = serialize_mir_module(first)
        expect(graph).to_contain("Call")
        val next_result = lowering.lower_module_transient_scoped(next_hir, [hir], false)
        expect(next_result.is_ok()).to_equal(true)
        expect(next_result.unwrap().functions.len()).to_equal(1)
        expect(lowering.lower_emit_fn_values.len()).to_equal(0)
        expect(lowering.errors.len()).to_equal(0)
        expect(serialize_mir_module(first)).to_equal(graph)
        expect(hir.functions.len()).to_equal(2)
        expect(next_hir.functions.len()).to_equal(1)
