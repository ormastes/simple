# @req REQ-SSPEC-COMPILER
"""
# A bare `return` in a value-returning function never lowers to an operand-less Ret

Phase-3 codegen of `compiler.hir.hir_lowering._Items.module_import_registration`
failed the Cranelift verifier with `inst8170 (return): arguments of return must
match function signature`: `me register_imported_symbol_inner(...) -> text:`
held `if local_name == qualified_local: return`, which lowered to `Ret(None)`
while the MIR (and so the Cranelift) signature carries one result. LLVM hid it
by fabricating `ret i64 0`. A bare `return` is `return nil` in an Optional
function and a fatal E-SFFI-016 diagnostic in any other value-returning one.
Bug: doc/08_tracking/bug/cranelift_bare_return_in_valued_fn_verifier_2026-11-18.md
"""

# @tag: unit, compiler, mir, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

fn ret_shapes_of(source: text, fn_name: text) -> text:
    val log = Logger(level: 0)
    val ast = parse_full_frontend(source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["app.main"] = ast
    val sources = [SourceFile(path: "app/main.spl", content: source, module_name: "app.main")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var lowering = hirlowering_for_module("app.main", surfaces)
    val hir = lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir, [hir])
    var out = ""
    for e in mir_lowering.errors:
        out = out + "mir: " + e.message + "\n"
    for entry in mir.functions.values():
        if entry.name == fn_name or entry.name.ends_with("." + fn_name):
            for block in entry.blocks:
                match block.terminator:
                    case MirTerminator.Ret(value):
                        if value.?:
                            out = out + "ret-value\n"
                        else:
                            out = out + "ret-void\n"
                    case _:
                        ()
    out

describe "bare return in a value-returning function":
    it "`return` in `-> text` is a fatal E-SFFI-016, not a silent operand-less Ret":
        val src = "fn pick(name: text, other: text) -> text:\n    var selected = \"none\"\n    if name == other: return\n    selected = \"picked\"\n    selected\n\nfn main() -> i64:\n    print(pick(\"a\", \"b\"))\n    0\n"
        val shapes = ret_shapes_of(src, "pick")
        expect(shapes.contains("E-SFFI-016: bare `return` in non-unit function")).to_equal(true)
        expect(shapes.contains("pick")).to_equal(true)

    it "`return` in `-> i64?` returns nil: every Ret carries a value":
        val src = "fn num(n: i64) -> i64?:\n    if n == 0: return\n    n\n\nfn main() -> i64:\n    val got = num(0)\n    0\n"
        val shapes = ret_shapes_of(src, "num")
        expect(shapes.contains("mir: ")).to_equal(false)
        expect(shapes.contains("ret-value")).to_equal(true)
        expect(shapes.contains("ret-void")).to_equal(false)

    it "`return` in a Unit function stays a bare Ret with no diagnostic":
        val src = "fn side(flag: bool):\n    if flag: return\n    print \"x\"\n\nfn main() -> i64:\n    side(true)\n    0\n"
        val shapes = ret_shapes_of(src, "side")
        expect(shapes.contains("mir: ")).to_equal(false)
        expect(shapes.contains("ret-void")).to_equal(true)
        expect(shapes.contains("ret-value")).to_equal(false)

    it "`return` in a `-> unit` function stays a bare Ret with no diagnostic":
        val src = "fn check(name: text) -> unit:\n    if name == \"\":\n        return\n    print name\n\nfn main() -> i64:\n    check(\"a\")\n    0\n"
        val shapes = ret_shapes_of(src, "check")
        expect(shapes.contains("mir: ")).to_equal(false)
        expect(shapes.contains("ret-void")).to_equal(true)
        expect(shapes.contains("ret-value")).to_equal(false)
