"""
Generalization spec — a collection-typed struct field is usable ONLY if the
constructor call names it; omitting it yields nil, and every access form is
then fatal.

Sibling of test/01_unit/compiler/50.mir/mir_lowering_global_maps_initialized_spec.spl
(2026-09-02). Record:
doc/08_tracking/bug/mcp_native_build_post_mono_nil_contains_2026-09-01.md

Defect class: a struct declares a collection field with no default; the single
constructor call forgets it; nothing else ever assigns it; the field is
`Value::Nil` forever. Nothing at construction time complains. The failure
surfaces arbitrarily far away, at the first member access, as

    method `<m>` not found on type `nil` (receiver value: nil)

with the receiver rendered as the desugared `__nested_field_<name>__`, which
does not textually match the field's use site and has repeatedly misdirected
readers.

The fixed instance was `MirLowering.global_statics_by_id` reached through
`.contains()`. This spec sweeps the neighbours the fix did not touch, because
every one of them exists verbatim on that same struct and on its ~90 sibling
fields:

  * element kinds — bool-valued, struct-valued, array-valued, text-keyed;
  * access forms — `.contains()`, `.len()`, index-read, index-assign, `.keys()`,
    for-in iteration;
  * the FIELD-TO-FIELD COPY shape, which is how the real defect propagated:
    _MirLoweringExpr/switch_operators_calls.spl:4468-4469 does
        lw.global_statics_by_id = self.global_statics_by_id
    so a nil source silently poisons a second, separately-constructed object
    whose own constructor DID initialise the field. A spec that only checked
    the origin object would miss this.

Every example here asserts the CORRECT contract for the initialised case. They
are expected to pass; they exist so that a future regression that re-breaks
construction (or a change to how omitted fields default) fails loudly at unit
scale in seconds instead of 35 minutes into an MCP native build.

Note: an example that SUMMED the dict keys was found to return the text "012"
instead of 3. That is a different defect class (key TYPING, not field
CONSTRUCTION), reproduces on a plain local dict with no struct field involved,
and is filed separately as
doc/08_tracking/bug/dict_i64_keys_sum_concatenates_as_text_2026-09-02.md.
The example here counts iterations instead, so a future construction regression
stays distinguishable from that open defect.

Measured 2026-09-02 on seed src/compiler_rust/target/release/simple.exe
md5 286f66b8615dce0e0da788f0550c4008, SIMPLE_EXECUTION_MODE=interpret.
"""
use std.spec.{describe, it, expect}

struct Item:
    label: text

struct Maps:
    flags: Dict<i64, bool>
    items: Dict<i64, Item>
    lists: Dict<text, [text]>

impl Maps:
    static fn empty() -> Maps:
        Maps(flags: {}, items: {}, lists: {})

    me flag_contains_miss() -> bool:
        self.flags.contains(9)

    me flag_len_empty() -> i64:
        self.flags.len()

    me item_index_assign_then_index_read() -> text:
        self.items[4] = Item(label: "four")
        self.items[4].label

    me array_valued_store_and_read() -> text:
        self.lists["k"] = ["x", "y"]
        self.lists["k"][1]

    me keys_after_stores() -> i64:
        self.flags[1] = true
        self.flags[2] = false
        self.flags.keys().len()

    # NOTE: this counts iterations rather than SUMMING the keys. Summing them
    # returns the text "012" instead of 3 on this seed -- a separate, filed
    # defect in the KEY TYPING of `Dict<i64, _>.keys()`, reproducible on a
    # plain local dict with no struct field involved:
    # doc/08_tracking/bug/dict_i64_keys_sum_concatenates_as_text_2026-09-02.md
    # It is deliberately not asserted here: this spec is about field
    # CONSTRUCTION, and folding an unrelated open defect into it would make a
    # future construction regression indistinguishable from that one.
    me iterate_after_stores() -> i64:
        self.items[1] = Item(label: "a")
        self.items[2] = Item(label: "b")
        var seen = 0
        for key in self.items.keys():
            seen = seen + 1
        seen

# The field-to-field copy shape from switch_operators_calls.spl:4468-4469.
struct SubLowering:
    items: Dict<i64, Item>

impl SubLowering:
    static fn empty() -> SubLowering:
        SubLowering(items: {})

fn copy_field_into_second_object() -> bool:
    var src = Maps.empty()
    src.items[5] = Item(label: "five")
    var dst = SubLowering.empty()
    dst.items = src.items
    dst.items.contains(5)

describe "collection-typed struct fields are usable when the constructor names them":

    it "bool-valued Dict answers .contains() on a miss":
        var m = Maps.empty()
        expect(m.flag_contains_miss()).to_equal(false)

    it "bool-valued Dict reports length 0 when empty":
        var m = Maps.empty()
        expect(m.flag_len_empty()).to_equal(0)

    it "struct-valued Dict survives index-assign then index-read":
        var m = Maps.empty()
        expect(m.item_index_assign_then_index_read()).to_equal("four")

    it "array-valued, text-keyed Dict survives store then nested index":
        var m = Maps.empty()
        expect(m.array_valued_store_and_read()).to_equal("y")

    it ".keys() reflects stores":
        var m = Maps.empty()
        expect(m.keys_after_stores()).to_equal(2)

    it "for-in over .keys() visits every stored entry":
        var m = Maps.empty()
        expect(m.iterate_after_stores()).to_equal(2)

describe "a collection field copied into a second object stays usable":

    it "field-to-field copy carries a populated dict (the sub-lowerer shape)":
        expect(copy_field_into_second_object()).to_equal(true)
