# Regression: native `d[k]` on Dict<text, bool> must yield a bool, not int 1/0.
# bug: doc/08_tracking/bug/native_dict_bool_index_int_2026-10-25.md

struct BoolHolder:
    flag: bool

struct FlagTable:
    flags: Dict<text, bool>

describe "Dict<text, bool> index read":
    it "compares equal to true":
        val d: Dict<text, bool> = {"a": true, "b": false}
        expect(d["a"] == true).to_equal(true)
        expect(d["b"] == false).to_equal(true)

    it "interpolates as true/false":
        val d: Dict<text, bool> = {"a": true, "b": false}
        expect("{d["a"]}").to_equal("true")
        expect("{d["b"]}").to_equal("false")

    it "stores into a bool field":
        val d: Dict<text, bool> = {"a": true}
        val h = BoolHolder(flag: d["a"])
        expect(h.flag).to_equal(true)

    it "reads through a struct field projection":
        val t = FlagTable(flags: {"a": true})
        expect("{t.flags["a"]}").to_equal("true")
