# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Regression spec: struct-ctor field loop must unwrap the lowered LocalId.
# A mixed-type if-expression (LocalId vs LocalId?) was typed Option on the
# stage-native lane, so the raw Option handle word (0x13_00000004) became every
# struct-field operand and llc failed with 'use of undefined value'.
use std.spec
extern fn rt_file_read_text(path: text) -> text?

struct Opts:
    path: text
    n: i64

describe "struct ctor field local":
    it "constructs a struct with correct field values":
        val o = Opts(path: "x", n: 3)
        expect(o.path == "x").to_equal(true)
        expect(o.n == 3).to_equal(true)

    it "struct-ctor loop has no un-annotated mixed-type `var v = if function_slot:`":
        val src = (rt_file_read_text("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl") ?? "")
        expect(src.contains("var v = if function_slot:")).to_equal(false)
        expect(src.contains("var v_opt: LocalId? = nil")).to_equal(true)
