use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_runtime_mul_low_provider.{
    strict_riscv_scalar_runtime_mul_provider, strict_riscv_scalar_runtime_mul_low_provider}
use lib.hardware.riscv_common.isa.scalar_database.{riscv_scalar_decoder_plan}

fn zmmul32() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "rv32-zmmul", isa_profile: "rv32i_zmmul", compressed_decode_profile: "none")

fn zmmul64() -> CoreConfig:
    CoreConfig(xlen: 64, physical_address_bits: 56, register_count: 32,
        profile: "rv64-zmmul", isa_profile: "rv64i_zmmul", compressed_decode_profile: "none")

describe "dynamic plan-bound runtime Zmmul multiply provider":
    it "captures every dynamic RV32 Zmmul multiply row at tag two and holds its full completion":
        val plan = riscv_scalar_decoder_plan("rv32i_zmmul").unwrap()
        val provider = strict_riscv_scalar_runtime_mul_provider("runtime_mul_dynamic", zmmul32(), plan).unwrap()
        expect(provider.diagnostic()).to_equal("")
        expect(provider.plan.named_width(provider.ports, "request_provider_tag")).to_equal(3)
        expect(provider.plan.named_width(provider.ports, "completion_provider_tag")).to_equal(3)
        expect(provider.datapath_constants.any(_.name == "tag_muldiv" and _.value == 2)).to_equal(true)
        expect(provider.origins.any(_.source_name == "rv.m.mul")).to_equal(true)
        expect(provider.origins.any(_.source_name == "rv.m.mulh")).to_equal(true)
        expect(provider.origins.any(_.source_name == "rv.m.mulhsu")).to_equal(true)
        expect(provider.origins.any(_.source_name == "rv.m.mulhu")).to_equal(true)
        expect(provider.plan.rules[2].name).to_equal("finish")
        expect(provider.plan.rules[3].name).to_equal("iterate")
        expect(provider.plan.rules[4].name).to_equal("request_capture")
        expect(provider.plan.outputs[2].result).to_equal("completion_valid")
        expect(provider.plan.named_width(provider.ports, "completion_provider_event_id")).to_equal(64)
        expect(provider.plan.named_width(provider.ports, "completion_decode_event_id")).to_equal(64)

    it "uses captured runtime operands and operation semantics rather than a frozen specialization":
        val provider = strict_riscv_scalar_runtime_mul_provider("runtime_mul_operands", zmmul64(), riscv_scalar_decoder_plan("rv64i_zmmul").unwrap()).unwrap()
        expect(provider.datapath_width("capture_lhs_wide")).to_equal(128)
        expect(provider.datapath_width("acc_next")).to_equal(128)
        expect(provider.datapath_width("product_low")).to_equal(64)
        expect(provider.datapath_width("product_high")).to_equal(64)
        expect(provider.datapath_width("architectural_result")).to_equal(64)
        expect(provider.origins.any(_.source_name == "rv64.m.mulw")).to_equal(true)
        expect(provider.plan.registers.any(_.name == "operation_reg" and _.bit_width == 3)).to_equal(true)
        expect(provider.datapath_comb_ops.any(_.result == "high_corrected" and _.op == "sub")).to_equal(true)
        expect(provider.datapath_comb_ops.any(_.result == "word_result" and _.op == "sext")).to_equal(true)
        expect(provider.datapath_comb_ops.any(_.result == "op_is_mulhu" and _.op == "eq")).to_equal(true)
        expect(provider.datapath_comb_ops.any(_.result == "high_operation" and _.op == "or")).to_equal(true)
        expect(provider.datapath_comb_ops.any(_.result == "acc_added" and _.lhs == "acc_reg" and _.rhs == "multiplicand_reg")).to_equal(true)
        expect(provider.datapath_bit_extract_ops[0].result).to_equal("multiplier_lsb")
        expect(provider.plan.rules[0].name).to_equal("protocol_fault")

    it "keeps M divide rows outside its selection and fail-closed boundary":
        val rv32m = CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
            profile: "rv32-m", isa_profile: "rv32im", compressed_decode_profile: "none")
        val provider = strict_riscv_scalar_runtime_mul_provider("runtime_mul_m", rv32m, riscv_scalar_decoder_plan("rv32im").unwrap()).unwrap()
        expect(provider.origins.any(_.source_name == "rv.m.div")).to_equal(false)
        expect(provider.datapath_constants.any(_.name == "op_mulhu" and _.value == 3)).to_equal(true)
        expect(provider.datapath_comb_ops.any(_.result == "selection_missing" and _.op == "eq")).to_equal(true)

    it "rejects non-M plans and compressed v1 construction":
        expect(strict_riscv_scalar_runtime_mul_provider("runtime_mul_none", CoreConfig.rv32(), riscv_scalar_decoder_plan("rv32i").unwrap()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_mul_provider("", zmmul32(), riscv_scalar_decoder_plan("rv32i_zmmul").unwrap()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_mul_provider("runtime_mul_compressed", CoreConfig.rv32_zca_integer(), riscv_scalar_decoder_plan("rv32i_zca").unwrap()).is_err()).to_equal(true)

    it "retains the low-MUL factory as a structural compatibility alias":
        val plan = riscv_scalar_decoder_plan("rv32i_zmmul").unwrap()
        val canonical = strict_riscv_scalar_runtime_mul_provider("runtime_mul_alias", zmmul32(), plan).unwrap()
        val alias = strict_riscv_scalar_runtime_mul_low_provider("runtime_mul_alias", zmmul32(), plan).unwrap()
        expect(alias.structural_sha256()).to_equal(canonical.structural_sha256())
