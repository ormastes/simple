# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# @tag: unit, compiler, mir, generics
#
# BUG-IT-6 (stage2 micro_g, 2026-10-10): reading a field of a generic struct
# whose declared type is the struct's own TYPE PARAMETER lowered the field as
# a struct NAMED AFTER THE PARAMETER -- `struct Pair<A, B>: a: A`, then
# `q.a + q.b` on a `Pair<text, text>` died in 50.mir with
# `unresolved method call: operator overload for struct A`. The field's type
# must be the INSTANTIATION's argument, not the template's parameter.
#
# 50.mir now (1) marks type-param fields in `struct_field_type_param` instead
# of recording a struct type named `A`, (2) records at every generic
# construct site the MIR type each field actually holds, and (3) resolves a
# type-param field read from that record, or from the base's own
# `Pair<text, i64>` HIR type arguments (a parameter). These examples take the
# shapes through HIR -> 40.mono -> 50.mir -> MirToLlvm and require zero MIR
# diagnostics and the expected runtime operation on the projected field.
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.mono.monomorphize_integration.{run_monomorphization_with_diagnostics}

val MODULE = "gsf_probe"

val PRELUDE = "struct Pair<A, B>:\n" +
    "    a: A\n" +
    "    b: B\n" +
    "\n" +
    "struct W<T>:\n" +
    "    v: T\n" +
    "\n" +
    "struct Acc:\n" +
    "    n: i64\n" +
    "\n"

struct Shaped:
    ir: text
    hir_errors: [text]
    mir_errors: [text]

fn shape(body: text) -> Shaped:
    val src = PRELUDE + body
    val file = "testdata/gsf_probe.spl"
    var hl = HirLowering.with_filename(file)
    val hir = hl.lower_module(parse_full_frontend(src, file, MODULE, Logger(level: 0)))
    var hir_errors: [text] = []
    for e in hl.errors:
        hir_errors.push(e.message)
    var mods: Dict<text, HirModule> = {}
    mods[MODULE] = hir
    val (mono, _stats, _diags) = run_monomorphization_with_diagnostics(mods)
    val m: HirModule = mono[MODULE]
    var lowering = MirLowering.new_for_target(m.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(m)
    var mir_errors: [text] = []
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        mir_errors.push(e.message)
    val ir = MirToLlvm.create(MODULE, CodegenTarget.X86_64, nil).translate_module(mir)
    Shaped(ir: ir, hir_errors: hir_errors, mir_errors: mir_errors)

fn expect_clean(s: Shaped):
    expect(s.hir_errors.len()).to_equal(0)
    expect(s.mir_errors.len()).to_equal(0)
    expect(s.ir.contains("operator overload for struct")).to_equal(false)

describe "generic struct type-param fields take the instantiation's type (BUG-IT-6)":
    it "micro_g: Pair<text, text> field `+` is string concatenation, Pair<text, i64>.b is an integer":
        val s = shape(
            "fn main() -> i64:\n" +
            "    val p = Pair<text, i64>(a: \"a\", b: 7)\n" +
            "    val q = Pair<text, text>(a: \"a\", b: \"b\")\n" +
            "    print \"pair=\{q.a + q.b\} n=\{p.b\}\"\n" +
            "    0\n")
        expect_clean(s)
        # `q.a + q.b` must reach the runtime string concatenation, never
        # integer add on the two field words.
        expect(s.ir.contains("rt_strcat") or s.ir.contains("rt_string_concat")).to_equal(true)

    it "single-param struct inferred at i64: `w.v == 1` is an integer compare":
        val s = shape(
            "fn main() -> i64:\n" +
            "    val w = W(v: 1)\n" +
            "    if w.v == 1:\n" +
            "        return 0\n" +
            "    1\n")
        expect_clean(s)
        expect(s.ir.contains("icmp eq i64")).to_equal(true)

    it "T = f64, bool and text instances keep their field representation":
        val s = shape(
            "fn main() -> i64:\n" +
            "    val f = W(v: 2.5)\n" +
            "    val b = W(v: true)\n" +
            "    val t = W(v: \"x\")\n" +
            "    val half = f.v / 2.0\n" +
            "    val l = t.v.len()\n" +
            "    if b.v and l == 1:\n" +
            "        return 0\n" +
            "    1\n")
        expect_clean(s)
        expect(s.ir.contains("fdiv double")).to_equal(true)

    it "T = struct: a nested instance field chains into its own fields":
        val s = shape(
            "fn main() -> i64:\n" +
            "    val w = W(v: Acc(n: 5))\n" +
            "    w.v.n\n")
        expect_clean(s)

    # The frontend drops the arguments of a same-module `Pair<text, i64>`
    # ANNOTATION (the parameter reaches HIR as bare `Pair`), so nothing knows
    # this instance. Moving the field is fine; an operator on it is refused
    # exactly as before BUG-IT-6 -- never lowered as an integer add of two
    # field words. (This example used to claim the declared arguments typed
    # the read; its only assertion was the absence of a diagnostic.)
    it "a parameter declared Pair<text, i64>: a field move lowers, an operator on it is refused":
        val moved = shape(
            "fn first(p: Pair<text, i64>) -> text:\n" +
            "    p.a\n" +
            "\n" +
            "fn main() -> i64:\n" +
            "    val p = Pair<text, i64>(a: \"a\", b: 7)\n" +
            "    print \"\{first(p)\}\"\n" +
            "    0\n")
        expect_clean(moved)
        val operated = shape(
            "fn second(p: Pair<text, i64>) -> i64:\n" +
            "    p.b + 1\n" +
            "\n" +
            "fn main() -> i64:\n" +
            "    second(Pair<text, i64>(a: \"a\", b: 7))\n")
        var refused = false
        for e in operated.mir_errors:
            val et: text = e
            if et.contains("operator overload for struct B"):
                refused = true
        expect(refused).to_equal(true)

    it "a copied binding keeps the instance's field types":
        val s = shape(
            "fn main() -> i64:\n" +
            "    val q = Pair<text, text>(a: \"a\", b: \"b\")\n" +
            "    val c = q\n" +
            "    print \"\{c.a + c.b\}\"\n" +
            "    0\n")
        expect_clean(s)
        expect(s.ir.contains("rt_strcat") or s.ir.contains("rt_string_concat")).to_equal(true)

    it "two instantiations of the same struct in one function do not share field types":
        val s = shape(
            "fn main() -> i64:\n" +
            "    val a = W(v: \"s\")\n" +
            "    val b = W(v: 3)\n" +
            "    val n = a.v.len() + b.v\n" +
            "    n\n")
        expect_clean(s)
