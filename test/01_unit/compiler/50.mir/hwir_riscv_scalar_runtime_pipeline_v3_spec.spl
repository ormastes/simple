use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v3.{
    strict_riscv_scalar_runtime_pipeline_v3}

describe "runtime scalar pipeline v3 typed closure":
    it "closes decoder, ALU, control, illegal, selector, and completion skids":
        val result = strict_riscv_scalar_runtime_pipeline_v3(
            "runtime_scalar_v3", CoreConfig.rv32())
        expect(result.is_ok()).to_equal(true)
        if result.is_ok():
            val pipeline = result.ok().unwrap()
            expect(pipeline.local_diagnostic()).to_equal("")
            expect(pipeline.diagnostic()).to_equal("")
            expect(pipeline.control.children.len()).to_equal(2)
            expect(pipeline.bindings.any(\row:
                row.source_owner == "uop_skid" and
                    row.source_port == "decoded_execution_class" and
                    row.destination_owner == "control")).to_equal(true)
            expect(pipeline.bindings.any(\row:
                row.source_owner == "control" and
                    row.source_port == "completion_redirect_target" and
                    row.destination_owner == "selector" and
                    row.destination_port == "control_redirect_target")).to_equal(true)
            expect(pipeline.bindings.any(\row:
                row.source_owner == "selector" and
                    row.source_port == "selected_valid" and
                    row.destination_owner == "completion_skid")).to_equal(true)
            expect(pipeline.bindings.any(\row:
                row.source_owner == "selector" and row.source_port == "selector_fault" and
                    row.destination_owner == "fault_owner")).to_equal(true)

    it "is deterministic for RV32 and RV64 and preserves the v3 identity":
        for config in [CoreConfig.rv32(), CoreConfig.rv64()]:
            val first = strict_riscv_scalar_runtime_pipeline_v3(
                "runtime_scalar_v3_exact", config).unwrap()
            val second = strict_riscv_scalar_runtime_pipeline_v3(
                "runtime_scalar_v3_exact", config).unwrap()
            expect(first.structural_sha256()).to_equal(second.structural_sha256())
            expect(first.structural_sha256().len()).to_equal(64)
            expect(first.node_id.value).to_equal("runtime_scalar_v3_exact:module")

    it "rejects absent identity and noncanonical compressed lineage":
        expect(strict_riscv_scalar_runtime_pipeline_v3(
            "", CoreConfig.rv32()).is_err()).to_equal(true)
        val compressed = CoreConfig(profile: "rv32", xlen: 32,
            physical_address_bits: 32, register_count: 32,
            isa_profile: "rv32i", compressed_decode_profile: "rvc")
        expect(strict_riscv_scalar_runtime_pipeline_v3(
            "runtime_scalar_v3_rvc", compressed).is_err()).to_equal(true)
