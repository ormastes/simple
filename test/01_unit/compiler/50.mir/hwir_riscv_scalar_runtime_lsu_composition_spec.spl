use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_lsu_composition.{
    strict_riscv_scalar_runtime_lsu_composition}
use compiler.mir.hwir.host_evaluator.{HwHostInput, evaluate_strict_comb_hwir}

describe "canonical typed runtime LSU pending-path composition":
    it "closes decoded dispatch, LSU transport, completion, fault, and idle lanes":
        val graph = strict_riscv_scalar_runtime_lsu_composition(
            "runtime_lsu_composed", CoreConfig.rv64(), LsuConfig.xlen(64)).unwrap()
        expect(graph.diagnostic()).to_equal("")
        expect(graph.top_ports.any(_.name == "dispatch_decoded_row_index")).to_equal(true)
        expect(graph.top_ports.any(_.name == "dispatch_illegal_valid")).to_equal(true)
        expect(graph.top_ports.any(_.name == "bus_request_address")).to_equal(true)
        expect(graph.top_ports.any(_.name == "selected_completion_memory_trap_valid")).to_equal(true)
        expect(graph.bindings.any(\row: row.source_owner == "pending" and
            row.source_port == "lsu_request_canonical_instruction" and
            row.destination_owner == "projection" and
            row.destination_port == "canonical_instruction")).to_equal(true)
        expect(graph.bindings.any(\row: row.source_owner == "projection" and
            row.source_port == "request_write_data" and
            row.destination_owner == "lsu" and
            row.destination_port == "projected_request_write_data")).to_equal(true)
        expect(graph.bindings.any(\row: row.source_owner == "lsu" and
            row.source_port == "completion_provider_tag" and
            row.destination_owner == "pending" and
            row.destination_port == "lsu_completion_tag")).to_equal(true)
        expect(graph.bindings.any(\row: row.source_owner == "idle" and
            row.destination_owner == "pending" and
            row.destination_port == "muldiv_completion_valid")).to_equal(true)
        for lane in ["muldiv", "csr", "fence"]:
            for port in graph.pending.ports:
                if port.direction == "in" and port.name.starts_with(lane + "_"):
                    expect(graph.bindings.any(\row: row.source_owner == "idle" and
                        row.destination_owner == "pending" and
                        row.destination_port == port.name and
                        row.bit_width == port.bit_width)).to_equal(true)

    it "evaluates the LSU-only route and suppresses illegal marked dispatch":
        val graph = strict_riscv_scalar_runtime_lsu_composition(
            "runtime_lsu_route", CoreConfig.rv32(), LsuConfig.xlen(32)).unwrap()
        val legal = evaluate_strict_comb_hwir(graph.route, [
            HwHostInput.bits("dispatch_valid", 1), HwHostInput.bits("decode_legal", 1),
            HwHostInput.bits("illegal_valid", 0), HwHostInput.bits("decoded_execution_class", 3),
            HwHostInput.bits("pending_dispatch_ready", 1),
            HwHostInput.bits("pending_uop_ready", 1)]).unwrap()
        expect(legal.value_of("lsu_dispatch_valid").unwrap()).to_equal(1)
        expect(legal.value_of("lsu_dispatch_tag").unwrap()).to_equal(1)
        expect(legal.value_of("dispatch_ready").unwrap()).to_equal(1)
        expect(legal.value_of("uop_ready").unwrap()).to_equal(1)
        val illegal = evaluate_strict_comb_hwir(graph.route, [
            HwHostInput.bits("dispatch_valid", 1), HwHostInput.bits("decode_legal", 1),
            HwHostInput.bits("illegal_valid", 1), HwHostInput.bits("decoded_execution_class", 3),
            HwHostInput.bits("pending_dispatch_ready", 1),
            HwHostInput.bits("pending_uop_ready", 1)]).unwrap()
        expect(illegal.value_of("lsu_dispatch_valid").unwrap()).to_equal(0)
        expect(illegal.value_of("dispatch_ready").unwrap()).to_equal(0)
        expect(illegal.value_of("uop_ready").unwrap()).to_equal(0)

    it "has a deterministic canonical hash and rejects invalid construction":
        val bus = LsuConfig.xlen(32)
        val first = strict_riscv_scalar_runtime_lsu_composition(
            "runtime_lsu_exact", CoreConfig.rv32(), bus).unwrap()
        val second = strict_riscv_scalar_runtime_lsu_composition(
            "runtime_lsu_exact", CoreConfig.rv32(), bus).unwrap()
        expect(first.structural_sha256()).to_equal(second.structural_sha256())
        expect(first.structural_sha256().len()).to_equal(64)
        expect(strict_riscv_scalar_runtime_lsu_composition(
            "", CoreConfig.rv32(), bus).is_err()).to_equal(true)
