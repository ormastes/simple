use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_execution.{strict_riscv_scalar_alu_retire_projection_hwir}
use compiler.mir.hwir.riscv_scalar_control_projection.{strict_riscv_scalar_control_projection_hwir}
use compiler.mir.hwir.riscv_scalar_completion_interface.{HwScalarCompletionAdapter,
    HwScalarCompletionBinding, HwScalarCompletionField, HwScalarCompletionInterface,
    strict_hw_scalar_completion_adapter, strict_hw_scalar_completion_interface}

describe "frozen scalar completion interface v1":
    it "should freeze one concrete handshake payload and geometry hash":
        val rv32 = strict_hw_scalar_completion_interface(CoreConfig.rv32(),
            LsuConfig.rv32_product_default()).unwrap()
        val rv64 = strict_hw_scalar_completion_interface(CoreConfig.rv64(),
            LsuConfig.rv64_product_default()).unwrap()
        expect(rv32.diagnostic()).to_equal("")
        expect(rv32.fields[0].name).to_equal("completion_valid")
        expect(rv32.fields[0].direction).to_equal("out")
        expect(rv32.fields[1].name).to_equal("completion_ready")
        expect(rv32.fields[1].direction).to_equal("in")
        expect(rv32.fields.len()).to_equal(24)
        expect(rv32.structural_sha256().len()).to_equal(64)
        expect(rv32.structural_sha256() == rv64.structural_sha256()).to_equal(false)

    it "should structurally adapt existing ALU and control outputs":
        val config = CoreConfig.rv64_zca_mission_critical()
        val completion = strict_hw_scalar_completion_interface(config,
            LsuConfig.rv64_product_default()).unwrap()
        val alu = strict_riscv_scalar_alu_retire_projection_hwir(
            "completion_alu", config, 0x002081B3).unwrap()
        val control = strict_riscv_scalar_control_projection_hwir(
            "completion_control", config, 0x00208463).unwrap()
        val alu_adapter = strict_hw_scalar_completion_adapter(
            "alu", completion, alu).unwrap()
        val control_adapter = strict_hw_scalar_completion_adapter(
            "control", completion, control).unwrap()
        expect(alu_adapter.diagnostic_for_provider(alu)).to_equal("")
        expect(control_adapter.diagnostic_for_provider(control)).to_equal("")
        expect(alu_adapter.bindings.len()).to_equal(24)
        expect(control_adapter.bindings.len()).to_equal(24)
        expect(alu_adapter.structural_sha256() ==
            control_adapter.structural_sha256()).to_equal(false)
        expect(alu_adapter.bindings[1].source_kind).to_equal("hold_contract")

    it "should reject field direction width name and geometry mutations":
        val base_direction = strict_hw_scalar_completion_interface(CoreConfig.rv32(),
            LsuConfig.rv32_product_default()).unwrap()
        var direction_fields = base_direction.fields
        direction_fields[1] = HwScalarCompletionField(name: "completion_ready",
            direction: "out", bit_width: 1, semantic: "atomic-accept")
        val direction = HwScalarCompletionInterface(version: base_direction.version,
            config: base_direction.config, lsu: base_direction.lsu, fields: direction_fields)
        expect(direction.diagnostic()).to_contain("SHAPE")
        val base_width = strict_hw_scalar_completion_interface(CoreConfig.rv32(),
            LsuConfig.rv32_product_default()).unwrap()
        var width_fields = base_width.fields
        width_fields[10] = HwScalarCompletionField(name: "rd_value", direction: "out",
            bit_width: 64, semantic: "architectural")
        val width = HwScalarCompletionInterface(version: base_width.version,
            config: base_width.config, lsu: base_width.lsu, fields: width_fields)
        expect(width.diagnostic()).to_contain("SHAPE")
        val base_duplicate = strict_hw_scalar_completion_interface(CoreConfig.rv32(),
            LsuConfig.rv32_product_default()).unwrap()
        var duplicate_fields = base_duplicate.fields
        duplicate_fields[1] = HwScalarCompletionField(name: "COMPLETION_VALID",
            direction: "in", bit_width: 1, semantic: "atomic-accept")
        val duplicate = HwScalarCompletionInterface(version: base_duplicate.version,
            config: base_duplicate.config, lsu: base_duplicate.lsu, fields: duplicate_fields)
        expect(duplicate.diagnostic()).to_contain("NAME")
        expect(strict_hw_scalar_completion_interface(CoreConfig.rv32(),
            LsuConfig(bus_data_bits: 64, byte_mask_bits: 4)).is_err()).to_equal(true)

    it "should reject adapter binding endpoint width duplication and provider drift":
        val config = CoreConfig.rv32()
        val completion = strict_hw_scalar_completion_interface(config,
            LsuConfig.rv32_product_default()).unwrap()
        val provider = strict_riscv_scalar_alu_retire_projection_hwir(
            "completion_mutation", config, 0x002081B3).unwrap()
        val endpoint_base = strict_hw_scalar_completion_adapter(
            "alu", completion, provider).unwrap()
        var endpoint_bindings = endpoint_base.bindings
        endpoint_bindings[0] = HwScalarCompletionBinding(interface_field: "completion_valid",
            source_kind: "provider", source_name: "retire_rd_write", bit_width: 1)
        val endpoint = HwScalarCompletionAdapter(provider_kind: endpoint_base.provider_kind,
            completion_interface: endpoint_base.completion_interface, provider_graph_sha256: endpoint_base.provider_graph_sha256,
            bindings: endpoint_bindings)
        expect(endpoint.diagnostic_for_provider(provider)).to_contain("BINDING")
        val width_base = strict_hw_scalar_completion_adapter(
            "alu", completion, provider).unwrap()
        var width_bindings = width_base.bindings
        width_bindings[0] = HwScalarCompletionBinding(interface_field: "completion_valid",
            source_kind: "provider", source_name: "retire_valid", bit_width: 32)
        val width = HwScalarCompletionAdapter(provider_kind: width_base.provider_kind,
            completion_interface: width_base.completion_interface, provider_graph_sha256: width_base.provider_graph_sha256,
            bindings: width_bindings)
        expect(width.diagnostic_for_provider(provider)).to_contain("BINDING")
        val duplicate_base = strict_hw_scalar_completion_adapter(
            "alu", completion, provider).unwrap()
        var duplicate_bindings = duplicate_base.bindings
        duplicate_bindings[1] = HwScalarCompletionBinding(interface_field: "COMPLETION_VALID",
            source_kind: "hold_contract", source_name: "upstream_ready", bit_width: 1)
        val duplicate = HwScalarCompletionAdapter(provider_kind: duplicate_base.provider_kind,
            completion_interface: duplicate_base.completion_interface, provider_graph_sha256: duplicate_base.provider_graph_sha256,
            bindings: duplicate_bindings)
        expect(duplicate.diagnostic_for_provider(provider)).to_contain("BINDING")
        val other_provider = strict_riscv_scalar_alu_retire_projection_hwir(
            "completion_other", config, 0x002081B3).unwrap()
        val exact = strict_hw_scalar_completion_adapter(
            "alu", completion, provider).unwrap()
        expect(exact.diagnostic_for_provider(other_provider)).to_contain("PROVIDER")
