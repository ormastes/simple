use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{strict_riscv_scalar_muldiv_projection}
use compiler.mir.hwir.riscv_scalar_muldiv_iterative_contract.{
    strict_riscv_scalar_muldiv_iterative_contract}
use compiler.mir.hwir.riscv_scalar_muldiv_dispatch_datapath.{
    strict_riscv_scalar_muldiv_dispatch_datapath}

fn config(xlen: i32, profile: text) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: xlen, register_count: 32,
        profile: "riscv-gen2-" + profile, isa_profile: profile,
        compressed_decode_profile: "none")

fn dispatch(xlen: i32, instruction: u32):
    strict_riscv_scalar_muldiv_dispatch_datapath(
        strict_riscv_scalar_muldiv_iterative_contract(
            strict_riscv_scalar_muldiv_projection(config(xlen,
                if xlen == 32: "rv32im" else: "rv64im"),
                "iterative", instruction).unwrap()).unwrap()).unwrap()

describe "RISC-V Gen2 M/Zmmul dispatch normalization datapath":
    it "freezes signedness separately for MULH MULHSU and MULHU":
        val mulh = dispatch(64, 0x022091B3)
        expect(mulh.constants.any(_.name == "lhs_signed_constant" and _.canonical_bits == "1")).to_equal(true)
        expect(mulh.constants.any(_.name == "rhs_signed_constant" and _.canonical_bits == "1")).to_equal(true)
        val mulhsu = dispatch(64, 0x0220A1B3)
        expect(mulhsu.constants.any(_.name == "lhs_signed_constant" and _.canonical_bits == "1")).to_equal(true)
        expect(mulhsu.constants.any(_.name == "rhs_signed_constant" and _.canonical_bits == "0")).to_equal(true)
        val mulhu = dispatch(64, 0x0220B1B3)
        expect(mulhu.constants.any(_.name == "lhs_signed_constant" and _.canonical_bits == "0")).to_equal(true)

    it "constructs magnitude and signed division special predicates at operand width":
        val divw = dispatch(64, 0x0220C1BB)
        expect(divw.contract.operand_width).to_equal(32)
        expect(divw.comb_ops.any(_.result == "divisor_zero" and _.op == "eq")).to_equal(true)
        expect(divw.comb_ops.any(_.result == "signed_overflow" and _.op == "and")).to_equal(true)
        expect(divw.select_ops.any(_.result == "special_value" and
            _.when_false == "overflow_or_none")).to_equal(true)

    it "keeps unsigned division free of signed magnitude correction":
        val divu = dispatch(64, 0x0220D1B3)
        expect(divu.constants.any(_.name == "lhs_signed_constant" and _.canonical_bits == "0")).to_equal(true)
        expect(divu.constants.any(_.name == "signed_division_constant" and _.canonical_bits == "0")).to_equal(true)
