# @req REQ-SSPEC-COMPILER
# Exercise the real parser -> HIR -> MIR path. Backend-only literal tests miss
# the frontend constructor inserted after a NUL-bearing Opaque(str) constant.
use std.spec.{describe, it, expect}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.core.parser.{par_had_error_get}

fn nul_literal_is_raw_bytes(type_: MirType) -> bool:
    match type_.kind:
        case Ptr(element, mutable_):
            match element.kind:
                case U8: not mutable_
                case _: false
        case _: false

fn check_literal_constructor(authored: text, expected: [i64], needs_counted: bool):
    val file = "testdata/nul_literal_constructor.spl"
    val source = "fn literal() -> text:\n    " + authored + "\n"
    val parsed = parse_full_frontend(source, file, "nul_literal_constructor", Logger(level: 0))
    expect(par_had_error_get()).to_equal(false)
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    expect(hir_lowering.errors.len()).to_equal(0)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    var literals = 0
    var constructors = 0
    for function in mir.functions.values():
        var literal_id = -1
        var length_values: Dict<i64, i64> = {}
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Const(dest, MirConstValue.Str(value), type_):
                        literals = literals + 1
                        literal_id = dest.id
                        expect(value.len()).to_equal(expected.len())
                        for i in 0..expected.len():
                            expect(value.byte_at(i) as i64).to_equal(expected[i])
                        if needs_counted:
                            expect(nul_literal_is_raw_bytes(type_)).to_equal(true)
                        else:
                            match type_.kind:
                                case Opaque(name): expect(name).to_equal("str")
                                case _: expect(false).to_equal(true)
                    case MirInstKind.Const(dest, MirConstValue.Int(value), _):
                        length_values[dest.id] = value
                    case MirInstKind.Call(_, callee, args):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), type_):
                                if name == "rt_string_new":
                                    constructors = constructors + 1
                                    expect(args.len()).to_equal(2)
                                    match type_.kind:
                                        case FuncPtr(signature):
                                            expect(signature.params.len()).to_equal(2)
                                            expect(nul_literal_is_raw_bytes(signature.params[0])).to_equal(true)
                                        case _: expect(false).to_equal(true)
                                    match args[0].kind:
                                        case Copy(local): expect(local.id).to_equal(literal_id)
                                        case _: expect(false).to_equal(true)
                                    match args[1].kind:
                                        case Copy(local): expect(length_values.get(local.id) ?? -1).to_equal(expected.len())
                                        case _: expect(false).to_equal(true)
                            case _: pass
                    case _: pass
    expect(literals).to_equal(1)
    expect(constructors).to_equal(if needs_counted: 1 else: 0)

describe "NUL literal constructor input representation":
    it "uses raw bytes and exact lengths for leading, interior and trailing NUL":
        check_literal_constructor("\"\\0A\"", [0, 65], true)
        check_literal_constructor("\"A\\0é\"", [65, 0, 195, 169], true)
        check_literal_constructor("\"A\\0\"", [65, 0], true)
    it "keeps ordinary empty ASCII and UTF8 literals typed as text":
        check_literal_constructor("\"\"", [], false)
        check_literal_constructor("\"ABC\"", [65, 66, 67], false)
        check_literal_constructor("\"é\"", [195, 169], false)
