use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_lsu_owner.{strict_riscv_scalar_lsu_owner}
use compiler.mir.hwir.riscv_scalar_completion_interface.{strict_hw_scalar_completion_interface}
use compiler.backend.backend.riscv_scalar_lsu_owner_to_vhdl.{compile_strict_riscv_scalar_lsu_owner}

describe "typed scalar LSU transaction owner":
    it "should bind one projection and order fail-closed protocol rules":
        val built = strict_riscv_scalar_lsu_owner("rv64_ld_owner", CoreConfig.rv64(),
            LsuConfig.rv64_product_default(), 0x0000B083)
        expect(built.is_ok()).to_equal(true)
        if built.is_ok():
            val module = built.ok().unwrap()
            expect(module.diagnostic()).to_equal("")
            expect(module.child_entity).to_equal("rv64_ld_owner_access_projection")
            expect(module.child_graph_sha256.len()).to_equal(64)
            expect(module.plan.rules[0].name).to_equal("retire_consume")
            expect(module.plan.rules[1].name).to_equal("response_match")
            expect(module.plan.rules[2].name).to_equal("response_mismatch")
            expect(module.plan.rules[3].name).to_equal("request_accept")
            expect(module.plan.rules[4].name).to_equal("dispatch_identity_mismatch")
            expect(module.plan.rules[5].name).to_equal("local_fault")
            expect(module.plan.rules[6].name).to_equal("id_exhaustion")
            expect(module.plan.rules[7].name).to_equal("request_capture")
            expect(module.plan.port_direction(module.ports, "request_ready")).to_equal("in")
            expect(module.plan.port_direction(module.ports, "response_ready")).to_equal("out")
            expect(module.plan.rules[1].guards[2].lhs).to_equal("issued_reg")
            expect(module.plan.outputs[1].kind).to_equal("all")
            expect(module.plan.outputs[1].guards[1].lhs).to_equal("issued_reg")
            expect(module.plan.rules[0].guards[2].lhs).to_equal("response_absent")
            expect(module.plan.decoder_pins[0].signal_name).to_equal("selected_rs1_value")
            expect(module.plan.port_direction(module.ports, "dispatch_lineage_valid")).to_equal("in")
            expect(module.plan.port_direction(module.ports, "dispatch_event_id")).to_equal("in")
            expect(module.plan.named_width(module.ports, "completion_event_id")).to_equal(64)
            expect(module.plan.named_width(module.ports, "completion_decode_event_id")).to_equal(64)
            expect(module.plan.named_width(module.ports, "completion_illegal_valid")).to_equal(1)
            expect(module.plan.port_direction(module.ports, "rs1_index")).to_equal("in")
            expect(module.plan.port_direction(module.ports, "rs2_index")).to_equal("in")
            expect(module.plan.rules[4].assignments[0].destination).to_equal("fault_reg")
            expect(module.plan.rules[5].guards[1].lhs).to_equal("dispatch_identity_match")
            expect(module.plan.rules[7].guards[1].lhs).to_equal("dispatch_identity_match")
            expect(module.plan.rules[7].assignments[module.plan.rules[7].assignments.len() - 1].destination).to_equal("rs1_reg")

    it "should freeze load/store-aware source identity comparisons":
        val load = strict_riscv_scalar_lsu_owner("rv64_load_identity", CoreConfig.rv64(),
            LsuConfig.rv64_product_default(), 0x0000B083).unwrap()
        val store = strict_riscv_scalar_lsu_owner("rv64_store_identity", CoreConfig.rv64(),
            LsuConfig.rv64_product_default(), 0x0020B023).unwrap()
        var load_ignore_rs2 = -1
        var store_ignore_rs2 = -1
        for constant in load.datapath_constants:
            if constant.name == "ignore_rs2_match": load_ignore_rs2 = constant.value
        for constant in store.datapath_constants:
            if constant.name == "ignore_rs2_match": store_ignore_rs2 = constant.value
        expect(load_ignore_rs2).to_equal(1)
        expect(store_ignore_rs2).to_equal(0)

    it "should emit normalized request and retirement backpressure around the child":
        val emitted = compile_strict_riscv_scalar_lsu_owner("rv32_lw_owner",
            CoreConfig.rv32(), LsuConfig.rv32_product_default(), 0x0000A083)
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.route).to_equal("hwir-gen2-scalar-lsu-owner-v1")
        expect(emitted.vhdl).to_contain("child: entity work.rv32_lw_owner_access_projection")
        expect(emitted.vhdl).to_contain("request_valid <= '1' when pending_reg='1' and issued_reg='0' else '0';")
        expect(emitted.vhdl).to_contain("elsif request_ready='1' and pending_reg='1' and issued_reg='0' then")
        expect(emitted.vhdl).to_contain("completion_valid <= retire_reg;")
        expect(emitted.vhdl).to_contain("completion_event_id <= event_id_reg when retire_reg='1' else (others=>'0');")
        expect(emitted.vhdl).to_contain("dispatch_event_ids_equal <= '1' when dispatch_event_id = decode_event_id else '0';")
        expect(emitted.vhdl).to_contain("response_ready <= '1' when pending_reg='1' and issued_reg='1' and retire_reg='0' and fault_reg='0' else '0';")
        expect(emitted.vhdl).to_contain("response_id_match <= '1' when response_id = id_reg else '0';")
        expect(emitted.vhdl).to_contain("request_address <= address_reg when pending_reg='1' else (others=>'0');")
        expect(emitted.vhdl).to_contain("rd_value <= value_reg when retire_reg='1' and trap_reg='0' else (others=>'0');")
        expect(emitted.vhdl).to_contain("selected_rs1_value <= rs1_reg when pending_reg='1' else rs1_value;")
        expect(emitted.vhdl).to_contain("response_absent <= '1' when response_valid = zero1 else '0';")

    it "should implement every frozen completion field with captured storage":
        val config = CoreConfig.rv64()
        val bus = LsuConfig.rv64_product_default()
        val completion = strict_hw_scalar_completion_interface(config, bus).unwrap()
        val module = strict_riscv_scalar_lsu_owner("rv64_completion_owner", config,
            bus, 0x0000B083).unwrap()
        for field in completion.fields:
            expect(module.plan.port_direction(module.ports, field.name)).to_equal(field.direction)
        expect(module.plan.named_width(module.ports, "privilege_reg")).to_equal(2)
        expect(module.plan.named_width(module.ports, "original_instruction_reg")).to_equal(32)
        expect(module.plan.named_width(module.ports, "pc_before_reg")).to_equal(64)
        expect(module.plan.named_width(module.ports, "memory_read_mask_reg")).to_equal(32)
        expect(module.origins[0].source_name).to_contain("|completion=")
        expect(module.origins[0].source_name).to_contain("|adapter=")

    it "should fail closed before owner construction for unsupported rows":
        expect(strict_riscv_scalar_lsu_owner("bad", CoreConfig.rv32(),
            LsuConfig.rv32_product_default(), 0x002082B3).is_err()).to_equal(true)
