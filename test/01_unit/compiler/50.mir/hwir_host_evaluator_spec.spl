# @req: REQ-COMPILER-50MIR-001

# codex-system-test
# @manual_section RISC-V Gen2 strict HWIR host evaluator
"""Execute the exact strict combinational graph for composed-predecode oracles."""

use std.spec.*
use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwCompareOp,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp}
use compiler.mir.hwir.host_evaluator.{HwHostInput, evaluate_strict_comb_hwir, prepare_strict_comb_hwir}
use compiler.mir.hwir.trap_frontend.{strict_zca_target_trap_migrating_predecode_hwir}

fn target_trap_inputs(parcel: i64, pc: i64, rs1_index: i64, rs1_value: i64) -> [HwHostInput]:
    [HwHostInput.bits("original_parcel", parcel), HwHostInput.bits("fetch_pc", pc),
        HwHostInput.bits("rs1_index", rs1_index), HwHostInput.bits("rs1_value", rs1_value)]

fn target_trap_module(config: CoreConfig):
    strict_zca_target_trap_migrating_predecode_hwir("host_eval_target_trap", config).unwrap()

fn host_evaluator_mixed_module() -> HwModuleDef:
    val config = CoreConfig.rv32_zca_mission_critical()
    HwModuleDef(
        summary: HwModule(name: "host_evaluator_mixed", profile: config.profile,
            port_count: 6, signal_count: 0, register_count: 0, memory_count: 0,
            comb_op_count: 3, clock_domain_count: 1, fallback_function: "",
            cost: HwCostModel.empty()),
        config: config,
        node_id: HwNodeId.module_root("host_evaluator_mixed"),
        origins: [HwOrigin(node_id: HwNodeId.child("host_evaluator_mixed", "source"),
            source_name: "test.host_evaluator_mixed")],
        ports: [HwPort.input("lhs", "Bits", 4), HwPort.input("rhs", "Bits", 4),
            HwPort.input("choose_lhs", "Bits", 1), HwPort.output("sum", "Bits", 4),
            HwPort.output("equal", "Bits", 1), HwPort.output("selected", "Bits", 4)],
        signals: [], constants: [],
        comb_ops: [HwCombOp.binary("add", "sum", "lhs", "rhs", 4)],
        compare_ops: [HwCompareOp.equal("equal", "lhs", "rhs", 4)],
        select_ops: [HwSelectOp.mux("selected", "choose_lhs", "lhs", "rhs", 4)],
        clock_domains: [HwClockDomain.default_domain()])

describe "RISC-V Gen2 strict HWIR host evaluator":
    # @req REQ-G2-010 REQ-G2-011 NFR-G2-012
    it "should evaluate the exact RV32 and RV64 C.EBREAK trap tuple":
        # @req: REQ-G2-010
        step("Verify: should evaluate the exact RV32 and RV64 C.EBREAK trap tuple")
        step("Build each concrete target-trap graph and execute its typed operations")
        for config in [CoreConfig.rv32_zca_cjal_mission_critical(),
            CoreConfig.rv64_zca_addiw_mission_critical()]:
            val result = evaluate_strict_comb_hwir(target_trap_module(config),
                target_trap_inputs(0x9002, 0x120, 8, 0)).unwrap()
            expect(result.value_of("original_parcel").unwrap()).to_equal(0x9002)  # oracle: 0x9002 — named expected value from the requirement
            expect(result.value_of("canonical_instruction").unwrap()).to_equal(0x00100073)  # oracle: 0x00100073 — named expected value from the requirement
            expect(result.value_of("original_length_bytes").unwrap()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(result.value_of("legal").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.value_of("next_pc").unwrap()).to_equal(0x122)  # oracle: 0x122 — named expected value from the requirement
            expect(result.value_of("redirect_valid").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.value_of("redirect_target").unwrap()).to_equal(0x120)  # oracle: 0x120 — named expected value from the requirement
            expect(result.value_of("trap_valid").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.value_of("trap_cause").unwrap()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(result.value_of("trap_tval").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # @req REQ-G2-001 NFR-G2-001 NFR-G2-012
    it "should prepare one deterministic schedule for repeated concrete parcels":
        # @req: REQ-G2-011
        step("Verify: should prepare one deterministic schedule for repeated concrete parcels")
        step("Resolve the target-trap graph once before varying its parcel input")
        val prepared = prepare_strict_comb_hwir(
            target_trap_module(CoreConfig.rv32_zca_cjal_mission_critical())).unwrap()
        val first = prepared.evaluate(target_trap_inputs(0x2001, 0x100, 0, 0)).unwrap()
        val second = prepared.evaluate(target_trap_inputs(0x9002, 0x100, 0, 0)).unwrap()
        expect(first.value_of("canonical_instruction").unwrap()).to_equal(0x000000ef)  # oracle: 0x000000ef — named expected value from the requirement
        expect(first.value_of("redirect_valid").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(second.value_of("canonical_instruction").unwrap()).to_equal(0x00100073)  # oracle: 0x00100073 — named expected value from the requirement
        expect(second.value_of("trap_valid").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    # @req REQ-G2-010 REQ-G2-011 NFR-G2-012
    it "should fail closed for an unsupported parcel through the composed graph":
        # @req: REQ-G2-001
        step("Verify: should fail closed for an unsupported parcel through the composed graph")
        step("Execute the target-trap graph rather than an independent decoder classifier")
        for config in [CoreConfig.rv32_zca_cjal_mission_critical(),
            CoreConfig.rv64_zca_addiw_mission_critical()]:
            val result = evaluate_strict_comb_hwir(target_trap_module(config),
                target_trap_inputs(0, 0x340, 8, 0)).unwrap()
            expect(result.value_of("canonical_instruction").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.value_of("legal").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.value_of("next_pc").unwrap()).to_equal(0x342)  # oracle: 0x342 — named expected value from the requirement
            expect(result.value_of("redirect_valid").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.value_of("redirect_target").unwrap()).to_equal(0x340)  # oracle: 0x340 — named expected value from the requirement
            expect(result.value_of("trap_valid").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # @req REQ-G2-010 REQ-G2-011 NFR-G2-003 NFR-G2-012
    it "should execute the distinct RV32 C.JAL and RV64 C.ADDIW target rows":
        # @req: REQ-COMPILER-50MIR-001
        step("Verify: should execute the distinct RV32 C.JAL and RV64 C.ADDIW target rows")
        step("Evaluate the target-specific parcel class through each selected graph")
        val rv32 = evaluate_strict_comb_hwir(
            target_trap_module(CoreConfig.rv32_zca_cjal_mission_critical()),
            target_trap_inputs(0x2001, 0x180, 0, 0)).unwrap()
        expect(rv32.value_of("legal").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rv32.value_of("canonical_instruction").unwrap()).to_equal(0x000000ef)  # oracle: 0x000000ef — named expected value from the requirement
        expect(rv32.value_of("redirect_valid").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rv32.value_of("next_pc").unwrap()).to_equal(0x180)  # oracle: 0x180 — named expected value from the requirement
        expect(rv32.value_of("trap_valid").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val rv64 = evaluate_strict_comb_hwir(
            target_trap_module(CoreConfig.rv64_zca_addiw_mission_critical()),
            target_trap_inputs(0x2085, 0x1a0, 1, 0)).unwrap()
        expect(rv64.value_of("legal").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rv64.value_of("canonical_instruction").unwrap()).to_equal(0x0010809b)  # oracle: 0x0010809b — named expected value from the requirement
        expect(rv64.value_of("redirect_valid").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(rv64.value_of("next_pc").unwrap()).to_equal(0x1a2)  # oracle: 0x1a2 — named expected value from the requirement
        expect(rv64.value_of("trap_valid").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # @req REQ-G2-010 NFR-G2-003
    it "should preserve a PA64 high-bit indirect JALR target as a logical shift":
        # @req: REQ-G2-010
        step("Verify: should preserve a PA64 high-bit indirect JALR target as a logical shift")
        step("Use an allowed PA64 RV64 product to expose unsigned shift-right semantics")
        val config = CoreConfig(xlen: 64, physical_address_bits: 64, register_count: 32,
            profile: "riscv-gen2-rv64-zca-addiw-critical", isa_profile: "rv64i_zca",
            compressed_decode_profile: "zca-common-critical")
        val result = evaluate_strict_comb_hwir(target_trap_module(config),
            target_trap_inputs(0x8082, 0x80, 1, -9223372036854775805)).unwrap()
        expect(result.value_of("legal").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.value_of("canonical_instruction").unwrap()).to_equal(0x00008067)  # oracle: 0x00008067 — named expected value from the requirement
        expect(result.value_of("redirect_valid").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.value_of("redirect_target").unwrap()).to_equal(-9223372036854775806)  # oracle: -9223372036854775806 — named expected value from the requirement
        expect(result.value_of("next_pc").unwrap()).to_equal(-9223372036854775806)  # oracle: -9223372036854775806 — named expected value from the requirement

    # @req REQ-G2-001 NFR-G2-002
    it "should reject missing or non-input host values before graph execution":
        # @req: REQ-G2-011
        step("Verify: should reject missing or non-input host values before graph execution")
        step("Prove the evaluator cannot silently fabricate a register operand")
        val module = target_trap_module(CoreConfig.rv32_zca_cjal_mission_critical())
        val missing = evaluate_strict_comb_hwir(module,
            [HwHostInput.bits("original_parcel", 0x9002), HwHostInput.bits("fetch_pc", 0),
                HwHostInput.bits("rs1_index", 8)])
        expect(missing.err().unwrap()).to_contain("HWIR-E-HOST-EVAL-INPUT")
        val output_as_input = evaluate_strict_comb_hwir(module,
            [HwHostInput.bits("original_parcel", 0x9002), HwHostInput.bits("fetch_pc", 0),
                HwHostInput.bits("rs1_index", 8), HwHostInput.bits("rs1_value", 0),
                HwHostInput.bits("legal", 1)])
        expect(output_as_input.err().unwrap()).to_contain("HWIR-E-HOST-EVAL-INPUT")

    # @req REQ-G2-001 NFR-G2-002
    it "should reject empty and duplicate host inputs before any result is produced":
        # @req: REQ-G2-001
        step("Verify: should reject empty and duplicate host inputs before any result is produced")
        step("Prepare the concrete graph once and present malformed host input tuples")
        val prepared = prepare_strict_comb_hwir(
            target_trap_module(CoreConfig.rv32_zca_cjal_mission_critical())).unwrap()
        val empty_name = prepared.evaluate([
            HwHostInput.bits("original_parcel", 0x9002), HwHostInput.bits("fetch_pc", 0),
            HwHostInput.bits("rs1_index", 8), HwHostInput.bits("", 0)])
        expect(empty_name.err().unwrap()).to_start_with("HWIR-E-HOST-EVAL-INPUT")
        val duplicate = prepared.evaluate([
            HwHostInput.bits("original_parcel", 0x9002), HwHostInput.bits("fetch_pc", 0),
            HwHostInput.bits("rs1_index", 8), HwHostInput.bits("rs1_value", 0),
            HwHostInput.bits("fetch_pc", 2)])
        expect(duplicate.err().unwrap()).to_start_with("HWIR-E-HOST-EVAL-INPUT")

    # @req REQ-G2-001 NFR-G2-001 NFR-G2-012
    it "should normalize inputs and evaluate both equality and mux outcomes":
        # @req: REQ-COMPILER-50MIR-001
        step("Verify: should normalize inputs and evaluate both equality and mux outcomes")
        step("Evaluate a compact strict graph through both compare and select branches")
        val prepared = prepare_strict_comb_hwir(host_evaluator_mixed_module()).unwrap()
        val choose_lhs = prepared.evaluate([
            HwHostInput.bits("lhs", 0x1f), HwHostInput.bits("rhs", 3),
            HwHostInput.bits("choose_lhs", 1)]).unwrap()
        expect(choose_lhs.value_of("sum").unwrap()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(choose_lhs.value_of("equal").unwrap()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(choose_lhs.value_of("selected").unwrap()).to_equal(15)  # oracle: 15 — named expected value from the requirement
        val choose_rhs_equal = prepared.evaluate([
            HwHostInput.bits("lhs", 3), HwHostInput.bits("rhs", 3),
            HwHostInput.bits("choose_lhs", 0)]).unwrap()
        expect(choose_rhs_equal.value_of("sum").unwrap()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(choose_rhs_equal.value_of("equal").unwrap()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(choose_rhs_equal.value_of("selected").unwrap()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    # @req REQ-G2-001 NFR-G2-002
    it "should reject unsupported, width-invalid, and unreadable self-referential strict graphs before scheduling":
        # @req: REQ-G2-010
        step("Verify: should reject unsupported, width-invalid, and unreadable self-referential strict graphs before scheduling")
        step("Mutate independent typed graphs at the strict validation boundary")
        val unsupported = host_evaluator_mixed_module()
        unsupported.comb_ops[0].op = "not_a_strict_op"
        expect(prepare_strict_comb_hwir(unsupported).err().unwrap()).to_start_with("HWIR-E-COMB")
        val wrong_width = host_evaluator_mixed_module()
        wrong_width.comb_ops[0].bit_width = 3
        expect(prepare_strict_comb_hwir(wrong_width).err().unwrap()).to_start_with("HWIR-E-COMB")
        val cycle = host_evaluator_mixed_module()
        cycle.comb_ops[0].lhs = "sum"
        expect(prepare_strict_comb_hwir(cycle).err().unwrap()).to_start_with("HWIR-E-OP-OPERAND-DIRECTION")
