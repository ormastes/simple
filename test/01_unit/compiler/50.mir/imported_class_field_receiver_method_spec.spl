# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: method call on a field of an imported class

Phase-3 bootstrap (producer4, 2026-10-19) failed 119 modules with
`unresolved method call: add_error` and friends on `self.ctx.add_error(..)`
inside `impl CompilerDriver:` blocks that live in a different module from the
class declaration. `var c = self.ctx; c.add_error(..)` lowered fine.
(`self.symbols.define(..)`, `self.symbols.lookup_or_invalid(..)` and the
other `<base>.<field>.<method>()` sites are the same shape: 418 of the 696
located errors in that cluster.)

Root cause: `declared_field_hir_type` answered the field's declared type from
the bare-name layout row, whose `Named` ids come from the DEFINING module's
SymbolTable. Read through the consumer table that id names an unrelated
symbol, so the unresolved-receiver dispatch looked up
`<wrong owner>::add_error` and missed -- and because the declared answer was
non-nil it shadowed the correctly rebound field-load local type.

Each example lowers a consumer through HIR and MIR in-process with every
module passed as a provider, like the driver's entry-closure loop.
"""

# @tag: unit, compiler, mir

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules, ModuleSurfacesByName}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val ctx_source = "pub class Ctx:\n    errors: [text]\n\nimpl Ctx:\n    me add_error(message: text):\n        self.errors.push(message)\n"

val drv_source = "use lib.ctx.\{Ctx\}\n\npub class Drv:\n    ctx: Ctx\n"

# Import order matters: `lib.drv` imports Ctx first, the consumer imports Drv
# first, so `Ctx` gets different ids in the two tables. With Ctx imported
# first the ids happen to align and the defect is hidden (measured on
# producer4: same body passes with `use Ctx` first, fails with `use Drv` first).
val consumer_source = "use lib.drv.\{Drv\}\nuse lib.ctx.\{Ctx\}\n\nimpl Drv:\n    me check(n: i64) -> bool:\n        self.ctx.add_error(\"self_field\")\n        true\n\nfn via_param(d: Drv) -> i64:\n    d.ctx.add_error(\"param_field\")\n    1\n"

fn lower_consumer_errors() -> text:
    val log = Logger(level: 0)
    val ctx_ast = parse_full_frontend(ctx_source, "lib/ctx.spl", "lib.ctx", log)
    val drv_ast = parse_full_frontend(drv_source, "lib/drv.spl", "lib.drv", log)
    val main_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.ctx"] = ctx_ast
    modules["lib.drv"] = drv_ast
    modules["app.main"] = main_ast
    val sources = [SourceFile(path: "lib/ctx.spl", content: ctx_source, module_name: "lib.ctx"), SourceFile(path: "lib/drv.spl", content: drv_source, module_name: "lib.drv"), SourceFile(path: "app/main.spl", content: consumer_source, module_name: "app.main")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var ctx_lowering = hirlowering_for_module("lib.ctx", surfaces)
    var drv_lowering = hirlowering_for_module("lib.drv", surfaces)
    var main_lowering = hirlowering_for_module("app.main", surfaces)
    val ctx_hir = ctx_lowering.lower_module(ctx_ast)
    val drv_hir = drv_lowering.lower_module(drv_ast)
    val main_hir = main_lowering.lower_module(main_ast)
    var hir_modules: Dict<text, HirModule> = {}
    hir_modules["lib.ctx"] = ctx_hir
    hir_modules["lib.drv"] = drv_hir
    hir_modules["app.main"] = main_hir
    var mir_lowering = MirLowering.new(main_hir.symbols)
    for module_key in hir_modules.keys():
        mir_lowering.prescan_module_struct_names(hir_modules, module_key)
    mir_lowering.lower_module(main_hir, [ctx_hir, drv_hir, main_hir])
    var out = ""
    for e in mir_lowering.errors:
        out = out + e.message + "\n"
    print "imported_class_field_receiver mir errors: [{out}]"
    out

describe "method call on a field of an imported class":
    it "resolves self.field.method() and param.field.method() in an impl outside the class module":
        val errs = lower_consumer_errors()
        expect(errs.contains("unresolved method call")).to_equal(false)
