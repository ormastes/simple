# @req REQ-SSPEC-COMPILER
"""
# A `val` bound from an untyped `if` expression is typed by its branch join

Bug: doc/08_tracking/bug/hir_if_expr_result_subject_untyped_2026-11-07.md.
Stage 2 bootstrap run 13 failed `src/compiler/99.loader/loader/jit_instantiator.spl:419`:

    val code_result = if ok: Ok(code) else: Err(message)
    match code_result:
        case Ok(compiled_code): ...

with "enum match: bare variant 'Ok' is ambiguous (declared in multiple
enums) ... has type unresolved". HIR left the binding untyped: an `if`
expression with an else branch was not typed from its branches (a bare builtin
`Ok(x)` / `Err(e)` tail is a Result whose other arm the join fills). Another enum in the closure that
declares `Ok`/`Err` then makes the bare arms ambiguous.

Through pure-Simple HIR+MIR in-process (seed-hosted), the binding must carry
the join of its branch types (`Result<T, E>`), and the match must lower clean.
Branches that do not join stay untyped, so the match still fails closed.
"""

# @tag: unit, compiler, mir, hir, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

fn lines(xs: [text]) -> text:
    xs.join("\n") + "\n"

fn lower_closure(names: [text], srcs: [text]) -> text:
    """Lower every module through HIR, prescan all, then MIR-lower the last one.
    Returns the concatenated HIR/MIR diagnostics ("" when clean)."""
    val log = Logger(level: 0)
    var modules: Dict<text, Module> = {}
    var sources: [SourceFile] = []
    var asts: [Module] = []
    var i = 0
    while i < names.len():
        val path = names[i].replace(".", "/") + ".spl"
        val ast = parse_full_frontend(srcs[i], path, names[i], log)
        modules[names[i]] = ast
        sources.push(SourceFile(path: path, content: srcs[i], module_name: names[i]))
        asts.push(ast)
        i = i + 1
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var hirs: [HirModule] = []
    var out = ""
    i = 0
    while i < names.len():
        var hl = hirlowering_for_module(names[i], surfaces)
        hirs.push(hl.lower_module(asts[i]))
        for e in hl.errors:
            out = out + "hir: " + e.message + "\n"
        i = i + 1
    val last = hirs.len() - 1
    var ml = MirLowering.new(hirs[last].symbols)
    var pre: Dict<text, HirModule> = {}
    i = 0
    while i < names.len():
        pre["m" + i.to_text()] = hirs[i]
        i = i + 1
    i = 0
    while i < names.len():
        ml.prescan_module_struct_names(pre, "m" + i.to_text())
        i = i + 1
    val mir = ml.lower_module(hirs[last], hirs)
    for e in ml.errors:
        if not e.message.contains("non-exhaustive enum match"):
            out = out + "mir: " + e.message + "\n"
    print "diagnostics: [" + out + "]"
    out

# Another module declares an enum that also owns `Ok` and `Err`.
val OTHER = lines(["pub enum Status:", "    Ok", "    Err(code: i64)"])

fn lower_main(body: [text]) -> text:
    lower_closure(["lib.other", "app.main"], [OTHER, lines(body)])

describe "if-expression Result join types the bound subject":
    it "val bound from if Ok(..) else Err(..) matches bare Ok/Err":
        val d = lower_main(["fn f(b: bool) -> i64:", "    val r = if b: Ok(1) else: Err(\"x\")", "    match r:", "        case Ok(v): v", "        case Err(_): 0"])
        expect(d).to_equal("")

    it "block-form if with Ok/Err tails (jit_instantiator shape) matches bare Ok/Err":
        val d = lower_main(["fn f(b: bool, n: i64, m: text) -> i64:", "    val r = if b:", "        Ok(n)", "    else:", "        Err(if m == \"\": \"Unknown error\" else: m)", "    match r:", "        case Ok(v): v", "        case Err(_): 0"])
        expect(d).to_equal("")

    it "branches that do not join (Ok vs plain i64) stay untyped and still fail closed":
        val d = lower_main(["fn f(b: bool) -> i64:", "    val r = if b: Ok(1) else: 2", "    match r:", "        case Ok(v): v", "        case _: 0"])
        expect(d.contains("is ambiguous")).to_equal(true)

    it "Result branches with conflicting settled Ok types do not join and still fail closed":
        val d = lower_main(["fn f(b: bool, n: i64, m: text) -> i64:", "    val r = if b: Ok(n) else: Ok(m)", "    match r:", "        case Ok(_): 1", "        case _: 0"])
        expect(d.contains("is ambiguous")).to_equal(true)
