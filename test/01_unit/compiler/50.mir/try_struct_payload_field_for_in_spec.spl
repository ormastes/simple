# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: `?` on a Result whose Ok payload is a record keeps the owner

`val f = make()?` followed by `for x in f.names` failed with #143
("collection mir type: I64") because the `?` payload local never recorded its
record owner, so the field read degraded to an erased word. `.unwrap()` and an
annotated `val f: Frag = make()?` already worked; this pins the unannotated
`?` spelling to the same lowering.
"""

# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn try_payload_messages(src: text) -> [text]:
    val file = "testdata/fixture_try_payload.spl"
    val parsed = parse_full_frontend(src, file, "fixture_try_payload", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    messages

val try_field_src = "class Frag:\n" +
    "    names: [text]\n" +
    "\n" +
    "fn make(n: i64) -> Result<Frag, text>:\n" +
    "    if n < 0: return Err(\"neg\")\n" +
    "    Ok(Frag(names: [\"a\", \"b\"]))\n" +
    "\n" +
    "fn direct() -> Result<i64, text>:\n" +
    "    val f = make(1)?\n" +
    "    var c = 0\n" +
    "    for n in f.names:\n" +
    "        c = c + n.len()\n" +
    "    Ok(c)\n" +
    "\n" +
    "fn via_local() -> Result<i64, text>:\n" +
    "    val f = make(1)?\n" +
    "    val ns = f.names\n" +
    "    var c = 0\n" +
    "    for n in ns:\n" +
    "        c = c + n.len()\n" +
    "    Ok(c)\n" +
    "\n" +
    "fn via_array() -> Result<i64, text>:\n" +
    "    val a = make(1)?\n" +
    "    val b = make(2)?\n" +
    "    val frags = [a, b]\n" +
    "    var c = 0\n" +
    "    for frag in frags:\n" +
    "        for n in frag.names:\n" +
    "            c = c + n.len()\n" +
    "    Ok(c)\n"

describe "MIR lowering: try-operator record payload":
    it "iterates a field of an unannotated `?` record payload":
        val messages = try_payload_messages(try_field_src)
        var all = ""
        for m in messages:
            all = all + m + "\n"
        print "diagnostics: [{all}]"
        expect(messages.len()).to_equal(0)
