fn hardware_cand_intrinsic_function() -> MirFunction:
    var function = hardware_cli_intrinsic_function()
    function.symbol = SymbolId(id: 921)
    function.name = "mir_cand_intrinsic"
    function = with_entry_instruction(function, MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 1)), "__simple_riscv_zca_cand_row_v1", [copy(0)]), span: nil))
    function

