        blocks: [MirBlock(
            id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 1)), "__simple_riscv_zca_cli_row_v1", [copy(0)]), span: nil)],
            terminator: MirTerminator.Ret(Some(copy(1)))
        )],
        entry_block: BlockId(id: 0), span: span(), generic_params: [],
