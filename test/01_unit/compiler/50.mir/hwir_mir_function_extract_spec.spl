fn hardware_rv64_zca_row_intrinsic_function(intrinsic_name: text, function_name: text) -> MirFunction:
    var function = hardware_cli_intrinsic_function()
    function.name = function_name
    function = with_entry_instruction(function, MirInst(kind: MirInstKind.Intrinsic(
        Some(LocalId(id: 1)), intrinsic_name, [copy(0)]), span: nil))
    function

fn has_origin_source(module: HwModuleDef, source_name: text) -> bool:
    for origin in module.origins:
        if origin.source_name == source_name: return true
    false

fn hardware_cj_predecode_intrinsic_function(address_bits: i64) -> MirFunction:
    val parcel = bits_type(16)
    val pc = bits_type(address_bits)
    val result = cj_predecode_result_type(address_bits)
    MirFunction(
        symbol: SymbolId(id: 928), name: "mir_cj_predecode_intrinsic",
        signature: MirSignature(params: [parcel, pc], return_type: result, is_variadic: false),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("original_parcel"), type_: parcel, kind: LocalKind.Arg(0)),
            MirLocal(id: LocalId(id: 1), name: Some("fetch_pc"), type_: pc, kind: LocalKind.Arg(1)),
            MirLocal(id: LocalId(id: 2), name: Some("predecoded"), type_: result, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 3), name: nil, type_: result, kind: LocalKind.Return)
        ],
        blocks: [MirBlock(
            id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 2)), "__simple_riscv_zca_cj_predecode_v1", [copy(0), copy(1)]), span: nil)],
            terminator: MirTerminator.Ret(Some(copy(2)))
        )],
        entry_block: BlockId(id: 0), span: span(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: true,
        vhdl_metadata: hardware_metadata(false), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

fn hardware_cb_predecode_intrinsic_function(address_bits: i64, xlen: i64,
    intrinsic_name: text, function_name: text) -> MirFunction:
    val parcel = bits_type(16)
    val pc = bits_type(address_bits)
    val register_index = bits_type(5)
    val register_value = bits_type(xlen)
    val result = cj_predecode_result_type(address_bits)
    MirFunction(
        symbol: SymbolId(id: 929), name: function_name,
        signature: MirSignature(params: [parcel, pc, register_index, register_value], return_type: result, is_variadic: false),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("original_parcel"), type_: parcel, kind: LocalKind.Arg(0)),
            MirLocal(id: LocalId(id: 1), name: Some("fetch_pc"), type_: pc, kind: LocalKind.Arg(1)),
            MirLocal(id: LocalId(id: 2), name: Some("rs1_index"), type_: register_index, kind: LocalKind.Arg(2)),
            MirLocal(id: LocalId(id: 3), name: Some("rs1_value"), type_: register_value, kind: LocalKind.Arg(3)),
            MirLocal(id: LocalId(id: 4), name: Some("predecoded"), type_: result, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 5), name: nil, type_: result, kind: LocalKind.Return)
        ],
        blocks: [MirBlock(
            id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 4)), intrinsic_name, [copy(0), copy(1), copy(2), copy(3)]), span: nil)],
            terminator: MirTerminator.Ret(Some(copy(4)))
        )],
        entry_block: BlockId(id: 0), span: span(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: true,
        vhdl_metadata: hardware_metadata(false), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

fn with_entry_instruction(mir_function: MirFunction, instruction: MirInst) -> MirFunction:
    var updated = mir_function
    var entry = updated.blocks[0]
    entry.instructions = [instruction]
    updated.blocks = [entry]
    updated

fn with_block_terminator(mir_function: MirFunction, block_index: i32, terminator: MirTerminator) -> MirFunction:
    var updated = mir_function
    var blocks = updated.blocks
    var block = blocks[block_index]
    block.terminator = terminator
    blocks[block_index] = block
    updated.blocks = blocks
    updated

fn with_block_instruction(mir_function: MirFunction, block_index: i32, instruction_index: i32, instruction: MirInst) -> MirFunction:
    var updated = mir_function
    var blocks = updated.blocks
    var block = blocks[block_index]
    var instructions = block.instructions
    instructions[instruction_index] = instruction
    block.instructions = instructions
    blocks[block_index] = block
    updated.blocks = blocks
    updated

fn hardware_caddi_intrinsic_function() -> MirFunction:
    var function = hardware_cli_intrinsic_function()
    function.symbol = SymbolId(id: 908)
    function.name = "mir_caddi_intrinsic"
    function = with_entry_instruction(function, MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 1)), "__simple_riscv_zca_caddi_row_v1", [copy(0)]), span: nil))
    function

