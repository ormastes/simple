# Strict HWIR extraction from real MIR function graphs.
# codex-system-test
# @manual_section Strict real-MIR to HWIR extraction

use std.spec.*
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef}
use compiler.mir.hwir.mir_to_hwir.{lower_strict_mir_function_to_hwir}
use compiler.backend.backend.hwir_to_vhdl.{render_strict_hwir_vhdl, compile_strict_hwir_module}

fn span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1, file: "", length: 0)

fn bool_type() -> MirType:
    MirType(kind: MirTypeKind.Bool)

fn u32_type() -> MirType:
    MirType(kind: MirTypeKind.U32)

fn bits_type(width: i64) -> MirType:
    MirType(kind: MirTypeKind.Bits(width: width, signed: false))

fn cj_predecode_result_type(address_bits: i64) -> MirType:
    MirType(kind: MirTypeKind.Tuple(elements: [
        bits_type(32), bits_type(2), bool_type(), bits_type(address_bits),
        bool_type(), bits_type(address_bits)
    ]))

fn copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))

fn hardware_metadata(clocked: bool):
    var metadata = vhdl_hardware_metadata_default()
    metadata.is_hardware = true
    metadata.has_clocked = clocked
    metadata

fn hardware_and_function() -> MirFunction:
    val bool = bool_type()
    MirFunction(
        symbol: SymbolId(id: 901), name: "mir_bool_and",
        signature: MirSignature(params: [bool, bool], return_type: bool, is_variadic: false),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("left"), type_: bool, kind: LocalKind.Arg(0)),
            MirLocal(id: LocalId(id: 1), name: Some("right"), type_: bool, kind: LocalKind.Arg(1)),
            MirLocal(id: LocalId(id: 2), name: Some("and_value"), type_: bool, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 3), name: nil, type_: bool, kind: LocalKind.Return)
        ],
        blocks: [MirBlock(
            id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.BinOp(LocalId(id: 2), MirBinOp.BitAnd, copy(0), copy(1)), span: nil)],
            terminator: MirTerminator.Ret(Some(copy(2)))
        )],
        entry_block: BlockId(id: 0), span: span(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: true,
        vhdl_metadata: hardware_metadata(false), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

fn hardware_u32_and_function() -> MirFunction:
    var function = hardware_and_function()
    val word = u32_type()
    function.name = "mir_u32_and"
    function.signature = MirSignature(params: [word, word], return_type: word, is_variadic: false)
    var word_locals: [MirLocal] = []
    for local in function.locals:
        local.type_ = word
        word_locals.push(local)
    function.locals = word_locals
    function

