fn hardware_cebreak_decode_function() -> MirFunction:
    val word = u32_type()
    val predicate_type = bool_type()
    MirFunction(
        symbol: SymbolId(id: 906), name: "mir_cebreak_decode",
        signature: MirSignature(params: [word], return_type: word, is_variadic: false),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("parcel"), type_: word, kind: LocalKind.Arg(0)),
            MirLocal(id: LocalId(id: 1), name: Some("cebreak_parcel"), type_: word, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 2), name: Some("is_cebreak"), type_: predicate_type, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 3), name: Some("canonical_ebreak"), type_: word, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 4), name: Some("illegal_instruction"), type_: word, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 5), name: Some("selected"), type_: word, kind: LocalKind.Temp),
            MirLocal(id: LocalId(id: 6), name: nil, type_: word, kind: LocalKind.Return)
        ],
        blocks: [
            MirBlock(
                id: BlockId(id: 0), label: Some("entry"),
                instructions: [
                    MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(0x9002), word), span: nil),
                    MirInst(kind: MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Eq, copy(0), copy(1)), span: nil)
                ],
                terminator: MirTerminator.If(copy(2), BlockId(id: 1), BlockId(id: 2))
            ),
            MirBlock(
                id: BlockId(id: 1), label: Some("matched"),
                instructions: [
                    MirInst(kind: MirInstKind.Const(LocalId(id: 3), MirConstValue.Int(0x00100073), word), span: nil),
                    MirInst(kind: MirInstKind.Copy(LocalId(id: 5), LocalId(id: 3)), span: nil)
                ],
                terminator: MirTerminator.Goto(BlockId(id: 3))
            ),
            MirBlock(
                id: BlockId(id: 2), label: Some("missed"),
                instructions: [
                    MirInst(kind: MirInstKind.Const(LocalId(id: 4), MirConstValue.Int(0), word), span: nil),
                    MirInst(kind: MirInstKind.Copy(LocalId(id: 5), LocalId(id: 4)), span: nil)
                ],
                terminator: MirTerminator.Goto(BlockId(id: 3))
            ),
            MirBlock(
                id: BlockId(id: 3), label: Some("join"), instructions: [],
                terminator: MirTerminator.Ret(Some(copy(5)))
            )
        ],
        entry_block: BlockId(id: 0), span: span(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: true,
        vhdl_metadata: hardware_metadata(false), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )

