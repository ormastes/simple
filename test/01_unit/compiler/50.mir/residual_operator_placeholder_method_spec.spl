# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: record/enum equality, placeholder lambdas, text builtins

Phase-3 residual "unresolved method call" shapes:

- `==` / `!=` on a struct or class with no `__eq__` is structural (interpreter
  `Value::Object` equality, seed runtime `object_eq`); on an enum whose peer
  operand lost its owner (`want[i]`) it is the runtime enum equality; a record
  compared with an integer literal compares words.
- `xs.map(self.f(_.1))` is one lambda over the whole argument (seed
  `transform_placeholder_args_for_call`), not `self.f(\p: p.1)`.
- `text.to_bytes()` / `text.hash()`, `v.to_text()` on an `if val` Int binder,
  and `xs.len()` on an untyped `if val xs = self.d.get(k)` binder.
"""

# @tag:unit
# @tag:compiler
# @tag:mir

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn lowering_messages(src: text) -> [text]:
    val file = "testdata/fixture_residual_method.spl"
    val parsed = parse_full_frontend(src, file, "fixture_residual_method", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        messages = messages.push("mir: " + e.message)
    messages

fn expect_resolved(src: text):
    val messages = lowering_messages(src)
    var all = ""
    for m in messages:
        all = all + m + "\n"
    print "diagnostics: [{all}]"
    expect(messages.len()).to_equal(0)

val struct_eq_src = "struct Digest:\n" +
    "    w0: u64\n" +
    "    w1: u64\n" +
    "\n" +
    "struct Wrap:\n" +
    "    id: i64\n" +
    "    name: text\n" +
    "    d: Digest\n" +
    "\n" +
    "fn same(a: Digest, b: Digest) -> bool:\n" +
    "    a == b\n" +
    "\n" +
    "fn differ(a: Wrap, b: Wrap) -> bool:\n" +
    "    a != b\n" +
    "\n" +
    "fn find(xs: [Wrap], w: Wrap) -> i64:\n" +
    "    var i = 0\n" +
    "    for x in xs:\n" +
    "        if x == w:\n" +
    "            return i\n" +
    "        i = i + 1\n" +
    "    -1\n"

val enum_eq_src = "enum SecKind:\n" +
    "    exports\n" +
    "    debug\n" +
    "\n" +
    "struct Sec:\n" +
    "    kind: SecKind\n" +
    "\n" +
    "fn ok(secs: [Sec]) -> bool:\n" +
    "    val want = [SecKind.exports, SecKind.debug]\n" +
    "    for i in 0..2:\n" +
    "        if secs[i].kind != want[i]:\n" +
    "            return false\n" +
    "    true\n" +
    "\n" +
    "fn zero(s: Sec) -> bool:\n" +
    "    s.kind == 0\n"

val placeholder_src = "class Mapper:\n" +
    "    scale: i64\n" +
    "\n" +
    "    fn one(x: i64) -> text:\n" +
    "        \"<{x * self.scale}>\"\n" +
    "\n" +
    "    fn all(xs: [i64]) -> text:\n" +
    "        xs.map(self.one(_)).join(\",\")\n" +
    "\n" +
    "    fn pairs(ps: [(text, i64)]) -> text:\n" +
    "        ps.map(self.one(_.1)).join(\",\")\n"

val text_builtin_src = "class Tab:\n" +
    "    pay: Dict<text, [i64]>\n" +
    "\n" +
    "    fn pay_len(key: text) -> i64:\n" +
    "        if val xs = self.pay.get(key):\n" +
    "            return xs.len()\n" +
    "        -1\n" +
    "\n" +
    "fn byte_count(s: text) -> i64:\n" +
    "    val name: text = s\n" +
    "    val bs: [u8] = name.to_bytes()\n" +
    "    bs.len()\n" +
    "\n" +
    "fn digest(s: text) -> i64:\n" +
    "    s.hash()\n" +
    "\n" +
    "fn render(lo: i64?) -> text:\n" +
    "    if val v = lo: v.to_text() else: \"none\"\n"

describe "MIR lowering: residual operator, placeholder and builtin method shapes":
    it "lowers == and != on records without __eq__ structurally":
        expect_resolved(struct_eq_src)

    it "lowers enum != against an owner-less peer and enum == 0":
        expect_resolved(enum_eq_src)

    it "lowers a placeholder inside a nested call as the higher-order lambda":
        expect_resolved(placeholder_src)

    it "lowers text to_bytes/hash, if-val to_text and if-val dict-get len":
        expect_resolved(text_builtin_src)

    it "still rejects arithmetic on a record without __add__":
        val messages = lowering_messages("struct P:\n    x: i64\n\nfn add(a: P, b: P) -> P:\n    a + b\n")
        var named = false
        for m in messages:
            if m.contains("operator overload for struct"):
                named = true
        expect(named).to_equal(true)
