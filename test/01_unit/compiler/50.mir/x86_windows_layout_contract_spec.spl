# @cover src/compiler/00.common/target_scalar_alignment.spl
# @cover src/compiler/30.types/_TypeLayout/arch_and_verify.spl
# @cover src/compiler/50.mir/mir_target_hir_layout.spl
# Source-derived regression suite. Execution status is recorded in its manual.
use std.spec.*
use test.fixtures.compiler.x86_windows_layout_contract.{x86_windows_layout_c_contract, x86_windows_layout_policy_contract, x86_windows_layout_datalayout_contract, x86_windows_layout_rejects_unknown, x86_windows_layout_alias_bitfield_contract}

describe "x86 Windows scalar and aggregate ABI agreement":
    it "matches measured MSVC GNU Linux and x64 C-record offsets through both MIR paths":
        expect(x86_windows_layout_c_contract()).to_equal(true)

    it "preserves packed transparent ordered reordered explicit alignment and arch-only policies":
        expect(x86_windows_layout_policy_contract()).to_equal(true)

    it "emits Windows 64-bit scalar alignments while retaining Linux data layout":
        expect(x86_windows_layout_datalayout_contract()).to_equal(true)

    it "rejects unknown target architecture instead of falling back to host layout":
        expect(x86_windows_layout_rejects_unknown()).to_equal(true)

    it "normalizes direct x86 aliases and aligns existing 64-bit bitfield storage":
        expect(x86_windows_layout_alias_bitfield_contract()).to_equal(true)
