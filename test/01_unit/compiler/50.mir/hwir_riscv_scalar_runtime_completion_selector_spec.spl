use std.spec.*
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef}
use compiler.mir.hwir.host_evaluator.{HwHostInput, evaluate_strict_comb_hwir}
use compiler.mir.hwir.riscv_scalar_runtime_completion_selector.{
    strict_riscv_scalar_runtime_completion_selector}

fn selector_inputs(module: HwModuleDef, uop: i64, uop_illegal: i64,
    alu_valid: i64, illegal_valid: i64, ready: i64,
    alu_fault: i64 = 0, illegal_fault: i64 = 0) -> [HwHostInput]:
    var inputs: [HwHostInput] = []
    for port in module.ports:
        if port.direction == "in":
            var value: i64 = 0
            if port.name == "uop_valid": value = uop
            elif port.name == "uop_illegal_valid": value = uop_illegal
            elif port.name == "alu_valid": value = alu_valid
            elif port.name == "illegal_valid": value = illegal_valid
            elif port.name == "completion_ready": value = ready
            elif port.name == "alu_fault": value = alu_fault
            elif port.name == "illegal_fault": value = illegal_fault
            elif port.name == "alu_rd_value": value = 0x33
            elif port.name == "alu_provider_event_id": value = 7
            elif port.name == "illegal_execute_trap_valid": value = 1
            elif port.name == "illegal_execute_trap_cause": value = 2
            elif port.name == "illegal_execute_trap_tval": value = 0xFFFFFFFF
            elif port.name == "illegal_original_instruction": value = 0xFFFFFFFF
            elif port.name == "illegal_illegal_valid": value = 1
            elif port.name == "illegal_provider_event_id": value = 9
            elif port.name == "uop_lineage_valid": value = 1
            elif port.name == "uop_privilege": value = 3
            elif port.name == "uop_original_instruction": value = if uop_illegal == 1: 0xFFFFFFFF else: 0
            elif port.name == "uop_canonical_instruction": value = if uop_illegal == 1: 0xFFFFFFFF else: 0
            elif port.name == "uop_instruction_length_bytes": value = 0
            elif port.name == "uop_pc_before" or port.name == "uop_fallthrough_pc": value = 0
            elif port.name == "uop_provider_event_id": value = if uop_illegal == 1: 9 else: 7
            elif port.name == "uop_decode_event_id": value = 0
            elif port.name.ends_with("_privilege"): value = 3
            elif port.name.ends_with("_original_instruction") or port.name.ends_with("_canonical_instruction"):
                value = if port.name.starts_with("illegal_"): 0xFFFFFFFF else: 0
            elif port.name.ends_with("_provider_event_id"): value = if port.name.starts_with("illegal_"): 9 else: 7
            inputs.push(HwHostInput.bits(port.name, value))
    inputs

describe "runtime ALU and illegal completion selector":
    it "selects an ALU completion and consumes only on completion readiness":
        val module = strict_riscv_scalar_runtime_completion_selector(
            "runtime_selector_alu", CoreConfig.rv32()).unwrap()
        val held = evaluate_strict_comb_hwir(module,
            selector_inputs(module, 1, 0, 1, 0, 0)).unwrap()
        expect(held.value_of("selected_valid").unwrap()).to_equal(1)
        expect(held.value_of("uop_ready").unwrap()).to_equal(0)
        expect(held.value_of("selector_fault").unwrap()).to_equal(0)
        expect(held.value_of("selected_rd_value").unwrap()).to_equal(0x33)
        expect(held.value_of("selected_provider_event_id").unwrap()).to_equal(7)
        val accepted = evaluate_strict_comb_hwir(module,
            selector_inputs(module, 1, 0, 1, 0, 1)).unwrap()
        expect(accepted.value_of("uop_ready").unwrap()).to_equal(1)

    it "selects the exact normalized illegal-provider payload":
        val module = strict_riscv_scalar_runtime_completion_selector(
            "runtime_selector_illegal", CoreConfig.rv64()).unwrap()
        val result = evaluate_strict_comb_hwir(module,
            selector_inputs(module, 1, 1, 0, 1, 1)).unwrap()
        expect(result.value_of("selected_valid").unwrap()).to_equal(1)
        expect(result.value_of("uop_ready").unwrap()).to_equal(1)
        expect(result.value_of("selector_fault").unwrap()).to_equal(0)
        expect(result.value_of("selected_execute_trap_valid").unwrap()).to_equal(1)
        expect(result.value_of("selected_execute_trap_cause").unwrap()).to_equal(2)
        expect(result.value_of("selected_execute_trap_tval").unwrap()).to_equal(0xFFFFFFFF)
        expect(result.value_of("selected_original_instruction").unwrap()).to_equal(0xFFFFFFFF)
        expect(result.value_of("selected_illegal_valid").unwrap()).to_equal(1)
        expect(result.value_of("selected_provider_event_id").unwrap()).to_equal(9)

    it "fails closed on overlap missing ownership wrong lane or provider fault":
        val module = strict_riscv_scalar_runtime_completion_selector(
            "runtime_selector_fault", CoreConfig.rv32()).unwrap()
        val cases = [selector_inputs(module, 1, 0, 1, 1, 1),
            selector_inputs(module, 1, 0, 0, 0, 1),
            selector_inputs(module, 1, 1, 1, 0, 1),
            selector_inputs(module, 1, 0, 0, 1, 1),
            selector_inputs(module, 1, 0, 1, 0, 1, 1, 0),
            selector_inputs(module, 1, 1, 0, 1, 1, 0, 1),
            selector_inputs(module, 0, 0, 1, 0, 1)]
        for inputs in cases:
            val result = evaluate_strict_comb_hwir(module, inputs).unwrap()
            expect(result.value_of("selector_fault").unwrap()).to_equal(1)
            expect(result.value_of("selected_valid").unwrap()).to_equal(0)
            expect(result.value_of("uop_ready").unwrap()).to_equal(0)

    it "is idle without a registered uop":
        val module = strict_riscv_scalar_runtime_completion_selector(
            "runtime_selector_idle", CoreConfig.rv32()).unwrap()
        val result = evaluate_strict_comb_hwir(module,
            selector_inputs(module, 0, 0, 0, 0, 1)).unwrap()
        expect(result.value_of("selector_fault").unwrap()).to_equal(0)
        expect(result.value_of("selected_valid").unwrap()).to_equal(0)
        expect(result.value_of("uop_ready").unwrap()).to_equal(0)
