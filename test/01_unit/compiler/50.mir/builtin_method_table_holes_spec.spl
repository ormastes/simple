# @req REQ-SSPEC-COMPILER
"""
# MIR builtin method table: methods stage2 does not resolve yet (BUG-IT-10)

Measured 2026-10-10 on release/1.0 @ b68c0c65708: each method below makes
`MirLowering` emit `unresolved method call: <name>` while the rest of its
receiver family resolves (`builtin_method_table_sweep_spec.spl`). One example
per method so a fixer can move exactly the wired ones back into the sweep's
family example. Every example asserts the CORRECT behaviour (zero
diagnostics) and is expected to fail until wired.
"""

# @tag:in-development
# Tracks: BUG-IT-10, doc/08_tracking/bug/stage2_mir_builtin_method_table_holes_2026-10-10.md

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn hole_messages(src: text) -> [text]:
    val file = "testdata/fixture_builtin_holes.spl"
    val parsed = parse_full_frontend(src, file, "fixture_builtin_holes", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val _mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    messages

fn hole_expect_resolved(src: text):
    val messages = hole_messages(src)
    for m in messages:
        print "diagnostic: {m}"
    expect(messages.len()).to_equal(0)

fn text_probe(body: text) -> text:
    "fn t(s: text) -> i64:\n    " + body + "\n"

fn array_probe(body: text) -> text:
    "fn a(v: [i64]) -> i64:\n    " + body + "\n"

fn result_probe(body: text) -> text:
    "fn r(v: Result<i64, text>) -> i64:\n    " + body + "\n"

fn int_probe(body: text) -> text:
    "fn n(x: i64) -> i64:\n    " + body + "\n"

fn float_probe(body: text) -> text:
    "fn f(x: f64) -> i64:\n    " + body + "\n"

describe "MIR builtin method table holes (BUG-IT-10)":
    it "BUG-IT-10: text.repeat(n)":
        hole_expect_resolved(text_probe("s.repeat(2).len()"))

    it "BUG-IT-10: array.reversed()":
        hole_expect_resolved(array_probe("v.reversed().len()"))

    it "BUG-IT-10: array.sorted()":
        hole_expect_resolved(array_probe("v.sorted().len()"))

    it "BUG-IT-10: array.reduce(init, fn)":
        hole_expect_resolved(array_probe("v.reduce(0, \\acc, x: acc + x)"))

    it "BUG-IT-10: array.find(pred)":
        hole_expect_resolved(array_probe("v.find(\\x: x == 2) ?? -1"))

    it "BUG-IT-10: array.index_of(value)":
        hole_expect_resolved(array_probe("v.index_of(2)"))

    it "BUG-IT-10: Result.map(fn)":
        hole_expect_resolved(result_probe("if v.map(\\x: x * 2).is_ok(): 1 else: 0"))

    it "BUG-IT-10: Result.map_err(fn)":
        hole_expect_resolved(result_probe("if v.map_err(\\m: m.len()).is_err(): 1 else: 0"))

    it "BUG-IT-10: Result.ok()":
        hole_expect_resolved(result_probe("v.ok() ?? 0"))

    it "BUG-IT-10: i64.abs()":
        hole_expect_resolved(int_probe("x.abs()"))

    it "BUG-IT-10: i64.min(other)":
        hole_expect_resolved(int_probe("x.min(3)"))

    it "BUG-IT-10: i64.max(other)":
        hole_expect_resolved(int_probe("x.max(3)"))

    it "BUG-IT-10: f64.floor()":
        hole_expect_resolved(float_probe("x.floor().to_i64()"))

    it "BUG-IT-10: f64.round()":
        hole_expect_resolved(float_probe("x.round().to_i64()"))
