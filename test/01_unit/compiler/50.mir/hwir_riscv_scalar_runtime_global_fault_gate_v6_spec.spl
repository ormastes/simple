use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.host_evaluator.{HwHostInput, evaluate_strict_comb_hwir}
use compiler.mir.hwir.riscv_scalar_runtime_global_fault_gate_v6.{
    strict_riscv_scalar_runtime_global_fault_gate_v6}

describe("runtime pipeline v6 global fault gate"):
    it("aggregates each of the eleven fault owners and fails closed"):
        val module = strict_riscv_scalar_runtime_global_fault_gate_v6(
            "runtime_v6_fault_gate", CoreConfig.rv32im()).unwrap()
        val faults = ["router_fault", "decoded_uop_skid_fault", "adapter_fault",
            "selector_fault", "pending_fault", "projection_fault", "muldiv_fault",
            "lsu_fault", "fence_fault", "merge_fault", "completion_skid_fault"]
        val gated = ["input_valid", "input_ready", "completion_valid", "completion_ready",
            "bus_request_valid", "bus_response_ready", "fence_effect_valid",
            "bus_request_ready", "bus_response_valid", "fence_effect_ready"]
        for fault in faults:
            var inputs: [HwHostInput] = []
            for port in module.ports:
                if port.direction == "in":
                    val value = if port.name.starts_with("raw_") or port.name == fault: 1 else: 0
                    inputs.push(HwHostInput.bits(port.name, value))
            val result = evaluate_strict_comb_hwir(module, inputs).unwrap()
            expect(result.value_of("fault_in").unwrap()).to_equal(1)
            for output in gated:
                expect(result.value_of(output).unwrap()).to_equal(0)

    it("allows all handshakes only when all live and sticky faults are clear"):
        val module = strict_riscv_scalar_runtime_global_fault_gate_v6(
            "runtime_v6_gate_clear", CoreConfig.rv64im()).unwrap()
        val gated = ["input_valid", "input_ready", "completion_valid", "completion_ready",
            "bus_request_valid", "bus_response_ready", "fence_effect_valid",
            "bus_request_ready", "bus_response_valid", "fence_effect_ready"]
        var clear_inputs: [HwHostInput] = []
        for port in module.ports:
            if port.direction == "in":
                clear_inputs.push(HwHostInput.bits(port.name,
                    if port.name.starts_with("raw_"): 1 else: 0))
        val clear = evaluate_strict_comb_hwir(module, clear_inputs).unwrap()
        expect(clear.value_of("fault_in").unwrap()).to_equal(0)
        for output in gated:
            expect(clear.value_of(output).unwrap()).to_equal(1)

        var sticky_inputs: [HwHostInput] = []
        for port in module.ports:
            if port.direction == "in":
                sticky_inputs.push(HwHostInput.bits(port.name,
                    if port.name.starts_with("raw_") or port.name == "sticky_fault": 1 else: 0))
        val sticky = evaluate_strict_comb_hwir(module, sticky_inputs).unwrap()
        # fault_in reports newly-observed child faults; sticky fault remains terminal.
        expect(sticky.value_of("fault_in").unwrap()).to_equal(0)
        for output in gated:
            expect(sticky.value_of(output).unwrap()).to_equal(0)

    it("has deterministic identities that preserve the selected core config"):
        val gate32 = strict_riscv_scalar_runtime_global_fault_gate_v6(
            "runtime_v6_gate_id", CoreConfig.rv32im()).unwrap()
        val gate32_again = strict_riscv_scalar_runtime_global_fault_gate_v6(
            "runtime_v6_gate_id", CoreConfig.rv32im()).unwrap()
        val gate64 = strict_riscv_scalar_runtime_global_fault_gate_v6(
            "runtime_v6_gate_id", CoreConfig.rv64im()).unwrap()
        expect(gate32.shape_diagnostic()).to_equal("")
        expect(gate32.structural_sha256()).to_equal(gate32_again.structural_sha256())
        expect(gate32.structural_sha256() == gate64.structural_sha256()).to_equal(false)
