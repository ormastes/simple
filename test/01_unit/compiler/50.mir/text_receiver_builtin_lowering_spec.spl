# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: text builtins on every text receiver shape

Regression guard for `unresolved method call: substring` on the stage2 micro
fixture `test/fixtures/bootstrap/stage2_micro/micro_c` (`for w in words:
val first = w.substring(0, 1)` over an UNTYPED text array literal).

The text builtins must lower for a text receiver however the text value was
produced: a loop variable, a local, a parameter, a struct field, a call
result, an index result and a `??` result. One example per receiver shape,
each calling the methods that share the text path: substring, slice, char_at,
starts_with, find, index_of, replace, trim, split and len.
"""

# @tag: unit, compiler, mir, builtins, text

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn text_recv_messages(src: text) -> [text]:
    val file = "testdata/fixture_text_receiver.spl"
    val parsed = parse_full_frontend(src, file, "fixture_text_receiver", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val _mir = lowering.lower_module(hir)
    var messages: [text] = []
    for e in hir_lowering.errors:
        messages = messages.push("hir: " + e.message)
    for e in lowering.errors:
        if e.message.starts_with("non-exhaustive enum match on '"):
            continue
        messages = messages.push("mir: " + e.message)
    messages

fn text_recv_expect_clean(src: text):
    val messages = text_recv_messages(src)
    for m in messages:
        print "diagnostic: {m}"
    expect(messages.len()).to_equal(0)

# The ten text methods, called on the receiver expression `recv`.
fn text_recv_calls(recv: text) -> text:
    "    var n = " + recv + ".substring(0, 1).len()\n" +
    "    n = n + " + recv + ".substring(1).len()\n" +
    "    n = n + " + recv + ".slice(0, 1).len()\n" +
    "    n = n + " + recv + ".char_at(0).len()\n" +
    "    if " + recv + ".starts_with(\"a\"):\n" +
    "        n = n + 1\n" +
    "    n = n + " + recv + ".find(\"a\")\n" +
    "    n = n + " + recv + ".index_of(\"a\")\n" +
    "    n = n + " + recv + ".replace(\"a\", \"b\").len()\n" +
    "    n = n + " + recv + ".trim().len()\n" +
    "    n = n + " + recv + ".split(\",\").len()\n" +
    "    n = n + " + recv + ".len()\n"

describe "text builtins on every text receiver shape":
    it "micro_c: the loop variable of an untyped text array literal":
        text_recv_expect_clean("fn main() -> i64:\n" +
            "    val words = [\"alpha\", \"beta\", \"gamma\", \"delta\"]\n" +
            "    var counts: Dict<text, i64> = {}\n" +
            "    for w in words:\n" +
            "        val first = w.substring(0, 1)\n" +
            "        val prev = counts.get(first) ?? 0\n" +
            "        counts[first] = prev + 1\n" +
            "    val count_a = counts.get(\"a\") ?? 0\n" +
            "    count_a\n")

    it "the loop variable of an untyped text array literal, all ten methods":
        text_recv_expect_clean("fn f() -> i64:\n" +
            "    val words = [\"alpha\", \"beta\"]\n" +
            "    var total = 0\n" +
            "    for w in words:\n" +
            text_recv_calls("w").replace("\n    ", "\n        ").replace("    var n", "        var n") +
            "        total = total + n\n" +
            "    total\n")

    it "the loop variable of a declared [text] parameter":
        text_recv_expect_clean("fn f(words: [text]) -> i64:\n" +
            "    var total = 0\n" +
            "    for w in words:\n" +
            text_recv_calls("w").replace("\n    ", "\n        ").replace("    var n", "        var n") +
            "        total = total + n\n" +
            "    total\n")

    it "a text parameter":
        text_recv_expect_clean("fn f(s: text) -> i64:\n" + text_recv_calls("s") + "    n\n")

    it "an untyped local bound to a text literal":
        text_recv_expect_clean("fn f() -> i64:\n    val s = \"alpha,beta\"\n" + text_recv_calls("s") + "    n\n")

    it "an untyped local bound to another text method's result":
        text_recv_expect_clean("fn f(t: text) -> i64:\n    val s = t.trim()\n" + text_recv_calls("s") + "    n\n")

    it "a struct text field":
        text_recv_expect_clean("struct P:\n    name: text\n\nfn f(p: P) -> i64:\n" + text_recv_calls("p.name") + "    n\n")

    it "a call result":
        text_recv_expect_clean("fn make() -> text:\n    \"alpha\"\n\nfn f() -> i64:\n" + text_recv_calls("make()") + "    n\n")

    it "an index result of a declared [text]":
        text_recv_expect_clean("fn f(words: [text]) -> i64:\n" + text_recv_calls("words[0]") + "    n\n")

    it "an index result of an untyped text array literal":
        text_recv_expect_clean("fn f() -> i64:\n    val words = [\"alpha\", \"beta\"]\n" + text_recv_calls("words[0]") + "    n\n")

    it "a `??` result":
        text_recv_expect_clean("fn f(o: text?) -> i64:\n    val s = o ?? \"\"\n" + text_recv_calls("s") + "    n\n")

    it "a dict value read through `??`":
        text_recv_expect_clean("fn f(d: Dict<text, text>) -> i64:\n    val s = d.get(\"k\") ?? \"\"\n" + text_recv_calls("s") + "    n\n")
