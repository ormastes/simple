# @req REQ-SSPEC-COMPILER
"""
# Bare names that must NOT become a silent variant test

Companion of bare_variant_untyped_subject_spec (split: one file exceeds the
runner's per-file budget). Same provider + glob facade + consumer fixture.

- a KNOWN non-enum subject (`fn h(x: i64): match x: case Var:`) binds, as on
  the seed, even though `Var` is a unit variant of an unrelated enum;
- a bare name on a payload whose enum is known but does not own it
  (`op: Op`, `case Return:`) never borrows the unrelated enum's
  discriminant: it binds (a catch-all, as before) with a stderr warning.
  Warn-first: the seed rejects it, but the closure is not measured yet;
- a genuinely untyped parameter (pinned divergence: the seed binds) tests the
  variant a unique name identifies, and reports a name shared by two enums.
"""

# @tag: unit, compiler, mir, hir, enum, stage2

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*

val data_source = "pub enum Op:\n    Eq\n    Ne\n    Lt\n\npub enum Inst:\n    Bin(d: i64, op: Op)\n    Nop\n\npub enum Kind:\n    Arg(i: i64)\n    Var\n    Temp\n    Return\n\npub enum Proj:\n    Deref\n    Field(i: i64)\n    Down(i: i64)\n\npub enum Term:\n    Ret(v: i64)\n    Unreachable\n    Abort(m: i64)\n    Goto(b: i64)\n\npub struct Loc:\n    kind: Kind\n\npub struct Place:\n    projection: [Proj]\n\npub enum Cmp:\n    Eq\n    Gt\n\npub struct Fn:\n    locals: [Loc]\n    terms: [Term]\n"

val facade_source = "use lib.data.*\n\nexport use lib.data.\{Op, Cmp, Inst, Kind, Proj, Term, Loc, Place, Fn\}\n"

fn lower_facade_consumer(body: text) -> text:
    val consumer_source = "use lib.facade.*\n\n" + body
    val log = Logger(level: 0)
    val data_ast = parse_full_frontend(data_source, "lib/data.spl", "lib.data", log)
    val facade_ast = parse_full_frontend(facade_source, "lib/facade.spl", "lib.facade", log)
    val consumer_ast = parse_full_frontend(consumer_source, "app/main.spl", "app.main", log)
    var modules: Dict<text, Module> = {}
    modules["lib.data"] = data_ast
    modules["lib.facade"] = facade_ast
    val sources = [SourceFile(path: "lib/data.spl", content: data_source, module_name: "lib.data"), SourceFile(path: "lib/facade.spl", content: facade_source, module_name: "lib.facade")]
    val surfaces = module_surfaces_from_modules(modules, sources).unwrap()
    var data_lowering = hirlowering_for_module("lib.data", surfaces)
    var facade_lowering = hirlowering_for_module("lib.facade", surfaces)
    var consumer_lowering = hirlowering_for_module("app.main", surfaces)
    val data_hir = data_lowering.lower_module(data_ast)
    val facade_hir = facade_lowering.lower_module(facade_ast)
    val consumer_hir = consumer_lowering.lower_module(consumer_ast)
    var mir_lowering = MirLowering.new(consumer_hir.symbols)
    mir_lowering.prescan_module_struct_names(data_hir)
    mir_lowering.prescan_module_struct_names(facade_hir)
    mir_lowering.prescan_module_struct_names(consumer_hir)
    val mir = mir_lowering.lower_module(consumer_hir, [data_hir, facade_hir, consumer_hir])
    var out = ""
    for e in consumer_lowering.errors:
        out = out + "hir: " + e.message + "\n"
    for e in mir_lowering.errors:
        out = out + "mir: " + e.message + "\n"
    print "errors: [{out}]"
    out

describe "bare names that must NOT become a silent variant test":
    it "known non-enum subject binds: fn h(x: i64): match x: case Var:":
        # `Var` is a unit variant of the unrelated enum Kind. An i64 subject
        # can never be that variant; the seed binds (catch-all). The arm
        # body reads the binding, which only resolves if `Var` was bound.
        val all = lower_facade_consumer("fn h(x: i64) -> i64:\n    match x:\n        case Var:\n            Var + 1\n        case _:\n            0\n")
        expect(all.contains("no variant")).to_equal(false)
        expect(all.contains("enum match")).to_equal(false)
        expect(all.contains("unresolved")).to_equal(false)

    it "a variant of an unrelated enum on a known-enum payload binds, never borrows":
        # op: Op; `Return` exists only in Kind. No enum test may name
        # `Return` (that would be Kind's discriminant); HIR warns on stderr.
        val all = lower_facade_consumer("fn k2(i: Inst) -> i64:\n    match i:\n        case Bin(d, op):\n            match op:\n                case Return:\n                    1\n                case _:\n                    0\n        case Nop:\n            2\n")
        expect(all.contains("'Return'")).to_equal(false)
        expect(all.contains("ambiguous")).to_equal(false)

    it "a genuinely untyped parameter: unique variant name is a variant test":
        # Pinned divergence: the seed binds here; stage2 tests the variant
        # the name uniquely identifies (Lt is only in Op).
        val all = lower_facade_consumer("fn u(x) -> i64:\n    match x:\n        case Lt:\n            1\n        case _:\n            0\n")
        expect(all.contains("B5b")).to_equal(false)
        expect(all.contains("unreachable match arm")).to_equal(false)
        expect(all.contains("ambiguous")).to_equal(false)

    it "a genuinely untyped parameter: a name shared by two enums is reported":
        val all = lower_facade_consumer("fn u2(x) -> i64:\n    match x:\n        case Eq:\n            1\n        case _:\n            0\n")
        expect(all.contains("ambiguous")).to_equal(true)
