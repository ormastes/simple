# @req REQ-SSPEC-COMPILER
"""
# MIR lowering: `.to_i64()` on a compound receiver is a Cast, not a text parse

Bug: doc/08_tracking/bug/native_to_i64_compound_receiver_2026_10_31.md.
`arr.len().to_i64()` and `((w + 1) - 1).to_i64()` returned 0 for every non-zero
input on a producer built before 8d261cef11b: the receiver had no proof of being
numeric, so the erased-receiver arm parsed the raw integer word as text.
Each form below must lower without a text parse or a dynamic dispatch.
"""

# @tag: unit, compiler, mir, builtins

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}

fn callees_of(src: text) -> [text]:
    val file = "testdata/fixture_to_i64_compound.spl"
    val parsed = parse_full_frontend(src, file, "fixture_to_i64_compound", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(file)
    val hir = hir_lowering.lower_module(parsed)
    var lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(hir)
    var callees: [text] = []
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                callees = callees.push(name)
                            case _: pass
                    case _: pass
    callees

fn parses_text(src: text) -> bool:
    for callee in callees_of(src):
        if callee == "rt_string_to_int_lenient":
            return true
    false

describe "to_i64 on compound receivers":
    it "len of a declared array local is a cast":
        expect(parses_text("fn f() -> i64:\n    var grow: [u8] = []\n    grow.len().to_i64()\n")).to_equal(false)

    it "len of an array parameter is a cast":
        expect(parses_text("fn f(arr: [u8]) -> i64:\n    arr.len().to_i64()\n")).to_equal(false)

    it "len of a text parameter is a cast":
        expect(parses_text("fn f(passphrase: text) -> i64:\n    passphrase.len().to_i64()\n")).to_equal(false)

    it "nested arithmetic over a u64 local is a cast":
        expect(parses_text("fn f(v: i64) -> i64:\n    val w: u64 = v.to_u64()\n    ((w + 1) - 1).to_i64()\n")).to_equal(false)

describe "to_i64 on nearby receiver shapes":
    it "untyped var of a u8 call is a cast after reassignment":
        val src = "fn g(v: i64) -> u8:\n    v.to_u8()\nfn f(v: i64, c: bool) -> i64:\n    var t0 = g(v)\n    if c:\n        t0 = (v ^ 0).to_u8()\n    t0.to_i64()\n"
        expect(parses_text(src)).to_equal(false)

    it "len of a struct array field is a cast":
        val src = "struct S:\n    data: [u8]\nfn f(s: S) -> i64:\n    s.data.len().to_i64()\n"
        expect(parses_text(src)).to_equal(false)

    it "len of an untyped local from a call is a cast":
        val src = "fn g() -> [u8]:\n    []\nfn f() -> i64:\n    val a = g()\n    a.len().to_i64()\n"
        expect(parses_text(src)).to_equal(false)

    it "len of an array element is a cast":
        val src = "fn f(rows: [[u8]]) -> i64:\n    rows[0].len().to_i64()\n"
        expect(parses_text(src)).to_equal(false)

    it "len of a method result is a cast":
        val src = "struct S:\n    data: [u8]\nimpl S:\n    fn bytes() -> [u8]:\n        self.data\nfn f(s: S) -> i64:\n    s.bytes().len().to_i64()\n"
        expect(parses_text(src)).to_equal(false)

    it "len of a self field is a cast":
        val src = "struct S:\n    data: [u8]\nimpl S:\n    fn n() -> i64:\n        self.data.len().to_i64()\n"
        expect(parses_text(src)).to_equal(false)

    it "erased Any receiver keeps the text parse":
        expect(parses_text("fn f(v: Any) -> i64:\n    v.to_i64()\n")).to_equal(true)

    it "text local keeps the text parse":
        expect(parses_text("fn f(s: text) -> i64:\n    s.to_i64()\n")).to_equal(true)
