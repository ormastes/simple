#!/bin/sh
set -eu

root=${1:-.}
view="$root/src/lib/common/io/read_only_file_view.spl"
pinned="$root/src/compiler/80.driver/cache/pinned_archive_capability.spl"
section="$root/src/compiler/80.driver/smf/package_section_reader_v1.spl"
hal="$root/src/os/hal/read_only_file_map_port.spl"
sosix="$root/src/os/sosix/read_only_file_map.spl"
policy_spec="$root/test/01_unit/os/read_only_file_view_map_policy_integration_spec.spl"

grep -q 'read_only_file_view_adopt_descriptor_v1' "$view"
grep -q 'FileReadPolicyV1.auto_map' "$pinned"
grep -q 'read_only_file_view_read_v1' "$pinned"
grep -q 'pinned_archive_read_member_v1' "$section"

if grep -q 'rt_pinned_archive_pread_exact_v1' "$pinned"; then
    echo 'direct archive pread remains in demand hot path' >&2
    exit 1
fi

grep -q 'file_read_policy_allows_fallback_v1' "$view"
grep -q 'file_view_buffered_read_v1' "$view"
grep -q 'cancellation.is_cancelled()' "$view"
grep -q 'file_view_identity_equal_v1' "$view"
grep -q 'ReadOnlyFileMapPortV1' "$hal"
grep -q 'impl ReadOnlyFileMapPortV1 for SosixReadOnlyFileMapPortV1' "$sosix"
grep -q 'FileReadPolicyV1.prefer_map' "$policy_spec"
grep -q 'ReadOnlyFileMapErrorKind.Unsupported' "$policy_spec"
grep -q 'FileReadPolicyV1.must_map' "$policy_spec"

echo 'READ_ONLY_FILE_VIEW_INTEGRATION_STATIC_PASS'
