#!/bin/sh
set -eu

source_file=src/compiler/80.driver/smf/runtime_std_package_set.spl

test -f "$source_file"
grep -q 'RUNTIME_PACKAGE_IDENTITY_V1: text = "simple.runtime"' "$source_file"
grep -q 'STD_PACKAGE_IDENTITY_V1: text = "simple.std"' "$source_file"
grep -q 'compiler_digest: text' "$source_file"
grep -q 'action_abi_digest: text' "$source_file"
grep -q 'runtime_abi_digest: text' "$source_file"
grep -q 'std_abi_digest: text' "$source_file"
grep -q 'config_digest: text' "$source_file"
grep -q 'package_image_validate_v1(image, receipt)' "$source_file"
grep -q 'runtime_std_publish_set_v1' "$source_file"
grep -q 'build_action_result_validate_v1' "$source_file"
grep -q 'runtime-std-action-result-invalid' "$source_file"
grep -q 'cas_batch_publish_v1(transaction)' "$source_file"
grep -q 'receipt!.members.len() != 10' "$source_file"
grep -q 'runtime-std-rebuild-required' "$source_file"
grep -q 'runtime-std-authority-invalid' "$source_file"

driver=src/compiler/80.driver/driver_source_pipeline_loading.spl
grep -q 'runtime_std_load_baseline_v1' "$driver"
grep -q 'runtime/std SMF baseline authority mismatch' "$driver"
grep -q 'SIMPLE_ACTION_ABI_DIGEST' "$driver"

printf '%s\n' RUNTIME_STD_PACKAGE_SET_STATIC_PASS
