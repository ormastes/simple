# RB-DIAG-01 fixture: SPL-PAT-001 (Some/None pattern on a non-Option subject).
enum Color:
    Red
    Green

fn main():
    match 5:
        case Some(_): print "SOME_INT"
        case _: print "OTHER_INT"
    match Color.Red:
        case Some(_): print "SOME_ENUM"
        case _: print "OTHER_ENUM"
