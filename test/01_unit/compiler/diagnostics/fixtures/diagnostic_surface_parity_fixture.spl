# RB-DIAG-01 fixture: one policy-bound violation per public signature.
# diagnostic_surface_parity_spec prepends @deny/@warn/@allow(primitive_api).
pub fn scale_reading(raw: i64) -> Reading:
    Reading(value: raw)

pub fn toggle_feature(enabled: bool) -> Feature:
    Feature(on: enabled)

fn private_helper(count: i64) -> Reading:
    Reading(value: count)
