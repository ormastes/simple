# @cover src/compiler/00.common/diagnostics/span.spl
# # Span Merge / Length Specification
#
# `Span.merge` previously delegated to `Span.new`, which dropped `file` (to "")
# and hardcoded `length: 0`. Both fields are load-bearing:
#
#   - `dim_constraints.spl` merges spans for DimError sites (6 call sites), so a
#     dropped file made those diagnostics point at no source file at all.
#   - `error_formatter.spl:409` sizes the caret underline from `span.length`
#     (`if span.length > 0: span.length else: 1`), so a hardcoded 0 collapsed
#     every underline to a single character.
#
# Cross-file merge policy: `self.file` wins. Merging spans from two files is a
# caller bug; preserving self keeps the diagnostic anchored somewhere real.

use std.spec
use compiler.common.diagnostics.span.{Span}

describe "Span merge and length":

    it "merge preserves the source file of the receiver":
        val a = Span(start: 10, end: 20, line: 1, col: 5, file: "a.spl", length: 10)
        val b = Span(start: 25, end: 35, line: 1, col: 11, file: "a.spl", length: 10)
        expect(a.merge(b).file).to_equal("a.spl")

    it "merge computes length as end - start":
        val a = Span(start: 10, end: 20, line: 1, col: 5, file: "a.spl", length: 10)
        val b = Span(start: 25, end: 35, line: 1, col: 11, file: "a.spl", length: 10)
        expect(a.merge(b).length).to_equal(25)

    it "merge spans earliest start to latest end":
        val a = Span(start: 30, end: 40, line: 3, col: 1, file: "a.spl", length: 10)
        val b = Span(start: 5, end: 12, line: 1, col: 2, file: "a.spl", length: 7)
        val m = a.merge(b)
        expect(m.start).to_equal(5)
        expect(m.end).to_equal(40)
        expect(m.line).to_equal(1)

    it "merge keeps self.file on a cross-file merge":
        val a = Span(start: 0, end: 4, line: 1, col: 1, file: "self.spl", length: 4)
        val b = Span(start: 8, end: 9, line: 1, col: 9, file: "other.spl", length: 1)
        expect(a.merge(b).file).to_equal("self.spl")

    it "Span.new records length so the caret underline is sized":
        expect(Span.new(10, 24, 1, 5).length).to_equal(14)

    it "to() records length across the combined range":
        val a = Span(start: 10, end: 20, line: 1, col: 5, file: "a.spl", length: 10)
        val b = Span(start: 25, end: 35, line: 1, col: 11, file: "a.spl", length: 10)
        expect(a.to(b).length).to_equal(25)

    it "zero-length constructors stay zero-length":
        expect(Span.at(7, 1, 1).length).to_equal(0)
        expect(Span.empty().length).to_equal(0)
