use std.spec.*
use compiler.common.build_contract.{
    BuildInputRef, BuildDependencyRef, BuildEnvInput, BuildResolutionProbe,
    SnapshotManifest, ToolchainManifest, InputManifest, ActionSpec,
    validate_input_manifest_v1, validate_action_spec_v1,
    input_manifest_digest_v1, action_spec_digest_v1}

fn sample_inputs() -> InputManifest:
    InputManifest(
        version: 1, snapshot_digest: "snapshot-a",
        source_inputs: [BuildInputRef(logical_path: "src/main.spl", content_digest: "source-a")],
        generated_inputs: [],
        declared_dependency_actions: ["dep-a"],
        dependency_outputs: [BuildDependencyRef(
            action_digest: "dep-a", output_path: "build/lib.smf", content_digest: "object-a")],
        env_inputs: [BuildEnvInput(name: "LANG", value_digest: "lang-a")],
        resolution_probes: [
            BuildResolutionProbe(path: "src/first.spl", found: false,
                content_digest: "", context_digest: "resolver-a"),
            BuildResolutionProbe(path: "src/second.spl", found: true,
                content_digest: "second-a", context_digest: "resolver-a")],
        context_digest: "context-a", discovery_complete: true,
        has_untracked_reads: false)

fn sample_action() -> ActionSpec:
    ActionSpec(
        version: 1, kind: "simple-compile",
        snapshot: SnapshotManifest(version: 1, snapshot_digest: "snapshot-a",
            source_tree_digest: "tree-a", submodule_closure_digest: "submodules-a"),
        toolchain: ToolchainManifest(version: 1, executable_digest: "exe-a",
            behavior_digest: "behavior-a", provider_abi_digest: "abi-a",
            runtime_digest: "runtime-a", sysroot_digest: "sysroot-a",
            target_triple: "aarch64-apple-darwin"),
        inputs: sample_inputs(), argv: ["simple", "build", "--opt=2"],
        working_directory: "src", sandbox_digest: "sandbox-a",
        output_paths: ["build/main.smf"], resource_policy_digest: "policy-a")

describe "build contract v1 completeness and identity":
    it "accepts a complete action and yields stable identities":
        val action = sample_action()
        expect(validate_input_manifest_v1(action.inputs)).to_equal("ok")
        expect(validate_action_spec_v1(action)).to_equal("ok")
        expect(input_manifest_digest_v1(action.inputs) != "").to_equal(true)
        expect(action_spec_digest_v1(action)).to_equal(action_spec_digest_v1(sample_action()))

    it "rejects incomplete context and untracked reads":
        var inputs = sample_inputs()
        inputs.context_digest = ""
        expect(validate_input_manifest_v1(inputs)).to_equal("context-incomplete")
        expect(input_manifest_digest_v1(inputs)).to_equal("")
        inputs = sample_inputs()
        inputs.discovery_complete = false
        expect(validate_input_manifest_v1(inputs)).to_equal("discovery-incomplete")
        inputs = sample_inputs()
        inputs.has_untracked_reads = true
        expect(validate_input_manifest_v1(inputs)).to_equal("discovery-incomplete")

    it "rejects incomplete declared dependencies":
        var inputs = sample_inputs()
        inputs.dependency_outputs = []
        expect(validate_input_manifest_v1(inputs)).to_equal("dependency-incomplete")
        var action = sample_action()
        action.inputs = inputs
        expect(action_spec_digest_v1(action)).to_equal("")

    it "keeps ordered arguments and probes in semantic identity":
        val original = action_spec_digest_v1(sample_action())
        var action = sample_action()
        action.argv = ["simple", "--opt=2", "build"]
        expect(action_spec_digest_v1(action) == original).to_equal(false)
        action = sample_action()
        action.inputs.resolution_probes = [
            BuildResolutionProbe(path: "src/second.spl", found: true,
                content_digest: "second-a", context_digest: "resolver-a"),
            BuildResolutionProbe(path: "src/first.spl", found: false,
                content_digest: "", context_digest: "resolver-a")]
        expect(action_spec_digest_v1(action) == original).to_equal(false)

    it "changes identity with tool behavior and semantic context":
        val original = action_spec_digest_v1(sample_action())
        var action = sample_action()
        action.toolchain.behavior_digest = "behavior-b"
        expect(action_spec_digest_v1(action) == original).to_equal(false)
        action = sample_action()
        action.inputs.context_digest = "context-b"
        expect(action_spec_digest_v1(action) == original).to_equal(false)
        action = sample_action()
        action.inputs.env_inputs = [BuildEnvInput(name: "LANG", value_digest: "lang-b")]
        expect(action_spec_digest_v1(action) == original).to_equal(false)

    it "treats declared input sets as order independent":
        var action = sample_action()
        action.inputs.source_inputs = [
            BuildInputRef(logical_path: "src/main.spl", content_digest: "source-a"),
            BuildInputRef(logical_path: "src/lib.spl", content_digest: "source-b")]
        val original = action_spec_digest_v1(action)
        action.inputs.source_inputs = [
            BuildInputRef(logical_path: "src/lib.spl", content_digest: "source-b"),
            BuildInputRef(logical_path: "src/main.spl", content_digest: "source-a")]
        expect(action_spec_digest_v1(action)).to_equal(original)

    it "records absent candidates and their context in identity":
        val original = action_spec_digest_v1(sample_action())
        var action = sample_action()
        action.inputs.resolution_probes[0].context_digest = "resolver-b"
        expect(action_spec_digest_v1(action) == original).to_equal(false)
        action = sample_action()
        action.inputs.resolution_probes = [BuildResolutionProbe(
            path: "src/second.spl", found: true,
            content_digest: "second-a", context_digest: "resolver-a")]
        expect(action_spec_digest_v1(action) == original).to_equal(false)

    it "rejects missing provider identity and malformed resolution witnesses":
        var action = sample_action()
        action.toolchain.provider_abi_digest = ""
        expect(validate_action_spec_v1(action)).to_equal("toolchain-incomplete")
        action = sample_action()
        action.inputs.resolution_probes = [BuildResolutionProbe(
            path: "src/absent.spl", found: false, content_digest: "unexpected",
            context_digest: "resolver-a")]
        expect(validate_action_spec_v1(action)).to_equal("resolution-invalid")

    it "rejects a mismatched snapshot and duplicate output paths":
        var action = sample_action()
        action.inputs.snapshot_digest = "snapshot-b"
        expect(validate_action_spec_v1(action)).to_equal("snapshot-mismatch")
        action = sample_action()
        action.output_paths = ["build/main.smf", "build/main.smf"]
        expect(validate_action_spec_v1(action)).to_equal("output-invalid")
