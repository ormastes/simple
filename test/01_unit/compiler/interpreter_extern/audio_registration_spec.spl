# @req REQ-SSPEC-COMPILER
"""
# rt_audio_* Interpreter Registration (source-list-absent bucket)

## Overview

`rt_audio_*` (31 symbols, census bucket (a) "source-list-absent") is declared
as `extern fn` throughout `src/lib` and `src/app`, and is implemented once,
in C, at `src/runtime/runtime_audio.c` -- a real miniaudio-backed engine, not
a capability stub. Before this fix the interpreter had no entry for the
family at all, so every call died with the generic
`unknown extern function: rt_audio_init`, indistinguishable from "no audio
support".

Unlike the `rt_opengl_*`/`rt_oneapi_*` lane, `runtime_audio.c` was missing
from **both** C-source lists that gate linkage:

- the native-product-build list (`sources` array at
  `src/compiler/70.backend/backend/runtime_compiler.spl`), and
- the C sources `src/compiler_rust/runtime/build.rs` compiles into this
  crate's own staticlib/cdylib.

Both were fixed by adding `runtime_audio.c` to each list; no duplicate-symbol
risk exists (confirmed before landing: no other C or Rust source in this
crate defines any `rt_audio_*` name, so the whole file could be linked
directly, unlike `runtime_native.c`'s partial-extraction precedent).

`rt_audio_*` is not uniformly `int64_t`-in/`int64_t`-out like
`rt_opengl_*`/`rt_oneapi_*`: it mixes `int64_t` handles, `double`
(volume/position/distance), `const char*` (paths, the backend name), and one
`SplArray*`-taking entry point (`rt_audio_play_pcm_f32`), which is refused
cleanly rather than risking a bad transmute (same precedent as
`rt_sdl2_present_rgba`/`rt_glfw_present_argb`).

This spec proves the error TEXT changed (the resolution oracle -- exit status
alone is fail-open), not merely that the process exits non-zero.

## Related Specifications

- doc/08_tracking/bug/interpreter_extern_unreachable_names.md — bucket (a)
- doc/03_plan/runtime/native_binding/interpreter_extern_registration_lanes.md
- test/01_unit/compiler/interpreter_extern/opengl_registration_spec.spl — sibling lane, same probe pattern
"""

# @tag: unit, compiler, interpreter-extern, audio, source-list-absent

use std.spec.step

use std.spec.*
use std.io_runtime.{process_run, env_get}

fn contract_binary() -> text:
    val override = env_get("SIMPLE_TEST_BINARY")
    if override != "" and override != nil:
        return override
    "bin/simple"

fn contract_binary_uses_runner_authority() -> bool:
    val configured = env_get("SIMPLE_TEST_BINARY")
    configured != "" and configured != nil and contract_binary() == configured

# On Windows the test runner exports SIMPLE_TEST_BINARY as a `\\?\`-prefixed
# extended-length path (e.g. `\\?\D:\wk-comp2\bin\simple.exe`). That prefix
# is a Win32-API-only spelling of the same path (see the mirrored helper
# `_strip_extended_length_prefix` in
# src/lib/nogc_sync_mut/storage_roots/resolver.spl) -- MSYS `sh` cannot
# resolve it as a command and fails with "No such file or directory". Strip
# it ONLY for the shelled-out probe command; contract_binary() itself keeps
# returning the raw override so the runner-authority equality check above
# stays exact.
fn _shell_safe_binary(binary: text) -> text:
    val slashed = binary.replace("\\", "/")
    if slashed.starts_with("//?/"):
        return slashed.substring(4)
    binary

fn run_probe(binary: text, fixture: text) -> (text, text, i64):
    # NOTE: plain `"..."` text literals in Simple do not interpolate `{name}`
    # placeholders -- concatenate explicitly, or the shell receives the
    # literal 4-character string `{binary}` as its argv[0] and every probe
    # fails identically with a shell "not found" error rather than the
    # `unknown extern function`/`unknown rt_audio_` text this spec asserts on.
    val cmd = "SIMPLE_BOOTSTRAP=1 SIMPLE_EXECUTION_MODE=interpret '" + _shell_safe_binary(binary) + "' run '" + fixture + "'"
    # Use a bare "sh" (PATH-resolved) rather than the absolute POSIX path
    # "/bin/sh": process_run -> host_path_native rewrites an absolute path
    # that doesn't match the mingw drive-letter grammar (`/d/...`) into a
    # bogus backslash path (`/bin/sh` -> `\bin\sh`, relative to the current
    # drive) on a Windows host, so the child process never spawns (empty
    # stdout/stderr, exit code -1). A bare command name is resolved through
    # PATH (Git-for-Windows' usr/bin) unmangled on every platform.
    process_run("sh", ["-c", cmd])

# Self-heals onto the bootstrap seed if the deployed binary predates this
# lane (extern-arm additions require a rebuild to take effect).
fn run_probe_child(fixture: text) -> (text, text, i64):
    val (out, err, code) = run_probe(contract_binary(), fixture)
    if out.contains("audio_backend_name_result") or out.contains("unexpected success") or err.contains("unknown rt_audio_") or err.contains("unknown extern function"):
        return (out, err, code)
    val (probe, _pe, _pc) = process_run("sh",
        ["-c", "test -x src/compiler_rust/target/release/simple && echo yes || echo no"])
    if probe.contains("yes"):
        return run_probe("src/compiler_rust/target/release/simple", fixture)
    val (probe2, _pe2, _pc2) = process_run("sh",
        ["-c", "test -x src/compiler_rust/target/debug/simple && echo yes || echo no"])
    if probe2.contains("yes"):
        return run_probe("src/compiler_rust/target/debug/simple", fixture)
    (out, err, code)

describe "rt_audio_* interpreter registration":
    # @manual scenario evidence

    it "rt_audio_backend_name: resolves through to the linked C implementation instead of failing to resolve":
        # @req REQ-SSPEC-COMPILER
        step("rt_audio_backend_name: resolves through to the linked C implementation instead of failing to resolve")
        step("Run the audio backend-name probe fixture under the interpreter")
        val (out, err, _code) = run_probe_child("test/fixture/interpreter_extern/audio_backend_name_probe.spl")
        assert_true(out.contains("audio_backend_name_result="))
        assert_equal(err.contains("unknown extern function"), false)

    it "rt_audio_zzz_bogus: a prefix name with no C definition gets the family guard, not a crash":
        # @req REQ-SSPEC-COMPILER
        step("rt_audio_zzz_bogus: a prefix name with no C definition gets the family guard, not a crash")
        step("Run the audio bogus-name probe fixture under the interpreter")
        val (_out, err, _code) = run_probe_child("test/fixture/interpreter_extern/audio_bogus_probe.spl")
        assert_true(err.contains("unknown rt_audio_"))

    it "rt_audio_zzz_bogus: guard text is distinct from the generic unknown-extern text":
        # @req REQ-SSPEC-COMPILER
        step("rt_audio_zzz_bogus: guard text is distinct from the generic unknown-extern text")
        val (_out, err, _code) = run_probe_child("test/fixture/interpreter_extern/audio_bogus_probe.spl")
        assert_equal(err.contains("unknown extern function"), false)

    it "rt_audio_play_pcm_f32: the one array-taking entry point is refused cleanly, not transmuted":
        # @req REQ-SSPEC-COMPILER
        step("rt_audio_play_pcm_f32: the one array-taking entry point is refused cleanly, not transmuted")
        step("Run the audio play_pcm_f32 probe fixture under the interpreter")
        val (_out, err, _code) = run_probe_child("test/fixture/interpreter_extern/audio_play_pcm_f32_probe.spl")
        assert_true(err.contains("natively-linked"))
        assert_equal(err.contains("unknown extern function"), false)
    it "inherits the test runner's admitted child binary authority":
        step("inherits the test runner's admitted child binary authority")
        assert_true(contract_binary_uses_runner_authority())
