# @req REQ-INTERP-EXTERN-FILE-CHAR-DEVICE-001
describe "rt_file_is_char_device seed/JIT registration":
    it "links the no-shell device probe through the seed satellite runtime":
        val satellite = rt_file_read_text("src/runtime/runtime_native_gpu_stub.c") ?? ""
        val build = rt_file_read_text("src/compiler_rust/runtime/build.rs") ?? ""
        val static_table_start = build.find("const LINKED_C_SOURCES")
        val static_table = if static_table_start >= 0: build.substring(static_table_start) else: ""
        expect(satellite).to_contain("int rt_file_is_char_device(const char* path)")
        expect(satellite).to_contain("stat(path, &st) == 0 && S_ISCHR(st.st_mode)")
        expect(build).to_contain("\"runtime_native_gpu_stub.c\"")
        expect(static_table).to_contain("\"runtime_native_gpu_stub.c\"")
