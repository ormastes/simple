# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




# @req REQ-SSPEC-COMPILER
# Updated 2026-08-17: this spec previously asserted the OLD design — a verbatim
# C copy of rt_file_is_char_device inside runtime_native_gpu_stub.c with a
# `const char* path` signature. That copy was a real defect (duplicate symbol
# with an incompatible one-arg ABI that silently won under -z muldefs and
# misreported /dev/zero); it was deliberately removed per
# doc/08_tracking/bug/rt_file_is_char_device_dejit_and_dual_abi_2026-08-10.md.
# The spec now asserts the CURRENT design: canonical (ptr, len) ABI in the C
# runtime, the Rust runtime as the seed/JIT provider, the gpu stub explicitly
# forbidding re-adding a C copy, and the interpreter extern-table registration.
use std.spec.step

describe "rt_file_is_char_device seed/JIT registration":
    # @manual scenario evidence
    it "keeps the canonical (ptr, len) ABI with no stale C copy in the gpu stub":
        # @req REQ-SSPEC-COMPILER
        step("keeps the canonical (ptr, len) ABI with no stale C copy in the gpu stub")
        val stub = rt_file_read_text("src/runtime/runtime_native_gpu_stub.c") ?? ""
        val runtime_c = rt_file_read_text("src/runtime/runtime.c") ?? ""
        val mod_rs = rt_file_read_text("src/compiler_rust/compiler/src/interpreter_extern/mod.rs") ?? ""
        # The gpu stub must document the removal and must NOT define the symbol.
        expect(stub).to_contain("do not")
        expect(stub).to_contain("re-add a C copy")
        assert_false(stub.contains("int rt_file_is_char_device(const char* path)"))
        # The canonical C runtime definition uses the two-argument (ptr, len) ABI.
        expect(runtime_c).to_contain("int rt_file_is_char_device(const uint8_t* path_ptr, uint64_t path_len)")
        expect(runtime_c).to_contain("S_ISCHR(st.st_mode)")
        # The interpreter extern table registers the name.
        expect(mod_rs).to_contain("\"rt_file_is_char_device\"")
