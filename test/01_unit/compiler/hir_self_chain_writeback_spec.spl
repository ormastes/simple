"""
Regression spec — a two-hop method chain rooted at `self` must not write its
result back into `self`.

Defect (2026-09-01, MCP native build, HIR entry, step 2/6 module 0):

    src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl:347
        val already_bound = self.symbols.lookup_or_invalid(local_name).is_valid()
    src/.../module_import_registration.spl:348
        val imported_type = self.symbols.define(...)      # <-- FATAL

    error: semantic: undefined field 'symbols':
           cannot access field on value of type 'bool'
    [field-access-error] field=symbols recv_type=bool recv=false
           expr=Identifier("self")
           stack=... -> register_imported_symbol -> register_imported_symbol_inner

The trailing `.is_valid()` bool was written back through the chain into the
root receiver `self`, so the very next `self.symbols` read saw a bool. Line
347 was pinned by probe instrumentation: its probe fired exactly once and the
fatal followed immediately; the single-hop siblings on lines 238/449 ran 33
and 541 times with no failure. Fix: bind the intermediate to a typed `val`.

Record: doc/08_tracking/bug/mcp_native_build_hir_entry_env_get_nil_len_fatal_2026-09-01.md

NOTE ON SCOPE: the underlying interpreter defect IS reproducible at unit
scale — see test/01_unit/compiler/self_receiver_chain_member_access_spec.spl
(@tag:in-development) and
doc/08_tracking/bug/self_rooted_chain_val_binding_clobbers_receiver_2026-09-01.md.
The trigger is binding a >=2-call self-rooted chain to a `val`. THIS file
pins the applied workaround: the split form must keep working, and the
two-hop shapes used elsewhere in the same method must stay safe.
"""

use std.spec.{describe, it, expect}

class Inner:
    var table: {text: i64} = {}

    me lookup(k: text) -> i64:
        if self.table.contains_key(k):
            return self.table[k]
        -1

class Outer:
    var syms: Inner = Inner()
    var tag: text = "outer"

    me probe_two_hop(k: text) -> bool:
        # The exact production shape: self.<field>.<call>(...).<call>()
        val already = self.syms.lookup(k) >= 0
        # Reading `self` again immediately after the chain is what blew up.
        val still_ok = self.tag == "outer"
        return already and still_ok

    me probe_split(k: text) -> bool:
        val found = self.syms.lookup(k)
        val already = found >= 0
        val still_ok = self.tag == "outer"
        return already and still_ok

describe "self-rooted method chains do not clobber the receiver":

    it "chained call followed by a field read on self keeps self intact":
        var o = Outer()
        o.syms.table["a"] = 1
        expect(o.probe_two_hop("a")).to_equal(true)

    it "the split form (the applied fix) behaves identically":
        var o = Outer()
        o.syms.table["a"] = 1
        expect(o.probe_split("a")).to_equal(true)

    it "the miss path also leaves self readable":
        var o = Outer()
        expect(o.probe_two_hop("absent")).to_equal(false)
        expect(o.tag).to_equal("outer")

    it "repeated chains in one frame keep self readable throughout":
        var o = Outer()
        o.syms.table["a"] = 1
        var round = 0
        while round < 5:
            expect(o.probe_two_hop("a")).to_equal(true)
            round = round + 1
        expect(o.tag).to_equal("outer")
