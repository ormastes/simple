# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# A `var` local named like an imported module namespace / builtin (`input`) must
# survive reassignment inside an `it` block and shadow the module/builtin.

use std.spec.step

use std.spec.*
use std.nogc_async_mut.tui.widgets.input.{make_input_widget_with_value}
use std.nogc_async_mut.tui.style.{tui_default_style}

describe "locals shadow builtins and module namespaces":
    it "reassigned var named input keeps its value":
        # @req REQ-SSPEC-COMPILER
        step("reassigned var named input keeps its value")
        val style = tui_default_style()
        var input = make_input_widget_with_value("> ", "ab", style)
        input = make_input_widget_with_value("> ", "cd", style)
        expect(input.value).to_equal("cd")
