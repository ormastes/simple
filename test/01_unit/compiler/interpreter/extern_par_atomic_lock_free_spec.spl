# Interpreter dispatch for the raw-cell lock-free query and SeqCst load.

use std.nogc_sync_mut.ptr.raw.{rt_alloc, rt_free, rt_ptr_write_i64}

extern fn rt_par_atomic_i64_is_lock_free(addr: i64) -> i64
extern fn rt_par_atomic_load_i64(addr: i64) -> i64

describe "rt_par_atomic_i64 interpreter externs":
    it "reports an aligned live cell as lock-free and loads it":
        val cell = rt_alloc(16)
        rt_ptr_write_i64(cell, 0, 77)
        expect(rt_par_atomic_i64_is_lock_free(cell)).to_equal(1)
        expect(rt_par_atomic_load_i64(cell)).to_equal(77)
        rt_free(cell)

    it "reports null as not lock-free":
        expect(rt_par_atomic_i64_is_lock_free(0)).to_equal(0)
