# @req REQ-SSPEC-COMPILER
"""
Pin for bug duplicate_type_name_collision_audit_2026-07-17 (class A): an enum
and a struct sharing a bare type name in two co-loaded modules must each
resolve to their own declaring module, in either load order.
"""
use std.spec.step
use std.spec.*
use test.fixtures.flat_fn_shadow.shade_enum.{shade_enum_depth}
use test.fixtures.flat_fn_shadow.shade_struct.{shade_struct_depth}

describe "enum vs struct same-name collision across co-loaded modules":
    it "enum module matches its own Shade variants":
        step("call enum module after struct module was co-loaded")
        expect(shade_enum_depth()).to_equal(4)
    it "struct module constructs its own Shade":
        expect(shade_struct_depth()).to_equal(9)
    it "both resolve in one expression":
        expect(shade_enum_depth() + shade_struct_depth()).to_equal(13)
