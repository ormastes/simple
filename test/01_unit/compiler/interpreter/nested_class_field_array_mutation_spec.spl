# Nested class-field array mutation from a `me` method of an outer class.
# self.store.items.push(x) / self.store.items[i] = x must persist.

class Store:
    items: [i64]
    n: i64

class Outer:
    store: Store

    me add(x: i64):
        self.store.items.push(x)

    me set0(x: i64):
        self.store.items[0] = x

    me bump():
        self.store.n = self.store.n + 1

describe "nested class-field array mutation":
    it "push through nested field persists":
        val o = Outer(store: Store(items: [], n: 0))
        o.add(1)
        o.add(2)
        expect(o.store.items.len()).to_equal(2)

    it "index assign through nested field persists":
        val o = Outer(store: Store(items: [1, 2], n: 0))
        o.set0(9)
        expect(o.store.items[0]).to_equal(9)

    it "nested scalar write persists":
        val o = Outer(store: Store(items: [], n: 0))
        o.bump()
        expect(o.store.n).to_equal(1)
