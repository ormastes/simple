# Run-path probe (Dict.get -> Option presence via .? and ?? in value position) for class_ref_interp_jit_consistency_spec.spl.
fn main():
    val dt = {"a": "hello"}
    val di = {"a": 5, "three": 3}
    print "t_hit={dt.get("a") ?? "none"}"
    print "t_miss={dt.get("zz") ?? "none"}"
    print "i_hit={di.get("a") ?? -1}"
    print "i_three={di.get("three") ?? -1}"
    print "i_miss={di.get("zz") ?? -1}"
    val q = di.get("zz").?
    print "q_miss_is_nil={q == nil}"
    print "tail=ok"
main()
