# @req REQ-SSPEC-COMPILER
"""
Cross-module same-name function / class resolution: a module's own calls and an
importer's calls must each reach the definition that module actually owns, even
when another transitively co-loaded module defines the same name with the SAME
signature (bug rows interp_flat_fn_table_load_config_shadowed_2026-11-03 and
interp_class_name_collision_breaks_test_db_persistence_2026-08-10).
"""
use std.spec.step
use std.spec.*
use test.fixtures.flat_fn_shadow.mod_a.{load_config}
use test.fixtures.flat_fn_shadow.mod_c.{c_val}
use test.fixtures.flat_fn_shadow.cls_b.{tag_b}

describe "cross-module name collision resolution":
    it "same-signature fn: importer reaches its own module's definition":
        step("call imported load_config")
        expect(load_config("x")).to_equal("A:x")
    it "same-signature fn: transitive module keeps its own definition":
        step("call through mod_c -> mod_b")
        expect(c_val()).to_equal("B:y")
    it "same-name class: other module's instance dispatches its own method":
        step("call cls_b helper that builds its own Interner")
        expect(tag_b()).to_equal("B!")
