# Assigning an array local to a class/struct field must copy (value semantics)
# under both the seed JIT (`simple run`) and the interpreter (`simple test`).
# Bug: doc/08_tracking/bug/seed_jit_class_field_array_assign_aliases_local_2026-11-04.md
use std.spec.*

class HoldU8:
    buf: [u8]
    me poke():
        self.buf[0] = 9u8

class HoldI64:
    buf: [i64]

class HoldF64:
    buf: [f64]

struct SHold:
    buf: [i64]

describe "field array assign value semantics":
    it "[u8] field write does not reach the local":
        var a: [u8] = [1u8, 2u8]
        var h = HoldU8(buf: [])
        h.buf = a
        h.poke()
        expect(a[0]).to_equal(1u8)
        expect(h.buf[0]).to_equal(9u8)
    it "[u8] local write does not reach the field":
        var a: [u8] = [1u8, 2u8]
        var h = HoldU8(buf: [])
        h.buf = a
        a[1] = 7u8
        expect(h.buf[1]).to_equal(2u8)
    it "[i64] both directions":
        var a: [i64] = [1, 2]
        var h = HoldI64(buf: [])
        h.buf = a
        h.buf[0] = 9
        a[1] = 5
        expect(a[0]).to_equal(1)
        expect(h.buf[1]).to_equal(2)
    it "[f64] both directions":
        var a: [f64] = [1.5, 2.5]
        var h = HoldF64(buf: [])
        h.buf = a
        h.buf[0] = 9.5
        a[1] = 5.5
        expect(a[0]).to_equal(1.5)
        expect(h.buf[1]).to_equal(2.5)
    it "struct field both directions":
        var a: [i64] = [1, 2]
        var s = SHold(buf: [0, 0])
        s.buf = a
        s.buf[0] = 9
        a[1] = 5
        expect(a[0]).to_equal(1)
        expect(s.buf[1]).to_equal(2)
