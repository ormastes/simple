# Probe: `for e in List<T>` must visit every element in BOTH engines.
use std.common.core.collections.List

struct ProbeEntry:
    v: i64

fn main():
    var xs = List<ProbeEntry>(items: [])
    xs.push(ProbeEntry(v: 1))
    xs.push(ProbeEntry(v: 2))
    xs.push(ProbeEntry(v: 4))
    var total = 0
    for e in xs:
        total = total + e.v
    print "FOR_LIST_SUM={total}"
    val empty = List<ProbeEntry>(items: [])
    var visits = 0
    for e in empty:
        visits = visits + 1
    print "FOR_LIST_EMPTY={visits}"
main()
