# Reproduce specs for two interpreter builtin defects.
#
# 1. `range(start, end, step)` read its third argument as an inclusive-bound
#    flag instead of a step, so `range(0, 10, 2)` yielded 0..9 and
#    `range(5, 0, -1)` yielded nothing.
#    See doc/08_tracking/bug/range_builtin_missing_step_argument_2026-07-20.md
# 2. SI prefixes `k` and `m` were dropped on unit literals (`M` worked),
#    because a preloaded on-disk `km`/`ms` entry short-circuited SI decomposition.

describe "range() step argument":
    it "steps forward by 2":
        val result = [for x in range(0, 10, 2): x]
        expect result == [0, 2, 4, 6, 8]

    it "steps backward by -1":
        val result = [for x in range(5, 0, -1): x]
        expect result == [5, 4, 3, 2, 1]

    it "steps forward in a plain for loop":
        var total = 0
        for x in range(0, 10, 3):
            total = total + x
        expect total == 18

    it "keeps the default step of 1":
        val result = [for x in range(0, 4): x]
        expect result == [0, 1, 2, 3]

    it "steps past the end without overshooting":
        val result = [for x in range(0, 7, 3): x]
        expect result == [0, 3, 6]


describe "SI prefixes on unit literals":
    it "applies the kilo prefix":
        unit length(base: f64): m = 1.0
        val dist = 5_km
        expect dist.value() == 5000.0

    it "applies the milli prefix":
        unit duration(base: f64): s = 1.0
        val dur = 500_ms
        expect dur.value() < 1.0

    it "still applies the mega prefix":
        unit length2(base: f64): qm = 1.0
        val dist = 2_Mqm
        expect dist.value() == 2000000.0

    it "keeps an explicitly declared suffix unscaled":
        unit length3(base: f64): zm = 1.0, kzm = 1000.0
        val dist = 5_kzm
        expect dist.value() == 5
