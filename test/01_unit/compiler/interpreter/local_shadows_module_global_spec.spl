# A function-local binding must not write through to a same-named module
# global of another module (interp_local_shadows_cross_module_global_arm_body_2026-08-24),
# and `var t: [T; N]` module state without an initializer must be visible to
# its own module's functions (interpreter_fd_ownership_private_module_globals_not_linked_2026-08-12).
use test.fixtures.interpreter_r8a.shadow_arena.*

describe "local shadows a cross-module global":
    it "plain reassignment of a same-named local does not publish to the global":
        var r8a_arena: [i64] = []
        r8a_arena = [7]
        r8a_arena_push([2])
        expect(r8a_arena_len()).to_equal(1)
        expect(r8a_arena.len()).to_equal(1)
        expect(r8a_arena[0]).to_equal(7)

    it "uninitialised fixed-size module array is readable and writable":
        r8a_slot_set(1, 9)
        expect(r8a_slot_get(1)).to_equal(9)
        expect(r8a_slot_get(0)).to_equal(0)
