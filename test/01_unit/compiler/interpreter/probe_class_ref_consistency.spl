# Run-path probe for class_ref_interp_jit_consistency_spec.spl.
#
# One program, four ways of reaching a class instance, each mutated through
# the binding and read back through the container. Prints one `name=value`
# line per shape so the spec can compare the interpreter and JIT outputs
# line for line. Expected under reference semantics: every value is 2.
#
# Bug: doc/08_tracking/bug/bug_db.sdn
#      interp_dict_class_value_index_mutation_loss_2026-11-03

class Inner:
    v: i64

class Outer:
    inner: Inner
    d: Dict<text, Inner>

struct Pt:
    x: i64

fn bump(c: Inner):
    c.v = 2

fn main():
    # 1. list element
    var xs = [Inner(v: 0)]
    val e1 = xs[0]
    e1.v = 2
    print "list_element={xs[0].v}"

    # 2. dict value (the filed shape)
    var d = {"k": Inner(v: 0)}
    val e2 = d["k"]
    e2.v = 2
    print "dict_value={d["k"].v}"

    # 3. class field
    val o = Outer(inner: Inner(v: 0), d: {"k": Inner(v: 0)})
    val e3 = o.inner
    e3.v = 2
    print "class_field={o.inner.v}"

    # 4. class param
    val p = Inner(v: 0)
    bump(p)
    print "class_param={p.v}"

    # Siblings of the dict shape.
    var d2 = {"k": Inner(v: 0)}
    d2["k"].v = 2
    print "dict_direct_target={d2["k"].v}"

    val e4 = o.d["k"]
    e4.v = 2
    print "nested_dict_in_class={o.d["k"].v}"

    var d3 = {"k": Inner(v: 0)}
    for k, v in d3:
        v.v = 2
    print "dict_iteration={d3["k"].v}"

    # Value types stay copies in BOTH engines: a struct read out of a dict
    # is independent of the entry.
    var ps = {"k": Pt(x: 0)}
    var q = ps["k"]
    q.x = 5
    print "struct_dict_value_copied={ps["k"].x}"

main()
