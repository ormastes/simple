#!/bin/sh
set -eu

facade=src/compiler/95.interp/load_facade/interpreter_load_facade_v1.spl

test -f "$facade"
grep -q 'PackageCommandResolutionV1' "$facade"
grep -q 'DiagnosticV1' "$facade"
grep -q 'ImportSnapshotIdentityV1' "$facade"
grep -q 'package_section_reader_open_v1' "$facade"
grep -q 'package_section_reader_read_v1' "$facade"
grep -q 'package_section_reader_close_v1' "$facade"
grep -q 'pinned_archive_close_v1' "$facade"

if grep -Eq 'compiler\.loader\.|rt_(file|dir|process)|walk|scan_dir|src/' "$facade"; then
    echo 'interpreter load facade bypasses shared demand/archive authority' >&2
    exit 1
fi

for code in IL1001 IL1002 IL1003 IL1004 IL1005 IL1006; do
    grep -q "\"$code\"" "$facade"
done

echo INTERPRETER_LOAD_FACADE_STATIC_PASS
