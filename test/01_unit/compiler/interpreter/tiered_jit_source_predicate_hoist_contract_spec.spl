# Source contract for shared Tiered JIT lexical predicates.
#
# The fact builder must not repeatedly scan the source for predicates shared by
# several detectors, and it must not scan source at all for an ineligible
# profile. Behavioral fact coverage lives in tiered_jit_hotspot_spec.spl.

use std.io_runtime.{file_read}
use std.spec.*

val TIERED_JIT_SOURCE = "src/compiler/95.interp/execution/tiered_jit.spl"

fn function_body(source: text, name: text, next_name: text) -> text:
    val start = source.find("fn " + name)
    if start < 0:
        fail("missing function: " + name)
        return ""
    val tail = source.substring(start, source.len())
    val finish = tail.find("fn " + next_name)
    if finish < 0:
        fail("missing next function: " + next_name)
        return ""
    tail.substring(0, finish)

fn occurrence_count(haystack: text, needle: text) -> i64:
    var count: i64 = 0
    var remaining = haystack
    var found = remaining.find(needle)
    while found >= 0:
        count = count + 1
        val next = found + needle.len()
        remaining = remaining.substring(next, remaining.len())
        found = remaining.find(needle)
    count

describe "Tiered JIT source predicate hoisting":
    it "runs exactly one indexed source scan inside the eligibility guard [importance=critical; importance_weight=3]":
        step("Read only the private scanner and fact builder")
        val source = file_read(TIERED_JIT_SOURCE)
        val scanner = function_body(
            source, "_jit_hotspot_source_scan(", "_jit_hotspot_backend_plugin_fact_build(")
        val build = function_body(
            source, "_jit_hotspot_backend_plugin_fact_build(", "jit_hotspot_backend_plugin_facts(")

        step("Pin one computation and its placement after eligibility")
        val guard = build.find("if profile.typed_mir and profile.safe_deopt:")
        val scan = build.find("_jit_hotspot_source_scan(profile.source)")
        expect(guard).to_be_greater_than(-1)
        expect(scan).to_be_greater_than(guard)
        expect(occurrence_count(build, "_jit_hotspot_source_scan(profile.source)")).to_equal(1)
        expect(occurrence_count(scanner, "while ")).to_equal(1)
        expect(scanner.contains("source.contains(")).to_equal(false)
        expect(build.contains("source.contains(")).to_equal(false)

    it "routes the public fact adapter through the private build exactly once [importance=high; importance_weight=2]":
        step("Inspect the public backend fact adapter")
        val source = file_read(TIERED_JIT_SOURCE)
        val body = function_body(
            source, "jit_hotspot_backend_plugin_facts(", "jit_hotspot_rebuild_choice(")

        step("Require one private build call and a value-returned fact vector")
        expect(occurrence_count(body, "_jit_hotspot_backend_plugin_fact_build(")).to_equal(1)
        expect(body.contains(".facts")).to_equal(true)

    it "does not retain the old rescanning helper family [importance=high; importance_weight=2]":
        step("Inspect the complete tiered-JIT source region")
        val source = file_read(TIERED_JIT_SOURCE)
        step("Reject shared wrappers and direct source rescans")
        expect(source.contains("_with_shared(")).to_equal(false)
        expect(source.contains("fn jit_hotspot_source_has_bounded_byte_scan(")).to_equal(false)
        expect(source.contains("fn jit_hotspot_source_has_checksum_reducer(")).to_equal(false)
        expect(source.contains("fn jit_hotspot_source_has_small_fixed_trip_loop(")).to_equal(false)
        expect(source.contains("fn jit_hotspot_source_has_vectorization_candidate(")).to_equal(false)
        expect(source.contains("fn jit_hotspot_source_has_range_facts(")).to_equal(false)
