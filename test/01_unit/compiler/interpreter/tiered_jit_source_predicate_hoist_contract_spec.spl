# Source contract for shared Tiered JIT lexical predicates.
#
# The fact builder must not repeatedly scan the source for predicates shared by
# several detectors, and it must not scan source at all for an ineligible
# profile. Behavioral fact coverage lives in tiered_jit_hotspot_spec.spl.

use std.io_runtime.{file_read}
use std.spec.*

val TIERED_JIT_SOURCE = "src/compiler/95.interp/execution/tiered_jit.spl"

fn function_body(source: text, name: text, next_name: text) -> text:
    val start = source.find("fn " + name)
    if start < 0:
        fail("missing function: " + name)
        return ""
    val tail = source.substring(start, source.len())
    val finish = tail.find("fn " + next_name)
    if finish < 0:
        fail("missing next function: " + next_name)
        return ""
    tail.substring(0, finish)

fn occurrence_count(haystack: text, needle: text) -> i64:
    var count: i64 = 0
    var remaining = haystack
    var found = remaining.find(needle)
    while found >= 0:
        count = count + 1
        val next = found + needle.len()
        remaining = remaining.substring(next, remaining.len())
        found = remaining.find(needle)
    count

describe "Tiered JIT source predicate hoisting":
    it "computes each shared predicate once inside the eligibility guard":
        step("Read only the backend fact builder")
        val source = file_read(TIERED_JIT_SOURCE)
        val body = function_body(
            source, "jit_hotspot_backend_plugin_facts(", "jit_hotspot_rebuild_choice(")

        step("Pin one computation and its placement after eligibility")
        val guard = body.find("if profile.typed_mir and profile.safe_deopt:")
        val loop = body.find("val has_loop =")
        val indexed = body.find("val has_indexed_access =")
        val advance = body.find("val advances_index =")
        val first_fact = body.find("facts = facts.push(\"loop_preheader\")")
        expect(guard).to_be_greater_than(-1)
        expect(loop).to_be_greater_than(guard)
        expect(indexed).to_be_greater_than(loop)
        expect(advance).to_be_greater_than(indexed)
        expect(first_fact).to_be_greater_than(advance)
        expect(occurrence_count(body, "val has_loop =")).to_equal(1)
        expect(occurrence_count(body, "val has_indexed_access =")).to_equal(1)
        expect(occurrence_count(body, "val advances_index =")).to_equal(1)

    it "routes shared consumers through internal variants":
        step("Inspect the backend fact builder call sites")
        val source = file_read(TIERED_JIT_SOURCE)
        val body = function_body(
            source, "jit_hotspot_backend_plugin_facts(", "jit_hotspot_rebuild_choice(")

        step("Require every shared consumer and exclude rescanning wrappers")
        expect(occurrence_count(body, "_with_shared(")).to_equal(5)
        expect(body.contains("jit_hotspot_source_has_small_fixed_trip_loop(profile.source)")).to_equal(false)
        expect(body.contains("jit_hotspot_source_has_vectorization_candidate(profile.source)")).to_equal(false)
        expect(body.contains("jit_hotspot_source_has_range_facts(profile.source)")).to_equal(false)
        expect(body.contains("jit_hotspot_source_has_bounded_byte_scan(profile.source)")).to_equal(false)
        expect(body.contains("jit_hotspot_source_has_checksum_reducer(profile.source)")).to_equal(false)
