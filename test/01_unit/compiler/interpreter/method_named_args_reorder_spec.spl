# Regression pins: named arguments were ignored for METHOD calls.
#
# Method calls evaluate their arguments up front and bound them through
# bind_args_with_values, which takes a bare &[Value] -- the names were already
# discarded, so binding was purely positional. `m.subtract(subtrahend=15,
# minuend=50)` computed 15 - 50 = -35 instead of 50 - 15 = 35. Plain function
# calls were unaffected: they keep the Argument list and bind by name.
# Non-commutative operators are used throughout so a reordering failure cannot
# hide behind a symmetric result.

class Math:
    fn subtract(self, minuend, subtrahend):
        return minuend - subtrahend

    fn divide(self, numerator, denominator):
        return numerator / denominator

    fn combine(self, a, b, c):
        return a * 100 + b * 10 + c

fn free_subtract(minuend, subtrahend):
    return minuend - subtrahend

describe "named arguments on method calls":
    it "reorders two named method arguments":
        val m = Math {}
        expect m.subtract(subtrahend=15, minuend=50) == 35

    it "still binds two named method arguments given in order":
        val m = Math {}
        expect m.subtract(minuend=50, subtrahend=15) == 35

    it "reorders a non-commutative division":
        val m = Math {}
        expect m.divide(denominator=4, numerator=100) == 25

    it "reorders three named method arguments":
        val m = Math {}
        expect m.combine(c=3, a=1, b=2) == 123

    it "handles a positional argument followed by named ones":
        val m = Math {}
        expect m.combine(1, c=3, b=2) == 123

    it "binds purely positional method arguments unchanged":
        val m = Math {}
        expect m.subtract(50, 15) == 35

    it "keeps free-function reordering working":
        expect free_subtract(subtrahend=15, minuend=50) == 35
