# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use fixtures.shadowed_global_arena.{arena_push, arena_get, arena_len, build_local_with_same_name}


# Regression: `var arm_body_flat: [i64]` in parser_stmts.spl shadowed the
# module global `arm_body_flat: [text]` of decl_nodes.spl. The seed
# interpreter's mutating-method write-through (`x.push(v)` -> MODULE_GLOBALS
# by NAME) copied the local's ints into the global, so the next
# `arm_body_flat[idx].split(",")` failed with `method split not found on type
# i64 (receiver value: 30)` while parsing src/compiler/driver/driver.spl
# (2026-08-21 stage-1 build). A frame local must never write through.
describe "interpreter: frame local sharing a module global's name":
    # @manual scenario evidence
    it "keeps the module global intact after pushing into the local":
        # @req REQ-SSPEC-UNIT
        step("keeps the module global intact after pushing into the local")
        arena_push("1,2,3")
        arena_push("4,5")
        expect(build_local_with_same_name(4)).to_equal(4)
        expect(arena_len()).to_equal(2)
        expect(arena_get(0)).to_equal("1,2,3")
        expect(arena_get(1).split(",").len()).to_equal(2)
