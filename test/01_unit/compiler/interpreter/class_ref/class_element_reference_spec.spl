# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# design: doc/05_design/compiler/interpreter/class_instance_reference_storage_2026-11-03.md

# Fixed 2026-11-04: reference carrier is the interpreter default (green by default).
# Tracks: doc/08_tracking/bug/interp_list_class_element_read_returns_copy_mutation_loss_2026-08-17.md
#         doc/08_tracking/bug/jit_class_mutation_drop_characterization_2026-07-04.md
# Fix needs a seed (Rust tree-walk) value-model change + redeploy; tag comes off then.

# Class instances are reference types: reading one out of a list or field yields
# a shared handle. Structs stay value-copied. Runs in-process on the tree-walk
# interpreter, which is the engine under test.

class RefItem:
    n: i64

impl RefItem:
    me bump():
        me.n = me.n + 1

struct ValPoint:
    x: i64

class RefBox:
    items: [RefItem]

impl RefBox:
    me first() -> RefItem:
        me.items[0]

describe "class element read is a reference":
    it "xs[i].mutate() persists":
        val xs = [RefItem(n: 0)]
        xs[0].bump()
        expect(xs[0].n).to_equal(1)
    it "val c = xs[i]; c.mutate() persists":
        val xs = [RefItem(n: 0)]
        val c = xs[0]
        c.bump()
        expect(xs[0].n).to_equal(1)
    it "field-list element returned from a method aliases":
        val b = RefBox(items: [RefItem(n: 0)])
        val it0 = b.first()
        it0.bump()
        expect(b.first().n).to_equal(1)
        expect(b.items[0].n).to_equal(1)

describe "struct element read stays a value copy":
    it "copy does not write through":
        val ps = [ValPoint(x: 5)]
        var p = ps[0]
        p.x = 9
        expect(ps[0].x).to_equal(5)
