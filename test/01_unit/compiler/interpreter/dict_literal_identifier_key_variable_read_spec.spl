use std.spec.*

# Contract pin for dict literal keys (seed_dict_literal_identifier_keys_variable_not_found_2026-11-12):
# a bare identifier key is a VARIABLE READ, in every engine — the seed
# interpreter, the seed HIR lower, and the self-hosted frontend all evaluate
# the key expression. Literal string keys must be quoted. The earlier
# app_mcp_intensive_spec.spl failures were shorthand drift (now quoted), not
# an interpreter defect; an interpreter "fix" that turned identifier keys
# into literal strings silently diverged from compiled paths (product code
# such as src/app/spipe/fusion/rrf.spl keys dicts with bound variables).

describe "dict literal identifier keys are variable reads":
    it "keys by the value of a bound identifier, not by its name":
        val dyn_key = "dyn"
        val d = {dyn_key: 42}
        expect(d["dyn"]).to_equal(42)
        expect(d["dyn_key"].? != nil).to_equal(false)

    it "quoted keys stay literal":
        val d = {"dyn_key": 42}
        expect(d["dyn_key"]).to_equal(42)
        expect(d["dyn"].? != nil).to_equal(false)

    it "int-valued bound identifiers key by their text":
        val id = 7
        val d = {id: "seven"}
        expect(d["7"]).to_equal("seven")
        expect(d["id"].? != nil).to_equal(false)
