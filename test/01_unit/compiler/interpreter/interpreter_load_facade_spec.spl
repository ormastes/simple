use std.spec.*
use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

val INTERPRETER_LOAD_FACADE_PATH =
    "src/compiler/95.interp/load_facade/interpreter_load_facade_v1.spl"

describe "interpreter package load facade":
    it "uses shared resolver diagnostic and snapshot identities":
        step("uses shared resolver diagnostic and snapshot identities")
        val source = rt_file_read_text(INTERPRETER_LOAD_FACADE_PATH) ?? ""
        expect(source).to_contain("PackageCommandResolutionV1")
        expect(source).to_contain("DiagnosticV1")
        expect(source).to_contain("ImportSnapshotIdentityV1")
        expect(source).to_not_contain("struct InterpreterResolver")
        expect(source).to_not_contain("struct InterpreterSnapshot")

    it "loads only selected sections from pinned package authority":
        step("loads only selected sections from pinned package authority")
        val source = rt_file_read_text(INTERPRETER_LOAD_FACADE_PATH) ?? ""
        expect(source).to_contain("package_section_reader_open_v1")
        expect(source).to_contain("package_section_reader_read_v1")
        expect(source).to_contain("package_section_reader_close_v1")
        expect(source).to_contain("PinnedArchiveCapability")

    it "rejects invalid resolver snapshot and archive identities":
        step("rejects invalid resolver snapshot and archive identities")
        val source = rt_file_read_text(INTERPRETER_LOAD_FACADE_PATH) ?? ""
        expect(source).to_contain("IL1001")
        expect(source).to_contain("IL1002")
        expect(source).to_contain("IL1003")
        expect(source).to_contain("IL1004")

    it "never imports a private loader or reads the live source tree":
        step("never imports a private loader or reads the live source tree")
        val source = rt_file_read_text(INTERPRETER_LOAD_FACADE_PATH) ?? ""
        expect(source).to_not_contain("compiler.loader.")
        expect(source).to_not_contain("rt_file_")
        expect(source).to_not_contain("scan_dir")
        expect(source).to_not_contain("walk_dir")
        expect(source).to_not_contain("src/")

    it "binds successful loads to resolver snapshot and archive receipts":
        step("binds successful loads to resolver snapshot and archive receipts")
        val source = rt_file_read_text(INTERPRETER_LOAD_FACADE_PATH) ?? ""
        expect(source).to_contain("resolver-root=")
        expect(source).to_contain("tree=")
        expect(source).to_contain("inventory=")
        expect(source).to_contain("archive=")
        expect(source).to_contain("receipt=")
