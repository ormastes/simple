# @tag:in-development
# Pure-Simple core interpreter parity for unit conversions, incl. chained
# `x.to_<sfx>().to_<sfx2>()` (seed: PR #9797, interpreter_helpers/method_dispatch.rs;
# seed spec test/01_unit/compiler/interpreter/unit_nested_method_dispatch_spec.spl).
# Expected RED: the core interpreter has no unit runtime at all -- every unit
# literal fails with `unsupported expression kind: SuffixedLit`, and
# `use unit.velocity.{kmph}` does not parse (`unit` keyword). Chained dispatch
# needs that base first. Tracked in the robust-boundaries plan implementation log.
use std.spec.{describe, it, expect}
use compiler.frontend.core.interpreter.mod.{core_interpret}
use compiler.frontend.core.interpreter.value.{val_get_int}
use compiler.frontend.core.interpreter.eval.{eval_get_error}

fn probe(src: text) -> text:
    val result = core_interpret(src + "\n", "core_unit_chain_probe.spl")
    val err = eval_get_error()
    if err != "": return "ERR:" + err
    "" + val_get_int(result)

val MK: text = "fn mk() -> kmph?:\n    Some(60_kmph)\n"

describe "core interpreter unit conversion parity":
    it "evaluates a nominal unit literal":
        expect(probe("unit FreeBytes: i64 as fbytes\nval b = 12_fbytes\nb.value()")).to_equal("12")

    it "returns to_text in chained position":
        expect(probe("unit FreeBytes: i64 as fbytes\nfn mkb() -> FreeBytes?:\n    Some(12_fbytes)\nif mkb().unwrap().to_text() == \"12\": 1 else: 0")).to_equal("1")

    it "converts a bound value with to_mps":
        expect(probe("val s = 60_kmph\nif s.to_mps().value() > 16.6: 1 else: 0")).to_equal("1")

    it "converts opt.unwrap().to_mps() in chained position":
        expect(probe(MK + "if mk().unwrap().to_mps().value() > 16.6: 1 else: 0")).to_equal("1")

    it "round-trips a two-deep chained conversion":
        expect(probe(MK + "if mk().unwrap().to_mps().to_kmph().value() > 59.9: 1 else: 0")).to_equal("1")

    it "falls through to builtin to_i64 on a unit":
        expect(probe("unit FreeBytes: i64 as fbytes\nval b = 12_fbytes\nb.to_i64()")).to_equal("12")
