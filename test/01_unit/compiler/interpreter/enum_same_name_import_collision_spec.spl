# @req REQ-SSPEC-COMPILER
"""
Regression for bug seed_enum_variant_bare_name_last_registration_wins_2026_10_19
(sibling of interp_class_name_collision_breaks_test_db_persistence_2026-08-10):
a braced import of another module's function co-loads its same-named enum, which
used to replace the importer's enum by bare name. Enums are now resolved per
owning module in the flattened lane, like classes.
"""
use std.spec.*
use test.fixtures.flat_fn_shadow.enum_a.{Mode, mode_a_level}
use test.fixtures.flat_fn_shadow.enum_b.{mode_b_name, mode_b_mix}

describe "same-name enums in two co-loaded modules":
    it "importer's Mode and other module's Mode stay distinct":
        val m = Mode.Slow
        expect(m == Mode.Slow).to_equal(true)
        expect(mode_b_name()).to_equal("blue")
    it "payload variant resolves against the importer's enum":
        expect(mode_a_level(Mode.Tuned(5))).to_equal(5)
        expect(mode_a_level(Mode.Fast)).to_equal(1)
    it "payload variant inside the other module resolves against its own enum":
        expect(mode_b_mix()).to_equal("teal")
