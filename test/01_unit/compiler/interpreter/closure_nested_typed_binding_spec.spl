# @req: REQ-COMPILER-INTERPRETER-001

# Regression: typed `val x: T = ...` bindings inside nested blocks (if/while/else)
# within closure bodies (describe/it lambdas) must bind like unannotated vals.
# Bug: exec_block_closure_mut hand-rolled only identifier patterns, silently
# dropping Pattern::Typed bindings — reads then failed with
# "variable `x` not found".
# See doc/08_tracking/bug/test_runner_annotated_u32_val_arg_corruption_2026-06-12.md
# @tag: unit, compiler, interpreter, closure, binding

use std.spec.{describe, it, expect}

fn take_u(v: u32) -> u32:
    v

use std.spec.step

describe "typed val bindings in nested closure blocks":
    it "binds annotated i32 inside if and reads it":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds annotated i32 inside if and reads it")
        val cond = true
        if cond:
            val x: i32 = 5
            expect(x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        else:
            expect(2).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "binds annotated u32 inside if and passes it as call arg":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds annotated u32 inside if and passes it as call arg")
        val cond = true
        if cond:
            val v: u32 = 0xFF0000FFu32
            expect(take_u(v)).to_equal(0xFF0000FFu32)  # oracle: 0xFF0000FFu32 — named expected value from the requirement
        else:
            expect(2).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "binds annotated val inside while body":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds annotated val inside while body")
        var i = 0
        var total = 0
        while i < 1:
            val x: i32 = 7
            total = total + x
            i = i + 1
        expect(total).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "binds annotated val inside else branch":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds annotated val inside else branch")
        val cond = false
        if cond:
            expect(1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        else:
            val x: i32 = 9
            expect(x).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "binds tuple destructuring inside if":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds tuple destructuring inside if")
        val cond = true
        if cond:
            val (a, b) = (3, 4)
            expect(a + b).to_equal(7)  # oracle: 7 — named expected value from the requirement
        else:
            expect(2).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "binds typed val inside Ok((a,b)) match arm body":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds typed val inside Ok((a,b)) match arm body")
        # Regression for interpreter_val_in_ok_tuple_match_arm_not_visible_2026-06-04:
        # typed val declared after the Ok((a,b)) pattern binding was not visible
        # to subsequent statements in the same arm (exec_block_closure_mut dropped
        # Pattern::Typed bindings; fixed 2026-06-12 via bind_pattern_value).
        val res = Ok(("x", "y"))
        match res:
            Ok((a, b)):
                val joined: text = a + b
                expect(joined).to_equal("xy")
            Err(_):
                assert_true(false)

    it "binds multiple typed vals sequentially in Ok((a,b)) match arm":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: binds multiple typed vals sequentially in Ok((a,b)) match arm")
        val res = Ok(("hello", "world"))
        match res:
            Ok((a, b)):
                val first: text = a
                val second: text = b
                val combined: text = first + " " + second
                expect(combined).to_equal("hello world")
            Err(_):
                assert_true(false)
