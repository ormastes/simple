# Run-path (JIT) probe for optional UNWRAP IDIOMS over BoxInt-family scalars.
#
# WHY THIS FILE EXISTS: `bin/simple test` executes specs on the tree-walk
# INTERPRETER, which was already correct for every case below, so an ordinary
# spec cannot observe this defect at all. Only the run path (Cranelift JIT)
# can.
#
# DEFECT (fixed 2026-08-31, second half of the #138 family): after #138 boxed
# the producer side, every CONSUMER idiom on the JIT lane still leaked the
# TAGGED word (value << 3) instead of the payload:
#   val w = f() ?? 0        -> w printed 336 (== 42 << 3), w + 1 -> 337
#   f().unwrap() + 1        -> 337
#   if val n = f(): n + 1   -> 337
# while the interpreter printed 42/43 for all three. Fixes: `??` over a
# `T?`-scalar is now TYPED as the raw inner scalar (hir lower_coalesce),
# `if val` bindings and `.unwrap()` likewise, and mir lower_builtin_call_expr
# unboxes `rt_unwrap_or_self` results by name+type (the same mechanism
# `rt_enum_payload` already had).
#
# Arithmetic on an UNNARROWED optional (`if v != nil: v + 1`) is NOT narrowed
# (flow_sensitive_narrowing_design.md is a PROPOSAL); it is now rejected in
# HIR lowering so the JIT lane fails closed exactly like the interpreter lane
# instead of silently computing on tagged bits. That is intentionally not
# probed here (it does not compile); the lane-agreement evidence lives in the
# bug record.
#
#   bin/simple run <this>                                    -> ALL PASS
#   SIMPLE_EXECUTION_MODE=interpreter bin/simple run <this>  -> ALL PASS (control)
#
# Tracked by doc/08_tracking/bug/optional_i64_return_payload_corruption_2026-08-31.md

use std.io_runtime.{exit}

fn get() -> i64?:
    return 42

fn get_nil() -> i64?:
    return nil

fn get_three() -> i64?:
    # payload that COLLIDES with the nil sentinel word 3 must survive ??
    return 3

fn check(name: text, actual: text, expected: text, fails: i64) -> i64:
    if actual == expected:
        print("PASS " + name + " = " + actual)
        return fails
    print("FAIL " + name + " expected=" + expected + " actual=" + actual)
    return fails + 1

fn main():
    var fails = 0

    # ?? yields the RAW payload, usable in arithmetic
    val w = get() ?? 0
    fails = check("coalesce_value", w.to_text(), "42", fails)
    fails = check("coalesce_arith", (w + 1).to_text(), "43", fails)
    fails = check("coalesce_nil_default", (get_nil() ?? -1).to_text(), "-1", fails)
    fails = check("coalesce_payload_three", (get_three() ?? -1).to_text(), "3", fails)

    # .unwrap() yields the RAW payload
    val u = get().unwrap()
    fails = check("unwrap_value", u.to_text(), "42", fails)
    fails = check("unwrap_arith", (u + 1).to_text(), "43", fails)

    # if val binds the RAW payload
    var bound = -1
    var bound_plus = -1
    if val n = get():
        bound = n
        bound_plus = n + 1
    fails = check("if_val_value", bound.to_text(), "42", fails)
    fails = check("if_val_arith", bound_plus.to_text(), "43", fails)

    # genuinely-optional accessors keep the checked path (sentinel history:
    # coalesce_raw_i64_sentinel_collision_2026-08-02.md)
    val e: [i64] = []
    fails = check("empty_first_default", (e.first() ?? -1).to_text(), "-1", fails)
    val a = [40, 41, 3]
    fails = check("first_value", (a.first() ?? -1).to_text(), "40", fails)
    fails = check("index_of_sentinel_value", (a.index_of(3) ?? -1).to_text(), "2", fails)
    val d = {"k": 7}
    fails = check("dict_get_value", (d.get("k") ?? -1).to_text(), "7", fails)
    val d0: {text: i64} = {}
    fails = check("dict_get_miss_default", (d0.get("k") ?? -1).to_text(), "-1", fails)

    if fails == 0:
        print("OPTIONAL_UNWRAP_IDIOMS PROBE: ALL PASS")
        exit(0)
    print("OPTIONAL_UNWRAP_IDIOMS PROBE: " + fails.to_text() + " FAILURES")
    exit(1)

main()
