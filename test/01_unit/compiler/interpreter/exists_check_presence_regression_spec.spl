# @cover src/compiler_rust/compiler/src/interpreter_control.rs 60%
# Regression: `.?` returns T? (value-or-nil) and treats empty collections as absent.
# Closes: dotq_on_empty_collection_reads_present_2026-09-13,
#         option_predicate_returns_payload_not_bool_2026-07-28 (outdated premise),
#         optional_query_operator_identity_passthrough_2026-07-20 (outdated premise),
#         seed_optional_query_comparison_divergence_2026-08-16 (Divergence A by design).

class Thing:
    x: i64

fn find_thing(present: bool) -> Thing?:
    if present:
        return Thing(x: 42)
    nil

describe "exists check .? presence":
    it "empty list is absent in if":
        var e: [i64] = []
        var hit = false
        if e.?:
            hit = true
        expect(hit).to_equal(false)

    it "empty dict and empty text are absent":
        var d: Dict<text, i64> = {}
        var s = ""
        var hit = 0
        if d.?:
            hit = hit + 1
        if s.?:
            hit = hit + 1
        expect(hit).to_equal(0)

    it "while coll.? drain loop terminates":
        var w = [1, 2, 3]
        var n = 0
        while w.?:
            w = w[1:]
            n = n + 1
            if n > 10:
                break
        expect(n).to_equal(3)

    it "not coll.? is the is_empty spelling":
        var e: [i64] = []
        expect(not e.?).to_equal(true)
        expect(not [1].?).to_equal(false)

    it "optional .? passes the payload through, not bool":
        val y = find_thing(true)
        val n = find_thing(false)
        expect(y.?.x).to_equal(42)
        expect(n.? == nil).to_equal(true)

    it "falsy present payload still takes the branch":
        val z: i64? = 0
        var hit = false
        if z.?:
            hit = true
        expect(hit).to_equal(true)

    it "explicit bool comparison uses != nil":
        val y = find_thing(true)
        expect(y != nil).to_equal(true)
        expect(find_thing(false) != nil).to_equal(false)
