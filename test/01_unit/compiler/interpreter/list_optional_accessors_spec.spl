# @req REQ-SSPEC-COMPILER
# Bug: list_first_returns_raw_value_not_option_2026-07-20
"""
List first/last/pop/min/max return a nullable T? (the element, or nil when
empty), matching pure Simple rt_array_first -- NOT Option<T>. They must work
with `??` and `if val`. Oracles are absolute literals.
"""
use std.spec.step

import std.spec

describe "list optional accessors (T?)":
    it "first/last on non-empty list with ??":
        step("first/last non-empty")
        val xs = [10, 20, 30]
        expect(xs.first() ?? -1).to_equal(10)
        expect(xs.last() ?? -1).to_equal(30)

    it "first/last on empty list with ??":
        step("first/last empty")
        val xs: [i64] = []
        expect(xs.first() ?? -1).to_equal(-1)
        expect(xs.last() ?? -1).to_equal(-1)

    it "min/max on non-empty and empty list with ??":
        step("min/max")
        val xs = [5, 2, 9]
        val es: [i64] = []
        expect(xs.min() ?? -1).to_equal(2)
        expect(xs.max() ?? -1).to_equal(9)
        expect(es.min() ?? -1).to_equal(-1)
        expect(es.max() ?? -1).to_equal(-1)

    it "pop on non-empty and empty list with ??":
        step("pop")
        var xs = [1, 2, 3]
        expect(xs.pop() ?? -1).to_equal(3)
        expect(xs.len()).to_equal(2)
        var es: [i64] = []
        expect(es.pop() ?? -1).to_equal(-1)

    it "present element 3 and 0 are not mistaken for nil":
        step("sentinel values")
        val xs = [3]
        val zs = [0]
        expect(xs.first() ?? 9).to_equal(3)
        expect(zs.first() ?? 9).to_equal(0)
        expect(xs.max() ?? 9).to_equal(3)

    it "if val binds the element for non-empty and skips for empty":
        step("if val")
        val xs = [7, 8]
        var got = 0
        if val f = xs.first():
            got = f
        expect(got).to_equal(7)
        if val l = xs.last():
            got = l
        expect(got).to_equal(8)
        if val mn = xs.min():
            got = mn
        expect(got).to_equal(7)
        if val mx = xs.max():
            got = mx
        expect(got).to_equal(8)
        var ys = [4, 5]
        if val p = ys.pop():
            got = p
        expect(got).to_equal(5)
        val es: [i64] = []
        var hit = false
        if val e = es.first():
            hit = true
        if val e2 = es.last():
            hit = true
        if val e3 = es.min():
            hit = true
        if val e4 = es.max():
            hit = true
        expect(hit).to_equal(false)

    it "text split last still binds to a text val":
        step("split last")
        val name = "a/b/c".split("/").last()
        expect(name).to_equal("c")
