# Regression: chained method calls on unit values (rb4-unitmethod).
use unit.velocity.{kmph}
unit FreeBytes: i64 as fbytes

fn mk(r: i64) -> FreeBytes?:
    Some(FreeBytes(r))

describe "unit value nested method dispatch":
    it "returns inner value from opt.unwrap().value()":
        expect(mk(4096).unwrap().value()).to_equal(4096)

    it "forwards builtin to_i64 in chained position":
        expect(mk(4096).unwrap().to_i64()).to_equal(4096)

    it "matches the bound-variable form":
        val f = mk(7).unwrap()
        expect(mk(7).unwrap().value()).to_equal(f.value)

    it "returns to_text in chained position":
        expect(mk(12).unwrap().to_text()).to_equal("12")

fn mk_speed() -> kmph?:
    Some(60_kmph)

describe "unit-to-unit conversion in chained position":
    it "converts opt.unwrap().to_mps() within the family":
        expect(mk_speed().unwrap().to_mps().value() > 16.6).to_equal(true)

    it "round-trips a two-deep chained conversion":
        expect(mk_speed().unwrap().to_mps().to_kmph().value() > 59.9).to_equal(true)

    it "matches the bound-variable conversion":
        val s = mk_speed().unwrap()
        expect(mk_speed().unwrap().to_mps().value()).to_equal(s.to_mps().value())
