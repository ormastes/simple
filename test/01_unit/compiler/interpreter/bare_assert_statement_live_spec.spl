# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER

# Regression for doc/08_tracking/bug/bare_assert_statement_vacuity_2026-08-02.md
#
# A bare `assert <cond>` statement used to be silently inert. This spec invokes
# checked-in probes as child processes so it can observe the assertion's exit
# status without depending on a POSIX shell or asking a spec body to observe
# its own termination. The parser-level companion spec covers the pure-Simple
# desugaring to `__assert`.

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run, env_get}

fn simple_binary() -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    bin

fn run_probe(name: text) -> (text, text, i64):
    process_run(simple_binary(), [
        "run",
        "test/fixtures/repro/compiler/bare_assert/bare_assert_" + name + ".spl",
        "--mode=interpreter",
        "--clean"
    ])

describe "bare assert statement is live under the tree-walk interpreter":
    it "fails an example whose only assertion is a false bare assert":
        # @req REQ-SSPEC-COMPILER
        step("Run a fixture whose bare assertion is deliberately false")
        val result = run_probe("false")
        step("The interpreter must terminate non-zero with the assertion message")
        expect(result.2 != 0).to_equal(true)
        expect(result.1).to_contain("bare assert sentinel")
        expect(result.0.contains("UNREACHABLE_BARE_ASSERT_SENTINEL")).to_equal(false)

    it "continues after a true bare assert":
        step("Run a fixture containing a true bare assert followed by a marker")
        val result = run_probe("true")
        step("The process must succeed and execute the following statement")
        expect(result.2).to_equal(0)
        expect(result.0).to_contain("BARE_ASSERT_CONTINUED")
