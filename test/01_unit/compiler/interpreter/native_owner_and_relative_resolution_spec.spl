use std.spec.*
use compiler.core.interpreter.value.{val_init_cache, val_make_int, val_get_int, val_make_array, val_get_array, val_array_clear, val_array_pop, val_is_nil}
use compiler.core.interpreter.ops.{val_negate}
use compiler.core.interpreter.module_loader_resolve.{resolve_module_path, module_resolve_cache_reset}
use compiler.core.ast.{ast_reset, expr_int, expr_get_tag, EXPR_INT_LIT}
use std.io_runtime.file_read

describe "native core interpreter owner boundaries":
    it "accepts the final live expression index after arena growth":
        ast_reset()
        val final_live = expr_int(7, 0)
        expect(expr_get_tag(final_live)).to_equal(EXPR_INT_LIT)

    it "negates an integer through the explicit value owner":
        val_init_cache()
        expect(val_get_int(val_negate(val_make_int(1)))).to_equal(-1)

    it "resolves a bare import within its nearest runtime family source root":
        module_resolve_cache_reset()
        val resolved = resolve_module_path(
            "testing.mock.builder",
            "src/lib/nogc_sync_mut/src/testing/mock/prevention.spl",
        )
        expect(resolved).to_equal("src/lib/nogc_sync_mut/src/testing/mock/builder.spl")

    it "resolves leading-dot imports from the nearest package ancestor":
        module_resolve_cache_reset()
        expect(resolve_module_path(".types", "src/lib/common/crypto/sha256_core.spl")).to_equal("src/lib/common/crypto/types.spl")
        expect(resolve_module_path(".string_core", "src/lib/common/crypto/types.spl")).to_equal("src/lib/common/string_core.spl")

    it "clears arrays through their value-arena owner":
        val_init_cache()
        val items = val_make_array([val_make_int(1)])
        expect(val_array_clear(items)).to_equal(true)
        expect(val_get_array(items).len()).to_equal(0)

    it "pops arrays through their owner and returns nil when empty":
        val_init_cache()
        val items = val_make_array([val_make_int(7)])
        expect(val_get_int(val_array_pop(items))).to_equal(7)
        expect(val_get_array(items).len()).to_equal(0)
        expect(val_is_nil(val_array_pop(items))).to_equal(true)

    it "retains array ownership after pop and clear operations":
        val_init_cache()
        val items = val_make_array([val_make_int(1), val_make_int(2)])
        val _ = val_array_pop(items)
        expect(val_get_array(items).len()).to_equal(1)
        val _ = val_array_clear(items)
        expect(val_get_array(items).len()).to_equal(0)

    it "preserves declaration owners across multi-module append imports":
        val loader = file_read("src/compiler/10.frontend/core/interpreter/module_loader_core.spl")
        val evaluator = file_read("src/compiler/10.frontend/core/interpreter/eval_decls.spl")
        expect(loader).to_contain("for appended_did in appended_decls:")
        expect(loader).to_contain("decl_owner_file_set(appended_did, resolved_path)")
        expect(evaluator).to_contain("decl_owner_file_get(did)")
        expect(evaluator).to_contain("current_file = if declared_owner !=")

    it "serializes both pass and fail counters before nested result formatting":
        val spec_owner = file_read("src/lib/nogc_sync_mut/spec.spl")
        expect(spec_owner).to_contain("Persist before any later nested call")
        expect(spec_owner).to_contain("serialize the authoritative local counters first")
        expect(spec_owner).to_contain("_write_test_result_evidence(passed, failed)")
