"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/interpreter/u32_wrap_arith_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""
use std.spec.step

# doc-path: doc/01_research/local/u32_wrap_arith_spec.md
# doc-path: doc/03_plan/sys_test/u32_wrap_arith_spec.md
# doc-path: doc/04_architecture/u32_wrap_arith_spec.md
# doc-path: doc/05_design/u32_wrap_arith_spec_oracles.md
# @manual: primary

"""
# u32 / Unsigned Integer Wrap Arithmetic Specification

**Feature IDs:** #INTERP-U32-WRAP
**Category:** Interpreter
**Difficulty:** 2/5
**Status:** Regression

## Overview

Regression test for the bug filed at
`doc/08_tracking/bug/interpreter_u32_wrap_subtraction_2026-05-01.md`,
where the Rust seed interpreter held all integer values as `Value::Int(i64)`
with no width tag, so unsigned arithmetic on `u32`-typed expressions did not
wrap modulo 2^32. The classic LZMA range-coder mask
`val mask: u32 = 0u32 - (code >> 31u32)` produced `-1` instead of
`0xFFFFFFFF`.

The fix introduces a `Value::UInt { value: u64, width: u8 }` variant carried
through arithmetic ops in `src/compiler_rust/compiler/src/interpreter/expr/
ops.rs`. Add/Sub/Mul/Neg apply `wrapping_*` at the operand width when at
least one side is `Value::UInt`; bitwise/shift ops preserve UInt-ness so
chains like `(code >> 31u32)` keep their u32 type into the surrounding
subtraction.

This spec exercises:
- u32 subtraction wrap (the LZMA range-coder idiom)
- u32 addition overflow wrap
- u32 multiplication overflow wrap
- u32 negation wrap
- u8 / u16 wrap at narrower widths
- u64 wrap (already worked before by accident — pinned here so a future
  refactor doesn't drop it)
"""

use std.spec.step

import std.spec

describe "u32 wrap arithmetic":
    # @manual scenario evidence
    it "wraps subtraction: 0u32 - 1u32 == 0xFFFFFFFFu32":
        # @req REQ-SSPEC-COMPILER
        step("wraps subtraction: 0u32 - 1u32 == 0xFFFFFFFFu32")
        val r: u32 = 0u32 - 1u32
        expect(r == 0xFFFFFFFFu32).to_equal(true)

    it "wraps subtraction (variable lhs): mask idiom":
        # @req REQ-SSPEC-COMPILER
        step("wraps subtraction (variable lhs): mask idiom")
        val code: u32 = 0x80000000u32
        val mask: u32 = 0u32 - (code >> 31u32)
        expect(mask == 0xFFFFFFFFu32).to_equal(true)

    it "wraps subtraction with zero high-bit: mask idiom":
        # @req REQ-SSPEC-COMPILER
        step("wraps subtraction with zero high-bit: mask idiom")
        val code: u32 = 0x12345678u32
        val mask: u32 = 0u32 - (code >> 31u32)
        expect(mask == 0u32).to_equal(true)

    it "wraps addition: 0xFFFFFFFFu32 + 1u32 == 0u32":
        step("Verify: wraps addition: 0xFFFFFFFFu32 + 1u32 == 0u32")
        # @req: REQ-SSPEC-LOCAL-001
        val r: u32 = 0xFFFFFFFFu32 + 1u32
        expect(r == 0u32).to_equal(true)

    it "wraps multiplication: 0xFFFFu32 * 0x10001u32 == 0xFFFFu32 (low 32 bits)":
        # @req REQ-SSPEC-COMPILER
        step("wraps multiplication: 0xFFFFu32 * 0x10001u32 == 0xFFFFu32 (low 32 bits)")
        # 0xFFFF * 0x10001 = 0xFFFF0000 + 0xFFFF = 0xFFFFFFFF (no wrap needed)
        val r: u32 = 0xFFFFu32 * 0x10001u32
        expect(r == 0xFFFFFFFFu32).to_equal(true)

    it "wraps multiplication overflow: 0x10000u32 * 0x10000u32 == 0u32":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: wraps multiplication overflow: 0x10000u32 * 0x10000u32 == 0u32")
        val r: u32 = 0x10000u32 * 0x10000u32
        expect(r == 0u32).to_equal(true)

describe "u8 / u16 wrap arithmetic":
    it "wraps u8 subtraction: 0u8 - 1u8 == 0xFFu8":
        # @req REQ-SSPEC-COMPILER
        step("wraps u8 subtraction: 0u8 - 1u8 == 0xFFu8")
        val r: u8 = 0u8 - 1u8
        expect(r == 0xFFu8).to_equal(true)

    it "wraps u16 subtraction: 0u16 - 1u16 == 0xFFFFu16":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: wraps u16 subtraction: 0u16 - 1u16 == 0xFFFFu16")
        val r: u16 = 0u16 - 1u16
        expect(r == 0xFFFFu16).to_equal(true)

    it "wraps u8 addition overflow":
        step("Verify: wraps u8 addition overflow")
        # @req: REQ-SSPEC-LOCAL-001
        val r: u8 = 0xFFu8 + 1u8
        expect(r == 0u8).to_equal(true)

describe "u64 wrap arithmetic":
    it "wraps u64 subtraction: 0u64 - 1u64 == 0xFFFFFFFFFFFFFFFFu64":
        # @req REQ-SSPEC-COMPILER
        step("wraps u64 subtraction: 0u64 - 1u64 == 0xFFFFFFFFFFFFFFFFu64")
        val r: u64 = 0u64 - 1u64
        expect(r == 0xFFFFFFFFFFFFFFFFu64).to_equal(true)

    it "wraps u64 addition overflow":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: wraps u64 addition overflow")
        val r: u64 = 0xFFFFFFFFFFFFFFFFu64 + 1u64
        expect(r == 0u64).to_equal(true)

    it "shifts u64 function parameters logically, not arithmetically":
        # @req REQ-SSPEC-COMPILER
        step("shifts u64 function parameters logically, not arithmetically")
        fn shr_param(x: u64, n: u64) -> u64:
            x >> n

        fn shr_local() -> u64:
            val x: u64 = 0xCBBB9D5DC1059ED8u64
            x >> 28u64

        expect(shr_param(0xCBBB9D5DC1059ED8u64, 28u64) == 0xCBBB9D5DCu64).to_equal(true)
        expect(shr_local() == 0xCBBB9D5DCu64).to_equal(true)

describe "signed integer arithmetic (no regression)":
    it "i64 subtraction stays signed: 0 - 1 == -1":
        # @req REQ-SSPEC-COMPILER
        step("i64 subtraction stays signed: 0 - 1 == -1")
        val r: i64 = 0 - 1
        expect(r == -1).to_equal(true)

    it "i32 cast keeps signed semantics: (-1 as i32) is still -1":
        # @req REQ-SSPEC-COMPILER
        step("i32 cast keeps signed semantics: (-1 as i32) is still -1")
        val n: i64 = -1
        val r: i32 = n.to_i32()
        expect(r == -1).to_equal(true)

    it "mixed i64 + u32 is governed by u32 wrap (UInt-wins)":
        # @req REQ-SSPEC-COMPILER
        step("mixed i64 + u32 is governed by u32 wrap (UInt-wins)")
        # Cross-variant: when one operand is UInt, the wrap-width applies.
        # This documents the chosen semantics; if/when a stricter type rule
        # rejects mixed arithmetic, this spec should be updated together.
        val u: u32 = 1u32
        val s: i64 = 0
        val r: u32 = (s.to_u32()) - u
        expect(r == 0xFFFFFFFFu32).to_equal(true)
