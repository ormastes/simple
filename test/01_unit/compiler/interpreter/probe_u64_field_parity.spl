# Run-path probe (u64 > i64 max field store/compare) for class_ref_interp_jit_consistency_spec.spl.
class U64Box:
    v: u64
fn main():
    var big = U64Box(v: 0xFFFF_FFFF_FFFF_FFF0)
    print "a={big.v == 0xFFFF_FFFF_FFFF_FFF0}"
    print "b={big.v > 5}"
    big.v = 0xFFFF_FFFF_FFFF_FFF1
    print "c={big.v > 0xFFFF_FFFF_FFFF_FFF0}"
    print "d={big.v}"
main()
