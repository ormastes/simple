# @req: REQ-COMPILER-INTERPRETER-001

use std.spec.{describe, it, expect}

use std.spec.step

describe "self-hosted interpreter string interpolation":
    it "evaluates variables expressions and multiple regions":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: evaluates variables expressions and multiple regions")
        val a = 2
        val b = 3
        val words = ["a", "b"]

        expect("bare={a}").to_equal("bare=2")
        expect("expr={a + b}").to_equal("expr=5")
        expect("nested {a} and {b}").to_equal("nested 2 and 3")
        expect("joined={words.join("-")}").to_equal("joined=a-b")
        expect("{{literal}} {a}").to_equal("{literal} 2")

    it "keeps escaped and non-expression braces literal":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: keeps escaped and non-expression braces literal")
        val escaped = "{{not interpolation}}"
        val css = "{ color: red; }"
        val mixed_invalid = "before {value} then { color: red; }"
        val after = 9

        expect(escaped).to_equal("{" + "not interpolation" + "}")
        expect(css).to_equal("{" + " color: red; " + "}")
        expect(mixed_invalid).to_equal(
            "before " + "{value}" + " then " + "{ color: red; }"
        )
        expect(after).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "does not interpolate raw strings":
        # @req: REQ-COMPILER-INTERPRETER-001
        step("Verify: does not interpolate raw strings")
        val value = 7
        val raw = r"{value}"

        expect(raw).to_equal("{" + "value" + "}")
