# `for e in List<T>` must iterate under the JIT lane too (it used to iterate
# ZERO times, silently). The probe runs as a subprocess in each engine and both
# must report the same sum. interp_for_over_list_generic_2026-07-02.
use std.spec.*
use std.io_runtime.{process_run, env_get}

val PROBE_PATH: text = "test/01_unit/compiler/interpreter/probe_for_over_list_class.spl"

fn run_probe_in_mode(mode: text) -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = "SIMPLE_RUST_SEED_WARNING=0 SIMPLE_EXECUTION_MODE=" + mode + " " +
        bin + " run " + PROBE_PATH + " 2>/dev/null"
    val out = process_run("sh", ["-c", cmd])
    out.0

describe "for over List<T> class value in both engines":
    it "sums the elements under the interpreter":
        val out = run_probe_in_mode("interpreter")
        expect(out).to_contain("FOR_LIST_SUM=7")
        expect(out).to_contain("FOR_LIST_EMPTY=0")

    it "sums the same elements under the JIT":
        val out = run_probe_in_mode("jit")
        expect(out).to_contain("FOR_LIST_SUM=7")
        expect(out).to_contain("FOR_LIST_EMPTY=0")
