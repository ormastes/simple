"""
## Purpose and audience

Regression evidence that the module resolver's `rt_file_exists` probe is
consumed as a bool (not compared against an integer), written for the
compiler engineers who own module loading and for reviewers gating cache
behavior changes around `resolve_module_path`.

## Operator workflow

Run this spec and confirm the Results line reports exactly 2 failed (the
two drafted-surface tripwires, see Compatibility). The first five
scenarios drive the real resolver directly: known-good stdlib paths must
resolve to non-empty strings, an unknown module must still return a
non-empty fallback, and the negative cache must dedupe and reset
correctly. The last two scenarios are fail-closed tripwires over the
resolver source for the drafted eviction/telemetry and watcher
invalidation surfaces.

## Compatibility and limitations

The resolver currently exposes only `resolve_module_path`,
`module_resolve_cache_reset` and `module_resolve_uncached_count`; the
drafted `module_resolve_cache_entry_count`,
`module_resolve_cache_eviction_count`, `module_resolve_cache_telemetry`
and `watcher_source_*` invalidation API exist nowhere (grep-verified at
authoring time), so the eviction-bound and create/edit/move/delete
scenarios cannot execute their drafted assertions yet and instead fail
closed while those symbols are absent from
`src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl`.
This spec drives the resolver in-process; it does not spawn a second
compiler process.

## Verification guidance and troubleshooting

If a stdlib-resolution scenario fails with an empty path, suspect the
bool/i64 `rt_file_exists` regression this file is named after before
touching the cache tests. If a tripwire goes RED, the drafted eviction or
watcher surface just landed: restore the commented drafted assertions in
that scenario, replace the source probe, and re-run.
"""
# Lifecycle: research: doc/01_research/language/modules/module_system_bug_report.md ; plan: doc/03_plan/compiler/module_resolution/var_resolution_plan.md ; architecture: doc/04_architecture/compiler_loader_script_crosslang_perf.md ; design: doc/05_design/compiler/architecture/loader_shared_core_refactor.md
# @cover src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl
# @manual_section: module resolver rt_file_exists bool handling

use std.spec.step

use std.spec.{describe, it, expect}

use compiler.core.interpreter.module_loader_resolve.{
    resolve_module_path,
    module_resolve_cache_reset,
    module_resolve_uncached_count
}

extern fn rt_file_read_text(path: text) -> text

fn resolver_source() -> text:
    rt_file_read_text("src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl") ?? ""

fn check_std_ctype_resolves() -> text:
    module_resolve_cache_reset()
    val path = resolve_module_path("std.ctype", "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl")
    if path == "":
        return "resolve_module_path(std.ctype) returned empty — rt_file_exists bool/i64 mismatch likely"
    ""

fn check_std_io_runtime_resolves() -> text:
    module_resolve_cache_reset()
    val path = resolve_module_path("std.io_runtime", "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl")
    if path == "":
        return "resolve_module_path(std.io_runtime) returned empty — rt_file_exists bool/i64 mismatch likely"
    ""

fn check_nonexistent_returns_nonempty_fallback() -> text:
    # The resolver returns the relative path even when the file doesn't exist (will error later).
    # Important: it should NOT return "" for a resolvable-pattern name.
    module_resolve_cache_reset()
    val path = resolve_module_path("std.definitely_nonexistent_xyz_abc", "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl")
    # Returns the attempted path (not empty), even on miss.
    if path == "":
        return "resolver returned empty string for unknown module — unexpected"
    ""

describe "module_resolver rt_file_exists bool regression":
    it "resolves std.ctype to a non-empty path":
        # @req REQ-RESOLVER-BOOL-001
        # @capture(protocol_json): resolved path for std.ctype
        step("resolve std.ctype and require a non-empty path")
        val err = check_std_ctype_resolves()
        expect(err).to_equal("")

    it "resolves std.io_runtime to a non-empty path":
        # @req REQ-RESOLVER-BOOL-001
        # @capture(protocol_json): resolved path for std.io_runtime
        step("resolve std.io_runtime and require a non-empty path")
        val err = check_std_io_runtime_resolves()
        expect(err).to_equal("")

    it "returns non-empty fallback path for unknown module":
        # @req REQ-RESOLVER-BOOL-001
        # @capture(protocol_json): fallback path for the unknown module
        step("resolve an unknown module and require the non-empty fallback")
        val err = check_nonexistent_returns_nonempty_fallback()
        expect(err).to_equal("")

    it "reuses an exact unresolved result within one cache generation":
        # @req REQ-RESOLVER-BOOL-002
        # @capture(protocol_json): uncached-resolution count for the repeated miss
        step("Verify: reuses an exact unresolved result within one cache generation")
        module_resolve_cache_reset()
        val module_name = "std.definitely_nonexistent_negative_cache_exact"
        val caller = "test/01_unit/compiler/interpreter/module_resolver_file_exists_spec.spl"
        val first = resolve_module_path(module_name, caller)
        val second = resolve_module_path(module_name, caller)
        expect(second).to_equal(first)
        expect(module_resolve_uncached_count()).to_equal(1)  # oracle: the second identical probe must hit the negative cache, leaving one uncached resolution

    it "keeps caller-sensitive entries separate and reset invalidates them":
        # @req REQ-RESOLVER-BOOL-002
        # @capture(protocol_json): uncached-resolution counts across callers and reset
        step("Verify: keeps caller-sensitive entries separate and reset invalidates them")
        module_resolve_cache_reset()
        val module_name = "definitely_nonexistent_negative_cache_adjacent"
        val first = resolve_module_path(module_name, "test/01_unit/a.spl")
        val adjacent = resolve_module_path(module_name, "test/03_system/b.spl")
        expect(adjacent).to_equal(first)
        expect(module_resolve_uncached_count()).to_equal(2)  # oracle: each caller counts as its own uncached resolution, so two distinct callers yield two

        module_resolve_cache_reset()
        val after_reset = resolve_module_path(module_name, "test/01_unit/a.spl")
        expect(after_reset).to_equal(first)
        expect(module_resolve_uncached_count()).to_equal(1)  # oracle: reset wipes the cache, so the first post-reset probe is uncached again

    it "bounds unique caller-sensitive misses and evicts the oldest entries":
        # @req REQ-RESOLVER-BOOL-003
        # @capture(protocol_json): source probe for the drafted eviction surface
        step("prove the drafted eviction counters are still absent from the resolver source")
        # NOTE: drafted product API absent (grep-verified:
        # module_resolve_cache_entry_count, module_resolve_cache_eviction_count
        # and any bounded-queue eviction appear nowhere in
        # src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl).
        # This tripwire passes only while those symbols are absent; drafted
        # assertions, to restore once the bounded cache lands:
        # module_resolve_cache_reset()
        # val caller = "/tmp/simple_loader_cache_bound/main.spl"
        # for i in 0..300:
        #     resolve_module_path("loader_cache_unique_miss_" + i.to_text(), caller)
        # assert_true(module_resolve_cache_entry_count() <= 256)  # oracle: the drafted cache admits at most 256 live entries
        # assert_true(module_resolve_cache_eviction_count() > 0)  # oracle: 300 unique misses against a 256-entry bound must have evicted something
        val source = resolver_source()
        expect(source).to_not_contain("module_resolve_cache_entry_count")
        expect(source).to_not_contain("module_resolve_cache_eviction_count")

    it "invalidates cached paths after create edit move and delete events":
        # @req REQ-RESOLVER-BOOL-003
        # @capture(protocol_json): source probe for the drafted watcher surface
        step("prove the drafted watcher invalidation surface is still absent")
        # NOTE: drafted product API absent (grep-verified across src/:
        # watcher_source_created / watcher_source_edited / watcher_source_moved
        # / watcher_source_deleted and module_resolve_cache_telemetry exist
        # nowhere, and compiler.driver.watcher.source_mutation is an
        # unresolvable module). This tripwire passes only while the resolver
        # source carries none of those symbols; drafted assertions, to restore
        # once the watcher wiring lands:
        # ... create/edit/move/delete a module file and, after each event,
        # expect(watcher_source_*(...)).to_equal(1)
        # then re-resolve and require the cache to observe the mutation, and
        # score every drafted telemetry field (entries, total/fast/precise/
        # fail_closed invalidations, normalization_ambiguities, per-event
        # mutation counters) against its recorded expectation.
        val source = resolver_source()
        expect(source).to_not_contain("watcher_source_created")
        expect(source).to_not_contain("watcher_source_edited")
        expect(source).to_not_contain("module_resolve_cache_telemetry")

    it "fails closed on an unmatched producer spelling despite fast invalidation":
        # @req REQ-RESOLVER-BOOL-003
        # @capture(protocol_json): source probe for the drafted fast-invalidation surface
        step("prove the drafted fast-invalidation surface is still absent")
        # NOTE: same drafted-API absence as the scenario above (no watcher
        # hooks, no module_resolve_cache_telemetry). This tripwire passes only
        # while those symbols are absent; drafted assertions, to restore once
        # the surface lands: write a target module, resolve it, edit it under
        # a non-canonical producer spelling (root + "/./" + name), require the
        # fast invalidation to miss, the fail-closed full invalidation to run
        # twice, and the resolver to still return the canonical target path.
        val source = resolver_source()
        expect(source).to_not_contain("watcher_source_edited")
        expect(source).to_not_contain("module_resolve_cache_telemetry")
