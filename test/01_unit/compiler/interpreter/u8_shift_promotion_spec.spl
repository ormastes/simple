# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# u8 << n promotes to a wider integer (C-style); it must not be narrowed back to u8.

use std.spec.step

use std.spec.*

fn shift_first(d: [u8]) -> i64:
    val b0 = d[0]
    val s = b0 << 8
    s

fn varint2(d: [u8]) -> i64:
    val first = d[0]
    val b1 = d[1]
    val v = ((first & 0x3f) << 8) | b1
    v

describe "u8 shift promotion":
    it "u8 << 8 is not narrowed to u8":
        # @req REQ-SSPEC-COMPILER
        step("u8 << 8 is not narrowed to u8")
        val b0: u8 = 1
        val s = b0 << 8
        expect(s).to_equal(256)

    it "u8 element << 8 keeps high bits":
        # @req REQ-SSPEC-COMPILER
        step("u8 element << 8 keeps high bits")
        expect(shift_first([64u8])).to_equal(16384)

    it "shifted u8 or-ed with another u8 is not re-narrowed (varint decode shape)":
        # @req REQ-SSPEC-COMPILER
        step("shifted u8 or-ed with another u8 is not re-narrowed (varint decode shape)")
        expect(varint2([0x7fu8, 0x01u8])).to_equal(16129)
        expect(varint2([0x50u8, 0x34u8])).to_equal(4148)
