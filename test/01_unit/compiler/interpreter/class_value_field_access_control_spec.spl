"""
## Purpose and audience
Purpose: Prove that aggregate field access defect class.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERPRETER-001 — stable requirement identity for this spec.

# Defect-class spec with POSITIVE CONTROLS for the ClassInstance field-access
# fix: value-identity `struct` values (Value::Object) and nested/optional
# aggregates must keep working exactly as before, so the fix is not a blanket
# change to aggregate field access.
use std.spec

struct PlainPoint:
    x: i64
    y: i64

class RefBox:
    inner: PlainPoint
    label: text

    fn describe() -> text:
        "{self.label}:{self.inner.x}"

fn struct_field() -> i64:
    val p = PlainPoint(x: 7, y: 9)
    p.x + p.y

fn struct_in_class_field() -> i64:
    val b = RefBox(inner: PlainPoint(x: 5, y: 6), label: "b")
    b.inner.y

fn class_method_reading_struct_field() -> text:
    val b = RefBox(inner: PlainPoint(x: 5, y: 6), label: "b")
    b.describe()

fn class_field_write_then_read() -> i64:
    var b = RefBox(inner: PlainPoint(x: 1, y: 2), label: "m")
    b.label = "changed"
    b.inner.x

describe "aggregate field access defect class":
    it "positive control: struct fields still read":
        step("Verify: positive control: struct fields still read")
        # @req: REQ-COMPILER-INTERPRETER-001
        expect(struct_field()).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "reads a struct field nested inside a class":
        step("Verify: reads a struct field nested inside a class")
        expect(struct_in_class_field()).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "a class method reads its own struct-typed field":
        step("Verify: a class method reads its own struct-typed field")
        expect(class_method_reading_struct_field()).to_equal("b:5")

    it "field write on a class does not break subsequent reads":
        step("Verify: field write on a class does not break subsequent reads")
        expect(class_field_write_then_read()).to_equal(1)  # oracle: 1 — named expected value from the requirement
