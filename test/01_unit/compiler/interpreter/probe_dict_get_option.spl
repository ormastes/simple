# Run-path probe (Dict.get -> Option: hit/miss for text/class/struct) for class_ref_interp_jit_consistency_spec.spl.
class Inner:
    v: i64
struct Pt:
    x: i64
fn tag_t(o: text?) -> text:
    match o:
        Some(s): "some:" + s
        None: "none"
fn tag_c(o: Inner?) -> text:
    match o:
        Some(c): "some:{c.v}"
        None: "none"
fn tag_p(o: Pt?) -> text:
    match o:
        Some(p): "some:{p.x}"
        None: "none"
fn main():
    val dt = {"a": "hello"}
    val dc = {"a": Inner(v: 7)}
    val dp = {"a": Pt(x: 9)}
    print "t1={tag_t(dt.get("a"))}"
    print "t2={tag_t(dt.get("zz"))}"
    print "c1={tag_c(dc.get("a"))}"
    print "c2={tag_c(dc.get("zz"))}"
    print "p1={tag_p(dp.get("a"))}"
    print "p2={tag_p(dp.get("zz"))}"
main()
