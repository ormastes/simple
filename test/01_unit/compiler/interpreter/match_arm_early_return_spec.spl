# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# match arm early-return propagation spec
##
# Regression for bug: interp_match_or_pattern_early_return_swallowed_2026-06-13
# Root cause: exec_block_fn used exec_if_expr/exec_match_expr for last-statement
# if/match nodes, which collapsed Control::Return into a plain value instead
# of propagating the early return to the enclosing function.
# Fix: use exec_if_core/exec_match_core which preserve Control::Return.
##
# Finding: the bug affects ALL pattern kinds (not just or-patterns) when the
# arm's last statement is an if/match containing an explicit return.

use std.spec

enum Dir:
    North
    South
    East
    West

fn or_pattern_if_return(d: Dir) -> i64:
    match d:
        case Dir.North | Dir.South:
            if true:
                return 1
    return 0

fn single_pattern_if_return(d: Dir) -> i64:
    match d:
        case Dir.North:
            if true:
                return 1
    return 0

fn arm_value_no_return(d: Dir) -> i64:
    match d:
        case Dir.North | Dir.South: 42
        case _: 0

fn false_cond_fallthrough(d: Dir) -> i64:
    match d:
        case Dir.North | Dir.South:
            if false:
                return 1
    return 0

fn nested_match_return(d: Dir) -> i64:
    match d:
        case Dir.North | Dir.South:
            match d:
                case Dir.North: return 10
                case _: return 20
    return 0

describe "match arm early-return propagation":

    it "or-pattern first variant: explicit return inside if propagates":
        # @req REQ-SSPEC-UNIT
        step("or-pattern first variant: explicit return inside if propagates")
        expect(or_pattern_if_return(Dir.North)).to_equal(1)

    it "or-pattern second variant: explicit return inside if propagates":
        # @req REQ-SSPEC-UNIT
        step("or-pattern second variant: explicit return inside if propagates")
        expect(or_pattern_if_return(Dir.South)).to_equal(1)

    it "or-pattern: non-matching arm falls through to post-match return":
        # @req REQ-SSPEC-UNIT
        step("or-pattern: non-matching arm falls through to post-match return")
        expect(or_pattern_if_return(Dir.East)).to_equal(0)

    it "single-pattern: explicit return inside if propagates":
        # @req REQ-SSPEC-UNIT
        step("single-pattern: explicit return inside if propagates")
        expect(single_pattern_if_return(Dir.North)).to_equal(1)

    it "single-pattern: non-matching falls through":
        # @req REQ-SSPEC-UNIT
        step("single-pattern: non-matching falls through")
        expect(single_pattern_if_return(Dir.South)).to_equal(0)

    it "arm value with no early return still works correctly":
        # @req REQ-SSPEC-UNIT
        step("arm value with no early return still works correctly")
        expect(arm_value_no_return(Dir.North)).to_equal(42)
        expect(arm_value_no_return(Dir.East)).to_equal(0)

    it "false if-condition: arm does not return, falls through":
        # @req REQ-SSPEC-UNIT
        step("false if-condition: arm does not return, falls through")
        expect(false_cond_fallthrough(Dir.North)).to_equal(0)

    it "nested match as last statement: return propagates":
        # @req REQ-SSPEC-UNIT
        step("nested match as last statement: return propagates")
        expect(nested_match_return(Dir.North)).to_equal(10)
        expect(nested_match_return(Dir.South)).to_equal(20)
