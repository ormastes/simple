"""
Binding a class-typed field to a local preserves class identity.

Regression for interpreter_binding_class_typed_field_snapshots_instead_of_aliasing_2026-08-10.
The local `mid` and `root.inner` must refer to the same class instance.
"""

use std.spec.*

class AliasCell:
    var n: i64

    me bump():
        self.n = self.n + 1

class AliasMiddle:
    var cell: AliasCell

class AliasRoot:
    var inner: AliasMiddle

describe "class-typed field binding identity":
    it "observes mutation through a local alias of a nested class field":
        val root = AliasRoot(inner: AliasMiddle(cell: AliasCell(n: 0)))
        val mid = root.inner
        mid.cell.bump()
        expect(mid.cell.n).to_equal(1)
        expect(root.inner.cell.n).to_equal(1)
