# @req REQ-SSPEC-COMPILER
"""
Prevention for bug interp_class_name_collision_breaks_test_db_persistence_2026-08-10:
same-name struct / class / trait declarations in two co-loaded modules must each
resolve to their own declaring module's layout, and a braced import of one
module's symbols must not replace the importer's same-named type.
"""
use std.spec.step
use std.spec.*
use test.fixtures.flat_fn_shadow.struct_a.{Pair, pair_a_sum}
use test.fixtures.flat_fn_shadow.struct_b.{pair_b_text}
use test.fixtures.flat_fn_shadow.trait_a.{Square}
use test.fixtures.flat_fn_shadow.trait_b.{circle_b_label}

describe "same-name type collisions across co-loaded modules":
    it "struct: importer constructs its own Pair, other module keeps its Pair":
        step("construct struct_a Pair after struct_b was co-loaded")
        val p = Pair(left: 7)
        expect(pair_a_sum(p)).to_equal(7)
        expect(pair_b_text()).to_equal("B")
    it "trait: same-name trait in two modules dispatches each impl":
        expect(Square(side: 3).area()).to_equal(9)
        expect(circle_b_label()).to_equal("circle b")
