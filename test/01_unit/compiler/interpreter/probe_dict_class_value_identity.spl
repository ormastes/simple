# Run-path probe: class instances reached through a container have REFERENCE
# semantics — every read yields the same handle, so a mutation through any
# handle is visible through the container and the caller. `struct` values keep
# VALUE semantics: a read is a copy and the original is untouched.
#
# Oracle for test/01_unit/compiler/interpreter/dict_class_value_identity_spec.spl
# (doc/08_tracking/bug/interp_dict_class_value_copy_on_get_mutation_loss_2026-07-06.md).
#
# Contract: doc/05_design/compiler/interpreter/class_instance_reference_storage_2026-11-03.md
# ("`class` values are reference types: one heap cell, many handles; `struct`
# values are value types"). This supersedes the 2026-09-27 value-type ruling the
# earlier version of this probe asserted; the interpreter's reference carrier
# (`Value::ClassInstance`) is the default since 2026-11-04. Every expected
# value is an absolute literal; each check pins BOTH halves — the handle did
# change AND the container sees it (class) / does not (struct) — so a probe
# that mutates nothing cannot pass.

class Cache:
    hits: i64
    last: text

class Host:
    caches: Dict<i64, Cache>

struct Counter:
    n: i64

var failures: i64 = 0

fn check(name: text, got: i64, want: i64):
    if got == want:
        print("PASS " + name)
    else:
        print("FAIL " + name + " got=" + got.to_text() + " want=" + want.to_text())
        failures = failures + 1

fn check_text(name: text, got: text, want: text):
    if got == want:
        print("PASS " + name)
    else:
        print("FAIL " + name + " got=" + got + " want=" + want)
        failures = failures + 1

fn bump(h: Host, id: i64) -> i64:
    val c = h.caches.get(id)
    c.hits = c.hits + 1
    c.last = "seen"
    c.hits

fn main():
    # 1. The report's repro sketch: get, mutate, get again. The fetched handle
    #    is the dict entry, so the mutation is visible through the dict.
    var d: Dict<i64, Cache> = {}
    d.set(1, Cache(hits: 0, last: "none"))
    val c = d.get(1)
    c.hits = 5
    check("dict_get_handle_mutated", c.hits, 5)
    check("dict_get_entry_shared", d.get(1).hits, 5)
    c.last = "seen"
    check_text("dict_get_entry_text_shared", d.get(1).last, "seen")

    # 2. An explicit write-back is a no-op on a shared handle (no double count).
    d.set(1, c)
    check("dict_write_back_idempotent", d.get(1).hits, 5)

    # 3. text-keyed dict — the key type must not change reference semantics.
    var dt: Dict<text, Cache> = {}
    dt.set("k", Cache(hits: 10, last: "a"))
    val ct = dt.get("k")
    ct.hits = 99
    check("dict_text_key_handle_mutated", ct.hits, 99)
    check("dict_text_key_entry_shared", dt.get("k").hits, 99)

    # 4. Dict held as a FIELD, mutated inside a CALLEE: the callee mutates the
    #    shared cell, so the caller's object observes every bump.
    var hd: Dict<i64, Cache> = {}
    hd.set(7, Cache(hits: 0, last: "none"))
    val h = Host(caches: hd)
    check("callee_handle_mutated", bump(h, 7), 1)
    check("callee_handle_mutated_again", bump(h, 7), 2)
    check("callee_field_dict_hits_shared", h.caches.get(7).hits, 2)
    check_text("callee_field_dict_last_shared", h.caches.get(7).last, "seen")

    # 5. Same question via an ARRAY element rather than a dict.
    val arr: [Cache] = [Cache(hits: 1, last: "x")]
    val ae = arr[0]
    ae.hits = 42
    check("array_elem_handle_mutated", ae.hits, 42)
    check("array_elem_entry_shared", arr[0].hits, 42)

    # 6. Two reads of the same key are two handles on one cell.
    var d2: Dict<i64, Cache> = {}
    d2.set(3, Cache(hits: 0, last: "n"))
    val h1 = d2.get(3)
    val h2 = d2.get(3)
    h1.hits = 77
    check("two_handles_first_mutated", h1.hits, 77)
    check("two_handles_second_shared", h2.hits, 77)

    # 7. Plain assignment aliases too: `val b = a`.
    val a = Cache(hits: 3, last: "a")
    val b = a
    b.hits = 4
    check("val_assign_handle_mutated", b.hits, 4)
    check("val_assign_original_shared", a.hits, 4)

    # 8. `struct` stays a value type: the same shapes COPY.
    var ds: Dict<i64, Counter> = {}
    ds.set(1, Counter(n: 0))
    val sc = ds.get(1)
    sc.n = 5
    check("struct_dict_get_copy_mutated", sc.n, 5)
    check("struct_dict_get_original_unchanged", ds.get(1).n, 0)
    val sa = Counter(n: 3)
    val sb = sa
    sb.n = 4
    check("struct_val_assign_copy_mutated", sb.n, 4)
    check("struct_val_assign_original_unchanged", sa.n, 3)

    if failures == 0:
        print("DICT_CLASS_VALUE PROBE: ALL PASS")
    else:
        print("DICT_CLASS_VALUE PROBE: FAILURES=" + failures.to_text())
