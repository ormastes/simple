# Run-path probe: class instances reached through a container have VALUE
# semantics — every read is a copy, and a mutation through that copy never
# reaches the container (or the caller) unless it is written back.
#
# Oracle for test/01_unit/compiler/interpreter/dict_class_value_identity_spec.spl
# (doc/08_tracking/bug/interp_dict_class_value_copy_on_get_mutation_loss_2026-07-06.md).
#
# Owner ruling 2026-09-27: classes are value types
# (doc/07_guide/language/capability_library_authoring.md:33 — "`val b = a`
# copies"). The earlier version of this probe asserted reference identity and
# was retargeted. Every expected value is an absolute literal; each check pins
# BOTH halves — the copy did change, the original did not — so a probe that
# mutates nothing cannot pass.

class Cache:
    hits: i64
    last: text

class Host:
    caches: Dict<i64, Cache>

var failures: i64 = 0

fn check(name: text, got: i64, want: i64):
    if got == want:
        print("PASS " + name)
    else:
        print("FAIL " + name + " got=" + got.to_text() + " want=" + want.to_text())
        failures = failures + 1

fn check_text(name: text, got: text, want: text):
    if got == want:
        print("PASS " + name)
    else:
        print("FAIL " + name + " got=" + got + " want=" + want)
        failures = failures + 1

fn bump(h: Host, id: i64) -> i64:
    val c = h.caches.get(id)
    c.hits = c.hits + 1
    c.last = "seen"
    c.hits

fn main():
    # 1. The report's repro sketch: get, mutate, get again. The fetched copy
    #    changes; the dict entry does not.
    var d: Dict<i64, Cache> = {}
    d.set(1, Cache(hits: 0, last: "none"))
    val c = d.get(1)
    c.hits = 5
    check("dict_get_copy_mutated", c.hits, 5)
    check("dict_get_original_unchanged", d.get(1).hits, 0)
    check_text("dict_get_original_text_unchanged", d.get(1).last, "none")

    # 2. The documented write-back idiom is how a mutation persists.
    d.set(1, c)
    check("dict_write_back_persists", d.get(1).hits, 5)

    # 3. text-keyed dict — the key type must not change value semantics.
    var dt: Dict<text, Cache> = {}
    dt.set("k", Cache(hits: 10, last: "a"))
    val ct = dt.get("k")
    ct.hits = 99
    check("dict_text_key_copy_mutated", ct.hits, 99)
    check("dict_text_key_original_unchanged", dt.get("k").hits, 10)

    # 4. Dict held as a FIELD, mutated inside a CALLEE: the callee works on a
    #    copy, so the caller's object is untouched.
    var hd: Dict<i64, Cache> = {}
    hd.set(7, Cache(hits: 0, last: "none"))
    val h = Host(caches: hd)
    check("callee_copy_mutated", bump(h, 7), 1)
    check("callee_copy_mutated_again", bump(h, 7), 1)
    check("callee_field_dict_hits_unchanged", h.caches.get(7).hits, 0)
    check_text("callee_field_dict_last_unchanged", h.caches.get(7).last, "none")

    # 5. Same question via an ARRAY element rather than a dict.
    val arr: [Cache] = [Cache(hits: 1, last: "x")]
    val ae = arr[0]
    ae.hits = 42
    check("array_elem_copy_mutated", ae.hits, 42)
    check("array_elem_original_unchanged", arr[0].hits, 1)

    # 6. Two reads of the same key are two independent copies.
    var d2: Dict<i64, Cache> = {}
    d2.set(3, Cache(hits: 0, last: "n"))
    val h1 = d2.get(3)
    val h2 = d2.get(3)
    h1.hits = 77
    check("two_handles_first_mutated", h1.hits, 77)
    check("two_handles_second_independent", h2.hits, 0)

    # 7. Plain assignment copies too: `val b = a`.
    val a = Cache(hits: 3, last: "a")
    val b = a
    b.hits = 4
    check("val_assign_copy_mutated", b.hits, 4)
    check("val_assign_original_unchanged", a.hits, 3)

    if failures == 0:
        print("DICT_CLASS_VALUE PROBE: ALL PASS")
    else:
        print("DICT_CLASS_VALUE PROBE: FAILURES=" + failures.to_text())
