"""
## Purpose and audience
Purpose: Prove that a declared extern fn can be passed by name as a function value.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERPRETER-001 — stable requirement identity for this spec.

use std.spec

extern fn rt_pool_get_parallelism() -> i64

fn extern_value_call(f: fn() -> i64) -> i64:
    f()

describe "extern fn as a first-class value":
    it "calls an extern fn passed by name":
        expect(extern_value_call(rt_pool_get_parallelism)).to_equal(rt_pool_get_parallelism())
