"""
## Purpose and audience
Purpose: Prove that nested string split dispatch.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERPRETER-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}

describe "nested string split dispatch":
    it "splits a temporary string receiver":
        step("Verify: splits a temporary string receiver")
        # @req: REQ-COMPILER-INTERPRETER-001
        val parts = " a,b ".trim().split(",")

        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("a")
        expect(parts[1]).to_equal("b")

    it "honors a two-part split limit on a temporary receiver":
        step("Verify: honors a two-part split limit on a temporary receiver")
        val parts = "a:b:c".split(":", 2)

        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("a")
        expect(parts[1]).to_equal("b:c")

    it "keeps the complete value when the split limit is one":
        step("Verify: keeps the complete value when the split limit is one")
        val parts = "a:b:c".split(":", 1)

        expect(parts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(parts[0]).to_equal("a:b:c")

    it "preserves a value without the requested separator":
        step("Verify: preserves a value without the requested separator")
        val parts = "abc".split(":", 2)

        expect(parts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(parts[0]).to_equal("abc")

    it "applies the same limit when splitting into characters":
        step("Verify: applies the same limit when splitting into characters")
        val parts = "abc".split("", 2)

        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("a")
        expect(parts[1]).to_equal("bc")

    it "passes a variable split limit as a numeric operand":
        step("Verify: passes a variable split limit as a numeric operand")
        val limit = 2
        val parts = "a:b:c".split(":", limit)

        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("a")
        expect(parts[1]).to_equal("b:c")

    it "preserves unicode around a multibyte delimiter at the limit":
        step("Verify: preserves unicode around a multibyte delimiter at the limit")
        val parts = "한글::테스트::끝".split("::", 2)

        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("한글")
        expect(parts[1]).to_equal("테스트::끝")
