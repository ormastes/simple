# @req REQ-SSPEC-COMPILER
# @tag:in-development
"""
OPEN bug interp_class_name_collision_breaks_test_db_persistence_2026-08-10:
the seed interpreter registers classes by BARE name, so constructing module A's
`Interner(n: 3)` after module B's same-named class was co-loaded fails with
`class Interner has no field named label` (B's layout wins). Expected to FAIL
until classes are keyed per owning module.
"""
use std.spec.step
use std.spec.*
use test.fixtures.flat_fn_shadow.cls_a.{Interner}
use test.fixtures.flat_fn_shadow.cls_b.{tag_b}

describe "same-name classes in two co-loaded modules":
    it "constructs and dispatches the importing module's own class":
        step("construct cls_a Interner with its own field")
        val a = Interner(n: 3)
        expect(a.tag()).to_equal("A")
        expect(a.n).to_equal(3)
    it "other module's class still resolves to its own layout":
        expect(tag_b()).to_equal("B!")
