# Element writes into `mut xs: [T]` parameters must reach the caller for every
# element storage kind, including packed `[u8]` (Value::ByteArray).
# Bug: doc/08_tracking/bug/seed_interp_mut_u8_array_param_element_write_lost_2026-11-04.md
use std.spec.*

fn set_u8(mut xs: [u8]):
    xs[1] = 200u8
fn set_i32(mut xs: [i32]):
    xs[1] = 7i32
fn set_f64(mut xs: [f64]):
    xs[1] = 2.5
fn set_bool(mut xs: [bool]):
    xs[1] = true
fn set_i64(mut xs: [i64]):
    xs[1] = 9
fn outer_u8(mut xs: [u8]):
    set_u8(xs)
fn outer_i64(mut xs: [i64]):
    set_i64(xs)
fn set_u8_at(mut xs: [u8], base: i64):
    xs[base * 2 + 1] = 42u8
fn fill_meta_and_pixels(mut meta: [i64], mut pixels: [u8]):
    var i: i64 = 0
    while i < pixels.len():
        pixels[i] = 200u8
        i = i + 1
    meta[0] = 7

describe "mut array param element write":
    it "writes back [u8]":
        var xs: [u8] = [0u8; 3]
        set_u8(xs)
        expect(xs[1]).to_equal(200u8)
    it "writes back [i32]":
        var xs: [i32] = [0i32, 0i32, 0i32]
        set_i32(xs)
        expect(xs[1]).to_equal(7i32)
    it "writes back [f64]":
        var xs: [f64] = [0.0, 0.0, 0.0]
        set_f64(xs)
        expect(xs[1]).to_equal(2.5)
    it "writes back [bool]":
        var xs: [bool] = [false, false, false]
        set_bool(xs)
        expect(xs[1]).to_equal(true)
    it "writes back [i64]":
        var xs: [i64] = [0; 3]
        set_i64(xs)
        expect(xs[1]).to_equal(9)
    it "writes back through call depth 2":
        var b: [u8] = [0u8; 3]
        outer_u8(b)
        var w: [i64] = [0; 3]
        outer_i64(w)
        expect(b[1]).to_equal(200u8)
        expect(w[1]).to_equal(9)
    it "writes back via an index expression":
        var xs: [u8] = [0u8; 6]
        set_u8_at(xs, 2)
        expect(xs[5]).to_equal(42u8)
    it "writes back mixed [i64] and [u8] params":
        var m: [i64] = [0; 4]
        var p: [u8] = [0u8; 5]
        fill_meta_and_pixels(m, p)
        expect(m[0]).to_equal(7)
        expect(p[0]).to_equal(200u8)
        expect(p[4]).to_equal(200u8)
