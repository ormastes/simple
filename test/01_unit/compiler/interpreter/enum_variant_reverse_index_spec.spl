"""
## Purpose and audience
Purpose: Pin the interpreter enum-variant reverse index across its state transitions.
Audience: compiler engineers maintaining interpreter pattern classification.
"""

use compiler.core.interpreter.eval_tables.{
    enum_table_register,
    enum_table_remove,
    enum_table_reset,
    enum_variant_is_declared
}
use compiler.core.interpreter.hashmap.{HM_SIZE, hm_hash_text}
use std.spec.step

fn variant_hash_collision() -> (text, text):
    # HM_SIZE + 1 distinct spellings guarantee one shared bucket.
    var first_by_bucket: [text] = []
    var i: i64 = 0
    while i < HM_SIZE:
        first_by_bucket.push("")
        i = i + 1
    i = 0
    while i <= HM_SIZE:
        val candidate = "Variant{i}"
        val bucket = hm_hash_text(candidate) % HM_SIZE
        if first_by_bucket[bucket] != "":
            return (first_by_bucket[bucket], candidate)
        first_by_bucket[bucket] = candidate
        i = i + 1
    ("", "")

describe "interpreter enum variant reverse index":
    it "resets both hit and miss state":
        step("Verify: reset clears the reverse index and permits fresh registration")
        enum_table_reset()
        expect(enum_variant_is_declared("")).to_equal(false)
        expect(enum_variant_is_declared("Missing")).to_equal(false)
        enum_table_register("State", ["Ready"])
        expect(enum_variant_is_declared("Ready")).to_equal(true)
        enum_table_reset()
        expect(enum_variant_is_declared("Ready")).to_equal(false)
        enum_table_register("FreshState", ["Fresh"])
        expect(enum_variant_is_declared("Fresh")).to_equal(true)

    it "keeps the empty enum-name sentinel out of the reverse index":
        step("Verify: an empty enum owner remains invisible before and after removal")
        enum_table_reset()
        enum_table_register("", ["SentinelVariant"])
        expect(enum_variant_is_declared("SentinelVariant")).to_equal(false)
        expect(enum_table_remove("")).to_equal(true)
        expect(enum_variant_is_declared("SentinelVariant")).to_equal(false)

    it "retains a shared variant until its last enum owner is removed":
        step("Verify: reverse-index counts distinguish one remaining owner from none")
        enum_table_reset()
        enum_table_register("First", ["Shared", "FirstOnly"])
        enum_table_register("Second", ["Shared", "SecondOnly"])
        expect(enum_variant_is_declared("Shared")).to_equal(true)
        expect(enum_table_remove("First")).to_equal(true)
        expect(enum_variant_is_declared("Shared")).to_equal(true)
        expect(enum_variant_is_declared("FirstOnly")).to_equal(false)
        expect(enum_variant_is_declared("SecondOnly")).to_equal(true)
        expect(enum_table_remove("Second")).to_equal(true)
        expect(enum_variant_is_declared("Shared")).to_equal(false)
        expect(enum_variant_is_declared("SecondOnly")).to_equal(false)
        expect(enum_table_remove("Second")).to_equal(false)

    it "does not count an ignored duplicate enum registration twice":
        step("Verify: first-wins duplicate registration leaves one removable owner")
        enum_table_reset()
        enum_table_register("State", ["Ready"])
        enum_table_register("State", ["Ready"])
        expect(enum_variant_is_declared("Ready")).to_equal(true)
        expect(enum_table_remove("State")).to_equal(true)
        expect(enum_variant_is_declared("Ready")).to_equal(false)

    it "compares exact variant text inside a shared hash bucket":
        step("Verify: collision-chain hit, miss, and zero-count entries stay distinct")
        val collision = variant_hash_collision()
        expect(collision.0 == "").to_equal(false)
        expect(collision.1 == "").to_equal(false)
        expect(collision.0 == collision.1).to_equal(false)
        expect(hm_hash_text(collision.0) % HM_SIZE).to_equal(
            hm_hash_text(collision.1) % HM_SIZE)

        enum_table_reset()
        enum_table_register("FirstCollisionOwner", [collision.0])
        enum_table_register("SecondCollisionOwner", [collision.1])
        expect(enum_variant_is_declared(collision.0)).to_equal(true)
        expect(enum_variant_is_declared(collision.1)).to_equal(true)
        expect(enum_variant_is_declared("NotInEitherEnum")).to_equal(false)
        expect(enum_table_remove("SecondCollisionOwner")).to_equal(true)
        expect(enum_variant_is_declared(collision.1)).to_equal(false)
        expect(enum_variant_is_declared(collision.0)).to_equal(true)
