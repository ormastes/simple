# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Container-held class instances have REFERENCE semantics — regression spec.
#
# Gates doc/08_tracking/bug/interp_dict_class_value_copy_on_get_mutation_loss_2026-07-06.md.
# That record reported `Dict<K, ClassInstance>.get()` handing back a COPY, so a
# mutation through the fetched handle was lost. Contract:
# doc/05_design/compiler/interpreter/class_instance_reference_storage_2026-11-03.md
# — `class` values are reference types (one heap cell, many handles), `struct`
# values are value types. The interpreter's reference carrier
# (`Value::ClassInstance`, src/compiler_rust/compiler/src/value.rs) is the
# default since 2026-11-04; this spec was retargeted from the 2026-09-27
# value-type oracle accordingly and now also pins the struct half.
#
# The property is broader than `Dict.get`: every way of reaching an instance —
# a dict read, a dict held as a FIELD and read inside a CALLEE, an array
# element, two reads of one key, and plain `val b = a` — yields the SAME
# handle. The probe pins both halves of each case (the handle changed AND the
# container sees it), so a probe that mutates nothing cannot pass.
#
# ENGINE SCOPE. The oracle runs on the interpreter engine; the JIT engine
# already aliased class instances in all of these shapes
# (doc/08_tracking/bug/jit_class_instances_alias_instead_of_copy_2026-09-27.md
# recorded that as a divergence from the old ruling — it is now the contract).
#
# WHY A SUBPROCESS. A spec body runs interpreted, so it cannot select an engine.
# The oracle is the sibling run-path probe `probe_dict_class_value_identity.spl`,
# which checks absolute literals and prints one verdict line.

use std.spec.step

use std.spec.*
use std.io_runtime.{process_run, env_get}


val PROBE_PATH: text = "test/01_unit/compiler/interpreter/probe_dict_class_value_identity.spl"

fn run_probe_in_mode(mode: text) -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = "SIMPLE_RUST_SEED_WARNING=0 SIMPLE_EXECUTION_MODE=" + mode + " " +
        bin + " run " + PROBE_PATH + " 2>/dev/null"
    val out = process_run("sh", ["-c", cmd])
    out.0

describe "class instances reached through a container share one handle":
    # @manual scenario evidence
    it "shares on Dict.get so a mutation is visible through the dict":
        # @req REQ-SSPEC-COMPILER
        step("Run the run-path probe under the interpreter engine")
        val out = run_probe_in_mode("interpreter")

        step("The report's repro sketch: the fetched handle changes AND the entry sees it")
        expect(out).to_contain("PASS dict_get_handle_mutated")
        expect(out).to_contain("PASS dict_get_entry_shared")
        expect(out).to_contain("PASS dict_get_entry_text_shared")

        step("An explicit write-back of the same handle is a no-op")
        expect(out).to_contain("PASS dict_write_back_idempotent")

        step("Key type must not change reference semantics")
        expect(out).to_contain("PASS dict_text_key_handle_mutated")
        expect(out).to_contain("PASS dict_text_key_entry_shared")

    it "gives a callee the same handle to an instance held in a dict-valued field":
        # @req REQ-SSPEC-COMPILER
        step("The filed cache shape: dict held as a FIELD, mutated inside a CALLEE")
        val out = run_probe_in_mode("interpreter")
        expect(out).to_contain("PASS callee_handle_mutated")
        expect(out).to_contain("PASS callee_handle_mutated_again")
        expect(out).to_contain("PASS callee_field_dict_hits_shared")
        expect(out).to_contain("PASS callee_field_dict_last_shared")

    it "shares through array elements, repeated reads and plain val assignment":
        # @req REQ-SSPEC-COMPILER
        val out = run_probe_in_mode("interpreter")
        step("An array element read is the element's handle")
        expect(out).to_contain("PASS array_elem_handle_mutated")
        expect(out).to_contain("PASS array_elem_entry_shared")

        step("Two reads of one key are two handles on one cell")
        expect(out).to_contain("PASS two_handles_first_mutated")
        expect(out).to_contain("PASS two_handles_second_shared")

        step("`val b = a` aliases a class instance")
        expect(out).to_contain("PASS val_assign_handle_mutated")
        expect(out).to_contain("PASS val_assign_original_shared")

    it "keeps struct values as copies in the same shapes":
        # @req REQ-SSPEC-COMPILER
        val out = run_probe_in_mode("interpreter")
        step("A struct read from a dict is a copy; the entry is untouched")
        expect(out).to_contain("PASS struct_dict_get_copy_mutated")
        expect(out).to_contain("PASS struct_dict_get_original_unchanged")
        step("`val b = a` copies a struct")
        expect(out).to_contain("PASS struct_val_assign_copy_mutated")
        expect(out).to_contain("PASS struct_val_assign_original_unchanged")

    it "reports an unambiguous all-pass verdict":
        # @req REQ-SSPEC-COMPILER
        val out = run_probe_in_mode("interpreter")
        step("The aggregate verdict line is the authoritative result")
        expect(out).to_contain("DICT_CLASS_VALUE PROBE: ALL PASS")
        expect(out.contains("FAIL ")).to_equal(false)
