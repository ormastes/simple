# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Container-held class instances have VALUE semantics — regression spec.
#
# Gates doc/08_tracking/bug/interp_dict_class_value_copy_on_get_mutation_loss_2026-07-06.md.
# That record reported `Dict<K, ClassInstance>.get()` handing back a COPY and
# asked whether the interpreter should share references instead. Owner ruling
# 2026-09-27: classes are value types
# (doc/07_guide/language/capability_library_authoring.md:33 — "`val b = a`
# copies"), so the copy is the specified behaviour and a mutation persists only
# through an explicit write-back (`d.set(k, c)`). This spec was retargeted from
# its earlier reference-identity oracle accordingly.
#
# The property is broader than `Dict.get`: every way of reaching an instance —
# a dict read, a dict held as a FIELD and read inside a CALLEE, an array
# element, two reads of one key, and plain `val b = a` — yields an independent
# copy. The probe pins both halves of each case (the copy changed, the original
# did not), so a probe that mutates nothing cannot pass.
#
# ENGINE SCOPE. The oracle runs on the interpreter engine, which implements the
# ruling. The seed's JIT engine still ALIASES class instances in all of these
# shapes (8 of 16 probe checks fail under SIMPLE_EXECUTION_MODE=jit, including
# plain `val b = a`); that divergence is filed as
# doc/08_tracking/bug/jit_class_instances_alias_instead_of_copy_2026-09-27.md
# and is not asserted here until it is fixed.
#
# WHY A SUBPROCESS. A spec body runs interpreted, so it cannot select an engine.
# The oracle is the sibling run-path probe `probe_dict_class_value_identity.spl`,
# which checks absolute literals and prints one verdict line.

use std.spec.step

use std.spec.*
use std.io_runtime.{process_run, env_get}


val PROBE_PATH: text = "test/01_unit/compiler/interpreter/probe_dict_class_value_identity.spl"

fn run_probe_in_mode(mode: text) -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = "SIMPLE_RUST_SEED_WARNING=0 SIMPLE_EXECUTION_MODE=" + mode + " " +
        bin + " run " + PROBE_PATH + " 2>/dev/null"
    val out = process_run("sh", ["-c", cmd])
    out.0

describe "class instances reached through a container are copies":
    # @manual scenario evidence
    it "copies on Dict.get and persists only through an explicit write-back":
        # @req REQ-SSPEC-COMPILER
        step("Run the run-path probe under the interpreter engine")
        val out = run_probe_in_mode("interpreter")

        step("The report's repro sketch: the fetched copy changes, the entry does not")
        expect(out).to_contain("PASS dict_get_copy_mutated")
        expect(out).to_contain("PASS dict_get_original_unchanged")
        expect(out).to_contain("PASS dict_get_original_text_unchanged")

        step("The documented write-back idiom is how a mutation persists")
        expect(out).to_contain("PASS dict_write_back_persists")

        step("Key type must not change value semantics")
        expect(out).to_contain("PASS dict_text_key_copy_mutated")
        expect(out).to_contain("PASS dict_text_key_original_unchanged")

    it "gives a callee a copy of an instance held in a dict-valued field":
        # @req REQ-SSPEC-COMPILER
        step("The filed cache shape: dict held as a FIELD, mutated inside a CALLEE")
        val out = run_probe_in_mode("interpreter")
        expect(out).to_contain("PASS callee_copy_mutated")
        expect(out).to_contain("PASS callee_copy_mutated_again")
        expect(out).to_contain("PASS callee_field_dict_hits_unchanged")
        expect(out).to_contain("PASS callee_field_dict_last_unchanged")

    it "copies through array elements, repeated reads and plain val assignment":
        # @req REQ-SSPEC-COMPILER
        val out = run_probe_in_mode("interpreter")
        step("An array element read is a copy")
        expect(out).to_contain("PASS array_elem_copy_mutated")
        expect(out).to_contain("PASS array_elem_original_unchanged")

        step("Two reads of one key are two independent copies")
        expect(out).to_contain("PASS two_handles_first_mutated")
        expect(out).to_contain("PASS two_handles_second_independent")

        step("`val b = a` copies (capability_library_authoring.md:33)")
        expect(out).to_contain("PASS val_assign_copy_mutated")
        expect(out).to_contain("PASS val_assign_original_unchanged")

    it "reports an unambiguous all-pass verdict":
        # @req REQ-SSPEC-COMPILER
        val out = run_probe_in_mode("interpreter")
        step("The aggregate verdict line is the authoritative result")
        expect(out).to_contain("DICT_CLASS_VALUE PROBE: ALL PASS")
        expect(out.contains("FAIL ")).to_equal(false)
