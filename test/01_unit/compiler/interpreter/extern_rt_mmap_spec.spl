# Interpreter dispatch for rt_mmap (path, size, offset, readonly) -> addr.

use std.nogc_sync_mut.io_runtime.{file_write, file_delete, getpid}
use std.nogc_sync_mut.ptr.raw.{rt_ptr_read_u8}

extern fn rt_mmap(path: text, size: i64, offset: i64, readonly: i64) -> i64
extern fn rt_munmap(addr: i64, size: i64) -> bool

describe "rt_mmap interpreter extern":
    it "maps an existing file read-only and exposes its bytes":
        val path = ".extern_rt_mmap_spec_{getpid()}.txt"
        file_write(path, "ABCD")
        val addr = rt_mmap(path, 4, 0, 1)
        var first = -1
        var last = -1
        var unmapped = false
        if addr != 0:
            first = rt_ptr_read_u8(addr, 0)
            last = rt_ptr_read_u8(addr, 3)
            unmapped = rt_munmap(addr, 4)
        file_delete(path)
        assert_true(addr != 0)
        expect(first).to_equal(65)
        expect(last).to_equal(68)
        expect(unmapped).to_equal(true)

    it "returns 0 for a missing file":
        expect(rt_mmap(".extern_rt_mmap_spec_missing.txt", 4, 0, 1)).to_equal(0)
