use std.spec.*

struct S:
    n: i64
    items: [i64]

class H:
    d: Dict<i64, S>

    me first_key() -> i64:
        for k in self.d.keys():
            return k
        return -1

fn sample() -> Dict<i64, S>:
    var d: Dict<i64, S> = {}
    d[7] = S(n: 1, items: [])
    d

describe "Dict with non-text keys":
    it "keys() yields the i64 that was inserted":
        for k in sample().keys():
            expect(k == 7).to_equal(true)
            expect(k.to_text() == "7").to_equal(true)
            expect(sample()[k].n).to_equal(1)
    it "keys() through a class field":
        val h = H(d: sample())
        expect(h.first_key() == 7).to_equal(true)
    it "keeps bool, float and text keys typed":
        var b: Dict<bool, i64> = {}
        b[true] = 1
        for k in b.keys():
            expect(k == true).to_equal(true)
        var f: Dict<f64, i64> = {}
        f[1.5] = 1
        for k in f.keys():
            expect(k == 1.5).to_equal(true)
        var t: Dict<text, i64> = {}
        t["7"] = 1
        for k in t.keys():
            expect(k == "7").to_equal(true)
    it "iterates entries and items with typed keys and plain values":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        for (k, v) in d.items():
            expect(k == 7).to_equal(true)
            expect(v).to_equal(70)
        for (k, v) in d:
            expect(k == 7).to_equal(true)
            expect(v).to_equal(70)
        expect(d.values()).to_equal([70])
    it "literal, get, get_or, contains and remove":
        var d = {7: 70, 8: 80}
        expect(d[7]).to_equal(70)
        expect(d.get(8)).to_equal(80)
        expect(d.get_or(9, 0)).to_equal(0)
        expect(d.contains_key(7)).to_equal(true)
        expect(7 in d).to_equal(true)
        d.remove(7)
        expect(d.len()).to_equal(1)
        for k in d.keys():
            expect(k == 8).to_equal(true)
    it "writes through the value slot in place":
        var d = sample()
        d[7].n = 5
        d[7].items.push(3)
        expect(d[7].n).to_equal(5)
        expect(d[7].items).to_equal([3])
        for k in d.keys():
            expect(k == 7).to_equal(true)
    it "compound assign":
        var d: Dict<i64, i64> = {}
        d[7] = 1
        d[7] += 2
        expect(d[7]).to_equal(3)
    it "prints the value, not the storage":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        val shown = "{d}"
        expect(shown.contains("__dict_entry__")).to_equal(false)
        expect(shown.contains("7: 70")).to_equal(true)
    it "dict equality":
        var a: Dict<i64, i64> = {}
        a[7] = 70
        expect(a == {7: 70}).to_equal(true)
    it "group_by keeps the key type":
        val groups = [1, 2, 3].group_by(\x: x % 2)
        expect(groups[1]).to_equal([1, 3])
        for k in groups.keys():
            expect(k == 0 or k == 1).to_equal(true)
    it "filter sees typed keys and plain values":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        d[8] = 80
        val by_value = d.filter(\v: v > 70)
        expect(by_value.len()).to_equal(1)
        expect(by_value[8]).to_equal(80)
        val by_key = d.filter(\k, v: k == 7)
        expect(by_key[7]).to_equal(70)
        for k in by_key.keys():
            expect(k == 7).to_equal(true)
    it "map_values sees plain values and keeps typed keys":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        val doubled = d.map_values(\v: v * 2)
        expect(doubled[7]).to_equal(140)
        for k in doubled.keys():
            expect(k == 7).to_equal(true)
    it "compact drops nil and unwraps Some under typed keys":
        var d: Dict<i64, i64?> = {}
        d[1] = nil
        d[2] = None
        d[3] = Some(30)
        d[4] = 40
        val kept = d.compact()
        expect(kept.len()).to_equal(2)
        expect(kept[3]).to_equal(30)
        expect(kept[4]).to_equal(40)
        for k in kept.keys():
            expect(k == 3 or k == 4).to_equal(true)
    it "for_each sees typed keys and plain values":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        var seen: [i64] = []
        d.for_each(\k, v: seen.push(if k == 7: v else: -1))
        expect(seen).to_equal([70])
    it "setdefault returns plain values and keeps typed keys":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        val (hit, _) = d.setdefault(7, 0)
        expect(hit).to_equal(70)
        val (miss, grown) = d.setdefault(8, 80)
        expect(miss).to_equal(80)
        expect(grown[8]).to_equal(80)
        expect(grown.keys().contains(8)).to_equal(true)
    it "spread and merge keep entries readable":
        var d: Dict<i64, i64> = {}
        d[7] = 70
        val s = {**d, 8: 80}
        expect(s[7]).to_equal(70)
        var m: Dict<i64, i64> = {}
        m.merge(d)
        expect(m[7]).to_equal(70)
