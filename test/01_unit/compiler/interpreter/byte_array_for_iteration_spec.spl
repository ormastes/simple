# Purpose and audience: regression cover for iterating packed byte arrays in `for` loops.
# @req REQ-SSPEC-COMPILER
#
# A buffer from a runtime allocator (`rt_byte_array_new_len`) is a packed byte
# array, not the generic array representation. `for b in buf` failed with
# `value of type 'array' is not iterable` because the for-loop iterator
# helper (block_execution::get_iterator_values) lacked the ByteArray case
# that comprehensions (iter_to_vec) already had.
use std.spec.step

use std.spipe.*

extern fn rt_byte_array_new_len(n: i64) -> [u8]

describe "for loop over a packed byte array":
    # @manual scenario evidence

    it "visits every byte of a runtime-allocated buffer":
        # @req REQ-SSPEC-COMPILER
        step("visits every byte of a runtime-allocated buffer")
        var buf = rt_byte_array_new_len(3)
        buf[0] = 1u8
        buf[1] = 2u8
        buf[2] = 3u8
        var total = 0
        var count = 0
        for b in buf:
            total = total + b
            count = count + 1
        expect(count).to_equal(3)
        expect(total).to_equal(6)

    it "visits every byte of a slice of a packed buffer":
        # @req REQ-SSPEC-COMPILER
        step("visits every byte of a slice of a packed buffer")
        var buf = rt_byte_array_new_len(4)
        buf[1] = 5u8
        buf[2] = 7u8
        var total = 0
        for b in buf[1:3]:
            total = total + b
        expect(total).to_equal(12)
