# Run-path probe: a nested fn assigning an enclosing local must be REJECTED.
#
# Oracle for test/01_unit/compiler/interpreter/nested_fn_enclosing_var_mutation_spec.spl.
# Owner ruling 2026-09-27: closures capture enclosing locals by value and are
# read-only (.claude/rules/language.md:22), so line 13 is a compile error:
#     cannot assign to captured variable `total` inside nested fn `bump` (line 13)
# Nothing runs; `total=` is printed only if the module was (wrongly) accepted.

fn outer() -> i64:
    var total = 0
    fn bump(n: i64):
        # the rejected write
        total = total + n
    bump(5)
    total

fn main():
    print("total=" + outer().to_text())
