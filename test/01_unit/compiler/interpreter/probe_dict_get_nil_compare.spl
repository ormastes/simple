# Run-path probe (Dict.get -> Option compared with == nil / != nil) for class_ref_interp_jit_consistency_spec.spl.
# Shape of the pure-Simple HIR SymbolTable scope probe (hir_types.spl define).
class ScopeRow:
    symbols: Dict<text, i64>

fn main():
    var row = ScopeRow(symbols: {})
    row.symbols["a"] = 5
    val miss = row.symbols.get("zz")
    val hit = row.symbols.get("a")
    print "f_miss_eq={miss == nil}"
    print "f_miss_ne={miss != nil}"
    print "f_hit_eq={hit == nil}"
    print "f_hit_ne={hit != nil}"
    var d: Dict<text, i64> = {}
    print "l_miss_ne={d.get("q") != nil}"
    print "l_miss_rev={nil == d.get("q")}"
    print "tail=ok"
main()
