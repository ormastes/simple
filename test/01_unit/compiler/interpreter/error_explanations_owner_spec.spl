# Purpose: shared error explanation ownership across common and interpreter surfaces.
# @req REQ-SSPEC-UNIT

use std.spec.*
use compiler.common.error_explanations.{ErrorRegistry as CommonErrorRegistry}
use compiler.interpreter.errors.{ErrorRegistry as InterpreterErrorRegistry}

describe "Error explanation shared owner [importance=critical; importance_weight=3]":
    it "keeps the common and interpreter surfaces on the same registry type":
        val common_registry = CommonErrorRegistry.create()
        val interpreter_registry: InterpreterErrorRegistry = common_registry
        expect(interpreter_registry.get("E0001").is_some()).to_be(true)
