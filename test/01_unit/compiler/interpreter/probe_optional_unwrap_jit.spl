# Run-path (JIT) mirror of test/01_unit/compiler/interpreter/optional_unwrap_bang_spec.spl
#
# WHY THIS FILE EXISTS: `bin/simple test` executes specs on the tree-walk
# INTERPRETER, so the sibling spec cannot observe the Cranelift JIT at all.
# The JIT corrupts `i64?` payloads outright. This probe is the only artifact
# that can see it.
#
# STATUS: KNOWN RED on the JIT as of 2026-08-17. It is deliberately left
# failing per .claude/rules/testing.md ("a correct spec that fails is a
# legitimate artifact") and tracked by
# doc/08_tracking/bug/jit_optional_i64_payload_reinterpreted_2026-08-17.md.
#
#   bin/simple run <this>                                -> FAIL (JIT, the defect)
#   SIMPLE_EXECUTION_MODE=interpreter bin/simple run <this> -> ALL PASS (control)
#
# The interpreter invocation is the control arm: if it ever stops passing, the
# probe itself is broken rather than the JIT.

use std.io_runtime.{exit}

fn give_int() -> i64?:
    return 7

fn check(name: text, actual: text, expected: text, fails: i64) -> i64:
    if actual == expected:
        print("PASS " + name + " = " + actual)
        return fails
    print("FAIL " + name + " expected=" + expected + " actual=" + actual)
    return fails + 1

fn main():
    var fails = 0

    val x: i64? = 42
    fails = check("optional_i64_renders_payload", x.to_string(), "42", fails)
    fails = check("bang_unwrap_variable", (x!).to_string(), "42", fails)
    fails = check("nil_coalesce_keeps_payload", (x ?? 99).to_string(), "42", fails)

    val g = give_int()
    fails = check("optional_from_fn_renders_payload", g.to_string(), "7", fails)
    fails = check("bang_unwrap_fn_result", (g!).to_string(), "7", fails)

    if fails == 0:
        print("OPTIONAL_UNWRAP PROBE: ALL PASS")
        exit(0)
    print("OPTIONAL_UNWRAP PROBE: " + fails.to_string() + " FAILED")
    exit(1)

main()
