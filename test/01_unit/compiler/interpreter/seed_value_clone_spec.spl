"""
`clone()` on text and on a struct value works in the Rust seed interpreter.
The self-hosted module resolver calls `text.clone()` and `ModulePath.clone()`;
without these built-ins every resolver spec failed on the seed with
"method `clone` not found on type `str`".
"""
# @req REQ-SSPEC-COMPILER
use std.spec.{describe, it, expect}
use std.spec.step

struct Pair:
    left: text
    right: i64

struct Holder:
    pair: Pair

impl Holder:
    fn pair_copy() -> Pair:
        self.pair.clone()

struct Tagged:
    tag: text

impl Tagged:
    fn clone() -> Tagged:
        Tagged(tag: self.tag + "-user")

impl Pair:
    me bump():
        self.right = self.right + 1

describe "seed built-in clone":
    it "clones a text value to an equal text":
        step("Clone a text and compare")
        val original = "src/lib"
        val copy = original.clone()
        expect(copy).to_equal("src/lib")
        expect(copy.len()).to_equal(7)

    it "clones a struct to an independent equal value":
        step("Clone a struct, mutate the copy, keep the original")
        val original = Pair(left: "a", right: 1)
        var copy = original.clone()
        expect(copy.left).to_equal("a")
        expect(copy.right).to_equal(1)
        copy.bump()
        expect(copy.right).to_equal(2)
        expect(original.right).to_equal(1)

    it "clones a struct field reached through self":
        step("Clone a nested struct inside a method")
        val holder = Holder(pair: Pair(left: "b", right: 9))
        val copy = holder.pair_copy()
        expect(copy.left).to_equal("b")
        expect(copy.right).to_equal(9)

    it "keeps a nested field of the clone independent":
        step("Mutate a nested field of the clone only")
        val original = Holder(pair: Pair(left: "c", right: 3))
        var copy = original.clone()
        copy.pair.right = 30
        expect(copy.pair.right).to_equal(30)
        expect(original.pair.right).to_equal(3)

    it "prefers a user-defined clone over the built-in":
        step("A struct with its own clone keeps that behaviour")
        val original = Tagged(tag: "t")
        expect(original.clone().tag).to_equal("t-user")
