# Run-path probe (Dict.get -> Option payload decode for f64/bool/u64 values) for class_ref_interp_jit_consistency_spec.spl.
fn main():
    val df = {"a": 1.5}
    val db = {"t": true, "f": false}
    val du: {text: u64} = {"u": 7}
    val x = (df.get("a") ?? 0.0) + 1.0
    print "f={x}"
    print "b={db.get("t") ?? false} {db.get("f") ?? true} {db.get("zz") ?? true}"
    if val bb = db.get("f"):
        print "ifb={not bb}"
    val y = (du.get("u") ?? 0) + 1
    print "u={y}"
    match df.get("a"):
        Some(v): print "mf={v * 2.0}"
        None: print "mf=none"
    val g = df.get("a")
    print "g_some={g.is_some()}"
main()
