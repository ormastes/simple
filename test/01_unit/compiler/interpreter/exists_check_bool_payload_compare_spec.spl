"""
# `.?` on a `bool?` compares as a plain bool (absence-safe)

`.?` yields `T?` (payload or None). For a `bool?` receiver the payload bool passes
through, so `bool_false().? == false` is true; for an absent (None) receiver `None == false`
is false and `None != true` is true, with no error. For a non-bool payload
(`i64?`) `.? == false` never fires.

Bug: doc/08_tracking/bug/seed_optional_query_comparison_divergence_2026-08-16.md (Part A)
"""

fn bool_false() -> bool?:
    return false

fn bool_true() -> bool?:
    return true

fn bool_none() -> bool?:
    return None

fn int_five() -> i64?:
    return 5

describe "bool? payload comparison":
    it "false payload .? == false is true":
        expect (bool_false().? == false) == true

    it "true payload .? == true is true":
        expect (bool_true().? == true) == true

    it "false payload .? == true is false":
        expect (bool_false().? == true) == false

    it "bound false payload compares equal to false":
        val e = bool_false().?
        expect (e == false) == true
        expect (e != false) == false

    it "None receiver: None == false is false":
        expect (bool_none().? == false) == false

    it "None receiver: None != true is true":
        expect (bool_none().? != true) == true

    it "None receiver: .? == None is true":
        expect (bool_none().? == None) == true

    it "present bool receiver: .? == None is false":
        expect (bool_false().? == None) == false

    it "i64? payload .? == false never fires":
        expect (int_five().? == false) == false

    it "i64? returned value compares equal to its payload":
        expect (int_five() == 5) == true
