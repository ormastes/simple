"""
# `.?` on a `bool?` compares as a plain bool (nil-safe)

`.?` yields `T?` (payload or nil). For a `bool?` receiver the payload bool passes
through, so `bool_false().? == false` is true; for a nil receiver `nil == false`
is false and `nil != true` is true, with no error. For a non-bool payload
(`i64?`) `.? == false` never fires.

Bug: doc/08_tracking/bug/seed_optional_query_comparison_divergence_2026-08-16.md (Part A)
"""

fn bool_false() -> bool?:
    return false

fn bool_true() -> bool?:
    return true

fn bool_nil() -> bool?:
    return nil

fn int_five() -> i64?:
    return 5

describe "bool? payload comparison":
    it "false payload .? == false is true":
        expect (bool_false().? == false) == true

    it "true payload .? == true is true":
        expect (bool_true().? == true) == true

    it "false payload .? == true is false":
        expect (bool_false().? == true) == false

    it "bound false payload compares equal to false":
        val e = bool_false().?
        expect (e == false) == true
        expect (e != false) == false

    it "nil receiver: nil == false is false":
        expect (bool_nil().? == false) == false

    it "nil receiver: nil != true is true":
        expect (bool_nil().? != true) == true

    it "nil receiver: .? == nil is true":
        expect (bool_nil().? == nil) == true

    it "present bool receiver: .? == nil is false":
        expect (bool_false().? == nil) == false

    it "i64? payload .? == false never fires":
        expect (int_five().? == false) == false

    it "i64? returned value compares equal to its payload":
        expect (int_five() == 5) == true
