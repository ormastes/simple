# Run-path probe (one class ref in list, dict, struct field, param) for class_ref_interp_jit_consistency_spec.spl.
class Inner:
    v: i64
struct Holder:
    r: Inner
fn bump(c: Inner):
    c.v = 2
fn main():
    val shared = Inner(v: 0)
    var l2 = [shared]
    var d4 = {"k": shared}
    val h = Holder(r: shared)
    l2[0].v = 1
    print "shared_via_list_seen_dict={d4["k"].v}"
    d4["k"].v = 2
    print "shared_via_dict_seen_holder={h.r.v}"
    h.r.v = 3
    print "shared_via_field_seen_list={l2[0].v}"
    bump(shared)
    print "shared_via_param_seen_all={l2[0].v}{d4["k"].v}{h.r.v}{shared.v}"
main()
