# Interpreter dispatch for the legacy numbered rt_thread_spawn_isolated2 spelling.
# Same ABI as rt_thread_spawn_isolated_with_args: (closure, data1, data2) -> handle.

extern fn rt_thread_spawn_isolated2(closure: Any, data1: Any, data2: Any) -> i64
extern fn rt_thread_join(handle: i64) -> Any

describe "rt_thread_spawn_isolated2 interpreter extern":
    it "passes both data arguments to the closure":
        val handle = rt_thread_spawn_isolated2(\a, b: a * 10 + b, 4, 2)
        expect(rt_thread_join(handle)).to_equal(42)
