"""
`to_u64()` yields an unsigned value, so an i64 with bit 63 set becomes a large
magnitude rather than a negative number. Behaviour twin of
test/01_unit/compiler/mir/unsigned_conversion_result_spec.spl, which pins the
MIR lowering type only. The results are deliberately left untyped (`val u =`)
so the conversion itself must carry the unsigned view.
"""
# @req REQ-COMPILER-MIR-U64-CONVERSION
use std.spec.{describe, it, expect}
use std.spec.step

describe "to_u64 unsigned semantics":
    it "round-trips the all-ones pattern as the maximum u64":
        step("Convert -1 and read it back")
        val minus_one: i64 = -1
        val u = minus_one.to_u64()
        expect(u.to_string()).to_equal("18446744073709551615")
        expect(u == 18446744073709551615u64).to_equal(true)
        expect(u.to_i64()).to_equal(-1)

    it "compares a high-bit value as larger than every positive i64":
        step("Compare against zero and against i64 max")
        val min_i64: i64 = -9223372036854775807 - 1
        val u = min_i64.to_u64()
        expect(u > 0u64).to_equal(true)
        expect(u > 9223372036854775807u64).to_equal(true)
        expect(u.to_string()).to_equal("9223372036854775808")

    it "shifts and divides a high-bit value logically":
        step("Right shift and divide the all-ones pattern")
        val minus_one: i64 = -1
        val u = minus_one.to_u64()
        expect((u >> 63).to_string()).to_equal("1")
        expect((u / 2u64).to_string()).to_equal("9223372036854775807")

    it "keeps small values unchanged":
        step("Convert a small positive value and add to it")
        val u = 10.to_u64()
        expect((u + 5u64).to_string()).to_equal("15")
        expect(u < 11u64).to_equal(true)
