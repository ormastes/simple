# Regression: comparisons between unit values return plain bool (rb4-unitcmp).
unit FreeBytes: i64 as fbytes

describe "unit value comparison yields plain bool":
    it "== returns true not true_fbytes":
        val a = 5 * 1_fbytes
        expect("{a == 5_fbytes}").to_equal("true")

    it "!= returns plain bool":
        expect("{5_fbytes != 6_fbytes}").to_equal("true")

    it "< returns plain bool":
        expect("{5_fbytes < 6_fbytes}").to_equal("true")

    it "<= returns plain bool":
        expect("{6_fbytes <= 6_fbytes}").to_equal("true")

    it "> returns plain bool":
        expect("{5_fbytes > 6_fbytes}").to_equal("false")

    it ">= returns plain bool":
        expect("{7_fbytes >= 6_fbytes}").to_equal("true")

    it "works in an if condition":
        val a = 5 * 1_fbytes
        val b = 5_fbytes
        var hit = false
        if a == b:
            hit = true
        expect(hit).to_equal(true)
