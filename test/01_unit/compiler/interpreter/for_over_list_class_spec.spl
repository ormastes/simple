# `for e in list` where list: List<T> iterates the items payload
# (interp_for_over_list_generic_2026-07-02).
use std.common.core.collections.List

struct ListEntry:
    v: i64

describe "for over List<T>":
    it "visits every element in order":
        var xs = List<ListEntry>(items: [])
        xs.push(ListEntry(v: 1))
        xs.push(ListEntry(v: 2))
        xs.push(ListEntry(v: 4))
        var total = 0
        var visits = 0
        for e in xs:
            total = total + e.v
            visits = visits + 1
        expect(total).to_equal(7)
        expect(visits).to_equal(3)

    it "an empty List runs the body zero times":
        val xs = List<ListEntry>(items: [])
        var visits = 0
        for e in xs:
            visits = visits + 1
        expect(visits).to_equal(0)

    it "list comprehension over List<T> also works":
        var xs = List<ListEntry>(items: [])
        xs.push(ListEntry(v: 3))
        xs.push(ListEntry(v: 5))
        val vs = [e.v for e in xs]
        expect(vs.len()).to_equal(2)
        expect(vs[1]).to_equal(5)
