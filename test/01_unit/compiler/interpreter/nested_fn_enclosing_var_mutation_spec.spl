"""
## Purpose and audience
Regression contract for a nested `fn` or lambda assigning a local of an
ENCLOSING function. Owner ruling 2026-09-27: closures capture enclosing
locals by value and are READ-ONLY (.claude/rules/language.md:22), so such a
write is a loud compile error in the Rust seed (module loader and native
build) and in the pure-Simple interpreter (resolve.spl
capture_write_check_module), with one shared diagnostic. Written for the
compiler engineers who own closure capture in either engine.
## Operator workflow
Run the file with the seeded runner:
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/compiler/interpreter/nested_fn_enclosing_var_mutation_spec.spl`
## Compatibility and limitations
The seed half runs the sibling probes as subprocesses because the rejected
program cannot load at all; the pure-Simple half feeds source text to
core_interpret in-process. Colon-blocks (`describe`/`it`/hooks) are scopes,
not closures, and are out of this rule's scope.
## Verification guidance and troubleshooting
Before the ruling this spec asserted the opposite (write-through), and the
original defect was that the write was silently lost (the caller read 0).
See doc/08_tracking/bug/nested_fn_cannot_mutate_enclosing_it_block_var_2026-08-04.md.
If the seed examples fail with `total=`/`count=` in the output, the running
seed predates the fix (rebuild it); if they fail with a different message,
the two engines' diagnostics have drifted.
"""
# @manual_section: interpreter-closure-mutation

use std.spec.{describe, it, expect, step}
use std.io_runtime.{process_run, env_get}
use compiler.frontend.core.interpreter.mod.{core_interpret}
use compiler.frontend.core.interpreter.value.{val_get_int}
use compiler.frontend.core.interpreter.eval.{eval_get_error}

val NESTED_FN_PROBE: text = "test/01_unit/compiler/interpreter/probe_nested_fn_capture_write.spl"
val LAMBDA_PROBE: text = "test/01_unit/compiler/interpreter/probe_lambda_capture_write.spl"
val NESTED_FN_DIAGNOSTIC: text = "cannot assign to captured variable `total` inside nested fn `bump` (line 13): closures capture enclosing locals by value and are read-only; return the new value or use a module-level `var`"
val LAMBDA_DIAGNOSTIC: text = "cannot assign to captured variable `count` inside a closure (line 11)"

fn test_binary() -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    bin

fn run_probe(path: text, mode: text) -> text:
    val cmd = "SIMPLE_RUST_SEED_WARNING=0 SIMPLE_EXECUTION_MODE=" + mode + " " +
        test_binary() + " run " + path + " 2>&1"
    process_run("sh", ["-c", cmd]).0

fn core_run(source: text) -> text:
    val r = core_interpret(source, "nested_fn_capture_probe.spl")
    if r < 0: return "ERR:" + eval_get_error()
    "VAL:" + val_get_int(r).to_text()

describe "nested fn / lambda writes to an enclosing local":

    it "rejects a nested fn assigning an enclosing local, on both seed engines":
        # @req REQ-INTERP-CLOSURE-001
        step("Run the nested-fn probe under the interpreter and the JIT")
        val interp = run_probe(NESTED_FN_PROBE, "interpreter")
        val jit = run_probe(NESTED_FN_PROBE, "jit")
        step("Both report the shared diagnostic, naming the variable, the nested fn and the line")
        expect(interp).to_contain(NESTED_FN_DIAGNOSTIC)
        expect(jit).to_contain(NESTED_FN_DIAGNOSTIC)
        step("The module never ran: the old silent-loss path printed total=0")
        expect(interp).to_not_contain("total=")
        expect(jit).to_not_contain("total=")

    it "rejects a lambda assigning an enclosing local":
        # @req REQ-INTERP-CLOSURE-002
        val out = run_probe(LAMBDA_PROBE, "interpreter")
        expect(out).to_contain(LAMBDA_DIAGNOSTIC)
        expect(out).to_not_contain("count=")

    it "reports the identical diagnostic from the pure-Simple interpreter":
        # @req REQ-INTERP-CLOSURE-003
        step("Feed the same shape to core_interpret in-process")
        val src = "fn outer() -> i64:\n    var total = 0\n    fn bump(n: i64):\n        total = total + n\n    bump(5)\n    total\nfn main() -> i64:\n    outer()\n"
        val out = core_run(src)
        expect(out).to_start_with("ERR:cannot assign to captured variable `total` inside nested fn `bump` (line 4): closures capture enclosing locals by value and are read-only")

    it "rejects a lambda write in the pure-Simple interpreter too":
        # @req REQ-INTERP-CLOSURE-004
        val src = "fn outer() -> i64:\n    var n = 0\n    val f = fn(x):\n        n = n + x\n    f(2)\n    n\nfn main() -> i64:\n    outer()\n"
        expect(core_run(src)).to_start_with("ERR:cannot assign to captured variable `n` inside nested fn `f`")

    it "still lets a nested fn READ an enclosing local":
        # @req REQ-INTERP-CLOSURE-005
        step("Read-only capture is the specified semantics and keeps working")
        val base = 40
        fn plus(n: i64) -> i64:
            base + n
        expect(plus(2)).to_equal(42)

    it "keeps module-level vars writable from a nested fn":
        # @req REQ-INTERP-CLOSURE-006
        step("A module global is not a capture: the documented alternative")
        val src = "var g = 0\nfn outer() -> i64:\n    fn setg():\n        g = 5\n    setg()\n    g\nfn main() -> i64:\n    outer()\n"
        expect(core_run(src)).to_equal("VAL:5")

    it "lets a nested fn assign its own locals and parameters":
        # @req REQ-INTERP-CLOSURE-007
        val src = "fn outer() -> i64:\n    fn inner(k: i64) -> i64:\n        var scratch = k * 100\n        k = k + 1\n        scratch + k\n    inner(1)\nfn main() -> i64:\n    outer()\n"
        step("No captured-write error: only the nested fn's own names are assigned")
        expect(core_run(src)).to_start_with("VAL:")
