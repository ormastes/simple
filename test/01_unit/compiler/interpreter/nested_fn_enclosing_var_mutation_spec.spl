"""
## Purpose and audience
Regression contract for nested `fn` assignment to an ENCLOSING local under
the interpreter: the write-back half (a call's assignment is visible to the
caller) and the fresh-read half (the SECOND call sees the FIRST call's
result, not the declaration-time snapshot). Written for the compiler
engineers who own node_exec and the closure-capture lowering.
## Operator workflow
Run the file with the pure-Simple CLI:
./src/compiler_rust/target/bootstrap/simple run test/01_unit/compiler/interpreter/nested_fn_enclosing_var_mutation_spec.spl
## Compatibility and limitations
Exercises interpreter closure semantics only; native-codegen closure
capture has its own lanes. The bug record this spec reproduces lives at
doc/08_tracking/bug/nested_fn_cannot_mutate_enclosing_it_block_var_2026-08-04.md.
## Verification guidance and troubleshooting
A failure in the accumulate scenario means capture fell back to a
declaration-time snapshot (the original defect printed 0; a partial fix
printed 7); a failure in the shadow scenario means parameter binding now
clobbers the enclosing local. Rerun the single file above after any
node_exec or capture-related edit.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/interpreter_shared_text.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: interpreter-closure-mutation

use std.spec.{describe, it, expect, step}

describe "nested fn mutation of an enclosing local":

    it "propagates a single assignment back to the enclosing scope":
        # @req REQ-INTERP-CLOSURE-001
        # @capture(statistics): enclosing local observed after one nested-fn call
        step("Call a nested fn that assigns the enclosing total and read it back")
        var total = 0
        fn bump(n: i64):
            total = total + n
        bump(5)
        expect(total).to_equal(5)  # oracle: write-back must make the single assignment visible to the caller

    it "accumulates across repeated calls (second call sees the first result)":
        # @req REQ-INTERP-CLOSURE-002
        # @capture(statistics): enclosing local observed after two nested-fn calls
        step("Call the nested fn twice and require the second call to see the first result")
        # THE ORIGINAL DEFECT: this printed 0. A partial fix printed 7 (the last
        # call only), because each call re-read the declaration-time snapshot.
        var total = 0
        fn bump(n: i64):
            total = total + n
        bump(5)
        bump(7)
        expect(total).to_equal(12)  # oracle: 5 + 7 accumulated across frames, not re-read from the snapshot

    it "supports plain assignment, not only compound assignment":
        # @req REQ-INTERP-CLOSURE-003
        # @capture(statistics): enclosing local observed after a plain store
        step("Assign the enclosing local with a plain store and read it back")
        var seen = 0
        fn record(n: i64):
            seen = n
        record(42)
        expect(seen).to_equal(42)  # oracle: the plain store must land in the caller's binding

    it "mutates an enclosing text variable":
        # @req REQ-INTERP-CLOSURE-004
        # @capture(statistics): enclosing text local observed after two appends
        step("Append to an enclosing text local from two nested-fn calls")
        var log = ""
        fn append(s: text):
            log = log + s
        append("a")
        append("b")
        expect(log).to_equal("ab")  # oracle: both appends land on the caller's text binding in order

    it "mutates an enclosing bool variable":
        # @req REQ-INTERP-CLOSURE-005
        # @capture(statistics): enclosing bool local observed after the nested call
        step("Raise an enclosing bool local from inside a nested fn")
        var flag = false
        fn raise():
            flag = true
        raise()
        expect(flag).to_equal(true)  # oracle: the callee's store must flip the caller's bool

    it "leaves a callee-only local invisible to the caller":
        # @req REQ-INTERP-CLOSURE-006
        # @capture(statistics): enclosing total observed after a call using a callee scratch
        step("Let the callee use its own scratch local and check nothing escapes")
        # The write-back must be restricted to names the CALLER already binds.
        # A callee local escaping into the caller would be the opposite defect.
        var total = 0
        fn bump(n: i64):
            var scratch = n * 100
            total = total + scratch
        bump(1)
        expect(total).to_equal(100)  # oracle: only the enclosing total is written back, through the callee scratch

    it "lets a parameter shadow an enclosing name without clobbering it":
        # @req REQ-INTERP-CLOSURE-007
        # @capture(statistics): parameter result and enclosing local after a shadowing call
        step("Shadow an enclosing name with a parameter and verify neither view bleeds")
        # Parameter binding happens AFTER the enclosing-local refresh, so the
        # parameter must win inside the body and the outer variable must be
        # untouched by that shadowing. The seed is mediated through a named
        # product call so the oracle observes the interpreter, not a literal.
        val caller_seed = "10".to_int() ?? 0
        var value = caller_seed
        fn shadow(value: i64) -> i64:
            value * 2
        val doubled = shadow(3)
        expect(doubled).to_equal(6)  # oracle: the parameter binding wins inside the body (3 * 2)
        expect(value).to_equal(10)  # oracle: the caller's seed of 10 must survive the shadowing call untouched
