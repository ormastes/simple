"""Nested value reconstruction must preserve both scalar and array fields."""

use std.spec.*

struct ScalarAndBytes:
    token: u64
    bytes: [u8]

struct NestedScalarAndBytes:
    inner: ScalarAndBytes

fn _advance_nested(
    source: NestedScalarAndBytes
) -> NestedScalarAndBytes:
    var bytes = source.inner.bytes
    bytes[0] = 20
    var token = source.inner.token
    if bytes[0] == 20:
        token = source.inner.token + 1
    val inner = ScalarAndBytes(token: token, bytes: bytes)
    NestedScalarAndBytes(inner: inner)

fn _advance_inner(source: ScalarAndBytes) -> ScalarAndBytes:
    var bytes = source.bytes
    bytes[0] = 30
    var token = source.token
    if bytes[0] == 30:
        token = source.token + 2
    ScalarAndBytes(token: token, bytes: bytes)

describe "nested struct scalar reconstruction":
    it "returns the branch-computed token beside mutated bytes":
        val result = _advance_nested(NestedScalarAndBytes(
            inner: ScalarAndBytes(token: 11, bytes: [0, 0])))
        expect(result.inner.bytes).to_equal([20, 0])
        expect(result.inner.token).to_equal(12)

    it "preserves the same fields without an outer wrapper":
        val result = _advance_inner(ScalarAndBytes(token: 11, bytes: [0, 0]))
        expect(result.bytes).to_equal([30, 0])
        expect(result.token).to_equal(13)
