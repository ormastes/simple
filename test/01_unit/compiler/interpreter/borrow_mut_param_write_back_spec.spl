use std.spec.*
struct Inner:
    v: i64
struct Route:
    execution: i64
    name: text
    inner: Inner
    items: [i64]
class Box2:
    route: Route
    fn m(r: &mut Route):
        r.execution = 50
    me own_bump():
        bump(&mut self.route)
fn mk() -> Route:
    Route(execution: 1, name: "a", inner: Inner(v: 1), items: [1])
fn bump(route: &mut Route):
    route.execution = route.execution + 1
fn bump2(route: &mut Route):
    bump(route)
fn bump3(route: &mut Route):
    bump(&mut route)
fn deep(route: &mut Route):
    route.inner.v = 9
    route.items.push(2)
    route.items[0] = 5
fn replace(route: &mut Route):
    route = mk()
fn by_value(route: Route):
    var r = route
    r.execution = 99
fn by_value_mut(mut route: Route):
    route.execution = 99
fn fails(route: &mut Route) -> Result<i64, text>:
    route.execution = 100
    Err("no")
fn inc(x: &mut i64):
    x = x + 1
fn fill(mut buf: [u8]):
    buf[0] = 7u8
fn nofill(buf: [u8]):
    pass
fn arr_b(a: &mut [i64]):
    a.push(3)
fn dict_b(d: &mut Dict<text,i64>):
    d["k"] = 1
class Holder:
    buf: [u8]
class C:
    n: i64
    fn fill(mut buf: [u8]):
        buf[0] = 7u8
describe "borrow":
    it "direct":
        var r = mk()
        bump(&mut r)
        expect(r.execution).to_equal(2)
    it "bare ident to &mut":
        var r = mk()
        bump(r)
        expect(r.execution).to_equal(2)
    it "nested bare":
        var r = mk()
        bump2(&mut r)
        expect(r.execution).to_equal(2)
    it "nested explicit":
        var r = mk()
        bump3(&mut r)
        expect(r.execution).to_equal(2)
    it "deep projections":
        var r = mk()
        deep(&mut r)
        expect(r.inner.v).to_equal(9)
        expect(r.items).to_equal([5, 2])
    it "whole replace":
        var r = mk()
        r.execution = 44
        replace(&mut r)
        expect(r.execution).to_equal(1)
    it "field place":
        var b = Box2(route: mk())
        bump(&mut b.route)
        expect(b.route.execution).to_equal(2)
    it "index place":
        var rs = [mk(), mk()]
        bump(&mut rs[1])
        expect(rs[1].execution).to_equal(2)
        expect(rs[0].execution).to_equal(1)
    it "method param":
        var r = mk()
        val b = Box2(route: mk())
        b.m(&mut r)
        expect(r.execution).to_equal(50)
    it "me self field":
        var b = Box2(route: mk())
        b.own_bump()
        expect(b.route.execution).to_equal(2)
    it "by-value struct unchanged":
        var r = mk()
        by_value(r)
        by_value_mut(r)
        expect(r.execution).to_equal(1)
    it "scalar":
        var x = 1
        inc(&mut x)
        expect(x).to_equal(2)
    it "array and dict":
        var a = [1]
        arr_b(&mut a)
        expect(a).to_equal([1, 3])
        var d: Dict<text,i64> = {}
        dict_b(&mut d)
        expect(d["k"]).to_equal(1)
    it "u8 free fn":
        var o: [u8] = [0u8, 0u8]
        fill(o)
        expect(o).to_equal([7u8, 0u8])
    it "u8 method":
        val c = C(n: 0)
        var o: [u8] = [0u8, 0u8]
        c.fill(o)
        expect(o).to_equal([7u8, 0u8])
    it "u8 object field argument":
        var h = Holder(buf: [0u8, 0u8])
        fill(h.buf)
        expect(h.buf).to_equal([7u8, 0u8])
