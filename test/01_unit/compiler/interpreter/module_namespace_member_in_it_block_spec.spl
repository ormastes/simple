# Regression: module-namespace member calls inside an sspec `it` block must not
# inject an implicit `self` (bug module_namespace_member_call_in_spec_it_block_2026-07-27).
# Covers interpolation, matcher-chain, comparison and assignment positions, for a
# member that is also a bare global (file_exists) and one that is not (exists).
use std.fs
use std.spec

val P = "test/01_unit/compiler/interpreter/module_namespace_member_in_it_block_spec.spl"

describe "module-namespace member call in it block":
    it "interpolation, bare-global member":
        val s = "{fs.file_exists(P)}"
        expect(s).to_equal("true")
    it "interpolation, namespace-only member":
        val s = "{fs.exists(P)}"
        expect(s).to_equal("true")
    it "matcher chain, namespace-only member":
        expect(fs.exists(P)).to_equal(true)
    it "comparison inside expect":
        expect(fs.exists(P) == true).to_equal(true)
    it "assignment position":
        val v = fs.exists(P)
        expect(v).to_equal(true)
