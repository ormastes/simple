# @req REQ-SSPEC-COMPILER
# @tag:in-development
"""
OPEN bug seed_enum_variant_bare_name_last_registration_wins_2026_10_19 (sibling of
interp_class_name_collision_breaks_test_db_persistence_2026-08-10): a braced import
of another module's function co-loads its same-named enum, which replaces the
importer's enum by bare name. Expected to FAIL until enums are keyed per owner
in the flattened lane like classes now are.
"""
use std.spec.*
use test.fixtures.flat_fn_shadow.enum_a.{Mode}
use test.fixtures.flat_fn_shadow.enum_b.{mode_b_name}

describe "same-name enums in two co-loaded modules":
    it "importer's Mode and other module's Mode stay distinct":
        val m = Mode.Slow
        expect(m == Mode.Slow).to_equal(true)
        expect(mode_b_name()).to_equal("blue")
