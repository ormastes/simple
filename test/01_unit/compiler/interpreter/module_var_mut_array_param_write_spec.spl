# A module-level `var` array passed to a `mut` array parameter must observe the
# callee's element writes, both when the call runs at module scope and when it
# runs inside a function body.
# Bug: doc/08_tracking/bug/seed_interp_module_var_mut_array_param_write_back_lost_2026-11-04.md
use std.spec.*

class Holder:
    data: [i64]

var top_i64: [i64] = [0; 4]
var top_u8: [u8] = [0u8; 4]
var top_f64: [f64] = [0.0; 4]
var top_depth: [i64] = [0; 4]
var top_holder = Holder(data: [0; 4])
var fn_i64: [i64] = [0; 4]
var fn_u8: [u8] = [0u8; 4]

fn fill(mut meta: [i64], mut pixels: [u8]):
    pixels[3] = 200u8
    meta[0] = 7
fn set_f64(mut xs: [f64]):
    xs[1] = 2.5
fn set_i64(mut xs: [i64]):
    xs[2] = 42
fn outer_i64(mut xs: [i64]):
    set_i64(xs)

fill(top_i64, top_u8)
set_f64(top_f64)
outer_i64(top_depth)
set_i64(top_holder.data)

describe "module var mut array param write-back":
    it "module-scope call writes back [i64]":
        expect(top_i64[0]).to_equal(7)
    it "module-scope call writes back [u8]":
        expect(top_u8[3]).to_equal(200u8)
    it "module-scope call writes back [f64]":
        expect(top_f64[1]).to_equal(2.5)
    it "module-scope call writes back at depth 2":
        expect(top_depth[2]).to_equal(42)
    it "module-scope call writes back a struct-held array":
        expect(top_holder.data[2]).to_equal(42)
    it "function-body call writes back module [i64] and [u8]":
        fill(fn_i64, fn_u8)
        expect(fn_i64[0]).to_equal(7)
        expect(fn_u8[3]).to_equal(200u8)
