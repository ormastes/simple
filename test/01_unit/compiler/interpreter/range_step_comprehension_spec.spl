# Regression pins for the stepped-range miscompile.
#
# `range(start, end, step)` had its THIRD argument read as an "inclusive"
# truthy flag instead of a step, so `range(0, 10, 2)` silently evaluated to
# 0..=10 (step dropped AND the bound flipped to inclusive) and
# `range(5, 0, -1)` evaluated to the empty range. Both produced a wrong VALUE
# with no error. Fixed by carrying an explicit `step` field on the range
# object and honouring it in both iteration sites.

describe "stepped range":
    it "honours a positive step in a comprehension":
        expect [for x in range(0, 10, 2): x] == [0, 2, 4, 6, 8]

    it "honours a negative step in a comprehension":
        expect [for x in range(5, 0, -1): x] == [5, 4, 3, 2, 1]

    it "does not flip the end bound to inclusive when a step is given":
        # The pre-fix bug made the end INCLUSIVE, yielding a trailing 10.
        expect [for x in range(0, 10, 2): x].len() == 5

    it "honours a positive step in a statement loop":
        var out = []
        for x in range(0, 10, 2):
            out.push(x)
        expect out == [0, 2, 4, 6, 8]

    it "honours a negative step in a statement loop":
        var out = []
        for x in range(5, 0, -1):
            out.push(x)
        expect out == [5, 4, 3, 2, 1]

    it "keeps two-argument ranges exclusive":
        expect [for x in range(0, 5): x] == [0, 1, 2, 3, 4]

    it "yields nothing for a zero step instead of looping forever":
        expect [for x in range(0, 5, 0): x] == []

    it "yields nothing when a positive step runs away from the end":
        expect [for x in range(5, 0, 1): x] == []
