"""
## Purpose and audience
Purpose: Prove that interpreter mixed numeric arithmetic.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERPRETER-001 — stable requirement identity for this spec.

use std.spec.step

describe "interpreter mixed numeric arithmetic":
    it "promotes either operand for addition":
        step("Verify: promotes either operand for addition")
        # @req: REQ-COMPILER-INTERPRETER-001
        expect(2 + 0.5).to_equal(2.5)  # oracle: 2.5 — named expected value from the requirement
        expect(0.5 + 2).to_equal(2.5)  # oracle: 2.5 — named expected value from the requirement
        expect(-3 + 0.5).to_equal(-2.5)  # oracle: -2.5 — named expected value from the requirement
        expect(0 + 0.5).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement

    it "promotes either operand for subtraction":
        step("Verify: promotes either operand for subtraction")
        expect(2 - 0.5).to_equal(1.5)  # oracle: 1.5 — named expected value from the requirement
        expect(2.5 - 2).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement

    it "promotes either operand for multiplication":
        step("Verify: promotes either operand for multiplication")
        expect(2 * 0.5).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(0.5 * 2).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    it "promotes either operand for division":
        step("Verify: promotes either operand for division")
        expect(5 / 2.0).to_equal(2.5)  # oracle: 2.5 — named expected value from the requirement
        expect(5.0 / 2).to_equal(2.5)  # oracle: 2.5 — named expected value from the requirement
