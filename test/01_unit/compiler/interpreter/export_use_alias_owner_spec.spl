use std.spec.*
use test.fixtures.export_alias_owner.owner_b.{is_dir}
use test.fixtures.export_alias_owner.facade.{fa_is_dir}

# `export use A.{is_dir as fa_is_dir}` must bind the alias to A's symbol even
# when another co-compiled module (owner_b) defines the same name.
# doc/08_tracking/bug/seed_export_use_as_alias_binds_wrong_owner_2026-11-26.md
describe "export use alias with a co-compiled same-named function":
    it "resolves the alias to the named owner":
        expect(fa_is_dir("x")).to_equal("owner_a")

    it "keeps the directly imported same-named function on its own owner":
        expect(is_dir("x")).to_equal("owner_b")
