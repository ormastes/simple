# Run-path probe for dotq_jit_interp_parity_spec.spl: one `name=value` line per
# `.?` / `??` shape. Expected values are the pure-Simple contract
# (seed_jit_dotq_coalesce_parity_2026-11-06).
fn opt_nil_payload() -> i64?:
    Some(nil)

fn main() -> i64:
    val c = opt_nil_payload()
    print "some_nil_coalesce={c ?? 7}"
    val n: i64? = nil
    print "nil_coalesce={n ?? 9}"
    val z: i64? = Some(0)
    print "some_zero_coalesce={z ?? 7}"
    val e: Result<i64, text> = Err("e")
    if e.?:
        print "err_if_present=true"
    else:
        print "err_if_present=false"
    val ok: Result<i64, text> = Ok(1)
    if ok.?:
        print "ok_if_present=true"
    else:
        print "ok_if_present=false"
    print "not_some_zero={not z.?}"
    print "not_nil={not n.?}"
    if z.?:
        print "some_zero_if=true"
    else:
        print "some_zero_if=false"
    0
