# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# `i64 as usize` must work inside a spec context.

use std.spec.step

use std.spec.*

struct Pos:
    position: usize

fn mk(offset: i64) -> Pos:
    Pos(position: offset as usize)

describe "i64 as usize":
    it "casts in a struct constructor argument":
        # @req REQ-SSPEC-COMPILER
        step("casts in a struct constructor argument")
        val p = mk(5)
        expect(p.position).to_equal(5)
