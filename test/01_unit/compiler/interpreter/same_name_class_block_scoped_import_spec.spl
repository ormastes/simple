# Purpose and audience: compiler engineers who own class identity across
# flattened and lazily loaded modules (test-runner interpreter lane).
# @req REQ-SSPEC-UNIT
# Tracks: interpreter_lazy_same_name_class_entry_ambiguous_type_2026_11_27
"""
# Block-scoped imports of same-named classes resolve by owner

`use` statements written inside a function body (or an `it` block) load
their module lazily through `load_and_merge_module`: the imported
constructor is bound in the local/global surface, but no owner binding is
recorded for the entry module. Two such imports of same-named classes used
to fail on the bare name with `ambiguous type Thing: ... none of them is
imported by <entry>` even though the entry imported exactly one of them.
The constructor binding IS the import: the bare name must resolve to the
class the import bound, and the alias to its owner class.
"""

use std.spec.step

use std.spipe.*

describe "block-scoped imports of same-named classes keep their owners":
    it "resolves the bare name and the alias to their owner classes":
        step("resolves the bare name and the alias to their owner classes")
        use test.fixtures.same_name_class.pa.{Thing}
        use test.fixtures.same_name_class.pb.{Thing as Legacy}
        val a = Thing.create()
        val l = Legacy.create()
        expect(a.n).to_equal(1)
        expect(a.compile()).to_equal(24)
        expect(Thing.tag()).to_equal(100)
        expect(a.label()).to_equal(7)
        expect(l.n).to_equal(2)
        expect(l.size()).to_equal(10)
        expect(l.compile()).to_equal(1010)
        expect(Legacy.tag()).to_equal(200)
        expect(l.label()).to_equal(8)
