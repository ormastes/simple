# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Interpreter / JIT consistency guard for class-reference semantics.
#
# Bug interp_dict_class_value_index_mutation_loss_2026-11-03 (bug_db.sdn):
# in the seed interpreter `val e = d["k"]; e.v = 2` left `d["k"].v` at 0 and
# `d["k"].v = 2` died with "cannot convert string to int", while the JIT kept
# the mutation. Policy (interpreter_binding_class_typed_field_snapshots_
# instead_of_aliasing_2026-08-10.md, 2026-11-02 plan): classes are reference
# types, structs are value types, and the two engines must agree.
#
# The oracle is the sibling run-path probe `probe_class_ref_consistency.spl`:
# the same program reaches an instance four ways (list element, dict value,
# class field, class param), mutates it through the binding and reads it back
# through the container, printing one `name=value` line per shape. The spec
# runs it under BOTH engines and compares the outputs line for line.
#
# ENGINE SCOPE. The interpreter's reference carrier (`Value::ClassInstance`)
# is opt-in until plan step 5 flips `Value::aggregate()` for real
# (`SIMPLE_INTERP_CLASS_REF=1`, src/compiler_rust/compiler/src/value.rs).
# The consistency arm therefore runs the interpreter WITH that flag; the
# default-carrier arm pins only what is fixed there today: `d["k"].v = 2` is
# an assignment target instead of an error.

use std.spec.step

use std.spec.*
use std.io_runtime.{process_run, env_get}


val PROBE_PATH: text = "test/01_unit/compiler/interpreter/probe_class_ref_consistency.spl"

fn run_probe(env_prefix: text) -> text:
    run_probe_file(PROBE_PATH, env_prefix)

fn run_probe_file(path: text, env_prefix: text) -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = "SIMPLE_RUST_SEED_WARNING=0 " + env_prefix + " " + bin + " run " + path + " 2>/dev/null"
    val out = process_run("sh", ["-c", cmd])
    out.0

describe "interpreter and JIT agree on class-reference semantics":
    # @manual scenario evidence
    it "keeps a mutation through all four reach shapes in both engines":
        # @req REQ-SSPEC-COMPILER
        step("Run the probe on the JIT and on the interpreter's reference carrier")
        val jit = run_probe("SIMPLE_EXECUTION_MODE=jit")
        val interp = run_probe("SIMPLE_EXECUTION_MODE=interpreter SIMPLE_INTERP_CLASS_REF=1")

        step("Every shape reads back the mutation on the JIT (the reference oracle)")
        expect(jit).to_contain("list_element=2")
        expect(jit).to_contain("dict_value=2")
        expect(jit).to_contain("class_field=2")
        expect(jit).to_contain("class_param=2")

        step("The interpreter prints the same four lines")
        expect(interp).to_contain("list_element=2")
        expect(interp).to_contain("dict_value=2")
        expect(interp).to_contain("class_field=2")
        expect(interp).to_contain("class_param=2")

        step("The whole probe output is identical line for line")
        expect(interp).to_equal(jit)

    it "treats d[k].field as an assignment target and shares dict siblings":
        # @req REQ-SSPEC-COMPILER
        step("Direct target, nested dict-in-class and dict iteration under both engines")
        val jit = run_probe("SIMPLE_EXECUTION_MODE=jit")
        val interp = run_probe("SIMPLE_EXECUTION_MODE=interpreter SIMPLE_INTERP_CLASS_REF=1")
        expect(jit).to_contain("dict_direct_target=2")
        expect(jit).to_contain("nested_dict_in_class=2")
        expect(jit).to_contain("dict_iteration=2")
        expect(interp).to_contain("dict_direct_target=2")
        expect(interp).to_contain("nested_dict_in_class=2")
        expect(interp).to_contain("dict_iteration=2")

    it "keeps value types copied: a struct read from a dict is independent":
        # @req REQ-SSPEC-COMPILER
        val jit = run_probe("SIMPLE_EXECUTION_MODE=jit")
        val interp = run_probe("SIMPLE_EXECUTION_MODE=interpreter SIMPLE_INTERP_CLASS_REF=1")
        expect(jit).to_contain("struct_dict_value_copied=0")
        expect(interp).to_contain("struct_dict_value_copied=0")

describe "default interpreter carrier (copy-on-write Object)":
    # @manual scenario evidence
    it "accepts d[k].field = v as an assignment target instead of erroring":
        # @req REQ-SSPEC-COMPILER
        step("Before the fix the index was converted to int before the receiver kind was checked")
        val out = run_probe("SIMPLE_EXECUTION_MODE=interpreter")
        expect(out).to_contain("dict_direct_target=2")
        expect(out).to_contain("class_param=2")

    it "keeps the default unchanged: SIMPLE_INTERP_CLASS_REF=0 behaves exactly like unset":
        # @req REQ-SSPEC-COMPILER
        step("The reference carrier is opt-in; only the literal value 1 enables it")
        val unset = run_probe("SIMPLE_EXECUTION_MODE=interpreter")
        val off = run_probe("SIMPLE_EXECUTION_MODE=interpreter SIMPLE_INTERP_CLASS_REF=0")
        expect(off).to_equal(unset)
        step("Flag on and flag off must differ on the shapes only the reference carrier shares")
        val on = run_probe("SIMPLE_EXECUTION_MODE=interpreter SIMPLE_INTERP_CLASS_REF=1")
        expect(on).to_contain("list_element=2")

val JIT_ENV: text = "SIMPLE_EXECUTION_MODE=jit"
val INTERP_ENV: text = "SIMPLE_EXECUTION_MODE=interpreter SIMPLE_INTERP_CLASS_REF=1"

describe "u64 field store and compare above i64 max (parity)":
    # @manual scenario evidence
    it "keeps 0xFFFF_FFFF_FFFF_FFF0 unsigned on the JIT (oracle)":
        # @req REQ-SSPEC-COMPILER
        val jit = run_probe_file("test/01_unit/compiler/interpreter/probe_u64_field_parity.spl", JIT_ENV)
        expect(jit).to_contain("a=true")
        expect(jit).to_contain("b=true")
        expect(jit).to_contain("c=true")
        expect(jit).to_contain("d=18446744073709551601")

describe "Dict.get returns Option (parity)":
    # @manual scenario evidence
    it "reports hit and miss for text, class and struct values on both engines":
        # @req REQ-SSPEC-COMPILER
        val p = "test/01_unit/compiler/interpreter/probe_dict_get_option.spl"
        val jit = run_probe_file(p, JIT_ENV)
        val interp = run_probe_file(p, INTERP_ENV)
        expect(jit).to_contain("t1=some:hello")
        expect(jit).to_contain("t2=none")
        expect(jit).to_contain("c1=some:7")
        expect(jit).to_contain("c2=none")
        expect(jit).to_contain("p1=some:9")
        expect(jit).to_contain("p2=none")
        expect(interp).to_equal(jit)

    it "keeps a stored 3 present and a miss absent through ?? and .? on both engines":
        # @req REQ-SSPEC-COMPILER
        # Bug jit_dict_get_option_presence_in_string_interp_2026-11-03: the JIT
        # returned the bare stored word, so a stored 3 read as the nil sentinel.
        val p = "test/01_unit/compiler/interpreter/probe_dict_get_presence.spl"
        val jit = run_probe_file(p, JIT_ENV)
        val interp = run_probe_file(p, INTERP_ENV)
        expect(jit).to_contain("t_hit=hello")
        expect(jit).to_contain("t_miss=none")
        expect(jit).to_contain("i_hit=5")
        expect(jit).to_contain("i_three=3")
        expect(jit).to_contain("i_miss=-1")
        expect(jit).to_contain("q_miss_is_nil=true")
        expect(jit).to_contain("tail=ok")
        expect(interp).to_equal(jit)

    it "decodes f64, bool and u64 Dict.get payloads like the interpreter":
        # @req REQ-SSPEC-COMPILER
        val p = "test/01_unit/compiler/interpreter/probe_dict_get_primitives.spl"
        val jit = run_probe_file(p, JIT_ENV)
        val interp = run_probe_file(p, INTERP_ENV)
        expect(jit).to_contain("f=2.5")
        expect(jit).to_contain("b=true false true")
        expect(jit).to_contain("ifb=true")
        expect(jit).to_contain("u=8")
        expect(jit).to_contain("mf=3.0")
        expect(jit).to_contain("g_some=true")
        expect(interp).to_equal(jit)

describe "one class reference reached via list, dict, struct field and param":
    # @manual scenario evidence
    it "observes a mutation made through any carrier via all the others":
        # @req REQ-SSPEC-COMPILER
        val p = "test/01_unit/compiler/interpreter/probe_shared_class_ref.spl"
        val jit = run_probe_file(p, JIT_ENV)
        expect(jit).to_contain("shared_via_list_seen_dict=1")
        expect(jit).to_contain("shared_via_dict_seen_holder=2")
        expect(jit).to_contain("shared_via_field_seen_list=3")
        expect(jit).to_contain("shared_via_param_seen_all=2222")
        expect(run_probe_file(p, INTERP_ENV)).to_equal(jit)
