# Pure-Simple core interpreter: library unit suffix scope covers every org dir
# under the unit library root (src/unit/<org>/<family>/<sfx>.spl), not only
# `simple-lang`. Fixture orgs live under a temp root (build/ is gitignored).
# Runtime: src/compiler/10.frontend/core/interpreter/eval_units.spl.
# Import lists use r"..." so `{rpmx}` is not interpolated by the spec itself.
use std.spec.{describe, it, expect}
use std.io_runtime.{file_write}
use compiler.frontend.core.interpreter.mod.{core_interpret}
use compiler.frontend.core.interpreter.value.{val_get_int}
use compiler.frontend.core.interpreter.eval.{eval_get_error}
use compiler.frontend.core.interpreter.eval_units.{unit_library_set_base}
use compiler.frontend.core.interpreter.module_loader_resolve.{unit_library_root_from_simple_lib}

val FIXTURE_ROOT: text = "build/tmp/use_unit_suffix_org_scope_spec/unit"

fn setup_fixture():
    file_write(FIXTURE_ROOT + "/acme/robotics/rpmx.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/acme/robotics/__init__.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/beta.com/robotics/rpmx.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/beta.com/robotics/__init__.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/simple-lang/robotics/__init__.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/simple-lang/velocity/kmph.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/acme/robotics/rpma.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/velocity/misc/rpmv.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/gamma/robotics/rpmg.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/gamma/robotics/__init__.spl", "# fixture\n")
    file_write(FIXTURE_ROOT + "/simple-lang/gamma/robotics/__init__.spl", "# fixture\n")
    unit_library_set_base(FIXTURE_ROOT)

fn probe(src: text) -> text:
    setup_fixture()
    val result = core_interpret(src + "\n", "use_unit_suffix_org_scope_probe.spl")
    val err = eval_get_error()
    unit_library_set_base("")
    if err != "": return "ERR:" + err
    "" + val_get_int(result)

describe "core interpreter unit suffix scope across orgs":
    it "rejects a non-simple-lang org suffix that is not imported":
        expect(probe("val r = 3_rpmx\nr.value()")).to_start_with("ERR:unit suffix 'rpmx' is not in scope")

    it "names every org import that would admit the suffix":
        val out = probe("val r = 3_rpmx\nr.value()")
        expect(out).to_contain(r"`use unit.acme.robotics.{rpmx}`")
        expect(out).to_contain(r"`use unit.beta.robotics.{rpmx}`")

    it "keeps the short form for the simple-lang org":
        expect(probe("val s = 60_kmph\ns.value()")).to_contain(r"`use unit.velocity.{kmph}`")

    it "accepts an org-qualified selective import":
        expect(probe(r"use unit.acme.robotics.{rpmx}" + "\nval r = 3_rpmx\nr.value()")).to_equal("3")

    it "accepts an org-qualified family glob import":
        expect(probe("use unit.acme.robotics.*\nval r = 4_rpmx\nr.value()")).to_equal("4")

    it "accepts a .com org-qualified family import":
        expect(probe("use unit.beta.com.robotics\nval r = 5_rpmx\nr.value()")).to_equal("5")

    it "does not admit an org suffix through a same-named simple-lang family":
        expect(probe("use unit.robotics.*\nval r = 6_rpmx\nr.value()")).to_start_with("ERR:unit suffix 'rpmx'")

    it "keys a selective import by org: another org's suffix is not admitted":
        expect(probe(r"use unit.beta.robotics.{rpma}" + "\nval r = 7_rpma\nr.value()")).to_start_with("ERR:unit suffix 'rpma' is not in scope")

    it "a selective org import still admits its own org's suffix":
        expect(probe(r"use unit.acme.robotics.{rpma}" + "\nval r = 8_rpma\nr.value()")).to_equal("8")

    it "routes an org name colliding with a simple-lang family to the path that exists":
        expect(probe("use unit.velocity.kmph\nval s = 9_kmph\ns.value()")).to_equal("9")

    it "reports an import that resolves under both an org and a simple-lang family":
        val out = probe("use unit.gamma.robotics.*\nval r = 1_rpmg\nr.value()")
        expect(out).to_start_with("ERR:unit suffix 'rpmg' is not in scope")
        expect(out).to_contain("is ambiguous")

describe "core interpreter unit library root resolution":
    it "fails closed when the unit library root does not exist":
        unit_library_set_base("build/tmp/use_unit_suffix_org_scope_spec/no_such_unit_root")
        val result = core_interpret("val s = 60_kmph\ns.value()\n", "use_unit_root_probe.spl")
        val err = eval_get_error()
        unit_library_set_base("")
        expect(err).to_contain("unit library root not found")

    it "auto-resolves the default root without an override":
        unit_library_set_base("")
        val result = core_interpret("val s = 60_kmph\ns.value()\n", "use_unit_root_probe.spl")
        expect(eval_get_error()).to_contain(r"`use unit.velocity.{kmph}`")

    it "resolves the root from the canonical SIMPLE_LIB=<root>/src":
        expect(unit_library_root_from_simple_lib("src")).to_equal("src/unit")
        expect(unit_library_root_from_simple_lib("src/")).to_equal("src/unit")

    it "accepts the SIMPLE_LIB=<src>/lib sibling form":
        expect(unit_library_root_from_simple_lib("src/lib")).to_equal("src/unit")

    it "yields no root when SIMPLE_LIB points nowhere":
        expect(unit_library_root_from_simple_lib("build/tmp/no_such_simple_lib")).to_equal("")
