"""
# (module path, name)-keyed function resolution — pure-Simple mirror

Seed-policy mirror (2026-08-25) of the Rust seed's cross-module duplicate
free-function fix: the flat bare-name function table is last-write-wins, so
two co-compiled modules that each define the same free function silently
shadow each other by load order — the mechanism behind BOTH 2026-08-25
llm_caret incidents (`extract_json_string` hijacked by std.mcp.helpers,
`char_from_code` hijacked by encoding/utf8). See
doc/08_tracking/bug/co_compiled_symbol_collision_decision_2026-08-09.md.

The mirror keys a twin registration on (owner module path, name)
(`func_table_register_owned`, populated by
module_loader_core.register_module_functions) plus a per-importer
selective-import binding table (`func_import_binding_register`, populated by
eval_decls DECL_USE), and resolves a call through the CALLER first
(`func_resolve_for_caller`): own definition, then import binding, then the
flat table's historical pick.

This file drives the resolver directly (same technique as
`import_admission_critical_spec.spl`): register two same-named decls under
two owners, bind an importer to one of them, and assert each caller gets its
own module's / its imported module's decl — not the flat-table winner.
"""

use compiler.core.ast.{ast_reset, decl_fn}
use compiler.core.interpreter.eval_tables.{
    func_table_reset,
    func_table_register,
    func_table_lookup,
    func_table_register_owned,
    func_table_lookup_owned,
    func_import_binding_register,
    func_import_binding_lookup,
    func_import_binding_reset,
    func_resolve_for_caller,
    func_module_namespace_lookup,
    func_resolve_module_member_for_caller
}
use compiler.core.interpreter.module_loader_core.{
    module_loader_init, module_mark_loaded, record_module_surface,
    load_module_selective_with_unbraced_alias, register_deferred_module,
    try_force_any_deferred_for
}

val MOD_A: text = "src/fixture/mod_a.spl"
val MOD_B: text = "src/fixture/mod_b.spl"
val MOD_FACADE: text = "src/fixture/facade.spl"
val SPEC_FILE: text = "test/fixture/who_spec.spl"

fn setup_collision() -> (i64, i64):
    ast_reset()
    func_table_reset()
    func_import_binding_reset()
    val did_a = decl_fn("who", [], [], 0, [], 0, [], 0)
    val did_b = decl_fn("who", [], [], 0, [], 0, [], 0)
    # Flat table: last write wins (mod_b), reproducing the load-order hazard.
    func_table_register("who", did_a)
    func_table_register_owned(MOD_A, "who", did_a)
    func_table_register("who", did_b)
    func_table_register_owned(MOD_B, "who", did_b)
    (did_a, did_b)

describe "(module path, name)-keyed function resolution":
    it "flat bare-name table alone is last-write-wins (the hazard)":
        val pair = setup_collision()
        expect(func_table_lookup("who")).to_equal(pair.1)

    it "keeps both definitions reachable under their owner keys":
        val pair = setup_collision()
        expect(func_table_lookup_owned(MOD_A, "who")).to_equal(pair.0)
        expect(func_table_lookup_owned(MOD_B, "who")).to_equal(pair.1)

    it "a caller module that defines the name gets ITS OWN definition":
        val pair = setup_collision()
        # mod_a lost the flat-table race, but a call from inside mod_a must
        # still reach mod_a's body.
        expect(func_resolve_for_caller(MOD_A, "who")).to_equal(pair.0)
        expect(func_resolve_for_caller(MOD_B, "who")).to_equal(pair.1)

    it "a caller resolves through its own selective-import binding":
        val pair = setup_collision()
        func_import_binding_register(SPEC_FILE, "who", MOD_A)
        expect(func_import_binding_lookup(SPEC_FILE, "who")).to_equal(MOD_A)
        # The spec imported `who` from mod_a only; the flat table would have
        # served mod_b's. The caller-aware route must win.
        expect(func_resolve_for_caller(SPEC_FILE, "who")).to_equal(pair.0)

    it "binds an aliased import to the original callable without exposing its old name":
        val pair = setup_collision()
        func_import_binding_register(SPEC_FILE, "who:chosen", MOD_A)
        expect(func_import_binding_lookup(SPEC_FILE, "chosen")).to_equal(MOD_A)
        expect(func_import_binding_lookup(SPEC_FILE, "who")).to_equal("")
        expect(func_resolve_for_caller(SPEC_FILE, "chosen")).to_equal(pair.0)
        expect(func_resolve_for_caller(SPEC_FILE, "who")).to_equal(-1)

    it "follows two aliased re-export hops using each source name":
        val pair = setup_collision()
        func_import_binding_register(MOD_FACADE, "who:forwarded", MOD_A)
        func_import_binding_register(SPEC_FILE, "forwarded:public", MOD_FACADE)
        expect(func_resolve_for_caller(SPEC_FILE, "public")).to_equal(pair.0)

    it "routes a missing complete module through its parent's exported item":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val provider_file = "spec/fixture/ru011_provider.spl"
        val facade_file = "spec/fixture/ru011_facade.spl"
        val origin = decl_fn("orig", [], [], 0, [], 0, [], 0)
        func_table_register_owned(provider_file, "orig", origin)
        module_mark_loaded("ru011_spec.provider", provider_file, [])
        record_module_surface(provider_file, [origin])
        val loaded = load_module_selective_with_unbraced_alias(
            "ru011_spec.provider.orig",
            ["ru011_spec.provider.orig:public_orig"], facade_file)
        expect(loaded).to_equal(1)
        expect(func_import_binding_lookup(facade_file, "public_orig")).to_equal(provider_file)
        expect(func_import_binding_lookup(facade_file, "orig")).to_equal("")
        expect(func_resolve_for_caller(facade_file, "public_orig")).to_equal(origin)

    it "keeps a present complete module ahead of the parent item":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val parent_file = "spec/fixture/ru011_parent.spl"
        val complete_file = "spec/fixture/ru011_complete.spl"
        val facade_file = "spec/fixture/ru011_complete_facade.spl"
        val origin = decl_fn("orig", [], [], 0, [], 0, [], 0)
        func_table_register_owned(complete_file, "orig", origin)
        module_mark_loaded("ru011_spec.provider", parent_file, [])
        module_mark_loaded("ru011_spec.provider.orig", complete_file, [])
        val loaded = load_module_selective_with_unbraced_alias(
            "ru011_spec.provider.orig",
            ["ru011_spec.provider.orig:local"], facade_file)
        expect(loaded).to_equal(1)
        expect(func_module_namespace_lookup(facade_file, "local")).to_equal(complete_file)
        expect(func_resolve_module_member_for_caller(facade_file, "local", "orig")).to_equal(origin)
        expect(func_import_binding_lookup(facade_file, "local")).to_equal("")
        expect(func_resolve_for_caller(facade_file, "orig")).to_equal(-1)

    it "forces a lazy complete-module namespace before member lookup":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val owner_file = "spec/fixture/ru011_lazy_complete.spl"
        val caller_file = "spec/fixture/ru011_lazy_complete_caller.spl"
        val origin = decl_fn("answer", [], [], 0, [], 0, [], 0)
        func_table_register_owned(owner_file, "answer", origin)
        module_mark_loaded("ru011_spec.complete", owner_file, [])
        register_deferred_module("ru011_spec.complete", caller_file,
            ["ru011_spec.complete:ns"])
        expect(try_force_any_deferred_for("ns", caller_file)).to_equal(1)
        expect(func_module_namespace_lookup(caller_file, "ns")).to_equal(owner_file)
        expect(func_resolve_module_member_for_caller(caller_file, "ns", "answer")).to_equal(origin)

    it "rejects a missing parent item without registering the alias":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val provider_file = "spec/fixture/ru011_missing_provider.spl"
        val facade_file = "spec/fixture/ru011_missing_facade.spl"
        val present = decl_fn("present", [], [], 0, [], 0, [], 0)
        module_mark_loaded("ru011_spec.missing_provider", provider_file, [])
        record_module_surface(provider_file, [present])
        val loaded = load_module_selective_with_unbraced_alias(
            "ru011_spec.missing_provider.absent",
            ["ru011_spec.missing_provider.absent:local"], facade_file)
        expect(loaded).to_equal(0)
        expect(func_import_binding_lookup(facade_file, "local")).to_equal("")

    it "forces a lazy unbraced alias on first use of its local name":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val provider_file = "spec/fixture/ru011_lazy_provider.spl"
        val caller_file = "spec/fixture/ru011_lazy_caller.spl"
        val origin = decl_fn("orig", [], [], 0, [], 0, [], 0)
        func_table_register_owned(provider_file, "orig", origin)
        module_mark_loaded("ru011_spec.lazy_provider", provider_file, [])
        record_module_surface(provider_file, [origin])
        register_deferred_module("ru011_spec.lazy_provider.orig", caller_file,
            ["ru011_spec.lazy_provider.orig:local"])
        expect(try_force_any_deferred_for("local", caller_file)).to_equal(1)
        expect(func_resolve_for_caller(caller_file, "local")).to_equal(origin)

    it "forces only the requesting caller's lazy alias":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val first_file = "spec/fixture/ru011_first_provider.spl"
        val second_file = "spec/fixture/ru011_second_provider.spl"
        val first_caller = "spec/fixture/ru011_first_caller.spl"
        val second_caller = "spec/fixture/ru011_second_caller.spl"
        val first = decl_fn("first", [], [], 0, [], 0, [], 0)
        val second = decl_fn("second", [], [], 0, [], 0, [], 0)
        func_table_register_owned(first_file, "first", first)
        func_table_register_owned(second_file, "second", second)
        module_mark_loaded("ru011_spec.first_provider", first_file, [])
        module_mark_loaded("ru011_spec.second_provider", second_file, [])
        record_module_surface(first_file, [first])
        record_module_surface(second_file, [second])
        register_deferred_module("ru011_spec.first_provider.first", first_caller,
            ["ru011_spec.first_provider.first:local"])
        register_deferred_module("ru011_spec.second_provider.second", second_caller,
            ["ru011_spec.second_provider.second:local"])
        expect(try_force_any_deferred_for("local", second_caller)).to_equal(1)
        expect(func_resolve_for_caller(second_caller, "local")).to_equal(second)
        expect(func_import_binding_lookup(first_caller, "local")).to_equal("")

    it "keeps two callers' deferred aliases for the same module distinct":
        module_loader_init()
        ast_reset()
        func_table_reset()
        func_import_binding_reset()
        val provider_file = "spec/fixture/ru011_shared_provider.spl"
        val first_caller = "spec/fixture/ru011_shared_first.spl"
        val second_caller = "spec/fixture/ru011_shared_second.spl"
        val origin = decl_fn("orig", [], [], 0, [], 0, [], 0)
        func_table_register_owned(provider_file, "orig", origin)
        module_mark_loaded("ru011_spec.shared_provider", provider_file, [])
        record_module_surface(provider_file, [origin])
        register_deferred_module("ru011_spec.shared_provider.orig", first_caller,
            ["ru011_spec.shared_provider.orig:first_local"])
        register_deferred_module("ru011_spec.shared_provider.orig", second_caller,
            ["ru011_spec.shared_provider.orig:second_local"])
        expect(try_force_any_deferred_for("second_local", second_caller)).to_equal(1)
        expect(func_resolve_for_caller(second_caller, "second_local")).to_equal(origin)
        expect(func_import_binding_lookup(first_caller, "first_local")).to_equal("")
        expect(try_force_any_deferred_for("first_local", first_caller)).to_equal(1)
        expect(func_resolve_for_caller(first_caller, "first_local")).to_equal(origin)

    it "replaces the source and owner together when a local alias is rebound":
        setup_collision()
        val replacement = decl_fn("elsewhere", [], [], 0, [], 0, [], 0)
        func_table_register_owned(MOD_B, "elsewhere", replacement)
        func_import_binding_register(SPEC_FILE, "who:chosen", MOD_A)
        func_import_binding_register(SPEC_FILE, "elsewhere:chosen", MOD_B)
        expect(func_resolve_for_caller(SPEC_FILE, "chosen")).to_equal(replacement)

    it "keeps malformed alias encodings literal instead of binding another name":
        setup_collision()
        func_import_binding_register(SPEC_FILE, "who:", MOD_A)
        expect(func_import_binding_lookup(SPEC_FILE, "who:")).to_equal(MOD_A)
        expect(func_import_binding_lookup(SPEC_FILE, "who")).to_equal("")

    it "a caller with no route falls back to the flat table (-1 sentinel)":
        setup_collision()
        expect(func_resolve_for_caller("test/fixture/unrelated.spl", "who")).to_equal(-1)
        expect(func_resolve_for_caller("<entry>", "who")).to_equal(-1)
        expect(func_resolve_for_caller("", "who")).to_equal(-1)
