"""
# (module path, name)-keyed function resolution — pure-Simple mirror

Seed-policy mirror (2026-08-25) of the Rust seed's cross-module duplicate
free-function fix: the flat bare-name function table is last-write-wins, so
two co-compiled modules that each define the same free function silently
shadow each other by load order — the mechanism behind BOTH 2026-08-25
llm_caret incidents (`extract_json_string` hijacked by std.mcp.helpers,
`char_from_code` hijacked by encoding/utf8). See
doc/08_tracking/bug/co_compiled_symbol_collision_decision_2026-08-09.md.

The mirror keys a twin registration on (owner module path, name)
(`func_table_register_owned`, populated by
module_loader_core.register_module_functions) plus a per-importer
selective-import binding table (`func_import_binding_register`, populated by
eval_decls DECL_USE), and resolves a call through the CALLER first
(`func_resolve_for_caller`): own definition, then import binding, then the
flat table's historical pick.

This file drives the resolver directly (same technique as
`import_admission_critical_spec.spl`): register two same-named decls under
two owners, bind an importer to one of them, and assert each caller gets its
own module's / its imported module's decl — not the flat-table winner.
"""

use compiler.core.ast.{ast_reset, decl_fn}
use compiler.core.interpreter.eval_tables.{
    func_table_reset,
    func_table_register,
    func_table_lookup,
    func_table_register_owned,
    func_table_lookup_owned,
    func_import_binding_register,
    func_import_binding_lookup,
    func_import_binding_reset,
    func_resolve_for_caller
}

val MOD_A: text = "src/fixture/mod_a.spl"
val MOD_B: text = "src/fixture/mod_b.spl"
val SPEC_FILE: text = "test/fixture/who_spec.spl"

fn setup_collision() -> (i64, i64):
    ast_reset()
    func_table_reset()
    func_import_binding_reset()
    val did_a = decl_fn("who", [], [], 0, [], 0, [], 0)
    val did_b = decl_fn("who", [], [], 0, [], 0, [], 0)
    # Flat table: last write wins (mod_b), reproducing the load-order hazard.
    func_table_register("who", did_a)
    func_table_register_owned(MOD_A, "who", did_a)
    func_table_register("who", did_b)
    func_table_register_owned(MOD_B, "who", did_b)
    (did_a, did_b)

describe "(module path, name)-keyed function resolution":
    it "flat bare-name table alone is last-write-wins (the hazard)":
        val pair = setup_collision()
        expect(func_table_lookup("who")).to_equal(pair.1)

    it "keeps both definitions reachable under their owner keys":
        val pair = setup_collision()
        expect(func_table_lookup_owned(MOD_A, "who")).to_equal(pair.0)
        expect(func_table_lookup_owned(MOD_B, "who")).to_equal(pair.1)

    it "a caller module that defines the name gets ITS OWN definition":
        val pair = setup_collision()
        # mod_a lost the flat-table race, but a call from inside mod_a must
        # still reach mod_a's body.
        expect(func_resolve_for_caller(MOD_A, "who")).to_equal(pair.0)
        expect(func_resolve_for_caller(MOD_B, "who")).to_equal(pair.1)

    it "a caller resolves through its own selective-import binding":
        val pair = setup_collision()
        func_import_binding_register(SPEC_FILE, "who", MOD_A)
        expect(func_import_binding_lookup(SPEC_FILE, "who")).to_equal(MOD_A)
        # The spec imported `who` from mod_a only; the flat table would have
        # served mod_b's. The caller-aware route must win.
        expect(func_resolve_for_caller(SPEC_FILE, "who")).to_equal(pair.0)

    it "a caller with no route falls back to the flat table (-1 sentinel)":
        setup_collision()
        expect(func_resolve_for_caller("test/fixture/unrelated.spl", "who")).to_equal(-1)
        expect(func_resolve_for_caller("<entry>", "who")).to_equal(-1)
        expect(func_resolve_for_caller("", "who")).to_equal(-1)
