# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Seed-interpreter regressions:
#  1. a literal whose brace hole is not a complete expression (`{k: 1, d: "{d}"}`)
#     stays literal but still interpolates the nested `{d}` hole.
#  2. payload-less enum variants answer `.to_string()` with the variant name.

use std.spec.step

use std.spec.*

enum Level:
    Low
    High

describe "brace-leading literals and enum to_string":
    # @manual scenario evidence

    it "interpolates a nested hole inside a dict-like literal":
        # @req REQ-SSPEC-COMPILER
        step("nested hole inside {k: 1, d: ...}")
        val d = 5
        val s = "{k: 1, d: \"{d}\"}"
        expect(s).to_equal("{k: 1, d: \"5\"}")

    it "still interpolates a plain hole":
        # @req REQ-SSPEC-COMPILER
        step("plain hole")
        val d = 5
        expect("{d}").to_equal("5")

    it "unit enum variant to_string is the variant name":
        # @req REQ-SSPEC-COMPILER
        step("enum to_string")
        val l = Level.High
        expect(l.to_string()).to_equal("High")
