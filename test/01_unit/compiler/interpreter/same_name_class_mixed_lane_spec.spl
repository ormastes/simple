# Purpose and audience: compiler engineers who own class identity across
# flattened and lazily loaded modules (test-runner interpreter lane).
# @req REQ-SSPEC-UNIT
# Tracks: interpreter_same_name_class_method_dispatch_collision_2026_11_26
"""
# A flattened class beside a lazily loaded same-named class

`use m.Thing` flattens pa's module into the unit; `use m.{Thing as Legacy}`
loads pb's module lazily. Both declare `class Thing` with the same layout.
The lazily loaded one is the second owner of the name, so it carries pb's
owner-exact identity: its statics, `create()`, self-calls and trait methods
run pb's bodies. Before the fix every pb call ran pa's class.
"""
use std.spec.step

use std.spipe.*
use test.fixtures.same_name_class.pa.Thing
use test.fixtures.same_name_class.pb.{Thing as Legacy}

describe "a flattened class and a lazy same-named class keep their owners":
    it "dispatches the lazy alias to its owner class":
        step("dispatches the lazy alias to its owner class")
        val a = Thing.create()
        val l = Legacy.create()
        expect(a.n).to_equal(1)
        expect(a.compile()).to_equal(24)
        expect(Thing.tag()).to_equal(100)
        expect(a.label()).to_equal(7)
        expect(l.n).to_equal(2)
        expect(l.size()).to_equal(10)
        expect(l.compile()).to_equal(1010)
        expect(Legacy.tag()).to_equal(200)
        expect(l.label()).to_equal(8)
