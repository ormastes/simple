# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
#
# `val x = unsafe:` + indented block is a block EXPRESSION whose last
# expression is the value (doc/08_tracking/bug/seed_unsafe_block_expression_unsupported_2026-11-04.md).
# The seed used to fail with `semantic: function 'unsafe' not found`.

use std.spec.step

fn twice(n: i64) -> i64:
    n * 2

fn nested_value() -> i64:
    val x = unsafe:
        val a = 20
        a + 1
    x

fn as_call_arg() -> i64:
    val y = unsafe:
        3
    twice(y)

fn statement_form() -> i64:
    var total = 1
    unsafe:
        total = total + 41
    total

fn assigned_value() -> i64:
    var z = 0
    z = unsafe:
        9
    z

describe "unsafe block expression":
    it "yields the last expression of the block":
        step("top level val")
        val x = unsafe:
            val a = 5
            a + 2
        expect(x).to_equal(7)
    it "works nested in a function":
        expect(nested_value()).to_equal(21)
    it "feeds a call argument through a binding":
        expect(as_call_arg()).to_equal(6)
    it "keeps the statement form working":
        expect(statement_form()).to_equal(42)
    it "works as an assignment right-hand side":
        expect(assigned_value()).to_equal(9)
