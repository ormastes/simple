# Run-path probe: a lambda assigning an enclosing local must be REJECTED.
#
# Oracle for test/01_unit/compiler/interpreter/nested_fn_enclosing_var_mutation_spec.spl.
# Owner ruling 2026-09-27: closures are read-only, so line 11 is a compile error:
#     cannot assign to captured variable `count` inside a closure (line 11)
# `count=` is printed only if the module was (wrongly) accepted.

fn outer() -> i64:
    var count = 0
    [1, 2, 3].each(\x:
        count = count + x
    )
    count

fn main():
    print("count=" + outer().to_text())
