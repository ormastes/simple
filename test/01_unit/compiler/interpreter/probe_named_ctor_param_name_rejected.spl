# Run-path probe: a named class literal whose argument name is a PARAMETER of
# `static fn new` (and not a field) must be REJECTED, never routed into `new`.
#
# Oracle for test/01_unit/compiler/interpreter/named_ctor_static_new_hijack_spec.spl
# (doc/08_tracking/bug/interp_static_fn_new_hijacks_named_ctor_2026-07-02.md).
#
# Correct behaviour since 9b6be7f5c98 ("keep named construction out of static
# new"): construction fails with
#     class `Font` has no field named `path`
# and nothing below the literal runs. `HIJACKED` is printed only if the literal
# was accepted; id=77 in that line would additionally prove it reached `new`'s
# body (the sentinel exists nowhere else).

class Font:
    id: i64
    size: i64
    static fn new(path: text, size: i64) -> Font:
        return Font(id: 77, size: size)

fn main():
    print("NAMED_CTOR_REJECT PROBE: reached")
    val d = Font(path: "x", size: 8)
    print("HIJACKED id=" + d.id.to_text())
