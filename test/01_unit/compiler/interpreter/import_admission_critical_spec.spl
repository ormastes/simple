"""
# Import-Admission Fail-Closed Under `critical` (WP-10)

Plan: doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md
WP-10, plan premise 8.

`load_module_selective`'s fallback path (module_loader_core.spl) used to
accept ANY unresolvable import as long as every requested name happened to
already be registered somewhere in the flat function table -- an unrelated
module's same-named symbol could silently satisfy the import. That fallback
is unconditionally reachable regardless of assurance profile.

`import_admission_set_deny(true)` (wired from
`eval_apply_assurance_profile` under the `critical` profile, see
`policy_five_site_convergence_spec.spl`) forbids that fallback: an
unresolvable import becomes a hard `0` return, which the DECL_USE caller in
eval_decls.spl already turns into `eval_set_error("failed to load module:
...")`.

This file drives `load_module_selective` directly (same technique as
`module_loader_lazy_spec.spl`): register a probe name in the function table
so the lenient fallback WOULD normally fire, point at a module path that
cannot resolve to a real file, and assert the return code flips with the
switch.
"""

use compiler.core.ast.{ast_reset, decl_fn}
use compiler.core.interpreter.eval_tables.{func_table_reset, func_table_register}
use compiler.core.interpreter.module_loader_core.{
    module_loader_init,
    load_module_selective,
    import_admission_set_deny,
    import_admission_get_deny
}

fn spec_current_file() -> text:
    "test/01_unit/compiler/interpreter/import_admission_critical_spec.spl"

fn register_probe_fn(name: text) -> i64:
    ast_reset()
    val d = decl_fn(name, [], [], 0, [], 0, [], 0)
    func_table_register(name, d)
    d

fn check_default_is_lenient() -> text:
    module_loader_init()
    func_table_reset()
    import_admission_set_deny(false)
    register_probe_fn("wp10_probe_fn_a")
    val ok = load_module_selective(
        "nonexistent.module.wp10_lenient", ["wp10_probe_fn_a"], spec_current_file()
    )
    if ok != 1:
        return "expected lenient fallback to accept (ok=1), got " + ok.to_text()
    ""

fn check_critical_is_fail_closed() -> text:
    module_loader_init()
    func_table_reset()
    import_admission_set_deny(true)
    register_probe_fn("wp10_probe_fn_b")
    val ok = load_module_selective(
        "nonexistent.module.wp10_critical", ["wp10_probe_fn_b"], spec_current_file()
    )
    import_admission_set_deny(false)
    if ok != 0:
        return "expected fail-closed (ok=0) under critical, got " + ok.to_text()
    ""

describe "import admission fail-closed under critical (WP-10)":
    it "accepts the lenient already-registered-name fallback by default (non-critical)":
        val err = check_default_is_lenient()
        expect(err).to_equal("")

    it "hard-fails the SAME unresolvable import once import_admission_set_deny(true)":
        val err = check_critical_is_fail_closed()
        expect(err).to_equal("")

    it "import_admission_get_deny reflects the switch":
        import_admission_set_deny(true)
        expect(import_admission_get_deny()).to_equal(true)
        import_admission_set_deny(false)
        expect(import_admission_get_deny()).to_equal(false)
