# Bug interp_u64_above_i64_max_signed_compare_and_print_2026-11-03: the seed
# interpreter treats u64 values above i64 max as signed (compare false, prints
# negative); the JIT is correct. Fixed: interpreter Eq/NotEq compares the 64-bit word.
use std.spec.*
use std.io_runtime.{process_run, env_get}

fn run_probe(env_prefix: text) -> text:
    var bin = env_get("SIMPLE_TEST_BINARY")
    if bin == "":
        bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = "SIMPLE_RUST_SEED_WARNING=0 " + env_prefix + " " + bin + " run test/01_unit/compiler/interpreter/probe_u64_field_parity.spl 2>/dev/null"
    val out = process_run("sh", ["-c", cmd])
    out.0

describe "u64 field store and compare above i64 max":
    it "interpreter agrees with the JIT on unsigned compare and print":
        # @req REQ-SSPEC-COMPILER
        val jit = run_probe("SIMPLE_EXECUTION_MODE=jit")
        val interp = run_probe("SIMPLE_EXECUTION_MODE=interpreter")
        expect(interp).to_contain("b=true")
        expect(interp).to_contain("d=18446744073709551601")
        expect(interp).to_equal(jit)
