# Type Inference Specification — Hindley-Milner core
#
# Covers src/compiler/10.frontend/core/type_inference.spl: fresh type variable
# generation, the unification substitution store, transitive substitution
# resolution, the occurs check, and the unification status protocol.
#
# HISTORY: this file previously held 70 examples whose entire body was
#     expect true  # Placeholder until module import works
# It imported nothing, so all 70 reported green while executing none of the
# inference engine. The import works; the placeholders were never revisited.
#
# Every example below drives the shipped module. Do not reintroduce a
# placeholder: if an API is not reachable, delete the example or file a bug.
#
# Protocol note: unify_types returns a STATUS (UNIFY_SUCCESS / _FAIL_MISMATCH /
# _FAIL_OCCURS), not the unified type. The unified result is observed through
# type_subst_apply on the variable that was bound.

use std.spec
use compiler.frontend.core.type_inference.{
    type_var_fresh, type_var_reset, is_type_var,
    unify_reset, unify_bind, unify_lookup, unify_is_bound,
    type_subst_apply, occurs_check, unify_types, unify_get_error,
    UNIFY_SUCCESS, UNIFY_FAIL_MISMATCH, UNIFY_FAIL_OCCURS
}
use compiler.core.types.{TYPE_BOOL, TYPE_I64, TYPE_F64, TYPE_TEXT}

describe "Type Inference — type variables":
    it "generates distinct fresh variables":
        type_var_reset()
        val a = type_var_fresh()
        val b = type_var_fresh()
        val c = type_var_fresh()
        expect(a == b).to_equal(false)
        expect(b == c).to_equal(false)
        expect(a == c).to_equal(false)

    it "allocates fresh variables in increasing order":
        type_var_reset()
        val a = type_var_fresh()
        val b = type_var_fresh()
        expect(b > a).to_equal(true)

    it "restarts numbering after reset":
        type_var_reset()
        val first = type_var_fresh()
        type_var_reset()
        val again = type_var_fresh()
        expect(again).to_equal(first)

    it "classifies type variables apart from concrete types":
        type_var_reset()
        val v = type_var_fresh()
        expect(is_type_var(v)).to_equal(true)
        expect(is_type_var(TYPE_I64)).to_equal(false)
        expect(is_type_var(TYPE_BOOL)).to_equal(false)
        expect(is_type_var(TYPE_F64)).to_equal(false)
        expect(is_type_var(TYPE_TEXT)).to_equal(false)

describe "Type Inference — substitution store":
    it "reports an unbound variable as unbound":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(unify_is_bound(v)).to_equal(false)

    it "binds a variable to a concrete type and looks it up":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        unify_bind(v, TYPE_I64)
        expect(unify_is_bound(v)).to_equal(true)
        expect(unify_lookup(v)).to_equal(TYPE_I64)

    it "keeps separate bindings for separate variables":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        unify_bind(v1, TYPE_I64)
        unify_bind(v2, TYPE_TEXT)
        expect(unify_lookup(v1)).to_equal(TYPE_I64)
        expect(unify_lookup(v2)).to_equal(TYPE_TEXT)

    it "returns -1 when looking up an unbound variable":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(unify_lookup(v)).to_equal(0 - 1)

    it "clears every binding on reset":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        unify_bind(v, TYPE_I64)
        expect(unify_is_bound(v)).to_equal(true)
        unify_reset()
        expect(unify_is_bound(v)).to_equal(false)

describe "Type Inference — substitution resolution":
    it "leaves a concrete type unchanged":
        unify_reset()
        expect(type_subst_apply(TYPE_I64)).to_equal(TYPE_I64)
        expect(type_subst_apply(TYPE_TEXT)).to_equal(TYPE_TEXT)

    it "leaves an unbound variable unchanged":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(type_subst_apply(v)).to_equal(v)

    it "resolves a single binding":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        unify_bind(v, TYPE_F64)
        expect(type_subst_apply(v)).to_equal(TYPE_F64)

    it "follows a transitive chain to the concrete type":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        val v3 = type_var_fresh()
        unify_bind(v1, v2)
        unify_bind(v2, v3)
        unify_bind(v3, TYPE_BOOL)
        expect(type_subst_apply(v1)).to_equal(TYPE_BOOL)
        expect(type_subst_apply(v2)).to_equal(TYPE_BOOL)

    it "stops at the last unbound variable in a chain":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        unify_bind(v1, v2)
        expect(type_subst_apply(v1)).to_equal(v2)

describe "Type Inference — occurs check":
    it "reports no occurrence for an unrelated concrete type":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(occurs_check(v, TYPE_I64)).to_equal(false)

    it "reports an occurrence when the variable is itself":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(occurs_check(v, v)).to_equal(true)

    it "reports an occurrence through a substitution chain":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        unify_bind(v2, v1)
        expect(occurs_check(v1, v2)).to_equal(true)

    it "reports no occurrence for a different unbound variable":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        expect(occurs_check(v1, v2)).to_equal(false)

describe "Type Inference — unification":
    it "succeeds on two identical primitives":
        unify_reset()
        expect(unify_types(TYPE_I64, TYPE_I64)).to_equal(UNIFY_SUCCESS)
        expect(unify_types(TYPE_BOOL, TYPE_BOOL)).to_equal(UNIFY_SUCCESS)
        expect(unify_types(TYPE_TEXT, TYPE_TEXT)).to_equal(UNIFY_SUCCESS)

    it "fails with a mismatch on two different primitives":
        unify_reset()
        expect(unify_types(TYPE_I64, TYPE_TEXT)).to_equal(UNIFY_FAIL_MISMATCH)
        expect(unify_types(TYPE_BOOL, TYPE_F64)).to_equal(UNIFY_FAIL_MISMATCH)

    it "binds a variable on the left to a concrete type":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(unify_types(v, TYPE_I64)).to_equal(UNIFY_SUCCESS)
        expect(type_subst_apply(v)).to_equal(TYPE_I64)

    it "binds a variable on the right to a concrete type":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(unify_types(TYPE_TEXT, v)).to_equal(UNIFY_SUCCESS)
        expect(type_subst_apply(v)).to_equal(TYPE_TEXT)

    it "unifies two variables so they resolve together":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        expect(unify_types(v1, v2)).to_equal(UNIFY_SUCCESS)
        expect(unify_types(v2, TYPE_BOOL)).to_equal(UNIFY_SUCCESS)
        expect(type_subst_apply(v1)).to_equal(TYPE_BOOL)

    it "is reflexive on a type variable":
        type_var_reset()
        unify_reset()
        val v = type_var_fresh()
        expect(unify_types(v, v)).to_equal(UNIFY_SUCCESS)

    it "succeeds when both sides resolve to the same variable":
        type_var_reset()
        unify_reset()
        val v1 = type_var_fresh()
        val v2 = type_var_fresh()
        unify_bind(v2, v1)
        expect(unify_types(v1, v2)).to_equal(UNIFY_SUCCESS)

    it "records a message on mismatch":
        unify_reset()
        expect(unify_types(TYPE_I64, TYPE_TEXT)).to_equal(UNIFY_FAIL_MISMATCH)
        expect(unify_get_error()).to_equal("Type mismatch")

    # NOTE ON COVERAGE, NOT A PLACEHOLDER: there is deliberately no example
    # asserting a UNIFY_FAIL_OCCURS return. That status is unreachable in the
    # current unify_types — the occurs check is dead code — which is a defect
    # filed as
    # doc/08_tracking/bug/unify_occurs_check_unreachable_2026-08-02.md
    # An example asserting the present behaviour would enshrine the bug, so the
    # gap is tracked in the bug rather than papered over here. Add the example
    # when the occurs check is repaired.

    it "keeps the three status codes distinct":
        expect(UNIFY_SUCCESS == UNIFY_FAIL_MISMATCH).to_equal(false)
        expect(UNIFY_SUCCESS == UNIFY_FAIL_OCCURS).to_equal(false)
        expect(UNIFY_FAIL_MISMATCH == UNIFY_FAIL_OCCURS).to_equal(false)
