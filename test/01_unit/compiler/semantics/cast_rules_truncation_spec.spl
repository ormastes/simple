"""
## Purpose and audience
Purpose: Prove that cast_int_to_numeric truncation.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

"""Cast rules — integer truncation semantics.

cast_int_to_numeric documents (and the Rust reference implementation in
src/compiler_rust/compiler/src/semantics/cast_rules.rs enforces) that casting
to a narrower integer type truncates and sign/zero-extends through that
narrower width: `300 as i8 as i64 == 44`, `-1 as u8 as i64 == 255`. The
self-hosted port in src/compiler/35.semantics/semantics/cast_rules.spl must
match this contract.
"""

use compiler.semantics.cast_rules.{cast_int_to_numeric, cast_float_to_numeric, NumericType, CastNumericResult}
use testing.{describe, it, expect}

fn as_int(r: CastNumericResult) -> i64:
    match r:
        case Int(v): v
        case Float(v): -999999

use std.spec.step

describe "cast_int_to_numeric truncation":
    it "truncates 300 to i8 range: 300 as i8 as i64 == 44":
        step("Verify: truncates 300 to i8 range: 300 as i8 as i64 == 44")
        # @req: REQ-COMPILER-SEMANTICS-001
        val r = cast_int_to_numeric(300, NumericType.I8)
        expect(as_int(r)).to_equal(44)  # oracle: 44 — named expected value from the requirement

    it "wraps -1 to u8 range: -1 as u8 as i64 == 255":
        step("Verify: wraps -1 to u8 range: -1 as u8 as i64 == 255")
        val r = cast_int_to_numeric(-1, NumericType.U8)
        expect(as_int(r)).to_equal(255)  # oracle: 255 — named expected value from the requirement

    it "truncates to i16 range":
        step("Verify: truncates to i16 range")
        val r = cast_int_to_numeric(70000, NumericType.I16)
        expect(as_int(r)).to_equal(4464)  # oracle: 4464 — named expected value from the requirement

    it "truncates to u32 range":
        step("Verify: truncates to u32 range")
        val r = cast_int_to_numeric(-1, NumericType.U32)
        expect(as_int(r)).to_equal(4294967295)  # oracle: 4294967295 — named expected value from the requirement
