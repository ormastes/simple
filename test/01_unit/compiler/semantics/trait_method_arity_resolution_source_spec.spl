use std.spipe.*

extern fn rt_file_read_text(path: text) -> text

fn source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "trait method call arity resolution contracts":
    it "filters same-named trait candidates by explicit call arity":
        val resolver = source("src/compiler/35.semantics/resolve_strategies.spl")

        expect(resolver).to_contain(
            "self.try_trait_method(ty, method, args.len())")
        expect(resolver).to_contain(
            "params.len() == explicit_arg_count + 1")
        expect(resolver).to_contain(
            "self.trait_method_accepts_explicit_arity(symbol, explicit_arg_count)")
        expect(resolver).to_contain(
            "self.trait_method_accepts_explicit_arity(method_sym, explicit_arg_count)")

    it "preserves unresolved imported trait symbols without invented arity facts":
        val resolver = source("src/compiler/35.semantics/resolve_strategies.spl")

        expect(resolver).to_contain(
            "Imported/erased symbols can lack a complete callable type")
        expect(resolver).to_contain(
            "true\n\n    me try_trait_method(receiver_type")

    it "keeps inherent methods ahead of arity-filtered trait fallback":
        val resolver = source("src/compiler/35.semantics/resolve_strategies.spl")
        val priority = resolver.split("me resolve_method(")[1].split("fn format_type(")[0]

        val instance_pos = priority.find("self.try_instance_method")
        val trait_pos = priority.find("self.try_trait_method")
        expect(instance_pos).to_be_greater_than(-1)
        expect(trait_pos).to_be_greater_than(instance_pos)
