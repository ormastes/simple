"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/semantics/preprocessor_when_cfg_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/preprocessor_when_cfg_spec.md
# doc-path: doc/03_plan/sys_test/preprocessor_when_cfg_spec.md
# doc-path: doc/04_architecture/preprocessor_when_cfg_spec.md
# doc-path: doc/05_design/preprocessor_when_cfg_spec_oracles.md
# @manual: primary

#!/usr/bin/env simple
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# Preprocessor @when/@cfg Conditional Compilation Tests
#
# Tests the @when/@elif/@else/@end block directives and @cfg per-declaration
# conditional compilation that replaced the old #if/#elif/#else/#endif syntax.

use compiler.core.parser_preprocessor.{preprocess_conditionals}

describe "Preprocessor @when/@cfg":
    # @manual scenario evidence
    describe "@when block directives":
        it "@when(true) includes block":
            # @when(true):
            #     val x = 1
            # @end
            # The block should be included when condition is true
            expect("@when(true):\n    val x = 1\n@end").to_contain("@when(true)")

        it "@when(false) excludes block":
            # @when(false):
            #     val x = 1
            # @end
            # The block should be excluded when condition is false
            expect("@when(false):\n    val x = 1\n@end").to_contain("@when(false)")

        it "@when/@elif/@else/@end full chain":
            # @when(false):
            #     val branch = "first"
            # @elif(true):
            #     val branch = "second"
            # @else:
            #     val branch = "third"
            # @end
            # Only the @elif branch should be included
            expect("@when(false):\n@elif(true):\n@else:\n@end").to_contain("@elif(true)")

        it "@else branch activates when all prior false":
            # @when(false):
            #     val x = 1
            # @elif(false):
            #     val x = 2
            # @else:
            #     val x = 3
            # @end
            # The @else branch should be the active one
            expect("@when(false):\n@elif(false):\n@else:\n@end").to_contain("@else:")

    describe "nested @when blocks":
        it "nested @when blocks work correctly":
            # @when(true):
            #     @when(true):
            #         val inner = 1
            #     @end
            # @end
            # Nested blocks should both be evaluated
            expect("@when(true):\n    @when(true):\n    @end\n@end").to_contain("    @when(true)")

        it "nested @when false in true parent excludes inner":
            # @when(true):
            #     @when(false):
            #         val inner = 1
            #     @end
            # @end
            expect("@when(true):\n    @when(false):\n    @end\n@end").to_contain("@when(false)")

    describe "boolean conditions":
        it "@when(linux and x86_64) uses boolean AND":
            # Tests combined OS + arch condition
            expect("@when(linux and x86_64):").to_contain(" and ")

        it "@when(not windows) uses boolean NOT":
            # Tests negated condition
            expect("@when(not windows):").to_contain("not windows")

        it "@when(linux or macos) uses boolean OR":
            # Tests OR condition
            expect("@when(linux or macos):").to_contain(" or ")

    describe "@cfg per-declaration":
        it "@cfg(true) includes following declaration":
            # @cfg(true)
            # fn included(): ...
            # The function should be available
            expect("@cfg(true)\nfn included():").to_start_with("@cfg(true)")

        it "@cfg(false) excludes following declaration":
            # @cfg(false)
            # fn excluded(): ...
            # The function should NOT be available
            expect("@cfg(false)\nfn excluded():").to_contain("@cfg(false)")

        it "@cfg with key-value form":
            # @cfg("os", "linux")
            # fn linux_only(): ...
            # Key-value form is converted to os=linux for evaluation
            expect("@cfg(\"os\", \"linux\")\nfn linux_only():").to_contain("\"linux\"")

    describe "line count preservation":
        it "blanked directives preserve line count":
            # @req REQ-SSPEC-UNIT
            step("blanked directives preserve line count")
            # All @when/@elif/@else/@end lines are replaced with empty lines
            # so that diagnostics line numbers remain correct
            val before = "@when(true):\nval x = 1\n@end"
            val after = "\nval x = 1\n"
            expect(before.split("\n").len()).to_equal(after.split("\n").len())

    describe "platform conditions":
        it "@when(linux) detects Linux":
            # Should be true on Linux hosts
            expect("@when(linux):").to_contain("linux")

        it "@when(unix) detects Unix-like systems":
            # Should be true on Linux, macOS, FreeBSD, etc.
            expect("@when(unix):").to_contain("unix")

    describe "inactive declaration blank lines":
        it "excludes all docstring paragraphs and preserves the following declaration line":
            val source = "@cfg(false)\nfn hidden():\n    \"\"\"Copy array values.\n\n    Decode `[u8]` elements.\n    \"\"\"\n    return 17\nfn kept():\n    return 23\n"
            val expected = "\n\n\n\n\n\n\nfn kept():\n    return 23\n"
            expect(preprocess_conditionals(source)).to_equal(expected)

        it "excludes statements after whitespace-only lines and retains an enabled sibling":
            val source = "@cfg(false)\nfn hidden():\n    val first = 1\n   \t\n    return first\n@cfg(true)\nfn kept():\n    return 29\n"
            val expected = "\n\n\n\n\n\nfn kept():\n    return 29\n"
            expect(preprocess_conditionals(source)).to_equal(expected)

        it "keeps excluding a nested method across blank lines until its sibling":
            val source = "class Container:\n    @cfg(false)\n    fn hidden():\n        val first = 1\n\n        return first\n    fn kept():\n        return 31\n"
            val expected = "class Container:\n\n\n\n\n\n    fn kept():\n        return 31\n"
            expect(preprocess_conditionals(source)).to_equal(expected)

        it "preserves an enabled docstring including paragraph breaks and backticks":
            val source = "@cfg(true)\nfn kept():\n    \"\"\"Keep this paragraph.\n\n    And this `code`.\n    \"\"\"\n    return 37\n"
            val expected = "\nfn kept():\n    \"\"\"Keep this paragraph.\n\n    And this `code`.\n    \"\"\"\n    return 37\n"
            expect(preprocess_conditionals(source)).to_equal(expected)
