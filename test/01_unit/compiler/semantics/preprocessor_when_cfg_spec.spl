#!/usr/bin/env simple
# Preprocessor @when/@cfg Conditional Compilation Tests
#
# Tests the @when/@elif/@else/@end block directives and @cfg per-declaration
# conditional compilation that replaced the old #if/#elif/#else/#endif syntax.

use std.spec.*
use compiler.frontend.frontend.{preprocess_conditionals}
use compiler.frontend.core.cfg_platform.{cfg_detect_arch}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.core.parser.{parser_has_errors}
use std.nogc_sync_mut.io.file_ops.{file_read_text}

describe "Preprocessor @when/@cfg":
    describe "@when block directives":
        it "@when(true) includes block":
            val out = preprocess_conditionals("@when(true):\n    val x = 1\n@end\n")
            expect(out.contains("val x = 1")).to_be(true)
            expect(out.contains("@when")).to_be(false)

        it "@when(false) excludes block":
            val out = preprocess_conditionals("@when(false):\n    val x = 1\n@end\n")
            expect(out.contains("val x = 1")).to_be(false)

        it "@when/@elif/@else/@end full chain":
            val out = preprocess_conditionals("@when(false):\n    val branch = \"first\"\n@elif(true):\n    val branch = \"second\"\n@else:\n    val branch = \"third\"\n@end\n")
            expect(out.contains("first")).to_be(false)
            expect(out.contains("second")).to_be(true)
            expect(out.contains("third")).to_be(false)

        it "@else branch activates when all prior false":
            val out = preprocess_conditionals("@when(false):\n    val branch = \"first\"\n@elif(false):\n    val branch = \"second\"\n@else:\n    val branch = \"third\"\n@end\n")
            expect(out.contains("first")).to_be(false)
            expect(out.contains("second")).to_be(false)
            expect(out.contains("third")).to_be(true)

    describe "nested @when blocks":
        it "nested @when blocks work correctly":
            val out = preprocess_conditionals("@when(true):\n    @when(true):\n        val inner = 1\n    @end\n@end\n")
            expect(out.contains("val inner = 1")).to_be(true)

        it "nested @when false in true parent excludes inner":
            val out = preprocess_conditionals("@when(true):\n    @when(false):\n        val inner = 1\n    @end\n@end\n")
            expect(out.contains("val inner = 1")).to_be(false)

    describe "boolean conditions":
        it "@when(linux and x86_64) uses boolean AND":
            val out = preprocess_conditionals("@when(true and true):\n    val included = 1\n@end\n")
            expect(out.contains("val included = 1")).to_be(true)

        it "@when(not windows) uses boolean NOT":
            val out = preprocess_conditionals("@when(not false):\n    val included = 1\n@end\n")
            expect(out.contains("val included = 1")).to_be(true)

        it "@when(linux or macos) uses boolean OR":
            val out = preprocess_conditionals("@when(false or true):\n    val included = 1\n@end\n")
            expect(out.contains("val included = 1")).to_be(true)

    describe "@cfg per-declaration":
        it "@cfg(true) includes following declaration":
            val out = preprocess_conditionals("@cfg(true)\nfn included():\n    1\n")
            expect(out.contains("fn included():")).to_be(true)

        it "@cfg(false) excludes following declaration":
            val out = preprocess_conditionals("@cfg(false)\nfn excluded():\n    1\n")
            expect(out.contains("fn excluded():")).to_be(false)

        it "@cfg with key-value form":
            val arch = cfg_detect_arch()
            val condition = if arch == "unknown": "true" else: "\"arch\", \"{arch}\""
            val out = preprocess_conditionals("@cfg({condition})\nfn host_only():\n    1\n")
            expect(out.contains("fn host_only():")).to_be(true)

    describe "line count preservation":
        it "keeps trailing and adjacent blank lines as empty text":
            val src = "@cfg(false)\nfn excluded():\n    1\n\n\nfn included():\n    2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("nilnil")).to_equal(false)
            expect(out.ends_with("\n")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "does not append text when conditional source has no final newline":
            val src = "@cfg(false)\nfn excluded():\n    1\n\nfn included():\n    2"
            val out = preprocess_conditionals(src)
            expect(out.contains("nil")).to_equal(false)
            expect(out.ends_with("\n")).to_equal(false)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "preprocesses and parses the Stage 4 sync IO fixture without generated identifiers":
            val fixture = file_read_text("test/fixtures/compiler/stage4_native_sync_io_facade.spl")
            val out = preprocess_conditionals(fixture)
            val module = parse_and_build_module(out, "stage4_native_sync_io_facade.spl")
            expect(out.contains("nilnil")).to_equal(false)
            expect(parser_has_errors()).to_equal(false)
            expect(module.functions.contains("main")).to_equal(true)

        it "preprocesses the production sync IO facade without generated identifiers":
            val source_path = "src/lib/nogc_sync_mut/io.spl"
            val source = file_read_text(source_path)
            val out = preprocess_conditionals(source)
            val _module = parse_and_build_module(out, source_path)
            expect(out.contains("nilnil")).to_equal(false)
            expect(parser_has_errors()).to_equal(false)

        it "preprocesses and parses every current-host SimpleOS syscall wrapper":
            val fixture = file_read_text("src/os/userlib/syscall_raw.spl")
            val out = preprocess_conditionals(fixture)
            val module = parse_and_build_module(out, "syscall_raw.spl")
            expect(out.contains("nilnil")).to_equal(false)
            expect(parser_has_errors()).to_equal(false)
            expect(module.functions.contains("sys_poll")).to_equal(true)
            expect(module.functions.contains("sys_fcntl")).to_equal(true)

        it "sync IO facade does not route imports or exports through itself":
            val facade = file_read_text("src/lib/nogc_sync_mut/io.spl")
            expect(facade.contains("use std.nogc_sync_mut.io.*")).to_equal(false)
            expect(facade.contains("export use std.nogc_sync_mut.io.{")).to_equal(false)

        it "blanked directives preserve line count":
            # All @when/@elif/@else/@end lines are replaced with empty lines
            # so that diagnostics line numbers remain correct
            val before = "@when(true):\nval x = 1\n@end"
            val after = preprocess_conditionals(before)
            expect(before.split("\n").len()).to_equal(after.split("\n").len())

        it "false cfg keeps skipping a declaration across blank body lines":
            val src = "@cfg(false)\nfn excluded():\n    \"\"\"Paragraph one.\n\n    Args:\n        value: must remain excluded\n    \"\"\"\n    val hidden = 1\n\nfn included():\n    val visible = 2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("Paragraph one.")).to_equal(false)
            expect(out.contains("value: must remain excluded")).to_equal(false)
            expect(out.contains("val hidden = 1")).to_equal(false)
            expect(out.contains("fn included():")).to_equal(true)
            expect(out.contains("val visible = 2")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "false cfg keeps skipping across a comment-only body line":
            val src = "@cfg(false)\nfn excluded():\n# comment does not end the excluded body\n    val hidden = 1\n\nfn included():\n    val visible = 2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("comment does not end the excluded body")).to_equal(false)
            expect(out.contains("val hidden = 1")).to_equal(false)
            expect(out.contains("fn included():")).to_equal(true)
            expect(out.contains("val visible = 2")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "false cfg does not cross an indentation boundary":
            val src = "    @cfg(false)\n\nfn included():\n    val visible = 2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("fn included():")).to_equal(true)
            expect(out.contains("val visible = 2")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "false cfg suppresses a same-indent decorator stack and body":
            val src = "@cfg(false)\n@export(\"hidden\")\nfn excluded():\n    val hidden = 1\n\nfn included():\n    val visible = 2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("@export")).to_equal(false)
            expect(out.contains("fn excluded():")).to_equal(false)
            expect(out.contains("val hidden = 1")).to_equal(false)
            expect(out.contains("fn included():")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "outer false cfg suppresses a stacked cfg declaration":
            val src = "@cfg(false)\n@cfg(true)\nfn excluded():\n    val hidden = 1\n\nfn included():\n    val visible = 2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("fn excluded():")).to_equal(false)
            expect(out.contains("val hidden = 1")).to_equal(false)
            expect(out.contains("fn included():")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

        it "true cfg preserves the following decorator and declaration":
            val src = "@cfg(true)\n@export(\"visible\")\nfn included():\n    val visible = 2\n"
            val out = preprocess_conditionals(src)
            expect(out.contains("@export(\"visible\")")).to_equal(true)
            expect(out.contains("fn included():")).to_equal(true)
            expect(out.contains("val visible = 2")).to_equal(true)
            expect(src.split("\n").len()).to_equal(out.split("\n").len())

    describe "platform conditions":
        it "@when detects the current host architecture":
            val arch = cfg_detect_arch()
            val host_condition = if arch == "unknown": "true" else: arch
            val out = preprocess_conditionals("@when({host_condition}):\n    val current_host = 1\n@end\n")
            expect(out.contains("val current_host = 1")).to_be(true)

        it "@when rejects an impossible architecture":
            val out = preprocess_conditionals("@when(__not_a_real_arch__):\n    val impossible_host = 1\n@end\n")
            expect(out.contains("val impossible_host = 1")).to_be(false)

    it "false cfg output parses without leaking the excluded declaration":
        val src = "@cfg(false)\n@export(\"hidden\")\nfn excluded():\n    \"\"\"Hidden documentation.\"\"\"\n    1\n\nfn included():\n    2\n"
        val out = preprocess_conditionals(src)
        val module = parse_and_build_module(out, "preprocessor_false_cfg_scope.spl")
        expect(parser_has_errors()).to_be(false)
        expect(module.functions.contains("included")).to_be(true)
        expect(module.functions.contains("excluded")).to_be(false)

# ================================================================
# Task #45 residual — source-driven same-name @cfg/@when arch dispatch
# ================================================================
# #45: two same-named functions gated by different @cfg(arch) conditions
# resolved to whichever was DECLARED FIRST, instead of the host-matching
# one (last/first-write-wins bug). Repro: bin/simple run on a same-name
# arch_name() pair still shows the pre-fix symptom on the deployed binary
# ("arm64" wins when the arm64 variant is declared first, on an x86_64
# host) — that is expected: the deployed binary's self-compiled frontend
# is redeploy-gated. This block verifies the FIX ITSELF straight from
# current .spl source, independent of the deployed binary.
#
# Investigation trail (see git log):
#   - d4ae10aeb3c "fix(interpreter): evaluate @cfg conditions at
#     registration time (#45)" touches src/app/interpreter/module/
#     evaluator.spl's evaluate_module/cfg_decorators_active. That function
#     has zero callers anywhere in src/ or test/ (grep "evaluate_module(")
#     and its item types (Node/FunctionDef with a `.decorators` field) do
#     not match any struct/enum defined in the .spl tree — this is
#     orphaned code on a path `bin/simple run` never executes.
#   - cb8d9df703558 "fix(frontend): activate @cfg stripping (was inert) +
#     native host arch/os detection" (one day earlier) is the REAL fix:
#     src/compiler/10.frontend/frontend.spl's `preprocess_conditionals`
#     used to be a local passthrough (`fn preprocess_conditionals(source):
#     source`) that bare-name-shadowed its own
#     `use compiler.core.parser_preprocessor.{preprocess_conditionals}`
#     import, so @cfg/@when stripping never ran and the FIRST-declared
#     same-name variant always won regardless of host arch. The fix
#     delegates to the uniquely-named `_pp_preprocess_conditionals` so the
#     real text-level stripping (which blanks the losing declaration
#     entirely before parsing) always executes.
#   - `preprocess_conditionals` here is imported from
#     `compiler.frontend.frontend` (the exact function that had the #45
#     regression), driven directly from source — not a hand-rolled
#     reimplementation of its logic.
describe "Task #45 residual — same-name arch dispatch (source-driven)":
    it "reassembles spaced key value cfg conditions":
        val arch = cfg_detect_arch()
        val single_condition = if arch == "unknown": "true" else: "arch = \"{arch}\""
        val double_condition = if arch == "unknown": "true" else: "arch == \"{arch}\""
        val src = "@cfg({single_condition})\nfn single_equals() -> text:\n    \"kept-single\"\n\n@cfg({double_condition})\nfn double_equals() -> text:\n    \"kept-double\"\n"
        val out = preprocess_conditionals(src)
        expect(out.contains("kept-single")).to_equal(true)
        expect(out.contains("kept-double")).to_equal(true)

    it "keeps the host-matching @cfg variant when declared first (order A)":
        val arch = cfg_detect_arch()
        val host_condition = if arch == "unknown": "true" else: "arch = \"{arch}\""
        val src = "@cfg({host_condition})\nfn arch_name() -> text:\n    \"host-match\"\n\n@cfg(arch = \"__not_a_real_arch__\")\nfn arch_name() -> text:\n    \"non-match\"\n"
        val out = preprocess_conditionals(src)
        expect(out.contains("\"host-match\"")).to_be(true)
        expect(out.contains("\"non-match\"")).to_be(false)

    it "keeps the host-matching @cfg variant when declared second (order B — the #45 regression order)":
        val arch = cfg_detect_arch()
        val host_condition = if arch == "unknown": "true" else: "arch = \"{arch}\""
        val src = "@cfg(arch = \"__not_a_real_arch__\")\nfn arch_name() -> text:\n    \"non-match\"\n\n@cfg({host_condition})\nfn arch_name() -> text:\n    \"host-match\"\n"
        val out = preprocess_conditionals(src)
        expect(out.contains("\"host-match\"")).to_be(true)
        expect(out.contains("\"non-match\"")).to_be(false)

    it "@when sibling path: keeps the host-matching block-form variant regardless of order":
        # cfg_eval_key_value/cfg_detect_arch (compiler.core.cfg_platform) is
        # shared between the per-declaration @cfg path and the block-scoped
        # @when path (both route through preprocess_conditionals's two
        # preprocessing passes in _pp_preprocess_conditionals). This proves
        # the @when sibling has no analogous same-name gap in the current
        # source: the false-condition block is blanked in its entirety
        # before parsing, same as @cfg, so no duplicate name ever reaches
        # the parser/interpreter to race on declaration order.
        val arch = cfg_detect_arch()
        val host_condition = if arch == "unknown": "true" else: arch
        val src = "@when(__not_a_real_arch__)\nfn arch_name() -> text:\n    \"non-match\"\n@end\n\n@when({host_condition})\nfn arch_name() -> text:\n    \"host-match\"\n@end\n"
        val out = preprocess_conditionals(src)
        expect(out.contains("\"host-match\"")).to_be(true)
        expect(out.contains("\"non-match\"")).to_be(false)
