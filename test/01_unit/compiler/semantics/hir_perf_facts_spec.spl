"""
## Purpose and audience
Executable spec of the typed HIR collection performance-facts pass for the
semantic-analysis maintainers who own `src/compiler/semantics/perf_facts`.
Scope: resolved-lookup admission from a verified registry contract, loop
ancestry, fail-closed behavior for absent or unverified metadata, COLL002
linear-lookup findings, and traversal coverage of comprehensions and nested
method calls.
## Operator workflow
Run: ./src/compiler_rust/target/bootstrap/simple run
test/01_unit/compiler/semantics/hir_perf_facts_spec.spl — the pf_* helpers
build HIR functions with one `Array.contains` lookup and each scenario feeds
them to collect_hir_function_perf_facts against a fixture registry.
## Compatibility and limitations
HIR nodes are hand-built, so the spec pins the facts collector's contract,
not frontend resolution. The registry fixture pins one operation kind
(ContainsLookup) with signature `Array<T>.contains(T)->bool`.
## Verification guidance and troubleshooting
A failure means an unverified or absent registry row was admitted, a linear
lookup lost or gained a COLL002 finding, loop depth was miscounted, a small
literal domain was not suppressed, or traversal dropped a nested or
comprehension-owned call. Each scenario name names which contract broke.
"""
# Lifecycle: doc/01_research/compiler/collection_planner/collection_plan_ir_2026-07-31.md ;
# doc/03_plan/infra/agent_sessions/lint_spec.md ;
# doc/04_architecture/compiler/perf/simple_optimization_plugin.md ;
# doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md
# @manual_section: hir-perf-facts

use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{
    FunctionAttr, vhdl_hardware_metadata_default}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.perf_facts.*

fn pf_span(line: i64) -> Span:
    Span.at(line, line, 1)

fn pf_unit_type() -> HirType:
    HirType(kind: HirTypeKind.Unit, span: pf_span(1))

fn pf_bool_type() -> HirType:
    HirType(kind: HirTypeKind.Bool, span: pf_span(1))

fn pf_i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: pf_span(1))

fn pf_array_type() -> HirType:
    HirType(kind: HirTypeKind.Array(
        HirType(kind: HirTypeKind.Int(64, true), span: pf_span(1)), nil),
        span: pf_span(1))

fn pf_expr(kind: HirExprKind, type_: HirType, line: i64) -> HirExpr:
    HirExpr(kind: kind, has_type_: true, type_: type_, span: pf_span(line))

fn pf_empty_expr() -> HirExpr:
    pf_expr(HirExprKind.UnitLit, pf_unit_type(), 1)

fn pf_lookup(resolution: MethodResolution) -> HirExpr:
    val receiver = pf_expr(
        HirExprKind.NamedVar(SymbolId(id: 11), "items"), pf_array_type(), 3)
    pf_expr(HirExprKind.MethodCall(
        receiver, "contains", [HirCallArg(
            has_name: false, name: "",
            value: pf_expr(HirExprKind.IntLit(7, nil), pf_i64_type(), 4),
            span: pf_span(4))], resolution), pf_bool_type(), 4)

fn pf_named_lookup(
    receiver: HirExpr, method_name: text, result_type: HirType,
    argument: HirExpr, resolution: MethodResolution, line: i64
) -> HirExpr:
    pf_expr(HirExprKind.MethodCall(
        receiver, method_name, [HirCallArg(
            has_name: false, name: "", value: argument,
            span: pf_span(line))], resolution), result_type, line)

fn pf_function_with_expr(expr: HirExpr) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: 20), name: "scan", type_params: [], params: [],
        return_type: pf_unit_type(),
        body: HirBlock(
            stmts: [HirStmt(kind: HirStmtKind.Expr(expr), span: pf_span(2))],
            has: false, value: pf_empty_expr(), span: pf_span(1)),
        effects: [], visibility: Visibility.Private, is_async: false,
        is_static: false, is_public: false, is_method: false,
        is_mutable: false, is_const: false, is_extern: false,
        func_attr: FunctionAttr.default(), has_export_attr: false,
        export_attr: nil, has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_doc_comment: false, doc_comment: "", span: pf_span(1),
        is_gpu_kernel: false, gpu_target: "", gpu_backend_order: "",
        verification_contract: nil)

fn pf_function_with_iter(
    resolution: MethodResolution, iter: HirExpr
) -> HirFunction:
    val lookup = pf_lookup(resolution)
    val body = HirBlock(
        stmts: [HirStmt(kind: HirStmtKind.Expr(lookup), span: pf_span(4))],
        has: false, value: pf_empty_expr(), span: pf_span(4))
    val loop = pf_expr(
        HirExprKind.For(SymbolId(id: 13), iter, body, nil),
        pf_unit_type(), 2)
    pf_function_with_expr(loop)

fn pf_function(resolution: MethodResolution) -> HirFunction:
    pf_function_with_iter(resolution, pf_expr(
        HirExprKind.NamedVar(SymbolId(id: 12), "queries"),
        pf_array_type(), 2))

fn pf_registry_contract(
    symbol_id: i64, verified: bool, operation: HirPerfOperationKind,
    explicit_argument_count: i64
) -> CollectionOperationRegistry:
    var registry = CollectionOperationRegistry.new("stdlib-cost-v1")
    registry.register(CollectionOperationSummary(
        symbol_id: symbol_id, stable_name: "Array.contains",
        operation: operation,
        cost: HirPerfCostClass.LinearReceiver,
        output_cardinality: HirPerfCardinality.Exact(1),
        enumeration: HirPerfEnumerationClass.Once,
        expected_receiver: HirPerfReceiverKind.Array,
        signature_fingerprint: "Array<T>.contains(T)->bool",
        explicit_argument_count: explicit_argument_count,
        effects: HirPerfEffectFacts(
            reads: true, writes: false, allocates: false, throws: false,
            suspends: false, observable: false, unknown: false),
        allocation: HirPerfAllocationClass.None,
        preserves_order: true, materializes: false,
        metadata_version: "stdlib-cost-v1",
        provenance: "stdlib build metadata",
        evidence_receipt: if verified: "fixture-evidence" else: ""))
    registry

fn pf_registry_operation(
    symbol_id: i64, verified: bool, operation: HirPerfOperationKind
) -> CollectionOperationRegistry:
    pf_registry_contract(symbol_id, verified, operation, 1)

fn pf_registry(symbol_id: i64, verified: bool) -> CollectionOperationRegistry:
    pf_registry_operation(symbol_id, verified, HirPerfOperationKind.ContainsLookup)

describe "typed HIR collection performance facts":
    it "records one resolved linear lookup with loop ancestry":
        # @req REQ-009 REQ-010 REQ-012 REQ-023 REQ-024
        # @capture(statistics): scan count, op count, loop depth, and COLL002 finding
        step("Collect facts for one contains lookup inside a for loop")
        val facts = collect_hir_function_perf_facts(
            pf_function(MethodResolution.InstanceMethod(
                SymbolId(id: 10), SymbolId(id: 30))), pf_registry(30, true))
        expect(facts.functions_scanned).to_equal(1)  # oracle: the fixture is exactly one function
        expect(facts.collection_ops.len()).to_equal(1)  # oracle: the body holds exactly one method call
        expect(facts.collection_ops[0].loop_depth).to_equal(1)  # oracle: the lookup sits inside exactly one for loop
        expect(facts.collection_ops[0].metadata_admitted).to_equal(true)
        val findings = typed_coll002_linear_lookup_findings(facts)
        expect(findings.len()).to_equal(1)  # oracle: one linear lookup inside a loop is exactly one COLL002 violation
        expect(findings[0].code).to_equal("COLL002")
        expect(findings[0].evidence).to_contain("lookup_cost=linear(receiver)")

    it "fails closed when operation metadata is absent":
        # @req REQ-009 REQ-023
        # @capture(statistics): unclassified count and empty op list
        step("Collect facts against an empty registry")
        val facts = collect_hir_function_perf_facts(
            pf_function(MethodResolution.InstanceMethod(
                SymbolId(id: 10), SymbolId(id: 31))),
            CollectionOperationRegistry.new("stdlib-cost-v1"))
        expect(facts.unclassified_method_calls).to_equal(1)  # oracle: the registry has no row for the call, so it must surface as unclassified
        expect(facts.collection_ops.len()).to_equal(0)  # oracle: without a registry row nothing may be admitted
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: findings may only rest on admitted facts, so zero is the fail-closed result

    it "fails closed when registry metadata is not verified":
        # @req REQ-009 REQ-023
        # @capture(statistics): unclassified count and empty op list for unverified evidence
        step("Collect facts against a registry row with no evidence receipt")
        val facts = collect_hir_function_perf_facts(
            pf_function(MethodResolution.InstanceMethod(
                SymbolId(id: 10), SymbolId(id: 32))), pf_registry(32, false))
        expect(facts.unclassified_method_calls).to_equal(1)  # oracle: an unverified row is treated exactly like a missing one
        expect(facts.collection_ops.len()).to_equal(0)  # oracle: no admission without evidence, so the op list stays empty
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: no admitted op means no COLL002 finding may be produced

    it "does not infer a collection capability without a typed receiver":
        # @req REQ-012
        # @capture(statistics): the unknown receiver reason text
        step("Ask for the receiver kind of an expression with no type")
        val untyped = HirExpr(
            kind: HirExprKind.UnitLit, has_type_: false,
            type_: pf_unit_type(), span: pf_span(9))
        match hir_perf_receiver_kind(untyped):
            case HirPerfReceiverKind.Unknown(reason):
                expect(reason).to_contain("unavailable")
            case _:
                expect(false).to_equal(true)

    it "does not convert an unresolved method name into cost evidence":
        # @req REQ-012
        # @capture(statistics): unclassified count and empty op list for an unresolved receiver
        step("Collect facts for a call whose method resolution failed")
        val facts = collect_hir_function_perf_facts(
            pf_function(MethodResolution.Unresolved), pf_registry(30, true))
        expect(facts.unclassified_method_calls).to_equal(1)  # oracle: even with a matching registry row, an unresolved call cannot be classified
        expect(facts.collection_ops.len()).to_equal(0)  # oracle: unresolved names admit no operation facts
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: no admitted op, so no finding

    it "suppresses an exact small literal iteration domain":
        # @req REQ-024
        # @capture(statistics): fixed-small verdict plus loop depth and finding count
        step("Iterate a one-element array literal and collect facts")
        val literal = pf_expr(HirExprKind.ArrayLit([
            pf_expr(HirExprKind.IntLit(1, nil), pf_array_type(), 10)
        ], nil), pf_array_type(), 10)
        expect(hir_perf_iteration_is_fixed_small(literal)).to_equal(true)
        val facts = collect_hir_function_perf_facts(
            pf_function_with_iter(MethodResolution.InstanceMethod(
                SymbolId(id: 10), SymbolId(id: 30)), literal),
            pf_registry(30, true))
        expect(facts.collection_ops[0].loop_depth).to_equal(0)  # oracle: a literal iteration domain is fully enumerated, so it does not count as loop ancestry
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: a lookup in a known-small domain is not a linear-cost risk

    it "poisons duplicate registry symbols instead of overwriting them":
        # @req REQ-010
        # @capture(statistics): structural-validity flag and lookup verdict after the duplicate
        step("Register the same symbol id twice and query the registry")
        var registry = pf_registry(40, true)
        val duplicate = registry.summaries[40]
        registry.register(duplicate)
        expect(registry.is_structurally_valid()).to_equal(false)
        expect(registry.lookup(40).?).to_equal(false)

    it "recognizes contains in an unknown while domain without claiming coverage":
        # @req REQ-009 REQ-012
        # @capture(statistics): unknown-domain count, coverage flag, and finding count
        step("Put the contains lookup inside a while loop with an unknown domain")
        val body = HirBlock(
            stmts: [HirStmt(kind: HirStmtKind.Expr(pf_lookup(
                MethodResolution.InstanceMethod(
                    SymbolId(id: 10), SymbolId(id: 30)))), span: pf_span(4))],
            has: false, value: pf_empty_expr(), span: pf_span(3))
        val loop = pf_expr(HirExprKind.While(
            pf_expr(HirExprKind.BoolLit(true), pf_bool_type(), 2), body, nil),
            pf_unit_type(), 2)
        val facts = collect_hir_function_perf_facts(
            pf_function_with_expr(loop), pf_registry(30, true))
        expect(facts.unknown_execution_domains).to_equal(1)  # oracle: a while loop over an unknown condition is exactly one unbounded domain
        expect(facts.coverage_complete).to_equal(false)
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(1)  # oracle: unlike the small-literal domain, an unbounded while is a real COLL002 risk

    it "does not relabel a different linear lookup as COLL002":
        # @req REQ-010 REQ-023
        # @capture(statistics): op count and empty COLL002 finding list
        step("Register the lookup as a plain LinearLookup, not ContainsLookup")
        val facts = collect_hir_function_perf_facts(
            pf_function(MethodResolution.InstanceMethod(
                SymbolId(id: 10), SymbolId(id: 30))),
            pf_registry_operation(30, true, HirPerfOperationKind.LinearLookup))
        expect(facts.collection_ops.len()).to_equal(1)  # oracle: the call is still admitted once, under its true operation kind
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: COLL002 is reserved for contains-style lookups, so a LinearLookup must not be relabeled

    it "rejects a registry contract with the wrong explicit arity":
        # @req REQ-010 REQ-023
        # @capture(statistics): op count, incomplete count, and finding count
        step("Register ContainsLookup with zero explicit arguments")
        val facts = collect_hir_function_perf_facts(
            pf_function(MethodResolution.InstanceMethod(
                SymbolId(id: 10), SymbolId(id: 30))),
            pf_registry_contract(
                30, true, HirPerfOperationKind.ContainsLookup, 0))
        expect(facts.collection_ops.len()).to_equal(1)  # oracle: the call is admitted but flagged, not dropped
        expect(facts.incomplete_ops).to_equal(1)  # oracle: the arity mismatch makes exactly this one op incomplete
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: an incomplete contract must not feed a COLL002 finding

    it "preserves parent receiver and argument preorder without counting wrappers":
        # @req REQ-024
        # @capture(statistics): the preorder method-name sequence of three nested lookups
        step("Nest lookups as parent, receiver, and argument and collect facts")
        val resolution = MethodResolution.InstanceMethod(
            SymbolId(id: 10), SymbolId(id: 30))
        val leaf_receiver = pf_expr(
            HirExprKind.NamedVar(SymbolId(id: 71), "leaf"),
            pf_array_type(), 20)
        val receiver_lookup = pf_named_lookup(
            leaf_receiver, "receiver_lookup", pf_array_type(),
            pf_expr(HirExprKind.IntLit(1, nil), pf_i64_type(), 21),
            resolution, 21)
        val argument_lookup = pf_named_lookup(
            leaf_receiver, "argument_lookup", pf_bool_type(),
            pf_expr(HirExprKind.IntLit(2, nil), pf_i64_type(), 22),
            resolution, 22)
        val parent_lookup = pf_named_lookup(
            receiver_lookup, "parent_lookup", pf_bool_type(),
            argument_lookup, resolution, 23)
        val facts = collect_hir_function_perf_facts(
            pf_function_with_expr(parent_lookup), pf_registry(30, true))
        expect(facts.collection_ops.len()).to_equal(3)  # oracle: parent plus receiver lookup plus argument lookup, with no synthetic wrapper ops
        expect(facts.collection_ops[0].method_name).to_equal("parent_lookup")
        expect(facts.collection_ops[1].method_name).to_equal("receiver_lookup")
        expect(facts.collection_ops[2].method_name).to_equal("argument_lookup")

    it "visits for and if expressions owned by comprehension clause kinds":
        # @req REQ-009 REQ-012
        # @capture(statistics): clause-ordered method names, loop depths, and coverage flags
        step("Put two lookups into a comprehension's for and if clauses")
        val resolution = MethodResolution.InstanceMethod(
            SymbolId(id: 10), SymbolId(id: 30))
        val leaf = pf_expr(
            HirExprKind.NamedVar(SymbolId(id: 70), "leaf"),
            pf_array_type(), 29)
        val iter_lookup = pf_named_lookup(
            leaf, "iter_lookup", pf_array_type(),
            pf_expr(HirExprKind.IntLit(1, nil), pf_i64_type(), 30),
            resolution, 30)
        val if_lookup = pf_named_lookup(
            leaf, "if_lookup", pf_bool_type(),
            pf_expr(HirExprKind.IntLit(2, nil), pf_i64_type(), 31),
            resolution, 31)
        val comprehension = pf_expr(HirExprKind.Comprehension(
            HirComprehensionKind.List,
            pf_expr(HirExprKind.IntLit(9, nil), pf_i64_type(), 29),
            [HirCompClause(
                kind: HirCompClauseKind.For(SymbolId(id: 72), iter_lookup),
                span: pf_span(30)),
             HirCompClause(
                kind: HirCompClauseKind.If(if_lookup), span: pf_span(31))]),
            pf_array_type(), 29)
        val facts = collect_hir_function_perf_facts(
            pf_function_with_expr(comprehension), pf_registry(30, true))
        expect(facts.collection_ops.len()).to_equal(2)  # oracle: one lookup per comprehension clause — the iter and the filter
        expect(facts.collection_ops[0].method_name).to_equal("iter_lookup")
        expect(facts.collection_ops[1].method_name).to_equal("if_lookup")
        expect(facts.collection_ops[0].loop_depth).to_equal(0)  # oracle: a comprehension clause is not itself an enclosing loop for its own iter expression
        expect(facts.collection_ops[1].loop_depth).to_equal(0)  # oracle: the filter clause is likewise not loop ancestry for its own lookup
        expect(facts.unknown_execution_domains).to_equal(1)  # oracle: the comprehension's own iteration domain is not statically bounded here, so one unknown domain
        expect(facts.coverage_complete).to_equal(false)
        expect(typed_coll002_linear_lookup_findings(facts).len()).to_equal(0)  # oracle: clause lookups without proven loop ancestry stay outside COLL002
