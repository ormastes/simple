# Body-free effect facts must come from real parser/lowering/layout walkers.
# These rows are not archive admission tokens; driver consumers replay them.
use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.common.config.{Logger}
use compiler.semantics.effect_validation.{EffectFunctionFactsV1,
    effect_function_facts_v1, validate_effect_contract_facts_v1,
    validate_effect_contracts, effect_struct_sizes, effect_fn_names}
use compiler.semantics.effect_verifier.{LOOP_BOUND_NONE, LOOP_BOUND_CONST}
use compiler.semantics.effect_validation.{effect_contract_claims_v1, validate_effect_claim_facts_v1}
use compiler.frontend.effect_registry.{effect_registry_reset}

fn lowered(src: text, path: text, name: text) -> HirModule:
    val parsed = parse_full_frontend(src, path, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    lowering.lower_module(parsed)

fn facts(modules: Dict<text, HirModule>) -> [EffectFunctionFactsV1]:
    val sizes = effect_struct_sizes(modules)
    val names = effect_fn_names(modules)
    var out: [EffectFunctionFactsV1] = []
    for key in modules.keys():
        for func in modules[key].functions.values():
            out.push(effect_function_facts_v1(func, sizes, names))
    out

describe "real lowered effect body facts and aggregate gate":
    it "replays a real transitive copy failure after its ambient claim is removed":
        effect_registry_reset()
        val hir = lowered("struct Blob:\n    a: i64\n\nfn helper(src: Blob) -> i64:\n    val dup: Blob = src\n    dup.a\n\n@copy_budget(0)\nfn outer(src: Blob) -> i64:\n    helper(src)\n", "facts_claim_copy.spl", "facts_claim_copy")
        val rows = facts({"facts_claim_copy": hir})
        val ids = ["facts_claim_copy.spl"]
        val claims = effect_contract_claims_v1()
        val original = validate_effect_contract_facts_v1(ids, rows)
        expect(original.len()).to_equal(1)
        expect(original[0]).to_contain("8 bytes (8 from callees)")
        effect_registry_reset()
        expect(validate_effect_claim_facts_v1(ids, rows, claims)).to_equal(original)
        expect(validate_effect_contract_facts_v1(ids, rows).len()).to_equal(0)

    it "replays actual loop obligations in original claim order without registry installation":
        effect_registry_reset()
        val hir = lowered("@bounded_loop\nfn first():\n    while true:\n        val one = 1\n\n@bounded_loop\nfn second():\n    while true:\n        val two = 2\n", "facts_claim_order.spl", "facts_claim_order")
        val rows = facts({"facts_claim_order": hir})
        val ids = ["facts_claim_order.spl"]
        val claims = effect_contract_claims_v1()
        val original = validate_effect_contract_facts_v1(ids, rows)
        expect(original.len()).to_equal(2)
        expect(original[0]).to_contain("first")
        expect(original[1]).to_contain("second")
        effect_registry_reset()
        expect(validate_effect_claim_facts_v1(ids, rows, claims)).to_equal(original)

    it "charges the actual 24-byte unannotated callee copy to its caller":
        val src = "struct Blob:\n    a: i64\n    b: i64\n    c: i64\n\nfn helper(src: Blob) -> i64:\n    val dup: Blob = src\n    dup.a\n\n@copy_budget(8)\nfn outer(src: Blob) -> i64:\n    helper(src)\n"
        val hir = lowered(src, "facts_transitive.spl", "facts_transitive")
        val modules = {"facts_transitive": hir}
        val rows = facts(modules)
        var copy_bytes = 0
        var calls: [text] = []
        for row in rows:
            if row.name == "helper":
                for copy in row.copies: copy_bytes = copy_bytes + copy.bytes
            if row.name == "outer": calls = row.callees
        expect(copy_bytes).to_equal(24)
        expect(calls.contains("helper")).to_equal(true)
        val errors = validate_effect_contract_facts_v1(["facts_transitive.spl", "facts_transitive"], rows)
        expect(errors.len()).to_equal(1)
        expect(errors[0]).to_contain("24 bytes (24 from callees)")
        expect(errors).to_equal(validate_effect_contracts(modules))

    it "retains actual unbounded and constant-bound loop classes":
        val src = "@bounded_loop\nfn spin():\n    while true:\n        val observed = 1\n\n@bounded_loop\nfn bounded():\n    var i = 0\n    while i < 16:\n        i = i + 1\n"
        val hir = lowered(src, "facts_loops.spl", "facts_loops")
        val rows = facts({"facts_loops": hir})
        var spin_bound = -1
        var constant_bound = -1
        for row in rows:
            if row.name == "spin": spin_bound = row.loops[0].bound_kind
            if row.name == "bounded": constant_bound = row.loops[0].bound_kind
        expect(spin_bound).to_equal(LOOP_BOUND_NONE)
        expect(constant_bound).to_equal(LOOP_BOUND_CONST)
        val errors = validate_effect_contract_facts_v1(["facts_loops.spl", "facts_loops"], rows)
        expect(errors.len()).to_equal(1)
        expect(errors[0]).to_contain("spin")

    it "checks every duplicate-named body while preserving claim order":
        val first = lowered("@bounded_loop\nfn shared():\n    while true:\n        val one = 1\n", "facts_first.spl", "facts_first")
        val second = lowered("fn shared():\n    while true:\n        val two = 2\n", "facts_second.spl", "facts_second")
        val modules = {"facts_first": first, "facts_second": second}
        val rows = facts(modules)
        expect(rows.len()).to_equal(2)
        val errors = validate_effect_contract_facts_v1(["facts_first.spl", "facts_first", "facts_second.spl", "facts_second"], rows)
        expect(errors.len()).to_equal(2)
        expect(errors[0]).to_contain("shared")
        expect(errors[1]).to_contain("shared")
        expect(errors).to_equal(validate_effect_contracts(modules))

    it "keeps out-of-compilation contracts scoped to their owner":
        val hir = lowered("@bounded_loop\nfn foreign():\n    while true:\n        val one = 1\n", "facts_foreign.spl", "facts_foreign")
        val rows = facts({"facts_foreign": hir})
        expect(validate_effect_contract_facts_v1(["different_source.spl"], rows).len()).to_equal(0)
        expect(validate_effect_contract_facts_v1(["facts_foreign.spl"], rows).len()).to_equal(1)

    it "rejects an in-scope claim whose lowered function fact is missing":
        val _hir = lowered("@bounded_loop\nfn missing():\n    var i = 0\n    while i < 2:\n        i = i + 1\n", "facts_missing.spl", "facts_missing")
        val errors = validate_effect_contract_facts_v1(["facts_missing.spl"], [])
        expect(errors.len()).to_equal(1)
        expect(errors[0]).to_contain("not a function visible in this compilation")
