#!/usr/bin/env simple
# Safety checker unsafe-boundary rules (lane SF2).
#
# Proves the previously-dead rules now fire (see
# doc/08_tracking/bug/safety_checker_pass_never_invoked_2026-07-27.md):
#   (i)   raw-pointer primitive call outside `unsafe:` warns
#   (ii)  the same call inside `unsafe:` is silent (also proves the
#         self-hosted `unsafe:` parse reaches HIR as UnsafeBlock)
#   (iii) inline asm outside `unsafe:` still warns (original rule)
#   (iv)  module extern-fn (FFI) call outside `unsafe:` warns

use std.spec.step

use std.spec
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.semantics.safety_checker.{SafetyChecker, SafetyError, safetychecker_check_module}

fn check_source(src: text, module_name: text) -> [SafetyError]:
    val parsed = parse_full_frontend(src, "testdata/{module_name}.spl", module_name, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("testdata/{module_name}.spl")
    val hir = hir_lowering.lower_module(parsed)
    val checker = SafetyChecker.create()
    safetychecker_check_module(checker, hir)

fn count_kind(errors: [SafetyError], kind: text) -> i64:
    var n = 0
    for e in errors:
        match e:
            case InlineAsmOutsideUnsafe(_):
                if kind == "asm":
                    n = n + 1
            case RawPointerOutsideUnsafe(_):
                if kind == "raw_ptr":
                    n = n + 1
            case UnsafeFfiOutsideUnsafe(_):
                if kind == "ffi":
                    n = n + 1
            case Other(_, _):
                if kind == "other":
                    n = n + 1
    n

describe "safety checker unsafe boundary":
    # @manual scenario evidence
    it "warns on raw-pointer primitive call outside unsafe":
        val src = "extern fn rt_alloc(size: i64) -> i64\n" +
            "fn use_raw() -> i64:\n" +
            "    val p = rt_alloc(16)\n" +
            "    p\n"
        val errors = check_source(src, "safety_raw_outside")
        expect(count_kind(errors, "raw_ptr")).to_equal(1)

    it "is silent for the same raw-pointer call inside unsafe":
        val src = "extern fn rt_alloc(size: i64) -> i64\n" +
            "fn use_raw() -> i64:\n" +
            "    unsafe:\n" +
            "        val p = rt_alloc(16)\n" +
            "    0\n"
        val errors = check_source(src, "safety_raw_inside")
        expect(count_kind(errors, "raw_ptr")).to_equal(0)
        expect(count_kind(errors, "ffi")).to_equal(0)

    it "still warns on inline asm outside unsafe":
        # Raw (single-quoted) segment for the `{ nop }` text: a double-quoted
        # literal auto-interpolates `{...}`, and the self-hosted frontend
        # eagerly lowers/evaluates that embedded `nop` as a real identifier
        # expression -- unrelated to inline-asm lowering itself (same failure
        # mode reproduces on the pre-existing, unrelated
        # inline_asm_core_parser_spec.spl, which is red for the same reason).
        val src = "fn touch():\n" +
            '    asm { nop }' + "\n"
        val errors = check_source(src, "safety_asm_outside")
        expect(count_kind(errors, "asm")).to_equal(1)

    it "is silent for inline asm inside unsafe":
        val src = "fn touch():\n" +
            "    unsafe:\n" +
            '        asm { nop }' + "\n"
        val errors = check_source(src, "safety_asm_inside")
        expect(count_kind(errors, "asm")).to_equal(0)

    it "warns on module extern fn (FFI) call outside unsafe":
        val src = "extern fn my_device_poke(x: i64) -> i64\n" +
            "fn use_ffi() -> i64:\n" +
            "    my_device_poke(1)\n"
        val errors = check_source(src, "safety_ffi_outside")
        expect(count_kind(errors, "ffi")).to_equal(1)

    it "does not infer foreign identity from an rt-prefixed Simple function":
        step("Verify: resolved declaration identity outranks name spelling")
        val src = "fn rt_imported_probe() -> i64:\n" +
            "    1\n" +
            "fn use_imported_raw() -> i64:\n" +
            "    rt_imported_probe()\n"
        val errors = check_source(src, "safety_imported_ffi_outside")
        expect(count_kind(errors, "ffi")).to_equal(0)

    it "accepts imported-style raw runtime call inside unsafe":
        # @req REQ-SSPEC-COMPILER
        step("accepts imported-style raw runtime call inside unsafe")
        step("Verify: minimal ffi boundary admits imported rt identity")
        val src = "fn rt_imported_probe() -> i64:\n" +
            "    1\n" +
            "fn use_imported_raw() -> i64:\n" +
            "    unsafe(capabilities: [ffi]):\n" +
            "        rt_imported_probe()\n"
        val errors = check_source(src, "safety_imported_ffi_inside")
        expect(count_kind(errors, "ffi")).to_equal(0)

    it "warns on an aliased imported extern without relying on its spelling":
        step("Verify: resolved extern identity survives an import alias")
        val provider = "pub extern fn device_poke(x: i64)\n"
        val consumer = r"use ffi_provider.{device_poke as poke}" + "\n" +
            "fn use_ffi():\n" +
            "    poke(1)\n"
        val (errors, inventory) = check_imported_source(provider, consumer)
        expect(errors.len()).to_equal(1)
        expect(count_kind(errors, "ffi")).to_equal(1)
        expect(inventory.raw_call_sites).to_equal(1)
        expect(inventory.resolved_raw_call_sites).to_equal(1)
        expect(inventory.aliased_raw_call_sites).to_equal(1)
        expect(inventory.missing_authority_call_sites).to_equal(1)
        expect(inventory.lexically_scoped_call_sites).to_equal(0)
        expect(inventory.hir_complete).to_equal(true)
        expect(inventory.signature_evidence_included).to_equal(false)
        expect(inventory.verification_evidence_included).to_equal(false)

    it "covers the static mutability reference unsafe MC/DC matrix":
        step("Verify each static/ref/unsafe condition independently affects its diagnostic")
        val immutable_ref_out = check_source(
            "val STATIC_VALUE = 1\nfn f():\n    val p = &STATIC_VALUE\n", "static_immutable_ref_out")
        val immutable_mut_ref_out = check_source(
            "val STATIC_VALUE = 1\nfn f():\n    val p = &mut STATIC_VALUE\n", "static_immutable_mut_ref_out")
        val mutable_ref_out = check_source(
            "var STATIC_VALUE = 1\nfn f():\n    val p = &STATIC_VALUE\n", "static_mutable_ref_out")
        val mutable_mut_ref_out = check_source(
            "var STATIC_VALUE = 1\nfn f():\n    val p = &mut STATIC_VALUE\n", "static_mutable_mut_ref_out")
        val immutable_ref_in = check_source(
            "val STATIC_VALUE = 1\nfn f():\n    unsafe:\n        val p = &STATIC_VALUE\n", "static_immutable_ref_in")
        val immutable_mut_ref_in = check_source(
            "val STATIC_VALUE = 1\nfn f():\n    unsafe:\n        val p = &mut STATIC_VALUE\n", "static_immutable_mut_ref_in")
        val mutable_ref_in = check_source(
            "var STATIC_VALUE = 1\nfn f():\n    unsafe:\n        val p = &STATIC_VALUE\n", "static_mutable_ref_in")
        val mutable_mut_ref_in = check_source(
            "var STATIC_VALUE = 1\nfn f():\n    unsafe:\n        val p = &mut STATIC_VALUE\n", "static_mutable_mut_ref_in")

        expect(count_kind(immutable_ref_out, "static_ref")).to_equal(1)
        expect(count_kind(immutable_ref_out, "immutable_static_mut_ref")).to_equal(0)
        expect(count_kind(immutable_mut_ref_out, "static_ref")).to_equal(1)
        expect(count_kind(immutable_mut_ref_out, "immutable_static_mut_ref")).to_equal(1)
        expect(count_kind(mutable_ref_out, "static_ref")).to_equal(1)
        expect(count_kind(mutable_ref_out, "immutable_static_mut_ref")).to_equal(0)
        expect(count_kind(mutable_mut_ref_out, "static_ref")).to_equal(1)
        expect(count_kind(mutable_mut_ref_out, "immutable_static_mut_ref")).to_equal(0)
        expect(count_kind(immutable_ref_in, "static_ref")).to_equal(0)
        expect(count_kind(immutable_ref_in, "immutable_static_mut_ref")).to_equal(0)
        expect(count_kind(immutable_mut_ref_in, "static_ref")).to_equal(0)
        expect(count_kind(immutable_mut_ref_in, "immutable_static_mut_ref")).to_equal(1)
        expect(count_kind(mutable_ref_in, "static_ref")).to_equal(0)
        expect(count_kind(mutable_ref_in, "immutable_static_mut_ref")).to_equal(0)
        expect(count_kind(mutable_mut_ref_in, "static_ref")).to_equal(0)
        expect(count_kind(mutable_mut_ref_in, "immutable_static_mut_ref")).to_equal(0)

    it "does not classify references to locals as static references":
        step("Verify locals preserve their existing reference behavior")
        val errors = check_source(
            "fn f():\n    var local = 1\n    val p = &mut local\n", "local_mut_ref")
        expect(count_kind(errors, "static_ref")).to_equal(0)
        expect(count_kind(errors, "immutable_static_mut_ref")).to_equal(0)

    it "restores nested unsafe depth before checking a following reference":
        step("Verify nested unsafe blocks restore the exact enclosing depth")
        val src = "val STATIC_VALUE = 1\nfn f():\n" +
            "    unsafe:\n        unsafe:\n            val a = &STATIC_VALUE\n" +
            "        val b = &STATIC_VALUE\n    val c = &STATIC_VALUE\n"
        val errors = check_source(src, "nested_static_ref_restore")
        expect(count_kind(errors, "static_ref")).to_equal(1)

    it "preserves imported static mutability for reference diagnostics":
        step("Verify imported immutable and mutable statics match local policy")
        val immutable_provider = "pub val EXPORTED = 1\n"
        val immutable_consumer = r"use ffi_provider.{EXPORTED}" + "\n" +
            "fn f():\n    unsafe:\n        val p = &mut EXPORTED\n"
        val (immutable_errors, _) = check_imported_source(
            immutable_provider, immutable_consumer)
        expect(count_kind(immutable_errors, "static_ref")).to_equal(0)
        expect(count_kind(immutable_errors, "immutable_static_mut_ref")).to_equal(1)

        val mutable_provider = "pub var EXPORTED = 1\n"
        val mutable_consumer = r"use ffi_provider.{EXPORTED}" + "\n" +
            "fn f():\n    unsafe:\n        val p = &mut EXPORTED\n"
        val (mutable_errors, _) = check_imported_source(
            mutable_provider, mutable_consumer)
        expect(count_kind(mutable_errors, "static_ref")).to_equal(0)
        expect(count_kind(mutable_errors, "immutable_static_mut_ref")).to_equal(0)

    it "accepts the same aliased imported extern inside minimal unsafe":
        step("Verify: alias identity respects the lexical ffi boundary")
        val provider = "pub extern fn device_poke(x: i64)\n"
        val consumer = r"use ffi_provider.{device_poke as poke}" + "\n" +
            "fn use_ffi():\n" +
            "    unsafe(capabilities: [ffi]):\n" +
            "        poke(1)\n"
        val (errors, inventory) = check_imported_source(provider, consumer)
        expect(errors.len()).to_equal(0)
        expect(inventory.raw_call_sites).to_equal(1)
        expect(inventory.missing_authority_call_sites).to_equal(0)
        expect(inventory.lexically_scoped_call_sites).to_equal(1)
        expect(inventory.hir_complete).to_equal(true)

    it "tracks a resolved extern reached through UFCS":
        step("Verify: resolved UFCS identity retains the FFI boundary")
        val provider = "pub extern fn device_poke(x: i64) -> i64\n"
        val consumer = r"use ffi_provider.{device_poke}" + "\n" +
            "fn use_ffi() -> i64:\n" +
            "    1.device_poke()\n"
        val (errors, inventory) = check_imported_source(provider, consumer)
        expect(count_kind(errors, "ffi")).to_equal(1)
        expect(inventory.raw_call_sites).to_equal(1)
        expect(inventory.resolved_raw_call_sites).to_equal(1)
        expect(inventory.missing_authority_call_sites).to_equal(1)

    it "accepts the same resolved UFCS extern inside minimal unsafe":
        step("Verify: resolved UFCS identity respects lexical FFI authority")
        val provider = "pub extern fn device_poke(x: i64) -> i64\n"
        val consumer = r"use ffi_provider.{device_poke}" + "\n" +
            "fn use_ffi() -> i64:\n" +
            "    unsafe(capabilities: [ffi]):\n" +
            "        1.device_poke()\n"
        val (errors, inventory) = check_imported_source(provider, consumer)
        expect(count_kind(errors, "ffi")).to_equal(0)
        expect(inventory.raw_call_sites).to_equal(1)
        expect(inventory.missing_authority_call_sites).to_equal(0)
        expect(inventory.lexically_scoped_call_sites).to_equal(1)

    it "does not classify an imported safe wrapper as raw ffi":
        step("Verify: foreign identity does not leak through safe wrappers")
        val provider = "extern fn device_poke(x: i64) -> i64\n" +
            "pub fn checked_poke(x: i64) -> i64:\n" +
            "    unsafe(capabilities: [ffi]):\n" +
            "        device_poke(x)\n"
        val consumer = r"use ffi_provider.{checked_poke as poke}" + "\n" +
            "fn use_wrapper() -> i64:\n" +
            "    poke(1)\n"
        val (errors, inventory) = check_imported_source(provider, consumer)
        expect(errors.len()).to_equal(0)
        expect(inventory.raw_call_sites).to_equal(0)
        expect(inventory.resolved_extern_symbols).to_equal(0)
        expect(inventory.hir_complete).to_equal(true)
