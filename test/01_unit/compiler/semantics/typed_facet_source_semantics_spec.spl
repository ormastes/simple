# @req REQ-AF-003 REQ-AF-006
# @cover src/compiler/10.frontend/core/parser_expr.spl 80%
# @cover src/compiler/20.hir/hir_lowering/expressions.spl 80%
# @cover src/compiler/35.semantics/safety_checker.spl 80%

use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_definitions.{HirExprKind, HirStmtKind}
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.semantics.safety_checker.{
    SafetyChecker, SafetyError, safetychecker_check_module
}

fn typed_facet_source(body: text) -> text:
    "aspect debug:\n" +
    "    facet interface Debuggable:\n" +
    "        fn snapshot(self) -> i64\n" +
    "        fn merge(self, other: i64) -> i64\n" +
    # Deliberate same-name declaration: facet signature lowering must bind the
    # compiler-known canonical context, never this unrelated local type.
    "struct AspectExecutionContext:\n" +
    "    marker: i64\n" +
    "struct Cache:\n" +
    "    marker: i64\n" +
    "struct OrdinaryContract:\n" +
    "    marker: i64\n" +
    "fn use_facet(context: AspectExecutionContext, cache: Cache) -> i64:\n" +
    body

fn lower_typed_facet_source(body: text):
    val parsed = parse_full_frontend(
        typed_facet_source(body), "typed_facet_source.spl",
        "typed_facet_source", Logger(level: 0))
    var lowering = HirLowering.with_filename("typed_facet_source.spl")
    lowering.lower_module(parsed)

fn count_facet_escape_errors(errors: [SafetyError]) -> i64:
    var count = 0
    for error in errors:
        match error:
            case Other(message, _):
                if message.starts_with("E-AF006"):
                    count = count + 1
            case _: pass
    count

describe "typed facet source and HIR ownership":
    it "assigns the documented wrapper type to each acquisition form":
        val hir = lower_typed_facet_source(
            "    val maybe_debug = context.try_facet<Debuggable>(cache)\n" +
            "    val loaded_debug = context.facet<Debuggable>(cache)\n" +
            "    val required_debug = context.require_facet<Debuggable>(cache)\n" +
            "    0\n")
        var saw_try = false
        var saw_facet = false
        var saw_require = false
        var facet_error_symbol = -1
        var require_error_symbol = -1
        var acquisition_context_symbol = -1
        for item in hir.functions:
            val function = item[1]
            if function.name != "use_facet": continue
            for statement in function.body.stmts:
                match statement.kind:
                    case Let(_, _, init):
                        match init.kind:
                            case FacetAcquire(context, _, _, mode):
                                match context.kind:
                                    case Var(value_symbol) | NamedVar(value_symbol, _):
                                        if val value = hir.symbols.get_symbol_raw(value_symbol.id):
                                            if val value_type = value.type_:
                                                match value_type.kind:
                                                    case HirTypeKind.Named(symbol, _):
                                                        acquisition_context_symbol = symbol.id
                                                    case _: pass
                                    case _: pass
                                if init.type_ == nil:
                                    fail("facet acquisition must retain its HIR wrapper type")
                                val acquired_type = init.type_ ?? HirType(
                                    kind: HirTypeKind.Error, span: init.span)
                                match (mode, acquired_type.kind):
                                    case ("try_facet", HirTypeKind.Optional(_)):
                                        saw_try = true
                                    case ("facet", HirTypeKind.Result(ok, error)):
                                        match (ok.kind, error.kind):
                                            case (HirTypeKind.Optional(_), HirTypeKind.Named(symbol, _)):
                                                facet_error_symbol = symbol.id
                                                saw_facet = true
                                            case _:
                                                fail("facet must be Result<Option<FacetRef<T>>, FacetAcquireError>")
                                    case ("require_facet", HirTypeKind.Result(ok, error)):
                                        match (ok.kind, error.kind):
                                            case (HirTypeKind.Named(_, _), HirTypeKind.Named(symbol, _)):
                                                require_error_symbol = symbol.id
                                                saw_require = true
                                            case _:
                                                fail("require_facet must be Result<FacetRef<T>, FacetAcquireError>")
                                    case _:
                                        fail("unexpected facet acquisition wrapper type")
                            case _: pass
                    case _: pass
        if not saw_try: fail("missing typed try_facet HIR")
        if not saw_facet: fail("missing typed facet HIR")
        if not saw_require: fail("missing typed require_facet HIR")
        if facet_error_symbol != require_error_symbol:
            fail("facet and require_facet must share one canonical error symbol")
        if val error_type_symbol = hir.symbols.get_symbol_raw(facet_error_symbol):
            if error_type_symbol.name != "FacetAcquireError":
                fail("facet acquisition error must be canonical FacetAcquireError")
            if (error_type_symbol.defining_module ?? "") != "std.nogc_sync_mut.aop.facet":
                fail("FacetAcquireError must retain its std.aop owner identity")
        else:
            fail("canonical FacetAcquireError symbol must exist")
        val context_raw = hir.symbols.lookup_qualified_type_raw(
            "app.startup.aspect_application_runtime", "AspectExecutionContext")
        if context_raw < 0:
            fail("facet source must receive canonical AspectExecutionContext without an app.startup import")
        if acquisition_context_symbol != context_raw:
            fail("same-named local type must not replace the canonical facet context")
        if val context_symbol = hir.symbols.get_symbol_raw(context_raw):
            if context_symbol.name != "AspectExecutionContext":
                fail("facet context must retain its canonical source spelling")
        else:
            fail("canonical AspectExecutionContext symbol must exist")

    it "preserves explicit context, typed base, contract, and member provenance":
        val hir = lower_typed_facet_source(
            "    val debug = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    debug.snapshot()\n" +
            "    0\n")
        var saw_acquire = false
        var saw_member = false
        for item in hir.functions:
            val function = item[1]
            if function.name == "use_facet":
                for statement in function.body.stmts:
                    match statement.kind:
                        case Let(_, _, init):
                            match init.kind:
                                case FacetAcquire(_, _, _, mode):
                                    expect(mode).to_equal("require_facet")
                                    saw_acquire = true
                                case MethodCall(receiver, method, _, _):
                                    if method == "unwrap":
                                        match receiver.kind:
                                            case FacetAcquire(_, _, _, mode):
                                                expect(mode).to_equal("require_facet")
                                                saw_acquire = true
                                            case _: pass
                                case _: pass
                        case Expr(expr):
                            match expr.kind:
                                case FacetMemberCall(_, method, _, _):
                                    expect(method).to_equal("snapshot")
                                    saw_member = true
                                case _: pass
                        case _: pass
        if not saw_acquire:
            fail("expected real FacetAcquire HIR")
        if not saw_member:
            fail("expected FacetMemberCall provenance")

    it "keeps wrapper methods ordinary until Result and Option are removed":
        val hir = lower_typed_facet_source(
            "    val loaded = context.facet<Debuggable>(cache)\n" +
            "    loaded.is_ok()\n" +
            "    val debug = loaded.unwrap().unwrap()\n" +
            "    debug.snapshot()\n" +
            "    0\n")
        var saw_wrapper_method = false
        var saw_unwrapped_member = false
        for item in hir.functions:
            val function = item[1]
            if function.name != "use_facet": continue
            for statement in function.body.stmts:
                match statement.kind:
                    case Expr(expr):
                        match expr.kind:
                            case MethodCall(_, method, _, _):
                                if method == "is_ok": saw_wrapper_method = true
                            case FacetMemberCall(_, method, _, _):
                                if method == "snapshot": saw_unwrapped_member = true
                            case _: pass
                    case _: pass
        if not saw_wrapper_method:
            fail("Result wrapper method must not become facet dispatch")
        if not saw_unwrapped_member:
            fail("fully unwrapped FacetRef must retain facet dispatch provenance")

    it "rejects copy and return escapes by HIR symbol identity":
        val hir = lower_typed_facet_source(
            "    val debug = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    val copied = debug\n" +
            "    return debug\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_facet_escape_errors(errors)).to_equal(2)

    it "rejects assignment copies and leased facet method arguments":
        val hir = lower_typed_facet_source(
            "    var first = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    val second = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    first = second\n" +
            "    first.merge(second)\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_facet_escape_errors(errors)).to_equal(2)

    it "allows local member use without treating it as an escape":
        val hir = lower_typed_facet_source(
            "    val debug = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    debug.snapshot()\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_facet_escape_errors(errors)).to_equal(0)

    it "rejects a nominally wrong acquisition context":
        val hir = lower_typed_facet_source(
            "    val debug = cache.require_facet<Debuggable>(cache)\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        var found = false
        for error in errors:
            match error:
                case Other(message, _):
                    if message.contains("exact AspectExecutionContext"):
                        found = true
                case _: pass
        expect(found).to_be(true)

    it "rejects an ordinary nominal type as the facet contract":
        val hir = lower_typed_facet_source(
            "    val wrong = context.require_facet<OrdinaryContract>(cache)\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        var found = false
        for error in errors:
            match error:
                case Other(message, _):
                    if message.contains("not a declared facet interface"):
                        found = true
                case _: pass
        expect(found).to_be(true)

    it "rejects a member absent from the canonical facet interface":
        val hir = lower_typed_facet_source(
            "    val debug = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    debug.missing_member()\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        var found = false
        for error in errors:
            match error:
                case Other(message, _):
                    if message.contains("has no member 'missing_member'"):
                        found = true
                case _: pass
        expect(found).to_be(true)

    it "rejects lambda capture using HIR symbol identity":
        val hir = lower_typed_facet_source(
            "    val debug = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    val closure = \\: debug.snapshot()\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_facet_escape_errors(errors)).to_equal(1)

    it "rejects capture by a closure passed to an async boundary":
        val hir = lower_typed_facet_source(
            "    val debug = context.require_facet<Debuggable>(cache).unwrap()\n" +
            "    task_spawn(\\: debug.snapshot())\n" +
            "    0\n")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_facet_escape_errors(errors)).to_equal(1)
