use std.spec.*
use std.io_runtime.{file_read}

# Bug dot_question_returns_optional_but_25_sites_return_it_as_bool_2026-08-09:
# `.?` yields T? (payload-or-nil), so a `-> bool` fn must not end in a bare `.?`.
# Source-scan guard over the sites fixed here (sibling-prevention).
fn has_tail_exists_check(path: text, signature: text) -> bool:
    val lines = file_read(path).split("\n")
    var in_fn = false
    var found = false
    for line in lines:
        if line.contains(signature):
            in_fn = true
        elif in_fn:
            val t = line.trim()
            if t.ends_with(".?") and not t.contains(" if ") and not t.starts_with("#"):
                found = true
            if t.starts_with("fn ") or t.starts_with("me "):
                in_fn = false
    found

describe "-> bool functions do not leak .? payload":
    it "TypeAlias has_default":
        expect(has_tail_exists_check("src/compiler/25.traits/trait_def.spl", "fn has_default() -> bool")).to_equal(false)
    it "const_keys has_suggestion and can_validate":
        expect(has_tail_exists_check("src/compiler/35.semantics/const_keys.spl", "fn has_suggestion() -> bool")).to_equal(false)
        expect(has_tail_exists_check("src/compiler/35.semantics/const_keys.spl", "fn can_validate() -> bool")).to_equal(false)
    it "pkg manifest has_dep":
        expect(has_tail_exists_check("src/app/pkg/manifest.spl", "fn has_dep(dep_name: text) -> bool")).to_equal(false)
    it "lazy_val contains (both copies)":
        expect(has_tail_exists_check("src/app/interpreter/lazy/lazy_val.spl", "fn contains(key: K) -> bool")).to_equal(false)
        expect(has_tail_exists_check("src/app/interpreter/lazy/lazy_val_fixed.spl", "fn contains(key: K) -> bool")).to_equal(false)
    it "bug db is_split_table_db (both copies)":
        expect(has_tail_exists_check("src/lib/nogc_sync_mut/database/bug.spl", "fn is_split_table_db() -> bool")).to_equal(false)
        expect(has_tail_exists_check("src/lib/nogc_async_mut/database/bug.spl", "fn is_split_table_db() -> bool")).to_equal(false)

describe "-> bool functions do not leak .? payload (follow-up sites)":
    it "vhdl call lowering (backend and plugin copies)":
        val paths = ["src/compiler/70.backend/backend/vhdl/vhdl_call_lowering.spl", "src/plugins/backend_vhdl/vhdl/vhdl_call_lowering.spl"]
        for p in paths:
            expect(has_tail_exists_check(p, "fn hardware_call_uses_port_map(caller: MirFunction, operand: MirOperand) -> bool")).to_equal(false)
            expect(has_tail_exists_check(p, "fn call_is_lowered_hardware_entity(operand: MirOperand) -> bool")).to_equal(false)
    it "nvfs root device superblock probe":
        expect(has_tail_exists_check("src/os/kernel/boot/nvfs_root_device.spl", "fn nvfs_root_device_has_superblock(dev: BlockDevice) -> bool")).to_equal(false)
    it "clang catalog triplet present":
        expect(has_tail_exists_check("src/os/kernel/loader/clang_filesystem_signed_catalog_boot_v1.spl", "fn _catalog_triplet_present_v1() -> bool")).to_equal(false)
