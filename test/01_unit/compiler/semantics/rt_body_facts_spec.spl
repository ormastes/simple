# Actual parser/lowering body scans, not hand-built HirBlock witnesses.
use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.common.config.{Logger}
use compiler.semantics.rt_criticality_validation.*
use compiler.semantics.rt_criticality.{RT_EFFECT_ALLOC, RT_EFFECT_LOOP,
    RtCriticalDiagnostic, RtCriticalDiagnosticSeverity, rt_bound_manifest_capabilities,
    RtCriticalFact, RtBoundCapability, rt_closure_digest, rt_bound_manifest_replace, rt_bound_manifest_clear}
use compiler.frontend.rt_criticality_registry.{rt_criticality_reset, rt_criticality_declare}

fn lowered(src: text, path: text, name: text) -> HirModule:
    val parsed = parse_full_frontend(src, path, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    lowering.lower_module(parsed)

fn body_facts(modules: Dict<text, HirModule>) -> [RtCriticalFunctionFactsV1]:
    var declarations: [RtCriticalFunctionDeclarationV1] = []
    for key in modules.keys():
        for declaration in rt_module_function_declarations_v1(key, modules[key]):
            declarations.push(declaration)
    val names = rt_unambiguous_declaration_names_v1(declarations)
    var out: [RtCriticalFunctionFactsV1] = []
    for key in modules.keys():
        val module = modules[key]
        for func in module.functions.values(): out.push(rt_function_facts_v1(key, module, func, names))
    out

fn messages(diagnostics: [RtCriticalDiagnostic]) -> [text]:
    var out: [text] = []
    for diagnostic in diagnostics: out.push(diagnostic.message)
    out

describe "RT shared actual body facts and aggregate policy":
    it "replays a source-declared critical allocation failure after claim removal":
        rt_criticality_reset()
        rt_bound_manifest_clear()
        val hir = lowered("@rt(critical)\nfn array_value() -> [i64]:\n    [1, 2]\n", "rt_claim_replay.spl", "rt_claim_replay")
        val rows = body_facts({"rt_claim_replay": hir})
        val claims = rt_critical_contract_claims_v1()
        expect(claims.len()).to_equal(1)
        expect(claims[0].fn_name).to_equal("array_value")
        expect(claims[0].profile).to_equal("critical")
        val ids = ["rt_claim_replay.spl"]
        val original = validate_rt_criticality_facts_with_capabilities_v1(ids, rows, [])
        expect(original.len()).to_equal(1)
        expect(original[0].severity).to_equal(RtCriticalDiagnosticSeverity.Error)
        expect(original[0].message).to_contain("RT-E-UNBOUNDED-ALLOCATION")
        rt_criticality_reset()
        val replay = validate_rt_criticality_claim_facts_v1(ids, rows, [], claims, false)
        expect(messages(replay)).to_equal(messages(original))
        expect(replay[0].severity).to_equal(original[0].severity)
        expect(validate_rt_criticality_facts_with_capabilities_v1(ids, rows, []).len()).to_equal(0)

    it "uses the captured severity for a real source-declared lower-tier allocation":
        rt_criticality_reset()
        val hir = lowered("@rt(robust,reason:\"test\")\nfn lower_array() -> [i64]:\n    [3, 4]\n", "rt_claim_severity.spl", "rt_claim_severity")
        val rows = body_facts({"rt_claim_severity": hir})
        val claims = rt_critical_contract_claims_v1()
        expect(claims.len()).to_equal(1)
        expect(claims[0].reason).to_equal("test")
        rt_criticality_reset()
        val warning = validate_rt_criticality_claim_facts_v1(["rt_claim_severity.spl"], rows, [], claims, false)
        val error = validate_rt_criticality_claim_facts_v1(["rt_claim_severity.spl"], rows, [], claims, true)
        expect(warning.len()).to_equal(1)
        expect(warning[0].severity).to_equal(RtCriticalDiagnosticSeverity.Warning)
        expect(warning[0].message).to_contain("RT-W-STEADY-ALLOCATION-001")
        expect(error.len()).to_equal(1)
        expect(error[0].severity).to_equal(RtCriticalDiagnosticSeverity.Error)
        expect(error[0].message).to_contain("RT-E-STEADY-ALLOCATION-001")

    it "retains allocation and unbounded-loop observed units from real bodies":
        val hir = lowered("fn array_value() -> [i64]:\n    [1, 2]\n\nfn spin():\n    while true:\n        val one = 1\n", "rt_facts_units.spl", "rt_facts_units")
        val rows = body_facts({"rt_facts_units": hir})
        var alloc_units = 0
        var loop_units = 0
        for row in rows:
            if row.declaration.name == "array_value":
                expect((row.own_effects & RT_EFFECT_ALLOC) != 0).to_equal(true)
                alloc_units = row.effect_units[RT_EFFECT_ALLOC] ?? 0
            if row.declaration.name == "spin":
                expect((row.own_effects & RT_EFFECT_LOOP) != 0).to_equal(true)
                loop_units = row.effect_units[RT_EFFECT_LOOP] ?? 0
        expect(alloc_units).to_equal(1)
        expect(loop_units).to_equal(1)

    it "propagates an unannotated callee allocation to its critical caller":
        rt_criticality_reset()
        val hir = lowered("fn helper() -> [i64]:\n    [1, 2]\n\nfn caller() -> [i64]:\n    helper()\n", "rt_facts_call.spl", "rt_facts_call")
        rt_criticality_declare("rt_facts_call.spl", "caller", "critical")
        val modules = {"rt_facts_call": hir}
        val rows = body_facts(modules)
        val projected = validate_rt_criticality_facts_v1(["rt_facts_call.spl", "rt_facts_call"], rows)
        expect(projected.len()).to_equal(1)
        expect(projected[0].severity).to_equal(RtCriticalDiagnosticSeverity.Error)
        expect(projected[0].message).to_contain("RT-E-UNBOUNDED-ALLOCATION")
        expect(messages(projected)).to_equal(messages(validate_rt_criticality_diagnostics(modules)))
        expect(rt_bound_manifest_capabilities().len()).to_equal(0)
        rt_criticality_reset()

    it "rejects two same-named callee providers without choosing a leaf":
        rt_criticality_reset()
        val first = lowered("fn helper() -> i64:\n    1\n\nfn caller() -> i64:\n    helper()\n", "rt_facts_first.spl", "rt_facts_first")
        val second = lowered("fn helper() -> i64:\n    2\n", "rt_facts_second.spl", "rt_facts_second")
        rt_criticality_declare("rt_facts_first.spl", "caller", "critical")
        val modules = {"rt_facts_first": first, "rt_facts_second": second}
        val projected = validate_rt_criticality_facts_v1(["rt_facts_first.spl", "rt_facts_first", "rt_facts_second.spl", "rt_facts_second"], body_facts(modules))
        expect(messages(projected).join("\n")).to_contain("RT-E-UNBOUNDED-UNKNOWN")
        expect(messages(projected)).to_equal(messages(validate_rt_criticality_diagnostics(modules)))
        rt_criticality_reset()

    it "preserves a missing in-scope root as an unproved body":
        rt_criticality_reset()
        val _hir = lowered("fn missing() -> i64:\n    1\n", "rt_facts_missing.spl", "rt_facts_missing")
        rt_criticality_declare("rt_facts_missing.spl", "missing", "critical")
        val rejected = validate_rt_criticality_facts_v1(["rt_facts_missing.spl"], [])
        expect(rejected.len()).to_equal(1)
        expect(rejected[0].message).to_contain("has no lowered body")
        rt_criticality_reset()

    it "retains HAL declaration ownership from actual function attributes":
        val hir = lowered("@rt(hal, operation:io.read.v1, providers:pure+c+rust, comparator:11, normalizer:12)\nfn tagged(value: i64) -> i64:\n    value\nfn plain(value: i64) -> i64:\n    value\n", "rt_facts_hal.spl", "rt_facts_hal")
        var tagged = false
        var plain = true
        for declaration in rt_module_function_declarations_v1("rt_facts_hal", hir):
            if declaration.name == "tagged": tagged = declaration.is_rt_hal
            if declaration.name == "plain": plain = declaration.is_rt_hal
            expect(declaration.module_path).to_equal("rt_facts_hal.spl")
            expect(declaration.module_key).to_equal("rt_facts_hal")
        expect(tagged).to_equal(true)
        expect(plain).to_equal(false)

    it "replays the consumed actual capability without installing stale grants":
        rt_criticality_reset()
        rt_bound_manifest_clear()
        val hir = lowered("fn bounded_array() -> [i64]:\n    [1, 2]\n", "rt_facts_manifest.spl", "rt_facts_manifest")
        rt_criticality_declare("rt_facts_manifest.spl", "bounded_array", "critical")
        val rows = body_facts({"rt_facts_manifest": hir})
        expect(rows.len()).to_equal(1)
        val row = rows[0]
        val root = rt_stable_fn_id(row.declaration.module_key, row.declaration.symbol_id)
        val facts = [RtCriticalFact(name: root, own_effects: row.own_effects,
            bounded_effects: 0, callees: [], line: row.declaration.line, effect_units: row.effect_units)]
        val capability = RtBoundCapability(subject_id: root, closure_digest: rt_closure_digest(root, facts),
            effect: RT_EFFECT_ALLOC, max_units: 1, review_id: "FIXTURE-ACTUAL-ALLOC-ONE")
        rt_bound_manifest_replace([capability])
        val actual = rt_bound_manifest_capabilities()
        val ids = ["rt_facts_manifest.spl", "rt_facts_manifest"]
        expect(validate_rt_criticality_facts_v1(ids, rows).len()).to_equal(0)
        expect(rt_bound_manifest_capabilities().len()).to_equal(0)
        expect(validate_rt_criticality_facts_with_capabilities_v1(ids, rows, actual).len()).to_equal(0)
        expect(rt_bound_manifest_capabilities().len()).to_equal(0)
        val changed = RtBoundCapability(..capability, max_units: 0)
        val denied = validate_rt_criticality_facts_with_capabilities_v1(ids, rows, [changed])
        expect(messages(denied).join("\n")).to_contain("RT-E-UNBOUNDED-ALLOCATION")
        rt_bound_manifest_replace([changed])
        expect(validate_rt_criticality_facts_with_capabilities_v1(ids, rows, actual).len()).to_equal(0)
        # Pure replay must not clear a manifest owned by the next compilation.
        expect(rt_bound_manifest_capabilities()[0].max_units).to_equal(0)
        rt_bound_manifest_clear()
        rt_criticality_reset()
