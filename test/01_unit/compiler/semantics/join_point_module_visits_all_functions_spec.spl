"""
## Purpose and audience
Purpose: Pin that forward_join_points_for_module_v1 visits every function of a
module that declares several, after its `Dict<SymbolId, HirFunction>` walk was
rewritten to index with the keys() element directly.
Audience: compiler engineers who maintain 35.semantics and the bootstrap lanes.

LIMIT, stated plainly: this is a behavioural pin at whatever level the test
runner executes it (interpreter / seed). It CANNOT reproduce the native
failure it guards against. That failure needs code generated by the frozen
Phase 2 compiler, where the for-in loop variable was a fresh copy of the
SymbolId block and the C runtime hashed that block by address, so the lookup
returned nil and `func.body` faulted. The interpreter compares struct keys by
value and never sees it. What this spec does catch is a rewrite of the walk
that drops, repeats or reorders functions.

Bug: doc/08_tracking/bug/phase2_struct_dict_key_copy_identity_hash_2026-11-18.md
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.semantics.join_point_model.{forward_join_points_for_module_v1}
use compiler.common.config.{Logger}

# One function that does real work and three forwarders to it.
val JP_SRC = "fn jp_impl(n: i64) -> i64:\n    n + 1\n\nfn jp_view_a(n: i64) -> i64:\n    jp_impl(n)\n\nfn jp_view_b(n: i64) -> i64:\n    jp_impl(n)\n\nfn jp_view_c(n: i64) -> i64:\n    jp_impl(n)\n"

fn jp_lower(src: text) -> HirModule:
    val module = parse_full_frontend(src, "jp_visit.spl", "jp_visit", Logger(level: 0))
    var lowering = HirLowering.with_filename("jp_visit.spl")
    lowering.lower_module(module)

describe "forward_join_points_for_module_v1 over a multi-function module":
    it "sees all four declared functions in the module":
        val hir = jp_lower(JP_SRC)
        expect(hir.functions.keys().len()).to_equal(4)

    it "reports every forwarder once and skips the function that does work":
        val points = forward_join_points_for_module_v1(jp_lower(JP_SRC), 1)
        expect(points.len()).to_equal(3)
        var sources: [text] = []
        for point in points:
            sources.push(point.source_symbol)
            expect(point.target_symbol).to_equal("jp_impl")
        expect(sources.contains("jp_view_a")).to_equal(true)
        expect(sources.contains("jp_view_b")).to_equal(true)
        expect(sources.contains("jp_view_c")).to_equal(true)
        expect(sources.contains("jp_impl")).to_equal(false)

    it "numbers the join points consecutively from first_id":
        val points = forward_join_points_for_module_v1(jp_lower(JP_SRC), 7)
        expect(points.len()).to_equal(3)
        expect(points[0].logical_join_point_id).to_equal(7)
        expect(points[1].logical_join_point_id).to_equal(8)
        expect(points[2].logical_join_point_id).to_equal(9)
