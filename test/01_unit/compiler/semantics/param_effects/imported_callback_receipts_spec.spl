# @req AC-BOR-04
use std.spec
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.semantics.param_effects.infer.{infer_param_effects}
use compiler.semantics.param_effects.imported_callback_receipts.*
use test.helpers.module_surface_owner_fixture.{module_surfaces_from_test_modules}

val CALLBACK_PROVIDER = "pub fn invoke(callback: fn(i64) -> i64) -> i64:\n    callback(1)\n"

fn callback_import_receipts(alias: text, admitted: bool, changed: bool) -> [ImportedCallbackReceiptV1]:
    var parsed = parse_and_build_module(CALLBACK_PROVIDER, "provider.spl")
    parsed.nogc_strict = true
    val source = SourceFile(path: "provider.spl", content: CALLBACK_PROVIDER, module_name: "provider")
    val registry = module_surfaces_from_test_modules({"provider": parsed}, [source]).unwrap()
    var owner_lowering = HirLowering.with_filename("provider.spl")
    owner_lowering.module_surfaces = registry
    var owner = owner_lowering.lower_module(parsed)
    expect(owner_lowering.errors.len()).to_equal(0)
    val report = infer_param_effects(owner, {}, {})
    expect(report.diags.len()).to_equal(0)
    owner.nogc_param_effects_checked = admitted
    if changed:
        owner.path = "different-provider.spl"
    val consumer_source = "use provider.{invoke as " + alias + "}\n\nfn caller() -> i64:\n    " + alias + "(\\x: x)\n"
    var consumer_parsed = parse_and_build_module(consumer_source, "consumer.spl")
    consumer_parsed.nogc_strict = true
    var consumer_lowering = HirLowering.with_filename("consumer.spl")
    consumer_lowering.module_surfaces = registry
    val consumer = consumer_lowering.lower_module(consumer_parsed)
    expect(consumer_lowering.errors.len()).to_equal(0)
    verified_imported_callback_receipts(consumer, [owner], registry.surfaces)

describe "imported callback receipts require live canonical owners":
    it "retains the terminal provider identity through a local import alias":
        val receipts = callback_import_receipts("renamed", true, false)
        expect(receipts.len()).to_equal(1)
        expect(receipts[0].provider_name).to_equal("provider")
        expect(receipts[0].callback_slots).to_equal([0])

    it "rejects providers without checked ownership admission":
        expect(callback_import_receipts("renamed", false, false).len()).to_equal(0)

    it "rejects a provider from a different physical source":
        expect(callback_import_receipts("renamed", true, true).len()).to_equal(0)

    it "rejects every altered canonical wire field or stale version":
        val live = ImportedCallbackReceiptV1("/provider.spl", "provider", 7, 19, "source", "signature", "body", [0])
        val encoded = imported_callback_receipt_encode_v1(live)
        expect(imported_callback_receipt_matches_v1(encoded, live)).to_equal(true)
        expect(imported_callback_receipt_matches_v1(encoded + "\n", live)).to_equal(false)
        expect(imported_callback_receipt_matches_v1(encoded.replace("/v1", "/v0"), live)).to_equal(false)
        expect(imported_callback_receipt_matches_v1(encoded.replace("body", "changed"), live)).to_equal(false)
        val changed = ImportedCallbackReceiptV1("/provider.spl", "provider", 7, 19, "source", "signature", "changed", [0])
        expect(imported_callback_receipt_matches_v1(encoded, changed)).to_equal(false)
