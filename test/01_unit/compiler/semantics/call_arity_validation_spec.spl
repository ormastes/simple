# Focused regression for call_site_arity_never_checked_2026-08-04.
# @req REQ-SSPEC-COMPILER

use std.spec.*
use std.spec.step

use compiler.common.attributes.{FunctionAttr}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirBlock, HirCallArg, HirExpr, HirExprKind, HirFunction, HirParam}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.semantics.resolve.{MethodResolver}

fn arity_expr(value: i64) -> HirExpr:
    HirExpr(
        kind: HirExprKind.IntLit(value, nil),
        has_type_: true,
        type_: HirType(kind: HirTypeKind.Int(64, true), span: Span.empty()),
        span: Span.empty()
    )

fn arity_arg(value: i64) -> HirCallArg:
    HirCallArg(has_name: false, name: "", value: arity_expr(value), span: Span.empty())

fn arity_param(id: i64, name: text, has_default: bool, default_value: i64) -> HirParam:
    HirParam(
        symbol: SymbolId(id: id), name: name,
        type_: HirType(kind: HirTypeKind.Int(64, true), span: Span.empty()),
        has_default: has_default, default: arity_expr(default_value), span: Span.empty(),
        is_mutable: false
    )

fn arity_function(id: i64) -> HirFunction:
    val span = Span.empty()
    HirFunction(
        symbol: SymbolId(id: id), name: "bounded", type_params: [],
        params: [arity_param(11, "required", false, 0), arity_param(12, "optional", true, 7)],
        return_type: HirType(kind: HirTypeKind.Int(64, true), span: span),
        body: HirBlock(stmts: [], has: true, value: arity_expr(0), span: span),
        effects: [], visibility: Visibility.Public,
        is_async: false, is_static: false, is_public: true, is_method: false,
        is_mutable: false, is_const: false, is_extern: false,
        func_attr: FunctionAttr.default(), has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false, vhdl_metadata: nil,
        has_doc_comment: false, doc_comment: "", span: span
    )

fn arity_resolver() -> MethodResolver:
    var resolver = MethodResolver.new(SymbolTable.new())
    resolver.module_functions[SymbolId(id: 10)] = arity_function(10)
    resolver

fn arity_callee() -> HirExpr:
    HirExpr(
        kind: HirExprKind.Var(SymbolId(id: 10)), has_type_: false,
        type_: HirType(kind: HirTypeKind.Infer(0, 0), span: Span.empty()),
        span: Span.empty()
    )

describe "direct call arity validation":
    it "rejects a call below its required arity before backend lowering":
        step("Resolve a zero-argument call whose first parameter is required")
        var resolver = arity_resolver()
        val args = resolver.fill_call_defaults(arity_callee(), [], Span.empty())
        expect(args.len()).to_equal(0)
        expect(resolver.errors.len()).to_equal(1)
        expect(resolver.errors[0].message).to_contain("requires at least 1 argument(s)")

    it "rejects a call above its closed maximum arity before backend lowering":
        step("Resolve a three-argument call against a closed two-parameter signature")
        var resolver = arity_resolver()
        val args = resolver.fill_call_defaults(
            arity_callee(), [arity_arg(1), arity_arg(2), arity_arg(3)], Span.empty())
        expect(args.len()).to_equal(3)
        expect(resolver.errors.len()).to_equal(1)
        expect(resolver.errors[0].message).to_contain("accepts at most 2 argument(s)")

    it "fills a trailing default inside the valid arity interval":
        step("Resolve a one-argument call whose second parameter has a default")
        var resolver = arity_resolver()
        val args = resolver.fill_call_defaults(arity_callee(), [arity_arg(1)], Span.empty())
        expect(resolver.errors.len()).to_equal(0)
        expect(args.len()).to_equal(2)
        match args[1].value.kind:
            case HirExprKind.IntLit(value, _): expect(value).to_equal(7)
            case _: expect(false).to_be(true)

    it "does not impose a closed maximum without a local signature":
        step("Leave a computed or foreign/variadic boundary open")
        var resolver = MethodResolver.new(SymbolTable.new())
        val args = resolver.fill_call_defaults(
            arity_callee(), [arity_arg(1), arity_arg(2), arity_arg(3)], Span.empty())
        expect(args.len()).to_equal(3)
        expect(resolver.errors.len()).to_equal(0)
