# @cover src/compiler/55.borrow/gc_analysis/roots.spl
# @cover src/compiler/55.borrow/gc_analysis/barriers.spl
"""
## Purpose and audience
Executable specification for the GC root-set and write-barrier
analyses in src/compiler/55.borrow/gc_analysis/ (roots.spl,
barriers.spl). Audience: compiler maintainers working on GC safety —
root keying, liveness ranges, safepoint verification, and per-strategy
barrier requirements — plus anyone porting the analysis to a new GC
strategy.

## Operator workflow
Run the spec from the repo root with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/01_unit/compiler/semantics/gc_roots_barriers_spec.spl
Read the trailing SPEC FILE VERDICT line. Each scenario stamps the
analysis counters it observed (requirement and error counts, root
lists, barrier kinds), so a wrong count names the broken analysis
pass directly.

## Compatibility and limitations
Both analysed files were left non-executable by the 2025
scripts/tools/desugarer.py port: the impl blocks for RootKind, GcRoot,
BarrierKind, RootError and BarrierError were emitted as bare
"(was: impl X:)" headers with no bodies, and roots.spl carried a
broken tuple-type desugar, a `has_GcRoot` return type that is not a
type, and a RootError split no constructor ever set. See
doc/08_tracking/bug/gc_analysis_desugar_dropped_method_bodies_2026-08-02.md.
BarrierAnalysis.analyze() previously failed semantic analysis with
"unknown symbol self.is_gc_type" — the parenthesized-field-call form
`(self.field)(args)` does not resolve; `self.field(args)` does (fix
recorded in the same bug doc, 2026-08-06 update). RootAnalysis never
calls its `is_gc_type` field, so it was unaffected. The predicates
used here are test-local stand-ins for the real per-type GC predicate.

## Verification guidance and troubleshooting
A scenario failing at `analyze()` usually means a strategy's
barrier-requirement rule flipped: compare the stamped needs_barrier
kind against the strategy matrix (StopTheWorld never, Incremental
post-write on GC source, Generational only both-sides, Concurrent
pre-write on GC source). A verify_barriers failure with the right
emitted map means the requirement keyed a different program point.
"""

# Lifecycle: doc/01_research/runtime/memory_tooling/memory_inspection_tooling.md ;
# doc/03_plan/runtime/gc_nogc_runtime_completion_audit_2026-05-13.md ;
# doc/04_architecture/lib/runtime_family_tier_defaults.md ;
# doc/05_design/runtime/gc_pure_simple_implementation.md

use std.spec
use compiler.borrow.gc_analysis.roots.{
    RootKind,
    GcRoot,
    RootSet,
    RootAnalysis,
    GcPoint,
    GcPointKind,
    gcroot_local,
    gcroot_parameter,
    gcpoint_call,
    gcpoint_allocation,
    rooterror_unrooted,
    rooterror_dangling
}
use compiler.borrow.gc_analysis.barriers.{
    BarrierKind,
    GcStrategy,
    BarrierAnalysis,
    writesite_field_write,
    writesite_array_write,
    barriererror_missing
}

fn is_gc_type_1(t: i64) -> bool:
    """Test predicate: only type id 1 is GC-managed."""
    t == 1

fn is_gc_type_all(t: i64) -> bool:
    """Test predicate: every type id is GC-managed."""
    true

# @manual_section: root-keying

describe "RootKind":
    it "keys every variant distinctly, including the payload":
        # @req REQ-GC-ROOTS-001
        step("Render one key per RootKind variant")
        # @capture(bit_table): the rendered key for each RootKind variant
        expect(RootKind.Local(1).to_text()).to_equal("local:1")
        expect(RootKind.Local(2).to_text()).to_equal("local:2")
        expect(RootKind.Parameter(0).to_text()).to_equal("param:0")
        expect(RootKind.Global("g").to_text()).to_equal("global:g")
        expect(RootKind.Temporary(9).to_text()).to_equal("temp:9")
        expect(RootKind.Return.to_text()).to_equal("return")

    it "never collides two distinct locals onto one key":
        # @req REQ-GC-ROOTS-002
        step("Compare Local keys against Local with a different payload and other kinds with the same payload")
        # @capture(bit_table): key-equality results across payloads and kinds
        expect(RootKind.Local(1).to_text() == RootKind.Local(2).to_text()).to_equal(false)
        expect(RootKind.Local(1).to_text() == RootKind.Parameter(1).to_text()).to_equal(false)
        expect(RootKind.Local(1).to_text() == RootKind.Temporary(1).to_text()).to_equal(false)

# @manual_section: root-builders

describe "GcRoot":
    it "builds a local root that is not interior or pinned":
        # @req REQ-GC-ROOTS-003
        step("Build a local root for slot 3 of type 99")
        val r = gcroot_local(3, 99)
        # @capture(statistics): the built root's type, flags and rendered kind
        expect(r.type_id).to_equal(99)  # oracle: gcroot_local(3, 99) carries the type id it was built with
        expect(r.is_interior).to_equal(false)
        expect(r.is_pinned).to_equal(false)
        expect(r.kind.to_text()).to_equal("local:3")

    it "gives a local root an empty live range by default":
        # @req REQ-GC-ROOTS-004
        step("Build a local root and probe its default live range")
        val r = gcroot_local(3, 99)
        # @capture(statistics): the default live-range bounds and liveness probes
        expect(r.live_range[0]).to_equal(0)  # oracle: a fresh local root's live range defaults to (0, 0)
        expect(r.live_range[1]).to_equal(0)  # oracle: a fresh local root's live range defaults to (0, 0)
        expect(r.is_live_at(0)).to_equal(true)
        expect(r.is_live_at(5)).to_equal(false)

    it "keeps a parameter root live for the whole function":
        # @req REQ-GC-ROOTS-005
        step("Build a parameter root and probe liveness at entry and far past the body")
        val p = gcroot_parameter(0, 7)
        # @capture(statistics): the parameter root's kind and liveness probes
        expect(p.kind.to_text()).to_equal("param:0")
        expect(p.is_live_at(0)).to_equal(true)
        expect(p.is_live_at(500)).to_equal(true)

    it "treats the live range as inclusive at both ends":
        # @req REQ-GC-ROOTS-006
        step("Probe a parameter root's liveness exactly at both range ends")
        val p = gcroot_parameter(1, 7)
        # @capture(statistics): liveness at both inclusive range ends
        expect(p.is_live_at(p.live_range[0])).to_equal(true)
        expect(p.is_live_at(p.live_range[1])).to_equal(true)

    it "describes itself for diagnostics":
        # @req REQ-GC-ROOTS-007
        step("Render a local root's diagnostic text")
        # @capture(bit_table): the rendered diagnostic text
        expect(gcroot_local(3, 99).to_text()).to_equal("local:3:type99")

# @manual_section: root-set

describe "RootSet":
    it "starts empty":
        # @req REQ-GC-ROOTS-008
        step("Create a fresh root set and read its counters")
        val s = RootSet.create()
        # @capture(statistics): count and root-list length for a fresh set
        expect(s.count()).to_equal(0)  # oracle: a fresh RootSet has recorded no roots
        expect(s.all_roots().len()).to_equal(0)  # oracle: a fresh RootSet has recorded no roots

    it "adds roots and counts them":
        # @req REQ-GC-ROOTS-009
        step("Add two distinct local roots and read the counters")
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_local(2, 10))
        # @capture(statistics): count and root-list length after two adds
        expect(s.count()).to_equal(2)  # oracle: two add_root calls store exactly two roots
        expect(s.all_roots().len()).to_equal(2)  # oracle: two add_root calls store exactly two roots

    it "replaces rather than duplicates a root of the same kind":
        # @req REQ-GC-ROOTS-010
        step("Add the same local slot twice with different type ids")
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_local(1, 20))
        # @capture(statistics): count after the duplicate-kind add
        expect(s.count()).to_equal(1)  # oracle: the same-kind add replaces, leaving one root

    it "finds a root by kind and reports nil for a missing one":
        # @req REQ-GC-ROOTS-011
        step("Look up a stored root, an unstored slot, and an unstored kind")
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        # @capture(statistics): look-up results for stored and missing kinds
        expect(s.get_root(RootKind.Local(1)) != nil).to_equal(true)
        expect(s.get_root(RootKind.Local(77)) != nil).to_equal(false)
        expect(s.get_root(RootKind.Return) != nil).to_equal(false)

    it "removes a root by kind":
        # @req REQ-GC-ROOTS-012
        step("Add two locals, remove one by kind, and re-look-up both")
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_local(2, 10))
        s.remove_root(RootKind.Local(1))
        # @capture(statistics): count and look-up results after the removal
        expect(s.count()).to_equal(1)  # oracle: removing one of two roots leaves one
        expect(s.get_root(RootKind.Local(1)) != nil).to_equal(false)
        expect(s.get_root(RootKind.Local(2)) != nil).to_equal(true)

    it "filters roots by liveness at a program point":
        # @req REQ-GC-ROOTS-013
        step("Add one short-lived local and one whole-function parameter, then filter at two points")
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_parameter(0, 10))
        # @capture(statistics): live-root counts at points 0 and 50
        expect(s.live_roots_at(0).len()).to_equal(2)  # oracle: the local (range (0, 0)) and the parameter are both live at 0
        expect(s.live_roots_at(50).len()).to_equal(1)  # oracle: the local's range (0, 0) excludes 50, the parameter's does not

# @manual_section: root-diagnostics

describe "RootError":
    it "reports an unrooted pointer with no specific root attached":
        # @req REQ-GC-ROOTS-014
        step("Build an unrooted-pointer error for GC point 12")
        val e = rooterror_unrooted(12, "value in r3")
        # @capture(statistics): the error's point, root slot and message
        expect(e.point).to_equal(12)  # oracle: rooterror_unrooted stamps the point it was built for
        expect(e.root == nil).to_equal(true)
        expect(e.message).to_equal("Unrooted pointer at GC point: value in r3")

    it "reports a dangling root and names it":
        # @req REQ-GC-ROOTS-015
        step("Build a dangling-root error carrying a local root")
        val r = gcroot_local(3, 99)
        val e = rooterror_dangling(5, r)
        # @capture(statistics): the error's point, root slot and message
        expect(e.point).to_equal(5)  # oracle: rooterror_dangling stamps the point it was built for
        expect(e.root != nil).to_equal(true)
        expect(e.message).to_equal("Dangling root: local:3:type99")

# @manual_section: barrier-kind

describe "BarrierKind":
    it "names every barrier kind":
        # @req REQ-GC-BARRIERS-001
        step("Render one diagnostic name per BarrierKind variant")
        # @capture(bit_table): the rendered name for each BarrierKind variant
        expect(BarrierKind.PreWrite.to_text()).to_equal("pre-write")
        expect(BarrierKind.PostWrite.to_text()).to_equal("post-write")
        expect(BarrierKind.CardMark.to_text()).to_equal("card-mark")
        expect(BarrierKind.Generational.to_text()).to_equal("generational")
        expect(BarrierKind.None_.to_text()).to_equal("none")

    it "treats only None_ as requiring no barrier":
        # @req REQ-GC-BARRIERS-002
        step("Probe is_required for each BarrierKind variant")
        # @capture(bit_table): is_required for each BarrierKind variant
        expect(BarrierKind.PreWrite.is_required()).to_equal(true)
        expect(BarrierKind.PostWrite.is_required()).to_equal(true)
        expect(BarrierKind.CardMark.is_required()).to_equal(true)
        expect(BarrierKind.Generational.is_required()).to_equal(true)
        expect(BarrierKind.None_.is_required()).to_equal(false)

# @manual_section: write-sites

describe "WriteSite":
    it "records a field write with its field index":
        # @req REQ-GC-BARRIERS-003
        step("Build a field-write site for program point 5")
        val w = writesite_field_write(5, 1, 2, 3)
        # @capture(statistics): the built site's point and type ids
        expect(w.program_point).to_equal(5)  # oracle: writesite_field_write stamps its first argument as the program point
        expect(w.target_type).to_equal(1)  # oracle: writesite_field_write stamps its second argument as the target type
        expect(w.source_type).to_equal(3)  # oracle: writesite_field_write stamps its fourth argument as the source type

    it "records an array write":
        # @req REQ-GC-BARRIERS-004
        step("Build an array-write site for program point 6")
        val w = writesite_array_write(6, 1, 3)
        # @capture(statistics): the built site's point and type ids
        expect(w.program_point).to_equal(6)  # oracle: writesite_array_write stamps its first argument as the program point
        expect(w.target_type).to_equal(1)  # oracle: writesite_array_write stamps its second argument as the target type
        expect(w.source_type).to_equal(3)  # oracle: writesite_array_write stamps its third argument as the source type

# @manual_section: barrier-errors

describe "BarrierError":
    it "names the missing barrier kind in its message":
        # @req REQ-GC-BARRIERS-005
        step("Build a missing-barrier error for a field write needing PostWrite")
        val w = writesite_field_write(5, 1, 2, 3)
        val e = barriererror_missing(w, BarrierKind.PostWrite)
        # @capture(statistics): the error's message, kind and write-site point
        expect(e.message).to_equal("Missing post-write barrier at write site")
        expect(e.missing_barrier == BarrierKind.PostWrite).to_equal(true)
        expect(e.write_site.program_point).to_equal(5)  # oracle: the error keeps the write site's program point 5

# @manual_section: barrier-analysis

describe "BarrierAnalysis":
    it "starts with no requirements and no errors":
        # @req REQ-GC-BARRIERS-006
        step("Create an Incremental analysis and read the empty requirement and error lists")
        val b = BarrierAnalysis.create(GcStrategy.Incremental, is_gc_type_all)
        # @capture(statistics): requirement and error counts for a fresh analysis
        expect(b.get_requirements().len()).to_equal(0)  # oracle: a fresh analysis has recorded no writes yet
        expect(b.get_errors().len()).to_equal(0)  # oracle: a fresh analysis has verified nothing, so nothing failed

    it "StopTheWorld never requires a barrier even for GC-typed writes":
        # @req REQ-GC-BARRIERS-007
        step("Record a GC-to-GC field write under StopTheWorld and analyze")
        var b = BarrierAnalysis.create(GcStrategy.StopTheWorld, is_gc_type_all)
        b.record_write(writesite_field_write(1, 1, 0, 1))
        # @capture(statistics): analyze result and requirement count after a StopTheWorld write
        expect(b.analyze()).to_equal(true)
        expect(b.get_requirements().len()).to_equal(0)  # oracle: a stop-the-world collector pauses mutators, so no barrier is needed

    it "a write between two non-GC types never requires a barrier":
        # @req REQ-GC-BARRIERS-008
        step("Record a write between two non-GC types under Concurrent and analyze")
        var b = BarrierAnalysis.create(GcStrategy.Concurrent, is_gc_type_1)
        b.record_write(writesite_field_write(1, 9, 0, 9))
        # @capture(statistics): analyze result and requirement count for a non-GC write
        expect(b.analyze()).to_equal(true)
        expect(b.get_requirements().len()).to_equal(0)  # oracle: neither side is GC-managed, so no collector can observe the write

    it "Incremental requires a post-write barrier when the source is GC-managed":
        # @req REQ-GC-BARRIERS-009
        step("Record a write whose source is GC-managed under Incremental and analyze")
        var b = BarrierAnalysis.create(GcStrategy.Incremental, is_gc_type_1)
        b.record_write(writesite_field_write(3, 9, 0, 1))
        # @capture(statistics): analyze result and the required barrier kind at point 3
        expect(b.analyze()).to_equal(true)
        expect(b.needs_barrier(3) == BarrierKind.PostWrite).to_equal(true)

    it "Incremental requires nothing when only the target is GC-managed":
        # @req REQ-GC-BARRIERS-010
        step("Record a write whose only GC side is the target under Incremental and analyze")
        var b = BarrierAnalysis.create(GcStrategy.Incremental, is_gc_type_1)
        b.record_write(writesite_field_write(3, 1, 0, 9))
        # @capture(statistics): analyze result and the required barrier kind (none) at point 3
        expect(b.analyze()).to_equal(true)
        expect(b.needs_barrier(3) == BarrierKind.None_).to_equal(true)

    it "Generational requires a generational barrier only when both sides are GC-managed":
        # @req REQ-GC-BARRIERS-011
        step("Record a GC-to-GC write under Generational and analyze")
        var b = BarrierAnalysis.create(GcStrategy.Generational, is_gc_type_1)
        b.record_write(writesite_field_write(4, 1, 0, 1))
        # @capture(statistics): analyze result and the required generational barrier kind
        expect(b.analyze()).to_equal(true)
        expect(b.needs_barrier(4) == BarrierKind.Generational).to_equal(true)

    it "Concurrent requires a pre-write barrier when the source is GC-managed":
        # @req REQ-GC-BARRIERS-012
        step("Record a write whose source is GC-managed under Concurrent and analyze")
        var b = BarrierAnalysis.create(GcStrategy.Concurrent, is_gc_type_1)
        b.record_write(writesite_field_write(5, 9, 0, 1))
        # @capture(statistics): analyze result and the required pre-write barrier kind
        expect(b.analyze()).to_equal(true)
        expect(b.needs_barrier(5) == BarrierKind.PreWrite).to_equal(true)

    it "needs_barrier reports None_ for a program point with no recorded write":
        # @req REQ-GC-BARRIERS-013
        step("Query needs_barrier at a point that never recorded a write")
        var b = BarrierAnalysis.create(GcStrategy.Concurrent, is_gc_type_1)
        b.record_write(writesite_field_write(5, 9, 0, 1))
        # @capture(statistics): the barrier kind at an unrecorded point
        expect(b.needs_barrier(999) == BarrierKind.None_).to_equal(true)

    it "verify_barriers fails when a required barrier was never emitted":
        # @req REQ-GC-BARRIERS-014
        step("Analyze a GC-source write and verify against an empty emitted map")
        var b = BarrierAnalysis.create(GcStrategy.Incremental, is_gc_type_1)
        b.record_write(writesite_field_write(3, 9, 0, 1))
        b.analyze()
        val emitted: Dict<i64, BarrierKind> = {}
        # @capture(statistics): verify result, error count and the missing kind
        expect(b.verify_barriers(emitted)).to_equal(false)
        expect(b.get_errors().len()).to_equal(1)  # oracle: exactly the one required barrier went missing
        expect(b.get_errors()[0].missing_barrier == BarrierKind.PostWrite).to_equal(true)

    it "verify_barriers fails when the wrong barrier kind was emitted":
        # @req REQ-GC-BARRIERS-015
        step("Verify a GC-source write against an emitted CardMark where PostWrite is required")
        var b = BarrierAnalysis.create(GcStrategy.Incremental, is_gc_type_1)
        b.record_write(writesite_field_write(3, 9, 0, 1))
        b.analyze()
        var emitted: Dict<i64, BarrierKind> = {}
        emitted[3] = BarrierKind.CardMark
        # @capture(statistics): verify result and error count for the kind mismatch
        expect(b.verify_barriers(emitted)).to_equal(false)
        expect(b.get_errors().len()).to_equal(1)  # oracle: the wrong kind is one missing-barrier error

    it "verify_barriers succeeds when the correct barrier was emitted":
        # @req REQ-GC-BARRIERS-016
        step("Verify a GC-source write against the required PostWrite emission")
        var b = BarrierAnalysis.create(GcStrategy.Incremental, is_gc_type_1)
        b.record_write(writesite_field_write(3, 9, 0, 1))
        b.analyze()
        var emitted: Dict<i64, BarrierKind> = {}
        emitted[3] = BarrierKind.PostWrite
        # @capture(statistics): verify result and the empty error list
        expect(b.verify_barriers(emitted)).to_equal(true)
        expect(b.get_errors().len()).to_equal(0)  # oracle: the required barrier was emitted, so nothing failed

# @manual_section: gc-safepoints

describe "GcPoint":
    it "builds a call safepoint with no required roots":
        # @req REQ-GC-ROOTS-016
        step("Build a call safepoint at program point 7")
        val p = gcpoint_call(7)
        # @capture(statistics): the safepoint's program point and required-root count
        expect(p.program_point).to_equal(7)  # oracle: gcpoint_call stamps the point it was built for
        expect(p.required_roots.len()).to_equal(0)  # oracle: a bare call safepoint carries no required roots

    it "builds an allocation safepoint with no required roots":
        # @req REQ-GC-ROOTS-017
        step("Build an allocation safepoint at program point 8")
        val p = gcpoint_allocation(8)
        # @capture(statistics): the safepoint's program point and required-root count
        expect(p.program_point).to_equal(8)  # oracle: gcpoint_allocation stamps the point it was built for
        expect(p.required_roots.len()).to_equal(0)  # oracle: a bare allocation safepoint carries no required roots

# @manual_section: root-analysis

describe "RootAnalysis":
    it "starts with no gc points, no roots, and no errors":
        # @req REQ-GC-ROOTS-018
        step("Create a fresh RootAnalysis and read all three counters")
        val a = RootAnalysis.create(is_gc_type_1)
        # @capture(statistics): gc-point, root and error counts for a fresh analysis
        expect(a.get_gc_points().len()).to_equal(0)  # oracle: a fresh analysis has recorded no safepoints
        expect(a.get_roots_at(0).len()).to_equal(0)  # oracle: a fresh analysis has recorded no roots
        expect(a.get_errors().len()).to_equal(0)  # oracle: a fresh analysis has verified nothing, so nothing failed

    it "records a root at a program point and retrieves it":
        # @req REQ-GC-ROOTS-019
        step("Record a local root at point 10 and read it back")
        var a = RootAnalysis.create(is_gc_type_1)
        a.record_root(10, gcroot_local(1, 99))
        # @capture(statistics): the root list at point 10 and its rendered key
        expect(a.get_roots_at(10).len()).to_equal(1)  # oracle: one record_root call stores exactly one root
        expect(a.get_roots_at(10)[0].kind.to_text()).to_equal("local:1")

    it "records a GC safepoint":
        # @req REQ-GC-ROOTS-020
        step("Record a call safepoint at point 4 and read it back")
        var a = RootAnalysis.create(is_gc_type_1)
        a.record_gc_point(gcpoint_call(4))
        # @capture(statistics): the safepoint list and its program point
        expect(a.get_gc_points().len()).to_equal(1)  # oracle: one record_gc_point call stores exactly one safepoint
        expect(a.get_gc_points()[0].program_point).to_equal(4)  # oracle: the stored safepoint keeps its program point 4

    it "propagates only roots still live at the destination point":
        # @req REQ-GC-ROOTS-021
        step("Record a dead-by-point-5 local and a whole-function parameter at point 0, then propagate to 5")
        var a = RootAnalysis.create(is_gc_type_1)
        a.record_root(0, gcroot_local(1, 99))       # live_range (0, 0)
        a.record_root(0, gcroot_parameter(0, 99))    # live for the whole function
        a.propagate_roots(0, 5)
        val at5 = a.get_roots_at(5)
        # @capture(statistics): the root list at the destination point
        expect(at5.len()).to_equal(1)  # oracle: the local's live range (0, 0) excludes point 5, the parameter's does not
        expect(at5[0].kind.to_text()).to_equal("param:0")

    it "verify_gc_points passes when every required root is present":
        # @req REQ-GC-ROOTS-022
        step("Record the required parameter root, then verify a safepoint demanding it")
        var a = RootAnalysis.create(is_gc_type_1)
        a.record_root(4, gcroot_parameter(0, 99))
        a.record_gc_point(GcPoint(
            kind: GcPointKind.Call,
            program_point: 4,
            required_roots: [RootKind.Parameter(0)]
        ))
        # @capture(statistics): verify result and the empty error list
        expect(a.verify_gc_points()).to_equal(true)
        expect(a.get_errors().len()).to_equal(0)  # oracle: the required root is live at the safepoint, so nothing failed

    it "verify_gc_points fails and records a RootError when a required root is missing":
        # @req REQ-GC-ROOTS-023
        step("Verify a safepoint whose required root was never recorded")
        var a = RootAnalysis.create(is_gc_type_1)
        a.record_gc_point(GcPoint(
            kind: GcPointKind.Call,
            program_point: 4,
            required_roots: [RootKind.Parameter(0)]
        ))
        # @capture(statistics): verify result, error count and the error's point
        expect(a.verify_gc_points()).to_equal(false)
        expect(a.get_errors().len()).to_equal(1)  # oracle: one safepoint with one missing root is one error
        expect(a.get_errors()[0].point).to_equal(4)  # oracle: the error names the safepoint's program point 4
        expect(a.get_errors()[0].root == nil).to_equal(true)
