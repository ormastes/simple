# GC Root and Write-Barrier Analysis Tests
#
# Covers src/compiler/55.borrow/gc_analysis/roots.spl and barriers.spl.
#
# Both files were left non-executable by the 2025 scripts/tools/desugarer.py
# port: the impl blocks for RootKind, GcRoot, BarrierKind, RootError and
# BarrierError were emitted as bare "(was: impl X:)" headers with no bodies,
# and the call sites were rewritten into helpers no pass generates. roots.spl
# additionally carried a broken tuple-type desugar (a `val _tv_0 = [i64, i64]`
# field), a `has_GcRoot` return type that is not a type, and a RootError split
# into has_root + non-optional root that no constructor ever set.
#
# See doc/08_tracking/bug/gc_analysis_desugar_dropped_method_bodies_2026-08-02.md
#
# This file covers the surface that executes. BarrierAnalysis.analyze() is
# deliberately NOT covered: it still fails semantic analysis with
# "unknown symbol self.is_gc_type", which is filed in the bug above and left
# failing loudly rather than stubbed. Do NOT pad this file with `pass`.

use std.spec
use compiler.borrow.gc_analysis.roots.{
    RootKind,
    GcRoot,
    RootSet,
    gcroot_local,
    gcroot_parameter,
    rooterror_unrooted,
    rooterror_dangling
}
use compiler.borrow.gc_analysis.barriers.{
    BarrierKind,
    writesite_field_write,
    writesite_array_write,
    barriererror_missing
}

describe "RootKind":
    it "keys every variant distinctly, including the payload":
        expect(RootKind.Local(1).to_text()).to_equal("local:1")
        expect(RootKind.Local(2).to_text()).to_equal("local:2")
        expect(RootKind.Parameter(0).to_text()).to_equal("param:0")
        expect(RootKind.Global("g").to_text()).to_equal("global:g")
        expect(RootKind.Temporary(9).to_text()).to_equal("temp:9")
        expect(RootKind.Return.to_text()).to_equal("return")

    it "never collides two distinct locals onto one key":
        expect(RootKind.Local(1).to_text() == RootKind.Local(2).to_text()).to_equal(false)
        expect(RootKind.Local(1).to_text() == RootKind.Parameter(1).to_text()).to_equal(false)
        expect(RootKind.Local(1).to_text() == RootKind.Temporary(1).to_text()).to_equal(false)

describe "GcRoot":
    it "builds a local root that is not interior or pinned":
        val r = gcroot_local(3, 99)
        expect(r.type_id).to_equal(99)
        expect(r.is_interior).to_equal(false)
        expect(r.is_pinned).to_equal(false)
        expect(r.kind.to_text()).to_equal("local:3")

    it "gives a local root an empty live range by default":
        val r = gcroot_local(3, 99)
        expect(r.live_range[0]).to_equal(0)
        expect(r.live_range[1]).to_equal(0)
        expect(r.is_live_at(0)).to_equal(true)
        expect(r.is_live_at(5)).to_equal(false)

    it "keeps a parameter root live for the whole function":
        val p = gcroot_parameter(0, 7)
        expect(p.kind.to_text()).to_equal("param:0")
        expect(p.is_live_at(0)).to_equal(true)
        expect(p.is_live_at(500)).to_equal(true)

    it "treats the live range as inclusive at both ends":
        val p = gcroot_parameter(1, 7)
        expect(p.is_live_at(p.live_range[0])).to_equal(true)
        expect(p.is_live_at(p.live_range[1])).to_equal(true)

    it "describes itself for diagnostics":
        expect(gcroot_local(3, 99).to_text()).to_equal("local:3:type99")

describe "RootSet":
    it "starts empty":
        val s = RootSet.create()
        expect(s.count()).to_equal(0)
        expect(s.all_roots().len()).to_equal(0)

    it "adds roots and counts them":
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_local(2, 10))
        expect(s.count()).to_equal(2)
        expect(s.all_roots().len()).to_equal(2)

    it "replaces rather than duplicates a root of the same kind":
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_local(1, 20))
        expect(s.count()).to_equal(1)

    it "finds a root by kind and reports nil for a missing one":
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        expect(s.get_root(RootKind.Local(1)) != nil).to_equal(true)
        expect(s.get_root(RootKind.Local(77)) != nil).to_equal(false)
        expect(s.get_root(RootKind.Return) != nil).to_equal(false)

    it "removes a root by kind":
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_local(2, 10))
        s.remove_root(RootKind.Local(1))
        expect(s.count()).to_equal(1)
        expect(s.get_root(RootKind.Local(1)) != nil).to_equal(false)
        expect(s.get_root(RootKind.Local(2)) != nil).to_equal(true)

    it "filters roots by liveness at a program point":
        var s = RootSet.create()
        s.add_root(gcroot_local(1, 10))
        s.add_root(gcroot_parameter(0, 10))
        expect(s.live_roots_at(0).len()).to_equal(2)
        expect(s.live_roots_at(50).len()).to_equal(1)

describe "RootError":
    it "reports an unrooted pointer with no specific root attached":
        val e = rooterror_unrooted(12, "value in r3")
        expect(e.point).to_equal(12)
        expect(e.root == nil).to_equal(true)
        expect(e.message).to_equal("Unrooted pointer at GC point: value in r3")

    it "reports a dangling root and names it":
        val r = gcroot_local(3, 99)
        val e = rooterror_dangling(5, r)
        expect(e.point).to_equal(5)
        expect(e.root != nil).to_equal(true)
        expect(e.message).to_equal("Dangling root: local:3:type99")

describe "BarrierKind":
    it "names every barrier kind":
        expect(BarrierKind.PreWrite.to_text()).to_equal("pre-write")
        expect(BarrierKind.PostWrite.to_text()).to_equal("post-write")
        expect(BarrierKind.CardMark.to_text()).to_equal("card-mark")
        expect(BarrierKind.Generational.to_text()).to_equal("generational")
        expect(BarrierKind.None_.to_text()).to_equal("none")

    it "treats only None_ as requiring no barrier":
        expect(BarrierKind.PreWrite.is_required()).to_equal(true)
        expect(BarrierKind.PostWrite.is_required()).to_equal(true)
        expect(BarrierKind.CardMark.is_required()).to_equal(true)
        expect(BarrierKind.Generational.is_required()).to_equal(true)
        expect(BarrierKind.None_.is_required()).to_equal(false)

describe "WriteSite":
    it "records a field write with its field index":
        val w = writesite_field_write(5, 1, 2, 3)
        expect(w.program_point).to_equal(5)
        expect(w.target_type).to_equal(1)
        expect(w.source_type).to_equal(3)

    it "records an array write":
        val w = writesite_array_write(6, 1, 3)
        expect(w.program_point).to_equal(6)
        expect(w.target_type).to_equal(1)
        expect(w.source_type).to_equal(3)

describe "BarrierError":
    it "names the missing barrier kind in its message":
        val w = writesite_field_write(5, 1, 2, 3)
        val e = barriererror_missing(w, BarrierKind.PostWrite)
        expect(e.message).to_equal("Missing post-write barrier at write site")
        expect(e.missing_barrier == BarrierKind.PostWrite).to_equal(true)
        expect(e.write_site.program_point).to_equal(5)
