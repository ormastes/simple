# @req REQ-STRUCT-ARRAY-FIELD-OBSERVABLE-VALUE-COPY
# UNRUN regression: native execution required; no eager deep-clone policy implied.
use std.spec.{describe, it, expect, step}

struct ArrayFieldCopyControl:
    label: text
    items: [i64]

describe "struct copies preserve observable array field value semantics", tag: ["only-compiled"]:
    it "isolates indexed array field mutation after an ordinary struct binding copy":
        step("exercise native ordinary nonrecursive struct binding and indexed field write")
        val original = ArrayFieldCopyControl(label: "original", items: [29])
        var copied = original
        copied.label = "copied"
        expect(original.label).to_equal("original")
        expect(copied.label).to_equal("copied")
        expect(original.items.len()).to_equal(1)
        expect(copied.items.len()).to_equal(1)
        if original.items.len() == 1 and copied.items.len() == 1:
            copied.items[0] = 31
            expect(original.items[0]).to_equal(29)
            expect(copied.items[0]).to_equal(31)
