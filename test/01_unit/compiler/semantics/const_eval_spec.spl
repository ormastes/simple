# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: evaluated compile-time constants must render through the typed
formatter, and the env-boolean truth table must be driven by the owned
str_to_lower helper on the raw environment value.
Audience: compiler engineers who maintain constant evaluation.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use compiler.semantics.const_eval.{EvaluatedConstValue}
use std.common.string_core.{str_to_lower}

describe "evaluated constant text formatting":
    # @manual scenario evidence
    it "formats nested values through the typed formatter":
        # @req REQ-SSPEC-COMPILER
        step("Verify: nested evaluated constants render in canonical form")
        val value = EvaluatedConstValue.Tuple([
            EvaluatedConstValue.Int(7),
            EvaluatedConstValue.Array([EvaluatedConstValue.Bool(true), EvaluatedConstValue.String("ok")])
        ])

        expect(value.to_text()).to_equal("(7, [true, \"ok\"])")

    it "formats scalar evaluated constants through the same formatter":
        # @req REQ-SSPEC-COMPILER
        step("Verify: scalar evaluated constants render exactly")
        expect(EvaluatedConstValue.Int(-3).to_text()).to_equal("-3")  # oracle: signed int
        expect(EvaluatedConstValue.Bool(false).to_text()).to_equal("false")  # oracle: bool literal
        expect(EvaluatedConstValue.String("s").to_text()).to_equal("\"s\"")  # oracle: quoted string

    it "lowercases raw environment text for the compile-time env-boolean table":
        # @req REQ-SSPEC-COMPILER
        step("Verify: str_to_lower normalizes env values so TRUE/YES/ON all match")
        # sys_env_bool compares str_to_lower(rt_env_get(name)) against the
        # lowercase truth set {"1","true","yes","on"}; the helper itself is the
        # behavior under test here.
        expect(str_to_lower("TRUE")).to_equal("true")  # oracle: uppercase env value normalizes
        expect(str_to_lower("Yes")).to_equal("yes")  # oracle: mixed case normalizes
        expect(str_to_lower("off")).to_equal("off")  # oracle: already-lowercase is unchanged
