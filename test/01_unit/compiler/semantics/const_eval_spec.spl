use compiler.semantics.const_eval.{ConstValue}
use std.io.{file_read}

describe "ConstValue text formatting":
    it "formats nested values through the typed formatter":
        val value = ConstValue.Tuple([
            ConstValue.Int(7),
            ConstValue.Array([ConstValue.Bool(true), ConstValue.String("ok")])
        ])

        expect(value.to_text()).to_equal("(7, [true, \"ok\"])")

    it "uses the owned string helper for compile-time environment booleans":
        val source = file_read("src/compiler/35.semantics/const_eval.spl")
        expect(source).to_contain("str_to_lower(rt_env_get(env_name))")
        expect(source.contains("rt_env_get(env_name).to_lowercase()")).to_equal(false)

    it "gates desugared block values with their has flag":
        val eval_source = file_read("src/compiler/35.semantics/const_eval.spl")
        val fold_source = file_read("src/compiler/35.semantics/const_fold.spl")

        expect(eval_source).to_contain("if block.has:")
        expect(eval_source).to_contain("self.eval(block.value)?")
        expect(eval_source.contains("match block.value:")).to_equal(false)
        expect(fold_source).to_contain("if block.has:")
        expect(fold_source).to_contain("value: folded_value")
        expect(fold_source.contains("match block.value:")).to_equal(false)
