use std.test.*
use compiler.semantics.rt_criticality.*
use compiler.frontend.rt_criticality_registry.{rt_criticality_parse_args}
use compiler.semantics.rt_criticality_validation.{rt_direct_callee_dispatches, rt_admit_with_manifest, validate_rt_criticality, validate_rt_criticality_diagnostics}
use compiler.semantics.rt_criticality_validation.{rt_annotation_bound_diagnostic}
use compiler.semantics.rt_criticality_validation.{rt_expr_dispatches, rt_expr_allocates, rt_hal_facts_with_reviewed_intrinsic}
use compiler.frontend.rt_criticality_registry.{rt_criticality_reset, rt_criticality_declare, rt_criticality_claim_keys, rt_criticality_is_hal}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirEnumPayload, HirFunction, HirBlock}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}

fn unit_type() -> HirType:
    HirType(kind: HirTypeKind.Unit, span: Span.default())

fn var_callee(id: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.Var(SymbolId(id: id)), has_type_: false,
        type_: unit_type(), span: Span.default())

fn error_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.Error, has_type_: false,
        type_: unit_type(), span: Span.default())

fn fact(name: text, effects: i64, bounded: i64, callees: [text]) -> RtCriticalFact:
    RtCriticalFact(name: name, own_effects: effects, bounded_effects: bounded,
        callees: callees, line: 1)

# This HIR fixture reaches the real registry -> validator route.  The
# `malloc_` name intentionally produces an unbounded allocation fact, making
# duplicate admission observable as duplicate diagnostics rather than a
# tautological empty success.
fn rt_validation_fn(id: i64, name: text, attr: FunctionAttr) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: id), name: name, type_params: [], params: [],
        return_type: unit_type(),
        body: HirBlock(stmts: [], has: true,
            value: HirExpr(kind: HirExprKind.UnitLit, has_type_: true,
                type_: unit_type(), span: Span.default()), span: Span.default()),
        effects: [], visibility: Visibility.Public,
        is_async: false, is_static: false, is_public: true, is_method: false,
        is_mutable: false, is_const: false, is_extern: false, func_attr: attr,
        has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false, vhdl_metadata: nil,
        has_doc_comment: false, doc_comment: "", span: Span.default())

fn rt_validation_module(path: text, fn_: HirFunction) -> HirModule:
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[fn_.symbol] = fn_
    HirModule(name: "rt_validation_fixture", path: path, imports: [], exports: [],
        domain_blocks: [], symbols: SymbolTable.new(), functions: functions,
        classes: {}, structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [],
        constants: {}, static_asserts: [], aop_advices: [], di_bindings: [],
        arch_rules: [], mock_decls: [], types: [])

describe "RT declaration criticality staging":
    it "defaults an implicit RT declaration to critical with one stable warning phase":
        val warning = rt_critical_profile_diagnostics("tick", "", "", false)
        val error = rt_critical_profile_diagnostics("tick", "", "", true)
        expect(rt_critical_profile("")).to_equal(true)
        expect(warning.len()).to_equal(1)
        expect(warning[0]).to_contain("W-RT-PROFILE-001")
        expect(error[0]).to_contain("E-RT-PROFILE-001")

    it "requires a reason for an explicitly lower tier":
        expect(rt_critical_profile_diagnostics("tick", "robust", "", false).len()).to_equal(1)
        expect(rt_critical_profile_diagnostics("tick", "robust", "bounded lab shim", false).len()).to_equal(0)

    it "admits verified as stricter than critical without a lower-tier reason":
        expect(rt_profile_assurance_rank("verified") > rt_profile_assurance_rank("critical")).to_equal(true)
        expect(rt_critical_profile("verified")).to_equal(true)
        expect(rt_critical_profile_diagnostics("tick", "verified", "", false).len()).to_equal(0)

    it "rejects unknown and misspelled profiles even when a reason is present":
        val diagnostics = rt_critical_profile_diagnostics("tick", "criticall", "typo", false)
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNKNOWN-PROFILE")

    it "derives production staging from the explicit compiler migration epoch":
        expect(rt_implicit_profile_is_error()).to_equal(RT_PROFILE_MIGRATION_EPOCH >= 2)

    it "retains an annotation-bound payload so semantics can reject it":
        val parsed = rt_criticality_parse_args("robust,reason:\"lab-only\",bounds:blocking|synchronization")
        expect(parsed[0]).to_equal("robust")
        expect(parsed[1]).to_equal("lab-only")
        expect(parsed[2]).to_equal("blocking|synchronization")
        expect(rt_annotation_bound_diagnostic("tick", parsed[2]))
            .to_contain("RT-E-BOUND-CAPABILITY-UNVERIFIED")

    it "treats the HAL provider tag as an explicit critical RT declaration":
        val parsed = rt_criticality_parse_args("hal")
        expect(parsed[0]).to_equal("critical")

    it "treats verified and unqualified roots as fatal assurance independently of the global profile":
        expect(rt_profile_assurance_rank("")).to_equal(3)
        expect(rt_profile_assurance_rank("critical")).to_equal(3)
        expect(rt_profile_assurance_rank("verified")).to_equal(4)
        expect(rt_critical_profile("verified")).to_equal(true)

describe "mission-critical transitive admission":
    it "promotes a lower root to a reachable critical dependency with scalar closure state":
        val facts = [fact("lower_root", 0, 0, ["critical_helper"]),
            fact("critical_helper", RT_EFFECT_ALLOC, 0, [])]
        var ranks: Dict<text, i64> = {}
        ranks["lower_root"] = rt_profile_assurance_rank("robust")
        ranks["critical_helper"] = rt_profile_assurance_rank("")
        val effective = rt_effective_assurance_closure(facts, ranks)
        expect(effective[0]).to_equal(3)
        expect(rt_critical_admit("lower_root", facts)[0])
            .to_contain("RT-E-UNBOUNDED-ALLOCATION")

    it "keeps an explicitly lower allocation in the configured warning migration phase":
        val path = "synthetic/rt_lower_alloc.spl"
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_tick", "robust,reason:\"lab shim\"")
        var modules: Dict<text, HirModule> = {}
        modules[path] = rt_validation_module(path,
            rt_validation_fn(810, "malloc_tick", FunctionAttr.default()))
        val diagnostics = validate_rt_criticality_diagnostics(modules)
        rt_criticality_reset()
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0].severity).to_equal(RtCriticalDiagnosticSeverity.Warning)
        expect(diagnostics[0].message).to_contain("RT-W-STEADY-ALLOCATION-001")

    it "rejects a transitive unbounded allocation":
        val facts = [fact("irq", 0, 0, ["helper"]),
            fact("helper", RT_EFFECT_ALLOC, 0, [])]
        val diagnostics = rt_critical_admit("irq", facts)
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-ALLOCATION")

    it "rejects recursion without iterating forever":
        val facts = [fact("a", 0, 0, ["b"]), fact("b", 0, 0, ["a"])]
        val diagnostics = rt_critical_admit("a", facts)
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-RECURSION")

    it "retains effects across a recursive SCC":
        val facts = [fact("a", 0, 0, ["b"]),
            fact("b", RT_EFFECT_ALLOC, 0, ["a"])]
        val diagnostics = rt_critical_admit("a", facts)
        expect(diagnostics.len()).to_equal(2)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-ALLOCATION")
        expect(diagnostics[1]).to_contain("RT-E-UNBOUNDED-RECURSION")

    it "fails closed for an unresolved callee":
        val diagnostics = rt_critical_admit("irq", [fact("irq", 0, 0, ["opaque_target"])])
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-UNKNOWN")

    it "distinguishes a resolved direct Var call from an unresolved function value":
        var names: Dict<i64, text> = {}
        names[41] = "known_helper"
        expect(rt_direct_callee_dispatches(var_callee(41), names)).to_equal(false)
        expect(rt_direct_callee_dispatches(var_callee(42), names)).to_equal(true)

    it "fails closed for error and recursively nested enum payload HIR":
        var names: Dict<i64, text> = {}
        val nested = HirExpr(kind: HirExprKind.EnumLit(unit_type(), "Bad",
            Some(HirEnumPayload.Tuple([error_expr()]))), has_type_: false,
            type_: unit_type(), span: Span.default())
        expect(rt_expr_dispatches(error_expr(), names)).to_equal(true)
        expect(rt_expr_dispatches(nested, names)).to_equal(true)
        expect(rt_expr_allocates(error_expr())).to_equal(true)

    it "admits only a numeric reviewed bound tied to subject and closure digest":
        val capabilities = [RtBoundCapability(subject_id: "irq", closure_digest: "sha256:abc",
            effect: RT_EFFECT_BLOCKING, max_units: 10, review_id: "SAFETY-42")]
        var observed: Dict<i64, i64> = {}
        observed[RT_EFFECT_BLOCKING] = 4
        val mask = rt_reviewed_bound_mask("irq", "sha256:abc", observed, capabilities)
        val facts = [fact("irq", RT_EFFECT_BLOCKING | RT_EFFECT_LOGGING, mask, [])]
        val diagnostics = rt_critical_admit("irq", facts)
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-LOGGING")

    it "rejects a reviewed capability whose numeric maximum is too small":
        val capabilities = [RtBoundCapability(subject_id: "irq", closure_digest: "sha256:abc",
            effect: RT_EFFECT_BLOCKING, max_units: 3, review_id: "SAFETY-42")]
        var observed: Dict<i64, i64> = {}
        observed[RT_EFFECT_BLOCKING] = 4
        expect(rt_reviewed_bound_mask("irq", "sha256:abc", observed, capabilities)).to_equal(0)

    it "does not use a root capability to waive the same effect in a callee":
        val facts = [fact("irq", RT_EFFECT_BLOCKING, RT_EFFECT_BLOCKING, ["helper"]),
            fact("helper", RT_EFFECT_BLOCKING, 0, [])]
        val diagnostics = rt_critical_admit("irq", facts)
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-BLOCKING")

    it "admits a production manifest capability with the exact compiler closure digest":
        val facts = [fact("irq", RT_EFFECT_BLOCKING, 0, [])]
        val digest = rt_closure_digest("irq", facts)
        rt_bound_manifest_replace([RtBoundCapability(subject_id: "irq",
            closure_digest: digest, effect: RT_EFFECT_BLOCKING,
            max_units: 1, review_id: "SAFETY-42")])
        expect(rt_admit_with_manifest("irq", facts).len()).to_equal(0)
        rt_bound_manifest_clear()

    it "preserves exact reviewed allocation authority through the shared validator scratch":
        val path = "synthetic/rt_reviewed_alloc.spl"
        val root_id = rt_stable_fn_id(path, 813)
        val facts = [RtCriticalFact(name: root_id,
            own_effects: RT_EFFECT_ALLOC, bounded_effects: 0,
            callees: [], line: 0,
            effect_units: rt_observed_effect_units(RT_EFFECT_ALLOC))]
        val digest = rt_closure_digest(root_id, facts)
        rt_bound_manifest_replace([RtBoundCapability(subject_id: root_id,
            closure_digest: digest, effect: RT_EFFECT_ALLOC,
            max_units: 1, review_id: "SAFETY-ALLOC-813")])
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_tick", "critical")
        var modules: Dict<text, HirModule> = {}
        modules[path] = rt_validation_module(path,
            rt_validation_fn(813, "malloc_tick", FunctionAttr.default()))
        val diagnostics = validate_rt_criticality_diagnostics(modules)
        rt_criticality_reset()
        expect(diagnostics.len()).to_equal(0)

    it "rejects stale production manifest closure identity":
        val facts = [fact("irq", RT_EFFECT_BLOCKING, 0, [])]
        rt_bound_manifest_replace([RtBoundCapability(subject_id: "irq",
            closure_digest: "stale", effect: RT_EFFECT_BLOCKING,
            max_units: 1, review_id: "SAFETY-42")])
        expect(rt_admit_with_manifest("irq", facts).len()).to_equal(1)
        rt_bound_manifest_clear()

    it "sorts diagnostics and manifest canonical material deterministically":
        expect(rt_sort_text(["z", "a", "m"])).to_equal(["a", "m", "z"])

    it "admits only the compiler-owned bounded RT-HAL intrinsic":
        val facts = [fact("irq", 0, 0, [])]
        val with_intrinsic = rt_hal_facts_with_reviewed_intrinsic("irq", facts)
        expect(with_intrinsic.len()).to_equal(2)
        expect(rt_admit_with_manifest("irq", with_intrinsic).len()).to_equal(0)

    it "keeps a non-HAL critical registry claim out of HAL admission and prevents direct-HAL double admission":
        val path = "synthetic/rt_non_hal_claim.spl"
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_tick", "critical")
        val key = rt_criticality_claim_keys()[0]
        expect(rt_criticality_is_hal(key)).to_equal(false)
        var attr = FunctionAttr.default()
        attr.is_rt_hal = true
        var modules: Dict<text, HirModule> = {}
        modules[path] = rt_validation_module(path, rt_validation_fn(811, "malloc_tick", attr))
        val diagnostics = validate_rt_criticality(modules)
        rt_criticality_reset()
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-ALLOCATION")

    it "admits a HAL registry claim once with its reviewed intrinsic":
        val path = "synthetic/rt_hal_claim.spl"
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_tick", "hal")
        val key = rt_criticality_claim_keys()[0]
        expect(rt_criticality_is_hal(key)).to_equal(true)
        var attr = FunctionAttr.default()
        attr.is_rt_hal = true
        var modules: Dict<text, HirModule> = {}
        modules[path] = rt_validation_module(path, rt_validation_fn(812, "malloc_tick", attr))
        val diagnostics = validate_rt_criticality(modules)
        rt_criticality_reset()
        expect(diagnostics.len()).to_equal(1)
        expect(diagnostics[0]).to_contain("RT-E-UNBOUNDED-ALLOCATION")
