# @req: REQ-COMPILER-SEMANTICS-ANYESCAPE-001

# @cover src/compiler/35.semantics/any_escape/checker.spl 60%
# @cover src/compiler/10.frontend/core/parser_stmts.spl 10%
# @req REQ-MC-ANY-001
"""
# `unsafe(capabilities: [...]):` block form reaches the Any-escape checker

**Category:** Language
**Status:** In Progress
**Research:** doc/01_research/compiler/hardening/simple_hardening_plan_2026-08-21.md §8.1

## Purpose and Audience

Reproduce specs for two bug records that were one gap seen from two sides:

- doc/08_tracking/bug/unsafe_capability_block_syntax_not_parsed_2026-08-21.md —
  `unsafe(reason: ..., capabilities: [...]):` did not parse as an unsafe block.
- doc/08_tracking/bug/unsafe_capabilities_not_carried_into_hir_2026-08-21.md —
  the capability names never reached HIR, so `any_escape` had to take the grant
  as a profile input.

Every scenario passes an EMPTY grant list: the only way a region can be granted
here is through the capability names lowered onto `HirBlock.unsafe_caps`.

## Scope and Preconditions

Each scenario lowers a fixture under `test/fixtures/any_escape/` to HIR and
runs `any_escape_check`. Pre-fix, the block form lowered to a plain expression
statement and every `Any` inside it was reported as an origin.

## Primary Workflow

Block form with `type_erasure` -> HIR `UnsafeBlock` whose body carries the
capability -> checker treats the region as granted.

## Key Concepts

| Concept | Description |
|---------|-------------|
| `HirBlock.unsafe_caps` | Capability names carried on the body of `HirExprKind.UnsafeBlock` |
| `type_erasure` | The only capability that licenses `Any` inside the region |

## Related Specifications

- test/01_unit/compiler/semantics/any_escape/any_escape_spec.spl (annotation form)

## Evidence and Provenance

The `raw_ptr`-only and unknown-capability neighbours are load-bearing: a fix
that treated ANY capability list as a grant would pass the primary scenario
and fail them.

## Recovery and Troubleshooting

A parse failure here means the statement-position `unsafe(` branch in
`parser_stmts.spl` regressed; a spurious `E-MC-ANY-001` with a clean parse
means `unsafe_caps` was dropped between `ExprKind.UnsafeBlock` and `HirBlock`.

## Compatibility and Limitations

Only the BLOCK form is carried on HIR. The declaration-level `@unsafe(...)`
annotation form still reaches the checker through `AnyEscapeProfile`.
"""

use std.spec.*
use compiler.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}
use compiler.hir.hir_lowering.*
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfacesByName}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.*
use compiler.semantics.any_escape.types.{AnyEscapeProfile, any_escape_kind_name}
use compiler.semantics.any_escape.checker.{any_escape_check}

# ============================================================================
# Step Helpers
# ============================================================================

fn lower_fixture(name: text) -> HirModule:
    val path = "test/fixtures/any_escape/" + name + ".spl"
    val content = rt_file_read_text(path) ?? ""
    val log = Logger(level: 0)
    val pm = parse_full_frontend(content, path, name, log)
    val surfaces = ModuleSurfacesByName.empty()
    var lowering = hirlowering_for_module("", surfaces)
    lowering.lower_module(pm)

fn check_fixture(name: text) -> [text]:
    """Findings as `<code>/<class>`, with NO profile grant at all."""
    val diags = any_escape_check(lower_fixture(name), AnyEscapeProfile.census([]))
    var out: [text] = []
    for d in diags:
        out = out.push(d.code + "/" + any_escape_kind_name(d.kind))
    out

fn count_of(found: [text], want: text) -> i64:
    var n = 0
    for f in found:
        if f == want:
            n = n + 1
    n

fn first_unsafe_caps(hm: HirModule) -> [text]:
    """Capability list of the first `UnsafeBlock` statement in the first
    function; `["<none>"]` when no UnsafeBlock is found at all."""
    for key in hm.functions.keys():
        val f = hm.functions[key]
        for s in f.body.stmts:
            match s.kind:
                case HirStmtKind.Expr(e):
                    match e.kind:
                        case HirExprKind.UnsafeBlock(body): return body.unsafe_caps
                        case _: ()
                case _: ()
    ["<none>"]

# ============================================================================
# Primary Scenarios
# ============================================================================

describe "unsafe(capabilities: [...]) block form":

    it "parses the block form into HirExprKind.UnsafeBlock carrying its capabilities":
        # @req: REQ-MC-ANY-001
        step("Verify: parses the block form into HirExprKind.UnsafeBlock carrying its capabilities")
        step("lower the §8.1 primary-spelling fixture")
        val caps = first_unsafe_caps(lower_fixture("block_form_type_erasure"))
        step("the statement IS an UnsafeBlock (pre-fix: plain expression statement)")
        expect(caps.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        step("and the body carries the parsed capability name")
        expect(caps[0]).to_equal("type_erasure")

    it "treats Any inside a type_erasure block as granted without any profile grant":
        # @req: REQ-COMPILER-SEMANTICS-ANYESCAPE-001
        step("Verify: treats Any inside a type_erasure block as granted without any profile grant")
        step("check the fixture with an EMPTY grant list")
        val found = check_fixture("block_form_type_erasure")
        step("no origin report: the grant came from the HIR node")
        expect(count_of(found, "E-MC-ANY-001/outside_unsafe")).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # Neighbour 1 — a capability list is not a grant; only type_erasure is.
    it "still reports the origin when the block asks for raw_ptr only":
        # @req: REQ-MC-ANY-001
        step("Verify: still reports the origin when the block asks for raw_ptr only")
        step("check a block form granting raw_ptr but not type_erasure")
        val found = check_fixture("block_form_raw_ptr_only")
        step("the Any inside is an E-MC-ANY-001 origin")
        expect(count_of(found, "E-MC-ANY-001/outside_unsafe")).to_be_greater_than(0)

    # Neighbour 2 — the granted region still fences escapes.
    it "reports an escape, not an origin, when the granted block returns its Any":
        # @req: REQ-COMPILER-SEMANTICS-ANYESCAPE-001
        step("Verify: reports an escape, not an origin, when the granted block returns its Any")
        step("check a type_erasure block that returns the erased value")
        val found = check_fixture("block_form_leak")
        expect(count_of(found, "E-MC-ANY-002/escape_return")).to_be_greater_than(0)
        expect(count_of(found, "E-MC-ANY-001/outside_unsafe")).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # Neighbour 3 — a typo'd capability is never a silent grant.
    it "does not grant erasure for an unknown capability name":
        # @req: REQ-MC-ANY-001
        step("Verify: does not grant erasure for an unknown capability name")
        step("check a block form whose capability is misspelled")
        val found = check_fixture("block_form_unknown_cap")
        expect(count_of(found, "E-MC-ANY-001/outside_unsafe")).to_be_greater_than(0)

    # Neighbour 4 — the bare form keeps working and carries no capabilities.
    it "keeps the bare `unsafe:` form as an UnsafeBlock with no capabilities":
        # @req: REQ-COMPILER-SEMANTICS-ANYESCAPE-001
        step("Verify: keeps the bare unsafe: form as an UnsafeBlock with no capabilities")
        val caps = first_unsafe_caps(lower_fixture("block_form_bare"))
        expect(caps.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
