# A5 pure carrier/validator tests. Runtime qualification is owned by the caller.
use std.spec.*
use compiler.common.assurance.representation_manifest_v1.{RepresentationManifestV1, RepresentationDeclarationV1}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.common.diagnostics.span.{Span}
use compiler.common.diagnostics.severity.{Severity}
use compiler.semantics.symbol_id.stable_id.{SymbolComponents, stable_symbol_id}
use compiler.semantics.representation_boundary.validation.{representation_manifest_validate_v1, representation_index_build_v1, representation_internal_binding_exempt_v1, representation_manifest_diagnostics_v1}

fn rep_span(start: i64, end: i64) -> Span:
    Span(start: start, end: end, line: 1, col: start + 1, file: "fixture.spl", length: end - start)

fn rep_manifest() -> RepresentationManifestV1:
    RepresentationManifestV1(schema_version: 1, kind: "layout", reason: "Device word storage", reviewers: ["platform-owner"], capabilities: [])

fn rep_declaration(name: text, start: i64, finish: i64) -> RepresentationDeclarationV1:
    val components = SymbolComponents(package: "a5.test", module_path: "fixture", item_kind: "fn", owner_id: "", name: name, signature: "fn {name}()")
    RepresentationDeclarationV1(components: components, declaration_id: stable_symbol_id(components), local_symbol_id: start, declaration_span: rep_span(start, finish), attribute_span: rep_span(start, start), owned_intervals: [rep_span(start, finish)], source_digest: "source-v1", manifest: Some(rep_manifest()), metadata_errors: [], region_capabilities: [])

describe "A5 manifest admission":
    it "admits empty-capability layout and preserves exact declaration identity":
        val declaration = rep_declaration("encode", 10, 40)
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(true)
        expect(admitted.diagnostics.len()).to_equal(0)
        expect(admitted.declaration.declaration_id).to_equal(stable_symbol_id(declaration.components))

    it "keeps unannotated safe declarations ordinary":
        var declaration = rep_declaration("safe", 10, 40)
        declaration.manifest = nil
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(0)

    it "requires metadata for declared unsafe regions and follows strictness":
        var declaration = rep_declaration("unsafe_work", 10, 40)
        declaration.manifest = nil
        declaration.region_capabilities = ["ffi"]
        val baseline = representation_manifest_validate_v1(declaration, AssuranceStrictness.Moderate)
        val critical = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(baseline.primitive_internal_exempt).to_equal(false)
        expect(baseline.diagnostics[0].code).to_equal(Some("E-MC-REP-001"))
        expect(baseline.diagnostics[0].severity).to_equal(Severity.Warning)
        expect(critical.diagnostics[0].severity).to_equal(Severity.Error)
        expect(critical.diagnostics[0].span).to_equal(Some(declaration.declaration_span))

    it "requires metadata for an explicit unsafe region with no capabilities":
        var declaration = rep_declaration("empty_unsafe", 10, 40)
        declaration.manifest = nil
        declaration.requires_manifest = true
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics[0].code).to_equal(Some("E-MC-REP-001"))

    it "rejects whitespace reason and blank reviewer with attribute locations":
        var declaration = rep_declaration("blank", 10, 40)
        var manifest = rep_manifest()
        manifest.reason = " \t\n"
        manifest.reviewers = [" "]
        declaration.manifest = Some(manifest)
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(2)
        expect(admitted.diagnostics[0].span).to_equal(Some(declaration.attribute_span))

    it "rejects missing reviewers and unknown kind":
        var declaration = rep_declaration("unknown", 10, 40)
        var manifest = rep_manifest()
        manifest.reviewers = []
        manifest.kind = "module"
        declaration.manifest = Some(manifest)
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(2)

    it "normalizes trimmed reason and reviewers after validation":
        var declaration = rep_declaration("trimmed", 10, 40)
        var manifest = rep_manifest()
        manifest.reason = "  reviewed layout  "
        manifest.reviewers = [" platform-owner "]
        declaration.manifest = Some(manifest)
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(true)
        match admitted.manifest:
            Some(normalized):
                expect(normalized.reason).to_equal("reviewed layout")
                expect(normalized.reviewers).to_equal(["platform-owner"])
            nil:
                assert(false)

    it "rejects duplicate reviewer and capability literals":
        var declaration = rep_declaration("duplicate", 10, 40)
        var manifest = rep_manifest()
        manifest.reviewers = ["platform-owner", " platform-owner "]
        manifest.capabilities = ["ffi", "ffi"]
        declaration.manifest = Some(manifest)
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(2)

    it "retains parser duplicate-key and duplicate-row failures":
        var declaration = rep_declaration("duplicate_keys", 10, 40)
        declaration.metadata_errors = ["duplicate reason", "duplicate representation_boundary"]
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(2)
        expect(admitted.diagnostics[0].code).to_equal(Some("E-MC-REP-001"))

    it "rejects capability typos and unaudited region capabilities":
        var declaration = rep_declaration("caps", 10, 40)
        var manifest = rep_manifest()
        manifest.capabilities = ["FFI"]
        declaration.manifest = Some(manifest)
        declaration.region_capabilities = ["ffi"]
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(2)
        expect(admitted.diagnostics[0].code).to_equal(Some("E-MC-REP-003"))

    it "accepts the existing vocabulary without changing region caps":
        var declaration = rep_declaration("all_caps", 10, 40)
        var manifest = rep_manifest()
        manifest.capabilities = ["raw_ptr", "ffi", "mmio", "inline_asm", "type_erasure"]
        declaration.manifest = Some(manifest)
        declaration.region_capabilities = ["ffi", "mmio"]
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(true)
        expect(admitted.declaration.region_capabilities).to_equal(["ffi", "mmio"])

    it "rejects unsupported schema and absent source freshness":
        var declaration = rep_declaration("stale", 10, 40)
        var manifest = rep_manifest()
        manifest.schema_version = 2
        declaration.manifest = Some(manifest)
        declaration.source_digest = ""
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics.len()).to_equal(2)
        expect(admitted.diagnostics[0].code).to_equal(Some("E-MC-REP-004"))

    it "rejects shortened identity and missing package context":
        var declaration = rep_declaration("identity", 10, 40)
        declaration.declaration_id = declaration.declaration_id.slice(0, 12)
        declaration.components.package = ""
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics[0].code).to_equal(Some("E-MC-REP-002"))

    it "rejects unsupported declaration targets and foreign ownership spans":
        var declaration = rep_declaration("bad_scope", 10, 40)
        declaration.components.item_kind = "module"
        declaration.declaration_id = stable_symbol_id(declaration.components)
        declaration.owned_intervals = [rep_span(5, 20)]
        val admitted = representation_manifest_validate_v1(declaration, AssuranceStrictness.Critical)
        expect(admitted.primitive_internal_exempt).to_equal(false)
        expect(admitted.diagnostics[0].code).to_equal(Some("E-MC-REP-002"))

describe "A5 invocation-owned index":
    it "exempts only complete bindings in exact half-open owned intervals":
        val declaration = rep_declaration("exact", 10, 40)
        val index = representation_index_build_v1([declaration], AssuranceStrictness.Critical)
        expect(representation_internal_binding_exempt_v1(index, declaration.declaration_id, rep_span(11, 15))).to_equal(true)
        expect(representation_internal_binding_exempt_v1(index, declaration.declaration_id, rep_span(39, 41))).to_equal(false)
        expect(representation_internal_binding_exempt_v1(index, declaration.declaration_id, rep_span(40, 40))).to_equal(false)
        expect(representation_internal_binding_exempt_v1(index, "missing", rep_span(11, 15))).to_equal(false)
        var foreign = rep_span(11, 15)
        foreign.file = "other.spl"
        expect(representation_internal_binding_exempt_v1(index, declaration.declaration_id, foreign)).to_equal(false)

    it "keeps same names in different modules distinct":
        val first = rep_declaration("same", 10, 30)
        var second = rep_declaration("same", 40, 60)
        second.components.module_path = "other"
        second.declaration_id = stable_symbol_id(second.components)
        second.manifest = nil
        val index = representation_index_build_v1([first, second], AssuranceStrictness.Critical)
        expect(index.declarations.len()).to_equal(2)
        expect(representation_internal_binding_exempt_v1(index, first.declaration_id, rep_span(11, 15))).to_equal(true)
        expect(representation_internal_binding_exempt_v1(index, second.declaration_id, rep_span(41, 45))).to_equal(false)

    it "does not inherit across nested callable ownership holes":
        var outer = rep_declaration("outer", 10, 100)
        outer.owned_intervals = [rep_span(10, 30), rep_span(60, 100)]
        var nested = rep_declaration("inner", 30, 60)
        nested.manifest = nil
        val index = representation_index_build_v1([outer, nested], AssuranceStrictness.Critical)
        expect(index.diagnostics.len()).to_equal(0)
        expect(representation_internal_binding_exempt_v1(index, outer.declaration_id, rep_span(65, 70))).to_equal(true)
        expect(representation_internal_binding_exempt_v1(index, outer.declaration_id, rep_span(35, 40))).to_equal(false)
        expect(representation_internal_binding_exempt_v1(index, nested.declaration_id, rep_span(35, 40))).to_equal(false)
        expect(index.intervals[1].declaration_id).to_equal(nested.declaration_id)

    it "rejects both sides of duplicate identity even with identical payload":
        val declaration = rep_declaration("duplicate", 10, 40)
        val index = representation_index_build_v1([declaration, declaration], AssuranceStrictness.Critical)
        expect(representation_internal_binding_exempt_v1(index, declaration.declaration_id, rep_span(11, 15))).to_equal(false)
        expect(index.diagnostics[0].code).to_equal(Some("E-MC-REP-002"))

    it "rejects annotated and ordinary declarations sharing identity in either order":
        val annotated = rep_declaration("shared_identity", 10, 30)
        var ordinary = rep_declaration("shared_identity", 40, 60)
        ordinary.manifest = nil
        expect(ordinary.declaration_id).to_equal(annotated.declaration_id)
        for declarations in [[annotated, ordinary], [ordinary, annotated]]:
            val index = representation_index_build_v1(declarations, AssuranceStrictness.Critical)
            expect(index.declarations.contains_key(annotated.declaration_id)).to_equal(true)
            expect(index.declarations[annotated.declaration_id].primitive_internal_exempt).to_equal(false)
            expect(representation_internal_binding_exempt_v1(index, annotated.declaration_id, rep_span(11, 15))).to_equal(false)
            expect(representation_internal_binding_exempt_v1(index, ordinary.declaration_id, rep_span(41, 45))).to_equal(false)
            expect(index.diagnostics.len()).to_equal(1)
            expect(index.diagnostics[0].code).to_equal(Some("E-MC-REP-002"))

    it "rejects ordinary conflicting components reusing an annotated identity in either order":
        val annotated = rep_declaration("conflicting_components", 10, 30)
        var ordinary = rep_declaration("conflicting_components", 40, 60)
        ordinary.manifest = nil
        ordinary.components.module_path = "different.module"
        # A stale or corrupt row retained the old identity despite new components.
        expect(ordinary.declaration_id).to_equal(annotated.declaration_id)
        expect(stable_symbol_id(ordinary.components) == annotated.declaration_id).to_equal(false)
        for declarations in [[annotated, ordinary], [ordinary, annotated]]:
            val index = representation_index_build_v1(declarations, AssuranceStrictness.Critical)
            expect(index.declarations[annotated.declaration_id].primitive_internal_exempt).to_equal(false)
            expect(representation_internal_binding_exempt_v1(index, annotated.declaration_id, rep_span(11, 15))).to_equal(false)
            expect(index.diagnostics[0].code).to_equal(Some("E-MC-REP-002"))

    it "rejects ordinary conflicting source digest reusing an annotated identity in either order":
        val annotated = rep_declaration("conflicting_source", 10, 30)
        var ordinary = rep_declaration("conflicting_source", 40, 60)
        ordinary.manifest = nil
        ordinary.source_digest = "source-v2"
        for declarations in [[annotated, ordinary], [ordinary, annotated]]:
            val index = representation_index_build_v1(declarations, AssuranceStrictness.Critical)
            expect(index.declarations[annotated.declaration_id].primitive_internal_exempt).to_equal(false)
            expect(representation_internal_binding_exempt_v1(index, annotated.declaration_id, rep_span(11, 15))).to_equal(false)
            expect(index.diagnostics.len()).to_equal(1)
            expect(index.diagnostics[0].code).to_equal(Some("E-MC-REP-004"))

    it "omits unsupported anonymous barriers after the owner has been split":
        var outer = rep_declaration("barrier_owner", 10, 100)
        outer.owned_intervals = [rep_span(10, 30), rep_span(60, 100)]
        var anonymous = rep_declaration("", 30, 45)
        anonymous.manifest = nil
        anonymous.components.item_kind = "nested_callable"
        anonymous.declaration_id = ""
        anonymous.local_symbol_id = -1
        var nested_extern = rep_declaration("", 45, 60)
        nested_extern.manifest = nil
        nested_extern.components.item_kind = "nested_extern"
        nested_extern.declaration_id = ""
        nested_extern.local_symbol_id = -1
        val index = representation_index_build_v1([outer, anonymous, nested_extern], AssuranceStrictness.Critical)
        expect(index.declarations.len()).to_equal(1)
        expect(index.intervals.len()).to_equal(2)
        expect(index.diagnostics.len()).to_equal(0)
        expect(representation_internal_binding_exempt_v1(index, outer.declaration_id, rep_span(35, 40))).to_equal(false)
        expect(representation_internal_binding_exempt_v1(index, outer.declaration_id, rep_span(65, 70))).to_equal(true)

    it "diagnoses metadata-bearing unsupported barriers instead of omitting them":
        var barrier = rep_declaration("", 30, 45)
        barrier.components.item_kind = "nested_callable"
        barrier.declaration_id = ""
        barrier.local_symbol_id = -1
        val index = representation_index_build_v1([barrier], AssuranceStrictness.Critical)
        expect(index.declarations.contains_key("")).to_equal(true)
        expect(index.declarations[""].primitive_internal_exempt).to_equal(false)
        expect(index.diagnostics[0].code).to_equal(Some("E-MC-REP-002"))

    it "rejects edited source reusing an existing declaration identity":
        val first = rep_declaration("edited", 10, 40)
        var second = first
        second.source_digest = "source-v2"
        val index = representation_index_build_v1([first, second], AssuranceStrictness.Critical)
        expect(index.declarations[first.declaration_id].primitive_internal_exempt).to_equal(false)
        expect(index.diagnostics[0].code).to_equal(Some("E-MC-REP-004"))

    it "rejects all overlapping owners including a long enclosing interval":
        val first = rep_declaration("long", 10, 100)
        val second = rep_declaration("short", 20, 30)
        val third = rep_declaration("later", 40, 50)
        val index = representation_index_build_v1([first, second, third], AssuranceStrictness.Critical)
        expect(index.declarations[first.declaration_id].primitive_internal_exempt).to_equal(false)
        expect(index.declarations[second.declaration_id].primitive_internal_exempt).to_equal(false)
        expect(index.declarations[third.declaration_id].primitive_internal_exempt).to_equal(false)
        expect(representation_manifest_diagnostics_v1(index).len()).to_equal(3)

    it "preserves declaration source order for diagnostic publication":
        var first = rep_declaration("first", 10, 30)
        var second = rep_declaration("second", 40, 60)
        first.metadata_errors = ["first malformed attribute"]
        second.metadata_errors = ["second malformed attribute"]
        val index = representation_index_build_v1([first, second], AssuranceStrictness.Critical)
        val diagnostics = representation_manifest_diagnostics_v1(index)
        expect(diagnostics.len()).to_equal(2)
        expect(diagnostics[0].message).to_contain("first malformed attribute")
        expect(diagnostics[1].message).to_contain("second malformed attribute")
