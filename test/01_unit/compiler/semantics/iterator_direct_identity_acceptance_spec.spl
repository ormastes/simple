# codex-system-test
# @req REQ-MC-005 G7
# Source-authored production API acceptance; execution UNRUN.
use std.spec.*
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.semantics.safety_checker.{SafetyChecker, SafetyError, safetychecker_check_module}

# Assertion-only helper; never models the production checker.
fn assert_e1048_diagnostics(errors: [SafetyError], expected_count: i64, expected_line: i64, expected_col: i64, expected_file: text):
    var count = 0
    for diagnostic in errors:
        match diagnostic:
            case Other(message, span):
                if message.starts_with("E1048:"):
                    count = count + 1
                    expect(message).to_equal("E1048: collection 'xs' is mutated while being iterated")
                    expect(span.line).to_equal(expected_line)
                    expect(span.col).to_equal(expected_col)
                    expect(span.file).to_equal(expected_file)
            case _: ()
    expect(count).to_equal(expected_count)
    expect(errors.len()).to_equal(expected_count)

describe "G7 direct resolved collection identity":
    it "should reject direct push":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        xs.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_push.spl", "g7_push", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_push.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 1, 4, 9, "testdata/g7_push.spl")

    it "should reject direct index assignment":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        xs[0] = x\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_index.spl", "g7_index", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_index.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 1, 4, 9, "testdata/g7_index.spl")

    it "should reject direct reassignment":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        xs = [9]\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_reassign.spl", "g7_reassign", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_reassign.spl")
