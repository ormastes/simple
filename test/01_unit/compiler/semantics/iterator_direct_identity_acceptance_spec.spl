    it "should distinguish a shadowed binding":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        var xs: [i64] = [9]\n        xs.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_shadow.spl", "g7_shadow", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_shadow.spl")
        val hir = lowering.lower_module(parsed)
