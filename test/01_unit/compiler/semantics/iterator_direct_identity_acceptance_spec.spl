        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 1, 4, 9, "testdata/g7_reassign.spl")

    it "should reject desugared collection merge":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        xs = xs + [x]\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_merge.spl", "g7_merge", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_merge.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 1, 4, 9, "testdata/g7_merge.spl")

    it "should retain outer iterable through nested loop":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    var ys: [i64] = [3]\n    for x in xs:\n        for y in ys:\n            xs.push(y)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_nested_outer.spl", "g7_nested_outer", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_nested_outer.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 1, 6, 13, "testdata/g7_nested_outer.spl")

    it "should allow mutation of a separate collection":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    var ys: [i64] = [3]\n    for x in xs:\n        ys.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_other.spl", "g7_other", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_other.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 0, 0, 0, "testdata/g7_other.spl")

    it "should allow mutation after iteration":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        val y = x\n    xs.push(9)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_after.spl", "g7_after", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
