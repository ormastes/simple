        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 0, 0, 0, "testdata/g7_after.spl")

    it "should allow collection length reads":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    for x in xs:\n        val n = xs.len()\n    0\n"
