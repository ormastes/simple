    it "should retain outer iterable after inner loop exit":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    var ys: [i64] = [3]\n    for x in xs:\n        for y in ys:\n            val z = y\n        xs.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_nested_exit.spl", "g7_nested_exit", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_nested_exit.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 1, 7, 9, "testdata/g7_nested_exit.spl")

    it "should release inner iterable after inner loop exit":
        step("Parse and lower the actual collection iteration program")
        val source = "fn walk() -> i64:\n    var xs: [i64] = [1, 2]\n    var ys: [i64] = [3]\n    for x in xs:\n        for y in ys:\n            val z = y\n        ys.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_inner_after_exit.spl", "g7_inner_after_exit", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.functions.contains("walk")).to_equal(true)
        var lowering = HirLowering.with_filename("testdata/g7_inner_after_exit.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Check actual resolved HIR and require exact iterator diagnostics")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        assert_e1048_diagnostics(errors, 0, 0, 0, "testdata/g7_inner_after_exit.spl")

