# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that forbidden-I/O acquisition entry point set.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

# Forbidden-I/O Context Checker Specification (E-APACK008, contextual half)
#
# Tests for `35.semantics/forbidden_io_checker.spl`. See that file's header
# for the scope decision (contextual formulation only; temporal formulation
# is a runtime concern, tested separately in
# test/01_unit/lib/aspect_pack_forbidden_io_temporal_spec.spl) and
# doc/04_architecture/compiler/aspect_dynload/forbidden_io_diagnostic_scope_2026-08-19.md.
#
# Covers both loader entry points and the real HIR markers emitted for
# `facet<T>()` / `try_facet<T>()`, including aspect-advice `@noalloc` context.

use compiler.semantics.forbidden_io_checker.{
    ForbiddenIoContextManifest, ForbiddenIoViolationKind,
    FORBIDDEN_IO_MAX_CALL_DEPTH,
    check_forbidden_io_violations, check_all_forbidden_io_fns,
    format_forbidden_io_violation, format_forbidden_io_violations,
    is_forbidden_io_acquire_fn, check_hir_modules_forbidden_io,
    check_hir_modules_forbidden_io_with_sources
}
use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_hir_pipeline_lowering.{run_forbidden_io_hir_pass}
use compiler.frontend.aspect_registry.{aspect_registry_declare}
use compiler.frontend.parser_types_expr.{AsmConstraintKind, AsmLocation}
use std.io_runtime.{file_read}

fn forbidden_io_unit_expr() -> HirExpr:
    val span = Span.empty()
    HirExpr(
        kind: HirExprKind.UnitLit,
        has_type_: true,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )

fn forbidden_io_facet_marker(lazy: bool) -> HirExpr:
    val span = Span.empty()
    val method = if lazy: "__facet_load$Named" else: "__facet_try$Named"
    HirExpr(
        kind: HirExprKind.MethodCall(
            forbidden_io_unit_expr(), method, [], MethodResolution.Unresolved),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )

fn forbidden_io_call_expr(symbol_id: i64, name: text) -> HirExpr:
    val span = Span.empty()
    val callee = HirExpr(
        kind: HirExprKind.NamedVar(SymbolId(id: symbol_id), name),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )
    HirExpr(
        kind: HirExprKind.Call(callee, [], []),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )

fn forbidden_io_method_call_expr(method_id: i64, method: text) -> HirExpr:
    val span = Span.empty()
    HirExpr(
        kind: HirExprKind.MethodCall(
            forbidden_io_unit_expr(), method, [],
            MethodResolution.InstanceMethod(
                SymbolId(id: 900), SymbolId(id: method_id))),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )

fn forbidden_io_static_call_expr(method_id: i64, method: text) -> HirExpr:
    val span = Span.empty()
    HirExpr(
        kind: HirExprKind.StaticCall(
            HirType(kind: HirTypeKind.Unit, span: span), method, [],
            MethodResolution.StaticMethod(
                SymbolId(id: 901), SymbolId(id: method_id))),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )

fn forbidden_io_inline_asm_expr(operand: HirExpr) -> HirExpr:
    val span = Span.empty()
    val constraint = HirAsmConstraint(
        name: "operand",
        kind: AsmConstraintKind.In,
        location: AsmLocation.Reg,
        value: operand,
        output_value: nil,
        span: span
    )
    HirExpr(
        kind: HirExprKind.InlineAsm(HirAsm(
            asm_template: "",
            is_volatile: false,
            constraints: [constraint],
            clobbers: [],
            clobber_abis: [],
            options: [],
            span: span
        )),
        has_type_: false,
        type_: HirType(kind: HirTypeKind.Unit, span: span),
        span: span
    )
fn forbidden_io_hir_function(
    symbol_id: i64, name: text, tail: HirExpr, is_noalloc: bool
) -> HirFunction:
    val span = Span.empty()
    var attr = FunctionAttr.default()
    attr.is_no_alloc = is_noalloc
    HirFunction(
        symbol: SymbolId(id: symbol_id),
        name: name,
        type_params: [],
        params: [],
        return_type: HirType(kind: HirTypeKind.Unit, span: span),
        body: HirBlock(stmts: [], has: true, value: tail, span: span),
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: attr,
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: span
    )

fn forbidden_io_hir_module(path: text, functions: [HirFunction]) -> HirModule:
    var function_map: Dict<SymbolId, HirFunction> = {}
    var symbols = SymbolTable.new()
    for function in functions:
        function_map[function.symbol] = function
        symbols.register_preserved_symbol(HirSymbol(
            id: function.symbol,
            name: function.name,
            kind: if function.is_method: SymbolKind.Method else: SymbolKind.Function,
            type_: nil,
            scope: ScopeId(id: 0),
            span: function.span,
            visibility: function.visibility,
            is_public: function.is_public,
            is_mutable: function.is_mutable,
            defining_module: Some(path)
        ))
    HirModule(
        name: path,
        path: path,
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: symbols,
        functions: function_map,
        gpu_function_targets: {},
        gpu_function_backend_orders: {},
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

fn forbidden_io_error_count(errors: [text]) -> i64:
    var count = 0
    for error in errors:
        if error.contains("error[E-APACK008]"):
            count = count + 1
    count

fn forbidden_io_direct_hir(path: text, lazy: bool) -> HirModule:
    forbidden_io_hir_module(path, [
        forbidden_io_hir_function(0, "trace", forbidden_io_facet_marker(lazy), true)
    ])

fn forbidden_io_transitive_hir(path: text, lazy: bool) -> HirModule:
    forbidden_io_hir_module(path, [
        forbidden_io_hir_function(0, "helper", forbidden_io_facet_marker(lazy), false),
        forbidden_io_hir_function(1, "trace", forbidden_io_call_expr(0, "helper"), true)
    ])

use std.spec.step

describe "forbidden-I/O acquisition entry point set":
    # @manual scenario evidence
    it "recognizes the lazy loader-level acquisition functions":
        # @req REQ-SSPEC-COMPILER
        step("recognizes the lazy loader-level acquisition functions")
        step("Verify: recognizes the lazy loader-level acquisition functions")
        # @req: REQ-COMPILER-SEMANTICS-001
        expect(is_forbidden_io_acquire_fn("apk_load_facet")).to_equal(true)
        expect(is_forbidden_io_acquire_fn("apk_load_aspect_manual")).to_equal(true)
        expect(is_forbidden_io_acquire_fn("apk_activate_startup")).to_equal(true)
        expect(is_forbidden_io_acquire_fn("_apk_acquire_facet")).to_equal(true)
        expect(is_forbidden_io_acquire_fn("facet_lookup_lazy")).to_equal(true)
        expect(is_forbidden_io_acquire_fn("runtime::facet_lookup_lazy")).to_equal(true)
        expect(is_forbidden_io_acquire_fn(
            "common.facet_runtime.facet_lookup_lazy")).to_equal(true)
        expect(is_forbidden_io_acquire_fn(
            "std.common.facet_runtime::facet_lookup_lazy")).to_equal(true)

    it "does not let an unrelated qualified symbol impersonate a loader entry point":
        expect(is_forbidden_io_acquire_fn("tenant.metrics::apk_load_facet")).to_equal(false)
        expect(is_forbidden_io_acquire_fn("tenant.metrics.facet_lookup_lazy")).to_equal(false)
        expect(is_forbidden_io_acquire_fn(
            "tenant.common.facet_runtime.facet_lookup_lazy")).to_equal(false)

    it "does NOT flag apk_try_facet — its own contract states it never performs I/O":
        # @req REQ-SSPEC-COMPILER
        step("does NOT flag apk_try_facet — its own contract states it never performs I/O")
        step("Verify: does NOT flag apk_try_facet — its own contract states it never performs I/O")
        expect(is_forbidden_io_acquire_fn("apk_try_facet")).to_equal(false)
        expect(is_forbidden_io_acquire_fn("facet_lookup_loaded")).to_equal(false)

describe "real HIR forbidden-I/O integration":
    it "rejects the real lazy-facet HIR marker directly from a noalloc function":
        val hir = forbidden_io_direct_hir("forbidden_lazy_direct", true)
        val violations = check_hir_modules_forbidden_io({"forbidden_lazy_direct": hir})
        expect(violations.len()).to_equal(1)
        expect(violations[0].kind).to_equal(ForbiddenIoViolationKind.DirectAcquire)
        expect(violations[0].detail).to_contain("facet_lookup_lazy")

    it "accepts the resident try-facet HIR marker in the identical context":
        val hir = forbidden_io_direct_hir("forbidden_resident_control", false)
        expect(check_hir_modules_forbidden_io({"forbidden_resident_control": hir}).len()).to_equal(0)

    it "rejects lazy facet acquisition reached through an ordinary helper":
        val hir = forbidden_io_transitive_hir("forbidden_lazy_transitive", true)
        val violations = check_hir_modules_forbidden_io({"forbidden_lazy_transitive": hir})
        expect(violations.len()).to_equal(1)
        expect(violations[0].kind).to_equal(ForbiddenIoViolationKind.TransitiveAcquire)

    it "treats an aspect registry @noalloc obligation as a forbidden HIR context":
        val path = "aspect_noalloc_lazy.spl"
        val hir = forbidden_io_hir_module(path, [
            forbidden_io_hir_function(
                0, "trace", forbidden_io_facet_marker(true), false)
        ])
        aspect_registry_declare(path, "trace", "forward", "submit", "static",
            true, true, true)
        expect(check_hir_modules_forbidden_io({path: hir}).len()).to_equal(1)

    it "keeps equal short names and equal per-module SymbolIds isolated":
        val left = forbidden_io_transitive_hir("collision_left", true)
        val right = forbidden_io_transitive_hir("collision_right", false)
        val violations = check_hir_modules_forbidden_io({"left": left, "right": right})
        expect(violations.len()).to_equal(1)
        expect(violations[0].fn_name).to_contain("collision_left")

    it "accepts a user function whose short name collides with the loader API":
        val hir = forbidden_io_hir_module("loader_name_collision", [
            forbidden_io_hir_function(
                0, "apk_load_facet", forbidden_io_unit_expr(), false),
            forbidden_io_hir_function(
                1, "trace", forbidden_io_call_expr(0, "apk_load_facet"), true)
        ])
        expect(check_hir_modules_forbidden_io({"loader_name_collision": hir}).len()).to_equal(0)

    it "resolves an imported alias through defining-module provenance":
        val provider = forbidden_io_hir_module("provider", [
            forbidden_io_hir_function(
                0, "real_io", forbidden_io_facet_marker(true), false)
        ])
        var consumer = forbidden_io_hir_module("consumer", [
            forbidden_io_hir_function(
                0, "trace", forbidden_io_call_expr(7, "io_alias"), true)
        ])
        consumer.symbols.register_preserved_symbol(HirSymbol(
            id: SymbolId(id: 7),
            name: "provider.real_io",
            kind: SymbolKind.Function,
            type_: nil,
            scope: ScopeId(id: 0),
            span: Span.empty(),
            visibility: Visibility.Public,
            is_public: true,
            is_mutable: false,
            defining_module: Some("provider")
        ))
        consumer.imports = [HirImport(
            module_path: "reexport.facade",
            items: [HirImportItem(
                name: "real_io", alias: Some("io_alias"), resolved: nil)],
            is_lazy: false,
            span: Span.empty()
        )]
        val violations = check_hir_modules_forbidden_io(
            {"provider": provider, "consumer": consumer})
        expect(violations.len()).to_equal(1)
        expect(violations[0].kind).to_equal(ForbiddenIoViolationKind.TransitiveAcquire)

    it "uses resolved method IDs when two methods have the same short name":
        var lazy_method = forbidden_io_hir_function(
            10, "load", forbidden_io_facet_marker(true), false)
        lazy_method.is_method = true
        var safe_method = forbidden_io_hir_function(
            11, "load", forbidden_io_facet_marker(false), false)
        safe_method.is_method = true
        val lazy_caller = forbidden_io_hir_function(
            12, "lazy_trace", forbidden_io_method_call_expr(10, "load"), true)
        val safe_caller = forbidden_io_hir_function(
            13, "safe_trace", forbidden_io_method_call_expr(11, "load"), true)
        var hir = forbidden_io_hir_module(
            "method_identity", [lazy_method, safe_method, lazy_caller, safe_caller])
        var lazy_symbol = hir.symbols.symbols[10]
        lazy_symbol.name = "LazyOwner::load"
        hir.symbols.symbols[10] = lazy_symbol
        var safe_symbol = hir.symbols.symbols[11]
        safe_symbol.name = "ResidentOwner::load"
        hir.symbols.symbols[11] = safe_symbol
        val violations = check_hir_modules_forbidden_io({"method_identity": hir})
        expect(violations.len()).to_equal(1)
        expect(violations[0].fn_name).to_contain("lazy_trace")

    it "adds resolved static-call edges":
        var lazy_static = forbidden_io_hir_function(
            20, "load", forbidden_io_facet_marker(true), false)
        lazy_static.is_static = true
        val caller = forbidden_io_hir_function(
            21, "static_trace", forbidden_io_static_call_expr(20, "load"), true)
        val hir = forbidden_io_hir_module("static_edge", [lazy_static, caller])
        expect(check_hir_modules_forbidden_io({"static_edge": hir}).len()).to_equal(1)

    it "walks inline-assembly input operands":
        val hir = forbidden_io_hir_module("asm_operand", [
            forbidden_io_hir_function(0, "asm_trace",
                forbidden_io_inline_asm_expr(forbidden_io_facet_marker(true)), true)
        ])
        expect(check_hir_modules_forbidden_io({"asm_operand": hir}).len()).to_equal(1)

    it "deduplicates repeated lazy edges in one forbidden context":
        val repeated = HirExpr(
            kind: HirExprKind.TupleLit([
                forbidden_io_facet_marker(true), forbidden_io_facet_marker(true)]),
            has_type_: false,
            type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()),
            span: Span.empty()
        )
        val hir = forbidden_io_hir_module("dedupe", [
            forbidden_io_hir_function(0, "trace", repeated, true)
        ])
        expect(check_hir_modules_forbidden_io({"dedupe": hir}).len()).to_equal(1)

    it "recovers @realtime from the loaded source and has a mutation control":
        var realtime_fn = forbidden_io_hir_function(
            0, "trace", forbidden_io_facet_marker(true), false)
        realtime_fn.span = Span(
            start: 10, end: 20, line: 2, col: 1,
            file: "realtime_source.spl", length: 10)
        val hir = forbidden_io_hir_module("realtime_source.spl", [realtime_fn])
        val tagged = check_hir_modules_forbidden_io_with_sources(
            {"realtime_source": hir},
            {"realtime_source.spl": "@realtime\nfn trace():\n    pass\n"})
        val untagged = check_hir_modules_forbidden_io_with_sources(
            {"realtime_source": hir},
            {"realtime_source.spl": "\nfn trace():\n    pass\n"})
        expect(tagged.len()).to_equal(1)
        expect(untagged.len()).to_equal(0)

describe "real compiler-driver reachability":
    it "keeps the checker call in the shared post-HIR validation hook":
        val source = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        expect(source).to_contain("run_forbidden_io_hir_pass(ctx, ctx.hir_modules)")
        expect(source).to_contain("check_hir_modules_forbidden_io_with_sources(")
        expect(source).to_contain(
            "forbidden_io_source_texts[source.module_name] = source.content")

    it "publishes a lowered noalloc facet violation through the driver pass":
        val hir = forbidden_io_direct_hir("driver_forbidden_lazy.spl", true)
        val driver = CompilerDriver.create(driver_core_compile_options_default())
        run_forbidden_io_hir_pass(driver.ctx, {"driver_forbidden_lazy": hir})
        expect(driver.ctx.has_errors()).to_equal(true)
        expect(driver.ctx.errors.join("\n")).to_contain("error[E-APACK008]")

    it "keeps the resident control clean through the same driver hook":
        val hir = forbidden_io_direct_hir("driver_resident_control.spl", false)
        val driver = CompilerDriver.create(driver_core_compile_options_default())
        run_forbidden_io_hir_pass(driver.ctx, {"driver_resident_control": hir})
        expect(driver.ctx.has_errors()).to_equal(false)
        expect(driver.ctx.errors.join("\n")).to_not_contain("error[E-APACK008]")

describe "check_forbidden_io_violations — direct call":
    it "REJECTS: an interrupt-context function directly calling apk_load_facet":
        # @req REQ-SSPEC-COMPILER
        step("REJECTS: an interrupt-context function directly calling apk_load_facet")
        step("Verify: REJECTS: an interrupt-context function directly calling apk_load_facet")
        val m = ForbiddenIoContextManifest.new()
        m.register("isr_tick", false, true, false)
        m.set_callees("isr_tick", ["apk_load_facet"])
        val violations = check_forbidden_io_violations("isr_tick", m)
        expect(violations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(violations[0].kind).to_equal(ForbiddenIoViolationKind.DirectAcquire)

    it "REJECTS: a @noalloc-context function directly calling apk_load_aspect_manual":
        # @req REQ-SSPEC-COMPILER
        step("REJECTS: a @noalloc-context function directly calling apk_load_aspect_manual")
        step("Verify: REJECTS: a @noalloc-context function directly calling apk_load_aspect_manual")
        val m = ForbiddenIoContextManifest.new()
        m.register("noalloc_step", false, false, true)
        m.set_callees("noalloc_step", ["apk_load_aspect_manual"])
        expect(check_forbidden_io_violations("noalloc_step", m).len()).to_equal(1)

    it "REJECTS: a real-time-context function directly calling apk_activate_startup":
        # @req REQ-SSPEC-COMPILER
        step("REJECTS: a real-time-context function directly calling apk_activate_startup")
        step("Verify: REJECTS: a real-time-context function directly calling apk_activate_startup")
        val m = ForbiddenIoContextManifest.new()
        m.register("rt_loop", true, false, false)
        m.set_callees("rt_loop", ["apk_activate_startup"])
        expect(check_forbidden_io_violations("rt_loop", m).len()).to_equal(1)

    it "PASSES: an interrupt-context function calling apk_try_facet (no I/O, legitimate)":
        # @req REQ-SSPEC-COMPILER
        step("PASSES: an interrupt-context function calling apk_try_facet (no I/O, legitimate)")
        step("Verify: PASSES: an interrupt-context function calling apk_try_facet (no I/O, legitimate)")
        val m = ForbiddenIoContextManifest.new()
        m.register("isr_tick", false, true, false)
        m.set_callees("isr_tick", ["apk_try_facet"])
        expect(check_forbidden_io_violations("isr_tick", m).len()).to_equal(0)

    it "PASSES: an ordinary (untagged) function calling apk_load_facet — not a forbidden context at all":
        # @req REQ-SSPEC-COMPILER
        step("PASSES: an ordinary (untagged) function calling apk_load_facet — not a forbidden context at all")
        step("Verify: PASSES: an ordinary (untagged) function calling apk_load_facet — not a forbidden context at all")
        val m = ForbiddenIoContextManifest.new()
        m.register("ordinary_startup_fn", false, false, false)
        m.set_callees("ordinary_startup_fn", ["apk_load_facet"])
        expect(check_forbidden_io_violations("ordinary_startup_fn", m).len()).to_equal(0)

describe "check_forbidden_io_violations — transitive call":
    it "REJECTS: an interrupt-context function reaching apk_load_facet through two hops":
        # @req REQ-SSPEC-COMPILER
        step("REJECTS: an interrupt-context function reaching apk_load_facet through two hops")
        step("Verify: REJECTS: an interrupt-context function reaching apk_load_facet through two hops")
        val m = ForbiddenIoContextManifest.new()
        m.register("isr_tick", false, true, false)
        m.set_callees("isr_tick", ["helper_a"])
        m.set_callees("helper_a", ["helper_b"])
        m.set_callees("helper_b", ["apk_load_facet"])
        val violations = check_forbidden_io_violations("isr_tick", m)
        expect(violations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(violations[0].kind).to_equal(ForbiddenIoViolationKind.TransitiveAcquire)

    it "PASSES: an interrupt-context function whose transitive chain never reaches an acquisition fn":
        # @req REQ-SSPEC-COMPILER
        step("PASSES: an interrupt-context function whose transitive chain never reaches an acquisition fn")
        step("Verify: PASSES: an interrupt-context function whose transitive chain never reaches an acquisition fn")
        val m = ForbiddenIoContextManifest.new()
        m.register("isr_tick", false, true, false)
        m.set_callees("isr_tick", ["helper_a"])
        m.set_callees("helper_a", ["helper_b"])
        m.set_callees("helper_b", ["apk_try_facet"])
        expect(check_forbidden_io_violations("isr_tick", m).len()).to_equal(0)

    it "REJECTS: real-time and noalloc roots through the shared indexed transitive graph":
        val m = ForbiddenIoContextManifest.new()
        m.register("rt_loop", true, false, false)
        m.set_callees("rt_loop", ["shared_helper"])
        m.register("noalloc_loop", false, false, true)
        m.set_callees("noalloc_loop", ["shared_helper"])
        m.set_callees("shared_helper", ["src/lib/common/aspect_pack.spl::apk_load_facet"])
        expect(check_forbidden_io_violations("rt_loop", m).len()).to_equal(1)
        expect(check_forbidden_io_violations("noalloc_loop", m).len()).to_equal(1)

    it "does not hang on a call-graph cycle that never reaches an acquisition fn":
        # @req REQ-SSPEC-COMPILER
        step("does not hang on a call-graph cycle that never reaches an acquisition fn")
        step("Verify: does not hang on a call-graph cycle that never reaches an acquisition fn")
        val m = ForbiddenIoContextManifest.new()
        m.register("isr_tick", false, true, false)
        m.set_callees("isr_tick", ["helper_a"])
        m.set_callees("helper_a", ["helper_b"])
        m.set_callees("helper_b", ["helper_a"])
        expect(check_forbidden_io_violations("isr_tick", m).len()).to_equal(0)

    it "rejects a non-vacuous 300-node chain without a depth fail-open":
        val m = ForbiddenIoContextManifest.new()
        m.register("long_root", false, true, false)
        m.set_callees("long_root", ["node_0"])
        var i = 0
        while i < 299:
            m.set_callees("node_{i}", ["node_{i + 1}"])
            i = i + 1
        m.set_callees("node_299", ["apk_load_facet"])
        val violations = check_forbidden_io_violations("long_root", m)
        expect(violations.len()).to_equal(1)
        expect(violations[0].kind).to_equal(ForbiddenIoViolationKind.TransitiveAcquire)

    it "terminates a cyclic diamond and emits exactly one diagnostic":
        val m = ForbiddenIoContextManifest.new()
        m.register("diamond_root", false, true, false)
        m.set_callees("diamond_root", ["left", "right", "left"])
        m.set_callees("left", ["join"])
        m.set_callees("right", ["join"])
        m.set_callees("join", ["left", "apk_load_facet"])
        val violations = check_forbidden_io_violations("diamond_root", m)
        expect(violations.len()).to_equal(1)
        expect(violations[0].detail).to_contain("apk_load_facet")

describe "check_all_forbidden_io_fns — bulk":
    it "collects violations only from tagged functions, across a mixed manifest":
        # @req REQ-SSPEC-COMPILER
        step("collects violations only from tagged functions, across a mixed manifest")
        step("Verify: collects violations only from tagged functions, across a mixed manifest")
        val m = ForbiddenIoContextManifest.new()
        m.register("isr_tick", false, true, false)
        m.set_callees("isr_tick", ["apk_load_facet"])
        m.register("plain_startup_fn", false, false, false)
        m.set_callees("plain_startup_fn", ["apk_load_facet"])
        m.register("rt_publisher", true, false, false)
        m.set_callees("rt_publisher", ["apk_try_facet"])
        val violations = check_all_forbidden_io_fns(m)
        expect(violations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(violations[0].fn_name).to_equal("isr_tick")

