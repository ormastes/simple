use std.spec.*
use compiler.semantics.lint.leading_operator.{
    check_leading_operator, check_leading_operator_lines}

describe "leading operator canonical line snapshot":
    it "matches the compatibility source API exactly":
        val source = "fn sample():\n    val x = 1\n    - 2\n\n    # gap\n    + 3\n"
        val from_source = check_leading_operator(source, "sample.spl")
        val from_lines = check_leading_operator_lines(
            source.split("\n"), "sample.spl")
        expect(from_lines.len()).to_equal(from_source.len())
        expect(from_lines.len()).to_equal(2)
        var index = 0
        while index < from_source.len():
            expect(from_lines[index].code).to_equal(from_source[index].code)
            expect(from_lines[index].severity).to_equal(
                from_source[index].severity)
            expect(from_lines[index].op).to_equal(from_source[index].op)
            expect(from_lines[index].line_num).to_equal(
                from_source[index].line_num)
            expect(from_lines[index].message).to_equal(
                from_source[index].message)
            expect(from_lines[index].note).to_equal(from_source[index].note)
            index = index + 1

    it "keeps docstrings and deeper continuations suppressed":
        val lines = [
            "fn sample():",
            "    val x = 1",
            "        - 2",
            "    \"\"\"",
            "    + prose",
            "    \"\"\"",
            "    return x"
        ]
        expect(check_leading_operator_lines(lines, "sample.spl").len()).to_equal(0)
