# Focused retained-cardinality evidence for the real compiler lint cache.
# @req REQC-AC6

use std.spec.*
use compiler.semantics.lint.lint_cache.{LintCache, lint_cache_store, lint_cache_invalidate_symbol}

describe "lint cache dependency retention":
    it "retains one dependency per distinct symbol":
        var cache = LintCache(entries: {}, symbol_index: {})
        var deps: [text] = []
        var i = 0
        while i < 1024:
            deps.push("SharedSymbol")
            i = i + 1

        lint_cache_store(cache, "src/example.spl::work", 7, [], deps)

        expect(cache.entries["src/example.spl::work"].symbol_deps.len()).to_equal(1)
        expect(cache.symbol_index["SharedSymbol"].len()).to_equal(1)
        lint_cache_invalidate_symbol(cache, "SharedSymbol")
        expect(cache.entries.has("src/example.spl::work")).to_equal(false)

    it "preserves first-seen order for distinct dependencies":
        var cache = LintCache(entries: {}, symbol_index: {})
        lint_cache_store(cache, "src/order.spl::work", 9, [], ["B", "A", "B", "C", "A"])
        val retained = cache.entries["src/order.spl::work"].symbol_deps
        expect(retained).to_equal(["B", "A", "C"])
