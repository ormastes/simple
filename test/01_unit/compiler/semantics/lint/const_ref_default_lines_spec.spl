use std.spec.*
use compiler.semantics.lint.const_ref_default.{
    check_const_ref_default, check_const_ref_default_lines}

describe "const reference canonical line snapshot":
    it "matches the compatibility source API exactly":
        val source = "fn update(items: [i64]):\n    items.push(1)\n"
        val from_source = check_const_ref_default(source, "sample.spl")
        val from_lines = check_const_ref_default_lines(
            source.split("\n"), "sample.spl")
        expect(from_lines.len()).to_equal(from_source.len())
        expect(from_lines.len()).to_equal(1)
        var index = 0
        while index < from_source.len():
            expect(from_lines[index].code).to_equal(from_source[index].code)
            expect(from_lines[index].param).to_equal(from_source[index].param)
            expect(from_lines[index].line_num).to_equal(
                from_source[index].line_num)
            expect(from_lines[index].message).to_equal(
                from_source[index].message)
            expect(from_lines[index].note).to_equal(from_source[index].note)
            index = index + 1

    it "keeps vendored sources excluded":
        val lines = ["fn update(items: [i64]):", "    items.push(1)"]
        expect(check_const_ref_default_lines(
            lines, "src/runtime/vendor/sample.spl").len()).to_equal(0)
        expect(check_const_ref_default_lines(
            lines, "src/compiler_rust/vendor/sample.spl").len()).to_equal(0)
