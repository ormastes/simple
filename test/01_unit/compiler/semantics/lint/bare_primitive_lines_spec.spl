use std.spec.*
use compiler.semantics.lint.bare_primitive_internal.{
    check_bare_primitive_internal, check_bare_primitive_internal_lines}

describe "bare primitive canonical line snapshot":
    it "matches the compatibility source API exactly":
        val source = "fn sample():\n    val count = 1\n    var ready: bool = compute()\n"
        val from_source = check_bare_primitive_internal(source, "src/app/sample.spl")
        val from_lines = check_bare_primitive_internal_lines(
            source.split("\n"), "src/app/sample.spl")
        expect(from_lines.len()).to_equal(from_source.len())
        expect(from_lines.len()).to_equal(2)
        var index = 0
        while index < from_source.len():
            expect(from_lines[index].code).to_equal(from_source[index].code)
            expect(from_lines[index].name).to_equal(from_source[index].name)
            expect(from_lines[index].line_num).to_equal(from_source[index].line_num)
            expect(from_lines[index].message).to_equal(from_source[index].message)
            expect(from_lines[index].note).to_equal(from_source[index].note)
            index = index + 1

    it "keeps both owned-code vendor exclusions":
        val lines = ["fn sample():", "    val count = 1"]
        expect(check_bare_primitive_internal_lines(
            lines, "src/runtime/vendor/sample.spl").len()).to_equal(0)
        expect(check_bare_primitive_internal_lines(
            lines, "src/compiler_rust/vendor/sample.spl").len()).to_equal(0)
