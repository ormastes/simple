use std.spec.*

var g_calls = 0

fn present_counter() -> i64?:
    g_calls = g_calls + 1
    Some(g_calls)

fn absent_counter() -> i64?:
    g_calls = g_calls + 1
    nil

describe "?? evaluates a stateful left operand exactly once":
    it "present operand: one call, no fallback":
        g_calls = 0
        val v = present_counter() ?? 99
        expect(g_calls).to_equal(1)
        expect(v).to_equal(1)
    it "absent operand: one call, fallback used":
        g_calls = 0
        val v = absent_counter() ?? 99
        expect(g_calls).to_equal(1)
        expect(v).to_equal(99)
    it "chained coalesce evaluates each operand once":
        g_calls = 0
        val v = absent_counter() ?? absent_counter() ?? 7
        expect(g_calls).to_equal(2)
        expect(v).to_equal(7)
