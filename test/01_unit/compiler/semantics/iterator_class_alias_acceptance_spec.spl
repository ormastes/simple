# Boundary regressions assert loss of unsupported exact facts and a real ledger
# record; zero diagnostics here is explicitly not full iterator-safety coverage.
describe "G7 unsupported alias transfer boundaries":
    it "should forget affected alias facts after unsupported while transfer":
        step("Parse and lower a real unsupported transfer followed by an iterator use")
        val source = "class Bag:\n    items: [i64]\n\nfn walk(flag: bool) -> i64:\n    var owner: Bag = Bag(items: [1, 2])\n    var other: Bag = Bag(items: [3])\n    var alias: Bag = owner\n    while flag:\n        alias = other\n    for x in other.items:\n        alias.items.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_boundary_while.spl", "boundary_while", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.classes.len()).to_equal(1)
        var lowering = HirLowering.with_filename("testdata/g7_boundary_while.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Require unsupported transfer evidence instead of an exact last-visited alias")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(errors.len()).to_equal(0)
        var boundary_records = 0
        for span in checker.context.place_unmodeled_sites:
            if span.line == 8 and span.col == 5:
                boundary_records = boundary_records + 1
                expect(span.file).to_equal("testdata/g7_boundary_while.spl")
        expect(boundary_records).to_equal(1)

    it "should forget affected alias facts after unsupported loop transfer":
        step("Parse and lower a real unsupported transfer followed by an iterator use")
        val source = "class Bag:\n    items: [i64]\n\nfn walk(flag: bool) -> i64:\n    var owner: Bag = Bag(items: [1, 2])\n    var other: Bag = Bag(items: [3])\n    var alias: Bag = owner\n    loop:\n        alias = other\n        break\n    for x in other.items:\n        alias.items.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_boundary_loop.spl", "boundary_loop", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.classes.len()).to_equal(1)
        var lowering = HirLowering.with_filename("testdata/g7_boundary_loop.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Require unsupported transfer evidence instead of an exact last-visited alias")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(errors.len()).to_equal(0)
        var boundary_records = 0
        for span in checker.context.place_unmodeled_sites:
            if span.line == 8 and span.col == 5:
                boundary_records = boundary_records + 1
                expect(span.file).to_equal("testdata/g7_boundary_loop.spl")
        expect(boundary_records).to_equal(1)

    it "should forget affected alias facts after unsupported match transfer":
        step("Parse and lower a real unsupported transfer followed by an iterator use")
        val source = "class Bag:\n    items: [i64]\n\nfn walk(flag: bool) -> i64:\n    var owner: Bag = Bag(items: [1, 2])\n    var other: Bag = Bag(items: [3])\n    var alias: Bag = owner\n    match flag:\n        case true:\n            alias = owner\n        case false:\n            alias = other\n    for x in other.items:\n        alias.items.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_boundary_match.spl", "boundary_match", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.classes.len()).to_equal(1)
        var lowering = HirLowering.with_filename("testdata/g7_boundary_match.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        step("Require unsupported transfer evidence instead of an exact last-visited alias")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(errors.len()).to_equal(0)
        var boundary_records = 0
        for span in checker.context.place_unmodeled_sites:
            if span.line == 8 and span.col == 5:
                boundary_records = boundary_records + 1
                expect(span.file).to_equal("testdata/g7_boundary_match.spl")
        expect(boundary_records).to_equal(1)

    it "should forget affected alias facts after unsupported for transfer":
        step("Parse and lower a real unsupported transfer followed by an iterator use")
        val source = "class Bag:\n    items: [i64]\n\nfn walk(flag: bool) -> i64:\n    var owner: Bag = Bag(items: [1, 2])\n    var other: Bag = Bag(items: [3])\n    var alias: Bag = owner\n    for y in owner.items:\n        alias = other\n    for x in other.items:\n        alias.items.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_boundary_for.spl", "boundary_for", Logger(level: 0))
        expect(parsed.functions.len()).to_equal(1)
        expect(parsed.classes.len()).to_equal(1)
        var lowering = HirLowering.with_filename("testdata/g7_boundary_for.spl")
