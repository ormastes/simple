        expect(lowering.errors.len()).to_equal(0)
        step("Require unsupported transfer evidence instead of an exact last-visited alias")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(errors.len()).to_equal(0)
        var boundary_records = 0
        for span in checker.context.place_unmodeled_sites:
            if span.line == 8 and span.col == 5:
                boundary_records = boundary_records + 1
                expect(span.file).to_equal("testdata/g7_boundary_for.spl")
        expect(boundary_records).to_equal(1)

