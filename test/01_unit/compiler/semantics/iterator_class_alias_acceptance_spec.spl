# codex-system-test
# @req REQ-MC-005 G7
# Test-first external packet; execution UNRUN.
use std.spec.*
use std.spec.step
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirTypeKind, HirModule}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_data.*
use compiler.semantics.safety_checker.{SafetyChecker, SafetyError, safetychecker_check_module}

fn assert_alias_e1048(errors: [SafetyError], count_expected: i64, line_expected: i64, col_expected: i64, file_expected: text):
    var count = 0
    for diagnostic in errors:
        match diagnostic:
            case Other(message, span):
                if message.starts_with("E1048:"):
                    count = count + 1
                    expect(span.line).to_equal(line_expected)
                    expect(span.col).to_equal(col_expected)
                    expect(span.file).to_equal(file_expected)
            case _: ()
    expect(count).to_equal(count_expected)
    expect(errors.len()).to_equal(count_expected)

describe "G7 typed class owner aliases":
    it "should enforce alias collection identity":
        step("Parse and lower a real typed class collection program")
        val source = "class Bag:\n    items: [i64]\n\nfn walk(flag: bool) -> i64:\n    var owner: Bag = Bag(items: [1, 2])\n    val alias: Bag = owner\n    for x in owner.items:\n        alias.items.push(x)\n    0\n"
        val parsed = parse_full_frontend(source, "testdata/g7_alias_alias.spl", "alias_alias", Logger(level: 0))
        expect(parsed.functions.contains("walk")).to_equal(true)
        expect(parsed.classes.len()).to_equal(1)
        var lowering = HirLowering.with_filename("testdata/g7_alias_alias.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        expect(hir.classes.len()).to_equal(1)
        for class_entry in hir.classes:
            expect(class_entry[1].fields.len()).to_equal(1)
            expect(class_entry[1].fields[0].name).to_equal("items")
            expect(class_entry[1].fields[0].symbol.id).to_be_greater_than(-1)
            val field_type = class_entry[1].fields[0].type_
            var collection_field = false
            match field_type.kind:
                case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_): collection_field = true
                case _: ()
            expect(collection_field).to_equal(true)
        step("Check production alias and captured iterable identity")
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(checker.context.place_owner_fields.len()).to_equal(1)
        for class_entry in hir.classes:
            val declared_fields = checker.context.place_owner_fields[class_entry[1].symbol.id]
            expect(declared_fields["items"].field_id).to_equal(class_entry[1].fields[0].symbol.id)
            expect(declared_fields["items"].is_collection).to_equal(true)
        assert_alias_e1048(errors, 1, 8, 9, "testdata/g7_alias_alias.spl")

