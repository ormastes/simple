use std.spec.*
use std.spec.step
use compiler.driver.driver_hir_pipeline_support.{driver_rt_criticality_errors}
use compiler.semantics.rt_criticality_validation.{validate_rt_criticality_diagnostics}
use compiler.frontend.rt_criticality_registry.{rt_criticality_reset, rt_criticality_declare}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirFunction, HirBlock}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}

fn rt_driver_fixture(path: text, id: i64, name: text) -> HirModule:
    val type_ = HirType(kind: HirTypeKind.Unit, span: Span.default())
    val fn_ = HirFunction(
        symbol: SymbolId(id: id), name: name, type_params: [], params: [],
        return_type: type_,
        body: HirBlock(stmts: [], has: true,
            value: HirExpr(kind: HirExprKind.UnitLit, has_type_: true,
                type_: type_, span: Span.default()), span: Span.default()),
        effects: [], visibility: Visibility.Public,
        is_async: false, is_static: false, is_public: true, is_method: false,
        is_mutable: false, is_const: false, is_extern: false, func_attr: FunctionAttr.default(),
        has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false, vhdl_metadata: nil,
        has_doc_comment: false, doc_comment: "", span: Span.default())
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[fn_.symbol] = fn_
    HirModule(name: "rt_driver_fixture", path: path, imports: [], exports: [],
        domain_blocks: [], symbols: SymbolTable.new(), functions: functions,
        classes: {}, structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [],
        constants: {}, static_asserts: [], aop_advices: [], di_bindings: [],
        arch_rules: [], mock_decls: [], types: [])

describe "RT criticality driver severity routing":
    it "routes a verified allocation to a fatal driver result even with a reason":
        # @req REQ-RT-OWNER-006
        step("Declare a verified allocation root with a supplied reason")
        val path = "synthetic/rt_driver_verified.spl"
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_verified", "verified,reason:\"stricter assurance\"")
        var modules: Dict<text, HirModule> = {}
        modules[path] = rt_driver_fixture(path, 901, "malloc_verified")
        step("Route the actual typed validator through the production driver helper")
        val errors = driver_rt_criticality_errors(modules)
        rt_criticality_reset()
        expect(errors.len()).to_equal(1)
        expect(errors[0]).to_contain("RT-E-UNBOUNDED-ALLOCATION")

    it "emits an explicit lower-tier warning without a fatal driver result":
        # @req REQ-RT-OWNER-007
        step("Declare an allocation root in the configured warning migration epoch")
        val path = "synthetic/rt_driver_warning.spl"
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_driver_warning", "robust,reason:\"lab shim\"")
        var modules: Dict<text, HirModule> = {}
        modules[path] = rt_driver_fixture(path, 902, "malloc_driver_warning")
        step("Keep the emitted warning separate from the fatal driver error result")
        val errors = driver_rt_criticality_errors(modules)
        rt_criticality_reset()
        expect(errors.len()).to_equal(0)

    it "retains separate diagnostics for two ambiguous declaration identities":
        # @req REQ-RT-OWNER-008
        step("Resolve two declarations against modules sharing the same path and name")
        val path = "synthetic/rt_ambiguous.spl"
        rt_criticality_reset()
        rt_criticality_declare(path, "malloc_tick", "critical")
        rt_criticality_declare("rt_driver_fixture", "malloc_tick", "critical")
        var modules: Dict<text, HirModule> = {}
        modules["alias_a"] = rt_driver_fixture(path, 903, "malloc_tick")
        modules["alias_b"] = rt_driver_fixture(path, 904, "malloc_tick")
        step("Preserve each unresolved claim key instead of deduplicating one sentinel")
        val diagnostics = validate_rt_criticality_diagnostics(modules)
        rt_criticality_reset()
        expect(diagnostics.len()).to_equal(2)
        val messages = diagnostics[0].message + "\n" + diagnostics[1].message
        expect(messages).to_contain("claim:synthetic/rt_ambiguous.spl|malloc_tick")
        expect(messages).to_contain("claim:rt_driver_fixture|malloc_tick")
