# @cover src/compiler/80.driver/driver_hir_pipeline_support.spl 5%
"""
Pins the driver half of the by-value struct cycle check: the three HIR
pipelines all go through `driver_validate_value_struct_layouts`, which is where
`SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE=warning` downgrades a cycle to a printed
warning. Default (unset) must stay a returned, fatal error.
doc/08_tracking/bug/recursive_struct_layout_typeinfo_2026-10-10.md
"""
use std.spec
use std.nogc_sync_mut.io.env_ops.{env_set}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirField, HirStruct}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable, SymbolKind}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind}
use compiler.semantics.value_struct_layout.{value_struct_layout_snapshot_v1}
use compiler.driver.driver_hir_pipeline_support.{driver_validate_value_struct_layouts}

fn sev_span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1, file: "", length: 0)

fn sev_self_cycle_module() -> HirModule:
    var table = SymbolTable.new()
    val node_sym = table.define("VslDriverNode", SymbolKind.Struct, nil, sev_span(), Visibility.Public, false, nil)
    val named = HirType(kind: HirTypeKind.Named(node_sym, []), span: sev_span())
    val no_default = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Int(64, true), span: sev_span()), span: sev_span())
    val me_field = HirField(
        symbol: SymbolId(id: 0), name: "me", type_: named, has_default: false, default: no_default,
        visibility: Visibility.Public, is_public: true, is_volatile: false, has_bits_attr: false,
        bits_width: 0, has_fixed_address: false, fixed_address: 0, span: sev_span())
    val node_struct = HirStruct(
        symbol: node_sym, name: "VslDriverNode", type_params: [], fields: [me_field],
        visibility: Visibility.Public, is_public: true, has_doc_comment: false, doc_comment: "",
        span: sev_span(), has_layout_attr: false,
        layout_attr: LayoutAttr(layout_kind: TypeLayoutKind.Simple, is_packed: false),
        has_platform_attr: false, platform_has_error: false, platform_has_warning: false,
        platform_diagnostic_message: "", platform_diagnostic_line: 0, is_generic_template: false,
        has_specialization_of: false, specialization_of: "", type_bindings: {})
    var structs: Dict<SymbolId, HirStruct> = {}
    structs[node_sym] = node_struct
    value_struct_layout_snapshot_v1("pkg.vsl_driver", "synthetic/vsl_driver.spl", structs, table)

describe "driver_validate_value_struct_layouts cycle severity":
    it "returns the cycle as a fatal error by default":
        # @req REQ-SEM-VSL-018
        step("Run the driver wrapper with the downgrade variable empty")
        env_set("SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE", "")
        val no_modules: Dict<text, HirModule> = {}
        val errors = driver_validate_value_struct_layouts(["pkg.vsl_driver"], [sev_self_cycle_module()], no_modules)
        expect(errors.len()).to_equal(1)  # oracle: 1 — default stays fatal
        expect(errors[0]).to_contain("recursive by-value struct layout: VslDriverNode.me -> VslDriverNode")

    it "returns no error when SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE=warning":
        # @req REQ-SEM-VSL-018
        step("Run the driver wrapper with the downgrade variable set, then restore it")
        env_set("SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE", "warning")
        val no_modules: Dict<text, HirModule> = {}
        val errors = driver_validate_value_struct_layouts(["pkg.vsl_driver"], [sev_self_cycle_module()], no_modules)
        env_set("SIMPLE_VALUE_STRUCT_LAYOUT_CYCLE", "")
        expect(errors.len()).to_equal(0)  # oracle: 0 — the cycle was printed as a warning, not returned
