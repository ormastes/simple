"""
## Purpose and audience
Purpose: Prove that E1047 param-mutability-semantic.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

#!/usr/bin/env simple
# E1047 param-mutability-semantic (lane G2).
#
# Semantic (typed-HIR) mirror of lint W-MC-REF-001
# (35.semantics/lint/const_ref_default.spl): flags reassignment of a
# non-`mut` parameter binding, and index-assign / known-mutating method
# calls on a non-`mut` VALUE-type (struct) parameter. Class-typed param
# mutation-through-reference (s19) and `me` receiver mutation are NOT
# flagged -- those are user-protected design decisions.
#
# HARNESS LANDMINE (documented in
# enum_match_unknown_variant_diagnostic_spec.spl's header): the
# parse_full_frontend -> HirLowering -> SafetyChecker pipeline is inlined in
# every `it` block below rather than factored into a shared helper fn --
# module-level helper fns have been observed to read back EMPTY error lists
# from a lowering/checker object created inside them, even though inline
# code in the `it` block sees the real list.

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.semantics.safety_checker.{SafetyChecker, SafetyError, safetychecker_check_module}

fn count_e1047(errors: [SafetyError]) -> i64:
    var n = 0
    for e in errors:
        match e:
            case Other(message, _):
                if message.starts_with("E1047"):
                    n = n + 1
            case _:
                pass
    n

describe "E1047 param-mutability-semantic":
    it "fires when a plain (non-mut) parameter is reassigned":
        step("Verify: fires when a plain (non-mut) parameter is reassigned")
        # @req: REQ-COMPILER-SEMANTICS-001
        # NOTE: `x = x + 1` deliberately avoided here -- it is not this
        # rule's target shape. The AST-level collection anti-pattern desugar
        # (10.frontend/desugar/collection_desugar.spl's `try_rewrite_assign`,
        # Pattern B) rewrites ANY `target = target + rhs` into
        # `target.merge(rhs)` with no type gate (pre-type-check AST pass),
        # so `x = x + 1` on a plain i64 param silently becomes
        # `x.merge(1)` -- a MethodCall, not an Assign -- before HIR lowering
        # ever sees it. That is a separate, out-of-scope compiler defect
        # (filed: doc/08_tracking/bug/collection_desugar_scalar_merge_rewrite_2026-07-29.md).
        # Plain reassignment (`x = 42`) is unaffected and exercises the real
        # Assign-target path E1047 targets.
        val src = "fn bump(x: i64) -> i64:\n" +
            "    x = 42\n" +
            "    x\n"
        val parsed = parse_full_frontend(src, "testdata/e1047_reassign.spl", "e1047_reassign", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/e1047_reassign.spl")
        val hir = hir_lowering.lower_module(parsed)
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_e1047(errors)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "is silent when the parameter is declared mut":
        step("Verify: is silent when the parameter is declared mut")
        val src = "fn bump(mut x: i64) -> i64:\n" +
            "    x = 42\n" +
            "    x\n"
        val parsed = parse_full_frontend(src, "testdata/e1047_mut_ok.spl", "e1047_mut_ok", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/e1047_mut_ok.spl")
        val hir = hir_lowering.lower_module(parsed)
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_e1047(errors)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "is silent for class-param field mutation (s19 protection)":
        step("Verify: is silent for class-param field mutation (s19 protection)")
        val src = "class Counter:\n" +
            "    n: i64\n" +
            "\n" +
            "fn touch(c: Counter):\n" +
            "    c.n = c.n + 1\n"
        val parsed = parse_full_frontend(src, "testdata/e1047_class_field.spl", "e1047_class_field", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/e1047_class_field.spl")
        val hir = hir_lowering.lower_module(parsed)
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_e1047(errors)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "is silent for a me method mutating self":
        step("Verify: is silent for a me method mutating self")
        # NOTE: uses `struct` + `impl` (not an inline `class` method body) --
        # HirClass.methods only carries method-name -> SymbolId, never the
        # HirFunction body itself (declaration_lowering.spl's lower_class
        # discards `hir_fn`, keeping only `hir_fn.symbol`), so a
        # class-embedded method body is unreachable from HirModule and
        # SafetyChecker cannot walk it (fixed the resulting crash in
        # safetychecker_check_module, but the gap itself is a separate,
        # out-of-scope architectural TODO). `impl` method bodies ARE
        # reachable (merged into module.functions via
        # self.lowered_impl_functions), so this exercises the real E1047
        # `me`-receiver exclusion end to end.
        val src = "struct Counter:\n" +
            "    n: i64\n" +
            "\n" +
            "impl Counter:\n" +
            "    me bump():\n" +
            "        self.n = self.n + 1\n"
        val parsed = parse_full_frontend(src, "testdata/e1047_me_self.spl", "e1047_me_self", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("testdata/e1047_me_self.spl")
        val hir = hir_lowering.lower_module(parsed)
        val checker = SafetyChecker.create()
        val errors = safetychecker_check_module(checker, hir)
        expect(count_e1047(errors)).to_equal(0)  # oracle: 0 — named expected value from the requirement
