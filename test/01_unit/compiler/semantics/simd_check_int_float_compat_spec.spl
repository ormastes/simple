use std.spec.*
use compiler.semantics.simd_check.{
    SimdElementType, SimdVectorType, SimdOperation, SimdTypeChecker
}

describe "simd vector type compatibility":
    it "does not treat an int vector and a float vector of the same width as compatible":
        val i32x4 = SimdVectorType.create(SimdElementType.I32, 4)
        val f32x4 = SimdVectorType.create(SimdElementType.F32, 4)
        expect(i32x4.is_compatible_with(f32x4)).to_equal(false)

    it "rejects a binary op mixing int and float vectors of the same width":
        val i32x4 = SimdVectorType.create(SimdElementType.I32, 4)
        val f32x4 = SimdVectorType.create(SimdElementType.F32, 4)
        var checker = SimdTypeChecker.for_avx()
        val ok = checker.check_binary_op(SimdOperation.Add, i32x4, f32x4)
        expect(ok).to_equal(false)
