"""
## Purpose and audience
Purpose: Prove that noalloc family manifest — allocator submodule regression (WP-11).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

# Regression spec for WP-11:
# doc/08_tracking/bug/noalloc_family_manifest_prefix_match_exempts_its_own_allocators_2026-08-07.md
#
# `src/lib/nogc_async_mut_noalloc/__init__.spl` publicly exports real
# sub-allocators (mimalloc_alloc/free, BumpAllocator/FreeListAllocator/
# heap_init) from submodules of the "no heap allocation"
# nogc_async_mut_noalloc family. Before the fix, `RUNTIME_FAMILY_MANIFEST`
# classified the whole family — including those allocator submodules — as
# `allocates: false` via prefix matching, so a `@noalloc` function calling
# `mimalloc_alloc` could never trip the checker's FamilyImport rejection.
#
# WP-13 (the library-side half of this defect) audited what each submodule
# actually does at the pointer level:
#   - baremetal/allocator.spl (BumpAllocator etc) and mimalloc.spl DO
#     sub-allocate within a caller-supplied (base, size) region — real
#     allocation for @noalloc purposes, so they get allocates: true.
#   - memory/refc_binary.spl's SharedHeap.allocate() returns a logical
#     BinaryRef{id, offset, len} computed from counters and allocates
#     nothing — it stays allocates: false. Marking it allocating would be a
#     false positive, which this spec also guards against.
#
# This spec drives the REAL compiler modules (not a local replica) so it
# proves the actual behaviour, not a mirrored assumption of it.

use std.spec.*
use compiler.semantics.noalloc_checker.{NoallocCapabilityManifest, check_noalloc_violations, NoallocViolationKind}

describe "noalloc family manifest — allocator submodule regression (WP-11)":
    it "REJECTS a @noalloc fn calling mimalloc_alloc (was silently ACCEPTED before the fix)":
        step("Verify: REJECTS a @noalloc fn calling mimalloc_alloc (was silently ACCEPTED before the fix)")
        # @req: REQ-COMPILER-SEMANTICS-001
        val m = NoallocCapabilityManifest.new()
        # mimalloc_alloc is registered the way the real driver would: not
        # itself flagged allocating by alloc_inference (it's a leaf runtime
        # primitive), but its family_module is the mimalloc submodule that
        # actually performs the allocation.
        m.register("mimalloc_alloc", false, false, "std.nogc_async_mut_noalloc.mimalloc")

        val violations = check_noalloc_violations("boot_alloc", [], ["mimalloc_alloc"], m)

        expect(violations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(violations[0].kind).to_equal(NoallocViolationKind.FamilyImport)
        expect(violations[0].detail).to_contain("mimalloc_alloc")
        expect(violations[0].detail).to_contain("allocating family")

    it "REJECTS a @noalloc fn calling into baremetal's BumpAllocator/heap_init submodule (allocator.spl)":
        step("Verify: REJECTS a @noalloc fn calling into baremetal's BumpAllocator/heap_init submodule (allocator.spl)")
        val m = NoallocCapabilityManifest.new()
        m.register("heap_init", false, false, "std.nogc_async_mut_noalloc.baremetal.allocator")

        val violations = check_noalloc_violations("boot_alloc3", [], ["heap_init"], m)

        expect(violations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(violations[0].kind).to_equal(NoallocViolationKind.FamilyImport)

    it "still ACCEPTS a @noalloc fn calling into genuinely allocation-free noalloc submodules":
        step("Verify: still ACCEPTS a @noalloc fn calling into genuinely allocation-free noalloc submodules")
        val m = NoallocCapabilityManifest.new()
        m.register("bm_str_len", false, false, "std.nogc_async_mut_noalloc.string")
        m.register("crc32_bytes", false, false, "std.nogc_async_mut_noalloc.hash")

        val violations = check_noalloc_violations("boot_clean", [], ["bm_str_len", "crc32_bytes"], m)

        expect(violations.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "does NOT flag SharedHeap's memory submodule — it returns logical BinaryRefs, not a memory address (false-positive guard)":
        step("Verify: does NOT flag SharedHeap's memory submodule — it returns logical BinaryRefs, not a memory address (false-positive guard)")
        # WP-13's first pass called `memory` "arena-bound" and retracted that
        # as an overclaim. A false positive here (blocking a legitimately
        # allocation-free call) is as damaging to the @noalloc guarantee as
        # the false negative this bug fixes, so this must stay accepted.
        val m = NoallocCapabilityManifest.new()
        m.register("shared_heap_alloc", false, false, "std.nogc_async_mut_noalloc.memory")

        val violations = check_noalloc_violations("boot_shared_heap", [], ["shared_heap_alloc"], m)

        expect(violations.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
