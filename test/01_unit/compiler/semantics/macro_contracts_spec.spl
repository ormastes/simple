# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

"""
## Purpose and audience

Purpose: pin that `process_macro_contract` RECORDS what an `inject` contract
item declares. The Rust->Simple port computed the anchor and then rebuilt the
result copying every field from itself, so `inject_labels` and `injections`
came back empty and a macro's inject contract was invisible to IDE completion.
Audience: compiler semantics engineers.

Assertions go through `macro_contract_inject_digest` rather than reading the
result's fields directly: a struct-field read from an `it` block is lowered
into the wrapped spec's `main`, which the compiled (whole-directory) lane
rejects with "cannot infer field type", losing the entire file.

## Operator workflow

`bin/simple test test/01_unit/compiler/semantics/macro_contracts_spec.spl`
"""

use std.spec.{describe, it, expect}
use compiler.35.semantics.macro_contracts.{
    process_macro_contract,
    macro_contract_item_inject,
    macro_contract_inject_digest,
    symbolscope_empty,
    macrocontractresult_empty
}

fn _digest(items) -> text:
    val r = process_macro_contract(items, {}, symbolscope_empty())
    match r:
        case Ok(v): macro_contract_inject_digest(v)
        case _: macro_contract_inject_digest(macrocontractresult_empty())

describe "process_macro_contract — inject contract items":

    context "a single head injection":
        it "records the label and its anchor":
            expect(_digest([macro_contract_item_inject("head", "body")])).to_equal("labels=1;buckets=1;body=head")

        it "records exactly one label":
            expect(_digest([macro_contract_item_inject("head", "body")]).contains("labels=1")).to_equal(true)

        it "seeds exactly one injections bucket":
            expect(_digest([macro_contract_item_inject("head", "body")]).contains("buckets=1")).to_equal(true)

    context "tail and callsite anchors":
        it "maps 'tail' to the Tail anchor":
            expect(_digest([macro_contract_item_inject("tail", "after")])).to_equal("labels=1;buckets=1;after=tail")

        it "maps an unknown anchor word to Here":
            expect(_digest([macro_contract_item_inject("somewhere", "mid")])).to_equal("labels=1;buckets=1;mid=here")

        it "seeds a distinct bucket per anchor":
            val d = _digest([macro_contract_item_inject("head", "a"), macro_contract_item_inject("tail", "b")])
            expect(d.contains("buckets=2")).to_equal(true)

    context "several injections":
        it "records every label":
            val d = _digest([
                macro_contract_item_inject("head", "a"),
                macro_contract_item_inject("tail", "b"),
                macro_contract_item_inject("here", "c")
            ])
            expect(d.contains("labels=3")).to_equal(true)

        it "shares one bucket for two labels on the same anchor":
            val d = _digest([macro_contract_item_inject("head", "a"), macro_contract_item_inject("head", "b")])
            expect(d.contains("labels=2")).to_equal(true)
            expect(d.contains("buckets=1")).to_equal(true)

    context "contracts with no inject item":
        it "records no labels and no buckets":
            expect(_digest([])).to_equal("labels=0;buckets=0")
