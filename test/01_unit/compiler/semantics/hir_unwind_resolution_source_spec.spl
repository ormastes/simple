# @cover src/compiler/35.semantics/resolve.spl
# @cover src/compiler/35.semantics/resolve_strategies.spl
# @cover src/compiler/25.traits/associated_types.spl

extern fn rt_file_read_text(path: text) -> text

use std.spec.*

describe "Resolved callable unwind metadata":
    it "keeps complete typed function values through symbol and method resolution":
        val resolve = rt_file_read_text(
            "src/compiler/35.semantics/resolve.spl") ?? ""
        val strategies = rt_file_read_text(
            "src/compiler/35.semantics/resolve_strategies.spl") ?? ""
        expect(resolve).to_contain("return symbol_type")
        expect(strategies).to_contain("val resolved_func_type = func_type")
        expect(strategies).to_contain("case Function(params, _, _)")

    it "preserves effects while normalizing associated function types":
        val source = rt_file_read_text(
            "src/compiler/25.traits/associated_types.spl") ?? ""
        expect(source).to_contain("case Function(params, ret, effects)")
        expect(source).to_contain("effects: effects")
