"""
## Purpose and audience
Purpose: Prove that C3 @advice reaches the real logical join-point model.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

# C3 end-to-end: `@advice(KIND, SELECTOR)` parsed from REAL SOURCE reaches the
# real logical join-point model and produces real diagnostics.
#
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (C3)
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (M5 = C3)
#
# WHY THIS SPEC EXISTS / WHAT IT WOULD CATCH:
# The failure mode C1 and C4 both lived in for months was "checker green on
# hand-built fixtures, unenforced on the tree". Every example below starts from
# SOURCE TEXT containing the attribute and goes through the real
# parser -> flat-AST bridge -> HIR lowering -> validate_aspect_contracts path,
# so none of them can pass if the attribute does not parse, if nothing records
# it, or if nothing calls the validator.
#
# Concretely, each example fails (not passes) under these wrong behaviors:
#   * "@advice parses but records nothing" / "is silently swallowed as an
#     unknown decorator" (the PRE-C3 behaviour: enum_module_body.spl's trailing
#     `else: pass_dn`)
#       -> ex.1 sees 0 advice in the registry and fails.
#   * "the validator is never called on real source"
#       -> ex.2/3/4/5/6 expect REJECTIONS; an unwired validator returns no
#          diagnostic and every one of them fails.
#   * "an unknown kind is silently ignored" (the classic disabled-check typo)
#       -> ex.3 fails.
#   * "per-pixel join points are accepted" (the plan forbids them outright)
#       -> ex.4 fails.
#   * "the three advice obligations are assumed rather than required"
#       -> ex.5 fails.
#   * "dynload/live_reload are silently downgraded to static weave"
#       -> ex.6 fails.
#   * "an unmeasurable kind is reported as a clean pass, or as a plain
#     not-found" -- the exact fail-open this lane must not have
#       -> ex.7 fails (it asserts the word UNMEASURED is in the diagnostic).
#   * "the forward join-point universe is a stub returning []" or "every
#     function is treated as a forwarder"
#       -> ex.2 and ex.8 disagree in opposite directions; both fail.
#   * "the attribute changes the decorated function's representation"
#       -> ex.9 would see the advice fn missing or renamed, and fails.

use std.spec.{describe, it, expect}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.aspect_registry.{aspect_registry_claim_keys, aspect_claim_key}
use compiler.frontend.aspect_registry.{aspect_registry_kind_of_key, aspect_registry_selector_of_key}
use compiler.frontend.aspect_registry.{aspect_registry_mode_of_key}
use compiler.frontend.aspect_registry.{aspect_registry_readonly_of_key, aspect_registry_noalloc_of_key}
use compiler.frontend.aspect_registry.{aspect_registry_bounded_time_of_key}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.semantics.aspect_validation.{validate_aspect_contracts}
use compiler.semantics.join_point_model.{forward_join_points, join_points_matching}
use compiler.semantics.join_point_model.{JoinPoint}
use compiler.semantics.join_point_model.{join_point_kinds, join_point_kind_is_measurable}
use compiler.semantics.join_point_model.{join_point_kind_is_prohibited, join_point_mode_is_implemented}
use compiler.common.config.{Logger}

fn adv_logger() -> Logger:
    Logger(level: 0)

# Parse + lower one source string, then run the production C3 validation over
# the resulting HIR. Returns the diagnostics list (empty = every advice proven).
fn adv_diagnostics(src: text, path: text) -> [text]:
    val module = parse_full_frontend(src, path, "adv_probe", adv_logger())
    var lowering = HirLowering.with_filename(path)
    val hir = lowering.lower_module(module)
    validate_aspect_contracts({"adv_probe": hir})

fn adv_forward_points(src: text, path: text) -> i64:
    val module = parse_full_frontend(src, path, "adv_probe", adv_logger())
    var lowering = HirLowering.with_filename(path)
    val hir = lowering.lower_module(module)
    forward_join_points({"adv_probe": hir}).len()

fn adv_has(path: text, fn_name: text) -> bool:
    aspect_registry_claim_keys().contains(aspect_claim_key(path, fn_name))

# --- sources -----------------------------------------------------------------

# The advice obligations, spelled out once. Every source below that expects to
# get PAST the obligation check carries all three.
val OBLIGATIONS = "@readonly\n@noalloc\n@bounded_time\n"

# `submit_view` is a business-logic-free forwarder: its whole body is one
# delegating call, so it IS a logical forward join point.
val FORWARDER = "fn submit_impl(n: i64) -> i64:\n    n + 1\n\nfn submit_view(n: i64) -> i64:\n    submit_impl(n)\n"

# CLEAN: advice on a real forward join point, all three obligations declared.
val SRC_OK = FORWARDER + "\n@advice(forward, submit_view)\n" + OBLIGATIONS + "fn trace_submit():\n    pass_dn\n"

# VIOLATION: the selector names a function that does REAL WORK, so it is not a
# logical forward edge and there is nothing for the advice to observe.
val SRC_NO_MATCH = FORWARDER + "\n@advice(forward, submit_impl)\n" + OBLIGATIONS + "fn trace_missing():\n    pass_dn\n"

# VIOLATION: an unknown kind. A typo here must be an error, never a quietly
# disabled aspect.
val SRC_BAD_KIND = FORWARDER + "\n@advice(forwrad, submit_view)\n" + OBLIGATIONS + "fn trace_typo():\n    pass_dn\n"

# VIOLATION: a prohibited per-element join point.
val SRC_PROHIBITED = FORWARDER + "\n@advice(pixel, submit_view)\n" + OBLIGATIONS + "fn trace_pixel():\n    pass_dn\n"

# VIOLATION: obligations missing (only @readonly declared).
val SRC_MISSING_OBLIGATIONS = FORWARDER + "\n@advice(forward, submit_view)\n@readonly\nfn trace_partial():\n    pass_dn\n"

# VIOLATION: a mode this slice does not implement. Must be REJECTED, not
# silently downgraded to static weave.
val SRC_LIVE_RELOAD = FORWARDER + "\n@advice(forward, submit_view, live_reload)\n" + OBLIGATIONS + "fn trace_live():\n    pass_dn\n"

# UNMEASURED: a legitimate C3 kind that nothing on this tree emits.
val SRC_UNMEASURED = FORWARDER + "\n@advice(scene_commit, submit_view)\n" + OBLIGATIONS + "fn trace_commit():\n    pass_dn\n"

# OPT-IN: no advice anywhere -> nothing is checked.
val SRC_UNANNOTATED = FORWARDER

describe "C3 @advice reaches the real logical join-point model":

    it "retains matching join-point payloads under value semantics":
        step("Verify: retains matching join-point payloads under value semantics")
        # @req: REQ-COMPILER-SEMANTICS-001
        val points = [JoinPoint(kind: "forward", source_symbol: "submit_view",
            target_symbol: "submit_impl", logical_join_point_id: 7)]
        val matches = join_points_matching(points, "forward", "submit_view")
        expect(matches.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(matches[0].logical_join_point_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(join_points_matching(points, "forward", "missing").len()).to_equal(0)

    it "records advice from real source and proves a real forward join point":
        step("Verify: records advice from real source and proves a real forward join point")
        val diags = adv_diagnostics(SRC_OK, "adv_ok.spl")
        # The attribute actually parsed and recorded advice: this is the
        # assertion that is FALSE today-without-the-attribute-path (an unknown
        # decorator is silently swallowed, so the registry stays empty).
        expect(adv_has("adv_ok.spl", "trace_submit")).to_equal(true)
        val key = aspect_claim_key("adv_ok.spl", "trace_submit")
        expect(aspect_registry_kind_of_key(key)).to_equal("forward")
        expect(aspect_registry_selector_of_key(key)).to_equal("submit_view")
        # Unspecified mode normalises to static, the only implemented mode.
        expect(aspect_registry_mode_of_key(key)).to_equal("static")
        expect(aspect_registry_readonly_of_key(key)).to_equal(true)
        expect(aspect_registry_noalloc_of_key(key)).to_equal(true)
        expect(aspect_registry_bounded_time_of_key(key)).to_equal(true)
        # ...and the real validator ran against the real join-point universe.
        expect(diags.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects a selector that names a function doing real work":
        step("Verify: rejects a selector that names a function doing real work")
        val diags = adv_diagnostics(SRC_NO_MATCH, "adv_nomatch.spl")
        expect(diags.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(diags[0].contains("error[aspect]")).to_equal(true)
        expect(diags[0].contains("no such logical join point")).to_equal(true)
        expect(diags[0].contains("trace_missing")).to_equal(true)

    it "rejects an unknown join-point kind instead of disabling the check":
        step("Verify: rejects an unknown join-point kind instead of disabling the check")
        val diags = adv_diagnostics(SRC_BAD_KIND, "adv_typo.spl")
        expect(diags.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(diags[0].contains("unknown join-point kind")).to_equal(true)
        expect(diags[0].contains("forwrad")).to_equal(true)

    it "rejects a per-element join point with the prohibition as the reason":
        step("Verify: rejects a per-element join point with the prohibition as the reason")
        val diags = adv_diagnostics(SRC_PROHIBITED, "adv_pixel.spl")
        expect(diags.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        # Distinct from "unknown kind": the plan forbids these by design, so
        # the message must not invite the author to fix a spelling.
        expect(diags[0].contains("prohibited")).to_equal(true)
        expect(diags[0].contains("unknown join-point kind")).to_equal(false)
        expect(join_point_kind_is_prohibited("pixel")).to_equal(true)
        expect(join_point_kind_is_prohibited("glyph")).to_equal(true)
        expect(join_point_kind_is_prohibited("span")).to_equal(true)
        expect(join_point_kind_is_prohibited("tile")).to_equal(true)

    it "requires @readonly @noalloc @bounded_time on advice":
        step("Verify: requires @readonly @noalloc @bounded_time on advice")
        val diags = adv_diagnostics(SRC_MISSING_OBLIGATIONS, "adv_oblig.spl")
        expect(diags.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(diags[0].contains("must declare @readonly @noalloc @bounded_time")).to_equal(true)
        # The two absent ones are named; the declared one is not.
        expect(diags[0].contains("@noalloc")).to_equal(true)
        expect(diags[0].contains("@bounded_time")).to_equal(true)

    it "rejects an unimplemented weave mode rather than downgrading it":
        step("Verify: rejects an unimplemented weave mode rather than downgrading it")
        val diags = adv_diagnostics(SRC_LIVE_RELOAD, "adv_live.spl")
        expect(diags.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(diags[0].contains("live_reload")).to_equal(true)
        expect(diags[0].contains("not implemented in this slice")).to_equal(true)
        expect(join_point_mode_is_implemented("static")).to_equal(true)
        expect(join_point_mode_is_implemented("dynload")).to_equal(false)
        expect(join_point_mode_is_implemented("live_reload")).to_equal(false)

    it "reports an unemitted join-point kind as UNMEASURED, not as absent":
        step("Verify: reports an unemitted join-point kind as UNMEASURED, not as absent")
        val diags = adv_diagnostics(SRC_UNMEASURED, "adv_unmeasured.spl")
        expect(diags.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(diags[0].contains("UNMEASURED")).to_equal(true)
        # It must NOT be reported with the not-found wording, which would be a
        # claim about the SOURCE when the truth is a claim about the COMPILER.
        expect(diags[0].contains("no such logical join point")).to_equal(false)
        # Six of the seven kinds are unmeasurable today; exactly one is not.
        var measurable = 0
        for k in join_point_kinds():
            if join_point_kind_is_measurable(k):
                measurable = measurable + 1
        expect(join_point_kinds().len()).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(measurable).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "enumerates exactly the forwarders, not every function":
        step("Verify: enumerates exactly the forwarders, not every function")
        # `submit_view` forwards; `submit_impl` computes. A stub returning []
        # gives 0 here; treating every function as a forwarder gives 2.
        expect(adv_forward_points(FORWARDER, "adv_enum.spl")).to_equal(1)

    it "does not check anything when no advice is declared (opt-in)":
        step("Verify: does not check anything when no advice is declared (opt-in)")
        val diags = adv_diagnostics(SRC_UNANNOTATED, "adv_optin.spl")
        expect(diags.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "leaves the advice function itself an ordinary function":
        step("Verify: leaves the advice function itself an ordinary function")
        # @advice adds a proof obligation, never a behaviour or representation
        # change -- the same contract @layer_eq and @copy_budget hold to.
        val module = parse_full_frontend(SRC_OK, "adv_shape.spl", "adv_probe", adv_logger())
        expect(module.functions.contains("trace_submit")).to_equal(true)
        expect(module.functions.contains("submit_view")).to_equal(true)
