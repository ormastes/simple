use std.test.*
use compiler.semantics.rt_criticality.*
use std.common.crypto.sha256.{sha256_text}

# Frozen pre-change ordering oracle; intentionally quadratic for small fixtures.
fn legacy_rt_sort(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var at = out.len()
        var i = 0
        while i < out.len():
            if item < out[i]:
                at = i
                break
            i = i + 1
        out.push(item)
        var j = out.len() - 1
        while j > at:
            out[j] = out[j - 1]
            j = j - 1
        out[at] = item
    out

describe "RT canonical sorting preserves the admitted digest contract":
    it "matches legacy ordering for empty, equal, odd, prefix and Unicode inputs":
        val fixtures: [[text]] = [[], [""], ["same", "same", "same"],
            ["a", "aa", "b", "z"], ["z", "b", "aa", "a"],
            ["é", "e", "한", "😀", "", "a", "aa", "a", "-1", "+1"]]
        for items in fixtures:
            var original: [text] = []
            for item in items: original.push(item)
            expect(rt_sort_text(items)).to_equal(legacy_rt_sort(items))
            expect(items).to_equal(original)

    it "merges a large odd reverse input retaining every duplicate":
        var items: [text] = []
        var expected: [text] = []
        var i = 0
        while i < 1024:
            items.push("z")
            expected.push("a")
            i = i + 1
        items.push("m")
        expected.push("m")
        i = 0
        while i < 1024:
            items.push("a")
            expected.push("z")
            i = i + 1
        expect(rt_sort_text(items)).to_equal(expected)
        expect(items[0]).to_equal("z")
        expect(items[2048]).to_equal("a")

    it "preserves exact RT-CLOSURE-V1 bytes and reviewed capability identity":
        var units: Dict<i64, i64> = {}
        units[RT_EFFECT_BLOCKING] = 1
        val root = RtCriticalFact(name: "irq", own_effects: RT_EFFECT_BLOCKING,
            bounded_effects: 0, callees: ["z", "a", "a"], line: 1,
            effect_units: units)
        val a = RtCriticalFact(name: "a", own_effects: 0,
            bounded_effects: 0, callees: [], line: 2)
        val z = RtCriticalFact(name: "z", own_effects: 0,
            bounded_effects: 0, callees: [], line: 3)
        val expected = sha256_text("RT-CLOSURE-V1\nirq\na|0||\nirq|2|2:1|a,a,z\nz|0||")
        expect(rt_closure_digest("irq", [z, root, a])).to_equal(expected)
        expect(rt_closure_digest("irq", [a, z, root])).to_equal(expected)
        val authority = [RtBoundCapability(subject_id: "irq", closure_digest: expected,
            effect: RT_EFFECT_BLOCKING, max_units: 1, review_id: "SORT-REGRESSION")]
        expect(rt_reviewed_bound_mask("irq", rt_closure_digest("irq", [root, a, z]), units, authority)).to_equal(RT_EFFECT_BLOCKING)
        expect(rt_reviewed_bound_mask("irq", rt_closure_digest("other", [root, a, z]), units, authority)).to_equal(0)
