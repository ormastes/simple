"""
## Purpose and audience
Purpose: Prove that parallel boundary transfer classification.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

#!/usr/bin/env simple
# WP-11 compiler-owned execution-boundary transfer classification.
#
# Phase-1 scoping in
# doc/01_research/language/simple_vs_rust_safety_property_audit_2026-07-28.md
# (G8 "Transfer/Share structural capabilities") found NO distinguishable
# "spawn site" or "actor message send" node at HIR level: the parser's
# dedicated `ExprKind.Spawn` AST node has zero callers (dead code), actors
# have no representation in the type system at all, and `HirExpr.type_` is
# always nil (no per-expression inferred type available to a HIR pass). See
# the full block comment above `safetychecker_check_transfer_module` in
# `35.semantics/safety_checker.spl` for the complete evidence trail.
#
# The reachable integration slice is a bare parameter reference passed
# DIRECTLY as an argument to a call to a function literally named `spawn`.
# Its declared HIR type is classified as copy, frozen share, isolated move,
# runtime-classified, or rejected, with profile-sensitive ownership policy.
# `spawn` is identified
# by callee-name string match, the same precedent already used
# independently by `30.types/type_system/checker.spl`,
# `builtin_registry.spl`, and `50.mir/mir_effects.spl`.
#
# ## Why this spec hand-builds HIR instead of parsing `spawn(...)` source
# text (mirrors `test/01_unit/compiler/borrow/iso_move_pipeline_spec.spl`'s
# own justification for the identical technique on a different pre-existing
# gap)
#
# `spawn` lexes as the reserved `KwSpawn` token
# (`10.frontend/lexer_types.spl:60`), never `TOK_IDENT`. On THIS seed binary
# (`bin/simple` currently resolves to `bin/release/x86_64-unknown-linux-gnu/
# simple`, the Rust-built bootstrap seed, not the pure-Simple self-hosted
# tool -- confirmed via `bin/simple --version`'s own seed warning), a
# `spawn(...)` CALL EXPRESSION -- not just a `fn spawn(...)` declaration,
# which is a hard parse error for the same reason -- silently lowers to
# `HirExprKind.NilLit`, discarding the callee AND every argument, with ZERO
# diagnostic recorded anywhere (`hir_lowering.errors.len()` stays 0).
# Root-caused (see `doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md`
# for the full repro trail) to `10.frontend/_FlatAstBridge/convert_nodes.spl`
# -- "the bootstrap-safe frontend path when the newer parser surface is
# unavailable" per that file's own header -- which already has this EXACT
# failure mode independently rediscovered and individually patched at
# several other sites in the same file (its own comments: "Bug (array/
# string slice-index silently -> NilLit -> SIGSEGV)", "discarding every
# statement", "the deferred statement's effect [lost]"); `spawn` is simply
# one more never-yet-patched instance of that same generic "unhandled node
# kind -> silent NilLit" fallback. This is upstream of HIR/SafetyChecker
# entirely and out of this lane's ownership scope (parser/bridge layer, not
# `35.semantics/`).
#
# To prove E1049's OWN mechanism -- that a `Call` node with a `spawn`-named
# `NamedVar` callee and a bare non-iso class-typed `NamedVar` argument is
# correctly flagged, and that `iso`/fresh-construction/non-class/wrong-callee
# variants are correctly silent -- this spec hand-builds the HIR module
# directly, exactly like `iso_move_pipeline_spec.spl` does to isolate its own
# HIR/MIR-side correctness from that same class of parser-layer gap.
#
# HARNESS LANDMINE (documented in
# enum_match_unknown_variant_diagnostic_spec.spl's header, and reused
# verbatim by param_mutability_semantic_spec.spl): the checker-invocation
# pipeline is inlined in every `it` block below rather than factored into a
# shared helper fn -- module-level helper fns have been observed to read
# back EMPTY error lists from a checker object created inside them, even
# though inline code in the `it` block sees the real list.

use std.spec
use compiler.hir.hir_definitions.{
    HirFunction, HirParam, HirBlock, HirStmt, HirStmtKind, HirExpr, HirExprKind,
    HirClass, HirField, HirStruct, HirCallArg
}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind}
use compiler.common.attributes.{FunctionAttr, ExportAttr}
use compiler.semantics.safety_checker.{SafetyChecker, SafetyError, safetychecker_check_module, safetychecker_check_transfer_module}
use compiler.semantics.boundary_transfer.{
    HirExecutionBoundary, HirRegionOrigin,
    classify_hir_boundary_transfer
}
use compiler.common.parallel_policy.policy_schema.{ResolvedParallelPolicyV1}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}

fn mk_span(line: i64) -> Span:
    Span(start: 0, end: 0, line: line, col: 1, file: "synthetic", length: 0)

fn i64_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: mk_span(0))

fn named_type(sym: SymbolId) -> HirType:
    HirType(kind: HirTypeKind.Named(sym, []), span: mk_span(0))

fn iso_named_type(sym: SymbolId) -> HirType:
    HirType(kind: HirTypeKind.Isolated(named_type(sym)), span: mk_span(0))

fn nil_expr() -> HirExpr:
    HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: i64_type(), span: mk_span(0))

fn named_var(sym: SymbolId, name: text, line: i64) -> HirExpr:
    HirExpr(kind: HirExprKind.NamedVar(sym, name), has_type_: true, type_: i64_type(), span: mk_span(line))

fn call_arg(value: HirExpr, line: i64) -> HirCallArg:
    HirCallArg(has_name: false, name: "", value: value, span: mk_span(line))

# `spawn(<arg_expr>)` as a bare statement -- the real shape a compiling
# frontend would produce (see the module docstring): a single
# `HirStmtKind.Expr` wrapping `HirExprKind.Call`, not a tail block value.
fn spawn_call_stmt(spawn_sym: SymbolId, arg_expr: HirExpr, line: i64) -> HirStmt:
    val callee = named_var(spawn_sym, "spawn", line)
    val call = HirExpr(
        kind: HirExprKind.Call(callee, [call_arg(arg_expr, line)], []),
        has_type_: true,
        type_: i64_type(),
        span: mk_span(line)
    )
    HirStmt(kind: HirStmtKind.Expr(call), span: mk_span(line))

fn not_spawn_call_stmt(callee_sym: SymbolId, callee_name: text, arg_expr: HirExpr, line: i64) -> HirStmt:
    val callee = named_var(callee_sym, callee_name, line)
    val call = HirExpr(
        kind: HirExprKind.Call(callee, [call_arg(arg_expr, line)], []),
        has_type_: true,
        type_: i64_type(),
        span: mk_span(line)
    )
    HirStmt(kind: HirStmtKind.Expr(call), span: mk_span(line))

fn make_param(sym: SymbolId, name: text, type_: HirType) -> HirParam:
    HirParam(symbol: sym, name: name, type_: type_, has_default: false, default: nil_expr(), span: mk_span(0), is_mutable: false)

fn make_fn(sym: SymbolId, name: text, params: [HirParam], body_stmts: [HirStmt]) -> HirFunction:
    val body = HirBlock(stmts: body_stmts, has: false, value: nil_expr(), span: mk_span(1))
    HirFunction(
        symbol: sym,
        name: name,
        type_params: [],
        params: params,
        return_type: i64_type(),
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(1)
    )

fn make_class(sym: SymbolId, name: text) -> HirClass:
    HirClass(
        symbol: sym,
        name: name,
        type_params: [],
        fields: [],
        methods: {},
        visibility: Visibility.Public,
        is_public: true,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(0),
        has_layout_attr: false,
        layout_attr: LayoutAttr(layout_kind: TypeLayoutKind.Simple, is_packed: false),
        has_export_attr: false,
        export_attr: ExportAttr(is_export_c: false, export_name: ""),
        has_platform_attr: false,
        platform_has_error: false,
        platform_has_warning: false,
        platform_diagnostic_message: "",
        platform_diagnostic_line: 0,
        is_generic_template: false,
        has_specialization_of: false,
        specialization_of: "",
        type_bindings: {}
    )

fn make_struct(sym: SymbolId, name: text) -> HirStruct:
    HirStruct(
        symbol: sym,
        name: name,
        type_params: [],
        fields: [],
        visibility: Visibility.Public,
        is_public: true,
        has_doc_comment: false,
        doc_comment: "",
        span: mk_span(0),
        has_layout_attr: false,
        layout_attr: LayoutAttr(layout_kind: TypeLayoutKind.Simple, is_packed: false),
        has_platform_attr: false,
        platform_has_error: false,
        platform_has_warning: false,
        platform_diagnostic_message: "",
        platform_diagnostic_line: 0,
        is_generic_template: false,
        has_specialization_of: false,
        specialization_of: "",
        type_bindings: {}
    )

fn make_module(fns: [HirFunction], classes: [HirClass], structs: [HirStruct]) -> HirModule:
    var functions: Dict<SymbolId, HirFunction> = {}
    for f in fns:
        functions[f.symbol] = f
    var classes_dict: Dict<SymbolId, HirClass> = {}
    for c in classes:
        classes_dict[c.symbol] = c
    var structs_dict: Dict<SymbolId, HirStruct> = {}
    for s in structs:
        structs_dict[s.symbol] = s
    HirModule(
        name: "e1049_test",
        path: "synthetic/e1049_test.spl",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        classes: classes_dict,
        structs: structs_dict,
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

fn count_parallel_transfer(errors: [SafetyError]) -> i64:
    var n = 0
    for e in errors:
        match e:
            case Other(message, _):
                if message.contains("PAR-"):
                    n = n + 1
            case _:
                pass
    n

describe "parallel boundary transfer classification":
    it "fires when a non-iso class-typed param is passed bare to spawn()":
        step("Verify: fires when a non-iso class-typed param is passed bare to spawn()")
        # @req: REQ-COMPILER-SEMANTICS-001
        val worker_sym = SymbolId(id: 1)
        val spawn_sym = SymbolId(id: 2)
        val w_sym = SymbolId(id: 3)
        val boot_sym = SymbolId(id: 4)
        val worker_cls = make_class(worker_sym, "Worker")
        val w_param = make_param(w_sym, "w", named_type(worker_sym))
        val stmt = spawn_call_stmt(spawn_sym, named_var(w_sym, "w", 10), 10)
        val boot_fn = make_fn(boot_sym, "boot", [w_param], [stmt])
        val hir = make_module([boot_fn], [worker_cls], [])
        val checker = SafetyChecker.create()
        val _ = safetychecker_check_module(checker, hir)
        val errors = safetychecker_check_transfer_module(checker, hir)
        expect(count_parallel_transfer(errors)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "warns that an implicit existing iso transfer consumes the parent":
        step("Verify: warns that an implicit existing iso transfer consumes the parent")
        val worker_sym = SymbolId(id: 1)
        val spawn_sym = SymbolId(id: 2)
        val w_sym = SymbolId(id: 3)
        val boot_sym = SymbolId(id: 4)
        val worker_cls = make_class(worker_sym, "Worker")
        val w_param = make_param(w_sym, "w", iso_named_type(worker_sym))
        val stmt = spawn_call_stmt(spawn_sym, named_var(w_sym, "w", 10), 10)
        val boot_fn = make_fn(boot_sym, "boot", [w_param], [stmt])
        val hir = make_module([boot_fn], [worker_cls], [])
        val checker = SafetyChecker.create()
        val _ = safetychecker_check_module(checker, hir)
        val errors = safetychecker_check_transfer_module(checker, hir)
        expect(count_parallel_transfer(errors)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "is silent for a freshly-constructed spawn argument (not a bare identifier)":
        step("Verify: is silent for a freshly-constructed spawn argument (not a bare identifier)")
        val worker_sym = SymbolId(id: 1)
        val spawn_sym = SymbolId(id: 2)
        val boot_sym = SymbolId(id: 4)
        val worker_cls = make_class(worker_sym, "Worker")
        # A StructLit argument -- not a NamedVar -- has no trackable binding,
        # so the rule cannot (and, per the fresh-construction scoping note in
        # the block comment above safety_transfer_walk_expr, should not) fire.
        val fresh_arg = HirExpr(kind: HirExprKind.StructLit(named_type(worker_sym), []), has_type_: true, type_: named_type(worker_sym), span: mk_span(10))
        val stmt = spawn_call_stmt(spawn_sym, fresh_arg, 10)
        val boot_fn = make_fn(boot_sym, "boot", [], [stmt])
        val hir = make_module([boot_fn], [worker_cls], [])
        val checker = SafetyChecker.create()
        val _ = safetychecker_check_module(checker, hir)
        val errors = safetychecker_check_transfer_module(checker, hir)
        expect(count_parallel_transfer(errors)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "requires runtime classification for an aggregate param":
        step("Verify: requires runtime classification for an aggregate param")
        val task_sym = SymbolId(id: 1)
        val spawn_sym = SymbolId(id: 2)
        val t_sym = SymbolId(id: 3)
        val boot_sym = SymbolId(id: 4)
        val task_struct = make_struct(task_sym, "Task")
        val t_param = make_param(t_sym, "t", named_type(task_sym))
        val stmt = spawn_call_stmt(spawn_sym, named_var(t_sym, "t", 10), 10)
        val boot_fn = make_fn(boot_sym, "boot", [t_param], [stmt])
        val hir = make_module([boot_fn], [], [task_struct])
        val checker = SafetyChecker.create()
        val _ = safetychecker_check_module(checker, hir)
        val errors = safetychecker_check_transfer_module(checker, hir)
        expect(count_parallel_transfer(errors)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "is silent for an ordinary call whose callee is not named spawn":
        step("Verify: is silent for an ordinary call whose callee is not named spawn")
        val worker_sym = SymbolId(id: 1)
        val identity_sym = SymbolId(id: 2)
        val w_sym = SymbolId(id: 3)
        val touch_sym = SymbolId(id: 4)
        val worker_cls = make_class(worker_sym, "Worker")
        val w_param = make_param(w_sym, "w", named_type(worker_sym))
        val stmt = not_spawn_call_stmt(identity_sym, "identity", named_var(w_sym, "w", 10), 10)
        val touch_fn = make_fn(touch_sym, "touch", [w_param], [stmt])
        val hir = make_module([touch_fn], [worker_cls], [])
        val checker = SafetyChecker.create()
        val _ = safetychecker_check_module(checker, hir)
        val errors = safetychecker_check_transfer_module(checker, hir)
        expect(count_parallel_transfer(errors)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects raw pointers at process boundaries":
        step("Verify: rejects raw pointers at process boundaries")
        val pointer = HirType(kind: HirTypeKind.Ptr(i64_type(), true),
            span: mk_span(1))
        val decision = classify_hir_boundary_transfer(pointer, false,
            HirExecutionBoundary.Process, HirRegionOrigin.ParentExisting,
            false, ResolvedParallelPolicyV1.balanced())
        expect(decision.allowed).to_equal(false)
        expect(decision.code).to_equal("E-PAR-PROC-003")

    it "denies existing parent iso state under critical policy":
        step("Verify: denies existing parent iso state under critical policy")
        val isolated = iso_named_type(SymbolId(id: 99))
        val critical = ResolvedParallelPolicyV1.for_assurance(
            AssuranceStrictness.Critical)
        val decision = classify_hir_boundary_transfer(isolated, true,
            HirExecutionBoundary.Thread, HirRegionOrigin.ParentExisting,
            true, critical)
        expect(decision.allowed).to_equal(false)
        expect(decision.code).to_equal("E-PAR-OWN-001")

    it "copies scalar values without diagnostics":
        step("Verify: copies scalar values without diagnostics")
        val decision = classify_hir_boundary_transfer(i64_type(), false,
            HirExecutionBoundary.Thread, HirRegionOrigin.ParentExisting,
            false, ResolvedParallelPolicyV1.balanced())
        expect(decision.allowed).to_equal(true)
        expect(decision.code).to_equal("")
