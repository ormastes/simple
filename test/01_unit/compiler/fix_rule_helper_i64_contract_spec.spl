extern fn rt_file_read_text(path: text) -> text

describe("fix rule helper concrete integer contracts"):
    it("uses i64 for byte offsets and edit distance"):
        val source = rt_file_read_text("src/compiler/tools/fix/rules/helpers.spl") ?? ""
        expect(source.contains("target_line: Int")).to_equal(false)
        expect(source.contains("target_col: Int")).to_equal(false)
        expect(source.contains(") -> Int:")).to_equal(false)
        expect(source.contains("target_line: i64")).to_equal(true)
        expect(source.contains("fn levenshtein(a: String, b: String) -> i64:")).to_equal(true)

    it("uses i64 for fix implementation line and byte positions"):
        val lint = rt_file_read_text("src/compiler/tools/fix/rules/impl_/lint_code.spl") ?? ""
        val errors = rt_file_read_text("src/compiler/tools/fix/rules/impl_/error_fix.spl") ?? ""
        expect(lint.contains("after_line: Int")).to_equal(false)
        expect(lint.contains("after_offset: Int")).to_equal(false)
        expect(errors.contains("line_num: Int")).to_equal(false)
        expect(errors.contains("byte_end: Int")).to_equal(false)
