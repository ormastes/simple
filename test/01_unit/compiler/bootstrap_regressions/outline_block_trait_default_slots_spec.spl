# Regression: doc/08_tracking/bug/outline_block_native_prerequisites_2026_10_16.md
# Interpreter shape of the workaround: omitted trait default is callable and an
# explicit override stays authoritative. Native fixture:
# test/fixtures/compiler/outline_block_trait_default_slots/main.spl
use std.spec.{describe, it, expect}

trait Block:
    fn kind() -> text
    fn policy() -> text:
        "default"

struct Plain:
    pass

struct Custom:
    pass

impl Block for Plain:
    fn kind() -> text: "plain"

impl Block for Custom:
    fn kind() -> text: "custom"
    fn policy() -> text: "override"

describe "trait default slots":
    it "omitted default is supplied":
        expect(Plain().policy()).to_equal("default")
    it "override wins":
        expect(Custom().policy()).to_equal("override")
