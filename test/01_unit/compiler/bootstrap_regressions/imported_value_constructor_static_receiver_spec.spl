# Regression: doc/08_tracking/bug/imported_value_constructor_static_receiver_native_2026_10_16.md
# Interpreter shape of the workaround: typed top-level factory and the enum
# static receiver must build the same variants. Native fixture:
# test/fixtures/compiler/imported_value_constructor_static_receiver/main.spl
use std.spec.{describe, it, expect}

enum Value:
    Int(i64)
    Text(text)
    Unit

fn value_int(n: i64) -> Value:
    Value.Int(n)

fn int_of(v: Value) -> i64:
    match v:
        case Value.Int(n): n
        case _: -1

describe "Value constructor static receiver":
    it "enum receiver builds Int":
        expect(int_of(Value.Int(7))).to_equal(7)
    it "typed factory matches the receiver":
        expect(int_of(value_int(7))).to_equal(int_of(Value.Int(7)))
    it "non-Int variants are distinct":
        expect(int_of(Value.Text("x"))).to_equal(-1)
        expect(int_of(Value.Unit)).to_equal(-1)
