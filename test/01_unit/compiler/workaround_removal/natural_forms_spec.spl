# @req REQ-SSPEC-COMPILER
# Natural (un-worked-around) forms of six registered workarounds whose bugs the
# 2026-11-05 verify sweep (#6982) marked fixed. Run: bin/simple.exe test <this spec>
use std.spec.{describe, it, expect}

enum E1:
    Worse
    Fine

struct Adm:
    n: i64

fn admit(ok: bool) -> Result<Adm, text>:
    if ok: Ok(Adm(n: 7)) else: Err("no")

fn admit_panic_first() -> Adm:
    match admit(true):
        case Err(reason): panic("failed: {reason}")
        case Ok(value): value

fn opt_f(o: i64?) -> i64?:
    val r = match o:
        case Some(e): Some(e + 1)
        case None: None
    r

fn err_enum(fail: bool) -> Result<i64, E1>:
    if fail: Err(E1.Worse) else: Ok(1)

fn kind_of(c: Dict<text, text>) -> text:
    c["kind"] ?? "dflt"

fn scalar_like(t: i64?) -> bool:
    if t == nil:
        return false
    t > 0

describe "natural forms of fixed workarounds":
    it "match with panic arm first keeps the Ok value":
        expect(admit_panic_first().n).to_equal(7)
    it "untyped match arm result joins payload with [] literal":
        val xs: [i64] = [1, 2]
        val got = match xs.len():
            case 2: xs
            case _: []
        expect(got.len()).to_equal(2)
    it "untyped Option match Some/None needs no annotation":
        expect(opt_f(Some(3))).to_equal(Some(4))
        expect(opt_f(None).?).to_equal(false)
    it "field/value read after nil check reads the payload":
        expect(scalar_like(5)).to_equal(true)
        expect(scalar_like(nil)).to_equal(false)
    it "Result.err().unwrap() with an enum error payload":
        val r = err_enum(true)
        expect(r.is_err()).to_equal(true)
        expect(r.err().unwrap() == E1.Worse).to_equal(true)
    it "dict index ?? default on a miss yields the default":
        var c: Dict<text, text> = {}
        expect(kind_of(c)).to_equal("dflt")
        c["kind"] = "x"
        expect(kind_of(c)).to_equal("x")
