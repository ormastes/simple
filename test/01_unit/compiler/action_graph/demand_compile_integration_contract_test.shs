#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
integration="$root/src/compiler/80.driver/action_graph/demand_compile_integration.spl"
driver="$root/src/compiler/80.driver/driver_source_pipeline_loading.spl"

test -f "$integration"
grep -q 'PackageIndexRouteV1' "$integration"
grep -q 'coordinator_new_v1' "$integration"
grep -q 'pinned-archive-load' "$integration"
grep -q 'frozen-source-scc' "$integration"
grep -q 'demand_backend_plan_v1' "$integration"
grep -q 'native_promotion_enqueue_v1' "$integration"
grep -q 'demand_compile_complete_scc_outputs_v1' "$integration"
grep -q 'scc_compile_outputs_publish_v1' "$integration"
grep -q 'budget.priority - 1' "$integration"
grep -q 'coordinator_diagnostics_v1' "$integration"
grep -q 'package_index_route_current_v1' "$driver"
grep -q 'route_archive_install_commit_v1' "$driver"
grep -q 'demand_compile_begin_v1' "$driver"
grep -q 'demand_artifact_commit_v1' "$driver"
grep -q 'package_archive_publish_scc_v1' "$root/src/compiler/80.driver/action_graph/scc_compile_outputs.spl"
! grep -q 'demand_compile_publish_dirty_scc_v1' "$integration"
! grep -q 'rt_file_read' "$integration"
! grep -q 'rt_process_run' "$integration"

printf '%s\n' 'DEMAND_COMPILE_INTEGRATION_STATIC_PASS'
