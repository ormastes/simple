# @req REQ-SSPEC-UNIT
# @cover src/compiler/80.driver/action_graph/persisted_graph.spl
#
# Regression: Phase-3 census (run-19 Stage 2 compiler, 2026-11-13) failed MIR
# on compiler.driver.action_graph.persisted_graph with
# `unresolved method call: is_none ... owner=` at `priority.is_none()`, where
# `priority = fields[3].to_i64()`. `text.to_i64()` is the LENIENT raw-i64
# parse (0 on failure) in MIR and both native runtimes, so its result has no
# Option owner; the strict `Option<i64>` parse is `parse_i64()`.
#
# The seed interpreter accepts both spellings (its `to_i64` returns nil on
# failure), so this spec passes on the interpreter either way. The
# discriminator is `simple compile <probe> --format=smf` on a Stage 2 binary:
# red with `to_i64().is_none()`, green with `parse_i64().is_none()`.
# Record: doc/08_tracking/bug/p3_census_mir_classes_2026-11-13.md
use std.spec.*
use compiler.driver.action_graph.build_action_v1.{BuildActionV1, BuildActionPoolV1}
use compiler.driver.action_graph.persisted_graph.{
    PersistedBuildGraphV1, persisted_graph_digest_v1,
    persisted_graph_encode_v1, persisted_graph_decode_v1
}

fn _action() -> BuildActionV1:
    BuildActionV1(
        action_id: "act-a", command_identity: "cmd-a", inputs: ["in.spl"],
        dynamic_edges: [], outputs: ["out.o"], pool: BuildActionPoolV1.mir,
        priority: 7, snapshot_revision: "snap-x", memory_budget_bytes: 2048,
        restat_identity: "restat-a")

fn _graph() -> PersistedBuildGraphV1:
    # The digest excludes `generation`, but validation needs it non-empty.
    val draft = PersistedBuildGraphV1(
        generation: "draft", parent_generation: "", snapshot_revision: "snap-x",
        actions: [_action()])
    PersistedBuildGraphV1(
        generation: persisted_graph_digest_v1(draft), parent_generation: "",
        snapshot_revision: "snap-x", actions: [_action()])

describe "persisted graph action-row decode":
    it "round-trips a valid graph with numeric priority and memory fields":
        val encoded = persisted_graph_encode_v1(_graph())
        expect(encoded != "").to_equal(true)
        val decoded = persisted_graph_decode_v1(encoded)
        expect(decoded.is_ok()).to_equal(true)
        val back = decoded.unwrap()
        expect(back.actions.len()).to_equal(1)
        expect(back.actions[0].priority).to_equal(7)
        expect(back.actions[0].memory_budget_bytes).to_equal(2048)

    it "rejects a non-numeric priority field as action-row-invalid":
        val encoded = persisted_graph_encode_v1(_graph())
        val corrupted = encoded.replace("|7|", "|seven|")
        expect(corrupted != encoded).to_equal(true)
        val decoded = persisted_graph_decode_v1(corrupted)
        expect(decoded.is_err()).to_equal(true)
        expect(decoded.unwrap_err()).to_equal("action-row-invalid")

    it "rejects a non-numeric memory budget field as action-row-invalid":
        val encoded = persisted_graph_encode_v1(_graph())
        val corrupted = encoded.replace("|2048|", "|2k|")
        expect(corrupted != encoded).to_equal(true)
        val decoded = persisted_graph_decode_v1(corrupted)
        expect(decoded.is_err()).to_equal(true)
        expect(decoded.unwrap_err()).to_equal("action-row-invalid")
