#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
source_file="$root/src/compiler/80.driver/action_graph/demand_compile_integration.spl"
route_file="$root/src/compiler/80.driver/cache/package_index_route.spl"

grep -Fq 'archive_admissions: [PackageArchiveAdmissionV1]' "$route_file"
grep -Fq 'export PackageArchiveAdmissionV1, PackageIndexRouteV1' "$route_file"
grep -Fq 'PackageArchiveAdmissionV1, PackageIndexRouteV1' "$source_file"
grep -Fq 'for admission in route.archive_admissions:' "$source_file"

if grep -Fq 'admission.load as ' "$source_file"; then
    echo "package archive admission must resolve through its exported type, not a cast" >&2
    exit 1
fi
