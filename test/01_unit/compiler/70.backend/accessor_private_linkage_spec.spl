# Actual MIR-to-LLVM source oracle; authored, not yet executed.
use std.spec
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.{MirBuilder}
use compiler.mir.mir_instructions.{MirModule, MirFunction}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirSignature, MirConstValue}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, MirCallOrigin}
use compiler.mir.mir_compiler_private_function_v1.{MirCompilerPrivateFunctionV1}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}

fn linkage_signature() -> MirSignature:
    MirSignature(params: [], return_type: MirType.unit(), is_variadic: false,
        params_known: true, declared_params: [], declared_params_known: true)

fn linkage_module(owner: bool) -> MirModule:
    val helper_name = "__simple_accessor_linkage_probe"
    val signature = linkage_signature()
    var builder = MirBuilder.new()
    val function_name = if owner: helper_name else: "caller"
    val function_symbol = SymbolId.new(if owner: 100 else: 7)
    builder.begin_function(function_symbol, function_name, signature, Span.empty())
    if not owner:
        val callee = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(helper_name),
            MirType(kind: MirTypeKind.FuncPtr(signature))), call_origin: MirCallOrigin.Source)
        builder.emit_call(callee, [], MirType.unit())
    builder.terminate_return(None)
    val function = builder.end_function()
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function_symbol] = function
    val module_name = if owner: "owner.module" else: "caller.module"
    MirModule(name: module_name, functions: functions, statics: {}, constants: {}, types: {},
        compiler_private_module_identity_v1: module_name,
        compiler_private_functions_v1: [MirCompilerPrivateFunctionV1(schema_version: 1,
            symbol: SymbolId.new(100), name: helper_name, signature: signature,
            emission_owner: "owner.module", canonical_key: "linkage-test-key",
            key_digest: "linkage-test-index", defines_here: owner)])

fn linkage_ir(owner: bool) -> text:
    val module = linkage_module(owner)
    var translator = MirToLlvm.create_explicit_target(module.name, CodegenTarget.X86_64,
        "x86_64", "unknown", "linux", "gnu", true, "", false)
    translator.translate_module_with_entry_policy(module, false, false)

describe "compiler-private accessor cross-object linkage":
    it "uses one final hidden name for definition declaration and call":
        val defining = linkage_ir(true)
        val calling = linkage_ir(false)
        expect(defining).to_contain("define hidden void @__simple_accessor_linkage_probe(")
        expect(calling).to_contain("declare hidden void @__simple_accessor_linkage_probe(")
        expect(calling).to_contain("call void @__simple_accessor_linkage_probe(")
        expect(defining.contains("@owner.module.__simple_accessor_linkage_probe")).to_equal(false)
        expect(calling.contains("@caller.module.__simple_accessor_linkage_probe")).to_equal(false)
