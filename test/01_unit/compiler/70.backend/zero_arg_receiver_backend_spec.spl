use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.mir.mir.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}


# Bug native_zero_arg_method_receiver_not_marshalled_2026-07-19, backend half.
# MIR is receiver-first (zero_arg_method_receiver_operand_spec, PR #8222); these
# pin that 70.backend MirToLlvm keeps that receiver as the single call argument
# instead of treating a 1-operand call to a zero-arg method as "no args".

val MODULE = "zarb_probe"
val PARAM_SRC = "struct B:\n    v: i64\n\n    fn p_ok() -> bool:\n        self.v > 0\n\nclass E:\n    n: i64\n\n    me run(batch: B) -> bool:\n        batch.p_ok()\n"
val LOCAL_SRC = "struct B:\n    v: i64\n\n    fn s_ok() -> bool:\n        self.v > 0\n\nfn run() -> bool:\n    val b = B(v: 1)\n    b.s_ok()\n"
val CHAIN_SRC = "struct B:\n    v: i64\n\n    fn c_ok() -> bool:\n        self.v > 0\n\nclass E:\n    n: i64\n\n    fn mk() -> B:\n        B(v: self.n)\n\n    fn run() -> bool:\n        self.mk().c_ok()\n"

fn ir_of(src: text) -> text:
    val file = "testdata/zarb_probe.spl"
    var hl = HirLowering.with_filename(file)
    val m: HirModule = hl.lower_module(parse_full_frontend(src, file, MODULE, Logger(level: 0)))
    var lowering = MirLowering.new_for_target(m.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = lowering.lower_module(m)
    MirToLlvm.create(MODULE, CodegenTarget.X86_64, nil).translate_module(mir)

# Argument list of the first `call ... @<...>.<method>(` site, or "<no-call>".
fn call_args(ir: text, method: text) -> text:
    for line in ir.split("\n"):
        val t = line.trim()
        if t.contains(" call ") and t.contains("." + method + "("):
            val open = t.index_of("." + method + "(") ?? -1
            if open < 0:
                return "<no-call>"
            val rest = t.substring(open + method.len() + 2, t.len())
            val close = rest.index_of(")") ?? -1
            if close < 0:
                return "<no-call>"
            return rest.substring(0, close)
    "<no-call>"

fn one_ptr_arg(args: text) -> bool:
    args.starts_with("ptr %") and not args.contains(",")

describe "native zero-arg method receiver is marshalled by MirToLlvm":
    it "passes a me-method parameter receiver (engine batch.p_ok() shape)":
        expect(one_ptr_arg(call_args(ir_of(PARAM_SRC), "p_ok"))).to_equal(true)

    it "passes a struct local receiver":
        expect(one_ptr_arg(call_args(ir_of(LOCAL_SRC), "s_ok"))).to_equal(true)

    it "passes a chained call result as receiver":
        expect(one_ptr_arg(call_args(ir_of(CHAIN_SRC), "c_ok"))).to_equal(true)

    it "callee declares exactly the receiver parameter":
        expect(ir_of(PARAM_SRC).contains("define i1 @testdata.zarb_probe.B.p_ok(ptr %l1)")).to_equal(true)
