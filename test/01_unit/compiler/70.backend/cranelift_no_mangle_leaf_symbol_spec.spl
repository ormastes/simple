# Cranelift twin of no_mangle_leaf_symbol_spec.spl: under --no-mangle a
# runtime-owned `rt_*` DEFINITION is the C-ABI runtime symbol itself and must
# keep its bare name (it was renamed to __simple_local_rt_* before the
# no-mangle check). Leaf stripping and collision failure live in MIR
# (mir_provider_callable_identity_for_mode / mir_no_mangle_claim_leaf), shared
# by both backends.
# See doc/08_tracking/bug/no_mangle_emits_module_qualified_symbols_2026-11-16.md
use std.spec
use std.io_runtime.{env_set}
use compiler.backend.backend.cranelift_codegen_adapter.{cl_function_emit_name}

describe "cranelift no-mangle emit names":
    it "keeps bare rt_* and Type.method definitions under --no-mangle":
        env_set("SIMPLE_NATIVE_BUILD_NO_MANGLE", "1")
        expect(cl_function_emit_name("rt_string_replace")).to_equal("rt_string_replace")
        expect(cl_function_emit_name("rt_array_new")).to_equal("rt_array_new")
        expect(cl_function_emit_name("Pt.get")).to_equal("Pt.get")
        env_set("SIMPLE_NATIVE_BUILD_NO_MANGLE", "")

    it "still privatizes lowering-owned array accessors under --no-mangle":
        env_set("SIMPLE_NATIVE_BUILD_NO_MANGLE", "1")
        expect(cl_function_emit_name("rt_array_get")).to_equal("__simple_local_rt_array_get")
        env_set("SIMPLE_NATIVE_BUILD_NO_MANGLE", "")

    it "privatizes runtime-owned local definitions when mangling":
        env_set("SIMPLE_NATIVE_BUILD_NO_MANGLE", "")
        expect(cl_function_emit_name("rt_array_new")).to_equal("__simple_local_rt_array_new")
        expect(cl_function_emit_name("main")).to_equal("__simple_main")
