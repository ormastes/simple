"""
# Small four-byte Color struct return invariant

**Bug:** doc/08_tracking/bug/arm64_framebuffer_color_struct_return_abi_2026-08-21.md

Target-independent invariant: a four-field `u8` Color (and a `u32`-packed
peer) returned from a static constructor and from a forwarding function keeps
every channel. The arm64-native repro lives in
`test/01_unit/compiler/codegen/native_arm64_framebuffer_color_return_spec.spl`.
"""

struct InvColor:
    r: u8
    g: u8
    b: u8
    a: u8

impl InvColor:
    static fn rgb(r: u8, g: u8, b: u8) -> InvColor:
        InvColor(r: r, g: g, b: b, a: 255)

    fn to_u32() -> u32:
        ((self.a as u32) << 24) | ((self.r as u32) << 16) | ((self.g as u32) << 8) | (self.b as u32)

struct InvPixel:
    value: u32
    x: u32
    y: u32
    tag: u8

fn forward_color(r: u8, g: u8, b: u8) -> InvColor:
    InvColor.rgb(r, g, b)

fn make_pixel(c: InvColor) -> InvPixel:
    InvPixel(value: c.to_u32(), x: 3, y: 5, tag: c.a)

describe "Color struct return invariant":
    it "static rgb constructor returns all four channels":
        val c = InvColor.rgb(17, 31, 47)
        expect(c.r).to_equal(17)
        expect(c.g).to_equal(31)
        expect(c.b).to_equal(47)
        expect(c.a).to_equal(255)

    it "forwarded return keeps channels":
        val c = forward_color(17, 31, 47)
        expect(c.r).to_equal(17)
        expect(c.b).to_equal(47)
        expect(c.a).to_equal(255)

    it "u32 mixed struct round-trips packed value":
        val p = make_pixel(InvColor.rgb(17, 31, 47))
        expect(p.value).to_equal(4279312175)
        expect(p.x).to_equal(3)
        expect(p.y).to_equal(5)
        expect(p.tag).to_equal(255)
