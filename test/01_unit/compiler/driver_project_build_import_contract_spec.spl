extern fn rt_file_read_text(path: text) -> text

describe("driver project build import ownership"):
    it("binds header generation and shared flags at module scope"):
        val source = rt_file_read_text("src/compiler/driver/driver_api_project_build.spl") ?? ""
        expect(source.contains("use lazy compiler.tools.header_gen.mod_ (HeaderGenerator)")).to_equal(true)
        expect(source.contains("use compiler.tools.header_gen.shared_lib_flags (SharedLibFlags, get_shared_lib_flags)")).to_equal(true)

    it("does not declare imports inside project build functions"):
        val source = rt_file_read_text("src/compiler/driver/driver_api_project_build.spl") ?? ""
        expect(source.contains("    use compiler.tools.header_gen.mod_")).to_equal(false)
        expect(source.contains("    use compiler.tools.header_gen.shared_lib_flags")).to_equal(false)
