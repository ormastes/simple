use std.spec.*
use compiler.backend.common.cuda_layout_extent_v1.*

describe "Shared CUDA checked physical extent":
    it "uses maximum end regardless of declaration order":
        expect(cuda_checked_struct_extent_v1([8, 0], [1, 8], 8).unwrap()).to_equal(16)
        expect(cuda_checked_struct_extent_v1([0, 8], [8, 1], 8).unwrap()).to_equal(16)
        expect(cuda_checked_struct_extent_v1([], [], 1).unwrap()).to_equal(0)

    it "preserves packed and C extents":
        expect(cuda_checked_struct_extent_v1([0, 1], [1, 8], 1).unwrap()).to_equal(9)
        expect(cuda_checked_struct_extent_v1([0, 8], [1, 8], 8).unwrap()).to_equal(16)

    it "rejects negative values overflow incomplete rows and invalid alignment":
        expect(cuda_checked_struct_extent_v1([-1], [8], 8).is_err()).to_equal(true)
        expect(cuda_checked_struct_extent_v1([0], [-1], 8).is_err()).to_equal(true)
        expect(cuda_checked_struct_extent_v1([9223372036854775807], [8], 8).is_err()).to_equal(true)
        expect(cuda_checked_struct_extent_v1([9223372036854775806, 0], [1, 8], 8).is_err()).to_equal(true)
        expect(cuda_checked_struct_extent_v1([0], [], 8).is_err()).to_equal(true)
        expect(cuda_checked_struct_extent_v1([0], [1], 0).is_err()).to_equal(true)
        expect(cuda_checked_extent_product_v1(8, 9223372036854775807).is_err()).to_equal(true)
