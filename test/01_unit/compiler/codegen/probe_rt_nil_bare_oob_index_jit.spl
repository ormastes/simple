# Run-path probe: a BARE out-of-bounds array index must fail loudly.
#
# Split out of `probe_rt_nil_sentinel_collision_jit.spl` because the correct
# behaviour here is a PANIC, which terminates the process — it cannot share a
# probe with checks that must keep running.
#
# doc/08_tracking/bug/jit_array_oob_read_leaks_raw_rt_nil_sentinel_2026-08-07.md
# recorded that under the JIT `xs[9]` on a 3-element array printed `3` (the raw
# RT_NIL sentinel word) with rc=0 and no panic, while the tree-walk interpreter
# correctly reported `array index out of bounds: index is 9 but length is 3`.
#
# Contract, checked by the sibling spec:
#   - the process must NOT exit 0
#   - stdout must NOT contain the marker line below (execution must not reach it)
#
# A `-1` index is deliberately NOT used here: negative indices are a supported
# Python-style wrap, not an out-of-bounds access.

fn main():
    val xs: [i64] = [10, 20, 30]
    val v = xs[9]
    print("BARE_OOB PROBE: NO PANIC, value=" + v.to_string())

main()
