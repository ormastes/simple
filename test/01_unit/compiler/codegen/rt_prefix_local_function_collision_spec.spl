# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
"""
# Local function named like a runtime symbol (codegen_rt_prefix_local_function_collision_sigsegv_2026-07-12)

A user-authored function whose name equals a runtime SFFI symbol must call its
own body, not the runtime import (which used to SIGSEGV).
"""
use std.spec.{describe, it, assert_equal}

fn rt_array_len_safe<T>(array: [T]) -> i64:
    array.len() + 100

fn rt_string_len(s: text) -> i64:
    s.len() * 2

describe "local function named like a runtime symbol":
    it "calls the local generic body":
        val arr: [i64] = [10, 20, 30, 40]
        assert_equal(rt_array_len_safe(arr), 104)

    it "calls the local non-generic body":
        assert_equal(rt_string_len("abc"), 6)
