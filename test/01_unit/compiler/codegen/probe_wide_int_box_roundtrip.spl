# Run-path probe: does a FULL-WIDTH i64 survive every tagged-slot boundary?
#
# This file is executed as a SUBPROCESS by
# `wide_int_box_roundtrip_class_spec.spl` under both engines. It must never be
# run by `bin/simple test` directly: the spec body runs on the tree-walk
# interpreter, which is correct for this whole class, so an in-process example
# can never go red on the JIT defect this probe exists to catch.
#
# CLASS UNDER TEST — the inline boxed-integer representation is `v << 3` with a
# 3-bit tag in the low bits, so the inline payload is only 61 SIGNED bits. Any
# |v| >= 2^60 shifts its top bits out and the matching `>> 3` sign-extends a
# DIFFERENT number back. Two separately-filed bugs were this one defect:
#   doc/08_tracking/bug/seed_jit_wide_i64_literal_miscompile_2026-07-27.md
#     `print "{a} {b}"` with a=i64::MAX b=i64::MIN printed `-1 0`.
#   doc/08_tracking/bug/seed_jit_spl_f64_to_bits_miscompile_2026-07-23.md
#     f64_to_bits(3.0) = 0x4008000000000000 stored into `[i64]` read back as
#     2251799813685248, and `readback == b` was false.
# Both are the SAME arithmetic: (0x4008000000000000 << 3) mod 2^64 >> 3.
#
# Every oracle below is an ABSOLUTE literal this probe did not compute. It never
# checks "the two engines agree" — that would pass while both are wrong.

extern fn spl_f64_to_bits(value: f64) -> i64

struct WideBox:
    v: i64

# `print` appends its own newline, so the verdict and the check name MUST be
# concatenated into ONE call — emitting them as two prints splits the token the
# spec greps for ("PASS \nname") and every assertion silently fails.
fn check(name: text, got: i64, want: i64):
    if got == want:
        print("PASS " + name)
    else:
        print("FAIL " + name)

fn via_list_param(l: list, i: i64) -> i64:
    return l[i]

fn main() -> i64:
    # The boundary values. 2^60 is the first magnitude that does NOT fit the
    # 61-bit signed inline payload; everything below it must be untouched.
    val vmax: i64 = 0x7FFFFFFFFFFFFFFF
    val vmin: i64 = 0x8000000000000000
    val p60: i64 = 0x1000000000000000
    val n60: i64 = -1152921504606846976
    val fbits: i64 = 0x4008000000000000
    val small: i64 = 5

    print("WIDE_INT_BOX_PROBE: BEGIN")

    # --- Boundary 1: string interpolation (the tagged to-string path). -------
    # This is the boundary that made bug 2026-07-27 look like a literal
    # materialization defect: plain `print(vmax)` was already correct.
    print("INTERP_MAX={vmax}")
    print("INTERP_MIN={vmin}")
    print("INTERP_P60={p60}")
    print("INTERP_N60={n60}")
    print("INTERP_FBITS={fbits}")
    print("INTERP_SMALL={small}")

    # --- Boundary 2: [i64] array element store/read. -------------------------
    var arr: [i64] = [0, 0, 0, 0, 0, 0]
    arr[0] = vmax
    arr[1] = vmin
    arr[2] = p60
    arr[3] = n60
    arr[4] = fbits
    arr[5] = small
    check("array_i64_max", arr[0], 0x7FFFFFFFFFFFFFFF)
    check("array_i64_min", arr[1], 0x8000000000000000)
    check("array_i64_p60", arr[2], 0x1000000000000000)
    check("array_i64_n60", arr[3], -1152921504606846976)
    check("array_i64_fbits", arr[4], 0x4008000000000000)
    check("array_i64_small", arr[5], 5)

    # --- Boundary 3: extern-returned i64 through an array (bug 2026-07-23). --
    val b = spl_f64_to_bits(3.0)
    check("extern_f64_bits_direct", b, 0x4008000000000000)
    var arr2: [i64] = [0, 0]
    arr2[1] = b
    val readback = arr2[1]
    check("extern_f64_bits_readback", readback, 0x4008000000000000)
    if readback == b:
        print("PASS extern_f64_bits_eq")
    else:
        print("FAIL extern_f64_bits_eq")

    # --- Boundary 4: nullable `i64?` slot (a tagged slot by lowering). -------
    val opt: i64? = vmax
    val opt2: i64? = vmin
    check("optional_i64_max", opt!, 0x7FFFFFFFFFFFFFFF)
    check("optional_i64_min", opt2!, 0x8000000000000000)

    # --- Boundary 5: struct field. -------------------------------------------
    val s = WideBox(v: vmax)
    check("field_i64_max", s.v, 0x7FFFFFFFFFFFFFFF)
    var s2 = WideBox(v: 0)
    s2.v = fbits
    check("field_i64_fbits", s2.v, 0x4008000000000000)

    # --- Boundary 6: untyped `list` parameter element read. -----------------
    # Related sibling defect, same tag arithmetic seen from the DECODE side:
    # doc/08_tracking/bug/untyped_list_element_read_seed_rootcause_2026-07-30.md
    check("list_param_small", via_list_param(arr, 5), 5)
    check("list_param_max", via_list_param(arr, 0), 0x7FFFFFFFFFFFFFFF)

    print("WIDE_INT_BOX_PROBE: END")
    return 0
