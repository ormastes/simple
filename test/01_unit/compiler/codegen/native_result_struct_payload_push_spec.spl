# Result<Struct> payload pushed into [Struct] must keep the struct value.
# Bug: doc/08_tracking/bug/result_struct_payload_pushed_into_struct_array_crashes_2026-10-25.md
# Red on natively compiled Stage 2 / Phase 3 gen-1 code (SEGV); the interpreter is green.

struct PushRc:
    name: text
    n: i64

fn push_rc_mk(i: i64) -> Result<PushRc, text>:
    if i < 0:
        return Err("neg")
    Ok(PushRc(name: "r{i}", n: i * 10))

describe "Result struct payload push":
    it "keeps matched Ok payloads pushed into a struct array":
        var xs: [PushRc] = []
        var errs: [text] = []
        var i = -1
        while i < 3:
            match push_rc_mk(i):
                case Err(reason):
                    errs.push(reason)
                case Ok(receipt): xs.push(receipt)
            i = i + 1
        expect(errs.len()).to_equal(1)
        expect(xs.len()).to_equal(3)
        expect(xs[1].name).to_equal("r1")
        expect(xs[2].n).to_equal(20)

    it "keeps unwrapped payloads pushed into a struct array":
        var xs: [PushRc] = []
        val res = push_rc_mk(4)
        if res.is_ok():
            val r: PushRc = res.unwrap()
            xs.push(r)
        expect(xs.len()).to_equal(1)
        expect(xs[0].name).to_equal("r4")
