# Run-path probe: a CHAINED call whose receiver is another call's result.
#
# Executed as a SUBPROCESS by chained_call_receiver_to_int_spec.spl and
# chained_call_receiver_class_spec.spl under both SIMPLE_EXECUTION_MODE=jit and
# =interpreter. A spec body runs on the tree-walk interpreter and therefore can
# never observe a JIT-only defect; this file is the oracle that can.
#
# Every expectation below is an ABSOLUTE literal, never "the two engines agree".
#
# Defect being pinned (bug jit_substring_chained_to_int_returns_pointer):
#   "ab1234".substring(2).to_int()  ->  2586350522657   (a raw HEAP POINTER)
# while the bound-intermediate form and the interpreter both give 1234.

var failures: i64 = 0

fn check(name: text, actual: text, expected: text):
    if actual == expected:
        print("PASS " + name)
    else:
        print("FAIL " + name + " expected=" + expected + " actual=" + actual)
        failures = failures + 1

fn main():
    val t = "ab1234"
    val arr = [10, 20, 30, 40]

    # --- the filed row: substring -> to_int, chained, no intermediate val ---
    check("substring_to_int_chained", t.substring(2).to_int().to_string(), "1234")

    # control arm: same computation with the intermediate bound to a local.
    # This form was ALWAYS correct; a red here means the probe itself is broken.
    val mid = t.substring(2)
    check("substring_to_int_stepped", mid.to_int().to_string(), "1234")

    # --- the CLASS: any call result used as a receiver ---
    check("substring_to_i64_chained", t.substring(2).to_i64().to_string(), "1234")
    check("substring_to_float_chained", t.substring(2).to_float().to_string(), "1234.0")
    check("substring_to_upper_chained", t.substring(0).to_upper(), "AB1234")
    check("substring_len_chained", t.substring(2).len().to_string(), "4")
    check("substring_substring_chained", t.substring(1).substring(1).to_int().to_string(), "1234")
    check("slice_to_int_chained", t.slice(2, 6).to_int().to_string(), "1234")
    check("trim_to_int_chained", "  9  ".trim().to_int().to_string(), "9")
    check("to_upper_to_lower_chained", t.to_upper().to_lower(), "ab1234")
    check("concat_to_int_chained", ("12" + "34").substring(0).to_int().to_string(), "1234")

    # --- array receivers must be UNAFFECTED: rt_slice/rt_take/rt_reverse are
    # shared between String and Array receivers, so a fix that types the result
    # String unconditionally would break these. ---
    check("array_slice_len_chained", arr.slice(1, 3).len().to_string(), "2")
    check("array_slice_index_chained", arr.slice(1, 3)[0].to_string(), "20")

    if failures == 0:
        print("CHAINED_CALL_RECEIVER PROBE: ALL PASS")
    else:
        print("CHAINED_CALL_RECEIVER PROBE: FAILURES=" + failures.to_string())
