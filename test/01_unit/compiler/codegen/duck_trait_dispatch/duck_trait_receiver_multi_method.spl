trait Backend:
    fn label(self) -> str
    fn scaled(self, k: i64) -> i64
    fn tag(self) -> i64

trait Named:
    fn label(self) -> str

class Soft:
    var base: i64
    fn label(self) -> str:
        return "soft"
    fn scaled(self, k: i64) -> i64:
        return self.base * k
    fn tag(self) -> i64:
        return 7

fn show(b: Backend) -> str:
    return b.label()

fn mul(b: Backend, k: i64) -> i64:
    return b.scaled(k)

fn tagof(b: Backend) -> i64:
    return b.tag()

fn named(n: Named) -> str:
    return n.label()

fn main():
    val s = Soft(base: 3)
    print(show(s))
    print(mul(s, 5))
    print(tagof(s))
    print(named(s))
