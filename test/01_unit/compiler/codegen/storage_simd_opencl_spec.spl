use std.spec.{describe, it, assert_true}
use std.common.structural.storage_layout.storage_layout_contracts.{
    StorageConversionPolicy, StorageLayoutKind, storage_layout_plan_v1
}
use compiler.backend.backend.backend_types.{compileoptions_default_options}
use compiler.backend.opencl_backend.{OpenClBackend}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.{
    MirFunction, MirModule, MirSignature, BlockId, LocalId
}
use compiler.mir.mir_instructions.{MirBlock, MirTerminator}
use compiler.mir.mir_types.{MirLocal, MirType, MirTypeKind, LocalKind}
use compiler.mir_opt.mir_opt.simd_recipe_infra.{VectorWidthRouter}
use compiler.mir_opt.mir_opt.storage_simd_admission.{storage_simd_admit}
use compiler.mir_opt.mir_opt.storage_simd_schedule.{storage_simd_schedule}
use compiler.mir_opt.mir_opt.storage_simd_codegen.{storage_simd_emit_full_block}

fn storage_opencl_arg(id: i64, index: i64, name: text, type_: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some(name), type_: type_,
        kind: LocalKind.Arg(index), is_ghost: false)

fn storage_opencl_temp(id: i64, type_: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_,
        kind: LocalKind.Temp, is_ghost: false)

fn storage_opencl_kernel() -> MirFunction:
    val vec = MirType(kind: MirTypeKind.Vec8f)
    val ptr = MirType.ptr(vec, true)
    val plan = storage_layout_plan_v1(71, StorageLayoutKind.AoSoA, 8, 32,
        false, StorageConversionPolicy.Cached, "opencl-storage", "simd-block")
    val admission = storage_simd_admit(
        plan, 32, 8, VectorWidthRouter.x86_64_avx2())
    val schedule = storage_simd_schedule(admission, 8, 96, 96, 1)
    val emitted = storage_simd_emit_full_block(
        schedule, 0, "f32", "Add", "opencl",
        LocalId(id: 1), LocalId(id: 2), LocalId(id: 3),
        LocalId(id: 10), LocalId(id: 11), LocalId(id: 12))
    MirFunction(
        symbol: SymbolId(id: 1), name: "storage_simd_add",
        signature: MirSignature(params: [ptr, ptr, ptr],
            return_type: MirType.unit(), is_variadic: false),
        locals: [
            storage_opencl_arg(1, 0, "a", ptr),
            storage_opencl_arg(2, 1, "b", ptr),
            storage_opencl_arg(3, 2, "out", ptr),
            storage_opencl_temp(10, vec), storage_opencl_temp(11, vec),
            storage_opencl_temp(12, vec)
        ],
        blocks: [MirBlock(id: BlockId.entry(), label: Some("entry"),
            instructions: emitted.instructions,
            terminator: MirTerminator.Ret(nil))],
        entry_block: BlockId.entry(), span: Span.empty(), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: true, gpu_target: "opencl",
        gpu_backend_order: "opencl", is_export_c: false, export_name: "",
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false)

describe "storage SIMD OpenCL integration":
    it "lowers storage-emitted typed MIR to executable OpenCL C":
        val function = storage_opencl_kernel()
        var functions: Dict<SymbolId, MirFunction> = {}
        functions[function.symbol] = function
        val module = MirModule(name: "storage_simd_opencl", functions: functions,
            statics: {}, constants: {}, types: {})
        val source = OpenClBackend.compile_module_to_opencl_source(module).unwrap()
        assert_true(source.contains("__kernel void storage_simd_add(__global float8* a, __global float8* b, __global float8* out)"))
        assert_true(source.contains("float8 v10 = *a;"))
        assert_true(source.contains("float8 v11 = *b;"))
        assert_true(source.contains("float8 v12 = v10 + v11;"))
        assert_true(source.contains("*out = v12;"))
