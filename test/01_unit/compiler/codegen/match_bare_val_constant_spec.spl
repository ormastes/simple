"""
## Purpose and audience
Purpose: Prove that bare val constants in match arms.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-CODEGEN-001 — stable requirement identity for this spec.

"""Regression coverage for bare `val` identifiers in match arms."""

use std.spec

val AUTH = "auth"
val USAGE = "usage"
val CODE_A = 11
val CODE_B = 29
val ENABLED = true
val DISABLED = false
var MUTABLE = 100

fn text_exit_code(kind: text) -> i64:
    match kind:
        case AUTH: 4
        case USAGE: 2
        case _: 1

fn integer_constant_code(kind: i64) -> i64:
    match kind:
        case CODE_A: 11
        case CODE_B: 29
        case _: -1

fn boolean_constant_code(kind: bool) -> i64:
    match kind:
        case ENABLED: 7
        case DISABLED: 3
        case _: -1

fn genuine_capture(value: i64) -> i64:
    match value:
        case captured: captured + 5

fn mutable_name_remains_capture(value: i64) -> i64:
    match value:
        case MUTABLE: MUTABLE + 1

describe "bare val constants in match arms":
    it "does not let the first text constant capture every subject":
        step("Verify: does not let the first text constant capture every subject")
        # @req: REQ-COMPILER-CODEGEN-001
        expect(text_exit_code(AUTH)).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(text_exit_code(USAGE)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(text_exit_code("other")).to_equal(1)

    it "routes adjacent integer constants to their own arms":
        step("Verify: routes adjacent integer constants to their own arms")
        expect(integer_constant_code(CODE_A)).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(integer_constant_code(CODE_B)).to_equal(29)  # oracle: 29 — named expected value from the requirement
        expect(integer_constant_code(99)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "compares adjacent boolean constants as values":
        step("Verify: compares adjacent boolean constants as values")
        expect(boolean_constant_code(ENABLED)).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(boolean_constant_code(DISABLED)).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "preserves an actually unbound identifier as a capture":
        step("Verify: preserves an actually unbound identifier as a capture")
        expect(genuine_capture(37)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "does not reinterpret a mutable module name as a constant pattern":
        step("Verify: does not reinterpret a mutable module name as a constant pattern")
        expect(mutable_name_remains_capture(8)).to_equal(9)  # oracle: 9 — named expected value from the requirement
