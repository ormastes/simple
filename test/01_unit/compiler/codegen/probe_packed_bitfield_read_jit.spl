# Run-path probe: `@packed` bitfield field reads must arrive at the formatter as
# TAGGED runtime values, exactly like every other scalar field read.
#
# Reproducer for
# doc/08_tracking/bug/jit_packed_bitfield_field_read_returns_nil_2026-08-10.md
#
# Under the JIT this printed `ready=nil ro=nil rsv=0`: the extracted bitfield
# scalar reached `rt_value_to_string` UNTAGGED, so the formatter read its low 3
# bits as a type tag — 1 -> "nil", 5 -> "<value:0x5>", 9 -> "<invalid-heap:0x9>",
# while 0 happened to render correctly and hid the defect.
#
# Every oracle below is an ABSOLUTE decimal literal this probe did not compute.
# Run with `bin/simple run`, under both SIMPLE_EXECUTION_MODE values.

@packed
struct Reg:
    ready: u32:1
    readonly: u32:1
    reserved: u32:30

@packed
struct Bytes:
    lo: u32:8
    mid: u32:8
    hi: u32:16

@packed
struct Mixed:
    lo: u32:4
    mid: u32:12
    hi: u32:16

struct Plain:
    q: u32

var failures: i64 = 0

fn check(name: text, got: text, want: text):
    if got == want:
        print "PASS " + name
    else:
        failures = failures + 1
        print "FAIL " + name + " got=" + got + " want=" + want

fn main() -> i64:
    print "PACKED BITFIELD PROBE START"
    var r = Reg(0)
    r.ready = 1
    r.readonly = 1

    # The three low bit-patterns that alias the runtime tag space.
    # 1 aliases TAG_HEAP-adjacent space and rendered as "nil"; this is the
    # exact expression from the bug report.
    check("bitfield_bit0_is_1", "{r.ready}", "1")
    check("bitfield_bit1_is_1", "{r.readonly}", "1")
    check("bitfield_wide_is_0", "{r.reserved}", "0")

    # Erased reads (string interpolation re-reads the raw word through the
    # value-tag decoder) and typed reads of the same three fields, named for
    # packed_bitfield_field_read_jit_spec.spl.
    check("status_erased_ready", "{r.ready}", "1")
    check("status_erased_readonly", "{r.readonly}", "1")
    check("status_erased_reserved", "{r.reserved}", "0")
    val t_ready: u32 = r.ready
    val t_readonly: u32 = r.readonly
    val t_reserved: u32 = r.reserved
    check("status_typed_ready", "{t_ready}", "1")
    check("status_typed_readonly", "{t_readonly}", "1")
    check("status_typed_reserved", "{t_reserved}", "0")

    # A zero-valued field is the case that accidentally survived the original
    # defect (raw 0 decodes as a tagged zero); it must stay correct.
    var z = Reg(0)
    check("status_zero_erased_ready", "{z.ready}", "0")
    val z_ready: u32 = z.ready
    check("status_zero_typed_ready", "{z_ready}", "0")

    var b = Bytes(0)
    b.lo = 5
    b.mid = 9
    b.hi = 300

    # 5 rendered as "<value:0x5>", 9 as "<invalid-heap:0x9>" before the fix.
    check("bitfield_byte0_is_5", "{b.lo}", "5")
    check("bitfield_byte1_is_9", "{b.mid}", "9")
    check("bitfield_word_is_300", "{b.hi}", "300")

    # A multiple of 8 has tag bits 0, so it is read back as a BOXED int and
    # silently DIVIDED BY 8 (measured: 8 rendered as "1"). This is the quietest
    # form of the defect — a plausible small number, no marker text at all.
    b.lo = 8
    check("bitfield_byte0_is_8", "{b.lo}", "8")

    # Control arm: an ordinary (non-bitfield) u32 struct field. This path was
    # never broken; a red here means the probe or the harness is wrong, not
    # the bitfield lowering.
    val p = Plain(7)
    check("plain_u32_field_is_7", "{p.q}", "7")

    # Round-tripping through a local was the documented WORKAROUND — it must
    # keep working too.
    val via_local: u32 = r.ready
    check("bitfield_via_local_is_1", "{via_local}", "1")

    # Widths 4/12/16 at offsets 0/4/16. Payloads chosen so their low 3 bits
    # alias distinct tag decodings (9 -> nil, 2730 -> float, 43981 -> 0x5
    # special), so a raw-vs-tagged confusion cannot coincidentally agree.
    var m = Mixed(0)
    m.lo = 9
    m.mid = 2730
    m.hi = 43981
    check("mixed_erased_lo", "{m.lo}", "9")
    check("mixed_erased_mid", "{m.mid}", "2730")
    check("mixed_erased_hi", "{m.hi}", "43981")
    val m_lo: u32 = m.lo
    val m_mid: u32 = m.mid
    val m_hi: u32 = m.hi
    check("mixed_typed_lo", "{m_lo}", "9")
    check("mixed_typed_mid", "{m_mid}", "2730")
    check("mixed_typed_hi", "{m_hi}", "43981")

    # A field read must survive arithmetic, not only printing.
    check("mixed_arith", "{m.lo + m.mid}", "2739")

    if failures == 0:
        print "PACKED_BITFIELD_READ PROBE: ALL PASS"
        print "PACKED BITFIELD PROBE: ALL PASS"
    else:
        print "PACKED_BITFIELD_READ PROBE: FAILURES"
        print "PACKED BITFIELD PROBE: FAILURES"
    0
