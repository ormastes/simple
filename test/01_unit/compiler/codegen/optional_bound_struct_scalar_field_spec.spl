# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# Optional-bound struct scalar field read
#
# Regression coverage for
# doc/08_tracking/bug/bootstrap_stage2_native_capsule_receipt_mismatch_equal_byte_counts_2026-09-12.md
#
# Reading an `i64` scalar field off a struct that was bound through an Optional
# (`if val fp = opt:` / `match opt: case Some(fp):`) returned a fresh tagged
# heap pointer per read under the SELF-HOSTED native codegen instead of the
# integer value (observed 53657758209 / 53657761281 for a 632-byte object).
# A `text` field read fine, because a pointer is the right representation for
# text -- only the scalar fields exposed the missing unbox.
#
# This spec runs on the seed interpreter, where the semantics are already
# correct; it pins the ORACLE. The native half of the evidence is the probe
# `test/01_unit/compiler/codegen/probe_optional_bound_struct_scalar_field.spl`,
# which the self-hosted lane builds and runs.

use std.spec.step

use std.spec.*


struct FieldProbe:
    size: i64
    width: i32
    ready: bool
    ratio: f64
    name: text


fn probe_of(n: i64) -> FieldProbe?:
    return FieldProbe(size: n, width: 17, ready: true, ratio: 2.5, name: "obj")


struct ProbeHolder:
    inner: FieldProbe?


fn nested_probe(n: i64) -> ProbeHolder?:
    return ProbeHolder(inner: probe_of(n))


describe "optional-bound struct scalar field reads":
    it "reads an i64 field off an if-val bound struct as its value":
        # @req REQ-SSPEC-UNIT
        step("reads an i64 field off an if-val bound struct as its value")
        var seen = -1
        if val fp = probe_of(632):
            seen = fp.size
        expect(seen).to_equal(632)

    it "reads the same i64 field twice without producing two distinct values":
        # @req REQ-SSPEC-UNIT
        step("reads the same i64 field twice without producing two distinct values")
        var first = -1
        var second = -2
        if val fp = probe_of(632):
            first = fp.size
            second = fp.size
        expect(first == second).to_equal(true)

    it "reads an i64 field off a match-bound struct as its value":
        # @req REQ-SSPEC-UNIT
        step("reads an i64 field off a match-bound struct as its value")
        var seen = -1
        match probe_of(632):
            case Some(fp):
                seen = fp.size
            case None:
                seen = -1
        expect(seen).to_equal(632)

    it "reads an i32 field off an optional-bound struct as its value":
        # @req REQ-SSPEC-UNIT
        step("reads an i32 field off an optional-bound struct as its value")
        var seen = -1
        if val fp = probe_of(632):
            seen = fp.width as i64
        expect(seen).to_equal(17)

    it "reads a bool field off an optional-bound struct as its value":
        # @req REQ-SSPEC-UNIT
        step("reads a bool field off an optional-bound struct as its value")
        var seen = false
        if val fp = probe_of(632):
            seen = fp.ready
        expect(seen).to_equal(true)

    it "reads an f64 field off an optional-bound struct as its value":
        # @req REQ-SSPEC-UNIT
        step("reads an f64 field off an optional-bound struct as its value")
        var seen = 0.0
        if val fp = probe_of(632):
            seen = fp.ratio
        expect(seen == 2.5).to_equal(true)

    it "reads a text field off an optional-bound struct as its value":
        # @req REQ-SSPEC-UNIT
        step("reads a text field off an optional-bound struct as its value")
        var seen = ""
        if val fp = probe_of(632):
            seen = fp.name
        expect(seen).to_equal("obj")

    it "reads an i64 field through a nested optional binding":
        # @req REQ-SSPEC-UNIT
        step("reads an i64 field through a nested optional binding")
        var seen = -1
        if val outer = nested_probe(632):
            if val fp = outer.inner:
                seen = fp.size
        expect(seen).to_equal(632)
