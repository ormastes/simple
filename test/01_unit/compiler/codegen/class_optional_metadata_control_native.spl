# Isolate class metadata from the separately recorded assert-to-libc ABI bug.
# The native runner requires exactly the success marker; either mismatch fails.
class MetadataCounter:
    value: i64

    fn read() -> i64:
        self.value

@export("C", name: "metadata_export_counter")
class ExportedMetadataCounter:
    """Positive export and doc-comment presence must preserve both payloads."""
    value: i64

    fn read() -> i64:
        self.value

fn main():
    val counter = MetadataCounter(value: 37)
    if counter.read() != 37:
        print "ordinary-class-value-mismatch"
        return
    val exported = ExportedMetadataCounter(value: 42)
    if exported.read() != 42:
        print "exported-class-value-mismatch"
        return
    print "class-optional-metadata-ok"
