# Pattern desugaring synthesizes untyped boolean expressions. Their absent
# type metadata must stay absent when condition lowering reads the HIR node.
fn classify(kind: text) -> i64:
    match kind:
        case "int": 10
        case "float": 20
        case _: 30

fn main():
    if classify("int") != 10:
        print "int-pattern-mismatch"
        return
    if classify("float") != 20:
        print "float-pattern-mismatch"
        return
    if classify("other") != 30:
        print "fallback-pattern-mismatch"
        return
    print "pattern-condition-metadata-ok"
