# @cover src/compiler/70.backend/backend/gpu_portable_compute.spl 5%
# @tag: unit, compiler, gpu, metal, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "portable Metal prelude source contract":
    it "wraps standalone sources and normalizes combined modules":
        val source = rt_file_read_text(
            "src/compiler/70.backend/backend/gpu_portable_compute.spl"
        ) ?? ""

        expect(source).to_contain("\"#include <metal_stdlib>\\nusing namespace metal;\\n\"")
        expect(source).to_contain("return portable_compute_metal_prelude() + body")
        expect(source).to_contain("source: portable_compute_source(target, source)")
        expect(source).to_contain(
            "source = portable_compute_source(target, source.replace(portable_compute_metal_prelude(), \"\"))"
        )
