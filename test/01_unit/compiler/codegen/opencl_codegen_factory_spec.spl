# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/plugins/backend_registry/full_static_backend_registry.spl
# @tag: unit, compiler, gpu, codegen, opencl
#
# CodegenFactory resolves through the INSTALLED static backend table. The
# default K1 table is an unselected stub, so without a composition root every
# factory request answers PLUG-E-NOTFOUND. This spec binds the committed
# llvm-cranelift composition plus its P-static plugin table (which carries
# OpenCL), exactly as backend_port_negotiate_spec does.
#
# Kept separate from opencl_backend_contract_spec: the P-static registry loads
# plugins.backend_opencl.opencl_backend, whose `OpenClBackend` shares a bare
# name with compiler.backend.backend.opencl_backend's, and the seed resolves a
# bare class name used by the spec entry as ambiguous when both are loaded.
# Note: this row therefore exercises the plugin copy
# (src/plugins/backend_opencl/opencl_backend.spl, the production route), while
# opencl_backend_contract_spec exercises the diverged 70.backend copy.

use std.spec.step

use compiler.backend.backend.backend_types.{BackendKind, compileoptions_default_options}
use compiler.backend.codegen_factory.{CodegenFactory}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.{MirFunction, MirModule, MirSignature, BlockId, LocalId}
use compiler.mir.mir_instructions.{MirBlock, MirInst, MirInstKind, MirTerminator, GpuBarrierScope}
use compiler.mir.mir_types.{MirType}
use compositions.kernel_llvm_cranelift.compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use plugins.backend_registry.full_static_backend_registry.{
    install_full_static_backends_for_k1_policy_v1}

fn opencl_id_kernel_block() -> MirBlock:
    MirBlock(
        id: BlockId.entry(),
        label: Some("entry"),
        instructions: [
            MirInst(kind: MirInstKind.GpuGlobalId(LocalId(id: 0), 0), span: nil),
            MirInst(kind: MirInstKind.GpuLocalId(LocalId(id: 1), 0), span: nil),
            MirInst(kind: MirInstKind.GpuBarrier(GpuBarrierScope.Workgroup), span: nil)
        ],
        terminator: MirTerminator.Ret(nil)
    )

fn make_opencl_id_kernel() -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: 4),
        name: "opencl_id_kernel",
        signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
        locals: [],
        blocks: [opencl_id_kernel_block()],
        entry_block: BlockId.entry(),
        span: Span.empty(),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: true,
        gpu_target: "opencl",
        gpu_backend_order: "opencl",
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false
    )

fn make_kernel_module(functions: [MirFunction]) -> MirModule:
    var map: Dict<SymbolId, MirFunction> = {}
    for fn_ in functions:
        map[fn_.symbol] = fn_
    MirModule(name: "gpu_target_module", functions: map, statics: {}, constants: {}, types: {})

describe "OpenCL codegen factory":
    # @manual scenario evidence

    it "compiles tagged OpenCL kernels through the shared Codegen factory interface":
        # @req REQ-SSPEC-COMPILER
        step("compiles tagged OpenCL kernels through the shared Codegen factory interface")
        expect(install_selected_k1_backend_table_v1()).to_equal(true)
        expect(install_full_static_backends_for_k1_policy_v1(selected_k1_backend_policy_v1())).to_equal(true)
        val module = make_kernel_module([make_opencl_id_kernel()])
        val codegen = CodegenFactory.create(BackendKind.OpenCl, compileoptions_default_options())
        expect(codegen.backend_name()).to_equal("opencl")
        val result = codegen.compile_module(module)

        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(output.name).to_equal("gpu_target_module")
        expect(output.kind == CodegenOutputKind.GpuCode).to_equal(true)
        expect(output.has_text_output).to_equal(true)
        expect(output.has_object_code).to_equal(false)
        expect(output.text_output).to_contain("__kernel void opencl_id_kernel")
        expect(output.text_output).to_contain("get_global_id(0)")
