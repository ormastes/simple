"""
## Purpose and audience
Purpose: Prove that CUDA backend intensive MIR contract.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-CODEGEN-001 — stable requirement identity for this spec.

# @cover src/compiler/70.backend/backend/cuda_backend.spl 80%
# @tag: unit, compiler, gpu, codegen, cuda

use compiler.backend.backend.backend_types.{BackendKind}
use compiler.backend.cuda_backend.{CudaBackend}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.{MirFunction, MirModule, MirSignature, BlockId, LocalId}
use compiler.mir.mir_instructions.{MirBlock, MirInst, MirInstKind, MirTerminator, MirOperand, MirOperandKind, MirBinOp, MirUnaryOp, GpuAtomicOpKind}
use compiler.mir.mir_types.{MirLocal, MirType, MirTypeKind, MirConstValue, LocalKind, MirTypeDef, MirTypeDefKind, MirFieldDef}
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn cuda_i32() -> MirType: MirType(kind: MirTypeKind.I32)
fn cuda_i64() -> MirType: MirType(kind: MirTypeKind.I64)
fn cuda_i16() -> MirType: MirType(kind: MirTypeKind.I16)
fn cuda_i8() -> MirType: MirType(kind: MirTypeKind.I8)
fn cuda_u32() -> MirType: MirType(kind: MirTypeKind.U32)
fn cuda_u64() -> MirType: MirType(kind: MirTypeKind.U64)
fn cuda_u16() -> MirType: MirType(kind: MirTypeKind.U16)
fn cuda_u8() -> MirType: MirType(kind: MirTypeKind.U8)
fn cuda_f32() -> MirType: MirType(kind: MirTypeKind.F32)
fn cuda_f64() -> MirType: MirType(kind: MirTypeKind.F64)
fn cuda_bool() -> MirType: MirType(kind: MirTypeKind.Bool)
fn cuda_ptr() -> MirType: MirType.ptr(cuda_u32(), true)
fn cuda_i32_ptr() -> MirType: MirType.ptr(cuda_i32(), true)
fn cuda_u64_ptr() -> MirType: MirType.ptr(cuda_u64(), true)

fn cuda_arg(id: i64, index: i64, name: text, ty: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some(name), type_: ty, kind: LocalKind.Arg(index), is_ghost: false)

fn cuda_temp(id: i64, ty: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: ty, kind: LocalKind.Temp, is_ghost: false)

fn cuda_function(id: i64, name: text, params: [MirType], ret: MirType, locals: [MirLocal], blocks: [MirBlock], kernel: bool) -> MirFunction:
    MirFunction(
        symbol: SymbolId(id: id), name: name,
        signature: MirSignature(params: params, return_type: ret, is_variadic: false),
        locals: locals, blocks: blocks, entry_block: BlockId.entry(), span: Span.empty(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: kernel,
        gpu_target: "cuda", gpu_backend_order: "cuda", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )

fn cuda_module(functions: [MirFunction]) -> MirModule:
    var map: Dict<SymbolId, MirFunction> = {}
    for fn_ in functions: map[fn_.symbol] = fn_
    MirModule(name: "cuda_intensive", functions: map, statics: {}, constants: {}, types: {})

fn cuda_module_with_types(functions: [MirFunction], types: Dict<SymbolId, MirTypeDef>) -> MirModule:
    var map: Dict<SymbolId, MirFunction> = {}
    for fn_ in functions: map[fn_.symbol] = fn_
    MirModule(name: "cuda_intensive", functions: map, statics: {}, constants: {}, types: types)

fn compile_supported_cuda(functions: [MirFunction]) -> text:
    val result = CudaBackend.create((8, 6)).compile(cuda_module(functions))
    result.unwrap().ptx

fn reject_unsupported_cuda(fn_: MirFunction):
    val result = CudaBackend.create((8, 6)).compile(cuda_module([fn_]))
    expect(result.is_err()).to_equal(true)

fn assert_module_backend_error_contains(functions: [MirFunction], fragment: text):
    val result = CudaBackend.create((8, 6)).compile(cuda_module(functions))
    expect(result.is_err()).to_equal(true)
    val error = result.unwrap_err()
    expect(error.phase).to_contain(BackendKind.Cuda.to_text())
    expect(error.message).to_contain(fragment)

fn assert_backend_error_contains(fn_: MirFunction, fragment: text):
    val result = CudaBackend.create((8, 6)).compile(cuda_module([fn_]))
    expect(result.is_err()).to_equal(true)
    val error = result.unwrap_err()
    expect(error.phase).to_contain(BackendKind.Cuda.to_text())
    expect(error.message).to_contain(fragment)

fn assert_no_placeholder_output(ptx: text):
    expect(ptx.contains("Unsupported")).to_equal(false)
    expect(ptx.contains("placeholder")).to_equal(false)
    expect(ptx.contains("not implemented")).to_equal(false)

fn compile_cuda_bounds_check(index_type: MirType, name: text, id: i64) -> text:
    val block = MirBlock(
        id: BlockId.entry(), label: Some("entry"),
        instructions: [MirInst(kind: MirInstKind.Intrinsic(nil, "bounds_check", [
            MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))
        ]), span: nil)],
        terminator: MirTerminator.Ret(nil)
    )
    val fn_ = cuda_function(
        id, name, [index_type, cuda_i64()], MirType.unit(),
        [cuda_arg(0, 0, "index", index_type), cuda_arg(1, 1, "length", cuda_i64())],
        [block], true
    )
    compile_supported_cuda([fn_])

fn cuda_compare_function(id: i64, name: text, op: MirBinOp, operand_type: MirType) -> MirFunction:
    val block = MirBlock(
        id: BlockId.entry(), label: Some("entry"),
        instructions: [MirInst(kind: MirInstKind.BinOp(
            LocalId(id: 2), op,
            MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))
        ), span: nil)],
        terminator: MirTerminator.Ret(nil)
    )
    cuda_function(
        id, name, [operand_type, operand_type], MirType.unit(),
        [
            cuda_arg(0, 0, "left", operand_type),
            cuda_arg(1, 1, "right", operand_type),
            cuda_temp(2, cuda_bool())
        ],
        [block], true
    )

fn cuda_bitcast_function(id: i64, name: text, source_type: MirType, dest_type: MirType, target_type: MirType) -> MirFunction:
    val block = MirBlock(
        id: BlockId.entry(), label: Some("entry"),
        instructions: [MirInst(kind: MirInstKind.Bitcast(
            LocalId(id: 1), MirOperand.copy(LocalId(id: 0)), target_type
        ), span: nil)],
        terminator: MirTerminator.Ret(nil)
    )
    cuda_function(
        id, name, [source_type], MirType.unit(),
        [cuda_arg(0, 0, "source", source_type), cuda_temp(1, dest_type)],
        [block], true
    )

fn cuda_unary_function(id: i64, name: text, op: MirUnaryOp, source_type: MirType, dest_type: MirType) -> MirFunction:
    val block = MirBlock(
        id: BlockId.entry(), label: Some("entry"),
        instructions: [MirInst(kind: MirInstKind.UnaryOp(
            LocalId(id: 1), op, MirOperand.copy(LocalId(id: 0))
        ), span: nil)],
        terminator: MirTerminator.Ret(nil)
    )
    cuda_function(
        id, name, [source_type], MirType.unit(),
        [cuda_arg(0, 0, "value", source_type), cuda_temp(1, dest_type)],
        [block], true
    )

fn cuda_neg_function(id: i64, name: text, ty: MirType) -> MirFunction:
    cuda_unary_function(id, name, MirUnaryOp.Neg, ty, ty)

use std.spec.step

describe "CUDA backend intensive MIR contract":
    it "lowers validated logical and bitwise CUDA unary operations":
        step("Verify: lowers validated logical and bitwise CUDA unary operations")
        # @req: REQ-COMPILER-CODEGEN-001
        val ptx = compile_supported_cuda([
            cuda_neg_function(45, "cuda_neg_u16", cuda_u16()),
            cuda_unary_function(46, "cuda_not_bool", MirUnaryOp.Not, cuda_bool(), cuda_bool()),
            cuda_unary_function(47, "cuda_bitnot_i16", MirUnaryOp.BitNot, cuda_i16(), cuda_i16()),
            cuda_unary_function(48, "cuda_bitnot_u16", MirUnaryOp.BitNot, cuda_u16(), cuda_u16()),
            cuda_unary_function(49, "cuda_bitnot_i32", MirUnaryOp.BitNot, cuda_i32(), cuda_i32()),
            cuda_unary_function(50, "cuda_bitnot_u32", MirUnaryOp.BitNot, cuda_u32(), cuda_u32()),
            cuda_unary_function(51, "cuda_bitnot_i64", MirUnaryOp.BitNot, cuda_i64(), cuda_i64()),
            cuda_unary_function(52, "cuda_bitnot_u64", MirUnaryOp.BitNot, cuda_u64(), cuda_u64())
        ])

        expect(ptx).to_contain("sub.u16 %r1, 0, %r0;")
        expect(ptx).to_contain("not.pred %r1, %r0;")
        expect(ptx).to_contain("not.b16 %r1, %r0;")
        expect(ptx).to_contain("not.b32 %r1, %r0;")
        expect(ptx).to_contain("not.b64 %r1, %r0;")

        val instr_145 = "sub.u16 %r1, 0, %r0;"
        val instr_145_start = ptx.find(instr_145)
        val capture_145 = UntypedCapture(label: "cuda-logical-bitwise-unary-ptx", raw_value: ptx.substring(instr_145_start, instr_145_start + instr_145.len()), source_kind: "log_line")
        val evidence_145 = untyped_capture_to_canonical(capture_145, "cuda_backend_intensive_contract_spec/logical-bitwise-unary")
        val comparison_145 = compare_evidence(evidence_145, oracle_spec("cuda_backend_intensive_contract_spec/logical-bitwise-unary", [
            check_exact("value", instr_145)
        ]))
        expect(comparison_145.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_unary.ptx"
            val cubin_path = "/tmp/simple_cuda_unary.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")

    it "rejects malformed and unsupported CUDA unary operations":
        step("Verify: rejects malformed and unsupported CUDA unary operations")
        val mismatch = cuda_unary_function(
            53, "cuda_bad_unary_mismatch", MirUnaryOp.Neg, cuda_u32(), cuda_i32()
        )
        assert_backend_error_contains(mismatch, "destination and operand types must match")

        val integer_not = cuda_unary_function(
            54, "cuda_bad_integer_not", MirUnaryOp.Not, cuda_u32(), cuda_u32()
        )
        assert_backend_error_contains(integer_not, "logical Not requires a Bool operand")

        val float_bitnot = cuda_unary_function(
            55, "cuda_bad_float_bitnot", MirUnaryOp.BitNot, cuda_f32(), cuda_f32()
        )
        assert_backend_error_contains(float_bitnot, "BitNot requires a 16-bit, 32-bit, or 64-bit integer operand")

        val narrow_signed = cuda_neg_function(56, "cuda_bad_i8_neg", cuda_i8())
        assert_backend_error_contains(narrow_signed, "negation requires a 16-bit, 32-bit, or 64-bit integer")

        val narrow_unsigned = cuda_neg_function(57, "cuda_bad_u8_neg", cuda_u8())
        assert_backend_error_contains(narrow_unsigned, "negation requires a 16-bit, 32-bit, or 64-bit integer")

        val pointer_neg = cuda_neg_function(58, "cuda_bad_pointer_neg", cuda_ptr())
        assert_backend_error_contains(pointer_neg, "negation requires a 16-bit, 32-bit, or 64-bit integer")

    it "lowers unsigned negation with legal modulo-width PTX":
        step("Verify: lowers unsigned negation with legal modulo-width PTX")
        val ptx = compile_supported_cuda([
            cuda_neg_function(43, "cuda_neg_u32", cuda_u32()),
            cuda_neg_function(44, "cuda_neg_u64", cuda_u64())
        ])

        expect(ptx).to_contain("sub.u32 %r1, 0, %r0;")
        expect(ptx).to_contain("sub.u64 %r1, 0, %r0;")
        expect(ptx.contains("neg.u32")).to_equal(false)
        expect(ptx.contains("neg.u64")).to_equal(false)

        val instr_197 = "sub.u32 %r1, 0, %r0;"
        val instr_197_start = ptx.find(instr_197)
        val capture_197 = UntypedCapture(label: "cuda-unsigned-neg-ptx", raw_value: ptx.substring(instr_197_start, instr_197_start + instr_197.len()), source_kind: "log_line")
        val evidence_197 = untyped_capture_to_canonical(capture_197, "cuda_backend_intensive_contract_spec/unsigned-neg")
        val comparison_197 = compare_evidence(evidence_197, oracle_spec("cuda_backend_intensive_contract_spec/unsigned-neg", [
            check_exact("value", instr_197)
        ]))
        expect(comparison_197.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_unsigned_neg.ptx"
            val cubin_path = "/tmp/simple_cuda_unsigned_neg.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")

    it "emits width-correct CUDA bitcasts and assembles them":
        step("Verify: emits width-correct CUDA bitcasts and assembles them")
        val ptx = compile_supported_cuda([
            cuda_bitcast_function(34, "cuda_f32_to_u32", cuda_f32(), cuda_u32(), cuda_u32()),
            cuda_bitcast_function(35, "cuda_u32_to_f32", cuda_u32(), cuda_f32(), cuda_f32()),
            cuda_bitcast_function(39, "cuda_f64_to_u64", cuda_f64(), cuda_u64(), cuda_u64()),
            cuda_bitcast_function(40, "cuda_u64_to_f64", cuda_u64(), cuda_f64(), cuda_f64())
        ])

        expect(ptx).to_contain("mov.b32 %r1, %r0;")
        expect(ptx).to_contain("mov.b64 %r1, %r0;")

        val instr_217 = "mov.b32 %r1, %r0;"
        val instr_217_start = ptx.find(instr_217)
        val capture_217 = UntypedCapture(label: "cuda-bitcasts-ptx", raw_value: ptx.substring(instr_217_start, instr_217_start + instr_217.len()), source_kind: "log_line")
        val evidence_217 = untyped_capture_to_canonical(capture_217, "cuda_backend_intensive_contract_spec/bitcasts")
        val comparison_217 = compare_evidence(evidence_217, oracle_spec("cuda_backend_intensive_contract_spec/bitcasts", [
            check_exact("value", instr_217)
        ]))
        expect(comparison_217.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_bitcasts.ptx"
            val cubin_path = "/tmp/simple_cuda_bitcasts.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")

    it "rejects malformed CUDA bitcasts":
        step("Verify: rejects malformed CUDA bitcasts")
        val width_mismatch = cuda_bitcast_function(
            36, "cuda_bad_bitcast_width", cuda_f32(), cuda_u64(), cuda_u64()
        )
        assert_backend_error_contains(width_mismatch, "source and target widths must match")

        val target_mismatch = cuda_bitcast_function(
            37, "cuda_bad_bitcast_target", cuda_u32(), cuda_u32(), cuda_f32()
        )
        assert_backend_error_contains(target_mismatch, "destination type must match target type")

        val pointer_target_mismatch = cuda_bitcast_function(
            41, "cuda_bad_pointer_bitcast_target", cuda_u64(), cuda_ptr(), cuda_u64()
        )
        assert_backend_error_contains(pointer_target_mismatch, "destination type must match target type")

        val unsupported_target = cuda_bitcast_function(
            42, "cuda_bad_unit_bitcast_target", cuda_u64(), MirType.unit(), MirType.unit()
        )
        assert_backend_error_contains(unsupported_target, "32-bit or 64-bit scalar or pointer target")

        val predicate_source = cuda_bitcast_function(
            38, "cuda_bad_bitcast_predicate", cuda_bool(), cuda_u32(), cuda_u32()
        )
        assert_backend_error_contains(predicate_source, "32-bit or 64-bit scalar or pointer source")

    it "lowers comparisons with operand PTX types and assembles them":
        step("Verify: lowers comparisons with operand PTX types and assembles them")
        val ptx = compile_supported_cuda([
            cuda_compare_function(16, "cuda_compare_u32", MirBinOp.Eq, cuda_u32()),
            cuda_compare_function(17, "cuda_compare_i64", MirBinOp.Lt, cuda_i64()),
            cuda_compare_function(18, "cuda_compare_u64", MirBinOp.Ge, cuda_u64()),
            cuda_compare_function(19, "cuda_compare_f32", MirBinOp.Ne, cuda_f32())
        ])

        expect(ptx).to_contain("setp.eq.u32 %r2, %r0, %r1;")
        expect(ptx).to_contain("setp.lt.s64 %r2, %r0, %r1;")
        expect(ptx).to_contain("setp.ge.u64 %r2, %r0, %r1;")
        expect(ptx).to_contain("setp.ne.f32 %r2, %r0, %r1;")
        expect(ptx.contains("setp.eq.pred")).to_equal(false)

        val instr_263 = "setp.eq.u32 %r2, %r0, %r1;"
        val instr_263_start = ptx.find(instr_263)
        val capture_263 = UntypedCapture(label: "cuda-comparisons-ptx", raw_value: ptx.substring(instr_263_start, instr_263_start + instr_263.len()), source_kind: "log_line")
        val evidence_263 = untyped_capture_to_canonical(capture_263, "cuda_backend_intensive_contract_spec/comparisons")
        val comparison_263 = compare_evidence(evidence_263, oracle_spec("cuda_backend_intensive_contract_spec/comparisons", [
            check_exact("value", instr_263)
        ]))
        expect(comparison_263.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_comparisons.ptx"
            val cubin_path = "/tmp/simple_cuda_comparisons.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")

    it "rejects malformed CUDA comparison types":
        step("Verify: rejects malformed CUDA comparison types")
        val non_bool_dest = cuda_function(
            13, "cuda_compare_non_bool", [cuda_u32(), cuda_u32()], MirType.unit(),
            [cuda_arg(0, 0, "left", cuda_u32()), cuda_arg(1, 1, "right", cuda_u32()), cuda_temp(2, cuda_u32())],
            [MirBlock(
                id: BlockId.entry(), label: Some("entry"),
                instructions: [MirInst(kind: MirInstKind.BinOp(
                    LocalId(id: 2), MirBinOp.Eq,
                    MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))
                ), span: nil)],
                terminator: MirTerminator.Ret(nil)
            )], true
        )
        assert_backend_error_contains(non_bool_dest, "comparison destination must be Bool")

        val mismatched = cuda_function(
            14, "cuda_compare_mismatch", [cuda_u32(), cuda_i64()], MirType.unit(),
            [cuda_arg(0, 0, "left", cuda_u32()), cuda_arg(1, 1, "right", cuda_i64()), cuda_temp(2, cuda_bool())],
            [MirBlock(
                id: BlockId.entry(), label: Some("entry"),
                instructions: [MirInst(kind: MirInstKind.BinOp(
                    LocalId(id: 2), MirBinOp.Lt,
                    MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))
                ), span: nil)],
                terminator: MirTerminator.Ret(nil)
            )], true
        )
        assert_backend_error_contains(mismatched, "comparison operand types must match")

        val predicates = cuda_compare_function(15, "cuda_compare_predicates", MirBinOp.Eq, cuda_bool())
        assert_backend_error_contains(predicates, "comparison operands must be I32, I64, U32, U64, F32, or F64")

    it "assembles I64, U64-global, and direct U32 GPU index paths":
        step("Verify: assembles I64, U64-global, and direct U32 GPU index paths")
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [
            MirInst(kind: MirInstKind.GpuGlobalId(LocalId(id: 0), 0), span: nil),
            MirInst(kind: MirInstKind.GpuLocalId(LocalId(id: 1), 1), span: nil),
            MirInst(kind: MirInstKind.GpuBlockId(LocalId(id: 2), 2), span: nil),
            MirInst(kind: MirInstKind.GpuBlockDim(LocalId(id: 3), 0), span: nil),
            MirInst(kind: MirInstKind.GpuGridDim(LocalId(id: 4), 1), span: nil),
            MirInst(kind: MirInstKind.GpuLocalId(LocalId(id: 5), 0), span: nil),
            MirInst(kind: MirInstKind.GpuGlobalId(LocalId(id: 6), 2), span: nil)
        ], terminator: MirTerminator.Ret(nil))
        val locals = [
            cuda_temp(0, cuda_i64()), cuda_temp(1, cuda_i64()), cuda_temp(2, cuda_i64()),
            cuda_temp(3, cuda_i64()), cuda_temp(4, cuda_i64()), cuda_temp(5, cuda_u32()),
            cuda_temp(6, cuda_u64())
        ]
        val fn_ = cuda_function(20, "cuda_i64_indices", [], MirType.unit(), locals, [block], true)
        val ptx = compile_supported_cuda([fn_])
        expect(ptx).to_contain("cvt.s64.u32 %r10, %r7;")
        expect(ptx).to_contain("mul.lo.s64 %r13, %r11, %r12;")
        expect(ptx).to_contain("add.s64 %r0, %r13, %r10;")
        expect(ptx).to_contain("mov.u32 %r14, %tid.y;")
        expect(ptx).to_contain("cvt.s64.u32 %r1, %r14;")
        expect(ptx).to_contain("mov.u32 %r15, %ctaid.z;")
        expect(ptx).to_contain("mov.u32 %r16, %ntid.x;")
        expect(ptx).to_contain("mov.u32 %r17, %nctaid.y;")
        expect(ptx).to_contain("mov.u32 %r5, %tid.x;")
        expect(ptx).to_contain("cvt.u64.u32 %r21, %r18;")
        expect(ptx).to_contain("mul.lo.u64 %r24, %r22, %r23;")
        expect(ptx).to_contain("add.u64 %r6, %r24, %r21;")
        expect(ptx.contains(".reg .u32 %r0;")).to_equal(false)

        val instr_318 = "cvt.s64.u32 %r10, %r7;"
        val instr_318_start = ptx.find(instr_318)
        val capture_318 = UntypedCapture(label: "cuda-gpu-index-paths-ptx", raw_value: ptx.substring(instr_318_start, instr_318_start + instr_318.len()), source_kind: "log_line")
        val evidence_318 = untyped_capture_to_canonical(capture_318, "cuda_backend_intensive_contract_spec/gpu-index-paths")
        val comparison_318 = compare_evidence(evidence_318, oracle_spec("cuda_backend_intensive_contract_spec/gpu-index-paths", [
            check_exact("value", instr_318)
        ]))
        expect(comparison_318.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_i64_indices.ptx"
            val cubin_path = "/tmp/simple_cuda_i64_indices.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")
        else:
            expect(ptx).to_contain(".target sm_86")

    it "keeps U32 dimensions direct in explicit dimension-only kernels":
        step("Verify: keeps U32 dimensions direct in explicit dimension-only kernels")
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [
            MirInst(kind: MirInstKind.GpuBlockDim(LocalId(id: 0), 2), span: nil),
            MirInst(kind: MirInstKind.GpuGridDim(LocalId(id: 1), 0), span: nil)
        ], terminator: MirTerminator.Ret(nil))
        val fn_ = cuda_function(
            21, "cuda_u32_dimensions", [], MirType.unit(),
            [cuda_temp(0, cuda_u32()), cuda_temp(1, cuda_u32())],
            [block], true
        )
        val ptx = compile_supported_cuda([fn_])
        expect(ptx).to_contain(".visible .entry cuda_u32_dimensions(")
        expect(ptx).to_contain("mov.u32 %r0, %ntid.z;")
        expect(ptx).to_contain("mov.u32 %r1, %nctaid.x;")
        expect(ptx.contains("cvt.")).to_equal(false)

    it "rejects invalid GPU index dimensions and destination types":
        step("Verify: rejects invalid GPU index dimensions and destination types")
        val bad_dim_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.GpuGlobalId(LocalId(id: 0), 3), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_dim = cuda_function(22, "cuda_bad_index_dim", [], MirType.unit(), [cuda_temp(0, cuda_i64())], [bad_dim_block], true)
        assert_backend_error_contains(bad_dim, "dimension must be 0, 1, or 2")

        val bad_type_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.GpuLocalId(LocalId(id: 0), 0), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_type = cuda_function(23, "cuda_bad_index_type", [], MirType.unit(), [cuda_temp(0, cuda_i32())], [bad_type_block], true)
        assert_backend_error_contains(bad_type, "destination must be U32, I64, or U64")

    it "emits if branches and loop backedges as executable PTX control flow":
        step("Verify: emits if branches and loop backedges as executable PTX control flow")
        val blocks = [
            MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [], terminator: MirTerminator.If(MirOperand.copy(LocalId(id: 0)), BlockId(id: 1), BlockId(id: 3))),
            MirBlock(id: BlockId(id: 1), label: Some("loop"), instructions: [], terminator: MirTerminator.Goto(BlockId(id: 2))),
            MirBlock(id: BlockId(id: 2), label: Some("backedge"), instructions: [], terminator: MirTerminator.Goto(BlockId(id: 1))),
            MirBlock(id: BlockId(id: 3), label: Some("exit"), instructions: [], terminator: MirTerminator.Ret(nil))
        ]
        val fn_ = cuda_function(1, "cuda_control", [cuda_bool()], MirType.unit(), [cuda_arg(0, 0, "cond", cuda_bool())], blocks, true)
        val ptx = compile_supported_cuda([fn_])
        expect(ptx).to_contain("ld.param.u8")
        expect(ptx).to_contain("setp.ne.u16 %r0")
        expect(ptx).to_contain("@%r0 bra BB1;")
        expect(ptx).to_contain("bra BB3;")
        expect(ptx).to_contain("bra BB1;")
        assert_no_placeholder_output(ptx)

    it "emits direct device calls by symbol name":
        step("Verify: emits direct device calls by symbol name")
        val callee_signature = MirSignature(params: [cuda_u32(), cuda_u32()], return_type: cuda_u32(), is_variadic: false)
        val callee_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))), span: nil)], terminator: MirTerminator.Ret(Some(MirOperand.copy(LocalId(id: 2)))))
        val callee = cuda_function(2, "cuda_add", [cuda_u32(), cuda_u32()], cuda_u32(), [cuda_arg(0, 0, "a", cuda_u32()), cuda_arg(1, 1, "b", cuda_u32()), cuda_temp(2, cuda_u32())], [callee_block], false)
        val callee_operand = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("cuda_add"), MirType(kind: MirTypeKind.FuncPtr(callee_signature))))
        val caller_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.Call(Some(LocalId(id: 2)), callee_operand, [MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))]), span: nil)], terminator: MirTerminator.Ret(nil))
        val caller = cuda_function(3, "cuda_call", [cuda_u32(), cuda_u32()], MirType.unit(), [cuda_arg(0, 0, "a", cuda_u32()), cuda_arg(1, 1, "b", cuda_u32()), cuda_temp(2, cuda_u32())], [caller_block], true)
        val ptx = compile_supported_cuda([callee, caller])
        expect(ptx).to_contain(".param .u32 __call_0_arg_0;")
        expect(ptx).to_contain("st.param.u32 [__call_0_arg_0], %r0;")
        expect(ptx).to_contain(".param .u32 __call_0_arg_1;")
        expect(ptx).to_contain("st.param.u32 [__call_0_arg_1], %r1;")
        expect(ptx).to_contain(".param .u32 __call_0_retval;")
        expect(ptx).to_contain("call (__call_0_retval), cuda_add, (__call_0_arg_0, __call_0_arg_1);")
        expect(ptx).to_contain("ld.param.u32 %r2, [__call_0_retval];")
        expect(ptx).to_contain("st.param.u32 [retval], %r2;")
        expect(ptx).to_contain("add.u32 %r2, %r0, %r1;")
        expect(ptx.contains("call (%r2)")).to_equal(false)
        assert_no_placeholder_output(ptx)

    it "rejects direct device calls with mismatched argument types":
        step("Verify: rejects direct device calls with mismatched argument types")
        val callee_signature = MirSignature(params: [cuda_u32(), cuda_u32()], return_type: cuda_u32(), is_variadic: false)
        val callee_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [], terminator: MirTerminator.Ret(Some(MirOperand.copy(LocalId(id: 0)))))
        val callee = cuda_function(6, "cuda_identity", [cuda_u32(), cuda_u32()], cuda_u32(), [cuda_arg(0, 0, "a", cuda_u32()), cuda_arg(1, 1, "b", cuda_u32()), cuda_temp(2, cuda_u32())], [callee_block], false)
        val callee_operand = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("cuda_identity"), MirType(kind: MirTypeKind.FuncPtr(callee_signature))))
        val caller_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.Call(Some(LocalId(id: 2)), callee_operand, [MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))]), span: nil)], terminator: MirTerminator.Ret(nil))
        val caller = cuda_function(7, "cuda_call_bad_arg", [cuda_u64(), cuda_u32()], MirType.unit(), [cuda_arg(0, 0, "a", cuda_u64()), cuda_arg(1, 1, "b", cuda_u32()), cuda_temp(2, cuda_u32())], [caller_block], true)
        assert_module_backend_error_contains([callee, caller], "CUDA direct call argument 0 type does not match its signature")

    it "preserves global and shared pointer spaces through GEP copy and bitcast":
        step("Verify: preserves global and shared pointer spaces through GEP copy and bitcast")
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [
            MirInst(kind: MirInstKind.Load(LocalId(id: 1), MirOperand.copy(LocalId(id: 0))), span: nil),
            MirInst(kind: MirInstKind.Store(MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))), span: nil),
            MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: 2), cuda_u32(), 64), span: nil),
            MirInst(kind: MirInstKind.Const(LocalId(id: 3), MirConstValue.Int(0), cuda_u64()), span: nil),
            MirInst(kind: MirInstKind.GetElementPtr(LocalId(id: 4), MirOperand.copy(LocalId(id: 2)), [MirOperand.copy(LocalId(id: 3))]), span: nil),
            MirInst(kind: MirInstKind.Store(MirOperand.copy(LocalId(id: 4)), MirOperand.copy(LocalId(id: 1))), span: nil),
            MirInst(kind: MirInstKind.Load(LocalId(id: 5), MirOperand.copy(LocalId(id: 4))), span: nil),
            MirInst(kind: MirInstKind.GpuAtomicOp(LocalId(id: 6), GpuAtomicOpKind.Add, MirOperand.copy(LocalId(id: 4)), MirOperand.copy(LocalId(id: 5))), span: nil),
            MirInst(kind: MirInstKind.Copy(LocalId(id: 7), LocalId(id: 4)), span: nil),
            MirInst(kind: MirInstKind.Load(LocalId(id: 8), MirOperand.copy(LocalId(id: 7))), span: nil),
            MirInst(kind: MirInstKind.Bitcast(LocalId(id: 9), MirOperand.copy(LocalId(id: 7)), cuda_ptr()), span: nil),
            MirInst(kind: MirInstKind.Load(LocalId(id: 10), MirOperand.copy(LocalId(id: 9))), span: nil),
            MirInst(kind: MirInstKind.GpuAtomicCas(LocalId(id: 11), MirOperand.copy(LocalId(id: 4)), MirOperand.copy(LocalId(id: 5)), MirOperand.copy(LocalId(id: 1))), span: nil),
            MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: 12), cuda_i32(), 1), span: nil),
            MirInst(kind: MirInstKind.Const(LocalId(id: 13), MirConstValue.Int(1), cuda_i32()), span: nil),
            MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 14)), "gpu_atomic_add_i32", [MirOperand.copy(LocalId(id: 12)), MirOperand.copy(LocalId(id: 13))]), span: nil),
            MirInst(kind: MirInstKind.Move(LocalId(id: 15), LocalId(id: 4)), span: nil),
            MirInst(kind: MirInstKind.Load(LocalId(id: 16), MirOperand.copy(LocalId(id: 15))), span: nil)
        ], terminator: MirTerminator.Ret(nil))
        val fn_ = cuda_function(
            4, "cuda_memory", [cuda_ptr()], MirType.unit(),
            [
                cuda_arg(0, 0, "data", cuda_ptr()), cuda_temp(1, cuda_u32()),
                cuda_temp(2, cuda_ptr()), cuda_temp(3, cuda_u64()),
                cuda_temp(4, cuda_ptr()), cuda_temp(5, cuda_u32()),
                cuda_temp(6, cuda_u32()), cuda_temp(7, cuda_ptr()),
                cuda_temp(8, cuda_u32()), cuda_temp(9, cuda_ptr()),
                cuda_temp(10, cuda_u32()), cuda_temp(11, cuda_u32()),
                cuda_temp(12, cuda_i32_ptr()), cuda_temp(13, cuda_i32()),
                cuda_temp(14, cuda_i32()), cuda_temp(15, cuda_ptr()),
                cuda_temp(16, cuda_u32())
            ],
            [block], true
        )
        val ptx = compile_supported_cuda([fn_])
        expect(ptx).to_contain("ld.global.u32 %r1, [%r0];")
        expect(ptx).to_contain("st.global.u32 [%r0], %r1;")
        expect(ptx).to_contain(".shared .u32 shared_2[64];")
        expect(ptx).to_contain("cvta.shared.u64 %r2, shared_2;")
        expect(ptx).to_contain("cvta.to.shared.u64")
        expect(ptx).to_contain("st.shared.u32 [")
        expect(ptx).to_contain("ld.shared.u32 %r5, [")
        expect(ptx).to_contain("atom.shared.add.u32 %r6, [")
        expect(ptx).to_contain("ld.shared.u32 %r8, [")
        expect(ptx).to_contain("ld.shared.u32 %r10, [")
        expect(ptx).to_contain("atom.shared.cas.b32 %r11, [")
        expect(ptx).to_contain("atom.shared.add.s32 %r14, [")
        expect(ptx).to_contain("ld.shared.u32 %r16, [")
        expect(ptx.contains("ld.global.u32 %r5")).to_equal(false)
        expect(ptx.contains("st.global.u32 [%r4]")).to_equal(false)
        expect(ptx.contains("atom.global.add.u32 %r6")).to_equal(false)
        expect(ptx).to_contain("ld.param.u64 %r0, [param_0];")
        assert_no_placeholder_output(ptx)

        val instr_438 = "ld.global.u32 %r1, [%r0];"
        val instr_438_start = ptx.find(instr_438)
        val capture_438 = UntypedCapture(label: "cuda-pointer-spaces-ptx", raw_value: ptx.substring(instr_438_start, instr_438_start + instr_438.len()), source_kind: "log_line")
        val evidence_438 = untyped_capture_to_canonical(capture_438, "cuda_backend_intensive_contract_spec/pointer-spaces")
        val comparison_438 = compare_evidence(evidence_438, oracle_spec("cuda_backend_intensive_contract_spec/pointer-spaces", [
            check_exact("value", instr_438)
        ]))
        expect(comparison_438.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_shared_space.ptx"
            val cubin_path = "/tmp/simple_cuda_shared_space.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")

    it "rejects pointers without CUDA memory-space provenance":
        step("Verify: rejects pointers without CUDA memory-space provenance")
        val block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Load(LocalId(id: 1), MirOperand.copy(LocalId(id: 0))), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val fn_ = cuda_function(
            24, "cuda_unknown_pointer_space", [], MirType.unit(),
            [cuda_temp(0, cuda_ptr()), cuda_temp(1, cuda_u32())], [block], true
        )
        assert_backend_error_contains(fn_, "pointer has no memory-space provenance")

    it "rejects mismatched CAS local atomics and multi-block shared provenance":
        step("Verify: rejects mismatched CAS local atomics and multi-block shared provenance")
        val bad_cas_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [
                MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: 0), cuda_u32(), 1), span: nil),
                MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(1), cuda_i64()), span: nil),
                MirInst(kind: MirInstKind.GpuAtomicCas(LocalId(id: 2), MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1)), MirOperand.copy(LocalId(id: 1))), span: nil)
            ],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_cas = cuda_function(
            25, "cuda_bad_cas_type", [], MirType.unit(),
            [cuda_temp(0, cuda_ptr()), cuda_temp(1, cuda_i64()), cuda_temp(2, cuda_i64())],
            [bad_cas_block], true
        )
        assert_backend_error_contains(bad_cas, "CAS operands and result must match pointer element type")

        val local_atomic_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [
                MirInst(kind: MirInstKind.Alloc(LocalId(id: 0), cuda_u32()), span: nil),
                MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(1), cuda_u32()), span: nil),
                MirInst(kind: MirInstKind.GpuAtomicOp(LocalId(id: 2), GpuAtomicOpKind.Add, MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))), span: nil)
            ],
            terminator: MirTerminator.Ret(nil)
        )
        val local_atomic = cuda_function(
            26, "cuda_local_atomic", [], MirType.unit(),
            [cuda_temp(0, cuda_ptr()), cuda_temp(1, cuda_u32()), cuda_temp(2, cuda_u32())],
            [local_atomic_block], true
        )
        assert_backend_error_contains(local_atomic, "atomics require global or shared memory")

        val shared_blocks = [
            MirBlock(
                id: BlockId.entry(), label: Some("entry"),
                instructions: [MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: 0), cuda_u32(), 1), span: nil)],
                terminator: MirTerminator.Goto(BlockId(id: 1))
            ),
            MirBlock(
                id: BlockId(id: 1), label: Some("use"),
                instructions: [MirInst(kind: MirInstKind.Load(LocalId(id: 1), MirOperand.copy(LocalId(id: 0))), span: nil)],
                terminator: MirTerminator.Ret(nil)
            )
        ]
        val multi_block_shared = cuda_function(
            27, "cuda_multiblock_shared", [], MirType.unit(),
            [cuda_temp(0, cuda_ptr()), cuda_temp(1, cuda_u32())], shared_blocks, true
        )
        assert_backend_error_contains(multi_block_shared, "requires CFG dataflow lowering")

    it "rejects allocation typed-atomic and vector-memory type mismatches":
        step("Verify: rejects allocation typed-atomic and vector-memory type mismatches")
        val bad_alloc_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: 0), cuda_u32(), 1), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_alloc = cuda_function(
            29, "cuda_bad_alloc_type", [], MirType.unit(),
            [cuda_temp(0, cuda_u64_ptr())], [bad_alloc_block], true
        )
        assert_backend_error_contains(bad_alloc, "shared allocation type must match destination pointer element type")

        val bad_typed_atomic_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [
                MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: 0), cuda_i32(), 1), span: nil),
                MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(1), cuda_i32()), span: nil),
                MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 2)), "gpu_atomic_add_i32", [MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))]), span: nil)
            ],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_typed_atomic = cuda_function(
            30, "cuda_bad_typed_atomic_dest", [], MirType.unit(),
            [cuda_temp(0, cuda_i32_ptr()), cuda_temp(1, cuda_i32()), cuda_temp(2, cuda_i64())],
            [bad_typed_atomic_block], true
        )
        assert_backend_error_contains(bad_typed_atomic, "typed atomic destination type does not match intrinsic")

        val bad_vector_block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 2)), "gpu_vec2_load_f32", [MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))]), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_vector = cuda_function(
            31, "cuda_bad_vector_pointer", [cuda_ptr(), cuda_u64()], MirType.unit(),
            [
                cuda_arg(0, 0, "ptr", cuda_ptr()), cuda_arg(1, 1, "index", cuda_u64()),
                cuda_temp(2, cuda_i32())
            ],
            [bad_vector_block], true
        )
        assert_backend_error_contains(bad_vector, "F32 vector memory intrinsic requires an F32 pointer")

    it "does not assume GPU-using device-function pointer parameters are global":
        step("Verify: does not assume GPU-using device-function pointer parameters are global")
        val block = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.GpuAtomicOp(LocalId(id: 2), GpuAtomicOpKind.Add, MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val fn_ = cuda_function(
            28, "cuda_device_pointer", [cuda_ptr(), cuda_u32()], MirType.unit(),
            [
                cuda_arg(0, 0, "ptr", cuda_ptr()), cuda_arg(1, 1, "value", cuda_u32()),
                cuda_temp(2, cuda_u32())
            ],
            [block], false
        )
        assert_backend_error_contains(fn_, "pointer has no memory-space provenance")

    it "rejects compare-exchange through the deprecated generic atomic instruction":
        step("Verify: rejects compare-exchange through the deprecated generic atomic instruction")
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [
            MirInst(kind: MirInstKind.GpuAtomicOp(LocalId(id: 2), GpuAtomicOpKind.CompareExchange, MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))), span: nil)
        ], terminator: MirTerminator.Ret(nil))
        val fn_ = cuda_function(13, "cuda_deprecated_compare_exchange", [cuda_ptr(), cuda_u32()], MirType.unit(), [cuda_arg(0, 0, "ptr", cuda_ptr()), cuda_arg(1, 1, "value", cuda_u32()), cuda_temp(2, cuda_u32())], [block], true)

        assert_backend_error_contains(fn_, "compare-exchange requires GpuAtomicCas")

    it "rejects indirect calls with CUDA backend identity preserved":
        step("Verify: rejects indirect calls with CUDA backend identity preserved")
        val sig = MirSignature(params: [cuda_u32()], return_type: cuda_u32(), is_variadic: false)
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.CallIndirect(Some(LocalId(id: 2)), MirOperand.copy(LocalId(id: 0)), [MirOperand.copy(LocalId(id: 1))], sig), span: nil)], terminator: MirTerminator.Ret(nil))
        val fn_ = cuda_function(5, "cuda_indirect", [MirType(kind: MirTypeKind.FuncPtr(sig)), cuda_u32()], MirType.unit(), [cuda_arg(0, 0, "fnptr", MirType(kind: MirTypeKind.FuncPtr(sig))), cuda_arg(1, 1, "x", cuda_u32()), cuda_temp(2, cuda_u32())], [block], true)
        reject_unsupported_cuda(fn_)
        assert_backend_error_contains(fn_, "indirect GPU calls")

    it "rejects unsupported switch terminators instead of comment-only success":
        step("Verify: rejects unsupported switch terminators instead of comment-only success")
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [], terminator: MirTerminator.Switch(MirOperand.copy(LocalId(id: 0)), [], BlockId(id: 1)))
        val fn_ = cuda_function(6, "cuda_switch", [cuda_u32()], MirType.unit(), [cuda_arg(0, 0, "selector", cuda_u32())], [block], true)
        reject_unsupported_cuda(fn_)
        assert_backend_error_contains(fn_, "terminator")

    it "rejects unsupported arithmetic and constants with typed CUDA errors":
        step("Verify: rejects unsupported arithmetic and constants with typed CUDA errors")
        val rem_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Rem, MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))), span: nil)], terminator: MirTerminator.Ret(nil))
        val rem_fn = cuda_function(7, "cuda_rem", [cuda_u32(), cuda_u32()], MirType.unit(), [cuda_arg(0, 0, "a", cuda_u32()), cuda_arg(1, 1, "b", cuda_u32()), cuda_temp(2, cuda_u32())], [rem_block], true)
        assert_backend_error_contains(rem_fn, "binary operation")

        val str_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Str("bad"), MirType(kind: MirTypeKind.Opaque("text"))), span: nil)], terminator: MirTerminator.Ret(nil))
        val str_fn = cuda_function(8, "cuda_string", [], MirType.unit(), [cuda_temp(0, MirType(kind: MirTypeKind.Opaque("text")))], [str_block], true)
        assert_backend_error_contains(str_fn, "local type")

        val bool_sig = MirSignature(params: [cuda_bool()], return_type: MirType.unit(), is_variadic: false)
        val bool_callee = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("cuda_bool_device"), MirType(kind: MirTypeKind.FuncPtr(bool_sig))))
        val bool_device_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [], terminator: MirTerminator.Ret(nil))
        val bool_device_fn = cuda_function(11, "cuda_bool_device", [cuda_bool()], MirType.unit(), [cuda_arg(0, 0, "flag", cuda_bool())], [bool_device_block], false)
        val bool_call_block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.Call(nil, bool_callee, [MirOperand.copy(LocalId(id: 0))]), span: nil)], terminator: MirTerminator.Ret(nil))
        val bool_call_fn = cuda_function(12, "cuda_bool_call", [cuda_bool()], MirType.unit(), [cuda_arg(0, 0, "flag", cuda_bool())], [bool_call_block], true)
        val bool_result = CudaBackend.create((8, 6)).compile(cuda_module([bool_device_fn, bool_call_fn]))
        expect(bool_result.is_err()).to_equal(true)
        expect(bool_result.unwrap_err().message).to_contain("boolean parameters")

    it "rejects unknown and malformed intrinsics instead of emitting comments":
        step("Verify: rejects unknown and malformed intrinsics instead of emitting comments")
        val unknown = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 0)), "gpu_unknown", []), span: nil)], terminator: MirTerminator.Ret(nil))
        val unknown_fn = cuda_function(9, "cuda_unknown_intrinsic", [], MirType.unit(), [cuda_temp(0, cuda_u32())], [unknown], true)
        assert_backend_error_contains(unknown_fn, "does not support intrinsic")

        val malformed = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 0)), "gpu_vec4_load_f32", []), span: nil)], terminator: MirTerminator.Ret(nil))
        val malformed_fn = cuda_function(10, "cuda_bad_intrinsic", [], MirType.unit(), [cuda_temp(0, cuda_u32())], [malformed], true)
        assert_backend_error_contains(malformed_fn, "requires exactly 2 arguments")

        val extra = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 3)), "gpu_atomic_add_i32", [
                MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1)), MirOperand.copy(LocalId(id: 2))
            ]), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val extra_fn = cuda_function(
            32, "cuda_extra_intrinsic_arg", [cuda_i32_ptr(), cuda_i32(), cuda_i32()], MirType.unit(),
            [
                cuda_arg(0, 0, "ptr", cuda_i32_ptr()), cuda_arg(1, 1, "value", cuda_i32()),
                cuda_arg(2, 2, "extra", cuda_i32()), cuda_temp(3, cuda_i32())
            ],
            [extra], true
        )
        assert_backend_error_contains(extra_fn, "requires exactly 2 arguments")

        val store_dest = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 4)), "gpu_vec2_store_f32", [
                MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1)),
                MirOperand.copy(LocalId(id: 2)), MirOperand.copy(LocalId(id: 3))
            ]), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val store_dest_fn = cuda_function(
            33, "cuda_store_with_dest", [cuda_ptr(), cuda_u64(), cuda_u32(), cuda_u32()], MirType.unit(),
            [
                cuda_arg(0, 0, "ptr", cuda_ptr()), cuda_arg(1, 1, "index", cuda_u64()),
                cuda_arg(2, 2, "x", cuda_u32()), cuda_arg(3, 3, "y", cuda_u32()),
                cuda_temp(4, cuda_u32())
            ],
            [store_dest], true
        )
        assert_backend_error_contains(store_dest_fn, "does not produce a destination")

    it "emits executable signed bounds checks for indexed kernels":
        step("Verify: emits executable signed bounds checks for indexed kernels")
        val ptx = compile_cuda_bounds_check(cuda_i32(), "cuda_bounds_check", 24)
        expect(ptx).to_contain("cvt.s64.s32 %r2, %r0;")
        expect(ptx).to_contain("setp.lt.s64 %p3, %r2, 0;")
        expect(ptx).to_contain("@%p3 trap;")
        expect(ptx).to_contain("setp.ge.s64 %p4, %r2, %r1;")
        expect(ptx).to_contain("@%p4 trap;")
        assert_no_placeholder_output(ptx)

        val instr_710 = "cvt.s64.s32 %r2, %r0;"
        val instr_710_start = ptx.find(instr_710)
        val capture_710 = UntypedCapture(label: "cuda-signed-bounds-check-ptx", raw_value: ptx.substring(instr_710_start, instr_710_start + instr_710.len()), source_kind: "log_line")
        val evidence_710 = untyped_capture_to_canonical(capture_710, "cuda_backend_intensive_contract_spec/signed-bounds-check")
        val comparison_710 = compare_evidence(evidence_710, oracle_spec("cuda_backend_intensive_contract_spec/signed-bounds-check", [
            check_exact("value", instr_710)
        ]))
        expect(comparison_710.status).to_equal(EvidenceStatus.passed)

        val (_which_out, _which_err, available) = rt_process_run("/bin/sh", ["-c", "command -v ptxas >/dev/null 2>&1"])
        if available == 0:
            val ptx_path = "/tmp/simple_cuda_bounds_check.ptx"
            val cubin_path = "/tmp/simple_cuda_bounds_check.cubin"
            expect(rt_file_write_text(ptx_path, ptx)).to_equal(true)
            val (_as_out, as_err, as_code) = rt_process_run("ptxas", ["-arch=sm_86", ptx_path, "-o", cubin_path])
            expect(as_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(as_err).to_equal("")
        else:
            expect(ptx).to_contain(".target sm_86")

    it "normalizes all supported bounds-check index widths to I64":
        step("Verify: normalizes all supported bounds-check index widths to I64")
        val i64_ptx = compile_cuda_bounds_check(cuda_i64(), "cuda_bounds_i64", 29)
        expect(i64_ptx).to_contain("setp.lt.s64 %p2, %r0, 0;")
        expect(i64_ptx.contains("cvt.s64.s64")).to_equal(false)

        val u32_ptx = compile_cuda_bounds_check(cuda_u32(), "cuda_bounds_u32", 30)
        expect(u32_ptx).to_contain("cvt.s64.u32 %r2, %r0;")
        expect(u32_ptx).to_contain("setp.ge.s64 %p4, %r2, %r1;")

        val u64_ptx = compile_cuda_bounds_check(cuda_u64(), "cuda_bounds_u64", 31)
        expect(u64_ptx).to_contain("cvt.s64.u64 %r2, %r0;")
        expect(u64_ptx).to_contain("setp.lt.s64 %p3, %r2, 0;")

    it "rejects malformed CUDA bounds checks":
        step("Verify: rejects malformed CUDA bounds checks")
        val bad_arity = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(nil, "bounds_check", [
                MirOperand.copy(LocalId(id: 0))
            ]), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_arity_fn = cuda_function(
            25, "cuda_bounds_arity", [cuda_i64()], MirType.unit(),
            [cuda_arg(0, 0, "index", cuda_i64())],
            [bad_arity], true
        )
        assert_backend_error_contains(bad_arity_fn, "requires exactly 2 arguments")

        val bad_dest = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(Some(LocalId(id: 2)), "bounds_check", [
                MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))
            ]), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_dest_fn = cuda_function(
            26, "cuda_bounds_dest", [cuda_i64(), cuda_i64()], MirType.unit(),
            [cuda_arg(0, 0, "index", cuda_i64()), cuda_arg(1, 1, "length", cuda_i64()), cuda_temp(2, cuda_i64())],
            [bad_dest], true
        )
        assert_backend_error_contains(bad_dest_fn, "does not produce a destination")

        val bad_type = MirBlock(
            id: BlockId.entry(), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.Intrinsic(nil, "bounds_check", [
                MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1))
            ]), span: nil)],
            terminator: MirTerminator.Ret(nil)
        )
        val bad_type_fn = cuda_function(
            27, "cuda_bounds_type", [cuda_bool(), cuda_i64()], MirType.unit(),
            [cuda_arg(0, 0, "index", cuda_bool()), cuda_arg(1, 1, "length", cuda_i64())],
            [bad_type], true
        )
        assert_backend_error_contains(bad_type_fn, "index must be an integer")

        val bad_pointer_fn = cuda_function(
            28, "cuda_bounds_pointer", [cuda_ptr(), cuda_i64()], MirType.unit(),
            [cuda_arg(0, 0, "index", cuda_ptr()), cuda_arg(1, 1, "length", cuda_i64())],
            [bad_type], true
        )
        assert_backend_error_contains(bad_pointer_fn, "index must be an integer")

        val bad_unit_fn = cuda_function(
            29, "cuda_bounds_unit", [MirType.unit(), cuda_i64()], MirType.unit(),
            [cuda_arg(0, 0, "index", MirType.unit()), cuda_arg(1, 1, "length", cuda_i64())],
            [bad_type], true
        )
        assert_backend_error_contains(bad_unit_fn, "index must be an integer")

        val bad_length_fn = cuda_function(
            32, "cuda_bounds_length", [cuda_i64(), cuda_u32()], MirType.unit(),
            [cuda_arg(0, 0, "index", cuda_i64()), cuda_arg(1, 1, "length", cuda_u32())],
            [bad_type], true
        )
        assert_backend_error_contains(bad_length_fn, "length must be I64")

    it "resolves Struct(SymbolId) field access to a real offset via the module's type table":
        step("Verify: resolves Struct(SymbolId) field access to a real offset via the module's type table")
        # struct Point { a: u32, b: u64 } -- offsets computed by MIR lowering
        # (compute_struct_layout) and carried on MirFieldDef as-is: a@0, b@8
        # (u64 needs 8-byte alignment, so a's 4-byte slot is padded).
        val struct_symbol = SymbolId(id: 100)
        val struct_ty = MirType(kind: MirTypeKind.Struct(struct_symbol))
        val types: Dict<SymbolId, MirTypeDef> = {
            struct_symbol: MirTypeDef(
                symbol: struct_symbol, name: "Point",
                kind: MirTypeDefKind.Struct([
                    MirFieldDef(name: "a", type_: cuda_u32(), offset: 0, has_bits_attr: false, bits_width: 0),
                    MirFieldDef(name: "b", type_: cuda_u64(), offset: 8, has_bits_attr: false, bits_width: 0)
                ]),
                is_export_c: false, export_name: ""
            )
        }
        val ptr_ty = MirType.ptr(struct_ty, true)
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [
            MirInst(kind: MirInstKind.GetField(LocalId(id: 1), MirOperand.copy(LocalId(id: 0)), 1), span: nil)
        ], terminator: MirTerminator.Ret(nil))
        val fn_ = cuda_function(14, "cuda_struct_field", [ptr_ty], MirType.unit(), [cuda_arg(0, 0, "p", ptr_ty), cuda_temp(1, cuda_u64())], [block], true)
        val result = CudaBackend.create((8, 6)).compile(cuda_module_with_types([fn_], types))
        expect(result.is_ok()).to_equal(true)
        val ptx = result.unwrap().ptx
        expect(ptx).to_contain("ld.local.u64 %r1, [%r0+8];")
        expect(ptx.contains("WARN: unresolved aggregate layout")).to_equal(false)
        assert_no_placeholder_output(ptx)

    it "still emits the loud WARN fallback for a struct symbol absent from the module's type table":
        step("Verify: still emits the loud WARN fallback for a struct symbol absent from the module's type table")
        val unknown_symbol = SymbolId(id: 999999)
        val struct_ty = MirType(kind: MirTypeKind.Struct(unknown_symbol))
        val ptr_ty = MirType.ptr(struct_ty, true)
        val block = MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: [
            MirInst(kind: MirInstKind.GetField(LocalId(id: 1), MirOperand.copy(LocalId(id: 0)), 0), span: nil)
        ], terminator: MirTerminator.Ret(nil))
        val fn_ = cuda_function(15, "cuda_struct_field_unknown", [ptr_ty], MirType.unit(), [cuda_arg(0, 0, "p", ptr_ty), cuda_temp(1, cuda_u64())], [block], true)
        val result = CudaBackend.create((8, 6)).compile(cuda_module([fn_]))
        expect(result.is_ok()).to_equal(true)
        val ptx = result.unwrap().ptx
        expect(ptx).to_contain("WARN: unresolved aggregate layout; using legacy 8-byte field slots")
        expect(ptx).to_contain("ld.local.u64 %r1, [%r0+0];")
