# Cross-engine DIFFERENTIAL probe — COPY/VALUE SEMANTICS subset.
#
# Same contract and same no-oracle rationale as
# `probe_engine_differential.spl` (see that file's header); this is a small
# subset that exists for a specific operational reason.
#
# WHY A SUBSET EXISTS. The full 150-observation probe's NATIVE/AOT lane did not
# finish inside a 900s `native-build` budget on a loaded box, twice — so every
# verdict from the full probe is interpreter-vs-JIT only and the third engine
# stayed unproven. Splitting the one cell that is actually RED out into a probe
# small enough to build makes the native answer reachable. If the full probe's
# native lane is later shown to build, this file is still worth keeping: it is
# the fast regression guard for the specific defect.
#
# THE DEFECT THIS TARGETS (live as of 2026-08-17 on a freshly built compiler):
#
#   var src: [u8] = [1, 2, 3]
#   val cp = src        # must be a COPY
#   src[1] = 99
#   # interpreter: cp[1] == 2   (correct)
#   # JIT:         cp[1] == 99  (aliased)
#
# The standing note that `[u8]` "still aliases" describes a uniform language
# limitation. What the differential actually shows is narrower and worse: the
# ENGINES DISAGREE, so identical source has different value semantics depending
# on how it is executed. `[i64]`, `[u64]`, `[f64]` and `[text]` are included as
# controls — they agree and are correct on both engines, which is what pins the
# defect to the packed byte-array representation rather than to array copying
# in general.

use std.io_runtime.{exit}

struct W3:
    first: i64
    length: i64
    tag: i64

var count: i64 = 0

fn obs(key: text, rendered: text):
    count = count + 1
    print("OBS " + key + " = " + rendered)

fn mutate_arg(w: W3) -> i64:
    var local = w
    local.length = 555
    return local.length

fn main():
    # --- the RED cell: packed [u8] ----------------------------------------
    var src_u8: [u8] = [1, 2, 3]
    val cp_u8 = src_u8
    src_u8[1] = 99
    obs("copy_arr_u8_original", src_u8[1].to_string())
    obs("copy_arr_u8_copy", cp_u8[1].to_string())

    # --- controls: these agree on interpreter and JIT ----------------------
    var src_i64: [i64] = [1, 2, 3]
    val cp_i64 = src_i64
    src_i64[1] = 999
    obs("copy_arr_i64_original", src_i64[1].to_string())
    obs("copy_arr_i64_copy", cp_i64[1].to_string())

    var src_u64: [u64] = [1, 2, 3]
    val cp_u64 = src_u64
    src_u64[1] = 999
    obs("copy_arr_u64_original", src_u64[1].to_string())
    obs("copy_arr_u64_copy", cp_u64[1].to_string())

    var src_f64: [f64] = [1.5, 2.5]
    val cp_f64 = src_f64
    src_f64[0] = 9.5
    obs("copy_arr_f64_original", src_f64[0].to_string())
    obs("copy_arr_f64_copy", cp_f64[0].to_string())

    var src_txt: [text] = ["a", "b"]
    val cp_txt = src_txt
    src_txt[0] = "z"
    obs("copy_arr_text_original", src_txt[0])
    obs("copy_arr_text_copy", cp_txt[0])

    # --- struct copy and by-value argument passing ------------------------
    var src_w3 = W3(first: 1, length: 2, tag: 3)
    val cp_w3 = src_w3
    src_w3.length = 999
    obs("copy_struct_original", src_w3.length.to_string())
    obs("copy_struct_copy", cp_w3.length.to_string())

    var arg_w3 = W3(first: 1, length: 2, tag: 3)
    val seen = mutate_arg(arg_w3)
    obs("copy_arg_callee_saw", seen.to_string())
    obs("copy_arg_caller_after", arg_w3.length.to_string())

    print("ENGINE_DIFFERENTIAL PROBE: " + count.to_string() + " OBSERVATIONS")
