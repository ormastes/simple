# @cover src/compiler/70.backend/backend/cuda/ptx_builder.spl 5%
# @tag: unit, compiler, gpu, cuda, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "CUDA unsigned negation source contract":
    it "uses modulo-width subtraction for U32 and U64":
        val source = rt_file_read_text(
            "src/compiler/70.backend/backend/cuda/ptx_builder.spl"
        ) ?? ""

        expect(source).to_contain("case U32 | U64:")
        expect(source).to_contain("self.emit_line(\"sub")
        expect(source).to_contain("self.emit_line(\"neg")
