# Probe: omitted fields of a struct/class reached via a glob re-export must
# take their declared defaults under native-build (bug
# native_struct_field_default_dropped_on_reexport_2026-10-25).
use reexp.*

fn main():
    var r1 = Rec(a: 1)
    var r2 = Rec(a: 2)
    val b = Box(id: 3)
    print("n={r1.n} z={r1.z} s={r1.s} f={r1.f} count={b.count} label={b.label}")
    var ok = true
    if r1.n != 12345: ok = false
    if r1.z != 0: ok = false
    if r1.s != "dflt": ok = false
    if not r1.f: ok = false
    if r1.o != nil: ok = false
    if b.count != 7: ok = false
    if b.label != "box": ok = false
    if not ok:
        print("REEXPORT_FIELD_DEFAULT PROBE: FAIL scalars")
        return
    # Each construction evaluates `= []` afresh: no shared mutable default.
    r1.xs.push(9)
    print("xs1={r1.xs.len()} xs2={r2.xs.len()}")
    if r1.xs.len() == 1 and r2.xs.len() == 0:
        print("REEXPORT_FIELD_DEFAULT PROBE: ALL PASS")
    else:
        print("REEXPORT_FIELD_DEFAULT PROBE: FAIL arrays")
