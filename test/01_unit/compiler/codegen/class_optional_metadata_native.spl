# Native regression: an ordinary class has no export attribute or specialization.
# HIR presence flags must remain false so MIR never dereferences an absent value.
class MetadataCounter:
    value: i64

    fn read() -> i64:
        self.value

fn main():
    val counter = MetadataCounter(value: 37)
    assert(counter.read() == 37)
    print "class-optional-metadata-ok"
