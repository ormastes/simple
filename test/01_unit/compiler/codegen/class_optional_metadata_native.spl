# Native regression: an ordinary class has no export attribute or specialization.
# HIR presence flags must remain false so MIR never dereferences an absent value.
class MetadataCounter:
    value: i64

    fn read() -> i64:
        self.value

@export("C", name: "metadata_export_counter")
class ExportedMetadataCounter:
    """Positive export and doc-comment presence must preserve both payloads."""
    value: i64

    fn read() -> i64:
        self.value

fn main():
    val counter = MetadataCounter(value: 37)
    assert(counter.read() == 37)
    val exported = ExportedMetadataCounter(value: 42)
    assert(exported.read() == 42)
    print "class-optional-metadata-ok"
