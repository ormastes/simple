"""
Standalone probe (has `fn main`, so it survives JIT lowering) for the
"native var rebind / register spill miscompiles" family tracked in
doc/08_tracking/bug/native_var_rebind_register_spill_2026-08-07.md and the
session memory note reference_native_list_rebind_and_spill_miscompiles.md.

Prints one VERDICT line: pass=N fail=M. Run under a NAMED engine via
SIMPLE_EXECUTION_MODE=interpret|jit — see
test/01_unit/compiler/codegen/f64_method_return_binop_spec.spl for the
pattern this mirrors.
"""

fn helper(n: i64) -> i64:
    return n * 2 + 1

fn mk(n: i64) -> i64:
    return n * 7 + 3

fn burn(n: i64) -> i64:
    return n + 1

fn main():
    var pass_count = 0
    var fail_count = 0

    # Case 1: plain sequential var rebind.
    var x = 1
    x = 2
    x = 3
    if x == 3:
        pass_count = pass_count + 1
    else:
        fail_count = fail_count + 1

    # Case 2: register pressure across CALL boundaries -- 18 simultaneously
    # live locals bound from an opaque `mk()` call (so Cranelift cannot
    # constant-fold them away), summed every iteration of a 20-iteration
    # loop whose body ALSO makes nested opaque calls (`burn(burn(burn(i)))`)
    # between the definitions and the final reads of b1..b18 -- the shape
    # the 2026-07-20 freestanding filing needed (many live values crossing
    # call boundaries), not just loop-local arithmetic pressure.
    val b1 = mk(1)
    val b2 = mk(2)
    val b3 = mk(3)
    val b4 = mk(4)
    val b5 = mk(5)
    val b6 = mk(6)
    val b7 = mk(7)
    val b8 = mk(8)
    val b9 = mk(9)
    val b10 = mk(10)
    val b11 = mk(11)
    val b12 = mk(12)
    val b13 = mk(13)
    val b14 = mk(14)
    val b15 = mk(15)
    val b16 = mk(16)
    val b17 = mk(17)
    val b18 = mk(18)
    var target = 0
    var i = 0
    while i < 20:
        val churn = burn(burn(burn(i)))
        target = target + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15 + b16 + b17 + b18 + churn
        i = i + 1
    if target == 25270 and b1 == 10 and b18 == 129:
        pass_count = pass_count + 1
    else:
        fail_count = fail_count + 1

    # Case 3: list var rebind from empty-list-first-assignment via BRACKET
    # index reads (the exact shape from
    # reference_native_list_rebind_and_spill_miscompiles.md trigger 1:
    # `var xs = []` then reassigned to a non-empty list, then read with
    # `xs[i]` -- `.get()` is a runtime call and lowers differently from the
    # inline bracket-index path the note's root cause names, so both are
    # probed).
    var xs = []
    xs = [4, 5, 6]
    if xs.get(0) == 4 and xs.get(1) == 5 and xs.get(2) == 6 and xs[0] == 4 and xs[1] == 5 and xs[2] == 6:
        pass_count = pass_count + 1
    else:
        fail_count = fail_count + 1

    # NOTE: the memory note's THIRD trigger (untyped `list`-typed parameter
    # element read, e.g. `fn read0(v: list) -> i64: return v[0]`) is a
    # SEPARATE, already-filed, still-open defect -- confirmed reproducing
    # today (`read0([5])` reads back 40, not 5, under the JIT; interpreter
    # correct) -- and is deliberately NOT included in this probe's pass
    # count. It is a distinct root cause (HIR `list` resolves to
    # `Array{element: ANY}`; `lower_index_expr` skips UnboxInt for
    # ANY-typed elements) from the rebind/register-pressure/list-spill
    # shapes this probe locks in. See
    # doc/08_tracking/bug/untyped_list_element_read_seed_rootcause_2026-07-30.md
    # (root cause, file:line) and
    # doc/08_tracking/bug/native_var_rebind_register_spill_2026-08-07.md
    # (today's independent re-confirmation).

    # Case 4: scalar spill across intervening calls inside a loop (the
    # shape from native_scalar_spill_clobber_loop_intervening_calls_2026-07-20.md).
    var top = 100
    var bottom = 40
    var j = 0
    var mismatches = 0
    while j < 30:
        val h1 = helper(j)
        val h2 = helper(h1)
        val h3 = helper(h2)
        val lerp = top - (top - bottom) * j / 30
        if lerp < 0 or lerp > 100:
            mismatches = mismatches + 1
        j = j + 1
    if mismatches == 0 and top == 100 and bottom == 40:
        pass_count = pass_count + 1
    else:
        fail_count = fail_count + 1

    # Case 5: loop-carried list spill across .push() reallocation (the
    # shape from reference_native_list_rebind_and_spill_miscompiles.md
    # trigger 2).
    var ys: [i64] = []
    var k = 0
    var bad = 0
    while k < 40:
        ys.push(k * 3)
        if k > 0:
            val prev = ys.get(k - 1)
            if prev != (k - 1) * 3:
                bad = bad + 1
        k = k + 1
    if bad == 0 and ys.get(0) == 0 and ys.get(39) == 117:
        pass_count = pass_count + 1
    else:
        fail_count = fail_count + 1

    print "VAR_REBIND_SPILL_VERDICT: pass={pass_count} fail={fail_count}"
