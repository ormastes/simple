# Native regression for the Stage 2 cold HIR generation gate. A text value
# returned through an optional binding used to retain its heap handle across
# `.to_i64() ?? -1` in the Rust seed's Cranelift output.

fn optional_generation() -> text?:
    "5"

fn accepts_generation(generation: i64) -> bool:
    generation == 5

fn main():
    val raw = optional_generation() ?? ""
    val parsed = raw.to_i64() ?? -1
    val numeric: i64 = 5
    if accepts_generation(parsed) and numeric.to_i64() == 5:
        print("PASS erased-text-to-i64-native")
    else:
        panic("FAIL erased-text-to-i64-native")
