"""
## Purpose and audience
Purpose: Prove that match-on-int dispatch (B5).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-CODEGEN-001 — stable requirement identity for this spec.

"""
B5 (compiler_bugs_for_crypto_2026-04-25.md) — verify dense `match` on
integer constants lowers to a MIR `Terminator::Switch`, which Cranelift
emits as `br_table`.

Acceptance gates the TLS-1.3 cipher dispatcher: a 5+ arm match on cipher_id
with span ≤ 1024 must dispatch in ≤ 2× direct-call cost. We can't observe
the IR shape from Simple, so we exercise the dispatch correctness for every
arm; the IR-shape assertion lives next to the codegen impl.
"""

use std.spec

fn dispatch(id: i64) -> i64:
    match id:
        case 0: 100
        case 1: 200
        case 2: 300
        case 3: 400
        case 4: 500
        case _: -1

describe "match-on-int dispatch (B5)":

    it "arm 0 returns 100":
        step("Verify: arm 0 returns 100")
        # @req: REQ-COMPILER-CODEGEN-001
        expect(dispatch(0)).to_equal(100)  # oracle: 100 — named expected value from the requirement

    it "arm 1 returns 200":
        step("Verify: arm 1 returns 200")
        expect(dispatch(1)).to_equal(200)  # oracle: 200 — named expected value from the requirement

    it "arm 2 returns 300":
        step("Verify: arm 2 returns 300")
        expect(dispatch(2)).to_equal(300)  # oracle: 300 — named expected value from the requirement

    it "arm 3 returns 400":
        step("Verify: arm 3 returns 400")
        expect(dispatch(3)).to_equal(400)  # oracle: 400 — named expected value from the requirement

    it "arm 4 returns 500":
        step("Verify: arm 4 returns 500")
        expect(dispatch(4)).to_equal(500)  # oracle: 500 — named expected value from the requirement

    it "default arm returns -1 for out-of-range":
        step("Verify: default arm returns -1 for out-of-range")
        expect(dispatch(5)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(dispatch(-1)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(dispatch(1000)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "sparse non-dense match still works (falls back to if-chain)":
        step("Verify: sparse non-dense match still works (falls back to if-chain)")
        val r = match 7:
            case 7: 99
            case _: 0
        expect(r).to_equal(99)  # oracle: 99 — named expected value from the requirement
