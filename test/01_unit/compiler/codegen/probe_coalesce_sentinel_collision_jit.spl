# Run-path probe: `??` must never confuse a real scalar with the nil sentinel.
#
# TAG_SPECIAL = 0b011 (src/compiler_rust/runtime/src/value/tags.rs:7) and
# rt_is_none (value/objects.rs) treats a raw machine word of 0 or 3 as nil.
# When the JIT handed `??` an UNBOXED i64, every value whose bit pattern
# collided with a tag sentinel was silently replaced by the default:
# `s.index_of("(")` returning 3 came back as the default instead.
# See doc/08_tracking/bug/tag_boxing_value_corruption_family_triage_2026-08-01.md #2.
#
# Every oracle below is an ABSOLUTE literal, never "the two engines agree".
# Run directly: bin/simple run <this file>  (SIMPLE_EXECUTION_MODE selects lane)

var failures = 0

fn check(name: text, got: i64, want: i64) -> i64:
    if got == want:
        print "PASS " + name
        return 0
    print "FAIL " + name + " got=" + got.to_text() + " want=" + want.to_text()
    return 1

fn main():
    var bad = 0

    # --- every low-3-bit pattern, as a plain non-nullable local ---
    # 0 is SPECIAL_NIL, 3 is TAG_SPECIAL: the two historically fatal values.
    val v0 = 0
    bad = bad + check("scalar_0", v0 ?? 777, 0)
    val v1 = 1
    bad = bad + check("scalar_1", v1 ?? 777, 1)
    val v2 = 2
    bad = bad + check("scalar_2", v2 ?? 777, 2)
    val v3 = 3
    bad = bad + check("scalar_3", v3 ?? 777, 3)
    val v4 = 4
    bad = bad + check("scalar_4", v4 ?? 777, 4)
    val v5 = 5
    bad = bad + check("scalar_5", v5 ?? 777, 5)
    val v6 = 6
    bad = bad + check("scalar_6", v6 ?? 777, 6)
    val v7 = 7
    bad = bad + check("scalar_7", v7 ?? 777, 7)
    val v8 = 8
    bad = bad + check("scalar_8", v8 ?? 777, 8)

    # --- the original reporter's shape: a search result that happens to be 3 ---
    val s = "get(x):"
    val paren = "("
    bad = bad + check("index_of_raw", s.index_of(paren), 3)
    bad = bad + check("index_of_coalesce", s.index_of(paren) ?? 999999, 3)

    # --- negative and arithmetic-derived values must survive too ---
    val neg = 0 - 3
    bad = bad + check("scalar_neg3", neg ?? 777, 0 - 3)
    val derived = 1 + 2
    bad = bad + check("scalar_derived3", derived ?? 777, 3)

    # --- the opposite failure mode: genuinely-absent optional accessors must
    # still take the runtime nil check and yield the DEFAULT, not the raw
    # sentinel 3 leaking out as an integer.
    var empty: [i64] = []
    bad = bad + check("empty_first_default", empty.first() ?? -1, -1)
    bad = bad + check("empty_last_default", empty.last() ?? -1, -1)
    var xs: [i64] = [3, 0, 42]
    bad = bad + check("present_first_is_3", xs.first() ?? -1, 3)
    bad = bad + check("present_get_is_0", xs.get(1) ?? -1, 0)
    bad = bad + check("present_get_is_42", xs.get(2) ?? -1, 42)
    bad = bad + check("oob_get_default", xs.get(99) ?? -1, -1)

    if bad == 0:
        print "COALESCE_SENTINEL PROBE: ALL PASS"
    else:
        print "COALESCE_SENTINEL PROBE: " + bad.to_text() + " FAILURES"
