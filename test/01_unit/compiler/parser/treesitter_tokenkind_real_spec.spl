"""
## Purpose and audience
Purpose: Verify `compiler.core.lexer_types.TokenKind` wire-code parity, round-trip
conversions (`token_kind_from_code`, `token_kind_code`), and token category predicates
(`token_is_keyword`, `token_is_operator`, `token_is_literal`).
Audience: compiler and frontend engineers maintaining `core/tokens.spl` and `core/lexer_types.spl`.

## Operator workflow
1. Run `bin/simple test test/01_unit/compiler/parser/treesitter_tokenkind_real_spec.spl`.
2. Require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; covers real wire codes without mocks or placeholders.
"""
# @req: REQ-COMPILER-FRONTEND-TOKENKIND-001
# @cover src/compiler/10.frontend/core/lexer_types.spl 80%

use std.spec.*
use std.spec.step
use compiler.core.lexer_types.{
    Token, TokenKind, lex_token_new, lex_token_eof, lex_token_error,
    token_kind_from_code, token_kind_code,
    token_is_keyword, token_is_operator, token_is_literal
}
use compiler.core.tokens.{
    TOK_KW_FN, TOK_KW_VAL, TOK_KW_VAR, TOK_KW_RETURN, TOK_KW_IF, TOK_KW_ELSE,
    TOK_KW_STRUCT, TOK_KW_CLASS, TOK_KW_MATCH, TOK_KW_WHILE,
    TOK_INT_LIT, TOK_FLOAT_LIT, TOK_STRING_LIT, TOK_BOOL_LIT, TOK_NIL_LIT, TOK_IDENT,
    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_EQ, TOK_NOT_EQ, TOK_LT_EQ, TOK_ASSIGN,
    TOK_LPAREN, TOK_ARROW, TOK_BACKTICK_IDENT, TOK_EOF, TOK_ERROR, tok_kind_name
}

describe "TokenKind Keywords":
    it "classifies declaration and control-flow keywords accurately":
        step("Verify token_is_keyword is true for keyword tokens")
        val codes = [
            TOK_KW_FN, TOK_KW_VAL, TOK_KW_VAR, TOK_KW_RETURN,
            TOK_KW_IF, TOK_KW_ELSE, TOK_KW_STRUCT, TOK_KW_CLASS,
            TOK_KW_MATCH, TOK_KW_WHILE
        ]
        for code in codes:
            val tok = lex_token_new(code, tok_kind_name(code), 1, 1)
            expect(token_is_keyword(tok)).to_equal(true)
            expect(token_is_operator(tok)).to_equal(false)
            expect(token_is_literal(tok)).to_equal(false)

describe "TokenKind Literals":
    it "classifies literals and identifiers accurately":
        step("Verify token_is_literal for integer, float, string, bool, nil, ident")
        val codes = [TOK_INT_LIT, TOK_FLOAT_LIT, TOK_STRING_LIT, TOK_BOOL_LIT, TOK_NIL_LIT, TOK_IDENT]
        for code in codes:
            val tok = lex_token_new(code, "x", 1, 1)
            expect(token_is_literal(tok)).to_equal(true)
            expect(token_is_keyword(tok)).to_equal(false)
            expect(token_is_operator(tok)).to_equal(false)

describe "TokenKind Operators":
    it "classifies arithmetic, comparison, and assignment operators":
        step("Verify token_is_operator for operator wire codes")
        val codes = [TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_EQ, TOK_NOT_EQ, TOK_LT_EQ, TOK_ASSIGN]
        for code in codes:
            val tok = lex_token_new(code, "op", 1, 1)
            expect(token_is_operator(tok)).to_equal(true)
            expect(token_is_keyword(tok)).to_equal(false)
            expect(token_is_literal(tok)).to_equal(false)

describe "TokenKind Wire Code Round-Trip":
    it "round-trips every core token kind code without drift":
        step("Verify token_kind_code(token_kind_from_code(c)) == c")
        val codes = [
            TOK_KW_FN, TOK_KW_VAL, TOK_INT_LIT, TOK_STRING_LIT, TOK_IDENT,
            TOK_PLUS, TOK_EQ, TOK_ASSIGN, TOK_LPAREN, TOK_ARROW,
            TOK_BACKTICK_IDENT, TOK_EOF, TOK_ERROR
        ]
        for code in codes:
            val kind = token_kind_from_code(code)
            expect(token_kind_code(kind)).to_equal(code)

    it "constructs explicit EOF and Error sentinel tokens":
        step("Verify lex_token_eof and lex_token_error preserve fields")
        val eof_tok = lex_token_eof(12)
        expect(eof_tok.kind).to_equal(TokenKind.Eof)
        expect(eof_tok.span.line).to_equal(12)

        val err_tok = lex_token_error("bad token", 3, 9)
        expect(err_tok.kind).to_equal(TokenKind.Error)
        expect(err_tok.text).to_equal("bad token")
        expect(err_tok.span.line).to_equal(3)
        expect(err_tok.span.col).to_equal(9)
