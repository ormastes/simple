# Bug: seed_parse_multiline_list_driver_compile_options_2026-11-15
# A bare multi-line list statement after `val x = match ...:` must start a new
# statement, not index the last arm value.

enum Mode:
    Fast
    Slow

fn shape_driver(m: Mode) -> [text]:
    val name = match m:
        case Fast: "fast"
        case _: ""
    ["schema=1", "mode=" + name,
        "a=" + name, "b=" + name,
        "c=" + name]

fn shape_trailing_comma(m: Mode) -> [text]:
    val name = match m:
        case Fast: "fast"
        case _: ""
    ["schema=1", "mode=" + name,
        "z",
    ]

fn shape_nested(m: Mode) -> [[text]]:
    val name = match m:
        case Fast: "fast"
        case _: ""
    [["a", name],
        ["b" + name]]

fn count_items(xs: [text]) -> i64:
    xs.len()

fn shape_call_arg(m: Mode) -> i64:
    val name = match m:
        case Fast: "fast"
        case _: ""
    count_items(["schema=1", "mode=" + name,
        "z"])

describe "multi-line list after match value":
    it "parses the driver_compile_options shape":
        val xs = shape_driver(Mode.Fast)
        expect(xs.len()).to_equal(5)
        expect(xs[1]).to_equal("mode=fast")
        expect(xs[4]).to_equal("c=fast")
    it "parses a trailing comma":
        expect(shape_trailing_comma(Mode.Slow).len()).to_equal(3)
    it "parses a nested list":
        val xs = shape_nested(Mode.Fast)
        expect(xs.len()).to_equal(2)
        expect(xs[1][0]).to_equal("bfast")
    it "parses a list in a call argument":
        expect(shape_call_arg(Mode.Fast)).to_equal(3)
