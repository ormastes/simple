# @req bug noinit_module_var_nonlocal_type_nil_fallback_needs_hir_zero_2026-11-09
# Flat parser (compiler) half of owner decision 2026-11-09 item 14: a module
# var of class or enum type with no initializer is a compile error ("explicit
# initializer required") in every mode. The same holds for any named type the
# parser cannot zero (imported, later-declared, kernel/noalloc modules): the
# old nil fallback is gone, nil only exists inside unsafe. A struct declared
# earlier still zero-initializes (item 8). The seed interpreter keeps its own
# first-variant / default-construction default (#7965).
use std.spec
use compiler.core.parser.{parse_module_silent_checked}
use compiler.core.ast.{module_decl_count_get, module_decl_at, decl_get_name, decl_get_body}
use compiler.core.ast_expr.{expr_get_tag, EXPR_STRUCT_LIT}
use compiler.frontend.core.parser_stmts.{set_noinit_robust_mode_v1, set_noinit_kernel_module_v1}

fn ec_body(name: text) -> i64:
    var i = 0
    while i < module_decl_count_get():
        val d = module_decl_at(i)
        if decl_get_name(d) == name:
            val b = decl_get_body(d)
            if b.len() == 1:
                return b[0]
        i = i + 1
    -1

describe "module var without initializer: class and enum need an explicit initializer (flat parser)":
    it "a no-init enum module var is a compile error":
        expect(parse_module_silent_checked("enum Light:\n    Red\n    Green\nvar light: Light\n", "ec1.spl")).to_equal(true)
    it "a no-init class module var is a compile error":
        val src = "class Counter:\n    count: i64\nvar counter: Counter\n"
        expect(parse_module_silent_checked(src, "ec2.spl")).to_equal(true)
    it "a no-init var of an imported or later-declared type is a compile error, not nil":
        expect(parse_module_silent_checked("use foo.Remote\nvar r: Remote\n", "ec3.spl")).to_equal(true)
        expect(parse_module_silent_checked("var p: Later\nstruct Later:\n    n: i64\n", "ec4.spl")).to_equal(true)
    it "kernel/noalloc modules get the same error instead of a nil global":
        set_noinit_kernel_module_v1(true)
        val e = parse_module_silent_checked("struct P:\n    n: i64\nvar p: P\n", "ec5.spl")
        set_noinit_kernel_module_v1(false)
        expect(e).to_equal(true)
    it "an explicit initializer is accepted for enum and class":
        expect(parse_module_silent_checked("enum L:\n    A\nvar l: L = L.A\n", "ec6.spl")).to_equal(false)
        expect(parse_module_silent_checked("class C:\n    n: i64\nvar c: C = C(n: 0)\n", "ec7.spl")).to_equal(false)
    it "a struct declared earlier still zero-initializes (item 8)":
        expect(parse_module_silent_checked("struct S:\n    n: i64\nvar s: S\n", "ec8.spl")).to_equal(false)
        expect(expr_get_tag(ec_body("s"))).to_equal(EXPR_STRUCT_LIT)
    it "robust mode rejects a no-init enum or class module var":
        set_noinit_robust_mode_v1(true)
        val e1 = parse_module_silent_checked("enum L:\n    A\nvar l: L\n", "ec9.spl")
        val e2 = parse_module_silent_checked("class C:\n    n: i64\nvar c: C\n", "ec10.spl")
        set_noinit_robust_mode_v1(false)
        expect(e1).to_equal(true)
        expect(e2).to_equal(true)
