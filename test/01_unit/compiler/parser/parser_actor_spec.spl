# @req: REQ-COMPILER-PARSER-001

#!/usr/bin/env simple
# Parser Tests for Actor Definitions
#
# Each scenario compiles a small actor fixture through the deployed
# `bin/simple` and asserts the program's observable outcome, so parsing of
# actor declarations is proven by execution, not by grepping parser source.
#
# Known limitation (2026-08-27): actor METHOD INVOCATION after spawn is not
# executable on the deployed Rust seed (JIT dispatch gap; interpreter reports
# "method not found on type `actor`"), so method-bearing actors are asserted
# up to successful parse + spawn. Generic actor declarations (`actor W<T>:`)
# are rejected by the parser today — covered in
# test/01_unit/compiler/parser/desugaring_spec.spl as a fail-closed oracle.


use std.spec.*
use std.io_runtime.{file_write, process_run, env_get}

fn compile_source(name: text, source: text) -> text:
    val path = "build/test-artifacts/parser_actor_" + name + ".spl"
    file_write(path, source)
    var bin = env_get("SIMPLE_BIN")
    if bin == "":
        bin = "bin/simple"
    val cmd = bin + " run " + path + " 2>&1"
    val out = process_run("sh", ["-c", cmd])
    out.0

val SIMPLE_ACTOR: text = "actor Counter:\n" +
    "    var count: i64 = 0\n" +
    "\n" +
    "fn main():\n" +
    "    val c = spawn Counter()\n" +
    "    print(\"simple ok\")\n"

val METHODS_ACTOR: text = "actor Mut:\n" +
    "    var n: i64 = 0\n" +
    "    fn bump(self):\n" +
    "        self.n = self.n + 1\n" +
    "    fn scale(self, by: i64):\n" +
    "        self.n = self.n * by\n" +
    "\n" +
    "fn main():\n" +
    "    val m = spawn Mut()\n" +
    "    print(\"methods ok\")\n"

val PARAMS_ACTOR: text = "actor Par:\n" +
    "    fn process(self, task: i64) -> i64:\n" +
    "        task * 2\n" +
    "\n" +
    "fn main():\n" +
    "    val p = spawn Par()\n" +
    "    print(\"params ok\")\n"

val PUB_ACTOR: text = "pub actor Visible:\n" +
    "    var v: i64 = 2\n" +
    "\n" +
    "fn main():\n" +
    "    val w = spawn Visible()\n" +
    "    print(\"pub ok\")\n"

val DOC_ACTOR: text = "## A documented actor.\nactor Doc:\n" +
    "    var v: i64 = 2\n" +
    "\n" +
    "fn main():\n" +
    "    val d = spawn Doc()\n" +
    "    print(\"doc ok\")\n"

val EMPTY_ACTOR: text = "actor Empty:\n" +
    "    pass\n" +
    "\n" +
    "fn main():\n" +
    "    val e = spawn Empty()\n" +
    "    print(\"empty ok\")\n"

val TWO_ACTORS: text = "actor One:\n" +
    "    var a: i64 = 1\n" +
    "actor Two:\n" +
    "    var b: i64 = 2\n" +
    "\n" +
    "fn main():\n" +
    "    val x = spawn One()\n" +
    "    val y = spawn Two()\n" +
    "    print(\"two actors ok\")\n"

val ACTOR_AND_CLASS: text = "class Plain:\n" +
    "    fn hi(self) -> text:\n" +
    "        \"class\"\n" +
    "\n" +
    "actor A2:\n" +
    "    var x: i64 = 1\n" +
    "\n" +
    "fn main():\n" +
    "    val c = Plain()\n" +
    "    val a = spawn A2()\n" +
    "    print(c.hi() + \" and actor\")\n"

val MISSING_COLON_ACTOR: text = "actor Bad\n" +
    "    var v: i64 = 1\n" +
    "\n" +
    "fn main():\n" +
    "    print(\"no\")\n"

describe "Parser actor definitions":
    """
    Purpose and audience: compiler engineers on the parser team who need actor
    declarations — plain, public, documented, empty, method-bearing, and
    alongside classes — to parse into runnable programs, and malformed actor
    headers to be rejected with a parse error.
    """
    # @manual scenario evidence
    it "a simple actor with one field parses and spawns":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture with a one-field actor")
        val out = compile_source("simple", SIMPLE_ACTOR)
        expect(out).to_contain("simple ok")

    it "an actor with multiple methods parses":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture whose actor declares two methods")
        val out = compile_source("methods", METHODS_ACTOR)
        step("methods exist on the parsed actor; invocation after spawn is")
        step("not executable on the deployed seed (see limitation note)")
        expect(out).to_contain("methods ok")

    it "an actor method with parameters and a return type parses":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture with fn process(self, task: i64) -> i64")
        val out = compile_source("params", PARAMS_ACTOR)
        expect(out).to_contain("params ok")

    it "a pub actor keeps its visibility through parsing":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture with a pub actor")
        val out = compile_source("pub", PUB_ACTOR)
        expect(out).to_contain("pub ok")

    it "an actor with a doc comment parses":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture with a documented actor")
        val out = compile_source("doc", DOC_ACTOR)
        expect(out).to_contain("doc ok")

    it "an empty actor body parses":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture whose actor body is a bare pass")
        val out = compile_source("empty", EMPTY_ACTOR)
        expect(out).to_contain("empty ok")

    it "several actors in one file each parse and spawn":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture declaring two actors")
        val out = compile_source("two", TWO_ACTORS)
        expect(out).to_contain("two actors ok")

    it "actors and classes coexist in one file":
        # @req REQ-SSPEC-COMPILER
        step("compile and run a fixture with a class and an actor")
        val out = compile_source("mixed", ACTOR_AND_CLASS)
        step("the class method stays callable while the actor spawns")
        expect(out).to_contain("class and actor")

    it "an actor header missing its colon is rejected with a parse error":
        # @req REQ-SSPEC-COMPILER
        step("compile a fixture whose actor header lacks the colon")
        val out = compile_source("missing_colon", MISSING_COLON_ACTOR)
        step("the parser refuses the file instead of running it")
        expect(out).to_contain("parse:")
        expect(out).to_contain("expected Colon")
        expect(out).to_contain("compile failed")
