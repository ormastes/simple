"""The rich AST bridge preserves interpolation expressions without retaining
an array of single-character fragments during its scan.
"""

use std.spec.*
use std.io_runtime.{file_read}
use std.nogc_sync_mut.sffi.host.{heap_registry_count}
use std.nogc_sync_mut.io.time_ops.{time_now_nanos}
use compiler.core.ast.{ast_reset}
use compiler.core.parser.{parser_set_had_error}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.flat_ast_bridge.{flat_bridge_build_string_interps}
use compiler.frontend.parser_types_expr.{ExprKind}

val OPEN_BRACE: text = "{"
val CLOSE_BRACE: text = "}"

fn reset_interpolation_parser():
    ast_reset()
    parser_set_had_error(false)

fn timed_bridge_batch(value: text, rounds: i64) -> (i64, i64):
    val span = Span.default()
    var checksum = 0
    val started = time_now_nanos()
    for index in 0..rounds:
        val parts = flat_bridge_build_string_interps(value, span)
        if parts.len() != 1:
            return (-1, -1)
        match parts[0].expr.kind:
            case ExprKind.Ident(name):
                if name != "marker":
                    return (-1, -1)
                checksum = checksum + name.len()
            case _: return (-1, -1)
    (time_now_nanos() - started, checksum)

describe "flat bridge interpolation fragment slicing":
    it "preserves expression order and span across adjacent regions":
        reset_interpolation_parser()
        val span = Span.new(10, 30, 2, 4)
        val value = OPEN_BRACE + "first" + CLOSE_BRACE + OPEN_BRACE + "second" + CLOSE_BRACE
        val parts = flat_bridge_build_string_interps(value, span)
        expect(parts.len()).to_equal(2)
        match parts[0].expr.kind:
            case ExprKind.Ident(name): expect(name).to_equal("first")
            case _: expect(false).to_equal(true)
        match parts[1].expr.kind:
            case ExprKind.Ident(name): expect(name).to_equal("second")
            case _: expect(false).to_equal(true)
        expect(parts[0].span.start).to_equal(10)
        expect(parts[1].span.end).to_equal(30)

    it "preserves nested braces within one fragment":
        reset_interpolation_parser()
        val value = OPEN_BRACE + "pick(" + OPEN_BRACE + "1: 2" + CLOSE_BRACE + ")" + CLOSE_BRACE
        expect(flat_bridge_build_string_interps(value, Span.default()).len()).to_equal(1)

    it "preserves a large completed interpolation identifier":
        reset_interpolation_parser()
        val name = "variable_" + "x".repeat(8192)
        val parts = flat_bridge_build_string_interps(OPEN_BRACE + name + CLOSE_BRACE, Span.default())
        expect(parts.len()).to_equal(1)
        match parts[0].expr.kind:
            case ExprKind.Ident(actual): expect(actual).to_equal(name)
            case _: expect(false).to_equal(true)

    it "retains no fragment accumulator container for a large unfinished interpolation":
        # Native runtime's live-object registry is implemented by both owners.
        # Equal-length scans make the same character/next-character slices;
        # neither invokes the inner parser. Warm short-string caches first.
        reset_interpolation_parser()
        val span = Span.default()
        val plain_value = "x".repeat(65537)
        val large_value = OPEN_BRACE + "x".repeat(65536)
        expect(flat_bridge_build_string_interps("xxx", span).len()).to_equal(0)
        expect(flat_bridge_build_string_interps(OPEN_BRACE + "xx", span).len()).to_equal(0)

        # Fail closed if registry accounting is absent or inert. Keep this
        # actual array alive across the subsequent measurements.
        val calibration_before = heap_registry_count()
        val calibration: [i64] = [17, 23]
        val calibration_after = heap_registry_count()
        expect(calibration_after > calibration_before).to_equal(true)

        val plain_before = heap_registry_count()
        val plain_parts = flat_bridge_build_string_interps(plain_value, span)
        val plain_after = heap_registry_count()
        val large_before = heap_registry_count()
        val large_parts = flat_bridge_build_string_interps(large_value, span)
        val large_after = heap_registry_count()

        expect(plain_parts.len()).to_equal(0)
        expect(large_parts.len()).to_equal(0)
        val plain_objects = plain_after - plain_before
        val large_objects = large_after - large_before
        expect(plain_objects > 0 and large_objects > 0).to_equal(true)
        # An unfinished region returns a fresh empty result: one extra array.
        # The old scanner additionally allocated/reset inner_parts on '{',
        # making this difference two and retaining the 65,536-slot buffer.
        expect(large_objects).to_equal(plain_objects + 1)
        expect(calibration[0] + calibration[1]).to_equal(40)

    it "keeps large completed interpolation scanning within a linear scaling budget":
        reset_interpolation_parser()
        # Padding expands the actual fragment scan while trim leaves the same
        # six-character expression for parsing. Build inputs outside timing.
        val small = OPEN_BRACE + " ".repeat(8192) + "marker" + CLOSE_BRACE
        val large = OPEN_BRACE + " ".repeat(16384) + "marker" + CLOSE_BRACE
        expect(time_now_nanos() > 0).to_equal(true)
        val warm_small = timed_bridge_batch(small, 1)
        val warm_large = timed_bridge_batch(large, 1)
        expect(warm_small.1).to_equal(6)
        expect(warm_large.1).to_equal(6)

        var small_best = 9223372036854775807
        var large_best = 9223372036854775807
        var checksum = 0
        # Fixed three samples reduce scheduler noise without retry-until-pass.
        # Alternate order so the larger input is not always measured second.
        for sample in 0..3:
            val first = timed_bridge_batch(if sample == 1: large else: small, 4)
            val second = timed_bridge_batch(if sample == 1: small else: large, 4)
            # Nanosecond provider must advance at least 1 us per four-call
            # batch. Frozen clocks and zero-duration samples fail closed.
            expect(first.0 >= 1000 and second.0 >= 1000).to_equal(true)
            expect(first.1).to_equal(24)
            expect(second.1).to_equal(24)
            checksum = checksum + first.1 + second.1
            val small_ns = if sample == 1: second.0 else: first.0
            val large_ns = if sample == 1: first.0 else: second.0
            if small_ns < small_best:
                small_best = small_ns
            if large_ns < large_best:
                large_best = large_ns
        expect(checksum).to_equal(144)
        # Expected work doubles. Permit 3x plus 25 ms for timer granularity
        # and shared-host variation; allocation growth has its own hard gate.
        expect(large_best <= small_best * 3 + 25000000).to_equal(true)

    it "skips escaped braces and accepts a following expression":
        reset_interpolation_parser()
        val value = OPEN_BRACE + OPEN_BRACE + "literal" + CLOSE_BRACE + CLOSE_BRACE + OPEN_BRACE + "name" + CLOSE_BRACE
        expect(flat_bridge_build_string_interps(value, Span.default()).len()).to_equal(1)

    it "rejects malformed and unmatched regions then recovers":
        reset_interpolation_parser()
        expect(flat_bridge_build_string_interps(OPEN_BRACE + "a +" + CLOSE_BRACE, Span.default()).len()).to_equal(0)
        expect(flat_bridge_build_string_interps(OPEN_BRACE + "a", Span.default()).len()).to_equal(0)
        expect(flat_bridge_build_string_interps(OPEN_BRACE + "good" + CLOSE_BRACE, Span.default()).len()).to_equal(1)
        expect(flat_bridge_build_string_interps("plain", Span.default()).len()).to_equal(0)

    it "materializes completed regions without per-character fragment storage":
        val source = file_read("src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl")
        val begin = source.index_of("fn flat_bridge_build_string_interps(")
        val finish = source.index_of("fn flat_bridge_decode_brace_escapes(")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body.count("value.substring(inner_start, i)")).to_equal(1)
        expect(body.count("inner_parts")).to_equal(0)
