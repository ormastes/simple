use compiler.core.ast.{ast_reset, expr_get_span, expr_get_tag, EXPR_CALL, EXPR_METHOD_CALL, span_line, span_col}
use compiler.core.parser.{parser_init, parse_expr}

extern fn rt_exit(code: i32)

ast_reset()
parser_init("run(1)")
val direct = parse_expr()
val direct_span = expr_get_span(direct)
val direct_tag = expr_get_tag(direct)
val direct_line = span_line(direct_span)
val direct_col = span_col(direct_span)

ast_reset()
parser_init("worker.run(1)")
val method = parse_expr()
val method_span = expr_get_span(method)

if direct_tag != EXPR_CALL or direct_line != 1 or direct_col != 4 or expr_get_tag(method) != EXPR_METHOD_CALL or span_line(method_span) != 1 or span_col(method_span) != 11:
    print "FAIL: source calls must retain their opening-paren span"
    rt_exit(1)

print "PASS: source call nodes retain opening-paren spans"
rt_exit(0)
