"""
# Inline Else With An Assignment Body

A programmer writing a one-line `if`/`else` pair expects the `else` line to
take an assignment whatever the `if` line holds:

    if index < 0: items.push(value)
    else: items[index] = value

When the `if` body was a call, the `else` body was read as an expression and
the `=` was rejected ("expected expression, found Assign"); with an assignment
`if` body the same `else` line was accepted. Both shapes must run.
"""

use std.spec.{describe, it, expect}

fn put(items: [i64], index: i64, value: i64) -> [i64]:
    var out = items
    if index < 0: out.push(value)
    else: out[index] = value
    out

fn tally(start: i64, amount: i64) -> i64:
    var total = start
    var resets = 0
    if amount < 0: resets = resets + 1
    else: total += amount
    total + resets * 100

describe "inline else with an assignment body":
    it "stores into the indexed slot when the if line is a call":
        expect(put([1, 2, 3], 1, 9)).to_equal([1, 9, 3])

    it "runs the call on the if line when its condition holds":
        expect(put([1, 2, 3], -1, 9)).to_equal([1, 2, 3, 9])

    it "applies a compound assignment on the else line":
        expect(tally(5, 4)).to_equal(9)
        expect(tally(5, -4)).to_equal(105)
