# UNEXECUTED: parser contract regression; native fixture remains unchanged.
use std.spec.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types_expr.*
use compiler.common.config.{Logger}

describe "while-val synthetic loop condition":
    it "uses a boolean literal and preserves the optional payload binding marker":
        val source = "fn read(input: i64?) -> i64:\n    while val value = input:\n        return value\n    return 0\n"
        val parsed = parse_full_frontend(source, "while_val_condition", "while_val_condition", Logger(level: 0))
        val function_ = parsed.functions["read"]
        match function_.body.stmts[0].kind:
            case StmtKind.While(condition, body):
                match condition.kind:
                    case ExprKind.BoolLit(value): expect(value).to_be(true)
                    case _: assert(false)
                expect(body.stmts[0].bind_optional_payload).to_be(true)
                match body.stmts[0].kind:
                    case StmtKind.Val(name, _, initializer):
                        expect(name).to_equal("value")
                        match initializer.kind:
                            case ExprKind.ExistsCheck(base):
                                match base.kind:
                                    case ExprKind.Ident(name): expect(name).to_equal("input")
                                    case _: assert(false)
                            case _: assert(false)
                    case _: assert(false)
            case _: assert(false)
