# @cover src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl
# @cover src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl

use std.spec.{describe, it, expect, fail, step}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types_expr.{ExprKind}
use compiler.core.parser.{parser_has_errors}

describe "explicit enum discriminants", tag: ["only-compiled"]:
    it "preserves explicit expressions and implicit variants":
        step("Parse explicit and implicit variants through the flat bridge")
        val src = "enum Code:\n    Zero = 0\n    Implicit\n    Sparse = 7\n"
        val module = parse_and_build_module(src, "explicit_enum_discriminant.spl")

        expect(parser_has_errors()).to_equal(false)
        val code = module.enums["Code"] ?? panic("missing Code enum")
        expect(code.variants.len()).to_equal(3)
        expect(code.variants[0].name).to_equal("Zero")
        expect(code.variants[0].has_discriminant).to_equal(true)
        match code.variants[0].discriminant.kind:
            case IntLit(value):
                expect(value).to_equal(0)
            case _:
                fail("Zero discriminant was not preserved as an integer expression")
        expect(code.variants[1].name).to_equal("Implicit")
        expect(code.variants[1].has_discriminant).to_equal(false)
        expect(code.variants[2].name).to_equal("Sparse")
        expect(code.variants[2].has_discriminant).to_equal(true)
        match code.variants[2].discriminant.kind:
            case IntLit(value):
                expect(value).to_equal(7)
            case _:
                fail("Sparse discriminant was not preserved as an integer expression")
