fn unwrap_or_zero(value: i64?) -> i64:
    val Some(inner) = value else: return 0
    inner

describe "refutable val-else":
    it "binds the payload when the pattern matches":
        expect(unwrap_or_zero(Some(42))).to_equal(42)

    it "runs the diverging fallback when the pattern misses":
        expect(unwrap_or_zero(nil)).to_equal(0)
