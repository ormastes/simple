"""
## Purpose and audience
Purpose: Prove that TreeSitter Highlight-Relevant Parsing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-PARSER-001 — stable requirement identity for this spec.

# TreeSitter Highlights Specification
#
# **Feature IDs:** #TS-HL-001
# **Category:** Compiler | Parser
# **Status:** Active
# @cover src/compiler/10.frontend/treesitter.spl 80%
#
# Tests outline extraction of items relevant to syntax highlighting:
# functions, classes, enums, and their structural properties.

use compiler.treesitter.*


use std.spec.step

describe "TreeSitter Highlight-Relevant Parsing", tag: ["only-compiled"]:
    it "extracts function with parameters for highlight":
        step("Verify: extracts function with parameters for highlight")
        # @req: REQ-COMPILER-PARSER-001
        val src = "fn greet(name: text) -> text:\n    name\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        val f = outline.functions[0]
        expect(f.name).to_equal("greet")
        expect(f.params.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "extracts class fields for highlight":
        step("Verify: extracts class fields for highlight")
        val src = "class Color:\n    r: i64\n    g: i64\n    b: i64\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.classes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "extracts enum variants for highlight":
        step("Verify: extracts enum variants for highlight")
        val src = "enum Direction:\n    North\n    South\n    East\n    West\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.enums.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "extracts static method for highlight":
        step("Verify: extracts static method for highlight")
        val src = "class Point:\n    x: i64\n    y: i64\n\nimpl Point:\n    static fn origin() -> Point:\n        Point(x: 0, y: 0)\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.classes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "extracts import statement":
        step("Verify: extracts import statement")
        val src = "use std.io\n\nfn main():\n    0\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.imports.len()).to_be_greater_than(0)
