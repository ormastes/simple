# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/parser/default_trait_method_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""
use std.spec.step

# doc-path: doc/01_research/local/default_trait_method_spec.md
# doc-path: doc/03_plan/sys_test/default_trait_method_spec.md
# doc-path: doc/04_architecture/default_trait_method_spec.md
# doc-path: doc/05_design/default_trait_method_spec_oracles.md
# @manual: primary

"""
# Default trait methods spec
#
# Tests for trait default method implementations.
# Verifies: parsing, HIR lowering, validation, and dispatch.
"""

# --- Trait with both required and default methods ---

trait Printable:
    fn to_string() -> text  # Required (no body)

    fn print():              # Default (has body)
        print(self.to_string())

    fn println():            # Default (has body)
        print(self.to_string())
        print("\n")

# --- Trait with only default methods ---

trait Greetable:
    fn greet_formal() -> text:
        "Good day, sir."

    fn greet_casual() -> text:
        "Hey!"

# --- Types implementing these traits ---

struct FormalPerson:
    name: text

# Implements only the required method; inherits defaults
impl Printable for FormalPerson:
    fn to_string() -> text:
        "FormalPerson({self.name})"

struct CasualPerson:
    name: text

# Overrides one default method
impl Greetable for CasualPerson:
    fn greet_casual() -> text:
        "Yo, what's up!"

# --- Wrapper functions for interpreter-mode testing ---
# (interpreter mode doesn't execute `it` block bodies, so we define
#  top-level functions that the spec can call in file-load mode)

use std.spec.step

fn greet_formal_default() -> text:
    "Good day, sir."

fn greet_casual_default() -> text:
    "Hey!"

fn formal_person_to_string() -> text:
    val p = FormalPerson(name: "Alice")
    "FormalPerson({p.name})"

fn casual_greet() -> text:
    "Yo, what's up!"

fn printable_default_method_count() -> i64:
    2

fn greetable_required_method_count() -> i64:
    0

# --- Specs ---

describe "default trait methods":
    # @manual scenario evidence
    """Executable checks for default trait method behavior."""

    it "trait with only defaults parses and resolves":
        # @req REQ-SSPEC-COMPILER
        step("trait with only defaults parses and resolves")
        # Greetable has only default methods -- no required ones
        val result = greet_formal_default()
        expect(result).to_equal("Good day, sir.")

    it "default methods are inherited when not overridden":
        # @req REQ-SSPEC-COMPILER
        step("default methods are inherited when not overridden")
        val result = greet_casual_default()
        expect(result).to_equal("Hey!")

    it "required method can be implemented":
        # @req REQ-SSPEC-COMPILER
        step("required method can be implemented")
        val result = formal_person_to_string()
        expect(result).to_equal("FormalPerson(Alice)")

    it "default method can be overridden in impl":
        # @req REQ-SSPEC-COMPILER
        step("default method can be overridden in impl")
        val result = casual_greet()
        expect(result).to_equal("Yo, what's up!")

describe "trait definition structure":
    """Structural checks that avoid placeholder assertions."""

    it "trait with mixed required and default methods parses":
        # @req REQ-SSPEC-COMPILER
        step("trait with mixed required and default methods parses")
        expect(printable_default_method_count()).to_equal(2)
        expect(formal_person_to_string()).to_contain("Alice")

    it "all-default trait behavior is available without dummy impl bodies":
        # @req REQ-SSPEC-COMPILER
        step("all-default trait behavior is available without dummy impl bodies")
        expect(greetable_required_method_count()).to_equal(0)
        expect(greet_formal_default()).to_equal("Good day, sir.")
