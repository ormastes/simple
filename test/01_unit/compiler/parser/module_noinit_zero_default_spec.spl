# @req bug p4p2_flat_parser_noinit_module_var_struct_and_fn_types_2026-10-20
# Module-level var without initializer: non-robust modes default-initialize,
# fn-typed has no safe zero (error), robust mode errors.
use std.spec
use compiler.core.parser.{parse_module_silent_checked}
use compiler.frontend.core.parser_stmts.{set_noinit_robust_mode_v1}

describe "module var without initializer":
    it "accepts struct-element fixed array":
        val src = "struct E:\n    a: i64\nvar tbl: [E; 4]\n"
        expect(parse_module_silent_checked(src, "t1.spl")).to_equal(false)
    it "accepts scalar module var":
        expect(parse_module_silent_checked("var counter: i64\nvar flag: bool\n", "t2.spl")).to_equal(false)
    it "rejects fn-element fixed array (no safe zero)":
        expect(parse_module_silent_checked("var h: [fn(i64); 4]\n", "t3.spl")).to_equal(true)
    it "rejects any no-init module var in robust mode":
        set_noinit_robust_mode_v1(true)
        val err = parse_module_silent_checked("var counter: i64\n", "t4.spl")
        set_noinit_robust_mode_v1(false)
        expect(err).to_equal(true)
