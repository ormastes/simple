# Unit type `()` inside a generic type argument.
#
# Bug: doc/08_tracking/bug/stage2_parser_result_unit_generic_divergence_2026-07-29.md
# The Rust seed parses `fn f() -> Result<(), CompileError>:` fine, but the
# stage-2 pure-Simple parser (src/compiler/10.frontend) has been reported to
# reject it, cascading into "unexpected token in expression: ':'" at the
# function body colon. Real victim: 6 occurrences in
# src/compiler/70.backend/backend/vhdl_codegen_helpers.spl.
#
# This spec locks parser.spl's generic-argument type parsing (parser_parse_type_impl)
# to accept `()` (the empty tuple / unit type) as a generic type argument, both
# in first and non-first argument position, and in a real function signature.

use compiler.core.parser.{parse_module, parser_has_errors, parser_get_errors, parser_set_had_error}

describe "unit type () as a generic type argument":
    it "parses Result<(), text> as a function return type":
        parser_set_had_error(false)
        val source = "fn f() -> Result<(), text>:\n    Ok(())\n"
        parse_module(source, "unit_type_generic_arg_result_first.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)

    it "parses Result<text, ()> with unit as the second type argument":
        parser_set_had_error(false)
        val source = "fn g() -> Result<text, ()>:\n    Ok(\"hi\")\n"
        parse_module(source, "unit_type_generic_arg_result_second.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)

    it "parses a real multi-statement function signature shaped like the victim file":
        parser_set_had_error(false)
        val source = "fn emit_helper(name: text) -> Result<(), CompileError>:\n" +
            "    val x = name.len()\n" +
            "    Ok(())\n"
        parse_module(source, "unit_type_generic_arg_real_signature.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)
