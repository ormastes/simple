# Feature: Simple Language Grammar Parsing
# Category: Compiler/Parser
# Status: Active

# Purpose: parser accepts representative Simple syntax constructs.
# Audience: compiler and runtime engineers.

# Operator workflow: run this spec with the compiler's `simple test` command.

# Compatibility and limitations
# These assertions exercise the compiler parser; they do not cover Tree-sitter.

use std.spec
use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}

fn parses_clean(name: text, source: text) -> bool:
    parser_set_had_error(false)
    parse_module(source, name)
    not parser_has_errors()

fn function_source(body: text) -> text:
    "fn grammar_probe():\n    " + body + "\n"

fn is_rejected(name: text, source: text) -> bool:
    parser_set_had_error(false)
    parse_module(source, name)
    parser_has_errors()

describe "SimpleGrammar - Core Modern Syntax":
    # Tests parsing of core Simple language syntax including val, var, and const declarations
    it "parses val declarations":
        val code = "val x = 42"
        expect(parses_clean("grammar_val.spl", function_source(code))).to_equal(true)

    it "parses var declarations":
        val code = "var count = 0"
        expect(parses_clean("grammar_var.spl", function_source(code))).to_equal(true)

    it "parses const declarations":
        val code = "const MAX_SIZE = 1000"
        expect(parses_clean("grammar_const.spl", function_source(code))).to_equal(true)

describe "SimpleGrammar - Lambda Syntax":
    # Tests parsing of lambda expressions in both fn() and backslash syntax
    it "parses fn lambda syntax":
        val code = "val add = fn(x, y): x + y"
        expect(parses_clean("grammar_fn_lambda.spl", function_source(code))).to_equal(true)

    it "parses backslash lambda":
        val code = "val double = \\x: x * 2"
        expect(parses_clean("grammar_backslash_lambda.spl", function_source(code))).to_equal(true)

describe "SimpleGrammar - Generic Types":
    # Tests parsing of generic type annotations using angle bracket syntax
    it "parses generic type":
        val code = "val items: List<Int> = []"
        expect(parses_clean("grammar_generic.spl", function_source(code))).to_equal(true)

    it "parses nested generics":
        val code = "val nested: List<Option<Int>> = []"
        expect(parses_clean("grammar_nested_generic.spl", function_source(code))).to_equal(true)

describe "SimpleGrammar - Module System":
    # Tests parsing of module imports with glob and selective use statements
    it "parses use statement with glob":
        val code = "use std.collections.*"
        expect(parses_clean("grammar_use_glob.spl", code)).to_equal(true)

    it "parses use statement with braces":
        val code = "use std.spec.{describe, it}"
        expect(parses_clean("grammar_use_selective.spl", code)).to_equal(true)

describe "SimpleGrammar - Advanced Types":
    # Tests parsing of optional and result type annotations
    it "parses optional type":
        val code = "val maybe: Int? = None"
        expect(parses_clean("grammar_optional.spl", function_source(code))).to_equal(true)

    it "parses result type":
        val code = "val result: Result<Int, text> = Ok(42)"
        expect(parses_clean("grammar_result.spl", function_source(code))).to_equal(true)

describe "SimpleGrammar - Operators":
    # Tests parsing of compound assignment and range operators
    it "parses compound assignment":
        val code = "x += 5"
        expect(parses_clean("grammar_compound_assignment.spl", function_source(code))).to_equal(true)

    it "parses range operators":
        val code = "val range1 = 0..10"
        expect(parses_clean("grammar_range.spl", function_source(code))).to_equal(true)

describe "SimpleGrammar - Literals":
    # Tests parsing of typed integers and the planned colon-prefixed symbol form
    it "parses typed integer":
        val code = "val a = 42i32"
        expect(parses_clean("grammar_typed_integer.spl", function_source(code))).to_equal(true)

    it "rejects unsupported colon-prefixed symbol literals":
        val code = "val status = :success"
        expect(is_rejected("grammar_symbol.spl", function_source(code))).to_equal(true)

describe "SimpleGrammar - Error Recovery":
    # Tests parsing error recovery mechanisms for malformed syntax
    it "recovers to parse a valid module after malformed syntax":
        val malformed = "fn broken(:\n    pass\n"
        expect(is_rejected("grammar_error_recovery.spl", malformed)).to_equal(true)
        val valid = "fn recovered() -> i64:\n    1\n"
        expect(parses_clean("grammar_recovered.spl", valid)).to_equal(true)
