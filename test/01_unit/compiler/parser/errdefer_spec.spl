"""
## Purpose and audience
Executable specification for `errdefer` and `defer` statement semantics across
the pure-Simple core parser and tree-walking interpreter (`compiler.core.interpreter`).
`errdefer` runs its deferred statement in LIFO order only when the enclosing
function scope exits with an error; `defer` runs unconditionally on function exit.

## Operator workflow
1. Run `bin/simple test test/01_unit/compiler/parser/errdefer_spec.spl`.
2. Confirm every scenario passes with 0 failures.

## Compatibility and limitations
Covers single-statement `defer expr` and `errdefer expr` in `core_jit_interpret`
(tree-walk threshold); native codegen and block-form `defer:` are out of scope here.
"""
# @req: REQ-COMPILER-PARSER-001
# @cover src/compiler/10.frontend/core/interpreter/eval.spl 80%
# @cover src/compiler/10.frontend/core/interpreter/eval_calls.spl 80%

use std.spec.{describe, it, expect, step}
use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}
use compiler.core.ast.{ast_reset}
use compiler.core.ast_stmt.{stmt_get_tag, STMT_ERRDEFER}
use compiler.frontend.core.interpreter.mod.{core_jit_interpret}
use compiler.frontend.core.interpreter.eval.{eval_has_error}
use compiler.frontend.core.interpreter.env.{env_lookup}
use compiler.frontend.core.interpreter.value.{val_get_bool, val_get_int}

fn run_core(source: text, path: text) -> i64:
    core_jit_interpret(source, path, 999999)

describe "Errdefer":
    describe "parsing":
        it "parses an errdefer statement into STMT_ERRDEFER without parse errors":
            # @req REQ-COMPILER-PARSER-001
            step("Parse a function declaring an errdefer statement")
            val src = "fn parse_probe() -> i64:\n    var cleaned = 0\n    errdefer cleaned = 1\n    val x = 42\n    x\n"
            ast_reset()
            parser_set_had_error(false)
            parse_module(src, "errdefer_parse.spl")
            expect(parser_has_errors()).to_equal(false)

            val res = run_core(src + "parse_probe()\n", "errdefer_parse_exec.spl")
            expect(eval_has_error()).to_equal(false)
            expect(val_get_int(res)).to_equal(42)

    describe "interpreter semantics":
        it "errdefer does NOT run on success":
            # @req REQ-COMPILER-PARSER-001
            step("Run a success path guarded by errdefer and confirm it stays cold")
            val src = "var ran = false\nfn success_path() -> i64:\n    errdefer ran = true\n    42\nsuccess_path()\n"
            val res = run_core(src, "errdefer_success.spl")
            expect(eval_has_error()).to_equal(false)
            expect(val_get_int(res)).to_equal(42)
            expect(val_get_bool(env_lookup("ran"))).to_equal(false)

        it "errdefer runs on error":
            # @req REQ-COMPILER-PARSER-001
            step("Divide by zero inside a guarded fn and observe cleanup execution")
            val src = "var ran = false\nfn error_path() -> i64:\n    errdefer ran = true\n    val bad = 1 / 0\n    0\nerror_path()\n"
            run_core(src, "errdefer_error.spl")
            expect(eval_has_error()).to_equal(true)
            expect(val_get_bool(env_lookup("ran"))).to_equal(true)

        it "defer always runs on success and error paths":
            # @req REQ-COMPILER-PARSER-001
            step("Run both success and failing fns with defer and verify cleanup runs")
            val ok_src = "var ran_ok = false\nfn ok_path() -> i64:\n    defer ran_ok = true\n    42\nok_path()\n"
            val ok_res = run_core(ok_src, "defer_success.spl")
            expect(eval_has_error()).to_equal(false)
            expect(val_get_int(ok_res)).to_equal(42)
            expect(val_get_bool(env_lookup("ran_ok"))).to_equal(true)

            val err_src = "var ran_err = false\nfn fail_path() -> i64:\n    defer ran_err = true\n    val bad = 1 / 0\n    0\nfail_path()\n"
            run_core(err_src, "defer_error.spl")
            expect(eval_has_error()).to_equal(true)
            expect(val_get_bool(env_lookup("ran_err"))).to_equal(true)

        it "multiple errdefers run in LIFO order on error":
            # @req REQ-COMPILER-PARSER-001
            step("Stack three errdefers and trigger division by zero")
            val src = "var trace = 0\nfn multi_errdefer() -> i64:\n    errdefer trace = trace * 10 + 1\n    errdefer trace = trace * 10 + 2\n    errdefer trace = trace * 10 + 3\n    val bad = 1 / 0\n    0\nmulti_errdefer()\n"
            run_core(src, "errdefer_lifo.spl")
            expect(eval_has_error()).to_equal(true)
            expect(val_get_int(env_lookup("trace"))).to_equal(321)
