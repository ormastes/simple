# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




use std.spec.{describe, it, expect, step}
use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}

extern fn rt_file_read_text(path: text) -> text?

fn read_text(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn bitfield_parses_clean(name: text, src: text) -> bool:
    parser_set_had_error(false)
    parse_module(src, name)
    not parser_has_errors()

describe "Bitfield Pure Simple Implementation":
    """Verifies bitfield token registration, split parser routing, and width validation."""

    # @manual scenario evidence
    it "registers bitfield keyword in token table":
        # @req REQ-SSPEC-UNIT
        step("registers bitfield keyword in token table")
        val tokens = read_text("src/compiler/10.frontend/core/tokens.spl")
        expect(tokens.contains("TOK_KW_BITFIELD")).to_equal(true)
        expect(tokens.contains("if name == \"bitfield\": return TOK_KW_BITFIELD")).to_equal(true)
        expect(tokens.contains("if kind == TOK_KW_BITFIELD: return \"bitfield\"")).to_equal(true)

    it "routes module declarations to parse_bitfield_decl":
        val body = read_text("src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl")
        val bitfield_mod = read_text("src/compiler/10.frontend/core/_ParserDecls/bitfield_aop_arch_decls.spl")
        expect(body.contains("parse_bitfield_decl()")).to_equal(true)
        expect(bitfield_mod.contains("fn parse_bitfield_decl() -> i64:")).to_equal(true)

    it "supports backing type and reserved underscore fields":
        val decls = read_text("src/compiler/10.frontend/core/_ParserDecls/bitfield_aop_arch_decls.spl")
        expect(decls.contains("var backing_type = parser_parse_type()")).to_equal(true)
        expect(decls.contains("val is_underscore: bool")).to_equal(true)
        val ok_src = "bitfield Flags(u32):\n    enabled: bool\n    _: u7\n    mode: u8\n"
        expect(bitfield_parses_clean("bitfield_ok.spl", ok_src)).to_equal(true)

    it "enforces backing and field width validation in parser":
        val decls = read_text("src/compiler/10.frontend/core/_ParserDecls/bitfield_aop_arch_decls.spl")
        expect(decls.contains("bitfield backing type must be u8, u16, u32, or u64")).to_equal(true)
        expect(decls.contains("bitfield field type must be bool, uN, or iN")).to_equal(true)
        expect(decls.contains("int_to_str(used_bits)")).to_equal(true)
        val bad_backing = "bitfield Bad(text):\n    flag: bool\n"
        val bad_width = "bitfield TooWide(u8):\n    a: u5\n    b: u5\n"
        expect(bitfield_parses_clean("bitfield_bad_backing.spl", bad_backing)).to_equal(false)
        expect(bitfield_parses_clean("bitfield_too_wide.spl", bad_width)).to_equal(false)
