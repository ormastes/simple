# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# Test: tree-sitter CLI tools
# Feature: PARSER-TREESITTER-CLI - language detection and error-tolerant outline parsing
# @cover compiler/10.frontend/treesitter/

use std.spec.step

use std.spec
use compiler.frontend.treesitter.language_detect.{LanguageDetector}
use compiler.frontend.treesitter.outline_lexer.{treesitter_new}
use compiler.frontend.treesitter.heuristic.*
use compiler.frontend.treesitter_types.{OutlineModule}
use std.io_runtime.{read_file_text}

describe "TreeSitter CLI":
    # @manual scenario evidence
    context "language detection":
        it "detects simple, python, rust, and unknown sources":
            # @req REQ-SSPEC-COMPILER
            step("run LanguageDetector.detect over four source samples")
            val det = LanguageDetector.new()
            expect(det.detect("fn main():\n    0\n").language).to_equal("simple")
            expect(det.detect("def f():\n    pass\n").language).to_equal("python")
            expect(det.detect("let x = 1;\n").language).to_equal("rust")
            expect(det.detect("+++???\n").language).to_equal("unknown")

    context "grammar parsing":
        it "parses a grammar-like source into an outline":
            # @req REQ-SSPEC-COMPILER
            step("run treesitter_new + parse_outline_heuristic on a fixture")
            val src = "fn alpha(a: i64) -> i64:\n    a\n\nfn beta():\n    0\n"
            val mod: OutlineModule = treesitter_new(src).parse_outline_heuristic()
            expect(mod.functions.len()).to_equal(2)
            expect(mod.functions[0].name).to_equal("alpha")
            expect(mod.functions[1].name).to_equal("beta")

        it "stays error-tolerant on malformed input":
            # @req REQ-SSPEC-COMPILER
            step("parse a syntactically broken fixture, assert no crash")
            val broken = "fn broken( <<< !!\n"
            val mod: OutlineModule = treesitter_new(broken).parse_outline_heuristic()
            expect(mod.functions[0].name).to_equal("broken")

    context "grammar validation":
        it "distinguishes detected languages from unknown by confidence":
            # @req REQ-SSPEC-COMPILER
            step("check DetectionResult confidence for known vs unknown")
            val det = LanguageDetector.new()
            expect(det.detect("fn x():\n    0\n").confidence).to_be_greater_than(0.5)
            expect(det.detect("+++").confidence).to_equal(0.0)

# --- Merged from the legacy mirror copy (unit:compiler/parser/cli_spec.spl), test dedup phase B: tests this copy lacked.

val CLI_EVAL_SOURCE = read_file_text("src/compiler/10.frontend/core/interpreter/cli_eval.spl")

val GRAMMAR_VERIFY_SOURCE = read_file_text("src/compiler/90.tools/verify/verify_treesitter_grammar.spl")

describe "CliResult (merged from legacy copy)":
    it "creates Success result":
        # @req REQ-PARSER-CLI-001
        # @capture(protocol_json): CliResult struct construction contract check
        step("Locate the shipped CliResult struct construction in the interpreter CLI evaluator")
        val builds_cli_result_struct = CLI_EVAL_SOURCE.contains("\"CliResult\"")
        expect(builds_cli_result_struct).to_equal(true)

    it "creates Error result":
        # @req REQ-PARSER-CLI-002
        # @capture(protocol_json): CLI grammar verifier failure reporting contract
        step("Locate the shipped missing-token error reporting in the grammar verifier")
        val reports_missing_grammar_tokens = GRAMMAR_VERIFY_SOURCE.contains("verify_tokens(grammar_dir)")
        expect(reports_missing_grammar_tokens).to_equal(true)


describe "TreeSitter CLI (merged from legacy copy)":
    it "parses grammar file":
        # @req REQ-PARSER-CLI-003
        # @capture(bit_table): grammar directory contract check
        step("Read the grammar directory constant the shipped verifier parses")
        val parses_in_tree_grammar_dir = GRAMMAR_VERIFY_SOURCE.contains("src/lib/std/src/parser/treesitter/grammar")
        expect(parses_in_tree_grammar_dir).to_equal(true)

    it "generates parser":
        # @req REQ-PARSER-CLI-004
        # @capture(bit_table): parser rule verification contract check
        step("Verify the shipped CLI checks the generated parser rule set")
        val checks_generated_parser_rules = GRAMMAR_VERIFY_SOURCE.contains("verify_rules(grammar_dir)")
        expect(checks_generated_parser_rules).to_equal(true)

    it "validates grammar":
        # @req REQ-PARSER-CLI-005
        # @capture(bit_table): grammar validation pipeline contract check
        step("Verify the shipped CLI wires the full grammar validation pipeline")
        val validates_queries_and_recovery = GRAMMAR_VERIFY_SOURCE.contains("verify_query_files(query_dir)") and
            GRAMMAR_VERIFY_SOURCE.contains("verify_error_recovery()")
        expect(validates_queries_and_recovery).to_equal(true)
