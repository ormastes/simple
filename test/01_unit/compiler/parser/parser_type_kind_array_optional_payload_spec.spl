use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{
    Expr, ExprKind, Type, TypeKind, parser_type_kind_is_array,
    parser_type_named_dependencies}

fn array_payload_test_span() -> Span:
    Span(0, 0, 0, 0, "", 0)

describe "parser TypeKind.Array optional size payload" :
    it "retains an actual length expression and its element type":
        val span = array_payload_test_span()
        val element = Type(kind: TypeKind.Named("Element", []), span: span)
        val length_expr = Expr(kind: ExprKind.IntLit(7), span: span)
        val size: Expr? = Some(length_expr)
        val kind = TypeKind.Array(element, size)
        val array_type = Type(kind: kind, span: span)

        expect(parser_type_kind_is_array(kind)).to_be(true)
        expect(parser_type_named_dependencies(array_type)).to_equal(["Element"])

        var observed_length = -1
        match kind:
            case TypeKind.Array(_, actual_size):
                if val actual_expr = actual_size:
                    match actual_expr.kind:
                        case ExprKind.IntLit(value): observed_length = value
                        case _: observed_length = -2
            case _: observed_length = -2
        expect(observed_length).to_equal(7)

    it "keeps an explicitly typed absent size and rejects non-array kinds":
        val span = array_payload_test_span()
        val element = Type(kind: TypeKind.Named("Element", []), span: span)
        val no_size: Expr? = None
        val unsized_kind = TypeKind.Array(element, no_size)
        val unsized_type = Type(kind: unsized_kind, span: span)

        expect(parser_type_kind_is_array(unsized_kind)).to_be(true)
        expect(parser_type_named_dependencies(unsized_type)).to_equal(["Element"])

        val scalar_kind = TypeKind.Named("Scalar", [])
        val scalar_type = Type(kind: scalar_kind, span: span)
        expect(parser_type_kind_is_array(scalar_kind)).to_be(false)
        expect(parser_type_named_dependencies(scalar_type)).to_equal(["Scalar"])
