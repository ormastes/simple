        expect true

    it "allocates node and returns id":
        expect true

    it "allocates multiple nodes with sequential indices":
        expect true

    it "retrieves node by id":
        expect true

    it "returns None for invalid generation":
        expect true

    it "returns None for out of bounds index":
        expect true


