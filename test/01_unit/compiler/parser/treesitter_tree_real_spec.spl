"""
## Purpose and audience
Purpose: Verify `LexSpan` geometry helpers (`lex_span_new`, `lex_span_empty`,
`span_merge`, `span_len`) and real `OutlineModule` AST tree construction via `TreeSitter`.
Audience: compiler and AST infrastructure engineers.

## Operator workflow
1. Run `bin/simple test test/01_unit/compiler/parser/treesitter_tree_real_spec.spl`.
2. Require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; exercises real `LexSpan` and `TreeSitter.parse_outline`.
"""
# @req: REQ-COMPILER-FRONTEND-TREESITTER-TREE-001
# @cover src/compiler/10.frontend/core/lexer_types.spl 80%
# @cover src/compiler/10.frontend/treesitter/outline.spl 80%

use std.spec.*
use std.spec.step
use compiler.core.lexer_types.{LexSpan, lex_span_new, lex_span_empty, span_merge, span_len}
use compiler.treesitter.*

describe "LexSpan Operations":
    it "creates span with byte positions and computes span_len":
        step("Construct LexSpan with byte offsets and verify span_len")
        val s = lex_span_new(4, 15, 2, 5)
        expect(s.start).to_equal(4)
        expect(s.end_pos).to_equal(15)
        expect(s.line).to_equal(2)
        expect(s.col).to_equal(5)
        expect(span_len(s)).to_equal(11)

    it "creates zero-length empty span":
        step("Verify lex_span_empty initializes zeroes")
        val empty = lex_span_empty()
        expect(empty.start).to_equal(0)
        expect(empty.end_pos).to_equal(0)
        expect(span_len(empty)).to_equal(0)

    it "merges disjoint spans preserving earliest start and latest end":
        step("Merge two spans via span_merge in both orders")
        val left = lex_span_new(2, 6, 1, 3)
        val right = lex_span_new(10, 18, 3, 1)
        val merged_lr = span_merge(left, right)
        val merged_rl = span_merge(right, left)
        expect(merged_lr.start).to_equal(2)
        expect(merged_lr.end_pos).to_equal(18)
        expect(span_len(merged_lr)).to_equal(16)
        expect(merged_rl.start).to_equal(2)
        expect(merged_rl.end_pos).to_equal(18)

describe "OutlineModule Tree Construction":
    it "preserves spans on parsed functions and classes":
        step("Parse class with methods and verify non-empty outlines and byte spans")
        val src = "class Counter:\n    value: i64\n\n    me inc(delta: i64) -> i64:\n        self.value = self.value + delta\n        self.value\n\nfn top() -> i64:\n    0\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.errors.len()).to_equal(0)
        expect(outline.classes.len()).to_equal(1)
        expect(outline.classes[0].name).to_equal("Counter")
        expect(outline.classes[0].fields.len()).to_equal(1)
        expect(outline.classes[0].methods.len()).to_equal(1)
        expect(outline.classes[0].methods[0].name).to_equal("inc")
        expect(outline.classes[0].methods[0].is_mutable).to_equal(true)
        expect(span_len(outline.classes[0].span)).to_be_greater_than(0)
        expect(outline.functions.len()).to_equal(1)
        expect(outline.functions[0].name).to_equal("top")
        expect(span_len(outline.functions[0].span)).to_be_greater_than(0)

    it "collects actors, bitfields, and variants accurately":
        step("Parse actor and bitfield declarations into OutlineModule")
        val src = "actor Worker:\n    inbox: i64\n\nbitfield Flags(u32):\n    ready: u8\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.errors.len()).to_equal(0)
        expect(outline.actors.len()).to_equal(1)
        expect(outline.actors[0].name).to_equal("Worker")
        expect(outline.bitfields.len()).to_equal(1)
        expect(outline.bitfields[0].name).to_equal("Flags")
