use compiler.core.parser.{parse_module, parser_set_had_error, parser_has_errors, parser_get_errors}

describe "where clause constraints":
    it "parses inherent, nested trait, and constrained generic impl headers":
        parser_set_had_error(false)
        val source = "impl Option<T>:\n" +
            "    fn option_marker():\n" +
            "        pass\n" +
            "impl OsFuture<Result<T, E>> for Ready<Result<T, E>>:\n" +
            "    fn nested_marker():\n" +
            "        pass\n" +
            "impl<T> Hash for Box<T> where T: Hash:\n" +
            "    fn constrained_marker():\n" +
            "        pass\n"
        parse_module(source, "generic_impl_header_regression.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)

    it "accepts deeper nesting and explicit constrained parameters":
        for header in ["impl Outer<Middle<Leaf<T>>>:", "impl<T> Trait<Box<T>> for Owner<T> where T: Trait:", "impl Box<i64>:"]:
            parser_set_had_error(false)
            parse_module(header + "\n    fn marker():\n        pass\n", "nested_neighbors.spl")
            expect(parser_has_errors()).to_equal(false)
    it "rejects a missing nested close delimiter":
        parser_set_had_error(false)
        parse_module("impl Outer<Inner<T>:\n    fn marker():\n        pass\n", "nested_bad.spl")
        expect(parser_has_errors()).to_equal(true)
