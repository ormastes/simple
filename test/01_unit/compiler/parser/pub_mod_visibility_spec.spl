use compiler.core.parser.{parse_module, parser_has_errors, parser_get_errors}
use compiler.core.ast.{decl_count, decl_get_name, decl_get_visibility_text}

describe "public module declarations":
    it "parses pub mod through the visibility dispatcher":
        parse_module("pub mod child\npub mod nested.child\npub mod async\n", "pub_mod_visibility_spec.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)
        expect(decl_count()).to_equal(3)
        expect(decl_get_name(0)).to_equal(".child")
        expect(decl_get_name(1)).to_equal(".child")
        expect(decl_get_name(2)).to_equal(".async")
        expect(decl_get_visibility_text(0)).to_equal("public")
        expect(decl_get_visibility_text(1)).to_equal("public")
        expect(decl_get_visibility_text(2)).to_equal("public")
