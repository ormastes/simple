"""
# Feature: Language Detection
# Category: Parser/TreeSitter
# Status: Complete

Purpose: core language semantics hold under execution. Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.
"""

use std.spec.{describe, it, expect, step}
use compiler.frontend.treesitter.language_detect.{DetectionResult, LanguageDetector}

describe "DetectionResult":
    """Tests for language detection result creation and confidence ranking."""

    it "creates detection result":
        val result = DetectionResult.new(language: "simple", confidence: 0.95)
        expect(result.language).to_equal("simple")
        expect(result.confidence).to_equal(0.95)

    it "ranks by confidence":
        val results = [
            DetectionResult.new(language: "rust", confidence: 0.8),
            DetectionResult.new(language: "python", confidence: 0.95),
            DetectionResult.new(language: "simple", confidence: 0.9)
        ]
        expect(results[1].confidence).to_equal(0.95)

describe "LanguageDetector":
    """Tests for language detection for Python, Rust, Simple, and unknown languages."""

    it "detects Python":
        step("Detect Python fn syntax via def keyword")
        val detector = LanguageDetector.new()
        val result = detector.detect("def greet(name):\n    return name")
        expect(result.language).to_equal("python")
        expect(result.confidence).to_be_greater_than(0.5)

    it "detects Rust":
        step("Detect Rust bindings via let keyword")
        val detector = LanguageDetector.new()
        val result = detector.detect("let x = 42;")
        expect(result.language).to_equal("rust")
        expect(result.confidence).to_be_greater_than(0.5)

    it "detects Simple":
        step("Detect Simple functions via fn keyword")
        val detector = LanguageDetector.new()
        val result = detector.detect("fn greet(name: text) -> text:\n    name")
        expect(result.language).to_equal("simple")
        expect(result.confidence).to_be_greater_than(0.5)

    it "handles unknown languages":
        step("Return unknown with 0.0 confidence when no marker matches")
        val detector = LanguageDetector.new()
        val result = detector.detect("just plain text without markers")
        expect(result.language).to_equal("unknown")
        expect(result.confidence).to_equal(0.0)
