# Purpose and audience: regression evidence for the parser owners.
# @req REQ-SSPEC-UNIT
"""
Regression for comment_only_block_swallows_next_statement_2026-10-04.

A block header whose only following lines are comments (or blank) has no body.
The next sibling statement at the header's own column must not be swallowed as a
"flat body"; the parser must report an error instead.
"""

use std.spec
use std.spec.step
use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}

fn parse_has_error(source: text) -> bool:
    parser_set_had_error(false)
    parse_module(source, "comment_only_block_body.spl")
    parser_has_errors()

describe "comment-only block body":
    it "rejects if with a comment-only body followed by a sibling":
        step("parse repro")
        val src = "fn main() -> i64:\n    if false:\n        # nothing\n    print \"after-if\"\n    0\n"
        expect(parse_has_error(src)).to_equal(true)

    it "rejects while with a comment-only body followed by a sibling":
        step("parse while")
        val src = "fn main() -> i64:\n    while false:\n        # nothing\n    print \"x\"\n    0\n"
        expect(parse_has_error(src)).to_equal(true)

    it "rejects for with a comment-only body followed by a sibling":
        step("parse for")
        val src = "fn main() -> i64:\n    for i in 0..1:\n        # nothing\n    print \"x\"\n    0\n"
        expect(parse_has_error(src)).to_equal(true)

    it "rejects else with a comment-only body followed by a sibling":
        step("parse else")
        val src = "fn main() -> i64:\n    if true:\n        pass\n    else:\n        # nothing\n    print \"x\"\n    0\n"
        expect(parse_has_error(src)).to_equal(true)

    it "accepts a comment followed by a real indented body":
        step("parse ok")
        val src = "fn main() -> i64:\n    if false:\n        # note\n        print \"x\"\n    0\n"
        expect(parse_has_error(src)).to_equal(false)

    it "accepts pass as the explicit empty body":
        step("parse pass")
        val src = "fn main() -> i64:\n    if false:\n        # note\n        pass\n    print \"x\"\n    0\n"
        expect(parse_has_error(src)).to_equal(false)

    it "still accepts a flat body on the immediately following line":
        step("parse flat")
        val src = "fn main() -> i64:\n    if false:\n    print \"x\"\n    0\n"
        expect(parse_has_error(src)).to_equal(false)
