"""Assertion argument shape regression. Authored; runtime execution is separate.

REQ-NOGC-ASSERT-001: assertion diagnostics must check the condition rather than
the allocation address of a tuple containing the condition and message.
"""

use std.spec.*
use std.spec.step
use compiler.core.parser.{parser_init, parser_has_errors}
use compiler.core.parser_stmts.{parse_statement}
use compiler.core.ast.{stmt_get_expr, expr_get_tag, expr_get_args, expr_get_left, expr_get_str, EXPR_BOOL_LIT, EXPR_BINARY}

fn parse_assert_arguments(source: text) -> [i64]:
    parser_init(source)
    val expression = stmt_get_expr(parse_statement())
    expect(expr_get_str(expr_get_left(expression))).to_equal("__assert")
    expr_get_args(expression)

describe "parenthesized assertion arguments":
    it "keeps a false condition separate from its message":
        step("Parse a false assertion with a message")
        val arguments = parse_assert_arguments("assert(false, \"must fail\")\n")
        expect(parser_has_errors()).to_equal(false)
        expect(arguments.len()).to_equal(2)
        expect(expr_get_tag(arguments[0])).to_equal(EXPR_BOOL_LIT)

    it "preserves bare and single parenthesized assertions":
        step("Parse the existing assertion forms")
        val bare = parse_assert_arguments("assert false, \"must fail\"\n")
        expect(bare.len()).to_equal(2)
        expect(expr_get_tag(bare[0])).to_equal(EXPR_BOOL_LIT)
        val single = parse_assert_arguments("assert(false)\n")
        expect(single.len()).to_equal(1)
        expect(expr_get_tag(single[0])).to_equal(EXPR_BOOL_LIT)
        expect(parser_has_errors()).to_equal(false)

    it "preserves a grouped condition with a boolean continuation":
        step("Parse a grouped expression followed by or")
        val arguments = parse_assert_arguments("assert (false) or true\n")
        expect(arguments.len()).to_equal(1)
        expect(expr_get_tag(arguments[0])).to_equal(EXPR_BINARY)
        expect(parser_has_errors()).to_equal(false)

    it "rejects missing conditions extra messages and nested tuple conditions":
        step("Reject assertion shapes that cannot represent a boolean condition")
        parse_assert_arguments("assert()\n")
        expect(parser_has_errors()).to_equal(true)
        parse_assert_arguments("assert(false, \"one\", \"two\")\n")
        expect(parser_has_errors()).to_equal(true)
        parse_assert_arguments("assert false, \"one\", \"two\"\n")
        expect(parser_has_errors()).to_equal(true)
        parse_assert_arguments("assert((false, true), \"tuple\")\n")
        expect(parser_has_errors()).to_equal(true)
