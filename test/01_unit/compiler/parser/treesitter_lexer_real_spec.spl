"""
## Purpose and audience
Purpose: Verify real tokenization via `compiler.core.lexer` and `compiler.core.lexer_types.TokenKind`
for keywords, identifiers, numbers, operators, delimiters, multi-token sequences,
and unexpected-character error reporting.
Audience: compiler and parser engineers running `test/01_unit/compiler/parser/`.

## Operator workflow
1. Run `bin/simple test test/01_unit/compiler/parser/treesitter_lexer_real_spec.spl`.
2. Require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane against `compiler.core.lexer` and `compiler.core.lexer_types`.
"""
# @req: REQ-COMPILER-FRONTEND-LEXER-002
# @cover src/compiler/10.frontend/core/lexer.spl 80%
# @cover src/compiler/10.frontend/core/lexer_types.spl 80%

use std.spec.*
use std.spec.step
use compiler.core.lexer.{lex_init, lex_next_token_record, lex_token_text}
use compiler.core.lexer_types.{Token, TokenKind, token_is_keyword, token_is_operator, token_is_literal}

fn lex_all_records(source: text) -> [Token]:
    lex_init(source)
    var out: [Token] = []
    for _ in 0..128:
        val tok = lex_next_token_record()
        out.push(tok)
        if tok.kind == TokenKind.Eof:
            break
    out

describe "Lexer Creation":
    it "creates lexer with empty source and returns Eof":
        step("Tokenize empty source and verify immediate TokenKind.Eof")
        val tokens = lex_all_records("")
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].kind).to_equal(TokenKind.Eof)

    it "creates lexer with whitespace only and returns Eof":
        step("Tokenize spaces and tabs and verify Eof")
        val tokens = lex_all_records("   \t  ")
        expect(tokens.len()).to_equal(1)
        expect(tokens[0].kind).to_equal(TokenKind.Eof)

describe "Keyword Tokenization":
    it "tokenizes declaration and control keywords":
        step("Verify fn, val, var, return, if, else, struct, class, match, while")
        val tokens = lex_all_records("fn val var return if else struct class match while")
        expect(tokens[0].kind).to_equal(TokenKind.KwFn)
        expect(tokens[1].kind).to_equal(TokenKind.KwVal)
        expect(tokens[2].kind).to_equal(TokenKind.KwVar)
        expect(tokens[3].kind).to_equal(TokenKind.KwReturn)
        expect(tokens[4].kind).to_equal(TokenKind.KwIf)
        expect(tokens[5].kind).to_equal(TokenKind.KwElse)
        expect(tokens[6].kind).to_equal(TokenKind.KwStruct)
        expect(tokens[7].kind).to_equal(TokenKind.KwClass)
        expect(tokens[8].kind).to_equal(TokenKind.KwMatch)
        expect(tokens[9].kind).to_equal(TokenKind.KwWhile)
        expect(token_is_keyword(tokens[0])).to_equal(true)
        expect(token_is_keyword(tokens[9])).to_equal(true)

    it "tokenizes true, false, and nil literals":
        step("Verify BoolLit and NilLit classification")
        val tokens = lex_all_records("true false nil")
        expect(tokens[0].kind).to_equal(TokenKind.BoolLit)
        expect(tokens[0].text).to_equal("true")
        expect(tokens[1].kind).to_equal(TokenKind.BoolLit)
        expect(tokens[1].text).to_equal("false")
        expect(tokens[2].kind).to_equal(TokenKind.NilLit)
        expect(tokens[2].text).to_equal("nil")
        expect(token_is_literal(tokens[0])).to_equal(true)
        expect(token_is_literal(tokens[2])).to_equal(true)

describe "Identifier Tokenization":
    it "tokenizes simple, underscored, numeric-suffixed, and uppercase identifiers":
        step("Verify identifier lexemes and TokenKind.Ident")
        val tokens = lex_all_records("foo foo_bar item2 Point")
        expect(tokens[0].kind).to_equal(TokenKind.Ident)
        expect(tokens[0].text).to_equal("foo")
        expect(tokens[1].kind).to_equal(TokenKind.Ident)
        expect(tokens[1].text).to_equal("foo_bar")
        expect(tokens[2].kind).to_equal(TokenKind.Ident)
        expect(tokens[2].text).to_equal("item2")
        expect(tokens[3].kind).to_equal(TokenKind.Ident)
        expect(tokens[3].text).to_equal("Point")

describe "Number Tokenization":
    it "tokenizes integers, zero, and floating-point literals":
        step("Verify Integer and Float token kinds and text")
        val tokens = lex_all_records("0 7 42 3.14")
        expect(tokens[0].kind).to_equal(TokenKind.Integer)
        expect(tokens[0].text).to_equal("0")
        expect(tokens[1].kind).to_equal(TokenKind.Integer)
        expect(tokens[2].kind).to_equal(TokenKind.Integer)
        expect(tokens[2].text).to_equal("42")
        expect(tokens[3].kind).to_equal(TokenKind.Float)
        expect(tokens[3].text).to_equal("3.14")

describe "Operator and Delimiter Tokenization":
    it "tokenizes operators and delimiters with wire-faithful TokenKind":
        step("Verify +, -, *, ==, !=, <=, ->, (), {}, [], comma, colon")
        val tokens = lex_all_records("+ - * == != <= -> () {} [] , :")
        expect(tokens[0].kind).to_equal(TokenKind.Plus)
        expect(tokens[1].kind).to_equal(TokenKind.Minus)
        expect(tokens[2].kind).to_equal(TokenKind.Star)
        expect(tokens[3].kind).to_equal(TokenKind.Eq)
        expect(tokens[4].kind).to_equal(TokenKind.NotEq)
        expect(tokens[5].kind).to_equal(TokenKind.LtEq)
        expect(tokens[6].kind).to_equal(TokenKind.Arrow)
        expect(tokens[7].kind).to_equal(TokenKind.LParen)
        expect(tokens[8].kind).to_equal(TokenKind.RParen)
        expect(tokens[9].kind).to_equal(TokenKind.LBrace)
        expect(tokens[10].kind).to_equal(TokenKind.RBrace)
        expect(tokens[11].kind).to_equal(TokenKind.LBracket)
        expect(tokens[12].kind).to_equal(TokenKind.RBracket)
        expect(tokens[13].kind).to_equal(TokenKind.Comma)
        expect(tokens[14].kind).to_equal(TokenKind.Colon)
        expect(token_is_operator(tokens[0])).to_equal(true)
        expect(token_is_operator(tokens[4])).to_equal(true)

describe "Multi-Token Sequences and Errors":
    it "tokenizes function signatures and variable declarations":
        step("Tokenize fn add(a: i64, b: i64) -> i64:")
        val tokens = lex_all_records("fn add(a: i64, b: i64) -> i64:")
        expect(tokens[0].kind).to_equal(TokenKind.KwFn)
        expect(tokens[1].text).to_equal("add")
        expect(tokens[2].kind).to_equal(TokenKind.LParen)
        expect(tokens[10].kind).to_equal(TokenKind.RParen)
        expect(tokens[11].kind).to_equal(TokenKind.Arrow)
        expect(tokens[12].kind).to_equal(TokenKind.Ident)
        expect(tokens[13].kind).to_equal(TokenKind.Colon)

    it "reports error token for unexpected characters":
        step("Verify unclosed backtick emits TokenKind.Error")
        val tokens = lex_all_records("`unclosed")
        expect(tokens[0].kind).to_equal(TokenKind.Error)
        expect(tokens[0].text).to_contain("Unclosed backtick")
