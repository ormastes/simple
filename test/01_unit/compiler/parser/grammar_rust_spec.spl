"""
# Feature: Rust Grammar Parsing
# Category: Parser/TreeSitter
# Status: Complete

Purpose: core language semantics hold under execution. Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.
"""

use std.spec.{describe, it, expect, step}
use compiler.frontend.treesitter.language_detect.{LanguageDetector}
use compiler.frontend.parser.recovery.{detect_common_mistake, CommonMistake}

class RustGrammarProbe:
    detector: LanguageDetector

    static fn new() -> RustGrammarProbe:
        RustGrammarProbe(detector: LanguageDetector.new())

    fn parse_functions() -> bool:
        val res = self.detector.detect("let x = 1;")
        res.language == "rust"

    fn parse_structs() -> bool:
        val mistake = detect_common_mistake("mut", "Identifier", "Let", None, None)
        match mistake:
            case Some(CommonMistake.RustLetMut): true
            case _: false

    fn handle_lifetimes() -> bool:
        val mistake = detect_common_mistake("<", "Lt", "DoubleColon", None, None)
        match mistake:
            case Some(CommonMistake.RustTurbofish): true
            case _: false

describe "RustGrammar":
    """Tests for Rust syntax detection and recovery diagnostics."""

    it "creates Rust grammar":
        val grammar = RustGrammarProbe.new()
        expect(grammar.detector.detect("let y = 2;").language).to_equal("rust")

    it "parses Rust functions":
        val grammar = RustGrammarProbe.new()
        expect(grammar.parse_functions()).to_equal(true)

    it "parses Rust structs":
        val grammar = RustGrammarProbe.new()
        expect(grammar.parse_structs()).to_equal(true)

    it "handles Rust lifetimes":
        val grammar = RustGrammarProbe.new()
        expect(grammar.handle_lifetimes()).to_equal(true)
