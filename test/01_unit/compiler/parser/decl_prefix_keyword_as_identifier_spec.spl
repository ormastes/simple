"""
## Purpose and audience
Purpose: Prove that Declaration-prefix keywords as identifiers.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-PARSER-001 — stable requirement identity for this spec.

"""
# Declaration-Prefix Keywords Usable As Identifiers

Regression for `doc/08_tracking/bug/spec_val_match_parse_expected_let_found_dot_2026-08-21.md`.

`mut`, `shared` and `ghost` are declaration prefixes only in the two-token
forms `mut let` / `shared let` / `ghost let` — every one of those parsers
`expect`s `Let` as its second token. Dispatching on the bare keyword meant a
statement like `ghost.set(k, v)`, using an ordinary variable named `ghost`,
died with `Unexpected token: expected Let, found Dot`. The reported symptom
blamed a nearby `val x = match ...`; the match was incidental, so the
neighbouring compact forms are pinned here too.
"""

class Ghost:
    var status: text = ""
    fn set(v: text):
        self.status = v

fn classify(n: i64) -> text:
    val ok = match n:
        case 3:
            "three"
        case _:
            "other"
    ok

use std.spec.step

describe "Declaration-prefix keywords as identifiers":
    it "parses a method call on a variable named ghost":
        step("Verify: parses a method call on a variable named ghost")
        # @req: REQ-COMPILER-PARSER-001
        val ghost = Ghost()
        ghost.set("lost write")
        expect(ghost.status).to_equal("lost write")

    it "parses assignment to variables named shared and mut":
        step("Verify: parses assignment to variables named shared and mut")
        var shared = 1
        shared = shared + 1
        expect(shared).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "binds val from a match and calls a method on the result":
        step("Verify: binds val from a match and calls a method on the result")
        val n = 3
        val ok = match n:
            case 3:
                "three"
            case _:
                "other"
        expect(ok.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(ok.to_upper()).to_equal("THREE")

    it "binds val from an if expression":
        step("Verify: binds val from an if expression")
        val n = 3
        val label = if n == 3: "yes" else: "no"
        expect(label.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "accepts a match expression in argument position":
        step("Verify: accepts a match expression in argument position")
        val n = 4
        expect(classify(n)).to_equal("other")
        expect(classify(3).len()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "combines a ghost-named variable with a val-from-match in one example":
        step("Verify: combines a ghost-named variable with a val-from-match in one example")
        val ghost = Ghost()
        val n = 3
        val ok = match n:
            case 3:
                "three"
            case _:
                "other"
        ghost.set(ok)
        expect(ghost.status.contains("thr")).to_equal(true)
