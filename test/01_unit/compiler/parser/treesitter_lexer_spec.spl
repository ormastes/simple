"""
## Purpose and audience
Purpose: Verify the pure-Simple core lexer stream (`lex_init`, `lex_next`, `CoreLexer`,
`core_lexer_next_token`) across empty inputs, keywords, identifiers, literals,
operators, delimiters, indentation, and comments.
Audience: compiler and frontend engineers maintaining `src/compiler/10.frontend/core/`.

## Operator workflow
1. Run `bin/simple test test/01_unit/compiler/parser/treesitter_lexer_spec.spl`.
2. Every scenario must pass with real lexer assertions.

## Compatibility and limitations
Executed on the interpreter test lane; covers token wire kinds, text, and line/col spans.
"""
# @req: REQ-COMPILER-FRONTEND-LEXER-001
# @cover src/compiler/10.frontend/core/lexer.spl 80%
# @cover src/compiler/10.frontend/core/lexer_struct.spl 80%

use std.spec.*
use std.spec.step
use compiler.core.lexer.{lex_init, lex_next, lex_token_text, lex_token_line, lex_token_col}
use compiler.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text}
use compiler.core.tokens.{
    TOK_EOF, TOK_KW_FN, TOK_KW_VAL, TOK_KW_VAR, TOK_KW_RETURN,
    TOK_IDENT, TOK_INT_LIT, TOK_STRING_LIT,
    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_EQ, TOK_NOT_EQ, TOK_LT_EQ, TOK_ARROW, TOK_ASSIGN,
    TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE, TOK_LBRACKET, TOK_RBRACKET,
    TOK_COMMA, TOK_COLON, TOK_INDENT, TOK_DEDENT, TOK_NEWLINE
}

fn collect_non_layout_kinds(source: text) -> [i64]:
    lex_init(source)
    var kinds: [i64] = []
    for _ in 0..64:
        val kind = lex_next()
        if kind == TOK_EOF:
            break
        if kind != TOK_NEWLINE and kind != TOK_INDENT and kind != TOK_DEDENT:
            kinds.push(kind)
    kinds

describe "Core Lexer Stream":
    it "tokenizes empty source immediately to EOF":
        step("Lex empty source and expect TOK_EOF")
        lex_init("")
        expect(lex_next()).to_equal(TOK_EOF)

    it "tokenizes keywords and preserves spellings":
        step("Lex fn, val, var, and return keywords")
        lex_init("fn val var return")
        expect(lex_next()).to_equal(TOK_KW_FN)
        expect(lex_token_text()).to_equal("fn")
        expect(lex_next()).to_equal(TOK_KW_VAL)
        expect(lex_token_text()).to_equal("val")
        expect(lex_next()).to_equal(TOK_KW_VAR)
        expect(lex_token_text()).to_equal("var")
        expect(lex_next()).to_equal(TOK_KW_RETURN)
        expect(lex_token_text()).to_equal("return")
        expect(lex_next()).to_equal(TOK_EOF)

    it "tokenizes identifiers, integers, and strings":
        step("Lex identifier, integer, and quoted string literal")
        lex_init("answer = 42\nlabel = \"hello\"")
        expect(lex_next()).to_equal(TOK_IDENT)
        expect(lex_token_text()).to_equal("answer")
        expect(lex_next()).to_equal(TOK_ASSIGN)
        expect(lex_next()).to_equal(TOK_INT_LIT)
        expect(lex_token_text()).to_equal("42")
        expect(lex_next()).to_equal(TOK_NEWLINE)
        expect(lex_next()).to_equal(TOK_IDENT)
        expect(lex_token_text()).to_equal("label")
        expect(lex_next()).to_equal(TOK_ASSIGN)
        expect(lex_next()).to_equal(TOK_STRING_LIT)
        expect(lex_token_text()).to_equal("hello")

    it "tokenizes multi-character operators and delimiters":
        step("Lex arithmetic, comparison, arrow, and brackets")
        val kinds = collect_non_layout_kinds("+ - * == != <= -> () {} [] , :")
        expect(kinds).to_equal([
            TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_EQ, TOK_NOT_EQ, TOK_LT_EQ, TOK_ARROW,
            TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE, TOK_LBRACKET, TOK_RBRACKET,
            TOK_COMMA, TOK_COLON
        ])

    it "skips comments and tracks indentation and line numbers":
        step("Lex indented function body following a comment")
        val src = "# header comment\nfn f():\n    42\n"
        lex_init(src)
        expect(lex_next()).to_equal(TOK_KW_FN)
        expect(lex_token_line()).to_equal(2)
        expect(lex_token_col()).to_equal(1)
        expect(lex_next()).to_equal(TOK_IDENT)
        expect(lex_next()).to_equal(TOK_LPAREN)
        expect(lex_next()).to_equal(TOK_RPAREN)
        expect(lex_next()).to_equal(TOK_COLON)
        expect(lex_next()).to_equal(TOK_NEWLINE)
        expect(lex_next()).to_equal(TOK_INDENT)
        expect(lex_next()).to_equal(TOK_INT_LIT)
        expect(lex_next()).to_equal(TOK_NEWLINE)
        expect(lex_next()).to_equal(TOK_DEDENT)
        expect(lex_next()).to_equal(TOK_EOF)

    it "advances CoreLexer tuples deterministically without globals":
        step("Drive CoreLexer via core_lexer_next_token")
        val lx0 = make_core_lexer("alpha + 7")
        val (lx1, k1) = core_lexer_next_token(lx0)
        expect(k1).to_equal(TOK_IDENT)
        expect(core_lexer_token_text(lx1)).to_equal("alpha")
        val (lx2, k2) = core_lexer_next_token(lx1)
        expect(k2).to_equal(TOK_PLUS)
        val (lx3, k3) = core_lexer_next_token(lx2)
        expect(k3).to_equal(TOK_INT_LIT)
        expect(core_lexer_token_text(lx3)).to_equal("7")
        val (_, k4) = core_lexer_next_token(lx3)
        expect(k4).to_equal(TOK_EOF)
