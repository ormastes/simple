# Feature: Tree-Sitter Lexer Module
# Category: Parser
# Status: Active

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

# Mock Token type
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")
class Token:
    type: text
    value: text

1. Run `bin/simple test test/01_unit/compiler/parser/treesitter_lexer_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/treesitter_lexer.md
# doc-path: doc/03_plan/sys_test/treesitter_lexer.md
# doc-path: doc/04_architecture/treesitter_lexer.md
# doc-path: doc/05_design/treesitter_lexer.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "numeric comparison helpers":
        step("Verify: numeric comparison helpers")
        # @req: REQ-COMPILER-PARSER-001
        expect(abs(-7)).to_equal(7)  # oracle: absolute value
        expect(max(3, 9)).to_equal(9)  # oracle: larger operand
        expect(min(3, 9)).to_equal(3)  # oracle: smaller operand

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-COMPILER-PARSER-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "array filtering and membership":
        step("Verify: array filtering and membership")
        # @req: REQ-COMPILER-PARSER-001
        expect([1, 2, 3].filter(fn(x: i64): x > 1)).to_equal([2, 3])
        expect([1, 2, 3].contains(2)).to_equal(true)
        expect([1, 2].concat([3])).to_equal([1, 2, 3])

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

describe "Lexer":
    # Tests lexical analysis with mock implementations
    it "tokenizes empty source":
        val lexer = MockLexer.new()
        val tokens = lexer.tokenize_empty()
        check(tokens.len() == 0)

    it "tokenizes keywords":
        val lexer = MockLexer.new()
        val result = lexer.tokenize_keywords("val x = 42")
        check(result)

    it "tokenizes identifiers":
        val lexer = MockLexer.new()
        val tokens = lexer.tokenize_identifiers("foo")
        check(tokens.len() > 0)

    it "tokenizes numbers":
        val lexer = MockLexer.new()
        val tokens = lexer.tokenize_numbers("123")
        check(tokens.len() > 0)

    it "tokenizes strings":
        val lexer = MockLexer.new()
        val tokens = lexer.tokenize_strings("\"hello\"")
        check(tokens.len() > 0)

    it "tokenizes operators":
        val lexer = MockLexer.new()
        val tokens = lexer.tokenize_operators("+")
        check(tokens.len() > 0)

    it "handles whitespace":
        val lexer = MockLexer.new()
        val result = lexer.handle_whitespace("   x   ")
        check(result)

    it "handles comments":
        val lexer = MockLexer.new()
        val result = lexer.handle_comments("# comment")
        check(result)
