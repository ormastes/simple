"""
# Feature: Python Grammar Parsing
# Category: Parser/TreeSitter
# Status: Complete

Purpose: core language semantics hold under execution. Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.
"""

use std.spec.{describe, it, expect, step}
use compiler.frontend.treesitter.language_detect.{LanguageDetector}

class PythonGrammarProbe:
    detector: LanguageDetector

    static fn new() -> PythonGrammarProbe:
        PythonGrammarProbe(detector: LanguageDetector.new())

    fn parse_functions() -> bool:
        self.detector.detect("def add(a, b):\n    return a + b").language == "python"

    fn parse_classes() -> bool:
        self.detector.detect("class Widget:\n    def render(self):\n        pass").language == "python"

    fn handle_indentation() -> bool:
        self.detector.detect("def outer():\n    if True:\n        return 1\n    return 0").language == "python"

describe "PythonGrammar":
    """Tests for Python language detection and function/class/indentation markers."""

    it "creates Python grammar":
        val grammar = PythonGrammarProbe.new()
        expect(grammar.detector.detect("def ok(): pass").language).to_equal("python")

    it "parses Python functions":
        val grammar = PythonGrammarProbe.new()
        expect(grammar.parse_functions()).to_equal(true)

    it "parses Python classes":
        val grammar = PythonGrammarProbe.new()
        expect(grammar.parse_classes()).to_equal(true)

    it "handles Python indentation":
        val grammar = PythonGrammarProbe.new()
        expect(grammar.handle_indentation()).to_equal(true)
