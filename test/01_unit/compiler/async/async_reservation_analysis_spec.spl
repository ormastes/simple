#!/usr/bin/env simple
"""
## Purpose and audience
Executable contract for the compile-time resource-reservation verifier used
by the baremetal async lanes (`compiler.desugar.reservation_analysis`),
owned by the compiler async team. It pins reserve lookup, per-resource
demand aggregation with instance weighting, overflow detection, per-task
contributor tracking, formatting, and the end-to-end NetRes scenario from
the async base design.
## Operator workflow
Run `simple run test/01_unit/compiler/async/async_reservation_analysis_spec.spl`
after touching `src/compiler/10.frontend/desugar/reservation_analysis.spl`
or the spawn-analysis data structures it consumes.
## Compatibility and limitations
Scenarios operate at the data-structure level (the same pattern as the Pass
A/B specs): reservation data is built by the fixtures, so attribute parsing
and AST walking are not covered here — those live in the integration lanes.
## Verification guidance and troubleshooting
A demand failure means the instances-weighted aggregation (count × actual
spawn instances) or the capacity comparison regressed; a formatting failure
means the operator-facing report drifted. Every expected demand is the
arithmetic sum of per-task count × instances stated in the oracle comments.
Rerun this single spec to reproduce a failure.
"""
# Lifecycle: doc/01_research/domain/simple_ring_async_base.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/simple_ring_async_base.md ;
# doc/05_design/simple_ring_async_base.md

# Resource Reservation Sum Analysis — Pass C. Reserve data is provided
# externally by the fixtures; no attribute parsing is exercised.

use compiler.desugar.reservation_analysis.{
    ResourceLeaf,
    TaskReservation,
    ReservationDemand,
    ReservationDiagnostic,
    ReservationVerifyResult,
    get_task_reserve,
    compute_demand,
    verify_reservations,
    format_demand,
    format_reservation_result
}
use compiler.desugar.spawn_analysis.{
    SpawnAnalysis,
    TaskInfo,
    TaskGroupInfo
}
use std.spec.{step}

# ================================================================
# Test Helpers
# ================================================================

fn make_leaf(path: text, unit_type: text, cap: i64) -> ResourceLeaf:
    ResourceLeaf(path: path, unit_name: unit_type, cap: cap)

fn make_reservation(name: text, paths: [text], counts: [i64], inst: i64) -> TaskReservation:
    TaskReservation(
        task_name: name,
        reserve_paths: paths,
        reserve_counts: counts,
        instances: inst
    )

fn make_empty_reservation(name: text, inst: i64) -> TaskReservation:
    TaskReservation(
        task_name: name,
        reserve_paths: [],
        reserve_counts: [],
        instances: inst
    )

# ================================================================
# Tests: get_task_reserve lookup
# ================================================================

describe "get_task_reserve lookup":
    # @manual_section: reservation reserve lookup
    it "returns count for existing path":
        # @req REQ-COMPILER-ASYNC-RES-001
        # @capture(bit_table): per-path reserve counts resolved from the fixture task
        step("Look up each reserved path on a two-path fixture task")
        val task = make_reservation("uart_rx", ["NetRes.pkt_pool", "NetRes.rxq.entries"], [2, 1], 1)
        expect(get_task_reserve(task, "NetRes.pkt_pool")).to_equal(2)  # oracle: the fixture reserves exactly 2 units of pkt_pool, the authoritative per-path count
        expect(get_task_reserve(task, "NetRes.rxq.entries")).to_equal(1)  # oracle: the fixture reserves exactly 1 unit of rxq.entries

    it "returns zero for missing path":
        # @req REQ-COMPILER-ASYNC-RES-002
        # @capture(bit_table): miss-path lookup verdict
        step("Look up a path the fixture task never reserved")
        val task = make_reservation("uart_rx", ["NetRes.pkt_pool"], [2], 1)
        expect(get_task_reserve(task, "NetRes.stats")).to_equal(0)  # oracle: an unreserved path must contribute zero demand, not error, so lookup misses are silent zeros

    it "returns zero for empty reserves":
        # @req REQ-COMPILER-ASYNC-RES-003
        # @capture(bit_table): empty-reserve lookup verdict
        step("Look up any path on a task with no reservations")
        val task = make_empty_reservation("idle_task", 1)
        expect(get_task_reserve(task, "NetRes.pkt_pool")).to_equal(0)  # oracle: a task with no reserve arrays has nothing to look up, so zero is the contract

# ================================================================
# Tests: Single resource checks
# ================================================================

describe "Single resource demand":
    # @manual_section: reservation single-resource demand
    it "passes when demand within capacity":
        # @req REQ-COMPILER-ASYNC-RES-004
        # @capture(statistics): demand versus capacity for two contributors under cap
        step("Verify two tasks whose weighted demand stays under the leaf capacity")
        val leaf = make_leaf("NetRes.pkt_pool", "PktBuf", 8)
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool"], [1], 2),
            make_reservation("parser", ["NetRes.pkt_pool"], [1], 3)
        ]
        val result = verify_reservations([leaf], tasks)
        expect(result.has_errors).to_equal(false)
        expect(result.passed_checks).to_equal(1)  # oracle: one leaf yields exactly one demand check, and it passes
        expect(result.total_checks).to_equal(1)  # oracle: verification checks one resource per leaf, so a single leaf means a single check
        # demand = 1*2 + 1*3 = 5 <= 8
        expect(result.demands[0].total_demand).to_equal(5)  # oracle: demand is instances-weighted: 1×2 + 1×3 = 5 against cap 8

    it "passes when demand equals capacity":
        # @req REQ-COMPILER-ASYNC-RES-005
        # @capture(statistics): boundary demand exactly at capacity
        step("Verify tasks whose weighted demand lands exactly on the capacity boundary")
        val leaf = make_leaf("NetRes.pkt_pool", "PktBuf", 8)
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool"], [2], 2),
            make_reservation("parser", ["NetRes.pkt_pool"], [2], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        expect(result.has_errors).to_equal(false)
        # demand = 2*2 + 2*2 = 8 == 8
        expect(result.demands[0].total_demand).to_equal(8)  # oracle: boundary arithmetic 2×2 + 2×2 = 8, exactly the cap, which must still pass
        expect(result.demands[0].overflow).to_equal(false)

    it "errors when demand exceeds capacity":
        # @req REQ-COMPILER-ASYNC-RES-006
        # @capture(statistics): overflow demand above capacity
        step("Verify tasks whose weighted demand exceeds the leaf capacity")
        val leaf = make_leaf("NetRes.pkt_pool", "PktBuf", 4)
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool"], [3], 2),
            make_reservation("parser", ["NetRes.pkt_pool"], [1], 1)
        ]
        val result = verify_reservations([leaf], tasks)
        expect(result.has_errors).to_equal(true)
        expect(result.passed_checks).to_equal(0)  # oracle: the only check overflows, so zero checks pass
        # demand = 3*2 + 1*1 = 7 > 4
        expect(result.demands[0].total_demand).to_equal(7)  # oracle: weighted arithmetic 3×2 + 1×1 = 7 against cap 4
        expect(result.demands[0].overflow).to_equal(true)

# ================================================================
# Tests: Multi-resource checks
# ================================================================

describe "Multi-resource checks":
    # @manual_section: reservation multi-resource demand
    it "passes when all resources within capacity":
        # @req REQ-COMPILER-ASYNC-RES-007
        # @capture(statistics): two-resource verdict both under cap
        step("Verify one task reserving two resources, both under cap")
        val leaves = [
            make_leaf("NetRes.pkt_pool", "PktBuf", 8),
            make_leaf("NetRes.rxq.entries", "RxEntry", 8)
        ]
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool", "NetRes.rxq.entries"], [1, 1], 2)
        ]
        val result = verify_reservations(leaves, tasks)
        expect(result.has_errors).to_equal(false)
        expect(result.passed_checks).to_equal(2)  # oracle: two leaves each produce one passing check
        expect(result.total_checks).to_equal(2)  # oracle: two leaves mean exactly two demand checks

    it "errors when one resource overflows":
        # @req REQ-COMPILER-ASYNC-RES-008
        # @capture(statistics): mixed verdict with one overflowing resource
        step("Verify a task whose second resource overflows while the first passes")
        val leaves = [
            make_leaf("NetRes.pkt_pool", "PktBuf", 8),
            make_leaf("NetRes.rxq.waiters", "Waiter", 2)
        ]
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool", "NetRes.rxq.waiters"], [1, 1], 3)
        ]
        val result = verify_reservations(leaves, tasks)
        expect(result.has_errors).to_equal(true)
        # pkt_pool: 1*3=3 <= 8 OK, waiters: 1*3=3 > 2 OVERFLOW
        expect(result.passed_checks).to_equal(1)  # oracle: exactly one of the two resource checks (pkt_pool) stays under cap
        expect(result.demands[0].overflow).to_equal(false)
        expect(result.demands[1].overflow).to_equal(true)

    it "errors when all resources overflow":
        # @req REQ-COMPILER-ASYNC-RES-009
        # @capture(statistics): all-overflow verdict
        step("Verify a task that overflows both of its resources")
        val leaves = [
            make_leaf("pool_a", "A", 2),
            make_leaf("pool_b", "B", 3)
        ]
        val tasks = [
            make_reservation("task1", ["pool_a", "pool_b"], [2, 2], 2)
        ]
        val result = verify_reservations(leaves, tasks)
        expect(result.has_errors).to_equal(true)
        expect(result.passed_checks).to_equal(0)  # oracle: both resources overflow, so no check passes
        # pool_a: 2*2=4 > 2, pool_b: 2*2=4 > 3
        expect(result.demands[0].overflow).to_equal(true)
        expect(result.demands[1].overflow).to_equal(true)

# ================================================================
# Tests: Per-task breakdown
# ================================================================

describe "Per-task breakdown":
    # @manual_section: reservation contributor tracking
    it "tracks contributor names":
        # @req REQ-COMPILER-ASYNC-RES-010
        # @capture(statistics): contributor name order for two reservers
        step("Aggregate demand from two tasks and inspect contributor names in order")
        val leaf = make_leaf("NetRes.pkt_pool", "PktBuf", 100)
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool"], [2], 3),
            make_reservation("parser", ["NetRes.pkt_pool"], [4], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        val demand = result.demands[0]
        expect(demand.contributor_names.len()).to_equal(2)  # oracle: two fixture tasks reserve the pool, so exactly two contributors are tracked
        expect(demand.contributor_names[0]).to_equal("uart_rx")
        expect(demand.contributor_names[1]).to_equal("parser")

    it "tracks contributor amounts":
        # @req REQ-COMPILER-ASYNC-RES-011
        # @capture(statistics): per-contributor weighted amounts and total
        step("Aggregate demand and check each contributor's weighted amount")
        val leaf = make_leaf("NetRes.pkt_pool", "PktBuf", 100)
        val tasks = [
            make_reservation("uart_rx", ["NetRes.pkt_pool"], [2], 3),
            make_reservation("parser", ["NetRes.pkt_pool"], [4], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        val demand = result.demands[0]
        # uart_rx: 2*3=6, parser: 4*2=8
        expect(demand.contributor_amounts[0]).to_equal(6)  # oracle: uart_rx contributes count×instances = 2×3 = 6
        expect(demand.contributor_amounts[1]).to_equal(8)  # oracle: parser contributes count×instances = 4×2 = 8
        expect(demand.total_demand).to_equal(14)  # oracle: the total is the sum of contributor amounts 6 + 8 = 14

# ================================================================
# Tests: Group-aware instances (using exact spawn counts from Pass B)
# ================================================================

describe "Group-aware instances":
    # @manual_section: reservation instance weighting
    it "uses exact spawn counts not declared instances":
        # @req REQ-COMPILER-ASYNC-RES-012
        # @capture(statistics): demand weighted by actual spawn count, not declared max
        step("Verify demand uses the actual spawn instances recorded in the fixture")
        # Task declared with instances=4, but only spawned 2 times
        val leaf = make_leaf("pool", "Unit", 5)
        val tasks = [
            make_reservation("task_a", ["pool"], [2], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        # demand = 2*2 = 4 <= 5 (uses instances=2, not declared max)
        expect(result.has_errors).to_equal(false)
        expect(result.demands[0].total_demand).to_equal(4)  # oracle: weighting must use actual spawn instances 2×2 = 4, not the declared maximum

    it "would overflow with declared instances but not with actual":
        # @req REQ-COMPILER-ASYNC-RES-013
        # @capture(statistics): actual-versus-declared instance weighting verdict
        step("Verify a case that only passes because actual spawns, not declared instances, weight demand")
        # If instances were 4 (declared), demand would be 2*4=8 > 5
        # But actual spawn count is 2, so demand = 2*2=4 <= 5
        val leaf = make_leaf("pool", "Unit", 5)
        val tasks = [
            make_reservation("task_a", ["pool"], [2], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        expect(result.has_errors).to_equal(false)

# ================================================================
# Tests: Zero reserves
# ================================================================

describe "Zero reserves":
    # @manual_section: reservation zero-reserve behavior
    it "task with no reserves contributes nothing":
        # @req REQ-COMPILER-ASYNC-RES-014
        # @capture(statistics): demand with an empty-reserve task alongside a reserver
        step("Verify that an empty-reserve task is excluded from demand and contributors")
        val leaf = make_leaf("pool", "Unit", 4)
        val tasks = [
            make_empty_reservation("idle_task", 3),
            make_reservation("worker", ["pool"], [1], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        # Only worker contributes: 1*2=2
        expect(result.demands[0].total_demand).to_equal(2)  # oracle: only worker contributes 1×2 = 2; the idle task adds nothing
        expect(result.demands[0].contributor_names.len()).to_equal(1)  # oracle: the empty-reserve task must not appear, leaving exactly one contributor
        expect(result.demands[0].contributor_names[0]).to_equal("worker")

    it "resource with no reservers has zero demand":
        # @req REQ-COMPILER-ASYNC-RES-015
        # @capture(statistics): zero-demand verdict for an unreserved resource
        step("Verify an untouched resource reports zero demand with no contributors")
        val leaf = make_leaf("unused_pool", "Unit", 4)
        val tasks = [
            make_reservation("worker", ["other_pool"], [1], 2)
        ]
        val result = verify_reservations([leaf], tasks)
        expect(result.demands[0].total_demand).to_equal(0)  # oracle: no task reserves unused_pool, so its demand is exactly zero
        expect(result.demands[0].overflow).to_equal(false)
        expect(result.demands[0].contributor_names.len()).to_equal(0)  # oracle: zero reservers means the contributor list is empty

# ================================================================
# Tests: Edge cases
# ================================================================

describe "Edge cases":
    # @manual_section: reservation edge cases
    it "handles empty leaves list":
        # @req REQ-COMPILER-ASYNC-RES-016
        # @capture(statistics): verifier verdict over an empty leaf set
        step("Run the verifier with no resources to check")
        val tasks = [
            make_reservation("worker", ["pool"], [1], 2)
        ]
        val result = verify_reservations([], tasks)
        expect(result.has_errors).to_equal(false)
        expect(result.total_checks).to_equal(0)  # oracle: no leaves means no checks can be produced
        expect(result.passed_checks).to_equal(0)  # oracle: with zero checks, zero can have passed
        expect(result.demands.len()).to_equal(0)  # oracle: no leaves also means no per-resource demand rows

    it "handles empty tasks list":
        # @req REQ-COMPILER-ASYNC-RES-017
        # @capture(statistics): verifier verdict over an empty task set
        step("Run the verifier with tasks that reserve nothing")
        val leaves = [make_leaf("pool", "Unit", 4)]
        val result = verify_reservations(leaves, [])
        expect(result.has_errors).to_equal(false)
        expect(result.total_checks).to_equal(1)  # oracle: one leaf still produces its single demand check
        expect(result.passed_checks).to_equal(1)  # oracle: zero demand cannot exceed the cap, so the lone check passes
        expect(result.demands[0].total_demand).to_equal(0)  # oracle: no reserving tasks means zero aggregated demand

# ================================================================
# Tests: Data structure construction
# ================================================================

describe "Data structure construction":
    # @manual_section: reservation data structures
    it "creates ResourceLeaf correctly":
        # @req REQ-COMPILER-ASYNC-RES-018
        # @capture(statistics): ResourceLeaf field round-trip
        step("Construct a ResourceLeaf and read its fields back")
        val leaf = make_leaf("NetRes.pkt_pool", "PktBuf", 8)
        expect(leaf.path).to_equal("NetRes.pkt_pool")
        expect(leaf.unit_name).to_equal("PktBuf")
        expect(leaf.cap).to_equal(8)  # oracle: the fixture capacity 8 is the value every downstream demand comparison in this spec uses

    it "creates TaskReservation correctly":
        # @req REQ-COMPILER-ASYNC-RES-019
        # @capture(statistics): TaskReservation field round-trip
        step("Construct a TaskReservation and read its arrays back")
        val task = make_reservation("uart_rx", ["pool_a", "pool_b"], [2, 3], 4)
        expect(task.task_name).to_equal("uart_rx")
        expect(task.reserve_paths.len()).to_equal(2)  # oracle: the fixture lists two reserved paths
        expect(task.reserve_counts.len()).to_equal(2)  # oracle: reserve_counts is parallel to reserve_paths, so it has the same two entries
        expect(task.instances).to_equal(4)  # oracle: the fixture declares 4 spawn instances for this task
        expect(task.reserve_paths[0]).to_equal("pool_a")
        expect(task.reserve_counts[1]).to_equal(3)  # oracle: the fixture reserves 3 units of the second path pool_b

    it "creates ReservationDemand via compute_demand":
        # @req REQ-COMPILER-ASYNC-RES-020
        # @capture(statistics): compute_demand field round-trip
        step("Compute demand for one resource and read the demand record back")
        val leaf = make_leaf("pool", "Unit", 10)
        val tasks = [make_reservation("t1", ["pool"], [3], 2)]
        val demand = compute_demand(leaf, tasks)
        expect(demand.resource_path).to_equal("pool")
        expect(demand.total_demand).to_equal(6)  # oracle: demand is count×instances = 3×2 = 6
        expect(demand.cap).to_equal(10)  # oracle: the demand record must carry the leaf's capacity 10 unchanged
        expect(demand.overflow).to_equal(false)

# ================================================================
# Tests: Formatting
# ================================================================

describe "Reservation formatting":
    # @manual_section: reservation report formatting
    it "formats passing result":
        # @req REQ-COMPILER-ASYNC-RES-021
        # @capture(protocol_json): operator-facing report for a passing verification
        step("Format a passing verification result for the operator report")
        val leaves = [make_leaf("pool", "Unit", 10)]
        val tasks = [make_reservation("t1", ["pool"], [1], 2)]
        val result = verify_reservations(leaves, tasks)
        val output = format_reservation_result(result)
        expect(output).to_contain("Reservation Verification: pass")
        expect(output).to_contain("1/1 resources OK")
        expect(output).to_contain("pool")

    it "formats failing result with overflow details":
        # @req REQ-COMPILER-ASYNC-RES-022
        # @capture(protocol_json): operator-facing report for an overflowing verification
        step("Format a failing verification result with its overflow details")
        val leaves = [make_leaf("pool", "Unit", 2)]
        val tasks = [make_reservation("t1", ["pool"], [3], 2)]
        val result = verify_reservations(leaves, tasks)
        val output = format_reservation_result(result)
        expect(output).to_contain("Reservation Verification: FAIL")
        expect(output).to_contain("0/1 resources OK")
        expect(output).to_contain("OVERFLOW")
        expect(output).to_contain("reservation overflow")

# ================================================================
# Tests: End-to-end scenario (spec Section 11)
# ================================================================

describe "End-to-end: spec Section 11 NetRes scenario":
    # @manual_section: reservation end-to-end NetRes
    it "validates full NetRes resource set":
        # @req REQ-COMPILER-ASYNC-RES-023
        # @capture(statistics): full NetRes resource-set verification counters
        step("Verify the complete four-resource NetRes set from the async base design")
        # Resources from spec
        val leaves = [
            make_leaf("NetRes.pkt_pool", "PktBuf", 8),
            make_leaf("NetRes.rxq.entries", "RxEntry", 8),
            make_leaf("NetRes.rxq.waiters", "Waiter", 2),
            make_leaf("NetRes.stats", "StatSlot", 64)
        ]

        # Tasks: uart_rx (1 instance), parser (1 instance)
        val tasks = [
            make_reservation(
                "uart_rx",
                ["NetRes.pkt_pool", "NetRes.rxq.entries", "NetRes.rxq.waiters"],
                [1, 1, 1],
                1
            ),
            make_reservation(
                "parser",
                ["NetRes.stats"],
                [4],
                1
            )
        ]

        val result = verify_reservations(leaves, tasks)

        # All should pass:
        # pkt_pool: 1*1=1 <= 8
        # rxq.entries: 1*1=1 <= 8
        # rxq.waiters: 1*1=1 <= 2
        # stats: 4*1=4 <= 64
        expect(result.has_errors).to_equal(false)
        expect(result.total_checks).to_equal(4)  # oracle: four leaves each produce exactly one demand check
        expect(result.passed_checks).to_equal(4)  # oracle: every weighted demand (1, 1, 1, 4) stays under its cap, so all four pass

        # Verify individual demands
        expect(result.demands[0].total_demand).to_equal(1)  # oracle: uart_rx reserves pkt_pool 1×1 = 1
        expect(result.demands[1].total_demand).to_equal(1)  # oracle: uart_rx reserves rxq.entries 1×1 = 1
        expect(result.demands[2].total_demand).to_equal(1)  # oracle: uart_rx reserves rxq.waiters 1×1 = 1
        expect(result.demands[3].total_demand).to_equal(4)  # oracle: parser reserves stats 4×1 = 4

        # Formatting should show pass
        step("Format the full result and require the operator-facing pass summary")
        val output = format_reservation_result(result)
        expect(output).to_contain("pass")
        expect(output).to_contain("4/4 resources OK")
