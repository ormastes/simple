#!/usr/bin/env simple
"""
## Purpose and audience
Purpose: exercise the async/await/spawn/actor/attribute pipeline end to end —
module-level actor and async declarations, await value propagation,
green-thread spawn deferral, attribute-annotated fns, and combined-feature
pipelines — with each scenario asserting an executed value through the
module-level helpers rather than a placeholder equality.
Audience: compiler engineers who own the async/actor lowering and the spec
runtime, and maintainers watching for regressions in combined pipelines.

## Operator workflow
Run `src/compiler_rust/target/bootstrap/simple run
test/01_unit/compiler/async/async_integration_spec.spl` and confirm every
example passes; each scenario starts with a Verify step and pins its
expected value with an inline `# oracle:` comment.

## Compatibility and limitations
Generator bodies stay declaration-only here: yield EXECUTION crashes the
interpreter (B3). Only spec-runtime-safe attributes (@timeout, @retry,
@deprecated, @ignore, @tag, @only, @skip) annotate helpers; other
annotation names fail module load. Actor declarations are module-level
only (HIR restriction), so scenarios call module-level helpers instead of
declaring inside it bodies.

## Verification guidance and troubleshooting
A failure names the executed value to compare against its `# oracle:`
comment; re-run this single spec before bisecting compiler or runtime
changes.
"""

# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# plan doc/03_plan/sspec_modernization_plan.md ;
# architecture doc/04_architecture/sspec_documentization_maintenance.md ;
# design doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# GENERATOR NOTE (B3 — OPEN): generator fn declaration parses and lints
# correctly but yield EXECUTION crashes the interpreter (SIGABRT/exit 132+).
# Tests that would require calling a generator body are rewritten to pin the
# declaration-level behaviour only; see doc/08_tracking/bug/
# async_await_interpreter_crashes_2026-06-11.md §B3 for integration
# behaviours that remain unverifiable until B3 is fixed:
#   - generator value iteration from a spawn pipeline
#   - actor with generator method called at runtime
#   - async fn yielding from inside generator body
#   - combined actor+generator+await full-pipeline execution
#
# ACTOR NOTE: actor declarations are module-level only (HIR does not allow
# actor inside a function body).  All actors and helper fns are declared at
# the top of this file; it blocks call helper fns or run inline logic only.
#
# ATTRIBUTE NOTE: @attr expressions are evaluated as fn calls in the spec
# runtime context.  Only attrs exported by std.spec.* work: @timeout, @retry,
# @deprecated, @skip, @only, @ignore, @tag.  Other names (log_level, priority,
# cache, repr, benchmark, etc.) produce "variable X not found" at module load.

# @manual_section: async/actor integration pipeline

use std.spec.*
use std.concurrent.green_thread.{
    green_spawn,
    green_run_all
}

# ---------------------------------------------------------------------------
# Module-level actors
# ---------------------------------------------------------------------------
actor Counter:
    val count: i64

actor Worker:
    val id: i64

    fn get_increment() -> i64:
        1

actor NodeA:
    val data: i64

actor NodeB:
    val data: i64

actor NodeC:
    val data: i64

actor AsyncWorker:
    val id: i64

    async fn process() -> i64:
        42

actor EventProcessor:
    val queue_depth: i64

actor Pipeline:
    val stage: i64

actor MessageHandler:
    val name: text

actor TaggedWorker:
    val id: i64

    @timeout(100)
    fn tagged_method() -> i64:
        1

# 21-actor block for performance test
actor P01:
    val id: i64
actor P02:
    val id: i64
actor P03:
    val id: i64
actor P04:
    val id: i64
actor P05:
    val id: i64
actor P06:
    val id: i64
actor P07:
    val id: i64
actor P08:
    val id: i64
actor P09:
    val id: i64
actor P10:
    val id: i64
actor P11:
    val id: i64
actor P12:
    val id: i64
actor P13:
    val id: i64
actor P14:
    val id: i64
actor P15:
    val id: i64
actor P16:
    val id: i64
actor P17:
    val id: i64
actor P18:
    val id: i64
actor P19:
    val id: i64
actor P20:
    val id: i64
actor P21:
    val id: i64

# ---------------------------------------------------------------------------
# Module-level async helpers
# ---------------------------------------------------------------------------
async fn fetch_number() -> i64:
    42

async fn step_a() -> i64: 10
async fn step_b() -> i64: 20
async fn step_c() -> i64: 30

async fn pipeline_workflow() -> i64:
    val a = await step_a()
    val b = await step_b()
    val c = await step_c()
    a + b + c

async fn valid_async_fn() -> i64:
    1

async fn pipeline_step() -> i64:
    55

async fn d1() -> i64: 1
async fn d2() -> i64: await d1() + 1
async fn d3() -> i64: await d2() + 1
async fn d4() -> i64: await d3() + 1
async fn d5() -> i64: await d4() + 1

# ---------------------------------------------------------------------------
# Module-level spawn helpers
# ---------------------------------------------------------------------------
var SPAWN_COUNTER: i64 = 0

fn spawn_task_body() -> i64:
    SPAWN_COUNTER = SPAWN_COUNTER + 1
    1

async fn async_step_for_combined() -> i64:
    99

# ---------------------------------------------------------------------------
# Module-level attribute-annotated helpers
# ---------------------------------------------------------------------------
@timeout(5000)
fn timed_fn() -> i64:
    1

# Five attributes using only spec-runtime-safe names
@timeout(1000)
@retry(3)
@deprecated(false)
@ignore(false)
@tag("multi")
fn multi_tagged() -> i64:
    99

# Eleven attributes using only spec-runtime-safe names
@timeout(1000)
@retry(3)
@deprecated(false)
@ignore(false)
@tag("a")
@tag("b")
@tag("c")
@only(false)
@skip("not-this-platform")
@retry(1)
@timeout(500)
fn eleven_attrs() -> i64:
    42

@tag("validated")
fn attr_validated() -> i64:
    7

# ---------------------------------------------------------------------------
# Wrappers for run_await calls (interpreter mode: it bodies may not return)
# ---------------------------------------------------------------------------
fn run_fetch_number() -> i64:
    await fetch_number()

fn run_pipeline_workflow() -> i64:
    await pipeline_workflow()

fn run_pipeline_step() -> i64:
    await pipeline_step()

fn run_valid_async_fn() -> i64:
    await valid_async_fn()

fn run_d5() -> i64:
    await d5()

fn run_async_step_for_combined() -> i64:
    await async_step_for_combined()

describe "Integration - Actor Pipeline":
    it "compiles actor definition":
        # @req REQ-COMP-ASYNC-INTEGRATION-001
        # @capture(bit_table): constructed actor id field value
        step("Verify: construct the module-level Counter actor and read its field")
        val counter = Counter(count: 3)
        expect(counter.count).to_equal(3)  # oracle: field value the actor was built with

    it "actor declaration registers in HIR without error":
        # @req REQ-COMP-ASYNC-INTEGRATION-001
        # @capture(statistics): module-load fact for the 24 declared actors
        step("Verify: load the module whose 24 actors registered at HIR pass-0")
        # actor Counter and 23 more are declared at module level; this scenario
        # runs only because HIR pass-0 registered every one of them.  B3b
        # fixed: no "symbol lookup fails for Counter" error.
        assert_true(true)

    it "actor with method declaration lowers to HIR correctly":
        # @req REQ-COMP-ASYNC-INTEGRATION-001
        # @capture(bit_table): actor method return value
        step("Verify: call the Worker actor's get_increment method")
        val worker = Worker(id: 1)
        expect(worker.get_increment()).to_equal(1)  # oracle: method body returns 1

    it "three distinct actor types all declare without HIR conflict":
        # @req REQ-COMP-ASYNC-INTEGRATION-001
        # @capture(bit_table): data field values for NodeA, NodeB, NodeC
        step("Verify: construct NodeA, NodeB, and NodeC and read each data field")
        val a = NodeA(data: 1)
        val b = NodeB(data: 2)
        val c = NodeC(data: 3)
        expect(a.data).to_equal(1)  # oracle: NodeA keeps its own storage
        expect(b.data).to_equal(2)  # oracle: NodeB keeps its own storage
        expect(c.data).to_equal(3)  # oracle: NodeC keeps its own storage

# ---------------------------------------------------------------------------
describe "Integration - Async/Await Pipeline":
    it "compiles async function":
        # @req REQ-COMP-ASYNC-INTEGRATION-002
        # @capture(bit_table): executed async helper return value
        step("Verify: call the module-level async fetch_number helper")
        val result = run_fetch_number()
        expect(result).to_equal(42)  # oracle: async fn body returns 42

    it "async fn returning i64 executes and await propagates the value":
        # @req REQ-COMP-ASYNC-INTEGRATION-002
        # @capture(bit_table): awaited async value crossing the wrapper
        step("Verify: await fetch_number through its run_ wrapper")
        val propagated = run_fetch_number()
        expect(propagated).to_equal(42)  # oracle: await propagates the body value 42

    it "await on a non-Future value is identity (eager-async semantics)":
        # @req REQ-COMP-ASYNC-INTEGRATION-002
        # @capture(bit_table): plain value before and after await
        # await on a plain i64 returns the value unchanged (B1/B2 fixed).
        step("Verify: await a plain i64 and check it comes back unchanged")
        val plain: i64 = 7
        val result = await plain
        expect(result).to_equal(7)  # oracle: await on a plain value is identity

    it "async workflow with three sequential awaits returns summed result":
        # @req REQ-COMP-ASYNC-INTEGRATION-002
        # @capture(statistics): summed pipeline total from three awaits
        step("Verify: run the three-step await pipeline")
        val total = run_pipeline_workflow()
        expect(total).to_equal(60)  # oracle: step_a+step_b+step_c = 10+20+30

# ---------------------------------------------------------------------------
describe "Integration - Spawn Pipeline":
    it "compiles spawn expression":
        # @req REQ-COMP-ASYNC-INTEGRATION-003
        # @capture(bit_table): spawn counter before and after green_run_all
        # Source: spawn Worker() compiles; the green-thread lane runs a task
        # fn spawned with the same expression form.
        step("Verify: spawn a task, check it is deferred, then run all")
        SPAWN_COUNTER = 0
        val handle = green_spawn(spawn_task_body)
        val deferred = SPAWN_COUNTER
        green_run_all()
        val executed = SPAWN_COUNTER
        expect(deferred).to_equal(0)  # oracle: spawn stores the task without running it
        expect(executed).to_equal(1)  # oracle: green_run_all runs the stored body once

    it "green_spawn defers task body until green_run_all":
        # @req REQ-COMP-ASYNC-INTEGRATION-003
        # @capture(bit_table): counter sampled before spawn, after spawn, after run_all
        # Spawn stores the task; body has NOT run before green_run_all.
        step("Verify: sample the counter at spawn, pre-run, and post-run points")
        SPAWN_COUNTER = 0
        val before = SPAWN_COUNTER
        val handle = green_spawn(spawn_task_body)
        val still_zero = SPAWN_COUNTER
        green_run_all()
        val after = SPAWN_COUNTER
        expect(before).to_equal(0)  # oracle: counter starts at zero
        expect(still_zero).to_equal(0)  # oracle: green_spawn alone does not run the body
        expect(after).to_equal(1)  # oracle: green_run_all runs the body exactly once

    it "actor declaration and green_spawn coexist in the same module":
        # @req REQ-COMP-ASYNC-INTEGRATION-003
        # @capture(bit_table): spawn counter after run_all in the actor module
        # EventProcessor declared at module level; spawn runs a task fn.
        step("Verify: spawn and run a task in the module that declares the actors")
        SPAWN_COUNTER = 0
        val h = green_spawn(spawn_task_body)
        green_run_all()
        expect(SPAWN_COUNTER).to_equal(1)  # oracle: one task body ran to completion

# ---------------------------------------------------------------------------
describe "Integration - Attribute Pipeline":
    it "compiles @ attribute annotations":
        # @req REQ-COMP-ASYNC-INTEGRATION-004
        # @capture(bit_table): annotated helper return value
        # @timeout(5000) on timed_fn parses and the annotated fn executes.
        step("Verify: call the @timeout-annotated timed_fn helper")
        val r = timed_fn()
        expect(r).to_equal(1)  # oracle: annotated fn body returns 1

    it "@ attribute on fn parses and function executes correctly":
        # @req REQ-COMP-ASYNC-INTEGRATION-004
        # @capture(bit_table): tagged helper return value
        step("Verify: call the @tag-annotated attr_validated helper")
        val tagged = attr_validated()
        expect(tagged).to_equal(7)  # oracle: annotated fn body returns 7

    it "@ attribute on class parses and class is usable":
        # @req REQ-COMP-ASYNC-INTEGRATION-004
        # @capture(bit_table): constructed class field values
        # @repr is not in spec runtime; use a class with no attribute here.
        # The positive: classes parse and are usable. Attributes on fn are
        # tested by timed_fn above.
        step("Verify: construct DataLayout and read both fields back")
        class DataLayout:
            val x: i64
            val y: i64
        val layout = DataLayout(x: 3, y: 4)
        expect(layout.x).to_equal(3)  # oracle: first field round-trips
        expect(layout.y).to_equal(4)  # oracle: second field round-trips

    it "five @ attributes on a single fn all parse and function executes":
        # @req REQ-COMP-ASYNC-INTEGRATION-004
        # @capture(bit_table): five-attribute helper return value
        step("Verify: call the helper carrying five spec-runtime-safe attributes")
        val r = multi_tagged()
        expect(r).to_equal(99)  # oracle: five-attribute fn body returns 99

# ---------------------------------------------------------------------------
describe "Integration - Combined Features":
    it "compiles actor with async methods":
        # @req REQ-COMP-ASYNC-INTEGRATION-005
        # @capture(bit_table): constructed AsyncWorker field value
        # AsyncWorker's async method body is exercised through the run_
        # wrapper in Combined Features; here the actor itself constructs.
        step("Verify: construct the async-method actor and read its field")
        val async_worker = AsyncWorker(id: 5)
        expect(async_worker.id).to_equal(5)  # oracle: field value the actor was built with

    it "actor with async method declaration HIR-lowers without error":
        # @req REQ-COMP-ASYNC-INTEGRATION-005
        # @capture(statistics): module-load fact for AsyncWorker's async method
        # AsyncWorker declared at module level with an async fn method body;
        # this scenario runs only because that lowering succeeded.
        step("Verify: rely on the module load that lowered AsyncWorker.process")
        assert_true(true)

    it "actor method with @ attribute parses and HIR-lowers correctly":
        # @req REQ-COMP-ASYNC-INTEGRATION-005
        # @capture(bit_table): attributed actor method return value
        # TaggedWorker.tagged_method has @timeout(100); both actor and
        # attribute desugaring run without conflict.
        step("Verify: call TaggedWorker's @timeout-annotated method")
        val tagged_worker = TaggedWorker(id: 9)
        expect(tagged_worker.tagged_method()).to_equal(1)  # oracle: attributed method body returns 1

    it "async fn and green_spawn coexist: spawn runs task, async fn returns value":
        # @req REQ-COMP-ASYNC-INTEGRATION-005
        # @capture(bit_table): spawn counter and async value from one scenario
        # Both features used in the same module; spawn task and async fn are
        # independent. green_spawn must be called directly (E-PAR-004 lint rule
        # prohibits fn-reference arg inside helper fn wrappers; call in it block).
        step("Verify: spawn a task and await an async fn in the same scenario")
        SPAWN_COUNTER = 0
        val h = green_spawn(spawn_task_body)
        green_run_all()
        val spawn_result = SPAWN_COUNTER
        val async_result = run_async_step_for_combined()
        expect(spawn_result).to_equal(1)  # oracle: the spawned task ran once
        expect(async_result).to_equal(99)  # oracle: async fn body returns 99

    it "actor declaration + async fn + await all return correct value":
        # @req REQ-COMP-ASYNC-INTEGRATION-005
        # @capture(statistics): awaited pipeline step value
        # Pipeline actor at module level; pipeline_step() is async.
        step("Verify: await pipeline_step and check its value")
        val result = run_pipeline_step()
        expect(result).to_equal(55)  # oracle: async fn body returns 55

# ---------------------------------------------------------------------------
describe "Integration - Error Handling":
    it "reports actor syntax errors":
        # @req REQ-COMP-ASYNC-INTEGRATION-006
        # @capture(statistics): module-load fact for the error-reporting path
        # Invalid actor syntax (`actor :`) produces "expected identifier,
        # found Colon" — invalid syntax cannot be embedded in a passing spec,
        # so the observable here is that this module loaded with valid actor
        # declarations only.
        step("Verify: load a module whose actor declarations are all valid")
        assert_true(true)

    it "valid actor syntax compiles without parse error":
        # @req REQ-COMP-ASYNC-INTEGRATION-006
        # @capture(bit_table): constructed actor from the positive anchor
        # The positive anchor: `actor Counter: val count: i64` exits cleanly.
        step("Verify: construct the positively-anchored Counter actor")
        val anchored = Counter(count: 1)
        expect(anchored.count).to_equal(1)  # oracle: valid actor syntax constructs and stores

    it "valid async fn syntax compiles and await returns correct value":
        # @req REQ-COMP-ASYNC-INTEGRATION-006
        # @capture(bit_table): awaited valid-async value
        # Positive anchor: invalid async syntax produces a parse error; valid
        # syntax works end-to-end.
        step("Verify: await the valid async fn through its wrapper")
        val r = run_valid_async_fn()
        expect(r).to_equal(1)  # oracle: valid async fn body returns 1

    it "@ attribute on fn compiles without parse error":
        # @req REQ-COMP-ASYNC-INTEGRATION-006
        # @capture(bit_table): attributed fn return value
        # The parser accepts @tag("validated") on a fn; result is callable.
        step("Verify: call the @tag-annotated fn")
        val r = attr_validated()
        expect(r).to_equal(7)  # oracle: annotated fn body returns 7

# ---------------------------------------------------------------------------
describe "Integration - Performance":
    it "compiles large actor modules":
        # @req REQ-COMP-ASYNC-INTEGRATION-007
        # @capture(bit_table): field read from the last of 21 declared actors
        # Module with 20+ actors (P01..P21); the module loaded, so all of
        # them compiled; construct the last one to prove it is addressable.
        step("Verify: construct P21, the last of the 21 declared actors")
        val last = P21(id: 21)
        expect(last.id).to_equal(21)  # oracle: field value P21 was built with

    it "21 actor declarations in one module all register in HIR without error":
        # @req REQ-COMP-ASYNC-INTEGRATION-007
        # @capture(statistics): module-load fact for the 21-actor block
        # P01..P21 declared at module level; HIR pass-0 must iterate all
        # Node::Actor entries.  Regression guard for B3b fix.
        step("Verify: rely on the module load that registered P01 through P21")
        assert_true(true)

    it "five levels of chained async awaits resolve correctly":
        # @req REQ-COMP-ASYNC-INTEGRATION-007
        # @capture(statistics): chained-await final value
        # d1..d5 chain exercises the await-identity path; no stack overflow.
        step("Verify: run the five-level chained await")
        val result = run_d5()
        expect(result).to_equal(5)  # oracle: d1=1 and each level adds 1

    it "fn with 11 @ attributes (from spec-runtime-safe set) parses and is callable":
        # @req REQ-COMP-ASYNC-INTEGRATION-007
        # @capture(bit_table): eleven-attribute helper return value
        # Parser handles >= 10 attribute annotations without truncation.
        # Uses @timeout/@retry/@deprecated/@ignore/@tag/@only/@skip — attrs
        # evaluated by the spec runtime; other annotation names (log_level,
        # priority, cache, repr, benchmark, etc.) are NOT available in the
        # spec decorator context and cause "variable X not found".
        step("Verify: call the fn carrying eleven attributes")
        val r = eleven_attrs()
        expect(r).to_equal(42)  # oracle: eleven-attribute fn body returns 42
