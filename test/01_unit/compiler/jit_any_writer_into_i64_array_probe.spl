fn set_any(a: [any], i: i64, v: any):
    a[i] = v

fn push_any(a: [any], v: any):
    a.push(v)

fn main():
    var xs: [i64] = [0, 0, 0, 0]
    xs[0] = 5
    xs[1] = 6
    xs[2] = -6
    set_any(xs, 3, nil)
    push_any(xs, 1.5)
    push_any(xs, "hi")
    print("len={xs.len()}")
    print("x3={xs[3]}")
    print("x4={xs[4]}")
    print("x5={xs[5]}")
    print("x0={xs[0]}")
main()
