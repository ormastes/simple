# Regression test: module-level `@repr("C")` struct global field reads must
# return the FIELD ASKED FOR, not always field index 0.
#
# Root cause (2026-08-06/07): `try_lower_global_read` (MIR lowering,
# src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl) creates a fresh MIR
# local for a `LoadGlobal` of a module-level `var` struct without registering
# it in `struct_value_syms`. Every OTHER struct-value-producing site in MIR
# lowering does register this map (mir_lowering_stmts.spl:291,
# method_calls_literals.spl:537, expr_dispatch.spl:1315, etc). Without it,
# `resolve_field_index` (function_lowering.spl:1028) falls through its
# name-keyed lookup, then its HIR-type-annotation lookup, and — if neither
# resolves the global's struct type — silently returns the hardcoded `0`
# fallback (function_lowering.spl:1070) for EVERY field access on that
# global, regardless of which field was actually requested. Confirmed on the
# aarch64 cranelift backend: reading any field of a global `@repr("C")`
# Limine boot-request struct returned the struct's first word (a magic
# constant) instead of the requested field. See
# doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md
# (2026-08-07 root-cause entry).
#
# CAVEAT (verified, not just asserted): `bin/simple test` runs the tree-walk
# interpreter, which never reaches MIR lowering / `resolve_field_index` /
# `try_lower_global_read` / Cranelift `GetField` at all. Confirmed with
# `SIMPLE_MIR_FIELD_TRACE=1 bin/simple run <probe>` (a different engine,
# reaches the Cranelift JIT): this spec's assertions pass IDENTICALLY whether
# the `struct_value_syms` registration fix in `try_lower_global_read`
# (expr_dispatch.spl) is present or reverted. It therefore does NOT gate or
# discriminate the aarch64 field-misread defect this fix targets — it is a
# documentation-style regression spec for the surface field-read contract
# only. See the 2026-08-07 root-cause entry in
# doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md
# for the executed discriminating test and the surviving candidate causes
# (Cranelift `GetField`'s uniform 8-byte field stride and unconditional
# tag-strip mask). Real verification of THIS defect needs an aarch64 native
# build, currently blocked by an unrelated in-flight regression in this
# checkout.
#
# @tag: compiler,regression,global,repr_c,struct
# @req: REQ-COMP-MODULE-LEVEL-REPR-C-STRUCT-GLOBAL-FIELD-001 — stable requirement identity for this spec.
"""
## Purpose and audience
Purpose: Prove that module-level @repr(\"C\") struct global field reads.
Audience: COMP maintainers who read this spec to confirm the behavior still holds.
"""


@repr("C")
struct BootRequest:
    magic: u64
    id: u64
    revision: u64
    response: u64

var g_boot_request: BootRequest = BootRequest(magic: 0xC7B1DD30, id: 42, revision: 3, response: 0)

fn read_magic() -> u64:
    g_boot_request.magic

fn read_id() -> u64:
    g_boot_request.id

fn read_revision() -> u64:
    g_boot_request.revision

fn read_response() -> u64:
    g_boot_request.response

use std.spec.step
describe "module-level @repr(\"C\") struct global field reads":
    it "reads field 0 (magic) correctly":
        step("Verify: reads field 0 (magic) correctly")
        # @req: REQ-COMP-MODULE-LEVEL-REPR-C-STRUCT-GLOBAL-FIELD-001
        expect(read_magic()).to_equal(0xC7B1DD30)

    it "reads a non-zero-index field (id) as its OWN value, not the magic":
        step("Verify: reads a non-zero-index field (id) as its OWN value, not the magic")
        expect(read_id()).to_equal(42)

    it "reads a further field (revision) as its OWN value":
        step("Verify: reads a further field (revision) as its OWN value")
        expect(read_revision()).to_equal(3)

    it "reads the last field (response) as its OWN value":
        step("Verify: reads the last field (response) as its OWN value")
        expect(read_response()).to_equal(0)

    it "direct field access (no wrapper fn) also resolves by name":
        step("Verify: direct field access (no wrapper fn) also resolves by name")
        expect(g_boot_request.id).to_equal(42)
        expect(g_boot_request.revision).to_equal(3)
