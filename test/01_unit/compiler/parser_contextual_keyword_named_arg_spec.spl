"""
# Parser: contextual keywords are ordinary names in named-argument position

**Category:** Syntax / Seed parser keyword hygiene
**Bug:** doc/08_tracking/bug/examples_identifier_rejected_in_named_argument_position_2026-08-10.md

## Overview

`examples` is lexed as a dedicated soft-keyword token (`TokenKind::Examples`,
for the Gherkin `examples name:` data-table block). The named-argument parser
accepted many keyword tokens as argument labels but not this one, so
`K(examples: "ok")` failed with "expected Comma, found Colon" even though the
field *declared* and *read* fine.

A parse error means this file will not load, so the constructions below are
themselves the grammar coverage; the `it` blocks assert the values round-trip.
The generalization probes exercise other contextual keywords in the same
named-arg position (`feature`, `scenario`, `given`, `when`, `then`, `context`,
`grid`) plus spec-DSL names that are plain identifiers (`describe`, `it`).

## Syntax

```simple
val k = K(examples: "ok")     # keyword token as a named-arg label
print(k.examples)
```
"""

use std.spec

struct K:
    examples: text

struct Gherkinish:
    feature: text
    scenario: text
    given: text
    when: text
    then: text

struct SpecNames:
    describe: text
    it: text
    context: text

struct GridBox:
    grid: i64

# `and_then` is the second half of the 2026-08-10 family census: the census
# probed every identifier in the same lexer keyword block and found exactly
# two broken in named-arg position, `examples` and `and_then`.
struct Chained:
    and_then: text

# `generator` is an ordinary name, but the interpreter has a lambda-based
# `generator(fn)` builtin. A user-defined `fn generator(...)` — such as
# `src/lib/nogc_async_mut/generator.spl`'s state-machine constructor — must
# shadow it, or every call through the stdlib module fails with
# "semantic: generator expects a lambda".
# Bug: doc/08_tracking/bug/generator_identifier_collides_with_builtin_construct_name_2026-08-11.md
fn generator(initial, step_fn):
    return initial

fn generator_caller(start, end_val):
    return generator(start, fn(n): (n + 1, n < end_val))

describe("contextual keywords as named-argument labels"):
    it("accepts `examples` as a named argument and reads it back"):
        val k = K(examples: "ok")
        assert_equal(k.examples, "ok")

    it("accepts gherkin soft keywords as named arguments"):
        val g = Gherkinish(feature: "f", scenario: "s", given: "g", when: "w", then: "t")
        assert_equal(g.feature, "f")
        assert_equal(g.scenario, "s")
        assert_equal(g.given, "g")
        assert_equal(g.when, "w")
        assert_equal(g.then, "t")

    it("accepts spec DSL names describe/it/context as named arguments"):
        val s = SpecNames(describe: "d", it: "i", context: "c")
        assert_equal(s.describe, "d")
        assert_equal(s.it, "i")
        assert_equal(s.context, "c")

    it("accepts `grid` as a named argument"):
        val b = GridBox(grid: 7)
        assert_equal(b.grid, 7)

    it("accepts `and_then` as a named argument and reads it back"):
        val c = Chained(and_then: "ok")
        assert_equal(c.and_then, "ok")

describe("builtin names are shadowable by ordinary bindings"):
    it("lets a user-defined `fn generator` shadow the lambda builtin"):
        assert_equal(generator(5, fn(n): (n + 1, true)), 5)

    it("resolves `generator` from another function in the same module"):
        assert_equal(generator_caller(0, 3), 0)

    it("accepts `generator` as a local binding name"):
        val generator = 7
        assert_equal(generator, 7)
