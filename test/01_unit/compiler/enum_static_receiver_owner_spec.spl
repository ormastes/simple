# bug: enum_static_receiver_owner_erasure_2026_10_11
use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.static_enum_receiver_owner.*

fn enum_static_lower(source: text) -> MirLowering:
    val filename = "enum_static_probe.spl"
    val parsed = parse_full_frontend(source, filename, "enum_static_probe", Logger(level: 0))
    var hir_owner = HirLowering.with_filename(filename)
    val hir = hir_owner.lower_module(parsed)
    expect(hir_owner.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(mir.functions.len()).to_be_greater_than(0)
    lowering

fn enum_static_fixture() -> MirLowering:
    enum_static_lower("enum DbType:\n    Integer\n    Real\n    Text\n\nenum DbValue:\n    Integer(value: i64)\n    Real(value: f64)\n    Text(value: text)\n\nfn probe() -> i64:\n    0\n")

fn enum_static_receiver(lowering: MirLowering, name: text) -> HirExpr:
    HirExpr(kind: HirExprKind.NamedVar(lowering.symbols.lookup_or_invalid(name), name),
        has_type_: false, type_: nil, span: Span.empty())

fn enum_static_text_arg(value: text) -> HirCallArg:
    HirCallArg(has_name: true, name: "value", value: HirExpr(
        kind: HirExprKind.StringLit(value, false), has_type_: true,
        type_: HirType(kind: HirTypeKind.Str, span: Span.empty()), span: Span.empty()), span: Span.empty())

fn enum_static_has_integer_constant(lowering: MirLowering, from_index: i64, expected: i64) -> bool:
    var index = from_index
    while index < lowering.builder.instructions.len():
        match lowering.builder.instructions[index].kind:
            case MirInstKind.Const(_, value, _):
                match value:
                    case MirConstValue.Int(number):
                        if number == expected: return true
                    case _: ()
            case _: ()
        index = index + 1
    false

# Select native backends through the runner, not an unsupported describe tag.
describe "declared enum static receiver authority":
    it "retains the enum owner inside its own static method with a colliding Float variant":
        val lowering = enum_static_lower("enum Decoy:\n    Float(i64)\n\nenum Value:\n    Float(f64)\n\n    static fn float(f: f64) -> Value:\n        Value.Float(f)\n\nfn probe() -> i64:\n    val value = Value.float(3.25)\n    0\n")
        expect(lowering.errors.len()).to_equal(0)

    it "does not recover a stale enum symbol through a runtime shadow with the same name":
        var lowering = enum_static_fixture()
        val enum_symbol = lowering.symbols.lookup_or_invalid("DbValue")
        val shadow = lowering.symbols.define("DbValue", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, true, nil)
        expect(shadow.id != enum_symbol.id).to_be(true)
        val receiver = HirExpr(kind: HirExprKind.NamedVar(enum_symbol, "DbValue"), has_type_: false, type_: nil, span: Span.empty())
        val before = lowering.builder.instructions.len()
        expect(lowering.try_lower_declared_enum_static_call(receiver, "Text", [enum_static_text_arg("bad")], MethodResolution.Unresolved)).to_be_nil()
        expect(lowering.builder.instructions.len()).to_equal(before)
        expect(lowering.errors.len()).to_equal(0)

    it "lowers real source constructors despite shared Integer Real and Text leaves":
        val lowering = enum_static_lower("enum DbType:\n    Integer\n    Real\n    Text\n\nenum DbValue:\n    Integer(value: i64)\n    Real(value: f64)\n    Text(value: text)\n\nfn probe(name: text, number: i64) -> i64:\n    val values: [DbValue] = [DbValue.Text(value: name)]\n    val value = DbValue.Integer(value: 0 - number)\n    values.len()\n")
        expect(lowering.errors.len()).to_equal(0)

    it "consumes the transported MethodCall through actual MIR dispatch and exact owner id":
        var lowering = enum_static_fixture()
        val receiver = enum_static_receiver(lowering, "DbValue")
        val owner = lowering.enum_qualified_key(lowering.symbols.lookup_or_invalid("DbValue"))
        expect(owner != "").to_be(true)
        val decoy = lowering.enum_qualified_key(lowering.symbols.lookup_or_invalid("DbType"))
        val before = lowering.builder.instructions.len()
        val call = HirExpr(kind: HirExprKind.MethodCall(receiver, "Text", [enum_static_text_arg("kept")], MethodResolution.Unresolved),
            has_type_: false, type_: nil, span: Span.empty())
        val result = lowering.lower_expr(call)
        expect(lowering.errors.len()).to_equal(0)
        expect(enum_static_has_integer_constant(lowering, before, lowering.enum_runtime_id(owner))).to_be(true)
        expect(enum_static_has_integer_constant(lowering, before, lowering.enum_runtime_id(decoy))).to_be(false)

    it "rejects inconsistent exact provider metadata without using the bare decoy":
        var lowering = enum_static_fixture()
        val receiver = enum_static_receiver(lowering, "DbValue")
        val owner = lowering.enum_qualified_key(lowering.symbols.lookup_or_invalid("DbValue"))
        lowering.enum_variant_index_q.remove(owner)
        val result = lowering.try_lower_declared_enum_static_call(receiver, "Text", [enum_static_text_arg("bad")], MethodResolution.Unresolved)
        expect(result != nil).to_be(true)
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].fatal).to_be(true)
        expect(lowering.errors[0].message).to_contain("lacks exact provider registry")

    it "does not intercept resolved enum associated methods":
        var lowering = enum_static_fixture()
        val receiver = enum_static_receiver(lowering, "DbValue")
        val symbol = lowering.symbols.lookup_or_invalid("DbValue")
        val before = lowering.builder.instructions.len()
        val result = lowering.try_lower_declared_enum_static_call(receiver, "factory", [], MethodResolution.StaticMethod(symbol, SymbolId(id: 900)))
        expect(result).to_be_nil()
        expect(lowering.builder.instructions.len()).to_equal(before)
        expect(lowering.errors.len()).to_equal(0)

    it "retains normal associated method dispatch through real frontend and MIR":
        val lowering = enum_static_lower("enum DbValue:\n    Text(value: text)\n    static fn factory() -> i64:\n        69\n\nfn probe() -> i64:\n    DbValue.factory()\n")
        expect(lowering.errors.len()).to_equal(0)

    it "does not use a bare homonym when all exact variant metadata is absent":
        var lowering = enum_static_fixture()
        val receiver = enum_static_receiver(lowering, "DbValue")
        val owner = lowering.enum_qualified_key(lowering.symbols.lookup_or_invalid("DbValue"))
        lowering.enum_variant_index_q.remove(owner)
        for variant in ["Integer", "Real", "Text"]:
            lowering.enum_variant_payload_kind.remove(owner + "::" + variant)
            lowering.enum_variant_payload_types.remove(owner + "::" + variant)
            lowering.enum_variant_payload_names.remove(owner + "::" + variant)
        val before = lowering.builder.instructions.len()
        val result = lowering.try_lower_declared_enum_static_call(receiver, "Text", [enum_static_text_arg("bad")], MethodResolution.Unresolved)
        expect(result != nil).to_be(true)
        expect(lowering.errors.len()).to_be_greater_than(0)
        expect(enum_static_has_integer_constant(lowering, before, lowering.enum_runtime_id(owner))).to_be(false)

    it "does not reinterpret a runtime variable shadowing DbValue as an enum":
        var lowering = enum_static_fixture()
        val variable = lowering.symbols.define("DbValue", SymbolKind.Variable, nil, Span.empty(), Visibility.Private, true, nil)
        val receiver = HirExpr(kind: HirExprKind.NamedVar(variable, "DbValue"), has_type_: false, type_: nil, span: Span.empty())
        val before = lowering.builder.instructions.len()
        expect(lowering.try_lower_declared_enum_static_call(receiver, "Text", [enum_static_text_arg("bad")], MethodResolution.Unresolved)).to_be_nil()
        expect(lowering.builder.instructions.len()).to_equal(before)
        expect(lowering.errors.len()).to_equal(0)

    it "rejects a conflicting numeric identity instead of reinterpreting it in another scope":
        var lowering = enum_static_fixture()
        val wrong = lowering.symbols.lookup_or_invalid("DbType")
        val receiver = HirExpr(kind: HirExprKind.NamedVar(wrong, "DbValue"), has_type_: false, type_: nil, span: Span.empty())
        expect(lowering.try_lower_declared_enum_static_call(receiver, "Text", [enum_static_text_arg("bad")], MethodResolution.Unresolved)).to_be_nil()
        expect(lowering.errors.len()).to_equal(0)

    it "retains declared payload validation for a wrong constructor argument":
        var lowering = enum_static_fixture()
        val receiver = enum_static_receiver(lowering, "DbValue")
        val result = lowering.try_lower_declared_enum_static_call(receiver, "Integer", [enum_static_text_arg("wrong")], MethodResolution.Unresolved)
        expect(result != nil).to_be(true)
        expect(lowering.errors.len()).to_equal(1)
        expect(lowering.errors[0].fatal).to_be(true)
        expect(lowering.errors[0].message).to_contain("payload type mismatch")
