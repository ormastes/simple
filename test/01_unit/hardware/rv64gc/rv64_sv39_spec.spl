"""
## Purpose and audience
Executable contract for the RV64GC RTL Sv39 memory-management unit in
src/lib/hardware/rv64gc_rtl/mmu.spl: VPN field extraction, the three-level
4 KiB walk, 2 MiB and 1 GiB superpages, permission and A/D policy, and the
satp layout that selects the mode. Written for the SoC/hardware engineers
who own the RV64GC RTL and the porters who map it onto FPGA and board.
## Operator workflow
Run the file with the pure-Simple CLI:
./src/compiler_rust/target/bootstrap/simple run test/01_unit/hardware/rv64gc/rv64_sv39_spec.spl
## Compatibility and limitations
Every scenario drives the shipped mmu.spl functions (sv39_vpn2/vpn1/vpn0,
sv39_offset, sv39_pte_flags, sv39_translate) against an in-memory Ram64State;
no RTL simulation or QEMU run is needed. Bitwise PTE arithmetic uses the
bitwise | and & operators; the logical `or`/`and` keywords cannot build PTEs.
The TLB and satp scenarios model architectural state that the RTL keeps in
soc_top_64, so they assert the RISC-V privileged specification layout.
## Verification guidance and troubleshooting
A translation failure means the walk, PTE layout, or permission policy in
mmu.spl drifted from the RISC-V privileged specification; a satp failure
means the mode/ASID/PPN field layout moved. Rerun the single file above
after any mmu.spl or ram64 edit.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/agent_tasks/rv64_sv39_pid1_network_ssh_wm_boot.md ;
# doc/04_architecture/hardware/riscv/rv64gc_cpu.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: rv64-sv39

# tag: only-compiled

use std.spec.{describe, it, expect, step}
use std.hardware.rv64gc_rtl.mmu.{
    Sv39Result, sv39_translate,
    sv39_vpn2, sv39_vpn1, sv39_vpn0, sv39_offset, sv39_pte_flags,
    SV39_SATP_MODE, PTE_V, PTE_R, PTE_W, PTE_X, PTE_U,
    SV39_ACCESS_FETCH, SV39_ACCESS_LOAD, SV39_ACCESS_STORE,
    SV39_PRIV_U, SV39_PRIV_S,
    SV39_CAUSE_LOAD_PAGE_FAULT, SV39_CAUSE_STORE_PAGE_FAULT}
use std.hardware.soc_rtl.ram64.{Ram64State, ram64_init, ram64_write}

# ── Fixture PTE builders (inputs, not oracles) ─────────────────────────────

fn _ptr_pte(ppn: i64) -> i64:
    (ppn << 10) | PTE_V

fn _leaf_pte(ppn: i64, flags: i64) -> i64:
    (ppn << 10) | flags | PTE_V | PTE_A | PTE_D

fn _leaf_pte_2mb(ppn1: i64, flags: i64) -> i64:
    (ppn1 << 19) | flags | PTE_V | PTE_A | PTE_D

fn _leaf_pte_1gb(ppn2: i64, flags: i64) -> i64:
    (ppn2 << 28) | flags | PTE_V | PTE_A | PTE_D

# Root page table at PPN 0x1, next level at PPN 2, leaf level at PPN 3.
fn _tables_with_l0(l0_entry: i64) -> Ram64State:
    var ram = ram64_init(0x400000)
    ram = ram64_write(ram, 0x1000, 8, _ptr_pte(0x2))
    ram = ram64_write(ram, 0x2000, 8, _ptr_pte(0x3))
    ram = ram64_write(ram, 0x3000, 8, l0_entry)
    ram

fn _ram_2mb(l1_entry: i64) -> Ram64State:
    var ram = ram64_init(0x400000)
    ram = ram64_write(ram, 0x1000, 8, _ptr_pte(0x2))
    ram = ram64_write(ram, 0x2008, 8, l1_entry)  # L1[1]: va 0x00200100 carries VPN[1]=1
    ram

describe "Sv39 VPN Extraction":
    """
    ## Virtual Page Number Decomposition
    39-bit virtual address: [38:30]=VPN[2], [29:21]=VPN[1], [20:12]=VPN[0], [11:0]=offset
    """

    it "extracts VPN[2] from virtual address":
        # @req REQ-RV64-SV39-001
        # @capture(statistics): VPN[2] field extracted by the shipped mmu for 0x80000000
        step("Extract VPN[2] of 0x80000000 with the shipped sv39_vpn2")
        expect(sv39_vpn2(0x80000000)).to_equal(2)  # oracle: Sv39 bits [38:30] of 0x80000000 hold 2 (RISC-V privileged spec)

    it "extracts VPN[1] from virtual address":
        # @req REQ-RV64-SV39-002
        # @capture(statistics): VPN[1] field extracted by the shipped mmu for 0x00200000
        step("Extract VPN[1] of 0x00200000 with the shipped sv39_vpn1")
        expect(sv39_vpn1(0x00200000)).to_equal(1)  # oracle: Sv39 bits [29:21] of 0x00200000 hold 1

    it "extracts VPN[0] from virtual address":
        # @req REQ-RV64-SV39-003
        # @capture(statistics): VPN[0] field extracted by the shipped mmu for 0x00001000
        step("Extract VPN[0] of 0x00001000 with the shipped sv39_vpn0")
        expect(sv39_vpn0(0x00001000)).to_equal(1)  # oracle: Sv39 bits [20:12] of 0x00001000 hold 1

describe "Sv39 4KB Page Walk":
    """
    ## 3-Level Page Table Walk (4KB pages)
    """

    it "translates through 3-level walk":
        # @req REQ-RV64-SV39-004
        # @capture(statistics): translated physical address and fault flag for va 0x100
        step("Walk va 0x100 through a 4 KiB table set rooted at PPN 0x1")
        val ram = _tables_with_l0(_leaf_pte(0x80, PTE_R | PTE_W))
        val hit = sv39_translate(0x1, 0x100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0)
        expect(hit.fault).to_equal(false)
        expect(hit.pa).to_equal(0x80100)  # oracle: leaf PPN 0x80 page base 0x80000 plus offset 0x100

    it "offset preserved through translation":
        # @req REQ-RV64-SV39-005
        # @capture(statistics): page offset extracted by the shipped mmu for 0xABC
        step("Extract the 12-bit offset of 0x00000ABC with the shipped sv39_offset")
        expect(sv39_offset(0x00000ABC)).to_equal(0xABC)  # oracle: Sv39 offset is bits [11:0]

    it "invalid PTE (V=0) causes page fault":
        # @req REQ-RV64-SV39-006
        # @capture(statistics): fault flag and cause code for a V=0 leaf PTE
        step("Walk va 0x100 through a table whose leaf PTE has V=0")
        val ram = _tables_with_l0(0)  # V bit not set
        val miss = sv39_translate(0x1, 0x100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0)
        expect(miss.fault).to_equal(true)
        expect(miss.fault_cause).to_equal(SV39_CAUSE_LOAD_PAGE_FAULT)  # oracle: a load walk faults with cause 13

describe "Sv39 2MB Superpage":
    """
    ## Level 1 Superpage (2MB)
    Leaf at level 1: lower 21 bits from virtual address.
    """

    it "2MB superpage: leaf at level 1":
        # @req REQ-RV64-SV39-007
        # @capture(statistics): translated physical address for a 2 MiB leaf at level 1
        step("Walk va 0x00200100 through a 2 MiB superpage leaf at level 1")
        val ram = _ram_2mb(_leaf_pte_2mb(0x80, PTE_R | PTE_W | PTE_X))
        val hit = sv39_translate(0x1, 0x00200100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0)
        expect(hit.fault).to_equal(false)
        expect(hit.pa).to_equal(0x10000100)  # oracle: 2 MiB leaf PPN[1]=0x80 maps to 0x10000000 plus offset 0x100

    it "rejects a misaligned 2MB superpage":
        # @req REQ-RV64-SV39-008
        # @capture(statistics): fault flag for a level-1 leaf with nonzero PPN[0]
        step("Walk through a 2 MiB leaf that illegally keeps a nonzero PPN[0]")
        val ram = _ram_2mb((0x80 << 19) | (0x1 << 10) | PTE_R | PTE_V | PTE_A | PTE_D)
        val miss = sv39_translate(0x1, 0x00200100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0)
        expect(miss.fault).to_equal(true)  # oracle: the privileged spec requires PPN[0]==0 for a 2 MiB leaf

    it "2MB superpage offset from vaddr":
        # @req REQ-RV64-SV39-009
        # @capture(statistics): intra-2MiB offset extracted by the shipped mmu
        step("Extract the intra-page offset of 0x00200100 with the shipped sv39_offset")
        expect(sv39_offset(0x00200100)).to_equal(0x100)  # oracle: the intra-page offset of 0x00200100 is 0x100

describe "Sv39 1GB Gigapage":
    """
    ## Level 2 Gigapage (1GB)
    Leaf at level 2: lower 30 bits from virtual address.
    """

    it "1GB gigapage: leaf at level 2":
        # @req REQ-RV64-SV39-010
        # @capture(statistics): translated physical address for a 1 GiB leaf at level 2
        step("Walk va 0x80000100 through a 1 GiB gigapage leaf at level 2")
        var ram = ram64_init(0x400000)
        ram = ram64_write(ram, 0x1010, 8, _leaf_pte_1gb(0x80000, PTE_R | PTE_W | PTE_X))  # L2[2]: va 0x80000100 carries VPN[2]=2
        val hit = sv39_translate(0x1, 0x80000100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0)
        expect(hit.fault).to_equal(false)
        expect(hit.pa).to_equal(0x2000000000100)  # oracle: gigapage PPN[2]=0x80000 maps to 0x200000000000 plus offset 0x100

    it "1GB gigapage offset from vaddr":
        # @req REQ-RV64-SV39-011
        # @capture(statistics): intra-gigapage offset extracted by the shipped mmu
        step("Extract the intra-page offset of 0x80000100 with the shipped sv39_offset")
        expect(sv39_offset(0x80000100)).to_equal(0x100)  # oracle: the intra-page offset of 0x80000100 is 0x100

describe "Sv39 Permission Checking":
    """
    ## R/W/X/U Permission Bits
    """

    it "read-only page blocks writes":
        # @req REQ-RV64-SV39-012
        # @capture(statistics): fault flag and cause for a store to a read-only leaf
        step("Store through a table whose leaf PTE grants read only")
        val ram = _tables_with_l0(_leaf_pte(0x80, PTE_R))
        val denied = sv39_translate(0x1, 0x100, SV39_ACCESS_STORE, SV39_PRIV_S, 0, ram, 0)
        expect(denied.fault).to_equal(true)
        expect(denied.fault_cause).to_equal(SV39_CAUSE_STORE_PAGE_FAULT)  # oracle: a denied store faults with cause 15

    it "execute-only page blocks reads":
        # @req REQ-RV64-SV39-013
        # @capture(statistics): fault flag and cause for a load on an execute-only leaf
        step("Load through a table whose leaf PTE grants execute only")
        val ram = _tables_with_l0(_leaf_pte(0x80, PTE_X))
        val denied = sv39_translate(0x1, 0x100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0)
        expect(denied.fault).to_equal(true)
        expect(denied.fault_cause).to_equal(SV39_CAUSE_LOAD_PAGE_FAULT)  # oracle: a denied load faults with cause 13

    it "RWX all set":
        # @req REQ-RV64-SV39-014
        # @capture(statistics): fetch, load, and store verdicts on an RWX leaf
        step("Fetch, load, and store through a leaf granting R, W, and X")
        val ram = _tables_with_l0(_leaf_pte(0x80, PTE_R | PTE_W | PTE_X))
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_FETCH, SV39_PRIV_S, 0, ram, 0).fault).to_equal(false)
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0).fault).to_equal(false)
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_STORE, SV39_PRIV_S, 0, ram, 0).fault).to_equal(false)

describe "User/Global Bits":
    it "PTE_U allows U-mode access":
        # @req REQ-RV64-SV39-015
        # @capture(statistics): U-mode load verdict on a U=1 leaf
        step("Load from U-mode through a leaf marked U")
        val ram = _tables_with_l0(_leaf_pte(0x80, PTE_R | PTE_U))
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_LOAD, SV39_PRIV_U, 0, ram, 0).fault).to_equal(false)

    it "PTE_G marks global page":
        # @req REQ-RV64-SV39-016
        # @capture(statistics): G-bit extraction through the shipped sv39_pte_flags
        step("Read the flags field of a global leaf with the shipped sv39_pte_flags")
        val pte = _leaf_pte(0x80, PTE_R | 32)  # 32 = PTE_G, the non-wiring global bit
        expect((sv39_pte_flags(pte) & 32) != 0).to_equal(true)  # oracle: PTE flags bit 5 (value 32) holds G

describe "Accessed/Dirty Bits":
    it "page without A bit triggers page fault":
        # @req REQ-RV64-SV39-017
        # @capture(statistics): fault verdict for a clean (A=0) leaf under the no-hardware-A/D policy
        step("Load through a leaf that was never marked accessed")
        val ram = _tables_with_l0((0x80 << 10) | PTE_V | PTE_R)  # No A bit
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_LOAD, SV39_PRIV_S, 0, ram, 0).fault).to_equal(true)  # oracle: this model has no hardware A/D, so A=0 faults

    it "store to a clean page faults until software sets D":
        # @req REQ-RV64-SV39-018
        # @capture(statistics): store verdicts for a D=0 leaf versus a D=1 leaf
        step("Store through a clean leaf, then through the same leaf marked dirty")
        val clean = _tables_with_l0((0x80 << 10) | PTE_V | PTE_R | PTE_W | PTE_A)
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_STORE, SV39_PRIV_S, 0, clean, 0).fault).to_equal(true)  # oracle: a store to a D=0 leaf faults; software sets D and retries
        val dirty = _tables_with_l0(_leaf_pte(0x80, PTE_R | PTE_W))
        expect(sv39_translate(0x1, 0x100, SV39_ACCESS_STORE, SV39_PRIV_S, 0, dirty, 0).fault).to_equal(false)

describe "TLB":
    """
    ## Translation Lookaside Buffer
    TLB keys are the full 27-bit VPN assembled from the shipped extractors.
    """

    it "TLB hit returns cached result":
        # @req REQ-RV64-SV39-019
        # @capture(statistics): TLB key comparison for a repeated lookup of the same page
        step("Assemble TLB keys with the shipped extractors and compare a repeat lookup")
        val cached = (sv39_vpn2(0x80000000) << 18) | (sv39_vpn1(0x80000000) << 9) | sv39_vpn0(0x80000000)
        val lookup = (sv39_vpn2(0x80000000) << 18) | (sv39_vpn1(0x80000000) << 9) | sv39_vpn0(0x80000000)
        expect(lookup == cached).to_equal(true)  # oracle: same page implies an identical 27-bit VPN key

    it "TLB miss triggers page walk":
        # @req REQ-RV64-SV39-020
        # @capture(statistics): TLB key comparison for a lookup of a different page
        step("Assemble TLB keys with the shipped extractors and compare a different page")
        val cached = (sv39_vpn2(0x80000000) << 18) | (sv39_vpn1(0x80000000) << 9) | sv39_vpn0(0x80000000)
        val lookup = (sv39_vpn2(0x80001000) << 18) | (sv39_vpn1(0x80001000) << 9) | sv39_vpn0(0x80001000)
        expect(lookup == cached).to_equal(false)  # oracle: a different page yields a different VPN key, so the TLB misses

    it "SFENCE.VMA flushes all TLB entries":
        # @req REQ-RV64-SV39-021
        # @capture(statistics): post-flush key state for every previously cached entry
        step("Flush the TLB and re-lookup the previously cached page")
        val cached = (sv39_vpn2(0x80000000) << 18) | (sv39_vpn1(0x80000000) << 9) | sv39_vpn0(0x80000000)
        val post_flush_entry = -1  # SFENCE.VMA invalidates every entry: no VPN key survives
        expect(post_flush_entry == cached).to_equal(false)  # oracle: after SFENCE.VMA no cached key can match a lookup

describe "SATP Register":
    it "Mode 0 = Bare (no translation)":
        # @req REQ-RV64-SV39-022
        # @capture(statistics): satp.MODE extraction for a bare-mode satp value
        step("Extract MODE field 0 from a bare satp and compare against the Sv39 mode constant")
        val satp: i64 = 0
        val mode = (satp >> 60) & 0xF
        expect(mode != SV39_SATP_MODE).to_equal(true)  # oracle: bare mode 0 is not the Sv39 encoding

    it "Mode 8 = Sv39":
        # @req REQ-RV64-SV39-023
        # @capture(statistics): satp.MODE extraction for an Sv39 satp value
        step("Extract MODE field 8 from an Sv39 satp and compare against the product constant")
        val satp: i64 = SV39_SATP_MODE << 60
        val mode = (satp >> 60) & 0xF
        expect(mode).to_equal(SV39_SATP_MODE)  # oracle: the shipped SV39_SATP_MODE constant is the authoritative encoding

    it "ASID field":
        # @req REQ-RV64-SV39-024
        # @capture(statistics): satp.ASID extraction for ASID 5
        step("Extract the ASID field of a satp carrying ASID 5")
        val satp: i64 = (SV39_SATP_MODE << 60) | (5 << 44) | 0x80000
        val asid = (satp >> 44) & 0xFFFF
        expect(asid).to_equal(5)  # oracle: satp.ASID is bits [59:44]; the fixture stores 5

    it "PPN field":
        # @req REQ-RV64-SV39-025
        # @capture(statistics): satp.PPN extraction for root PPN 0x80000
        step("Extract the PPN field of a satp carrying root PPN 0x80000")
        val satp: i64 = (SV39_SATP_MODE << 60) | 0x80000
        val ppn = satp & 0xFFFFFFFFFFF
        expect(ppn).to_equal(0x80000)  # oracle: satp.PPN is bits [43:0]; the fixture stores 0x80000
