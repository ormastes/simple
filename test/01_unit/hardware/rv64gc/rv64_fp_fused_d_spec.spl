"""
# RV64 Double-Precision FP Fused Multiply-Add Tests

**Feature IDs:** #RV64-FP-FUSED-D-001
**Category:** Hardware
**Difficulty:** 3/5
**Status:** Draft

## Overview

Unit tests for fmadd.d, fmsub.d, fnmadd.d, fnmsub.d.
"""
use std.spec.step

# tag: only-compiled

use std.spec.step

import std.spec

use hardware.rv64gc.ext.rv64_double.{fp_fmadd_d, fp_fmsub_d, fp_fnmadd_d, fp_fnmsub_d}
use hardware.rv64gc.pkg.rv64_fp_types_pkg.*


val ONE_D: i64 = 0x3FF0000000000000
val TWO_D: i64 = 0x4000000000000000
val THREE_D: i64 = 0x4008000000000000
val FIVE_D: i64 = 0x4014000000000000
val SEVEN_D: i64 = 0x401C000000000000
val POS_ZERO_D: i64 = 0x0000000000000000
val POS_INF_D: i64 = 0x7FF0000000000000
val QNAN_D: i64 = 0x7FF8000000000000
val NEG_SEVEN_D: i64 = 0xC01C000000000000
val NEG_FIVE_D: i64 = 0xC014000000000000

describe "FMADD.D (a*b+c)":
    # @manual scenario evidence
    it "2*3+1 = 7":
        # @req REQ-SSPEC-UNIT
        step("2*3+1 = 7")
        val r = fp_fmadd_d(TWO_D, THREE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(SEVEN_D)

    it "1*1+0 = 1":
        # @req REQ-SSPEC-UNIT
        step("1*1+0 = 1")
        val r = fp_fmadd_d(ONE_D, ONE_D, POS_ZERO_D, RoundMode.RNE)
        expect(r.value).to_equal(ONE_D)

    it "inf*0+1 = NaN":
        # @req REQ-SSPEC-UNIT
        step("inf*0+1 = NaN")
        val r = fp_fmadd_d(POS_INF_D, POS_ZERO_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_D)

    it "NaN propagates":
        # @req REQ-SSPEC-UNIT
        step("NaN propagates")
        val r = fp_fmadd_d(QNAN_D, ONE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_D)

describe "FMSUB.D (a*b-c)":
    it "2*3-1 = 5":
        # @req REQ-SSPEC-UNIT
        step("2*3-1 = 5")
        val r = fp_fmsub_d(TWO_D, THREE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(FIVE_D)

    it "1*1-1 = 0":
        # @req REQ-SSPEC-UNIT
        step("1*1-1 = 0")
        val r = fp_fmsub_d(ONE_D, ONE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(POS_ZERO_D)

    it "inf*1-inf = NaN":
        # @req REQ-SSPEC-UNIT
        step("inf*1-inf = NaN")
        val r = fp_fmsub_d(POS_INF_D, ONE_D, POS_INF_D, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_D)

describe "FNMADD.D (-(a*b)-c)":
    it "-(2*3)-1 = -7":
        # @req REQ-SSPEC-UNIT
        step("-(2*3)-1 = -7")
        val r = fp_fnmadd_d(TWO_D, THREE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(NEG_SEVEN_D)

    it "NaN propagates":
        # @req REQ-SSPEC-UNIT
        step("NaN propagates")
        val r = fp_fnmadd_d(QNAN_D, ONE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_D)

describe "FNMSUB.D (-(a*b)+c)":
    it "-(2*3)+1 = -5":
        # @req REQ-SSPEC-UNIT
        step("-(2*3)+1 = -5")
        val r = fp_fnmsub_d(TWO_D, THREE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(NEG_FIVE_D)

    it "-(1*1)+1 = 0":
        # @req REQ-SSPEC-UNIT
        step("-(1*1)+1 = 0")
        val r = fp_fnmsub_d(ONE_D, ONE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(POS_ZERO_D)

    it "NaN propagates":
        # @req REQ-SSPEC-UNIT
        step("NaN propagates")
        val r = fp_fnmsub_d(QNAN_D, ONE_D, ONE_D, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_D)
