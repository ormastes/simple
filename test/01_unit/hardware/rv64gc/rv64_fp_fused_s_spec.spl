"""
# RV64 Single-Precision FP Fused Multiply-Add Tests

**Feature IDs:** #RV64-FP-FUSED-S-001
**Category:** Hardware
**Difficulty:** 3/5
**Status:** Draft

## Overview

Unit tests for fmadd.s, fmsub.s, fnmadd.s, fnmsub.s.
"""
use std.spec.step

# tag: only-compiled

use std.spec.step

import std.spec

use hardware.rv64gc.ext.rv64_float.{fp_fmadd_s, fp_fmsub_s, fp_fnmadd_s, fp_fnmsub_s}
use hardware.rv64gc.pkg.rv64_fp_types_pkg.*


val ONE_S: i64 = 0x3F800000
val TWO_S: i64 = 0x40000000
val THREE_S: i64 = 0x40400000
val FIVE_S: i64 = 0x40A00000
val SEVEN_S: i64 = 0x40E00000
val NEG_ONE_S: i64 = 0xBF800000
val POS_ZERO_S: i64 = 0x00000000
val POS_INF_S: i64 = 0x7F800000
val QNAN_S: i64 = 0x7FC00000
val FP_FLAG_NV: i64 = 0x10

describe "FMADD.S (a*b+c)":
    # @manual scenario evidence
    it "2*3+1 = 7":
        # @req REQ-SSPEC-UNIT
        step("2*3+1 = 7")
        val r = fp_fmadd_s(TWO_S, THREE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(SEVEN_S)

    it "1*1+0 = 1":
        # @req REQ-SSPEC-UNIT
        step("1*1+0 = 1")
        val r = fp_fmadd_s(ONE_S, ONE_S, POS_ZERO_S, RoundMode.RNE)
        expect(r.value).to_equal(ONE_S)

    it "inf*0+1 = NaN":
        # @req REQ-SSPEC-UNIT
        step("inf*0+1 = NaN")
        val r = fp_fmadd_s(POS_INF_S, POS_ZERO_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_S)

    it "NaN propagates":
        # @req REQ-SSPEC-UNIT
        step("NaN propagates")
        val r = fp_fmadd_s(QNAN_S, ONE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_S)

describe "FMSUB.S (a*b-c)":
    it "2*3-1 = 5":
        # @req REQ-SSPEC-UNIT
        step("2*3-1 = 5")
        val r = fp_fmsub_s(TWO_S, THREE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(FIVE_S)

    it "1*1-1 = 0":
        # @req REQ-SSPEC-UNIT
        step("1*1-1 = 0")
        val r = fp_fmsub_s(ONE_S, ONE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(POS_ZERO_S)

    it "inf*1-inf = NaN":
        # @req REQ-SSPEC-UNIT
        step("inf*1-inf = NaN")
        val r = fp_fmsub_s(POS_INF_S, ONE_S, POS_INF_S, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_S)

describe "FNMADD.S (-(a*b)+c) [NOTE: actually -(a*b)-c per spec]":
    it "-(2*3)-1 = -7":
        # @req REQ-SSPEC-UNIT
        step("-(2*3)-1 = -7")
        val r = fp_fnmadd_s(TWO_S, THREE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(0xC0E00000)

    it "NaN propagates":
        # @req REQ-SSPEC-UNIT
        step("NaN propagates")
        val r = fp_fnmadd_s(QNAN_S, ONE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_S)

describe "FNMSUB.S (-(a*b)+c)":
    it "-(2*3)+1 = -5":
        # @req REQ-SSPEC-UNIT
        step("-(2*3)+1 = -5")
        val r = fp_fnmsub_s(TWO_S, THREE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(0xC0A00000)

    it "-(1*1)+1 = 0":
        # @req REQ-SSPEC-UNIT
        step("-(1*1)+1 = 0")
        val r = fp_fnmsub_s(ONE_S, ONE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(POS_ZERO_S)

    it "NaN propagates":
        # @req REQ-SSPEC-UNIT
        step("NaN propagates")
        val r = fp_fnmsub_s(QNAN_S, ONE_S, ONE_S, RoundMode.RNE)
        expect(r.value).to_equal(QNAN_S)
