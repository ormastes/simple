"""
## Purpose and audience
Purpose: Prove that FCSR Read/Write.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV64GC-001 — stable requirement identity for this spec.

"""
# RV64 FP CSR Unit Tests

**Feature IDs:** #RV64-FP-CSR-001
**Category:** Hardware
**Difficulty:** 2/5
**Status:** Draft

## Overview

Unit tests for floating-point CSRs: fcsr, fflags, frm.
"""

# tag: only-compiled

import std.spec

val FP_FLAG_NX: i64 = 0x01
val FP_FLAG_UF: i64 = 0x02
val FP_FLAG_OF: i64 = 0x04
val FP_FLAG_DZ: i64 = 0x08
val FP_FLAG_NV: i64 = 0x10

class _FpCsr:
    fcsr: i64

    fn fflags() -> i64:
        self.fcsr and 0x1F

    fn frm() -> i64:
        (self.fcsr >> 5) and 0x7

    me set_fflags(v: i64):
        self.fcsr = (self.fcsr and 0xE0) or (v and 0x1F)

    me set_frm(v: i64):
        self.fcsr = (self.fcsr and 0x1F) or ((v and 0x7) << 5)

    me accum_flags(flags: i64):
        self.fcsr = self.fcsr or (flags and 0x1F)

    me clear_all():
        self.fcsr = 0

use std.spec.step

describe "FCSR Read/Write":
    it "fcsr initially zero":
        step("Verify: fcsr initially zero")
        # @req: REQ-HARDWARE-RV64GC-001
        val csr = _FpCsr(fcsr: 0)
        expect(csr.fcsr).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "write and read full fcsr":
        step("Verify: write and read full fcsr")
        var csr = _FpCsr(fcsr: 0)
        csr.fcsr = 0xFF
        expect(csr.fcsr and 0xFF).to_equal(0xFF)

    it "fcsr only uses lower 8 bits (frm + fflags)":
        step("Verify: fcsr only uses lower 8 bits (frm + fflags)")
        var csr = _FpCsr(fcsr: 0xFF)
        expect(csr.fflags()).to_equal(0x1F)
        expect(csr.frm()).to_equal(0x7)

describe "FFlags Individual Flags":
    it "NX (inexact) flag":
        step("Verify: NX (inexact) flag")
        var csr = _FpCsr(fcsr: 0)
        csr.accum_flags(FP_FLAG_NX)
        expect(csr.fflags() and FP_FLAG_NX).to_equal(FP_FLAG_NX)

    it "UF (underflow) flag":
        step("Verify: UF (underflow) flag")
        var csr = _FpCsr(fcsr: 0)
        csr.accum_flags(FP_FLAG_UF)
        expect(csr.fflags() and FP_FLAG_UF).to_equal(FP_FLAG_UF)

    it "OF (overflow) flag":
        step("Verify: OF (overflow) flag")
        var csr = _FpCsr(fcsr: 0)
        csr.accum_flags(FP_FLAG_OF)
        expect(csr.fflags() and FP_FLAG_OF).to_equal(FP_FLAG_OF)

    it "DZ (divide by zero) flag":
        step("Verify: DZ (divide by zero) flag")
        var csr = _FpCsr(fcsr: 0)
        csr.accum_flags(FP_FLAG_DZ)
        expect(csr.fflags() and FP_FLAG_DZ).to_equal(FP_FLAG_DZ)

    it "NV (invalid operation) flag":
        step("Verify: NV (invalid operation) flag")
        var csr = _FpCsr(fcsr: 0)
        csr.accum_flags(FP_FLAG_NV)
        expect(csr.fflags() and FP_FLAG_NV).to_equal(FP_FLAG_NV)

describe "FRM Rounding Modes":
    it "RNE (round to nearest, ties to even) = 0":
        step("Verify: RNE (round to nearest, ties to even) = 0")
        var csr = _FpCsr(fcsr: 0)
        csr.set_frm(0)
        expect(csr.frm()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "RTZ (round toward zero) = 1":
        step("Verify: RTZ (round toward zero) = 1")
        var csr = _FpCsr(fcsr: 0)
        csr.set_frm(1)
        expect(csr.frm()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "RDN (round down) = 2":
        step("Verify: RDN (round down) = 2")
        var csr = _FpCsr(fcsr: 0)
        csr.set_frm(2)
        expect(csr.frm()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "RUP (round up) = 3":
        step("Verify: RUP (round up) = 3")
        var csr = _FpCsr(fcsr: 0)
        csr.set_frm(3)
        expect(csr.frm()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "RMM (round to nearest, ties to max magnitude) = 4":
        step("Verify: RMM (round to nearest, ties to max magnitude) = 4")
        var csr = _FpCsr(fcsr: 0)
        csr.set_frm(4)
        expect(csr.frm()).to_equal(4)  # oracle: 4 — named expected value from the requirement

describe "Exception Accumulation":
    it "flags OR together (accumulate)":
        step("Verify: flags OR together (accumulate)")
        var csr = _FpCsr(fcsr: 0)
        csr.accum_flags(FP_FLAG_NX)
        csr.accum_flags(FP_FLAG_OF)
        expect(csr.fflags()).to_equal(FP_FLAG_NX or FP_FLAG_OF)

    it "setting fflags preserves frm":
        step("Verify: setting fflags preserves frm")
        var csr = _FpCsr(fcsr: 0)
        csr.set_frm(3)
        csr.set_fflags(0x1F)
        expect(csr.frm()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(csr.fflags()).to_equal(0x1F)

    it "reset clears all":
        step("Verify: reset clears all")
        var csr = _FpCsr(fcsr: 0xFF)
        csr.clear_all()
        expect(csr.fcsr).to_equal(0)  # oracle: 0 — named expected value from the requirement
