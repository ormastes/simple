"""
## Purpose and audience
Purpose: Prove that MULW.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV64GC-001 — stable requirement identity for this spec.

"""
# RV64 W-Variant Multiply/Divide Unit Tests

**Feature IDs:** #RV64-MULDIV-WORD-001
**Category:** Hardware
**Difficulty:** 2/5
**Status:** Draft

## Overview

Unit tests for W-suffix multiply/divide (MULW, DIVW, DIVUW, REMW, REMUW).
32-bit operations with sign-extension to 64 bits.
"""

import std.spec

use hardware.rv64gc.ext.rv64_muldiv.muldiv_execute_word
use hardware.rv64gc.pkg.rv64_types_pkg.*

use std.spec.step

describe "MULW":
    it "MULW: 3 * 4 = 12":
        step("Verify: MULW: 3 * 4 = 12")
        # @req: REQ-HARDWARE-RV64GC-001
        expect(muldiv_execute_word(MulDivOp.Mulw, 3, 4)).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "MULW: wraps at 32 bits and sign-extends":
        step("Verify: MULW: wraps at 32 bits and sign-extends")
        val result = muldiv_execute_word(MulDivOp.Mulw, 0x40000000, 2)
        expect(result).to_equal(0xFFFFFFFF80000000)

    it "MULW: ignores upper 32 bits of inputs":
        step("Verify: MULW: ignores upper 32 bits of inputs")
        val result = muldiv_execute_word(MulDivOp.Mulw, 0x100000003, 0x200000004)
        expect(result).to_equal(12)  # oracle: 12 — named expected value from the requirement

describe "DIVW":
    it "DIVW: 20 / 4 = 5":
        step("Verify: DIVW: 20 / 4 = 5")
        expect(muldiv_execute_word(MulDivOp.Divw, 20, 4)).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "DIVW: divide by zero returns -1 (sign-extended)":
        step("Verify: DIVW: divide by zero returns -1 (sign-extended)")
        expect(muldiv_execute_word(MulDivOp.Divw, 20, 0)).to_equal(0xFFFFFFFFFFFFFFFF)

    it "DIVW: overflow 0x80000000 / -1 = 0x80000000 (sign-extended)":
        step("Verify: DIVW: overflow 0x80000000 / -1 = 0x80000000 (sign-extended)")
        val result = muldiv_execute_word(MulDivOp.Divw, 0x80000000, 0xFFFFFFFF)
        expect(result).to_equal(0xFFFFFFFF80000000)

describe "DIVUW":
    it "DIVUW: 20 / 4 = 5":
        step("Verify: DIVUW: 20 / 4 = 5")
        expect(muldiv_execute_word(MulDivOp.Divuw, 20, 4)).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "DIVUW: divide by zero returns 0xFFFFFFFF (sign-extended)":
        step("Verify: DIVUW: divide by zero returns 0xFFFFFFFF (sign-extended)")
        expect(muldiv_execute_word(MulDivOp.Divuw, 20, 0)).to_equal(0xFFFFFFFFFFFFFFFF)

    it "DIVUW: treats operands as unsigned 32-bit":
        step("Verify: DIVUW: treats operands as unsigned 32-bit")
        val result = muldiv_execute_word(MulDivOp.Divuw, 0xFFFFFFFF, 2)
        expect(result).to_equal(0x7FFFFFFF)

describe "REMW":
    it "REMW: 20 % 3 = 2":
        step("Verify: REMW: 20 % 3 = 2")
        expect(muldiv_execute_word(MulDivOp.Remw, 20, 3)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "REMW: negative remainder sign-extends":
        step("Verify: REMW: negative remainder sign-extends")
        val result = muldiv_execute_word(MulDivOp.Remw, -20, 3)
        expect(result).to_equal(0xFFFFFFFFFFFFFFFE)

    it "REMW: divide by zero returns dividend (32-bit sign-ext)":
        step("Verify: REMW: divide by zero returns dividend (32-bit sign-ext)")
        expect(muldiv_execute_word(MulDivOp.Remw, 20, 0)).to_equal(20)  # oracle: 20 — named expected value from the requirement

describe "REMUW":
    it "REMUW: 20 % 3 = 2":
        step("Verify: REMUW: 20 % 3 = 2")
        expect(muldiv_execute_word(MulDivOp.Remuw, 20, 3)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "REMUW: unsigned semantics":
        step("Verify: REMUW: unsigned semantics")
        val result = muldiv_execute_word(MulDivOp.Remuw, 0xFFFFFFFF, 0x10000000)
        expect(result).to_equal(0x0FFFFFFF)

    it "REMUW: divide by zero returns dividend":
        step("Verify: REMUW: divide by zero returns dividend")
        expect(muldiv_execute_word(MulDivOp.Remuw, 20, 0)).to_equal(20)  # oracle: 20 — named expected value from the requirement
