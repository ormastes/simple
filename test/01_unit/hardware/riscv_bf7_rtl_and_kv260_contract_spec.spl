"""
# BF-7 Hardware Contracts: rv32_exec_core Debug Ports + KV260 Clock & UART Truth
"""
# @req: REQ-HARDWARE-RV32-DEBUG-001

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_sh(command: text) -> (text, text, i64):
    val (probe_out, probe_err, probe_code) = rt_process_run("/bin/sh", ["-c", "true"])
    if probe_code == 0:
        return rt_process_run("/bin/sh", ["-c", command])
    rt_process_run("sh", ["-c", command])

describe "BF-7 RV32 debug ports and KV260 bring-up contracts":
    it "exposes Gap 1 clk_en_i/halt_i/halted_o and Gap 2 dbg_imem ports safely without resume corruption":
        val rtl = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/rv32_exec_core.vhd") ?? ""
        expect(rtl).to_contain("clk_en_i         : in  std_logic := '1'")
        expect(rtl).to_contain("halt_i           : in  std_logic := '0'")
        expect(rtl).to_contain("halted_o         : out std_logic")
        expect(rtl).to_contain("dbg_imem_we_i    : in  std_logic := '0'")
        expect(rtl).to_contain("dbg_imem_addr_i  : in  std_logic_vector(31 downto 0)")
        expect(rtl).to_contain("dbg_imem_wdata_i : in  std_logic_vector(31 downto 0)")
        expect(rtl).to_contain("dbg_imem_rdata_o : out std_logic_vector(31 downto 0)")
        expect(rtl).to_contain("halted_o <= halted_q")
        expect(rtl).to_contain("dbg_imem_rdata_o <= rom_b_q")
        # Clock-enable freeze must hold halted_q steady rather than falsifying halt mid-instruction.
        expect(rtl).to_contain("elsif clk_en_i = '0' then")
        val freeze_arm = rtl.split("elsif clk_en_i = '0' then")[1].split("elsif state_q =")[0]
        expect(freeze_arm).to_not_contain("halted_q <= halt_i")
        # External IMEM mux must require halted_q = '1' and exclude the S_FETCH resume edge (halt_i='0', clk_en_i='1').
        expect(rtl).to_contain("if rst = '0' and halted_q = '1' and (halt_i = '1' or clk_en_i = '0') then")
        expect(rtl).to_not_contain("halted_q = '1' or halt_i = '1' or clk_en_i = '0'")
        expect(rtl).to_contain("rom_a(rom_wa) <= rom_wd")
        expect(rtl).to_contain("rom_b(rom_wa) <= rom_wd")

    it "keeps non-DDR KV260 JTAG tops free of PS pl_clk0 and documents CFGMCLK accurately":
        val rv32_top = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/soc_top_rv32.vhd") ?? ""
        val tiny_top = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/soc_top_rv32_tiny_bram.vhd") ?? ""
        val rv64_top = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/soc_top_rv64.vhd") ?? ""
        val rv64_sim = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/soc_top_rv64_sim.vhd") ?? ""
        expect(rv32_top).to_contain("CFGMCLK => cfgmclk")
        expect(tiny_top).to_contain("CFGMCLK => cfgmclk")
        expect(rv64_top).to_contain("CFGMCLK => cfgmclk")
        expect(rv64_sim).to_contain("CFGMCLK/2-clocked")
        expect(rv64_sim).to_not_contain("soc_top_rv64.vhd (Zynq pl_clk0-clocked)")

    it "executes soak_rv32_board --self-test deterministically and passes sh -n on KV260 scripts":
        val (soak_out, soak_err, soak_code) = _run_sh("sh scripts/fpga/soak_rv32_board.shs --self-test")
        expect(soak_code).to_equal(0)
        expect(soak_out).to_contain("STATUS: PASS soak-rv32-board self-test")

        val (syntax_out, syntax_err, syntax_code) = _run_sh("for f in scripts/fpga/bringup_kv260_rv32_ddr.shs scripts/fpga/bringup_kv260_rv64_ddr.shs scripts/fpga/soak_rv32_board.shs scripts/fpga/soak_rv32_board_jtag.shs; do sh -n \"$f\" || exit 1; done")
        expect(syntax_code).to_equal(0)

    it "rejects unrouted FT4232H UART assumptions and missing psu_init.tcl in DDR JTAG bringup":
        val rv32_bringup = rt_file_read_text("scripts/fpga/bringup_kv260_rv32_ddr.shs") ?? ""
        val rv64_bringup = rt_file_read_text("scripts/fpga/bringup_kv260_rv64_ddr.shs") ?? ""
        val board_soak = rt_file_read_text("scripts/fpga/soak_rv32_board.shs") ?? ""
        val jtag_soak = rt_file_read_text("scripts/fpga/soak_rv32_board_jtag.shs") ?? ""
        expect(rv32_bringup).to_contain("psu_init.tcl missing inside")
        expect(rv32_bringup).to_contain("ALLOW_NO_PSU_INIT")
        expect(rv64_bringup).to_contain("psu_init.tcl missing inside")
        expect(rv64_bringup).to_contain("ALLOW_NO_PSU_INIT")
        expect(board_soak).to_not_contain("RV32_BOARD_UART_PORTS:-/dev/ttyUSB1 /dev/ttyUSB2")
        expect(board_soak).to_contain("SERIAL_BY_ID_DIR")
        expect(board_soak).to_contain("golden_provenance=host_sim_reference")
        expect(board_soak).to_contain("SOAK_RV32_BOARD: BLOCKED reason=pl_uart_not_routed_to_ft4232h")
        expect(jtag_soak).to_contain("core_golden_provenance=board_jtag_captured")
        expect(jtag_soak).to_contain("host_golden_provenance=host_sim_reference")
