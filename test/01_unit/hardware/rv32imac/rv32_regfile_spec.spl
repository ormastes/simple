"""
## Purpose and audience
Purpose: Prove that Register File.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV32IMAC-001 — stable requirement identity for this spec.

"""
# RV32 Register File Unit Tests

**Feature IDs:** #RV32-REGFILE-001
**Category:** Hardware
**Difficulty:** 1/5
**Status:** In Progress

## Overview

Unit tests for the 32x32 register file.
"""

import std.spec

use hardware.rv32imac.core.rv32_regfile.Rv32RegFile

use std.spec.step

describe "Register File":
    """
    ## 32-Entry Register File

    Tests read/write behavior and x0 hardwiring.
    """

    it "initializes all registers to zero":
        step("Verify: initializes all registers to zero")
        # @req: REQ-HARDWARE-RV32IMAC-001
        val rf = Rv32RegFile.create()
        var i = 0
        while i < 32:
            expect(rf.read(i)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            i = i + 1

    it "x0 is hardwired to zero":
        step("Verify: x0 is hardwired to zero")
        var rf = Rv32RegFile.create()
        rf.write(0, 0xFFFFFFFF)
        expect(rf.read(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "writes to x1 through x31":
        step("Verify: writes to x1 through x31")
        var rf = Rv32RegFile.create()
        rf.write(1, 0x11111111)
        rf.write(15, 0x55555555)
        rf.write(31, 0xFFFFFFFF)
        expect(rf.read(1)).to_equal(0x11111111)
        expect(rf.read(15)).to_equal(0x55555555)
        expect(rf.read(31)).to_equal(0xFFFFFFFF)

    it "overwrites previous value":
        step("Verify: overwrites previous value")
        var rf = Rv32RegFile.create()
        rf.write(5, 100)
        rf.write(5, 200)
        expect(rf.read(5)).to_equal(200)  # oracle: 200 — named expected value from the requirement

    it "masks to 32 bits":
        step("Verify: masks to 32 bits")
        var rf = Rv32RegFile.create()
        rf.write(1, 0x1FFFFFFFF)
        expect(rf.read(1)).to_equal(0xFFFFFFFF)
