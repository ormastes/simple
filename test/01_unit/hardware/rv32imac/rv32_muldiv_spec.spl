"""
## Purpose and audience
Purpose: Prove that MUL Operations.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV32IMAC-001 — stable requirement identity for this spec.

"""
# RV32 M Extension Unit Tests

**Feature IDs:** #RV32-MEXT-001
**Category:** Hardware
**Difficulty:** 2/5
**Status:** In Progress

## Overview

Unit tests for multiply and divide operations.
"""

import std.spec

use hardware.rv32imac.ext.rv32_muldiv.muldiv_execute
use hardware.rv32imac.pkg.rv32_types_pkg.*

use std.spec.step

describe "MUL Operations":
    """
    ## Multiply Lower 32 Bits
    """

    it "basic multiplication":
        step("Verify: basic multiplication")
        # @req: REQ-HARDWARE-RV32IMAC-001
        expect(muldiv_execute(AluOp.Mul, 6, 7)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "multiply by zero":
        step("Verify: multiply by zero")
        expect(muldiv_execute(AluOp.Mul, 12345, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "multiply by one":
        step("Verify: multiply by one")
        expect(muldiv_execute(AluOp.Mul, 12345, 1)).to_equal(12345)  # oracle: 12345 — named expected value from the requirement

    it "overflow wraps to lower 32 bits":
        step("Verify: overflow wraps to lower 32 bits")
        expect(muldiv_execute(AluOp.Mul, 0x10000, 0x10000)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "DIV Operations":
    """
    ## Signed Division
    """

    it "basic division":
        step("Verify: basic division")
        expect(muldiv_execute(AluOp.Div, 42, 6)).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "truncates toward zero":
        step("Verify: truncates toward zero")
        expect(muldiv_execute(AluOp.Div, 7, 2)).to_equal(3)  # oracle: 3 — named expected value from the requirement

    # Division-by-zero and overflow tests require compiled mode
    # (interpreter const-folds through to semantic div-by-zero error)

describe "DIVU Operations":
    """
    ## Unsigned Division
    """

    it "basic unsigned division":
        step("Verify: basic unsigned division")
        expect(muldiv_execute(AluOp.Divu, 100, 10)).to_equal(10)  # oracle: 10 — named expected value from the requirement

    # Division-by-zero test requires compiled mode

describe "REM Operations":
    """
    ## Remainder
    """

    it "basic remainder":
        step("Verify: basic remainder")
        expect(muldiv_execute(AluOp.Rem, 10, 3)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "remainder of exact division":
        step("Verify: remainder of exact division")
        expect(muldiv_execute(AluOp.Rem, 12, 4)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # Remainder-by-zero test requires compiled mode

describe "REMU Operations":
    """
    ## Unsigned Remainder
    """

    it "basic unsigned remainder":
        step("Verify: basic unsigned remainder")
        expect(muldiv_execute(AluOp.Remu, 10, 3)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    # Remainder-by-zero test requires compiled mode
