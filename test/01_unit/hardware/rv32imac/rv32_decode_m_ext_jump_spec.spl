# @tag:in-development
# Tracks: rv32imac_decode_spec_needs_m_extension_and_jump_branch_decode_2026-11-27
"""
# RV32 Decode: M-Extension and Jump/Branch Decode

**Feature IDs:** #RV32-DECODE-001
**Category:** Hardware
**Status:** In Development

## Overview

Cases split from rv32_decode_spec.spl that need decoder support riscv_common
does not have yet: the M-extension MUL ALU op, and an opcode-aware
`decode_branch_op(opcode, funct3)` that also maps JAL/JALR and returns None
for a non-branch opcode.
"""

import std.spec

use hardware.riscv_common.core.riscv_decode.*
use hardware.riscv_common.pkg.riscv_isa_pkg.*
use hardware.riscv_common.pkg.riscv_types_pkg.*

describe "ALU Operation Decode (M extension)":
    it "maps MUL correctly":
        expect(decode_alu_op(OP_OP, 0, 0x01)).to_equal(AluOp.Mul)

describe "Branch Operation Decode":
    """
    ## Branch Op Mapping
    """

    it "maps BEQ correctly":
        expect(decode_branch_op(OP_BRANCH, F3_BEQ)).to_equal(BranchOp.Beq)

    it "maps BNE correctly":
        expect(decode_branch_op(OP_BRANCH, F3_BNE)).to_equal(BranchOp.Bne)

    it "maps JAL correctly":
        expect(decode_branch_op(OP_JAL, 0)).to_equal(BranchOp.Jal)

    it "maps JALR correctly":
        expect(decode_branch_op(OP_JALR, 0)).to_equal(BranchOp.Jalr)

    it "returns None for non-branch":
        expect(decode_branch_op(OP_OP, 0)).to_equal(BranchOp.None)
