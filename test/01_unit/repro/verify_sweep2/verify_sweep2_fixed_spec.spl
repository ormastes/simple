# Purpose and audience: compiler engineers re-checking the 2026-11-06 s3_fable46 verify sweep 2.
# @req REQ-SSPEC-COMPILER
"""
# Verify-sweep-2 probes for bugs the sweep marked fixed

Each fixture under test/fixtures/repro/verify_sweep2/ is a probe the sweep ran
with s3_fable46 (sha256 6d95126bef198b82) natively or with the seed. Only the
PASS markers tied to rows set `fixed` are asserted; other markers in a bundled
fixture belong to rows that stayed open or pending (see bug_db evidence rows).
"""

# @tag: unit, compiler, repro, verify-sweep

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run, env_get, host_os}

val FIXTURE_DIR = "test/fixtures/repro/verify_sweep2"

fn contract_binary() -> text:
    val override = env_get("SIMPLE_TEST_BINARY")
    if override != "":
        return override
    if host_os() == "windows":
        return "bin/simple.exe"
    "bin/simple"

fn run_fixture(name: text) -> (text, text, i64):
    process_run(contract_binary(), ["run", "{FIXTURE_DIR}/{name}.spl"])

describe "verify-sweep-2 fixed bugs keep passing":
    it "b00_e: PASS coalesce,PASS trimbytes":
        step("run b00_e")
        val (out, err, code) = run_fixture("b00_e")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS coalesce"), true)
        assert_equal(out.contains("PASS trimbytes"), true)

    it "b02_f64u64: PASS f64 half,PASS f64 sum":
        step("run b02_f64u64")
        val (out, err, code) = run_fixture("b02_f64u64")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS f64 half"), true)
        assert_equal(out.contains("PASS f64 sum"), true)

    it "b03_spill_loop: PASS spill_loop":
        step("run b03_spill_loop")
        val (out, err, code) = run_fixture("b03_spill_loop")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS spill_loop"), true)

    it "b04_alias: PASS alias-static":
        step("run b04_alias")
        val (out, err, code) = run_fixture("b04_alias")
        # seed run: tail if/else-print in main exits 1 ("cannot convert string to int"); marker is the check
        assert_equal(out.contains("FAIL"), false)
        assert_equal(out.contains("PASS alias-static"), true)

    it "b04_ctx: PASS ctx-compare":
        step("run b04_ctx")
        val (out, err, code) = run_fixture("b04_ctx")
        # seed run: tail if/else-print in main exits 1 ("cannot convert string to int"); marker is the check
        assert_equal(out.contains("FAIL"), false)
        assert_equal(out.contains("PASS ctx-compare"), true)

    it "b04_trail: PASS static-default,PASS u8-to-i64":
        step("run b04_trail")
        val (out, err, code) = run_fixture("b04_trail")
        # seed run: tail if/else-print in main exits 1 ("cannot convert string to int"); marker is the check
        assert_equal(out.contains("FAIL"), false)
        assert_equal(out.contains("PASS static-default"), true)
        assert_equal(out.contains("PASS u8-to-i64"), true)

    it "b05_a3: PASS eqord":
        step("run b05_a3")
        val (out, err, code) = run_fixture("b05_a3")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS eqord"), true)

    it "b05_d2: PASS valueopt,PASS concat":
        step("run b05_d2")
        val (out, err, code) = run_fixture("b05_d2")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS valueopt"), true)
        assert_equal(out.contains("PASS concat"), true)

