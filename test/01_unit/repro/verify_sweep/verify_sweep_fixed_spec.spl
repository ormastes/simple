# Purpose and audience: compiler engineers re-checking the 2026-11-05 s3_fable43 verify sweep (PRs #6977/#6982).
# @req REQ-SSPEC-COMPILER
"""
# Verify-sweep probes for bugs the sweep marked fixed

Each fixture under test/fixtures/repro/verify_sweep/ is the probe the sweep ran
natively with s3_fable43 (sha256 615859c5c2815f71) and that printed PASS. Here the
same sources run through `SIMPLE_TEST_BINARY run` (default bin/simple.exe), so a
regression in either lane shows up as a changed stdout or exit code. Native
evidence per bug_db row stays the s3_fable43 run; this spec is the cheap re-run.
"""

# @tag: unit, compiler, repro, verify-sweep

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run, env_get}

val FIXTURE_DIR = "test/fixtures/repro/verify_sweep"

fn contract_binary() -> text:
    val override = env_get("SIMPLE_TEST_BINARY")
    if override != "" and override != nil:
        return override
    "bin/simple.exe"

fn run_fixture(name: text) -> (text, text, i64):
    val cmd = "'{contract_binary()}' run '{FIXTURE_DIR}/{name}.spl'"
    process_run("/bin/sh", ["-c", cmd])

describe "verify-sweep fixed bugs keep passing":
    it "b0_a: score formatter, array ==, unwrap payloads, extend, loop sums":
        step("run b0_a")
        val (out, err, code) = run_fixture("b0_a")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS"), true)
        assert_equal(out.contains("FAIL"), false)

    it "b1_a: u8 array !=, bool render, empty dict text, optional array if-val":
        step("run b1_a")
        val (out, err, code) = run_fixture("b1_a")
        assert_equal(code, 0)
        assert_equal(out.contains("U8NE=false"), true)
        assert_equal(out.contains("BOOL=true"), true)
        assert_equal(out.contains("TS=7"), true)
        assert_equal(out.contains("OPTARR=2"), true)
        assert_equal(out.contains("DICT=ok"), true)

    it "b1_d: `new` usable as an identifier":
        step("run b1_d")
        val (out, err, code) = run_fixture("b1_d")
        assert_equal(code, 0)
        assert_equal(out.contains("NV:L|END"), true)

    it "b2r_append: [text].append":
        step("run b2r_append")
        val (out, err, code) = run_fixture("b2r_append")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS append"), true)

    it "b2r_errunwrap: Result<i64, enum> err()/unwrap_err()":
        step("run b2r_errunwrap")
        val (out, err, code) = run_fixture("b2r_errunwrap")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS errunwrap"), true)

    it "b2r_nl: consecutive print() calls keep newlines":
        step("run b2r_nl")
        val (out, err, code) = run_fixture("b2r_nl")
        assert_equal(code, 0)
        assert_equal(out.contains("L1"), true)
        assert_equal(out.contains("L2"), true)
        assert_equal(out.contains("L3"), true)

    it "b3_multi: negative literal match arms, ? on Option, array map, u64 coalesce":
        step("run b3_multi")
        val (out, err, code) = run_fixture("b3_multi")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS"), true)
        assert_equal(out.contains("FAIL"), false)

    it "b3_multi2: enum text payload interpolation, dict tuple binders":
        step("run b3_multi2")
        val (out, err, code) = run_fixture("b3_multi2")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS"), true)
        assert_equal(out.contains("FAIL"), false)

    it "b4r_coal: Dict<text,text> d[k] ?? empty miss and hit":
        step("run b4r_coal")
        val (out, err, code) = run_fixture("b4r_coal")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS"), true)

    it "b4r_dictarr: Dict<text,[text]> index in for-in and contains":
        step("run b4r_dictarr")
        val (out, err, code) = run_fixture("b4r_dictarr")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS"), true)

    it "b4r_matcharm: match arm payload array vs [] literal":
        step("run b4r_matcharm")
        val (out, err, code) = run_fixture("b4r_matcharm")
        assert_equal(code, 0)
        assert_equal(out.contains("PASS"), true)

    it "b5_combo: option match, u64 range, concat, suffix range, lambdas, dict push":
        step("run b5_combo")
        val (out, err, code) = run_fixture("b5_combo")
        assert_equal(code, 0)
        for tag in ["optmatch", "u64range", "concat", "suffix", "lambda", "fnvalue", "dictpush"]:
            assert_equal(out.contains("FAIL " + tag), false)
