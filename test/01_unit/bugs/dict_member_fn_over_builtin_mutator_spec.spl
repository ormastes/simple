"""
Regression guard for bug `module_val_dict_export_unresolved_via_use_2026-09-01`
(residual): `dir.remove(path)` on the `std.shell.dir` module ran the built-in
dict mutator `remove` instead of the module's own `remove` function, so the
directory was never removed and the call returned the module itself. A member
function stored under the called name wins over a built-in dict mutator; a
dict with no such member keeps the built-in behaviour.
"""
use std.spec.{describe, it, expect}
use std.shell.dir

fn fake_remove(key: text) -> text:
    "called:" + key

describe "a stored member function wins over a built-in dict mutator":
    it "module function named like a dict mutator is called":
        val t = "build/test_tmp/dict_member_fn_spec_dir"
        dir.create_recursive(t)
        expect(dir.exist(t)).to_equal(true)
        expect(dir.remove(t)).to_equal(true)
        expect(dir.exist(t)).to_equal(false)

    it "a dict storing a function under `remove` calls it, in statement and expression position":
        var table = {"remove": fake_remove, "other": fake_remove}
        expect(table.remove("k")).to_equal("called:k")
        table.remove("other")
        expect(table.len()).to_equal(2)

    it "a plain dict still removes the key":
        var d = {"a": 1, "b": 2}
        d.remove("a")
        expect(d.len()).to_equal(1)
        expect(d.has("a")).to_equal(false)
