use std.spec.{describe, it, expect}

fn run_a() -> i64:
    var p = PA_create()
    p.feed(3)
    p.total

fn run_b() -> i64:
    var p = PB(total: 0)
    p.feed(3)
    p.total

describe "impl block declared after the describe":
    it "A: class with impl block, built by a factory fn":
        expect(run_a()).to_equal(3)
    it "B: class with impl block, built directly":
        expect(run_b()).to_equal(3)

class PA:
    total: i64

fn PA_create() -> PA:
    PA(total: 0)

impl PA:
    me feed(n: i64):
        self.total = self.total + n

class PB:
    total: i64

impl PB:
    me feed(n: i64):
        self.total = self.total + n
