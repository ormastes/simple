# @req: REQ-GEN-BUGS-001

"""
# Result under the forced-interpret test lane Specification

**Feature IDs:** #INTERP-RESULT-LANE-001
**Category:** Runtime
**Difficulty:** 3/5
**Status:** In Progress
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** doc/08_tracking/bug/test_harness_execution_divergence_2026-07-29.md

## Overview

`bin/simple test` forces SIMPLE_EXECUTION_MODE=interpret, and two lanes
independently found Result-wrapped APIs untestable there:
- qualified construction `Result.Ok(x)` / `Result.Err(e)` failed with
  "variable `Result` not found" (direct) or "unknown class Result"
  (imported module, e.g. bencode_decode_value) because the builtin
  Option/Result enums were never registered in the interpreter's enum
  registry (user enums were);
- the `?` operator appeared broken in BOTH engines, but that was the
  SIMPLE_BOOTSTRAP=1 textual `strip_optionals` preprocessor deleting the
  try-operator from valid sources before parse (now fallback-only).

This spec runs under the forced-interpret lane by construction and pins
every consumption form, using bencode_decode_value as the integration
proof for the imported-module path.
"""

use std.spec
use std.common.encoding.bencode.{bencode_decode_value}


fn half(n: i64) -> Result<i64, text>:
    if n % 2 == 0:
        return Ok(n / 2)
    Err("odd: {n}")

fn qual(n: i64) -> Result<i64, text>:
    if n > 0:
        return Result.Ok(n * 2)
    Result.Err("neg")

fn opt_qual(n: i64) -> Option<i64>:
    if n > 0:
        return Option.Some(n)
    Option.None

fn via_try(n: i64) -> Result<i64, text>:
    val h = half(n)?
    Ok(h + 100)


use std.spec.step

describe "Result under the forced-interpret test lane":

    context "bare construction and match":
        it "matches Ok with its payload":
            # @req: REQ-GEN-BUGS-001
            step("Verify: matches Ok with its payload")
            match half(10):
                case Ok(v): expect(v).to_equal(5)  # oracle: 5 — named expected value from the requirement
                case Err(e): expect(e).to_equal("UNREACHED")

        it "matches Err with its payload":
            # @req: REQ-GEN-BUGS-001
            step("Verify: matches Err with its payload")
            match half(7):
                case Ok(v): expect(v).to_equal(-1)  # oracle: -1 — named expected value from the requirement
                case Err(e): expect(e).to_equal("odd: 7")

    context "QUALIFIED construction (the reported failure)":
        it "constructs via Result.Ok":
            # @req: REQ-GEN-BUGS-001
            step("Verify: constructs via Result.Ok")
            match qual(21):
                case Ok(v): expect(v).to_equal(42)  # oracle: 42 — named expected value from the requirement
                case Err(e): expect(e).to_equal("UNREACHED")

        it "constructs via Result.Err":
            # @req: REQ-GEN-BUGS-001
            step("Verify: constructs via Result.Err")
            match qual(-1):
                case Ok(v): expect(v).to_equal(-1)  # oracle: -1 — named expected value from the requirement
                case Err(e): expect(e).to_equal("neg")

        it "constructs via Option.Some and Option.None":
            # @req: REQ-GEN-BUGS-001
            step("Verify: constructs via Option.Some and Option.None")
            match opt_qual(9):
                case Some(v): expect(v).to_equal(9)  # oracle: 9 — named expected value from the requirement
                case _: expect(true).to_equal(false)
            match opt_qual(-9):
                case Some(v): expect(v).to_equal(-1)  # oracle: -1 — named expected value from the requirement
                case _: expect(1).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "question-mark operator":
        it "unwraps Ok through ?":
            # @req: REQ-GEN-BUGS-001
            step("Verify: unwraps Ok through ?")
            match via_try(10):
                case Ok(v): expect(v).to_equal(105)  # oracle: 105 — named expected value from the requirement
                case Err(e): expect(e).to_equal("UNREACHED")

        it "propagates Err through ?":
            # @req: REQ-GEN-BUGS-001
            step("Verify: propagates Err through ?")
            match via_try(7):
                case Ok(v): expect(v).to_equal(-1)  # oracle: -1 — named expected value from the requirement
                case Err(e): expect(e).to_equal("odd: 7")

    context "method consumption":
        it "is_ok and unwrap agree with match":
            # @req: REQ-GEN-BUGS-001
            step("Verify: is_ok and unwrap agree with match")
            val r = half(4)
            expect(r.is_ok()).to_be_true()
            expect(r.unwrap()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    context "imported-module integration (bencode)":
        it "bencode_decode_value's Result API is exercisable":
            # @req: REQ-GEN-BUGS-001
            step("Verify: bencode_decode_value's Result API is exercisable")
            # This exact call failed with "unknown class Result" under the
            # test lane before the registry fix.
            match bencode_decode_value("i42e"):
                case Ok(v): expect(1).to_equal(1)  # oracle: 1 — named expected value from the requirement
                case Err(e): expect(1).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "reports trailing data as Err":
            # @req: REQ-GEN-BUGS-001
            step("Verify: reports trailing data as Err")
            match bencode_decode_value("i42eXX"):
                case Ok(v): expect(1).to_equal(-1)  # oracle: -1 — named expected value from the requirement
                case Err(e): expect(1).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "vacuity probe":
        it "executes assertions in this file":
            # @req: REQ-GEN-BUGS-001
            step("Verify: executes assertions in this file")
            expect(half(8).unwrap()).to_equal(4)  # oracle: 4 — named expected value from the requirement
