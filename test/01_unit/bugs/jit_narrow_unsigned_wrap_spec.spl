use std.spec.{describe, it, expect}

# Interpreter and JIT must agree: + - * on u8/u16/u32 wrap at the static width.
describe "narrow unsigned arithmetic wraps at the operation":
    it "u8 add/sub/mul":
        val a: u8 = 200
        val b: u8 = 60
        expect(a + b).to_equal(4)
        expect(b - a).to_equal(116)
        expect(a * b).to_equal(224)
    it "u16 add/sub/mul":
        val a: u16 = 60000
        val b: u16 = 10000
        expect(a + b).to_equal(4464)
        expect(b - a).to_equal(15536)
        expect(a * b).to_equal(17920)
    it "u32 add/sub/mul":
        val a: u32 = 4000000000
        val b: u32 = 500000000
        expect(a + b).to_equal(205032704)
        expect(b - a).to_equal(794967296)
        expect(a * b).to_equal(1321730048)
    it "u8 with literal":
        val a: u8 = 250
        expect(a + 10).to_equal(4)
        expect(a * 2).to_equal(244)
