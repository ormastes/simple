"""

# doc-path: doc/01_research/local/text_negative_single_index_spec.md
# doc-path: doc/03_plan/sys_test/text_negative_single_index_spec.md
# doc-path: doc/04_architecture/text_negative_single_index_spec.md
# doc-path: doc/05_design/text_negative_single_index_spec_oracles.md
# @manual: primary

"""
# Text negative single-index Specification

**Feature IDs:** #INTERP-TEXT-NEG-INDEX-001
**Category:** Runtime
**Difficulty:** 2/5
**Status:** In Progress
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** doc/08_tracking/bug/test_harness_execution_divergence_2026-07-29.md

## Overview

Pins CHARACTER-indexed text single-indexing with Python-style negative
indices, in both engines. Single-index (`s[i]`, `char_at`) keeps
character semantics — the deliberate outlier family — while slices, len
and index_of are byte-indexed.

Before the fix the JIT lane's rt_string_char_at returned NIL for any
negative index ("aé🙂z"[-2] was nil under the default engine while the
interpreter returned "🙂"). This spec runs under bin/simple test's
forced-interpret lane; the JIT half of the A/B is pinned by probes in
the bug doc.
"""

use std.spec.step

use std.spec
use std.spec.step



describe "text single-index character semantics":
    # @manual scenario evidence

    context "positive indices are character-indexed":
        it "returns the multi-byte character at index 1":
            # @req REQ-SSPEC-UNIT
            step("returns the multi-byte character at index 1")
            val v = "aé🙂z"
            expect(v[1]).to_equal("é")

        it "returns the 4-byte emoji at index 2":
            # @req REQ-SSPEC-UNIT
            step("returns the 4-byte emoji at index 2")
            val v = "aé🙂z"
            expect(v[2]).to_equal("🙂")

    context "negative indices count characters from the end":
        it "returns the last character for -1":
            # @req REQ-SSPEC-UNIT
            step("returns the last character for -1")
            val v = "aé🙂z"
            expect(v[-1]).to_equal("z")

        it "returns the 4-byte emoji for -2":
            # @req REQ-SSPEC-UNIT
            step("returns the 4-byte emoji for -2")
            val v = "aé🙂z"
            expect(v[-2]).to_equal("🙂")

        it "returns the first character for -len":
            # @req REQ-SSPEC-UNIT
            step("returns the first character for -len")
            val v = "aé🙂z"
            expect(v[-4]).to_equal("a")

    context "agreement between forms":
        it "v[-2] equals v[len_chars - 2]":
            # @req REQ-SSPEC-UNIT
            step("v[-2] equals v[len_chars - 2]")
            val v = "aé🙂z"
            expect(v[-2]).to_equal(v[2])

    context "vacuity probe":
        it "executes assertions in this file":
            # @req REQ-SSPEC-UNIT
            step("executes assertions in this file")
            val v = "vacuity"
            expect(v[-1]).to_equal("y")
