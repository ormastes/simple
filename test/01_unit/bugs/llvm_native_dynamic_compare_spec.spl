# doc-path: doc/01_research/local/llvm_native_dynamic_compare_spec.md
# doc-path: doc/03_plan/sys_test/llvm_native_dynamic_compare_spec.md
# doc-path: doc/04_architecture/llvm_native_dynamic_compare_spec.md
