use std.spec.{describe, it, expect}

describe "u8 operand with a wider signed Int":
    it "does not narrow the product to u8 width":
        val b: [u8] = [5u8, 0u8, 18u8]
        var v = 0
        var m = 1
        var i = 0
        while i < 3:
            v = v + (b[i] * m)
            m = m * 256
            i = i + 1
        expect(v).to_equal(1179653)

    it "still wraps u8 with an in-range operand":
        val x: u8 = 200u8
        expect(x * 2).to_equal(144)
        expect(x + 100).to_equal(44)
