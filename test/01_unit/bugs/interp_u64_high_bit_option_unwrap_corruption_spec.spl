# Regression coverage for interp_u64_high_bit_option_unwrap_corruption.
# The loop/reassign/return shape intentionally forces the interpreter fallback
# described in doc/08_tracking/bug/interp_u64_high_bit_option_unwrap_corruption_2026-07-11.md.

struct Frame:
    id: text
    checksum: u64

fn find_valid(frames: [Frame], target_id: text) -> Frame?:
    var found: Frame? = nil
    var matching_count = 0
    for frame in frames:
        if frame.id == target_id:
            matching_count = matching_count + 1
            val valid = frame.checksum > 0u64
            if valid:
                found = frame
    if matching_count == 1:
        return found
    nil

describe "interpreter u64 high-bit Option unwrap":
    it "unwraps a high-bit u64 struct field through if val":
        val result = find_valid(
            [Frame(id: "high", checksum: 9223372036854775808u64)],
            "high"
        )
        if val frame = result:
            expect(frame.checksum).to_equal(9223372036854775808u64)
        else:
            expect(false).to_equal(true)

    it "keeps the signed-boundary predecessor working":
        val result = find_valid(
            [Frame(id: "low", checksum: 9223372036854775807u64)],
            "low"
        )
        if val frame = result:
            expect(frame.checksum).to_equal(9223372036854775807u64)
        else:
            expect(false).to_equal(true)

    it "orders mixed signed and unsigned values without narrowing":
        val signed = -1
        val unsigned = 0u64
        expect(signed < unsigned).to_equal(true)
        expect(unsigned > signed).to_equal(true)
