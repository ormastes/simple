# @req Bare `field = value` inside a plain `fn` method must never silently
# no-op. The negative half (the program must be REJECTED) cannot live in a
# spec -- a must-not-compile body would reject the spec file itself -- so it is
# asserted by scripts/check/check-implicit-self-field-assignment.shs, which
# grew `fn` probes for exactly this bug. What a spec CAN pin is the positive
# half the fix must not break: explicit `self.field = ...` inside a plain `fn`
# method really does reach the caller, and a genuine local that merely shares a
# field's name still shadows it.
#
# doc/08_tracking/bug/implicit_self_field_assignment_still_silent_in_plain_fn_methods_2026-08-31.md
use std.spec

class Counter:
    count: i64 = 0
    flag: bool = false

    fn bump(self):
        self.count = self.count + 1

    fn shadowing_local(self) -> i64:
        var count = 41
        count = count + 1
        return count

    static fn static_local() -> i64:
        var flag = 7
        return flag

describe "implicit self field assignment (plain fn methods)":
    it "an explicit self.field write inside a plain fn method is visible to the caller":
        var c = Counter()
        c.bump()
        c.bump()
        expect(c.count).to_equal(2)

    it "a genuine local sharing a field name still shadows the field":
        var c = Counter()
        expect(c.shadowing_local()).to_equal(42)
        expect(c.count).to_equal(0)

    it "a local in a static method sharing a field name is untouched by the guard":
        expect(Counter.static_local()).to_equal(7)
