"""Tuple call projections retain their field types in condition and value positions."""

use std.spec

fn condition_tuple(valid: bool) -> (bool, text, [text]):
    if not valid:
        return (false, "rejected", [])
    (true, "entry.spl", ["src/app"])

fn condition_roots(valid: bool, fallback: bool) -> [text]:
    val frozen = condition_tuple(valid)
    if not frozen.0 and not fallback:
        return []
    if frozen.0:
        return frozen.2
    ["fallback"]

fn absent_condition() -> bool?:
    nil

fn present_condition() -> bool?:
    true

describe "native tuple call condition type":
    it "short circuits rejection without dereferencing an absent HIR type":
        val rejected = condition_roots(false, false)
        expect(rejected.len()).to_equal(0)

    it "preserves bool and array projections from a tuple returning call":
        val admitted = condition_roots(true, false)
        expect(admitted.len()).to_equal(1)
        expect(admitted[0]).to_equal("src/app")

    it "evaluates the explicit fallback when the tuple bool is false":
        val opted_in = condition_roots(false, true)
        expect(opted_in.len()).to_equal(1)
        expect(opted_in[0]).to_equal("fallback")

    it "preserves the text projection from a tuple returning call":
        val frozen = condition_tuple(true)
        expect(frozen.1).to_equal("entry.spl")

    it "keeps nil and optional condition normalization":
        var decisions = 0
        if not nil:
            decisions = decisions + 1
        if nil and true:
            decisions = decisions + 100
        if not absent_condition():
            decisions = decisions + 1
        if present_condition() and true:
            decisions = decisions + 1
        expect(decisions).to_equal(3)
