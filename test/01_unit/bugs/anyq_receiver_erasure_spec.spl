"""
## Purpose and audience
Purpose: Pin the fix for cross-module `any?` receiver-type erasure — an
explicit concrete local annotation (`val d: Dict<text, i64> = ...`) must win
over an `Any`/`Any?` initializer type in MIR Let lowering.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run with the test runner; a red scenario means either the behavioral shape
regressed (interpreter half) or the MIR lowering fix was removed (source-pin
half — the native-only symptom is "unresolved method call: keys" plus
"for-in ... (collection mir type: I64)", which no interpret-mode spec can
observe, hence the pin).
## Compatibility and limitations
KNOWN DIVERGENCE (measured 2026-09-01, seed interpreter): the bare
`val d: Dict<text, i64> = get_obj(...)` form (no `??`) binds the raw
Some(...) enum under the INTERPRETER and dies at first use with
"cannot index value of type enum" — the interpreter, like pre-fix MIR
lowering, ignores the concrete annotation and does not unwrap. Native
codegen with the pinned fix unwraps via rt_unwrap_or_self and works. The
behavioral scenarios below therefore use the `?? default` form, which both
modes support; the bare-annotation native behavior is pinned by source
inspection (repo convention, cf. dict_typed_method_lowering_source_spec).
"""
# @req: REQ-BUGS-001

use std.spec
use bugs.anyq_receiver_erasure_helper.get_obj

extern fn rt_file_read_text(path: text) -> text

describe "cross-module any? receiver-type erasure (val d: Dict<text,i64> = any?-call)":
    it "keeps dict methods usable on a concretely annotated any?-initialized binding":
        step("Verify: keeps dict methods usable on a concretely annotated any?-initialized binding")
        # @req: REQ-BUGS-001
        val d: Dict<text, i64> = get_obj({"a": 1, "b": 2}) ?? {}
        var seen = 0
        var total = 0
        for k in d.keys():
            seen = seen + 1
            total = total + d[k]
        expect(seen).to_equal(2)  # oracle: 2 — both keys iterate
        expect(total).to_equal(3)  # oracle: 3 — 1 + 2, values not garbage

    it "keeps array indexing usable on a concretely annotated any?-initialized binding":
        step("Verify: keeps array indexing usable on a concretely annotated any?-initialized binding")
        val a: [i64] = get_obj([4, 5, 6]) ?? []
        expect(a[1]).to_equal(5)  # oracle: 5 — element, not an option-handle word

    it "does not disturb concrete-initializer inference (controls)":
        step("Verify: does not disturb concrete-initializer inference (controls)")
        val d1 = {"x": 7}
        expect(d1["x"]).to_equal(7)
        val d2: Dict<text, i64> = {"y": 8}
        expect(d2["y"]).to_equal(8)

    it "pins the MIR Let-lowering fix that prefers a concrete annotation over Any/Any? init":
        step("Verify: pins the MIR Let-lowering fix that prefers a concrete annotation over Any/Any? init")
        # The native-only symptom cannot be observed from interpret mode, so
        # pin the fix's load-bearing pieces in the live early-Let path.
        val source = rt_file_read_text("src/compiler/50.mir/mir_lowering_stmts.spl") ?? ""
        expect(source).to_contain("any?/any receiver-type erasure")
        expect(source).to_contain("anyq_init_is_opt_any")
        expect(source).to_contain("MirConstValue.Str(\"rt_unwrap_or_self\")")
        expect(source).to_contain("self.remember_local_hir_type(init_local.id, anyq_declared, 0, 0)")
