"""
Regression guard for bug `static_factory_method_chain_wrong_value_2026-08-16`.

A method chained directly off a `static fn` factory call, nested inside another
call such as `expect(...)`, used to fail with "method not found on value of
type object in nested call context" because the receiver type was erased.
Both the bound and the chained forms must resolve the method and agree.
For compiler/interpreter engineers changing method resolution.
"""
use std.spipe.*

class Box:
    n: int
    me double() -> int:
        return self.n * 2
    static fn create(n: int) -> Box:
        return Box(n: n)

describe "method chained off a static factory":
    it "bound to a val first":
        val b = Box.create(21)
        expect(b.double()).to_equal(42)

    it "chained off the static factory inside expect":
        expect(Box.create(21).double()).to_equal(42)

    it "chained and bound forms agree for another input":
        val bound = Box.create(-4).double()
        expect(Box.create(-4).double()).to_equal(bound)
        expect(Box.create(-4).double()).to_equal(-8)
