"""
## Purpose and audience
Purpose: Pin the fix for bug seed_interp_local_to_i64_unwrap_shifts_by_tag_2026_11_09:
`x!` on a local holding a bare (non-nullable) `text.to_i64()` result must be
the identity. Under the seed JIT it re-typed the raw word as tagged `Any` and
shifted it by the tag width (`"20672".to_i64()` then `!` gave 2584).
Audience: compiler engineers. Run under SIMPLE_EXECUTION_MODE=jit for the
native-path signal; the interpreter was always correct.
"""
# @req: REQ-BUGS-001

use std.spec

fn _unwrap_local(s: text) -> i64:
    val d = s.to_i64()
    d!

fn _unwrap_if_expr(name: text) -> i64:
    val parts = name.split(".")
    val o = if parts.len() >= 4: parts[2].to_i64() else: None
    o!

describe "force unwrap of a raw to_i64 local":
    it "is the identity on a local":
        expect(_unwrap_local("20672")).to_equal(20672)

    it "is the identity through an if-expression with else None":
        expect(_unwrap_if_expr(".tmp.20672.x")).to_equal(20672)

    it "compares equal to the parsed value":
        val d = "20672".to_i64()
        expect(d! == 20672).to_equal(true)
