# Helper module for seed_unsigned_semantics_spec: typed module-level unsigned
# constants that the spec imports, so the binding crosses a module boundary.

val IMPORTED_KERNEL_START: u64 = 0xFFFF800000000000
val IMPORTED_U64_MAX: u64 = 0xFFFFFFFFFFFFFFFF
const IMPORTED_CONST_TOP: u64 = 0x8000000000000000
val IMPORTED_U32_MAX: u32 = 0xFFFFFFFF
