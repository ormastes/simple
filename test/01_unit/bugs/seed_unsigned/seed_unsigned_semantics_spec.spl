# Regression coverage for seed unsigned-integer semantics: values >= 2^63 typed
# u64 must compare, divide, and shift as unsigned in both the interpreter and
# the JIT. See doc/08_tracking/bug/seed_u64_signed_compare_and_u8_data_ptr_2026-10-19.md.

use std.spec
use bugs.seed_unsigned.unsigned_consts.{IMPORTED_KERNEL_START, IMPORTED_U64_MAX, IMPORTED_CONST_TOP, IMPORTED_U32_MAX}

const LOCAL_CONST_START: u64 = 0xFFFF800000000000

fn kernel_start_fn() -> u64:
    0xFFFF800000000000

fn is_user_ptr(ptr: u64) -> bool:
    ptr != 0 and ptr < IMPORTED_KERNEL_START

describe "seed unsigned integer semantics":
    it "keeps imported typed u64 module values unsigned":
        val ptr: u64 = 0x7FF0
        expect(IMPORTED_KERNEL_START.to_text()).to_equal("18446603336221196288")
        expect(IMPORTED_U64_MAX.to_text()).to_equal("18446744073709551615")
        expect(ptr < IMPORTED_KERNEL_START).to_equal(true)
        expect(ptr < IMPORTED_U64_MAX).to_equal(true)
        expect(is_user_ptr(0x7FF0)).to_equal(true)
        expect(is_user_ptr(0xFFFFFFFFFFFFFFF8u64)).to_equal(false)

    it "keeps typed const values unsigned":
        val ptr: u64 = 0x7FF0
        expect(ptr < LOCAL_CONST_START).to_equal(true)
        expect(IMPORTED_CONST_TOP > ptr).to_equal(true)
        expect(IMPORTED_CONST_TOP / 2u64).to_equal(4611686018427387904u64)

    it "keeps a u64 function return unsigned":
        val ptr: u64 = 0x7FF0
        expect(ptr < kernel_start_fn()).to_equal(true)

    it "treats suffixed u64 literals as unsigned operands":
        expect(0xFFFFFFFFFFFFFFF8u64 > 5u64).to_equal(true)
        expect(5u64 < 0xFFFFFFFFFFFFFFF8u64).to_equal(true)
        expect(0x8000000000000000u64 / 2u64).to_equal(4611686018427387904u64)
        expect(0xFFFFFFFFFFFFFFFFu64 >> 60u64).to_equal(15u64)
        expect(0xFFFFFFFFFFFFFFFFu64 % 10u64).to_equal(5u64)
        val three: u64 = 3
        expect(0xFFFFFFFFFFFFFFFFu64 / three).to_equal(6148914691236517205u64)

    it "wraps u32 arithmetic and keeps it unsigned":
        var a: u32 = 0
        a = a - 1u32
        expect(a > 1u32).to_equal(true)
        expect(a / 2u32).to_equal(2147483647u32)
        expect(a >> 31u32).to_equal(1u32)
        expect(IMPORTED_U32_MAX > 1u32).to_equal(true)

    it "keeps a block-local typed u64 unsigned":
        val big: u64 = 0xFFFFFFFFFFFFFFF8
        expect(big > 5u64).to_equal(true)
        expect(big / 2u64).to_equal(9223372036854775804u64)
        expect(big >> 60u64).to_equal(15u64)
