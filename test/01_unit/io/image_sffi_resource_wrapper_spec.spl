# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/io/image_sffi_resource_wrapper_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/image_sffi_resource_wrapper_spec.md
# doc-path: doc/03_plan/sys_test/image_sffi_resource_wrapper_spec.md
# doc-path: doc/04_architecture/image_sffi_resource_wrapper_spec.md
# doc-path: doc/05_design/image_sffi_resource_wrapper_spec_oracles.md
# @manual: primary

"""
Resource wrapper for Image — WP-J acceptance

Tests the new Image wrapper class with resource ownership pattern:
- Sentinel-based validity checks
- Consuming close() method
- Double-close guard (one-shot safety)
- Backward compatibility with deprecated ImageData aliases
"""

use std.spec.step

use std.spec
use std.spec.step
use std.nogc_sync_mut.io.image_sffi.{Image, load_image_resource, LoadedImageData, load_image, free_image}


describe "Image resource wrapper":
    # @manual scenario evidence
    it "Image.is_valid checks sentinel":
        # @req REQ-SSPEC-UNIT
        step("Image.is_valid checks sentinel")
        val img = Image(handle: 42, width: 100, height: 100, channels: 4)
        assert_true(img.is_valid())

    it "Image.is_valid detects invalid sentinel (0)":
        # @req REQ-SSPEC-UNIT
        step("Image.is_valid detects invalid sentinel (0)")
        val img = Image(handle: 0, width: 100, height: 100, channels: 4)
        assert_false(img.is_valid())

    it "Image sentinel is 0 not -1":
        # @req REQ-SSPEC-UNIT
        step("Image sentinel is 0 not -1")
        val img_zero = Image(handle: 0, width: 100, height: 100, channels: 4)
        assert_false(img_zero.is_valid())
        val img_neg = Image(handle: -1, width: 100, height: 100, channels: 4)
        assert_true(img_neg.is_valid())

    # `close()` calls the REAL `rt_image_free` C extern. `Image(handle: 42,
    # ...)` is a fabricated pointer that was never returned by
    # `rt_image_load` -- calling the real free on it is undefined behavior,
    # not a guard-logic test. This crashed the original version of this spec
    # (`error: test-runner: spec failed` partway through the file). The
    # guard's actual behavior -- `if self.handle != 0: free(); handle = 0` --
    # is proven safely below using the invalid sentinel (0), which the guard
    # skips before ever reaching the extern call. Testing double-close on a
    # genuinely-acquired handle needs a real decodable image fixture and is
    # left as a follow-up:
    # doc/08_tracking/bug/image_wrapper_close_needs_live_handle_fixture_2026-08-07.md

    it "close on invalid handle is safe":
        # @req REQ-SSPEC-UNIT
        step("close on invalid handle is safe")
        val img = Image(handle: 0, width: 100, height: 100, channels: 4)
        img.close()
        assert_equal(img.handle, 0)
        img.close()
        assert_equal(img.handle, 0)

    it "pixel_count calculates correctly":
        # @req REQ-SSPEC-UNIT
        step("pixel_count calculates correctly")
        val img = Image(handle: 42, width: 10, height: 20, channels: 4)
        assert_equal(img.pixel_count(), 200)

    it "size_bytes accounts for channels":
        # @req REQ-SSPEC-UNIT
        step("size_bytes accounts for channels")
        val img = Image(handle: 42, width: 10, height: 20, channels: 4)
        assert_equal(img.size_bytes(), 800)

    it "get_pixel returns 0 for invalid handle":
        # @req REQ-SSPEC-UNIT
        step("get_pixel returns 0 for invalid handle")
        val img = Image(handle: 0, width: 10, height: 20, channels: 4)
        assert_equal(img.get_pixel(5, 5), 0)

    it "LoadedImageData (deprecated) still exists":
        # @req REQ-SSPEC-UNIT
        step("LoadedImageData (deprecated) still exists")
        val img = LoadedImageData(handle: 42, width: 100, height: 100, channels: 4)
        assert_true(img.is_valid())

    it "load_image (deprecated) returns invalid sentinel on missing file":
        # @req REQ-SSPEC-UNIT
        step("load_image (deprecated) returns invalid sentinel on missing file")
        val result = load_image("/nonexistent/path")
        assert_false(result.is_valid())
        assert_equal(result.handle, 0)

    # Live-handle fixtures (doc/08_tracking/bug/image_wrapper_close_needs_live_handle_fixture_2026-08-07.md):
    # `test/fixture/io/tiny_1x1.png` is a genuinely valid 1x1 RGBA PNG that
    # `rt_image_load` decodes, so `.close()` below exercises the REAL
    # `rt_image_free` C path on a genuinely-acquired handle — not a fabricated
    # pointer (undefined behavior) and not the skipped-extern sentinel case.
    # The factories intentionally return a non-optional sentinel value rather
    # than Optional: mutation through an Optional-unwrapped class binding does
    # not persist in every runtime path, which silently defeats the one-shot
    # close guard and turns a second close into a real double-free crash.

    it "load_image_resource decodes tiny_1x1.png into a live handle":
        # @req REQ-SSPEC-UNIT
        step("load_image_resource decodes tiny_1x1.png into a live handle")
        val img = load_image_resource("test/fixture/io/tiny_1x1.png")
        assert_true(img.is_valid())
        assert_equal(img.width, 1)
        assert_equal(img.height, 1)
        assert_equal(img.channels, 4)
        img.close()

    it "load_image_resource returns invalid sentinel on missing file":
        # @req REQ-SSPEC-UNIT
        step("load_image_resource returns invalid sentinel on missing file")
        val img = load_image_resource("/nonexistent/path")
        assert_false(img.is_valid())
        assert_equal(img.handle, 0)
        # close on the invalid sentinel must be a safe no-op
        img.close()
        assert_equal(img.handle, 0)

    it "double-close on a live handle is a defined no-op":
        # @req REQ-SSPEC-UNIT
        step("double-close on a live handle is a defined no-op")
        val img = load_image_resource("test/fixture/io/tiny_1x1.png")
        assert_true(img.is_valid())
        img.close()
        assert_equal(img.handle, 0)
        # Second close must not crash and must not double-free.
        img.close()
        assert_equal(img.handle, 0)
        assert_false(img.is_valid())
        assert_equal(img.get_pixel(0, 0), 0)

    it "free_image on a live handle is fail-closed against double-free":
        # @req REQ-SSPEC-UNIT
        step("free_image on a live handle is fail-closed against double-free")
        var img = load_image("test/fixture/io/tiny_1x1.png")
        assert_true(img.is_valid())
        img = free_image(img)
        # Consuming drop: returned handle is invalidated so a second call is a no-op.
        assert_equal(img.handle, 0)
        assert_false(img.is_valid())
        img = free_image(img)
        assert_equal(img.handle, 0)
