#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../../../.." && pwd)
build_dir=${TMPDIR:-/tmp}/simple-kpf-c-cpp-$$
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM
mkdir -p "$build_dir"

cc -std=c11 -Wall -Wextra -Werror -pedantic \
    -I"$repo_root/sdk/kernel_plugin/c" \
    "$repo_root/sdk/kernel_plugin/c/example_provider.c" \
    "$repo_root/sdk/kernel_plugin/c/example_client.c" \
    -o "$build_dir/c-example"
"$build_dir/c-example"

cc -std=c11 -Wall -Wextra -Werror -pedantic \
    -I"$repo_root/sdk/kernel_plugin/c" \
    -c "$repo_root/sdk/kernel_plugin/c/example_provider.c" \
    -o "$build_dir/provider.o"
c++ -std=c++17 -Wall -Wextra -Werror -pedantic -fno-exceptions \
    -I"$repo_root/sdk/kernel_plugin/cpp" \
    "$repo_root/sdk/kernel_plugin/cpp/example_client.cpp" \
    "$build_dir/provider.o" \
    -o "$build_dir/cpp-example"
"$build_dir/cpp-example"

printf '%s\n' 'C/C++ KPF conformance: PASS'
