# @req REQ-INTERPRETER-MCDC-UNARY-NOT-LEAVES
# Requires SIMPLE_COVERAGE=1 to activate the real runtime collector.
use compiler.core.ast.{ast_reset}
use compiler.core.ast_expr.{expr_bool_lit, expr_unary, expr_binary, expr_ident}
use compiler.core.types.{flat_span_new}
use compiler.core.interpreter.eval.{eval_control_condition}
use compiler.core.interpreter.eval_decls.{eval_init}
use compiler.core.interpreter.value.{val_get_bool}
use compiler.core.interpreter.jit.{jit_init}
use std.nogc_sync_mut.sffi.coverage.{coverage_enabled, coverage_clear, coverage_dump_sdn}

describe "interpreter coverage unary-not leaves":
    before_each:
        eval_init()
        ast_reset()
        jit_init(999999, 0)
        coverage_clear()

    it "records the operand truth and excludes the negation wrapper":
        expect(coverage_enabled()).to_equal(true)
        val leaf = expr_bool_lit(1, flat_span_new(100, 104, 1, 5))
        val negation = expr_unary(57, leaf, flat_span_new(200, 208, 1, 1))
        val result = eval_control_condition(negation, 90001)
        expect(val_get_bool(result)).to_equal(false)
        val receipt = coverage_dump_sdn()
        expect(receipt).to_contain("90001, 101,")
        expect(receipt.contains("90001, 201,")).to_equal(false)

    it "preserves short-circuiting and only records the evaluated leaf":
        expect(coverage_enabled()).to_equal(true)
        val leaf = expr_bool_lit(0, flat_span_new(300, 305, 2, 6))
        val skipped = expr_ident("coverage_unbound_right_operand", flat_span_new(400, 429, 2, 16))
        val conjunction = expr_binary(55, leaf, skipped, flat_span_new(500, 535, 2, 5))
        val negation = expr_unary(57, conjunction, flat_span_new(600, 637, 2, 1))
        val result = eval_control_condition(negation, 90002)
        expect(val_get_bool(result)).to_equal(true)
        val receipt = coverage_dump_sdn()
        expect(receipt).to_contain("90002, 301,")
        expect(receipt.contains("90002, 401,")).to_equal(false)
        expect(receipt.contains("90002, 501,")).to_equal(false)
        expect(receipt.contains("90002, 601,")).to_equal(false)

    it "propagates an operand error without recording an invented condition":
        expect(coverage_enabled()).to_equal(true)
        val missing = expr_ident("coverage_unbound_error_operand", flat_span_new(700, 730, 3, 5))
        val negation = expr_unary(57, missing, flat_span_new(800, 832, 3, 1))
        val result = eval_control_condition(negation, 90003)
        expect(result).to_equal(-1)
        val receipt = coverage_dump_sdn()
        expect(receipt.contains("90003, 701,")).to_equal(false)
        expect(receipt.contains("90003, 801,")).to_equal(false)
