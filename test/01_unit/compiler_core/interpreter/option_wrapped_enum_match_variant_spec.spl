# Regression spec for
# doc/08_tracking/bug/interpreter_match_on_option_of_enum_fires_no_arm_2026-08-06.md
#
# Bug: matching an `E?` (Option<Enum>) value DIRECTLY against E's own variant
# patterns (`case E.A(x):`, `case E.C:`, or the bare `case A:` form) fired no
# arm under the interpreter, when the value happens to be physically wrapped
# as an `Option::Some`/`Option::None` boxed struct (as opposed to E's own
# `EnumName::Variant` boxed struct, which `eval_enum_variant_call` always
# produces).
#
# Root cause: `match_enum_variant_pattern` (eval.spl) recognizes the "boxed
# enum" shape purely by the presence of a `__tag` field
# (`val_is_boxed_enum`), then compares that field's TEXT directly against the
# target variant name. An `Option::Some` wrapper is itself boxed exactly the
# same way (`__tag` = "Some", `__payload` = the wrapped value), so when the
# scrutinee is such a wrapper, the tag compared was the WRAPPER's own tag
# ("Some"/"None"), never the enum's -- "A"/"C" can never equal "Some", so
# every real-variant arm silently failed and control fell through to
# `case _`. Verified directly below: before the fix,
# `match_enum_variant_pattern(Option::Some(E::A(7)), "A", [])` returned
# `false`; the bare-name path (`case A:` at line ~823 of eval.spl) had the
# identical defect and now delegates to the same fixed function.
#
# Fix: `match_enum_variant_pattern`, when the scrutinee IS boxed and the
# target variant is neither "Some" nor "None", first checks whether the
# scrutinee's OWN struct name (not merely the presence of `__tag`) is
# literally "Option::Some" / "Option::None". If so it unwraps one layer
# (recursing into the payload for Some, or reporting no-match for None)
# before ever comparing tags -- mirroring how `!`/`.unwrap()` already unwrap
# such a wrapper elsewhere in this same interpreter (eval_try in
# eval_access.spl, `.unwrap()` in eval_calls.spl's method dispatch).
#
# Non-vacuity / sabotage-check performed manually: reverting the fix (undoing
# the `if struct_name == "Option::Some": ... if struct_name == "Option::None":
# ...` block and the bare-name delegation) reproduces the exact pre-fix
# symptom -- the "wrapped" examples below flip from pass to fail while the
# "plain boxed" baseline keeps passing, matching the doc's own isolation
# table (interpreter column, "match Option direct" row).

use std.spec
use compiler.core.interpreter.value.{val_make_struct, val_make_int, val_make_text}
use compiler.core.interpreter.eval.{match_enum_variant_pattern}

fn make_boxed_enum(struct_name: text, tag: text, payload: i64) -> i64:
    val_make_struct(struct_name, ["__tag", "__payload"], [val_make_text(tag), payload])

describe "match_enum_variant_pattern unwraps an Option wrapper before comparing a non-Option variant tag":

    it "matches a plain boxed user-enum value against its own variant (baseline, unaffected by the fix)":
        val e_val = make_boxed_enum("E::A", "A", val_make_int(7))
        expect(match_enum_variant_pattern(e_val, "A", [])).to_equal(true)

    it "does NOT match a plain boxed user-enum value against a different variant":
        val e_val = make_boxed_enum("E::A", "A", val_make_int(7))
        expect(match_enum_variant_pattern(e_val, "C", [])).to_equal(false)

    it "matches an Option::Some-wrapped payload-carrying variant against the inner variant name (the bug)":
        val inner = make_boxed_enum("E::A", "A", val_make_int(7))
        val wrapped = make_boxed_enum("Option::Some", "Some", inner)
        expect(match_enum_variant_pattern(wrapped, "A", [])).to_equal(true)

    it "matches an Option::Some-wrapped payloadless variant against the inner variant name":
        val inner = make_boxed_enum("E::C", "C", val_make_int(0))
        val wrapped = make_boxed_enum("Option::Some", "Some", inner)
        expect(match_enum_variant_pattern(wrapped, "C", [])).to_equal(true)

    it "does NOT match an Option::Some wrapper against an unrelated inner variant name":
        val inner = make_boxed_enum("E::A", "A", val_make_int(7))
        val wrapped = make_boxed_enum("Option::Some", "Some", inner)
        expect(match_enum_variant_pattern(wrapped, "C", [])).to_equal(false)

    it "does NOT match an Option::None wrapper against any real variant name":
        val wrapped = make_boxed_enum("Option::None", "None", val_make_int(0))
        expect(match_enum_variant_pattern(wrapped, "A", [])).to_equal(false)
        expect(match_enum_variant_pattern(wrapped, "C", [])).to_equal(false)

    it "still matches the wrapper itself (not the inner enum) when the pattern's own variant IS Some/None":
        val inner = make_boxed_enum("E::A", "A", val_make_int(7))
        val wrapped = make_boxed_enum("Option::Some", "Some", inner)
        expect(match_enum_variant_pattern(wrapped, "Some", [])).to_equal(true)
        expect(match_enum_variant_pattern(wrapped, "None", [])).to_equal(false)
