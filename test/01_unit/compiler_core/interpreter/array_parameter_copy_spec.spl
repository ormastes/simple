# @req REQ-INTERP-ARRAY-PARAM-VALUE
# Arrays passed to functions have independent storage; class elements retain identity.
use compiler.core.interpreter.value.*
use compiler.core.interpreter.eval_calls.{val_copy_for_parameter, eval_function_call}
use compiler.core.interpreter.eval_decls.{eval_init}
use compiler.core.interpreter.env.{env_define}
use compiler.core.interpreter.jit.{jit_init}
use compiler.core.interpreter.eval_tables.{struct_table_register}
use compiler.core.ast.{ast_reset, decl_struct_def, decl_set_is_value_type, decl_fn}
use compiler.core.ast_expr.{expr_ident}
use compiler.core.ast_stmt.{stmt_expr_stmt}

describe "Interpreter array parameter values":
    before_each:
        eval_init()
        ast_reset()
        jit_init(999999, 0)

    it "isolates append and element replacement from the caller":
        val original = val_make_array([val_make_int(1), val_make_int(2)])
        env_define("array_param_input", original)
        val body = [stmt_expr_stmt(expr_ident("items", 0), 0)]
        val declaration = decl_fn("array_parameter_echo", ["items"], [0], 0, body, 0, [], 0)
        val copied = eval_function_call(declaration, [expr_ident("array_param_input", 0)], [])
        expect(copied != original).to_equal(true)
        expect(val_array_push(copied, val_make_int(3))).to_equal(true)
        expect(val_array_set(copied, 0, val_make_int(9))).to_equal(true)
        expect(val_get_array(original).len()).to_equal(2)
        expect(val_get_int(val_get_array(original)[0])).to_equal(1)
        expect(val_get_array(copied).len()).to_equal(3)
        expect(val_get_int(val_get_array(copied)[0])).to_equal(9)

    it "isolates nested array mutation":
        val inner = val_make_array([val_make_int(5)])
        val original = val_make_array([inner])
        val copied = val_copy_for_parameter(original)
        val copied_inner = val_get_array(copied)[0]
        expect(copied_inner != inner).to_equal(true)
        expect(val_array_push(copied_inner, val_make_int(6))).to_equal(true)
        expect(val_get_array(inner).len()).to_equal(1)
        expect(val_get_array(copied_inner).len()).to_equal(2)

    it "keeps class element identity shared through an independent array":
        val declaration = decl_struct_def("ArrayParamCell", ["value"], [0], [], [], 0)
        decl_set_is_value_type(declaration, 0)
        struct_table_register("ArrayParamCell", declaration)
        val cell = val_make_struct("ArrayParamCell", ["value"], [val_make_int(42)])
        val original = val_make_array([cell])
        val copied = val_copy_for_parameter(original)
        val copied_cell = val_get_array(copied)[0]
        expect(copied != original).to_equal(true)
        expect(copied_cell).to_equal(cell)
        val_struct_set_field(copied_cell, "value", val_make_int(777))
        expect(val_get_int(val_struct_get_field(val_get_array(original)[0], "value"))).to_equal(777)

    it "copies value struct elements and their array fields":
        val declaration = decl_struct_def("ArrayParamPoint", ["items"], [0], [], [], 0)
        decl_set_is_value_type(declaration, 1)
        struct_table_register("ArrayParamPoint", declaration)
        val inner = val_make_array([val_make_int(7)])
        val point = val_make_struct("ArrayParamPoint", ["items"], [inner])
        val copied = val_copy_for_parameter(val_make_array([point]))
        val copied_point = val_get_array(copied)[0]
        val copied_inner = val_struct_get_field(copied_point, "items")
        expect(copied_point != point).to_equal(true)
        expect(copied_inner != inner).to_equal(true)
        expect(val_array_push(copied_inner, val_make_int(8))).to_equal(true)
        expect(val_get_array(inner).len()).to_equal(1)

    it "keeps scalar identities and handles empty arrays":
        val scalar = val_make_int(23)
        expect(val_copy_for_parameter(scalar)).to_equal(scalar)
        val empty = val_make_array([])
        val copied = val_copy_for_parameter(empty)
        expect(copied != empty).to_equal(true)
        expect(val_get_array(copied).len()).to_equal(0)
