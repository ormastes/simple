describe "seed JIT release inside an open transient scope":
    it "frees in the scope, allocates under pause, reads survivors after scope end":
        step("Verify: the 1,000 releases happen and the 64 paused rows survive scope end")
        val frees = rt_heap_free_count()
        expect(scope_churn_then_survivors()).to_equal(502644)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
