# Purpose and audience: executable specification evidence for the owning engineering team.
# design: doc/05_design/compiler/jit_memory/seed_jit_array_reclamation.md (Option A, slice S1)
# bug: doc/08_tracking/bug/core_interp_per_iteration_array_leak_2026-11-14.md
#
# The seed JIT releases a scalar-element array local when its declaring
# statement list falls through, but only when the compiler proved the local is
# the buffer's single holder. The JIT aliases arrays at many sites where the
# interpreter copies (design section 2.5), so every escape form must keep
# today's behaviour: NOT freed. A wrong release there is a use-after-free.
#
# Positive examples: 1,000 iterations leave at most 2 live arrays and perform
# at least 1,000 frees. Negative examples: 1,000 iterations still leak at least
# 1,000 arrays (the release did not fire) and compute the same value as before.
#
# @jit_spec_entry
# The heap counters only observe runtime heap objects, i.e. the JIT lane.

use std.spec.step

extern fn rt_heap_live_count_by_kind(kind: i64) -> i64
extern fn rt_heap_free_count() -> i64

val HEAP_KIND_ARRAY: i64 = 2

struct Holder:
    xs: [i64]
    n: i64

var g_arr: [i64] = [1, 2, 3]
var g_rows: [[i64]] = [[1, 2], [3, 4]]
var g_slot: [i64] = [0]

fn live_arrays() -> i64:
    rt_heap_live_count_by_kind(HEAP_KIND_ARRAY)

fn ident(x: [i64]) -> [i64]:
    x

fn take_len(x: [i64]) -> i64:
    x.len()

fn mut_index(x: [i64]) -> i64:
    x[0] = 9
    x[0]

fn make_tail(i: i64) -> [i64]:
    val a = [i, 2, 3]
    a

fn make_ret(i: i64) -> [i64]:
    val a = [i, 2, 3]
    return a

# ---- positive loop bodies ----------------------------------------------------

fn p_literal() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, i + 1, i + 2]
        acc = acc + a[1]
        i = i + 1
    acc

fn p_copy_read_only(src: [i64]) -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val c = src
        acc = acc + c[0]
        i = i + 1
    acc

fn p_copy_then_store(src: [i64]) -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        var c = src
        c[0] = i
        acc = acc + c[0] + src[0]
        i = i + 1
    acc

fn p_row_of_local_rows(rows: [[i64]]) -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val row = rows[1]
        acc = acc + row[0]
        i = i + 1
    acc

fn p_global() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = g_arr
        acc = acc + a[2]
        i = i + 1
    acc

fn p_row_of_global_rows() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val row = g_rows[1]
        acc = acc + row[1]
        i = i + 1
    acc

fn p_field(h: Holder) -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val xs = h.xs
        acc = acc + xs[1]
        i = i + 1
    acc

fn p_bool() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val b = [true, false]
        if b[0]:
            acc = acc + 1
        i = i + 1
    acc

# Float elements are heap-boxed, so a shallow free would leak the boxes:
# float arrays are outside the S1 allowlist and are not released.
fn n_float() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val f = [1.5, 2.5]
        if f[1] > 2.0:
            acc = acc + 1
        i = i + 1
    acc

fn p_nested_if_and_function_level(n: i64) -> i64:
    val top = [n, 2, 3]
    var i = 0
    var acc = 0
    while i < 1000:
        if i >= 0:
            val a = [i, 1]
            acc = acc + a[0]
        i = i + 1
    acc + top[1]

fn n_A5_call_ret() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        var b = ident(a)
        b[0] = 9
        acc = acc + a[0] + b[0]
        i = i + 1
    acc

fn n_A6_struct_arg() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val h = Holder(xs: a, n: i)
        a[0] = 9
        acc = acc + h.xs[0]
        i = i + 1
    acc

fn n_A7_capture() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val f = \x: x + a[0]
        a[0] = 9
        acc = acc + f(1)
        i = i + 1
    acc

fn n_A8_global_write() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        g_slot = a
        a[0] = 9
        acc = acc + g_slot[0]
        i = i + 1
    acc

fn n_A9_push_into() -> i64:
    var i = 0
    var acc = 0
    var rows: [[i64]] = []
    while i < 1000:
        val a = [i, 1, 2]
        rows.push(a)
        a[0] = 9
        acc = acc + rows[i][0]
        i = i + 1
    acc

fn n_A10_assign() -> i64:
    var i = 0
    var acc = 0
    var b = [0]
    while i < 1000:
        val a = [i, 1, 2]
        b = a
        b[0] = 9
        acc = acc + a[0]
        i = i + 1
    acc

fn n_A13_tuple() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val t = (a, 1)
        a[0] = 9
        acc = acc + a[0]
        i = i + 1
    acc

fn n_A14_array_elem() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val o = [a]
        a[0] = 9
        acc = acc + o[0][0]
        i = i + 1
    acc

fn n_A15_dict_val() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val d = {"k": a}
        a[0] = 9
        acc = acc + a[0]
        i = i + 1
    acc

fn n_A16_for_elem() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val rows = [[i, 1], [2, 3]]
        for r in rows:
            r[0] = 9
        acc = acc + rows[0][0]
        i = i + 1
    acc

fn n_A17_if_expr() -> i64:
    var i = 0
    var acc = 0
    val a2 = [7, 8]
    while i < 1000:
        val a = [i, 1, 2]
        var b = if i > 5: a else: a2
        b[0] = 9
        acc = acc + a[0]
        i = i + 1
    acc

fn n_A18_index_store() -> i64:
    var i = 0
    var acc = 0
    var rows = [[0], [1]]
    while i < 1000:
        val a = [i, 1, 2]
        rows[0] = a
        a[0] = 9
        acc = acc + rows[0][0]
        i = i + 1
    acc

fn n_A19_elem_arg() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val rows = [[i, 1], [2, 3]]
        acc = acc + mut_index(rows[0]) + rows[0][0]
        i = i + 1
    acc

fn n_A20_some() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val o = Some(a)
        a[0] = 9
        acc = acc + a[0]
        i = i + 1
    acc

fn n_call_arg() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        acc = acc + take_len(a)
        i = i + 1
    acc

fn n_tail_expr() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val m = make_tail(i)
        acc = acc + m[0]
        i = i + 1
    acc

fn n_return() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val m = make_ret(i)
        acc = acc + m[0]
        i = i + 1
    acc

fn n_struct_handover() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        var o = [i, 1]
        val h = Holder(xs: o, n: i)
        acc = acc + h.n
        i = i + 1
    acc

fn n_move_source() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        var s = [i, 1]
        var o = s
        o.push(1)
        acc = acc + o.len()
        i = i + 1
    acc

fn n_reassign() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        var a = [i]
        a = [i, 2]
        acc = acc + a[0]
        i = i + 1
    acc

fn n_break() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1]
        if i == 5000:
            break
        acc = acc + a[0]
        i = i + 1
    acc

fn n_text() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = ["x", "y"]
        acc = acc + a.len()
        i = i + 1
    acc

fn n_nested_array() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [[i], [2]]
        acc = acc + a[0][0]
        i = i + 1
    acc

fn n_let_source() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val b = a
        acc = acc + b[0]
        i = i + 1
    acc

fn n_for_iter() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        for x in a:
            acc = acc + x
        i = i + 1
    acc

fn n_slice() -> i64:
    var i = 0
    var acc = 0
    while i < 1000:
        val a = [i, 1, 2]
        val s = a[0..2]
        acc = acc + s[0]
        i = i + 1
    acc

# ---- transient scope: frees inside an open scope ------------------------------

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

# Opens a scope, releases 1,000 loop locals inside it, pauses, allocates 64
# rows the scope does not own, ends the scope, then reads the rows. A freed
# array left in the scope's list would let scope end free a row that reused
# its address. Returns -1 when the scope calls fail.
fn scope_churn_then_survivors() -> i64:
    if not rt_transient_array_scope_begin():
        return -1
    val churned = p_literal()
    if not rt_transient_array_scope_pause():
        return -1
    var keep: [[i64]] = []
    var i = 0
    while i < 64:
        keep.push([i, i + 1])
        i = i + 1
    if not rt_transient_array_scope_end():
        return -1
    var acc = 0
    var j = 0
    while j < 64:
        acc = acc + keep[j][1]
        j = j + 1
    acc + churned + keep.len()

describe "seed JIT releases proven-unique scalar array locals at block end":
    it "fresh literal: val a = [i, i + 1, i + 2]":
        step("Verify: 1,000 iterations leave the live-array count flat")
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_literal()).to_equal(500500)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)

    it "copied local, read only: val c = src":
        step("Verify: the per-iteration copy is released")
        val src = [1, 2, 3]
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_copy_read_only(src)).to_equal(1000)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
        expect(src[0]).to_equal(1)

    it "copied local, scalar index store: var c = src; c[0] = i":
        step("Verify: the copy is released and the source is untouched")
        val src = [1, 2, 3]
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_copy_then_store(src)).to_equal(500500)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
        expect(src[0]).to_equal(1)

    it "row of a local [[i64]]: val row = rows[1]":
        step("Verify: the row copy is released and the row itself survives")
        val rows = [[1, 2], [3, 4]]
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_row_of_local_rows(rows)).to_equal(3000)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
        expect(rows[1][0]).to_equal(3)

    it "global array: val a = g_arr":
        step("Verify: the copy is released and the global survives")
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_global()).to_equal(3000)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
        expect(g_arr[2]).to_equal(3)

    it "row of a global [[i64]]: val row = g_rows[1]":
        step("Verify: the row copy is released and the global row survives")
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_row_of_global_rows()).to_equal(4000)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
        expect(g_rows[1][1]).to_equal(4)

    it "struct field: val xs = h.xs":
        step("Verify: the field copy is released and the field survives")
        val h = Holder(xs: [5, 6], n: 1)
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_field(h)).to_equal(6000)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)
        expect(h.xs[1]).to_equal(6)

    it "bool element arrays":
        step("Verify: the per-iteration bool array is released")
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_bool()).to_equal(1000)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1000).to_equal(true)

    it "nested if body and function-level local":
        step("Verify: lists other than a loop body release too")
        val before = live_arrays()
        val frees = rt_heap_free_count()
        expect(p_nested_if_and_function_level(7)).to_equal(499502)
        expect(live_arrays() - before <= 2).to_equal(true)
        expect(rt_heap_free_count() - frees >= 1001).to_equal(true)

describe "seed JIT does not release an array that may have a second holder":
    it "excluded element type: float arrays (boxed elements)":
        step("Verify: 1,000 iterations still hold at least 1,000 arrays and the value is unchanged")
        val before = live_arrays()
        expect(n_float()).to_equal(1000)
        expect(live_arrays() - before >= 1000).to_equal(true)

    it "escape form: A5 call ret":
        step("Verify: 1,000 iterations still hold at least 1,000 arrays and the value is unchanged")
        val before = live_arrays()
