# @req REQ-SSPEC-UNIT
"""
Guards spec_cross_module_eval_warnings_not_observed_2026-08-05 (sub-issue):
eval.spl exported `eval_clear_warnings` but never defined it.
Run: `bin/simple test test/01_unit/compiler_core/interpreter/eval_clear_warnings_spec.spl`.
"""

use std.spec
use compiler.core.interpreter.eval.{eval_get_warnings, eval_clear_warnings}

describe "eval_clear_warnings":
    it "is defined and leaves the warning list empty":
        # @req REQ-SSPEC-UNIT
        step("clear warnings")
        eval_clear_warnings()
        expect(eval_get_warnings().len()).to_equal(0)
