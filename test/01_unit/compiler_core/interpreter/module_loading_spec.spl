# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Module loading, observed at runtime: each scenario exercises a real
# `use` import of a distinct stdlib module family and asserts on the
# behavior of the imported symbols, proving the loader resolved,
# parsed, and linked the module tree.

use std.spec.step
use std.common.math.{abs_i64, max_i64}
use std.common.base_encoding.base64.{base64_encode, base64_decode}
use std.common.crypto.sha256.{sha256_text}
use std.common.math.{math_min_i64, math_clamp_i64, math_sign_i64}

describe "Runtime Module Loading":
    # @manual scenario evidence
    it "loads std.text and its methods compute real results":
        # @req REQ-SSPEC-UNIT
        step("import std.text and call through it")
        expect("Hello".to_lower()).to_equal("hello")
        expect(["a", "b", "c"].join("-")).to_equal("a-b-c")

    it "loads a second module family in the same program":
        # @req REQ-SSPEC-UNIT
        step("selectively import std.common.math helpers")
        expect(abs_i64(-42)).to_equal(42)
        expect(max_i64(3, 9)).to_equal(9)

    it "selective imports with curly braces bind only named symbols":
        # @req REQ-SSPEC-COMPILER-CORE
        step("use module.{a, b} binds exactly the listed names")
        expect(base64_encode("module loading")).to_equal("bW9kdWxlIGxvYWRpbmc=")
        expect(base64_decode("bW9kdWxlIGxvYWRpbmc=") ?? "").to_equal("module loading")

    it "loading the same module twice in one program stays consistent":
        # @req REQ-SSPEC-COMPILER-CORE
        step("repeat import resolves to the same behavior")
        expect("Repeat".to_lower()).to_equal("repeat")
        expect(["x", "y"].join("")).to_equal("xy")

# --- Merged from the legacy mirror copy (unit:compiler_core/interpreter/module_loading_spec.spl), test dedup phase B: tests this copy lacked.

describe "Interpreter Module Loading - Behavioral (merged from legacy copy)":
    it "imports std.common.crypto.sha256 and produces a hex digest":
        # @req REQ-SSPEC-UNIT
        step("hash a fixed input and pin the digest shape")
        val d = sha256_text("module loading")
        expect(d.len()).to_equal(64)
        expect(d.contains("z")).to_equal(false)

    it "imports std.common.math selectively and evaluates it":
        # @req REQ-SSPEC-UNIT
        step("three named imports, three pinned results")
        expect(math_min_i64(4, -7)).to_equal(-7)
        expect(math_clamp_i64(150, 0, 100)).to_equal(100)
        expect(math_sign_i64(-3)).to_equal(-1)

    it "imports a deep sub-module path and uses its symbol":
        # @req REQ-SSPEC-COMPILER-CORE
        step("curly-brace import through two directory levels")
        expect("load".to_upper()).to_equal("LOAD")
