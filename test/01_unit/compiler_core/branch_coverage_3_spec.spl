# @req: REQ-COMPILER-COMPILER_CORE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler_core/branch_coverage_3_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_3.md
# doc-path: doc/03_plan/sys_test/branch_coverage_3.md
# doc-path: doc/04_architecture/branch_coverage_3.md
# doc-path: doc/05_design/branch_coverage_3.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken

    it "boolean value selects via match on true/false":
        step("Verify: boolean value selects via match on true/false")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        val flag = false
        var r = 0
        match flag:
            true: r = 1
            false: r = 2
        expect(r).to_equal(2)  # oracle: false pattern arm

    it "match Some binds the payload":
        step("Verify: match Some binds the payload")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        match Some(5):
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(5)  # oracle: payload bound

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "nested conditionals evaluate inner guard independently":
        step("Verify: nested conditionals evaluate inner guard independently")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if true:
            if false:
                r = 1
            else:
                r = 2
        expect(r).to_equal(2)  # oracle: outer true, inner false

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

    it "for loop body runs once per element":
        step("Verify: for loop body runs once per element")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var c = 0
        for i in 0..3:
            c = c + 1
        expect(c).to_equal(3)  # oracle: three iterations
