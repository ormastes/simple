# @req: REQ-COMPILER-COMPILER_CORE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler_core/branch_coverage_22_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_22.md
# doc-path: doc/03_plan/sys_test/branch_coverage_22.md
# doc-path: doc/04_architecture/branch_coverage_22.md
# doc-path: doc/05_design/branch_coverage_22.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "boolean value selects via match on true/false":
        step("Verify: boolean value selects via match on true/false")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        val flag = false
        var r = 0
        match flag:
            true: r = 1
            false: r = 2
        expect(r).to_equal(2)  # oracle: false pattern arm

    it "nested conditionals evaluate inner guard independently":
        step("Verify: nested conditionals evaluate inner guard independently")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if true:
            if false:
                r = 1
            else:
                r = 2
        expect(r).to_equal(2)  # oracle: outer true, inner false

    it "for loop over empty range runs zero times":
        step("Verify: for loop over empty range runs zero times")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var c = 5
        for i in 2..2:
            c = c + 1
        expect(c).to_equal(5)  # oracle: body never entered

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "break terminates the innermost loop":
        step("Verify: break terminates the innermost loop")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var c = 0
        for i in 0..10:
            if i == 3: break
            c = c + 1
        expect(c).to_equal(3)  # oracle: iterations 0,1,2 counted

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "match nil takes the nil arm":
        step("Verify: match nil takes the nil arm")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 9
        match nil:
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(-1)  # oracle: nil arm
