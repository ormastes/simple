# Regression spec for commit b5c1ec692d0a43e8c5ffabf170862bfc7a181329
# "fix(lexer): use codepoint-indexed source_chars in lex_source_char_at/slice"
#
# lex_source_char_at/lex_source_slice used to slice the raw `text` value
# (BYTE-indexed on this engine) with codepoint indices (cur_start/pos, which
# are indices into source.chars()). Any multi-byte UTF-8 character preceding
# the queried position shifted every subsequent codepoint-index read onto the
# wrong character. In practice this made
# src/compiler/10.frontend/core/_ParserPrimary/primary_expr.spl misread the
# opening quote of a normal double-quoted interpolating string literal
# (`str_first = lex_source_char_at(str_start)`), misclassifying it as a
# non-interpolating raw string, so the whole interpolated literal was emitted
# verbatim (un-substituted) under native-build.

use std.spec.{describe, it, expect, step}
use compiler.core.lexer.{lex_init, lex_source_char_at, lex_source_slice}

describe "lex_source_char_at/lex_source_slice with a preceding multi-byte codepoint":

    it "reads the correct char_at position after a multi-byte em-dash":
        step("source: x, em-dash (1 codepoint, 3 bytes), then a quoted string")
        lex_init("x—\"hi\"")
        step("codepoint 2 is the opening quote; byte-indexing would land 2 bytes short")
        expect(lex_source_char_at(2)).to_equal("\"")
        expect(lex_source_char_at(3)).to_equal("h")

    it "reads the correct slice after a multi-byte codepoint":
        step("codepoints 3..5 are 'hi', the string body")
        lex_init("x—\"hi\"")
        expect(lex_source_slice(3, 5)).to_equal("hi")

    it "handles multiple multi-byte codepoints before the target position":
        step("two multi-byte chars (— and é, 3+2 bytes) precede the quote")
        lex_init("é—\"ok\"")
        expect(lex_source_char_at(2)).to_equal("\"")
        expect(lex_source_slice(3, 5)).to_equal("ok")

    it "leaves plain-ASCII indexing unaffected (regression guard)":
        step("no multi-byte prefix: byte and codepoint indices coincide")
        lex_init("x\"hi\"")
        expect(lex_source_char_at(1)).to_equal("\"")
        expect(lex_source_slice(2, 4)).to_equal("hi")

    it "out-of-range positions still return empty, not a shifted char":
        lex_init("—\"z\"")
        expect(lex_source_char_at(100)).to_equal("")
