# Stage4 regression: parser optional suffixes must not load imported TYPE_OPTION.
# @cover src/compiler/10.frontend/core/parser.spl

use compiler.core.parser.{parse_module, parser_has_errors}
use compiler.core.ast.{ast_reset, module_get_decls, decl_get_ret_type}
use std.spec

fn parse_return_tag(source: text) -> i64:
    ast_reset()
    parse_module(source, "parser_optional_fixed_tag_spec.spl")
    val decls = module_get_decls()
    decl_get_ret_type(decls[0])

describe "parser optional fixed tag":
    it "keeps an optional array return typed":
        val tag = parse_return_tag("fn fresh_tokens() -> [SimpleToken]?:\n    return nil\n")
        expect(parser_has_errors()).to_equal(false)
        # Fixed wire tag; do not import the potentially corrupt module constant.
        expect(tag).to_equal(14)

    it "keeps an optional tuple return typed after tuple parsing":
        val tag = parse_return_tag("fn pair() -> (text, i64)?:\n    return nil\n")
        expect(parser_has_errors()).to_equal(false)
        expect(tag).to_equal(14)
