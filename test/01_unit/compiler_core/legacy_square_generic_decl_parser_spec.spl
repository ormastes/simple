extern fn rt_file_read_text(path: text) -> text

fn read_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "Legacy square generic declaration parser":
    it "accepts a square bracket declaration opener and matching closer":
        val src = read_source("src/compiler/10.frontend/core/_ParserDecls/fn_struct_decls.spl")
        expect(src).to_contain("val has_square: bool = par_kind_get() == 144")
        expect(src).to_contain("val has_generic: bool = has_angle or has_square")
        expect(src).to_contain("if has_square:\n        parser_expect(145)")

    it "keeps canonical and legacy declarations together in the regression fixture":
        val fixture = read_source("test/fixtures/compiler/parser_legacy_square_generic_declarations.spl")
        expect(fixture).to_contain("class LegacyBox[T]:")
        expect(fixture).to_contain("fn wrap[U](value: U) -> [U]:")
        expect(fixture).to_contain("fn legacy_identity[T](value: T) -> T:")
        expect(fixture).to_contain("fn canonical_identity<T>(value: T) -> T:")
