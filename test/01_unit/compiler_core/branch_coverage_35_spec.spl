describe "Optional in Expressions":
    it "optional function in if":
        fn maybe_positive() -> i64?:
            Some(5)

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "optional with default":
        fn might_fail() -> i64?:
            nil

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "optional coalesce with value":
        fn get_optional() -> i64?:
            Some(10)

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

describe "Type Inference for Optionals":
    it "infer from Some":
        val x = Some(42)
        check(x.?)

    it "infer from nil":
        val n: i64? = nil
        check(not n.?)

    it "infer from function":
        fn returns_opt() -> text?:
            Some("hello")

        val s = returns_opt()
        check(s.?)

describe "Long Type Names":
    it "struct with long name":
        struct VeryLongStructNameForTestingBufferLimits:
            value: i64

        val item = VeryLongStructNameForTestingBufferLimits(value: 42)
        check(item.value == 42)

    it "optional of long struct":
        struct AnotherVeryLongNameToTestOptionalHandling:
            id: i64

        val opt: AnotherVeryLongNameToTestOptionalHandling? = nil
        check(not opt.?)

describe "Nested Optional Types":
    it "optional of optional":
        val o1 = Some(Some(42))
        check(o1.?)

    it "optional of optional - nil inner":
        val o2 = Some(nil)
        check(o2.?)

    it "function returning nested optional":
        fn nested_opt() -> i64?:
            Some(100)

        val result = nested_opt()
        check(result.?)

describe "Optional Struct Fields":
    it "struct with optional field":
        struct Record:
            id: i64
            optional_value: i64?

        val r1 = Record(id: 1, optional_value: Some(10))
        val r2 = Record(id: 2, optional_value: nil)

        check(r1.optional_value.?)
        check(not r2.optional_value.?)

describe "Optional in Collections":
    it "array of optionals":
        val arr = [Some(1), nil, Some(3)]
        check(arr[0].?)
        check(not arr[1].?)

    it "optional array":
        val opt_arr = Some([1, 2, 3])
        check(opt_arr.?)

describe "Type Base Extraction":
    it "non-optional type":
        val y: i64 = 42
        check(y == 42)

    it "text type":
        val s: text = "hello"
        check(s == "hello")

    it "bool type":
        val b: bool = true
        check(b)

    it "optional extract via coalesce":
        val x: i64? = Some(42)
        val unwrapped = x ?? 0
        check(unwrapped == 42)
