# @req: REQ-COMPILER-COMPILER_CORE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler_core/branch_coverage_23_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_23.md
# doc-path: doc/03_plan/sys_test/branch_coverage_23.md
# doc-path: doc/04_architecture/branch_coverage_23.md
# doc-path: doc/05_design/branch_coverage_23.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "for loop over empty range runs zero times":
        step("Verify: for loop over empty range runs zero times")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var c = 5
        for i in 2..2:
            c = c + 1
        expect(c).to_equal(5)  # oracle: body never entered

    it "elif second arm wins when first guard fails":
        step("Verify: elif second arm wins when first guard fails")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 9:
            r = 2
        elif 7 > 5:
            r = 3
        expect(r).to_equal(3)  # oracle: later elif evaluated after earlier false

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

    it "else arm runs when all guards fail":
        step("Verify: else arm runs when all guards fail")
        # @req: REQ-COMPILER-COMPILER_CORE-001
        var r = 0
        if 1 > 2:
            r = 1
        elif 2 > 3:
            r = 2
        else:
            r = 9
        expect(r).to_equal(9)  # oracle: terminal else
