"""
## Purpose and audience
Purpose: Prove that Short grammar combined.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-CORE-PARSER-001 — stable requirement identity for this spec.

fn double(x: i64) -> i64: x * 2
fn triple(x: i64) -> i64: x * 3
fn add1(x: i64) -> i64: x + 1
fn square(x: i64) -> i64: x * x

use std.spec.step

describe "Short grammar combined":
    it "pipe into composed function":
        step("Verify: pipe into composed function")
        # @req: REQ-COMPILER-CORE-PARSER-001
        val f = double >> add1
        val result = 3 |> f
        expect(result).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "comprehension piped to function":
        step("Verify: comprehension piped to function")
        val nums = [for i in 0..5: i * i]
        expect(nums).to_equal([0, 1, 4, 9, 16])

    it "pipe chain with multiple functions":
        step("Verify: pipe chain with multiple functions")
        val result = 2 |> double |> triple |> add1
        expect(result).to_equal(13)  # oracle: 13 — named expected value from the requirement

    it "compose chain then pipe":
        step("Verify: compose chain then pipe")
        val transform = add1 >> double >> triple
        val result = 1 |> transform
        expect(result).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "comprehension with filter":
        step("Verify: comprehension with filter")
        val evens = [for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0: x * 10]
        expect(evens).to_equal([20, 40, 60])
