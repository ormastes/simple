"""
## Purpose and audience
Purpose: Prove that Pipe operator |>.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-CORE-PARSER-001 — stable requirement identity for this spec.

fn double(x: i64) -> i64: x * 2
fn triple(x: i64) -> i64: x * 3
fn add(a: i64, b: i64) -> i64: a + b
fn add1(x: i64) -> i64: x + 1

use std.spec.step

describe "Pipe operator |>":
    it "basic pipe":
        step("Verify: basic pipe")
        # @req: REQ-COMPILER-CORE-PARSER-001
        val result = 5 |> double
        expect(result).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "pipe with extra args":
        step("Verify: pipe with extra args")
        val result = 1 |> add(2)
        expect(result).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "chained pipe":
        step("Verify: chained pipe")
        val result = 2 |> double |> triple
        expect(result).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "pipe to add1":
        step("Verify: pipe to add1")
        val result = 10 |> add1
        expect(result).to_equal(11)  # oracle: 11 — named expected value from the requirement

    it "pipe chain three":
        step("Verify: pipe chain three")
        val result = 1 |> add1 |> double |> triple
        expect(result).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "pipe to lambda":
        step("Verify: pipe to lambda")
        val result = 5 |> (\x: x * 3)
        expect(result).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "pipe to placeholder lambda in parens":
        step("Verify: pipe to placeholder lambda in parens")
        val result = 5 |> (_1 * 3)
        expect(result).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "pipe to composed function":
        step("Verify: pipe to composed function")
        val f = double >> triple
        val result = 2 |> f
        expect(result).to_equal(12)  # oracle: 12 — named expected value from the requirement
