# GenArena<T> — generational-index arena (slotmap) handle safety.
#
# The whole point: after free() + reuse, a NEW handle to the recycled slot
# works while the OLD (pre-free) handle is detected as stale and rejected.

"""
## Purpose and audience
Purpose: Verify GenArena<T>.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-GEN-ARENA-001 — stable requirement identity for this spec.

use std.spec
use std.mem.gen_arena.{GenArena, GenHandle}

describe "GenArena<T>":

    it "alloc then get round-trips the stored value":
        step("Verify: alloc then get round-trips the stored value")
        # @req: REQ-LIB-GEN-ARENA-001
        var arena = GenArena<i64>.new()
        val h = arena.alloc(42)
        expect(arena.get(h) ?? -1).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

    it "free then get returns nil":
        step("Verify: free then get returns nil")
        var arena = GenArena<i64>.new()
        val h = arena.alloc(7)
        expect(arena.free(h)).to_equal(true)
        expect(arena.get(h)).to_be_nil()

    it "slot reuse after free mints a new handle; old handle stays stale":
        step("Verify: slot reuse after free mints a new handle; old handle stays stale")
        var arena = GenArena<i64>.new()
        val h_old = arena.alloc(1)
        expect(arena.free(h_old)).to_equal(true)

        val h_new = arena.alloc(2)
        expect(h_new.idx).to_equal(h_old.idx)
        expect(h_new.generation != h_old.generation).to_equal(true)

        # New handle works.
        expect(arena.get(h_new) ?? -1).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        # Old (pre-free) handle to the same slot is rejected, not aliased.
        expect(arena.get(h_old)).to_be_nil()

    it "len() tracks live count across alloc and free":
        step("Verify: len() tracks live count across alloc and free")
        var arena = GenArena<i64>.new()
        expect(arena.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        val h1 = arena.alloc(10)
        expect(arena.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        val h2 = arena.alloc(20)
        expect(arena.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        arena.free(h1)
        expect(arena.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        arena.free(h2)
        expect(arena.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "set on a stale handle returns false and leaves the new value untouched":
        step("Verify: set on a stale handle returns false and leaves the new value untouched")
        var arena = GenArena<i64>.new()
        val h_old = arena.alloc(100)
        arena.free(h_old)
        val h_new = arena.alloc(200)

        expect(arena.set(h_old, 999)).to_equal(false)
        expect(arena.get(h_new) ?? -1).to_equal(200)  # oracle: authoritative expected value documented by this spec's contract

        expect(arena.set(h_new, 201)).to_equal(true)
        expect(arena.get(h_new) ?? -1).to_equal(201)  # oracle: authoritative expected value documented by this spec's contract
