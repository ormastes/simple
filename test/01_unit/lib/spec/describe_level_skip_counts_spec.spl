"""
# a describe-level skip is carried into the file verdict

`skip(name, reason)` at describe level prints `... skipped (reason)`, which the
Simple test runner counts into its `Results:` line, but the seed interpreter
recorded nothing for it, so the `SPEC FILE VERDICT` line said `skipped=0` while
`Results:` said `1 skipped`. The two lines must agree: one skipped, one passed,
and the skip must never be counted as a pass.
"""

use std.spec.*

describe "describe-level skip":
    skip("needs a device that this host does not have", "capability probe: no device")

    it "is a real passing example":
        expect(2 * 2).to_equal(4)
