# Regression: the nil-family matchers must treat `Option::None` as nil.
#
# `nil` has TWO runtime representations: the bare `nil` literal (Value::Nil) and
# `Option::None`, which is what a `T?`-returning function yields for `return nil`.
# `== nil` and `expect(x).to_be_nil()` already accepted both; `assert_nil` /
# `assert_not_nil` compared against the bare literal only, so a correct
# `Option::None` result was rejected with "assert_nil failed: got Option::None"
# (lane DBDUR, test/system/database/server/db_server_tier_spec.spl:114).
#
# The matchers must stay STRICT: this is not a truthiness check. `Some(_)`,
# `0`, `false` and `""` are all NOT nil.

fn none_i64() -> Option<i64>:
    return None

fn some_i64() -> Option<i64>:
    return Some(7)

fn bare_nil():
    return nil

describe "assert_nil accepts both nil representations":
    it "accepts the bare nil literal":
        assert_nil(bare_nil())

    it "accepts a typed Option::None":
        assert_nil(none_i64())

    it "agrees with == nil on Option::None":
        val v = none_i64()
        assert_true(v == nil)

    it "agrees with expect(...).to_be_nil() on Option::None":
        expect(none_i64()).to_be_nil()

describe "assert_nil stays strict about non-nil values":
    it "does not treat Some(_) as nil":
        assert_true(some_i64() != nil)

    it "does not treat zero as nil":
        assert_true(0 != nil)

    it "does not treat false as nil":
        assert_true(false != nil)

    it "does not treat the empty string as nil":
        assert_true("" != nil)

describe "assert_not_nil is the exact mirror of assert_nil":
    it "accepts a present Some(_)":
        assert_not_nil(some_i64())

    it "accepts zero (zero is present, not absent)":
        assert_not_nil(0)

    it "accepts the empty string":
        assert_not_nil("")

describe "nil-vs-nil comparison yields a strict boolean, not nil":
    # Regression guard for
    # doc/08_tracking/bug/expect_nil_not_equal_nil_boolean_coercion_2026-07-20.md:
    # `nil != nil` was reported to propagate `nil` as its own falsy result
    # instead of boolean `false`, so an explicit `.to_equal(false)` failed with
    # "expected nil to not equal nil".  The comparison must produce a real
    # `bool` even when BOTH sides are absent.
    #
    # These are non-vacuous only because the matcher is strict about nil (the
    # block below proves it): if `x != nil` returned `nil` rather than `false`,
    # `.to_equal(false)` would fail rather than silently pass.
    it "Option::None != nil is boolean false":
        val v = none_i64()
        expect(v != nil).to_equal(false)

    it "Option::None == nil is boolean true":
        val v = none_i64()
        expect(v == nil).to_equal(true)

    it "the bare nil literal != nil is boolean false":
        val v = bare_nil()
        expect(v != nil).to_equal(false)

    it "Some(_) != nil is boolean true (the passing sibling case)":
        val v = some_i64()
        expect(v != nil).to_equal(true)

describe "the matcher never coerces nil to a boolean":
    # If any of these were to pass, every `.to_equal(false)` guard above would
    # be vacuous — a nil-valued expression would satisfy them by coercion.
    it "Option::None is not equal to false":
        expect(none_i64()).to_not_equal(false)

    it "Option::None is not equal to true":
        expect(none_i64()).to_not_equal(true)

    it "Option::None is not equal to zero":
        expect(none_i64()).to_not_equal(0)

    it "false is not equal to zero":
        expect(false).to_not_equal(0)

describe "a failed assertion does not hide later examples in the file":
    # A single failure must never abort the rest of the file — that converts one
    # red into silently unobserved coverage.  These three run after the strictness
    # block above and are the canary for that behaviour.
    it "later example 1 is still observed":
        assert_equal(1, 1)

    it "later example 2 is still observed":
        assert_equal(2, 2)

    it "later example 3 is still observed":
        assert_equal(3, 3)
