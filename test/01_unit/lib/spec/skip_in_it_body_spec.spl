"""
# skip() inside an it block is reported as skipped, never as a pass

skip(name, reason) is a declaration, a sibling of `it`. Live specs also call it
from inside an example body to bail out when their environment is missing
(`if not live: skip(...); return`). The seed's `it` handler
(interpreter_call/bdd.rs) left an in-body skip alone, so the example printed a
green check and counted as PASSED. The handler now records it as skipped. See doc/08_tracking/bug/spec_skip_reported_as_pass_2026-11-19.md.

This file has one real passing example and two examples that skip in their
body, one of them before an expect that would fail. Skip wins, so the verdict
must say passed=1 skipped=2 failed=0. Before the fix it said passed=2 failed=1.
"""

use std.spec.*

describe "skip inside it":
    it "is a real passing example":
        expect(1 + 1).to_equal(2)

    it "is only skipped, not passed":
        skip("is only skipped, not passed", "environment gate closed for this example")
        return

    it "stays skipped when a failing expect follows the skip":
        skip("stays skipped when a failing expect follows the skip", "environment gate closed for this example")
        expect(1).to_equal(2)
