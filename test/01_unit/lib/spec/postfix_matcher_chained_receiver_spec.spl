# Bug ml_kem_postfix_to_equal_chained_call_not_found_2026-07-20:
# postfix `.to_equal(...)` must resolve when its receiver is a chained call.

fn three() -> [i64]:
    [7, 8, 9]

describe "postfix matcher on chained-call receiver":
    it "resolves on array.len()":
        val xs = [1, 2, 3]
        xs.len().to_equal(3)

    it "resolves on fn().len()":
        three().len().to_equal(3)

    it "resolves on indexed get chain":
        val xs = [4, 5]
        xs.get(0).to_equal(4)

    it "resolves to_be on chained text call":
        "abc".len().to_be(3)

    it "resolves on direct call (sibling)":
        three().to_equal([7, 8, 9])

    it "resolves to_not_equal on chained call":
        val xs = [1, 2, 3]
        xs.len().to_not_equal(4)
