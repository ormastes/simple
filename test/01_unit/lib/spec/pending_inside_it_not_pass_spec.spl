"""
# pending() inside an it block is reported as pending, never as a pass

The pure-Simple runner (spec.spl _execute_it) returns "pending" when the
pending counter moved during the block and no assertion failed. The seed
interpreter's `it` handler (interpreter_call/bdd.rs) ignored that counter, so
the example printed a green check and counted as PASSED. This file carries one
real passing example and one pending example: the verdict must say passed=1,
and the pending example must never appear as a pass.
"""

use std.spec.*

describe "pending inside it":
    it "is a real passing example":
        expect(1 + 1).to_equal(2)

    it "is only pending, not passed":
        pending("waiting on the feature under test")
