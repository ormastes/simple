"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/lib/std/language/mixin_spec.spl` and require the final Results line to report 0 failed.

## Features

- **Field composition**: Add fields from mixins to classes
- **Method composition**: Add methods from mixins to classes
- **Generic mixins**: Parameterize mixins with type variables
- **Multiple mixins**: Apply multiple mixins to a single class
- **Type safety**: Full type checking and inference for mixin usage
"""

use std.spec.step

mixin Timestamp:
    var created_at: i64
    var updated_at: i64

mixin Logger:
    var log_level: i32

    fn log(self, message: text) -> text:
        return "level=" + self.log_level.to_text() + " msg=" + message

mixin Box<T>:
    var value: T

    fn boxed(self) -> text:
        return "boxed:" + self.value.to_text()

class User:
    use Timestamp
    var name: text

class Service:
    use Logger
    var name: text

class Document:
    use Timestamp
    use Logger
    var content: text

class IntBox:
    use Box<i64>

describe "Mixin - Basic Declaration":
    it "composes mixin fields into a class":
        # @req REQ-SSPEC-UNIT
        val u = User()
        u.name = "bob"
        u.created_at = 7
        u.updated_at = 9
        expect(u.name).to_equal("bob")
        expect(u.created_at + u.updated_at).to_equal(16)

describe "Mixin - Method Declaration":
    it "calls a method defined on the mixin through the class":
        # @req REQ-SSPEC-UNIT
        val s = Service()
        s.log_level = 3
        expect(s.log("hello")).to_equal("level=3 msg=hello")

describe "Mixin - Generic Parameters":
    it "substitutes the concrete type into a generic mixin":
        # @req REQ-SSPEC-UNIT
        val b = IntBox()
        b.value = 41
        expect(b.boxed()).to_equal("boxed:41")
        expect(b.value + 1).to_equal(42)

describe "Mixin - Class Application":
    it "applies a mixin to a class with the use keyword":
        # @req REQ-SSPEC-UNIT
        val u = User()
        u.created_at = 100
        expect(u.created_at).to_equal(100)

describe "Mixin - Multiple Composition":
    it "composes two mixins into one class independently":
        # @req REQ-SSPEC-UNIT
        val d = Document()
        d.created_at = 1
        d.log_level = 2
        d.content = "txt"
        expect(d.log(d.content)).to_equal("level=2 msg=txt")
        expect(d.created_at).to_equal(1)

describe "Mixin - Type Inference":
    it "keeps distinct inferred types per mixin field":
        # @req REQ-SSPEC-UNIT
        val d = Document()
        d.created_at = 5
        d.log_level = 5
        expect(d.created_at).to_equal(d.log_level)
        expect((d.created_at + 1).to_text()).to_equal("6")
