# @manual_section: async-io
describe "AsyncIO":
    it "should create async I/O runtime":
        # @req REQ-ASYNC-IO-001
        # @capture(statistics): task count of a fresh AsyncIO runtime's executor
        step("Construct a fresh AsyncIO runtime")
        val io = AsyncIO.new()
        expect(io.executor.task_count()).to_equal(0)  # oracle: a fresh runtime's executor holds no tasks

    it "should create yield future":
        # @req REQ-ASYNC-IO-002
        # @capture(statistics): ready state and value of a yield_now future
        step("Request a yield_now future from a fresh AsyncIO runtime")
        val f = AsyncIO.new().yield_now()
        expect(f.is_ready()).to_equal(true)
        expect(f.poll().unwrap()).to_equal(0)  # oracle: yield_now resolves with sentinel value 0

    it "should create sleep future":
        # @req REQ-ASYNC-IO-003
        # @capture(statistics): ready state and value of a sleep future
        step("Request a 25-millisecond sleep future from a fresh AsyncIO runtime")
        val f = AsyncIO.new().sleep(25)
        expect(f.is_ready()).to_equal(true)
        expect(f.poll().unwrap()).to_equal(25)  # oracle: sleep echoes back the requested duration, 25ms

