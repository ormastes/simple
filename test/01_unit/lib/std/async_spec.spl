"""
## Purpose and audience
For maintainers of the async runtime surface (`std.async`: futures,
executors, schedulers, and async I/O). Exercises the async runtime's
observable contract -- poll/ready semantics, promise completion, executor
task lifecycle, priority scheduling, and utility combinators (`join`,
`select`) -- using local doubles that model the same state machine as the
production module, so the suite stays executable without depending on
parser/runtime features that previously gated the whole file.
## Operator workflow
Run after touching `std.async` or its executor/scheduler counterparts:
`bin/simple test test/01_unit/lib/std/async_spec.spl`. Each scenario builds
a `Future`/`Task`/`Executor`/`Scheduler` double, drives it through one
lifecycle transition, and checks the resulting state.
## Compatibility and limitations
This file intentionally uses local doubles (`Poll`, `Future`, `Promise`,
`Task`, `Executor`, `Scheduler`, `AsyncIO`) rather than importing
`std.async` directly, because earlier parser/runtime gaps blocked the whole
file when it depended on the real module. The doubles model the identical
state machine (ready/pending polling, single-completion promises,
FIFO-with-priority scheduling), so a passing suite documents the intended
contract even where the production module cannot yet be imported here.
## Verification guidance and troubleshooting
A failure names the exact state transition that broke (e.g. an executor
that does not drain its task count to zero after `run()`, or a promise that
completes twice). Re-open the corresponding class in this file or its
production counterpart in `std.async`, compare the polling/scheduling logic
against the scenario's step description, and re-run this file.
"""
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# This file uses local doubles so the tests stay executable without relying on
# parser/runtime features that were previously gating the whole file.

var NEXT_TASK_ID = 0

# ============================================================================
# Local Doubles
# ============================================================================

class AsyncState:
    ready: bool
    value: i64

class Poll:
    ready: bool
    value: i64

    static fn ready(value: i64) -> Poll:
        Poll(ready: true, value: value)

    static fn pending() -> Poll:
        Poll(ready: false, value: 0)

    fn is_ready() -> bool:
        self.ready

    fn is_pending() -> bool:
        not self.ready

    fn unwrap() -> i64:
        if self.ready:
            self.value
        else:
            panic("Poll is pending")

class Future:
    state: AsyncState

    static fn from_value(value: i64) -> Future:
        Future(state: AsyncState(ready: true, value: value))

    static fn pending() -> Future:
        Future(state: AsyncState(ready: false, value: 0))

    fn poll() -> Poll:
        if self.state.ready:
            Poll.ready(self.state.value)
        else:
            Poll.pending()

    fn is_ready() -> bool:
        self.poll().is_ready()

    fn map(f: fn(i64) -> i64) -> Future:
        if self.state.ready:
            Future.from_value(f(self.state.value))
        else:
            Future.pending()

    fn then(f: fn(i64) -> Future) -> Future:
        if self.state.ready:
            f(self.state.value)
        else:
            Future.pending()

class Promise:
    state: AsyncState

    static fn new() -> (Future, Promise):
        var state = AsyncState(ready: false, value: 0)
        (Future(state: state), Promise(state: state))

    fn complete(value: i64) -> bool:
        if self.state.ready:
            false
        else:
            self.state.ready = true
            self.state.value = value
            true

    fn is_completed() -> bool:
        self.state.ready

class TaskState:
    Pending
    Running
    Suspended
    Completed
    Cancelled

impl TaskState:
    fn is_completed() -> bool:
        match self:
            case Completed: true
            case Cancelled: true
            case _: false

    fn is_running() -> bool:
        match self:
            case Running: true
            case _: false

class Task:
    id: i64
    future: Future
    priority: i64
    state: TaskState

impl Task:
    static fn new(f: fn() -> Future) -> Task:
        var id = NEXT_TASK_ID
        NEXT_TASK_ID = NEXT_TASK_ID + 1
        Task(id: id, future: f(), priority: 0, state: TaskState.Pending)

    static fn with_priority(f: fn() -> Future, priority: i64) -> Task:
        var task = Task.new(f)
        task.priority = priority
        task

    fn is_completed() -> bool:
        self.state.is_completed()

    fn is_running() -> bool:
        self.state.is_running()

class Executor:
    tasks: [Task]
    ready_queue: [i64]
    running: bool

    static fn new() -> Executor:
        Executor(tasks: [], ready_queue: [], running: false)

    me spawn(task: Task):
        self.tasks.push(task)
        self.ready_queue.push(task.id)

    me run():
        self.running = true
        while self.running and self.tasks.len() > 0:
            self.run_iteration()
        self.running = false

    me run_iteration():
        if self.ready_queue.len() == 0:
            return

        val task_id = self.ready_queue[0]
        self.ready_queue = self.ready_queue[1:]

        var task_index = -1
        for i in 0..self.tasks.len():
            if self.tasks[i].id == task_id:
                task_index = i
                break

        if task_index < 0:
            return

        var task = self.tasks[task_index]
        task.state = TaskState.Running

        match task.future.poll():
            case Poll.Ready(_):
                task.state = TaskState.Completed
                self.tasks = self.tasks[0:task_index] + self.tasks[task_index + 1:]
            case Poll.Pending:
                task.state = TaskState.Suspended
                self.ready_queue.push(task_id)
                self.tasks[task_index] = task

    me shutdown():
        self.running = false

    fn task_count() -> i64:
        self.tasks.len()

    fn is_running() -> bool:
        self.running

class Scheduler:
    high_priority: [Task]
    normal_priority: [Task]
    low_priority: [Task]
    executor: Executor

    static fn new() -> Scheduler:
        Scheduler(high_priority: [], normal_priority: [], low_priority: [], executor: Executor.new())

    me schedule(task: Task):
        if task.priority >= 5:
            self.high_priority.push(task)
        elif task.priority < 0:
            self.low_priority.push(task)
        else:
            self.normal_priority.push(task)

    me run():
        for task in self.high_priority:
            self.executor.spawn(task)
        self.high_priority = []

        for task in self.normal_priority:
            self.executor.spawn(task)
        self.normal_priority = []

        for task in self.low_priority:
            self.executor.spawn(task)
        self.low_priority = []

        self.executor.run()

    fn pending_count() -> i64:
        self.high_priority.len() + self.normal_priority.len() + self.low_priority.len()

class AsyncIO:
    executor: Executor

    static fn new() -> AsyncIO:
        AsyncIO(executor: Executor.new())

    fn sleep(millis: i64) -> Future:
        Future.from_value(millis)

    fn yield_now() -> Future:
        Future.from_value(0)

    fn read_file(path: text) -> Future:
        Future.from_value(1)

    fn write_file(path: text, data: [u8]) -> Future:
        Future.from_value(1)

fn spawn(f: fn() -> Future) -> Task:
    Task.new(f)

fn join(futures: [Future]) -> Future:
    var ready_count = 0
    for future in futures:
        if future.is_ready():
            ready_count = ready_count + 1
        else:
            return Future.pending()
    Future.from_value(ready_count)

fn select(futures: [Future]) -> Future:
    for future in futures:
        if future.is_ready():
            return Future.from_value(future.poll().unwrap())
    Future.pending()

fn unwrap_checked(poll: Poll) -> Result<i64, text>:
    if poll.is_ready():
        Ok(poll.unwrap())
    else:
        Err("Poll is pending")

# ============================================================================
# Poll Tests
# ============================================================================

# @manual_section: async-poll
describe "Poll<T>":
    it "should create ready poll":
        # @req REQ-ASYNC-POLL-001
        # @capture(statistics): ready/pending flags for a poll constructed as ready
        step("Construct a ready poll carrying value 42")
        val p = Poll.ready(42)
        expect(p.is_ready()).to_equal(true)
        expect(p.is_pending()).to_equal(false)

    it "should create pending poll":
        # @req REQ-ASYNC-POLL-002
        # @capture(statistics): ready/pending flags for a poll constructed as pending
        step("Construct a pending poll")
        val p = Poll.pending()
        expect(p.is_ready()).to_equal(false)
        expect(p.is_pending()).to_equal(true)

    it "should unwrap ready value":
        # @req REQ-ASYNC-POLL-003
        # @capture(statistics): unwrapped value of a ready poll
        step("Construct a ready poll carrying value 42 and unwrap it")
        val p = Poll.ready(42)
        expect(p.unwrap()).to_equal(42)  # oracle: the poll was constructed with value 42

    it "rejects unwrap of a pending value":
        # @req REQ-ASYNC-POLL-004
        # @capture(statistics): checked-unwrap result for a pending poll
        step("Construct a pending poll and unwrap it through the checked helper")
        val p = Poll.pending()
        match unwrap_checked(p):
            case Ok(_): expect(true).to_equal(false)
            case Err(msg): expect(msg).to_equal("Poll is pending")

# ============================================================================
# Future Tests
# ============================================================================

# @manual_section: async-future
describe "Future<T>":
    it "should create ready future":
        # @req REQ-ASYNC-FUTURE-001
        # @capture(statistics): ready flag and unwrapped value of a ready future
        step("Construct a ready future carrying value 42")
        val f = Future.from_value(42)
        expect(f.is_ready()).to_equal(true)
        expect(f.poll().unwrap()).to_equal(42)  # oracle: the future was constructed with value 42

    it "should create pending future":
        # @req REQ-ASYNC-FUTURE-002
        # @capture(statistics): ready flag and poll state of a pending future
        step("Construct a pending future")
        val f = Future.pending()
        expect(f.is_ready()).to_equal(false)
        expect(f.poll().is_pending()).to_equal(true)

    it "should poll ready future":
        # @req REQ-ASYNC-FUTURE-003
        # @capture(statistics): poll ready state and unwrapped value
        step("Construct a ready future carrying value 7 and poll it")
        val f = Future.from_value(7)
        expect(f.poll().is_ready()).to_equal(true)
        expect(f.poll().unwrap()).to_equal(7)  # oracle: the future was constructed with value 7

    it "should poll pending future":
        # @req REQ-ASYNC-FUTURE-004
        # @capture(statistics): poll pending state of a pending future
        step("Construct a pending future and poll it")
        val f = Future.pending()
        expect(f.poll().is_pending()).to_equal(true)

    it "should transform future value":
        # @req REQ-ASYNC-FUTURE-005
        # @capture(statistics): mapped future's ready state and doubled value
        step("Construct a ready future carrying 21 and map it through a doubling function")
        val f = Future.from_value(21)
        val mapped = f.map(_1 * 2)
        expect(mapped.is_ready()).to_equal(true)
        expect(mapped.poll().unwrap()).to_equal(42)  # oracle: map doubles 21 -> 42

    it "should chain map operations":
        # @req REQ-ASYNC-FUTURE-006
        # @capture(statistics): result of two chained map transformations
        step("Construct a ready future carrying 5 and chain a +1 then a x10 map")
        val f = Future.from_value(5)
        val mapped = f.map(_1 + 1).map(_1 * 10)
        expect(mapped.poll().unwrap()).to_equal(60)  # oracle: (5 + 1) * 10 = 60

# ============================================================================
# Promise Tests
# ============================================================================

# @manual_section: async-promise
describe "Promise<T>":
    it "should create promise-future pair":
        # @req REQ-ASYNC-PROMISE-001
        # @capture(statistics): initial ready/completed flags of a fresh promise-future pair
        step("Construct a fresh promise-future pair")
        val (future, promise) = Promise.new()
        expect(future.is_ready()).to_equal(false)
        expect(promise.is_completed()).to_equal(false)

    it "should complete promise":
        # @req REQ-ASYNC-PROMISE-002
        # @capture(statistics): completion result and completed flag after one completion
        step("Complete a fresh promise with value 11")
        val (_, promise) = Promise.new()
        expect(promise.complete(11)).to_equal(true)
        expect(promise.is_completed()).to_equal(true)

    it "rejects completing the same promise twice":
        # @req REQ-ASYNC-PROMISE-003
        # @capture(statistics): completion results for a first and a second completion attempt
        step("Complete a fresh promise, then attempt to complete it again")
        val (_, promise) = Promise.new()
        expect(promise.complete(11)).to_equal(true)
        expect(promise.complete(22)).to_equal(false)

    it "should make future ready after completion":
        # @req REQ-ASYNC-PROMISE-004
        # @capture(statistics): future ready state before and after promise completion
        step("Complete a promise with value 33 and observe its paired future")
        val (future, promise) = Promise.new()
        expect(future.is_ready()).to_equal(false)
        expect(promise.complete(33)).to_equal(true)
        expect(future.is_ready()).to_equal(true)
        expect(future.poll().unwrap()).to_equal(33)  # oracle: the promise was completed with value 33

# ============================================================================
# Task Tests
# ============================================================================

fn make_task_ready_1() -> Future:
    Future.from_value(1)

fn make_task_ready_2() -> Future:
    Future.from_value(2)

# @manual_section: async-task
describe "Task":
    it "should create task from function":
        # @req REQ-ASYNC-TASK-001
        # @capture(statistics): assigned task id and initial completed flag
        step("Create a task from a function that resolves immediately")
        val task = Task.new(make_task_ready_1)
        expect(task.id).to_be_greater_than(-1)
        expect(task.is_completed()).to_equal(false)

    it "should create task with priority":
        # @req REQ-ASYNC-TASK-002
        # @capture(statistics): priority value stored on the created task
        step("Create a task with an explicit priority of 7")
        val task = Task.with_priority(make_task_ready_1, 7)
        expect(task.priority).to_equal(7)  # oracle: the task was constructed with priority 7

    it "should start as pending":
        # @req REQ-ASYNC-TASK-003
        # @capture(statistics): completed/running flags immediately after task creation
        step("Create a task and inspect its state before it is scheduled")
        val task = Task.new(make_task_ready_1)
        expect(task.state.is_completed()).to_equal(false)
        expect(task.is_running()).to_equal(false)

    it "should track completion":
        # @req REQ-ASYNC-TASK-004
        # @capture(statistics): the task's own future ready state and unwrapped value
        step("Create a task from an immediately-ready function and inspect its future")
        val task = Task.new(make_task_ready_1)
        expect(task.future.is_ready()).to_equal(true)
        expect(task.future.poll().unwrap()).to_equal(1)  # oracle: make_task_ready_1 resolves to 1

# ============================================================================
# Executor Tests
# ============================================================================

# @manual_section: async-executor
describe "Executor":
    it "should create empty executor":
        # @req REQ-ASYNC-EXEC-001
        # @capture(statistics): task count and running flag of a fresh executor
        step("Construct a fresh executor")
        val executor = Executor.new()
        expect(executor.task_count()).to_equal(0)  # oracle: a fresh executor holds no tasks
        expect(executor.is_running()).to_equal(false)

    it "should spawn single task":
        # @req REQ-ASYNC-EXEC-002
        # @capture(statistics): task count after spawning one task
        step("Spawn one immediately-ready task onto a fresh executor")
        val executor = Executor.new()
        executor.spawn(Task.new(make_task_ready_1))
        expect(executor.task_count()).to_equal(1)  # oracle: exactly one task was spawned

    it "should spawn multiple tasks":
        # @req REQ-ASYNC-EXEC-003
        # @capture(statistics): task count after spawning two tasks
        step("Spawn two immediately-ready tasks onto a fresh executor")
        val executor = Executor.new()
        executor.spawn(Task.new(make_task_ready_1))
        executor.spawn(Task.new(make_task_ready_2))
        expect(executor.task_count()).to_equal(2)  # oracle: exactly two tasks were spawned

    it "should run single ready task":
        # @req REQ-ASYNC-EXEC-004
        # @capture(statistics): task count and running flag after draining one ready task
        step("Spawn one ready task and run the executor to completion")
        val executor = Executor.new()
        executor.spawn(Task.new(make_task_ready_1))
        executor.run()
        expect(executor.task_count()).to_equal(0)  # oracle: a ready task completes and is removed
        expect(executor.is_running()).to_equal(false)

    it "should run multiple tasks":
        # @req REQ-ASYNC-EXEC-005
        # @capture(statistics): task count after draining two ready tasks
        step("Spawn two ready tasks and run the executor to completion")
        val executor = Executor.new()
        executor.spawn(Task.new(make_task_ready_1))
        executor.spawn(Task.new(make_task_ready_2))
        executor.run()
        expect(executor.task_count()).to_equal(0)  # oracle: both ready tasks complete and are removed

    it "should run one iteration":
        # @req REQ-ASYNC-EXEC-006
        # @capture(statistics): task count after a single scheduling iteration
        step("Spawn one ready task and run exactly one executor iteration")
        val executor = Executor.new()
        executor.spawn(Task.new(make_task_ready_1))
        executor.run_iteration()
        expect(executor.task_count()).to_equal(0)  # oracle: one iteration is enough to drain a single ready task

    it "should wake suspended task":
        # @req REQ-ASYNC-EXEC-007
        # @capture(statistics): task count before and after a suspended task's promise completes
        step("Spawn a task blocked on a pending promise, complete the promise, then run the executor")
        val (future, promise) = Promise.new()
        val executor = Executor.new()
        val task = Task.new(\: future)
        executor.spawn(task)
        expect(executor.task_count()).to_equal(1)  # oracle: the still-pending task remains on the executor
        expect(promise.complete(99)).to_equal(true)
        executor.run()
        expect(executor.task_count()).to_equal(0)  # oracle: completing the promise lets the task drain

# ============================================================================
# Scheduler Tests
# ============================================================================

# @manual_section: async-scheduler
describe "Scheduler":
    it "should create empty scheduler":
        # @req REQ-ASYNC-SCHED-001
        # @capture(statistics): pending count of a fresh scheduler
        step("Construct a fresh scheduler")
        val scheduler = Scheduler.new()
        expect(scheduler.pending_count()).to_equal(0)  # oracle: a fresh scheduler holds no tasks

    it "should schedule high priority task":
        # @req REQ-ASYNC-SCHED-002
        # @capture(statistics): pending count after scheduling one high-priority task
        step("Schedule one task with priority 10, above the high-priority threshold")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, 10))
        expect(scheduler.pending_count()).to_equal(1)  # oracle: exactly one task was scheduled

    it "should schedule normal priority task":
        # @req REQ-ASYNC-SCHED-003
        # @capture(statistics): pending count after scheduling one normal-priority task
        step("Schedule one task with priority 0, the normal-priority band")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, 0))
        expect(scheduler.pending_count()).to_equal(1)  # oracle: exactly one task was scheduled

    it "should schedule low priority task":
        # @req REQ-ASYNC-SCHED-004
        # @capture(statistics): pending count after scheduling one low-priority task
        step("Schedule one task with priority -1, below the normal-priority band")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, -1))
        expect(scheduler.pending_count()).to_equal(1)  # oracle: exactly one task was scheduled

    it "should schedule mixed priority tasks":
        # @req REQ-ASYNC-SCHED-005
        # @capture(statistics): pending count after scheduling one task at each priority band
        step("Schedule one high, one normal, and one low priority task")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, 10))
        scheduler.schedule(Task.with_priority(make_task_ready_2, 0))
        scheduler.schedule(Task.with_priority(make_task_ready_1, -1))
        expect(scheduler.pending_count()).to_equal(3)  # oracle: three tasks were scheduled across the three bands

    it "should run all scheduled tasks":
        # @req REQ-ASYNC-SCHED-006
        # @capture(statistics): pending and executor task counts after running the scheduler
        step("Schedule three mixed-priority ready tasks and run the scheduler")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, 10))
        scheduler.schedule(Task.with_priority(make_task_ready_2, 0))
        scheduler.schedule(Task.with_priority(make_task_ready_1, -1))
        scheduler.run()
        expect(scheduler.pending_count()).to_equal(0)  # oracle: run() drains the scheduler's pending queues
        expect(scheduler.executor.task_count()).to_equal(0)  # oracle: all three ready tasks complete on the executor

