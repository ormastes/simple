# @manual_section: async-integration
describe "Integration":
    it "should complete async workflow":
        # @req REQ-ASYNC-INTEGRATION-001
        # @capture(statistics): future readiness before/after completion and its resolved value
        step("Complete a promise with value 123 and observe its paired future")
        val (future, promise) = Promise.new()
        expect(future.is_ready()).to_equal(false)
        expect(promise.complete(123)).to_equal(true)
        expect(future.poll().unwrap()).to_equal(123)  # oracle: the promise was completed with value 123

    it "should execute task to completion":
        # @req REQ-ASYNC-INTEGRATION-002
        # @capture(statistics): executor task count and an unrelated promise's completed flag
        step("Spawn an inline-future task and run it to completion on the executor")
        val executor = Executor.new()
        val (_, promise) = Promise.new()
        val task = Task.new(\: Future.from_value(1))
        executor.spawn(task)
        executor.run()
        expect(executor.task_count()).to_equal(0)  # oracle: the ready task completes and is removed
        expect(promise.is_completed()).to_equal(false)

    it "should run high priority first":
        # @req REQ-ASYNC-INTEGRATION-003
        # @capture(statistics): pending count after the scheduler runs a high- and normal-priority task
        step("Schedule a high-priority and a normal-priority ready task, then run the scheduler")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, 10))
        scheduler.schedule(Task.with_priority(make_task_ready_2, 0))
        scheduler.run()
        expect(scheduler.pending_count()).to_equal(0)  # oracle: run() drains both scheduled tasks

    it "should chain future transformations":
        # @req REQ-ASYNC-INTEGRATION-004
        # @capture(statistics): resolved value after a map-then-then chain
        step("Chain a +2 map, then a x4 then-continuation, on a future carrying 3")
        val f = Future.from_value(3)
        val chained = f.map(_1 + 2).then(Future.from_value(_1 * 4))
        expect(chained.poll().unwrap()).to_equal(20)  # oracle: (3 + 2) * 4 = 20

# ============================================================================
# Use Cases
# ============================================================================

# @manual_section: async-use-cases
describe "Use Cases":
    it "should compute value asynchronously":
        # @req REQ-ASYNC-USECASE-001
        # @capture(statistics): completion result, future readiness, and resolved value
        step("Complete a promise with value 88 and read its paired future")
        val (future, promise) = Promise.new()
        expect(promise.complete(88)).to_equal(true)
        expect(future.is_ready()).to_equal(true)
        expect(future.poll().unwrap()).to_equal(88)  # oracle: the promise was completed with value 88

    it "should run multiple tasks concurrently":
        # @req REQ-ASYNC-USECASE-002
        # @capture(statistics): executor task count after concurrently running two tasks
        step("Spawn two ready tasks and run the executor")
        val executor = Executor.new()
        executor.spawn(Task.new(make_task_ready_1))
        executor.spawn(Task.new(make_task_ready_2))
        executor.run()
        expect(executor.task_count()).to_equal(0)  # oracle: both ready tasks complete and are removed

    it "should prioritize urgent tasks":
        # @req REQ-ASYNC-USECASE-003
        # @capture(statistics): pending count after scheduling two urgent tasks
        step("Schedule two above-normal-priority tasks (10 and 1)")
        val scheduler = Scheduler.new()
        scheduler.schedule(Task.with_priority(make_task_ready_1, 10))
        scheduler.schedule(Task.with_priority(make_task_ready_2, 1))
        expect(scheduler.pending_count()).to_equal(2)  # oracle: both scheduled tasks are still pending

    it "should delay execution with promise":
        # @req REQ-ASYNC-USECASE-004
        # @capture(statistics): future readiness before/after promise completion
        step("Complete a promise with value 9 and observe its paired future")
        val (future, promise) = Promise.new()
        expect(future.is_ready()).to_equal(false)
        expect(promise.complete(9)).to_equal(true)
        expect(future.is_ready()).to_equal(true)
