# @manual_section: async-utility
describe "Utility Functions":
    it "should spawn task":
        # @req REQ-ASYNC-UTIL-001
        # @capture(statistics): completed flag and resolved value of a spawned task
        step("Spawn a task via the top-level spawn() helper")
        val task = spawn(make_task_ready_1)
        expect(task.is_completed()).to_equal(false)
        expect(task.future.poll().unwrap()).to_equal(1)  # oracle: make_task_ready_1 resolves to 1

    it "should join multiple futures":
        # @req REQ-ASYNC-UTIL-002
        # @capture(statistics): ready state and value of the joined future
        step("Join two already-ready futures")
        val joined = join([Future.from_value(1), Future.from_value(2)])
        expect(joined.is_ready()).to_equal(true)
        expect(joined.poll().unwrap()).to_equal(2)  # oracle: join resolves to the count of ready futures, 2

    it "should select first ready future":
        # @req REQ-ASYNC-UTIL-003
        # @capture(statistics): ready state and value of the selected future
        step("Select between one pending and one ready future")
        val selected = select([Future.pending(), Future.from_value(7)])
        expect(selected.is_ready()).to_equal(true)
        expect(selected.poll().unwrap()).to_equal(7)  # oracle: the only ready candidate carries value 7

