# DSL Features Tests

use std.spec.*
use std.core.dsl.*

describe "Context blocks":
    it "provides context-aware building":
        val builder = ContextBuilder.new()
        expect builder.is_empty() == true

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

describe "Method missing":
    it "handles undefined methods":
        var called_name = ""
        var called_args = []

    it "collections keep insertion order and value semantics":
        step("Verify: collections keep insertion order and value semantics")
        # @req: REQ-LIB-LIB_GENERIC-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows by one
        expect(original.len()).to_equal(2)  # oracle: the original binding is unmodified

    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits

    it "enables dynamic proxies":
        val handler = \name, args: "handled"
        val proxy = DynamicProxy.new(handler)

        expect proxy.has_handler() == true
        val result = proxy.call_handler("any_method", [])
        expect result == "handled"

    it "supports attribute dictionaries":
        val obj = AttributeDict.new()
        expect obj.is_empty() == true

        obj.__setattr__("name", "Alice")
        val name = obj.__getattr__("name")
        expect name == "Alice"
        expect obj.has_attr("name") == true

describe "Fluent interfaces":
    it "enables method chaining":
        val query = QueryBuilder.new()
        query.select(["name", "age"])
        query.from_table("users")

        expect query.has_table() == true
        expect query.field_count() == 2
        expect query.is_valid() == true

    it "supports pipeline transformations":
        val pipe = Pipeline.new([1, 2, 3, 4, 5])
        expect pipe.size() == 5

        pipe.filter(_1 > 2)
        expect pipe.size() == 3

        val result = pipe.collect()
        expect len(result) == 3
        expect result[0] == 3
