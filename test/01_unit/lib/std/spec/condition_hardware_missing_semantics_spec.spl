# Bug repro: skip(hardware: [...]) is documented and used (see
# decorators_spec.spl "creates hardware-specific skip" / skip_no_gpu, reason
# "GPU required for test") to mean "skip this test when the hardware is
# MISSING" — the test needs a GPU and there isn't one, so it can't run.
#
# matches_hardware() in condition.spl instead matches (i.e. triggers skip)
# when the hardware IS PRESENT, which is backwards: a test requiring a GPU
# would be skipped only when a GPU is actually available, and would run (and
# presumably fail/crash) when the GPU is absent — the exact opposite of the
# stated purpose.
#
# has_neon() is deterministically false on x86_64 (env_detect.spl: NEON is
# only reported present when is_aarch64()). This sandbox and CI both run
# x86_64, so "neon" hardware is reliably MISSING here — a clean stand-in for
# "GPU missing" without depending on which GPU vendor tooling happens to be
# installed on the runner.

use std.nogc_sync_mut.spec.condition.{matches_hardware}

describe "matches_hardware missing-vs-present semantics":
    it "should match (trigger skip) when required hardware is MISSING, not present":
        # NEON is not available on x86_64.
        val matched = matches_hardware(["neon"])

        # Intended semantics (per decorators.spl skip() docstring: "hardware:
        # Skip if hardware missing" and skip_no_gpu's reason "GPU required
        # for test"): since the required hardware is missing, this SHOULD
        # match (skip).
        expect(matched).to_equal(true)
