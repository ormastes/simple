# @manual: primary

use std.spec.{_execute_it, expect, pending, print_summary}


fn pending_case():
    pending("fixture unavailable")
    return

fn active_case():
    expect("active").to_equal("active")

_execute_it("marks an unavailable example pending", pending_case)
_execute_it("still counts the following active example", active_case)
print_summary()
