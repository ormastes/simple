# Repro/regression: std_spec_package_shadows_file_print_summary_2026-07-17.
#
# The std.spec PACKAGE entrypoint (src/lib/nogc_sync_mut/spec/__init__.spl)
# must expose the same summary accessors as the canonical sibling FILE
# (src/lib/nogc_sync_mut/spec.spl). Every other tier shim (nogc_async_mut,
# gc_async_mut, gc_sync_mut) re-exports print_summary / get_exit_code /
# get_test_count / get_executed_test_count / get_expectation_count from
# std.nogc_sync_mut.spec; without that re-export the package surface shadows
# the file's own definitions for any consumer that resolves the package.
use std.spec.{describe, it, expect}
use std.env.{env_get}
use std.io_runtime.{host_os, getpid}
use std.io.process_ops.{process_run_bounded}
use std.process.run

use std.io.{file_read}

val FIXTURE = "test/fixtures/lib/std_spec_summary/package_surface.spl"
val PACKAGE_INIT = "src/lib/nogc_sync_mut/spec/__init__.spl"

fn _simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "":
        return configured
    if host_os() == "windows":
        val (out, _e, code) = process_run_bounded("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", "(Get-Process -Id {getpid()}).Path"], 20000, 65536)
        if code == 0:
            return out.trim()
        return ""
    val (ps_out, _pe, ps_code) = process_run_bounded("ps", ["-o", "comm=", "-p", "{getpid()}"], 2000, 65536)
    if ps_code == 0: ps_out.trim() else: ""

describe "std.spec package summary surface":
    it "re-exports the file-level summary accessors from the package entrypoint":
        val init_source = file_read(PACKAGE_INIT)
        expect(init_source).to_contain("export use std.nogc_sync_mut.spec.{print_summary, get_exit_code, get_test_count, get_executed_test_count, get_expectation_count}")

    it "reports the executed example through the package-imported accessors":
        val bin = _simple_binary()
        expect(bin != "").to_equal(true)
        val result = run(bin, ["run", FIXTURE])
        expect(result.stdout).to_contain("PKG_COUNT_AFTER_DESCRIBE=1")
        expect(result.stdout).to_contain("PKG_EXIT_AFTER_DESCRIBE=0")
