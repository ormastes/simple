# @cover src/lib/nogc_sync_mut/spec/skip_governance.spl
# @cover src/lib/nogc_sync_mut/spec.spl
#
# WP-9 acceptance coverage (aerospace_hardening_plan_2026-08-07.md):
# `skip_ref(id)` resolves into a real SDN-tracked record and, under the
# `critical` profile, REJECTS: `skip_it` (validate_skip_it), bare `pending`
# (validate_bare_pending), free-text-only reasons (validate_free_text_skip),
# weak reasons, expired records, and ownerless records
# (all three via validate_skip_ref_record). The same cases pass under
# non-critical profiles (moderate/robust), so this does not silently tighten
# anyone's default. Direct function calls are used throughout per this WP's
# harness convention (no new syntax was introduced).
#
# End-to-end reachability (skip_ref -> spec.spl's skip_via_ref -> real
# accept/reject) is proven separately via `bin/simple run` — see
# doc/08_tracking/bug/interpreter_pending_skip_dsl_intercept_bypasses_spl_body_2026-08-07.md
# for why that could not be a `bin/simple test` spec.

use std.spec
use std.spec.skip_governance.{
    SkipRecord, SkipValidation,
    validate_skip_it, validate_bare_pending, validate_free_text_skip,
    validate_skip_ref_record
}

fn _full_record(reason: text, owner: text, expiry: text) -> SkipRecord:
    SkipRecord(
        id: "wp9-test-id",
        category: "hardware",
        reason: reason,
        owner: owner,
        requirement: "REQ-MC-099",
        alternative_evidence: "",
        venue: "",
        expiry: expiry,
        issue: "https://example.invalid/issue/1"
    )

describe "WP-9 skip governance: valid full-metadata skip":
    it "passes at critical":
        # @req: REQ-MC-099
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "team-avionics", "2999-01-01"), "critical")
        expect(v.ok).to_equal(true)

    it "passes at robust":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "team-avionics", "2999-01-01"), "robust")
        expect(v.ok).to_equal(true)

    it "passes at moderate":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "team-avionics", "2999-01-01"), "moderate")
        expect(v.ok).to_equal(true)

describe "WP-9 skip governance: skip_it (carries no metadata by construction)":
    it "is REJECTED under critical":
        expect(validate_skip_it("critical").ok).to_equal(false)

    it "passes under robust (unchanged default)":
        expect(validate_skip_it("robust").ok).to_equal(true)

    it "passes under moderate (unchanged default)":
        expect(validate_skip_it("moderate").ok).to_equal(true)

describe "WP-9 skip governance: bare pending (carries no metadata by construction)":
    it "is REJECTED under critical":
        expect(validate_bare_pending("critical").ok).to_equal(false)

    it "passes under robust (unchanged default)":
        expect(validate_bare_pending("robust").ok).to_equal(true)

    it "passes under moderate (unchanged default)":
        expect(validate_bare_pending("moderate").ok).to_equal(true)

describe "WP-9 skip governance: free-text-only reason (a string with no structured record)":
    it "is REJECTED under critical even with a substantive-looking reason":
        val v = validate_free_text_skip("Deferred pending FPGA rev-C bring-up, see ISSUE-42", "critical")
        expect(v.ok).to_equal(false)

    it "passes under robust (unchanged default)":
        val v = validate_free_text_skip("Deferred pending FPGA rev-C bring-up, see ISSUE-42", "robust")
        expect(v.ok).to_equal(true)

    it "passes under moderate (unchanged default)":
        val v = validate_free_text_skip("Deferred pending FPGA rev-C bring-up, see ISSUE-42", "moderate")
        expect(v.ok).to_equal(true)

describe "WP-9 skip governance: weak reason (empty/short/filler-word, via validate_free_text_skip)":
    it "is REJECTED under critical":
        expect(validate_free_text_skip("", "critical").ok).to_equal(false)
        expect(validate_free_text_skip("todo", "critical").ok).to_equal(false)
        expect(validate_free_text_skip("later", "critical").ok).to_equal(false)
        expect(validate_free_text_skip("Condition not met", "critical").ok).to_equal(false)
        expect(validate_free_text_skip("Condition matched", "critical").ok).to_equal(false)

    it "passes under moderate (unchanged default)":
        expect(validate_free_text_skip("", "moderate").ok).to_equal(true)
        expect(validate_free_text_skip("todo", "moderate").ok).to_equal(true)

describe "WP-9 skip governance: weak reason on a resolved SDN record":
    it "is REJECTED under critical (Weak, not just FreeTextOnly)":
        val v = validate_skip_ref_record(_full_record("todo", "team-avionics", "2999-01-01"), "critical")
        expect(v.ok).to_equal(false)

    it "passes under moderate (unchanged default)":
        val v = validate_skip_ref_record(_full_record("todo", "team-avionics", "2999-01-01"), "moderate")
        expect(v.ok).to_equal(true)

describe "WP-9 skip governance: expired record":
    it "is REJECTED under critical":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "team-avionics", "2000-01-01"), "critical")
        expect(v.ok).to_equal(false)

    it "is REJECTED under critical when expiry is missing entirely":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "team-avionics", ""), "critical")
        expect(v.ok).to_equal(false)

    it "passes under moderate (unchanged default)":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "team-avionics", "2000-01-01"), "moderate")
        expect(v.ok).to_equal(true)

describe "WP-9 skip governance: ownerless record":
    it "is REJECTED under critical":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "", "2999-01-01"), "critical")
        expect(v.ok).to_equal(false)

    it "passes under moderate (unchanged default)":
        val v = validate_skip_ref_record(_full_record("Real HW dependency, tracked separately", "", "2999-01-01"), "moderate")
        expect(v.ok).to_equal(true)

describe "WP-9 skip governance: unregistered skip_ref id (no SDN record at all)":
    it "is REJECTED under critical (skip_ref returns an empty sentinel, not a fabricated reason)":
        val empty = SkipRecord(
            id: "unregistered", category: "", reason: "", owner: "",
            requirement: "", alternative_evidence: "", venue: "",
            expiry: "", issue: ""
        )
        val v = validate_skip_ref_record(empty, "critical")
        expect(v.ok).to_equal(false)

    it "passes under moderate (unchanged default)":
        val empty = SkipRecord(
            id: "unregistered", category: "", reason: "", owner: "",
            requirement: "", alternative_evidence: "", venue: "",
            expiry: "", issue: ""
        )
        val v = validate_skip_ref_record(empty, "moderate")
        expect(v.ok).to_equal(true)
