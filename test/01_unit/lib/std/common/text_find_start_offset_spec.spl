# @cover src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl 5%
"""
## Purpose and audience
Purpose: Pin the two-arg `(needle, start)` contract of text `find` / `find_str`
against a silent-wrong-answer regression.
Audience: compiler and stdlib engineers who maintain string method lowering.

# Text find start-offset Specification

**Feature IDs:** #TEXT-FIND-START
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** doc/08_tracking/bug/text_find_ignores_start_offset_2026-08-27.md

## Overview

`text.find(needle, start)` used to DISCARD the `start` argument: every lane
lowered it to the two-arg `rt_string_find`, so `"abcabc".find("abc", 1)`
answered `0` instead of `3`. It never crashed — it returned a plausible wrong
answer, which is why it survived. One victim infinite-looped a lint scan
(>900s at 100% CPU) because an advancing-position loop kept rediscovering the
same match at position 0.

`index_of` already routed two-arg calls to the offset-aware `rt_text_find`;
`find` / `find_str` are aliases of it and now share that route. These cases pin
`rt_text_find`'s contract exactly: byte-indexed, raw i64, `-1` for not-found,
`start < 0` clamps to 0, an empty needle answers `min(start, len)`, and a
non-empty needle with `start` past the end answers `-1`.
"""

# @req: REQ-LIB-TEXT-FIND-START-001 — stable requirement identity for this spec.

use std.spipe.*
use std.spec.step

describe "text.find with a start offset":
    it "finds a match at or after start":
        step("Verify: match after start is found at its real index")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("abc", 1)).to_equal(3)

    it "skips a match that lies before start":
        step("Verify: the earlier occurrence is not reported")
        # @req: REQ-LIB-TEXT-FIND-START-001
        # Pre-fix this answered 0 — the whole defect in one line.
        expect("xxay".find("xxa", 1)).to_equal(-1)

    it "matches a needle sitting exactly at start":
        step("Verify: start is inclusive")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("abc", 3)).to_equal(3)

    it "behaves like the one-arg form when start is 0":
        step("Verify: start 0 equals the one-arg contract")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("abc", 0)).to_equal(0)
        expect("abcabc".find("abc", 0)).to_equal("abcabc".find("abc"))

    it "reports -1 when start is beyond the length":
        step("Verify: start past the end misses")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("abc", 99)).to_equal(-1)

    it "clamps a negative start to 0":
        step("Verify: negative start clamps")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("abc", -5)).to_equal(0)

    it "answers min(start, len) for an empty needle":
        step("Verify: empty needle contract")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("", 2)).to_equal(2)
        expect("abcabc".find("", 99)).to_equal(6)

    it "reports -1 when the needle is absent entirely":
        step("Verify: absent needle misses")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("zzz", 1)).to_equal(-1)

describe "text.find_str with a start offset":
    it "honours start like find":
        step("Verify: find_str is an alias with the same contract")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find_str("abc", 1)).to_equal(3)

describe "text.find agrees with index_of":
    it "matches index_of for the same arguments":
        step("Verify: the aliases do not diverge")
        # @req: REQ-LIB-TEXT-FIND-START-001
        expect("abcabc".find("abc", 1)).to_equal("abcabc".index_of("abc", 1))
        expect("hello world hello".find("hello", 1)).to_equal(12)

describe "advancing-position scan terminates":
    it "walks every occurrence without revisiting position 0":
        step("Verify: the infinite-loop shape now terminates")
        # @req: REQ-LIB-TEXT-FIND-START-001
        # This is the loop that hung a lint scan for >900s pre-fix.
        var hits: [i64] = []
        var pos = 0
        while pos >= 0:
            val at = "aXaXa".find("a", pos)
            if at < 0:
                pos = -1
            else:
                hits.push(at)
                pos = at + 1
        expect(hits.len()).to_equal(3)
        expect(hits[0]).to_equal(0)
        expect(hits[1]).to_equal(2)
        expect(hits[2]).to_equal(4)
