"""
## Purpose and audience
Purpose: Verify CrashBundleV1 — synthetic capture (DS7).
Audience: compiler and tooling engineers who maintain this spec.

DS7 (mission-critical robustness plan, Batch D, lane crash-native) —
CrashBundleV1 spec.

Builds a bundle from a SYNTHETIC failure (this spec never raises a real
SIGSEGV/SIGABRT — the C runtime's `rt_install_crash_handler` is not
reachable from Simple code today; see
src/lib/nogc_sync_mut/crash/crash_bundle.spl's header comment and
doc/08_tracking/bug/crash_signal_bundle_extern_gap_2026-07-29.md for the
extern gap that blocks a real signal -> Simple hook). Instead this asserts
the CrashBundleV1 data model + SDN serialization + std.log ring-record
round-trip that ARE reachable today.
"""

# @req: REQ-LIB-CRASH-BUNDLE-001 — stable requirement identity for this spec.

use std.spec
use std.nogc_sync_mut.crash.crash_bundle.{
    CrashBundleV1, crash_ring_register, crash_ring_clear, crash_ring_unregister
}
use std.log.{SUBSYS_TEST, LOG_ERROR, log_info_subsys, log_error_subsys}
use std.fs.{read_file, file_exists}

describe "CrashBundleV1 — synthetic capture (DS7)":

    it "captures fault_kind, message, source_location, pid, timestamp, version":
        step("Verify: captures fault_kind, message, source_location, pid, timestamp, version")
        # @req: REQ-LIB-CRASH-BUNDLE-001
        val reg = crash_ring_register(64)
        val ring = reg.0
        val id = reg.1
        crash_ring_clear(ring)

        val bundle = CrashBundleV1.capture(
            "panic",
            "synthetic failure for DS7 spec",
            "crash_bundle_spec.spl:1",
            ring
        )

        expect(bundle.version).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(bundle.fault_kind).to_equal("panic")
        expect(bundle.message).to_equal("synthetic failure for DS7 spec")
        expect(bundle.source_location).to_equal("crash_bundle_spec.spl:1")
        expect(bundle.build_id).to_equal("")
        expect(bundle.pid).to_be_greater_than(0)
        expect(bundle.timestamp_unix_micros).to_be_greater_than(0)

        crash_ring_unregister(id)

    it "round-trips recent std.log ring records into the bundle":
        step("Verify: round-trips recent std.log ring records into the bundle")
        val reg = crash_ring_register(64)
        val ring = reg.0
        val id = reg.1
        crash_ring_clear(ring)

        log_info_subsys(SUBSYS_TEST, "ds7 ring record one")
        log_error_subsys(SUBSYS_TEST, "ds7 ring record two")

        val bundle = CrashBundleV1.capture("panic", "synthetic failure", "", ring)

        expect(bundle.ring_records.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(bundle.ring_records[0].subsys).to_equal(SUBSYS_TEST)
        expect(bundle.ring_records[0].message).to_equal("ds7 ring record one")
        expect(bundle.ring_records[1].level).to_equal(LOG_ERROR)
        expect(bundle.ring_records[1].message).to_equal("ds7 ring record two")

        crash_ring_unregister(id)

    it "caps captured ring records at max_records, keeping the most recent":
        step("Verify: caps captured ring records at max_records, keeping the most recent")
        val reg = crash_ring_register(64)
        val ring = reg.0
        val id = reg.1
        crash_ring_clear(ring)

        log_info_subsys(SUBSYS_TEST, "older record - should be dropped")
        log_info_subsys(SUBSYS_TEST, "kept record one")
        log_info_subsys(SUBSYS_TEST, "kept record two")

        val bundle = CrashBundleV1.capture_n("panic", "synthetic failure", "", ring, 2)

        expect(bundle.ring_records.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(bundle.ring_records[0].message).to_equal("kept record one")
        expect(bundle.ring_records[1].message).to_equal("kept record two")

        crash_ring_unregister(id)

    it "serializes to SDN with the expected top-level fields and escapes correctly":
        step("Verify: serializes to SDN with the expected top-level fields and escapes correctly")
        val reg = crash_ring_register(64)
        val ring = reg.0
        val id = reg.1
        crash_ring_clear(ring)

        log_info_subsys(SUBSYS_TEST, "sdn ring line")

        val bundle = CrashBundleV1.capture(
            "signal:SIGSEGV",
            "synthetic segv message with \"quotes\"",
            "mod.spl:42",
            ring
        )
        val sdn = bundle.to_sdn()

        expect(sdn).to_contain("crash_bundle:")
        expect(sdn).to_contain("format: \"simple-crash-bundle\"")
        expect(sdn).to_contain("version: 1")
        expect(sdn).to_contain("fault_kind: \"signal:SIGSEGV\"")
        expect(sdn).to_contain("message: \"synthetic segv message with \\\"quotes\\\"\"")
        expect(sdn).to_contain("source_location: \"mod.spl:42\"")
        expect(sdn).to_contain("ring_records:")
        expect(sdn).to_contain("count: 1")
        expect(sdn).to_contain("sdn ring line")

        crash_ring_unregister(id)

    it "writes the bundle to disk as SDN and reads it back byte-for-byte":
        step("Verify: writes the bundle to disk as SDN and reads it back byte-for-byte")
        val reg = crash_ring_register(64)
        val ring = reg.0
        val id = reg.1
        crash_ring_clear(ring)

        val bundle = CrashBundleV1.capture("panic", "write-to-disk synthetic", "", ring)
        val path = "/tmp/ds7_crash_bundle_spec_{bundle.pid}.sdn"
        val ok = bundle.write_to(path)

        expect(ok).to_equal(true)
        expect(file_exists(path)).to_equal(true)
        val on_disk = read_file(path)
        expect(on_disk).to_equal(bundle.to_sdn())

        crash_ring_unregister(id)
