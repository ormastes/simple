# Focused lifecycle owner specs for aspect-pack late activation and unload.

use std.common.string_core.{text_to_bytes}
use std.common.aspect_pack.{
    ApkModuleSourceV1, ApkCatalogEntryV1, ApkActivationClaimV1,
    apk_build_pack_v1, apk_build_catalog_v1, apk_loader_new,
    apk_loader_register_pack, apk_load_facet, apk_load_facet_owned_v1,
    apk_loader_generation, apk_loader_packs_opened, apk_loader_last_error,
    apk_loader_modules_decompressed, apk_loader_unloads,
    apk_activation_claim_v1, apk_activation_advance_v1,
    apk_activation_publish_v1, apk_activation_fail_v1,
    apk_activation_state_v1, apk_activation_diagnostic_v1,
    apk_facet_pin_v1, apk_facet_unpin_v1, apk_unload_facet_v1,
    apk_facet_state_v1, APK_FC_QUIESCING, APK_FC_UNLOADED,
    APK_AS_CATALOGUED, APK_AS_INDEX_MAPPED, APK_AS_RESOLVING,
    APK_AS_CHUNKS_LOADED, APK_AS_RELOCATED, APK_AS_BOUND,
    APK_AS_ACTIVE, APK_AS_QUIESCING, APK_AS_UNLOADED, APK_AS_FAILED
}

struct LifecycleFixture:
    ld: i64
    catalog: [u8]
    facet_key: text

fn build_lifecycle_fixture() -> LifecycleFixture:
    var modules: [ApkModuleSourceV1] = []
    modules.push(ApkModuleSourceV1(
        module_id: "debug.core",
        aspect_id: "debug",
        payload: text_to_bytes("debug aspect payload")
    ))
    val pack = apk_build_pack_v1(modules)
    var entries: [ApkCatalogEntryV1] = []
    entries.push(ApkCatalogEntryV1(
        facet_key: "debug/Debuggable",
        pack_path: "aspect/debug.apk",
        module_id: "debug.core"
    ))
    val catalog = apk_build_catalog_v1(entries)
    val ld = apk_loader_new()
    expect(pack.ok).to_equal(true)
    expect(catalog.ok).to_equal(true)
    expect(apk_loader_register_pack(ld, "aspect/debug.apk", pack.bytes)).to_equal(true)
    LifecycleFixture(ld: ld, catalog: catalog.bytes, facet_key: "debug/Debuggable")

fn assert_lifecycle_state(ld: i64, facet_key: text, expected: i64):
    expect(apk_activation_state_v1(ld, facet_key)).to_equal(expected)

fn advance_to_bound(ld: i64, claim: ApkActivationClaimV1):
    expect(apk_activation_advance_v1(ld, claim, APK_AS_CATALOGUED, APK_AS_INDEX_MAPPED)).to_equal(true)
    assert_lifecycle_state(ld, claim.facet_key, APK_AS_INDEX_MAPPED)
    expect(apk_activation_advance_v1(ld, claim, APK_AS_INDEX_MAPPED, APK_AS_RESOLVING)).to_equal(true)
    assert_lifecycle_state(ld, claim.facet_key, APK_AS_RESOLVING)
    expect(apk_activation_advance_v1(ld, claim, APK_AS_RESOLVING, APK_AS_CHUNKS_LOADED)).to_equal(true)
    assert_lifecycle_state(ld, claim.facet_key, APK_AS_CHUNKS_LOADED)
    expect(apk_activation_advance_v1(ld, claim, APK_AS_CHUNKS_LOADED, APK_AS_RELOCATED)).to_equal(true)
    assert_lifecycle_state(ld, claim.facet_key, APK_AS_RELOCATED)
    expect(apk_activation_advance_v1(ld, claim, APK_AS_RELOCATED, APK_AS_BOUND)).to_equal(true)
    assert_lifecycle_state(ld, claim.facet_key, APK_AS_BOUND)

describe "aspect-pack lifecycle owner":

    it "REQ-APK-P05 enters every late state and drains a pinned Active generation":
        val stage_ld = apk_loader_new()
        val staged = apk_activation_claim_v1(stage_ld, "state/Probe", "state-owner")
        expect(staged.owns).to_equal(true)
        assert_lifecycle_state(stage_ld, staged.facet_key, APK_AS_CATALOGUED)
        advance_to_bound(stage_ld, staged)
        expect(apk_activation_publish_v1(stage_ld, staged)).to_equal(true)
        assert_lifecycle_state(stage_ld, staged.facet_key, APK_AS_ACTIVE)

        val fixture = build_lifecycle_fixture()
        val loaded = apk_load_facet(fixture.ld, fixture.catalog, fixture.facet_key)
        expect(loaded.error_code).to_equal("")
        expect(loaded.ok).to_equal(true)
        assert_lifecycle_state(fixture.ld, fixture.facet_key, APK_AS_ACTIVE)
        val pinned = apk_facet_pin_v1(fixture.ld, fixture.facet_key)
        expect(apk_loader_last_error(fixture.ld)).to_equal("")
        expect(pinned).to_equal(true)
        val pending = apk_unload_facet_v1(fixture.ld, fixture.facet_key)
        expect(pending.error_code).to_equal("")
        expect(pending.quiescing).to_equal(true)
        expect(apk_facet_state_v1(fixture.ld, fixture.facet_key)).to_equal(APK_FC_QUIESCING)
        assert_lifecycle_state(fixture.ld, fixture.facet_key, APK_AS_QUIESCING)
        val unpinned = apk_facet_unpin_v1(fixture.ld, fixture.facet_key)
        expect(apk_loader_last_error(fixture.ld)).to_equal("")
        expect(unpinned).to_equal(true)
        expect(apk_facet_state_v1(fixture.ld, fixture.facet_key)).to_equal(APK_FC_UNLOADED)
        assert_lifecycle_state(fixture.ld, fixture.facet_key, APK_AS_UNLOADED)
        expect(apk_loader_unloads(fixture.ld)).to_equal(1)

    it "REQ-APK-P05-NEG refuses skips and non-owner completion, then keeps one failure diagnostic":
        val ld = apk_loader_new()
        val owner = apk_activation_claim_v1(ld, "debug/Failure", "owner-a")
        val joined = apk_activation_claim_v1(ld, "debug/Failure", "owner-b")
        expect(owner.owns).to_equal(true)
        expect(joined.owns).to_equal(false)
        expect(joined.joined).to_equal(true)
        expect(apk_activation_advance_v1(ld, owner, APK_AS_CATALOGUED, APK_AS_CHUNKS_LOADED)).to_equal(false)
        expect(apk_activation_advance_v1(ld, joined, APK_AS_CATALOGUED, APK_AS_INDEX_MAPPED)).to_equal(false)
        assert_lifecycle_state(ld, owner.facet_key, APK_AS_CATALOGUED)
        expect(apk_loader_generation(ld)).to_equal(0)
        expect(apk_activation_fail_v1(ld, owner, "stable relocation failure")).to_equal(true)
        expect(apk_activation_fail_v1(ld, owner, "replacement diagnostic")).to_equal(false)
        assert_lifecycle_state(ld, owner.facet_key, APK_AS_FAILED)
        expect(apk_activation_diagnostic_v1(ld, owner.facet_key)).to_equal("stable relocation failure")
        expect(apk_loader_generation(ld)).to_equal(0)

    it "REQ-APK-P06b gives one concurrent owner and decompresses its generation once":
        val fixture = build_lifecycle_fixture()
        val owner = apk_activation_claim_v1(fixture.ld, fixture.facet_key, "caller-a")
        val joined = apk_activation_claim_v1(fixture.ld, fixture.facet_key, "caller-b")
        expect(owner.owns).to_equal(true)
        expect(joined.joined).to_equal(true)
        expect(joined.attempt).to_equal(owner.attempt)
        expect(joined.generation).to_equal(owner.generation)

        val loser_early = apk_load_facet_owned_v1(
            fixture.ld, fixture.catalog, fixture.facet_key, false, "caller-b")
        expect(loser_early.ok).to_equal(false)
        expect(loser_early.error_code).to_equal("APK_ACTIVATION_IN_PROGRESS")
        expect(apk_loader_packs_opened(fixture.ld)).to_equal(0)
        expect(apk_loader_modules_decompressed(fixture.ld)).to_equal(0)

        val winner = apk_load_facet_owned_v1(
            fixture.ld, fixture.catalog, fixture.facet_key, false, "caller-a")
        expect(winner.ok).to_equal(true)
        val loser_observed = apk_load_facet_owned_v1(
            fixture.ld, fixture.catalog, fixture.facet_key, false, "caller-b")
        expect(loser_observed.ok).to_equal(true)
        expect(loser_observed.from_cache).to_equal(true)
        expect(loser_observed.generation).to_equal(winner.generation)
        expect(apk_loader_packs_opened(fixture.ld)).to_equal(1)
        expect(apk_loader_modules_decompressed(fixture.ld)).to_equal(1)
