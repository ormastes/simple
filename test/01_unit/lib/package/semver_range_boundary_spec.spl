# Purpose and audience: executable boundary evidence for canonical semantic-version ranges.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect, step}
use std.package.types.{Version, VersionConstraint}
use std.package.semver.{satisfies}

fn _version(major: i64, minor: i64, patch: i64) -> Version:
    Version(major: major, minor: minor, patch: patch, prerelease: nil, build: nil)

describe "Canonical semantic-version range boundaries":
    it "treats Range as a half-open interval":
        step("Accept the minimum and reject the maximum")
        val range = VersionConstraint.Range(min: _version(1, 0, 0), max: _version(2, 0, 0))
        expect(satisfies(_version(1, 0, 0), range)).to_be(true)
        expect(satisfies(_version(0, 9, 9), range)).to_be(false)
        expect(satisfies(_version(1, 9, 9), range)).to_be(true)
        expect(satisfies(_version(2, 0, 0), range)).to_be(false)
