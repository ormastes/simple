# Purpose and audience: exhaustive regression for the shared Range variant in canonical semver.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect, step}
use std.package.types.{Version, VersionConstraint}
use std.package.semver.{satisfies}

fn v(major: i64, minor: i64, patch: i64) -> Version:
    Version(major: major, minor: minor, patch: patch, prerelease: nil, build: nil)

describe "Canonical semver shared Range variant":
    it "includes the minimum and interior but excludes below and maximum":
        step("Evaluate the half-open interval [1.2.3, 2.0.0)")
        val range = VersionConstraint.Range(min: v(1, 2, 3), max: v(2, 0, 0))
        expect(satisfies(v(1, 2, 2), range)).to_be(false)
        expect(satisfies(v(1, 2, 3), range)).to_be(true)
        expect(satisfies(v(1, 9, 9), range)).to_be(true)
        expect(satisfies(v(2, 0, 0), range)).to_be(false)
