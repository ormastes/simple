# Purpose and audience: executable regression evidence for legacy package constraints.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect, step}
use std.package.semver_old.{parse_version, parse_constraint, satisfies, constraint_to_string}

describe "Legacy package constraint compatibility":
    it "uses canonical greater-equal and less enum variants":
        step("Parse and evaluate canonical comparison variants")
        val version = parse_version("1.4.2").unwrap()
        val lower = parse_constraint(">=1.4.0").unwrap()
        val upper = parse_constraint("<2.0.0").unwrap()
        expect(satisfies(version, lower)).to_be(true)
        expect(satisfies(version, upper)).to_be(true)
        expect(constraint_to_string(lower)).to_equal(">=1.4.0")
        expect(constraint_to_string(upper)).to_equal("<2.0.0")

    it "preserves bounded range constraints":
        step("Parse and evaluate the legacy comma range")
        val version = parse_version("1.4.2").unwrap()
        val range = parse_constraint(">=1.0.0, <2.0.0").unwrap()
        expect(satisfies(version, range)).to_be(true)
        expect(constraint_to_string(range)).to_equal(">=1.0.0, <2.0.0")
