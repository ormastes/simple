use std.gc_async_mut.package.semver_old.{parse_version, parse_constraint, satisfies, constraint_to_string}

describe "gc_async_mut legacy semver constraint variants":
    it "accepts inclusive lower bounds and rejects earlier versions":
        val lower = match parse_constraint(">=1.2.3"):
            case Ok(c): c
            case Err(e): panic(e)
        val exact = match parse_version("1.2.3"):
            case Ok(v): v
            case Err(e): panic(e)
        val earlier = match parse_version("1.2.2"):
            case Ok(v): v
            case Err(e): panic(e)
        expect(satisfies(exact, lower)).to_equal(true)
        expect(satisfies(earlier, lower)).to_equal(false)
        expect(constraint_to_string(lower)).to_equal(">=1.2.3")

    it "preserves bounded range behavior":
        val range = match parse_constraint(">=1.2.3, <2.0.0"):
            case Ok(c): c
            case Err(e): panic(e)
        val inside = match parse_version("1.9.0"):
            case Ok(v): v
            case Err(e): panic(e)
        val outside = match parse_version("2.0.0"):
            case Ok(v): v
            case Err(e): panic(e)
        expect(satisfies(inside, range)).to_equal(true)
        expect(satisfies(outside, range)).to_equal(false)
