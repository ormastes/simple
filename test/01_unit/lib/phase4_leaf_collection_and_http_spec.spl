use std.spec.{describe, it, expect}
use std.nogc_sync_mut.tui.style.{make_plain_line, render_line, render_lines}
use std.nogc_sync_mut.http_client.request.{http_get, http_post, http_put, http_delete}

describe "Phase4 library leaf collection and HTTP owners":
    it "renders empty and multiple styled lines through array methods":
        expect(render_lines([])).to_equal("")
        val first = make_plain_line("first")
        val second = make_plain_line("second")
        expect(render_lines([first, second])).to_equal("{render_line(first)}\n{render_line(second)}")

    it "uses all four sibling HTTP method constants and preserves body":
        val get = http_get("/resource")
        val post = http_post("/resource", "payload")
        val put = http_put("/resource", "replacement")
        val delete = http_delete("/resource")
        expect(get.0).to_equal("GET")
        expect(post.0).to_equal("POST")
        expect(put.0).to_equal("PUT")
        expect(delete.0).to_equal("DELETE")
        expect(post.3).to_equal("payload")
        expect(put.3).to_equal("replacement")
