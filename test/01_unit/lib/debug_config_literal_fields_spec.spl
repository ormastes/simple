use std.spec.{describe, it, assert_true, assert_false}
use std.fs.{file_read_text}

# @req REQ-JIT-FIELD-INFER-001
#
# Regression + generalization guard for
# doc/08_tracking/bug/test_runner_jit_fallback_functionoutline_type_params_2026-08-17.md
#
# A struct/class literal that names a field the declaration does not have is a
# HIR-lowering hard error (`Cannot infer field type: struct 'X' field 'f'`).
# The JIT reacts by dropping the ENTIRE module to the tree-walk interpreter, so
# a single bad literal anywhere in the import closure of
# src/app/test_runner_new/main.spl slows every test in the fleet by ~100-1000x.
#
# Concrete instance found 2026-08-17: five `DebugConfig(...)` literals passed
# `args:`, `debugger:` and `remote:`, none of which exist on ANY of the four
# `class DebugConfig` declarations in the tree.

val DECL_FILES = [
    "src/app/debug/remote/types.spl",
    "src/lib/nogc_sync_mut/debug/remote/types.spl",
    "src/lib/nogc_async_mut/debug/remote/types.spl",
    "src/lib/nogc_async_mut_noalloc/qemu/debug_boot_runner.spl"
]

val FIXED_FILES = [
    "src/lib/nogc_sync_mut/terminal/power/t32_power.spl",
    "src/app/test_daemon/adapters/hardware_adapter.spl"
]

describe("DebugConfig literals only name declared fields"):
    it("no DebugConfig declaration in the tree carries args/debugger/remote"):
        for path in DECL_FILES:
            val src = file_read_text(path) ?? ""
            assert_true(src.len() > 0)
            assert_true(src.contains("class DebugConfig"))
            assert_true(src.contains("    host: text"))
            assert_true(src.contains("    program: text"))
            assert_false(src.contains("\n    args:"))
            assert_false(src.contains("\n    debugger:"))
            assert_false(src.contains("\n    remote:"))

    it("the trace32 construction sites no longer pass undeclared fields"):
        for path in FIXED_FILES:
            val src = file_read_text(path) ?? ""
            assert_true(src.len() > 0)
            assert_false(src.contains("debugger: \"t32\""))
            assert_false(src.contains("remote: true"))

    it("the trace32 sites use the declared-field constructor helper"):
        for path in FIXED_FILES:
            val src = file_read_text(path) ?? ""
            assert_true(src.contains("DebugConfig.for_trace32("))
