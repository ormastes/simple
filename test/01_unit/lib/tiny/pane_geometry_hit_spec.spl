"""
## Purpose and audience
Purpose: Prove that Tiny pane resolution and hit testing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-TINY-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use std.tiny.common.status.{TINY_OK, TINY_ERR_INVALID, TINY_ERR_STALE_HANDLE}
use std.tiny.common.types.{TinyHandle, TinyPoint, TinyRect, tiny_add_i32_saturating, tiny_sub_i32_saturating}
use std.tiny.pane.model.{TinyPane, TINY_PANE_VISIBLE, TINY_PANE_ENABLED, TINY_PANE_POINTER}
use std.tiny.pane.store.{TinyPaneStore}
use std.tiny.pane.resolve.{tiny_resolve_panes}
use std.tiny.pane.hit_test.{tiny_hit_test}

fn pane_at(parent: TinyHandle, rect: TinyRect, z: i32, content_id: i32) -> TinyPane:
    TinyPane(
        id: TinyHandle.invalid(), parent: parent, local: rect,
        clip_local: TinyRect.empty(), scroll_x: 0, scroll_y: 0,
        z: z, flags: TINY_PANE_VISIBLE | TINY_PANE_ENABLED | TINY_PANE_POINTER,
        content_id: content_id,
    )

use std.spec.step

describe "Tiny pane resolution and hit testing":
    it "resolves parent-relative geometry with parent scroll and clipping":
        step("Verify: resolves parent-relative geometry with parent scroll and clipping")
        # @req: REQ-LIB-TINY-001
        var store = TinyPaneStore.with_capacity(3)
        val root = store.insert(pane_at(TinyHandle.invalid(), TinyRect(x: 10, y: 20, width: 100, height: 80), 0, 1))
        val root_lookup = store.get(root.handle)
        expect(root_lookup.status.code).to_equal(TINY_OK)
        var root_pane = root_lookup.pane
        root_pane.scroll_x = 3
        root_pane.scroll_y = 4
        expect(store.update(root_pane).code).to_equal(TINY_OK)
        val child = store.insert(pane_at(root.handle, TinyRect(x: 8, y: 9, width: 30, height: 20), 1, 2))
        val resolved = tiny_resolve_panes(store, TinyRect(x: 0, y: 0, width: 200, height: 200), 3)
        expect(resolved.status.code).to_equal(TINY_OK)
        expect(resolved.panes[1].absolute.x).to_equal(15)  # oracle: 15 — named expected value from the requirement
        expect(resolved.panes[1].absolute.y).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(resolved.panes[1].effective_clip.width).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(resolved.panes[1].id.index).to_equal(child.handle.index)

    it "selects the topmost eligible pane and returns local coordinates":
        step("Verify: selects the topmost eligible pane and returns local coordinates")
        var store = TinyPaneStore.with_capacity(3)
        store.insert(pane_at(TinyHandle.invalid(), TinyRect(x: 0, y: 0, width: 80, height: 80), 0, 1))
        store.insert(pane_at(TinyHandle.invalid(), TinyRect(x: 10, y: 10, width: 30, height: 30), 2, 2))
        val upper = store.insert(pane_at(TinyHandle.invalid(), TinyRect(x: 15, y: 15, width: 30, height: 30), 7, 3))
        val resolved = tiny_resolve_panes(store, TinyRect(x: 0, y: 0, width: 80, height: 80), 3)
        val hit = tiny_hit_test(resolved.panes, TinyPoint(x: 20, y: 22))
        expect(hit.status.code).to_equal(TINY_OK)
        expect(hit.handle.index).to_equal(upper.handle.index)
        expect(hit.local_point.x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(hit.local_point.y).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "rejects an orphan parent with an explicit status":
        step("Verify: rejects an orphan parent with an explicit status")
        var store = TinyPaneStore.with_capacity(1)
        val stale_parent = TinyHandle(index: 0, generation: 99)
        store.insert(pane_at(stale_parent, TinyRect(x: 0, y: 0, width: 10, height: 10), 0, 1))
        val resolved = tiny_resolve_panes(store, TinyRect(x: 0, y: 0, width: 20, height: 20), 1)
        expect(resolved.status.code).to_equal(TINY_ERR_STALE_HANDLE)

    it "rejects stale and invalid pane lookup before indexing storage":
        step("Verify: rejects stale and invalid pane lookup before indexing storage")
        var store = TinyPaneStore.with_capacity(1)
        val inserted = store.insert(pane_at(TinyHandle.invalid(), TinyRect(x: 0, y: 0, width: 10, height: 10), 0, 1))
        expect(store.remove(inserted.handle).code).to_equal(TINY_OK)
        val stale = store.get(inserted.handle)
        expect(stale.status.code).to_equal(TINY_ERR_STALE_HANDLE)
        expect(stale.pane.id.index).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        val invalid = store.get(TinyHandle.invalid())
        expect(invalid.status.code).to_equal(TINY_ERR_INVALID)
        expect(invalid.pane.id.index).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "saturates geometry arithmetic instead of wrapping coordinates":
        step("Verify: saturates geometry arithmetic instead of wrapping coordinates")
        expect(tiny_add_i32_saturating(2147483647, 1)).to_equal(2147483647)  # oracle: 2147483647 — named expected value from the requirement
        expect(tiny_sub_i32_saturating(-2147483647 - 1, 1)).to_equal(-2147483647 - 1)
        expect(TinyRect(x: 2147483647, y: 2147483647, width: 8, height: 8).right()).to_equal(2147483647)  # oracle: 2147483647 — named expected value from the requirement
        expect(TinyRect(x: 2147483647, y: 2147483647, width: 8, height: 8).bottom()).to_equal(2147483647)  # oracle: 2147483647 — named expected value from the requirement

    it "returns explicit no-hit status outside all clips":
        step("Verify: returns explicit no-hit status outside all clips")
        var store = TinyPaneStore.with_capacity(1)
        store.insert(pane_at(TinyHandle.invalid(), TinyRect(x: 2, y: 2, width: 5, height: 5), 0, 1))
        val resolved = tiny_resolve_panes(store, TinyRect(x: 0, y: 0, width: 20, height: 20), 1)
        val hit = tiny_hit_test(resolved.panes, TinyPoint(x: 19, y: 19))
        expect(hit.status.code).to_equal(TINY_ERR_INVALID)
        expect(hit.handle.index).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(hit.handle.generation).to_equal(0)  # oracle: 0 — named expected value from the requirement
