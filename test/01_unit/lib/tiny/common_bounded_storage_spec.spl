"""
## Purpose and audience
Purpose: Prove that Tiny bounded common storage.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-TINY-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use std.tiny.common.fixed_i32_vec.{TinyFixedI32Vec}
use std.tiny.common.generational_pool.{TinyGenerationalPool}
use std.tiny.common.status.{TINY_OK, TINY_ERR_CAPACITY, TINY_ERR_STALE_HANDLE}

use std.spec.step

describe "Tiny bounded common storage":
    it "rejects vector growth beyond its declared capacity":
        step("Verify: rejects vector growth beyond its declared capacity")
        # @req: REQ-LIB-TINY-001
        var values = TinyFixedI32Vec.with_capacity(2)
        expect(values.push(10).code).to_equal(TINY_OK)
        expect(values.push(20).code).to_equal(TINY_OK)
        expect(values.push(30).code).to_equal(TINY_ERR_CAPACITY)
        expect(values.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(values.get(1)).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "invalidates released handles and increments generation on reuse":
        step("Verify: invalidates released handles and increments generation on reuse")
        var pool = TinyGenerationalPool.with_capacity(1)
        val first = pool.acquire()
        expect(first.status.code).to_equal(TINY_OK)
        expect(first.handle.generation).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pool.release(first.handle).code).to_equal(TINY_OK)
        expect(pool.validate(first.handle).code).to_equal(TINY_ERR_STALE_HANDLE)
        val second = pool.acquire()
        expect(second.status.code).to_equal(TINY_OK)
        expect(second.handle.index).to_equal(first.handle.index)
        expect(second.handle.generation).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns capacity status when no handle slot is free":
        step("Verify: returns capacity status when no handle slot is free")
        var pool = TinyGenerationalPool.with_capacity(1)
        expect(pool.acquire().status.code).to_equal(TINY_OK)
        expect(pool.acquire().status.code).to_equal(TINY_ERR_CAPACITY)

    it "never wraps an exhausted generation into a reusable stale identity":
        step("Verify: never wraps an exhausted generation into a reusable stale identity")
        var pool = TinyGenerationalPool.with_capacity(2)
        pool.generations[0] = 2147483647
        val safe = pool.acquire()
        expect(safe.status.code).to_equal(TINY_OK)
        expect(safe.handle.index).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(safe.handle.generation).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pool.acquire().status.code).to_equal(TINY_ERR_CAPACITY)
