use std.nogc_sync_mut.tls.utilities.{tls_sha256, sha256}
use std.nogc_async_mut.tls.utilities.{sha256 as async_sha256}
use std.gc_async_mut.tls.utilities.{sha256 as gc_sha256}

describe "TLS SHA256 facade retains canonical provider aliases":
    it "uses the same helper under both names with the standard empty-input digest":
        val input: [i64] = []
        val expected = [227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36, 39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85]
        expect(tls_sha256(input)).to_equal(expected)
        expect(sha256(input)).to_equal(expected)

    it "preserves the existing asynchronous configured facade routes":
        val input: [i64] = [97, 98, 99]
        val expected = [186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173]
        expect(async_sha256(input)).to_equal(expected)
        expect(gc_sha256(input)).to_equal(expected)
