"""
## Purpose and audience
Purpose: Verify nogc_sync_immut PersistentMap native backend.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-MAP-FACADE-NATIVE-001 — stable requirement identity for this spec.

use std.nogc_sync_immut.{PersistentMap}

use std.spec.step

describe "nogc_sync_immut PersistentMap native backend":
    it "stores and retrieves a root-facade entry":
        step("Verify: stores and retrieves a root-facade entry")
        # @req: REQ-LIB-MAP-FACADE-NATIVE-001
        val base = PersistentMap.empty()
        val first = base.set("a", 1)

        expect(base.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "stores two root-facade entries":
        step("Verify: stores two root-facade entries")
        val first = PersistentMap.empty().set("a", 1).set("b", 2)

        expect(first.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "stores branch-shaped root-facade entries":
        step("Verify: stores branch-shaped root-facade entries")
        val base: PersistentMap = PersistentMap.empty()
        val first: PersistentMap = base.set("app", 1).set("apple", 2)

        expect(first.get("app")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.get("apple")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "overwrites branch-shaped root-facade entries":
        step("Verify: overwrites branch-shaped root-facade entries")
        val base: PersistentMap = PersistentMap.empty()
        val first: PersistentMap = base.set("app", 1).set("apple", 2)
        val overwritten: PersistentMap = first.set("app", 3)

        expect(overwritten.get("app")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(overwritten.get("apple")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(overwritten.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "removes branch-shaped root-facade entries":
        step("Verify: removes branch-shaped root-facade entries")
        val base: PersistentMap = PersistentMap.empty()
        val first: PersistentMap = base.set("app", 1).set("apple", 2)
        val removed: PersistentMap = first.remove("apple")

        expect(removed.get("app")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(removed.get("apple")).to_equal(nil)
        expect(removed.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
