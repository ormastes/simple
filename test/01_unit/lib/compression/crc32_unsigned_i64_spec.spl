# @cover src/lib/nogc_sync_mut/compression/gzip/crc.spl
use std.spec.*
use std.nogc_sync_mut.compression.gzip.crc.{crc32_calculate, crc32_text, crc32_update, crc32_finalize}
use std.common.text_bytes.{text_to_utf8_bytes}

describe "CRC32 unsigned words in i64 carriers":
    it "should return the independent standard text and byte known answer":
        step("Calculate the CRC-32/ISO-HDLC check value and the empty input")
        expect(crc32_text("123456789")).to_equal(3421780262)
        expect(crc32_calculate(text_to_utf8_bytes("123456789"))).to_equal(3421780262)
        expect(crc32_text("")).to_equal(0)

    it "should retain a high-bit-set streaming register across chunks":
        step("Continue from the independent pre-final CRC of abc")
        val first = crc32_update(4294967295, text_to_utf8_bytes("abc"))
        val second = crc32_update(first, text_to_utf8_bytes("def"))
        expect(first).to_equal(3403398717)
        expect(second).to_equal(3027355152)
        expect(crc32_finalize(second)).to_equal(1267612143)

    it "should preserve a valid register for nil input and finalize its low word":
        step("Use the no-op input contract and the all-ones initial register")
        expect(crc32_update(3403398717, nil)).to_equal(3403398717)
        expect(crc32_finalize(4294967295)).to_equal(0)
        expect(crc32_finalize(-1)).to_equal(0)
