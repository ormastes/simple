use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read_all}

describe "general exact RT/HAL process wire owner source contract":
    it "keeps the carrier scalar bounded and foreign-authority free":
        val source = file_read_all(
            "src/lib/nogc_sync_mut/rt_hal/exact_io_wire_owner.spl")
        expect(source).to_contain("type RtHalExactWireHandle = i64")
        expect(source).to_contain("var _wire_bytes: [u8] = []")
        expect(source).to_contain("capacity > 256")
        expect(source).to_contain("bytes_per_slot > 1048576")
        expect(source).to_contain("slot * _wire_bytes_per_slot + length")
        expect(source).to_contain("_wire_generation[slot] != generation")
        expect(source).to_contain("_wire_capability[slot] != handle")
        expect(source.contains("RtHalExactTypeAdmission")).to_equal(false)
        expect(source.contains("RtHalExactTypeRegistrySeal")).to_equal(false)

    it "exposes separate v1 and general v2 host callbacks":
        val arena = file_read_all(
            "src/lib/nogc_sync_mut/rt_hal/process_task_arena.spl")
        expect(arena).to_contain("spawn_compare_exact_fn")
        expect(arena).to_contain("spawn_compare_io_fn")
        expect(arena).to_contain("spawn_replay_io_fn")
        expect(arena).to_contain("join_io_until_fn")
        expect(arena).to_contain("pub struct RtHalIsolatedIoHostPortV2")
        expect(arena).to_contain("pub struct RtHalIsolatedExactHostPortV2")
        expect(arena).to_contain("pub struct RtHalIsolatedHostPort")
        expect(arena).to_contain("RTHAL-W-LEGACY-ORACLE-UNSAFE")
        expect(arena).to_contain("rt_hal_io_host_v2==nil")
