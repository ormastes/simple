# @cover src/lib/nogc_sync_mut/rt_hal/process_task_arena.spl 80%
use std.spec
use std.common.env_access.model.{EnvToolIdentity}
use std.common.rt_hal.model.{RtHalOperationKind}
use std.nogc_sync_mut.rt_hal.process_task_arena.*
use std.nogc_sync_mut.rt_hal.tagged.{RtHalTagPolicy, rt_hal_execute_registered_exact}
use std.nogc_sync_mut.rt_hal.exact_boundary.{
    RtHalDigest256, RtHalExactRequest, RtHalCanonicalReceipt, RtHalExactJoinV2,
    RtHalExactStatus
}
use std.nogc_sync_mut.rt_hal.exact_io_schema.{RtHalExactIoJoinStatus}
use std.nogc_sync_mut.rt_hal.exact_io_wire_owner.{
    RtHalExactWireHandle, RtHalExactWireJoin, rt_hal_exact_wire_failed_join
}

var fake_owner = 41
var fake_next_handle = 100
var fake_join_reaped = true
var fake_cancel_ok = true
var fake_close_ok = true
var fake_cancel_calls = 0
var fake_close_calls = 0
var fake_base_shutdown_ok=true
var fake_io_v2_shutdown_ok=true
var fake_io_v3_shutdown_ok=true
var fake_base_shutdown_calls=0
var fake_io_v2_shutdown_calls=0
var fake_io_v3_shutdown_calls=0
var fake_reentrant_bind=false
var fake_reentrant_io_v2_result=""
var fake_reentrant_io_v3_result=""
var fake_reentrant_shutdown_result=""
var fake_reentrant_owner=false

fn host_owner() -> i64:
    # This callback models a foreign ownership query which re-enters the
    # lifecycle.  It is one-shot to distinguish lock recursion from the
    # intended nested admission checks.
    if fake_reentrant_owner:
        fake_reentrant_owner=false
        fake_reentrant_io_v2_result=rt_hal_process_io_host_v2_install(secure_io_host_v2())
        fake_reentrant_io_v3_result=rt_hal_process_io_host_v3_install(secure_io_host_v3())
        fake_reentrant_shutdown_result=rt_hal_process_arena_shutdown()
    fake_owner
fn host_bind(handle: i64, provider: text, kind: text, tool_id: text, path: text, hash: text, schema: text) -> bool:
    # The native bind edge is an external callback.  It must not be able to
    # install a second IO port or start teardown between reservation and the
    # outer adapter commit.
    if fake_reentrant_bind:
        fake_reentrant_io_v2_result=rt_hal_process_io_host_v2_install(secure_io_host_v2())
        fake_reentrant_io_v3_result=rt_hal_process_io_host_v3_install(secure_io_host_v3())
        fake_reentrant_shutdown_result=rt_hal_process_arena_shutdown()
    handle > 0 and provider != "" and kind != "" and tool_id != "" and path.starts_with("/") and hash.starts_with("sha256:") and schema == "rthal-scalar-v2"
fn host_cancel(handle: i64, deadline: i64) -> bool:
    fake_cancel_calls = fake_cancel_calls + 1
    fake_cancel_ok
fn host_close(handle: i64) -> bool:
    fake_close_calls = fake_close_calls + 1
    fake_close_ok
fn host_shutdown() -> bool:
    fake_base_shutdown_calls=fake_base_shutdown_calls+1
    fake_base_shutdown_ok
fn host_io_v2_shutdown() -> bool:
    fake_io_v2_shutdown_calls=fake_io_v2_shutdown_calls+1
    fake_io_v2_shutdown_ok
fn host_io_v3_shutdown() -> bool:
    fake_io_v3_shutdown_calls=fake_io_v3_shutdown_calls+1
    fake_io_v3_shutdown_ok
fn host_deadline_after(timeout: i64) -> i64: timeout + 1000
fn host_compare_spawn(handle: i64, request: RtHalExactRequest) -> i64:
    fake_next_handle = fake_next_handle + 1
    fake_next_handle
fn host_replay_spawn(handle: i64, request: RtHalExactRequest, trace: RtHalDigest256) -> i64:
    fake_next_handle = fake_next_handle + 1
    fake_next_handle
fn digest(word: i64) -> RtHalDigest256:
    RtHalDigest256(word0: word, word1: word + 1, word2: word + 2, word3: word + 3)
fn host_exact_join(handle: i64, deadline: i64) -> RtHalExactJoinV2:
    RtHalExactJoinV2(completed: true, status: RtHalExactIoJoinStatus.Completed,
        child_exit_code: 0, reaped: fake_join_reaped, outcome_digest: digest(10),
        error_digest: digest(20), trace_digest: digest(30))
fn host_io_spawn(handle: i64, ordinal: i64, request: RtHalExactWireHandle) -> i64: -1
fn host_io_replay_spawn(handle: i64, ordinal: i64, request: RtHalExactWireHandle,
                        effect: RtHalExactWireHandle) -> i64: -1
fn host_io_join(handle: i64, deadline: i64) -> RtHalExactWireJoin:
    rt_hal_exact_wire_failed_join(RtHalExactIoJoinStatus.SpawnFailure, -1, false)
fn host_io_v3_bind(handle:i64, operation:text, adapter:i64, effect:bool)->bool:
    handle>0 and operation!="" and adapter>0

fn secure_host() -> RtHalIsolatedExactHostPortV2:
    RtHalIsolatedExactHostPortV2(
        capabilities: RtHalIsolatedHostCapabilities(
            available: true, canonical_executable_identity: true,
            static_executable_closure: true,
            fixed_scalar_argv: true, private_ipc: true,
            no_symlink_path_transport: true, process_tree_containment: true,
            bounded_timed_join: true, cancellation_and_reap: true,
            portable_host_contract: true, critical_no_alloc_dispatch: true
        ), current_owner_fn: host_owner, bind_adapter_fn: host_bind,
        cancel_and_reap_fn: host_cancel,
        close_fn: host_close,
        spawn_compare_exact_fn: host_compare_spawn,
        spawn_replay_exact_fn: host_replay_spawn,
        deadline_after_fn: host_deadline_after,
        join_exact_until_fn: host_exact_join,
        shutdown_fn: host_shutdown
    )

fn secure_io_host_v2()->RtHalIsolatedIoHostPortV2:
    RtHalIsolatedIoHostPortV2(available:true,
        cancel_and_reap_fn:host_cancel,close_fn:host_close,
        shutdown_fn:host_io_v2_shutdown,spawn_compare_io_fn:host_io_spawn,
        spawn_replay_io_fn:host_io_replay_spawn,join_io_until_fn:host_io_join)

fn secure_io_host_v3()->RtHalIsolatedIoHostPortV3:
    RtHalIsolatedIoHostPortV3(available:true,
        bind_operation_adapter_fn:host_io_v3_bind,cancel_and_reap_fn:host_cancel,
        close_fn:host_close,shutdown_fn:host_io_v3_shutdown,
        spawn_compare_io_fn:host_io_spawn,spawn_replay_io_fn:host_io_replay_spawn,
        join_io_until_fn:host_io_join)

fn tool(name: text) -> EnvToolIdentity:
    EnvToolIdentity(
        tool_id: name, canonical_path: "/opt/simple/{name}",
        identity_hash: "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    )

fn install_secure() -> text:
    if not rt_hal_process_lifecycle_begin_install("rt-hal-arena-unit"):return "RTHAL-E-LIFECYCLE"
    val installed=rt_hal_process_exact_host_v2_install(secure_host(),1)
    if installed!="":rt_hal_process_lifecycle_fail_install()
    installed

fn install_unavailable() -> text:
    if not rt_hal_process_lifecycle_begin_install("rt-hal-arena-unit"):return "RTHAL-E-LIFECYCLE"
    val installed=rt_hal_process_exact_host_v2_install(rt_hal_unavailable_isolated_exact_host_v2(),2)
    rt_hal_process_lifecycle_fail_install()
    installed

fn install_critical_forged_port() -> text:
    if not rt_hal_process_lifecycle_begin_install("rt-hal-critical-forged"):return "RTHAL-E-LIFECYCLE"
    val installed=rt_hal_process_exact_host_v2_install_for_assurance(secure_host(),1,3)
    rt_hal_process_lifecycle_fail_install()
    installed

fn controller_claim_ready() -> text:
    # The installation owner alone publishes the sealed catalog.  Tests may
    # then move the simulated controller to another owner before its claim.
    val controller_owner=fake_owner
    if rt_hal_process_lifecycle_is_installing():
        fake_owner=41
        if not rt_hal_process_lifecycle_mark_ready():
            fake_owner=controller_owner
            return "RTHAL-E-LIFECYCLE"
        fake_owner=controller_owner
    rt_hal_process_controller_claim()

fn shutdown_arena() -> text:
    if rt_hal_process_lifecycle_is_ready() and not rt_hal_process_lifecycle_begin_draining():
        return "RTHAL-E-LIFECYCLE"
    val shutdown=rt_hal_process_arena_shutdown()
    if shutdown=="" and rt_hal_process_lifecycle_is_draining():
        rt_hal_process_lifecycle_finish_closed()
    if shutdown=="" and rt_hal_process_lifecycle_is_installing():
        rt_hal_process_lifecycle_fail_install()
    shutdown

fn install_c_boundary() -> text:
    rt_hal_process_install_boundary_exact(true, false, 1, 1, 10, 1024)

describe "secure bounded RT/HAL isolated task arena":
    it "rejects forged public capability at Critical while lower assurance remains usable":
        expect(shutdown_arena()).to_equal("")
        # `secure_host` sets the public boolean true. That must not authorize
        # a Critical path without an opaque process-runtime attestation.
        expect(install_critical_forged_port()).to_equal("RTHAL-E-CRITICAL-HOST-ATTESTATION")
        expect(install_secure()).to_equal("")
        expect(shutdown_arena()).to_equal("")

    it "fails closed when any isolation capability is absent":
        expect(shutdown_arena()).to_equal("")
        expect(install_unavailable()).to_equal("RTHAL-W-PARALLEL-UNSUPPORTED")
        expect(rt_hal_process_exact_arena().capabilities.available).to_equal(false)

    it "publishes the exact registry once from the authoritative Installing owner":
        fake_owner=41
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(61, tool("c")))).to_equal("")
        fake_owner=42
        expect(install_c_boundary()).to_equal("RTHAL-E-OWNER")
        fake_owner=41
        expect(install_c_boundary()).to_equal("")
        # A second request in the same lifecycle must not replace the cache or
        # the already accepted lower-boundary registry.
        expect(install_c_boundary()).to_equal("RTHAL-E-ARENA-BUSY")
        expect(controller_claim_ready()).to_equal("")
        expect(shutdown_arena()).to_equal("")

    it "rejects premature Ready publication until the complete sealed catalog exists":
        fake_owner=41
        expect(install_secure()).to_equal("")
        fake_owner=42
        expect(rt_hal_process_lifecycle_mark_ready()).to_equal(false)
        fake_owner=41
        # A base host alone is deliberately insufficient: IO V2/V3, fixed
        # wire/task storage, adapters, operation/effect maps, boundary cache,
        # and both post-quiescence hooks must be installed before Ready seals.
        expect(rt_hal_process_lifecycle_mark_ready()).to_equal(false)
        expect(shutdown_arena()).to_equal("")

    it "rejects exact registry publication after Ready or Draining":
        fake_owner=41
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(62, tool("c")))).to_equal("")
        expect(install_c_boundary()).to_equal("")
        expect(controller_claim_ready()).to_equal("")
        expect(install_c_boundary()).to_equal("RTHAL-E-LIFECYCLE")
        expect(rt_hal_process_lifecycle_begin_draining()).to_equal(true)
        expect(install_c_boundary()).to_equal("RTHAL-E-LIFECYCLE")
        expect(shutdown_arena()).to_equal("")

    it "rejects IO installation and teardown reentry during an adapter bind reservation":
        fake_owner=41
        fake_reentrant_bind=true
        fake_reentrant_io_v2_result=""
        fake_reentrant_io_v3_result=""
        fake_reentrant_shutdown_result=""
        expect(install_secure()).to_equal("")
        # The outer reservation remains authoritative and commits exactly its
        # own adapter; callback attempts cannot publish ports or drain it.
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(63, tool("c")))).to_equal("")
        fake_reentrant_bind=false
        expect(fake_reentrant_io_v2_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(fake_reentrant_io_v3_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(fake_reentrant_shutdown_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(rt_hal_process_lifecycle_is_installing()).to_equal(true)
        # Clearing the outer reservation leaves a coherent installer state;
        # it may cleanly roll back instead of being stranded in Installing.
        expect(shutdown_arena()).to_equal("")

    it "rejects direct IO host installation by a non-installer owner":
        fake_owner=41
        expect(install_secure()).to_equal("")
        # Installing alone conveys no IO-host authority.  The host's current
        # external owner must still be the original admitted installer.
        fake_owner=42
        expect(rt_hal_process_io_host_v2_install(secure_io_host_v2())).to_equal("RTHAL-E-OWNER")
        expect(rt_hal_process_io_host_v3_install(secure_io_host_v3())).to_equal("RTHAL-E-OWNER")
        fake_owner=41
        expect(rt_hal_process_io_host_v2_install(secure_io_host_v2())).to_equal("")
        expect(rt_hal_process_io_host_v3_install(secure_io_host_v3())).to_equal("")
        expect(shutdown_arena()).to_equal("")

    it "reserves initial host admission before a reentrant owner callback":
        fake_owner=41
        fake_reentrant_owner=true
        fake_reentrant_io_v2_result=""
        fake_reentrant_io_v3_result=""
        fake_reentrant_shutdown_result=""
        # No exact host has been published while the owner callback runs, and
        # the reservation prevents a nested path from turning that gap into
        # an installation or teardown authority.
        expect(install_secure()).to_equal("")
        fake_reentrant_owner=false
        expect(fake_reentrant_io_v2_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(fake_reentrant_io_v3_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(fake_reentrant_shutdown_result).to_equal("")
        expect(rt_hal_process_lifecycle_is_installing()).to_equal(true)
        expect(shutdown_arena()).to_equal("")

    it "keeps boundary owner-query reentry outside the lifecycle lock and rolls back cleanly":
        fake_owner=41
        fake_reentrant_bind=false
        fake_reentrant_owner=false
        fake_reentrant_io_v2_result=""
        fake_reentrant_io_v3_result=""
        fake_reentrant_shutdown_result=""
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(64, tool("c")))).to_equal("")
        # `current_owner_fn` runs while the boundary-install reservation is
        # held but after the mutex is released. Its nested mutations must
        # fail; the outer publication remains the only committed change.
        fake_reentrant_owner=true
        expect(install_c_boundary()).to_equal("")
        expect(fake_reentrant_io_v2_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(fake_reentrant_io_v3_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(fake_reentrant_shutdown_result).to_equal("RTHAL-E-LIFECYCLE")
        expect(rt_hal_process_lifecycle_is_installing()).to_equal(true)
        expect(shutdown_arena()).to_equal("")
        expect(rt_hal_process_lifecycle_is_closed()).to_equal(true)
        expect(rt_hal_process_lifecycle_begin_install("rt-hal-owner-reentry-fresh")).to_equal(true)
        rt_hal_process_lifecycle_fail_install()

    it "persists each host shutdown acknowledgement across ordered retry":
        fake_owner=41
        fake_base_shutdown_ok=true
        fake_io_v2_shutdown_ok=true
        fake_io_v3_shutdown_ok=false
        fake_base_shutdown_calls=0
        fake_io_v2_shutdown_calls=0
        fake_io_v3_shutdown_calls=0
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_io_host_v2_install(secure_io_host_v2())).to_equal("")
        expect(rt_hal_process_io_host_v3_install(secure_io_host_v3())).to_equal("")
        expect(controller_claim_ready()).to_equal("")
        # V2 acknowledgement is durable; V3 failure prevents the base host
        # from observing shutdown until the pinned V3 executable is closed.
        expect(shutdown_arena()).to_equal("RTHAL-E-IO-V3-SHUTDOWN")
        expect(fake_io_v2_shutdown_calls).to_equal(1)
        expect(fake_io_v3_shutdown_calls).to_equal(1)
        expect(fake_base_shutdown_calls).to_equal(0)
        fake_io_v3_shutdown_ok=true
        expect(shutdown_arena()).to_equal("")
        expect(fake_io_v2_shutdown_calls).to_equal(1)
        expect(fake_io_v3_shutdown_calls).to_equal(2)
        expect(fake_base_shutdown_calls).to_equal(1)
        expect(rt_hal_process_lifecycle_finish_closed()).to_equal(true)

    it "keeps a partial install rollback draining until its pinned host closes":
        fake_owner=41
        fake_base_shutdown_ok=true
        fake_base_shutdown_calls=0
        expect(install_secure()).to_equal("")
        rt_hal_process_lifecycle_fail_install()
        expect(rt_hal_process_lifecycle_is_draining()).to_equal(true)
        expect(rt_hal_process_lifecycle_is_closed()).to_equal(false)
        # The installer is allowed to become the one teardown controller; a
        # replacement installer stays excluded until this acknowledgement.
        expect(rt_hal_process_controller_claim()).to_equal("")
        expect(shutdown_arena()).to_equal("")
        expect(fake_base_shutdown_calls).to_equal(1)
        expect(rt_hal_process_lifecycle_finish_closed()).to_equal(true)

    it "admits exactly one controller owner after a contested claim":
        fake_owner=41
        expect(install_secure()).to_equal("")
        expect(controller_claim_ready()).to_equal("")
        fake_owner=42
        expect(rt_hal_process_controller_claim()).to_equal("RTHAL-E-OWNER")
        fake_owner=41
        expect(shutdown_arena()).to_equal("")

    it "rejects unpinned and noncanonical executable identities":
        val invalid = rt_hal_c_process_adapter(2, EnvToolIdentity(
            tool_id: "c", canonical_path: "c-worker", identity_hash: "latest"
        ))
        expect(rt_hal_process_adapter_error(invalid)).to_equal("RTHAL-E-PROVIDER-ID")

    it "separates installer and cold controller ownership":
        fake_owner = 41
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(1, tool("c")))).to_equal("")
        val request = RtHalExactRequest(
            case_id: 7, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val receipt = RtHalCanonicalReceipt(
            case_id: 7, outcome_digest: digest(10), error_digest: digest(20),
            trace_digest: digest(30), observed_once: true
        )
        val port = rt_hal_process_exact_arena()
        expect(port.spawn_compare_fn(1, request)).to_equal(-1)
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val handle = port.spawn_compare_fn(1, request)
        expect(handle > 0).to_equal(true)
        fake_owner = 41
        expect(port.join_until_fn(handle, 1010).completed).to_equal(false)
        fake_owner = 42
        expect(port.join_until_fn(handle, 1010).completed).to_equal(true)
        expect(shutdown_arena()).to_equal("")

    it "keeps a completed but unreaped exact task reserved until controller cleanup":
        fake_owner = 41
        fake_join_reaped = false
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(31, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val request = RtHalExactRequest(
            case_id: 11, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val port = rt_hal_process_exact_arena()
        val handle = port.spawn_compare_fn(31, request)
        expect(handle > 0).to_equal(true)
        expect(port.join_until_fn(handle, 1010).completed).to_equal(true)
        # A completed observation without a reap cannot make the one-slot
        # arena reusable under a new generation.
        expect(port.spawn_compare_fn(31, request)).to_equal(-1)
        expect(port.cancel_fn(handle)).to_equal(true)
        expect(port.spawn_compare_fn(31, request) > 0).to_equal(true)
        expect(shutdown_arena()).to_equal("")

    it "releases a completed and reaped exact task on the fast path":
        fake_owner = 41
        fake_join_reaped = true
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(32, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val request = RtHalExactRequest(
            case_id: 12, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val port = rt_hal_process_exact_arena()
        val handle = port.spawn_compare_fn(32, request)
        expect(handle > 0).to_equal(true)
        expect(port.join_until_fn(handle, 1010).completed).to_equal(true)
        expect(port.spawn_compare_fn(32, request) > 0).to_equal(true)
        expect(shutdown_arena()).to_equal("")

    it "retains the generation slot and blocks reinstall when rollback cancel fails":
        fake_owner = 41
        fake_cancel_ok = true
        fake_close_ok = true
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(41, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val request = RtHalExactRequest(
            case_id: 41, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val port = rt_hal_process_exact_arena()
        val handle = port.spawn_compare_fn(41, request)
        expect(handle > 0).to_equal(true)
        # A rollback cleanup failure may not release this slot for a new
        # generation, nor may arena shutdown permit a replacement host.
        fake_cancel_ok = false
        expect(port.cancel_fn(handle)).to_equal(false)
        expect(port.spawn_compare_fn(41, request)).to_equal(-1)
        expect(shutdown_arena()).to_equal("RTHAL-E-REAP")
        expect(install_secure()).to_equal("RTHAL-E-LIFECYCLE")
        fake_cancel_ok = true
        expect(shutdown_arena()).to_equal("")

    it "retries reap before a single close acknowledgement":
        fake_owner = 41
        fake_cancel_ok = true
        fake_close_ok = true
        fake_cancel_calls = 0
        fake_close_calls = 0
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(46, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val request = RtHalExactRequest(
            case_id: 46, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val port = rt_hal_process_exact_arena()
        val handle = port.spawn_compare_fn(46, request)
        expect(handle > 0).to_equal(true)
        # A reap failure retains the active generation and must not consume
        # its process handle through close.
        fake_cancel_ok = false
        expect(port.cancel_fn(handle)).to_equal(false)
        expect(fake_cancel_calls).to_equal(1)
        expect(fake_close_calls).to_equal(0)
        # The next cleanup begins with reap again; only its acknowledged
        # success permits exactly one close transition.
        fake_cancel_ok = true
        expect(port.cancel_fn(handle)).to_equal(true)
        expect(fake_cancel_calls).to_equal(2)
        expect(fake_close_calls).to_equal(1)
        expect(shutdown_arena()).to_equal("")

    it "retains the generation slot and blocks reinstall when rollback close fails":
        fake_owner = 41
        fake_cancel_ok = true
        fake_close_ok = true
        fake_cancel_calls = 0
        fake_close_calls = 0
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(42, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val request = RtHalExactRequest(
            case_id: 42, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val port = rt_hal_process_exact_arena()
        val handle = port.spawn_compare_fn(42, request)
        expect(handle > 0).to_equal(true)
        fake_close_ok = false
        expect(port.cancel_fn(handle)).to_equal(false)
        expect(fake_cancel_calls).to_equal(1)
        expect(fake_close_calls).to_equal(1)
        expect(port.spawn_compare_fn(42, request)).to_equal(-1)
        expect(shutdown_arena()).to_equal("RTHAL-E-CLOSE")
        # Reap was already acknowledged.  Draining retries only close, never
        # a potentially non-idempotent cancel/reap operation.
        expect(fake_cancel_calls).to_equal(1)
        expect(fake_close_calls).to_equal(2)
        expect(install_secure()).to_equal("RTHAL-E-LIFECYCLE")
        fake_close_ok = true
        expect(shutdown_arena()).to_equal("")

    it "persists a join reap acknowledgement across close retry":
        fake_owner = 41
        fake_join_reaped = true
        fake_cancel_ok = true
        fake_close_ok = false
        fake_cancel_calls = 0
        fake_close_calls = 0
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(43, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        val request = RtHalExactRequest(
            case_id: 43, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val port = rt_hal_process_exact_arena()
        val handle = port.spawn_compare_fn(43, request)
        expect(handle > 0).to_equal(true)
        # Join reports reap, but close fails.  The slot remains reserved.
        expect(port.join_until_fn(handle, 1010).completed).to_equal(false)
        expect(fake_cancel_calls).to_equal(0)
        expect(fake_close_calls).to_equal(1)
        fake_close_ok = true
        expect(port.cancel_fn(handle)).to_equal(true)
        expect(fake_cancel_calls).to_equal(0)
        expect(fake_close_calls).to_equal(2)
        expect(shutdown_arena()).to_equal("")

    it "closes controller spawn admission before draining teardown":
        fake_owner = 41
        fake_join_reaped = true
        fake_cancel_ok = true
        fake_close_ok = true
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(44, tool("c")))).to_equal("")
        fake_owner = 42
        expect(controller_claim_ready()).to_equal("")
        expect(rt_hal_process_lifecycle_begin_draining()).to_equal(true)
        val request = RtHalExactRequest(
            case_id: 44, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        # Ready->Draining is the controller-owned cutoff: an old installer
        # cannot mutate provider state and a controller cannot start a child.
        expect(rt_hal_process_exact_arena().spawn_compare_fn(44, request)).to_equal(-1)
        fake_owner = 41
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(45, tool("c")))).to_equal("RTHAL-E-OWNER")
        fake_owner = 42
        expect(shutdown_arena()).to_equal("")

    it "compares foreign exact digests without re-executing Pure":
        fake_owner = 41
        expect(install_secure()).to_equal("")
        expect(rt_hal_process_adapter_register(rt_hal_c_process_adapter(21, tool("c")))).to_equal("")
        expect(controller_claim_ready()).to_equal("")
        val policy = RtHalTagPolicy(
            compare_c: true, compare_rust: false,
            worker_count: 1, queue_capacity: 2,
            timeout_ticks: 10, max_output_bytes: 1024,
            require_all: true)
        val request = RtHalExactRequest(
            case_id: 9, operation: RtHalOperationKind.Query,
            operation_digest: digest(1), input_digest: digest(2)
        )
        val receipt = RtHalCanonicalReceipt(
            case_id: 9, outcome_digest: digest(10), error_digest: digest(20),
            trace_digest: digest(30), observed_once: true
        )
        val report = rt_hal_execute_registered_exact(policy, [request], [receipt])
        expect(report.error).to_equal("")
        expect(report.results.len()).to_equal(1)
        expect(report.submitted_tasks).to_equal(1)
        expect(report.completed_tasks).to_equal(1)
        expect(report.results[0].status).to_equal(RtHalExactStatus.Match)
        expect(report.results[0].provider_id).to_equal("c-comparator")
        expect(report.actual_parallel).to_equal(false)
        expect(shutdown_arena()).to_equal("")
