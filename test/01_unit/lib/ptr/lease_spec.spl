# @req AC-BOR04
# Scalar library lifetime checks; compiler static escape checking is separate.
use std.spec.*
use std.nogc_sync_mut.ptr.weak.{weak_reset, weak_register, weak_create, weak_remove_strong}
use std.nogc_sync_mut.ptr.lease.{LeaseView, lease_acquire, lease_release, lease_with_view, lease_view_read, lease_with_view_result}

var lease_spec_saved = LeaseView(view_id: -1, epoch: -1)
var lease_spec_values: [i64] = []
var lease_spec_old_readable: bool = false

fn lease_spec_save(view: LeaseView):
    if lease_view_read(lease_spec_saved) != nil:
        lease_spec_old_readable = true
    if val value = lease_view_read(view):
        lease_spec_values.push(value)
    lease_spec_saved = view

fn lease_spec_error() -> Result<i64, text>:
    Err("callback failed")

fn lease_spec_failure_view(view: LeaseView) -> Result<i64, text>:
    lease_spec_saved = view
    val result = lease_spec_error()?
    Ok(result)

fn lease_spec_success_view(view: LeaseView) -> Result<i64, text>:
    lease_spec_saved = view
    Ok(17)

describe "retained scalar lease fresh short views":
    it "retains after original owner release and invalidates each callback epoch":
        weak_reset()
        lease_spec_values = []
        lease_spec_old_readable = false
        val target = weak_register(42)
        val acquired = lease_acquire(weak_create(target))
        expect(acquired != nil).to_equal(true)
        if val lease = acquired:
            weak_remove_strong(target)
            expect(lease_with_view(lease, lease_spec_save)).to_equal(true)
            expect(lease_view_read(lease_spec_saved)).to_be_nil()
            expect(lease_with_view(lease, lease_spec_save)).to_equal(true)
            expect(lease_spec_values).to_equal([42, 42])
            expect(lease_spec_old_readable).to_equal(false)
            expect(lease_view_read(lease_spec_saved)).to_be_nil()
            expect(lease_release(lease)).to_equal(true)
            expect(lease_release(lease)).to_equal(false)
            expect(lease_with_view(lease, lease_spec_save)).to_equal(false)

    it "revokes saved views and leases across reset":
        weak_reset()
        val target = weak_register(-1)
        val acquired = lease_acquire(weak_create(target))
        expect(acquired != nil).to_equal(true)
        if val lease = acquired:
            expect(lease_with_view(lease, lease_spec_save)).to_equal(true)
            weak_reset()
            expect(lease_view_read(lease_spec_saved)).to_be_nil()
            expect(lease_with_view(lease, lease_spec_save)).to_equal(false)
            expect(lease_release(lease)).to_equal(false)

    it "rejects fabricated out-of-range views":
        expect(lease_view_read(LeaseView(view_id: -1, epoch: 1))).to_be_nil()
        expect(lease_view_read(LeaseView(view_id: 999999, epoch: 1))).to_be_nil()

    it "cleans up before propagating callback errors and permits a fresh view":
        weak_reset()
        val target = weak_register(42)
        val acquired = lease_acquire(weak_create(target))
        expect(acquired != nil).to_equal(true)
        if val lease = acquired:
            val failure = lease_with_view_result(lease, lease_spec_failure_view)
            match failure:
                case Err(message): expect(message).to_equal("callback failed")
                case _: expect("unexpected success").to_equal("error")
            expect(lease_view_read(lease_spec_saved)).to_be_nil()
            val success = lease_with_view_result(lease, lease_spec_success_view)
            match success:
                case Ok(value): expect(value).to_equal(17)
                case _: expect("unexpected error").to_equal("success")
            expect(lease_view_read(lease_spec_saved)).to_be_nil()
            expect(lease_release(lease)).to_equal(true)
