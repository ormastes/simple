# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# DataFrame unique/nunique O(n^2) -> O(n) regression coverage

**Context:** `Series.unique_f64` / `Series.unique_i64` (src/lib/nogc_sync_mut/df/mod.spl)
used to grow a `seen` array and call `f64_group_index` / `i64_group_index`
(linear scan) per element, making them O(n^2). Fixed to use a local Dict
membership index (O(n)). This spec locks in: first-occurrence order,
missing-value handling, duplicate collapsing, float edge cases (NaN, -0.0
vs 0.0), and a scaling case large enough that an O(n^2) regression would be
obviously slower under `time`.
"""

use std.spec.step

use std.spipe.*
use std.df.*
use std.ndarray.*


describe "Series unique_i64 (order, duplicates, missing)":
    it "keeps first-occurrence order and collapses duplicates":
        step("keeps first-occurrence order and collapses duplicates")
        val ms = Series.from_i64_masked(
            Symbol.from("g"),
            [Int64.new(5), Int64.new(1), Int64.new(5), Int64.new(1), Int64.new(9), Int64.new(1)],
            [Bool.new(false), Bool.new(false), Bool.new(false), Bool.new(false), Bool.new(false), Bool.new(false)]
        )
        val s = ms.unwrap()
        val u = s.unique_i64()
        expect(u.len()).to_equal(Index.new(3))
        expect(u.values.flat_i64(Index.new(0))).to_equal(Int64.new(5))
        expect(u.values.flat_i64(Index.new(1))).to_equal(Int64.new(1))
        expect(u.values.flat_i64(Index.new(2))).to_equal(Int64.new(9))

    it "treats a missing value as a single distinct entry regardless of repeats":
        step("treats a missing value as a single distinct entry regardless of repeats")
        val ms = Series.from_i64_masked(
            Symbol.from("g"),
            [Int64.new(1), Int64.new(0), Int64.new(0), Int64.new(2)],
            [Bool.new(false), Bool.new(true), Bool.new(true), Bool.new(false)]
        )
        val s = ms.unwrap()
        val u = s.unique_i64()
        expect(u.len()).to_equal(Index.new(3))

describe "Series unique_f64 (order, duplicates, missing, float edge cases)":
    it "keeps first-occurrence order and collapses duplicates":
        step("keeps first-occurrence order and collapses duplicates")
        val s = Series.from_values(
            name: Symbol.from("x"),
            values: [Float64.new(3.0), Float64.new(1.0), Float64.new(3.0), Float64.new(2.0), Float64.new(1.0)]
        )
        val u = s.unique_f64()
        expect(u.len()).to_equal(Index.new(3))
        expect(u.values.flat_f64(Index.new(0))).to_equal(Float64.new(3.0))
        expect(u.values.flat_f64(Index.new(1))).to_equal(Float64.new(1.0))
        expect(u.values.flat_f64(Index.new(2))).to_equal(Float64.new(2.0))

    it "treats a missing value as a single distinct entry regardless of repeats":
        step("treats a missing value as a single distinct entry regardless of repeats")
        val ms = Series.from_f64_masked(
            Symbol.from("x"),
            [Float64.new(1.0), Float64.new(0.0), Float64.new(0.0), Float64.new(2.0)],
            [Bool.new(false), Bool.new(true), Bool.new(true), Bool.new(false)]
        )
        val s = ms.unwrap()
        val u = s.unique_f64()
        expect(u.len()).to_equal(Index.new(3))

    it "collapses -0.0 into a prior 0.0, matching f64 == semantics (first occurrence wins)":
        step("collapses -0.0 into a prior 0.0, matching f64 == semantics")
        val s = Series.from_values(
            name: Symbol.from("z"),
            values: [Float64.new(0.0), Float64.new(-0.0), Float64.new(1.0)]
        )
        val u = s.unique_f64()
        # 0.0 == -0.0 under IEEE 754, so -0.0 must NOT create a second entry.
        expect(u.len()).to_equal(Index.new(2))
        expect(u.values.flat_f64(Index.new(0))).to_equal(Float64.new(0.0))
        expect(u.values.flat_f64(Index.new(1))).to_equal(Float64.new(1.0))

    it "collapses 0.0 into a prior -0.0 the same way (order-independent)":
        step("collapses 0.0 into a prior -0.0 the same way")
        val s = Series.from_values(
            name: Symbol.from("z2"),
            values: [Float64.new(-0.0), Float64.new(0.0), Float64.new(1.0)]
        )
        val u = s.unique_f64()
        expect(u.len()).to_equal(Index.new(2))

    it "never collapses NaN with itself, matching f64 == semantics (NaN != NaN)":
        step("never collapses NaN with itself")
        val big = 1.0e308
        val pos_inf = big * 10.0
        val nan1 = pos_inf - pos_inf
        val nan2 = (0.0 - pos_inf) + pos_inf
        val s = Series.from_values(
            name: Symbol.from("n"),
            values: [Float64.new(1.0), Float64.new(nan1), Float64.new(nan1), Float64.new(nan2)]
        )
        val u = s.unique_f64()
        # 1.0 once, then three NaN occurrences, each treated as a fresh
        # "not found" per f64_group_index's `==`-based scan (NaN != NaN).
        expect(u.len()).to_equal(Index.new(4))

describe "Series nunique":
    it "delegates to unique_i64/unique_f64 and counts distinct values":
        step("delegates to unique_i64/unique_f64 and counts distinct values")
        val s = Series.from_values(
            name: Symbol.from("x"),
            values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0), Float64.new(3.0)]
        )
        expect(s.nunique()).to_equal(Index.new(3))

describe "unique_f64 / unique_i64 scaling (O(n) evidence)":
    # Sizes here are deliberately smaller than the 20000/10000 case measured
    # by hand for the perf writeup: on the O(n^2) linear-scan baseline,
    # n=20000/distinct=10000 does not finish inside this test runner's 120s
    # per-file budget at all (measured: killed at the 120s timeout). Against
    # this fix it completes in ~93s standalone, but combining it with the
    # other `it` blocks in this same file risks exceeding the shared 120s
    # file budget, so the committed scaling case uses n=3000/distinct=1500
    # (measured ~2-3s here) to stay reliably inside budget while still
    # exercising the Dict path at a size well beyond "a few elements".
    it "completes for 3000 values with 1500 distinct without excessive cost":
        step("completes for 3000 values with 1500 distinct values")
        var values: [Float64] = []
        var i = 0
        while i < 3000:
            values.push(Float64.new((i % 1500) as f64))
            i = i + 1
        val s = Series.from_values(name: Symbol.from("scale"), values: values)
        val u = s.unique_f64()
        expect(u.len()).to_equal(Index.new(1500))

    it "completes for 3000 Int64 values with 1500 distinct without excessive cost":
        step("completes for 3000 Int64 values with 1500 distinct values")
        var values: [Int64] = []
        var missing: [Bool] = []
        var i = 0
        while i < 3000:
            values.push(Int64.new(i % 1500))
            missing.push(Bool.new(false))
            i = i + 1
        val ms = Series.from_i64_masked(Symbol.from("scale_i"), values, missing)
        val s = ms.unwrap()
        val u = s.unique_i64()
        expect(u.len()).to_equal(Index.new(1500))

describe "value_counts (group_index -> Dict membership, same n^2 pattern)":
    it "counts occurrences per distinct value in first-occurrence key order":
        step("counts occurrences per distinct value in first-occurrence key order")
        val s = Series.from_values(
            name: Symbol.from("color"),
            values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0), Float64.new(3.0), Float64.new(2.0), Float64.new(2.0)]
        )
        val vc = value_counts(s)
        expect(vc.num_rows()).to_equal(Index.new(3))
        val counts = vc.col(Symbol.from("count")).unwrap()
        expect(counts.values.flat_i64(Index.new(0))).to_equal(Int64.new(2))
        expect(counts.values.flat_i64(Index.new(1))).to_equal(Int64.new(3))
        expect(counts.values.flat_i64(Index.new(2))).to_equal(Int64.new(1))

describe "groupby_numeric (group_index -> Dict slot index, same n^2 pattern)":
    it "sums values per distinct F64 key in first-occurrence key order":
        step("sums values per distinct F64 key in first-occurrence key order")
        val df = DataFrame.from_columns([
            SeriesErased.F64Series(Series.from_values(name: Symbol.from("k"), values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0)])),
            SeriesErased.F64Series(Series.from_values(name: Symbol.from("v"), values: [Float64.new(10.0), Float64.new(20.0), Float64.new(5.0)])),
        ]).unwrap()
        val grouped = df.groupby_sum(Symbol.from("k"), Symbol.from("v")).unwrap()
        val keys = grouped.col(Symbol.from("k")).unwrap()
        val vals = grouped.col(Symbol.from("v")).unwrap()
        expect(grouped.num_rows()).to_equal(Index.new(2))
        expect(keys.values.flat_f64(Index.new(0))).to_equal(Float64.new(1.0))
        expect(vals.values.flat_f64(Index.new(0))).to_equal(Float64.new(15.0))
        expect(keys.values.flat_f64(Index.new(1))).to_equal(Float64.new(2.0))
        expect(vals.values.flat_f64(Index.new(1))).to_equal(Float64.new(20.0))
