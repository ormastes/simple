# Play Expect Unit Tests
#
# **Feature IDs:** #PLAY-003
# **Category:** Stdlib | Play
# **Difficulty:** 2/5
# **Status:** Implemented
#
# ## Overview
# Validates the expect module factory functions and option defaults.
# Cannot test actual retry semantics without a live CDP session, so this
# spec focuses on the construction and default values.

"""
## Purpose and audience
Purpose: Verify default_expect_options.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-EXPECT-001 — stable requirement identity for this spec.

use std.play.expect.{expect_page, expect_locator, expect_page_with, expect_locator_with, PageExpect, LocatorExpect}
use std.play.types.*

# ============================================================================
# ExpectOptions defaults
# ============================================================================

use std.spec.step

describe "default_expect_options":
    it "has 5000ms timeout":
        step("Verify: has 5000ms timeout")
        # @req: REQ-LIB-EXPECT-001
        val opts = default_expect_options()
        expect(opts.timeout_ms).to_equal(5000)  # oracle: authoritative expected value documented by this spec's contract

    it "has 100ms poll interval":
        step("Verify: has 100ms poll interval")
        val opts = default_expect_options()
        expect(opts.poll_interval_ms).to_equal(100)  # oracle: authoritative expected value documented by this spec's contract

    it "has empty message":
        step("Verify: has empty message")
        val opts = default_expect_options()
        expect(opts.message).to_equal("")

# ============================================================================
# WaitForOptions defaults
# ============================================================================

describe "default_wait_for_options":
    it "state is visible":
        step("Verify: state is visible")
        val opts = default_wait_for_options()
        expect(opts.state).to_equal("visible")

    it "timeout is 30000":
        step("Verify: timeout is 30000")
        val opts = default_wait_for_options()
        expect(opts.timeout_ms).to_equal(30000)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# ScreenshotOptions defaults
# ============================================================================

describe "default_screenshot_options":
    it "image type is png":
        step("Verify: image type is png")
        val opts = default_screenshot_options()
        expect(opts.image_type).to_equal("png")

    it "full_page is false":
        step("Verify: full_page is false")
        val opts = default_screenshot_options()
        expect(opts.full_page).to_equal(false)

    it "quality is 90":
        step("Verify: quality is 90")
        val opts = default_screenshot_options()
        expect(opts.quality).to_equal(90)  # oracle: authoritative expected value documented by this spec's contract
