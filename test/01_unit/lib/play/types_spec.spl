# ## Overview
# Validates foundation types, constants, and factory functions for std.play.

"""
## Purpose and audience
Purpose: Verify Play backend constants.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-TYPES-001 — stable requirement identity for this spec.

use std.play.types.*

# ============================================================================
# Constants
# ============================================================================

use std.spec.step

describe "Play backend constants":
    it "defines BACKEND_CDP":
        step("Verify: defines BACKEND_CDP")
        # @req: REQ-LIB-TYPES-001
        expect(BACKEND_CDP).to_equal("cdp")

    it "defines BACKEND_SDL2":
        step("Verify: defines BACKEND_SDL2")
        expect(BACKEND_SDL2).to_equal("sdl2")

    it "defines BACKEND_WM":
        step("Verify: defines BACKEND_WM")
        expect(BACKEND_WM).to_equal("wm")

    it "defines BACKEND_ORCHESTRATOR":
        step("Verify: defines BACKEND_ORCHESTRATOR")
        expect(BACKEND_ORCHESTRATOR).to_equal("orchestrator")

describe "Play state constants":
    it "defines STATE_READY":
        step("Verify: defines STATE_READY")
        expect(STATE_READY).to_equal("ready")

    it "defines STATE_CLOSED":
        step("Verify: defines STATE_CLOSED")
        expect(STATE_CLOSED).to_equal("closed")

    it "defines STATE_FAILED":
        step("Verify: defines STATE_FAILED")
        expect(STATE_FAILED).to_equal("failed")

describe "Play timeout defaults":
    it "expect timeout is 5000":
        step("Verify: expect timeout is 5000")
        expect(DEFAULT_EXPECT_TIMEOUT_MS).to_equal(5000)  # oracle: authoritative expected value documented by this spec's contract

    it "action timeout is 30000":
        step("Verify: action timeout is 30000")
        expect(DEFAULT_ACTION_TIMEOUT_MS).to_equal(30000)  # oracle: authoritative expected value documented by this spec's contract

    it "poll interval is 100":
        step("Verify: poll interval is 100")
        expect(DEFAULT_POLL_INTERVAL_MS).to_equal(100)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Factory functions
# ============================================================================

describe "default_launch_options":
    it "returns empty executable_path":
        step("Verify: returns empty executable_path")
        val opts = default_launch_options()
        expect(opts.executable_path).to_equal("")

    it "returns empty args":
        step("Verify: returns empty args")
        val opts = default_launch_options()
        expect(opts.args.length()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "has xvfb enabled by default":
        step("Verify: has xvfb enabled by default")
        val opts = default_launch_options()
        expect(opts.xvfb).to_equal(true)

    it "has headless false by default":
        step("Verify: has headless false by default")
        val opts = default_launch_options()
        expect(opts.headless).to_equal(false)

    it "has 30s launch timeout":
        step("Verify: has 30s launch timeout")
        val opts = default_launch_options()
        expect(opts.timeout_ms).to_equal(30000)  # oracle: authoritative expected value documented by this spec's contract

describe "default_click_options":
    it "defaults to left button":
        step("Verify: defaults to left button")
        val opts = default_click_options()
        expect(opts.button).to_equal("left")

    it "defaults to 1 click":
        step("Verify: defaults to 1 click")
        val opts = default_click_options()
        expect(opts.click_count).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "defaults to no force":
        step("Verify: defaults to no force")
        val opts = default_click_options()
        expect(opts.force).to_equal(false)

describe "empty_play_session":
    it "has empty id":
        step("Verify: has empty id")
        val s = empty_play_session()
        expect(s.id).to_equal("")

    it "has closed state":
        step("Verify: has closed state")
        val s = empty_play_session()
        expect(s.state).to_equal("closed")

    it "has pid -1":
        step("Verify: has pid -1")
        val s = empty_play_session()
        expect(s.pid).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract

    it "has no windows":
        step("Verify: has no windows")
        val s = empty_play_session()
        expect(s.windows.length()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "play_error":
    it "sets code and message":
        step("Verify: sets code and message")
        val e = play_error("TEST_ERR", "test message")
        expect(e.code).to_equal("TEST_ERR")
        expect(e.message).to_equal("test message")
        expect(e.detail).to_equal("")

describe "play_error_with_detail":
    it "sets code message and detail":
        step("Verify: sets code message and detail")
        val e = play_error_with_detail("CODE", "msg", "extra")
        expect(e.code).to_equal("CODE")
        expect(e.message).to_equal("msg")
        expect(e.detail).to_equal("extra")

# ============================================================================
# Locator constructors
# ============================================================================

describe "locator_css":
    it "creates css locator":
        step("Verify: creates css locator")
        val loc = locator_css("#button")
        expect(loc.selector).to_equal("#button")
        expect(loc.strategy).to_equal("css")
        expect(loc.nth).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract

describe "locator_role":
    it "creates role locator":
        step("Verify: creates role locator")
        val loc = locator_role("button", "Submit")
        expect(loc.selector).to_equal("button")
        expect(loc.strategy).to_equal("role")
        expect(loc.has_text).to_equal("Submit")

describe "locator_test_id":
    it "creates test-id locator":
        step("Verify: creates test-id locator")
        val loc = locator_test_id("my-btn")
        expect(loc.selector).to_equal("my-btn")
        expect(loc.strategy).to_equal("test-id")

describe "locator_text":
    it "creates text locator":
        step("Verify: creates text locator")
        val loc = locator_text("Click me")
        expect(loc.selector).to_equal("Click me")
        expect(loc.strategy).to_equal("text")
