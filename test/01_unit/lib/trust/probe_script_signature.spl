# CLI probe for std.nogc_sync_mut.trust.script_signature.
# Run: bin/simple run test/01_unit/lib/trust/probe_script_signature.spl
#
# Verifies the committed shell-signed fixture (test/fixtures/trust/
# signed_sample.shs, signed by scripts/trust/sign-script.shs with the
# INSECURE fixture key) against the fixture public root, then confirms a
# flipped byte and a wrong root are rejected. Prints PASS/FAIL lines and a
# final verdict line.

use std.nogc_sync_mut.trust.script_signature.{script_signature_verify, script_signature_verify_file}
use std.io_runtime.{file_read, file_read_bytes}

fn report(name: text, ok: bool) -> i64:
    if ok:
        print("PASS " + name)
        return 0
    print("FAIL " + name)
    1

fn main():
    val script_path = "test/fixtures/trust/signed_sample.shs"
    val pub_path = "test/fixtures/trust/selftest_key.pub"
    var failures = 0

    val r = script_signature_verify_file(script_path, pub_path)
    failures = failures + report("shell-signed fixture verifies (reason=" + r.reason + ")", r.valid)
    failures = failures + report("leaf reported", r.leaf >= 0 and r.leaf < 256)
    failures = failures + report("key_id reported", r.key_id.starts_with("selftest-insecure-"))

    # Flip one byte of the script content.
    var flipped = file_read_bytes(script_path)
    if flipped.len() > 0:
        flipped[0] = ((flipped[0] as i64 + 1) % 256) as u8
    val sig_text = file_read(script_path + ".sig")
    val pub_text = file_read(pub_path)
    val r2 = script_signature_verify(flipped, sig_text, pub_text)
    failures = failures + report("flipped script byte rejected (reason=" + r2.reason + ")", not r2.valid)

    # Wrong root: swap the first hex digit of root=.
    val wrong_pub = pub_text.replace("root=" + pub_text.split("root=")[1].substring(0, 1),
                                     "root=" + (if pub_text.split("root=")[1].starts_with("0"): "1" else: "0"))
    val original = file_read_bytes(script_path)
    val r3 = script_signature_verify(original, sig_text, wrong_pub)
    failures = failures + report("wrong root rejected (reason=" + r3.reason + ")", not r3.valid)

    if failures == 0:
        print("PROBE PASS — 5 checks")
    else:
        print("PROBE FAIL — {failures} check(s) failed")

main()
