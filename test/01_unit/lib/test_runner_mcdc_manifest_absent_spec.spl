# Purpose and audience: executable specification evidence for the test-runner owners.
# Only the pure-Simple compiler driver emits the MC/DC obligation manifest. A
# compile that succeeds without one (the Rust seed) fails closed by default --
# under the pure-Simple compiler that is a regression. A toolchain that cannot
# produce a manifest opts in with SIMPLE_MCDC_MANIFEST_ABSENT=degrade; the spec
# then runs on the interpreter fallback and reports its REAL result. A manifest
# that is present but malformed always fails. Toolchain-neutral: on a compiler
# that does emit the manifest no degrade happens and the spec simply passes.
# Bug: doc/08_tracking/bug/test_runner_mcdc_manifest_absent_spec_never_runs_2026-10-19.md
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect}
use std.spec.step
use std.test_runner.test_executor_parsing.{find_simple_binary, mcdc_obligation_manifest_absent}
use std.test_runner.test_runner_execute.{mcdc_manifest_absent_degrade_opted_in}
use std.test_runner.native_owned_process.{run_scoped_child}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass}
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.io.env_ops.{env_set}

val COMPILES_FIXTURE = "test/fixtures/test_runner_mcdc/compiles_fixture.spl"
val BEGIN = "__SIMPLE_MCDC_OBLIGATION_MANIFEST_BEGIN__"
val END = "__SIMPLE_MCDC_OBLIGATION_MANIFEST_END__"

fn run_dir_lane(fixture: text, absent_policy: text) -> text:
    expect(env_set("SIMPLE_MCDC_MANIFEST_ABSENT", absent_policy)).to_equal(true)
    val dir = "build/test_runner_mcdc_manifest_{time_now_unix_micros()}"
    val (_o1, _e1, mk) = process_run_timeout("/bin/mkdir", ["-p", dir], 10000)
    expect(mk).to_equal(0)
    val (_o2, _e2, cp) = process_run_timeout("/bin/cp", [fixture, dir + "/fixture_spec.spl"], 10000)
    expect(cp).to_equal(0)
    # Captured through the runner's scoped-child path: process_run_timeout
    # returns empty text under the seed interpreter, see
    # doc/08_tracking/bug/seed_interpreter_text_codec_file_io_empty_2026-10-19.md
    val lane = run_scoped_child(ExecutionResourceClass.Unit, find_simple_binary(),
        ["test", dir, "--timeout", "120", "--no-db", "--no-cache"], 300000, 0, 0, 0, 0, false)
    process_run_timeout("/bin/rm", ["-rf", dir], 10000)
    lane.result.stdout + "\n" + lane.result.stderr

fn verdict_line(output: text) -> text:
    for line in output.split("\n"):
        if line.starts_with("SPEC FILE VERDICT:"):
            return line
    ""

describe "MC/DC obligation manifest absent from a successful compile":
    it "with the explicit degrade opt-in, runs the spec and reports its real result":
        # @req REQ-SSPEC-UNIT
        step("drive the directory lane over a spec that compiles standalone, opted in")
        val output = run_dir_lane(COMPILES_FIXTURE, "degrade")
        expect(output.contains("missing or malformed MC/DC obligation manifest")).to_equal(false)
        expect(output.contains("missing MC/DC obligation manifest")).to_equal(false)
        val verdict = verdict_line(output)
        expect(verdict).to_contain("outcome=OK")
        expect(verdict).to_contain("passed=1")
        if output.contains("[mcdc-fallback]"):
            expect(verdict).to_contain("degraded=mcdc-obligation-manifest-absent")

    it "without the opt-in, never degrades: an absent manifest fails closed":
        # @req REQ-SSPEC-UNIT
        step("drive the same lane with the policy unset")
        val output = run_dir_lane(COMPILES_FIXTURE, "")
        val verdict = verdict_line(output)
        expect(verdict.contains("degraded=mcdc-obligation-manifest-absent")).to_equal(false)
        if output.contains("missing MC/DC obligation manifest"):
            expect(verdict).to_contain("outcome=ERROR")
        else:
            expect(verdict).to_contain("outcome=OK")  # oracle: this compiler emitted a manifest

    it "treats only a marker-free output as absent, and only \"degrade\" as the opt-in":
        # @req REQ-SSPEC-UNIT
        step("classify absent, valid and malformed compiler outputs and opt-in values")
        expect(mcdc_obligation_manifest_absent("Compiled a.spl -> a.smf\n")).to_equal(true)
        expect(mcdc_obligation_manifest_absent("")).to_equal(true)
        expect(mcdc_obligation_manifest_absent(BEGIN + "\nobligations: []\n" + END + "\n")).to_equal(false)
        expect(mcdc_obligation_manifest_absent(BEGIN + "\nobligations: []\n")).to_equal(false)
        expect(mcdc_obligation_manifest_absent("noise\n" + END + "\n")).to_equal(false)
        expect(mcdc_manifest_absent_degrade_opted_in("degrade")).to_equal(true)
        expect(mcdc_manifest_absent_degrade_opted_in("")).to_equal(false)
        expect(mcdc_manifest_absent_degrade_opted_in("1")).to_equal(false)
        expect(mcdc_manifest_absent_degrade_opted_in("true")).to_equal(false)
