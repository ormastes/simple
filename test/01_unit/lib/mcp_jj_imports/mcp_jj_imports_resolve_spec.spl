# Regression: src/lib/nogc_sync_mut/mcp/jj/** must import real modules, not the
# nonexistent app.mcp_jj namespace (bug mcp_jj_package_imports_nonexistent_app_namespace_2026-08-18).
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.mcp.jj.jj_runner.{JjResult}
use std.nogc_sync_mut.mcp.jj.helpers.{make_error_response}
use std.nogc_sync_mut.mcp.jj.warning.{git_compat_warning}
use std.nogc_sync_mut.mcp.jj.tools_jj_changes.{schema_jj_new}
use std.nogc_sync_mut.mcp.jj.tools_jj_viewing.{schema_jj_status}
use std.nogc_sync_mut.mcp.jj.tools_jj_files.{schema_jj_file_show}
use std.nogc_sync_mut.mcp.jj.tools_jj_bookmarks.{schema_jj_bookmark_list}
use std.nogc_sync_mut.mcp.jj.tools_jj_git.{schema_jj_git_fetch}
use std.nogc_sync_mut.mcp.jj.tools_jj_misc.{schema_jj_op_log}

describe "mcp jj package imports":
    it "resolves every module with real namespaces":
        expect(schema_jj_new().len() > 0).to_equal(true)
        expect(schema_jj_status().len() > 0).to_equal(true)
        expect(schema_jj_bookmark_list().len() > 0).to_equal(true)

    it "contains no app.mcp_jj import in any file":
        # the needle is assembled so this spec does not match itself
        val needle = "app." + "mcp_jj"
        val names = ["__init__", "helpers", "jj_runner", "main", "prompts", "resources", "tools_git", "tools_git_branch", "tools_git_core", "tools_git_misc", "tools_git_sync", "tools_jj", "tools_jj_bookmarks", "tools_jj_changes", "tools_jj_files", "tools_jj_git", "tools_jj_misc", "tools_jj_viewing", "warning"]
        var offenders = 0
        for n in names:
            val src = rt_file_read_text("src/lib/nogc_sync_mut/mcp/jj/" + n + ".spl")
            if src.contains(needle):
                offenders = offenders + 1
        expect(offenders).to_equal(0)
