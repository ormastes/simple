# Unit tests for VersionedDynLib, MultiVersionLoader, and path resolution

use std.sffi.dynamic_versioned.{
    LibVersion, lib_version, lib_version_any, lib_version_string,
    build_candidate_paths, library_search_paths
}
use std.sffi.dynamic.{DynI64FnSlot, DynLib, platform_lib_extension, sffi_call_checked}
use std.spec.{describe, it, expect}

describe "LibVersion":
    it "formats any version":
        val v = lib_version_any()
        expect(lib_version_string(v)).to_equal("any")

    it "formats major only":
        val v = lib_version(1, 0, 0)
        expect(lib_version_string(v)).to_equal("1")

    it "formats major.minor":
        val v = lib_version(2, 3, 0)
        expect(lib_version_string(v)).to_equal("2.3")

    it "formats major.minor.patch":
        val v = lib_version(1, 2, 3)
        expect(lib_version_string(v)).to_equal("1.2.3")

describe "build_candidate_paths":
    it "generates candidates for unversioned library":
        val paths = build_candidate_paths("t32api64", lib_version_any())
        # Should contain at least bare name fallback
        expect(paths.len() > 0).to_equal(true)
        # Should contain lib prefix variant
        var has_lib_prefix = false
        var i = 0
        while i < paths.len():
            if paths[i].contains("libt32api64"):
                has_lib_prefix = true
            i = i + 1
        expect(has_lib_prefix).to_equal(true)

    it "generates versioned candidates":
        val paths = build_candidate_paths("mylib", lib_version(2, 1, 0))
        # Should contain versioned .so.2 or .2.dylib variants
        var has_major_version = false
        var i = 0
        while i < paths.len():
            if paths[i].contains(".2") or paths[i].contains("so.2"):
                has_major_version = true
            i = i + 1
        expect(has_major_version).to_equal(true)

    it "generates full version candidates":
        val paths = build_candidate_paths("mylib", lib_version(1, 2, 3))
        var has_full_version = false
        var i = 0
        while i < paths.len():
            if paths[i].contains("1.2.3"):
                has_full_version = true
            i = i + 1
        expect(has_full_version).to_equal(true)

describe "library_search_paths":
    it "returns at least one search path":
        val paths = library_search_paths()
        expect(paths.len() > 0).to_equal(true)

    it "includes T32 API path":
        val paths = library_search_paths()
        var has_t32 = false
        var i = 0
        while i < paths.len():
            if paths[i].contains("t32"):
                has_t32 = true
            i = i + 1
        expect(has_t32).to_equal(true)

describe "checked convention dispatch":
    it "rejects a name without a provider prefix before foreign loading":
        val result = unsafe(capabilities: [ffi, raw_ptr]):
            sffi_call_checked("malformed", [])
        match result:
            case Err(error):
                expect(error).to_contain("E-SFFI-014")
                expect(error).to_contain("malformed convention symbol")
            case Ok(value):
                expect("unexpected checked value: {value}").to_equal("")

    it "rejects a cached integer slot arity mismatch before dispatch":
        val slot = DynI64FnSlot(
            fptr: 1,
            symbol: "probe_two",
            provider_path: "fixture",
            arity: 2
        )
        val result = unsafe(capabilities: [ffi, raw_ptr]):
            slot.call_checked([7])
        match result:
            case Err(error):
                expect(error).to_contain("E-SFFI-003")
                expect(error).to_contain("expects 2 i64 arguments, got 1")
            case Ok(value):
                expect("unexpected cached value: {value}").to_equal("")

    it "rejects unsupported slot arity before symbol lookup":
        val lib = DynLib(handle: 1, path: "fixture")
        val result = unsafe(capabilities: [ffi, raw_ptr]):
            lib.resolve_i64_checked("probe_nine", 9)
        match result:
            case Err(error):
                expect(error).to_contain("E-SFFI-003")
                expect(error).to_contain("expected 0..8")
            case Ok(_):
                expect("unexpected resolved slot").to_equal("")

    it "rejects an empty provider prefix before foreign loading":
        val result = unsafe(capabilities: [ffi, raw_ptr]):
            sffi_call_checked("rt__probe", [])
        match result:
            case Err(error):
                expect(error).to_contain("E-SFFI-014")
                expect(error).to_contain("empty convention provider prefix")
            case Ok(value):
                expect("unexpected checked value: {value}").to_equal("")
