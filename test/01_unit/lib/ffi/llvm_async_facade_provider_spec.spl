use std.io_runtime.{file_read}
use std.spec.{describe, it, expect}

describe "async LLVM SFFI provider ownership":
    it "resolves private helpers directly from the canonical sync provider":
        val codegen = file_read("src/lib/nogc_async_mut/sffi/llvm_codegen.spl")
        val target = file_read("src/lib/nogc_async_mut/sffi/llvm_target.spl")
        expect(codegen).to_contain("use std.nogc_sync_mut.sffi.llvm_loader.{")
        expect(target).to_contain("use std.nogc_sync_mut.sffi.llvm_loader.{")
        expect(target).to_contain("use std.nogc_sync_mut.sffi.llvm_types.{")
        expect(codegen.contains(
            "use std.nogc_async_mut.sffi.llvm_loader.{")).to_equal(false)
        expect(target.contains(
            "use std.nogc_async_mut.sffi.llvm_loader.{")).to_equal(false)

    it "exports representative loader type constant codegen and target names":
        val facade = file_read("src/lib/nogc_async_mut/sffi/llvm.spl")
        expect(facade).to_contain(
            "export use std.nogc_sync_mut.sffi.llvm_loader.{")
        expect(facade).to_contain(
            "export use std.nogc_async_mut.sffi.llvm_types.{")
        expect(facade).to_contain("llvm_function_type")
        expect(facade).to_contain("llvm_const_null")
        expect(facade).to_contain(
            "export use std.nogc_async_mut.sffi.llvm_codegen.{")
        expect(facade).to_contain("llvm_build_icmp")
        expect(facade).to_contain(
            "export use std.nogc_async_mut.sffi.llvm_target.{")
        expect(facade).to_contain("llvm_create_target_machine")

    it "keeps LLVM target configuration on its terminal owner":
        val backend = file_read(
            "src/compiler/70.backend/backend/llvm_backend.spl")
        val driver = file_read(
            "src/compiler/80.driver/driver_bootstrap.spl")
        expect(backend).to_contain(
            "export use compiler.backend.llvm_target.\{LlvmTargetTriple, LlvmTargetConfig\}")
        expect(backend.contains(
            "export LlvmTargetTriple, LlvmTargetConfig")).to_equal(false)
        expect(driver).to_contain(
            "use compiler.backend.llvm_target.\{LlvmTargetConfig\}")
