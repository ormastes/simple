use std.sffi.admission.{
    SFFI_ADMISSION_MAX_SYMBOLS, SffiAdmissionTrustRootV1,
    parse_sffi_admission_v1, verify_sffi_evidence_v2,
}
use std.io_runtime.{file_read}
use lib.common.crypto.ed25519.{pure_ed25519_keypair_from_seed, pure_ed25519_sign}
use std.common.string_core.{text_to_bytes}
use std.sffi.sffi_signature.{
    EvidenceBoundI64ManifestV1, validate_evidence_bound_i64_identity,
}
use std.spec.{describe, it, expect}

val DIGEST_A = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val DIGEST_B = "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn admission_fixture() -> text:
    "schema\tsimple.sffi-admission.v1\n" +
    "provider_id\ttest.provider\n" +
    "target\tx86_64-linux\n" +
    "signer_key_id\ttest-key\n" +
    "artifact_sha256\t{DIGEST_A}\n" +
    "abi_registry_sha256\t{DIGEST_B}\n" +
    "signed_manifest_sha256\t{DIGEST_A}\n" +
    "verification_report_sha256\t{DIGEST_B}\n" +
    "symbol_count\t1\n" +
    "symbol\trt_test\t{DIGEST_A}\ttrue\ttrue\n"

fn evidence_fixture() -> text:
    "schema\tsimple.sffi-evidence.v2\n" +
    "provider_id\ttest.provider\n" +
    "target\tx86_64-linux\n" +
    "signer_key_id\ttest-key\n" +
    "artifact_sha256\t{DIGEST_A}\n" +
    "canonical_source_tree_sha256\t{DIGEST_B}\n" +
    "exact_build_input_sha256\t{DIGEST_A}\n" +
    "compiler_artifact_sha256\t{DIGEST_B}\n" +
    "abi_registry_sha256\t{DIGEST_B}\n" +
    "verification_report_sha256\t{DIGEST_A}\n" +
    "symbol_count\t1\n" +
    "symbol\trt_test\t{DIGEST_A}\n"

describe "SFFI evidence admission":
    it "verifies exact evidence bytes against an authorized Ed25519 root":
        val seed: [u8] = [7u8; 32]
        val keypair = pure_ed25519_keypair_from_seed(seed)
        val signature = pure_ed25519_sign(seed, keypair.1, text_to_bytes(evidence_fixture()))
        val root = SffiAdmissionTrustRootV1.create("test-key", keypair.1).unwrap()
        match verify_sffi_evidence_v2(evidence_fixture(), signature, [root]):
            case Ok(verified):
                expect(verified.provider_identity()).to_equal("test.provider")
                expect(verified.artifact_digest()).to_equal(DIGEST_A)
            case Err(error):
                expect("unexpected signature error: {error}").to_equal("")

    it "rejects a signed receipt after any byte changes":
        val seed: [u8] = [9u8; 32]
        val keypair = pure_ed25519_keypair_from_seed(seed)
        val signature = pure_ed25519_sign(seed, keypair.1, text_to_bytes(evidence_fixture()))
        val root = SffiAdmissionTrustRootV1.create("test-key", keypair.1).unwrap()
        val modified = evidence_fixture().replace("test.provider", "other.provider")
        match verify_sffi_evidence_v2(modified, signature, [root]):
            case Err(error): expect(error).to_contain("E-SFFI-005")
            case Ok(_): expect("modified signed receipt was accepted").to_equal("")

    it "parses an exact canonical signed-evidence receipt":
        match parse_sffi_admission_v1(admission_fixture()):
            case Ok(receipt):
                expect(receipt.provider_identity()).to_equal("test.provider")
                expect(receipt.source_signature("rt_test")).to_equal(Some(DIGEST_A))
            case Err(error):
                expect("unexpected parse error: {error}").to_equal("")

    it "rejects a forged verification boolean":
        val forged = admission_fixture().replace("\ttrue\ttrue\n", "\ttrue\tfalse\n")
        match parse_sffi_admission_v1(forged):
            case Err(error):
                expect(error).to_contain("E-SFFI-005")
            case Ok(_):
                expect("forged receipt was accepted").to_equal("")

    it "rejects symbol-count truncation":
        val truncated = admission_fixture().replace("symbol_count\t1", "symbol_count\t2")
        match parse_sffi_admission_v1(truncated):
            case Err(error):
                expect(error).to_contain("symbol_count")
            case Ok(_):
                expect("truncated receipt was accepted").to_equal("")

    it "rejects an admission closure above the allocation cap":
        val oversized = admission_fixture().replace(
            "symbol_count\t1", "symbol_count\t{SFFI_ADMISSION_MAX_SYMBOLS + 1}",
        )
        match parse_sffi_admission_v1(oversized):
            case Err(error):
                expect(error).to_contain("symbol_count")
            case Ok(_):
                expect("oversized closure was accepted").to_equal("")

    it "rejects a non-canonical digest spelling":
        val uppercase = admission_fixture().replace(DIGEST_A, DIGEST_A.to_upper())
        match parse_sffi_admission_v1(uppercase):
            case Err(error):
                expect(error).to_contain("digest")
            case Ok(_):
                expect("uppercase digest was accepted").to_equal("")

    it "keeps receipt and exact-artifact authority fields file-private":
        val admission_source = file_read("src/lib/nogc_sync_mut/sffi/admission.spl")
        val dynamic_source = file_read("src/lib/nogc_sync_mut/sffi/dynamic.spl")
        expect(admission_source).to_contain("    artifact_sha256: text")
        expect(admission_source).to_contain("    source_signatures: {text: text}")
        expect(dynamic_source).to_contain("    lib: DynLib")
        expect(dynamic_source).to_contain("    artifact_sha256: text")

    it "keeps legacy dynamic load and dispatch failures fail-closed":
        val dynamic_source = file_read("src/lib/nogc_sync_mut/sffi/dynamic.spl")
        expect(dynamic_source).to_contain(
            r'panic("E-SFFI-001: failed to load provider: {path}")')
        expect(dynamic_source).to_contain(
            r'panic("E-SFFI-003: malformed foreign symbol name: {func_name}")')
        expect(dynamic_source.contains(
            "return DynLib(handle: 0, path: path)")).to_equal(false)

    it "keeps LLVM provider and symbol failures fail-closed":
        val llvm_source = file_read(
            "src/lib/nogc_sync_mut/sffi/llvm_loader.spl")
        expect(llvm_source).to_contain("E-SFFI-001: LLVM provider is not loaded")
        expect(llvm_source).to_contain("E-SFFI-001: unresolved LLVM symbol")
        expect(llvm_source.contains(
            "DynLib(handle: 0, path: \"\")")).to_equal(false)

    it "rejects provider identity without touching a foreign handle":
        match parse_sffi_admission_v1(admission_fixture()):
            case Ok(receipt):
                val manifest = EvidenceBoundI64ManifestV1.create(
                    "wrong.provider", "x86_64-linux", DIGEST_A, DIGEST_B,
                )
                match validate_evidence_bound_i64_identity(
                    manifest, receipt, DIGEST_A):
                    case Err(error):
                        expect(error).to_contain("E-SFFI-005")
                    case Ok(_):
                        expect("identity mismatch was accepted").to_equal("")
            case Err(error):
                expect("unexpected fixture parse error: {error}").to_equal("")
