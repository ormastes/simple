# Unit tests for FfiManifest and validation functions

"""
## Purpose and audience
Purpose: Verify FfiManifest.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-FFI-SIGNATURE-001 — stable requirement identity for this spec.

use std.sffi.sffi_signature.{FfiManifest, FfiSignature, FfiValidationResult, validation_summary}
use std.spec.{describe, it, expect}

use std.spec.step

describe "FfiManifest":
    it "starts empty":
        step("Verify: starts empty")
        # @req: REQ-LIB-FFI-SIGNATURE-001
        var m = FfiManifest.create()
        expect(m.count()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "adds entries":
        step("Verify: adds entries")
        var m = FfiManifest.create()
        m.add("T32_Init", 0, "i32")
        m.add("T32_Config", 2, "i32")
        expect(m.count()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "retrieves by name":
        step("Verify: retrieves by name")
        var m = FfiManifest.create()
        m.add("T32_Ping", 0, "i32")
        val sig = m.get("T32_Ping")
        expect(sig == nil).to_equal(false)

    it "returns nil for unknown name":
        step("Verify: returns nil for unknown name")
        var m = FfiManifest.create()
        m.add("T32_Ping", 0, "i32")
        val sig = m.get("T32_NonExistent")
        expect(sig == nil).to_equal(true)

    it "lists all names":
        step("Verify: lists all names")
        var m = FfiManifest.create()
        m.add("A", 0, "i32")
        m.add("B", 1, "i32")
        m.add("C", 2, "i32")
        val names = m.names()
        expect(names.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

describe "validation_summary":
    it "formats summary correctly":
        step("Verify: formats summary correctly")
        val result = FfiValidationResult(
            total: 10,
            found: 7,
            missing: ["A", "B", "C"],
            present: ["D", "E", "F", "G", "H", "I", "J"]
        )
        val summary = validation_summary(result)
        expect(summary.contains("7/10")).to_equal(true)
        expect(summary.contains("3 missing")).to_equal(true)

    it "formats perfect result":
        step("Verify: formats perfect result")
        val result = FfiValidationResult(
            total: 5,
            found: 5,
            missing: [],
            present: ["A", "B", "C", "D", "E"]
        )
        val summary = validation_summary(result)
        expect(summary.contains("5/5")).to_equal(true)
        expect(summary.contains("0 missing")).to_equal(true)
