#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
profile="$root/src/lib/compiler_artifact_service/profile.spl"

test -f "$profile"
grep -q 'fn artifact_service_profile_v1(' "$profile"
grep -q 'profile_name: text, compatibility_id: text, pools: \[text\],' "$profile"
grep -q 'foreground_priority: i64, daemon_optional: bool' "$profile"
grep -q 'export ArtifactServiceProfileV1, artifact_service_profile_v1' "$profile"

for adapter in \
    "$root/src/app/compiler_service/demand_profile.spl" \
    "$root/src/app/test_daemon/demand_profile.spl" \
    "$root/src/app/mcp/demand_compile_profile.spl" \
    "$root/src/app/simple_lsp_mcp/demand_compile_profile.spl"
do
    test -f "$adapter"
    grep -q 'artifact_service_profile_v1' "$adapter"
    if grep -Eq 'ArtifactServiceV1|ArtifactQueueEntryV1|cas_artifact_digest|artifact_service_enqueue_v1' "$adapter"; then
        echo "adapter owns artifact-service queue or CAS truth: $adapter" >&2
        exit 1
    fi
done

echo "D3_D14_PROFILE_COMPATIBILITY_PASS"
