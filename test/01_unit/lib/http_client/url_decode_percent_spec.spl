# @req REQ-SSPEC-LIB

use std.spec.step
use std.spec.{describe, it, assert_equal}
use std.gc_async_mut.http_client.types.{url_decode as gc_url_decode}
use std.nogc_async_mut.http_client.types.{url_decode as nogc_url_decode}

describe "async HTTP client url_decode percent escapes":
    it "decodes percent octets and UTF-8 in both ownership profiles":
        # @req REQ-SSPEC-LIB
        step("decodes percent octets and UTF-8 in both ownership profiles")
        assert_equal(gc_url_decode("a%20b%2fc"), "a b/c")
        assert_equal(nogc_url_decode("a%20b%2fc"), "a b/c")
        assert_equal(gc_url_decode("%C3%A9"), "é")
        assert_equal(nogc_url_decode("%C3%A9"), "é")

    it "preserves literal multibyte text and form plus handling":
        # @req REQ-SSPEC-LIB
        step("preserves literal multibyte text and form plus handling")
        assert_equal(gc_url_decode("café+a%20b"), "café a b")
        assert_equal(nogc_url_decode("café+a%20b"), "café a b")

    it "preserves malformed and truncated escapes":
        # @req REQ-SSPEC-LIB
        step("preserves malformed and truncated escapes")
        assert_equal(gc_url_decode("%%"), "%%")
        assert_equal(nogc_url_decode("%%"), "%%")
        assert_equal(gc_url_decode("%X"), "%X")
        assert_equal(nogc_url_decode("%X"), "%X")
        assert_equal(gc_url_decode("%ZZ"), "%ZZ")
        assert_equal(nogc_url_decode("%ZZ"), "%ZZ")
        assert_equal(gc_url_decode("%2G"), "%2G")
        assert_equal(nogc_url_decode("%2G"), "%2G")
        assert_equal(gc_url_decode("%ZZ+ok"), "%ZZ ok")
        assert_equal(nogc_url_decode("%ZZ+ok"), "%ZZ ok")
        # Invalid full triplets are copied as three bytes, including an inner '+'.
        assert_equal(gc_url_decode("%+x"), "%+x")
        assert_equal(nogc_url_decode("%+x"), "%+x")
        assert_equal(gc_url_decode("%%41"), "%%41")
        assert_equal(nogc_url_decode("%%41"), "%%41")

    it "decodes a zero octet":
        # @req REQ-SSPEC-LIB
        step("decodes a zero octet")
        assert_equal(gc_url_decode("%00"), "\u{0}")
        assert_equal(nogc_url_decode("%00"), "\u{0}")

    it "decodes exactly one layer":
        # @req REQ-SSPEC-LIB
        step("decodes exactly one layer")
        assert_equal(gc_url_decode("%252F"), "%2F")
        assert_equal(nogc_url_decode("%252F"), "%2F")

    it "decodes a long mixed UTF-8 and escaped input":
        # @req REQ-SSPEC-LIB
        step("decodes a long mixed UTF-8 and escaped input")
        val encoded = "a%20é+".repeat(512)
        val expected = "a é ".repeat(512)
        assert_equal(gc_url_decode(encoded), expected)
        assert_equal(nogc_url_decode(encoded), expected)
