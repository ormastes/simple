# @req REQ-SSPEC-LIB
# Bug: nogc_sync_mut/http_client/types.spl called the imported
# nogc_sync_mut.http.url.url_decode(encoded:) with the named arg `text:`
# (copied from the gc_async_mut twin, which defines its own url_decode(text:)).
# HIR rejected it ("names unknown parameter `text`") and every native build whose
# closure reached this file (devhub) failed. These scenarios exercise the three
# repaired call sites through the public query-string API.

use std.spec.step
use std.spec.{describe, it, assert_equal}
use std.nogc_sync_mut.http_client.types.{parse_query_string, url_decode_component}

describe "sync HTTP client query-string decoding":
    it "decodes percent-escaped keys and values of a query string":
        # @req REQ-SSPEC-LIB
        step("parse a query string with escaped key and value")
        val params = parse_query_string("a%20b=c%2Fd&e=f")
        assert_equal(params.length(), 2)
        assert_equal(params[0], ("a b", "c/d"))
        assert_equal(params[1], ("e", "f"))

    it "decodes a bare key without a value":
        # @req REQ-SSPEC-LIB
        step("parse a key-only pair")
        val params = parse_query_string("caf%C3%A9")
        assert_equal(params.length(), 1)
        assert_equal(params[0], ("café", ""))

    it "decodes a single component":
        # @req REQ-SSPEC-LIB
        step("decode one component")
        assert_equal(url_decode_component("x%3Dy"), "x=y")
        assert_equal(parse_query_string("").length(), 0)
