use std.spec
use std.nogc_sync_mut.io.windows_process_owner_abi.{
    windows_abi_pointer_bits, windows_abi_pointer_bytes, windows_abi_pointer_bytes_for, windows_abi_size_t_max,
    windows_abi_security_attributes_size_for, windows_abi_security_attributes_descriptor_offset_for, windows_abi_security_attributes_inherit_offset_for,
    windows_abi_startupinfo_size_for, windows_abi_startupinfo_flags_offset_for, windows_abi_startupinfo_std_input_offset_for, windows_abi_startupinfo_std_output_offset_for, windows_abi_startupinfo_std_error_offset_for,
    windows_abi_startupinfoex_size_for, windows_abi_startupinfoex_attr_list_offset_for,
    windows_abi_process_info_size_for, windows_abi_process_info_process_offset_for, windows_abi_process_info_thread_offset_for, windows_abi_process_info_pid_offset_for, windows_abi_process_info_tid_offset_for,
    windows_abi_job_extended_limit_size_for, windows_abi_job_limit_flags_offset_for, windows_abi_job_process_memory_limit_offset_for, windows_abi_job_memory_limit_offset_for, windows_abi_job_peak_process_memory_offset_for, windows_abi_job_peak_memory_offset_for,
    windows_abi_overlapped_size_for, windows_abi_overlapped_event_offset_for,
    windows_abi_wsapollfd_size_for, windows_abi_wsapollfd_events_offset_for, windows_abi_wsapollfd_revents_offset_for,
    windows_abi_performance_info_size_for, windows_abi_performance_info_commit_total_offset_for, windows_abi_performance_info_commit_limit_offset_for, windows_abi_performance_info_page_size_offset_for,
    windows_abi_security_attributes_size, windows_abi_security_attributes_descriptor_offset, windows_abi_security_attributes_inherit_offset,
    windows_abi_startupinfo_size, windows_abi_startupinfo_flags_offset, windows_abi_startupinfo_std_input_offset, windows_abi_startupinfo_std_output_offset, windows_abi_startupinfo_std_error_offset,
    windows_abi_startupinfoex_size, windows_abi_startupinfoex_attr_list_offset,
    windows_abi_process_info_size, windows_abi_process_info_process_offset, windows_abi_process_info_thread_offset, windows_abi_process_info_pid_offset, windows_abi_process_info_tid_offset,
    windows_abi_job_extended_limit_size, windows_abi_job_limit_flags_offset, windows_abi_job_process_memory_limit_offset, windows_abi_job_memory_limit_offset, windows_abi_job_peak_process_memory_offset, windows_abi_job_peak_memory_offset,
    windows_abi_job_basic_accounting_size, windows_abi_job_active_processes_offset, windows_abi_file_attribute_tag_info_size,
    windows_abi_overlapped_size, windows_abi_overlapped_event_offset,
    windows_abi_wsapollfd_size, windows_abi_wsapollfd_events_offset, windows_abi_wsapollfd_revents_offset,
    windows_abi_performance_info_size, windows_abi_performance_info_commit_total_offset, windows_abi_performance_info_commit_limit_offset, windows_abi_performance_info_page_size_offset,
    windows_abi_handle_is_invalid_for, windows_abi_handle_is_invalid
}

describe "Win32 struct layout helpers for i686 (32-bit) and x86_64 (64-bit)":
    it "computes exact 32-bit i686 Windows sizes and field offsets":
        expect(windows_abi_pointer_bytes_for(32)).to_equal(4)
        expect(windows_abi_security_attributes_size_for(32)).to_equal(12)
        expect(windows_abi_security_attributes_descriptor_offset_for(32)).to_equal(4)
        expect(windows_abi_security_attributes_inherit_offset_for(32)).to_equal(8)
        expect(windows_abi_startupinfo_size_for(32)).to_equal(68)
        expect(windows_abi_startupinfo_flags_offset_for(32)).to_equal(44)
        expect(windows_abi_startupinfo_std_input_offset_for(32)).to_equal(56)
        expect(windows_abi_startupinfo_std_output_offset_for(32)).to_equal(60)
        expect(windows_abi_startupinfo_std_error_offset_for(32)).to_equal(64)
        expect(windows_abi_startupinfoex_size_for(32)).to_equal(72)
        expect(windows_abi_startupinfoex_attr_list_offset_for(32)).to_equal(68)
        expect(windows_abi_process_info_size_for(32)).to_equal(16)
        expect(windows_abi_process_info_process_offset_for(32)).to_equal(0)
        expect(windows_abi_process_info_thread_offset_for(32)).to_equal(4)
        expect(windows_abi_process_info_pid_offset_for(32)).to_equal(8)
        expect(windows_abi_process_info_tid_offset_for(32)).to_equal(12)
        expect(windows_abi_job_extended_limit_size_for(32)).to_equal(112)
        expect(windows_abi_job_limit_flags_offset_for(32)).to_equal(16)
        expect(windows_abi_job_process_memory_limit_offset_for(32)).to_equal(96)
        expect(windows_abi_job_memory_limit_offset_for(32)).to_equal(100)
        expect(windows_abi_job_peak_process_memory_offset_for(32)).to_equal(104)
        expect(windows_abi_job_peak_memory_offset_for(32)).to_equal(108)
        expect(windows_abi_overlapped_size_for(32)).to_equal(20)
        expect(windows_abi_overlapped_event_offset_for(32)).to_equal(16)
        expect(windows_abi_wsapollfd_size_for(32)).to_equal(8)
        expect(windows_abi_wsapollfd_events_offset_for(32)).to_equal(4)
        expect(windows_abi_wsapollfd_revents_offset_for(32)).to_equal(6)
        expect(windows_abi_performance_info_size_for(32)).to_equal(56)
        expect(windows_abi_performance_info_commit_total_offset_for(32)).to_equal(4)
        expect(windows_abi_performance_info_commit_limit_offset_for(32)).to_equal(8)
        expect(windows_abi_performance_info_page_size_offset_for(32)).to_equal(40)

    it "computes exact 64-bit Windows sizes and field offsets":
        expect(windows_abi_pointer_bytes_for(64)).to_equal(8)
        expect(windows_abi_security_attributes_size_for(64)).to_equal(24)
        expect(windows_abi_security_attributes_descriptor_offset_for(64)).to_equal(8)
        expect(windows_abi_security_attributes_inherit_offset_for(64)).to_equal(16)
        expect(windows_abi_startupinfo_size_for(64)).to_equal(104)
        expect(windows_abi_startupinfo_flags_offset_for(64)).to_equal(60)
        expect(windows_abi_startupinfo_std_input_offset_for(64)).to_equal(80)
        expect(windows_abi_startupinfo_std_output_offset_for(64)).to_equal(88)
        expect(windows_abi_startupinfo_std_error_offset_for(64)).to_equal(96)
        expect(windows_abi_startupinfoex_size_for(64)).to_equal(112)
        expect(windows_abi_startupinfoex_attr_list_offset_for(64)).to_equal(104)
        expect(windows_abi_process_info_size_for(64)).to_equal(24)
        expect(windows_abi_process_info_process_offset_for(64)).to_equal(0)
        expect(windows_abi_process_info_thread_offset_for(64)).to_equal(8)
        expect(windows_abi_process_info_pid_offset_for(64)).to_equal(16)
        expect(windows_abi_process_info_tid_offset_for(64)).to_equal(20)
        expect(windows_abi_job_extended_limit_size_for(64)).to_equal(144)
        expect(windows_abi_job_limit_flags_offset_for(64)).to_equal(16)
        expect(windows_abi_job_process_memory_limit_offset_for(64)).to_equal(112)
        expect(windows_abi_job_memory_limit_offset_for(64)).to_equal(120)
        expect(windows_abi_job_peak_process_memory_offset_for(64)).to_equal(128)
        expect(windows_abi_job_peak_memory_offset_for(64)).to_equal(136)
        expect(windows_abi_overlapped_size_for(64)).to_equal(32)
        expect(windows_abi_overlapped_event_offset_for(64)).to_equal(24)
        expect(windows_abi_wsapollfd_size_for(64)).to_equal(16)
        expect(windows_abi_wsapollfd_events_offset_for(64)).to_equal(8)
        expect(windows_abi_wsapollfd_revents_offset_for(64)).to_equal(10)
        expect(windows_abi_performance_info_size_for(64)).to_equal(104)
        expect(windows_abi_performance_info_commit_total_offset_for(64)).to_equal(8)
        expect(windows_abi_performance_info_commit_limit_offset_for(64)).to_equal(16)
        expect(windows_abi_performance_info_page_size_offset_for(64)).to_equal(80)

    it "recognises INVALID_HANDLE_VALUE at each pointer width":
        expect(windows_abi_handle_is_invalid_for(32, -1)).to_equal(true)
        expect(windows_abi_handle_is_invalid_for(32, 4294967295)).to_equal(true)
        expect(windows_abi_handle_is_invalid_for(32, 0)).to_equal(false)
        expect(windows_abi_handle_is_invalid_for(32, 4294967294)).to_equal(false)
        expect(windows_abi_handle_is_invalid_for(64, -1)).to_equal(true)
        expect(windows_abi_handle_is_invalid_for(64, 4294967295)).to_equal(false)
        expect(windows_abi_handle_is_invalid_for(64, 0)).to_equal(false)
        expect(windows_abi_handle_is_invalid(-1)).to_equal(true)
        expect(windows_abi_handle_is_invalid(0)).to_equal(false)

    it "preserves arch-invariant struct layouts and matches active target pointer width":
        expect(windows_abi_job_basic_accounting_size()).to_equal(48)
        expect(windows_abi_job_active_processes_offset()).to_equal(40)
        expect(windows_abi_file_attribute_tag_info_size()).to_equal(8)

        val bits = windows_abi_pointer_bits()
        val expected_bytes = if bits == 32: 4 else: 8
        expect(windows_abi_pointer_bytes()).to_equal(expected_bytes)
        expect(windows_abi_size_t_max()).to_equal(if bits == 32: 4294967295 else: 9223372036854775807)
        expect(windows_abi_security_attributes_size()).to_equal(windows_abi_security_attributes_size_for(bits))
        expect(windows_abi_security_attributes_descriptor_offset()).to_equal(windows_abi_security_attributes_descriptor_offset_for(bits))
        expect(windows_abi_security_attributes_inherit_offset()).to_equal(windows_abi_security_attributes_inherit_offset_for(bits))
        expect(windows_abi_startupinfo_size()).to_equal(windows_abi_startupinfo_size_for(bits))
        expect(windows_abi_startupinfo_flags_offset()).to_equal(windows_abi_startupinfo_flags_offset_for(bits))
        expect(windows_abi_startupinfo_std_input_offset()).to_equal(windows_abi_startupinfo_std_input_offset_for(bits))
        expect(windows_abi_startupinfo_std_output_offset()).to_equal(windows_abi_startupinfo_std_output_offset_for(bits))
        expect(windows_abi_startupinfo_std_error_offset()).to_equal(windows_abi_startupinfo_std_error_offset_for(bits))
        expect(windows_abi_startupinfoex_size()).to_equal(windows_abi_startupinfoex_size_for(bits))
        expect(windows_abi_startupinfoex_attr_list_offset()).to_equal(windows_abi_startupinfoex_attr_list_offset_for(bits))
        expect(windows_abi_process_info_size()).to_equal(windows_abi_process_info_size_for(bits))
        expect(windows_abi_process_info_process_offset()).to_equal(windows_abi_process_info_process_offset_for(bits))
        expect(windows_abi_process_info_thread_offset()).to_equal(windows_abi_process_info_thread_offset_for(bits))
        expect(windows_abi_process_info_pid_offset()).to_equal(windows_abi_process_info_pid_offset_for(bits))
        expect(windows_abi_process_info_tid_offset()).to_equal(windows_abi_process_info_tid_offset_for(bits))
        expect(windows_abi_job_extended_limit_size()).to_equal(windows_abi_job_extended_limit_size_for(bits))
        expect(windows_abi_job_limit_flags_offset()).to_equal(windows_abi_job_limit_flags_offset_for(bits))
        expect(windows_abi_job_process_memory_limit_offset()).to_equal(windows_abi_job_process_memory_limit_offset_for(bits))
        expect(windows_abi_job_memory_limit_offset()).to_equal(windows_abi_job_memory_limit_offset_for(bits))
        expect(windows_abi_job_peak_process_memory_offset()).to_equal(windows_abi_job_peak_process_memory_offset_for(bits))
        expect(windows_abi_job_peak_memory_offset()).to_equal(windows_abi_job_peak_memory_offset_for(bits))
        expect(windows_abi_overlapped_size()).to_equal(windows_abi_overlapped_size_for(bits))
        expect(windows_abi_overlapped_event_offset()).to_equal(windows_abi_overlapped_event_offset_for(bits))
        expect(windows_abi_wsapollfd_size()).to_equal(windows_abi_wsapollfd_size_for(bits))
        expect(windows_abi_wsapollfd_events_offset()).to_equal(windows_abi_wsapollfd_events_offset_for(bits))
        expect(windows_abi_wsapollfd_revents_offset()).to_equal(windows_abi_wsapollfd_revents_offset_for(bits))
        expect(windows_abi_performance_info_size()).to_equal(windows_abi_performance_info_size_for(bits))
        expect(windows_abi_performance_info_commit_total_offset()).to_equal(windows_abi_performance_info_commit_total_offset_for(bits))
        expect(windows_abi_performance_info_commit_limit_offset()).to_equal(windows_abi_performance_info_commit_limit_offset_for(bits))
        expect(windows_abi_performance_info_page_size_offset()).to_equal(windows_abi_performance_info_page_size_offset_for(bits))
