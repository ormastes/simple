use std.spec.{describe, it, expect, fail}
use std.common.encoding.external_text.{Encoding, TextByteOrder, BomPolicy, ExternalFormat, CodecErrorKind, external_validate_bom, utf8_format}

describe "BOM-only transport admission":
    it "rejects a forbidden UTF-16 signature and preserves its typed location":
        val format = ExternalFormat(encoding: Encoding.Utf16, byte_order: TextByteOrder.LittleEndian, bom: BomPolicy.Forbid)
        match external_validate_bom([255u8, 254u8, 65u8, 0u8], format):
            case Ok(_): fail("forbidden BOM accepted")
            case Err(error):
                expect(error.kind).to_equal(CodecErrorKind.ForbiddenBom)
                expect(error.byte_offset).to_equal(0)

    it "validates the required prefix without decoding the payload":
        val format = ExternalFormat(encoding: Encoding.Utf8, byte_order: TextByteOrder.NotApplicable, bom: BomPolicy.Require)
        expect(external_validate_bom([239u8, 187u8, 191u8, 255u8], format).is_ok()).to_be(true)
        expect(external_validate_bom([65u8], format).is_err()).to_be(true)
        expect(external_validate_bom([255u8], utf8_format()).is_ok()).to_be(true)

    it "rejects invalid codec metadata before admitting a prefix":
        val invalid = ExternalFormat(encoding: Encoding.Utf8, byte_order: TextByteOrder.LittleEndian, bom: BomPolicy.Preserve)
        match external_validate_bom([], invalid):
            case Ok(_): fail("invalid byte order accepted")
            case Err(error): expect(error.kind).to_equal(CodecErrorKind.InvalidFormat)
        val unknown = ExternalFormat(encoding: Encoding.Unknown("not-a-codec"), byte_order: TextByteOrder.NotApplicable, bom: BomPolicy.Preserve)
        match external_validate_bom([], unknown):
            case Ok(_): fail("unknown encoding accepted")
            case Err(error): expect(error.kind).to_equal(CodecErrorKind.UnknownEncoding)
