# AUTHORED_UNRUN. Pure error codec plus mandatory actual private-file owner.
use std.spec.{describe, it, expect, fail, step}
use app.io.mod.env_get
use std.nogc_sync_mut.io.retained_file.{RetainedPrivateCredentialV1,
    retained_private_credential_open_v1, retained_private_credential_read_v1,
    retained_private_credential_publish_v1, retained_private_credential_close_v1, retained_private_credential_state_v1,
    retained_private_credential_phase_v1, retained_private_credential_error_name_v1}
use std.common.string_core.{bytes_to_text, text_to_bytes}
use std.sosix.entropy.sosix_random_hex
use std.nogc_sync_mut.io.sysinfo_ops.getpid

var retained_private_credential_test_owner_v1: RetainedPrivateCredentialV1? = nil

describe "canonical retained private credential ownership":
    it "decodes only authoritative lifecycle codes and distinguishes consumed close errors":
        step("Reject unknown lifecycle and preserve unsupported stale and consumed diagnostics")
        expect(retained_private_credential_phase_v1(1)).to_equal("open")
        expect(retained_private_credential_phase_v1(2)).to_equal("published")
        expect(retained_private_credential_phase_v1(3)).to_equal("uncertain")
        expect(retained_private_credential_phase_v1(4)).to_equal("closed")
        for code in [0, 5, -1, -5]:
            expect(retained_private_credential_phase_v1(code)).to_equal("unavailable")
        expect(retained_private_credential_error_name_v1(-1)).to_equal("private-credential-unsupported")
        expect(retained_private_credential_error_name_v1(-5)).to_equal("private-credential-stale-token")
        expect(retained_private_credential_error_name_v1(-14)).to_equal("private-credential-close-consumed-error")
        expect(retained_private_credential_error_name_v1(-18)).to_equal("private-credential-native-failure")

    it "publishes once and prevents a copied token from closing its actual successor":
        step("Acquire an actual provisioned private credential without exposing a raw descriptor")
        val path = env_get("RETAINED_PRIVATE_CREDENTIAL_TEST_PATH")
        if path == "":
            fail("precondition: mandatory fresh private RETAINED_PRIVATE_CREDENTIAL_TEST_PATH")
            return
        val opened = retained_private_credential_open_v1(path)
        retained_private_credential_test_owner_v1 = opened.owner
        if opened.owner == nil:
            fail(opened.error)
            return
        val owner = opened.owner.unwrap()
        if opened.state != "open" or opened.error != "":
            val closed = retained_private_credential_close_v1(owner)
            retained_private_credential_test_owner_v1 = closed.owner
            fail("actual private credential acquisition failed")
            return
        val read = retained_private_credential_read_v1(owner)
        val nonce = sosix_random_hex(16)
        if read.error != "" or nonce == nil:
            val closed = retained_private_credential_close_v1(owner)
            retained_private_credential_test_owner_v1 = closed.owner
            fail("actual retained read or secure entropy precondition failed")
            return
        val initial = bytes_to_text(read.bytes).trim().split(" ")
        if initial.len() != 2:
            val closed = retained_private_credential_close_v1(owner)
            retained_private_credential_test_owner_v1 = closed.owner
            fail("actual initial credential format invalid")
            return
        val ready = text_to_bytes(initial[0] + " 127.0.0.1:1 " + initial[1] + " " + getpid().to_text() + " " + nonce.unwrap() + "\n")
        step("Publish immutable sibling once then retire the actual native owner")
        val published = retained_private_credential_publish_v1(owner, read.bytes, ready)
        retained_private_credential_test_owner_v1 = published.owner
        val duplicate = retained_private_credential_publish_v1(owner, read.bytes, ready)
        val closed = retained_private_credential_close_v1(owner)
        retained_private_credential_test_owner_v1 = closed.owner
        if not published.completed or not closed.completed:
            fail("actual publication or native retirement failed; owner status retained")
            return
        step("Reject copied authority while preserving a fresh generation and existing ready winner")
        val successor = retained_private_credential_open_v1(path)
        retained_private_credential_test_owner_v1 = successor.owner
        if successor.owner == nil:
            fail(successor.error)
            return
        val next = successor.owner.unwrap()
        val copied_close = retained_private_credential_close_v1(owner)
        val next_read = retained_private_credential_read_v1(next)
        val conflict = retained_private_credential_publish_v1(next, read.bytes, ready)
        val next_close = retained_private_credential_close_v1(next)
        retained_private_credential_test_owner_v1 = next_close.owner
        expect(published.consumed).to_equal(false)
        expect(duplicate.completed).to_equal(false)
        expect(closed.consumed).to_equal(true)
        expect(next.token != owner.token).to_equal(true)
        expect(copied_close.completed).to_equal(false)
        expect(next_read.error).to_equal("")
        expect(bytes_to_text(next_read.bytes)).to_equal(bytes_to_text(read.bytes))
        expect(conflict.completed).to_equal(false)
        expect(conflict.error).to_equal("private-credential-publication-conflict")
        expect(next_close.completed).to_equal(true)
