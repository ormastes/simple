"""
## Purpose and audience
Pins the fail-closed reconcile of the quarantined Linux service capacity journal
in `src/lib/nogc_sync_mut/orchestration/host_linux_service_reconcile_v4.spl` and
its one-call continuity flip `host_linux_service_reconcile_flip_v4`
(DECISION H2-P2-3; the proof never leaves the module). Written for owners of the Linux Host service.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable binary when written, 2026-11-16).
## Compatibility and limitations
The inventory match and drain are pure over DATA (row facts, an offline
fresh-epoch store inventory, a native snapshot), so every refusal and the
all-rows-released happy path run here. A successful M1 read is an
authenticated EMPTY store (the provider stays masked, so a non-empty store
refuses); releases rest on receipts or that absence only. Row facts are derived from a real temporary
owned-lock journal. The private proof apply runs on a real owned-lock owner,
and the flip refuses a foreign inventory borrow before any observation. No
genuine native identity or store-inventory borrow or Linux-protected journal
exists in a unit run, so `host_linux_service_reconcile_flip_v4` end to end and
the M1 observation itself (wrong boot, stale generation, non-empty store) are
on the configured real fixture driver list (NOT_AUTHORED). Simple does not enforce privacy, so the
proof boundary is source shape plus the continuity-setter ratchet guard.
## Verification guidance and troubleshooting
Each refusal names the exact error string; a changed string is a contract change.
"""
use std.spec.{step, fail}
use std.io.file_read_text
use test.fixtures.orchestration.host_linux_service_verifier_fixture_v1.*
# Tests reach private module gates directly (repo rule: tests may access private).
use std.nogc_sync_mut.orchestration.host_linux_service_reconcile_v4.*
use std.nogc_sync_mut.orchestration.host_linux_service_reconcile_v4.{linux_service_row_facts_v4, linux_service_journal_identity_v4,
    linux_service_row_set_digest_v4, linux_service_continuity_apply_v4, HostLinuxServiceReconcileProofV4,
    linux_service_inventory_digest_v4}
use std.nogc_sync_mut.orchestration.host_linux_service_current_v4.{linux_service_scope_v4, linux_service_association_v4,
    linux_service_prepare_authorize_v4}
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.*
use std.nogc_sync_mut.io.linux_fresh_epoch_store_inventory_v1.{LinuxFreshEpochStoreInventoryV1,
    LinuxFreshEpochStoreInventoryBorrowV1}
use std.nogc_sync_mut.io.linux_service_native_identity_v3.LinuxServiceNativeIdentityBorrowV3
use std.nogc_sync_mut.io.linux_machine_policy_owner_v1.LinuxMachinePolicyOwnerV1
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.LinuxFreshEpochSuccessorCustodyV1
use std.nogc_sync_mut.io.host_linux_service_records_v4.*
use std.nogc_sync_mut.io.linux_service_native_identity_v3.LinuxServiceNativeIdentitySnapshotV3
use std.nogc_sync_mut.io.local_authority_policy_v1.{local_authority_policy_decode_v1, host_local_context_v1}
use std.nogc_sync_mut.io.file_ops.secure_temp_dir
use std.nogc_sync_mut.io_runtime.dir_remove
use std.common.task_runner.distributed_operation_journal_v2.{distributed_operation_journal_open_cleanup_v2,
    distributed_operation_journal_publish_v3}
use std.common.contracts.orchestration.host_prepare_associated_v3.HostPrepareAssociatedRequestV3
use std.common.contracts.orchestration.host_prepare_request_v1.HostPrepareRequestV1
use std.common.contracts.orchestration.host_execution_association_v3.host_execution_association_encode_v3
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.common.contracts.orchestration.host_capacity_v1.*
use std.common.contracts.container.execution_draft_v3.*
use std.common.contracts.container.execution_v2.*
use std.common.contracts.distributed_control_v2.{ExecutionGrantV2, OperationEnvelopeV2}
use std.common.crypto.sha256.sha256_text

val RC_BOOT: text = "native-boot"
val RC_FAR: i64 = 4102444800000
val RC_OPERATIONS: [text] = ["host_enroll_v1", "host_reservation_v1", "host_execute_associated_v3"]

fn rc_native() -> LinuxServiceNativeIdentitySnapshotV3:
    LinuxServiceNativeIdentitySnapshotV3(native_machine_id: "machine_1", native_boot_id: RC_BOOT, architecture: "x86_64",
        owner_generation: 41, process_identity_digest: "e".repeat(64), process_generation: 2, authority_namespace_id: "namespace_1")

fn rc_capacity(generation: i64 = 41) -> HostCapacityV1:
    HostCapacityV1("worker_1", "host-authority", "b".repeat(64), generation, 2000, 536870912, [])

val RC_EPOCH: text = "c".repeat(64)

fn rc_inventory(boot: text = "native-boot") -> LinuxFreshEpochStoreInventoryV1:
    LinuxFreshEpochStoreInventoryV1(epoch_digest: RC_EPOCH, native_boot_id: boot, owner_generation: 41,
        process_identity_digest: "e".repeat(64), store_identity_digest: "5".repeat(64), partition_identity_digest: "6".repeat(64))

fn rc_row(op: text, state: text, plan: bool = true) -> HostLinuxServiceRowFactV4:
    HostLinuxServiceRowFactV4(operation_id: op, payload_digest: "0".repeat(64), action: "host_reservation_v1",
        journal_state: state, projected_released: false, abort_receipt: false, child_barrier: false,
        plan_bound: plan, plan_machine_id: "machine_1", plan_scope: "epoch-" + RC_EPOCH)

# DATA borrows: slots are never touched (the flip refuses the alias first).
fn rc_native_borrow(custody_slot: i64) -> LinuxServiceNativeIdentityBorrowV3:
    LinuxServiceNativeIdentityBorrowV3(reader: LinuxMachinePolicyOwnerV1(slot: 3, generation: 1),
        successor: LinuxFreshEpochSuccessorCustodyV1(slot: custody_slot, generation: 1), expected: rc_native())

fn rc_inventory_borrow(reader_generation: i64, custody_slot: i64) -> LinuxFreshEpochStoreInventoryBorrowV1:
    LinuxFreshEpochStoreInventoryBorrowV1(reader: LinuxMachinePolicyOwnerV1(slot: 3, generation: reader_generation),
        successor: LinuxFreshEpochSuccessorCustodyV1(slot: custody_slot, generation: 1), epoch_digest: RC_EPOCH)

fn rc_match(rows: [HostLinuxServiceRowFactV4]) -> Result<(), text>:
    host_linux_service_inventory_match_v4(rows, rc_inventory(), rc_native(), rc_capacity())

fn rc_drain(rows: [HostLinuxServiceRowFactV4]) -> Result<[HostLinuxServiceReleaseV4], text>:
    rc_match(rows)?
    host_linux_service_drain_v4(rows)

fn rc_count(source: text, needle: text) -> i64:
    source.split(needle).len() - 1

# Journal-backed helpers mirror the service 40 spec (real Ed25519 fixture signatures).
fn rc_fixture() -> LinuxServiceVerifierFixtureV1:
    linux_service_verifier_fixture_ops_v1(1, 65, RC_FAR, "/var/lib/simple/hosts", RC_OPERATIONS)

fn rc_fixture_native(fixture: LinuxServiceVerifierFixtureV1, boot: text = RC_BOOT) -> LinuxServiceNativeIdentitySnapshotV3:
    LinuxServiceNativeIdentitySnapshotV3(native_machine_id: fixture.binding.native_machine_id, native_boot_id: boot,
        architecture: "x86_64", owner_generation: 41, process_identity_digest: "e".repeat(64), process_generation: 2,
        authority_namespace_id: "namespace_1")

fn rc_prepare(scope: ContainerHostScopeV2, deadline_ms: i64) -> HostPrepareAssociatedRequestV3:
    val draft = ContainerExecutionDraftV3("linux-podman", "workload", 1, "operation_2", "a".repeat(64), "opaque-codec-DATA")
    val bound = container_execution_draft_bind_v3(draft, scope).unwrap()
    val intent = host_reservation_bind_intent_v1(HostReservationIntentV1(physical_host_id: "worker_1",
        fence: HostLedgerFenceV1("host-authority", container_scope_fence_id_v2(scope).unwrap(), 41, 1),
        plan_digest: container_execution_plan_digest_v2(bound.plan).unwrap(),
        reservation: HostReservationV1("reservation_operation_2", "operation_2", "0".repeat(64), "service_1", 1, "nonce",
            500, 4096, [], deadline_ms, HostReservationStateV1.Prepared))).unwrap()
    val operation = OperationEnvelopeV2(2, intent.reservation.operation_id, intent.reservation.payload_digest, "user_1", "project_1",
        "worker_1", "host_reservation_v1", "a".repeat(64), 4, 2, 3, 4096, 100)
    val grant = ExecutionGrantV2("grant_2", "user_1", "project_1", "worker_1", ["host_reservation_v1"], "a".repeat(64), 4, 2, RC_FAR, 536870912, 1000)
    val proof = linux_service_verifier_sign_v1(operation, grant, 1, 65, RC_FAR)
    HostPrepareAssociatedRequestV3(HostPrepareRequestV1(intent, operation, proof.0, proof.1), draft, scope)

fn rc_native_scope(native: LinuxServiceNativeIdentitySnapshotV3) -> ContainerHostScopeV2:
    ContainerHostScopeV2(physical_host_id: "worker_1", service_scope_id: "epoch-" + "c".repeat(64), boot_id: native.native_boot_id,
        provider_generation: native.owner_generation, native_machine_id: native.native_machine_id,
        continuity_mode: "native-boot-incarnation-v1", continuity_id: native.native_boot_id)

fn rc_open(root: text, capacity: HostCapacityV1) -> HostCapacityOwnerV1:
    var opened: [HostCapacityOwnerV1] = []
    match host_capacity_owner_open_owned_v2(root, capacity, "9".repeat(64), 64, true):
        case HostCapacityOpenV2.Ready(owner): opened.push(owner)
        case HostCapacityOpenV2.Rejected(reason): fail(reason)
        case HostCapacityOpenV2.CleanupRequired(cleanup, reason):
            val closed = distributed_operation_journal_open_cleanup_v2(cleanup)
            expect(closed.error).to_equal("")
            fail(reason)
    opened[0]

describe "Linux service capacity reconcile V4 (service 40, fail-closed)":
    it "refuses an inventory from a different boot or a retained plan from another machine":
        # @req S40-RECONCILE-01
        step("the inventory's own boot must be the actual native boot")
        expect(host_linux_service_inventory_match_v4([rc_row("operation_2", "executing")], rc_inventory("other-boot"), rc_native(),
            rc_capacity()).unwrap_err()).to_equal("linux-service-inventory-boot-mismatch")
        step("a begun row's retained plan must name this native machine")
        var foreign_plan = rc_row("operation_2", "executing")
        foreign_plan.plan_machine_id = "machine_2"
        expect(rc_match([foreign_plan]).unwrap_err()).to_equal("linux-service-inventory-machine-mismatch")
        var no_machine = rc_row("operation_2", "executing")
        no_machine.plan_machine_id = ""
        expect(rc_match([no_machine]).unwrap_err()).to_equal("linux-service-inventory-machine-mismatch")

    it "refuses a different provider generation on the ledger or the inventory":
        # @req S40-RECONCILE-02
        expect(host_linux_service_inventory_match_v4([rc_row("operation_2", "admitted", false)], rc_inventory(), rc_native(),
            rc_capacity(40)).unwrap_err()).to_equal("linux-service-inventory-generation-mismatch")
        step("a store inventory read under a stale fresh-epoch owner generation is refused")
        var stale = rc_inventory()
        stale.owner_generation = 40
        expect(host_linux_service_inventory_match_v4([rc_row("operation_2", "admitted", false)], stale, rc_native(),
            rc_capacity()).unwrap_err()).to_equal("linux-service-inventory-generation-mismatch")

    it "refuses a begun plan without an epoch scope and an unbound or tampered inventory":
        # @req S40-RECONCILE-03
        step("a begun row's plan must carry an epoch scope")
        var unscoped = rc_row("operation_2", "executing")
        unscoped.plan_scope = "service-incarnation-1"
        expect(rc_match([unscoped]).unwrap_err()).to_equal("linux-service-inventory-plan-scope")
        step("an inventory without a store, partition or epoch binding is no observation")
        var unbound = rc_inventory()
        unbound.store_identity_digest = ""
        expect(host_linux_service_inventory_match_v4([], unbound, rc_native(), rc_capacity()).unwrap_err()).to_equal(
            "linux-service-inventory-store-unbound")
        var no_epoch = rc_inventory()
        no_epoch.epoch_digest = "short"
        expect(host_linux_service_inventory_match_v4([], no_epoch, rc_native(), rc_capacity()).unwrap_err()).to_equal(
            "linux-service-inventory-store-unbound")
        step("an inventory read by another process identity is refused")
        var foreign = rc_inventory()
        foreign.process_identity_digest = "9".repeat(64)
        expect(host_linux_service_inventory_match_v4([], foreign, rc_native(), rc_capacity()).unwrap_err()).to_equal(
            "linux-service-inventory-process-mismatch")
        step("any tampered binding changes the digest the second read must reproduce")
        val original = linux_service_inventory_digest_v4(rc_inventory())
        var moved = rc_inventory()
        moved.store_identity_digest = "7".repeat(64)
        expect(linux_service_inventory_digest_v4(moved) != original).to_equal(true)
        var reepoch = rc_inventory()
        reepoch.epoch_digest = "d".repeat(64)
        expect(linux_service_inventory_digest_v4(reepoch) != original).to_equal(true)
        step("duplicate ledger rows are refused")
        expect(rc_match([rc_row("operation_2", "admitted", false), rc_row("operation_2", "admitted", false)]).unwrap_err()).to_equal(
            "linux-service-inventory-row-duplicate")

    it "refuses a begun ledger row whose absence has no retained plan or verified receipt":
        # @req S40-RECONCILE-04
        expect(rc_match([rc_row("operation_2", "executing", false)]).unwrap_err()).to_equal(
            "linux-service-inventory-row-absent-unverified:operation_2")
        expect(rc_match([rc_row("operation_2", "cancelled", false)]).unwrap_err()).to_equal(
            "linux-service-inventory-row-absent-unverified:operation_2")
        step("a never-begun admitted row and a verified abort receipt are accountable absences")
        var aborted = rc_row("operation_3", "cancelled", false)
        aborted.abort_receipt = true
        expect(rc_match([rc_row("operation_2", "admitted", false), aborted]).is_ok()).to_equal(true)

    it "keeps the journal quarantined unless every row drains":
        # @req S40-RECONCILE-05
        step("a store absence says nothing about helper processes; a child barrier keeps its parent")
        var helper = rc_row("helper_1", "admitted", false)
        helper.action = "host_helper_reservation_v1"
        expect(rc_drain([helper]).unwrap_err()).to_equal("linux-service-drain-quarantined:helper_1")
        var barrier = rc_row("operation_2", "executing")
        barrier.child_barrier = true
        expect(rc_drain([barrier]).unwrap_err()).to_equal("linux-service-drain-quarantined:operation_2")
        step("one undrainable row keeps every row charged")
        expect(rc_drain([rc_row("operation_3", "admitted", false), barrier]).unwrap_err()).to_equal(
            "linux-service-drain-quarantined:operation_2")

    it "drains history of earlier epochs and boots after a restart (fixed per-install store)":
        # @req S40-RECONCILE-11
        step("released, admitted and abort-receipt rows need no plan check, whatever epoch or boot planned them")
        var completed = rc_row("op_completed", "completed")
        completed.projected_released = true
        completed.plan_scope = "epoch-" + "d".repeat(64)
        var admitted = rc_row("op_admitted", "admitted")
        admitted.plan_scope = "epoch-" + "d".repeat(64)
        var aborted = rc_row("op_aborted", "cancelled")
        aborted.abort_receipt = true
        val reasons = rc_drain([completed, admitted, aborted]).unwrap()
        expect(reasons.len()).to_equal(3)
        expect(reasons[0].reason).to_equal("completion-receipt")
        expect(reasons[1].reason).to_equal("no-begin-absent")
        expect(reasons[2].reason).to_equal("abort-receipt-absent")
        step("a begun row planned by an earlier epoch of this boot is an accountable absence")
        var earlier = rc_row("op_earlier", "executing")
        earlier.plan_scope = "epoch-" + "d".repeat(64)
        expect(rc_drain([earlier]).unwrap()[0].reason).to_equal("begun-absent")
        # A begun row planned by an earlier boot is covered by S40-RECONCILE-12.

    it "releases every row only from a receipt or a same-machine absence":
        # @req S40-RECONCILE-06
        # @capture(statistics): release reason per projected row
        var completed = rc_row("op_completed", "completed")
        completed.projected_released = true
        var aborted = rc_row("op_aborted", "cancelled", false)
        aborted.abort_receipt = true
        var helper = rc_row("op_helper", "cancelled", false)
        helper.action = "host_helper_reservation_v1"
        helper.abort_receipt = true
        val rows = [completed, rc_row("op_admitted", "admitted", false), aborted, rc_row("op_gone", "executing"), helper]
        val releases = rc_drain(rows).unwrap()
        var reasons: [text] = []
        for release in releases: reasons.push(release.operation_id + "=" + release.reason)
        expect(reasons).to_equal(["op_completed=completion-receipt", "op_admitted=no-begin-absent", "op_aborted=abort-receipt-absent",
            "op_gone=begun-absent", "op_helper=abort-receipt"])

    it "derives row facts only from the held journal and its retained association":
        # @req S40-RECONCILE-07
        val fixture = rc_fixture()
        val policy = local_authority_policy_decode_v1(fixture.policy).unwrap()
        val native = rc_fixture_native(fixture)
        val scope = linux_service_scope_v4(fixture.binding, native, "ab".repeat(16)).unwrap()
        val prepare = rc_prepare(scope, host_local_context_v1(policy).monotonic_ms + 600000)
        val grant = linux_service_prepare_authorize_v4(scope, policy, "issuer_1", prepare, host_local_context_v1(policy)).unwrap()
        val root = secure_temp_dir("/tmp", "s40-reconcile").unwrap()
        val capacity = HostCapacityV1("worker_1", "host-authority", container_scope_fence_id_v2(scope).unwrap(), 41, 2000, 536870912, [])
        val prepared = host_capacity_owner_prepare_v1(rc_open(root + "/journal", capacity), prepare.prepare.intent, prepare.prepare.operation,
            grant, host_local_context_v1(policy)).unwrap()
        step("an admitted row with no retained association has no plan binding")
        val bare = linux_service_row_facts_v4(prepared.journal, prepared.ledger).unwrap()
        expect(bare.len()).to_equal(1)
        expect(bare[0].journal_state).to_equal("admitted")
        expect(bare[0].plan_bound).to_equal(false)
        step("the retained association binds the native machine and epoch scope")
        val receipt = host_reservation_receipt_v1(prepare.prepare.intent, prepare.prepare.operation).unwrap()
        val execution = container_execution_draft_bind_v3(prepare.draft, rc_native_scope(native)).unwrap()
        val association = linux_service_association_v4(fixture.binding, scope, "c".repeat(64), native, prepare, receipt, execution).unwrap()
        val relative = "host-execution-associations/" + sha256_text(container_scope_fence_id_v2(scope).unwrap() + "\n" + "operation_2") + ".sdn"
        expect(distributed_operation_journal_publish_v3(prepared.journal, relative, host_execution_association_encode_v3(association).unwrap()).unwrap()).to_equal(true)
        val facts = linux_service_row_facts_v4(prepared.journal, prepared.ledger).unwrap()
        expect(facts[0].plan_bound).to_equal(true)
        expect(facts[0].plan_machine_id).to_equal(fixture.binding.native_machine_id)
        expect(facts[0].plan_scope).to_equal(rc_native_scope(native).service_scope_id)
        step("the journal-derived facts match this epoch's empty store and drain as a never-begun absence")
        expect(host_linux_service_inventory_match_v4(facts, rc_inventory(), native, prepared.ledger.capacity).is_ok()).to_equal(true)
        expect(host_linux_service_drain_v4(facts).unwrap()[0].reason).to_equal("no-begin-absent")
        step("the journal identity is bound to the held writer and projection revision")
        val identity = linux_service_journal_identity_v4(prepared.journal, prepared.ledger).unwrap()
        var stale = prepared.ledger
        stale.revision = stale.revision + 1
        expect(linux_service_journal_identity_v4(prepared.journal, stale).unwrap_err()).to_equal("linux-service-reconcile-projection-stale")
        expect(identity.byte_len()).to_equal(64)
        val closed = host_capacity_owner_close_owned_v2(prepared)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "releases a begun row whose retained plan names a previous boot (no permanent quarantine)":
        # @req S40-RECONCILE-12 (coordinator decision 2026-11-16; before it this row refused
        # linux-service-inventory-boot-mismatch on every restart and kept the journal quarantined forever)
        # The graph root is persistent and the run root may be tmpfs; preparation proved both empty, censused
        # the service uid range and masked the provider units, so after a reboot nothing of the old plan can
        # be live or come back. The machine is still pinned (S40-RECONCILE-01).
        val fixture = rc_fixture()
        val policy = local_authority_policy_decode_v1(fixture.policy).unwrap()
        val before_reboot = rc_fixture_native(fixture, "previous-boot")
        val scope = linux_service_scope_v4(fixture.binding, before_reboot, "ab".repeat(16)).unwrap()
        val prepare = rc_prepare(scope, host_local_context_v1(policy).monotonic_ms + 600000)
        val grant = linux_service_prepare_authorize_v4(scope, policy, "issuer_1", prepare, host_local_context_v1(policy)).unwrap()
        val root = secure_temp_dir("/tmp", "s40-reconcile-reboot").unwrap()
        val capacity = HostCapacityV1("worker_1", "host-authority", container_scope_fence_id_v2(scope).unwrap(), 41, 2000, 536870912, [])
        val prepared = host_capacity_owner_prepare_v1(rc_open(root + "/journal", capacity), prepare.prepare.intent, prepare.prepare.operation,
            grant, host_local_context_v1(policy)).unwrap()
        step("the previous boot retained an association for its plan")
        val receipt = host_reservation_receipt_v1(prepare.prepare.intent, prepare.prepare.operation).unwrap()
        val execution = container_execution_draft_bind_v3(prepare.draft, rc_native_scope(before_reboot)).unwrap()
        val association = linux_service_association_v4(fixture.binding, scope, "c".repeat(64), before_reboot, prepare, receipt,
            execution).unwrap()
        val relative = "host-execution-associations/" + sha256_text(container_scope_fence_id_v2(scope).unwrap() + "\n" + "operation_2") + ".sdn"
        expect(distributed_operation_journal_publish_v3(prepared.journal, relative, host_execution_association_encode_v3(association).unwrap()).unwrap()).to_equal(true)
        var facts = linux_service_row_facts_v4(prepared.journal, prepared.ledger).unwrap()
        expect(facts[0].plan_bound).to_equal(true)
        step("as a begun row it matches this boot's empty store and drains as an accountable absence")
        # Facts are DATA: mark the derived row begun (the begin itself needs the Linux-protected journal).
        var begun = facts[0]
        begun.journal_state = "executing"
        facts[0] = begun
        val after_reboot = rc_fixture_native(fixture)
        expect(host_linux_service_inventory_match_v4(facts, rc_inventory(), after_reboot, rc_capacity()).is_ok()).to_equal(true)
        expect(host_linux_service_drain_v4(facts).unwrap()[0].reason).to_equal("begun-absent")
        val closed = host_capacity_owner_close_owned_v2(prepared)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "applies continuity only for a proof bound to this owner's journal and exact row set":
        # @req S40-RECONCILE-08
        # @capture(statistics): refusal reason per mismatched proof, row states and continuity after the apply
        # The proof is module-private; a test may construct it (tests may access private).
        val fixture = rc_fixture()
        val policy = local_authority_policy_decode_v1(fixture.policy).unwrap()
        val scope = linux_service_scope_v4(fixture.binding, rc_fixture_native(fixture), "ab".repeat(16)).unwrap()
        val prepare = rc_prepare(scope, host_local_context_v1(policy).monotonic_ms + 600000)
        val grant = linux_service_prepare_authorize_v4(scope, policy, "issuer_1", prepare, host_local_context_v1(policy)).unwrap()
        val root = secure_temp_dir("/tmp", "s40-apply").unwrap()
        val capacity = HostCapacityV1("worker_1", "host-authority", container_scope_fence_id_v2(scope).unwrap(), 41, 2000, 536870912, [])
        val opened = rc_open(root + "/journal", capacity)
        val prepared = host_capacity_owner_prepare_v1(opened, prepare.prepare.intent, prepare.prepare.operation,
            grant, host_local_context_v1(policy)).unwrap()
        var quarantined = prepared
        quarantined.ledger.continuity_proven = false
        val row = quarantined.ledger.reservations[0]
        val release = HostLinuxServiceReleaseV4(operation_id: row.operation_id, payload_digest: row.payload_digest, reason: "no-begin-absent")
        val genuine = HostLinuxServiceReconcileProofV4(journal_identity: linux_service_journal_identity_v4(quarantined.journal, quarantined.ledger).unwrap(),
            row_set_digest: linux_service_row_set_digest_v4(quarantined.ledger), releases: [release])
        step("an already-proven owner is refused")
        expect(linux_service_continuity_apply_v4(prepared, genuine).unwrap_err()).to_equal("host-continuity-already-proven")
        step("a proof of the same journal before its last append does not bind this owner")
        var before = opened
        before.ledger.continuity_proven = false
        var earlier = genuine
        earlier.journal_identity = linux_service_journal_identity_v4(before.journal, before.ledger).unwrap()
        expect(linux_service_continuity_apply_v4(quarantined, earlier).unwrap_err()).to_equal("host-continuity-proof-journal-mismatch")
        step("a changed projected row set is refused, whatever its row states")
        var edited = quarantined
        var charged = edited.ledger.reservations[0]
        charged.cpu_millis = charged.cpu_millis + 1
        edited.ledger.reservations[0] = charged
        expect(linux_service_continuity_apply_v4(edited, genuine).unwrap_err()).to_equal("host-continuity-proof-row-set-mismatch")
        step("every row must be covered exactly once by its own operation and payload")
        var empty = genuine
        empty.releases = []
        expect(linux_service_continuity_apply_v4(quarantined, empty).unwrap_err()).to_equal("host-continuity-proof-coverage")
        var foreign = genuine
        foreign.releases = [HostLinuxServiceReleaseV4(operation_id: "operation_9", payload_digest: row.payload_digest, reason: "no-begin-absent")]
        expect(linux_service_continuity_apply_v4(quarantined, foreign).unwrap_err()).to_equal("host-continuity-proof-coverage")
        step("the bound proof releases every row and sets continuity in memory only")
        val applied = linux_service_continuity_apply_v4(quarantined, genuine).unwrap()
        expect(applied.ledger.continuity_proven).to_equal(true)
        expect(applied.ledger.reservations[0].state == HostReservationStateV1.Released).to_equal(true)
        expect(applied.journal.sequence).to_equal(quarantined.journal.sequence)
        val closed = host_capacity_owner_close_owned_v2(applied)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "refuses a flip whose inventory borrow is not the native identity's reader and custody":
        # @req S40-RECONCILE-09 (flip without a matching inventory)
        val root = secure_temp_dir("/tmp", "s40-reconcile-foreign").unwrap()
        var opened: [HostCapacityOwnerV1] = []
        match host_capacity_owner_open_owned_v2(root + "/journal", rc_capacity(), "9".repeat(64), 64, false):
            case HostCapacityOpenV2.Ready(owner): opened.push(owner)
            case HostCapacityOpenV2.Rejected(reason): fail(reason)
            case HostCapacityOpenV2.CleanupRequired(cleanup, reason):
                val cleaned = distributed_operation_journal_open_cleanup_v2(cleanup)
                expect(cleaned.error).to_equal("")
                fail(reason)
        expect(opened.len()).to_equal(1)
        val owner = opened[0]
        expect(owner.ledger.continuity_proven).to_equal(false)
        expect(host_linux_service_reconcile_flip_v4(owner, rc_native_borrow(4), rc_inventory_borrow(1, 5)).unwrap_err()).to_equal(
            "linux-service-reconcile-inventory-foreign")
        expect(host_linux_service_reconcile_flip_v4(owner, rc_native_borrow(4), rc_inventory_borrow(2, 4)).unwrap_err()).to_equal(
            "linux-service-reconcile-inventory-foreign")
        step("the refused flip leaves the owner quarantined")
        expect(owner.ledger.continuity_proven).to_equal(false)
        val closed = host_capacity_owner_close_owned_v2(owner)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "keeps the proof inside the reconcile module and the capacity owner free of it":
        # @req S40-RECONCILE-10
        # Shape only: Simple does not enforce privacy (E1040/E1046 are never
        # emitted), so the real fence is that no pub fn takes or returns a proof
        # and the continuity-setter ratchet guard (check-continuity-proven-setters.shs).
        val reconcile = file_read_text("src/lib/nogc_sync_mut/orchestration/host_linux_service_reconcile_v4.spl")
        val owner = file_read_text("src/lib/nogc_sync_mut/orchestration/host_capacity_owner_v1.spl")
        val current = file_read_text("src/lib/nogc_sync_mut/orchestration/host_linux_service_current_v4.spl")
        expect(reconcile).to_contain("\nstruct HostLinuxServiceReconcileProofV4:\n")
        expect(rc_count(reconcile, "export HostLinuxServiceReconcileProofV4")).to_equal(0)
        expect(rc_count(reconcile, ", HostLinuxServiceReconcileProofV4")).to_equal(0)
        expect(rc_count(reconcile, "-> Result<HostLinuxServiceReconcileProofV4, text>")).to_equal(1)
        expect(rc_count(reconcile, "fn linux_service_reconcile_v4(")).to_equal(1)
        expect(rc_count(owner, "host_linux_service_reconcile_v4")).to_equal(0)
        expect(current).to_contain("host_linux_service_reconcile_flip_v4(owner.capacity.unwrap(), native, inventory)")
