use std.io.file_read_text
use std.common.contracts.container.execution_v2.ContainerExecutionRequestV2
use std.common.contracts.orchestration.host_capacity_v1.HostLedgerFenceV1
use std.common.contracts.orchestration.host_reservation_codec_v1.host_helper_reservation_receipt_v1
