"""
## Purpose and audience
Pins milestone_0022 N2: the helper settlement commit takes a CLOSED typed kind
(`HostHelperSettlementKindV1`) while its text entry point keeps the exact signature
and the exact refusal for both existing callers (`host_helper_settlement_v1.spl`
stream settle, `host_primary_attach_recovery_v1.spl` attach recovery). One table
maps kind -> record kind text -> field list; there is no second list. Written for
owners of the Host helper settlement path.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable binary when written, 2026-11-17).
## Compatibility and limitations
Pure-data cases over the private table functions (tests may reach private
functions) plus structural pins on the wrapper's order of checks; the live
commit needs a capacity owner and is covered by the existing settle specs, which
are unchanged. The last case is a structural pin: it catches the evidence read
moving into the wrapper, a changed refusal text or a dropped mapping, but it cannot
see a wrapper that returns a different owner under the same text (that needs a live
capacity owner). The `len() == 3` assertion forces a table review when a kind is added.
N3 (DESIGN 13.3) added `PrimaryAttachCancelled` with its own field and fact lists; the
plain commit refuses it (`helper-settlement-use-cancel-commit`) before any evidence read.
## Verification guidance and troubleshooting
If the closed-property case fails a new kind was added without a table row; if a
structural pin fails the wrapper no longer refuses an unknown text with the
original owner before the evidence read.
"""
use std.spec.{step}
use std.io.file_read_text
use std.nogc_sync_mut.orchestration.host_helper_settlement_commit_v1.{HostHelperSettlementKindV1,
    host_helper_settlement_kinds_v1, host_helper_settlement_kind_text_v1, host_helper_settlement_field_names_v1,
    host_helper_settlement_kind_of_text_v1, host_helper_settlement_fact_names_v1}

val N2_PATH = "src/lib/nogc_sync_mut/orchestration/host_helper_settlement_commit_v1.spl"

describe "helper settlement typed kind (milestone_0022 N2)":
    it "maps the two existing texts to the two kinds and back":
        # @req S40-NATIVE-N2
        expect(host_helper_settlement_kind_text_v1(HostHelperSettlementKindV1.StreamSettlement)).to_equal("host-helper-stream-settlement")
        expect(host_helper_settlement_kind_text_v1(HostHelperSettlementKindV1.PrimaryAttachSettlement)).to_equal("host-primary-attach-settlement")
        step("every text round trips through the one table")
        for kind in host_helper_settlement_kinds_v1():
            val back = host_helper_settlement_kind_of_text_v1(host_helper_settlement_kind_text_v1(kind))
            expect(back.is_some()).to_equal(true)
            expect(host_helper_settlement_kind_text_v1(back.unwrap())).to_equal(host_helper_settlement_kind_text_v1(kind))

    it "is closed: every kind has a distinct row and unknown text maps to nothing":
        # @req S40-NATIVE-N2
        val kinds = host_helper_settlement_kinds_v1()
        expect(kinds.len()).to_equal(3)
        expect(host_helper_settlement_kind_text_v1(kinds[0]) != host_helper_settlement_kind_text_v1(kinds[1])).to_equal(true)
        expect(host_helper_settlement_kind_text_v1(kinds[1]) != host_helper_settlement_kind_text_v1(kinds[2])).to_equal(true)
        expect(host_helper_settlement_kind_text_v1(kinds[0]) != host_helper_settlement_kind_text_v1(kinds[2])).to_equal(true)
        expect(host_helper_settlement_kind_text_v1(HostHelperSettlementKindV1.PrimaryAttachCancelled)).to_equal("host-primary-attach-cancelled")
        for text_kind in ["", "host-helper-stream-settlement ", "HOST-PRIMARY-ATTACH-SETTLEMENT", "host-primary-attach-cancel", "primary-attach"]:
            expect(host_helper_settlement_kind_of_text_v1(text_kind).is_none()).to_equal(true)

    it "keeps the nine-name field list byte-identical for both settlement kinds":
        # @req S40-NATIVE-N2
        val expected = ["version", "kind", "operationId", "operationDigest", "requestDigest", "preparedReceiptDigest",
            "consumptionDigest", "nativeIdentityDigest", "treeReceiptDigest"]
        expect(host_helper_settlement_field_names_v1(HostHelperSettlementKindV1.StreamSettlement)).to_equal(expected)
        expect(host_helper_settlement_field_names_v1(HostHelperSettlementKindV1.PrimaryAttachSettlement)).to_equal(expected)
        step("the settlement ACK facts keep their six-key order")
        val facts = ["operationId", "operationDigest", "requestDigest", "preparedReceiptDigest", "nativeIdentityDigest", "treeReceiptDigest"]
        expect(host_helper_settlement_fact_names_v1(HostHelperSettlementKindV1.StreamSettlement)).to_equal(facts)
        expect(host_helper_settlement_fact_names_v1(HostHelperSettlementKindV1.PrimaryAttachSettlement)).to_equal(facts)

    it "gives the cancelled kind its own field and fact lists with no native or tree fields":
        # @req S40-NATIVE-N3
        expect(host_helper_settlement_field_names_v1(HostHelperSettlementKindV1.PrimaryAttachCancelled)).to_equal(
            ["version", "kind", "operationId", "operationDigest", "requestDigest", "preparedReceiptDigest", "refusalDigest"])
        val facts = host_helper_settlement_fact_names_v1(HostHelperSettlementKindV1.PrimaryAttachCancelled)
        expect(facts).to_equal(["operationId", "operationDigest", "requestDigest", "preparedReceiptDigest", "refusalDigest"])
        expect(facts.contains("nativeIdentityDigest") or facts.contains("treeReceiptDigest")).to_equal(false)

    it "refuses the cancelled kind in the plain commit before any evidence read":
        # @req S40-NATIVE-N3
        val source = file_read_text(N2_PATH)
        expect(source.index_of("pub fn host_helper_settlement_commit_kind_v1(") >= 0 and source.index_of("fn host_helper_settlement_facts_v1(") > source.index_of("pub fn host_helper_settlement_commit_kind_v1(")).to_equal(true)
        val typed = source.substring(source.index_of("pub fn host_helper_settlement_commit_kind_v1("),
            source.index_of("fn host_helper_settlement_facts_v1("))
        val refusal = typed.index_of("HostHelperSettlementCommitTurnV1(owner, None, \"helper-settlement-use-cancel-commit\")")
        val evidence = typed.index_of("host_helper_settlement_facts_v1(owner, operation, kind, outcome)")
        expect(refusal >= 0 and evidence > refusal).to_equal(true)
        expect(typed.contains("case HostHelperSettlementKindV1.PrimaryAttachCancelled:")).to_equal(true)
        step("the cancel commit is the only settle path for the cancelled kind")
        expect(source.index_of("pub fn host_helper_cancel_commit_v1(") >= 0).to_equal(true)
        val cancel = source.substring(source.index_of("pub fn host_helper_cancel_commit_v1("), source.byte_len())
        expect(cancel.contains("host_helper_settlement_facts_v1(owner, operation, HostHelperSettlementKindV1.PrimaryAttachCancelled, outcome)")).to_equal(true)

    it "refuses an unknown text with the original owner before any evidence read":
        # @req S40-NATIVE-N2
        val source = file_read_text(N2_PATH)
        val text_entry = source.index_of("pub fn host_helper_settlement_commit_v1(")
        val typed_entry = source.index_of("pub fn host_helper_settlement_commit_kind_v1(")
        expect(text_entry >= 0 and typed_entry > text_entry).to_equal(true)
        val wrapper = source.substring(text_entry, typed_entry)
        step("the wrapper maps text first and returns the unchanged owner with the original refusal text")
        expect(wrapper.contains("host_helper_settlement_kind_of_text_v1(kind)")).to_equal(true)
        expect(wrapper.contains("HostHelperSettlementCommitTurnV1(owner, nil, \"helper-settlement-domain-invalid\")")).to_equal(true)
        step("the wrapper never reads evidence itself: only the typed entry point does")
        expect(wrapper.contains("host_capacity_completion_evidence_owned_v2")).to_equal(false)
        expect(wrapper.contains("host_helper_settlement_commit_kind_v1(")).to_equal(true)
        step("the typed entry point carries the old body: evidence (via the shared fact helper), per-kind facts, settle")
        val typed = source.substring(typed_entry, source.len())
        expect(typed.contains("host_capacity_completion_evidence_owned_v2")).to_equal(true)
        expect(typed.contains("host_capacity_owner_settle_v1")).to_equal(true)
