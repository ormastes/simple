"""
## Purpose and audience
Pins milestone_0021 PR3 P2R2-F1 for the V4 Linux service agent slot
(`.spipe/simple_orchestrator/continuation_20261116/milestone_0021_agent_owner_v4/DESIGN.md`
section 2, N-06/T-08). The slot keeps the FIRST signed envelope of an agent
operation and is cleared only for exactly that envelope. Written for owners of
the Linux Host service.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable binary when written, 2026-11-17).
## Compatibility and limitations
DATA only. It calls the PRIVATE predicate `linux_service_agent_slot_exact_v4`
(tests may reach private functions). It lives in its own file so that an import
rule change cannot take the other PR3 cases down with it. A same-id conflicting
re-prepare over a live journal needs a real capacity owner and is pinned
structurally in host_linux_service_agent_v4_pr3_spec.spl.
## Verification guidance and troubleshooting
If this file fails to resolve the import, private-function access changed;
the predicate's behaviour is unaffected.
"""
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.nogc_sync_mut.orchestration.host_linux_service_current_v4.linux_service_agent_slot_exact_v4

fn p3_operation(payload: text) -> OperationEnvelopeV2:
    OperationEnvelopeV2(version: 2, id: "op_1", payload_digest: payload, principal: "controller_1", project: "project_1",
        host_id: "host_1", operation: "host-prepare", environment_digest: "c".repeat(64), policy_revision: 4,
        revocation_epoch: 2, session_generation: 3, memory_bytes: 1024, duration_ms: 1000)

describe "V4 agent owner PR3: the agent slot keeps the first envelope (P2R2-F1)":
    it "matches only the exact stored signed envelope, never a same-id different one":
        # @req S40-AGENT-02 (N-06/T-08; P2R2-F1)
        val first = p3_operation("d".repeat(64))
        expect(linux_service_agent_slot_exact_v4(Some(first), first)).to_equal(true)
        expect(linux_service_agent_slot_exact_v4(Some(first), p3_operation("e".repeat(64)))).to_equal(false)
        expect(linux_service_agent_slot_exact_v4(None, first)).to_equal(false)
