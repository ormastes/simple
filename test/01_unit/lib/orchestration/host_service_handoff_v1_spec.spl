"""
## Purpose and audience
AT-OPS-01 (drain/update retains ownership; version refusal): the controller-signed `service-handoff` record, the old
owner's drain-and-publish, and the successor's verify-then-adopt, plus the structural pins that the path is reachable
only through the real V4 service start and route. Owner decisions 2026-11-17: D1 exit-then-adopt (no live custody
transfer), D2 the new unit's start path, D3 the `service-handoff` operation kind, D4 exact wire version only.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable `simple` binary on this host, 2026-11-17).
## Compatibility and limitations
Real Ed25519 signatures from the verifier fixture seeds and a real temporary capacity journal. The full start/restart
across two processes needs the installed fixture (test/03_system/tools/host_service_handoff_live_spec.spl, env-gated).
Shape pins are textual; Simple does not enforce field privacy.
## Verification guidance and troubleshooting
`APPROVAL_EXPIRED` after the wait is the restart-expiry owner decision of 2026-11-16, not a flake.
"""
use std.spec.{step, fail}
use std.io.file_read_text
use test.fixtures.orchestration.host_linux_service_verifier_fixture_v1.*
use std.common.task_runner.distributed_operation_journal_v2.{distributed_operation_journal_open_cleanup_v2,
    distributed_operation_journal_publish_v3, distributed_operation_journal_read_v3}
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.*
use std.nogc_sync_mut.orchestration.host_linux_service_current_v4.linux_service_scope_v4
use std.nogc_sync_mut.orchestration.host_service_handoff_v1.{host_service_handoff_commit_v1, host_service_handoff_verify_v1, host_service_handoff_consume_v1,
    host_service_handoff_pending_relative_v1, host_service_handoff_adopted_relative_v1}
use std.common.contracts.orchestration.host_service_handoff_v1.*
use std.nogc_sync_mut.io.linux_service_native_identity_v3.LinuxServiceNativeIdentitySnapshotV3
use std.nogc_sync_mut.io.local_authority_policy_v1.{local_authority_policy_decode_v1, host_local_context_v1}
use std.nogc_sync_mut.io.file_ops.secure_temp_dir
use std.nogc_sync_mut.io.thread.thread_sleep_ms
use std.nogc_sync_mut.io_runtime.dir_remove
use std.common.contracts.orchestration.host_capacity_v1.*
use std.common.contracts.container.execution_v2.*
use std.common.contracts.distributed_control_v2.{ExecutionGrantV2, OperationEnvelopeV2}
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.orchestration.host_local_root_v3.HostLocalRootV3
use std.nogc_sync_mut.orchestration.host_service_domain_v3.{HostServiceDomainV3, host_service_domain_turn_v3}
use std.nogc_sync_mut.orchestration.host_service_domain_v2.HostServiceRequestV2
use std.nogc_sync_mut.orchestration.host_linux_service_current_v4.HostLinuxServiceCurrentV4

val HO_OPS: [text] = ["service-handoff"]
val HO_FAR: i64 = 4102444800000
val HO_CURRENT_OLD: text = "linux-service-current/" + "ab".repeat(16) + ".sdn"

fn ho_fixture() -> LinuxServiceVerifierFixtureV1:
    linux_service_verifier_fixture_ops_v1(1, 65, HO_FAR, "/var/lib/simple/hosts", HO_OPS)

fn ho_native(fixture: LinuxServiceVerifierFixtureV1) -> LinuxServiceNativeIdentitySnapshotV3:
    LinuxServiceNativeIdentitySnapshotV3(native_machine_id: fixture.binding.native_machine_id, native_boot_id: "native-boot",
        architecture: "x86_64", owner_generation: 41, process_identity_digest: "e".repeat(64), process_generation: 2,
        authority_namespace_id: "namespace_1")

fn ho_scope(fixture: LinuxServiceVerifierFixtureV1, incarnation: text) -> ContainerHostScopeV2:
    linux_service_scope_v4(fixture.binding, ho_native(fixture), incarnation.repeat(16)).unwrap()

fn ho_grant(operations: [text]) -> ExecutionGrantV2:
    ExecutionGrantV2("grant_h", "user_1", "project_1", "worker_1", operations, "a".repeat(64), 4, 2, HO_FAR, 536870912, 1000)

fn ho_record(scope: ContainerHostScopeV2, current_bytes: text, sequence: i64 = 1, retained: text = "") -> HostServiceHandoffV1:
    HostServiceHandoffV1(wire_version: HOST_SERVICE_HANDOFF_WIRE_V1, sequence: sequence, scope: scope,
        from_current_relative: HO_CURRENT_OLD, from_current_digest: sha256_text(current_bytes), retained_operation_digest: retained)

fn ho_signed(record: HostServiceHandoffV1, kind: text = "service-handoff", issuer: i64 = 1, approver: i64 = 65,
        expires: i64 = HO_FAR) -> text:
    val operation = OperationEnvelopeV2(2, "handoff_1", host_service_handoff_digest_v1(record).unwrap(), "user_1", "project_1",
        "worker_1", kind, "a".repeat(64), 4, 2, 3, 4096, 100)
    val signed = linux_service_verifier_sign_v1(operation, ho_grant([kind]), issuer, approver, expires)
    host_service_handoff_proof_encode_v1(HostServiceHandoffProofV1(record, operation, signed.0, signed.1)).unwrap()

fn ho_open(root: text, scope: ContainerHostScopeV2) -> HostCapacityOwnerV1:
    val capacity = HostCapacityV1("worker_1", "host-authority", container_scope_fence_id_v2(scope).unwrap(), 41, 2000, 536870912, [])
    var opened: [HostCapacityOwnerV1] = []
    match host_capacity_owner_open_owned_v2(root, capacity, "9".repeat(64), 64, true):
        case HostCapacityOpenV2.Ready(owner): opened.push(owner)
        case HostCapacityOpenV2.Rejected(reason): fail(reason)
        case HostCapacityOpenV2.CleanupRequired(cleanup, reason):
            val closed = distributed_operation_journal_open_cleanup_v2(cleanup)
            expect(closed.error).to_equal("")
            fail(reason)
    opened[0]

describe "Controller-signed service handoff record (AT-OPS-01)":
    it "round-trips canonically and refuses every other wire version":
        # @req AT-OPS-01 (D4 exact version only)
        # @capture(statistics): refusal reason per altered version field
        val fixture = ho_fixture()
        val record = ho_record(ho_scope(fixture, "ab"), "current-old")
        val bytes = host_service_handoff_bytes_v1(record).unwrap()
        expect(host_service_handoff_decode_v1(bytes).unwrap().sequence).to_equal(1)
        step("an unknown wire version is refused at encode and at decode, never downgraded")
        var future = record
        future.wire_version = "service-handoff-v2"
        expect(host_service_handoff_bytes_v1(future).unwrap_err()).to_equal("service-handoff-version-unsupported")
        val tampered = bytes.replace("service-handoff-v1", "service-handoff-v2")
        expect(host_service_handoff_decode_v1(tampered).is_err()).to_equal(true)
        step("an unknown record version or an extra field is refused")
        expect(host_service_handoff_decode_v1(bytes.replace("version: 1", "version: 2")).is_err()).to_equal(true)
        expect(host_service_handoff_decode_v1(bytes + "extra: 1\n").is_err()).to_equal(true)

    it "binds the operation to the `service-handoff` kind, this record's digest and this host":
        # @req AT-OPS-01 (D3)
        val fixture = ho_fixture()
        val record = ho_record(ho_scope(fixture, "ab"), "current-old")
        val good = OperationEnvelopeV2(2, "handoff_1", host_service_handoff_digest_v1(record).unwrap(), "user_1", "project_1",
            "worker_1", "service-handoff", "a".repeat(64), 4, 2, 3, 4096, 100)
        expect(host_service_handoff_match_v1(record, good).unwrap()).to_equal(true)
        var other_kind = good
        other_kind.operation = "host_reservation_v1"
        expect(host_service_handoff_match_v1(record, other_kind).unwrap_err()).to_equal("service-handoff-operation-mismatch")
        var other_digest = good
        other_digest.payload_digest = "d".repeat(64)
        expect(host_service_handoff_match_v1(record, other_digest).unwrap_err()).to_equal("service-handoff-operation-mismatch")
        var other_host = good
        other_host.host_id = "worker_2"
        expect(host_service_handoff_match_v1(record, other_host).unwrap_err()).to_equal("service-handoff-operation-mismatch")

describe "Old owner drain commit (AT-OPS-01)":
    it "publishes the pending record only for a fresh controller-signed handoff naming its own live state":
        # @req AT-OPS-01 (D1)
        # @capture(statistics): refusal reason per gate
        val fixture = ho_fixture()
        val policy = local_authority_policy_decode_v1(fixture.policy).unwrap()
        val old_scope = ho_scope(fixture, "ab")
        val root = secure_temp_dir("/tmp", "ho-commit").unwrap()
        val capacity = ho_open(root + "/journal", old_scope)
        val journal = capacity.journal
        expect(distributed_operation_journal_publish_v3(journal, HO_CURRENT_OLD, "current-old").unwrap()).to_equal(true)
        val context = host_local_context_v1(policy)
        step("an unconfigured controller, a foreign scope and a bad signature are refused before any write")
        val record = ho_record(old_scope, "current-old")
        val source = ho_signed(record)
        expect(host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_9", context, HO_CURRENT_OLD, "current-old", None, source).unwrap_err())
            .to_equal("linux-host-service-controller-mismatch")
        expect(host_service_handoff_commit_v1(journal, ho_scope(fixture, "cd"), policy, "issuer_1", context, HO_CURRENT_OLD, "current-old", None, source).unwrap_err())
            .to_equal("service-handoff-scope-mismatch")
        expect(host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD, "current-old", None,
            ho_signed(record, "service-handoff", 2, 66)).unwrap_err()).to_equal("ISSUER_SIGNATURE_INVALID")
        step("a record naming other current bytes, or the wrong operation kind, is refused")
        expect(host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD, "other-bytes", None, source).unwrap_err())
            .to_equal("service-handoff-current-mismatch")
        step("a handoff whose envelope is another operation kind cannot even be encoded, so it is never on the wire")
        val foreign_op = OperationEnvelopeV2(2, "handoff_1", host_service_handoff_digest_v1(record).unwrap(), "user_1", "project_1",
            "worker_1", "host_reservation_v1", "a".repeat(64), 4, 2, 3, 4096, 100)
        val foreign_sig = linux_service_verifier_sign_v1(foreign_op, ho_grant(["host_reservation_v1"]), 1, 65, HO_FAR)
        expect(host_service_handoff_proof_encode_v1(HostServiceHandoffProofV1(record, foreign_op, foreign_sig.0, foreign_sig.1)).unwrap_err())
            .to_equal("service-handoff-operation-mismatch")
        step("a record naming an agent slot the owner does not hold is refused")
        expect(host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD, "current-old", None,
            ho_signed(ho_record(old_scope, "current-old", 1, "f".repeat(64)))).unwrap_err()).to_equal("service-handoff-retained-mismatch")
        step("a wrong sequence is refused and nothing was published by any refusal")
        expect(host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD, "current-old", None,
            ho_signed(ho_record(old_scope, "current-old", 2))).unwrap_err()).to_equal("service-handoff-sequence-mismatch")
        expect(distributed_operation_journal_read_v3(journal, host_service_handoff_pending_relative_v1(1), 262144).unwrap().is_none()).to_equal(true)
        step("the genuine handoff publishes exactly once; a second one while it is unconsumed is refused")
        val reply = host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD, "current-old", None, source)
        expect(reply.is_ok()).to_equal(true)
        expect(distributed_operation_journal_read_v3(journal, host_service_handoff_pending_relative_v1(1), 262144).unwrap().unwrap()).to_equal(source)
        expect(host_service_handoff_commit_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD, "current-old", None, source).unwrap_err())
            .to_equal("service-handoff-pending-exists")
        val closed = host_capacity_owner_close_owned_v2(capacity)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

describe "Successor verify-then-adopt (AT-OPS-01)":
    it "adopts one pending handoff exactly once, and only over the predecessor's real journal record":
        # @req AT-OPS-01 (D1: re-prove then adopt; single writer, no ledger-only continuity flip)
        # @capture(statistics): adopted digest and refusal reason per gate
        val fixture = ho_fixture()
        val policy = local_authority_policy_decode_v1(fixture.policy).unwrap()
        val old_scope = ho_scope(fixture, "ab")
        val new_scope = ho_scope(fixture, "cd")
        val new_current = "linux-service-current/" + "cd".repeat(16) + ".sdn"
        val root = secure_temp_dir("/tmp", "ho-adopt").unwrap()
        val capacity = ho_open(root + "/journal", old_scope)
        val journal = capacity.journal
        val context = host_local_context_v1(policy)
        step("no pending record is a plain start")
        expect(host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_1", context, new_current).unwrap()).to_equal("")
        step("a pending record whose predecessor current record is absent or different is refused")
        val record = ho_record(old_scope, "current-old")
        val source = ho_signed(record)
        expect(distributed_operation_journal_publish_v3(journal, host_service_handoff_pending_relative_v1(1), source).unwrap()).to_equal(true)
        expect(host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_1", context, new_current).unwrap_err())
            .to_equal("service-handoff-predecessor-record-missing")
        expect(distributed_operation_journal_publish_v3(journal, HO_CURRENT_OLD, "rewritten").unwrap()).to_equal(true)
        expect(host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_1", context, new_current).unwrap_err())
            .to_equal("service-handoff-predecessor-record-mismatch")
        step("an unconfigured controller and the predecessor's own scope never adopt")
        expect(host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_9", context, new_current).unwrap_err())
            .to_equal("linux-host-service-controller-mismatch")
        expect(host_service_handoff_verify_v1(journal, old_scope, policy, "issuer_1", context, HO_CURRENT_OLD).unwrap_err())
            .to_equal("service-handoff-self-adoption")
        val closed = host_capacity_owner_close_owned_v2(capacity)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "adopts a verified handoff once and consumes it":
        # @req AT-OPS-01
        val fixture = ho_fixture()
        val policy = local_authority_policy_decode_v1(fixture.policy).unwrap()
        val old_scope = ho_scope(fixture, "ab")
        val new_scope = ho_scope(fixture, "cd")
        val new_current = "linux-service-current/" + "cd".repeat(16) + ".sdn"
        val root = secure_temp_dir("/tmp", "ho-adopt-ok").unwrap()
        val capacity = ho_open(root + "/journal", old_scope)
        val journal = capacity.journal
        val context = host_local_context_v1(policy)
        expect(distributed_operation_journal_publish_v3(journal, HO_CURRENT_OLD, "current-old").unwrap()).to_equal(true)
        val source = ho_signed(ho_record(old_scope, "current-old"))
        expect(distributed_operation_journal_publish_v3(journal, host_service_handoff_pending_relative_v1(1), source).unwrap()).to_equal(true)
        val verified = host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_1", context, new_current)
        expect(verified.unwrap()).to_equal(sha256_text(source))
        step("verify writes nothing: a failed reconcile leaves the handoff pending, never consumed")
        expect(distributed_operation_journal_read_v3(journal, host_service_handoff_adopted_relative_v1(1), 4096).unwrap().is_none()).to_equal(true)
        step("consume refuses a record other than the one verify approved")
        expect(host_service_handoff_consume_v1(journal, new_current, "d".repeat(64)).unwrap_err()).to_equal("service-handoff-pending-changed")
        step("consume (after the reconcile) writes the marker once on the same journal; a replay finds nothing pending")
        expect(host_service_handoff_consume_v1(journal, new_current, sha256_text(source)).unwrap()).to_equal(sha256_text(source))
        expect(distributed_operation_journal_read_v3(journal, host_service_handoff_adopted_relative_v1(1), 4096).unwrap().is_some()).to_equal(true)
        expect(host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_1", context, new_current).unwrap()).to_equal("")
        expect(host_service_handoff_consume_v1(journal, new_current, "").unwrap()).to_equal("")
        step("an approval that expires between drain and restart is refused at the successor")
        val expires = host_local_context_v1(policy).grant_clock + 20000
        val short = ho_signed(ho_record(old_scope, "current-old", 2), "service-handoff", 1, 65, expires)
        expect(distributed_operation_journal_publish_v3(journal, host_service_handoff_pending_relative_v1(2), short).unwrap()).to_equal(true)
        var polls = 0
        while host_local_context_v1(policy).grant_clock <= expires and polls < 120:
            thread_sleep_ms(500)
            polls = polls + 1
        expect(host_service_handoff_verify_v1(journal, new_scope, policy, "issuer_1", host_local_context_v1(policy), new_current).unwrap_err())
            .to_equal("APPROVAL_EXPIRED")
        val closed = host_capacity_owner_close_owned_v2(capacity)
        expect(closed.closed and closed.error == "").to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

describe "Handoff wire route (AT-OPS-01)":
    it "frames the signed proof at the domain and fails closed over an unstarted owner":
        # @req AT-OPS-01 (D2)
        val fixture = ho_fixture()
        val domain = HostServiceDomainV3(HostLocalRootV3.LinuxService(HostLinuxServiceCurrentV4(root: "/nonexistent/linux-service")))
        val source = ho_signed(ho_record(ho_scope(fixture, "ab"), "current-old"))
        step("a payload that is not a canonical proof, or names another operation id, is a plain refusal")
        val garbage = host_service_domain_turn_v3(domain, HostServiceRequestV2("host-service-handoff", "handoff_1", "not-a-proof"))
        expect(garbage.exit_code).to_equal(1)
        val foreign = host_service_domain_turn_v3(domain, HostServiceRequestV2("host-service-handoff", "handoff_other", source))
        expect(foreign.exit_code).to_equal(1)
        expect(foreign.response.contains("host-service-handoff-operation-mismatch")).to_equal(true)
        step("a well-formed proof over an unpublished owner needs recovery, never a silent success")
        val unstarted = host_service_domain_turn_v3(domain, HostServiceRequestV2("host-service-handoff", "handoff_1", source))
        expect(unstarted.exit_code).to_equal(2)
        expect(unstarted.response.contains("linux-host-service-current-unpublished")).to_equal(true)

fn ho_current() -> text:
    file_read_text("src/lib/nogc_sync_mut/orchestration/host_linux_service_current_v4.spl")

fn ho_before(source: text, first: text, second: text) -> bool:
    val a = source.index_of(first)
    val b = source.index_of(second)
    a >= 0 and b > a

describe "Handoff wiring pins (AT-OPS-01, nothing unreachable)":
    it "reaches the driver only through the real V4 start, dispatch and route":
        # @req AT-OPS-01 (D2)
        val current = ho_current()
        val module = file_read_text("src/lib/nogc_sync_mut/orchestration/host_service_handoff_v1.spl")
        val domain = file_read_text("src/lib/nogc_sync_mut/orchestration/host_service_domain_v3.spl")
        step("the successor adopts after the journal writer is held and the current record is published, before the reconcile flip")
        expect(ho_before(current, "owner.published = true", "host_service_handoff_verify_v1(")).to_equal(true)
        expect(ho_before(current, "host_service_handoff_verify_v1(", "host_linux_service_reconcile_flip_v4(owner.capacity.unwrap()")).to_equal(true)
        step("a refused verification quarantines through reconcile_error and skips the flip; consume runs only after the flip")
        expect(current).to_contain("owner.reconcile_error = adopted.unwrap_err()")
        expect(ho_before(current, "host_linux_service_reconcile_flip_v4(owner.capacity.unwrap()", "host_service_handoff_consume_v1(")).to_equal(true)
        step("a consume that fails after the flip still quarantines prepare and execute (continuity proven AND reconcile_error set)")
        expect(current).to_contain("if not owner.capacity.unwrap().ledger.continuity_proven or owner.reconcile_error != \"\":")
        expect(current).to_contain("if owner.reconcile_error != \"\": return linux_service_reply_v4(owner, \"\", \"linux-host-service-startup-quarantine\", false)")
        step("draining still lets a live attachment release the writer, and status stops reporting ready")
        expect(current).to_contain("action != \"host_agent_detach_v4\" and action != \"host_agent_cancel_v4\"")
        expect(current).to_contain("if self.draining: return Err(\"linux-host-service-draining\")")
        step("the old owner's drain is a dispatch action; admission stops only after the verified record is published")
        expect(current).to_contain("if action == \"host_service_handoff_v1\": return linux_service_handoff_v4(owner, source)")
        expect(ho_before(current, "host_service_handoff_commit_v1(", "owner.draining = true")).to_equal(true)
        expect(current).to_contain("linux-host-service-draining")
        step("the wire route exists and the domain stays the only caller of the installed dispatch")
        expect(domain).to_contain("host-service-handoff")
        step("the module neither imports the service owner nor touches continuity")
        expect(module.index_of("host_linux_service_current_v4")).to_equal(-1)
        expect(module.index_of("continuity_proven")).to_equal(-1)
        expect(module.index_of("host_capacity_owner_open")).to_equal(-1)
