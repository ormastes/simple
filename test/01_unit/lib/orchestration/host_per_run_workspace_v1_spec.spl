"""
## Purpose and audience
milestone_0047 (owner decision 1, 2026-11-19, "use worktree"): every workspace run gets its OWN child of the
admin-provisioned workspace leaf instead of every run sharing that one leaf. The child name is derived from the run's
operation id (`run-<sha256(operation id)>`), created no-follow and exclusive beneath the held leaf descriptor only after
the run recorded its staging effect, bound into the run's workspace binding digest, mounted as the run's ONLY workspace,
and a controller-signed `retention-release` deletes only that child. The provisioned leaf, its XFS project lease and its
quota stay: the admin provisions once. Written for owners of the Host service, the Linux provider and `remote-run`.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable `simple` binary on this host, 2026-11-19).
## Compatibility and limitations
Linux only for the temp-tree cases (a private directory under /tmp owned by the runner, no privilege). The staging,
binding and release order is pinned structurally; the provisioned-Host case needs an installed Host with a provisioned
XFS project workspace and is BLOCKED unless its fixture env is set. The XFS project quota (hard_bytes) is SHARED by every
retained child of the leaf: a full project refuses new staging until releases happen (fail closed).
## Verification guidance and troubleshooting
A refused per-run mapping is `workspace-source-request-mapping-mismatch` (Host) or `linux-host-remote-build-profile-run-root`
(prepare). Removal refusals are `retained-tree-*`; an absent child on a first release is `workspace-retention-release-run-absent`
unless the run was reaped under the stage-intent regime with no stage intent recorded (milestone_0049).
"""
use std.spec.{step, fail, pending}
use std.io.file_read_text
use std.io_runtime.env_get_opt
use std.common.contracts.container.linux_workspace_profile_v1.*
use std.common.contracts.orchestration.host_retention_release_v1.*
use std.common.contracts.container.execution_v2.ContainerMountProjectionV2
use std.nogc_async_mut.container.providers.linux.workspace_mount_owner_v1.linux_workspace_source_request_match_v1
use std.nogc_async_mut.container.providers.linux.request_v1.LinuxOciRequestV1
use std.nogc_sync_mut.io.retained_directory_stage_v1.retained_stage_leaf_v1
use std.nogc_sync_mut.io.retained_file.retained_directory_open_trusted_v1
use std.nogc_sync_mut.io.anchored_io_linux_v1.anchored_linux_directory_flags_v1
use std.nogc_sync_mut.io.dir_entry_ops.directory_create_private
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove_all}
use std.nogc_sync_mut.io_runtime.{file_write, file_exists, dir_exists, process_run}
use std.nogc_sync_mut.io.time_ops.time_sample_monotonic_nanos_or_failure
use std.common.string_core.string_to_int
use std.common.crypto.sha256.sha256_text
use test.fixtures.orchestration.simple_container_linux_adapter_fixture_v2.linux_container_leaf_fixture_v2

fn pr_profile() -> LinuxWorkspaceInstalledProfileV1:
    LinuxWorkspaceInstalledProfileV1(machine_policy_digest: "a".repeat(64), provider_policy_digest: "b".repeat(64),
        containment_profile_digest: "c".repeat(64), protected_parent: "/srv/simple-workspaces", leaf_name: "fixed",
        expected_pool_id: "xfs:pool", expected_workspace_id: "inode:workspace", quota_id: 42,
        hard_bytes: 1048576, guest_root: "/work", read_only: false)

fn pr_request(host_root: text) -> LinuxOciRequestV1:
    var request = linux_container_leaf_fixture_v2()
    request.mounts = [ContainerMountProjectionV2(host_root: host_root, guest_root: "/work", read_only: false)]
    request.containment_profile_digest = "c".repeat(64)
    request.user_uid = 1000
    request.user_gid = 1001
    request.user_namespace_mode = "keep-id"
    request.replace_entrypoint = true
    request.working_directory = "/work"
    request

fn pr_body(file: text, start: text, stop: text) -> text:
    val source = file_read_text(file)
    val at = source.index_of(start)
    if at < 0: return ""
    val rest = source.substring(at, source.byte_len())
    val to = rest.substring(1, rest.byte_len()).index_of(stop)
    if to < 0: return rest
    rest.substring(0, to + 1)

fn pr_base(tag: text) -> text:
    val base = "/tmp/simple-per-run-spec-" + tag + "-" + str(time_sample_monotonic_nanos_or_failure())
    expect(directory_create_private(base)).to_equal(true)
    base

fn pr_euid() -> i64:
    val (out, _err, code) = process_run("id", ["-u"])
    if code != 0: fail("id -u failed")
    string_to_int(out.trim())

val PR_MOUNT: text = "src/lib/nogc_async_mut/container/providers/linux/workspace_mount_owner_v1.spl"
val PR_BINDING: text = "src/lib/nogc_sync_mut/io/linux_fresh_workspace_binding_v3.spl"
val PR_HOST: text = "src/lib/nogc_sync_mut/orchestration/host_remote_build_retention_release_v1.spl"
val PR_PROVIDER: text = "src/lib/nogc_async_mut/container/providers/linux/workspace_retention_release_v1.spl"
val PR_SERVICE: text = "src/lib/nogc_sync_mut/orchestration/host_linux_service_current_v4.spl"

describe "Per-run workspace name (milestone_0047)":
    it "derives one bounded child name per operation id beneath the provisioned leaf":
        # @req M47-PER-RUN-WORKSPACE (name from the op id, within the leaf and journal segment limits)
        val leaf = linux_workspace_run_leaf_v1("build_op_1")
        expect(leaf).to_equal("run-" + sha256_text("build_op_1"))
        expect(leaf.byte_len()).to_equal(68)
        expect(retained_stage_leaf_v1(leaf)).to_equal(true)
        expect(linux_workspace_run_leaf_v1("build_op_2") != leaf).to_equal(true)
        expect(linux_workspace_run_root_v1(pr_profile(), "build_op_1")).to_equal("/srv/simple-workspaces/fixed/" + leaf)

describe "Per-run request mapping (milestone_0047)":
    it "accepts only this run's child as the one workspace mount, never the shared leaf or another run's child":
        # @req M47-PER-RUN-WORKSPACE (a request can never name the provisioned leaf or a sibling run)
        val profile = pr_profile()
        val own = pr_request("")
        val run_root = linux_workspace_run_root_v1(profile, own.operation_id)
        expect(linux_workspace_source_request_match_v1(profile, pr_request(run_root), 1000).unwrap().len()).to_equal(64)
        expect(linux_workspace_source_request_match_v1(profile, pr_request("/srv/simple-workspaces/fixed"), 1000).unwrap_err())
            .to_equal("workspace-source-request-mapping-mismatch")
        val sibling = linux_workspace_run_root_v1(profile, own.operation_id + "_other")
        expect(linux_workspace_source_request_match_v1(profile, pr_request(sibling), 1000).unwrap_err())
            .to_equal("workspace-source-request-mapping-mismatch")

    it "projects, launches and inspects the run child, and prepare refuses a request that does not name it":
        # @req M47-PER-RUN-WORKSPACE (build projection checks consistent with the per-run path; P2-a stays first)
        val expected = file_read_text("src/lib/common/contracts/container/linux_fresh_workspace_v3.spl")
        expect(expected.contains("\"hostRoot\": SdnValue.String(linux_workspace_run_root_v1(profile, plan.operation_id))")).to_equal(true)
        val launch = file_read_text("src/lib/nogc_sync_mut/io/linux_fresh_workspace_launch_v3.spl")
        expect(launch.contains("\"type=bind,src=\" + linux_workspace_run_root_v1(workspace, plan.operation_id)")).to_equal(true)
        val inspect = file_read_text("src/lib/common/contracts/container/linux_fresh_workspace_inspect_v3.spl")
        expect(inspect.contains("linux_workspace_run_root_v1(workspace, ")).to_equal(true)
        expect(inspect.contains("val source = linux_workspace_source_root_v1(workspace)")).to_equal(false)
        val gate = pr_body("src/lib/nogc_sync_mut/orchestration/host_linux_service_remote_build_v4.spl",
            "pub fn host_remote_build_profile_gate_v4(", "\n# Re-review P3-1")
        expect(gate.contains("linux_workspace_run_leaf_v1(request.operation_id)")).to_equal(true)
        expect(gate.contains("linux-host-remote-build-profile-run-root")).to_equal(true)
        step("the controller derives the run child from the operation id; host-inputs names only the provisioned leaf")
        val author = pr_body("src/app/orchestrator/remote_run_author_v1.spl", "pub fn remote_run_request_bytes_v1(", "\npub fn ")
        expect(author.contains("inputs.host_root + \"/\" + linux_workspace_run_leaf_v1(operation_id)")).to_equal(true)

describe "Per-run staging and binding (milestone_0047)":
    it "creates the run child only after the staging effect is recorded, and stages into it":
        # @req M47-PER-RUN-WORKSPACE (no orphan without an effect; exclusive, no-follow, beneath the held leaf)
        val build = pr_body(PR_MOUNT, "    pub fn stage_remote_build_v3(", "\n    pub fn ")
        val effect = build.index_of("build_effect_attempted = true")
        val create = build.index_of("workspace_run_directory_create_v1(self, request_bytes)")
        val stage = build.index_of("linux_remote_build_stage_bytes_v1(run")
        expect(effect >= 0 and create > effect and stage > create).to_equal(true)
        expect(build.contains("state.root_directory.unwrap().directory_is_empty_v1()")).to_equal(false)
        val agent = pr_body(PR_MOUNT, "    fn stage_agent_installed_v1(", "\n    # milestone_0030 op (i)")
        val agent_effect = agent.index_of("agent_effect_attempted = true")
        val agent_create = agent.index_of("workspace_run_directory_create_v1(self, request_bytes)")
        val agent_stage = agent.index_of("linux_agent_workspace_stage_bytes_v1(run")
        expect(agent_effect >= 0 and agent_create > agent_effect and agent_stage > agent_create).to_equal(true)
        val create_fn = pr_body(PR_MOUNT, "fn workspace_run_directory_create_v1(", "\nfn ")
        expect(create_fn.contains(".stage_directory_v1(linux_workspace_run_leaf_v1(")).to_equal(true)
        expect(create_fn.contains(", true)")).to_equal(true)
        step("the settled read and both bindings use the run child; the shared leaf is never staged into")
        expect(pr_body(PR_MOUNT, "    pub fn read_settled_build_v3(", "\n    pub fn ").contains("linux_remote_build_read_v1(state.run_directory.unwrap()"))
            .to_equal(true)
        expect(file_read_text(PR_MOUNT).contains("state.root_directory.unwrap(), state.run_directory.unwrap(),")).to_equal(true)
        step("a run child exists only after an effect, and a source with an effect never plain-closes (retained)")
        val close = pr_body(PR_MOUNT, "    pub fn close_v1(", "\n# This acquires")
        expect(close.contains("remote-build-workspace-retention-requires-authorized-cleanup")).to_equal(true)

    it "binds the run child's identity into the workspace binding digest":
        # @req M47-PER-RUN-WORKSPACE (the run child is part of the run's binding digest, rechecked every observation)
        val binding = file_read_text(PR_BINDING)
        expect(binding.contains("sha256_u8_hex(parent_identity + root_identity + run_identity)")).to_equal(true)
        expect(binding.contains("owner.root_directory.stage_child_match_v1(linux_workspace_run_leaf_v1(plan.operation_id), owner.run_directory)"))
            .to_equal(true)

describe "Per-run retention release (milestone_0047)":
    it "derives one run's release with no shared-leaf holder admission":
        # @req M47-PER-RUN-WORKSPACE (two retained runs no longer refuse each other)
        val derivation = pr_body(PR_HOST, "pub fn host_retention_release_expected_v1(", "\npub fn ")
        expect(derivation.contains("retention-release-ambiguous")).to_equal(false)
        expect(derivation.contains("retention-release-nothing-retained")).to_equal(true)

    it "deletes only the run child beneath the held leaf and never native-releases the provisioned leaf":
        # @req M47-PER-RUN-WORKSPACE (retention-release deletes only that run's child; the leaf stays provisioned)
        val effect = pr_body(PR_PROVIDER, "pub fn linux_workspace_retention_release_v1(", "\nexport ")
        val open = effect.index_of("root.open_source_v3(")
        val absent = effect.index_of(".retained_run_absent_v1(")
        val remove = effect.index_of(".remove_retained_tree_v1(")
        val close = effect.index_of("val closed = source.close_v1()")
        expect(open >= 0 and absent > open and remove > absent and close > remove).to_equal(true)
        expect(effect.contains("workspace_storage_release_if_absent_v1")).to_equal(false)
        expect(effect.contains("workspace_storage_forget_released_v1")).to_equal(false)
        expect(effect.contains("\"run-removed\"")).to_equal(true)
        expect(effect.contains("retention_release_absent_v1(absent_settles)")).to_equal(true)
        val absent_turn = pr_body(PR_PROVIDER, "fn retention_release_absent_v1(", "\n\n")
        expect(absent_turn.contains("if not absent_settles: return retention_release_failed_v1(\"workspace-retention-release-run-absent\")"))
            .to_equal(true)
        val mount = pr_body(PR_MOUNT, "    pub fn remove_retained_tree_v1(", "\n    pub fn ")
        expect(mount.contains(".remove_child_tree_v1(linux_workspace_run_leaf_v1(sample.request.operation_id), sample.process.effective_uid)"))
            .to_equal(true)
        expect(mount.contains("sample.profile.leaf_name")).to_equal(false)
        step("the run child is opened as the SAME stated directory: a name that stops being it refuses, nothing unlinked")
        val child = pr_body("src/lib/nogc_sync_mut/io/retained_tree_remove_v1.spl",
            "pub fn retained_tree_remove_child_tree_v1(", "\n# Whether ")
        expect(child.contains("retained_tree_open_directory_v1(parent_fd, bytes, entry, parent)")).to_equal(true)
        expect(child.contains("retained_tree_child_v1(")).to_equal(false)

    it "admits its own lease and drops the hold on every exit, so the next workload prepare needs no restart":
        # @req M47-LEASE-DROP (bug: a release kept the leaf lease in-process and refused every later prepare until restart)
        val effect = pr_body(PR_PROVIDER, "pub fn linux_workspace_retention_release_v1(", "\nexport ")
        step("a fresh admission (full native re-proof of the leaf), never adoption of an in-process token")
        expect(effect.contains("root.admit_lease_v3()")).to_equal(true)
        expect(effect.contains("recover_lease_v3")).to_equal(false)
        step("every exit after the admission drops the hold; a source exit drops only after a CONFIRMED close")
        expect(effect.contains("workspace_storage_close_retained_v1")).to_equal(false)
        val drop = pr_body(PR_PROVIDER, "fn retention_release_drop_v1(", "\n\n")
        expect(drop.contains("workspace_storage_close_retained_v1(lease)")).to_equal(true)
        val after = pr_body(PR_PROVIDER, "fn retention_release_after_close_v1(", "\n\n")
        val unconfirmed = after.index_of("    if not closed.closed:")
        val kept = after.index_of("workspace-retention-release-hold-kept")
        val dropping = after.index_of("retention_release_drop_v1(lease")
        expect(unconfirmed >= 0 and kept > unconfirmed and dropping > kept).to_equal(true)
        var direct = 0
        var via_close = 0
        var via_drop = 0
        for line in effect.split("\n"):
            if line.contains("return retention_release_failed_v1("): direct = direct + 1
            if line.contains("return retention_release_after_close_v1(lease, "): via_close = via_close + 1
            if line.contains("return retention_release_drop_v1(lease, "): via_drop = via_drop + 1
        expect(direct).to_equal(1)
        expect(effect.contains("if admitted.is_err(): return retention_release_failed_v1(admitted.unwrap_err())")).to_equal(true)
        expect(via_close).to_equal(5)
        expect(via_drop).to_equal(3)
        val closed = effect.index_of("val closed = source.close_v1()")
        val observe = effect.index_of("workspace_storage_observe_v1(lease)")
        val success = effect.index_of("retention_release_drop_v1(lease, LinuxWorkspaceRetentionReleaseTurnV1(charge: \"run-removed\"")
        expect(closed >= 0 and observe > closed and success > observe).to_equal(true)
        step("the service keeps no in-process hold and no restart gate")
        expect(file_read_text(PR_SERVICE).contains("retention_lease_held")).to_equal(false)
        expect(file_read_text(PR_SERVICE).contains("linux-host-retention-lease-held")).to_equal(false)
        val handler = pr_body(PR_SERVICE, "fn linux_service_retention_release_v4(", "\n# milestone_0045 retention-release inspect")
        expect(handler.contains("owner.agent_operation_id != \"\"")).to_equal(true)
        step("the native drop refuses a loaned or released slot and touches no quota")
        val native = file_read_text("src/runtime/runtime_workspace_storage_v1.c")
        expect(native.contains("int64_t rt_workspace_storage_close_retained_v1(int64_t token) {")).to_equal(true)
        expect(native.contains("else if(slot->busy||slot->released)error=EBUSY;")).to_equal(true)

    it "archives the run removal with the shared project usage and refuses the retired leaf-release class":
        # @req M47-PER-RUN-WORKSPACE (charge vocabulary describes what happened: the run child was removed)
        val removed = host_retention_released_bytes_v1(HostRetentionReleasedV1(operation_id: "build_op_1",
            marker_digest: "6".repeat(64), charge: "run-removed", used_bytes: 4096, used_inodes: 3, removed: 12,
            released_at_ms: 1700000000000))
        expect(removed.is_ok()).to_equal(true)
        expect(host_retention_released_decode_v1(removed.unwrap()).unwrap().charge).to_equal("run-removed")
        expect(host_retention_released_bytes_v1(HostRetentionReleasedV1(operation_id: "build_op_1", marker_digest: "6".repeat(64),
            charge: "native-released", used_bytes: 0, used_inodes: 0, removed: 1, released_at_ms: 1)).is_err()).to_equal(true)
        expect(host_retention_released_bytes_v1(HostRetentionReleasedV1(operation_id: "build_op_1", marker_digest: "6".repeat(64),
            charge: "run-removed", used_bytes: -1, used_inodes: 0, removed: 1, released_at_ms: 1)).is_err()).to_equal(true)
        step("absent-unmeasured (owner decision 2, amended milestone_0049): a resumed or never-staged release whose child is absent")
        expect(host_retention_released_bytes_v1(HostRetentionReleasedV1(operation_id: "build_op_1", marker_digest: "6".repeat(64),
            charge: "absent-unmeasured", used_bytes: -1, used_inodes: -1, removed: -1, released_at_ms: 1)).is_ok()).to_equal(true)

describe "Per-run child removal on a private temp tree (milestone_0047)":
    it "removes one run child and its tree while a sibling run child and the leaf stay":
        # @req M47-PER-RUN-WORKSPACE (no-follow, fd-relative; only the named child is removed)
        if anchored_linux_directory_flags_v1() == 0: return
        val base = pr_base("sibling")
        val mine = linux_workspace_run_leaf_v1("build_op_1")
        val other = linux_workspace_run_leaf_v1("build_op_2")
        expect(dir_create(base + "/" + mine + "/out/deep", true)).to_equal(true)
        expect(file_write(base + "/" + mine + "/out/deep/a.txt", "a\n")).to_equal(true)
        expect(dir_create(base + "/" + other + "/kept", true)).to_equal(true)
        expect(file_write(base + "/" + other + "/kept/b.txt", "b\n")).to_equal(true)
        val (_o, _e, linked) = process_run("ln", ["-s", base + "/" + other, base + "/" + mine + "/escape"])
        expect(linked).to_equal(0)
        val leaf = retained_directory_open_trusted_v1(base).unwrap()
        val removed = leaf.remove_child_tree_v1(mine, pr_euid())
        expect(removed.is_ok()).to_equal(true)
        expect(removed.unwrap()).to_equal(5)
        expect(leaf.child_absent_v1(mine).unwrap()).to_equal(true)
        expect(file_exists(base + "/" + other + "/kept/b.txt")).to_equal(true)
        step("an absent run child refuses, and a foreign owner uid refuses before anything is removed")
        expect(leaf.remove_child_tree_v1(mine, pr_euid()).is_err()).to_equal(true)
        expect(leaf.remove_child_tree_v1(other, pr_euid() + 1).is_err()).to_equal(true)
        expect(dir_exists(base + "/" + other + "/kept")).to_equal(true)
        var held = leaf
        expect(held.close()).to_equal(true)
        expect(dir_remove_all(base)).to_equal(true)

describe "Per-run workspace on a provisioned Host (milestone_0047, live root)":
    it "runs two remote builds in their own children and releases each without re-provisioning":
        # @req M47-PER-RUN-WORKSPACE (live root; BLOCKED unless the installed Host fixture is configured)
        if (env_get_opt("SIMPLE_PER_RUN_HOST_FIXTURE") ?? "") == "":
            pending("BLOCKED: installed Host + provisioned XFS workspace fixture env unset: SIMPLE_PER_RUN_HOST_FIXTURE")
            return
        fail("SIMPLE_PER_RUN_HOST_FIXTURE is set but no live driver is wired for this lane yet")
