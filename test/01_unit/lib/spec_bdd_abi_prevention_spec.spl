# Prevention: rt_bdd_record_result takes an i64 in the Rust and C runtimes (like
# rt_bdd_it_end). The Simple extern must declare i64 and pass 1/0, never bool: a
# native bool may leave upper register bits undefined and the runtime tests all 64.
extern fn rt_file_read_text(path: text) -> text?

describe "std.spec rt_bdd_* ABI":
    it "declares rt_bdd_record_result with an i64 and calls it with 1/0":
        val src = rt_file_read_text("src/lib/nogc_sync_mut/spec.spl") ?? ""
        expect(src.contains("extern fn rt_bdd_record_result(passed: i64)")).to_equal(true)
        expect(src.contains("extern fn rt_bdd_record_result(passed: bool)")).to_equal(false)
        expect(src.contains("rt_bdd_record_result(true)")).to_equal(false)
        expect(src.contains("rt_bdd_record_result(false)")).to_equal(false)
