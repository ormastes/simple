# Extension import compatibility stays separate from primary-only admission.
use std.spec.*
use std.gc_async_mut.gpu.engine3d.backend.{RenderBackend3D}
use std.gc_sync_mut.gpu.engine3d.backend_cpu_ext.{CpuBackend3D}
use std.gc_sync_mut.gpu.engine3d.backend_baremetal_ext.{BaremetalBackend3D}
use std.gc_sync_mut.gpu.engine3d.backend_intel_ext.{IntelBackend3D}
use std.gc_sync_mut.gpu.engine3d.backend_opengl_ext.{OpenGLBackend3D}
use std.gc_sync_mut.gpu.engine3d.backend_qualcomm_ext.{QualcommBackend3D}
use std.gc_sync_mut.gpu.engine3d.backend_virtio_gpu_ext.{VirtioGpuBackend3D}
fn p2_p3_adjacent_regression(backend: RenderBackend3D, expected_name: text):
    expect(backend.name()).to_equal(expected_name)

describe "Engine3D extension compatibility follows real primary owners":
    it "keeps the CPU compatibility path after its old extension was removed":
        step("Reject the adjacent regression")
        p2_p3_adjacent_regression(CpuBackend3D.create(), "cpu3d")
    it "retains the baremetal extension import through the sync facade":
        step("Reject the adjacent regression")
        p2_p3_adjacent_regression(BaremetalBackend3D.create(), "baremetal3d")

    it "retains the intel extension import through the sync facade":
        step("Reject the adjacent regression")
        p2_p3_adjacent_regression(IntelBackend3D.create(), "intel3d")

    it "retains the opengl extension import through the sync facade":
        step("Reject the adjacent regression")
        p2_p3_adjacent_regression(OpenGLBackend3D.create(), "opengl3d")

    it "retains the qualcomm extension import through the sync facade":
        step("Reject the adjacent regression")
        p2_p3_adjacent_regression(QualcommBackend3D.create(), "qualcomm3d")

    it "retains the virtio_gpu extension import through the sync facade":
        step("Reject the adjacent regression")
        p2_p3_adjacent_regression(VirtioGpuBackend3D.create(), "virtiogpu3d")
