use std.spec.{describe, it, expect}
use std.nogc_sync_mut.gpu.engine3d.ffi_dispatch3d.{gpu_lib_candidates_for_os_3d, gpu_lib_candidates_3d}
use std.nogc_sync_mut.gpu.engine3d.sffi_dispatch3d.{gpu_lib_candidates_for_os_3d as sffi_candidates_for_os_3d}
use std.io_runtime.{platform_name}

describe "3D GPU dynamic library candidates":
    it "maps each OS to its own library naming":
        expect(gpu_lib_candidates_for_os_3d("windows", "vulkan")[0]).to_equal("vulkan.dll")
        expect(gpu_lib_candidates_for_os_3d("macos", "vulkan")[0]).to_equal("libvulkan.dylib")
        expect(gpu_lib_candidates_for_os_3d("linux", "vulkan")[0]).to_equal("libvulkan.so.1")
        expect(sffi_candidates_for_os_3d("macos", "vulkan")[1]).to_equal("libvulkan.1.dylib")

    it "uses the runtime platform identity, not SIMPLE_OS_TYPE":
        val actual = gpu_lib_candidates_3d("vulkan")
        val expected = gpu_lib_candidates_for_os_3d(platform_name(), "vulkan")
        expect(actual[0]).to_equal(expected[0])
