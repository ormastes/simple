# Exact primary-owner regression; no extension module is imported here.
# Tests trait admission and existing framebuffer behavior, not GPU availability.
use std.spec.*
use std.gc_async_mut.gpu.engine3d.backend.{RenderBackend3D}
use std.gc_async_mut.gpu.engine3d.backend_baremetal.{BaremetalBackend3D}
use std.gc_async_mut.gpu.engine3d.backend_intel.{IntelBackend3D}
use std.gc_async_mut.gpu.engine3d.backend_opengl.{OpenGLBackend3D}
use std.gc_async_mut.gpu.engine3d.backend_qualcomm.{QualcommBackend3D}
use std.gc_async_mut.gpu.engine3d.backend_virtio_gpu.{VirtioGpuBackend3D}
use std.gc_async_mut.gpu.engine3d.backend_webgpu.{WebGpuBackend3D}
fn p2_p3_bug_reproduction(backend: RenderBackend3D, expected_name: text):
    expect(backend.name()).to_equal(expected_name)
    expect(backend.init(2, 2)).to_equal(true)
    backend.clear(0xFF000000u32)
    expect(backend.occlusion_query(0, 0, 2, 2)).to_equal(0)
    backend.draw_image(0, 0, 2, 2,
        [0xFFFFFFFFu32, 0xFF000000u32, 0xFF000000u32, 0xFF123456u32])
    expect(backend.occlusion_query(0, 0, 2, 2)).to_equal(2)
    expect(backend.occlusion_query(-1, -1, 2, 2)).to_equal(1)
    expect(backend.occlusion_query(2, 2, 1, 1)).to_equal(0)
    backend.shutdown()

describe "remaining Engine3D primary owners implement the rendering trait":
    it "admits the baremetal primary owner without its extension module":
        step("Reproduce the exact failure")
        p2_p3_bug_reproduction(BaremetalBackend3D.create(), "baremetal3d")

    it "admits the intel primary owner without its extension module":
        step("Reproduce the exact failure")
        p2_p3_bug_reproduction(IntelBackend3D.create(), "intel3d")

    it "admits the opengl primary owner without its extension module":
        step("Reproduce the exact failure")
        p2_p3_bug_reproduction(OpenGLBackend3D.create(), "opengl3d")

    it "admits the qualcomm primary owner without its extension module":
        step("Reproduce the exact failure")
        p2_p3_bug_reproduction(QualcommBackend3D.create(), "qualcomm3d")

    it "admits the virtio_gpu primary owner without its extension module":
        step("Reproduce the exact failure")
        p2_p3_bug_reproduction(VirtioGpuBackend3D.create(), "virtiogpu3d")

    it "admits the webgpu primary owner without its extension module":
        step("Reproduce the exact failure")
        p2_p3_bug_reproduction(WebGpuBackend3D.create(), "webgpu3d")
