"""
## Purpose and audience
Purpose: Prove that Engine3D Textures.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

# @tag: gpu, engine3d, texture
# @cover src/lib/gc_async_mut/gpu/engine3d/texture3d.spl 60%

use std.spec.{describe, context, it, expect}
use std.gpu.engine3d.texture3d.{
    TextureDescriptor3D, SamplerDescriptor3D,
    bytes_per_pixel_3d, is_depth_format, is_compressed_format,
    TEX_DIM_2D, TEX_DIM_3D, TEX_DIM_CUBE, TEX_DIM_2D_ARRAY,
    TEX_FMT_RGBA8_UNORM, TEX_FMT_DEPTH32_FLOAT, TEX_FMT_BC1_UNORM,
    FILTER_NEAREST, FILTER_LINEAR,
    COMPARE_NONE, COMPARE_LESS
}

use std.spec.step

describe "Engine3D Textures":

    context "TextureDescriptor3D.create_2d":

        it "sets width and height":
            step("Verify: sets width and height")
            # @req: REQ-LIB-GPU-001
            val t = TextureDescriptor3D.create_2d(256, 128, TEX_FMT_RGBA8_UNORM)
            expect(t.width).to_equal(256)  # oracle: 256 — named expected value from the requirement
            expect(t.height).to_equal(128)  # oracle: 128 — named expected value from the requirement

        it "dimension is TEX_DIM_2D":
            step("Verify: dimension is TEX_DIM_2D")
            val t = TextureDescriptor3D.create_2d(64, 64, TEX_FMT_RGBA8_UNORM)
            expect(t.dimension).to_equal(TEX_DIM_2D)

        it "depth_or_layers is 1":
            step("Verify: depth_or_layers is 1")
            val t = TextureDescriptor3D.create_2d(64, 64, TEX_FMT_RGBA8_UNORM)
            expect(t.depth_or_layers).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "TextureDescriptor3D.create_3d":

        it "dimension is TEX_DIM_3D":
            step("Verify: dimension is TEX_DIM_3D")
            val t = TextureDescriptor3D.create_3d(32, 32, 16, TEX_FMT_RGBA8_UNORM)
            expect(t.dimension).to_equal(TEX_DIM_3D)

        it "depth_or_layers matches depth argument":
            step("Verify: depth_or_layers matches depth argument")
            val t = TextureDescriptor3D.create_3d(32, 32, 16, TEX_FMT_RGBA8_UNORM)
            expect(t.depth_or_layers).to_equal(16)  # oracle: 16 — named expected value from the requirement

    context "TextureDescriptor3D.create_cube":

        it "dimension is TEX_DIM_CUBE":
            step("Verify: dimension is TEX_DIM_CUBE")
            val t = TextureDescriptor3D.create_cube(128, TEX_FMT_RGBA8_UNORM)
            expect(t.dimension).to_equal(TEX_DIM_CUBE)

        it "depth_or_layers is 6":
            step("Verify: depth_or_layers is 6")
            val t = TextureDescriptor3D.create_cube(128, TEX_FMT_RGBA8_UNORM)
            expect(t.depth_or_layers).to_equal(6)  # oracle: 6 — named expected value from the requirement

    context "TextureDescriptor3D.create_depth":

        it "format is TEX_FMT_DEPTH32_FLOAT":
            step("Verify: format is TEX_FMT_DEPTH32_FLOAT")
            val t = TextureDescriptor3D.create_depth(1920, 1080)
            expect(t.format).to_equal(TEX_FMT_DEPTH32_FLOAT)

        it "dimension is TEX_DIM_2D":
            step("Verify: dimension is TEX_DIM_2D")
            val t = TextureDescriptor3D.create_depth(1920, 1080)
            expect(t.dimension).to_equal(TEX_DIM_2D)

    context "TextureDescriptor3D.create_2d_array":

        it "dimension is TEX_DIM_2D_ARRAY":
            step("Verify: dimension is TEX_DIM_2D_ARRAY")
            val t = TextureDescriptor3D.create_2d_array(256, 256, 4, TEX_FMT_RGBA8_UNORM)
            expect(t.dimension).to_equal(TEX_DIM_2D_ARRAY)

        it "depth_or_layers matches layers argument":
            step("Verify: depth_or_layers matches layers argument")
            val t = TextureDescriptor3D.create_2d_array(256, 256, 8, TEX_FMT_RGBA8_UNORM)
            expect(t.depth_or_layers).to_equal(8)  # oracle: 8 — named expected value from the requirement

    context "SamplerDescriptor3D.create_default":

        it "mag_filter is FILTER_LINEAR":
            step("Verify: mag_filter is FILTER_LINEAR")
            val s = SamplerDescriptor3D.create_default()
            expect(s.mag_filter).to_equal(FILTER_LINEAR)

        it "min_filter is FILTER_LINEAR":
            step("Verify: min_filter is FILTER_LINEAR")
            val s = SamplerDescriptor3D.create_default()
            expect(s.min_filter).to_equal(FILTER_LINEAR)

    context "SamplerDescriptor3D.create_nearest":

        it "mag_filter is FILTER_NEAREST":
            step("Verify: mag_filter is FILTER_NEAREST")
            val s = SamplerDescriptor3D.create_nearest()
            expect(s.mag_filter).to_equal(FILTER_NEAREST)

        it "min_filter is FILTER_NEAREST":
            step("Verify: min_filter is FILTER_NEAREST")
            val s = SamplerDescriptor3D.create_nearest()
            expect(s.min_filter).to_equal(FILTER_NEAREST)

    context "SamplerDescriptor3D.create_shadow":

        it "compare is COMPARE_LESS":
            step("Verify: compare is COMPARE_LESS")
            val s = SamplerDescriptor3D.create_shadow()
            expect(s.compare).to_equal(COMPARE_LESS)

    context "bytes_per_pixel_3d":

        it "RGBA8 returns 4":
            step("Verify: RGBA8 returns 4")
            expect(bytes_per_pixel_3d(TEX_FMT_RGBA8_UNORM)).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "DEPTH32_FLOAT returns 4":
            step("Verify: DEPTH32_FLOAT returns 4")
            expect(bytes_per_pixel_3d(TEX_FMT_DEPTH32_FLOAT)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    context "is_depth_format":

        it "DEPTH32_FLOAT is depth":
            step("Verify: DEPTH32_FLOAT is depth")
            expect(is_depth_format(TEX_FMT_DEPTH32_FLOAT)).to_equal(true)

        it "RGBA8_UNORM is not depth":
            step("Verify: RGBA8_UNORM is not depth")
            expect(is_depth_format(TEX_FMT_RGBA8_UNORM)).to_equal(false)

    context "is_compressed_format":

        it "BC1_UNORM is compressed":
            step("Verify: BC1_UNORM is compressed")
            expect(is_compressed_format(TEX_FMT_BC1_UNORM)).to_equal(true)

        it "RGBA8_UNORM is not compressed":
            step("Verify: RGBA8_UNORM is not compressed")
            expect(is_compressed_format(TEX_FMT_RGBA8_UNORM)).to_equal(false)

    context "TEX_DIM constants":

        it "TEX_DIM_2D is 0":
            step("Verify: TEX_DIM_2D is 0")
            expect(TEX_DIM_2D).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "TEX_DIM_3D is 1":
            step("Verify: TEX_DIM_3D is 1")
            expect(TEX_DIM_3D).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "TEX_DIM_CUBE is 2":
            step("Verify: TEX_DIM_CUBE is 2")
            expect(TEX_DIM_CUBE).to_equal(2)  # oracle: 2 — named expected value from the requirement
