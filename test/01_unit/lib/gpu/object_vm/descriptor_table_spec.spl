"""
## Purpose and audience
Purpose: Prove that object vm descriptor table lease epochs.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

# ============================================================================
# PLACE lane — Object VM descriptor table contract (reconciled API).
#
# Ported from the gpu-mmu lane's class-based DescriptorTable spec (branch
# layout-web-layout-interface-clean, dropped at landing because it deleted
# residency_model.spl) onto the mainline functional object_vm API, plus the
# capabilities grafted from that lane: count-based pins, in-flight transfer
# protection, retired-slot reuse, and the typed ObjectRef/ResidentView bridge.
#
# Behaviour claims (every claim is an observable result of calling the model):
#   1. EPOCHS — consecutive leases carry increasing epochs; releasing a
#      superseded epoch faults StaleLease, releasing the current one succeeds.
#   2. STALE HANDLE — a wrong-generation handle faults StaleGeneration, and
#      the typed-handle staleness helper agrees.
#   3. STALE VIEW — a resident view with a wrong lease epoch cannot release;
#      the typed view minted from a live lease carries the lease's fields.
#   4. PROTECTION — a positive pin count or in-flight transfer count blocks
#      retire with a Protected fault; draining both unblocks it.
#   5. REUSE — a retired slot is reused by a later define and the reused slot
#      carries an advanced generation.
#   6. EPOCH KEY — the slot/epoch key packing is deterministic.
# ============================================================================

# @tag: unit, gpu, gpu-mmu, object-vm

use std.spec
use std.nogc_async_mut.gpu.object_vm.descriptor_table.{
    object_vm_table_empty,
    object_vm_define,
    object_vm_retire,
    object_vm_acquire_lease,
    object_vm_release_lease,
    object_vm_pin,
    object_vm_touch,
    object_vm_is_protected,
    object_vm_epoch_key,
    object_vm_object_ref,
    object_vm_resident_view,
    object_vm_handles_stale,
    object_vm_fault_to_u8
}

val TIER_DEVICE_LOCAL: i64 = 0
val TIER_HOST_COLD: i64 = 4

# Fault wire codes, mirrored from object_vm_fault_to_u8 so assertions compare
# stable integers instead of enum values.
val FAULT_STALE_GENERATION: i64 = 2
val FAULT_STALE_LEASE: i64 = 3
val FAULT_PROTECTED: i64 = 5

describe "object vm descriptor table lease epochs":
    it "acquires increasing epochs and rejects release of a superseded epoch":
        step("Verify: acquires increasing epochs and rejects release of a superseded epoch")
        # @req: REQ-LIB-GPU-001
        var t = object_vm_table_empty()
        val d = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 10)
        expect(d.ok).to_equal(true)
        t = d.table
        val l1 = object_vm_acquire_lease(t, d.slot, d.generation)
        t = l1.table
        expect(l1.resolve.ok).to_equal(true)
        expect(l1.resolve.lease_epoch).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val l2 = object_vm_acquire_lease(t, d.slot, d.generation)
        t = l2.table
        expect(l2.resolve.ok).to_equal(true)
        expect(l2.resolve.lease_epoch).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val stale_release = object_vm_release_lease(t, d.slot, l1.resolve.lease_epoch)
        expect(stale_release.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(stale_release.resolve.fault)).to_equal(FAULT_STALE_LEASE)
        val live_release = object_vm_release_lease(t, d.slot, l2.resolve.lease_epoch)
        expect(live_release.resolve.ok).to_equal(true)

describe "object vm descriptor table stale handles":
    it "faults StaleGeneration for a wrong-generation handle":
        step("Verify: faults StaleGeneration for a wrong-generation handle")
        var t = object_vm_table_empty()
        val d = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 256, 10)
        t = d.table
        val stale = object_vm_acquire_lease(t, d.slot, d.generation + 1)
        expect(stale.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(stale.resolve.fault)).to_equal(FAULT_STALE_GENERATION)

    it "agrees with the typed-handle staleness helper":
        step("Verify: agrees with the typed-handle staleness helper")
        var t = object_vm_table_empty()
        val d = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 256, 10)
        t = d.table
        val live_ref = object_vm_object_ref(d.slot, d.generation)
        val stale_ref = object_vm_object_ref(d.slot, d.generation + 1)
        expect(object_vm_handles_stale(live_ref, stale_ref)).to_equal(true)
        expect(object_vm_handles_stale(live_ref, live_ref)).to_equal(false)

describe "object vm descriptor table resident views":
    it "rejects a stale view epoch on release and mints a typed view from a live lease":
        step("Verify: rejects a stale view epoch on release and mints a typed view from a live lease")
        var t = object_vm_table_empty()
        val d = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 10)
        t = d.table
        val lease = object_vm_acquire_lease(t, d.slot, d.generation)
        t = lease.table
        val bad = object_vm_release_lease(t, d.slot, lease.resolve.lease_epoch + 1)
        expect(bad.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(bad.resolve.fault)).to_equal(FAULT_STALE_LEASE)
        val view = object_vm_resident_view(lease.resolve)
        val view_slot = view.object_slot as i64
        val view_epoch = view.lease_epoch as i64
        val view_len = view.length as i64
        expect(view_slot).to_equal(d.slot)
        expect(view_epoch).to_equal(lease.resolve.lease_epoch)
        expect(view_len).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        val good = object_vm_release_lease(t, d.slot, lease.resolve.lease_epoch)
        expect(good.resolve.ok).to_equal(true)

describe "object vm descriptor table protection":
    it "blocks retire while pinned or a transfer is in flight":
        step("Verify: blocks retire while pinned or a transfer is in flight")
        var t = object_vm_table_empty()
        val d = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 512, 10)
        t = d.table
        expect(object_vm_is_protected(t, d.slot)).to_equal(false)
        val pin_up = object_vm_pin(t, d.slot, d.generation, 1)
        t = pin_up.table
        expect(pin_up.resolve.ok).to_equal(true)
        expect(object_vm_is_protected(t, d.slot)).to_equal(true)
        val retire_pinned = object_vm_retire(t, d.slot, d.generation)
        expect(retire_pinned.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(retire_pinned.resolve.fault)).to_equal(FAULT_PROTECTED)
        val pin_down = object_vm_pin(t, d.slot, d.generation, -1)
        t = pin_down.table
        expect(pin_down.resolve.ok).to_equal(true)
        val touch_up = object_vm_touch(t, d.slot, d.generation, 1)
        t = touch_up.table
        expect(touch_up.resolve.ok).to_equal(true)
        expect(object_vm_is_protected(t, d.slot)).to_equal(true)
        val retire_in_flight = object_vm_retire(t, d.slot, d.generation)
        expect(retire_in_flight.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(retire_in_flight.resolve.fault)).to_equal(FAULT_PROTECTED)
        val touch_down = object_vm_touch(t, d.slot, d.generation, -1)
        t = touch_down.table
        expect(object_vm_is_protected(t, d.slot)).to_equal(false)
        val retire_free = object_vm_retire(t, d.slot, d.generation)
        expect(retire_free.resolve.ok).to_equal(true)

    it "refuses to drive a pin or transfer count negative":
        step("Verify: refuses to drive a pin or transfer count negative")
        var t = object_vm_table_empty()
        val d = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 64, 10)
        t = d.table
        val bad_pin = object_vm_pin(t, d.slot, d.generation, -1)
        expect(bad_pin.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(bad_pin.resolve.fault)).to_equal(FAULT_PROTECTED)
        val bad_touch = object_vm_touch(t, d.slot, d.generation, -1)
        expect(bad_touch.resolve.ok).to_equal(false)
        expect(object_vm_fault_to_u8(bad_touch.resolve.fault)).to_equal(FAULT_PROTECTED)

describe "object vm descriptor table slot reuse":
    it "reuses a retired slot with an advanced generation":
        step("Verify: reuses a retired slot with an advanced generation")
        var t = object_vm_table_empty()
        val first = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 10)
        t = first.table
        val retired = object_vm_retire(t, first.slot, first.generation)
        expect(retired.resolve.ok).to_equal(true)
        t = retired.table
        val second = object_vm_define(t, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 512, 10)
        expect(second.ok).to_equal(true)
        expect(second.slot).to_equal(first.slot)
        expect(second.generation).to_equal(first.generation + 1)

describe "object vm descriptor table epoch key":
    it "packs slot and lease epoch deterministically":
        step("Verify: packs slot and lease epoch deterministically")
        expect(object_vm_epoch_key(0, 1)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(object_vm_epoch_key(1, 0)).to_equal(4294967296)  # oracle: 4294967296 — named expected value from the requirement
        expect(object_vm_epoch_key(3, 7)).to_equal(12884901895)  # oracle: 12884901895 — named expected value from the requirement
