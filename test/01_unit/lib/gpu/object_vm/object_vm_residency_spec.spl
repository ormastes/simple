"""
## Purpose and audience
Purpose: Prove that object vm empty input.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

# ============================================================================
# PLACE lane — CPU-reference Object VM residency model.
#
# Behaviour claims (no source-text assertions; every claim is an observable
# result of calling the model):
#   1. EMPTY — an empty table with no requests plans successfully, decides
#      nothing, and still reports the frozen schema version.
#   2. HANDLES — define/resolve round-trips through a lease; a retired slot's
#      handle faults StaleGeneration; a released lease faults StaleLease.
#   3. MISS — a request for a non-resident arena is admitted and the decision
#      carries a receipt naming the miss, both tiers and the byte count.
#   4. EVICTION — admitting past the device budget evicts the lowest
#      retain_score arena, moves it to its home tier, and the receipt names the
#      victim, its score and the slot it made room for.
#   5. PROTECTION — pinned and leased arenas are never evicted; when they are
#      the only candidates the request is rejected with a receipt counting each
#      protection class.
#   6. FAIL-CLOSED — a zero device_bytes budget is rejected by name, never
#      treated as unlimited.
# ============================================================================

use std.spec
use std.common.compute.placement_contracts.planner.{PlacementBudget}
use std.common.compute.placement_contracts.schema.{PLACEMENT_SCHEMA_VERSION, PLACEMENT_NO_EPOCH, residency_tier_to_u8, residency_tier_from_u8, residency_tier_valid, residency_tier_name}
use std.common.compute.placement_contracts.residency.{ResidencyTier}
use std.nogc_async_mut.gpu.object_vm.descriptor_table.{
    ObjectVmFault,
    ObjectVmDescriptorTable,
    object_vm_table_empty,
    object_vm_define,
    object_vm_retire,
    object_vm_acquire_lease,
    object_vm_release_lease,
    object_vm_resolve,
    object_vm_set_pinned,
    object_vm_device_bytes,
    object_vm_slot_count
}
use std.nogc_async_mut.gpu.object_vm.residency_model.{
    ObjectVmDecisionKind,
    ObjectVmResidencyRequest,
    ObjectVmPlacementPlan,
    object_vm_residency_request,
    object_vm_plan_residency,
    object_vm_plan_receipt
}

# ----------------------------------------------------------------------------
# Fixtures
# ----------------------------------------------------------------------------

val TIER_DEVICE_LOCAL: i64 = 0
val TIER_HOST_COLD: i64 = 4
val TIER_SSD_CAS: i64 = 5

fn _budget(device_bytes: i64) -> PlacementBudget:
    PlacementBudget(
        device_bytes: device_bytes,
        host_pinned_bytes: 0,
        host_hot_bytes: 0,
        staging_bytes: 0,
        driver_queue_bytes: 0,
        manifest_cache_bytes: 0,
        runtime_base_bytes: 0)

fn _is_fault(f: ObjectVmFault, want: i64) -> bool:
    match f:
        case NoFault: want == 0
        case UnknownSlot: want == 1
        case StaleGeneration: want == 2
        case StaleLease: want == 3
        case NotResident: want == 4
        case Protected: want == 5
        case InvalidTier: want == 6

fn _is_kind(k: ObjectVmDecisionKind, want: i64) -> bool:
    match k:
        case Hit: want == 0
        case Admitted: want == 1
        case Evicted: want == 2
        case Rejected: want == 3

# ----------------------------------------------------------------------------
# 1. Empty input
# ----------------------------------------------------------------------------

describe "object vm empty input":
    it "plans an empty table with no requests successfully":
        step("Verify: plans an empty table with no requests successfully")
        # @req: REQ-LIB-GPU-001
        val plan = object_vm_plan_residency(object_vm_table_empty(), _budget(4096), [])
        expect(plan.ok).to_be(true)
        expect(plan.decisions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.hit_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.admit_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.evict_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.reject_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.device_bytes_used).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.reason).to_equal("")

    it "stamps the frozen schema version on every plan":
        step("Verify: stamps the frozen schema version on every plan")
        val plan = object_vm_plan_residency(object_vm_table_empty(), _budget(4096), [])
        expect(plan.schema_version).to_equal(PLACEMENT_SCHEMA_VERSION)
        expect(PLACEMENT_SCHEMA_VERSION).to_equal("simple-placement-contracts-v1")

    it "reports an empty table as holding no device bytes and no slots":
        step("Verify: reports an empty table as holding no device bytes and no slots")
        expect(object_vm_device_bytes(object_vm_table_empty())).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(object_vm_slot_count(object_vm_table_empty())).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 2. Tier wire encoding
# ----------------------------------------------------------------------------

describe "residency tier wire encoding":
    it "round-trips every declared tier through its wire value":
        step("Verify: round-trips every declared tier through its wire value")
        expect(residency_tier_to_u8(ResidencyTier.DeviceLocal)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(residency_tier_to_u8(ResidencyTier.Recomputable)).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(residency_tier_to_u8(residency_tier_from_u8(5))).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(residency_tier_to_u8(residency_tier_from_u8(2))).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "rejects out-of-range tier values instead of coercing them":
        step("Verify: rejects out-of-range tier values instead of coercing them")
        expect(residency_tier_valid(0)).to_be(true)
        expect(residency_tier_valid(6)).to_be(true)
        expect(residency_tier_valid(7)).to_be(false)
        expect(residency_tier_valid(0 - 1)).to_be(false)

    it "names an invalid tier rather than pretending it is tier zero":
        step("Verify: names an invalid tier rather than pretending it is tier zero")
        expect(residency_tier_name(7)).to_equal("InvalidTier")
        expect(residency_tier_name(0)).to_equal("DeviceLocal")

# ----------------------------------------------------------------------------
# 3. Handles, generations, leases
# ----------------------------------------------------------------------------

describe "object vm handles and leases":
    it "resolves a device-resident arena through a live lease":
        step("Verify: resolves a device-resident arena through a live lease")
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 5)
        expect(d.ok).to_be(true)
        val l = object_vm_acquire_lease(d.table, d.slot, d.generation)
        expect(l.resolve.ok).to_be(true)
        val v = object_vm_resolve(l.table, d.slot, d.generation, l.resolve.lease_epoch)
        expect(v.ok).to_be(true)
        expect(v.length).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(v.device_address > 0).to_be(true)
        expect(v.reason).to_equal("")

    it "faults StaleGeneration on a handle to a retired slot":
        step("Verify: faults StaleGeneration on a handle to a retired slot")
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 512, 1)
        val retired = object_vm_retire(d.table, d.slot, d.generation)
        expect(retired.resolve.ok).to_be(true)
        val v = object_vm_resolve(retired.table, d.slot, d.generation, 1)
        expect(v.ok).to_be(false)
        expect(_is_fault(v.fault, 2)).to_be(true)
        expect(v.reason.contains("object_vm_stale_generation")).to_be(true)

    it "faults StaleLease once the lease has been released":
        step("Verify: faults StaleLease once the lease has been released")
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 512, 1)
        val l = object_vm_acquire_lease(d.table, d.slot, d.generation)
        val released = object_vm_release_lease(l.table, d.slot, l.resolve.lease_epoch)
        expect(released.resolve.ok).to_be(true)
        val v = object_vm_resolve(released.table, d.slot, d.generation, l.resolve.lease_epoch)
        expect(v.ok).to_be(false)
        expect(_is_fault(v.fault, 3)).to_be(true)
        expect(v.reason.contains("object_vm_stale_lease")).to_be(true)

    it "faults UnknownSlot for a slot that was never defined":
        step("Verify: faults UnknownSlot for a slot that was never defined")
        val v = object_vm_resolve(object_vm_table_empty(), 7, 1, 1)
        expect(v.ok).to_be(false)
        expect(_is_fault(v.fault, 1)).to_be(true)
        expect(v.lease_epoch).to_equal(PLACEMENT_NO_EPOCH)
        expect(v.reason.contains("object_vm_unknown_slot")).to_be(true)

    it "refuses to lease an arena that is not on a device tier":
        step("Verify: refuses to lease an arena that is not on a device tier")
        val d = object_vm_define(object_vm_table_empty(), TIER_SSD_CAS, TIER_SSD_CAS, 256, 1)
        val l = object_vm_acquire_lease(d.table, d.slot, d.generation)
        expect(l.resolve.ok).to_be(false)
        expect(_is_fault(l.resolve.fault, 4)).to_be(true)
        expect(l.resolve.reason.contains("object_vm_not_resident")).to_be(true)
        expect(l.resolve.reason.contains("SsdCas")).to_be(true)

    it "refuses to retire an arena while a lease is outstanding":
        step("Verify: refuses to retire an arena while a lease is outstanding")
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 256, 1)
        val l = object_vm_acquire_lease(d.table, d.slot, d.generation)
        val r = object_vm_retire(l.table, d.slot, d.generation)
        expect(r.resolve.ok).to_be(false)
        expect(_is_fault(r.resolve.fault, 5)).to_be(true)
        expect(r.resolve.reason.contains("object_vm_protected")).to_be(true)

    it "rejects a definition with an out-of-range tier":
        step("Verify: rejects a definition with an out-of-range tier")
        val d = object_vm_define(object_vm_table_empty(), 9, TIER_HOST_COLD, 256, 1)
        expect(d.ok).to_be(false)
        expect(d.reason.contains("object_vm_invalid_tier")).to_be(true)

# ----------------------------------------------------------------------------
# 4. Residency miss / admission
# ----------------------------------------------------------------------------

describe "object vm residency miss":
    it "admits a non-resident arena and receipts the miss":
        step("Verify: admits a non-resident arena and receipts the miss")
        val d = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(d.table, _budget(4096), [object_vm_residency_request(d.slot, d.generation, 7)])
        expect(plan.ok).to_be(true)
        expect(plan.admit_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.evict_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.device_bytes_used).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(plan.decisions.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_is_kind(plan.decisions[0].kind, 1)).to_be(true)
        expect(plan.decisions[0].reason.contains("object_vm_residency_miss")).to_be(true)
        expect(plan.decisions[0].reason.contains("HostCold")).to_be(true)
        expect(plan.decisions[0].reason.contains("DeviceLocal")).to_be(true)

    it "reports an already-resident arena as a hit with no receipt":
        step("Verify: reports an already-resident arena as a hit with no receipt")
        val d = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 3)
        val plan = object_vm_plan_residency(d.table, _budget(4096), [object_vm_residency_request(d.slot, d.generation, 1)])
        expect(plan.ok).to_be(true)
        expect(plan.hit_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.admit_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_is_kind(plan.decisions[0].kind, 0)).to_be(true)
        expect(plan.decisions[0].reason).to_equal("")
        expect(object_vm_plan_receipt(plan)).to_equal("")

    it "rejects a stale-generation request without admitting anything":
        step("Verify: rejects a stale-generation request without admitting anything")
        val d = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(d.table, _budget(4096), [object_vm_residency_request(d.slot, d.generation + 5, 1)])
        expect(plan.ok).to_be(false)
        expect(plan.reject_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.admit_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.device_bytes_used).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.decisions[0].reason.contains("object_vm_stale_generation")).to_be(true)

    it "rejects an arena larger than the whole device budget by name":
        step("Verify: rejects an arena larger than the whole device budget by name")
        val d = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 8192, 0)
        val plan = object_vm_plan_residency(d.table, _budget(4096), [object_vm_residency_request(d.slot, d.generation, 1)])
        expect(plan.ok).to_be(false)
        expect(plan.decisions[0].reason.contains("object_vm_object_exceeds_budget")).to_be(true)
        expect(plan.decisions[0].reason.contains("device_bytes_limit=4096")).to_be(true)

# ----------------------------------------------------------------------------
# 5. Eviction
# ----------------------------------------------------------------------------

fn _two_resident_and_one_cold() -> ObjectVmDescriptorTable:
    """slot 0: resident 1024 retain 1 · slot 1: resident 1024 retain 9 ·
    slot 2: HostCold 1024 waiting for admission. Device budget of 2048 forces
    exactly one eviction, and slot 0 is the lower-scoring victim."""
    val a = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 1)
    val b = object_vm_define(a.table, TIER_DEVICE_LOCAL, TIER_HOST_COLD, 1024, 9)
    val c = object_vm_define(b.table, TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
    c.table

describe "object vm eviction":
    it "evicts the lowest retain_score arena to make room":
        step("Verify: evicts the lowest retain_score arena to make room")
        val t = _two_resident_and_one_cold()
        val plan = object_vm_plan_residency(t, _budget(2048), [object_vm_residency_request(2, 1, 5)])
        expect(plan.ok).to_be(true)
        expect(plan.evict_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.admit_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.device_bytes_used).to_equal(2048)  # oracle: 2048 — named expected value from the requirement
        expect(_is_kind(plan.decisions[0].kind, 2)).to_be(true)
        expect(plan.decisions[0].slot).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "receipts the eviction with the victim, its score and the beneficiary":
        step("Verify: receipts the eviction with the victim, its score and the beneficiary")
        val t = _two_resident_and_one_cold()
        val plan = object_vm_plan_residency(t, _budget(2048), [object_vm_residency_request(2, 1, 5)])
        val receipt = plan.decisions[0].reason
        expect(receipt.contains("object_vm_evicted")).to_be(true)
        expect(receipt.contains("slot=0")).to_be(true)
        expect(receipt.contains("retain_score=1")).to_be(true)
        expect(receipt.contains("HostCold")).to_be(true)
        expect(receipt.contains("need=1024")).to_be(true)

    it "moves the evicted arena to its home tier and drops its device address":
        step("Verify: moves the evicted arena to its home tier and drops its device address")
        val t = _two_resident_and_one_cold()
        val plan = object_vm_plan_residency(t, _budget(2048), [object_vm_residency_request(2, 1, 5)])
        expect(plan.table.tier[0]).to_equal(TIER_HOST_COLD)
        expect(plan.table.device_address[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.table.tier[2]).to_equal(TIER_DEVICE_LOCAL)
        expect(plan.table.device_address[2] > 0).to_be(true)

    it "never evicts an arena that a request in the same plan just touched":
        step("Verify: never evicts an arena that a request in the same plan just touched")
        val t = _two_resident_and_one_cold()
        val plan = object_vm_plan_residency(t, _budget(2048), [
            object_vm_residency_request(0, 1, 5),
            object_vm_residency_request(2, 1, 5)])
        expect(plan.hit_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.decisions[1].slot).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_is_kind(plan.decisions[1].kind, 2)).to_be(true)

# ----------------------------------------------------------------------------
# 6. Protection and fail-closed bounds
# ----------------------------------------------------------------------------

describe "object vm protection":
    it "never evicts a pinned arena and counts it in the rejection receipt":
        step("Verify: never evicts a pinned arena and counts it in the rejection receipt")
        val a = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 2048, 0)
        val pinned = object_vm_set_pinned(a.table, a.slot, true)
        val c = object_vm_define(pinned.table, TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(c.table, _budget(2048), [object_vm_residency_request(c.slot, c.generation, 5)])
        expect(plan.ok).to_be(false)
        expect(plan.evict_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.reject_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.table.tier[a.slot]).to_equal(TIER_DEVICE_LOCAL)
        expect(plan.decisions[0].reason.contains("object_vm_device_budget_exhausted")).to_be(true)
        expect(plan.decisions[0].reason.contains("blocked_pinned=1")).to_be(true)

    it "never evicts an arena with a live lease":
        step("Verify: never evicts an arena with a live lease")
        val a = object_vm_define(object_vm_table_empty(), TIER_DEVICE_LOCAL, TIER_HOST_COLD, 2048, 0)
        val l = object_vm_acquire_lease(a.table, a.slot, a.generation)
        val c = object_vm_define(l.table, TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(c.table, _budget(2048), [object_vm_residency_request(c.slot, c.generation, 5)])
        expect(plan.ok).to_be(false)
        expect(plan.evict_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.decisions[0].reason.contains("blocked_leased=1")).to_be(true)

    it "fails closed on an unset device budget and names the field":
        step("Verify: fails closed on an unset device budget and names the field")
        val d = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(d.table, _budget(0), [object_vm_residency_request(d.slot, d.generation, 1)])
        expect(plan.ok).to_be(false)
        expect(plan.decisions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.reason.contains("object_vm_budget_unset")).to_be(true)
        expect(plan.reason.contains("PlacementBudget.device_bytes")).to_be(true)
        expect(object_vm_plan_receipt(plan)).to_equal(plan.reason)

    it "does not treat a zero budget as unlimited":
        step("Verify: does not treat a zero budget as unlimited")
        val d = object_vm_define(object_vm_table_empty(), TIER_HOST_COLD, TIER_HOST_COLD, 1024, 0)
        val plan = object_vm_plan_residency(d.table, _budget(0), [object_vm_residency_request(d.slot, d.generation, 1)])
        expect(plan.admit_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.table.tier[d.slot]).to_equal(TIER_HOST_COLD)
