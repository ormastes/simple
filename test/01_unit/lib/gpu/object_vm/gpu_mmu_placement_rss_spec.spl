# @tag: gpu, object-vm, placement
# @cover src/lib/nogc_async_mut/gpu/placement_backends/planner.spl 80%

use std.spec.*
use common.compute.placement_contracts.planner.{PlacementBudget}
use std.gpu.placement_backends.planner.{placement_host_rss_limit, placement_modeled_peak_host_rss}

describe "GPU MMU fixed host RSS budget":
    it "does not grow when the corpus grows tenfold":
        val budget = PlacementBudget(device_bytes: 1024, host_pinned_bytes: 128, host_hot_bytes: 256, staging_bytes: 128, driver_queue_bytes: 32, manifest_cache_bytes: 16, runtime_base_bytes: 64)
        val one_x = placement_modeled_peak_host_rss(budget, 1000)
        val ten_x = placement_modeled_peak_host_rss(budget, 10000)
        expect(one_x).to_equal(240)
        expect(ten_x).to_equal(one_x)
        expect(ten_x).to_equal(placement_host_rss_limit(budget))
