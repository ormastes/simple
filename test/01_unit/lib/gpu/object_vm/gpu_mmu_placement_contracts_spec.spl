# @tag: gpu, object-vm, placement
# @cover src/lib/common/compute/placement_contracts 80%

use std.spec.*
use common.compute.placement_contracts.handles.{object_ref, entity_ref, ArenaResidency, ResidentView}
use common.compute.placement_contracts.semantic.{AnyObject}
use common.compute.placement_contracts.storage.{artifact_id, artifact_id_valid, hash128}

describe "GPU MMU placement owner contracts":
    it "keeps entity identity below one arena descriptor":
        val object = object_ref<AnyObject>(3u32, 11u32)
        val entity = entity_ref(3u32, 99u32)
        val view: ResidentView<i64> = ResidentView(device_address: 4096u64, length: 64u64, object_slot: 3u32, lease_epoch: 4u32)
        val arena = ArenaResidency(object: object, entity_count: 100u64, byte_len: 64u64)
        expect(entity.object_slot).to_equal(3u32)
        expect(entity.local_index).to_equal(99u32)
        expect(view.lease_epoch).to_equal(4u32)
        expect(arena.object.generation).to_equal(11u32)

    it "rejects malformed content identities":
        expect(artifact_id_valid(artifact_id(hash128(0u64, 0u64), 0u32))).to_be(false)
        expect(artifact_id_valid(artifact_id(hash128(1u64, 2u64), 4u32))).to_be(true)
