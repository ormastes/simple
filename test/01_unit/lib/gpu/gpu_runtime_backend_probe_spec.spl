"""
# std.gpu_runtime backend detection uses the CUDA driver probe

Reproduce for Gap D (2026-08-25): gpu_available / gpu_backend_name /
gpu_device_count in src/lib/nogc_sync_mut/gpu_runtime/mod.spl gated on
rt_torch_cuda_available, so a host with two real GPUs and no PyTorch runtime
reported "CPU" and 0 devices while std.cuda counted 2.
"""

use std.spec
use std.fs.{read_file}
use std.nogc_sync_mut.gpu_runtime.mod.{gpu_available, gpu_backend_name, gpu_device_count}
use std.nogc_sync_mut.cuda.mod.{cuda_available, cuda_device_count}
use std.common.test_env_gate.{test_env_cuda_available, test_env_gate_skip}

val OWNER = "src/lib/nogc_sync_mut/gpu_runtime/mod.spl"

fn body_of(source: text, fn_name: text) -> text:
    val start = source.index_of("fn " + fn_name + "(")
    expect(start >= 0).to_equal(true)
    val rest = source.substring(start, source.len())
    val next_fn = rest.substring(1, rest.len()).index_of("\nfn ")
    if next_fn < 0:
        rest
    else:
        rest.substring(0, next_fn + 1)

describe "std.gpu_runtime backend detection (device-free)":
    it "does not gate device detection on the torch runtime":
        val source = read_file(OWNER)
        for name in ["gpu_available", "gpu_backend_name", "gpu_device_count"]:
            expect(body_of(source, name).contains("rt_torch_cuda_available")).to_equal(false)

    it "agrees with the std.cuda driver probe":
        expect(gpu_available()).to_equal(cuda_available())
        expect(gpu_device_count() as i64).to_equal(cuda_device_count())
        if cuda_available():
            expect(gpu_backend_name()).to_equal("CUDA")
        else:
            expect(gpu_backend_name()).to_equal("CPU")

describe "std.gpu_runtime backend detection on hardware":
    if not test_env_cuda_available():
        it "env_skip: CUDA not available":
            val reason = test_env_gate_skip("SIMPLE_CUDA_TEST")
            expect(reason).to_contain("Skipped")
        return

    it "counts the real devices":
        expect(gpu_available()).to_equal(true)
        expect(gpu_backend_name()).to_equal("CUDA")
        expect(gpu_device_count() as i64).to_be_greater_than(0)
