"""
## Purpose and audience
Purpose: Prove that device_live_bytes / device_peak_bytes.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

# GPU device-memory-counter / HIP-parity-surface / host-diffable-report tests
# (M7 remainder — memory infra GPU lane, 2026-07-29/30).
#
# Covers the additions to std.nogc_sync_mut.gpu_profile.mem_profile beyond
# the original compute-sanitizer wrapper + memory_viz trace serializer
# (those stay covered by test/01_unit/lib/gpu/mem_profile_spec.spl, 5/5):
#   1. device_live_bytes()/device_peak_bytes() — Simple-side wrappers over
#      the allocator-agnostic rt_gpu_mem_live_bytes/rt_gpu_mem_peak_bytes
#      externs (kind-level DEVICE_LIVE_BYTES/DEVICE_PEAK_BYTES atomics at
#      the rt_cuda_mem_alloc_fn/rt_cuda_mem_free_fn choke points).
#   2. device_mem_report_tsv(backend) — host-diffable TSV snapshot, same
#      line-tag vocabulary as src/lib/nogc_sync_mut/mem/dump.spl.
#   3. run_under_gpu_sanitizer(backend, tool, cmd) — backend-dispatching
#      wrapper over run_under_compute_sanitizer, with a clear non-cuda path.
#
# No GPU required anywhere in this file. This box has no GPU, so every
# assertion here is either a counter-arithmetic invariant true with or
# without a device, or an exact string/shape check on a code path this
# module can force deterministically (unset PATH, non-"cuda" backend tag).
#
# Assertions that would ONLY be meaningful on a real GPU host (NOT covered
# here, called out explicitly so nobody mistakes silence for coverage):
#   - device_live_bytes() actually increasing after a real rt_cuda_mem_alloc_fn
#     call, and decreasing back after the matching free (needs SIMPLE_MEM_ATTR=1
#     AND a CUDA driver AND a physical GPU — this module has no Simple-callable
#     entry point that reaches cuMemAlloc_v2 directly, only the counter readers).
#   - device_peak_bytes() surviving a real seeded-leak against a live device.
#   - run_under_gpu_sanitizer("cuda", ...) actually invoking a present
#     compute-sanitizer binary and parsing real memcheck output.

use std.spec.*
use std.nogc_sync_mut.gpu_profile.mem_profile.{
    device_live_bytes,
    device_peak_bytes,
    device_mem_report_tsv,
    run_under_gpu_sanitizer
}

extern fn rt_env_get(key: text) -> text
extern fn rt_env_set(key: text, value: text) -> bool

use std.spec.step

describe "device_live_bytes / device_peak_bytes":

    it "returns non-negative counters with peak never below live (arithmetic invariant, GPU-less-safe)":
        step("Verify: returns non-negative counters with peak never below live (arithmetic invariant, GPU-less-safe)")
        # @req: REQ-LIB-GPU-001
        # On a GPU-less host, or with SIMPLE_MEM_ATTR unset (the default),
        # the Rust-side choke points that would move these atomics are
        # no-ops, so both counters read whatever they were left at (0 on a
        # fresh process). We assert the invariant the choke points promise
        # rather than an exact value, so this test is not coupled to
        # process/test-run history.
        val live = device_live_bytes()
        val peak = device_peak_bytes()

        expect(live).to_be_greater_than(-1)
        expect(peak).to_be_greater_than(-1)
        assert_true(peak >= live, "peak must never be below live")

    it "is stable across repeated reads with no allocation activity between them":
        step("Verify: is stable across repeated reads with no allocation activity between them")
        val live1 = device_live_bytes()
        val live2 = device_live_bytes()
        val peak1 = device_peak_bytes()
        val peak2 = device_peak_bytes()

        expect(live1).to_equal(live2)
        expect(peak1).to_equal(peak2)

describe "device_mem_report_tsv":

    it "emits a versioned header line distinct from the host-side schema tag":
        step("Verify: emits a versioned header line distinct from the host-side schema tag")
        val tsv = device_mem_report_tsv("cuda")

        expect(tsv).to_contain("simple-gpu-mem-snapshot\tv1\t")
        # Must NOT collide with dump.spl's own schema tag, so a reader can
        # tell host and device snapshots apart at a glance.
        assert_false(tsv.contains("simple-mem-snapshot\tv1\t"),
            "device schema tag must not collide with the host schema tag")

    it "emits exactly one OWNER row shaped like dump.spl's OWNER rows, tagged with the backend":
        step("Verify: emits exactly one OWNER row shaped like dump.spl's OWNER rows, tagged with the backend")
        val tsv = device_mem_report_tsv("cuda")

        expect(tsv).to_contain("OWNER\tgpu:cuda\t")
        # allocs sentinel: per-allocation count is not tracked at this
        # choke point today (only live/peak bytes are) — must be -1.
        expect(tsv).to_end_with("\t-1\n")

        var owner_rows = 0
        for line in tsv.split("\n"):
            if line.len() > 0 and line.slice(0, 6) == "OWNER\t":
                owner_rows = owner_rows + 1
        expect(owner_rows).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "carries the caller-supplied backend tag verbatim, not hardcoded to cuda":
        step("Verify: carries the caller-supplied backend tag verbatim, not hardcoded to cuda")
        val tsv_cuda = device_mem_report_tsv("cuda")
        val tsv_hip = device_mem_report_tsv("hip")

        expect(tsv_cuda).to_contain("gpu:cuda")
        expect(tsv_hip).to_contain("gpu:hip")
        assert_false(tsv_hip.contains("gpu:cuda"),
            "a hip-tagged report must not also claim to be a cuda report")

    it "OWNER row's live/peak fields match device_live_bytes()/device_peak_bytes()":
        step("Verify: OWNER row's live/peak fields match device_live_bytes()/device_peak_bytes()")
        val live = device_live_bytes()
        val peak = device_peak_bytes()
        val tsv = device_mem_report_tsv("cuda")

        val expected_row = "OWNER\tgpu:cuda\t{live}\t{peak}\t-1"
        assert_true(tsv.contains(expected_row),
            "expected row `" + expected_row + "` in:\n" + tsv)

describe "run_under_gpu_sanitizer":

    it "dispatches backend=\"cuda\" to the same 127 path as run_under_compute_sanitizer when the tool is absent":
        val saved_path = rt_env_get("PATH")
        rt_env_set("PATH", "/nonexistent_dir_for_gpu_sanitize_dispatch_test")

        val (out, err, code) = run_under_gpu_sanitizer("cuda", "memcheck", ["echo", "hi"])

        rt_env_set("PATH", saved_path)

        expect(code).to_equal(127)  # oracle: 127 — named expected value from the requirement
        expect(err).to_equal("compute-sanitizer not found")
        expect(out).to_equal("")

    it "returns a clear, deterministic unsupported-backend result for \"hip\", without touching PATH or a subprocess":
        val (out, err, code) = run_under_gpu_sanitizer("hip", "memcheck", ["echo", "hi"])

        expect(code).to_equal(127)  # oracle: 127 — named expected value from the requirement
        expect(err).to_equal("no sanitizer wrapper for backend 'hip'")
        expect(out).to_equal("")

    it "returns the same clear result for an unknown/typo'd backend tag":
        step("Verify: returns the same clear result for an unknown/typo'd backend tag")
        val (out, err, code) = run_under_gpu_sanitizer("opencl", "memcheck", ["echo", "hi"])

        expect(code).to_equal(127)  # oracle: 127 — named expected value from the requirement
        expect(err).to_equal("no sanitizer wrapper for backend 'opencl'")
        expect(out).to_equal("")
