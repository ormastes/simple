# @cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl
# @req REQ-ENGINE2D-VULKAN-RECT-COLOR
"""
# VulkanBackend draw_rect_filled color, alpha, extent, and fallback parity

Verifies that `VulkanBackend.draw_rect_filled` matches `SoftwareBackend`
pixel-for-pixel across opaque colors, semi-transparent blending, zero-alpha
no-ops, negative/zero bounds, and CPU-fallback rendering.
"""

use std.spec.{describe, it, expect, step}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend}
use std.gc_async_mut.gpu.engine2d.backend_software.{SoftwareBackend}

fn _count_diffs(a: [u32], b: [u32]) -> i64:
    if a.len() != b.len():
        return -1
    var diffs: i64 = 0
    var i: i64 = 0
    while i < a.len().to_i64():
        if a[i] != b[i]:
            diffs = diffs + 1
        i = i + 1
    diffs

describe "VulkanBackend draw_rect_filled parity":

    it "matches SoftwareBackend on opaque and translucent ARGB color packing":
        step("Render identical opaque and blended rects on SoftwareBackend and VulkanBackend")
        var sw = SoftwareBackend.create()
        val sw_ok = sw.init(8, 8)
        expect(sw_ok).to_equal(true)
        sw.clear(0xFF112233u32)
        sw.draw_rect_filled(1, 1, 4, 4, 0xFFAA5511u32)
        sw.draw_rect_filled(3, 3, 4, 4, 0x8000FF00u32)
        val expected = sw.read_pixels()

        var vk = VulkanBackend.create()
        val vk_ok = if vk.init(8, 8): true else: vk.init_cpu_fallback_surface(8, 8, "no-vulkan-device")
        expect(vk_ok).to_equal(true)
        vk.clear(0xFF112233u32)
        vk.draw_rect_filled(1, 1, 4, 4, 0xFFAA5511u32)
        vk.draw_rect_filled(3, 3, 4, 4, 0x8000FF00u32)
        val actual = vk.read_pixels()

        expect(_count_diffs(actual, expected)).to_equal(0)
        vk.shutdown()
        sw.shutdown()

    it "treats zero-alpha and negative-both-axes rects as no-ops without fallback":
        step("Draw alpha=0 rect and (-2, -2) translucent rect")
        var sw = SoftwareBackend.create()
        sw.init(6, 6)
        sw.clear(0xFF223344u32)
        sw.draw_rect_filled(1, 1, 3, 3, 0x00FF8800u32)
        sw.draw_rect_filled(1, 1, -2, -2, 0x80FF0000u32)
        val expected = sw.read_pixels()

        var vk = VulkanBackend.create()
        val has_hw = vk.init(6, 6)
        val vk_ok = if has_hw: true else: vk.init_cpu_fallback_surface(6, 6, "no-vulkan-device")
        expect(vk_ok).to_equal(true)
        vk.clear(0xFF223344u32)
        vk.draw_rect_filled(1, 1, 3, 3, 0x00FF8800u32)
        vk.draw_rect_filled(1, 1, -2, -2, 0x80FF0000u32)
        val actual = vk.read_pixels()

        expect(_count_diffs(actual, expected)).to_equal(0)
        if has_hw:
            expect(vk.cpu_fallback_used).to_equal(false)
        else:
            expect(vk.cpu_fallback_reason).to_equal("no-vulkan-device")
        vk.shutdown()
        sw.shutdown()

    it "updates fallback CPU framebuffer cleanly across clip, negative origin, and rect lists":
        step("Verify clear, clipped rect, negative-origin rect, and rect list on fallback framebuffer")
        var sw = SoftwareBackend.create()
        sw.init(6, 6)
        sw.clear(0xFF102030u32)
        sw.set_clip(1, 1, 4, 4)
        sw.draw_rect_filled(-1, 0, 4, 3, 0xFFCC4488u32)
        sw.clear_clip()
        sw.draw_rect_filled(3, 3, 2, 2, 0xFF00AAFFu32)
        sw.draw_rect_filled(0, 4, 2, 2, 0x80FFFFFFu32)
        val expected = sw.read_pixels()

        var vk = VulkanBackend.create()
        expect(vk.init_cpu_fallback_surface(6, 6, "unit-forced-fallback")).to_equal(true)
        vk.clear(0xFF102030u32)
        vk.set_clip(1, 1, 4, 4)
        vk.draw_rect_filled(-1, 0, 4, 3, 0xFFCC4488u32)
        vk.clear_clip()
        vk.draw_rect_list_filled([3, 3, 2, 2, 0, 4, 2, 2], [0xFF00AAFFu32, 0x80FFFFFFu32])
        val actual = vk.read_pixels()

        expect(_count_diffs(actual, expected)).to_equal(0)
        expect(vk.cpu_fallback_used).to_equal(true)
        vk.shutdown()
        sw.shutdown()

    it "matches SoftwareBackend on asymmetric stencil mask and prevents narrow-mask row wrap":
        step("Verify full-surface asymmetric stencil mask matches SoftwareBackend and narrow 2x2 mask does not wrap rows")
        val mask_6x6: [u8] = [
            0u8, 1u8, 1u8, 0u8, 1u8, 0u8,
            1u8, 0u8, 1u8, 1u8, 0u8, 1u8,
            0u8, 1u8, 0u8, 1u8, 1u8, 0u8,
            1u8, 1u8, 0u8, 0u8, 1u8, 1u8,
            0u8, 0u8, 1u8, 1u8, 0u8, 1u8,
            1u8, 0u8, 1u8, 0u8, 1u8, 0u8
        ]
        var sw = SoftwareBackend.create()
        sw.init(6, 6)
        sw.clear(0xFF101010u32)
        sw.set_mask(mask_6x6, 6, 6)
        sw.draw_rect_filled(0, 0, 6, 6, 0xFF33CC99u32)
        val expected = sw.read_pixels()

        var vk = VulkanBackend.create()
        expect(vk.init_cpu_fallback_surface(6, 6, "mask-parity-fallback")).to_equal(true)
        vk.clear(0xFF101010u32)
        vk.set_mask(mask_6x6, 6, 6)
        vk.draw_rect_filled(0, 0, 6, 6, 0xFF33CC99u32)
        val actual = vk.read_pixels()
        expect(_count_diffs(actual, expected)).to_equal(0)

        val mask_2x2: [u8] = [0u8, 1u8, 1u8, 0u8]
        vk.clear(0xFF101010u32)
        vk.set_mask(mask_2x2, 2, 2)
        vk.draw_rect_filled(0, 0, 5, 4, 0xFFAA4422u32)
        val narrow = vk.read_pixels()
        expect(narrow[0]).to_equal(0xFF101010u32)
        expect(narrow[1]).to_equal(0xFFAA4422u32)
        expect(narrow[3]).to_equal(0xFFAA4422u32)
        expect(narrow[6]).to_equal(0xFFAA4422u32)
        expect(narrow[7]).to_equal(0xFF101010u32)
        vk.shutdown()
        sw.shutdown()
