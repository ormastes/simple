"""ROCm/HIP SFFI Dispatch Specification

@tag: gpu, engine2d, rocm, hip, amd, sffi
Exercises host-stable construction and fail-closed paths. HIP device, memory,
module, synchronization, and real kernel operations remain unavailable without
an AMD GPU/runtime and are deliberately not counted as passing tests. No
measured coverage percentage is claimed.
"""
use std.spec.step

use std.spec.step

use std.spec.{describe, it, expect}
use std.gpu.engine2d.sffi_dispatch.{GpuFfiMode}
use std.gpu.engine2d.sffi_rocm.{RocmFfi}

describe "RocmFfi host-stable contract":
    it "AC-8: constructs static dispatch without claiming runtime availability":
        val ffi = RocmFfi.create_static()
        expect(ffi.mode()).to_equal(GpuFfiMode.Static)

    it "AC-3: rejects an explicitly missing HIP loader":
        val ffi = RocmFfi.create_dynamic_from("/definitely/missing/libamdhip64.so")
        expect(ffi).to_be_nil()

    it "fails closed instead of dispatching a zero HIP kernel handle":
        val ffi = RocmFfi.create_static()
        expect(ffi.launch_kernel("kernel_clear", 1, 1, 1, 1, 1, 1, 0)).to_equal(false)

    it "rejects the legacy uncounted packed-argument pointer":
        val ffi = RocmFfi.create_static()
        expect(ffi.launch_kernel_args(7, 1, 1, 1, 1, 1, 1, 0, 4096)).to_equal(false)

    it "AC-8: exposes stable dispatch-mode names":
        expect(GpuFfiMode.Static.to_text()).to_equal("Static")
        expect(GpuFfiMode.Dynamic.to_text()).to_equal("Dynamic")

# UNAVAILABLE ON THIS HOST: hipInit, device enumeration, memory operations,
# module loading, synchronization, and real kernel dispatch require an AMD
# runtime/device.
