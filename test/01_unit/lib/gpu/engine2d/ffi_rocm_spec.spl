"""ROCm/HIP SFFI Dispatch Specification

@tag: gpu, engine2d, rocm, hip, amd, sffi
Exercises host-stable construction and fail-closed paths. HIP device, memory,
module, synchronization, and real kernel operations remain unavailable without
an AMD GPU/runtime and are deliberately not counted as passing tests. No
measured coverage percentage is claimed.
"""
use std.spec.step

use std.spec.step

use std.spec.{describe, it, expect}
use std.gpu.engine2d.sffi_dispatch.{GpuFfiMode}
use std.gpu.engine2d.sffi_rocm.{RocmFfi}
use std.spec.{describe, context, it, expect}
use std.common.test_env_gate.{test_env_require, test_env_gpu_available}

describe "RocmFfi host-stable contract":
    it "AC-8: constructs static dispatch without claiming runtime availability":
        val ffi = RocmFfi.create_static()
        expect(ffi.mode()).to_equal(GpuFfiMode.Static)

    it "AC-3: rejects an explicitly missing HIP loader":
        val ffi = RocmFfi.create_dynamic_from("/definitely/missing/libamdhip64.so")
        expect(ffi).to_be_nil()

    it "fails closed instead of dispatching a zero HIP kernel handle":
        val ffi = RocmFfi.create_static()
        expect(ffi.launch_kernel("kernel_clear", 1, 1, 1, 1, 1, 1, 0)).to_equal(false)

    it "rejects the legacy uncounted packed-argument pointer":
        val ffi = RocmFfi.create_static()
        expect(ffi.launch_kernel_args(7, 1, 1, 1, 1, 1, 1, 0, 4096)).to_equal(false)

    it "AC-8: exposes stable dispatch-mode names":
        expect(GpuFfiMode.Static.to_text()).to_equal("Static")
        expect(GpuFfiMode.Dynamic.to_text()).to_equal("Dynamic")

# UNAVAILABLE ON THIS HOST: hipInit, device enumeration, memory operations,
# module loading, synchronization, and real kernel dispatch require an AMD
# runtime/device.

describe "RocmFfi":
    describe "create_dynamic":

        it "AC-3: attempts to load libamdhip64.so":
            # @req REQ-SSPEC-UNIT
            step("AC-3: attempts to load libamdhip64.so")
            expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

        it "AC-8: returns nil when HIP runtime not installed":
            # @req REQ-SSPEC-UNIT
            step("AC-8: returns nil when HIP runtime not installed")
            expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

describe "RocmFfi":
    describe "create_static":

        it "AC-8: static mode available when runtime is built":
            # @req REQ-SSPEC-UNIT
            step("AC-8: static mode available when runtime is built")
            expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    describe "HIP device management":

    it "AC-3: hipInit returns success code":
        # @req REQ-SSPEC-UNIT
        step("AC-3: hipInit returns success code")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    it "AC-3: device_count via hipGetDeviceCount":
        # @req REQ-SSPEC-UNIT
        step("AC-3: device_count via hipGetDeviceCount")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    describe "HIP memory operations":

    it "AC-3: hipMalloc returns device pointer":
        # @req REQ-SSPEC-UNIT
        step("AC-3: hipMalloc returns device pointer")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    describe "HIP kernel launch":

    it "AC-3: hipLaunchKernel dispatches compute kernel":
        # @req REQ-SSPEC-UNIT
        step("AC-3: hipLaunchKernel dispatches compute kernel")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    it "fails closed when the dynamic HIP runtime cannot be loaded":
        # @req REQ-SSPEC-UNIT
        step("fails closed when the dynamic HIP runtime cannot be loaded")
        val ffi = RocmFfi.create_dynamic_from("/definitely/missing/libamdhip64.so")
        expect(ffi).to_be_nil()

    describe "platform support":

    it "AC-7: ROCm primary on Linux":
        # @req REQ-SSPEC-UNIT
        step("AC-7: ROCm primary on Linux")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    it "AC-7: ROCm partial on Windows":
        # @req REQ-SSPEC-UNIT
        step("AC-7: ROCm partial on Windows")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

    it "AC-3: ROCm dynamic-only (no Rust runtime)":
        # @req REQ-SSPEC-UNIT
        step("AC-3: ROCm dynamic-only (no Rust runtime)")
        expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")
