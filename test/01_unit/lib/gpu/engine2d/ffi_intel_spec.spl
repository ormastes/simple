"""Intel oneAPI Level Zero SFFI Dispatch Specification

@tag: gpu, engine2d, intel, oneapi, level_zero, sffi
Exercises host-stable construction and fail-closed loading. Level Zero device,
memory, command-list, and kernel operations remain unavailable without an Intel
GPU/runtime and are deliberately not counted as passing tests. No measured
coverage percentage is claimed.

History (2026-09-19, gated_specs_are_tautology_shells_2026-08-09): the AC-4
example used to be the single line
`expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")`
— an assertion of nothing but its own gate being shut. It now exercises the
real fail-closed loader path: `IntelFfi.create_dynamic_from` against a path
that cannot exist must return nil (same accepted pattern as the ROCm sibling
spec). The device-backed half of AC-4 (zeInit, driver/device enumeration,
command lists, memory, kernels) still requires a Level Zero runtime and stays
unrepresented rather than asserted via a gate tautology.
"""
use std.spec.step

use std.spec.{describe, it, expect}
use std.gpu.engine2d.sffi_dispatch.{GpuFfiMode}
use std.gpu.engine2d.sffi_intel.{IntelFfi}


describe "IntelFfi host-stable contract":
    it "AC-8: constructs static dispatch without claiming runtime availability":
        val ffi = IntelFfi.create_static()
        expect(ffi.mode()).to_equal(GpuFfiMode.Static)

describe "IntelDynFfi":
    describe "create_dynamic":
        it "AC-4: rejects an explicitly missing Level Zero loader":
            # @req REQ-SSPEC-UNIT
            step("AC-4: attempts to load libze_loader.so and must fail closed")
            val ffi = IntelFfi.create_dynamic_from("/definitely/missing/libze_loader.so")
            expect(ffi).to_be_nil()

# UNAVAILABLE ON THIS HOST: zeInit, driver/device enumeration, command-list
# creation, memory allocation, and kernel launch require real Level Zero
# runtime/device evidence.
