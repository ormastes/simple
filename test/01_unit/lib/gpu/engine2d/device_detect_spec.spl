"""GPU Device Value Contract Specification

@tag: gpu, device, detection, backend
Exercises the host-stable common GPU value constructors. Runtime device
enumeration is unavailable as deterministic unit evidence on this host and is
deliberately not represented by a passing gate assertion. No measured coverage
percentage is claimed.
"""
use std.spec.step

use std.spec.step

use std.spec.{describe, it, expect}
use std.common.gpu.device.{
    GpuBackend,
    gpu_cuda,
    gpu_vulkan,
    gpu_rocm,
    gpu_oneapi,
    gpu_metal,
    gpu_none
}
use std.spec.{describe, context, it, expect}
use std.common.test_env_gate.{test_env_require, test_env_gpu_available}

describe "Gpu common device values":
    it "constructs a CUDA device with its caller-selected id":
        val gpu = gpu_cuda(7)
        expect(gpu.backend).to_equal(GpuBackend.Cuda)
        expect(gpu.device_id).to_equal(7)

    it "constructs a Vulkan device with its caller-selected id":
        val gpu = gpu_vulkan(3)
        expect(gpu.backend).to_equal(GpuBackend.Vulkan)
        expect(gpu.device_id).to_equal(3)

    it "constructs ROCm, oneAPI, and Metal device values":
        val rocm = gpu_rocm(1)
        val oneapi = gpu_oneapi(2)
        val metal = gpu_metal(4)

        expect(rocm.backend).to_equal(GpuBackend.Rocm)
        expect(rocm.device_id).to_equal(1)
        expect(oneapi.backend).to_equal(GpuBackend.Oneapi)
        expect(oneapi.device_id).to_equal(2)
        expect(metal.backend).to_equal(GpuBackend.Metal)
        expect(metal.device_id).to_equal(4)

    it "constructs the explicit CPU fallback sentinel":
        val gpu = gpu_none()
        expect(gpu.backend).to_equal(GpuBackend.None_)
        expect(gpu.device_id).to_equal(-1)

# UNAVAILABLE ON THIS HOST: actual CUDA/Vulkan/ROCm/oneAPI/Metal enumeration
# depends on installed devices and drivers; it is integration evidence, not a
# deterministic constructor unit test.

