"""
## Purpose and audience
Purpose: Prove that SimdLevel.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

"""SIMD Kernels Specification

@tag: gpu, engine2d, simd, cpu, acceleration
@cover src/lib/gc_async_mut/gpu/engine2d/simd_kernels.spl 80%

Verifies SIMD-accelerated pixel operations with runtime CPU feature
detection. Covers AC-6: CPU acceleration via SSE4.2/AVX2/NEON.
"""

use std.spec.{describe, context, it, expect}
use std.io_runtime.{file_read}
use std.gpu.engine2d.simd_kernels.{SimdLevel, detect_simd_level, cpu_simd_runtime_evidence, cpu_simd_required_evidence_valid, CpuSimdRuntimeEvidence, simd_fill_row, engine2d_simd_fill_buffer_u32, engine2d_simd_fill_rows_u32, rt_engine2d_simd_fill_span_u32, rt_engine2d_simd_copy_span_u32, engine2d_simd_blend_row_u32, engine2d_simd_blend_span_u32, engine2d_simd_blend_const_span_u32, simd_blend_row, simd_blit_row, _scalar_blend_row, engine2d_simd_has_sse, engine2d_simd_has_avx2, engine2d_simd_has_neon, engine2d_simd_has_rvv, active_arch_text, active_feature_text, simd_config_mode, blit_rect, _scalar_blit_rect, scroll_region, _scalar_scroll_region}
use std.env.variables.{env_set, env_unset}

# ============================================================================
# SimdLevel detection
# ============================================================================

use std.spec.step

describe "SimdLevel":
    it "AC-6: has None variant for scalar fallback":
        step("Verify: AC-6: has None variant for scalar fallback")
        # @req: REQ-LIB-GPU-001
        val level = SimdLevel.None_
        expect(level.to_text()).to_equal("None")

    it "AC-6: has Sse42 variant":
        step("Verify: AC-6: has Sse42 variant")
        val level = SimdLevel.Sse42
        expect(level.to_text()).to_equal("SSE4.2")

    it "AC-6: has Avx2 variant":
        step("Verify: AC-6: has Avx2 variant")
        val level = SimdLevel.Avx2
        expect(level.to_text()).to_equal("AVX2")

    it "AC-6: has Avx512 variant":
        step("Verify: AC-6: has Avx512 variant")
        val level = SimdLevel.Avx512
        expect(level.to_text()).to_equal("AVX-512")

    it "AC-6: has Neon variant":
        step("Verify: AC-6: has Neon variant")
        val level = SimdLevel.Neon
        expect(level.to_text()).to_equal("NEON")

# ============================================================================
# CPU feature detection
# ============================================================================

describe "detect_simd_level":
    it "AC-6: returns a valid SimdLevel on any platform":
        step("Verify: AC-6: returns a valid SimdLevel on any platform")
        val level = detect_simd_level()
        val name = level.to_text()
        val valid = name == "None" or name == "SSE4.2" or name == "AVX2" or name == "AVX-512" or name == "NEON"
        expect(valid).to_equal(true)

    it "AC-6: detection is consistent across calls":
        step("Verify: AC-6: detection is consistent across calls")
        val level1 = detect_simd_level()
        val level2 = detect_simd_level()
        expect(level1.to_text()).to_equal(level2.to_text())

    it "AC-6: records runtime execution evidence for fill copy alpha and scroll":
        step("Verify: AC-6: records runtime execution evidence for fill copy alpha and scroll")
        val evidence = cpu_simd_runtime_evidence()
        expect(evidence.executed_fill).to_equal(true)
        expect(evidence.executed_copy).to_equal(true)
        expect(evidence.executed_alpha).to_equal(true)
        expect(evidence.executed_scroll).to_equal(true)
        expect(evidence.executed_all()).to_equal(true)
        expect(evidence.checksum).to_be_greater_than(0)
        expect(evidence.diagnostic_text()).to_contain("arch=")
        expect(evidence.diagnostic_text()).to_contain("feature=")
        expect(evidence.diagnostic_text()).to_contain("executed=true")

# ============================================================================
# simd_fill_row — vectorized pixel fill
# ============================================================================

describe "simd_fill_row":
    it "allocates and fills a complete owned framebuffer":
        step("Verify: allocates and fills a complete owned framebuffer")
        val buf = engine2d_simd_fill_buffer_u32(17, 0xFF102030u32)
        expect(buf.len()).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(buf[0]).to_equal(0xFF102030u32)
        expect(buf[16]).to_equal(0xFF102030u32)
        expect(engine2d_simd_fill_buffer_u32(0, 0u32).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "fills bounded row chunks without changing packed color":
        step("Verify: fills bounded row chunks without changing packed color")
        val buf = engine2d_simd_fill_rows_u32(13, 37, 0x80102030u32, 8)
        expect(buf.len()).to_equal(481)  # oracle: 481 — named expected value from the requirement
        expect(buf[0]).to_equal(0x80102030u32)
        expect(buf[480]).to_equal(0x80102030u32)
        expect(engine2d_simd_fill_rows_u32(0, 37, 0u32, 8).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "AC-6: fills row with solid color":
        step("Verify: AC-6: fills row with solid color")
        var buf: [u32] = [0u32; 16]
        val color: u32 = 0xFFFF0000
        simd_fill_row(buf, 0, 16, color)
        expect(buf[0]).to_equal(0xFFFF0000)
        expect(buf[15]).to_equal(0xFFFF0000)

    it "AC-6: fills partial row with offset":
        step("Verify: AC-6: fills partial row with offset")
        var buf: [u32] = [0u32; 16]
        val color: u32 = 0xFF00FF00
        simd_fill_row(buf, 4, 8, color)
        expect(buf[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(buf[4]).to_equal(0xFF00FF00)
        expect(buf[11]).to_equal(0xFF00FF00)
        expect(buf[12]).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "AC-6: handles zero-length fill":
        step("Verify: AC-6: handles zero-length fill")
        var buf: [u32] = [0xFFFFFFFF; 4]
        simd_fill_row(buf, 0, 0, 0)
        expect(buf[0]).to_equal(0xFFFFFFFF)

    it "uses the cross-mode return-array span bridge for backend fills":
        step("Verify: uses the cross-mode return-array span bridge for backend fills")
        val source = file_read("src/lib/nogc_sync_mut/gpu/engine2d/simd_kernels.spl")
        val backend_source = file_read("src/lib/gc_async_mut/gpu/engine2d/backend_software.spl")
        val engine_source = file_read("src/lib/gc_async_mut/gpu/engine2d/engine.spl")
        val interp_source = file_read("src/compiler_rust/compiler/src/interpreter_extern/simd.rs")
        val interp_dispatch = file_read("src/compiler_rust/compiler/src/interpreter_extern/mod.rs")
        val llvm_source = file_read("src/compiler/70.backend/backend/_MirToLlvm/asm_constraints_helpers.spl")
        val mir_source = file_read("src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl")
        expect(source).to_contain("rt_engine2d_simd_fill_span_u32")
        expect(source).to_contain("rt_engine2d_simd_copy_span_u32")
        expect(backend_source).to_contain("self.buf = rt_engine2d_simd_fill_span_u32")
        expect(backend_source).to_contain("self.buf = rt_engine2d_simd_copy_span_u32")
        expect(backend_source).to_contain("self.native_simd_spans and native_pixel_rows_enabled()")
        # The scalar fallback must write through self.buf DIRECTLY: passing the
        # field to a `mut` callee (e.g. _scalar_fill_row(self.buf, ...)) hands
        # the callee a field-read COPY under the interpreter, making fills a
        # silent no-op (see backend_software.spl sw_fill_raw_span comment).
        expect(backend_source).to_contain("self.buf[offset + i] = color")
        expect(backend_source.contains("_scalar_fill_row(self.buf")).to_equal(false)
        expect(backend_source.contains("simd_fill_row(self.buf, offset as i64, count as i64, color)")).to_equal(false)
        # Behavioral equivalence: the bridge's scalar reference produces the
        # same pixels the backend's direct-write fallback loop produces.
        var bridge_buf: [u32] = [0; 8]
        _scalar_fill_row(bridge_buf, 2, 4, 0xAABBCCDDu32)
        var loop_buf: [u32] = [0; 8]
        var li = 2
        while li < 6:
            loop_buf[li] = 0xAABBCCDDu32
            li = li + 1
        var bi = 0
        while bi < 8:
            expect(bridge_buf[bi]).to_equal(loop_buf[bi])
            bi = bi + 1
        expect(backend_source).to_contain("record_simd_alpha_hit()")
        expect(engine_source).to_contain("var cpu_simd = CpuBackend.create_simd()")
        expect(interp_source).to_contain("pub fn rt_engine2d_simd_fill_span_u32")
        expect(interp_source).to_contain("pub fn rt_engine2d_simd_copy_span_u32")
        expect(interp_source).to_contain("copy_from_slice(&filled)")
        expect(interp_dispatch).to_contain("insert_simple!(\"rt_engine2d_simd_fill_span_u32\"")
        expect(interp_dispatch).to_contain("insert_simple!(\"rt_engine2d_simd_copy_span_u32\"")
        expect(interp_dispatch.contains("rt_engine2d_simd_fill_u32")).to_equal(false)
        expect(llvm_source).to_contain("declare ptr @rt_engine2d_simd_fill_span_u32(ptr, i64, i64, i64)")
        expect(llvm_source).to_contain("declare ptr @rt_engine2d_simd_copy_span_u32(ptr, i64, ptr, i64, i64)")
        expect(mir_source).to_contain("name == \"rt_engine2d_simd_fill_span_u32\"")
        expect(mir_source).to_contain("name == \"rt_engine2d_simd_copy_span_u32\"")

    it "fills a bounded span without changing adjacent pixels":
        step("Verify: fills a bounded span without changing adjacent pixels")
        var buf: [u32] = [0 as u32; 8]
        buf = rt_engine2d_simd_fill_span_u32(buf, 2, 4, 0xFF102030u32)
        expect(buf[1]).to_equal(0u32)
        expect(buf[2]).to_equal(0xFF102030u32)
        expect(buf[5]).to_equal(0xFF102030u32)
        expect(buf[6]).to_equal(0u32)
        buf = rt_engine2d_simd_fill_span_u32(buf, 0, -1, 0xFFFFFFFFu32)
        expect(buf[0]).to_equal(0u32)

    it "clips fill spans at the destination end and preserves zero-count rows":
        step("Verify: clips fill spans at the destination end and preserves zero-count rows")
        var buf: [u32] = [0x01020304u32; 8]
        buf = rt_engine2d_simd_fill_span_u32(buf, 6, 8, 0xFFFFFFFFu32)
        expect(buf[5]).to_equal(0x01020304u32)
        expect(buf[6]).to_equal(0xFFFFFFFFu32)
        expect(buf[7]).to_equal(0xFFFFFFFFu32)
        buf = rt_engine2d_simd_fill_span_u32(buf, 0, 0, 0u32)
        expect(buf[0]).to_equal(0x01020304u32)
        buf = rt_engine2d_simd_fill_span_u32(buf, 8, 1, 0u32)
        expect(buf[7]).to_equal(0xFFFFFFFFu32)

# ============================================================================
# simd_blend_row — Porter-Duff alpha blending
# ============================================================================

describe "simd_blend_row":
    it "AC-6: blends opaque source over destination":
        step("Verify: AC-6: blends opaque source over destination")
        var dst: [u32] = [0xFF0000FF; 4]
        var src: [u32] = [0xFFFF0000; 4]
        simd_blend_row(dst, src, 0, 4)
        expect(dst[0]).to_equal(0xFFFF0000)

    it "AC-6: transparent source leaves destination unchanged":
        step("Verify: AC-6: transparent source leaves destination unchanged")
        var dst: [u32] = [0xFF0000FF; 4]
        var src: [u32] = [0x00000000; 4]
        simd_blend_row(dst, src, 0, 4)
        expect(dst[0]).to_equal(0xFF0000FF)

    it "AC-6: 50% alpha blends correctly":
        step("Verify: AC-6: 50% alpha blends correctly")
        var dst: [u32] = [0xFF000000; 4]
        var src: [u32] = [0x80FF0000; 4]
        simd_blend_row(dst, src, 0, 4)
        val r = (dst[0] >> 16) & 0xFF
        expect(r).to_be_greater_than(100)
        expect(r).to_be_less_than(200)

    it "translucent source over transparent destination preserves src exactly":
        step("Verify: translucent source over transparent destination preserves src exactly")
        var dst: [u32] = [0x00000000; 4]
        var src: [u32] = [0x80FF0000; 4]
        simd_blend_row(dst, src, 0, 4)
        expect(dst[0]).to_equal(0x80FF0000u32)

    it "native and scalar rows match for transparent and translucent destinations":
        step("Verify: native and scalar rows match for transparent and translucent destinations")
        val native_dst: [u32] = [0x00000000u32, 0x800000FFu32, 0x00112233u32, 0x7FFFFFFFu32]
        var scalar_dst: [u32] = [0x00000000u32, 0x800000FFu32, 0x00112233u32, 0x7FFFFFFFu32]
        val src: [u32] = [0x80FFFFFFu32, 0x80FF0000u32, 0x00000000u32, 0xFFFFFFFFu32]
        _scalar_blend_row(scalar_dst, src, 0, 4)
        val native = engine2d_simd_blend_row_u32(native_dst, src)
        expect(native).to_equal(scalar_dst)
        expect(native[0]).to_equal(0x80FFFFFFu32)
        expect(native[1]).to_equal(0xBFAA0054u32)
        expect(native[2]).to_equal(0x00112233u32)
        expect(native[3]).to_equal(0xFFFFFFFFu32)

    it "native blend handles empty and one-pixel rows":
        step("Verify: native blend handles empty and one-pixel rows")
        expect(engine2d_simd_blend_row_u32([], []).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val one = engine2d_simd_blend_row_u32([0x00000000u32], [0x80FFFFFFu32])
        expect(one.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(one[0]).to_equal(0x80FFFFFFu32)

# ============================================================================
# simd_blit_row — pixel copy
# ============================================================================

describe "simd_blit_row":
    it "AC-6: copies pixels from source to destination":
        step("Verify: AC-6: copies pixels from source to destination")
        var dst: [u32] = [0u32; 8]
        var src: [u32] = [0xFFAABBCC; 8]
        simd_blit_row(dst, 0, src, 0, 8)
        expect(dst[0]).to_equal(0xFFAABBCC)
        expect(dst[7]).to_equal(0xFFAABBCC)

    it "AC-6: copies with offset":
        step("Verify: AC-6: copies with offset")
        var dst: [u32] = [0u32; 8]
        var src: [u32] = [0xFFDDEEFF; 8]
        simd_blit_row(dst, 2, src, 0, 4)
        expect(dst[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst[2]).to_equal(0xFFDDEEFF)
        expect(dst[5]).to_equal(0xFFDDEEFF)
        expect(dst[6]).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "copies a bounded native span without changing adjacent pixels":
        step("Verify: copies a bounded native span without changing adjacent pixels")
        var dst: [u32] = [0u32; 8]
        val src: [u32] = [10u32, 11u32, 12u32, 13u32, 14u32, 15u32, 16u32, 17u32]
        dst = rt_engine2d_simd_copy_span_u32(dst, 2, src, 3, 4)
        expect(dst[1]).to_equal(0u32)
        expect(dst[2]).to_equal(13u32)
        expect(dst[5]).to_equal(16u32)
        expect(dst[6]).to_equal(0u32)
        dst = rt_engine2d_simd_copy_span_u32(dst, 6, src, 6, 8)
        expect(dst[6]).to_equal(16u32)
        expect(dst[7]).to_equal(17u32)
        dst = rt_engine2d_simd_copy_span_u32(dst, -1, src, 0, 2)
        expect(dst[0]).to_equal(0u32)

# ============================================================================
# Platform-universal guarantee (AC-6)
# ============================================================================

describe "universal fallback":
    it "AC-6: SIMD ops work even when SimdLevel is None (scalar fallback)":
        step("Verify: AC-6: SIMD ops work even when SimdLevel is None (scalar fallback)")
        var buf: [u32] = [0u32; 4]
        simd_fill_row(buf, 0, 4, 0xFFFF0000)
        expect(buf[0]).to_equal(0xFFFF0000)

    it "AC-6: same results regardless of SIMD level":
        step("Verify: AC-6: same results regardless of SIMD level")
        var buf1: [u32] = [0u32; 4]
        var buf2: [u32] = [0u32; 4]
        simd_fill_row(buf1, 0, 4, 0xFF112233)
        simd_fill_row(buf2, 0, 4, 0xFF112233)
        expect(buf1[0]).to_equal(buf2[0])
        expect(buf1[3]).to_equal(buf2[3])

# ============================================================================
# detect_simd_level — F6: consistency with the raw CPU-feature probes
# ============================================================================

describe "detect_simd_level vs raw feature probes":
    it "F6: chosen level matches the highest-priority true probe (avx2 > sse > neon > rvv > none)":
        step("Verify: F6: chosen level matches the highest-priority true probe (avx2 > sse > neon > rvv > none)")
        val level_name = detect_simd_level().to_text()
        val has_avx2 = engine2d_simd_has_avx2()
        val has_sse = engine2d_simd_has_sse()
        val has_neon = engine2d_simd_has_neon()
        val has_rvv = engine2d_simd_has_rvv()
        val expected = if has_avx2:
            "AVX2"
        elif has_sse:
            "SSE4.2"
        elif has_neon:
            "NEON"
        elif has_rvv:
            "RVV"
        else:
            "None"
        expect(level_name).to_equal(expected)

    it "F6: active_arch_text/active_feature_text agree with the detected level":
        step("Verify: F6: active_arch_text/active_feature_text agree with the detected level")
        val level = detect_simd_level()
        expect(active_arch_text()).to_equal(level.arch_text())
        expect(active_feature_text()).to_equal(level.feature_text())

# ============================================================================
# simd_config_mode — F6: env-driven branches
# ============================================================================

describe "simd_config_mode":
    it "F6: empty/unset SIMPLE_2D_SIMD defaults to auto":
        step("Verify: F6: empty/unset SIMPLE_2D_SIMD defaults to auto")
        env_unset("SIMPLE_2D_SIMD")
        expect(simd_config_mode()).to_equal("auto")

    it "F6: SIMPLE_2D_SIMD=off is honored verbatim":
        step("Verify: F6: SIMPLE_2D_SIMD=off is honored verbatim")
        env_set("SIMPLE_2D_SIMD", "off")
        expect(simd_config_mode()).to_equal("off")
        env_unset("SIMPLE_2D_SIMD")

    it "F6: an explicit ISA name passes through unmodified":
        step("Verify: F6: an explicit ISA name passes through unmodified")
        env_set("SIMPLE_2D_SIMD", "neon")
        expect(simd_config_mode()).to_equal("neon")
        env_unset("SIMPLE_2D_SIMD")
        expect(simd_config_mode()).to_equal("auto")

# ============================================================================
# blit_rect — F6: rect-copy dispatch, row-by-row parity vs the scalar reference
# ============================================================================

fn make_ramp(n: i64) -> [u32]:
    var out: [u32] = [0u32; n]
    var i: i64 = 0
    while i < n:
        out[i.to_i32()] = (0xFF000000u32 | (i.to_u32() & 0xFFu32))
        i = i + 1
    out

describe "blit_rect":
    it "F6: dispatch path matches the scalar reference row-by-row":
        step("Verify: F6: dispatch path matches the scalar reference row-by-row")
        val src = make_ramp(64)
        var dst_dispatch: [u32] = [0u32; 64]
        var dst_scalar: [u32] = [0u32; 64]
        blit_rect(dst_dispatch, 8, 1, 1, src, 8, 0, 0, 5, 5)
        _scalar_blit_rect(dst_scalar, 8, 1, 1, src, 8, 0, 0, 5, 5)
        expect(dst_dispatch).to_equal(dst_scalar)
        expect(dst_dispatch[9]).to_equal(src[0])

    it "F6: overlapping src/dst regions (same underlying pixel values) stay in parity":
        step("Verify: F6: overlapping src/dst regions (same underlying pixel values) stay in parity")
        val shared = make_ramp(64)
        var dst_dispatch: [u32] = shared
        var dst_scalar: [u32] = shared
        blit_rect(dst_dispatch, 8, 2, 2, shared, 8, 0, 0, 4, 4)
        _scalar_blit_rect(dst_scalar, 8, 2, 2, shared, 8, 0, 0, 4, 4)
        expect(dst_dispatch).to_equal(dst_scalar)

    it "F6: zero-area rect (w<=0 or h<=0) is a no-op on both paths":
        step("Verify: F6: zero-area rect (w<=0 or h<=0) is a no-op on both paths")
        val src = make_ramp(16)
        var dst_dispatch: [u32] = [0xFFFFFFFFu32; 16]
        var dst_scalar: [u32] = [0xFFFFFFFFu32; 16]
        blit_rect(dst_dispatch, 4, 0, 0, src, 4, 0, 0, 0, 3)
        _scalar_blit_rect(dst_scalar, 4, 0, 0, src, 4, 0, 0, 0, 3)
        expect(dst_dispatch).to_equal(dst_scalar)
        expect(dst_dispatch[0]).to_equal(0xFFFFFFFFu32)

# ============================================================================
# scroll_region — F6: vertical scroll dispatch vs scalar reference
#
# The real signature (`stride, x, y, w, h, delta_y`) only ever moves rows
# vertically — there is no delta_x parameter, so a "left/right" scroll is not
# expressible through this API. Pinning that reality rather than the plan's
# assumption of a horizontal variant (V1/F4 precedent).
# ============================================================================

describe "scroll_region":
    it "F6: scroll up (negative delta_y) matches scalar reference":
        step("Verify: F6: scroll up (negative delta_y) matches scalar reference")
        val original = make_ramp(64)
        var buf_dispatch: [u32] = original
        var buf_scalar: [u32] = original
        scroll_region(buf_dispatch, 8, 0, 0, 8, 8, -2)
        _scalar_scroll_region(buf_scalar, 8, 0, 0, 8, 8, -2)
        expect(buf_dispatch).to_equal(buf_scalar)
        expect(buf_dispatch[0]).to_equal(original[16])

    it "F6: scroll down (positive delta_y) matches scalar reference":
        step("Verify: F6: scroll down (positive delta_y) matches scalar reference")
        val original = make_ramp(64)
        var buf_dispatch: [u32] = original
        var buf_scalar: [u32] = original
        scroll_region(buf_dispatch, 8, 0, 0, 8, 8, 3)
        _scalar_scroll_region(buf_scalar, 8, 0, 0, 8, 8, 3)
        expect(buf_dispatch).to_equal(buf_scalar)
        expect(buf_dispatch[24]).to_equal(original[0])

    it "F6: delta_y == 0 and delta_y >= h are no-ops on both paths":
        step("Verify: F6: delta_y == 0 and delta_y >= h are no-ops on both paths")
        val original = make_ramp(64)
        var buf_zero: [u32] = original
        var buf_zero_scalar: [u32] = original
        scroll_region(buf_zero, 8, 0, 0, 8, 8, 0)
        _scalar_scroll_region(buf_zero_scalar, 8, 0, 0, 8, 8, 0)
        expect(buf_zero).to_equal(original)
        expect(buf_zero).to_equal(buf_zero_scalar)

        var buf_over: [u32] = original
        var buf_over_scalar: [u32] = original
        scroll_region(buf_over, 8, 0, 0, 8, 8, 8)
        _scalar_scroll_region(buf_over_scalar, 8, 0, 0, 8, 8, 8)
        expect(buf_over).to_equal(original)
        expect(buf_over).to_equal(buf_over_scalar)

# ============================================================================
# cpu_simd_required_evidence_valid — F6: honest-gate evidence composition
#
# Fabricated-stub guard pattern: this is a pure predicate over evidence
# fields, so we drive it directly with crafted CpuSimdRuntimeEvidence values
# instead of trusting only the live host reading (which is a single sample).
# ============================================================================

describe "cpu_simd_required_evidence_valid":
    it "F6: valid only when arch matches, all kernels executed, native SIMD ran bit-exact, and no fallback calls occurred":
        step("Verify: F6: valid only when arch matches, all kernels executed, native SIMD ran bit-exact, and no fallback calls occurred")
        val good = CpuSimdRuntimeEvidence(
            arch: "aarch64", feature: "neon", level: "NEON",
            x86_available: false, arm_available: true, riscv_available: false,
            executed_fill: true, executed_copy: true, executed_alpha: true, executed_scroll: true,
            checksum: 42, hit_summary: "ok", reason: "ok",
            native_simd_executed: true, native_simd_bit_exact: true, native_simd_hits: 4
        )
        expect(cpu_simd_required_evidence_valid(good, "aarch64", 0)).to_equal(true)

    it "F6: rejects a mismatched expected_arch":
        step("Verify: F6: rejects a mismatched expected_arch")
        val evidence = CpuSimdRuntimeEvidence(
            arch: "aarch64", feature: "neon", level: "NEON",
            x86_available: false, arm_available: true, riscv_available: false,
            executed_fill: true, executed_copy: true, executed_alpha: true, executed_scroll: true,
            checksum: 42, hit_summary: "ok", reason: "ok",
            native_simd_executed: true, native_simd_bit_exact: true, native_simd_hits: 4
        )
        expect(cpu_simd_required_evidence_valid(evidence, "x86_64", 0)).to_equal(false)

    it "F6: rejects when a kernel never executed (not-executed_all)":
        step("Verify: F6: rejects when a kernel never executed (not-executed_all)")
        val evidence = CpuSimdRuntimeEvidence(
            arch: "aarch64", feature: "neon", level: "NEON",
            x86_available: false, arm_available: true, riscv_available: false,
            executed_fill: true, executed_copy: true, executed_alpha: true, executed_scroll: false,
            checksum: 42, hit_summary: "ok", reason: "ok",
            native_simd_executed: true, native_simd_bit_exact: true, native_simd_hits: 4
        )
        expect(cpu_simd_required_evidence_valid(evidence, "aarch64", 0)).to_equal(false)

    it "F6: rejects a canned-success evidence that never ran native SIMD (fabricated-stub guard)":
        step("Verify: F6: rejects a canned-success evidence that never ran native SIMD (fabricated-stub guard)")
        val evidence = CpuSimdRuntimeEvidence(
            arch: "aarch64", feature: "neon", level: "NEON",
            x86_available: false, arm_available: true, riscv_available: false,
            executed_fill: true, executed_copy: true, executed_alpha: true, executed_scroll: true,
            checksum: 42, hit_summary: "ok", reason: "claimed success",
            native_simd_executed: false, native_simd_bit_exact: true, native_simd_hits: 0
        )
        expect(cpu_simd_required_evidence_valid(evidence, "aarch64", 0)).to_equal(false)

    it "F6: rejects when any fallback call occurred, even with otherwise-clean evidence":
        step("Verify: F6: rejects when any fallback call occurred, even with otherwise-clean evidence")
        val evidence = CpuSimdRuntimeEvidence(
            arch: "aarch64", feature: "neon", level: "NEON",
            x86_available: false, arm_available: true, riscv_available: false,
            executed_fill: true, executed_copy: true, executed_alpha: true, executed_scroll: true,
            checksum: 42, hit_summary: "ok", reason: "ok",
            native_simd_executed: true, native_simd_bit_exact: true, native_simd_hits: 4
        )
        expect(cpu_simd_required_evidence_valid(evidence, "aarch64", 1)).to_equal(false)

    it "F6: the live host evidence's own executed_all() agrees with the gate's fill/copy/alpha/scroll requirement":
        step("Verify: F6: the live host evidence's own executed_all() agrees with the gate's fill/copy/alpha/scroll requirement")
        val live = cpu_simd_runtime_evidence()
        val gated = cpu_simd_required_evidence_valid(live, live.arch, 0)
        if live.native_simd_executed and live.native_simd_bit_exact and live.native_simd_hits > 0:
            expect(gated).to_equal(live.executed_all())
        else:
            expect(gated).to_equal(false)

# ============================================================================
# diagnostic_text — F6: names the active arch/feature honestly
# ============================================================================

describe "CpuSimdRuntimeEvidence.diagnostic_text":
    it "F6: names the arch and feature actually detected on this host":
        step("Verify: F6: names the arch and feature actually detected on this host")
        val evidence = cpu_simd_runtime_evidence()
        val text_out = evidence.diagnostic_text()
        expect(text_out).to_contain("arch=" + active_arch_text())
        expect(text_out).to_contain("feature=" + active_feature_text())
        expect(text_out).to_contain("native_simd_executed=")
        expect(text_out).to_contain("native_simd_hits=" + evidence.native_simd_hits.to_text())

# ============================================================================
# rt_engine2d_simd_blend_span_u32 / rt_engine2d_simd_blend_const_span_u32
#
# T16 (doc/08_tracking/bug/t16_blend_span_c_symbol_not_reachable_three_implementations_2026-08-07.md)
# tracked these two kernels as absent from the deployed native ABI. `nm` on
# the current deployed binary shows both symbols present again, but no spec
# asserted pixel output for the in-place span form — only the row form
# (engine2d_simd_blend_row_u32) had exact-value coverage. These cases close
# that gap with the same straight-alpha src-over fixtures already proven
# bit-exact for the row kernel above.
# ============================================================================

describe "engine2d_simd_blend_span_u32 (in-place span blend, bit-exact)":
    it "blends a bounded span in place without touching pixels outside it":
        step("Verify: blends a bounded span in place without touching pixels outside it")
        var dst: [u32] = [0x11111111u32, 0xFF0000FFu32, 0xFF0000FFu32, 0x22222222u32]
        val src: [u32] = [0xFFFF0000u32, 0xFFFF0000u32]
        dst = engine2d_simd_blend_span_u32(dst, 1, src, 0, 2)
        expect(dst[0]).to_equal(0x11111111u32)
        expect(dst[1]).to_equal(0xFFFF0000u32)
        expect(dst[2]).to_equal(0xFFFF0000u32)
        expect(dst[3]).to_equal(0x22222222u32)

    it "transparent source leaves destination span unchanged":
        step("Verify: transparent source leaves destination span unchanged")
        var dst: [u32] = [0xFF0000FFu32, 0xFF0000FFu32]
        val src: [u32] = [0x00000000u32, 0x00000000u32]
        dst = engine2d_simd_blend_span_u32(dst, 0, src, 0, 2)
        expect(dst[0]).to_equal(0xFF0000FFu32)
        expect(dst[1]).to_equal(0xFF0000FFu32)

    it "matches the scalar row kernel value-for-value (bit-exact parity)":
        step("Verify: matches the scalar row kernel value-for-value (bit-exact parity)")
        val dst_row: [u32] = [0x00000000u32, 0x800000FFu32, 0x00112233u32, 0x7FFFFFFFu32]
        val src_row: [u32] = [0x80FFFFFFu32, 0x80FF0000u32, 0x00000000u32, 0xFFFFFFFFu32]
        var scalar_dst: [u32] = [0x00000000u32, 0x800000FFu32, 0x00112233u32, 0x7FFFFFFFu32]
        _scalar_blend_row(scalar_dst, src_row, 0, 4)
        var span_dst: [u32] = [0x00000000u32, 0x800000FFu32, 0x00112233u32, 0x7FFFFFFFu32]
        span_dst = engine2d_simd_blend_span_u32(span_dst, 0, src_row, 0, 4)
        expect(span_dst).to_equal(scalar_dst)
        expect(span_dst[1]).to_equal(0xBFAA0054u32)

describe "engine2d_simd_blend_const_span_u32 (constant-colour span blend, bit-exact)":
    it "blends one constant colour over a bounded span in place":
        step("Verify: blends one constant colour over a bounded span in place")
        var dst: [u32] = [0x11111111u32, 0xFF0000FFu32, 0xFF0000FFu32, 0x22222222u32]
        dst = engine2d_simd_blend_const_span_u32(dst, 1, 2, 0xFFFF0000i64)
        expect(dst[0]).to_equal(0x11111111u32)
        expect(dst[1]).to_equal(0xFFFF0000u32)
        expect(dst[2]).to_equal(0xFFFF0000u32)
        expect(dst[3]).to_equal(0x22222222u32)

    it "zero-alpha constant colour is a no-op":
        step("Verify: zero-alpha constant colour is a no-op")
        var dst: [u32] = [0xFF0000FFu32, 0xFF0000FFu32]
        dst = engine2d_simd_blend_const_span_u32(dst, 0, 2, 0x00FFFFFFi64)
        expect(dst[0]).to_equal(0xFF0000FFu32)
        expect(dst[1]).to_equal(0xFF0000FFu32)

    it "50%-alpha constant colour matches the row kernel's known bit-exact value":
        step("Verify: 50%-alpha constant colour matches the row kernel's known bit-exact value")
        var dst: [u32] = [0x800000FFu32]
        dst = engine2d_simd_blend_const_span_u32(dst, 0, 1, 0x80FF0000i64)
        expect(dst[0]).to_equal(0xBFAA0054u32)
