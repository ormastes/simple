# @tag: unit, gpu, engine2d, software, damage
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_software.spl 5%

use std.spec
use std.gc_async_mut.gpu.engine2d.backend_software.{SoftwareBackend}
use common.ui.window_scene.{wm_content_frame_checksum}

describe "software damage mirror checksum":
    it "matches a full-frame checksum after sparse and idle frames":
        var backend = SoftwareBackend.create()
        expect(backend.init(96, 64)).to_equal(true)
        backend.clear(0xFF102030u32)
        val seeded = backend.read_pixels_damaged_with_checksum(16)
        expect(seeded.1).to_equal(wm_content_frame_checksum(seeded.0))
        backend.present()

        backend.draw_rect_filled(37, 21, 5, 3, 0xFF80A040u32)
        val changed = backend.read_pixels_damaged_with_checksum(16)
        expect(changed.1).to_equal(wm_content_frame_checksum(
            backend.read_pixels()))
        backend.present()

        val idle = backend.read_pixels_damaged_with_checksum(16)
        expect(idle.1).to_equal(changed.1)
        expect(idle.0).to_equal(changed.0)
        backend.shutdown()
