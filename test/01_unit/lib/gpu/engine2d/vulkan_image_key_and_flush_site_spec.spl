use std.gpu.engine2d.backend_vulkan.{VulkanBackend, text_blit_image_key, inline_image_key, VK_IMAGE_INLINE_KEY_MAX_PIXELS}

# REPRODUCER for vulkan_page_frame_17_submits_and_unkeyed_image_uploads_2026-09-12.
#
# Two defects, one file, both measured on the real page by
# `scripts/check/check-web-vulkan-gpu-boundary-audit.shs`:
#
#   #5 `submits_per_frame=17` against an invariant of 1. Every submit this
#      backend performs comes from exactly one `_flush_pending_compute`, so the
#      count was never the question -- WHICH call site produced each one was,
#      and nothing in the tree could answer it. `last_flush_site` is that
#      answer, and these examples pin that the tag is set by the tagged entry
#      point and RESET afterwards, so a later untagged flush cannot inherit the
#      previous site's name and mis-attribute a submit to innocent code.
#
#   #6 `uploads_per_frame=78` with no identity key: the same pixels re-uploaded
#      every frame. The fix is a producer-supplied key, armed once per image and
#      consumed exactly once. These examples pin the key function's identity
#      semantics and the arm/consume contract, both of which are device-free.
#
# Device-free by construction: no example here touches a Vulkan device. The
# device-level oracles (a frame with N images and M text runs performs exactly
# one submit; an unchanged image uploads once across two frames) are the audit
# gate's job -- it renders a real page and reads the live SFFI counters.

describe "text_blit_image_key names a text raster's identity, not its pixels":

    it "is deterministic for identical inputs":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-001
        # The whole point: the key is computed from the DRAW, so two frames that
        # draw the same label produce the same key without ever digesting the
        # raster.
        val a = text_blit_image_key("Hello", 0xFF112233u32, 14, 40, 16)
        val b = text_blit_image_key("Hello", 0xFF112233u32, 14, 40, 16)
        expect(a).to_equal(b)

    it "separates every field that changes the pixels":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-002
        val base = text_blit_image_key("Hello", 0xFF112233u32, 14, 40, 16)
        expect(text_blit_image_key("Hellp", 0xFF112233u32, 14, 40, 16)).to_not_equal(base)
        expect(text_blit_image_key("Hello", 0xFF112234u32, 14, 40, 16)).to_not_equal(base)
        expect(text_blit_image_key("Hello", 0xFF112233u32, 15, 40, 16)).to_not_equal(base)
        expect(text_blit_image_key("Hello", 0xFF112233u32, 14, 41, 16)).to_not_equal(base)
        expect(text_blit_image_key("Hello", 0xFF112233u32, 14, 40, 17)).to_not_equal(base)

    it "never returns 0, which is reserved for 'no key'":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-003
        # A key of 0 means "unknown identity" and disables the cache for that
        # image. A hash that happened to land on 0 would silently do that, so it
        # is nudged to 1 instead.
        expect(text_blit_image_key("", 0u32, 0, 0, 0)).to_not_equal(0)
        expect(text_blit_image_key("a", 0xFFFFFFFFu32, 12, 8, 12)).to_not_equal(0)

describe "an image key is armed once and consumed once":

    it "starts unarmed":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-004
        val b = VulkanBackend.create()
        expect(b.pending_image_key).to_equal(0)

    it "holds the key the producer armed":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-005
        var b = VulkanBackend.create()
        b.hint_image_key(987654321)
        expect(b.pending_image_key).to_equal(987654321)

    it "lets a later arm replace an unconsumed key":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-006
        # Last writer wins: the key belongs to the NEXT composite, and only one
        # composite can be next.
        var b = VulkanBackend.create()
        b.hint_image_key(11)
        b.hint_image_key(22)
        expect(b.pending_image_key).to_equal(22)

describe "a keyed source is only handed back when it truly holds those pixels":

    it "refuses every lookup on an uninitialized backend":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-007
        # Fail closed: with no device and no pool, there is no slot that can
        # hold anything, and a non-zero answer here would skip a real upload.
        var b = VulkanBackend.create()
        expect(b._acquire_keyed_image_source(4096, 12345)).to_equal(0)

    it "refuses the reserved zero key outright":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-008
        var b = VulkanBackend.create()
        b.initialized = true
        b.d_framebuffer = 4242
        expect(b._acquire_keyed_image_source(4096, 0)).to_equal(0)

    it "refuses a non-positive byte count":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-009
        var b = VulkanBackend.create()
        b.initialized = true
        b.d_framebuffer = 4242
        expect(b._acquire_keyed_image_source(0, 12345)).to_equal(0)

    it "starts with no key hits recorded":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-010
        val b = VulkanBackend.create()
        expect(b.image_source_key_hit_count).to_equal(0)

describe "every flush names the site that caused it":

    it "starts untagged":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-011
        # `untagged` is what the two font-lane flush sites report. That is
        # deliberate: they live in a file this fix does not own, and the tag
        # still tells the audit which submits are NOT this file's.
        val b = VulkanBackend.create()
        expect(b.last_flush_site).to_equal("untagged")

    it "records the site the tagged entry point was given":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-012
        # An uninitialized backend has no pending command, so the flush itself
        # is a no-op returning 1 -- exactly what makes this assertion about the
        # TAG and nothing else.
        var b = VulkanBackend.create()
        val rc = b._flush_pending_compute_at("spec-site")
        expect(rc).to_equal(1)
        expect(b.last_flush_site).to_equal("spec-site")

describe "a small image is its own key; a large one is never digested":

    it "digests only images at or below the bound":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-013
        # The bound is the honesty of this scheme: below it the digest is
        # cheaper than the upload it replaces, above it a per-frame digest would
        # cost more than the upload it saves, so large images stay unkeyed
        # unless a producer names them.
        expect(VK_IMAGE_INLINE_KEY_MAX_PIXELS).to_equal(64)

    it "gives identical small images identical keys":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-014
        val a = inline_image_key([0xFF00FF00u32], 1, 1, 1, 1000, 1)
        val b = inline_image_key([0xFF00FF00u32], 1, 1, 1, 1000, 1)
        expect(a).to_equal(b)

    it "separates a different pixel, opacity, and composite mode":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-015
        val base = inline_image_key([0xFF00FF00u32], 1, 1, 1, 1000, 1)
        expect(inline_image_key([0xFF00FF01u32], 1, 1, 1, 1000, 1)).to_not_equal(base)
        expect(inline_image_key([0xFF00FF00u32], 1, 1, 1, 500, 1)).to_not_equal(base)
        expect(inline_image_key([0xFF00FF00u32], 1, 1, 1, 1000, 0)).to_not_equal(base)

    it "never returns the reserved zero":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-016
        expect(inline_image_key([0u32], 1, 1, 1, 1000, 0)).to_not_equal(0)

describe "an armed key never survives the draw it belongs to":

    it "is cleared even when the composite is rejected outright":
        step("Exercise the Vulkan image key and flush site")
        # @req REQ-GPU-VULKAN-IMAGE-KEY-FLUSH-017
        # THE bug this ordering exists to prevent: a clipped-out or otherwise
        # rejected image used to leave its key armed, and the NEXT, unrelated
        # image inherited that identity -- then skipped a genuine upload on a
        # later frame and drew the wrong pixels.
        var b = VulkanBackend.create()
        b.hint_image_key(4242)
        val rc = b._draw_image_composite_native_impl(0, 0, 4, 4, 4, 4,
            [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
             0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32], 1000, 0, false)
        expect(rc).to_equal(0)
        expect(b.pending_image_key).to_equal(0)
