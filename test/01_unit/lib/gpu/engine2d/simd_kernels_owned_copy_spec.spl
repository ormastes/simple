use std.spec.*
use std.gpu.engine2d.simd_kernels.{
    simd_blit_rect,
    simd_scroll_region,
    _scalar_blit_rect,
    _scalar_scroll_region
}

fn owned_pixels() -> [u32]:
    [for i in 0..32: i.to_u32()]

describe "ownership-safe SIMD rectangle copy and scroll":
    it "returns the same pixels as scalar rectangular blit with row tails":
        val src = owned_pixels()
        var expected = [99u32; 32]
        _scalar_blit_rect(expected, 8, 2, 1, src, 8, 1, 0, 5, 3)
        # simd_blit_rect mutates its destination in place (void return).
        var actual = [99u32; 32]
        simd_blit_rect(actual, 8, 2, 1, src, 8, 1, 0, 5, 3)
        expect(actual).to_equal(expected)

    it "preserves overlap ordering while scrolling upward":
        var expected = owned_pixels()
        _scalar_scroll_region(expected, 8, 1, 0, 6, 4, -1)
        var actual = owned_pixels()
        simd_scroll_region(actual, 8, 1, 0, 6, 4, -1)
        expect(actual).to_equal(expected)

    it "preserves overlap ordering while scrolling downward":
        var expected = owned_pixels()
        _scalar_scroll_region(expected, 8, 1, 0, 6, 4, 2)
        var actual = owned_pixels()
        simd_scroll_region(actual, 8, 1, 0, 6, 4, 2)
        expect(actual).to_equal(expected)

    it "returns unchanged storage for zero and oversized deltas":
        var actual = owned_pixels()
        simd_scroll_region(actual, 8, 0, 0, 8, 4, 0)
        expect(actual).to_equal(owned_pixels())
        simd_scroll_region(actual, 8, 0, 0, 8, 4, 4)
        expect(actual).to_equal(owned_pixels())
