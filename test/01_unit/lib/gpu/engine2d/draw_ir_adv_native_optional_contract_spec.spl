use std.io_runtime.{file_read}
use std.spec.*

describe "Draw IR native optional lowering contract":
    it "uses the guarded Vulkan evidence value rather than unwrapping the guard result":
        val source = file_read("src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl")
        expect(source).to_contain("if vulkan_font != nil:")
        expect(source).to_contain("val evidence = vulkan_font")
        expect(source.contains("val evidence = vulkan_font.?")).to_be(false)
