# @req REQ-2D-005 REQ-2D-006
# CPU geometry proof for the strict Engine2D Vulkan opaque rectangle path.
# Physical device parity is covered separately by the Linux qualification run.

use std.spec.{describe, it, expect}
use std.spec.step
use std.common.ui.draw_ir.{draw_ir_rect_clipped, draw_ir_rect_bounds}
use std.gc_async_mut.gpu.engine2d.strict_vulkan_rect_clip.{
    engine2d_strict_vulkan_rect_clip_coverage}

describe "strict Vulkan clipped rectangle coverage":
    it "intersects an oversized draw with its target-coordinate clip":
        step("Clip a larger opaque rectangle to five by six target pixels")
        val command = draw_ir_rect_clipped("box", -2, -2, 20, 20,
            0xff336699u32, draw_ir_rect_bounds(2, 3, 5, 6))
        val visible = engine2d_strict_vulkan_rect_clip_coverage(
            command, 16, 16)
        expect(visible.present).to_equal(true)
        expect(visible.x).to_equal(2)
        expect(visible.y).to_equal(3)
        expect(visible.width).to_equal(5)
        expect(visible.height).to_equal(6)

    it "treats an empty clip as zero coverage":
        step("Keep the command without dispatching a zero-area GPU rectangle")
        val command = draw_ir_rect_clipped("empty", 0, 0, 16, 16,
            0xff336699u32, draw_ir_rect_bounds(2, 3, 0, 6))
        val visible = engine2d_strict_vulkan_rect_clip_coverage(
            command, 16, 16)
        expect(visible.present).to_equal(false)

    it "does not overflow when a clip edge lies beyond i32 range":
        step("Calculate the edge in i64 and reject out-of-target coverage")
        val command = draw_ir_rect_clipped("far", 0, 0, 16, 16,
            0xff336699u32,
            draw_ir_rect_bounds(2147483647, 0, 2147483647, 16))
        val visible = engine2d_strict_vulkan_rect_clip_coverage(
            command, 16, 16)
        expect(visible.present).to_equal(false)
