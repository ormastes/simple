# @cover src/lib/gc_async_mut/gpu/engine2d/{backend.spl,backend_cpu.spl,engine.spl} 80%
# @tag: unit, engine2d, cpu, damage
"""Single-owner borrowed damage mirror through the Engine2D facade."""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

val RETAINED_BLACK: u32 = 0xff000000u32
val RETAINED_RED: u32 = 0xffef4444u32

describe "Engine2D retained CPU damaged readback":
    it "updates CpuBackend's single owned software mirror after present":
        var engine = Engine2D.create_with_backend(4, 2, "cpu_simd")
        engine.clear(RETAINED_BLACK)
        val seeded = engine.read_pixels_damaged(16)
        expect(seeded).to_equal([
            RETAINED_BLACK, RETAINED_BLACK, RETAINED_BLACK, RETAINED_BLACK,
            RETAINED_BLACK, RETAINED_BLACK, RETAINED_BLACK, RETAINED_BLACK
        ])
        engine.present()
        engine.draw_rect_filled(2, 1, 1, 1, RETAINED_RED)
        val updated = engine.read_pixels_damaged(16)
        expect(updated).to_equal([
            RETAINED_BLACK, RETAINED_BLACK, RETAINED_BLACK, RETAINED_BLACK,
            RETAINED_BLACK, RETAINED_BLACK, RETAINED_RED, RETAINED_BLACK
        ])
        engine.present()
        engine.shutdown()
