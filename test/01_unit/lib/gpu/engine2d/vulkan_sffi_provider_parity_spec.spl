"""Vulkan Engine2D SFFI provider alias parity contract.

The migration must preserve raw handle, status, byte-count, and timeout values
without allocating a provider object or adding a wrapper frame per operation.
"""

extern fn rt_file_read_text(path: text) -> text

use std.spec.{describe, it, expect}

fn _occurrences(source: text, token: text) -> i64:
    source.split(token).len() - 1

fn _alias_call_line_count(source: text) -> i64:
    val lines = source.split("\n")
    var count: i64 = 0
    var i: i64 = 0
    while i < lines.len():
        val alias = lines[i].find("vulkan_abi_")
        val call = lines[i].find("(")
        if alias >= 0 and call > alias:
            count += 1
        i += 1
    count

describe "Vulkan SFFI provider parity":
    it "keeps every migrated call on a direct canonical alias":
        val facade = rt_file_read_text(
            "src/lib/nogc_sync_mut/gpu/engine2d/sffi_vulkan.spl") ?? ""
        val provider = rt_file_read_text(
            "src/lib/nogc_sync_mut/io/vulkan_sffi.spl") ?? ""

        expect(_alias_call_line_count(facade)).to_equal(87)
        expect(_occurrences(provider, "@inline\npub fn vulkan_abi_")).to_equal(55)
        expect(_occurrences(facade, "vulkan_abi_byte_array_new_len(")).to_equal(3)
        expect(facade.contains("VulkanAbiProvider(")).to_equal(false)
        expect(facade.contains("vulkan_abi_provider()")).to_equal(false)

    it "preserves handle and status arguments without representation changes":
        val facade = rt_file_read_text(
            "src/lib/nogc_sync_mut/gpu/engine2d/sffi_vulkan.spl") ?? ""

        expect(facade).to_contain(
            "vulkan_abi_alloc_buffer(size, usage)")
        expect(facade).to_contain(
            "vulkan_abi_create_compute_pipeline(shader_module, entry_point, push_constant_size)")
        expect(facade).to_contain(
            "vulkan_abi_submit_and_wait_fence(cmd)")
        expect(facade).to_contain(
            "vulkan_abi_wait_fence(fence, timeout_ns)")
        expect(facade).to_contain(
            "vulkan_abi_accepted_compute_submit_count()")
        expect(facade).to_contain(
            "vulkan_abi_present_buffer(swapchain, buffer, width, height, content_revision)")
        expect(facade).to_contain(
            "vulkan_abi_destroy_swapchain(swapchain)")

    it "keeps array ABI byte counts and native exact-size allocation intact":
        val facade = rt_file_read_text(
            "src/lib/nogc_sync_mut/gpu/engine2d/sffi_vulkan.spl") ?? ""

        expect(facade).to_contain(
            "vulkan_abi_copy_to_buffer_array(handle, data, data.len().to_i64(), offset)")
        expect(facade).to_contain(
            "vulkan_abi_push_constants_array(cmd, pipe, data, data.len().to_i64())")
        expect(facade).to_contain(
            "vulkan_abi_copy_from_buffer_array(bytes, byte_count, handle, offset)")
        expect(facade).to_contain(
            "val packed = vulkan_abi_byte_array_new_len(byte_count)")

    it "declares the migrated ABI exactly once in the canonical owner":
        val provider = rt_file_read_text(
            "src/lib/nogc_sync_mut/io/vulkan_sffi.spl") ?? ""

        expect(_occurrences(provider, "extern fn rt_vulkan_")).to_equal(91)
        expect(_occurrences(provider, "extern fn rt_byte_array_new_len")).to_equal(1)
        expect(provider).to_contain(
            "extern fn rt_vulkan_present_buffer_regions(swapchain: i64, buffer: i64, width: i64, height: i64, content_revision: i64, rects: [i64]) -> i64")
        expect(provider).to_contain(
            "extern fn rt_vulkan_copy_from_buffer_strided(data: [u8], handle: i64, src_offset: i64, row_bytes: i64, row_count: i64, src_stride: i64) -> bool")
        expect(provider).to_contain(
            "extern fn rt_vulkan_accepted_compute_submit_count() -> i64")
        expect(provider).to_contain(
            "extern fn rt_vulkan_dependency_quarantine_lock() -> bool")
