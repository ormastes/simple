# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec.{describe, it, expect}

extern fn rt_fs_read_text(path: text) -> text?

describe "SoftwareBackend in-place SIMD blend spans":
    # @manual scenario evidence
    it "routes production image and constant blends without row allocation":
        # @req REQ-SSPEC-LIB
        step("routes production image and constant blends without row allocation")
        val source = rt_fs_read_text(
            "src/lib/gc_async_mut/gpu/engine2d/backend_software.spl") ?? ""
        expect(source).to_contain("rt_engine2d_simd_blend_span_u32(")
        expect(source).to_contain("rt_engine2d_simd_blend_const_span_u32(")
        expect(source.contains("var dst_row: [u32]")).to_equal(false)
        expect(source.contains("var src_row: [u32]")).to_equal(false)
        expect(source.contains("engine2d_simd_blend_row_u32(")).to_equal(false)
        # Cross-ISA selection is governed by native evidence, not an x86-only
        # production branch; enabled AArch64/RISC-V runtimes use the same ABI.
        expect(source.contains("active_arch_text() == \"x86_64\"")).to_equal(false)
