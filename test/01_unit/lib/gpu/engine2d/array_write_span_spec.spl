"""
## Purpose and audience
Purpose: Prove that array write_span.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

"""Array write_span bulk copy primitive

@tag: gpu, engine2d, simd, interpreter, array

Unit spec for `arr.write_span(src, dst_off, src_off, count)` — the bulk
in-place array copy on the interpreter's mutating-method channel, added for
doc/08_tracking/bug/engine2d_interpreter_span_kernel_marshalling_perf_gap_2026-08-14.md.

Contract under test:
  * copies src[src_off..src_off+count] into self[dst_off..dst_off+count];
  * returns the count written; count <= 0 is a no-op returning 0;
  * NEVER grows the destination (out-of-range is a loud error, exercised by
    the shared kernel `array_write_span` in
    src/compiler_rust/compiler/src/interpreter_method/collections.rs; a spec
    cannot catch interpreter errors, so here we assert the non-error side:
    lengths are invariant across every valid call);
  * overlap semantics are memmove-style: a same-array copy reads the
    PRE-copy contents (src is snapshotted at argument evaluation);
  * mutation propagates through nested `mut` array params, like `push`.
"""

use std.spec.{describe, it, expect}

fn _nested_write(mut dst: any, src: [u32], dst_off: i64, src_off: i64, count: i64):
    # One frame deeper on purpose: proves the mutating-method channel relays
    # the bulk write through a nested `mut` param, exactly like `arr.push`.
    dst.write_span(src, dst_off, src_off, count)

use std.spec.step

describe "array write_span":
    it "copies a span and returns the count written":
        step("Verify: copies a span and returns the count written")
        # @req: REQ-LIB-GPU-001
        var dst: [u32] = [0, 0, 0, 0, 0, 0]
        val src: [u32] = [10, 20, 30, 40]
        val n = dst.write_span(src, 1, 1, 3)
        expect(n).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(dst[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst[1]).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(dst[2]).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(dst[3]).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(dst[4]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "treats count <= 0 as a no-op returning 0":
        step("Verify: treats count <= 0 as a no-op returning 0")
        var dst: [u32] = [1, 2, 3]
        val src: [u32] = [9, 9, 9]
        expect(dst.write_span(src, 0, 0, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst.write_span(src, 0, 0, -5)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(dst[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(dst[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "never grows the destination on a full-range write":
        step("Verify: never grows the destination on a full-range write")
        var dst: [u32] = [7, 7, 7, 7]
        val src: [u32] = [1, 2, 3, 4]
        val n = dst.write_span(src, 0, 0, 4)
        expect(n).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(dst.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(dst[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(dst[3]).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "memmove semantics: overlapping forward same-array copy reads pre-copy contents":
        step("Verify: memmove semantics: overlapping forward same-array copy reads pre-copy contents")
        # a.write_span(a, 2, 0, 3): dst range [2..5) overlaps src range [0..3).
        # memmove-style: result uses the ORIGINAL a[0..3] = 1,2,3.
        var a: [u32] = [1, 2, 3, 4, 5]
        val n = a.write_span(a, 2, 0, 3)
        expect(n).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(a[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(a[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(a[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(a[3]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(a[4]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "memmove semantics: overlapping backward same-array copy reads pre-copy contents":
        step("Verify: memmove semantics: overlapping backward same-array copy reads pre-copy contents")
        var a: [u32] = [1, 2, 3, 4, 5]
        val n = a.write_span(a, 0, 2, 3)
        expect(n).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(a[0]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(a[1]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(a[2]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(a[3]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(a[4]).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "propagates through a nested mut param like push does":
        step("Verify: propagates through a nested mut param like push does")
        var dst: [u32] = [0, 0, 0, 0]
        val src: [u32] = [5, 6, 7, 8]
        _nested_write(dst, src, 1, 0, 2)
        expect(dst[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst[1]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(dst[2]).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(dst[3]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dst.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
