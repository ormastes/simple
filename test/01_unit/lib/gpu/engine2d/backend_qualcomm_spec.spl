"""Qualcomm Adreno Backend Pure Contract Specification

@tag: gpu, engine2d, qualcomm, adreno, vulkan
Exercises only host-independent target selection, profile, tuning, and
constructor state. Actual Vulkan initialization, render, present, and readback
remain unavailable on this non-Adreno host and are deliberately not registered
as passing examples. No measured coverage percentage is claimed.
"""
use std.spec.step

use std.spec.step

use std.spec.{describe, it, expect}
use std.gpu.engine2d.backend_qualcomm.{
    QualcommBackend,
    qualcomm_preferred_workgroup_size,
    qualcomm_subgroup_size,
    qualcomm_supports_target,
    qualcomm_vulkan_profile_key,
    qualcomm_preferred_backend_for_target
}

describe "QualcommBackend pure target contract":
    it "AC-5: exposes the Adreno workgroup and subgroup tuning":
        expect(qualcomm_preferred_workgroup_size()).to_equal(64)
        expect(qualcomm_subgroup_size()).to_equal(64)

    it "AC-7: accepts the three supported ARM target profiles":
        expect(qualcomm_supports_target("arm64", 64)).to_equal(true)
        expect(qualcomm_supports_target("arm32", 32)).to_equal(true)
        expect(qualcomm_supports_target("arm-mixed", 3264)).to_equal(true)

    it "AC-7: rejects mismatched and unrelated target profiles":
        expect(qualcomm_supports_target("arm64", 32)).to_equal(false)
        expect(qualcomm_supports_target("x86_64", 64)).to_equal(false)
        expect(qualcomm_supports_target("", 0)).to_equal(false)

    it "AC-7: assigns stable Vulkan profile keys":
        expect(qualcomm_vulkan_profile_key("arm64", 64)).to_equal("qualcomm-adreno:vulkan:arm64")
        expect(qualcomm_vulkan_profile_key("arm32", 32)).to_equal("qualcomm-adreno:vulkan:arm32")
        expect(qualcomm_vulkan_profile_key("arm-mixed", 3264)).to_equal("qualcomm-adreno:vulkan:arm32+arm64")
        expect(qualcomm_vulkan_profile_key("x86_64", 64)).to_equal("qualcomm-adreno:vulkan:unsupported")

    it "AC-5: selects Vulkan only for a supported Qualcomm target":
        expect(qualcomm_preferred_backend_for_target("arm64", 64)).to_equal("vulkan")
        expect(qualcomm_preferred_backend_for_target("x86_64", 64)).to_equal("cpu")

    it "AC-5: preserves target metadata before device initialization":
        val arm64 = QualcommBackend.create_for_target("arm64", 64)
        val mixed = QualcommBackend.create_for_target("arm-mixed", 3264)

        expect(arm64.target_arch()).to_equal("arm64")
        expect(arm64.target_bits()).to_equal(64)
        expect(arm64.mixed_32_64()).to_equal(false)
        expect(arm64.target_profile()).to_equal("qualcomm-adreno:vulkan:arm64")
        expect(arm64.width()).to_equal(0)
        expect(arm64.height()).to_equal(0)
        expect(mixed.mixed_32_64()).to_equal(true)

# UNAVAILABLE ON THIS HOST: Adreno Vulkan init/render/present/readback requires
# a Qualcomm device and is intentionally absent instead of represented by a
# green environment-gate assertion.
