use std.spec
use std.io_runtime.{file_read_text_at_nullable}
use std.nogc_async_mut.sosix.host_facade.{sosix_file_read_text_at_nullable}

val fixture = "test/fixtures/io_runtime/ranged_read_ascii.txt"

describe "std.io_runtime ranged reads through SoSix":
    it "reads the exact requested range through both facade names":
        expect(file_read_text_at_nullable(fixture, 2, 3)).to_equal(Some("cde"))
        expect(sosix_file_read_text_at_nullable(fixture, 2, 3)).to_equal(Some("cde"))

    it "rejects a negative offset":
        expect(file_read_text_at_nullable(fixture, -1, 3)).to_be_nil()

    it "returns nil for a missing file with a positive read size":
        expect(file_read_text_at_nullable("test/fixtures/io_runtime/absent-ranged-read-file", 0, 1)).to_be_nil()

    it "returns empty text for a zero-size read of the fixture":
        expect(file_read_text_at_nullable(fixture, 0, 0)).to_equal(Some(""))
