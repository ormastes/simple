# @cover src/lib/nogc_sync_mut/io/process_ops.spl 10%
"""Regression coverage for incremental live process-output relay."""

use std.nogc_sync_mut.io.process_ops.{process_run_timeout_live}

describe "library process_run_timeout_live relay offset":
    it "captures several output bursts exactly once":
        val script = "i=0; while [ $i -lt 3 ]; do echo burst-$i; i=$((i+1)); sleep 0.6; done; printf tail"
        val (stdout, _stderr, rc) = process_run_timeout_live("/bin/sh", ["-c", script], 10000)

        expect(rc).to_equal(0)
        expect(stdout).to_equal("burst-0\nburst-1\nburst-2\ntail")
