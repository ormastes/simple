# AUTHORED_NOT_RUN. Production grammar only, never native/readiness authority.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.host_identity_ssh_projection_types_v1.host_identity_ssh_projection_roles_valid_v1

describe "Paired identity SSH projection leaf roles v1":
    it "requires a real key role and a separate known-hosts role":
        val key = "a".repeat(64) + ".key"
        val hosts = "b".repeat(64) + ".hosts"
        val profile = "c".repeat(64) + ".profile"
        expect(host_identity_ssh_projection_roles_valid_v1(key, hosts)).to_equal(true)
        expect(host_identity_ssh_projection_roles_valid_v1(hosts, key)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1(profile, hosts)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1(key, profile)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1(key, key)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1(hosts, hosts)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1("A".repeat(64) + ".key", hosts)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1("../" + key, hosts)).to_equal(false)
        expect(host_identity_ssh_projection_roles_valid_v1(key, hosts + "\u0000")).to_equal(false)
