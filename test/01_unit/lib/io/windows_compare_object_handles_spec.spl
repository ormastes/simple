# Windows object-identity comparison used by the service-logon namespace owner.
use std.spec.*
use std.nogc_sync_mut.io.windows_service_logon_namespace_abi_v1.{rt_win_compare_object_handles}

describe "Windows object handle identity comparison":
    it "reports the same kernel object as identical":
        step("Compare the current-process pseudo handle with itself")
        expect(rt_win_compare_object_handles(-1, -1) != 0).to_equal(true)

    it "reports different kernel objects as not identical":
        step("Compare the current-process pseudo handle with the current-thread pseudo handle")
        expect(rt_win_compare_object_handles(-1, -2) != 0).to_equal(false)
