# Pure scalar decoding only; native child progression has a separate fixture.
use std.spec.{describe, it, expect, fail}
use std.common.process.launch_progress_v6.{ProcessLaunchProgressV6, process_launch_progress_decode_v6}

describe "deferred launch scalar progress V6":
    it "decodes each actual native progress state":
        match process_launch_progress_decode_v6(0):
            case Ok(value): expect(value).to_equal(ProcessLaunchProgressV6.NoChild)
            case Err(reason): fail(reason)
        match process_launch_progress_decode_v6(1):
            case Ok(value): expect(value).to_equal(ProcessLaunchProgressV6.LaunchPending)
            case Err(reason): fail(reason)
        match process_launch_progress_decode_v6(2):
            case Ok(value): expect(value).to_equal(ProcessLaunchProgressV6.ObservationAvailable)
            case Err(reason): fail(reason)

    it "refuses unsupported errors and unknown progress without fabricating observation":
        for code in [-95, -1, 3, 6, 9223372036854775807]:
            match process_launch_progress_decode_v6(code):
                case Ok(_): fail("unknown progress accepted: {code}")
                case Err(reason): expect(reason).to_contain("unknown deferred launch progress")
