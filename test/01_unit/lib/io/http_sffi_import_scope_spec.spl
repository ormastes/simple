use std.spec.*
use std.nogc_sync_mut.io.http_sffi.{HttpMethod, method_to_string}
use std.nogc_sync_mut.http_server.router.{Router}

describe "HTTP SFFI names remain import scoped":
    it "keeps the SFFI HTTP enum distinct while the server router is loaded":
        val router = Router.new()
        expect(router.routes.len()).to_equal(0)
        expect(method_to_string(HttpMethod.GET)).to_equal("GET")
