"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/io/string_helpers_char_code_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/string_helpers_char_code_spec.md
# doc-path: doc/03_plan/sys_test/string_helpers_char_code_spec.md
# doc-path: doc/04_architecture/string_helpers_char_code_spec.md
# doc-path: doc/05_design/string_helpers_char_code_spec_oracles.md
# @manual: primary

use std.spec
use std.spec.step
use lib.gc_async_mut.io.string_helpers.{char_code as gc_char_code}
use lib.nogc_async_mut.io.string_helpers.{char_code as nogc_char_code}
use lib.nogc_sync_mut.io.string_helpers.{char_code as sync_char_code}


describe "io string helpers char_code":
    """As a library user I ask char_code for the numeric code of a
    character so I can classify text without hand-rolled tables; it must
    return the real code point, never a silently parsed 0."""

    it "returns real ASCII codes for letters in all three tiers":
        # @req REQ-SSPEC-UNIT
        # @req REQ-SSPEC-UNIT
        # @req: LIB-IO-CHARCODE-001
        # @manual_section: 3.2
        step("query a non-digit letter in each tier")
        expect(gc_char_code("A")).to_equal(65)
        expect(nogc_char_code("z")).to_equal(122)
        expect(sync_char_code(" ")).to_equal(32)

    it "returns the code point of a digit, not its parsed value":
        # @req: LIB-IO-CHARCODE-002
        # @manual_section: 3.2
        step("query digit '7' — code 55, not the number 7")
        expect(gc_char_code("7")).to_equal(55)
        expect(nogc_char_code("0")).to_equal(48)
        expect(sync_char_code("9")).to_equal(57)

    it "returns 0 only for the empty string":
        # @req: LIB-IO-CHARCODE-003
        # @manual_section: 3.2
        step("empty input yields the documented 0 sentinel")
        expect(gc_char_code("")).to_equal(0)
