"""REQ-001 IEEE inputs must retain their sign before collection key handling."""
use std.spec.*
use std.common.binary_io.{f64_from_bits, f64_to_bits, f32_from_bits, f32_to_bits}

describe "IEEE reconstruction preserves the sign of zero":
    it "retains both f64 zero bit patterns":
        expect(f64_to_bits(f64_from_bits(0x8000000000000000u64))).to_equal(0x8000000000000000u64)
        expect(f64_to_bits(f64_from_bits(0u64))).to_equal(0u64)

    it "retains both f32 zero bit patterns":
        expect(f32_to_bits(f32_from_bits(0x80000000u32))).to_equal(0x80000000u32)
        expect(f32_to_bits(f32_from_bits(0u32))).to_equal(0u32)

    it "keeps negative finite subnormal and infinite values":
        for bits in [0xBFF8000000000000u64, 0x8000000000000001u64, 0xFFF0000000000000u64]:
            expect(f64_to_bits(f64_from_bits(bits))).to_equal(bits)
        for bits in [0xBFC00000u32, 0x80000001u32, 0xFF800000u32]:
            expect(f32_to_bits(f32_from_bits(bits))).to_equal(bits)

    it "preserves NaN classification without promising a payload":
        val wide = f64_from_bits(0xFFF8000000000001u64)
        val narrow = f32_from_bits(0xFFC00001u32)
        expect(wide != wide).to_equal(true)
        expect(narrow != narrow).to_equal(true)
