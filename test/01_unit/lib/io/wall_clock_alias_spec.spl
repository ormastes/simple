# @req REQ-CLI-004
# @cover src/lib/nogc_sync_mut/sffi/time.spl
use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.sffi.time.{time_now_ms, timestamp_now}

describe "Native wall-clock aliases":
    it "should return Unix milliseconds rather than monotonic uptime":
        step("Read the production microsecond clock and millisecond alias")
        val micros = time_now_unix_micros()
        val millis = time_now_ms()
        step("Check units and wall-clock epoch with scheduling tolerance")
        expect(micros).to_be_greater_than(1000000000000000)
        expect(millis).to_be_greater_than(1000000000000)
        val delta = millis - micros / 1000
        expect(delta).to_be_greater_than(-30001)
        expect(delta).to_be_less_than(30001)

    it "should return microseconds from the same wall-clock provider":
        step("Read the canonical clock and timestamp alias")
        val micros = time_now_unix_micros()
        val timestamp = timestamp_now()
        step("Check timestamp units with scheduling tolerance")
        expect(timestamp).to_be_greater_than(1000000000000000)
        val delta = timestamp - micros
        expect(delta).to_be_greater_than(-30000001)
        expect(delta).to_be_less_than(30000001)
