# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

# Regression: `use std.io.{time_now_unix_micros}` (devhub), `{timestamp_now}`
# and `{rt_debug_set_active}` (mcp) failed native HIR lowering
# ("module std.io has no exported item ...").
#
# `std.io` resolves to the facade src/lib/nogc_async_mut/io.spl, which listed
# the time helpers on a bare `export` line with nothing binding them in that
# module (no `use`, no package-sibling declaration). The interpreter tolerated
# the unbound export; the compiler's export table correctly did not. The fix
# re-exports them from their concrete owner with `export use`.
#
# The structural rows pin the facade shape (they are what the native build
# reads); the runtime row proves the import still works under the interpreter.

use std.spec.step
use std.io.{time_now_unix_micros}

extern fn rt_file_read_text(path: text) -> text

fn facade_source() -> text:
    rt_file_read_text("src/lib/nogc_async_mut/io.spl") ?? ""

describe "std.io re-exports the time helpers through a bound export":
    # @manual scenario evidence

    it "binds the time and debug helpers with export use, not a bare export":
        # @req REQ-SSPEC-UNIT
        step("facade re-exports time helpers from the sync owner")
        val src = facade_source()
        expect(src.contains(r"export use std.nogc_sync_mut.io.{time_now_unix_micros, current_time_unix, current_time_ms, time_now_nanos, time_now_micros}")).to_equal(true)
        expect(src.contains(r"export use std.nogc_sync_mut.io.time_ops.{timestamp_now}")).to_equal(true)
        expect(src.contains(r"export use std.nogc_sync_mut.io.debug_stubs.{rt_debug_set_active,")).to_equal(true)
        expect(src.contains("\nexport time_now_unix_micros")).to_equal(false)
        expect(src.contains("\nexport timestamp_now")).to_equal(false)

    it "resolves time_now_unix_micros through std.io":
        # @req REQ-SSPEC-UNIT
        step("time_now_unix_micros through std.io returns a plausible epoch")
        expect(time_now_unix_micros() > 1000000000000000).to_equal(true)
