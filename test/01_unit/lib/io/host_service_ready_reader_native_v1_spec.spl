# SOURCE_AUTHORED_NOT_RUN. Requires externally installed real V6-only service,
# protected setup/ready pair and public pin; missing prerequisites FAIL, no skip.
use std.spec.*
use std.io_runtime.env_get_nullable
use std.nogc_sync_mut.io.host_service_ready_reader_v1.*

var ready_fixture_owner_v1: Option<HostServiceReadyReaderV1> = nil

fn ready_fixture_close_v1() -> bool:
    for turn in 0..16:
        if ready_fixture_owner_v1.is_none(): return true
        val closed = host_service_ready_reader_close_v1(ready_fixture_owner_v1.unwrap())
        ready_fixture_owner_v1 = closed.owner
        if closed.completed: return true
    false

describe "Actual protected Windows V6 ready-reader prerequisite specimen":
    after_each:
        expect(ready_fixture_close_v1()).to_equal(true)

    it "retains actual setup/ready files and invalidates copied reader aliases on close":
        step("Require actual canonical-thread Windows and separately provisioned V6-only files")
        if ready_fixture_owner_v1.is_some() and not ready_fixture_close_v1():
            panic("prior actual ready-reader cleanup remains retained")
        val path = env_get_nullable("SIMPLE_HOST_AUTH_SETUP_PATH")
        val pin = env_get_nullable("SIMPLE_HOST_AUTH_SETUP_DIGEST")
        val host_root = env_get_nullable("SIMPLE_HOST_AUTH_DEPLOYMENT_ROOT")
        val authority = env_get_nullable("SIMPLE_HOST_AUTH_AUTHORITY_DIGEST")
        if path.is_none() or pin.is_none() or host_root.is_none() or authority.is_none(): panic("required actual V6 protected ready/pin setup unavailable")
        val opened = host_service_ready_reader_open_v1(path.unwrap(), pin.unwrap(), host_root.unwrap(), authority.unwrap())
        ready_fixture_owner_v1 = opened.owner
        if not opened.ready or opened.error != "" or opened.owner.is_none():
            panic("actual V6 ready-reader prerequisite admission failed")
        val owner = opened.owner.unwrap()
        val alias = owner
        expect(host_service_ready_reader_current_v1(owner).is_ok()).to_equal(true)
        expect(host_service_ready_reader_endpoint_v1(owner).unwrap().starts_with("127.0.0.1:")).to_equal(true)
        expect(host_service_ready_reader_incarnation_v1(owner).unwrap().byte_len()).to_equal(32)
        expect(host_service_ready_reader_expected_service_pid_v1(owner).unwrap()).to_be_greater_than(0)
        expect(host_service_ready_reader_host_lease_digest_v1(owner).unwrap().byte_len()).to_equal(64)
        expect(host_service_ready_reader_ready_digest_v1(owner).unwrap().byte_len()).to_equal(64)
        val closing = host_service_ready_reader_close_v1(owner)
        ready_fixture_owner_v1 = closing.owner
        expect(closing.completed).to_equal(false)
        expect(host_service_ready_reader_current_v1(alias).is_err()).to_equal(true)
        expect(ready_fixture_close_v1()).to_equal(true)
        expect(host_service_ready_reader_close_v1(alias).completed).to_equal(true)
