use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_ACTION_RELEASE,
    WINDOW_MOD_ALT,
    WINDOW_MOD_CTRL,
    WINDOW_MOD_SHIFT,
}
use common.io.window_shortcut.{
    WINDOW_WM_SHORTCUT_NONE,
    WINDOW_WM_SHORTCUT_FOCUS_NEXT,
    WINDOW_WM_SHORTCUT_CLOSE,
    WINDOW_WM_SHORTCUT_MINIMIZE,
    WINDOW_WM_SHORTCUT_TOGGLE_MAXIMIZE,
    window_wm_shortcut_action,
}

fn main() -> i64:
    if window_wm_shortcut_action(
        258, WINDOW_ACTION_PRESS, WINDOW_MOD_ALT
    ) != WINDOW_WM_SHORTCUT_FOCUS_NEXT:
        return 1
    if window_wm_shortcut_action(
        293, WINDOW_ACTION_PRESS, WINDOW_MOD_ALT
    ) != WINDOW_WM_SHORTCUT_CLOSE:
        return 2
    if window_wm_shortcut_action(
        77, WINDOW_ACTION_PRESS, WINDOW_MOD_CTRL
    ) != WINDOW_WM_SHORTCUT_MINIMIZE:
        return 3
    if window_wm_shortcut_action(
        77, WINDOW_ACTION_PRESS, WINDOW_MOD_CTRL | WINDOW_MOD_SHIFT
    ) != WINDOW_WM_SHORTCUT_TOGGLE_MAXIMIZE:
        return 4
    if window_wm_shortcut_action(
        258, WINDOW_ACTION_RELEASE, WINDOW_MOD_ALT
    ) != WINDOW_WM_SHORTCUT_NONE:
        return 5
    if window_wm_shortcut_action(
        67, WINDOW_ACTION_PRESS, WINDOW_MOD_CTRL
    ) != WINDOW_WM_SHORTCUT_NONE:
        return 6
    0
