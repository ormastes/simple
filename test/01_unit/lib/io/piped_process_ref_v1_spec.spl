# @req PPIPE-01 PPIPE-02 PPIPE-03 PPIPE-04 PPIPE-05
# AWAITING_VERIFICATION. Native child must be supplied; no success-by-skip.
use std.spec.{describe, it, expect}
use test.fixtures.piped_process_ref_v1.{piped_ref_invalid_case, piped_ref_input_case, piped_ref_live_stream_case}

describe "canonical generation-bearing piped process reference":
    it "rejects zero or missing generations before every stream/lifecycle/validation operation":
        expect(piped_ref_invalid_case()).to_equal(0)

    it "rejects relative executables, NUL and excess argv before spawning":
        expect(piped_ref_input_case()).to_equal(0)

    it "rejects stale references while retaining exact UTF-8 stream progress, EOF, validation and lifecycle status":
        expect(piped_ref_live_stream_case()).to_equal(0)
