# SOURCE_AUTHORED_NOT_RUN. This explicit administrative specimen would publish
# an immutable private setup file if run. No provisioning occurred in this lane.
use std.spec.*
use std.io_runtime.env_get_nullable
use std.nogc_sync_mut.io.host_service_auth_setup_v1.*

var setup_fixture_owner_v1: Option<HostServiceAuthSetupOwnerV1> = nil

fn setup_fixture_close_v1() -> bool:
    for turn in 0..32:
        if setup_fixture_owner_v1.is_none(): return true
        val closed = host_service_auth_setup_close_v1(setup_fixture_owner_v1.unwrap())
        setup_fixture_owner_v1 = closed.owner
    setup_fixture_owner_v1.is_none()

describe "Actual Windows V6 entropy setup administrative prerequisite specimen":
    after_each:
        expect(setup_fixture_close_v1()).to_equal(true)

    it "publishes a fresh private setup through actual protected roots and OS entropy":
        step("Require an operator-selected fresh target under an existing protected Windows parent")
        if setup_fixture_owner_v1.is_some() and not setup_fixture_close_v1():
            panic("prior actual setup-publication cleanup remains retained")
        val path = env_get_nullable("SIMPLE_HOST_AUTH_FRESH_SETUP_TARGET")
        if path.is_none(): panic("required explicit fresh protected setup target unavailable")
        var turn = host_service_auth_setup_open_v1(path.unwrap())
        setup_fixture_owner_v1 = turn.owner
        if turn.owner.is_none(): panic("actual protected setup owner prerequisite unavailable")
        val alias = turn.owner.unwrap()
        for phase in 0..64:
            if setup_fixture_owner_v1.is_some():
                turn = host_service_auth_setup_step_v1(setup_fixture_owner_v1.unwrap())
                setup_fixture_owner_v1 = turn.owner
        expect(turn.completed).to_equal(true)
        expect(turn.setup_publication).to_equal("published")
        expect(turn.cleanup_pending).to_equal(false)
        expect(turn.error).to_equal("")
        expect(turn.publication_uid.byte_len()).to_equal(32)
        expect(turn.setup_digest.byte_len()).to_equal(64)
        expect(turn.owner.is_none()).to_equal(true)
        val retired = host_service_auth_setup_step_v1(alias)
        expect(retired.owner.is_none()).to_equal(true)
        expect(retired.setup_digest).to_equal(turn.setup_digest)
        expect(retired.setup_publication).to_equal("published")
        # Published setup is intentionally not deleted/replaced by test cleanup.
