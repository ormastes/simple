"""ConPTY geometry and UTF8 stream contracts. Native OS execution is a separate gate."""
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.windows_pty_codec.{windows_pty_size_valid_v1, windows_pty_coord_v1, windows_pty_decode_v1}

describe "Windows ConPTY wire values":
    it "packs columns in COORD.X and rows in COORD.Y":
        expect(windows_pty_coord_v1(24, 80)).to_equal(1572944u32)
    it "rejects nonpositive, signed-SHORT overflow and excessive screen area":
        expect(windows_pty_size_valid_v1(0, 80)).to_equal(false)
        expect(windows_pty_size_valid_v1(24, -1)).to_equal(false)
        expect(windows_pty_size_valid_v1(24, 32768)).to_equal(false)
        expect(windows_pty_size_valid_v1(1000, 1000)).to_equal(false)
        expect(windows_pty_size_valid_v1(24, 80)).to_equal(true)
    it "preserves ASCII controls and embedded NUL":
        val decoded = windows_pty_decode_v1([], [65u8, 0u8, 27u8, 91u8, 109u8, 13u8, 10u8], false)
        expect(decoded.value).to_equal("A\0\x1b[m\r\n")
        expect(decoded.tail.len()).to_equal(0)
    it "retains a three-byte scalar split after its first octet":
        val first = windows_pty_decode_v1([], [65u8, 237u8], false)
        expect(first.value).to_equal("A")
        expect(first.tail).to_equal([237u8])
        val second = windows_pty_decode_v1(first.tail, [149u8, 156u8], false)
        expect(second.value).to_equal("한")
        expect(second.tail.len()).to_equal(0)
    it "retains a four-byte scalar across three OS reads":
        val first = windows_pty_decode_v1([], [240u8, 159u8], false)
        expect(first.value).to_equal("")
        val second = windows_pty_decode_v1(first.tail, [152u8], false)
        expect(second.value).to_equal("")
        expect(second.tail).to_equal([240u8, 159u8, 152u8])
        val third = windows_pty_decode_v1(second.tail, [128u8, 66u8], false)
        expect(third.value).to_equal("😀B")
        expect(third.tail.len()).to_equal(0)
    it "keeps a partial scalar through an empty poll":
        val decoded = windows_pty_decode_v1([226u8, 130u8], [], false)
        expect(decoded.value).to_equal("")
        expect(decoded.tail).to_equal([226u8, 130u8])
    it "flushes an incomplete scalar as a replacement on EOF":
        val decoded = windows_pty_decode_v1([226u8, 130u8], [], true)
        expect(decoded.value).to_equal("�")
        expect(decoded.tail.len()).to_equal(0)
    it "rejects overlong and surrogate UTF8 rather than returning malformed text":
        expect(windows_pty_decode_v1([], [192u8, 128u8], false).value).to_equal("�")
        expect(windows_pty_decode_v1([], [237u8, 160u8, 128u8], false).value).to_equal("�")
