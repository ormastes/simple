# @cover src/lib/nogc_sync_mut/io/hosted_volatile_u8_device.spl 100%

use std.spec
use std.concurrent.thread.{thread_spawn}
use std.io.hosted_volatile_u8_device.{
    HOSTED_VOLATILE_U8_CAPACITY,
    hosted_volatile_u8_owner,
    hosted_volatile_u8_current_owner_admitted,
    hosted_volatile_u8_admit,
    hosted_volatile_u8_reset,
    hosted_volatile_u8_register,
    hosted_volatile_u8_unregister,
    hosted_volatile_u8_try_read,
    hosted_volatile_u8_read,
    hosted_volatile_u8_write
}

fn rejected_on_non_creator_thread() -> i64:
    var rejected = 0
    if not hosted_volatile_u8_current_owner_admitted():
        rejected = rejected + 1
    if not hosted_volatile_u8_reset():
        rejected = rejected + 1
    if not hosted_volatile_u8_register(24576, 1):
        rejected = rejected + 1
    if hosted_volatile_u8_try_read(4096) == -1:
        rejected = rejected + 1
    if not hosted_volatile_u8_write(4096, 1):
        rejected = rejected + 1
    if not hosted_volatile_u8_unregister(4096):
        rejected = rejected + 1
    rejected

describe "HostedVolatileU8DeviceOwner":
    it "enforces creator-thread ownership and covers every state decision":
        val initial = hosted_volatile_u8_owner()
        expect(initial.admitted).to_equal(false)
        expect(initial.current_thread_owned).to_equal(false)
        expect(initial.generation).to_equal(0)
        expect(initial.live_addresses).to_equal(0)
        expect(initial.capacity).to_equal(HOSTED_VOLATILE_U8_CAPACITY)

        expect(hosted_volatile_u8_try_read(4096)).to_equal(-1)
        expect(hosted_volatile_u8_write(4096, 1)).to_equal(false)
        expect(hosted_volatile_u8_admit()).to_equal(true)
        expect(hosted_volatile_u8_admit()).to_equal(false)
        expect(hosted_volatile_u8_owner().generation).to_equal(1)

        val other_thread = thread_spawn(\: rejected_on_non_creator_thread())
        expect(other_thread.join()).to_equal(6)
        expect(hosted_volatile_u8_owner().generation).to_equal(1)

        expect(hosted_volatile_u8_register(0, 1)).to_equal(false)
        expect(hosted_volatile_u8_register(4096, 511)).to_equal(true)
        expect(hosted_volatile_u8_owner().generation).to_equal(2)
        expect(hosted_volatile_u8_register(4096, 2)).to_equal(false)
        expect(hosted_volatile_u8_owner().generation).to_equal(2)
        expect(hosted_volatile_u8_register(12288, 17)).to_equal(true)
        expect(hosted_volatile_u8_register(16384, 33)).to_equal(true)
        expect(hosted_volatile_u8_owner().generation).to_equal(4)

        expect(hosted_volatile_u8_try_read(8192)).to_equal(-1)
        expect(hosted_volatile_u8_read(4096)).to_equal(255)
        expect(hosted_volatile_u8_write(8192, 1)).to_equal(false)
        expect(hosted_volatile_u8_owner().generation).to_equal(4)
        expect(hosted_volatile_u8_write(4096, 258)).to_equal(true)
        expect(hosted_volatile_u8_read(4096)).to_equal(2)
        expect(hosted_volatile_u8_owner().generation).to_equal(5)

        expect(hosted_volatile_u8_unregister(8192)).to_equal(false)
        expect(hosted_volatile_u8_owner().generation).to_equal(5)
        expect(hosted_volatile_u8_unregister(12288)).to_equal(true)
        expect(hosted_volatile_u8_owner().generation).to_equal(6)
        # Removing the middle entry exercises both retained sides and proves
        # address/value pairing survives compaction.
        expect(hosted_volatile_u8_read(4096)).to_equal(2)
        expect(hosted_volatile_u8_read(12288)).to_equal(-1)
        expect(hosted_volatile_u8_read(16384)).to_equal(33)

        expect(hosted_volatile_u8_reset()).to_equal(true)
        expect(hosted_volatile_u8_owner().generation).to_equal(7)
        var i = 0
        while i < HOSTED_VOLATILE_U8_CAPACITY:
            val registered = hosted_volatile_u8_register(32768 + i, i)
            expect(registered).to_equal(true)
            i = i + 1
        val capacity_rejected = hosted_volatile_u8_register(65536, 1)
        expect(capacity_rejected).to_equal(false)
        val full = hosted_volatile_u8_owner()
        expect(full.admitted).to_equal(true)
        expect(full.current_thread_owned).to_equal(true)
        expect(full.generation).to_equal(7 + HOSTED_VOLATILE_U8_CAPACITY)
        expect(full.live_addresses).to_equal(HOSTED_VOLATILE_U8_CAPACITY)
