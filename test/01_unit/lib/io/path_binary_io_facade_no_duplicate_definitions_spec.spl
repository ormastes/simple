# Regression guard: the nogc_async_mut path/binary_io facades must not DEFINE
# functions, only re-export.
#
# Bug: doc/08_tracking/bug/duplicate_public_symbols_differing_return_types_jit_misdispatch_2026-08-09.md
# Before 2026-08-10, src/lib/nogc_async_mut/path.spl was a byte-identical copy
# of src/lib/nogc_sync_mut/path.spl (28 duplicate-named public fns) and
# src/lib/nogc_async_mut/binary_io.spl a semantically identical copy of
# src/lib/common/binary_io.spl (17 fns + 5 duplicate types). Under
# co-compilation every duplicate-named public fn collides in the seed JIT's
# bare-name symbol table; identical signatures (Class B) let one body silently
# win with no diagnostic. Converting the async variants to pure `export use`
# facades removed 43 collision warnings (345 -> 302 on the
# SIMPLE_DIAG_SAME_SIGNATURE_COLLISION=1 action_key_spec harness).
# A facade must never re-grow a local body.

use std.nogc_sync_mut.io.file_ops.{file_read, file_exists}
use std.nogc_async_mut.path.{basename, is_absolute}
use std.nogc_async_mut.binary_io.{ByteOrder}

val path_facade = "src/lib/nogc_async_mut/path.spl"
val binio_facade = "src/lib/nogc_async_mut/binary_io.spl"

fn local_definition_lines(src: text) -> [text]:
    var hits: [text] = []
    for line in src.split("\n"):
        val t = line.trim()
        if (t.starts_with("fn ") or t.starts_with("pub fn ") or
            t.starts_with("extern fn ") or t.starts_with("class ") or
            t.starts_with("struct ") or t.starts_with("enum ")):
            hits.push(line)
    hits

describe "nogc_async_mut path/binary_io facades stay definition-free":
    it "path facade re-exports the canonical implementation (behavioral wire-through)":
        # @req: facade re-export surface remains importable and functional
        expect file_exists(path_facade) == true
        expect basename("/a/b/c.txt") == "c.txt"
        assert_true is_absolute("/tmp")
        assert_false is_absolute("rel/path")

    it "path facade contains zero local definitions - only export use":
        # @req: no duplicate-named fn bodies may re-grow in the path facade
        val src = file_read(path_facade)
        expect src.len() > 0
        val hits = local_definition_lines(src)
        if hits.len() > 0:
            print "path facade regrew local definitions (Class B collision risk):"
            for h in hits:
                print "  {h}"
        expect hits.len() == 0
        expect src.contains("export use std.nogc_sync_mut.path.") == true

    it "binary_io facade contains zero local definitions - only export use":
        # @req: no duplicate fn/class bodies may re-grow in the binary_io facade
        val src = file_read(binio_facade)
        expect src.len() > 0
        val hits = local_definition_lines(src)
        if hits.len() > 0:
            print "binary_io facade regrew local definitions (Class B collision risk):"
            for h in hits:
                print "  {h}"
        expect hits.len() == 0
        expect src.contains("export use std.common.binary_io.") == true

    it "scan control: canonical binary_io still has real definitions":
        # @req: absence check paired with a control that MUST hit
        val src = file_read("src/lib/common/binary_io.spl")
        val hits = local_definition_lines(src)
        expect hits.len() > 10
