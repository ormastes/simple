# Runnable check for the rt_io_file_* family backing std.nogc_sync_mut.io.file.
#
# Replaces test/01_unit/lib/io/file_seek_openmode_native_check.spl (lane
# FFI-ENUM), which asserted seek positions on this same path while all 13
# rt_io_file_* externs were undefined and RT_KEEP-stubbed to return zero. That
# test could only ever fail, and it would have failed against the zero-stubs
# rather than the FFI enum-crossing defect it named. See
# doc/08_tracking/bug/rt_io_file_family_undefined_stubbed_silent_data_loss_2026-08-05.md
#
# 2026-08-05 follow-up: this file's FIRST version (landed in the same commit
# as the native fix, 31c6287af87) called `wh.write_text(...)` expecting an
# `Ok(n)` byte count and `rh.read_text(3)` expecting a sized read -- neither
# matches the real `file.spl` surface (`write_text` returns `Result<(), IoError>`;
# `read_text` takes no size argument). It also never actually ran, which is
# why that mismatch went unnoticed. Rewritten below to call only methods that
# exist on `FileHandle`/`File`. Separately, `rt_io_file_*` was never wired
# into the Rust seed's INTERPRETER extern registry (only the native runtime
# symbols existed), so interpret mode failed closed with `unknown extern
# function: rt_io_file_delete` even after the native fix landed -- see
# doc/08_tracking/bug/rt_io_file_family_interpreter_fixed_native_still_stubbed_2026-08-05.md
# for the current status (interpreter fixed, native/JIT still stubbed pending
# a runtime redeploy -- do not treat a JIT/native "PASS" as evidence until
# that doc's "Next step" section is done).
#
# Scoring rule: read the VERDICT line, never the exit status. `bin/simple
# compile` has been observed to emit a non-executable artifact and exit 0.
#
# This defect is ENGINE-DIVERGENT, so a single-engine green is not evidence:
#   - JIT/native   : the stubs made File.write return Ok while writing nothing.
#   - interpret    : fails closed with `unknown extern function: rt_io_file_*`.
# Run BOTH:
#   SIMPLE_EXECUTION_MODE=interpret bin/simple run <this file>
#   bin/simple native-build --source src/lib --entry <this file> -o /tmp/rt_io_file_check && /tmp/rt_io_file_check
# Note SIMPLE_EXECUTION_MODE=native is NOT a mode; anything but `interpret`
# silently means JIT.
#
# 2026-08-05 status: interpret mode PASSES (verified end to end: real disk
# write, exists check, content read-back, 3 distinct SeekFrom positions, a
# post-seek partial read, and size()). JIT/native mode still FAILS -- confirmed
# via strace that `rt_io_file_open` under `bin/simple run` makes ZERO openat
# syscalls for the target path, i.e. it never reaches the real implementation;
# it is still served by the RT_KEEP stub in `stubs.rs` because the *deployed*
# `target/bootstrap/libsimple_runtime.a` predates these symbols. See
# doc/08_tracking/bug/rt_io_file_family_interpreter_fixed_native_still_stubbed_2026-08-05.md.
# This is a KNOWN, deliberately-ordered gap (redeploy must precede dropping
# the RT_KEEP entries) -- do not read a JIT/native failure here as a new bug.
#
# NO NESTED `fn` IN THIS FILE, DELIBERATELY. A nested function here raised
# `unresolved external symbol 'fail'` and dropped the whole module to the
# interpreter, which then died on the unknown extern — so the JIT arm never
# executed and the probe reported a semantic error instead of a VERDICT line.
# Keep every check inline so this file actually reaches the engine under test.

use std.nogc_sync_mut.io.file.{FileHandle, File}
use std.common.io.types.{FileMode, SeekFrom}

fn main() -> i64:
    val path = "/tmp/rt_io_file_family_check.txt"
    var failures = 0

    File.delete(path)

    # --- write must actually reach the disk ---------------------------------
    val wh = match FileHandle.open(path, FileMode.WriteOnly):
        case Ok(h): h
        case Err(e):
            print("VERDICT: FAIL rt_io_file family broken (open WriteOnly failed)")
            return 1
    match wh.write_text("0123456789"):
        case Ok(_): pass
        case Err(e):
            print("FAIL write_text failed: {e.to_string()}")
            failures = failures + 1
    match wh.close():
        case Ok(_): pass
        case Err(e):
            print("FAIL close after write failed: {e.to_string()}")
            failures = failures + 1

    # The zero-stub signature: Ok returned, nothing on disk.
    if not File.exists(path):
        print("FAIL file absent after a successful write (zero-stub signature)")
        failures = failures + 1

    # --- content must be exactly what was written ---------------------------
    val content = match File.read(path):
        case Ok(t): t
        case Err(e): "<err>"
    if content != "0123456789":
        print("FAIL read back '{content}', expected '0123456789'")
        failures = failures + 1

    # --- seek must report real absolute positions ---------------------------
    val rh = match FileHandle.open(path, FileMode.ReadOnly):
        case Ok(h): h
        case Err(e):
            print("VERDICT: FAIL rt_io_file family broken (open ReadOnly failed)")
            return 1

    val p_start = match rh.seek(SeekFrom.Start(3)):
        case Ok(p): p
        case Err(e): -1
    if p_start != 3:
        print("FAIL SeekFrom.Start(3) gave {p_start}, expected 3")
        failures = failures + 1

    val p_cur = match rh.seek(SeekFrom.Current(2)):
        case Ok(p): p
        case Err(e): -1
    if p_cur != 5:
        print("FAIL SeekFrom.Current(2) from 3 gave {p_cur}, expected 5")
        failures = failures + 1

    val p_end = match rh.seek(SeekFrom.End(-1)):
        case Ok(p): p
        case Err(e): -1
    if p_end != 9:
        print("FAIL SeekFrom.End(-1) gave {p_end}, expected 9")
        failures = failures + 1

    # A family of all-zero stubs makes every whence indistinguishable.
    if p_start == p_cur or p_cur == p_end:
        print("FAIL distinct SeekFrom variants produced identical positions")
        failures = failures + 1

    # --- read after seek must return the sought bytes, not '' ---------------
    val p_four = match rh.seek(SeekFrom.Start(4)):
        case Ok(p): p
        case Err(e): -1
    val chunk = match rh.read(3):
        case Ok(bytes): bytes
        case Err(e): []
    val expected: [u8] = [52, 53, 54]  # "456"
    if p_four == 4 and chunk != expected:
        print("FAIL read(3) at offset 4 gave {chunk.len()} bytes, expected '456'")
        failures = failures + 1

    # --- size must be real ---------------------------------------------------
    val sz = match rh.size():
        case Ok(s): s
        case Err(e): -1
    if sz != 10:
        print("FAIL size() gave {sz}, expected 10")
        failures = failures + 1

    match rh.close():
        case Ok(_): pass
        case Err(e):
            print("FAIL close after read failed: {e.to_string()}")
            failures = failures + 1
    File.delete(path)

    if failures == 0:
        print("VERDICT: PASS rt_io_file family works")
        return 0
    print("VERDICT: FAIL rt_io_file family broken ({failures} failures)")
    1
