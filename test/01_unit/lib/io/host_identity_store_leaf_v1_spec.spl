# AUTHORED_NOT_RUN. These call the production grammar helper, never fabricate
# an owner or claim native filesystem/authentication coverage.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.host_identity_store_abi_v1.host_identity_leaf_valid_v1

describe "Identity-store digest and distinct leaf roles v1":
    it "admits all three roles for the same lowercase SHA256-shaped stem":
        val stem = "0123456789abcdef".repeat(4)
        val key = stem + ".key"
        val hosts = stem + ".hosts"
        val profile = stem + ".profile"
        expect(host_identity_leaf_valid_v1(key)).to_equal(true)
        expect(host_identity_leaf_valid_v1(hosts)).to_equal(true)
        expect(host_identity_leaf_valid_v1(profile)).to_equal(true)
        expect(key == hosts).to_equal(false)
        expect(key == profile).to_equal(false)
        expect(hosts == profile).to_equal(false)

    it "rejects malformed stems and ambiguous or traversing role spellings":
        val stem = "a".repeat(64)
        for leaf in ["A".repeat(64) + ".profile", "g".repeat(64) + ".profile",
                "a".repeat(63) + ".profile", "a".repeat(65) + ".profile",
                stem + ".PROFILE", stem + ".profile.key", stem + ".key.profile",
                stem + ".profile/../" + stem + ".key", "../" + stem + ".hosts",
                stem + ".profile.", stem + ".profile ", stem + ".profile\u0000",
                stem + ".sdn", stem + ".json", stem + ".key:stream", stem + ".hosts\\leaf"]:
            expect(host_identity_leaf_valid_v1(leaf)).to_equal(false)
