use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "runtime alias semantic preservation":
    it "keeps raw owner functions as exact one-call runtime aliases":
        val env_owner = file_read("src/lib/nogc_sync_mut/io/env_ops.spl")
        val process_owner = file_read("src/lib/nogc_sync_mut/io/process_ops.spl")

        expect(env_owner).to_contain("fn cwd_raw() -> text:\n    rt_env_cwd()")
        expect(env_owner).to_contain("fn home_raw() -> text:\n    rt_env_home()")
        expect(process_owner).to_contain("fn process_run_raw(cmd: text, args: [text]) -> (text, text, i64):\n    rt_process_run(cmd, args)")
        expect(process_owner).to_contain("fn process_run_timeout_raw(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):\n    rt_process_run_timeout(cmd, args, timeout_ms)")

    it "keeps ffi and sffi compatibility wrappers on the raw owner path":
        val sffi = file_read("src/lib/nogc_sync_mut/sffi/system.spl")
        val ffi = file_read("src/lib/nogc_sync_mut/ffi/system.spl")

        expect(sffi).to_contain("cwd_raw as io_cwd_raw")
        expect(sffi).to_contain("process_run_raw as io_process_run_raw")
        expect(sffi).to_contain("process_run_timeout_raw as io_process_run_timeout_raw")
        expect(sffi.contains("extern fn rt_env_cwd")).to_equal(false)
        expect(sffi.contains("extern fn rt_process_run(cmd")).to_equal(false)
        expect(sffi.contains("extern fn rt_process_run_timeout")).to_equal(false)

        expect(ffi).to_contain("cwd_raw as io_cwd_raw")
        expect(ffi).to_contain("process_run_raw as io_process_run_raw")
        expect(ffi).to_contain("process_run_timeout_raw as io_process_run_timeout_raw")
        expect(ffi.contains("extern fn rt_env_cwd")).to_equal(false)
        expect(ffi.contains("extern fn rt_process_run(cmd")).to_equal(false)
        expect(ffi.contains("extern fn rt_process_run_timeout")).to_equal(false)

    it "keeps snpm current-directory failure behavior without a leaf runtime alias":
        val init = file_read("src/app/snpm/cmd_init.spl")
        val link = file_read("src/app/snpm/cmd_link.spl")
        val main = file_read("src/app/snpm/main.spl")

        expect(init).to_contain(r"use std.nogc_sync_mut.io.env_ops.{cwd_raw}")
        expect(init).to_contain("val current_dir = cwd_raw() ?? \"\"")
        expect(link).to_contain(r"use std.nogc_sync_mut.io.env_ops.{cwd_raw}")
        expect(link).to_contain("val current_dir = cwd_raw() ?? \"\"")
        expect(init.contains("rt_get_cwd")).to_equal(false)
        expect(link.contains("rt_get_cwd")).to_equal(false)
        expect(main.contains("rt_get_cwd")).to_equal(false)

    it "keeps the remaining reviewed aliases on exact canonical owners":
        val receipt = file_read("src/lib/common/perf/render_perf_receipt_v2.spl")
        val env_gate = file_read("src/lib/common/test_env_gate.spl")
        val db_checker = file_read("src/lib/nogc_sync_mut/database/checker.spl")
        val db_todo = file_read("src/lib/nogc_sync_mut/database/todo.spl")
        val daemon_types = file_read("src/lib/nogc_sync_mut/daemon_sdk/types.spl")

        expect(receipt).to_contain(r"use std.nogc_sync_mut.io.env_ops.{env_get}")
        expect(env_gate).to_contain(r"use std.nogc_sync_mut.io.env_ops.{env_get}")
        expect(db_checker).to_contain(r"use std.nogc_sync_mut.io.file_ops.{file_exists}")
        expect(db_todo).to_contain(r"use std.nogc_sync_mut.io.file_ops.{file_exists}")
        expect(daemon_types).to_contain(r"use std.nogc_sync_mut.io.sysinfo_ops.{getpid}")
        expect(daemon_types).to_contain(r"use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}")
        expect(receipt.contains("extern fn rt_env_get")).to_equal(false)
        expect(env_gate.contains("extern fn rt_env_get")).to_equal(false)
        expect(db_checker.contains("extern fn rt_file_exists")).to_equal(false)
        expect(db_todo.contains("extern fn rt_file_exists")).to_equal(false)
        expect(daemon_types.contains("extern fn rt_getpid")).to_equal(false)
        expect(daemon_types.contains("extern fn rt_time_now_unix_micros")).to_equal(false)

    it "breaks broad io_runtime edges in the owner and reviewed alias batch":
        val process_owner = file_read("src/lib/nogc_sync_mut/io/process_ops.spl")
        val process_governor = file_read("src/lib/nogc_sync_mut/io/process_governor.spl")
        val time_owner = file_read("src/lib/nogc_sync_mut/io/time_ops.spl")
        val sffi = file_read("src/lib/nogc_sync_mut/sffi/system.spl")
        val ffi = file_read("src/lib/nogc_sync_mut/ffi/system.spl")
        val daemon_types = file_read("src/lib/nogc_sync_mut/daemon_sdk/types.spl")
        val db_checker = file_read("src/lib/nogc_sync_mut/database/checker.spl")
        val db_todo = file_read("src/lib/nogc_sync_mut/database/todo.spl")
        val snpm_main = file_read("src/app/snpm/main.spl")
        val snpm_init = file_read("src/app/snpm/cmd_init.spl")
        val snpm_link = file_read("src/app/snpm/cmd_link.spl")

        expect(process_owner.contains("use std.io_runtime")).to_equal(false)
        expect(process_owner).to_contain(r"use std.nogc_sync_mut.io.env_ops.{env_get}")
        expect(process_owner).to_contain(r"use std.nogc_sync_mut.io.file_ops.{file_delete, file_exists}")
        expect(process_owner).to_contain(r"use std.nogc_sync_mut.io.sysinfo_ops.{getpid}")
        expect(process_owner).to_contain(r"use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}")
        expect(process_governor.contains("use std.io_runtime")).to_equal(false)
        expect(process_governor).to_contain(r"use std.nogc_sync_mut.io.env_ops.{env_get}")
        expect(time_owner).to_contain("fn thread_sleep_raw(milliseconds: i64):\n    rt_thread_sleep(milliseconds)")

        expect(sffi.contains("use std.io_runtime")).to_equal(false)
        expect(ffi.contains("use std.io_runtime")).to_equal(false)
        expect(daemon_types.contains("use std.io_runtime")).to_equal(false)
        expect(db_checker.contains("use std.io_runtime")).to_equal(false)
        expect(db_todo.contains("use std.io_runtime")).to_equal(false)
        expect(snpm_main.contains("use std.io_runtime")).to_equal(false)
        expect(snpm_init.contains("use std.io_runtime")).to_equal(false)
        expect(snpm_link.contains("use std.io_runtime")).to_equal(false)

        expect(snpm_main).to_contain(r"use std.nogc_sync_mut.ffi.cli.{cli_get_args as cli_get_args_raw}")
        expect(snpm_main).to_contain("val all_args = cli_get_args_raw() ?? []")
