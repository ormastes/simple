# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# Test: serial proxy baud guard
# Feature: IO-SERIAL-PROXY - Malformed baud values parse to zero (rejected by main)
# @cover lib/nogc_sync_mut/io/serial_proxy.spl

use std.spec.step

use std.nogc_sync_mut.io.serial_baud.{parse_baud_or_zero}

describe "serial proxy baud guard":
    # @manual scenario evidence
    context "valid baud values":
        it "parses decimal baud rates":
            # @req REQ-SSPEC-LIB
            step("call parse_baud_or_zero with valid rates")
            expect(parse_baud_or_zero("9600")).to_equal(9600)
            expect(parse_baud_or_zero("115200")).to_equal(115200)
            expect(parse_baud_or_zero(" 57600 ")).to_equal(57600)

    context "malformed baud values":
        it "returns zero for non-numeric, negative, empty input":
            # @req REQ-SSPEC-LIB
            step("call parse_baud_or_zero with malformed values")
            expect(parse_baud_or_zero("abc")).to_equal(0)
            expect(parse_baud_or_zero("-5")).to_equal(0)
            expect(parse_baud_or_zero("")).to_equal(0)
            expect(parse_baud_or_zero("   ")).to_equal(0)
            expect(parse_baud_or_zero("115k2")).to_equal(0)
