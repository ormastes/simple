# Regression (hello native-build "SCV-E-ADMISSION: directory-alias-inventory-invalid",
# 2026-10-30): std.{nogc_sync_mut,nogc_async_mut}.file_system.dir_ops each
# defined a mock `dir_exists(path: text) -> bool` answering true for every
# absolute path. The JIT function registry is keyed on NAME ALONE and identical
# signatures raise no collision warning, so compile admission's alias inventory
# (app.compiler_entrypoint.inventory_aliases) reached the mock, saw every
# untracked child as a directory, and failed closed. The dir_ops modules now
# re-export the one real io_runtime implementation.
use std.spec
use std.nogc_sync_mut.file_system.dir_ops.{dir_exists as sync_fs_dir_exists}
use std.nogc_async_mut.file_system.dir_ops.{dir_exists as async_fs_dir_exists}
use std.nogc_sync_mut.io_runtime.{dir_exists as io_dir_exists}

describe "file_system.dir_ops.dir_exists":
    it "reports a missing absolute path as absent":
        expect(sync_fs_dir_exists("/nonexistent/simple_dir_exists_spec_zz")).to_equal(false)
        expect(async_fs_dir_exists("/nonexistent/simple_dir_exists_spec_zz")).to_equal(false)
        expect(io_dir_exists("/nonexistent/simple_dir_exists_spec_zz")).to_equal(false)

    it "reports an existing directory as present":
        expect(sync_fs_dir_exists("/tmp")).to_equal(true)
        expect(async_fs_dir_exists("/tmp")).to_equal(true)
