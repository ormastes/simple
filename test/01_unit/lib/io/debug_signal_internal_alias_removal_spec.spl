use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

fn old_runtime_name(suffix: text) -> text:
    "rt_" + suffix

fn expect_internal_names_only(path: text):
    val source = file_read(path)
    expect(source.contains(old_runtime_name("signal_handler_available"))).to_equal(false)
    expect(source.contains(old_runtime_name("signal_handler_install"))).to_equal(false)
    expect(source.contains(old_runtime_name("atexit_register"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_set_active"))).to_equal(false)
    expect(source.contains(old_runtime_name("hook_enable_debugging"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_add_breakpoint_at"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_remove_breakpoint_at"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_continue_exec"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_pause_exec"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_set_step_mode_val"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_stack_trace_lines"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_local_vars"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_get_current_file"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_get_current_line"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_run_file_debug"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_add_breakpoint_rich"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_add_function_breakpoint"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_set_breakpoint_enabled"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_get_breakpoint_info"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_list_breakpoints"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_get_pending_condition"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_report_condition_result"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_select_frame"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_get_selected_frame"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_frame_locals"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_get_source_lines"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_add_watch"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_remove_watch"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_list_watches"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_set_variable"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_eval_expression"))).to_equal(false)
    expect(source.contains(old_runtime_name("debug_terminate"))).to_equal(false)
    expect(source.contains(old_runtime_name("fault_set_stack_overflow_detection"))).to_equal(false)
    expect(source.contains(old_runtime_name("fault_set_max_recursion_depth"))).to_equal(false)
    expect(source.contains(old_runtime_name("fault_set_timeout"))).to_equal(false)
    expect(source.contains(old_runtime_name("fault_set_execution_limit"))).to_equal(false)
    expect(source.contains(old_runtime_name("vulkan_is_available"))).to_equal(false)

describe "debug and signal internal compatibility alias removal":
    it "publishes semantic names through every production facade":
        expect_internal_names_only("src/lib/nogc_sync_mut/io/debug_stubs.spl")
        expect_internal_names_only("src/lib/nogc_sync_mut/io/signal_stubs.spl")
        expect_internal_names_only("src/lib/nogc_sync_mut/io/signal_handlers.spl")
        expect_internal_names_only("src/lib/nogc_sync_mut/io/__init__.spl")
        expect_internal_names_only("src/lib/nogc_sync_mut/io.spl")
        expect_internal_names_only("src/lib/nogc_async_mut/io/debug_stubs.spl")
        expect_internal_names_only("src/lib/nogc_async_mut/io/signal_stubs.spl")
        expect_internal_names_only("src/lib/nogc_async_mut/io/__init__.spl")
        expect_internal_names_only("src/lib/nogc_async_mut/io.spl")
        expect_internal_names_only("src/app/io/mod.spl")
        expect_internal_names_only("src/app/io/__init__.spl")
        expect_internal_names_only("src/app/interpreter/main.spl")
        expect_internal_names_only("src/app/mcp/debug_handlers.spl")
        expect_internal_names_only("src/app/mcp/debug_tools.spl")
        expect_internal_names_only("src/lib/nogc_async_mut/mcp/debug_handlers.spl")
        expect_internal_names_only("src/lib/nogc_async_mut/mcp/debug_tools.spl")

    it "retains same-spelled native ABI declarations":
        val debug_abi = file_read("src/lib/nogc_sync_mut/sffi/debug.spl")
        val fault_abi = file_read("src/lib/nogc_sync_mut/sffi/fault.spl")
        val vulkan_abi = file_read("src/lib/nogc_sync_mut/io/vulkan_sffi.spl")
        expect(debug_abi).to_contain("extern fn " + old_runtime_name("debug_set_active"))
        expect(fault_abi).to_contain("extern fn " + old_runtime_name("fault_set_timeout"))
        expect(vulkan_abi).to_contain("extern fn " + old_runtime_name("vulkan_is_available"))

    it "keeps delegation behavior behind semantic debug names":
        val owner = file_read("src/lib/nogc_sync_mut/io/debug_stubs.spl")
        expect(owner).to_contain("fn debug_stub_set_active(active: bool):\n    ds_set_active(active)")
        expect(owner).to_contain("fn debug_stub_add_breakpoint_at(bp_file: text, bp_line: i64) -> i64:\n    ds_add_breakpoint(bp_file, bp_line)")
        expect(owner).to_contain("fn debug_stub_terminate():\n    ds_terminate()")
