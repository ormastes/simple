# Bug: builtin_dict_set_silent_insert_audit_2026-07-31
# `.set(k, v)` on a builtin Dict must insert (it silently dropped the write under native codegen).
# Interpreter lane proves the contract; the native lane is the open verification.

use std.spec

describe "builtin Dict .set()":
    it "inserts a new key readable via contains_key and index":
        var d: Dict<text, text> = {}
        d.set("k", "v")
        expect(d.contains_key("k")).to_equal(true)
        expect(d["k"]).to_equal("v")

    it "overwrites an existing key without growing":
        var d: Dict<text, i64> = {}
        d.set("a", 1)
        d.set("a", 2)
        expect(d.len()).to_equal(1)
        expect(d["a"]).to_equal(2)

    it "matches bracket assignment":
        var a: Dict<text, i64> = {}
        var b: Dict<text, i64> = {}
        a.set("x", 5)
        b["x"] = 5
        expect(a.keys().len()).to_equal(b.keys().len())
