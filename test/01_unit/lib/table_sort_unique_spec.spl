"""
# Table sort_by / unique regression specification

**Category:** Stdlib
**Status:** Implemented

Reproduce spec for the C14 defects in `src/lib/nogc_sync_mut/src/table.spl`:
- `Table.sort_by` called `[i64].sorted_by`, a method that does not exist, so
  every sort raised `method `sorted_by` not found on type `array``.
- `Column.unique` referenced an unimported class `Set`, so it raised
  `unknown class Set`.
Both failed before the fix and pass after it.
"""
use std.nogc_sync_mut.src.table.*

describe "Table.sort_by":
    context "ascending":
        it "orders rows by the key column and carries the other columns along", fn():
            var data = {}
            data["x"] = [3, 1, 2]
            data["y"] = [30, 10, 20]
            val sorted = Table.from_dict(data).sort_by("x", true)
            expect(sorted.get("x").as_ints()).to_equal([1, 2, 3])
            expect(sorted.get("y").as_ints()).to_equal([10, 20, 30])

    context "descending":
        it "orders rows from largest to smallest", fn():
            var data = {}
            data["x"] = [1, 4, 2, 3]
            data["y"] = [10, 40, 20, 30]
            val sorted = Table.from_dict(data).sort_by("x", false)
            expect(sorted.get("x").as_ints()).to_equal([4, 3, 2, 1])
            expect(sorted.get("y").as_ints()).to_equal([40, 30, 20, 10])

    context "already ordered input":
        it "is a no-op on sorted data", fn():
            var data = {}
            data["x"] = [1, 2, 3]
            val sorted = Table.from_dict(data).sort_by("x", true)
            expect(sorted.get("x").as_ints()).to_equal([1, 2, 3])

    context "duplicate keys":
        it "keeps every row", fn():
            var data = {}
            data["x"] = [2, 1, 2, 1]
            val sorted = Table.from_dict(data).sort_by("x", true)
            expect(sorted.get("x").as_ints()).to_equal([1, 1, 2, 2])

describe "Column.unique":
    context "with duplicates":
        it "keeps only the first occurrence of each value, in order", fn():
            val uniq = Column.from_ints("x", [1, 2, 2, 3, 3, 3]).unique()
            expect(uniq.len()).to_equal(3)
            expect(uniq.as_ints()).to_equal([1, 2, 3])

    context "with no duplicates":
        it "returns every element unchanged", fn():
            val uniq = Column.from_ints("x", [5, 4, 6]).unique()
            expect(uniq.as_ints()).to_equal([5, 4, 6])

    context "on text columns":
        it "deduplicates text values", fn():
            val uniq = Column.from_texts("t", ["a", "b", "a", "c", "b"]).unique()
            expect(uniq.len()).to_equal(3)
