# @req: REQ-LIB-EXTENDED-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/extended/gpu_buffer_integration_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/gpu_buffer_integration.md
# doc-path: doc/03_plan/sys_test/gpu_buffer_integration.md
# doc-path: doc/04_architecture/gpu_buffer_integration.md
# doc-path: doc/05_design/gpu_buffer_integration.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-LIB-EXTENDED-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "function calls and closure values":
        step("Verify: function calls and closure values")
        # @req: REQ-LIB-EXTENDED-001
        fn add(a: i64, b: i64) -> i64: a + b
        expect(add(2, 3)).to_equal(5)  # oracle: 2+3
        val f = fn(x: i64) -> i64: x * x
        expect(f(4)).to_equal(16)  # oracle: 4 squared

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-LIB-EXTENDED-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "gzip compression roundtrip":
        step("Verify: gzip compression roundtrip")
        # @req: REQ-LIB-EXTENDED-001
        use std.common.compress.gzip.{gzip_compress, gzip_decompress}
        val data = "hello hello hello hello".bytes()
        val packed = gzip_compress(data)
        expect(packed.len() > 0).to_equal(true)
        expect(gzip_decompress(packed)).to_equal(data)
        expect(packed.len() < data.len())  # oracle: repeated text compresses

    it "dict literal access":
        step("Verify: dict literal access")
        # @req: REQ-LIB-EXTENDED-001
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-LIB-EXTENDED-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10
