"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/extended/memory_gc_integration_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/memory_gc_integration.md
# doc-path: doc/03_plan/sys_test/memory_gc_integration.md
# doc-path: doc/04_architecture/memory_gc_integration.md
# doc-path: doc/05_design/memory_gc_integration.md

describe "LIB Extended Test":
    it "lib function 1":
        check(true)
    it "lib function 2":
        check(1 + 1 == 2)
    it "lib function 3":
        val x = [1,2,3]
        check(x.len() == 3)
    it "lib function 4":
        val d = {"k": "v"}
        check(d["k"] == "v")
    it "error path 1":
        var err = nil
        check(err == nil)
    it "error path 2":
        val opt = nil
        check(not opt.?)
    it "branch 1":
        if true: check(true)
        else: check(false)
    it "branch 2":
        match Some(1):
            Some(x): check(x == 1)
            nil: check(false)
    it "loop 1":
        var c = 0
        for i in 0..5: c = c + 1
        check(c == 5)
    it "loop 2":
        var s = 0
        for i in [1,2,3]: s = s + i
        check(s == 6)
    it "edge empty":
        check([].len() == 0)
    it "edge single":
        check([1].len() == 1)
    it "complex":
        val arr = [1,2,3,4,5]
        var evens = []
        for x in arr: if x % 2 == 0: evens = evens.append(x)
        check(evens.len() == 2)
    it "integration":
        val input = "test"
        val stage1 = input + "_1"
        val stage2 = stage1 + "_2"
        check(stage2 == "test_1_2")
    it "validation":
        check(5 > 0)
        check(-1 < 0)
        check(0 == 0)
