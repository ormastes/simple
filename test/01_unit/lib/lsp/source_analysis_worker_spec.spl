# Authored controls; native tests require an admitted compiled full CLI.
# SOURCE_ANALYSIS_TEST_BINARY and SOURCE_ANALYSIS_TEST_WORKSPACE are mandatory.
use std.spec.{describe, it, expect, step}
use std.env.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.common.diagnostics.source_analysis_v1.*
use std.common.diagnostics.source_analysis_wire_v1.{source_analysis_environment_decode_v1, source_analysis_request_encode_v1}
use std.nogc_sync_mut.lsp.lsp_analysis_worker.*
use std.nogc_sync_mut.lsp.lsp_analysis_worker_artifact.{source_analysis_artifact_create_v1, source_analysis_artifact_open_v1, source_analysis_artifact_reserve_v1}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.nogc_sync_mut.io_runtime.{file_rename}
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove, dir_is_real_no_follow}
use std.nogc_sync_mut.io.process_inspection_v1.{OwnedCwdPinV4}
use std.nogc_sync_mut.lsp.lsp_analysis_receipt.{lsp_analysis_response_decode_v1, lsp_analysis_receipt_matches_v1}
use std.common.process.observation_v4.*

fn analysis_worker_packet_v1() -> ProcessObservationPacketV4:
    var binding: [u8] = []
    for index in 0..32: binding.push(index as u8)
    val wire = ProcessObservationWireV4(
        words: [4, 2, 64, 2, 1, 2, 3, 4, 7, 255, 0, 0, 0, 3, 0, 42, 0,
            0, 0, 10, 11, 12, 13, 14, 15, 20, 20, 30, 0, 0, 0, 0, 1, 1,
            1, 1, 3, 4, 7, 0, 2, 100, 1, 0, 0, 1, 1, 1, 1, 2, 0, 2, 2,
            2, 2, 0, 1, 1, 1, 1, 2, 1, 32, 0],
        stdout: [111u8, 107u8], stderr: [33u8], binding: binding)
    decode_process_observation_v4(wire).unwrap().packet

fn analysis_worker_drain_v1(initial: SourceAnalysisWorkerV1) -> SourceAnalysisWorkerEventV1:
    var worker = initial
    var event = worker.tick(0)
    var count = 0
    while event.cleanup_pending and count < 1600:
        event = worker.tick(25)
        count = count + 1
    if event.cleanup_pending:
        event = worker.cancel()
        var cleanup = 0
        while event.cleanup_pending and cleanup < 160:
            event = worker.tick(25)
            cleanup = cleanup + 1
    expect(event.cleanup_pending).to_equal(false)
    event

fn analysis_worker_fixture_v1() -> (text, text):
    val binary = env_get("SOURCE_ANALYSIS_TEST_BINARY") ?? ""
    val root = env_get("SOURCE_ANALYSIS_TEST_WORKSPACE") ?? ""
    expect(binary != "").to_equal(true)
    expect(root != "").to_equal(true)
    (binary, root)

describe "snapshot process worker owner":
    it "transports escaped source snapshots beyond the old stdin ceiling":
        step("Exactly sixteen MiB of newlines survive escaping and private artifact IO")
        val source = "\n".repeat(1048576)
        val digest = sha256_text(source)
        var documents: [SourceAnalysisDocumentV1] = []
        for index in 0..16:
            val path = "/workspace/document" + index.to_text() + ".spl"
            documents.push(SourceAnalysisDocumentV1(path: path, uri: "file://" + path,
                version: 1, source: source, digest: digest))
        val environment = SourceAnalysisEnvironmentV1(executable_digest: "e".repeat(64), compiler_identity: "a".repeat(64),
            target: "", features: [], config_digest: "b".repeat(64))
        val request = SourceAnalysisRequestV1(run_id: "encoded-limit", workspace_root: "/workspace",
            workspace_identity: "workspace", owner_id: "spec", lifetime_generation: 1,
            entry_path: documents[0].path, documents: documents, environment: environment,
            bounds: SourceAnalysisBoundsV1())
        val encoded = source_analysis_request_encode_v1(request)
        expect(encoded.is_ok()).to_equal(true)
        expect(encoded.unwrap().byte_len() > 33554432).to_equal(true)
        var artifact = source_analysis_artifact_create_v1(encoded.unwrap(), "e".repeat(64), "wire").unwrap()
        val read = artifact.request()
        val cleanup = artifact.cleanup()
        expect(cleanup).to_equal(true)
        expect(read.is_ok()).to_equal(true)
        expect(read.unwrap()).to_equal(encoded.unwrap())

    it "retries a real initial pin failure without deleting a replacement directory":
        step("Temporarily move the reserved owner, fail pin, reject a new empty replacement, then restore")
        var artifact = source_analysis_artifact_reserve_v1().unwrap()
        val original = artifact.root
        val held = original + ".held"
        val moved = file_rename(original, held)
        val initial = artifact.admit_initial()
        val pin_reason = artifact.error
        val replacement_created = dir_create(original, false)
        val replacement_cleanup = artifact.cleanup()
        val replacement_survives = dir_is_real_no_follow(original)
        val replacement_removed = if replacement_created: dir_remove(original, false) else: false
        val restored = if moved: file_rename(held, original) else: false
        val cleanup = artifact.cleanup()
        expect(cleanup).to_equal(true)
        expect(moved).to_equal(true)
        expect(initial).to_equal(false)
        expect(pin_reason).to_equal("artifact_initial_pin_failed")
        expect(replacement_created).to_equal(true)
        expect(replacement_cleanup).to_equal(false)
        expect(replacement_survives).to_equal(true)
        expect(replacement_removed).to_equal(true)
        expect(restored).to_equal(true)

    it "recovers from a real closed-pin digest refusal before initial admission":
        step("Use the canonical closed handle error, then retry through a fresh retained pin")
        var artifact = source_analysis_artifact_reserve_v1().unwrap()
        var pin = OwnedCwdPinV4.pin(artifact.root).unwrap()
        val closed = pin.close()
        artifact.pin = Some(pin)
        val initial = artifact.admit_initial()
        val digest_reason = artifact.error
        val released_failed_pin = artifact.pin == nil
        val cleanup = artifact.cleanup()
        expect(cleanup).to_equal(true)
        expect(closed.is_ok() and closed.unwrap()).to_equal(true)
        expect(initial).to_equal(false)
        expect(digest_reason).to_equal("artifact_initial_digest_failed")
        expect(released_failed_pin).to_equal(true)

    it "binds private artifacts to their control and never replaces published responses":
        step("Use real private files, then reject mutation and duplicate publication")
        var parent = source_analysis_artifact_create_v1("immutable request", "e".repeat(64), "artifact-test").unwrap()
        var child = source_analysis_artifact_open_v1(parent.control).unwrap()
        val input = child.request()
        val published = child.publish("response.sdn", "{schema: test}", 4194304)
        val duplicate = child.publish("response.sdn", "{schema: changed}", 4194304)
        val closed = child.close_pins()
        val response = parent.read_leaf("response.sdn", 4194304)
        val changed = file_atomic_write(parent.root + "/request.sdn", "mutated request")
        val rejected = parent.request()
        val cleanup = parent.cleanup()
        expect(cleanup).to_equal(true)
        expect(input.unwrap()).to_equal("immutable request")
        expect(published).to_equal(true)
        expect(duplicate).to_equal(false)
        expect(closed).to_equal(true)
        expect(response.unwrap()).to_equal("{schema: test}")
        expect(changed).to_equal(true)
        expect(rejected.is_err()).to_equal(true)

    it "distinguishes failure receipts without turning zero exit into success":
        step("Classify actual V4 packet fields; this is not native fault injection")
        var packet = analysis_worker_packet_v1()
        packet.exit_code = 9
        expect(source_analysis_worker_failure_v1(packet)).to_equal("exit_failed")
        packet.failure_reason = ProcessObservationFailureReasonV4.ExecutionDeadline
        expect(source_analysis_worker_failure_v1(packet)).to_equal("timed_out")
        packet.failure_reason = ProcessObservationFailureReasonV4.CleanupDeadline
        expect(source_analysis_worker_failure_v1(packet)).to_equal("cleanup_failed")
        packet.failure_reason = ProcessObservationFailureReasonV4.Unknown
        packet.stdout.seen_bytes = packet.stdout.retained_bytes + 1
        expect(source_analysis_worker_failure_v1(packet)).to_equal("truncated")

    it "retains the real process through cancellation and idle retirement":
        step("Launch the native handshake and cancel before consuming output")
        val (binary, root) = analysis_worker_fixture_v1()
        var worker = source_analysis_worker_start_environment_v1(binary, root, "").unwrap()
        val cancelled = worker.cancel()
        val terminal = analysis_worker_drain_v1(worker)
        expect(terminal.status).to_equal("cancelled")
        expect(terminal.wire).to_equal("")

    it "observation preserves the lease until one explicit acknowledgement":
        step("Collect a real frozen handshake twice, certify stdin, then acknowledge once")
        val (binary, root) = analysis_worker_fixture_v1()
        var worker = source_analysis_worker_start_environment_v1(binary, root, "").unwrap()
        expect(worker.lease != nil).to_equal(true)
        var lease = worker.lease.unwrap()
        var observed = lease.collect_observation(0)
        var count = 0
        while observed.is_ok() and observed.unwrap().packet.packet_kind != ProcessObservationPacketKindV4.Frozen and count < 1600:
            observed = lease.collect_observation(25000000)
            count = count + 1
        var repeat_matches = false
        var certified = false
        var duplicate_rejected = false
        if observed.is_ok() and observed.unwrap().packet.packet_kind == ProcessObservationPacketKindV4.Frozen:
            val second = lease.collect_observation(0)
            repeat_matches = second.is_ok() and second.unwrap().binding_digest == observed.unwrap().binding_digest
            val capture = lease.terminal_capture(0)
            certified = capture.is_ok() and capture.unwrap() != nil
            val acknowledged = lease.acknowledge_current()
            if acknowledged.is_ok():
                duplicate_rejected = lease.acknowledge_current().is_err()
                worker.lease = nil
        if worker.lease != nil:
            val cancelled = worker.cancel()
        val retired = analysis_worker_drain_v1(worker)
        expect(repeat_matches).to_equal(true)
        expect(certified).to_equal(true)
        expect(duplicate_rejected).to_equal(true)

    it "uses a real handshake and returns the captured unsaved source receipt":
        step("Obtain compiler identity from the pinned native worker")
        val (binary, root) = analysis_worker_fixture_v1()
        val handshake = analysis_worker_drain_v1(source_analysis_worker_start_environment_v1(binary, root, "").unwrap())
        expect(handshake.status).to_equal("completed")
        val environment = source_analysis_environment_decode_v1(handshake.wire).unwrap()
        val path = root + "/test/fixtures/source_analysis/worker_input.spl"
        val source = "fn main() -> i64:\n    42\n"
        val request = SourceAnalysisRequestV1(run_id: "native-overlay-control", workspace_root: root,
            workspace_identity: sha256_text(root), owner_id: "worker-spec", lifetime_generation: 7,
            entry_path: path, documents: [SourceAnalysisDocumentV1(path: path, uri: "file://" + path,
                version: 9, source: source, digest: sha256_text(source))],
            environment: environment, bounds: SourceAnalysisBoundsV1())
        val terminal = analysis_worker_drain_v1(source_analysis_worker_start_v1(request, binary).unwrap())
        expect(terminal.status).to_equal("completed")
        val response = lsp_analysis_response_decode_v1(terminal.wire).unwrap()
        expect(lsp_analysis_receipt_matches_v1(request, response.receipt)).to_equal(true)
        var saw_overlay = false
        for dependency in response.receipt.dependencies:
            if dependency.path == path:
                saw_overlay = dependency.origin == "overlay" and dependency.digest == sha256_text(source)
        expect(saw_overlay).to_equal(true)

    it "rejects unavailable executables without creating a worker lease":
        step("Missing executable admission fails before a native process exists")
        val result = source_analysis_worker_start_environment_v1("relative-compiler", "/workspace", "")
        expect(result.is_err()).to_equal(true)
