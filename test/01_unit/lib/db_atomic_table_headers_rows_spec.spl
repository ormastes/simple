# Candidate regression for existing Table arity bug; AUTHORED, UNEXECUTED.
# Issue: doc/08_tracking/bug/phase2_matrix_strict_stage2_error_family_2026-10-09.md addendum 6.
use std.spec.step
use std.sdn.{SdnValue}
use std.nogc_async_mut.db_atomic.{extract_table_from_sdn as async_extract}
use std.nogc_sync_mut.db_atomic.{extract_table_from_sdn as sync_extract}

fn expect_table(result: Result<([text], [[text]]), text>, columns: [text], rows: [[text]]):
    expect(result.is_ok()).to_equal(true)
    match result:
        case Ok((actual_columns, actual_rows)):
            expect(actual_columns).to_equal(columns)
            expect(actual_rows).to_equal(rows)
        case Err(message):
            assert(false)

fn expect_error(result: Result<([text], [[text]]), text>, message: text):
    expect(result.is_err()).to_equal(true)
    match result:
        case Err(actual):
            expect(actual).to_equal(message)
        case Ok(value):
            assert(false)

describe "async atomic database canonical Table extraction":
    it "preserves header order and scalar row conversion":
        step("async: preserves header order and scalar row conversion")
        val root = SdnValue.Dict({"todos": SdnValue.Table(["id", "name", "enabled", "empty"], [[SdnValue.Int(7), SdnValue.String("Task 1"), SdnValue.Bool(true), SdnValue.Null], [SdnValue.Int(-2), SdnValue.String("a,b"), SdnValue.Bool(false), SdnValue.String("")]])})
        expect_table(async_extract(root, "todos"), ["id", "name", "enabled", "empty"], [["7", "Task 1", "true", ""], ["-2", "a,b", "false", ""]])

    it "accepts required empty headers":
        step("async: accepts required empty headers")
        val root = SdnValue.Dict({"todos": SdnValue.Table([], [[]])})
        expect_table(async_extract(root, "todos"), [], [[]])

    it "preserves headers in an empty table":
        step("async: preserves headers in an empty table")
        val root = SdnValue.Dict({"todos": SdnValue.Table(["id"], [])})
        expect_table(async_extract(root, "todos"), ["id"], [])

    it "rejects a missing table":
        step("async: rejects a missing table")
        val root = SdnValue.Dict({"other": SdnValue.Table(["id"], [])})
        expect_error(async_extract(root, "todos"), "Table 'todos' not found in SDN")

    it "rejects a named non-table value":
        step("async: rejects a named non-table value")
        val root = SdnValue.Dict({"todos": SdnValue.String("wrong")})
        expect_error(async_extract(root, "todos"), "Value for 'todos' is not a table")

    it "rejects a non-dictionary root":
        step("async: rejects a non-dictionary root")
        val root = SdnValue.Table(["id"], [])
        expect_error(async_extract(root, "todos"), "SDN root must be a dictionary")

describe "sync atomic database canonical Table extraction":
    it "preserves header order and scalar row conversion":
        step("sync: preserves header order and scalar row conversion")
        val root = SdnValue.Dict({"todos": SdnValue.Table(["id", "name", "enabled", "empty"], [[SdnValue.Int(7), SdnValue.String("Task 1"), SdnValue.Bool(true), SdnValue.Null], [SdnValue.Int(-2), SdnValue.String("a,b"), SdnValue.Bool(false), SdnValue.String("")]])})
        expect_table(sync_extract(root, "todos"), ["id", "name", "enabled", "empty"], [["7", "Task 1", "true", ""], ["-2", "a,b", "false", ""]])

    it "accepts required empty headers":
        step("sync: accepts required empty headers")
        val root = SdnValue.Dict({"todos": SdnValue.Table([], [[]])})
        expect_table(sync_extract(root, "todos"), [], [[]])

    it "preserves headers in an empty table":
        step("sync: preserves headers in an empty table")
        val root = SdnValue.Dict({"todos": SdnValue.Table(["id"], [])})
        expect_table(sync_extract(root, "todos"), ["id"], [])

    it "rejects a missing table":
        step("sync: rejects a missing table")
        val root = SdnValue.Dict({"other": SdnValue.Table(["id"], [])})
        expect_error(sync_extract(root, "todos"), "Table 'todos' not found in SDN")

    it "rejects a named non-table value":
        step("sync: rejects a named non-table value")
        val root = SdnValue.Dict({"todos": SdnValue.String("wrong")})
        expect_error(sync_extract(root, "todos"), "Value for 'todos' is not a table")

    it "rejects a non-dictionary root":
        step("sync: rejects a non-dictionary root")
        val root = SdnValue.Table(["id"], [])
        expect_error(sync_extract(root, "todos"), "SDN root must be a dictionary")
