# Regression spec: LeaseManager treats non-positive holder PIDs as dead
# rather than calling rt_process_exists(-1) / 0.

use std.spec.*
use std.io_runtime.{getpid}
use std.service.lease_manager.{
    lease_manager_new, try_acquire_exclusive, active_lease_count
}

describe "LeaseManager non-positive PID guard":
    it "reclaims leases whose holder_pid is 0 or negative immediately":
        var mgr = lease_manager_new()
        val r_neg = try_acquire_exclusive(mgr, -1i64, 30000i64)
        expect(r_neg.ok).to_equal(true)
        expect(active_lease_count(mgr)).to_equal(0i64)

        val r_zero = try_acquire_exclusive(mgr, 0i64, 30000i64)
        expect(r_zero.ok).to_equal(true)
        expect(active_lease_count(mgr)).to_equal(0i64)

        val live = try_acquire_exclusive(mgr, getpid(), 30000i64)
        expect(live.ok).to_equal(true)
        expect(active_lease_count(mgr)).to_equal(1i64)
