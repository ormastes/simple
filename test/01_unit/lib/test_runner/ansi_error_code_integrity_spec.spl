# @req REQ-DOCTEST-DIAGNOSTICS
use std.test_runner.test_runner_files.{strip_ansi}

describe "ANSI stripping preserves ordinary brackets":
    it "keeps diagnostic error codes intact":
        expect(strip_ansi("error[E1002]: missing function")).to_equal("error[E1002]: missing function")

    it "keeps bracketed labels and index expressions intact":
        expect(strip_ansi("[PASS] values[12] x[31m")).to_equal("[PASS] values[12] x[31m")

    it "strips colored diagnostics without consuming their error codes":
        expect(strip_ansi("\u{1b}[31merror[E1002]: missing\u{1b}[0m")).to_equal("error[E1002]: missing")

    it "retains an incomplete escape sequence for inspection":
        expect(strip_ansi("\u{1b}[31")).to_equal("\u{1b}[31")

    it "returns long escape-free output unchanged (fast path for ordinary lines)":
        # Captured test output is stripped line by line on every pass; a
        # 200K-char line with no ESC must come back identical.
        val filler = "0123456789abcdefghij"
        var parts: [text] = []
        var k = 0
        while k < 10000:
            parts.push(filler)
            k = k + 1
        val big = parts.join("")
        expect(big.len()).to_equal(200000)
        expect(strip_ansi(big)).to_equal(big)

    it "leaves CR, TAB and multibyte text untouched when no ESC is present":
        val line = "a\tb\rc 日本語 [E1002]"
        expect(strip_ansi(line)).to_equal(line)

    it "still strips when ESC appears mid-line":
        expect(strip_ansi("x\u{1b}[31my")).to_equal("xy")
