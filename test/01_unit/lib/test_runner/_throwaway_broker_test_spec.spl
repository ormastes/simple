# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""
## Purpose and audience
Purpose: Import-check probe that also exercises the imported module behaviorally
so a broken export fails here, not silently at load time.
Audience: test-runner engineers who own the imported module.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use app.test_daemon.qemu_broker.{QemuBroker, qemu_broker_new}

describe "throwaway broker import check":
    # @manual scenario evidence
    it "loads broker module":
        # @req REQ-SSPEC-LIB
        step("loads broker module")
        # evidence(protocol_json): broker construction invariants below are the complete typed oracle
        val broker = qemu_broker_new(2)
        expect(broker.max_sessions).to_equal(2)
        expect(broker.sessions.len()).to_equal(0)

# --- Merged from the legacy mirror copy (unit:lib/test_runner/_throwaway_broker_test_spec.spl), test dedup phase B: tests this copy lacked.

describe "throwaway broker import check (merged from legacy copy)":
    it "hands out one in-use session on first acquire":
        # @req REQ-TEST-DAEMON-BROKER-001
        # @capture(statistics): broker session status and test-count readback
        step("acquire a session from a freshly constructed broker")
        val broker = qemu_broker_new(2)
        val session = broker.acquire("x86_64", "bin/qemu-system-test")
        expect(session.status).to_equal(QEMU_IN_USE)  # oracle: a fresh acquire must mark the session in use
