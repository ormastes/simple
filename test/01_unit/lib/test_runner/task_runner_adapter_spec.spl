use std.spec
use std.common.crypto.sha256.{sha256_text}
use std.common.task_runner.contracts.{TaskRunnerIdentityV1}
use std.common.task_runner.recovery.{task_runner_execution_mode_v1}
use std.nogc_sync_mut.io.process_completion.{ProcessCompletionV1}
use std.test_runner.task_runner_adapter.{test_task_attempt_v1}

fn identity(case_id: text = "") -> TaskRunnerIdentityV1:
    TaskRunnerIdentityV1(kind: "test", task_id: "fixture", case_id: case_id,
        backend: "contract-fixture", phase: "unit", producer_digest: sha256_text("producer"),
        source_digest: sha256_text("source"), runtime_digest: sha256_text("runtime"),
        toolchain_digest: sha256_text("toolchain"), policy_digest: sha256_text("policy"),
        execution_digest: sha256_text("execution"))

fn completion(exit_code: i64, reaped: bool = true, timeout: bool = false) -> ProcessCompletionV1:
    ProcessCompletionV1(pid: 123, process_generation: 1, exit_code: exit_code,
        signal_number: 0, tree_reaped: reaped, timed_out: timeout, cancelled: timeout,
        stdout_digest: sha256_text("stdout"), stderr_digest: sha256_text("stderr"),
        transport_execution_digest: sha256_text("fixture argv/env/config"))

describe "native test TaskRunner receipt adapter":
    it "keeps a normal assertion failure eligible for grouped execution":
        val row = test_task_attempt_v1(identity(), "group", 1, "grouped", completion(1), "simple-bdd-v1\n2\n1\n").unwrap()
        expect(row.status).to_equal("failed")
        expect(row.exit_code).to_equal(1)
        expect(task_runner_execution_mode_v1(row.identity_digest, [row]).unwrap()).to_equal("grouped")

    it "quarantines an observed native exception before the next attempt":
        val row = test_task_attempt_v1(identity(), "group", 1, "grouped", completion(3221225477), "").unwrap()
        expect(row.status).to_equal("crashed")
        expect(row.result_validated).to_equal(false)
        expect(task_runner_execution_mode_v1(row.identity_digest, [row]).unwrap()).to_equal("isolated")

    it "does not turn a deadline into crash history":
        val row = test_task_attempt_v1(identity(), "group", 1, "grouped", completion(124, timeout: true), "").unwrap()
        expect(row.reason).to_equal("timed-out")
        expect(task_runner_execution_mode_v1(row.identity_digest, [row]).unwrap()).to_equal("grouped")

    it "refuses zero executed tests despite an exit zero":
        expect(test_task_attempt_v1(identity(), "group", 1, "grouped", completion(0), "simple-bdd-v1\n0\n0\n").is_err()).to_equal(true)

    it "refuses fabricated per-case attribution from aggregate totals":
        expect(test_task_attempt_v1(identity("case-one"), "group", 1, "grouped", completion(0), "simple-bdd-v1\n1\n0\n").is_err()).to_equal(true)

    it "refuses a process whose owned tree has not been collected":
        expect(test_task_attempt_v1(identity(), "group", 1, "grouped", completion(0, reaped: false), "simple-bdd-v1\n1\n0\n").is_err()).to_equal(true)

    it "refuses oversized and noncanonical count fields":
        expect(test_task_attempt_v1(identity(), "group", 1, "grouped", completion(0), "simple-bdd-v1\n9223372036854775808\n0\n").is_err()).to_equal(true)
        expect(test_task_attempt_v1(identity(), "group", 1, "grouped", completion(0), "simple-bdd-v1\n01\n0\n").is_err()).to_equal(true)

    it "keeps stale source identities out of the next execution mode":
        val row = test_task_attempt_v1(identity(), "group", 1, "grouped", completion(3221225477), "").unwrap()
        expect(task_runner_execution_mode_v1(sha256_text("changed-source-identity"), [row]).unwrap()).to_equal("grouped")
