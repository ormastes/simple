# @req REQ-MC-012
use std.spec.*
use test.fixtures.test_runner.interpreter_mcdc_verdict.{interpreter_mcdc_verdict_valid}

fn failing_probe_verdict(error: text) -> bool:
    interpreter_mcdc_verdict_valid(0, 1, 0, 0, 0, 0, false, error, "", true, true)

describe "MC/DC interpreter regression evidence oracle":
    it "accepts an authenticated failure of the named authored assertion":
        expect(failing_probe_verdict("test-runner: authenticated BDD assertion failure: Error: Expected MCDC_EXPECTED_SENTINEL_B73, got MCDC_ACTUAL_SENTINEL_A17")).to_equal(true)
    it "rejects infrastructure failures with the same zero-pass one-fail counts":
        for error in ["test-runner: structured BDD evidence unavailable", "--assert-ran: no BDD examples executed", "spawn failed", "semantic: unknown method", "Process limit exceeded", "no parseable pass/fail summary", "invalid MC/DC manifest contract"]:
            expect(failing_probe_verdict(error)).to_equal(false)
    it "rejects an unrelated assertion and an unauthenticated mismatch":
        expect(failing_probe_verdict("test-runner: authenticated BDD assertion failure: Error: Expected other, got MCDC_ACTUAL_SENTINEL_A17")).to_equal(false)
        expect(failing_probe_verdict("✗ mcdc_child_authored_assertion -- expected 1 to equal 2")).to_equal(false)
    it "accepts only one clean passing example without MC/DC evidence":
        expect(interpreter_mcdc_verdict_valid(1, 0, 0, 0, 0, 0, false, "", "", true, false)).to_equal(true)
        expect(interpreter_mcdc_verdict_valid(1, 0, 0, 0, 0, 0, false, "transport failed", "", true, false)).to_equal(false)
        expect(interpreter_mcdc_verdict_valid(1, 0, 0, 0, 0, 0, false, "", "fabricated", true, false)).to_equal(false)
        expect(interpreter_mcdc_verdict_valid(1, 0, 0, 0, 0, 0, true, "", "", true, false)).to_equal(false)
    it "rejects matching verdict counts when the authored execution marker is absent":
        val error = "test-runner: authenticated BDD assertion failure: Error: Expected MCDC_EXPECTED_SENTINEL_B73, got MCDC_ACTUAL_SENTINEL_A17"
        expect(interpreter_mcdc_verdict_valid(0, 1, 0, 0, 0, 0, false, error, "", false, true)).to_equal(false)
        expect(interpreter_mcdc_verdict_valid(1, 0, 0, 0, 0, 0, false, "", "", false, false)).to_equal(false)
