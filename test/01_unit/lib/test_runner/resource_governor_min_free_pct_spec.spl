# Purpose and audience: executable evidence that the governor free-floor override is validated.
use std.spec.step

use std.nogc_sync_mut.test_runner.resource_governor.{governor_min_free_pct_from}

describe "SIMPLE_GOVERNOR_MIN_FREE_PCT parsing":
    it "accepts only a plain number in 0..100, else falls back to 25":
        step("parse overrides")
        expect(governor_min_free_pct_from("abc")).to_equal(25.0)
        expect(governor_min_free_pct_from("150")).to_equal(25.0)
        expect(governor_min_free_pct_from("-5")).to_equal(25.0)
        expect(governor_min_free_pct_from("40")).to_equal(40.0)
