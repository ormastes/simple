# @tag:in-development
# @req REQ-TRC-012 REQ-TRC-013
use std.spec.*
use std.test_runner.test_runner_types.{TestFileResult}
use std.nogc_sync_mut.test_runner.trace_transport.{validate_requested_trace_transport}
use std.common.traceability.case_events.{TraceCaseEvent, encode_trace_case_event}

val EVENTS = "[" + encode_trace_case_event(TraceCaseEvent(case_name: "case", phase: "started", outcome: "not_finished")) + ", " + encode_trace_case_event(TraceCaseEvent(case_name: "case", phase: "finished", outcome: "passed")) + "]"

fn _result(path: text, passed: i64, failed: i64, skipped: i64, pending: i64, cached: bool, trace: text) -> TestFileResult:
    TestFileResult(path: path, passed: passed, failed: failed, skipped: skipped, pending: pending, duration_ms: 1, setup_ms: 0, error: "", timed_out: false, cached: cached, trace_case_events_sdn: trace)

describe "trace-requested runner transport":
    it "rejects zero result rows instead of silently passing the trace lane":
        match validate_requested_trace_transport([]):
            case Ok(_): fail("empty run was accepted")
            case Err(reason): expect(reason).to_contain("no per-file observations")

    it "rejects partial transport when one of two executed files has no events":
        val rows = [_result("test/has_spec.spl", 1, 0, 0, 0, false, EVENTS), _result("test/missing_spec.spl", 1, 0, 0, 0, false, "")]
        match validate_requested_trace_transport(rows):
            case Ok(_): fail("partial trace transport was accepted")
            case Err(reason): expect(reason).to_contain("test/missing_spec.spl")

    it "requires current transport for executed and cached result rows":
        match validate_requested_trace_transport([_result("test/executed_spec.spl", 0, 1, 0, 0, false, EVENTS)]):
            case Ok(_): pass
            case Err(reason): fail("executed transport rejected: {reason}")
        match validate_requested_trace_transport([_result("test/cached_spec.spl", 1, 0, 0, 0, true, EVENTS)]):
            case Ok(_): fail("cached prior transport was accepted as current")
            case Err(reason): expect(reason).to_contain("cached result")

    it "does not require events for skipped or feature-gated files":
        var skipped = _result("test/skipped_spec.spl", 0, 0, 2, 0, false, "")
        var gated = _result("test/gated_spec.spl", 0, 0, 0, 0, false, "")
        gated.feature_gated = "requires unavailable feature"
        match validate_requested_trace_transport([skipped, gated]):
            case Ok(_): pass
            case Err(reason): fail("not-run rows incorrectly required events: {reason}")
