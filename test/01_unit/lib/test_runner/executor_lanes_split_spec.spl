# Proves the composite/GPU lane symbols moved behind test_executor_lanes.spl
# resolve from the new module, after test_runner_execute stopped importing and
# re-exporting test_executor_composite (the eager GPU/JIT -> ~300 compiler
# module closure, ~40-150s seed load).
# See doc/08_tracking/todo/test_runner_execute_composite_gpu_eager_import_cost_2026-08-17.md

use std.test_runner.test_executor_lanes.{qemu_binary_for_arch, qemu_machine_for_arch, extract_arch_from_spec}

describe "test_executor_lanes split":
    it "resolves qemu_binary_for_arch from the lanes module":
        expect(qemu_binary_for_arch("riscv64")).to_equal("qemu-system-riscv64")

    it "resolves qemu_machine_for_arch from the lanes module":
        expect(qemu_machine_for_arch("riscv64").len()).to_be_greater_than(0)

    it "resolves extract_arch_from_spec from the lanes module":
        expect(extract_arch_from_spec("no arch marker here").len()).to_be_greater_than(-1)
