# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.nogc_sync_mut.test_runner.test_executor_parsing.{make_result_from_output}


describe "crashed specs are classified separately from failures and timeouts":
    # @manual scenario evidence
    it "reports a signal death (no exit code) as CRASHED, not a plain failure":
        # @req REQ-SSPEC-LIB
        step("reports a signal death (no exit code) as CRASHED, not a plain failure")
        # Reproducing case: the runtime maps death-by-signal onto exit_code -1,
        # the same sentinel as a timeout. Without the CRASHED branch this read
        # as "Process exited with code -1".
        val r = make_result_from_output("x_spec.spl", "", "fatal runtime error: stack overflow, aborting", -1, 10, 60)
        expect(r.error.starts_with("CRASHED")).to_equal(true)
        expect(r.timed_out).to_equal(false)
        expect(r.failed).to_equal(1)
        expect(r.passed).to_equal(0)

    it "still reports a timeout as timed out, not as a crash":
        # @req REQ-SSPEC-LIB
        step("still reports a timeout as timed out, not as a crash")
        # Similar-problem detection: the two share the -1 sentinel, so a
        # classification bug in either direction shows up here.
        val r = make_result_from_output("y_spec.spl", "", "TIMEOUT", -1, 10, 60)
        expect(r.timed_out).to_equal(true)
        expect(r.error.starts_with("CRASHED")).to_equal(false)

    it "leaves an ordinary non-zero exit as an ordinary failure":
        # @req REQ-SSPEC-LIB
        step("leaves an ordinary non-zero exit as an ordinary failure")
        val r = make_result_from_output("z_spec.spl", "1 example, 1 failure", "", 1, 10, 60)
        expect(r.error.starts_with("CRASHED")).to_equal(false)
        expect(r.failed).to_equal(1)

describe "a crashed spec reports the fault diagnostic the runner already matched":
    # @manual scenario evidence
    it "surfaces `memory allocation of N bytes failed` instead of a blank last output":
        # @req REQ-SSPEC-LIB
        step("surfaces `memory allocation of N bytes failed` instead of a blank last output")
        # Reproducing case: a spec child killed by the runner's `ulimit -v` cap
        # aborts with exactly this text on stderr. `has_crash_evidence` matched
        # it (its pattern list contains "memory allocation of") but
        # `extract_error_message` did not (its list is semantic:/parse error:/
        # ERROR:/... only), so the reported message was
        # `CRASHED: child died by signal 6 (exit 134); last output: ` -- empty.
        # 66 crashes in one directory run printed a blank diagnosis while the
        # runner already held the reason.
        val alloc_stderr = "memory allocation of 729096 bytes failed\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace"
        val r = make_result_from_output("alloc_spec.spl", "", alloc_stderr, 134, 10, 60)
        expect(r.error.starts_with("CRASHED")).to_equal(true)
        expect(r.error.contains("memory allocation of 729096 bytes failed")).to_equal(true)
        expect(r.error.ends_with("last output: ")).to_equal(false)

    it "reports the fault diagnostic even when an assertion line is also present":
        # @req REQ-SSPEC-LIB
        step("reports the fault diagnostic even when an assertion line is also present")
        # Similar-problem detection: a fallback that only fires when
        # `extract_error_message` is empty would let the `✗` assertion line win
        # and hide the abort reason again. At a crash site the matched fault
        # diagnostic must appear unconditionally.
        val r = make_result_from_output(
            "mixed_spec.spl",
            "✗ some example\nexpected 1 to equal 2",
            "memory allocation of 4096 bytes failed",
            134, 10, 60)
        expect(r.error.contains("memory allocation of 4096 bytes failed")).to_equal(true)

    it "keeps reporting a panic diagnostic for a signal death with no exit code":
        # @req REQ-SSPEC-LIB
        step("keeps reporting a panic diagnostic for a signal death with no exit code")
        val r = make_result_from_output("panic_spec.spl", "", "thread 'main' panicked at src/x.rs:1:1:\nboom", -1, 10, 60)
        expect(r.error.starts_with("CRASHED")).to_equal(true)
        expect(r.error.contains("panicked at")).to_equal(true)
