# Reproduce + regression proof (2026-08-24): extract_block_error scanned for a
# literal "error:" substring, but the seed colourises the marker, so a real
# error arrives as "\x1b[31merror\x1b[0m: ..." and never matched. The scan then
# fell through to its stderr-line-1 fallback, which is always the seed's
# "bootstrap seed only" banner — the same masking fixed for SPL doctests in
# 3bd92f2b8b8. Observed in the 2026-08-24 baseline as the reported reason for
# doc/07_guide/ml/tensor_dimensions.md line 423.
use std.test_runner.sdoctest.runner.*

val SEED_BANNER = "WARNING: this Rust-built Simple binary is a bootstrap seed only; do not use it as the normal tool."

describe "sdoctest block error extraction sees through ANSI colouring":
    it "finds a colourised error: line instead of falling back to the banner":
        val stderr = SEED_BANNER + "\n\x1b[31merror\x1b[0m: undefined variable `x`"
        expect(extract_block_error(stderr: stderr, stdout: "")).to_equal("error: undefined variable `x`")

    it "still finds a plain uncoloured error: line":
        val stderr = SEED_BANNER + "\nerror: boom"
        expect(extract_block_error(stderr: stderr, stdout: "")).to_equal("error: boom")

    it "still finds a colourised parse error":
        val stderr = SEED_BANNER + "\n\x1b[31mparse error\x1b[0m: bad token"
        expect(extract_block_error(stderr: stderr, stdout: "")).to_equal("parse error: bad token")

    it "reports the fixed placeholder when there is nothing at all":
        expect(extract_block_error(stderr: "", stdout: "")).to_equal("Exit code non-zero")
