use std.test_runner.doctest_runner.{extract_doctests}

describe "docstring indentation without unavailable trim_start dispatch":
    it "preserves ascii body bytes":
        val blocks = extract_doctests("test/fixtures/doctest_indent_seed_compat/ascii.txt")
        expect(blocks.len()).to_equal(1)
        expect(blocks[0].code).to_equal("if true:\n    print(\"ok\")  ")
        expect(blocks[0].should_fail).to_equal(false)
    it "preserves tabs body bytes":
        val blocks = extract_doctests("test/fixtures/doctest_indent_seed_compat/tabs.txt")
        expect(blocks.len()).to_equal(1)
        expect(blocks[0].code).to_equal("if true:\n\tprint(\"tab\")\t ")
        expect(blocks[0].should_fail).to_equal(false)
    it "preserves unicode body bytes":
        val blocks = extract_doctests("test/fixtures/doctest_indent_seed_compat/unicode.txt")
        expect(blocks.len()).to_equal(1)
        expect(blocks[0].code).to_equal("print(\"café café\")  ")
        expect(blocks[0].should_fail).to_equal(false)
    it "preserves blank body bytes":
        val blocks = extract_doctests("test/fixtures/doctest_indent_seed_compat/blank.txt")
        expect(blocks.len()).to_equal(1)
        expect(blocks[0].code).to_equal("\n    \nprint(\"after\")  ")
        expect(blocks[0].should_fail).to_equal(false)
    it "preserves repeat body bytes":
        val blocks = extract_doctests("test/fixtures/doctest_indent_seed_compat/repeat.txt")
        expect(blocks.len()).to_equal(1)
        expect(blocks[0].code).to_equal("value value  \nvalue value  ")
        expect(blocks[0].should_fail).to_equal(false)
    it "preserves sdoctest body bytes":
        val blocks = extract_doctests("test/fixtures/doctest_indent_seed_compat/sdoctest.txt")
        expect(blocks.len()).to_equal(1)
        expect(blocks[0].code).to_equal("if true:\n    print(\"nested\")  ")
        expect(blocks[0].should_fail).to_equal(false)
