use std.nogc_sync_mut.test_runner.worker_memory.{worker_memory_charges, worker_memory_can_spawn, worker_memory_supported}
use std.nogc_sync_mut.test_runner.test_runner_args.{parse_test_args, test_args_validation_error}

fn main() -> i64:
    val charges = worker_memory_charges("10 1 100\n11 10 200\n12 11 300\n20 1 50\n99 1 9000\n", [10, 20, 30], 128)
    if charges != [600, 128, 128]:
        print "FAIL descendant and missing-root charges: {charges}"
        return 1
    if worker_memory_charges("10 1 nope\n", [10], 128).len() != 0: return 2
    if worker_memory_charges("10 11 2\n11 10 2\n", [20], 128).len() != 0: return 3
    if not worker_memory_can_spawn(1000, 800, 200): return 4
    if worker_memory_can_spawn(1000, 801, 200): return 5
    if worker_memory_charges("10 1 2\n10 1 3\n", [10], 128).len() != 0: return 6
    if worker_memory_charges("", [10], 128).len() != 0: return 7
    if worker_memory_can_spawn(1000, -1, 200): return 8
    val opts = parse_test_args(["--worker-memory-mb=20480", "--max-workers=20"])
    if opts.worker_memory_mb != 20480 or opts.max_workers != 20: return 9
    if test_args_validation_error(["--worker-memory-mb=0"]) == "": return 10
    if test_args_validation_error(["--worker-memory-mb", "bad"]) == "": return 11
    if test_args_validation_error(["--worker-memory-mb", "20480"]) != "": return 12
    for invalid in ["nope", "x", "-1", "+1", "1x", "9999999999999999999999999999"]:
        if worker_memory_charges("10 1 {invalid}\n", [10], 128).len() != 0: return 13
        if worker_memory_charges("{invalid} 1 10\n", [10], 128).len() != 0: return 14
        if worker_memory_charges("10 {invalid} 10\n", [10], 128).len() != 0: return 15
    if worker_memory_charges("10 0 0\n", [10], 128) != [128]: return 16
    if worker_memory_charges("10 0 1099511627777\n", [10], 128).len() != 0: return 17
    if test_args_validation_error(["--worker-memory-mb=x"]) == "": return 18
    if test_args_validation_error(["--worker-memory-mb=9999999999999999999999"]) == "": return 19
    val spaced = parse_test_args(["--worker-memory-mb", "512", "--max-workers", "20"])
    if spaced.worker_memory_mb != 512 or spaced.max_workers != 20: return 20
    if worker_memory_charges("0 0 100\n10 0 0\n", [10], 128) != [128]: return 21
    if worker_memory_charges("0 0 100\n", [0], 128).len() != 0: return 22
    if not worker_memory_supported("freebsd") or worker_memory_supported("windows"): return 23
    print "worker memory parser, admission, CLI PASS"
    0
