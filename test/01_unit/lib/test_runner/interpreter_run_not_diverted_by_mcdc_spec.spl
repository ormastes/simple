# @req REQ-MC-012
# @cover src/lib/nogc_sync_mut/test_runner/test_runner_config.spl
"""
# Default-on MC/DC must not divert interpreter runs to native

Repro for mcdc_default_on_diverts_interpreter_runs_to_native_2026-09-05
(before the fix the decision was `coverage or mode in {on, dynamic}`), and the
prevention guard for the class: only explicit coverage selects native.
"""

use std.spec.*
use std.spec.step
use std.test_runner.test_runner_config.{interpreter_run_diverts_to_native, interpreter_mcdc_not_instrumented_notice}

describe "interpreter run vs MC/DC mode":
    it "stays on the interpreter for every MC/DC mode when coverage is off":
        for mode in ["", "on", "dynamic", "off", "static-on"]:
            expect(interpreter_run_diverts_to_native(false, mode)).to_equal(false)

    it "explicit coverage still selects the native lane":
        for mode in ["", "on", "dynamic"]:
            expect(interpreter_run_diverts_to_native(true, mode)).to_equal(true)

    it "prints a visible notice only when MC/DC is on or dynamic":
        expect(interpreter_mcdc_not_instrumented_notice("on").contains("not MC/DC-instrumented")).to_equal(true)
        expect(interpreter_mcdc_not_instrumented_notice("dynamic").contains("[mcdc]")).to_equal(true)
        expect(interpreter_mcdc_not_instrumented_notice("off")).to_equal("")
        expect(interpreter_mcdc_not_instrumented_notice("")).to_equal("")
