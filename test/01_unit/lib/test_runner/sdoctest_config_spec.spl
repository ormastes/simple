use std.spec
use std.test_runner.sdoctest.{default_sdoctest_config, parse_config_from_text}
use std.text.{ends_with}

describe "sync sdoctest config":
    it "parses closed ignore path and tag arrays":
        val config = parse_config_from_text("ignore:\n  paths: [\"build/**\", \"vendor/**\"]\n  tags: [\"slow\"]\n")
        expect(config.ignore.paths).to_equal(["build/**", "vendor/**"])
        expect(config.ignore.tags).to_equal(["slow"])

    it "handles empty closed arrays":
        val config = parse_config_from_text("ignore:\n  paths: []\n  tags: []\n")
        expect(config.ignore.paths.len()).to_equal(0)
        expect(config.ignore.tags.len()).to_equal(0)

    it "keeps the positional text suffix API available":
        expect(ends_with("items]", "]")).to_equal(true)
        expect(ends_with("items", "]")).to_equal(false)

    it "preserves default configuration":
        val config = default_sdoctest_config()
        expect(config.default_timeout).to_equal(5000)
