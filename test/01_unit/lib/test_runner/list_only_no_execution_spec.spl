use std.spec.{describe, it, expect}
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_config.{TestConfig}
use std.test_runner.test_runner_modes.{run_spl_doctest_mode}
use app.test_runner_new.test_runner_main.{run_tests}
use std.nogc_sync_mut.io.file_ops.{file_write, file_exists}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}

describe "test inventory never executes examples":
    it "lists an assertion-failing source doctest without running it":
        val options = parse_test_args(["test/fixtures/test_runner/list_only_poison.spl", "--spl-doctest", "--list"])
        expect(options.list).to_equal(true)
        val result = run_spl_doctest_mode(options, TestConfig.defaults())
        expect(result.total).to_equal(0)
        expect(result.failed).to_equal(0)
        expect(result.errors).to_equal(0)
        expect(result.files.len()).to_equal(0)

    it "lists a system spec before execution-only coverage admission":
        val directory = "build/test-list-no-execute/03_system"
        dir_create_all(directory)
        val path = directory + "/poison_spec.spl"
        file_write(path, "use std.spec.*\ndescribe \"must not execute\":\n    it \"poison\":\n        assert(false)\n")
        expect(file_exists(path)).to_equal(true)
        val options = parse_test_args([path, "--list", "--no-cache"])
        expect(options.no_cover_check).to_equal(false)
        val result = run_tests(options)
        expect(result.total_failed).to_equal(0)
        expect(result.total_passed).to_equal(0)
        expect(result.files.len()).to_equal(0)
