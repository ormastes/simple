# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""
## Purpose and audience
Purpose: Import-check probe that also exercises the imported module behaviorally
so a broken export fails here, not silently at load time.
Audience: test-runner engineers who own the imported module.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.test_runner.test_classification.{separate_qemu_tests}

describe "throwaway import check":
    # @manual scenario evidence
    it "loads classification module":
        # @req REQ-SSPEC-LIB
        step("loads classification module")
        # evidence(protocol_json): classification split below is the complete typed oracle
        val (normal, qemu) = separate_qemu_tests(["a/normal_spec.spl", "b/qemu/run_spec.spl"])
        expect(normal.len()).to_equal(1)
        expect(qemu.len()).to_equal(1)
