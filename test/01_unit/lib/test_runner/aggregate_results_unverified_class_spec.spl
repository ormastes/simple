"""
## Purpose and audience
Purpose: Prove that unverified units are never absent from the aggregate failure count.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-TEST-RUNNER-001 — stable requirement identity for this spec.

use std.nogc_sync_mut.test_runner.test_runner_output.{aggregate_failed_count}
use std.nogc_sync_mut.test_runner.test_runner_types.{TestFileResult, TestRunResult}

# Defect CLASS spec for the vacuous aggregate `Results:` head.
#
# The timeout in the reproducing spec is one instance of a general shape: a
# TestFileResult that is NOT OK but carries `failed == 0`, so it contributes
# nothing to total_failed and vanishes from a head built only from
# total_passed/total_failed. TERMINATED (host SIGTERM) and the silent NOT_RUN
# shape (no error, no examples of any kind) have exactly the same shape.
#
# The POSITIVE CONTROL below is the load-bearing half: the fix must not be
# "always report a failure". A normally-passing run, and an ordinary failing
# run, must both still report their REAL counts -- in particular an ordinary
# failing spec must be counted ONCE, not twice, even though it classifies as
# a non-OK file.

fn file_of(path: text, passed: i64, failed: i64, error: text, timed_out: bool) -> TestFileResult:
    TestFileResult(
        path: path, passed: passed, failed: failed, skipped: 0, pending: 0,
        duration_ms: 1, setup_ms: 0, error: error, timed_out: timed_out,
        cached: false
    )

fn run_of(files: [TestFileResult], passed: i64, failed: i64, timed_out: i64) -> TestRunResult:
    TestRunResult(
        files: files, total_passed: passed, total_failed: failed,
        total_skipped: 0, total_pending: 0, total_timed_out: timed_out,
        total_duration_ms: 0, total_setup_ms: 0, total_cached: 0
    )

use std.spec.step

describe "unverified units are never absent from the aggregate failure count":
    it "counts a TERMINATED unit":
        step("Verify: counts a TERMINATED unit")
        # @req: REQ-LIB-TEST-RUNNER-001
        val f = file_of("t_spec.spl", 0, 0, "TERMINATED: killed by signal", false)
        expect(aggregate_failed_count(run_of([f], 0, 0, 0))).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "counts a silent NOT_RUN unit (no error, no examples)":
        step("Verify: counts a silent NOT_RUN unit (no error, no examples)")
        val f = file_of("n_spec.spl", 0, 0, "", false)
        expect(aggregate_failed_count(run_of([f], 0, 0, 0))).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "counts each unverified unit separately alongside real failures":
        step("Verify: counts each unverified unit separately alongside real failures")
        val ok = file_of("a_spec.spl", 3, 0, "", false)
        val bad = file_of("b_spec.spl", 0, 2, "", false)
        val tout = file_of("c_spec.spl", 0, 0, "TIMEOUT: no result after 15s", true)
        expect(aggregate_failed_count(run_of([ok, bad, tout], 3, 2, 1))).to_equal(3)  # oracle: 3 — named expected value from the requirement

describe "POSITIVE CONTROL: honest runs keep their real counts":
    it "reports zero failures for an all-passing run":
        step("Verify: reports zero failures for an all-passing run")
        val a = file_of("a_spec.spl", 4, 0, "", false)
        val b = file_of("b_spec.spl", 10, 0, "", false)
        expect(aggregate_failed_count(run_of([a, b], 14, 0, 0))).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports an ordinary failing run exactly once, not twice":
        step("Verify: reports an ordinary failing run exactly once, not twice")
        # A failing spec is a non-OK file AND is already inside total_failed.
        # Adding the outcome-class counters directly would double it.
        val f = file_of("f_spec.spl", 1, 2, "", false)
        expect(aggregate_failed_count(run_of([f], 1, 2, 0))).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "reports zero failures for a genuinely empty selection":
        step("Verify: reports zero failures for a genuinely empty selection")
        expect(aggregate_failed_count(run_of([], 0, 0, 0))).to_equal(0)  # oracle: 0 — named expected value from the requirement
