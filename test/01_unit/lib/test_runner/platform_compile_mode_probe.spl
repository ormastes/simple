use std.nogc_sync_mut.test_runner.test_runner_types.{TestExecutionMode}
use std.nogc_sync_mut.test_runner.test_runner_files.{platform_tag_matches}

fn main() -> i64:
    val tags: [text] = ["host", "all", "interpreter", "smf", "native", "compile", "composite", "unknown"]
    var checks = 0
    for tag in tags:
        val common = tag == "host" or tag == "all"
        if platform_tag_matches(tag, TestExecutionMode.Compile) != (common or tag == "compile"): return 1
        if platform_tag_matches(tag, TestExecutionMode.Interpreter) != (common or tag == "interpreter"): return 2
        if platform_tag_matches(tag, TestExecutionMode.Smf) != (common or tag == "smf"): return 3
        if platform_tag_matches(tag, TestExecutionMode.Native) != (common or tag == "native"): return 4
        if platform_tag_matches(tag, TestExecutionMode.Composite("native+compile")) != (common or tag == "native" or tag == "compile" or tag == "composite"): return 5
        checks = checks + 5
    print "platform compile mode probe PASS checks={checks}"
    0
