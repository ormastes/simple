"""
## Purpose and audience
Purpose: Prove the neighbours of the assertion-failure fallback keep their
shape: compiler/runtime error lines win over assertion lines, and an
`expected` line without a preceding `✗` is not promoted on its own.
Audience: compiler and tooling engineers who maintain the test runner.
"""
# @req: REQ-LIB-TEST-RUNNER-002 — assertion failures must be diagnosable from the runner summary.

use std.nogc_sync_mut.test_runner.test_executor_parsing.{extract_error_message}
use std.spec.step

# Generalisation of doc/08_tracking/bug/test_01_unit_process_exit_cluster_2026-08-26.md:
# the fallback only runs when the primary error-line pass found nothing, and
# only pairs `expected ...` with the `✗` line directly above it.

describe "error-line precedence around the assertion fallback":
    it "prefers a semantic error over a later assertion failure":
        step("Verify: prefers a semantic error over a later assertion failure")
        # @req: REQ-LIB-TEST-RUNNER-002
        val out = "semantic: unknown method foo\n  ✗ example\n    expected 1 to equal 2\n"
        expect(extract_error_message(out)).to_equal("semantic: unknown method foo")

    it "prefers an Error: line even when it comes after the assertion":
        step("Verify: prefers an Error: line even when it comes after the assertion")
        val out = "  ✗ example\n    expected 1 to equal 2\nError: runtime blew up\n"
        expect(extract_error_message(out)).to_equal("Error: runtime blew up")

    it "does not promote a stray expected line with no failing example above it":
        step("Verify: does not promote a stray expected line with no failing example above it")
        val out = "some prose\n    expected 1 to equal 2\n"
        expect(extract_error_message(out)).to_equal("")

    it "keeps a failing example whose expectation line is missing":
        step("Verify: keeps a failing example whose expectation line is missing")
        val out = "  ✗ example without detail\n1 example, 1 failure\n"
        expect(extract_error_message(out)).to_equal("✗ example without detail")
