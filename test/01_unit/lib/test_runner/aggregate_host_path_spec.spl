use std.spec
use std.nogc_sync_mut.fs.host_path.{host_path_is_absolute_for}

describe "aggregate ledger host path admission":
    it "admits drive-rooted and network-share Windows ledger paths":
        expect(host_path_is_absolute_for("C:/test/registry.tsv", "windows")).to_equal(true)
        expect(host_path_is_absolute_for("C:\\test\\registry.tsv", "windows")).to_equal(true)
        expect(host_path_is_absolute_for("\\\\server\\share\\registry.tsv", "windows")).to_equal(true)

    it "rejects relative-drive, current-drive and device namespace paths":
        expect(host_path_is_absolute_for("C:registry.tsv", "windows")).to_equal(false)
        expect(host_path_is_absolute_for("/registry.tsv", "windows")).to_equal(false)
        expect(host_path_is_absolute_for("\\\\.\\pipe\\registry", "windows")).to_equal(false)
        expect(host_path_is_absolute_for("\\\\?\\C:\\registry.tsv", "windows")).to_equal(false)

    it "preserves POSIX absolute and literal-backslash semantics":
        expect(host_path_is_absolute_for("/tmp/a\\b.tsv", "linux")).to_equal(true)
        expect(host_path_is_absolute_for("C:/registry.tsv", "linux")).to_equal(false)
        expect(host_path_is_absolute_for("\\tmp\\registry.tsv", "linux")).to_equal(false)
