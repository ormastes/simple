"""Async collection must use its own receipt, never nested human output.

These exercise collection with temporary receipt files, not process transport.
Real parallel child execution remains a separate integration gate.
"""
use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_write, file_exists}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.test_runner.test_runner_async.{AsyncTestRun, create_temp_files, collect_async_result}

fn receipt_run_v1(label: text, receipt: text) -> AsyncTestRun:
    val (stdout_file, stderr_file) = create_temp_files(label)
    file_write(stdout_file, "Results: 999 total, 999 passed, 0 failed\n")
    val evidence = stdout_file + ".bdd"
    if receipt != "":
        file_write(evidence, receipt)
        file_write(evidence + ".expectations", "simple-bdd-expectations-v1\n1\n")
    AsyncTestRun(pid: 0, file_path: label, start_time: time_now_unix_micros(),
        stdout_file: stdout_file, stderr_file: stderr_file, timeout_ms: 1000,
        evidence_file: evidence)

describe "async structured child evidence":
    it "uses receipt counts instead of nested green output":
        val run = receipt_run_v1("async_receipt_green.spl", "simple-bdd-v1\n2\n0\n")
        val result = collect_async_result(run, 0)
        expect(result.passed).to_equal(2)
        expect(result.failed).to_equal(0)
        expect(result.is_ok()).to_equal(true)
        expect(file_exists(run.evidence_file)).to_equal(false)
        expect(file_exists(run.evidence_file + ".expectations")).to_equal(false)

    it "keeps a red receipt red even when output looks green":
        val run = receipt_run_v1("async_receipt_red.spl", "simple-bdd-v1\n2\n1\n")
        val result = collect_async_result(run, 1)
        expect(result.passed).to_equal(2)
        expect(result.failed).to_equal(1)
        expect(result.is_ok()).to_equal(false)

    it "rejects missing evidence despite a green transcript and exit zero":
        val run = receipt_run_v1("async_receipt_missing.spl", "")
        val result = collect_async_result(run, 0)
        expect(result.passed).to_equal(0)
        expect(result.failed).to_equal(1)
        expect(result.error).to_contain("structured BDD evidence unavailable")

    it "rejects zero executed examples":
        val run = receipt_run_v1("async_receipt_zero.spl", "simple-bdd-v1\n0\n0\n")
        val result = collect_async_result(run, 0)
        expect(result.passed).to_equal(0)
        expect(result.failed).to_equal(1)
        expect(result.error).to_contain("no BDD examples executed")

    it "keeps deadline expiry authoritative over a green receipt":
        val run = receipt_run_v1("async_receipt_timeout.spl", "simple-bdd-v1\n1\n0\n")
        val result = collect_async_result(run, 0, deadline_expired: true)
        expect(result.timed_out).to_equal(true)
        expect(result.is_ok()).to_equal(false)
        expect(file_exists(run.evidence_file)).to_equal(false)

    it "collects independent receipts in reverse completion order":
        val first = receipt_run_v1("async_receipt_first.spl", "simple-bdd-v1\n1\n0\n")
        val second = receipt_run_v1("async_receipt_second.spl", "simple-bdd-v1\n3\n0\n")
        expect(first.evidence_file == second.evidence_file).to_equal(false)
        val second_result = collect_async_result(second, 0)
        expect(second_result.passed).to_equal(3)
        expect(file_exists(first.evidence_file)).to_equal(true)
        val first_result = collect_async_result(first, 0)
        expect(first_result.passed).to_equal(1)
        expect(file_exists(first.evidence_file)).to_equal(false)
