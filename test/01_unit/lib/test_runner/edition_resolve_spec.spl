"""
## Purpose and audience
Purpose: Prove that resolve_edition() -- decision-free manifest slice (no semantics gated).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-TEST-RUNNER-001 — stable requirement identity for this spec.

# @cover src/lib/nogc_sync_mut/test_runner/test_runner_config.spl
# Lane ED1 `editions-scoping-plus-manifest` -- decision-free manifest slice.
# See doc/01_research/language/editions_mechanism_scoping_2026-07-29.md for
# what a real edition mechanism would gate; this spec only proves the
# accessor resolves correctly. Nothing downstream consumes resolve_edition()
# yet -- no semantics are gated on it.
#
# Proves:
#  1. edition="2026" (the one defined value) resolves to "2026".
#  2. Absent simple.sdn (this repo's cwd during `bin/simple test` has none at
#     the root, same fact profile_aware_execution_spec.spl relies on) ->
#     resolve_edition() resolves to the documented implicit default "2026".
#  3. An unknown edition value warns exactly once (edition_unknown_warn_count
#     proves the count, mirroring deprecated_profile_alias_warn_count) and
#     falls back to the default rather than propagating the bad value.

use std.test_runner.test_runner_config.{resolve_edition, resolve_edition_from_value, edition_unknown_warn_count, EDITION_DEFAULT}

use std.spec.step

describe "resolve_edition() -- decision-free manifest slice (no semantics gated)":
    it "defaults to \"2026\" when simple.sdn is absent at the repo root":
        # This repo's cwd during `bin/simple test` has no simple.sdn at the
        # root (verified by profile_aware_execution_spec.spl's own comment),
        # so the [package] tier of resolution yields "" and resolve_edition
        # falls through to the documented implicit current edition.
        expect(resolve_edition()).to_equal("2026")

    it "EDITION_DEFAULT is the one currently-defined edition value":
        step("Verify: EDITION_DEFAULT is the one currently-defined edition value")
        # @req: REQ-LIB-TEST-RUNNER-001
        expect(EDITION_DEFAULT).to_equal("2026")

describe "resolve_edition_from_value() -- the pure resolution step":
    it "resolves the one defined value, \"2026\", unchanged":
        expect(resolve_edition_from_value("2026")).to_equal("2026")

    it "resolves an empty/absent value to the default":
        step("Verify: resolves an empty/absent value to the default")
        expect(resolve_edition_from_value("")).to_equal(EDITION_DEFAULT)

    it "falls back to the default for an unknown value, warning exactly once":
        step("Verify: falls back to the default for an unknown value, warning exactly once")
        val before = edition_unknown_warn_count("not-a-real-edition-xyz")
        expect(before).to_equal(0)  # oracle: 0 — named expected value from the requirement

        val resolved = resolve_edition_from_value("not-a-real-edition-xyz")
        expect(resolved).to_equal(EDITION_DEFAULT)

        val after = edition_unknown_warn_count("not-a-real-edition-xyz")
        expect(after).to_equal(1)  # oracle: 1 — named expected value from the requirement

        # Calling again with the same bad value must not warn twice --
        # edition_unknown_warn_count stays at 1 (mirrors the profile
        # precedent's warn-once contract).
        val resolved_again = resolve_edition_from_value("not-a-real-edition-xyz")
        expect(resolved_again).to_equal(EDITION_DEFAULT)
        expect(edition_unknown_warn_count("not-a-real-edition-xyz")).to_equal(1)
