# @cover src/lib/nogc_sync_mut/test_runner/test_runner_config.spl
# Lane ED1 `editions-scoping-plus-manifest` -- decision-free manifest slice.
# See doc/01_research/language/editions_mechanism_scoping_2026-07-29.md for
# what a real edition mechanism would gate; this spec only proves the
# accessor resolves correctly. Nothing downstream consumes resolve_edition()
# yet -- no semantics are gated on it.
#
# Proves:
#  1. edition="2026" (the one defined value) resolves to "2026".
#  2. Absent simple.sdn (this repo's cwd during `bin/simple test` has none at
#     the root, same fact profile_aware_execution_spec.spl relies on) ->
#     resolve_edition() resolves to the documented implicit default "2026".
#  3. An unknown edition value warns exactly once (edition_unknown_warn_count
#     proves the count, mirroring deprecated_profile_alias_warn_count) and
#     falls back to the default rather than propagating the bad value.

use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.test_runner.test_runner_config.{resolve_edition, resolve_edition_from_sdn, resolve_edition_from_value, edition_unknown_warn_count, edition_values_from_policy, EDITION_DEFAULT}

describe "resolve_edition() -- decision-free manifest slice (no semantics gated)":
    # @manual scenario evidence
    it "defaults to \"2027.2\" when simple.sdn is absent at the repo root":
        # @req REQ-SSPEC-UNIT
        step("defaults to \"2027.2\" when simple.sdn is absent at the repo root")
        # This repo's cwd during `bin/simple test` has no simple.sdn at the
        # root (verified by profile_aware_execution_spec.spl's own comment),
        # so the project: tier of resolution yields "" and resolve_edition
        # falls through to the default edition.
        expect(resolve_edition()).to_equal("2027.2")

    it "EDITION_DEFAULT is 2027.2":
        expect(EDITION_DEFAULT).to_equal("2027.2")

describe "resolve_edition_from_value() -- the pure resolution step":
    it "still accepts the legacy explicit edition \"2026\" unchanged":
        # @req REQ-SSPEC-UNIT
        step("still accepts the legacy explicit edition \"2026\" unchanged")
        expect(resolve_edition_from_value("2026")).to_equal("2026")
        expect(edition_unknown_warn_count("2026")).to_equal(0)

    it "resolves an empty/absent value to the default":
        expect(resolve_edition_from_value("")).to_equal(EDITION_DEFAULT)

    it "falls back to the default for an unknown value, warning exactly once":
        val before = edition_unknown_warn_count("not-a-real-edition-xyz")
        expect(before).to_equal(0)

        val resolved = resolve_edition_from_value("not-a-real-edition-xyz")
        expect(resolved).to_equal(EDITION_DEFAULT)

        val after = edition_unknown_warn_count("not-a-real-edition-xyz")
        expect(after).to_equal(1)

        # Calling again with the same bad value must not warn twice --
        # edition_unknown_warn_count stays at 1 (mirrors the profile
        # precedent's warn-once contract).
        val resolved_again = resolve_edition_from_value("not-a-real-edition-xyz")
        expect(resolved_again).to_equal(EDITION_DEFAULT)
        expect(edition_unknown_warn_count("not-a-real-edition-xyz")).to_equal(1)

# Owner decision 5C (plan §7): the editions the diagnostic policy schedules
# (config/policy/diagnostic_policy.sdn *_lang_version) are recognized.
describe "resolve_edition_from_value() -- policy editions (5C)":
    it "accepts 2026.11 unchanged":
        expect(resolve_edition_from_value("2026.11")).to_equal("2026.11")
        expect(edition_unknown_warn_count("2026.11")).to_equal(0)

    it "accepts 2027.2 unchanged":
        expect(resolve_edition_from_value("2027.2")).to_equal("2027.2")
        expect(edition_unknown_warn_count("2027.2")).to_equal(0)

    it "unknown 2099.9 warns once and falls back":
        expect(resolve_edition_from_value("2099.9")).to_equal(EDITION_DEFAULT)
        expect(edition_unknown_warn_count("2099.9")).to_equal(1)

    it "reads project: edition from an explicit simple.sdn path":
        val dir = secure_temp_dir(".", "edition-resolve-spec").unwrap()
        val path = dir + "/simple.sdn"
        file_write(path, "project:\n  name: demo\n  edition: \"2027.2\"\n")
        expect(resolve_edition_from_sdn(path)).to_equal("2027.2")
        dir_remove_all(dir)

    it "ignores edition outside the project: block and TOML [package] form":
        val dir = secure_temp_dir(".", "edition-resolve-spec").unwrap()
        val path = dir + "/simple.sdn"
        file_write(path, "project:\n  name: demo\nlints:\n  edition: 2027.2\n")
        expect(resolve_edition_from_sdn(path)).to_equal(EDITION_DEFAULT)
        file_write(path, "[package]\nedition = \"2027.2\"\n")
        expect(resolve_edition_from_sdn(path)).to_equal(EDITION_DEFAULT)
        file_write(path, "project:\n  name: demo\n  edition: 2026.11\n")
        expect(resolve_edition_from_sdn(path)).to_equal("2026.11")
        dir_remove_all(dir)

    it "no edition key resolves to the default":
        val dir = secure_temp_dir(".", "edition-resolve-spec").unwrap()
        val path = dir + "/simple.sdn"
        file_write(path, "project:\n  name: demo\n  version: 1.0.0\n")
        expect(resolve_edition_from_sdn(path)).to_equal(EDITION_DEFAULT)
        dir_remove_all(dir)

describe "edition_values_from_policy() -- only promotion keys":
    it "collects warn_since/error_since but not remove_since":
        val pol = "rules:\n  r1:\n    warn_since_lang_version: \"2026.11\"\n    error_since_lang_version: \"2027.2\"\n    remove_since_lang_version: \"2028.5\"\n"
        val eds = edition_values_from_policy(pol)
        expect(eds.contains("2026.11")).to_equal(true)
        expect(eds.contains("2027.2")).to_equal(true)
        expect(eds.contains("2028.5")).to_equal(false)
