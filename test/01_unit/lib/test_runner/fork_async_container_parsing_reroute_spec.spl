# Proves test_runner_fork / test_runner_async / sequential_container resolve
# their cheap helpers from the defining module test_executor_parsing, not via
# test_runner_execute (which eagerly loads composite -> GPU/JIT -> ~300
# compiler modules, ~40-110s seed load).
# See doc/08_tracking/todo/test_runner_execute_composite_gpu_eager_import_cost_2026-08-17.md

use std.test_runner.test_runner_fork.{run_test_file_fork}
use std.test_runner.test_runner_async
use std.test_runner.sequential_container
use std.test_runner.test_executor_parsing.{make_result_from_output, find_simple_binary, build_child_args}
use std.test_runner.test_runner_types.{TestOptions}

describe "reroute of cheap test_runner helpers to test_executor_parsing":
    it "resolves make_result_from_output from the defining module":
        val r = make_result_from_output("probe.spl", "Results: 1 total, 1 passed, 0 failed", "", 0, 5, 60)
        expect(r.path).to_equal("probe.spl")

    it "resolves build_child_args from the defining module":
        val args = build_child_args("probe.spl", TestOptions())
        expect(args.len()).to_be_greater_than(0)
