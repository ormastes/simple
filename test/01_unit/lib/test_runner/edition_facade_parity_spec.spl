# @cover src/lib/nogc_async_mut/test_runner/test_runner_config.spl
# All four test_runner_config copies (std.test_runner resolves to the
# nogc_async_mut facade first) must share the 2027.2 edition acceptance.

use std.nogc_sync_mut.test_runner.test_runner_config.{resolve_edition_from_value as sync_resolve, resolve_edition_from_sdn as sync_sdn, EDITION_DEFAULT}
use std.nogc_async_mut.test_runner.test_runner_config.{resolve_edition_from_value as async_resolve, resolve_edition_from_sdn as async_sdn}
use std.gc_async_mut.test_runner.test_runner_config.{resolve_edition_from_value as gca_resolve, resolve_edition_from_sdn as gca_sdn}
use std.gc_sync_mut.test_runner.test_runner_config.{resolve_edition_from_value as gcs_resolve, resolve_edition_from_sdn as gcs_sdn}

describe "test_runner_config edition parity across families":
    it "nogc_sync_mut accepts 2027.2 and rejects 2099.9":
        expect(sync_resolve("2027.2")).to_equal("2027.2")
        expect(sync_resolve("2099.9")).to_equal(EDITION_DEFAULT)
    it "nogc_async_mut accepts 2027.2 and rejects 2099.9":
        expect(async_resolve("2027.2")).to_equal("2027.2")
        expect(async_resolve("2099.9")).to_equal(EDITION_DEFAULT)
    it "gc_async_mut accepts 2027.2 and rejects 2099.9":
        expect(gca_resolve("2027.2")).to_equal("2027.2")
        expect(gca_resolve("2099.9")).to_equal(EDITION_DEFAULT)
    it "gc_sync_mut accepts 2027.2 and rejects 2099.9":
        expect(gcs_resolve("2027.2")).to_equal("2027.2")
        expect(gcs_resolve("2099.9")).to_equal(EDITION_DEFAULT)
    it "all families export resolve_edition_from_sdn":
        expect(async_sdn("nonexistent.sdn")).to_equal(sync_sdn("nonexistent.sdn"))
        expect(gca_sdn("nonexistent.sdn")).to_equal(sync_sdn("nonexistent.sdn"))
        expect(gcs_sdn("nonexistent.sdn")).to_equal(sync_sdn("nonexistent.sdn"))
