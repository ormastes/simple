# @req: REQ-LIB-TEST-RUNNER-001

# @cover src/lib/nogc_sync_mut/test_runner/test_db_core.spl
# Reproduce check for
# doc/08_tracking/bug/runner_test_db_core_imports_nonexistent_stringinterner_2026-08-20.md
#
# `test_db_core.spl` imported `std.test_runner.string_interner.StringInterner`,
# a symbol that module does not define (it defines `TestDbStringInterner`; the
# rename was deliberate, see string_interner.spl:34-35). The bad import is only
# a WARNING, so the failure was deferred to `RunnerTestDbCore.empty()`, which
# died with `method `empty` not found on type `dict``. Pre-fix this spec fails
# at the first expectation; post-fix it is green. It also pins that the fix was
# NOT made by re-adding a `StringInterner` alias.
use std.spec.step

use std.nogc_sync_mut.test_runner.test_db_core.{RunnerTestDbCore}
use std.test_runner.string_interner.{TestDbStringInterner}
use std.test_runner.test_db_types.{RunRecord}

use std.spec.step

describe "RunnerTestDbCore is constructible":
    # @manual scenario evidence
    it "empty() builds a database with no records":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: empty() builds a database with no records")
        var db = RunnerTestDbCore.empty()
        expect(db.tests.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(db.files.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(db.suites.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(db.dirty).to_equal(false)

    it "carries a real TestDbStringInterner, not an empty dict":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: carries a real TestDbStringInterner, not an empty dict")
        var db = RunnerTestDbCore.empty()
        expect(db.interner.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(db.interner.contains("nope")).to_equal(false)

    it "interns through the field the broken import used to blank out":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: interns through the field the broken import used to blank out")
        var db = RunnerTestDbCore.empty()
        val id = db.interner.intern("test/01_unit/example_spec.spl")
        expect(id).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(db.interner.get(id)).to_equal("test/01_unit/example_spec.spl")
        expect(db.interner.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "find_test_index reports absence on an empty database":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: find_test_index reports absence on an empty database")
        var db = RunnerTestDbCore.empty()
        expect(db.find_test_index(0, 0)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "complete_run writes an extracted run record back to its array slot":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: complete_run writes an extracted run record back to its array slot")
        var db = RunnerTestDbCore.empty()
        db.test_runs.push(RunRecord(
            run_id: "target", start_time: "2026-01-01T00:00:00Z", end_time: "",
            pid: 7, hostname: "host", status: "running", test_count: 0,
            passed: 0, failed: 0, crashed: 0, timed_out: 0
        ))
        db.complete_run("target", 5, 3, 1, 1)
        expect(db.test_runs[0].status).to_equal("completed")
        expect(db.test_runs[0].test_count).to_equal(5)
        expect(db.test_runs[0].passed).to_equal(3)
        expect(db.test_runs[0].failed).to_equal(1)
        expect(db.test_runs[0].timed_out).to_equal(1)
        expect(db.test_runs[0].end_time == "").to_equal(false)

    it "cleanup_stale_runs writes an extracted stale run back to its array slot":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: cleanup_stale_runs writes an extracted stale run back to its array slot")
        var db = RunnerTestDbCore.empty()
        db.test_runs.push(RunRecord(
            run_id: "stale", start_time: "2020-01-01T00:00:00Z", end_time: "",
            pid: 8, hostname: "host", status: "running", test_count: 0,
            passed: 0, failed: 0, crashed: 0, timed_out: 0
        ))
        db.cleanup_stale_runs(1)
        expect(db.test_runs[0].status).to_equal("crashed")
        expect(db.test_runs[0].end_time == "").to_equal(false)
        expect(db.dirty).to_equal(true)

describe "the renamed interner class is the only one":
    it "TestDbStringInterner.empty() is the constructor the module provides":
        # @req: REQ-LIB-TEST-RUNNER-001
        step("Verify: TestDbStringInterner.empty() is the constructor the module provides")
        var interner = TestDbStringInterner.empty()
        expect(interner.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
