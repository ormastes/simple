"""
## Purpose and audience
Purpose: Prove that test_config on std.config core (CFG3).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-TEST-RUNNER-001 — stable requirement identity for this spec.

# std.test_runner.test_config on the std.config core (CFG3).
#
# TestConfig is the second, non-IDE consumer of std.common.config_core:
# compiled defaults come from its declared schema, the simple.test.sdn
# document contributes the `workspace` layer, the CI env override contributes
# the `session` layer, and `mandatory` pins policy ceilings.
#
# This replaces the previous spec that pinned the hand-rolled parser's
# CONFIRMED DEFECT (apply_test_config_value missing `mut` made every file key
# a silent no-op — doc/08_tracking/bug/
# test_config_apply_value_missing_mut_param_2026-07-17.md). That helper is
# deleted; the tests below assert the intended values, as that spec asked for
# once the defect was fixed.

use std.spec.{step}
use std.io.{env_get, env_set}
use std.test_runner.test_config.{TestConfig, CONFIG_FILENAME, find_config_file}
use std.test_runner.test_config.{test_config_schema, test_config_entries}
use std.test_runner.test_config.{test_config_env_entries, test_config_resolve}
use std.common.config_core.layers.{ConfigEntry, config_is_locked}

describe "test_config on std.config core (CFG3)":

    context "default resolution (compiled_default layer)":
        it "resolves compiled defaults from the schema with no entries":
            # @req: REQ-LIB-TEST-RUNNER-001
            step("resolve TestConfig from an empty entry list")
            val config = TestConfig.defaults()
            expect(config.timeout_seconds).to_equal(60)  # oracle: 60 — named expected value from the requirement
            expect(config.memory_limit_mb).to_equal(512)  # oracle: 512 — named expected value from the requirement
            expect(config.cpu_limit_seconds).to_equal(30)  # oracle: 30 — named expected value from the requirement
            expect(config.max_fds).to_equal(256)  # oracle: 256 — named expected value from the requirement
            expect(config.max_procs).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(config.slow_threshold_ms).to_equal(5000)  # oracle: 5000 — named expected value from the requirement
            expect(config.cpu_threshold).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement
            expect(config.session_idle_timeout_ms).to_equal(300000)  # oracle: 300000 — named expected value from the requirement
            expect(config.session_max_qemu_vm).to_equal(4)  # oracle: 4 — named expected value from the requirement
            assert_false(config.parallel)
            assert_false(config.fail_fast)
            assert_true(config.run_spec_tests)
            assert_false(config.run_sdoctests)
            assert_false(config.run_slow_tests)
            assert_false(config.ci_mode)

    context "workspace document layer wins over defaults":
        it "parses test: section keys and they override compiled defaults":
            step("parse a nested simple.test.sdn document into workspace entries")
            val content = "test:\n  timeout: 120\n  parallel: true  # trailing comment\n  cpu_throttle:\n    enabled: true\n    threshold: 70\n    memory_threshold: 75.5\n  session_max_sessions:\n    qemu_vm: 9\n    container_instance: 3\n  session_share: true\n"
            val entries = test_config_entries(content: content, layer: "workspace")
            step("resolve against the schema")
            val config = test_config_resolve(entries)
            expect(config.timeout_seconds).to_equal(120)  # oracle: 120 — named expected value from the requirement
            assert_true(config.parallel)
            assert_true(config.throttle_enabled)
            expect(config.cpu_threshold).to_equal(70.0)  # oracle: 70.0 — named expected value from the requirement
            expect(config.memory_threshold).to_equal(75.5)  # oracle: 75.5 — named expected value from the requirement
            expect(config.session_max_qemu_vm).to_equal(9)  # oracle: 9 — named expected value from the requirement
            expect(config.session_max_container).to_equal(3)  # oracle: 3 — named expected value from the requirement
            assert_true(config.session_share)

        it "fixes the old apply-value no-op defect end to end":
            step("parse boolean and session-limit values from a test: document")
            val content = "test:\n  run_sdoctests: true\n  session_max_sessions:\n    qemu_vm: 11\n"
            val entries = test_config_entries(content: content, layer: "workspace")
            step("resolve parsed entries into the returned TestConfig")
            val config = test_config_resolve(entries)
            assert_true(config.run_sdoctests)
            expect(config.session_max_qemu_vm).to_equal(11)  # oracle: 11 — named expected value from the requirement

        it "ignores unknown keys and non-TestConfig subsections":
            step("parse a document with bogus keys")
            val content = "test:\n  totally_bogus_key_xyz: true\n  unit_dir: test/unit\n  session_defaults:\n    qemu_vm: 99\n"
            val config = test_config_resolve(test_config_entries(content: content, layer: "workspace"))
            expect(config.session_max_qemu_vm).to_equal(4)  # oracle: 4 — named expected value from the requirement
            assert_false(config.run_sdoctests)

        it "drops malformed or below-minimum values and keeps the lower layer":
            step("contribute a non-numeric timeout, malformed floats, and a zero memory limit")
            val content = "test:\n  timeout: nope\n  memory_limit_mb: 0\n  cpu_throttle:\n    threshold: nope\n    memory_threshold: .\n"
            val config = test_config_resolve(test_config_entries(content: content, layer: "workspace"))
            expect(config.timeout_seconds).to_equal(60)  # oracle: 60 — named expected value from the requirement
            expect(config.memory_limit_mb).to_equal(512)  # oracle: 512 — named expected value from the requirement
            expect(config.cpu_threshold).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement
            expect(config.memory_threshold).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement

    context "CI env override (session layer)":
        it "CI=true contributes session entries that beat the workspace layer":
            step("set CI=true and gather env entries")
            val original_ci = env_get("CI") ?? ""
            env_set("CI", "true")
            var entries = test_config_entries(content: "test:\n  fail_fast: true\n  run_slow_tests: false\n", layer: "workspace")
            val env_entries = test_config_env_entries()
            var i = 0
            while i < env_entries.len():
                entries.push(env_entries[i])
                i = i + 1
            step("resolve: session (rank 8) outranks workspace (rank 7)")
            val config = test_config_resolve(entries)
            assert_true(config.ci_mode)
            assert_true(config.run_slow_tests)
            assert_false(config.fail_fast)
            if original_ci != "":
                env_set("CI", original_ci)
            else:
                env_set("CI", "")

    context "mandatory policy layer is a ceiling":
        it "a mandatory entry clamps an over-limit session value":
            step("session tries timeout_seconds=6000; mandatory pins 90")
            val entries = [
                ConfigEntry(key: "timeout_seconds", value: "120", layer: "workspace"),
                ConfigEntry(key: "timeout_seconds", value: "6000", layer: "session"),
                ConfigEntry(key: "timeout_seconds", value: "90", layer: "mandatory")
            ]
            val config = test_config_resolve(entries)
            expect(config.timeout_seconds).to_equal(90)  # oracle: 90 — named expected value from the requirement
            step("the resolved key reports as locked by mandatory policy")
            assert_true(config_is_locked(test_config_schema(), entries, "timeout_seconds"))

        it "mandatory memory ceiling survives an over-limit workspace value":
            step("workspace tries memory_limit_mb=999999; mandatory pins 512")
            val entries = [
                ConfigEntry(key: "memory_limit_mb", value: "512", layer: "mandatory"),
                ConfigEntry(key: "memory_limit_mb", value: "999999", layer: "workspace")
            ]
            val config = test_config_resolve(entries)
            expect(config.memory_limit_mb).to_equal(512)  # oracle: 512 — named expected value from the requirement

    context "config file discovery":
        it "declares the canonical config path":
            step("Verify: declares the canonical config path")
            expect(CONFIG_FILENAME).to_equal("config/simple.test.sdn")

        it "finds the config file or fails closed to empty":
            step("Verify: finds the config file or fails closed to empty")
            val path = find_config_file()
            assert_true(path == "" or path.ends_with(CONFIG_FILENAME))
