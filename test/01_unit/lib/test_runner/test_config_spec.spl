# std.test_runner.test_config on the std.config core (CFG3).
#
# load_test_config_from_path currently short-circuits to TestConfig.defaults()
# before ever reading a file (see the early `return config` in that function),
# so these tests exercise the real parsing surface directly instead:
# apply_test_config_value, parse_config_key_value, and parse_test_config_content.
#
# CONFIRMED DEFECT while writing this spec: apply_test_config_value's `config`
# parameter is not declared `mut`, so field writes inside it (e.g.
# `config.run_sdoctests = value == "true"`) mutate only the callee's own stack
# frame -- never the caller's struct. parse_test_config_content routes every
# top-level and cpu_throttle.* key through this same helper, so those keys are
# ALSO no-ops end to end. Direct field assignment done locally within
# parse_test_config_content itself (its CI env-var override block) is NOT
# affected -- only mutation-through-a-separate-function-call is broken. See
# doc/08_tracking/bug/test_config_apply_value_missing_mut_param_2026-07-17.md.
# The tests below pin the CURRENT (broken) contract explicitly rather than
# asserting the unreachable intended behavior, and cover the parts of the
# module that do work correctly.

use std.test_runner.test_config.{TestConfig, apply_test_config_value, parse_config_key_value, parse_test_config_content}
use std.io.{env_get, env_set}

describe "test_config on std.config core (CFG3)":

    context "default resolution (compiled_default layer)":
        it "resolves compiled defaults from the schema with no entries":
            step("resolve TestConfig from an empty entry list")
            val config = TestConfig.defaults()
            expect(config.timeout_seconds).to_equal(60)
            expect(config.memory_limit_mb).to_equal(512)
            expect(config.cpu_limit_seconds).to_equal(30)
            expect(config.max_fds).to_equal(256)
            expect(config.max_procs).to_equal(64)
            expect(config.slow_threshold_ms).to_equal(5000)
            expect(config.cpu_threshold).to_equal(80.0)
            expect(config.session_idle_timeout_ms).to_equal(300000)
            expect(config.session_max_qemu_vm).to_equal(4)
            assert_false(config.parallel)
            assert_false(config.fail_fast)
            assert_true(config.run_spec_tests)
            assert_false(config.run_sdoctests)
            assert_false(config.run_slow_tests)
            assert_false(config.ci_mode)

    context "workspace document layer wins over defaults":
        it "parses test: section keys and they override compiled defaults":
            step("parse a nested simple.test.sdn document into workspace entries")
            val content = "test:\n  timeout: 120\n  parallel: true  # trailing comment\n  cpu_throttle:\n    enabled: true\n    threshold: 70\n    memory_threshold: 75.5\n  session_max_sessions:\n    qemu_vm: 9\n    container_instance: 3\n  session_share: true\n"
            val entries = test_config_entries(content: content, layer: "workspace")
            step("resolve against the schema")
            val config = test_config_resolve(entries)
            expect(config.timeout_seconds).to_equal(120)
            assert_true(config.parallel)
            assert_true(config.throttle_enabled)
            expect(config.cpu_threshold).to_equal(70.0)
            expect(config.memory_threshold).to_equal(75.5)
            expect(config.session_max_qemu_vm).to_equal(9)
            expect(config.session_max_container).to_equal(3)
            assert_true(config.session_share)

        it "fixes the old apply-value no-op defect: run_sdoctests now takes effect":
            step("contribute run_sdoctests via a test: section document")
            val entries = test_config_entries(content: "test:\n  run_sdoctests: true\n", layer: "workspace")
            val config = test_config_resolve(entries)
            assert_true(config.run_sdoctests)
            expect(config.session_max_qemu_vm).to_equal(11)

        it "ignores unknown keys and non-TestConfig subsections":
            step("parse a document with bogus keys")
            val content = "test:\n  totally_bogus_key_xyz: true\n  unit_dir: test/unit\n  session_defaults:\n    qemu_vm: 99\n"
            val config = test_config_resolve(test_config_entries(content: content, layer: "workspace"))
            expect(config.session_max_qemu_vm).to_equal(4)
            assert_false(config.run_sdoctests)

        it "drops malformed or below-minimum values and keeps the lower layer":
            step("contribute a non-numeric timeout, malformed floats, and a zero memory limit")
            val content = "test:\n  timeout: nope\n  memory_limit_mb: 0\n  cpu_throttle:\n    threshold: nope\n    memory_threshold: .\n"
            val config = test_config_resolve(test_config_entries(content: content, layer: "workspace"))
            expect(config.timeout_seconds).to_equal(60)
            expect(config.memory_limit_mb).to_equal(512)
            expect(config.cpu_threshold).to_equal(80.0)
            expect(config.memory_threshold).to_equal(80.0)

        it "documents the same apply_test_config_value defect end-to-end: a test: section run_sdoctests/cpu_throttle line never takes effect":
            val config = TestConfig.defaults()
            val content = "test:\n  run_sdoctests: true\n  cpu_throttle:\n    enabled: true\n"
            val parsed = parse_test_config_content(config, content)
            # Both keys are routed through the broken helper -- see the bug
            # doc referenced above. If this ever starts failing (turning
            # true), the underlying defect has been fixed and this test
            # should be rewritten to assert the correct/intended values.
            expect(parsed.run_sdoctests).to_equal(false)
            expect(parsed.throttle_enabled).to_equal(false)

        it "applies the CI env var override via direct field assignment (the one path NOT routed through the broken helper)":
            val original_ci = env_get("CI") ?? ""
            env_set("CI", "true")
            val config = TestConfig.defaults()
            val parsed = parse_test_config_content(config, "")
            expect(parsed.ci_mode).to_equal(true)
            expect(parsed.run_slow_tests).to_equal(true)
            expect(parsed.fail_fast).to_equal(false)
            if original_ci != "":
                env_set("CI", original_ci)
            else:
                env_set("CI", "")

    context "mandatory policy layer is a ceiling":
        it "a mandatory entry clamps an over-limit session value":
            step("session tries timeout_seconds=6000; mandatory pins 90")
            val entries = [
                ConfigEntry(key: "timeout_seconds", value: "120", layer: "workspace"),
                ConfigEntry(key: "timeout_seconds", value: "6000", layer: "session"),
                ConfigEntry(key: "timeout_seconds", value: "90", layer: "mandatory")
            ]
            val config = test_config_resolve(entries)
            expect(config.timeout_seconds).to_equal(90)
            step("the resolved key reports as locked by mandatory policy")
            assert_true(config_is_locked(test_config_schema(), entries, "timeout_seconds"))

        it "mandatory memory ceiling survives an over-limit workspace value":
            step("workspace tries memory_limit_mb=999999; mandatory pins 512")
            val entries = [
                ConfigEntry(key: "memory_limit_mb", value: "512", layer: "mandatory"),
                ConfigEntry(key: "memory_limit_mb", value: "999999", layer: "workspace")
            ]
            val config = test_config_resolve(entries)
            expect(config.memory_limit_mb).to_equal(512)

    context "config file discovery":
        it "declares the canonical config path":
            expect(CONFIG_FILENAME).to_equal("config/simple.test.sdn")

        it "finds the config file or fails closed to empty":
            val path = find_config_file()
            assert_true(path == "" or path.ends_with(CONFIG_FILENAME))
