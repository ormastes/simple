use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_write, file_size, file_delete}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.test_runner.test_runner_async.{read_bounded_temp_output}
use std.test_runner.test_runner_types.{TEST_OUTPUT_CAPTURE_BYTES}

describe "test runner random-access file owner":
    it "retains the actual head and tail of oversized temporary output":
        val path = "/tmp/simple-random-access-owner-{time_now_unix_micros()}.txt"
        var middle = "x"
        while middle.len() < TEST_OUTPUT_CAPTURE_BYTES:
            middle = middle + middle
        val payload = "HEAD" + middle[0:TEST_OUTPUT_CAPTURE_BYTES] + "TAIL"

        expect(file_write(path, payload)).to_be(true)
        expect(file_size(path)).to_equal(TEST_OUTPUT_CAPTURE_BYTES + 8)

        val captured = read_bounded_temp_output(path)
        expect(captured).to_start_with("HEAD")
        expect(captured).to_contain("[output truncated: 8 bytes omitted]")
        expect(captured).to_end_with("TAIL")
        expect(file_delete(path)).to_be(true)
