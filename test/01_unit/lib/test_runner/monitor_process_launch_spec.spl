# @req REQ-SSPEC-UNIT
use std.spec.*
use std.test_runner.monitor_process_launch.{launch_monitor_script_detached}
use std.nogc_sync_mut.sosix.host_process_launch.{sosix_launch_background_script_for_host}
use std.nogc_sync_mut.io.process_ops.{shell_bool, shell_output_default}
use std.nogc_sync_mut.io.env_ops.{host_os}
use std.io_runtime.{thread_sleep}

fn _monitor_posix_shell_available() -> bool:
    val os = host_os()
    os == "linux" or os == "macos" or os == "freebsd" or os == "openbsd" or os == "netbsd" or os.starts_with("mingw") or os.starts_with("msys") or os.starts_with("cygwin")

fn _monitor_launch_and_reap():
    val pid = launch_monitor_script_detached("test/fixtures/test_runner/monitor launch's fixture.shs")
    expect((pid.to_i64() ?? 0) > 0).to_equal(true)
    expect(shell_bool("kill -0 {pid} 2>/dev/null")).to_equal(true)
    var process_name = ""
    var attempts = 0
    while attempts < 25 and not process_name.ends_with("sleep"):
        process_name = shell_output_default("ps -p {pid} -o comm= 2>/dev/null", "").trim()
        if not process_name.ends_with("sleep"):
            thread_sleep(10)
        attempts = attempts + 1
    expect(process_name.ends_with("sleep")).to_equal(true)
    val kill_sent = shell_bool("kill {pid} 2>/dev/null")
    expect(kill_sent).to_equal(true)
    attempts = 0
    var still_running = true
    while attempts < 25 and still_running:
        still_running = shell_bool("kill -0 {pid} 2>/dev/null")
        if still_running:
            thread_sleep(10)
        attempts = attempts + 1
    val remains = shell_bool("kill -0 {pid} 2>/dev/null")
    expect(remains).to_equal(false)

describe "detached test-runner monitor launch":
    it "rejects unbound SimpleOS and unknown hosted providers":
        expect(sosix_launch_background_script_for_host("simpleos", "test/fixtures/test_runner/monitor launch's fixture.shs")).to_equal("unsupported")
        expect(sosix_launch_background_script_for_host("unknown", "test/fixtures/test_runner/monitor launch's fixture.shs")).to_equal("unsupported")

    it "reports native Windows unsupported until detached stdio is bound":
        expect(sosix_launch_background_script_for_host("windows", "test/fixtures/test_runner/does-not-exist.bat")).to_equal("unsupported")

    it "rejects empty and NUL paths even for unbound hosts":
        expect(sosix_launch_background_script_for_host("unknown", "")).to_equal("")
        expect(sosix_launch_background_script_for_host("simpleos", "invalid\0path")).to_equal("")

    it "rejects embedded NUL before consulting the host":
        expect(sosix_launch_background_script_for_host("linux", "test/fixtures/test_runner/monitor launch's fixture.shs\0suffix")).to_equal("")

    it "refuses a missing script instead of returning the shell's background PID":
        step("file existence is checked before a detached shell can produce a misleading PID")
        expect(launch_monitor_script_detached("test/fixtures/test_runner/does-not-exist.shs")).to_equal("")

    skip_if(fn(): not _monitor_posix_shell_available(), "requires POSIX nohup, sh and kill")(
        "detaches a script path with spaces and apostrophes and returns its PID",
        fn():
            step("a synchronous shell facade owns launch while nohup detaches the child")
            _monitor_launch_and_reap()
    )
