use std.spec.{describe, it, expect}
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_types.{doctest_discovery_scope_path}

describe "doctest source scope follows explicit CLI targets":
    it "narrows source doctests to an explicit file":
        val path = "src/lib/example.spl"
        val options = parse_test_args([path, "--spl-doctest"])
        expect(options.path_explicit).to_equal(true)
        expect(doctest_discovery_scope_path(options)).to_equal(path)

    it "narrows source doctests to an explicit directory":
        val path = "src/lib/selected"
        val options = parse_test_args([path, "--spl-doctest"])
        expect(options.path_explicit).to_equal(true)
        expect(doctest_discovery_scope_path(options)).to_equal(path)

    it "keeps whole-repository test runs repository-scoped":
        val options = parse_test_args(["test", "--whole"])
        expect(doctest_discovery_scope_path(options)).to_equal("")
