"""Windows memory headroom fails closed (Err) instead of reaching raw kernel32 externs.

# @req REQ-TESTRUNNER-WINDOWS-HEADROOM
"""

use std.spec.*
use std.nogc_sync_mut.io.windows_process_owner.{windows_headroom_from_snapshot_v1, windows_available_memory_headroom_v1}

describe "windows headroom snapshot":
    it "accepts a positive runtime snapshot":
        expect(windows_headroom_from_snapshot_v1(4096).unwrap()).to_equal(4096)

    it "returns Err for a zero snapshot instead of aborting":
        expect(windows_headroom_from_snapshot_v1(0).is_err()).to_equal(true)

    it "returns Err for a negative snapshot":
        expect(windows_headroom_from_snapshot_v1(-1).is_err()).to_equal(true)

    it "live query returns Ok or Err without aborting":
        val r = windows_available_memory_headroom_v1()
        expect(r.is_ok() or r.is_err()).to_equal(true)
