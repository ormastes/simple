# stdlib_eprint_shadows_prelude_builtin_program_wide_2026-08-17
#
# `src/lib/nogc_sync_mut/io/process_ops.spl` deliberately declares `fn eprint`
# (real fd-2 routing for self-hosted compiler diagnostics; the bug doc's
# re-diagnosis forbids renaming it). The native-lane half of the bug is fixed
# compiler-side: `eprint` is admitted by `is_interp_builtin_fn`
# (src/compiler/20.hir/hir_lowering/_Expressions/expression_support.spl:60),
# so an ordinary program calling `eprint(...)` no longer dies with
# "unresolved name: eprint" under native-build.
#
# Interpreter-lane regression: `eprint` must resolve and execute from plain
# user code, must accept text and int arguments, and must not disturb the
# values computed around it.

describe "stdlib eprint prelude builtin":
    it "resolves eprint from user code and leaves program state intact":
        var acc: [text] = []
        eprint("diagnostic line")
        acc.push("after-text")
        eprint(42)
        acc.push("after-int")
        eprint("count={acc.len()}")
        expect(acc.len()).to_equal(2)
        expect(acc[0]).to_equal("after-text")
        expect(acc[1]).to_equal("after-int")

    it "eprint calls compose with control flow without corrupting branches":
        var seen = 0
        var i = 0
        while i < 3:
            if i == 1:
                eprint("middle iteration")
            seen = seen + i
            i += 1
        expect(seen).to_equal(3)
