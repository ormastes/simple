extern fn rt_file_read_text(path: text) -> text?

describe "mqtt auth header guard":
    it "guards auth header access before tuple indexing":
        val sync_source = rt_file_read_text("src/lib/nogc_sync_mut/mqtt/utilities.spl") ?? ""
        val nogc_async_source = rt_file_read_text("src/lib/nogc_async_mut/mqtt/utilities.spl") ?? ""
        val async_source = rt_file_read_text("src/lib/gc_async_mut/mqtt/utilities.spl") ?? ""

        expect(sync_source).to_contain("fn mqtt_auth_get_reason_code(packet: MqttPacket?)")
        expect(sync_source).to_contain("MqttHeaders.Auth(parts):")
        expect(sync_source).to_contain("return REASON_NORMAL_DISCONNECTION")
        expect(nogc_async_source).to_contain("MqttHeaders.Auth(parts):")
        expect(async_source).to_contain("fn mqtt_auth_get_method(packet: MqttPacket?)")
        expect(async_source).to_contain("return nil")
