use std.spec
use std.nogc_sync_mut.mqtt.types.{MqttHeaders, MqttPayload, mqtt_packet_type, mqtt_create_packet}
use std.nogc_sync_mut.mqtt.connect.{mqtt_create_connect_packet, mqtt_connect_set_credentials, mqtt_connect_set_will, mqtt_connect_get_client_id, mqtt_connect_get_keep_alive, mqtt_connect_has_clean_session, mqtt_connect_has_will, mqtt_connect_get_will_qos, mqtt_connect_get_protocol_version}
use std.nogc_sync_mut.mqtt.packet.{mqtt_set_qos_in_flags, mqtt_get_qos_from_flags, mqtt_set_retain_flag}
use std.nogc_sync_mut.mqtt.publish.{mqtt_create_connack_packet, mqtt_connack_get_return_code, mqtt_connack_has_session_present, mqtt_create_publish_packet, mqtt_publish_set_packet_id, mqtt_publish_get_topic, mqtt_publish_get_packet_id, mqtt_publish_get_qos, mqtt_create_puback_packet}
use std.nogc_sync_mut.mqtt.subscribe.{mqtt_pubx_get_packet_id, mqtt_create_subscribe_packet, mqtt_subscribe_add_topic_filter, mqtt_subscribe_get_packet_id, mqtt_subscribe_get_topic_filters, mqtt_create_suback_packet, mqtt_suback_get_return_codes, mqtt_create_unsubscribe_packet, mqtt_unsubscribe_get_topics, mqtt_create_unsuback_packet, mqtt_unsuback_get_packet_id}
use std.nogc_sync_mut.mqtt.utilities.{mqtt_create_disconnect_packet, mqtt_create_disconnect_packet_v5, mqtt_disconnect_get_reason_code, mqtt_create_auth_packet, mqtt_auth_get_reason_code, mqtt_auth_get_method, mqtt_auth_get_data, mqtt_topic_is_valid, mqtt_topic_matches_filter, mqtt_topic_get_level}

describe "mqtt typed packet behaviour":
    it "round-trips connect packet fields":
        val c = mqtt_create_connect_packet("cid", true, 60, 4)
        val c3 = mqtt_connect_set_will(mqtt_connect_set_credentials(c, "u", "p"), "wt", "wm", 1, true)
        expect(mqtt_connect_get_client_id(c3)).to_equal("cid")
        expect(mqtt_connect_get_keep_alive(c3)).to_equal(60)
        expect(mqtt_connect_has_clean_session(c3)).to_equal(true)
        expect(mqtt_connect_has_will(c3)).to_equal(true)
        expect(mqtt_connect_get_will_qos(c3)).to_equal(1)
        expect(mqtt_connect_get_protocol_version(nil)).to_equal(4)

    it "round-trips connack and publish fields":
        val ck = mqtt_create_connack_packet(true, 0)
        expect(mqtt_connack_get_return_code(ck)).to_equal(0)
        expect(mqtt_connack_has_session_present(ck)).to_equal(true)
        expect(mqtt_connack_get_return_code(nil)).to_equal(3)
        val p2 = mqtt_publish_set_packet_id(mqtt_create_publish_packet("a/b", "hello", 1, true), 42)
        expect(mqtt_publish_get_topic(p2)).to_equal("a/b")
        expect(mqtt_publish_get_packet_id(p2)).to_equal(42)
        expect(mqtt_publish_get_qos(p2)).to_equal(1)
        expect(mqtt_pubx_get_packet_id(mqtt_create_puback_packet(9))).to_equal(9)

    it "round-trips subscribe family payloads":
        val s = mqtt_subscribe_add_topic_filter(mqtt_create_subscribe_packet(5, [("x", 0)]), "y/#", 1)
        expect(mqtt_subscribe_get_packet_id(s)).to_equal(5)
        expect(mqtt_subscribe_get_topic_filters(s).len()).to_equal(2)
        expect(mqtt_subscribe_get_topic_filters(nil).len()).to_equal(0)
        expect(mqtt_suback_get_return_codes(mqtt_create_suback_packet(3, [0, 1])).len()).to_equal(2)
        expect(mqtt_unsubscribe_get_topics(mqtt_create_unsubscribe_packet(4, ["q"])).len()).to_equal(1)
        expect(mqtt_unsuback_get_packet_id(mqtt_create_unsuback_packet(8))).to_equal(8)

    it "round-trips disconnect, auth and defaults":
        expect(mqtt_disconnect_get_reason_code(mqtt_create_disconnect_packet())).to_equal(0)
        expect(mqtt_disconnect_get_reason_code(mqtt_create_disconnect_packet_v5(4))).to_equal(4)
        val a = mqtt_create_auth_packet(24, "m", "d")
        expect(mqtt_auth_get_reason_code(a)).to_equal(24)
        expect(mqtt_auth_get_method(a)).to_equal("m")
        expect(mqtt_auth_get_data(a)).to_equal("d")
        expect(mqtt_packet_type(a)).to_equal(15)
        expect(mqtt_packet_type(nil)).to_equal(0)

    it "validates and matches topics":
        expect(mqtt_topic_is_valid("a/b")).to_equal(true)
        expect(mqtt_topic_is_valid(nil)).to_equal(false)
        expect(mqtt_topic_matches_filter("a/b/c", "a/+/c")).to_equal(true)
        expect(mqtt_topic_matches_filter("a/b/c", "a/#")).to_equal(true)
        expect(mqtt_topic_get_level("a/b/c", 1)).to_equal("b")
        expect(mqtt_topic_get_level("a/b/c", 5)).to_equal(nil)
