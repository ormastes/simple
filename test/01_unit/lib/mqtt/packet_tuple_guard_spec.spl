extern fn rt_file_read_text(path: text) -> text?

describe "mqtt packet guard":
    it "defaults a missing packet through the typed MqttPacket? unwrap":
        val sync_source = rt_file_read_text("src/lib/nogc_sync_mut/mqtt/types.spl") ?? ""
        val nogc_async_source = rt_file_read_text("src/lib/nogc_async_mut/mqtt/types.spl") ?? ""
        val async_source = rt_file_read_text("src/lib/gc_async_mut/mqtt/types.spl") ?? ""

        expect(sync_source).to_contain("struct MqttPacket:")
        expect(sync_source).to_contain("fn mqtt_packet_or_default(packet: MqttPacket?) -> MqttPacket:")
        expect(sync_source).to_contain("if val p = packet:")
        expect(nogc_async_source).to_contain("struct MqttPacket:")
        expect(nogc_async_source).to_contain("fn mqtt_packet_or_default(packet: MqttPacket?) -> MqttPacket:")
        expect(nogc_async_source).to_contain("if val p = packet:")
        expect(async_source).to_contain("struct MqttPacket:")
        expect(async_source).to_contain("fn mqtt_packet_or_default(packet: MqttPacket?) -> MqttPacket:")
        expect(async_source).to_contain("if val p = packet:")
