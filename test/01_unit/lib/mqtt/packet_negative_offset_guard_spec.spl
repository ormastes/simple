extern fn rt_file_read_text(path: text) -> text

fn _contains_negative_offset_guard(path: text) -> bool:
    val source = rt_file_read_text(path) ?? ""
    # Signatures carry explicit param/return types so the module compiles
    # natively instead of falling back whole-module to the interpreter
    # (HIR: untyped parameters). The invariant under test is unchanged:
    # every decode helper guards negative offsets before field indexing.
    return source.to_contain("fn mqtt_decode_string(bytes: [i64], offset: i64) -> (text, i64)?:") and
        source.to_contain("fn mqtt_decode_binary(bytes: [i64], offset: i64) -> ([i64], i64)?:") and
        source.to_contain("fn mqtt_decode_two_byte_int(bytes: [i64], offset: i64) -> (i64, i64)?:") and
        source.to_contain("fn mqtt_decode_four_byte_int(bytes: [i64], offset: i64) -> (i64, i64)?:") and
        source.to_contain("fn mqtt_decode_variable_byte_int(bytes: [i64], offset: i64) -> (i64, i64)?:") and
        source.to_contain("if offset < 0:\n        return nil")

describe "mqtt packet negative offset guard":
    it "guards mirrored packet decode helpers before field indexing":
        expect(_contains_negative_offset_guard("src/lib/nogc_sync_mut/mqtt/packet.spl")).to_equal(true)
        expect(_contains_negative_offset_guard("src/lib/nogc_async_mut/mqtt/packet.spl")).to_equal(true)
        expect(_contains_negative_offset_guard("src/lib/gc_async_mut/mqtt/packet.spl")).to_equal(true)

        val facade_source = rt_file_read_text("src/lib/gc_sync_mut/mqtt/packet.spl") ?? ""
        expect(facade_source).to_contain("export use std.gc_async_mut.mqtt.packet.*")
