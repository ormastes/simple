# @cover src/lib/common/env_access/model.spl 80%
use std.spec
use std.common.env_access.model.*
use std.common.env_access.executor.*

val SHA256_A = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val SHA256_B = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn probe_tool(path: text) -> EnvToolIdentity:
    EnvToolIdentity(
        tool_id: "probe",
        canonical_path: path,
        identity_hash: SHA256_A
    )

fn read_instruction(resource: text) -> EnvAccessInstruction:
    EnvAccessInstruction(
        kind: EnvAccessKind.ReadRepoFile,
        resource: resource,
        arguments: [],
        timeout_ms: 100,
        max_stdout_bytes: 128,
        max_stderr_bytes: 128
    )

fn tool_instruction(tool: text) -> EnvAccessInstruction:
    EnvAccessInstruction(
        kind: EnvAccessKind.RunAllowedTool,
        resource: tool,
        arguments: ["--identity"],
        timeout_ms: 100,
        max_stdout_bytes: 128,
        max_stderr_bytes: 128
    )

fn executed_receipt(plan_id: text, index: i64) -> EnvAccessReceipt:
    EnvAccessReceipt(
        plan_id: plan_id,
        instruction_index: index,
        status: EnvAccessStatus.Executed,
        exit_code: 0,
        stdout_hash: SHA256_A,
        stderr_hash: SHA256_B,
        discarded_bytes: 0,
        reason: "",
        prerequisite: "",
        owner: "",
        artifact_paths: [],
        resume_command: ""
    )

describe "bounded typed environment plans":
    it "rejects escaping repo reads and tools outside the allowlist":
        expect(env_access_instruction_error(read_instruction("../secret"))).to_equal("ENV-E-REPO-PATH")
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [tool_instruction("probe")],
            max_total_bytes: 256,
            max_processes: 1,
            allowed_tools: [EnvToolIdentity(
                tool_id: "other-probe",
                canonical_path: "/workspace/tools/other-probe",
                identity_hash: SHA256_B
            )],
            allowed_hardware_probes: []
        )
        expect(env_access_plan_error(plan)).to_equal("ENV-E-TOOL-NOT-ALLOWED")

    it "rejects aggregate capture budgets before execution":
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [read_instruction("fixtures/board.id"), read_instruction("fixtures/driver.id")],
            max_total_bytes: 300,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: []
        )
        expect(env_access_plan_error(plan)).to_equal("ENV-E-TOTAL-BYTES")

    it "validates receipts in deterministic instruction order":
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [read_instruction("fixtures/board.id"), read_instruction("fixtures/driver.id")],
            max_total_bytes: 512,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: []
        )
        val ordered = [executed_receipt("rt-hal", 0), executed_receipt("rt-hal", 1)]
        val reversed = [executed_receipt("rt-hal", 1), executed_receipt("rt-hal", 0)]
        expect(env_access_receipts_error(plan, ordered)).to_equal("")
        expect(env_access_receipts_error(plan, reversed)).to_equal("ENV-E-RECEIPT-ORDER")

    it "rejects Windows separators and noncanonical tool paths":
        expect(env_access_instruction_error(read_instruction("fixtures\\board.id"))).to_equal("ENV-E-REPO-PATH")
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [tool_instruction("probe")],
            max_total_bytes: 256,
            max_processes: 1,
            allowed_tools: [probe_tool("probe-from-PATH")],
            allowed_hardware_probes: []
        )
        expect(env_access_plan_error(plan)).to_equal("ENV-E-TOOL-PATH")

class FakeEnvCapability:
    resolved_repo_path: text?
    resolved_tool_path: text?
    emitted_stdout: text
    elapsed_ms: i64

impl EnvAccessCapability for FakeEnvCapability:
    fn canonical_repo_path(canonical_repo_root: text, relative_path: text) -> text?:
        val _ = canonical_repo_root
        val _ = relative_path
        return self.resolved_repo_path

    fn canonical_tool_path(tool_id: text, identity_hash: text) -> text?:
        val _ = tool_id
        val _ = identity_hash
        return self.resolved_tool_path

    fn execute_bounded(instruction: EnvAccessInstruction,
                       canonical_resource: text) -> EnvAccessRawResult:
        val _ = instruction
        val _ = canonical_resource
        return EnvAccessRawResult(
            status: EnvAccessStatus.Executed,
            exit_code: 0,
            stdout: self.emitted_stdout,
            stderr: "",
            discarded_bytes: 0,
            elapsed_ms: self.elapsed_ms,
            reason: "",
            prerequisite: "",
            owner: "",
            artifact_paths: [],
            resume_command: ""
        )

describe "injected environment capability":
    it "fails closed when canonical symlink resolution is unknown":
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [read_instruction("fixtures/board.id")],
            max_total_bytes: 256,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: []
        )
        val capability = FakeEnvCapability(
            resolved_repo_path: nil, resolved_tool_path: nil,
            emitted_stdout: "", elapsed_ms: 1)
        val receipts = env_access_execute(plan, capability).unwrap()
        expect(receipts[0].status).to_equal(EnvAccessStatus.Rejected)

    it "rejects a tool when the injected canonical identity differs":
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [tool_instruction("probe")],
            max_total_bytes: 256,
            max_processes: 1,
            allowed_tools: [probe_tool("/workspace/tools/probe")],
            allowed_hardware_probes: []
        )
        val capability = FakeEnvCapability(
            resolved_repo_path: nil,
            resolved_tool_path: Some("/different/probe"),
            emitted_stdout: "",
            elapsed_ms: 1
        )
        val receipts = env_access_execute(plan, capability).unwrap()
        expect(receipts[0].status).to_equal(EnvAccessStatus.Rejected)

    it "parent rejects capability output and elapsed time outside the request":
        val plan = EnvAccessPlan(
            plan_id: "rt-hal",
            canonical_repo_root: "/workspace/repo",
            instructions: [read_instruction("fixtures/board.id")],
            max_total_bytes: 256,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: []
        )
        val oversized = FakeEnvCapability(
            resolved_repo_path: Some("/workspace/repo/fixtures/board.id"),
            resolved_tool_path: nil,
            emitted_stdout: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
            elapsed_ms: 1
        )
        expect(env_access_execute(plan, oversized).unwrap_err()).to_equal("ENV-E-OUTPUT-CAP")
        val overdue = FakeEnvCapability(
            resolved_repo_path: Some("/workspace/repo/fixtures/board.id"),
            resolved_tool_path: nil,
            emitted_stdout: "value",
            elapsed_ms: 101
        )
        expect(env_access_execute(plan, overdue).unwrap_err()).to_equal("ENV-E-TIMEOUT-CAP")

describe "reason-required environment scenario omission":
    it "accepts execution without omission metadata":
        expect(env_scenario_selection_error(env_scenario_execute("irq-replay"))).to_equal("")

    it "rejects a reasonless skip":
        val selection = env_scenario_skip(
            "physical-board", "", "hal-team", "BUG-42",
            "physical board", [], "simple test --tag=physical-board")
        expect(env_scenario_selection_error(selection)).to_equal("ENV-E-OMISSION-REASON")

    it "requires prerequisite and resume evidence for unavailable scenarios":
        val selection = env_scenario_skip(
            "physical-board", "board is unavailable in hosted CI", "hal-team",
            "BUG-42", "", [], "")
        expect(env_scenario_selection_error(selection)).to_equal("ENV-B-BLOCKED-INCOMPLETE")

    it "requires a contained canonical artifact path":
        val absent = env_scenario_skip(
            "physical-board", "board is unavailable in hosted CI", "hal-team",
            "BUG-42", "physical board", [], "simple test --tag=physical-board")
        expect(env_scenario_selection_error(absent)).to_equal("ENV-B-BLOCKED-INCOMPLETE")
        val traversal = env_scenario_skip(
            "physical-board", "board is unavailable in hosted CI", "hal-team",
            "BUG-42", "physical board", ["../private/receipt.sdn"],
            "simple test --tag=physical-board")
        expect(env_scenario_selection_error(traversal)).to_equal("ENV-E-ARTIFACT-PATH")
        val canonical = env_scenario_skip(
            "physical-board", "board is unavailable in hosted CI", "hal-team",
            "BUG-42", "physical board", ["artifacts/hal/receipt.sdn"],
            "simple test --tag=physical-board")
        expect(env_scenario_selection_error(canonical)).to_equal("")

    it "requires canonical repo-relative evidence on unavailable receipts":
        val missing = EnvAccessReceipt(
            plan_id: "physical-board", instruction_index: 0,
            status: EnvAccessStatus.Unsupported, exit_code: -1,
            stdout_hash: "", stderr_hash: "", discarded_bytes: 0,
            reason: "probe is unavailable", prerequisite: "attach board",
            owner: "hal-team", artifact_paths: [],
            resume_command: "rerun the physical-board plan")
        expect(env_access_receipt_error(missing)).to_equal("ENV-B-BLOCKED-INCOMPLETE")
        val escaping = EnvAccessReceipt(
            plan_id: "physical-board", instruction_index: 0,
            status: EnvAccessStatus.Unsupported, exit_code: -1,
            stdout_hash: "", stderr_hash: "", discarded_bytes: 0,
            reason: "probe is unavailable", prerequisite: "attach board",
            owner: "hal-team", artifact_paths: ["../private/receipt.sdn"],
            resume_command: "rerun the physical-board plan")
        expect(env_access_receipt_error(escaping)).to_equal("ENV-E-ARTIFACT-PATH")
        val canonical_receipt = EnvAccessReceipt(
            plan_id: "physical-board", instruction_index: 0,
            status: EnvAccessStatus.Unsupported, exit_code: -1,
            stdout_hash: "", stderr_hash: "", discarded_bytes: 0,
            reason: "probe is unavailable", prerequisite: "attach board",
            owner: "hal-team", artifact_paths: ["artifacts/hal/receipt.sdn"],
            resume_command: "rerun the physical-board plan")
        expect(env_access_receipt_error(canonical_receipt)).to_equal("")

    it "requires reviewed exclusions to expire or name a version":
        val selection = env_scenario_exclude(
            "destructive-power-cycle",
            "the shared capture host cannot be power-cycled",
            "hal-team",
            "SAFETY-17",
            ""
        )
        expect(env_scenario_selection_error(selection)).to_equal("ENV-E-EXCLUSION-STALE")
