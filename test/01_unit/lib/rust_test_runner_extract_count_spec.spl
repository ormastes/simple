"""
## Purpose and audience
Purpose: Prove that `extract_count` parses a numeric token out of a Rust test
summary line without invoking a method that does not exist in the tree.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-TEST-RUNNER-001 — stable requirement identity for this spec.

"""
# Rust Test Runner — extract_count Spec

Reproduce spec for the phantom-method defect class. `extract_count` used to
call `.to_int_or(-1)`, a method with ZERO definitions anywhere in the tree, so
reaching this path aborted at runtime with

    semantic: method `to_int_or` not found on type `str`

The `-1` is a SENTINEL: the loop keeps scanning words until one parses, and
`num >= 0` is the "did it parse" test. Swapping in the builtin `.to_int()`
would have been wrong here — it fails open to `0`, which passes `>= 0`, so the
first non-numeric word would be returned as a count of zero. The fix uses
`try_parse_int(...) ?? -1`, which preserves the sentinel. The third example
below is what pins that distinction.

See doc/08_tracking/bug/phantom_conversion_methods_to_int_or_2026-08-27.md
"""

use std.spec.{describe, it, expect}
use std.spec.step
use std.test_runner.rust_test_runner.{extract_count}

describe "extract_count":
    it "extracts the count preceding the keyword":
        step("Verify: a well-formed summary segment yields its number")
        expect(extract_count("test result: ok. 42 passed; 0 failed", "passed")).to_equal(42)

    it "returns 0 when the keyword is absent":
        step("Verify: no matching segment yields the 0 fallback")
        expect(extract_count("test result: ok. 42 passed", "ignored")).to_equal(0)

    it "skips non-numeric words rather than reading them as zero":
        step("Verify: the -1 sentinel still discriminates unparseable words")
        # "finished" precedes the number; a fail-open-to-0 parse would stop
        # there and wrongly report 0.
        expect(extract_count("finished 7 leaked", "leaked")).to_equal(7)
