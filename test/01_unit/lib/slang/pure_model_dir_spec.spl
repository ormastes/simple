# Model-directory resolution for the pure-runner specs: no hardcoded path.

use std.spec.{describe, it, expect}
use test.fixtures.slang_pure.model_dir.{pure_model_dir_from}

describe "pure_model_dir_from":
    it "prefers SLANG_PURE_MODEL":
        expect(pure_model_dir_from("D:/m/x", "E:/root")).to_equal("D:/m/x")

    it "falls back to llama2c-stories15M under SLANG_MODEL_ROOT":
        expect(pure_model_dir_from("", "E:/root")).to_equal("E:/root/llama2c-stories15M")
        expect(pure_model_dir_from("", "E:/root/")).to_equal("E:/root/llama2c-stories15M")

    it "has no built-in default path":
        expect(pure_model_dir_from("", "")).to_equal("")
