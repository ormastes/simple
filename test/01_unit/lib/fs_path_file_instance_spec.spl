# Companion to fs_file_statics_resolve_spec.spl: the narrower instance-style
# File in std.fs.path must keep resolving and working after the flat fs module
# moved into the package as std.fs.flat
# (doc/08_tracking/bug/fs_file_class_collision_wrong_static_method_2026-09-01).
# Kept in a separate spec file because importing both File classes into one
# closure hits the separate name-keyed class-collision compiler defect.
use std.spec.{describe, it, expect, is_windows}
use std.fs.path.{Path, File}
use std.nogc_sync_mut.io_runtime.{file_delete}

fn probe_path(tag: text) -> text:
    "/tmp/simple_fs_path_file_spec_{tag}.txt"

describe "std.fs.path.File instance API still resolves":
    it "File.new(path).exists and .write/.read round-trip":
        if is_windows():
            return
        val p = Path(path: probe_path("instance"))
        val f = File.new(p)
        val _ = file_delete(p.to_string())
        expect(f.exists()).to_equal(false)
        expect(f.write("path file body")).to_equal(true)
        expect(f.exists()).to_equal(true)
        expect(f.read()).to_equal("path file body")
        expect(f.delete()).to_equal(true)
        expect(f.exists()).to_equal(false)
