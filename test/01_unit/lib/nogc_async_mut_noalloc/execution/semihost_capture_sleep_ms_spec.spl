# @req REQ-EXEC-SEMIHOST-SLEEP
# Regression spec for sleep_ms sub-second truncation bug.
#
# semihost_capture.read_output_file() calls sleep_ms(100) to give the QEMU
# process time to flush output before reading it. The buggy implementation
# computed `seconds = ms / 1000` (integer division), which truncates any
# ms < 1000 to 0 seconds — so sleep_ms(100) never slept at all, racing the
# just-launched process. This spec measures real wall-clock elapsed time
# around sleep_ms(300) and asserts it actually blocked for a meaningful
# fraction of a second.

use std.execution.semihost_capture.{sleep_ms}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn now_ms() -> i64:
    val (stdout, stderr, exit_code) = rt_process_run("/bin/sh", ["-c", "date +%s%3N"])
    var result: i64 = 0
    for c in stdout.trim():
        if c >= "0" and c <= "9":
            val d = (c.char_code_at(0) - "0".char_code_at(0)) as i64
            result = result * 10 + d
    result

describe "sleep_ms sub-second durations":
    it "actually blocks for sub-second millisecond values (300ms)":
        val start = now_ms()
        sleep_ms(300)
        val elapsed = now_ms() - start
        # Old buggy code: seconds = 300 / 1000 = 0 -> no sleep -> elapsed ~0ms.
        # Fixed code should block for close to 300ms (allow generous slack
        # for process-spawn overhead / CI jitter, but must be well above the
        # near-zero elapsed time the bug produced).
        expect(elapsed).to_be_greater_than(150)
