# WP-18 (observed-max-execution-time harness) spec for
# doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md.
#
# Proves ObservedMaxTracker correctly identifies the maximum across a set of
# runs with known, controlled durations.
#
# Timing mechanism used: async/timer.spl's timer_now() is, in interpreter
# mode (the engine `bin/simple test` runs on -- see .claude/rules/testing.md),
# a monotonic counter that increments by exactly 1 per call, with no
# wall-clock component. No real sleep/delay primitive is available or safe to
# depend on for a deterministic unit test here, so each probe closure below
# calls timer_now() a controlled, known number of extra times to stand in for
# "duration" -- this is a call-count proxy for time, not a real elapsed-time
# measurement, and it is deterministic by construction (each call to
# timer_now() advances the counter by exactly 1). This is stated explicitly
# per the acceptance criteria: it is a loop-count-style proxy, chosen because
# it is the only deterministic, controllable "timing" this codebase's own
# timer primitive offers in interpreter mode.
#
# Exact tick arithmetic, verified empirically before writing the assertions
# below (record_run() itself calls timer_now() twice -- once for `start`,
# once inside timer_elapsed() to read the end -- on top of whatever the
# probed closure calls): a closure that calls timer_now() N times inside
# record_run() reads back as N + 1 elapsed ticks, not N.

use std.nogc_async_mut_noalloc.async.wcet_adapter.{ObservedMaxTracker}
use std.nogc_async_mut_noalloc.async.timer.{timer_now}

describe "ObservedMaxTracker observed-maximum measurement (WP-18)":
    """Proves the tracker records elapsed-tick samples per run and reports
    the true maximum across a controlled set of run durations."""

    it "reports the maximum elapsed ticks across three runs of known, controlled duration":
        val tracker = ObservedMaxTracker.new()

        # Run 1: 2 extra timer_now() calls inside the closure -> 3 elapsed
        # ticks (N + 1, see file header).
        val r1 = tracker.record_run(fn():
            timer_now()
            timer_now()
        )
        expect(r1).to_equal(3)

        # Run 2: 5 extra timer_now() calls -> 6 elapsed ticks (the max).
        val r2 = tracker.record_run(fn():
            timer_now()
            timer_now()
            timer_now()
            timer_now()
            timer_now()
        )
        expect(r2).to_equal(6)

        # Run 3: 1 extra timer_now() call -> 2 elapsed ticks (the min).
        val r3 = tracker.record_run(fn():
            timer_now()
        )
        expect(r3).to_equal(2)

        expect(tracker.sample_count()).to_equal(3)
        expect(tracker.observed_max_ticks()).to_equal(6)
        expect(tracker.observed_min_ticks()).to_equal(2)

    it "reports 0 for an empty tracker (no data, not a zero-duration claim)":
        val tracker = ObservedMaxTracker.new()
        expect(tracker.sample_count()).to_equal(0)
        expect(tracker.observed_max_ticks()).to_equal(0)
        expect(tracker.observed_min_ticks()).to_equal(0)

    it "accepts pre-measured samples directly via record_sample":
        val tracker = ObservedMaxTracker.new()
        tracker.record_sample(10)
        tracker.record_sample(42)
        tracker.record_sample(7)
        expect(tracker.sample_count()).to_equal(3)
        expect(tracker.observed_max_ticks()).to_equal(42)
