# WP-18 (target timing model) spec for
# doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md.
#
# Proves TargetTimingModel's tick<->millisecond conversion is correct for a
# known ticks_per_ms rate, and that a non-positive rate degrades to 0 instead
# of dividing by zero.

"""
## Purpose and audience
Purpose: Verify TargetTimingModel tick/ms conversion (WP-18).
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-TIMING-MODEL-001 — stable requirement identity for this spec.

use std.nogc_async_mut_noalloc.async.timing_model.{TargetTimingModel}

use std.spec.step

describe "TargetTimingModel tick/ms conversion (WP-18)":
    """Proves the declared ticks-per-ms conversion rate is applied correctly
    in both directions for a known input, and is safe against a
    non-positive rate."""

    it "converts ticks to milliseconds for a known 1000-ticks-per-ms rate":
        step("Verify: converts ticks to milliseconds for a known 1000-ticks-per-ms rate")
        # @req: REQ-LIB-TIMING-MODEL-001
        val model = TargetTimingModel.new("test-1MHz-1kHz-tick", 1000)
        expect(model.ticks_to_ms(5000)).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
        expect(model.ticks_to_ms(999)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(model.ticks_to_ms(1000)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(model.ticks_to_ms(0)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "converts milliseconds to ticks for a known 1000-ticks-per-ms rate":
        step("Verify: converts milliseconds to ticks for a known 1000-ticks-per-ms rate")
        val model = TargetTimingModel.new("test-1MHz-1kHz-tick", 1000)
        expect(model.ms_to_ticks(5)).to_equal(5000)  # oracle: authoritative expected value documented by this spec's contract
        expect(model.ms_to_ticks(0)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "round-trips ms -> ticks -> ms for a known rate":
        step("Verify: round-trips ms -> ticks -> ms for a known rate")
        val model = TargetTimingModel.new("test-100-ticks-per-ms", 100)
        val ms = 7
        val ticks = model.ms_to_ticks(ms)
        expect(ticks).to_equal(700)  # oracle: authoritative expected value documented by this spec's contract
        expect(model.ticks_to_ms(ticks)).to_equal(ms)

    it "does not divide by zero when ticks_per_ms is non-positive":
        step("Verify: does not divide by zero when ticks_per_ms is non-positive")
        val bad_model = TargetTimingModel.new("bad-zero-rate", 0)
        expect(bad_model.ticks_to_ms(5000)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(bad_model.ms_to_ticks(5)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        val negative_model = TargetTimingModel.new("bad-negative-rate", -10)
        expect(negative_model.ticks_to_ms(5000)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(negative_model.ms_to_ticks(5)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
