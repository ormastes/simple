# Repro + prevention for seed_jit_wide_literal_match_u64_misevaluates_2026-08-28.
# A literal-arm `match` on a u64 scrutinee must agree with equality for every
# arm, including arms above i64::MAX (interpreter used to compare the literal as
# signed i64 against a Value::UInt) and for the real riscv CSR table.

use std.nogc_async_mut_noalloc.baremetal.riscv.csr.{csr_is_supported}

fn wide_arm(addr: u64) -> bool:
    match addr:
        case 0x8000000000000000: true
        case 0xFFFFFFFFFFFFFFFF: true
        case 0xF14: true
        case 0x300: true
        case _: false

describe "u64 literal-arm match":
    it "matches arms above i64::MAX":
        expect(wide_arm(0x8000000000000000)).to_equal(true)
        expect(wide_arm(0xFFFFFFFFFFFFFFFF)).to_equal(true)

    it "matches small arms and rejects non-arms":
        expect(wide_arm(0xF14)).to_equal(true)
        expect(wide_arm(0x300)).to_equal(true)
        expect(wide_arm(1)).to_equal(false)
        expect(wide_arm(0x7FFFFFFFFFFFFFFF)).to_equal(false)

    it "keeps the riscv CSR support table correct in module context":
        expect(csr_is_supported(0xF14)).to_equal(true)
        expect(csr_is_supported(0x300)).to_equal(true)
        expect(csr_is_supported(0x7FF)).to_equal(false)
