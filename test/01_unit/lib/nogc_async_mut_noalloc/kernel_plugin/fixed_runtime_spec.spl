use common.kernel_plugin.contracts.{
    KpfMemoryContractV1,
    KPF_FLAG_FALSE,
    KPF_MEMORY_NOGC_BOUNDED,
    KPF_MEMORY_STATIC_NOALLOC,
}
use std.nogc_async_mut_noalloc.kernel_plugin.fixed_runtime.{
    KpfFixedRuntime,
    KpfFixedRuntimeConfig,
    KpfNoallocPhase,
    KpfNoallocStatus,
}
use std.spec.step

fn memory_contract(maximum_sessions: u32, maximum_inflight: u32) -> KpfMemoryContractV1:
    KpfMemoryContractV1(
        memory_class: KPF_MEMORY_STATIC_NOALLOC,
        initialization_bytes: 0u64,
        persistent_bytes_per_instance: 8u64,
        bytes_per_session: 16u64,
        bytes_per_inflight_request: 4u64,
        input_alignment: 8u32,
        output_alignment: 8u32,
        maximum_sessions: maximum_sessions,
        maximum_inflight_per_session: maximum_inflight,
        maximum_batch_items: 8u32,
        may_allocate_after_activation: KPF_FLAG_FALSE,
        reserved0: 0u32,
    )

fn runtime(arena_bytes: u64, session_capacity: u32, inflight_per_session: u32, request_capacity: i32) -> KpfFixedRuntime:
    match KpfFixedRuntime.create(KpfFixedRuntimeConfig(
        memory: memory_contract(session_capacity, inflight_per_session),
        arena_capacity_bytes: arena_bytes,
        request_capacity: request_capacity,
    )):
        case Ok(value): value
        case Err(_): panic("runtime creation failed")

describe "strict fixed-capacity KPF projection":
    it "rejects non-strict memory classes before activation":
        step("Reject non-strict memory classes at the seal boundary")
        var memory = memory_contract(1u32, 1u32)
        memory.memory_class = KPF_MEMORY_NOGC_BOUNDED
        expect(KpfFixedRuntime.create(KpfFixedRuntimeConfig(
            memory: memory, arena_capacity_bytes: 64u64, request_capacity: 1,
        ))).to_equal(Err(KpfNoallocStatus.InvalidConfiguration))

    it "seals once and refuses work before activation":
        step("Require the explicit activation boundary")
        var value = runtime(64u64, 1u32, 1u32, 1)
        expect(value.phase()).to_equal(KpfNoallocPhase.Configuring)
        expect(value.open_session().status).to_equal(KpfNoallocStatus.InvalidPhase)
        expect(value.activate()).to_equal(KpfNoallocStatus.Ok)
        expect(value.activate()).to_equal(KpfNoallocStatus.InvalidPhase)
        expect(value.phase()).to_equal(KpfNoallocPhase.Active)

    it "rejects an undersized arena while the composition is still configuring":
        step("Mutation guard: omitting persistent arena accounting admits an impossible seal")
        expect(KpfFixedRuntime.create(KpfFixedRuntimeConfig(
            memory: memory_contract(1u32, 1u32),
            arena_capacity_bytes: 7u64,
            request_capacity: 1,
        ))).to_equal(Err(KpfNoallocStatus.CapacityExceeded))

    it "distinguishes per-session backpressure from global capacity exhaustion":
        step("Return WouldBlock for a full session and CapacityExceeded for the fixed request table")
        var value = runtime(128u64, 2u32, 1u32, 1)
        expect(value.activate()).to_equal(KpfNoallocStatus.Ok)
        val first_session = value.open_session().handle
        val second_session = value.open_session().handle
        val first_request = value.submit(first_session)
        expect(first_request.status).to_equal(KpfNoallocStatus.Ok)
        expect(value.submit(first_session).status).to_equal(KpfNoallocStatus.WouldBlock)
        expect(value.submit(second_session).status).to_equal(KpfNoallocStatus.CapacityExceeded)

    it "accounts arena bytes exactly and performs zero post-activation allocations":
        step("Exercise valid open submit complete close operations without active allocation")
        var value = runtime(28u64, 1u32, 1u32, 1)
        expect(value.activate()).to_equal(KpfNoallocStatus.Ok)
        expect(value.arena_used_bytes()).to_equal(8u64)
        val session = value.open_session()
        expect(session.status).to_equal(KpfNoallocStatus.Ok)
        expect(value.arena_used_bytes()).to_equal(24u64)
        val request = value.submit(session.handle)
        expect(request.status).to_equal(KpfNoallocStatus.Ok)
        expect(value.arena_used_bytes()).to_equal(28u64)
        expect(value.arena_high_water_bytes()).to_equal(28u64)
        expect(value.post_activation_allocation_count()).to_equal(0u64)
        expect(value.complete(request.handle)).to_equal(KpfNoallocStatus.Ok)
        expect(value.close_session(session.handle)).to_equal(KpfNoallocStatus.Ok)
        expect(value.arena_used_bytes()).to_equal(8u64)
        expect(value.post_activation_allocation_count()).to_equal(0u64)

    it "fails closed at the exact arena boundary without changing accounting":
        step("Mutation guard: reducing arena capacity by one rejects the request")
        var value = runtime(27u64, 1u32, 1u32, 1)
        expect(value.activate()).to_equal(KpfNoallocStatus.Ok)
        val session = value.open_session()
        expect(session.status).to_equal(KpfNoallocStatus.Ok)
        expect(value.submit(session.handle).status).to_equal(KpfNoallocStatus.CapacityExceeded)
        expect(value.arena_used_bytes()).to_equal(24u64)
        expect(value.inflight_request_count()).to_equal(0)
        expect(value.post_activation_allocation_count()).to_equal(0u64)

    it "uses epochs to reject stale session and request handles after slot reuse":
        step("Mutation guard: removing epoch increments exposes stale handles")
        var value = runtime(64u64, 1u32, 1u32, 1)
        value.activate()
        val first_session = value.open_session().handle
        val first_request = value.submit(first_session).handle
        expect(value.complete(first_request)).to_equal(KpfNoallocStatus.Ok)
        expect(value.complete(first_request)).to_equal(KpfNoallocStatus.StaleHandle)
        expect(value.close_session(first_session)).to_equal(KpfNoallocStatus.Ok)
        val second_session = value.open_session().handle
        expect(value.submit(first_session).status).to_equal(KpfNoallocStatus.StaleHandle)
        expect(second_session.epoch).to_equal(first_session.epoch + 1u64)

    it "quiesces without admitting new work and retires only after draining":
        step("Mutation guard: retirement cannot skip session and request drain checks")
        var value = runtime(64u64, 1u32, 1u32, 1)
        value.activate()
        val session = value.open_session().handle
        val request = value.submit(session).handle
        expect(value.begin_quiesce()).to_equal(KpfNoallocStatus.Ok)
        expect(value.submit(session).status).to_equal(KpfNoallocStatus.InvalidPhase)
        expect(value.retire()).to_equal(KpfNoallocStatus.WouldBlock)
        expect(value.complete(request)).to_equal(KpfNoallocStatus.Ok)
        expect(value.close_session(session)).to_equal(KpfNoallocStatus.Ok)
        expect(value.retire()).to_equal(KpfNoallocStatus.Ok)
        expect(value.phase()).to_equal(KpfNoallocPhase.Retired)
