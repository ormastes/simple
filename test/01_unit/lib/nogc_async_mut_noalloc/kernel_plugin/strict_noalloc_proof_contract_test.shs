#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../../../../.." && pwd)
checker="$repo_root/scripts/check/kernel-plugin-fabric/check-strict-noalloc-proof.shs"

"$checker" "$repo_root"

fixture=$(mktemp -d "${TMPDIR:-/tmp}/kpf-noalloc-proof.XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM
mkdir -p "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin"
mkdir -p "$fixture/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin"
cp "$repo_root/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl" \
    "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl"
cp "$repo_root/src/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime.spl" \
    "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime.spl"
cp "$repo_root/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl" \
    "$fixture/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl"

sed 's/if current_count != self.baseline_count:/if false:/' \
    "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl" > "$fixture/probe.mutated"
mv "$fixture/probe.mutated" "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl"

if "$checker" "$fixture" >"$fixture/mutation.out" 2>&1; then
    echo "strict noalloc mutation unexpectedly passed" >&2
    exit 1
fi
grep -Fq 'KPF_STRICT_NOALLOC_PROOF: FAIL missing-delta-check' "$fixture/mutation.out"

cp "$repo_root/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl" \
    "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl"
cp "$repo_root/src/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime.spl" \
    "$fixture/src/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime.spl"
cp "$repo_root/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl" \
    "$fixture/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl"

sed 's/expect(receipt.post_activation_allocations).to_equal(0u64)/expect(receipt.post_activation_allocations).to_be_greater_than(0u64)/' \
    "$fixture/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl" > "$fixture/spec.mutated"
mv "$fixture/spec.mutated" "$fixture/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl"

if "$checker" "$fixture" >"$fixture/mutation2.out" 2>&1; then
    echo "strict noalloc workload mutation unexpectedly passed" >&2
    exit 1
fi
grep -Fq 'KPF_STRICT_NOALLOC_PROOF: FAIL missing-strict-zero-allocation-assertion' "$fixture/mutation2.out"
echo "KPF_STRICT_NOALLOC_MUTATION: PASS disabled-detection-rejected"
