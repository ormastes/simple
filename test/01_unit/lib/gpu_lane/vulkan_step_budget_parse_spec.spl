use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use std.gc_async_mut.gpu_lane.vulkan_vm_executor.{step_budget_from_env, DEFAULT_STEP_BUDGET}

describe "vulkan VM step budget parsing":
    it "accepts positive decimal and defaults on invalid, zero, negative, and overflow":
        val prior = env_get("SVMG_STEP_BUDGET")
        env_set("SVMG_STEP_BUDGET", "256")
        val valid = step_budget_from_env()
        env_set("SVMG_STEP_BUDGET", "not-a-number")
        val invalid = step_budget_from_env()
        env_set("SVMG_STEP_BUDGET", "0")
        val zero = step_budget_from_env()
        env_set("SVMG_STEP_BUDGET", "-5")
        val negative = step_budget_from_env()
        env_set("SVMG_STEP_BUDGET", "9223372036854775808")
        val overflow = step_budget_from_env()
        env_set("SVMG_STEP_BUDGET", prior)
        expect(valid).to_equal(256)
        expect(invalid).to_equal(DEFAULT_STEP_BUDGET)
        expect(zero).to_equal(DEFAULT_STEP_BUDGET)
        expect(negative).to_equal(DEFAULT_STEP_BUDGET)
        expect(overflow).to_equal(DEFAULT_STEP_BUDGET)
