use std.spec.*
use std.env.{env_get, env_set}
use std.gc_async_mut.gpu_lane.cuda_vm_executor.{step_budget_from_env, DEFAULT_STEP_BUDGET}

describe "CUDA VM step budget parsing":
    it "preserves wide positive i64 values and rejects invalid budgets":
        val previous = env_get("SVMG_STEP_BUDGET")
        env_set("SVMG_STEP_BUDGET", "1152921504606846976")
        expect(step_budget_from_env()).to_equal(1152921504606846976)
        env_set("SVMG_STEP_BUDGET", "9223372036854775807")
        expect(step_budget_from_env()).to_equal(9223372036854775807)
        env_set("SVMG_STEP_BUDGET", "invalid")
        expect(step_budget_from_env()).to_equal(DEFAULT_STEP_BUDGET)
        env_set("SVMG_STEP_BUDGET", "-1")
        expect(step_budget_from_env()).to_equal(DEFAULT_STEP_BUDGET)
        env_set("SVMG_STEP_BUDGET", "9223372036854775808")
        expect(step_budget_from_env()).to_equal(DEFAULT_STEP_BUDGET)
        env_set("SVMG_STEP_BUDGET", previous)
