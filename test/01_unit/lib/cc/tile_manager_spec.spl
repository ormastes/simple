# @cover src/lib/cc/feature/tile_manager.spl 80%

use std.spipe.*
use std.cc.entity.tile.{Tile, TileKey, TilePriority}
use std.cc.feature.raster_buffer_provider.{RasterBufferProvider}
use std.cc.feature.tile_manager.{TileManager}
use std.skia.entity.geometry.{SkIRect, SkRect}
use std.skia.entity.color.{SkColor4f}
use std.skia.backend.cpu.raster_prims.{fill_rect}
use std.skia.capability.{SkCapability, sk_capability_cpu}

fn make_manager() -> TileManager:
    val rp = RasterBufferProvider.new(sk_capability_cpu())
    TileManager.new(rp)

fn make_tile(layer_id: i32, i: i32, j: i32, priority: TilePriority) -> Tile:
    val key = TileKey.new(layer_id, i, j, 1.0)
    val rect = SkIRect.make_xywh(i * 256, j * 256, 256, 256)
    Tile.new(key, rect, priority)

describe "TileManager":
    context "new":
        it "new manager has 0 tiles and 0 ready":
            val mgr = make_manager()
            expect(mgr.tiles.len()).to_equal(0)
            expect(mgr.ready_count()).to_equal(0)

    context "add_tile":
        it "add_tile increments pending_count":
            var mgr = make_manager()
            val t = make_tile(1, 0, 0, TilePriority.NowBin)
            mgr.add_tile(t)
            expect(mgr.pending_count()).to_equal(1)

    context "schedule_tasks":
        it "schedule_tasks marks NowBin tiles ready":
            var mgr = make_manager()
            val t = make_tile(1, 0, 0, TilePriority.NowBin)
            mgr.add_tile(t)
            mgr.schedule_tasks()
            expect(mgr.ready_count()).to_equal(1)

        it "SoonBin tiles remain not-ready after schedule":
            var mgr = make_manager()
            val t = make_tile(1, 0, 0, TilePriority.SoonBin)
            mgr.add_tile(t)
            mgr.schedule_tasks()
            expect(mgr.ready_count()).to_equal(0)

    context "invalidate_tile":
        it "invalidate_tile flips is_ready back to false":
            var mgr = make_manager()
            val key = TileKey.new(1, 0, 0, 1.0)
            val t = make_tile(1, 0, 0, TilePriority.NowBin)
            mgr.add_tile(t)
            mgr.schedule_tasks()
            expect(mgr.ready_count()).to_equal(1)
            mgr.invalidate_tile(key)
            expect(mgr.ready_count()).to_equal(0)

        it "schedule_tasks allocates 4*w*h bitmap writable via set_pixel and fill_rect":
            var mgr = make_manager()
            val t = make_tile(1, 0, 0, TilePriority.NowBin)
            mgr.add_tile(t)
            mgr.schedule_tasks()
            expect(mgr.ready_count()).to_equal(1)
            val bmp = mgr.tiles[0].bitmap
            expect(bmp.width).to_equal(256)
            expect(bmp.height).to_equal(256)
            expect(bmp.pixels.len()).to_equal(4 * 256 * 256)
            bmp.set_pixel(1, 2, SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
            val set_idx = (2 * 256 + 1) * 4
            expect(bmp.pixels[set_idx] as i64).to_equal(255)
            expect(bmp.pixels[set_idx + 3] as i64).to_equal(255)
            fill_rect(bmp, SkRect(left: 4.0, top: 3.0, right: 8.0, bottom: 7.0), SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))
            val rect_idx = (4 * 256 + 5) * 4
            expect(bmp.pixels[rect_idx + 1] as i64).to_equal(255)
            expect(bmp.pixels[rect_idx + 3] as i64).to_equal(255)

        it "allocate_tile_bitmap returns 4*w*h buffer safe for pixel writes":
            val rp = RasterBufferProvider.new(sk_capability_cpu())
            val bmp = rp.allocate_tile_bitmap(8, 6)
            expect(bmp.pixels.len()).to_equal(4 * 8 * 6)
            bmp.set_pixel(0, 0, SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
            fill_rect(bmp, SkRect(left: 2.0, top: 1.0, right: 5.0, bottom: 4.0), SkColor4f(r: 0.0, g: 0.0, b: 1.0, a: 1.0))
            expect(bmp.pixels[0] as i64).to_equal(255)
            expect(bmp.pixels[(2 * 8 + 3) * 4 + 2] as i64).to_equal(255)

    context "counts":
        it "ready_count + pending_count equals tile count":
            var mgr = make_manager()
            val t1 = make_tile(1, 0, 0, TilePriority.NowBin)
            val t2 = make_tile(1, 1, 0, TilePriority.SoonBin)
            val t3 = make_tile(1, 0, 1, TilePriority.NowBin)
            mgr.add_tile(t1)
            mgr.add_tile(t2)
            mgr.add_tile(t3)
            mgr.schedule_tasks()
            val total = mgr.ready_count() + mgr.pending_count()
            expect(total).to_equal(mgr.tiles.len())
