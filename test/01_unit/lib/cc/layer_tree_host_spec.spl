"""
## Purpose and audience
Purpose: Prove that LayerTreeImpl.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-CC-001 — stable requirement identity for this spec.

# @cover src/lib/cc/entity/layer_tree_host.spl 80%

use std.spipe.*
use std.cc.entity.layer.{Layer, LayerKind}
use std.cc.entity.layer_tree_host.{LayerTreeImpl, LayerTreeHost}
use std.skia.entity.geometry.{SkRect}

use std.spec.step

describe "LayerTreeImpl":
    context "empty":
        it "has 0 layers when created empty":
            step("Verify: has 0 layers when created empty")
            # @req: REQ-LIB-CC-001
            val tree = LayerTreeImpl.empty()
            expect(tree.layer_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "add_layer":
        it "add_layer returns monotonically increasing ids":
            step("Verify: add_layer returns monotonically increasing ids")
            var tree = LayerTreeImpl.empty()
            val bounds = SkRect.make_xywh(0.0, 0.0, 100.0, 100.0)
            val l1 = Layer.root(bounds)
            val l2 = Layer.root(bounds)
            val id1 = tree.add_layer(l1)
            val id2 = tree.add_layer(l2)
            expect(id2 > id1).to_equal(true)

        it "layer_count grows after add_layer":
            step("Verify: layer_count grows after add_layer")
            var tree = LayerTreeImpl.empty()
            val bounds = SkRect.make_xywh(0.0, 0.0, 50.0, 50.0)
            val l = Layer.root(bounds)
            tree.add_layer(l)
            expect(tree.layer_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "LayerTreeHost":
    context "new":
        it "starts with needs_commit=false and source_frame_number=0":
            step("Verify: starts with needs_commit=false and source_frame_number=0")
            val host = LayerTreeHost.new()
            expect(host.needs_commit).to_equal(false)
            expect(host.source_frame_number).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "set_needs_commit and commit":
        it "set_needs_commit sets flag then commit clears it":
            step("Verify: set_needs_commit sets flag then commit clears it")
            var host = LayerTreeHost.new()
            host.set_needs_commit()
            expect(host.needs_commit).to_equal(true)
            host.commit()
            expect(host.needs_commit).to_equal(false)

    context "commit copies pending to active":
        it "layer added to pending appears in active after commit":
            step("Verify: layer added to pending appears in active after commit")
            var host = LayerTreeHost.new()
            val bounds = SkRect.make_xywh(0.0, 0.0, 200.0, 200.0)
            val l = Layer.root(bounds)
            host.pending_tree.add_layer(l)
            expect(host.active_tree.layer_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            host.commit()
            expect(host.active_tree.layer_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "begin_main_frame":
        it "increments source_frame_number each call":
            step("Verify: increments source_frame_number each call")
            var host = LayerTreeHost.new()
            host.begin_main_frame()
            expect(host.source_frame_number).to_equal(1)  # oracle: 1 — named expected value from the requirement
            host.begin_main_frame()
            expect(host.source_frame_number).to_equal(2)  # oracle: 2 — named expected value from the requirement

    context "tree independence":
        it "changing pending after commit does not mutate active":
            step("Verify: changing pending after commit does not mutate active")
            var host = LayerTreeHost.new()
            val bounds = SkRect.make_xywh(0.0, 0.0, 64.0, 64.0)
            val l = Layer.root(bounds)
            host.pending_tree.add_layer(l)
            host.commit()
            val active_count_before = host.active_tree.layer_count()
            val l2 = Layer.root(bounds)
            host.pending_tree.add_layer(l2)
            expect(host.active_tree.layer_count()).to_equal(active_count_before)

# clone_tree is the mechanism commit relies on. NOTE: on this lane class
# assignment is itself a value copy (measured: `var b = a` then mutating `a`
# leaves `b` untouched), so NO assertion can distinguish `clone_tree()` from a
# bare `active = pending`. What these examples DO discriminate is a clone_tree
# that loses state — the realistic defect — so each one goes red if the layer
# list or the id counter is dropped, reset, or shared.
describe "LayerTreeImpl.clone_tree":
    context "state transfer":
        it "carries over every layer and the id counter, so cloned ids never collide":
            step("Verify: carries over every layer and the id counter, so cloned ids never collide")
            var tree = LayerTreeImpl.empty()
            val bounds = SkRect.make_xywh(0.0, 0.0, 32.0, 32.0)
            val first_id = tree.add_layer(Layer.root(bounds))
            val second_id = tree.add_layer(Layer.root(bounds))
            var copy = tree.clone_tree()
            expect(copy.layer_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            # A clone that reset next_id would re-issue first_id/second_id here.
            val cloned_next = copy.add_layer(Layer.root(bounds))
            expect(cloned_next > second_id).to_equal(true)
            expect(cloned_next).to_equal(second_id + 1)
            expect(first_id).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "bidirectional independence":
        it "writes to the clone leave the original untouched":
            step("Verify: writes to the clone leave the original untouched")
            var tree = LayerTreeImpl.empty()
            val bounds = SkRect.make_xywh(0.0, 0.0, 8.0, 8.0)
            tree.add_layer(Layer.root(bounds))
            var copy = tree.clone_tree()
            copy.add_layer(Layer.root(bounds))
            copy.add_layer(Layer.root(bounds))
            expect(copy.layer_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(tree.layer_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "writes to the original leave the clone untouched":
            step("Verify: writes to the original leave the clone untouched")
            var tree = LayerTreeImpl.empty()
            val bounds = SkRect.make_xywh(0.0, 0.0, 8.0, 8.0)
            tree.add_layer(Layer.root(bounds))
            var copy = tree.clone_tree()
            tree.add_layer(Layer.root(bounds))
            tree.add_layer(Layer.root(bounds))
            expect(tree.layer_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(copy.layer_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "commit uses it":
        it "the committed active tree keeps issuing ids after the pending tree left off":
            step("Verify: the committed active tree keeps issuing ids after the pending tree left off")
            var host = LayerTreeHost.new()
            val bounds = SkRect.make_xywh(0.0, 0.0, 16.0, 16.0)
            host.pending_tree.add_layer(Layer.root(bounds))
            host.pending_tree.add_layer(Layer.root(bounds))
            host.commit()
            expect(host.active_tree.layer_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(host.active_tree.add_layer(Layer.root(bounds))).to_equal(3)  # oracle: 3 — named expected value from the requirement
