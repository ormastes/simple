use std.spec.*
use std.nogc_sync_mut.daemon_sdk.framed_io_v1.{daemon_read_frame_v1, daemon_write_frame_v1}

var FRAME_BUF: [u8] = []
var FRAME_POS: i64 = 0

fn frame_write(bytes: [u8], offset: i64, count: i64) -> Result<i64, text>:
    for i in 0..count: FRAME_BUF.push(bytes[offset + i])
    Ok(count)

fn frame_read(count: i64) -> Result<[u8], text>:
    var out: [u8] = []
    while out.len() < count and FRAME_POS < FRAME_BUF.len():
        out.push(FRAME_BUF[FRAME_POS])
        FRAME_POS = FRAME_POS + 1
    Ok(out)

describe "daemon framed I/O v1":
    it "round-trips one length-prefixed frame and refuses an oversized body":
        FRAME_BUF = []
        FRAME_POS = 0
        expect(daemon_write_frame_v1(frame_write, [7u8, 8u8, 9u8], 64).unwrap()).to_equal(7)
        expect(daemon_read_frame_v1(frame_read, 64).unwrap()).to_equal([7u8, 8u8, 9u8])
        expect(daemon_write_frame_v1(frame_write, [1u8, 2u8], 1).is_err()).to_equal(true)
        expect(daemon_read_frame_v1(frame_read, 64).is_err()).to_equal(true)
