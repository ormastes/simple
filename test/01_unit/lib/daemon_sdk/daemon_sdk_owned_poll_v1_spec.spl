# @req DOWNER-01 DOWNER-02 DOWNER-03 DOWNER-04
# NOT_RUN pending admitted SSpec execution; native subset is separate evidence.
use std.spec.{describe, it, expect}
use test.fixtures.daemon_sdk.publication_regression.{daemon_publication_failure_case}
use test.fixtures.daemon_sdk.owned_poll_v1.{
    owned_poll_idle_stopped_case, owned_poll_accumulation_case,
    owned_poll_publication_failure_case, owned_poll_identity_failure_case,
    owned_poll_ack_failure_case, owned_poll_limit_case, owned_poll_prefix_failure_case
}

describe "daemon poll explicit domain owner":
    it "returns unchanged owner during idle and stopped turns while retaining runner state":
        expect(owned_poll_idle_stopped_case()).to_equal(0)

    it "accumulates owner counters through two serial handlers in one batch":
        expect(owned_poll_accumulation_case()).to_equal(0)

    it "retains the handler owner after publication fails and refuses another invocation":
        expect(owned_poll_publication_failure_case()).to_equal(0)

    it "retains the handler owner before rejecting an unrelated response identity":
        expect(owned_poll_identity_failure_case()).to_equal(0)

    it "retains the handler owner after acknowledgement fails and refuses another invocation":
        expect(owned_poll_ack_failure_case()).to_equal(0)

    it "respects the serial batch limit and carries the caller owner across turns":
        expect(owned_poll_limit_case()).to_equal(0)

    it "returns the latest owner after a successful prefix and failed second response":
        expect(owned_poll_prefix_failure_case()).to_equal(0)

    it "preserves legacy handler capture and publication fail-stop through the shared core":
        expect(daemon_publication_failure_case()).to_equal(0)
