# @req REQ-CMUX-003
# Unix terminal_console provider ownership contract (bug
# doc/08_tracking/bug/terminal_console_no_unix_provider_2026-11-14.md).
use std.spec.{describe, it, expect, step}
use std.sys.terminal_console.{open, read, write, size, close, cleanup}

describe "terminal console provider ownership":
    """
    The console has one exclusive owner. Handles it never issued are refused,
    and a successful open is always restored by close.
    """
    it "refuses every operation on a handle it never issued":
        step("Use a foreign handle without opening the console")
        expect(read(99, 16).is_err()).to_equal(true)
        expect(write(99, "x").is_err()).to_equal(true)
        expect(size(99).is_err()).to_equal(true)
        expect(close(99)).to_equal(false)
        expect(cleanup()).to_equal(true)

    it "either opens exclusively and restores, or refuses with a reason":
        step("Open the console once; a second open must be refused")
        val first = open()
        if first.is_ok():
            val handle = first.unwrap()
            expect(open().is_err()).to_equal(true)
            expect(close(handle)).to_equal(true)
            expect(close(handle)).to_equal(false)
        else:
            expect(first.unwrap_err() != "").to_equal(true)
        expect(cleanup()).to_equal(true)
