# Reproduce spec for the E-SFFI-016 "non-optional return contract" fixes
# applied across src/lib/{nogc_sync_mut,nogc_async_mut,gc_async_mut}/**.
#
# Each function below used to be declared with a non-optional return type
# (e.g. `-> text`, `-> tuple`) while its body legitimately returned `nil` on
# a "not found" / "invalid input" path. On the strict seed that aborts with
# "nil is forbidden by the non-optional return contract of '<fn>'
# [E-SFFI-016]". The fix widened the declared type to `T?`. This spec drives
# each function down its nil path and asserts it returns nil cleanly instead
# of trapping.

use std.nogc_sync_mut.http.headers.{get_header, parse_range_header, parse_multipart_part}
use std.nogc_sync_mut.http.url.{get_query_param}
use std.nogc_async_mut.mailbox.{mailbox_new, mailbox_receive}

describe "non-optional return contract fixes (nil path)":
    it "get_header returns nil (not a crash) when the header is absent":
        val headers = [("Content-Type", "text/plain")]
        expect get_header(headers, "X-Missing") == nil

    it "parse_range_header returns nil on a malformed Range header":
        expect parse_range_header("not-a-range") == nil

    it "parse_multipart_part returns nil when no header/body separator is found":
        expect parse_multipart_part("no-crlf-separator-here") == nil

    it "get_query_param returns nil when the parameter name is absent":
        expect get_query_param([("a", "1"), ("b", "2")], "missing") == nil

    it "mailbox_receive returns nil when the mailbox is empty":
        val mb = mailbox_new(4)
        expect mailbox_receive(mb) == nil
