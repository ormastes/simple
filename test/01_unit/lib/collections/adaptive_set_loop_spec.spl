# @tag: unit, collection, profile
# @req REQ-PSC-003
# UNRUN: requires the admitted Simple source runner; this lane only adds source assertions.
use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.sffi.collection_capture.{collection_capture_begin, collection_capture_finish}
use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveTextSet, AdaptiveSetAttribute, adaptive_set_default_profile}
use std.nogc_sync_mut.src.collections.adaptive_set_loop.{AdaptiveSetLoopStep, adaptive_set_for_each_observed}

var loop_test_trace: [text] = []

fn loop_continue(value: text) -> Result<AdaptiveSetLoopStep, text>:
    loop_test_trace.push(value)
    Ok(AdaptiveSetLoopStep.Continue)

fn loop_break_on_b(value: text) -> Result<AdaptiveSetLoopStep, text>:
    loop_test_trace.push(value)
    if value == "b": return Ok(AdaptiveSetLoopStep.Break)
    Ok(AdaptiveSetLoopStep.Continue)

fn loop_fail_on_b(value: text) -> Result<AdaptiveSetLoopStep, text>:
    loop_test_trace.push(value)
    if value == "b": return Err("loop callback failed at b")
    Ok(AdaptiveSetLoopStep.Continue)

fn loop_fail_if_called(value: text) -> Result<AdaptiveSetLoopStep, text>:
    loop_test_trace.push(value)
    Err("empty loop called its body")

fn captured_loop_trip_count(body: text, site: text) -> i64:
    for line in body.split("\n"):
        if line.contains("site=" + site + ";") and
                line.contains("name=loop_trip_count;value="):
            val fields = line.split("name=loop_trip_count;value=")
            if fields.len() == 2:
                return fields[1].to_i64() ?? -1
    -1

describe "caller-owned completed adaptive set loop observations":
    it "counts each continued body entry in sorted snapshot order":
        step("Normalize each backing representation to its sorted unique snapshot")
        for attribute in [AdaptiveSetAttribute.Linear, AdaptiveSetAttribute.Hash, AdaptiveSetAttribute.Ordered]:
            var source = AdaptiveTextSet.with_attribute(adaptive_set_default_profile(), "ast-loop-source", "native-test", attribute)
            source.insert("c")
            source.insert("a")
            source.insert("b")
            source.insert("b")
            loop_test_trace = []
            val completed = adaptive_set_for_each_observed(source, loop_continue).unwrap()
            expect(loop_test_trace).to_equal(["a", "b", "c"])
            expect(completed.site_id).to_equal("ast-loop-source")
            expect(completed.target_profile_id).to_equal("native-test")
            expect(completed.trips).to_equal(3)
            expect(source.snapshot_values()).to_equal(["a", "b", "c"])

    it "counts the break entry and does not visit later keys":
        step("Count the callback entry that returns Break")
        var source = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "ast-loop-break", "native-test")
        source.insert("a")
        source.insert("b")
        source.insert("c")
        loop_test_trace = []
        val completed = adaptive_set_for_each_observed(source, loop_break_on_b).unwrap()
        expect(loop_test_trace).to_equal(["a", "b"])
        expect(completed.trips).to_equal(2)

    it "returns no completed observation after callback failure":
        step("Propagate callback error without reporting completion")
        var source = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "ast-loop-error", "native-test")
        source.insert("a")
        source.insert("b")
        source.insert("c")
        loop_test_trace = []
        val failed = adaptive_set_for_each_observed(source, loop_fail_on_b)
        expect(loop_test_trace).to_equal(["a", "b"])
        expect(failed.is_err()).to_be(true)
        match failed:
            case Err(reason): expect(reason).to_equal("loop callback failed at b")
            case Ok(_): assert(false)

    it "returns a known zero-trip observation for empty input":
        step("Return a measured zero without invoking the callback")
        val source = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "ast-loop-empty", "native-test")
        loop_test_trace = []
        val completed = adaptive_set_for_each_observed(source, loop_fail_if_called).unwrap()
        expect(loop_test_trace).to_equal([])
        expect(completed.site_id).to_equal("ast-loop-empty")
        expect(completed.target_profile_id).to_equal("native-test")
        expect(completed.trips).to_equal(0)

    it "requires source site and target identities before invoking the body":
        step("Reject missing identity before any callback entry")
        val no_site = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "", "native-test")
        val no_target = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "ast-loop", "")
        loop_test_trace = []
        expect(adaptive_set_for_each_observed(no_site, loop_continue).is_err()).to_be(true)
        expect(adaptive_set_for_each_observed(no_target, loop_continue).is_err()).to_be(true)
        expect(loop_test_trace).to_equal([])

    it "rejects incomplete snapshots before invoking the body":
        step("Reject size and snapshot disagreement before callbacks")
        var source = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "ast-loop-incomplete", "native-test")
        source.insert("a")
        source.size = 2
        loop_test_trace = []
        expect(adaptive_set_for_each_observed(source, loop_continue).is_err()).to_be(true)
        expect(loop_test_trace).to_equal([])

    it "rejects duplicate snapshots before invoking the body":
        step("Reject duplicate physical keys before callbacks")
        var duplicate = AdaptiveTextSet.with_site_and_target(adaptive_set_default_profile(), "ast-loop-duplicate", "native-test")
        duplicate.linear_values = ["a", "a"]
        duplicate.size = 2
        loop_test_trace = []
        expect(adaptive_set_for_each_observed(duplicate, loop_continue).is_err()).to_be(true)
        expect(loop_test_trace).to_equal([])

    it "captures a completed two-trip break and omits a callback error":
        step("Serialize a completed break and keep failed invocation absent")
        val target = "native-test"
        val break_site = "ast://unit/adaptive-set-loop/break#stable"
        val error_site = "ast://unit/adaptive-set-loop/error#stable"
        expect(collection_capture_begin(target)).to_be(true)
        var breaking = AdaptiveTextSet.with_site_and_target(
            adaptive_set_default_profile(), break_site, target)
        breaking.insert("a")
        breaking.insert("b")
        breaking.insert("c")
        loop_test_trace = []
        val completed = adaptive_set_for_each_observed(breaking, loop_break_on_b).unwrap()
        expect(completed.trips).to_equal(2)

        var failing = AdaptiveTextSet.with_site_and_target(
            adaptive_set_default_profile(), error_site, target)
        failing.insert("a")
        failing.insert("b")
        loop_test_trace = []
        expect(adaptive_set_for_each_observed(failing, loop_fail_on_b).is_err()).to_be(true)

        val body = collection_capture_finish() ?? ""
        expect(captured_loop_trip_count(body, break_site)).to_equal(2)
        expect(captured_loop_trip_count(body, error_site)).to_equal(-1)

    it "captures an empty loop as a known zero-trip observation":
        step("Distinguish completed zero from an absent loop measurement")
        val target = "native-test"
        val site = "ast://unit/adaptive-set-loop/empty#stable"
        expect(collection_capture_begin(target)).to_be(true)
        val source = AdaptiveTextSet.with_site_and_target(
            adaptive_set_default_profile(), site, target)
        loop_test_trace = []
        val completed = adaptive_set_for_each_observed(source, loop_fail_if_called).unwrap()
        expect(completed.trips).to_equal(0)
        expect(loop_test_trace).to_equal([])
        val body = collection_capture_finish() ?? ""
        expect(captured_loop_trip_count(body, site)).to_equal(0)

    it "keeps the completed loop result when capture rejects its site":
        step("Report capture failure at finish without changing loop semantics")
        val target = "native-test"
        expect(collection_capture_begin(target)).to_be(true)
        var source = AdaptiveTextSet.with_site_and_target(
            adaptive_set_default_profile(), "not-an-admitted-site", target)
        source.insert("a")
        loop_test_trace = []
        val completed = adaptive_set_for_each_observed(source, loop_continue).unwrap()
        expect(completed.trips).to_equal(1)
        expect(loop_test_trace).to_equal(["a"])
        expect(collection_capture_finish()).to_be_nil()
