# Resume extraction — SAML fixture for test/01_unit/lib/saml/saml_spec.spl.
#
# Deliberately mixed: one well-formed, fully-evidenced function and one that
# trips every static warning the analyzer knows how to raise.
module resume

enum Seniority:
    junior
    staff @alias("staff_engineer")
    principal

class Education:
    school: text
    degree: text?

class Resume:
    name: text @alias("candidate_name") @description("Full legal name as written")
    email: text? @sensitive(pii)
    skills: [text]
    education: [Education]
    seniority: Seniority

struct ExtractionStats:
    tokens: i64
    retries: i64

# Extract a structured resume from raw pasted text.
# example: ExtractResume("Grace Hopper, Rear Admiral") => name == "Grace Hopper"
# counter-example: ExtractResume("") => error
@trace
@parse(strictness: strict)
@redact(pii)
llm fn ExtractResume(resume_text: text) -> Resume:
    client: FastExtract
    prompt:
        """
        Extract the resume below into the requested schema.

        {{ resume_text }}

        {{ saml.output_format }}
        """

llm fn ScoreResume(resume: Resume, rubric: text) -> Seniority:
    client: CarefulJudge
    prompt:
        """
        Rate {{ candidate }} against the rubric.

        {{ rubric }}
        """

test resume_extraction:
    functions:
        - ExtractResume
    assert:
        - name == "Grace Hopper"
    evidence:
        source: fixture
