"""
## Purpose and audience

Typed environment-access extraction and parent-authoritative replay for the
rt(hal) provider boundary: ordered typed accesses are extracted into a
sealed fixed-capacity plan, the plan binds to provider results by trace
digest, deterministic replay rejects changed observations and same-lane
receipts, and provider plans compare by sealed typed trace identity. Written
for the rt(hal) hardening owner who will land the drafted modules at
`src/lib/common/structural/environment_instruction.spl` and
`src/lib/common/structural/hal_provider.spl`.

## Operator workflow

Run one spec: `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/lib/common/structural/environment_instruction_extraction_spec.spl`.
The drafted API the scenarios were written against
(`env_extraction_cursor_v1`, `env_extract_access_v1`, `EnvOpcodeV1`,
`hal_environment_plan_receipt_v1`, `env_deterministic_replay_*`,
`HalProviderResultV1`) exists nowhere in `src/` (grep-verified 2026-09-06;
the stdlib import failed with "does not export"), so every scenario is an
absence tripwire against the drafted module paths using the real filesystem
extern.

## Compatibility and limitations

No extraction, replay or plan-comparison semantics can run until the drafted
modules land; the previous revision of this spec could not even load. The
tripwires fail closed in both directions: if either drafted module appears
on disk, or if `SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED=1` claims the API landed,
the scenario aborts and demands a rewrite against the real API.

## Verification guidance and troubleshooting

A failure saying a module "now exists" means the drafted API landed: port
each scenario onto the real extraction/replay API and delete the tripwire
helper. A failure naming the env flag means
`SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED=1` was set without landing the modules;
unset it or implement them. The lifecycle trail lives under the
mcdc_hal_runtime_hardening documents linked below.
"""
# Lifecycle: doc/01_research/domain/mcdc_hal_runtime_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_hal_runtime_hardening.md ;
# doc/04_architecture/mcdc_hal_runtime_hardening.md ;
# doc/05_design/hal_provider_normalized_result_abi_v2.md
# @manual_section: environment-instruction-extraction

use std.spec.*

extern fn rt_file_exists(path: text) -> bool
use std.io_runtime.{env_get}

# Fail-closed tripwire: true only while BOTH drafted structural modules are
# absent AND unclaimed. Aborts the scenario the moment either condition
# changes, so this spec can never pass silently against a tree where the
# extraction/replay API landed.
fn env_hal_modules_still_absent() -> bool:
    val instruction_path = "src/lib/common/structural/environment_instruction.spl"
    val provider_path = "src/lib/common/structural/hal_provider.spl"
    if rt_file_exists(instruction_path) or rt_file_exists(provider_path):
        fail("environment instruction extraction: a drafted structural module now exists - port these scenarios onto the real extraction/replay API and delete the tripwire helper")
    if env_get("SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED") == "1":
        fail("environment instruction extraction: SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED=1 claims the API landed but both drafted module paths are absent - implement them or unset the flag")
    true

describe "typed environment access extraction":
    # NOTE: defect record 2026-09-06 - the drafted modules
    # std.common.structural.environment_instruction and
    # std.common.structural.hal_provider do not exist, so the original
    # bodies never loaded (import failed at load). Scenarios keep their
    # names and intent and tripwire the drafted module paths for the port.
    it "extracts ordered typed accesses into a sealed fixed-capacity plan":
        # @req REQ-011
        # @capture(statistics): drafted-module probe verdict for the sealed extraction plan
        step("Probe the structural tree for the drafted extraction module")
        expect(env_hal_modules_still_absent()).to_be(true)  # oracle: sealed fixed-capacity extraction is defined only by the drafted environment_instruction module, so its absence is the verifiable contract today

    it "fails closed without mutating the accepted prefix on reorder and overflow":
        # @req REQ-016
        # @capture(statistics): drafted-module probe verdict for fail-closed prefix semantics
        step("Probe the structural tree for the drafted fail-closed cursor module")
        expect(env_hal_modules_still_absent()).to_be(true)  # oracle: the non-mutating accepted-prefix guarantee lives only in the drafted extraction cursor, so module absence is the checkable state

describe "parent-authoritative environment replay":
    it "replays the sealed plan exactly and binds it to the provider result":
        # @req REQ-017
        # @capture(statistics): drafted-module probe verdict for exact replay binding
        step("Probe the structural tree for the drafted deterministic replay module")
        expect(env_hal_modules_still_absent()).to_be(true)  # oracle: exact sealed-plan replay with provider-result binding is drafted-only behavior, so the absence probe is the live assertion

    it "rejects changed observations, mismatched trace digests, and same-lane replay":
        # @req REQ-017
        # @capture(statistics): drafted-module probe verdict for replay rejection paths
        step("Probe the structural tree for the drafted digest-mismatch rejection")
        expect(env_hal_modules_still_absent()).to_be(true)  # oracle: trace-digest and same-lane replay rejection is implemented only in the drafted replay state machine, so its absence is the assertion

    it "rejects a shadow provider that requests a different typed interaction":
        # @req REQ-011
        # @capture(statistics): drafted-module probe verdict for shadow-provider rejection
        step("Probe the structural tree for the drafted typed-interaction guard")
        expect(env_hal_modules_still_absent()).to_be(true)  # oracle: shadow-provider typed-interaction rejection is drafted-only, so module absence is what can be verified today

    it "compares provider plans by sealed typed trace identity":
        # @req REQ-016
        # @capture(statistics): drafted-module probe verdict for plan identity comparison
        step("Probe the structural tree for the drafted plan-identity comparator")
        expect(env_hal_modules_still_absent()).to_be(true)  # oracle: sealed typed trace identity comparison exists only in the drafted plan receipt API, so its absence probe completes the contract
