use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, ManifestResourceLimits, ManifestArgument, ManifestPreload,
    SimpleArtifactManifest, SIMPLE_ARTIFACT_MANIFEST_MAX_COLLECTION_ITEMS_V1
}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes
}

fn _sam_hash(ch: text) -> text:
    ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch +
        ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch +
        ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch +
        ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch + ch

fn _sam_manifest(signature: text) -> SimpleArtifactManifest:
    SimpleArtifactManifest(
        format_version: 1,
        artifact_kind: "elf",
        target: ManifestTarget(os: "simpleos", arch: "x86_64", abi: "simpleos"),
        entrypoint: "main",
        required_abi_features: ["elf64", "w_xor_x"],
        required_services: ["clock"],
        required_capabilities: 5u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576,
            max_open_handles: 8,
            max_threads: 2,
            cpu_budget_us: 100000),
        namespace_template: "app_default",
        native_libraries: ["simple_runtime@2"],
        smf_libraries: [],
        interpreter: "",
        argument_schema: [ManifestArgument(
            name: "mode", value_kind: "text", required: false,
            default_value: "safe")],
        startup_preloads: [ManifestPreload(
            source_arg: "", fixed_path: "/etc/app.sdn", mode: "read",
            required: true, maximum_bytes: 4096, access: "copy",
            prefault: false, hash_policy: "sha256")],
        content_hashes: [_sam_hash("a")],
        signature: signature,
        debug_identity: "fixture-v1")

describe "SimpleArtifactManifest v1 canonical signing bytes":
    it "is deterministic and excludes only the signature container":
        val first = encode_simple_artifact_manifest_v1_signing_bytes(
            _sam_manifest("ed25519:key-a:aaaa"), _sam_hash("b"))
        val second = encode_simple_artifact_manifest_v1_signing_bytes(
            _sam_manifest("ed25519:key-a:bbbb"), _sam_hash("b"))
        expect(first.ok).to_equal(true)
        expect(second.ok).to_equal(true)
        expect(first.bytes).to_equal(second.bytes)

    it "binds the exact image hash and policy fields":
        val original = _sam_manifest("")
        var changed = original
        changed.required_capabilities = 7u32
        val first = encode_simple_artifact_manifest_v1_signing_bytes(
            original, _sam_hash("b"))
        val other_image = encode_simple_artifact_manifest_v1_signing_bytes(
            original, _sam_hash("c"))
        val other_policy = encode_simple_artifact_manifest_v1_signing_bytes(
            changed, _sam_hash("b"))
        expect(first.bytes == other_image.bytes).to_equal(false)
        expect(first.bytes == other_policy.bytes).to_equal(false)

    it "rejects invalid hashes and manifests outside installed bounds":
        val invalid_hash = encode_simple_artifact_manifest_v1_signing_bytes(
            _sam_manifest(""), "not-a-sha256")
        var oversized = _sam_manifest("")
        var services: [text] = []
        var i: i64 = 0
        while i <= SIMPLE_ARTIFACT_MANIFEST_MAX_COLLECTION_ITEMS_V1:
            services.push("clock")
            i = i + 1
        oversized.required_services = services
        val invalid_bounds = encode_simple_artifact_manifest_v1_signing_bytes(
            oversized, _sam_hash("b"))
        expect(invalid_hash.ok).to_equal(false)
        expect(invalid_hash.bytes.len()).to_equal(0)
        expect(invalid_bounds.ok).to_equal(false)
        expect(invalid_bounds.bytes.len()).to_equal(0)
