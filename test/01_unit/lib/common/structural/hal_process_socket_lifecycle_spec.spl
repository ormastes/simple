"""
## Purpose and audience

Mission-critical process/socket lifecycle ownership for the rt(hal) external
boundary: captured process and socket generations poison on failure,
admission requires registered generations and consumes each poll exactly
once, slot collisions and generation replays fail closed, alpha comparison
rejects divergence without touching caller storage, beta commits the
preferred lane while retaining divergence, normal mode admits only its
preferred slot, timeouts preserve lifecycle and output, and socket open/
send/receive/close must follow the complete order. Written for the rt(hal)
hardening owner who will land the drafted owner API at
`src/lib/common/structural/hal_provider.spl`.

## Operator workflow

Run one spec: `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/lib/common/structural/hal_process_socket_lifecycle_spec.spl`.
The drafted API the scenarios were written against
(`hal_external_captured_admission_owner_v2`, `HalExternalLifecycleOwnerV1`
with begin/publish/finish, `hal_provider_scalar_result_v2`,
`HAL_EXTERNAL_CAPTURED_MAX_SLOTS_V2`) exists nowhere in `src/`
(grep-verified 2026-09-06; the stdlib imports failed with "does not
export"), so every scenario is an absence tripwire against the drafted
module paths using the real filesystem extern.

## Compatibility and limitations

No admission, publish, commit, comparison or timeout semantics can run
until the drafted modules land; the previous revision of this spec could
not even load. The tripwires fail closed in both directions: if either
drafted module appears on disk, or if `SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED=1`
claims the API landed, the scenario aborts and demands a rewrite against
the real API.

## Verification guidance and troubleshooting

A failure saying a module "now exists" means the drafted lifecycle API
landed: port each scenario onto the real owner API and delete the tripwire
helper. A failure naming the env flag means
`SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED=1` was set without landing the modules;
unset it or implement them. The lifecycle trail lives under the
mcdc_hal_runtime_hardening documents plus the process/socket lifecycle
report linked below.
"""
# Lifecycle: doc/01_research/domain/mcdc_hal_runtime_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_hal_runtime_hardening.md ;
# doc/04_architecture/mcdc_hal_runtime_hardening.md ;
# doc/05_design/hal_provider_normalized_result_abi_v2.md ;
# doc/09_report/rt_hal_process_socket_lifecycle_v4_2026-08-22.md
# @manual_section: hal-process-socket-lifecycle

use std.spec.*

extern fn rt_file_exists(path: text) -> bool
use std.io_runtime.{env_get}

# Fail-closed tripwire: true only while BOTH drafted structural modules are
# absent AND unclaimed. Aborts the scenario the moment either condition
# changes, so this spec can never pass silently against a tree where the
# external lifecycle owner landed.
fn lifecycle_modules_still_absent() -> bool:
    val provider_path = "src/lib/common/structural/hal_provider.spl"
    val instruction_path = "src/lib/common/structural/environment_instruction.spl"
    if rt_file_exists(provider_path) or rt_file_exists(instruction_path):
        fail("hal process socket lifecycle: a drafted structural module now exists - port these scenarios onto the real external lifecycle owner API and delete the tripwire helper")
    if env_get("SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED") == "1":
        fail("hal process socket lifecycle: SIMPLE_STRUCTURAL_ENV_HAL_DRAFTED=1 claims the owner API landed but both drafted module paths are absent - implement them or unset the flag")
    true

describe "mission-critical process/socket lifecycle owner":
    # NOTE: defect record 2026-09-06 - the drafted modules
    # std.common.structural.hal_provider and
    # std.common.structural.environment_instruction do not exist, so the
    # original bodies never loaded (import failed at load). Scenarios keep
    # their names and intent and tripwire the drafted module paths for the
    # port onto the real owner API.
    it "poisons failed captured process and socket generations":
        # @req REQ-009
        # @capture(statistics): drafted-module probe verdict for generation poisoning
        step("Probe the structural tree for the drafted captured-admission owner")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: generation poisoning after a failed finish is defined only by the drafted admission owner, so its absence is the verifiable contract today

    it "admits only coherent captured production lifecycle steps":
        # @req REQ-011
        # @capture(statistics): drafted-module probe verdict for captured-step coherence
        step("Probe the structural tree for the drafted captured-step validator")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: the well-formedness rules binding kind, opcode and generation pairs live only in the drafted validator, so module absence is the checkable state

    it "requires registered process generation and consumes each poll once":
        # @req REQ-012
        # @capture(statistics): drafted-module probe verdict for single-consume polls
        step("Probe the structural tree for the drafted single-consume poll registry")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: register-once/consume-once admission is implemented only in the drafted owner, so its absence probe is the live assertion

    it "fails closed on slot collision and socket generation replay":
        # @req REQ-015
        # @capture(statistics): drafted-module probe verdict for slot collision rejection
        step("Probe the structural tree for the drafted slot-collision guard")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: slot-collision and generation-replay rejection exists only in the drafted admission owner, so its absence is what can be asserted

    it "rejects invalid fixed capacity without growing storage":
        # @req REQ-012
        # @capture(statistics): drafted-module probe verdict for the fixed capacity seal
        step("Probe the structural tree for the drafted fixed-capacity seal")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: HAL_EXTERNAL_CAPTURED_MAX_SLOTS_V2 and the sealed slot table are drafted-only, so module absence completes this scenario

    it "extracts automatically and advances one exact process handle":
        # @req REQ-011
        # @capture(statistics): drafted-module probe verdict for automatic extraction
        step("Probe the structural tree for the drafted external lifecycle owner")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: begin/publish/finish extraction with sequence advancement is defined only by the drafted owner, so its absence is the assertion

    it "rejects alpha differences without modifying caller storage":
        # @req REQ-012
        # @capture(statistics): drafted-module probe verdict for alpha divergence rejection
        step("Probe the structural tree for the drafted alpha comparison fence")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: the non-mutating comparison-failure path with a difference pair mask is drafted-only, so module absence is the checkable state

    it "commits the preferred beta result while retaining divergence":
        # @req REQ-015
        # @capture(statistics): drafted-module probe verdict for beta preferred commit
        step("Probe the structural tree for the drafted beta commit path")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: beta-mode preferred-lane commit with retained divergence is defined only by the drafted owner, so its absence probe is the live assertion

    it "normal mode admits only its preferred fixed slot":
        # @req REQ-009
        # @capture(statistics): drafted-module probe verdict for normal-mode slot admission
        step("Probe the structural tree for the drafted normal-mode slot filter")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: NormalPreferred single-slot admission with expected/received masks is drafted-only behavior, so module absence is the assertion

    it "returns a structured timeout and preserves lifecycle and output":
        # @req REQ-011
        # @capture(statistics): drafted-module probe verdict for structured timeouts
        step("Probe the structural tree for the drafted timeout receipt")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: HAL_EXTERNAL_ERROR_TIMEOUT_V1 and the output-preserving timeout path exist only in the drafted owner, so its absence completes the contract

    it "enforces the complete socket open send receive close order":
        # @req REQ-015
        # @capture(statistics): drafted-module probe verdict for socket order enforcement
        step("Probe the structural tree for the drafted socket order machine")
        expect(lifecycle_modules_still_absent()).to_be(true)  # oracle: the open/send/receive/close order state machine with a Closed terminal is drafted-only, so module absence is the final checkable state
