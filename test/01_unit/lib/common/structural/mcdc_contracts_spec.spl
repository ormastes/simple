# @feature mcdc_hal_runtime_hardening
# @req REQ-001 REQ-002 REQ-003 REQ-004 REQ-005 REQ-018

use std.spec.*
use std.common.structural.mcdc.contracts.*
use std.common.structural.environment_instruction.contracts.*

fn decision() -> McdcDecisionIdV1:
    mcdc_decision_id_v1(11, 12, 100, 3)

fn exclusion(kind: ExclusionKindV1, reason_length: i64 = 24,
             evidence_hi: i64 = 61, evidence_lo: i64 = 62,
             owner: i64 = 71, review: i64 = 100,
             expiry: i64 = 200) -> ScenarioExclusionV1:
    scenario_exclusion_v1(
        31, kind, 41, 0, reason_length, 24, 51,
        evidence_hi, evidence_lo, owner, review, expiry)

describe "bounded MC/DC evidence contracts":
    describe "REQ-001 and REQ-002: stable decisions and correlated vectors":
        it "accepts a bounded stable decision and short-circuit vector":
            val item = decision()
            val evaluation = mcdc_evaluation_v1(item, 1, 3, 1, false)
            expect(mcdc_decision_id_v1_well_formed(item)).to_be(true)
            expect(mcdc_evaluation_v1_well_formed(evaluation)).to_be(true)

        it "rejects truth outside the evaluated and admitted masks":
            val unevaluated_truth = mcdc_evaluation_v1(decision(), 1, 1, 2, false)
            val unknown_condition = mcdc_evaluation_v1(decision(), 1, 8, 0, false)
            expect(mcdc_evaluation_v1_well_formed(unevaluated_truth)).to_be(false)
            expect(mcdc_evaluation_v1_well_formed(unknown_condition)).to_be(false)

        it "keeps signed masks below the sign bit boundary":
            val maximum = mcdc_decision_id_v1(11, 12, 100, 62)
            val too_many = mcdc_decision_id_v1(11, 12, 100, 63)
            expect(mcdc_decision_id_v1_well_formed(maximum)).to_be(true)
            expect(mcdc_condition_mask(62)).to_be_greater_than(0)
            expect(mcdc_decision_id_v1_well_formed(too_many)).to_be(false)
            expect(mcdc_condition_mask(63)).to_equal(0)

    describe "REQ-003: independence witnesses":
        it "proves a unique-cause pair when only the target changes":
            val a = mcdc_evaluation_v1(decision(), 1, 7, 0, false)
            val b = mcdc_evaluation_v1(decision(), 2, 7, 2, true)
            val witness = mcdc_witness_v1(
                1, McdcWitnessPolicyV1.UniqueCause, 0, 0, 0)
            expect(mcdc_unique_cause_pair(witness, a, b)).to_be(true)

        it "rejects a unique-cause pair when another condition changes":
            val a = mcdc_evaluation_v1(decision(), 1, 7, 0, false)
            val b = mcdc_evaluation_v1(decision(), 2, 7, 6, true)
            val witness = mcdc_witness_v1(
                1, McdcWitnessPolicyV1.UniqueCause, 0, 0, 0)
            expect(mcdc_unique_cause_pair(witness, a, b)).to_be(false)

        it "rejects reused sequences and different decision identities":
            val a = mcdc_evaluation_v1(decision(), 1, 7, 0, false)
            val same_sequence = mcdc_evaluation_v1(decision(), 1, 7, 2, true)
            val other_decision = mcdc_evaluation_v1(
                mcdc_decision_id_v1(11, 12, 101, 3), 2, 7, 2, true)
            val witness = mcdc_witness_v1(
                1, McdcWitnessPolicyV1.UniqueCause, 0, 0, 0)
            expect(mcdc_unique_cause_pair(witness, a, same_sequence)).to_be(false)
            expect(mcdc_unique_cause_pair(witness, a, other_decision)).to_be(false)

        it "accepts masking evidence shape only with a verifier receipt":
            val a = mcdc_evaluation_v1(decision(), 1, 7, 0, false)
            val b = mcdc_evaluation_v1(decision(), 2, 7, 6, true)
            val proved = mcdc_witness_v1(
                1, McdcWitnessPolicyV1.ValidatedMasking, 4, 21, 22)
            val unproved = mcdc_witness_v1(
                1, McdcWitnessPolicyV1.ValidatedMasking, 0, 0, 0)
            expect(mcdc_witness_v1_evidence_well_formed(proved, a, b)).to_be(true)
            expect(mcdc_witness_v1_evidence_well_formed(unproved, a, b)).to_be(false)

        it "rejects an overbroad masking proof mask":
            val a = mcdc_evaluation_v1(decision(), 1, 7, 0, false)
            val b = mcdc_evaluation_v1(decision(), 2, 7, 6, true)
            val overbroad = mcdc_witness_v1(
                1, McdcWitnessPolicyV1.ValidatedMasking, 5, 21, 22)
            expect(mcdc_witness_v1_evidence_well_formed(overbroad, a, b)).to_be(false)

    describe "REQ-004 and REQ-005: truthful exact gate":
        it "passes only when every non-excluded condition is covered":
            val complete = mcdc_coverage_summary_v1(10, 2, 8)
            val incomplete = mcdc_coverage_summary_v1(10, 2, 7)
            expect(mcdc_coverage_summary_v1_is_exact_100(complete)).to_be(true)
            expect(mcdc_coverage_summary_v1_is_exact_100(incomplete)).to_be(false)

        it "does not report an empty eligible denominator as 100 percent":
            val empty = mcdc_coverage_summary_v1(0, 0, 0)
            val all_excluded = mcdc_coverage_summary_v1(2, 2, 0)
            expect(mcdc_coverage_summary_v1_is_exact_100(empty)).to_be(false)
            expect(mcdc_coverage_summary_v1_is_exact_100(all_excluded)).to_be(false)

        it "joins each of the five governed REQ-018 kinds":
            val kinds = [
                ExclusionKindV1.CapabilityUnavailable,
                ExclusionKindV1.FixtureUnavailable,
                ExclusionKindV1.PlatformInapplicable,
                ExclusionKindV1.SafetyProhibited,
                ExclusionKindV1.UncontrollableNondeterminism]
            for kind in kinds:
                val joined = mcdc_decision_exclusion_v1(decision(), exclusion(kind))
                expect(mcdc_decision_exclusion_v1_well_formed(
                    joined, decision(), 150)).to_be(true)

        it "joins a governed exclusion only to the exact stable decision":
            val excluded = exclusion(ExclusionKindV1.CapabilityUnavailable)
            val wrong_span = mcdc_decision_id_v1(11, 12, 101, 3)
            val joined = mcdc_decision_exclusion_v1(decision(), excluded)
            expect(mcdc_decision_exclusion_v1_well_formed(joined, decision(), 150)).to_be(true)
            expect(mcdc_decision_exclusion_v1_well_formed(joined, wrong_span, 150)).to_be(false)

        it "rejects invalid and stale kinds from the eligible join":
            val invalid = exclusion(ExclusionKindV1.Invalid)
            val stale = exclusion(
                ExclusionKindV1.CapabilityUnavailable, expiry: 149)
            val invalid_join = mcdc_decision_exclusion_v1(decision(), invalid)
            val stale_join = mcdc_decision_exclusion_v1(decision(), stale)
            expect(mcdc_decision_exclusion_v1_well_formed(invalid_join, decision(), 150)).to_be(false)
            expect(mcdc_decision_exclusion_v1_well_formed(stale_join, decision(), 150)).to_be(false)

        it "rejects missing reason, evidence, and owner fields":
            val blank_reason = exclusion(
                ExclusionKindV1.FixtureUnavailable, reason_length: 0)
            val no_evidence = exclusion(
                ExclusionKindV1.PlatformInapplicable,
                evidence_hi: 0, evidence_lo: 0)
            val no_owner = exclusion(
                ExclusionKindV1.SafetyProhibited, owner: 0)
            expect(mcdc_decision_exclusion_v1_well_formed(
                mcdc_decision_exclusion_v1(decision(), blank_reason),
                decision(), 150)).to_be(false)
            expect(mcdc_decision_exclusion_v1_well_formed(
                mcdc_decision_exclusion_v1(decision(), no_evidence),
                decision(), 150)).to_be(false)
            expect(mcdc_decision_exclusion_v1_well_formed(
                mcdc_decision_exclusion_v1(decision(), no_owner),
                decision(), 150)).to_be(false)

        it "passes normal coverage only with exact 100 percent and validated exclusions":
            val summary = mcdc_coverage_summary_v1(10, 2, 8)
            val complete = mcdc_normal_gate_v1(
                McdcReportModeV1.Normal, true, summary, 2, 2, 0)
            val unvalidated = mcdc_normal_gate_v1(
                McdcReportModeV1.Normal, true, summary, 2, 1, 0)
            val unexplained = mcdc_normal_gate_v1(
                McdcReportModeV1.Normal, true, summary, 2, 2, 1)
            val accounting_mismatch = mcdc_normal_gate_v1(
                McdcReportModeV1.Normal, true, summary, 1, 1, 0)
            expect(mcdc_normal_gate_v1_passes(complete)).to_be(true)
            expect(mcdc_normal_gate_v1_passes(unvalidated)).to_be(false)
            expect(mcdc_normal_gate_v1_passes(unexplained)).to_be(false)
            expect(mcdc_normal_gate_v1_passes(accounting_mismatch)).to_be(false)

        it "enforces exact coverage in alpha and rejects disabled or incomplete gates":
            val summary = mcdc_coverage_summary_v1(10, 2, 8)
            val alpha = mcdc_normal_gate_v1(
                McdcReportModeV1.Alpha, true, summary, 2, 2, 0)
            val disabled = mcdc_normal_gate_v1(
                McdcReportModeV1.Normal, false, summary, 2, 2, 0)
            val incomplete = mcdc_normal_gate_v1(
                McdcReportModeV1.Normal, true,
                mcdc_coverage_summary_v1(10, 2, 7), 2, 2, 0)
            expect(mcdc_normal_gate_v1_passes(alpha)).to_be(true)
            expect(mcdc_normal_gate_v1_passes(disabled)).to_be(false)
            expect(mcdc_normal_gate_v1_passes(incomplete)).to_be(false)

        it "validates bounded V2 source and process provenance rows":
            val row = McdcDecisionReportV2(
                schema_version: MCDC_REPORT_SCHEMA_VERSION,
                decision: decision(), source_file_digest: 77,
                line: 12, column: 7, covered_mask: 5,
                excluded_mask: 2, eligible_mask: 5,
                process_id: 3, process_sequence: 9,
                mode: McdcReportModeV1.Normal)
            expect(mcdc_decision_report_v2_well_formed(row)).to_be(true)
            val escaped = McdcDecisionReportV2(
                schema_version: MCDC_REPORT_SCHEMA_VERSION,
                decision: decision(), source_file_digest: 77,
                line: 12, column: 7, covered_mask: 7,
                excluded_mask: 2, eligible_mask: 5,
                process_id: 3, process_sequence: 9,
                mode: McdcReportModeV1.Normal)
            expect(mcdc_decision_report_v2_well_formed(escaped)).to_be(false)

        it "defines deterministic decision then process merge order":
            val first = McdcDecisionReportV2(
                schema_version: MCDC_REPORT_SCHEMA_VERSION,
                decision: decision(), source_file_digest: 77,
                line: 12, column: 7, covered_mask: 5,
                excluded_mask: 2, eligible_mask: 5,
                process_id: 3, process_sequence: 9,
                mode: McdcReportModeV1.Normal)
            val second = McdcDecisionReportV2(
                schema_version: MCDC_REPORT_SCHEMA_VERSION,
                decision: decision(), source_file_digest: 77,
                line: 12, column: 7, covered_mask: 5,
                excluded_mask: 2, eligible_mask: 5,
                process_id: 4, process_sequence: 1,
                mode: McdcReportModeV1.Normal)
            expect(mcdc_decision_report_v2_before(first, second)).to_be(true)
            expect(mcdc_decision_report_v2_before(second, first)).to_be(false)
