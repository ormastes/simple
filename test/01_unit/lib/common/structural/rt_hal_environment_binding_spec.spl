# @feature mcdc_hal_runtime_hardening
# @req REQ-009 REQ-011 REQ-016 REQ-017 NFR-005 NFR-006

use std.spec.*
use std.io_runtime.{file_read}
use std.common.structural.environment_instruction.*
use std.common.structural.hal_provider.{
    HalErrorDomainV2, HalProviderKind, HalStatusV1,
    hal_environment_plan_receipt_v2,
    hal_environment_plan_result_admitted_v2,
    hal_environment_trace_position_v2,
    hal_provider_scalar_result_v2, hal_structured_error_v2
}

describe "tagged rt(hal) environment binding":
    it "binds the actual clock tag to one ordered fixed-capacity access":
        val initial = rt_hal_environment_binding_v1(
            RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1, 71, 1)
        val step = rt_hal_environment_extract_v1(
            initial, EnvOpcodeV1.ClockRead, 11, 0,
            0, 0, 0, 0, 8, 8)
        val sealed = rt_hal_environment_binding_seal_v1(step.binding)

        expect(step.accepted).to_be(true)
        expect(step.instruction.sequence).to_equal(0)
        expect(step.instruction.opcode).to_equal(EnvOpcodeV1.ClockRead)
        expect(rt_hal_environment_binding_complete_v1(sealed)).to_be(true)
        expect(rt_hal_environment_binding_trace_v1(sealed).instruction_count).to_equal(1)

    it "rejects an opcode that does not belong to the tagged operation":
        val initial = rt_hal_environment_binding_v1(
            RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1, 72, 1)
        val wrong = rt_hal_environment_extract_v1(
            initial, EnvOpcodeV1.EnvironmentGet, 8, 0,
            0, 4, 4, 0, 8, 8)

        expect(wrong.accepted).to_be(false)
        expect(wrong.binding.extraction.instruction_count).to_equal(0)
        expect(wrong.binding.extraction.sealed).to_be(true)
        expect(rt_hal_environment_plan_admitted_v1(
            rt_hal_environment_plan_v1(wrong.binding),
            RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1)).to_be(false)

    it "replays caller-owned bytes once without ambient effect or allocation":
        val extracted = rt_hal_environment_extract_v1(
            rt_hal_environment_binding_v1(
                RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1, 73, 2),
            EnvOpcodeV1.ClockRead, 11, 0, 0, 0, 0, 0, 8, 8)
        val sealed = rt_hal_environment_binding_seal_v1(extracted.binding)
        val plan = rt_hal_environment_plan_v1(sealed)
        val trace = plan.trace
        var recorded: [u8] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8]
        var replayed: [u8] = [0u8; 8]
        val physical = env_execution_record_applied_v1(
            extracted.instruction, [], recorded, 8, true, 0)
        val first = rt_hal_environment_replay_exact_v1(
            rt_hal_environment_plan_replay_v1(
                plan, RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1),
            extracted.instruction,
            extracted.instruction, physical.observation, [], recorded, replayed)
        expect(first.accepted).to_be(true)
        expect(replayed).to_equal(recorded)
        val complete = env_deterministic_replay_seal(
            first.replay, trace.plan_digest_hi, trace.plan_digest_lo)
        expect(env_trace_v1_complete(complete)).to_be(true)
        replayed[0] = 99u8
        val duplicate = rt_hal_environment_replay_exact_v1(
            first.replay, extracted.instruction, extracted.instruction,
            physical.observation, [], recorded, replayed)

        expect(first.receipt.physical_effect).to_be(false)
        expect(first.receipt.allocation_count_after_seal).to_equal(0)
        expect(first.replay.cursor.consumed_count).to_equal(1)
        expect(duplicate.accepted).to_be(false)
        expect(duplicate.replay.cursor.consumed_count).to_equal(1)
        expect(duplicate.replay.cursor.sealed).to_be(true)
        expect(replayed[0]).to_equal(99u8)

        val extra_instruction = env_instruction_v1(
            73, 1, EnvOpcodeV1.ClockRead, 11, 0,
            0, 0, 0, 0, 8, 8)
        var extra_result: [u8] = [77u8; 8]
        val extra_physical = env_execution_record_applied_v1(
            extra_instruction, [], recorded, 8, true, 0)
        val extra = rt_hal_environment_replay_exact_v1(
            first.replay, extra_instruction, extra_instruction,
            extra_physical.observation, [], recorded, extra_result)
        expect(extra.accepted).to_be(false)
        expect(extra_result[0]).to_equal(77u8)

    it "keeps the manifest operation identity in the sealed replay plan":
        val extracted = rt_hal_environment_extract_v1(
            rt_hal_environment_binding_v1(
                RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1, 75, 1),
            EnvOpcodeV1.ClockRead, 11, 0, 0, 0, 0, 0, 8, 8)
        val plan = rt_hal_environment_plan_v1(
            rt_hal_environment_binding_seal_v1(extracted.binding))
        val wrong = rt_hal_environment_plan_replay_v1(
            plan, RT_HAL_ENVIRONMENT_GET_OPERATION_V1)

        expect(rt_hal_environment_plan_admitted_v1(
            plan, RT_HAL_CLOCK_MONOTONIC_NANOS_OPERATION_V1)).to_be(true)
        expect(rt_hal_environment_plan_admitted_v1(
            plan, RT_HAL_ENVIRONMENT_GET_OPERATION_V1)).to_be(false)
        expect(env_replay_cursor_v1_well_formed(wrong.cursor)).to_be(false)

        val position = hal_environment_trace_position_v2(plan, 0)
        expect(position.length).to_equal(1)
        expect(position.capacity).to_equal(1)
        expect(position.cursor).to_equal(0)
        expect(position.identity_hi == plan.trace.plan_digest_hi).to_be(false)

        val receipt = hal_environment_plan_receipt_v2(
            HalProviderKind.C, plan)
        val completed_position = hal_environment_trace_position_v2(plan, 1)
        val result = hal_provider_scalar_result_v2(
            HalProviderKind.C, 75, HalStatusV1.Ok, 42,
            hal_structured_error_v2(HalErrorDomainV2.None, 0),
            completed_position, 1)
        expect(hal_environment_plan_result_admitted_v2(
            receipt, result)).to_be(true)
        val wrong_receipt = hal_environment_plan_receipt_v2(
            HalProviderKind.C,
            RtHalEnvironmentPlanV1(
                tagged_operation_id: RT_HAL_ENVIRONMENT_GET_OPERATION_V1,
                environment_schema_id: plan.environment_schema_id,
                trace: plan.trace, status: plan.status,
                complete: plan.complete))
        expect(hal_environment_plan_result_admitted_v2(
            wrong_receipt, result)).to_be(false)

    it "admits existing typed adapters under a manifest operation identity":
        val initial = rt_hal_environment_binding_v1(
            rt_hal_environment_operation_for_opcode_v1(EnvOpcodeV1.FileRead),
            74, 1)
        val file = rt_hal_environment_extract_v1(
            initial, EnvOpcodeV1.FileRead, 13, 0,
            0, 12, 12, 0, 32, 32)

        expect(file.accepted).to_be(true)
        expect(file.instruction.sequence).to_equal(0)

    it "keeps extraction scalar O(1) and replay free of ambient rereads":
        val source = file_read(
            "src/lib/common/structural/environment_instruction/hal_binding.spl")
        val extract_begin = source.find("fn rt_hal_environment_extract_v1(")
        val extract_end = source.find("fn rt_hal_environment_binding_seal_v1(")
        val replay_begin = source.find("fn rt_hal_environment_replay_exact_v1(")
        val replay_end = source.find("export RT_HAL_ENVIRONMENT_SCHEMA_V1")
        val extract = source.substring(extract_begin, extract_end)
        val replay = source.substring(replay_begin, replay_end)

        expect(extract_begin).to_be_greater_than(-1)
        expect(extract_end).to_be_greater_than(extract_begin)
        expect(extract.contains("while ")).to_equal(false)
        expect(extract.contains("for ")).to_equal(false)
        expect(extract.contains(".push(")).to_equal(false)
        expect(extract.contains("Dict<")).to_equal(false)
        expect(replay.contains("env_get(")).to_equal(false)
        expect(replay.contains("rt_env_get")).to_equal(false)
        expect(replay.contains("time_now")).to_equal(false)
        expect(replay.contains("random_")).to_equal(false)
        expect(replay.contains(".push(")).to_equal(false)
