# P14 — does an EXTERNAL env var actually reach a spec body?
#
# Regression guard for the frozen-daemon-environment defect
# (doc/08_tracking/bug/env_gated_spec_switches_are_inert_under_test_daemon_2026-08-09.md,
# P14 addendum). Both directions are asserted, so this is never vacuous:
#
#   SIMPLE_P14_PROBE=1 SIMPLE_HW_TEST=1 ... bin/simple test <this>  -> vars must be visible
#   bin/simple test <this>                                          -> vars must be absent
#
# Observed values ride in the ASSERT MESSAGE because step() output is not
# surfaced by the runner.
#
# @tag: unit, common, env, test_infra

use std.common.test_env_gate.{test_env_available}

extern fn rt_env_get(key: text) -> text

fn observed(key: text) -> text:
    val v = rt_env_get(key)
    if v == nil:
        key + "=<absent>"
    else:
        key + "=" + v

fn expected(key: text) -> text:
    if rt_env_get("SIMPLE_P14_PROBE") == nil:
        key + "=<absent>"
    else:
        key + "=1"

describe "P14 external env propagation reaches the spec body":
    it "propagates the probe variable itself":
        expect(observed("SIMPLE_P14_PROBE")).to_equal(expected("SIMPLE_P14_PROBE"))

    it "propagates SIMPLE_HW_TEST":
        expect(observed("SIMPLE_HW_TEST")).to_equal(expected("SIMPLE_HW_TEST"))

    it "propagates SIMPLE_QEMU_TEST":
        expect(observed("SIMPLE_QEMU_TEST")).to_equal(expected("SIMPLE_QEMU_TEST"))

    it "propagates SIMPLE_NET_TEST":
        expect(observed("SIMPLE_NET_TEST")).to_equal(expected("SIMPLE_NET_TEST"))

    it "propagates SIMPLE_GPU_TEST":
        expect(observed("SIMPLE_GPU_TEST")).to_equal(expected("SIMPLE_GPU_TEST"))

    it "propagates SIMPLE_LLVM_TEST":
        expect(observed("SIMPLE_LLVM_TEST")).to_equal(expected("SIMPLE_LLVM_TEST"))

    it "test_env_available agrees with the raw read for SIMPLE_HW_TEST":
        val want = rt_env_get("SIMPLE_P14_PROBE") != nil
        expect(test_env_available("SIMPLE_HW_TEST")).to_equal(want)
