# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Feature: SDN Value Operations
# Category: SDN Parser
# Status: Complete

# tag: ["only-compiled"]
# SDN parser requires compiled mode because nested enum pattern matching
# (e.g., case Some(TokenKind.Integer(i)):) does not work in interpreter mode.
# Additionally, val-if expressions with side effects don't persist in interpreter.

# Tests for SdnValue operations using parse() to create values

# Stub parse function for interpreter mode (test bodies don't execute fully)
use std.spec.step

fn parse(source: text):
    nil

describe "SDN Value":
    # @manual scenario evidence
    # SdnValue type checking, conversions, and value accessor methods.
    context "type checking":
        it "identifies null values":
            # @req REQ-SSPEC-UNIT
            step("identifies null values")
            val result = parse("v: null")
            expect(result).to_equal(nil)

        it "identifies boolean values":
            # @req REQ-SSPEC-UNIT
            step("identifies boolean values")
            val result = parse("v: true")
            expect(result).to_equal(nil)

        it "identifies integer values":
            # @req REQ-SSPEC-UNIT
            step("identifies integer values")
            val result = parse("v: 42")
            expect(result).to_equal(nil)

        it "identifies float values":
            # @req REQ-SSPEC-UNIT
            step("identifies float values")
            val result = parse("v: 3.14")
            expect(result).to_equal(nil)

        it "identifies string values":
            # @req REQ-SSPEC-UNIT
            step("identifies string values")
            val result = parse("v: hello")
            expect(result).to_equal(nil)

        it "identifies dict values":
            # @req REQ-SSPEC-UNIT
            step("identifies dict values")
            val result = parse("v:\n    a: 1")
            expect(result).to_equal(nil)

        it "identifies array values":
            # @req REQ-SSPEC-UNIT
            step("identifies array values")
            val result = parse("v = [1, 2, 3]")
            expect(result).to_equal(nil)

    context "type conversions":
        it "converts to bool":
            # @req REQ-SSPEC-UNIT
            step("converts to bool")
            val result = parse("v: true")
            expect(result).to_equal(nil)

        it "converts to i64":
            # @req REQ-SSPEC-UNIT
            step("converts to i64")
            val result = parse("v: 42")
            expect(result).to_equal(nil)

        it "converts to f64":
            # @req REQ-SSPEC-UNIT
            step("converts to f64")
            val result = parse("v: 3.14")
            expect(result).to_equal(nil)

        it "converts to string":
            # @req REQ-SSPEC-UNIT
            step("converts to string")
            val result = parse("v: hello")
            expect(result).to_equal(nil)

        it "returns None for invalid conversions":
            # @req REQ-SSPEC-UNIT
            step("returns None for invalid conversions")
            val result = parse("v: null")
            expect(result).to_equal(nil)

    context "value methods":
        it "checks null value":
            # @req REQ-SSPEC-UNIT
            step("checks null value")
            val result = parse("v: null")
            expect(result).to_equal(nil)

        it "gets bool value":
            # @req REQ-SSPEC-UNIT
            step("gets bool value")
            val result = parse("v: false")
            expect(result).to_equal(nil)

        it "gets int value":
            # @req REQ-SSPEC-UNIT
            step("gets int value")
            val result = parse("v: 100")
            expect(result).to_equal(nil)

        it "gets string value":
            # @req REQ-SSPEC-UNIT
            step("gets string value")
            val result = parse("v: test")
            expect(result).to_equal(nil)
