# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# Collections Specification
#
# Comprehensive tests for stdlib collections including Option, Result,
# Array, List, and Dictionary types. Verifies creation, access, modification,
# and conversion operations for each collection type.

use test.unit.*

describe "Option Type":
    # @manual scenario evidence
    # Tests for the Option type which represents an optional value.
    # Option is either Some(value) or None.
    context "creation and checks":
        it "creates Some value":
            # @req REQ-SSPEC-UNIT
            step("creates Some value")
            val opt = Some(42)
            expect opt.is_some == true

        it "creates None value":
            # @req REQ-SSPEC-UNIT
            step("creates None value")
            val opt = None
            expect opt.is_none == true

        it "is_some returns true for Some":
            # @req REQ-SSPEC-UNIT
            step("is_some returns true for Some")
            val opt = Some(10)
            expect opt.is_some == true

        it "is_none returns true for None":
            # @req REQ-SSPEC-UNIT
            step("is_none returns true for None")
            val opt = None
            expect opt.is_none == true

    context "unwrap operations":
        it "unwrap extracts Some value":
            # @req REQ-SSPEC-UNIT
            step("unwrap extracts Some value")
            val opt = Some(42)
            expect opt.unwrap() == 42

        it "expect returns value with message":
            # @req REQ-SSPEC-UNIT
            step("expect returns value with message")
            val opt = Some(99)
            expect opt.expect("Should have value") == 99

        it "unwrap_or returns default for None":
            # @req REQ-SSPEC-UNIT
            step("unwrap_or returns default for None")
            val opt = None
            expect opt.unwrap_or(0) == 0

        it "unwrap_or returns Some value":
            # @req REQ-SSPEC-UNIT
            step("unwrap_or returns Some value")
            val opt = Some(5)
            expect opt.unwrap_or(0) == 5

    context "or and conversion":
        it "or returns self if Some":
            # @req REQ-SSPEC-UNIT
            step("or returns self if Some")
            val opt1 = Some(1)
            val opt2 = Some(2)
            expect opt1.or(opt2).unwrap() == 1

        it "or returns other if None":
            # @req REQ-SSPEC-UNIT
            step("or returns other if None")
            val opt1 = None
            val opt2 = Some(2)
            expect opt1.or(opt2).unwrap() == 2

        it "ok_or converts Some to Ok":
            # @req REQ-SSPEC-UNIT
            step("ok_or converts Some to Ok")
            val opt = Some(42)
            val res_obj = opt.ok_or("error")
            expect res_obj.is_ok == true

        it "ok_or converts None to Err":
            # @req REQ-SSPEC-UNIT
            step("ok_or converts None to Err")
            val opt = None
            val res_obj = opt.ok_or("error")
            expect res_obj.is_err == true

describe "Result Type":
    # Tests for the Result type which represents success (Ok) or failure (Err).
    # Used for error handling without exceptions.

    context "creation and checks":
        it "creates Ok value":
            # @req REQ-SSPEC-UNIT
            step("creates Ok value")
            val res_obj = Ok(42)
            expect res_obj.is_ok == true

        it "creates Err value":
            # @req REQ-SSPEC-UNIT
            step("creates Err value")
            val res_obj = Err("error")
            expect res_obj.is_err == true

        it "is_ok returns true for Ok":
            # @req REQ-SSPEC-UNIT
            step("is_ok returns true for Ok")
            val res_obj = Ok(10)
            expect res_obj.is_ok == true

        it "is_err returns true for Err":
            # @req REQ-SSPEC-UNIT
            step("is_err returns true for Err")
            val res_obj = Err("error")
            expect res_obj.is_err == true

    context "unwrap operations":
        it "unwrap extracts Ok value":
            # @req REQ-SSPEC-UNIT
            step("unwrap extracts Ok value")
            val res_obj = Ok(42)
            expect res_obj.unwrap() == 42

        it "unwrap_err extracts Err value":
            # @req REQ-SSPEC-UNIT
            step("unwrap_err extracts Err value")
            val res_obj = Err("failure")
            expect res_obj.unwrap_err() == "failure"

        it "unwrap_or returns default for Err":
            # @req REQ-SSPEC-UNIT
            step("unwrap_or returns default for Err")
            val res_obj = Err("error")
            expect res_obj.unwrap_or(0) == 0

        it "unwrap_or returns Ok value":
            # @req REQ-SSPEC-UNIT
            step("unwrap_or returns Ok value")
            val res_obj = Ok(5)
            expect res_obj.unwrap_or(0) == 5

        it "expect returns value with message":
            # @req REQ-SSPEC-UNIT
            step("expect returns value with message")
            val res_obj = Ok(99)
            expect res_obj.expect("Should succeed") == 99

    context "or operations":
        it "or returns self if Ok":
            # @req REQ-SSPEC-UNIT
            step("or returns self if Ok")
            val res1 = Ok(1)
            val res2 = Err("error2")
            expect res1.or(res2).unwrap() == 1

        it "or returns other if Err":
            # @req REQ-SSPEC-UNIT
            step("or returns other if Err")
            val res1 = Err("error1")
            val res2 = Ok(2)
            expect res1.or(res2).unwrap() == 2

    context "conversion operations":
        it "ok converts Ok to Some":
            # @req REQ-SSPEC-UNIT
            step("ok converts Ok to Some")
            val res_obj = Ok(42)
            val opt = res_obj.ok()
            expect opt.is_some == true
            expect opt.unwrap() == 42

        it "ok converts Err to None":
            # @req REQ-SSPEC-UNIT
            step("ok converts Err to None")
            val res_obj = Err("error")
            val opt = res_obj.ok()
            expect opt.is_none == true

        it "err converts Err to Some":
            # @req REQ-SSPEC-UNIT
            step("err converts Err to Some")
            val res_obj = Err("error")
            val opt = res_obj.err()
            expect opt.is_some == true
            expect opt.unwrap() == "error"

        it "err converts Ok to None":
            # @req REQ-SSPEC-UNIT
            step("err converts Ok to None")
            val res_obj = Ok(42)
            val opt = res_obj.err()
            expect opt.is_none == true

describe "Array Type":
    # Tests for the Array type which provides fixed-size indexed collections.
    # Arrays support indexing, length queries, and functional operations.

    context "creation and access":
        it "creates array with literals":
            # @req REQ-SSPEC-UNIT
            step("creates array with literals")
            var arr = [1, 2, 3, 4, 5]
            expect arr.len == 5

        it "accesses elements by index":
            # @req REQ-SSPEC-UNIT
            step("accesses elements by index")
            var arr = [10, 20, 30]
            expect arr[0] == 10
            expect arr[1] == 20
            expect arr[2] == 30

        it "creates empty array":
            # @req REQ-SSPEC-UNIT
            step("creates empty array")
            val empty = []
            expect empty.len == 0

    context "array methods":
        it "push adds element":
            # @req REQ-SSPEC-UNIT
            step("push adds element")
            # Note: push returns a new array (functional style)
            var arr = [1, 2]
            arr = arr.push(3)
            expect arr.len == 3
            expect arr[2] == 3

        it "pop removes last element":
            # Note: pop removes the last element in place and returns it
            var arr = [1, 2, 3]
            arr = arr.pop()
            expect arr.len == 2
            expect arr[1] == 2

        it "contains checks for element":
            # @req REQ-SSPEC-UNIT
            step("contains checks for element")
            var arr = [1, 2, 3]
            expect arr.contains(2) == true
            expect arr.contains(5) == false

        it "is_empty checks length":
            # @req REQ-SSPEC-UNIT
            step("is_empty checks length")
            val empty_arr = []
            expect empty_arr.is_empty == true
            val full = [1]
            expect full.is_empty == false

describe "List Type":
    # Tests for the List type which provides dynamic-size collections.
    # Currently uses array literals as List class requires stdlib module loading.

    # Note: List<T> class requires stdlib module loading which isn't fully available yet
    # Use built-in arrays [] for now - they support functional push/pop/etc.
    context "creation and operations":
        it "creates empty list":
            # @req REQ-SSPEC-UNIT
            step("creates empty list")
            # Try creating with array literal instead
            var list = []
            expect list.is_empty == true

        it "append adds elements":
            # @req REQ-SSPEC-UNIT
            step("append adds elements")
            # Using array literals - they support append operations
            var list = []
            list = list.push(1)
            list = list.push(2)
            expect list.len == 2

        it "length tracking":
            # @req REQ-SSPEC-UNIT
            step("length tracking")
            # Using array literals - they support length operations
            var list = []
            expect list.len == 0
            list = list.push(1)
            expect list.len == 1

        it "access elements":
            # @req REQ-SSPEC-UNIT
            step("access elements")
            # Using array literals - they support indexing
            var list = []
            list = list.push(10)
            list = list.push(20)
            expect list[0] == 10
            expect list[1] == 20

    context "list methods":
        it "contains checks membership":
            # @req REQ-SSPEC-UNIT
            step("contains checks membership")
            # Using array literals - they support contains
            var list = []
            list = list.push(1)
            list = list.push(2)
            list = list.push(3)
            expect list.contains(2) == true
            expect list.contains(5) == false

        it "is_empty returns correct status":
            # @req REQ-SSPEC-UNIT
            step("is_empty returns correct status")
            # Using array literals - they support is_empty
            var list = []
            expect list.is_empty == true
            list = list.push(1)
            expect list.is_empty == false

describe "Dictionary (Dict) Type":
    # Tests for the Dictionary type which provides key-value storage.
    # Supports insertion, retrieval, deletion, and iteration operations.

    context "creation and operations":
        it "creates empty dict":
            # @req REQ-SSPEC-UNIT
            step("creates empty dict")
            val dict = {}
            expect dict.is_empty == true

        it "inserts and retrieves values":
            # Using functional style: dict.set() returns new dict
            # Note: Index assignment (dict["key"] = value) works but
            # requires mutable variable scope (use var dict_ or direct script)
            var dict_ = {}
            dict_ = dict_.set("key1", 10)
            expect dict_.get("key1") == 10

        it "checks for key existence":
            # @req REQ-SSPEC-UNIT
            step("checks for key existence")
            var dict_ = {}
            dict_ = dict_.set("exists", 1)
            expect dict_.contains("exists") == true
            expect dict_.contains("missing") == false

        it "counts items":
            # @req REQ-SSPEC-UNIT
            step("counts items")
            var dict_ = {}
            dict_ = dict_.set("a", 1)
            dict_ = dict_.set("b", 2)
            expect dict_.len == 2

    context "dict methods":
        it "keys returns all keys":
            # @req REQ-SSPEC-UNIT
            step("keys returns all keys")
            var dict_ = {}
            dict_ = dict_.set("x", 1)
            dict_ = dict_.set("y", 2)
            val keys = dict_.keys()
            expect keys.len == 2

        it "values returns all values":
            # @req REQ-SSPEC-UNIT
            step("values returns all values")
            var dict_ = {}
            dict_ = dict_.set("a", 10)
            dict_ = dict_.set("b", 20)
            val values = dict_.values()
            expect values.len == 2

        it "remove deletes entries":
            # @req REQ-SSPEC-UNIT
            step("remove deletes entries")
            var dict_ = {}
            dict_ = dict_.set("key", 1)
            expect dict_.len == 1
            dict_ = dict_.remove("key")
            expect dict_.len == 0

        it "clear removes all entries":
            # @req REQ-SSPEC-UNIT
            step("clear removes all entries")
            var dict_ = {}
            dict_ = dict_.set("a", 1)
            dict_ = dict_.set("b", 2)
            dict_ = dict_.clear()
            expect dict_.is_empty == true
