# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that levenshtein_distance.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.text_advanced.{levenshtein_distance}

use std.spec.step

describe "levenshtein_distance":
    # @manual scenario evidence
    """Edit distance between two strings.

    Regression guard for a value-type write-back defect: the DP matrix rows
    were copied OUT of `dp` with `dp[i]`, mutated, and never written back, so
    the matrix stayed zero-filled and the function returned 0 for EVERY input
    pair. Equal-string cases cannot detect this (0 is also the correct answer),
    so every oracle below asserts a NON-ZERO expected distance.
    """

    it "reports the classic kitten/sitting distance of three":
        # @req REQ-SSPEC-LIB
        step("reports the classic kitten/sitting distance of three")
        step("Verify: reports the classic kitten/sitting distance of three")
        # @req: REQ-LIB-COMMON-001
        # k->s, e->i, +g : three single-character edits.
        expect(levenshtein_distance("kitten", "sitting")).to_equal(3)

    it "counts a full replacement of every character":
        # @req REQ-SSPEC-LIB
        step("counts a full replacement of every character")
        step("Verify: counts a full replacement of every character")
        expect(levenshtein_distance("abc", "xyz")).to_equal(3)

    it "counts pure insertions against the empty string":
        # @req REQ-SSPEC-LIB
        step("counts pure insertions against the empty string")
        step("Verify: counts pure insertions against the empty string")
        expect(levenshtein_distance("", "abcd")).to_equal(4)
        expect(levenshtein_distance("abcd", "")).to_equal(4)

    it "counts a single substitution":
        # @req REQ-SSPEC-LIB
        step("counts a single substitution")
        step("Verify: counts a single substitution")
        expect(levenshtein_distance("flaw", "flow")).to_equal(1)

    it "counts a single deletion":
        # @req REQ-SSPEC-LIB
        step("counts a single deletion")
        step("Verify: counts a single deletion")
        expect(levenshtein_distance("cart", "car")).to_equal(1)

    it "still reports zero for identical strings":
        # @req REQ-SSPEC-LIB
        step("still reports zero for identical strings")
        step("Verify: still reports zero for identical strings")
        expect(levenshtein_distance("same", "same")).to_equal(0)

    it "is symmetric":
        # @req REQ-SSPEC-LIB
        step("is symmetric")
        step("Verify: is symmetric")
        expect(levenshtein_distance("sunday", "saturday")).to_equal(3)
        expect(levenshtein_distance("saturday", "sunday")).to_equal(3)
