"""
## Purpose and audience
Purpose: Pin 16-bit samples and Adam7 interlacing in the PNG decoder, the two
formats it used to reject explicitly. A 16-bit sample keeps its high byte;
tRNS keys compare against the full 16-bit sample; an interlaced image's seven
passes are unfiltered separately and scattered into raster order.
Audience: maintainers of the image decoders used by the browser engine.
## Operator workflow
Run with the test runner; fixtures are built in-spec (stored deflate block,
real CRC and Adler-32), no files or network.
## Compatibility and limitations
Bug record: doc/08_tracking/bug/png_palette_and_inflate_cross_block_2026-10-05.md
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001

use std.spec.*
use std.spec.step
use std.common.image.png_decode.{decode_png_to_argb}
use std.common.compress.gzip.{gzip_crc32}

fn be32(v: i64) -> [u8]:
    [((v >> 24) & 255).to_u8(), ((v >> 16) & 255).to_u8(), ((v >> 8) & 255).to_u8(), (v & 255).to_u8()]

fn chunk(kind: [u8], body: [u8]) -> [u8]:
    var typed: [u8] = []
    for b in kind: typed.push(b)
    for b in body: typed.push(b)
    var out = be32(body.len())
    for b in typed: out.push(b)
    for b in be32(gzip_crc32(typed).to_i64()): out.push(b)
    out

fn adler32(data: [u8]) -> i64:
    var a: i64 = 1
    var b: i64 = 0
    for byte in data:
        a = (a + byte.to_i64()) % 65521
        b = (b + a) % 65521
    (b << 16) | a

fn zlib_stored(raw: [u8]) -> [u8]:
    val n = raw.len()
    var out: [u8] = [0x78u8, 0x01u8, 0x01u8, (n & 255).to_u8(), ((n >> 8) & 255).to_u8(),
        ((n & 255) ^ 255).to_u8(), (((n >> 8) & 255) ^ 255).to_u8()]
    for b in raw: out.push(b)
    for b in be32(adler32(raw)): out.push(b)
    out

fn png(width: i64, height: i64, depth: i64, color: i64, interlace: i64, extra: [[u8]], scanlines: [u8]) -> [u8]:
    var out: [u8] = [137u8, 80u8, 78u8, 71u8, 13u8, 10u8, 26u8, 10u8]
    var ihdr = be32(width)
    for b in be32(height): ihdr.push(b)
    ihdr.push(depth.to_u8())
    ihdr.push(color.to_u8())
    ihdr.push(0u8)
    ihdr.push(0u8)
    ihdr.push(interlace.to_u8())
    for b in chunk([73u8, 72u8, 68u8, 82u8], ihdr): out.push(b)
    for c in extra:
        for b in c: out.push(b)
    for b in chunk([73u8, 68u8, 65u8, 84u8], zlib_stored(scanlines)): out.push(b)
    for b in chunk([73u8, 69u8, 78u8, 68u8], []): out.push(b)
    out

fn trns(values: [u8]) -> [u8]:
    chunk([116u8, 82u8, 78u8, 83u8], values)

fn pixels_of(data: [u8]) -> [u32]:
    match decode_png_to_argb(data):
        Ok(image): image.pixels
        Err(message):
            print "decode error: {message}"
            []

fn gray(v: i64) -> u32:
    0xFF000000u32 | (v.to_u32() << 16) | (v.to_u32() << 8) | v.to_u32()

describe "16-bit samples":
    it "keeps the high byte of 16-bit RGB and RGBA samples":
        step("RGB 0x1234 0xABCD 0xFF00 -> 12 AB FF")
        val rgb = png(1, 1, 16, 2, 0, [], [0u8, 0x12u8, 0x34u8, 0xABu8, 0xCDu8, 0xFFu8, 0x00u8])
        expect(pixels_of(rgb)).to_equal([0xFF12ABFFu32])
        step("RGBA with alpha 0x8000 -> alpha 0x80")
        val rgba = png(1, 1, 16, 6, 0, [], [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0x80u8, 0x00u8])
        expect(pixels_of(rgba)).to_equal([0x80000000u32])

    it "compares a 16-bit tRNS key against the full sample":
        step("gray samples 0x0102 (the key) and 0x0103 share a high byte; only the key is transparent")
        val data = png(2, 1, 16, 0, 0, [trns([1u8, 2u8])], [0u8, 1u8, 2u8, 1u8, 3u8])
        expect(pixels_of(data)).to_equal([0x00010101u32, 0xFF010101u32])

    it "decodes 16-bit gray+alpha":
        val data = png(1, 1, 16, 4, 0, [], [0u8, 0xC8u8, 0x00u8, 0x32u8, 0xFFu8])
        expect(pixels_of(data)).to_equal([0x32C8C8C8u32])

describe "Adam7 interlacing":
    it "scatters the seven passes of a 3x3 image into raster order":
        step("pixel (x, y) holds gray 1 + x + 3y; passes 2 and 3 are empty at this size")
        val scanlines: [u8] = [
            0u8, 1u8,              # pass 1: (0,0)
            0u8, 3u8,              # pass 4: (2,0)
            0u8, 7u8, 9u8,         # pass 5: (0,2) (2,2)
            0u8, 2u8, 0u8, 8u8,    # pass 6: (1,0) / (1,2)
            0u8, 4u8, 5u8, 6u8     # pass 7: row y=1
        ]
        val data = png(3, 3, 8, 0, 1, [], scanlines)
        expect(pixels_of(data)).to_equal([gray(1), gray(2), gray(3), gray(4), gray(5), gray(6), gray(7), gray(8), gray(9)])

    it "unfilters each pass on its own (Sub filter restarts per pass row)":
        step("pass 7 row uses filter 1 (Sub): 4, +1, +1 -> 4 5 6")
        val scanlines: [u8] = [
            0u8, 1u8, 0u8, 3u8, 0u8, 7u8, 9u8, 0u8, 2u8, 0u8, 8u8,
            1u8, 4u8, 1u8, 1u8
        ]
        val data = png(3, 3, 8, 0, 1, [], scanlines)
        expect(pixels_of(data)).to_equal([gray(1), gray(2), gray(3), gray(4), gray(5), gray(6), gray(7), gray(8), gray(9)])

    it "rejects interlaced data with the wrong pass length":
        val data = png(3, 3, 8, 0, 1, [], [0u8, 1u8, 0u8, 3u8])
        match decode_png_to_argb(data):
            Ok(_): expect("decoded").to_equal("rejected")
            Err(message): expect(message).to_contain("does not match")

    it "rejects an unknown interlace method":
        val data = png(1, 1, 8, 0, 2, [], [0u8, 1u8])
        match decode_png_to_argb(data):
            Ok(_): expect("decoded").to_equal("rejected")
            Err(message): expect(message).to_contain("interlace")
