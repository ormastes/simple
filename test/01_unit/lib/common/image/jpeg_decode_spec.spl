"""
## Purpose and audience
Purpose: Pin the pure-Simple JPEG decoder the browser uses for real-site
`image/jpeg` responses: baseline, extended-sequential and progressive
Huffman JPEGs, 4:4:4 / 4:2:2 / 4:2:0 / 4:4:0 chroma subsampling, restart
markers, grayscale, Adobe RGB, and EXIF orientation recording — and prove
that hostile bytes are refused with an error, never a crash or an
unbounded allocation.
Audience: maintainers of the image decoders used by the browser engine.
## Operator workflow
Run with the test runner from the repo root. Fixtures live in
test/fixtures/image/jpeg/<case>/ and are regenerated by
test/fixtures/image/jpeg/regenerate.shs (libjpeg-turbo cjpeg/djpeg + macOS
sips) from src_33x17.ppm, a 33x17 image chosen so every case has partial
MCUs on both axes.
## Compatibility and limitations
Oracles: `djpeg -dct int` output (djpeg_ref.ppm) — the decoder reproduces
libjpeg-turbo's islow IDCT, fancy upsampling and YCbCr tables, so the match
is EXACT (0 differing channel values; measured 2026-10-05 on all 13 cases
and on a 1920x1080 4:2:0 photo-like image, baseline and progressive).
sips_ref.bmp is Apple ImageIO's decode of the same file, an independent
decoder: measured max channel difference 32 and mean <= 2/255 on these
fixtures (ImageIO's upsampling/IDCT differ), so the cross-decoder tolerance
is max 40, mean 3.
EXIF orientation is recorded in `exif_orientation`, NOT applied.
Unsupported and rejected: 12-bit, lossless, arithmetic, hierarchical,
CMYK/YCCK, DNL height.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001
# @cover src/lib/common/image/jpeg_decode.spl 90%

use std.spec.*
use std.spec.step
use std.common.image.jpeg_decode.{decode_jpeg_to_argb, decode_jpeg_to_argb_bounded, jpeg_signature_valid}
use std.common.image.ppm_decode.{decode_ppm_to_argb}
use std.nogc_sync_mut.io_runtime.{file_read_bytes}

val FIXTURES = "test/fixtures/image/jpeg/"

fn fixture(case_name: text, file: text) -> [u8]:
    file_read_bytes(FIXTURES + case_name + "/" + file)

fn bmp24_pixels(d: [u8]) -> [u32]:
    """Top-down or bottom-up 24-bit uncompressed BMP (what sips writes) to ARGB."""
    val off = d[10].to_i64() | (d[11].to_i64() << 8)
    val w = d[18].to_i64() | (d[19].to_i64() << 8)
    val stride = (w * 3 + 3) / 4 * 4
    val hraw = d[22].to_i64() | (d[23].to_i64() << 8) | (d[24].to_i64() << 16) | (d[25].to_i64() << 24)
    val top_down = hraw > 2147483647
    val h = if top_down: 4294967296 - hraw else: hraw
    var out: [u32] = []
    var y: i64 = 0
    while y < h:
        val src_row = if top_down: y else: h - 1 - y
        var x: i64 = 0
        while x < w:
            val p = off + src_row * stride + x * 3
            out.push(0xFF000000u32 | (d[p + 2].to_u32() << 16) | (d[p + 1].to_u32() << 8) | d[p].to_u32())
            x = x + 1
        y = y + 1
    out

fn channel_diff(a: [u32], b: [u32]) -> (i64, i64):
    """(max abs channel difference, mean abs difference x1000) over RGB."""
    if a.len() != b.len() or a.len() == 0:
        return (999, 999000)
    var mx: i64 = 0
    var sum: i64 = 0
    var i: i64 = 0
    while i < a.len():
        var sh: u32 = 0
        while sh < 24:
            val x = ((a[i] >> sh) & 255u32).to_i64()
            val y = ((b[i] >> sh) & 255u32).to_i64()
            val d = if x > y: x - y else: y - x
            if d > mx:
                mx = d
            sum = sum + d
            sh = sh + 8
        i = i + 1
    (mx, sum * 1000 / (a.len() * 3))

fn exact_vs_djpeg(case_name: text) -> i64:
    """Max channel difference against libjpeg-turbo; -1 on decode failure."""
    val decoded = decode_jpeg_to_argb(fixture(case_name, "input.jpg"))
    if decoded.is_err():
        return -1
    val image = decoded.unwrap()
    val reference = decode_ppm_to_argb(fixture(case_name, "djpeg_ref.ppm")).unwrap()
    if image.width != reference.width or image.height != reference.height:
        return -1
    channel_diff(image.pixels, reference.pixels).0

fn with_app1_after_soi(jpeg: [u8], app1_body: [u8]) -> [u8]:
    var out: [u8] = [255u8, 216u8, 255u8, 225u8]
    val seg_len = app1_body.len() + 2
    out.push(((seg_len >> 8) & 255).to_u8())
    out.push((seg_len & 255).to_u8())
    for b in app1_body:
        out.push(b)
    var i: i64 = 2
    while i < jpeg.len():
        out.push(jpeg[i])
        i = i + 1
    out

fn exif_orientation_body(big_endian: bool, orientation: i64) -> [u8]:
    """APP1 "Exif\\0\\0" + TIFF header + IFD0 holding one SHORT Orientation."""
    var b: [u8] = [69u8, 120u8, 105u8, 102u8, 0u8, 0u8]
    if big_endian:
        for v in [77, 77, 0, 42, 0, 0, 0, 8, 0, 1, 1, 18, 0, 3, 0, 0, 0, 1, 0, orientation, 0, 0, 0, 0, 0, 0, 0, 0]:
            b.push(v.to_u8())
    else:
        for v in [73, 73, 42, 0, 8, 0, 0, 0, 1, 0, 18, 1, 3, 0, 1, 0, 0, 0, orientation, 0, 0, 0, 0, 0, 0, 0, 0, 0]:
            b.push(v.to_u8())
    b

fn sof_only(marker: i64, precision: i64, width: i64, height: i64, comps: i64) -> [u8]:
    """SOI + one SOF segment + EOI: enough to exercise header validation."""
    var out: [u8] = [255u8, 216u8, 255u8, marker.to_u8()]
    val seg_len = 8 + comps * 3
    for v in [seg_len >> 8, seg_len & 255, precision, height >> 8, height & 255, width >> 8, width & 255, comps]:
        out.push(v.to_u8())
    var c: i64 = 0
    while c < comps:
        out.push((c + 1).to_u8())
        out.push(17u8)
        out.push(0u8)
        c = c + 1
    out.push(255u8)
    out.push(217u8)
    out

fn prefix(data: [u8], n: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < n and i < data.len():
        out.push(data[i])
        i = i + 1
    out

describe "JPEG decode matches libjpeg-turbo exactly":
    it "decodes baseline 4:4:4, 4:2:2, 4:2:0 and 4:4:0 bit-exactly":
        step("decode each subsampling variant and compare every channel with djpeg -dct int")
        expect(exact_vs_djpeg("baseline_444")).to_equal(0)
        expect(exact_vs_djpeg("baseline_422")).to_equal(0)
        expect(exact_vs_djpeg("baseline_420")).to_equal(0)
        expect(exact_vs_djpeg("baseline_440")).to_equal(0)

    it "decodes progressive spectral-selection and successive-approximation scans bit-exactly":
        step("decode cjpeg -progressive output (DC first/refine, AC first/refine, EOB runs)")
        expect(exact_vs_djpeg("progressive_420")).to_equal(0)
        expect(exact_vs_djpeg("progressive_444")).to_equal(0)
        expect(exact_vs_djpeg("gray_progressive")).to_equal(0)

    it "honors restart markers in sequential and progressive scans":
        step("decode files with an RST marker after every MCU / block")
        expect(exact_vs_djpeg("restart_420")).to_equal(0)
        expect(exact_vs_djpeg("restart_progressive")).to_equal(0)

    it "decodes grayscale, optimized-Huffman, Adobe RGB and Apple-encoded files":
        expect(exact_vs_djpeg("gray")).to_equal(0)
        expect(exact_vs_djpeg("optimized_420")).to_equal(0)
        expect(exact_vs_djpeg("rgb_444")).to_equal(0)
        expect(exact_vs_djpeg("sips_encoded")).to_equal(0)

    it "reports geometry, progressive flag and opaque alpha":
        val image = decode_jpeg_to_argb(fixture("progressive_420", "input.jpg")).unwrap()
        expect(image.width).to_equal(33)
        expect(image.height).to_equal(17)
        assert_true(image.progressive)
        expect(image.pixels.len()).to_equal(561)
        expect(image.pixels[0] >> 24).to_equal(255u32)
        assert_false(decode_jpeg_to_argb(fixture("baseline_420", "input.jpg")).unwrap().progressive)

describe "JPEG decode agrees with an independent decoder (macOS ImageIO)":
    it "stays within the cross-decoder tolerance for every case":
        step("compare with sips' BMP export of the same JPEG")
        for case_name in ["baseline_444", "baseline_422", "baseline_420", "baseline_440", "progressive_420", "restart_420", "gray", "sips_encoded"]:
            val image = decode_jpeg_to_argb(fixture(case_name, "input.jpg")).unwrap()
            val diff = channel_diff(image.pixels, bmp24_pixels(fixture(case_name, "sips_ref.bmp")))
            expect(diff.0).to_be_less_than(41)
            expect(diff.1).to_be_less_than(3001)

describe "JPEG EXIF orientation is recorded, not applied":
    it "defaults to 1 without EXIF":
        expect(decode_jpeg_to_argb(fixture("baseline_444", "input.jpg")).unwrap().exif_orientation).to_equal(1)

    it "reads big- and little-endian IFD0 Orientation":
        val base = fixture("baseline_444", "input.jpg")
        val plain = decode_jpeg_to_argb(base).unwrap()
        val mm = decode_jpeg_to_argb(with_app1_after_soi(base, exif_orientation_body(true, 6))).unwrap()
        val ii = decode_jpeg_to_argb(with_app1_after_soi(base, exif_orientation_body(false, 8))).unwrap()
        expect(mm.exif_orientation).to_equal(6)
        expect(ii.exif_orientation).to_equal(8)
        step("pixels are untouched (orientation is not applied)")
        expect(mm.width).to_equal(plain.width)
        expect(mm.pixels[40]).to_equal(plain.pixels[40])

    it "ignores malformed EXIF instead of failing":
        val base = fixture("baseline_444", "input.jpg")
        var bad = exif_orientation_body(true, 6)
        bad[13] = 200u8
        val image = decode_jpeg_to_argb(with_app1_after_soi(base, bad)).unwrap()
        expect(image.exif_orientation).to_equal(1)

describe "JPEG decode rejects hostile input before allocating":
    it "rejects empty, short and non-JPEG input":
        val empty: [u8] = []
        assert_true(decode_jpeg_to_argb(empty).is_err())
        assert_true(decode_jpeg_to_argb([255u8, 216u8, 255u8]).is_err())
        assert_true(decode_jpeg_to_argb([137u8, 80u8, 78u8, 71u8, 13u8, 10u8, 26u8, 10u8]).is_err())
        assert_false(jpeg_signature_valid([137u8, 80u8, 78u8, 71u8]))
        assert_true(jpeg_signature_valid(fixture("gray", "input.jpg")))

    it "refuses a 65535x65535 frame from its header":
        step("the SOF claims 4.29 G pixels; the decoder must refuse without allocating")
        val r = decode_jpeg_to_argb(sof_only(192, 8, 65535, 65535, 3))
        expect(r.is_err()).to_equal(true)
        expect(r.unwrap_err()).to_equal("JPEG dimensions exceed decoder limits")

    it "enforces the caller's pixel budget":
        val bytes = fixture("baseline_420", "input.jpg")
        val r = decode_jpeg_to_argb_bounded(bytes, 560)
        expect(r.unwrap_err()).to_equal("JPEG dimensions exceed decoder limits")
        assert_true(decode_jpeg_to_argb_bounded(bytes, 561).is_ok())
        assert_true(decode_jpeg_to_argb_bounded(bytes, 0).is_err())

    it "rejects unsupported frame types with a named reason":
        expect(decode_jpeg_to_argb(sof_only(192, 12, 8, 8, 3)).unwrap_err()).to_equal("JPEG sample precision is unsupported")
        expect(decode_jpeg_to_argb(sof_only(201, 8, 8, 8, 3)).unwrap_err()).to_equal("arithmetic-coded JPEG is unsupported")
        expect(decode_jpeg_to_argb(sof_only(195, 8, 8, 8, 3)).unwrap_err()).to_equal("lossless or hierarchical JPEG is unsupported")
        expect(decode_jpeg_to_argb(sof_only(192, 8, 8, 8, 4)).unwrap_err()).to_equal("JPEG component count is unsupported")
        expect(decode_jpeg_to_argb(sof_only(192, 8, 8, 0, 3)).unwrap_err()).to_equal("JPEG DNL-defined height is unsupported")

    it "rejects a frame without scan data":
        expect(decode_jpeg_to_argb(sof_only(192, 8, 8, 8, 3)).unwrap_err()).to_equal("JPEG is missing scan data")

    it "rejects every truncation of a baseline and a progressive file":
        step("decode each 29-byte-stepped prefix; each must fail cleanly")
        for case_name in ["baseline_420", "progressive_420"]:
            val full = fixture(case_name, "input.jpg")
            var n: i64 = 0
            var failures: i64 = 0
            var tried: i64 = 0
            while n < full.len() - 2:
                tried = tried + 1
                if decode_jpeg_to_argb(prefix(full, n)).is_err():
                    failures = failures + 1
                n = n + 29
            expect(failures).to_equal(tried)

    it "survives corrupted entropy data and segment lengths":
        step("flip bytes across the file; decoding must return (Ok or Err), never crash")
        val full = fixture("progressive_420", "input.jpg")
        var pos: i64 = 2
        var returned: i64 = 0
        var tried: i64 = 0
        while pos < full.len():
            var mutated = prefix(full, full.len())
            mutated[pos] = (mutated[pos].to_i64() ^ 0x5A).to_u8()
            val r = decode_jpeg_to_argb(mutated)
            tried = tried + 1
            if r.is_ok():
                val image = r.unwrap()
                expect(image.pixels.len()).to_equal(image.width.to_i64() * image.height.to_i64())
            returned = returned + 1
            pos = pos + 17
        expect(returned).to_equal(tried)

    it "rejects an oversubscribed Huffman table":
        step("a DHT declaring three 1-bit codes cannot be canonical")
        var bytes: [u8] = [255u8, 216u8, 255u8, 196u8, 0u8, 22u8, 0u8, 3u8]
        var i: i64 = 0
        while i < 15:
            bytes.push(0u8)
            i = i + 1
        bytes.push(0u8)
        bytes.push(1u8)
        bytes.push(2u8)
        bytes.push(255u8)
        bytes.push(217u8)
        expect(decode_jpeg_to_argb(bytes).unwrap_err()).to_equal("JPEG Huffman table is oversubscribed")
