"""
## Purpose and audience
Purpose: Prove that render_perf_receipt_v2 construction.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

"""Engine-identity-mandatory performance receipts (render_perf_receipt_v2).

A performance run without an explicit engine identity, or tainted by a
fallback, must be impossible to report as a pass. These examples include
sabotage cases: every bypass route must land on a refusal.
"""

use std.common.perf.render_perf_receipt_v2.{
    RenderPerfReceiptV2, render_perf_receipt_new, perf_receipt_gate,
    perf_receipt_line, perf_engine_id_known, perf_probe_engine_family,
    perf_ctr_set, perf_ctr_get, perf_ctr_measured, perf_ctr_name,
    perf_milestone_counters, perf_milestone_gate, perf_milestone_line,
    RenderPerfGateLedger,
    ENGINE_INTERPRETER, ENGINE_SEED_JIT, ENGINE_PURE_SIMPLE_JIT, ENGINE_AOT,
    PERF_CTR_RASTER_MS, PERF_CTR_DIRTY_PIXELS, PERF_CTR_COUNT,
    PERF_CTR_ALLOCATIONS, PERF_CTR_SCENE_COPY_BYTES,
    PERF_CTR_FULL_READBACK_BYTES, PERF_CTR_UNCHANGED_RASTER_PIXELS,
    PERF_CTR_FORWARD_PHYSICAL_HOPS}

fn milestone_receipt_all_zero(engine: text) -> RenderPerfReceiptV2:
    """A receipt that has ACTUALLY MEASURED all five milestone counters and
    found each to be zero — the only shape entitled to a milestone pass."""
    val r0 = render_perf_receipt_new(engine, "abc123")
    var r = r0!
    val ctrs = perf_milestone_counters()
    var i = 0
    while i < ctrs.len():
        r = perf_ctr_set(r, ctrs[i], 0)
        i = i + 1
    r

use std.spec.step

describe "render_perf_receipt_v2 construction":
    it "constructs with a known engine and attested md5":
        step("Verify: constructs with a known engine and attested md5")
        # @req: REQ-LIB-COMMON-001
        val r = render_perf_receipt_new(ENGINE_SEED_JIT, "d41d8cd98f00b204e9800998ecf8427e")
        assert_true(r.?)
        expect(r!.engine).to_equal(ENGINE_SEED_JIT)
        expect(r!.fallback_status).to_equal("none")

    it "refuses construction with an unknown engine (sabotage: 'native')":
        step("Verify: refuses construction with an unknown engine (sabotage: 'native')")
        # "native" is deliberately NOT an engine id — it is the classic lie.
        val r = render_perf_receipt_new("native", "d41d8cd98f00b204e9800998ecf8427e")
        assert_false(r.?)

    it "refuses construction without a binary attestation":
        step("Verify: refuses construction without a binary attestation")
        val r = render_perf_receipt_new(ENGINE_AOT, "")
        assert_false(r.?)

    it "knows exactly the four engine identities":
        step("Verify: knows exactly the four engine identities")
        assert_true(perf_engine_id_known(ENGINE_INTERPRETER))
        assert_true(perf_engine_id_known(ENGINE_SEED_JIT))
        assert_true(perf_engine_id_known(ENGINE_PURE_SIMPLE_JIT))
        assert_true(perf_engine_id_known(ENGINE_AOT))
        assert_false(perf_engine_id_known("native"))
        assert_false(perf_engine_id_known(""))
        assert_false(perf_engine_id_known("jit"))

describe "render_perf_receipt_v2 gate":
    it "passes a matching, untainted receipt":
        step("Verify: passes a matching, untainted receipt")
        val r = render_perf_receipt_new(ENGINE_INTERPRETER, "abc123")
        expect(perf_receipt_gate(r!, ENGINE_INTERPRETER)).to_equal("pass")

    it "refuses an engine mismatch":
        step("Verify: refuses an engine mismatch")
        val r = render_perf_receipt_new(ENGINE_INTERPRETER, "abc123")
        val v = perf_receipt_gate(r!, ENGINE_PURE_SIMPLE_JIT)
        assert_true(v.starts_with("refuse:engine-mismatch"))

    it "refuses an unknown required engine (sabotage: gate cannot be pointed at a fake engine)":
        step("Verify: refuses an unknown required engine (sabotage: gate cannot be pointed at a fake engine)")
        val r = render_perf_receipt_new(ENGINE_SEED_JIT, "abc123")
        val v = perf_receipt_gate(r!, "fastest")
        assert_true(v.starts_with("refuse:unknown-required-engine"))

    it "refuses a fallback-tainted receipt (sabotage: silent interpreted fallback)":
        step("Verify: refuses a fallback-tainted receipt (sabotage: silent interpreted fallback)")
        val r0 = render_perf_receipt_new(ENGINE_PURE_SIMPLE_JIT, "abc123")
        var r = r0!
        r.fallback_status = "interpreted-fallback:hir-unknown-variable"
        val v = perf_receipt_gate(r, ENGINE_PURE_SIMPLE_JIT)
        assert_true(v.starts_with("refuse:fallback"))

    it "refuses a hand-built receipt whose md5 was blanked after construction":
        step("Verify: refuses a hand-built receipt whose md5 was blanked after construction")
        val r0 = render_perf_receipt_new(ENGINE_SEED_JIT, "abc123")
        var r = r0!
        r.binary_md5 = ""
        val v = perf_receipt_gate(r, ENGINE_SEED_JIT)
        expect(v).to_equal("refuse:missing-binary-attestation")

describe "render_perf_receipt_v2 counters and line":
    it "sets and reads counters; out-of-range reads are -1":
        step("Verify: sets and reads counters; out-of-range reads are -1")
        val r0 = render_perf_receipt_new(ENGINE_INTERPRETER, "abc123")
        val r = perf_ctr_set(r0!, PERF_CTR_RASTER_MS, 42)
        expect(perf_ctr_get(r, PERF_CTR_RASTER_MS)).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(perf_ctr_get(r, PERF_CTR_DIRTY_PIXELS)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(perf_ctr_get(r, PERF_CTR_COUNT)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(perf_ctr_get(r, -1)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "emits a single line naming engine, md5 and fallback":
        step("Verify: emits a single line naming engine, md5 and fallback")
        val r = render_perf_receipt_new(ENGINE_SEED_JIT, "abc123")
        val line = perf_receipt_line(r!)
        assert_true(line.starts_with("perf_receipt_v2 engine=seed-jit"))
        assert_contains(line, "md5=abc123")
        assert_contains(line, "fallback=none")

    it "probe returns interpreter or jit-family, never a third value":
        step("Verify: probe returns interpreter or jit-family, never a third value")
        val fam = perf_probe_engine_family()
        assert_true(fam == "interpreter" or fam == "jit-family")

describe "§0 decisive-milestone gate":
    """The plan's decisive first milestone is a warm frame where allocations,
    scene copy bytes, full readback bytes, unchanged raster pixels and
    physical forward hops are ALL zero. These examples prove the gate can only
    say "pass" when all five were genuinely measured.
    """

    it "gates on exactly five counters":
        step("Verify: gates on exactly five counters")
        expect(perf_milestone_counters().len()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "passes only when all five were measured and are zero":
        step("Verify: passes only when all five were measured and are zero")
        val r = milestone_receipt_all_zero(ENGINE_AOT)
        expect(perf_milestone_gate(r, ENGINE_AOT)).to_equal("pass")

    it "blocks a fresh receipt whose counters were never probed (sabotage: fabricated zero)":
        step("Verify: blocks a fresh receipt whose counters were never probed (sabotage: fabricated zero)")
        # Every counter reads 0 on a fresh receipt. That 0 is not evidence.
        val r = render_perf_receipt_new(ENGINE_AOT, "abc123")
        expect(perf_ctr_get(r!, PERF_CTR_ALLOCATIONS)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_false(perf_ctr_measured(r!, PERF_CTR_ALLOCATIONS))
        expect(perf_milestone_gate(r!, ENGINE_AOT)).to_equal("blocked:unmeasured:allocations")

    it "blocks when any single one of the five is left unmeasured":
        step("Verify: blocks when any single one of the five is left unmeasured")
        val ctrs = perf_milestone_counters()
        var skipped = 0
        var i = 0
        while i < ctrs.len():
            val r0 = render_perf_receipt_new(ENGINE_AOT, "abc123")
            var r = r0!
            var j = 0
            while j < ctrs.len():
                if j != i:
                    r = perf_ctr_set(r, ctrs[j], 0)
                j = j + 1
            expect(perf_milestone_gate(r, ENGINE_AOT))
                .to_equal("blocked:unmeasured:" + perf_ctr_name(ctrs[i]))
            skipped = skipped + 1
            i = i + 1
        # Non-vacuity: this example must have exercised all five omissions.
        expect(skipped).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "fails a measured nonzero allocation (sabotage: one alloc in a warm frame)":
        step("Verify: fails a measured nonzero allocation (sabotage: one alloc in a warm frame)")
        var r = milestone_receipt_all_zero(ENGINE_AOT)
        r = perf_ctr_set(r, PERF_CTR_ALLOCATIONS, 1)
        expect(perf_milestone_gate(r, ENGINE_AOT)).to_equal("fail:nonzero:allocations=1")

    it "fails a measured nonzero value on each of the five in turn":
        step("Verify: fails a measured nonzero value on each of the five in turn")
        val ctrs = perf_milestone_counters()
        var checked = 0
        var i = 0
        while i < ctrs.len():
            var r = milestone_receipt_all_zero(ENGINE_AOT)
            r = perf_ctr_set(r, ctrs[i], 7)
            expect(perf_milestone_gate(r, ENGINE_AOT))
                .to_equal("fail:nonzero:" + perf_ctr_name(ctrs[i]) + "=7")
            checked = checked + 1
            i = i + 1
        expect(checked).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "checks engine identity before any counter (sabotage: perfect numbers, wrong engine)":
        step("Verify: checks engine identity before any counter (sabotage: perfect numbers, wrong engine)")
        val r = milestone_receipt_all_zero(ENGINE_INTERPRETER)
        val v = perf_milestone_gate(r, ENGINE_AOT)
        assert_true(v.starts_with("refuse:engine-mismatch"))

    it "refuses milestone numbers from a fallback-tainted run":
        step("Verify: refuses milestone numbers from a fallback-tainted run")
        var r = milestone_receipt_all_zero(ENGINE_AOT)
        r.fallback_status = "interpreted-fallback:hir-unknown-variable"
        assert_true(perf_milestone_gate(r, ENGINE_AOT).starts_with("refuse:fallback"))

    it "prints unmeasured counters as 'unmeasured', never as 0":
        step("Verify: prints unmeasured counters as 'unmeasured', never as 0")
        val fresh = render_perf_receipt_new(ENGINE_AOT, "abc123")
        val line = perf_milestone_line(fresh!)
        assert_contains(line, "allocations=unmeasured")
        assert_contains(line, "forward_physical_hops=unmeasured")
        val done = milestone_receipt_all_zero(ENGINE_AOT)
        val line2 = perf_milestone_line(done)
        assert_contains(line2, "allocations=0")
        assert_contains(line2, "unchanged_raster_pixels=0")

describe "RenderPerfGateLedger counted verdicts":
    """A verdict must state how many receipts it examined. A gate that
    examined none is an ERROR, not a pass.
    """

    it "reports ERROR when nothing was checked (sabotage: vacuous pass)":
        step("Verify: reports ERROR when nothing was checked (sabotage: vacuous pass)")
        val led = RenderPerfGateLedger.create(ENGINE_AOT)
        expect(led.checked_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_true(led.verdict().starts_with("ERROR — nothing was checked"))
        expect(led.exit_code()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "reports PASS with a nonzero count after admitting real receipts":
        step("Verify: reports PASS with a nonzero count after admitting real receipts")
        var led = RenderPerfGateLedger.create(ENGINE_AOT)
        assert_true(led.admit(milestone_receipt_all_zero(ENGINE_AOT)))
        assert_true(led.admit(milestone_receipt_all_zero(ENGINE_AOT)))
        expect(led.checked_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(led.rejected_op_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(led.last_rejection()).to_equal("")
        assert_contains(led.verdict(), "PASS — 2 receipt(s) checked")
        expect(led.exit_code()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "counts a nonzero-counter rejection and names it":
        step("Verify: counts a nonzero-counter rejection and names it")
        var led = RenderPerfGateLedger.create(ENGINE_AOT)
        var bad = milestone_receipt_all_zero(ENGINE_AOT)
        bad = perf_ctr_set(bad, PERF_CTR_SCENE_COPY_BYTES, 4096)
        assert_false(led.admit(bad))
        expect(led.rejected_op_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(led.blocked_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(led.last_rejection()).to_equal("fail:nonzero:scene_copy_bytes=4096")
        assert_true(led.verdict().starts_with("FAIL — 1 receipt(s) checked, 1 rejected"))
        expect(led.exit_code()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "counts an unmeasurable receipt as blocked, separately from a bad number":
        step("Verify: counts an unmeasurable receipt as blocked, separately from a bad number")
        var led = RenderPerfGateLedger.create(ENGINE_AOT)
        val fresh = render_perf_receipt_new(ENGINE_AOT, "abc123")
        assert_false(led.admit(fresh!))
        expect(led.rejected_op_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(led.blocked_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        assert_contains(led.verdict(), "1 unmeasurable")
        expect(led.exit_code()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "one bad receipt among good ones still reds the whole verdict":
        step("Verify: one bad receipt among good ones still reds the whole verdict")
        var led = RenderPerfGateLedger.create(ENGINE_AOT)
        assert_true(led.admit(milestone_receipt_all_zero(ENGINE_AOT)))
        var bad = milestone_receipt_all_zero(ENGINE_AOT)
        bad = perf_ctr_set(bad, PERF_CTR_FULL_READBACK_BYTES, 8294400)
        assert_false(led.admit(bad))
        assert_true(led.admit(milestone_receipt_all_zero(ENGINE_AOT)))
        expect(led.checked_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(led.rejected_op_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(led.exit_code()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "a ledger required to be AOT rejects interpreter receipts (sabotage: perf claim from the interpreter)":
        step("Verify: a ledger required to be AOT rejects interpreter receipts (sabotage: perf claim from the interpreter)")
        var led = RenderPerfGateLedger.create(ENGINE_AOT)
        assert_false(led.admit(milestone_receipt_all_zero(ENGINE_INTERPRETER)))
        expect(led.rejected_op_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        assert_true(led.last_rejection().starts_with("refuse:engine-mismatch"))

    it "a ledger pointed at a fake engine can never pass (sabotage: 'native')":
        step("Verify: a ledger pointed at a fake engine can never pass (sabotage: 'native')")
        var led = RenderPerfGateLedger.create("native")
        assert_false(led.admit(milestone_receipt_all_zero(ENGINE_AOT)))
        assert_true(led.last_rejection().starts_with("refuse:unknown-required-engine"))
        expect(led.exit_code()).to_equal(1)  # oracle: 1 — named expected value from the requirement
