# std.config core — HOST CONFIG precedence (env > user > host > default).
#
# Source: src/lib/common/config_core/host_config.spl; shell twin and its
# fixtures: sh scripts/setup/host-env.shs --selftest (cases e, e2, f, g).

use std.spec.step

use std.spec.{step}
use std.common.config_core.host_config.{host_config_entries, host_config_resolve, host_config_value}
use std.common.config_core.host_config.{host_config_cpu_features, host_config_env_name, host_config_warnings}
use std.common.config_core.host_config.{host_config_cache_env, host_config_cache_var}
use std.nogc_sync_mut.simd.host_cpu_config.{CpuFeatureSet}

fn defaults_doc() -> text:
    "host_config:\n  schema: simple-host-config-v1\n  # max_build_jobs: 99\n  max_threads: 2\n  os: linux\n  gpu: off\n"

fn host_doc() -> text:
    "host_env:\n  hostname: sthost\n  os: freebsd\n  gpu: on\n"

fn user_doc() -> text:
    "host_config:\n  max_build_jobs: 12   # trailing comment\n  os: macos\n  cpu_family: aarch64\n  cpu_features: neon, sve\n"

describe "std.config core — host config":
    # @manual scenario evidence

    describe "layer precedence":
        it "takes a user value over host and default":
            step("resolve os with default, host and user layers present")
            val entries = host_config_entries(defaults_doc(), host_doc(), user_doc(), [])
            val r = host_config_resolve(entries, "os")
            expect(r.value).to_equal("macos")
            expect(r.layer).to_equal("user")

        it "takes the environment over every file":
            step("SIMPLE_HOST_OS overrides the user file")
            val entries = host_config_entries(defaults_doc(), host_doc(), user_doc(), [("SIMPLE_HOST_OS", "windows")])
            val r = host_config_resolve(entries, "os")
            expect(r.value).to_equal("windows")
            expect(r.layer).to_equal("session")

        it "falls back to the per-host file, then the default":
            val entries = host_config_entries(defaults_doc(), host_doc(), user_doc(), [])
            expect(host_config_value(entries, "gpu")).to_equal("on")
            expect(host_config_value(entries, "max_threads")).to_equal("2")

        it "treats a commented default as unset":
            val entries = host_config_entries(defaults_doc(), "", "", [])
            val r = host_config_resolve(entries, "max_build_jobs")
            expect(r.value).to_equal("")
            expect(r.layer).to_equal("compiled_default")

        it "strips trailing comments and skips invalid values":
            val entries = host_config_entries(defaults_doc(), "", user_doc(), [("SIMPLE_HOST_MAX_BUILD_JOBS", "lots")])
            expect(host_config_value(entries, "max_build_jobs")).to_equal("12")

    describe "env names and cpu features":
        it "maps keys to SIMPLE_HOST_<KEY>":
            expect(host_config_env_name("max_build_jobs")).to_equal("SIMPLE_HOST_MAX_BUILD_JOBS")

        it "feeds cpu_features into CpuFeatureSet":
            val entries = host_config_entries(defaults_doc(), "", user_doc(), [])
            val feats = host_config_cpu_features(entries)
            expect(feats.len()).to_equal(2)
            val set = CpuFeatureSet.from_host_config(host_config_value(entries, "cpu_family"), feats)
            expect(set.arch).to_equal("aarch64")
            expect(set.has_sve).to_equal(true)
            expect(set.highest_tier().name).to_equal("sve")

    describe "schema and value validation (same verdicts as host-env.shs case e2)":
        it "rejects an invalid env value with a warning and falls through":
            val env = [("SIMPLE_HOST_MAX_BUILD_JOBS", "lots"), ("SIMPLE_HOST_OS", "plan9")]
            val entries = host_config_entries(defaults_doc(), host_doc(), user_doc(), env)
            expect(host_config_value(entries, "max_build_jobs")).to_equal("12")
            expect(host_config_value(entries, "os")).to_equal("macos")
            val warnings = host_config_warnings(defaults_doc(), host_doc(), user_doc(), env)
            expect(warnings).to_contain("host-config: warning: ignoring invalid max_build_jobs=lots from env")
            expect(warnings).to_contain("host-config: warning: ignoring invalid os=plan9 from env")

        it "rejects invalid file values and falls through to the next layer":
            val bad_user = "host_config:\n  max_threads: 0\n  gpu: maybe\n"
            val entries = host_config_entries(defaults_doc(), host_doc(), bad_user, [])
            expect(host_config_value(entries, "max_threads")).to_equal("2")
            expect(host_config_value(entries, "gpu")).to_equal("on")
            val warnings = host_config_warnings(defaults_doc(), host_doc(), bad_user, [])
            expect(warnings).to_contain("host-config: warning: ignoring invalid gpu=maybe from user layer")

        it "skips a user file whose schema is not simple-host-config-v1":
            val v9_user = "host_config:\n  schema: simple-host-config-v9\n  os: linux\n"
            val entries = host_config_entries(defaults_doc(), host_doc(), v9_user, [])
            val r = host_config_resolve(entries, "os")
            expect(r.value).to_equal("freebsd")
            expect(r.layer).to_equal("machine")
            val warnings = host_config_warnings(defaults_doc(), host_doc(), v9_user, [])
            expect(warnings).to_contain("host-config: warning: ignoring user layer: schema is not simple-host-config-v1")

        it "emits no warnings for valid layers":
            expect(host_config_warnings(defaults_doc(), host_doc(), user_doc(), []).len()).to_equal(0)

    describe "cache keys (same verdicts as host-env.shs case g)":
        it "maps each cache key to its existing consumer variable":
            expect(host_config_cache_var("cache_scope")).to_equal("SIMPLE_CACHE_SCOPE")
            expect(host_config_cache_var("frontend_cache")).to_equal("SIMPLE_FRONTEND_CACHE")
            expect(host_config_cache_var("native_build_cache_dir")).to_equal("SIMPLE_NATIVE_BUILD_CACHE_DIR")
            expect(host_config_cache_var("gpu")).to_equal("")

        it "supplies defaults for unset consumer variables, on/off as 1/0":
            val cache_user = "host_config:\n  cache_scope: devlane\n  frontend_cache: off\n  hir_cache: on\n  cache_max_bytes: 4096\n"
            val entries = host_config_entries(defaults_doc(), "", cache_user, [])
            val defaults = host_config_cache_env(entries, [])
            expect(defaults.len()).to_equal(4)
            expect(defaults[0].0).to_equal("SIMPLE_CACHE_SCOPE")
            expect(defaults[0].1).to_equal("devlane")
            expect(defaults[1].1).to_equal("0")
            expect(defaults[2].1).to_equal("1")
            expect(defaults[3].0).to_equal("SIMPLE_CACHE_MAX_BYTES")

        it "never overrides a consumer variable that is already set":
            val cache_user = "host_config:\n  cache_scope: devlane\n"
            val entries = host_config_entries(defaults_doc(), "", cache_user, [])
            expect(host_config_cache_env(entries, [("SIMPLE_CACHE_SCOPE", "phase3")]).len()).to_equal(0)

        it "rejects a lane name that could leave its partition, and bad on/off or sizes":
            val bad = "host_config:\n  cache_scope: ../phase3\n  frontend_cache: maybe\n  cache_max_gb: 0\n"
            val entries = host_config_entries(defaults_doc(), "", bad, [("SIMPLE_HOST_CACHE_ROOT", "")])
            expect(host_config_value(entries, "cache_scope")).to_equal("")
            expect(host_config_value(entries, "frontend_cache")).to_equal("")
            expect(host_config_value(entries, "cache_max_gb")).to_equal("")
            val warnings = host_config_warnings(defaults_doc(), "", bad, [])
            expect(warnings).to_contain("host-config: warning: ignoring invalid cache_scope=../phase3 from user layer")
            expect(warnings).to_contain("host-config: warning: ignoring invalid frontend_cache=maybe from user layer")
