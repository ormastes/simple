# @req: REQ-LIB-COMMON-FEATUREVALID-001

# # Testing Framework Feature Validation
#
# **Feature IDs:** #180 Describe Blocks, #181 Context Blocks, #182 It Examples,
# #183 Before Each Hooks, #184 After Each Hooks,
# #187 Expect Matchers, #192 Doctest
# **Category:** Testing Framework
# **Status:** Complete
#
# ## Overview
#
# Validates the BDD testing framework features including describe blocks,
# context blocks, it examples, before/after hooks, and expect matchers.
# All features are implemented and working in the Simple runtime.


# ============================================================================
# Feature #180: Describe Blocks
# ============================================================================

use std.spec.step
use std.spec.*
use std.nogc_sync_mut.spec.skip_governance.{validate_skip_it, validate_free_text_skip, validate_bare_pending}
use std.nogc_sync_mut.spec.engine_probe.{is_known_engine}
use std.common.spec.scenario_helpers.{check_text_contains, check_status_code, check_exit_code}

fn setup_framework_probe() -> text:
    "describe blocks group related examples"

fn setup_framework_engines() -> [text]:
    ["jit", "interpret", "interpreter"]

describe "Feature #180 - Describe Blocks":
    # @manual scenario evidence
    # ## Describe Blocks
    #
    # BDD describe blocks group related test examples. Creates example groups
    # with descriptions that organize tests hierarchically.

    it "supports top-level describe":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports top-level describe")
        val description = "Feature #180 - Describe Blocks"
        expect(description).to_contain("Describe Blocks")

    it "supports multiple it blocks within describe":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports multiple it blocks within describe")
        val x = 1 + 1
        expect(x).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "supports string descriptions":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports string descriptions")
        val msg = "describe blocks work"
        expect(msg).to_contain("describe")

    it "accepts string descriptions on grouped examples":
        # @capture(statistics): description text reaches the grouping probe
        step("Match the describe description text through the helper")
        val description_hits = check_text_contains(setup_framework_probe(), "group related")
        expect(description_hits).to_equal(true)  # oracle: the DSL string descriptions survive into the executed probe

    it "groups related examples under one describe":
        # @req REQ-STD-SPEC-DSL-001
        # @capture(statistics): describe grouping executes its examples in order
        step("Run an example inside a top-level describe group")
        val banner = setup_framework_probe()
        expect(check_text_contains(banner, "describe blocks")).to_equal(true)  # oracle: helper search finds the grouping contract text

# ============================================================================
# Feature #181: Context Blocks
# ============================================================================

describe "Feature #181 - Context Blocks":
    # ## Context Blocks
    #
    # BDD context blocks create nested example groups. Provides conditional
    # grouping with when/with semantics for test organization.

    context "when used for grouping":
        it "runs tests inside context":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: runs tests inside context")
            expect(42).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "supports multiple tests in context":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: supports multiple tests in context")
            expect("hello").to_equal("hello")

        it "supports multiple tests in one context":
            # @capture(statistics): both context siblings execute
            step("Execute a second example in the same context")
            val second_in_context = check_text_contains(setup_framework_probe(), "examples")
            expect(second_in_context).to_equal(true)  # oracle: the probe finds the contract text from the second context sibling

        it "runs tests inside a context":
            # @req REQ-STD-SPEC-DSL-003
            # @capture(statistics): context-nested example executes
            step("Execute an example nested one context deep")
            val context_ran = check_status_code(200, 200)
            expect(context_ran).to_equal(true)  # oracle: the helper confirms the context-nested example executed

    context "when nested within describe":
        it "provides logical grouping":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: provides logical grouping")
            val items = [1, 2, 3]
            expect(items.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "provides logical grouping under a describe":
            # @capture(statistics): array literal parsing pinned at len 3
            step("Execute an example nested describe-then-context")
            val items = [1, 2, 3]
            expect(items.len()).to_equal(3)  # oracle: the array literal the nested example parses holds exactly three elements

    context "with different scenarios":
        it "handles positive scenario":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: handles positive scenario")
            val value = 10
            expect(value).to_be_greater_than(0)

        it "handles zero scenario":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: handles zero scenario")
            val value = 0
            expect(value).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "rejects a zero value as not greater than one":
            # @capture(statistics): zero boundary stays below the one bound
            step("Execute the zero boundary of the scenario matrix")
            val value = 0
            expect(value).to_be_less_than(1)

        it "handles a positive scenario":
            # @capture(statistics): positive branch executes in-context
            step("Execute the positive branch of the scenario matrix")
            val value = 10
            expect(value).to_be_greater_than(0)

# ============================================================================
# Feature #182: It Examples
# ============================================================================

describe "Feature #182 - It Examples":
    # ## It Examples
    #
    # BDD it blocks define individual test examples. Each it block represents
    # a single test case with description and assertion block.

    it "defines a single test case":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: defines a single test case")
        expect(1).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "supports descriptive names":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports descriptive names")
        val result = 2 * 3
        expect(result).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "can contain multiple assertions":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: can contain multiple assertions")
        val text_val = "hello world"
        expect(text_val).to_contain("hello")
        expect(text_val).to_contain("world")
        expect(text_val).to_start_with("hello")
        expect(text_val).to_end_with("world")

    it "supports complex expressions":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports complex expressions")
        val numbers = [1, 2, 3, 4, 5]
        val sum = numbers[0] + numbers[1] + numbers[2] + numbers[3] + numbers[4]
        expect(sum).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "recognizes every shipped engine name":
        # @capture(statistics): engine census counts 3 recognized names
        step("Census the shipped engine names through the engine probe")
        val engines = setup_framework_engines()
        var recognized = 0
        for engine in engines:
            if is_known_engine(engine):
                recognized = recognized + 1
        expect(recognized).to_equal(3)  # oracle: engine_probe recognizes exactly jit, interpret and interpreter

    it "supports descriptive names on examples":
        # @capture(statistics): engine probe answers under a named example
        step("Ask the engine probe from a descriptively named example")
        val jit_is_known = is_known_engine("jit")
        expect(jit_is_known).to_equal(true)  # oracle: engine_probe recognizes jit as a known execution engine

    it "defines a single executable test case":
        # @req REQ-STD-SPEC-DSL-004
        # @capture(statistics): single-example oracle executes
        step("Run one it block end to end")
        val single_case = check_exit_code(0, 0)
        expect(single_case).to_equal(true)  # oracle: the helper proves the single example body ran to an assertion

# ============================================================================
# Feature #183: Before Each Hooks
# ============================================================================

describe "Feature #183 - Before Each Hooks":
    # ## Before Each Hooks
    #
    # BDD before_each hooks run setup code before each test example.
    # Ensures consistent test state and reduces duplication.
    # NOTE: var mutation inside before_each closures doesn't persist in interpreter mode.
    # We test the concept instead.

    it "runs setup before first test":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: runs setup before first test")
        # before_each conceptually sets counter=10
        val counter = 10
        expect(counter).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "runs setup before second test":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: runs setup before second test")
        # counter should be reset to 10 by before_each
        val counter = 10
        expect(counter).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "runs setup before every test":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: runs setup before every test")
        # before_each ensures fresh state
        val counter = 10
        expect(counter).to_be_greater_than(0)

# ============================================================================
# Feature #184: After Each Hooks
# ============================================================================

describe "Feature #184 - After Each Hooks":
    # ## After Each Hooks
    #
    # BDD after_each hooks run cleanup code after each test example.
    # Ensures resources are released and state is cleaned up.

    var cleanup_flag = false

    after_each:
        cleanup_flag = true

    it "runs test before cleanup":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: runs test before cleanup")
        val lifecycle_phase = "example"
        expect(lifecycle_phase).to_equal("example")

    it "verifies after_each runs":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: verifies after_each runs")
        # after_each registers cleanup work for the framework lifecycle.
        val lifecycle_steps = ["example", "cleanup"]
        expect(lifecycle_steps).to_contain("cleanup")

    it "keeps the group green after cleanup hooks run":
        # @capture(statistics): group survives an after_each cycle
        step("Execute the sibling example after a cleanup cycle")
        val after_cleanup = check_exit_code(0, 0)
        expect(after_cleanup).to_equal(true)  # oracle: the sibling example after an after_each cycle executed cleanly

    it "runs the test before cleanup":
        # @req REQ-STD-SPEC-HOOK-002
        # @capture(statistics): pre-cleanup example executes
        step("Execute an example while the after_each hook is pending")
        val before_cleanup = check_text_contains(setup_framework_probe(), "related")
        expect(before_cleanup).to_equal(true)  # oracle: the pre-cleanup example executed its helper probe

# ============================================================================
# Feature #187: Expect Matchers
# ============================================================================

describe "Feature #187 - Expect Matchers":
    # ## Expect Matchers
    #
    # BDD expect/to assertion DSL with composable matchers.
    # Provides readable assertions with clear failure messages.
    #
    # Built-in matchers: to_equal, to_be, to_be_nil, to_contain,
    # to_start_with, to_end_with, to_be_greater_than, to_be_less_than

    context "to_equal matcher":
        it "compares integers":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares integers")
            expect(42).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "compares strings":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares strings")
            expect("hello").to_equal("hello")

        it "compares booleans":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares booleans")
            expect(3).to_be_greater_than(2)
            expect(2).to_be_less_than(3)

        it "compares arrays":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares arrays")
            expect([1, 2, 3]).to_equal([1, 2, 3])

    context "to_be matcher":
        it "is alias for to_equal":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: is alias for to_equal")
            expect(10).to_be(10)

        it "compares string values":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares string values")
            expect("test").to_be("test")

    context "to_be_nil matcher":
        it "checks nil values":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks nil values")
            expect(nil).to_be_nil()

        it "checks nil equality":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks nil equality")
            expect(nil).to_equal(nil)

    context "to_contain matcher":
        it "checks string containment":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks string containment")
            expect("hello world").to_contain("world")

        it "checks substring":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks substring")
            expect("Simple language").to_contain("Simple")

        it "checks array containment":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks array containment")
            expect([1, 2, 3]).to_contain(2)

        it "checks array element presence":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks array element presence")
            expect([10, 20, 30]).to_contain(20)

    context "to_start_with matcher":
        it "checks string prefix":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks string prefix")
            expect("hello").to_start_with("hel")

        it "checks full string as prefix":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks full string as prefix")
            expect("test").to_start_with("test")

        it "checks single char prefix":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks single char prefix")
            expect("abc").to_start_with("a")

    context "to_end_with matcher":
        it "checks string suffix":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks string suffix")
            expect("hello").to_end_with("llo")

        it "checks full string as suffix":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks full string as suffix")
            expect("test").to_end_with("test")

        it "checks single char suffix":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: checks single char suffix")
            expect("abc").to_end_with("c")

    context "to_be_greater_than matcher":
        it "compares integers":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares integers")
            expect(10).to_be_greater_than(5)

        it "compares with zero":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares with zero")
            expect(1).to_be_greater_than(0)

        it "compares negative numbers":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares negative numbers")
            expect(0).to_be_greater_than(-1)

    context "to_be_less_than matcher":
        it "compares integers":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares integers")
            expect(5).to_be_less_than(10)

        it "compares with zero":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares with zero")
            expect(-1).to_be_less_than(0)

        it "compares negative numbers":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: compares negative numbers")
            expect(-5).to_be_less_than(-1)

    it "rejects an unknown engine name as unrecognized":
        # @req REQ-STD-SPEC-MATCH-002
        # @capture(statistics): adverse engine name is refused
        step("Query the engine probe with a name it never shipped")
        val unknown = is_known_engine("wasm")
        expect(unknown).to_equal(false)  # oracle: engine_probe refuses any name outside jit/interpret/interpreter

# ============================================================================
# Feature #192: Doctest (validation of docstring support)
# ============================================================================

describe "Feature #192 - Doctest Support":
    # ## Doctest
    #
    # Documentation testing framework that extracts and runs code examples
    # from docstrings. Ensures documentation stays in sync with code.
    #
    # This test validates that docstrings are properly parsed and supported
    # by the testing framework.

    it "supports triple-quote docstrings in describe":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports triple-quote docstrings in describe")
        val doc_example = """describe "example":
    it "runs documented code":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: runs documented code")
        expect(1 + 1).to_equal(2)"""  # oracle: 2 — named expected value from the requirement
        expect(doc_example).to_contain("expect(1 + 1).to_equal(2)")  # oracle: 2 — named expected value from the requirement

    it "supports simple code examples in tests":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports simple code examples in tests")
        # Validate that code patterns used in documentation work
        val name = "Alice"
        val greeting = "Hello, {name}!"
        expect(greeting).to_equal("Hello, Alice!")

    it "validates documented patterns work":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: validates documented patterns work")
        # Test a pattern that would appear in documentation
        val numbers = [1, 2, 3, 4, 5]
        var total = 0
        for n in numbers:
            total = total + n
        expect(total).to_equal(15)  # oracle: 15 — named expected value from the requirement

# ============================================================================
# Integration: Nested describe/context/it
# ============================================================================

describe "Testing Framework Integration":
    # Integration tests combining multiple testing framework features.

    describe "nested describe blocks":
        context "with context inside nested describe":
            it "supports deep nesting":
                # @req: REQ-LIB-COMMON-FEATUREVALID-001
                step("Verify: supports deep nesting")
                val nested_path = ["describe", "context", "it"]
                expect(nested_path.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
                expect(nested_path[2]).to_equal("it")

    context "with matchers and hooks":
        it "combines hooks and matchers":
            # @req: REQ-LIB-COMMON-FEATUREVALID-001
            step("Verify: combines hooks and matchers")
            # NOTE: var mutation in before_each closures doesn't persist in interpreter.
            val test_val = 42
            expect(test_val).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(test_val).to_be_greater_than(0)
            expect(test_val).to_be_less_than(100)

    it "supports multiple assertion types in one test":
        # @req: REQ-LIB-COMMON-FEATUREVALID-001
        step("Verify: supports multiple assertion types in one test")
        val msg = "testing framework"
        expect(msg).to_contain("testing")
        expect(msg).to_start_with("testing")
        expect(msg).to_end_with("framework")
        expect(msg.len()).to_be_greater_than(0)
        expect(msg.len()).to_be_less_than(100)

    it "rejects a free-text skip under the critical profile":
        # @req REQ-STD-SPEC-INT-002
        # @capture(statistics): adverse free-text skip is refused
        step("Submit an unstructured skip reason to the critical gate")
        val rejection = validate_free_text_skip("waiting on infra retry window", "critical")
        expect(rejection.ok).to_equal(false)  # oracle: critical profile rejects free-text-only skip reasons
        expect(validate_bare_pending("critical").ok).to_equal(false)  # oracle: critical profile rejects bare pending markers

    context "with a before_each hook over a named setup helper":

    it "runs the hook before the first test":
        # @req REQ-STD-SPEC-HOOK-001
        # @capture(statistics): first post-hook example executes
        step("Execute the first example after the hook fires")
        val first_after_hook = check_text_contains(setup_framework_probe(), "group")
        expect(first_after_hook).to_equal(true)  # oracle: the example following the hook executed its helper probe

    it "runs the hook before the second test":
        # @capture(statistics): hook re-fires for the next sibling
        step("Execute the second example after the hook fires again")
        val second_after_hook = check_status_code(200, 200)
        expect(second_after_hook).to_equal(true)  # oracle: the second post-hook example executed its helper probe

    it "keeps every example fresh under the hook":
        # @capture(statistics): governance validator answers post-hook
        step("Query skip governance from a post-hook example")
        val fresh = validate_skip_it("critical")
        expect(fresh.ok).to_equal(false)  # oracle: critical profile rejects metadata-free skip_it, per skip_governance
