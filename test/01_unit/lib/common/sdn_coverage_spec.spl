            step("Exercise: displays false")
            expect(SdnValue.bool(false).to_text()).to_equal("false")

        it "displays integer":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "displays integer"
            step("Exercise: displays integer")
            expect(SdnValue.int(42).to_text()).to_equal("42")

        it "displays simple string without quotes":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "displays simple string without quotes"
            step("Exercise: displays simple string without quotes")
            expect(SdnValue.string("hello").to_text()).to_equal("hello")

        it "displays string with spaces in quotes":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "displays string with spaces in quotes"
            step("Exercise: displays string with spaces in quotes")
            val result = SdnValue.string("hello world").to_text()
            expect(result).to_start_with("\"")
            expect(result).to_end_with("\"")

        it "displays empty array":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "displays empty array"
            step("Exercise: displays empty array")
            expect(SdnValue.empty_array().to_text()).to_equal("[]")

        it "displays array with items":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "displays array with items"
            step("Exercise: displays array with items")
            val arr = SdnValue.array([SdnValue.int(1), SdnValue.int(2)])
            val result = arr.to_text()
            expect(result).to_equal("[1, 2]")


# ============================================================================
# SDN SdnSpan
# ============================================================================

describe "SDN SdnSpan":
    """
    ## SdnSpan Location Tracking

    Tests for SdnSpan struct constructors and merge.
    """

    context "construction":
        it "creates empty span":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates empty span"
            step("Exercise: creates empty span")
            step("Verify: creates empty span")
            val s = SdnSpan.empty()
            expect(s.start).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(s.end).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(s.line).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(s.column).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "creates span with values":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates span with values"
            step("Exercise: creates span with values")
            step("Verify: creates span with values")
            val s = SdnSpan(start: 10, end: 20, line: 1, column: 5)
            expect(s.start).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(s.end).to_equal(20)  # oracle: 20 — named expected value from the requirement

    context "merge":
        it "merges two spans":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "merges two spans"
            step("Exercise: merges two spans")
            step("Verify: merges two spans")
            val a = SdnSpan(start: 0, end: 5, line: 1, column: 0)
            val b = SdnSpan(start: 5, end: 10, line: 1, column: 5)
            val merged = a.merge(b)
            expect(merged.start).to_equal(0)  # oracle: merged span keeps the earlier start of 0
            expect(merged.end).to_equal(10)  # oracle: merged span takes the later end of 10


# ============================================================================
# SDN Lexer
# ============================================================================

describe "SDN Lexer":
    """
    ## SDN Tokenization

    Tests for SDN tokenize function.
    """

    context "tokenize":
        it "tokenizes simple key-value":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "tokenizes simple key-value"
            step("Exercise: tokenizes simple key-value")
            val tokens = tokenize("name: Alice")
            expect(tokens.len()).to_be_greater_than(0)

        it "tokenizes integer value":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "tokenizes integer value"
            step("Exercise: tokenizes integer value")
            val tokens = tokenize("count: 42")
            expect(tokens.len()).to_be_greater_than(0)

        it "tokenizes boolean":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "tokenizes boolean"
            step("Exercise: tokenizes boolean")
            val tokens = tokenize("flag: true")
            expect(tokens.len()).to_be_greater_than(0)

        it "tokenizes empty input":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "tokenizes empty input"
            step("Exercise: tokenizes empty input")
            val tokens = tokenize("")
            expect(tokens.len()).to_equal(0)  # oracle: empty input produces zero tokens


