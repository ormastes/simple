describe "SDN Parser":
    """
    ## SDN Parsing

    Tests for parse, parse_untrusted, parse_config, parse_safe functions.
    """

    context "parse valid input":
        it "parses simple key-value":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses simple key-value"
            step("Exercise: parses simple key-value")
            val result = parse("name: Alice")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

        it "parses integer value":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses integer value"
            step("Exercise: parses integer value")
            val result = parse("count: 42")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

        it "parses boolean values":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses boolean values"
            step("Exercise: parses boolean values")
            val result = parse("flag: true")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

        it "parses array value":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses array value"
            step("Exercise: parses array value")
            val result = parse("items: [1, 2, 3]")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

        it "parses multiple key-values":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses multiple key-values"
            step("Exercise: parses multiple key-values")
            val result = parse("name: Alice\nage: 30")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

    context "parse_untrusted":
        it "parses with size limits":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses with size limits"
            step("Exercise: parses with size limits")
            val result = parse_untrusted("name: Alice")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

    context "parse_config":
        it "parses config-style input":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses config-style input"
            step("Exercise: parses config-style input")
            val result = parse_config("name: Alice")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")

    context "parse_safe":
        it "parses safely":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "parses safely"
            step("Exercise: parses safely")
            val result = parse_safe("name: Alice")
            match result:
                case Ok(v):
                    expect(v.is_dict()).to_equal(true)
                case Err(e):
                    expect("parse failed").to_equal("should not fail")


# ============================================================================
# SDN Error
# ============================================================================

describe "SDN Error":
    """
    ## SDN Error Types

    Tests for SdnError constructors and methods.
    """

    context "error constructors":
        it "creates syntax error":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates syntax error"
            step("Exercise: creates syntax error")
            val err = SdnError.syntax_error("bad token", 1, 5)
            expect(err.message()).to_contain("bad token")

        it "creates syntax error with span":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates syntax error with span"
            step("Exercise: creates syntax error with span")
            step("Verify: creates syntax error with span")
            val span = SdnSpan(start: 0, end: 5, line: 1, column: 0)
            val err = SdnError.syntax_error_with_span("bad", span)
            expect(err.message()).to_contain("bad")

        it "creates unexpected token error":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates unexpected token error"
            step("Exercise: creates unexpected token error")
            step("Verify: creates unexpected token error")
            val span = SdnSpan(start: 0, end: 1, line: 1, column: 0)
            val err = SdnError.unexpected_token("COLON", "IDENT", span)
            expect(err.message()).to_contain("COLON")

        it "creates security error":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates security error"
            step("Exercise: creates security error")
            step("Verify: creates security error")
            val span = SdnSpan(start: 0, end: 1, line: 1, column: 0)
            val err = SdnError.security_error("blocked", span)
            expect(err.is_security_error()).to_equal(true)

        it "non-security error returns false":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "non-security error returns false"
            step("Exercise: non-security error returns false")
            val err = SdnError.syntax_error("msg", 1, 1)
            expect(err.is_security_error()).to_equal(false)


