            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "get returns nil for non-dict non-array"
            step("Exercise: get returns nil for non-dict non-array")
            val v = SdnValue.int(1)
            val result = v.get("x")
