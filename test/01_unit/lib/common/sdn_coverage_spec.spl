# @covers src/lib/common/sdn/ 60%
"""
# SDN Coverage Specification

## Purpose and audience
Branch-coverage evidence for the SDN parser library (lib.common.sdn) for
stdlib maintainers: value constructors, type checks, extraction, mutation,
path access, spans, lexer, parser, and error construction — both branches
of every conditional.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/lib/common/sdn_coverage_spec.spl` and read the SPEC FILE
VERDICT line.
## Compatibility and limitations
Pure in-memory parsing only — no file system, network, or environment
access, so it runs identically on the interpreter and native runner. Split
from `parsers_coverage_spec.spl` to avoid memory pressure (404 it-blocks
hit 2048MB RSS cap).
## Verification guidance and troubleshooting
A failure names the exact value mismatch; rerun the single file and read
the failing scenario name to locate the sdn module and branch involved.
"""
# Lifecycle: doc/01_research/compiler/backend/sdn_self_hosting.md ;
# doc/03_plan/ui/draw_ir/draw_io_sdn_draw_ir_plan.md ;
# doc/04_architecture/format/note_sdn_index.md ;
# doc/05_design/compiler/language_design/codegen/smf_note_sdn_implementation.md
# @manual_section: sdn library coverage

import std.spec

use std.common.sdn.value.{SdnValue, SdnSpan}
use std.common.sdn.error.{SdnError}
use std.common.sdn.lexer.{Token, TokenKind, Lexer, tokenize}
use std.common.sdn.parser.{parse, parse_untrusted, parse_config, parse_safe}


# ============================================================================
# SDN Value Types
# ============================================================================

describe "SDN Value":
    """
    ## SDN Value Construction and Access

    Tests for SdnValue enum constructors, type checks, value extraction,
    mutation, path access, type_name, and display.
    """

    context "constructors":
        it "creates null":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates null"
            step("Exercise: creates null")
            val v = SdnValue.null()
            expect(v.is_null()).to_equal(true)

        it "creates bool true":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates bool true"
            step("Exercise: creates bool true")
            val v = SdnValue.bool(true)
            expect(v.is_bool()).to_equal(true)

        it "creates bool false":
            # @req REQ-LIB-SDN-COV-001
            # @capture(statistics): recorded outcome of "creates bool false"
            step("Exercise: creates bool false")
