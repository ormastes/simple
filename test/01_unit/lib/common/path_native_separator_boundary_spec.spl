# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @req REQ-SSPEC-LIB
#
# DEFECT REPRODUCTION: the Windows separator boundary.
#
# Establishes, by execution rather than citation, WHERE a native backslash path
# is genuinely required on Windows and where a forward slash is fine. The whole
# commonization design rests on this boundary, so it is pinned here as a spec
# rather than left in a commit message.
#
# Measured on Windows 11, 2026-09-01, ONE file, TWO spellings:
#
#   layer                                    backslash form      forward-slash form
#   Win32 file API, in-process (read/write)  OK                  OK
#   spawned cmd.exe /c type <path>           exit 0 + contents   exit 1, "The syntax
#                                                                of the command is
#                                                                incorrect."
#
# The spawned-process row is the defect: it is the documented "fails mute" class
# (cf. e9cf9800e54 "stop failing mute", 8200b73b3bd, ce2bc9df521) -- a wrong-form
# path does not raise, it produces wrong behaviour quietly.
#
# CONCLUSION PINNED HERE: forward slash is the correct canonical INTERNAL form on
# every platform, and conversion belongs at the spawn/argv boundary ONLY, via the
# single seam std.platform.to_native_path.
#
# MAX_PATH, honestly: NOT reproduced on this host and deliberately NOT asserted.
# LongPathsEnabled = 1 in the registry here, and a 403-character path was
# created, written and read back successfully both in-process and through
# cmd.exe. The 261-char cl.exe failure recorded in ce2bc9df521 is a
# NON-long-path-aware SPAWNED TOOL problem (a process opts into long paths via
# its manifest, which cl.exe does not), so its fix is path shortening, not a
# path-form change. Asserting a length limit here would pin this host registry
# state, not the code. What IS asserted below is the part that is a property of
# the code: the helpers preserve a >260-character path length and content
# exactly, so no conversion silently truncates one.
#
# CROSS-PLATFORM: the spawn assertions are gated on is_windows(). Off Windows the
# spec asserts the complementary contract -- to_native_path is the IDENTITY
# function -- so the file is meaningful and green on POSIX rather than skipped.
# NOT EXECUTED ON POSIX by this author: no POSIX host was available.

use std.spec.step

use std.spec.{describe, it, assert_equal, assert_true}
use std.platform.{to_native_path, is_windows}
use std.common.path_pure.{to_backslash, to_slash}
use std.process.{process_run}

describe "Windows separator boundary - forward slash is fine for file I/O, fatal at the spawn boundary":

    it "converts to the native form only on Windows, and is the identity elsewhere":
        # @req REQ-SSPEC-LIB
        step("converts to the native form only on Windows, and is the identity elsewhere")
        val canonical = "C:/tmp/probe.txt"
        if is_windows():
            assert_equal(to_native_path(canonical), "C:" + "\\" + "tmp" + "\\" + "probe.txt")
        else:
            # POSIX: byte-for-byte unchanged. A backslash is a LEGAL POSIX
            # filename character, so rewriting it here would corrupt real paths.
            assert_equal(to_native_path(canonical), canonical)
            assert_equal(to_native_path("a/b" + "\\" + "c"), "a/b" + "\\" + "c")

    it "reproduces the defect: a spawned native tool rejects the forward-slash form":
        # @req REQ-SSPEC-LIB
        step("reproduces the defect: a spawned native tool rejects the forward-slash form")
        if is_windows():
            # Same existing file, two spellings, one spawned tool.
            val fwd  = "C:/Windows/win.ini"
            val back = to_native_path(fwd)
            val ok   = process_run("cmd.exe", ["/c", "type " + back])
            val bad  = process_run("cmd.exe", ["/c", "type " + fwd])
            # The native form works.
            assert_equal(ok.2, 0)
            # The forward-slash form does NOT -- this is the mute failure.
            assert_true(bad.2 != 0)
            # And the two spellings name the SAME file, differing only in form.
            assert_equal(to_slash(back), fwd)
        else:
            # No spawn boundary to probe off Windows; assert the identity
            # contract that makes this whole design safe on POSIX.
            assert_equal(to_native_path("/usr/bin/env"), "/usr/bin/env")

    it "preserves a path longer than MAX_PATH (260) exactly - length and content":
        # @req REQ-SSPEC-LIB
        step("preserves a path longer than MAX_PATH (260) exactly - length and content")
        # Built by repetition so the assertion does not depend on any host path.
        var deep = "C:/mp"
        var i = 0
        while i < 12:
            deep = deep + "/dddddddddddddddddddddddddddddd"
            i = i + 1
        assert_true(deep.len() > 260)
        val native = to_native_path(deep)
        # No truncation: a conversion that silently shortened a long path would
        # be the very defect class this file exists to fence.
        assert_equal(native.len(), deep.len())
        # Round-trip is lossless, so the >260 case carries no special handling
        # and needs none: long paths are enabled per-process, not per-path.
        assert_equal(to_slash(native), deep)
