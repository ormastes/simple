# Reproduce spec for: HIR lowering rejected src/lib/common/text_advanced.spl with
# "untyped function returns a value" for six functions, breaking every
# --entry-closure native-build that pulls in std.common (incl. the MCP servers).
use common.text_advanced.{detect_indent, normalize_indent, dedent_lines, hamming_distance, longest_word, most_common_char}
use std.spec.step
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/common/text_advanced_return_types_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/text_advanced_return_types_spec.md
# doc-path: doc/03_plan/sys_test/text_advanced_return_types_spec.md
# doc-path: doc/04_architecture/text_advanced_return_types_spec.md
# doc-path: doc/05_design/text_advanced_return_types_spec_oracles.md
# @manual: primary


describe "text_advanced value-returning functions are typed":
    it "detect_indent returns the leading-space count":
        step("Verify: detect_indent returns the leading-space count")
        # @req: REQ-SSPEC-LOCAL-001
        expect(detect_indent(["hello", "  world", "    foo"])).to_equal(2)
        expect(detect_indent(["hello", "world"])).to_equal(0)

    it "dedent_lines strips the common indent":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: dedent_lines strips the common indent")
        val out = dedent_lines(["  hello", "    world"])
        expect(out[0]).to_equal("hello")
        expect(out[1]).to_equal("  world")

    it "normalize_indent rescales the indent":
        step("Verify: normalize_indent rescales the indent")
        # @req: REQ-SSPEC-LOCAL-001
        val out = normalize_indent(["  hello", "    world"], 4)
        expect(out[0]).to_equal("    hello")
        expect(out[1]).to_equal("        world")

    it "hamming_distance counts differing positions and is optional":
        step("Verify: hamming_distance counts differing positions and is optional")
        # @req: REQ-SSPEC-LOCAL-001
        expect(hamming_distance("karolin", "kathrin")).to_equal(3)
        expect(hamming_distance("abc", "abcd")).to_equal(nil)

    it "longest_word returns the longest word and its length":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: longest_word returns the longest word and its length")
        val got = longest_word("The quick brown fox") ?? ("", 0)
        expect(got[0]).to_equal("quick")
        expect(got[1]).to_equal(5)
        expect(longest_word("")).to_equal(nil)

    it "most_common_char returns the modal character and its count":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: most_common_char returns the modal character and its count")
        val got = most_common_char("hello") ?? ("", 0)
        expect(got[0]).to_equal("l")
        expect(got[1]).to_equal(2)
        expect(most_common_char("")).to_equal(nil)
