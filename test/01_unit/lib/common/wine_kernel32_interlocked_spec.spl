"""
## Purpose and audience
Purpose: Prove that Wine KERNEL32 interlocked bridge.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use common.wine_kernel32_interlocked.{
    wine_kernel32_execute_interlocked,
    wine_kernel32_interlocked_cell_new,
    wine_kernel32_interlocked_compare_exchange,
    wine_kernel32_interlocked_decrement,
    wine_kernel32_interlocked_exchange,
    wine_kernel32_interlocked_exchange_add,
    wine_kernel32_interlocked_increment
}

use std.spec.step

describe "Wine KERNEL32 interlocked bridge":
    it "executes a bounded interlocked operation sequence":
        step("Verify: executes a bounded interlocked operation sequence")
        # @req: REQ-LIB-COMMON-001
        val result = wine_kernel32_execute_interlocked(
            ["InterlockedIncrement", "InterlockedDecrement", "InterlockedExchange", "InterlockedCompareExchange", "InterlockedExchangeAdd"],
            wine_kernel32_interlocked_cell_new(10),
            40,
            2
        )

        expect(result.ok).to_equal(true)
        expect(result.previous).to_equal(41)  # oracle: 41 — named expected value from the requirement
        expect(result.current).to_equal(43)  # oracle: 43 — named expected value from the requirement
        expect(result.cell.value).to_equal(43)  # oracle: 43 — named expected value from the requirement
        expect(result.operations).to_equal("InterlockedIncrement InterlockedDecrement InterlockedExchange InterlockedCompareExchange InterlockedExchangeAdd")

    it "exposes direct interlocked helpers":
        step("Verify: exposes direct interlocked helpers")
        val incremented = wine_kernel32_interlocked_increment(wine_kernel32_interlocked_cell_new(1))
        val decremented = wine_kernel32_interlocked_decrement(incremented.cell)
        val exchanged = wine_kernel32_interlocked_exchange(decremented.cell, 9)
        val compared = wine_kernel32_interlocked_compare_exchange(exchanged.cell, 11, 9)
        val added = wine_kernel32_interlocked_exchange_add(compared.cell, 4)

        expect(incremented.current).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(decremented.current).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(exchanged.previous).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(compared.current).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(added.previous).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(added.current).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "preserves compare-exchange value when the comparand does not match":
        step("Verify: preserves compare-exchange value when the comparand does not match")
        val result = wine_kernel32_interlocked_compare_exchange(wine_kernel32_interlocked_cell_new(7), 12, 6)

        expect(result.previous).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(result.current).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(result.cell.value).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "keeps interlocked dispatch ordered and bounded":
        step("Verify: keeps interlocked dispatch ordered and bounded")
        val out_of_order = wine_kernel32_execute_interlocked(
            ["InterlockedExchange", "InterlockedIncrement", "InterlockedDecrement", "InterlockedCompareExchange", "InterlockedExchangeAdd"],
            wine_kernel32_interlocked_cell_new(10),
            40,
            2
        )
        expect(out_of_order.ok).to_equal(false)
        expect(out_of_order.error).to_equal("kernel32-interlocked-sequence-expected:InterlockedIncrement")

        val wrong_family = wine_kernel32_execute_interlocked(
            ["InterlockedIncrement", "InterlockedDecrement", "InterlockedExchange", "InterlockedCompareExchange", "HeapAlloc"],
            wine_kernel32_interlocked_cell_new(10),
            40,
            2
        )
        expect(wrong_family.ok).to_equal(false)
        expect(wrong_family.error).to_equal("bridge-wrong-category:HeapAlloc")
