# Purpose and audience: executable specification evidence for the owning engineering team.
# @req core_purity_runtime_split_blocked_native_const_resolution_2026-07-08
# bug: doc/08_tracking/bug/core_purity_runtime_split_blocked_native_const_resolution_2026-07-08.md

use std.spec.step

use std.spec.*
use std.js.engine.runtime.{NATIVE_PARSE_INT, NATIVE_CONSOLE_LOG, NATIVE_MATH_FLOOR, NATIVE_JSON_PARSE}


describe "JS engine NATIVE_* id constants resolve across the module boundary":
    # @manual scenario evidence

    it "resolves NATIVE_* constants imported from std.js.engine.runtime to their defined ids":
        expect(NATIVE_PARSE_INT).to_equal(-10)
        expect(NATIVE_CONSOLE_LOG).to_equal(-1)
        expect(NATIVE_MATH_FLOOR).to_equal(-20)
        expect(NATIVE_JSON_PARSE).to_equal(-30)
