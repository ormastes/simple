"""
## Purpose and audience
Purpose: Prove that ActorSnapshot.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# ActorSnapshot + ActorState Tests
#
# Tests for the actor_snapshot module from nogc_async_immut.
# ActorSnapshot provides immutable frozen captures of actor state.
# ActorState provides mutable versioned state with snapshot creation.

use lib.actor_snapshot.{ActorSnapshot, ActorSnapshot__new, ActorState, ActorState__new, ActorState__named}

use std.spec.step

describe "ActorSnapshot":

    describe "creation":
        it "creates with ActorSnapshot__new":
            step("Verify: creates with ActorSnapshot__new")
            # @req: REQ-LIB-COMMON-001
            val snap = ActorSnapshot.new("hello", 1, 100, "src-1")
            expect(snap.state()).to_equal("hello")

        it "state() returns the correct value":
            step("Verify: state() returns the correct value")
            val snap = ActorSnapshot.new(42, 0, 0, "worker")
            expect(snap.state()).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "version() returns version number":
            step("Verify: version() returns version number")
            val snap = ActorSnapshot.new("data", 5, 10, "node-a")
            expect(snap.version()).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "timestamp() returns timestamp":
            step("Verify: timestamp() returns timestamp")
            val snap = ActorSnapshot.new("data", 3, 77, "node-b")
            expect(snap.timestamp()).to_equal(77)  # oracle: 77 — named expected value from the requirement

        it "source() returns source identifier":
            step("Verify: source() returns source identifier")
            val snap = ActorSnapshot.new("val", 0, 0, "worker-7")
            expect(snap.source()).to_equal("worker-7")

    describe "is_from":
        it "returns true for matching source":
            step("Verify: returns true for matching source")
            val snap = ActorSnapshot.new(nil, 0, 0, "origin-1")
            expect(snap.is_from("origin-1")).to_equal(true)

        it "returns false for non-matching source":
            step("Verify: returns false for non-matching source")
            val snap = ActorSnapshot.new(nil, 0, 0, "origin-1")
            expect(snap.is_from("origin-2")).to_equal(false)

    describe "metadata":
        it "with_metadata returns new snapshot with metadata":
            step("Verify: with_metadata returns new snapshot with metadata")
            val snap = ActorSnapshot.new("st", 0, 0, "s1")
            val snap2 = snap.with_metadata("key", "value")
            expect(snap2.metadata("key")).to_equal("value")

        it "original snapshot unchanged after with_metadata":
            step("Verify: original snapshot unchanged after with_metadata")
            val snap = ActorSnapshot.new("st", 0, 0, "s1")
            val snap2 = snap.with_metadata("key", "value")
            expect(snap.has_metadata("key")).to_equal(false)

        it "has_metadata returns true for existing key":
            step("Verify: has_metadata returns true for existing key")
            val snap = ActorSnapshot.new("st", 0, 0, "s1")
            val snap2 = snap.with_metadata("color", "red")
            expect(snap2.has_metadata("color")).to_equal(true)

        it "has_metadata returns false for missing key":
            step("Verify: has_metadata returns false for missing key")
            val snap = ActorSnapshot.new("st", 0, 0, "s1")
            expect(snap.has_metadata("missing")).to_equal(false)

        it "metadata returns nil for missing key":
            step("Verify: metadata returns nil for missing key")
            val snap = ActorSnapshot.new("data", 0, 0, "s1")
            expect(snap.metadata("nope")).to_be_nil()

        it "with_metadata preserves other fields":
            step("Verify: with_metadata preserves other fields")
            val snap = ActorSnapshot.new("payload", 3, 99, "src-x")
            val snap2 = snap.with_metadata("tag", "v1")
            expect(snap2.state()).to_equal("payload")
            expect(snap2.version()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(snap2.timestamp()).to_equal(99)  # oracle: 99 — named expected value from the requirement
            expect(snap2.source()).to_equal("src-x")

        it "multiple metadata entries":
            step("Verify: multiple metadata entries")
            val snap = ActorSnapshot.new("d", 0, 0, "s")
            val s2 = snap.with_metadata("a", 1)
            val s3 = s2.with_metadata("b", 2)
            expect(s3.metadata("a")).to_equal(1)
            expect(s3.metadata("b")).to_equal(2)

    describe "snapshot with nil state":
        it "handles nil state":
            step("Verify: handles nil state")
            val snap = ActorSnapshot.new(nil, 0, 0, "s1")
            expect(snap.state()).to_be_nil()

        it "handles array state":
            step("Verify: handles array state")
            val snap = ActorSnapshot.new([1, 2, 3], 1, 5, "arr-src")
            expect(snap.state()).to_equal([1, 2, 3])

describe "ActorState":

    describe "creation":
        it "creates with initial state":
            step("Verify: creates with initial state")
            var st = ActorState.new("initial", "worker-1")
            expect(st.current()).to_equal("initial")

        it "version starts at 0":
            step("Verify: version starts at 0")
            var st = ActorState.new(100, "w1")
            expect(st.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "source returns identifier":
            step("Verify: source returns identifier")
            var st = ActorState.new(nil, "my-actor")
            expect(st.source()).to_equal("my-actor")

        it "ActorState__named creates with nil initial":
            step("Verify: ActorState__named creates with nil initial")
            var st = ActorState.named("lazy-actor")
            expect(st.current()).to_be_nil()
            expect(st.source()).to_equal("lazy-actor")
            expect(st.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "update":
        it "update replaces state":
            step("Verify: update replaces state")
            var st = ActorState.new("old", "w")
            st.update("new")
            expect(st.current()).to_equal("new")

        it "update increments version":
            step("Verify: update increments version")
            var st = ActorState.new(0, "w")
            st.update(1)
            expect(st.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "multiple updates increment version correctly":
            step("Verify: multiple updates increment version correctly")
            var st = ActorState.new("a", "w")
            st.update("b")
            st.update("c")
            st.update("d")
            expect(st.version()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(st.current()).to_equal("d")

    describe "update_with":
        it "applies function to current state":
            step("Verify: applies function to current state")
            var st = ActorState.new(10, "calc")
            st.update_with(_1 * 2)
            expect(st.current()).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "increments version":
            step("Verify: increments version")
            var st = ActorState.new(5, "calc")
            st.update_with(_1 + 1)
            expect(st.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "snapshot":
        it "creates snapshot of current state":
            step("Verify: creates snapshot of current state")
            var st = ActorState.new("data", "w-1")
            val snap = st.snapshot()
            expect(snap.state()).to_equal("data")
            expect(snap.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(snap.source()).to_equal("w-1")

        it "snapshot isolated from subsequent updates":
            step("Verify: snapshot isolated from subsequent updates")
            var st = ActorState.new("before", "w")
            val snap = st.snapshot()
            st.update("after")
            expect(snap.state()).to_equal("before")
            expect(snap.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(st.current()).to_equal("after")

        it "snapshot_with uses custom state":
            step("Verify: snapshot_with uses custom state")
            var st = ActorState.new([1, 2, 3], "w")
            val snap = st.snapshot_with("custom-view")
            expect(snap.state()).to_equal("custom-view")
            expect(snap.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(snap.source()).to_equal("w")

    describe "metadata":
        it "set_metadata propagates to snapshots":
            step("Verify: set_metadata propagates to snapshots")
            var st = ActorState.new("data", "w")
            st.set_metadata("env", "production")
            val snap = st.snapshot()
            expect(snap.has_metadata("env")).to_equal(true)
            expect(snap.metadata("env")).to_equal("production")

        it "set_metadata overwrites existing key":
            step("Verify: set_metadata overwrites existing key")
            var st = ActorState.new("d", "w")
            st.set_metadata("key", "v1")
            st.set_metadata("key", "v2")
            val snap = st.snapshot()
            expect(snap.metadata("key")).to_equal("v2")

    describe "multiple updates and snapshots":
        it "snapshots at different versions":
            step("Verify: snapshots at different versions")
            var st = ActorState.new(0, "counter")
            val snap0 = st.snapshot()
            st.update(10)
            val snap1 = st.snapshot()
            st.update(20)
            val snap2 = st.snapshot()
            expect(snap0.state()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(snap0.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(snap1.state()).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(snap1.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(snap2.state()).to_equal(20)  # oracle: 20 — named expected value from the requirement
            expect(snap2.version()).to_equal(2)  # oracle: 2 — named expected value from the requirement
