"""
## Purpose and audience
Purpose: Prove that VersionedSnapshot.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# VersionedSnapshot -- MVCC Versioned Container Tests
#
# Tests for VersionedSnapshot and Snapshot classes from nogc_async_immut/versioned.
# VersionedSnapshot maintains a bounded history of versioned values
# for multi-version concurrency control style reads.

use lib.versioned.{VersionedSnapshot, VersionedSnapshot__new, VersionedSnapshot__with_history, Snapshot, Snapshot__new}

use std.spec.step

describe "VersionedSnapshot":

    # ========================================================================
    # Creation
    # ========================================================================

    describe "creation":
        it "creates with initial value at version 0":
            step("Verify: creates with initial value at version 0")
            # @req: REQ-LIB-COMMON-001
            val vs = VersionedSnapshot.new(100)
            expect(vs.current()).to_equal(100)  # oracle: 100 — named expected value from the requirement
            expect(vs.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "creates with string initial value":
            step("Verify: creates with string initial value")
            val vs = VersionedSnapshot.new("hello")
            expect(vs.current()).to_equal("hello")

        it "creates with nil initial value":
            step("Verify: creates with nil initial value")
            val vs = VersionedSnapshot.new(nil)
            expect(vs.current()).to_be_nil()

        it "creates with custom max_history":
            step("Verify: creates with custom max_history")
            val vs = VersionedSnapshot.with_history("start", 3)
            expect(vs.current()).to_equal("start")
            expect(vs.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # Read operations
    # ========================================================================

    describe "current":
        it "returns initial value":
            step("Verify: returns initial value")
            val vs = VersionedSnapshot.new(42)
            expect(vs.current()).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "returns latest value after updates":
            step("Verify: returns latest value after updates")
            var vs = VersionedSnapshot.new(1)
            vs.update(2)
            vs.update(3)
            expect(vs.current()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    describe "version":
        it "starts at 0":
            step("Verify: starts at 0")
            val vs = VersionedSnapshot.new(0)
            expect(vs.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "increments on each update":
            step("Verify: increments on each update")
            var vs = VersionedSnapshot.new(0)
            vs.update(10)
            expect(vs.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            vs.update(20)
            expect(vs.version()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    describe "at_version":
        it "returns value at version 0":
            step("Verify: returns value at version 0")
            val vs = VersionedSnapshot.new(100)
            expect(vs.at_version(0)).to_equal(100)  # oracle: 100 — named expected value from the requirement

        it "returns value at specific version":
            step("Verify: returns value at specific version")
            var vs = VersionedSnapshot.new("a")
            vs.update("b")
            vs.update("c")
            expect(vs.at_version(0)).to_equal("a")
            expect(vs.at_version(1)).to_equal("b")
            expect(vs.at_version(2)).to_equal("c")

        it "returns nil for missing version":
            step("Verify: returns nil for missing version")
            val vs = VersionedSnapshot.new(10)
            expect(vs.at_version(99)).to_be_nil()

        it "returns nil for negative version":
            step("Verify: returns nil for negative version")
            val vs = VersionedSnapshot.new(10)
            expect(vs.at_version(-1)).to_be_nil()

    describe "has_version":
        it "returns true for existing version":
            step("Verify: returns true for existing version")
            val vs = VersionedSnapshot.new(10)
            expect(vs.has_version(0)).to_equal(true)

        it "returns false for missing version":
            step("Verify: returns false for missing version")
            val vs = VersionedSnapshot.new(10)
            expect(vs.has_version(5)).to_equal(false)

        it "tracks updated versions":
            step("Verify: tracks updated versions")
            var vs = VersionedSnapshot.new(0)
            vs.update(1)
            expect(vs.has_version(0)).to_equal(true)
            expect(vs.has_version(1)).to_equal(true)
            expect(vs.has_version(2)).to_equal(false)

    describe "version_count":
        it "starts at 1 with initial value":
            step("Verify: starts at 1 with initial value")
            val vs = VersionedSnapshot.new(10)
            expect(vs.version_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "grows with updates":
            step("Verify: grows with updates")
            var vs = VersionedSnapshot.new(0)
            vs.update(1)
            vs.update(2)
            expect(vs.version_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    # ========================================================================
    # Snapshot
    # ========================================================================

    describe "snapshot":
        it "creates frozen snapshot of current state":
            step("Verify: creates frozen snapshot of current state")
            val vs = VersionedSnapshot.new(42)
            val snap = vs.snapshot()
            expect(snap.get()).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(snap.get_version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "snapshot reflects latest update":
            step("Verify: snapshot reflects latest update")
            var vs = VersionedSnapshot.new(1)
            vs.update(2)
            vs.update(3)
            val snap = vs.snapshot()
            expect(snap.get()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(snap.get_version()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "snapshot is immutable after creation":
            step("Verify: snapshot is immutable after creation")
            var vs = VersionedSnapshot.new(10)
            val snap = vs.snapshot()
            vs.update(20)
            vs.update(30)
            expect(snap.get()).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(snap.get_version()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(vs.current()).to_equal(30)  # oracle: 30 — named expected value from the requirement

    describe "Snapshot__new":
        it "creates snapshot directly":
            step("Verify: creates snapshot directly")
            val snap = Snapshot.new(5, "data")
            expect(snap.get()).to_equal("data")
            expect(snap.get_version()).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "creates snapshot with nil value":
            step("Verify: creates snapshot with nil value")
            val snap = Snapshot.new(0, nil)
            expect(snap.get()).to_be_nil()
            expect(snap.get_version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # History
    # ========================================================================

    describe "history":
        it "returns all version entries":
            step("Verify: returns all version entries")
            var vs = VersionedSnapshot.new("a")
            vs.update("b")
            vs.update("c")
            val h = vs.history()
            expect(h.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "entries contain version and value":
            step("Verify: entries contain version and value")
            var vs = VersionedSnapshot.new(10)
            vs.update(20)
            val h = vs.history()
            expect(h[0][0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(h[0][1]).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(h[1][0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(h[1][1]).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "initial state has one entry":
            step("Verify: initial state has one entry")
            val vs = VersionedSnapshot.new(42)
            val h = vs.history()
            expect(h.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(h[0][0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(h[0][1]).to_equal(42)  # oracle: 42 — named expected value from the requirement

    describe "history_since":
        it "returns entries from given version onwards":
            step("Verify: returns entries from given version onwards")
            var vs = VersionedSnapshot.new("a")
            vs.update("b")
            vs.update("c")
            val h = vs.history_since(1)
            expect(h.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(h[0][1]).to_equal("b")
            expect(h[1][1]).to_equal("c")

        it "returns all entries when version is 0":
            step("Verify: returns all entries when version is 0")
            var vs = VersionedSnapshot.new(10)
            vs.update(20)
            val h = vs.history_since(0)
            expect(h.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "returns empty when version is beyond current":
            step("Verify: returns empty when version is beyond current")
            var vs = VersionedSnapshot.new(10)
            vs.update(20)
            val h = vs.history_since(99)
            expect(h.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # Write operations
    # ========================================================================

    describe "update":
        it "adds new version":
            step("Verify: adds new version")
            var vs = VersionedSnapshot.new(1)
            vs.update(2)
            expect(vs.current()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(vs.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "multiple updates track all values":
            step("Verify: multiple updates track all values")
            var vs = VersionedSnapshot.new(0)
            vs.update(10)
            vs.update(20)
            vs.update(30)
            expect(vs.current()).to_equal(30)  # oracle: 30 — named expected value from the requirement
            expect(vs.version()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(vs.at_version(1)).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(vs.at_version(2)).to_equal(20)  # oracle: 20 — named expected value from the requirement

    describe "update_with":
        it "applies function to current value":
            step("Verify: applies function to current value")
            var vs = VersionedSnapshot.new(10)
            vs.update_with(_1 * 2)
            expect(vs.current()).to_equal(20)  # oracle: 20 — named expected value from the requirement
            expect(vs.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "chains function applications":
            step("Verify: chains function applications")
            var vs = VersionedSnapshot.new(1)
            vs.update_with(_1 + 1)
            vs.update_with(_1 * 10)
            expect(vs.current()).to_equal(20)  # oracle: 20 — named expected value from the requirement
            expect(vs.at_version(1)).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(vs.at_version(2)).to_equal(20)  # oracle: 20 — named expected value from the requirement

    # ========================================================================
    # History trimming
    # ========================================================================

    describe "max_history trimming":
        it "trims oldest entries when exceeding max_history":
            step("Verify: trims oldest entries when exceeding max_history")
            var vs = VersionedSnapshot.with_history(0, 3)
            vs.update(1)
            vs.update(2)
            vs.update(3)
            # 4 entries total, max is 3 -- version 0 should be trimmed
            expect(vs.version_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(vs.has_version(0)).to_equal(false)
            expect(vs.has_version(1)).to_equal(true)

        it "retains latest entries":
            step("Verify: retains latest entries")
            var vs = VersionedSnapshot.with_history(0, 2)
            vs.update(1)
            vs.update(2)
            vs.update(3)
            # max 2: should keep versions 2 and 3
            expect(vs.current()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(vs.version_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "at_version returns nil for trimmed versions":
            step("Verify: at_version returns nil for trimmed versions")
            var vs = VersionedSnapshot.with_history(0, 2)
            vs.update(10)
            vs.update(20)
            vs.update(30)
            expect(vs.at_version(0)).to_be_nil()
            expect(vs.at_version(1)).to_be_nil()
