use std.common.trace.observer_contract_v1.*
use std.common.trace.observer_config_v1.*
use std.common.crypto.sha256.{sha256_u8_hex}

describe "observer V1 strict SDN configuration":
    it "API-01 binds the extension schema hash to the exact descriptor":
        expect(sha256_u8_hex(TRACE_CONFIG_SCHEMA_DESCRIPTOR_V1.bytes())).to_equal(TRACE_CONFIG_SCHEMA_HASH_V1)

    it "API-01 defaults to off without resolving any platform backend":
        val config = trace_config_parse_sdn_v1("trace:\n    schema: 1\n").unwrap()
        expect(config.instrumentation).to_equal(TraceInstrumentationV1.Off)
        expect(config.backend).to_equal(TraceBackendV1.Auto)
        expect(config.consistency).to_equal(TraceConsistencyV1.RawEdges)
        expect(config.patch_mode).to_equal(TracePatchModeV1.Quiescent)
        expect(config.event_mask).to_equal(7)
        expect(config.abi_profile).to_equal("")
        expect(config.buffer_bytes).to_equal(98304)

    it "API-01 freezes the default document including bounded resource keys":
        val encoded = trace_config_format_sdn_v1(trace_config_defaults_v1()).unwrap()
        val golden = "trace:\n    schema: 1\n    instrumentation: off\n    backend: auto\n    consistency: raw_edges\n    patch_mode: quiescent\n    abi_profile: \"\"\n    events: [entry, exit, tail_exit]\n    buffer_bytes: 98304\n    max_contexts: 64\n    max_depth: 128\n    max_resident_generations: 8\n"
        expect(encoded).to_equal(golden)

    it "API-01 preserves explicit requests without granting profile capabilities":
        var config = trace_config_defaults_v1()
        config.instrumentation = TraceInstrumentationV1.Dynamic
        config.backend = TraceBackendV1.Simple
        config.consistency = TraceConsistencyV1.PairedSpans
        config.patch_mode = TracePatchModeV1.Live
        config.abi_profile = "unqualified-test-profile"
        config.event_mask = 1023
        config.buffer_bytes = 192
        config.max_contexts = 2
        config.max_depth = 3
        config.max_resident_generations = 4
        val parsed = trace_config_parse_sdn_v1(trace_config_format_sdn_v1(config).unwrap()).unwrap()
        expect(parsed.instrumentation).to_equal(config.instrumentation)
        expect(parsed.backend).to_equal(config.backend)
        expect(parsed.consistency).to_equal(config.consistency)
        expect(parsed.patch_mode).to_equal(config.patch_mode)
        expect(parsed.abi_profile).to_equal(config.abi_profile)
        expect(parsed.event_mask).to_equal(config.event_mask)
        expect(parsed.buffer_bytes).to_equal(config.buffer_bytes)
        expect(parsed.max_contexts).to_equal(config.max_contexts)
        expect(parsed.max_depth).to_equal(config.max_depth)
        expect(parsed.max_resident_generations).to_equal(config.max_resident_generations)

    it "API-01 rejects schema ambiguity duplicate keys and unknown fields":
        for source in ["", "{}", "trace: {}", "trace:\n    schema: 2\n",
                "trace:\n    schema: 1\n    schema: 1\n",
                "trace:\n    schema: 1\n    backned: llvm\n",
                "trace:\n    schema: 1\nother: true\n",
                "trace:\n    schema: 1\n    backend: [llvm]\n"]:
            expect(trace_config_parse_sdn_v1(source).is_err()).to_equal(true)

    it "API-01 preserves llvm always-on requests and explicit disabled backend":
        var config = trace_config_defaults_v1()
        config.instrumentation = TraceInstrumentationV1.AlwaysOn
        config.backend = TraceBackendV1.Llvm
        config.abi_profile = "test.scalar-v1"
        val encoded = trace_config_format_sdn_v1(config).unwrap()
        val parsed = trace_config_parse_sdn_v1(encoded).unwrap()
        expect(parsed.instrumentation).to_equal(TraceInstrumentationV1.AlwaysOn)
        expect(parsed.backend).to_equal(TraceBackendV1.Llvm)
        expect(trace_config_format_sdn_v1(parsed).unwrap()).to_equal(encoded)
        config.instrumentation = TraceInstrumentationV1.Off
        config.backend = TraceBackendV1.None
        val disabled = trace_config_parse_sdn_v1(trace_config_format_sdn_v1(config).unwrap()).unwrap()
        expect(disabled.backend).to_equal(TraceBackendV1.None)

    it "API-01 rejects invalid options event selections and numeric coercion":
        for field in ["instrumentation: enabled", "backend: fallback", "consistency: exact",
                "patch_mode: unsafe", "events: []", "events: [entry, entry]",
                "events: [unknown]", "events: entry", "buffer_bytes: 95",
                "max_contexts: 0", "max_depth: -1", "max_depth: 1.0",
                "max_depth: \"1\"", "max_resident_generations: false",
                "buffer_bytes: 9223372036854775808"]:
            val source = "trace:\n    schema: 1\n    {field}\n"
            expect(trace_config_parse_sdn_v1(source).is_err()).to_equal(true)

    it "API-01 rejects active mode without a profile or with none backend":
        val prefix = "trace:\n    schema: 1\n    instrumentation: dynamic\n"
        expect(trace_config_parse_sdn_v1(prefix).is_err()).to_equal(true)
        val none = prefix + "    abi_profile: scalar\n    backend: none\n"
        expect(trace_config_parse_sdn_v1(none).is_err()).to_equal(true)
        var config = trace_config_defaults_v1()
        config.event_mask = 1024
        expect(trace_config_format_sdn_v1(config).is_err()).to_equal(true)
        config.event_mask = 7
        config.abi_profile = "bad\"profile"
        expect(trace_config_format_sdn_v1(config).is_err()).to_equal(true)

    it "API-01 bounds parser input and rejects trailing authored content":
        expect(trace_config_parse_sdn_v1("x".repeat(4097)).is_err()).to_equal(true)
        val trailing = "trace:\n    schema: 1\n[entry]\n"
        expect(trace_config_parse_sdn_v1(trailing).is_err()).to_equal(true)
