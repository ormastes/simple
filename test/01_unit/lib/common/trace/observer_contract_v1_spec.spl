use std.common.trace.observer_contract_v1.*
use std.common.plugin.aspect_params.*

describe "backend-neutral trace observer V1 contract":
    it "API-01 preserves the existing aspect parameter ordinals and off defaults":
        val params = AspectParamsV1.defaults()
        expect(ASPECT_PARAM_LOG_CALLS).to_equal(0)
        expect(ASPECT_PARAM_MCDC_MANIFEST_SHA256).to_equal(5)
        expect(params.hdr.schema_major).to_equal(1)
        expect(params.hdr.present).to_equal(0)
        expect(params.log_calls).to_equal(false)
        expect(params.ext.len()).to_equal(1)
        expect(params.ext[0].ext_name).to_equal(ASPECT_CUTOVER_ATOMIC_EXT_V1)
        expect(ASPECT_TRACE_OBSERVER_EXT_V1).to_equal("simple.trace/observer-v1")

    it "API-01 freezes raw, paired, transition and loss tags before backend admission":
        expect(trace_event_kind_code_v1(TraceEventKindV1.Entry)).to_equal(1)
        expect(trace_event_kind_code_v1(TraceEventKindV1.Exit)).to_equal(2)
        expect(trace_event_kind_code_v1(TraceEventKindV1.TailExit)).to_equal(3)
        expect(trace_event_kind_code_v1(TraceEventKindV1.Transition)).to_equal(4)
        expect(trace_event_kind_code_v1(TraceEventKindV1.Loss)).to_equal(5)
        expect(trace_event_kind_code_v1(TraceEventKindV1.UnmatchedEdge)).to_equal(6)
        expect(trace_event_kind_code_v1(TraceEventKindV1.TruncatedSpan)).to_equal(7)
        expect(trace_event_kind_code_v1(TraceEventKindV1.UnsupportedSite)).to_equal(8)
        expect(trace_event_kind_code_v1(TraceEventKindV1.PairedSpan)).to_equal(9)
        expect(trace_event_kind_code_v1(TraceEventKindV1.Completion)).to_equal(10)
        expect(TRACE_OBSERVER_EVENT_BYTES_V1).to_equal(96)

    it "API-01 keeps unsupported, timeout and backend failures distinguishable":
        expect(trace_failure_code_v1(TraceFailureV1.UnsupportedTarget)).to_equal(1)
        expect(trace_failure_code_v1(TraceFailureV1.UnsupportedProfile)).to_equal(2)
        expect(trace_failure_code_v1(TraceFailureV1.UnsupportedConsistency)).to_equal(3)
        expect(trace_failure_code_v1(TraceFailureV1.InstrumentationAbsent)).to_equal(4)
        expect(trace_failure_code_v1(TraceFailureV1.InvalidMap)).to_equal(5)
        expect(trace_failure_code_v1(TraceFailureV1.Busy)).to_equal(6)
        expect(trace_failure_code_v1(TraceFailureV1.ResourceExhausted)).to_equal(7)
        expect(trace_failure_code_v1(TraceFailureV1.TimedOut)).to_equal(8)
        expect(trace_failure_code_v1(TraceFailureV1.BackendFailure)).to_equal(9)
        expect(trace_failure_code_v1(TraceFailureV1.InvalidArgument)).to_equal(10)
        expect(trace_failure_code_v1(TraceFailureV1.InvalidHandle)).to_equal(11)
