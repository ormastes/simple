# @cover src/lib/common/trace/xray_native_map_format_v1.spl
# @req REQ-XRAY-PR5-SIMPLE-XRAY-MAP
"""
# `.simple_xray_map` format v1 (XRay PR5, MAP-01 structural half)

Design A.5 map format: header {magic SXRM, u16 format=1, u16 isa,
u16 abi_profile, u16 sled_abi_version, u32 fn_count, u32 site_count,
u8[16] build_id, u64 text_base, u32 string_bytes}; function rows
{u32 local_fn_id, u32 first_site, u32 site_count, u32 name_off}; site rows
{u64 text_offset, u32 local_fn_id, u8 kind, u8 len, u8 align, u8 reserved,
u32 off_word, u32 on_word}; then the string table. Little-endian.
"""
use std.spec.*
use std.common.trace.observer_contract_v1.*
use std.common.trace.xray_native_map_format_v1.*

fn build_id() -> [u8]:
    var out: [u8] = []
    for index in 0..16: out.push((index + 1) as u8)
    out

fn sample_map() -> XrayMapV1:
    XrayMapV1(isa: XRAY_MAP_ISA_AARCH64_V1, abi_profile: XRAY_MAP_ABI_AARCH64_SIMPLE_V1,
        sled_abi_version: XRAY_MAP_SLED_ABI_V1, build_id: build_id(), text_base: 0,
        functions: [XrayMapFunctionV1(local_fn_id: 1, first_site: 1, site_count: 2, name: "f")],
        sites: [
            xray_map_aarch64_site_v1(16, 1, XRAY_MAP_KIND_ENTRY_V1),
            xray_map_aarch64_site_v1(56, 1, XRAY_MAP_KIND_EXIT_V1)
        ])

fn u32le(value: i64) -> [u8]:
    [(value & 255) as u8, ((value >> 8) & 255) as u8, ((value >> 16) & 255) as u8, ((value >> 24) & 255) as u8]

describe "XRay .simple_xray_map format v1":
    it "encodes the exact golden header, rows and string table":
        val bytes = xray_map_encode_v1(sample_map()).unwrap()
        # 48 header + 16 fn row + 2*24 site rows + "f\0" = 114
        expect(bytes.len()).to_equal(114)
        expect([bytes[0], bytes[1], bytes[2], bytes[3]]).to_equal([83u8, 88u8, 82u8, 77u8])
        expect([bytes[4], bytes[5], bytes[6], bytes[7], bytes[8], bytes[9], bytes[10], bytes[11]]).to_equal([1u8, 0u8, 2u8, 0u8, 1u8, 0u8, 1u8, 0u8])
        expect([bytes[12], bytes[16], bytes[20], bytes[35]]).to_equal([1u8, 2u8, 1u8, 16u8])
        expect([bytes[44], bytes[45]]).to_equal([2u8, 0u8])
        # function row: id 1, first site 1, count 2, name offset 0
        expect([bytes[48], bytes[52], bytes[56], bytes[60]]).to_equal([1u8, 1u8, 2u8, 0u8])
        # first site row at 64: offset 16, fn 1, kind entry, len 32, align 4
        expect([bytes[64], bytes[72], bytes[76], bytes[77], bytes[78], bytes[79]]).to_equal([16u8, 1u8, 1u8, 32u8, 4u8, 0u8])
        expect([bytes[80], bytes[81], bytes[82], bytes[83]]).to_equal(u32le(0x14000008))
        expect([bytes[84], bytes[85], bytes[86], bytes[87]]).to_equal(u32le(0xD503201F))
        expect([bytes[112], bytes[113]]).to_equal([102u8, 0u8])

    it "round-trips through the strict decoder":
        val map = xray_map_decode_v1(xray_map_encode_v1(sample_map()).unwrap()).unwrap()
        expect(map.functions[0].name).to_equal("f")
        expect(map.sites[1].text_offset).to_equal(56u64)
        expect(map.sites[1].kind).to_equal(XRAY_MAP_KIND_EXIT_V1)
        expect(map.build_id).to_equal(build_id())

    it "MAP-01 rejects corrupt, truncated and inconsistent maps (fail closed)":
        val good = xray_map_encode_v1(sample_map()).unwrap()
        var bad_magic = good
        bad_magic[0] = 0u8
        expect(xray_map_decode_v1(bad_magic)).to_equal(Err(TraceFailureV1.InvalidMap))
        var truncated: [u8] = []
        for index in 0..100: truncated.push(good[index])
        expect(xray_map_decode_v1(truncated)).to_equal(Err(TraceFailureV1.InvalidMap))
        var bad_kind = good
        bad_kind[76] = 9u8
        expect(xray_map_decode_v1(bad_kind)).to_equal(Err(TraceFailureV1.InvalidMap))
        var bad_off_word = good
        bad_off_word[80] = 0u8
        expect(xray_map_decode_v1(bad_off_word)).to_equal(Err(TraceFailureV1.InvalidMap))
        var misaligned = good
        misaligned[64] = 18u8
        expect(xray_map_decode_v1(misaligned)).to_equal(Err(TraceFailureV1.InvalidMap))
        var bad_count = good
        bad_count[16] = 3u8
        expect(xray_map_decode_v1(bad_count)).to_equal(Err(TraceFailureV1.InvalidMap))
        var bad_isa = good
        bad_isa[6] = 1u8
        expect(xray_map_decode_v1(bad_isa)).to_equal(Err(TraceFailureV1.UnsupportedTarget))

    it "rejects encoding a function row that does not cover its sites":
        val map = sample_map()
        val broken = XrayMapV1(isa: map.isa, abi_profile: map.abi_profile, sled_abi_version: map.sled_abi_version,
            build_id: map.build_id, text_base: 0,
            functions: [XrayMapFunctionV1(local_fn_id: 1, first_site: 1, site_count: 1, name: "f")],
            sites: map.sites)
        expect(xray_map_encode_v1(broken).is_err()).to_equal(true)

    it "derives the runtime .text base from a linked PREL64 text_base field":
        # field address = map + 36; runtime base = field address + signed(field)
        expect(xray_map_runtime_text_base_v1(65536, 256u64)).to_equal(65536 + 36 + 256)
        expect(xray_map_runtime_text_base_v1(65536, 0u64)).to_equal(65572)
        # negative offset: .text placed before the map (the usual layout)
        val minus_8192 = (-8192) as u64
        expect(xray_map_runtime_text_base_v1(65536, minus_8192)).to_equal(65536 + 36 - 8192)
        expect(xray_map_runtime_text_base_v1(4198400, (-4198436) as u64)).to_equal(0)
