use std.common.trace.observer_contract_v1.*
use std.common.trace.observer_config_v1.*
use std.common.trace.observer_session_v1.*

fn reference_selection_v1() -> TraceSelectionV1:
    TraceSelectionV1(manifest_incarnation: 17,
        sites: [TraceSiteV1(module_instance: 11, site_id: 3)])

fn reference_config_v1() -> TraceConfigV1:
    var config = trace_config_defaults_v1()
    config.instrumentation = TraceInstrumentationV1.Dynamic
    config.abi_profile = "serial-reference-model"
    config.buffer_bytes = 192
    config.max_contexts = 2
    config.max_resident_generations = 8
    config

fn reference_edge_v1(session: TraceSessionV1, sequence: u64) -> TraceEventV1:
    TraceEventV1(kind: TraceEventKindV1.Entry, flags: 0, generation: session.generation,
        module_instance: 11, function_id: 2, site_id: 3, context_id: 4,
        sequence: sequence, timestamp: 99, span_token: 0,
        payload0: 0, payload1: 0, payload2: 0)

describe "serial observer reference lifecycle V1":
    # One scenario intentionally owns one caller-held model through a terminal
    # fault. Quarantine has no reset escape hatch, so later capture is forbidden.
    it "retains generations, drains exact work, rejects stale handles, and quarantines faults":
        var model = TraceReferenceModelV1.create()
        val selection = reference_selection_v1()
        val config = reference_config_v1()
        val disabled = model.prepare(trace_config_defaults_v1(), selection).unwrap_err()
        expect(disabled).to_equal(TraceFailureV1.InstrumentationAbsent)
        var paired = config
        paired.consistency = TraceConsistencyV1.PairedSpans
        val unsupported = model.prepare(paired, selection).unwrap_err()
        expect(unsupported).to_equal(TraceFailureV1.UnsupportedConsistency)
        val prepared = model.prepare(config, selection).unwrap()
        val conflict = model.prepare(config, selection).unwrap_err()
        expect(conflict).to_equal(TraceFailureV1.Busy)
        val forged_prepared = TracePreparedV1(slot: 2, incarnation: prepared.incarnation)
        expect(model.start(forged_prepared).is_err()).to_equal(true)
        val session = model.start(prepared).unwrap()
        expect(model.start(prepared).is_err()).to_equal(true)
        val lease = model.begin_hook(session, 4).unwrap()
        expect(model.begin_hook(session, 4).is_err()).to_equal(true)
        expect(model.record(lease, reference_edge_v1(session, 1)).unwrap()).to_equal(true)
        val stop = model.request_stop(session).unwrap()
        expect(stop).to_equal(TraceSessionStateV1.Draining)
        expect(model.request_stop(session).unwrap()).to_equal(stop)
        expect(model.begin_hook(session, 5).is_err()).to_equal(true)
        val recursive_drain = model.drain_once(session, 4, 10, 10).unwrap_err()
        expect(recursive_drain).to_equal(TraceFailureV1.Busy)
        val waiting = model.drain_once(session, 0, 9, 10).unwrap()
        expect(waiting.state).to_equal(TraceSessionStateV1.Draining)
        val timeout = model.drain_once(session, 0, 10, 10).unwrap_err()
        expect(timeout).to_equal(TraceFailureV1.TimedOut)
        expect(model.release(session).is_err()).to_equal(true)
        # Work admitted before stop may finish, but only with its exact lease.
        expect(model.record(lease, reference_edge_v1(session, 2)).unwrap()).to_equal(true)
        expect(model.end_hook(lease).unwrap()).to_equal(true)
        expect(model.end_hook(lease).is_err()).to_equal(true)
        expect(model.record(lease, reference_edge_v1(session, 3)).is_err()).to_equal(true)
        val flush_timeout = model.flush_once(session, 0, 10, 10).unwrap_err()
        expect(flush_timeout).to_equal(TraceFailureV1.TimedOut)
        val batch = model.poll(session, 8).unwrap()
        expect(batch.events.len()).to_equal(2)
        expect(batch.events[1].sequence).to_equal(2)
        val drained = model.drain_once(session, 0, 11, 10).unwrap()
        expect(drained.state).to_equal(TraceSessionStateV1.Drained)
        expect(drained.stats.lost).to_equal(1)
        expect(model.release(session).unwrap()).to_equal(true)
        expect(model.stats(session).is_err()).to_equal(true)
        expect(model.resident_generations()).to_equal(1)

        var limited = config
        limited.max_resident_generations = 1
        val exhausted = model.prepare(limited, selection).unwrap_err()
        expect(exhausted).to_equal(TraceFailureV1.ResourceExhausted)
        val next_prepared = model.prepare(config, selection).unwrap()
        val next = model.start(next_prepared).unwrap()
        expect(next.generation).to_be_greater_than(session.generation)
        val stale = model.request_stop(session).unwrap_err()
        expect(stale).to_equal(TraceFailureV1.InvalidHandle)
        expect(model.fault(next).unwrap()).to_equal(TraceSessionStateV1.Faulted)
        val fault_stats = model.stats(next).unwrap()
        expect(fault_stats.backend_errors).to_equal(1)
        expect(model.request_stop(next).unwrap()).to_equal(TraceSessionStateV1.Faulted)
        val quarantined = model.drain_once(next, 0, 12, 20).unwrap_err()
        expect(quarantined).to_equal(TraceFailureV1.BackendFailure)
        expect(model.release(next).is_err()).to_equal(true)
        expect(model.prepare(config, selection).is_err()).to_equal(true)
        expect(model.resident_generations()).to_equal(2)

    it "keeps caller-owned models independent (no shared module state)":
        var first = TraceReferenceModelV1.create()
        var second = TraceReferenceModelV1.create()
        val prepared = first.prepare(reference_config_v1(), reference_selection_v1()).unwrap()
        expect(first.prepare(reference_config_v1(), reference_selection_v1()).unwrap_err()).to_equal(TraceFailureV1.Busy)
        expect(second.prepare(reference_config_v1(), reference_selection_v1()).is_ok()).to_equal(true)
        expect(first.resident_generations()).to_equal(1)
        expect(second.resident_generations()).to_equal(1)
        expect(prepared.incarnation).to_equal(1)

