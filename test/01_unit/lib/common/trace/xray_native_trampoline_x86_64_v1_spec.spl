# @cover src/lib/common/trace/xray_native_trampoline_x86_64_v1.spl
# @req REQ-XRAY-PR6-TRAMPOLINE
"""
# XRay PR6 — Simple twin of the x86-64 SysV resident trampoline

`__simple_xray_trampoline_v1` is asm in
src/runtime/xray/xray_native_runtime_x86_64.c (the irreplaceable register
save/restore). This twin encodes the same bytes in pure Simple. The golden
below is the clang 23 assembly of that TU (handler CALL rel32 = 0x9f); the
x86-64 XRay e2e check re-compares the twin with the freshly built object.
"""
use std.spec.*
use std.common.trace.xray_native_trampoline_x86_64_v1.*

val GOLDEN_HEX: text = ""

fn hex_of(bytes: [i64]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for byte in bytes:
        out = out + digits[(byte >> 4) & 15] + digits[byte & 15]
    out

describe "XRay native x86-64 trampoline twin":
    it "preserves RFLAGS, the SysV caller-saved GPRs, xmm0-15 and MXCSR":
        val saved = xray_native_trampoline_x86_saved_state_v1()
        for name in ["rflags", "rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11", "xmm0", "xmm15", "mxcsr"]:
            expect(saved.contains(name)).to_equal(true)
        # callee-saved by the handler per SysV; never touched here
        expect(saved.contains("rbx")).to_equal(false)
        expect(saved.contains("r12")).to_equal(false)
        expect(XRAY_NATIVE_TRAMPOLINE_X86_FRAME_BYTES_V1 % 16).to_equal(0)

    it "matches the assembled trampoline byte for byte":
        val bytes = xray_native_trampoline_bytes_x86_64_v1(0x9f)
        expect(bytes.len()).to_equal(XRAY_NATIVE_TRAMPOLINE_X86_BYTES_V1)
        expect(hex_of(bytes)).to_equal(GOLDEN_HEX)
        expect(bytes[XRAY_NATIVE_TRAMPOLINE_X86_CALL_REL32_AT_V1 - 1]).to_equal(0xE8)
        expect(bytes[0]).to_equal(0x9C)
        expect(bytes[bytes.len() - 2]).to_equal(0x9D)

    it "encodes a backward handler displacement and rejects one that does not fit rel32":
        val back = xray_native_trampoline_bytes_x86_64_v1(-1)
        expect(back[XRAY_NATIVE_TRAMPOLINE_X86_CALL_REL32_AT_V1]).to_equal(0xFF)
        expect(back[XRAY_NATIVE_TRAMPOLINE_X86_CALL_REL32_AT_V1 + 3]).to_equal(0xFF)
        expect(xray_native_trampoline_bytes_x86_64_v1(2147483648).len()).to_equal(0)
