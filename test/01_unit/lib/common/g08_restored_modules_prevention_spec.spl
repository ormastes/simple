# Purpose and audience: prevention guard for modules that specs reached release before the lib did.
# @req REQ-SSPEC-LIB

"""Importing these four modules fails the whole spec if any of them is removed
or renamed again, and each gets one fail-closed behavior probe."""

use std.spec.*
use lib.common.crypto.x25519_mlkem768.protocol_profile.{
    x25519_mlkem768_tls13_protocol_profile, x25519_mlkem768_validate_protocol_profile}
use std.common.llm.knowledge_selector.*
use std.common.processing.db_filter_u32_ir.*
use lib.common.spipe_knowledge.identity.*

describe "g08 restored common modules":
    it "should keep the TLS profile validating against itself":
        step("validate the pinned TLS 1.3 profile")
        val result = x25519_mlkem768_validate_protocol_profile(x25519_mlkem768_tls13_protocol_profile())
        expect(result.is_ok()).to_equal(true)

    it "should reject an empty source path list in the knowledge selector":
        step("select with no source paths")
        val selected = select_implementation_knowledge("1", "any", [], [], [])
        expect(selected.valid).to_equal(false)

    it "should fail closed on an inverted DB filter range":
        step("validate min greater than max")
        val ir = processing_ir_db_filter_u32([1u32, 2u32], 5u32, 1u32)
        expect(processing_db_filter_u32_validate(ir).reason).to_equal("db-filter-range-invalid")
        expect(processing_db_filter_u32_cpu_mask(ir).len()).to_equal(0)

    it "should reject a non-ASCII workspace id":
        step("parse a non-ASCII workspace id")
        expect(parse_workspace_id_v1("WS-\u00e9").is_err()).to_equal(true)
