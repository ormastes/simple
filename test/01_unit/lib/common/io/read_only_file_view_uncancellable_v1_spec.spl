"""B5 C2 descriptor-bound uncancellable buffered read; authored tests, UNRUN."""
use std.spec.*
use std.spec.step
use std.async.cancellation.{token_new}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.common.io.file_read_policy.{FileReadPolicyV1, FileViewTransportV1}
use std.common.io.file_view_buffered.{BufferedFileViewErrorV1, file_view_buffered_read_v1,
    file_view_identity_equal_v1, file_view_descriptor_identity_v1}
use std.common.io.read_only_file_view.{ReadOnlyFileViewV1, ReadOnlyFileViewErrorV1, FileViewSliceV1,
    read_only_file_view_open_v1, read_only_file_view_close_v1, read_only_file_view_read_now_v1,
    read_only_file_view_read_buffered_uncancellable_v1}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write, file_rename,
    file_read_regular_no_follow_bounded, file_write_text_at}

struct UncancellableViewFixtureV1:
    root: text
    live: text
    aside: text
    replacement: text
    original: text
    alternate: text
    digest: text

fn write_uncancellable_view_fixture_v1(name: text, original: text = "AAAA\n", alternate: text = "BBBB\n") -> UncancellableViewFixtureV1:
    val root = secure_temp_dir("/tmp", "simple-b5-c2-" + name + "-").unwrap()
    val live = root + "/live.spl"
    val replacement = root + "/replacement.spl"
    expect(file_write(live, original)).to_be(true)
    expect(file_write(replacement, alternate)).to_be(true)
    UncancellableViewFixtureV1(root: root, live: live, aside: root + "/pinned-a.spl",
        replacement: replacement, original: original, alternate: alternate,
        digest: sha256_text("b5-c2-uncancellable:" + original))

fn require_uncancellable_view_failure_v1(result: Result<FileViewSliceV1, ReadOnlyFileViewErrorV1>, expected: ReadOnlyFileViewErrorV1):
    match result:
        case Ok(_): panic("expected actual descriptor read failure")
        case Err(reason): expect(reason).to_equal(expected)

describe "B5 C2 uncancellable descriptor-bound buffered file reads":
    it "reads pinned A while its pathname points to B and then restores A":
        step("Pin the original file before replacing its actual filesystem path")
        val fixture = write_uncancellable_view_fixture_v1("aba")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.buffered, 1048576u64).unwrap()
        val identity = view.identity
        val descriptor = view.descriptor
        val moved_original = file_rename(fixture.live, fixture.aside)
        var moved_alternate = false
        if moved_original:
            moved_alternate = file_rename(fixture.replacement, fixture.live)
        step("Read the pinned descriptor while the live path contains different same-length bytes")
        val visible_path = file_read_regular_no_follow_bounded(fixture.live, 1048576)
        val read = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, identity.size)
        var restored_alternate = false
        if moved_alternate:
            restored_alternate = file_rename(fixture.live, fixture.replacement)
        var restored_original = false
        if moved_original:
            restored_original = file_rename(fixture.aside, fixture.live)
        val closed = read_only_file_view_close_v1(view)
        step("Require original pinned bytes and identity after restoring the path and closing its owner")
        expect(moved_original and moved_alternate and restored_alternate and restored_original).to_be(true)
        expect(closed.is_ok()).to_be(true)
        expect(visible_path.unwrap()).to_equal(fixture.alternate)
        val slice = read.unwrap()
        expect(slice.transport).to_equal(FileViewTransportV1.buffered)
        expect(file_view_identity_equal_v1(slice.identity, identity)).to_be(true)
        expect(sha256_u8_hex(slice.bytes)).to_equal(sha256_text(fixture.original))
        expect(sha256_u8_hex(slice.bytes) == sha256_text(fixture.alternate)).to_be(false)
        expect(file_read_regular_no_follow_bounded(fixture.live, 1048576).unwrap()).to_equal(fixture.original)
        expect(file_view_descriptor_identity_v1(descriptor, fixture.digest)).to_be_nil()

    it "reads an exact offset and permits a genuine empty file":
        step("Read a bounded interior slice from the same open descriptor")
        val fixture = write_uncancellable_view_fixture_v1("offset")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.buffered, 3u64).unwrap()
        val read = read_only_file_view_read_buffered_uncancellable_v1(&view, 1u64, 3u64)
        val closed = read_only_file_view_close_v1(view)
        expect(closed.is_ok()).to_be(true)
        val slice = read.unwrap()
        expect(slice.offset).to_equal(1u64)
        expect(slice.length).to_equal(3u64)
        expect(sha256_u8_hex(slice.bytes)).to_equal(sha256_text("AAA"))
        step("An admitted empty file returns an actual empty payload")
        val empty = write_uncancellable_view_fixture_v1("empty", "", "")
        var empty_view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(empty.root, empty.live,
            empty.digest, FileReadPolicyV1.buffered, 1u64).unwrap()
        val empty_read = read_only_file_view_read_buffered_uncancellable_v1(&empty_view, 0u64, 0u64)
        val empty_closed = read_only_file_view_close_v1(empty_view)
        expect(empty_closed.is_ok()).to_be(true)
        expect(empty_read.unwrap().bytes.len()).to_equal(0)
        expect(empty_read.unwrap().identity.size).to_equal(0u64)

    it "refuses out-of-range and over-budget reads without consuming the view":
        step("Exercise real range and capacity refusals on an open bounded view")
        val fixture = write_uncancellable_view_fixture_v1("bounds")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.buffered, 4u64).unwrap()
        val descriptor = view.descriptor
        val too_long = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, 5u64)
        val past_end = read_only_file_view_read_buffered_uncancellable_v1(&view, view.identity.size, 1u64)
        val overflow = read_only_file_view_read_buffered_uncancellable_v1(&view, 18446744073709551615u64, 2u64)
        val valid = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, 4u64)
        val closed = read_only_file_view_close_v1(view)
        step("The caller closes once after errors; subsequent reads see a closed owner")
        val after_close = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, 1u64)
        require_uncancellable_view_failure_v1(too_long, ReadOnlyFileViewErrorV1.invalid_range)
        require_uncancellable_view_failure_v1(past_end, ReadOnlyFileViewErrorV1.invalid_range)
        require_uncancellable_view_failure_v1(overflow, ReadOnlyFileViewErrorV1.invalid_range)
        expect(sha256_u8_hex(valid.unwrap().bytes)).to_equal(sha256_text("AAAA"))
        expect(closed.is_ok()).to_be(true)
        require_uncancellable_view_failure_v1(after_close, ReadOnlyFileViewErrorV1.closed)
        expect(file_view_descriptor_identity_v1(descriptor, fixture.digest)).to_be_nil()
        expect(read_only_file_view_close_v1(view).is_err()).to_be(true)

    it "refuses mapping policies through the explicitly buffered-only API":
        step("Open a real mapping-capable policy and require a typed buffered-contract refusal")
        val fixture = write_uncancellable_view_fixture_v1("policy")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.prefer_map, 1048576u64).unwrap()
        val read = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, view.identity.size)
        val closed = read_only_file_view_close_v1(view)
        expect(closed.is_ok()).to_be(true)
        require_uncancellable_view_failure_v1(read, ReadOnlyFileViewErrorV1.mapping_unsupported)

    it "refuses a size change to the actual pinned inode and still permits close":
        step("Extend the same filesystem inode after opening its descriptor")
        val fixture = write_uncancellable_view_fixture_v1("size-change")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.buffered, 1048576u64).unwrap()
        val descriptor = view.descriptor
        val appended = file_write_text_at(fixture.live, fixture.original.len(), "x")
        val read = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, view.identity.size)
        val closed = read_only_file_view_close_v1(view)
        expect(appended).to_be_greater_than(-1)
        expect(closed.is_ok()).to_be(true)
        require_uncancellable_view_failure_v1(read, ReadOnlyFileViewErrorV1.identity_changed)
        expect(file_view_descriptor_identity_v1(descriptor, fixture.digest)).to_be_nil()

    it "preserves cancellation before range validation in both existing cancellable owners":
        step("Cancel an actual registered token and pass an invalid range to each original API")
        val fixture = write_uncancellable_view_fixture_v1("old-cancellable")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.buffered, 1048576u64).unwrap()
        var cancelled = token_new()
        cancelled.cancel()
        val buffer_cancelled = file_view_buffered_read_v1(view.descriptor, view.identity,
            view.identity.size, 1u64, cancelled)
        val view_cancelled = read_only_file_view_read_now_v1(&view, view.identity.size, 1u64, cancelled)
        step("An uncancelled registered token still reads the actual pinned bytes through both original APIs")
        val valid = token_new()
        val buffer_valid = file_view_buffered_read_v1(view.descriptor, view.identity,
            0u64, view.identity.size, valid)
        val view_valid = read_only_file_view_read_now_v1(&view, 0u64, view.identity.size, valid)
        val closed = read_only_file_view_close_v1(view)
        expect(closed.is_ok()).to_be(true)
        expect(cancelled.is_cancelled()).to_be(true)
        expect(valid.is_cancelled()).to_be(false)
        match buffer_cancelled:
            case Ok(_): panic("original buffered API ignored cancellation before range validation")
            case Err(reason): expect(reason).to_equal(BufferedFileViewErrorV1.cancelled)
        require_uncancellable_view_failure_v1(view_cancelled, ReadOnlyFileViewErrorV1.cancelled)
        expect(sha256_u8_hex(buffer_valid.unwrap())).to_equal(sha256_text(fixture.original))
        expect(sha256_u8_hex(view_valid.unwrap().bytes)).to_equal(sha256_text(fixture.original))

    it "creates no cancellation tokens across repeated actual descriptor reads":
        step("Bracket repeated reads with two valid registered cancellation tokens")
        val fixture = write_uncancellable_view_fixture_v1("token-registry")
        var view: ReadOnlyFileViewV1 = read_only_file_view_open_v1(fixture.root, fixture.live,
            fixture.digest, FileReadPolicyV1.buffered, 1048576u64).unwrap()
        val before = token_new()
        var all_exact = true
        var completed = 0
        while completed < 64:
            val read = read_only_file_view_read_buffered_uncancellable_v1(&view, 0u64, view.identity.size)
            match read:
                case Ok(slice):
                    if sha256_u8_hex(slice.bytes) != sha256_text(fixture.original):
                        all_exact = false
                case Err(_): all_exact = false
            completed = completed + 1
        val closed = read_only_file_view_close_v1(view)
        val after = token_new()
        step("Require exact bytes, a closed descriptor, and precisely the second explicit token allocation")
        expect(closed.is_ok()).to_be(true)
        expect(completed).to_equal(64)
        expect(all_exact).to_be(true)
        expect(before.is_cancelled()).to_be(false)
        expect(after.is_cancelled()).to_be(false)
        expect(after.token_id).to_equal(before.token_id + 1)
