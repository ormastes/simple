# Purpose and audience: executable specification evidence for the owning engineering team.
# Pins the expected semantics from doc/08_tracking/bug/slice_index_range_form_unimplemented_and_misnamed_2026-08-25.md:
# array slicing supports the colon form with literal and variable bounds and open ends, and the
# `..` range form — on both array and text receivers.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec

describe "array slice forms":

    it "colon form with literal bounds":
        # @req REQ-SSPEC-UNIT
        step("a[1:3] on an i64 array")
        val a: [i64] = [1, 2, 3, 4, 5]
        val s = a[1:3]
        expect(s.len()).to_equal(2)
        expect(s[0]).to_equal(2)
        expect(s[1]).to_equal(3)

    it "colon form with variable bounds":
        # @req REQ-SSPEC-UNIT
        step("a[i:j] with runtime i64 bounds")
        val a: [i64] = [1, 2, 3, 4, 5]
        val i = 1
        val j = 3
        val s = a[i:j]
        expect(s.len()).to_equal(2)
        expect(s[0]).to_equal(2)

    it "open end and open start":
        # @req REQ-SSPEC-UNIT
        step("a[2:] and a[:3]")
        val a: [i64] = [1, 2, 3, 4, 5]
        expect(a[2:].len()).to_equal(3)
        expect(a[2:][0]).to_equal(3)
        expect(a[:3].len()).to_equal(3)
        expect(a[:3][2]).to_equal(3)

    it "range form with literal and variable bounds":
        # @req REQ-SSPEC-UNIT
        step("a[1..3] and a[i..j]")
        val a: [i64] = [1, 2, 3, 4, 5]
        val s = a[1..3]
        expect(s.len()).to_equal(2)
        expect(s[0]).to_equal(2)
        val i = 1
        val j = 3
        val s2 = a[i..j]
        expect(s2.len()).to_equal(2)
        expect(s2[1]).to_equal(3)

describe "text slice forms":

    it "colon and range forms on text":
        # @req REQ-SSPEC-UNIT
        step("t[1:3], t[6:], t[:5], t[1..3]")
        val t = "hello world"
        expect(t[1:3]).to_equal("el")
        expect(t[6:]).to_equal("world")
        expect(t[:5]).to_equal("hello")
        expect(t[1..3]).to_equal("el")

    it "slice result is empty for an empty span":
        # @req REQ-SSPEC-UNIT
        step("a[2:2] is empty")
        val a: [i64] = [1, 2, 3]
        expect(a[2:2].len()).to_equal(0)
