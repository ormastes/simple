"""
## Purpose and audience
`std.text.escape_json` builds the request bodies llm_caret sends to an LLM
server. A tool result holding any non-ASCII character (a source file with an
em dash, an accented name) used to come out corrupted, and the local slang
server rejected the whole request as invalid JSON. This spec is for whoever
touches `src/lib/common/text.spl`.
## Operator workflow
bin/simple test test/01_unit/lib/common/text_escape_json_multibyte_spec.spl
"""
use std.text.{escape_json}
use std.common.json.parser.{json_parse_with_error}

fn quoted(s: text) -> text:
    "\"" + escape_json(s) + "\""

describe "escape_json keeps multi-byte text intact":
    it "escapes a control character that follows a multi-byte character":
        expect(escape_json("é\nz")).to_equal("é\\nz")
        expect(escape_json("a—b\t\"c\"")).to_equal("a—b\\t\\\"c\\\"")
        expect(json_parse_with_error(quoted("한글\n— end")).1).to_equal("")

    it "leaves ASCII behaviour unchanged":
        expect(escape_json("a\nb\\c")).to_equal("a\\nb\\\\c")
        expect(escape_json("plain")).to_equal("plain")

    it "still rejects nothing it should escape":
        expect(json_parse_with_error("\"" + "é\nz" + "\"").1 == "").to_equal(false)
