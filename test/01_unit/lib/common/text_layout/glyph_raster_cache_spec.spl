"""
## Purpose and audience
Purpose: Prove that glyph-raster cache (T12).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# T12 (render-perf replan, 2026-08-07): cross-instance glyph-raster cache.
#
# Lands what c1e232a9a1e deliberately withheld -- but note that commit's
# diff to font_renderer.spl contains no glyph-raster implementation to
# restore (it was instrumentation for the *shaped-run* cache only; the
# glyph-raster cache was dropped before ever being committed). This is a
# from-scratch implementation, not a revert-revert.
#
# Its predecessor was blocked by
# doc/08_tracking/bug/glyph_raster_cache_text_array_index_corrupt_zero_hit_rate_2026-08-06.md,
# titled "[text]-array element read is corrupt under native/JIT". T11
# (2026-08-07) re-investigated and found that framing FALSE: a positive-
# control probe (direct inline push/index-read) round-trips correctly on
# both engines. The real, narrower, still-open defect is interpreter-only
# (`bin/simple test`): a free function whose entire body is only
# `_arr.push(v)` can silently lose the write when called from an `it`
# block. It does not reproduce for a mutation done INLINE inside the
# function/method that owns the array -- verified separately by a
# class-method positive-control probe during this unit's implementation.
# This cache's store path (`FontRenderer.get_glyph`, font_renderer.spl)
# does the push inline in that method's own body for exactly this reason.
#
# This is a standalone spec file (not appended to font_renderer_spec.spl,
# which already times out at ~280s under `bin/simple test` on its own,
# per c1e232a9a1e's commit message) so a run here produces a real
# `Results:` verdict line.

use std.spec.{describe, it, expect}
use common.text_layout.font_renderer.{
    FontRenderer, CachedGlyph,
    glyph_raster_cache_hits, glyph_raster_cache_misses, _glyph_raster_cache_reset_for_test}

describe "glyph-raster cache (T12)":
    it "cross-instance: a fresh FontRenderer hits what an earlier instance rasterized":
        step("Verify: cross-instance: a fresh FontRenderer hits what an earlier instance rasterized")
        # @req: REQ-LIB-COMMON-001
        _glyph_raster_cache_reset_for_test()
        var first = FontRenderer.new()
        first.use_vector = false
        val rasterized = first.get_glyph(65, 16)
        expect(rasterized.width).to_be_greater_than(0)
        expect(rasterized.height).to_be_greater_than(0)
        expect(glyph_raster_cache_misses()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(glyph_raster_cache_hits()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var second = FontRenderer.new()
        second.use_vector = false
        val served = second.get_glyph(65, 16)
        expect(glyph_raster_cache_hits()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(served.width).to_equal(rasterized.width)
        expect(served.height).to_equal(rasterized.height)
        expect(served.advance).to_equal(rasterized.advance)

    it "STRESS -- many distinct (codepoint, size) keys each hit correctly on a fresh instance, not just the first one":
        step("Verify: STRESS -- many distinct (codepoint, size) keys each hit correctly on a fresh instance, not just the first one")
        _glyph_raster_cache_reset_for_test()
        val codepoints: [i32] = [65, 66, 67, 68, 69, 70, 71, 72, 73, 74]
        for codepoint in codepoints:
            var warm = FontRenderer.new()
            warm.use_vector = false
            warm.get_glyph(codepoint, 16)
        expect(glyph_raster_cache_misses()).to_equal(codepoints.len())
        expect(glyph_raster_cache_hits()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var idx = 0
        while idx < codepoints.len():
            var fresh = FontRenderer.new()
            fresh.use_vector = false
            val hits_before = glyph_raster_cache_hits()
            val glyph = fresh.get_glyph(codepoints[idx], 16)
            expect(glyph_raster_cache_hits()).to_equal(hits_before + 1)
            expect(glyph.width).to_be_greater_than(0)
            idx = idx + 1
        expect(glyph_raster_cache_hits()).to_equal(codepoints.len())

    it "different font size is NOT served from a differently-sized cached entry":
        step("Verify: different font size is NOT served from a differently-sized cached entry")
        _glyph_raster_cache_reset_for_test()
        var a = FontRenderer.new()
        a.use_vector = false
        a.get_glyph(65, 16)
        var b = FontRenderer.new()
        b.use_vector = false
        val glyph = b.get_glyph(65, 24)
        expect(glyph_raster_cache_hits()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(glyph.font_size).to_equal(24)  # oracle: 24 — named expected value from the requirement

    it "sabotage: a reset cache reports zero hits even for a previously-served key (probe discriminates)":
        step("Verify: sabotage: a reset cache reports zero hits even for a previously-served key (probe discriminates)")
        _glyph_raster_cache_reset_for_test()
        var first = FontRenderer.new()
        first.use_vector = false
        first.get_glyph(65, 16)
        var second = FontRenderer.new()
        second.use_vector = false
        second.get_glyph(65, 16)
        expect(glyph_raster_cache_hits()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        _glyph_raster_cache_reset_for_test()
        var third = FontRenderer.new()
        third.use_vector = false
        third.get_glyph(65, 16)
        expect(glyph_raster_cache_hits()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(glyph_raster_cache_misses()).to_equal(1)  # oracle: 1 — named expected value from the requirement
