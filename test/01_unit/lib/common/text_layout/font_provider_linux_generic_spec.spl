# Chrome on Linux resolves the generic families through its default font
# settings: `sans-serif` -> "Arial" -> fontconfig Liberation Sans, and
# `monospace` -> "Monospace" -> DejaVu Sans Mono. Before this spec the platform
# face lists were macOS-only, so on Linux `sans-serif` fell through to the
# bundled Noto Sans SC variable font at its wght=100 THIN master and bold fell
# back to the regular face (measured: web catalog `overview` 6.46% mismatch vs
# Chromium 131, every heading drawn thin and unbolded).

use std.spec.step
use std.spec.{describe, it, expect, pending}
use common.text_layout.font_provider.{
    browser_platform_sans_faces, browser_platform_sans_bold_faces,
    browser_platform_mono_faces, browser_platform_mono_bold_faces,
    browser_font_family_for_weight, browser_font_family_for_style}
use std.nogc_sync_mut.sffi.io.{file_exists}

val LIB_SANS = "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
val LIB_SANS_BOLD = "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"
val DJV_MONO = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
val DJV_MONO_BOLD = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"

fn _linux_fonts_present() -> bool:
    file_exists(LIB_SANS) and file_exists(LIB_SANS_BOLD) and file_exists(DJV_MONO) and file_exists(DJV_MONO_BOLD)

fn _macos_fonts_present() -> bool:
    file_exists("/System/Library/Fonts/Helvetica.ttc")

describe "Linux generic font faces match Chrome's defaults":
    it "resolves sans-serif and monospace to Chrome's Linux faces":
        step("resolves sans-serif and monospace to Chrome's Linux faces")
        if not _linux_fonts_present() or _macos_fonts_present():
            pending("BLOCKED: host has no Liberation Sans / DejaVu Sans Mono under /usr/share/fonts")
            return
        expect(browser_platform_sans_faces()[0]).to_equal(LIB_SANS)
        expect(browser_platform_mono_faces()[0]).to_equal(DJV_MONO)

    it "routes bold generic families to the real bold face, not the regular one":
        step("routes bold generic families to the real bold face, not the regular one")
        if not _linux_fonts_present() or _macos_fonts_present():
            pending("BLOCKED: host has no Liberation Sans / DejaVu Sans Mono under /usr/share/fonts")
            return
        expect(browser_platform_sans_bold_faces()[0]).to_equal(LIB_SANS_BOLD)
        expect(browser_platform_mono_bold_faces()[0]).to_equal(DJV_MONO_BOLD)
        expect(browser_font_family_for_weight("sans-serif", true)).to_equal("__simple_font_face__|" + LIB_SANS_BOLD + "|sans-serif")
        expect(browser_font_family_for_weight("sans-serif", false)).to_equal("sans-serif")

    it "routes italic generic families to the italic face of the same typeface":
        step("routes italic generic families to the italic face of the same typeface")
        val lib_italic = "/usr/share/fonts/truetype/liberation/LiberationSans-Italic.ttf"
        val lib_bold_italic = "/usr/share/fonts/truetype/liberation/LiberationSans-BoldItalic.ttf"
        val djv_oblique = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Oblique.ttf"
        if not _linux_fonts_present() or _macos_fonts_present() or not file_exists(lib_italic) or not file_exists(lib_bold_italic) or not file_exists(djv_oblique):
            pending("BLOCKED: host has no Liberation Sans Italic / DejaVu Sans Mono Oblique under /usr/share/fonts")
            return
        expect(browser_font_family_for_style("sans-serif", false, true)).to_equal("__simple_font_face__|" + lib_italic + "|sans-serif")
        expect(browser_font_family_for_style("sans-serif", true, true)).to_equal("__simple_font_face__|" + lib_bold_italic + "|sans-serif")
        expect(browser_font_family_for_style("monospace", false, true)).to_equal("__simple_font_face__|" + djv_oblique + "|monospace")
        expect(browser_font_family_for_style("sans-serif", true, false)).to_equal(browser_font_family_for_weight("sans-serif", true))
        expect(browser_font_family_for_style("serif", false, true)).to_equal("serif")
