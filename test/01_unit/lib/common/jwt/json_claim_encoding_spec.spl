use std.spec.{describe, it, assert_equal}
use std.common.jwt.encode.{json_encode_object, json_encode}

# Vacuity probe: `json_encode_object` previously called the nonexistent
# `text.from_any(value)` (no such Rust intrinsic or `.spl` function exists
# anywhere in this codebase) and iterated tuples via `.at()`, which is not a
# valid array/list method here (only `text.at`/`char_at` exist). Both defects
# made this function fail on any input — it has never worked. No existing
# JWT spec reaches this path: `jwt_sign_hs256`/`jwt_sign_hs256_bytes` take an
# already-built `payload_json: text` directly, never routing through
# `json_encode`/`json_encode_object`, and nothing else in src/ or test/ calls
# these functions. This spec is the first to exercise the path and would
# fail against the original code (either a semantic "method `at` not found
# on type `array`" error, or an unresolved-symbol error for `from_any`).
describe "JWT claim JSON encoding (json_encode_object)":
    it "quotes text values":
        val out = json_encode_object([("sub", "user123")])
        assert_equal(out, "{\"sub\":\"user123\"}")

    it "leaves integer values unquoted, including negatives":
        val out = json_encode_object([("exp", 1735689600), ("neg", -7)])
        assert_equal(out, "{\"exp\":1735689600,\"neg\":-7}")

    it "emits booleans unquoted as true/false, not digit-sniffed text":
        val out = json_encode_object([("admin", true), ("banned", false)])
        assert_equal(out, "{\"admin\":true,\"banned\":false}")

    it "handles a mixed claim set (text, int, bool together)":
        val out = json_encode_object([
            ("sub", "user123"),
            ("exp", 1735689600),
            ("admin", true),
        ])
        assert_equal(out, "{\"sub\":\"user123\",\"exp\":1735689600,\"admin\":true}")

    it "json_encode is a pass-through alias to json_encode_object":
        val tuples = [("k", "v")]
        assert_equal(json_encode(tuples), json_encode_object(tuples))
