# table_cbc key-material wipe helper.

"""
## Purpose and audience
Purpose: pin that the T-table CBC wipe helper really zeroes a schedule buffer.
Audience: crypto maintainers.
"""

# @req: REQ-CIPHER-PAGE-001 - key hygiene of the T-table CBC path.

use std.spec.*
use std.common.aes.table_cbc.{_tc_zero}

describe "table_cbc wipe":
    it "zeroes every element and reports true":
        var a: [i64] = []
        var i = 0
        while i < 60:
            a.push(0xAB + i)
            i = i + 1
        val ok = _tc_zero(a)
        var sum = 0
        var j = 0
        while j < a.len():
            sum = sum + a[j]
            j = j + 1
        expect(ok).to_equal(true)
        expect(sum).to_equal(0)
