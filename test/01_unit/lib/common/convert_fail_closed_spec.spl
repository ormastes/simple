"""
## Purpose and audience
Purpose: Prove that std.convert fail-closed parsing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Fail-CLOSED numeric parsing contract for std.convert.
#
# Guards the security-relevant invariant that motivated try_parse_int:
# a non-numeric value must be REJECTED (nil), never silently admitted as the
# integer 0. The `.to_int()` intrinsic cannot do this -- it is typed `i64?`
# but its runtime (rt_string_to_int) returns a plain int64_t, so every invalid
# input arrives as 0, indistinguishable from a legitimate "0". Admitting
# `session=notanumber` as session 0 is the concrete exploit.
#
# NOTE: presence is tested with `== nil`, never `.?`. `.?` on an i64 optional
# is a zero-test and reports false for a valid 0.
# NOTE: every value is bound to a typed local before `expect(...)` -- passing a
# spec-local helper call straight into expect() yields `<future>`.

use std.convert.{try_parse_int, is_int_text, try_parse_i32, try_parse_u16, try_parse_u32, try_parse_u64}

use std.spec.step

describe "std.convert fail-closed parsing":

    describe "try_parse_int rejects non-numeric input":
        it "rejects empty text":
            step("Verify: rejects empty text")
            # @req: REQ-LIB-COMMON-001
            val a: bool = try_parse_int("") == nil
            expect(a).to_equal(true)

        it "rejects pure garbage":
            step("Verify: rejects pure garbage")
            val a: bool = try_parse_int("abc") == nil
            val b: bool = try_parse_int("notanumber") == nil
            expect(a).to_equal(true)
            expect(b).to_equal(true)

        it "rejects trailing and leading junk":
            step("Verify: rejects trailing and leading junk")
            val a: bool = try_parse_int("12abc") == nil
            val b: bool = try_parse_int("abc12") == nil
            expect(a).to_equal(true)
            expect(b).to_equal(true)

        it "rejects hex, separators and a bare sign":
            step("Verify: rejects hex, separators and a bare sign")
            val a: bool = try_parse_int("0x1f") == nil
            val b: bool = try_parse_int("1_000") == nil
            val c: bool = try_parse_int("-") == nil
            val d: bool = try_parse_int("+") == nil
            expect(a).to_equal(true)
            expect(b).to_equal(true)
            expect(c).to_equal(true)
            expect(d).to_equal(true)

        it "rejects magnitudes beyond the portable ceiling":
            step("Verify: rejects magnitudes beyond the portable ceiling")
            val a: bool = try_parse_int("99999999999999999999999") == nil
            val b: bool = try_parse_int("1152921504606846976") == nil
            expect(a).to_equal(true)
            expect(b).to_equal(true)

    describe "try_parse_int accepts valid input with exact values":
        it "accepts zero as a real value, distinct from failure":
            step("Verify: accepts zero as a real value, distinct from failure")
            val is_rejected: bool = try_parse_int("0") == nil
            val v: i64 = try_parse_int("0") ?? -999
            expect(is_rejected).to_equal(false)
            expect(v).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "accepts plain, signed and padded decimals":
            step("Verify: accepts plain, signed and padded decimals")
            val a: i64 = try_parse_int("12") ?? -999
            val b: i64 = try_parse_int(" 12 ") ?? -999
            val c: i64 = try_parse_int("+12") ?? -999
            val d: i64 = try_parse_int("-12") ?? -999
            val e: i64 = try_parse_int("1152921504606846975") ?? -999
            expect(a).to_equal(12)  # oracle: 12 — named expected value from the requirement
            expect(b).to_equal(12)  # oracle: 12 — named expected value from the requirement
            expect(c).to_equal(12)  # oracle: 12 — named expected value from the requirement
            expect(d).to_equal(-12)  # oracle: -12 — named expected value from the requirement
            expect(e).to_equal(1152921504606846975)  # oracle: 1152921504606846975 — named expected value from the requirement

    describe "the fail-open regression this spec exists to catch":
        # DELIBERATE-RED CALIBRATION.
        # If try_parse_int ever regresses to the `.to_int()` behaviour --
        # returning 0 instead of nil for garbage -- both examples below turn
        # red: `v` becomes 0 rather than the -1 sentinel.
        it "must not admit a non-numeric session id as session 0":
            step("Verify: must not admit a non-numeric session id as session 0")
            val v: i64 = try_parse_int("notanumber") ?? -1
            val is_rejected: bool = try_parse_int("notanumber") == nil
            expect(is_rejected).to_equal(true)
            expect(v).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "must not admit an overflowing id as 0":
            step("Verify: must not admit an overflowing id as 0")
            val v: i64 = try_parse_int("99999999999999999999999") ?? -1
            expect(v).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    describe "is_int_text":
        it "accepts complete integer literals":
            step("Verify: accepts complete integer literals")
            val a: bool = is_int_text("0")
            val b: bool = is_int_text("-12")
            val c: bool = is_int_text(" 42 ")
            expect(a).to_equal(true)
            expect(b).to_equal(true)
            expect(c).to_equal(true)

        it "rejects anything else":
            step("Verify: rejects anything else")
            val a: bool = is_int_text("")
            val b: bool = is_int_text("12abc")
            val c: bool = is_int_text("0x1f")
            val d: bool = is_int_text("1_000")
            expect(a).to_equal(false)
            expect(b).to_equal(false)
            expect(c).to_equal(false)
            expect(d).to_equal(false)

    describe "range-checked siblings are fail-closed too":
        it "rejects out-of-range values":
            step("Verify: rejects out-of-range values")
            val a: bool = try_parse_i32("2147483648") == nil
            val b: bool = try_parse_u16("70000") == nil
            val c: bool = try_parse_u32("4294967296") == nil
            val d: bool = try_parse_u64("-1") == nil
            expect(a).to_equal(true)
            expect(b).to_equal(true)
            expect(c).to_equal(true)
            expect(d).to_equal(true)

        it "accepts in-range values including zero":
            step("Verify: accepts in-range values including zero")
            val a: bool = try_parse_u16("0") == nil
            val b: bool = try_parse_i32("-2147483648") == nil
            val c: i64 = try_parse_u32("4294967295") ?? -1
            expect(a).to_equal(false)
            expect(b).to_equal(false)
            expect(c).to_equal(4294967295)  # oracle: 4294967295 — named expected value from the requirement

        it "rejects non-numeric input in every sibling":
            step("Verify: rejects non-numeric input in every sibling")
            val a: bool = try_parse_i32("abc") == nil
            val b: bool = try_parse_u16("abc") == nil
            val c: bool = try_parse_u32("abc") == nil
            val d: bool = try_parse_u64("abc") == nil
            expect(a).to_equal(true)
            expect(b).to_equal(true)
            expect(c).to_equal(true)
            expect(d).to_equal(true)
