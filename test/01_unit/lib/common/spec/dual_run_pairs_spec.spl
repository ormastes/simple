# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# design: doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md (Part B) ;
# plan: doc/03_plan/os/hal/asm_to_simple_migration_plan.md (Batch D)
#
# Real C<->Simple pairs converted from the after-the-fact return compare to
# the full dual-run contract (DualRunner: typed args, shadow targets, commit
# on match, trap on mismatch, ledger row per pair). The gate
# scripts/check/check-dual-run-shadow.shs enumerates pairs from the
# `@dual_pair:` annotations below — one line per pair, format:
#   # @dual_pair: <name> mode=<mode> ref=<C symbol> cand=<Simple fn> id=<C-MIG id>
# These runners write to the DEFAULT ledger (build/dual_run/dual_run_ledger.sdn,
# or $DUAL_RUN_LEDGER), so every case here must agree — a deliberate-mismatch
# fixture belongs in rt_hal_dual_run_*_spec.spl with a temp ledger.
#
# @dual_pair: parse_i64_vs_rt_string_to_int mode=value ref=rt_string_to_int cand=std.common.text.parse_i64 id=C-MIG-0021
# @dual_pair: base64url_decode_vs_rt_base64url_decode mode=shadow-buffer ref=rt_base64url_decode cand=std.common.base_encoding.base64.base64url_decode id=C-MIG-0023
# @dual_pair: ns16550_putc_vs_log_write_byte_ns16550 mode=record-compare ref=log_write_byte_ns16550 cand=std.nogc_sync_mut.rt_hal.ns16550_ops.ns16550_putc id=C-MIG-0043
#
# HONEST LIMITATION (record-compare pair): the C reference
# `log_write_byte_ns16550` (src/runtime/startup/baremetal/runtime_log.c:75)
# writes raw volatile pointers on riscv only, so it cannot run against the
# façade in this process. Its reference trace below is DERIVED FROM SOURCE
# (poll LSR until bit 5, then write THR), not captured under QEMU or on a
# board. The QEMU record-compare soak (design B.8: >= 10 clean runs per arch)
# is out of scope here and still owed — see the plan's Phase 3 row.

use std.spec
use std.common.text.{parse_i64}
use std.common.base_encoding.base64.{base64url_decode}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes as text_to_bytes}
use std.nogc_sync_mut.rt_hal.dual_runner.*
use std.nogc_sync_mut.rt_hal.virtual_device.*
use std.nogc_sync_mut.rt_hal.ns16550_ops.{ns16550_putc}

# C/Rust oracles (test-only; never production-linked from Simple product code here).
extern fn rt_string_to_int(s: text) -> i64
extern fn rt_base64url_decode(s: text) -> text

val UART: u64 = 0x10000000

# --- pair 1: value mode, text arg -------------------------------------------
fn ref_parse(a: DualArgs) -> i64:
    rt_string_to_int(args_text(a, 0))

fn cand_parse(a: DualArgs) -> i64:
    parse_i64(args_text(a, 0))

# --- pair 2: shadow-buffer mode: decode args[0] into the target at offset 0 --
fn _write_bytes(target: [u8], src: [u8]) -> [u8]:
    var out = target
    var i = 0
    while i < src.len() and i < out.len():
        out[i] = src[i]
        i = i + 1
    out

fn ref_b64_decode(a: DualArgs, target: [u8]) -> [u8]:
    _write_bytes(target, text_to_bytes(rt_base64url_decode(args_text(a, 0))))

fn cand_b64_decode(a: DualArgs, target: [u8]) -> [u8]:
    _write_bytes(target, text_to_bytes(base64url_decode(args_text(a, 0))))

# --- pair 3: record-compare mode against the derived C reference trace ------
fn cand_putc(a: DualArgs, dev: VirtualDevice):
    ns16550_putc(dev, UART, args_i64(a, 0))

fn c_putc_trace(byte: i64, polls_until_ready: i64) -> [EffectRecord]:
    # log_write_byte_ns16550: while (((*lsr) & 0x20) == 0) {} ; *thr = byte;
    var t = ""
    var i = 0
    while i < polls_until_ready:
        t = t + "r8 0x10000005 0x00\n"
        i = i + 1
    t = t + "r8 0x10000005 0x20\nw8 0x10000000 0x{byte.to_hex()}\n"
    effect_log_from_trace_text(t)

fn zeroed(n: i64) -> [u8]:
    var b: [u8] = []
    var i = 0
    while i < n:
        b.push(0)
        i = i + 1
    b

describe "dual-run real pairs — value mode":
    it "parse_i64 vs rt_string_to_int: typed text args, committed from the reference":
        var r = DualRunner.create("parse_i64_vs_rt_string_to_int", "value", MismatchPolicy.Trap)
        val inputs = ["0", "42", "-17", "  9  ", "9223372036854775807", "-9223372036854775808", "007"]
        for s in inputs:
            val out = dual_run_i64(r, dual_args([arg_text(s)]), ref_parse, cand_parse)
            expect(out.receipt.agree).to_equal(true)
            expect(out.receipt.committed).to_equal(true)
        expect(r.cases).to_equal(inputs.len())
        expect(r.mismatches).to_equal(0)
        expect(r.flush_ledger()).to_equal(true)

describe "dual-run real pairs — shadow-buffer mode":
    it "base64url_decode vs rt_base64url_decode: both providers write shadows, one copy committed":
        var r = DualRunner.create("base64url_decode_vs_rt_base64url_decode", "shadow-buffer", MismatchPolicy.Trap)
        val inputs = ["aGVsbG8", "YQ", "YWI", "YWJj", "", "SGVsbG8sIFdvcmxkIQ", "w6HDqcOtw7PDug"]
        for s in inputs:
            var shadow = ShadowSet.from_real("decoded", zeroed(32))
            val receipt = dual_run_shadow_buffer(r, dual_args([arg_text(s)]), shadow, ref_b64_decode, cand_b64_decode)
            expect(receipt.agree).to_equal(true)
            expect(shadow.commit_count).to_equal(1)
        var shadow = ShadowSet.from_real("decoded", zeroed(32))
        dual_run_shadow_buffer(r, dual_args([arg_text("aGVsbG8")]), shadow, ref_b64_decode, cand_b64_decode)
        expect(shadow.real[0]).to_equal(104)
        expect(shadow.real[4]).to_equal(111)
        expect(shadow.real[5]).to_equal(0)
        expect(r.mismatches).to_equal(0)
        expect(r.flush_ledger()).to_equal(true)

describe "dual-run real pairs — record-compare mode":
    it "ns16550_putc vs log_write_byte_ns16550: MMIO plans agree modulo polls, replayed once":
        var r = DualRunner.create("ns16550_putc_vs_log_write_byte_ns16550", "record-compare", MismatchPolicy.Trap)
        val bytes = [0x41, 0x0A, 0x00, 0xFF, 0x7E]
        var i = 0
        while i < bytes.len():
            val ref_trace = c_putc_trace(bytes[i], i)
            val out = dual_run_record_compare_trace(r, dual_args([arg_i64(bytes[i])]), ref_trace, cand_putc, [0x00, 0x20], true, false)
            expect(out.receipt.agree).to_equal(true)
            expect(out.commit_writes).to_equal(1)
            expect(out.agreed[out.agreed.len() - 1].value).to_equal(bytes[i])
            i = i + 1
        expect(r.commit_count).to_equal(bytes.len())
        expect(r.hardware_apply_count).to_equal(0)
        expect(r.mismatches).to_equal(0)
        expect(r.flush_ledger()).to_equal(true)
