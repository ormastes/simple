# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
#
# Dual-run pairs for three lane-wise SIMD primitives in
# src/runtime/runtime_simd_dispatch.c. The Simple side
# (std.common.simd_lane_pure) is a plain scalar loop over lanes; the oracle is
# the vector instruction reached through the registered extern.
#
# The interesting case is the one a vector implementation gets wrong: lane
# independence at the i64 wrap boundary. A carry that leaks across a lane is
# the classic defect, so INT64_MAX + 1 and INT64_MIN - 1 are placed in lanes
# adjacent to quiet ones.
#
# NOT WIRED, and why: rt_simd_shuffle_u8x16 (runtime_simd_dispatch.c:2547) has
# a scalar Simple reference ready in std.common.simd_lane_pure, but it cannot
# be dual-run from the interpreter at all. The stdlib Vec16u8 declares u8
# fields, which the interpreter represents as UInt{width:8}, while the bridge
# helper require_u8_field (interpreter_extern/simd.rs:1204) accepts only
# Value::Int — so the call dies with "field u0 must be an integer, got
# UInt { value: 1, width: 8 }" before either side computes anything. That is a
# defect in the oracle, not in the twin, and it blocks every Vec16u8-taking
# extern. Filed as
# doc/08_tracking/bug/interpreter_vec16u8_extern_rejects_u8_fields_2026-09-02.md.
# Wiring it with an Int-typed adapter struct would make the harness certify a
# path no real caller uses, so it stays uncovered until the bridge is fixed.
#
# HONEST LIMITATION: under `bin/simple test` (tree-walk interpreter) the oracle
# is the interpreter scalar bridge in interpreter_extern/simd.rs, not the AVX2
# / NEON instruction. This pins the semantics across two independent
# implementations; running the same spec under a native/JIT engine reaches the
# real vector path. Same limitation the sibling shadow specs carry.
#
# @dual_pair: add_i64x4_vs_rt_simd_add_i64x4 mode=value-legacy ref=rt_simd_add_i64x4 cand=std.common.simd_lane_pure.add_i64x4_pure
# @dual_pair: sub_i64x4_vs_rt_simd_sub_i64x4 mode=value-legacy ref=rt_simd_sub_i64x4 cand=std.common.simd_lane_pure.sub_i64x4_pure

use std.spec.step

use std.spec.{describe, it, assert_true, assert_equal}
use std.common.spec.dual_run.{dual_check_bytes, dual_summarize}
use std.common.simd_lane_pure.{add_i64x4_pure, sub_i64x4_pure}
use std.nogc_sync_mut.simd.{Vec4i64}

extern fn rt_simd_add_i64x4(a: Vec4i64, b: Vec4i64) -> Vec4i64
extern fn rt_simd_sub_i64x4(a: Vec4i64, b: Vec4i64) -> Vec4i64

fn oracle_add4(a: [i64], b: [i64]) -> [i64]:
    return rt_simd_add_i64x4(Vec4i64.from_array(a), Vec4i64.from_array(b)).to_array()

fn oracle_sub4(a: [i64], b: [i64]) -> [i64]:
    return rt_simd_sub_i64x4(Vec4i64.from_array(a), Vec4i64.from_array(b)).to_array()

describe "dual_run lane-wise SIMD primitives — scalar Simple reference vs vector oracle":
    # @manual scenario evidence
    it "add_i64x4 and sub_i64x4 keep lanes independent at the i64 wrap boundary":
        # @req REQ-SSPEC-LIB
        step("add_i64x4 and sub_i64x4 keep lanes independent at the i64 wrap boundary")
        val imax = 9223372036854775807
        val imin = 0 - 9223372036854775807 - 1
        val zero = [0, 0, 0, 0]
        val ones = [1, 1, 1, 1]
        val small = [1, 0 - 2, 3, 0 - 4]
        # A wrapping lane sits next to quiet lanes: a carry leaking sideways
        # would corrupt the neighbour and show up as a divergence.
        val edge = [imax, 0, imin, 7]
        val mixed = [1, imax, 0 - 1, imin]
        val pairs_a = [zero, ones, small, edge, mixed, imax_vec(imax), zero]
        val pairs_b = [zero, ones, edge, ones, ones, ones, edge]
        var verdicts = [dual_check_bytes("add_i64x4",
            add_i64x4_pure(pairs_a[0], pairs_b[0]), oracle_add4(pairs_a[0], pairs_b[0]))]
        var i = 1
        while i < pairs_a.len():
            verdicts = verdicts.push(dual_check_bytes("add_i64x4",
                add_i64x4_pure(pairs_a[i], pairs_b[i]), oracle_add4(pairs_a[i], pairs_b[i])))
            i = i + 1
        var j = 0
        while j < pairs_a.len():
            verdicts = verdicts.push(dual_check_bytes("sub_i64x4",
                sub_i64x4_pure(pairs_a[j], pairs_b[j]), oracle_sub4(pairs_a[j], pairs_b[j])))
            j = j + 1
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 14)
        assert_equal(summary.divergent, 0)
        # Non-vacuity: the quiet neighbour lanes are genuinely untouched.
        val added = add_i64x4_pure(edge, ones)
        assert_equal(added[1], 1)
        assert_equal(added[3], 8)

    # NEGATIVE CONTROL. An unregistered extern silently returns nil, so a
    # green dual-run above could mean "both sides agree" or "the oracle was
    # never called". Feeding a deliberately wrong reference to the same
    # comparator settles it: this MUST come back divergent.
    # @manual scenario evidence
    it "a deliberately wrong lane is REPORTED divergent, proving the oracle is really called":
        # @req REQ-SSPEC-LIB
        step("a deliberately wrong lane is REPORTED divergent, proving the oracle is really called")
        val a = [10, 20, 30, 40]
        val b = [1, 2, 3, 4]
        # Correct sum is [11, 22, 33, 44]; corrupt exactly one lane, which is
        # what a carry leaking across a vector lane would look like.
        val wrong = [11, 22, 33, 45]
        var verdicts = [dual_check_bytes("add_i64x4_wrong_lane", wrong, oracle_add4(a, b))]
        verdicts = verdicts.push(dual_check_bytes("sub_i64x4_wrong_lane", wrong, oracle_sub4(a, b)))
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 2)
        assert_equal(summary.divergent, 2)
        # And the correct reference against the same oracle still agrees, so
        # the divergence above is the corruption and not a broken comparator.
        val ok = dual_summarize([dual_check_bytes("add_i64x4_control", add_i64x4_pure(a, b), oracle_add4(a, b))])
        assert_equal(ok.divergent, 0)

fn imax_vec(imax: i64) -> [i64]:
    return [imax, imax, imax, imax]
