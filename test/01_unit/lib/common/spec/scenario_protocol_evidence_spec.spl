# codex-system-test

use std.spec.*
use std.common.spec.scenario_protocol_evidence.{
    ScenarioProtocolFieldEvidence,
    scenario_protocol_field_evidence_validate,
    scenario_protocol_evidence_validate
}

fn protocol_field(
    byte_offset: i64,
    bit_offset: i64,
    bit_width: i64,
    mask: text,
    name: text
) -> ScenarioProtocolFieldEvidence:
    ScenarioProtocolFieldEvidence(
        byte_offset: byte_offset,
        byte_length: 1,
        bit_offset: bit_offset,
        bit_width: bit_width,
        mask: mask,
        endianness: "little",
        name: name,
        actual: "1",
        expected: "1",
        status: "pass",
        importance: "critical",
        note: "linked to the raw byte"
    )

describe "Scenario protocol field evidence":
    it "should accept typed non-overlapping bitfield rows":
        step("Capture")
        val fields = [
            protocol_field(0, 0, 1, "0x01", "ready"),
            protocol_field(0, 1, 3, "0x0e", "kind")
        ]
        step("Verify")
        val result = scenario_protocol_evidence_validate(fields)
        step("Render")
        expect(fields[1].name).to_equal("kind")
        step("Publish")
        expect(result).to_equal("ok")

    it "should reject a field outside its declared byte range":
        step("Capture")
        val field = protocol_field(0, 7, 2, "0x03", "overflow")
        step("Verify")
        val result = scenario_protocol_field_evidence_validate(field)
        step("Render")
        expect(field.byte_length).to_equal(1)
        step("Publish")
        expect(result).to_equal("invalid_bit_width")

    it "should reject overlapping rows":
        step("Capture")
        val fields = [
            protocol_field(4, 0, 4, "0x0f", "opcode"),
            protocol_field(4, 2, 4, "0x3c", "flags")
        ]
        step("Verify")
        val result = scenario_protocol_evidence_validate(fields)
        step("Render")
        expect(fields[0].byte_offset).to_equal(4)
        step("Publish")
        expect(result).to_equal("overlapping_fields")

    it "should reject a passing row whose values differ":
        step("Capture")
        val base = protocol_field(8, 0, 8, "0xff", "status")
        val field = ScenarioProtocolFieldEvidence(
            byte_offset: base.byte_offset,
            byte_length: base.byte_length,
            bit_offset: base.bit_offset,
            bit_width: base.bit_width,
            mask: base.mask,
            endianness: base.endianness,
            name: base.name,
            actual: "2",
            expected: "1",
            status: "pass",
            importance: base.importance,
            note: base.note
        )
        step("Verify")
        val result = scenario_protocol_field_evidence_validate(field)
        step("Render")
        expect(field.actual).to_equal("2")
        step("Publish")
        expect(result).to_equal("passing_value_mismatch")
