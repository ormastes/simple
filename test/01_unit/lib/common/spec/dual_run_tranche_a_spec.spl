# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
#
# Tranche A of doc/08_tracking/data/rt_dual_implementation_paydown_plan.md:
# the five twins the migration inventory NAMED but which had never been
# written. The inventory's `replacement:` field mixes landed migrations with
# planned ones, so these five looked covered and were not. They are written
# now, in pure Simple, and dual-run against their C/Rust oracles here.
#
# Every oracle below is registered in the interpreter's EXTERN_DISPATCH
# (src/compiler_rust/compiler/src/interpreter_extern/mod.rs), verified before
# these pairs were annotated — an unregistered extern silently returns nil and
# would make this harness certify a lie.
#
# HONEST LIMITATION (same as the sibling shadow spec): this dual-runs both
# sides only inside test specs, not on live traffic.
#
# @dual_pair: str_ends_with_vs_rt_string_ends_with mode=value-legacy ref=rt_string_ends_with cand=std.common.str_search_pure.str_ends_with
# @dual_pair: str_last_index_of_vs_rt_string_rfind mode=value-legacy ref=rt_string_rfind cand=std.common.str_search_pure.str_last_index_of
# @dual_pair: char_from_code_vs_rt_char_from_code mode=value-legacy ref=rt_char_from_code cand=std.common.char_from_code_pure.char_from_code
# @dual_pair: is_nan_f64_vs_rt_math_is_nan mode=value-legacy ref=rt_math_is_nan cand=std.common.float_class_pure.is_nan_f64
# @dual_pair: is_inf_f64_vs_rt_math_is_inf mode=value-legacy ref=rt_math_is_inf cand=std.common.float_class_pure.is_inf_f64

use std.spec.step

use std.spec.{describe, it, assert_true, assert_equal}
use std.common.spec.dual_run.{dual_check_bool, dual_check_i64, dual_check_text, dual_summarize}
use std.common.str_search_pure.{str_ends_with, str_last_index_of}
use std.common.char_from_code_pure.{char_from_code}
use std.common.float_class_pure.{is_nan_f64, is_inf_f64}

# C/Rust oracles (test-only).
extern fn rt_string_ends_with(s: text, suffix: text) -> bool
extern fn rt_string_rfind(s: text, needle: text) -> i64
extern fn rt_char_from_code(code: i64) -> text
extern fn rt_math_is_nan(x: f64) -> bool
extern fn rt_math_is_inf(x: f64) -> bool

describe "dual_run tranche A — five twins written for the rt_* dual directive":
    # @manual scenario evidence
    it "str_ends_with vs rt_string_ends_with agrees, including multi-byte suffixes":
        # @req REQ-SSPEC-LIB
        step("str_ends_with vs rt_string_ends_with agrees, including multi-byte suffixes")
        # Both lanes compare BYTES. The non-ASCII rows are load-bearing: a
        # character-indexing twin passes the ASCII rows and fails these.
        val subjects = ["hello.md", "hello.md", "hello.md", "", "", "abc", "naïve", "naïve", "日本語", "日本語", "日本語", "aa"]
        val suffixes = [".md", ".mdx", "", "", "x", "abcd", "ïve", "ve", "語", "本語", "日", "aaa"]
        var verdicts = [dual_check_bool(
            "str_ends_with",
            str_ends_with(subjects[0], suffixes[0]),
            rt_string_ends_with(subjects[0], suffixes[0]))]
        var i = 1
        while i < subjects.len():
            verdicts = verdicts.push(dual_check_bool(
                "str_ends_with",
                str_ends_with(subjects[i], suffixes[i]),
                rt_string_ends_with(subjects[i], suffixes[i])))
            i = i + 1
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 12)
        assert_equal(summary.divergent, 0)

    it "str_last_index_of vs rt_string_rfind agrees on byte indices and the empty-needle contract":
        # @req REQ-SSPEC-LIB
        step("str_last_index_of vs rt_string_rfind agrees on byte indices and the empty-needle contract")
        # The empty-needle row answers the subject's BYTE LENGTH, not 0 — that
        # is the C runtime's contract, mirrored by the Rust lane.
        val subjects = ["abcabc", "abcabc", "abcabc", "abcabc", "", "", "a", "日本語日本語", "日本語", "naïve"]
        val needles = ["abc", "a", "z", "", "", "x", "aa", "日本", "語", "ï"]
        var verdicts = [dual_check_i64(
            "str_last_index_of",
            str_last_index_of(subjects[0], needles[0]),
            rt_string_rfind(subjects[0], needles[0]))]
        var i = 1
        while i < subjects.len():
            verdicts = verdicts.push(dual_check_i64(
                "str_last_index_of",
                str_last_index_of(subjects[i], needles[i]),
                rt_string_rfind(subjects[i], needles[i])))
            i = i + 1
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 10)
        assert_equal(summary.divergent, 0)

    it "char_from_code vs rt_char_from_code agrees across all four UTF-8 widths and the rejects":
        # @req REQ-SSPEC-LIB
        step("char_from_code vs rt_char_from_code agrees across all four UTF-8 widths and the rejects")
        # 0x41 1-byte, 0xE9 2-byte, 0x65E5 3-byte, 0x1F600 4-byte; then the
        # three rejection classes the oracle answers "" for: negative,
        # above U+10FFFF, and the UTF-16 surrogate range.
        val codes = [0, 0x41, 0x7F, 0x80, 0xE9, 0x7FF, 0x800, 0x65E5, 0xFFFF, 0x10000, 0x1F600, 0x10FFFF, 0 - 1, 0x110000, 0xD800, 0xDFFF]
        var verdicts = [dual_check_text(
            "char_from_code",
            char_from_code(codes[0]),
            rt_char_from_code(codes[0]))]
        var i = 1
        while i < codes.len():
            verdicts = verdicts.push(dual_check_text(
                "char_from_code",
                char_from_code(codes[i]),
                rt_char_from_code(codes[i])))
            i = i + 1
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 16)
        assert_equal(summary.divergent, 0)

    it "is_nan_f64 and is_inf_f64 vs rt_math_is_nan / rt_math_is_inf agree on the IEEE classes":
        # @req REQ-SSPEC-LIB
        step("is_nan_f64 and is_inf_f64 vs rt_math_is_nan / rt_math_is_inf agree on the IEEE classes")
        # Infinities are built by overflowing multiplication, not 1.0/0.0:
        # the tree-walk interpreter raises on division by zero.
        val big = 1.0e308
        val pos_inf = big * 10.0
        val neg_inf = 0.0 - pos_inf
        val nan_x = pos_inf - pos_inf
        val xs = [0.0, -0.0, 1.0, 0.0 - 1.0, big, 0.0 - big, pos_inf, neg_inf, nan_x]
        var verdicts = [dual_check_bool("is_nan_f64", is_nan_f64(xs[0]), rt_math_is_nan(xs[0]))]
        verdicts = verdicts.push(dual_check_bool("is_inf_f64", is_inf_f64(xs[0]), rt_math_is_inf(xs[0])))
        var i = 1
        while i < xs.len():
            val x = xs[i]
            verdicts = verdicts.push(dual_check_bool("is_nan_f64", is_nan_f64(x), rt_math_is_nan(x)))
            verdicts = verdicts.push(dual_check_bool("is_inf_f64", is_inf_f64(x), rt_math_is_inf(x)))
            i = i + 1
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 18)
        assert_equal(summary.divergent, 0)
        # Non-vacuity: the input set must actually contain each class, or the
        # 18 agreements above would be 18 agreements on "false".
        assert_true(is_nan_f64(nan_x))
        assert_true(is_inf_f64(pos_inf))
        assert_true(is_inf_f64(neg_inf))
        assert_true(not is_inf_f64(nan_x))
        assert_true(not is_nan_f64(pos_inf))
