# Unit specs for typed UI target references + spec metadata extraction.
# Contract: doc/04_architecture/ui/testing/typed_ui_interface_arch.md §SSpec targets
use std.spec.{describe, it, expect}
use std.common.spec.ui_target.{
    parse_ui_target,
    extract_ui_app,
    extract_ui_target_surface,
    is_valid_ui_surface,
    UI_TARGET_SYMBOL,
    UI_TARGET_QUALIFIED,
    UI_TARGET_PATTERN,
    UI_TARGET_FOCUSED,
    UI_TARGET_RUNTIME,
    UI_TARGET_NAME
}

describe "parse_ui_target precedence":
    it "parses a bare id as a compiled symbol":
        val t = parse_ui_target("formula_input")
        expect(t.kind).to_equal(UI_TARGET_SYMBOL)
        expect(t.value).to_equal("formula_input")

    it "parses a dotted id as qualified":
        val t = parse_ui_target("toolbar.save")
        expect(t.kind).to_equal(UI_TARGET_QUALIFIED)
        expect(t.value).to_equal("toolbar.save")

    it "parses a braced id as a typed pattern":
        val t = parse_ui_target("cell_" + "{" + "CellRef}")
        expect(t.kind).to_equal(UI_TARGET_PATTERN)

    it "parses an empty target as focused":
        expect(parse_ui_target("").kind).to_equal(UI_TARGET_FOCUSED)

    it "parses id(expr) as an explicit runtime escape":
        val t = parse_ui_target("id(runtime_expr)")
        expect(t.kind).to_equal(UI_TARGET_RUNTIME)
        expect(t.value).to_equal("runtime_expr")

    it "parses a quoted string as accessible-name fallback":
        val t = parse_ui_target("\"Save document\"")
        expect(t.kind).to_equal(UI_TARGET_NAME)
        expect(t.value).to_equal("Save document")

describe "spec source metadata extraction":
    val source = "# demo spec\n# @ui: calc\n# @ui-target: tui\ndescribe \"x\":\n"

    it "extracts the @ui app id":
        expect(extract_ui_app(source)).to_equal("calc")

    it "extracts the @ui-target surface":
        expect(extract_ui_target_surface(source)).to_equal("tui")

    it "defaults the surface to both when the marker is absent":
        expect(extract_ui_target_surface("# no markers here\n")).to_equal("both")

    it "returns empty app id when @ui marker is absent":
        expect(extract_ui_app("# nothing\n")).to_equal("")

    it "validates surfaces":
        assert_true(is_valid_ui_surface("both"))
        assert_false(is_valid_ui_surface("native"))
