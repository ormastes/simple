# Prevention: the scenario-evidence / ui_target spec-support modules must stay
# resolvable from std.* (round 16 g02: specs had landed without their modules).
use std.spec.{describe, it, expect}
use std.common.spec.ui_target_resolver.{edit_distance}
use std.common.spec.scenario_motion_evidence.{ScenarioArtifactIntegrity}
use std.common.spec.scenario_protocol_evidence.{ScenarioProtocolFieldEvidence}
use std.common.spec.scenario_evidence.{ScenarioCaptureKind, scenario_capture_kind_name}
use std.common.ui.id_suggest.{ui_id_edit_distance}
use std.spec.scenario_evidence_manifest_io.{scenario_evidence_manifest_path_for_spec}

describe "scenario spec-support module resolution":
    it "edit distance agrees between resolver and shared id_suggest":
        expect(edit_distance("save_btn", "save_bnt")).to_equal(ui_id_edit_distance("save_btn", "save_bnt"))
        expect(edit_distance("abc", "abc")).to_equal(0)
    it "maps a spec path to its evidence manifest path":
        expect(scenario_evidence_manifest_path_for_spec("test/01_unit/a/b_spec.spl")).to_equal("build/test-artifacts/01_unit/a/b/evidence.sdn")

describe "capture kind names":
    it "names the motion kind":
        expect(scenario_capture_kind_name(ScenarioCaptureKind.motion)).to_equal("motion")
