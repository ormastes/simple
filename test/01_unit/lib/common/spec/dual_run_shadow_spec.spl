# @req: REQ-LIB-SPEC-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/common/spec/dual_run_shadow_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/dual_run_shadow.md
# doc-path: doc/03_plan/sys_test/dual_run_shadow.md
# doc-path: doc/04_architecture/dual_run_shadow.md
# doc-path: doc/05_design/dual_run_shadow.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "sha256 known-answer vectors":
        step("Verify: sha256 known-answer vectors")
        # @req: REQ-LIB-SPEC-001
        use std.common.crypto.sha256.{sha256_text}
        expect(sha256_text("abc")).to_equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")  # oracle: FIPS 180-2 vector for "abc"
        expect(sha256_text("")).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")  # oracle: empty-input vector

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-LIB-SPEC-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-LIB-SPEC-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-LIB-SPEC-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-LIB-SPEC-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

    it "array sorting and mapping":
        step("Verify: array sorting and mapping")
        # @req: REQ-LIB-SPEC-001
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
        expect([1, 2, 3].map(fn(x: i64): x * 2)).to_equal([2, 4, 6])
