# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @req REQ-SSPEC-LIB
#
# Goal 6 of the binary_runtime_hardening plan: "a framework that runs BOTH
# the C and Simple implementations at runtime to check robustness" — Wave 4's
# shadow mode. This spec exercises src/lib/common/spec/dual_run.spl's
# dual_check_f64/dual_check_text helper across 13 already-migrated,
# already-verified symbol-pairs from
# doc/08_tracking/c_migration/c_migration_inventory.sdn (C-MIG-0031, 0032,
# 0026, 0028, 0019 x6 [from_components/add_days/diff_days/get_year/
# get_month/get_day], 0020 [rt_hash_text only — the sibling rt_str_hash is
# not registered in the interpreter's extern dispatch table, deferred],
# 0021, 0022). Pairs deliberately chosen OUTSIDE the contested/in-flux areas
# under concurrent edit: path_pure.spl, text_ascii.spl, text_builder.spl,
# math/special.spl, math/cbrt.spl, numeric_round.spl (beyond the two
# pre-existing floor/ceil tests below), base_encoding/** (beyond
# utilities.spl's UTF-8 validator, which is NOT in that concurrent-edit
# list), gzip/**, string_core.spl are all avoided. See
# doc/07_guide/infra/c_migration/dual_run_shadow.md for the full wired +
# deferred pair list and "how to add a pair".
#
# HONEST LIMITATION: this dual-runs both sides only inside test specs. It is
# NOT a production shadow that dual-runs on live traffic — see
# doc/07_guide/infra/c_migration/dual_run_shadow.md.
#
# Pair registry for scripts/check/check-dual-run-shadow.shs (enumerated from
# these annotations, never hard-coded). mode=value-legacy: after-the-fact
# return compare via dual_check_*; the DualRunner contract lives in
# dual_run_pairs_spec.spl.
# @dual_pair: floor_f64_vs_rt_math_floor mode=value-legacy ref=rt_math_floor cand=std.common.numeric_round.floor_f64 id=C-MIG-0031
# @dual_pair: ceil_f64_vs_rt_math_ceil mode=value-legacy ref=rt_math_ceil cand=std.common.numeric_round.ceil_f64 id=C-MIG-0032
# @dual_pair: i64_to_text_vs_rt_raw_i64_to_string mode=value-legacy ref=rt_raw_i64_to_string cand=std.common.convert.i64_to_text id=C-MIG-0026
# @dual_pair: byte_char_vs_rt_byte_char mode=value-legacy ref=rt_byte_char cand=std.common.encoding.byte_char.byte_char id=C-MIG-0028
# @dual_pair: timestamp_from_components_vs_rt mode=value-legacy ref=rt_timestamp_from_components cand=std.common.time_utils.timestamp_from_components id=C-MIG-0019
# @dual_pair: timestamp_add_days_vs_rt mode=value-legacy ref=rt_timestamp_add_days cand=std.common.time_utils.timestamp_add_days id=C-MIG-0019
# @dual_pair: timestamp_diff_days_vs_rt mode=value-legacy ref=rt_timestamp_diff_days cand=std.common.time_utils.timestamp_diff_days id=C-MIG-0019
# @dual_pair: timestamp_get_year_vs_rt mode=value-legacy ref=rt_timestamp_get_year cand=std.common.time_utils.timestamp_get_year id=C-MIG-0019
# @dual_pair: timestamp_get_month_vs_rt mode=value-legacy ref=rt_timestamp_get_month cand=std.common.time_utils.timestamp_get_month id=C-MIG-0019
# @dual_pair: timestamp_get_day_vs_rt mode=value-legacy ref=rt_timestamp_get_day cand=std.common.time_utils.timestamp_get_day id=C-MIG-0019
# @dual_pair: hash_text_vs_rt_hash_text mode=value-legacy ref=rt_hash_text cand=std.hash.rt_hash_text id=C-MIG-0020
# @dual_pair: parse_i64_vs_rt_string_to_int_legacy mode=value-legacy ref=rt_string_to_int cand=std.common.text.parse_i64 id=C-MIG-0021
# @dual_pair: utf8_validate_vs_rt_text_validate_utf8 mode=value-legacy ref=rt_text_validate_utf8 cand=std.common.base_encoding.utilities.validated_utf8_bytes_to_text_linear id=C-MIG-0022

use std.spec.step

use std.spec.{describe, it, assert_true, assert_equal}
use std.common.spec.dual_run.{dual_check_f64, dual_check_text}
use std.common.numeric_round.{floor_f64, ceil_f64}
use std.common.convert.{i64_to_text}
use std.common.encoding.byte_char.{byte_char}
use std.common.time_utils.{timestamp_from_components, timestamp_add_days,
    timestamp_diff_days, timestamp_get_year, timestamp_get_month, timestamp_get_day}
use std.hash.{rt_hash_text as simple_hash_text}
use std.common.text.{parse_i64}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear, base_encoding_text_to_bytes as text_to_bytes}

# C/Rust oracles (test-only; never production-linked from Simple product code here).
extern fn rt_math_floor(x: f64) -> f64
extern fn rt_math_ceil(x: f64) -> f64
extern fn rt_raw_i64_to_string(n: i64) -> text
extern fn rt_byte_char(v: i64) -> text
extern fn rt_timestamp_from_components(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, microsecond: i32) -> i64
extern fn rt_timestamp_add_days(micros: i64, days: i64) -> i64
extern fn rt_timestamp_diff_days(micros1: i64, micros2: i64) -> i64
extern fn rt_timestamp_get_year(micros: i64) -> i32
extern fn rt_timestamp_get_month(micros: i64) -> i32
extern fn rt_timestamp_get_day(micros: i64) -> i32
extern fn rt_hash_text(s: text) -> i64
extern fn rt_string_to_int(s: text) -> i64
extern fn rt_text_validate_utf8(s: text) -> bool

fn simple_is_valid_utf8(s: text) -> bool:
    match validated_utf8_bytes_to_text_linear(text_to_bytes(s)):
        Ok(_decoded):
            true
        Err(_error):
            false

fn bool_text(b: bool) -> text:
    if b: "true" else: "false"

describe "dual_run shadow harness — C oracle vs Simple, 4 migrated pairs":
    # @manual scenario evidence
    it "floor_f64 vs rt_math_floor agrees on representative + edge inputs":
        # @req REQ-SSPEC-LIB
        step("floor_f64 vs rt_math_floor agrees on representative + edge inputs")
        # bit_exact: false here (plain `==`) -- matches the convention of
        # the existing floor_f64 crosslang spec's assert_equal. Sign-of-zero
        # on -0.0 differs between bin/simple test's tree-walk interpreter
        # and bin/simple run's JIT for this pair (a real, already-known
        # run-vs-test engine divergence class per .claude/rules/testing.md,
        # not a floor_f64 defect); bit_exact:true would flag it, which is
        # exactly what the sanity checks below demonstrate on purpose.
        val xs = [3.0, 3.7, -3.1, 0.0, -0.0, 1.0e20, 0.0 - 1.0e20]
        var i = 0
        var checked = 0
        while i < xs.len():
            val x = xs[i]
            val v = dual_check_f64("floor_f64", floor_f64(x), rt_math_floor(x), false)
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        # NaN case: both-NaN must count as agreement, not divergence.
        val big = 1.0e308
        val pos_inf = big * 10.0
        val nan_x = pos_inf - pos_inf
        val nan_v = dual_check_f64("floor_f64_nan", floor_f64(nan_x), rt_math_floor(nan_x), false)
        assert_true(nan_v.agree)
        assert_equal(checked, 7)

    it "ceil_f64 vs rt_math_ceil agrees on representative + edge inputs":
        # @req REQ-SSPEC-LIB
        step("ceil_f64 vs rt_math_ceil agrees on representative + edge inputs")
        val xs = [3.0, 3.2, -3.1, 0.0, -0.5, 1.0e20, 0.0 - 1.0e20]
        var i = 0
        var checked = 0
        while i < xs.len():
            val x = xs[i]
            val v = dual_check_f64("ceil_f64", ceil_f64(x), rt_math_ceil(x), false)
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 7)

    it "i64_to_text vs rt_raw_i64_to_string agrees on boundary + typical values":
        # @req REQ-SSPEC-LIB
        step("i64_to_text vs rt_raw_i64_to_string agrees on boundary + typical values")
        val ns = [0, 1, -1, 42, -42, 9223372036854775807, -9223372036854775808]
        var i = 0
        var checked = 0
        while i < ns.len():
            val n = ns[i]
            val v = dual_check_text("i64_to_text", i64_to_text(n), rt_raw_i64_to_string(n))
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 7)

    it "byte_char vs rt_byte_char agrees across the full 0..255 byte range":
        # @req REQ-SSPEC-LIB
        step("byte_char vs rt_byte_char agrees across the full 0..255 byte range")
        var b = 0
        var checked = 0
        var divergent = 0
        while b < 256:
            val v = dual_check_text("byte_char", byte_char(b), rt_byte_char(b))
            if not v.agree:
                divergent = divergent + 1
            checked = checked + 1
            b = b + 1
        assert_equal(divergent, 0)
        assert_equal(checked, 256)

    it "dual_check_f64 detects a deliberately divergent pair (sanity: the helper is not vacuous)":
        # @req REQ-SSPEC-LIB
        step("dual_check_f64 detects a deliberately divergent pair (sanity: the helper is not vacuous)")
        val v = dual_check_f64("deliberately_wrong", 1.0, 2.0, false)
        assert_true(not v.agree)

    it "dual_check_text detects a deliberately divergent pair (sanity: the helper is not vacuous)":
        # @req REQ-SSPEC-LIB
        step("dual_check_text detects a deliberately divergent pair (sanity: the helper is not vacuous)")
        val v = dual_check_text("deliberately_wrong_text", "a", "b")
        assert_true(not v.agree)

    it "dual_check_f64 bit_exact:true distinguishes -0.0 from 0.0, unlike plain ==":
        # @req REQ-SSPEC-LIB
        step("dual_check_f64 bit_exact:true distinguishes -0.0 from 0.0, unlike plain ==")
        val loose = dual_check_f64("zero_loose", 0.0, -0.0, false)
        assert_true(loose.agree)
        val strict = dual_check_f64("zero_strict", 0.0, -0.0, true)
        assert_true(not strict.agree)

    it "dual_check_f64 treats both-NaN as agreement (NaN-safe), not a divergence":
        # @req REQ-SSPEC-LIB
        step("dual_check_f64 treats both-NaN as agreement (NaN-safe), not a divergence")
        val big = 1.0e308
        val pos_inf = big * 10.0
        val nan_a = pos_inf - pos_inf
        val nan_b = pos_inf - pos_inf
        val v = dual_check_f64("nan_pair", nan_a, nan_b, false)
        assert_true(v.agree)

    it "timestamp_from_components vs rt_timestamp_from_components agrees on epoch/leap/century/pre-epoch vectors":
        # @req REQ-SSPEC-LIB
        step("timestamp_from_components vs rt_timestamp_from_components agrees on epoch/leap/century/pre-epoch vectors")
        # year, month, day, hour, minute, second, microsecond
        val vectors = [
            (1970, 1, 1, 0, 0, 0, 0),
            (2000, 2, 29, 0, 0, 0, 0),        # 400-year leap day
            (1900, 2, 28, 23, 59, 59, 999999), # century non-leap boundary
            (2038, 1, 19, 3, 14, 8, 0),        # 32-bit rollover
            (1969, 12, 31, 23, 59, 59, 0),     # pre-epoch
            (2024, 12, 31, 23, 59, 59, 500000),
        ]
        var i = 0
        var checked = 0
        while i < vectors.len():
            val (y, mo, d, h, mi, se, us) = vectors[i]
            val simple = timestamp_from_components(y, mo, d, h, mi, se, us)
            val oracle = rt_timestamp_from_components(y as i32, mo as i32, d as i32, h as i32, mi as i32, se as i32, us as i32)
            val v = dual_check_text("timestamp_from_components", "{simple}", "{oracle}")
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 6)

    it "timestamp_add_days vs rt_timestamp_add_days agrees on positive/negative/zero offsets":
        # @req REQ-SSPEC-LIB
        step("timestamp_add_days vs rt_timestamp_add_days agrees on positive/negative/zero offsets")
        val base = timestamp_from_components(2024, 6, 15, 12, 0, 0, 0)
        val offsets = [0, 1, -1, 30, -365, 146097]  # 146097 days = 400 years
        var i = 0
        var checked = 0
        while i < offsets.len():
            val simple = timestamp_add_days(base, offsets[i])
            val oracle = rt_timestamp_add_days(base, offsets[i])
            val v = dual_check_text("timestamp_add_days", "{simple}", "{oracle}")
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 6)

    it "timestamp_diff_days vs rt_timestamp_diff_days agrees, incl. negative diffs":
        # @req REQ-SSPEC-LIB
        step("timestamp_diff_days vs rt_timestamp_diff_days agrees, incl. negative diffs")
        val a = timestamp_from_components(2024, 6, 15, 0, 0, 0, 0)
        val b = timestamp_from_components(2024, 1, 1, 0, 0, 0, 0)
        val c = timestamp_from_components(1969, 12, 1, 0, 0, 0, 0)
        val pairs = [(a, b), (b, a), (a, a), (a, c), (c, a)]
        var i = 0
        var checked = 0
        while i < pairs.len():
            val (m1, m2) = pairs[i]
            val simple = timestamp_diff_days(m1, m2)
            val oracle = rt_timestamp_diff_days(m1, m2)
            val v = dual_check_text("timestamp_diff_days", "{simple}", "{oracle}")
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 5)

    it "timestamp_get_year/month/day vs rt_timestamp_get_year/month/day agree on boundary timestamps":
        # @req REQ-SSPEC-LIB
        step("timestamp_get_year/month/day vs rt_timestamp_get_year/month/day agree on boundary timestamps")
        val micros_list = [
            timestamp_from_components(1970, 1, 1, 0, 0, 0, 0),
            timestamp_from_components(2000, 2, 29, 0, 0, 0, 0),
            timestamp_from_components(1900, 2, 28, 0, 0, 0, 0),
            timestamp_from_components(2038, 1, 19, 3, 14, 8, 0),
            timestamp_from_components(1969, 12, 31, 23, 59, 59, 0),
        ]
        var i = 0
        var checked = 0
        while i < micros_list.len():
            val m = micros_list[i]
            val y_v = dual_check_text("timestamp_get_year", "{timestamp_get_year(m)}", "{rt_timestamp_get_year(m)}")
            val mo_v = dual_check_text("timestamp_get_month", "{timestamp_get_month(m)}", "{rt_timestamp_get_month(m)}")
            val d_v = dual_check_text("timestamp_get_day", "{timestamp_get_day(m)}", "{rt_timestamp_get_day(m)}")
            assert_true(y_v.agree)
            assert_true(mo_v.agree)
            assert_true(d_v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 5)

    it "rt_hash_text (Simple FNV-1a bridge) vs C oracle rt_hash_text agrees incl. UTF-8":
        # @req REQ-SSPEC-LIB
        step("rt_hash_text (Simple FNV-1a bridge) vs C oracle rt_hash_text agrees incl. UTF-8")
        val vectors = ["", "a", "abc", "hello world", "héllo", "日本語", "emoji 🎉 test", "Ω≈ç√∫"]
        var i = 0
        var checked = 0
        while i < vectors.len():
            val simple = simple_hash_text(vectors[i])
            val oracle = rt_hash_text(vectors[i])
            val v = dual_check_text("rt_hash_text", "{simple}", "{oracle}")
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 8)

    it "parse_i64 vs rt_string_to_int agrees on well-formed decimal integers (sentinel divergence documented, not asserted)":
        # @req REQ-SSPEC-LIB
        step("parse_i64 vs rt_string_to_int agrees on well-formed decimal integers (sentinel divergence documented, not asserted)")
        # NOTE: on malformed/empty input the two sides use DIFFERENT sentinels
        # (parse_i64 -1 vs rt_string_to_int 0 per C-MIG-0021's caller_note) —
        # this pair intentionally restricts to well-formed input, matching
        # test/01_unit/lib/nogc_sync_mut/parse_i64_crosslang_spec.spl's convention.
        val vectors = ["0", "1", "-1", "42", "-42", "9223372036854775807", "-9223372036854775808"]
        var i = 0
        var checked = 0
        while i < vectors.len():
            val simple = parse_i64(vectors[i])
            val oracle = rt_string_to_int(vectors[i])
            val v = dual_check_text("parse_i64", "{simple}", "{oracle}")
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 7)

    it "validated_utf8_bytes_to_text_linear vs rt_text_validate_utf8 agrees on valid/invalid UTF-8, incl. multibyte":
        # @req REQ-SSPEC-LIB
        step("validated_utf8_bytes_to_text_linear vs rt_text_validate_utf8 agrees on valid/invalid UTF-8, incl. multibyte")
        val vectors = ["", "a", "hello world", "héllo", "日本語ABCabc", "emoji 🎉 TEST", "Ω≈ç√∫ mixedCase", "Café", "naïve", "東京", "👍👎🎉"]
        var i = 0
        var checked = 0
        while i < vectors.len():
            val simple = bool_text(simple_is_valid_utf8(vectors[i]))
            val oracle = bool_text(rt_text_validate_utf8(vectors[i]))
            val v = dual_check_text("utf8_validate", simple, oracle)
            assert_true(v.agree)
            checked = checked + 1
            i = i + 1
        assert_equal(checked, 11)

# ---------------------------------------------------------------------------
# Tranche 2 (2026-09-01) — 7 further pairs, selected mechanically rather than
# by intuition. The selection rule was:
#
#   coverable = (rt_* registered in the interpreter's extern dispatch table)
#             ∩ (a Simple twin that ACTUALLY EXISTS in src/lib)
#             − (pairs already covered above)
#
# The dispatch-table term is load-bearing: rt_str_hash was deferred from
# tranche 1 for exactly this reason, and a pair chosen by traffic alone can
# turn out not to be callable from a spec at all.
#
# The "twin actually exists" term is the one that shrank this tranche. The C
# migration inventory's `replacement:` field mixes LANDED migrations with
# PLANNED ones, and grepping src/lib for each named function found five that
# do not exist yet: str_ends_with, str_last_index_of, char_from_code,
# is_nan_f64, is_inf_f64. Those five are deliberately LEFT UNCOVERED. Writing
# a placeholder twin for them would make this harness certify agreement
# between the runtime and a function invented to agree with it, which is
# worse than no coverage — so they are recorded in the paydown plan instead.
#
# Each case below builds a list of DualVerdict and asserts on dual_summarize,
# rather than hand-rolling a while/assert block per pair.
#
# @dual_pair: to_upper_ascii_vs_rt_text_to_upper_ascii mode=value-legacy ref=rt_text_to_upper_ascii cand=std.common.text_ascii.to_upper_ascii
# @dual_pair: is_ascii_text_vs_rt_text_is_ascii mode=value-legacy ref=rt_text_is_ascii cand=std.common.ascii_pure.is_ascii_text
# @dual_pair: sqrt_f64_vs_rt_math_sqrt mode=value-legacy ref=rt_math_sqrt cand=std.math.special.sqrt_f64
# @dual_pair: cbrt_f64_vs_rt_math_cbrt mode=value-legacy ref=rt_math_cbrt cand=std.math.cbrt.cbrt_f64
# @dual_pair: path_basename_vs_rt_path_basename mode=value-legacy ref=rt_path_basename cand=std.common.path_pure.path_basename
# @dual_pair: path_dirname_vs_rt_path_dirname mode=value-legacy ref=rt_path_dirname cand=std.common.path_pure.path_dirname
# @dual_pair: path_ext_vs_rt_path_ext mode=value-legacy ref=rt_path_ext cand=std.common.path_pure.path_ext

use std.common.spec.dual_run.{dual_check_bool, dual_summarize}
use std.common.text_ascii.{to_upper_ascii}
use std.common.ascii_pure.{is_ascii_text}
use std.math.special.{sqrt_f64}
use std.math.cbrt.{cbrt_f64}
use std.common.path_pure.{path_basename, path_dirname, path_ext}

extern fn rt_text_to_upper_ascii(s: text) -> text
extern fn rt_text_is_ascii(s: text) -> bool
extern fn rt_math_sqrt(x: f64) -> f64
extern fn rt_math_cbrt(x: f64) -> f64
extern fn rt_path_basename(p: text) -> text
extern fn rt_path_dirname(p: text) -> text
extern fn rt_path_ext(p: text) -> text

describe "dual_run shadow harness — tranche 2, 7 further C/Rust-vs-Simple pairs":
    # @manual scenario evidence
    it "to_upper_ascii vs rt_text_to_upper_ascii agrees, incl. non-ASCII left untouched":
        # @req REQ-SSPEC-LIB
        step("to_upper_ascii vs rt_text_to_upper_ascii agrees, incl. non-ASCII left untouched")
        # Non-ASCII vectors matter: "ASCII uppercase" must leave every
        # multi-byte codepoint byte-for-byte alone. A twin that naively
        # subtracted 32 from every high byte would pass on pure ASCII and
        # corrupt these, so they are the discriminating cases, not decoration.
        val xs = ["", "a", "abc", "ABC", "aBc123", "hello world", "héllo", "日本語abc", "_-+=~", "zZ"]
        var vs: [DualVerdict] = []
        var i = 0
        while i < xs.len():
            vs.push(dual_check_text("to_upper_ascii", to_upper_ascii(xs[i]), rt_text_to_upper_ascii(xs[i])))
            i = i + 1
        val summary = dual_summarize(vs)
        assert_equal(summary.divergent, 0)
        assert_equal(summary.total, 10)

    it "is_ascii_text vs rt_text_is_ascii agrees on the ASCII/non-ASCII boundary":
        # @req REQ-SSPEC-LIB
        step("is_ascii_text vs rt_text_is_ascii agrees on the ASCII/non-ASCII boundary")
        val xs = ["", "a", "hello world", "\t\n", "héllo", "日本語", "mixed é ascii", "~", "👍"]
        var vs: [DualVerdict] = []
        var i = 0
        while i < xs.len():
            vs.push(dual_check_bool("is_ascii_text", is_ascii_text(xs[i]), rt_text_is_ascii(xs[i])))
            i = i + 1
        val summary = dual_summarize(vs)
        assert_equal(summary.divergent, 0)
        assert_equal(summary.total, 9)

    it "sqrt_f64 vs rt_math_sqrt: exact on exact squares, 3 documented ULP divergences elsewhere":
        # @req REQ-SSPEC-LIB
        step("sqrt_f64 vs rt_math_sqrt: exact on exact squares, 3 documented ULP divergences elsewhere")
        # REAL DIVERGENCE FOUND BY THIS HARNESS — recorded, not papered over.
        # IEEE-754 REQUIRES sqrt to be correctly rounded, so the two sides must
        # agree to the last bit. They do not. Measured on this seed:
        #   sqrt(2.0)    simple 1.414213562373095   oracle 1.4142135623730951
        #   sqrt(1.0e-10) simple 0.000009999999999999999 oracle 0.00001
        #   sqrt(2.5)    simple 1.5811388300841895  oracle 1.5811388300841898
        # rt_math_sqrt is correctly rounded; std.math.special.sqrt_f64 (a
        # Newton-Raphson refinement) is not, so the SIMPLE side is the defective
        # one. Filed as doc/08_tracking/bug/sqrt_f64_not_correctly_rounded_2026-09-01.md.
        #
        # Rather than relax this pair to a tolerance — which would hide exactly
        # the drift this harness exists to catch — the divergence is asserted as
        # a SENTINEL, following the precedent set by the parse_i64 pair above.
        # Two consequences, both deliberate: agreement is still enforced on the
        # exactly-representable inputs, and if sqrt_f64 is ever fixed the
        # sentinel count goes to 0 and THIS TEST TURNS RED, forcing the spec to
        # be updated rather than silently rotting into a permanent excuse.
        val exact = [0.0, -0.0, 1.0, 4.0, 9.0, 0.25, 1.0e10]
        var vs: [DualVerdict] = []
        var i = 0
        while i < exact.len():
            vs.push(dual_check_f64("sqrt_f64", sqrt_f64(exact[i]), rt_math_sqrt(exact[i]), true))
            i = i + 1
        val summary = dual_summarize(vs)
        assert_equal(summary.divergent, 0)
        assert_equal(summary.total, 7)

        val known_divergent = [2.0, 1.0e-10, 2.5]
        var sentinels: [DualVerdict] = []
        var j = 0
        while j < known_divergent.len():
            sentinels.push(dual_check_f64("sqrt_f64_sentinel", sqrt_f64(known_divergent[j]),
                rt_math_sqrt(known_divergent[j]), true))
            j = j + 1
        assert_equal(dual_summarize(sentinels).divergent, 3)

    it "cbrt_f64 vs rt_math_cbrt agrees on positive, negative and zero inputs":
        # @req REQ-SSPEC-LIB
        step("cbrt_f64 vs rt_math_cbrt agrees on positive, negative and zero inputs")
        # Negatives are the discriminating cases: cbrt is defined for them
        # (unlike sqrt), and an implementation routing through pow(x, 1/3)
        # returns NaN there. bit_exact: false because cbrt is not required to
        # be correctly rounded, so a last-bit difference would be a legitimate
        # implementation choice rather than the divergence class of interest.
        val xs = [0.0, 1.0, 8.0, 27.0, -1.0, -8.0, -27.0, 0.125, 1.0e9]
        var vs: [DualVerdict] = []
        var i = 0
        while i < xs.len():
            vs.push(dual_check_f64("cbrt_f64", cbrt_f64(xs[i]), rt_math_cbrt(xs[i]), false))
            i = i + 1
        val summary = dual_summarize(vs)
        assert_equal(summary.divergent, 0)
        assert_equal(summary.total, 9)

    it "path_basename/path_dirname/path_ext agree with their rt_path_* oracles":
        # @req REQ-SSPEC-LIB
        step("path_basename/path_dirname/path_ext agree with their rt_path_* oracles")
        # Three pairs share one case list on purpose: path splitting is where
        # the three functions must stay mutually consistent, and the awkward
        # inputs are the same for all three — a trailing slash, a bare
        # basename with no directory, a dotfile (leading dot is NOT an
        # extension), a name with several dots, and root.
        val xs = ["/a/b/c.txt", "c.txt", "/a/b/", "/", "a/b/.hidden", "x.tar.gz", "", "relative/path", "/no_ext"]
        var base: [DualVerdict] = []
        var dir: [DualVerdict] = []
        var ext: [DualVerdict] = []
        var i = 0
        while i < xs.len():
            base.push(dual_check_text("path_basename", path_basename(xs[i]), rt_path_basename(xs[i])))
            dir.push(dual_check_text("path_dirname", path_dirname(xs[i]), rt_path_dirname(xs[i])))
            ext.push(dual_check_text("path_ext", path_ext(xs[i]), rt_path_ext(xs[i])))
            i = i + 1
        assert_equal(dual_summarize(base).divergent, 0)
        assert_equal(dual_summarize(dir).divergent, 0)
        assert_equal(dual_summarize(ext).divergent, 0)
        assert_equal(dual_summarize(base).total, 9)
