# Byte-identical regeneration gate for typed-evidence manuals.
#
# @manual_section Manual regeneration stability
# @req REQ-SSPEC-EVD-001
"""
# Byte-identical regeneration gate for typed-evidence manuals

## Purpose and audience

For the SPipe docgen pipeline and its reviewers: this spec proves that
regenerating a manual from unchanged typed evidence yields a byte-identical
digest, and that any change to the evidence (run id, environment, verdict)
moves the digest. Audience: maintainers who rely on regeneration stability to
detect drift between checked-in manuals and current specs.
"""

use std.spec.*
use std.common.spec.evidence.model.{
    ManualBlock, EvidenceAudience, EvidenceManifest, EvidenceStatus,
    evidence_manifest,
    CanonicalEvidence, OracleSpec,
    canonical_evidence, evidence_node,
    oracle_spec, check_exact
}
use std.common.spec.evidence.regeneration_gate.{
    render_manual_digest, assert_regeneration_stable, manifest_regeneration_report
}
use std.common.spec.evidence.evidence_comparator.{
    compare_evidence, comparison_to_manual_blocks
}

fn sample_manifest(run_id: text, environment: text) -> EvidenceManifest:
    evidence_manifest(
        "evd-regen-001",
        "simple-list/1",
        "test/01_unit/lib/common/spec/evidence/regeneration_gate_spec.spl",
        "1111111111111111111111111111111111111111111111111111111111111111",
        "provider.list",
        "1.0.0",
        run_id,
        environment,
        "2222222222222222222222222222222222222222222222222222222222222222",
        EvidenceStatus.passed
    )

fn sample_evidence() -> CanonicalEvidence:
    canonical_evidence(
        "protocol_text",
        "simple-list/1",
        [evidence_node("response.status", "200")]
    )

fn sample_spec() -> OracleSpec:
    oracle_spec("simple-list/1", [check_exact("response.status", "200")])

describe "Regeneration digest stability":
    """
    A reader trusts that a generated manual is the SAME manual every time it
    is regenerated from the same evidence and spec. This is only a real
    guarantee if two independent renders hash identically, not merely if
    they look alike on a screen.
    """

    it "produces identical digests for two renders of identical inputs":
        # @req: REQ-SSPEC-EVD-001
        step("Render the same evidence/spec/manifest through the gate")
        val manifest = sample_manifest("run-42", "ci-linux")
        val outcome = assert_regeneration_stable(
            sample_evidence(), sample_spec(), "List response manual", EvidenceAudience.qa, manifest
        )

        step("Verify the gate reports stable with no diff text")
        expect(outcome.0).to_equal(true)
        expect(outcome.1).to_equal("")

    it "stays stable across manifests that differ only in run_id and environment":
        step("Build two manifests for the same evidence that differ only in run_id/environment")
        val manifest_a = sample_manifest("run-1", "ci-linux")
        val manifest_b = sample_manifest("run-2", "ci-macos")

        step("Verify assert_regeneration_stable still reports stable for each manifest independently")
        val outcome_a = assert_regeneration_stable(sample_evidence(), sample_spec(), "List response manual", EvidenceAudience.qa, manifest_a)
        val outcome_b = assert_regeneration_stable(sample_evidence(), sample_spec(), "List response manual", EvidenceAudience.qa, manifest_b)
        expect(outcome_a.0).to_equal(true)
        expect(outcome_b.0).to_equal(true)

        step("Verify manifest_regeneration_report classifies run_id/environment drift as OK-EXPECTED, not stale")
        val report = manifest_regeneration_report(sample_evidence(), sample_spec(), "List response manual", EvidenceAudience.qa, manifest_a, manifest_b)
        val report_text = joined(report)
        expect(report_text).to_contain("OK-EXPECTED: run_id differs")
        expect(report_text).to_contain("OK-EXPECTED: environment differs")
        expect(report_text).to_not_contain("STALE-SOURCE")

    it "flags a spec_sha256 mismatch between manifests as STALE-SOURCE":
        step("Build two manifests where spec_sha256 differs, as if the source spec changed between runs")
        val manifest_a = sample_manifest("run-1", "ci-linux")
        var manifest_b = sample_manifest("run-2", "ci-linux")
        manifest_b.spec_sha256 = "3333333333333333333333333333333333333333333333333333333333333333"

        step("Verify manifest_regeneration_report flags the drift as STALE-SOURCE")
        val report = manifest_regeneration_report(sample_evidence(), sample_spec(), "List response manual", EvidenceAudience.qa, manifest_a, manifest_b)
        val report_text = joined(report)
        expect(report_text).to_contain("STALE-SOURCE: spec_sha256 differs")

    it "produces a different digest when the rendered block order is disturbed":
        step("Compare evidence and build the manual blocks the normal way")
        val manifest = sample_manifest("run-42", "ci-linux")
        val result = compare_evidence(sample_evidence(), sample_spec())
        val blocks = comparison_to_manual_blocks("List response manual", result)
        val original_digest = render_manual_digest("List response manual", blocks, EvidenceAudience.qa, manifest)

        step("Build a manually reordered copy of the same blocks")
        val reordered = reorder(blocks)
        val reordered_digest = render_manual_digest("List response manual", reordered, EvidenceAudience.qa, manifest)

        step("Verify the digests differ, proving the gate would catch nondeterministic block ordering")
        expect(original_digest).to_not_equal(reordered_digest)

fn joined(lines: [text]) -> text:
    var out = ""
    var i = 0
    while i < lines.len():
        if i > 0:
            out = out + "\n"
        out = out + lines[i]
        i = i + 1
    out

fn reorder(blocks: [ManualBlock]) -> [ManualBlock]:
    var out: [ManualBlock] = []
    var i = blocks.len() - 1
    while i >= 0:
        out.push(blocks[i])
        i = i - 1
    out
