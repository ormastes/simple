"""
## Purpose and audience

This spec proves `stacked_md_table` emits genuine Markdown pipe-table
syntax with correct word ordering, hex bytes, and binary grouping, so a
generated manual can carry the stacked word figure as a real table. It is
read by spec-rendering maintainers and anyone routing stacked word
evidence into a Markdown manual.

`stacked_md_table` is the additive sibling of `stacked_rows`: same stacked
word values, but emitted as genuine Markdown pipe-table syntax
(`| col | col |` with a header separator row) instead of plain reference
lines, so a generated manual can carry the stacked word figure as a real
table when a caller chooses to route it that way. It does not replace or
change `stacked_rows`.

Design: doc/05_design/infra/sspec/binary_reference_stacked_design.md
"""

use std.spec.*
use std.common.spec.evidence.format.binary_layout.{stacked_md_table}

describe "stacked_md_table":
    it "emits a real Markdown pipe table for a 2-word layout":
        step("Render two stacked words as a Markdown table")
        val rows = stacked_md_table([0x1234, 0xABCD], "CDW", 10)

        step("Verify the header row uses pipe-table syntax")
        expect(rows[0]).to_equal("| Word | Value (hex) | Binary |")

        step("Verify the header separator row is present (required for valid Markdown)")
        expect(rows[1]).to_equal("| --- | --- | --- |")

        step("Verify each data row is a real pipe-delimited row, not a plain line")
        expect(rows.len()).to_equal(4)
        expect(rows[2].starts_with("| CDW10 | 0x")).to_equal(true)
        expect(rows[2].contains("|")).to_equal(true)
        expect(rows[3].starts_with("| CDW11 | 0x")).to_equal(true)

    it "orders words by first_word offset and encodes the correct hex value":
        step("Render a single word starting at index 0")
        val rows = stacked_md_table([255], "W", 0)

        step("Verify the value cell carries the correct little-endian hex bytes")
        expect(rows[2]).to_equal("| W0 | 0xff 00 00 00 00 00 00 00 | 0b00000000_00000000_00000000_00000000_00000000_00000000_00000000_11111111 |")
