"""
# Live process-execution capture (typed-evidence lane)

## Purpose and audience

Every existing typed-evidence adapter — text_protocol, json_document,
terminal_grid, binary_layout, and the rest — is intentionally pure: it turns
an already-constructed transcript, string, or byte buffer into
`CanonicalEvidence`. None of them ever touch a running process. This is the
FIRST genuinely live-capture provider in the typed-evidence system: it
actually launches a real process through the repo's process-execution
facade (`std.nogc_sync_mut.sffi.system.process_run`), records what that
process really did, and only then builds evidence from the recording. A
reader should come away convinced the exit code, stdout text, and pass/fail
verdict below come from a real `sh -c` invocation on this machine during this
test run, not from a fixture string typed into the spec. Audience: QA authors
adding live captures and reviewers auditing that recorded evidence is real.
"""

use std.spec.*

use std.common.spec.evidence.model.{check_exact, check_full_pattern, oracle_spec_open}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}
use std.common.spec.evidence.format.exec_capture.{
    ExecCapture, capture_exec, exec_to_evidence, EXEC_LAUNCH_FAILURE_EXIT_CODE
}

describe "Exec/CLI live capture format adapter":
    # @manual: show
    # @capture(text)
    it "records the real exit code of a process that really exits 0":
        step("Run the portable shell builtin `true`, which always exits 0")
        val capture = capture_exec("true", [])

        step("Verify the recorded exit code is the process's real exit code, not a hardcoded 0")
        expect(capture.exit_code).to_equal(0)
        expect(capture.launch_ok).to_equal(true)

    it "records the real nonzero exit code of a process that really exits nonzero":
        step("Run the portable shell builtin `false`, which always exits 1")
        val capture = capture_exec("false", [])

        step("Verify the recorded exit code reflects the real nonzero exit, not a normalized 0")
        expect(capture.exit_code == 0).to_equal(false)

    it "records the real stdout text a process actually printed":
        step("Run `echo` with a deterministic, spec-specific probe string")
        val capture = capture_exec("echo", ["hello_exec_capture_probe"])

        step("Verify captured stdout contains the exact text the process printed")
        expect(capture.stdout.contains("hello_exec_capture_probe")).to_equal(true)

    it "captures a nonexistent command as a real failure, never a silent success":
        step("Run a command name that cannot possibly exist on PATH")
        val capture = capture_exec("this_command_does_not_exist_xyz123", [])

        step("Verify the failure is recorded as a nonzero exit code or an explicit launch error")
        val recorded_as_failure = (capture.exit_code != 0) or (not capture.launch_ok)
        expect(recorded_as_failure).to_equal(true)
        expect(capture.exit_code == 0 and capture.launch_ok).to_equal(false)

    it "builds typed evidence from a live capture and verifies it end to end against a closed oracle":
        step("Run `echo` with a deterministic probe string, for real, right now")
        val capture = capture_exec("echo", ["hello_exec_capture_probe"])
        expect(capture.exit_code).to_equal(0)

        step("Convert the live capture into canonical evidence")
        val evidence = exec_to_evidence(capture, "exec-probe/1")
        expect(evidence.parse_ok).to_equal(true)

        step("Verify the live-captured evidence against a closed oracle built from the real outcome")
        val spec = oracle_spec_open(
            "exec-probe/1",
            [
                check_exact("exec-probe/1.command", "echo"),
                check_exact("exec-probe/1.exit_code", "0"),
                check_exact("exec-probe/1.stdout.lines", "hello_exec_capture_probe")
            ]
        )
        val result = compare_evidence(evidence, spec)
        expect(result.summary).to_equal("3 check(s) passed")

    it "discriminates a real captured exit code from a wrong expectation":
        step("Run `false`, which really exits 1")
        val capture = capture_exec("false", [])

        step("Convert the live capture into canonical evidence")
        val evidence = exec_to_evidence(capture, "exec-probe/2")

        step("Verify an oracle expecting the real captured exit code (1) passes")
        val correct_spec = oracle_spec_open("exec-probe/2", [check_exact("exec-probe/2.exit_code", "1")])
        val correct_result = compare_evidence(evidence, correct_spec)
        expect(correct_result.summary).to_equal("1 check(s) passed")
