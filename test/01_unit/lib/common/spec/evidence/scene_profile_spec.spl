    it "reports a finding for an asset with zero byte_length":
        step("Build a scene with an asset declaring zero bytes")
        val scene = Scene3D(
            scene_id: "sc4",
            assets: [SceneAsset(asset_id: "mesh1", kind: "mesh", uri: "m.bin", byte_length: 0, accessor_count: 1)],
            objects: [],
            camera_id: "cam1",
            light_ids: []
        )
        step("Validate the scene's assets")
        val findings = validate_scene_assets(scene)
        step("Verify the zero byte_length finding is reported")
        var found = false
        for finding in findings:
            if finding.contains("zero byte_length"):
                found = true
        expect(found).to_equal(true)

    it "reports a finding for an asset with zero accessor_count":
        step("Build a scene with an asset declaring zero accessors")
        val scene = Scene3D(
            scene_id: "sc5",
            assets: [SceneAsset(asset_id: "mesh1", kind: "mesh", uri: "m.bin", byte_length: 10, accessor_count: 0)],
            objects: [],
            camera_id: "cam1",
            light_ids: []
        )
        step("Validate the scene's assets")
        val findings = validate_scene_assets(scene)
        step("Verify the zero accessor_count finding is reported")
