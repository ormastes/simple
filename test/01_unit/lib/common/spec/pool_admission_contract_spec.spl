# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
#
# Contract spec for src/lib/common/pool_admission_pure.spl — the pure-Simple
# port of the DETERMINISTIC admission/sentinel layer of the pool ABI
# (src/runtime/runtime_pool.c, src/runtime/runtime_thread.c).
#
# ---------------------------------------------------------------------------
# WHY THIS IS **NOT** A `@dual_pair` SPEC — read before adding one.
# ---------------------------------------------------------------------------
# It carries NO `# @dual_pair:` annotation, deliberately. `check-dual-run-shadow.shs`
# enumerates pairs FROM those annotations and then trusts the spec's `Results:`
# line. An annotation naming `ref=rt_pool_state_create_v1` on a spec that never
# actually reaches that C symbol would report a green pair to the gate while
# comparing nothing — certifying a lie. That is exactly the hazard the
# tranche-A spec header warns about, one level up.
#
# MEASURED 2026-09-02, on the deployed seed `bin/simple.exe`:
# under `bin/simple test` (the tree-walk interpreter, and the ONLY engine the
# dual-run gate ever invokes) NO extern in this ABI reaches the C runtime.
# Every one dispatches to a Rust reimplementation or an explicit stub in
# src/compiler_rust/compiler/src/interpreter_extern/:
#
#   rt_pool_state_*_v1, rt_pool_task_*_v1  -> concurrency::rt_pool_state_v1_unavailable
#       which RAISES "PoolStateV1 requires the native runtime". Observed: all
#       five oracle-backed examples of the first draft of this spec failed with
#       exactly that message. It is a deliberate refusal, not a defect — the
#       stub's own comment reads "Interpreter mode must not pretend that
#       bounded admission or OS-thread execution occurred."
#   rt_pool_submit -> constant 0;  rt_pool_is_done -> constant 1;
#   rt_pool_join   -> constant 0;  rt_pool_get_parallelism -> constant 1.
#       Fabricated interpreter answers, not runtime_pool.c.
#   rt_ptr_read_*/rt_ptr_write_* are REAL Rust implementations, but they need a
#       valid raw address, and `malloc` is not an interpreter extern
#       ("semantic: unknown extern function: malloc" — measured), so no buffer
#       can be obtained to compare against.
#
# Consequently a twin of runtime_pool.c CANNOT be dual-run against
# runtime_pool.c under this harness. The assertions below therefore pin the
# twin against the C SOURCE literally (constants and control-flow order quoted
# from the C in comments), which is the strongest honest evidence available
# on this engine.
#
# DUPLICATE-DEFINITION NOTE (verified 2026-09-02, load-bearing): the
# `rt_pool_state_*_v1` family is defined TWICE — in runtime_pool.c and in
# runtime_thread.c — and only runtime_thread.c is linked into the core-C
# capsule (scripts/check/build-core-c-bootstrap-runtime-capsule.shs lists
# runtime_thread.c and runtime_memory.c, NOT runtime_pool.c). Pinning the
# dead copy's semantics would be worthless, so both copies were diffed:
#   capacity bound   pool.c RT_POOL_STATE_MAX_CAPACITY 65534
#                    thread.c RT_POOL_V1_MAX_CAPACITY  65534   (same value,
#                    different macro name; same `< 1 || > MAX` predicate)
#   counter sentinel both -1  (thread.c via static rt_pool_state_counter_v1)
#   close/destroy    both 0
#   task status      both -1
#   submit ladder    both -3 bad handle / -2 closed||destroying / -1 full / 0
# The two are contract-identical, so every assertion below holds for whichever
# copy links. This spec cites runtime_pool.c line numbers for readability.
#
# PLATFORM NOTE: authored and executed on Windows. Every constant and ladder
# asserted here sits ABOVE the `#ifdef RT_POOL_PTHREAD` in the C, so it is
# shared by the POSIX and Windows branches alike and nothing POSIX-specific is
# claimed. POSIX was NOT executed here.

use std.spec.step

use std.spec.{describe, it, assert_true, assert_equal}
use std.common.pool_admission_pure.{
    pool_state_max_capacity,
    pool_state_capacity_admits,
    pool_state_query_invalid,
    pool_state_lifecycle_invalid,
    pool_task_status_invalid,
    pool_submit_reject_code,
    pool_handle_encode,
    pool_handle_slot,
    pool_handle_generation,
    pool_handle_is_structurally_valid}

describe "pool admission contract — pure-Simple port of the deterministic pool ABI layer":
    # @manual scenario evidence
    it "pool_state_capacity_admits matches the C admission boundary exactly":
        # @req REQ-SSPEC-LIB
        step("pool_state_capacity_admits matches the C admission boundary exactly")
        # C (runtime_pool.c rt_pool_state_create_v1):
        #   if (capacity < 1 || capacity > RT_POOL_STATE_MAX_CAPACITY) return 0;
        # with RT_POOL_STATE_MAX_CAPACITY 65534 (runtime_pool.c:95).
        # 0 and 65535 are the two values a `capacity > 0` / `<= 65536` twin
        # would get wrong, so they are the load-bearing rows.
        assert_equal(pool_state_max_capacity(), 65534)
        assert_true(pool_state_capacity_admits(1))
        assert_true(pool_state_capacity_admits(2))
        assert_true(pool_state_capacity_admits(65533))
        assert_true(pool_state_capacity_admits(65534))
        assert_true(not pool_state_capacity_admits(65535))
        assert_true(not pool_state_capacity_admits(65536))
        assert_true(not pool_state_capacity_admits(1000000))
        assert_true(not pool_state_capacity_admits(0))
        assert_true(not pool_state_capacity_admits(-1))
        assert_true(not pool_state_capacity_admits(-65534))

    # @manual scenario evidence
    it "the invalid-handle sentinels are distinct per family, as the C defines them":
        # @req REQ-SSPEC-LIB
        step("the invalid-handle sentinels are distinct per family, as the C defines them")
        # The counter queries early-out -1; the lifecycle calls early-out 0.
        # They are DIFFERENT values, which is precisely what a single shared
        # "invalid" constant would paper over — hence three separate twins.
        assert_equal(pool_state_query_invalid(), -1)      # _pending/_running/_outstanding/_completed
        assert_equal(pool_state_lifecycle_invalid(), 0)   # _close/_destroy/_join_idle
        assert_equal(pool_task_status_invalid(), -1)      # rt_pool_task_status_i64_v1
        assert_true(pool_state_query_invalid() != pool_state_lifecycle_invalid())

    # @manual scenario evidence
    it "pool_submit_reject_code encodes the C rejection ladder in C's own precedence order":
        # @req REQ-SSPEC-LIB
        step("pool_submit_reject_code encodes the C rejection ladder in C's own precedence order")
        # C (rt_pool_state_try_submit_i64_v1), in source order:
        #   state == NULL                  -> -3
        #   closed || destroying           -> -2
        #   outstanding >= capacity        -> -1
        # Precedence is the whole content of this twin: a reordered ladder
        # returns a plausible-but-wrong code on any input matching two rungs,
        # and cannot be observed through the live ABI without real workers.
        assert_equal(pool_submit_reject_code(false, true, 99, 1), -3)   # bad handle outranks closed AND full
        assert_equal(pool_submit_reject_code(false, false, 0, 8), -3)
        assert_equal(pool_submit_reject_code(true, true, 99, 1), -2)    # closed outranks full
        assert_equal(pool_submit_reject_code(true, true, 0, 8), -2)
        assert_equal(pool_submit_reject_code(true, false, 8, 8), -1)    # boundary: == capacity is FULL
        assert_equal(pool_submit_reject_code(true, false, 9, 8), -1)
        assert_equal(pool_submit_reject_code(true, false, 7, 8), 0)     # boundary: capacity-1 admits
        assert_equal(pool_submit_reject_code(true, false, 0, 1), 0)

    # @manual scenario evidence
    it "pool handle encode/decode round-trips over the representable slot/generation domain":
        # @req REQ-SSPEC-LIB
        step("pool handle encode/decode round-trips over the representable slot/generation domain")
        # C (runtime_thread.c, both `static` — no callable oracle exists):
        #   encode: (int64_t)(((uint64_t)generation << 32) | (uint64_t)slot)
        #   decode: slot = raw & 0xffffffff ; generation = raw >> 32
        #
        # DOMAIN LIMIT, stated rather than glossed: C composes the handle in
        # uint64 and lets it wrap; Simple's i64 has no such wraparound, so a
        # generation >= 2^31 overflows the compose here rather than wrapping.
        # The asserted domain is therefore generation < 2^31, which covers
        # every generation the C allocator can actually reach (it increments
        # from 1 per slot reuse). Generation >= 2^31 is left UNTWINNED and is
        # recorded in the backlog, not silently normalised.
        val slots = [1, 2, 255, 65535, 65536, 4294967295, 0]
        val gens = [1, 7, 3, 9, 1, 1, 5]
        var i = 0
        while i < slots.len():
            val h = pool_handle_encode(slots[i], gens[i])
            assert_equal(pool_handle_slot(h), slots[i])
            assert_equal(pool_handle_generation(h), gens[i])
            i = i + 1

    # @manual scenario evidence
    it "pool_handle_is_structurally_valid mirrors the C validity predicate":
        # @req REQ-SSPEC-LIB
        step("pool_handle_is_structurally_valid mirrors the C validity predicate")
        # C: return *slot > 0 && *slot < RT_POOL_V1_MAX_HANDLES && *generation != 0;
        # with RT_POOL_V1_MAX_HANDLES 65536 (runtime_thread.c:504).
        assert_true(pool_handle_is_structurally_valid(pool_handle_encode(1, 1)))
        assert_true(pool_handle_is_structurally_valid(pool_handle_encode(65535, 9)))
        # slot == 0 is the reserved "never valid" handle.
        assert_true(not pool_handle_is_structurally_valid(pool_handle_encode(0, 1)))
        # slot == RT_POOL_V1_MAX_HANDLES is out of range (strict <).
        assert_true(not pool_handle_is_structurally_valid(pool_handle_encode(65536, 1)))
        # generation 0 marks a free slot.
        assert_true(not pool_handle_is_structurally_valid(pool_handle_encode(1, 0)))
        assert_true(not pool_handle_is_structurally_valid(0))
