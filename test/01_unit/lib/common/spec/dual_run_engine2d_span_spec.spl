# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
#
# Dual-run pairs for the three engine2d SIMD span kernels in
# src/runtime/runtime_simd_dispatch.c. The Simple side
# (std.common.engine2d_span_pure) is a straight scalar loop; the oracle side is
# the vectorised kernel reached through the registered extern. For a SIMD
# kernel the scalar reference IS the contract, so this is the strongest form of
# dual-run test available: any disagreement is a real defect in one side.
#
# TAIL COVERAGE IS THE POINT. The C kernels process 8 (AVX2) / 4 (SSE2, NEON)
# lanes at a time and then run a scalar tail. Counts below therefore span
# 1,2,3,4,5,7,8,9,15,16,17,31,33 — deliberately including non-multiples of
# every vector width in play — plus offsets that push the tail off a vector
# boundary, plus counts that overrun dst, overrun src, and overrun both.
#
# HONEST LIMITATION, stated because it changes what this evidence proves:
# under `bin/simple test` (tree-walk interpreter) the oracle side is the
# interpreter own scalar bridge in interpreter_extern/simd.rs, NOT the C
# vector kernels. That still pins the bounds/clamp contract and the blend
# arithmetic across two independent implementations, and the same spec run
# under a native/JIT engine reaches the C kernels. It does not, from the
# interpreter alone, prove the AVX2/NEON tails correct. Same limitation the
# sibling shadow specs carry.
#
# @dual_pair: fill_span_u32_vs_rt_engine2d_simd_fill_span_u32 mode=value-legacy ref=rt_engine2d_simd_fill_span_u32 cand=std.common.engine2d_span_pure.fill_span_u32_pure
# @dual_pair: copy_span_u32_vs_rt_engine2d_simd_copy_span_u32 mode=value-legacy ref=rt_engine2d_simd_copy_span_u32 cand=std.common.engine2d_span_pure.copy_span_u32_pure
# @dual_pair: blend_span_u32_vs_rt_engine2d_simd_blend_span_u32 mode=value-legacy ref=rt_engine2d_simd_blend_span_u32 cand=std.common.engine2d_span_pure.blend_span_u32_pure

use std.spec.step

use std.spec.{describe, it, assert_true, assert_equal}
use std.common.spec.dual_run.{dual_check_bytes, dual_summarize}
use std.common.engine2d_span_pure.{fill_span_u32_pure, copy_span_u32_pure, blend_span_u32_pure}

extern fn rt_engine2d_simd_fill_span_u32(dst: [u32], offset: i64, count: i64, color: u32) -> [u32]
extern fn rt_engine2d_simd_copy_span_u32(dst: [u32], dst_offset: i64, src: [u32], src_offset: i64, count: i64) -> [u32]
extern fn rt_engine2d_simd_blend_span_u32(dst: [u32], dst_offset: i64, src: [u32], src_offset: i64, count: i64) -> [u32]

fn to_i64s(xs: [u32]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < xs.len():
        out.push(xs[i] as i64)
        i = i + 1
    return out

fn to_u32s(xs: [i64]) -> [u32]:
    var out: [u32] = []
    var i = 0
    while i < xs.len():
        out.push(xs[i] as u32)
        i = i + 1
    return out

# Deterministic pixel ramp: alpha cycles through 0, 255 and intermediate
# values so every branch of the src-over blend is exercised.
fn ramp(n: i64, seed: i64) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < n:
        val a = (i * 37 + seed * 61) % 256
        val r = (i * 13 + seed * 7) % 256
        val g = (i * 29 + seed * 3) % 256
        val b = (i * 53 + seed * 11) % 256
        out.push((a << 24) | (r << 16) | (g << 8) | b)
        i = i + 1
    return out

describe "dual_run engine2d SIMD span kernels — scalar Simple reference vs vectorised oracle":
    # @manual scenario evidence
    it "fill_span agrees on every vector-width tail, on empty spans and on out-of-range offsets":
        # @req REQ-SSPEC-LIB
        step("fill_span agrees on every vector-width tail, on empty spans and on out-of-range offsets")
        val counts = [1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 33]
        val offsets = [0, 3]
        val color = 305419896
        val first_base = ramp(40, 1)
        var verdicts = [dual_check_bytes(
            "fill_span",
            fill_span_u32_pure(first_base, 0, 1, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(first_base), 0, 1, color as u32)))]
        var ci = 0
        while ci < counts.len():
            val n = counts[ci]
            var oi = 0
            while oi < offsets.len():
                val off = offsets[oi]
                if ci > 0 or oi > 0:
                    val base = ramp(40, ci + 1)
                    verdicts = verdicts.push(dual_check_bytes(
                        "fill_span",
                        fill_span_u32_pure(base, off, n, color),
                        to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(base), off, n, color as u32))))
                oi = oi + 1
            ci = ci + 1
        # Boundary and invalid inputs: empty dst, zero count, negative count,
        # negative offset, offset at the end, offset past the end, and a count
        # that overruns dst (the clamp path).
        val small = ramp(8, 9)
        val empty: [i64] = []
        verdicts = verdicts.push(dual_check_bytes("fill_empty_dst",
            fill_span_u32_pure(empty, 0, 4, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(empty), 0, 4, color as u32))))
        verdicts = verdicts.push(dual_check_bytes("fill_zero_count",
            fill_span_u32_pure(small, 2, 0, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(small), 2, 0, color as u32))))
        verdicts = verdicts.push(dual_check_bytes("fill_negative_count",
            fill_span_u32_pure(small, 2, 0 - 5, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(small), 2, 0 - 5, color as u32))))
        verdicts = verdicts.push(dual_check_bytes("fill_negative_offset",
            fill_span_u32_pure(small, 0 - 1, 4, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(small), 0 - 1, 4, color as u32))))
        verdicts = verdicts.push(dual_check_bytes("fill_offset_at_end",
            fill_span_u32_pure(small, 8, 4, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(small), 8, 4, color as u32))))
        verdicts = verdicts.push(dual_check_bytes("fill_offset_past_end",
            fill_span_u32_pure(small, 99, 4, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(small), 99, 4, color as u32))))
        verdicts = verdicts.push(dual_check_bytes("fill_count_overruns_dst",
            fill_span_u32_pure(small, 5, 100, color),
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(small), 5, 100, color as u32))))
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 33)
        assert_equal(summary.divergent, 0)
        # Non-vacuity: the reference must actually change the array, and must
        # leave the untouched prefix alone.
        val probe = fill_span_u32_pure(small, 5, 100, color)
        assert_equal(probe[5], color)
        assert_equal(probe[0], small[0])

    it "copy_span agrees across tails, shifted offsets and both clamp directions":
        # @req REQ-SSPEC-LIB
        step("copy_span agrees across tails, shifted offsets and both clamp directions")
        val counts = [1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 33]
        val d0 = ramp(40, 2)
        val s0 = ramp(40, 5)
        var verdicts = [dual_check_bytes("copy_span_aligned",
            copy_span_u32_pure(d0, 0, s0, 0, 1),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(d0), 0, to_u32s(s0), 0, 1)))]
        var ci = 0
        while ci < counts.len():
            val n = counts[ci]
            val dst = ramp(40, ci + 2)
            val src = ramp(40, ci + 5)
            if ci > 0:
                verdicts = verdicts.push(dual_check_bytes("copy_span_aligned",
                    copy_span_u32_pure(dst, 0, src, 0, n),
                    to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(dst), 0, to_u32s(src), 0, n))))
            verdicts = verdicts.push(dual_check_bytes("copy_span_offset",
                copy_span_u32_pure(dst, 3, src, 5, n),
                to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(dst), 3, to_u32s(src), 5, n))))
            ci = ci + 1
        val d8 = ramp(8, 3)
        val s5 = ramp(5, 4)
        val empty: [i64] = []
        verdicts = verdicts.push(dual_check_bytes("copy_src_shorter_clamp",
            copy_span_u32_pure(d8, 0, s5, 0, 8),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(d8), 0, to_u32s(s5), 0, 8))))
        verdicts = verdicts.push(dual_check_bytes("copy_dst_shorter_clamp",
            copy_span_u32_pure(s5, 0, d8, 0, 8),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(s5), 0, to_u32s(d8), 0, 8))))
        verdicts = verdicts.push(dual_check_bytes("copy_empty_src",
            copy_span_u32_pure(d8, 0, empty, 0, 4),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(d8), 0, to_u32s(empty), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("copy_empty_dst",
            copy_span_u32_pure(empty, 0, d8, 0, 4),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(empty), 0, to_u32s(d8), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("copy_negative_src_offset",
            copy_span_u32_pure(d8, 0, s5, 0 - 2, 4),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(d8), 0, to_u32s(s5), 0 - 2, 4))))
        verdicts = verdicts.push(dual_check_bytes("copy_src_offset_past_end",
            copy_span_u32_pure(d8, 0, s5, 5, 4),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(d8), 0, to_u32s(s5), 5, 4))))
        verdicts = verdicts.push(dual_check_bytes("copy_zero_count",
            copy_span_u32_pure(d8, 1, s5, 1, 0),
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(d8), 1, to_u32s(s5), 1, 0))))
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 33)
        assert_equal(summary.divergent, 0)
        # Non-vacuity: a real copy moves src lanes and stops at the clamp.
        val probe = copy_span_u32_pure(d8, 0, s5, 0, 8)
        assert_equal(probe[0], s5[0])
        assert_equal(probe[4], s5[4])
        assert_equal(probe[5], d8[5])

    it "blend_span agrees on opaque, transparent and partial alpha across every tail":
        # @req REQ-SSPEC-LIB
        step("blend_span agrees on opaque, transparent and partial alpha across every tail")
        val counts = [1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 33]
        val d0 = ramp(40, 6)
        val s0 = ramp(40, 1)
        var verdicts = [dual_check_bytes("blend_span_aligned",
            blend_span_u32_pure(d0, 0, s0, 0, 1),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(d0), 0, to_u32s(s0), 0, 1)))]
        var ci = 0
        while ci < counts.len():
            val n = counts[ci]
            val dst = ramp(40, ci + 6)
            val src = ramp(40, ci + 1)
            if ci > 0:
                verdicts = verdicts.push(dual_check_bytes("blend_span_aligned",
                    blend_span_u32_pure(dst, 0, src, 0, n),
                    to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dst), 0, to_u32s(src), 0, n))))
            verdicts = verdicts.push(dual_check_bytes("blend_span_offset",
                blend_span_u32_pure(dst, 3, src, 7, n),
                to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dst), 3, to_u32s(src), 7, n))))
            ci = ci + 1
        # Alpha extremes: fully opaque src must replace dst, fully transparent
        # src must leave dst untouched, and a fully transparent dst under a
        # partial src must not divide by zero.
        val opaque = [4278190335, 4294901760, 4278255360, 4278190208]
        val clear = [255, 65280, 16711680, 128]
        val partial = [2164260863, 2147483648, 2151694080, 2155905152]
        val dstv = ramp(4, 12)
        val clear_dst = [0, 0, 0, 0]
        val empty: [i64] = []
        verdicts = verdicts.push(dual_check_bytes("blend_opaque_src",
            blend_span_u32_pure(dstv, 0, opaque, 0, 4),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dstv), 0, to_u32s(opaque), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("blend_transparent_src",
            blend_span_u32_pure(dstv, 0, clear, 0, 4),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dstv), 0, to_u32s(clear), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("blend_partial_over_clear_dst",
            blend_span_u32_pure(clear_dst, 0, partial, 0, 4),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(clear_dst), 0, to_u32s(partial), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("blend_empty_dst",
            blend_span_u32_pure(empty, 0, partial, 0, 4),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(empty), 0, to_u32s(partial), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("blend_negative_count",
            blend_span_u32_pure(dstv, 0, partial, 0, 0 - 3),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dstv), 0, to_u32s(partial), 0, 0 - 3))))
        verdicts = verdicts.push(dual_check_bytes("blend_offset_past_end",
            blend_span_u32_pure(dstv, 4, partial, 0, 4),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dstv), 4, to_u32s(partial), 0, 4))))
        verdicts = verdicts.push(dual_check_bytes("blend_count_overruns_both",
            blend_span_u32_pure(dstv, 2, partial, 3, 99),
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dstv), 2, to_u32s(partial), 3, 99))))
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 33)
        assert_equal(summary.divergent, 0)
        # Non-vacuity: opaque src replaces, transparent src does not.
        val replaced = blend_span_u32_pure(dstv, 0, opaque, 0, 4)
        assert_equal(replaced[0], opaque[0])
        val untouched = blend_span_u32_pure(dstv, 0, clear, 0, 4)
        assert_equal(untouched[0], dstv[0])

    # NEGATIVE CONTROL. Without this, a green run above is indistinguishable
    # from a harness that never reached the oracle at all: an unregistered
    # extern silently returns nil, and a comparator that is never really
    # exercised reports 0 divergent for the same reason it reports 0 anything.
    # Here a deliberately WRONG reference — the classic SIMD tail bug, a loop
    # that stops one lane short — is fed to the same dual_check_bytes, and the
    # summary MUST come back divergent. If this scenario ever reports 0
    # divergent, every pass in this file is worthless and should be read as a
    # harness failure, not as agreement.
    # @manual scenario evidence
    it "a deliberately short-by-one tail is REPORTED divergent, proving the oracle is really called":
        # @req REQ-SSPEC-LIB
        step("a deliberately short-by-one tail is REPORTED divergent, proving the oracle is really called")
        val dst = ramp(40, 2)
        val src = ramp(40, 5)
        val color = 305419896
        # Broken references: each drops the final lane of the span.
        var broken_fill = fill_span_u32_pure(dst, 0, 7 - 1, color)
        var broken_copy = copy_span_u32_pure(dst, 0, src, 0, 7 - 1)
        var broken_blend = blend_span_u32_pure(dst, 0, src, 0, 7 - 1)
        var verdicts = [dual_check_bytes("fill_span_short_tail",
            broken_fill,
            to_i64s(rt_engine2d_simd_fill_span_u32(to_u32s(dst), 0, 7, color as u32)))]
        verdicts = verdicts.push(dual_check_bytes("copy_span_short_tail",
            broken_copy,
            to_i64s(rt_engine2d_simd_copy_span_u32(to_u32s(dst), 0, to_u32s(src), 0, 7))))
        verdicts = verdicts.push(dual_check_bytes("blend_span_short_tail",
            broken_blend,
            to_i64s(rt_engine2d_simd_blend_span_u32(to_u32s(dst), 0, to_u32s(src), 0, 7))))
        val summary = dual_summarize(verdicts)
        assert_equal(summary.total, 3)
        # All three must be caught. A count below 3 means the comparator is
        # blind to a one-lane tail difference, which is exactly the defect
        # class this whole file exists to catch.
        assert_equal(summary.divergent, 3)
