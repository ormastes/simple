# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

"""
# Array `.get(i)` returns `T?` — `Some(elem)` in range, `None` otherwise

**Category:** Stdlib / collection accessors
**Bug:** doc/08_tracking/bug/array_get_contract_drift_crypto_2026-10-18.md

## Overview

Owner decision (settled 2026-11-09): `a.get(i)` returns `T?` on EVERY lane —
Rust seed interpreter, JIT, self-hosted compiler and native. `a[i]` stays the
direct-element form. `.get(i)` and `.at(i)` are therefore the same operation.

Before this fix the Rust seed interpreter returned the bare element (and the
`nil` sentinel out of range), while the native lane already produced an
`Optional(elem)`. Crypto's nested-limb helpers consumed the result as a plain
collection and failed under native codegen with unresolved `len`/`get`.

The in-range assertions are the ones that are RED against the old seed: a bare
`i64` does not match `Some(v)` (the seed's matcher reports an exhausted match),
while `get(99)` happened to read as absent on every lane.

## Coverage

- in-range hit (first, interior, `len - 1`) and the `[i]` contrast
- out-of-range: `len` exactly, far past the end, negative, empty container
- nested array element (`[[i64]]`) — the crypto shape from the bug record
- `.get` and `.at` agree on every index
"""

use std.spec.step

use std.spec

val SENTINEL_ABSENT: i64 = -777

fn get_or_absent(xs: [i64], i: i64) -> i64:
    match xs.get(i):
        Some(v): return v
        None: return SENTINEL_ABSENT

fn is_present(xs: [i64], i: i64) -> bool:
    match xs.get(i):
        Some(v): return true
        None: return false

fn at_or_absent(xs: [i64], i: i64) -> i64:
    match xs.at(i):
        Some(v): return v
        None: return SENTINEL_ABSENT

fn nested_values() -> [[i64]]:
    [[7, 11], [13]]

fn nested_first_len() -> i64:
    match nested_values().get(0):
        Some(row): return row.len()
        None: return SENTINEL_ABSENT

fn nested_first_second() -> i64:
    match nested_values().get(0):
        Some(row):
            match row.get(1):
                Some(v): return v
                None: return SENTINEL_ABSENT
        None: return SENTINEL_ABSENT

describe("array .get() Option accessor"):

    it("returns Some(element) for an in-range index"):
        val xs: [i64] = [10, 20, 30, 40, 50]
        assert_equal(get_or_absent(xs, 0), 10)
        assert_equal(get_or_absent(xs, 2), 30)
        assert_equal(get_or_absent(xs, 4), 50)
        assert_true(is_present(xs, 4))

    it("returns None at len, far past the end, and for a negative index"):
        val xs: [i64] = [10, 20, 30, 40, 50]
        assert_equal(get_or_absent(xs, 5), SENTINEL_ABSENT)
        assert_equal(get_or_absent(xs, 99), SENTINEL_ABSENT)
        assert_equal(get_or_absent(xs, -1), SENTINEL_ABSENT)
        assert_false(is_present(xs, 5))

    it("returns None on an empty array"):
        val e: [i64] = []
        assert_equal(get_or_absent(e, 0), SENTINEL_ABSENT)

    it("reports an element whose value is 0 or 3 as present"):
        val xs: [i64] = [0, 3]
        assert_equal(get_or_absent(xs, 0), 0)
        assert_equal(get_or_absent(xs, 1), 3)
        assert_true(is_present(xs, 1))

    it("agrees with [i] and with .at(i) on every in-range index"):
        val xs: [i64] = [7, 0, 3, 42, -5]
        var i = 0
        while i < xs.len():
            assert_equal(get_or_absent(xs, i), xs[i])
            assert_equal(get_or_absent(xs, i), at_or_absent(xs, i))
            i = i + 1

    it("wraps a nested array row so len and inner get work after unwrapping"):
        assert_equal(nested_first_len(), 2)
        assert_equal(nested_first_second(), 11)
