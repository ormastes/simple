"""Representable powers must not evaluate an unused overflowing square."""
use std.spec.step
use std.common.math.{math_pow_i64, pow_i64}

describe "Integer power terminal-square safety":
    it "preserves signed endpoints for exponent one":
        step("Compute representable endpoint powers without a terminal square")
        val largest: i64 = 9223372036854775807
        val smallest: i64 = -9223372036854775807 - 1
        expect(math_pow_i64(largest, 1)).to_equal(largest)
        expect(math_pow_i64(smallest, 1)).to_equal(smallest)
        expect(pow_i64(3037000500, 1)).to_equal(3037000500)

    it "preserves representable powers across multiple squaring steps":
        step("Reach the final useful multiplication at the signed boundary")
        val smallest: i64 = -9223372036854775807 - 1
        expect(math_pow_i64(2, 62)).to_equal(4611686018427387904)
        expect(math_pow_i64(-2, 63)).to_equal(smallest)
        expect(pow_i64(3, 20)).to_equal(3486784401)
        expect(pow_i64(-3, 3)).to_equal(-27)
        expect(pow_i64(-3, 4)).to_equal(81)

    it "retains zero and negative exponent behavior":
        step("Preserve the existing integer exponent contract")
        val smallest: i64 = -9223372036854775807 - 1
        expect(math_pow_i64(0, 0)).to_equal(1)
        expect(math_pow_i64(0, 9)).to_equal(0)
        expect(math_pow_i64(7, -1)).to_equal(0)
        expect(math_pow_i64(7, smallest)).to_equal(0)
        expect(math_pow_i64(-1, 9223372036854775807)).to_equal(-1)
