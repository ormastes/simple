"""
## Purpose and audience
Purpose: Prove that ByteSpan.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# span_spec.spl — ByteSpan / ByteBuffer invariants (AC-2, AC-3)
use std.spec
use lib.common.bytes.span.{ByteSpan, ByteBuffer}

describe "ByteSpan":
    it "reports len and get over the whole slice":
        step("Verify: reports len and get over the whole slice")
        # @req: REQ-LIB-COMMON-001
        val data: [u8] = [10u8, 20u8, 30u8, 40u8]
        val s = ByteSpan.new(data)
        expect(s.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(s.get(0).to_i64()).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(s.get(3).to_i64()).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "fails closed on out-of-bounds get (returns 0, no corruption)":
        step("Verify: fails closed on out-of-bounds get (returns 0, no corruption)")
        val data: [u8] = [10u8, 20u8, 30u8]
        val s = ByteSpan.new(data)
        expect(s.get(3).to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(s.get(0 - 1).to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(s.get(999).to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "try_get returns Err out of bounds and Ok in bounds":
        step("Verify: try_get returns Err out of bounds and Ok in bounds")
        val data: [u8] = [7u8, 8u8]
        val s = ByteSpan.new(data)
        expect(s.try_get(0).is_ok()).to_equal(true)
        expect(s.try_get(2).is_ok()).to_equal(false)

    it "slice produces a bounded sub-window":
        step("Verify: slice produces a bounded sub-window")
        val data: [u8] = [1u8, 2u8, 3u8, 4u8, 5u8]
        val s = ByteSpan.new(data)
        val mid = s.slice(1, 3)
        expect(mid.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(mid.get(0).to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(mid.get(2).to_i64()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "slice clamps over-long lengths instead of overrunning":
        step("Verify: slice clamps over-long lengths instead of overrunning")
        val data: [u8] = [1u8, 2u8, 3u8]
        val s = ByteSpan.new(data)
        val over = s.slice(1, 100)
        expect(over.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(over.get(1).to_i64()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "value equality compares contents not identity":
        step("Verify: value equality compares contents not identity")
        val a: [u8] = [9u8, 8u8, 7u8]
        val b: [u8] = [9u8, 8u8, 7u8]
        val c: [u8] = [9u8, 8u8, 6u8]
        expect(ByteSpan.new(a).equals(ByteSpan.new(b))).to_equal(true)
        expect(ByteSpan.new(a).equals(ByteSpan.new(c))).to_equal(false)

    it "starts_with detects a prefix span":
        step("Verify: starts_with detects a prefix span")
        val data: [u8] = [77u8, 90u8, 1u8, 2u8]
        val s = ByteSpan.new(data)
        val pfx: [u8] = [77u8, 90u8]
        expect(s.starts_with(ByteSpan.new(pfx))).to_equal(true)

    it "supports == operator for value equality (AC-2)":
        step("Verify: supports == operator for value equality (AC-2)")
        val a: [u8] = [4u8, 5u8, 6u8]
        val b: [u8] = [4u8, 5u8, 6u8]
        expect(ByteSpan.new(a)).to_equal(ByteSpan.new(b))

    it "iterates: internal sum() and external for-in over to_bytes() (AC-2)":
        step("Verify: iterates: internal sum() and external for-in over to_bytes() (AC-2)")
        val data: [u8] = [10u8, 20u8, 30u8]
        val s = ByteSpan.new(data)
        expect(s.sum()).to_equal(60)  # oracle: 60 — named expected value from the requirement
        var total = 0
        for byte_v in s.to_bytes():
            total = total + byte_v.to_i64()
        expect(total).to_equal(60)  # oracle: 60 — named expected value from the requirement

describe "ByteBuffer":
    it "push_u8 grows length and freeze yields matching ByteSpan":
        step("Verify: push_u8 grows length and freeze yields matching ByteSpan")
        var b = ByteBuffer.new()
        b.push_u8(100u8)
        b.push_u8(200u8)
        expect(b.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val span = b.freeze()
        expect(span.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(span.get(0).to_i64()).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(span.get(1).to_i64()).to_equal(200)  # oracle: 200 — named expected value from the requirement

    it "push_span round-trips byte-exactly through freeze (AC-3)":
        step("Verify: push_span round-trips byte-exactly through freeze (AC-3)")
        val src: [u8] = [3u8, 1u8, 4u8, 1u8, 5u8, 9u8]
        val src_span = ByteSpan.new(src)
        var b = ByteBuffer.new()
        b.push_span(src_span)
        val frozen = b.freeze()
        expect(frozen.equals(src_span)).to_equal(true)
        expect(frozen.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement
