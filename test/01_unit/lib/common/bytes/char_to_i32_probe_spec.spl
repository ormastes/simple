# Test: char.to_i32() must not be input-independent
# Bug: doc/08_tracking/bug/char_to_i32_input_independent_zero_2026-08-26.md
#
# Pre-fix, `ch.to_i32()` on a non-numeric single character always returned 0
# regardless of which character it was (parse-as-integer failed and fell back
# to a hardcoded 0). That degenerates any djb2/FNV-style checksum that folds
# in `ch.to_i32()` per character: distinct strings of the same length hashed
# identically because every character contributed the same 0.
use std.spec

fn codes_of(s: text) -> [i64]:
    var out: [i64] = []
    for ch in s:
        out.push(ch.to_i32())
    out

describe "char to_i32":
    it "gives distinct values for distinct non-numeric characters":
        val codes = codes_of("abcdefghijklmnopqrstuvwxyz")
        var saw_nonzero = false
        var all_same = true
        for c in codes:
            if c != 0:
                saw_nonzero = true
            if c != codes[0]:
                all_same = false
        expect(saw_nonzero).to_equal(true)
        expect(all_same).to_equal(false)

    it "reproduces: a djb2-style fold distinguishes different-content same-length strings":
        # This is the exact shape from test/01_unit/tools/shell/checksum_spec.spl.
        var hash1: u64 = 5381
        var hash2: u64 = 5381
        for ch in "hello":
            hash1 = ((hash1 << 5) + hash1) + ch.to_i32()
        for ch in "world":
            hash2 = ((hash2 << 5) + hash2) + ch.to_i32()
        expect(hash1 != hash2).to_equal(true)

    # Defect-class neighbor: to_i64/to_i16/to_i8 share the same string-method
    # arm in interpreter_method/string.rs and must not regress the same way.
    it "to_i64 also distinguishes distinct non-numeric characters":
        var xs: [i64] = []
        for ch in "xy":
            xs.push(ch.to_i64())
        expect(xs[0] != xs[1]).to_equal(true)

    it "to_i8 also distinguishes distinct non-numeric characters":
        var xs: [i64] = []
        for ch in "mn":
            xs.push(ch.to_i8())
        expect(xs[0] != xs[1]).to_equal(true)

    # Guard the case the fix must NOT change: numeric text still parses as a
    # number, not as a codepoint.
    it "still parses actual numeric text as a number, not a codepoint":
        expect("42".to_i32()).to_equal(42)
        expect("5".to_i32()).to_equal(5)

    it "empty text still returns 0":
        expect("".to_i32()).to_equal(0)
