"""
## Purpose and audience
Pins the crypto and compress dynSMF bundle entry modules: each imports, reports
ready, and re-exports a working primary entry point.
## Operator workflow
bin/simple test test/01_unit/lib/common/dynsmf_entry_spec.spl
## Compatibility and limitations
Inputs are a few bytes; full algorithm vectors live in the per-algorithm specs.
## Verification guidance and troubleshooting
A failure here means a bundle entry module no longer re-exports a name the
dynsmf manifest lists (src/os/smf/dynsmf_session.spl).
"""
# @req: REQ-SSPEC-OS
use std.spec.{describe, it, expect, step}
use os.smf.dynsmf_session.{dynsmf_default_manifest}

extern fn rt_file_read_text(path: text) -> text
use std.common.crypto.dynsmf_entry.{crypto_lib_ready, hmac_sha256_bytes, tls12_prf_sha256, is_pem}
use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}
use std.common.compress.dynsmf_entry.{compress_lib_ready, snappy_compress, snappy_decompress, gzip_compress, gzip_decompress, deflate_compress, deflate_decompress}

describe "crypto and compress dynSMF entry modules":
    it "crypto entry is ready and re-exports hmac_sha256_bytes (RFC 4231 case 2)":
        step("crypto entry is ready and re-exports hmac_sha256_bytes")
        expect(crypto_lib_ready()).to_equal(true)
        val mac = hmac_sha256_bytes(crypto_text_to_bytes("Jefe"), crypto_text_to_bytes("what do ya want for nothing?"))
        expect(bytes_to_hex(mac)).to_equal("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")

    it "compress entry is ready and re-exports a snappy round trip":
        step("compress entry is ready and re-exports a snappy round trip")
        expect(compress_lib_ready()).to_equal(true)
        val data: [u8] = [104, 105, 104, 105, 104, 105, 104, 105]
        val back = snappy_decompress(snappy_compress(data))
        expect(back).to_equal(data)

    it "crypto entry re-exports tls12_prf_sha256 and is_pem":
        step("crypto entry re-exports tls12_prf_sha256 and is_pem")
        val secret = [0x9b, 0xbe, 0x43, 0x6b, 0xa9, 0x40, 0xf0, 0x17, 0xb1, 0x76, 0x52, 0x84, 0x9a, 0x71, 0xdb, 0x35]
        val seed = [0xa0, 0xba, 0x9f, 0x93, 0x6c, 0xda, 0x31, 0x18, 0x27, 0xa6, 0xf7, 0x96, 0xff, 0xd5, 0x19, 0x8c]
        val out = tls12_prf_sha256(secret, "test label", seed, 8)
        expect(bytes_to_hex(out)).to_equal("e3f229ba727be17b")
        expect(is_pem("-----BEGIN CERTIFICATE-----\nAA==\n-----END CERTIFICATE-----")).to_equal(true)
        expect(is_pem("not pem")).to_equal(false)

    it "compress entry re-exports gzip and deflate round trips":
        step("compress entry re-exports gzip and deflate round trips")
        val data: [u8] = [104, 105, 104, 105, 104, 105, 104, 105, 0, 255, 7]
        val gz = gzip_compress(data)
        expect(gz[0]).to_equal(0x1f)
        expect(gz[1]).to_equal(0x8b)
        expect(gzip_decompress(gz)).to_equal(data)
        expect(deflate_decompress(deflate_compress(data))).to_equal(data)

    it "compress manifest exports and entry source both carry gzip and deflate":
        step("compress manifest exports and entry source both carry gzip and deflate")
        val names = ["gzip_compress", "gzip_decompress", "deflate_compress", "deflate_decompress"]
        var exports: [text] = []
        for entry in dynsmf_default_manifest():
            if entry.id == "compress":
                exports = entry.exports
        val source = rt_file_read_text("src/lib/common/compress/dynsmf_entry.spl") ?? ""
        var export_lines = ""
        for line in source.split("\n"):
            if line.starts_with("export use "):
                export_lines = export_lines + line + "\n"
        for n in names:
            expect(exports.contains(n)).to_equal(true)
            expect(export_lines.contains(n)).to_equal(true)
