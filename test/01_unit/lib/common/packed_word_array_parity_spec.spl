"""Packed word arrays behave exactly like boxed arrays

@tag: interpreter, array, memory

The interpreter stores a large `[x; n]` repeat whose value is a non-negative
`Int` or a `u32` in packed form (about 4 bytes per element instead of 64).
Every observable result must be the one the boxed array gives. Each example
builds the same contents twice. `[x; n]` with n >= 1024 is packed; a
push-built copy is boxed. The example runs the same operation on both and
requires identical results.

Design: doc/05_design/compiler/interpreter/packed_word_array_storage_2026-10-05.md
"""

use std.spec.{describe, it, expect}

val N = 2048

fn boxed_copy(xs: [u32]) -> [u32]:
    var out: [u32] = []
    for x in xs:
        out.push(x)
    out

fn summary(xs: [u32]) -> text:
    var h: i64 = 7
    var i = 0
    while i < xs.len():
        h = (h * 31 + xs[i].to_i64()) % 1000000007
        i = i + 1
    "len={xs.len()} hash={h} first={xs[0]} last={xs[xs.len() - 1]}"

class Surface:
    buf: [u32]

    me set(i: i64, c: u32):
        self.buf[i] = c

    me fill(off: i64, n: i64, c: u32) -> i64:
        val row: [u32] = [c; n]
        self.buf.write_span(row, off, 0, n)

    me shift(dst: i64, src: i64, n: i64) -> i64:
        self.buf.write_span(self.buf, dst, src, n)

describe "packed word arrays":
    it "reads, lengths and iteration match boxed":
        """Index reads, len, for-in and equality agree."""
        val packed: [u32] = [7u32; N]
        val boxed = boxed_copy(packed)
        expect(summary(packed)).to_equal(summary(boxed))
        expect(packed == boxed).to_equal(true)
        var count = 0
        for x in packed:
            if x == 7u32:
                count = count + 1
        expect(count).to_equal(N)

    it "index writes through local, field and nested places match boxed":
        var p: [u32] = [0u32; N]
        var b = boxed_copy(p)
        p[5] = 9u32
        b[5] = 9u32
        var sp = Surface(buf: [0u32; N])
        var sb = Surface(buf: boxed_copy([0u32; N]))
        sp.set(100, 0xFF00FF00u32)
        sb.set(100, 0xFF00FF00u32)
        var rows_p = [[0u32; N], [1u32; N]]
        var rows_b = [boxed_copy([0u32; N]), boxed_copy([1u32; N])]
        rows_p[1][3] = 4u32
        rows_b[1][3] = 4u32
        expect(summary(p)).to_equal(summary(b))
        expect(summary(sp.buf)).to_equal(summary(sb.buf))
        expect(summary(rows_p[1])).to_equal(summary(rows_b[1]))

    it "a shared array mutated through one alias leaves the other unchanged":
        var a: [u32] = [3u32; N]
        val alias = a
        a[0] = 4u32
        expect(a[0]).to_equal(4u32)
        expect(alias[0]).to_equal(3u32)
        var s = Surface(buf: [1u32; N])
        val snap = s.buf
        s.set(1, 2u32)
        expect(snap[1]).to_equal(1u32)
        expect(s.buf[1]).to_equal(2u32)

    it "write_span, including self overlap, matches boxed":
        var sp = Surface(buf: [0u32; N])
        var sb = Surface(buf: boxed_copy([0u32; N]))
        expect(sp.fill(10, 300, 5u32)).to_equal(sb.fill(10, 300, 5u32))
        sp.set(10, 6u32)
        sb.set(10, 6u32)
        expect(sp.shift(11, 10, 200)).to_equal(sb.shift(11, 10, 200))
        expect(summary(sp.buf)).to_equal(summary(sb.buf))

    it "a non-u32 store in the middle of a loop converts and still matches boxed":
        var p: [u32] = [0u32; N]
        var b = boxed_copy(p)
        var i = 0
        while i < 50:
            p[i] = i as u32
            b[i] = i as u32
            if i == 25:
                p[i] = -1
                b[i] = -1
            i = i + 1
        expect("{p[25]}").to_equal("{b[25]}")
        expect(p[24]).to_equal(b[24])
        expect(p.len()).to_equal(b.len())

    it "push, pop, growth past the end and slicing match boxed":
        var p: [u32] = [2u32; N]
        var b = boxed_copy(p)
        p.push(8u32)
        b.push(8u32)
        expect(p.pop()).to_equal(b.pop())
        p[N + 1] = 1u32
        b[N + 1] = 1u32
        expect("{p[N]}").to_equal("{b[N]}")
        expect(p.len()).to_equal(b.len())
        expect("{p[0:4]}").to_equal("{b[0:4]}")
        expect("{p[N - 2:N]}").to_equal("{b[N - 2:N]}")

    it "Int and u32 elements keep their kind":
        """`x - x - 1` is -1 for Int and wraps for u32 in the interpreter."""
        val ints = [0; N]
        val words: [u32] = [0u32; N]
        expect(ints[0] - ints[0] - 1).to_equal(-1)
        expect(words[0] - words[0] - 1u32).to_equal(4294967295u32)
