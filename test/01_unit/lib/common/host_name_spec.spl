use std.common.net.host_name.{HostName, HostIdentity, host_name_parse, host_identity_parse}

describe "host_name_parse":
    it "accepts and lowercases a DNS name":
        match host_name_parse("Example.COM"):
            Ok(h): expect(h.value).to_equal("example.com")
            Err(e): fail(e)

    it "rejects empty, whitespace, IP literals":
        expect(host_name_parse("").is_err()).to_equal(true)
        expect(host_name_parse("a b.com").is_err()).to_equal(true)
        expect(host_name_parse("127.0.0.1").is_err()).to_equal(true)
        expect(host_name_parse("::1").is_err()).to_equal(true)

    it "rejects bad labels":
        expect(host_name_parse("-a.com").is_err()).to_equal(true)
        expect(host_name_parse("a-.com").is_err()).to_equal(true)
        expect(host_name_parse("a..com").is_err()).to_equal(true)
        expect(host_name_parse("a_b.com").is_err()).to_equal(true)
        expect(host_name_parse("a.com.").is_err()).to_equal(true)

    it "rejects non-ASCII":
        expect(host_name_parse("bücher.de").is_err()).to_equal(true)

    it "enforces length limits":
        var long_label = ""
        var i = 0
        while i < 64:
            long_label = long_label + "a"
            i = i + 1
        expect(host_name_parse(long_label + ".com").is_err()).to_equal(true)
        expect(host_name_parse(long_label[0:63] + ".com").is_err()).to_equal(false)

    it "rejects non-ASCII with the IDNA message":
        match host_name_parse("bücher.de"):
            Ok(_): fail("non-ASCII accepted")
            Err(e): expect(e.contains("ASCII")).to_equal(true)

describe "host_identity_parse":
    it "classifies DNS names, IPv4 and IPv6":
        match host_identity_parse("Example.com"):
            Ok(HostIdentity.Name(n)): expect(n.value).to_equal("example.com")
            _: fail("name not classified")
        match host_identity_parse("10.0.0.1"):
            Ok(HostIdentity.Ip(_)): expect(true).to_equal(true)
            _: fail("ipv4 not classified")
        match host_identity_parse("2001:db8::1"):
            Ok(HostIdentity.Ip(_)): expect(true).to_equal(true)
            _: fail("ipv6 not classified")
        match host_identity_parse("::1"):
            Ok(HostIdentity.Ip(_)): expect(true).to_equal(true)
            _: fail("loopback not classified")

    it "rejects malformed literals and names":
        expect(host_identity_parse("1.2.3").is_err()).to_equal(true)
        expect(host_identity_parse("300.1.1.1").is_err()).to_equal(true)
        expect(host_identity_parse("1:2:3").is_err()).to_equal(true)
        expect(host_identity_parse("::zz").is_err()).to_equal(true)
        expect(host_identity_parse("1::2::3").is_err()).to_equal(true)
        expect(host_identity_parse("").is_err()).to_equal(true)
