use std.common.net.host_name.{HostName, host_name_parse, host_name_is_ip_literal}

describe "host_name_parse":
    it "accepts and lowercases a DNS name":
        match host_name_parse("Example.COM"):
            Ok(h): expect(h.value).to_equal("example.com")
            Err(e): fail(e)

    it "rejects empty, whitespace, IP literals":
        expect(host_name_parse("").is_err()).to_equal(true)
        expect(host_name_parse("a b.com").is_err()).to_equal(true)
        expect(host_name_parse("127.0.0.1").is_err()).to_equal(true)
        expect(host_name_parse("::1").is_err()).to_equal(true)

    it "rejects bad labels":
        expect(host_name_parse("-a.com").is_err()).to_equal(true)
        expect(host_name_parse("a-.com").is_err()).to_equal(true)
        expect(host_name_parse("a..com").is_err()).to_equal(true)
        expect(host_name_parse("a_b.com").is_err()).to_equal(true)
        expect(host_name_parse("a.com.").is_err()).to_equal(true)

    it "rejects non-ASCII":
        expect(host_name_parse("bücher.de").is_err()).to_equal(true)

    it "enforces length limits":
        var long_label = ""
        var i = 0
        while i < 64:
            long_label = long_label + "a"
            i = i + 1
        expect(host_name_parse(long_label + ".com").is_err()).to_equal(true)
        expect(host_name_parse(long_label[0:63] + ".com").is_err()).to_equal(false)

    it "detects IP literals":
        expect(host_name_is_ip_literal("10.0.0.1")).to_equal(true)
        expect(host_name_is_ip_literal("localhost")).to_equal(false)
