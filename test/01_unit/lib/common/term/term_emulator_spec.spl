# Purpose and audience: executable specification evidence for the owning engineering team.
# @cover src/lib/common/term/emulator.spl 80%
"""
# Pure-Simple VT/ANSI Terminal Emulator

**Category:** Stdlib
**Status:** Implemented

## Overview

I run agent panes inside the `cs` caret suite, and on Windows there is no
tmux to turn a child process's output into something I can look at. This
module is the piece that closes that gap: I hand it the raw bytes a CLI
agent wrote, and it hands me back a grid of styled cells I can paint.

It has to be honest about two things. First, it must never let an escape
sequence it does not understand leak into the grid as garbage text — but it
must also not hide how much it skipped, so it counts every sequence it
consumed and ignored. Second, a real pty read lands wherever the kernel
decides, frequently in the middle of an escape sequence, so feeding
`ESC [` and then `31m` has to mean exactly what feeding `ESC [ 31 m` means.

## Key Concepts

| Concept | Description |
|---------|-------------|
| TermScreen | Immutable cell grid plus cursor, style, title and parser state |
| term_feed | Pure: consumes bytes, returns a NEW screen |
| unknown_seqs | How many sequences were consumed but not acted on |
| pending | The incomplete escape-sequence tail carried between feeds |
| colour encoding | -1 default, 0..255 palette index, >= 0x1000000 truecolor |
"""

use std.spec.step
use std.spec.{describe, it, assert_equal, assert_true}
use std.common.term.emulator.{
    TermScreen, TermCell,
    term_new, term_feed, term_resize, term_render_text, term_cell_at,
    ATTR_BOLD, ATTR_DIM, ATTR_UNDERLINE, ATTR_REVERSE, TRUECOLOR_FLAG,
}


# Escape-sequence fixtures are built by concatenation from this helper rather
# than embedded in literals: a brace inside a plain string is parsed as
# interpolation on this compiler, which makes hand-written CSI literals a
# minefield. `esc()` keeps every fixture brace-free.
fn esc() -> text:
    return "\x1b"

fn csi(body: text) -> text:
    return esc() + "[" + body


describe "term_feed lays printable text into the grid":
    it "places each glyph in its own cell and advances the cursor":
        step("places each glyph in its own cell and advances the cursor")
        val s = term_feed(term_new(10, 3), "hi")
        assert_equal(term_cell_at(s, 0, 0).ch, "h")
        assert_equal(term_cell_at(s, 1, 0).ch, "i")
        assert_equal(term_cell_at(s, 2, 0).ch, "")
        assert_equal(s.cur_col, 2)
        assert_equal(s.cur_row, 0)
        assert_equal(term_render_text(s), "hi\n\n")

    it "keeps a multi-byte UTF-8 glyph in a single cell":
        step("keeps a multi-byte UTF-8 glyph in a single cell")
        # If the emulator indexed bytes instead of characters this would
        # smear the two-byte 'e-acute' across two cells as mojibake.
        val s = term_feed(term_new(6, 2), "héllo")
        assert_equal(term_cell_at(s, 0, 0).ch, "h")
        assert_equal(term_cell_at(s, 1, 0).ch, "é")
        assert_equal(term_cell_at(s, 2, 0).ch, "l")
        assert_equal(s.cur_col, 5)

    it "honours carriage return, line feed, backspace and tab":
        step("honours carriage return, line feed, backspace and tab")
        val a = term_feed(term_new(10, 3), "one\r\ntwo")
        assert_equal(term_render_text(a), "one\ntwo\n")
        val b = term_feed(term_new(10, 2), "abc\bZ")
        assert_equal(term_render_text(b), "abZ\n")
        val c = term_feed(term_new(20, 2), "ab\tX")
        assert_equal(c.cur_col, 9)
        assert_equal(term_cell_at(c, 8, 0).ch, "X")

    it "wraps at the right margin without inventing a blank line":
        step("wraps at the right margin without inventing a blank line")
        val s = term_feed(term_new(4, 3), "abcdef")
        assert_equal(term_render_text(s), "abcd\nef\n")
        assert_equal(term_cell_at(s, 0, 1).ch, "e")
        # Deferred wrap: an exactly-cols-wide line followed by a newline
        # must NOT skip a row.
        val t = term_feed(term_new(4, 3), "abcd\r\nZ")
        assert_equal(term_render_text(t), "abcd\nZ\n")

    it "treats a line feed as a pure index that keeps the column":
        step("treats a line feed as a pure index that keeps the column")
        # This is real VT behaviour and it is deliberate: a bare LF moves down
        # a row and leaves the column alone. A pty delivers "\r\n" (ONLCR), so
        # panes see the line start they expect; a caller feeding bare "\n" and
        # expecting column 0 is the one that is wrong, and this pins it so the
        # multiplexer cannot be surprised later.
        val s = term_feed(term_new(6, 3), "ab\ncd")
        assert_equal(term_render_text(s), "ab\n  cd\n")
        assert_equal(term_feed(term_new(6, 3), "ab\r\ncd").cur_col, 2)


describe "term_feed moves the cursor on CSI requests":
    it "positions the cursor absolutely with H and f":
        step("positions the cursor absolutely with H and f")
        var s = term_feed(term_new(8, 4), csi("3;5H") + "X")
        assert_equal(term_cell_at(s, 4, 2).ch, "X")
        s = term_feed(s, csi("1;1f") + "Y")
        assert_equal(term_cell_at(s, 0, 0).ch, "Y")
        # Missing parameters default to row 1 / column 1.
        val h = term_feed(term_feed(term_new(8, 4), csi("4;4H")), csi("H") + "Q")
        assert_equal(term_cell_at(h, 0, 0).ch, "Q")

    it "moves relatively with A, B, C and D and clamps at the edges":
        step("moves relatively with A, B, C and D and clamps at the edges")
        var s = term_feed(term_new(8, 4), csi("2;2H"))
        s = term_feed(s, csi("1A") + "u")
        assert_equal(term_cell_at(s, 1, 0).ch, "u")
        s = term_feed(s, csi("2;2H") + csi("1B") + "d")
        assert_equal(term_cell_at(s, 1, 2).ch, "d")
        s = term_feed(s, csi("2;2H") + csi("1C") + "r")
        assert_equal(term_cell_at(s, 2, 1).ch, "r")
        s = term_feed(s, csi("2;2H") + csi("1D") + "l")
        assert_equal(term_cell_at(s, 0, 1).ch, "l")
        # Clamping: 99 rows up from row 1 is row 0, not a negative index.
        val c = term_feed(term_feed(term_new(8, 4), csi("2;2H")), csi("99A"))
        assert_equal(c.cur_row, 0)


describe "term_feed erases regions of the grid":
    it "erases to end of line, to start of line and the whole line":
        step("erases to end of line, to start of line and the whole line")
        val base = term_feed(term_new(6, 2), "abcdef" + csi("1;3H"))
        assert_equal(term_render_text(term_feed(base, csi("0K"))), "ab\n")
        assert_equal(term_render_text(term_feed(base, csi("1K"))), "   def\n")
        assert_equal(term_render_text(term_feed(base, csi("2K"))), "\n")
        # No parameter means mode 0.
        assert_equal(term_render_text(term_feed(base, csi("K"))), "ab\n")

    it "erases to end of display, to start of display and the whole display":
        step("erases to end of display, to start of display and the whole display")
        val base = term_feed(term_new(3, 3), "abcdefghi" + csi("2;2H"))
        assert_equal(term_render_text(base), "abc\ndef\nghi")
        assert_equal(term_render_text(term_feed(base, csi("0J"))), "abc\nd\n")
        assert_equal(term_render_text(term_feed(base, csi("1J"))), "\n  f\nghi")
        assert_equal(term_render_text(term_feed(base, csi("2J"))), "\n\n")


describe "term_feed tracks SGR styling":
    it "sets the 8 and 16 colour foreground and background":
        step("sets the 8 and 16 colour foreground and background")
        val s = term_feed(term_new(6, 2), csi("31m") + csi("44m") + "R")
        val c = term_cell_at(s, 0, 0)
        assert_equal(c.fg, 1)
        assert_equal(c.bg, 4)
        val b = term_feed(term_new(6, 2), csi("92;101m") + "B")
        assert_equal(term_cell_at(b, 0, 0).fg, 10)
        assert_equal(term_cell_at(b, 0, 0).bg, 9)

    it "sets bold, dim, underline and reverse as a bitfield":
        step("sets bold, dim, underline and reverse as a bitfield")
        val s = term_feed(term_new(6, 2), csi("1;2;4;7m") + "A")
        val want = ATTR_BOLD + ATTR_DIM + ATTR_UNDERLINE + ATTR_REVERSE
        assert_equal(term_cell_at(s, 0, 0).attrs, want)
        # 22/24/27 clear individually without disturbing the rest.
        val t = term_feed(term_new(6, 2), csi("1;4m") + csi("24m") + "A")
        assert_equal(term_cell_at(t, 0, 0).attrs, ATTR_BOLD)

    it "resets colour and attributes on 0m":
        step("resets colour and attributes on 0m")
        var s = term_feed(term_new(6, 2), csi("1;31;44m") + "A")
        s = term_feed(s, csi("0m") + "B")
        val a = term_cell_at(s, 0, 0)
        val b = term_cell_at(s, 1, 0)
        assert_true(a.fg == 1 and a.bg == 4 and a.attrs == ATTR_BOLD)
        assert_equal(b.fg, -1)
        assert_equal(b.bg, -1)
        assert_equal(b.attrs, 0)
        # A bare `ESC [ m` is an implicit reset too.
        val z = term_feed(term_feed(term_new(6, 2), csi("31m")), csi("m") + "C")
        assert_equal(term_cell_at(z, 0, 0).fg, -1)

    it "decodes 256 colour and truecolor into the documented encoding":
        step("decodes 256 colour and truecolor into the documented encoding")
        val p = term_feed(term_new(6, 2), csi("38;5;196m") + csi("48;5;21m") + "P")
        assert_equal(term_cell_at(p, 0, 0).fg, 196)
        assert_equal(term_cell_at(p, 0, 0).bg, 21)
        val t = term_feed(term_new(6, 2), csi("38;2;10;20;30m") + "T")
        val fg = term_cell_at(t, 0, 0).fg
        assert_equal(fg, TRUECOLOR_FLAG + 10 * 65536 + 20 * 256 + 30)
        assert_true(fg >= TRUECOLOR_FLAG)
        assert_equal((fg / 65536) % 256, 10)
        assert_equal((fg / 256) % 256, 20)
        assert_equal(fg % 256, 30)
        val bgs = term_feed(term_new(6, 2), csi("48;2;255;0;128m") + "U")
        assert_equal(term_cell_at(bgs, 0, 0).bg, TRUECOLOR_FLAG + 255 * 65536 + 128)


describe "term_feed scrolls and sets the scroll region":
    it "scrolls the whole screen when text runs off the bottom":
        step("scrolls the whole screen when text runs off the bottom")
        val s = term_feed(term_new(3, 3), "aaa\r\nbbb\r\nccc\r\nddd")
        assert_equal(term_render_text(s), "bbb\nccc\nddd")

    it "confines scrolling to a region set with r, and reverse-indexes":
        step("confines scrolling to a region set with r, and reverse-indexes")
        var s = term_feed(term_new(3, 4), "aaa\r\nbbb\r\nccc\r\nddd")
        s = term_feed(s, csi("2;3r"))
        # `r` homes the cursor to the top of the region.
        assert_equal(s.cur_row, 1)
        assert_equal(s.cur_col, 0)
        s = term_feed(s, csi("3;1H") + "\r\nzzz")
        # Row 0 and row 3 are outside the region and must be untouched.
        assert_equal(term_render_text(s), "aaa\nccc\nzzz\nddd")
        # ESC M at the region top scrolls the region down.
        var r = term_feed(term_new(3, 3), "aaa\r\nbbb\r\nccc")
        r = term_feed(r, csi("1;1H") + esc() + "M")
        assert_equal(term_render_text(r), "\naaa\nbbb")


describe "term_feed reads the window title from OSC":
    it "sets the title from OSC 0 and OSC 2 with either terminator":
        step("sets the title from OSC 0 and OSC 2 with either terminator")
        val bel = term_feed(term_new(8, 2), esc() + "]0;agent one\x07" + "hi")
        assert_equal(bel.title, "agent one")
        assert_equal(term_render_text(bel), "hi\n")
        val st = term_feed(term_new(8, 2), esc() + "]2;second" + esc() + "\\" + "ok")
        assert_equal(st.title, "second")
        assert_equal(term_render_text(st), "ok\n")


describe "term_feed consumes what it does not understand":
    it "swallows an unrecognised sequence and counts it, leaving the grid alone":
        step("swallows an unrecognised sequence and counts it, leaving the grid alone")
        val plain = term_feed(term_new(10, 2), "ab")
        val fed = term_feed(plain, csi("?25l") + csi("5X") + esc() + "(B")
        # Nothing leaked into the grid...
        assert_equal(term_render_text(fed), term_render_text(plain))
        assert_equal(fed.cur_col, plain.cur_col)
        # ...but the emulator admits how much it skipped.
        assert_equal(plain.unknown_seqs, 0)
        assert_equal(fed.unknown_seqs, 3)
        # A recognised sequence is NOT counted (discrimination).
        assert_equal(term_feed(plain, csi("31m")).unknown_seqs, 0)

    it "aborts a malformed sequence instead of eating the rest of the stream":
        step("aborts a malformed sequence instead of eating the rest of the stream")
        # The newline inside the CSI is neither a parameter nor a final byte.
        val s = term_feed(term_new(8, 3), csi("12") + "\n" + "ok")
        assert_equal(s.unknown_seqs, 1)
        assert_equal(term_render_text(s), "\nok\n")


describe "term_feed carries an escape sequence split across calls":
    it "produces the same screen as one undivided feed":
        step("produces the same screen as one undivided feed")
        val whole = term_feed(term_new(8, 2), csi("31m") + "Z")
        var split = term_feed(term_new(8, 2), esc() + "[")
        # Mid-sequence: nothing has been drawn or applied yet.
        assert_equal(term_render_text(split), "\n")
        assert_true(split.pending.len() > 0)
        split = term_feed(split, "31m")
        split = term_feed(split, "Z")
        assert_equal(term_render_text(split), term_render_text(whole))
        assert_equal(term_cell_at(split, 0, 0).fg, term_cell_at(whole, 0, 0).fg)
        assert_equal(term_cell_at(split, 0, 0).fg, 1)
        assert_equal(split.unknown_seqs, 0)
        assert_equal(split.pending, "")

    it "splits an OSC title and a bare trailing ESC just as safely":
        step("splits an OSC title and a bare trailing ESC just as safely")
        var s = term_feed(term_new(8, 2), esc() + "]0;pa")
        assert_equal(s.title, "")
        s = term_feed(s, "ne\x07x")
        assert_equal(s.title, "pane")
        assert_equal(term_render_text(s), "x\n")
        # A lone trailing ESC could still be the start of anything.
        var e = term_feed(term_new(8, 2), "a" + esc())
        assert_equal(e.pending, esc())
        e = term_feed(e, "[32mb")
        assert_equal(term_cell_at(e, 1, 0).fg, 2)


describe "term_feed is pure over the screen it is given":
    it "leaves the input screen untouched, including its cells":
        step("leaves the input screen untouched, including its cells")
        val before = term_feed(term_new(6, 2), "ab")
        val snapshot = term_render_text(before)
        val after = term_feed(before, csi("1;1H") + csi("31m") + "ZZ")
        # The new screen changed...
        assert_equal(term_render_text(after), "ZZ\n")
        assert_equal(term_cell_at(after, 0, 0).fg, 1)
        # ...and the old one did not. This is what lets the multiplexer keep
        # one screen per pane without them bleeding into each other.
        assert_equal(term_render_text(before), snapshot)
        assert_equal(term_render_text(before), "ab\n")
        assert_equal(term_cell_at(before, 0, 0).ch, "a")
        assert_equal(term_cell_at(before, 0, 0).fg, -1)
        assert_equal(before.cur_col, 2)


describe "term_resize keeps what still fits":
    it "preserves the overlapping content, styling, title and cursor":
        step("preserves the overlapping content, styling, title and cursor")
        var s = term_feed(term_new(4, 3), esc() + "]2;t\x07" + csi("31m") + "abcdefgh")
        assert_equal(term_render_text(s), "abcd\nefgh\n")
        val wide = term_resize(s, 6, 3)
        assert_equal(wide.cols, 6)
        assert_equal(term_render_text(wide), "abcd\nefgh\n")
        assert_equal(term_cell_at(wide, 0, 0).fg, 1)
        assert_equal(wide.title, "t")
        val narrow = term_resize(s, 2, 1)
        assert_equal(term_render_text(narrow), "ab")
        assert_equal(narrow.cur_col, 1)
        assert_equal(narrow.cur_row, 0)
        # The resized screen keeps writing correctly afterwards.
        assert_equal(term_render_text(term_feed(wide, csi("3;1H") + "zz")), "abcd\nefgh\nzz")
