# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.cbor.major_types.*
use std.common.cbor.types.{make_initial_byte}
use std.common.cbor.decode.{cbor_item_size, cbor_validate}


describe "CBOR item size truncation guards":
    # @manual scenario evidence
    it "rejects truncated integer headers":
        # @req REQ-SSPEC-UNIT
        step("rejects truncated integer headers")
        val encoded = [make_initial_byte(major_unsigned_int(), addl_uint16()), 0]
        assert_equal(cbor_item_size(encoded, 0), 0)
        assert_equal(cbor_validate(encoded), false)

    it "rejects truncated byte string payloads":
        # @req REQ-SSPEC-UNIT
        step("rejects truncated byte string payloads")
        val encoded = [make_initial_byte(major_byte_string(), 2), 0x41]
        assert_equal(cbor_item_size(encoded, 0), 0)
        assert_equal(cbor_validate(encoded), false)

    it "rejects truncated nested arrays":
        # @req REQ-SSPEC-UNIT
        step("rejects truncated nested arrays")
        val encoded = [make_initial_byte(major_array(), 1), make_initial_byte(major_text_string(), 2), 0x41]
        assert_equal(cbor_item_size(encoded, 0), 0)
        assert_equal(cbor_validate(encoded), false)

    it "keeps complete byte strings valid":
        # @req REQ-SSPEC-UNIT
        step("keeps complete byte strings valid")
        val encoded = [make_initial_byte(major_byte_string(), 2), 0x41, 0x42]
        assert_equal(cbor_item_size(encoded, 0), 3)
        assert_equal(cbor_validate(encoded), true)
