# @req: REQ-LIB-COMMON-ENGINE-AUDIO-001

# @req REQ-011 REQ-012 REQ-013 REQ-014
use std.spec.*
use std.common.engine.audio.simple_audio_environment.{
    simple_audio_convolve_reference,
    simple_audio_max_error_ppm,
    check_spatial_audio_parity,
    check_audio_offload_fallback,
    check_simple_audio_backend
}

use std.spec.step

describe "pure-Simple audio offload reference":
    it "computes deterministic finite convolution":
        # @req: REQ-011
        step("Verify: computes deterministic finite convolution")
        val output = simple_audio_convolve_reference([1.0, 2.0], [0.5, 0.25])
        expect(output).to_equal([0.5, 1.25, 0.5])
        expect(simple_audio_convolve_reference([], [1.0])).to_equal([])
        expect(simple_audio_convolve_reference([1.0], [])).to_equal([])

    it "measures exact and malformed candidate parity":
        # @req: REQ-012
        step("Verify: measures exact and malformed candidate parity")
        expect(simple_audio_max_error_ppm([0.0, 1.0], [0.0, 1.0])).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(simple_audio_max_error_ppm([0.0], [0.0, 1.0])).to_equal(1000000)  # oracle: 1000000 — named expected value from the requirement
        expect(check_spatial_audio_parity().max_sample_error_ppm).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps callback and final output CPU owned":
        # @req: REQ-013
        step("Verify: keeps callback and final output CPU owned")
        val result = check_audio_offload_fallback("vulkan")
        expect(result.callback_owned_by_cpu).to_equal(true)
        expect(result.final_output_owned_by_cpu).to_equal(true)
        expect(result.deadline_period_percent).to_equal(60)  # oracle: 60 — named expected value from the requirement

    it "quarantines late work and returns every token on faults":
        # @req: REQ-014
        step("Verify: quarantines late work and returns every token on faults")
        val result = check_audio_offload_fallback("faults")
        expect(result.timeout_fallback).to_equal("cpu-next-period")
        expect(result.device_lost_fallback).to_equal("cpu-next-period")
        expect(result.rejected_fallback).to_equal("cpu-next-period")
        expect(result.queue_full_fallback).to_equal("cpu-next-period")
        expect(result.output_gaps).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.late_results_committed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.live_tokens).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports unbound native capsules honestly":
        # @req: REQ-LIB-COMMON-ENGINE-AUDIO-001
        step("Verify: reports unbound native capsules honestly")
        val linux = check_simple_audio_backend("linux", "pipewire")
        val wrong = check_simple_audio_backend("linux", "wasapi")
        expect(linux.status).to_equal("unavailable")
        expect(linux.owner).to_equal("pure-simple-contract")
        expect(wrong.status).to_equal("unsupported")
