"""
## Purpose and audience
Purpose: Prove that pointer_event_from_window_record — record-to-event mapping.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/engine/interaction/window_event_adapter.spl 80%
"""
# Window-event → interaction-core input transport — conformance spec

**Feature IDs:** N/A (lane L3 / decision D4 of the unified 2D event plan)
**Category:** Stdlib / Engine
**Status:** Implemented
**Requirements:** N/A
**Plan:** doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md
**Design:** N/A
**Research:** N/A

## Overview

Covers the input-transport bridge
(`src/lib/common/engine/interaction/window_event_adapter.spl`): the
normalized scalar `WindowEventRecord` contract (the ring that hosted/
SimpleOS backends and the winit bridge enqueue into) mapped onto the
interaction core's `PointerEvent2D`, including the FIRST consumer of
`WINDOW_EVENT_WHEEL`. Records are injected through the same
`WindowEventLoop.enqueue` path that `SimpleWindowBackend.
inject_window_event` forwards to, drained with `drain_pointer_events`,
and one drained event is routed end-to-end through `hit_stack` +
`event_route.dispatch` to a listener.

## Key Concepts

| Concept | Description |
|---------|-------------|
| Milli-unit contract | `WindowEventRecord` carries `x_milli`/`delta_*_milli`; the adapter divides by 1000 into `PointerEvent2D` whole units |
| Pointer filter | Only POINTER_BUTTON / POINTER_MOVE / WHEEL records map; key, text, focus, resize, close are consumed and discarded |
| POINTER_WHEEL | New `PointerEvent2D` kind (code 8) with additive `delta_x`/`delta_y` fields (0 on every non-wheel event) |
| Unresolved target | Adapter output has `target == -1`; the caller resolves it via `hit_stack` before dispatch |

## Examples

A press record at (50_000, 60_000) milli with button 2 drains as one
POINTER_DOWN at (50, 60) with buttons 2. A wheel record with
`delta_y_milli = -3000` drains as POINTER_WHEEL with `delta_y == -3`.
A key record and a resize record injected between pointer records are
filtered out, leaving only the pointer events in queue order. A drained
POINTER_DOWN whose coords hit a `HitProxy2D` box dispatches through
`event_route.dispatch` and fires the box's listener.
"""

use std.spec.*
use std.common.io.window_event.{
    WindowEventLoop,
    WindowEventRecord,
    window_event_none,
    window_event_key,
    window_event_pointer,
    WINDOW_EVENT_POINTER_MOVE,
    WINDOW_EVENT_POINTER_BUTTON,
    WINDOW_EVENT_WHEEL,
    WINDOW_EVENT_RESIZE,
    WINDOW_ACTION_PRESS,
    WINDOW_ACTION_RELEASE,
    WINDOW_STATUS_OK
}
use std.common.engine.interaction.pointer_event.{
    PointerEvent2D, POINTER_DOWN, POINTER_UP, POINTER_MOVE, POINTER_WHEEL
}
use std.common.engine.interaction.window_event_adapter.{
    WindowPointerMap, pointer_event_from_window_record, drain_pointer_events
}
use std.common.engine.interaction.hit_proxy.{HitProxy2D}
use std.common.engine.interaction.hit_test.{hit_stack}
use std.common.engine.interaction.event_route.{EventListener2D, dispatch, ACTION_NONE}

fn _button_record(handle: i64, seq: i64, action: i64, button: i64, x_milli: i64, y_milli: i64) -> WindowEventRecord:
    var rec = window_event_pointer(handle, seq, 0, WINDOW_EVENT_POINTER_BUTTON, x_milli, y_milli, action, 0)
    rec.key = button
    rec

fn _wheel_record(handle: i64, seq: i64, x_milli: i64, y_milli: i64, delta_x_milli: i64, delta_y_milli: i64) -> WindowEventRecord:
    var rec = window_event_none()
    rec.kind = WINDOW_EVENT_WHEEL
    rec.window_handle = handle
    rec.sequence = seq
    rec.x_milli = x_milli
    rec.y_milli = y_milli
    rec.delta_x_milli = delta_x_milli
    rec.delta_y_milli = delta_y_milli
    rec

fn _resize_record(handle: i64, width: i64, height: i64) -> WindowEventRecord:
    var rec = window_event_none()
    rec.kind = WINDOW_EVENT_RESIZE
    rec.window_handle = handle
    rec.width = width
    rec.height = height
    rec

fn handler_none(e: PointerEvent2D) -> i32:
    ACTION_NONE

describe "pointer_event_from_window_record — record-to-event mapping":

    it "maps a button PRESS record to POINTER_DOWN preserving button id and milli->unit coords":
        # @req: REQ-LIB-COMMON-001
        val rec = _button_record(7, 1, WINDOW_ACTION_PRESS, 2, 50000, 60000)
        val mapped = pointer_event_from_window_record(rec)
        assert_true(mapped.matched)
        expect(mapped.event.kind).to_equal(POINTER_DOWN)
        expect(mapped.event.x).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(mapped.event.y).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(mapped.event.buttons).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(mapped.event.pointer_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        step("target starts unresolved -- hit testing is the caller's job")
        expect(mapped.event.target).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "maps a button RELEASE record to POINTER_UP":
        step("Verify: maps a button RELEASE record to POINTER_UP")
        val rec = _button_record(7, 2, WINDOW_ACTION_RELEASE, 1, 10000, 20000)
        val mapped = pointer_event_from_window_record(rec)
        assert_true(mapped.matched)
        expect(mapped.event.kind).to_equal(POINTER_UP)
        expect(mapped.event.buttons).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "maps a pointer-move record to POINTER_MOVE with zero deltas":
        step("Verify: maps a pointer-move record to POINTER_MOVE with zero deltas")
        val rec = window_event_pointer(7, 3, 0, WINDOW_EVENT_POINTER_MOVE, 15000, 25000, 0, 0)
        val mapped = pointer_event_from_window_record(rec)
        assert_true(mapped.matched)
        expect(mapped.event.kind).to_equal(POINTER_MOVE)
        expect(mapped.event.x).to_equal(15)  # oracle: 15 — named expected value from the requirement
        expect(mapped.event.y).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(mapped.event.delta_x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(mapped.event.delta_y).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "maps a WHEEL record to POINTER_WHEEL preserving signed milli->unit deltas":
        step("WINDOW_EVENT_WHEEL gets its first consumer")
        val rec = _wheel_record(7, 4, 30000, 40000, 2000, -3000)
        val mapped = pointer_event_from_window_record(rec)
        assert_true(mapped.matched)
        expect(mapped.event.kind).to_equal(POINTER_WHEEL)
        expect(mapped.event.x).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(mapped.event.y).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(mapped.event.delta_x).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(mapped.event.delta_y).to_equal(-3)  # oracle: -3 — named expected value from the requirement

    it "does not map key or resize records":
        val key_rec = window_event_key(7, 5, 0, 65, 30, WINDOW_ACTION_PRESS, 0)
        val key_mapped = pointer_event_from_window_record(key_rec)
        expect(key_mapped.matched).to_equal(false)
        val resize_mapped = pointer_event_from_window_record(_resize_record(7, 800, 600))
        expect(resize_mapped.matched).to_equal(false)
        step("the placeholder event carries an unresolved target and must not be dispatched")
        expect(key_mapped.event.target).to_equal(-1)  # oracle: -1 — named expected value from the requirement

describe "drain_pointer_events — ring-to-event-list transport":

    it "drains injected down/move/up/wheel records in queue order and empties the ring":
        var events = WindowEventLoop.create(16, 4)
        expect(events.enqueue(_button_record(9, 1, WINDOW_ACTION_PRESS, 1, 5000, 6000))).to_equal(WINDOW_STATUS_OK)
        expect(events.enqueue(window_event_pointer(9, 2, 0, WINDOW_EVENT_POINTER_MOVE, 7000, 8000, 0, 0))).to_equal(WINDOW_STATUS_OK)
        expect(events.enqueue(_button_record(9, 3, WINDOW_ACTION_RELEASE, 1, 7000, 8000))).to_equal(WINDOW_STATUS_OK)
        expect(events.enqueue(_wheel_record(9, 4, 7000, 8000, 0, -120000))).to_equal(WINDOW_STATUS_OK)

        val drained = drain_pointer_events(events)
        expect(drained.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(drained[0].kind).to_equal(POINTER_DOWN)
        expect(drained[0].x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(drained[0].y).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(drained[0].buttons).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(drained[1].kind).to_equal(POINTER_MOVE)
        expect(drained[1].x).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(drained[2].kind).to_equal(POINTER_UP)
        expect(drained[3].kind).to_equal(POINTER_WHEEL)
        expect(drained[3].delta_y).to_equal(-120)  # oracle: -120 — named expected value from the requirement
        step("the ring is fully consumed")
        expect(events.queued_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "filters key and resize records out of the drained list but still consumes them":
        step("Verify: filters key and resize records out of the drained list but still consumes them")
        var events = WindowEventLoop.create(16, 4)
        expect(events.enqueue(window_event_key(9, 1, 0, 65, 30, WINDOW_ACTION_PRESS, 0))).to_equal(WINDOW_STATUS_OK)
        expect(events.enqueue(_button_record(9, 2, WINDOW_ACTION_PRESS, 1, 5000, 6000))).to_equal(WINDOW_STATUS_OK)
        expect(events.enqueue(_resize_record(9, 800, 600))).to_equal(WINDOW_STATUS_OK)

        val drained = drain_pointer_events(events)
        expect(drained.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(drained[0].kind).to_equal(POINTER_DOWN)
        expect(events.queued_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "an empty ring drains to an empty list":
        step("Verify: an empty ring drains to an empty list")
        var events = WindowEventLoop.create(4, 1)
        val drained = drain_pointer_events(events)
        expect(drained.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "end-to-end — injected record dispatched through the interaction core":

    it "a drained POINTER_DOWN resolves via hit_stack and fires a listener via dispatch":
        step("Inject a press at (50, 50) in milli units")
        var events = WindowEventLoop.create(4, 1)
        expect(events.enqueue(_button_record(1, 1, WINDOW_ACTION_PRESS, 1, 50000, 50000))).to_equal(WINDOW_STATUS_OK)
        val drained = drain_pointer_events(events)
        expect(drained.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        step("Resolve the target with hit_stack over one proxy covering the point")
        val proxy = HitProxy2D.create(900, 0, 0, 100, 100)
        val parents: Dict<i64, i64> = {}
        val hit = hit_stack([proxy], parents, drained[0].x, drained[0].y)
        expect(hit.primary).to_equal(900)  # oracle: 900 — named expected value from the requirement

        step("Dispatch the drained event through event_route to a bubble listener")
        var event = drained[0]
        event.target = hit.primary
        val listeners = [
            EventListener2D.create(900, POINTER_DOWN, false, false, handler_none)
        ]
        val outcome = dispatch(event, listeners, hit.ancestor_path)
        expect(outcome.fired_node_ids.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(outcome.fired_node_ids[0]).to_equal(900)  # oracle: 900 — named expected value from the requirement
        assert_false(outcome.stopped)
