# @cover src/lib/common/engine/interaction/hit_test.spl 80%
# @cover src/lib/common/engine/interaction/event_route.spl 80%
# @cover src/lib/common/engine/interaction/pointer_capture.spl 80%
"""
## Purpose and audience
Executable specification for the shared 2D interaction core
(`src/lib/common/engine/interaction/`): an ordered hit stack whose
paint order equals hit order, full capture -> target -> bubble event
dispatch with stop/immediate-stop semantics, and pointer capture with
hover-path diffing. Audience: maintainers of the engine interaction
stack and authors of later surface adapters (GUI widget, browser DOM,
Node2D) that must sit on this plumbing unchanged.

## Operator workflow
Run the spec from the repo root with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/01_unit/lib/common/engine/interaction/interaction_core_spec.spl
Read the trailing SPEC FILE VERDICT line. A runnable mirror of every
case also lives at `probe_interaction_core.spl` in this directory
(`timeout 300 bin/simple run test/01_unit/lib/common/engine/interaction/probe_interaction_core.spl`);
the probe is the primary evidence artifact when the `simple test`
daemon path is unavailable.

## Compatibility and limitations
This is surface-agnostic plumbing — no GUI widget, browser DOM, or
Node2D adapter is wired yet (that is a later lane); every scenario
here builds `HitProxy2D`/`EventListener2D` fixtures directly. The
paint-order key is `stacking_context_order, render_layer, z_index,
tree_order, insertion_sequence` and drives both paint and hit order.
`PointerPolicy.None` is hit-test pass-through. A `stopImmediate
Propagation` blocks firing on the current node but does not drop the
later listener from registration.

## Verification guidance and troubleshooting
A hit-order failure usually means one field of the flattened paint
key changed precedence — the stacking-context scenario separates the
leading field from z_index deliberately. A dispatch-order failure
shows up in the stamped fired-node sequence: compare it against the
capture(root), capture(mid), target, bubble(mid), bubble(root)
contract before touching the router.
"""

# Lifecycle: doc/01_research/ui/engine2d_gc_tier/analysis_2026-07-25.md ;
# doc/03_plan/ui/unified_2d_engine/unified_2d_interaction_2026-07-20.md ;
# doc/04_architecture/ui/engine_2d.md ;
# doc/05_design/engine2d_four_backend_capture.md

use std.spec.*
use std.common.engine.interaction.hit_proxy.{HitProxy2D, POINTER_POLICY_NONE}
use std.common.engine.interaction.hit_test.{hit_stack, ancestor_path_of}
use std.common.engine.interaction.pointer_event.{PointerEvent2D, POINTER_DOWN}
use std.common.engine.interaction.event_route.{
    EventListener2D, dispatch, ACTION_NONE, ACTION_STOP_PROPAGATION, ACTION_STOP_IMMEDIATE
}
use std.common.engine.interaction.pointer_capture.{PointerRouter, effective_target, hover_diff}

fn _count_i64(arr: [i64], v: i64) -> i32:
    var c = 0
    var i = 0
    while i < arr.len():
        if arr[i] == v:
            c = c + 1
        i = i + 1
    c

fn handler_none(e: PointerEvent2D) -> i32:
    ACTION_NONE

fn handler_stop_propagation(e: PointerEvent2D) -> i32:
    ACTION_STOP_PROPAGATION

fn handler_stop_immediate(e: PointerEvent2D) -> i32:
    ACTION_STOP_IMMEDIATE

# @manual_section: hit-stack

describe "hit_stack — paint-order-ranked hit testing":

    it "the topmost box by paint key wins under overlapping bounds":
        # @req REQ-2DUI-HITTEST-001
        step("Build two full-overlap boxes differing only by z_index")
        var low = HitProxy2D.create(1, 0, 0, 100, 100)
        low.z_index = 0
        var high = HitProxy2D.create(2, 0, 0, 100, 100)
        high.z_index = 5
        val parents: Dict<i64, i64> = {}

        step("Hit-test the shared point")
        val result = hit_stack([low, high], parents, 50, 50)
        # @capture(statistics): primary node id and the ordered hit list
        expect(result.primary).to_equal(2)  # oracle: the higher z_index paints later and wins the point
        expect(result.hits.len()).to_equal(2)  # oracle: both overlapping boxes report a hit
        expect(result.hits[0].node_id).to_equal(2)  # oracle: paint order puts the high box first in the hit list
        expect(result.hits[1].node_id).to_equal(1)  # oracle: the low box trails in paint order

    it "stacking_context_order outranks z_index -- full key precedence, not just the last field":
        # @req REQ-2DUI-HITTEST-002
        step("Build a box with higher stacking_context_order against one with a much higher z_index")
        var a = HitProxy2D.create(10, 0, 0, 100, 100)
        a.stacking_context_order = 1
        a.z_index = 0
        var b = HitProxy2D.create(11, 0, 0, 100, 100)
        b.stacking_context_order = 0
        b.z_index = 999
        val parents: Dict<i64, i64> = {}

        step("Hit-test the shared point and check the leading key field decides")
        val result = hit_stack([a, b], parents, 50, 50)
        # @capture(statistics): the winning node id for the key-precedence pair
        expect(result.primary).to_equal(10)  # oracle: stacking_context_order precedes z_index in the flattened key

    it "PointerPolicy.None passes hit-testing through to the box below":
        # @req REQ-2DUI-HITTEST-003
        step("Cover a normal box with a None-policy box at a huge z_index")
        var top = HitProxy2D.create(20, 0, 0, 100, 100)
        top.z_index = 99
        top.pointer_policy = POINTER_POLICY_NONE
        var below = HitProxy2D.create(21, 0, 0, 100, 100)
        below.z_index = 0
        val parents: Dict<i64, i64> = {}

        step("Hit-test the covered point")
        val result = hit_stack([top, below], parents, 50, 50)
        # @capture(statistics): the resolved primary and hit-list length
        expect(result.primary).to_equal(21)  # oracle: the pass-through box is skipped, so the box below resolves
        expect(result.hits.len()).to_equal(1)  # oracle: the None-policy box never appears in the hit list

    it "a point outside every proxy's bounds hits nothing":
        # @req REQ-2DUI-HITTEST-004
        step("Hit-test a point far outside a small proxy")
        val proxy = HitProxy2D.create(30, 0, 0, 10, 10)
        val parents: Dict<i64, i64> = {}
        val result = hit_stack([proxy], parents, 999, 999)
        # @capture(statistics): the miss sentinel and empty ancestor path
        expect(result.primary).to_equal(-1)  # oracle: no box covers (999, 999), so the miss sentinel is returned
        expect(result.ancestor_path.len()).to_equal(0)  # oracle: a miss carries no ancestor chain

    it "ancestor_path_of walks a child->parent map into root-to-node order":
        # @req REQ-2DUI-HITTEST-005
        step("Link 2->1 and 3->2, then walk the path of node 3")
        var parents: Dict<i64, i64> = {}
        parents[2] = 1
        parents[3] = 2
        val path = ancestor_path_of(parents, 3)
        # @capture(statistics): the root-to-node path order
        expect(path.len()).to_equal(3)  # oracle: node 3 plus two ancestors make a three-node chain
        expect(path[0]).to_equal(1)  # oracle: the root of the chain comes first
        expect(path[1]).to_equal(2)  # oracle: the middle ancestor comes second
        expect(path[2]).to_equal(3)  # oracle: the queried node comes last

# @manual_section: event-dispatch

describe "event_route.dispatch — capture, target, bubble":

    it "fires capture(root), capture(mid), target, bubble(mid), bubble(root) in order":
        # @req REQ-2DUI-ROUTE-001
        step("Register capture and bubble listeners on every node of a 3-node chain")
        val path: [i64] = [100, 101, 102]
        val listeners = [
            EventListener2D.create(100, -1, true, false, handler_none),
            EventListener2D.create(101, -1, true, false, handler_none),
            EventListener2D.create(102, -1, false, false, handler_none),
            EventListener2D.create(101, -1, false, false, handler_none),
            EventListener2D.create(100, -1, false, false, handler_none)
        ]
        val event = PointerEvent2D.create(1, POINTER_DOWN, 5, 5, 1, 102)

        step("Dispatch and check the full phase order")
        val outcome = dispatch(event, listeners, path)
        # @capture(statistics): the fired node-id sequence across both phases
        expect(outcome.fired_node_ids.len()).to_equal(5)  # oracle: five registered listeners all fire once
        expect(outcome.fired_node_ids[0]).to_equal(100)  # oracle: capture phase starts at the root
        expect(outcome.fired_node_ids[1]).to_equal(101)  # oracle: capture phase walks toward the target
        expect(outcome.fired_node_ids[2]).to_equal(102)  # oracle: the target fires between the phases
        expect(outcome.fired_node_ids[3]).to_equal(101)  # oracle: bubble phase walks back through the mid node
        expect(outcome.fired_node_ids[4]).to_equal(100)  # oracle: bubble phase ends at the root
        assert_false(outcome.stopped)

    it "stopPropagation at the target blocks the remaining (bubble) ancestors":
        # @req REQ-2DUI-ROUTE-002
        step("Register a stopPropagation handler on the target of a 3-node chain")
        val path: [i64] = [200, 201, 202]
        val listeners = [
            EventListener2D.create(202, -1, false, false, handler_stop_propagation),
            EventListener2D.create(201, -1, false, false, handler_none),
            EventListener2D.create(200, -1, false, false, handler_none)
        ]
        val event = PointerEvent2D.create(1, POINTER_DOWN, 5, 5, 1, 202)

        step("Dispatch and confirm the bubble ancestors never fire")
        val outcome = dispatch(event, listeners, path)
        # @capture(statistics): fired node count and the stop flags
        expect(outcome.fired_node_ids.len()).to_equal(1)  # oracle: stopPropagation at the target blocks both bubble ancestors
        assert_true(outcome.stopped)
        assert_false(outcome.stopped_immediate)
        assert_true(event.stop_flag)

    it "stopImmediatePropagation blocks a later listener registered on the SAME node":
        # @req REQ-2DUI-ROUTE-003
        step("Register an immediate-stop handler before a normal handler on one node")
        val path: [i64] = [300, 301]
        val listeners = [
            EventListener2D.create(301, -1, false, false, handler_stop_immediate),
            EventListener2D.create(301, -1, false, false, handler_none)
        ]
        val event = PointerEvent2D.create(1, POINTER_DOWN, 5, 5, 1, 301)

        step("Dispatch and check the same-node listener never fires")
        val outcome = dispatch(event, listeners, path)
        # @capture(statistics): per-node fire counts and remaining listener registrations
        expect(_count_i64(outcome.fired_node_ids, 301)).to_equal(1)  # oracle: only the immediate-stop handler fires on node 301
        assert_true(outcome.stopped_immediate)
        step("Confirm the un-fired second listener is NOT dropped -- immediate-stop blocks firing, not registration")
        expect(outcome.remaining_listeners.len()).to_equal(2)  # oracle: both registrations survive, only firing was blocked

    it "a `once` listener fires exactly once and is dropped from the returned listener list":
        # @req REQ-2DUI-ROUTE-004
        step("Register one once-listener on a single-node path")
        val path: [i64] = [400]
        val listeners = [
            EventListener2D.create(400, -1, false, true, handler_none)
        ]
        val event = PointerEvent2D.create(1, POINTER_DOWN, 5, 5, 1, 400)

        step("Dispatch and confirm the listener consumed itself")
        val outcome = dispatch(event, listeners, path)
        # @capture(statistics): fired count and remaining listener count
        expect(outcome.fired_node_ids.len()).to_equal(1)  # oracle: the once-listener fires on this dispatch
        expect(outcome.remaining_listeners.len()).to_equal(0)  # oracle: a fired once-listener is removed from the registry

    it "an empty ancestor_path (nothing hit) is a no-op":
        # @req REQ-2DUI-ROUTE-005
        step("Dispatch an event whose path hit nothing")
        val event = PointerEvent2D.create(1, POINTER_DOWN, 5, 5, 1, -1)
        val listeners = [
            EventListener2D.create(1, -1, false, false, handler_none)
        ]
        val outcome = dispatch(event, listeners, [])
        # @capture(statistics): fired count and surviving listener count
        expect(outcome.fired_node_ids.len()).to_equal(0)  # oracle: an empty path fires nothing
        expect(outcome.remaining_listeners.len()).to_equal(1)  # oracle: a no-op dispatch leaves registrations intact

# @manual_section: pointer-capture

describe "pointer_capture — capture routing and hover diff":

    it "a captured pointer keeps resolving to the capture target outside every proxy's bounds":
        # @req REQ-2DUI-CAPTURE-001
        step("Confirm the far point misses every proxy first")
        val proxy = HitProxy2D.create(500, 0, 0, 10, 10)
        val parents: Dict<i64, i64> = {}
        val far_hit = hit_stack([proxy], parents, 999, 999)
        expect(far_hit.primary).to_equal(-1)  # oracle: the point (999, 999) is outside node 500's box

        step("Capture pointer 1 on node 500 and re-resolve the far point")
        var router = PointerRouter.create()
        router.capture_pointer(1, 500)
        assert_true(router.has_pointer_capture(1, 500))
        # @capture(statistics): effective targets with and without the capture
        expect(effective_target(router, 1, far_hit)).to_equal(500)  # oracle: capture overrides the miss while held

        step("Release the capture and confirm the hit-test primary is used again")
        router.release_pointer(1)
        assert_false(router.has_pointer_capture(1, 500))
        expect(effective_target(router, 1, far_hit)).to_equal(-1)  # oracle: without capture the miss sentinel resolves

    it "an uncaptured pointer resolves to the hit-test primary":
        # @req REQ-2DUI-CAPTURE-002
        step("Hit-test a point inside a proxy with no capture held")
        val proxy = HitProxy2D.create(600, 0, 0, 100, 100)
        val parents: Dict<i64, i64> = {}
        val hit = hit_stack([proxy], parents, 50, 50)
        val router = PointerRouter.create()
        # @capture(statistics): the effective target equal to the hit primary
        expect(effective_target(router, 1, hit)).to_equal(600)  # oracle: with no capture, the hit primary resolves

    it "hover_diff emits entered/left node sets and an over/out primary pair":
        # @req REQ-2DUI-CAPTURE-003
        step("Diff path [1,2,3] against path [1,4,5]")
        val old_path: [i64] = [1, 2, 3]
        val new_path: [i64] = [1, 4, 5]

        val diff = hover_diff(old_path, new_path)
        # @capture(statistics): entered/left sets and the over/out pair
        expect(diff.entered.len()).to_equal(2)  # oracle: nodes 4 and 5 are new to the hover path
        expect(_count_i64(diff.entered, 4)).to_equal(1)  # oracle: node 4 entered exactly once
        expect(_count_i64(diff.entered, 5)).to_equal(1)  # oracle: node 5 entered exactly once
        expect(diff.left.len()).to_equal(2)  # oracle: nodes 2 and 3 left the hover path
        expect(_count_i64(diff.left, 2)).to_equal(1)  # oracle: node 2 left exactly once
        expect(_count_i64(diff.left, 3)).to_equal(1)  # oracle: node 3 left exactly once
        expect(diff.over_target).to_equal(5)  # oracle: the new path's leaf is the over target
        expect(diff.out_target).to_equal(3)  # oracle: the old path's leaf is the out target

    it "hover_diff on an unchanged path emits no enter/leave and no over/out":
        # @req REQ-2DUI-CAPTURE-004
        step("Diff an unchanged hover path against itself")
        val old_path: [i64] = [1, 2, 3]
        val same_path: [i64] = [1, 2, 3]
        val diff = hover_diff(old_path, same_path)
        # @capture(statistics): the empty enter/leave sets and sentinel pair
        expect(diff.entered.len()).to_equal(0)  # oracle: no node entered an unchanged path
        expect(diff.left.len()).to_equal(0)  # oracle: no node left an unchanged path
        expect(diff.over_target).to_equal(-1)  # oracle: no over event without a change
        expect(diff.out_target).to_equal(-1)  # oracle: no out event without a change

    it "PointerRouter tracks pressed_target independently of capture/hover":
        # @req REQ-2DUI-CAPTURE-005
        step("Press, set, and clear a pressed target on pointer 1")
        var router = PointerRouter.create()
        # @capture(statistics): pressed targets at each router state
        expect(router.pressed_target(1)).to_equal(-1)  # oracle: a fresh router has no pressed target
        router.set_pressed(1, 700)
        expect(router.pressed_target(1)).to_equal(700)  # oracle: set_pressed records node 700 for pointer 1
        router.clear_pressed(1)
        expect(router.pressed_target(1)).to_equal(-1)  # oracle: clearing returns to the unset sentinel
