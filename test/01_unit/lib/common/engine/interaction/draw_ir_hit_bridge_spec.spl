"""
## Purpose and audience
Purpose: Prove that draw_ir_hit_forest — DrawIR composition to hit forest.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/engine/interaction/draw_ir_hit_bridge.spl 80%
"""
# DrawIR hit bridge — DrawIR composition to hit forest + group collision

**Feature IDs:** N/A (Lane L1 of the unified 2D event/panel/offload plan)
**Category:** Stdlib / Engine
**Status:** Implemented
**Requirements:** N/A
**Plan:** doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md
**Design:** N/A
**Research:** N/A

## Overview

Covers decisions D2 and D5 of the 2026-07-30 plan: `draw_ir_hit_forest`
lifts a `DrawIrComposition` into the interaction core's `HitProxy2D`
forest (batch = group node from the embedding rect/layer, command with a
present `hit_rect` = leaf node translated into absolute coordinates,
`parent_id`/batch parentage in a child->parent map), and
`group_collisions` reports pairwise AABB overlap over the SAME proxy set.
Node ids are stable 32-bit FNV-1a hashes of component_id text with a
reverse `node_names` map for callers. All bounds follow the core's
half-open convention (left/top inclusive, right/bottom exclusive).

## Key Concepts

| Concept | Description |
|---------|-------------|
| Group node | One per DrawIrBatch: embedding {x,y,w,h} as absolute half-open edges, render_layer = embedding.layer, tree_order = batch index |
| Leaf node | One per DrawIrCommand with a present hit_rect, translated by embedding x/y, parented to its batch (or command parent_id) |
| Clip clamp | embedding.clip = true clamps leaf rects to the batch rect |
| Stable ids | FNV-1a over component_id bytes — same text always hashes to the same i64, never -1 |
| Half-open collision | Rects sharing only an edge do NOT collide, matching contains_point |

## Examples

A taskbar batch at (10, 20) sized 100x50 on layer 3 becomes a group proxy
[10, 110) x [20, 70). A button command inside it with hit_rect (5, 5,
20, 10) becomes a leaf at [15, 35) x [25, 35) whose parent is the batch
group, so `hit_stack` at (16, 26) resolves the leaf with ancestor_path
[group, leaf] and a bubble listener registered on the GROUP fires when
the LEAF is hit — DrawIR content dispatching through the one event core.
"""

use std.spec.*
use std.common.engine.interaction.hit_proxy.{HitProxy2D}
use std.common.engine.interaction.hit_test.{hit_stack}
use std.common.engine.interaction.pointer_event.{PointerEvent2D, POINTER_DOWN}
use std.common.engine.interaction.event_route.{EventListener2D, dispatch, ACTION_NONE}
use std.common.engine.interaction.draw_ir_hit_bridge.{
    DrawIrHitForest, draw_ir_node_id, draw_ir_hit_forest, group_collisions
}
use std.common.ui.draw_ir.{
    DrawIrCommand, draw_ir_composition, draw_ir_batch, draw_ir_embedding_config,
    draw_ir_rect, draw_ir_rect_bounds
}

fn handler_none(e: PointerEvent2D) -> i32:
    ACTION_NONE

fn _find_proxy(proxies: [HitProxy2D], node_id: i64) -> HitProxy2D:
    """Test helper: fetch the proxy for a node id (falls back to the
    first proxy; callers assert on node_id so a miss still fails)."""
    var i = 0
    while i < proxies.len():
        if proxies[i].node_id == node_id:
            return proxies[i]
        i = i + 1
    proxies[0]

fn _rect_command(component_id: text, x: i32, y: i32, w: i32, h: i32, hx: i32, hy: i32, hw: i32, hh: i32) -> DrawIrCommand:
    """Fixture: a rect command carrying a batch-local hit_rect."""
    var cmd = draw_ir_rect(component_id, x, y, w, h, 0xff0000ffu32)
    cmd.hit_rect = draw_ir_rect_bounds(hx, hy, hw, hh)
    cmd

describe "draw_ir_hit_forest — DrawIR composition to hit forest":

    it "a batch becomes a group proxy from its embedding rect and layer":
        # @req: REQ-LIB-COMMON-001
        step("One batch embedded at (10, 20) sized 100x50 on layer 3")
        val emb = draw_ir_embedding_config("surface", "panel", 10, 20, 100, 50, 3, 1000, false)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [])
        ])

        val forest = draw_ir_hit_forest(comp)
        expect(forest.proxies.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val group = forest.proxies[0]
        expect(group.node_id).to_equal(draw_ir_node_id("panel"))
        step("embedding {x,y,w,h} become absolute half-open edges")
        expect(group.left).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(group.top).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(group.right).to_equal(110)  # oracle: 110 — named expected value from the requirement
        expect(group.bottom).to_equal(70)  # oracle: 70 — named expected value from the requirement
        expect(group.render_layer).to_equal(3)  # oracle: 3 — named expected value from the requirement
        step("the reverse map recovers the component_id text")
        assert_true(forest.node_names.contains_key(group.node_id))
        expect(forest.node_names[group.node_id]).to_equal("panel")

    it "a command with a hit_rect becomes a leaf translated by the embedding origin":
        step("Batch at (10, 20); command hit_rect (5, 5, 20, 10) is batch-local")
        val emb = draw_ir_embedding_config("surface", "panel", 10, 20, 100, 50, 0, 1000, false)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [
                _rect_command("btn", 5, 5, 20, 10, 5, 5, 20, 10)
            ])
        ])

        val forest = draw_ir_hit_forest(comp)
        expect(forest.proxies.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val leaf = _find_proxy(forest.proxies, draw_ir_node_id("btn"))
        expect(leaf.node_id).to_equal(draw_ir_node_id("btn"))
        expect(leaf.left).to_equal(15)  # oracle: 15 — named expected value from the requirement
        expect(leaf.top).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(leaf.right).to_equal(35)  # oracle: 35 — named expected value from the requirement
        expect(leaf.bottom).to_equal(35)  # oracle: 35 — named expected value from the requirement
        step("the leaf's parent is its batch group")
        assert_true(forest.parents.contains_key(leaf.node_id))
        expect(forest.parents[leaf.node_id]).to_equal(draw_ir_node_id("panel"))

    it "a command without a hit_rect produces no leaf proxy":
        step("Verify: a command without a hit_rect produces no leaf proxy")
        val emb = draw_ir_embedding_config("surface", "panel", 0, 0, 100, 50, 0, 1000, false)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [
                draw_ir_rect("decor", 5, 5, 20, 10, 0xff0000ffu32)
            ])
        ])
        val forest = draw_ir_hit_forest(comp)
        expect(forest.proxies.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "the parent map ancestor chain feeds hit_stack's ancestor_path":
        step("panel group > row (parent = batch) > btn (parent_id = row)")
        val emb = draw_ir_embedding_config("surface", "panel", 0, 0, 200, 100, 0, 1000, false)
        var row = _rect_command("row", 10, 10, 180, 40, 10, 10, 180, 40)
        var btn = _rect_command("btn", 20, 20, 30, 20, 20, 20, 30, 20)
        btn.parent_id = "row"
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [row, btn])
        ])

        val forest = draw_ir_hit_forest(comp)
        val result = hit_stack(forest.proxies, forest.parents, 25, 25)
        step("the innermost (latest-emitted) leaf wins the hit")
        expect(result.primary).to_equal(draw_ir_node_id("btn"))
        step("ancestor_path is root-to-target: panel, row, btn")
        expect(result.ancestor_path.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(result.ancestor_path[0]).to_equal(draw_ir_node_id("panel"))
        expect(result.ancestor_path[1]).to_equal(draw_ir_node_id("row"))
        expect(result.ancestor_path[2]).to_equal(draw_ir_node_id("btn"))

    it "embedding.clip = true clamps leaf rects to the batch rect":
        step("Batch [10, 110) x [10, 60) with clip; hit_rect overhangs on all sides")
        val emb = draw_ir_embedding_config("surface", "panel", 10, 10, 100, 50, 0, 1000, true)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [
                _rect_command("wide", 0, 0, 500, 500, -20, -20, 500, 500)
            ])
        ])

        val forest = draw_ir_hit_forest(comp)
        val leaf = _find_proxy(forest.proxies, draw_ir_node_id("wide"))
        expect(leaf.left).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(leaf.top).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(leaf.right).to_equal(110)  # oracle: 110 — named expected value from the requirement
        expect(leaf.bottom).to_equal(60)  # oracle: 60 — named expected value from the requirement

    it "without clip the same overhanging leaf keeps its full rect":
        step("Verify: without clip the same overhanging leaf keeps its full rect")
        val emb = draw_ir_embedding_config("surface", "panel", 10, 10, 100, 50, 0, 1000, false)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [
                _rect_command("wide", 0, 0, 500, 500, -20, -20, 500, 500)
            ])
        ])
        val forest = draw_ir_hit_forest(comp)
        val leaf = _find_proxy(forest.proxies, draw_ir_node_id("wide"))
        expect(leaf.left).to_equal(-10)  # oracle: -10 — named expected value from the requirement
        expect(leaf.top).to_equal(-10)  # oracle: -10 — named expected value from the requirement
        expect(leaf.right).to_equal(490)  # oracle: 490 — named expected value from the requirement
        expect(leaf.bottom).to_equal(490)  # oracle: 490 — named expected value from the requirement

    it "node ids are stable across rebuilds and distinct per component_id":
        step("FNV-1a of the same text is the same id in any build")
        expect(draw_ir_node_id("panel")).to_equal(draw_ir_node_id("panel"))
        assert_not_equal(draw_ir_node_id("panel"), draw_ir_node_id("btn"))
        step("pinned vector: fnv1a_32(\"hello\") = 0x4F9F2CAB")
        expect(draw_ir_node_id("hello")).to_equal(1335831723)
        step("ids never collide with the core's -1 nothing-hit sentinel")
        assert_true(draw_ir_node_id("") > 0)

        val emb = draw_ir_embedding_config("surface", "panel", 0, 0, 10, 10, 0, 1000, false)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [])
        ])
        val a = draw_ir_hit_forest(comp)
        val b = draw_ir_hit_forest(comp)
        expect(a.proxies[0].node_id).to_equal(b.proxies[0].node_id)

describe "group_collisions — pairwise AABB overlap over the same proxies":

    it "reports overlap, skips edge-touch (half-open) and disabled proxies":
        step("A [0,10) overlaps B [5,15); C touches A only at x = 10")
        val a = HitProxy2D.create(1, 0, 0, 10, 10)
        val b = HitProxy2D.create(2, 5, 5, 15, 15)
        val c = HitProxy2D.create(3, 10, 0, 20, 10)
        var d = HitProxy2D.create(4, 0, 0, 100, 100)
        d.enabled = false

        val pairs = group_collisions([a, b, c, d])
        step("exactly A-B and B-C collide; the edge-touching A-C pair and the disabled D never do")
        expect(pairs.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pairs[0].0).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pairs[0].1).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pairs[1].0).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pairs[1].1).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "an invisible proxy is skipped even when fully overlapping":
        step("Verify: an invisible proxy is skipped even when fully overlapping")
        val a = HitProxy2D.create(1, 0, 0, 10, 10)
        var phantom = HitProxy2D.create(2, 0, 0, 10, 10)
        phantom.visible = false
        val pairs = group_collisions([a, phantom])
        expect(pairs.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "dispatch integration — DrawIR content through the one event core":

    it "a bubble listener on the batch group fires when a leaf inside it is hit":
        step("Build forest -> hit_stack -> dispatch, listener registered on the GROUP only")
        val emb = draw_ir_embedding_config("surface", "panel", 10, 20, 100, 50, 0, 1000, false)
        val comp = draw_ir_composition("comp", "scene", "host", [
            draw_ir_batch("b0", "host", emb, [
                _rect_command("btn", 5, 5, 20, 10, 5, 5, 20, 10)
            ])
        ])
        val forest = draw_ir_hit_forest(comp)

        val result = hit_stack(forest.proxies, forest.parents, 16, 26)
        val btn_id = draw_ir_node_id("btn")
        val panel_id = draw_ir_node_id("panel")
        expect(result.primary).to_equal(btn_id)

        val listeners = [
            EventListener2D.create(panel_id, -1, false, false, handler_none)
        ]
        val event = PointerEvent2D.create(1, POINTER_DOWN, 16, 26, 1, result.primary)
        val outcome = dispatch(event, listeners, result.ancestor_path)
        step("the group's bubble listener fired for a hit that resolved to the leaf")
        expect(outcome.fired_node_ids.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(outcome.fired_node_ids[0]).to_equal(panel_id)
        assert_false(outcome.stopped)
