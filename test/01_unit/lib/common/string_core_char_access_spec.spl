use common.string_core.{str_char_at}
use std.common.encoding.utf8.{text_is_valid_utf8}

describe "string core char access":
    it "returns characters for valid indexes":
        expect(str_char_at("abc", 0)).to_equal("a")
        expect(str_char_at("abc", 2)).to_equal("c")

    it "returns empty text for invalid indexes":
        expect(str_char_at("abc", -1)).to_equal("")
        expect(str_char_at("abc", 3)).to_equal("")
        expect(str_char_at("", 0)).to_equal("")

    it "returns complete valid UTF-8 scalars instead of byte fragments":
        val value = "Aé한😀"
        expect(str_char_at(value, 0)).to_equal("A")
        expect(str_char_at(value, 1)).to_equal("é")
        expect(str_char_at(value, 2)).to_equal("한")
        expect(str_char_at(value, 3)).to_equal("😀")
        expect(str_char_at(value, 4)).to_equal("")
        expect(text_is_valid_utf8(str_char_at(value, 1))).to_be(true)
        expect(text_is_valid_utf8(str_char_at(value, 2))).to_be(true)
        expect(text_is_valid_utf8(str_char_at(value, 3))).to_be(true)
