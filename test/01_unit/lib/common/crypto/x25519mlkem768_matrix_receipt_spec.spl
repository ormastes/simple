    it "admits non-promotable source rows while final promotion rejects them":
        # @req: REQ-LIB-COMMON-CRYPTO-001
        step("Verify: admits non-promotable source rows while final promotion rejects them")
        step("Bind all public outputs and lifecycle claims as source evidence")
        var rows = _complete_matrix()
        var index: i64 = 0
        while index < rows.len():
            rows[index].execution.promotion_eligible = false
            index = index + 1
        val source = x25519_mlkem768_admit_source_backend_matrix(rows)
        expect(source.status).to_equal(X25519MlKem768EvidenceStatus.Pass)
        expect(source.admitted_rows).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(source.rejected_rows).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(source.row_set_sha256.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        val final_matrix = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(final_matrix.status).to_equal(X25519MlKem768EvidenceStatus.Blocked)
        expect(final_matrix.rows[0].admission_reason).to_equal(
            "row-not-promotion-eligible")

    it "rejects source integrity lifecycle and oracle violations":
        # @req: REQ-008
        step("Verify: rejects source integrity lifecycle and oracle violations")
        step("Reject a promoted source row to preserve the lifecycle boundary")
        var lifecycle = _complete_matrix()
