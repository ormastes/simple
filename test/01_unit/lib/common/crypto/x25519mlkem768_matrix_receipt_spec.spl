"""
## Purpose and audience
Purpose: Verify X25519MLKEM768 backend matrix v2.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
Troubleshooting: a red scenario here means the pinned contract changed —
check verification guidance in the linked design docs before editing oracles.
# @manual: primary
REQ-LIB-COMMON-CRYPTO-001
doc/01_research/local/REQ-LIB-COMMON-CRYPTO-001.md
doc/03_plan/sys_test/REQ-LIB-COMMON-CRYPTO-001.md
doc/04_architecture/REQ-LIB-COMMON-CRYPTO-001.md
doc/05_design/REQ-LIB-COMMON-CRYPTO-001.md
"""
# @req: REQ-LIB-COMMON-CRYPTO-001

# @tag: unit, crypto, x25519mlkem768, matrix, receipts
# @req REQ-008 REQ-009 REQ-010 REQ-012 REQ-015 NFR-009 NFR-017

use std.spec.{describe, it, expect, step, fail}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768RunReceipt}
use lib.common.crypto.x25519_mlkem768.pinned_public_receipt.{
    X25519MlKem768PinnedSet, X25519MlKem768PinnedSetReceipt,
    X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
    X25519_MLKEM768_PINNED_MLKEM_CT_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
    X25519_MLKEM768_PINNED_SERVER_X25519_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
    X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{
    X25519MlKem768MatrixAdmissionPhase,
    X25519MlKem768MatrixRowOutcome,
    X25519MlKem768MatrixOutputComparison,
    X25519MlKem768MatrixRow,
    x25519_mlkem768_admit_full_backend_matrix,
    x25519_mlkem768_admit_source_backend_matrix,
    x25519_mlkem768_render_matrix_receipt}

fn _gpu(backend: X25519MlKem768EvidenceBackend) -> bool:
    backend == X25519MlKem768EvidenceBackend.Cuda or
    backend == X25519MlKem768EvidenceBackend.Vulkan or
    backend == X25519MlKem768EvidenceBackend.Metal

fn _simd(backend: X25519MlKem768EvidenceBackend) -> bool:
    backend == X25519MlKem768EvidenceBackend.Avx2 or
    backend == X25519MlKem768EvidenceBackend.Neon or
    backend == X25519MlKem768EvidenceBackend.Rvv

fn _host_arch(backend: X25519MlKem768EvidenceBackend) -> text:
    if backend == X25519MlKem768EvidenceBackend.Neon or
            backend == X25519MlKem768EvidenceBackend.Metal:
        return "aarch64"
    if backend == X25519MlKem768EvidenceBackend.Rvv: return "riscv64"
    "x86_64"

fn _set_a() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(
        set_id: X25519MlKem768PinnedSet.MlKem,
        first_output_label: "mlkem768-encapsulation-key",
        second_output_label: "mlkem768-ciphertext",
        first_output_bytes: 1184, second_output_bytes: 1088,
        shared_secret_bytes: 32, recovered_secret_bytes: 32,
        first_output_sha256: X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_MLKEM_CT_SHA256)

fn _set_b() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(
        set_id: X25519MlKem768PinnedSet.X25519,
        first_output_label: "x25519-client-public",
        second_output_label: "x25519-server-public",
        first_output_bytes: 32, second_output_bytes: 32,
        shared_secret_bytes: 32, recovered_secret_bytes: 32,
        first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_X25519_SHA256)

fn _set_c() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(
        set_id: X25519MlKem768PinnedSet.Hybrid,
        first_output_label: "x25519mlkem768-client-share",
        second_output_label: "x25519mlkem768-server-share",
        first_output_bytes: 1216, second_output_bytes: 1120,
        shared_secret_bytes: 64, recovered_secret_bytes: 64,
        first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

fn _pass_execution(
        backend: X25519MlKem768EvidenceBackend) -> X25519MlKem768RunReceipt:
    val gpu = _gpu(backend)
    val simd = _simd(backend)
    X25519MlKem768RunReceipt(
        schema: "x25519mlkem768-evidence-v1",
        status: X25519MlKem768EvidenceStatus.Pass,
        reason: "full-operation-pass",
        scope: X25519MlKem768EvidenceScope.FullOperation,
        requested_backend: backend, selected_backend: Some(backend),
        mode: X25519MlKem768EvidenceMode.Native,
        emulated: false, promotion_eligible: true,
        implementation_version: "0.3.0",
        profile_version: "fips203-2024+ecdhe-mlkem-05",
        fixture_id: "mlkem-native-fd58+rfc7748-abc-v1",
        fixture_manifest_sha256: "a" * 64,
        fixture_source_sha256: "b" * 64,
        pinned_workload_sha256: "d" * 64,
        runner_source_sha256: "c" * 64,
        batch_size: 1,
        client_share_bytes: 1216, server_share_bytes: 1120,
        shared_secret_bytes: 64,
        keygen_output_digest: "d" * 64,
        encapsulate_output_digest: "e" * 64,
        decapsulate_output_digest: "e" * 64,
        scalar_roundtrip_match: true, fallback_used: false,
        absolute_oracle_match: true,
        simd_chunk_hits: if simd: 4 else: 0,
        observed_rvv_vlen_bits:
            if backend == X25519MlKem768EvidenceBackend.Rvv: 256 else: 0,
        kernel_invocations: if gpu: 7 else: 0,
        compiled: gpu, submitted: gpu,
        fence_completed: gpu, device_readback: gpu,
        artifact_sha256: if gpu or simd: "f" * 64 else: "",
        device_identity: if gpu: "physical-device"
        elif backend == X25519MlKem768EvidenceBackend.Avx2:
            "native-avx2-candidate"
        elif backend == X25519MlKem768EvidenceBackend.Neon:
            "native-neon-candidate"
        elif backend == X25519MlKem768EvidenceBackend.Rvv:
            "native-rvv-candidate"
        else: "pure-simple-scalar")

fn _pass_row(
        backend: X25519MlKem768EvidenceBackend) -> X25519MlKem768MatrixRow:
    val artifact = if backend == X25519MlKem768EvidenceBackend.ScalarCpu:
        "9" * 64
    else:
        "f" * 64
    X25519MlKem768MatrixRow(
        execution: _pass_execution(backend),
        admission_phase: X25519MlKem768MatrixAdmissionPhase.Executed,
        runner_artifact_sha256: "9" * 64,
        admitted_artifact_sha256: artifact,
        host_os: if backend == X25519MlKem768EvidenceBackend.Metal:
            "macos" else: "linux",
        host_arch: _host_arch(backend),
        pinned_workload_schema: "x25519mlkem768-pinned-workload-v3",
        pinned_oracle_id: "mlkem-native-fd58+rfc7748",
        set_a: Some(_set_a()), set_b: Some(_set_b()), set_c: Some(_set_c()),
        public_wire_bytes: 2336,
        client_share_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        server_share_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

fn _blocked_execution(backend: X25519MlKem768EvidenceBackend,
        reason: text, fixture_admitted: bool) -> X25519MlKem768RunReceipt:
    X25519MlKem768RunReceipt(
        schema: "x25519mlkem768-evidence-v1",
        status: X25519MlKem768EvidenceStatus.Blocked,
        reason: reason, scope: X25519MlKem768EvidenceScope.FullOperation,
        requested_backend: backend, selected_backend: nil,
        mode: X25519MlKem768EvidenceMode.Native,
        emulated: false, promotion_eligible: false,
        implementation_version: "0.3.0",
        profile_version: "fips203-2024+ecdhe-mlkem-05",
        fixture_id: "mlkem-native-fd58+rfc7748-abc-v1",
        fixture_manifest_sha256: if fixture_admitted: "a" * 64 else: "",
        fixture_source_sha256: if fixture_admitted: "b" * 64 else: "",
        pinned_workload_sha256: "",
        runner_source_sha256: if fixture_admitted: "c" * 64 else: "",
        batch_size: 1,
        client_share_bytes: 0, server_share_bytes: 0,
        shared_secret_bytes: 0,
        keygen_output_digest: "", encapsulate_output_digest: "",
        decapsulate_output_digest: "", scalar_roundtrip_match: false,
        fallback_used: false, absolute_oracle_match: false,
        simd_chunk_hits: 0, observed_rvv_vlen_bits: 0,
        kernel_invocations: 0, compiled: false, submitted: false,
        fence_completed: false, device_readback: false,
        artifact_sha256: "", device_identity: "")

fn _blocked_row(backend: X25519MlKem768EvidenceBackend,
        phase: X25519MlKem768MatrixAdmissionPhase,
        reason: text) -> X25519MlKem768MatrixRow:
    val fixture_admitted =
        phase != X25519MlKem768MatrixAdmissionPhase.Requested
    val artifact_admitted =
        phase == X25519MlKem768MatrixAdmissionPhase.ArtifactAdmitted
    X25519MlKem768MatrixRow(
        execution: _blocked_execution(backend, reason, fixture_admitted),
        admission_phase: phase,
        runner_artifact_sha256: if artifact_admitted: "9" * 64 else: "",
        admitted_artifact_sha256: if artifact_admitted: "f" * 64 else: "",
        host_os: if backend == X25519MlKem768EvidenceBackend.Metal:
            "macos" else: "linux",
        host_arch: _host_arch(backend),
        pinned_workload_schema: "", pinned_oracle_id: "",
        set_a: nil, set_b: nil, set_c: nil,
        public_wire_bytes: 0,
        client_share_sha256: "", server_share_sha256: "")

fn _complete_matrix() -> [X25519MlKem768MatrixRow]:
    [
        _pass_row(X25519MlKem768EvidenceBackend.ScalarCpu),
        _pass_row(X25519MlKem768EvidenceBackend.Avx2),
        _pass_row(X25519MlKem768EvidenceBackend.Neon),
        _pass_row(X25519MlKem768EvidenceBackend.Rvv),
        _pass_row(X25519MlKem768EvidenceBackend.Cuda),
        _pass_row(X25519MlKem768EvidenceBackend.Vulkan),
        _pass_row(X25519MlKem768EvidenceBackend.Metal)
    ]

describe "X25519MLKEM768 backend matrix v2":
    it "admits seven typed native rows and hashes canonical backend order":
        # @req: REQ-008
        step("Verify: admits seven typed native rows and hashes canonical backend order")
        step("Admit synthetic branch-test rows with typed public receipts")
        val receipt = x25519_mlkem768_admit_full_backend_matrix(
            _complete_matrix())
        expect(receipt.status).to_equal(X25519MlKem768EvidenceStatus.Pass)
        expect(receipt.admitted_rows).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(receipt.matching_output_rows).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(receipt.blocked_rows).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(receipt.failed_rows).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(receipt.rejected_rows).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(receipt.fixture_admitted_rows).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(receipt.artifact_admitted_rows).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(receipt.executed_rows).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(receipt.public_wire_bytes).to_equal(2336)  # oracle: 2336 — named expected value from the requirement
        expect(receipt.row_set_sha256.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        val rows = _complete_matrix()
        val permuted = [rows[6], rows[2], rows[4], rows[0],
            rows[5], rows[1], rows[3]]
        val reordered = x25519_mlkem768_admit_full_backend_matrix(permuted)
        expect(reordered.row_set_sha256).to_equal(receipt.row_set_sha256)

    it "retains simultaneous Vulkan and Metal blockers without scalar outputs":
        # @req: REQ-009
        step("Verify: retains simultaneous Vulkan and Metal blockers without scalar outputs")
        step("Retain artifact-admitted Vulkan and requested-only Metal")
        var rows = _complete_matrix()
        rows[5] = _blocked_row(X25519MlKem768EvidenceBackend.Vulkan,
            X25519MlKem768MatrixAdmissionPhase.ArtifactAdmitted,
            "vulkan-runtime-device-capability-binding-unavailable")
        rows[6] = _blocked_row(X25519MlKem768EvidenceBackend.Metal,
            X25519MlKem768MatrixAdmissionPhase.Requested,
            "metal-binary-digest-not-pinned-by-fixture-manifest")
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.status).to_equal(X25519MlKem768EvidenceStatus.Blocked)
        expect(receipt.admitted_rows).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(receipt.blocked_rows).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(receipt.matching_output_rows).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(receipt.rows[5].source_reason).to_equal(
            "vulkan-runtime-device-capability-binding-unavailable")
        expect(receipt.rows[6].source_reason).to_equal(
            "metal-binary-digest-not-pinned-by-fixture-manifest")
        expect(receipt.rows[5].output_comparison).to_equal(
            X25519MlKem768MatrixOutputComparison.NotAvailable)
        expect(receipt.rows[6].source.client_share_sha256).to_equal("")
        val rendered = x25519_mlkem768_render_matrix_receipt(receipt)
        expect(rendered).to_contain(
            "row.vulkan.outcome=blocked")
        expect(rendered).to_contain(
            "row.metal.outcome=blocked")
        expect(rendered).to_contain(
            "row.metal.client_share_sha256=\n")

    it "rejects requested-only rows that smuggle fixture or output claims":
        # @req: REQ-010
        step("Verify: rejects requested-only rows that smuggle fixture or output claims")
        step("Mutate requested-only Metal with an unadmitted public digest")
        var rows = _complete_matrix()
        var metal = _blocked_row(X25519MlKem768EvidenceBackend.Metal,
            X25519MlKem768MatrixAdmissionPhase.Requested,
            "metal-binary-digest-not-pinned-by-fixture-manifest")
        metal.client_share_sha256 = "d" * 64
        rows[6] = metal
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.rows[6].outcome).to_equal(
            X25519MlKem768MatrixRowOutcome.Rejected)
        expect(receipt.rows[6].admission_reason).to_equal(
            "requested-row-carries-unadmitted-claims")

    it "rejects output and vector-proof claims before execution":
        # @req: REQ-012
        step("Verify: rejects output and vector-proof claims before execution")
        step("Attach public Set A to fixture-admitted AVX2")
        var fixture_rows = _complete_matrix()
        var fixture_only = _blocked_row(
            X25519MlKem768EvidenceBackend.Avx2,
            X25519MlKem768MatrixAdmissionPhase.FixtureAdmitted,
            "avx2-runner-artifact-not-admitted")
        fixture_only.set_a = Some(_set_a())
        fixture_rows[1] = fixture_only
        val fixture_receipt = x25519_mlkem768_admit_full_backend_matrix(
            fixture_rows)
        expect(fixture_receipt.rows[1].admission_reason).to_equal(
            "fixture-admitted-row-state-invalid")
        step("Attach RVV execution proof to artifact-admitted RVV")
        var artifact_rows = _complete_matrix()
        var artifact_only = _blocked_row(
            X25519MlKem768EvidenceBackend.Rvv,
            X25519MlKem768MatrixAdmissionPhase.ArtifactAdmitted,
            "rvv-native-run-not-started")
        artifact_only.execution.observed_rvv_vlen_bits = 256
        artifact_rows[3] = artifact_only
        val artifact_receipt = x25519_mlkem768_admit_full_backend_matrix(
            artifact_rows)
        expect(artifact_receipt.rows[3].admission_reason).to_equal(
            "artifact-admitted-row-state-invalid")

    it "binds runner source and rejects malformed artifact provenance":
        # @req: REQ-015
        step("Verify: binds runner source and rejects malformed artifact provenance")
        step("Change the NEON runner source under an otherwise matching row")
        var mismatch_rows = _complete_matrix()
        mismatch_rows[2].execution.runner_source_sha256 = "8" * 64
        val mismatch = x25519_mlkem768_admit_full_backend_matrix(mismatch_rows)
        expect(mismatch.rows[2].admission_reason).to_equal(
            "fixture-or-configuration-mismatch")
        step("Reject uppercase non-canonical CUDA runner artifact SHA-256")
        var malformed_rows = _complete_matrix()
        malformed_rows[4].runner_artifact_sha256 = "A" * 64
        val malformed = x25519_mlkem768_admit_full_backend_matrix(
            malformed_rows)
        expect(malformed.rows[4].admission_reason).to_equal(
            "artifact-provenance-sha256-invalid")
        expect(malformed.artifact_admitted_rows).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(malformed.executed_rows).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "marks only the independently mutated public Set row mismatched":
        # @req: REQ-LIB-COMMON-CRYPTO-001
        step("Verify: marks only the independently mutated public Set row mismatched")
        step("Change RVV Set B while preserving its internal typed shape")
        var rows = _complete_matrix()
        var changed_b = _set_b()
        changed_b.first_output_sha256 = "8" * 64
        rows[3].set_b = Some(changed_b)
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.rows[3].outcome).to_equal(
            X25519MlKem768MatrixRowOutcome.Rejected)
        expect(receipt.rows[3].output_comparison).to_equal(
            X25519MlKem768MatrixOutputComparison.Mismatch)
        expect(receipt.rows[2].outcome).to_equal(
            X25519MlKem768MatrixRowOutcome.Admitted)
        expect(receipt.matching_output_rows).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "keeps execution failures and QEMU rejections as separate rows":
        # @req: REQ-008
        step("Verify: keeps execution failures and QEMU rejections as separate rows")
        step("Retain CUDA failure while independently rejecting emulated NEON")
        var rows = _complete_matrix()
        rows[2].execution.mode = X25519MlKem768EvidenceMode.QemuCorrectness
        rows[2].execution.emulated = true
        rows[4].execution.status = X25519MlKem768EvidenceStatus.Fail
        rows[4].execution.reason = "cuda-device-lost"
        rows[4].execution.promotion_eligible = false
        rows[4].pinned_workload_schema = ""
        rows[4].pinned_oracle_id = ""
        rows[4].set_a = nil
        rows[4].set_b = nil
        rows[4].set_c = nil
        rows[4].public_wire_bytes = 0
        rows[4].client_share_sha256 = ""
        rows[4].server_share_sha256 = ""
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.status).to_equal(X25519MlKem768EvidenceStatus.Fail)
        expect(receipt.failed_rows).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(receipt.rejected_rows).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(receipt.rows[2].admission_reason).to_equal(
            "native-execution-missing")
        expect(receipt.rows[4].source_reason).to_equal("cuda-device-lost")

    it "does not classify an unstarted declared failure as executed":
        # @req: REQ-009
        step("Verify: does not classify an unstarted declared failure as executed")
        step("Remove CUDA selection and submission from a declared failure")
        var rows = _complete_matrix()
        rows[4].execution.status = X25519MlKem768EvidenceStatus.Fail
        rows[4].execution.reason = "cuda-device-lost"
        rows[4].execution.promotion_eligible = false
        rows[4].execution.selected_backend = nil
        rows[4].execution.submitted = false
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.rows[4].outcome).to_equal(
            X25519MlKem768MatrixRowOutcome.Rejected)
        expect(receipt.rows[4].admission_reason).to_equal(
            "fallback-or-selection-mismatch")
        expect(receipt.executed_rows).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "rejects newline injection and impossible backend host identity":
        # @req: REQ-010
        step("Verify: rejects newline injection and impossible backend host identity")
        step("Inject a second rendered key through the Vulkan reason")
        var injected_rows = _complete_matrix()
        injected_rows[5].execution.reason = "pass\nstatus=pass"
        val injected = x25519_mlkem768_admit_full_backend_matrix(injected_rows)
        expect(injected.rows[5].admission_reason).to_equal(
            "receipt-text-field-invalid")
        step("Claim native NEON execution on x86-64")
        var host_rows = _complete_matrix()
        host_rows[2].host_arch = "x86_64"
        val host = x25519_mlkem768_admit_full_backend_matrix(host_rows)
        expect(host.rows[2].admission_reason).to_equal(
            "neon-host-architecture-mismatch")

    it "changes canonical hash on evidence mutation and redacts secret digests":
        # @req: REQ-012
        step("Verify: changes canonical hash on evidence mutation and redacts secret digests")
        step("Bind device identity and source reason into canonical row material")
        val baseline = x25519_mlkem768_admit_full_backend_matrix(
            _complete_matrix())
        var rows = _complete_matrix()
        rows[4].execution.device_identity = "different-physical-device"
        val changed = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(changed.row_set_sha256 == baseline.row_set_sha256).to_be(false)
        val rendered = x25519_mlkem768_render_matrix_receipt(changed)
        expect(rendered.contains("shared_secret_sha256")).to_be(false)
        expect(rendered.contains("mlkem_shared_sha256")).to_be(false)

    it "rejects seven mutually agreeing rows when the scalar oracle is fabricated":
        # @req: REQ-015
        step("Verify: rejects seven mutually agreeing rows when the scalar oracle is fabricated")
        step("Replace canonical Set A in every row with one shared fake digest")
        var rows = _complete_matrix()
        var index: i64 = 0
        while index < rows.len():
            var fabricated = _set_a()
            fabricated.first_output_sha256 = "7" * 64
            rows[index].set_a = Some(fabricated)
            index = index + 1
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.status).to_equal(X25519MlKem768EvidenceStatus.Blocked)
        expect(receipt.rows[0].admission_reason).to_equal(
            "set-a-set-public-output-oracle-mismatch")
        expect(receipt.admitted_rows).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects semantic label drift even when public lengths and hashes match":
        # @req: REQ-LIB-COMMON-CRYPTO-001
        step("Verify: rejects semantic label drift even when public lengths and hashes match")
        step("Change the AVX2 Set B output label only")
        var rows = _complete_matrix()
        var changed_b = _set_b()
        changed_b.first_output_label = "unbound-public-value"
        rows[1].set_b = Some(changed_b)
        val receipt = x25519_mlkem768_admit_full_backend_matrix(rows)
        expect(receipt.rows[1].outcome).to_equal(
            X25519MlKem768MatrixRowOutcome.Rejected)
        expect(receipt.rows[1].admission_reason).to_equal(
            "set-b-set-public-output-label-mismatch")

    it "retains valid fixture-only and artifact-only blocked phases":
