# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# HKDF-Expand max-output bound (RFC 5869: L <= 255 * HashLen) incl. near-wraparound L.

use std.spec.step
use std.spec.{describe, it, expect}
use std.common.crypto.hkdf.{hkdf_expand_sha256, hkdf_expand_sha1, hkdf_expand_sha384}

fn prk32() -> [i64]:
    var p: [i64] = []
    var i = 0
    while i < 32:
        p.push(i)
        i = i + 1
    p

describe "HKDF-Expand output length bounds":
    it "sha256 emits exactly 255*32 bytes at the RFC maximum":
        # @req REQ-SSPEC-LIB
        step("expand to L = 8160")
        expect(hkdf_expand_sha256(prk32(), [], 8160).len()).to_equal(8160)

    it "sha256 refuses one byte past the RFC maximum":
        # @req REQ-SSPEC-LIB
        step("expand to L = 8161")
        expect(hkdf_expand_sha256(prk32(), [], 8161).len()).to_equal(0)

    it "a near-i64-max length is refused without iterating":
        # @req REQ-SSPEC-LIB
        step("expand sha256/sha1/sha384 to L = 0x7FFFFFFFFFFFFFFF")
        expect(hkdf_expand_sha256(prk32(), [], 0x7FFFFFFFFFFFFFFF).len()).to_equal(0)
        expect(hkdf_expand_sha1(prk32(), [], 0x7FFFFFFFFFFFFFFF).len()).to_equal(0)
        expect(hkdf_expand_sha384(prk32(), [], 0x7FFFFFFFFFFFFFFF).len()).to_equal(0)

    it "a negative length yields no output":
        # @req REQ-SSPEC-LIB
        step("expand to L = -1")
        expect(hkdf_expand_sha256(prk32(), [], -1).len()).to_equal(0)

    it "sha1 refuses one byte past 255*20":
        # @req REQ-SSPEC-LIB
        step("expand sha1 to L = 5101")
        expect(hkdf_expand_sha1(prk32(), [], 5101).len()).to_equal(0)
