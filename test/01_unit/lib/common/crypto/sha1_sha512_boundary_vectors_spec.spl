describe "SHA-1 boundary vectors":
    it "matches every boundary length through the list and u8 APIs":
        var k = 0
        while k < LENGTHS.len():
            val n = LENGTHS[k]
            expect(bytes_to_hex(sha1_bytes(pattern_list(n)))).to_equal(SHA1[k])
            expect(sha1_u8_hex(pattern_u8(n))).to_equal(SHA1[k])
            k = k + 1

    it "matches the FIPS 180-4 text vectors":
        expect(sha1_hex("")).to_equal("da39a3ee5e6b4b0d3255bfef95601890afd80709")
        expect(sha1_hex("abc")).to_equal("a9993e364706816aba3e25717850c26c9cd0d89d")
        expect(sha1_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")).to_equal("84983e441c3bd26ebaae4aa1f95129e5e54670f1")
        expect(sha1_hex_upper("abc")).to_equal("A9993E364706816ABA3E25717850C26C9CD0D89D")

    it "tuple streaming equals one-shot for every split":
        for n in [0, 1, 55, 56, 64, 65, 129]:
            val data = pattern_list(n)
            for cut in [0, 1, 32, 55, 64]:
                val c = if cut < n: cut else: n
                var head: [i64] = []
                var tail: [i64] = []
                var i = 0
                while i < n:
                    if i < c:
                        head.push(data[i])
                    else:
                        tail.push(data[i])
                    i = i + 1
                val ctx = sha1_tuple_update(sha1_tuple_update(sha1_init(), head), tail)
                expect(bytes_to_hex(sha1_tuple_final(ctx))).to_equal(bytes_to_hex(sha1_bytes(data)))
        val dirty = sha1_tuple_update(sha1_init(), pattern_list(9))
        expect(bytes_to_hex(sha1_tuple_final(sha1_reset(dirty)))).to_equal("da39a3ee5e6b4b0d3255bfef95601890afd80709")

    it "x4 lanes equal four scalar digests (single-block SIMD path)":
        val m0 = pattern_list(0)
        val m1 = pattern_list(3)
        val m2 = pattern_list(55)
        val m3 = pattern_list(1)
        val (d0, d1, d2, d3) = sha1_x4_message(m0, m1, m2, m3)
        expect(sha1_digest_to_hex(d0)).to_equal(SHA1[0])
        expect(sha1_digest_to_hex(d1)).to_equal(SHA1[2])
        expect(sha1_digest_to_hex(d2)).to_equal(SHA1[3])
        expect(sha1_digest_to_hex(d3)).to_equal(SHA1[1])
        val (e0, e1, e2, e3) = sha1_x4(sha1_pad_message(m0), sha1_pad_message(m1), sha1_pad_message(m2), sha1_pad_message(m3))
        expect(sha1_digest_to_hex(e0) + sha1_digest_to_hex(e1) + sha1_digest_to_hex(e2) + sha1_digest_to_hex(e3)).to_equal(SHA1[0] + SHA1[2] + SHA1[3] + SHA1[1])

    it "x4 falls back to scalar when any lane needs two blocks":
        val short = pattern_list(3)
        val long = pattern_list(56)
        # One multi-block lane in each position flips one condition at a time.
        var lane = 0
        while lane < 4:
            val m0 = if lane == 0: long else: short
            val m1 = if lane == 1: long else: short
            val m2 = if lane == 2: long else: short
            val m3 = if lane == 3: long else: short
            val (d0, d1, d2, d3) = sha1_x4_message(m0, m1, m2, m3)
            val got = [sha1_digest_to_hex(d0), sha1_digest_to_hex(d1), sha1_digest_to_hex(d2), sha1_digest_to_hex(d3)]
            var j = 0
            while j < 4:
                val want = if j == lane: SHA1[4] else: SHA1[2]
                expect(got[j]).to_equal(want)
                j = j + 1
            lane = lane + 1

describe "SHA-512 family boundary vectors":
    it "matches SHA-512, SHA-384 and SHA-512/256 at every boundary length":
        var k = 0
        while k < LENGTHS.len():
            val data = pattern_list(LENGTHS[k])
            expect(bytes_to_hex(sha512_bytes(data))).to_equal(SHA512[k])
            expect(bytes_to_hex(sha384_bytes(data))).to_equal(SHA384[k])
            expect(bytes_to_hex(sha512_256_bytes(data))).to_equal(SHA512_256[k])
            k = k + 1

    it "matches the FIPS 180-4 text vectors":
        expect(sha512_text("abc")).to_equal("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
        expect(sha384_text("abc")).to_equal("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
        expect(sha512_256_text("abc")).to_equal("53048e2681941ef99b2e29b76b4c7dabe4c2d0c634fc6d46e0e2f13107e7af23")

    it "keeps the logical-shift helper contract at its edges":
        val neg = -81985529216486896
        expect(_lshr64(neg, 0)).to_equal(neg)
        expect(_lshr64(neg, -3)).to_equal(neg)
        expect(_lshr64(neg, 64)).to_equal(0)
        expect(_lshr64(neg, 100)).to_equal(0)
        expect(_lshr64(-1, 63)).to_equal(1)
        expect(_lshr64(256, 4)).to_equal(16)
        expect(_rotr64(neg, 0)).to_equal(neg)
        expect(_rotr64(neg, 64)).to_equal(neg)
        expect(_rotr64(1, 1)).to_equal(-9223372036854775807 - 1)
