"""SHA-1 and SHA-2/512-family boundary vectors (FIPS 180-4).

Messages are bytes `i % 251` (i = 0..n-1) at the 64-byte (SHA-1) and
128-byte (SHA-512) padding boundaries; expected digests from CPython
hashlib (OpenSSL). Covers the scalar SHA-1 list API, its u8 / text / tuple
streaming entry points and the Vec4i x4 lanes (single-block SIMD path and
the multi-block scalar fallback), plus SHA-512, SHA-384 and SHA-512/256.
"""
# @req REQ-SSPEC-LIB

use std.spec.*
use std.common.crypto.sha1.{
    sha1_bytes, sha1_u8_hex, sha1_hex, sha1_hex_upper, sha1_init, sha1_tuple_update,
    sha1_tuple_final, sha1_reset, sha1_x4, sha1_x4_message, sha1_pad_message,
    sha1_digest_to_hex
}
use std.common.crypto.sha512.{
    sha512_bytes, sha384_bytes, sha512_256_bytes, sha512_text, sha384_text,
    sha512_256_text, _lshr64, _rotr64
}
use std.common.crypto.types.{bytes_to_hex}

fn pattern_list(n: i64) -> [i64]:
    var out: [i64] = [0; n]
    var i = 0
    while i < n:
        out[i] = i % 251
        i = i + 1
    out

fn pattern_u8(n: i64) -> [u8]:
    var out: [u8] = [0u8; n]
    var i = 0
    while i < n:
        out[i] = (i % 251).to_u8()
        i = i + 1
    out

val LENGTHS: [i64] = [0, 1, 3, 55, 56, 63, 64, 65, 111, 112, 119, 120, 127, 128, 129, 200]
