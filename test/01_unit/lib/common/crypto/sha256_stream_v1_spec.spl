"""Partition invariance contracts for allocation-bounded incremental SHA-256."""

use std.spec.*
use std.common.crypto.sha256.{
    sha256_stream_v1_new, sha256_stream_v1_update, sha256_stream_v1_finish_hex
}

fn stream_digest(parts: [[u8]]) -> text:
    val stream = sha256_stream_v1_new()
    for part in parts:
        expect(sha256_stream_v1_update(stream, part)).to_be(true)
    sha256_stream_v1_finish_hex(stream).unwrap()

describe "SHA-256 stream block update contract":
    it "preserves empty and complementary partial-block partitions":
        expect(stream_digest([[]])).to_equal(
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
        val bytes: [u8] = [97u8; 64]
        val direct = stream_digest([bytes])
        expect(stream_digest([[97u8; 63], [97u8]])).to_equal(direct)
        expect(stream_digest([[97u8], [97u8; 63]])).to_equal(direct)

    it "preserves full-block plus tail and multi-block partitions":
        val bytes: [u8] = [97u8; 129]
        val direct = stream_digest([bytes])
        expect(stream_digest([[97u8; 64], [97u8; 65]])).to_equal(direct)
        expect(stream_digest([[97u8; 128], [97u8]])).to_equal(direct)
        expect(stream_digest([[97u8; 31], [97u8; 64], [97u8; 34]])).to_equal(direct)
