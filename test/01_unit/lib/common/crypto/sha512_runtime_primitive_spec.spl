# Purpose and audience: runtime SHA-384/512 primitive (rt_sha384_digest / rt_sha512_digest) must match FIPS 180-4 NIST vectors and the pure-Simple std.common.crypto.sha512 byte-for-byte.
# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/2026-10-19_pbkdf2_sha384_sha512_no_runtime_primitive.md

use std.spec.step
use std.spipe.*
use std.nogc_sync_mut.sffi.host.{sha384_digest, sha512_digest}
use std.common.crypto.sha512.{sha384_bytes, sha512_bytes}
use std.crypto.types.{bytes_to_hex}

fn _u8(s: text) -> [u8]:
    var out: [u8] = []
    for c in s.bytes():
        out.push(c as u8)
    out

fn _i64(s: text) -> [i64]:
    var out: [i64] = []
    for c in s.bytes():
        out.push(c as i64)
    out

fn _hex(d: [u8]) -> text:
    var out: [i64] = []
    var i: i64 = 0
    while i < d.len():
        out.push(d[i] as i64)
        i = i + 1
    bytes_to_hex(out)

fn _repeat_a(n: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < n:
        out.push(0x61 as u8)
        i = i + 1
    out

fn _pattern(n: i64) -> [i64]:
    var out: [i64] = []
    var i: i64 = 0
    while i < n:
        out.push((i * 37 + 11) & 255)
        i = i + 1
    out

fn _to_u8(b: [i64]) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < b.len():
        out.push(b[i] as u8)
        i = i + 1
    out

val _MSG896 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"

describe "rt_sha512_digest NIST FIPS 180-4 vectors":
    it "empty message":
        step("SHA-512 empty")
        expect(_hex(sha512_digest(_u8("")))).to_equal(
            "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")

    it "abc":
        step("SHA-512 abc")
        expect(_hex(sha512_digest(_u8("abc")))).to_equal(
            "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

    it "896-bit message":
        step("SHA-512 896-bit")
        expect(_hex(sha512_digest(_u8(_MSG896)))).to_equal(
            "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")

    it "one million 'a'":
        step("SHA-512 1M a")
        expect(_hex(sha512_digest(_repeat_a(1000000)))).to_equal(
            "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")

describe "rt_sha384_digest NIST FIPS 180-4 vectors":
    it "empty message":
        step("SHA-384 empty")
        expect(_hex(sha384_digest(_u8("")))).to_equal(
            "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")

    it "abc":
        step("SHA-384 abc")
        expect(_hex(sha384_digest(_u8("abc")))).to_equal(
            "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")

    it "896-bit message":
        step("SHA-384 896-bit")
        expect(_hex(sha384_digest(_u8(_MSG896)))).to_equal(
            "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")

describe "runtime SHA-384/512 equal the pure-Simple twin":
    it "NIST messages byte-for-byte":
        step("pure vs runtime on NIST messages")
        for m in ["", "abc", _MSG896]:
            expect(_hex(sha512_digest(_u8(m)))).to_equal(bytes_to_hex(sha512_bytes(_i64(m))))
            expect(_hex(sha384_digest(_u8(m)))).to_equal(bytes_to_hex(sha384_bytes(_i64(m))))

    it "padding boundaries around the 128-byte block":
        step("lengths 111 112 127 128 129 239 240 256")
        for n in [111, 112, 127, 128, 129, 239, 240, 256]:
            val msg = _pattern(n)
            expect(_hex(sha512_digest(_to_u8(msg)))).to_equal(bytes_to_hex(sha512_bytes(msg)))
            expect(_hex(sha384_digest(_to_u8(msg)))).to_equal(bytes_to_hex(sha384_bytes(msg)))
