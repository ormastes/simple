use std.spec.{describe, it, assert_equal}
use std.crypto.types.{bytes_to_hex}

# bytes_to_hex takes [u8] (owner decision 2026-11-27), so out-of-range
# elements cannot be represented and the old "" rejection contract is gone.
describe "crypto bytes_to_hex guards":
    it "keeps valid byte formatting":
        val b: [u8] = [0u8, 15u8, 16u8, 255u8]
        assert_equal(bytes_to_hex(b), "000f10ff")

    it "returns empty text for empty input":
        val b: [u8] = []
        assert_equal(bytes_to_hex(b), "")

    it "formats high bytes without sign extension":
        val b: [u8] = [128u8, 200u8, 254u8]
        assert_equal(bytes_to_hex(b), "80c8fe")
