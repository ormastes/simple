"""
## Purpose and audience
Purpose: Keep SHA-256 text conversion on the canonical string-core SFFI owner.
Audience: crypto, runtime, and SFFI maintainers.
"""

use std.spec.{describe, it, expect, expect_not}
use std.io_runtime.{file_read}

describe "SHA-256 text SFFI ownership":
    """Proves canonical raw ownership, lexical authority, and bounded hex lifting."""
    it "keeps text conversion in the canonical string-core owner":
        val sha = file_read("src/lib/common/crypto/sha256.spl")
        val types = file_read("src/lib/common/crypto/types.spl")
        expect(sha).to_contain("text_to_bytes as string_core_text_to_bytes")
        expect_not(sha.contains("extern fn rt_text_to_bytes("))
        expect_not(types.contains("extern fn rt_text_to_bytes("))
        expect_not(types.contains("extern fn rt_bytes_to_text("))
        expect(types).to_contain("string_core_text_to_bytes(s)")

    it "keeps one fail-closed accelerated digest call":
        val sha = file_read("src/lib/common/crypto/sha256.spl")
        val mentions = sha.split("rt_tls13_sha256(raw)").len() - 1
        expect(mentions).to_equal(1)
        expect(sha).to_contain("a non-32-byte result is the unsupported or provider-failure sentinel")
        expect(sha).to_contain("unsafe(capabilities: [ffi]):")
        expect(sha).to_contain("if digest.len() != 32u64:")
        expect(sha).to_contain("return sha256_u8_hex(raw)")
        expect(sha).to_contain("var out: [text] = [\"\"; 64]")
        expect(sha).to_contain("var result: [text] = [\"\"; 64]")
        expect_not(sha.contains("out = out +"))
        expect_not(sha.contains("result = result +"))

    it "keeps raw text-byte calls lexically scoped in string core":
        val owner = file_read("src/lib/common/string_core.spl")
        expect(owner).to_contain("raw UTF-8 byte lift")
        expect(owner).to_contain("raw UTF-8 text lift")
        expect(owner).to_contain("pub fn text_to_bytes(s: text) -> [u8]:")
        expect(owner).to_contain("pub fn bytes_to_text(bytes: [u8]) -> text:")
        expect(owner).to_contain("unsafe(capabilities: [ffi]):")
