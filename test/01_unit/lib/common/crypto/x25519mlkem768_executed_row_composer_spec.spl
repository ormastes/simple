# @req: REQ-LIB-COMMON-CRYPTO-001

# @tag: unit, crypto, x25519mlkem768, matrix, receipt-composer
# @req REQ-008 REQ-009 REQ-010 REQ-012 REQ-015 NFR-009 NFR-017

use std.spec.{describe, it, expect, step, fail}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768RunReceipt}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{
    X25519MlKem768MatrixAdmissionPhase, X25519MlKem768MatrixRow}
use lib.common.crypto.x25519_mlkem768.pinned_public_receipt.{
    X25519MlKem768PinnedSet, X25519MlKem768PinnedSetReceipt,
    X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
    X25519_MLKEM768_PINNED_MLKEM_CT_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
    X25519_MLKEM768_PINNED_SERVER_X25519_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
    X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256}
use lib.common.crypto.x25519_mlkem768.executed_row_composer.{
    x25519_mlkem768_compose_executed_matrix_row}

fn _composer_set_a() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(
        set_id: X25519MlKem768PinnedSet.MlKem,
        first_output_label: "mlkem768-encapsulation-key",
        second_output_label: "mlkem768-ciphertext",
        first_output_bytes: 1184, second_output_bytes: 1088,
        shared_secret_bytes: 32, recovered_secret_bytes: 32,
        first_output_sha256: X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_MLKEM_CT_SHA256)

fn _composer_set_b() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(
        set_id: X25519MlKem768PinnedSet.X25519,
        first_output_label: "x25519-client-public",
        second_output_label: "x25519-server-public",
        first_output_bytes: 32, second_output_bytes: 32,
        shared_secret_bytes: 32, recovered_secret_bytes: 32,
        first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_X25519_SHA256)

fn _composer_set_c() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(
        set_id: X25519MlKem768PinnedSet.Hybrid,
        first_output_label: "x25519mlkem768-client-share",
        second_output_label: "x25519mlkem768-server-share",
        first_output_bytes: 1216, second_output_bytes: 1120,
        shared_secret_bytes: 64, recovered_secret_bytes: 64,
        first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

fn _composer_execution() -> X25519MlKem768RunReceipt:
    X25519MlKem768RunReceipt(
        schema: "x25519mlkem768-evidence-v1",
        status: X25519MlKem768EvidenceStatus.Pass,
        reason: "full-operation-pass",
        scope: X25519MlKem768EvidenceScope.FullOperation,
        requested_backend: X25519MlKem768EvidenceBackend.Cuda,
        selected_backend: Some(X25519MlKem768EvidenceBackend.Cuda),
        mode: X25519MlKem768EvidenceMode.Native,
        emulated: false, promotion_eligible: true,
        implementation_version: "0.3.0",
        profile_version: "fips203-2024+ecdhe-mlkem-05",
        fixture_id: "mlkem-native-fd58+rfc7748-abc-v1",
        fixture_manifest_sha256: "a" * 64,
        fixture_source_sha256: "b" * 64,
        pinned_workload_sha256: "d" * 64,
        runner_source_sha256: "c" * 64,
        batch_size: 1,
        client_share_bytes: 1216, server_share_bytes: 1120,
        shared_secret_bytes: 64,
        keygen_output_digest: "",
        encapsulate_output_digest: "",
        decapsulate_output_digest: "",
        scalar_roundtrip_match: true, fallback_used: false,
        absolute_oracle_match: true,
        simd_chunk_hits: 0, observed_rvv_vlen_bits: 0,
        kernel_invocations: 7, compiled: true, submitted: true,
        fence_completed: true, device_readback: true,
        artifact_sha256: "f" * 64,
        device_identity: "cuda-test-device")

fn _compose(execution: X25519MlKem768RunReceipt,
        set_a: X25519MlKem768PinnedSetReceipt,
        set_b: X25519MlKem768PinnedSetReceipt,
        set_c: X25519MlKem768PinnedSetReceipt,
        client_sha256: text) -> Result<X25519MlKem768MatrixRow, text>:
    x25519_mlkem768_compose_executed_matrix_row(
        execution, "9" * 64, "f" * 64, "linux", "x86_64",
        set_a, set_b, set_c, client_sha256,
        X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

describe "X25519MLKEM768 executed matrix row composer":
    it "constructs a complete executed row from public typed receipts":
        # @req: REQ-008
        step("Verify: constructs a complete executed row from public typed receipts")
        step("Compose a CUDA row after all public evidence is present")
        val result = _compose(
            _composer_execution(), _composer_set_a(),
            _composer_set_b(), _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256)
        match result:
            case Err(reason): fail(reason)
            case Ok(row):
                expect(row.admission_phase).to_equal(
                    X25519MlKem768MatrixAdmissionPhase.Executed)
                expect(row.public_wire_bytes).to_equal(2336)  # oracle: 2336 — named expected value from the requirement
                expect(row.pinned_workload_schema).to_equal(
                    "x25519mlkem768-pinned-workload-v3")
                expect(row.set_a != nil).to_be(true)
                expect(row.set_b != nil).to_be(true)
                expect(row.set_c != nil).to_be(true)

    it "rejects a run receipt that did not pass":
        # @req: REQ-009
        step("Verify: rejects a run receipt that did not pass")
        step("Change the executed status to blocked")
        var execution = _composer_execution()
        execution.status = X25519MlKem768EvidenceStatus.Blocked
        execution.promotion_eligible = false
        val result = _compose(execution, _composer_set_a(),
            _composer_set_b(), _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256)
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_equal("execution-status-not-pass")

    it "rejects backend selection that differs from the request":
        # @req: REQ-010
        step("Verify: rejects backend selection that differs from the request")
        step("Claim AVX2 selection for a CUDA request")
        var execution = _composer_execution()
        execution.selected_backend = Some(X25519MlKem768EvidenceBackend.Avx2)
        val result = _compose(execution, _composer_set_a(),
            _composer_set_b(), _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256)
        expect(result.unwrap_err()).to_equal("fallback-or-selection-mismatch")

    it "rejects an incomplete GPU device proof":
        # @req: REQ-012
        step("Verify: rejects an incomplete GPU device proof")
        step("Remove the device readback lifecycle event")
        var execution = _composer_execution()
        execution.device_readback = false
        val result = _compose(execution, _composer_set_a(),
            _composer_set_b(), _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256)
        expect(result.unwrap_err()).to_equal("gpu-device-proof-incomplete")

    it "rejects an artifact not bound to the execution receipt":
        # @req: REQ-015
        step("Verify: rejects an artifact not bound to the execution receipt")
        step("Use a different admitted CUDA binary digest")
        val result = x25519_mlkem768_compose_executed_matrix_row(
            _composer_execution(), "9" * 64, "8" * 64,
            "linux", "x86_64", _composer_set_a(), _composer_set_b(),
            _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
            X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)
        expect(result.unwrap_err()).to_equal(
            "executed-artifact-binding-mismatch")

    it "rejects an incomplete or mislabeled typed set receipt":
        # @req: REQ-LIB-COMMON-CRYPTO-001
        step("Verify: rejects an incomplete or mislabeled typed set receipt")
        step("Remove the canonical Set B public-output label")
        var set_b = _composer_set_b()
        set_b.first_output_label = ""
        val result = _compose(_composer_execution(), _composer_set_a(),
            set_b, _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256)
        expect(result.unwrap_err()).to_equal(
            "set-b-set-public-output-label-mismatch")

    it "rejects Set C when it does not bind the supplied public output":
        # @req: REQ-008
        step("Verify: rejects Set C when it does not bind the supplied public output")
        step("Supply a different client-share digest")
        val result = _compose(_composer_execution(), _composer_set_a(),
            _composer_set_b(), _composer_set_c(), "7" * 64)
        expect(result.unwrap_err()).to_equal(
            "set-c-public-wire-sha256-mismatch")

    it "rejects malformed public provenance without exposing secret hashes":
        # @req: REQ-009
        step("Verify: rejects malformed public provenance without exposing secret hashes")
        step("Use an uppercase runner artifact digest")
        val result = x25519_mlkem768_compose_executed_matrix_row(
            _composer_execution(), "A" * 64, "f" * 64,
            "linux", "x86_64", _composer_set_a(), _composer_set_b(),
            _composer_set_c(),
            X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
            X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)
        expect(result.unwrap_err()).to_equal(
            "artifact-provenance-sha256-invalid")

    it "rejects an empty pinned workload digest before accepting a matrix row":
        # @req: REQ-010
        step("Verify: rejects an empty pinned workload digest before accepting a matrix row")
        var execution = _composer_execution()
        execution.pinned_workload_sha256 = ""
        val result = _compose(execution, _composer_set_a(), _composer_set_b(),
            _composer_set_c(), X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256)
        expect(result.unwrap_err()).to_equal(
            "pinned-workload-or-fixture-provenance-sha256-invalid")
