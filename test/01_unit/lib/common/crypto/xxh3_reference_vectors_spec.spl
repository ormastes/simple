describe "XXH3 reference vectors":
    it "matches XXH3-64 and XXH3-128 for every length class and seed":
        for row in SEEDED:
            val data = msg(row.n)
            expect(xxh3_64_seeded(data, row.seed)).to_equal(row.h64)
            val h = xxh3_128_seeded(data, row.seed)
            expect(h[0]).to_equal(row.lo)
            expect(h[1]).to_equal(row.hi)
            if row.seed == 0u64:
                expect(xxh3_64(data)).to_equal(row.h64)
                expect(xxh3_128(data)).to_equal([row.lo, row.hi])
                expect(xxh3_128_hex(data)).to_equal(hex64(row.hi) + hex64(row.lo))

    it "matches the custom-secret variants":
        val secret = custom_secret()
        for row in WITH_SECRET:
            val data = msg(row.n)
            expect(xxh3_64_with_secret(data, secret)).to_equal([row.h64])
            expect(xxh3_128_with_secret(data, secret)).to_equal([row.lo, row.hi])

    it "rejects a secret shorter than 136 bytes":
        var short: [u8] = [0u8; 135]
        expect(xxh3_64_with_secret(msg(9), short)).to_equal([])
        expect(xxh3_128_with_secret(msg(9), short)).to_equal([])
