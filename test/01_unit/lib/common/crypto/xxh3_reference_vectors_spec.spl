"""XXH3 64/128 reference vectors at every length-class boundary.

Messages are bytes `(7*i + 3) mod 256`, lengths 0/1/3/4/8/9/16/17/32/33/64/65/96/97/128/129/
240/241/300/1025/2049 (the 0, 1-3, 4-8, 9-16, 17-128 with its 32/64/96 mix
steps, 129-240, >240 and >1024 multi-block classes on both
sides of each edge), under seeds 0, 1, 0x9E3779B185EBCA87 and 2^64-1, plus a
192-byte custom secret. Expected values from the reference C library
(libxxhash 0.8 via python-xxhash for the seeded forms, XXH3_*_withSecret via
ctypes for the secret forms). A secret shorter than 136 bytes must be rejected.
"""
# @req REQ-SSPEC-LIB

use std.spec.*
use std.common.crypto.xxh3.{
    xxh3_64, xxh3_64_seeded, xxh3_64_with_secret, xxh3_128, xxh3_128_seeded,
    xxh3_128_with_secret, xxh3_128_hex
}

struct XxRow:
    n: i64
    seed: u64
    h64: u64
    lo: u64
    hi: u64

fn msg(n: i64) -> [u8]:
    var out: [u8] = [0u8; n]
    var i = 0
    while i < n:
        out[i] = ((i * 7 + 3) % 256).to_u8()
        i = i + 1
    out

fn custom_secret() -> [u8]:
    var out: [u8] = [0u8; 192]
    var i = 0
    while i < 192:
        out[i] = ((i * 13 + 5) % 256).to_u8()
        i = i + 1
    out

fn hex64(v: u64) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    var i = 15
    while i >= 0:
        val nib = ((v >> (4u64 * i.to_u64())) & 0xFu64).to_i64()
        out = out + digits.substring(nib, nib + 1)
        i = i - 1
    out

