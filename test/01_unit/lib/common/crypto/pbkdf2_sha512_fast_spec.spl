# Purpose and audience: PBKDF2-HMAC-SHA-384/512 runtime fast path (rt_sha384_digest / rt_sha512_digest) must match the pure-Simple path and the draft-josefsson-pbkdf2-test-vectors.
# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/2026-10-19_pbkdf2_sha384_sha512_no_runtime_primitive.md

use std.spec.step
use std.spipe.*
use std.common.crypto.pbkdf2.{pbkdf2_sha384_bytes, pbkdf2_sha384_bytes_pure, pbkdf2_sha512_bytes, pbkdf2_sha512_bytes_pure}
use std.crypto.types.{bytes_to_hex}

fn _b(s: text) -> [i64]:
    var out: [i64] = []
    for c in s.bytes():
        out.push(c as i64)
    out

fn _rep(s: text, n: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < n:
        out = out + s
        i = i + 1
    out

describe "PBKDF2-HMAC-SHA-512 fast path":
    it "draft-josefsson TC1 c=1 dkLen=64":
        step("SHA-512 TC1")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 1, 64))).to_equal(
            "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce")

    it "draft-josefsson TC2 c=2 dkLen=64":
        step("SHA-512 TC2")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 2, 64))).to_equal(
            "e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e")

    it "draft-josefsson TC3 c=4096 dkLen=64":
        step("SHA-512 TC3")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 4096, 64))).to_equal(
            "d197b1b33db0143e018b12f3d1d1479e6cdebdcc97c5c0f87f6902e072f457b5143f30602641b3d55cd335988cb36b84376060ecd532e039b742a239434af2d5")

    it "multi-block dkLen=150 with big-endian counter equals pure path":
        step("block counter 1..3")
        val fast = pbkdf2_sha512_bytes(_b("password"), _b("salt"), 3, 150)
        val pure = pbkdf2_sha512_bytes_pure(_b("password"), _b("salt"), 3, 150)
        expect(bytes_to_hex(fast)).to_equal(bytes_to_hex(pure))

    it "key longer than the 128-byte block equals pure path":
        step("long key is hashed first")
        val fast = pbkdf2_sha512_bytes(_b(_rep("k", 150)), _b("salt"), 3, 64)
        val pure = pbkdf2_sha512_bytes_pure(_b(_rep("k", 150)), _b("salt"), 3, 64)
        expect(bytes_to_hex(fast)).to_equal(bytes_to_hex(pure))

    it "empty and exactly-128-byte keys equal pure path":
        step("edge keys")
        expect(bytes_to_hex(pbkdf2_sha512_bytes([], _b("salt"), 2, 64))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure([], _b("salt"), 2, 64)))
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b(_rep("q", 128)), _b("salt"), 2, 64))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure(_b(_rep("q", 128)), _b("salt"), 2, 64)))

describe "PBKDF2-HMAC-SHA-384 fast path":
    it "c=1 dkLen=48":
        step("SHA-384 c=1")
        expect(bytes_to_hex(pbkdf2_sha384_bytes(_b("password"), _b("salt"), 1, 48))).to_equal(
            bytes_to_hex(pbkdf2_sha384_bytes_pure(_b("password"), _b("salt"), 1, 48)))

    it "c=4096 dkLen=48":
        step("SHA-384 c=4096")
        expect(bytes_to_hex(pbkdf2_sha384_bytes(_b("password"), _b("salt"), 4096, 48))).to_equal(
            "559726be38db125bc85ed7895f6e3cf574c7a01c080c3447db1e8a76764deb3c307b94853fbe424f6488c5f4f1289626")

    it "multi-block dkLen=100 and long key equal pure path":
        step("SHA-384 counter and long key")
        expect(bytes_to_hex(pbkdf2_sha384_bytes(_b("password"), _b("salt"), 3, 100))).to_equal(
            bytes_to_hex(pbkdf2_sha384_bytes_pure(_b("password"), _b("salt"), 3, 100)))
        expect(bytes_to_hex(pbkdf2_sha384_bytes(_b(_rep("k", 140)), _b("salt"), 2, 48))).to_equal(
            bytes_to_hex(pbkdf2_sha384_bytes_pure(_b(_rep("k", 140)), _b("salt"), 2, 48)))
