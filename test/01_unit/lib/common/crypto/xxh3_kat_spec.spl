"""
## Purpose and audience
Maintainers and cache-index authors who need a fast, stable 64/128-bit
non-cryptographic fingerprint (XXH3) implemented in pure Simple. This spec pins
the implementation to the official xxHash sanity vectors for every length class
(0, 1-3, 4-8, 9-16, 17-128, 129-240, long inputs with block/stripe boundaries),
for default, seeded, and custom-secret modes, in both 64-bit and 128-bit widths.
## Operator workflow
bin/simple test test/01_unit/lib/common/crypto/xxh3_kat_spec.spl
## Compatibility and limitations
XXH3 is NOT cryptographic and is not collision resistant against adversaries.
Output equals the scalar reference path of xxHash 0.8.x; it is endianness
independent. A custom secret shorter than 136 bytes is rejected fail-closed:
both xxh3_128_with_secret and xxh3_64_with_secret return an empty array
(0 is a valid digest, so it cannot signal rejection; [u64] rather than u64? because
the seed JIT mis-unwraps an optional u64, see seed_jit_optional_u64_unwrap_2026-10-18.md).
## Verification guidance and troubleshooting
A red row prints the failing input length. Vectors are copied verbatim from
xxHash tests/sanity_test_vectors.h; the input is the xxHash sanity buffer
(generator 2654435761, multiplier 0x9E3779B185EBCA8D, byte = top 8 bits).
"""
# Lifecycle: doc/01_research/lib/crypto/security_crypto_protocol_catalog_2026-06-15.md ;
# doc/03_plan/lib/crypto/hash_gzip_hardening_2026-10-18.md ;
# doc/04_architecture/lib/common_compression_framework.md ;
# doc/05_design/lib/crypto/hash_gzip_design.md
# @manual_section: XXH3
use std.spec.step
use std.spipe.*
use std.common.hash.xxh3.{xxh3_64, xxh3_64_seeded, xxh3_64_with_secret, xxh3_128_hex}
use std.common.crypto.xxh3.{_k_xxh3_128 as xxh3_128, _k_xxh3_128_seeded as xxh3_128_seeded, _k_xxh3_128_with_secret as xxh3_128_with_secret, _mul128}

fn _hi(h: u64) -> i64:
    (h >> 32u64).to_i64()

fn _lo(h: u64) -> i64:
    (h & 0xFFFFFFFFu64).to_i64()

fn _seed(hi: i64, lo: i64) -> u64:
    (hi.to_u64() << 32u64) | lo.to_u64()

fn _sanity(n: i64) -> [u8]:
    var out: [u8] = []
    var g: u64 = 2654435761u64
    val m: u64 = 0x9E3779B185EBCA8Du64
    var i = 0
    while i < n:
        out.push((g >> 56u64).to_u8())
        g = g * m
        i = i + 1
    out

fn _secret() -> [u8]:
    val b = _sanity(154)
    var out: [u8] = []
    var i = 7
    while i < 154:
        out.push(b[i])
        i = i + 1
    out

describe "XXH3 128-bit multiply helper (xxHash XXH_mult64to128)":

    it "all-ones times all-ones is 0xFFFFFFFFFFFFFFFE_0000000000000001 (boundary of 32-bit limbs)":
        # @req REQ-XXH3-001
        # @capture(vector): (2^64-1)^2 = 2^128 - 2^65 + 1, hand arithmetic
        step("Multiply 0xFFFFFFFFFFFFFFFF by itself")
        val p = _mul128(0xFFFFFFFFFFFFFFFFu64, 0xFFFFFFFFFFFFFFFFu64)
        expect(_hi(p[0])).to_equal(0)  # oracle: low word 0x0000000000000001, hand arithmetic
        expect(_lo(p[0])).to_equal(1)  # oracle: low word 0x0000000000000001, hand arithmetic
        expect(_hi(p[1])).to_equal(0xFFFFFFFF)  # oracle: high word 0xFFFFFFFFFFFFFFFE, hand arithmetic
        expect(_lo(p[1])).to_equal(0xFFFFFFFE)  # oracle: high word 0xFFFFFFFFFFFFFFFE, hand arithmetic

    it "0x100000001 squared carries across limbs to 0x1_0000000200000001":
        # @req REQ-XXH3-001
        # @capture(vector): (2^32+1)^2 = 2^64 + 2^33 + 1, hand arithmetic
        step("Multiply 0x100000001 by itself")
        val p = _mul128(0x100000001u64, 0x100000001u64)
        expect(_hi(p[0])).to_equal(2)  # oracle: 2^33+1 -> low word 0x0000000200000001
        expect(_lo(p[0])).to_equal(1)  # oracle: 2^33+1 -> low word 0x0000000200000001
        expect(_lo(p[1])).to_equal(1)  # oracle: 2^64 term -> high word 1

    it "2^63 times 4 is 2^65: low word 0, high word 2, and a one-word operand 2 doubles all-ones":
        # @req REQ-XXH3-001
        # @capture(vector): 2^63 * 4 = 2^65; (2^64-1)*2 = 2^65 - 2, hand arithmetic
        step("Multiply 2^63 by 4 and all-ones by 2")
        val p = _mul128(0x8000000000000000u64, 4u64)
        val q = _mul128(0xFFFFFFFFFFFFFFFFu64, 2u64)
        expect(_lo(p[0])).to_equal(0)  # oracle: 2^65 has zero low word
        expect(_lo(p[1])).to_equal(2)  # oracle: 2^65 = 2 * 2^64
        expect(_hi(q[0])).to_equal(0xFFFFFFFF)  # oracle: 2^65-2 low word 0xFFFFFFFFFFFFFFFE
        expect(_lo(q[0])).to_equal(0xFFFFFFFE)  # oracle: 2^65-2 low word 0xFFFFFFFFFFFFFFFE
        expect(_lo(q[1])).to_equal(1)  # oracle: 2^65-2 high word 1

