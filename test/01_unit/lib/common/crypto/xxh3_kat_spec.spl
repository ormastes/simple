            [2049, 0x00000000, 0x00000000, 0xA21BE3A0, 0x4630DEF3, 0x545E6704, 0x6AF902FB],
            [2240, 0x00000000, 0x00000000, 0xB26C938C, 0x7AF3A71F, 0x1E89EE71, 0x0A768055],
            [2367, 0x00000000, 0x00000000, 0x293FA8E5, 0x173BB5E7, 0x343654A3, 0x5ACF0DAE],
            [2368, 0x00000000, 0x00000000, 0x1B882F56, 0x51079927, 0x7BA2FE90, 0x989DDABC],
            [4095, 0x00000000, 0x00000000, 0xC2D88832, 0x7F91A534, 0x42FE4D68, 0x8287BEE7],
            [4096, 0x00000000, 0x00000000, 0x80C04307, 0x3074A679, 0x7771BE33, 0x4FA36A7A],
            [4159, 0x00000000, 0x00000000, 0xB12AB27B, 0x68460462, 0x262239CE, 0xF1E9E0DF],
            [4160, 0x00000000, 0x00000000, 0x7CD56BF8, 0xCB910475, 0x06CD5176, 0x5E2D12B6]
        ]
        val secret = _secret()
        var failed = ""
        for r in rows:
            val buf = _sanity(r[0])
            val h = xxh3_128_with_secret(buf, secret)
            if h.len() != 2 or _hi(h[0]) != r[3] or _lo(h[0]) != r[4] or _hi(h[1]) != r[5] or _lo(h[1]) != r[6]:
                failed = failed + "len=" + r[0].to_text() + " "
        expect(failed).to_equal("")

describe "XXH3 canonical text form and invalid input":

    it "the canonical hex of the empty input is high64 then low64 in lowercase (XXH128_canonicalFromHash)":
        # @req REQ-XXH3-009
        # @capture(vector): XXH128 of empty input: low 0x6001C324468D497F, high 0x99AA06D3014798D8
        step("Render the 128-bit hash of empty input as hex")
        expect(xxh3_128_hex(_sanity(0))).to_equal("99aa06d3014798d86001c324468d497f")

    it "the canonical hex of one sanity byte is 32 lowercase hex digits (XXH128_canonicalFromHash)":
        # @req REQ-XXH3-009
        # @capture(vector): XXH128 len 1: low 0xC44BDFF4074EECDB, high 0xA6CD5E9392000F6A
        step("Render the 128-bit hash of one byte as hex")
        expect(xxh3_128_hex(_sanity(1))).to_equal("a6cd5e9392000f6ac44bdff4074eecdb")

    it "a secret shorter than 136 bytes is rejected fail-closed with an empty 128-bit result and an empty 64-bit result (XXH3_SECRET_SIZE_MIN)":
        # @req REQ-XXH3-010
        # @capture(vector): boundary - 135 bytes is invalid, 136 bytes is the minimum valid size
        step("Hash with a 135-byte secret and a 136-byte secret")
        val data = _sanity(300)
        val short = _sanity(135)
        val minimal = _sanity(136)
        val bad128 = xxh3_128_with_secret(data, short)
        val ok128 = xxh3_128_with_secret(data, minimal)
        val bad64 = xxh3_64_with_secret(data, short)
        val ok64 = xxh3_64_with_secret(data, minimal)
        expect(bad128.len()).to_equal(0)  # oracle: rejected secret yields no hash words
        expect(ok128.len()).to_equal(2)  # oracle: low64 and high64
        expect(bad64.len()).to_equal(0)  # oracle: rejected secret yields no hash word
        expect(ok64.len()).to_equal(1)  # oracle: one 64-bit hash word

    it "an empty secret is invalid and rejected (error path for XXH3_SECRET_SIZE_MIN)":
        # @req REQ-XXH3-010
        # @capture(vector): boundary - zero-length secret
        step("Hash with an empty secret")
        val empty: [u8] = []
        expect(xxh3_128_with_secret(_sanity(10), empty).len()).to_equal(0)  # oracle: rejected secret yields no hash words
        expect(xxh3_64_with_secret(_sanity(10), empty).len()).to_equal(0)  # oracle: rejected secret yields no hash word
