use std.spec.{describe, it, assert_equal}
use std.common.crypto.argon2.{argon2id_bytes_ks}
use std.crypto.types.{bytes_to_hex}

fn make_filled_bytes(count: i64, value: u8) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < count:
        out.push(value)
        i = i + 1
    out

describe "u64 array push high-bit preservation":
    it "preserves u64 >= 2^63 words across typed empty push and grow":
        var words: [u64] = []
        words.push(0x8000000000000000u64)
        words.push(0xC000000000000000u64)
        words.push(0xFFFFFFFFFFFFFFFFu64)
        words.push(13643789653076310793u64)
        var i: i64 = 0
        while i < 20:
            words.push(0x8000000000000000u64 + i.to_u64())
            i = i + 1

        assert_equal(words.len(), 24)
        assert_equal(words[0], 0x8000000000000000u64)
        assert_equal(words[1], 0xC000000000000000u64)
        assert_equal(words[2], 0xFFFFFFFFFFFFFFFFu64)
        assert_equal(words[3], 13643789653076310793u64)
        assert_equal(words[23], 0x8000000000000013u64)

    it "preserves u64 >= 2^63 words for untyped empty and large repeat arrays":
        var refined = []
        refined.push(13643789653076310793u64)
        refined.push(0x8000000000000000u64)
        refined.push(0xC000000000000000u64)
        refined.push(0xFFFFFFFFFFFFFFFFu64)
        assert_equal(refined[0], 13643789653076310793u64)
        assert_equal(refined[1], 0x8000000000000000u64)
        assert_equal(refined[2], 0xC000000000000000u64)
        assert_equal(refined[3], 0xFFFFFFFFFFFFFFFFu64)

        var repeat_arr: [u64] = [0u64; 300]
        repeat_arr.push(0x8000000000000000u64)
        repeat_arr.push(0xC000000000000000u64)
        repeat_arr.push(0xFFFFFFFFFFFFFFFFu64)
        repeat_arr.push(13643789653076310793u64)
        assert_equal(repeat_arr[300], 0x8000000000000000u64)
        assert_equal(repeat_arr[301], 0xC000000000000000u64)
        assert_equal(repeat_arr[302], 0xFFFFFFFFFFFFFFFFu64)
        assert_equal(repeat_arr[303], 13643789653076310793u64)

    it "matches Argon2id RFC 9106 section 5.3 vector":
        val pw = make_filled_bytes(32, 0x01u8)
        val salt = make_filled_bytes(16, 0x02u8)
        val key = make_filled_bytes(8, 0x03u8)
        val ad = make_filled_bytes(12, 0x04u8)
        val tag = argon2id_bytes_ks(pw, salt, key, ad, 3, 32, 4, 32)
        assert_equal(
            bytes_to_hex(tag),
            "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"
        )
