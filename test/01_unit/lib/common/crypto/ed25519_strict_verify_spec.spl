# Strict Ed25519 verification for the canonical pure-Simple implementation.
#
# Positive data is RFC 8032 section 7.1 TEST SHA(abc).  Negative cases cover
# the RFC 8032 section 5.1.3 decoding rules plus the low-order encodings that
# strict Ed25519 verifiers must reject.

use std.spipe.*
use lib.common.crypto.ed25519.{
    pure_ed25519_keypair_from_seed, pure_ed25519_sign, pure_ed25519_verify
}

val SEED_SHA_ABC: [u8] = [
    0x83u8, 0x3fu8, 0xe6u8, 0x24u8, 0x09u8, 0x23u8, 0x7bu8, 0x9du8,
    0x62u8, 0xecu8, 0x77u8, 0x58u8, 0x75u8, 0x20u8, 0x91u8, 0x1eu8,
    0x9au8, 0x75u8, 0x9cu8, 0xecu8, 0x1du8, 0x19u8, 0x75u8, 0x5bu8,
    0x7du8, 0xa9u8, 0x01u8, 0xb9u8, 0x6du8, 0xcau8, 0x3du8, 0x42u8
]

val PUB_SHA_ABC: [u8] = [
    0xecu8, 0x17u8, 0x2bu8, 0x93u8, 0xadu8, 0x5eu8, 0x56u8, 0x3bu8,
    0xf4u8, 0x93u8, 0x2cu8, 0x70u8, 0xe1u8, 0x24u8, 0x50u8, 0x34u8,
    0xc3u8, 0x54u8, 0x67u8, 0xefu8, 0x2eu8, 0xfdu8, 0x4du8, 0x64u8,
    0xebu8, 0xf8u8, 0x19u8, 0x68u8, 0x34u8, 0x67u8, 0xe2u8, 0xbfu8
]

val MSG_SHA_ABC: [u8] = [
    0xddu8, 0xafu8, 0x35u8, 0xa1u8, 0x93u8, 0x61u8, 0x7au8, 0xbau8,
    0xccu8, 0x41u8, 0x73u8, 0x49u8, 0xaeu8, 0x20u8, 0x41u8, 0x31u8,
    0x12u8, 0xe6u8, 0xfau8, 0x4eu8, 0x89u8, 0xa9u8, 0x7eu8, 0xa2u8,
    0x0au8, 0x9eu8, 0xeeu8, 0xe6u8, 0x4bu8, 0x55u8, 0xd3u8, 0x9au8,
    0x21u8, 0x92u8, 0x99u8, 0x2au8, 0x27u8, 0x4fu8, 0xc1u8, 0xa8u8,
    0x36u8, 0xbau8, 0x3cu8, 0x23u8, 0xa3u8, 0xfeu8, 0xebu8, 0xbdu8,
    0x45u8, 0x4du8, 0x44u8, 0x23u8, 0x64u8, 0x3cu8, 0xe8u8, 0x0eu8,
    0x2au8, 0x9au8, 0xc9u8, 0x4fu8, 0xa5u8, 0x4cu8, 0xa4u8, 0x9fu8
]

val SIG_SHA_ABC: [u8] = [
    0xdcu8, 0x2au8, 0x44u8, 0x59u8, 0xe7u8, 0x36u8, 0x96u8, 0x33u8,
    0xa5u8, 0x2bu8, 0x1bu8, 0xf2u8, 0x77u8, 0x83u8, 0x9au8, 0x00u8,
    0x20u8, 0x10u8, 0x09u8, 0xa3u8, 0xefu8, 0xbfu8, 0x3eu8, 0xcbu8,
    0x69u8, 0xbeu8, 0xa2u8, 0x18u8, 0x6cu8, 0x26u8, 0xb5u8, 0x89u8,
    0x09u8, 0x35u8, 0x1fu8, 0xc9u8, 0xacu8, 0x90u8, 0xb3u8, 0xecu8,
    0xfdu8, 0xfbu8, 0xc7u8, 0xc6u8, 0x64u8, 0x31u8, 0xe0u8, 0x30u8,
    0x3du8, 0xcau8, 0x17u8, 0x9cu8, 0x13u8, 0x8au8, 0xc1u8, 0x7au8,
    0xd9u8, 0xbeu8, 0xf1u8, 0x17u8, 0x73u8, 0x31u8, 0xa7u8, 0x04u8
]

fn _point_encoding(first: u8, last: u8, middle: u8) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < 32:
        if i == 0:
            out.push(first)
        else if i == 31:
            out.push(last)
        else:
            out.push(middle)
        i = i + 1
    out

fn _identity_encoding() -> [u8]:
    _point_encoding(0x01u8, 0x00u8, 0x00u8)

fn _negative_zero_encoding() -> [u8]:
    _point_encoding(0x01u8, 0x80u8, 0x00u8)

fn _order_two_encoding() -> [u8]:
    _point_encoding(0xecu8, 0x7fu8, 0xffu8)

fn _noncanonical_p_encoding() -> [u8]:
    _point_encoding(0xedu8, 0x7fu8, 0xffu8)

fn _invalid_y_two_encoding() -> [u8]:
    _point_encoding(0x02u8, 0x00u8, 0x00u8)

fn _identity_forgery() -> [u8]:
    var sig: [u8] = []
    var i: u64 = 0
    while i < 64:
        if i == 0:
            sig.push(0x01u8)
        else:
            sig.push(0x00u8)
        i = i + 1
    sig

fn _signature_with_s_l() -> [u8]:
    val scalar_l: [u8] = [
        0xedu8, 0xd3u8, 0xf5u8, 0x5cu8, 0x1au8, 0x63u8, 0x12u8, 0x58u8,
        0xd6u8, 0x9cu8, 0xf7u8, 0xa2u8, 0xdeu8, 0xf9u8, 0xdeu8, 0x14u8,
        0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
        0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x10u8
    ]
    var sig: [u8] = []
    var i: u64 = 0
    while i < 64:
        if i < 32:
            sig.push(SIG_SHA_ABC[i])
        else:
            sig.push(scalar_l[i - 32])
        i = i + 1
    sig

fn _signature_with_r(r: [u8]) -> [u8]:
    var sig: [u8] = []
    var i: u64 = 0
    while i < 64:
        if i < 32:
            sig.push(r[i])
        else:
            sig.push(SIG_SHA_ABC[i])
        i = i + 1
    sig

describe "pure-Simple Ed25519 strict verification":

    it "derives the RFC 8032 SHA(abc) public key exactly":
        val keypair = pure_ed25519_keypair_from_seed(SEED_SHA_ABC)
        expect(keypair.1).to_equal(PUB_SHA_ABC)

    it "accepts the RFC 8032 SHA(abc) signature":
        expect(pure_ed25519_verify(PUB_SHA_ABC, MSG_SHA_ABC, SIG_SHA_ABC)).to_be(true)

    it "signs the RFC 8032 SHA(abc) vector byte-for-byte":
        val signature = pure_ed25519_sign(SEED_SHA_ABC, PUB_SHA_ABC, MSG_SHA_ABC)
        expect(signature).to_equal(SIG_SHA_ABC)

    it "rejects S equal to the group order L":
        expect(pure_ed25519_verify(PUB_SHA_ABC, MSG_SHA_ABC, _signature_with_s_l())).to_be(false)

    it "rejects the identity-key universal-forgery shape":
        expect(pure_ed25519_verify(_identity_encoding(), [], _identity_forgery())).to_be(false)

    it "rejects an order-two public key":
        expect(pure_ed25519_verify(_order_two_encoding(), MSG_SHA_ABC, SIG_SHA_ABC)).to_be(false)

    it "rejects y equal to non-canonical field modulus p":
        expect(pure_ed25519_verify(_noncanonical_p_encoding(), MSG_SHA_ABC, SIG_SHA_ABC)).to_be(false)

    it "rejects a y coordinate whose curve equation has no square root":
        expect(pure_ed25519_verify(_invalid_y_two_encoding(), MSG_SHA_ABC, SIG_SHA_ABC)).to_be(false)

    it "rejects the forbidden negative encoding of x zero":
        expect(pure_ed25519_verify(_negative_zero_encoding(), MSG_SHA_ABC, SIG_SHA_ABC)).to_be(false)

    it "rejects an identity R point":
        val bad_sig = _signature_with_r(_identity_encoding())
        expect(pure_ed25519_verify(PUB_SHA_ABC, MSG_SHA_ABC, bad_sig)).to_be(false)

    it "rejects a non-canonical R point":
        val bad_sig = _signature_with_r(_noncanonical_p_encoding())
        expect(pure_ed25519_verify(PUB_SHA_ABC, MSG_SHA_ABC, bad_sig)).to_be(false)
