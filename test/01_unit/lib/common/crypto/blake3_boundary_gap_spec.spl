"""
BLAKE3 specification gap checks. Proof class: production API, AUTHORED_UNRUN.
Official BLAKE3 vectors f55849f89cd85083c1c9daa2c5de20766f309c00,
SHA256 dcb91ea8accc77e6d6e632af7cdc1a99a9f3ae78cf648da595c7d064db32f624.
Input byte i = i modulo 251; expected digests are independent published bytes.
No runtime, branch percentage, or generated-manual completion is claimed.
"""
# codex-system-test
use std.spec.*
use std.common.crypto.blake3.{blake3_hash, blake3_hash_xof, blake3_keyed_hash, blake3_derive_key, blake3_hex, blake3_bytes}

# @inline
fn load_blake3_vectors(n: i64) -> [u8]:
    var data: [u8] = []
    for i in 0..n:
        data.push((i % 251).to_u8())
    data

describe "BLAKE3 missing unit boundaries":
    it "should match keyed_hash immediately before the chunk boundary":
        # @req REQ-HASH-BLAKE3-001
        step("Load the published vector")
        val data = load_blake3_vectors(1023)
        step("Hash through the production API")
        val digest = blake3_keyed_hash("whats the Elvish word for friend".bytes(), data)
        step("Compare the expected digest")
        expect(blake3_hex(digest)).to_equal("c951ecdf03288d0fcc96ee3413563d8a6d3589547f2c2fb36d9786470f1b9d6e")

    it "should match derive_key immediately before the chunk boundary":
        # @req REQ-HASH-BLAKE3-001
        step("Load the published vector")
        val data = load_blake3_vectors(1023)
        step("Hash through the production API")
        val digest = blake3_derive_key("BLAKE3 2019-12-27 16:29:52 test vectors context", data)
        step("Compare the expected digest")
        expect(blake3_hex(digest)).to_equal("74a16c1c3d44368a86e1ca6df64be6a2f64cce8f09220787450722d85725dea5")

    it "should truncate the official XOF to exactly 1 bytes":
        # @req REQ-HASH-BLAKE3-002
        step("Load the published vector")
        val data = load_blake3_vectors(65)
        step("Hash through the production API")
        val digest = blake3_hash_xof(data, 1)
        step("Compare the expected digest")
        expect(blake3_hex(digest)).to_equal("de")

    it "should truncate the official XOF to exactly 63 bytes":
        # @req REQ-HASH-BLAKE3-002
        step("Load the published vector")
        val data = load_blake3_vectors(65)
        step("Hash through the production API")
        val digest = blake3_hash_xof(data, 63)
        step("Compare the expected digest")
        expect(blake3_hex(digest)).to_equal("de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee0e16e0a4749d6811dd1d6d1265c29729b1b75a9ac346cf93f0e1d7296dfcfd")

    it "should truncate the official XOF to exactly 64 bytes":
        # @req REQ-HASH-BLAKE3-002
        step("Load the published vector")
        val data = load_blake3_vectors(65)
        step("Hash through the production API")
        val digest = blake3_hash_xof(data, 64)
        step("Compare the expected digest")
        expect(blake3_hex(digest)).to_equal("de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee0e16e0a4749d6811dd1d6d1265c29729b1b75a9ac346cf93f0e1d7296dfcfd43")

    it "should truncate the official XOF to exactly 65 bytes":
        # @req REQ-HASH-BLAKE3-002
        step("Load the published vector")
        val data = load_blake3_vectors(65)
        step("Hash through the production API")
        val digest = blake3_hash_xof(data, 65)
        step("Compare the expected digest")
        expect(blake3_hex(digest)).to_equal("de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee0e16e0a4749d6811dd1d6d1265c29729b1b75a9ac346cf93f0e1d7296dfcfd4313")

    it "should return no bytes for negative output length":
        # @req REQ-HASH-BLAKE3-003
        step("Request the production API negative-length contract")
        expect(blake3_hash_xof([], -1)).to_equal([])

    it "should reject an empty key before reading key words":
        # @req REQ-HASH-BLAKE3-003
        step("Request keyed hashing with an invalid empty key")
        expect(blake3_keyed_hash([], [0u8])).to_equal([])

    it "should preserve high-bit bytes in lowercase hexadecimal":
        # @req REQ-HASH-BLAKE3-004
        step("Render zero, signed-byte boundary and maximum-byte values")
        expect(blake3_hex([0u8, 127u8, 128u8, 255u8])).to_equal("007f80ff")
