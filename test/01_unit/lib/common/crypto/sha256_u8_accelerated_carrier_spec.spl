# @req REQ-SSPEC-LIB
# Pins phase2_u8_accelerated_sha256_ffi_carrier_2026_10_27: the accelerated
# [u8] SHA-256 boundary (rt_tls13_sha256) must accept typed byte arrays with
# octets 0,128,255 and empty input. Run natively with the deployed producer to
# retire the adapter_minio.spl workaround.
use std.spec.step
use std.spec.{describe, it, assert_equal}
use std.common.crypto.sha256.{sha256_u8_fast_hex, sha256_u8_hex}

describe "sha256 [u8] accelerated carrier":
    it "hashes octets 0,128,255":
        step("high-bit octets")
        val b: [u8] = [0, 128, 255]
        val want = "5240672d7b51756b829ad0ef8d9468b7a078afa2f410484fd3892dab47becb72"
        assert_equal(sha256_u8_fast_hex(b), want)
        assert_equal(sha256_u8_hex(b), want)
    it "hashes empty input":
        step("empty")
        val e: [u8] = []
        assert_equal(sha256_u8_fast_hex(e), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
