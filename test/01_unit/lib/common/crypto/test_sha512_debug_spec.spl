"""
## Purpose and audience
Purpose: Prove that sha512_256 debug.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spipe.*
use std.crypto.sha512.{sha512_256_bytes}

use std.spec.step

describe "sha512_256 debug":
    it "empty input":
        step("Verify: empty input")
        # @req: REQ-LIB-COMMON-001
        val result = sha512_256_bytes([])
        expect(result.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
    it "small 4-byte input":
        step("Verify: small 4-byte input")
        val result = sha512_256_bytes([1, 2, 3, 4])
        expect(result.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
    it "68-byte input":
        step("Verify: 68-byte input")
        var data: [i64] = []
        var i = 0
        while i < 68:
            data.push(i & 255)
            i = i + 1
        val result = sha512_256_bytes(data)
        expect(result.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
    it "128-byte input":
        step("Verify: 128-byte input")
        var data: [i64] = []
        var i = 0
        while i < 128:
            data.push(i & 255)
            i = i + 1
        val result = sha512_256_bytes(data)
        expect(result.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
