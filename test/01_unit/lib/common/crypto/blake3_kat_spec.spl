"""
## Purpose and audience
Known-answer tests for the complete BLAKE3 hash (std.common.crypto.blake3) against the
official BLAKE3 test vectors. Operators who rely on BLAKE3 digests for cache objects,
workload image hashes and content addressing use this to confirm multi-chunk inputs,
keyed hashing, key derivation and extendable output are correct.
## Operator workflow
bin/simple test test/01_unit/lib/common/crypto/blake3_kat_spec.spl
## Compatibility and limitations
Vectors are the official test_vectors.json (input byte i is i mod 251; key and context as
published). The legacy blake3_bytes/blake3_text wrappers share the one compression function.
## Verification guidance and troubleshooting
A failure at 65 bytes means block chaining is broken; at 1025 bytes the chunk tree or
chunk counter; in XOF bytes 32..130 the output-block counter; in keyed/derive vectors the
KEYED_HASH / DERIVE_KEY flags.
"""
# Lifecycle: doc/01_research/lib/crypto/security_crypto_protocol_catalog_2026-06-15.md ;
# doc/03_plan/lib/crypto/hash_gzip_hardening_2026-10-18.md ;
# doc/04_architecture/lib/common_compression_framework.md ;
# doc/05_design/lib/crypto/hash_gzip_design.md
# @manual_section: BLAKE3

use std.spec.step
use std.spipe.*
use std.common.crypto.blake3.{blake3_hash, blake3_hash_xof, blake3_keyed_hash, blake3_derive_key, blake3_hex, blake3_bytes, blake3_text}

fn _input(n: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < n:
        out.push((i % 251).to_u8())
        i = i + 1
    out

fn _key() -> [u8]:
    "whats the Elvish word for friend".bytes()

fn _ctx() -> text:
    "BLAKE3 2019-12-27 16:29:52 test vectors context"

fn _hex(b: [u8]) -> text:
    var s = ""
    val digits = "0123456789abcdef"
    for x in b:
        val v = x.to_i64()
        s = s + digits[v / 16] + digits[v % 16]
    s

describe "BLAKE3 unkeyed hash, official vectors":
    it "a 0-byte input hashes to the official 32-byte digest (BLAKE3 spec 2, test_vectors hash)":
        # @req REQ-BLAKE3-001
        # @capture(vector): official hash, input_len=0, first 64 hex chars
        step("Hash the 0-byte vector input")
        expect(_hex(blake3_hash(_input(0)))).to_equal("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")

    it "a 1-byte input hashes to the official 32-byte digest (BLAKE3 spec 2, test_vectors hash)":
