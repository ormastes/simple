        # @capture(vector): official keyed_hash, input_len=2049, first 64 hex chars
        step("Keyed-hash the 2049-byte vector input")
        expect(_hex(blake3_keyed_hash(_key(), _input(2049)))).to_equal("9f29700902f7c86e514ddc4df1e3049f258b2472b6dd5267f61bf13983b78dd5")

    it "a 8193-byte input under the official key matches keyed_hash (BLAKE3 spec 2.3 KEYED_HASH)":
        # @req REQ-BLAKE3-003
        # @capture(vector): official keyed_hash, input_len=8193, first 64 hex chars
        step("Keyed-hash the 8193-byte vector input")
        expect(_hex(blake3_keyed_hash(_key(), _input(8193)))).to_equal("954a2a75420c8d6547e3ba5b98d963e6fa6491addc8c023189cc519821b4a1f5")

    it "a 31-byte key is rejected as invalid and yields no digest (error path, fail closed)":
        # @req REQ-BLAKE3-003
        # @capture(vector): key length 31 and 33 are invalid
        step("Keyed-hash with a 31-byte key")
        expect(blake3_keyed_hash(_key()[0:31], _input(10)).len()).to_equal(0)  # oracle: spec requires a 32-byte key
        step("Keyed-hash with a 33-byte key")
        expect(blake3_keyed_hash(_key() + [0u8], _input(10)).len()).to_equal(0)  # oracle: spec requires a 32-byte key

