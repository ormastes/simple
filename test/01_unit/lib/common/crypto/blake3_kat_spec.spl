describe "BLAKE3 extendable output (output-block counter)":
    it "a 0-byte input yields the official 131-byte XOF across three output blocks (BLAKE3 spec 2.6)":
        # @req REQ-BLAKE3-002
        # @capture(vector): official hash XOF, input_len=0, 262 hex chars
        step("Request 131 bytes of output for the 0-byte vector input")
        expect(_hex(blake3_hash_xof(_input(0), 131))).to_equal("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262e00f03e7b69af26b7faaf09fcd333050338ddfe085b8cc869ca98b206c08243a26f5487789e8f660afe6c99ef9e0c52b92e7393024a80459cf91f476f9ffdbda7001c22e159b402631f277ca96f2defdf1078282314e763699a31c5363165421cce14d")

    it "a 1024-byte input yields the official 131-byte XOF across three output blocks (BLAKE3 spec 2.6)":
        # @req REQ-BLAKE3-002
        # @capture(vector): official hash XOF, input_len=1024, 262 hex chars
        step("Request 131 bytes of output for the 1024-byte vector input")
        expect(_hex(blake3_hash_xof(_input(1024), 131))).to_equal("42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af71cf8107265ecdaf8505b95d8fcec83a98a6a96ea5109d2c179c47a387ffbb404756f6eeae7883b446b70ebb144527c2075ab8ab204c0086bb22b7c93d465efc57f8d917f0b385c6df265e77003b85102967486ed57db5c5ca170ba441427ed9afa684e")

    it "a 1025-byte input yields the official 131-byte XOF across three output blocks (BLAKE3 spec 2.6)":
        # @req REQ-BLAKE3-002
        # @capture(vector): official hash XOF, input_len=1025, 262 hex chars
        step("Request 131 bytes of output for the 1025-byte vector input")
        expect(_hex(blake3_hash_xof(_input(1025), 131))).to_equal("d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444f4c4a22b4b399155358a994e52bf255de60035742ec71bd08ac275a1b51cc6bfe332b0ef84b409108cda080e6269ed4b3e2c3f7d722aa4cdc98d16deb554e5627be8f955c98e1d5f9565a9194cad0c4285f93700062d9595adb992ae68ff12800ab67a")

    it "a 3073-byte input yields the official 131-byte XOF across three output blocks (BLAKE3 spec 2.6)":
        # @req REQ-BLAKE3-002
        # @capture(vector): official hash XOF, input_len=3073, 262 hex chars
        step("Request 131 bytes of output for the 3073-byte vector input")
        expect(_hex(blake3_hash_xof(_input(3073), 131))).to_equal("7124b49501012f81cc7f11ca069ec9226cecb8a2c850cfe644e327d22d3e1cd39a27ae3b79d68d89da9bf25bc27139ae65a324918a5f9b7828181e52cf373c84f35b639b7fccbb985b6f2fa56aea0c18f531203497b8bbd3a07ceb5926f1cab74d14bd66486d9a91eba99059a98bd1cd25876b2af5a76c3e9eed554ed72ea952b603bf")

    it "the first 32 XOF bytes equal the plain digest and a zero length is an invalid empty request (boundary)":
        # @req REQ-BLAKE3-002
        # @capture(vector): XOF prefix property for the 65-byte input
        step("Compare the 32-byte prefix of a 100-byte XOF with the digest")
        expect(_hex(blake3_hash_xof(_input(65), 100)[0:32])).to_equal(_hex(blake3_hash(_input(65))))
        step("Request zero output bytes")
        expect(blake3_hash_xof(_input(65), 0).len()).to_equal(0)  # oracle: empty request yields no bytes

describe "BLAKE3 keyed hash":
    it "a 0-byte input under the official key matches keyed_hash (BLAKE3 spec 2.3 KEYED_HASH)":
        # @req REQ-BLAKE3-003
        # @capture(vector): official keyed_hash, input_len=0, first 64 hex chars
        step("Keyed-hash the 0-byte vector input")
        expect(_hex(blake3_keyed_hash(_key(), _input(0)))).to_equal("92b2b75604ed3c761f9d6f62392c8a9227ad0ea3f09573e783f1498a4ed60d26")

