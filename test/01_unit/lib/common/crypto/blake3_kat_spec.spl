describe "BLAKE3 legacy wrappers":
    it "blake3_bytes, blake3_text and blake3_hex agree with the official vectors (compat)":
        # @req REQ-BLAKE3-005
        # @capture(vector): hash input_len=0 and 65 via the legacy APIs
        step("Hash 65 bytes through blake3_bytes")
        var legacy: [i64] = []
        var i = 0
        while i < 65:
            legacy.push(i % 251)
            i = i + 1
        expect(blake3_bytes(legacy).len()).to_equal(32)  # oracle: digest is 32 bytes
        expect(blake3_bytes(legacy)[0]).to_equal(222)  # oracle: 0xde, first byte of official 65-byte digest de1e5fa0...
        step("Hash the empty text through blake3_text")
        expect(blake3_text("")).to_equal("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")
        step("Render blake3_hex of the empty digest")
        expect(blake3_hex(blake3_hash([]))).to_equal("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")
