"""
## Purpose and audience
Minimum-secret and remaining XXH3-128 branch-boundary vectors for library maintainers comparing pure-Simple behavior to xxHash v0.8.3.
## Operator workflow
Run this spec with an admitted native runner, --native-backend=llvm --assert-ran --no-cache.
## Compatibility and limitations
AUTHORED_UNRUN. No admitted runtime was available; branch coverage is UNMEASURED.
XXH3 is non-cryptographic. This tests the production API, not the upstream C library.
## Verification guidance and troubleshooting
Independent oracle: xxHash e626a72bc2321cd320e953a0ccf1584cad60f363, xxhash.h.
Input repeats 00 7f 80 ff; secret byte i is (13*i+5) mod 256.
Retain actual test counts and branch denominators before claiming coverage.
"""
# codex-system-test
# Lifecycle: doc/03_plan/sys_test/xxh3_128_spec_boundaries_20261103.md
# @manual_section: XXH3-128 published contract
# @evidence-display: links
use std.spec.*
use std.common.crypto.xxh3.{_k_xxh3_128_seeded, _k_xxh3_128_with_secret}

# @inline
fn binary_input(n: i64) -> [u8]:
    val pattern: [u8] = [0u8, 127u8, 128u8, 255u8]
    var data: [u8] = []
    for i in 0..n:
        data.push(pattern[i % 4])
    data

# @inline
fn secret_input(n: i64) -> [u8]:
    var data: [u8] = []
    for i in 0..n:
        data.push(((13 * i + 5) % 256).to_u8())
    data

struct BoundaryVector:
    length: i64
    secret_length: i64
    low: u64
    high: u64

describe "XXH3-128 missing published boundary cases":
    it "should match exact digests at minimum-secret block boundaries":
        # @req REQ-HASH-XXH3-004
        # @req REQ-HASH-XXH3-003
        # @capture(binary): exact low/high digest words checked against upstream reference
        step("Load the published vector")
        val vectors: [BoundaryVector] = [
            BoundaryVector(length: 0, secret_length: 136, low: 0x6c433e8430908e0bu64, high: 0x0185b75c08909137u64),
            BoundaryVector(length: 4, secret_length: 136, low: 0x3e0b9bfd74245d08u64, high: 0x2d644f018f3bb0ceu64),
            BoundaryVector(length: 240, secret_length: 136, low: 0x797a51512f06fa57u64, high: 0x9e938a80c5f5ed17u64),
            BoundaryVector(length: 241, secret_length: 136, low: 0xdd2354f5d01a8427u64, high: 0x16341628f6f66257u64),
            BoundaryVector(length: 575, secret_length: 136, low: 0x7eba2e7599325bbfu64, high: 0x69bc7657c358fb3du64),
            BoundaryVector(length: 576, secret_length: 136, low: 0xd9e7cd4086b97da8u64, high: 0xa1a762c499e1705cu64),
            BoundaryVector(length: 577, secret_length: 136, low: 0xecbe723d59ef8fb5u64, high: 0x78a4cd02b12276c4u64),
            BoundaryVector(length: 1152, secret_length: 136, low: 0x75cd0120316d74f3u64, high: 0xe47d7e88b4e6cc19u64),
            BoundaryVector(length: 1153, secret_length: 136, low: 0x459a58e4060a6ebeu64, high: 0x79a757cd00ed7205u64),
            BoundaryVector(length: 0, secret_length: 137, low: 0x6c433e8430908e0bu64, high: 0x0185b75c08909137u64),
            BoundaryVector(length: 4, secret_length: 137, low: 0x3e0b9bfd74245d08u64, high: 0x2d644f018f3bb0ceu64),
            BoundaryVector(length: 240, secret_length: 137, low: 0x797a51512f06fa57u64, high: 0x9e938a80c5f5ed17u64),
            BoundaryVector(length: 241, secret_length: 137, low: 0xbe8defd28c7c8733u64, high: 0x3d8e05195b1f13fcu64),
            BoundaryVector(length: 575, secret_length: 137, low: 0x776e86fff1e4543eu64, high: 0x6c117318bdfe6f4bu64),
            BoundaryVector(length: 576, secret_length: 137, low: 0x76c8f5659dc05af7u64, high: 0xa565acc96ff4d519u64),
            BoundaryVector(length: 577, secret_length: 137, low: 0x156159f1c6ced7adu64, high: 0x92395a99760d9ecdu64),
            BoundaryVector(length: 1152, secret_length: 137, low: 0x3725f893fb58f89fu64, high: 0xa90b82a85c6ab670u64),
            BoundaryVector(length: 1153, secret_length: 137, low: 0x3d5b6d7852514ca5u64, high: 0x3380fa62fa7e3b8au64),
        ]
        step("Hash through the production API")
        for vector in vectors:
            val digest = _k_xxh3_128_with_secret(binary_input(vector.length), secret_input(vector.secret_length))
            step("Compare the expected digest")
            expect(digest).to_equal([vector.low, vector.high]) # oracle: pinned upstream XXH3_128bits_withSecret

    it "should match high-bit seed digests across remaining round and stripe boundaries":
        # @req REQ-HASH-XXH3-001
        # @req REQ-HASH-XXH3-002
        # @req REQ-HASH-XXH3-003
        # @capture(binary): exact low/high words for seed 0xffffffffffffffff
        step("Load the published vector")
        val vectors: [BoundaryVector] = [
            BoundaryVector(length: 0, secret_length: 0, low: 0x2d10110a247d19ddu64, high: 0x5334ec22748b5fcdu64),
            BoundaryVector(length: 2, secret_length: 0, low: 0x8c897fbe086c1f94u64, high: 0xdc91bdca33dc8783u64),
            BoundaryVector(length: 7, secret_length: 0, low: 0xf2e13378ded0e329u64, high: 0x9e5d5b6ba887c1e8u64),
            BoundaryVector(length: 15, secret_length: 0, low: 0x91d4bf295d2240f5u64, high: 0xcbd5b5c080265b8bu64),
            BoundaryVector(length: 159, secret_length: 0, low: 0x2752a4743cf983b6u64, high: 0xfda31632f51ce7fdu64),
            BoundaryVector(length: 160, secret_length: 0, low: 0x7ec593e38fdd8006u64, high: 0x928dde50ab016df4u64),
            BoundaryVector(length: 191, secret_length: 0, low: 0x42300157f7c2a6a4u64, high: 0x29cac275545897f2u64),
            BoundaryVector(length: 192, secret_length: 0, low: 0xfd63a66a236ecb78u64, high: 0x15795bbad22d9e2au64),
            BoundaryVector(length: 223, secret_length: 0, low: 0xb60d8127150d71a9u64, high: 0xac6b191b5854fdf5u64),
            BoundaryVector(length: 224, secret_length: 0, low: 0x5de456e9fe78b697u64, high: 0x30b02448c35fafafu64),
            BoundaryVector(length: 239, secret_length: 0, low: 0x4477139d2b86c35au64, high: 0x373c7a308df207e9u64),
            BoundaryVector(length: 240, secret_length: 0, low: 0x9d2734dd5361cd05u64, high: 0x9134d65dc018ccbdu64),
            BoundaryVector(length: 241, secret_length: 0, low: 0x72d1e198c71b2effu64, high: 0x1c8f496d19a44e93u64),
            BoundaryVector(length: 255, secret_length: 0, low: 0xb979ea982fc3f34bu64, high: 0x55461995f01e4a03u64),
            BoundaryVector(length: 256, secret_length: 0, low: 0x9ecaeed6807ded54u64, high: 0x0272d54900af0640u64),
            BoundaryVector(length: 257, secret_length: 0, low: 0x6a7d4cbbc75fa8f9u64, high: 0x114e06a4fcb2bef2u64),
            BoundaryVector(length: 1023, secret_length: 0, low: 0x146a54f548e44585u64, high: 0x100ae0b79aacbdf3u64),
            BoundaryVector(length: 1024, secret_length: 0, low: 0xb8b58a870348a532u64, high: 0x981efc953e3582d9u64),
            BoundaryVector(length: 1025, secret_length: 0, low: 0xa3e265f548404d56u64, high: 0xda8cfd49a62fe118u64),
            BoundaryVector(length: 2048, secret_length: 0, low: 0x4706c51efdc9755cu64, high: 0x0d6dbde146c1b48fu64),
        ]
        step("Hash through the production API")
        for vector in vectors:
            val digest = _k_xxh3_128_seeded(binary_input(vector.length), 0xffffffffffffffffu64)
            step("Compare the expected digest")
            expect(digest).to_equal([vector.low, vector.high]) # oracle: pinned upstream XXH3_128bits_withSeed

    it "should reject undersized secrets before short and long input hashing":
        # @req REQ-HASH-XXH3-004
        # @capture(binary): rejected secrets produce no digest words
        step("Load the published vector")
        val invalid_lengths = [0, 1, 64, 135]
        step("Hash through the production API")
        for length in invalid_lengths:
            for input_length in [0, 4, 241, 577]:
                val digest = _k_xxh3_128_with_secret(binary_input(input_length), secret_input(length))
                step("Compare the expected digest")
                expect(digest).to_equal([]) # oracle: local API fail-closed contract; upstream requires >=136
