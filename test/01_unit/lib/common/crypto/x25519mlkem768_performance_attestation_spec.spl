"""
## Purpose and audience
Purpose: Prove that X25519MLKEM768 qualified performance attestation v5.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @tag: unit, crypto, x25519mlkem768, performance, attestation
# @req NFR-009 NFR-010 NFR-017
# Contract schema: x25519mlkem768-performance-attestation-v5.

use std.spec.{describe, it, expect}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus}
use lib.common.crypto.x25519_mlkem768.measurement_qualification.{
    X25519MlKem768MeasurementQualification}
use lib.common.crypto.x25519_mlkem768.qualified_timing.{
    X25519MlKem768TimingRole,
    X25519MlKem768WarmSetupReceipt,
    X25519MlKem768TimedOperationReceipt,
    X25519MlKem768PairedScheduleReceipt,
    x25519_mlkem768_timing_p50_us,
    x25519_mlkem768_timing_p95_us,
    x25519_mlkem768_timing_p99_us,
    x25519_mlkem768_timing_operations_per_second,
    x25519_mlkem768_sample_set_sha256,
    x25519_mlkem768_timed_operation_receipt_sha256,
    x25519_mlkem768_paired_schedule_receipt_sha256,
    x25519_mlkem768_qualified_timing_sha256}
use lib.common.crypto.x25519_mlkem768.performance_attestation.{
    X25519MlKem768PerformanceMetrics,
    X25519MlKem768PerformanceMeasurement,
    x25519_mlkem768_admit_performance_attestation,
    x25519_mlkem768_performance_receipt_sha256}
use test.helpers.x25519mlkem768_performance_fixture.{
    x25519_mlkem768_synthetic_measurement_qualification,
    x25519_mlkem768_synthetic_warm_setup,
    x25519_mlkem768_synthetic_timed_operations,
    x25519_mlkem768_synthetic_paired_schedule}

fn perf_metrics(warm: X25519MlKem768WarmSetupReceipt,
        timed: X25519MlKem768TimedOperationReceipt
        ) -> X25519MlKem768PerformanceMetrics:
    X25519MlKem768PerformanceMetrics(
        sample_count: timed.samples_ns.len(),
        warmup_count: warm.completed_full_exchanges,
        p50_us: x25519_mlkem768_timing_p50_us(timed),
        p95_us: x25519_mlkem768_timing_p95_us(timed),
        p99_us: x25519_mlkem768_timing_p99_us(timed),
        operations_per_second:
            x25519_mlkem768_timing_operations_per_second(timed),
        max_rss_kb: timed.max_rss_kb)

fn perf_measurement(backend: X25519MlKem768EvidenceBackend,
        qualification: X25519MlKem768MeasurementQualification,
        timing_sha256: text,
        warm: X25519MlKem768WarmSetupReceipt,
        timed: X25519MlKem768TimedOperationReceipt
        ) -> X25519MlKem768PerformanceMeasurement:
    val gpu = backend == X25519MlKem768EvidenceBackend.Cuda or
        backend == X25519MlKem768EvidenceBackend.Vulkan or
        backend == X25519MlKem768EvidenceBackend.Metal
    X25519MlKem768PerformanceMeasurement(
        backend: backend, selected_backend: Some(backend),
        backend_identity: if backend == X25519MlKem768EvidenceBackend.ScalarCpu:
            qualification.target.scalar_backend_identity
        else:
            qualification.target.executor_identity,
        qualification_sha256: qualification.qualification_sha256,
        qualified_timing_sha256: timing_sha256,
        matrix_row_set_sha256: qualification.target.matrix_row_set_sha256,
        scalar_source_receipt_sha256:
            qualification.scalar_source_receipt_sha256,
        candidate_source_receipt_sha256:
            qualification.candidate_source_receipt_sha256,
        sample_set_sha256: timed.sample_set_sha256,
        host_os: qualification.target.host_os,
        host_arch: qualification.target.host_arch,
        session_id: qualification.target.session_id,
        monotonic_clock_id: qualification.target.monotonic_clock_id,
        mode: X25519MlKem768EvidenceMode.Native,
        scope: X25519MlKem768EvidenceScope.FullOperation,
        emulated: false, fallback_used: false, full_end_to_end: true,
        oracle_match: true,
        implementation_version: qualification.implementation_version,
        profile_version: qualification.profile_version,
        fixture_id: qualification.target.fixture_id,
        fixture_manifest_sha256:
            qualification.target.fixture_manifest_sha256,
        fixture_source_sha256: qualification.target.fixture_source_sha256,
        workload_configuration_sha256:
            qualification.target.workload_configuration_sha256,
        backend_configuration_sha256: if
                backend == X25519MlKem768EvidenceBackend.ScalarCpu:
            qualification.target.scalar_configuration_sha256
        else:
            qualification.target.candidate_configuration_sha256,
        compiler_artifact_sha256: "d" * 64,
        compiler_provenance_sha256: "e" * 64,
        compiler_source_revision: "8" * 64,
        runner_source_sha256: qualification.target.runner_source_sha256,
        runner_artifact_sha256: qualification.target.runner_artifact_sha256,
        backend_artifact_sha256: if
                backend == X25519MlKem768EvidenceBackend.ScalarCpu:
            qualification.target.scalar_backend_artifact_sha256
        else:
            qualification.target.backend_artifact_sha256,
        crypto_source_sha256: "4" * 64,
        accelerator_source_sha256: if gpu: "5" * 64 else: "",
        accelerator_artifact_sha256:
            if gpu: qualification.target.backend_artifact_sha256 else: "",
        accelerator_build_binding_sha256: if gpu: "7" * 64 else: "",
        batch_size: qualification.batch_size,
        metrics: perf_metrics(warm, timed),
        gpu_transfer_included: gpu, gpu_launch_included: gpu,
        gpu_synchronization_included: gpu, gpu_readback_included: gpu)

struct X25519MlKem768SyntheticPerformancePair:
    scalar_warm: X25519MlKem768WarmSetupReceipt
    candidate_warm: X25519MlKem768WarmSetupReceipt
    scalar_timed: X25519MlKem768TimedOperationReceipt
    candidate_timed: X25519MlKem768TimedOperationReceipt
    schedule: X25519MlKem768PairedScheduleReceipt
    scalar: X25519MlKem768PerformanceMeasurement
    candidate: X25519MlKem768PerformanceMeasurement

fn perf_pair(qualification: X25519MlKem768MeasurementQualification,
        scalar_base_ns: i64,
        candidate_base_ns: i64) -> X25519MlKem768SyntheticPerformancePair:
    val scalar_warm = x25519_mlkem768_synthetic_warm_setup(
        qualification, X25519MlKem768TimingRole.ScalarReference)
    val candidate_warm = x25519_mlkem768_synthetic_warm_setup(
        qualification, X25519MlKem768TimingRole.Candidate)
    val scalar_timed = x25519_mlkem768_synthetic_timed_operations(
        qualification, scalar_warm, scalar_base_ns)
    val candidate_timed = x25519_mlkem768_synthetic_timed_operations(
        qualification, candidate_warm, candidate_base_ns)
    val schedule = x25519_mlkem768_synthetic_paired_schedule(
        qualification, scalar_timed, candidate_timed)
    val timing_sha256 = x25519_mlkem768_qualified_timing_sha256(
        qualification, scalar_warm, candidate_warm,
        scalar_timed, candidate_timed, schedule)
    X25519MlKem768SyntheticPerformancePair(
        scalar_warm: scalar_warm, candidate_warm: candidate_warm,
        scalar_timed: scalar_timed, candidate_timed: candidate_timed,
        schedule: schedule,
        scalar: perf_measurement(
            X25519MlKem768EvidenceBackend.ScalarCpu,
            qualification, timing_sha256, scalar_warm, scalar_timed),
        candidate: perf_measurement(
            qualification.target.backend,
            qualification, timing_sha256, candidate_warm, candidate_timed))

fn admit_pair(qualification: X25519MlKem768MeasurementQualification,
        pair: X25519MlKem768SyntheticPerformancePair):
    x25519_mlkem768_admit_performance_attestation(
        qualification, pair.scalar_warm, pair.candidate_warm,
        pair.scalar_timed, pair.candidate_timed,
        pair.schedule,
        pair.scalar, pair.candidate,
        x25519_mlkem768_performance_receipt_sha256(
            pair.scalar, pair.candidate))

describe "X25519MLKEM768 qualified performance attestation v5":
    it "admits qualified SIMD and GPU at their exact NFR thresholds":
        step("Verify: admits qualified SIMD and GPU at their exact NFR thresholds")
        # @req: REQ-LIB-COMMON-001
        val simd_qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Avx2)
        val simd_pair = perf_pair(simd_qualification, 122000, 72000)
        val simd_receipt = admit_pair(simd_qualification, simd_pair)
        expect(simd_receipt.status).to_equal(
            X25519MlKem768EvidenceStatus.Pass)
        expect(simd_receipt.speedup_milli).to_equal(1500)  # oracle: 1500 — named expected value from the requirement
        expect(simd_receipt.scalar_sample_set_sha256).to_equal(
            simd_pair.scalar_timed.sample_set_sha256)
        val gpu_qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Cuda)
        val gpu_pair = perf_pair(gpu_qualification, 97000, 72000)
        val gpu_receipt = admit_pair(gpu_qualification, gpu_pair)
        expect(gpu_receipt.status).to_equal(
            X25519MlKem768EvidenceStatus.Pass)
        expect(gpu_receipt.speedup_milli).to_equal(1250)  # oracle: 1250 — named expected value from the requirement

    it "rejects synthetic aggregates without the matching qualification":
        step("Verify: rejects synthetic aggregates without the matching qualification")
        val avx = x25519_mlkem768_synthetic_measurement_qualification(
            X25519MlKem768EvidenceBackend.Avx2)
        val neon = x25519_mlkem768_synthetic_measurement_qualification(
            X25519MlKem768EvidenceBackend.Neon)
        val pair = perf_pair(avx, 122000, 72000)
        val receipt = admit_pair(neon, pair)
        expect(receipt.status).to_equal(
            X25519MlKem768EvidenceStatus.Blocked)
        expect(receipt.reason).to_equal("measurement-qualification-mismatch")

    it "rejects a stale matrix row-set or source receipt binding":
        step("Verify: rejects a stale matrix row-set or source receipt binding")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Rvv)
        var pair = perf_pair(qualification, 122000, 72000)
        pair.candidate.matrix_row_set_sha256 = "7" * 64
        val receipt = admit_pair(qualification, pair)
        expect(receipt.reason).to_equal("measurement-qualification-mismatch")

    it "rejects a full-operation speedup below the backend threshold":
        step("Verify: rejects a full-operation speedup below the backend threshold")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Avx2)
        val pair = perf_pair(qualification, 121000, 72000)
        val receipt = admit_pair(qualification, pair)
        expect(receipt.speedup_milli).to_equal(1490)  # oracle: 1490 — named expected value from the requirement
        expect(receipt.reason).to_equal(
            "full-operation-speedup-below-threshold")

    it "rejects stale toolchain identity and insufficient samples":
        step("Verify: rejects stale toolchain identity and insufficient samples")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Neon)
        var stale = perf_pair(qualification, 122000, 72000)
        stale.candidate.crypto_source_sha256 = "8" * 64
        expect(admit_pair(qualification, stale).reason).to_equal(
            "shared-workload-or-toolchain-identity-mismatch")
        var wrong_aggregate = perf_pair(qualification, 122000, 72000)
        wrong_aggregate.candidate.metrics.sample_count = 29
        expect(admit_pair(qualification, wrong_aggregate).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var wrong_scalar_config = perf_pair(qualification, 122000, 72000)
        wrong_scalar_config.scalar.backend_configuration_sha256 = "8" * 64
        expect(admit_pair(qualification, wrong_scalar_config).reason).to_equal(
            "measurement-qualification-mismatch")

    it "requires equal scalar and candidate sample counts":
        step("Verify: requires equal scalar and candidate sample counts")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Avx2)
        var pair = perf_pair(qualification, 122000, 72000)
        pair.candidate_timed.samples_ns.push(102000)
        pair.candidate_timed.sample_set_sha256 =
            x25519_mlkem768_sample_set_sha256(
                pair.candidate_timed.samples_ns)
        pair.candidate_timed.full_exchange_count = 31
        pair.candidate_timed.hybrid_operation_count = 93
        pair.candidate_timed.accelerated_operation_count = 93
        pair.candidate_timed.simd_chunk_hits = 93
        pair.candidate_timed.receipt_sha256 =
            x25519_mlkem768_timed_operation_receipt_sha256(
                pair.candidate_timed)
        val timing_sha256 = x25519_mlkem768_qualified_timing_sha256(
            qualification, pair.scalar_warm, pair.candidate_warm,
            pair.scalar_timed, pair.candidate_timed, pair.schedule)
        pair.scalar.qualified_timing_sha256 = timing_sha256
        pair.candidate.qualified_timing_sha256 = timing_sha256
        pair.candidate.sample_set_sha256 =
            pair.candidate_timed.sample_set_sha256
        pair.candidate.metrics = perf_metrics(
            pair.candidate_warm, pair.candidate_timed)
        expect(admit_pair(qualification, pair).reason).to_equal(
            "qualified-timing-sample-count-mismatch")

    it "rejects every malformed derived metric boundary before qualification":
        step("Verify: rejects every malformed derived metric boundary before qualification")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Avx2)
        var warmups = perf_pair(qualification, 122000, 72000)
        warmups.candidate.metrics.warmup_count = 1
        expect(admit_pair(qualification, warmups).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var p50 = perf_pair(qualification, 122000, 72000)
        p50.candidate.metrics.p50_us = 0
        expect(admit_pair(qualification, p50).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var p95 = perf_pair(qualification, 122000, 72000)
        p95.candidate.metrics.p95_us = 0
        expect(admit_pair(qualification, p95).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var p99 = perf_pair(qualification, 122000, 72000)
        p99.candidate.metrics.p99_us = 0
        expect(admit_pair(qualification, p99).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var p50_order = perf_pair(qualification, 122000, 72000)
        p50_order.candidate.metrics.p50_us =
            p50_order.candidate.metrics.p95_us + 1
        expect(admit_pair(qualification, p50_order).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var p95_order = perf_pair(qualification, 122000, 72000)
        p95_order.candidate.metrics.p99_us =
            p95_order.candidate.metrics.p95_us - 1
        expect(admit_pair(qualification, p95_order).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var speedup_overflow = perf_pair(qualification, 122000, 72000)
        speedup_overflow.scalar.metrics.p95_us = 9223372036854776
        speedup_overflow.scalar.metrics.p99_us = 9223372036854776
        expect(admit_pair(qualification, speedup_overflow).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var throughput = perf_pair(qualification, 122000, 72000)
        throughput.candidate.metrics.operations_per_second = 0
        expect(admit_pair(qualification, throughput).reason).to_equal(
            "invalid-native-full-operation-measurement")
        var rss = perf_pair(qualification, 122000, 72000)
        rss.candidate.metrics.max_rss_kb = 0
        expect(admit_pair(qualification, rss).reason).to_equal(
            "invalid-native-full-operation-measurement")

    it "rejects GPU timing that omits transfer launch sync or readback":
        step("Verify: rejects GPU timing that omits transfer launch sync or readback")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Vulkan)
        var pair = perf_pair(qualification, 97000, 72000)
        pair.candidate.gpu_readback_included = false
        expect(admit_pair(qualification, pair).reason).to_equal(
            "gpu-end-to-end-lifecycle-incomplete")
        var stale_kernel_count = perf_pair(qualification, 97000, 72000)
        stale_kernel_count.candidate_timed.gpu_kernel_count =
            stale_kernel_count.candidate_timed.gpu_kernel_count + 1
        expect(admit_pair(qualification, stale_kernel_count).reason).to_equal(
            "candidate-timed-operations-invalid")

    it "rejects altered raw samples and mismatched qualified timing identity":
        step("Verify: rejects altered raw samples and mismatched qualified timing identity")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Avx2)
        var altered = perf_pair(qualification, 122000, 72000)
        altered.candidate_timed.samples_ns[0] = 1
        expect(admit_pair(qualification, altered).reason).to_equal(
            "candidate-timed-operations-invalid")
        var misordered = perf_pair(qualification, 122000, 72000)
        misordered.schedule.ordinal_base = 1
        misordered.schedule.receipt_sha256 =
            x25519_mlkem768_paired_schedule_receipt_sha256(
                misordered.schedule)
        expect(admit_pair(qualification, misordered).reason).to_equal(
            "qualified-timing-paired-schedule-invalid")
        var identity = perf_pair(qualification, 122000, 72000)
        identity.candidate.qualified_timing_sha256 = "7" * 64
        expect(admit_pair(qualification, identity).reason).to_equal(
            "qualified-timing-sha256-mismatch")

    it "changes the canonical receipt when a retained sample-set hash changes":
        step("Verify: changes the canonical receipt when a retained sample-set hash changes")
        val qualification =
            x25519_mlkem768_synthetic_measurement_qualification(
                X25519MlKem768EvidenceBackend.Avx2)
        val pair = perf_pair(qualification, 122000, 72000)
        val baseline = x25519_mlkem768_performance_receipt_sha256(
            pair.scalar, pair.candidate)
        var changed = pair.candidate
        changed.sample_set_sha256 = "7" * 64
        expect(x25519_mlkem768_performance_receipt_sha256(
            pair.scalar, changed) == baseline).to_be(false)
