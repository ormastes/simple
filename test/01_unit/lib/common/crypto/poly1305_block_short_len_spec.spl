"""poly1305_block over a short block: only the first block_len bytes count.

`poly1305_block(st, block, block_len, hibit)` accumulates the little-endian
integer of block[0..block_len) plus hibit * 2^128 (bytes past block_len are
ignored). It used to load whole 4-byte words only (`block_len >= 4/8/12/16`),
silently dropping 1-3 trailing bytes and every byte of a block shorter than
4. Callers in this module pass 16, but the function is public. Expected tags
for one block (lengths 1..16, hibit 0 and 1, block bytes past block_len are
nonzero on purpose) from a big-integer reference:
tag = ((m * clamp(r)) mod (2^130 - 5) + s) mod 2^128.
"""
# @req REQ-SSPEC-LIB

use std.spec.*
use std.common.crypto.poly1305.{poly1305_init, poly1305_block, poly1305_finalize}
use os.crypto.poly1305 as os_poly

fn hex_nibble(c: i64) -> i64:
    if c >= 97:
        return c - 87
    c - 48

fn hex_bytes(h: text) -> [u8]:
    var out: [u8] = [0u8; h.len() / 2]
    var i = 0
    while i < out.len():
        out[i] = (hex_nibble(h.char_code_at(2 * i)) * 16 + hex_nibble(h.char_code_at(2 * i + 1))).to_u8()
        i = i + 1
    out

val KEY = "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"
val BLOCK = "a0a7aeb5bcc3cad1d8dfe6edf4fb0209"
# [block_len, hibit, tag]
val ROWS: [[text]] = [
    ["1", "0", "2616c60181620722cd8c61a34a913a20"],
    ["2", "0", "b1dfb67f3534b17409730e4ea25a5795"],
    ["3", "0", "7eb1234eeb25cf7359c758da8c16e186"],
    ["4", "0", "78bb3b5e9713feddad14c588f84001d1"],
    ["5", "0", "427d81bc4a9d234a64be0f0d0b8c6b55"],
    ["6", "0", "e43a0d3eeff38aa70dc10e55a70296ff"],
    ["7", "0", "0b5bbb93acde84eca2a75da9ecb67009"],
    ["8", "0", "6dcf5832ccd7b589c574814496f93c48"],
    ["9", "0", "3a0a1d4d5bc1ea00067586a57df87c2c"],
    ["10", "0", "f5122f61f3409e71c35864e21b2cd169"],
    ["11", "0", "40ec744a57560eef6f5ceb9d90075113"],
    ["12", "0", "3b326ccd170aa14fb74435c829b469df"],
    ["13", "0", "5edbaee2d7a1a45f08565958f72a4e35"],
    ["14", "0", "129902220b9f13b3959734b8cd9ba251"],
    ["15", "0", "f2ae54779ca7495e63bb54cddeafacfe"],
    ["16", "0", "dc11b7689c3570d1e5d8f5ddbdfc06ac"],
    ["1", "1", "4ba2b40c2a0d5026686248b5da1b432a"],
    ["2", "1", "d66ba58adedef978a448f55f32e55f9f"],
    ["3", "1", "a33d125994d01778f49c3fec1ca1e990"],
    ["4", "1", "9d472a6940be46e248eaab9a88cb09db"],
    ["5", "1", "6c0970c7f3476c4eff93f61e9b16745f"],
    ["6", "1", "0ec7fb48989ed3aba896f566378d9e09"],
    ["7", "1", "30e7a99e5589cdf03d7d44bb7c417913"],
    ["8", "1", "975b473d7582fe8d604a685626844552"],
    ["9", "1", "5f960b58046c3305a14a6db70d838536"],
    ["10", "1", "1a9f1d6c9cebe6755e2e4bf4abb6d973"],
    ["11", "1", "65786355000157f30a32d2af2092591d"],
    ["12", "1", "65be5ad8c0b4e953521a1cdab93e72e9"],
    ["13", "1", "83679ded804ced63a32b406a87b5563f"],
    ["14", "1", "3c25f12cb4495cb7306d1bca5d26ab5b"],
    ["15", "1", "173b438245529262fe903bdf6e3ab508"],
    ["16", "1", "069ea57345e0b8d580aedcef4d870fb6"]
]

describe "poly1305_block short-block contract":
    it "accumulates exactly block_len bytes for lengths 1..16 (std.common)":
        for row in ROWS:
            val n = row[0].to_i64() ?? 0
            val hibit = (row[1].to_i64() ?? 0).to_u32()
            val st = poly1305_block(poly1305_init(hex_bytes(KEY)), hex_bytes(BLOCK), n.to_u64(), hibit)
            expect(poly1305_finalize(st)).to_equal(hex_bytes(row[2]))

    it "the os.crypto twin agrees":
        for row in ROWS:
            val n = row[0].to_i64() ?? 0
            val hibit = (row[1].to_i64() ?? 0).to_u32()
            val st = os_poly.poly1305_block(os_poly.poly1305_init(hex_bytes(KEY)), hex_bytes(BLOCK), n.to_u64(), hibit)
            expect(os_poly.poly1305_finalize(st)).to_equal(hex_bytes(row[2]))
