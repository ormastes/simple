# Purpose and audience: public pbkdf2_sha512_bytes is native-first (rt_pbkdf2_hmac_sha512); it must stay byte-identical to the pure-Simple reference twin pbkdf2_sha512_bytes_pure and to the published draft-josefsson-pbkdf2-test-vectors, and a sqlcipher4-sized (256000-iteration) derivation must finish in seconds, not minutes, in the interpreter.
# @req REQ-SSPEC-UNIT
# Dual-run twin: native primitive vs pure-Simple reference (doc/07_guide/os/hal/pure_simple_hal.md).

use std.spec.step
use std.spipe.*
use std.common.crypto.pbkdf2.{pbkdf2_sha512_bytes, pbkdf2_sha512_bytes_pure, pbkdf2_sha512_bytes_fast}
use std.crypto.types.{bytes_to_hex}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

fn _b(s: text) -> [u8]:
    var out: [u8] = []
    for c in s.bytes():
        out.push(c.to_u8())
    out

fn _rep(s: text, n: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < n:
        out = out + s
        i = i + 1
    out

describe "PBKDF2-HMAC-SHA-512 native-first public API":
    it "draft-josefsson TC1 c=1 dkLen=64":
        step("public path, TC1")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 1, 64))).to_equal(
            "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce")

    it "draft-josefsson TC2 c=2 dkLen=64":
        step("public path, TC2")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 2, 64))).to_equal(
            "e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e")

    it "draft-josefsson TC3 c=4096 dkLen=64":
        step("public path, TC3")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 4096, 64))).to_equal(
            "d197b1b33db0143e018b12f3d1d1479e6cdebdcc97c5c0f87f6902e072f457b5143f30602641b3d55cd335988cb36b84376060ecd532e039b742a239434af2d5")

    it "draft-josefsson TC4 long password and salt c=4096 dkLen=64":
        step("public path, TC4")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("passwordPASSWORDpassword"), _b("saltSALTsaltSALTsaltSALTsaltSALTsalt"), 4096, 64))).to_equal(
            "8c0511f4c6e597c6ac6315d8f0362e225f3c501495ba23b868c005174dc4ee71115b59f9e60cd9532fa33e0f75aefe30225c583a186cd82bd4daea9724a3d3b8")

    it "embedded NUL bytes, truncated dkLen=16 (hashlib oracle)":
        step("NUL-bearing password and salt")
        val pw: [u8] = [112u8, 97u8, 115u8, 115u8, 0u8, 119u8, 111u8, 114u8, 100u8]
        val salt: [u8] = [115u8, 97u8, 0u8, 108u8, 116u8]
        expect(bytes_to_hex(pbkdf2_sha512_bytes(pw, salt, 4096, 16))).to_equal("9d9e9c4cd21fe4be24d5b8244c759665")

    it "native equals the pure-Simple twin across block, key-length and edge shapes":
        step("multi-block dkLen=150 (counter 1..3)")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b("password"), _b("salt"), 3, 150))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure(_b("password"), _b("salt"), 3, 150)))
        step("password longer than the 128-byte block is pre-hashed")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b(_rep("k", 150)), _b("salt"), 3, 64))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure(_b(_rep("k", 150)), _b("salt"), 3, 64)))
        step("password exactly one block, and empty password")
        expect(bytes_to_hex(pbkdf2_sha512_bytes(_b(_rep("q", 128)), _b("salt"), 2, 64))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure(_b(_rep("q", 128)), _b("salt"), 2, 64)))
        expect(bytes_to_hex(pbkdf2_sha512_bytes([], _b("salt"), 2, 64))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure([], _b("salt"), 2, 64)))
        step("fast entry point agrees")
        expect(bytes_to_hex(pbkdf2_sha512_bytes_fast(_b("password"), _b("salt"), 3, 150))).to_equal(
            bytes_to_hex(pbkdf2_sha512_bytes_pure(_b("password"), _b("salt"), 3, 150)))

    it "sqlcipher4-sized c=256000 dkLen=32 is correct and finishes in seconds":
        step("256000 iterations through the public entry point")
        val t0 = time_now_unix_micros()
        val dk = pbkdf2_sha512_bytes(_b("password"), _b("salt"), 256000, 32)
        val elapsed_us = time_now_unix_micros() - t0
        expect(bytes_to_hex(dk)).to_equal("c881e84434887fcad1cd37801abf077eb33abd4c70ed10b64b17643c7ef7405e")
        step("pure interpreted loop takes ~12 min here; native takes ~0.25 s")
        expect(elapsed_us < 30000000).to_equal(true)
