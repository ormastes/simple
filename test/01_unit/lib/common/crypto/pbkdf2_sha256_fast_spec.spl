# Purpose and audience: PBKDF2-HMAC-SHA-256 runtime-SHA-256 fast path must match the pure-Simple path and the RFC 7914 / draft-josefsson vectors.
# @req REQ-SSPEC-UNIT

use std.spec.step
use std.spipe.*
use std.common.crypto.pbkdf2.{pbkdf2_sha256_bytes, pbkdf2_sha256_bytes_pure}
use std.crypto.types.{bytes_to_hex}

fn _b(s: text) -> [i64]:
    var out: [i64] = []
    for c in s.bytes():
        out.push(c as i64)
    out

describe "PBKDF2-HMAC-SHA-256 fast path":
    it "RFC 7914 vector: passwd/salt c=1 dkLen=64":
        step("RFC 7914 §11 vector 1")
        expect(bytes_to_hex(pbkdf2_sha256_bytes(_b("passwd"), _b("salt"), 1, 64))).to_equal(
            "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783")

    it "RFC 7914 vector: Password/NaCl c=80000 dkLen=64":
        step("RFC 7914 §11 vector 2")
        expect(bytes_to_hex(pbkdf2_sha256_bytes(_b("Password"), _b("NaCl"), 80000, 64))).to_equal(
            "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d")

    it "multi-block dkLen=70 with big-endian counter equals pure path":
        step("block counter")
        val fast = pbkdf2_sha256_bytes(_b("password"), _b("salt"), 7, 70)
        val pure = pbkdf2_sha256_bytes_pure(_b("password"), _b("salt"), 7, 70)
        expect(bytes_to_hex(fast)).to_equal(bytes_to_hex(pure))

    it "key longer than the 64-byte block equals pure path":
        step("long key")
        var key = ""
        var i = 0
        while i < 90:
            key = key + "k"
            i = i + 1
        val fast = pbkdf2_sha256_bytes(_b(key), _b("salt"), 5, 40)
        val pure = pbkdf2_sha256_bytes_pure(_b(key), _b("salt"), 5, 40)
        expect(bytes_to_hex(fast)).to_equal(bytes_to_hex(pure))

    it "empty password and 64-byte key equal pure path":
        step("edge keys")
        val a = pbkdf2_sha256_bytes([], _b("salt"), 3, 32)
        val b = pbkdf2_sha256_bytes_pure([], _b("salt"), 3, 32)
        expect(bytes_to_hex(a)).to_equal(bytes_to_hex(b))
