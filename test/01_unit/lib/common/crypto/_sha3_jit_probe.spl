# Probe body for sha3_jit_engine_divergence_spec.spl. Not a spec: it is run as
# a subprocess under an explicit SIMPLE_EXECUTION_MODE so the JIT can be
# observed, which a spec body cannot do. Kept minimal on purpose -- a single
# unsupported operation demotes the WHOLE program back to the interpreter.
use std.common.crypto.sha3

fn _bytes(tag: text, b: list) -> text:
    var s = tag + "="
    var i = 0
    while i < b.len():
        if i > 0:
            s = s + " "
        s = s + b.get(i).to_string()
        i = i + 1
    s

fn main():
    print(_bytes("empty", sha3_256_bytes([])))
    print(_bytes("abc", sha3_256_bytes([97, 98, 99])))
    val p60 = 1152921504606846976
    print("pow=" + p60.to_string() + " " + (p60 * 2).to_string() + " " + (p60 * 4).to_string() + " " + (p60 * 8).to_string())
