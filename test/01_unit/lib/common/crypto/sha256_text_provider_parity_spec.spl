"""Exact SHA-256 text bytes through the production runtime provider.

Pins were generated once from UTF-8 bytes with .NET SHA256 during authoring.
These assertions are NOT RUN until a corrected qualified producer is selected.
"""
use std.spec
use std.common.crypto.sha256.{sha256_text}
use std.common.string_core.{str_repeat}

describe "SHA-256 text provider parity":
    it "preserves empty and ASCII digests":
        expect(sha256_text("")).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
        expect(sha256_text("abc")).to_equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

    it "hashes exact multi-byte UTF-8":
        expect(sha256_text("한🙂")).to_equal("7a76d3e6f2edda1ecdf9b4f5792946797d910d841b3a241d5d698a57b396d1e8")

    it "retains bytes after an embedded NUL":
        expect(sha256_text("a\0b")).to_equal("59b271ae1bbcb1d31d41929817f4b16fb439eb4f31520b5ad1d5ce98920a7138")

    it "preserves SHA-256 padding and block boundaries":
        val lengths: [i64] = [55, 56, 63, 64, 65, 127, 128, 129]
        val digests: [text] = [
            "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318",
            "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a",
            "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34",
            "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb",
            "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0",
            "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a",
            "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e",
            "c12cb024a2e5551cca0e08fce8f1c5e314555cc3fef6329ee994a3db752166ae"
        ]
        for idx in 0..lengths.len():
            expect(sha256_text(str_repeat("a", lengths[idx]))).to_equal(digests[idx])
