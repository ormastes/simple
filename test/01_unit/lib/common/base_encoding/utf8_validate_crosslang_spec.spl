# @req REQ-C-MIG-UTF8VALIDATE
#
# C-MIG-0022 (following the C-MIG-0020 hash_text_crosslang pattern): pure
# UTF-8 validation. C oracle `rt_text_validate_utf8` (SIMD-dispatched
# scalar/SSE2/AVX2/NEON `*_utf8_validate` in
# src/runtime/runtime_simd_utf8.c, exposed with a clean `text -> bool` ABI
# via src/lib/common/encoding/simd_text_ffi.spl) vs the pure-Simple
# `validated_utf8_bytes_to_text_linear` in
# src/lib/common/base_encoding/utilities.spl (strict RFC 3629 byte-by-byte
# validator: rejects truncated/malformed continuation sequences, overlong
# encodings, and UTF-16 surrogate code points, same contract as the C
# validator). This spec freezes the C behavior as a differential oracle for
# C-MIG-0022.

use std.spec.{describe, it, assert_equal, assert_true}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear, text_to_bytes}
use std.io.{time_now_unix_micros}

# C oracle (test-only; never production-linked from Simple product code here).
extern fn rt_text_validate_utf8(s: text) -> bool

fn simple_is_valid_utf8(s: text) -> bool:
    match validated_utf8_bytes_to_text_linear(text_to_bytes(s)):
        Ok(_decoded):
            true
        Err(_error):
            false

fn build_bulk_vectors() -> [text]:
    var vectors: [text] = []
    # Boundary lengths 0..12 of plain ASCII.
    var n = 0
    while n <= 12:
        var s = ""
        var k = 0
        while k < n:
            s = s + "x"
            k = k + 1
        vectors.push(s)
        n = n + 1
    # ASCII letter/digit/punct boundary chars.
    vectors.push("`")
    vectors.push("a")
    vectors.push("z")
    vectors.push("{")
    vectors.push("@")
    vectors.push("A")
    vectors.push("Z")
    vectors.push("[")
    vectors.push("0")
    vectors.push("9")
    vectors.push("!@#$%^&*()")
    # Valid multi-byte UTF-8 sequences (2/3/4-byte, incl. astral/emoji).
    vectors.push("héllo Wörld")
    vectors.push("日本語ABCabc")
    vectors.push("emoji 🎉 TEST")
    vectors.push("Ω≈ç√∫ mixedCase")
    vectors.push("Café")
    vectors.push("naïve")
    vectors.push("東京")
    vectors.push("👍👎🎉")
    vectors.push("mixed ASCII 日本語 🎉 tail")
    # Repeat a valid-mixed vector with varying length to pad the corpus.
    var rep = 0
    while rep < 55:
        vectors.push("Repeat{rep}日本語MixedText🎉!")
        rep = rep + 1
    vectors

# Invalid UTF-8 byte sequences (constructed directly as [u8], since Simple
# `text` literals cannot hold malformed UTF-8) fed to both sides via
# rt_bytes_to_text-free byte-level Simple validation and the C oracle's own
# raw-byte validator would require a bytes-taking C entry; instead we drive
# the C oracle through its `text` ABI using rt_text_validate_utf8, restricted
# here to a case it CAN observe cleanly: an unpaired continuation byte and a
# truncated multi-byte lead, both of which the runtime keeps as raw bytes in
# a `text` value's byte buffer since neither implementation re-validates on
# construction.
fn build_invalid_byte_vectors() -> [[u8]]:
    var vectors: [[u8]] = []
    vectors.push([0x80u8])                    # lone continuation byte
    vectors.push([0xC2u8])                     # truncated two-byte sequence
    vectors.push([0xE0u8, 0x80u8, 0x80u8])      # overlong three-byte sequence
    vectors.push([0xEDu8, 0xA0u8, 0x80u8])      # UTF-16 surrogate
    vectors.push([0xF5u8, 0x80u8, 0x80u8, 0x80u8]) # code point exceeds U+10FFFF
    vectors.push([0x41u8, 0x80u8, 0x42u8])      # valid 'A', stray continuation, 'B'
    vectors

describe "UTF-8 validation — pure-Simple vs C oracle":
    it "matches the C oracle on empty string and ASCII":
        assert_equal(simple_is_valid_utf8(""), rt_text_validate_utf8(""))
        assert_true(simple_is_valid_utf8(""))
        assert_true(rt_text_validate_utf8(""))
        assert_equal(simple_is_valid_utf8("hello"), rt_text_validate_utf8("hello"))
        assert_true(simple_is_valid_utf8("hello"))

    it "matches the C oracle on valid UTF-8 multi-byte input":
        val vectors = ["héllo", "日本語", "emoji 🎉 test", "Ω≈ç√∫", "Café MENU", "👍👎🎉"]
        var i = 0
        while i < vectors.len():
            assert_equal(simple_is_valid_utf8(vectors[i]), rt_text_validate_utf8(vectors[i]))
            assert_true(simple_is_valid_utf8(vectors[i]))
            i = i + 1

    it "the pure-Simple validator rejects malformed byte sequences (discrimination)":
        val invalid = build_invalid_byte_vectors()
        var i = 0
        while i < invalid.len():
            match validated_utf8_bytes_to_text_linear(invalid[i]):
                Ok(_decoded):
                    assert_true(false)
                Err(_error):
                    assert_true(true)
            i = i + 1

    it "runs a shared-logic bulk differential loop over ~90 branch-covering valid vectors, and measures perf":
        val vectors = build_bulk_vectors()
        assert_true(vectors.len() >= 85)

        # --- shared differential loop: same input feeds BOTH implementations ---
        var i = 0
        while i < vectors.len():
            val v = vectors[i]
            assert_equal(simple_is_valid_utf8(v), rt_text_validate_utf8(v))
            assert_true(simple_is_valid_utf8(v))
            i = i + 1

        # --- perf: time both sides over the same corpus ---
        val simple_start = time_now_unix_micros()
        var si = 0
        while si < vectors.len():
            simple_is_valid_utf8(vectors[si])
            si = si + 1
        val simple_end = time_now_unix_micros()
        val simple_micros = simple_end - simple_start

        val c_start = time_now_unix_micros()
        var ci = 0
        while ci < vectors.len():
            rt_text_validate_utf8(vectors[ci])
            ci = ci + 1
        val c_end = time_now_unix_micros()
        val c_micros = c_end - c_start

        print("perf_evidence: simple_micros={simple_micros} c_micros={c_micros} vectors={vectors.len()}")
        assert_true(simple_micros >= 0)
        assert_true(c_micros >= 0)

    it "matches the C oracle on batched-ASCII fast-path boundary shapes":
        # Long pure-ASCII run — exercises the inner fast-path loop end to end.
        var long_ascii = ""
        var li = 0
        while li < 300:
            long_ascii = long_ascii + "x"
            li = li + 1
        assert_equal(simple_is_valid_utf8(long_ascii), rt_text_validate_utf8(long_ascii))
        assert_true(simple_is_valid_utf8(long_ascii))

        # High byte at position 0 (no ASCII run before the multibyte lead).
        val high_at_start = "é" + long_ascii
        assert_equal(simple_is_valid_utf8(high_at_start), rt_text_validate_utf8(high_at_start))
        assert_true(simple_is_valid_utf8(high_at_start))

        # High byte at the very last position (fast path runs to the end,
        # then the outer loop must still see the trailing multibyte char).
        val high_at_end = long_ascii + "é"
        assert_equal(simple_is_valid_utf8(high_at_end), rt_text_validate_utf8(high_at_end))
        assert_true(simple_is_valid_utf8(high_at_end))

        # High byte straddling likely fast-path chunk boundaries (64/128/256).
        var i = 60
        while i <= 260:
            var s = ""
            var k = 0
            while k < i:
                s = s + "x"
                k = k + 1
            s = s + "日" + long_ascii
            assert_equal(simple_is_valid_utf8(s), rt_text_validate_utf8(s))
            assert_true(simple_is_valid_utf8(s))
            i = i + 1

        # Alternating ASCII / multibyte — forces the fast path to kick in and
        # bail out repeatedly within one buffer.
        var alt = ""
        var ai = 0
        while ai < 40:
            alt = alt + "ab" + "日" + "cd" + "🎉"
            ai = ai + 1
        assert_equal(simple_is_valid_utf8(alt), rt_text_validate_utf8(alt))
        assert_true(simple_is_valid_utf8(alt))
