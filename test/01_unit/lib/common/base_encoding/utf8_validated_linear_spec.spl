# @req: REQ-LIB-COMMON-BASEENCODING-001

# @cover src/lib/common/base_encoding/utilities.spl
# @tag: unit, encoding, utf8

use std.spec.*
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear, text_to_bytes_linear}

fn _expect_same_bytes(actual: [u8], expected: [u8]):
    expect(actual.len()).to_equal(expected.len())
    var i = 0
    while i < actual.len():
        expect(actual[i]).to_equal(expected[i])
        i = i + 1

fn _expect_utf8_success(bytes: [u8]):
    match validated_utf8_bytes_to_text_linear(bytes):
        Err(_error):
            expect(false).to_equal(true)
        Ok(decoded):
            _expect_same_bytes(text_to_bytes_linear(decoded), bytes)

fn _expect_utf8_error(bytes: [u8], family: text):
    match validated_utf8_bytes_to_text_linear(bytes):
        Ok(_decoded):
            expect(false).to_equal(true)
        Err(error):
            expect(error).to_contain(family)

use std.spec.step

describe "linear validated UTF-8 owner facade":

    it "accepts ASCII including NUL and DEL":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: accepts ASCII including NUL and DEL")
        _expect_utf8_success([0u8, 65u8, 127u8])

    it "accepts two-byte lower and upper boundaries":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: accepts two-byte lower and upper boundaries")
        _expect_utf8_success([0xC2u8, 0x80u8, 0xDFu8, 0xBFu8])

    it "accepts three-byte lower and upper boundaries":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: accepts three-byte lower and upper boundaries")
        _expect_utf8_success([0xE0u8, 0xA0u8, 0x80u8, 0xEFu8, 0xBFu8, 0xBFu8])

    it "accepts four-byte lower and upper boundaries":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: accepts four-byte lower and upper boundaries")
        _expect_utf8_success([0xF0u8, 0x90u8, 0x80u8, 0x80u8, 0xF4u8, 0x8Fu8, 0xBFu8, 0xBFu8])

    it "rejects C0 C1 and F5 invalid leading bytes":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: rejects C0 C1 and F5 invalid leading bytes")
        _expect_utf8_error([0xC0u8, 0x80u8], "invalid leading byte")
        _expect_utf8_error([0xC1u8, 0xBFu8], "invalid leading byte")
        _expect_utf8_error([0xF5u8, 0x80u8, 0x80u8, 0x80u8], "invalid leading byte")

    it "rejects overlong surrogate and out-of-range special sequences":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: rejects overlong surrogate and out-of-range special sequences")
        _expect_utf8_error([0xE0u8, 0x9Fu8, 0xBFu8], "overlong three-byte sequence")
        _expect_utf8_error([0xEDu8, 0xA0u8, 0x80u8], "surrogate code point")
        _expect_utf8_error([0xF0u8, 0x8Fu8, 0xBFu8, 0xBFu8], "overlong four-byte sequence")
        _expect_utf8_error([0xF4u8, 0x90u8, 0x80u8, 0x80u8], "code point exceeds U+10FFFF")

    it "rejects two three and four-byte truncation":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: rejects two three and four-byte truncation")
        _expect_utf8_error([0xC2u8], "truncated two-byte sequence")
        _expect_utf8_error([0xE1u8, 0x80u8], "truncated three-byte sequence")
        _expect_utf8_error([0xF1u8, 0x80u8, 0x80u8], "truncated four-byte sequence")

    it "classifies bad second continuation before special range errors":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: classifies bad second continuation before special range errors")
        _expect_utf8_error([0xE0u8, 0x41u8, 0x80u8], "malformed three-byte sequence")
        _expect_utf8_error([0xEDu8, 0x41u8, 0x80u8], "malformed three-byte sequence")
        _expect_utf8_error([0xF0u8, 0x41u8, 0x80u8, 0x80u8], "malformed four-byte sequence")
        _expect_utf8_error([0xF4u8, 0x41u8, 0x80u8, 0x80u8], "malformed four-byte sequence")

    it "rejects bad ordinary second third and fourth continuations":
        # @req: REQ-LIB-COMMON-BASEENCODING-001
        step("Verify: rejects bad ordinary second third and fourth continuations")
        _expect_utf8_error([0xC2u8, 0x41u8], "malformed two-byte sequence")
        _expect_utf8_error([0xE1u8, 0x41u8, 0x80u8], "malformed three-byte sequence")
        _expect_utf8_error([0xE1u8, 0x80u8, 0x41u8], "malformed three-byte sequence")
        _expect_utf8_error([0xF1u8, 0x41u8, 0x80u8, 0x80u8], "malformed four-byte sequence")
        _expect_utf8_error([0xF1u8, 0x80u8, 0x41u8, 0x80u8], "malformed four-byte sequence")
        _expect_utf8_error([0xF1u8, 0x80u8, 0x80u8, 0x41u8], "malformed four-byte sequence")
