# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.base_encoding.utilities.{bytes_to_text}

describe "base encoding UTF-8 byte guards":
    # @manual scenario evidence
    it "keeps valid multi-byte UTF-8":
        # @req REQ-SSPEC-UNIT
        step("keeps valid multi-byte UTF-8")
        assert_equal(bytes_to_text([0xC3, 0xA9]), "é")

    it "rejects invalid continuation bytes":
        # @req REQ-SSPEC-UNIT
        step("rejects invalid continuation bytes")
        assert_equal(bytes_to_text([0xC3, 0x41]), "?A")

    it "rejects overlong encodings":
        # @req REQ-SSPEC-UNIT
        step("rejects overlong encodings")
        assert_equal(bytes_to_text([0xC0, 0xAF]), "??")

    it "rejects surrogate codepoints":
        # @req REQ-SSPEC-UNIT
        step("rejects surrogate codepoints")
        assert_equal(bytes_to_text([0xED, 0xA0, 0x80]), "???")

    it "rejects out-of-range leading bytes":
        # @req REQ-SSPEC-UNIT
        step("rejects out-of-range leading bytes")
        assert_equal(bytes_to_text([0xFF, 0xBF, 0xBF, 0xBF]), "????")
