use std.spec.{describe, it, assert_equal, assert_true}
use std.common.base_encoding.{base_encoding_facade_text_to_bytes as text_to_bytes, bytes_to_text}

fn byte_list(b: [u8]) -> text:
    var parts: [text] = []
    var i = 0
    while i < b.len():
        parts = parts.push(b[i].to_i64().to_text())
        i = i + 1
    parts.join(",")

describe "base encoding facade text_to_bytes":
    """text_to_bytes must emit the exact UTF-8 bytes of the input text.

    The facade previously bounded its encode loop by `s.len()` (a BYTE
    count) while indexing with `s.char_at(i)` (CODEPOINT indexed), so any
    input containing a non-ASCII codepoint over-ran the string.
    """

    it "encodes ASCII unchanged":
        assert_equal(byte_list(text_to_bytes("Hi")), "72,105")

    it "encodes a two-byte codepoint as C3 A9":
        assert_equal(byte_list(text_to_bytes("é")), "195,169")

    it "encodes a three-byte codepoint as E2 82 AC":
        assert_equal(byte_list(text_to_bytes("€")), "226,130,172")

    it "encodes a four-byte codepoint as F0 9F 98 80":
        assert_equal(byte_list(text_to_bytes("😀")), "240,159,152,128")

    it "round-trips mixed-width text through bytes_to_text":
        val s = "aé€😀z"
        assert_equal(bytes_to_text(text_to_bytes(s)), s)

    it "emits no trailing padding bytes for multi-byte input":
        assert_equal(text_to_bytes("aé€😀z").len(), 11)
