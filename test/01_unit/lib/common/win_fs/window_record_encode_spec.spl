# @cover src/lib/common/win_fs/window_record.spl 80%
"""
# window_record_encode Specification

Reproducer for doc/08_tracking/bug/win_fs_window_record_encode_gap_and_entries_field_2026-07-20.md:
`window_record_encode` was imported by `src/app/simple_process_manager/wm_spm_client.spl`
(`use lib.common.win_fs.window_record.{WindowRecord, window_record_encode}`) but was
never defined anywhere under `src/lib` — `git grep -n 'fn window_record_encode' src`
returned zero hits. Any caller importing it failed to resolve.
"""

use std.spipe.*
use lib.common.privilege.id_path.{id_path_intern}
use lib.common.win_fs.window_record.{WindowRecord, WindowState, Rect, BufferRef, window_record_encode}

describe "window_record_encode":
    it "encodes exact service field names, generation and ACL bytes":
        val rec = WindowRecord(
            wid: 42, generation: 3, app: "banking", title: "Acct",
            state: WindowState.Normal,
            geometry: Rect(x: 1, y: 2, w: 3, h: 4),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.banking.view"))
        val encoded = window_record_encode(rec)
        val expected = "wid=42;generation=3;app=banking;title=Acct;acl=id.user.banking.view;state=normal;x=1;y=2;w=3;h=4".bytes()
        expect(encoded).to_equal(expected)

    it "preserves a different ACL and zero generation without defaulting":
        val rec = WindowRecord(
            wid: 7, generation: 0, app: "mail", title: "Inbox",
            state: WindowState.Hidden,
            geometry: Rect(x: -1, y: 0, w: 10, h: 20),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.mail.view"))
        val expected = "wid=7;generation=0;app=mail;title=Inbox;acl=id.user.mail.view;state=hidden;x=-1;y=0;w=10;h=20".bytes()
        expect(window_record_encode(rec)).to_equal(expected)

    it "preserves the default generation and explicitly empty ACL":
        val rec = WindowRecord.new(9, "notes", "Draft")
        val expected = "wid=9;generation=1;app=notes;title=Draft;acl=;state=normal;x=0;y=0;w=0;h=0".bytes()
        expect(window_record_encode(rec)).to_equal(expected)

    it "round-trips distinguishing fields: encoding differs when title differs":
        val base = WindowRecord(
            wid: 42, generation: 3, app: "banking", title: "Acct",
            state: WindowState.Normal,
            geometry: Rect(x: 1, y: 2, w: 3, h: 4),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.banking.view"))
        val changed = WindowRecord(
            wid: 42, generation: 3, app: "banking", title: "Transfer",
            state: WindowState.Normal,
            geometry: Rect(x: 1, y: 2, w: 3, h: 4),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.banking.view"))
        val a = window_record_encode(base)
        val b = window_record_encode(changed)
        expect(a.len() == b.len() and a == b).to_equal(false)
