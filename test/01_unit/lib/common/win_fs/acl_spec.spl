"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/01_unit/lib/common/win_fs/acl_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step
use lib.common.privilege.id_path.{IdPath, id_path_intern}
use lib.common.privilege.principal.{Principal, PrincipalKind}
use lib.common.privilege.authority_token.{AuthorityToken, AuthorityLevel, Scope, TrustSource}
use lib.common.win_fs.window_record.{WindowRecord, WindowState, Rect, BufferRef}
use lib.common.win_fs.fs_encoder.{FsOp}
use lib.common.win_fs.acl.{acl_check}

describe "Standard library comprehensive behavior":
    it "text primitives agree on a fixed fixture":
        step("Verify: text primitives agree on a fixed fixture")
        # @req: REQ-LIB-LIB_GENERIC-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.replace("Language", "Runtime")).to_equal("Simple Runtime")  # oracle: substitution applies

    it "collections keep insertion order and value semantics":
        step("Verify: collections keep insertion order and value semantics")
        # @req: REQ-LIB-LIB_GENERIC-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows by one
        expect(original.len()).to_equal(2)  # oracle: the original binding is unmodified

    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits


# --- Merged from the legacy mirror copy (unit:lib/common/win_fs/acl_spec.spl), test dedup phase B: tests this copy lacked.

describe "Win-FS ACL / open() (merged from legacy copy)":
    it "AC-2: allows open when token id_path matches required prefix":
        val rec = WindowRecord(
            wid: 1, generation: 1, app: "banking", title: "Acct",
            state: WindowState.Normal,
            geometry: Rect(x: 0, y: 0, w: 1, h: 1),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.banking.view"))
        val principal = Principal(kind: PrincipalKind.Local, id: "alice")
        val token = AuthorityToken.mock(
            id_path: id_path_intern("id.user.banking"),
            level: AuthorityLevel.Sensitive,
            principal: principal)
        expect acl_check(rec, token, FsOp.Open) to_equal true

    it "AC-2: denies open when token id_path lacks required prefix":
        val rec = WindowRecord(
            wid: 1, generation: 1, app: "banking", title: "Acct",
            state: WindowState.Normal,
            geometry: Rect(x: 0, y: 0, w: 1, h: 1),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.banking.view"))
        val principal = Principal(kind: PrincipalKind.Local, id: "eve")
        val token = AuthorityToken.mock(
            id_path: id_path_intern("id.user.mail"),
            level: AuthorityLevel.Internal,
            principal: principal)
        expect acl_check(rec, token, FsOp.Open) to_equal false

    it "AC-2: revoked token is denied":
        val rec = WindowRecord(
            wid: 1, generation: 1, app: "banking", title: "Acct",
            state: WindowState.Normal,
            geometry: Rect(x: 0, y: 0, w: 1, h: 1),
            buffer_ref: BufferRef(kind: "shm", handle: 0, bytes: 0),
            acl_id_path: id_path_intern("id.user.banking.view"))
        val principal = Principal(kind: PrincipalKind.Local, id: "alice")
        val token = AuthorityToken.mock_with_trust(
            id_path: id_path_intern("id.user.banking.view"),
            level: AuthorityLevel.Sensitive,
            principal: principal,
            trust: TrustSource.Revoked)
        expect acl_check(rec, token, FsOp.Open) to_equal false
