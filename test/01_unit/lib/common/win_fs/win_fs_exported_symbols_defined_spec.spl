# @cover src/lib/common/win_fs/window_record.spl 60%
"""
# win_fs exported-symbol defect-class detection

Generalizes doc/08_tracking/bug/win_fs_window_record_encode_gap_and_entries_field_2026-07-20.md:
an unresolved `use` import is only a compiler warning, so a module can import
and call a symbol that was never defined anywhere in the tree and still run
(or silently fail) instead of erroring loudly. This spec exercises every
function `window_record.spl` is known to export and re-export via
`src/app/simple_process_manager/wm_spm_client.spl`'s import list, so a future
symbol that is declared-but-missing goes RED here instead of only surfacing
deep in an app-layer caller.
"""

use std.spipe.*
use lib.common.privilege.id_path.{id_path_intern}
use lib.common.win_fs.window_record.{WindowRecord, WindowState, Rect, BufferRef, window_mark_destroyed, window_record_encode}

describe "win_fs window_record exported API surface":
    it "window_mark_destroyed is callable and returns Destroyed state":
        val rec = WindowRecord(
            wid: 7, generation: 1, app: "a", title: "t",
            state: WindowState.Normal,
            geometry: Rect(x: 0, y: 0, w: 0, h: 0),
            buffer_ref: BufferRef(kind: "none", handle: 0, bytes: 0),
            acl_id_path: id_path_intern(""))
        val gone = window_mark_destroyed(rec)
        expect gone.state to_equal WindowState.Destroyed

    it "window_record_encode is callable (was import-only, undefined, before this fix)":
        val rec = WindowRecord(
            wid: 7, generation: 1, app: "a", title: "t",
            state: WindowState.Normal,
            geometry: Rect(x: 0, y: 0, w: 0, h: 0),
            buffer_ref: BufferRef(kind: "none", handle: 0, bytes: 0),
            acl_id_path: id_path_intern(""))
        val encoded = window_record_encode(rec)
        expect(encoded.len()).to_be_greater_than(0)
