# @tag: unit, bytes, native-layout
# The existing runtime probe rejects non-byte-basis arrays with -1. This gate
# needs an admitted native runtime; an unavailable interpreter probe is not PASS.
use std.spec
use std.common.text_bytes.{TextByteBufferError, text_byte_buffer, bytes_to_text}

extern fn rt_array_bytes_basis_len(bytes: [u8]) -> i64

fn check_packed_byte_buffer():
    var bytes = text_byte_buffer(3).unwrap()
    expect(bytes.len()).to_equal(0)
    bytes.push(65)
    bytes.push(0)
    bytes.push(255)
    expect(bytes.len()).to_equal(3)
    expect(bytes[0]).to_equal(65)
    expect(bytes[1]).to_equal(0)
    expect(bytes[2]).to_equal(255)
    expect(rt_array_bytes_basis_len(bytes)).to_equal(3)

describe "packed text byte buffer provider":
    it "rejects negative capacity before allocating":
        match text_byte_buffer(-1):
            case Err(error): expect(error).to_equal(TextByteBufferError.NegativeCapacity)
            case Ok(bytes): assert(false)

    it "rejects header plus capacity overflow before allocating":
        match text_byte_buffer(9223372036854775768):
            case Err(error): expect(error).to_equal(TextByteBufferError.CapacityOverflow)
            case Ok(bytes): assert(false)

    it "has zero logical length and stores byte values in packed storage":
        check_packed_byte_buffer()

    it "permits zero capacity without inserting a NUL element":
        val bytes = text_byte_buffer(0).unwrap()
        expect(bytes.len()).to_equal(0)
        expect(bytes_to_text(bytes)).to_equal("")

    it "preserves compiler byte arguments 8 and 128 through push and indexed mutation":
        var bytes = text_byte_buffer(2).unwrap()
        val high: u8 = 128u8
        bytes.push(8u8)
        bytes.push(high)
        expect(bytes[0]).to_equal(8u8)
        expect(bytes[1]).to_equal(128u8)
        bytes[0] = high
        bytes[1] = 8u8
        expect(bytes[0]).to_equal(128u8)
        expect(bytes[1]).to_equal(8u8)
        expect(rt_array_bytes_basis_len(bytes)).to_equal(2)
