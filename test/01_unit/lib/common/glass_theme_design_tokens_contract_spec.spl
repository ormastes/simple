use std.io.{file_read}

describe "common glass theme token ownership":
    it "keeps static tokens below runtime package resolution":
        val source = file_read("src/lib/common/ui/glass/theme.spl")

        expect(source).to_contain("if theme_name == \"aetheric_dark\":")
        expect(source).to_contain("return GlassDesignTokens.obsidian_dark()")
        expect(source.contains("nogc_sync_mut.ui.theme_package")).to_equal(false)
        expect(source.contains("theme_design_tokens(theme_name)")).to_equal(false)
