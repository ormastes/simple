# Direct native mirror for the scalar WM lifecycle state owner.

use common.ui.wm_window_state.*

fn check(label: text, ok: bool) -> i32:
    if ok:
        print("PASS {label}")
        return 0
    print("FAIL {label}")
    1

fn main() -> i32:
    var failures = 0
    val minimized_normal = wm_window_state_minimize(WM_WINDOW_STATE_NORMAL)
    val minimized_maximized = wm_window_state_minimize(WM_WINDOW_STATE_MAXIMIZED)
    failures = failures + check("normal minimizes", minimized_normal == WM_WINDOW_STATE_MINIMIZED)
    failures = failures + check("normal restores", wm_window_state_restore(minimized_normal, wm_window_state_before_minimize(WM_WINDOW_STATE_NORMAL)) == WM_WINDOW_STATE_NORMAL)
    failures = failures + check("maximized restores", wm_window_state_restore(minimized_maximized, wm_window_state_before_minimize(WM_WINDOW_STATE_MAXIMIZED)) == WM_WINDOW_STATE_MAXIMIZED)
    failures = failures + check("minimized rejects input", not wm_window_state_accepts_input(WM_WINDOW_STATE_MINIMIZED))
    val closing = wm_window_state_begin_close(WM_WINDOW_STATE_NORMAL)
    failures = failures + check("closing rejects input", not wm_window_state_accepts_input(closing))
    failures = failures + check("closing finishes closed", wm_window_state_finish_close(closing) == WM_WINDOW_STATE_CLOSED)

    if failures == 0:
        print("WM WINDOW STATE PROBE: PASS")
        return 0
    print("WM WINDOW STATE PROBE: FAIL {failures}")
    1
