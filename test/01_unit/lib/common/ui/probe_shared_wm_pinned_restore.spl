use common.ui.taskbar_model.{AppRef, TaskbarModel, WindowRef}
use common.ui.window_scene.{
    shared_wm_dispatch_pointer,
    shared_wm_focus_window_by_window_id,
    simple_gui_internal_window,
    simple_gui_internal_window_scene,
}
use common.ui.wm_runtime_dispatch.{
    wm_runtime_apply_command,
    wm_runtime_dispatch_command,
    wm_runtime_shell_state_empty,
}

fn main() -> i64:
    val scene = simple_gui_internal_window_scene(800, 600, "cpu", [
        simple_gui_internal_window(
            "surf1", "win1", 1u64, "demo.app", "One",
            10, 40, 300, 200, "", false, false, 1
        ),
        simple_gui_internal_window(
            "surf2", "win2", 2u64, "demo.app", "Two",
            80, 120, 300, 200, "", true, false, 2
        )
    ])
    val taskbar = TaskbarModel(
        pinned: [
            AppRef(app_id: "demo.app", display_name: "Demo", icon: "demo")
        ],
        running: [
            WindowRef(
                window_id: "win1", app_id: "demo.app",
                title: "One", minimized: false
            ),
            WindowRef(
                window_id: "win2", app_id: "demo.app",
                title: "Two", minimized: true
            )
        ],
        tray: []
    )
    val result = shared_wm_dispatch_pointer(
        scene, taskbar, 10, 575, "left", "down", 1000, "", 0
    )
    val refocused = shared_wm_focus_window_by_window_id(result.scene, "win1")
    val recent = shared_wm_dispatch_pointer(
        refocused, taskbar, 10, 575, "left", "down", 1000, "", 0
    )
    val minimized = wm_runtime_apply_command(
        wm_runtime_shell_state_empty(),
        wm_runtime_dispatch_command(
            "window_minimize", "surf2", "demo.app", "win2", "", true
        )
    )
    val focused = wm_runtime_apply_command(
        minimized,
        wm_runtime_dispatch_command(
            "window_focus", "win2", "demo.app", "win2", "", true
        )
    )
    if (result.action == "focus_window" and
        result.window_id == "win2" and
        result.scene.windows[1].focused and
        not result.scene.windows[1].minimized and
        recent.window_id == "win1" and
        focused.focused_window_id == "win2" and
        focused.minimized_window_ids.len() == 0):
        print "SHARED WM PINNED RESTORE PROBE: PASS"
        return 0
    print "SHARED WM PINNED RESTORE PROBE: FAIL"
    1
