# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that layout_hbox flex remainder.
Audience: compiler and tooling engineers who maintain this spec.
"""
use std.spec.step
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/layout.spl 30%
# @req FR-UI-LAYOUT-FLEX-REMAINDER
#
# layout_hbox() divides the free width into `flex_unit` per flex point and
# hands the integer-division REMAINDER to one child. The remainder must be
# awarded EXACTLY ONCE, or the children's widths sum to more than the box.
#
# `flex_idx` accumulates each child's flex weight, so the guard
# `flex_idx >= total_flex` fires for the last child with flex > 0 AND again
# for every trailing child with flex == 0 (adding 0 leaves flex_idx at
# total_flex). A `flex="0"` child — reachable via `with_flex(node, 0)` or the
# sdn `flex` prop — therefore collected a second copy of the remainder and
# overflowed the container.
#
# Design call pinned here: the remainder goes to the LAST child that actually
# takes space (flex > 0). A child that asked for zero width gets zero width.
# That matches layout_vbox's identical remainder invariant
# (awarded once, to the last space-taking child).

use std.spec.step

use std.spec.{describe, it, expect, assert_true}
use common.ui.widget.{WidgetNode, WidgetKind, WidgetRect}
use common.ui.builder.{label, with_flex}
use common.ui.layout.{compute_layout, find_rect}

# A border-free hbox container: `row()` builds a WidgetKind.Panel, whose 1px
# border would inset the width and make the arithmetic below off-by-2. Any
# non-"panel" kind skips the border trim.
fn _hbox(id: text, kids: [WidgetNode]) -> WidgetNode:
    var node = WidgetNode.new(id, WidgetKind.Card.to_wire())
    node = node.set_layout("hbox")
    for k in kids:
        node = node.add_child(k)
    node

# Width of a laid-out child, or 0 when it was given no rect at all (a
# zero-width child is dropped by `if actual_w > 0`).
fn _w(rects: [WidgetRect], id: text) -> i32:
    match find_rect(rects, id):
        case Some(r): r.w
        # find_rect returns WidgetRect?, so the only other arm is nil, which
        # means the child was dropped for having zero width — report 0.
        case _: 0

describe "layout_hbox flex remainder":
    # @manual scenario evidence
    """The hbox flex remainder is awarded exactly once, to the last child with
    flex > 0, so children's widths never sum past the container width."""

    it "never awards the remainder twice — a flex=0 child gets no width":
        # @req REQ-SSPEC-LIB
        step("never awards the remainder twice — a flex=0 child gets no width")
        step("Verify: never awards the remainder twice — a flex=0 child gets no width")
        # @req: REQ-LIB-COMMON-001
        # REGRESSION: box w=10, A flex=3, B flex=0.
        # total_flex=3, flex_unit=3, flex_remainder=10-9=1.
        # A: flex_idx 0->3, 3>=3 -> 3*3+1 = 10  (correct)
        # B: flex_idx 3->3, 3>=3 -> 0*3+1 = 1   (WRONG: remainder again)
        # 10+1 = 11px assigned into a 10px box.
        val a = with_flex(label("flexrem_a", "A"), 3)
        val b = with_flex(label("flexrem_b", "B"), 0)
        val rects = compute_layout(_hbox("flexrem_root", [a, b]), 0, 0, 10, 4)
        val a_w = _w(rects, "flexrem_a")
        val b_w = _w(rects, "flexrem_b")
        expect(b_w).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(a_w).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(a_w + b_w).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "gives all-positive flex children the same geometry as before (control)":
        # @req REQ-SSPEC-LIB
        step("gives all-positive flex children the same geometry as before (control)")
        step("Verify: gives all-positive flex children the same geometry as before (control)")
        # Discriminating control: no flex=0 child, so the guard change cannot
        # move these numbers. Must pass in BOTH directions — a green here with
        # a red above proves the oracle discriminates instead of failing
        # wholesale.
        # total_flex=4, flex_unit=2, remainder=2.
        # C1: flex_idx 0->3, 3<4  -> 3*2   = 6
        # C2: flex_idx 3->4, 4>=4 -> 1*2+2 = 4
        val c1 = with_flex(label("flexctl_c1", "1"), 3)
        val c2 = with_flex(label("flexctl_c2", "2"), 1)
        val rects = compute_layout(_hbox("flexctl_root", [c1, c2]), 0, 0, 10, 4)
        expect(_w(rects, "flexctl_c1")).to_equal(6)
        expect(_w(rects, "flexctl_c2")).to_equal(4)

    it "treats a NEGATIVE flex as zero instead of double-awarding":
        # @req REQ-SSPEC-LIB
        step("treats a NEGATIVE flex as zero instead of double-awarding")
        step("Verify: treats a NEGATIVE flex as zero instead of double-awarding")
        # REGRESSION: `with_flex(node, -2)` and sdn `flex: -2` both parse, and
        # a negative weight made flex_idx non-monotone, so more than one child
        # could satisfy `flex_idx >= total_flex` even with the flex > 0 guard.
        # Unclamped, w=10 with flex 5 / -2 / 1:
        #   total_flex = 4, flex_unit = 2, flex_remainder = 2
        #   C1: flex_idx 0->5, 5>=4 -> 5*2+2 = 12   (remainder)
        #   C2: flex_idx 5->3, flex<0, skipped
        #   C3: flex_idx 3->4, 4>=4 -> 1*2+2 = 4    (remainder AGAIN)
        #   12+4 = 16px into a 10px box.
        # Clamped, total_flex = 6, flex_unit = 1, remainder = 4:
        #   C1 -> 5, C2 -> 0 (dropped), C3 -> 1*1+4 = 5. Sum = 10.
        val c1 = with_flex(label("flexneg_c1", "1"), 5)
        val c2 = with_flex(label("flexneg_c2", "2"), -2)
        val c3 = with_flex(label("flexneg_c3", "3"), 1)
        val rects = compute_layout(_hbox("flexneg_root", [c1, c2, c3]), 0, 0, 10, 4)
        val w1 = _w(rects, "flexneg_c1")
        val w2 = _w(rects, "flexneg_c2")
        val w3 = _w(rects, "flexneg_c3")
        expect(w2).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(w1 + w2 + w3).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "was already correct with a LEADING flex=0 child (control)":
        # @req REQ-SSPEC-LIB
        step("was already correct with a LEADING flex=0 child (control)")
        step("Verify: was already correct with a LEADING flex=0 child (control)")
        # Second control, also unchanged in both directions: with the zero
        # child FIRST, flex_idx is still 0 when it is visited, so 0 >= 3 is
        # false and the remainder was never double-awarded. This pins that the
        # defect was specifically about TRAILING zero-flex children, not about
        # flex=0 in general.
        val b = with_flex(label("flexlead_b", "B"), 0)
        val a = with_flex(label("flexlead_a", "A"), 3)
        val rects = compute_layout(_hbox("flexlead_root", [b, a]), 0, 0, 10, 4)
        expect(_w(rects, "flexlead_b")).to_equal(0)
        expect(_w(rects, "flexlead_a")).to_equal(10)

# A border-free vbox container, for the same reason `_hbox` above exists: a
# panel's 1px border would inset the height and shift every number by 2.
fn _vbox(id: text, kids: [WidgetNode]) -> WidgetNode:
    var node = WidgetNode.new(id, WidgetKind.Card.to_wire())
    node = node.set_layout("vbox")
    for k in kids:
        node = node.add_child(k)
    node

# Height of a laid-out child, or 0 when it was given no rect at all (a
# zero-height child is dropped by `if actual_h > 0`).
fn _h(rects: [WidgetRect], id: text) -> i32:
    match find_rect(rects, id):
        case Some(r): r.h
        case _: 0

describe "layout_vbox flex weighting":
    # @manual scenario evidence
    """layout_vbox weights each child's height by its `flex` prop and awards
    the integer-division remainder exactly once, to the last child with
    flex > 0 — the same contract layout_hbox applies on the other axis."""

    it "weights heights by the flex prop instead of splitting equally":
        # @req REQ-SSPEC-LIB
        step("weights heights by the flex prop instead of splitting equally")
        step("Verify: weights heights by the flex prop instead of splitting equally")
        # REGRESSION: vbox used to count the children with no fixed height and
        # divide the box equally, so flex 3 vs flex 1 both got 5 of a h=10 box.
        # Weighted: total_flex=4, flex_unit=2, flex_remainder=10-8=2.
        # A: flex_idx 0->3, 3<4  -> 3*2   = 6
        # B: flex_idx 3->4, 4>=4 -> 1*2+2 = 4
        val a = with_flex(label("vflex_a", "A"), 3)
        val b = with_flex(label("vflex_b", "B"), 1)
        val rects = compute_layout(_vbox("vflex_root", [a, b]), 0, 0, 4, 10)
        expect(_h(rects, "vflex_a")).to_equal(6)  # oracle: 6 — weighted 3/4 of 10
        expect(_h(rects, "vflex_b")).to_equal(4)  # oracle: 4 — weighted 1/4 of 10, plus remainder

    it "gives a flex=0 child no height and awards the remainder once":
        # @req REQ-SSPEC-LIB
        step("gives a flex=0 child no height and awards the remainder once")
        step("Verify: gives a flex=0 child no height and awards the remainder once")
        # REGRESSION: with_flex(n, 0) used to still collect an equal share.
        # Mirror of the hbox case above: total_flex=3, flex_unit=3,
        # flex_remainder=1, so A takes the whole box and B takes nothing.
        val a = with_flex(label("vzero_a", "A"), 3)
        val b = with_flex(label("vzero_b", "B"), 0)
        val rects = compute_layout(_vbox("vzero_root", [a, b]), 0, 0, 4, 10)
        val a_h = _h(rects, "vzero_a")
        val b_h = _h(rects, "vzero_b")
        expect(b_h).to_equal(0)  # oracle: 0 — a child that asked for zero height gets zero
        expect(a_h).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(a_h + b_h).to_equal(10)  # oracle: 10 — children still sum to the box

    it "leaves children with no flex prop splitting the box equally (control)":
        # @req REQ-SSPEC-LIB
        step("leaves children with no flex prop splitting the box equally (control)")
        step("Verify: leaves children with no flex prop splitting the box equally (control)")
        # Discriminating control: get_flex() defaults to 1, so two unannotated
        # children weight 1/1 and land on the same 5/5 the equal-division code
        # produced. A green here with a red above proves the oracle
        # discriminates rather than failing wholesale.
        val rects = compute_layout(
            _vbox("vctl_root", [label("vctl_a", "A"), label("vctl_b", "B")]), 0, 0, 4, 10)
        expect(_h(rects, "vctl_a")).to_equal(5)
        expect(_h(rects, "vctl_b")).to_equal(5)
