"""
## Purpose and audience
Purpose: Prove that retained DrawIR conservative occlusion.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use common.ui.render_opt.occlusion.{build_occlusion_plan}

describe "retained DrawIR conservative occlusion":
    it "culls a plain rectangle covered by one later opaque rectangle":
        step("Verify: culls a plain rectangle covered by one later opaque rectangle")
        # @req: REQ-LIB-COMMON-001
        val plan = build_occlusion_plan(
            [0, 0, 100, 100, 0, 0, 100, 100],
            [true, true], [false, true], 100, 100, 32, 16)
        expect(plan.visible).to_equal([false, true])
        expect(plan.occluded_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "proves coverage by the exact union of two later rectangles":
        step("Verify: proves coverage by the exact union of two later rectangles")
        val plan = build_occlusion_plan(
            [0, 0, 100, 100, 0, 0, 50, 100, 50, 0, 50, 100],
            [true, true, true], [false, true, true], 100, 100, 32, 16)
        expect(plan.visible).to_equal([false, true, true])
        expect(plan.occluded_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "does not cull through a one-pixel coverage hole":
        step("Verify: does not cull through a one-pixel coverage hole")
        val plan = build_occlusion_plan(
            [0, 0, 100, 100, 0, 0, 49, 100, 50, 0, 50, 100],
            [true, true, true], [false, true, true], 100, 100, 32, 16)
        expect(plan.visible).to_equal([true, true, true])

    it "never lets a translucent or uncertain command contribute coverage":
        step("Verify: never lets a translucent or uncertain command contribute coverage")
        val plan = build_occlusion_plan(
            [0, 0, 40, 40, 0, 0, 40, 40],
            [true, true], [false, false], 40, 40, 32, 16)
        expect(plan.visible).to_equal([true, true])
        expect(plan.occluded_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "fails open when rectangle subtraction exhausts workspace":
        step("Verify: fails open when rectangle subtraction exhausts workspace")
        val plan = build_occlusion_plan(
            [0, 0, 100, 100, 25, 25, 50, 50],
            [true, true], [false, true], 100, 100, 1, 16)
        expect(plan.visible).to_equal([true, true])
        expect(plan.overflow_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "culls exact eligible geometry wholly outside the viewport":
        step("Verify: culls exact eligible geometry wholly outside the viewport")
        val plan = build_occlusion_plan(
            [120, 10, 20, 20], [true], [false], 100, 100, 8, 8)
        expect(plan.visible).to_equal([false])
        expect(plan.offscreen_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rejects malformed parallel columns by making every command visible":
        step("Verify: rejects malformed parallel columns by making every command visible")
        val plan = build_occlusion_plan(
            [0, 0, 10, 10, 2], [true], [true], 100, 100, 8, 8)
        expect(plan.visible).to_equal([true])
        expect(plan.overflow_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "fails open and records coordinates outside the DrawIR i32 domain":
        step("Verify: fails open and records coordinates outside the DrawIR i32 domain")
        val plan = build_occlusion_plan(
            [9223372036854775807, 0, 10, 10],
            [true], [true], 100, 100, 8, 8)
        expect(plan.visible).to_equal([true])
        expect(plan.overflow_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "records an exhausted occluder table without hiding earlier work":
        step("Verify: records an exhausted occluder table without hiding earlier work")
        val plan = build_occlusion_plan(
            [0, 0, 10, 10, 20, 0, 10, 10],
            [true, true], [true, true], 100, 100, 8, 0)
        expect(plan.visible).to_equal([true, true])
        expect(plan.overflow_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
