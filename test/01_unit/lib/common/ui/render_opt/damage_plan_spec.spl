"""
## Purpose and audience
Purpose: Prove that deterministic retained damage plan.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use common.ui.render_opt.damage_tiles.{DirtyTilePyramid}
use common.ui.render_opt.damage_plan.{
    DamagePlanPolicy, build_damage_plan,
    DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_FULL,
    DAMAGE_FALLBACK_AREA, DAMAGE_FALLBACK_CAP
}

fn _policy(max_rects: i64, threshold: i64) -> DamagePlanPolicy:
    DamagePlanPolicy.create(max_rects, threshold)

describe "deterministic retained damage plan":

    it "returns NONE for an unchanged frame":
        step("Verify: returns NONE for an unchanged frame")
        # @req: REQ-LIB-COMMON-001
        val pyramid = DirtyTilePyramid.create(256, 128, [64], [64])
        val plan = build_damage_plan(pyramid, 0, _policy(16, 60))
        expect(plan.mode).to_equal(DAMAGE_PLAN_NONE)
        expect(plan.rects).to_equal([])
        expect(plan.tiles_examined).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "merges horizontal and vertical tiles into one exact rectangle":
        step("Verify: merges horizontal and vertical tiles into one exact rectangle")
        var pyramid = DirtyTilePyramid.create(256, 192, [64], [64])
        pyramid.mark_rect(0, 0, 192, 128)
        val plan = build_damage_plan(pyramid, 0, _policy(16, 90))
        expect(plan.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(plan.rects).to_equal([0, 0, 192, 128])
        expect(plan.source_tile_count).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(plan.output_rect_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.merged_tile_count).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(plan.dirty_pixels).to_equal(24576)  # oracle: 24576 — named expected value from the requirement
        expect(plan.planned_pixels).to_equal(24576)  # oracle: 24576 — named expected value from the requirement

    it "vertically merges two separated runs without losing the first":
        step("Verify: vertically merges two separated runs without losing the first")
        var pyramid = DirtyTilePyramid.create(192, 128, [64], [64])
        pyramid.mark_rect(0, 0, 64, 128)
        pyramid.mark_rect(128, 0, 64, 128)
        val plan = build_damage_plan(pyramid, 0, _policy(16, 90))
        expect(plan.rects).to_equal([
            0, 0, 64, 128, 128, 0, 64, 128])
        expect(plan.output_rect_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "does not widen rectangles when adjacent row run shapes differ":
        step("Verify: does not widen rectangles when adjacent row run shapes differ")
        var pyramid = DirtyTilePyramid.create(192, 128, [64], [64])
        pyramid.mark_rect(0, 0, 128, 64)
        pyramid.mark_rect(0, 64, 64, 64)
        val plan = build_damage_plan(pyramid, 0, _policy(16, 90))
        expect(plan.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(plan.rects).to_equal([
            0, 0, 128, 64, 0, 64, 64, 64])
        expect(plan.dirty_pixels).to_equal(12288)  # oracle: 12288 — named expected value from the requirement
        expect(plan.planned_pixels).to_equal(12288)  # oracle: 12288 — named expected value from the requirement

    it "clips the 8K bottom-right tile to 64 by 32":
        step("Verify: clips the 8K bottom-right tile to 64 by 32")
        var pyramid = DirtyTilePyramid.create(7680, 4320, [64], [64])
        pyramid.mark_rect(7679, 4319, 1, 1)
        val plan = build_damage_plan(pyramid, 0, _policy(16, 60))
        expect(plan.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(plan.rects).to_equal([7616, 4288, 64, 32])
        expect(plan.dirty_pixels).to_equal(2048)  # oracle: 2048 — named expected value from the requirement

    it "uses i64 area threshold equality for full fallback":
        step("Verify: uses i64 area threshold equality for full fallback")
        var below = DirtyTilePyramid.create(100, 100, [10], [10])
        below.mark_rect(0, 0, 100, 50)
        below.mark_rect(0, 50, 90, 10)
        val local = build_damage_plan(below, 0, _policy(100, 60))
        expect(local.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(local.dirty_pixels).to_equal(5900)  # oracle: 5900 — named expected value from the requirement
        var equal = DirtyTilePyramid.create(100, 100, [10], [10])
        equal.mark_rect(0, 0, 100, 60)
        val full = build_damage_plan(equal, 0, _policy(100, 60))
        expect(full.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(full.fallback_reason).to_equal(DAMAGE_FALLBACK_AREA)
        expect(full.rects).to_equal([0, 0, 100, 100])

    it "falls back to only the full viewport when the rect cap is exceeded":
        step("Verify: falls back to only the full viewport when the rect cap is exceeded")
        var pyramid = DirtyTilePyramid.create(320, 64, [64], [64])
        pyramid.mark_rect(0, 0, 1, 1)
        pyramid.mark_rect(128, 0, 1, 1)
        pyramid.mark_rect(256, 0, 1, 1)
        val plan = build_damage_plan(pyramid, 0, _policy(2, 100))
        expect(plan.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(plan.fallback_reason).to_equal(DAMAGE_FALLBACK_CAP)
        expect(plan.rects).to_equal([0, 0, 320, 64])
        expect(plan.output_rect_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "keeps exactly the cap number of local rectangles":
        step("Verify: keeps exactly the cap number of local rectangles")
        var pyramid = DirtyTilePyramid.create(320, 64, [64], [64])
        pyramid.mark_rect(0, 0, 1, 1)
        pyramid.mark_rect(128, 0, 1, 1)
        val plan = build_damage_plan(pyramid, 0, _policy(2, 100))
        expect(plan.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(plan.rects).to_equal([
            0, 0, 64, 64, 128, 0, 64, 64])
        expect(plan.output_rect_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
