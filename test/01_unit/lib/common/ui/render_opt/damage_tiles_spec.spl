"""
## Purpose and audience
Purpose: Prove that retained multiscale damage tiles.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use common.ui.render_opt.damage_tiles.{
    DirtyTilePyramid, damage_tiles_mark_property_damage
}
use common.ui.render_opt.property_trees.{PropertyTrees, PT_TRANSFORM}

describe "retained multiscale damage tiles":

    it "maps an 8K ragged edge exactly at every configured scale":
        step("Verify: maps an 8K ragged edge exactly at every configured scale")
        # @req: REQ-LIB-COMMON-001
        var pyramid = DirtyTilePyramid.create(
            7680, 4320, [64, 256], [64, 256])
        expect(pyramid.valid).to_equal(true)
        expect(pyramid.cols).to_equal([120, 30])
        expect(pyramid.rows).to_equal([68, 17])
        pyramid.mark_rect(7679, 4319, 1, 1)
        expect(pyramid.dirty_count(0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pyramid.dirty_count(1)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pyramid.dirty_rects(0)).to_equal([7616, 4288, 64, 32])
        expect(pyramid.dirty_rects(1)).to_equal([7424, 4096, 256, 224])

    it "deduplicates overlapping marks and clears by epoch":
        step("Verify: deduplicates overlapping marks and clears by epoch")
        var pyramid = DirtyTilePyramid.create(256, 128, [64], [64])
        pyramid.mark_rect(1, 1, 80, 60)
        pyramid.mark_rect(20, 20, 10, 10)
        expect(pyramid.dirty_count(0)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pyramid.dirty_rects(0)).to_equal([
            0, 0, 64, 64, 64, 0, 64, 64])
        pyramid.begin_frame()
        expect(pyramid.dirty_count(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pyramid.dirty_rects(0)).to_equal([])

    it "emits deterministic row-major rectangles independent of mark order":
        step("Verify: emits deterministic row-major rectangles independent of mark order")
        var a = DirtyTilePyramid.create(192, 128, [64], [64])
        var b = DirtyTilePyramid.create(192, 128, [64], [64])
        a.mark_rect(129, 65, 1, 1)
        a.mark_rect(1, 1, 1, 1)
        b.mark_rect(1, 1, 1, 1)
        b.mark_rect(129, 65, 1, 1)
        expect(a.dirty_rects(0)).to_equal(b.dirty_rects(0))
        expect(a.dirty_rects(0)).to_equal([
            0, 0, 64, 64, 128, 64, 64, 64])

    it "consumes PropertyTrees old and new transform damage":
        step("Verify: consumes PropertyTrees old and new transform damage")
        var trees = PropertyTrees.create()
        val node = trees.add_node(PT_TRANSFORM, -1, 10u32, 20u32, 30u32, 20u32)
        trees.set_translate(node, 100u32, 70u32)
        var pyramid = DirtyTilePyramid.create(256, 128, [64], [64])
        damage_tiles_mark_property_damage(pyramid, trees)
        expect(trees.damage_len).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pyramid.dirty_rects(0)).to_equal([
            0, 0, 64, 64,
            64, 64, 64, 64,
            128, 64, 64, 64])

    it "rejects invalid configuration and overflowed rectangles":
        step("Verify: rejects invalid configuration and overflowed rectangles")
        var invalid = DirtyTilePyramid.create(0, 4320, [64], [64])
        expect(invalid.valid).to_equal(false)
        var pyramid = DirtyTilePyramid.create(128, 128, [64], [64])
        pyramid.mark_rect(9223372036854775807, 0, 1, 1)
        expect(pyramid.dirty_count(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
