# @cover src/lib/common/ui/render_opt/damage_budget_slice.spl 95%
# @tag: unit, ui, render_perf, retained, frame_switch, progressive, 8k

use std.spec
use common.ui.render_opt.damage_plan.{
    DamageFramePlan, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_NONE,
    DAMAGE_FALLBACK_NONE
}
use common.ui.render_opt.damage_budget_slice.slice_damage_plan_budget

fn plan(rects: [i64], pixels: i64, mode: i64 = DAMAGE_PLAN_LOCAL) -> DamageFramePlan:
    DamageFramePlan(
        rects: rects, mode: mode, source_tile_count: 0,
        output_rect_count: rects.len() / 4, merged_tile_count: 0,
        dirty_pixels: pixels, planned_pixels: pixels, tiles_examined: 0,
        full_fallback_count: 0, fallback_reason: DAMAGE_FALLBACK_NONE)

describe "exact progressive retained damage slicing":
    it "splits the 110th mixed-alpha row at the exact measured allowance":
        val source = plan([0, 0, 7680, 110], 844800)
        val slice = slice_damage_plan_budget(source, 838069)
        assert_true(slice.valid)
        expect(slice.current_pixels).to_equal(838069)
        expect(slice.deferred_pixels).to_equal(6731)
        expect(slice.current_rects).to_equal(
            [0, 0, 7680, 109, 0, 109, 949, 1])
        expect(slice.deferred_rects).to_equal([949, 109, 6731, 1])
        assert_false(slice.complete)

    it "partitions disjoint rectangles without widening or omission":
        val source = plan([0, 0, 64, 64, 128, 0, 64, 64], 8192)
        val slice = slice_damage_plan_budget(source, 5000)
        expect(slice.current_pixels + slice.deferred_pixels).to_equal(8192)
        expect(slice.current_pixels).to_equal(5000)
        expect(slice.deferred_pixels).to_equal(3192)
        expect(slice.current_rects).to_equal(
            [0, 0, 64, 64, 128, 0, 64, 14, 128, 14, 8, 1])
        expect(slice.deferred_rects).to_equal(
            [136, 14, 56, 1, 128, 15, 64, 49])

    it "passes admitted and idle plans through exactly":
        val admitted = slice_damage_plan_budget(
            plan([10, 20, 30, 40], 1200), 1200)
        assert_true(admitted.complete)
        expect(admitted.current_rects).to_equal([10, 20, 30, 40])
        val idle = slice_damage_plan_budget(plan([], 0, DAMAGE_PLAN_NONE), 0)
        assert_true(idle.valid)
        assert_true(idle.complete)
        expect(idle.current_rects.len()).to_equal(0)

    it "fails closed for malformed tuples and negative budgets":
        assert_false(slice_damage_plan_budget(plan([0, 0, 1], 0), 1).valid)
        assert_false(slice_damage_plan_budget(
            plan([0, 0, 1, 1], 1), -1).valid)
