# @cover src/lib/common/ui/render_opt/wm_retained_damage_consumer.spl 95%
# @tag: unit, ui, wm, render_perf, retained, damage, 8k

use std.spec
use common.ui.render_opt.property_trees.PropertyTrees
use common.ui.render_opt.damage_plan.{DAMAGE_PLAN_LOCAL}
use common.ui.render_opt.retained_frame_schedule.{
    RETAINED_SCHEDULE_EXECUTE, RETAINED_SCHEDULE_REJECT_PROFILE,
    RETAINED_SCHEDULE_REJECT_STATE
}
use common.ui.render_opt.wm_retained_damage_consumer.{
    WmRetainedDamageConsumer, WM_DAMAGE_LEVEL_CPU,
    WM_DAMAGE_LEVEL_PRESENTER
}

describe "WM multiscale retained damage consumer":
    it "retains the declared coarse CPU and presenter levels":
        val consumer = WmRetainedDamageConsumer.create(7680, 4320)
        expect(consumer.pyramid.level_count).to_equal(3)
        expect(consumer.pyramid.tile_w).to_equal([256u32, 64u32, 32u32])
        expect(consumer.planning_level(false)).to_equal(WM_DAMAGE_LEVEL_CPU)
        expect(consumer.planning_level(true)).to_equal(WM_DAMAGE_LEVEL_PRESENTER)

    it "builds the CPU-scale schedule from current property damage":
        var trees = PropertyTrees.create()
        trees.push_damage(128, 64, 16, 16)
        val consumer = WmRetainedDamageConsumer.create(512, 256)
        val schedule = consumer.schedule(
            trees, false, 1000, 64, 1, "focused-unit-profile")
        expect(schedule.status).to_equal(RETAINED_SCHEDULE_EXECUTE)
        expect(schedule.plan_mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(schedule.plan_rects).to_equal([128, 64, 64, 64])

    it "rejects an unmeasured or malformed property-damage frame":
        var trees = PropertyTrees.create()
        trees.push_damage(0, 0, 1, 1)
        val consumer = WmRetainedDamageConsumer.create(64, 64)
        val unmeasured = consumer.schedule(trees, false, 0, 0, 0, "")
        expect(unmeasured.status).to_equal(RETAINED_SCHEDULE_REJECT_PROFILE)
        trees.damage_x = []
        val malformed = consumer.schedule(
            trees, false, 1000, 64, 1, "focused-unit-profile")
        expect(malformed.status).to_equal(RETAINED_SCHEDULE_REJECT_STATE)
