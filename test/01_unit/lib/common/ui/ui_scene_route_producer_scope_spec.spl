# @tag: unit, ui, draw_ir_v3, unified_packed_ui_scene, l9
# Regression for doc/08_tracking/bug/ui_scene_route_owner_lookup_ignores_producer_scope_2026-08-08.md:
# two producers' owner records share a producer-private semantic_id in one table.

use std.spec
use std.spec.step
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID, DRAW_IR_V3_HIT_RECT, DRAW_IR_V3_KIND_RECT, DrawIrV3Scene,
    draw_ir_v3_empty_scene, draw_ir_v3_empty_command, draw_ir_v3_scene_push_command,
    draw_ir_v3_hit_shape_append
}
use common.ui.draw_ir_v3_group_resolve.{draw_ir_v3_group_resolve, draw_ir_v3_port_surface_state_empty}
use common.ui.ui_scene_counts.{UI_PRODUCER_WM, UI_PRODUCER_GUI}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, UI_SCENE_EVENT_POLICY_HIT_OPAQUE}
use common.ui.ui_scene_event_route.{
    UI_SCENE_ROUTE_OK, UI_SCENE_ROUTE_REFUSE_AMBIGUOUS_OWNER,
    ui_scene_route_event, ui_scene_route_event_scoped
}

# One GUI button command (component 3, generation 9) at (0,0,20,20).
fn _scene() -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(1u32, 1u32)
    scene.hit_shapes = draw_ir_v3_hit_shape_append(scene.hit_shapes, 0, 0, 20, 20, DRAW_IR_V3_HIT_RECT, 0u16, 3u32)
    var button = draw_ir_v3_empty_command()
    button.kind = DRAW_IR_V3_KIND_RECT
    button.component_id = 3u32
    button.component_generation = 9u32
    button.hit_shape_id = 0u32
    draw_ir_v3_scene_push_command(scene, button)

fn _owner(kind: u16, semantic_id: u32, generation: u32, action: u32) -> UiOwnerRecord:
    UiOwnerRecord(
        producer_kind: kind, event_policy: UI_SCENE_EVENT_POLICY_HIT_OPAQUE,
        semantic_id: semantic_id, semantic_generation: generation,
        parent_owner_id: DRAW_IR_V3_NO_ID, action_binding_id: action
    )

# WM row first (so a first-match scan picks it), GUI row second; both id 3.
fn _owners(wm_generation: u32) -> [UiOwnerRecord]:
    [_owner(UI_PRODUCER_WM, 3u32, wm_generation, 11u32), _owner(UI_PRODUCER_GUI, 3u32, 9u32, 22u32)]

describe "ui_scene_route_event producer scope":
    it "routes to the producer that emitted the hit command, not the first id match":
        step("Command 0 is a GUI command; owner rows are WM#3 then GUI#3")
        val scene = _scene()
        val resolved = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val r = ui_scene_route_event_scoped(scene, resolved, _owners(0u32), [UI_PRODUCER_GUI], 5, 5)
        expect(r.accepted).to_equal(true)
        expect(r.reason).to_equal(UI_SCENE_ROUTE_OK)
        expect(r.owner_chain[0]).to_equal(1u32)
        expect(r.action_binding_id).to_equal(22u32)

    it "never reports a cross-producer collision as a stale generation":
        step("Unscoped routing over a colliding table refuses as ambiguous")
        val scene = _scene()
        val resolved = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val r = ui_scene_route_event(scene, resolved, _owners(9u32), 5, 5)
        expect(r.accepted).to_equal(false)
        expect(r.reason).to_equal(UI_SCENE_ROUTE_REFUSE_AMBIGUOUS_OWNER)
        expect(r.action_binding_id).to_equal(DRAW_IR_V3_NO_ID)

    it "never invokes the other producer's action binding":
        step("Scoped to WM, the WM owner and its action are chosen")
        val scene = _scene()
        val resolved = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val r = ui_scene_route_event_scoped(scene, resolved, _owners(9u32), [UI_PRODUCER_WM], 5, 5)
        expect(r.accepted).to_equal(true)
        expect(r.action_binding_id).to_equal(11u32)
