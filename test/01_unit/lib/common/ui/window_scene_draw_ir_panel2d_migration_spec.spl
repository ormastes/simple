"""
## Purpose and audience
Purpose: Prove that _wm_window_draw_ir_embedding — Panel2D-derived embedding matches the pre-migration formula.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/window_scene_draw_ir.spl 80%
"""
# Internal window Panel2D migration — conformance spec

**Feature IDs:** N/A (Lane L2 adoption gap, D3 of
doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md)
**Category:** Stdlib / UI / Window manager
**Status:** Implemented
**Plan:** doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md

## Overview

D3 named internal windows (`simple_gui_internal_window`) as a Panel2D
consumer, but Panel2D had zero internal-window callers -- this closes that
gap. `_wm_window_panel2d` (window_scene_draw_ir.spl) now composes a
`Panel2D` for a window's geometry/layer/opacity_milli/clip instead of a
hand-rolled `draw_ir_embedding_config` call, and `_wm_window_draw_ir_embedding`
routes the actual DrawIR embedding through Panel2D's own projection
(`panel_to_draw_ir_batch`). `_wm_draw_ir_window_batch`'s visual command
list (theme'd rects/text/fonts) is untouched -- only the rect/layer/clip
plumbing moved, so `simple_gui_internal_window` callers see identical output.

This spec proves: (1) the migrated embedding is byte-for-byte what the
pre-migration inline formula produced, (2) layering between two window
panels resolves the same way the DrawIR embedding's `layer` field always
implied, (3) `clip=true` on a window panel still excludes out-of-bounds
child content per the shared interaction core (not a window-specific
reimplementation), (4) a translucent window panel remains hit-testable
(D3's opacity-is-render-only contract), and (5) a window panel that opts
into scroll participates in the same wheel-clamp mechanism the taskbar and
generic panels already prove.
"""

use std.spec.*
use common.ui.window_scene.{
    simple_gui_internal_window,
    simple_gui_internal_window_with_chrome_kind,
    simple_gui_internal_window_scene,
    SharedWmWindow,
    SharedWmScene,
    WM_CHROME_KIND_BORDERLESS
}
use common.ui.window_scene_draw_ir.{
    _wm_window_panel2d,
    _wm_window_draw_ir_embedding,
    _wm_draw_ir_window_batch,
    _wm_draw_ir_window_opacity,
    WM_WINDOW_SHADOW_OFFSET_X,
    WM_WINDOW_SHADOW_OFFSET_Y
}
use std.common.ui.panel2d.{
    Panel2D, panel2d, panel_add_child, panel_with_scroll, panel_dispatch_pointer
}
use std.common.ui.scroll_surface.{ScrollModel, max_scroll}
use std.common.engine.interaction.pointer_event.{PointerEvent2D, POINTER_DOWN, POINTER_WHEEL}

fn _win(surface_id: text, window_id: text, x: i32, y: i32, w: i32, h: i32, z: i32, focused: bool) -> SharedWmWindow:
    simple_gui_internal_window(surface_id, window_id, 1u64, "notes", "Title-{window_id}", x, y, w, h, "", false, focused, z)

describe "_wm_window_draw_ir_embedding — Panel2D-derived embedding matches the pre-migration formula":

    it "a focused titled window: shadow-inflated size, layer = z+10, opacity 1000, clip true, surface_id preserved":
        # @req: REQ-LIB-COMMON-001
        step("window at (40,60,300,200), z=3, focused, on an 800x600 scene -- plenty of room for the shadow")
        val win = _win("surf-a", "win-a", 40, 60, 300, 200, 3, true)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])

        val embedding = _wm_window_draw_ir_embedding(scene, win)
        expect(embedding.surface_id).to_equal("surf-a")
        expect(embedding.component_id).to_equal("win-a")
        expect(embedding.x).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(embedding.y).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(embedding.width).to_equal(300 + WM_WINDOW_SHADOW_OFFSET_X)
        expect(embedding.height).to_equal(200 + WM_WINDOW_SHADOW_OFFSET_Y)
        expect(embedding.layer).to_equal(13)  # oracle: 13 — named expected value from the requirement
        expect(embedding.opacity_milli).to_equal(1000)  # oracle: 1000 — named expected value from the requirement
        assert_true(embedding.clip)

    it "an unfocused window gets the unfocused opacity (930)":
        step("Verify: an unfocused window gets the unfocused opacity (930)")
        val win = _win("surf-b", "win-b", 0, 0, 100, 100, 0, false)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])
        expect(_wm_window_draw_ir_embedding(scene, win).opacity_milli).to_equal(_wm_draw_ir_window_opacity(win))
        expect(_wm_window_draw_ir_embedding(scene, win).opacity_milli).to_equal(930)  # oracle: 930 — named expected value from the requirement

    it "a borderless window gets no shadow inflation but keeps clip true":
        step("chrome_kind=borderless skips the shadow calc entirely (pre-migration behaviour)")
        val win = simple_gui_internal_window_with_chrome_kind("surf-c", "win-c", 1u64, "notes", "C", 0, 0, 100, 100, "", false, true, 0, WM_CHROME_KIND_BORDERLESS)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])

        val embedding = _wm_window_draw_ir_embedding(scene, win)
        expect(embedding.width).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(embedding.height).to_equal(100)  # oracle: 100 — named expected value from the requirement
        assert_true(embedding.clip)

    it "_wm_draw_ir_window_batch's own embedding is the same value _wm_window_draw_ir_embedding produces":
        step("the production batch builder must route through the same Panel2D-derived embedding, not a parallel copy")
        val win = _win("surf-d", "win-d", 10, 20, 150, 120, 2, true)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])

        val batch = _wm_draw_ir_window_batch(scene, win, "cpu")
        val embedding = _wm_window_draw_ir_embedding(scene, win)
        expect(batch.embedding.x).to_equal(embedding.x)
        expect(batch.embedding.y).to_equal(embedding.y)
        expect(batch.embedding.width).to_equal(embedding.width)
        expect(batch.embedding.height).to_equal(embedding.height)
        expect(batch.embedding.layer).to_equal(embedding.layer)
        expect(batch.embedding.opacity_milli).to_equal(embedding.opacity_milli)
        expect(batch.embedding.clip).to_equal(embedding.clip)
        expect(batch.embedding.surface_id).to_equal(embedding.surface_id)

describe "_wm_window_panel2d — layering between two window panels":

    it "of two overlapping windows, the higher z_index (higher Panel2D layer) is the hit target":
        step("both windows cover (0,0)-(200,200); win-hi has the higher z_index")
        val win_lo = _win("surf-lo", "win-lo", 0, 0, 200, 200, 1, false)
        val win_hi = _win("surf-hi", "win-hi", 0, 0, 200, 200, 5, true)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win_lo, win_hi])

        val panel_lo = _wm_window_panel2d(scene, win_lo)
        val panel_hi = _wm_window_panel2d(scene, win_hi)
        assert_true(panel_hi.layer > panel_lo.layer)

        step("(100,100) is below the titlebar/close-button strip for both -- lands in each window's body")
        val event = PointerEvent2D.create(1, POINTER_DOWN, 100, 100, 1, -1)
        val result = panel_dispatch_pointer([panel_lo, panel_hi], event, [])
        expect(result.target_name).to_equal("win-hi-body")

describe "_wm_window_panel2d — clip=true excludes content outside the window rect":

    it "a child positioned past the window's (shadow-inflated) bounds does not hit-test once clip is true":
        step("100x100 window on an 800x600 scene -> shadow-inflated panel rect is (0,0,105,106); an added child at (80,80,40,40) spans x:80-120,y:80-120")
        val win = _win("surf-e", "win-e", 0, 0, 100, 100, 0, true)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])
        var panel = _wm_window_panel2d(scene, win)
        assert_true(panel.clip)
        panel = panel_add_child(panel, panel2d("win-e-overflow", 80, 80, 40, 40))

        step("(110,90) is inside the overflow child's raw bounds but past the panel's clipped width (105)")
        val event = PointerEvent2D.create(1, POINTER_DOWN, 110, 90, 1, -1)
        val clipped_result = panel_dispatch_pointer([panel], event, [])
        expect(clipped_result.target_node).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        step("control: with clip off, the same point DOES hit the overflow child -- proves clip, not something else, excluded it")
        var unclipped = panel
        unclipped.clip = false
        val unclipped_result = panel_dispatch_pointer([unclipped], event, [])
        expect(unclipped_result.target_name).to_equal("win-e-overflow")

describe "_wm_window_panel2d — a translucent window remains hit-testable (D3: opacity_milli is render-only)":

    it "opacity_milli=50 does not block a pointer hit on the window body":
        step("Verify: opacity_milli=50 does not block a pointer hit on the window body")
        val win = _win("surf-f", "win-f", 0, 0, 200, 200, 0, true)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])
        var panel = _wm_window_panel2d(scene, win)
        panel.opacity_milli = 50

        val event = PointerEvent2D.create(1, POINTER_DOWN, 100, 100, 1, -1)
        val result = panel_dispatch_pointer([panel], event, [])
        expect(result.target_name).to_equal("win-f-body")

describe "_wm_window_panel2d — a window panel that opts into scroll":

    it "scrolls by the wheel delta and clamps at max_scroll, through the same panel_dispatch_pointer path as any other panel":
        val win = _win("surf-g", "win-g", 0, 0, 200, 200, 0, true)
        val scene = simple_gui_internal_window_scene(800, 600, "cpu", [win])
        val model = ScrollModel(total_rows: 100, view_w: 200, view_h: 200)
        var panel = panel_with_scroll(_wm_window_panel2d(scene, win), model)

        step("a small wheel delta scrolls by exactly that amount")
        var event = PointerEvent2D.create(1, POINTER_WHEEL, 100, 100, 0, -1)
        event.delta_y = 30
        val result = panel_dispatch_pointer([panel], event, [])
        assert_true(result.scrolled)
        expect(result.panels[0].scroll_offset).to_equal(30)  # oracle: 30 — named expected value from the requirement

        step("a huge wheel delta clamps at max_scroll instead of overshooting")
        var event2 = PointerEvent2D.create(2, POINTER_WHEEL, 100, 100, 0, -1)
        event2.delta_y = 100000
        val result2 = panel_dispatch_pointer(result.panels, event2, [])
        expect(result2.panels[0].scroll_offset).to_equal(max_scroll(model))
