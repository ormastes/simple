"""
## Purpose and audience
Purpose: Prove that frozen DrawIR v3 contract.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/draw_ir_v3.spl 80%
# @tag: unit, ui, draw_ir, draw_ir_v3

use std.spec
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_FLAG_CLIPPED,
    DRAW_IR_V3_FLAG_HIDDEN,
    DRAW_IR_V3_FLAG_HIT_TESTABLE,
    DRAW_IR_V3_FLAG_TRANSFORMED,
    DRAW_IR_V3_HIT_ROUNDED_RECT,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_KIND_TEXT,
    DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_PROVENANCE_PAINT_OF,
    DRAW_IR_V3_RESOURCE_IMAGE,
    DRAW_IR_V3_SCHEMA_ID,
    DRAW_IR_V3_SCHEMA_VERSION,
    DRAW_IR_V3_VERB_LINE,
    DRAW_IR_V3_VERB_MOVE,
    DrawIrV3Command,
    DrawIrV3Scene,
    draw_ir_v3_clip_append,
    draw_ir_v3_clip_at,
    draw_ir_v3_clip_next_id,
    draw_ir_v3_command,
    draw_ir_v3_empty_clip_table,
    draw_ir_v3_empty_command,
    draw_ir_v3_empty_geometry_table,
    draw_ir_v3_empty_hit_shape_table,
    draw_ir_v3_empty_paint_table,
    draw_ir_v3_empty_path_point_table,
    draw_ir_v3_empty_provenance_table,
    draw_ir_v3_empty_resource_table,
    draw_ir_v3_empty_scene,
    draw_ir_v3_empty_text_run_table,
    draw_ir_v3_empty_transform_table,
    draw_ir_v3_geometry_append,
    draw_ir_v3_geometry_at,
    draw_ir_v3_geometry_next_id,
    draw_ir_v3_glyph_append,
    draw_ir_v3_glyph_at,
    draw_ir_v3_glyph_next_id,
    draw_ir_v3_has_flag,
    draw_ir_v3_hit_shape_append,
    draw_ir_v3_hit_shape_at,
    draw_ir_v3_hit_shape_next_id,
    draw_ir_v3_paint_append,
    draw_ir_v3_paint_at,
    draw_ir_v3_paint_next_id,
    draw_ir_v3_path_point_append,
    draw_ir_v3_path_point_at,
    draw_ir_v3_path_point_next_id,
    draw_ir_v3_path_span_append,
    draw_ir_v3_path_span_at,
    draw_ir_v3_path_span_next_id,
    draw_ir_v3_provenance_append,
    draw_ir_v3_provenance_at,
    draw_ir_v3_provenance_next_id,
    draw_ir_v3_resource_append,
    draw_ir_v3_resource_at,
    draw_ir_v3_resource_next_id,
    draw_ir_v3_scene_command_at,
    draw_ir_v3_scene_command_count,
    draw_ir_v3_scene_push_command,
    draw_ir_v3_text_run_append,
    draw_ir_v3_text_run_at,
    draw_ir_v3_text_run_next_id,
    draw_ir_v3_transform_append,
    draw_ir_v3_transform_at,
    draw_ir_v3_transform_next_id
}

# A scene carrying one fully-populated command that references every one of the
# nine side tables. Returned by value so each example builds its own.
fn build_reference_scene() -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(11u32, 4u32)

    scene.geometry = draw_ir_v3_geometry_append(scene.geometry, 12, 34, 200, 48, 6)
    val geometry_id = 0u32

    scene.paint = draw_ir_v3_paint_append(
        scene.paint, 0xff2196f3u32, 0xff0d47a1u32, 1500, 900, 2u16
    )
    val paint_id = 0u32

    scene.text_runs = draw_ir_v3_glyph_append(scene.text_runs, 71u32, 4, 18, 0)
    scene.text_runs = draw_ir_v3_glyph_append(scene.text_runs, 72u32, 11, 18, 1)
    scene.text_runs = draw_ir_v3_glyph_append(scene.text_runs, 73u32, 19, 18, 2)
    scene.text_runs = draw_ir_v3_text_run_append(
        scene.text_runs, 0u32, 3u32, 5u32, 14000, 4, 18, 0xffffffffu32
    )
    val text_run_id = 0u32

    scene.resources = draw_ir_v3_resource_append(
        scene.resources, DRAW_IR_V3_RESOURCE_IMAGE, 3u32, 640u32, 480u32, 8877665544332211
    )
    val resource_id = 0u32

    scene.path_points = draw_ir_v3_path_point_append(scene.path_points, 0, 0, DRAW_IR_V3_VERB_MOVE)
    scene.path_points = draw_ir_v3_path_point_append(scene.path_points, 40, 0, DRAW_IR_V3_VERB_LINE)
    scene.path_points = draw_ir_v3_path_point_append(scene.path_points, 40, 25, DRAW_IR_V3_VERB_LINE)
    scene.path_points = draw_ir_v3_path_span_append(scene.path_points, 0u32, 3u32, 1u16)
    val path_span_id = 0u32

    scene.clips = draw_ir_v3_clip_append(scene.clips, 0, 0, 300, 200, 0, DRAW_IR_V3_NO_ID)
    scene.clips = draw_ir_v3_clip_append(scene.clips, 10, 10, 120, 60, 4, 0u32)
    val clip_id = 1u32

    scene.transforms = draw_ir_v3_transform_append(scene.transforms, 1000, 0, 0, 1000, 25, 40)
    val transform_id = 0u32

    scene.hit_shapes = draw_ir_v3_hit_shape_append(
        scene.hit_shapes, 12, 34, 200, 48, DRAW_IR_V3_HIT_ROUNDED_RECT, 1u16, 9001u32
    )
    val hit_shape_id = 0u32

    scene.provenance = draw_ir_v3_provenance_append(
        scene.provenance, 0u32, DRAW_IR_V3_PROVENANCE_PAINT_OF, 501u32, 77u32, 128u32, 42u32
    )

    val command = draw_ir_v3_command(
        DRAW_IR_V3_KIND_RECT,
        DRAW_IR_V3_FLAG_CLIPPED | DRAW_IR_V3_FLAG_HIT_TESTABLE,
        9001u32, 4u32, 8000u32,
        geometry_id, paint_id, text_run_id, resource_id, path_span_id,
        clip_id, transform_id, hit_shape_id
    )
    draw_ir_v3_scene_push_command(scene, command)

# Reduce a command to the flat integer record a device buffer would hold.
fn command_to_words(command: DrawIrV3Command) -> [i64]:
    [
        command.kind.to_i64(),
        command.flags.to_i64(),
        command.component_id.to_i64(),
        command.component_generation.to_i64(),
        command.parent_id.to_i64(),
        command.geometry_id.to_i64(),
        command.paint_id.to_i64(),
        command.text_run_id.to_i64(),
        command.image_resource_id.to_i64(),
        command.path_span_id.to_i64(),
        command.clip_id.to_i64(),
        command.transform_id.to_i64(),
        command.hit_shape_id.to_i64()
    ]

# Rebuild a command from nothing but that flat integer record.
fn command_from_words(words: [i64]) -> DrawIrV3Command:
    draw_ir_v3_command(
        words[0] as u16,
        words[1] as u16,
        words[2] as u32,
        words[3] as u32,
        words[4] as u32,
        words[5] as u32,
        words[6] as u32,
        words[7] as u32,
        words[8] as u32,
        words[9] as u32,
        words[10] as u32,
        words[11] as u32,
        words[12] as u32
    )

describe "frozen DrawIR v3 contract":

    it "publishes an explicit schema version distinct from v2":
        step("Verify: publishes an explicit schema version distinct from v2")
        # @req: REQ-LIB-COMMON-001
        expect(DRAW_IR_V3_SCHEMA_VERSION).to_equal("simple-draw-ir-v3")
        expect(DRAW_IR_V3_SCHEMA_ID).to_equal(4u32)

        val scene = draw_ir_v3_empty_scene(1u32, 0u32)
        expect(scene.schema).to_equal(DRAW_IR_V3_SCHEMA_VERSION)
        expect(scene.schema_id).to_equal(DRAW_IR_V3_SCHEMA_ID)
        expect(draw_ir_v3_scene_command_count(scene)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "resolves a command through every side table to the values that were stored":
        step("Verify: resolves a command through every side table to the values that were stored")
        val scene = build_reference_scene()
        expect(draw_ir_v3_scene_command_count(scene)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val command = draw_ir_v3_scene_command_at(scene, 0)

        expect(command.kind).to_equal(DRAW_IR_V3_KIND_RECT)
        expect(command.component_id).to_equal(9001u32)
        expect(command.component_generation).to_equal(4u32)
        expect(command.parent_id).to_equal(8000u32)

        val geometry = draw_ir_v3_geometry_at(scene.geometry, command.geometry_id)
        expect(geometry.present).to_equal(true)
        expect(geometry.x).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(geometry.y).to_equal(34)  # oracle: 34 — named expected value from the requirement
        expect(geometry.width).to_equal(200)  # oracle: 200 — named expected value from the requirement
        expect(geometry.height).to_equal(48)  # oracle: 48 — named expected value from the requirement
        expect(geometry.corner_radius).to_equal(6)  # oracle: 6 — named expected value from the requirement

        val paint = draw_ir_v3_paint_at(scene.paint, command.paint_id)
        expect(paint.present).to_equal(true)
        expect(paint.fill_color).to_equal(0xff2196f3u32)
        expect(paint.stroke_color).to_equal(0xff0d47a1u32)
        expect(paint.stroke_width_milli).to_equal(1500)  # oracle: 1500 — named expected value from the requirement
        expect(paint.opacity_milli).to_equal(900)  # oracle: 900 — named expected value from the requirement

        val run = draw_ir_v3_text_run_at(scene.text_runs, command.text_run_id)
        expect(run.present).to_equal(true)
        expect(run.glyph_count).to_equal(3u32)
        expect(run.font_resource_id).to_equal(5u32)
        expect(run.font_size_milli).to_equal(14000)  # oracle: 14000 — named expected value from the requirement
        expect(run.baseline_x).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(run.baseline_y).to_equal(18)  # oracle: 18 — named expected value from the requirement

        val resource = draw_ir_v3_resource_at(scene.resources, command.image_resource_id)
        expect(resource.present).to_equal(true)
        expect(resource.kind).to_equal(DRAW_IR_V3_RESOURCE_IMAGE)
        expect(resource.width).to_equal(640u32)
        expect(resource.height).to_equal(480u32)
        expect(resource.content_hash).to_equal(8877665544332211)  # oracle: 8877665544332211 — named expected value from the requirement

        val span = draw_ir_v3_path_span_at(scene.path_points, command.path_span_id)
        expect(span.present).to_equal(true)
        expect(span.point_start).to_equal(0u32)
        expect(span.point_count).to_equal(3u32)

        val clip = draw_ir_v3_clip_at(scene.clips, command.clip_id)
        expect(clip.present).to_equal(true)
        expect(clip.x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(clip.y).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(clip.width).to_equal(120)  # oracle: 120 — named expected value from the requirement
        expect(clip.height).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(clip.parent_id).to_equal(0u32)

        val transform = draw_ir_v3_transform_at(scene.transforms, command.transform_id)
        expect(transform.present).to_equal(true)
        expect(transform.m11).to_equal(1000)  # oracle: 1000 — named expected value from the requirement
        expect(transform.m22).to_equal(1000)  # oracle: 1000 — named expected value from the requirement
        expect(transform.dx).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(transform.dy).to_equal(40)  # oracle: 40 — named expected value from the requirement

        val hit = draw_ir_v3_hit_shape_at(scene.hit_shapes, command.hit_shape_id)
        expect(hit.present).to_equal(true)
        expect(hit.shape_kind).to_equal(DRAW_IR_V3_HIT_ROUNDED_RECT)
        expect(hit.component_id).to_equal(command.component_id)

        val provenance = draw_ir_v3_provenance_at(scene.provenance, 0u32)
        expect(provenance.present).to_equal(true)
        expect(provenance.command_index).to_equal(0u32)
        expect(provenance.edge_kind).to_equal(DRAW_IR_V3_PROVENANCE_PAINT_OF)
        expect(provenance.source_node_id).to_equal(501u32)
        expect(provenance.source_rule_id).to_equal(77u32)
        expect(provenance.source_span_start).to_equal(128u32)
        expect(provenance.source_span_len).to_equal(42u32)

    it "keeps every render-hot reference numeric so a command survives a text-free round trip":
        step("Verify: keeps every render-hot reference numeric so a command survives a text-free round trip")
        val scene = build_reference_scene()
        val original = draw_ir_v3_scene_command_at(scene, 0)

        # The command is reduced to integers only: no text key participates.
        val words = command_to_words(original)
        expect(words.len()).to_equal(13)  # oracle: 13 — named expected value from the requirement
        val rebuilt = command_from_words(words)

        expect(rebuilt.kind).to_equal(original.kind)
        expect(rebuilt.flags).to_equal(original.flags)
        expect(rebuilt.component_id).to_equal(original.component_id)
        expect(rebuilt.component_generation).to_equal(original.component_generation)
        expect(rebuilt.parent_id).to_equal(original.parent_id)
        expect(rebuilt.geometry_id).to_equal(original.geometry_id)
        expect(rebuilt.paint_id).to_equal(original.paint_id)
        expect(rebuilt.text_run_id).to_equal(original.text_run_id)
        expect(rebuilt.image_resource_id).to_equal(original.image_resource_id)
        expect(rebuilt.path_span_id).to_equal(original.path_span_id)
        expect(rebuilt.clip_id).to_equal(original.clip_id)
        expect(rebuilt.transform_id).to_equal(original.transform_id)
        expect(rebuilt.hit_shape_id).to_equal(original.hit_shape_id)

        # And the integer-only rebuild resolves to the same side-table values.
        val from_original = draw_ir_v3_geometry_at(scene.geometry, original.geometry_id)
        val from_rebuilt = draw_ir_v3_geometry_at(scene.geometry, rebuilt.geometry_id)
        expect(from_rebuilt.x).to_equal(from_original.x)
        expect(from_rebuilt.y).to_equal(from_original.y)
        expect(from_rebuilt.width).to_equal(from_original.width)
        expect(from_rebuilt.height).to_equal(from_original.height)

        val paint_original = draw_ir_v3_paint_at(scene.paint, original.paint_id)
        val paint_rebuilt = draw_ir_v3_paint_at(scene.paint, rebuilt.paint_id)
        expect(paint_rebuilt.fill_color).to_equal(paint_original.fill_color)
        expect(paint_rebuilt.opacity_milli).to_equal(paint_original.opacity_milli)

    it "expresses variable-length payloads as flat spans rather than nested arrays":
        step("Verify: expresses variable-length payloads as flat spans rather than nested arrays")
        val scene = build_reference_scene()
        val command = draw_ir_v3_scene_command_at(scene, 0)

        val run = draw_ir_v3_text_run_at(scene.text_runs, command.text_run_id)
        var glyph_x_total = 0
        var i = run.glyph_start.to_i64()
        val glyph_end = run.glyph_start.to_i64() + run.glyph_count.to_i64()
        var first_glyph_id = 0u32
        while i < glyph_end:
            val glyph = draw_ir_v3_glyph_at(scene.text_runs, i as u32)
            expect(glyph.present).to_equal(true)
            if i == run.glyph_start.to_i64():
                first_glyph_id = glyph.glyph_id
            glyph_x_total = glyph_x_total + glyph.x
            i = i + 1
        expect(first_glyph_id).to_equal(71u32)
        expect(glyph_x_total).to_equal(34)  # oracle: 34 — named expected value from the requirement
        expect(draw_ir_v3_glyph_next_id(scene.text_runs)).to_equal(3u32)

        val span = draw_ir_v3_path_span_at(scene.path_points, command.path_span_id)
        var verbs_seen = 0
        var p = span.point_start.to_i64()
        val point_end = span.point_start.to_i64() + span.point_count.to_i64()
        while p < point_end:
            val point = draw_ir_v3_path_point_at(scene.path_points, p as u32)
            expect(point.present).to_equal(true)
            verbs_seen = verbs_seen + 1
            p = p + 1
        expect(verbs_seen).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(draw_ir_v3_path_point_at(scene.path_points, 0u32).verb).to_equal(DRAW_IR_V3_VERB_MOVE)
        expect(draw_ir_v3_path_point_at(scene.path_points, 1u32).verb).to_equal(DRAW_IR_V3_VERB_LINE)

    it "reads an absent or out-of-range side-table reference as not present":
        step("Verify: reads an absent or out-of-range side-table reference as not present")
        val scene = build_reference_scene()
        val blank = draw_ir_v3_empty_command()

        expect(blank.geometry_id).to_equal(DRAW_IR_V3_NO_ID)
        expect(draw_ir_v3_geometry_at(scene.geometry, blank.geometry_id).present).to_equal(false)
        expect(draw_ir_v3_paint_at(scene.paint, blank.paint_id).present).to_equal(false)
        expect(draw_ir_v3_text_run_at(scene.text_runs, blank.text_run_id).present).to_equal(false)
        expect(draw_ir_v3_resource_at(scene.resources, blank.image_resource_id).present).to_equal(false)
        expect(draw_ir_v3_path_span_at(scene.path_points, blank.path_span_id).present).to_equal(false)
        expect(draw_ir_v3_clip_at(scene.clips, blank.clip_id).present).to_equal(false)
        expect(draw_ir_v3_transform_at(scene.transforms, blank.transform_id).present).to_equal(false)
        expect(draw_ir_v3_hit_shape_at(scene.hit_shapes, blank.hit_shape_id).present).to_equal(false)
        expect(draw_ir_v3_provenance_at(scene.provenance, DRAW_IR_V3_NO_ID).present).to_equal(false)

        # Past-the-end ids are rejected the same way as the sentinel.
        expect(draw_ir_v3_geometry_at(scene.geometry, 99u32).present).to_equal(false)
        expect(draw_ir_v3_clip_at(scene.clips, 2u32).present).to_equal(false)
        expect(draw_ir_v3_scene_command_at(scene, 7).kind).to_equal(draw_ir_v3_empty_command().kind)

    it "hands out the appended row id and keeps earlier rows readable":
        step("Verify: hands out the appended row id and keeps earlier rows readable")
        var geometry = draw_ir_v3_empty_geometry_table()
        expect(draw_ir_v3_geometry_next_id(geometry)).to_equal(0u32)
        geometry = draw_ir_v3_geometry_append(geometry, 1, 2, 3, 4, 5)
        expect(draw_ir_v3_geometry_next_id(geometry)).to_equal(1u32)
        geometry = draw_ir_v3_geometry_append(geometry, 6, 7, 8, 9, 10)
        expect(draw_ir_v3_geometry_next_id(geometry)).to_equal(2u32)
        expect(draw_ir_v3_geometry_at(geometry, 0u32).x).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(draw_ir_v3_geometry_at(geometry, 1u32).x).to_equal(6)  # oracle: 6 — named expected value from the requirement

        var paint = draw_ir_v3_empty_paint_table()
        paint = draw_ir_v3_paint_append(paint, 1u32, 2u32, 3, 4, 0u16)
        expect(draw_ir_v3_paint_next_id(paint)).to_equal(1u32)

        var resources = draw_ir_v3_empty_resource_table()
        resources = draw_ir_v3_resource_append(resources, DRAW_IR_V3_RESOURCE_IMAGE, 1u32, 8u32, 8u32, 5)
        expect(draw_ir_v3_resource_next_id(resources)).to_equal(1u32)

        var clips = draw_ir_v3_empty_clip_table()
        clips = draw_ir_v3_clip_append(clips, 1, 1, 1, 1, 0, DRAW_IR_V3_NO_ID)
        expect(draw_ir_v3_clip_next_id(clips)).to_equal(1u32)

        var transforms = draw_ir_v3_empty_transform_table()
        transforms = draw_ir_v3_transform_append(transforms, 1000, 0, 0, 1000, 0, 0)
        expect(draw_ir_v3_transform_next_id(transforms)).to_equal(1u32)

        var hits = draw_ir_v3_empty_hit_shape_table()
        hits = draw_ir_v3_hit_shape_append(hits, 0, 0, 4, 4, DRAW_IR_V3_HIT_ROUNDED_RECT, 0u16, 1u32)
        expect(draw_ir_v3_hit_shape_next_id(hits)).to_equal(1u32)

        var provenance = draw_ir_v3_empty_provenance_table()
        provenance = draw_ir_v3_provenance_append(provenance, 0u32, DRAW_IR_V3_PROVENANCE_PAINT_OF, 1u32, 2u32, 3u32, 4u32)
        expect(draw_ir_v3_provenance_next_id(provenance)).to_equal(1u32)

        var runs = draw_ir_v3_empty_text_run_table()
        runs = draw_ir_v3_glyph_append(runs, 1u32, 0, 0, 0)
        runs = draw_ir_v3_text_run_append(runs, 0u32, 1u32, 0u32, 12000, 0, 0, 0u32)
        expect(draw_ir_v3_text_run_next_id(runs)).to_equal(1u32)

        var paths = draw_ir_v3_empty_path_point_table()
        paths = draw_ir_v3_path_point_append(paths, 0, 0, DRAW_IR_V3_VERB_MOVE)
        paths = draw_ir_v3_path_span_append(paths, 0u32, 1u32, 0u16)
        expect(draw_ir_v3_path_span_next_id(paths)).to_equal(1u32)
        expect(draw_ir_v3_path_point_next_id(paths)).to_equal(1u32)

    it "reports command flags as an independent bitmask":
        step("Verify: reports command flags as an independent bitmask")
        val scene = build_reference_scene()
        val command = draw_ir_v3_scene_command_at(scene, 0)

        expect(draw_ir_v3_has_flag(command, DRAW_IR_V3_FLAG_CLIPPED)).to_equal(true)
        expect(draw_ir_v3_has_flag(command, DRAW_IR_V3_FLAG_HIT_TESTABLE)).to_equal(true)
        expect(draw_ir_v3_has_flag(command, DRAW_IR_V3_FLAG_TRANSFORMED)).to_equal(false)
        expect(draw_ir_v3_has_flag(command, DRAW_IR_V3_FLAG_HIDDEN)).to_equal(false)

    it "keeps v2 commands and v3 commands as separate schemas":
        step("Verify: keeps v2 commands and v3 commands as separate schemas")
        val v3 = draw_ir_v3_empty_command()
        expect(v3.component_id).to_equal(0u32)
        expect(v3.kind).to_equal(0u16)

        var scene = draw_ir_v3_empty_scene(2u32, 1u32)
        scene = draw_ir_v3_scene_push_command(scene, draw_ir_v3_command(
            DRAW_IR_V3_KIND_TEXT, DRAW_IR_V3_FLAG_TRANSFORMED,
            1u32, 1u32, DRAW_IR_V3_NO_ID,
            DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID,
            DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID,
            DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID
        ))
        expect(draw_ir_v3_scene_command_count(scene)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(draw_ir_v3_scene_command_at(scene, 0).kind).to_equal(DRAW_IR_V3_KIND_TEXT)
        expect(scene.schema_id).to_equal(DRAW_IR_V3_SCHEMA_ID)
