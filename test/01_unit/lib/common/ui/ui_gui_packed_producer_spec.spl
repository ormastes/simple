"""
## Purpose and audience
Purpose: Prove that GuiPackedProducer count/emit exactness (design section 2.2, lane L6).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/ui_gui_packed_producer.spl 70%
# @tag: unit, ui, draw_ir, draw_ir_v3, unified_packed_ui_scene, l6

use std.spec
use common.ui.widget.{WidgetNode}
use common.ui.builder.{column, with_background, with_height, with_width, button}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}
use common.ui.draw_ir_v2_to_v3.{draw_ir_v2_to_v3}
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID,
    draw_ir_v3_empty_command,
    draw_ir_v3_empty_scene,
    draw_ir_v3_scene_push_command,
    draw_ir_v3_transform_append,
    draw_ir_v3_clip_append,
    draw_ir_v3_paint_append,
    draw_ir_v3_hit_shape_append
}
use common.ui.draw_ir_v3_group_resolve.{draw_ir_v3_group_resolve, draw_ir_v3_port_surface_state_empty}
use common.ui.ui_scene_event_route.{ui_scene_route_event}
use common.ui.ui_scene_counts.{
    UiSceneCounts,
    UiSceneRanges,
    UiSceneOverflowReceipt,
    UI_PRODUCER_GUI,
    UI_SCENE_TABLE_COMMANDS,
    UI_SCENE_OVERFLOW_SURPLUS,
    ui_scene_counts_zero,
    ui_scene_scan
}
use common.ui.ui_scene_owner_table.{UiOwnerRecord}
use common.ui.ui_scene_slice.{
    UiSceneSlice,
    UiSceneWriteVerdict,
    UiSceneEmitResult,
    DrawIrV3Writer,
    UiOwnerWriter,
    UiActionWriter,
    UiPackedProducer
}
use nogc_sync_mut.ui.draw_ir_v3_native_writer.{
    UiSceneNativeWriter,
    UiSceneNativeOwnerWriter,
    UiSceneNativeActionWriter
}
use common.ui.ui_gui_packed_producer.{GuiPackedProducer}

# GUI corpus: a real widget tree (`common.ui.builder` + `widget_draw_ir.spl`,
# the production widget-to-DrawIR projector), two colored panels plus one
# button so the corpus has at least one interactive widget (the panels alone
# have none -- verified: `widget_draw_ir.spl` never sets `hit_rect` for a
# plain rect).
fn _l6_corpus_root() -> WidgetNode:
    val panel_a = with_background(with_height(with_width(column("l6-panel-a", []), 60), 24), "#3366CC")
    val panel_b = with_background(with_height(with_width(column("l6-panel-b", []), 50), 24), "#CC3333")
    val go_button = with_height(with_width(button("l6-go-button", "Go", "go-action"), 40), 16)
    with_background(column("l6-root", [panel_a, panel_b, go_button]), "#202020")

fn _l6_zero_counts() -> UiSceneCounts:
    UiSceneCounts(
        commands: 0u32, geometry: 0u32, paint: 0u32, text_runs: 0u32, glyphs: 0u32,
        resources: 0u32, path_spans: 0u32, path_points: 0u32, clips: 0u32, transforms: 0u32,
        hit_shapes: 0u32, provenance_edges: 0u32, owner_records: 0u32, action_bindings: 0u32,
        prepared_batches: 0u32, dirty_ranges: 0u32
    )

# Minimal stub child producer (design section 2.2 nesting rule: "count-in-
# count, emit-in-ranges", proven with a stub). `extra` lets one test make it
# misbehave (write past its own reported count) to prove the writer refuses
# rather than silently overrunning into a neighboring producer's rows.
class L6StubChildProducer:
    id_val: u32
    rows: u32
    extra: u32

impl UiPackedProducer for L6StubChildProducer:
    me producer_kind() -> u16:
        UI_PRODUCER_GUI
    me producer_id() -> u32:
        self.id_val
    me count(snapshot_id: u64, counts: UiSceneCounts) -> UiSceneCounts:
        var c = _l6_zero_counts()
        c.commands = self.rows
        c
    me emit(
        snapshot_id: u64, ranges: UiSceneRanges,
        draw: DrawIrV3Writer, owners: UiOwnerWriter, actions: UiActionWriter
    ) -> UiSceneEmitResult:
        val to_write = self.rows + self.extra
        var written = 0u32
        while written < to_write:
            draw.put_command(draw_ir_v3_empty_command())
            written = written + 1u32
        match draw.finish():
            UiSceneWriteVerdict.Exact:
                UiSceneEmitResult.Emitted(UiSceneSlice(
                    scene_slot: self.id_val, scene_generation: 1u32,
                    root_component_id: DRAW_IR_V3_NO_ID, ranges: ranges
                ))
            UiSceneWriteVerdict.Deficit(table_id, n):
                UiSceneEmitResult.Refused(UiSceneOverflowReceipt(
                    table_id: table_id, kind: UI_SCENE_OVERFLOW_SURPLUS, required: n, capacity: 0u32,
                    producer_kind: self.producer_kind(), producer_id: self.id_val, snapshot_id: snapshot_id
                ))
            UiSceneWriteVerdict.Surplus(table_id, n):
                UiSceneEmitResult.Refused(UiSceneOverflowReceipt(
                    table_id: table_id, kind: UI_SCENE_OVERFLOW_SURPLUS, required: n, capacity: 0u32,
                    producer_kind: self.producer_kind(), producer_id: self.id_val, snapshot_id: snapshot_id
                ))

describe "GuiPackedProducer count/emit exactness (design section 2.2, lane L6)":
    """The GUI widget-tree/Panel2D path adopts the UiPackedProducer contract:
    count() reports exact rows for a real widget-tree scene, emit() writes
    exactly that many into externally-owned writers, and finish() reaches
    Exact -- never Deficit/Surplus -- on a non-trivial corpus."""

    it "reports and emits exactly the reserved rows for a real widget-tree scene":
        # @req: REQ-LIB-COMMON-001
        step("A corpus with two panels and one button")
        val producer = GuiPackedProducer(id_val: 1u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val counts = producer.count(1u64, ui_scene_counts_zero())
        expect(counts.commands).to_be_greater_than(0u32)
        expect(counts.geometry).to_be_greater_than(0u32)
        expect(counts.paint).to_be_greater_than(0u32)
        expect(counts.hit_shapes).to_equal(1u32)
        expect(counts.owner_records).to_equal(1u32)

        val ranges = ui_scene_scan([counts])[0]
        var draw = UiSceneNativeWriter.new(ranges)
        var owners = UiSceneNativeOwnerWriter.new(ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(ranges.action_bindings)
        val result = producer.emit(1u64, ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                expect(slice.scene_slot).to_equal(1u32)
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)
        print "l6_gui_producer_exactness commands={counts.commands} hit_shapes={counts.hit_shapes} owners={counts.owner_records}"

    it "reports the same counts twice for the same unchanged tree (count is repeatable)":
        step("Verify: reports the same counts twice for the same unchanged tree (count is repeatable)")
        val producer = GuiPackedProducer(id_val: 2u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val first = producer.count(5u64, ui_scene_counts_zero())
        val second = producer.count(5u64, ui_scene_counts_zero())
        expect(first.commands).to_equal(second.commands)
        expect(first.hit_shapes).to_equal(second.hit_shapes)
        expect(first.owner_records).to_equal(second.owner_records)

describe "GuiPackedProducer owner records (design section 2.4, gate b)":
    """Every HIT_SHAPES row this producer emits gets exactly one
    OWNER_RECORDS row, tagged `producer_kind==GUI`, correlated by
    `component_id == semantic_id`. `semantic_generation` is 0u32, matching
    draw_ir_v2_to_v3's adapter (which sets `component_generation: 0u32`
    unconditionally on every command it emits) -- ui_scene_event_route.spl's
    recycled-slot check compares these two fields for EQUALITY, so the owner
    must mirror whatever generation the cross-referenced command actually
    carries, not an arbitrary nonzero constant."""

    it "emits one owner record per hit-shape row, tagged GUI with the oracle's generation":
        step("Verify: emits one owner record per hit-shape row, tagged GUI with the oracle's generation")
        val producer = GuiPackedProducer(id_val: 3u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val counts = producer.count(1u64, ui_scene_counts_zero())
        val ranges = ui_scene_scan([counts])[0]
        var draw = UiSceneNativeWriter.new(ranges)
        var owners = UiSceneNativeOwnerWriter.new(ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(ranges.action_bindings)
        val result = producer.emit(1u64, ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                expect(slice.scene_slot).to_equal(3u32)
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

        val hit_shapes = draw.hit_shapes_snapshot()
        val records = owners.records_snapshot()
        expect(hit_shapes.len()).to_equal(records.len())
        expect(records.len()).to_be_greater_than(0)
        var i = 0
        while i < records.len():
            val rec = records[i]
            expect(rec.producer_kind).to_equal(UI_PRODUCER_GUI)
            expect(rec.semantic_generation).to_equal(0u32)
            expect(hit_shapes[i].component_id).to_equal(rec.semantic_id)
            i = i + 1
        print "l6_gui_producer_owners hit_shapes={hit_shapes.len()} owners={records.len()}"

describe "GuiPackedProducer host_owner_id reparenting (cross-producer owner-chain wiring)":
    """When this producer is nested inside a host (e.g. a WM window), the
    host passes its own OWNER_RECORDS absolute index as `host_owner_id`,
    and every owner record this producer emits -- currently all flat/root
    within its own scope -- gets re-parented onto it, closing the
    cross-producer chain ui_scene_event_route.spl's own routing walks."""

    it "leaves parent_owner_id as NO_ID when host_owner_id is NO_ID (standalone, non-nested render)":
        step("Verify: leaves parent_owner_id as NO_ID when host_owner_id is NO_ID (standalone, non-nested render)")
        val producer = GuiPackedProducer(id_val: 7u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val counts = producer.count(1u64, ui_scene_counts_zero())
        val ranges = ui_scene_scan([counts])[0]
        var draw = UiSceneNativeWriter.new(ranges)
        var owners = UiSceneNativeOwnerWriter.new(ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(ranges.action_bindings)
        val result = producer.emit(1u64, ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                val records = owners.records_snapshot()
                expect(records.len()).to_be_greater_than(0)
                var i = 0
                while i < records.len():
                    expect(records[i].parent_owner_id).to_equal(DRAW_IR_V3_NO_ID)
                    i = i + 1
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

    it "re-parents every owner record onto host_owner_id when nested":
        step("Verify: re-parents every owner record onto host_owner_id when nested")
        val host_owner_id = 99u32
        val producer = GuiPackedProducer(id_val: 8u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: host_owner_id)
        val counts = producer.count(1u64, ui_scene_counts_zero())
        val ranges = ui_scene_scan([counts])[0]
        var draw = UiSceneNativeWriter.new(ranges)
        var owners = UiSceneNativeOwnerWriter.new(ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(ranges.action_bindings)
        val result = producer.emit(1u64, ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                val records = owners.records_snapshot()
                expect(records.len()).to_be_greater_than(0)
                var i = 0
                while i < records.len():
                    expect(records[i].parent_owner_id).to_equal(host_owner_id)
                    i = i + 1
                print "l6_gui_producer_host_owner_id owners={records.len()} parent={host_owner_id}"
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

describe "GuiPackedProducer nested-child containment (design section 2.2 nesting rule)":
    """count-in-count, emit-in-ranges: a host's counts and a nested stub
    child's counts scan into disjoint, contiguous sub-ranges, and a writer
    bound to the child's carved range refuses a row that would spill past
    it -- rows land inside the parent-assigned sub-range and nowhere
    else (gate c)."""

    it "carves disjoint, contiguous sub-ranges for host and child and the child writes only inside its own":
        step("Verify: carves disjoint, contiguous sub-ranges for host and child and the child writes only inside its own")
        var host_counts = _l6_zero_counts()
        host_counts.commands = 3u32
        host_counts.hit_shapes = 1u32
        host_counts.owner_records = 1u32
        val child = L6StubChildProducer(id_val: 9u32, rows: 2u32, extra: 0u32)
        val child_counts = child.count(1u64, ui_scene_counts_zero())

        val scanned = ui_scene_scan([host_counts, child_counts])
        val host_ranges = scanned[0]
        val child_ranges = scanned[1]
        expect(child_ranges.commands.start).to_equal(host_ranges.commands.start + host_ranges.commands.count)
        expect(child_ranges.hit_shapes.start).to_equal(host_ranges.hit_shapes.start + host_ranges.hit_shapes.count)

        var draw = UiSceneNativeWriter.new(child_ranges)
        var owners = UiSceneNativeOwnerWriter.new(child_ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(child_ranges.action_bindings)
        val result = child.emit(1u64, child_ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                expect(draw.commands_snapshot().len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)
        print "l6_gui_producer_nesting host_commands=[{host_ranges.commands.start},{host_ranges.commands.count}) child_commands=[{child_ranges.commands.start},{child_ranges.commands.count})"

    it "refuses (drops) a write attempted past a range carved for fewer rows":
        step("Verify: refuses (drops) a write attempted past a range carved for fewer rows")
        var host_counts = _l6_zero_counts()
        host_counts.commands = 3u32
        # Child's range is carved for 2 rows; a 3rd write attempt must be
        # rejected at the writer boundary -- it must not land anywhere,
        # including inside the host's neighboring range.
        var declared_child_counts = _l6_zero_counts()
        declared_child_counts.commands = 2u32

        val scanned = ui_scene_scan([host_counts, declared_child_counts])
        val child_ranges = scanned[1]
        var draw = UiSceneNativeWriter.new(child_ranges)
        val ok1 = draw.put_command(draw_ir_v3_empty_command())
        val ok2 = draw.put_command(draw_ir_v3_empty_command())
        val ok3 = draw.put_command(draw_ir_v3_empty_command())
        expect(ok1).to_equal(true)
        expect(ok2).to_equal(true)
        expect(ok3).to_equal(false)
        expect(draw.commands_snapshot().len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        print "l6_gui_producer_nesting_overflow declared=2 third_write_accepted={ok3} rows_landed={draw.commands_snapshot().len()}"

describe "GuiPackedProducer id rebasing under a non-zero assigned range (multi-producer composition)":
    """Ids embedded in emitted commands (geometry_id, paint_id, ...) are read
    back as ABSOLUTE indices into the assembled arena's combined per-table
    array (draw_ir_v3_group_resolve.spl's own accessor convention, and the
    landed `ranges.<table>.start + cursor()` pattern in
    draw_ir_v3_emit_full.spl). When this producer is scanned alongside
    another producer with non-zero counts, its assigned `ranges.geometry`/
    `ranges.paint` no longer start at 0 -- every id it copies from the v2
    oracle's locally-numbered scene must be rebased by that start, or a
    downstream reader indexing the combined arena lands on the wrong row."""

    it "keeps geometry_id/paint_id arena-absolute when scanned after a producer with non-zero counts":
        step("Verify: keeps geometry_id/paint_id arena-absolute when scanned after a producer with non-zero counts")
        var dummy_counts = _l6_zero_counts()
        dummy_counts.commands = 2u32
        dummy_counts.geometry = 2u32
        dummy_counts.paint = 2u32
        dummy_counts.text_runs = 1u32
        dummy_counts.glyphs = 3u32
        dummy_counts.resources = 1u32
        dummy_counts.path_spans = 1u32
        dummy_counts.path_points = 2u32
        dummy_counts.clips = 1u32
        dummy_counts.transforms = 1u32
        dummy_counts.hit_shapes = 1u32

        val producer = GuiPackedProducer(id_val: 6u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val gui_counts = producer.count(1u64, ui_scene_counts_zero())

        val scanned = ui_scene_scan([dummy_counts, gui_counts])
        val gui_ranges = scanned[1]
        assert_true(gui_ranges.geometry.start > 0u32)
        assert_true(gui_ranges.paint.start > 0u32)

        var draw = UiSceneNativeWriter.new(gui_ranges)
        var owners = UiSceneNativeOwnerWriter.new(gui_ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(gui_ranges.action_bindings)
        val result = producer.emit(1u64, gui_ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                expect(slice.scene_slot).to_equal(6u32)
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

        val commands = draw.commands_snapshot()
        var checked_geometry = 0
        var checked_paint = 0
        var i = 0
        while i < commands.len():
            if commands[i].geometry_id != DRAW_IR_V3_NO_ID:
                assert_true(commands[i].geometry_id >= gui_ranges.geometry.start)
                checked_geometry = checked_geometry + 1
            if commands[i].paint_id != DRAW_IR_V3_NO_ID:
                assert_true(commands[i].paint_id >= gui_ranges.paint.start)
                checked_paint = checked_paint + 1
            i = i + 1
        assert_true(checked_geometry > 0)
        assert_true(checked_paint > 0)
        print "l6_gui_producer_id_rebasing geometry_start={gui_ranges.geometry.start} paint_start={gui_ranges.paint.start} checked_geometry={checked_geometry} checked_paint={checked_paint}"

describe "GuiPackedProducer parity with the v2 oracle (design section 9, gate d)":
    """The producer adopts the EXISTING renderer (`widget_tree_to_draw_ir_cpu`
    + the landed v2->v3 adapter) rather than re-deriving layout/paint, so its
    emitted COMMANDS/GEOMETRY/PAINT rows must match that oracle's output
    command-for-command, row-for-row on a non-trivial corpus."""

    it "matches widget_tree_to_draw_ir_cpu + draw_ir_v2_to_v3 on commands, geometry and paint":
        step("Verify: matches widget_tree_to_draw_ir_cpu + draw_ir_v2_to_v3 on commands, geometry and paint")
        val root = _l6_corpus_root()
        val oracle_v3 = draw_ir_v2_to_v3(widget_tree_to_draw_ir_cpu(root, 200, 150))

        val producer = GuiPackedProducer(id_val: 4u32, root: root, width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val counts = producer.count(1u64, ui_scene_counts_zero())
        val ranges = ui_scene_scan([counts])[0]
        var draw = UiSceneNativeWriter.new(ranges)
        var owners = UiSceneNativeOwnerWriter.new(ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(ranges.action_bindings)
        val result = producer.emit(1u64, ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                expect(slice.scene_slot).to_equal(4u32)
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

        val produced_commands = draw.commands_snapshot()
        expect(produced_commands.len()).to_equal(oracle_v3.commands.len())

        val produced_geometry = draw.geometry_snapshot()
        expect(produced_geometry.len()).to_equal(oracle_v3.geometry.xs.len())
        var i = 0
        while i < produced_geometry.len():
            expect(produced_geometry[i].x).to_equal(oracle_v3.geometry.xs[i])
            expect(produced_geometry[i].y).to_equal(oracle_v3.geometry.ys[i])
            expect(produced_geometry[i].width).to_equal(oracle_v3.geometry.widths[i])
            expect(produced_geometry[i].height).to_equal(oracle_v3.geometry.heights[i])
            i = i + 1

        val produced_paint = draw.paint_snapshot()
        expect(produced_paint.len()).to_equal(oracle_v3.paint.fill_colors.len())
        i = 0
        while i < produced_paint.len():
            expect(produced_paint[i].fill_color).to_equal(oracle_v3.paint.fill_colors[i])
            i = i + 1
        print "l6_gui_producer_parity commands={produced_commands.len()} geometry={produced_geometry.len()} paint={produced_paint.len()}"

describe "GuiPackedProducer interactive-widget hit shapes are reachable via L9 routing":
    """Previously each interactive widget's synthetic hit_shape/owner was
    appended with no command cross-referencing it, so
    draw_ir_v3_group_resolve_hit_test (which only considers commands whose
    OWN hit_shape_id is set) could never find it -- GUI's interactive
    widgets were unreachable through ui_scene_event_route.spl entirely, not
    just unflagged. Now the widget's real drawing command is looked up
    (draw_ir_v2_to_v3_command_ids_for) and cross-referenced, so a real
    click actually routes to the owner record."""

    it "routes a click on the button's own rect through to its owner record":
        step("Verify: routes a click on the button's own rect through to its owner record")
        val producer = GuiPackedProducer(id_val: 10u32, root: _l6_corpus_root(), width: 200, height: 150, host_owner_id: DRAW_IR_V3_NO_ID)
        val counts = producer.count(1u64, ui_scene_counts_zero())
        val ranges = ui_scene_scan([counts])[0]
        var draw = UiSceneNativeWriter.new(ranges)
        var owners = UiSceneNativeOwnerWriter.new(ranges.owner_records)
        var actions = UiSceneNativeActionWriter.new(ranges.action_bindings)
        val result = producer.emit(1u64, ranges, draw, owners, actions)
        match result:
            UiSceneEmitResult.Emitted(slice):
                expect(slice.scene_slot).to_equal(10u32)
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

        val commands = draw.commands_snapshot()
        var cross_referenced = 0
        var i = 0
        while i < commands.len():
            if commands[i].hit_shape_id != DRAW_IR_V3_NO_ID:
                cross_referenced = cross_referenced + 1
            i = i + 1
        assert_true(cross_referenced > 0)

        val hit_shapes = draw.hit_shapes_snapshot()
        expect(hit_shapes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val target = hit_shapes[0]

        var combined = draw_ir_v3_empty_scene(1u32, 1u32)
        for cmd in commands:
            combined = draw_ir_v3_scene_push_command(combined, cmd)
        for t in draw.transforms_snapshot():
            combined.transforms = draw_ir_v3_transform_append(combined.transforms, t.m11, t.m12, t.m21, t.m22, t.dx, t.dy)
        for c in draw.clips_snapshot():
            combined.clips = draw_ir_v3_clip_append(combined.clips, c.x, c.y, c.width, c.height, c.corner_radius, c.parent_id)
        for p in draw.paint_snapshot():
            combined.paint = draw_ir_v3_paint_append(combined.paint, p.fill_color, p.stroke_color, p.stroke_width_milli, p.opacity_milli, p.blend_mode)
        for h in draw.hit_shapes_snapshot():
            combined.hit_shapes = draw_ir_v3_hit_shape_append(combined.hit_shapes, h.x, h.y, h.width, h.height, h.shape_kind, h.hit_flags, h.component_id)

        val resolved = draw_ir_v3_group_resolve(combined, draw_ir_v3_port_surface_state_empty())
        expect(resolved.ok).to_equal(true)

        val owner_records = owners.records_snapshot()
        val receipt = ui_scene_route_event(combined, resolved, owner_records, target.x, target.y)
        expect(receipt.accepted).to_equal(true)
        expect(receipt.owner_chain.len()).to_be_greater_than(0)
        print "l6_gui_producer_reachable px={target.x} py={target.y} accepted={receipt.accepted} chain_len={receipt.owner_chain.len()}"
