# @cover src/lib/common/ui/draw_ir_patch.spl 80%
# @tag: unit, ui, draw_ir, patch
"""
# Draw IR incremental patch generation

## Overview

Backends normally re-receive a whole `DrawIrComposition` every frame and
diff it themselves. This spec covers the incremental patch companion
(`common.ui.draw_ir_patch`): computing a compact list of per-component
operations (Insert / Remove / UpdateGeometry / UpdateText / UpdateStyle /
Reorder) between two composition revisions, and applying that patch back
onto the baseline to reproduce the target across the patch-covered command
fields, including shaped glyph payloads — so a renderer can repaint only the
changed regions instead of the whole frame.

## Examples

A new sibling component emits an Insert op carrying only `new_bounds`;
removing one emits a Remove op carrying only `old_bounds`. A pure
position/size change emits UpdateGeometry; a text-only or style-only
change emits its own narrow op instead of a blanket replace. A component
that keeps its content but moves emits Reorder — unless content ALSO
changed at the new position, in which case the content-change op wins and
Reorder is suppressed. The round-trip contract holds on every case,
including a ~30-command mixed composition exercising every op kind at
once: `apply(old, patch_between(old, new))` equals `new` across every
patch-covered field.
"""

use std.spec
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    draw_edge,
    DrawIrCommand,
    draw_ir_batch,
    draw_ir_box_with_style,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_edge_command,
    draw_ir_glyph_run_payload,
    draw_ir_image_command,
    draw_ir_no_rect,
    draw_ir_path_command,
    draw_ir_point,
    draw_ir_rect,
    draw_ir_style_prop,
    draw_ir_text,
    draw_ir_text_resolved_font,
    draw_ir_text_shaped_font
}
use common.ui.draw_ir_patch.{
    DRAW_IR_PATCH_OP_INSERT,
    DRAW_IR_PATCH_OP_REMOVE,
    DRAW_IR_PATCH_OP_REORDER,
    DRAW_IR_PATCH_OP_UPDATE_GEOMETRY,
    DRAW_IR_PATCH_OP_UPDATE_STYLE,
    DRAW_IR_PATCH_OP_UPDATE_TEXT,
    DrawIrPatchOp,
    draw_ir_patch_apply,
    draw_ir_patch_between,
    draw_ir_patch_commands_equal
}

fn _embedding():
    draw_ir_embedding_config("surface", "root", 0, 0, 400, 160, 0, 1000, false)

fn _op_kind_present(ops: [DrawIrPatchOp], kind: i32, component_id: text) -> bool:
    for op in ops:
        if op.kind == kind and op.component_id == component_id:
            return true
    false

fn _op_kind_count(ops: [DrawIrPatchOp], kind: i32, component_id: text) -> i32:
    var count = 0
    for op in ops:
        if op.kind == kind and op.component_id == component_id:
            count = count + 1
    count

describe "Draw IR patch generation":

    it "patches an image URI change and damages its existing bounds":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_image_command("content", 10, 20, 30, 40,
                    "wm-content://window/old", [])
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_image_command("content", 10, 20, 30, 40,
                    "wm-content://window/new", [])
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(
            patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "content"
        )).to_equal(true)
        expect(patch.damage_rects.len()).to_equal(2)
        expect(patch.damage_rects[0].x).to_equal(10)
        expect(patch.damage_rects[0].width).to_equal(30)
        val applied = draw_ir_patch_apply(baseline, patch)
        expect(applied.ok).to_equal(true)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)

    it "patches resolved text advance changes at the same geometry":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_text_resolved_font("text", 10, 20, "ab", 1u32,
                    "sans", "font", [5, 15], 20, 12, 12)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_text_resolved_font("text", 10, 20, "ab", 1u32,
                    "sans", "font", [7, 13], 20, 12, 12)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(
            patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "text"
        )).to_equal(true)
        val applied = draw_ir_patch_apply(baseline, patch)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)

    it "uses point bounds for changed path and edge damage":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_path_command("path", [draw_ir_point(10, 20),
                    draw_ir_point(30, 40)], []),
                draw_ir_edge_command(draw_edge("edge", "a", "b", "straight",
                    [draw_ir_point(50, 60), draw_ir_point(70, 80)], []))
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_path_command("path", [draw_ir_point(11, 20),
                    draw_ir_point(31, 40)], []),
                draw_ir_edge_command(draw_edge("edge", "a", "b", "straight",
                    [draw_ir_point(51, 60), draw_ir_point(71, 80)], []))
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(
            patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "path"
        )).to_equal(true)
        expect(_op_kind_present(
            patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "edge"
        )).to_equal(true)
        expect(patch.damage_rects[0].width).to_be_greater_than(0)
        expect(patch.damage_rects[0].height).to_be_greater_than(0)
        val applied = draw_ir_patch_apply(baseline, patch)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)

    it "uses edge payload points even when the mirrored command points are stale":
        val old_edge = draw_ir_edge_command(draw_edge(
            "edge", "a", "b", "straight",
            [draw_ir_point(10, 10), draw_ir_point(20, 20)], []))
        var new_edge = old_edge
        new_edge.edge = Some(draw_edge(
            "edge", "a", "b", "straight",
            [draw_ir_point(100, 110), draw_ir_point(120, 130)], []))
        # Leave new_edge.points at the old values to model an independently
        # decoded/stale mirror; retained damage must still cover the payload
        # the edge rasterizer actually consumes.
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [old_edge])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [new_edge])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(patch.damage_rects.len()).to_equal(2)
        expect(patch.damage_rects[1].x).to_equal(99)
        expect(patch.damage_rects[1].y).to_equal(109)
        expect(patch.damage_rects[1].width).to_equal(23)
        expect(patch.damage_rects[1].height).to_equal(23)

    it "uses stroke payloads despite stale nonzero geometry and ordered styles":
        val old_path = draw_ir_path_command("path", [draw_ir_point(10, 10),
            draw_ir_point(20, 20)], [draw_ir_style_prop("stroke-color", "1")])
        var new_path = old_path
        new_path.points = [draw_ir_point(100, 100), draw_ir_point(120, 120)]
        new_path.x = 1
        new_path.y = 2
        new_path.width = 3
        new_path.height = 4
        new_path.computed_style = [
            draw_ir_style_prop("stroke-color", "1"),
            draw_ir_style_prop("stroke-color", "2")
        ]
        var old_with_duplicate = old_path
        old_with_duplicate.computed_style = [
            draw_ir_style_prop("stroke-color", "1"),
            draw_ir_style_prop("stroke-color", "1")
        ]
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [old_with_duplicate])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [new_path])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(
            patch.operations, DRAW_IR_PATCH_OP_UPDATE_GEOMETRY, "path"
        )).to_equal(true)
        expect(patch.damage_rects[1].x).to_equal(99)
        expect(patch.damage_rects[1].y).to_equal(99)
        val applied = draw_ir_patch_apply(baseline, patch)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)

    it "emits an Insert op for a new component with new_bounds set and no old_bounds":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32),
                draw_ir_rect("fresh", 1, 2, 5, 6, 9u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_INSERT, "fresh")).to_equal(true)
        for op in patch.operations:
            if op.component_id == "fresh":
                expect(op.old_bounds.present).to_equal(false)
                expect(op.new_bounds.present).to_equal(true)
                expect(op.new_bounds.x).to_equal(1)
                expect(op.new_bounds.y).to_equal(2)

    it "emits a Remove op for a dropped component with old_bounds set and no new_bounds":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32),
                draw_ir_rect("gone", 90, 91, 10, 11, 3u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_REMOVE, "gone")).to_equal(true)
        for op in patch.operations:
            if op.component_id == "gone":
                expect(op.old_bounds.present).to_equal(true)
                expect(op.old_bounds.x).to_equal(90)
                expect(op.new_bounds.present).to_equal(false)

    it "emits an UpdateGeometry op when x/y/width/height change":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 30, 40, 55, 25, 1u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_UPDATE_GEOMETRY, "box")).to_equal(true)
        for op in patch.operations:
            if op.kind == DRAW_IR_PATCH_OP_UPDATE_GEOMETRY:
                expect(op.old_bounds.x).to_equal(10)
                expect(op.new_bounds.x).to_equal(30)

    it "emits an UpdateText op when text_value changes":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_text("label", 5, 5, "Old", 2u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_text("label", 5, 5, "New", 2u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_UPDATE_TEXT, "label")).to_equal(true)

    it "emits an UpdateStyle op when computed_style changes":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_box_with_style("box", 10, 10, 50, 20, 1u32, draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), [draw_ir_style_prop("fill", "blue")])
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_box_with_style("box", 10, 10, 50, 20, 1u32, draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), [draw_ir_style_prop("fill", "red")])
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "box")).to_equal(true)

    it "emits a Reorder op only when content is identical but position moved":
        val baseline = draw_ir_composition("rev-a", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("first", 0, 0, 10, 10, 1u32),
                draw_ir_rect("second", 20, 0, 10, 10, 2u32)
            ])
        ])
        val current = draw_ir_composition("rev-b", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("second", 20, 0, 10, 10, 2u32),
                draw_ir_rect("first", 0, 0, 10, 10, 1u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-a", current, "rev-b")
        var reorder_count = 0
        for op in patch.operations:
            if op.kind == DRAW_IR_PATCH_OP_REORDER:
                reorder_count = reorder_count + 1
                expect(op.old_bounds.x).to_equal(op.new_bounds.x)
        expect(reorder_count).to_equal(2)

    it "does not emit Reorder when content also changed at a moved position":
        val baseline = draw_ir_composition("rev-a", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("first", 0, 0, 10, 10, 1u32),
                draw_ir_rect("second", 20, 0, 10, 10, 2u32)
            ])
        ])
        val current = draw_ir_composition("rev-b", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("second", 20, 0, 10, 10, 2u32),
                draw_ir_rect("first", 99, 0, 10, 10, 1u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-a", current, "rev-b")
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_UPDATE_GEOMETRY, "first")).to_equal(true)
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_REORDER, "first")).to_equal(false)

    it "covers damage_rects with the changed bounds":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 30, 40, 55, 25, 1u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        var found_old = false
        var found_new = false
        for rect in patch.damage_rects:
            if rect.x == 10 and rect.y == 10:
                found_old = true
            if rect.x == 30 and rect.y == 40:
                found_new = true
        expect(found_old).to_equal(true)
        expect(found_new).to_equal(true)

    it "round-trips: apply(old, patch_between(old,new)) equals new command-by-command":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32),
                draw_ir_text("label", 5, 5, "Old", 2u32),
                draw_ir_rect("gone", 90, 90, 10, 10, 3u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 20, 30, 60, 25, 1u32),
                draw_ir_text("label", 5, 5, "New", 2u32),
                draw_ir_rect("fresh", 1, 1, 5, 5, 9u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        val applied = draw_ir_patch_apply(baseline, patch)
        expect(applied.ok).to_equal(true)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)
        expect(applied.composition.composition_id).to_equal("rev-2")

    it "detects and round-trips a color-only in-place change with no geometry/style/text delta":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 9u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        expect(patch.operations.len() > 0).to_equal(true)
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "box")).to_equal(true)
        expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_REORDER, "box")).to_equal(false)
        val applied = draw_ir_patch_apply(baseline, patch)
        expect(applied.ok).to_equal(true)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)
        expect(applied.composition.batches[0].commands[0].color).to_equal(9u32)

    it "compares every glyph_run member and suppresses reorder for moved glyph changes":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_text_shaped_font("label", 5, 5, "AB", 2u32, "mono", "face", [8, 8], 16, 12, 12,
                    draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [0, 0], [0, 1], true)),
                draw_ir_rect("peer", 40, 5, 8, 8, 3u32)
            ])
        ])
        val changed_payloads = [
            draw_ir_glyph_run_payload([9u32, 2u32], [0, 8], [0, 0], [0, 1], true),
            draw_ir_glyph_run_payload([1u32, 2u32], [1, 8], [0, 0], [0, 1], true),
            draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [1, 0], [0, 1], true),
            draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [0, 0], [1, 1], true),
            draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [0, 0], [0, 1], false),
            draw_ir_glyph_run_payload([1u32, 2u32], [0], [0, 0], [0, 1], true)
        ]
        for changed_payload in changed_payloads:
            val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
                draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                    draw_ir_text_shaped_font("label", 5, 5, "AB", 2u32, "mono", "face", [8, 8], 16, 12, 12, changed_payload),
                    draw_ir_rect("peer", 40, 5, 8, 8, 3u32)
                ])
            ])
            val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
            expect(patch.operations.len()).to_equal(1)
            expect(_op_kind_count(patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "label")).to_equal(1)
            expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_REORDER, "label")).to_equal(false)
            expect(patch.damage_rects.len()).to_equal(2)
            expect(draw_ir_patch_commands_equal(baseline, current)).to_equal(false)
            val applied = draw_ir_patch_apply(baseline, patch)
            expect(applied.ok).to_equal(true)
            expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)

        val moved = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("peer", 40, 5, 8, 8, 3u32),
                draw_ir_text_shaped_font("label", 6, 5, "AB", 2u32, "mono", "face", [8, 8], 16, 12, 12,
                    draw_ir_glyph_run_payload([9u32, 2u32], [0, 8], [0, 0], [0, 1], true))
            ])
        ])
        val moved_patch = draw_ir_patch_between(baseline, "rev-1", moved, "rev-2")
        expect(_op_kind_count(moved_patch.operations, DRAW_IR_PATCH_OP_UPDATE_GEOMETRY, "label")).to_equal(1)
        expect(_op_kind_count(moved_patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "label")).to_equal(1)
        expect(_op_kind_present(moved_patch.operations, DRAW_IR_PATCH_OP_REORDER, "label")).to_equal(false)
        expect(_op_kind_count(moved_patch.operations, DRAW_IR_PATCH_OP_REORDER, "peer")).to_equal(1)
        val moved_applied = draw_ir_patch_apply(baseline, moved_patch)
        expect(moved_applied.ok).to_equal(true)
        expect(draw_ir_patch_commands_equal(moved_applied.composition, moved)).to_equal(true)

    it "rejects apply when the composition revision does not match base_revision":
        val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 30, 40, 55, 25, 1u32)
            ])
        ])
        val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
        val stale = draw_ir_composition("rev-STALE", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
                draw_ir_rect("box", 10, 10, 50, 20, 1u32)
            ])
        ])
        val rejected = draw_ir_patch_apply(stale, patch)
        expect(rejected.ok).to_equal(false)
        expect(rejected.reason != "").to_equal(true)
        expect(rejected.composition.composition_id).to_equal("rev-STALE")

    it "round-trips a mixed ~30-command composition (insert/remove/geometry/text/style/reorder/unchanged)":
        var baseline_cmds: [DrawIrCommand] = []
        var current_cmds: [DrawIrCommand] = []

        # c0..c4: geometry changes
        var i = 0
        while i < 5:
            val id = "geo{i}"
            baseline_cmds.push(draw_ir_rect(id, i * 10, i * 10, 20, 20, 1u32))
            current_cmds.push(draw_ir_rect(id, i * 10 + 100, i * 10 + 100, 20, 20, 1u32))
            i = i + 1

        # c5..c9: text changes
        i = 0
        while i < 5:
            val id = "text{i}"
            baseline_cmds.push(draw_ir_text(id, i, i, "old{i}", 2u32))
            current_cmds.push(draw_ir_text(id, i, i, "new{i}", 2u32))
            i = i + 1

        # c10..c14: style changes
        i = 0
        while i < 5:
            val id = "style{i}"
            baseline_cmds.push(draw_ir_box_with_style(id, i, i, 10, 10, 1u32, draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), [draw_ir_style_prop("fill", "blue")]))
            current_cmds.push(draw_ir_box_with_style(id, i, i, 10, 10, 1u32, draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), [draw_ir_style_prop("fill", "red")]))
            i = i + 1

        # c15..c21: unchanged
        i = 0
        while i < 7:
            val id = "same{i}"
            val cmd = draw_ir_rect(id, i * 3, i * 3, 15, 15, 4u32)
            baseline_cmds.push(cmd)
            current_cmds.push(cmd)
            i = i + 1

        # r0, r1: removed (baseline only)
        baseline_cmds.push(draw_ir_rect("gone0", 200, 200, 5, 5, 5u32))
        baseline_cmds.push(draw_ir_rect("gone1", 201, 201, 5, 5, 5u32))

        # reordered pair: swap "reorder0" and "reorder1"
        baseline_cmds.push(draw_ir_rect("reorder0", 300, 300, 5, 5, 6u32))
        baseline_cmds.push(draw_ir_rect("reorder1", 310, 310, 5, 5, 7u32))
        current_cmds.push(draw_ir_rect("reorder1", 310, 310, 5, 5, 7u32))
        current_cmds.push(draw_ir_rect("reorder0", 300, 300, 5, 5, 6u32))

        # inserted new items (current only)
        current_cmds.push(draw_ir_rect("new0", 400, 400, 5, 5, 8u32))
        current_cmds.push(draw_ir_rect("new1", 401, 401, 5, 5, 8u32))
        current_cmds.push(draw_ir_rect("new2", 402, 402, 5, 5, 8u32))

        expect(baseline_cmds.len()).to_equal(26)
        expect(current_cmds.len()).to_equal(27)

        val baseline = draw_ir_composition("mix-1", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), baseline_cmds)
        ])
        val current = draw_ir_composition("mix-2", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), current_cmds)
        ])
        val patch = draw_ir_patch_between(baseline, "mix-1", current, "mix-2")
        val applied = draw_ir_patch_apply(baseline, patch)

        expect(applied.ok).to_equal(true)
        expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)
