# Equivalence proof for the window-content hit-dispatch migration
# (doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md,
# decision D1). `_shared_wm_content_dispatch` in window_scene.spl used to pick
# a window (topmost by z_index whose rect contains the point) and then
# hand-test titlebar close/minimize button rects via manual local-coordinate
# arithmetic (`_shared_wm_local_in_button`). It now lifts each visible
# window's body + close/minimize buttons into a one-batch-per-window
# DrawIrComposition (embedding layer = window.z_index) and resolves the
# point through draw_ir_hit_bridge.draw_ir_hit_forest + hit_test.hit_stack --
# the SAME interaction core the taskbar migration and draw_ir_hit_bridge_spec
# already use (see window_scene_taskbar_hit_migration_spec.spl, its worked
# example).
#
# This spec walks the content-dispatch coordinate space (window body, each
# titlebar button, the unwired green button, drag start, close, minimize,
# desktop background, and multi-window z-order) through the ONLY public
# entry point, shared_wm_dispatch_pointer, asserting the exact action
# strings the old rect-test arithmetic produced.

use std.spec
use common.ui.builder.{column, label, build_tree_with_title}
use common.ui.taskbar_model.{TaskbarModel}
use common.ui.window.{WindowManager}
use common.ui.window_surface_registry.{UiWindowSurfaceRegistry, UI_SURFACE_KIND_SIMPLE_WEB}
use common.ui.window_scene.{shared_wm_dispatch_pointer, shared_wm_scene_from_window_manager}

fn _tree(title: text):
    build_tree_with_title(column("{title}_root", [label("{title}_label", title)]), title, "glass_dark")

fn _empty_taskbar() -> TaskbarModel:
    TaskbarModel(pinned: [], running: [], tray: [])

# Single titled window at (10, 40, 300, 200) -- same fixture shape
# window_scene_spec.spl uses for its content-dispatch scenarios. Titlebar
# button geometry (window_scene.spl WM_TITLEBAR_* constants): close button
# local (276, 2, 20x20); red traffic local (12, 9, 10x10); yellow traffic
# (minimize) local (30, 9, 10x10); green traffic local (48, 9, 10x10, no
# action wired). Titlebar height (drag region) is local y < 28.
fn _one_window_scene():
    var manager = WindowManager.new()
    val _one = manager.open_window("surf1", "One", 10, 40, 300, 200, _tree("one"))
    var registry = UiWindowSurfaceRegistry.new()
    registry.bind_with_kind("win1", "surf1", 42u64, "demo.app", "Window One", UI_SURFACE_KIND_SIMPLE_WEB)
    shared_wm_scene_from_window_manager(manager, registry, 800, 600)

describe "SharedWmScene content hit-forest migration equivalence":

    it "focuses the window when the body is clicked below the titlebar":
        val scene = _one_window_scene()
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 200, 150, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("focus_window")
        expect(hit.window_id).to_equal("win1")

    it "begins a drag when the titlebar is clicked away from any button":
        val scene = _one_window_scene()
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 200, 45, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("begin_drag_window")
        expect(hit.window_id).to_equal("win1")

    it "still begins a drag on the unwired green traffic-light button":
        val scene = _one_window_scene()
        # Absolute: local (48, 9) + window origin (10, 40) = (58, 49).
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 58, 49, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("begin_drag_window")

    it "closes the window when the close (X) button is clicked":
        val scene = _one_window_scene()
        # Absolute: local (276, 2) + window origin (10, 40) = (286, 42).
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 286, 42, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("close_window")
        expect(hit.window_id).to_equal("win1")
        expect(hit.scene.windows.len()).to_equal(0)

    it "closes the window when the red traffic-light button is clicked":
        val scene = _one_window_scene()
        # Absolute: local (12, 9) + window origin (10, 40) = (22, 49).
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 22, 49, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("close_window")
        expect(hit.window_id).to_equal("win1")

    it "minimizes the window when the yellow traffic-light button is clicked":
        val scene = _one_window_scene()
        # Absolute: local (30, 9) + window origin (10, 40) = (40, 49).
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 40, 49, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("minimize_window")
        expect(hit.window_id).to_equal("win1")
        expect(hit.scene.windows[0].minimized).to_equal(true)

    it "falls through to desktop_background outside every window and chrome rect":
        val scene = _one_window_scene()
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 780, 300, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("desktop_background")

    it "picks the topmost window by z-order when two windows overlap":
        var manager = WindowManager.new()
        val _one = manager.open_window("surf1", "One", 10, 40, 300, 200, _tree("one"))
        val _two = manager.open_window("surf2", "Two", 80, 120, 300, 200, _tree("two"))
        val registry = UiWindowSurfaceRegistry.new()
        val scene = shared_wm_scene_from_window_manager(manager, registry, 800, 600)
        # (150, 180) lies inside both window rects; "Two" opened later so it
        # has the higher z_index and must win.
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 150, 180, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("focus_window")
        expect(hit.window_id).to_equal("surf2")

    it "falls back to the lower window once the topmost is minimized":
        var manager = WindowManager.new()
        val _one = manager.open_window("surf1", "One", 10, 40, 300, 200, _tree("one"))
        val _two = manager.open_window("surf2", "Two", 80, 120, 300, 200, _tree("two"))
        manager.minimize_window("surf2")
        val registry = UiWindowSurfaceRegistry.new()
        val scene = shared_wm_scene_from_window_manager(manager, registry, 800, 600)
        val hit = shared_wm_dispatch_pointer(scene, _empty_taskbar(), 150, 180, "left", "down", 1000, "09:41", 0)
        expect(hit.action).to_equal("focus_window")
        expect(hit.window_id).to_equal("surf1")
