"""
## Purpose and audience
Purpose: Prove that Theme semantic role hierarchy.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.*
use common.ui.theme_render_snapshot.{ThemeRenderSnapshot, ThemeMaterialSemantics, theme_role_color, theme_role_is_known, validate_theme_fragment}
use nogc_sync_mut.ui.theme_package.{theme_package_render_snapshot, theme_package_fingerprint}

val ALL_ROLES: [text] = [
    "wm.titlebar", "wm.border", "wm.controls",
    "workbench.activity_bar", "workbench.sidebar", "workbench.tab_bar",
    "workbench.editor", "workbench.panel", "workbench.status_bar", "workbench.focus_ring",
    "document.paper", "document.text", "document.selection", "document.cursor", "document.heading",
    "sheet.grid", "sheet.header", "sheet.active_cell", "sheet.error_cell",
    "slide.workspace", "slide.canvas", "slide.placeholder",
    "semantic.info", "semantic.success", "semantic.warning", "semantic.error"
]

describe "Theme semantic role hierarchy":
    it "resolves every documented role to a non-empty color on the default theme":
        step("Verify: resolves every documented role to a non-empty color on the default theme")
        # @req: REQ-LIB-COMMON-001
        val snapshot = theme_package_render_snapshot("")
        for role in ALL_ROLES:
            val resolved = theme_role_color(snapshot, role)
            expect(resolved.role).to_equal(role)
            expect(resolved.hex).to_start_with("#")
            expect(resolved.hex.len()).to_equal(9)  # oracle: 9 — named expected value from the requirement
            expect(resolved.known).to_equal(true)
            expect(theme_role_is_known(role)).to_equal(true)

    it "falls back to the default foreground for an unknown role, flagged not-known":
        step("Verify: falls back to the default foreground for an unknown role, flagged not-known")
        val snapshot = theme_package_render_snapshot("")
        val resolved = theme_role_color(snapshot, "not.a.real.role")
        expect(resolved.known).to_equal(false)
        expect(resolved.rgba).to_equal(snapshot.foreground_rgba)
        expect(theme_role_is_known("not.a.real.role")).to_equal(false)

    it "resolves semantic status roles to the theme's real status colors":
        step("Verify: resolves semantic status roles to the theme's real status colors")
        # Real values sourced from ResolvedThemePackage.ui_theme.colors
        # (config/themes/aetheric_dark/base.css: --ui-info: #9bdcff,
        # --ui-success: #b1b1ff, --ui-warning: #f4bd78, --ui-error: #ffb4ab),
        # NOT the fixed ThemeSemanticColors fallback constants -- those only
        # apply when a snapshot is built without going through
        # theme_package.spl (see the "falls back" test below).
        val snapshot = theme_package_render_snapshot("")
        val info = theme_role_color(snapshot, "semantic.info")
        val success = theme_role_color(snapshot, "semantic.success")
        val warning = theme_role_color(snapshot, "semantic.warning")
        val error = theme_role_color(snapshot, "semantic.error")
        expect(info.rgba).to_equal(0xFF9BDCFFu32)
        expect(success.rgba).to_equal(0xFFB1B1FFu32)
        expect(warning.rgba).to_equal(0xFFF4BD78u32)
        expect(error.rgba).to_equal(0xFFFFB4ABu32)
        expect(info.rgba).to_be_greater_than(0)
        expect(snapshot.semantic.info_rgba).to_equal(0xFF9BDCFFu32)
        expect(snapshot.semantic.error_rgba).to_equal(0xFFFFB4ABu32)

    it "maps sheet.error_cell onto the same real error color as semantic.error":
        step("Verify: maps sheet.error_cell onto the same real error color as semantic.error")
        val snapshot = theme_package_render_snapshot("")
        val sheet_error = theme_role_color(snapshot, "sheet.error_cell")
        val semantic_error = theme_role_color(snapshot, "semantic.error")
        expect(sheet_error.rgba).to_equal(semantic_error.rgba)
        expect(sheet_error.rgba).to_equal(0xFFFFB4ABu32)

    it "falls back to the fixed ThemeSemanticColors constants when a snapshot omits `semantic`":
        step("Verify: falls back to the fixed ThemeSemanticColors constants when a snapshot omits `semantic`")
        # theme_package.spl always populates `semantic` from the package CSS.
        # Other construction sites (generated fixtures, wire decode) that
        # predate this field, or a bare fixture like this one, get the
        # ThemeSemanticColors class defaults instead of a crash.
        val material = ThemeMaterialSemantics(
            desktop_fill_rgba: 0xFF010203u32,
            window_fill_rgba: 0xFF111213u32,
            active_title_fill_rgba: 0xFF212223u32,
            inactive_title_fill_rgba: 0xFF313233u32,
            surface_alpha_milli: 800,
            backdrop_blur_px: 24,
            backdrop_saturation_milli: 1700,
            border_width_px: 1,
            border_rgba: 0xFF414243u32,
            corner_radius_px: 12,
            active_shadows: [],
            inactive_shadows: [],
            font_family: "sans",
            font_size_px: 14,
            font_weight: 500,
            text_rgba: 0xFFF0F1F2u32,
            secondary_text_rgba: 0xFFE0E1E2u32,
            solid_fallback_rgba: 0xFF111213u32,
            fallback_contrast_milli: 4500,
            window_gradient_available: false,
            window_gradient_start_rgba: 0xFF111213u32,
            window_gradient_end_rgba: 0xFF111213u32,
            window_gradient_source_css: ""
        )
        val bare_snapshot = ThemeRenderSnapshot(
            id: "bare-fixture",
            family_id: "test",
            source_reference: "test/bare-fixture",
            source_manifest_sha256: "manifest-bare-fixture",
            material_sha256: "material-bare-fixture",
            composed_css: ":root " + "{" + "}",
            background_rgba: 0xFF010203u32,
            foreground_rgba: 0xFFF0F1F2u32,
            accent_rgba: 0xFF123456u32,
            material: material
        )
        val info = theme_role_color(bare_snapshot, "semantic.info")
        val success = theme_role_color(bare_snapshot, "semantic.success")
        val warning = theme_role_color(bare_snapshot, "semantic.warning")
        val error = theme_role_color(bare_snapshot, "semantic.error")
        expect(info.rgba).to_equal(0xFF3B82F6u32)
        expect(success.rgba).to_equal(0xFF22C55Eu32)
        expect(warning.rgba).to_equal(0xFFF59E0Bu32)
        expect(error.rgba).to_equal(0xFFEF4444u32)

describe "Extension theme fragment validation":
    it "accepts fragments whose keys use a recognized role namespace prefix":
        step("Verify: accepts fragments whose keys use a recognized role namespace prefix")
        val fragment: Dict<text, text> = {
            "wm.titlebar": "#112233",
            "workbench.editor": "#445566",
            "ext.myplugin.accent": "#778899"
        }
        val issues = validate_theme_fragment(fragment)
        expect(issues.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects keys outside the recognized role namespaces":
        step("Verify: rejects keys outside the recognized role namespaces")
        val fragment: Dict<text, text> = {
            "totally.made.up": "#000000"
        }
        val issues = validate_theme_fragment(fragment)
        expect(issues.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(issues[0].key).to_equal("totally.made.up")

    it "rejects an empty-string key":
        step("Verify: rejects an empty-string key")
        val fragment: Dict<text, text> = {
            "": "#000000"
        }
        val issues = validate_theme_fragment(fragment)
        expect(issues.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "accepts an empty fragment with no issues":
        step("Verify: accepts an empty fragment with no issues")
        val fragment: Dict<text, text> = {}
        val issues = validate_theme_fragment(fragment)
        expect(issues.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "Theme snapshot fingerprint stability":
    it "is byte-identical across two independent loads of the same theme":
        step("Verify: is byte-identical across two independent loads of the same theme")
        val first = theme_package_fingerprint("aetheric_dark")
        val second = theme_package_fingerprint("aetheric_dark")
        expect(first).to_equal(second)
        expect(first.len()).to_be_greater_than(0)
