use common.ui.wm_runtime_dispatch.{
    wm_runtime_apply_command,
    wm_runtime_dispatch_command,
    wm_runtime_shell_state_empty,
}

fn main() -> i64:
    val minimized = wm_runtime_apply_command(
        wm_runtime_shell_state_empty(),
        wm_runtime_dispatch_command(
            "window_minimize", "surf1", "demo.app", "win1", "", true
        )
    )
    val closed = wm_runtime_apply_command(
        minimized,
        wm_runtime_dispatch_command(
            "window_close", "surf1", "demo.app", "win1", "", true
        )
    )
    if (minimized.minimized_window_ids.len() == 1 and
        closed.closed_window_ids.len() == 1 and
        closed.closed_window_ids[0] == "win1" and
        closed.minimized_window_ids.len() == 0):
        print "WM CLOSE MINIMIZED CLEANUP PROBE: PASS"
        return 0
    print "WM CLOSE MINIMIZED CLEANUP PROBE: FAIL"
    1
