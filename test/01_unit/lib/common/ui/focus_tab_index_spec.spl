# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/common/ui/event.spl 80%
# @req FR-UI-TAB-INDEX
#
# Focus traversal honors an optional `tab_index` widget prop: widgets with a
# tab_index are ordered by it; those without keep declaration position; ties
# break by declaration order (stable). Covers forward and reverse walks.

use std.spec.step

use std.spec.*
use common.ui.widget.{WidgetNode, UIState}
use common.ui.builder.{column, button, label, panel, checkbox, build_tree}
use common.ui.event.{focus_next, focus_prev, get_focusable_ordered, handle_focus_event}


fn tab_state() -> UIState:
    val root = column("tabroot", [
        button("tab_a", "A", "act_a"),
        button("tab_b", "B", "act_b"),
        button("tab_c", "C", "act_c"),
    ])
    val tree = build_tree(root)
    # Declaration order is a, b, c but tab_index reorders them to b(1), c(2), a(3).
    WidgetNode(id: "tab_a").set_prop("tab_index", "3")
    WidgetNode(id: "tab_b").set_prop("tab_index", "1")
    WidgetNode(id: "tab_c").set_prop("tab_index", "2")
    UIState.new(tree)

fn index_of(ids: [text], target: text) -> i32:
    var i = 0
    for id in ids:
        if id == target:
            return i
        i = i + 1
    -1

describe "focus traversal honors tab_index":
    # @manual scenario evidence

    it "orders widgets by tab_index (1,2,3) not declaration order":
        # @req REQ-SSPEC-UNIT
        step("orders widgets by tab_index (1,2,3) not declaration order")
        val order = get_focusable_ordered(tab_state().tree)
        val pb = index_of(order, "tab_b")
        val pc = index_of(order, "tab_c")
        val pa = index_of(order, "tab_a")
        assert_true(pb < pc)
        assert_true(pc < pa)

    it "focus_next steps through the widgets in tab order":
        # @req REQ-SSPEC-UNIT
        step("focus_next steps through the widgets in tab order")
        # Focus tab_b, then Next should land on tab_c (next tab_index), then tab_a.
        var s = tab_state()
        s = UIState(tree: s.tree, mode: s.mode, focused_id: "tab_b", command_buffer: s.command_buffer)
        s = focus_next(s)
        expect(s.focused_id).to_equal("tab_c")
        s = focus_next(s)
        expect(s.focused_id).to_equal("tab_a")

    it "focus_prev reverses the tab order":
        # @req REQ-SSPEC-UNIT
        step("focus_prev reverses the tab order")
        var s = tab_state()
        s = UIState(tree: s.tree, mode: s.mode, focused_id: "tab_a", command_buffer: s.command_buffer)
        s = focus_prev(s)
        expect(s.focused_id).to_equal("tab_c")
        s = focus_prev(s)
        expect(s.focused_id).to_equal("tab_b")

    it "widgets without tab_index keep declaration position as their key":
        # @req REQ-SSPEC-UNIT
        step("widgets without tab_index keep declaration position as their key")
        # No tab_index props at all: order equals declaration order.
        val root = column("plainroot", [
            button("plain_a", "A", "a"),
            button("plain_b", "B", "b"),
        ])
        val order = get_focusable_ordered(build_tree(root))
        assert_true(index_of(order, "plain_a") < index_of(order, "plain_b"))

    it "excludes non-interactive, hidden, and disabled widgets from focus traversal":
        # @req REQ-SGUI-004
        step("Build tree with static label/panel, hidden button, disabled checkbox, and active button")
        val hidden_btn = button("hid_btn", "Hidden", "hid").set_visible(false)
        val dis_chk = checkbox("dis_chk", "Disabled", false).set_prop("disabled", "true")
        val root = panel("wrap_panel", "Panel", [
            label("static_lbl", "Static"),
            hidden_btn,
            dis_chk,
            button("live_btn", "Live", "live"),
        ])
        val order = get_focusable_ordered(build_tree(root))
        expect(index_of(order, "wrap_panel")).to_equal(-1)
        expect(index_of(order, "static_lbl")).to_equal(-1)
        expect(index_of(order, "hid_btn")).to_equal(-1)
        expect(index_of(order, "dis_chk")).to_equal(-1)
        expect(index_of(order, "live_btn")).to_equal(0)

    it "clears ui_focus and preedit on focus transitions and explicit blur":
        # @req REQ-SGUI-004
        step("Move focus from tab_b to tab_c and check previous widget blur cleanup")
        var s = tab_state()
        s = handle_focus_event(s, "tab_b", "focus")
        expect(s.focused_id).to_equal("tab_b")
        expect(WidgetNode(id: "tab_b").get_prop("ui_focus")).to_equal("true")
        WidgetNode(id: "tab_b").set_prop("preedit", "ka")
        s = focus_next(s)
        expect(s.focused_id).to_equal("tab_c")
        expect(WidgetNode(id: "tab_b").get_prop("ui_focus")).to_equal("false")
        expect(WidgetNode(id: "tab_b").get_prop("preedit")).to_equal("")
        expect(WidgetNode(id: "tab_c").get_prop("ui_focus")).to_equal("true")
        step("Explicit blur clears focused_id and ui_focus")
        WidgetNode(id: "tab_c").set_prop("preedit", "na")
        s = handle_focus_event(s, "tab_c", "blur")
        expect(s.focused_id).to_equal("")
        expect(WidgetNode(id: "tab_c").get_prop("ui_focus")).to_equal("false")
        expect(WidgetNode(id: "tab_c").get_prop("preedit")).to_equal("")
