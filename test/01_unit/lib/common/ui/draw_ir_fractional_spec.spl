# @tag: unit, ui, draw_ir, REQ-2D-002

use std.spec
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU, draw_ir_batch, draw_ir_composition, draw_ir_embedding_config, draw_ir_fractional_rect, draw_ir_rect}
use common.ui.draw_ir_sdn.{draw_ir_to_sdn, sdn_to_draw_ir}

describe "REQ-2D-002 versioned fractional DrawIR geometry":

    it "retains fractional coordinates and integer compatibility across SDN":
        val fractional = draw_ir_fractional_rect("fraction", 1.25, -2.5, 3.75, 4.125, 0xff112233u32)
        val integer = draw_ir_rect("integer", 1, 2, 3, 4, 0xff445566u32)
        val batch = draw_ir_batch("mixed", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config("surface", "component", 0, 0, 10, 10, 0, 1000, false),
            [fractional, integer])
        val encoded = draw_ir_to_sdn(draw_ir_composition("mixed", "scene", DRAW_IR_BACKEND_CPU, [batch]))
        val decoded = sdn_to_draw_ir(encoded)

        expect(encoded).to_start_with("draw_ir schema=simple-draw-ir-v3")
        expect(encoded).to_contain("fractional_present=true")
        expect(draw_ir_to_sdn(decoded)).to_equal(encoded)
        expect(decoded.batches[0].commands[0].x).to_equal(0)
        if val geometry = decoded.batches[0].commands[0].fractional_geometry:
            expect(geometry.x).to_equal(1.25)
            expect(geometry.y).to_equal(-2.5)
            expect(geometry.width).to_equal(3.75)
            expect(geometry.height).to_equal(4.125)
        else:
            fail("missing fractional geometry")
        expect(decoded.batches[0].commands[1].fractional_geometry).to_be_nil()
        expect(decoded.batches[0].commands[1].x).to_equal(1)
        expect(decoded.batches[0].commands[1].width).to_equal(3)

    it "promotes version-2 integer geometry without fabricating fractional values":
        val legacy = "draw_ir schema=simple-draw-ir-v2\n\tcomposition id=legacy scene_key=scene backend=cpu\n\tbatch id=batch backend=cpu surface=surface component=component x=0 y=0 width=10 height=10 layer=0 opacity=1000 clip=false\n\t\tcommand kind=rect id=integer x=2 y=3 width=4 height=5 color=4278190080 text="
        val decoded = sdn_to_draw_ir(legacy)

        expect(decoded.schema).to_equal("simple-draw-ir-v3")
        expect(decoded.batches[0].commands[0].fractional_geometry).to_be_nil()
        expect(decoded.batches[0].commands[0].x).to_equal(2)
        expect(decoded.batches[0].commands[0].height).to_equal(5)
