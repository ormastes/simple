use std.spec.{describe, it, expect}
use common.ui.style.{
    StyleRule,
    StyleSelector,
    StyleSheet,
    resolve_style,
    FontProperties
}

fn _italic_rule() -> StyleRule:
    val base = StyleRule.default()
    return StyleRule(
        color: base.color,
        font: FontProperties(
            family: base.font.family,
            size_px: base.font.size_px,
            weight: base.font.weight,
            style: "italic",
            line_height: base.font.line_height
        ),
        padding: base.padding,
        margin: base.margin,
        width: base.width,
        height: base.height,
        border_width: base.border_width,
        border_radius: base.border_radius,
        border_style: base.border_style,
        display: base.display,
        visibility: base.visibility
    )

describe "resolve_style cascades font style":
    it "applies an italic font-style override":
        var sheet = StyleSheet.new()
        sheet.add_rule(StyleSelector.by_kind("label"), _italic_rule())

        val resolved = resolve_style(sheet, "hint", "label", "", "")

        expect(resolved.font.style).to_equal("italic")
