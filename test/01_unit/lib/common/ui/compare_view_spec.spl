# @cover src/lib/common/ui/compare_view.spl 80%
# @tag: rendering, pixel-compare, inspection
"""
## Purpose and audience
Proves the pure planning half of the compare-view inspection infra used by the
Skia-vs-Simple-2D and Chrome-vs-Simple-web comparison tests: the open-mode
option, the host-screen-fitting window plan (side by side -> tabs -> fit or
scrollbars), the script-free inspection page, and the viewer launch arguments.
Written for rendering-parity test owners.
## Operator workflow
`SIMPLE_COMPARE_VIEW=stay|auto|off bin/simple test <compare spec>`; default off.
"""
use std.spec.*
use common.ui.compare_view.*
use std.common.types.{Count, Length}

describe "compare_view open mode":

    it "is off by default and for unknown values":
        expect(compare_view_mode_parse("")).to_equal("off")
        expect(compare_view_mode_parse("off")).to_equal("off")
        expect(compare_view_mode_parse("0")).to_equal("off")
        expect(compare_view_mode_parse("banana")).to_equal("off")

    it "parses stay and auto case-insensitively":
        expect(compare_view_mode_parse("stay")).to_equal("stay")
        expect(compare_view_mode_parse("1")).to_equal("stay")
        expect(compare_view_mode_parse(" Auto ")).to_equal("auto")

    it "parses html dump and files as html":
        expect(compare_view_mode_parse("html")).to_equal("html")
        expect(compare_view_mode_parse(" Dump ")).to_equal("html")
        expect(compare_view_mode_parse("FILES")).to_equal("html")

describe "compare_view screen size":

    it "parses WxH":
        val s = compare_view_screen_parse("1920x1040")
        expect(s.w).to_equal(1920)
        expect(s.h).to_equal(1040)

    it "reports unknown as 0x0":
        val s = compare_view_screen_parse("wide")
        expect(s.w).to_equal(0)
        expect(s.h).to_equal(0)

describe "compare_view window plan":

    it "shows both images side by side when they fit the host screen":
        val p = compare_view_plan(Length(value: 1920), Length(value: 1040), Length(value: 320), Length(value: 240), Length(value: 320), Length(value: 240))
        expect(p.side_by_side).to_equal(true)
        expect(p.needs_fit).to_equal(false)
        expect(p.maximized).to_equal(false)
        expect(p.window_w).to_equal(320 + 320 + COMPARE_VIEW_GAP + COMPARE_VIEW_DECOR_W)
        expect(p.window_h).to_equal(240 + COMPARE_VIEW_BAR_H + COMPARE_VIEW_DECOR_H)

    it "switches to tabs when the pair is wider than the screen":
        val p = compare_view_plan(Length(value: 1920), Length(value: 1040), Length(value: 1200), Length(value: 800), Length(value: 1200), Length(value: 800))
        expect(p.side_by_side).to_equal(false)
        expect(p.needs_fit).to_equal(false)
        expect(p.window_w).to_equal(1200 + COMPARE_VIEW_DECOR_W)
        expect(p.window_h).to_equal(800 + COMPARE_VIEW_BAR_H + COMPARE_VIEW_DECOR_H)

    it "switches to tabs when the pair is taller than the screen":
        val p = compare_view_plan(Length(value: 1920), Length(value: 600), Length(value: 300), Length(value: 580), Length(value: 300), Length(value: 580))
        expect(p.side_by_side).to_equal(false)
        expect(p.needs_fit).to_equal(true)

    it "clamps the window to the screen and asks for fit or scroll when one image is too big":
        val p = compare_view_plan(Length(value: 1920), Length(value: 1040), Length(value: 4000), Length(value: 3000), Length(value: 3840), Length(value: 2160))
        expect(p.side_by_side).to_equal(false)
        expect(p.needs_fit).to_equal(true)
        expect(p.window_w).to_equal(1920)
        expect(p.window_h).to_equal(1040)

    it "sizes tabs for the larger of two different images":
        val p = compare_view_plan(Length(value: 1000), Length(value: 1040), Length(value: 900), Length(value: 300), Length(value: 400), Length(value: 700))
        expect(p.side_by_side).to_equal(false)
        expect(p.window_w).to_equal(900 + COMPARE_VIEW_DECOR_W)
        expect(p.window_h).to_equal(700 + COMPARE_VIEW_BAR_H + COMPARE_VIEW_DECOR_H)

    it "never plans a window larger than the host screen":
        val p1 = compare_view_plan(Length(value: 800), Length(value: 600), Length(value: 790), Length(value: 590), Length(value: 10), Length(value: 10))
        expect(p1.window_w <= 800).to_equal(true)
        expect(p1.window_h <= 600).to_equal(true)
        val p2 = compare_view_plan(Length(value: 640), Length(value: 480), Length(value: 100), Length(value: 5000), Length(value: 100), Length(value: 100))
        expect(p2.window_w <= 640).to_equal(true)
        expect(p2.window_h <= 480).to_equal(true)

    it "keeps tiny images in a usable minimum window":
        val p = compare_view_plan(Length(value: 1920), Length(value: 1040), Length(value: 4), Length(value: 4), Length(value: 4), Length(value: 4))
        expect(p.window_w).to_equal(COMPARE_VIEW_MIN_W)
        expect(p.window_h).to_equal(COMPARE_VIEW_MIN_H)

    it "widens the side-by-side window for a third diff pane":
        val p = compare_view_plan_diff(Length(value: 1920), Length(value: 1040), Length(value: 320), Length(value: 240), Length(value: 320), Length(value: 240), Length(value: 320))
        expect(p.side_by_side).to_equal(true)
        expect(p.window_w).to_equal(320 * 3 + COMPARE_VIEW_GAP * 2 + COMPARE_VIEW_DECOR_W)

    it "falls back to tabs when three panes do not fit":
        val p = compare_view_plan_diff(Length(value: 1000), Length(value: 1040), Length(value: 400), Length(value: 240), Length(value: 400), Length(value: 240), Length(value: 400))
        expect(p.side_by_side).to_equal(false)

    it "maximizes when the host screen size is unknown":
        val p = compare_view_plan(Length(value: 0), Length(value: 0), Length(value: 320), Length(value: 240), Length(value: 320), Length(value: 240))
        expect(p.maximized).to_equal(true)

describe "compare_view inspection page":

    it "embeds both images with their labels and sizes":
        val html = compare_view_html("case02", "simple", "a.png", Length(value: 320), Length(value: 240), "skia", "b.png", Length(value: 300), Length(value: 200))
        expect(html).to_contain("src=a.png")
        expect(html).to_contain("src=b.png")
        expect(html).to_contain("A: simple 320x240")
        expect(html).to_contain("B: skia 300x200")

    it "lays out side by side only when the window can hold both, else tabs":
        val html = compare_view_html("t", "simple", "a.png", Length(value: 320), Length(value: 240), "chrome", "b.png", Length(value: 300), Length(value: 200))
        expect(html).to_contain("@media (min-width:628px) and (min-height:276px)")
        expect(html).to_contain("type=radio name=t id=ta checked")
        expect(html).to_contain("type=radio name=t id=tb")

    it "offers fit-to-window and falls back to scrollbars":
        val html = compare_view_html("t", "a", "a.png", Length(value: 9000), Length(value: 9000), "b", "b.png", Length(value: 9000), Length(value: 9000))
        expect(html).to_contain("type=checkbox id=fit checked")
        expect(html).to_contain("object-fit:contain")
        expect(html).to_contain("overflow:auto")

    it "contains no script and escapes labels":
        val html = compare_view_html("<t>", "a<b", "a.png", Length(value: 1), Length(value: 1), "c&d", "b.png", Length(value: 1), Length(value: 1))
        expect(html.contains("<script")).to_equal(false)
        expect(html).to_contain("a&lt;b")
        expect(html).to_contain("c&amp;d")
        expect(html).to_contain("<title>&lt;t&gt;</title>")

describe "compare_view viewer launch":

    it "opens an app window sized by the plan":
        val p = compare_view_plan(Length(value: 1920), Length(value: 1040), Length(value: 320), Length(value: 240), Length(value: 320), Length(value: 240))
        val args = compare_view_browser_args("file:///x/index.html", p, "/x/.profile")
        expect(args).to_contain("--app=file:///x/index.html")
        expect(args).to_contain("--window-size=" + p.window_w.to_text() + "," + p.window_h.to_text())
        expect(args).to_contain("--user-data-dir=/x/.profile")

    it "starts maximized when the screen is unknown":
        val p = compare_view_plan(Length(value: 0), Length(value: 0), Length(value: 320), Length(value: 240), Length(value: 320), Length(value: 240))
        val args = compare_view_browser_args("file:///x/index.html", p, "/x/.profile")
        expect(args).to_contain("--start-maximized")

    it "builds file URLs from Windows and POSIX paths":
        expect(compare_view_file_url("C:\\dev\\out\\index.html")).to_equal("file:///C:/dev/out/index.html")
        expect(compare_view_file_url("/tmp/out/index.html")).to_equal("file:///tmp/out/index.html")

    it "makes a filesystem-safe artifact name":
        expect(compare_view_slug("Chrome vs Simple: text/1")).to_equal("chrome_vs_simple__text_1")

describe "compare_view diff image":

    it "marks differing pixels magenta and dims equal ones":
        val a: [u32] = [0xFFFFFFFFu32, 0xFF000000u32]
        val b: [u32] = [0xFFFFFFFFu32, 0xFF0000FFu32]
        val d = compare_view_diff_argb(a, b)
        expect(d.len()).to_equal(2)
        expect(d[0]).to_equal(0xFF3F3F3Fu32)
        expect(d[1]).to_equal(0xFFFF00FFu32)
        expect(compare_view_diff_count(a, b)).to_equal(1)

describe "compare_view pixel adapters":

    it "converts RGBA8 bytes to ARGB words":
        val bytes: [u8] = [0x11u8, 0x22u8, 0x33u8, 0xFFu8, 0x01u8, 0x02u8, 0x03u8, 0x80u8]
        val argb = compare_view_argb_from_rgba8(bytes)
        expect(argb.len()).to_equal(2)
        expect(argb[0]).to_equal(0xFF112233u32)
        expect(argb[1]).to_equal(0x80010203u32)

describe "compare_view page stylesheet":

    it "closes the side-by-side media block":
        val html = compare_view_html("t", "a", "a.png", Length(value: 10), Length(value: 10), "b", "b.png", Length(value: 20), Length(value: 10))
        expect(html).to_contain(r"}}</style>")
        expect(html).to_contain(r"nav{height:36px}@media")

    it "marks the split between the two images when side by side":
        val html = compare_view_html("t", "a", "a.png", Length(value: 10), Length(value: 10), "b", "b.png", Length(value: 20), Length(value: 10))
        expect(html).to_contain(r"main{gap:8px;background:#facc15}")
        expect(html).to_contain(r".a{border-color:#f97316}")
        expect(html).to_contain(r".b{border-color:#06b6d4}")

    it "makes tabs look like tabs and says how to switch":
        val html = compare_view_html("t", "a", "a.png", Length(value: 10), Length(value: 10), "b", "b.png", Length(value: 20), Length(value: 10))
        expect(html).to_contain("TABS - click A or B to switch")
        expect(html).to_contain(r"#ta:checked~nav label[for=ta]{background:#f97316")
        expect(html).to_contain(r"#tb:checked~nav label[for=tb]{background:#06b6d4")

    it "adds a diff tab with the differing pixel count when given a diff image":
        val html = compare_view_html_diff("t", "a", "a.png", Length(value: 10), Length(value: 10), "b", "b.png", Length(value: 10), Length(value: 10), "diff.png", Count(value: 7))
        expect(html).to_contain("type=radio name=t id=td")
        expect(html).to_contain("DIFF: 7 px differ")
        expect(html).to_contain("src=diff.png")
        expect(html).to_contain("@media (min-width:46px)")

    it "has no diff tab without a diff image":
        val html = compare_view_html("t", "a", "a.png", Length(value: 10), Length(value: 10), "b", "b.png", Length(value: 10), Length(value: 10))
        expect(html.contains("id=td")).to_equal(false)

    it "enlarges small images to fill the window when fit is on":
        val html = compare_view_html("t", "a", "a.png", Length(value: 4), Length(value: 4), "b", "b.png", Length(value: 4), Length(value: 4))
        expect(html).to_contain(r"#fit:checked~main img{width:100%;height:100%;object-fit:contain}")

    it "includes match percentage and small-buffer warning when below 128x96":
        val html = compare_view_html_diff("t", "a", "a.png", Length(value: 10), Length(value: 10), "b", "b.png", Length(value: 10), Length(value: 10), "diff.png", Count(value: 25))
        expect(html).to_contain("match: 75.00%")
        expect(html).to_contain("SMALL BUFFER")

    it "omits small-buffer warning when both buffers are at least 128x96":
        val html = compare_view_html_diff("t", "a", "a.png", Length(value: 128), Length(value: 96), "b", "b.png", Length(value: 128), Length(value: 96), "diff.png", Count(value: 0))
        expect(html).to_contain("match: 100.00%")
        expect(html.contains("SMALL BUFFER")).to_equal(false)

describe "compare_view comparable size":

    it "requires at least 128x96":
        expect(compare_view_is_comparable_size(128, 96)).to_equal(true)
        expect(compare_view_is_comparable_size(320, 160)).to_equal(true)
        expect(compare_view_is_comparable_size(127, 96)).to_equal(false)
        expect(compare_view_is_comparable_size(128, 95)).to_equal(false)
        expect(compare_view_is_comparable_size(32, 16)).to_equal(false)

describe "compare_view heatmap image":

    it "colors 0 delta dim grey, 1..tol yellow, tol+1..32 orange, >32 magenta":
        val a: [u32] = [0xFFFFFFFFu32, 0xFF808080u32, 0xFF808080u32, 0xFF000000u32]
        val b: [u32] = [0xFFFFFFFFu32, 0xFF838080u32, 0xFF908080u32, 0xFF400000u32]
        val heat = compare_view_heatmap_argb(a, b, 4)
        val grey = compare_view_diff_argb([0xFFFFFFFFu32], [0xFFFFFFFFu32])[0]
        expect(heat.len()).to_equal(4)
        expect(heat[0]).to_equal(grey)
        expect(heat[1]).to_equal(0xFFFFCC00u32)
        expect(heat[2]).to_equal(0xFFFF6600u32)
        expect(heat[3]).to_equal(0xFFFF00FFu32)

describe "compare_view visual diff and stats":

    it "reports zero diff stats on identical buffers":
        val px: [u32] = [0x00000000u32, 0xFF1E50C8u32, 0xFF1E50C8u32, 0x00000000u32]
        val stats = compare_view_diff_stats(px, px)
        expect(stats.total_diff).to_equal(0)
        expect(stats.color_only_diff).to_equal(0)
        expect(stats.alpha_or_shape_diff).to_equal(0)
        expect(stats.max_channel_delta).to_equal(0)

    it "distinguishes A-only shape fill, B-only shape fill, and opaque color diff":
        # index 0: shared transparent corner backdrop
        # index 1: present in A (blue), transparent in B (gold/orange like winding inner pentagon)
        # index 2: transparent in A, present in B (red-orange) -> cyan
        # index 3: blue in A vs red-orange in B -> amplified purple RGB delta
        val a: [u32] = [0x00000000u32, 0xFF1E50C8u32, 0x00000000u32, 0xFF1E50C8u32]
        val b: [u32] = [0x00000000u32, 0x00000000u32, 0xFFC83C1Eu32, 0xFFC83C1Eu32]
        val res = compare_view_visual_diff_with_stats(a, b)
        expect(res.stats.total_diff).to_equal(3)
        expect(res.stats.alpha_or_shape_diff).to_equal(2)
        expect(res.stats.color_only_diff).to_equal(1)
        expect(res.stats.max_channel_delta).to_equal(255)
        val px_a_only = res.pixels[1]
        val px_b_only = res.pixels[2]
        val px_color = res.pixels[3]
        # Gold/orange for A-only: R=255, G>=155, B=20
        expect(((px_a_only >> 16) & 0xFFu32)).to_equal(255u32)
        expect(((px_a_only >> 8) & 0xFFu32) >= 155u32).to_equal(true)
        expect((px_a_only & 0xFFu32)).to_equal(20u32)
        # Cyan for B-only: R=20, G>=180, B=255
        expect(((px_b_only >> 16) & 0xFFu32)).to_equal(20u32)
        expect(((px_b_only >> 8) & 0xFFu32) >= 180u32).to_equal(true)
        expect((px_b_only & 0xFFu32)).to_equal(255u32)
        # Purple color delta for blue-vs-red: distinct from gold A-only pixel
        expect(px_color != px_a_only).to_equal(true)
        expect(((px_color >> 16) & 0xFFu32) > 150u32).to_equal(true)
        expect((px_color & 0xFFu32) > 150u32).to_equal(true)

    it "sizes 3-pane windows wide enough for side-by-side 200x200 panes and cascades position":
        val plan = compare_view_plan_panes(1440, 900, 200, 200, 200, 200, 3)
        expect(plan.side_by_side).to_equal(true)
        expect(plan.window_w >= 636).to_equal(true)
        val args = compare_view_browser_args_offset("file:///x/index.html", plan, "/x/.profile", 1)
        expect(args).to_contain("--window-position=36,32")

    it "renders IDENTICAL and breakdown status badges in compare_view_html_rich":
        val zero = CompareViewDiffStats(total_diff: 0, color_only_diff: 0, alpha_or_shape_diff: 0, max_channel_delta: 0)
        val h_ident = compare_view_html_rich("same", "a", "a.png", 200, 200, "b", "b.png", 200, 200, "delta.png", "heatmap.png", zero)
        expect(h_ident).to_contain("IDENTICAL (0 color diff, 0 shape/alpha diff, max Δ=0)")
        expect(h_ident).to_contain("src=delta.png")
        expect(h_ident).to_contain("src=heatmap.png")
        val mixed = CompareViewDiffStats(total_diff: 120, color_only_diff: 90, alpha_or_shape_diff: 30, max_channel_delta: 255)
        val h_diff = compare_view_html_rich("diff", "a", "a.png", 200, 200, "b", "b.png", 200, 200, "delta.png", "heatmap.png", mixed)
        expect(h_diff).to_contain("max Δ=255 | shape/alpha: 30 px (gold=A, cyan=B) | color: 90 px")
