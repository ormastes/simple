"""
## Purpose and audience
Purpose: Prove that DrawIR v3 CPU oracle and validation sink.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/draw_ir_v3_oracle.spl 80%
# @tag: unit, ui, draw_ir, draw_ir_v3, gpu_web, oracle

use std.spec
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_FLAG_HIDDEN,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_KIND_TEXT,
    DrawIrV3Scene,
    draw_ir_v3_empty_command,
    draw_ir_v3_empty_scene,
    draw_ir_v3_geometry_append,
    draw_ir_v3_geometry_next_id,
    draw_ir_v3_paint_append,
    draw_ir_v3_paint_next_id,
    draw_ir_v3_scene_push_command
}
use common.ui.draw_ir_v3_oracle.{
    draw_ir_v3_oracle_count,
    draw_ir_v3_oracle_hash,
    draw_ir_v3_oracle_validate,
    draw_ir_v3_oracle_walk
}

# --- fixtures ---------------------------------------------------------------

# One geometry row + one paint row, referenced by both rects below, so the
# validate-true case has real in-range table ids rather than all-sentinel.
fn _oracle_scene_with_geometry_and_paint() -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(1u32, 1u32)

    var geometry = scene.geometry
    val gid = draw_ir_v3_geometry_next_id(geometry)
    geometry = draw_ir_v3_geometry_append(geometry, 0, 0, 10, 10, 0)
    scene.geometry = geometry

    var paint = scene.paint
    val pid = draw_ir_v3_paint_next_id(paint)
    paint = draw_ir_v3_paint_append(paint, 0xff112233u32, 0u32, 0, 1000, 0u16)
    scene.paint = paint

    var cmd = draw_ir_v3_empty_command()
    cmd.kind = DRAW_IR_V3_KIND_RECT
    cmd.geometry_id = gid
    cmd.paint_id = pid
    draw_ir_v3_scene_push_command(scene, cmd)

# Two visible rects (sharing the one geometry/paint row above) plus one
# hidden text command with no geometry/paint reference at all.
fn _oracle_two_rects_one_hidden_text_scene() -> DrawIrV3Scene:
    var scene = _oracle_scene_with_geometry_and_paint()

    val gid = draw_ir_v3_geometry_next_id(scene.geometry) - 1u32
    val pid = draw_ir_v3_paint_next_id(scene.paint) - 1u32

    var cmd1 = draw_ir_v3_empty_command()
    cmd1.kind = DRAW_IR_V3_KIND_RECT
    cmd1.geometry_id = gid
    cmd1.paint_id = pid
    scene = draw_ir_v3_scene_push_command(scene, cmd1)

    var cmd2 = draw_ir_v3_empty_command()
    cmd2.kind = DRAW_IR_V3_KIND_TEXT
    cmd2.flags = DRAW_IR_V3_FLAG_HIDDEN
    draw_ir_v3_scene_push_command(scene, cmd2)

# A single rect command with a caller-chosen `paint_id`, everything else left
# at `draw_ir_v3_empty_command()` defaults -- used to prove the hash is
# sensitive to one field changing.
fn _oracle_single_rect_scene(paint_id: u32) -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(1u32, 1u32)
    var cmd = draw_ir_v3_empty_command()
    cmd.kind = DRAW_IR_V3_KIND_RECT
    cmd.paint_id = paint_id
    draw_ir_v3_scene_push_command(scene, cmd)

describe "DrawIR v3 CPU oracle and validation sink":

    it "reports zero counts and a stable hash for an empty scene":
        step("Verify: reports zero counts and a stable hash for an empty scene")
        # @req: REQ-LIB-COMMON-001
        val scene = draw_ir_v3_empty_scene(1u32, 1u32)
        val report_a = draw_ir_v3_oracle_walk(scene)
        val report_b = draw_ir_v3_oracle_walk(scene)

        expect(report_a.total_commands).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report_a.rect_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report_a.text_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report_a.image_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report_a.path_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report_a.hidden_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report_a.hash).to_equal(report_b.hash)
        expect(draw_ir_v3_oracle_hash(scene)).to_equal(report_a.hash)

    it "counts two rects and one hidden text command from a single pass":
        step("Verify: counts two rects and one hidden text command from a single pass")
        val scene = _oracle_two_rects_one_hidden_text_scene()
        val report = draw_ir_v3_oracle_walk(scene)

        expect(report.total_commands).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(report.rect_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(report.text_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(report.hidden_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(draw_ir_v3_oracle_count(scene)).to_equal(report.total_commands)

    it "gives identical scenes equal hashes":
        step("Verify: gives identical scenes equal hashes")
        val scene_a = _oracle_two_rects_one_hidden_text_scene()
        val scene_b = _oracle_two_rects_one_hidden_text_scene()

        expect(draw_ir_v3_oracle_hash(scene_a)).to_equal(draw_ir_v3_oracle_hash(scene_b))

    it "gives a different hash when one command field (paint_id) changes":
        step("Verify: gives a different hash when one command field (paint_id) changes")
        val scene_a = _oracle_single_rect_scene(7u32)
        val scene_b = _oracle_single_rect_scene(8u32)

        val hash_a = draw_ir_v3_oracle_hash(scene_a)
        val hash_b = draw_ir_v3_oracle_hash(scene_b)
        expect(hash_a == hash_b).to_equal(false)

    it "validates true when every table id is in range":
        step("Verify: validates true when every table id is in range")
        val scene = _oracle_scene_with_geometry_and_paint()
        expect(draw_ir_v3_oracle_validate(scene)).to_equal(true)

    it "validates false for a command whose geometry_id is out of range":
        step("Verify: validates false for a command whose geometry_id is out of range")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        var cmd = draw_ir_v3_empty_command()
        cmd.kind = DRAW_IR_V3_KIND_RECT
        cmd.geometry_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, cmd)

        expect(draw_ir_v3_oracle_validate(scene)).to_equal(false)
