"""
## Purpose and audience
Purpose: Prove that panel_to_draw_ir_batch / panels_to_composition — DrawIR projection.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/panel2d.spl 80%
"""
# Panel2D — conformance spec

**Feature IDs:** N/A (Lane L2 of the unified 2D event/panel/offload campaign)
**Category:** Stdlib / UI
**Status:** Implemented
**Plan:** doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md

## Overview

Covers `src/lib/common/ui/panel2d.spl`: DrawIR projection (one batch per
top-level panel, children flattened to batch-local commands), pointer
dispatch through the shared interaction core (bubbling, layer ordering,
clip), the D3 transparency contract (`opacity_milli` is render-only,
`POINTER_POLICY_NONE` is the only click-through mechanism), wheel-driven
scroll with clamping, and the taskbar's slot-hit-testing use of
`panel_hit_forest` instead of x/slot_w division.
"""

use std.spec.*
use std.common.io.window_event.{
    WindowEventLoop,
    WindowEventRecord,
    window_event_none,
    WINDOW_EVENT_WHEEL,
    WINDOW_STATUS_OK
}
use std.common.ui.panel2d.{
    Panel2D, PanelDispatchResult,
    panel2d, panel_add_child, panel_with_scroll, panel_scroll_by,
    panel_to_draw_ir_batch, panels_to_composition, panel_hit_forest,
    panel_dispatch_pointer, taskbar_panel
}
use std.common.ui.scroll_surface.{ScrollModel}
use std.common.ui.taskbar_model.{TaskbarModel, AppRef, WindowRef}
use std.common.engine.interaction.hit_proxy.{POINTER_POLICY_NONE}
use std.common.engine.interaction.event_route.{EventListener2D, ACTION_NONE}
use std.common.engine.interaction.pointer_event.{PointerEvent2D, POINTER_DOWN, POINTER_WHEEL}
use std.common.engine.interaction.draw_ir_hit_bridge.{draw_ir_node_id}
use std.common.engine.interaction.window_event_adapter.{drain_pointer_events}

fn handler_none(e: PointerEvent2D) -> i32:
    ACTION_NONE

fn _wheel_record(handle: i64, seq: i64, x_milli: i64, y_milli: i64, delta_x_milli: i64, delta_y_milli: i64) -> WindowEventRecord:
    var rec = window_event_none()
    rec.kind = WINDOW_EVENT_WHEEL
    rec.window_handle = handle
    rec.sequence = seq
    rec.x_milli = x_milli
    rec.y_milli = y_milli
    rec.delta_x_milli = delta_x_milli
    rec.delta_y_milli = delta_y_milli
    rec

fn _count_i64(arr: [i64], v: i64) -> i32:
    var c = 0
    var i = 0
    while i < arr.len():
        if arr[i] == v:
            c = c + 1
        i = i + 1
    c

describe "panel_to_draw_ir_batch / panels_to_composition — DrawIR projection":

    it "one panel with one child projects a batch carrying the embedding plus its commands":
        # @req: REQ-LIB-COMMON-001
        step("root panel at (10,20,200,100) with one child at parent-relative (5,5,50,50)")
        var root = panel2d("root", 10, 20, 200, 100)
        val child = panel2d("child", 5, 5, 50, 50)
        root = panel_add_child(root, child)

        val batch = panel_to_draw_ir_batch(root)
        expect(batch.embedding.component_id).to_equal("root")
        expect(batch.embedding.x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(batch.embedding.y).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(batch.embedding.width).to_equal(200)  # oracle: 200 — named expected value from the requirement
        expect(batch.embedding.height).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(batch.embedding.layer).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(batch.embedding.opacity_milli).to_equal(1000)  # oracle: 1000 — named expected value from the requirement
        assert_false(batch.embedding.clip)

        expect(batch.commands.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val cmd = batch.commands[0]
        expect(cmd.component_id).to_equal("child")
        expect(cmd.x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(cmd.y).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(cmd.width).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(cmd.height).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(cmd.parent_id).to_equal("")
        assert_true(cmd.hit_rect.present)
        expect(cmd.hit_rect.x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(cmd.hit_rect.y).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(cmd.hit_rect.width).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(cmd.hit_rect.height).to_equal(50)  # oracle: 50 — named expected value from the requirement

    it "two sibling top-level panels produce two batches in array order":
        step("Verify: two sibling top-level panels produce two batches in array order")
        val panels = [panel2d("a", 0, 0, 10, 10), panel2d("b", 20, 20, 10, 10)]
        val comp = panels_to_composition(panels)
        expect(comp.batches.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(comp.batches[0].embedding.component_id).to_equal("a")
        expect(comp.batches[1].embedding.component_id).to_equal("b")

describe "panel_dispatch_pointer — hit targeting and bubbling":

    it "a pointer down on a child bubbles to a listener registered on the parent":
        step("child covers (50,50)-(100,100) absolute; listener sits on the parent")
        var root = panel2d("root", 0, 0, 200, 200)
        val child = panel2d("child", 50, 50, 50, 50)
        root = panel_add_child(root, child)

        val event = PointerEvent2D.create(1, POINTER_DOWN, 60, 60, 1, -1)
        val listeners = [EventListener2D.create(draw_ir_node_id("root"), -1, false, false, handler_none)]

        val result = panel_dispatch_pointer([root], event, listeners)
        expect(result.target_node).to_equal(draw_ir_node_id("child"))
        expect(result.target_name).to_equal("child")
        expect(_count_i64(result.fired_node_ids, draw_ir_node_id("root"))).to_equal(1)

    it "of two overlapping panels, the higher layer is the target":
        step("Verify: of two overlapping panels, the higher layer is the target")
        var panel_a = panel2d("a", 0, 0, 100, 100)
        var panel_b = panel2d("b", 0, 0, 100, 100)
        panel_b.layer = 5

        val event = PointerEvent2D.create(1, POINTER_DOWN, 50, 50, 1, -1)
        val result = panel_dispatch_pointer([panel_a, panel_b], event, [])
        expect(result.target_name).to_equal("b")

    it "clip=true excludes a point outside the panel rect, even one inside a child's raw bounds":
        step("child extends past the parent; clip clamps the child's hit rect back to the parent")
        var root = panel2d("root", 0, 0, 100, 100)
        root.clip = true
        val child = panel2d("child", 80, 80, 40, 40)
        root = panel_add_child(root, child)

        val event = PointerEvent2D.create(1, POINTER_DOWN, 110, 110, 1, -1)
        val result = panel_dispatch_pointer([root], event, [])
        expect(result.target_node).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(result.target_name).to_equal("")

describe "Transparency contract (D3) — opacity_milli is render-only":

    it "a low opacity_milli with Auto pointer policy still hit-tests":
        step("Verify: a low opacity_milli with Auto pointer policy still hit-tests")
        var root = panel2d("root", 0, 0, 100, 100)
        root.opacity_milli = 50
        val event = PointerEvent2D.create(1, POINTER_DOWN, 50, 50, 1, -1)
        val result = panel_dispatch_pointer([root], event, [])
        expect(result.target_name).to_equal("root")

    it "POINTER_POLICY_NONE is click-through to the panel underneath":
        step("Verify: POINTER_POLICY_NONE is click-through to the panel underneath")
        val bottom = panel2d("bottom", 0, 0, 100, 100)
        var top = panel2d("top", 0, 0, 100, 100)
        top.pointer_policy = POINTER_POLICY_NONE

        val event = PointerEvent2D.create(1, POINTER_DOWN, 50, 50, 1, -1)
        val result = panel_dispatch_pointer([bottom, top], event, [])
        expect(result.target_name).to_equal("bottom")

describe "Wheel dispatch — scroll offset clamping":

    it "a wheel event scrolls the offset by the delta":
        step("Verify: a wheel event scrolls the offset by the delta")
        val model = ScrollModel(total_rows: 100, view_w: 100, view_h: 100)
        var root = panel_with_scroll(panel2d("root", 0, 0, 100, 100), model)
        var event = PointerEvent2D.create(1, POINTER_WHEEL, 50, 50, 0, -1)
        event.delta_y = 20

        val result = panel_dispatch_pointer([root], event, [])
        assert_true(result.scrolled)
        expect(result.panels[0].scroll_offset).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "scrolling past the end clamps at max_scroll":
        step("total_rows=2, view_h=6 -> content_height=96 -> max_scroll=90")
        val model = ScrollModel(total_rows: 2, view_w: 100, view_h: 6)
        var root = panel_with_scroll(panel2d("root", 0, 0, 100, 100), model)
        var event = PointerEvent2D.create(1, POINTER_WHEEL, 50, 50, 0, -1)
        event.delta_y = 500

        val result = panel_dispatch_pointer([root], event, [])
        expect(result.panels[0].scroll_offset).to_equal(90)  # oracle: 90 — named expected value from the requirement

    it "scrolling negative floors at 0":
        step("Verify: scrolling negative floors at 0")
        val model = ScrollModel(total_rows: 100, view_w: 100, view_h: 50)
        var root = panel_with_scroll(panel2d("root", 0, 0, 100, 100), model)
        var event = PointerEvent2D.create(1, POINTER_WHEEL, 50, 50, 0, -1)
        event.delta_y = -50

        val result = panel_dispatch_pointer([root], event, [])
        expect(result.panels[0].scroll_offset).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "a panel without has_scroll ignores wheel entirely":
        step("Verify: a panel without has_scroll ignores wheel entirely")
        val root = panel2d("root", 0, 0, 100, 100)
        var event = PointerEvent2D.create(1, POINTER_WHEEL, 50, 50, 0, -1)
        event.delta_y = 20

        val result = panel_dispatch_pointer([root], event, [])
        assert_false(result.scrolled)
        expect(result.panels[0].scroll_offset).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "taskbar_panel — slot hit targeting":

    it "a point over slot 1 targets taskbar_slot_1; a point past every slot targets the bar itself":
        step("Verify: a point over slot 1 targets taskbar_slot_1; a point past every slot targets the bar itself")
        val model = TaskbarModel(
            pinned: [
                AppRef(app_id: "app1", display_name: "App One", icon: ""),
                AppRef(app_id: "app2", display_name: "App Two", icon: "")
            ],
            running: [WindowRef(window_id: "w1", app_id: "app3", title: "Win", minimized: false)],
            tray: []
        )
        val bar = taskbar_panel(model, 1000, 80, 40)

        val hit_slot = PointerEvent2D.create(1, POINTER_DOWN, 90, 20, 1, -1)
        val slot_result = panel_dispatch_pointer([bar], hit_slot, [])
        expect(slot_result.target_name).to_equal("taskbar_slot_1")

        val hit_bar = PointerEvent2D.create(1, POINTER_DOWN, 400, 20, 1, -1)
        val bar_result = panel_dispatch_pointer([bar], hit_bar, [])
        expect(bar_result.target_name).to_equal("taskbar")

describe "End-to-end wheel dispatch — WindowEventRecord through adapter to Panel2D scroll":

    it "a wheel WindowEventRecord converts and scrolls a panel with scroll by its delta":
        step("Create a WindowEventRecord with WINDOW_EVENT_WHEEL at (50_000, 60_000) milli, delta_y_milli = +2000 (scroll down)")
        var events = WindowEventLoop.create(4, 1)
        val wheel_rec = _wheel_record(7, 1, 50000, 60000, 0, 2000)
        expect(events.enqueue(wheel_rec)).to_equal(WINDOW_STATUS_OK)

        step("Drain the record through the adapter to get PointerEvent2D with POINTER_WHEEL kind")
        val drained = drain_pointer_events(events)
        expect(drained.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val wheel_event = drained[0]
        expect(wheel_event.kind).to_equal(POINTER_WHEEL)
        expect(wheel_event.x).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(wheel_event.y).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(wheel_event.delta_y).to_equal(2)  # oracle: 2 — named expected value from the requirement

        step("Create a scrollable panel and dispatch the wheel event")
        val model = ScrollModel(total_rows: 100, view_w: 100, view_h: 100)
        var root = panel_with_scroll(panel2d("root", 0, 0, 100, 100), model)
        val result = panel_dispatch_pointer([root], wheel_event, [])

        step("Assert the scroll offset changed by the delta")
        assert_true(result.scrolled)
        expect(result.panels[0].scroll_offset).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "wheel scroll through adapter clamps at both ends":
        step("Scroll UP (delta_y_milli = -5000) at start position (offset 0)")
        var events_up = WindowEventLoop.create(4, 1)
        val wheel_up = _wheel_record(7, 1, 50000, 50000, 0, -5000)
        expect(events_up.enqueue(wheel_up)).to_equal(WINDOW_STATUS_OK)
        val drained_up = drain_pointer_events(events_up)

        val model_at_zero = ScrollModel(total_rows: 100, view_w: 100, view_h: 100)
        var root_at_zero = panel_with_scroll(panel2d("root", 0, 0, 100, 100), model_at_zero)
        val result_up = panel_dispatch_pointer([root_at_zero], drained_up[0], [])

        step("Clamp at 0 prevents negative offset")
        expect(result_up.panels[0].scroll_offset).to_equal(0)  # oracle: 0 — named expected value from the requirement

        step("Scroll DOWN (delta_y_milli = +10000) at end position (offset max_scroll)")
        var events_down = WindowEventLoop.create(4, 1)
        val wheel_down = _wheel_record(7, 1, 50000, 50000, 0, 10000)
        expect(events_down.enqueue(wheel_down)).to_equal(WINDOW_STATUS_OK)
        val drained_down = drain_pointer_events(events_down)

        val model_at_end = ScrollModel(total_rows: 2, view_w: 100, view_h: 6)
        var root_at_end = panel_with_scroll(panel2d("root", 0, 0, 100, 100), model_at_end)
        var root_at_end_scrolled = root_at_end
        root_at_end_scrolled.scroll_offset = 90
        val result_down = panel_dispatch_pointer([root_at_end_scrolled], drained_down[0], [])

        step("Clamp at max_scroll: total_rows=2, view_h=6 -> max_scroll=90")
        expect(result_down.panels[0].scroll_offset).to_equal(90)  # oracle: 90 — named expected value from the requirement

describe "panel_hit_forest — proxy tree over a panel set":

    it "3 proxies (2 groups + 1 leaf) are produced with the expected parent chain":
        step("Verify: 3 proxies (2 groups + 1 leaf) are produced with the expected parent chain")
        val p1 = panel2d("p1", 0, 0, 50, 50)
        var p2 = panel2d("p2", 100, 0, 50, 50)
        val p2_child = panel2d("p2_child", 10, 10, 20, 20)
        p2 = panel_add_child(p2, p2_child)

        val forest = panel_hit_forest([p1, p2])
        expect(forest.proxies.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(forest.parents[draw_ir_node_id("p2_child")]).to_equal(draw_ir_node_id("p2"))
        assert_false(forest.parents.contains_key(draw_ir_node_id("p1")))
        expect(forest.node_names[draw_ir_node_id("p2_child")]).to_equal("p2_child")
