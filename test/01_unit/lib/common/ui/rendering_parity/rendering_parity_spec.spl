"""
## Purpose and audience
Purpose: Prove that rendering parity contracts and pixels.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/rendering_parity 80%
# @tag: unit, ui, rendering, parity

use std.spec
use common.ui.rendering_parity.*

describe "rendering parity contracts and pixels":
    it "validates frozen contracts":
        step("Verify: validates frozen contracts")
        # @req: REQ-LIB-COMMON-001
        val fixture = rendering_fixture("button-1", "button", "html", "<button>x</button>", 2, 1).unwrap()
        expect(fixture.schema_version).to_equal(RENDERING_PARITY_SCHEMA_VERSION)
        expect(fixture.component).to_equal("button")
        expect(rendering_fixture("", "button", "html", "", 2, 1).is_err()).to_equal(true)
        expect(rendering_stage_record("button-1", "pixels", "cpu", 1u64, 2u64).is_ok()).to_equal(true)
        expect(backend_evidence("button-1", "gpu", "vulkan", true, "skip", "device unavailable").is_ok()).to_equal(true)
        expect(backend_evidence("button-1", "gpu", "vulkan", true, "skip", "").is_err()).to_equal(true)

        val deterministic = rendering_fixture_v1("button-1", "button", "html", "<button>x</button>", "sha256:resource", "sha256:config", 800, 600, 2000, "srgb", "sha256:fonts", "en-US", "UTC", 42, "hover:none", ["grid"], ["chrome", "cpu", "simd", "vulkan"], "button-aa", 2).unwrap()
        expect(deterministic.required_rows.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(deterministic.dpr_milli).to_equal(2000)  # oracle: 2000 — named expected value from the requirement
        expect(rendering_fixture_v1("x", "button", "html", "", "", "hash", 1, 1, 1000, "srgb", "fonts", "en", "UTC", 0, "none", [], ["cpu"], "exact", 1).is_err()).to_equal(true)

    it "validates ordered stages and truthful independent backend receipts":
        step("Verify: validates ordered stages and truthful independent backend receipts")
        val first = rendering_stage_record_v1("one", "gpu", "dom", 0, "root", "{}", 1u64, 2u64, "simple-stage", 1, false, false).unwrap()
        val second = rendering_stage_record_v1("one", "gpu", "raster", 1, "root", "{}", 2u64, 3u64, "gpu-rgba", 1, false, false).unwrap()
        expect(rendering_stage_records_valid_order([first, second])).to_equal(true)
        expect(rendering_stage_records_valid_order([second, first])).to_equal(false)
        val gpu = backend_evidence_v1("one", "vulkan", "vulkan", "run-1", "rev-1", "vk-1", "device-1", "device-readback-1", 1, 1, "bgra8", 3, 0, true, false, false, false, "", 50, 1000, "pass", "").unwrap()
        val gpu2 = backend_evidence_v1("one", "vulkan", "vulkan", "run-2", "rev-1", "vk-1", "device-1", "device-readback-2", 1, 1, "bgra8", 3, 0, true, false, false, false, "", 51, 1001, "pass", "").unwrap()
        expect(backend_evidence_truthful_physical_gpu(gpu)).to_equal(true)
        expect(backend_evidence_distinct_execution(gpu, gpu2)).to_equal(true)
        expect(backend_evidence_v1("one", "vulkan", "cpu", "run-3", "rev", "vk", "device", "readback", 1, 1, "rgba8", 1, 0, true, false, true, false, "", 1, 1, "pass", "").is_err()).to_equal(true)

    it "compares semantic stages exactly and reports the first style divergence":
        step("Verify: compares semantic stages exactly and reports the first style divergence")
        val expected_dom = rendering_stage_record_v1("one", "chrome", "dom", 0, "root", "button", 1u64, 2u64, "chrome-stage", 1, false, false).unwrap()
        val expected_style = rendering_stage_record_v1("one", "chrome", "style", 1, "root", "color:red", 2u64, 3u64, "chrome-stage", 1, false, false).unwrap()
        val actual_dom = rendering_stage_record_v1("one", "cpu", "dom", 0, "root", "button", 1u64, 2u64, "simple-stage", 1, false, false).unwrap()
        val actual_style = rendering_stage_record_v1("one", "cpu", "style", 1, "root", "color:red", 2u64, 3u64, "simple-stage", 1, false, false).unwrap()
        val exact = compare_rendering_stages([expected_dom, expected_style], [actual_dom, actual_style], "chrome", "cpu").unwrap()
        expect(exact.equal).to_equal(true)
        expect(exact.status).to_equal("exact")
        expect(exact.first_divergent_stage).to_equal("")

        val changed_style = rendering_stage_record_v1("one", "cpu", "style", 1, "root", "color:blue", 2u64, 4u64, "simple-stage", 1, false, false).unwrap()
        val divergent = compare_rendering_stages([expected_dom, expected_style], [actual_dom, changed_style], "chrome", "cpu").unwrap()
        expect(divergent.equal).to_equal(false)
        expect(divergent.first_divergent_stage).to_equal("style")
        expect(divergent.diagnostic.expected_summary).to_contain("color:red")
        expect(divergent.diagnostic.actual_summary).to_contain("color:blue")
        expect(divergent.policy_id).to_equal("semantic-stage-exact")

    it "converts ARGB words and validates stride":
        step("Verify: converts ARGB words and validates stride")
        val descriptor = pixel_format_descriptor(PIXEL_FORMAT_ARGB_U32, PIXEL_ALPHA_STRAIGHT, PIXEL_ORIGIN_TOP_LEFT, PIXEL_COLOR_SPACE_SRGB, 8, 2).unwrap()
        val rgba = argb_u32_to_straight_rgba8([0x80112233u32, 0xffaabbccu32], 2, 1, descriptor).unwrap()
        expect(rgba).to_equal([0x11u8, 0x22u8, 0x33u8, 0x80u8, 0xaau8, 0xbbu8, 0xccu8, 0xffu8])
        expect(pixel_format_descriptor(PIXEL_FORMAT_RGBA8, PIXEL_ALPHA_STRAIGHT, PIXEL_ORIGIN_TOP_LEFT, PIXEL_COLOR_SPACE_SRGB, 7, 2).is_err()).to_equal(true)
        expect(pixel_format_descriptor(PIXEL_FORMAT_RGBA8, PIXEL_ALPHA_STRAIGHT, PIXEL_ORIGIN_TOP_LEFT, "display-p3", 8, 2).is_err()).to_equal(true)
        expect(argb_u32_to_straight_rgba8([0u32], 2, 1, descriptor).is_err()).to_equal(true)
        val invalid = PixelFormatDescriptor(PIXEL_FORMAT_ARGB_U32, "unknown", PIXEL_ORIGIN_TOP_LEFT, PIXEL_COLOR_SPACE_SRGB, 8)
        expect(argb_u32_to_straight_rgba8([0u32, 0u32], 2, 1, invalid).is_err()).to_equal(true)

    it "normalizes BGRA padding bottom-left origin and premultiplied alpha":
        step("Verify: normalizes BGRA padding bottom-left origin and premultiplied alpha")
        val descriptor = pixel_format_descriptor(PIXEL_FORMAT_BGRA8, PIXEL_ALPHA_PREMULTIPLIED, PIXEL_ORIGIN_BOTTOM_LEFT, PIXEL_COLOR_SPACE_SRGB, 8, 1).unwrap()
        val source = [0u8, 0u8, 128u8, 128u8, 9u8, 9u8, 9u8, 9u8, 0u8, 128u8, 0u8, 128u8, 8u8, 8u8, 8u8, 8u8]
        val rgba = byte_pixels_to_straight_rgba8(source, 1, 2, descriptor).unwrap()
        expect(rgba).to_equal([0u8, 255u8, 0u8, 128u8, 255u8, 0u8, 0u8, 128u8])

    it "compares exact and tolerance policies with diagnostics":
        step("Verify: compares exact and tolerance policies with diagnostics")
        val expected = [0u8, 10u8, 20u8, 255u8, 30u8, 40u8, 50u8, 255u8]
        val actual = [0u8, 12u8, 20u8, 255u8, 30u8, 40u8, 60u8, 255u8]
        val exact = compare_rgba8(expected, actual, 2, 1, RENDER_COMPARE_EXACT, 0).unwrap()
        expect(exact.equal).to_equal(false)
        expect(exact.diagnostic.mismatch_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(exact.diagnostic.min_x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(exact.diagnostic.max_x).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(exact.diagnostic.max_channel_delta).to_equal(10)  # oracle: 10 — named expected value from the requirement
        val tolerant = compare_rgba8_with_policy(expected, actual, 2, 1, "chrome", "cpu", "raster", RENDER_COMPARE_CHANNEL_TOLERANCE, "fixture:text-aa", 1, 10, 2).unwrap()
        expect(tolerant.equal).to_equal(true)
        expect(tolerant.status).to_equal("accepted-with-policy")
        expect(tolerant.diagnostic.mismatch_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(tolerant.diagnostic.min_x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(stable_bytes_checksum(expected) == stable_bytes_checksum(expected)).to_equal(true)
        expect(compare_rgba8(expected, actual, 2, 1, "unknown", 0).is_err()).to_equal(true)
        expect(compare_rgba8(expected, actual, 2, 1, RENDER_COMPARE_CHANNEL_TOLERANCE, 10).is_err()).to_equal(true)
        expect(compare_rgba8_with_policy(expected, actual, 2, 1, "chrome", "cpu", "raster", RENDER_COMPARE_CHANNEL_TOLERANCE, "global", 1, 10, 1).is_err()).to_equal(true)

        val pixel_bound_fail = compare_rgba8_with_policy(expected, actual, 2, 1, "chrome", "cpu", "raster", RENDER_COMPARE_CHANNEL_TOLERANCE, "fixture:pixel-bound", 1, 10, 1).unwrap()
        expect(pixel_bound_fail.equal).to_equal(false)
        expect(pixel_bound_fail.status).to_equal("divergent")
        expect(pixel_bound_fail.diagnostic.max_channel_delta).to_equal(10)  # oracle: 10 — named expected value from the requirement

        val channel_bound_fail = compare_rgba8_with_policy(expected, actual, 2, 1, "chrome", "cpu", "raster", RENDER_COMPARE_CHANNEL_TOLERANCE, "fixture:channel-bound", 1, 9, 2).unwrap()
        expect(channel_bound_fail.equal).to_equal(false)
        expect(channel_bound_fail.max_differing_pixels).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(channel_bound_fail.first_divergent_stage).to_equal("raster")

    it "builds canonical output only from complete RGBA data":
        step("Verify: builds canonical output only from complete RGBA data")
        val rgba = [1u8, 2u8, 3u8, 4u8]
        val checksum = stable_bytes_checksum(rgba)
        val output = canonical_render_output("one", "cpu", 1, 1, rgba, checksum).unwrap()
        expect(output.checksum).to_equal(checksum)
        expect(canonical_render_output("one", "cpu", 1, 1, [1u8], checksum).is_err()).to_equal(true)
        expect(rgba8_is_blank([1u8, 2u8, 3u8, 0u8])).to_equal(true)
        expect(rgba8_is_blank([0u8, 0u8, 0u8, 255u8])).to_equal(true)
        expect(rgba8_is_blank([255u8, 255u8, 255u8, 255u8])).to_equal(true)
        expect(rgba8_is_blank([255u8, 0u8, 255u8, 255u8])).to_equal(true)
        expect(rgba8_has_visible_diversity([1u8, 2u8, 3u8, 255u8])).to_equal(true)
        expect(canonical_render_output("one", "cpu", 1, 1, rgba, checksum + 1u64).is_err()).to_equal(true)

    it "retains complete pixel comparison diagnostic paths":
        step("Verify: retains complete pixel comparison diagnostic paths")
        val expected = [1u8, 2u8, 3u8, 255u8]
        val actual = [1u8, 2u8, 4u8, 255u8]
        val result = compare_rgba8_with_policy_and_diagnostics(expected, actual, 1, 1, "chrome", "cpu", "raster", RENDER_COMPARE_CHANNEL_TOLERANCE, "fixture:edge", 1, 1, 1, "expected.json", "actual.json", "diff.png", "bin/simple run parity --case one").unwrap()
        expect(result.diagnostic.expected_evidence_path).to_equal("expected.json")
        expect(result.diagnostic.actual_evidence_path).to_equal("actual.json")
        expect(result.diagnostic.diff_path).to_equal("diff.png")
        expect(result.diagnostic.reproduction_command).to_contain("--case one")
        expect(compare_rgba8_with_policy_and_diagnostics(expected, actual, 1, 1, "chrome", "cpu", "raster", RENDER_COMPARE_CHANNEL_TOLERANCE, "fixture:edge", 1, 1, 1, "", "actual.json", "diff.png", "run").is_err()).to_equal(true)
