"""
## Purpose and audience
Purpose: Prove that DrawIR v3 CPU-reference emission (kernels A-E).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/draw_ir_v3_emit.spl 80%
# @tag: unit, ui, draw_ir, draw_ir_v3, gpu_web

use std.spec
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_KIND_PATH,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_KIND_TEXT,
    DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_SCHEMA_ID,
    DRAW_IR_V3_VERB_LINE,
    DRAW_IR_V3_VERB_MOVE,
    draw_ir_v3_geometry_at,
    draw_ir_v3_glyph_at,
    draw_ir_v3_paint_at,
    draw_ir_v3_path_span_at,
    draw_ir_v3_text_run_at
}
use common.ui.gpu_web_capacity_manifest.{
    GpuWebCapacityManifest,
    gpu_web_capacity_manifest_zero
}
use common.ui.draw_ir_v3_emit.{
    DrawIrV3EmitRequest,
    draw_ir_v3_capacity_plan,
    draw_ir_v3_compact_batch,
    draw_ir_v3_count_records,
    draw_ir_v3_emit,
    draw_ir_v3_emit_item_hide,
    draw_ir_v3_emit_item_path,
    draw_ir_v3_emit_item_rect,
    draw_ir_v3_emit_item_text,
    draw_ir_v3_emit_matches_plan,
    draw_ir_v3_emit_pipeline,
    draw_ir_v3_empty_request,
    draw_ir_v3_exclusive_scan,
    draw_ir_v3_plan_emission,
    draw_ir_v3_verify_capacity
}

# --- fixtures ---------------------------------------------------------------

# A manifest with every bound this lane touches set generously, so a test that
# is not about capacity never trips capacity. Unset bounds stay 0 (fail closed)
# but this lane's plan leaves those requests at 0 too, so they cannot breach.
fn roomy_manifest() -> GpuWebCapacityManifest:
    var m = gpu_web_capacity_manifest_zero()
    m.max_draw_commands = 1024u32
    m.max_glyphs = 4096u32
    m.max_path_points = 4096u32
    m.max_draw_batches = 64u32
    m

# Four items in a deliberate order:
#   0  rect, batch 1, plain fill               -> 1 command
#   1  rect, batch 1, stroked                  -> 2 commands
#   2  text, batch 2, three glyphs             -> 1 command, 1 run, 3 glyphs
#   3  path, batch 1, two points               -> 1 command, 1 span, 2 points
# Total 5 commands. Batch keys run 1,1,1,2,1 across the command sequence, i.e.
# three adjacent runs -- note item 3 shares key 1 with items 0/1 but is NOT
# adjacent to them, so it must form its own batch.
fn mixed_request() -> DrawIrV3EmitRequest:
    var req = draw_ir_v3_empty_request()

    var items = req.items
    items.push(draw_ir_v3_emit_item_rect(101u32, 1u32, 10, 20, 30, 40, 4, 0xff112233u32, 0u32, 0))
    items.push(draw_ir_v3_emit_item_rect(102u32, 1u32, 50, 60, 70, 80, 0, 0xff445566u32, 0xff778899u32, 250))
    items.push(draw_ir_v3_emit_item_text(103u32, 2u32, 9u32, 14000, 5, 18, 0xffaabbccu32, 0, 3))
    items.push(draw_ir_v3_emit_item_path(104u32, 1u32, 0xffddeeffu32, 1u16, 0, 2))
    req.items = items

    var gid = req.glyph_ids
    var gx = req.glyph_xs
    var gy = req.glyph_ys
    var gc = req.glyph_clusters
    gid.push(71u32)
    gid.push(72u32)
    gid.push(73u32)
    gx.push(5)
    gx.push(12)
    gx.push(19)
    gy.push(18)
    gy.push(18)
    gy.push(18)
    gc.push(0)
    gc.push(1)
    gc.push(2)
    req.glyph_ids = gid
    req.glyph_xs = gx
    req.glyph_ys = gy
    req.glyph_clusters = gc

    var px = req.point_xs
    var py = req.point_ys
    var pv = req.point_verbs
    px.push(3)
    px.push(33)
    py.push(4)
    py.push(44)
    pv.push(DRAW_IR_V3_VERB_MOVE)
    pv.push(DRAW_IR_V3_VERB_LINE)
    req.point_xs = px
    req.point_ys = py
    req.point_verbs = pv

    req

describe "DrawIR v3 CPU-reference emission (kernels A-E)":

    # --- Kernel B ---------------------------------------------------------

    it "produces exclusive-prefix offsets, not inclusive ones":
        step("Verify: produces exclusive-prefix offsets, not inclusive ones")
        # @req: REQ-LIB-COMMON-001
        val scan = draw_ir_v3_exclusive_scan([2, 0, 3, 1])
        expect(scan.offsets[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(scan.offsets[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(scan.offsets[2]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(scan.offsets[3]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(scan.total).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "scans an empty count column to an empty offset column and a zero total":
        step("Verify: scans an empty count column to an empty offset column and a zero total")
        val scan = draw_ir_v3_exclusive_scan([])
        expect(scan.offsets.len().to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(scan.total).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "gives every offset the sum of all strictly preceding counts":
        step("Verify: gives every offset the sum of all strictly preceding counts")
        val counts = [4, 1, 0, 0, 7, 2]
        val scan = draw_ir_v3_exclusive_scan(counts)
        var expected = 0
        var i = 0
        while i < 6:
            expect(scan.offsets[i]).to_equal(expected)
            expected = expected + counts[i]
            i = i + 1
        expect(scan.total).to_equal(expected)

    # --- Kernel A ---------------------------------------------------------

    it "counts a stroked rect as two commands and a plain rect as one":
        step("Verify: counts a stroked rect as two commands and a plain rect as one")
        val counts = draw_ir_v3_count_records(mixed_request())
        expect(counts.command_counts[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(counts.command_counts[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(counts.command_counts[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(counts.command_counts[3]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "counts variable-length payloads only for the kinds that own them":
        step("Verify: counts variable-length payloads only for the kinds that own them")
        val counts = draw_ir_v3_count_records(mixed_request())
        expect(counts.glyph_counts[1]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(counts.glyph_counts[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(counts.text_run_counts[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(counts.path_point_counts[2]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(counts.path_point_counts[3]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(counts.path_span_counts[3]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "counts a hidden item as zero records of every kind":
        step("Verify: counts a hidden item as zero records of every kind")
        var req = draw_ir_v3_empty_request()
        var items = req.items
        items.push(draw_ir_v3_emit_item_hide(
            draw_ir_v3_emit_item_text(1u32, 1u32, 9u32, 1000, 0, 0, 0u32, 0, 3)
        ))
        req.items = items
        val counts = draw_ir_v3_count_records(req)
        expect(counts.command_counts[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(counts.text_run_counts[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(counts.glyph_counts[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(counts.batch_upper_bound).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # --- Kernel D ---------------------------------------------------------

    it "emits every record at exactly the offset the scan computed":
        step("Verify: emits every record at exactly the offset the scan computed")
        val req = mixed_request()
        val plan = draw_ir_v3_plan_emission(req)
        expect(plan.commands.total).to_equal(5)  # oracle: 5 — named expected value from the requirement

        val result = draw_ir_v3_emit(req, plan, 77u32, 3u32)
        val scene = result.scene

        # item 0 -> command 0; item 1 -> commands 1,2; item 2 -> 3; item 3 -> 4
        expect(plan.commands.offsets[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.commands.offsets[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(plan.commands.offsets[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(plan.commands.offsets[3]).to_equal(4)  # oracle: 4 — named expected value from the requirement

        expect(scene.commands[0].component_id).to_equal(101u32)
        expect(scene.commands[1].component_id).to_equal(102u32)
        expect(scene.commands[2].component_id).to_equal(102u32)
        expect(scene.commands[3].component_id).to_equal(103u32)
        expect(scene.commands[4].component_id).to_equal(104u32)

        expect(scene.commands[3].kind).to_equal(DRAW_IR_V3_KIND_TEXT)
        expect(scene.commands[4].kind).to_equal(DRAW_IR_V3_KIND_PATH)

    it "keeps geometry and paint rows parallel to the commands that own them":
        step("Verify: keeps geometry and paint rows parallel to the commands that own them")
        val req = mixed_request()
        val plan = draw_ir_v3_plan_emission(req)
        val scene = draw_ir_v3_emit(req, plan, 77u32, 3u32).scene

        val g2 = draw_ir_v3_geometry_at(scene.geometry, scene.commands[2].geometry_id)
        expect(g2.present).to_equal(true)
        expect(g2.x).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(g2.y).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(g2.width).to_equal(70)  # oracle: 70 — named expected value from the requirement
        expect(g2.height).to_equal(80)  # oracle: 80 — named expected value from the requirement

        # command 1 is the fill half of item 1, command 2 the stroke half
        val fill = draw_ir_v3_paint_at(scene.paint, scene.commands[1].paint_id)
        expect(fill.fill_color).to_equal(0xff445566u32)
        expect(fill.stroke_width_milli).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val stroke = draw_ir_v3_paint_at(scene.paint, scene.commands[2].paint_id)
        expect(stroke.stroke_color).to_equal(0xff778899u32)
        expect(stroke.stroke_width_milli).to_equal(250)  # oracle: 250 — named expected value from the requirement

    it "lands the text run and its glyphs at their scanned span":
        step("Verify: lands the text run and its glyphs at their scanned span")
        val req = mixed_request()
        val plan = draw_ir_v3_plan_emission(req)
        val scene = draw_ir_v3_emit(req, plan, 77u32, 3u32).scene

        val run = draw_ir_v3_text_run_at(scene.text_runs, scene.commands[3].text_run_id)
        expect(run.present).to_equal(true)
        expect(run.glyph_start).to_equal(plan.glyphs.offsets[2] as u32)
        expect(run.glyph_count).to_equal(3u32)
        expect(run.baseline_x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(run.color).to_equal(0xffaabbccu32)

        val glyph = draw_ir_v3_glyph_at(scene.text_runs, run.glyph_start + 1u32)
        expect(glyph.present).to_equal(true)
        expect(glyph.glyph_id).to_equal(72u32)
        expect(glyph.x).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(glyph.cluster).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "lands the path span at its scanned span and leaves unused ids absent":
        step("Verify: lands the path span at its scanned span and leaves unused ids absent")
        val req = mixed_request()
        val plan = draw_ir_v3_plan_emission(req)
        val scene = draw_ir_v3_emit(req, plan, 77u32, 3u32).scene

        val span = draw_ir_v3_path_span_at(scene.path_points, scene.commands[4].path_span_id)
        expect(span.present).to_equal(true)
        expect(span.point_start).to_equal(plan.path_points.offsets[3] as u32)
        expect(span.point_count).to_equal(2u32)
        expect(span.fill_rule).to_equal(1u16)

        expect(scene.commands[0].text_run_id).to_equal(DRAW_IR_V3_NO_ID)
        expect(scene.commands[0].path_span_id).to_equal(DRAW_IR_V3_NO_ID)
        expect(scene.commands[3].path_span_id).to_equal(DRAW_IR_V3_NO_ID)

    it "never changes a column length during emission":
        step("Verify: never changes a column length during emission")
        val req = mixed_request()
        val plan = draw_ir_v3_plan_emission(req)
        val result = draw_ir_v3_emit(req, plan, 77u32, 3u32)
        expect(draw_ir_v3_emit_matches_plan(result, plan)).to_equal(true)
        expect(result.scene.commands.len().to_i64()).to_equal(plan.commands.total)
        expect(result.scene.text_runs.glyph_ids.len().to_i64()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(result.scene.path_points.point_xs.len().to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "emits a well-formed empty scene from an empty request":
        step("Verify: emits a well-formed empty scene from an empty request")
        val req = draw_ir_v3_empty_request()
        val plan = draw_ir_v3_plan_emission(req)
        expect(plan.commands.total).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.glyphs.total).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(plan.batch_upper_bound).to_equal(0)  # oracle: 0 — named expected value from the requirement

        val result = draw_ir_v3_emit(req, plan, 5u32, 2u32)
        expect(result.scene.schema_id).to_equal(DRAW_IR_V3_SCHEMA_ID)
        expect(result.scene.scene_id).to_equal(5u32)
        expect(result.scene.commands.len().to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(draw_ir_v3_emit_matches_plan(result, plan)).to_equal(true)

        val compacted = draw_ir_v3_compact_batch(result)
        expect(compacted.kept_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compacted.batch_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compacted.culled_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # --- Kernel C ---------------------------------------------------------

    it "accepts a plan sitting exactly on the capacity bound":
        step("Verify: accepts a plan sitting exactly on the capacity bound")
        val plan = draw_ir_v3_plan_emission(mixed_request())
        var manifest = roomy_manifest()
        manifest.max_draw_commands = plan.commands.total as u32
        manifest.max_glyphs = plan.glyphs.total as u32
        manifest.max_path_points = plan.path_points.total as u32
        manifest.max_draw_batches = plan.batch_upper_bound as u32

        val verdict = draw_ir_v3_verify_capacity(plan, manifest)
        expect(verdict.accepted).to_equal(true)
        expect(verdict.breach_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(verdict.first_breach_bound).to_equal("")

    it "rejects a plan one record over capacity and names the exceeded bound":
        step("Verify: rejects a plan one record over capacity and names the exceeded bound")
        val plan = draw_ir_v3_plan_emission(mixed_request())
        var manifest = roomy_manifest()
        manifest.max_draw_commands = (plan.commands.total - 1) as u32

        val verdict = draw_ir_v3_verify_capacity(plan, manifest)
        expect(verdict.accepted).to_equal(false)
        expect(verdict.breach_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(verdict.first_breach_bound).to_equal("max_draw_commands")
        expect(verdict.breaches[0].requested).to_equal(plan.commands.total)
        expect(verdict.breaches[0].limit).to_equal(plan.commands.total - 1)
        expect(verdict.breaches[0].overflow).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "names the glyph bound when glyphs are what overflow":
        step("Verify: names the glyph bound when glyphs are what overflow")
        val plan = draw_ir_v3_plan_emission(mixed_request())
        var manifest = roomy_manifest()
        manifest.max_glyphs = 2u32

        val verdict = draw_ir_v3_verify_capacity(plan, manifest)
        expect(verdict.accepted).to_equal(false)
        expect(verdict.first_breach_bound).to_equal("max_glyphs")

    it "requests zero against bounds this lane does not use":
        step("Verify: requests zero against bounds this lane does not use")
        val capacity_plan = draw_ir_v3_capacity_plan(draw_ir_v3_plan_emission(mixed_request()))
        expect(capacity_plan.draw_commands).to_equal(5u32)
        expect(capacity_plan.nodes).to_equal(0u32)
        expect(capacity_plan.css_rules).to_equal(0u32)
        expect(capacity_plan.layout_boxes).to_equal(0u32)

    # --- Kernel E ---------------------------------------------------------

    it "batches adjacent commands sharing a key and preserves draw order":
        step("Verify: batches adjacent commands sharing a key and preserves draw order")
        val req = mixed_request()
        val plan = draw_ir_v3_plan_emission(req)
        val compacted = draw_ir_v3_compact_batch(draw_ir_v3_emit(req, plan, 1u32, 1u32))

        expect(compacted.kept_count).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(compacted.culled_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

        # keys along the command sequence are 1,1,1,2,1 -> three adjacent runs.
        # The trailing key-1 command must NOT be merged back into the leading
        # key-1 run: that would move it in front of the text command.
        expect(compacted.batch_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(compacted.batches[0].batch_key).to_equal(1u32)
        expect(compacted.batches[0].first_command).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compacted.batches[0].command_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(compacted.batches[1].batch_key).to_equal(2u32)
        expect(compacted.batches[1].first_command).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(compacted.batches[1].command_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(compacted.batches[2].batch_key).to_equal(1u32)
        expect(compacted.batches[2].first_command).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(compacted.batches[2].command_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

        # kept indices are strictly increasing and concatenating the batches in
        # order reproduces the kept sequence
        var i = 1
        while i < compacted.kept_count:
            expect(compacted.kept[i] > compacted.kept[i - 1]).to_equal(true)
            i = i + 1

    it "culls a degenerate rect while leaving the surviving order intact":
        step("Verify: culls a degenerate rect while leaving the surviving order intact")
        var req = draw_ir_v3_empty_request()
        var items = req.items
        items.push(draw_ir_v3_emit_item_rect(1u32, 5u32, 0, 0, 10, 10, 0, 0xff000001u32, 0u32, 0))
        items.push(draw_ir_v3_emit_item_rect(2u32, 5u32, 0, 0, 0, 10, 0, 0xff000002u32, 0u32, 0))
        items.push(draw_ir_v3_emit_item_rect(3u32, 5u32, 0, 0, 10, 10, 0, 0xff000003u32, 0u32, 0))
        req.items = items

        val plan = draw_ir_v3_plan_emission(req)
        val result = draw_ir_v3_emit(req, plan, 1u32, 1u32)
        val compacted = draw_ir_v3_compact_batch(result)

        expect(compacted.kept_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(compacted.culled_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(compacted.kept[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compacted.kept[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result.scene.commands[compacted.kept[0]].component_id).to_equal(1u32)
        expect(result.scene.commands[compacted.kept[1]].component_id).to_equal(3u32)
        # the cull does not split the batch: both survivors still share key 5
        expect(compacted.batch_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(compacted.batches[0].command_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

    # --- whole pipeline ---------------------------------------------------

    it "runs A-E end to end and reports emission":
        step("Verify: runs A-E end to end and reports emission")
        val outcome = draw_ir_v3_emit_pipeline(mixed_request(), roomy_manifest(), 9u32, 1u32)
        expect(outcome.emitted).to_equal(true)
        expect(outcome.verdict.accepted).to_equal(true)
        expect(outcome.result.scene.commands.len().to_i64()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(outcome.compacted.batch_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(draw_ir_v3_emit_matches_plan(outcome.result, outcome.plan)).to_equal(true)

    it "emits nothing at all when capacity verification rejects":
        step("Verify: emits nothing at all when capacity verification rejects")
        var manifest = roomy_manifest()
        manifest.max_draw_commands = 2u32
        val outcome = draw_ir_v3_emit_pipeline(mixed_request(), manifest, 9u32, 1u32)

        expect(outcome.emitted).to_equal(false)
        expect(outcome.verdict.accepted).to_equal(false)
        expect(outcome.verdict.first_breach_bound).to_equal("max_draw_commands")
        # the scan still reports what WOULD have been needed
        expect(outcome.plan.commands.total).to_equal(5)  # oracle: 5 — named expected value from the requirement
        # ...but no partial scene is produced
        expect(outcome.result.scene.commands.len().to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(outcome.compacted.kept_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
