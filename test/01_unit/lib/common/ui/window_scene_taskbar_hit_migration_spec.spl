# Equivalence proof for the taskbar hit-dispatch migration
# (doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md,
# decision D1). `_shared_wm_taskbar_dispatch` in window_scene.spl used to pick
# a taskbar slot via manual `x / slot_w` arithmetic; it now builds a one-batch
# DrawIrComposition of 56px slot rects and resolves the point through
# draw_ir_hit_bridge.draw_ir_hit_forest + hit_test.hit_stack (the SAME
# interaction core panel2d and the draw_ir_hit_bridge specs already use).
#
# This spec walks every slot boundary (56px pinned/running columns, half-open
# per the core's bounds convention) through the ONLY public entry point,
# shared_wm_dispatch_pointer, and asserts the exact action strings the old
# arithmetic produced -- proving the swap is behavior-preserving at the
# boundaries where a mechanism change would first show up as an off-by-one.

use std.spec
use common.ui.builder.{column, label, build_tree_with_title}
use common.ui.taskbar_model.{AppRef, TaskbarModel, WindowRef}
use common.ui.window.{WindowManager}
use common.ui.window_surface_registry.{UiWindowSurfaceRegistry, UI_SURFACE_KIND_SIMPLE_WEB}
use common.ui.window_scene.{shared_wm_dispatch_pointer, shared_wm_scene_from_window_manager}

fn _tree(title: text):
    build_tree_with_title(column("{title}_root", [label("{title}_label", title)]), title, "glass_dark")

# 2 pinned slots (columns 0 and 1) + 1 running slot (column 2). Matches the
# shared `_taskbar()` fixture shape used by window_scene_spec.spl.
fn _hit_taskbar() -> TaskbarModel:
    TaskbarModel(
        pinned: [
            AppRef(app_id: "terminal", display_name: "Terminal", icon: "term"),
            AppRef(app_id: "browser", display_name: "Browser", icon: "browser")
        ],
        running: [
            WindowRef(window_id: "win1", app_id: "demo.app", title: "Window One", minimized: false)
        ],
        tray: []
    )

fn _hit_scene():
    var manager = WindowManager.new()
    val _one = manager.open_window("surf1", "One", 10, 40, 300, 200, _tree("one"))
    var registry = UiWindowSurfaceRegistry.new()
    registry.bind_with_kind("win1", "surf1", 42u64, "demo.app", "Window One", UI_SURFACE_KIND_SIMPLE_WEB)
    shared_wm_scene_from_window_manager(manager, registry, 800, 600)

describe "SharedWmScene taskbar hit-forest migration equivalence":

    it "hits pinned slot 0 across its whole 56px column, not past it":
        val scene = _hit_scene()
        val taskbar = _hit_taskbar()
        val at_left_edge = shared_wm_dispatch_pointer(scene, taskbar, 0, 575, "left", "down", 1000, "09:41", 2)
        val at_right_edge = shared_wm_dispatch_pointer(scene, taskbar, 55, 575, "left", "down", 1000, "09:41", 2)
        expect(at_left_edge.action).to_equal("launch_app")
        expect(at_left_edge.app_id).to_equal("terminal")
        expect(at_right_edge.action).to_equal("launch_app")
        expect(at_right_edge.app_id).to_equal("terminal")

    it "hits pinned slot 1 starting exactly at the 56px boundary":
        val scene = _hit_scene()
        val taskbar = _hit_taskbar()
        val at_boundary = shared_wm_dispatch_pointer(scene, taskbar, 56, 575, "left", "down", 1000, "09:41", 2)
        val at_right_edge = shared_wm_dispatch_pointer(scene, taskbar, 111, 575, "left", "down", 1000, "09:41", 2)
        expect(at_boundary.action).to_equal("launch_app")
        expect(at_boundary.app_id).to_equal("browser")
        expect(at_right_edge.action).to_equal("launch_app")
        expect(at_right_edge.app_id).to_equal("browser")

    it "hits the running-window slot 2 and focuses the existing window":
        val scene = _hit_scene()
        val taskbar = _hit_taskbar()
        val at_boundary = shared_wm_dispatch_pointer(scene, taskbar, 112, 575, "left", "down", 1000, "09:41", 2)
        val at_right_edge = shared_wm_dispatch_pointer(scene, taskbar, 167, 575, "left", "down", 1000, "09:41", 2)
        expect(at_boundary.action).to_equal("focus_window")
        expect(at_boundary.window_id).to_equal("win1")
        expect(at_right_edge.action).to_equal("focus_window")
        expect(at_right_edge.window_id).to_equal("win1")

    it "falls through to taskbar_empty exactly past the last slot's right edge":
        val scene = _hit_scene()
        val taskbar = _hit_taskbar()
        val past_last_slot = shared_wm_dispatch_pointer(scene, taskbar, 168, 575, "left", "down", 1000, "09:41", 2)
        expect(past_last_slot.action).to_equal("taskbar_empty")

    it "right-click on a pinned slot unpins it; right-click on a running slot pins it":
        val scene = _hit_scene()
        val taskbar = _hit_taskbar()
        val unpin = shared_wm_dispatch_pointer(scene, taskbar, 0, 575, "right", "down", 1000, "09:41", 2)
        val pin = shared_wm_dispatch_pointer(scene, taskbar, 112, 575, "right", "down", 1000, "09:41", 2)
        expect(unpin.action).to_equal("unpin_app")
        expect(unpin.app_id).to_equal("terminal")
        expect(pin.action).to_equal("pin_app")
        expect(pin.app_id).to_equal("demo.app")
        expect(pin.window_id).to_equal("win1")

    it "reports taskbar_empty when there are no pinned or running apps at all":
        val scene = _hit_scene()
        val empty_taskbar = TaskbarModel(pinned: [], running: [], tray: [])
        val clicked = shared_wm_dispatch_pointer(scene, empty_taskbar, 0, 575, "left", "down", 1000, "09:41", 2)
        expect(clicked.action).to_equal("taskbar_empty")
