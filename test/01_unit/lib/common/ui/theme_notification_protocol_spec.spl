# @cover src/lib/common/ui/theme_notification_protocol.spl
# @tag: unit, ui, theme, notification, protocol

use std.spec.*
use common.ui.theme_notification_protocol.*

extern fn rt_array_data_ptr(array: [u8]) -> i64
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64

val SOURCE_HASH: text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val MATERIAL_HASH: text = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

var _fake_payload_copies: [[u8]] = []
var _fake_destinations: [u64] = []
var _fake_source_port: u64 = 0u64
var _fake_method: u32 = 0u32
var _fake_flags: u32 = 0u32

fn _reset_fake_transport():
    _fake_payload_copies = []
    _fake_destinations = []
    _fake_source_port = 0u64
    _fake_method = 0u32
    _fake_flags = 0u32

fn _copying_fake_send(source_port: u64, destination_port: u64, method: u32, flags: u32, payload_addr: u64, payload_len: u64) -> i64:
    # This is the host-adapter contract: copy synchronously, store/queue only
    # the owned copy, and never retain `payload_addr`.
    var owned_copy: [u8] = []
    var i: u64 = 0u64
    while i < payload_len:
        owned_copy = owned_copy.push(spl_load_u8(payload_addr.to_i64(), i.to_i64()).to_u8())
        i = i + 1u64
    _fake_payload_copies = _fake_payload_copies.push(owned_copy)
    _fake_destinations = _fake_destinations.push(destination_port)
    _fake_source_port = source_port
    _fake_method = method
    _fake_flags = flags
    if destination_port == 11u64:
        return THEME_NOTIFICATION_STATUS_OK
    if destination_port == 12u64:
        return THEME_NOTIFICATION_STATUS_STALE
    if destination_port == 13u64:
        return THEME_NOTIFICATION_STATUS_RETRYABLE
    if destination_port == 14u64:
        return THEME_NOTIFICATION_STATUS_DENIED
    99

fn _valid_message() -> ThemeChangedV1:
    ThemeChangedV1(
        canonical_theme_id: "dark",
        source_manifest_sha256: SOURCE_HASH,
        material_sha256: MATERIAL_HASH,
        revision: 42u64
    )

fn _valid_payload() -> [u8]:
    match theme_changed_v1_encode(_valid_message()):
        Err(error):
            expect(error).to_equal("")
            []
        Ok(bytes):
            bytes

fn _repeat_text(unit: text, count: i64) -> text:
    var out = ""
    var i = 0
    while i < count:
        out = out + unit
        i = i + 1
    out

fn _expect_decode_error(bytes: [u8]):
    match theme_changed_v1_decode(bytes):
        Ok(message):
            expect(message.canonical_theme_id).to_equal("")
        Err(error):
            expect(error == "").to_equal(false)

fn _expect_encode_error(message: ThemeChangedV1):
    match theme_changed_v1_encode(message):
        Ok(bytes):
            expect(bytes.len()).to_equal(0)
        Err(error):
            expect(error == "").to_equal(false)

describe "theme changed v1 canonical codec":

    it "round-trips bounded UTF-8 identity, exact hashes, and LE revision":
        val payload = _valid_payload()
        expect(payload.len()).to_equal(THEME_CHANGED_V1_FIXED_BYTES + 4)
        expect(payload[0]).to_equal(4u8)
        expect(payload[1]).to_equal(0u8)
        expect(payload[2]).to_equal(0u8)
        expect(payload[3]).to_equal(0u8)
        expect(payload[4]).to_equal(THEME_CHANGED_V1_VERSION)
        expect(payload[payload.len() - 8]).to_equal(42u8)
        expect(payload[payload.len() - 7]).to_equal(0u8)

        match theme_changed_v1_decode(payload):
            Err(error):
                expect(error).to_equal("")
            Ok(message):
                expect(message.canonical_theme_id).to_equal("dark")
                expect(message.source_manifest_sha256).to_equal(SOURCE_HASH)
                expect(message.material_sha256).to_equal(MATERIAL_HASH)
                expect(message.revision).to_equal(42u64)

    it "rejects wrong method, version, trailing, oversized, malformed UTF-8, hashes, and zero revision":
        var wrong_method = _valid_payload()
        wrong_method[0] = 5u8
        _expect_decode_error(wrong_method)

        var wrong_version = _valid_payload()
        wrong_version[4] = 2u8
        _expect_decode_error(wrong_version)

        var trailing = _valid_payload()
        trailing = trailing.push(0u8)
        _expect_decode_error(trailing)

        val oversized: [u8] = [0u8; THEME_CHANGED_V1_MAX_PAYLOAD_BYTES + 1]
        _expect_decode_error(oversized)

        var malformed_id = _valid_payload()
        malformed_id[7] = 255u8
        _expect_decode_error(malformed_id)

        var malformed_source_hash = _valid_payload()
        malformed_source_hash[7 + 4] = 65u8
        _expect_decode_error(malformed_source_hash)

        var malformed_material_hash = _valid_payload()
        malformed_material_hash[7 + 4 + THEME_CHANGED_V1_HASH_BYTES] = 71u8
        _expect_decode_error(malformed_material_hash)

        var zero_revision = _valid_payload()
        var i = zero_revision.len() - 8
        while i < zero_revision.len():
            zero_revision[i] = 0u8
            i = i + 1
        _expect_decode_error(zero_revision)

    it "rejects noncanonical ids, non-lowercase hashes, and zero revision before encoding":
        _expect_encode_error(ThemeChangedV1(
            canonical_theme_id: " dark ",
            source_manifest_sha256: SOURCE_HASH,
            material_sha256: MATERIAL_HASH,
            revision: 1u64
        ))
        _expect_encode_error(ThemeChangedV1(
            canonical_theme_id: "dark",
            source_manifest_sha256: "Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            material_sha256: MATERIAL_HASH,
            revision: 1u64
        ))
        _expect_encode_error(ThemeChangedV1(
            canonical_theme_id: "dark",
            source_manifest_sha256: SOURCE_HASH,
            material_sha256: MATERIAL_HASH,
            revision: 0u64
        ))
        _expect_encode_error(ThemeChangedV1(
            canonical_theme_id: _repeat_text("x", THEME_CHANGED_V1_MAX_ID_BYTES + 1),
            source_manifest_sha256: SOURCE_HASH,
            material_sha256: MATERIAL_HASH,
            revision: 1u64
        ))

describe "theme notification injected transport policy":

    it "copies before return, attempts every unique subscriber, and classifies every status":
        _reset_fake_transport()
        var payload = _valid_payload()
        val original_method_byte = payload[0]
        val transport = ThemeNotificationTransport(
            source_port: 77u64,
            send_payload_fn: _copying_fake_send
        )
        val result = theme_notification_send_all(
            transport,
            [11u64, 12u64, 11u64, 13u64, 14u64, 15u64],
            rt_array_data_ptr(payload).to_u64(),
            payload.len().to_u64()
        )

        match result:
            Err(error):
                expect(error).to_equal("")
            Ok(report):
                expect(report.attempted_ports.len()).to_equal(5)
                expect(report.statuses.len()).to_equal(5)
                expect(report.delivered_ports[0]).to_equal(11u64)
                expect(report.stale_ports[0]).to_equal(12u64)
                expect(report.retryable_ports[0]).to_equal(13u64)
                expect(report.denied_ports[0]).to_equal(14u64)
                expect(report.unknown_failure_ports[0]).to_equal(15u64)

        expect(_fake_destinations.len()).to_equal(5)
        expect(_fake_destinations[0]).to_equal(11u64)
        expect(_fake_destinations[1]).to_equal(12u64)
        expect(_fake_destinations[2]).to_equal(13u64)
        expect(_fake_destinations[3]).to_equal(14u64)
        expect(_fake_destinations[4]).to_equal(15u64)
        expect(_fake_source_port).to_equal(77u64)
        expect(_fake_method).to_equal(THEME_CHANGED_V1_METHOD)
        expect(_fake_flags).to_equal(THEME_NOTIFICATION_SEND_ASYNC)

        # Mutation after send cannot affect any fake queued payload because the
        # callback retained only its synchronous copy.
        payload[0] = 99u8
        expect(_fake_payload_copies.len()).to_equal(5)
        expect(_fake_payload_copies[0][0]).to_equal(original_method_byte)
        expect(_fake_payload_copies[4][0]).to_equal(original_method_byte)
