# @cover src/lib/common/ui/wm_window_state.spl 20%
use std.spec.*
use common.ui.wm_window_state.*

describe "WM window lifecycle state":
    it "restores the state held before minimization":
        val minimized_normal = wm_window_state_minimize(WM_WINDOW_STATE_NORMAL)
        expect(wm_window_state_restore(
            minimized_normal,
            wm_window_state_before_minimize(WM_WINDOW_STATE_NORMAL)
        )).to_equal(WM_WINDOW_STATE_NORMAL)

        val minimized_maximized = wm_window_state_minimize(WM_WINDOW_STATE_MAXIMIZED)
        expect(wm_window_state_restore(
            minimized_maximized,
            wm_window_state_before_minimize(WM_WINDOW_STATE_MAXIMIZED)
        )).to_equal(WM_WINDOW_STATE_MAXIMIZED)

    it "rejects input while minimized or closing":
        expect(wm_window_state_accepts_input(WM_WINDOW_STATE_NORMAL)).to_be(true)
        expect(wm_window_state_accepts_input(WM_WINDOW_STATE_MAXIMIZED)).to_be(true)
        expect(wm_window_state_accepts_input(WM_WINDOW_STATE_MINIMIZED)).to_be(false)
        val closing = wm_window_state_begin_close(WM_WINDOW_STATE_NORMAL)
        expect(closing).to_equal(WM_WINDOW_STATE_CLOSING)
        expect(wm_window_state_accepts_input(closing)).to_be(false)
        expect(wm_window_state_finish_close(closing)).to_equal(WM_WINDOW_STATE_CLOSED)
