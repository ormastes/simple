"""
## Purpose and audience
Purpose: Prove that draw_ir_v2_to_v3 (typed v2 -> v3 adapter).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/draw_ir_v2_to_v3.spl 80%
# @tag: unit, ui, draw_ir, draw_ir_v3, unified_packed_ui_scene, l3

use std.spec
use common.ui.draw_ir.{
    DrawIrPoint,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_edge_command,
    draw_ir_embedding_config,
    draw_ir_glyph_run_payload,
    draw_ir_group_command,
    draw_ir_image_command,
    draw_ir_no_rect,
    draw_ir_path_command,
    draw_ir_point,
    draw_ir_port_command,
    draw_ir_rect,
    draw_ir_rect_bounds,
    draw_ir_rect_clipped,
    draw_ir_style_prop,
    draw_ir_text,
    draw_ir_text_styled,
    draw_edge
}
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_KIND_EDGE,
    DRAW_IR_V3_KIND_GROUP,
    DRAW_IR_V3_KIND_IMAGE,
    DRAW_IR_V3_KIND_PATH,
    DRAW_IR_V3_KIND_PORT,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_KIND_TEXT,
    DRAW_IR_V3_NO_ID,
    draw_ir_v3_clip_at,
    draw_ir_v3_geometry_at,
    draw_ir_v3_glyph_at,
    draw_ir_v3_hit_shape_at,
    draw_ir_v3_paint_at,
    draw_ir_v3_resource_at,
    draw_ir_v3_text_run_at,
    draw_ir_v3_transform_at
}
use common.ui.draw_ir_v2_to_v3.{draw_ir_v2_to_v3}

# --- fixture helpers ---------------------------------------------------------

fn _single_batch_composition(embedding_x: i32, embedding_y: i32, width: i32, height: i32, clip: bool, opacity_milli: i32, commands: [DrawIrCommand]):
    val embedding = draw_ir_embedding_config("surf", "root", embedding_x, embedding_y, width, height, 0, opacity_milli, clip)
    val batch = draw_ir_batch("batch-a", "cpu", embedding, commands)
    draw_ir_composition("comp-a", "key-a", "cpu", [batch])

describe "draw_ir_v2_to_v3 (typed v2 -> v3 adapter)":

    it "maps a plain RECT command's geometry, paint and component id":
        step("Verify: maps a plain RECT command's geometry, paint and component id")
        # @req: REQ-LIB-COMMON-001
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [
            draw_ir_rect("r1", 10, 20, 30, 40, 0xFFAABBCCu32)
        ])
        val scene = draw_ir_v2_to_v3(composition)
        # commands[0] is the synthesized batch GROUP; commands[1] is the rect.
        expect(scene.commands.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val cmd = scene.commands[1]
        expect(cmd.kind).to_equal(DRAW_IR_V3_KIND_RECT)
        val geom = draw_ir_v3_geometry_at(scene.geometry, cmd.geometry_id)
        expect(geom.present).to_equal(true)
        expect(geom.x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(geom.y).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(geom.width).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(geom.height).to_equal(40)  # oracle: 40 — named expected value from the requirement
        val paint = draw_ir_v3_paint_at(scene.paint, cmd.paint_id)
        expect(paint.present).to_equal(true)
        expect(paint.fill_color).to_equal(0xFFAABBCCu32)

    it "maps a TEXT command's baseline, color and glyph run":
        step("Verify: maps a TEXT command's baseline, color and glyph run")
        val glyphs = draw_ir_glyph_run_payload([7u32, 8u32], [1, 2], [3, 4], [100, 200], true)
        var text_cmd = draw_ir_text("t1", 5, 6, "hi", 0xFF112233u32)
        text_cmd.glyph_run = glyphs
        text_cmd.computed_style = [draw_ir_style_prop("font-size", "12")]
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [text_cmd])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.kind).to_equal(DRAW_IR_V3_KIND_TEXT)
        val run = draw_ir_v3_text_run_at(scene.text_runs, cmd.text_run_id)
        expect(run.present).to_equal(true)
        expect(run.baseline_x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(run.baseline_y).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(run.color).to_equal(0xFF112233u32)
        expect(run.font_size_milli).to_equal(12000)  # oracle: 12000 — named expected value from the requirement
        expect(run.glyph_count).to_equal(2u32)
        val g0 = draw_ir_v3_glyph_at(scene.text_runs, run.glyph_start)
        expect(g0.present).to_equal(true)
        expect(g0.glyph_id).to_equal(7u32)
        expect(g0.x).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(g0.y).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "maps an IMAGE command's geometry and resource content hash":
        step("Verify: maps an IMAGE command's geometry and resource content hash")
        val img_cmd = draw_ir_image_command("i1", 1, 2, 16, 8, "image://asset-a", [])
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [img_cmd])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.kind).to_equal(DRAW_IR_V3_KIND_IMAGE)
        val geom = draw_ir_v3_geometry_at(scene.geometry, cmd.geometry_id)
        expect(geom.width).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(geom.height).to_equal(8)  # oracle: 8 — named expected value from the requirement
        val res = draw_ir_v3_resource_at(scene.resources, cmd.image_resource_id)
        expect(res.present).to_equal(true)
        expect(res.width).to_equal(16u32)
        expect(res.height).to_equal(8u32)

    it "de-duplicates repeated IMAGE resource URIs into one RESOURCES row":
        step("Verify: de-duplicates repeated IMAGE resource URIs into one RESOURCES row")
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [
            draw_ir_image_command("i1", 0, 0, 4, 4, "image://shared", []),
            draw_ir_image_command("i2", 4, 0, 4, 4, "image://shared", [])
        ])
        val scene = draw_ir_v2_to_v3(composition)
        val a = scene.commands[1]
        val b = scene.commands[2]
        expect(a.image_resource_id).to_equal(b.image_resource_id)
        expect(scene.resources.kinds.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "maps a PATH command's points into PATH_POINTS/PATH_SPANS":
        step("Verify: maps a PATH command's points into PATH_POINTS/PATH_SPANS")
        val points = [draw_ir_point(0, 0), draw_ir_point(10, 0), draw_ir_point(10, 10)]
        val path_cmd = draw_ir_path_command("p1", points, [])
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [path_cmd])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.kind).to_equal(DRAW_IR_V3_KIND_PATH)
        expect(cmd.path_span_id).to_not_equal(DRAW_IR_V3_NO_ID)
        expect(scene.path_points.point_xs.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(scene.path_points.point_xs[1]).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "maps an EDGE command's points the same way as PATH (shared point vocabulary)":
        step("Verify: maps an EDGE command's points the same way as PATH (shared point vocabulary)")
        val edge = draw_edge("e1", "a", "b", "straight", [draw_ir_point(0, 0), draw_ir_point(5, 5)], [])
        val edge_cmd = draw_ir_edge_command(edge)
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [edge_cmd])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.kind).to_equal(DRAW_IR_V3_KIND_EDGE)
        expect(cmd.path_span_id).to_not_equal(DRAW_IR_V3_NO_ID)

    it "maps a PORT command with a fail-closed (unresolved) surface reference":
        step("Verify: maps a PORT command with a fail-closed (unresolved) surface reference")
        val port_cmd = draw_ir_port_command("port1", "", 12, 14)
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [port_cmd])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.kind).to_equal(DRAW_IR_V3_KIND_PORT)
        # v2 carries no live surface registry, so the adapter leaves the
        # resource reference unresolved (NO_ID) rather than fabricating one --
        # the resolver's fail-closed PORT_UNAVAILABLE path (design section 4.2)
        # depends on exactly this.
        expect(cmd.image_resource_id).to_equal(DRAW_IR_V3_NO_ID)

    it "maps a clip_rect to a CLIPS row and sets the CLIPPED flag":
        step("Verify: maps a clip_rect to a CLIPS row and sets the CLIPPED flag")
        val clipped = draw_ir_rect_clipped("r1", 0, 0, 50, 50, 0xFFFFFFFFu32, draw_ir_rect_bounds(5, 5, 10, 10))
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [clipped])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.clip_id).to_not_equal(DRAW_IR_V3_NO_ID)
        val clip = draw_ir_v3_clip_at(scene.clips, cmd.clip_id)
        expect(clip.present).to_equal(true)
        expect(clip.x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(clip.width).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "maps a hit_rect to a HIT_SHAPES row owned by the command's own id":
        step("Verify: maps a hit_rect to a HIT_SHAPES row owned by the command's own id")
        var cmd_v2 = draw_ir_rect("r1", 0, 0, 20, 20, 0xFF000000u32)
        cmd_v2.hit_rect = draw_ir_rect_bounds(0, 0, 20, 20)
        val composition = _single_batch_composition(0, 0, 100, 100, false, 1000, [cmd_v2])
        val scene = draw_ir_v2_to_v3(composition)
        val cmd = scene.commands[1]
        expect(cmd.hit_shape_id).to_not_equal(DRAW_IR_V3_NO_ID)
        val shape = draw_ir_v3_hit_shape_at(scene.hit_shapes, cmd.hit_shape_id)
        expect(shape.present).to_equal(true)
        expect(shape.component_id).to_equal(cmd.component_id)

    it "synthesizes one v3 GROUP per v2 batch carrying its embedding transform":
        step("Verify: synthesizes one v3 GROUP per v2 batch carrying its embedding transform")
        val composition = _single_batch_composition(40, 30, 160, 100, true, 1000, [
            draw_ir_rect("r1", 0, 0, 10, 10, 0xFFFFFFFFu32)
        ])
        val scene = draw_ir_v2_to_v3(composition)
        val group = scene.commands[0]
        expect(group.kind).to_equal(DRAW_IR_V3_KIND_GROUP)
        expect(group.parent_id).to_equal(DRAW_IR_V3_NO_ID)
        val transform = draw_ir_v3_transform_at(scene.transforms, group.transform_id)
        expect(transform.present).to_equal(true)
        # dx/dy are plain pixel offsets in the transform table, not milli-scaled
        # (only m11/m12/m21/m22 use the milli fixed-point convention).
        expect(transform.dx).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(transform.dy).to_equal(30)  # oracle: 30 — named expected value from the requirement
        val clip = draw_ir_v3_clip_at(scene.clips, group.clip_id)
        expect(clip.present).to_equal(true)
        expect(clip.width).to_equal(160)  # oracle: 160 — named expected value from the requirement
        expect(clip.height).to_equal(100)  # oracle: 100 — named expected value from the requirement
        val rect = scene.commands[1]
        expect(rect.parent_id).to_equal(group.component_id)

    it "leaves a zero-offset, unclipped batch's GROUP transform/clip absent (no spurious rows)":
        step("Verify: leaves a zero-offset, unclipped batch's GROUP transform/clip absent (no spurious rows)")
        val composition = _single_batch_composition(0, 0, 50, 50, false, 1000, [
            draw_ir_rect("r1", 0, 0, 10, 10, 0xFFFFFFFFu32)
        ])
        val scene = draw_ir_v2_to_v3(composition)
        val group = scene.commands[0]
        expect(group.transform_id).to_equal(DRAW_IR_V3_NO_ID)
        expect(group.clip_id).to_equal(DRAW_IR_V3_NO_ID)

    it "maps an in-batch v2 GROUP command as a parent-chain anchor":
        step("Verify: maps an in-batch v2 GROUP command as a parent-chain anchor")
        val inner_group = draw_ir_group_command("g1", "")
        var child = draw_ir_rect("r1", 1, 1, 5, 5, 0xFF00FF00u32)
        child.parent_id = "g1"
        val composition = _single_batch_composition(0, 0, 50, 50, false, 1000, [inner_group, child])
        val scene = draw_ir_v2_to_v3(composition)
        # commands[0] = batch group, [1] = inner v2 group, [2] = child rect.
        val inner = scene.commands[1]
        expect(inner.kind).to_equal(DRAW_IR_V3_KIND_GROUP)
        expect(inner.parent_id).to_equal(scene.commands[0].component_id)
        val rect = scene.commands[2]
        expect(rect.parent_id).to_equal(inner.component_id)

    it "keeps each command's component id stable and unique across a composition":
        step("Verify: keeps each command's component id stable and unique across a composition")
        val composition = _single_batch_composition(0, 0, 50, 50, false, 1000, [
            draw_ir_rect("r1", 0, 0, 5, 5, 0xFFFFFFFFu32),
            draw_ir_rect("r2", 5, 0, 5, 5, 0xFFFFFFFFu32)
        ])
        val scene = draw_ir_v2_to_v3(composition)
        expect(scene.commands[1].component_id).to_not_equal(scene.commands[2].component_id)
