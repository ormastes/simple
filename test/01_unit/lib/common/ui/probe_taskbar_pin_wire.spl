use common.ui.taskbar_pin_wire.{
    taskbar_pin_wire_app_id,
    taskbar_pin_wire_display_name,
    taskbar_pin_wire_icon,
    taskbar_pin_wire_line,
    taskbar_pin_wire_line_valid,
}

fn main() -> i64:
    val line = taskbar_pin_wire_line(
        "/sys/apps/demo", "Demo App", "D"
    )
    if not taskbar_pin_wire_line_valid(line):
        return 1
    if taskbar_pin_wire_app_id(line) != "/sys/apps/demo":
        return 2
    if taskbar_pin_wire_display_name(line) != "Demo App":
        return 3
    if taskbar_pin_wire_icon(line) != "D":
        return 4
    if taskbar_pin_wire_line("bad|id", "Demo", "D") != "":
        return 5
    if taskbar_pin_wire_line_valid("missing|field"):
        return 6
    0
