# @cover src/lib/common/ui/host_env_contract.spl 100%

use std.spec.*
use common.ui.host_env_contract.{
    HostCapabilityRow,
    RenderPipelineReceipt,
    TestHostEnv,
    host_display_input_evidence_passes,
    host_readback_evidence_passes,
    host_renderdoc_evidence_passes,
    host_simd_evidence_passes,
    host_vulkan_evidence_passes,
    host_x86_simd_evidence_passes
}

fn row(name: text, status: text, reason: text = "", resume: text = "") -> HostCapabilityRow:
    HostCapabilityRow.create(name, status, reason, "build/evidence/" + name + ".txt", resume)

fn complete_env() -> TestHostEnv:
    TestHostEnv.create([
        row("x86_simd", "pass"),
        row("arm_simd", "blocked", "arm-host-required", "bin/simple test-host-env --row arm_simd"),
        row("riscv_simd", "blocked", "riscv-host-required", "bin/simple test-host-env --row riscv_simd"),
        row("vulkan", "pass"),
        row("renderdoc", "pass"),
        row("display_input", "pass"),
        row("framebuffer_readback", "pass")
    ])

fn receipt(
    event_id: i64 = 7,
    frame_id: i64 = 7,
    backend: text = "vulkan",
    handle: i64 = 41,
    completed: bool = true,
    source: text = "device_readback",
    width: i32 = 64,
    height: i32 = 48,
    stride: i32 = 256,
    checksum: i64 = 99,
    nonblank: i64 = 12,
    fallback: bool = false
) -> RenderPipelineReceipt:
    RenderPipelineReceipt.create(
        event_id, frame_id, 3, backend, handle, completed, source,
        width, height, stride, "argb8888", checksum, nonblank, fallback
    )

