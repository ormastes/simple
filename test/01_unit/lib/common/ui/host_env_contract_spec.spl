        "rdoc_simple_gate_scene=vulkan-engine2d\n" +
        "rdoc_simple_gate_capture_status=pass\n" +
        "rdoc_simple_gate_capture_file=/tmp/frame.rdc\n" +
        "rdoc_simple_gate_capture_file_status=pass\n" +
        "rdoc_simple_gate_capture_magic=RDOC\n" +
        "rdoc_simple_gate_capture_file_magic=RDOC\n" +
        "rdoc_simple_gate_runtime_backend=vulkan\n" +
        "rdoc_simple_gate_renderdoc_available=1\n" +
        "rdoc_simple_gate_renderdoc_start=1\n" +
        "rdoc_simple_gate_renderdoc_capturing_before_end=1\n" +
