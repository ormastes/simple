"""
## Purpose and audience
Purpose: Prove that compute_layout scale_permille.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/layout.spl 80%
# @cover src/lib/common/ui/form_factor.spl 60%
# @req FR-UI-LAYOUT-DPI-SCALE
#
# compute_layout()'s optional `scale_permille` DPI/UI scale factor: identity
# (1000, the default) must leave existing 4-arg call sites unaffected, and a
# non-identity scale must multiply every emitted rect's (x, y, w, h) uniformly
# — the root rect, and every descendant rect that flows from it. Also covers
# FormFactorProfile.scale_permille, which is meant to be fed straight into
# compute_layout by callers that know the device's DPI scale.

use std.spec.{describe, it, expect, assert_true}
use common.ui.widget.{WidgetNode, WidgetKind}
use common.ui.builder.{column, button, label, scroll}
use common.ui.layout.{compute_layout, find_rect}
use common.ui.form_factor.{compute_form_factor}
use common.ui.viewport.{new_viewport}

# `column()`/`row()` wrap children in a WidgetKind.Panel container, and
# compute_layout gives panels a fixed (unscaled) 1px border on every side —
# so a panel's INNER geometry is never an exact 2x multiple of its 1x inner
# geometry. Build a border-free vbox container directly (any non-"panel"
# kind skips the border trim) so the child-doubling assertions below are
# exact instead of off-by-the-border-constant.
#
# The panel path itself is NOT exempt from scaling, though — it is only the
# 1px border that stays unscaled. The "panel border insets the scaled rect"
# example below pins that exactly, because the panel branch once inset the
# RAW args and so dropped DPI scaling for every container subtree.
fn _vbox(id: text, child: WidgetNode) -> WidgetNode:
    var node = WidgetNode.new(id, WidgetKind.Card.to_wire())
    node = node.set_layout("vbox")
    node = node.add_child(child)
    node

describe "compute_layout scale_permille":

    it "defaults to identity (1000) when omitted — matches the 4-arg call":
        step("Verify: defaults to identity (1000) when omitted — matches the 4-arg call")
        # @req: REQ-LIB-COMMON-001
        val root = column("scale_id_root", [button("scale_id_child", "C", "a")])
        val default_rects = compute_layout(WidgetNode(id: "scale_id_root"), 0, 0, 100, 50)
        val explicit_rects = compute_layout(WidgetNode(id: "scale_id_root"), 0, 0, 100, 50, 1000)
        match find_rect(default_rects, "scale_id_root"):
            case Some(a):
                match find_rect(explicit_rects, "scale_id_root"):
                    case Some(b):
                        expect(a.w).to_equal(b.w)
                        expect(a.h).to_equal(b.h)
                    case _: assert_true(false)
            case _: assert_true(false)

    it "scale 2000 (2.0x) doubles the root rect's size and position":
        step("Verify: scale 2000 (2.0x) doubles the root rect's size and position")
        val root = column("scale2_root", [button("scale2_child", "C", "a")])
        val rects = compute_layout(WidgetNode(id: "scale2_root"), 10, 20, 100, 50, 2000)
        match find_rect(rects, "scale2_root"):
            case Some(r):
                expect(r.x).to_equal(20)  # oracle: 20 — named expected value from the requirement
                expect(r.y).to_equal(40)  # oracle: 40 — named expected value from the requirement
                expect(r.w).to_equal(200)  # oracle: 200 — named expected value from the requirement
                expect(r.h).to_equal(100)  # oracle: 100 — named expected value from the requirement
            case _: assert_true(false)

    it "scale 2000 doubles a flex child's computed size vs scale 1000":
        step("Verify: scale 2000 doubles a flex child's computed size vs scale 1000")
        val root_a = _vbox("scale3a_root", button("scale3a_child", "C", "a"))
        val rects_1x = compute_layout(WidgetNode(id: "scale3a_root"), 0, 0, 100, 50, 1000)
        val root_b = _vbox("scale3b_root", button("scale3b_child", "C", "a"))
        val rects_2x = compute_layout(WidgetNode(id: "scale3b_root"), 0, 0, 100, 50, 2000)
        match find_rect(rects_1x, "scale3a_child"):
            case Some(c1x):
                match find_rect(rects_2x, "scale3b_child"):
                    case Some(c2x):
                        expect(c2x.w).to_equal(c1x.w * 2)
                        expect(c2x.h).to_equal(c1x.h * 2)
                    case _: assert_true(false)
            case _: assert_true(false)

    it "insets a panel's 1px border from the SCALED rect, not the raw one":
        step("Verify: insets a panel's 1px border from the SCALED rect, not the raw one")
        # REGRESSION: `column()` builds a WidgetKind.Panel, so this is the
        # common container path. The panel branch used to compute
        # inner = (x+1, y+1, w-2, h-2) from the UNSCALED args, which placed
        # the child at the 1x inner rect no matter what scale was asked for —
        # a child drawn at half size in the top-left corner at 2.0x DPI.
        val root = column("scale_panel_root", [button("scale_panel_child", "C", "a")])
        val rects_2x = compute_layout(root, 10, 20, 100, 50, 2000)
        match find_rect(rects_2x, "scale_panel_root"):
            case Some(r):
                expect(r.x).to_equal(20)  # oracle: 20 — named expected value from the requirement
                expect(r.y).to_equal(40)  # oracle: 40 — named expected value from the requirement
                expect(r.w).to_equal(200)  # oracle: 200 — named expected value from the requirement
                expect(r.h).to_equal(100)  # oracle: 100 — named expected value from the requirement
            case _: assert_true(false)
        # inner = scaled rect inset by the unscaled 1px border on each side
        match find_rect(rects_2x, "scale_panel_child"):
            case Some(c):
                expect(c.x).to_equal(21)  # oracle: 21 — named expected value from the requirement
                expect(c.y).to_equal(41)  # oracle: 41 — named expected value from the requirement
                expect(c.w).to_equal(198)  # oracle: 198 — named expected value from the requirement
                expect(c.h).to_equal(98)  # oracle: 98 — named expected value from the requirement
            case _: assert_true(false)

    it "leaves the panel path untouched at identity scale (control)":
        step("Verify: leaves the panel path untouched at identity scale (control)")
        # Discriminating control: must hold both before and after the fix, so
        # a green above cannot come from the oracle passing wholesale.
        val root = column("scale_panel_id_root", [button("scale_panel_id_child", "C", "a")])
        val rects_1x = compute_layout(root, 10, 20, 100, 50, 1000)
        match find_rect(rects_1x, "scale_panel_id_child"):
            case Some(c):
                expect(c.x).to_equal(11)  # oracle: 11 — named expected value from the requirement
                expect(c.y).to_equal(21)  # oracle: 21 — named expected value from the requirement
                expect(c.w).to_equal(98)  # oracle: 98 — named expected value from the requirement
                expect(c.h).to_equal(48)  # oracle: 48 — named expected value from the requirement
            case _: assert_true(false)

    it "scales a scroll container's max_height clip into device units":
        step("Verify: scales a scroll container's max_height clip into device units")
        # REGRESSION: the scroll branch clipped the ALREADY-SCALED inner_h
        # against a max_height parsed straight off the prop, i.e. unscaled.
        # At any non-identity scale the two sides of `inner_h > max_h` were in
        # different units, so the comparison was meaningless: at 2.0x the
        # content area was clipped to the 1x pixel count and a scroll view
        # showed half as much as it was asked to.
        #
        # `scroll(id, max_height, ...)` takes a plain i32 from a caller with no
        # scale knowledge — the same logical units as the x/y/w/h handed to
        # compute_layout, which this function scales. So max_height is scaled
        # here too, at the same place and exactly once.
        #
        # h=50 -> sh=100; max_height 20 -> 40 at 2.0x, so the single flex child
        # of the scroll's vbox fills 40, not 20.
        val sc = scroll("scale_scroll_root", 20, [label("scale_scroll_kid", "K")])
        val rects_2x = compute_layout(sc, 0, 0, 100, 50, 2000)
        match find_rect(rects_2x, "scale_scroll_kid"):
            case Some(c):
                expect(c.h).to_equal(40)  # oracle: 40 — named expected value from the requirement
            case _: assert_true(false)

    it "leaves the scroll clip untouched at identity scale (control)":
        step("Verify: leaves the scroll clip untouched at identity scale (control)")
        # Discriminating control: at scale 1000 the scaled and unscaled
        # max_height are the same number, so this must hold both before and
        # after the fix — a green above cannot come from the oracle passing
        # wholesale.
        val sc = scroll("scale_scroll_id_root", 20, [label("scale_scroll_id_kid", "K")])
        val rects_1x = compute_layout(sc, 0, 0, 100, 50, 1000)
        match find_rect(rects_1x, "scale_scroll_id_kid"):
            case Some(c):
                expect(c.h).to_equal(20)  # oracle: 20 — named expected value from the requirement
            case _: assert_true(false)

describe "FormFactorProfile.scale_permille":

    it "defaults to 1000 (identity) when compute_form_factor is called without it":
        step("Verify: defaults to 1000 (identity) when compute_form_factor is called without it")
        val vp = new_viewport(1440, 900, "gui")
        val ff = compute_form_factor(vp, "macos", false)
        expect(ff.scale_permille).to_equal(1000)  # oracle: 1000 — named expected value from the requirement

    it "carries an explicit scale_permille through to the profile":
        step("Verify: carries an explicit scale_permille through to the profile")
        val vp = new_viewport(1440, 900, "gui")
        val ff = compute_form_factor(vp, "macos", false, 1500)
        expect(ff.scale_permille).to_equal(1500)  # oracle: 1500 — named expected value from the requirement
