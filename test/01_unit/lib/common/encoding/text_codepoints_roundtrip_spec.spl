use std.spec.{describe, it, assert_equal}
use std.common.encoding.utf8.{text_from_codepoints, text_codepoints, char_from_code}

# Repro for doc/08_tracking/bug/text_from_codepoints_empty_text_phase2_native_2026_11_03.md:
# under Phase-2 native codegen text_from_codepoints / char_from_code returned
# empty text (NUL-leading string-table slice), so row reads hit SchemaNotFound.
describe "text_from_codepoints roundtrip":
    it "roundtrips ASCII codepoints to non-empty text":
        val cps = [0x48, 0x65, 0x6C, 0x6C, 0x6F]
        val t = text_from_codepoints(cps)
        assert_equal(t.len(), 5)
        assert_equal(t, "Hello")
        assert_equal(text_codepoints(t), cps)

    it "roundtrips multibyte codepoints":
        val cps = [0x41, 0xE9, 0xD55C, 0x1F600]
        val t = text_from_codepoints(cps)
        assert_equal(t.len(), 1 + 2 + 3 + 4)
        assert_equal(text_codepoints(t), cps)

    it "keeps NUL and low control codepoints":
        val t = text_from_codepoints([0x61, 0x00, 0x62])
        assert_equal(t.len(), 3)
        assert_equal(text_codepoints(t), [0x61, 0x00, 0x62])

    it "char_from_code is non-empty for the whole ASCII range":
        var c: i64 = 0
        while c < 128:
            assert_equal(char_from_code(c).len(), 1)
            c = c + 1

    it "returns empty text for empty codepoints":
        assert_equal(text_from_codepoints([]).len(), 0)
