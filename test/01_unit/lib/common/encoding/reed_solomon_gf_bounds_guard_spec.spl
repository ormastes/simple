# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.reed_solomon.{gf_mul, gf_inv, gf_pow}


describe "Reed-Solomon GF bounds guards":
    # @manual scenario evidence
    it "rejects out-of-range multiplication operands":
        # @req REQ-SSPEC-UNIT
        step("rejects out-of-range multiplication operands")
        assert_equal(gf_mul(-1, 1), 0)
        assert_equal(gf_mul(1, 256), 0)

    it "rejects out-of-range inverse operands":
        # @req REQ-SSPEC-UNIT
        step("rejects out-of-range inverse operands")
        assert_equal(gf_inv(-1), 0)
        assert_equal(gf_inv(256), 0)

    it "rejects out-of-range powers":
        # @req REQ-SSPEC-UNIT
        step("rejects out-of-range powers")
        assert_equal(gf_pow(-1, 2), 0)
        assert_equal(gf_pow(2, -1), 0)

    it "keeps valid GF arithmetic":
        # @req REQ-SSPEC-UNIT
        step("keeps valid GF arithmetic")
        assert_equal(gf_mul(2, 2), 4)
        assert_equal(gf_inv(1), 1)
        assert_equal(gf_pow(2, 0), 1)
