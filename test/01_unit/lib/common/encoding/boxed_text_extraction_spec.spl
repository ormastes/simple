"""Encoding-neutral checked extraction. Count-mismatch seam is not OOM injection."""
use std.spec
use std.common.text_bytes.{boxed_text_bytes_checked, text_byte_extraction_checked,
    text_byte_buffer, bytes_to_text, TextByteBufferError}
fn boxed_expect_bytes(actual: [u8], expected: [u8]):
    expect(actual.len()).to_equal(expected.len())
    for index in 0..expected.len(): expect(actual[index]).to_equal(expected[index])

describe "Checked boxed byte extraction shared by SOSIX and codecs":
    it "uses byte counts rather than Unicode scalar counts and preserves NUL":
        boxed_expect_bytes(boxed_text_bytes_checked("é\0🙂").unwrap(), [0xC3u8, 0xA9u8, 0u8, 0xF0u8, 0x9Fu8, 0x99u8, 0x82u8])
        expect(boxed_text_bytes_checked("").unwrap().len()).to_equal(0)

    it "rejects a short extraction using the production deterministic guard":
        val empty = text_byte_buffer(0).unwrap()
        expect(text_byte_extraction_checked(0, empty).is_ok()).to_equal(true)
        match text_byte_extraction_checked(4, empty):
            case Err(cause): expect(cause).to_equal(TextByteBufferError.AllocationFailed)
            case Ok(_): assert(false)
        expect(text_byte_extraction_checked(1, [65u8, 66u8]).is_err()).to_equal(true)
        expect(text_byte_extraction_checked(-1, empty).is_err()).to_equal(true)
        expect(text_byte_extraction_checked(9223372036854775807, empty).is_err()).to_equal(true)

    it "preserves raw nonUTF8 bytes without claiming encoding validation":
        val raw = bytes_to_text([255u8, 0u8, 65u8])
        boxed_expect_bytes(boxed_text_bytes_checked(raw).unwrap(), [255u8, 0u8, 65u8])
