# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.codec.{encode_from_codepoints, Encoding}


describe "encoding codec codepoint encode guards":
    # @manual scenario evidence
    it "keeps valid ASCII codepoints":
        # @req REQ-SSPEC-UNIT
        step("keeps valid ASCII codepoints")
        assert_equal(encode_from_codepoints([65, 66], Encoding.Ascii), [65, 66])

    it "rejects negative ASCII codepoints as question marks":
        # @req REQ-SSPEC-UNIT
        step("rejects negative ASCII codepoints as question marks")
        assert_equal(encode_from_codepoints([-1, 0x80], Encoding.Ascii), [0x3F, 0x3F])

    it "keeps valid Latin-1 codepoints":
        # @req REQ-SSPEC-UNIT
        step("keeps valid Latin-1 codepoints")
        assert_equal(encode_from_codepoints([65, 255], Encoding.Latin1), [65, 255])

    it "rejects negative Latin-1 codepoints as question marks":
        # @req REQ-SSPEC-UNIT
        step("rejects negative Latin-1 codepoints as question marks")
        assert_equal(encode_from_codepoints([-1, 256], Encoding.Latin1), [0x3F, 0x3F])
