# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.protobuf_wire.{pb_varint_from_payload}


describe "Protobuf wire varint payload guards":
    # @manual scenario evidence
    it "rejects empty varint payloads":
        # @req REQ-SSPEC-UNIT
        step("rejects empty varint payloads")
        assert_equal(pb_varint_from_payload([]), 0)

    it "rejects truncated varint payloads":
        # @req REQ-SSPEC-UNIT
        step("rejects truncated varint payloads")
        assert_equal(pb_varint_from_payload([128]), 0)

    it "rejects trailing invalid varint payload bytes":
        # @req REQ-SSPEC-UNIT
        step("rejects trailing invalid varint payload bytes")
        assert_equal(pb_varint_from_payload([1, 300]), 0)

    it "rejects trailing extra varint payload bytes":
        # @req REQ-SSPEC-UNIT
        step("rejects trailing extra varint payload bytes")
        assert_equal(pb_varint_from_payload([1, 2]), 0)

    it "keeps valid varint payload decoding":
        # @req REQ-SSPEC-UNIT
        step("keeps valid varint payload decoding")
        assert_equal(pb_varint_from_payload([172, 2]), 300)
