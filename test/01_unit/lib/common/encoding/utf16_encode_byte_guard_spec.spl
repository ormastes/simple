# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}
use std.common.encoding.utf16.{utf16_to_bytes_le, utf16_to_bytes_be, utf16_from_bytes_le, utf16_from_bytes_be}


describe "utf16 byte encoding guards":
    # @manual scenario evidence
    it "keeps valid little-endian serialization":
        # @req REQ-SSPEC-UNIT
        step("keeps valid little-endian serialization")
        assert_equal(utf16_to_bytes_le([0x41]), [0x41, 0x00])

    it "keeps valid big-endian serialization":
        # @req REQ-SSPEC-UNIT
        step("keeps valid big-endian serialization")
        assert_equal(utf16_to_bytes_be([0x41]), [0x00, 0x41])

    it "serializes negative units as replacement":
        # @req REQ-SSPEC-UNIT
        step("serializes negative units as replacement")
        assert_equal(utf16_from_bytes_le(utf16_to_bytes_le([-1])), [0xFFFD])

    it "serializes above-range units as replacement":
        # @req REQ-SSPEC-UNIT
        step("serializes above-range units as replacement")
        assert_equal(utf16_from_bytes_be(utf16_to_bytes_be([0x10041])), [0xFFFD])
