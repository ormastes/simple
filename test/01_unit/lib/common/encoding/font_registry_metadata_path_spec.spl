# Regression for divergence_byte_char_find_option_sweep_2026-08-01:
# rfind returns a byte offset, which must remain a substring byte bound.
use std.spec.{describe, it, expect}
use std.common.encoding.font_registry.{selected_font_asset_candidates}

describe "font candidate metadata directory uses the search byte offset":
    it "keeps the complete directory for a variable font filename":
        val assets = selected_font_asset_candidates()
        expect(assets[0].metadata_path).to_equal("ofl/notosanssc/METADATA.pb")

    it "keeps the directory for every selected font independently of filename length":
        val assets = selected_font_asset_candidates()
        expect(assets.len()).to_be_greater_than(1)
        for asset in assets:
            val components = asset.upstream_path.split("/")
            expect(components.len()).to_equal(3)
            expect(asset.metadata_path).to_equal(components[0] + "/" + components[1] + "/METADATA.pb")
