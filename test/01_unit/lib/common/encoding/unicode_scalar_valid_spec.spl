use std.spec
use std.common.encoding.unicode_scalar.{unicode_scalar_valid, unicode_scalar_to_char}

describe "shared Unicode scalar predicate boundary":
    it "accepts scalar endpoints and both sides of the surrogate gap":
        for value in [0, 127, 128, 0xD7FF, 0xE000, 0xFFFF, 0x10000, 0x10FFFF]:
            expect(unicode_scalar_valid(value)).to_equal(true)
            expect(unicode_scalar_to_char(value).is_ok()).to_equal(true)

    it "rejects negatives, surrogates, overflow and wide truncation aliases":
        for value in [-1, 0xD800, 0xDBFF, 0xDC00, 0xDFFF, 0x110000, 4294967361, 9223372036854775807]:
            expect(unicode_scalar_valid(value)).to_equal(false)
            expect(unicode_scalar_to_char(value).is_err()).to_equal(true)
