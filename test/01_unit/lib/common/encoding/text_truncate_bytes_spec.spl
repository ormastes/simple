"""
## Purpose and audience
Purpose: Prove that text_truncate_bytes.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# text_truncate_bytes Tests
#
# Tests for src/lib/common/encoding/utf8.spl :: text_truncate_bytes
#
# Byte-length text truncation that never splits a UTF-8 character. Covers
# the byte-boundary-vs-character-boundary gap described in
# doc/08_tracking/bug/byte_slice_utf8_boundary_audit_2026-07-31.md: a raw
# s[0:max_bytes] slice can land inside a multi-byte character and (on the
# native/JIT backends) yield invalid UTF-8; text_truncate_bytes backs off to
# the last valid character boundary at or before max_bytes instead.

use std.common.encoding.utf8.{text_truncate_bytes}

use std.spec.step

describe "text_truncate_bytes":
    it "leaves pure ASCII input unchanged when it fits":
        step("Verify: leaves pure ASCII input unchanged when it fits")
        # @req: REQ-LIB-COMMON-001
        expect(text_truncate_bytes("Hello world", 20)).to_equal("Hello world")
        expect(text_truncate_bytes("Hello world", 11)).to_equal("Hello world")

    it "truncates pure ASCII input at the byte limit":
        step("Verify: truncates pure ASCII input at the byte limit")
        val result = text_truncate_bytes("Hello world", 5)
        expect(result).to_equal("Hello")
        expect(result.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "backs off before a straddled 2-byte character (é, U+00E9)":
        step("Verify: backs off before a straddled 2-byte character (é, U+00E9)")
        # "café" = c,a,f (1 byte each) + é (0xC3 0xA9, 2 bytes) = 5 bytes total.
        # A limit of 4 lands inside é's 2-byte sequence (byte offset 3..5);
        # the safe result backs off to the 3-byte boundary before it.
        val s = "café"
        expect(s.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        val result = text_truncate_bytes(s, 4)
        expect(result).to_equal("caf")
        expect(result.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "backs off before a straddled 3-byte character (説, U+8AAC)":
        step("Verify: backs off before a straddled 3-byte character (説, U+8AAC)")
        # "AB" (1 byte each) + 説 (0xE8 0xAA 0xAC, 3 bytes) = 5 bytes total.
        # A limit of 4 lands inside 説's 3-byte sequence (byte offset 2..5);
        # the safe result backs off to the 2-byte boundary before it.
        val s = "AB説"
        expect(s.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        val result = text_truncate_bytes(s, 4)
        expect(result).to_equal("AB")
        expect(result.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns empty text for a limit of 0":
        step("Verify: returns empty text for a limit of 0")
        expect(text_truncate_bytes("hello", 0)).to_equal("")
        expect(text_truncate_bytes("説明", 0)).to_equal("")

    it "returns the original text unchanged for a limit larger than the string":
        step("Verify: returns the original text unchanged for a limit larger than the string")
        expect(text_truncate_bytes("hi", 100)).to_equal("hi")
        expect(text_truncate_bytes("", 100)).to_equal("")

    it "returns the whole string when the limit lands exactly on a character boundary":
        step("Verify: returns the whole string when the limit lands exactly on a character boundary")
        # "café" is 5 bytes: c,a,f,then é starting at byte 3 ending at byte 5.
        val s = "café"
        val result = text_truncate_bytes(s, 3)
        expect(result).to_equal("caf")
        expect(result.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
