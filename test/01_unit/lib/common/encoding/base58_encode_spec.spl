use std.common.encoding.base58.{base58_encode, base58_decode}

# Regression coverage for src/lib/common/encoding/base58.spl's
# base58_encode, which was completely non-functional before this fix
# (crashed on every input, including plain ASCII, with "Function
# 'i64.chr' not found").
#
# Root cause: `.chr()` is implemented only in the tree-walking
# interpreter's method dispatch (interpreter_method/primitives.rs), not
# in the JIT/native codegen path this engine uses by default -- not a
# receiver-typing or erased-receiver issue (tested and ruled out: an i64
# literal, a typed local, a function-result local, and a direct call-site
# receiver all fail identically under the default engine and all succeed
# identically under SIMPLE_EXECUTION_MODE=interpret). Fixed by using
# char_from_code (std.common.encoding.utf8) instead -- base58's alphabet
# is entirely ASCII 49-122, well within char_from_code's correct range
# (it is not a general Unicode codepoint converter; it returns U+FFFD for
# 128-255, but base58 never produces those).
#
# No fabricated/from-memory reference vectors are used here (see this
# campaign's own documented correction after an unverified "canonical
# Bitcoin test vector" was caught before being reported). Values below are
# either the function's own deterministic single-alphabet-character
# outputs (verifiable by hand from the documented alphabet string) or
# round-trips against this same module's base58_decode.

describe "base58_encode":
    it "does not crash and produces the exact single-alphabet-character outputs for the alphabet's own boundary values":
        # Alphabet: 123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz
        # index 0 = '1', index 1 = '2', index 57 (last) = 'z' -- byte value N
        # (0-255) maps to base58 index N via _b58_alphabet_ord/_b58_alpha_index_ord,
        # both hand-verifiable from the alphabet string in the file.
        expect(base58_encode([0])).to_equal("1")
        expect(base58_encode([1])).to_equal("2")
        expect(base58_encode([57])).to_equal("z")
        # 58 = 1*58 + 0 -> MSB digit 1 ('2'), LSB digit 0 ('1') -> "21"
        expect(base58_encode([58])).to_equal("21")

    it "round-trips through base58_decode for a multi-byte, non-leading-zero input":
        val encoded = base58_encode("Hello World!".bytes())
        val decoded = base58_decode(encoded)
        match decoded:
            Ok(bytes):
                expect(bytes).to_equal("Hello World!".bytes())
            Err(_):
                expect(true).to_be(false)

    it "round-trips through base58_decode preserving leading zero bytes":
        val input: [u8] = [0, 0, 1, 2, 3]
        val encoded = base58_encode(input)
        val decoded = base58_decode(encoded)
        match decoded:
            Ok(bytes):
                expect(bytes).to_equal(input)
            Err(_):
                expect(true).to_be(false)
