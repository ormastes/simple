use std.common.encoding.host_text_boundary_v1.{HostTextByteSpanV1, HostTextCodecErrorV1, host_validate_text_span_v1, host_text_span_to_utf8_v1, host_text_bytes_to_utf8_v1, utf8_bytes_to_host_text_v1, host_text_span_byte_v1}
use std.spec.{describe, it}

fn check_canonical_bytes(actual: Result<[u8], HostTextCodecErrorV1>, expected: [u8]):
    match actual:
        Ok(bytes):
            assert(bytes.len() == expected.len())
            for index in 0..expected.len():
                assert(bytes[index] == expected[index])
        Err(problem): assert(false)

fn check_span_valid(actual: Result<(), HostTextCodecErrorV1>):
    match actual:
        Ok(value): assert(value == ())
        Err(problem): assert(false)

fn check_span_error(actual: Result<(), HostTextCodecErrorV1>, code: text, offset: i64):
    match actual:
        Ok(value): assert(false)
        Err(problem):
            assert(problem.code == code)
            assert(problem.byte_offset == offset)

describe "canonical byte span host transcoding":
    it "transcodes bytes symmetrically without semantic full-array widening":
        check_canonical_bytes(host_text_bytes_to_utf8_v1([65, 0, 0, 0, 61, 216, 0, 222], "utf-16le"), [65, 0, 240, 159, 152, 128])
        check_canonical_bytes(utf8_bytes_to_host_text_v1([65, 0, 240, 159, 152, 128], "utf-16be"), [0, 65, 0, 0, 216, 61, 222, 0])
        check_canonical_bytes(host_text_bytes_to_utf8_v1([], "utf-8"), [])

    it "reads prefix and selected byte region without concatenation":
        val span = HostTextByteSpanV1(prefix: [240, 159], bytes: [152, 128, 0, 255], start: 0, end: 5)
        assert(host_text_span_byte_v1(span, 1) == 159)
        assert(host_text_span_byte_v1(span, 2) == 152)
        check_span_valid(host_validate_text_span_v1(span, "utf-8"))
        check_canonical_bytes(host_text_span_to_utf8_v1(span, "utf-8"), [240, 159, 152, 128, 0])
        val selected = HostTextByteSpanV1(prefix: [], bytes: [239, 187, 191, 65, 0, 255], start: 3, end: 5)
        check_canonical_bytes(host_text_span_to_utf8_v1(selected, "utf-8"), [65, 0])

    it "keeps absolute logical error positions and metadata precedence":
        val bad = HostTextByteSpanV1(prefix: [65], bytes: [65, 224, 65], start: 2, end: 4)
        check_span_error(host_validate_text_span_v1(bad, "utf-8"), "invalid_utf8", 3)
        val missing = HostTextByteSpanV1(prefix: [65], bytes: [65, 240, 159], start: 2, end: 4)
        check_span_error(host_validate_text_span_v1(missing, "utf-8"), "truncated_input", 4)
        val invalid = HostTextByteSpanV1(prefix: [], bytes: [], start: -1, end: 0)
        check_span_error(host_validate_text_span_v1(invalid, "guess"), "unsupported_encoding", -1)
        check_span_error(host_validate_text_span_v1(invalid, "utf-8"), "invalid_span", -1)
        val long_prefix = HostTextByteSpanV1(prefix: [65, 66, 67, 68], bytes: [], start: 0, end: 4)
        check_span_error(host_validate_text_span_v1(long_prefix, "utf-8"), "invalid_span", -1)

    it "handles UTF16 prefix boundaries and empty selected spans":
        val pair = HostTextByteSpanV1(prefix: [216], bytes: [61, 222, 0], start: 0, end: 4)
        check_span_valid(host_validate_text_span_v1(pair, "utf-16be"))
        check_canonical_bytes(host_text_span_to_utf8_v1(pair, "utf-16be"), [240, 159, 152, 128])
        val empty = HostTextByteSpanV1(prefix: [], bytes: [255], start: 1, end: 1)
        check_span_valid(host_validate_text_span_v1(empty, "utf-8"))
        check_canonical_bytes(host_text_span_to_utf8_v1(empty, "utf-8"), [])
