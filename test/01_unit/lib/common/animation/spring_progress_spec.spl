# @cover src/lib/common/animation/spring.spl

use std.spec.*
use std.common.animation.spring.{SpringConfig, SpringAnimation, spring_progress}

fn _anim(from_v: f64, to_v: f64, cur: f64) -> SpringAnimation:
    SpringAnimation(
        config: SpringConfig(stiffness: 100.0, damping: 10.0, mass: 1.0),
        from_value: from_v, to_value: to_v, velocity: 0.0,
        current: cur, elapsed: 0.0, is_complete: false
    )

describe "spring_progress":
    it "is 0 at start, 0.5 midway, 1 at target":
        expect(spring_progress(_anim(0.0, 10.0, 0.0))).to_equal(0.0)
        expect(spring_progress(_anim(0.0, 10.0, 5.0))).to_equal(0.5)
        expect(spring_progress(_anim(0.0, 10.0, 10.0))).to_equal(1.0)
    it "overshoots above 1 and handles zero range":
        expect(spring_progress(_anim(0.0, 10.0, 12.0))).to_equal(1.2)
        expect(spring_progress(_anim(3.0, 3.0, 3.0))).to_equal(1.0)
