use std.spec.*
use std.async.cancellation.{token_new}
use std.common.crypto.sha256.{sha256_u8_hex, sha256_text}
use std.common.io.file_read_policy.{FileReadPolicyV1}
use std.common.io.read_only_file_view.{
    read_only_file_view_open_v1, read_only_file_view_read_v1,
    read_only_file_view_close_v1
}

describe "read-only file view native synchronous read":
    it "returns exact buffered bytes without a global async runtime":
        val opened = read_only_file_view_open_v1(
            ".", "test/05_perf/fixtures/interpreter_startup/hello.spl",
            "fixture-snapshot", FileReadPolicyV1.auto_map)
        expect(opened.is_ok()).to_be(true)
        var view = opened.unwrap()
        val read = read_only_file_view_read_v1(
            &view, 0, view.identity.size, token_new())
        expect(read.is_ok()).to_be(true)
        val payload = read.unwrap().bytes
        expect(payload.len().to_u64()).to_equal(view.identity.size)
        expect(sha256_u8_hex(payload)).to_equal(sha256_text(
            "fn main():\n    println(\"Hello World\")\n"))
        expect(read_only_file_view_close_v1(view).is_ok()).to_be(true)

    it "rejects an out-of-range read on the same pinned descriptor":
        val opened = read_only_file_view_open_v1(
            ".", "test/05_perf/fixtures/interpreter_startup/hello.spl",
            "fixture-snapshot", FileReadPolicyV1.auto_map)
        expect(opened.is_ok()).to_be(true)
        var view = opened.unwrap()
        val read = read_only_file_view_read_v1(
            &view, view.identity.size, 1, token_new())
        expect(read.is_err()).to_be(true)
        expect(read_only_file_view_close_v1(view).is_ok()).to_be(true)
