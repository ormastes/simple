# @req REQ-SSPEC-LIB
# Bug nul_literal_double_box_constructor_2026_10_12 (reopened 2026-11-06):
# char_from_code(0) must be a 1-byte text holding NUL, not "". Native
# self-hosted builds returned "" (rt_bytes_to_text C-string termination).
use std.string_core.{char_from_code, bytes_to_text_counted}

describe "char_from_code NUL":
    it "char_from_code(0) has length 1":
        expect(char_from_code(0).len()).to_equal(1)

    it "char_from_code(0) byte is 0":
        expect(char_from_code(0).byte_at(0) as i64).to_equal(0)

    it "NUL between ASCII keeps length 3":
        val s = "a" + char_from_code(0) + "b"
        expect(s.len()).to_equal(3)

    it "bytes_to_text_counted keeps interior NUL":
        val t = bytes_to_text_counted([97 as u8, 0 as u8, 98 as u8])
        expect(t.len()).to_equal(3)
        expect(t.byte_at(1) as i64).to_equal(0)
