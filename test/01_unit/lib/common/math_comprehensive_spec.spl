    it "returns 0 for negative exponent":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns 0 for negative exponent")
        expect(math_pow_i64(2, -1)).to_equal(0)  # oracle: value fixed by the spec contract

    it "computes 1^large":
        # @req: REQ-COMMON-MathComprehensive-001
