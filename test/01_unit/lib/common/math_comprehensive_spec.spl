describe "math_factorial":

    it "computes 0! = 1":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes 0! = 1")
        expect(math_factorial(0)).to_equal(1)  # oracle: value fixed by the spec contract

    it "computes 1! = 1":
