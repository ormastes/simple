describe "average_i64":

    it "computes average of a list":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes average of a list")
        val result = average_i64([2, 4, 6])
        expect(result).to_equal(4)  # oracle: value fixed by the spec contract

    it "returns nil for empty list":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns nil for empty list")
        val result = average_i64([])
        expect(result).to_be_nil()

    it "computes average of single element":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes average of single element")
        val result = average_i64([10])
        expect(result).to_equal(10)  # oracle: value fixed by the spec contract

    it "truncates toward zero for integer division":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: truncates toward zero for integer division")
        # [1, 2] -> sum=3, len=2, 3/2 = 1 (integer division)
        val result = average_i64([1, 2])
        expect(result).to_equal(1)  # oracle: value fixed by the spec contract

describe "median_i64":

    it "computes median of odd-length list":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes median of odd-length list")
        val result = median_i64([3, 1, 2])
        expect(result).to_equal(2)  # oracle: value fixed by the spec contract

    it "computes median of even-length list":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes median of even-length list")
        # [1, 2, 3, 4] -> (2 + 3) / 2 = 2 (integer division)
        val result = median_i64([4, 1, 3, 2])
        expect(result).to_equal(2)  # oracle: value fixed by the spec contract

    it "returns nil for empty list":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns nil for empty list")
        val result = median_i64([])
        expect(result).to_be_nil()

    it "computes median of single element":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes median of single element")
        val result = median_i64([42])
        expect(result).to_equal(42)  # oracle: value fixed by the spec contract

    it "computes median of sorted list":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes median of sorted list")
        val result = median_i64([10, 20, 30, 40, 50])
        expect(result).to_equal(30)  # oracle: value fixed by the spec contract

    it "handles duplicate values":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: handles duplicate values")
        val result = median_i64([5, 5, 5])
        expect(result).to_equal(5)  # oracle: value fixed by the spec contract

# ============================================================================
# Re-exported std.common.math surface (shadowing regression gate)
#
# math_pow/math_cbrt live in src/lib/common/math.spl, which src/lib/math.spl
# shadows. They resolve only because the facade re-exports them. If that
# re-export is ever dropped, these examples fail with
# `error[E1002]: function ... not found` rather than silently disappearing.
# ============================================================================

describe "Math re-exported from std.common.math":

    it "math_pow raises to an integer power":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: math_pow raises to an integer power")
        val result = math_pow(2.0, 3.0)
        val close = math_is_close(result, 8.0, 0.0001)
        expect(close).to_equal(true)

    it "math_pow with exponent zero is one":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: math_pow with exponent zero is one")
        val result = math_pow(5.0, 0.0)
        val close = math_is_close(result, 1.0, 0.0001)
        expect(close).to_equal(true)

    it "math_cbrt returns the cube root":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: math_cbrt returns the cube root")
        val result = math_cbrt(27.0)
        val close = math_is_close(result, 3.0, 0.0001)
        expect(close).to_equal(true)
