# ============================================================================
# Linear Interpolation
# ============================================================================

describe "math_lerp":

    it "returns a when t=0":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns a when t=0")
        val result = math_lerp(10.0, 20.0, 0.0)
        val close = math_is_close(result, 10.0, 0.001)
        expect(close).to_equal(true)

    it "returns b when t=1":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns b when t=1")
        val result = math_lerp(10.0, 20.0, 1.0)
        val close = math_is_close(result, 20.0, 0.001)
        expect(close).to_equal(true)

    it "returns midpoint when t=0.5":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns midpoint when t=0.5")
        val result = math_lerp(10.0, 20.0, 0.5)
        val close = math_is_close(result, 15.0, 0.001)
        expect(close).to_equal(true)

    it "handles t=0.25":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: handles t=0.25")
        val result = math_lerp(0.0, 100.0, 0.25)
        val close = math_is_close(result, 25.0, 0.001)
        expect(close).to_equal(true)

# ============================================================================
# Approximate Equality
# ============================================================================

describe "math_is_close":

    it "returns true for identical values":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns true for identical values")
        val result = math_is_close(5.0, 5.0, 0.01)
        expect(result).to_equal(true)

    it "returns true for values within tolerance":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns true for values within tolerance")
        val result = math_is_close(5.0, 5.005, 0.01)
        expect(result).to_equal(true)

    it "returns false for values outside tolerance":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns false for values outside tolerance")
        val result = math_is_close(5.0, 6.0, 0.01)
        expect(result).to_equal(false)

    it "handles negative differences":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: handles negative differences")
        val result = math_is_close(3.0, 2.999, 0.01)
        expect(result).to_equal(true)

# ============================================================================
# GCD
# ============================================================================

describe "math_gcd":

    it "computes gcd of 12 and 8":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes gcd of 12 and 8")
        expect(math_gcd(12, 8)).to_equal(4)  # oracle: value fixed by the spec contract

    it "computes gcd of coprime numbers":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes gcd of coprime numbers")
        expect(math_gcd(7, 13)).to_equal(1)  # oracle: value fixed by the spec contract

    it "handles zero argument":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: handles zero argument")
        expect(math_gcd(5, 0)).to_equal(5)  # oracle: value fixed by the spec contract
        expect(math_gcd(0, 5)).to_equal(5)  # oracle: value fixed by the spec contract

    it "handles negative arguments":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: handles negative arguments")
        expect(math_gcd(-12, 8)).to_equal(4)  # oracle: value fixed by the spec contract
        expect(math_gcd(12, -8)).to_equal(4)  # oracle: value fixed by the spec contract

    it "computes gcd of equal values":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes gcd of equal values")
        expect(math_gcd(6, 6)).to_equal(6)  # oracle: value fixed by the spec contract

# ============================================================================
# LCM
# ============================================================================

describe "math_lcm":

    it "computes lcm of 4 and 6":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes lcm of 4 and 6")
        expect(math_lcm(4, 6)).to_equal(12)  # oracle: value fixed by the spec contract

    it "computes lcm of coprime numbers":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes lcm of coprime numbers")
        expect(math_lcm(3, 5)).to_equal(15)  # oracle: value fixed by the spec contract

    it "returns 0 when either argument is zero":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns 0 when either argument is zero")
        expect(math_lcm(0, 5)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(math_lcm(5, 0)).to_equal(0)  # oracle: value fixed by the spec contract

    it "computes lcm of 7 and 3":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes lcm of 7 and 3")
        expect(math_lcm(7, 3)).to_equal(21)  # oracle: value fixed by the spec contract

