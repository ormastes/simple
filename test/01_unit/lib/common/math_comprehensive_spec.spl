# ============================================================================
# Clamp
# ============================================================================

describe "math_clamp (f64)":

    it "returns value when within range":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns value when within range")
        val result = math_clamp(5.0, 0.0, 10.0)
        val close = math_is_close(result, 5.0, 0.001)
        expect(close).to_equal(true)

    it "returns min when below range":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns min when below range")
        val result = math_clamp(-3.0, 0.0, 10.0)
        val close = math_is_close(result, 0.0, 0.001)
        expect(close).to_equal(true)

    it "returns max when above range":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns max when above range")
        val result = math_clamp(15.0, 0.0, 10.0)
        val close = math_is_close(result, 10.0, 0.001)
        expect(close).to_equal(true)

describe "math_clamp_i64":

    it "returns value when within range":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns value when within range")
        expect(math_clamp_i64(5, 0, 10)).to_equal(5)  # oracle: value fixed by the spec contract

    it "returns min when below range":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns min when below range")
        expect(math_clamp_i64(-3, 0, 10)).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns max when above range":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns max when above range")
        expect(math_clamp_i64(15, 0, 10)).to_equal(10)  # oracle: value fixed by the spec contract

    it "handles boundary values":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: handles boundary values")
        expect(math_clamp_i64(0, 0, 10)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(math_clamp_i64(10, 0, 10)).to_equal(10)  # oracle: value fixed by the spec contract

