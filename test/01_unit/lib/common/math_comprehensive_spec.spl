        step("Verify: computes 1! = 1")
        expect(math_factorial(1)).to_equal(1)  # oracle: value fixed by the spec contract

    it "computes 5! = 120":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes 5! = 120")
        expect(math_factorial(5)).to_equal(120)  # oracle: value fixed by the spec contract

    it "computes 10! = 3628800":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: computes 10! = 3628800")
        expect(math_factorial(10)).to_equal(3628800)  # oracle: value fixed by the spec contract

    it "returns 1 for negative input":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: returns 1 for negative input")
        expect(math_factorial(-5)).to_equal(1)  # oracle: value fixed by the spec contract

# ============================================================================
# Degree/Radian Conversion
# ============================================================================

describe "math_to_radians":

    it "converts 0 degrees to 0 radians":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts 0 degrees to 0 radians")
        val result = math_to_radians(0.0)
        val close = math_is_close(result, 0.0, 0.001)
        expect(close).to_equal(true)

    it "converts 180 degrees to PI radians":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts 180 degrees to PI radians")
        val result = math_to_radians(180.0)
        val close = math_is_close(result, MATH_PI, 0.001)
        expect(close).to_equal(true)

    it "converts 360 degrees to TAU radians":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts 360 degrees to TAU radians")
        val result = math_to_radians(360.0)
        val close = math_is_close(result, MATH_TAU, 0.001)
        expect(close).to_equal(true)

    it "converts 90 degrees to PI/2 radians":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts 90 degrees to PI/2 radians")
        val result = math_to_radians(90.0)
        val expected = MATH_PI / 2.0
        val close = math_is_close(result, expected, 0.001)
        expect(close).to_equal(true)

describe "math_to_degrees":

    it "converts 0 radians to 0 degrees":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts 0 radians to 0 degrees")
        val result = math_to_degrees(0.0)
        val close = math_is_close(result, 0.0, 0.001)
        expect(close).to_equal(true)

    it "converts PI radians to 180 degrees":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts PI radians to 180 degrees")
        val result = math_to_degrees(MATH_PI)
        val close = math_is_close(result, 180.0, 0.001)
        expect(close).to_equal(true)

    it "converts TAU radians to 360 degrees":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: converts TAU radians to 360 degrees")
        val result = math_to_degrees(MATH_TAU)
        val close = math_is_close(result, 360.0, 0.001)
        expect(close).to_equal(true)

    it "round-trips degrees through radians":
        # @req: REQ-COMMON-MathComprehensive-001
        step("Verify: round-trips degrees through radians")
        val original = 45.0
        val rad = math_to_radians(original)
        val deg = math_to_degrees(rad)
        val close = math_is_close(deg, original, 0.001)
        expect(close).to_equal(true)

