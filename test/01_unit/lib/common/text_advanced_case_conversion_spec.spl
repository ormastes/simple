# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.text_advanced.{to_title_case, to_snake_case, to_camel_case}


describe "text_advanced case conversion":
    # @manual scenario evidence
    """Regression guard for a char-arithmetic-as-text-interpolation defect.

    `to_title_case`, `to_snake_case`, and `to_camel_case` computed a shifted
    character code (`ch[0] +/- 32`) and pushed it via `"{code}"` string
    interpolation instead of converting the code back to a character. Since
    interpolating an integer renders its decimal digits, every case-shifted
    letter came out as digits glued into the surrounding text -- e.g.
    `to_snake_case("HelloWorld")` returned `"H32ello_W32orld"` instead of
    `"hello_world"`. Fixed by routing the shifted code through
    `char_from_code()`.
    """

    it "title-cases each word without leaking numeric char codes":
        # @req REQ-SSPEC-UNIT
        step("title-cases each word without leaking numeric char codes")
        expect(to_title_case("hello world")).to_equal("Hello World")

    it "snake-cases a PascalCase identifier without leaking numeric char codes":
        # @req REQ-SSPEC-UNIT
        step("snake-cases a PascalCase identifier without leaking numeric char codes")
        expect(to_snake_case("HelloWorld")).to_equal("hello_world")

    it "camel-cases space-separated words without leaking numeric char codes":
        # @req REQ-SSPEC-UNIT
        step("camel-cases space-separated words without leaking numeric char codes")
        expect(to_camel_case("hello world")).to_equal("helloWorld")

    it "camel-cases underscore-separated words too":
        # @req REQ-SSPEC-UNIT
        step("camel-cases underscore-separated words too")
        expect(to_camel_case("hello_world")).to_equal("helloWorld")
