# @req REQ-C-MIG-BYTE-CHAR
#
# C-MIG-0028: pure-Simple byte-value-to-one-character-text conversion
# (`std.common.encoding.byte_char.byte_char`) vs the C/Rust oracle
# `rt_byte_char` (src/compiler_rust/compiler/src/interpreter_extern/
# conversion.rs::rt_byte_char_fn).
#
# rt_byte_char treats its argument as a raw `u8` (truncating/masking to the
# low 8 bits) and does Rust's `byte_val as char`, which maps a u8 directly to
# the identical Unicode scalar value (Latin-1 / ISO-8859-1 transparency: byte
# 0x00..0xFF == codepoint U+0000..U+00FF) and UTF-8 encodes it -- 1 byte for
# 0x00..0x7F, 2 bytes (0xC2/0xC3 lead + continuation) for 0x80..0xFF.
#
# The pure-Simple counterpart (`byte_char`, src/lib/common/encoding/
# byte_char.spl) reimplements this UTF-8 encoding directly with u64 bit math,
# deliberately NOT delegating to std.common.string_core (out of scope this
# round per the C-migration plan) or to `rt_char_from_code`. It uses
# `rt_bytes_to_text` only as a raw byte-array -> text memcpy primitive, the
# same non-algorithmic role that extern plays inside string_core.spl's own
# char_from_code_inline, so this is a genuine independent implementation.

use std.spec.{describe, it, assert_equal, assert_true}
use std.common.encoding.byte_char.{byte_char}

# C/Rust oracle (test-only; never production-linked from Simple product code here).
extern fn rt_byte_char(v: i64) -> text

describe "byte_char — pure-Simple vs C/Rust oracle (rt_byte_char)":
    it "matches the oracle on published-shape KATs":
        assert_equal(byte_char(65), "A")
        assert_equal(byte_char(65), rt_byte_char(65))
        assert_equal(byte_char(48), "0")
        assert_equal(byte_char(48), rt_byte_char(48))
        assert_equal(byte_char(32), " ")
        assert_equal(byte_char(32), rt_byte_char(32))
        assert_equal(byte_char(0), rt_byte_char(0))
        assert_equal(byte_char(127), rt_byte_char(127))

    it "matches the oracle on the 1-byte/2-byte UTF-8 boundary (0x7F vs 0x80)":
        assert_equal(byte_char(0x7F), rt_byte_char(0x7F))
        assert_equal(byte_char(0x80), rt_byte_char(0x80))
        assert_equal(byte_char(0x80), "\u{80}")

    it "matches the oracle across the full 2-byte Latin-1 supplement range":
        assert_equal(byte_char(0x81), rt_byte_char(0x81))
        assert_equal(byte_char(0xA9), rt_byte_char(0xA9))
        assert_equal(byte_char(0xE9), rt_byte_char(0xE9))
        assert_equal(byte_char(0xFF), rt_byte_char(0xFF))
        assert_equal(byte_char(0xFF), "\u{FF}")

    it "single-byte corruption changes the result (discrimination)":
        assert_true(byte_char(65) != byte_char(66))
        assert_true(rt_byte_char(200) != rt_byte_char(201))

    it "is deterministic on both sides":
        assert_equal(byte_char(0xE9), byte_char(0xE9))
        assert_equal(rt_byte_char(0xE9), rt_byte_char(0xE9))

    it "matches the oracle on 100 shared branch-covering vectors, with perf evidence":
        # SHARED TEST LOGIC (plan: "C-migration test standard"): one
        # deterministic generator feeds the SAME byte value to BOTH sides
        # inside this loop. Branch coverage via a seeded LCG cycling through
        # the full 0..255 byte range so both UTF-8 encoding-length branches
        # (1-byte ASCII, 2-byte Latin-1 supplement) are exercised, plus
        # forced boundary values at fixed moduli.
        use std.io_runtime.{time_now_unix_micros}
        var simple_us = 0
        var c_us = 0
        var i = 0
        while i < 100:
            var seed = (i * 2654435761 + 12345) % 4294967296
            seed = (seed * 1103515245 + 12345) % 2147483648
            var v = seed % 256
            if i % 17 == 0:
                v = 0x7F
            else if i % 13 == 0:
                v = 0x80
            else if i % 11 == 0:
                v = 0
            else if i % 7 == 0:
                v = 0xFF

            val t0 = time_now_unix_micros()
            val s = byte_char(v)
            val t1 = time_now_unix_micros()
            val c = rt_byte_char(v)
            val t2 = time_now_unix_micros()
            simple_us = simple_us + (t1 - t0)
            c_us = c_us + (t2 - t1)
            assert_equal(s, c)
            i = i + 1
        print("perf_evidence: shared_corpus=100 simple_us={simple_us} c_us={c_us}")
        assert_true(simple_us >= 0 and c_us >= 0)
