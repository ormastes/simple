# @req OBS-V1-DEFAULTS-001
# Verifies explicit population of all seven additive receipt defaults on
# ObservedProcessResultV1 and all six additive receipt defaults on
# ProcessObservationOwnerV1 across common and nogc_sync_mut process modules.

use std.spec.*
use std.common.process.observation_v1.{
    ProcessObservationProviderV1,
    ObservedProcessStartStatusV1,
    ObservedProcessResultStatusV1,
    ObservedProcessFailureReasonV1,
    ObservedProcessRequestV1,
    ObservedProcessResultV1,
    observed_process_empty_stream_v1,
    observed_process_empty_rusage_v1,
    observed_process_empty_pin_v1,
    observed_process_result_status_v1
}
use std.nogc_sync_mut.io.process_observation_v1.{
    process_observation_start_with_provider_v1,
    process_observation_collect_v1,
    process_observation_decode_result_v1
}

fn expect_unknown_receipt_defaults(result: ObservedProcessResultV1):
    expect(result.output_complete_observed).to_equal(false)
    expect(result.stream_counts_observed).to_equal(false)
    expect(result.terminal_observed.?).to_equal(false)
    expect(result.identity_revalidated.?).to_equal(false)
    expect(result.cancel_requested.?).to_equal(false)
    expect(result.native_error.?).to_equal(false)
    expect(result.native_retired).to_equal(false)

describe "ObservedProcessResultV1 additive receipt defaults":
    it "explicitly populates all seven additive receipt defaults in observed_process_result_status_v1":
        step("Build Missing and Malformed status results through helper and decoder")
        val missing = observed_process_result_status_v1(ObservedProcessResultStatusV1.Missing)
        expect(missing.status).to_equal(ObservedProcessResultStatusV1.Missing)
        expect(missing.failure_reason).to_equal(ObservedProcessFailureReasonV1.None)
        expect(missing.exit_code).to_equal(-1)
        expect(missing.signal).to_equal(0)
        expect_unknown_receipt_defaults(missing)

        val decoded_empty = process_observation_decode_result_v1([])
        expect(decoded_empty.status).to_equal(ObservedProcessResultStatusV1.Missing)
        expect_unknown_receipt_defaults(decoded_empty)

        val decoded_nonempty = process_observation_decode_result_v1([42])
        expect(decoded_nonempty.status).to_equal(ObservedProcessResultStatusV1.Malformed)
        expect_unknown_receipt_defaults(decoded_nonempty)

    it "explicitly populates owner and result additive receipt defaults in unsupported lifecycle":
        step("Start and collect with Unsupported provider through process_ops")
        val req = ObservedProcessRequestV1(
            command: "/bin/sh",
            args: ["-c", "exit 0"],
            deadline_ms: 100,
            term_grace_ms: 10,
            stdout_limit: 1024,
            stderr_limit: 1024,
            pin_executable: false
        )
        val denied = process_observation_start_with_provider_v1(
            ProcessObservationProviderV1.Unsupported, req)
        expect(denied.status).to_equal(ObservedProcessStartStatusV1.Unsupported)
        expect(denied.spawned).to_equal(false)
        expect(denied.lease.output_complete_observed).to_equal(false)
        expect(denied.lease.stream_counts_observed).to_equal(false)
        expect(denied.lease.terminal_observed.?).to_equal(false)
        expect(denied.lease.identity_revalidated.?).to_equal(false)
        expect(denied.lease.cancel_requested.?).to_equal(false)
        expect(denied.lease.native_error.?).to_equal(false)

        val collected = process_observation_collect_v1(denied.lease)
        expect(collected.status).to_equal(ObservedProcessResultStatusV1.Unsupported)
        expect(collected.failure_reason).to_equal(ObservedProcessFailureReasonV1.None)
        expect_unknown_receipt_defaults(collected)

    it "preserves explicit non-default additive receipt fields when constructed directly":
        step("Construct ObservedProcessResultV1 with all receipt fields set")
        val explicit = ObservedProcessResultV1(
            status: ObservedProcessResultStatusV1.Collected,
            pid: 1234,
            exit_code: 0,
            signal: 0,
            deadline_exceeded: false,
            term_sent: false,
            kill_sent: false,
            reaped: true,
            output_complete: true,
            wall_time_ms: 15,
            stdout: observed_process_empty_stream_v1(),
            stderr: observed_process_empty_stream_v1(),
            rusage: observed_process_empty_rusage_v1(),
            executable_pin: observed_process_empty_pin_v1(),
            failure_reason: ObservedProcessFailureReasonV1.None,
            output_complete_observed: true,
            stream_counts_observed: true,
            terminal_observed: Some(true),
            identity_revalidated: Some(true),
            cancel_requested: Some(false),
            native_error: Some(0),
            native_retired: true
        )
        expect(explicit.output_complete_observed).to_equal(true)
        expect(explicit.stream_counts_observed).to_equal(true)
        expect(explicit.terminal_observed.?).to_equal(true)
        expect(explicit.terminal_observed.unwrap()).to_equal(true)
        expect(explicit.identity_revalidated.?).to_equal(true)
        expect(explicit.identity_revalidated.unwrap()).to_equal(true)
        expect(explicit.cancel_requested.?).to_equal(true)
        expect(explicit.cancel_requested.unwrap()).to_equal(false)
        expect(explicit.native_error.?).to_equal(true)
        expect(explicit.native_error.unwrap()).to_equal(0)
        expect(explicit.native_retired).to_equal(true)
