"""
# http_core — adversarial edge hardening (lane W17-B)

Adversarial edge coverage for the unified HTTP core
(`src/lib/common/net/http_core.spl`) beyond the happy-path guards already
fenced by `http_core_spec.spl`. Every scenario here drives a real core entry
point with hostile input and asserts the SAFE outcome (rejected / bounded /
not smuggled). These are regression fences on the hardened behaviour — the
core already handles each case; this locks that in so a future refactor of
`body_decision` / the chunked decoder / the request-limit checks cannot
silently reopen a smuggling or resource-exhaustion hole.

**Gaps this closes (were untested before W17-B):**
  - `hex_chunk_size` bad-hex / empty / overflow bounds (directly)
  - `decode_chunked_bounded` malformed framing, truncation, missing
    terminator, and 413-on-decoded-size (directly)
  - `chunked_body_end_scan` invalid vs incomplete framing (directly)
  - duplicate/conflicting singleton security headers (Host, Authorization,
    Origin, X-Forwarded-Host, X-Forwarded-Proto) — header-smuggling vector
  - `HttpParseError` request-line / header-count / header-size / body-size
    limit checks and their status mapping
  - backslash and encoded-backslash path traversal

Lane: .spipe/simple_enterprise_suite (Wave A hardening follow-up W17-B).
"""

use std.spec.*
use std.common.net.http_core.{
    body_decision,
    hex_chunk_size,
    decode_chunked_bounded,
    chunked_body_end_scan,
    HttpLimits, http_limits_default,
    HttpParseError, http_parse_error_status,
    check_request_line, check_header_count, check_header_size, check_body_size,
    path_is_safe, is_safe_static_path
}

fn repeat_char(c: text, n: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < n:
        out = out + c
        i = i + 1
    out

describe "http_core — hex_chunk_size fails closed on hostile chunk sizes":
    it "parses a valid lowercase hex chunk size":
        expect(hex_chunk_size("ff")).to_equal(255)

    it "parses a valid uppercase hex chunk size":
        expect(hex_chunk_size("1A")).to_equal(26)

    it "rejects an empty chunk-size field":
        expect(hex_chunk_size("")).to_equal(-1)

    it "rejects a non-hex character (smuggled garbage size)":
        expect(hex_chunk_size("xz")).to_equal(-1)

    it "rejects a chunk size beyond the 2^27 sanity bound":
        step("A single 256 MiB chunk (10000000 hex) is hostile")
        expect(hex_chunk_size("10000000")).to_equal(-1)

describe "http_core — decode_chunked_bounded rejects malformed framing":
    it "decodes a well-formed chunked body":
        val r = decode_chunked_bounded("5\r\nhello\r\n0\r\n\r\n", 1024)
        expect(r.0).to_equal("")
        expect(r.1).to_equal("hello")

    it "rejects a bad chunk-size line with 400":
        val r = decode_chunked_bounded("zz\r\nhello\r\n0\r\n\r\n", 1024)
        expect(r.0.starts_with("400")).to_be(true)

    it "rejects a truncated chunk (size larger than data) with 400":
        val r = decode_chunked_bounded("5\r\nhi\r\n0\r\n\r\n", 1024)
        expect(r.0.starts_with("400")).to_be(true)

    it "rejects a chunk missing its CRLF terminator with 400":
        step("Data followed by non-CRLF bytes must not be silently accepted")
        val r = decode_chunked_bounded("5\r\nhelloXX0\r\n\r\n", 1024)
        expect(r.0.starts_with("400")).to_be(true)

    it "rejects a decoded body exceeding max_body with 413":
        step("Decoded size, not the encoded size, is what bounds memory")
        val r = decode_chunked_bounded("5\r\nhello\r\n0\r\n\r\n", 3)
        expect(r.0.starts_with("413")).to_be(true)

describe "http_core — chunked_body_end_scan distinguishes invalid from incomplete":
    it "returns a positive end offset for complete framing":
        val end = chunked_body_end_scan("5\r\nhello\r\n0\r\n\r\n")
        expect(end).to_equal(15)

    it "returns -2 (provably invalid) on a bad chunk-size field":
        expect(chunked_body_end_scan("zz\r\nhello\r\n0\r\n\r\n")).to_equal(-2)

    it "returns -1 (need more bytes) when the chunk data is truncated":
        step("A short read must ask for more, never mis-frame")
        expect(chunked_body_end_scan("5\r\nhel")).to_equal(-1)

    it "does not mistake a 0-chunk marker embedded in chunk DATA for the end":
        step("'0\\r\\n\\r\\n' inside data must be consumed as data, not termination")
        val payload = "0\r\n\r\n"
        val buf = "5\r\n" + payload + "\r\n0\r\n\r\n"
        val end = chunked_body_end_scan(buf)
        expect(end).to_equal(buf.len())

describe "http_core — duplicate singleton security headers are a smuggling vector":
    it "accepts a single Host header":
        val d = body_decision([("Host", "example.com")], 1024, false)
        expect(d.0).to_equal("")

    it "rejects a duplicate Host header with 400":
        step("Two Host headers let a proxy and origin disagree on authority")
        val d = body_decision([("Host", "a.com"), ("Host", "a.com")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

    it "rejects conflicting duplicate Host headers with 400":
        val d = body_decision([("Host", "a.com"), ("Host", "evil.com")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

    it "rejects duplicate X-Forwarded-Host (spoofed forwarding chain)":
        val d = body_decision([("X-Forwarded-Host", "a"), ("X-Forwarded-Host", "b")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

    it "rejects duplicate Authorization headers":
        val d = body_decision([("Authorization", "Bearer x"), ("Authorization", "Bearer y")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

describe "http_core — request-limit checks fail closed with correct status":
    it "rejects an over-long request line with 414":
        val limits = http_limits_default()
        val long_line = "GET /" + repeat_char("a", 9000) + " HTTP/1.1"
        val err = check_request_line(long_line, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(414)
            nil:
                expect(false).to_be(true)

    it "rejects a malformed request line (too few parts) with 400":
        val limits = http_limits_default()
        val err = check_request_line("GET", limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(400)
            nil:
                expect(false).to_be(true)

    it "accepts a well-formed request line":
        val limits = http_limits_default()
        expect(check_request_line("GET / HTTP/1.1", limits).is_none()).to_be(true)

    it "rejects too many headers with 400":
        val limits = http_limits_default()
        val err = check_header_count(101, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(400)
            nil:
                expect(false).to_be(true)

    it "rejects an over-long single header line with 400":
        val limits = http_limits_default()
        val big_value = repeat_char("v", 9000)
        val err = check_header_size("X-Big", big_value, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(400)
            nil:
                expect(false).to_be(true)

    it "rejects an over-sized body with 413":
        val limits = http_limits_default()
        val err = check_body_size(20000000, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(413)
            nil:
                expect(false).to_be(true)

    it "accepts a body within the limit":
        val limits = http_limits_default()
        expect(check_body_size(1024, limits).is_none()).to_be(true)

describe "http_core — path guard rejects backslash traversal variants":
    it "rejects backslash dot-dot traversal":
        expect(path_is_safe("/static\\..\\secret")).to_be(false)

    it "rejects encoded-backslash dot-dot traversal":
        expect(path_is_safe("/static/..%5csecret")).to_be(false)

    it "rejects a raw null byte in the path":
        expect(path_is_safe("/a\0b")).to_be(false)

    it "is_safe_static_path rejects a relative (no leading slash) path":
        expect(is_safe_static_path("static/file")).to_be(false)

    it "is_safe_static_path rejects a dot-dot traversal":
        expect(is_safe_static_path("/static/../etc/passwd")).to_be(false)

    it "is_safe_static_path accepts a normal absolute path":
        expect(is_safe_static_path("/static/app.js")).to_be(true)
