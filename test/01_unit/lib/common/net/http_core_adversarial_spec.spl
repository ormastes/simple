# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that http_core — hex_chunk_size fails closed on hostile chunk sizes.
Audience: compiler and tooling engineers who maintain this spec.
"""
use std.spec.step
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

"""
# http_core — adversarial edge hardening (lane W17-B)

Adversarial edge coverage for the unified HTTP core
(`src/lib/common/net/http_core.spl`) beyond the happy-path guards already
fenced by `http_core_spec.spl`. Every scenario here drives a real core entry
point with hostile input and asserts the SAFE outcome (rejected / bounded /
not smuggled). These are regression fences on the hardened behaviour — the
core already handles each case; this locks that in so a future refactor of
`body_decision` / the chunked decoder / the request-limit checks cannot
silently reopen a smuggling or resource-exhaustion hole.

**Gaps this closes (were untested before W17-B):**
  - `hex_chunk_size` bad-hex / empty / overflow bounds (directly)
  - `decode_chunked_bounded` malformed framing, truncation, missing
    terminator, and 413-on-decoded-size (directly)
  - `chunked_body_end_scan` invalid vs incomplete framing (directly)
  - duplicate/conflicting singleton security headers (Host, Authorization,
    Origin, X-Forwarded-Host, X-Forwarded-Proto) — header-smuggling vector
  - `HttpParseError` request-line / header-count / header-size / body-size
    limit checks and their status mapping
  - backslash and encoded-backslash path traversal

Lane: .spipe/simple_enterprise_suite (Wave A hardening follow-up W17-B).
"""

use std.spec.step

use std.spec.*
use std.common.net.http_core.{
    body_decision, request_authority_error, http_authority_valid,
    hex_chunk_size,
    decode_chunked_bounded,
    chunked_body_end_scan,
    HttpLimits, http_limits_default,
    HttpParseError, http_parse_error_status,
    check_request_line, check_header_count, check_header_size, check_body_size,
    path_is_safe, is_safe_static_path
}

fn repeat_char(c: text, n: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < n:
        out = out + c
        i = i + 1
    out

describe "http_core — hex_chunk_size fails closed on hostile chunk sizes":
    # @manual scenario evidence
    it "parses a valid lowercase hex chunk size":
        # @req REQ-SSPEC-LIB
        step("parses a valid lowercase hex chunk size")
        step("Verify: parses a valid lowercase hex chunk size")
        # @req: REQ-LIB-COMMON-001
        expect(hex_chunk_size("ff")).to_equal(255)

    it "parses a valid uppercase hex chunk size":
        # @req REQ-SSPEC-LIB
        step("parses a valid uppercase hex chunk size")
        step("Verify: parses a valid uppercase hex chunk size")
        expect(hex_chunk_size("1A")).to_equal(26)

    it "rejects an empty chunk-size field":
        # @req REQ-SSPEC-LIB
        step("rejects an empty chunk-size field")
        step("Verify: rejects an empty chunk-size field")
        expect(hex_chunk_size("")).to_equal(-1)

    it "rejects a non-hex character (smuggled garbage size)":
        # @req REQ-SSPEC-LIB
        step("rejects a non-hex character (smuggled garbage size)")
        step("Verify: rejects a non-hex character (smuggled garbage size)")
        expect(hex_chunk_size("xz")).to_equal(-1)

    it "rejects a chunk size beyond the 2^27 sanity bound":
        # @req REQ-SSPEC-LIB
        step("rejects a chunk size beyond the 2^27 sanity bound")
        step("A single 256 MiB chunk (10000000 hex) is hostile")
        expect(hex_chunk_size("10000000")).to_equal(-1)

describe "http_core — decode_chunked_bounded rejects malformed framing":
    it "decodes a well-formed chunked body":
        # @req REQ-SSPEC-LIB
        step("decodes a well-formed chunked body")
        step("Verify: decodes a well-formed chunked body")
        val r = decode_chunked_bounded("5\r\nhello\r\n0\r\n\r\n", 1024)
        expect(r.0).to_equal("")
        expect(r.1).to_equal("hello")

    it "rejects a bad chunk-size line with 400":
        # @req REQ-SSPEC-LIB
        step("rejects a bad chunk-size line with 400")
        step("Verify: rejects a bad chunk-size line with 400")
        val r = decode_chunked_bounded("zz\r\nhello\r\n0\r\n\r\n", 1024)
        expect(r.0.starts_with("400")).to_be(true)

    it "rejects a truncated chunk (size larger than data) with 400":
        # @req REQ-SSPEC-LIB
        step("rejects a truncated chunk (size larger than data) with 400")
        step("Verify: rejects a truncated chunk (size larger than data) with 400")
        val r = decode_chunked_bounded("5\r\nhi\r\n0\r\n\r\n", 1024)
        expect(r.0.starts_with("400")).to_be(true)

    it "rejects a chunk missing its CRLF terminator with 400":
        # @req REQ-SSPEC-LIB
        step("rejects a chunk missing its CRLF terminator with 400")
        step("Data followed by non-CRLF bytes must not be silently accepted")
        val r = decode_chunked_bounded("5\r\nhelloXX0\r\n\r\n", 1024)
        expect(r.0.starts_with("400")).to_be(true)

    it "rejects a decoded body exceeding max_body with 413":
        # @req REQ-SSPEC-LIB
        step("rejects a decoded body exceeding max_body with 413")
        step("Decoded size, not the encoded size, is what bounds memory")
        val r = decode_chunked_bounded("5\r\nhello\r\n0\r\n\r\n", 3)
        expect(r.0.starts_with("413")).to_be(true)

describe "http_core — chunked_body_end_scan distinguishes invalid from incomplete":
    it "returns a positive end offset for complete framing":
        # @req REQ-SSPEC-LIB
        step("returns a positive end offset for complete framing")
        step("Verify: returns a positive end offset for complete framing")
        val end = chunked_body_end_scan("5\r\nhello\r\n0\r\n\r\n")
        expect(end).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "returns -2 (provably invalid) on a bad chunk-size field":
        # @req REQ-SSPEC-LIB
        step("returns -2 (provably invalid) on a bad chunk-size field")
        step("Verify: returns -2 (provably invalid) on a bad chunk-size field")
        expect(chunked_body_end_scan("zz\r\nhello\r\n0\r\n\r\n")).to_equal(-2)

    it "returns -1 (need more bytes) when the chunk data is truncated":
        # @req REQ-SSPEC-LIB
        step("returns -1 (need more bytes) when the chunk data is truncated")
        step("A short read must ask for more, never mis-frame")
        expect(chunked_body_end_scan("5\r\nhel")).to_equal(-1)

    it "does not mistake a 0-chunk marker embedded in chunk DATA for the end":
        # @req REQ-SSPEC-LIB
        step("does not mistake a 0-chunk marker embedded in chunk DATA for the end")
        step("'0\\r\\n\\r\\n' inside data must be consumed as data, not termination")
        val payload = "0\r\n\r\n"
        val buf = "5\r\n" + payload + "\r\n0\r\n\r\n"
        val end = chunked_body_end_scan(buf)
        expect(end).to_equal(buf.len())

describe "http_core — duplicate singleton security headers are a smuggling vector":
    it "accepts a single Host header":
        # @req REQ-SSPEC-LIB
        step("accepts a single Host header")
        step("Verify: accepts a single Host header")
        val d = body_decision([("Host", "example.com")], 1024, false)
        expect(d.0).to_equal("")

    it "rejects a duplicate Host header with 400":
        # @req REQ-SSPEC-LIB
        step("rejects a duplicate Host header with 400")
        step("Two Host headers let a proxy and origin disagree on authority")
        val d = body_decision([("Host", "a.com"), ("Host", "a.com")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

    it "rejects conflicting duplicate Host headers with 400":
        # @req REQ-SSPEC-LIB
        step("rejects conflicting duplicate Host headers with 400")
        step("Verify: rejects conflicting duplicate Host headers with 400")
        val d = body_decision([("Host", "a.com"), ("Host", "evil.com")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

    it "rejects duplicate X-Forwarded-Host (spoofed forwarding chain)":
        # @req REQ-SSPEC-LIB
        step("rejects duplicate X-Forwarded-Host (spoofed forwarding chain)")
        step("Verify: rejects duplicate X-Forwarded-Host (spoofed forwarding chain)")
        val d = body_decision([("X-Forwarded-Host", "a"), ("X-Forwarded-Host", "b")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

    it "rejects duplicate Authorization headers":
        # @req REQ-SSPEC-LIB
        step("rejects duplicate Authorization headers")
        step("Verify: rejects duplicate Authorization headers")
        val d = body_decision([("Authorization", "Bearer x"), ("Authorization", "Bearer y")], 1024, false)
        expect(d.0.starts_with("400")).to_be(true)

describe "http_core — HTTP/1 authority is singular, valid, and consistent":
    it "requires exactly one Host for HTTP/1.1 but keeps it optional for HTTP/1.0":
        step("Make the shared pre-dispatch policy decide both protocol versions")
        expect(request_authority_error([], "HTTP/1.1", "/")).to_contain("Missing Host")
        expect(request_authority_error([], "HTTP/1.0", "/")).to_equal("")
        expect(request_authority_error([], "HTTP/1.0", "http://legacy.test/")).to_equal("")
        expect(request_authority_error([("Host", "a"), ("host", "a")], "HTTP/1.1", "/")).to_contain("Multiple Host")

    it "rejects empty, userinfo, whitespace, malformed brackets, and nonnumeric ports":
        step("Exercise bounded authority grammar without a socket or dispatcher")
        expect(http_authority_valid("")).to_be(false)
        expect(http_authority_valid("user@example.test")).to_be(false)
        expect(http_authority_valid("example test")).to_be(false)
        expect(http_authority_valid("[::1")).to_be(false)
        expect(http_authority_valid("[:::]")).to_be(false)
        expect(http_authority_valid("[v]")).to_be(false)
        expect(http_authority_valid("example.test:http")).to_be(false)
        expect(http_authority_valid("[::1]:8080")).to_be(true)

    it "accepts case-only absolute-form agreement and rejects authority mismatch":
        val headers = [("Host", "example.TEST:8080")]
        expect(request_authority_error(headers, "HTTP/1.1", "http://Example.test:8080/path?q=1")).to_equal("")
        expect(request_authority_error(headers, "HTTP/1.1", "http://evil.test:8080/path")).to_contain("does not match")
        expect(request_authority_error(headers, "HTTP/1.1", "ftp://evil.test:8080/path")).to_contain("does not match")

    it "rejects an empty or invalid absolute-form authority":
        val headers = [("Host", "example.test")]
        expect(request_authority_error(headers, "HTTP/1.1", "http:///path")).to_contain("Empty absolute-form")
        expect(request_authority_error(headers, "HTTP/1.1", "http://user@example.test/path")).to_contain("Invalid absolute-form")

describe "http_core — request-limit checks fail closed with correct status":
    it "rejects an over-long request line with 414":
        # @req REQ-SSPEC-LIB
        step("rejects an over-long request line with 414")
        step("Verify: rejects an over-long request line with 414")
        val limits = http_limits_default()
        val long_line = "GET /" + repeat_char("a", 9000) + " HTTP/1.1"
        val err = check_request_line(long_line, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(414)  # oracle: 414 — named expected value from the requirement
            nil:
                expect(false).to_be(true)

    it "rejects a malformed request line (too few parts) with 400":
        # @req REQ-SSPEC-LIB
        step("rejects a malformed request line (too few parts) with 400")
        step("Verify: rejects a malformed request line (too few parts) with 400")
        val limits = http_limits_default()
        val err = check_request_line("GET", limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(400)  # oracle: 400 — named expected value from the requirement
            nil:
                expect(false).to_be(true)

    it "accepts a well-formed request line":
        # @req REQ-SSPEC-LIB
        step("accepts a well-formed request line")
        step("Verify: accepts a well-formed request line")
        val limits = http_limits_default()
        expect(check_request_line("GET / HTTP/1.1", limits).is_none()).to_be(true)

    it "rejects too many headers with 400":
        # @req REQ-SSPEC-LIB
        step("rejects too many headers with 400")
        step("Verify: rejects too many headers with 400")
        val limits = http_limits_default()
        val err = check_header_count(101, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(400)  # oracle: 400 — named expected value from the requirement
            nil:
                expect(false).to_be(true)

    it "rejects an over-long single header line with 400":
        # @req REQ-SSPEC-LIB
        step("rejects an over-long single header line with 400")
        step("Verify: rejects an over-long single header line with 400")
        val limits = http_limits_default()
        val big_value = repeat_char("v", 9000)
        val err = check_header_size("X-Big", big_value, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(400)  # oracle: 400 — named expected value from the requirement
            nil:
                expect(false).to_be(true)

    it "rejects an over-sized body with 413":
        # @req REQ-SSPEC-LIB
        step("rejects an over-sized body with 413")
        step("Verify: rejects an over-sized body with 413")
        val limits = http_limits_default()
        val err = check_body_size(20000000, limits)
        expect(err.is_some()).to_be(true)
        match err:
            Some(e):
                expect(http_parse_error_status(e)).to_equal(413)  # oracle: 413 — named expected value from the requirement
            nil:
                expect(false).to_be(true)

    it "accepts a body within the limit":
        # @req REQ-SSPEC-LIB
        step("accepts a body within the limit")
        step("Verify: accepts a body within the limit")
        val limits = http_limits_default()
        expect(check_body_size(1024, limits).is_none()).to_be(true)

describe "http_core — path guard rejects backslash traversal variants":
    it "rejects backslash dot-dot traversal":
        # @req REQ-SSPEC-LIB
        step("rejects backslash dot-dot traversal")
        step("Verify: rejects backslash dot-dot traversal")
        expect(path_is_safe("/static\\..\\secret")).to_be(false)

    it "rejects encoded-backslash dot-dot traversal":
        # @req REQ-SSPEC-LIB
        step("rejects encoded-backslash dot-dot traversal")
        step("Verify: rejects encoded-backslash dot-dot traversal")
        expect(path_is_safe("/static/..%5csecret")).to_be(false)

    it "rejects a raw null byte in the path":
        # @req REQ-SSPEC-LIB
        step("rejects a raw null byte in the path")
        step("Verify: rejects a raw null byte in the path")
        expect(path_is_safe("/a\0b")).to_be(false)

    it "is_safe_static_path rejects a relative (no leading slash) path":
        # @req REQ-SSPEC-LIB
        step("is_safe_static_path rejects a relative (no leading slash) path")
        step("Verify: is_safe_static_path rejects a relative (no leading slash) path")
        expect(is_safe_static_path("static/file")).to_be(false)

    it "is_safe_static_path rejects a dot-dot traversal":
        # @req REQ-SSPEC-LIB
        step("is_safe_static_path rejects a dot-dot traversal")
        step("Verify: is_safe_static_path rejects a dot-dot traversal")
        expect(is_safe_static_path("/static/../etc/passwd")).to_be(false)

    it "is_safe_static_path accepts a normal absolute path":
        # @req REQ-SSPEC-LIB
        step("is_safe_static_path accepts a normal absolute path")
        step("Verify: is_safe_static_path accepts a normal absolute path")
        expect(is_safe_static_path("/static/app.js")).to_be(true)
