# Purpose and audience: executable specification evidence for the owning engineering team.
# Pins the fix for doc/08_tracking/bug/fixedvec_splat_boxing_mismatch_breaks_simd_scan_2026-09-13.md:
# a FixedVec built by fixedvec_splat (value flows through the generic T parameter) must compare
# EQUAL, lane for lane, to a FixedVec built by fixedvec_from_array from a [u8] array — the
# standard SIMD scan idiom ("splat the needle, compare against array-sourced lanes").
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec
use std.gc_sync_mut.simd.fixed.{fixedvec_splat, fixedvec_from_array}

describe "fixedvec_splat vs fixedvec_from_array representation parity":

    it "cmp_eq matches every lane across the two construction paths":
        # @req REQ-SSPEC-UNIT
        step("splat a u8 needle and compare against an equal from_array vector")
        val s = fixedvec_splat(13u8, 16)
        val fa = fixedvec_from_array([13u8; 16])
        val eq = s.cmp_eq(fa)
        expect(eq.any()).to_equal(true)
        expect(eq.all()).to_equal(true)

    it "elements compare equal individually across construction paths":
        # @req REQ-SSPEC-UNIT
        step("lane 0 element equality is representation-independent")
        val s = fixedvec_splat(13u8, 16)
        val fa = fixedvec_from_array([13u8; 16])
        expect(s.elements[0] == fa.elements[0]).to_equal(true)

    it "same-construction cmp_eq is all-true and any-true":
        # @req REQ-SSPEC-UNIT
        step("self-consistency of both constructors")
        val x = [13u8; 16]
        expect(fixedvec_from_array(x).cmp_eq(fixedvec_from_array(x)).all()).to_equal(true)
        expect(fixedvec_splat(7u8, 16).cmp_eq(fixedvec_splat(7u8, 16)).all()).to_equal(true)

    it "differing values do not compare equal":
        # @req REQ-SSPEC-UNIT
        step("negative case: splat vs from_array with different payloads")
        val s = fixedvec_splat(13u8, 16)
        val fa = fixedvec_from_array([14u8; 16])
        expect(s.cmp_eq(fa).any()).to_equal(false)
