# @tag: unit, regression
# Regression for doc/08_tracking/bug/tree_wipe_module_damage_census_2026-08-04.md:
# symbols the tree wipe deleted while live code still imports them.

use std.spec
use std.spec.step
use common.animation.spring.{SpringConfig, SpringAnimation, spring_progress}
use lib.common.win_fs.window_record.{WindowState, window_state_name}
use std.nogc_async_mut.js.engine.interpreter.{_resolve_fetch_url}

describe "tree-wipe restored symbols":
    it "spring_progress reports normalized progress":
        step("halfway between 0 and 10")
        val a = SpringAnimation(config: SpringConfig(stiffness: 1.0, damping: 1.0, mass: 1.0), from_value: 0.0, to_value: 10.0, velocity: 0.0, current: 5.0, elapsed: 0.0, is_complete: false)
        expect(spring_progress(a)).to_equal(0.5)

    it "window_state_name names each state":
        step("Maximized and Hidden")
        expect(window_state_name(WindowState.Maximized)).to_equal("Maximized")
        expect(window_state_name(WindowState.Hidden)).to_equal("Hidden")

    it "_resolve_fetch_url resolves relative, absolute and fragment hrefs":
        step("relative to the base directory")
        expect(_resolve_fetch_url("https://a.test/x/page.html?q=1", "data.json")).to_equal("https://a.test/x/data.json")
        step("root-relative and protocol-relative")
        expect(_resolve_fetch_url("https://a.test/x/page.html", "/api")).to_equal("https://a.test/api")
        expect(_resolve_fetch_url("https://a.test/x/", "//cdn.test/y")).to_equal("https:" + "//cdn.test/y")
        step("query, fragment, absolute, empty")
        expect(_resolve_fetch_url("https://a.test/p?a=1#f", "?b=2")).to_equal("https://a.test/p?b=2")
        expect(_resolve_fetch_url("https://a.test/p#f", "#g")).to_equal("https://a.test/p#g")
        expect(_resolve_fetch_url("https://a.test/p", "http://b.test/")).to_equal("http://b.test/")
        expect(_resolve_fetch_url("https://a.test/p", "")).to_equal("https://a.test/p")
        expect(_resolve_fetch_url("https://a.test", "z")).to_equal("https://a.test/z")
