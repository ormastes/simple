# @cover src/lib/common/process/receipt_invariants_v4.spl 100%
# importance: critical (weight: 3)
"""Receipt-invariant contract for the V4 pure process observation schema."""

use std.spec.*
use std.common.process.observation_v4.{
    ProcessObservationWireV4, POV4_VALID_EXEC_CONFIRMED,
    decode_process_observation_v4
}
use std.common.process.receipt_invariants_v4.{
    process_observation_receipt_invariants_valid_v4
}

fn _binding() -> [u8]:
    var result: [u8] = []
    var index = 0
    while index < 32:
        result.push(index as u8)
        index = index + 1
    result

fn _golden_receipt_v4() -> ProcessObservationWireV4:
    ProcessObservationWireV4(
        words: [4, 2, 64, 2, 1, 2, 3, 4, 7, 255, 0, 0, 0, 3, 0, 42, 0,
            0, 0, 10, 11, 12, 13, 14, 15, 20, 20, 30, 0, 0, 0, 0, 1, 1,
            1, 1, 3, 4, 7, 0, 2, 100, 1, 0, 0, 1, 1, 1, 1, 2, 0, 2, 2,
            2, 2, 0, 1, 1, 1, 1, 2, 1, 32, 0],
        stdout: [111u8, 107u8], stderr: [33u8], binding: _binding())

describe "process observation V4 receipt invariants [importance=critical; weight=3]":
    it "accepts the canonical frozen terminal receipt":
        val receipt = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        expect(process_observation_receipt_invariants_valid_v4(receipt).is_ok()).to_equal(true)

    it "requires a nonnegative start when confirmed, reaped, or tree-empty facts exist":
        var receipt = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        receipt.packet.process_started_ns = -1
        expect(process_observation_receipt_invariants_valid_v4(receipt).is_err()).to_equal(true)

    it "enforces monotonic process event ordering":
        var receipt = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        receipt.packet.leader_waited_ns = 12
        expect(process_observation_receipt_invariants_valid_v4(receipt).is_err()).to_equal(true)

    it "enforces flags and timestamp presence in both directions":
        var no_exec_bit = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        no_exec_bit.packet.validity_bits = no_exec_bit.packet.validity_bits & ~POV4_VALID_EXEC_CONFIRMED
        expect(process_observation_receipt_invariants_valid_v4(no_exec_bit).is_err()).to_equal(true)
        var no_reap_flag = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        no_reap_flag.packet.leader_reaped = false
        expect(process_observation_receipt_invariants_valid_v4(no_reap_flag).is_err()).to_equal(true)

    it "requires frozen terminal completion and exact delivered payloads":
        var unfinished = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        unfinished.packet.tree_empty = false
        unfinished.packet.tree_empty_ns = -1
        expect(process_observation_receipt_invariants_valid_v4(unfinished).is_err()).to_equal(true)
        var truncated = decode_process_observation_v4(_golden_receipt_v4()).unwrap()
        truncated.stdout = []
        expect(process_observation_receipt_invariants_valid_v4(truncated).is_err()).to_equal(true)
