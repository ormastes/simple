use std.spec
use lib.common.search.types.{Score}
use lib.common.search.top_k.{TextScoredDoc, text_top_k, SearchPageV1}

describe "public ID top-k":
    it "uses score descending then UTF-8 text ID ascending":
        step("Rank equal scores deterministically")
        val hits = text_top_k([TextScoredDoc.of("b", Score.from_milli(5)), TextScoredDoc.of("a", Score.from_milli(5))], 2)
        expect(hits[0].document_id).to_equal("a")
        expect(SearchPageV1.of("sha256:r", hits, nil, true).exhausted).to_equal(true)

