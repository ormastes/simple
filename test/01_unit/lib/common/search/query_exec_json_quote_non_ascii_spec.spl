# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/len_bounded_byte_scanners_non_ascii_2026_11_14.md
# The explanation-JSON string quoter walked bytes up to s.len() (code points),
# dropping the tail (and its quote escapes) after any multi-byte character.

use std.spec.*
use std.common.search.query_exec.{query_exec_json_quote_v1}
use std.common.json.value.{JsonValue, json_parse_value_strict}

fn _decoded(raw: text) -> text:
    match json_parse_value_strict(query_exec_json_quote_v1(raw)):
        case Ok(JsonValue.Str(v)): v
        case Ok(_): "<not a string>"
        case Err(e): "<parse error: " + e + ">"

describe "explanation JSON string quoting on non-ASCII terms":
    it "round-trips a term with multi-byte characters and an embedded quote":
        # @req REQ-SSPEC-UNIT
        step("quote café\"ü and decode the JSON back")
        expect(_decoded("café\"ü")).to_equal("café\"ü")

    it "round-trips an ASCII term with a backslash (control)":
        # @req REQ-SSPEC-UNIT
        step("quote a\b and decode the JSON back")
        expect(_decoded("a\b")).to_equal("a\b")
