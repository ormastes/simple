# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.spec

use lib.common.search.explain_build.{FieldInputV1, FieldTermInputV1, build_explanation, utf8_hex}
use lib.common.search.field_stats.{build_field_stats, build_field_stats_table}
use lib.common.search.ranking.{bm25_term_checked_trace}

describe "P3 explanation completion — recompute against the reported score":
    it "sums term contributions into a field total that recomputes exactly":
        # @req REQ-SSPEC-LIB
        step("sums term contributions into a field total that recomputes exactly")
        step("Build one field with one scored term and one absent term")
        val stats = build_field_stats("body", [6, 6, 6]).unwrap()
        val terms = [
            FieldTermInputV1.of("alpha", 1, 2),
            FieldTermInputV1.of("zeta", 0, 0),
        ]
        val field = FieldInputV1.of("body", 6, stats, terms)
        val explanation = build_explanation(
            "spipe-unicode-lex-v1", "spipe-lexical-snapshot-v1", "sha256:s",
            "sha256:r", "doc-1", [field]).unwrap()

        step("Recompute the scored term independently from the trace")
        val trace = bm25_term_checked_trace(1, 6, 18, 3, 2, 1000).unwrap()
        expect(explanation.term_contributions.len()).to_equal(2)
        expect(explanation.term_contributions[0].term).to_equal("alpha")
        expect(explanation.term_contributions[0].present).to_equal(true)
        expect(explanation.term_contributions[0].contribution_scaled).to_equal(trace.weighted.to_text())
        expect(explanation.term_contributions[1].term).to_equal("zeta")
        expect(explanation.term_contributions[1].present).to_equal(false)
        expect(explanation.term_contributions[1].contribution_scaled).to_equal("0")

        step("Field total and internal total must equal the checked sum of contributions")
        expect(explanation.fields.len()).to_equal(1)
        expect(explanation.fields[0].field_total).to_equal(trace.weighted.to_text())
        expect(explanation.internal_total).to_equal(trace.weighted.to_text())

        step("public_score_milli must be internal_total / 1000, recomputed independently")
        expect(explanation.public_score_milli).to_equal(trace.weighted / 1000)

        step("tie_key_utf8_hex must be the UTF-8 hex of the document id")
        expect(explanation.tie_key_utf8_hex).to_equal(utf8_hex("doc-1"))
        expect(explanation.tie_key_utf8_hex).to_equal("646f632d31")

    it "reconciles across two authorized fields in canonical order":
        # @req REQ-SSPEC-LIB
        step("reconciles across two authorized fields in canonical order")
        step("Build title and body fields, each with one scored term")
        val title_stats = build_field_stats("title", [6, 6, 6]).unwrap()
        val body_stats = build_field_stats("body", [6, 6, 6]).unwrap()
        val title_field = FieldInputV1.of(
            "title", 6, title_stats, [FieldTermInputV1.of("alpha", 1, 2)])
        val body_field = FieldInputV1.of(
            "body", 6, body_stats, [FieldTermInputV1.of("alpha", 1, 2)])
        val explanation = build_explanation(
            "spipe-unicode-lex-v1", "spipe-lexical-snapshot-v1", "sha256:s",
            "sha256:r", "doc-2", [title_field, body_field]).unwrap()

        step("Recompute both field traces independently")
        val title_trace = bm25_term_checked_trace(1, 6, 18, 3, 2, 4000).unwrap()
        val body_trace = bm25_term_checked_trace(1, 6, 18, 3, 2, 1000).unwrap()

        step("Each field total matches its own trace; internal_total is the checked sum")
        expect(explanation.fields[0].field).to_equal("title")
        expect(explanation.fields[0].field_total).to_equal(title_trace.weighted.to_text())
        expect(explanation.fields[1].field).to_equal("body")
        expect(explanation.fields[1].field_total).to_equal(body_trace.weighted.to_text())
        val expected_internal = title_trace.weighted + body_trace.weighted
        expect(explanation.internal_total).to_equal(expected_internal.to_text())
        expect(explanation.public_score_milli).to_equal(expected_internal / 1000)

    it "rejects fields given out of canonical authorized order":
        # @req REQ-SSPEC-LIB
        step("rejects fields given out of canonical authorized order")
        val title_stats = build_field_stats("title", [6]).unwrap()
        val body_stats = build_field_stats("body", [6]).unwrap()
        val title_field = FieldInputV1.of("title", 6, title_stats, [])
        val body_field = FieldInputV1.of("body", 6, body_stats, [])
        val result = build_explanation(
            "spipe-unicode-lex-v1", "spipe-lexical-snapshot-v1", "sha256:s",
            "sha256:r", "doc-3", [body_field, title_field])
        expect(result.is_err()).to_equal(true)

    it "rejects terms given out of ascending UTF-8 order within a field":
        # @req REQ-SSPEC-LIB
        step("rejects terms given out of ascending UTF-8 order within a field")
        val stats = build_field_stats("body", [6]).unwrap()
        val field = FieldInputV1.of("body", 6, stats, [
            FieldTermInputV1.of("zeta", 0, 0),
            FieldTermInputV1.of("alpha", 0, 0),
        ])
        val result = build_explanation(
            "spipe-unicode-lex-v1", "spipe-lexical-snapshot-v1", "sha256:s",
            "sha256:r", "doc-4", [field])
        expect(result.is_err()).to_equal(true)

    it "builds per-field statistics as N live documents, total length, and scaled average":
        # @req REQ-SSPEC-LIB
        step("builds per-field statistics as N live documents, total length, and scaled average")
        val stats = build_field_stats("heading", [2, 4]).unwrap()
        expect(stats.field).to_equal("heading")
        expect(stats.num_docs).to_equal(2)
        expect(stats.total_length).to_equal(6)
        expect(stats.average_length_scaled).to_equal(3000000)

    it "builds a per-field statistics table only in canonical field order":
        # @req REQ-SSPEC-LIB
        step("builds a per-field statistics table only in canonical field order")
        val ok = build_field_stats_table(["title", "body"], [[6, 12], [6, 12]])
        expect(ok.is_ok()).to_equal(true)
        val bad = build_field_stats_table(["body", "title"], [[6, 12], [6, 12]])
        expect(bad.is_err()).to_equal(true)
