# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# design: doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md §7 ; plan: doc/03_plan/infra/spipe/spipe_search_providers_impl_plan.md — P10

use std.spec.step
use std.spec
use lib.common.search.fingerprint.{
    SIMILARITY_SCALE, shingles_of_tokens, minhash_signature, minhash_jaccard_estimate,
    simhash_fingerprint, simhash_similarity, hamming_distance64, stable_hash64,
}
use lib.common.search.similarity.{build_sparse_vector, cosine_similarity_fixed}

describe "duplicate-detection primitives: shingles, MinHash, SimHash, cosine":
    it "hashes identical token windows to identical shingle hashes":
        # @req REQ-SSPEC-UNIT
        step("hashes identical token windows to identical shingle hashes")
        val a = shingles_of_tokens(["the", "quick", "brown", "fox"], 2)
        val b = shingles_of_tokens(["the", "quick", "brown", "fox"], 2)
        expect(a.hashes).to_equal(b.hashes)

    it "gives disjoint token streams a MinHash Jaccard estimate of zero":
        # @req REQ-SSPEC-UNIT
        step("gives disjoint token streams a MinHash Jaccard estimate of zero")
        val a = shingles_of_tokens(["alpha", "beta", "gamma"], 2)
        val b = shingles_of_tokens(["zulu", "yankee", "xray"], 2)
        val sig_a = minhash_signature(a, 32)
        val sig_b = minhash_signature(b, 32)
        expect(minhash_jaccard_estimate(sig_a, sig_b)).to_equal(0)

    it "gives identical token streams a MinHash Jaccard estimate of exactly SIMILARITY_SCALE":
        # @req REQ-SSPEC-UNIT
        step("gives identical token streams a MinHash Jaccard estimate of exactly SIMILARITY_SCALE")
        val tokens = ["café", "naïve", "résumé", "über", "façade"]
        val a = shingles_of_tokens(tokens, 2)
        val b = shingles_of_tokens(tokens, 2)
        val sig_a = minhash_signature(a, 16)
        val sig_b = minhash_signature(b, 16)
        expect(minhash_jaccard_estimate(sig_a, sig_b)).to_equal(SIMILARITY_SCALE)

    it "gives near-duplicate non-ASCII documents a high MinHash Jaccard estimate":
        # @req REQ-SSPEC-UNIT
        step("gives near-duplicate non-ASCII documents a high MinHash Jaccard estimate")
        val doc_a = ["café", "naïve", "résumé", "über", "façade", "jalapeño"]
        val doc_b = ["café", "naïve", "résumé", "über", "façade", "piñata"]
        val sig_a = minhash_signature(shingles_of_tokens(doc_a, 2), 64)
        val sig_b = minhash_signature(shingles_of_tokens(doc_b, 2), 64)
        val score = minhash_jaccard_estimate(sig_a, sig_b)
        expect(score > SIMILARITY_SCALE / 2).to_equal(true)

    it "hamming distance zero yields SimHash similarity of exactly SIMILARITY_SCALE":
        # @req REQ-SSPEC-UNIT
        step("hamming distance zero yields SimHash similarity of exactly SIMILARITY_SCALE")
        val tokens = ["日本語", "テスト", "文書", "類似度"]
        val fp_a = simhash_fingerprint(shingles_of_tokens(tokens, 1))
        val fp_b = simhash_fingerprint(shingles_of_tokens(tokens, 1))
        expect(hamming_distance64(fp_a.bits, fp_b.bits)).to_equal(0)
        expect(simhash_similarity(fp_a, fp_b)).to_equal(SIMILARITY_SCALE)

    it "gives dissimilar documents a lower SimHash similarity than near-duplicates":
        # @req REQ-SSPEC-UNIT
        step("gives dissimilar documents a lower SimHash similarity than near-duplicates")
        val base = ["the", "quick", "brown", "fox", "jumps", "over", "the", "lazy", "dog"]
        val near = ["the", "quick", "brown", "fox", "jumps", "over", "the", "sleepy", "dog"]
        val far = ["completely", "unrelated", "vocabulary", "about", "astrophysics", "orbits"]
        val fp_base = simhash_fingerprint(shingles_of_tokens(base, 2))
        val fp_near = simhash_fingerprint(shingles_of_tokens(near, 2))
        val fp_far = simhash_fingerprint(shingles_of_tokens(far, 2))
        val sim_near = simhash_similarity(fp_base, fp_near)
        val sim_far = simhash_similarity(fp_base, fp_far)
        expect(sim_near > sim_far).to_equal(true)

    it "computes cosine similarity of 1.0 (scaled) for identical sparse vectors":
        # @req REQ-SSPEC-UNIT
        step("computes cosine similarity of 1.0 (scaled) for identical sparse vectors")
        val v = build_sparse_vector(["naïve", "naïve", "café", "über"])
        expect(cosine_similarity_fixed(v, v)).to_equal(SIMILARITY_SCALE)

    it "computes cosine similarity of 0 for disjoint sparse vectors":
        # @req REQ-SSPEC-UNIT
        step("computes cosine similarity of 0 for disjoint sparse vectors")
        val a = build_sparse_vector(["alpha", "beta"])
        val b = build_sparse_vector(["gamma", "delta"])
        expect(cosine_similarity_fixed(a, b)).to_equal(0)

    it "hashes the same string to the same stable hash across calls":
        # @req REQ-SSPEC-UNIT
        step("hashes the same string to the same stable hash across calls")
        expect(stable_hash64("résumé")).to_equal(stable_hash64("résumé"))
        return ()
