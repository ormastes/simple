# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""Executable parity checks for the generated, host-independent UCD 17 adapter."""
# @req: REQ-SSPEC-LIB

use std.spec.step

use std.spec
use std.common.encoding.utf8.{text_from_codepoints, text_codepoints}
use lib.common.search.generated.unicode_17_0_0.{
    unicode_is_alphabetic, unicode_is_decimal_number, unicode_is_mark,
    unicode_is_token_code_point, unicode_canonical_combining_class,
    unicode_normalize_nfc, unicode_default_lowercase
}

extern fn rt_file_read_text(path: text) -> text?

fn _unicode_hex_digit(cp: i64) -> i64:
    if cp >= 48 and cp <= 57: return cp - 48
    if cp >= 65 and cp <= 70: return cp - 55
    if cp >= 97 and cp <= 102: return cp - 87
    -1

fn _unicode_parse_hex_sequence(field: text) -> text:
    var values: [i64] = []
    val tokens = field.trim().split(" ")
    var token_index: i64 = 0
    while token_index < tokens.len():
        val token = tokens[token_index]
        if token.len() > 0:
            val digits = text_codepoints(token)
            var value: i64 = 0
            var digit_index: i64 = 0
            while digit_index < digits.len():
                value = value * 16 + _unicode_hex_digit(digits[digit_index])
                digit_index = digit_index + 1
            values.push(value)
        token_index = token_index + 1
    text_from_codepoints(values)

fn _unicode_normalization_corpus_receipt() -> [i64]:
    val content = rt_file_read_text("examples/05_stdlib/spipe/tools/unicode/ucd/17.0.0/NormalizationTest.txt") ?? ""
    val lines = content.split("\n")
    var cases: i64 = 0
    var mismatches: i64 = 0
    var line_index: i64 = 0
    while line_index < lines.len():
        val without_comment = lines[line_index].split("#")[0].trim()
        if without_comment.len() > 0 and not without_comment.starts_with("@"):
            val fields = without_comment.split(";")
            if fields.len() >= 5:
                val c1 = _unicode_parse_hex_sequence(fields[0])
                val c2 = _unicode_parse_hex_sequence(fields[1])
                val c3 = _unicode_parse_hex_sequence(fields[2])
                val c4 = _unicode_parse_hex_sequence(fields[3])
                val c5 = _unicode_parse_hex_sequence(fields[4])
                if unicode_normalize_nfc(c1) != c2: mismatches = mismatches + 1
                if unicode_normalize_nfc(c2) != c2: mismatches = mismatches + 1
                if unicode_normalize_nfc(c3) != c2: mismatches = mismatches + 1
                if unicode_normalize_nfc(c4) != c4: mismatches = mismatches + 1
                if unicode_normalize_nfc(c5) != c4: mismatches = mismatches + 1
                cases = cases + 1
        line_index = line_index + 1
    [cases, mismatches]

fn _unicode_fold(current: i64, value: i64, modulus: i64) -> i64:
    (current * 65599 + value + 1) % modulus

fn _unicode_scalar_parity_fingerprint() -> [i64]:
    var first: i64 = 17
    var second: i64 = 17
    var cp: i64 = 0
    while cp <= 0x10FFFF:
        if cp < 0xD800 or cp > 0xDFFF:
            var property_bits: i64 = 0
            if unicode_is_alphabetic(cp): property_bits = property_bits + 1
            if unicode_is_decimal_number(cp): property_bits = property_bits + 2
            if unicode_is_mark(cp): property_bits = property_bits + 4
            if unicode_is_token_code_point(cp): property_bits = property_bits + 8
            val input = text_from_codepoints([cp])
            val normalized = text_codepoints(unicode_normalize_nfc(input))
            val lowered = text_codepoints(unicode_default_lowercase(input))
            first = _unicode_fold(first, cp, 1000000007)
            second = _unicode_fold(second, cp, 1000000009)
            first = _unicode_fold(first, property_bits, 1000000007)
            second = _unicode_fold(second, property_bits, 1000000009)
            val combining_class = unicode_canonical_combining_class(cp)
            first = _unicode_fold(first, combining_class, 1000000007)
            second = _unicode_fold(second, combining_class, 1000000009)
            first = _unicode_fold(first, normalized.len(), 1000000007)
            second = _unicode_fold(second, normalized.len(), 1000000009)
            var index: i64 = 0
            while index < normalized.len():
                first = _unicode_fold(first, normalized[index], 1000000007)
                second = _unicode_fold(second, normalized[index], 1000000009)
                index = index + 1
            first = _unicode_fold(first, 0x110000, 1000000007)
            second = _unicode_fold(second, 0x110000, 1000000009)
            first = _unicode_fold(first, lowered.len(), 1000000007)
            second = _unicode_fold(second, lowered.len(), 1000000009)
            index = 0
            while index < lowered.len():
                first = _unicode_fold(first, lowered[index], 1000000007)
                second = _unicode_fold(second, lowered[index], 1000000009)
                index = index + 1
            first = _unicode_fold(first, 0x110001, 1000000007)
            second = _unicode_fold(second, 0x110001, 1000000009)
        cp = cp + 1
    [first, second]

describe "pinned Unicode 17 generated adapter":
    # @manual scenario evidence
    it "classifies token scalars without host Unicode tables":
        # @req REQ-SSPEC-LIB
        step("classifies token scalars without host Unicode tables")
        step("Verify Unicode 17 categories and underscore token policy")
        expect(unicode_is_alphabetic(0x11DB0)).to_equal(true)
        expect(unicode_is_decimal_number(0x0665)).to_equal(true)
        expect(unicode_is_mark(0x0301)).to_equal(true)
        expect(unicode_is_token_code_point(0x005F)).to_equal(true)
        expect(unicode_is_token_code_point(0x002D)).to_equal(false)
        expect(unicode_canonical_combining_class(0x0301)).to_equal(230)

    it "normalizes canonical and algorithmic Hangul compositions":
        # @req REQ-SSPEC-LIB
        step("normalizes canonical and algorithmic Hangul compositions")
        step("Verify NFC canonical composition and Hangul algorithm")
        expect(unicode_normalize_nfc(text_from_codepoints([0x0041, 0x030A]))).to_equal(text_from_codepoints([0x00C5]))
        expect(unicode_normalize_nfc(text_from_codepoints([0x1100, 0x1161, 0x11A8]))).to_equal(text_from_codepoints([0xAC01]))
        expect(unicode_normalize_nfc(text_from_codepoints([0x0F73]))).to_equal(text_from_codepoints([0x0F71, 0x0F72]))

    it "applies default lowercase including final sigma and expansion":
        # @req REQ-SSPEC-LIB
        step("applies default lowercase including final sigma and expansion")
        step("Verify locale-independent Default Lowercase Conversion")
        expect(unicode_default_lowercase(text_from_codepoints([0x039F, 0x03A3]))).to_equal(text_from_codepoints([0x03BF, 0x03C2]))
        expect(unicode_default_lowercase(text_from_codepoints([0x039F, 0x03A3, 0x0391]))).to_equal(text_from_codepoints([0x03BF, 0x03C3, 0x03B1]))
        expect(text_codepoints(unicode_default_lowercase(text_from_codepoints([0x0130])))).to_equal([0x0069, 0x0307])

    it "passes all five NFC relations in the complete UCD normalization corpus":
        # @req REQ-SSPEC-LIB
        step("passes all five NFC relations in the complete UCD normalization corpus")
        step("Verify every NormalizationTest.txt vector through the generated Simple runtime")
        expect(_unicode_normalization_corpus_receipt()).to_equal([20034, 0])

    it "matches the JavaScript every-scalar Unicode 17 fingerprint":
        # @req REQ-SSPEC-LIB
        step("matches the JavaScript every-scalar Unicode 17 fingerprint")
        step("Verify properties, CCC, singleton NFC, and singleton lowercase for every Unicode scalar")
        expect(_unicode_scalar_parity_fingerprint()).to_equal([566308199, 235371174])
