# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# bug: doc/08_tracking/bug/stage2_codegen_large_array_literal_2026-11-02.md

"""Parity of the text-encoded Unicode 17 tables against the original [i64] array literals."""
# @req: REQ-SSPEC-LIB

use std.spec.step

use std.spec
use lib.common.search.generated.unicode_17_0_0.{unicode_table_samples_for_spec, unicode_is_alphabetic, unicode_canonical_combining_class}

describe "Unicode 17 text-encoded tables":
    # @manual scenario evidence
    it "decodes every table to the original length, first, middle and last entry":
        # @req REQ-SSPEC-LIB
        step("decodes every table to the original length, first, middle and last entry")
        step("Verify [len, first, mid, last] for all 17 tables, values copied from the pre-workaround literals")
        val expected: [i64] = [1522, 65, 43759, 210041, 144, 48, 65296, 130041, 654, 768, 43019, 917999, 316, 65, 11506, 127369, 928, 39, 42888, 917999, 968, 768, 6889, 125258, 968, 230, 230, 7, 2081, 192, 63785, 195101, 2082, 0, 2007, 3127, 3127, 65, 7950, 173568, 2883, 60, 772, 93546, 1563, 65, 7948, 125217, 1564, 0, 783, 1564, 1564, 97, 7940, 125251, 1564, 0, 1, 1, 1, 962, 962, 962, 1563, 0, 0, 0]
        expect(unicode_table_samples_for_spec()).to_equal(expected)

    it "is stable across repeated memoized accesses":
        # @req REQ-SSPEC-LIB
        step("is stable across repeated memoized accesses")
        step("Verify the second decode-cache read returns identical results")
        expect(unicode_is_alphabetic(210041)).to_equal(true)
        expect(unicode_is_alphabetic(210042)).to_equal(false)
        expect(unicode_canonical_combining_class(125258)).to_equal(7)
        expect(unicode_table_samples_for_spec().len()).to_equal(68)
