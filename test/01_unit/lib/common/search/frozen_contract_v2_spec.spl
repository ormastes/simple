# Purpose and audience: executable specification evidence for Package 0 of the
# SPipe search-providers slice — the frozen shared types every sibling package
# imports. Declarations-only contract: this spec asserts shape and identity
# constants, never algorithm.
# @req REQ-SSPEC-LIB
# plan: doc/03_plan/infra/spipe/spipe_search_providers_impl_plan.md

use std.spec

use lib.common.search.analyzer_contract.{SearchFieldIdentityV1, AnalyzerErrorV1, AnalyzerIdentityV1, AnalyzerLimitsV1, AnalyzedTokenV1, AnalyzedTextV1, AnalyzedQueryTermV1, AnalyzedQueryV1, ANALYZER_STOP_WORDS_ID, ANALYZER_STOP_WORDS_SHA256, ANALYZER_CONTRACT_V1_ID}
use lib.common.search.document.{SearchHitV1}
use lib.common.search.explain.{SearchExplanationV1, FieldExplanationV1, TermContributionV1}
use lib.common.search.corpus_stats.{FieldStatsV1, BM25_FIXED_V1_ID, BM25_SCALE, BM25_K1, BM25_B, BM25_LN2, BM25_FIELD_NAMES, BM25_FIELD_WEIGHTS}
use lib.common.search.snapshot.{CandidateRecordV1, PublicationRecordV1, DurableTerminalErrorV1, CandidateExpiryReceiptV1, QueryReceiptV1, OperationReceiptV1}
use lib.common.search.provider.{LexicalSearchPort, SearchProvider, ProviderErrorV1, RequestEnvelopeV1, TransportDiagnosticV1}
use lib.common.search.fusion_types.{FusionSourceV1, SourceCandidateV1, SourceRankingV1, MatchTierV1, FusedHitV1, IdentityExplanationV1, FusionExplanationV1, RRF_FIXED_V1_ID, RRF_DEFAULT_K, RRF_MIN_K, RRF_MAX_K, RRF_DEFAULT_SOURCE_K, RRF_MAX_SOURCE_K, RRF_MAX_POOL, RRF_BOOST_CAP_PERMILLE}
use lib.common.search.contract_ids.{PROVIDER_CONTRACT_ID, ANALYZER_CONTRACT_ID, SCORE_CONTRACT_ID, EXPLANATION_CONTRACT_ID, LOGICAL_INDEX_CONTRACT_ID, FUSION_CONTRACT_ID, CANONICAL_JSON_ID}
use lib.common.search.canonical_json.{CANONICAL_JSON_V1_ID, CANONICAL_JSON_SAFE_INTEGER_MAX}

describe "Package 0 frozen contract identity constants":
    it "freezes the seven contract IDs verbatim":
        step("Check §5.6 and §14.1 contract identity constants")
        expect(PROVIDER_CONTRACT_ID).to_equal("spipe-search-provider/1.0")
        expect(ANALYZER_CONTRACT_ID).to_equal("spipe-unicode-lex-v1")
        expect(SCORE_CONTRACT_ID).to_equal("bm25-fixed-v1")
        expect(EXPLANATION_CONTRACT_ID).to_equal("bm25-explain-v1")
        expect(LOGICAL_INDEX_CONTRACT_ID).to_equal("spipe-lexical-snapshot-v1")
        expect(FUSION_CONTRACT_ID).to_equal("rrf-fixed-v1")
        expect(CANONICAL_JSON_ID).to_equal("spipe-canonical-json-v1")
        expect(CANONICAL_JSON_V1_ID).to_equal(CANONICAL_JSON_ID)
        expect(CANONICAL_JSON_SAFE_INTEGER_MAX).to_equal(9007199254740991)

    it "freezes bm25-fixed-v1 scale/weight identity, matching ranking.spl's landed arithmetic":
        step("Check §5.2 BM25 identity constants and closed field order")
        expect(BM25_FIXED_V1_ID).to_equal("bm25-fixed-v1")
        expect(BM25_SCALE).to_equal(1000000)
        expect(BM25_K1).to_equal(1200000)
        expect(BM25_B).to_equal(750000)
        expect(BM25_LN2).to_equal(693147)
        expect(BM25_FIELD_NAMES.len()).to_equal(5)
        expect(BM25_FIELD_NAMES[0]).to_equal("identifier")
        expect(BM25_FIELD_NAMES[1]).to_equal("title")
        expect(BM25_FIELD_NAMES[2]).to_equal("heading")
        expect(BM25_FIELD_NAMES[3]).to_equal("classification")
        expect(BM25_FIELD_NAMES[4]).to_equal("body")
        expect(BM25_FIELD_WEIGHTS[0]).to_equal(4000)
        expect(BM25_FIELD_WEIGHTS[1]).to_equal(4000)
        expect(BM25_FIELD_WEIGHTS[2]).to_equal(2500)
        expect(BM25_FIELD_WEIGHTS[3]).to_equal(2000)
        expect(BM25_FIELD_WEIGHTS[4]).to_equal(1000)

    it "derives FieldStatsV1.average_length_scaled as floor(total*scale/num_docs)":
        step("Check §14.3 per-field statistics derivation")
        val stats = FieldStatsV1.of("body", 4, 100)
        expect(stats.field).to_equal("body")
        expect(stats.num_docs).to_equal(4)
        expect(stats.total_length).to_equal(100)
        expect(stats.average_length_scaled).to_equal(25000000)
        val empty = FieldStatsV1.of("body", 0, 0)
        expect(empty.average_length_scaled).to_equal(0)

    it "freezes the rrf-fixed-v1 identity and bounds":
        step("Check §5.5 RRF fusion contract constants")
        expect(RRF_FIXED_V1_ID).to_equal("rrf-fixed-v1")
        expect(RRF_DEFAULT_K).to_equal(60)
        expect(RRF_MIN_K).to_equal(1)
        expect(RRF_MAX_K).to_equal(10000)
        expect(RRF_DEFAULT_SOURCE_K).to_equal(1000)
        expect(RRF_MAX_SOURCE_K).to_equal(1000)
        expect(RRF_MAX_POOL).to_equal(3000)
        expect(RRF_BOOST_CAP_PERMILLE).to_equal(250)

    it "freezes the stop-word set identity asserted, not assumed":
        step("Check §15.2 en-basic-v1 stop-word identity")
        expect(ANALYZER_STOP_WORDS_ID).to_equal("en-basic-v1")
        expect(ANALYZER_STOP_WORDS_SHA256).to_equal("6f0a7c26d3d0e3d06a2fbbbeaa1843294f83c3be26baf1c04651191e011510bf")
        expect(ANALYZER_CONTRACT_V1_ID).to_equal("spipe-unicode-lex-v1")

    it "exposes AnalyzerLimitsV1.query_default as the frozen query limits tuple":
        step("Check §5.1 query analyzer limits")
        val limits = AnalyzerLimitsV1.query_default()
        expect(limits.max_input_bytes).to_equal(4096)
        expect(limits.max_normalized_bytes).to_equal(4096)
        expect(limits.max_token_bytes).to_equal(4096)
        expect(limits.max_tokens).to_equal(128)
        expect(limits.max_distinct_terms).to_equal(128)

describe "Package 0 frozen shapes construct and round-trip fields":
    it "constructs the SearchFieldIdentityV1 and AnalyzerErrorV1 closed enums":
        step("Check §5.1 enum variants are reachable")
        val f: SearchFieldIdentityV1 = SearchFieldIdentityV1.Body
        expect(f).to_equal(SearchFieldIdentityV1.Body)
        val e: AnalyzerErrorV1 = AnalyzerErrorV1.DistinctTermLimitExceeded
        expect(e).to_equal(AnalyzerErrorV1.DistinctTermLimitExceeded)

    it "constructs AnalyzedTextV1/AnalyzedQueryV1 seam records":
        step("Check §5.1 analyzer seam record shapes")
        val token = AnalyzedTokenV1(value: "alpha", position: 1, exact_identifier: false)
        val text_result = AnalyzedTextV1(normalized: "alpha", tokens: [token])
        expect(text_result.tokens.len()).to_equal(1)
        expect(text_result.tokens[0].position).to_equal(1)
        val term = AnalyzedQueryTermV1(value: "alpha", qtf: 2)
        val query_result = AnalyzedQueryV1(normalized: "alpha", terms: [term])
        expect(query_result.terms[0].qtf).to_equal(2)

    it "constructs a full AnalyzerIdentityV1 record":
        step("Check §5.1 AnalyzerIdentityV1 field set")
        val identity = AnalyzerIdentityV1(
            analyzer_id: "spipe-unicode-lex-v1", unicode_version: "17.0.0",
            unicode_manifest_sha256: "sha256:abc", normalization_id: "nfc",
            lowercase_id: "default", tokenizer_id: "ucd17", stop_words_id: ANALYZER_STOP_WORDS_ID,
            stop_words_sha256: ANALYZER_STOP_WORDS_SHA256, stemming_id: "none",
            field_schema_id: "spipe-search-fields-v1", limits_schema_id: "spipe-search-limits-v1")
        expect(identity.stop_words_id).to_equal("en-basic-v1")
        expect(identity.stemming_id).to_equal("none")

    it "constructs SearchHitV1 with a bounded rank and matched-field set":
        step("Check §5.4 SearchHitV1 wire shape")
        val hit = SearchHitV1.of("doc-1", 1500, 1, ["title", "body"], nil)
        expect(hit.document_id).to_equal("doc-1")
        expect(hit.score_milli).to_equal(1500)
        expect(hit.has_valid_rank()).to_equal(true)
        expect(hit.has_valid_matched_fields()).to_equal(true)
        expect(hit.explanation).to_equal(nil)
        val out_of_range = SearchHitV1.of("doc-2", 100, 0, [], nil)
        expect(out_of_range.has_valid_rank()).to_equal(false)

    it "constructs TermContributionV1 present and absent records":
        step("Check §14.14 per-term explanation records")
        val present = TermContributionV1.of("alpha", "body", 3, 2, "469998", "1000000", 1000, "12345")
        expect(present.present).to_equal(true)
        expect(present.term).to_equal("alpha")
        expect(present.idf_scaled).to_equal("469998")
        val absent = TermContributionV1.absent("beta", "title")
        expect(absent.present).to_equal(false)
        expect(absent.term_frequency).to_equal(0)
        expect(absent.contribution_scaled).to_equal("0")

    it "carries term_contributions on SearchExplanationV1":
        step("Check SearchExplanationV1 wiring to TermContributionV1")
        val field = FieldExplanationV1(field: "body", document_count: 4, total_length: 100,
            average_length_scaled: "25000000", document_length: 20, weight_milli: 1000, field_total: "0")
        val term = TermContributionV1.absent("alpha", "body")
        val explanation = SearchExplanationV1(contract: "bm25-explain-v1", analyzer: "spipe-unicode-lex-v1",
            score_contract: "bm25-fixed-v1", logical_index: "spipe-lexical-snapshot-v1",
            scope_digest: "sha256:s", logical_root: "sha256:r", document_id: "a", fields: [field],
            term_contributions: [term], internal_total: "10", public_score_milli: 0, tie_key_utf8_hex: "61")
        expect(explanation.term_contributions.len()).to_equal(1)
        expect(explanation.term_contributions[0].term).to_equal("alpha")

    it "constructs the five missing §14.16/§14.17 candidate lifecycle records":
        step("Check candidate lifecycle record shapes")
        val candidate = CandidateRecordV1(candidate_uid: "cand-1", operation_id: "op-1",
            payload_hash: "sha256:p", base_logical_root: "sha256:b", candidate_logical_root: "sha256:c",
            created_at_ms: 1000, expires_at_ms: 2000, status: "pending")
        expect(candidate.status).to_equal("pending")
        val publication = PublicationRecordV1(candidate_uid: "cand-1", operation_id: "op-1",
            previous_logical_root: "sha256:b", logical_root: "sha256:c", published_at_ms: 1500)
        expect(publication.logical_root).to_equal("sha256:c")
        val terminal_error = DurableTerminalErrorV1(operation_id: "op-1", payload_hash: "sha256:p",
            code: "candidate_expired", message: "expired", occurred_at_ms: 3000)
        expect(terminal_error.code).to_equal("candidate_expired")
        val expiry = CandidateExpiryReceiptV1(candidate_uid: "cand-1", operation_id: "op-1",
            base_logical_root: "sha256:b", expired_at_ms: 2001)
        expect(expiry.candidate_uid).to_equal("cand-1")
        val query_receipt = QueryReceiptV1(request_id: "req-1", logical_root: "sha256:c",
            scope_digest: "sha256:s", query_digest: "sha256:q", result_hash: "sha256:h", signature: "sig")
        expect(query_receipt.request_id).to_equal("req-1")
        val op_receipt = OperationReceiptV1(operation_id: "op-1", payload_hash: "sha256:p",
            scope_digest: "sha256:s", outcome: "applied", result_hash: "sha256:h", signature: "sig")
        expect(op_receipt.outcome).to_equal("applied")

    it "constructs ProviderErrorV1, RequestEnvelopeV1, and the local-only TransportDiagnosticV1":
        step("Check §14.11/§14.12/§14.18 wire envelope and error records")
        val error = ProviderErrorV1(code: "invalid_scope", message: "scope mismatch", retryable: false)
        expect(error.code).to_equal("invalid_scope")
        val envelope = RequestEnvelopeV1(request_id: "req-1", operation: "search",
            protocol_major: 1, protocol_minor: 0, provider_generation: "pg-" + "0".repeat(32),
            workspace: "WS-1", snapshot: "spks1-1", scope_digest: "sha256:s",
            query_receipt: nil, operation_receipt: nil, deadline_ms: 5000)
        expect(envelope.has_valid_protocol()).to_equal(true)
        expect(envelope.has_valid_deadline()).to_equal(true)
        val bad_deadline = RequestEnvelopeV1(request_id: "req-2", operation: "search",
            protocol_major: 1, protocol_minor: 0, provider_generation: "pg-" + "0".repeat(32),
            workspace: "WS-1", snapshot: "spks1-1", scope_digest: "sha256:s",
            query_receipt: nil, operation_receipt: nil, deadline_ms: 0)
        expect(bad_deadline.has_valid_deadline()).to_equal(false)
        val diagnostic = TransportDiagnosticV1(code: "frame_too_large", byte_count: 2097152)
        expect(diagnostic.code).to_equal("frame_too_large")

    it "constructs fusion source and identity-dominance records outside RRF":
        step("Check §3.5/§5.3/§5.5 fusion records")
        val candidate = SourceCandidateV1(document_id: "doc-1", source_rank: 1, source_score_milli: 900)
        val ranking = SourceRankingV1(source: FusionSourceV1.Lexical, source_contract: "bm25-fixed-v1",
            snapshot_id: "spks1-1", scope_digest: "sha256:s", candidates: [candidate], complete: true,
            source_digest: "sha256:d")
        expect(ranking.candidates.len()).to_equal(1)
        expect(ranking.source).to_equal(FusionSourceV1.Lexical)
        val identity_pin = IdentityExplanationV1(resolved_uid: "uid-1", matched_key: "REQ-1",
            alias_authority: "canonical", alias_status: "active", registry_generation: 1,
            visibility_decision: "authorized", pinned_rank: 1)
        expect(identity_pin.has_frozen_pinned_rank()).to_equal(true)
        val pinned = FusedHitV1(document_id: "doc-1", match_tier: MatchTierV1.ExactIdentity,
            final_rank: 1, rrf_raw_scaled: 0, rrf_adjusted_scaled: 0)
        expect(pinned.match_tier).to_equal(MatchTierV1.ExactIdentity)
        val fused_hit = FusedHitV1(document_id: "doc-2", match_tier: MatchTierV1.Fused,
            final_rank: 2, rrf_raw_scaled: 16393, rrf_adjusted_scaled: 16393)
        expect(fused_hit.final_rank).to_equal(2)
        val explanation = FusionExplanationV1(contract: "rrf-fixed-v1", k: 60, source_k: 1000,
            source_names: ["lexical", "graph"], source_ranks: [1, 0-1],
            source_contributions_scaled: [16393, 0], adjustments: [], adjustment_caps_scaled: [],
            raw_sum_scaled: 16393, adjusted_sum_scaled: 16393, tie_break_document_id: "doc-2")
        expect(explanation.source_ranks[1]).to_equal(0 - 1)

describe "Package 0 gate — zero re-declaration outside owned files":
    it "the frozen contract module compiles and imports resolve through __init__":
        step("Check the search package facade exports the new Package 0 modules")
        val ranked_field: [text] = BM25_FIELD_NAMES
        expect(ranked_field.len()).to_equal(5)
