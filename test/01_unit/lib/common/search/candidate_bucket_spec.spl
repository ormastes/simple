# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# design: doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md §7 ; plan: doc/03_plan/infra/spipe/spipe_search_providers_impl_plan.md — P10

use std.spec.step
use std.spec
use lib.common.search.fingerprint.{shingles_of_tokens, minhash_signature}
use lib.common.search.candidate_bucket.{bucketed_candidates}

describe "bounded LSH candidate bucketing":
    it "pairs only near-duplicate documents and leaves unrelated ones out":
        # @req REQ-SSPEC-UNIT
        step("pairs only near-duplicate documents and leaves unrelated ones out")
        val doc_a = ["the", "quick", "brown", "fox", "jumps", "over", "the", "lazy", "dog"]
        val doc_b = ["the", "quick", "brown", "fox", "jumps", "over", "the", "lazy", "cat"]
        val doc_c = ["completely", "unrelated", "vocabulary", "about", "astrophysics", "orbits"]
        val ids = ["a", "b", "c"]
        val sigs = [
            minhash_signature(shingles_of_tokens(doc_a, 2), 32),
            minhash_signature(shingles_of_tokens(doc_b, 2), 32),
            minhash_signature(shingles_of_tokens(doc_c, 2), 32),
        ]
        val pairs = bucketed_candidates(ids, sigs, 8, 4, 10)
        expect(pairs.len() > 0).to_equal(true)
        expect(pairs[0].left_id).to_equal("a")
        expect(pairs[0].right_id).to_equal("b")

    it "orders pairs by score desc, then left ID asc, then right ID asc":
        # @req REQ-SSPEC-UNIT
        step("orders pairs by score desc, then left ID asc, then right ID asc")
        val doc = ["alpha", "beta", "gamma", "delta", "epsilon"]
        val ids = ["z", "y", "x"]
        val sigs = [
            minhash_signature(shingles_of_tokens(doc, 2), 16),
            minhash_signature(shingles_of_tokens(doc, 2), 16),
            minhash_signature(shingles_of_tokens(doc, 2), 16),
        ]
        val pairs = bucketed_candidates(ids, sigs, 4, 4, 10)
        # all three documents are identical -> all pairs share the max score;
        # tie-break must be left ID asc, right ID asc.
        expect(pairs.len()).to_equal(3)
        expect(pairs[0].left_id).to_equal("x")
        expect(pairs[0].right_id).to_equal("y")
        expect(pairs[1].left_id).to_equal("x")
        expect(pairs[1].right_id).to_equal("z")
        expect(pairs[2].left_id).to_equal("y")
        expect(pairs[2].right_id).to_equal("z")

    it "caps the number of candidates returned per document":
        # @req REQ-SSPEC-UNIT
        step("caps the number of candidates returned per document")
        val doc = ["one", "two", "three", "four", "five"]
        val ids = ["a", "b", "c", "d", "e"]
        var sigs = []
        var i = 0
        while i < ids.len():
            sigs.push(minhash_signature(shingles_of_tokens(doc, 2), 16))
            i = i + 1
        val pairs = bucketed_candidates(ids, sigs, 4, 4, 1)
        var per_doc: {text: i64} = {}
        var j = 0
        while j < pairs.len():
            per_doc[pairs[j].left_id] = (per_doc[pairs[j].left_id] ?? 0) + 1
            per_doc[pairs[j].right_id] = (per_doc[pairs[j].right_id] ?? 0) + 1
            j = j + 1
        val keys = per_doc.keys()
        var k = 0
        while k < keys.len():
            expect(per_doc[keys[k]] <= 1).to_equal(true)
            k = k + 1
        return ()
