# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/03_plan/infra/spipe/spipe_search_providers_impl_plan.md

"""
## Purpose and audience
Purpose: prove the P2 common index engine — idempotent replace, delete
no-op/precondition validation, and logical-root determinism across equivalent
delta histories — and the P2 exhaustive top-k oracle's ordering/tie-break.
Audience: engineers implementing later index/retrieval packages (P4-P8) who
must match this engine's observable behavior.
"""

use std.spec.step
use std.spec

use lib.common.search.document.{ScopedSearchDocumentV1, ScopedFieldV1, ScopedFacetV1}
use lib.common.search.snapshot.{IndexOperationV1}
use lib.common.search.segment.{Segment, unsigned_utf8_lt}
use lib.common.search.index_engine.{IndexEngine}
use lib.common.search.ranking.{Bm25FieldV1}
use lib.common.search.top_k.{ExhaustiveCandidateV1, score_exhaustive_candidate, exhaustive_top_k_v1}

fn doc_of(id: text, revision: text, title: text) -> ScopedSearchDocumentV1:
    ScopedSearchDocumentV1.of(
        id, revision,
        [ScopedFieldV1.of("title", title)],
        [],
        "vis-digest",
        "hash-" + id + "-" + revision,
        "scope-digest",
    )

describe "index_engine: idempotent replace by (id, revision)":
    it "treats a repeated add of the same (id, revision) as a no-op":
        step("build an engine with one document")
        val d0 = doc_of("doc-1", "r1", "Alpha")
        val engine0 = IndexEngine.of_documents([d0])
        step("re-apply the identical add operation")
        val op = IndexOperationV1.add(d0)
        val engine1 = engine0.apply_operation(op).unwrap()
        step("logical root and document count are unchanged")
        expect(engine1.logical_root()).to_equal(engine0.logical_root())
        expect(engine1.document_count()).to_equal(1)
        return ()

    it "treats replaying a replace to an already-current revision as a no-op":
        step("build an engine with one document at revision r2")
        val d0 = doc_of("doc-1", "r1", "Alpha")
        val d1 = doc_of("doc-1", "r2", "Alpha v2")
        val engine0 = IndexEngine.of_documents([d0]).apply_operation(
            IndexOperationV1.replace("r1", "hash-doc-1-r1", d1)
        ).unwrap()
        step("replaying the SAME replace operation again is a no-op")
        val engine1 = engine0.apply_operation(
            IndexOperationV1.replace("r1", "hash-doc-1-r1", d1)
        ).unwrap()
        expect(engine1.logical_root()).to_equal(engine0.logical_root())
        val found = engine1.find("doc-1").unwrap()
        expect(found.revision).to_equal("r2")
        return ()

    it "rejects a replace whose asserted prior revision does not match":
        val d0 = doc_of("doc-1", "r1", "Alpha")
        val d1 = doc_of("doc-1", "r2", "Alpha v2")
        val engine0 = IndexEngine.of_documents([d0])
        val result = engine0.apply_operation(
            IndexOperationV1.replace("WRONG-REV", "hash-doc-1-r1", d1)
        )
        expect(result.is_err()).to_be_true()
        return ()

    it "rejects a replace targeting a document that does not exist":
        val engine0 = IndexEngine.of_documents([])
        val d1 = doc_of("doc-1", "r2", "Alpha v2")
        val result = engine0.apply_operation(
            IndexOperationV1.replace("r1", "hash-doc-1-r1", d1)
        )
        expect(result.is_err()).to_be_true()
        return ()

describe "index_engine: delete no-op and closed precondition":
    it "treats deleting an absent id as a no-op (delete_absent)":
        val engine0 = IndexEngine.of_documents([doc_of("doc-1", "r1", "Alpha")])
        val engine1 = engine0.apply_operation(IndexOperationV1.delete_absent("doc-missing")).unwrap()
        expect(engine1.logical_root()).to_equal(engine0.logical_root())
        expect(engine1.document_count()).to_equal(1)
        return ()

    it "treats deleting an absent id as a no-op even with an asserted (delete_present) precondition":
        val engine0 = IndexEngine.of_documents([doc_of("doc-1", "r1", "Alpha")])
        val engine1 = engine0.apply_operation(IndexOperationV1.delete_present("doc-missing", "r1", "hash-x")).unwrap()
        expect(engine1.logical_root()).to_equal(engine0.logical_root())
        return ()

    it "deletes a present document when the precondition matches":
        val d0 = doc_of("doc-1", "r1", "Alpha")
        val engine0 = IndexEngine.of_documents([d0])
        val engine1 = engine0.apply_operation(IndexOperationV1.delete_present("doc-1", "r1", "hash-doc-1-r1")).unwrap()
        expect(engine1.document_count()).to_equal(0)
        expect(engine1.contains("doc-1")).to_be_false()
        return ()

    it "rejects deleting a present document when the asserted precondition mismatches":
        val d0 = doc_of("doc-1", "r1", "Alpha")
        val engine0 = IndexEngine.of_documents([d0])
        val result = engine0.apply_operation(IndexOperationV1.delete_present("doc-1", "WRONG-REV", "hash-doc-1-r1"))
        expect(result.is_err()).to_be_true()
        return ()

    it "rejects a mixed null/non-null delete precondition (closed tagged choice)":
        # Neither delete_absent nor delete_present constructors can produce a
        # mixed pair, so construct the malformed operation directly to prove
        # has_closed_preconditions() actually gates apply_operation.
        val engine0 = IndexEngine.of_documents([doc_of("doc-1", "r1", "Alpha")])
        val malformed = IndexOperationV1(kind: "delete", document_id: "doc-1", before_revision: "r1", before_hash: nil, after: nil)
        val result = engine0.apply_operation(malformed)
        expect(result.is_err()).to_be_true()
        return ()

describe "index_engine: logical root determinism across equivalent delta histories":
    it "clean rebuild equals replaying add-then-add-then-delete-then-add":
        val a = doc_of("a", "r1", "A")
        val b = doc_of("b", "r1", "B")
        val c = doc_of("c", "r1", "C")

        step("clean rebuild of the final document set {a, c}")
        val rebuilt = IndexEngine.of_documents([a, c])

        step("equivalent delta history: add a, add b, add c, delete b")
        val replayed = IndexEngine.empty().apply_operations([
            IndexOperationV1.add(a),
            IndexOperationV1.add(b),
            IndexOperationV1.add(c),
            IndexOperationV1.delete_present("b", "r1", "hash-b-r1"),
        ]).unwrap()

        expect(replayed.logical_root()).to_equal(rebuilt.logical_root())
        expect(replayed.document_count()).to_equal(2)
        return ()

    it "is order-independent: adding a and c in either order yields the same logical root":
        val a = doc_of("a", "r1", "A")
        val c = doc_of("c", "r1", "C")
        val forward = IndexEngine.empty().apply_operations([IndexOperationV1.add(a), IndexOperationV1.add(c)]).unwrap()
        val backward = IndexEngine.empty().apply_operations([IndexOperationV1.add(c), IndexOperationV1.add(a)]).unwrap()
        expect(forward.logical_root()).to_equal(backward.logical_root())
        return ()

    it "changes the logical root when the final document set actually differs":
        val a = doc_of("a", "r1", "A")
        val b = doc_of("b", "r1", "B")
        val only_a = IndexEngine.of_documents([a])
        val both = IndexEngine.of_documents([a, b])
        expect(only_a.logical_root() == both.logical_root()).to_be_false()
        return ()

describe "segment: unsigned UTF-8 id comparator":
    it "orders ASCII ids ascending":
        expect(unsigned_utf8_lt("a", "b")).to_be_true()
        expect(unsigned_utf8_lt("b", "a")).to_be_false()
        expect(unsigned_utf8_lt("a", "a")).to_be_false()
        return ()

    it "sorts a built segment's documents by unsigned UTF-8 document id":
        val seg = Segment.build([doc_of("c", "r1", "C"), doc_of("a", "r1", "A"), doc_of("b", "r1", "B")])
        expect(seg.documents[0].document_id).to_equal("a")
        expect(seg.documents[1].document_id).to_equal("b")
        expect(seg.documents[2].document_id).to_equal("c")
        return ()

describe "top_k: exhaustive oracle ordering and tie-break":
    it "ranks higher scores first":
        val low = score_exhaustive_candidate("doc-low", [
            Bm25FieldV1.of("body", ["cat"], [1], [1], 4, 4, 1),
        ], ["body"]).unwrap()
        val high = score_exhaustive_candidate("doc-high", [
            Bm25FieldV1.of("body", ["cat"], [3], [1], 4, 4, 1),
        ], ["body"]).unwrap()
        val hits = exhaustive_top_k_v1([low, high], 2)
        expect(hits.len()).to_equal(2)
        expect(hits[0].document_id).to_equal("doc-high")
        expect(hits[0].source_rank).to_equal(1)
        expect(hits[1].document_id).to_equal("doc-low")
        expect(hits[1].source_rank).to_equal(2)
        return ()

    it "breaks exact score ties by ascending unsigned UTF-8 document id":
        val fields = [Bm25FieldV1.of("body", ["cat"], [1], [1], 4, 4, 2)]
        val z = score_exhaustive_candidate("z-doc", fields, ["body"]).unwrap()
        val a = score_exhaustive_candidate("a-doc", fields, ["body"]).unwrap()
        expect(z.score.raw_value()).to_equal(a.score.raw_value())
        val hits = exhaustive_top_k_v1([z, a], 2)
        expect(hits[0].document_id).to_equal("a-doc")
        expect(hits[1].document_id).to_equal("z-doc")
        return ()

    it "clamps k to the candidate count":
        val fields = [Bm25FieldV1.of("body", ["cat"], [1], [1], 4, 4, 1)]
        val only = score_exhaustive_candidate("only", fields, ["body"]).unwrap()
        val hits = exhaustive_top_k_v1([only], 50)
        expect(hits.len()).to_equal(1)
        return ()
