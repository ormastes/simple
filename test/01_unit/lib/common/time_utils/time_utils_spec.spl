"""
## Purpose and audience
Purpose: Prove that time_utils — pure arithmetic civil-date library.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use std.common.time_utils.{
    is_leap_year,
    days_in_month,
    day_of_week,
    timestamp_get_year,
    timestamp_get_month,
    timestamp_get_day,
    timestamp_get_hour,
    timestamp_get_minute,
    timestamp_get_second,
    timestamp_get_microsecond,
    timestamp_from_components,
    timestamp_add_days,
    timestamp_diff_days
}

describe "time_utils — pure arithmetic civil-date library":

    context "is_leap_year":
        it "2000 is a leap year (divisible by 400)":
            step("Verify: 2000 is a leap year (divisible by 400)")
            # @req: REQ-LIB-COMMON-001
            expect(is_leap_year(2000)).to_equal(true)

        it "1900 is not a leap year (divisible by 100 but not 400)":
            step("Verify: 1900 is not a leap year (divisible by 100 but not 400)")
            expect(is_leap_year(1900)).to_equal(false)

        it "2024 is a leap year (divisible by 4 not 100)":
            step("Verify: 2024 is a leap year (divisible by 4 not 100)")
            expect(is_leap_year(2024)).to_equal(true)

        it "2023 is not a leap year":
            step("Verify: 2023 is not a leap year")
            expect(is_leap_year(2023)).to_equal(false)

        it "1 AD is not a leap year":
            step("Verify: 1 AD is not a leap year")
            expect(is_leap_year(1)).to_equal(false)

    context "days_in_month":
        it "January has 31 days":
            step("Verify: January has 31 days")
            expect(days_in_month(2024, 1)).to_equal(31)  # oracle: 31 — named expected value from the requirement

        it "April has 30 days":
            step("Verify: April has 30 days")
            expect(days_in_month(2024, 4)).to_equal(30)  # oracle: 30 — named expected value from the requirement

        it "February 2024 has 29 days (leap year)":
            step("Verify: February 2024 has 29 days (leap year)")
            expect(days_in_month(2024, 2)).to_equal(29)  # oracle: 29 — named expected value from the requirement

        it "February 2023 has 28 days (non-leap)":
            step("Verify: February 2023 has 28 days (non-leap)")
            expect(days_in_month(2023, 2)).to_equal(28)  # oracle: 28 — named expected value from the requirement

        it "February 1900 has 28 days (century not divisible by 400)":
            step("Verify: February 1900 has 28 days (century not divisible by 400)")
            expect(days_in_month(1900, 2)).to_equal(28)  # oracle: 28 — named expected value from the requirement

        it "February 2000 has 29 days (400-year leap)":
            step("Verify: February 2000 has 29 days (400-year leap)")
            expect(days_in_month(2000, 2)).to_equal(29)  # oracle: 29 — named expected value from the requirement

        it "December has 31 days":
            step("Verify: December has 31 days")
            expect(days_in_month(2024, 12)).to_equal(31)  # oracle: 31 — named expected value from the requirement

    context "timestamp_get_year":
        it "epoch (micros=0) is year 1970":
            step("Verify: epoch (micros=0) is year 1970")
            expect(timestamp_get_year(0)).to_equal(1970)  # oracle: 1970 — named expected value from the requirement

        it "2000-01-01 00:00:00 UTC is year 2000":
            step("Verify: 2000-01-01 00:00:00 UTC is year 2000")
            # 946684800 seconds * 1_000_000
            expect(timestamp_get_year(946684800000000)).to_equal(2000)  # oracle: 2000 — named expected value from the requirement

        it "one second before epoch is year 1969":
            step("Verify: one second before epoch is year 1969")
            expect(timestamp_get_year(-1000000)).to_equal(1969)  # oracle: 1969 — named expected value from the requirement

        it "2024-02-29 is year 2024":
            step("Verify: 2024-02-29 is year 2024")
            # 2024-02-29 00:00:00 UTC = 1709164800 seconds
            expect(timestamp_get_year(1709164800000000)).to_equal(2024)  # oracle: 2024 — named expected value from the requirement

    context "timestamp_get_month":
        it "epoch (micros=0) is month 1":
            step("Verify: epoch (micros=0) is month 1")
            expect(timestamp_get_month(0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "2000-01-01 is month 1":
            step("Verify: 2000-01-01 is month 1")
            expect(timestamp_get_month(946684800000000)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "one second before epoch is month 12 (December 1969)":
            step("Verify: one second before epoch is month 12 (December 1969)")
            expect(timestamp_get_month(-1000000)).to_equal(12)  # oracle: 12 — named expected value from the requirement

        it "2024-02-29 is month 2":
            step("Verify: 2024-02-29 is month 2")
            expect(timestamp_get_month(1709164800000000)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    context "timestamp_get_day":
        it "epoch (micros=0) is day 1":
            step("Verify: epoch (micros=0) is day 1")
            expect(timestamp_get_day(0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "2000-01-01 is day 1":
            step("Verify: 2000-01-01 is day 1")
            expect(timestamp_get_day(946684800000000)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "one second before epoch is day 31 (1969-12-31)":
            step("Verify: one second before epoch is day 31 (1969-12-31)")
            expect(timestamp_get_day(-1000000)).to_equal(31)  # oracle: 31 — named expected value from the requirement

        it "2024-02-29 is day 29":
            step("Verify: 2024-02-29 is day 29")
            expect(timestamp_get_day(1709164800000000)).to_equal(29)  # oracle: 29 — named expected value from the requirement

    context "timestamp_get_hour":
        it "epoch is hour 0":
            step("Verify: epoch is hour 0")
            expect(timestamp_get_hour(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "3600 seconds past epoch is hour 1":
            step("Verify: 3600 seconds past epoch is hour 1")
            expect(timestamp_get_hour(3600000000)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "one second before epoch is hour 23":
            step("Verify: one second before epoch is hour 23")
            expect(timestamp_get_hour(-1000000)).to_equal(23)  # oracle: 23 — named expected value from the requirement

    context "timestamp_get_minute":
        it "epoch is minute 0":
            step("Verify: epoch is minute 0")
            expect(timestamp_get_minute(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "1830 seconds past epoch is minute 30":
            step("Verify: 1830 seconds past epoch is minute 30")
            # 30 * 60 + 30 = 1830 seconds = 30m30s → minute 30
            expect(timestamp_get_minute(1830000000)).to_equal(30)  # oracle: 30 — named expected value from the requirement

        it "one second before epoch is minute 59":
            step("Verify: one second before epoch is minute 59")
            expect(timestamp_get_minute(-1000000)).to_equal(59)  # oracle: 59 — named expected value from the requirement

    context "timestamp_get_second":
        it "epoch is second 0":
            step("Verify: epoch is second 0")
            expect(timestamp_get_second(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "45 seconds past epoch is second 45":
            step("Verify: 45 seconds past epoch is second 45")
            expect(timestamp_get_second(45000000)).to_equal(45)  # oracle: 45 — named expected value from the requirement

        it "one second before epoch is second 59":
            step("Verify: one second before epoch is second 59")
            expect(timestamp_get_second(-1000000)).to_equal(59)  # oracle: 59 — named expected value from the requirement

    context "timestamp_get_microsecond":
        it "epoch has 0 microseconds":
            step("Verify: epoch has 0 microseconds")
            expect(timestamp_get_microsecond(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "500000 micros past epoch is 500000 sub-second micros":
            step("Verify: 500000 micros past epoch is 500000 sub-second micros")
            expect(timestamp_get_microsecond(500000)).to_equal(500000)  # oracle: 500000 — named expected value from the requirement

        it "one microsecond before epoch is 999999":
            step("Verify: one microsecond before epoch is 999999")
            expect(timestamp_get_microsecond(-1)).to_equal(999999)  # oracle: 999999 — named expected value from the requirement

        it "one microsecond before epoch keeps a coherent time of day":
            step("Verify: one microsecond before epoch keeps a coherent time of day")
            expect(timestamp_get_hour(-1)).to_equal(23)  # oracle: 23 — named expected value from the requirement
            expect(timestamp_get_minute(-1)).to_equal(59)  # oracle: 59 — named expected value from the requirement
            expect(timestamp_get_second(-1)).to_equal(59)  # oracle: 59 — named expected value from the requirement

    context "day_of_week":
        it "epoch 1970-01-01 is Thursday (4)":
            step("Verify: epoch 1970-01-01 is Thursday (4)")
            expect(day_of_week(0)).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "1970-01-04 is Sunday (0)":
            step("Verify: 1970-01-04 is Sunday (0)")
            # 3 days after epoch
            expect(day_of_week(3 * 86400000000)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "2000-01-01 is Saturday (6)":
            step("Verify: 2000-01-01 is Saturday (6)")
            expect(day_of_week(946684800000000)).to_equal(6)  # oracle: 6 — named expected value from the requirement

        it "one day before epoch 1969-12-31 is Wednesday (3)":
            step("Verify: one day before epoch 1969-12-31 is Wednesday (3)")
            expect(day_of_week(-86400000000)).to_equal(3)  # oracle: 3 — named expected value from the requirement

    context "timestamp_from_components":
        it "Unix epoch from components":
            step("Verify: Unix epoch from components")
            expect(timestamp_from_components(1970, 1, 1, 0, 0, 0, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "2000-01-01 00:00:00 from components":
            step("Verify: 2000-01-01 00:00:00 from components")
            expect(timestamp_from_components(2000, 1, 1, 0, 0, 0, 0)).to_equal(946684800000000)  # oracle: 946684800000000 — named expected value from the requirement

        it "one second before epoch from components":
            step("Verify: one second before epoch from components")
            expect(timestamp_from_components(1969, 12, 31, 23, 59, 59, 0)).to_equal(-1000000)  # oracle: -1000000 — named expected value from the requirement

        it "2024-02-29 from components":
            step("Verify: 2024-02-29 from components")
            expect(timestamp_from_components(2024, 2, 29, 0, 0, 0, 0)).to_equal(1709164800000000)  # oracle: 1709164800000000 — named expected value from the requirement

    context "round-trip: from_components then get_*":
        it "round-trips 2023-07-15 14:30:45.123456":
            step("Verify: round-trips 2023-07-15 14:30:45.123456")
            val micros = timestamp_from_components(2023, 7, 15, 14, 30, 45, 123456)
            expect(timestamp_get_year(micros)).to_equal(2023)  # oracle: 2023 — named expected value from the requirement
            expect(timestamp_get_month(micros)).to_equal(7)  # oracle: 7 — named expected value from the requirement
            expect(timestamp_get_day(micros)).to_equal(15)  # oracle: 15 — named expected value from the requirement
            expect(timestamp_get_hour(micros)).to_equal(14)  # oracle: 14 — named expected value from the requirement
            expect(timestamp_get_minute(micros)).to_equal(30)  # oracle: 30 — named expected value from the requirement
            expect(timestamp_get_second(micros)).to_equal(45)  # oracle: 45 — named expected value from the requirement
            expect(timestamp_get_microsecond(micros)).to_equal(123456)  # oracle: 123456 — named expected value from the requirement

        it "round-trips 1800-03-01 (pre-1970 distant past)":
            step("Verify: round-trips 1800-03-01 (pre-1970 distant past)")
            val micros = timestamp_from_components(1800, 3, 1, 0, 0, 0, 0)
            expect(timestamp_get_year(micros)).to_equal(1800)  # oracle: 1800 — named expected value from the requirement
            expect(timestamp_get_month(micros)).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(timestamp_get_day(micros)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "timestamp_add_days":
        it "adding 0 days is identity":
            step("Verify: adding 0 days is identity")
            expect(timestamp_add_days(0, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "adding 1 day to epoch gives 86400000000 micros":
            step("Verify: adding 1 day to epoch gives 86400000000 micros")
            expect(timestamp_add_days(0, 1)).to_equal(86400000000)  # oracle: 86400000000 — named expected value from the requirement

        it "adding negative days moves backward":
            step("Verify: adding negative days moves backward")
            expect(timestamp_add_days(86400000000, -1)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "timestamp_diff_days":
        it "same timestamp gives 0 days difference":
            step("Verify: same timestamp gives 0 days difference")
            expect(timestamp_diff_days(0, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "one day apart gives 1":
            step("Verify: one day apart gives 1")
            expect(timestamp_diff_days(86400000000, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "reversed gives -1":
            step("Verify: reversed gives -1")
            expect(timestamp_diff_days(0, 86400000000)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "365 days apart":
            step("Verify: 365 days apart")
            val one_year = 365 * 86400000000
            expect(timestamp_diff_days(one_year, 0)).to_equal(365)  # oracle: 365 — named expected value from the requirement
