# @cover src/lib/nogc_sync_mut/js/engine/interpreter.spl

use std.spec.*
use std.nogc_async_mut.js.engine.interpreter.{_simple_fetch_marker, _simple_fetch_base_url, _simple_fetch_cookie_header, _resolve_fetch_url}
use std.js.engine.vm_object_store.{ObjectStore}
use std.js.types.js_types.JsValue

describe "js fetch host helpers":
    it "reads host properties from the object store":
        var store = ObjectStore.create()
        val o = store.alloc_object()
        val p = store.alloc_object()
        store.set_property(o, "__simple_fetch_host", JsValue.Boolean(v: true))
        store.set_property(o, "__simple_base_url", JsValue.String(v: "https://a.test/x/y.html"))
        store.set_property(o, "__simple_cookie_header", JsValue.String(v: "k=v"))
        expect(_simple_fetch_marker(o, store)).to_equal(true)
        expect(_simple_fetch_base_url(o, store)).to_equal("https://a.test/x/y.html")
        expect(_simple_fetch_cookie_header(o, store)).to_equal("k=v")
        expect(_simple_fetch_marker(p, store)).to_equal(false)
        expect(_simple_fetch_base_url(p, store)).to_equal("")
    it "resolves fetch urls against a base":
        val base = "https://a.test/x/y.html?q=1#f"
        expect(_resolve_fetch_url(base, "")).to_equal(base)
        expect(_resolve_fetch_url(base, "http://b.test/z")).to_equal("http://b.test/z")
        expect(_resolve_fetch_url(base, "//c.test/z")).to_equal("https://c.test/z")
        expect(_resolve_fetch_url(base, "#g")).to_equal("https://a.test/x/y.html?q=1#g")
        expect(_resolve_fetch_url(base, "?r=2")).to_equal("https://a.test/x/y.html?r=2")
        expect(_resolve_fetch_url(base, "/root")).to_equal("https://a.test/root")
        expect(_resolve_fetch_url(base, "rel.json")).to_equal("https://a.test/x/rel.json")
