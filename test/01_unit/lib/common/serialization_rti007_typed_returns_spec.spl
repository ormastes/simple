# @covers src/lib/common/serialization/__init__.spl
"""
## Purpose and audience
# Serialization stage2-safe typed returns (rti007 regression)

**Bug:** rti007_any_return_rows_2026-11-01
**Status:** Workaround regression

## Overview

The frozen phase-3 stage2 lowers the return of any function with an untyped
parameter and no declared return to `Any`, which has no RTI interface row
(E-RTI-007). Every such function reachable from the stage3 closure now spells
a concrete return type. These checks pin the observable values of the
rewritten signatures so the explicit types cannot drift from the old
dynamically typed behaviour.
"""

use std.spec.step
use std.common.serialization.{serialize_list, serialize_tuple_text, serialize_dict, serialize_int, serialize_text, serialize_text_list, serialize_bool, to_sdn_int, to_sdn_bool, to_sdn_text, pretty_list, is_valid_sdn, tag_type, add_version, mark_compressed, is_compressed, is_encrypted, write_bytes, serialize_int_bytes, serialize_bool_bytes, serialize_text_list_bytes, quote_string, deep_clone_int, deep_clone_list_text, deep_equal_int, deep_equal_text, deep_equal_list_int, deep_equal_list_text, structural_hash_int, structural_hash_bool, structural_hash_list_int, int_to_hex, bytes_to_hex, escape_string, hex_to_bytes}

# @req: REQ-RTI007-SER-001
describe "serialization typed returns (rti007)":
    it "keeps text-returning serializers":
        # @req: REQ-RTI007-SER-001
        step("Verify text serializers return the same text")
        expect(serialize_list([1, 2])).to_equal("[1, 2]")
        expect(serialize_tuple_text([1, 2])).to_equal("(1, 2)")
        expect(serialize_dict([("a", 1)])).to_equal("{a: 1}")
        expect(serialize_int(42)).to_equal("42")
        expect(serialize_text("hi")).to_equal("\"hi\"")
        expect(serialize_text_list(["a", "b"])).to_equal("[\"a\", \"b\"]")
        expect(serialize_bool(true)).to_equal("true")
        expect(to_sdn_int(7)).to_equal("7")
        expect(to_sdn_bool(false)).to_equal("false")
        expect(to_sdn_text("x")).to_equal("\"x\"")
        expect(pretty_list([], 0)).to_equal("[]")
        expect(quote_string("q")).to_equal("\"q\"")
        expect(escape_string("plain")).to_equal("plain")

    it "keeps tag and version helpers":
        # @req: REQ-RTI007-SER-001
        step("Verify tag/version helpers")
        expect(tag_type("x", "T")).to_equal("@T{x}")
        expect(mark_compressed("x")).to_equal("@Compressed{x}")
        expect(is_compressed(mark_compressed("x"))).to_equal(true)
        expect(is_encrypted(mark_compressed("x"))).to_equal(false)
        expect(add_version("d", 2)).to_start_with("{v: 2")
        expect(is_valid_sdn("[1]")).to_equal(true)

    it "keeps byte encoders":
        # @req: REQ-RTI007-SER-001
        step("Verify byte encoders")
        expect(write_bytes([5, 6])).to_equal([2, 5, 6])
        expect(serialize_bool_bytes(true)).to_equal([1, 1])
        expect(serialize_int_bytes(1).len()).to_be_greater_than(1)
        expect(serialize_text_list_bytes(["a"])[1]).to_equal(1)
        expect(bytes_to_hex([255, 1])).to_equal("ff01")
        expect(int_to_hex(171)).to_equal("ab")
        expect(hex_to_bytes("ff01")).to_equal([255, 1])

    it "keeps clone, equality and hash helpers":
        # @req: REQ-RTI007-SER-001
        step("Verify clone/equal/hash helpers")
        expect(deep_clone_int(3)).to_equal(3)
        expect(deep_clone_list_text(["a"])).to_equal(["a"])
        expect(deep_equal_int(1, 1)).to_equal(true)
        expect(deep_equal_text("a", "b")).to_equal(false)
        expect(deep_equal_list_int([1, 2], [1, 2])).to_equal(true)
        expect(deep_equal_list_text(["a"], ["b"])).to_equal(false)
        expect(structural_hash_int(9)).to_equal(9)
        expect(structural_hash_bool(true)).to_equal(1)
        expect(structural_hash_list_int([1])).to_equal(2166136261 * 31 + 1)
