# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB

"""
## Purpose and audience
Purpose: prove the ponytail debt ledger harvests every deliberate `ponytail:`
shortcut with its 1-based line number and trimmed note, independent of the
host language's comment syntax.
Audience: engineers extending the ponytail mimic surface (`simple_ponytail`,
mode `debt`) that must work on non-Simple sources.
"""

use std.spec.step
use std.spec

use lib.common.ponytail.audit.{ponytail_debt_source}

describe "ponytail debt ledger: harvest":
    it "reports zero entries for a source with no markers":
        step("audit a source carrying no ponytail marker")
        val out = ponytail_debt_source("a.spl", "fn main():\n    return 0\n")
        expect(out.contains("entries: 0")).to_equal(true)
        return ()

    it "records the 1-based line number and the trimmed note":
        step("harvest a single marker on line 2")
        val src = "fn main():\n    # ponytail:   global lock, shard if throughput matters\n    return 0\n"
        val out = ponytail_debt_source("a.spl", src)
        expect(out.contains("entries: 1")).to_equal(true)
        expect(out.contains("a.spl:2: global lock, shard if throughput matters")).to_equal(true)
        return ()

    it "harvests markers behind any comment syntax, not just Simple's":
        step("harvest C, SQL and Simple comment styles in one source")
        val src = "// ponytail: c style\n-- ponytail: sql style\n# ponytail: hash style\n"
        val out = ponytail_debt_source("x.c", src)
        expect(out.contains("entries: 3")).to_equal(true)
        expect(out.contains("x.c:1: c style")).to_equal(true)
        expect(out.contains("x.c:2: sql style")).to_equal(true)
        expect(out.contains("x.c:3: hash style")).to_equal(true)
        return ()
