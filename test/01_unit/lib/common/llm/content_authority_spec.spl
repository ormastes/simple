# @cover src/lib/common/llm/content_authority.spl 80%
"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/lib/common/llm/content_authority_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

use std.spipe.*
use lib.common.privilege.authority_token.{AuthorityLevel, TrustSource}
use lib.common.llm.content_authority.{ContentAuthority, ReleaseDecision, release_gate}

describe "Content Authority":
    describe "release_gate":
        it "AC-6: reader clearance >= content level → Release":
            val content = ContentAuthority(level: AuthorityLevel.Internal, source_trust: TrustSource.RegistryTrusted)
            val decision = release_gate(content, AuthorityLevel.Sensitive)
            expect decision.kind to_equal "Release"

        it "AC-6: equal clearance → Release":
            val content = ContentAuthority(level: AuthorityLevel.Sensitive, source_trust: TrustSource.RegistryTrusted)
            val decision = release_gate(content, AuthorityLevel.Sensitive)
            expect decision.kind to_equal "Release"

        it "AC-6: reader clearance < content level → Scrub or Block":
            val content = ContentAuthority(level: AuthorityLevel.Secret, source_trust: TrustSource.RegistryTrusted)
            val decision = release_gate(content, AuthorityLevel.Public)
            val held = (decision.kind == "Scrub") or (decision.kind == "Block")
            expect held to_equal true

        it "AC-6: revoked trust_source → Block":
            val content = ContentAuthority(level: AuthorityLevel.Public, source_trust: TrustSource.Revoked)
            val decision = release_gate(content, AuthorityLevel.Secret)
            expect decision.kind to_equal "Block"
