# Conversion imports bind canonical owners and preserve distinct raw semantics.
use std.spec.{describe, it, expect}
use std.common.base_encoding.utilities.{base_encoding_bytes_to_text as bytes_to_text}
use std.common.base_encoding.utilities.{base_encoding_bytes_to_text}
use std.common.cbor.types.{cbor_text_to_bytes as text_to_bytes}
use std.common.cbor.types.{cbor_text_to_bytes}
use std.common.text_bytes.{bytes_to_text as raw_bytes_to_text, text_to_bytes as raw_text_to_bytes}

describe "explicit conversion import ownership":
    it "routes malformed continuation to the question-mark utility":
        expect(bytes_to_text([0xC3, 0x41])).to_equal("?A")

    it "routes overlong encoding to the question-mark utility":
        expect(bytes_to_text([0xC0, 0xAF])).to_equal("??")

    it "routes surrogate bytes to the question-mark utility":
        expect(bytes_to_text([0xED, 0xA0, 0x80])).to_equal("???")

    it "routes out-of-range lead bytes to the question-mark utility":
        expect(bytes_to_text([0xFF, 0xBF, 0xBF, 0xBF])).to_equal("????")

    it "routes newline to the restricted CBOR helper":
        expect(text_to_bytes("\n").len()).to_equal(0)

    it "keeps explicit utility alias equal to its canonical owner on a new malformed sequence":
        val data = [0xE2, 0x28, 0xA1]
        expect(base_encoding_bytes_to_text(data)).to_equal("?(?")
        expect(bytes_to_text(data)).to_equal("?(?")

    it "keeps the separately imported raw decoder distinct":
        expect(raw_bytes_to_text([0xE2, 0x28, 0xA1])).to_equal("�(�")

    it "keeps explicit CBOR alias equal to its canonical owner on tab":
        expect(cbor_text_to_bytes("\t").len()).to_equal(0)
        expect(text_to_bytes("\t").len()).to_equal(0)

    it "keeps the separately imported raw encoder distinct":
        val actual = raw_text_to_bytes("\t")
        expect(actual.len()).to_equal(1)
        expect(actual[0].to_i64()).to_equal(9)
