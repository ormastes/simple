use std.spec.*
use lib.common.js.engine.runtime.{JsRuntime}
use lib.common.js.engine.js_error.{Logger}
use lib.common.js.types.js_types.{JsValue}

fn _display_js(v: JsValue) -> text:
    match v:
        JsValue.Undefined: "undefined"
        JsValue.Null: "null"
        JsValue.Boolean(b): if b: "true" else: "false"
        JsValue.Number(n):
            var s = "{n}"
            if s.ends_with(".0"):
                s = s.slice(0, s.len() - 2)
            s
        JsValue.String(s): s
        JsValue.Object(id): "[object Object]"
        JsValue.Array(id): "[object Array]"
        JsValue.Function(id): "[Function]"
        JsValue.Symbol(id): "Symbol()"

describe "JS runtime async browser globals":

    it "installs Promise and fetch globals":
        val runtime = JsRuntime.new(Logger(name: "js-async-test"))
        val result = runtime.eval("typeof Promise.resolve + ':' + typeof Promise.prototype.then + ':' + typeof fetch")
        match result:
            Ok(value):
                expect(_display_js(value)).to_contain("function:function:function")
            Err(e):
                fail("fetch chain returned Err: {e}")

    it "bounds unresolved fetch requests before host dispatch":
        val runtime = JsRuntime.new(Logger(name: "js-async-limit"))
        val result = runtime.eval(
            "var limited = null; for (var i = 0; i < 1030; i = i + 1) { limited = fetch('https://example.test/' + i); } limited.__simple_state"
        )
        match result:
            Ok(value):
                expect(_display_js(value)).to_equal("rejected")
                expect(
                    runtime.interpreter.pending_async_request_registry.len()
                ).to_equal(1024)
            Err(e):
                fail("Expected bounded fetch queue: {e}")
