"""
## Purpose and audience
Purpose: Prove that Fluent Interface Support.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Fluent Interface Specification
#
# Tests fluent interface patterns and method chaining with the functional update
# operator. Verifies array transformations (map, filter, append) and multi-step
# operation chaining work correctly with the fluent API.

# Fluent Interface (Functional Update Operator ->) Tests
# Tests for #1068 - Fluent interface support with method chaining
#
# NOTE: BDD framework mutable variable bugs were FIXED on 2026-01-04
# These tests can now be implemented properly


use std.spec.step

describe "Fluent Interface Support":
    # Validates fluent interface patterns including array concatenation,
    # element mapping, filtering, and method chaining for functional-style
    # data transformations.
    it "concatenates arrays with ->":
        step("Verify: concatenates arrays with ->")
        # @req: REQ-LIB-COMMON-001
        # Test functional update operator with array concatenation
        var arr = [1, 2]
        arr = arr + [3, 4]
        expect(arr.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(arr[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "maps array elements with ->":
        step("Verify: maps array elements with ->")
        # Test mapping over array elements
        val arr = [1, 2, 3]
        val doubled = arr.map(_ * 2)
        expect(doubled[0]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(doubled[1]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(doubled[2]).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "filters array elements with ->":
        step("Verify: filters array elements with ->")
        # Test filtering array elements
        val arr = [1, 2, 3, 4, 5]
        val evens = arr.filter(_ % 2 == 0)
        expect(evens.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(evens[0]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(evens[1]).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "chains multiple operations":
        step("Verify: chains multiple operations")
        # Test chaining map and filter
        val arr = [1, 2, 3, 4, 5]
        val filtered = arr.filter(_ > 2)
        val result = filtered.map(_ * 2)
        expect(result.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(result[0]).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(result[1]).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(result[2]).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "works with method calls":
        step("Verify: works with method calls")
        # Test fluent interface with method chaining
        var list = [1, 2]
        list.append(3)
        expect(list.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(list[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "preserves array identity":
        step("Verify: preserves array identity")
        # Test that operations preserve type
        val arr = [1, 2, 3]
        val same = arr.map(_1)
        expect(same.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(same[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
