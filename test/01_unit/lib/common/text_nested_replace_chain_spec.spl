# @req REQ-SSPEC-STDLIB
"""
# Chained / nested `.replace(...)` on text -- behavioural contract
Bug: native_build_nested_replace_method_resolution_2026-07-26 -- the second
`.replace` of a chain must dispatch on the text result of the first one in
every position: direct chain, nested call argument, array push argument,
call-result receiver, string interpolation, and `trim()`/`len()` siblings.
"""

# @tag: unit, lib, text

use std.spec

fn wrap(t: text) -> text:
    "[" + t + "]"

fn raw_line() -> text:
    "a\tb\rc"

describe "chained .replace(...).replace(...) on text":
    it "applies both replacements in a direct chain":
        val s = "a\tb\rc"
        expect(s.replace("\t", " ").replace("\r", " ")).to_equal("a b c")

    it "applies both replacements when the chain is a nested call argument":
        expect(wrap("a\tb\rc".replace("\t", " ").replace("\r", " "))).to_equal("[a b c]")

    it "applies both replacements when the chain is pushed onto an array":
        var titles: [text] = []
        titles.push("a\tb\rc".replace("\t", " ").replace("\r", " "))
        expect(titles[0]).to_equal("a b c")

    it "applies both replacements on a call-result receiver":
        expect(raw_line().replace("\t", " ").replace("\r", " ")).to_equal("a b c")

    it "applies both replacements nested inside a string interpolation":
        val s = "a\tb\rc"
        expect("<{s.replace("\t", " ").replace("\r", " ")}>").to_equal("<a b c>")

describe "sibling chained text-method shapes":
    it "trim().replace() replaces on the trimmed text":
        expect("  xay ".trim().replace("a", "b")).to_equal("xby")

    it "replace().len() measures the replaced text":
        expect("aaa".replace("a", "bb").len()).to_equal(6)

    it "replace().trim() as a nested call argument trims the replaced text":
        expect(wrap(" red blue ".replace("red", "").trim())).to_equal("[blue]")
