"""
Purpose: Verify strict common process-memory admission arithmetic.
Audience: BuildRunner and TestRunner maintainers.
Workflow: Run scenarios through SPipe and inspect exact case counts.
Limit: Pure same-unit accounting; native enforcement and fiber progress differ.
"""
use std.common.task_runner.memory_admission.{task_memory_charge_v1, task_memory_add_v1, task_memory_fits_v1}

describe "Common process memory admission":
    it "preserves reservation floors and measured monitor overshoot":
        expect(task_memory_charge_v1(100, 0)).to_equal(100)
        expect(task_memory_charge_v1(100, 150)).to_equal(150)
        expect(task_memory_charge_v1(0, 150)).to_equal(-1)
        expect(task_memory_charge_v1(100, -1)).to_equal(-1)

    it "rejects overflowing totals without losing earlier failure":
        val maximum = 9223372036854775807
        expect(task_memory_add_v1(maximum - 1, 1)).to_equal(maximum)
        expect(task_memory_add_v1(maximum, 1)).to_equal(-1)
        expect(task_memory_add_v1(-1, 0)).to_equal(-1)
        expect(task_memory_add_v1(0, -1)).to_equal(-1)

    it "admits an exact fit but never allows overcommit or invalid input":
        val maximum = 9223372036854775807
        expect(task_memory_fits_v1(maximum, maximum - 1, 1)).to_equal(true)
        expect(task_memory_fits_v1(maximum, maximum, 1)).to_equal(false)
        expect(task_memory_fits_v1(0, 0, 1)).to_equal(false)
        expect(task_memory_fits_v1(100, -1, 1)).to_equal(false)
        expect(task_memory_fits_v1(100, 0, 0)).to_equal(false)
        expect(task_memory_fits_v1(100, 0, 101)).to_equal(false)
