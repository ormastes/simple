"""
## Purpose and audience
Purpose: Pin the pure-Simple zstd compressor: Block_Type=2 compressed blocks
built from an LZ77 match finder, Raw/RLE literals and Predefined_Mode FSE
sequence tables, with per-block Raw/RLE fallback.
Audience: storage and compression maintainers (SimpleOS nvfs Zstd3/Zstd19
extents, std.common.compress.zstd consumers).
## Operator workflow
Run with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
v1 emits Raw or RLE literals only (no Huffman literal coding) and never emits
repeat-offset codes. The primary correctness oracle is the reference
`zstd -d` (1.5.5), run by hand in the lane evidence; this committed spec cannot
shell out, so it checks the in-repo decoder round trip, the frame structure
and the compression ratio.
## Verification guidance and troubleshooting
A red ratio scenario means the match finder or sequence coder regressed; a red
structure scenario means no Block_Type=2 block was produced.
"""
# @manual_section: zstd-encoder

use std.spec
use std.spec.step
use std.common.compress.types.{CompressionCodec}
use std.common.compress.lz4.{CompressionOptions}
use std.common.compress.utilities.{compression_options}
use std.common.compress.zstd.{zstd_compress_frame, zstd_decompress_frame}

fn _opts(level: i64, checksum: bool) -> CompressionOptions:
    val base = compression_options(CompressionCodec.zstd, level)
    CompressionOptions(codec: base.codec, level: base.level, checksum: checksum, block_mode: base.block_mode, dictionary_bytes: nil, dictionary_id: nil, content_size: nil)

fn _word_text(n: i64) -> [u8]:
    val words = ["let ", "fn ", "val ", "match ", "return ", "compress ", "block ", "offset ", "literal ", "sequence ", "state ", "table ", "if ", "else ", "while ", "data ", "len ", "push ", "frame ", "window ", "\n    ", "(", ")", ": ", " = ", ".len()", "i + 1", "zstd_"]
    var out: [u8] = []
    var s: i64 = 7
    while out.len() < n:
        s = (s * 1103515245 + 12345) % 2147483648
        val w = words[(s / 65536) % words.len()].bytes()
        var k = 0
        while k < w.len():
            out.push(w[k])
            k = k + 1
    out

fn _lcg_bytes(n: i64) -> [u8]:
    var out: [u8] = []
    var s: i64 = 12345
    while out.len() < n:
        s = (s * 1103515245 + 12345) % 2147483648
        out.push(((s / 65536) % 256) as u8)
    out

fn _same(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

# Block_Type of every block in a single-segment frame (0 raw, 1 rle, 2 compressed).
fn _block_types(frame: [u8]) -> [i64]:
    var types: [i64] = []
    val fhd = frame[4] as i64
    val fcs_flag = fhd / 64
    var fcs_len = 1
    if fcs_flag == 1:
        fcs_len = 2
    if fcs_flag == 2:
        fcs_len = 4
    if fcs_flag == 3:
        fcs_len = 8
    var pos = 5 + fcs_len
    var last = false
    while not last and pos + 3 <= frame.len():
        val h = (frame[pos] as i64) + (frame[pos + 1] as i64) * 256 + (frame[pos + 2] as i64) * 65536
        last = (h % 2) == 1
        val btype = (h / 2) % 4
        val size = h / 8
        types.push(btype)
        if btype == 1:
            pos = pos + 3 + 1
        else:
            pos = pos + 3 + size
    types

describe "zstd compressor with predefined FSE sequences":
    it "emits Block_Type=2 compressed blocks and round-trips word text":
        # @req REQ-ZSTD-ENC-001
        step("compress 16 KiB of word text at level 3")
        val plain = _word_text(16384)
        val frame = zstd_compress_frame(plain, _opts(3, false))
        # @capture(text)
        step("walk the frame and require a Block_Type=2 block")
        val types = _block_types(frame)
        expect(types.len()).to_equal(1)
        expect(types[0]).to_equal(2)
        step("decode with the in-repo decoder and compare")
        match zstd_decompress_frame(frame):
            case Ok(out): expect(_same(out, plain)).to_equal(true)
            case Err(_): fail("decoder rejected the compressed frame")

    it "shrinks word text below 45 percent at every level":
        # @req REQ-ZSTD-ENC-002
        step("compress 16 KiB of word text at levels 1, 3 and 19")
        val plain = _word_text(16384)
        # @capture(text)
        step("each frame is under 45 percent of the input")
        for level in [1, 3, 19]:
            val frame = zstd_compress_frame(plain, _opts(level, false))
            expect(frame.len() * 100 < plain.len() * 45).to_equal(true)
            match zstd_decompress_frame(frame):
                case Ok(out): expect(_same(out, plain)).to_equal(true)
                case Err(_): fail("decoder rejected the level frame")

    it "keeps the XXH64 checksum valid on a compressed frame":
        # @req REQ-ZSTD-ENC-003
        step("compress with checksum and decode it")
        val plain = _word_text(6000)
        val frame = zstd_compress_frame(plain, _opts(3, true))
        # @capture(text)
        step("decoder accepts the checksum and the output matches")
        match zstd_decompress_frame(frame):
            case Ok(out): expect(_same(out, plain)).to_equal(true)
            case Err(_): fail("checksum frame rejected")

    it "falls back to a Raw block when the data is incompressible":
        # @req REQ-ZSTD-ENC-004
        step("compress 4 KiB of pseudo-random bytes")
        val plain = _lcg_bytes(4096)
        val frame = zstd_compress_frame(plain, _opts(3, false))
        # @capture(text)
        step("the only block is Raw and the frame is input plus framing")
        val types = _block_types(frame)
        expect(types.len()).to_equal(1)
        expect(types[0]).to_equal(0)
        expect(frame.len() < plain.len() + 16).to_equal(true)
        match zstd_decompress_frame(frame):
            case Ok(out): expect(_same(out, plain)).to_equal(true)
            case Err(_): fail("raw fallback frame rejected")

    it "rejects a compressed frame whose sequence bitstream is corrupted":
        # @req REQ-ZSTD-ENC-005
        step("compress word text and flip the last byte of the sequence stream")
        val plain = _word_text(4096)
        var frame = zstd_compress_frame(plain, _opts(3, false))
        frame[frame.len() - 1] = 0u8
        # @capture(text)
        step("decoder errors or returns different bytes")
        match zstd_decompress_frame(frame):
            case Ok(out): expect(_same(out, plain)).to_equal(false)
            case Err(_): expect(true).to_equal(true)

    it "uses an RLE literals section for runs and still shrinks":
        # @req REQ-ZSTD-ENC-006
        step("compress alternating long runs of two bytes")
        var plain: [u8] = []
        var r = 0
        while r < 40:
            var k = 0
            while k < 50:
                plain.push(65u8)
                k = k + 1
            plain.push(66u8)
            r = r + 1
        val frame = zstd_compress_frame(plain, _opts(3, false))
        # @capture(text)
        step("frame is far smaller than the input and decodes back")
        expect(frame.len() * 10 < plain.len()).to_equal(true)
        match zstd_decompress_frame(frame):
            case Ok(out): expect(_same(out, plain)).to_equal(true)
            case Err(_): fail("run frame rejected")
