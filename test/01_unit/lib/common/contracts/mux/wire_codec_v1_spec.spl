# REQ-CMUX-001/002/003/006/007/008/011. NOT_RUN: no native/compiler run.
# Pure production codec controls. Fixtures are typed values, not live providers.
use std.spec.{describe, it, expect, step}
use std.common.contracts.mux.wire_envelope_v1.*
use std.common.contracts.mux.wire_exchange_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_validation_v1.*
use std.common.contracts.mux.wire_values_06_v1.{mux_wire_size_mux_wire_result_v1}
use std.common.contracts.mux.wire_budget_03_v1.{mux_wire_nodes_mux_wire_result_v1}
use std.common.sdn.strict_v1.{sdn_parse_strict_bytes_v1}
