use std.spec.{describe, it, expect, step}
use std.common.contracts.container.host_capability_v1.{
    ContainerHostCapabilityV1, ContainerHostRequirementV1,
    CONTAINER_CLIENT_PRIVILEGE_USER_V1, CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1,
    CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1,
    CONTAINER_ISOLATION_NATIVE_V1, CONTAINER_ISOLATION_NATIVE_SANDBOX_V1,
    CONTAINER_ISOLATION_VM_V1,
    container_host_admission_reason_v1
}

fn linux_host() -> ContainerHostCapabilityV1:
    ContainerHostCapabilityV1(host_os: "linux", guest_os: "linux",
        provider_id: "podman-provider", isolation_class: CONTAINER_ISOLATION_NATIVE_V1,
        client_privilege: CONTAINER_CLIENT_PRIVILEGE_USER_V1,
        admin_setup: false, launch_capable: true, reason: "observed")

fn linux_requirement() -> ContainerHostRequirementV1:
    ContainerHostRequirementV1(host_os: "linux", guest_os: "linux",
        isolation_class: CONTAINER_ISOLATION_NATIVE_V1,
        require_unprivileged_client: true)

describe "portable container host capability admission":
    it "admits an exact observed user-level host and guest":
        step("inspect host capability")
        expect(container_host_admission_reason_v1(
            linux_host(), linux_requirement())).to_equal("")

    it "rejects missing provider and host identities":
        var host = linux_host()
        host.provider_id = ""
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("host-capability-identity-missing")
        host = linux_host()
        host.guest_os = ""
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("host-capability-identity-missing")
        var required = linux_requirement()
        required.host_os = ""
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("host-requirement-identity-missing")

    it "rejects unsupported and mismatched isolation":
        var host = linux_host()
        host.isolation_class = "process"
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("host-isolation-unsupported")
        var required = linux_requirement()
        required.isolation_class = "process"
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("required-isolation-unsupported")
        required.isolation_class = CONTAINER_ISOLATION_VM_V1
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("virtual-machine-not-simple-container")

    it "requires exact host and guest operating systems":
        var required = linux_requirement()
        required.host_os = "windows"
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("host-guest-os-mismatch")

    it "rejects matching but unknown host and guest OS tokens":
        var host = linux_host()
        var required = linux_requirement()
        host.host_os = "foo"
        required.host_os = "foo"
        expect(container_host_admission_reason_v1(
            host, required)).to_equal("host-capability-os-unsupported")
        host = linux_host()
        required = linux_requirement()
        host.guest_os = "foo"
        required.guest_os = "foo"
        expect(container_host_admission_reason_v1(
            host, required)).to_equal("host-capability-os-unsupported")
        required = linux_requirement()
        required.host_os = "foo"
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("host-requirement-os-unsupported")
        required = linux_requirement()
        required.guest_os = "foo"
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("host-requirement-os-unsupported")
        required = linux_requirement()
        required.guest_os = "freebsd"
        expect(container_host_admission_reason_v1(
            linux_host(), required)).to_equal("host-guest-os-mismatch")

    it "rejects absent and unknown client privilege":
        var host = linux_host()
        host.client_privilege = "rootless"
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("host-client-privilege-invalid")
        host.client_privilege = CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("unprivileged-client-unavailable")
        var required = linux_requirement()
        required.require_unprivileged_client = false
        expect(container_host_admission_reason_v1(
            host, required)).to_equal("host-launch-unavailable")
        host = linux_host()
        host.launch_capable = false
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("host-launch-unavailable")

    it "admits a user-level route even when prior admin setup was needed":
        var host = linux_host()
        host.admin_setup = true
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("")

    it "matches a delegated unprivileged client route without authorizing launch":
        var host = linux_host()
        host.client_privilege = CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1
        host.admin_setup = true
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("")
        host.launch_capable = false
        expect(container_host_admission_reason_v1(
            host, linux_requirement())).to_equal("host-launch-unavailable")

    it "admits a native macOS sandbox for macOS workloads":
        var host = linux_host()
        host.host_os = "macos"
        host.guest_os = "macos"
        host.provider_id = "macos-app-sandbox-v1"
        host.isolation_class = CONTAINER_ISOLATION_NATIVE_SANDBOX_V1
        var required = linux_requirement()
        required.host_os = "macos"
        required.guest_os = "macos"
        required.isolation_class = CONTAINER_ISOLATION_NATIVE_SANDBOX_V1
        expect(container_host_admission_reason_v1(host, required)).to_equal("")
        host.guest_os = "simpleos"
        required.guest_os = "simpleos"
        expect(container_host_admission_reason_v1(host, required)).to_equal(
            "native-host-execution-os-mismatch")

    it "admits a native SimpleOS provider only for SimpleOS workloads":
        var host = linux_host()
        host.host_os = "simpleos"
        host.guest_os = "simpleos"
        host.provider_id = "simpleos-managed-container-v1"
        var required = linux_requirement()
        required.host_os = "simpleos"
        required.guest_os = "simpleos"
        expect(container_host_admission_reason_v1(host, required)).to_equal("")

    it "admits Windows process isolation as a native Windows container":
        var host = linux_host()
        host.host_os = "windows"
        host.guest_os = "windows"
        host.provider_id = "windows-process-container-v1"
        host.client_privilege = CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1
        var required = linux_requirement()
        required.host_os = "windows"
        required.guest_os = "windows"
        expect(container_host_admission_reason_v1(host, required)).to_equal("")
        host.guest_os = "linux"
        required.guest_os = "linux"
        expect(container_host_admission_reason_v1(host, required)).to_equal(
            "native-host-execution-os-mismatch")

    it "refuses to describe macOS sandbox execution as a native container":
        var host = linux_host()
        host.host_os = "macos"
        host.guest_os = "macos"
        var required = linux_requirement()
        required.host_os = "macos"
        required.guest_os = "macos"
        expect(container_host_admission_reason_v1(host, required)).to_equal(
            "macos-native-container-unsupported")

    it "refuses to claim the macOS sandbox class on another OS":
        var host = linux_host()
        host.isolation_class = CONTAINER_ISOLATION_NATIVE_SANDBOX_V1
        var required = linux_requirement()
        required.isolation_class = CONTAINER_ISOLATION_NATIVE_SANDBOX_V1
        expect(container_host_admission_reason_v1(host, required)).to_equal(
            "native-sandbox-host-unsupported")

    it "rejects a VM-backed Simple Container even if the OS tuple matches":
        var host = linux_host()
        host.host_os = "macos"
        host.guest_os = "simpleos"
        host.isolation_class = CONTAINER_ISOLATION_VM_V1
        var required = linux_requirement()
        required.host_os = "macos"
        required.guest_os = "simpleos"
        required.isolation_class = CONTAINER_ISOLATION_VM_V1
        expect(container_host_admission_reason_v1(host, required)).to_equal(
            "virtual-machine-not-simple-container")
