use std.spec.{describe, it, expect}
use std.spec.step
use std.common.contracts.container.workspace_preparation_deadline_v1.{workspace_preparation_deadline_v1,
    workspace_preparation_remaining_ms_v1}

describe "Distinct workspace preparation stage deadline":
    it "correlates the exact stage digest and operation before reporting remaining time":
        step("Keep workspace preparation authority separate from mapping and workload facts")
        val deadline = workspace_preparation_deadline_v1("a".repeat(64), "prepare-op", 5000).unwrap()
        expect(workspace_preparation_remaining_ms_v1(deadline, "a".repeat(64), "prepare-op", 4999).unwrap()).to_equal(1)
        expect(workspace_preparation_remaining_ms_v1(deadline, "b".repeat(64), "prepare-op", 4999).is_err()).to_equal(true)
        expect(workspace_preparation_remaining_ms_v1(deadline, "a".repeat(64), "keeper-launch", 4999).is_err()).to_equal(true)

    it "refuses equality at expiry, expired time and missing clock observation":
        step("Admit no mode effect after the verified preparation window")
        val deadline = workspace_preparation_deadline_v1("a".repeat(64), "prepare-op", 5000).unwrap()
        expect(workspace_preparation_remaining_ms_v1(deadline, "a".repeat(64), "prepare-op", 5000).is_err()).to_equal(true)
        expect(workspace_preparation_remaining_ms_v1(deadline, "a".repeat(64), "prepare-op", 5001).is_err()).to_equal(true)
        expect(workspace_preparation_remaining_ms_v1(deadline, "a".repeat(64), "prepare-op", -1).is_err()).to_equal(true)

    it "rejects malformed correlation and nonpositive expiry before producing a carrier":
        step("Validate public carrier data without treating the constructor as authentication")
        expect(workspace_preparation_deadline_v1("bad", "prepare-op", 5000).is_err()).to_equal(true)
        expect(workspace_preparation_deadline_v1("a".repeat(64), "../prepare", 5000).is_err()).to_equal(true)
        expect(workspace_preparation_deadline_v1("a".repeat(64), "prepare-op", 0).is_err()).to_equal(true)
