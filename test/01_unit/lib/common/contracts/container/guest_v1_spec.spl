# @req: REQ-MSG-002, REQ-MSG-003 (structural boundary only)
use std.spec.{describe, it, expect, step}
use std.common.contracts.container.runtime_v1.{RuntimeIdentityV1}
use std.common.contracts.container.guest_v1.{
    GuestContainerAttemptV1, GuestContainerObservationV1,
    guest_container_attempt_rejection_v1,
    guest_container_observation_rejection_v1,
    guest_container_exit_pair_rejection_v1
}

val HASH_A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val HASH_B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val HASH_C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

fn attempt() -> GuestContainerAttemptV1:
    GuestContainerAttemptV1(
        host_os: "macos", guest_os: "simpleos", runtime_class: "virtual-machine",
        identity: RuntimeIdentityV1(
            pod_uid: "pod-1", attempt: 1, provider_generation: 2,
            operation_id: "op-1", engine: "simpleos-managed-container-v1",
            native_id: "", node_boot_id: "boot-1"),
        guest_boot_id: "boot-1", guest_image_sha256: HASH_A,
        workload_sha256: HASH_B, policy_sha256: HASH_C, nonce: "nonce-1")

fn observation() -> GuestContainerObservationV1:
    GuestContainerObservationV1(operation_id: "op-1", guest_boot_id: "boot-1",
        nonce: "nonce-1", native_task_id: "42", phase: "exited",
        exit_code: 0, kernel_exit_observed: true)

fn running_observation() -> GuestContainerObservationV1:
    var observed = observation()
    observed.phase = "running"
    observed.exit_code = -1
    observed.kernel_exit_observed = false
    observed

describe "macOS SimpleOS guest container identity":
    it "accepts one bound guest task exit":
        step("Bind the host, guest boot, image, workload, policy and attempt")
        val request = attempt()
        expect(guest_container_attempt_rejection_v1(request)).to_equal("")
        expect(guest_container_observation_rejection_v1(request, observation())).to_equal("")
        expect(guest_container_exit_pair_rejection_v1(request,
            running_observation(), observation())).to_equal("")

    it "rejects a native macOS container claim and wrong guest boot":
        var request = attempt()
        request.runtime_class = "native-container"
        expect(guest_container_attempt_rejection_v1(request)).to_equal("runtime-class-mismatch")
        request = attempt()
        var identity = request.identity
        identity.node_boot_id = "old-boot"
        request.identity = identity
        expect(guest_container_attempt_rejection_v1(request)).to_equal("guest-binding-invalid")

    it "requires a macOS host and SimpleOS guest with a fresh request token":
        var request = attempt()
        request.host_os = "linux"
        expect(guest_container_attempt_rejection_v1(request)).to_equal("host-guest-os-mismatch")
        request = attempt()
        request.guest_os = "linux"
        expect(guest_container_attempt_rejection_v1(request)).to_equal("host-guest-os-mismatch")
        request = attempt()
        request.nonce = ""
        expect(guest_container_attempt_rejection_v1(request)).to_equal("guest-binding-invalid")
        request = attempt()
        request.nonce = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        expect(guest_container_attempt_rejection_v1(request)).to_equal("guest-binding-invalid")

    it "rejects invalid digests and an already bound task identifier":
        var request = attempt()
        request.workload_sha256 = "abc"
        expect(guest_container_attempt_rejection_v1(request)).to_equal("digest-invalid")
        request = attempt()
        var identity = request.identity
        identity.native_id = "42"
        request.identity = identity
        expect(guest_container_attempt_rejection_v1(request)).to_equal("runtime-identity-invalid")
        request = attempt()
        var identity2 = request.identity
        identity2.engine = "docker"
        request.identity = identity2
        expect(guest_container_attempt_rejection_v1(request)).to_equal("runtime-identity-invalid")

    it "rejects mismatched observations and unobserved exits":
        val request = attempt()
        var observed = observation()
        observed.nonce = "nonce-old"
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("observation-binding-mismatch")
        observed = observation()
        observed.guest_boot_id = "boot-old"
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("observation-binding-mismatch")
        observed = observation()
        observed.operation_id = "op-old"
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("observation-binding-mismatch")
        observed = observation()
        observed.kernel_exit_observed = false
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("kernel-exit-unobserved")

    it "only accepts a running observation before exit":
        val request = attempt()
        var observed = observation()
        observed.phase = "running"
        observed.exit_code = -1
        observed.kernel_exit_observed = false
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("")
        observed.exit_code = 0
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("running-observation-invalid")
        observed = running_observation()
        observed.kernel_exit_observed = true
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("running-observation-invalid")
        observed = observation()
        observed.phase = "unknown"
        expect(guest_container_observation_rejection_v1(request, observed)).to_equal("observation-phase-invalid")

    it "requires one positive task identity across start and exit":
        val request = attempt()
        var exited = observation()
        exited.native_task_id = "99"
        expect(guest_container_exit_pair_rejection_v1(request,
            running_observation(), exited)).to_equal("native-task-binding-mismatch")
        exited = observation()
        exited.native_task_id = "task-42"
        expect(guest_container_observation_rejection_v1(request, exited)).to_equal("native-task-id-invalid")
        exited.native_task_id = "0"
        expect(guest_container_observation_rejection_v1(request, exited)).to_equal("native-task-id-invalid")
        exited = observation()
        expect(guest_container_exit_pair_rejection_v1(request,
            observation(), exited)).to_equal("start-phase-invalid")
