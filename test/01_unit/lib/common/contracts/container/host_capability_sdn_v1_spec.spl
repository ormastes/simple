use std.spec.{describe, it, expect}
use std.common.contracts.container.host_capability_v1.{ContainerHostCapabilityV1}
use std.common.contracts.container.host_capability_sdn_v1.{
    format_container_host_capability_sdn_v1, parse_container_host_capability_sdn_v1
}
use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}

fn sample() -> ContainerHostCapabilityV1:
    ContainerHostCapabilityV1(
        host_os: "linux", guest_os: "linux", provider_id: "rootless-podman",
        isolation_class: "native-container", client_privilege: "user",
        admin_setup: false, launch_capable: true,
        reason: "space, quote\" slash\\ percent%")

fn parse_reason(receipt: text) -> text:
    match parse_container_host_capability_sdn_v1(receipt):
        case Err(reason): reason
        case Ok(_): "accepted"

describe "container capability SDN receipt":
    it "round trips bounded escaped values and booleans":
        match format_container_host_capability_sdn_v1(sample()):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                expect(receipt.starts_with("container_host_capability |field, value|\n    \"schema\", \"simple-container-host-capability-v1\"\n")).to_equal(true)
                expect(receipt.contains("space, quote\\\" slash\\\\ percent%")).to_equal(true)
                match parse_container_host_capability_sdn_v1(receipt):
                    case Err(_): expect(false).to_equal(true)
                    case Ok(parsed):
                        expect(parsed.reason).to_equal(sample().reason)
                        expect(parsed.launch_capable).to_equal(true)
                        expect(parsed.admin_setup).to_equal(false)
                match parse(receipt):
                    case Err(_): expect(false).to_equal(true)
                    case Ok(document):
                        match document.get_path("container_host_capability") ?? SdnValue.Null:
                            case SdnValue.Table(headers, rows):
                                expect(headers.len()).to_equal(2)
                                expect(rows.len()).to_equal(9)
                                match rows[8][1]:
                                    case SdnValue.String(reason): expect(reason).to_equal(sample().reason)
                                    case _: expect(false).to_equal(true)
                            case _: expect(false).to_equal(true)

    it "rejects malformed and noncanonical rows":
        match format_container_host_capability_sdn_v1(sample()):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                expect(parse_reason(receipt.replace("quote\\\"", "quote\\x"))).to_equal("malformed-escape")
                expect(parse_reason(receipt.replace("quote\\\"", "quote\""))).to_equal("unescaped-value")
                expect(parse_reason(receipt.replace("\"host_os\"", "\"unknown\""))).to_equal("receipt-field-invalid")
                expect(parse_reason(receipt.replace("\"reason\"", "\"host_os\""))).to_equal("receipt-field-invalid")
                expect(parse_reason(receipt.replace("\"true\"", "\"yes\""))).to_equal("receipt-boolean-invalid")
                expect(parse_reason(receipt + "\n")).to_equal("receipt-shape-invalid")
                expect(parse_reason(receipt.replace("simple-container-host-capability-v1", "other"))).to_equal("receipt-schema-invalid")

    it "rejects unknown capability identities and enum values":
        match format_container_host_capability_sdn_v1(sample()):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                expect(parse_reason(receipt.replace("\"host_os\", \"linux\"", "\"host_os\", \"unknown\""))).to_equal("host-capability-os-unsupported")
                expect(parse_reason(receipt.replace("\"guest_os\", \"linux\"", "\"guest_os\", \"unknown\""))).to_equal("host-capability-os-unsupported")
                expect(parse_reason(receipt.replace("\"host_os\", \"linux\"", "\"host_os\", \"\""))).to_equal("host-capability-identity-missing")
                expect(parse_reason(receipt.replace("\"guest_os\", \"linux\"", "\"guest_os\", \"\""))).to_equal("host-capability-identity-missing")
                expect(parse_reason(receipt.replace("\"provider_id\", \"rootless-podman\"", "\"provider_id\", \"\""))).to_equal("host-capability-identity-missing")
                expect(parse_reason(receipt.replace("\"native-container\"", "\"unknown-isolation\""))).to_equal("host-isolation-unsupported")
                expect(parse_reason(receipt.replace("\"client_privilege\", \"user\"", "\"client_privilege\", \"root\""))).to_equal("host-client-privilege-invalid")

    it "retains a blocked capability receipt":
        var capability = sample()
        capability.launch_capable = false
        capability.client_privilege = "unavailable"
        capability.reason = "provider-unavailable"
        match format_container_host_capability_sdn_v1(capability):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                expect(parse_reason(receipt)).to_equal("accepted")
                match parse_container_host_capability_sdn_v1(receipt):
                    case Err(_): expect(false).to_equal(true)
                    case Ok(parsed):
                        expect(parsed.launch_capable).to_equal(false)
                        expect(parsed.reason).to_equal("provider-unavailable")

    it "round trips a native macOS sandbox without changing its isolation class":
        var capability = sample()
        capability.host_os = "macos"
        capability.guest_os = "macos"
        capability.provider_id = "macos-app-sandbox-v1"
        capability.isolation_class = "native-sandbox"
        match format_container_host_capability_sdn_v1(capability):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                match parse_container_host_capability_sdn_v1(receipt):
                    case Err(_): expect(false).to_equal(true)
                    case Ok(parsed):
                        expect(parsed.host_os).to_equal("macos")
                        expect(parsed.guest_os).to_equal("macos")
                        expect(parsed.isolation_class).to_equal("native-sandbox")

    it "rejects oversized values and round trips canonical control escapes":
        var capability = sample()
        capability.reason = "a".repeat(257)
        match format_container_host_capability_sdn_v1(capability):
            case Err(reason): expect(reason).to_equal("value-out-of-bounds")
            case Ok(_): expect(false).to_equal(true)
        capability = sample()
        capability.reason = "line\nbreak"
        match format_container_host_capability_sdn_v1(capability):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                expect(receipt.contains("line\\nbreak")).to_equal(true)
                match parse_container_host_capability_sdn_v1(receipt):
                    case Err(_): expect(false).to_equal(true)
                    case Ok(parsed): expect(parsed.reason).to_equal("line\nbreak")
        capability.reason = "line\tbreak\r"
        match format_container_host_capability_sdn_v1(capability):
            case Err(_): expect(false).to_equal(true)
            case Ok(receipt):
                expect(receipt.contains("line\\tbreak\\r")).to_equal(true)
                match parse_container_host_capability_sdn_v1(receipt):
                    case Err(_): expect(false).to_equal(true)
                    case Ok(parsed): expect(parsed.reason).to_equal("line\tbreak\r")
