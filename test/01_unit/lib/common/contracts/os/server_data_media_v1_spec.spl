use std.common.contracts.os.server_data_media_v1.{
    ServerDataImageIdentityV1, SERVER_DATA_ROLE_V1, SERVER_DATA_SERIAL_V1,
    SERVER_DATA_SECTOR_SIZE_V1, SERVER_DATA_MIN_BLOCKS_V1,
    server_data_identity_sector_v1, validate_server_data_identity_sector_v1,
    server_data_identity_set_accepts_v1
}

fn valid_identity(uuid_lo: u64) -> ServerDataImageIdentityV1:
    ServerDataImageIdentityV1(
        role: SERVER_DATA_ROLE_V1, serial: SERVER_DATA_SERIAL_V1,
        uuid_hi: 17u64, uuid_lo: uuid_lo, sector_size: SERVER_DATA_SECTOR_SIZE_V1,
        block_count: SERVER_DATA_MIN_BLOCKS_V1, empty_root_generation: 1u64)

describe "SimpleOS server-data image identity bytes":
    it "round trips deterministic role serial UUID geometry generation and checksum":
        val identity = valid_identity(29u64)
        val first = server_data_identity_sector_v1(identity).unwrap()
        val second = server_data_identity_sector_v1(identity).unwrap()
        expect(first).to_equal(second)
        val checked = validate_server_data_identity_sector_v1(first)
        expect(checked.accepted).to_equal(true)
        expect(checked.identity.role).to_equal(SERVER_DATA_ROLE_V1)
        expect(checked.identity.serial).to_equal(SERVER_DATA_SERIAL_V1)
        expect(checked.identity.uuid_lo).to_equal(29u64)
        expect(checked.identity.block_count).to_equal(SERVER_DATA_MIN_BLOCKS_V1)

    it "rejects corruption and zero identity":
        var bytes = server_data_identity_sector_v1(valid_identity(31u64)).unwrap()
        bytes[44] = bytes[44] ^ 1u8
        expect(validate_server_data_identity_sector_v1(bytes).accepted).to_equal(false)
        val zero = ServerDataImageIdentityV1(
            role: SERVER_DATA_ROLE_V1, serial: SERVER_DATA_SERIAL_V1,
            uuid_hi: 0u64, uuid_lo: 0u64, sector_size: SERVER_DATA_SECTOR_SIZE_V1,
            block_count: SERVER_DATA_MIN_BLOCKS_V1, empty_root_generation: 1u64)
        expect(server_data_identity_sector_v1(zero).is_err()).to_equal(true)

    it "rejects nonzero reserved bytes and trailing bytes after a field terminator":
        var reserved = server_data_identity_sector_v1(valid_identity(35u64)).unwrap()
        reserved[200] = 1u8
        expect(validate_server_data_identity_sector_v1(reserved).accepted).to_equal(false)
        var trailing = server_data_identity_sector_v1(valid_identity(36u64)).unwrap()
        # The canonical role ends before this byte; trailing field material is
        # rejected rather than silently normalized during decode/re-encode.
        trailing[70] = 65u8
        expect(validate_server_data_identity_sector_v1(trailing).accepted).to_equal(false)

    it "rejects duplicate server-data identities and root UUID reuse":
        val one = valid_identity(41u64)
        expect(server_data_identity_set_accepts_v1([one], 1u64, 2u64).is_ok()).to_equal(true)
        expect(server_data_identity_set_accepts_v1([one, valid_identity(42u64)], 1u64, 2u64).is_err()).to_equal(true)
        expect(server_data_identity_set_accepts_v1([one], one.uuid_hi, one.uuid_lo).is_err()).to_equal(true)

    it "uses order-independent duplicate precedence":
        val root = valid_identity(51u64)
        val other = valid_identity(52u64)
        val forward = server_data_identity_set_accepts_v1([root, other], root.uuid_hi, root.uuid_lo)
        val reverse = server_data_identity_set_accepts_v1([other, root], root.uuid_hi, root.uuid_lo)
        expect(forward.unwrap_err()).to_equal("duplicate server-data image identities")
        expect(reverse.unwrap_err()).to_equal("duplicate server-data image identities")
