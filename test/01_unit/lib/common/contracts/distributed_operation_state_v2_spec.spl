# DBC-021: an uncertain external write never becomes permission to execute again.
use std.spec.{describe, it, expect}
use std.common.contracts.distributed_operation_state_v2.*

fn state_envelope() -> text:
    "DBC_OPERATION_V2\noperation_1\n" + "a".repeat(64) + "\nuser_1\nproject_1\nworker_1\nbuild\n" + "b".repeat(64) + "\n4\n2\n3\n1024\n1000\n"

fn admitted_state() -> DistributedOperationStateV2:
    distributed_operation_initial_v2(state_envelope()).unwrap()

fn executing_state() -> DistributedOperationStateV2:
    distributed_operation_transition_v2(admitted_state(), "executing", "").unwrap()

describe "distributed operation replay state":
    it "returns prior admission for the exact duplicate":
        expect(distributed_operation_duplicate_v2(admitted_state(), state_envelope())).to_equal("ALREADY_ADMITTED")

    it "rejects changed request under the same operation ID":
        expect(distributed_operation_duplicate_v2(admitted_state(), state_envelope().replace("1024", "2048"))).to_equal("OPERATION_PAYLOAD_MISMATCH")

    it "preserves unknown outcome and forbids a second execution transition":
        val unknown = distributed_operation_transition_v2(executing_state(), "outcome-unknown", "").unwrap()
        expect(distributed_operation_duplicate_v2(unknown, state_envelope())).to_equal("OUTCOME_UNKNOWN")
        expect(distributed_operation_transition_v2(unknown, "executing", "").is_err()).to_equal(true)

    it "requires terminal evidence before recording completion":
        expect(distributed_operation_transition_v2(executing_state(), "completed", "").is_err()).to_equal(true)
        val completed = distributed_operation_transition_v2(executing_state(), "completed", "c".repeat(64)).unwrap()
        expect(distributed_operation_duplicate_v2(completed, state_envelope())).to_equal("RETAINED_OUTCOME")
        expect(distributed_operation_transition_v2(completed, "executing", "").is_err()).to_equal(true)

    it "does not permit completion without an executing admission":
        expect(distributed_operation_transition_v2(admitted_state(), "completed", "c".repeat(64)).is_err()).to_equal(true)

    it "allows cancellation before execution only with a retained receipt":
        expect(distributed_operation_transition_v2(admitted_state(), "cancelled", "").is_err()).to_equal(true)
        val cancelled = distributed_operation_transition_v2(admitted_state(), "cancelled", "d".repeat(64)).unwrap()
        expect(cancelled.state).to_equal("cancelled")
