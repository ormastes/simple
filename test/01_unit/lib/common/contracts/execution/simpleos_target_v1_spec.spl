# @req: REQ-LIB-COMMON-CONTRACTS-EXECUTION-001

# @codex-impl
# @req REQ-002 REQ-009 REQ-010 REQ-011 REQ-019

use std.spec.*
use common.contracts.execution.simpleos_target_v1.{
    simpleos_target_v1_is_userland_triple,
    simpleos_target_v1_abi_for_triple,
    simpleos_target_v1_firmware_for_triple,
    simpleos_target_v1_canonical_triples,
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE,
    SIMPLEOS_TARGET_V1_AARCH64_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE
}

use std.spec.step

describe "SimpleOS canonical target contract v1":
    it "binds required architecture triples to ABI and firmware profiles":
        # @req: REQ-002
        step("Verify: binds required architecture triples to ABI and firmware profiles")
        # @req: REQ-LIB-COMMON-CONTRACTS-EXECUTION-001.
        # @req: REQ-LIB-COMMON-CONTRACTS-EXECUTION-001
        # @req: REQ-019
        # @req: REQ-011
        expect(simpleos_target_v1_abi_for_triple(SIMPLEOS_TARGET_V1_X86_64_TRIPLE)).to_equal("sysv")
        expect(simpleos_target_v1_firmware_for_triple(SIMPLEOS_TARGET_V1_X86_64_TRIPLE)).to_equal("LimineBios")
        expect(simpleos_target_v1_abi_for_triple(SIMPLEOS_TARGET_V1_AARCH64_TRIPLE)).to_equal("aapcs64")
        expect(simpleos_target_v1_firmware_for_triple(SIMPLEOS_TARGET_V1_AARCH64_TRIPLE)).to_equal("RawLoader")
        expect(simpleos_target_v1_abi_for_triple(SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE)).to_equal("lp64d")
        expect(simpleos_target_v1_firmware_for_triple(SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE)).to_equal("OpenSbi")

    it "rejects unknown triples without inferring a host target":
        # @req: REQ-009
        step("Verify: rejects unknown triples without inferring a host target")
        expect(simpleos_target_v1_is_userland_triple("mips64-unknown-simpleos")).to_equal(false)
        expect(simpleos_target_v1_abi_for_triple("mips64-unknown-simpleos")).to_equal("")
        expect(simpleos_target_v1_firmware_for_triple("mips64-unknown-simpleos")).to_equal("")

    it "publishes a duplicate-free nonempty canonical catalog":
        # @req: REQ-010
        step("Verify: publishes a duplicate-free nonempty canonical catalog")
        val triples = simpleos_target_v1_canonical_triples()
        expect(triples.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        var i = 0
        while i < triples.len():
            expect(triples[i].trim() == "").to_equal(false)
            var j = i + 1
            while j < triples.len():
                expect(triples[i] == triples[j]).to_equal(false)
                j = j + 1
            i = i + 1
