# DBC-005/006/018: public signed frames are untrusted values, not approvals.
use std.spec.{describe, it, expect}
use std.common.contracts.distributed_authority_v2.*
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.contracts.distributed_control_v2.*

fn authority_wire_signature() -> [u8]:
    var bytes: [u8] = []
    for i in 0..64: bytes.push(0u8)
    bytes

fn authority_wire_grant() -> DistributedSignedGrantV2:
    val grant = ExecutionGrantV2(id: "grant_1", principal: "user_1", project: "project_1",
        host_id: "worker_1", operations: ["build"], environment_digest: "a".repeat(64),
        policy_revision: 4, revocation_epoch: 2, expires_at: 200,
        maximum_memory_bytes: 1024, maximum_duration_ms: 1000)
    DistributedSignedGrantV2(grant: grant, issuer_id: "issuer_1", key_revision: 1,
        signature: authority_wire_signature())

fn authority_wire_grant_golden() -> text:
    val body = "DBC_EXECUTION_GRANT_V2\ngrant_1\nuser_1\nproject_1\nworker_1\n" +
        "a".repeat(64) + "\n4\n2\n200\n1024\n1000\n1\nbuild\n"
    "DBC_SIGNED_GRANT_V2\nissuer_1\n1\n" + body.replace("\n", "%0A") + "\n" + "0".repeat(128) + "\n"

fn authority_wire_approval() -> DistributedSignedApprovalV2:
    DistributedSignedApprovalV2(approver_id: "approver_1", key_revision: 1,
        grant_digest: "a".repeat(64), request_digest: "b".repeat(64), policy_revision: 4,
        session_generation: 3, expires_at: 190, signature: authority_wire_signature())

fn authority_wire_approval_golden() -> text:
    "DBC_SIGNED_APPROVAL_V2\napprover_1\n1\n" + "a".repeat(64) + "\n" + "b".repeat(64) +
        "\n4\n3\n190\n" + "0".repeat(128) + "\n"

fn authority_wire_grant_error(payload: text) -> text:
    match distributed_decode_signed_grant_v2(payload):
        case Ok(value): ""
        case Err(reason): reason

describe "strict bounded public signed authority frames":
    it "encodes independently specified grant and approval frames":
        match distributed_encode_signed_grant_v2(authority_wire_grant()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(payload): expect(payload).to_equal(authority_wire_grant_golden())
        match distributed_encode_signed_approval_v2(authority_wire_approval()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(payload): expect(payload).to_equal(authority_wire_approval_golden())

    it "decodes exact untrusted signature fields":
        match distributed_decode_signed_grant_v2(authority_wire_grant_golden()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(value):
                expect(value.issuer_id).to_equal("issuer_1")
                expect(value.grant.id).to_equal("grant_1")
                expect(value.signature.len()).to_equal(64)
        match distributed_decode_signed_approval_v2(authority_wire_approval_golden()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(value):
                expect(value.approver_id).to_equal("approver_1")
                expect(value.request_digest).to_equal("b".repeat(64))
                expect(value.session_generation).to_equal(3)

    it "rejects unsupported versions, trailing fields, truncation and oversized input":
        expect(authority_wire_grant_error(authority_wire_grant_golden().replace("SIGNED_GRANT_V2", "SIGNED_GRANT_V1"))).to_equal("VERSION_UNSUPPORTED")
        expect(authority_wire_grant_error(authority_wire_grant_golden() + "extra\n")).to_equal("trailing wire fields")
        expect(authority_wire_grant_error("DBC_SIGNED_GRANT_V2\n")).to_equal("truncated wire record")
        expect(authority_wire_grant_error("x".repeat(65537))).to_equal("WIRE_TOO_LARGE")

    it "rejects noncanonical and malformed signature hex":
        expect(authority_wire_grant_error(authority_wire_grant_golden().replace("0".repeat(128), "A".repeat(128)))).to_equal("SIGNATURE_NONCANONICAL")
        expect(authority_wire_grant_error(authority_wire_grant_golden().replace("0".repeat(128), "x".repeat(128)))).to_equal("SIGNATURE_NONCANONICAL")
        expect(authority_wire_grant_error(authority_wire_grant_golden().replace("0".repeat(128), "0".repeat(127)))).to_equal("SIGNATURE_INVALID")

    it "rejects noncanonical key revisions and invalid encode signature length":
        expect(authority_wire_grant_error(authority_wire_grant_golden().replace("\n1\n", "\n01\n"))).to_equal("noncanonical wire integer")
        var value = authority_wire_grant()
        value.signature = []
        match distributed_encode_signed_grant_v2(value):
            case Ok(payload): expect("accepted empty signature").to_equal("SIGNATURE_INVALID")
            case Err(reason): expect(reason).to_equal("SIGNATURE_INVALID")
