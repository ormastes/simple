# DBC-005/006/018/020: canonical grant bytes are not issuer authentication.
use std.spec.{describe, it, expect}
use std.common.contracts.distributed_control_v2.*
use std.common.contracts.distributed_control_codec_v2.*
use std.common.crypto.sha256.sha256_text

fn codec_grant() -> ExecutionGrantV2:
    ExecutionGrantV2(id: "grant_1", principal: "user_1", project: "project_1",
        host_id: "worker_1", operations: ["build", "test"], environment_digest: "a".repeat(64),
        policy_revision: 4, revocation_epoch: 2, expires_at: 200,
        maximum_memory_bytes: 1024, maximum_duration_ms: 1000)

fn grant_golden_wire() -> text:
    "DBC_EXECUTION_GRANT_V2\ngrant_1\nuser_1\nproject_1\nworker_1\n" +
        "a".repeat(64) + "\n4\n2\n200\n1024\n1000\n2\nbuild\ntest\n"

fn grant_decode_error(payload: text) -> text:
    match distributed_decode_grant_v2(payload):
        case Ok(value): ""
        case Err(reason): reason

describe "bounded canonical execution grant V2 wire":
    it "encodes independent golden bytes and digest":
        match distributed_encode_grant_v2(codec_grant()):
            case Ok(payload): expect(payload).to_equal(grant_golden_wire())
            case Err(reason): expect(reason).to_equal("")
        match distributed_grant_digest_v2(codec_grant()):
            case Ok(digest): expect(digest).to_equal(sha256_text(grant_golden_wire()))
            case Err(reason): expect(reason).to_equal("")

    it "decodes each scope, lifetime and resource value from golden bytes":
        match distributed_decode_grant_v2(grant_golden_wire()):
            case Err(reason): expect(reason).to_equal("")
            case Ok(grant):
                expect(grant.id).to_equal("grant_1")
                expect(grant.principal).to_equal("user_1")
                expect(grant.project).to_equal("project_1")
                expect(grant.host_id).to_equal("worker_1")
                expect(grant.environment_digest).to_equal("a".repeat(64))
                expect(grant.policy_revision).to_equal(4)
                expect(grant.revocation_epoch).to_equal(2)
                expect(grant.expires_at).to_equal(200)
                expect(grant.maximum_memory_bytes).to_equal(1024)
                expect(grant.maximum_duration_ms).to_equal(1000)
                expect(grant.operations).to_equal(["build", "test"])

    it "rejects version changes, trailing fields and oversized input":
        expect(grant_decode_error(grant_golden_wire().replace("GRANT_V2", "GRANT_V1"))).to_equal("VERSION_UNSUPPORTED")
        expect(grant_decode_error(grant_golden_wire() + "extra\n")).to_equal("trailing wire fields")
        expect(grant_decode_error("x".repeat(65537))).to_equal("WIRE_TOO_LARGE")

    it "rejects duplicate operations and count over the allocation bound":
        expect(grant_decode_error(grant_golden_wire().replace("test\n", "build\n"))).to_equal("OPERATIONS_DUPLICATE")
        var lines = grant_golden_wire().split("\n")
        lines[11] = "65"
        expect(grant_decode_error(lines.join("\n"))).to_equal("wire integer exceeds bound")

    it "rejects noncanonical integers and invalid resource values":
        expect(grant_decode_error(grant_golden_wire().replace("\n4\n", "\n04\n"))).to_equal("noncanonical wire integer")
        expect(grant_decode_error(grant_golden_wire().replace("\n1024\n", "\n0\n"))).to_equal("INTEGER_INVALID")
        var grant = codec_grant()
        grant.maximum_duration_ms = 10000000000000000
        expect(distributed_grant_wire_validate_v2(grant)).to_equal("INTEGER_TOO_LARGE")
