# @cover src/lib/common/css/shorthand.spl 80%
"""
# CSS Shorthand Expansion Specification

**Category:** Browser / CSS
**Status:** Active

## Overview

A CSS shorthand is a write to every longhand it covers, including the ones the
author did not mention — those are written back to their initial value. This
specification pins the two properties every consumer of the expansion depends
on: the expansion is COMPLETE (never a partial longhand set), and a value that
cannot be decomposed FAILS (returns nil) rather than expanding halfway.
"""

use std.spipe.*
use std.common.css.shorthand.{
    CssLonghand, expand_shorthand, is_shorthand, longhands_of,
    expand_box_values, split_css_components, split_css_comma_list
}

# Render an expansion as `prop=value;prop=value;...` so a full longhand set is
# comparable in one assertion — a per-property assertion could pass while the
# set was incomplete, which is the exact defect this module exists to prevent.
fn _expand(property: text, value: text) -> text:
    if val longhands = expand_shorthand(property, value):
        var out: text = ""
        var i = 0
        while i < longhands.len():
            val lh = longhands[i as i32]
            if out.len() > 0:
                out = out + ";"
            out = out + lh.property + "=" + lh.value
            i = i + 1
        return out
    "invalid"

fn _join(parts: [text]) -> text:
    var out: text = ""
    var i = 0
    while i < parts.len():
        if out.len() > 0:
            out = out + "|"
        out = out + parts[i as i32]
        i = i + 1
    out

# @manual_section: Component splitting
describe "split_css_components":
    """
    As a CSS engine, I want a shorthand value split into the components the
    author wrote, so that a function such as `rgb(1, 2, 3)` counts as the one
    colour it is rather than as three stray numbers that make the whole
    declaration look invalid.
    """

    # @req REQ-CSS-SHORTHAND-SPLIT
    it "keeps a function call as one component":
        step("split `1px solid rgb(1, 2, 3)`")
        expect(_join(split_css_components("1px solid rgb(1, 2, 3)"))).to_equal("1px|solid|rgb(1, 2, 3)")

    # @req REQ-CSS-SHORTHAND-SPLIT
    it "collapses runs of whitespace instead of emitting empty components":
        step("split a value padded with repeated spaces")
        expect(_join(split_css_components("  10px    20px  "))).to_equal("10px|20px")

    # @req REQ-CSS-SHORTHAND-SPLIT
    it "splits a layer list on top-level commas only":
        step("split `url(a.png) 1px, red` into two layers")
        expect(_join(split_css_comma_list("url(a.png) 1px, red"))).to_equal("url(a.png) 1px|red")

# @manual_section: Box shorthands
describe "expand_box_values":
    """
    As a CSS engine, I want the 1/2/3/4-value box form resolved to four
    explicit sides, so that `margin: 0 auto` sets all four margins rather than
    leaving a previously written `margin-left` alive underneath it.
    """

    # @req REQ-CSS-SHORTHAND-BOX
    it "expands one value to all four sides":
        step("expand `5px`")
        expect(_expand("margin", "5px")).to_equal(
            "margin-top=5px;margin-right=5px;margin-bottom=5px;margin-left=5px")

    # @req REQ-CSS-SHORTHAND-BOX
    it "expands two values to vertical then horizontal":
        step("expand `0 auto`")
        expect(_expand("margin", "0 auto")).to_equal(
            "margin-top=0;margin-right=auto;margin-bottom=0;margin-left=auto")

    # @req REQ-CSS-SHORTHAND-BOX
    it "expands three values to top, horizontal, bottom":
        step("expand `1px 2px 3px`")
        expect(_expand("padding", "1px 2px 3px")).to_equal(
            "padding-top=1px;padding-right=2px;padding-bottom=3px;padding-left=2px")

    # @req REQ-CSS-SHORTHAND-BOX
    it "expands four values clockwise from the top":
        step("expand `1px 2px 3px 4px`")
        expect(_expand("padding", "1px 2px 3px 4px")).to_equal(
            "padding-top=1px;padding-right=2px;padding-bottom=3px;padding-left=4px")

    # @req REQ-CSS-SHORTHAND-INVALID
    it "reports a five-value box form as invalid rather than truncating it":
        step("expand a box value with five components")
        expect(_expand("margin", "1px 2px 3px 4px 5px")).to_equal("invalid")

    # @req REQ-CSS-SHORTHAND-BOX
    it "writes the four offset longhands for inset, not prefixed ones":
        step("expand `inset: 0`")
        expect(_expand("inset", "0")).to_equal("top=0;right=0;bottom=0;left=0")

# @manual_section: Border and outline
describe "border shorthands":
    """
    As a CSS engine, I want `border` to write all twelve side longhands with
    initial values filled in for the components the author omitted, so that a
    later `border: 1px solid red` cannot inherit a stale style or colour from
    an earlier declaration.
    """

    # @req REQ-CSS-SHORTHAND-BORDER
    it "fills omitted components with their initial values":
        step("expand `border-top: solid`, mentioning only the style")
        expect(_expand("border-top", "solid")).to_equal(
            "border-top-width=medium;border-top-style=solid;border-top-color=currentcolor")

    # @req REQ-CSS-SHORTHAND-BORDER
    it "accepts the three components in any order":
        step("expand `red solid 2px`, written back to front")
        expect(_expand("border-left", "red solid 2px")).to_equal(
            "border-left-width=2px;border-left-style=solid;border-left-color=red")

    # @req REQ-CSS-SHORTHAND-BORDER
    it "writes all four sides for the un-suffixed border shorthand":
        step("expand `border: 1px solid red` and count the longhands")
        val expanded = expand_shorthand("border", "1px solid red")
        var count = 0
        if val list = expanded:
            count = list.len()
        expect(count).to_equal(12)

    # @req REQ-CSS-SHORTHAND-INVALID
    it "rejects a border value with an unrecognisable component":
        step("expand `border: 1px wiggly red`")
        expect(_expand("border", "1px wiggly red")).to_equal("invalid")

    # @req REQ-CSS-SHORTHAND-BORDER
    it "expands outline the same way as a border side":
        step("expand `outline: thin dotted`")
        expect(_expand("outline", "thin dotted")).to_equal(
            "outline-width=thin;outline-style=dotted;outline-color=currentcolor")

# @manual_section: flex
describe "the flex shorthand":
    """
    As a CSS engine, I want `flex: 1` to mean grow 1 / shrink 1 / basis 0, so
    that a single-number flex behaves the way the specification says rather
    than the way the property name suggests.
    """

    # @req REQ-CSS-SHORTHAND-FLEX
    it "gives the one-number form a zero basis, not auto":
        step("expand `flex: 1`")
        expect(_expand("flex", "1")).to_equal("flex-grow=1;flex-shrink=1;flex-basis=0")

    # @req REQ-CSS-SHORTHAND-FLEX
    it "expands the none keyword to a rigid item":
        step("expand `flex: none`")
        expect(_expand("flex", "none")).to_equal("flex-grow=0;flex-shrink=0;flex-basis=auto")

    # @req REQ-CSS-SHORTHAND-FLEX
    it "reads a length one-value form as a basis, keeping grow at 1":
        step("expand `flex: 30px`")
        expect(_expand("flex", "30px")).to_equal("flex-grow=1;flex-shrink=1;flex-basis=30px")

    # @req REQ-CSS-SHORTHAND-FLEX
    it "expands the three-value form positionally":
        step("expand `flex: 2 3 auto`")
        expect(_expand("flex", "2 3 auto")).to_equal("flex-grow=2;flex-shrink=3;flex-basis=auto")

# @manual_section: font and background
describe "multi-axis shorthands":
    """
    As a CSS engine, I want `font` and `background` expanded only when I can
    decompose them completely, so that a system-font keyword or a multi-layer
    background is reported as unexpanded instead of turning into a fabricated
    set of longhands.
    """

    # @req REQ-CSS-SHORTHAND-FONT
    it "expands a font with size and family":
        step("expand `font: italic bold 12px/1.5 Arial, sans-serif`")
        expect(_expand("font", "italic bold 12px/1.5 Arial, sans-serif")).to_equal(
            "font-style=italic;font-variant=normal;font-weight=bold;font-stretch=normal;"
            + "font-size=12px;line-height=1.5;font-family=Arial, sans-serif")

    # @req REQ-CSS-SHORTHAND-INVALID
    it "refuses to expand a system font keyword it has no metrics for":
        step("expand `font: caption`")
        expect(_expand("font", "caption")).to_equal("invalid")

    # @req REQ-CSS-SHORTHAND-INVALID
    it "refuses a font with a size but no family":
        step("expand `font: 12px`")
        expect(_expand("font", "12px")).to_equal("invalid")

    # @req REQ-CSS-SHORTHAND-BACKGROUND
    it "expands a single-layer background with initial values for the rest":
        step("expand `background: red`")
        expect(_expand("background", "red")).to_equal(
            "background-color=red;background-image=none;background-repeat=repeat;"
            + "background-attachment=scroll;background-position=0% 0%;background-size=auto;"
            + "background-origin=padding-box;background-clip=border-box")

    # @req REQ-CSS-SHORTHAND-INVALID
    it "refuses a multi-layer background rather than expanding only the first layer":
        step("expand `background: url(a.png), red`")
        expect(_expand("background", "url(a.png), red")).to_equal("invalid")

# @manual_section: CSS-wide keywords
describe "CSS-wide keywords":
    """
    As a CSS engine, I want `inherit` on a shorthand propagated to every one of
    its longhands, because a shorthand set to a CSS-wide keyword sets all of
    them and leaving any behind would keep a stale value alive.
    """

    # @req REQ-CSS-SHORTHAND-WIDE
    it "propagates inherit to every longhand of the shorthand":
        step("expand `margin: inherit`")
        expect(_expand("margin", "inherit")).to_equal(
            "margin-top=inherit;margin-right=inherit;margin-bottom=inherit;margin-left=inherit")

    # @req REQ-CSS-SHORTHAND-WIDE
    it "propagates unset across a three-longhand shorthand":
        step("expand `flex: unset`")
        expect(_expand("flex", "unset")).to_equal(
            "flex-grow=unset;flex-shrink=unset;flex-basis=unset")

# @manual_section: The reset set
describe "longhands_of":
    """
    As a CSS engine, I want to name every longhand a shorthand writes without
    having a value in hand, so that invalidation and diffing know the full
    reset set rather than only the properties an author happened to mention.
    """

    # @req REQ-CSS-SHORTHAND-RESET
    it "names all four sides for a box shorthand":
        step("ask for the longhands of `padding`")
        expect(_join(longhands_of("padding"))).to_equal(
            "padding-top|padding-right|padding-bottom|padding-left")

    # @req REQ-CSS-SHORTHAND-RESET
    it "names all seven font longhands":
        step("count the longhands of `font`")
        expect(longhands_of("font").len()).to_equal(7)

    # @req REQ-CSS-SHORTHAND-RESET
    it "names nothing for a property that is not a shorthand":
        step("ask for the longhands of `color`")
        expect(longhands_of("color").len()).to_equal(0)

    # @req REQ-CSS-SHORTHAND-RESET
    it "recognises a shorthand regardless of case and surrounding space":
        step("ask whether `  MARGIN ` is a shorthand")
        expect(is_shorthand("  MARGIN ")).to_equal(true)

    # @req REQ-CSS-SHORTHAND-RESET
    it "does not claim a longhand is a shorthand":
        step("ask whether `margin-left` is a shorthand")
        expect(is_shorthand("margin-left")).to_equal(false)
