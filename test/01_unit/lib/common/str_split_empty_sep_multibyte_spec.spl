# Regression: str_split(s, "") on multibyte text (bug mixed_byte_and_codepoint_indexing_defect_class_2026-08-18)
use std.common.string_core.{str_split}

describe "str_split empty separator":
    it "splits ASCII into single characters":
        val parts = str_split("abc", "")
        expect(parts.len()).to_equal(3)
        expect(parts[2]).to_equal("c")

    it "splits multibyte text per code point":
        val parts = str_split("aé€b", "")
        expect(parts.len()).to_equal(4)
        expect(parts[1]).to_equal("é")
        expect(parts[2]).to_equal("€")
        expect(parts[3]).to_equal("b")
