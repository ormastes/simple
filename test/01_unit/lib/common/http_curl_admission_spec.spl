# @cover src/lib/common/http_curl.spl
use std.spec.*
use std.spec.step
use std.common.http_curl.{curl_request_text}

describe "Bounded curl transport admission":
    it "should refuse non-HTTP URLs before starting a process":
        step("Submit an unsupported local-file protocol")
        val result = curl_request_text("POST", "file:///not-http", [], "ignored")
        expect(result.0).to_equal(0)
        expect(result.1).to_equal("")
        expect(result.2).to_contain("http or https")

    it "should refuse headers that introduce an extra line":
        step("Submit a header containing a CRLF delimiter")
        val result = curl_request_text("POST", "http://127.0.0.1:1", ["X-Value: safe\r\nInjected: yes"], "ignored")
        expect(result.0).to_equal(0)
        expect(result.2).to_contain("control delimiter")

    it "should refuse URL userinfo so credentials never enter argv":
        step("Submit an HTTP URL with a userinfo component")
        val result = curl_request_text("POST", "https://user:fixture@127.0.0.1/", [], "ignored")
        expect(result.0).to_equal(0)
        expect(result.2).to_contain("userinfo")
