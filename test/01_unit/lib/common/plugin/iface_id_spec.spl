# @req KPM-REQ-002 KPM-REQ-009
use std.spec.*
use common.plugin.iface_id.{IfaceId, ParamHeader, ParamExt}

describe "versioned plugin identity values":
    it "preserves interface identity fields by value":
        val id = IfaceId(name: "simple.codegen.BackendPort", major: 1,
            minor: 2, abi_digest: "sha256:abc")
        expect id.name == "simple.codegen.BackendPort"
        expect id.major == 1
        expect id.minor == 2
        expect id.abi_digest == "sha256:abc"

    it "preserves parameter schema version and presence bits by value":
        val hdr = ParamHeader(schema_name: "simple.codegen.CodegenParams",
            schema_major: 1, schema_minor: 3, present: 5)
        expect hdr.schema_name == "simple.codegen.CodegenParams"
        expect hdr.schema_major == 1
        expect hdr.schema_minor == 3
        expect hdr.present == 5

    it "preserves typed extension identity and canonical payload by value":
        val payload: [u8] = [0x01u8, 0x02u8]
        val ext = ParamExt(ext_name: "simple.codegen.ext.cuda_sm", ext_major: 1,
            payload: payload, payload_schema_hash: "sha256:def")
        expect ext.ext_name == "simple.codegen.ext.cuda_sm"
        expect ext.ext_major == 1
        expect ext.payload.len() == 2
        expect ext.payload[0] == 0x01u8
        expect ext.payload_schema_hash == "sha256:def"

    it "copy-on-write payload mutation does not change the source value":
        val payload: [u8] = [0x01u8, 0x02u8]
        val original = ParamExt(ext_name: "simple.codegen.ext.cuda_sm", ext_major: 1,
            payload: payload, payload_schema_hash: "sha256:def")
        var copied = original
        copied.payload[0] = 0x09u8
        expect original.payload[0] == 0x01u8
        expect copied.payload[0] == 0x09u8
