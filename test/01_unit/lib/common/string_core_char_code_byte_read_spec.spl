use common.string_core.{char_code_inline, char_code, char_from_code}

# Regression pin for the 2026-08-28 loader perf fix: char_code_inline reads
# the first byte in place (byte_at(0)) instead of allocating a [u8] array per
# call. The observable contract must not move: empty -> 0, ASCII -> its code,
# non-ASCII lead byte -> 0, and only the FIRST byte is consulted.
describe "string core char_code_inline byte read":
    it "returns the ASCII code of the first character":
        expect(char_code_inline("a")).to_equal(97)
        expect(char_code_inline("Z")).to_equal(90)
        expect(char_code_inline("0")).to_equal(48)
        expect(char_code_inline(" ")).to_equal(32)
        expect(char_code_inline("\n")).to_equal(10)
        expect(char_code_inline("_")).to_equal(95)

    it "only consults the first byte of longer text":
        expect(char_code_inline("abc")).to_equal(97)
        expect(char_code_inline("fn main")).to_equal(102)

    it "returns 0 for empty text and non-ASCII lead bytes":
        expect(char_code_inline("")).to_equal(0)
        expect(char_code_inline("é")).to_equal(0)
        expect(char_code_inline("→x")).to_equal(0)

    it "round-trips through char_from_code for printable ASCII":
        var code = 32
        while code <= 126:
            expect(char_code(char_from_code(code))).to_equal(code)
            code = code + 1
