# Feature: Context Sharing with context_def
# Category: BDD Framework
# Status: Complete

## Operator workflow
Run `bin/simple test test/unit/lib/common/context_sharing_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

describe "Standard library comprehensive behavior":
    it "text primitives agree on a fixed fixture":
        step("Verify: text primitives agree on a fixed fixture")
        # @req: REQ-LIB-LIB_GENERIC-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.replace("Language", "Runtime")).to_equal("Simple Runtime")  # oracle: substitution applies

    it "collections keep insertion order and value semantics":
        step("Verify: collections keep insertion order and value semantics")
        # @req: REQ-LIB-LIB_GENERIC-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows by one
        expect(original.len()).to_equal(2)  # oracle: the original binding is unmodified

    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits

describe "Context Sharing (context_def)":
    # Tests reusable context definitions (context_def) for BDD fixtures.
    # Verifies that contexts can be defined once and reused across multiple tests.

    describe "basic context_def usage":
        # Tests basic usage of context_def with simple fixture values.
        context :with_counter:
            it "provides counter value":
                expect get_let(:counter) == 0
            
            it "provides increment value":
                expect get_let(:increment) == 1

    describe "list context":
        # Tests context_def with list fixtures and accessing list elements.
        context :with_list:
            it "provides items":
                val items = get_let(:items)
                expect len(items) == 3
            
            it "provides empty list":
                val empty = get_let(:empty_list)
                expect len(empty) == 0
            
            it "items are accessible":
                val items = get_let(:items)
                expect items[0] == 1

    describe "string context":
        # Tests context_def with string fixtures.
        context :with_strings:
            it "provides greeting":
                expect get_let(:greeting) == "hello"
            
            it "provides name":
                expect get_let(:name) == "world"

    describe "boolean context":
        # Tests context_def with boolean fixtures.
        context :with_booleans:
            it "provides true flag":
                expect get_let(:flag_true) == true
            
            it "provides false flag":
                expect get_let(:flag_false) == false

    describe "reusing contexts":
        # Tests that context_def can be reused multiple times without duplication.
        context :with_counter:
            it "works first time":
                expect get_let(:counter) == 0
        
        context :with_counter:
            it "works second time":
                expect get_let(:counter) == 0

    describe "nested contexts with context_def":
        # Tests nesting of context_def with inline context blocks and fixture inheritance.
        context :with_list:
            it "outer has items":
                val items = get_let(:items)
                expect len(items) == 3
            
            context "inner context":
                given_lazy :extra, \: 99
                
                it "inner has extra":
                    expect get_let(:extra) == 99
                
                it "inner still has outer items":
                    val items = get_let(:items)
                    expect len(items) == 3

main = 0
