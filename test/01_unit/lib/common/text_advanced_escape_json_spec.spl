use std.text_advanced.{escape_json}

describe "text_advanced escape_json":
    """Regression guard for a duplicated JSON-escaping implementation.

    `text_advanced.escape_json` used to reimplement JSON string escaping via a
    chain of `.replace()` calls that only handled backslash, quote, newline,
    carriage return, and tab -- missing other C0 control characters. It now
    delegates to the shared `common.text.escape_json` implementation, which
    escapes the full control-character family.
    """

    it "escapes backslash, quote, and whitespace controls":
        expect(escape_json("a\\b\"c\nd\te")).to_equal("a\\\\b\\\"c\\nd\\te")

    it "escapes other C0 control characters via \\u00XX":
        expect(escape_json("az")).to_equal("a\\u0001z")
