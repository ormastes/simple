# DESIRED behaviour: an SDN block sequence of mappings parses into an Array.
#
# EXPECTED-RED UNTIL PATCHED. Every example in this file fails today; they turn
# GREEN only once the patch in
# doc/08_tracking/bug/sdn_parser_drops_block_sequence_of_mappings_2026-08-09.md
# is applied to src/lib/common/sdn/parser.spl. No build is needed to re-run it —
# the stdlib is read as source on every run.
#
# The characterisation of today's defective behaviour lives in the sibling
# sdn_block_sequence_probe_spec.spl (GREEN today, delete when this goes GREEN).

use std.spec.{describe, it, expect, step}
use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}

# Exactly the shape of src/app/simple.sdn.
val THREE = "project:\n  dependencies:\n    - project: ../compiler\n    - project: ../lib\n    - project: ../../rust\n"
val ONE = "project:\n  dependencies:\n    - project: ../lib\n"
val AFTER = "project:\n  dependencies:\n    - project: ../lib\n  root: .\n"

describe "SDN block sequence of mappings parses into an Array":

    it "yields an Array of 3 under project.dependencies":
        step("parse the src/app/simple.sdn shape and count the items")
        match parse(THREE):
            case Ok(v):
                val deps = (v.get_path("project.dependencies") ?? SdnValue.Null).as_array() ?? []
                expect(deps.len()).to_equal(3)
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")

    it "preserves EVERY declared dependency path in order":
        step("read all three project values by index — no entry may be dropped")
        match parse(THREE):
            case Ok(v):
                val a = (v.get_path("project.dependencies.0.project") ?? SdnValue.Null).as_str() ?? "<none>"
                val b = (v.get_path("project.dependencies.1.project") ?? SdnValue.Null).as_str() ?? "<none>"
                val c = (v.get_path("project.dependencies.2.project") ?? SdnValue.Null).as_str() ?? "<none>"
                expect(a + "|" + b + "|" + c).to_equal("../compiler|../lib|../../rust")
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")

    it "never creates a literal '- project' key":
        step("the dash is sequence syntax, not part of the key text")
        match parse(THREE):
            case Ok(v):
                expect(v.get_path("project.dependencies.- project") == None).to_equal(true)
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")

    it "still works for a single-item sequence":
        step("one item must be an Array of 1, not a bare mapping")
        match parse(ONE):
            case Ok(v):
                val deps = (v.get_path("project.dependencies") ?? SdnValue.Null).as_array() ?? []
                expect(deps.len()).to_equal(1)
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")

    it "single-item sequence exposes its mapping value":
        step("index 0 of a one-item sequence carries the mapping")
        match parse(ONE):
            case Ok(v):
                expect((v.get_path("project.dependencies.0.project") ?? SdnValue.Null).as_str() ?? "<none>").to_equal("../lib")
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")

    it "returns to the parent mapping after the sequence ends":
        step("a sibling key at the parent indent after the sequence still parses")
        match parse(AFTER):
            case Ok(v):
                expect((v.get_path("project.root") ?? SdnValue.Null).as_str() ?? "<none>").to_equal(".")
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")

    it "leaves ordinary nested mappings unchanged":
        step("regression guard: no dash means no sequence")
        match parse("project:\n  name: simple-app\n  version: 1.0.0-RC\n"):
            case Ok(v):
                expect((v.get_path("project.name") ?? SdnValue.Null).as_str() ?? "<none>").to_equal("simple-app")
            case Err(e):
                expect("parse failed: " + e).to_equal("Ok")
