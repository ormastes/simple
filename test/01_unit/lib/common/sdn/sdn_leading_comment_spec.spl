# A document whose first lines are `#` comments carries the value that follows
# them. Only the block-mapping route used to skip leading comment lines; an
# inline dict/array/table/scalar after a comment header parsed as one bare
# String, which made every commented registered trace declaration
# (doc/08_tracking/trace/features/*.sdn) undecodable through `simple trace`.
use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}

fn shape(source: text) -> text:
    match parse(source):
        case Err(e): "parse-error: " + e
        case Ok(value):
            match value:
                case SdnValue.Dict(fields): "dict:" + fields.len().to_text()
                case SdnValue.Array(items): "array:" + items.len().to_text()
                case SdnValue.String(_): "string"
                case SdnValue.Null: "null"
                case SdnValue.Int(_): "int"
                case _: "other"

describe "SDN leading comment lines":
    it "parses an inline dict after a comment header as a dict":
        expect(shape("# authored intent\n# second line\n\{a: 1, b: 2\}\n")).to_equal("dict:2")

    it "parses an inline array after a comment header as an array":
        expect(shape("# header\n[1, 2, 3]\n")).to_equal("array:3")

    it "parses a scalar after a comment header as that scalar":
        expect(shape("# header\n42\n")).to_equal("int")

    it "parses a block mapping after a comment header unchanged":
        expect(shape("# header\nkey: value\nother: 2\n")).to_equal("dict:2")

    it "treats a comment-only document as null":
        expect(shape("# only a comment\n# and another\n")).to_equal("null")

    it "keeps an uncommented inline dict as a dict":
        expect(shape("\{a: 1\}")).to_equal("dict:1")
