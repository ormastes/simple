use std.spec.*
use std.common.sdn.value.{SdnValue, sdn_value_to_text}

describe "SDN typed empty container constructor workaround for #2982":
    it "preserves distinct empty array and dictionary values":
        val array = SdnValue.empty_array()
        val dict = SdnValue.empty_dict()
        expect(array.is_array()).to_equal(true)
        expect(array.is_dict()).to_equal(false)
        expect(dict.is_array()).to_equal(false)
        expect(dict.is_dict()).to_equal(true)
        expect(array.len()).to_equal(0)
        expect(dict.len()).to_equal(0)
        expect(sdn_value_to_text(array)).to_equal("[]")
        expect(sdn_value_to_text(dict)).to_equal("{...}")

    it "preserves empty container payloads when nested in another SDN value":
        val items: [SdnValue] = [SdnValue.empty_array(), SdnValue.empty_dict()]
        expect(sdn_value_to_text(SdnValue.array(items))).to_equal("[[], {...}]")
