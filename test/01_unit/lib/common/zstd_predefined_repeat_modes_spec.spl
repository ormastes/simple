val REPEAT_PLAINTEXT_PREFIX: [u8] = [
    0x23u8, 0x20u8, 0x43u8, 0x6Fu8, 0x6Du8, 0x6Du8, 0x6Fu8, 0x6Eu8, 0x20u8, 0x63u8, 0x6Fu8, 0x6Du8, 0x70u8, 0x72u8, 0x65u8, 0x73u8,
    0x73u8, 0x69u8, 0x6Fu8, 0x6Eu8, 0x20u8, 0x66u8, 0x61u8, 0x63u8, 0x61u8, 0x64u8, 0x65u8, 0x2Eu8, 0x0Au8, 0x0Au8, 0x65u8, 0x78u8,
    0x70u8, 0x6Fu8, 0x72u8, 0x74u8, 0x20u8, 0x75u8, 0x73u8, 0x65u8
]

fn _zstd_frame(expected_size: i64, block: [u8]) -> [u8]:
    [
        0x28u8, 0xB5u8, 0x2Fu8, 0xFDu8,
        0xA0u8,
        (expected_size & 0xFF).to_u8(),
        ((expected_size >> 8) & 0xFF).to_u8(),
        ((expected_size >> 16) & 0xFF).to_u8(),
        ((expected_size >> 24) & 0xFF).to_u8(),
        block[0], block[1], block[2]
    ] + block.slice(3, block.len())

fn _compressed_block(payload: [u8]) -> [u8]:
    val header = 1 | (2 << 1) | (payload.len() << 3)
    [
        (header & 0xFF).to_u8(),
        ((header >> 8) & 0xFF).to_u8(),
        ((header >> 16) & 0xFF).to_u8()
    ] + payload

describe "zstd predefined and repeat sequence table modes":
    # @manual scenario evidence
    it "decodes a real all-predefined-mode frame to the exact plaintext":
        # @req REQ-SSPEC-UNIT
        step("decodes a real all-predefined-mode frame to the exact plaintext")
        val decoded = zstd_decompress_frame(ALL_PREDEFINED_FRAME)
        expect(decoded.is_ok()).to_equal(true)
        expect(decoded.unwrap()).to_equal(ALL_PREDEFINED_PLAINTEXT)

    it "decodes a real multi-block frame whose later blocks use repeat mode":
        # @req REQ-SSPEC-UNIT
        step("decodes a real multi-block frame whose later blocks use repeat mode")
        val decoded = zstd_decompress_frame(REPEAT_FRAME)
        expect(decoded.is_ok()).to_equal(true)
        val out = decoded.unwrap()
        expect(out.len()).to_equal(8000)
        expect(out.slice(0, 40)).to_equal(REPEAT_PLAINTEXT_PREFIX)

    it "rejects repeat mode on the first compressed block as corruption":
        # @req REQ-SSPEC-UNIT
        step("rejects repeat mode on the first compressed block as corruption")
        val literals = [0x18u8, 0x61u8, 0x62u8, 0x63u8]
        val frame = _zstd_frame(3, _compressed_block(literals + [0x01u8, 0xC0u8]))
        val decoded = decompress_bytes(frame, Some(CompressionCodec.zstd))
        expect(decoded.is_err()).to_equal(true)
        match decoded.unwrap_err():
            CompressionError.CorruptStream(message):
                expect(message).to_contain("repeat mode without a previous")
            _:
                expect("CorruptStream").to_equal("other error kind")
