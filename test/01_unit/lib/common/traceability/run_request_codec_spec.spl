# @tag:in-development
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
use std.spec.*
use std.common.traceability.run_plan.{TracePlannedCase}
use std.common.traceability.run_request.{TraceRunRequest, validate_trace_run_request, materialize_trace_run_plan}
use std.common.traceability.run_request_codec.{encode_trace_run_request, decode_trace_run_request}

fn _request_case(id: text, path: text, name: text) -> TracePlannedCase:
    TracePlannedCase(case_id: id, test_path: path, case_name: name, test_definition_id: "definition-1", lane_id: "lane-unit")

fn _request(cases: [TracePlannedCase]) -> TraceRunRequest:
    TraceRunRequest(subject_id: "subject-α", configuration_id: "config-1", expectation_id: "expectation-1", binary_id: "binary-1", cases: cases)

describe "pre-dispatch trace run request":
    it "round trips Unicode cases while preserving planned order":
        val request = _request([
            _request_case("case-α", "test/日本_spec.spl", "says \"hello\""),
            _request_case("case-2", "test/other_spec.spl", "second")
        ])
        match encode_trace_run_request(request):
            case Err(reason): fail("valid request failed encoding: {reason}")
            case Ok(source):
                match decode_trace_run_request(source):
                    case Err(reason): fail("encoded request failed decoding: {reason}")
                    case Ok(decoded):
                        expect(decoded.subject_id).to_equal("subject-α")
                        expect(decoded.cases.len()).to_equal(2)
                        expect(decoded.cases[0].case_id).to_equal("case-α")
                        expect(decoded.cases[0].test_path).to_equal("test/日本_spec.spl")
                        expect(decoded.cases[0].case_name).to_equal("says \"hello\"")
                        expect(decoded.cases[1].case_id).to_equal("case-2")

    it "rejects caller-supplied run IDs, duplicate or unknown fields, and wrong schema":
        val supplied_run_id = "{schema: \"simple.trace.run-request/v1\", run_id: \"premature\", subject_id: \"s\", configuration_id: \"c\", expectation_id: \"e\", binary_id: \"b\", cases: [{case_id: \"i\", test_path: \"t\", case_name: \"n\", test_definition_id: \"d\", lane_id: \"l\"}]}"
        match decode_trace_run_request(supplied_run_id):
            case Ok(_): fail("caller-supplied run ID was accepted")
            case Err(reason): expect(reason).to_contain("unexpected")
        val duplicate = "{schema: \"simple.trace.run-request/v1\", subject_id: \"s\", subject_id: \"other\", configuration_id: \"c\", expectation_id: \"e\", binary_id: \"b\", cases: []}"
        match decode_trace_run_request(duplicate):
            case Ok(_): fail("duplicate field was accepted")
            case Err(reason): expect(reason).to_contain("duplicate")
        val wrong_schema = "{schema: \"simple.trace.run-request/v2\", subject_id: \"s\", configuration_id: \"c\", expectation_id: \"e\", binary_id: \"b\", cases: []}"
        match decode_trace_run_request(wrong_schema):
            case Ok(_): fail("unsupported request schema was accepted")
            case Err(reason): expect(reason).to_contain("unsupported")

    it "rejects invalid request identities, empty inventories, and duplicate cases":
        match validate_trace_run_request(_request([])):
            case Ok(_): fail("empty request inventory was accepted")
            case Err(reason): expect(reason).to_contain("at least one")
        val duplicate = _request([_request_case("same", "test/a.spl", "first"), _request_case("same", "test/b.spl", "second")])
        match encode_trace_run_request(duplicate):
            case Ok(_): fail("duplicate case IDs were encoded")
            case Err(reason): expect(reason).to_contain("duplicate planned case id")
        val empty_identity = TraceRunRequest(subject_id: "", configuration_id: "c", expectation_id: "e", binary_id: "b", cases: [_request_case("id", "test/a.spl", "case")])
        match validate_trace_run_request(empty_identity):
            case Ok(_): fail("incomplete request identity was accepted")
            case Err(reason): expect(reason).to_contain("identity is incomplete")

    it "materializes with only the allocated run ID and rejects an empty allocation":
        val request = _request([_request_case("case-1", "test/a.spl", "first"), _request_case("case-2", "test/b.spl", "second")])
        match materialize_trace_run_plan(request, ""):
            case Ok(_): fail("empty allocated run ID was accepted")
            case Err(reason): expect(reason).to_contain("allocated trace run identity is empty")
        match materialize_trace_run_plan(request, "allocated-run-7"):
            case Err(reason): fail("valid request failed materialization: {reason}")
            case Ok(plan):
                expect(plan.run_id).to_equal("allocated-run-7")
                expect(plan.subject_id).to_equal(request.subject_id)
                expect(plan.cases.len()).to_equal(2)
                expect(plan.cases[0].case_id).to_equal("case-1")
                expect(plan.cases[1].case_id).to_equal("case-2")
