# @tag:in-development
# @req REQ-TRC-003 REQ-TRC-013 REQ-TRC-018
use std.spec
use std.common.traceability.case_events.{TraceCaseEvent}
use std.database.test_extended.database.{TestDatabaseExtended}

describe "Runner-owned framework observation storage":
    it "keeps actual failure observations and rejects a replayed file scope":
        var db = TestDatabaseExtended.create("target/trace-store-unit-no-save")
        val run_id = db.start_run()
        val events = [TraceCaseEvent("criterion case", "started", "not_finished"),
                      TraceCaseEvent("criterion case", "finished", "failed")]
        expect(db.record_trace_case_events(run_id, "test/criterion_spec.spl", events).is_ok()).to_equal(true)
        match db.get_trace_case_events(run_id, "test/criterion_spec.spl"):
            case Ok(stored):
                expect(stored.len()).to_equal(2)
                expect(stored[0].outcome).to_equal("not_finished")
                expect(stored[1].outcome).to_equal("failed")
            case Err(reason): fail(reason)
        expect(db.record_trace_case_events(run_id, "test/criterion_spec.spl", events).is_err()).to_equal(true)

    it "does not append earlier events from a rejected batch":
        var db = TestDatabaseExtended.create("target/trace-store-unit-no-save")
        val run_id = db.start_run()
        val events = [TraceCaseEvent("first", "started", "not_finished"),
                      TraceCaseEvent("second", "finished", "fabricated_pass")]
        expect(db.record_trace_case_events(run_id, "test/rejected_spec.spl", events).is_err()).to_equal(true)
        match db.get_trace_case_events(run_id, "test/rejected_spec.spl"):
            case Ok(stored): expect(stored.len()).to_equal(0)
            case Err(reason): fail(reason)

    it "keeps one shared suite's observations distinct across file scopes":
        var db = TestDatabaseExtended.create("target/trace-store-unit-no-save")
        val run_id = db.start_run()
        val events = [TraceCaseEvent("shared case", "started", "not_finished")]
        expect(db.record_trace_case_events(run_id, "test/first_spec.spl", events).is_ok()).to_equal(true)
        expect(db.record_trace_case_events(run_id, "test/second_spec.spl", events).is_ok()).to_equal(true)
        match db.get_trace_case_events(run_id, "test/first_spec.spl"):
            case Ok(stored): expect(stored.len()).to_equal(1)
            case Err(reason): fail(reason)
