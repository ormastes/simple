# @tag:in-development
# REQ-TRC-020 / AC-TRC-032, AC-TRC-040: projection unit coverage only.
# Native browser/security/publication acceptance remains separate and NOT RUN.
use std.spec.{describe, it, expect, step, fail}
use std.common.traceability.model.*
use std.common.traceability.html.{project_trace_html, trace_html_escape}

fn html_graph() -> TraceGraph:
    TraceGraph(subject: SnapshotSubject(repository_id: "simple", snapshot_id: "snapshot:html",
        kind: "git_tree", revision_id: "revision:html", tree_id: "tree:html", object_format: "sha256"),
        input_manifest_id: "inputs:html", generation_id: "generation:html", complete: true,
        nodes: [TraceNode(id: "feature:public", kind: TraceNodeKind.Feature, title: "<script>alert('x')</script>"),
            TraceNode(id: "feature:private", kind: TraceNodeKind.Feature, title: "Confidential design")],
        test_definitions: [], claims: [], edges: [], edge_origins: [], origins: [], locators: [], diagnostics: [])

fn html_render(graph: TraceGraph, selected: [text]) -> text:
    match project_trace_html(graph, selected):
        case Ok(output): output.content
        case Err(reason):
            fail(reason)
            ""

describe "Offline structural HTML projection":
    it "escapes repository text instead of creating active markup":
        step("Render a node with executable-looking title through the production projection")
        val html = html_render(html_graph(), ["feature:public"])
        expect(html.contains("<script>")).to_equal(false)
        expect(html).to_contain("&lt;script&gt;alert(&#39;x&#39;)&lt;/script&gt;")
        expect(html).to_contain("default-src 'none'")
        expect(trace_html_escape("\"&<>" )).to_equal("&quot;&amp;&lt;&gt;")

    it "omits unselected entity content while disclosing the publication limit":
        step("Publish only the admitted public entity")
        val html = html_render(html_graph(), ["feature:public"])
        expect(html.contains("Confidential design")).to_equal(false)
        expect(html.contains("feature:private")).to_equal(false)
        expect(html).to_contain("Visible nodes: 1 of 2")
        expect(html).to_contain("Execution qualification: not included")

    it "keeps output deterministic when inventory and selection order change":
        step("Render equivalent inventories in different input orders")
        val first = html_render(html_graph(), ["feature:public", "feature:private"])
        var graph = html_graph()
        graph.nodes = [graph.nodes[1], graph.nodes[0]]
        val second = html_render(graph, ["feature:private", "feature:public"])
        expect(first).to_equal(second)
        expect(second).to_contain("Snapshot: snapshot:html")

    it "refuses unknown publication selections":
        step("Request an entity absent from the graph")
        match project_trace_html(html_graph(), ["feature:absent"]):
            case Ok(_): fail("unknown publication entity was accepted")
            case Err(reason): expect(reason).to_equal("invalid or duplicate publication selection")
