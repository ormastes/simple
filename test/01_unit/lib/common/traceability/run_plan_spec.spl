# @tag:in-development
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013
use std.spec.*
use std.common.traceability.case_events.{TraceCaseEvent}
use std.common.traceability.run_plan.{TracePlannedCase, TraceRunPlan, TraceCaseEventFile, validate_trace_run_plan, reconcile_trace_case_events}

fn _case(case_id: text, path: text, name: text) -> TracePlannedCase:
    TracePlannedCase(case_id: case_id, test_path: path, case_name: name, test_definition_id: "definition-1", lane_id: "lane-unit")

fn _plan(cases: [TracePlannedCase]) -> TraceRunPlan:
    TraceRunPlan(run_id: "run-1", subject_id: "subject-1", configuration_id: "config-1", expectation_id: "expectation-1", binary_id: "binary-1", cases: cases)

fn _started(name: text) -> TraceCaseEvent:
    TraceCaseEvent(case_name: name, phase: "started", outcome: "not_finished")

fn _finished(name: text, outcome: text) -> TraceCaseEvent:
    TraceCaseEvent(case_name: name, phase: "finished", outcome: outcome)

describe "frozen trace run plan":
    it "rejects an empty feature plan instead of claiming complete execution":
        match validate_trace_run_plan(_plan([])):
            case Ok(_): fail("empty feature plan accepted")
            case Err(reason): expect(reason).to_contain("at least one planned case")

    it "keeps a planned case missing when the actual event set is empty":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        match reconcile_trace_case_events(plan, []):
            case Err(reason): fail("empty observations rejected: {reason}")
            case Ok(completion):
                expect(completion.complete).to_equal(false)
                expect(completion.attempts.len()).to_equal(1)
                expect(completion.attempts[0].started).to_equal(false)
                expect(completion.attempts[0].finished).to_equal(false)
                expect(completion.missing_case_ids[0]).to_equal("case-1")

    it "retains a valid started-only prefix as an incomplete attempt":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        val actual = [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case")])]
        match reconcile_trace_case_events(plan, actual):
            case Err(reason): fail("interrupted prefix rejected: {reason}")
            case Ok(completion):
                expect(completion.complete).to_equal(false)
                expect(completion.attempts[0].started).to_equal(true)
                expect(completion.attempts[0].finished).to_equal(false)
                expect(completion.missing_case_ids.len()).to_equal(1)

    it "marks a failed terminal observation complete without changing its outcome":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        val actual = [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case"), _finished("first case", "failed")])]
        match reconcile_trace_case_events(plan, actual):
            case Err(reason): fail("failed case rejected: {reason}")
            case Ok(completion):
                expect(completion.complete).to_equal(true)
                expect(completion.attempts[0].outcome).to_equal("failed")
                expect(completion.missing_case_ids.len()).to_equal(0)

    it "rejects unknown observed cases and duplicate planned identities":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        val unknown = [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("not planned")])]
        match reconcile_trace_case_events(plan, unknown):
            case Ok(_): fail("unknown event identity was accepted")
            case Err(reason): expect(reason).to_contain("unknown trace case")
        val duplicate_id = _plan([_case("same-id", "test/a_spec.spl", "first"), _case("same-id", "test/b_spec.spl", "second")])
        match validate_trace_run_plan(duplicate_id):
            case Ok(_): fail("duplicate case id was accepted")
            case Err(reason): expect(reason).to_contain("duplicate planned case id")
        val duplicate_scope = _plan([_case("case-1", "test/a_spec.spl", "same"), _case("case-2", "test/a_spec.spl", "same")])
        match validate_trace_run_plan(duplicate_scope):
            case Ok(_): fail("duplicate path/name identity was accepted")
            case Err(reason): expect(reason).to_contain("duplicate planned path")

    it "allows the same case name in separate planned files":
        val plan = _plan([_case("case-a", "test/a_spec.spl", "shared name"), _case("case-b", "test/b_spec.spl", "shared name")])
        val actual = [
            TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("shared name"), _finished("shared name", "passed")]),
            TraceCaseEventFile(test_path: "test/b_spec.spl", events: [_started("shared name"), _finished("shared name", "passed")])
        ]
        match reconcile_trace_case_events(plan, actual):
            case Err(reason): fail("file-scoped identities collided: {reason}")
            case Ok(completion):
                expect(completion.complete).to_equal(true)
                expect(completion.attempts.len()).to_equal(2)
                expect(completion.attempts[0].case_id).to_equal("case-a")
                expect(completion.attempts[1].case_id).to_equal("case-b")

    it "rejects duplicate starts and terminals without inferring a pass":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        val duplicate_start = [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case"), _started("first case")])]
        match reconcile_trace_case_events(plan, duplicate_start):
            case Ok(_): fail("duplicate start was accepted")
            case Err(reason): expect(reason).to_contain("duplicate trace case start")
        # A second planned case leaves enough input budget to reach the
        # duplicate-terminal guard instead of the aggregate event limit.
        val wider = _plan([_case("case-1", "test/a_spec.spl", "first case"), _case("case-2", "test/a_spec.spl", "second case")])
        val duplicate_terminal = [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case"), _finished("first case", "passed"), _finished("first case", "failed")])]
        match reconcile_trace_case_events(wider, duplicate_terminal):
            case Ok(_): fail("duplicate terminal accepted")
            case Err(reason): expect(reason).to_contain("duplicate trace case terminal")
        val pending = [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case"), _finished("first case", "pending")])]
        match reconcile_trace_case_events(plan, pending):
            case Err(reason): fail("pending case rejected: {reason}")
            case Ok(completion):
                expect(completion.complete).to_equal(false)
                expect(completion.missing_case_ids[0]).to_equal("case-1")

    it "rejects unknown empty files and observations before a case starts":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        match reconcile_trace_case_events(plan, [TraceCaseEventFile(test_path: "test/unknown.spl", events: [])]):
            case Ok(_): fail("unknown empty file accepted")
            case Err(reason): expect(reason).to_contain("unknown trace event file")
        match reconcile_trace_case_events(plan, [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_finished("first case", "passed")])]):
            case Ok(_): fail("terminal without start accepted")
            case Err(reason): expect(reason).to_contain("without a start")

    it "rejects malformed phases, outcomes and excessive event input":
        val plan = _plan([_case("case-1", "test/a_spec.spl", "first case")])
        val bad_phase = TraceCaseEvent(case_name: "first case", phase: "invented", outcome: "passed")
        match reconcile_trace_case_events(plan, [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [bad_phase])]):
            case Ok(_): fail("unknown phase accepted")
            case Err(reason): expect(reason).to_contain("unknown trace case event phase")
        match reconcile_trace_case_events(plan, [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case"), _finished("first case", "invented_pass")])]):
            case Ok(_): fail("invented outcome accepted")
            case Err(reason): expect(reason).to_contain("invalid outcome")
        match reconcile_trace_case_events(plan, [TraceCaseEventFile(test_path: "test/a_spec.spl", events: [_started("first case"), _finished("first case", "passed"), _finished("first case", "passed")])]):
            case Ok(_): fail("excessive event batch accepted")
            case Err(reason): expect(reason).to_contain("frozen plan budget")
