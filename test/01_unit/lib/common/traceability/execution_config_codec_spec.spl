# @tag:in-development
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
use std.spec.*
use std.common.traceability.execution_config.{TraceExecutionConfiguration, validate_trace_execution_configuration}
use std.common.traceability.execution_config_codec.{encode_trace_execution_configuration, decode_trace_execution_configuration, trace_execution_configuration_id}

fn _execution_config() -> TraceExecutionConfiguration:
    TraceExecutionConfiguration(
        execution_mode: "interpreter", backend: "default", lane_id: "lane-α",
        timeout_secs: 120, timeout_binding: "fixed", slow_policy: "include_slow",
        seed: 37, seed_set: true, fail_fast: false, cache_policy: "disabled",
        parallel: false, worker_count: 1, shard_id: "shard-1", shard_index: 0,
        shard_count: 1, shard_membership: ["test/日本_spec.spl", "test/other_spec.spl"],
        unresolved_fields: [], unsupported_fields: [])

describe "frozen trace execution configuration codec":
    it "round trips the explicit execution settings and shard paths in order":
        val config = _execution_config()
        match encode_trace_execution_configuration(config):
            case Err(reason): fail("valid execution config failed encoding: {reason}")
            case Ok(source):
                expect(source).to_contain("simple.trace.execution-config/v1")
                expect(source).to_contain("日本_spec.spl")
                match decode_trace_execution_configuration(source):
                    case Err(reason): fail("encoded execution config failed decoding: {reason}")
                    case Ok(decoded):
                        expect(decoded.execution_mode).to_equal("interpreter")
                        expect(decoded.backend).to_equal("default")
                        expect(decoded.lane_id).to_equal("lane-α")
                        expect(decoded.timeout_secs).to_equal(120)
                        expect(decoded.seed).to_equal(37)
                        expect(decoded.seed_set).to_equal(true)
                        expect(decoded.shard_membership.len()).to_equal(2)
                        expect(decoded.shard_membership[0]).to_equal("test/日本_spec.spl")
                        expect(decoded.shard_membership[1]).to_equal("test/other_spec.spl")
                        match encode_trace_execution_configuration(decoded):
                            case Err(reason): fail("decoded config failed canonical re-encoding: {reason}")
                            case Ok(canonical): expect(canonical).to_equal(source)

    it "retains unresolved and unsupported dimensions but refuses trace admission":
        var unresolved = _execution_config()
        unresolved.timeout_binding = "per_file_slow_and_header_adjustment"
        unresolved.unresolved_fields = ["effective_timeout"]
        unresolved.unsupported_fields = ["worker_environment"]
        match encode_trace_execution_configuration(unresolved):
            case Err(reason): fail("snapshot with unresolved values should remain serializable: {reason}")
            case Ok(source):
                match decode_trace_execution_configuration(source):
                    case Err(reason): fail("unresolved snapshot did not round trip: {reason}")
                    case Ok(decoded):
                        expect(decoded.unresolved_fields[0]).to_equal("effective_timeout")
                        expect(decoded.unsupported_fields[0]).to_equal("worker_environment")
                        match validate_trace_execution_configuration(decoded):
                            case Ok(_): fail("unresolved execution config was admitted")
                            case Err(reason): expect(reason).to_contain("unresolved")

    it "rejects unknown modes and incomplete shard membership":
        var unknown_mode = _execution_config()
        unknown_mode.execution_mode = "surprise"
        match validate_trace_execution_configuration(unknown_mode):
            case Ok(_): fail("unknown execution mode was admitted")
            case Err(reason): expect(reason).to_contain("unsupported trace execution mode")
        var no_members = _execution_config()
        no_members.shard_membership = []
        match validate_trace_execution_configuration(no_members):
            case Ok(_): fail("empty shard membership was admitted")
            case Err(reason): expect(reason).to_contain("shard membership")

    it "does not treat a configured result cache as trace-admissible evidence":
        var cached = _execution_config()
        cached.cache_policy = "enabled"
        match encode_trace_execution_configuration(cached):
            case Err(reason): fail("descriptive cache config should remain serializable: {reason}")
            case Ok(source):
                match decode_trace_execution_configuration(source):
                    case Err(reason): fail("cache config snapshot failed to decode: {reason}")
                    case Ok(decoded):
                        match validate_trace_execution_configuration(decoded):
                            case Ok(_): fail("cache without current-run evidence was admitted")
                            case Err(reason): expect(reason).to_contain("cache policy")

    it "rejects wrong schema, unknown or duplicate fields, and wrong field types":
        match encode_trace_execution_configuration(_execution_config()):
            case Err(reason): fail("valid config encoding failed: {reason}")
            case Ok(source):
                val wrong_schema = source.replace("simple.trace.execution-config/v1", "simple.trace.execution-config/v2")
                match decode_trace_execution_configuration(wrong_schema):
                    case Ok(_): fail("wrong schema was accepted")
                    case Err(reason): expect(reason).to_contain("unsupported")
        val duplicate = "{schema: \"simple.trace.execution-config/v1\", schema: \"other\"}"
        match decode_trace_execution_configuration(duplicate):
            case Ok(_): fail("duplicate field was accepted")
            case Err(reason): expect(reason).to_contain("duplicate")
        match encode_trace_execution_configuration(_execution_config()):
            case Err(reason): fail("valid config encoding failed: {reason}")
            case Ok(source):
                val wrong_type = source.replace("timeout_secs: 120", "timeout_secs: \"120\"")
                match decode_trace_execution_configuration(wrong_type):
                    case Ok(_): fail("wrong field type was accepted")
                    case Err(reason): expect(reason).to_contain("integer")
                match decode_trace_execution_configuration(source + " "):
                    case Ok(_): fail("noncanonical trailing data was accepted")
                    case Err(reason): expect(reason).to_contain("canonical")

    it "derives a stable namespaced digest from canonical SDN":
        val first = trace_execution_configuration_id(_execution_config())
        val second = trace_execution_configuration_id(_execution_config())
        match (first, second):
            case (Ok(a), Ok(b)):
                expect(a).to_equal(b)
                expect(a.starts_with("sha256:")).to_equal(true)
                expect(a.len()).to_equal(71)
            case (Err(reason), _): fail("valid config ID failed: {reason}")
            case (_, Err(reason)): fail("repeated config ID failed: {reason}")

    it "invalidates configuration identity when effective inputs or membership change":
        val baseline = _execution_config()
        val baseline_id = trace_execution_configuration_id(baseline).unwrap()
        match validate_trace_execution_configuration(baseline):
            case Err(reason): fail("supported fixture profile was rejected: {reason}")
            case Ok(_):
                for dimension in ["timeout", "backend", "seed", "fail_fast", "lane", "membership"]:
                    var changed = baseline
                    if dimension == "timeout": changed.timeout_secs = 121
                    elif dimension == "backend": changed.backend = "llvm"
                    elif dimension == "seed": changed.seed = 38
                    elif dimension == "fail_fast": changed.fail_fast = true
                    elif dimension == "lane": changed.lane_id = "lane-other"
                    else: changed.shard_membership = ["test/other_spec.spl", "test/日本_spec.spl"]
                    val changed_id = trace_execution_configuration_id(changed).unwrap()
                    expect(changed_id == baseline_id).to_equal(false)

    it "rejects duplicate unresolved dimensions and oversized aggregate membership":
        var duplicate = _execution_config()
        duplicate.unresolved_fields = ["effective_timeout", "effective_timeout"]
        match encode_trace_execution_configuration(duplicate):
            case Ok(_): fail("duplicate unresolved dimension was serialized")
            case Err(reason): expect(reason).to_contain("duplicate")
        var oversized = _execution_config()
        var paths: [text] = []
        for i in 0..257:
            paths.push("test/{i}/" + "x".repeat(4080))
        oversized.shard_membership = paths
        match encode_trace_execution_configuration(oversized):
            case Ok(_): fail("oversized aggregate membership was serialized")
            case Err(reason): expect(reason).to_contain("1 MiB")
