# @tag:in-development
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# Pure acknowledgement binding only; these fixtures do not authenticate a worker or admit evidence.
use std.spec.*
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.traceability.run_plan.{TracePlannedCase, TraceRunPlan}
use std.common.traceability.run_request.{TraceRunRequest, materialize_trace_run_plan}
use std.common.traceability.run_preparation.{TraceRunPreparation, build_trace_run_preparation, encode_trace_run_preparation}
use std.common.traceability.sspec_inventory.{TraceSspecCase, TraceSspecPlannedDefinition, TraceSspecPlannedRequest,
    trace_sspec_definition_id, trace_sspec_planned_case_id, trace_sspec_inventory_digest}
use std.common.traceability.sspec_preparation.{TraceSspecPreparation, build_trace_sspec_preparation,
    encode_trace_sspec_preparation, decode_trace_sspec_preparation, verify_trace_sspec_preparation}

fn _sspec_preparation_fixture(name: text) -> TraceSspecPlannedRequest:
    val source = "fixture source for " + name
    var bytes: [u8] = []
    for byte in source.bytes(): bytes.push(byte)
    val source_digest = "sha256:" + sha256_u8_hex(bytes)
    val item = TraceSspecCase(test_path: "test/fixtures/sspec_preparation_spec.spl",
        case_name: "suite > context > " + name, leaf_name: name, kind: "normal",
        suite_path: ["suite"], context_path: ["context"], start_byte: 40, end_byte: 88, line: 4, column: 9)
    val extractor = "simple.sspec.literal-ast/v1"
    val definition_id = trace_sspec_definition_id(source_digest, extractor, item)
    val case_id = trace_sspec_planned_case_id("subject:fixture", "config:fixture", "expectation:fixture",
        "binary:fixture", "lane:fixture", definition_id)
    val planned = TracePlannedCase(case_id: case_id, test_path: item.test_path, case_name: item.case_name,
        test_definition_id: definition_id, lane_id: "lane:fixture")
    val request = TraceRunRequest(subject_id: "subject:fixture", configuration_id: "config:fixture",
        expectation_id: "expectation:fixture", binary_id: "binary:fixture", cases: [planned])
    val definition = TraceSspecPlannedDefinition(case_id: case_id, test_definition_id: definition_id,
        source_sha256: source_digest, extractor_version: extractor, definition: item)
    val definitions = [definition]
    TraceSspecPlannedRequest(request: request, definitions: definitions,
        inventory_digest: trace_sspec_inventory_digest(request, definitions).unwrap(), evidence_validity: "unverified")

fn _sspec_preparation_plan(metadata: TraceSspecPlannedRequest, run_id: text) -> TraceRunPlan:
    materialize_trace_run_plan(metadata.request, run_id).unwrap()

fn _sspec_preparation_wire(preparation_source: text, inventory_digest: text, validity: text) -> text:
    var fields: Dict<text, SdnValue> = {}
    fields["schema"] = SdnValue.String("simple.trace.sspec-preparation/v1")
    fields["preparation_sdn"] = SdnValue.String(preparation_source)
    fields["inventory_digest"] = SdnValue.String(inventory_digest)
    fields["evidence_validity"] = SdnValue.String(validity)
    sdn_encode_canonical(SdnValue.Dict(fields))

describe "Unverified SSpec preparation acknowledgement":
    it "should round trip a canonical envelope and verify the allocated plan binding":
        val metadata = _sspec_preparation_fixture("round trip")
        val plan = _sspec_preparation_plan(metadata, "run:allocated")
        match build_trace_sspec_preparation(metadata, plan):
            case Err(reason): fail("valid metadata and plan failed to bind: {reason}")
            case Ok(value):
                expect(value.preparation.run_id).to_equal("run:allocated")
                expect(value.inventory_digest).to_equal(metadata.inventory_digest)
                expect(value.evidence_validity).to_equal("unverified")
                match encode_trace_sspec_preparation(value):
                    case Err(reason): fail("valid acknowledgement failed to encode: {reason}")
                    case Ok(source):
                        match decode_trace_sspec_preparation(source):
                            case Err(reason): fail("canonical acknowledgement failed to decode: {reason}")
                            case Ok(decoded):
                                match verify_trace_sspec_preparation(metadata, source, 0):
                                    case Err(reason): fail("valid worker acknowledgement failed verification: {reason}")
                                    case Ok(verified_plan):
                                        expect(decoded.preparation.run_id).to_equal(verified_plan.run_id)
                                        expect(verified_plan.cases[0].case_id).to_equal(metadata.request.cases[0].case_id)
                                        expect(decoded.evidence_validity).to_equal("unverified")

    it "should accept exactly one optional line ending after canonical stdout":
        val metadata = _sspec_preparation_fixture("日本 line ending")
        val plan = _sspec_preparation_plan(metadata, "run:日本-line-ending")
        val value = build_trace_sspec_preparation(metadata, plan).unwrap()
        val source = encode_trace_sspec_preparation(value).unwrap()
        expect(verify_trace_sspec_preparation(metadata, source + "\n", 0).is_ok()).to_equal(true)
        expect(verify_trace_sspec_preparation(metadata, source + "\r\n", 0).is_ok()).to_equal(true)
        expect(verify_trace_sspec_preparation(metadata, source + "\n\n", 0).is_err()).to_equal(true)
        expect(verify_trace_sspec_preparation(metadata, source + " ", 0).is_err()).to_equal(true)

    it "should reject a failed worker before parsing its output":
        val metadata = _sspec_preparation_fixture("worker exit")
        match verify_trace_sspec_preparation(metadata, "not SDN", 7):
            case Ok(_): fail("failed worker output was accepted")
            case Err(reason): expect(reason).to_contain("worker exited unsuccessfully")

    it "should reject an acknowledgement for a different full inventory digest":
        val metadata = _sspec_preparation_fixture("inventory binding")
        val plan = _sspec_preparation_plan(metadata, "run:inventory-binding")
        val value = build_trace_sspec_preparation(metadata, plan).unwrap()
        var wrong = value
        wrong.inventory_digest = "sha256:" + "0".repeat(64)
        val source = encode_trace_sspec_preparation(wrong).unwrap()
        match verify_trace_sspec_preparation(metadata, source, 0):
            case Ok(_): fail("different inventory digest was accepted")
            case Err(reason): expect(reason).to_contain("inventory digest mismatch")

    it "should reject unknown or duplicate envelope keys and noncanonical embedded acknowledgements":
        val digest = "sha256:" + "0".repeat(64)
        val unknown = "{schema: \"simple.trace.sspec-preparation/v1\", preparation_sdn: \"\", inventory_digest: \"{digest}\", evidence_validity: \"unverified\", selection_digest: \"invented\"}"
        match decode_trace_sspec_preparation(unknown):
            case Ok(_): fail("unknown envelope field was accepted")
            case Err(reason): expect(reason).to_contain("unexpected")
        val duplicate = "{schema: \"simple.trace.sspec-preparation/v1\", preparation_sdn: \"\", inventory_digest: \"{digest}\", inventory_digest: \"{digest}\", evidence_validity: \"unverified\"}"
        match decode_trace_sspec_preparation(duplicate):
            case Ok(_): fail("duplicate envelope field was accepted")
            case Err(reason): expect(reason).to_contain("duplicate")
        val inner = "{schema: \"simple.trace.run-preparation/v1\", run_id: \"run:fixture\", request_digest: \"{digest}\", plan_digest: \"{digest}\", evidence_validity: \"unverified\"}"
        val noncanonical = _sspec_preparation_wire(inner, digest, "unverified")
        match decode_trace_sspec_preparation(noncanonical):
            case Ok(_): fail("noncanonical embedded acknowledgement was accepted")
            case Err(reason): expect(reason).to_contain("embedded trace preparation must be canonical")

    it "should reject validity escalation and malformed inventory digests":
        val digest = "sha256:" + "0".repeat(64)
        val preparation = TraceRunPreparation(request_digest: digest, run_id: "run:fixture",
            plan_digest: digest, evidence_validity: "unverified")
        var forged = TraceSspecPreparation(preparation: preparation, inventory_digest: digest,
            evidence_validity: "verified")
        expect(encode_trace_sspec_preparation(forged).is_err()).to_equal(true)
        forged.evidence_validity = "unverified"
        forged.inventory_digest = "sha256:" + "G".repeat(64)
        expect(encode_trace_sspec_preparation(forged).is_err()).to_equal(true)
