# @tag:in-development
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# Pure binding fixtures; these do not prove owner persistence or admission.
use std.spec.*
use std.common.traceability.run_plan.{TracePlannedCase}
use std.common.traceability.run_request.{TraceRunRequest, materialize_trace_run_plan}
use std.common.traceability.run_preparation.{TraceRunPreparation, build_trace_run_preparation,
    encode_trace_run_preparation, decode_trace_run_preparation, validate_trace_run_preparation}

fn preparation_request(name: text) -> TraceRunRequest:
    TraceRunRequest(subject_id: "subject:fixture", configuration_id: "config:fixture",
        expectation_id: "expectation:fixture", binary_id: "binary:fixture",
        cases: [TracePlannedCase(case_id: "case:fixture", test_path: "test/日本_spec.spl",
            case_name: name, test_definition_id: "definition:fixture", lane_id: "lane:fixture")])

describe "Unverified pre-dispatch preparation acknowledgement":
    it "round trips the binding to the allocated run without granting evidence validity":
        val request = preparation_request("accepts a,b and \"quoted\" names")
        match materialize_trace_run_plan(request, "run:allocated"):
            case Err(reason): fail(reason)
            case Ok(plan):
                match build_trace_run_preparation(request, plan):
                    case Err(reason): fail(reason)
                    case Ok(value):
                        expect(value.run_id).to_equal("run:allocated")
                        expect(value.evidence_validity).to_equal("unverified")
                        expect(value.request_digest).to_start_with("sha256:")
                        expect(value.request_digest.len()).to_equal(71)
                        expect(value.request_digest == value.plan_digest).to_equal(false)
                        match encode_trace_run_preparation(value):
                            case Err(reason): fail(reason)
                            case Ok(source):
                                match decode_trace_run_preparation(source):
                                    case Err(reason): fail(reason)
                                    case Ok(decoded):
                                        expect(decoded.request_digest).to_equal(value.request_digest)
                                        expect(decoded.plan_digest).to_equal(value.plan_digest)
                                        match validate_trace_run_preparation(decoded, request, plan):
                                            case Err(reason): fail(reason)
                                            case Ok(_): expect(decoded.run_id).to_equal(plan.run_id)

    it "rejects a plan whose definition name differs despite unchanged identities":
        val request = preparation_request("original")
        match materialize_trace_run_plan(preparation_request("changed"), "run:allocated"):
            case Err(reason): fail(reason)
            case Ok(changed_plan):
                match build_trace_run_preparation(request, changed_plan):
                    case Ok(_): fail("different request content was bound to the plan")
                    case Err(reason): expect(reason).to_contain("differs from the exact request")

    it "rejects independently changed run, request and plan bindings":
        val request = preparation_request("original")
        match materialize_trace_run_plan(request, "run:allocated"):
            case Err(reason): fail(reason)
            case Ok(plan):
                match build_trace_run_preparation(request, plan):
                    case Err(reason): fail(reason)
                    case Ok(value):
                        var wrong_run = value
                        wrong_run.run_id = "run:other"
                        match validate_trace_run_preparation(wrong_run, request, plan):
                            case Ok(_): fail("wrong allocated run was accepted")
                            case Err(reason): expect(reason).to_contain("run identity mismatch")
                        var wrong_request = value
                        wrong_request.request_digest = "sha256:" + "0".repeat(64)
                        match validate_trace_run_preparation(wrong_request, request, plan):
                            case Ok(_): fail("wrong request digest was accepted")
                            case Err(reason): expect(reason).to_contain("request digest mismatch")
                        var wrong_plan = value
                        wrong_plan.plan_digest = "sha256:" + "0".repeat(64)
                        match validate_trace_run_preparation(wrong_plan, request, plan):
                            case Ok(_): fail("wrong plan digest was accepted")
                            case Err(reason): expect(reason).to_contain("plan digest mismatch")

    it "rejects a forged verified value even with matching request and plan digests":
        val request = preparation_request("original")
        match materialize_trace_run_plan(request, "run:allocated"):
            case Err(reason): fail(reason)
            case Ok(plan):
                match build_trace_run_preparation(request, plan):
                    case Err(reason): fail(reason)
                    case Ok(value):
                        var forged = value
                        forged.evidence_validity = "verified"
                        match validate_trace_run_preparation(forged, request, plan):
                            case Ok(_): fail("forged validity was accepted")
                            case Err(reason): expect(reason).to_contain("cannot grant evidence validity")
                        match encode_trace_run_preparation(forged):
                            case Ok(_): fail("forged validity was serialized")
                            case Err(reason): expect(reason).to_contain("cannot grant evidence validity")

    it "rejects unknown fields, duplicate fields and unsupported schemas":
        val digest = "sha256:" + "0".repeat(64)
        val unknown = "{schema: \"simple.trace.run-preparation/v1\", request_digest: \"{digest}\", run_id: \"run:1\", plan_digest: \"{digest}\", evidence_validity: \"unverified\", selection_digest: \"invented\"}"
        match decode_trace_run_preparation(unknown):
            case Ok(_): fail("invented selection binding was accepted")
            case Err(reason): expect(reason).to_contain("unexpected")
        val duplicate = "{schema: \"simple.trace.run-preparation/v1\", request_digest: \"{digest}\", run_id: \"run:1\", run_id: \"run:2\", plan_digest: \"{digest}\", evidence_validity: \"unverified\"}"
        match decode_trace_run_preparation(duplicate):
            case Ok(_): fail("duplicate run identity was accepted")
            case Err(reason): expect(reason).to_contain("duplicate")
        val future = "{schema: \"simple.trace.run-preparation/v2\", request_digest: \"{digest}\", run_id: \"run:1\", plan_digest: \"{digest}\", evidence_validity: \"unverified\"}"
        match decode_trace_run_preparation(future):
            case Ok(_): fail("unknown schema was accepted")
            case Err(reason): expect(reason).to_contain("unsupported")

    it "rejects forged wire validity, malformed digests and oversized input":
        val digest = "sha256:" + "0".repeat(64)
        val forged = "{schema: \"simple.trace.run-preparation/v1\", request_digest: \"{digest}\", run_id: \"run:1\", plan_digest: \"{digest}\", evidence_validity: \"verified\"}"
        match decode_trace_run_preparation(forged):
            case Ok(_): fail("wire validity was trusted")
            case Err(reason): expect(reason).to_contain("cannot grant evidence validity")
        val malformed = TraceRunPreparation(request_digest: "sha256:" + "G".repeat(64), run_id: "run:1", plan_digest: digest, evidence_validity: "unverified")
        match encode_trace_run_preparation(malformed):
            case Ok(_): fail("non-hex digest was accepted")
            case Err(reason): expect(reason).to_contain("canonical SHA-256")
        match decode_trace_run_preparation(" ".repeat(1048577)):
            case Ok(_): fail("oversized receipt was accepted")
            case Err(reason): expect(reason).to_contain("exceeds 1 MiB")
