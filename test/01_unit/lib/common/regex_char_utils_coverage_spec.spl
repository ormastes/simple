            expect(is_special_regex_char("[")).to_equal(true)

        it "returns true for ']'":
            step("Verify: returns true for ']'")
            expect(is_special_regex_char("]")).to_equal(true)

        it "returns true for '{'":
            step("Verify: returns true for '('")
            expect(is_special_regex_char("{")).to_equal(true)

        it "returns true for '}'":
            step("Verify: returns true for ')'")
            expect(is_special_regex_char("}")).to_equal(true)

        it "returns true for '^'":
