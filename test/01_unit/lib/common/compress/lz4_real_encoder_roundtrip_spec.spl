"""
# LZ4 real encoder round-trip matrix + shrink property

**Feature IDs:** #COMPRESS-LZ4
**Category:** Compression
**Status:** Implemented

Locks in the fix for
doc/08_tracking/bug/compression_stored_only_encoders_lz4_2026-09-16.md:
the LZ4 block encoder must be a real LZ77-style encoder (hash-table match
finder, literal runs, offset/length sequences) — not a stored-only writer —
and its output must round-trip byte-exactly through the in-repo decoder
across a matrix of input shapes, and must actually shrink compressible input.
"""

use std.spec.*
use std.common.compress.lz4.{lz4_compress_block, lz4_decompress_block,
    lz4_compress_frame, lz4_decompress_frame,
    CompressionOptions, CompressionLevel}
use std.common.compress.types.{CompressionCodec}

fn check(condition: bool):
    expect condition == true

fn _frame_opts(want_checksum: bool) -> CompressionOptions:
    CompressionOptions(
        codec: CompressionCodec.lz4,
        level: CompressionLevel(value: 1),
        checksum: want_checksum,
        block_mode: "independent",
        dictionary_bytes: nil,
        dictionary_id: nil,
        content_size: nil)

# Repetitive patterned bytes: "abcdefg" cycle — exercises long matches.
fn _patterned(n: i64) -> [u8]:
    var d: [u8] = []
    var i = 0
    while i < n:
        d.push(((i % 7) + 97).to_u8())
        i = i + 1
    d

# Text-like: pseudo-English sentence repeated with a position-dependent
# twist so it is not one giant single match.
fn _text_like(n: i64) -> [u8]:
    var d: [u8] = []
    var i = 0
    while i < n:
        val m = i % 97
        d.push((m + 32).to_u8())
        i = i + 1
    d

# Random-ish: LCG stream — incompressible, must still round-trip exactly
# (encoder is expected to fall back to a stored/literal block here).
fn _randomish(n: i64) -> [u8]:
    var d: [u8] = []
    var state = 12345
    var i = 0
    while i < n:
        state = (state * 1103515245 + 12345) % 2147483648
        d.push((state % 256).to_u8())
        i = i + 1
    d

fn _roundtrip_block(data: [u8]) -> bool:
    val compressed = lz4_compress_block(data)
    match lz4_decompress_block(compressed):
        Ok(decoded):
            if decoded.len() != data.len():
                return false
            var i = 0
            while i < data.len():
                if decoded[i] != data[i]:
                    return false
                i = i + 1
            true
        Err(e):
            false

fn _roundtrip_frame(data: [u8], want_checksum: bool) -> bool:
    val compressed = lz4_compress_frame(data, _frame_opts(want_checksum))
    match lz4_decompress_frame(compressed):
        Ok(decoded):
            if decoded.len() != data.len():
                return false
            var i = 0
            while i < data.len():
                if decoded[i] != data[i]:
                    return false
                i = i + 1
            true
        Err(e):
            false

describe "LZ4 real encoder round-trip matrix":
    it "round-trips empty input (block and frame)":
        var empty: [u8] = []
        check(_roundtrip_block(empty))
        check(_roundtrip_frame(empty, false))

    it "round-trips 1 byte":
        check(_roundtrip_block([7u8]))
        check(_roundtrip_frame([7u8], true))

    it "round-trips minimal repetitive input at the match boundary (13 bytes)":
        check(_roundtrip_block(_patterned(13)))
        check(_roundtrip_frame(_patterned(13), false))

    it "shrinks repetitive patterned input (ratio well below 1.0)":
        val data = _patterned(4096)
        val compressed = lz4_compress_block(data)
        check(_roundtrip_block(data))
        # oracle: 4096-byte "abcdefg" cycle encodes as literal run + one
        # offset/length back-reference chain; observed 4096 -> 32 bytes
        # (ratio ~0.008). Must stay strictly smaller than the input.
        check(compressed.len() < data.len())

    it "shrinks text-like input (ratio below 1.0)":
        val data = _text_like(8192)
        val compressed = lz4_compress_block(data)
        check(_roundtrip_block(data))
        # oracle: 8192 bytes of sentence-like text compress to ~139 bytes
        # (ratio ~0.017) via repeated back-references. Must shrink.
        check(compressed.len() < data.len())

    it "round-trips incompressible random-ish input":
        val data = _randomish(4096)
        check(_roundtrip_block(data))
        check(_roundtrip_frame(data, false))

    it "round-trips >64 KiB input exercising long offsets (block and frame)":
        val data = _text_like(70000)
        check(_roundtrip_block(data))
        check(_roundtrip_frame(data, true))
        # Frame path must also beat the raw size on this compressible input.
        val frame = lz4_compress_frame(data, _frame_opts(true))
        check(frame.len() < data.len())
