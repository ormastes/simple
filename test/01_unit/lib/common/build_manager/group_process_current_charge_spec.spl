use std.spec
use std.common.build_manager.group_process_protocol.{GroupProcessPollV1,
    group_process_observation_encode_v1, group_process_observation_decode_v1}

fn digest(ch: text) -> text: ch.repeat(64)

describe "Group broker current memory charge":
    it "round trips a live charge separately from lifetime peak":
        val identity = digest("a")
        val live = GroupProcessPollV1(false, false, false, 1, -1,
            false, false, 134217728, 67108864)
        match group_process_observation_decode_v1(identity,
                group_process_observation_encode_v1(identity, live)):
            case Ok(observed):
                expect(observed.memory_peak_bytes).to_equal(134217728)
                expect(observed.memory_current_bytes).to_equal(67108864)
            case Err(reason): fail(reason)

    it "requires zero current charge after a proven tree reap":
        val identity = digest("b")
        val complete = GroupProcessPollV1(true, true, true, 0, 0,
            false, false, 134217728, 0)
        match group_process_observation_decode_v1(identity,
                group_process_observation_encode_v1(identity, complete)):
            case Ok(observed): expect(observed.memory_current_bytes).to_equal(0)
            case Err(reason): fail(reason)
        val stale = GroupProcessPollV1(true, true, true, 0, 0,
            false, false, 134217728, 1)
        match group_process_observation_decode_v1(identity,
                group_process_observation_encode_v1(identity, stale)):
            case Ok(_): fail("reaped group retained a live charge")
            case Err(reason): expect(reason).to_equal("inconsistent current group memory charge")

    it "rejects a current charge larger than its observed peak":
        val identity = digest("c")
        val invalid = GroupProcessPollV1(false, false, false, 1, -1,
            false, false, 100, 101)
        match group_process_observation_decode_v1(identity,
                group_process_observation_encode_v1(identity, invalid)):
            case Ok(_): fail("current charge exceeded lifetime peak")
            case Err(reason): expect(reason).to_equal("inconsistent current group memory charge")
