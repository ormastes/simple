use std.spec.{describe, it, expect}
use std.common.build_manager.work_deadline.{builder_work_deadline_v1, builder_work_deadline_expired_v1}

describe "manager workload deadlines":
    it "keeps explicit unlimited work alive beyond every former fixed cap":
        val deadline = builder_work_deadline_v1(100, 0)
        expect(deadline).to_equal(0)
        for now in [100, 86400100, 604800100, 1209600100]:
            expect(builder_work_deadline_expired_v1(now, deadline)).to_equal(false)

    it "expires a finite work budget exactly at its deadline":
        val deadline = builder_work_deadline_v1(100, 200)
        expect(builder_work_deadline_expired_v1(299, deadline)).to_equal(false)
        expect(builder_work_deadline_expired_v1(300, deadline)).to_equal(true)
        expect(builder_work_deadline_expired_v1(301, deadline)).to_equal(true)

    it "does not disable a separate finite cleanup deadline":
        val work_deadline = builder_work_deadline_v1(100, 0)
        val cleanup_deadline = builder_work_deadline_v1(100, 30000)
        expect(builder_work_deadline_expired_v1(30100, work_deadline)).to_equal(false)
        expect(builder_work_deadline_expired_v1(30100, cleanup_deadline)).to_equal(true)
