use std.spec.{describe, it, expect}
use test.fixtures.bootstrap.grouped_native_request.checks.{request_wire_check_v1,
    request_wire_refusal_check_v1, request_authority_refusal_check_v1,
    request_numeric_bounds_check_v1}

describe "grouped worker request defining owner":
    it "REQ-HIR-GROUPED-REQUEST-001 preserves exact wire bytes and every field":
        expect(request_wire_check_v1()).to_equal(true)
    it "REQ-HIR-GROUPED-REQUEST-002 rejects oversized noncanonical or trailing wire":
        expect(request_wire_refusal_check_v1()).to_equal(true)
    it "REQ-HIR-GROUPED-REQUEST-003 retains path identity backend and overlap refusals":
        expect(request_authority_refusal_check_v1()).to_equal(true)
    it "REQ-HIR-GROUPED-REQUEST-004 retains inclusive thread and timeout bounds":
        expect(request_numeric_bounds_check_v1()).to_equal(true)
