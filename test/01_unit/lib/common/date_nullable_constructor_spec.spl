use std.spec
use std.common.date.types.{from_ymd, from_days}

describe "typed nullable date constructors":
    it "preserves a valid Gregorian leap day inside Some":
        match from_ymd(2024, 2, 29):
            case Some(actual):
                expect(actual[0]).to_equal(2024)
                expect(actual[1]).to_equal(2)
                expect(actual[2]).to_equal(29)
            case nil: assert(false)

    it "rejects month thirteen and days past the calendar boundary":
        expect(from_ymd(2025, 13, 1)).to_be_nil()
        expect(from_ymd(2025, 1, 32)).to_be_nil()

    it "preserves the first leap year day-count boundary payload":
        match from_days(1155):
            case Some(actual):
                expect(actual[0]).to_equal(4)
                expect(actual[1]).to_equal(2)
                expect(actual[2]).to_equal(29)
            case nil: assert(false)
