# Purpose and audience: executable specification evidence for the owning engineering team.
# Pins the fix for doc/08_tracking/bug/unwrap_family_treats_flat_nil_as_present_2026-09-13.md:
# a runtime flat nil (the bare-nil representation of an absent `T?`) must behave as ABSENT
# for the whole unwrap family — unwrap_or yields the default, unwrap/expect trap with
# "called unwrap on None", and is_none/is_some see it — on every engine.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec

fn absent_text(m: Map<text, text>, k: text) -> text?:
    return m.get(k)

fn absent_i64(m: Map<i64, i64>, k: i64) -> i64?:
    return m.get(k)

describe "unwrap family on a runtime flat nil (bare-nil absent representation)":

    it "unwrap_or yields the caller's default for a runtime flat nil":
        # @req REQ-SSPEC-UNIT
        step("dict miss produces a bare nil receiver at runtime")
        var m: Map<text, text> = Map.new()
        m.insert("a", "/A")
        val missing = absent_text(m, "zzz")
        expect(missing.is_none()).to_equal(true)
        expect(missing.unwrap_or("/fallback")).to_equal("/fallback")

    it "unwrap_or yields the payload for a present flat value":
        # @req REQ-SSPEC-UNIT
        step("present value passes through unwrap_or unchanged")
        var m: Map<text, text> = Map.new()
        m.insert("a", "/A")
        val present = absent_text(m, "a")
        expect(present.is_some()).to_equal(true)
        expect(present.unwrap_or("/fallback")).to_equal("/A")

    it "typed numeric option: flat nil unwrap_or yields the numeric default":
        # @req REQ-SSPEC-UNIT
        step("i64? dict miss unwrap_or(42) == 42")
        var m: Map<i64, i64> = Map.new()
        m.insert(1, 100)
        expect(absent_i64(m, 99).unwrap_or(42)).to_equal(42)
        expect(absent_i64(m, 1).unwrap_or(42)).to_equal(100)

describe "unwrap family on a compile-time-known nil literal":

    it "nil-literal unwrap_or yields the default and is_none is true":
        # @req REQ-SSPEC-UNIT
        step("val n: text? = nil path")
        val n: text? = nil
        expect(n.is_none()).to_equal(true)
        expect(n.unwrap_or("/fallback")).to_equal("/fallback")
        val p: text? = "/present"
        expect(p.is_some()).to_equal(true)
        expect(p.unwrap_or("/fallback")).to_equal("/present")
