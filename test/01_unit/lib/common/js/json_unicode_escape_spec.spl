"""
## Purpose and audience
Purpose: Prove that json unicode escape decoding (js builtins parse_string).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

"""
RFC 8259 \\uXXXX decoding in the JS engine's JSON string parser (was:
every \\uXXXX became a literal "?" — the data-loss bug flagged by
doc/08_tracking/bug/bracket_slice_byte_index_survey_2026-07-29.md at
json.spl:83-85).

Tests target parse_string (the decode surface, returning a plain Pair)
rather than json_parse: constructing the builtin Result that json_parse
returns is not supported by the unit-spec interpreter lane ("unknown
class Result"), while the decode logic itself is fully exercised here.

Byte-sequence assertions: text equality is byte equality and .len() is
BYTE length, so equality + len pin the exact bytes.
"""

use std.spec.*
use std.common.js.builtins.json.{parse_string}
use std.common.js.types.pair.{Pair}

fn decoded(input: text) -> text:
    # input must start with the opening quote at index 0
    parse_string(input, 0).first

describe "json unicode escape decoding (js builtins parse_string)":
    it "decodes ASCII and BMP escapes to UTF-8 bytes, not question marks":
        step("Verify: decodes ASCII and BMP escapes to UTF-8 bytes, not question marks")
        # @req: REQ-LIB-COMMON-001
        val out = decoded("\"\\u0041 caf\\u00e9\"")
        expect(out).to_equal("A café")
        # bytes: A, space, c, a, f, then 2-byte e-acute = 7
        expect(out.len()).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect not out.contains("?")

    it "decodes CJK escape to 3-byte UTF-8":
        step("Verify: decodes CJK escape to 3-byte UTF-8")
        val out = decoded("\"\\u4e2d\"")
        expect(out).to_equal("中")
        expect(out.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "combines surrogate pairs into supplementary codepoints":
        step("Verify: combines surrogate pairs into supplementary codepoints")
        val out = decoded("\"\\ud83d\\ude00\"")
        expect(out).to_equal("😀")
        expect(out.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "decodes lone surrogates to U+FFFD":
        step("Verify: decodes lone surrogates to U+FFFD")
        expect(decoded("\"\\ud83dX\"")).to_equal("�X")
        expect(decoded("\"\\udc00\"")).to_equal("�")

    it "handles mixed literal and escaped content byte-correctly":
        step("Verify: handles mixed literal and escaped content byte-correctly")
        val out = decoded("\"é\\u4e2dz\\ud83d\\ude00\"")
        expect(out).to_equal("é中z😀")
        expect(out.len()).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "continues parsing correctly after the escape (consumption length)":
        step("Verify: continues parsing correctly after the escape (consumption length)")
        val p = parse_string("\"\\u0041B\"", 0)
        expect(p.first).to_equal("AB")
        # closing quote consumed: index just past the final quote
        expect(p.second).to_equal(9)  # oracle: 9 — named expected value from the requirement
