use std.js.builtins.string.{string_charAt, string_charCodeAt, string_split, string_length}

# Multi-byte regression coverage for src/lib/common/js/builtins/string.spl.
#
# string_charAt/string_charCodeAt/string_split("") used to index by BYTE
# offset while claiming JS character-index semantics (the function name
# "charAt" implies "the i-th character", not "the i-th byte"). For pure
# ASCII the two coincide; for multi-byte UTF-8 content they diverge and the
# old code returned partial, invalid UTF-8 byte fragments instead of the
# requested character. Fixed to walk codepoint boundaries via
# text_codepoints/utf8_codepoint_byte_len (never char_at -- char_at is
# itself character-indexed and mixing it with this file's otherwise-all-
# byte-indexed arithmetic is the exact bug class this spec's sibling survey
# found in scv/structural_match.spl; see
# doc/08_tracking/bug/bracket_slice_byte_index_survey_2026-07-29.md).

describe "string_charAt / string_charCodeAt / string_split multi-byte":
    it "cafe with a combining-free accented e (2-byte UTF-8) — charAt returns the whole character, not a byte fragment":
        val s = "café"
        expect(string_length(s)).to_equal(5)  # 4 codepoints, "é" is 2 bytes -> 5 bytes total
        expect(string_charAt(s, 0)).to_equal("c")
        expect(string_charAt(s, 1)).to_equal("a")
        expect(string_charAt(s, 2)).to_equal("f")
        expect(string_charAt(s, 3)).to_equal("é")
        expect(string_charAt(s, 4)).to_equal("")  # out of range (4 codepoints, index 4 doesn't exist)

    it "cafe — charCodeAt returns the Unicode codepoint value, not the UTF-8 lead byte":
        val s = "café"
        expect(string_charCodeAt(s, 3)).to_equal(233)  # U+00E9 LATIN SMALL LETTER E WITH ACUTE

    it "CJK (3-byte-per-character) — charAt walks whole characters, not bytes":
        val s = "日本語"
        expect(string_length(s)).to_equal(9)  # 3 codepoints * 3 bytes each
        expect(string_charAt(s, 0)).to_equal("日")
        expect(string_charAt(s, 1)).to_equal("本")
        expect(string_charAt(s, 2)).to_equal("語")
        expect(string_charAt(s, 3)).to_equal("")

    it "em-dash (3-byte UTF-8) between two ASCII characters — charAt/charCodeAt land on the right character":
        val s = "a—b"
        expect(string_length(s)).to_equal(5)  # 'a' + 3-byte em-dash + 'b'
        expect(string_charAt(s, 0)).to_equal("a")
        expect(string_charAt(s, 1)).to_equal("—")
        expect(string_charAt(s, 2)).to_equal("b")
        expect(string_charCodeAt(s, 1)).to_equal(8212)  # U+2014 EM DASH

    it "cafe — split('') yields one array element per character, not per byte":
        val parts = string_split("café", "")
        expect(parts.len()).to_equal(4)
        expect(parts[0]).to_equal("c")
        expect(parts[1]).to_equal("a")
        expect(parts[2]).to_equal("f")
        expect(parts[3]).to_equal("é")

    it "CJK — split('') yields one array element per character, not per byte":
        val parts = string_split("日本語", "")
        expect(parts.len()).to_equal(3)
        expect(parts[0]).to_equal("日")
        expect(parts[1]).to_equal("本")
        expect(parts[2]).to_equal("語")

    it "pure ASCII is unaffected (regression guard: byte and codepoint indices coincide)":
        val s = "hello"
        expect(string_charAt(s, 1)).to_equal("e")
        expect(string_charCodeAt(s, 1)).to_equal(101)
        val parts = string_split(s, "")
        expect(parts.len()).to_equal(5)
        expect(parts[4]).to_equal("o")
