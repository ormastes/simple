# @req: REQ-LIB-COMMON-JS-ENGINE-001

# codex-system-test
# @req REQ-WEB-BROWSER-017
# @cover src/lib/common/js/engine/interpreter_types.spl

use std.spec.*
use std.js.engine.js_error.{Logger, LogLevel}
use std.js.engine.parser.{JsParser}
use std.js.types.js_types.{JsValue}
use std.nogc_sync_mut.js.engine.interpreter.{JsInterpreter}
use std.js.engine.interpreter_types.{EnvironmentStack}

class LexicalParentFixture:
    stack: EnvironmentStack
    global_env: i64
    creator_env: i64
    escaped_env: i64

fn setup_lexical_parent_fixture() -> LexicalParentFixture:
    var stack = EnvironmentStack.new()
    val global_env = stack.create_env(-1)
    val creator_env = stack.create_env(global_env)
    val escaped_env = stack.create_env(creator_env)
    stack.define_var(global_env, "global_name", JsValue.String(v: "global"))
    stack.define_var(creator_env, "creator_only", JsValue.String(v: "creator"))
    stack.define_var(creator_env, "name", JsValue.String(v: "parent"))
    stack.define_var(escaped_env, "name", JsValue.String(v: "child"))
    LexicalParentFixture(
        stack: stack,
        global_env: global_env,
        creator_env: creator_env,
        escaped_env: escaped_env
    )

fn check_escaped_closure_identity() -> text:
    val source = "function make() { var captured = { id: 41 }; return function() { return captured; }; } var escaped = make(); var first = escaped(); var second = escaped(); first === second && first.id === 41"
    val logger = Logger.new("lexical-parent-spec", LogLevel.Error)
    val parser = JsParser.new(source, logger)
    match parser.parse_program():
        Ok(statements):
            val interpreter = JsInterpreter.new(logger)
            match interpreter.execute(statements):
                Ok(JsValue.Boolean(v)): if v: "same" else: "different"
                Ok(_):
                    fail("escaped closure did not return a boolean identity result")
                    "unreachable"
                Err(error):
                    fail("escaped closure execution failed: {error.message}")
                    "unreachable"
        Err(error):
            fail("escaped closure fixture failed to parse: {error.message}")
            "unreachable"

fn _string_value(value: JsValue?) -> text:
    match value:
        Some(JsValue.String(s)): s
        nil: "<missing>"
        _: "<non-string>"

fn check_parent_lookup_and_assignment(fixture: LexicalParentFixture) -> [text]:
    var stack = fixture.stack
    val inherited_global = _string_value(stack.get_var(fixture.escaped_env, "global_name"))
    val shadowed = _string_value(stack.get_var(fixture.escaped_env, "name"))
    stack.set_var(fixture.escaped_env, "captured_name", JsValue.String(v: "local"))
    stack.set_var(fixture.escaped_env, "name", JsValue.String(v: "updated-child"))
    stack.set_var(fixture.escaped_env, "creator_only", JsValue.String(v: "updated-creator"))
    stack.set_var(fixture.escaped_env, "global_name", JsValue.String(v: "updated-global"))
    [
        inherited_global,
        shadowed,
        _string_value(stack.get_var(fixture.escaped_env, "name")),
        _string_value(stack.get_var(fixture.creator_env, "name")),
        _string_value(stack.get_var(fixture.creator_env, "creator_only")),
        _string_value(stack.get_var(fixture.global_env, "global_name")),
        _string_value(stack.get_var(fixture.escaped_env, "captured_name")),
        _string_value(stack.get_var(fixture.escaped_env, "missing"))
    ]

fn check_environment_cycle_rejected() -> [i64]:
    var stack = EnvironmentStack.new()
    val global_env = stack.create_env(-1)
    val rejected_self_parent = stack.create_env(1)
    val child_env = stack.create_env(global_env)
    var parent_ids = stack.env_parent_ids
    parent_ids[child_env] = child_env
    stack.env_parent_ids = parent_ids
    val missing_terminated = if stack.get_var(child_env, "missing") == nil: 1 else: 0

    var boundary_stack = EnvironmentStack.new()
    var parent_env = boundary_stack.create_env(-1)
    while boundary_stack.next_id < 8:
        parent_env = boundary_stack.create_env(parent_env)
    val rejected_id_eight = boundary_stack.create_env(8)
    val rejected_future_alias = boundary_stack.create_env(16)
    [
        rejected_self_parent,
        child_env,
        missing_terminated,
        rejected_id_eight,
        rejected_future_alias,
        boundary_stack.next_id
    ]

describe "JavaScript VM lexical environment prerequisite":
    describe "REQ-WEB-BROWSER-017: lexical parents preserve closure state":
        it "should create a valid lexical parent chain":
            # @req: REQ-WEB-BROWSER-017
            step("Verify: should create a valid lexical parent chain")
            step("Create a lexical parent chain")
            val fixture = setup_lexical_parent_fixture()
            expect(fixture.global_env).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(fixture.creator_env).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(fixture.escaped_env).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(fixture.stack.env_parent_ids.get(fixture.creator_env)).to_equal(fixture.global_env)
            expect(fixture.stack.env_parent_ids.get(fixture.escaped_env)).to_equal(fixture.creator_env)

        it "should retain captured object identity after the creator returns":
            # @req: REQ-LIB-COMMON-JS-ENGINE-001
            step("Verify: should retain captured object identity after the creator returns")
            step("Capture a value in an escaped closure")
            expect(check_escaped_closure_identity()).to_equal("same")

        it "should resolve shadowing and assign through the nearest lexical owner":
            # @req: REQ-WEB-BROWSER-017
            step("Verify: should resolve shadowing and assign through the nearest lexical owner")
            step("Shadow and assign through the chain")
            val fixture = setup_lexical_parent_fixture()
            val values = check_parent_lookup_and_assignment(fixture)
            expect(values).to_equal([
                "global",
                "child",
                "updated-child",
                "parent",
                "updated-creator",
                "updated-global",
                "local",
                "<missing>"
            ])
            var stack = fixture.stack
            expect(stack.get_var(fixture.escaped_env, "missing")).to_be_nil()

        it "should reject a self-parent and terminate a corrupted cycle":
            # @req: REQ-LIB-COMMON-JS-ENGINE-001
            step("Verify: should reject a self-parent and terminate a corrupted cycle")
            step("Reject a cyclic environment link")
            expect(check_environment_cycle_rejected()).to_equal([-1, 1, 1, -1, -1, 8])
