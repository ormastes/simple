# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB

"""
## Purpose and audience

The brotli encoder is otherwise only checked by round-tripping through the
in-tree decoder, which is circular. These expected bytes were derived BY HAND
from the RFC 7932 bit rules (bits are packed LSB-first into each byte; multi-bit
fields are written LSB-first; a prefix code with one symbol is a zero-length
code). Audience: compression library maintainers.

# @manual_section: brotli-encoder
"""

use std.spec.step
use std.spec.*
use std.nogc_sync_mut.compression.brotli.encoder.{brotli_encode, brotli_encode_uncompressed}

fn _bytes_eq(got: [u8], want: [i64]) -> bool:
    if got.len() != want.len():
        return false
    var i = 0
    while i < want.len():
        if got[i].to_i64() != want[i]:
            return false
        i = i + 1
    true

describe "brotli encoder pinned bytes (hand-derived from RFC 7932)":
    it "encodes the empty input as WBITS=16, ISLAST=1, ISLASTEMPTY=1":
        step("bits 0,1,1 -> 0b110 = 0x06")
        # WBITS=16 is the single bit 0 (RFC 9.1); ISLAST=1; ISLASTEMPTY=1.
        # Bit0=0, bit1=1, bit2=1 -> byte 0x06.
        expect(_bytes_eq(brotli_encode([]), [0x06])).to_equal(true)

    it "encodes one byte 'A' as an uncompressed meta-block":
        step("derive 00 00 10 41 03")
        # bit0 WBITS=0 | bit1 ISLAST=0 | bits2-3 MNIBBLES code 0 (4 nibbles)
        # bits4-19 MLEN-1=0 (16 bits) | bit20 ISUNCOMPRESSED=1 | bits21-23 pad.
        # -> bytes 0x00, 0x00, 0x10 (bit 20 = bit 4 of byte 2), then raw 0x41.
        # Terminator ISLAST=1, ISLASTEMPTY=1 -> bits 0,1 of the next byte = 0x03.
        expect(_bytes_eq(brotli_encode_uncompressed([0x41]), [0x00, 0x00, 0x10, 0x41, 0x03])).to_equal(true)
        expect(_bytes_eq(brotli_encode([0x41]), [0x00, 0x00, 0x10, 0x41, 0x03])).to_equal(true)

    it "encodes 16 non-repeating a/b bytes as a literal-only compressed meta-block":
        step("derive e2 01 00 00 54 98 58 20 14 80 2e 6b (96 bits)")
        # Input "abbbabaabbababba". Bits in stream order:
        #  WBITS 0 | ISLAST 1 | ISLASTEMPTY 0 | MNIBBLES code 00 | MLEN-1=15 (16 bits)
        #  NBLTYPESL/I/D = 0,0,0 (value 1 each) | NPOSTFIX 00 NDIRECT 0000 CMODE 00
        #  NTREESL 0, NTREESD 0 (both counts precede all trees, RFC 9.2) = 34 bits.
        #  Literal tree: simple (HSKIP=1: bits 1,0), NSYM-1=1 (bits 1,0), symbols
        #  0x61,0x62 in 8 bits each (sorted; codes a=0, b=1)             = 20 bits.
        #  Command tree: HSKIP 1, NSYM-1=0, one 10-bit symbol. Length 16 uses
        #  insert code 9 (base 14, 2 extra bits, extra value 2); cell 4 (insert
        #  8-15, copy 0-7, explicit distance); symbol = 4*64 + (9&7)*8 + 0 = 264 = 14 bits.
        #  Distance tree: HSKIP 1, NSYM-1=0, 6-bit symbol 0              = 10 bits.
        #  Insert extra bits 2 in 2 bits (0,1); 16 one-bit literal codes
        #  (a=0, b=1); copy omitted because MLEN is reached             = 18 bits.
        # Total 96 bits = 12 bytes, versus 20 bytes uncompressed, so it is chosen.
        val data: [u8] = [0x61, 0x62, 0x62, 0x62, 0x61, 0x62, 0x61, 0x61, 0x62, 0x62, 0x61, 0x62, 0x61, 0x62, 0x62, 0x61]
        val want = [0xe2, 0x01, 0x00, 0x00, 0x54, 0x98, 0x58, 0x20, 0x14, 0x80, 0x2e, 0x6b]
        expect(_bytes_eq(brotli_encode(data), want)).to_equal(true)
