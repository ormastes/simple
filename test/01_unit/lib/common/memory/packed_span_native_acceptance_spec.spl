# @mode: native
# @tag: unit, memory, packed_span, render_perf, native
#
# Focused F2 criterion-7 acceptance gate. This spec proves only that the
# native engine delivers the already-defined SimplePackedSpanV1 contract; it
# makes no throughput or performance claim. ABI width and typed refusal
# coverage remain in packed_span_spec.spl.

use std.spec
use common.memory.packed_span.{
    PackedSpanRegistry,
    packed_span_make,
    packed_span_backend_name,
    packed_span_resolve_base,
    packed_span_probe_bytes,
    packed_span_last_verdict,
    PACKED_SPAN_OK,
    PACKED_SPAN_C_OK
}

describe "packed span F2 native acceptance (criterion 7)":
    it "requires a stable nonzero native-packed-v1 base with verdict zero":
        assert_equal(packed_span_backend_name(), "native-packed-v1")

        val reg = PackedSpanRegistry.create(1)
        val slot = reg.register(4096)
        assert_equal(slot, 0)
        val r = packed_span_make(slot, reg.generation_of(slot), 0, 1024, 4)
        assert_equal(reg.resolve(r), PACKED_SPAN_OK)

        val backing = packed_span_probe_bytes(4096)
        val first_base = packed_span_resolve_base(backing, r)
        assert_true(first_base != 0)
        assert_equal(packed_span_last_verdict(), PACKED_SPAN_C_OK)

        val second_base = packed_span_resolve_base(backing, r)
        assert_true(second_base != 0)
        assert_equal(second_base, first_base)
        assert_equal(packed_span_last_verdict(), PACKED_SPAN_C_OK)
