use std.spec.*
use std.common.debug.contracts_v1.{debug_wire_v1, debug_policy_development_v1}
use std.common.debug.service_v1.{central_debug_service_v1_open, central_debug_service_v1_receipts}
use std.common.debug.wire_dispatch_v1.{dispatch_debug_wire_v1}

describe "DebugWireV1 dispatch boundary":
    it "dispatches an allowlisted command through the central service with a receipt":
        val session_id = central_debug_service_v1_open("wire-build-allowed", debug_policy_development_v1())!
        val wire = debug_wire_v1("wire-request-1", session_id.value, "probe", "probe", "probe.list", "none", "")
        val dispatched = dispatch_debug_wire_v1(wire)!
        expect(dispatched.request_id).to_equal("wire-request-1")
        expect(dispatched.receipt.allowed).to_equal(true)
        expect(dispatched.receipt.action).to_equal("wire.probe.probe.list")

    it "fails closed for an unknown domain command and records the rejection":
        val session_id = central_debug_service_v1_open("wire-build-reject", debug_policy_development_v1())!
        val before = central_debug_service_v1_receipts(session_id).len()
        val wire = debug_wire_v1("wire-request-2", session_id.value, "domain", "sql", "drop-database", "none", "")
        match dispatch_debug_wire_v1(wire):
            case Ok(_): fail("unknown domain command was dispatched")
            case Err(reason): expect(reason).to_equal("unsupported debug wire domain/command")
        val receipts = central_debug_service_v1_receipts(session_id)
        expect(receipts.len()).to_equal(before + 1)
        expect(receipts[receipts.len() - 1].action).to_equal("wire.reject")
        expect(receipts[receipts.len() - 1].allowed).to_equal(false)

    it "rejects an unsupported wire major before command execution":
        val session_id = central_debug_service_v1_open("wire-build-version", debug_policy_development_v1())!
        var wire = debug_wire_v1("wire-request-3", session_id.value, "observe", "service", "doctor", "none", "")
        wire.version = "debug-wire-v2"
        match dispatch_debug_wire_v1(wire):
            case Ok(_): fail("unsupported wire major was dispatched")
            case Err(reason): expect(reason).to_equal("unsupported debug wire major")
