# codex-system-test
"""
## Purpose and audience

Probe and evidence lifecycle contract for the central debug service: probe
registration against a registered target, source-anchor and unknown-target
rejection, observe-only denial of Probe operations with a retained denial
receipt, session close making further probe registration fail closed, and
build-bound evidence export with digest admission. Written for the
debug-service owner; the surface under test is `std.common.debug.service_v1` /
`contracts_v1` (the `central_debug_service_v1_*` functions and
`DebugServiceV1`).

## Operator workflow

Run one spec: `bin/simple test test/01_unit/lib/common/debug/debug_service_v1_spec.spl`.

## Compatibility and limitations

The evidence scenarios were absence tripwires until `DebugEvidenceArtifactV1`
and `export_evidence` landed; they now assert the real export contract.

## Verification guidance and troubleshooting

Any failure is a genuine regression in `std.common.debug.service_v1`.
"""
# doc/03_plan/agent_tasks/simple_unified_debugging_evidence.md ;
# doc/04_architecture/simple_unified_debugging_evidence.md ;
# doc/05_design/simple_unified_debugging_evidence.md
# @manual_section: debug-service-probe-evidence-lifecycle

use std.spec.*
use std.common.debug.contracts_v1.{
    DebugCapabilityV1, DebugVerificationV1, DebugPerturbationV1,
    DebugTargetNodeV1, DebugProbeKindV1, DebugRootOperationV1,
    DebugPolicyV1, DebugSessionId, DebugEvidenceArtifactV1,
}
use std.common.debug.capability.{CapLevel}
use std.common.debug.service_v1.{
    debug_policy_development_v1, debug_policy_observe_only_v1,
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_apply_probe, central_debug_service_v1_authorize,
    central_debug_service_v1_close, central_debug_service_v1_export_evidence,
    central_debug_service_v1_receipts,
}


fn open_with_target(policy: DebugPolicyV1) -> DebugSessionId:
    val session = central_debug_service_v1_open("sha256:probe-build", policy).unwrap()
    central_debug_service_v1_add_target(
        session,
        DebugTargetNodeV1("t0", "", "process", "target zero"),
        DebugCapabilityV1("t0", CapLevel.Native, DebugVerificationV1.LiveVerified, DebugPerturbationV1.Cooperative, "reachable"),
    ).unwrap()
    session

describe "DebugServiceV1 probe lifecycle":
    it "should apply a development probe with receipted perturbation":
        # @req REQ-008
        step("Open a development session with one target and register a stop probe")
        val session = open_with_target(debug_policy_development_v1())
        val auth = central_debug_service_v1_authorize(session, DebugRootOperationV1.Probe, DebugPerturbationV1.Stopping, "probe.apply")
        expect(auth.allowed).to_equal(true)
        val probe = central_debug_service_v1_apply_probe(session, DebugProbeKindV1.Stop, "t0", "main.spl:10", DebugPerturbationV1.Stopping, 0).unwrap()
        expect(probe.session_id).to_equal(session.value)
        expect(probe.target_id).to_equal("t0")
        expect(probe.source_anchor).to_equal("main.spl:10")
        expect(probe.probe_id).to_start_with("probe-" + session.value)

    it "should reject probes without a source anchor or for an unregistered target":
        # @req REQ-008
        val session = open_with_target(debug_policy_development_v1())
        match central_debug_service_v1_apply_probe(session, DebugProbeKindV1.Stop, "t0", "  ", DebugPerturbationV1.Stopping, 0):
            case Ok(_): fail("probe without source anchor must be rejected")
            case Err(reason): expect(reason).to_contain("source anchor")
        match central_debug_service_v1_apply_probe(session, DebugProbeKindV1.Stop, "nope", "main.spl:10", DebugPerturbationV1.Stopping, 0):
            case Ok(_): fail("probe on unregistered target must be rejected")
            case Err(reason): expect(reason).to_contain("unregistered probe target")

    it "should deny probe application under observe-only policy and retain denial receipt":
        # @req REQ-009
        val observe_policy = debug_policy_observe_only_v1()
        expect(observe_policy.allow_control).to_equal(false)
        expect(observe_policy.allow_domain).to_equal(false)
        val session = open_with_target(observe_policy)
        val denied = central_debug_service_v1_authorize(session, DebugRootOperationV1.Probe, DebugPerturbationV1.Stopping, "probe.apply")
        expect(denied.allowed).to_equal(false)
        expect(denied.succeeded).to_equal(false)
        expect(denied.reason).to_contain("denies Probe")
        expect(denied.action).to_equal("probe.apply")

    it "should refuse probes once the owning session closes":
        # @req REQ-010
        val session = open_with_target(debug_policy_development_v1())
        central_debug_service_v1_close(session).unwrap()
        match central_debug_service_v1_apply_probe(session, DebugProbeKindV1.Stop, "t0", "main.spl:10", DebugPerturbationV1.Stopping, 0):
            case Ok(_): fail("probe on closed session must be rejected")
            case Err(reason): expect(reason).to_contain("unknown or closed session")

describe "DebugServiceV1 evidence lifecycle":
    it "should bind valid evidence to the exact session build and preserve its digest":
        # @req REQ-010
        step("Export one typed artifact from a development session")
        val session = open_with_target(debug_policy_development_v1())
        val artifact = DebugEvidenceArtifactV1("raw/core", "application/x-core", "sha256:abc123", true, "restricted")
        val manifest = central_debug_service_v1_export_evidence(session, 42, [artifact]).unwrap()
        expect(manifest.build_id).to_equal("sha256:probe-build")
        expect(manifest.session_id.value).to_equal(session.value)
        expect(manifest.captured_at_ns).to_equal(42)
        expect(manifest.artifacts.len()).to_equal(1)
        expect(manifest.artifacts[0].digest).to_equal("sha256:abc123")

    it "should reject a missing digest and receipt the failed export as denied":
        # @req REQ-011
        step("Export an artifact without a digest")
        val session = open_with_target(debug_policy_development_v1())
        val artifact = DebugEvidenceArtifactV1("raw/core", "application/x-core", "", true, "restricted")
        match central_debug_service_v1_export_evidence(session, 42, [artifact]):
            case Ok(_): fail("evidence without a digest must be rejected")
            case Err(reason): expect(reason).to_contain("path and digest")
        val receipts = central_debug_service_v1_receipts(session)
        val last = receipts[receipts.len() - 1]
        expect(last.action).to_equal("evidence.export")
        expect(last.allowed).to_equal(false)
