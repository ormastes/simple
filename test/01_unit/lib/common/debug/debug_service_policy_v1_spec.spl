# codex-system-test
# @req REQ-008 REQ-009 REQ-010 REQ-011
"""Focused temporal policy and evidence admission tests for DebugServiceV1."""

use std.spec.*
use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugCapabilityV1, DebugVerificationV1, DebugPerturbationV1,
    DebugProbeKindV1, DebugEvidenceArtifactV1, DebugTargetNodeV1,
    DebugAuthorizationContextV1, DebugRootOperationV1, debug_policy_development_v1,
}
use std.common.debug.service_v1.{DebugServiceV1}

fn session_or_fail(result: Result<DebugSessionId, text>) -> DebugSessionId:
    match result:
        case Ok(value): value
        case Err(reason): fail("session rejected: {reason}")

fn authorization_context(now_ns: i64) -> DebugAuthorizationContextV1:
    DebugAuthorizationContextV1(now_ns: now_ns, environment: "development", privilege: "debug")

fn add_target(service: DebugServiceV1, session_id: DebugSessionId):
    match service.add_target(session_id, DebugTargetNodeV1(target_id: "host", parent_target_id: "", kind: "host", label: "Host"), DebugCapabilityV1(target_id: "host", support: CapLevel.Native, verification: DebugVerificationV1.FixtureVerified, perturbation: DebugPerturbationV1.Passive, reason: "fixture")):
        case Ok(_): pass_do_nothing("target added")
        case Err(reason): fail("target rejected: {reason}")

describe "DebugServiceV1 temporal policy":
    it "should preserve caller time and expire TTL without overflowing":
        var policy = debug_policy_development_v1()
        policy.ttl_ms = 10
        val service = DebugServiceV1.create()
        val session_id = session_or_fail(service.open_session_at("build-time", policy, 1000000000))
        val accepted = service.authorize_with_context(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "inspect.before", authorization_context(1009000000))
        expect(accepted.allowed).to_equal(true)
        expect(accepted.timestamp_ns).to_equal(1009000000)
        val denied = service.authorize_with_context(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "inspect.after", authorization_context(1010000000))
        expect(denied.allowed).to_equal(false)
        expect(denied.reason).to_equal("debug session policy expired")
        expect(denied.timestamp_ns).to_equal(1010000000)

    it "should enforce a rolling-minute rate window":
        var policy = debug_policy_development_v1()
        policy.ttl_ms = -1
        policy.rate_limit_per_minute = 1
        val service = DebugServiceV1.create()
        val session_id = session_or_fail(service.open_session_at("build-rate", policy, 0))
        expect(service.authorize_with_context(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "first", authorization_context(100)).allowed).to_equal(true)
        expect(service.authorize_with_context(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "limited", authorization_context(200)).allowed).to_equal(false)
        expect(service.authorize_with_context(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "next-window", authorization_context(60000000100)).allowed).to_equal(true)

describe "DebugServiceV1 temporal probe and evidence lifecycle":
    it "should reject already-expired probes and hide probes after expiry":
        val service = DebugServiceV1.create()
        val session_id = session_or_fail(service.open_session_at("build-probe-time", debug_policy_development_v1(), 0))
        add_target(service, session_id)
        match service.apply_probe_with_context(session_id, DebugProbeKindV1.Log, "host", "main:1", DebugPerturbationV1.Cooperative, 100, authorization_context(100)):
            case Ok(_): fail("expired probe accepted")
            case Err(reason): expect(reason).to_equal("debug probe expiry must be in the future")
        match service.apply_probe_with_context(session_id, DebugProbeKindV1.Log, "host", "main:2", DebugPerturbationV1.Cooperative, 200, authorization_context(100)):
            case Ok(_): pass_do_nothing("future probe accepted")
            case Err(reason): fail("future probe rejected: {reason}")
        expect(service.probes_for_at(session_id, 199).len()).to_equal(1)
        expect(service.probes_for_at(session_id, 200).len()).to_equal(0)

    it "should deny stale or explicitly unredacted evidence with timed receipts":
        var policy = debug_policy_development_v1()
        policy.ttl_ms = -1
        policy.retention_ms = 10
        val service = DebugServiceV1.create()
        val session_id = session_or_fail(service.open_session_at("build-evidence-policy", policy, 0))
        val unredacted = DebugEvidenceArtifactV1(path: "raw/memory", media_type: "application/octet-stream", digest: "sha256:1", native: true, privacy_label: "unredacted")
        match service.export_evidence_with_context(session_id, 10000000, [unredacted], authorization_context(10000000)):
            case Ok(_): fail("unredacted evidence accepted")
            case Err(reason): expect(reason).to_equal("unredacted evidence denied by policy")
        val restricted = DebugEvidenceArtifactV1(path: "raw/core", media_type: "application/x-core", digest: "sha256:2", native: true, privacy_label: "restricted")
        match service.export_evidence_with_context(session_id, 0, [restricted], authorization_context(11000000)):
            case Ok(_): fail("stale evidence accepted")
            case Err(reason): expect(reason).to_equal("evidence exceeds retention policy")
        val receipts = service.receipts_for(session_id)
        expect(receipts[receipts.len() - 1].timestamp_ns).to_equal(11000000)
