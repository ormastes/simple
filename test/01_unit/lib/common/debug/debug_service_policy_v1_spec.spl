# codex-system-test
"""
## Purpose and audience

Temporal-policy and evidence-admission contract for the central debug
service: caller-supplied time is preserved on receipts (no wall-clock reads),
TTL expiry denies authorization without overflowing, a rolling one-minute
rate window throttles repeat operations, expired probes are rejected and then
hidden, and stale or explicitly unredacted evidence is denied with timed
receipts. Written for the debug-service owner; the surface under test is
`DebugServiceV1` in `std.common.debug.service_v1` and the policy fields in
`contracts_v1`.

## Operator workflow

Run one spec: `bin/simple test test/01_unit/lib/common/debug/debug_service_policy_v1_spec.spl`.

## Compatibility and limitations

These scenarios were absence tripwires while the temporal API was only
drafted; they now run against the shipped `DebugServiceV1`.

## Verification guidance and troubleshooting

Any failure is a genuine regression in `std.common.debug.service_v1`.
"""
# @manual_section: debug-service-temporal-policy

use std.spec.*
use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugCapabilityV1, DebugVerificationV1, DebugPerturbationV1, DebugTargetNodeV1,
    DebugProbeKindV1, DebugRootOperationV1, DebugEvidenceArtifactV1,
    DebugAuthorizationContextV1, DebugSessionId,
}
use std.common.debug.service_v1.{
    DebugServiceV1, debug_policy_development_v1, debug_policy_observe_only_v1,
}

fn context_at(now_ns: i64) -> DebugAuthorizationContextV1:
    DebugAuthorizationContextV1(now_ns: now_ns, environment: "development", privilege: "debug")

fn add_host_target(service: DebugServiceV1, session: DebugSessionId):
    service.add_target(
        session,
        DebugTargetNodeV1("t0", "", "process", "target zero"),
        DebugCapabilityV1("t0", CapLevel.Native, DebugVerificationV1.LiveVerified, DebugPerturbationV1.Cooperative, "reachable"),
    ).unwrap()

describe "DebugServiceV1 temporal policy":
    it "should preserve caller time and expire TTL without overflowing":
        # @req REQ-008
        step("Open a session at t=0 under a 1 ms TTL policy")
        expect(debug_policy_development_v1().name).to_equal("development")
        var policy = debug_policy_development_v1()
        policy.ttl_ms = 1
        var service = DebugServiceV1.create()
        val session = service.open_session_at("build-ttl", policy, 0).unwrap()
        val early = service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "inspect.early", 500000)
        expect(early.allowed).to_equal(true)
        expect(early.captured_at_ns).to_equal(500000)
        step("Authorize after the TTL, including a near-i64-max clock")
        val late = service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "inspect.late", 2000000)
        expect(late.allowed).to_equal(false)
        expect(late.reason).to_equal("debug session policy expired")
        val huge = service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "inspect.huge", 9000000000000000000)
        expect(huge.allowed).to_equal(false)

    it "should enforce a rolling-minute rate window":
        # @req REQ-009
        step("Allow two actions per minute, deny the third, allow again after the window")
        expect(debug_policy_observe_only_v1().name).to_equal("observe-only")
        var policy = debug_policy_development_v1()
        policy.rate_limit_per_minute = 2
        var service = DebugServiceV1.create()
        val session = service.open_session("build-rate", policy).unwrap()
        val sec = 1000000000
        expect(service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "a", 1 * sec).allowed).to_equal(true)
        expect(service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "b", 2 * sec).allowed).to_equal(true)
        val throttled = service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "c", 3 * sec)
        expect(throttled.allowed).to_equal(false)
        expect(throttled.reason).to_equal("debug session rate limit exceeded")
        expect(service.authorize_at(session, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "d", 70 * sec).allowed).to_equal(true)

describe "DebugServiceV1 temporal probe and evidence lifecycle":
    it "should reject already-expired probes and hide probes after expiry":
        # @req REQ-010
        step("Apply a probe that expires at t=100 ns, then read it at t=200 ns")
        var service = DebugServiceV1.create()
        val session = service.open_session("build-probe-ttl", debug_policy_development_v1()).unwrap()
        add_host_target(service, session)
        match service.apply_probe_with_context(session, DebugProbeKindV1.Stop, "t0", "main.spl:1", DebugPerturbationV1.Stopping, 50, context_at(50)):
            case Ok(_): fail("probe expiring at the current time must be rejected")
            case Err(reason): expect(reason).to_equal("debug probe expiry must be in the future")
        val probe = service.apply_probe_with_context(session, DebugProbeKindV1.Stop, "t0", "main.spl:1", DebugPerturbationV1.Stopping, 100, context_at(10)).unwrap()
        expect(service.probes_for_at(session, 50).len()).to_equal(1)
        expect(service.probes_for_at(session, 200).len()).to_equal(0)
        val expired = service.receipts_for(session).filter(\r: r.action == "probe.expire")
        expect(expired.len()).to_equal(1)
        expect(probe.session_id).to_equal(session.value)

    it "should deny stale or explicitly unredacted evidence with timed receipts":
        # @req REQ-011
        step("Export stale evidence under a 1 ms retention policy")
        var policy = debug_policy_development_v1()
        policy.retention_ms = 1
        var service = DebugServiceV1.create()
        val session = service.open_session("build-evidence-ttl", policy).unwrap()
        val artifact = DebugEvidenceArtifactV1("raw/core", "application/x-core", "sha256:abc", true, "restricted")
        match service.export_evidence_with_context(session, 0, [artifact], context_at(5000000)):
            case Ok(_): fail("stale evidence must be denied")
            case Err(reason): expect(reason).to_equal("evidence exceeds retention policy")
        step("Export explicitly unredacted evidence under a redacting policy")
        val raw = DebugEvidenceArtifactV1("raw/core", "application/x-core", "sha256:abc", true, "unredacted")
        match service.export_evidence_with_context(session, 4999999, [raw], context_at(5000000)):
            case Ok(_): fail("unredacted evidence must be denied")
            case Err(reason): expect(reason).to_equal("unredacted evidence denied by policy")
        val denied = service.receipts_for(session).filter(\r: r.action == "evidence.export" and not r.allowed)
        expect(denied.len()).to_equal(2)
        expect(denied[0].captured_at_ns).to_equal(5000000)
