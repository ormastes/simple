# stable_order_by_key — the shared ordering primitive
#
# Returns a PERMUTATION of indices in ascending key order, preserving input
# order among equal keys. It exists so that callers sorting different record
# types by an integer key share one implementation: Simple has no
# closure-taking generic sort, so before this there were three hand-rolled
# insertion sorts in the linker alone (ELF output-section rank, COFF
# output-section rank, PE base-relocation RVA).
#
# @cover src/lib/common/algorithm_utils.spl

use std.common.algorithm_utils.{stable_order_by_key}

fn apply_order(vals: [text], keys: [i64]) -> [text]:
    var out: [text] = []
    for idx in stable_order_by_key(keys):
        out = out.push(vals[idx])
    out

describe "stable_order_by_key - ordering":
    it "returns indices in ascending key order":
        expect(stable_order_by_key([3, 1, 2])).to_equal([1, 2, 0])
        expect(stable_order_by_key([0, 1, 2, 3])).to_equal([0, 1, 2, 3])
        expect(stable_order_by_key([3, 2, 1, 0])).to_equal([3, 2, 1, 0])

    it "is STABLE: equal keys keep their input order":
        # The property every caller depends on — two output sections of the
        # same rank, or two base relocations on the same RVA, must not swap.
        expect(stable_order_by_key([2, 1, 2, 1, 0])).to_equal([4, 1, 3, 0, 2])
        expect(apply_order(["a", "b", "c", "d"], [1, 0, 1, 0])).to_equal(["b", "d", "a", "c"])

    it "handles empty and single-element inputs":
        expect(stable_order_by_key([])).to_equal([])
        expect(stable_order_by_key([7])).to_equal([0])

    it "handles negative keys and duplicates of the same key":
        expect(stable_order_by_key([-1, -5, 0, -5])).to_equal([1, 3, 0, 2])
        expect(stable_order_by_key([4, 4, 4])).to_equal([0, 1, 2])

    it "returns a true permutation: every index exactly once":
        val order = stable_order_by_key([5, 3, 5, 1, 3, 9])
        expect(order.len()).to_equal(6)
        var seen: {i64: bool} = {}
        for i in order:
            expect(seen.has(i)).to_equal(false)
            seen[i] = true
        expect(seen.keys().len()).to_equal(6)

    it "orders by the key, never by the value being permuted":
        # Descending values under ascending keys must come out descending.
        expect(apply_order(["z", "y", "x"], [0, 1, 2])).to_equal(["z", "y", "x"])
        expect(apply_order(["z", "y", "x"], [2, 1, 0])).to_equal(["x", "y", "z"])
