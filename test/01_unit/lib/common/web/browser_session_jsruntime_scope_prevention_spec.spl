use std.spec.*
use std.gc_async_mut.web.browser_session.*
use std.js.types.js_types.{JsValue}

# Repro + prevention for r16 g14: BrowserSession imports JsRuntime explicitly
# from std.common.js.engine.runtime, yet the seed's class-scope resolver
# (module_cache.rs resolve_class_in_scope) reported
# "ambiguous type `JsRuntime`" because common/ and nogc_sync_mut/ both declare it.
# Every browser_session*_spec failed at BrowserSession.new()/open_html.
describe "BrowserSession JsRuntime scope resolution":
    it "constructs a session and evaluates a script without an ambiguous-type error":
        var session = BrowserSession.new()
        val opened = session.open_html(
            "https://safe.test/app", "<html><body>safe</body></html>"
        )
        expect(opened.is_ok()).to_be(true)
        match session.eval_script("1 + 2"):
            Ok(JsValue.Number(n)):
                expect(n).to_equal(3.0)
            _:
                fail("Expected eval_script to run on the explicitly imported JsRuntime")

    it "bounds a hostile do-while loop (iteration budget)":
        var session = BrowserSession.new()
        val opened = session.open_html(
            "https://safe.test/app", "<html><body>safe</body></html>"
        )
        expect(opened.is_ok()).to_be(true)
        val exhausted = session.eval_script(
            "var iterations = 0; do { iterations = iterations + 1; } while (true);"
        )
        expect(exhausted.is_ok()).to_be(true)
        match session.eval_script("iterations"):
            Ok(JsValue.Number(iterations)):
                expect(iterations).to_be_greater_than(0.0)
                expect(iterations).to_be_less_than(100000.0)
            _:
                fail("Expected the do-while execution limit to terminate the script")
