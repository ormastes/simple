# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
"""
BrowserSession HTML title/body extraction index-space contract.

`extract_title_text` / `extract_body_inner_html` position with BYTE scanners
(text_to_bytes / find_text) and must therefore cut with the byte-offset family
(substring / byte_len). Slicing with `html[a:b]` — the codepoint family per
ADR-005 — over-ran by one codepoint on any text carrying a multi-byte
codepoint and swallowed the '<' of the closing tag ("Case İ<"). ASCII input
cannot see the defect, so every fixture carries a multi-byte codepoint.
"""
# @req REQ-SSPEC-LIB
# @cover src/lib/gc_async_mut/web/browser_session_html.spl 1%
use std.spec.*

use std.gc_async_mut.web.browser_session_html.{
    extract_title_text, extract_body_inner_html
}

describe "BrowserSession HTML title/body extraction byte offsets":
    it "extracts a title ending in a two-byte codepoint without swallowing the closing tag":
        # @req REQ-SSPEC-LIB
        step("extracts a title ending in a two-byte codepoint without swallowing the closing tag")
        expect(extract_title_text(
            "<HTML><HEAD><TITLE>Case İ</TITLE></HEAD><BODY></BODY></HTML>"
        )).to_equal("Case İ")

    it "extracts a title containing a three-byte codepoint":
        # @req REQ-SSPEC-LIB
        step("extracts a title containing a three-byte codepoint")
        expect(extract_title_text(
            "<head><title>A—B test</title></head>"
        )).to_equal("A—B test")

    it "extracts body inner html with multi-byte text before the closing tag":
        # @req REQ-SSPEC-LIB
        step("extracts body inner html with multi-byte text before the closing tag")
        expect(extract_body_inner_html(
            "<html><body><p>İş</p></body></html>"
        )).to_equal("<p>İş</p>")

    it "extracts body inner html past a multi-byte codepoint when the closing tag is absent":
        # @req REQ-SSPEC-LIB
        step("extracts body inner html past a multi-byte codepoint when the closing tag is absent")
        expect(extract_body_inner_html(
            "<html><body>ab İ"
        )).to_equal("ab İ")
