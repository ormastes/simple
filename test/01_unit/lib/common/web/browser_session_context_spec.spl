use std.spec.*

use std.gc_async_mut.web.browser_session_context.{
    browser_session_is_loopback_http, browser_session_is_secure_context,
    browser_meta_content_security_policy
}

describe "BrowserSession secure context":

    it "trusts exact loopback hosts without trusting prefix spoofs":
        expect(browser_session_is_loopback_http(
            "http://localhost:8080/app"
        )).to_equal(true)
        expect(browser_session_is_loopback_http(
            "http://127.0.0.1/app"
        )).to_equal(true)
        expect(browser_session_is_loopback_http(
            "http://localhost.evil/app"
        )).to_equal(false)
        expect(browser_session_is_loopback_http(
            "http://127.0.0.1.evil/app"
        )).to_equal(false)
        expect(browser_session_is_secure_context(
            "http://localhost.evil/app"
        )).to_equal(false)

    # @req REQ-WEB-BROWSER-012
    it "ignores directives forbidden in meta CSP":
        expect(browser_meta_content_security_policy(
            "sandbox allow-scripts; frame-ancestors 'none'; report-uri /r; default-src 'self'"
        )).to_equal("default-src 'self'")
