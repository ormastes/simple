# codex-system-test
# @req REQ-WEB-BROWSER-002
"""
# BrowserSession HTML ruby text projection

Projects the supported ruby annotation semantics to visible text. This is
focused text-projection evidence, not ruby layout or typography evidence.
"""
use std.spec.*

use std.gc_async_mut.web.browser_session_html.{html_to_text}

describe "BrowserSession HTML ruby tag text semantics":

    it "should project ruby annotations without duplicating rp fallback markers":
        # @req: REQ-WEB-BROWSER-002
        step("Verify: should project ruby annotations without duplicating rp fallback markers")
        step("Project supported HTML semantics to visible text")
        val html = "<ruby>漢<rp>(</rp><rt>kan</rt><rp>)</rp></ruby>"
        expect(html_to_text(html)).to_equal("漢(kan)")

    it "should keep adjacent ruby annotations readable without rp fallback tags":
        # @req: REQ-LIB-COMMON-WEB-001
        step("Verify: should keep adjacent ruby annotations readable without rp fallback tags")
        step("Project supported HTML semantics to visible text")
        val html = "<ruby>東<rt>east</rt></ruby><ruby>京<rt>capital</rt></ruby>"
        expect(html_to_text(html)).to_equal("東(east)京(capital)")
