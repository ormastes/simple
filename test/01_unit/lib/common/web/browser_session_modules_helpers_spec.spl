"""
## Purpose and audience
Purpose: Prove that BrowserSession module helpers.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}

use std.gc_async_mut.web.browser_session_modules_helpers.*

describe "BrowserSession module helpers":

    it "splits module statements across quoted semicolons and block exports":
        step("Verify: splits module statements across quoted semicolons and block exports")
        # @req: REQ-LIB-COMMON-001
        val source = "import def, { named as alias, other } from './dep.js';\nexport default function demo() { return 'a;b'; }\nexport const one = 1, two = call([1, 2]);"

        val statements = split_module_statements(source)

        expect(statements.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(statements[0]).to_equal("import def, { named as alias, other } from './dep.js';")
        expect(statements[1]).to_equal("export default function demo() { return 'a;b'; }")
        expect(statements[2]).to_equal("export const one = 1, two = call([1, 2]);")

    it "splits import bindings and export declarators at top-level commas only":
        step("Verify: splits import bindings and export declarators at top-level commas only")
        val bindings = split_import_bindings("def, { named as alias, other }")
        val declarators = split_export_binding_declarators("one = 1, two = call([1, 2]), three = ['a,b']")

        expect(bindings.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(bindings[0].trim()).to_equal("def")
        expect(bindings[1].trim()).to_equal("{ named as alias, other }")
        expect(declarators.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(declarators[0].trim()).to_equal("one = 1")
        expect(declarators[1].trim()).to_equal("two = call([1, 2])")
        expect(declarators[2].trim()).to_equal("three = ['a,b']")

    it "splits generic text using repeated delimiters without dropping trailing parts":
        step("Verify: splits generic text using repeated delimiters without dropping trailing parts")
        val parts = split_text("alpha::beta::", "::")

        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(parts[0]).to_equal("alpha")
        expect(parts[1]).to_equal("beta")
        expect(parts[2]).to_equal("")

    it "removes only the first matching text item":
        step("Verify: removes only the first matching text item")
        val parts = remove_text_once(["alpha", "beta", "beta", "gamma"], "beta")
        val unchanged = remove_text_once(["alpha", "gamma"], "beta")

        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(parts[0]).to_equal("alpha")
        expect(parts[1]).to_equal("beta")
        expect(parts[2]).to_equal("gamma")
        expect(unchanged.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(unchanged[0]).to_equal("alpha")
        expect(unchanged[1]).to_equal("gamma")
