# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# codex-system-test
# @req REQ-SSPEC-LIB
"""
# BrowserSession HTML table text projection

Projects supported caption, row, and cell boundaries to visible text. This is
not table layout, Draw IR, or pixel evidence.
"""
use std.spec.step

use std.spec.*

use std.gc_async_mut.web.browser_session_html.{html_to_text}

describe "BrowserSession HTML table tag text semantics":
    # @manual scenario evidence

    it "should preserve caption row and cell boundaries for table text":
        # @req REQ-SSPEC-LIB
        step("should preserve caption row and cell boundaries for table text")
        step("Project supported HTML semantics to visible text")
        val html = "<table><caption>Scores</caption><colgroup><col></colgroup><thead><tr><th>Name</th><th>Score</th></tr></thead><tbody><tr><td>Ada</td><td>10</td></tr></tbody><tfoot><tr><td>Total</td><td>10</td></tr></tfoot></table>"
        expect(html_to_text(html)).to_equal("Scores\nName\tScore\nAda\t10\nTotal\t10")
