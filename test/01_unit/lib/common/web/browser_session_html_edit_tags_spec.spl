# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# codex-system-test
# @req REQ-SSPEC-LIB
"""
# BrowserSession HTML edit text projection

Projects the supported `del` and `ins` semantics to visible text. This is
focused text-projection evidence, not complete HTML parsing or rendering.
"""
use std.spec.step

use std.spec.*

use std.gc_async_mut.web.browser_session_html.{html_to_text}

describe "BrowserSession HTML edit tag text semantics":

    it "should mark inserted and deleted text in plain text extraction":
        # @req REQ-SSPEC-LIB
        step("should mark inserted and deleted text in plain text extraction")
        step("Project supported HTML semantics to visible text")
        val html = "<p>Before <del cite='/old'>old</del><ins datetime='2026-06-06'>new</ins> after</p>"
        expect(html_to_text(html)).to_equal("Before [-old][+new] after")

    it "should keep nested inline text inside edit annotations":
        # @req REQ-SSPEC-LIB
        step("should keep nested inline text inside edit annotations")
        step("Project supported HTML semantics to visible text")
        val html = "<del><strong>removed</strong> text</del><ins><em>added</em> text</ins>"
        expect(html_to_text(html)).to_equal("[-removed text][+added text]")
