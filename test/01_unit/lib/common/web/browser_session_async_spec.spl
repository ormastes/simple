use std.spec.*
use std.gc_async_mut.web.browser_session.{BrowserSession, BrowserResponse}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*
use std.js.types.js_types.{JsValue}

fn _display_js(v: JsValue) -> text:
    match v:
        JsValue.Undefined: "undefined"
        JsValue.Null: "null"
        JsValue.Boolean(b): if b: "true" else: "false"
        JsValue.Number(n):
            var s = "{n}"
            if s.ends_with(".0"):
                s = s.slice(0, s.len() - 2)
            s
        JsValue.String(s): s
        JsValue.Object(id): "[object Object]"
        JsValue.Array(id): "[object Array]"
        JsValue.Function(id): "[Function]"
        JsValue.Symbol(id): "Symbol()"

fn _commit_next_fetch(
    session: BrowserSession, expected_url: text, headers: text, body: text
):
    match session.take_pending_request():
        Some(request):
            expect(request.url).to_equal(expected_url)
            val committed = session.commit_network_response(
                BrowserResponse.create(
                    request_id: request.id,
                    kind: "fetch",
                    url: request.url,
                    status: 200,
                    headers: headers,
                    body: body,
                    error: ""
                )
            )
            match committed:
                Ok(_): expect(request.kind).to_equal("fetch")
                Err(e): fail("Expected fetch response commit to succeed: {e}")
        nil:
            fail("Expected pending fetch request for {expected_url}")

describe "BrowserSession async fetch":

    it "adopts promises returned from then callbacks":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var out = 'start'; Promise.resolve('seed').then(function() { return Promise.resolve('inner'); }).then(function(v) { out = v; });</script></body></html>"
        )

        val result = session.eval_script("out")
        match result:
            Ok(value) =>
                expect(_display_js(value)).to_equal("inner")
            Err(e) =>
                fail("Expected adopted promise return value to evaluate: {e}")

    it "adopts rejected promises returned from then callbacks":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var out = 'start'; Promise.resolve('seed').then(function() { return Promise.reject('boom'); }).catch(function(err) { out = err; });</script></body></html>"
        )

        val result = session.eval_script("out")
        match result:
            Ok(value) =>
                expect(_display_js(value)).to_equal("boom")
            Err(e) =>
                fail("Expected adopted rejected promise callback to evaluate: {e}")

    it "installs promise globals":
        var session = BrowserSession.new()
        session.open_html("https://example.com/app", "<html><body>Ready</body></html>")
        val result = session.eval_script("typeof Promise.resolve + ':' + typeof Promise.prototype.then")
        match result:
            Ok(value) =>
                expect(_display_js(value)).to_equal("function:function")
            Err(e) =>
                fail("Expected Promise globals to evaluate: {e}")

    it "queues a pending fetch and settles it later":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var out = ''; window.fetch('/data.txt').then(function(r) { return r.text(); }).then(function(t) { out = t; document.body.textContent = t; });</script></body></html>"
        )

        match session.take_pending_request():
            Some(request) =>
                expect(request.kind).to_equal("fetch")
                expect(request.url).to_equal("https://example.com/data.txt")
                val commit_result = session.commit_network_response(BrowserResponse.create(
                    request_id: request.id,
                    kind: "fetch",
                    url: request.url,
                    status: 200,
                    headers: "Set-Cookie: token=abc; Path=/\n",
                    body: "alpha",
                    error: ""
                ))
                match commit_result:
                    Ok(_) =>
                        val out_result = session.eval_script("out + ':' + document.body.textContent + ':' + document.cookie")
                        match out_result:
                            Ok(value) =>
                                expect(_display_js(value)).to_contain("alpha:alpha")
                                expect(_display_js(value)).to_contain("token=abc")
                            Err(e) =>
                                fail("Expected settled fetch output and cookie to evaluate: {e}")
                    Err(e) =>
                        fail("Expected network response commit for pending fetch to succeed: {e}")
            nil:
                fail("Expected pending fetch request after fetch setup")

    it "rejects queued and inflight fetches when navigation is canceled":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body>Old page<script>var canceled = ''; var cancelCount = 0; fetch('/slow-a').catch(function(e) { canceled = canceled + e; cancelCount = cancelCount + 1; fetch('/during-cancel'); }); fetch('/slow-b').catch(function(e) { canceled = canceled + ':' + e; cancelCount = cancelCount + 1; });</script></body></html>"
        )

        val old_request = session.take_pending_request()
        match old_request:
            Some(request): expect(request.kind).to_equal("fetch")
            nil: fail("Expected one old fetch request to become inflight")
        val nav = session.begin_network_navigation(
            "https://example.com/next", "GET", "", "", ""
        )
        expect(nav.is_ok()).to_equal(true)
        val document_request = session.take_pending_request()
        match document_request:
            Some(request):
                expect(request.kind).to_equal("document")
            nil:
                fail("Expected replacement document request")
        val cancellation_request = session.take_pending_request()
        match cancellation_request:
            Some(request):
                expect(request.url).to_equal(
                    "https://example.com/during-cancel"
                )
            nil:
                fail("Expected cancellation callback fetch to be pumped")
        session.stop_loading()
        expect(session.current_url).to_equal("https://example.com/app")
        expect(session.current_body_html).to_contain("Old page")

        match session.eval_script("cancelCount + ':' + canceled"):
            Ok(value):
                expect(_display_js(value)).to_equal(
                    "2:navigation-canceled:navigation-canceled"
                )
            Err(e):
                fail("Expected canceled fetch handlers to run once: {e}")
        match cancellation_request:
            Some(request):
                val late = session.commit_network_response(
                    BrowserResponse.create(
                        request_id: request.id,
                        kind: request.kind,
                        url: request.url,
                        status: 200,
                        headers: "",
                        body: "late",
                        error: ""
                    )
                )
                match late:
                    Err(e):
                        expect(e).to_equal(
                            "unknown or canceled request: {request.id}"
                        )
                    Ok(_): fail("Expected late canceled response to fail")
            nil:
                fail("Expected cancellation callback fetch to become inflight")

        val queued = session.eval_script(
            "var recovered = 'pending'; fetch('/after').then(function(r) { return r.text(); }).then(function(t) { recovered = t; }); 'queued'"
        )
        expect(queued.is_ok()).to_equal(true)
        match session.take_pending_request():
            Some(request):
                expect(request.url).to_equal("https://example.com/after")
                val committed = session.commit_network_response(
                    BrowserResponse.create(
                        request_id: request.id,
                        kind: request.kind,
                        url: request.url,
                        status: 200,
                        headers: "",
                        body: "ok",
                        error: ""
                    )
                )
                expect(committed.is_ok()).to_equal(true)
            nil:
                fail("Expected fetch after stopped navigation")
        match session.eval_script("recovered"):
            Ok(value): expect(_display_js(value)).to_equal("ok")
            Err(e): fail("Expected post-cancel fetch to settle: {e}")

    it "rejects a late old-page response without consuming the new fetch":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/old",
            "<html><body><script>fetch('/same')</script></body></html>"
        )
        val old_request = session.take_pending_request()

        val started = session.begin_network_navigation(
            "https://example.com/new", "GET", "", "", ""
        )
        expect(started.is_ok()).to_be(true)
        match session.take_pending_request():
            Some(document_request):
                val committed = session.commit_network_response(
                    BrowserResponse.create(
                        request_id: document_request.id,
                        kind: document_request.kind,
                        url: document_request.url,
                        status: 200,
                        headers: "",
                        body: "<html><body><script>var outcome = 'pending'; fetch('/same').then(function(r) { return r.text(); }).then(function(t) { outcome = t; });</script></body></html>",
                        error: ""
                    )
                )
                expect(committed.is_ok()).to_be(true)
            nil:
                fail("Expected replacement document request")

        val new_request = session.take_pending_request()
        match old_request:
            Some(old_fetch):
                expect(old_fetch.id).to_equal("fetch-1")
                match new_request:
                    Some(new_fetch):
                        # Request ids are "{kind}-{seq}" on ONE per-session sequence: the old

                        # page took fetch-1, the replacement document request took document-2,

                        # so the new page's fetch is fetch-3 (it was never "fetch-2").

                        expect(new_fetch.id).to_equal("fetch-3")
                        expect(new_fetch.url).to_equal(old_fetch.url)
                        val late = session.commit_network_response(
                            BrowserResponse.create(
                                request_id: old_fetch.id,
                                kind: old_fetch.kind,
                                url: old_fetch.url,
                                status: 200,
                                headers: "Set-Cookie: stale=yes; Path=/\nStrict-Transport-Security: max-age=3600",
                                body: "stale",
                                error: ""
                            )
                        )
                        match late:
                            Err(e):
                                expect(e).to_equal(
                                    "unknown or canceled request: {old_fetch.id}"
                                )
                            Ok(_):
                                fail("Expected stale old-page response rejection")
                        expect(session.cookies.count()).to_equal(0)
                        expect(session.hsts_policies.len()).to_equal(0)
                        expect(session.has_inflight_request(new_fetch)).to_be(true)
                        val fresh = session.commit_network_response(
                            BrowserResponse.create(
                                request_id: new_fetch.id,
                                kind: new_fetch.kind,
                                url: new_fetch.url,
                                status: 200,
                                headers: "",
                                body: "fresh",
                                error: ""
                            )
                        )
                        expect(fresh.is_ok()).to_be(true)
                    nil:
                        fail("Expected new-page fetch request")
            nil:
                fail("Expected old-page fetch request")
        match session.eval_script("outcome"):
            Ok(value): expect(_display_js(value)).to_equal("fresh")
            Err(e): fail("Expected only the new response to settle: {e}")

    it "rejects promise callbacks on transport error":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var out = 'start'; window.fetch('/data.txt').catch(function(err) { out = err; });</script></body></html>"
        )

        match session.take_pending_request():
            Some(request) =>
                val commit_result = session.commit_network_response(BrowserResponse.create(
                    request_id: request.id,
                    kind: "fetch",
                    url: request.url,
                    status: 0,
                    headers: "",
                    body: "",
                    error: "network down"
                ))
                match commit_result:
                    Err(e) =>
                        expect(e).to_equal("network down")
                        val result = session.eval_script("out")
                        match result:
                            Ok(value) =>
                                expect(_display_js(value)).to_equal("network down")
                            Err(err) =>
                                fail("Expected transport rejection callback output to evaluate: {err}")
                    Ok(_) =>
                        fail("Expected transport-error commit to reject")
            nil:
                fail("Expected pending fetch request for transport-error path")

    it "resolves http error responses with ok false and readable metadata":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var meta = 'start'; window.fetch('/missing.txt').then(function(r) { meta = r.status + ':' + r.ok + ':' + r.headersText + ':' + r.text() + ':' + r.text(); document.body.textContent = meta; });</script></body></html>"
        )

        match session.take_pending_request():
            Some(request) =>
                val commit_result = session.commit_network_response(BrowserResponse.create(
                    request_id: request.id,
                    kind: "fetch",
                    url: request.url,
                    status: 404,
                    headers: "X-Test: missing\n",
                    body: "missing",
                    error: ""
                ))
                match commit_result:
                    Ok(_) =>
                        val result = session.eval_script("meta + ':' + document.body.textContent")
                        match result:
                            Ok(value) =>
                                expect(_display_js(value)).to_equal("404:false:X-Test: missing\n:missing:[object Object]:404:false:X-Test: missing\n:missing:[object Object]")
                            Err(e) =>
                                fail("Expected HTTP error response metadata output to evaluate: {e}")
                    Err(e) =>
                        fail("Expected HTTP error response commit to resolve: {e}")
            nil:
                fail("Expected pending fetch request for HTTP error response")

    it "exposes response.statusText for resolved fetch responses":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var meta = 'start'; window.fetch('/missing.txt').then(function(r) { meta = r.status + ':' + r.statusText + ':' + r.ok; document.body.textContent = meta; });</script></body></html>"
        )

        match session.take_pending_request():
            Some(request) =>
                val commit_result = session.commit_network_response(BrowserResponse.create(
                    request_id: request.id,
                    kind: "fetch",
                    url: request.url,
                    status: 404,
                    headers: "",
                    body: "missing",
                    error: ""
                ))
                match commit_result:
                    Ok(_) =>
                        val result = session.eval_script("meta + ':' + document.body.textContent")
                        match result:
                            Ok(value) =>
                                expect(_display_js(value)).to_equal("404:Not Found:false:404:Not Found:false")
                            Err(e) =>
                                fail("Expected response.statusText output to evaluate: {e}")
                    Err(e) =>
                        fail("Expected statusText response commit to resolve: {e}")
            nil:
                fail("Expected pending fetch request for statusText response")

    it "rejects compileStreaming when response content type is not application wasm":
        var session = BrowserSession.new()
        session.open_html(
            "https://example.com/app",
            "<html><body><script>var out = 'start'; WebAssembly.compileStreaming(window.fetch('/module.wasm')).then(function(m) { out = 'compiled'; }).catch(function(err) { out = err; });</script></body></html>"
        )

        match session.take_pending_request():
            Some(request) =>
                expect(request.url).to_equal("https://example.com/module.wasm")
                val commit_result = session.commit_network_response(BrowserResponse.create(
                    request_id: request.id,
                    kind: "fetch",
                    url: request.url,
                    status: 200,
                    headers: "Content-Type: text/plain\n",
                    body: "0061736d01000000",
                    error: ""
                ))
                match commit_result:
                    Ok(_) =>
                        val result = session.eval_script("out")
                        match result:
                            Ok(value) =>
                                expect(_display_js(value)).to_equal("unsupported-wasm-content-type:text/plain")
                            Err(e) =>
                                fail("Expected compileStreaming MIME rejection output to evaluate: {e}")
                    Err(e) =>
                        fail("Expected compileStreaming non-wasm response commit to settle: {e}")
            nil:
                fail("Expected pending fetch request for compileStreaming MIME check")

