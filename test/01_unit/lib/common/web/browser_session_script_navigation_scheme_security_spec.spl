# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/common/web/browser_session_script_navigation_scheme_security_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/browser_session_script_navigation_scheme_security_spec.md
# doc-path: doc/03_plan/sys_test/browser_session_script_navigation_scheme_security_spec.md
# doc-path: doc/04_architecture/browser_session_script_navigation_scheme_security_spec.md
# doc-path: doc/05_design/browser_session_script_navigation_scheme_security_spec_oracles.md
# @manual: primary

"""
BrowserSession script-navigation reference security.

Location and History API navigation share one strict URL-reference policy:
trusted explicit schemes stay explicit, relative references resolve against the
active document, and opaque or unknown schemes never mutate browser state.
"""

use std.spec.step

use std.spec.*

use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.js.types.js_types.{JsValue}


# codex-system-test
describe "BrowserSession script-navigation reference security":
    # @manual scenario evidence
    it "should share strict scheme and reference policy across location and history":
        # @req REQ-SSPEC-LIB
        step("should share strict scheme and reference policy across location and history")
        step("Commit stable sessions for blocked and valid controls")
        val stable_url = "https://stable.test/dir/page"
        val stable_html = (
            "<html><head><title>Stable</title></head>" +
            "<body>stable</body></html>"
        )
        var blocked_session = BrowserSession.new()
        var reference_session = BrowserSession.new()
        var history_session = BrowserSession.new()
        expect(blocked_session.open_html(
            stable_url, stable_html
        ).is_ok()).to_be(true)
        expect(reference_session.open_html(
            stable_url, stable_html
        ).is_ok()).to_be(true)
        expect(history_session.open_html(
            stable_url, stable_html
        ).is_ok()).to_be(true)

        step("Reject opaque unknown and cross-origin history targets")
        val blocked_urls = [
            "data:text/html,blocked",
            "javascript:alert(1)",
            "file:///etc/passwd",
            "custom:payload",
            "mailto:user@example.test",
            "unknown://host/path"
        ]
        for blocked_url in blocked_urls:
            expect(blocked_session.eval_script(
                "location.assign('" + blocked_url + "')"
            ).is_ok()).to_be(true)
            expect(blocked_session.eval_script(
                "history.pushState(1, '', '" + blocked_url + "')"
            ).is_ok()).to_be(true)
            expect(blocked_session.eval_script(
                "history.replaceState(2, '', '" + blocked_url + "')"
            ).is_ok()).to_be(true)
        expect(blocked_session.eval_script(
            "history.pushState(3, '', 'https://evil.test/x')"
        ).is_ok()).to_be(true)
        expect(blocked_session.eval_script(
            "history.replaceState(4, '', '//evil.test/y')"
        ).is_ok()).to_be(true)

        step("Preserve state proposals runtime values and network")
        expect(blocked_session.current_url).to_equal(stable_url)
        expect(blocked_session.document_url).to_equal(stable_url)
        expect(blocked_session.current_title).to_equal("Stable")
        expect(blocked_session.current_body_html).to_contain("stable")
        expect(blocked_session.history.len()).to_equal(1)
        expect(blocked_session.current_index).to_equal(0)
        expect(blocked_session.history_proposal_action).to_equal("")
        expect(blocked_session.history_proposal_url_kind).to_equal("")
        expect(blocked_session.history_proposal_raw_url).to_equal("")
        match blocked_session.eval_script("location.href"):
            Ok(JsValue.String(href)):
                expect(href).to_equal(stable_url)
            _:
                fail("Expected rejected navigation to restore runtime location")
        match blocked_session.eval_script("history.state === null"):
            Ok(JsValue.Boolean(is_null)):
                expect(is_null).to_be(true)
            _:
                fail("Expected rejected History API calls to preserve state")
        expect(blocked_session.warnings.join("|")).to_contain(
            "script navigation blocked: unsupported navigation scheme"
        )
        expect(blocked_session.warnings.join("|")).to_contain(
            "invalid history URL blocked"
        )
        expect(blocked_session.has_pending_requests()).to_be(false)
        expect(blocked_session.take_pending_request()).to_be_nil()
        expect(blocked_session.can_stop_loading()).to_be(false)

        step("Resolve valid references HTTPS history and traversal")
        val references = [
            "child", "next.html", "/root", "./leaf",
            "../up", "?q=1", "#frag", "//next.test/x"
        ]
        val expected_urls = [
            "https://stable.test/dir/child",
            "https://stable.test/dir/next.html",
            "https://stable.test/root",
            "https://stable.test/dir/leaf",
            "https://stable.test/up",
            "https://stable.test/dir/page?q=1",
            "https://stable.test/dir/page#frag",
            "https://next.test/x"
        ]
        var reference_index = 0
        while reference_index < references.len():
            expect(reference_session.eval_script(
                "location.assign('" + references[reference_index] + "')"
            ).is_ok()).to_be(true)
            expect(reference_session.current_url).to_equal(
                expected_urls[reference_index]
            )
            reference_index = reference_index + 1
        expect(reference_session.eval_script(
            "location.assign('https://next.test/final')"
        ).is_ok()).to_be(true)
        expect(reference_session.current_url).to_equal(
            "https://next.test/final"
        )
        expect(reference_session.history.len()).to_equal(10)
        expect(reference_session.has_pending_requests()).to_be(false)

        expect(history_session.eval_script(
            "history.pushState(1, '', 'child')"
        ).is_ok()).to_be(true)
        expect(history_session.eval_script(
            "history.pushState(2, '', '/two')"
        ).is_ok()).to_be(true)
        expect(history_session.eval_script(
            "history.replaceState(3, '', '//stable.test/final')"
        ).is_ok()).to_be(true)
        expect(history_session.history.len()).to_equal(3)
        expect(history_session.current_url).to_equal(
            "https://stable.test/final"
        )
        expect(history_session.go_back().is_ok()).to_be(true)
        expect(history_session.current_url).to_equal(
            "https://stable.test/dir/child"
        )
        expect(history_session.go_back().is_ok()).to_be(true)
        expect(history_session.current_url).to_equal(stable_url)
        expect(history_session.go_forward().is_ok()).to_be(true)
        expect(history_session.go_forward().is_ok()).to_be(true)
        expect(history_session.current_url).to_equal(
            "https://stable.test/final"
        )
        expect(history_session.history.len()).to_equal(3)
        expect(history_session.has_pending_requests()).to_be(false)

    # @req REQ-WEB-BROWSER-012 REQ-WEB-BROWSER-013
    it "should preserve call-time History URL ownership for cookies and fetches":
        step("Apply an admitted History path before a cookie without fetching")
        var cookie_only = BrowserSession.new()
        match cookie_only.open_html(
            "https://safe.test/old/page",
            "<html><body>cookie only</body></html>"
        ):
            Ok(_):
                expect(cookie_only.document_url).to_equal(
                    "https://safe.test/old/page"
                )
            Err(e):
                fail("Expected the cookie-only document to open: {e}")
        match cookie_only.eval_script(
            "history.pushState(1, '', '/new/page'); " +
            "document.cookie = 'scoped=new; Secure'"
        ):
            Ok(_):
                expect(cookie_only.document_url).to_equal(
                    "https://safe.test/new/page"
                )
            Err(e):
                fail("Expected cookie-only History effects to settle: {e}")
        expect(cookie_only.document_cookie()).to_equal("scoped=new")
        expect(cookie_only.cookie_header_for_request(
            "https://safe.test/new/child"
        )).to_equal("scoped=new")
        expect(cookie_only.cookie_header_for_request(
            "https://safe.test/old/child"
        )).to_equal("")

        step("Queue relative fetches from two successive History paths")
        var sequenced = BrowserSession.new()
        sequenced.broker_network_policy = true
        match sequenced.open_html(
            "https://safe.test/old/page",
            "<html><body>sequenced fetches</body></html>"
        ):
            Ok(_):
                expect(sequenced.document_url).to_equal(
                    "https://safe.test/old/page"
                )
            Err(e):
                fail("Expected the sequenced-fetch document to open: {e}")
        match sequenced.eval_script(
            "history.pushState(2, '', '/a/page'); " +
            "document.cookie = 'scoped=a; Secure'; fetch('data'); " +
            "history.pushState(3, '', '/b/page'); " +
            "document.cookie = 'scoped=b; Secure'; fetch('data')"
        ):
            Ok(_):
                expect(sequenced.document_url).to_equal(
                    "https://safe.test/b/page"
                )
            Err(e):
                fail("Expected sequenced History and fetch effects: {e}")

        step("Keep each fetch and cookie at its call-time path")
        match sequenced.take_pending_request():
            Some(request):
                expect(request.url).to_equal("https://safe.test/a/data")
                expect(request.headers).to_contain("Cookie: scoped=a")
                expect(request.script_cookie_writes).to_equal([
                    "scoped=a; Secure"
                ])
            nil:
                fail("Expected the /a fetch")
        match sequenced.take_pending_request():
            Some(request):
                expect(request.url).to_equal("https://safe.test/b/data")
                expect(request.headers).to_contain("Cookie: scoped=b")
                expect(request.script_cookie_writes).to_equal([
                    "scoped=b; Secure"
                ])
            nil:
                fail("Expected the /b fetch")
        expect(sequenced.cookie_header_for_request(
            "https://safe.test/a/child"
        )).to_equal("scoped=a")
        expect(sequenced.cookie_header_for_request(
            "https://safe.test/b/child"
        )).to_equal("scoped=b")
        expect(sequenced.cookies.count()).to_equal(2)
        expect(sequenced.take_pending_script_cookie_writes().len()).to_equal(0)

        step("Keep rejected cross-origin History effects on the old document")
        var rejected = BrowserSession.new()
        rejected.broker_network_policy = true
        match rejected.open_html(
            "https://safe.test/old/page",
            "<html><body>rejected History</body></html>"
        ):
            Ok(_):
                expect(rejected.document_url).to_equal(
                    "https://safe.test/old/page"
                )
            Err(e):
                fail("Expected the rejected-History document to open: {e}")
        match rejected.eval_script(
            "history.pushState(4, '', 'https://evil.test/new/page'); " +
            "document.cookie = 'scoped=old; Secure'; fetch('data')"
        ):
            Ok(_):
                expect(rejected.current_url).to_equal(
                    "https://safe.test/old/page"
                )
                expect(rejected.document_url).to_equal(
                    "https://safe.test/old/page"
                )
            Err(e):
                fail("Expected rejected History effects to settle: {e}")
        expect(rejected.document_cookie()).to_equal("scoped=old")
        expect(rejected.cookie_header_for_request(
            "https://safe.test/old/child"
        )).to_equal("scoped=old")
        expect(rejected.cookie_header_for_request(
            "https://evil.test/new/child"
        )).to_equal("")
        match rejected.take_pending_request():
            Some(request):
                expect(request.url).to_equal("https://safe.test/old/data")
                expect(request.headers).to_contain("Cookie: scoped=old")
                expect(request.script_cookie_writes).to_equal([
                    "scoped=old; Secure"
                ])
            nil:
                fail("Expected the rejected-History fetch")
        expect(rejected.take_pending_script_cookie_writes().len()).to_equal(0)
