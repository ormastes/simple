use std.spec.{describe, it, expect, assert_true}

use std.gc_async_mut.web.browser_session.{BrowserCookie}
use std.gc_async_mut.web.browser_session_cookies.{
    split_text, join_text, split_cookie_assignments, cookie_text_has_attributes,
    parse_cookie_line, parse_cookie_line_for_url, merge_cookie_text, merge_cookie_text_for_url,
    upsert_cookie, cookie_text_for_url, document_cookie_text_for_url,
    cookie_matches_url, normalize_cookie_path, normalize_cookie_domain
}

describe "BrowserSession cookie helpers":

    it "splits and joins cookie text without dropping trailing parts":
        val parts = split_text("sid=abc; Path=/app;", ";")

        expect(parts.len()).to_equal(3)
        expect(parts[0]).to_equal("sid=abc")
        expect(parts[1]).to_equal(" Path=/app")
        expect(parts[2]).to_equal("")
        expect(join_text(["sid=abc", "theme=dark"], "; ")).to_equal("sid=abc; theme=dark")

    it "distinguishes cookie attributes from multiple document assignments":
        val assignments = split_cookie_assignments("sid=abc; theme=dark; Path=/app")

        expect(cookie_text_has_attributes("sid=abc; Path=/app")).to_equal(true)
        expect(assignments.len()).to_equal(3)
        expect(assignments[0]).to_equal("sid=abc")
        expect(assignments[1]).to_equal("theme=dark")
        expect(assignments[2]).to_equal("Path=/app")

    it "parses attributes and normalizes path and domain values":
        val parsed = parse_cookie_line("sid=abc; Path=app; Domain=.Example.com")

        match parsed:
            Some(cookie) =>
                expect(cookie.name).to_equal("sid")
                expect(cookie.value).to_equal("abc")
                expect(cookie.path).to_equal("/app")
                expect(cookie.domain).to_equal("example.com")
            nil =>
                fail("Expected parsed cookie")
        expect(normalize_cookie_path("app")).to_equal("/app")
        expect(normalize_cookie_domain(".Example.com")).to_equal("example.com")

    it "upserts removes and filters cookies for request URLs":
        val sid = BrowserCookie.create("sid", "abc", "/app", "example.com", false)
        val theme = BrowserCookie.create("theme", "dark", "/", "", false)
        val sid_updated = BrowserCookie.create("sid", "def", "/app", "example.com", false)
        val sid_expired = BrowserCookie.create("sid", "gone", "/app", "example.com", true)

        val jar = upsert_cookie(upsert_cookie([sid], theme), sid_updated)
        val removed = upsert_cookie(jar, sid_expired)

        expect(jar.len()).to_equal(2)
        expect(cookie_text_for_url(jar, "https://example.com/app/page")).to_equal("sid=def; theme=dark")
        expect(cookie_text_for_url(jar, "https://other.com/app/page")).to_equal("theme=dark")
        expect(cookie_text_for_url(removed, "https://example.com/app/page")).to_equal("theme=dark")
        expect(cookie_matches_url(sid_updated, "https://sub.example.com/app/page")).to_equal(true)

    it "merges document cookie text and Set-Cookie style updates":
        val jar = merge_cookie_text([], "sid=abc; theme=dark")
        val scoped = merge_cookie_text(jar, "sid=def; Path=/app; Max-Age=0")

        expect(jar.len()).to_equal(2)
        expect(cookie_text_for_url(jar, "https://example.com/")).to_equal("sid=abc; theme=dark")
        expect(scoped.len()).to_equal(2)

    it "enforces host-only Secure and HttpOnly cookie boundaries":
        val jar = merge_cookie_text_for_url(
            [],
            "sid=abc; Path=/; Secure; HttpOnly",
            "https://example.com/app",
            true
        )

        expect(jar.len()).to_equal(1)
        expect(cookie_text_for_url(jar, "https://example.com/next")).to_equal("sid=abc")
        expect(cookie_text_for_url(jar, "https://sub.example.com/next")).to_equal("")
        expect(cookie_text_for_url(jar, "http://example.com/next")).to_equal("")
        expect(document_cookie_text_for_url(jar, "https://example.com/next")).to_equal("")

    it "scopes cookies by hostname rather than network port":
        val jar = merge_cookie_text_for_url(
            [], "sid=abc; Path=/", "https://example.com:8443/app", true
        )

        expect(cookie_text_for_url(jar, "https://example.com:9443/next")).to_equal("sid=abc")
        expect(cookie_text_for_url(jar, "https://other.com:8443/next")).to_equal("")

    it "rejects foreign Domain and insecure Secure cookie updates":
        expect(parse_cookie_line_for_url("sid=abc; Domain=evil.test", "https://example.com/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=abc; Secure", "http://example.com/", true)).to_be_nil()

    it "rejects public suffix and IP Domain cookies":
        expect(parse_cookie_line_for_url("sid=1; Domain=com", "https://example.com/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=co.uk", "https://shop.co.uk/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=github.io", "https://tenant.github.io/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=公司.cn", "https://shop.公司.cn/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=xn--55qx5d.cn", "https://shop.xn--55qx5d.cn/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=127.0.0.1", "https://127.0.0.1/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=127.1", "https://127.1/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=0x7f000001", "https://0x7f000001/", true)).to_be_nil()
        expect(parse_cookie_line_for_url("sid=1; Domain=::1", "https://[::1]/", true)).to_be_nil()
        assert_true(parse_cookie_line_for_url("host=1", "https://127.0.0.1/", true) != nil)
        assert_true(parse_cookie_line_for_url("sid=1; Domain=example.com", "https://shop.example.com/", true) != nil)

    it "enforces cookie prefixes SameSite None and partition isolation":
        val url = "https://example.com/app"

        assert_true(parse_cookie_line_for_url("__Secure-ok=1; Secure", url, true) != nil)
        expect(parse_cookie_line_for_url("__Secure-bad=1", url, true)).to_be_nil()
        assert_true(parse_cookie_line_for_url("__Host-ok=1; Secure; Path=/", url, true) != nil)
        expect(parse_cookie_line_for_url("__Host-domain=1; Secure; Path=/; Domain=example.com", url, true)).to_be_nil()
        expect(parse_cookie_line_for_url("__Host-path=1; Secure; Path=/app", url, true)).to_be_nil()
        expect(parse_cookie_line_for_url("same=1; SameSite=None", url, true)).to_be_nil()
        assert_true(parse_cookie_line_for_url("same=1; SameSite=None; Secure", url, true) != nil)
        expect(parse_cookie_line_for_url("part=1; Secure; Partitioned", url, true)).to_be_nil()

    it "rejects cookie header injection":
        expect(parse_cookie_line("sid=abc\r\nX-Evil: yes")).to_be_nil()
        expect(merge_cookie_text([], "sid=abc\r\nX-Evil: yes").len()).to_equal(0)

    it "bounds cookie size and per-domain retention":
        var oversized = "sid="
        while oversized.len() <= 4096:
            oversized = oversized + "x"
        expect(parse_cookie_line(oversized)).to_be_nil()

        var jar: [BrowserCookie] = []
        var index = 0
        while index < 51:
            jar = upsert_cookie(
                jar,
                BrowserCookie.create("cookie{index}", "value", "/", "example.com", false)
            )
            index = index + 1
        expect(jar.len()).to_equal(50)
