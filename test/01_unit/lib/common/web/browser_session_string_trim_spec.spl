use std.spec.*
use std.nogc_sync_mut.js.engine.runtime.{JsRuntime}
use std.js.engine.js_error.{Logger, LogLevel}
use std.js.types.js_types.{JsValue}

fn expect_trim_dispatch(source: text, expected: text):
    var runtime = JsRuntime.new(Logger.new("trim-spec", LogLevel.Error))
    match runtime.eval(source):
        Ok(JsValue.String(value)): expect(value).to_equal(expected)
        Ok(_): fail("Expected string result for " + source)
        Err(error): fail("Expected trim dispatch to succeed: {error}")

describe "JavaScript interpreter string trimming":
    it "preserves empty and all-whitespace results":
        expect_trim_dispatch("''.trim()", "")
        expect_trim_dispatch("' \\t\\n '.trim()", "")

    it "trims the requested ASCII boundary only":
        expect_trim_dispatch("'  alpha beta  '.trim()", "alpha beta")
        expect_trim_dispatch("'  alpha beta  '.trimStart()", "alpha beta  ")
        expect_trim_dispatch("'  alpha beta  '.trimEnd()", "  alpha beta")

    it "preserves UTF-8 content while trimming ASCII whitespace":
        expect_trim_dispatch("'  café 猫  '.trim()", "café 猫")
        expect_trim_dispatch("'  λ  '.trimStart()", "λ  ")
        expect_trim_dispatch("'  λ  '.trimEnd()", "  λ")
