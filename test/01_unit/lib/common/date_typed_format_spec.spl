use std.spec
use std.common.date.types.{Date, epoch, today_mock}
use std.common.date.format.{to_string as date_string, to_iso8601, to_readable, to_short}

describe "concrete date formatter contract":
    it "formats the actual epoch producer without changing year padding":
        val first: Date = epoch()
        expect(date_string(first)).to_equal("1-01-01")
        expect(to_iso8601(first)).to_equal("1-01-01")

    it "formats the actual fixed date producer through both month helpers":
        val fixed: Date = today_mock()
        expect(date_string(fixed)).to_equal("2025-01-15")
        expect(to_readable(fixed)).to_equal("January 15, 2025")
        expect(to_short(fixed)).to_equal("Jan 15, 2025")

    it "retains leap day components and two digit calendar fields":
        val leap: Date = (2024, 2, 29)
        expect(to_iso8601(leap)).to_equal("2024-02-29")
        expect(to_readable(leap)).to_equal("February 29, 2024")
        expect(to_short(leap)).to_equal("Feb 29, 2024")
