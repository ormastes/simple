# @req: REQ-SSPEC-JSON-ARRAY-BOUNDARY
# Real JSON constructor/flatten and configured runtime facade; no mock predicate.
use std.spec
use std.common.json.types.{json_array, json_number, json_string, json_boolean, json_null}
use std.common.json.array_ops.json_array_flatten
use std.sffi.runtime.array_value_is_boxed_array

describe "checked JSON array flatten boundary":
    it "accepts empty boxed arrays and rejects scalar nil and tuple payloads":
        val empty: [any] = []
        expect(array_value_is_boxed_array(empty)).to_equal(true)
        expect(array_value_is_boxed_array(9)).to_equal(false)
        expect(array_value_is_boxed_array(nil)).to_equal(false)
        expect(array_value_is_boxed_array((1, 2))).to_equal(false)
        val result = json_array_flatten(json_array(empty))
        expect(result.0).to_equal("array")
        expect(array_value_is_boxed_array(result.1)).to_equal(true)
        expect(result.1.len()).to_equal(0)

    it "preserves heterogeneous scalar JSON values while flattening once":
        val inner = json_array([json_number(2.5), json_null(), json_boolean(true)])
        val result = json_array_flatten(json_array([json_string("a"), inner]))
        expect(result.0).to_equal("array")
        expect(result.1.len()).to_equal(4)
        expect(result.1[0].0).to_equal("string")
        expect(result.1[0].1).to_equal("a")
        expect(result.1[1].0).to_equal("number")
        expect(result.1[1].1).to_equal(2.5)
        expect(result.1[2].0).to_equal("null")
        expect(result.1[2].1).to_be_nil()
        expect(result.1[3].0).to_equal("boolean")
        expect(result.1[3].1).to_equal(true)

    it "preserves arrays nested more than one level":
        val deepest = json_array([json_number(7.0)])
        val result = json_array_flatten(json_array([json_array([deepest])]))
        expect(result.1.len()).to_equal(1)
        expect(result.1[0].0).to_equal("array")
        expect(result.1[0].1.len()).to_equal(1)
        expect(result.1[0].1[0].0).to_equal("number")
        expect(result.1[0].1[0].1).to_equal(7.0)

    it "keeps the existing empty result for non-array JSON and nil":
        val from_string = json_array_flatten(json_string("no array"))
        val from_nil = json_array_flatten(nil)
        expect(from_string.0).to_equal("array")
        expect(from_string.1.len()).to_equal(0)
        expect(from_nil.0).to_equal("array")
        expect(from_nil.1.len()).to_equal(0)

    it "rejects forged scalar and tuple storage instead of iterating it":
        expect(json_array_flatten(("array", 9))).to_be_nil()
        expect(json_array_flatten(("array", nil))).to_be_nil()
        expect(json_array_flatten(("array", (json_number(1.0), json_null())))).to_be_nil()

    it "rejects a malformed nested array without returning partial data":
        val malformed = ("array", 9)
        expect(json_array_flatten(json_array([json_number(1.0), malformed]))).to_be_nil()
