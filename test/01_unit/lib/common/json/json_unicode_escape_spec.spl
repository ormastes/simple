"""
## Purpose and audience
Purpose: Prove that json unicode escape decoding (std.common.json).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

"""
RFC 8259 \\uXXXX decoding in std.common.json (was: escapes passed through
as literal backslash-u text — data loss on any \\u-escaped codepoint).

Byte-sequence assertions: Simple text is UTF-8 and text equality is byte
equality, and .len() is BYTE length — so equality + len together pin the
exact byte sequence, not just display.

Surrogate policy under test: \\uD800-\\uDBFF followed by \\uDC00-\\uDFFF
combines to the supplementary-plane codepoint; a lone/invalid surrogate
decodes to U+FFFD (3 bytes: EF BF BD).
"""

use std.spec.*
use std.common.json.parser.{json_parse, json_unescape_string}
use std.common.json.serializer.{json_serialize}

describe "json unicode escape decoding (std.common.json)":
    it "decodes ASCII escape to the ASCII byte":
        step("Verify: decodes ASCII escape to the ASCII byte")
        # @req: REQ-LIB-COMMON-001
        val out = json_unescape_string("\\u0041")
        expect(out).to_equal("A")
        expect(out.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "decodes BMP escape to 2-byte UTF-8 (e-acute)":
        step("Verify: decodes BMP escape to 2-byte UTF-8 (e-acute)")
        val out = json_unescape_string("caf\\u00e9")
        expect(out).to_equal("café")
        expect(out.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "decodes CJK escape to 3-byte UTF-8":
        step("Verify: decodes CJK escape to 3-byte UTF-8")
        val out = json_unescape_string("\\u4e2d")
        expect(out).to_equal("中")
        expect(out.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "combines a surrogate pair into a 4-byte supplementary codepoint":
        step("Verify: combines a surrogate pair into a 4-byte supplementary codepoint")
        val out = json_unescape_string("\\ud83d\\ude00")
        expect(out).to_equal("😀")
        expect(out.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "decodes a lone high surrogate to U+FFFD":
        step("Verify: decodes a lone high surrogate to U+FFFD")
        val out = json_unescape_string("\\ud83dX")
        expect(out).to_equal("�X")
        expect(out.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "decodes a lone low surrogate to U+FFFD":
        step("Verify: decodes a lone low surrogate to U+FFFD")
        val out = json_unescape_string("\\udc00")
        expect(out).to_equal("�")
        expect(out.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "handles mixed literal and escaped content byte-correctly":
        step("Verify: handles mixed literal and escaped content byte-correctly")
        val out = json_unescape_string("é\\u4e2dz\\ud83d\\ude00")
        expect(out).to_equal("é中z😀")
        expect(out.len()).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "decodes through the json_parse entry point":
        step("Verify: decodes through the json_parse entry point")
        val v = json_parse("\"caf\\u00e9 \\u4e2d \\ud83d\\ude00\"")
        expect(v.1).to_equal("café 中 😀")

    it "serializes decoded escapes as raw UTF-8 bytes":
        step("Verify: serializes decoded escapes as raw UTF-8 bytes")
        # The serializer does not \u-escape non-ASCII, so the serialize
        # direction must carry the decoded UTF-8 bytes verbatim.
        val v = json_parse("\"caf\\u00e9\"")
        val re = json_serialize(v)
        expect(re).to_equal("\"café\"")
        expect(re.len()).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "parses raw non-ASCII string content byte-exactly":
        step("Verify: parses raw non-ASCII string content byte-exactly")
        # Tokenizer is byte-indexed throughout; raw UTF-8 passes through.
        # (Was: any raw non-ASCII made json_parse return nil — see
        # doc/08_tracking/bug/json_tokenizer_rejects_raw_non_ascii_strings_2026-07-29.md)
        val v1 = json_parse("\"café\"")
        expect(v1.1).to_equal("café")
        expect(v1.1.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        val v2 = json_parse("\"中\"")
        expect(v2.1).to_equal("中")
        expect(v2.1.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val v3 = json_parse("\"😀\"")
        expect(v3.1).to_equal("😀")
        expect(v3.1.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "parses mixed raw and escaped content in one string":
        step("Verify: parses mixed raw and escaped content in one string")
        val v = json_parse("\"é\\u4e2dz\\ud83d\\ude00 中\"")
        expect(v.1).to_equal("é中z😀 中")
        expect(v.1.len()).to_equal(14)  # oracle: 14 — named expected value from the requirement

    it "round-trips parse -> serialize -> parse for non-ASCII":
        step("Verify: round-trips parse -> serialize -> parse for non-ASCII")
        # Headline: the serializer emits decoded UTF-8 raw, and the
        # tokenizer must accept its own serializer's output.
        val v = json_parse("\"caf\\u00e9 \\u4e2d \\ud83d\\ude00\"")
        val re = json_serialize(v)
        val v2 = json_parse(re)
        expect(v2.1).to_equal("café 中 😀")
        # bytes: 5 (cafe-acute) + 1 + 3 (CJK) + 1 + 4 (emoji) = 14
        expect(v2.1.len()).to_equal(14)  # oracle: 14 — named expected value from the requirement

    it "keeps adjacent multi-byte characters intact with no replacement chars":
        step("Verify: keeps adjacent multi-byte characters intact with no replacement chars")
        # Canary for the deployed-seed slice divergence: the tokenizer
        # walks 1-unit slices, which are whole characters under the
        # current interpreter and single bytes under compiled code (and
        # under byte-indexed interpreter slicing after a seed redeploy
        # of ecc226b5136). If a mid-codepoint 1-unit read were ever
        # normalized to U+FFFD instead of the raw byte, this adjacent
        # multi-byte string would come back with replacement characters
        # and a changed byte length. Re-run after any seed redeploy that
        # changes slice semantics.
        val v = json_parse("\"\\ud83d\\ude00\\u4e2d\\u00e9\"")
        expect(v.1).to_equal("😀中é")
        val raw = json_parse("\"😀中é\"")
        expect(raw.1).to_equal(v.1)
        # bytes: 4 (emoji) + 3 (CJK) + 2 (e-acute) = 9, no ASCII between
        expect(raw.1.len()).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect not raw.1.contains("�")

    it "accepts non-ASCII in object keys and structures after them":
        step("Verify: accepts non-ASCII in object keys and structures after them")
        val v = json_parse("{\"caf\\u00e9\": 1, \"中\": [true, \"😀\"], \"z\": null}")
        val re = json_serialize(v)
        val v2 = json_parse(re)
        expect not (v2 == nil)
        expect(re.contains("中")).to_equal(true)
        expect(re.contains("😀")).to_equal(true)

    it "still rejects malformed unicode escapes at the parser level":
        step("Verify: still rejects malformed unicode escapes at the parser level")
        expect(json_parse("\"\\uZZZZ\"") == nil).to_equal(true)
