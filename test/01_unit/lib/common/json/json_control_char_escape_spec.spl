"""
## Purpose and audience
Purpose: Prove that json C0 control-character escaping (std.common.json).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

"""
RFC 8259 C0 control-character escaping in std.common.json's serializer.

Was: `json_escape_string` only ran a `.replace()` chain for backslash, quote,
newline, tab and carriage return, so backspace (0x08), form feed (0x0C) and
the other 26 characters below U+0020 were emitted RAW inside the string
literal. RFC 8259 forbids that, and this library's OWN parser rejects it --
`json_parse` returned nil on the serializer's own output ("Invalid string
escape"), i.e. serialize -> parse silently lost the whole value.

Control characters are built with `json_unescape_string` (the already-proven
decode direction) rather than a literal, so the spec never has to embed a raw
control byte in its own source.

Byte-sequence assertions: Simple text is UTF-8 and text equality is byte
equality, and .len() is BYTE length -- equality + len together pin the exact
byte sequence, not just the display form.
"""

use std.spec.*
use std.common.json.parser.{json_parse, json_unescape_string}
use std.common.json.serializer.{json_serialize}

describe "json C0 control-character escaping (std.common.json)":
    """As a caller serializing arbitrary text to JSON, I get output my own
    parser can read back, even when the text contains control characters."""

    it "escapes backspace as \\b, not a raw 0x08 byte":
        step("Verify: escapes backspace as b, not a raw 0x08 byte")
        # @req: REQ-LIB-COMMON-001
        val raw = json_unescape_string("a\\u0008b")
        expect(raw.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"a\\bb\"")

    it "escapes form feed as \\f, not a raw 0x0c byte":
        step("Verify: escapes form feed as f, not a raw 0x0c byte")
        val raw = json_unescape_string("a\\u000cb")
        expect(raw.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"a\\fb\"")

    it "escapes other C0 controls as lowercase \\u00XX":
        step("Verify: escapes other C0 controls as lowercase u00XX")
        val raw = json_unescape_string("\\u0001\\u001f")
        expect(raw.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"\\u0001\\u001f\"")

    it "emits hex letters a-f for the nibbles that need them":
        step("Verify: emits hex letters a-f for the nibbles that need them")
        # 0x0b/0x0e/0x1a exercise low nibbles b, e, a and a nonzero high
        # nibble -- the only examples that index _JSON_HEX_DIGITS past 9.
        # 0x0b (vertical tab) also must NOT be swallowed as whitespace.
        val raw = json_unescape_string("\\u000b\\u000e\\u001a")
        expect(raw.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"\\u000b\\u000e\\u001a\"")
        val back = json_parse(out)
        expect(back.1).to_equal(raw)

    it "escapes NUL as \\u0000":
        step("Verify: escapes NUL as u0000")
        val raw = json_unescape_string("x\\u0000y")
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"x\\u0000y\"")

    it "round-trips a control character through parse after serialize":
        step("Verify: round-trips a control character through parse after serialize")
        # Headline: the parser must accept its own serializer's output.
        # Before the fix json_parse returned nil here.
        val raw = json_unescape_string("a\\u0008b\\u000cc\\u0001")
        val out = json_serialize(("string", raw))
        val back = json_parse(out)
        expect not (back == nil)
        expect(back.1).to_equal(raw)
        expect(back.1.len()).to_equal(raw.len())

    it "keeps multi-byte UTF-8 intact alongside control characters":
        step("Verify: keeps multi-byte UTF-8 intact alongside control characters")
        # The escape pass must not walk raw byte indices: every byte of a
        # multi-byte sequence is >= 0x80 and must be copied whole.
        val raw = json_unescape_string("\\u00e9\\u0008\\u4e2d\\ud83d\\ude00")
        # bytes: 2 (e-acute) + 1 (BS) + 3 (CJK) + 4 (emoji) = 10
        expect(raw.len()).to_equal(10)  # oracle: 10 — named expected value from the requirement
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"é\\b中😀\"")
        val back = json_parse(out)
        expect(back.1).to_equal(raw)
        expect(back.1.len()).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect not back.1.contains("�")

    it "escapes control characters inside object keys too":
        step("Verify: escapes control characters inside object keys too")
        val key = json_unescape_string("k\\u0008")
        val obj = {key: ("number", 1.0)}
        val out = json_serialize(("object", obj))
        expect(out).to_equal("{\"k\\b\":1.0}")
        expect not (json_parse(out) == nil)

    it "leaves the already-covered escapes and plain text unchanged":
        step("Verify: leaves the already-covered escapes and plain text unchanged")
        # Regression guard: the new pass must not double-escape or disturb
        # the characters the original .replace() chain already handled.
        val raw = json_unescape_string("caf\\u00e9\\tx\\ny\\r\\\"z\\\\w")
        val out = json_serialize(("string", raw))
        expect(out).to_equal("\"café\\tx\\ny\\r\\\"z\\\\w\"")
        val back = json_parse(out)
        expect(back.1).to_equal(raw)
