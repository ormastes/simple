"""## Purpose and audience
Hex and line-ending-normalised wrappers over XXH3-64 (seed 0) and BLAKE3 for
tooling that fingerprints files (hash CLI, cache keys).
Category: Stdlib.
## Operator workflow
bin/simple test test/01_unit/lib/common/hash/xxh3_hex_spec.spl
## Compatibility and limitations
Non-cryptographic for XXH3. Official XXH3 vectors live in xxh3_spec.spl; this
spec pins the hex formatting, the text/bytes variants and CR stripping.
## Verification guidance and troubleshooting
A RED row names the wrapper; compare against xxh3_64 / blake3_hash directly.
"""
# @manual_section: primary
# @cover src/lib/common/hash/xxh3.spl 80%

use std.spec.*
use std.common.hash.xxh3.{xxh3_64, xxh3_64_hex, xxh3_64_hex_bytes, xxh3_64_hex_lf}
use std.common.crypto.blake3.{blake3_hash, blake3_hex, blake3_hex_text, blake3_hex_lf}

describe "xxh3_64 hex wrappers":
    it "empty text is the official 0x2D06800538D394C2":
        expect(xxh3_64_hex("")).to_equal("2d06800538d394c2")
        expect(xxh3_64_hex_bytes([])).to_equal("2d06800538d394c2")

    it "single zero byte matches the official length-1 vector":
        expect(xxh3_64_hex_bytes([0u8])).to_equal("c44bdff4074eecdb")

    it "pads to 16 lowercase hex chars":
        expect(xxh3_64_hex("abc").len()).to_equal(16)

    it "text variant equals bytes variant":
        expect(xxh3_64_hex("hello")).to_equal(xxh3_64_hex_bytes([104u8, 101u8, 108u8, 108u8, 111u8]))

    it "lf variant strips every CR before hashing":
        expect(xxh3_64_hex_lf("a\r\nb\r\n")).to_equal(xxh3_64_hex("a\nb\n"))
        expect(xxh3_64_hex_lf("a\nb\n")).to_equal(xxh3_64_hex("a\nb\n"))
        expect(xxh3_64_hex_lf("\r\r")).to_equal("2d06800538d394c2")

describe "blake3 hex wrappers":
    it "empty text is the official af1349b9...":
        expect(blake3_hex_text("")).to_equal("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")

    it "text variant equals bytes variant":
        expect(blake3_hex_text("abc")).to_equal(blake3_hex(blake3_hash([97u8, 98u8, 99u8])))

    it "lf variant strips every CR before hashing":
        expect(blake3_hex_lf("a\r\nb\r\n")).to_equal(blake3_hex_text("a\nb\n"))
        expect(blake3_hex_lf("x").len()).to_equal(64)
