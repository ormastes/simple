# REQ-RUNTIME-TEXT-HASH-001: preserve the rt_hash_text sidecar contract.
use std.spec.*
use std.common.hash.runtime_text.{runtime_text_hash_v1}

describe "runtime_text_hash_v1 signed FNV-1a64":
    it "matches empty and ASCII known answers":
        expect(runtime_text_hash_v1("")).to_equal(-3750763034362895579)
        expect(runtime_text_hash_v1("a")).to_equal(-5808556873153909620)
        expect(runtime_text_hash_v1("abc")).to_equal(-1792535898324117685)
        expect(runtime_text_hash_v1("hello")).to_equal(-6615550055289275125)

    it "hashes UTF-8 bytes rather than Unicode codepoints":
        expect(runtime_text_hash_v1("héllo")).to_equal(-6674344407707008800)
        expect(runtime_text_hash_v1("日本語")).to_equal(-1252314375984451705)
        expect(runtime_text_hash_v1("🎉")).to_equal(-51012698996789463)

    it "includes embedded zero bytes and bytes after them":
        expect(runtime_text_hash_v1("a\0b")).to_equal(-1886276961191958862)

    it "wraps repeatedly and retains deterministic order sensitivity":
        val boundary = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        expect(runtime_text_hash_v1(boundary)).to_equal(9038906031697053191)
        expect(runtime_text_hash_v1("ab") == runtime_text_hash_v1("ba")).to_equal(false)
        expect(runtime_text_hash_v1("abc")).to_equal(runtime_text_hash_v1("abc"))
