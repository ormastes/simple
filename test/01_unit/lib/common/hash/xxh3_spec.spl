describe "xxh3 known answers":
    # @manual scenario evidence
    it "matches the reference 64-bit digest for every length class and seed":
        # @req REQ-XXH3-064
        step("Generate the official sanity buffer")
        val buf = sanity_buf(8192)
        step("Hash each prefix and compare against the reference table")
        var bad = 0
        for r in rows():
            val d = prefix(buf, r[0].to_i64())
            if xxh3_64_seeded(d, r[1]) != r[2]:
                bad = bad + 1
        expect(bad).to_equal(0)

    it "matches the reference 128-bit digest for every length class and seed":
        # @req REQ-XXH3-128
        val buf = sanity_buf(8192)
        var bad = 0
        for r in rows():
            val d = prefix(buf, r[0].to_i64())
            val h = xxh3_128_seeded(d, r[1])
            if h.low != r[3] or h.high != r[4]:
                bad = bad + 1
        expect(bad).to_equal(0)

    it "matches the published empty-input digests":
        # @req REQ-XXH3-064
        expect(xxh3_64([]) == 0x2d06800538d394c2u64).to_equal(true)
        val h = xxh3_128([])
        expect(h.low == 0x6001c324468d497fu64).to_equal(true)
        expect(h.high == 0x99aa06d3014798d8u64).to_equal(true)

    it "unseeded entry points equal seed zero":
        # @req REQ-XXH3-064
        val d = sanity_buf(1024)
        expect(xxh3_64(d) == xxh3_64_seeded(d, 0u64)).to_equal(true)
        expect(xxh3_128(d).low == xxh3_128_seeded(d, 0u64).low).to_equal(true)

describe "xxh3 streaming":
    # @manual scenario evidence
    it "equals the one-shot digest for every split point":
        # @req REQ-XXH3-STREAM
        val buf = sanity_buf(1025)
        var bad = 0
        for n in [0, 1, 17, 129, 240, 241, 1025]:
            val d = prefix(buf, n)
            val e64 = xxh3_64(d)
            val e128 = xxh3_128(d)
            val s64 = xxh3_64_seeded(d, 0x9E3779B185EBCA8Du64)
            val s128 = xxh3_128_seeded(d, 0x9E3779B185EBCA8Du64)
            var k = 0
            while k <= n:
                var st = xxh3_state_new(0u64)
                st.update(slice(d, 0, k))
                st.update(slice(d, k, n))
                val g = st.digest128()
                if st.digest64() != e64 or g.low != e128.low or g.high != e128.high:
                    bad = bad + 1
                var ss = xxh3_state_new(0x9E3779B185EBCA8Du64)
                ss.update(slice(d, 0, k))
                ss.update(slice(d, k, n))
                val sg = ss.digest128()
                if ss.digest64() != s64 or sg.low != s128.low or sg.high != s128.high:
                    bad = bad + 1
                k = k + 1
        expect(bad).to_equal(0)

    it "handles byte-wise feeding, digest mid-stream and reset":
        # @req REQ-XXH3-STREAM
        val buf = sanity_buf(700)
        var st = xxh3_state_new(0u64)
        var i = 0
        while i < 700:
            st.update([buf[i]])
            i = i + 1
        expect(st.digest64() == xxh3_64(buf)).to_equal(true)
        expect(st.digest64() == xxh3_64(buf)).to_equal(true)
        st.reset()
        st.update(prefix(buf, 300))
        expect(st.digest64() == xxh3_64(prefix(buf, 300))).to_equal(true)
        val h = st.digest128()
        val e = xxh3_128(prefix(buf, 300))
        expect(h.low == e.low and h.high == e.high).to_equal(true)

    it "can digest mid-stream and keep absorbing":
        # @req REQ-XXH3-STREAM
        val buf = sanity_buf(1500)
        var bad = 0
        for cut in [0, 100, 240, 241, 256, 300, 700, 1024]:
            var st = xxh3_state_new(0u64)
            st.update(prefix(buf, cut))
            val mid = st.digest64()
            st.update(slice(buf, cut, 1500))
            val g = st.digest128()
            val e = xxh3_128(buf)
            if mid != xxh3_64(prefix(buf, cut)) or st.digest64() != xxh3_64(buf) or g.low != e.low or g.high != e.high:
                bad = bad + 1
        expect(bad).to_equal(0)
