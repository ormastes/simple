"""## Purpose and audience
XXH3-64/128 (xxHash 0.8) one-shot and streaming hashing in `std.common.hash.xxh3`,
for stdlib authors who need a fast non-cryptographic hash with exact reference output.
Category: Stdlib.
## Operator workflow
bin/simple test test/01_unit/lib/common/hash/xxh3_spec.spl
## Compatibility and limitations
Non-cryptographic. Expected values come from the official xxHash sanity buffer
hashed by the independent Rust crate xxhash-rust 0.8.15 (not by this module).
## Verification guidance and troubleshooting
A RED known-answer row names the length and seed; the streaming rows name the split point.
"""
# @manual_section: primary
# @cover src/lib/common/hash/xxh3.spl 80%

use std.spec.*
use std.common.hash.xxh3.{xxh3_64, xxh3_64_seeded, xxh3_128, xxh3_128_seeded, Xxh3Hash128, xxh3_state_new}

fn sanity_buf(n: i64) -> [u8]:
    var out: [u8] = [0u8; n]
    var g: u64 = 2654435761u64
    var i = 0
    while i < n:
        out[i] = (g >> 56u64).to_u8()
        g = g * 11400714785074694797u64
        i = i + 1
    out

fn prefix(buf: [u8], n: i64) -> [u8]:
    var out: [u8] = [0u8; n]
    var i = 0
    while i < n:
        out[i] = buf[i]
        i = i + 1
    out

fn slice(buf: [u8], a: i64, b: i64) -> [u8]:
    var out: [u8] = [0u8; b - a]
    var i = a
    while i < b:
        out[i - a] = buf[i]
        i = i + 1
    out

# rows: [len, seed, xxh3_64, xxh3_128 low, xxh3_128 high]
fn rows() -> [[u64]]:
