# Regression: len() counts scalars but slice() takes byte offsets.
# Bug: doc/08_tracking/bug/summary_store_publish_read_absent_2026-11-26.md
use std.spec.*
use std.spec.step
use std.common.js.types.js_types.{JsValue}
use std.common.js.node.path_module.{path_basename, path_extname}
use std.common.traceability.model.*
use std.common.traceability.trace_ids_v1.{TraceEntityIdV1, TracePathV1, TracePathSuffixV1, TraceRuleVersionV1}
use std.common.traceability.conventions.{convention_target_path}
use std.editor.unified.project_navigator.{_count_separators}
use std.gc_async_mut.web.browser_session_url.{find_text, collapse_url_dot_segments, _drop_last_segment, base_dir, url_authority}

describe "common js path_module on non-ASCII paths":
    it "returns the non-ASCII basename and strips the extension":
        step("basename")
        expect(path_basename([JsValue.String(v: "/é/한😀.x")])).to_equal(JsValue.String(v: "한😀.x"))
        expect(path_basename([JsValue.String(v: "/é/한😀.x"), JsValue.String(v: ".x")])).to_equal(JsValue.String(v: "한😀"))

    it "returns the extension after a non-ASCII directory":
        step("extname")
        expect(path_extname([JsValue.String(v: "é한😀/a.txt")])).to_equal(JsValue.String(v: ".txt"))

describe "traceability convention target on non-ASCII path":
    it "maps the full non-ASCII middle":
        step("convention target path")
        val rule = TraceConventionRule(id: TraceEntityIdV1(value: "app-unit-v1"), source_root: TracePathV1(value: "src/"), target_root: TracePathV1(value: "test/"),
            source_suffix: TracePathSuffixV1(value: ".spl"), target_suffix: TracePathSuffixV1(value: "_spec.spl"), relation: TraceRelation.Targets, version: TraceRuleVersionV1(value: "1"))
        expect(convention_target_path("src/é한😀/a.spl", rule)).to_equal("test/é한😀/a_spec.spl")

describe "project navigator separators under a non-ASCII root":
    it "counts only separators below the root":
        step("count separators")
        expect(_count_separators("/é한😀/x/a", "/é한😀/x")).to_equal(1)

describe "browser session url helpers on non-ASCII urls":
    it "finds text by byte index":
        step("find_text")
        expect(find_text("é한😀?q", "?", 0)).to_equal(9)

    it "collapses dot segments after a non-ASCII segment":
        step("collapse")
        expect(collapse_url_dot_segments("https://h/é한😀/../x?q")).to_equal("https://h/x?q")

    it "drops the last segment and keeps the base dir":
        step("drop last segment / base dir")
        expect(_drop_last_segment("/é한😀/b")).to_equal("/é한😀")
        expect(base_dir("https://h/é한😀/b.html")).to_equal("https://h/é한😀/")

    it "returns a non-ASCII authority":
        step("authority")
        expect(url_authority("https://é한😀.test/p")).to_equal("é한😀.test")
