use std.math_repr.{render_latex_raw}

describe "math_repr sum range latex repro":
    it "keeps upper bound n in latex sum output":
        val result = render_latex_raw("sum(i, 1..n) i")
        expect(result).to_contain("n")
        expect(result).to_contain("\\sum_")
        expect(result).to_contain("^{")
