# Repro spec for the predictable-randomness bug in
# src/lib/nogc_async_mut/oauth/utilities.spl random_int()/get_current_timestamp()
# (same family as the already-fixed nogc_sync_mut copy, commit
# 186b33e3651285110c7a73ffdc64d4c37b26ad88). Before the fix,
# get_current_timestamp() returned a hardcoded mock value (1707753600), so
# random_int() and everything built on it (generate_random_string, OAuth
# state/PKCE verifier generation) was fully deterministic/predictable.
#
# NOTE: this spec is currently blocked by a separate, pre-existing defect —
# see doc/08_tracking/bug/legacy_import_string_namespace_dict_ignores_source_content_2026-08-11.md.
# Under the currently deployed binary, `import string` resolves `string.*`
# calls (string.length/string.char_at, used inside random_int's hex decode)
# against a stale namespace dict that only contains 8 `bm_*` symbols,
# independent of source content. That defect fails this spec identically
# whether or not the random_int fix below is present, so it cannot serve as
# live before/after proof under the current deployment. It is left in place
# as a real repro to re-run once that defect (or a compiler
# rebuild+redeploy) unblocks it.

use nogc_async_mut.oauth.utilities.{random_int}

describe "nogc_async_mut oauth random_int":
    it "produces varying output across calls (not a deterministic mock timestamp)":
        val a = random_int(0, 1000000)
        val b = random_int(0, 1000000)
        val c = random_int(0, 1000000)
        # A hardcoded-timestamp mock would make these three deterministic
        # for a fixed range; a real CSPRNG should not collide on all three.
        expect (a != b) or (b != c)
