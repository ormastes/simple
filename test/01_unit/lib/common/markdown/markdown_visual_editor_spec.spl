"""
## Purpose and audience
Purpose: Prove that markdown_visual_wiki_links edge cases.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec
use common.markdown_visual_editor.{
    markdown_visual_wiki_links,
    markdown_visual_title
}

describe "markdown_visual_wiki_links edge cases":
    it "returns empty for empty input":
        step("Verify: returns empty for empty input")
        # @req: REQ-LIB-COMMON-001
        val links = markdown_visual_wiki_links("")
        expect(links.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "handles unterminated [[ without crash":
        step("Verify: handles unterminated [[ without crash")
        val links = markdown_visual_wiki_links("[[unterminated")
        expect(links.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ignores ]] with no opener":
        step("Verify: ignores ]] with no opener")
        val links = markdown_visual_wiki_links("text]] more")
        expect(links.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ignores empty [[]]":
        step("Verify: ignores empty [[]]")
        val links = markdown_visual_wiki_links("[[]]")
        expect(links.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "extracts adjacent links":
        step("Verify: extracts adjacent links")
        val links = markdown_visual_wiki_links("[[Alpha]][[Beta]]")
        expect(links.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(links[0]).to_equal("Alpha")
        expect(links[1]).to_equal("Beta")

    it "extracts multiple links with surrounding text":
        step("Verify: extracts multiple links with surrounding text")
        val links = markdown_visual_wiki_links("See [[Kernel]] and [[Packages]].")
        expect(links).to_contain("Kernel")
        expect(links).to_contain("Packages")

    it "handles single valid link":
        step("Verify: handles single valid link")
        val links = markdown_visual_wiki_links("[[MyNote]]")
        expect(links.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(links[0]).to_equal("MyNote")

describe "markdown_visual_title CRLF":
    it "strips CR from CRLF heading lines":
        step("Verify: strips CR from CRLF heading lines")
        expect(markdown_visual_title("/a/note.md", "# Title\r\nbody")).to_equal("Title")

    it "falls back to basename when no heading":
        step("Verify: falls back to basename when no heading")
        expect(markdown_visual_title("/a/note.md", "just body")).to_equal("note")
