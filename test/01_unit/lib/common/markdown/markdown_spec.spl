"""
## Purpose and audience
Purpose: Prove that markdown_inline_text.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec
use std.common.markdown.{
    markdown_inline_text,
    markdown_escape_html,
    markdown_plain_inline,
    markdown_block_kind,
    parse_markdown_blocks,
    markdown_slugify
}

describe "markdown_inline_text":
    it "returns empty string for empty input":
        step("Verify: returns empty string for empty input")
        # @req: REQ-LIB-COMMON-001
        expect(markdown_inline_text("")).to_equal("")

    it "passes plain text through unchanged":
        step("Verify: passes plain text through unchanged")
        expect(markdown_inline_text("hello world")).to_equal("hello world")

    it "wraps bold markers":
        step("Verify: wraps bold markers")
        expect(markdown_inline_text("**bold**")).to_equal("<strong>bold</strong>")

    it "wraps italic markers":
        step("Verify: wraps italic markers")
        expect(markdown_inline_text("*italic*")).to_equal("<em>italic</em>")

    it "wraps code span":
        step("Verify: wraps code span")
        expect(markdown_inline_text("`code`")).to_equal("<code>code</code>")

    it "leaves unbalanced bold as literal":
        step("Verify: leaves unbalanced bold as literal")
        expect(markdown_inline_text("**oops")).to_equal("**oops")

    it "leaves unbalanced italic as literal":
        step("Verify: leaves unbalanced italic as literal")
        expect(markdown_inline_text("*oops")).to_equal("*oops")

    it "leaves unbalanced backtick as literal":
        step("Verify: leaves unbalanced backtick as literal")
        expect(markdown_inline_text("`oops")).to_equal("`oops")

    it "handles escaped star":
        step("Verify: handles escaped star")
        expect(markdown_inline_text("\\*literal\\*")).to_equal("*literal*")

    it "protects code span content from bold parsing":
        step("Verify: protects code span content from bold parsing")
        expect(markdown_inline_text("`**not bold**`")).to_equal("<code>**not bold**</code>")

    it "handles adjacent bold and italic":
        step("Verify: handles adjacent bold and italic")
        expect(markdown_inline_text("**a** and *b*")).to_equal("<strong>a</strong> and <em>b</em>")

describe "markdown_escape_html":
    it "returns empty string for empty input":
        step("Verify: returns empty string for empty input")
        expect(markdown_escape_html("")).to_equal("")

    it "escapes ampersand first":
        step("Verify: escapes ampersand first")
        expect(markdown_escape_html("&amp;")).to_equal("&amp;amp;")

    it "escapes less-than":
        step("Verify: escapes less-than")
        expect(markdown_escape_html("<b>")).to_equal("&lt;b&gt;")

    it "escapes greater-than":
        step("Verify: escapes greater-than")
        expect(markdown_escape_html(">")).to_equal("&gt;")

    it "escapes double-quote for attribute safety":
        step("Verify: escapes double-quote for attribute safety")
        expect(markdown_escape_html("say \"hi\"")).to_equal("say &quot;hi&quot;")

    it "escapes single-quote for attribute safety":
        step("Verify: escapes single-quote for attribute safety")
        expect(markdown_escape_html("it's")).to_equal("it&#39;s")

    it "escapes all together":
        step("Verify: escapes all together")
        expect(markdown_escape_html("<a href=\"x&y\">")).to_equal("&lt;a href=&quot;x&amp;y&quot;&gt;")

describe "markdown_plain_inline":
    it "returns empty for empty input":
        step("Verify: returns empty for empty input")
        expect(markdown_plain_inline("")).to_equal("")

    it "strips bold markers, keeps text":
        step("Verify: strips bold markers, keeps text")
        expect(markdown_plain_inline("**bold**")).to_equal("bold")

    it "strips italic markers, keeps text":
        step("Verify: strips italic markers, keeps text")
        expect(markdown_plain_inline("*italic*")).to_equal("italic")

    it "strips backtick markers, keeps interior":
        step("Verify: strips backtick markers, keeps interior")
        expect(markdown_plain_inline("`code`")).to_equal("code")

    it "passes plain text unchanged":
        step("Verify: passes plain text unchanged")
        expect(markdown_plain_inline("hello")).to_equal("hello")

    it "drops unbalanced bold markers":
        step("Verify: drops unbalanced bold markers")
        expect(markdown_plain_inline("**oops")).to_equal("oops")

    it "drops lone star in unbalanced italic":
        step("Verify: drops lone star in unbalanced italic")
        expect(markdown_plain_inline("*oops")).to_equal("oops")

    it "keeps escaped star as literal":
        step("Verify: keeps escaped star as literal")
        expect(markdown_plain_inline("\\*literal\\*")).to_equal("*literal*")

    it "code span protects ** from being stripped":
        step("Verify: code span protects ** from being stripped")
        expect(markdown_plain_inline("`**keep**`")).to_equal("**keep**")

describe "markdown_block_kind":
    it "identifies headings":
        step("Verify: identifies headings")
        expect(markdown_block_kind("# Hello")).to_equal("heading")
        expect(markdown_block_kind("## Sub")).to_equal("heading")

    it "identifies code fences":
        step("Verify: identifies code fences")
        expect(markdown_block_kind("```rust")).to_equal("code")
        expect(markdown_block_kind("```")).to_equal("code")

    it "identifies blockquotes":
        step("Verify: identifies blockquotes")
        expect(markdown_block_kind("> quote")).to_equal("blockquote")

    it "identifies lists":
        step("Verify: identifies lists")
        expect(markdown_block_kind("- item")).to_equal("list")
        expect(markdown_block_kind("* item")).to_equal("list")

    it "identifies tables by leading pipe":
        step("Verify: identifies tables by leading pipe")
        expect(markdown_block_kind("| col1 | col2 |")).to_equal("table")

    it "identifies separator rows as table":
        step("Verify: identifies separator rows as table")
        expect(markdown_block_kind("| --- | --- |")).to_equal("table")
        expect(markdown_block_kind("|:---:|---:|")).to_equal("table")

    it "does NOT classify mid-paragraph pipe as table":
        step("Verify: does NOT classify mid-paragraph pipe as table")
        expect(markdown_block_kind("a | b")).to_equal("paragraph")
        expect(markdown_block_kind("true | false logic")).to_equal("paragraph")

    it "identifies plain paragraph":
        step("Verify: identifies plain paragraph")
        expect(markdown_block_kind("Just text")).to_equal("paragraph")

    it "empty string is paragraph":
        step("Verify: empty string is paragraph")
        expect(markdown_block_kind("")).to_equal("paragraph")

describe "parse_markdown_blocks":
    it "returns empty list for empty input":
        step("Verify: returns empty list for empty input")
        val blocks = parse_markdown_blocks("")
        expect(blocks.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "skips blank lines":
        step("Verify: skips blank lines")
        val blocks = parse_markdown_blocks("a\n\nb")
        expect(blocks.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "handles heading with no text (bare #)":
        step("Verify: handles heading with no text (bare #)")
        val blocks = parse_markdown_blocks("#")
        expect(blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(blocks[0].kind).to_equal("heading")

    it "handles unclosed code fence at EOF without crash":
        step("Verify: handles unclosed code fence at EOF without crash")
        val blocks = parse_markdown_blocks("```\ncode line\nno close")
        expect(blocks.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(blocks[0].kind).to_equal("code")
        expect(blocks[1].kind).to_equal("code")
        expect(blocks[2].kind).to_equal("code")

    it "correctly closes a code fence":
        step("Verify: correctly closes a code fence")
        val blocks = parse_markdown_blocks("```\nfoo\n```\nbar")
        expect(blocks.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(blocks[3].kind).to_equal("paragraph")

    it "preserves block from_line and to_line":
        step("Verify: preserves block from_line and to_line")
        val blocks = parse_markdown_blocks("# H\n\npara")
        expect(blocks[0].from_line).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(blocks[1].from_line).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "markdown_slugify":
    it "returns section for empty input":
        step("Verify: returns section for empty input")
        expect(markdown_slugify("")).to_equal("section")

    it "returns section for whitespace-only input":
        step("Verify: returns section for whitespace-only input")
        expect(markdown_slugify("   ")).to_equal("section")

    it "lowercases and replaces spaces with dashes":
        step("Verify: lowercases and replaces spaces with dashes")
        expect(markdown_slugify("Hello World")).to_equal("hello-world")

    it "collapses repeated dashes":
        step("Verify: collapses repeated dashes")
        expect(markdown_slugify("foo  bar")).to_equal("foo-bar")

    it "strips leading and trailing dashes":
        step("Verify: strips leading and trailing dashes")
        expect(markdown_slugify("  hello  ")).to_equal("hello")

    it "strips punctuation":
        step("Verify: strips punctuation")
        expect(markdown_slugify("Hello, World!")).to_equal("hello-world")

    it "handles unicode input without crash":
        step("Verify: handles unicode input without crash")
        val slug = markdown_slugify("こんにちは")
        expect(slug.len() > 0).to_equal(true)

    it "handles already-slug input":
        step("Verify: handles already-slug input")
        expect(markdown_slugify("hello-world")).to_equal("hello-world")

# ============================================================================
# UTF-8 index-space regression: the inline scanner must be BYTE-indexed
# throughout. It previously mixed spaces -- `len()`/`slice()` count BYTES while
# `char_at()` counts CHARACTERS -- so every multi-byte character desynced the
# marker scan from the interior slice.
#
# Every expectation below is HAND-COMPUTED from the UTF-8 encoding:
#   e-acute  U+00E9  = C3 A9        2 bytes, 1 character
#   CJK zhong U+4E2D = E4 B8 AD     3 bytes, 1 character
#   party    U+1F389 = F0 9F 8E 89  4 bytes, 1 character
#   BOM      U+FEFF  = EF BB BF     3 bytes, 1 character
# ============================================================================

describe "markdown_inline_text UTF-8 index space":
    # "\u{e9}*x*" is 5 BYTES (C3 A9 2A 78 2A) but 4 CHARACTERS. With the old
    # character-indexed scan the italic interior was slice(2,3) = "*" and the
    # len()-bounded loop then ran one index past the last character.
    it "keeps a 2-byte character before an italic span":
        step("Verify: keeps a 2-byte character before an italic span")
        expect(markdown_inline_text("\u{e9}*x*")).to_equal("\u{e9}<em>x</em>")

    it "keeps a 3-byte character before an italic span":
        step("Verify: keeps a 3-byte character before an italic span")
        expect(markdown_inline_text("\u{4e2d}*x*")).to_equal("\u{4e2d}<em>x</em>")

    it "keeps a 4-byte character before an italic span":
        step("Verify: keeps a 4-byte character before an italic span")
        expect(markdown_inline_text("\u{1f389}*x*")).to_equal("\u{1f389}<em>x</em>")

    # ASCII control: the same shape with a 1-byte leading character was always
    # correct, which is what hid the defect.
    it "ASCII control -- same shape, single-byte leading character":
        step("Verify: ASCII control -- same shape, single-byte leading character")
        expect(markdown_inline_text("e*x*")).to_equal("e<em>x</em>")

    it "carries a 2-byte character inside an italic span":
        step("Verify: carries a 2-byte character inside an italic span")
        expect(markdown_inline_text("*\u{e9}*")).to_equal("<em>\u{e9}</em>")

    it "carries a multi-byte character inside a bold span":
        step("Verify: carries a multi-byte character inside a bold span")
        expect(markdown_inline_text("**h\u{e9}llo**")).to_equal("<strong>h\u{e9}llo</strong>")

    it "carries a multi-byte character inside a code span":
        step("Verify: carries a multi-byte character inside a code span")
        expect(markdown_inline_text("`caf\u{e9}`")).to_equal("<code>caf\u{e9}</code>")

    # Pure literal text: each character must be copied whole, never split and
    # never truncated by the byte-length loop bound.
    it "passes multi-byte literal text through byte-for-byte":
        step("Verify: passes multi-byte literal text through byte-for-byte")
        expect(markdown_inline_text("h\u{e9}llo w\u{f6}rld")).to_equal("h\u{e9}llo w\u{f6}rld")

    it "passes a CJK literal through unchanged":
        step("Verify: passes a CJK literal through unchanged")
        expect(markdown_inline_text("\u{4e2d}\u{6587}")).to_equal("\u{4e2d}\u{6587}")

    it "passes a 4-byte emoji literal through unchanged":
        step("Verify: passes a 4-byte emoji literal through unchanged")
        expect(markdown_inline_text("\u{1f389}\u{1f389}")).to_equal("\u{1f389}\u{1f389}")

    # A literal BOM is a 3-byte character like any other and must survive whole.
    it "passes a literal BOM character through unchanged":
        step("Verify: passes a literal BOM character through unchanged")
        expect(markdown_inline_text("\u{feff}hi")).to_equal("\u{feff}hi")

    # Byte length is preserved for marker-free input: proves nothing was split,
    # dropped, or appended as nil.
    # "caf" 3 + e-acute 2 + " " 1 + CJK 3 + " " 1 + emoji 4 = 14 BYTES.
    it "preserves byte length of marker-free multi-byte text":
        step("Verify: preserves byte length of marker-free multi-byte text")
        expect(markdown_inline_text("caf\u{e9} \u{4e2d} \u{1f389}").len()).to_equal(14)

describe "markdown_plain_inline UTF-8 index space":
    it "strips italic markers around ASCII after a 2-byte character":
        step("Verify: strips italic markers around ASCII after a 2-byte character")
        expect(markdown_plain_inline("\u{e9}*x*")).to_equal("\u{e9}x")

    it "strips bold markers around multi-byte content":
        step("Verify: strips bold markers around multi-byte content")
        expect(markdown_plain_inline("**h\u{e9}llo**")).to_equal("h\u{e9}llo")

    it "strips code markers around multi-byte content":
        step("Verify: strips code markers around multi-byte content")
        expect(markdown_plain_inline("`caf\u{e9}`")).to_equal("caf\u{e9}")

    it "ASCII control -- strips italic markers":
        step("Verify: ASCII control -- strips italic markers")
        expect(markdown_plain_inline("e*x*")).to_equal("ex")

    it "passes multi-byte literal text through unchanged":
        step("Verify: passes multi-byte literal text through unchanged")
        expect(markdown_plain_inline("h\u{e9}llo w\u{f6}rld")).to_equal("h\u{e9}llo w\u{f6}rld")
