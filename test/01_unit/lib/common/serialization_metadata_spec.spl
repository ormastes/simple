describe "Compression Markers":
    """
    ## Compression Marker Functions

    Tests marking and checking, plus negative cases.
    """

    it "marks data as compressed":
        # @req: REQ-LIB-COMMON-001
        step("Verify: marks data as compressed")
        val result = mark_compressed("payload")
        expect(result).to_equal("@Compressed\{payload\}")

    it "detects compressed data":
        # @req: REQ-LIB-COMMON-001
        step("Verify: detects compressed data")
        val marked = mark_compressed("payload")
        expect(is_compressed(marked)).to_equal(true)

    it "returns false for non-compressed data":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns false for non-compressed data")
        expect(is_compressed("plain")).to_equal(false)

    it "returns false for short input":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns false for short input")
        expect(is_compressed("ab")).to_equal(false)

describe "Encryption Markers":
    """
    ## Encryption Marker Functions

    Tests marking and checking, plus negative cases.
    """

    it "marks data as encrypted":
        # @req: REQ-LIB-COMMON-001
        step("Verify: marks data as encrypted")
        val result = mark_encrypted("payload")
        expect(result).to_equal("@Encrypted\{payload\}")

    it "detects encrypted data":
        # @req: REQ-LIB-COMMON-001
        step("Verify: detects encrypted data")
        val marked = mark_encrypted("payload")
        expect(is_encrypted(marked)).to_equal(true)

    it "returns false for non-encrypted data":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns false for non-encrypted data")
        expect(is_encrypted("plain")).to_equal(false)

    it "returns false for short input":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns false for short input")
        expect(is_encrypted("ab")).to_equal(false)

# ============================================================================
# Test Group 20: Byte Array Utilities (utilities.spl)
# ============================================================================

describe "write_bytes":
    """
    ## Byte Array Writing
    """

    it "prepends length as varint":
        # @req: REQ-LIB-COMMON-001
        step("Verify: prepends length as varint")
        val result = write_bytes([10, 20, 30])
        expect(result[0]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(result.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "writes empty byte array":
        # @req: REQ-LIB-COMMON-001
        step("Verify: writes empty byte array")
        val result = write_bytes([])
        expect(result[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "read_bytes":
    """
    ## Byte Array Reading

    Tests normal read, read beyond bounds, and empty read.
    """

    it "reads specified number of bytes":
        # @req: REQ-LIB-COMMON-001
        step("Verify: reads specified number of bytes")
        val data = [10, 20, 30, 40, 50]
        val result = read_bytes(data, 1, 3)
        val bytes = result.0
        expect(bytes.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(bytes[0]).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(bytes[1]).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(bytes[2]).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "handles read beyond array bounds":
        # @req: REQ-LIB-COMMON-001
        step("Verify: handles read beyond array bounds")
        val data = [10, 20]
        val result = read_bytes(data, 0, 5)
        val bytes = result.0
        expect(bytes.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "reads zero bytes":
        # @req: REQ-LIB-COMMON-001
        step("Verify: reads zero bytes")
        val result = read_bytes([1, 2, 3], 0, 0)
        val bytes = result.0
        expect(bytes.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "read_bytes_with_length":
    """
    ## Length-Prefixed Byte Reading

    Roundtrip test with write_bytes.
    """

    it "roundtrips with write_bytes":
        # @req: REQ-LIB-COMMON-001
        step("Verify: roundtrips with write_bytes")
        val original = [65, 66, 67]
        val written = write_bytes(original)
        val result = read_bytes_with_length(written, 0)
        val data = result.0
        val consumed = result.1
        expect(data.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(data[0]).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(data[1]).to_equal(66)  # oracle: 66 — named expected value from the requirement
        expect(data[2]).to_equal(67)  # oracle: 67 — named expected value from the requirement

