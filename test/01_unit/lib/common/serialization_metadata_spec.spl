# @covers src/lib/common/serialization/utilities.spl 70%
"""
# Serialization Metadata Coverage Specification

**Feature IDs:** #SERIAL-COV-METADATA
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Branch-coverage tests for metadata, tagging, versioning, schema, cloning, hashing,
compression/encryption markers, binary I/O, and hex encoding:
- Type tagging: tag_type, get_type_tag, strip_type_tag (utilities.spl)
- Schema validation: define_schema, validate_field_type (utilities.spl)
- Versioning: add_version, get_version, strip_version (utilities.spl)
- Deep cloning, equality, structural hashing (utilities.spl)
- Compression/encryption markers (utilities.spl)
- Binary I/O: write_bytes, read_bytes (serialize.spl)
- Hex encoding: int_to_hex, bytes_to_hex, hex_to_bytes (serialize.spl)
"""

use serialization.*

# ============================================================================
# Test Group 13: Type Tagging (utilities.spl)
# ============================================================================

use std.spec.step

describe "tag_type":
    """
    ## Type Tagging
    """

    it "wraps content with type annotation":
        # @req: REQ-LIB-COMMON-001
        step("Verify: wraps content with type annotation")
        val result = tag_type("payload", "MyType")
        expect(result).to_equal("@MyType\{payload\}")

describe "get_type_tag":
    """
    ## Type Tag Extraction

    Tests valid tagged, too short, missing @, no brace, and nil return.
    """

    it "extracts tag from tagged string":
        # @req: REQ-LIB-COMMON-001
        step("Verify: extracts tag from tagged string")
        val result = get_type_tag("@MyType\{payload\}")
        expect(result).to_equal("MyType")

    it "returns nil for short string":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns nil for short string")
        val result = get_type_tag("ab")
        expect(result).to_be_nil()

    it "returns nil when not starting with @":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns nil when not starting with @")
        val result = get_type_tag("NoAt\{payload\}")
        expect(result).to_be_nil()

    it "returns nil when no opening brace":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns nil when no opening brace")
        val result = get_type_tag("@NobraceHere")
        expect(result).to_be_nil()

describe "strip_type_tag":
    """
    ## Type Tag Stripping

    Tests tagged input, untagged input, and edge cases.
    """

    it "strips tag and returns inner content":
        # @req: REQ-LIB-COMMON-001
        step("Verify: strips tag and returns inner content")
        val result = strip_type_tag("@MyType\{payload\}")
        expect(result).to_equal("payload")

    it "returns original when no tag present":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns original when no tag present")
        val result = strip_type_tag("notatag")
        expect(result).to_equal("notatag")

    it "returns original for short input":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns original for short input")
        val result = strip_type_tag("ab")
        expect(result).to_equal("ab")

# ============================================================================
# Test Group 14: Schema Validation (utilities.spl)
# ============================================================================

describe "define_schema":
    """
    ## Schema Definition
    """

    it "creates dict representation of schema":
        # @req: REQ-LIB-COMMON-001
        step("Verify: creates dict representation of schema")
        val result = define_schema([("name", "text"), ("age", "int")])
        expect(result).to_contain("name: text")
        expect(result).to_contain("age: int")

describe "validate_field_type":
    """
    ## Field Type Validation

    Tests all type branches: int, bool, nil, text, list, tuple, dict, and unknown.
    """

    it "validates int type":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates int type")
        expect(validate_field_type("42", "int")).to_equal(true)

    it "rejects non-numeric as int":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-numeric as int")
        expect(validate_field_type("abc", "int")).to_equal(false)

    it "validates true as bool":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates true as bool")
        expect(validate_field_type("true", "bool")).to_equal(true)

    it "validates false as bool":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates false as bool")
        expect(validate_field_type("false", "bool")).to_equal(true)

    it "rejects non-bool as bool":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-bool as bool")
        expect(validate_field_type("42", "bool")).to_equal(false)

    it "validates nil type":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates nil type")
        expect(validate_field_type("nil", "nil")).to_equal(true)

    it "rejects non-nil as nil":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-nil as nil")
        expect(validate_field_type("42", "nil")).to_equal(false)

    it "validates text type by leading quote":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates text type by leading quote")
        expect(validate_field_type("\"hello\"", "text")).to_equal(true)

    it "rejects non-quoted as text":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-quoted as text")
        expect(validate_field_type("hello", "text")).to_equal(false)

    it "validates list type by leading bracket":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates list type by leading bracket")
        expect(validate_field_type("[1, 2]", "list")).to_equal(true)

    it "rejects non-list as list":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-list as list")
        expect(validate_field_type("42", "list")).to_equal(false)

    it "validates tuple type by leading paren":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates tuple type by leading paren")
        expect(validate_field_type("(1, 2)", "tuple")).to_equal(true)

    it "rejects non-tuple as tuple":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-tuple as tuple")
        expect(validate_field_type("42", "tuple")).to_equal(false)

    it "validates dict type by leading brace":
        # @req: REQ-LIB-COMMON-001
        step("Verify: validates dict type by leading brace")
        expect(validate_field_type("{k: v}", "dict")).to_equal(true)

    it "rejects non-dict as dict":
        # @req: REQ-LIB-COMMON-001
        step("Verify: rejects non-dict as dict")
        expect(validate_field_type("42", "dict")).to_equal(false)

    it "returns true for unknown type":
        # @req: REQ-LIB-COMMON-001
        step("Verify: returns true for unknown type")
        expect(validate_field_type("anything", "custom_type")).to_equal(true)

