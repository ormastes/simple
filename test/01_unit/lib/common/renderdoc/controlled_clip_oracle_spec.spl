# @tag: unit, renderdoc, REQ-2D-003, REQ-2D-005, NFR-2D-003

use std.spec.{describe, it, expect, fail}
use std.spec.step
use common.renderdoc.controlled_clip_oracle.{
    controlled_clip_expected_rgba, controlled_clip_capture_matches_oracle}
use common.renderdoc.final_output_pixels.{
    FinalOutputMetadata, FinalOutputCapture}

fn _pixel(rgba: [i64], x: i32, y: i32) -> [i64]:
    val offset = (y * 16 + x) * 4
    rgba[offset:offset + 4]

fn _capture(bytes: [i64]) -> FinalOutputCapture:
    FinalOutputCapture(
        metadata: FinalOutputMetadata(
            fixture_id: "controlled-clipped-rect-v2",
            fixture_digest: "b16d53f7785a09559bf209797fcb724906f896b93d23eff512bda69ec44d8f2f",
            frame_id: "clip-oracle-test", resource_id: "device-output",
            selected_resource_count: 1, mip_level: 0, array_layer: 0,
            submission_token: "completed-clip-1",
            completion_token: "completed-clip-1",
            frame_complete: true, readback_complete: true,
            device_status: "ready", width: 16, height: 16, stride: 64,
            pixel_format: "R8G8B8A8_UNORM", alpha_mode: "opaque",
            color_space: "srgb", color_primaries: "srgb",
            transfer_function: "srgb", origin: "top-left",
            crop_x: 0, crop_y: 0, crop_width: 16, crop_height: 16),
        pixel_bytes: bytes)

describe "independent clipped rectangle oracle":
    it "pins visible, empty, disjoint, and later unclipped coverage":
        # @req REQ-2D-003 REQ-2D-005 NFR-2D-003
        step("Build analytic pixels without decoding the DrawIR fixture")
        match controlled_clip_expected_rgba():
            Ok(rgba):
                expect(rgba.len()).to_equal(1024)
                expect(_pixel(rgba, 2, 3)).to_equal([51, 102, 153, 255])
                expect(_pixel(rgba, 6, 8)).to_equal([51, 102, 153, 255])
                expect(_pixel(rgba, 7, 8)).to_equal([16, 32, 48, 255])
                expect(_pixel(rgba, 4, 4)).to_equal([51, 102, 153, 255])
                expect(_pixel(rgba, 10, 11)).to_equal([170, 85, 0, 255])
                expect(_pixel(rgba, 13, 13)).to_equal([170, 85, 0, 255])
                expect(_pixel(rgba, 14, 13)).to_equal([16, 32, 48, 255])
            Err(reason): fail("Pinned clipped oracle failed: {reason}")

    it "rejects a capture that lost the unclipped draw after clip state":
        # @req REQ-2D-003 REQ-2D-005 NFR-2D-003
        step("Replace a later orange pixel with background and compare")
        match controlled_clip_expected_rgba():
            Ok(rgba):
                match controlled_clip_capture_matches_oracle(_capture(rgba)):
                    Ok(matches): expect(matches).to_equal(true)
                    Err(reason): fail("Exact clipped capture rejected: {reason}")
                var wrong = rgba
                val offset = (11 * 16 + 10) * 4
                wrong[offset] = 16
                wrong[offset + 1] = 32
                wrong[offset + 2] = 48
                match controlled_clip_capture_matches_oracle(_capture(wrong)):
                    Ok(matches): expect(matches).to_equal(false)
                    Err(reason): fail("Wrong clip pixels rejected before comparison: {reason}")
            Err(reason): fail("Pinned clipped oracle failed: {reason}")
