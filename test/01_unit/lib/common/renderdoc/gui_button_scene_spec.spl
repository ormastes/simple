# @req REQ-2D-006
# @req NFR-2D-002
"""The pinned GUI button scene must retain widget state through strict DrawIR."""

use std.spec.{describe, it, expect}
use common.renderdoc.gui_button_scene.{
    GUI_BUTTON_WIDGET_ID, GUI_BUTTON_SURFACE_ARGB,
    GUI_BUTTON_RESTING_ARGB, GUI_BUTTON_PRESSED_ARGB,
    gui_button_fixture_scene, gui_button_qualification_theme,
    gui_button_scene_input_sha256}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU, DRAW_IR_COMMAND_RECT, DRAW_IR_SOURCE_GUI_AST}
use common.ui.ui_ir.{draw_ir_to_ui_ir}
use std.skia.backend.upstream_ganesh_vulkan.provider.{
    upstream_skia_ganesh_vulkan_preflight}

describe "pinned GUI button Vulkan source scene":
    it "keeps a real widget producer and two opaque states admissible":
        val theme = gui_button_qualification_theme()
        val resting_input_sha = gui_button_scene_input_sha256(false)
        val pressed_input_sha = gui_button_scene_input_sha256(true)
        expect(theme.source_manifest_sha256.len()).to_equal(64)
        expect(theme.material_sha256.len()).to_equal(64)
        expect(resting_input_sha.len()).to_equal(64)
        expect(pressed_input_sha.len()).to_equal(64)
        expect(resting_input_sha == pressed_input_sha).to_equal(false)
        val resting = gui_button_fixture_scene(false)
        val pressed = gui_button_fixture_scene(true)
        expect(resting.backend_target).to_equal(DRAW_IR_BACKEND_GPU)
        expect(pressed.backend_target).to_equal(DRAW_IR_BACKEND_GPU)
        expect(resting.batches.len()).to_equal(1)
        expect(pressed.batches.len()).to_equal(1)
        val resting_batch = resting.batches[0]
        val pressed_batch = pressed.batches[0]
        expect(resting_batch.source.source_kind).to_equal(DRAW_IR_SOURCE_GUI_AST)
        expect(pressed_batch.source.source_kind).to_equal(DRAW_IR_SOURCE_GUI_AST)
        expect(resting_batch.commands.len()).to_equal(2)
        expect(pressed_batch.commands.len()).to_equal(2)
        for batch in [resting_batch, pressed_batch]:
            expect(batch.embedding.width).to_equal(16)
            expect(batch.embedding.height).to_equal(16)
            expect(batch.commands[0].kind).to_equal(DRAW_IR_COMMAND_RECT)
            expect(batch.commands[0].x).to_equal(0)
            expect(batch.commands[0].y).to_equal(0)
            expect(batch.commands[0].width).to_equal(16)
            expect(batch.commands[0].height).to_equal(16)
            expect(batch.commands[0].color).to_equal(GUI_BUTTON_SURFACE_ARGB)
            expect(batch.commands[1].kind).to_equal(DRAW_IR_COMMAND_RECT)
            expect(batch.commands[1].component_id).to_equal(GUI_BUTTON_WIDGET_ID)
            expect(batch.commands[1].x).to_equal(0)
            expect(batch.commands[1].y).to_equal(0)
            expect(batch.commands[1].width).to_equal(16)
            expect(batch.commands[1].height).to_equal(16)
            expect(batch.commands[1].computed_style.len()).to_equal(0)
        expect(resting_batch.commands[1].color).to_equal(GUI_BUTTON_RESTING_ARGB)
        expect(pressed_batch.commands[1].color).to_equal(GUI_BUTTON_PRESSED_ARGB)
        expect(resting_batch.commands[1].color == pressed_batch.commands[1].color).to_equal(false)
        expect(draw_ir_to_ui_ir(resting).accepted).to_equal(true)
        expect(draw_ir_to_ui_ir(pressed).accepted).to_equal(true)
        val resting_admission = upstream_skia_ganesh_vulkan_preflight(resting)
        val pressed_admission = upstream_skia_ganesh_vulkan_preflight(pressed)
        expect(resting_admission.accepted).to_equal(true)
        expect(pressed_admission.accepted).to_equal(true)
        expect(resting_admission.rect_count).to_equal(2)
        expect(pressed_admission.rect_count).to_equal(2)
