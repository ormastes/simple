# @tag: unit, renderdoc, REQ-2D-006, NFR-2D-002
# Source/oracle checks only; synthetic captures never qualify physical Vulkan.

use std.spec.{describe, it, expect, fail}
use std.spec.step
use common.renderdoc.gui_button_qualification.{
    GUI_BUTTON_RESTING_SHA256, GUI_BUTTON_PRESSED_SHA256,
    GUI_BUTTON_THEME_MATERIAL_SHA256, GUI_BUTTON_THEME_SOURCE_SHA256,
    GUI_BUTTON_RESTING_INPUT_SHA256, GUI_BUTTON_PRESSED_INPUT_SHA256,
    gui_button_qualification_input_sha256,
    gui_button_prepared_scene, gui_button_checked_draw_ir,
    gui_button_expected_rgba, gui_button_capture_matches_oracle}
use common.renderdoc.gui_button_scene.{
    gui_button_qualification_theme, gui_button_scene_input_sha256}
use common.renderdoc.final_output_pixels.{
    FinalOutputMetadata, FinalOutputCapture}

fn _synthetic_capture(bytes: [i64], pressed: bool) -> FinalOutputCapture:
    val fixture_id = if pressed: "gui-button-16x16-v1-pressed"
        else: "gui-button-16x16-v1-resting"
    val fixture_sha = if pressed: GUI_BUTTON_PRESSED_SHA256 else:
        GUI_BUTTON_RESTING_SHA256
    FinalOutputCapture(
        metadata: FinalOutputMetadata(
            fixture_id: fixture_id, fixture_digest: fixture_sha,
            frame_id: "synthetic-oracle-check", resource_id: "synthetic",
            selected_resource_count: 1, mip_level: 0, array_layer: 0,
            submission_token: "synthetic-1", completion_token: "synthetic-1",
            frame_complete: true, readback_complete: true,
            device_status: "ready", width: 16, height: 16, stride: 64,
            pixel_format: "R8G8B8A8_UNORM", alpha_mode: "opaque",
            color_space: "srgb", color_primaries: "srgb",
            transfer_function: "srgb", origin: "top-left",
            crop_x: 0, crop_y: 0, crop_width: 16, crop_height: 16),
        pixel_bytes: bytes)

describe "pinned GUI button qualification source and oracle":
    it "requires two distinct source states and widget DrawIR":
        # @req REQ-2D-006 NFR-2D-002
        step("Pin both fixture manifests and widget input states")
        val resting = match gui_button_prepared_scene(false):
            Ok(value): value
            Err(reason): fail("Resting source invalid: {reason}")
        val pressed = match gui_button_prepared_scene(true):
            Ok(value): value
            Err(reason): fail("Pressed source invalid: {reason}")
        expect(resting.source_sha256 == pressed.source_sha256).to_equal(false)
        val theme = gui_button_qualification_theme()
        expect(theme.material_sha256).to_equal(
            GUI_BUTTON_THEME_MATERIAL_SHA256)
        expect(theme.source_manifest_sha256).to_equal(
            GUI_BUTTON_THEME_SOURCE_SHA256)
        expect(gui_button_scene_input_sha256(false)).to_equal(
            GUI_BUTTON_RESTING_INPUT_SHA256)
        expect(gui_button_scene_input_sha256(true)).to_equal(
            GUI_BUTTON_PRESSED_INPUT_SHA256)
        expect(gui_button_qualification_input_sha256(false)).to_equal(
            GUI_BUTTON_RESTING_INPUT_SHA256)
        expect(gui_button_qualification_input_sha256(true)).to_equal(
            GUI_BUTTON_PRESSED_INPUT_SHA256)
        match gui_button_checked_draw_ir(false):
            Ok(draw): expect(draw.batches.len()).to_equal(1)
            Err(reason): fail("Resting widget DrawIR invalid: {reason}")
        match gui_button_checked_draw_ir(true):
            Ok(draw): expect(draw.batches.len()).to_equal(1)
            Err(reason): fail("Pressed widget DrawIR invalid: {reason}")

    it "rejects a wrong state and a changed byte against exact pixels":
        # @req REQ-2D-006 NFR-2D-002
        step("Compare independent uniform pixels for each state")
        val resting = match gui_button_expected_rgba(false):
            Ok(value): value
            Err(reason): fail("Resting oracle unavailable: {reason}")
        val pressed = match gui_button_expected_rgba(true):
            Ok(value): value
            Err(reason): fail("Pressed oracle unavailable: {reason}")
        expect(resting.len()).to_equal(1024)
        expect(pressed.len()).to_equal(1024)
        expect(resting[0:4]).to_equal([39, 113, 199, 255])
        expect(pressed[0:4]).to_equal([45, 90, 136, 255])
        match gui_button_capture_matches_oracle(
            _synthetic_capture(resting, false), false):
            Ok(matches): expect(matches).to_equal(true)
            Err(reason): fail("Resting oracle rejected exact pixels: {reason}")
        match gui_button_capture_matches_oracle(
            _synthetic_capture(pressed, true), false):
            Ok(_): fail("Wrong fixture state was accepted")
            Err(reason): expect(reason).to_equal(
                "gui-button-final-capture-domain-mismatch")
        var wrong = pressed
        wrong[0] = 44
        match gui_button_capture_matches_oracle(
            _synthetic_capture(wrong, true), true):
            Ok(matches): expect(matches).to_equal(false)
            Err(reason): fail("Changed byte bypassed pixel comparison: {reason}")
