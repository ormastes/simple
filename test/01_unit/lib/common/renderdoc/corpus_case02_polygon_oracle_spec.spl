# @req REQ-2D-003
# @req REQ-2D-004
# @req REQ-2D-006
# @req NFR-2D-003
# @req NFR-2D-004
# @tag: unit, renderdoc, corpus, analytic_oracle, coverage_aa
"""Independent ideal-area case 02 pixels; no physical GPU PASS is claimed."""

use std.spec.{describe, it, expect, fail_test}
use std.spec.step
use common.renderdoc.final_output_pixels.{
    FinalOutputCapture, FinalOutputMetadata}
use common.renderdoc.corpus_case02_polygon_oracle.{
    CORPUS_CASE02_FIXTURE_ID, CORPUS_CASE02_SOURCE_SHA256,
    CORPUS_CASE02_RGBA_SHA256, CORPUS_CASE02_WIDTH, CORPUS_CASE02_HEIGHT,
    case02_analytic_oracle, case02_compare_canonical_rgba,
    case02_capture_matches_oracle}
use std.common.crypto.sha256.{sha256_bytes}
use std.common.crypto.types.{bytes_to_hex}

fn _offset(x: i32, y: i32) -> i64:
    (y * CORPUS_CASE02_WIDTH + x).to_i64() * 4

fn _copy_bytes(source: [i64]) -> [i64]:
    var copy: [i64] = []
    for byte in source:
        copy.push(byte)
    copy

fn _metadata() -> FinalOutputMetadata:
    FinalOutputMetadata(
        fixture_id: CORPUS_CASE02_FIXTURE_ID,
        fixture_digest: CORPUS_CASE02_SOURCE_SHA256,
        frame_id: "synthetic-oracle-frame",
        resource_id: "synthetic-oracle-resource",
        selected_resource_count: 1,
        mip_level: 0, array_layer: 0,
        submission_token: "synthetic-complete-1",
        completion_token: "synthetic-complete-1",
        frame_complete: true, readback_complete: true,
        device_status: "ready",
        width: CORPUS_CASE02_WIDTH.to_i64(),
        height: CORPUS_CASE02_HEIGHT.to_i64(),
        stride: CORPUS_CASE02_WIDTH.to_i64() * 4,
        pixel_format: "R8G8B8A8_UNORM", alpha_mode: "opaque",
        color_space: "srgb", color_primaries: "srgb",
        transfer_function: "srgb", origin: "top-left",
        crop_x: 0, crop_y: 0,
        crop_width: CORPUS_CASE02_WIDTH.to_i64(),
        crop_height: CORPUS_CASE02_HEIGHT.to_i64())

describe "pinned case 02 independent polygon-square coverage":
    it "pins source, exact oracle bytes, regions and boundary probes":
        step("Build the independent coverage-aa target from authored CSS constants")
        val oracle = match case02_analytic_oracle():
            Ok(value): value
            Err(reason): fail_test("case02 oracle unavailable: {reason}")
        expect(oracle.rgba.len()).to_equal(1228800)
        expect(oracle.edge_mask.len()).to_equal(307200)
        expect(bytes_to_hex(sha256_bytes(oracle.rgba))).to_equal(
            CORPUS_CASE02_RGBA_SHA256)
        expect(oracle.tile_interior_pixels).to_equal(17730)
        expect(oracle.bar_interior_pixels).to_equal(558)
        expect(oracle.exterior_pixels).to_equal(287998)
        expect(oracle.tile_edge_pixels).to_equal(629)
        expect(oracle.bar_edge_pixels).to_equal(285)
        expect(oracle.rgba[_offset(0, 0):_offset(0, 0) + 4]).to_equal(
            [255, 255, 255, 255])
        expect(oracle.rgba[_offset(100, 100):_offset(100, 100) + 4]).to_equal(
            [36, 123, 222, 255])
        expect(oracle.rgba[_offset(291, 100):_offset(291, 100) + 4]).to_equal(
            [17, 17, 17, 255])
        expect(oracle.rgba[_offset(293, 100):_offset(293, 100) + 4]).to_equal(
            [255, 255, 255, 255])
        expect(oracle.rgba[_offset(47, 40):_offset(47, 40) + 4]).to_equal(
            [111, 168, 233, 255])
        expect(oracle.rgba[_offset(290, 40):_offset(290, 40) + 4]).to_equal(
            [166, 166, 166, 255])
        expect(oracle.edge_mask[_offset(47, 40) / 4]).to_equal(true)
        expect(oracle.edge_mask[_offset(290, 40) / 4]).to_equal(true)

    it "accepts ideal canonical bytes and rejects wrong exact-region pixels":
        val oracle = match case02_analytic_oracle():
            Ok(value): value
            Err(reason): fail_test("case02 oracle unavailable: {reason}")
        val ideal = match case02_compare_canonical_rgba(oracle.rgba):
            Ok(value): value
            Err(reason): fail_test("ideal case02 bytes invalid: {reason}")
        expect(ideal.passed).to_equal(true)
        expect(ideal.exact_mismatch_pixels).to_equal(0)
        expect(ideal.edge_excess_pixels).to_equal(0)
        var wrong = _copy_bytes(oracle.rgba)
        wrong[_offset(0, 0)] = 254
        wrong[_offset(100, 100)] = 35
        val mismatch = match case02_compare_canonical_rgba(wrong):
            Ok(value): value
            Err(reason): fail_test("wrong case02 bytes rejected as malformed: {reason}")
        expect(mismatch.passed).to_equal(false)
        expect(mismatch.exact_mismatch_pixels).to_equal(2)

    it "applies only the predeclared edge channel and mean tolerances":
        val oracle = match case02_analytic_oracle():
            Ok(value): value
            Err(reason): fail_test("case02 oracle unavailable: {reason}")
        var near = _copy_bytes(oracle.rgba)
        near[_offset(47, 40)] = near[_offset(47, 40)] + 8
        val admitted = match case02_compare_canonical_rgba(near):
            Ok(value): value
            Err(reason): fail_test("near-edge case02 bytes invalid: {reason}")
        expect(admitted.passed).to_equal(true)
        expect(admitted.edge_max_channel_delta).to_equal(8)
        var far = _copy_bytes(oracle.rgba)
        far[_offset(47, 40)] = far[_offset(47, 40)] + 17
        val excess = match case02_compare_canonical_rgba(far):
            Ok(value): value
            Err(reason): fail_test("far-edge case02 bytes invalid: {reason}")
        expect(excess.passed).to_equal(false)
        expect(excess.edge_excess_pixels).to_equal(1)
        var aggregate = _copy_bytes(oracle.rgba)
        var pixel: i64 = 0
        while pixel < oracle.edge_mask.len():
            if oracle.edge_mask[pixel]:
                var channel = 0
                while channel < 3:
                    val offset = pixel * 4 + channel
                    if aggregate[offset] < 251:
                        aggregate[offset] = aggregate[offset] + 5
                    else:
                        aggregate[offset] = aggregate[offset] - 5
                    channel = channel + 1
            pixel = pixel + 1
        val mean_excess = match case02_compare_canonical_rgba(aggregate):
            Ok(value): value
            Err(reason): fail_test("aggregate case02 bytes invalid: {reason}")
        expect(mean_excess.passed).to_equal(false)
        expect(mean_excess.edge_excess_pixels).to_equal(0)
        expect(mean_excess.edge_channel_abs_sum).to_equal(
            mean_excess.edge_channel_count * 5)

    it "requires a completed canonical capture tied to the pinned source":
        val oracle = match case02_analytic_oracle():
            Ok(value): value
            Err(reason): fail_test("case02 oracle unavailable: {reason}")
        val synthetic = FinalOutputCapture(
            metadata: _metadata(), pixel_bytes: oracle.rgba)
        val verdict = match case02_capture_matches_oracle(synthetic):
            Ok(value): value
            Err(reason): fail_test("synthetic case02 capture invalid: {reason}")
        expect(verdict.passed).to_equal(true)
        var wrong_digest = _metadata()
        wrong_digest.fixture_digest =
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val unbound = case02_capture_matches_oracle(FinalOutputCapture(
            metadata: wrong_digest, pixel_bytes: oracle.rgba))
        match unbound:
            Ok(_value): fail_test("unbound case02 capture was admitted")
            Err(reason): expect(reason).to_equal("case02-capture-domain-mismatch")
