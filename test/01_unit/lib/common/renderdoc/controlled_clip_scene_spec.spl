# @tag: unit, renderdoc, draw_ir, REQ-2D-006

use std.spec.*
use std.fs.{read_file}
use std.common.crypto.sha256.{sha256_text}
use common.renderdoc.controlled_clip_scene.{
    simple_2d_controlled_clip_fixture_scene,
    simple_2d_controlled_clip_scene_from_source}

describe "pinned controlled clipped rectangle DrawIR source":
    it "parses five ordered commands and preserves every target-space clip":
        # @req REQ-2D-006
        val source = read_file("test/fixtures/simple_2d_skia/controlled_clipped_rect_v2.sdn")
        expect(sha256_text(source)).to_equal(
            "b16d53f7785a09559bf209797fcb724906f896b93d23eff512bda69ec44d8f2f")
        match simple_2d_controlled_clip_fixture_scene():
            Ok(scene):
                expect(scene.backend_target).to_equal("gpu")
                expect(scene.batches.len()).to_equal(1)
                val batch = scene.batches[0]
                expect(batch.embedding.width).to_equal(16)
                expect(batch.embedding.height).to_equal(16)
                expect(batch.embedding.clip).to_equal(false)
                expect(batch.commands.len()).to_equal(5)
                val clear = batch.commands[0]
                expect(clear.x).to_equal(0)
                expect(clear.y).to_equal(0)
                expect(clear.width).to_equal(16)
                expect(clear.height).to_equal(16)
                expect(clear.color).to_equal(0xff102030u32)
                expect(clear.clip_rect.present).to_equal(false)
                val clipped = batch.commands[1]
                expect(clipped.x).to_equal(-2)
                expect(clipped.y).to_equal(-2)
                expect(clipped.width).to_equal(20)
                expect(clipped.height).to_equal(20)
                expect(clipped.color).to_equal(0xff336699u32)
                expect(clipped.clip_rect.present).to_equal(true)
                expect(clipped.clip_rect.x).to_equal(2)
                expect(clipped.clip_rect.y).to_equal(3)
                expect(clipped.clip_rect.width).to_equal(5)
                expect(clipped.clip_rect.height).to_equal(6)
                val empty_clip = batch.commands[2]
                expect(empty_clip.color).to_equal(0xffff0000u32)
                expect(empty_clip.clip_rect.present).to_equal(true)
                expect(empty_clip.clip_rect.x).to_equal(4)
                expect(empty_clip.clip_rect.y).to_equal(4)
                expect(empty_clip.clip_rect.width).to_equal(0)
                expect(empty_clip.clip_rect.height).to_equal(8)
                val disjoint = batch.commands[3]
                expect(disjoint.color).to_equal(0xff00ff00u32)
                expect(disjoint.clip_rect.present).to_equal(true)
                expect(disjoint.clip_rect.x).to_equal(20)
                expect(disjoint.clip_rect.y).to_equal(20)
                expect(disjoint.clip_rect.width).to_equal(3)
                expect(disjoint.clip_rect.height).to_equal(3)
                val final_rect = batch.commands[4]
                expect(final_rect.x).to_equal(10)
                expect(final_rect.y).to_equal(11)
                expect(final_rect.width).to_equal(4)
                expect(final_rect.height).to_equal(3)
                expect(final_rect.color).to_equal(0xffaa5500u32)
                expect(final_rect.clip_rect.present).to_equal(false)
                for command in batch.commands:
                    expect(command.parent_id).to_equal("")
                    expect(command.computed_style.len()).to_equal(0)
                    expect(command.fractional_geometry).to_be_nil()
            Err(reason): fail("pinned clip source rejected: {reason}")

    it "rejects source changes before constructing any DrawIR":
        # @req REQ-2D-006
        val source = read_file("test/fixtures/simple_2d_skia/controlled_clipped_rect_v2.sdn")
        val changed = source.replace("clip: [4, 4, 0, 8]", "clip: [4, 4, 1, 8]")
        match simple_2d_controlled_clip_scene_from_source(changed):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_equal("controlled-clip-source-sha256-mismatch")
