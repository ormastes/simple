# @req REQ-2D-006
# @req NFR-2D-002
"""Pinned Web layout evidence before semantic Vulkan box lowering."""

use std.spec.{describe, it, expect}
use std.fs.{read_file}
use std.common.crypto.sha256.{sha256_text}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU, DRAW_IR_COMMAND_RECT, DRAW_IR_SOURCE_HTML_AST}
use common.ui.ui_ir.{draw_ir_to_ui_ir}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result}
use std.skia.backend.upstream_ganesh_vulkan.provider.{
    upstream_skia_ganesh_vulkan_preflight}

val WEB_BOX_FIXTURE: text = "test/fixtures/simple_2d_skia/web_opaque_box_v1.html"
val WEB_BOX_SHA256: text = "79ddcc965609652c829456fd017767b49e5970bf9c749e7012b135da06e1bd70"

describe "pinned Web opaque box producer":
    it "retains computed box geometry and paint metadata without degradation":
        val html = read_file(WEB_BOX_FIXTURE)
        expect(sha256_text(html)).to_equal(WEB_BOX_SHA256)
        val result = simple_web_layout_render_html_draw_ir_result(html, 16, 16)
        expect(result.render_degraded).to_equal(false)
        expect(result.degrade_reason).to_equal("")
        expect(result.material_fallback.kind).to_equal("none")
        expect(result.document_html).to_equal(html)
        val composition = result.composition
        expect(composition.backend_target).to_equal(DRAW_IR_BACKEND_CPU)
        expect(composition.batches.len()).to_equal(1)
        expect(composition.batches[0].source.source_kind).to_equal(
            DRAW_IR_SOURCE_HTML_AST)
        val lowered = draw_ir_to_ui_ir(composition)
        expect(lowered.accepted).to_equal(true)
        var source_command_count = 0
        var box_count = 0
        for batch in composition.batches:
            for command in batch.commands:
                source_command_count = source_command_count + 1
                if command.component_id == "box":
                    box_count = box_count + 1
                    expect(command.kind).to_equal(DRAW_IR_COMMAND_RECT)
                    expect(command.x).to_equal(4)
                    expect(command.y).to_equal(4)
                    expect(command.width).to_equal(8)
                    expect(command.height).to_equal(8)
                    expect(command.color).to_equal(0xFF2771C7u32)
                    expect(command.computed_style.len()).to_be_greater_than(0)
                    var found_background_image = false
                    var found_shadow = false
                    for prop in command.computed_style:
                        if prop.key == "background-image":
                            expect(prop.value).to_equal("none")
                            found_background_image = true
                        if prop.key == "box-shadow":
                            expect(prop.value).to_equal("none")
                            found_shadow = true
                    expect(found_background_image).to_equal(true)
                    expect(found_shadow).to_equal(true)
        expect(box_count).to_equal(1)
        expect(lowered.commands.len()).to_equal(source_command_count)
        var layout_box_count = 0
        var node_index = 0
        while node_index < result.hit_index.nodes.len():
            if result.hit_index.nodes[node_index].id_attr == "box":
                layout_box_count = layout_box_count + 1
                expect(result.raw_boxes.bx[node_index]).to_equal(4)
                expect(result.raw_boxes.by[node_index]).to_equal(4)
                expect(result.raw_boxes.bw[node_index]).to_equal(8)
                expect(result.raw_boxes.bh[node_index]).to_equal(8)
            node_index = node_index + 1
        expect(layout_box_count).to_equal(1)
        # The original CPU composition retains style; native Vulkan admission
        # stays closed until shared, exhaustive paint lowering is implemented.
        expect(upstream_skia_ganesh_vulkan_preflight(composition).accepted).to_equal(false)
