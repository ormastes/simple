# @req REQ-2D-003 REQ-2D-006 NFR-2D-003
"""Independent pixels reject matching wrong Web backend frames."""

use std.spec.{describe, it, expect, fail}
use std.spec.step
use common.renderdoc.web_opaque_box_oracle.{
    WEB_OPAQUE_BOX_FIXTURE_ID, WEB_OPAQUE_BOX_FIXTURE_SHA256,
    web_opaque_box_expected_rgba, web_opaque_box_capture_matches_oracle}
use common.renderdoc.final_output_pixels.{
    FinalOutputMetadata, FinalOutputCapture, FinalOutputTolerance,
    compare_final_output_pixels}

fn _web_capture(bytes: [i64], resource_id: text) -> FinalOutputCapture:
    FinalOutputCapture(
        metadata: FinalOutputMetadata(
            fixture_id: WEB_OPAQUE_BOX_FIXTURE_ID,
            fixture_digest: WEB_OPAQUE_BOX_FIXTURE_SHA256,
            frame_id: "web-oracle-test", resource_id: resource_id,
            selected_resource_count: 1, mip_level: 0, array_layer: 0,
            submission_token: "completed-1", completion_token: "completed-1",
            frame_complete: true, readback_complete: true, device_status: "ready",
            width: 16, height: 16, stride: 64,
            pixel_format: "R8G8B8A8_UNORM", alpha_mode: "opaque",
            color_space: "srgb", color_primaries: "srgb",
            transfer_function: "srgb", origin: "top-left",
            crop_x: 0, crop_y: 0, crop_width: 16, crop_height: 16),
        pixel_bytes: bytes)

describe "independent pinned Web box oracle":
    it "checks the authored image and rejects matching wrong outputs":
        step("Read the pinned HTML and build the independent expected RGBA")
        val expected = match web_opaque_box_expected_rgba():
            case Ok(rgba): rgba
            case Err(reason): fail("Pinned Web oracle failed: {reason}")
        expect(expected.len()).to_equal(1024)
        expect(expected[0:4]).to_equal([16, 32, 48, 255])
        expect(expected[(4 * 16 + 4) * 4:(4 * 16 + 4) * 4 + 4]).to_equal(
            [39, 113, 199, 255])
        step("Two identical wrong backend images must fail the authored oracle")
        var wrong: [i64] = []
        var index = 0
        while index < 1024:
            wrong.push(if index % 4 == 3: 255 else: 0)
            index = index + 1
        val first = _web_capture(wrong, "engine2d-output")
        val second = _web_capture(wrong, "skia-output")
        val tolerance = FinalOutputTolerance(
            fixture_id: WEB_OPAQUE_BOX_FIXTURE_ID,
            verified_source_digest: WEB_OPAQUE_BOX_FIXTURE_SHA256,
            max_channel_delta: 0, max_excess_pixels: 0)
        expect(compare_final_output_pixels(first, second, tolerance).status).to_equal("pass")
        match web_opaque_box_capture_matches_oracle(first):
            case Ok(matches): expect(matches).to_equal(false)
            case Err(reason): fail("Wrong Web pixels rejected before comparison: {reason}")
        step("Exact authored pixels pass and foreign metadata fails")
        match web_opaque_box_capture_matches_oracle(
            _web_capture(expected, "matching-output")):
            case Ok(matches): expect(matches).to_equal(true)
            case Err(reason): fail("Exact Web pixels rejected: {reason}")
        var foreign = _web_capture(expected, "foreign-output")
        foreign.metadata.fixture_digest = "wrong"
        match web_opaque_box_capture_matches_oracle(foreign):
            case Ok(_): fail("Foreign Web fixture metadata should reject")
            case Err(reason): expect(reason).to_equal(
                "web-opaque-box-oracle-fixture-mismatch")
