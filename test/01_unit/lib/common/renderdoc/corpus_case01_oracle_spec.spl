# @req REQ-2D-006
# @req NFR-2D-002
# @tag: unit, renderdoc, web, corpus
"""Independent case 01 pixels; this test does not qualify a GPU capture."""

use std.spec.{describe, it, expect, fail_test}
use std.spec.step
use common.renderdoc.corpus_case01_oracle.{
    CORPUS_CASE01_WIDTH, CORPUS_CASE01_HEIGHT,
    corpus_case01_expected_rgba}

fn _offset(x: i32, y: i32) -> i64:
    (y * CORPUS_CASE01_WIDTH + x).to_i64() * 4

describe "pinned corpus case 01 independent oracle":
    it "keeps white canvas and authored RGB boxes at exact boundaries":
        step("Hash the pinned HTML and SVG reference before constructing pixels")
        val rgba = match corpus_case01_expected_rgba():
            case Ok(value): value
            case Err(reason): fail_test("case 01 oracle unavailable: {reason}")
        expect(rgba.len()).to_equal(
            CORPUS_CASE01_WIDTH.to_i64() * CORPUS_CASE01_HEIGHT.to_i64() * 4)
        val white = _offset(0, 0)
        val red_start = _offset(20, 20)
        val red_end = _offset(199, 119)
        val after_red = _offset(200, 120)
        val blue_start = _offset(240, 30)
        val blue_end = _offset(339, 209)
        val green_start = _offset(380, 50)
        val green_end = _offset(559, 169)
        val white_end = _offset(639, 479)
        expect(rgba[white:white + 4]).to_equal([255, 255, 255, 255])
        expect(rgba[red_start:red_start + 4]).to_equal([255, 0, 0, 255])
        expect(rgba[red_end:red_end + 4]).to_equal([255, 0, 0, 255])
        expect(rgba[after_red:after_red + 4]).to_equal([255, 255, 255, 255])
        expect(rgba[blue_start:blue_start + 4]).to_equal([0, 0, 255, 255])
        expect(rgba[blue_end:blue_end + 4]).to_equal([0, 0, 255, 255])
        expect(rgba[green_start:green_start + 4]).to_equal([0, 255, 0, 255])
        expect(rgba[green_end:green_end + 4]).to_equal([0, 255, 0, 255])
        expect(rgba[white_end:white_end + 4]).to_equal([255, 255, 255, 255])
