use std.spec
use std.common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_BACKEND_DIRECTX,
    SIMPLEOS_HOST_GPU_BACKEND_METAL,
    SIMPLEOS_HOST_GPU_BACKEND_VULKAN,
    simpleos_host_gpu_render_backend_order
}

describe "SimpleOS host GPU render backend order":
    it "keeps required selection exclusive and optional fallback deterministic":
        expect(simpleos_host_gpu_render_backend_order(
            SIMPLEOS_HOST_GPU_BACKEND_VULKAN, true
        )).to_equal([SIMPLEOS_HOST_GPU_BACKEND_VULKAN])
        expect(simpleos_host_gpu_render_backend_order(
            SIMPLEOS_HOST_GPU_BACKEND_VULKAN, false
        )).to_equal([
            SIMPLEOS_HOST_GPU_BACKEND_VULKAN,
            SIMPLEOS_HOST_GPU_BACKEND_METAL,
            SIMPLEOS_HOST_GPU_BACKEND_DIRECTX
        ])
        expect(simpleos_host_gpu_render_backend_order(0, true)).to_equal([])
