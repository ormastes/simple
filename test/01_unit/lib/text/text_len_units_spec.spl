# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# bug: doc/08_tracking/bug/text_len_bytes_vs_index_codepoints_2026-07-02.md

# Text has two explicit length functions: byte_len() counts UTF-8 bytes and
# char_count() counts code points. len() is the legacy ambiguous form (bytes
# today, code points staged) and is deliberately not asserted against here.

use std.spec.step
use std.spec.{describe, it, expect}

describe "text length units":
    """
    ## byte_len() vs char_count()

    "héllo€" is 6 code points and 9 UTF-8 bytes (é = 2, € = 3).
    """

    it "counts bytes with byte_len and code points with char_count":
        # @req REQ-SSPEC-UNIT
        step("Measure a mixed ASCII/Latin/currency text")
        val s = "héllo€"
        expect(s.byte_len()).to_equal(9)
        expect(s.char_count()).to_equal(6)
        expect(s.chars().len()).to_equal(6)

    it "agrees on pure ASCII":
        # @req REQ-SSPEC-UNIT
        step("Measure ASCII text")
        expect("hello".byte_len()).to_equal(5)
        expect("hello".char_count()).to_equal(5)

    it "reports zero for empty text":
        # @req REQ-SSPEC-UNIT
        step("Measure empty text")
        expect("".byte_len()).to_equal(0)
        expect("".char_count()).to_equal(0)

    it "indexes by code point, bounded by char_count":
        # @req REQ-SSPEC-UNIT
        step("Index the last code point")
        val s = "héllo€"
        expect(s[s.char_count() - 1]).to_equal('€')

    it "counts code points with len, consistent with indexing":
        # @req REQ-SSPEC-UNIT
        # design: doc/05_design/language/text/text_len_counts_characters_2026-11-07.md
        step("len() is the character count, byte_len() the byte count")
        val s = "héllo€"
        expect(s.len()).to_equal(6)
        expect(s.len()).to_equal(s.char_count())
        expect(s.byte_len()).to_equal(9)
        expect(s[s.len() - 1]).to_equal('€')
        expect("".len()).to_equal(0)
        expect("hello".len()).to_equal(5)
