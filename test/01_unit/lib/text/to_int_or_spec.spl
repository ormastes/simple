"""Pin `std.text.to_int_or`, the symbol 31 call sites across 6 modules imported
from `std.text` while it did not exist there.

Purpose: prove the fail-CLOSED contract those call sites actually depend on --
every one of them passes a MEANINGFUL default (tmux pane width 80, height 24,
scrollback 100, dashboard port 3000), so a non-numeric field must yield THAT
default, never 0 and never a crash.

Pre-fix this whole file fails with `semantic: function to_int_or not found`.
"""
# @manual: primary
# @req: REQ-LIB-TEXT-TO-INT-OR
use std.spec.{describe, it, expect}
use std.spec.step
use std.text.{to_int_or}

describe "std.text.to_int_or":
    it "parses a plain integer":
        step("Verify: parses a plain integer")
        expect(to_int_or("8080", 3000)).to_equal(8080)  # oracle: 8080 — the literal parsed

    it "trims surrounding whitespace before parsing":
        step("Verify: trims surrounding whitespace before parsing")
        expect(to_int_or("  42  ", 0)).to_equal(42)  # oracle: 42 — Content-Length headers arrive padded

    it "returns the caller's default for a non-numeric value":
        step("Verify: returns the caller's default for a non-numeric value")
        expect(to_int_or("abc", 24)).to_equal(24)  # oracle: 24 — tmux height default must survive garbage

    it "returns the caller's default for an empty string":
        step("Verify: returns the caller's default for an empty string")
        expect(to_int_or("", 80)).to_equal(80)  # oracle: 80 — tmux width default, empty field is common

    it "returns the caller's default, not 0, for a partially numeric value":
        step("Verify: returns the caller's default, not 0, for a partially numeric value")
        expect(to_int_or("60;rm -rf /", 100)).to_equal(100)  # oracle: 100 — fail CLOSED; 0 would be a silent wrong answer

    it "returns the caller's default for an overflowing value":
        step("Verify: returns the caller's default for an overflowing value")
        expect(to_int_or("999999999999999999999999999999", 3000)).to_equal(3000)  # oracle: 3000 — overflow must not yield 0

    it "parses a negative integer":
        step("Verify: parses a negative integer")
        expect(to_int_or("-7", 0)).to_equal(-7)  # oracle: -7 — sign preserved
