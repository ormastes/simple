# Fixture for text_byte_len_jit_boxing_spec: `bin/simple run` compiles main()
# through the Cranelift JIT, which is where byte_len() lost its boxing.
fn bl_of(s: text) -> i64:
    s.byte_len()

fn main():
    val a = "hello"
    val b = "héllo→l"
    val x = a.byte_len()
    val y = b.byte_len()
    print "bl_ascii={x}"
    print "bl_utf8={y}"
    print "bl_sum={x + y}"
    print "bl_eq={y == 10}"
    print "bl_gt={y > 9}"
    print "bl_fn={bl_of(b)}"
    val c = b.char_count()
    val l = b.len()
    val f = b.find("l")
    val i = b.index_of("l")
    val r = b.rfind("l")
    val k = b.count("l")
    print "cc={c} len={l} find={f} idx={i} rfind={r} count={k}"
main()
