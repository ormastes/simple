"""
Feature: Text Extern Dispatch Parity

## Purpose and audience
## Operator workflow
## Compatibility and limitations

Category: Stdlib
Status: Active
"""
# @manual: primary
# @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
# doc-path: doc/01_research/lib/strings/text_validity_presence_pattern_2026-02-24.md
# doc-path: doc/03_plan/lib/misc/wm_text_access_mcp.md
# doc-path: doc/04_architecture/lib/wm_text_access_mcp.md
# doc-path: doc/05_design/compiler/codegen/pure_simple_text_extern_abi_fix_plan.md

# Regression spec for
# doc/08_tracking/bug/sdoctest_mode_unknown_extern_rt_string_ends_with_2026-08-07.md
#
# `rt_string_ends_with` and `rt_string_rfind` are declared `extern fn` in
# src/lib/text.spl (lines 52-53), defined in the C runtime
# (runtime_native.c:3670 / :3733), and registered in every codegen backend --
# but the SEED INTERPRETER's EXTERN_DISPATCH table had no entry for either, so
# an interpreted call died with:
#
#     error: semantic: unknown extern function: rt_string_ends_with
#
# The defect is LANE-SPECIFIC. Measured 2026-08-17 on the same binary and the
# same source file:
#
#     SIMPLE_EXECUTION_MODE=jit          -> ends=true  rfind=3   (rc=0)
#     SIMPLE_EXECUTION_MODE=interpreter  -> unknown extern function (rc=1)
#
# That asymmetry is why the originally reported surface (`simple test
# --sdoctest`) now passes 16/16 while the underlying gap is untouched: JIT is
# the default engine, so the sdoctest lane stopped routing through the
# interpreter. This spec therefore calls the externs DIRECTLY rather than going
# through `text.ends_with` -- a method call can be answered by the builtin
# method table without ever reaching the extern, which would make the spec
# vacuous on exactly the lane it is meant to fence.
#
# Run under the interpreter to exercise the regression:
#     SIMPLE_EXECUTION_MODE=interpreter bin/simple test <this file>
#
# RUN FROM THE REPO ROOT. Because this file declares the externs itself and
# calls them by name, it still imports `spec`, and a run whose cwd is outside
# the repo dies with:
#
#     stdlib import `std.text` resolves from the project stdlib roots only
#
# That is a module-resolution failure, NOT this bug -- but it is an error on
# the same file that mentions text, so it reads like a genuine RED. Confirm cwd
# before concluding the extern is missing again.

use std.spec.step
use spec.{describe, it, expect}

extern fn rt_string_ends_with(s: text, suffix: text) -> bool
extern fn rt_string_rfind(s: text, needle: text) -> i64

describe "rt_string_ends_with extern is dispatchable":
    it "matches a present suffix":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: matches a present suffix")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_ends_with("notes.md", ".md")).to_equal(true)

    it "rejects a near-miss suffix":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: rejects a near-miss suffix")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_ends_with("notes.mdx", ".md")).to_equal(false)

    it "rejects a suffix longer than the subject":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: rejects a suffix longer than the subject")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_ends_with("md", ".md")).to_equal(false)

    it "treats the whole subject as its own suffix":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: treats the whole subject as its own suffix")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_ends_with(".md", ".md")).to_equal(true)

    it "accepts the empty suffix":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: accepts the empty suffix")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_ends_with("anything", "")).to_equal(true)

    it "finds no suffix in the empty subject":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: finds no suffix in the empty subject")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_ends_with("", ".md")).to_equal(false)

describe "rt_string_rfind extern is dispatchable":
    it "returns the LAST byte index, not the first":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: returns the LAST byte index, not the first")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_rfind("a/b/c", "/")).to_equal(3)  # oracle: pinned constant asserted by this scenario

    it "returns the last of overlapping-free repeats":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: returns the last of overlapping-free repeats")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_rfind("abcabc", "abc")).to_equal(3)  # oracle: pinned constant asserted by this scenario

    it "returns 0 when the needle is the whole subject":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: returns 0 when the needle is the whole subject")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_rfind("abc", "abc")).to_equal(0)  # oracle: pinned constant asserted by this scenario

    it "returns -1 on a miss":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: returns -1 on a miss")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_rfind("abc", "zz")).to_equal(-1)  # oracle: pinned constant asserted by this scenario

    it "returns -1 when the needle is longer than the subject":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: returns -1 when the needle is longer than the subject")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_rfind("ab", "abc")).to_equal(-1)  # oracle: pinned constant asserted by this scenario

    # C-runtime contract: an EMPTY needle yields the subject LENGTH, not 0.
    it "returns the subject length for an empty needle":
        # @req: REQ-LIB-TEXT_RT_STRING_ENDS_WITH_EXT-001
        step("Verify: returns the subject length for an empty needle")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(rt_string_rfind("abc", "")).to_equal(3)  # oracle: pinned constant asserted by this scenario
