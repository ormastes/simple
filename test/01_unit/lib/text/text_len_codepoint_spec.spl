# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# bug: doc/08_tracking/bug/text_len_codepoint_switch_2026-11-03.md
#
# ADR-005: text.len() counts Unicode code points (not bytes, not grapheme
# clusters); byte_len() stays UTF-8 bytes. Red on any seed built before the
# switch (04969955c75), where len() == byte_len().

use std.spec.step
use std.spec.{describe, it, expect}

describe "text len counts code points (ADR-005)":
    it "ascii: len equals byte_len":
        # @req REQ-SSPEC-UNIT
        step("Measure ASCII text")
        expect("hello".len()).to_equal(5)
        expect("hello".byte_len()).to_equal(5)
        expect("".len()).to_equal(0)

    it "2-byte sequences count once":
        # @req REQ-SSPEC-UNIT
        step("Measure Latin-1 supplement text")
        val s = "héllo"
        expect(s.len()).to_equal(5)
        expect(s.byte_len()).to_equal(6)

    it "3-byte sequences count once":
        # @req REQ-SSPEC-UNIT
        step("Measure text with a 3-byte code point")
        val s = "a€b"
        expect(s.len()).to_equal(3)
        expect(s.byte_len()).to_equal(5)

    it "4-byte sequences count once":
        # @req REQ-SSPEC-UNIT
        step("Measure text with a 4-byte code point")
        val s = "a😀b"
        expect(s.len()).to_equal(3)
        expect(s.byte_len()).to_equal(6)

    it "combining sequences count each code point, not one grapheme":
        # @req REQ-SSPEC-UNIT
        step("Measure e + COMBINING ACUTE ACCENT")
        val s = "e\u{301}"
        expect(s.len()).to_equal(2)
        expect(s.byte_len()).to_equal(3)

    it "len agrees with char_count and the chars() array":
        # @req REQ-SSPEC-UNIT
        step("Cross-check against the explicit code-point surfaces")
        val s = "héllo€😀"
        expect(s.len()).to_equal(s.char_count())
        expect(s.len()).to_equal(s.chars().len())
        expect(s.len()).to_equal(7)
        expect(s.byte_len()).to_equal(13)
