"""
## Purpose and audience
Purpose: Verify DB prefix index.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-PREFIX-INDEX-001 — stable requirement identity for this spec.

use std.spec
use std.db.prefix_index.{
    prefix_index_new, prefix_index_insert, prefix_index_sort,
    prefix_index_lookup_exact, prefix_index_lookup_prefix,
    prefix_index_lookup_descendants, prefix_index_prefix_range
}
use std.db.db_persistence.{db_table_new}
use std.db.db_query.{db_table_prefix_scan}

describe "DB prefix index":
    it "supports exact and prefix lookup on unsorted inserts":
        step("Verify: supports exact and prefix lookup on unsorted inserts")
        # @req: REQ-LIB-PREFIX-INDEX-001
        var idx = prefix_index_new()
        idx = prefix_index_insert(idx, "tenant/b/order/2", 20)
        idx = prefix_index_insert(idx, "tenant/a/order/1", 10)
        idx = prefix_index_insert(idx, "tenant/a/order/3", 30)

        val exact = prefix_index_lookup_exact(idx, "tenant/a/order/1")
        val prefix = prefix_index_lookup_prefix(idx, "tenant/a/")

        expect(exact.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(exact[0]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(prefix.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(prefix[0]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(prefix[1]).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

    it "reports a sorted prefix range for repeated scans":
        step("Verify: reports a sorted prefix range for repeated scans")
        var idx = prefix_index_new()
        idx = prefix_index_insert(idx, "sys/b", 2)
        idx = prefix_index_insert(idx, "app/a", 1)
        idx = prefix_index_insert(idx, "app/b", 3)
        val sorted = prefix_index_sort(idx)

        val range = prefix_index_prefix_range(sorted, "app/")

        expect(range.start).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(range.end).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(range.matched_count).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "supports hierarchical descendant lookups with exact root inclusion":
        step("Verify: supports hierarchical descendant lookups with exact root inclusion")
        var idx = prefix_index_new()
        idx = prefix_index_insert(idx, "cfg", 1)
        idx = prefix_index_insert(idx, "cfg/db/host", 2)
        idx = prefix_index_insert(idx, "cfg/db/port", 3)
        idx = prefix_index_insert(idx, "cfgx/db/host", 4)

        val hits = prefix_index_lookup_descendants(idx, "cfg")

        expect(hits.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(hits[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(hits[1]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(hits[2]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "is used by DbTable prefix scans after index rebuild":
        step("Verify: is used by DbTable prefix scans after index rebuild")
        val table = db_table_new("kv")
        table.insert("user/002", "b")
        table.insert("admin/001", "root")
        table.insert("user/001", "a")

        val result = db_table_prefix_scan(table, "user/")

        expect(result.count).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.ids[0]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.ids[1]).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
