# Regression: len() counts scalars but substring() takes byte offsets.
# Bug: doc/08_tracking/bug/summary_store_publish_read_absent_2026-11-26.md
use std.spec.*
use std.spec.step
use std.js.types.js_types.{JsValue}
use std.js.node.path_module.{path_basename, _path_last_index_of, _path_replace_backslash}

describe "std.js path_module on non-ASCII paths":
    it "strips a suffix from a non-ASCII basename":
        step("basename with suffix")
        val r = path_basename([JsValue.String(v: "/a/é한😀.txt"), JsValue.String(v: ".txt")])
        expect(r).to_equal(JsValue.String(v: "é한😀"))

    it "finds the last needle by byte index":
        step("last index of .")
        expect(_path_last_index_of("é한😀.x", ".")).to_equal(9)

    it "keeps every byte when replacing backslashes":
        step("replace backslash")
        expect(_path_replace_backslash("é\한😀")).to_equal("é/한😀")
