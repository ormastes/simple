# Regression spec for js_engine_missing_builtins_regex_promise_prototype_2026-07-11
# (introspection portion). `typeof` on an identifier must resolve through the
# same path as normal evaluation, and builtin prototype methods must surface as
# function values for feature-detection (`if (arr.forEach) ...`).
use std.nogc_sync_mut.js.engine.runtime.{js_runtime_with_default_logger}
use std.js.types.js_types.{JsValue}

fn eval_str(src: text) -> text:
    var rt = js_runtime_with_default_logger("typeof-spec")
    match rt.eval(src):
        Ok(v):
            match v:
                JsValue.String(v: s): s
                JsValue.Number(v: n): n.to_text()
                JsValue.Undefined: "<undefined>"
                _: "<other>"
        Err(e):
            "<err>"

describe "JS engine typeof introspection":
    it "reports Promise as function": # @req: js_engine_missing_builtins_regex_promise_prototype_2026-07-11
        expect(eval_str("typeof Promise")).to_equal("function")

    it "reports array prototype methods as function":
        expect(eval_str("typeof [].forEach")).to_equal("function")
        expect(eval_str("typeof [1,2].map")).to_equal("function")

    it "reports string prototype methods as function":
        expect(eval_str("typeof ''.replace")).to_equal("function")

    it "still reports unknown identifiers and properties as undefined":
        expect(eval_str("typeof __no_such_global__")).to_equal("undefined")
        expect(eval_str("typeof [].__no_such_method__")).to_equal("undefined")

    it "does not break method calls or basic eval":
        expect(eval_str("[1,2,3].map(function(n){return n*2;}).join(',')")).to_equal("2,4,6")
        expect(eval_str("'a-b'.replace('-','+')")).to_equal("a+b")
