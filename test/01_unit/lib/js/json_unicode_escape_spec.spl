"""
## Purpose and audience
Purpose: Verify json unicode escape decoding (lib/js builtin).
Audience: compiler and tooling engineers who maintain this spec.

RFC 8259 escape decoding in the lib/js JSON builtin (the variant the js
engine interpreters import via tier-less std.js.builtins.json — direct
lib/ path precedence). Was: json_parse stripped quotes and decoded NO
escapes at all (not even backslash-n or an escaped quote), and its
slice(1, len-1) strip corrupted raw non-ASCII under the interpreter
(char-indexed slicing vs byte len).

Byte-sequence assertions: text equality is byte equality and .len() is
BYTE length, so equality + len pin the exact bytes.

Kept deviation (documented, JS-engine-specific): a bare `undefined`
input parses to JsValue.Undefined; arrays/objects still return
placeholder ids (pre-existing stub behavior, out of this fix's scope).
"""

# @req: REQ-LIB-JSON-UNICODE-ESCAPE-001 — stable requirement identity for this spec.

use std.spec.*
use std.js.builtins.json.{json_parse, json_stringify}
use std.js.types.js_types.{JsValue}

fn parsed_string(input: text) -> text:
    match json_parse(input):
        JsValue.String(s): s
        _: "<not-a-string>"

describe "json unicode escape decoding (lib/js builtin)":
    it "decodes standard escapes":
        step("Verify: decodes standard escapes")
        # @req: REQ-LIB-JSON-UNICODE-ESCAPE-001
        val out = parsed_string("\"a\\nb\\t\\\"q\\\"\\\\z\"")
        expect(out).to_equal("a\nb\t\"q\"\\z")

    it "decodes ASCII and BMP unicode escapes to UTF-8 bytes":
        step("Verify: decodes ASCII and BMP unicode escapes to UTF-8 bytes")
        val out = parsed_string("\"\\u0041 caf\\u00e9\"")
        expect(out).to_equal("A café")
        expect(out.len()).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract

    it "decodes CJK escape to 3-byte UTF-8":
        step("Verify: decodes CJK escape to 3-byte UTF-8")
        val out = parsed_string("\"\\u4e2d\"")
        expect(out).to_equal("中")
        expect(out.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "combines surrogate pairs into supplementary codepoints":
        step("Verify: combines surrogate pairs into supplementary codepoints")
        val out = parsed_string("\"\\ud83d\\ude00\"")
        expect(out).to_equal("😀")
        expect(out.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

    it "decodes lone surrogates to U+FFFD":
        step("Verify: decodes lone surrogates to U+FFFD")
        expect(parsed_string("\"\\ud83dX\"")).to_equal("�X")
        expect(parsed_string("\"\\udc00\"")).to_equal("�")

    it "passes raw non-ASCII content through byte-exactly":
        step("Verify: passes raw non-ASCII content through byte-exactly")
        val out = parsed_string("\"café 中 😀\"")
        expect(out).to_equal("café 中 😀")
        expect(out.len()).to_equal(14)  # oracle: authoritative expected value documented by this spec's contract
        expect not out.contains("�")

    it "handles mixed raw and escaped content byte-correctly":
        step("Verify: handles mixed raw and escaped content byte-correctly")
        val out = parsed_string("\"é\\u4e2dz\\ud83d\\ude00\"")
        expect(out).to_equal("é中z😀")
        expect(out.len()).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

    it "stringify escapes quotes, backslashes, and newlines":
        step("Verify: stringify escapes quotes, backslashes, and newlines")
        val re = json_stringify(JsValue.String("a\"b\\c\nd"))
        expect(re).to_equal("\"a\\\"b\\\\c\\nd\"")

    it "round-trips stringify -> parse for strings":
        step("Verify: round-trips stringify -> parse for strings")
        val re = json_stringify(JsValue.String("caf\né \"中\" 😀"))
        val back = parsed_string(re)
        expect(back).to_equal("caf\né \"中\" 😀")

    it "keeps the documented JS deviation: bare undefined parses":
        step("Verify: keeps the documented JS deviation: bare undefined parses")
        match json_parse("undefined"):
            JsValue.Undefined: expect(true).to_equal(true)
            _: expect(false).to_equal(true)
