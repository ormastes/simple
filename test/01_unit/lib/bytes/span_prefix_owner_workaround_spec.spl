use std.common.bytes.span.{ByteSpan}

describe "ByteSpan prefix comparison retains the sliced receiver owner":
    it "compares a prefix inside an offset span":
        val bytes: [u8] = [9u8, 10u8, 20u8, 30u8, 99u8]
        val span = ByteSpan.of(bytes, 1, 3)
        val prefix = ByteSpan.new([10u8, 20u8])
        expect(span.starts_with(prefix)).to_equal(true)

    it "rejects differing and longer prefixes":
        val span = ByteSpan.new([10u8, 20u8])
        expect(span.starts_with(ByteSpan.new([10u8, 21u8]))).to_equal(false)
        expect(span.starts_with(ByteSpan.new([10u8, 20u8, 30u8]))).to_equal(false)

    it "accepts empty prefixes including the empty span":
        expect(ByteSpan.new([10u8]).starts_with(ByteSpan.empty())).to_equal(true)
        expect(ByteSpan.empty().starts_with(ByteSpan.empty())).to_equal(true)
