use std.spec
use std.test_runner.child_diagnostics.{native_cleanup_diagnostic}

describe "canonical native child cleanup diagnostics":
    it "preserves a real diagnostic despite green presentation":
        val diagnostic = "error: NATIVE-CACHE-CLEANUP-FAILED: private cache remove failed"
        expect(native_cleanup_diagnostic("Results: 1 passed, 0 failed", diagnostic)).to_equal(diagnostic)

    it "accepts the reserved code-only protocol line":
        expect(native_cleanup_diagnostic("error: NATIVE-CACHE-CLEANUP-FAILED", "")).to_equal("error: NATIVE-CACHE-CLEANUP-FAILED")

    it "handles CRLF and surrounding whitespace":
        expect(native_cleanup_diagnostic("", "\r\n  error: NATIVE-CACHE-CLEANUP-FAILED: blocked\r\n")).to_equal("error: NATIVE-CACHE-CLEANUP-FAILED: blocked")

    it "rejects quoted source literals and descriptor traces":
        expect(native_cleanup_diagnostic("\"error: NATIVE-CACHE-CLEANUP-FAILED: quoted\"", "")).to_equal("")
        expect(native_cleanup_diagnostic("TRACE parser descriptor source=\"error: NATIVE-CACHE-CLEANUP-FAILED: quoted\"", "")).to_equal("")

    it "rejects a longer code sharing the prefix":
        expect(native_cleanup_diagnostic("", "error: NATIVE-CACHE-CLEANUP-FAILED-OTHER: unrelated")).to_equal("")

    it "rejects a marker mentioned inside another diagnostic":
        expect(native_cleanup_diagnostic("", "error: parser rejected literal NATIVE-CACHE-CLEANUP-FAILED")).to_equal("")

    it "does not manufacture an owner error from empty or green captures":
        expect(native_cleanup_diagnostic("", "")).to_equal("")
        expect(native_cleanup_diagnostic("Results: 1 passed, 0 failed", "")).to_equal("")
