# Aggregator and DisplayCompositor unit tests

use std.spipe.*
use std.skia.entity.geometry.{SkRect}
use std.viz.entity.compositor_frame.{CompositorFrame}
use std.viz.entity.surface_id.{SurfaceId, FrameSinkId, LocalSurfaceId}
use std.viz.entity.render_pass.{RenderPass}
use std.viz.feature.aggregator.{Aggregator, AggregatorEntry}

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

describe "Aggregator":
    it "new Aggregator has 0 known_frames":
        val agg = Aggregator.new()
        expect agg.known_frames.len() to_equal 0

    it "register_frame adds one entry":
        var agg = Aggregator.new()
        val sid = _sid(1, 2, 0, 1)
        val entry = AggregatorEntry(surface_id: sid, frame: CompositorFrame.empty())
        agg.register_frame(entry)
        expect agg.known_frames.len() to_equal 1

    it "register_frame with duplicate SurfaceId replaces, size stays 1":
        var agg = Aggregator.new()
        val sid = _sid(1, 2, 0, 1)
        val entry1 = AggregatorEntry(surface_id: sid, frame: _frame_with_passes(1))
        val entry2 = AggregatorEntry(surface_id: sid, frame: _frame_with_passes(3))
        agg.register_frame(entry1)
        agg.register_frame(entry2)
        expect agg.known_frames.len() to_equal 1

    it "aggregate with unknown root returns empty frame":
        var agg = Aggregator.new()
        val unknown = _sid(99, 99, 0, 0)
        val result = agg.aggregate(unknown)
        expect result.render_pass_list.len() to_equal 0

    it "aggregate with known root returns that frame's pass count":
        var agg = Aggregator.new()
        val sid = _sid(1, 1, 0, 1)
        val entry = AggregatorEntry(surface_id: sid, frame: _frame_with_passes(2))
        agg.register_frame(entry)
        val result = agg.aggregate(sid)
        expect result.render_pass_list.len() to_equal 2
