# Purpose and audience: executable specification evidence for the test-runner owners.
# A spec whose MC/DC standalone compile fails is re-run on the interpreter by
# run_test_file_mcdc_interpreter_fallback. When that re-run hits its wall-clock
# budget the verdict must say TIMEOUT (timed_out, timeout=1 verdict line), not
# "TERMINATED: child died by signal ... earlyoom cannot be ruled out".
# Bug: doc/08_tracking/bug/test_runner_mcdc_fallback_timeout_misreported_2026-10-19.md
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect}
use std.spec.step
use app.test_runner_new.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_execute.{scoped_limit_exceeded_result}
use std.test_runner.test_executor_parsing.{find_simple_binary}
use std.test_runner.native_owned_process.{ScopedChildRun, run_scoped_child}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass}
use std.nogc_sync_mut.io.process_ops.{ProcessResult, process_run_timeout}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

# Static fixtures, named without the _spec suffix so discovery never runs them
# directly. Each test copies one into a private directory as *_spec.spl and
# drives the real `simple test <dir>` lane over it.
val SPIN_FIXTURE = "test/fixtures/test_runner_mcdc/spin_fixture.spl"
val QUICK_FIXTURE = "test/fixtures/test_runner_mcdc/quick_fixture.spl"

fn run_dir_lane(fixture: text, budget_secs: text) -> (text, i32):
    val dir = "build/test_runner_mcdc_fixture_{time_now_unix_micros()}"
    val (_o1, _e1, mk) = process_run_timeout("/bin/mkdir", ["-p", dir], 10000)
    expect(mk).to_equal(0)
    val (_o2, _e2, cp) = process_run_timeout("/bin/cp", [fixture, dir + "/fixture_spec.spl"], 10000)
    expect(cp).to_equal(0)
    # Captured through the runner's own scoped-child path: process_run_timeout
    # returns empty text under the seed interpreter, see
    # doc/08_tracking/bug/seed_interpreter_text_codec_file_io_empty_2026-10-19.md
    val lane = run_scoped_child(ExecutionResourceClass.Unit, find_simple_binary(),
        ["test", dir, "--timeout", budget_secs, "--no-db", "--no-cache"], 300000, 0, 0, 0, 0, false)
    process_run_timeout("/bin/rm", ["-rf", dir], 10000)
    (lane.result.stdout + "\n" + lane.result.stderr, lane.result.exit_code)

fn verdict_line(output: text) -> text:
    for line in output.split("\n"):
        if line.starts_with("SPEC FILE VERDICT:"):
            return line
    ""

fn limit_child(limit_type: text) -> ScopedChildRun:
    ScopedChildRun(
        result: ProcessResult(stdout: "", stderr: "", exit_code: 143, limit_exceeded: true, limit_type: limit_type),
        usage: nil,
        budget_status: "failure")

describe "MC/DC interpreter fallback under a wall-clock budget":
    it "reports a budget kill as TIMEOUT, not as an unexplained signal death":
        # @req REQ-SSPEC-UNIT
        step("run a never-ending spec through the directory lane with a 3s budget")
        val (output, _code) = run_dir_lane(SPIN_FIXTURE, "3")
        # Pins the path under test: the MC/DC fallback, not the native run.
        expect(output).to_contain("[mcdc-fallback]")
        expect(output.contains("child died by signal")).to_equal(false)
        expect(output).to_contain("TIMEOUT")
        expect(verdict_line(output)).to_contain("timeout=1")

    it "still reports a spec that finishes inside its budget as a real result":
        # @req REQ-SSPEC-UNIT
        step("run a terminating spec through the same lane")
        val (output, _code) = run_dir_lane(QUICK_FIXTURE, "60")
        expect(output).to_contain("[mcdc-fallback]")
        val verdict = verdict_line(output)
        expect(verdict).to_contain("executed=1")
        expect(verdict.contains("timeout=1")).to_equal(false)

    it "classifies every resource-limit kill by its limit, keeping the fallback tags":
        # @req REQ-SSPEC-UNIT
        step("map timeout, memory, cpu and procs limits to their outcome classes")
        val options = parse_test_args(["--no-cache"])
        val timeout = scoped_limit_exceeded_result("t_spec.spl", limit_child("timeout"), options, 10, "why", "tok")
        expect(timeout.timed_out).to_equal(true)
        expect(timeout.failed).to_equal(0)
        expect(timeout.error).to_start_with("TIMEOUT")
        expect(timeout.mcdc_skip_reason).to_equal("why")
        expect(timeout.degraded_reason).to_equal("tok")
        val memory = scoped_limit_exceeded_result("m_spec.spl", limit_child("memory"), options, 10, "why", "")
        expect(memory.timed_out).to_equal(false)
        expect(memory.failed).to_equal(0)
        expect(memory.error).to_start_with("TERMINATED: Memory limit exceeded")
        val cpu = scoped_limit_exceeded_result("c_spec.spl", limit_child("cpu"), options, 10, "why", "")
        expect(cpu.failed).to_equal(0)
        expect(cpu.error).to_start_with("TERMINATED: CPU time limit exceeded")
        val procs = scoped_limit_exceeded_result("p_spec.spl", limit_child("procs"), options, 10, "why", "")
        expect(procs.failed).to_equal(1)  # oracle: an exhausted process cap is a real defect, not unverified
        expect(procs.error).to_start_with("Process limit exceeded")
