"""
## Purpose and audience
Purpose: Verify parse_magics — stripping magic lines from raw cell source.
Audience: compiler and tooling engineers who maintain this spec.

Notebook magics unit spec (Stream K, task K3).

Covers parsing/stripping of every magic (%mode, %%mode, %lanes, %reset,
%budget, %timeout, %onfault) from raw cell source, %%mode cell isolation
(design §3: "no cross-lane state sharing"), and the unknown-magic diagnostic.

Design: doc/05_design/app/tools/notebook_lanes_architecture.md §3
Plan:   doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream K, K3)
"""

# @req: REQ-LIB-MAGICS-001 — stable requirement identity for this spec.

use std.spec
use std.notebook.types.{CellResult, SessionOpts, LaneStatus, cell_result_ok}
use std.notebook.executor.{NotebookExecutor, NotebookExecutorFactory}
use std.notebook.session_manager.{KernelSessionManager}
use std.notebook.magics.{parse_magics, dispatch_magics, MagicsState}

# ============================================================================
# Test doubles (mirrors kernel_session_manager_spec.spl's FakeExecutor).
# ============================================================================

class FakeExecutor with NotebookExecutor:
    spec: text
    started: bool
    reset_count: i64
    exec_count: i64

    static fn make(spec: text) -> FakeExecutor:
        FakeExecutor(spec: spec, started: false, reset_count: 0, exec_count: 0)

    fn mode_spec() -> text:
        self.spec

    fn probe() -> LaneStatus:
        LaneStatus.Available

    me start(opts: SessionOpts):
        val _ = opts
        self.started = true

    me execute_cell(code: text, cell_id: text) -> CellResult:
        val _ = cell_id
        self.exec_count = self.exec_count + 1
        cell_result_ok("echo({self.spec}): {code}", [], [], 1)

    me interrupt():
        pass_do_nothing("not exercised by this spec")

    me reset():
        self.reset_count = self.reset_count + 1

    me shutdown():
        pass_do_nothing("not exercised by this spec")

class FakeExecutorFactory with NotebookExecutorFactory:
    created_count: i64

    static fn make() -> FakeExecutorFactory:
        FakeExecutorFactory(created_count: 0)

    me create(mode_spec: text) -> NotebookExecutor:
        self.created_count = self.created_count + 1
        FakeExecutor.make(mode_spec)

fn manager_with_fake_factory() -> KernelSessionManager:
    KernelSessionManager.create(FakeExecutorFactory.make())

describe "parse_magics — stripping magic lines from raw cell source":

    it "a cell with no magics is returned untouched":
        step("Verify: a cell with no magics is returned untouched")
        # @req: REQ-LIB-MAGICS-001
        val parsed = parse_magics("val x = 1\nprint(x)")
        expect(parsed.error).to_equal("")
        expect(parsed.code).to_equal("val x = 1\nprint(x)")
        expect(parsed.mode).to_equal("")
        expect(parsed.cell_mode_override).to_equal("")

    it "%mode is stripped and recorded, code preserved":
        step("Verify: %mode is stripped and recorded, code preserved")
        val parsed = parse_magics("%mode interpreter(remote(baremetal(riscv32)))\nval x = 1")
        expect(parsed.error).to_equal("")
        expect(parsed.mode).to_equal("interpreter(remote(baremetal(riscv32)))")
        expect(parsed.code).to_equal("val x = 1")

    it "%%mode as the first line is stripped and recorded as a cell override":
        step("Verify: %%mode as the first line is stripped and recorded as a cell override")
        val parsed = parse_magics("%%mode interpreter(remote(vulkan(spv15)))\nval x = 1")
        expect(parsed.error).to_equal("")
        expect(parsed.cell_mode_override).to_equal("interpreter(remote(vulkan(spv15)))")
        expect(parsed.code).to_equal("val x = 1")
        # %%mode must not also populate the session-default field.
        expect(parsed.mode).to_equal("")

    it "%%mode NOT on the first line is an unknown-magic-position error":
        step("Verify: %%mode NOT on the first line is an unknown-magic-position error")
        val parsed = parse_magics("%mode interpreter\n%%mode interpreter(remote(vulkan(spv15)))\nval x = 1")
        expect_not(parsed.error == "")
        assert_true(parsed.error.contains("%%mode"))
        assert_true(parsed.error.contains("first line"))

    it "a bare %lanes cell strips to empty code":
        step("Verify: a bare %lanes cell strips to empty code")
        val parsed = parse_magics("%lanes")
        expect(parsed.error).to_equal("")
        assert_true(parsed.lanes)
        expect(parsed.code).to_equal("")

    it "%reset is recognized":
        step("Verify: %reset is recognized")
        val parsed = parse_magics("%reset\nval x = 1")
        expect(parsed.error).to_equal("")
        assert_true(parsed.reset)
        expect(parsed.code).to_equal("val x = 1")

    it "%budget parses its integer argument":
        step("Verify: %budget parses its integer argument")
        val parsed = parse_magics("%budget 100000000\nval x = 1")
        expect(parsed.error).to_equal("")
        expect(parsed.budget).to_equal(100000000)  # oracle: authoritative expected value documented by this spec's contract

    it "%timeout parses its integer argument":
        step("Verify: %timeout parses its integer argument")
        val parsed = parse_magics("%timeout 60000\nval x = 1")
        expect(parsed.error).to_equal("")
        expect(parsed.timeout_ms).to_equal(60000)  # oracle: authoritative expected value documented by this spec's contract

    it "%onfault parses its argument":
        step("Verify: %onfault parses its argument")
        val parsed = parse_magics("%onfault reset\nval x = 1")
        expect(parsed.error).to_equal("")
        expect(parsed.onfault).to_equal("reset")

    it "%budget with a non-integer argument is a diagnostic error":
        step("Verify: %budget with a non-integer argument is a diagnostic error")
        val parsed = parse_magics("%budget nope")
        expect_not(parsed.error == "")
        assert_true(parsed.error.contains("%budget"))

    it "%timeout with no argument is a diagnostic error":
        step("Verify: %timeout with no argument is a diagnostic error")
        val parsed = parse_magics("%timeout")
        expect_not(parsed.error == "")
        assert_true(parsed.error.contains("%timeout"))

    it "%onfault with no argument is a diagnostic error":
        step("Verify: %onfault with no argument is a diagnostic error")
        val parsed = parse_magics("%onfault")
        expect_not(parsed.error == "")
        assert_true(parsed.error.contains("%onfault"))

    it "multiple leading magics combine, then the real cell body follows":
        step("Verify: multiple leading magics combine, then the real cell body follows")
        val parsed = parse_magics("%budget 5\n%timeout 10\n%onfault reset\nval x = 1\nval y = 2")
        expect(parsed.error).to_equal("")
        expect(parsed.budget).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
        expect(parsed.timeout_ms).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(parsed.onfault).to_equal("reset")
        expect(parsed.code).to_equal("val x = 1\nval y = 2")

    it "an unknown magic errors with the supported list, not silent ignore":
        step("Verify: an unknown magic errors with the supported list, not silent ignore")
        val parsed = parse_magics("%frobnicate 1\nval x = 1")
        expect_not(parsed.error == "")
        assert_true(parsed.error.contains("Unknown magic"))
        assert_true(parsed.error.contains("%frobnicate"))
        assert_true(parsed.error.contains("%mode"))
        assert_true(parsed.error.contains("%lanes"))
        assert_true(parsed.error.contains("%reset"))
        assert_true(parsed.error.contains("%budget"))
        assert_true(parsed.error.contains("%timeout"))
        assert_true(parsed.error.contains("%onfault"))

    it "a percent sign that is not a leading magic line is left alone (not treated as a magic)":
        step("Verify: a percent sign that is not a leading magic line is left alone (not treated as a magic)")
        val parsed = parse_magics("val x = 10 % 3\nprint(x)")
        expect(parsed.error).to_equal("")
        expect(parsed.code).to_equal("val x = 10 % 3\nprint(x)")

    it "a near-miss keyword with no word boundary is treated as unknown, not misparsed":
        step("Verify: a near-miss keyword with no word boundary is treated as unknown, not misparsed")
        val parsed = parse_magics("%modexyz 1")
        expect_not(parsed.error == "")
        assert_true(parsed.error.contains("%modexyz"))


describe "dispatch_magics — integration against KernelSessionManager":

    it "%mode changes the session default via the manager and confirms it":
        step("Verify: %mode changes the session default via the manager and confirms it")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val state = MagicsState.create()
        val result = dispatch_magics(mgr, "s1", state, "%mode interpreter(remote(baremetal(riscv32)))\nval x = 1")
        expect(result.error).to_equal("")
        expect(mgr.default_mode_of("s1")).to_equal("interpreter(remote(baremetal(riscv32)))")
        expect(result.code).to_equal("val x = 1")
        assert_true(result.message.contains("interpreter(remote(baremetal(riscv32)))"))

    it "an invalid %mode spec surfaces the manager's diagnostic, session default unchanged":
        step("Verify: an invalid %mode spec surfaces the manager's diagnostic, session default unchanged")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val state = MagicsState.create()
        val result = dispatch_magics(mgr, "s1", state, "%mode interpreter(nonsense(riscv32))")
        expect(result.error).to_equal("Unknown platform: nonsense")
        expect(mgr.default_mode_of("s1")).to_equal("interpreter")

    it "%reset resets every cached lane executor for the session":
        step("Verify: %reset resets every cached lane executor for the session")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val r1 = mgr.execute_cell("s1", "code-a", "cell-1", "")
        assert_true(r1.is_ok())
        val state = MagicsState.create()
        val result = dispatch_magics(mgr, "s1", state, "%reset")
        expect(result.error).to_equal("")
        assert_true(result.message.contains("reset"))

    it "%%mode cell isolation: the override runs on its own lane without changing the session default, and does not leak state to the next default-lane cell":
        step("Verify: %%mode cell isolation: the override runs on its own lane without changing the session default, and does not leak state to the next default-lane cell")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val state = MagicsState.create()

        # Cell 1: default lane.
        val r1 = mgr.execute_cell("s1", "cell-one-code", "cell-1", "")
        assert_true(r1.is_ok())
        expect(r1.stdout_delta).to_equal("echo(interpreter): cell-one-code")

        # Cell 2: %%mode override to a different lane, isolated to this cell.
        val parsed2 = dispatch_magics(mgr, "s1", state, "%%mode interpreter(remote(vulkan(spv15)))\ncell-two-code")
        expect(parsed2.error).to_equal("")
        expect(parsed2.cell_mode_override).to_equal("interpreter(remote(vulkan(spv15)))")
        val r2 = mgr.execute_cell("s1", parsed2.code, "cell-2", parsed2.cell_mode_override)
        assert_true(r2.is_ok())
        expect(r2.stdout_delta).to_equal("echo(interpreter(remote(vulkan(spv15)))): cell-two-code")

        # The session default lane is untouched by the %%mode override.
        expect(mgr.default_mode_of("s1")).to_equal("interpreter")

        # Cell 3: back on the default lane (no override) — sees the default
        # lane's own state, not anything from the %%mode-overridden cell.
        val parsed3 = dispatch_magics(mgr, "s1", state, "cell-three-code")
        expect(parsed3.error).to_equal("")
        expect(parsed3.cell_mode_override).to_equal("")
        val r3 = mgr.execute_cell("s1", parsed3.code, "cell-3", parsed3.cell_mode_override)
        assert_true(r3.is_ok())
        expect(r3.stdout_delta).to_equal("echo(interpreter): cell-three-code")

    it "%budget/%timeout/%onfault update MagicsState and are echoed in the confirmation message":
        step("Verify: %budget/%timeout/%onfault update MagicsState and are echoed in the confirmation message")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val state = MagicsState.create()
        val result = dispatch_magics(mgr, "s1", state, "%budget 100000000\n%timeout 60000\n%onfault reset")
        expect(result.error).to_equal("")
        expect(state.budget).to_equal(100000000)  # oracle: authoritative expected value documented by this spec's contract
        expect(state.timeout_ms).to_equal(60000)  # oracle: authoritative expected value documented by this spec's contract
        assert_true(state.onfault_reset)
        assert_true(result.message.contains("100000000"))
        assert_true(result.message.contains("60000"))
        assert_true(result.message.contains("reset"))

    it "%lanes reports the session default and any cached lane executors, probed live":
        step("Verify: %lanes reports the session default and any cached lane executors, probed live")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val _ = mgr.execute_cell("s1", "warm up the default lane", "cell-1", "")
        val state = MagicsState.create()
        val result = dispatch_magics(mgr, "s1", state, "%lanes")
        expect(result.error).to_equal("")
        assert_true(result.message.contains("default: interpreter"))
        assert_true(result.message.contains("interpreter: available"))

    it "an unknown magic never reaches the executor and stops the cell":
        step("Verify: an unknown magic never reaches the executor and stops the cell")
        val mgr = manager_with_fake_factory()
        val _ = mgr.create_session("s1", "interpreter")
        val state = MagicsState.create()
        val result = dispatch_magics(mgr, "s1", state, "%frobnicate 1\nval x = 1")
        expect_not(result.error == "")
        assert_true(result.error.contains("Unknown magic"))
        expect(result.code).to_equal("")
