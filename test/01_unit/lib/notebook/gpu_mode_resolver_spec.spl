"""
## Purpose and audience
Purpose: Verify resolve_gpu_mode_spec — tag classification.
Audience: compiler and tooling engineers who maintain this spec.

GPU mode resolver unit spec (P11).

Covers the FULL resolution matrix of `resolve_gpu_mode_spec(tag, config,
probe)` with a fake probe injected, so no GPU device is needed:

  * explicit full mode-spec  -> passed through VERBATIM (power users)
  * bare `gpu` + configured backend -> expanded from config, no probe
  * bare `gpu` + `backend: auto`    -> probe order cuda -> vulkan -> metal
  * no tag                          -> host
  * nothing available               -> honest error listing EACH backend's
                                       own skip reason

The fake probe records the exact order it was asked, so "first non-skip
wins" is asserted against observed calls, not assumed. Reason strings in the
fixtures are the REAL strings the lane sessions emit
(cuda_lane_session.spl:154, vulkan_lane_session.spl:116,
metal_lane_session.spl:149) — in particular Metal's
"skip:metal-unavailable-not-macos", which is the correct answer on this
Linux host and is asserted as such, never fixed up.

Design: doc/05_design/app/tools/gpu_debugger_common_interface_architecture_2026-08-09.md §7b
Plan:   doc/03_plan/agent_tasks/unified_debug_profile_capability_parallel_plan_2026-08-09.md (P11)
"""

# @req: REQ-LIB-GPU-MODE-RESOLVER-001 — stable requirement identity for this spec.

use std.spec
use std.notebook.gpu_config.{GpuConfig, default_gpu_config, parse_gpu_config}
use std.notebook.gpu_mode_resolver.{
    GpuBackendProbe, resolve_gpu_mode_spec, compose_gpu_mode_spec,
    default_arch_for_backend, is_bare_gpu_tag, is_host_tag
}
use std.test_runner.test_executor_composite_parse.{
    extract_base_runtime, extract_remote_backend, extract_gpu_submode
}

# Real probe strings, copied from the lane sessions they come from.
val CUDA_ABSENT = "skip:cuda-driver-unavailable"
val VULKAN_ABSENT = "skip:vulkan-loader-unavailable"
val METAL_ABSENT = "skip:metal-unavailable-not-macos"

# ---------------------------------------------------------------------------
# Fake probe: answers from a fixed availability list and records call order.
# ---------------------------------------------------------------------------

class FakeGpuProbe:
    available: [text]
    calls: [text]

impl FakeGpuProbe:
    static fn with_available(available: [text]) -> FakeGpuProbe:
        FakeGpuProbe(available: available, calls: [])

    static fn none_available() -> FakeGpuProbe:
        FakeGpuProbe(available: [], calls: [])

impl GpuBackendProbe for FakeGpuProbe:
    me probe_backend(backend: text) -> text:
        self.calls.push(backend)
        for name in self.available:
            if name == backend:
                return ""
        if backend == "cuda": return CUDA_ABSENT
        if backend == "vulkan": return VULKAN_ABSENT
        if backend == "metal": return METAL_ABSENT
        "skip:unknown-backend-{backend}"

fn auto_config() -> GpuConfig:
    default_gpu_config()

fn config_of(backend: text, submode: text, arch: text) -> GpuConfig:
    GpuConfig(backend: backend, submode: submode, arch: arch)

describe "resolve_gpu_mode_spec — tag classification":

    it "treats an empty tag as host and a bare gpu tag as GPU":
        step("Verify: treats an empty tag as host and a bare gpu tag as GPU")
        # @req: REQ-LIB-GPU-MODE-RESOLVER-001
        assert_true(is_host_tag(""))
        assert_true(is_host_tag("host"))
        assert_true(is_bare_gpu_tag("gpu"))
        # DAP launch config `"gpu": true` and Lab API `{"gpu": true}`.
        assert_true(is_bare_gpu_tag("true"))
        assert_true(is_bare_gpu_tag("  GPU  "))
        assert_false(is_bare_gpu_tag("interpreter(remote(cuda(sm80)))"))

describe "resolve_gpu_mode_spec — no tag means host":

    it "resolves the empty tag to the host lane without probing anything":
        step("Verify: resolves the empty tag to the host lane without probing anything")
        var probe = FakeGpuProbe.with_available(["cuda", "vulkan"])
        val resolved = resolve_gpu_mode_spec("", auto_config(), probe)
        expect(resolved.target).to_equal("host")
        expect(resolved.spec).to_equal("")
        expect(resolved.error).to_equal("")
        # No tag must never cost a device probe.
        expect(probe.calls.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "resolve_gpu_mode_spec — explicit spec passthrough":

    it "passes a full composite mode-spec through verbatim":
        step("Verify: passes a full composite mode-spec through verbatim")
        var probe = FakeGpuProbe.none_available()
        val spec = "interpreter(remote(cuda(sm80)))"
        val resolved = resolve_gpu_mode_spec(spec, auto_config(), probe)
        expect(resolved.spec).to_equal(spec)
        expect(resolved.target).to_equal("cuda")
        expect(resolved.error).to_equal("")
        # Power users are never re-probed, never rewritten -- even when the
        # probe would have reported every backend absent.
        expect(probe.calls.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "passes an explicit resident cuda spec through unchanged":
        step("Verify: passes an explicit resident cuda spec through unchanged")
        var probe = FakeGpuProbe.none_available()
        val spec = "interpreter(remote(cuda(sm80(resident))))"
        val resolved = resolve_gpu_mode_spec(spec, auto_config(), probe)
        expect(resolved.spec).to_equal(spec)
        expect(resolved.target).to_equal("cuda")
        expect(extract_gpu_submode(resolved.spec)).to_equal("resident")

    it "passes an explicit vulkan spec through unchanged":
        step("Verify: passes an explicit vulkan spec through unchanged")
        var probe = FakeGpuProbe.with_available(["cuda"])
        val spec = "jit(remote(vulkan(spv15)))"
        val resolved = resolve_gpu_mode_spec(spec, auto_config(), probe)
        expect(resolved.spec).to_equal(spec)
        expect(resolved.target).to_equal("vulkan")
        expect(probe.calls.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "resolve_gpu_mode_spec — bare gpu with a configured backend":

    it "expands from config without probing when backend is pinned":
        step("Verify: expands from config without probing when backend is pinned")
        var probe = FakeGpuProbe.none_available()
        val resolved = resolve_gpu_mode_spec("gpu", config_of("cuda", "interpreter", "auto"), probe)
        expect(resolved.spec).to_equal("interpreter(remote(cuda(sm80)))")
        expect(resolved.target).to_equal("cuda")
        expect(resolved.error).to_equal("")
        # A pinned backend is authoritative -- resolution does not probe.
        expect(probe.calls.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "honours an explicit arch and submode from config":
        step("Verify: honours an explicit arch and submode from config")
        var probe = FakeGpuProbe.none_available()
        val resolved = resolve_gpu_mode_spec("gpu", config_of("vulkan", "jit", "spv16"), probe)
        expect(resolved.spec).to_equal("jit(remote(vulkan(spv16)))")
        expect(resolved.target).to_equal("vulkan")

    it "expands arch auto to each backend's canonical default":
        step("Verify: expands arch auto to each backend's canonical default")
        expect(default_arch_for_backend("cuda")).to_equal("sm80")
        expect(default_arch_for_backend("vulkan")).to_equal("spv15")
        expect(default_arch_for_backend("metal")).to_equal("msl2")

    it "rejects an unknown configured backend by name":
        step("Verify: rejects an unknown configured backend by name")
        var probe = FakeGpuProbe.with_available(["cuda"])
        val resolved = resolve_gpu_mode_spec("gpu", config_of("opencl", "interpreter", "auto"), probe)
        expect(resolved.spec).to_equal("")
        assert_true(resolved.error.contains("unknown backend 'opencl'"))
        assert_true(resolved.error.contains("auto | cuda | vulkan | metal"))

describe "resolve_gpu_mode_spec — bare gpu with backend auto":

    it "probes cuda first and stops there when cuda is available":
        step("Verify: probes cuda first and stops there when cuda is available")
        var probe = FakeGpuProbe.with_available(["cuda", "vulkan"])
        val resolved = resolve_gpu_mode_spec("gpu", auto_config(), probe)
        expect(resolved.spec).to_equal("interpreter(remote(cuda(sm80)))")
        expect(resolved.target).to_equal("cuda")
        # cuda answered first, so vulkan/metal are never asked.
        expect(probe.calls.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(probe.calls[0]).to_equal("cuda")

    it "falls through to vulkan when cuda is absent":
        step("Verify: falls through to vulkan when cuda is absent")
        var probe = FakeGpuProbe.with_available(["vulkan", "metal"])
        val resolved = resolve_gpu_mode_spec("gpu", auto_config(), probe)
        expect(resolved.spec).to_equal("interpreter(remote(vulkan(spv15)))")
        expect(resolved.target).to_equal("vulkan")
        # cuda asked first, vulkan second, metal never reached.
        expect(probe.calls.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(probe.calls[0]).to_equal("cuda")
        expect(probe.calls[1]).to_equal("vulkan")

    it "falls through to metal only when cuda and vulkan are both absent":
        step("Verify: falls through to metal only when cuda and vulkan are both absent")
        var probe = FakeGpuProbe.with_available(["metal"])
        val resolved = resolve_gpu_mode_spec("gpu", auto_config(), probe)
        expect(resolved.spec).to_equal("interpreter(remote(metal(msl2)))")
        expect(resolved.target).to_equal("metal")
        expect(probe.calls.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(probe.calls[0]).to_equal("cuda")
        expect(probe.calls[1]).to_equal("vulkan")
        expect(probe.calls[2]).to_equal("metal")

describe "resolve_gpu_mode_spec — nothing available":

    it "errors listing every backend's own skip reason":
        step("Verify: errors listing every backend's own skip reason")
        var probe = FakeGpuProbe.none_available()
        val resolved = resolve_gpu_mode_spec("gpu", auto_config(), probe)
        expect(resolved.spec).to_equal("")
        expect(resolved.target).to_equal("")
        assert_true(resolved.error.contains("no GPU backend available"))
        # Each backend reports for ITSELF -- verbatim, never a generic
        # "no GPU found". Metal's reason on a non-macOS host is the real
        # rt_metal_is_available() answer.
        assert_true(resolved.error.contains("cuda: {CUDA_ABSENT}"))
        assert_true(resolved.error.contains("vulkan: {VULKAN_ABSENT}"))
        assert_true(resolved.error.contains("metal: {METAL_ABSENT}"))
        # All three were really asked, in order.
        expect(probe.calls.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

describe "resolve_gpu_mode_spec — expansion round-trips through the canonical grammar":

    it "produces specs the existing composite extractors parse identically":
        step("Verify: produces specs the existing composite extractors parse identically")
        var probe = FakeGpuProbe.with_available(["cuda"])
        val resolved = resolve_gpu_mode_spec("gpu", auto_config(), probe)
        # The expansion is exactly what a power user would have typed, so the
        # canonical extractors read it back with no special-casing.
        expect(extract_base_runtime(resolved.spec)).to_equal("interpreter")
        expect(extract_remote_backend(resolved.spec)).to_equal("cuda")
        expect(extract_gpu_submode(resolved.spec)).to_equal("launch")

    it "composes vulkan specs the extractors classify as dispatch":
        step("Verify: composes vulkan specs the extractors classify as dispatch")
        val spec = compose_gpu_mode_spec("interpreter", "vulkan", "spv15")
        expect(spec).to_equal("interpreter(remote(vulkan(spv15)))")
        expect(extract_remote_backend(spec)).to_equal("vulkan")
        expect(extract_gpu_submode(spec)).to_equal("dispatch")

describe "gpu config — the [gpu] section of simple.sdn":

    it "defaults to auto/interpreter/auto when no gpu section exists":
        step("Verify: defaults to auto/interpreter/auto when no gpu section exists")
        val config = parse_gpu_config("project:\n  name: demo\n  version: 1.0.0\n")
        expect(config.backend).to_equal("auto")
        expect(config.submode).to_equal("interpreter")
        expect(config.arch).to_equal("auto")

    it "reads backend, submode and arch from the gpu section":
        step("Verify: reads backend, submode and arch from the gpu section")
        val text_content = "project:\n  name: demo\n\ngpu:\n  backend: cuda\n  submode: jit\n  arch: sm90\n"
        val config = parse_gpu_config(text_content)
        expect(config.backend).to_equal("cuda")
        expect(config.submode).to_equal("jit")
        expect(config.arch).to_equal("sm90")

    it "ignores trailing comments and unknown keys":
        step("Verify: ignores trailing comments and unknown keys")
        val text_content = "gpu:\n  backend: vulkan   # auto | cuda | vulkan | metal\n  future_key: 7\n"
        val config = parse_gpu_config(text_content)
        expect(config.backend).to_equal("vulkan")
        expect(config.submode).to_equal("interpreter")

    it "stops at the next top-level section":
        step("Verify: stops at the next top-level section")
        val text_content = "gpu:\n  backend: metal\n\nlints:\n  backend: cuda\n"
        val config = parse_gpu_config(text_content)
        expect(config.backend).to_equal("metal")

    it "drives resolution end to end from parsed config":
        step("Verify: drives resolution end to end from parsed config")
        var probe = FakeGpuProbe.none_available()
        val config = parse_gpu_config("gpu:\n  backend: cuda\n  arch: sm86\n")
        val resolved = resolve_gpu_mode_spec("gpu", config, probe)
        expect(resolved.spec).to_equal("interpreter(remote(cuda(sm86)))")
