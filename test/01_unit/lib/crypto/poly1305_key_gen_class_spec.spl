# @req: REQ-LIB-CRYPTO-001

# Class-detection spec for the "RFC-mandated crypto helper missing / wrong
# block counter" defect class.
#
# The reproducing spec (poly1305_spec.spl) proves poly1305_key_gen exists and
# matches the RFC 8439 section 2.6.2 KAT. This spec pins the two ways that fix
# can silently regress into a look-alike:
#
#   1. The one-time key is derived at block counter 0. Deriving it at counter 1
#      (the counter chacha20_poly1305 uses for the ciphertext) still returns 32
#      plausible-looking bytes and still passes any length check, but produces
#      the wrong key and silently breaks every AEAD tag. We assert the derived
#      key is byte-for-byte the counter-0 keystream AND differs from counter 1.
#
#   2. The helper exists in std.crypto.poly1305 but not in the os.crypto mirror
#      (the original defect: the grep in the bug doc found zero hits in BOTH
#      modules). We assert both copies derive the identical one-time key.
#
# @req REQ-CRYPTO-POLY1305-KEYGEN

use std.common.crypto.poly1305.poly1305_key_gen
use std.common.crypto.chacha20.chacha20_encrypt
use os.crypto.poly1305.poly1305_key_gen as os_poly1305_key_gen

fn _key() -> [u8]:
    [0x80u8, 0x81u8, 0x82u8, 0x83u8, 0x84u8, 0x85u8, 0x86u8, 0x87u8,
     0x88u8, 0x89u8, 0x8au8, 0x8bu8, 0x8cu8, 0x8du8, 0x8eu8, 0x8fu8,
     0x90u8, 0x91u8, 0x92u8, 0x93u8, 0x94u8, 0x95u8, 0x96u8, 0x97u8,
     0x98u8, 0x99u8, 0x9au8, 0x9bu8, 0x9cu8, 0x9du8, 0x9eu8, 0x9fu8]

fn _nonce() -> [u8]:
    [0x00u8, 0x00u8, 0x00u8, 0x00u8,
     0x00u8, 0x00u8, 0x00u8, 0x00u8,
     0x00u8, 0x00u8, 0x00u8, 0x00u8]

fn _zeros32() -> [u8]:
    var z: [u8] = []
    var i: u64 = 0
    while i < 32:
        z.push(0)
        i = i + 1
    z

fn _first32(b: [u8]) -> [u8]:
    var o: [u8] = []
    var i: u64 = 0
    while i < 32:
        o.push(b[i])
        i = i + 1
    o

fn _bytes_eq(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i: u64 = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

use std.spec.step

describe "poly1305_key_gen block-counter class":

    it "derives the one-time key from the counter-0 ChaCha20 keystream":
        # @req: REQ-CRYPTO-POLY1305-KEYGEN
        step("Verify: derives the one-time key from the counter-0 ChaCha20 keystream")
        val otk = poly1305_key_gen(_key(), _nonce())
        val ks0 = _first32(chacha20_encrypt(_key(), 0, _nonce(), _zeros32()))
        expect(_bytes_eq(otk, ks0)).to_equal(true)

    it "does not derive the one-time key at block counter 1":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: does not derive the one-time key at block counter 1")
        # Guard the guard: counter 0 and counter 1 must really differ, else the
        # assertion below would pass against a counter-1 implementation too.
        val ks0 = _first32(chacha20_encrypt(_key(), 0, _nonce(), _zeros32()))
        val ks1 = _first32(chacha20_encrypt(_key(), 1, _nonce(), _zeros32()))
        expect(_bytes_eq(ks0, ks1)).to_equal(false)

        val otk = poly1305_key_gen(_key(), _nonce())
        expect(_bytes_eq(otk, ks1)).to_equal(false)

describe "poly1305_key_gen module-mirror class":

    it "os.crypto.poly1305 derives the identical one-time key as std.crypto.poly1305":
        # @req: REQ-CRYPTO-POLY1305-KEYGEN
        step("Verify: os.crypto.poly1305 derives the identical one-time key as std.crypto.poly1305")
        val a = poly1305_key_gen(_key(), _nonce())
        val b = os_poly1305_key_gen(_key(), _nonce())
        expect(_bytes_eq(a, b)).to_equal(true)

    it "both module copies return exactly 32 bytes":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: both module copies return exactly 32 bytes")
        expect(poly1305_key_gen(_key(), _nonce()).len()).to_equal(32u64)  # oracle: 32u64 — named expected value from the requirement
        expect(os_poly1305_key_gen(_key(), _nonce()).len()).to_equal(32u64)  # oracle: 32u64 — named expected value from the requirement
