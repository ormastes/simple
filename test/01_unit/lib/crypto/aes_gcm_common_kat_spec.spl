# std.common.crypto.aes_gcm known-answer tests (encrypt + decrypt, AES-128/256).
#
# Vectors: NIST/McGrew-Viega GCM spec test cases 2 (AES-128) and 14 (AES-256),
# zero key, zero 96-bit IV, one zero plaintext block; FIPS 197 C.1/C.3 for the
# inverse cipher. Guards the S-box / inverse S-box table-hoist refactor.

use std.spec.step
use std.spec.*
use std.common.crypto.aes_gcm.{
    aes128_key_expansion, aes256_key_expansion,
    aes128_decrypt_block, aes256_decrypt_block,
    aes128_gcm_encrypt, aes128_gcm_decrypt,
    aes256_gcm_encrypt, aes256_gcm_decrypt, AesGcmResult
}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

fn _to_u8(vals: list) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < vals.len():
        out.push((vals[i] & 0xFF).to_u8())
        i = i + 1
    out

fn _to_i64(arr: [u8], from: i64, n: i64) -> list:
    var out: [i64] = []
    var i = 0
    while i < n:
        out.push(rt_bytes_u8_at(arr, from + i))
        i = i + 1
    out

fn _zeros(n: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < n:
        out.push(0x00u8)
        i = i + 1
    out

fn _ct128() -> list:
    [0x03, 0x88, 0xda, 0xce, 0x60, 0xb6, 0xa3, 0x92, 0xf3, 0x28, 0xc2, 0xb9, 0x71, 0xb2, 0xfe, 0x78]

fn _tag128() -> list:
    [0xab, 0x6e, 0x47, 0xd4, 0x2c, 0xec, 0x13, 0xbd, 0xf5, 0x3a, 0x67, 0xb2, 0x12, 0x57, 0xbd, 0xdf]

fn _ct256() -> list:
    [0xce, 0xa7, 0x40, 0x3d, 0x4d, 0x60, 0x6b, 0x6e, 0x07, 0x4e, 0xc5, 0xd3, 0xba, 0xf3, 0x9d, 0x18]

fn _tag256() -> list:
    [0xd0, 0xd1, 0xc8, 0xa7, 0x99, 0x99, 0x6b, 0xf0, 0x26, 0x5b, 0x98, 0xb5, 0xd4, 0x8a, 0xb9, 0x19]

fn _fips_pt() -> list:
    [0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff]

fn _fips_key128() -> list:
    [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f]

fn _fips_ct128() -> list:
    [0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30, 0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a]

fn _fips_key256() -> list:
    [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
     0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f]

fn _fips_ct256() -> list:
    [0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf, 0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89]

describe "std.common.crypto.aes_gcm known-answer tests":
    # @manual scenario evidence

    it "AES-128-GCM encrypts NIST test case 2":
        # @req REQ-SSPEC-LIB
        step("AES-128-GCM encrypts NIST test case 2")
        val out = aes128_gcm_encrypt(_zeros(16), _zeros(12), _zeros(16), _zeros(0))
        expect(_to_i64(out, 0, 16)).to_equal(_ct128())
        expect(_to_i64(out, 16, 16)).to_equal(_tag128())

    it "AES-128-GCM decrypts NIST test case 2 and rejects a bad tag":
        # @req REQ-SSPEC-LIB
        step("AES-128-GCM decrypts NIST test case 2 and rejects a bad tag")
        val ok = aes128_gcm_decrypt(_zeros(16), _zeros(12), _to_u8(_ct128()), _zeros(0), _to_u8(_tag128()))
        match ok:
            AesGcmResult.Ok(pt):
                expect(_to_i64(pt, 0, 16)).to_equal(_to_i64(_zeros(16), 0, 16))
            AesGcmResult.Err(msg):
                fail("AES-128-GCM decrypt rejected a valid tag")
        val bad = aes128_gcm_decrypt(_zeros(16), _zeros(12), _to_u8(_ct128()), _zeros(0), _zeros(16))
        match bad:
            AesGcmResult.Ok(pt):
                fail("AES-128-GCM decrypt accepted a bad tag")
            AesGcmResult.Err(msg):
                expect(msg).to_equal("authentication tag mismatch")

    it "AES-256-GCM encrypts NIST test case 14":
        # @req REQ-SSPEC-LIB
        step("AES-256-GCM encrypts NIST test case 14")
        val out = aes256_gcm_encrypt(_zeros(32), _zeros(12), _zeros(16), _zeros(0))
        expect(_to_i64(out, 0, 16)).to_equal(_ct256())
        expect(_to_i64(out, 16, 16)).to_equal(_tag256())

    it "AES-256-GCM decrypts NIST test case 14 and rejects a bad tag":
        # @req REQ-SSPEC-LIB
        step("AES-256-GCM decrypts NIST test case 14 and rejects a bad tag")
        val ok = aes256_gcm_decrypt(_zeros(32), _zeros(12), _to_u8(_ct256()), _zeros(0), _to_u8(_tag256()))
        match ok:
            AesGcmResult.Ok(pt):
                expect(_to_i64(pt, 0, 16)).to_equal(_to_i64(_zeros(16), 0, 16))
            AesGcmResult.Err(msg):
                fail("AES-256-GCM decrypt rejected a valid tag")
        val bad = aes256_gcm_decrypt(_zeros(32), _zeros(12), _to_u8(_ct256()), _zeros(0), _zeros(16))
        match bad:
            AesGcmResult.Ok(pt):
                fail("AES-256-GCM decrypt accepted a bad tag")
            AesGcmResult.Err(msg):
                expect(msg).to_equal("authentication tag mismatch")

    it "inverse cipher decrypts FIPS 197 C.1 (AES-128) and C.3 (AES-256)":
        # @req REQ-SSPEC-LIB
        step("inverse cipher decrypts FIPS 197 C.1 (AES-128) and C.3 (AES-256)")
        val p128 = aes128_decrypt_block(_to_u8(_fips_ct128()), aes128_key_expansion(_to_u8(_fips_key128())))
        expect(_to_i64(p128, 0, 16)).to_equal(_fips_pt())
        val p256 = aes256_decrypt_block(_to_u8(_fips_ct256()), aes256_key_expansion(_to_u8(_fips_key256())))
        expect(_to_i64(p256, 0, 16)).to_equal(_fips_pt())
