# Regression: public HMAC byte APIs must be reachable by TLS and callers.
# @req REQ-HMAC-PUBLIC-BYTES-001
use std.spec.*
use std.spec.step
use std.crypto.hmac.{hmac_sha384_bytes, hmac_sha512_bytes}
use std.crypto.types.{bytes_to_hex}

describe "Public HMAC byte exports":
    it "exports SHA384 with the known answer for Hi There":
        step("Call SHA384 through the public namespace used by TLS12 PRF")
        val key = [11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11]
        val data = [72, 105, 32, 84, 104, 101, 114, 101]
        val result = hmac_sha384_bytes(key, data)
        expect(result.len()).to_equal(48)
        expect(bytes_to_hex(result)).to_equal("afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")

    it "exports SHA512 with the known answer for Hi There":
        step("Call SHA512 through the public namespace used by existing callers")
        val key = [11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11]
        val data = [72, 105, 32, 84, 104, 101, 114, 101]
        val result = hmac_sha512_bytes(key, data)
        expect(result.len()).to_equal(64)
        expect(bytes_to_hex(result)).to_equal("87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
