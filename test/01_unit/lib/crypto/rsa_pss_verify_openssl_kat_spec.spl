"""
## Purpose and audience
Known-answer evidence for RSASSA-PSS verification (SHA-256, MGF1-SHA-256) in
std.common.crypto.rsa_pss, for TLS 1.3 stack maintainers (rsa_pss_rsae_sha256
CertificateVerify) and crypto reviewers.

Vector provenance (read this before trusting the vectors): no network was
available to fetch NIST CAVS SigVerPSS_186-3 or Wycheproof files, so the
signatures here were produced by an INDEPENDENT implementation (pyca/cryptography
41.0.7 on OpenSSL 3.0.13), never by this repository's signer.  They are
OpenSSL known answers, not published standard-body vectors.  The 2048-bit
public key is the repository's vendored ring test key
(src/compiler_rust/vendor/ring/tests/rsa_test_private_key_2048.p8).
RFC 8017 section 8.1.2 / 9.1.2 define the checked algorithm.
"""

use std.spec.step
use std.spec.*
use std.common.crypto.rsa_pss.{
    rsa_pss_verify_sha256, rsa_pss_verify_sha256_with_salt_len, rsa_pss_emsa_verify_sha256
}

fn _hd(c: text) -> i64:
    if c == "0": return 0
    if c == "1": return 1
    if c == "2": return 2
    if c == "3": return 3
    if c == "4": return 4
    if c == "5": return 5
    if c == "6": return 6
    if c == "7": return 7
    if c == "8": return 8
    if c == "9": return 9
    if c == "a": return 10
    if c == "b": return 11
    if c == "c": return 12
    if c == "d": return 13
    if c == "e": return 14
    if c == "f": return 15
    -1

fn _hex(s: text) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < s.len():
        out.push((_hd(s[i]) * 16 + _hd(s[i + 1])).to_u8())
        i = i + 2
    out

fn _msg() -> [u8]:
    # "TLS 1.3, server CertificateVerify"
    _hex("544c5320312e332c20736572766572204365727469666963617465566572696679")

fn _n1024() -> text:
    "f40f44e1200ef728946d2d3812c7e883169e75edc0094e34b9fb2f3115a4121cfb4d1d7b632a1b0138e7d52741ab8895fddb30ccf907cebff7c5db825c96f980c14626ecc414daa057d465cf44089569cab97208d98fc9c6837046360f2820dd0fe473ebba8652836ae4348a0670c77b1793dfed41c688d48f29a95fd991b83d"

fn _sig1024() -> text:
    "bd409e8406d8b420a5f3ce39fb155708a410ac2e09a8941f4b4535a8b1dd78e8495957d5cdaa2c5f0d6c4e86ce13500a5dd461bf91607420949318f73217973646a798b7518b28650050054d25a6da68c5e372a6cdd42a96076d3acd16345ec096bc53b940d71d882c76bb56e0d58c073c8cc3ba27772f444d305cf8941a2361"

fn _sig1024_s20() -> text:
    "6f6d498da9b03024e6a2553d33e6d520c841250726202974e8866dd8d42fca329e221c7be3e622844c427350064aee51cd555c63eac8093df8a55e1fa9fec62b429e61747068e2cb185ec2e234b45e30877bfd47095d06c1aff1deaf7d1569439cb36a3b0678ae5de8f2cdc72096bb965682e7e2459faee0ae407638e5426f38"

fn _em1024() -> text:
    "0e181bea22846d862682da2b43234fad753e58642f567c2be169f4575f13572a034b623890d0318370a3fb23a005f03a1567608bee03286764ae8ffd205704da3c634707642a86cf981bdae29e0495b4fe39e5c85830456ba1b5f265e63eff173ecda592cc9a7ad6f424886962c4db6dad5973296bc0cda07eaad06935608ebc"

fn _em1024_s20() -> text:
    "5dc4334851de57bcdfc7cca960a7687387692092d1f47e42cf5fb2d1eadfa5f657653ee38b915581ef43d6af6bfc6b0bf6abb7d9aeddfb35a79e8b5af49312bbe3005d52057898b8d68f2b21bf605601f92ce9cadbe60ed4731ecd3914fb7d107c4529c20a52b9dbb77b8ed100d2b2f19ccac0ec357f31bca10acc0fad5aa1bc"

fn _n2048() -> text:
    ""

fn _sig2048() -> text:
    ""

describe "RSASSA-PSS SHA-256 verification":
    # @manual_section: rsa_pss_verify

    it "accepts the EMSA-PSS encoding of a OpenSSL-produced RSA-1024 signature":
        # @req REQ-CRYPTO-RSAPSS-001
        step("EMSA-PSS-VERIFY accepts a valid EM (sLen 32 and 20) and rejects altered EM / salt length")
        # @capture(kat): OPENSSL-PSS-1024-EM
        expect(rsa_pss_emsa_verify_sha256(_msg(), _hex(_em1024()), 1023, 32)).to_equal(true)
        expect(rsa_pss_emsa_verify_sha256(_msg(), _hex(_em1024_s20()), 1023, 20)).to_equal(true)
        # wrong salt length for the encoding
        expect(rsa_pss_emsa_verify_sha256(_msg(), _hex(_em1024_s20()), 1023, 32)).to_equal(false)
        # wrong message
        expect(rsa_pss_emsa_verify_sha256(_hex("00"), _hex(_em1024()), 1023, 32)).to_equal(false)

    it "rejects an EM whose trailer, hash or padding was modified":
        # @req REQ-CRYPTO-RSAPSS-002
        step("EMSA-PSS-VERIFY rejects modified bc trailer, H and DB")
        # @capture(kat): OPENSSL-PSS-1024-EM-negative
        expect(rsa_pss_emsa_verify_sha256(_msg(), _hex("0e181bea22846d862682da2b43234fad753e58642f567c2be169f4575f13572a034b623890d0318370a3fb23a005f03a1567608bee03286764ae8ffd205704da3c634707642a86cf981bdae29e0495b4fe39e5c85830456ba1b5f265e63eff173ecda592cc9a7ad6f424886962c4db6dad5973296bc0cda07eaad06935608ebd"), 1023, 32)).to_equal(false)
        expect(rsa_pss_emsa_verify_sha256(_msg(), _hex("0e181bea22846d862682da2b43234fad753e58642f567c2be169f4575f13572a034b623890d0318370a3fb23a005f03a1567608bee03286764ae8ffd205704da3c634707642a86cf981bdae29e0495b4fe39e5c85830456ba1b5f265e63eff173ecda592cc9b7ad6f424886962c4db6dad5973296bc0cda07eaad06935608ebc"), 1023, 32)).to_equal(false)
        expect(rsa_pss_emsa_verify_sha256(_msg(), _hex("0e191bea22846d862682da2b43234fad753e58642f567c2be169f4575f13572a034b623890d0318370a3fb23a005f03a1567608bee03286764ae8ffd205704da3c634707642a86cf981bdae29e0495b4fe39e5c85830456ba1b5f265e63eff173ecda592cc9a7ad6f424886962c4db6dad5973296bc0cda07eaad06935608ebc"), 1023, 32)).to_equal(false)

    it "verifies the full RSA-1024 PSS signature":
        # @req REQ-CRYPTO-RSAPSS-003
        step("RSASSA-PSS-VERIFY accepts a valid 1024-bit signature (sLen 32 and explicit 20)")
        # @capture(kat): OPENSSL-PSS-1024-SIG
        expect(rsa_pss_verify_sha256(_hex(_n1024()), _hex("010001"), _msg(), _hex(_sig1024()))).to_equal(true)
        expect(rsa_pss_verify_sha256_with_salt_len(_hex(_n1024()), _hex("010001"), _msg(), _hex(_sig1024_s20()), 20)).to_equal(true)

    it "rejects a modified signature, wrong salt length and wrong message":
        # @req REQ-CRYPTO-RSAPSS-004
        step("RSASSA-PSS-VERIFY rejects forgeries")
        # @capture(kat): OPENSSL-PSS-1024-SIG-negative
        expect(rsa_pss_verify_sha256(_hex(_n1024()), _hex("010001"), _msg(), _hex("bd409e8406d8b420a5f3ce39fb155708a410ac2e09a8941f4b4535a8b1dd78e8495957d5cdaa2c5f0d6c4e86ce13500a5dd461bf91607420949318f73317973646a798b7518b28650050054d25a6da68c5e372a6cdd42a96076d3acd16345ec096bc53b940d71d882c76bb56e0d58c073c8cc3ba27772f444d305cf8941a2361"))).to_equal(false)
        expect(rsa_pss_verify_sha256(_hex(_n1024()), _hex("010001"), _msg(), _hex(_sig1024_s20()))).to_equal(false)
        expect(rsa_pss_verify_sha256(_hex(_n1024()), _hex("010001"), _hex("00"), _hex(_sig1024()))).to_equal(false)
        # signature too short
        expect(rsa_pss_verify_sha256(_hex(_n1024()), _hex("010001"), _msg(), _hex("0102"))).to_equal(false)

    it "verifies a RSA-2048 PSS signature (rsa_pss_rsae_sha256 key size)":
        # @req REQ-CRYPTO-RSAPSS-005
        step("RSASSA-PSS-VERIFY accepts a 2048-bit signature and rejects a flipped one")
        # @capture(kat): OPENSSL-PSS-2048-SIG
        expect(rsa_pss_verify_sha256(_hex(_n2048()), _hex("010001"), _msg(), _hex(_sig2048()))).to_equal(true)
        expect(rsa_pss_verify_sha256(_hex(_n2048()), _hex("010001"), _msg(), _hex(""))).to_equal(false)
