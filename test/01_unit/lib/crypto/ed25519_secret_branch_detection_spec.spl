# @req: REQ-LIB-CRYPTO-001

# DETECTION spec for the secret-scalar branching CLASS, not one instance.
#
# The reproducer (`ed25519_ct_property_spec.spl`) inspects exactly one
# function, `ed_scalar_mul`, and matches three literal fingerprints of the
# old branchful body. That is too narrow twice over:
#
#   1. `ed_scalar_mul` was not the function actually reached by signing.
#      `ed_scalar_mul_basepoint` delegated to `ed_scalar_mul_basepoint_simple`,
#      a *separate* double-and-add loop that branched on every secret scalar
#      bit. Auditing only `ed_scalar_mul` would have reported the timing side
#      channel as fixed while every signature still leaked.
#   2. Fingerprint matching on old source text cannot see a NEW branchful
#      body written in a different shape.
#
# So this spec asserts the property over EVERY scalar-multiplication entry
# point in the module: none of them may contain an `if` whose condition
# mentions a scalar-bit or scalar-digit accessor. It is deliberately phrased
# as "no branch names a secret accessor" rather than "no old text survives".

use std.spipe.*

extern fn rt_file_read_text(path: text) -> text

val SRC_PATH: text = "src/os/crypto/ed25519_ops.spl"

# Accessors that yield a value derived from the secret scalar. An `if` whose
# condition mentions one of these is a data-dependent branch on key material.
fn _secret_accessors() -> [text]:
    ["_ed_scalar_bit", "scalar[", "byte_val", "digit"]

fn _fn_body(src: text, header: text) -> text:
    val start_opt = src.find(header)
    val start: i64 = start_opt ?? (-1).to_i64()
    if start < 0:
        return ""
    val after: u64 = start.to_u64() + header.len()
    val rest = src.substring(after, src.len())
    val next_opt = rest.find("\nfn ")
    val nfo: i64 = next_opt ?? (-1).to_i64()
    var body_end: u64 = src.len()
    if nfo >= 0:
        body_end = after + nfo.to_u64()
    src.substring(after, body_end)

# Count `if` lines in `body` whose condition text mentions a secret accessor.
fn _secret_branch_count(body: text) -> u64:
    var count: u64 = 0
    val lines = body.split("\n")
    var i: u64 = 0
    while i < lines.len():
        val line = lines[i].trim()
        val is_if = line.starts_with("if ") or line.starts_with("elif ")
        if is_if:
            var a: u64 = 0
            val accessors = _secret_accessors()
            while a < accessors.len():
                val hit: i64 = line.find(accessors[a])
                if hit >= 0:
                    count = count + 1
                a = a + 1
        i = i + 1
    count

use std.spec.step

describe "Ed25519: no scalar-multiplication path branches on secret material":

    it "the module under audit is readable and non-empty":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: the module under audit is readable and non-empty")
        # Guards against a vacuous green if the path ever moves: an empty
        # read would make every branch count trivially zero.
        val src = rt_file_read_text(SRC_PATH)
        expect(src.len() > 1000u64).to_be(true)
        val marker: i64 = src.find("fn ed_scalar_mul(")
        expect(marker >= 0).to_be(true)

    it "ed_scalar_mul has no data-dependent branch on the scalar":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: ed_scalar_mul has no data-dependent branch on the scalar")
        val src = rt_file_read_text(SRC_PATH)
        val body = _fn_body(src, "fn ed_scalar_mul(scalar: [u8], p: EdPoint) -> EdPoint:")
        expect(body.len() > 0u64).to_be(true)
        expect(_secret_branch_count(body)).to_equal(0u64)  # oracle: 0u64 — named expected value from the requirement

    it "ed_scalar_mul_basepoint has no data-dependent branch on the scalar":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: ed_scalar_mul_basepoint has no data-dependent branch on the scalar")
        # This is the entry point signing actually calls.
        val src = rt_file_read_text(SRC_PATH)
        val body = _fn_body(src, "fn ed_scalar_mul_basepoint(scalar: [u8]) -> EdPoint:")
        expect(body.len() > 0u64).to_be(true)
        expect(_secret_branch_count(body)).to_equal(0u64)  # oracle: 0u64 — named expected value from the requirement

    it "ed_scalar_mul_basepoint_simple has no data-dependent branch on the scalar":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: ed_scalar_mul_basepoint_simple has no data-dependent branch on the scalar")
        # The delegate that carried the actual side channel while the
        # documented constant-time function sat unused.
        val src = rt_file_read_text(SRC_PATH)
        val body = _fn_body(src, "fn ed_scalar_mul_basepoint_simple(scalar: [u8]) -> EdPoint:")
        expect(body.len() > 0u64).to_be(true)
        expect(_secret_branch_count(body)).to_equal(0u64)  # oracle: 0u64 — named expected value from the requirement

    it "the detector itself fires on a known-branchful body (anti-vacuity)":
        # @req: REQ-LIB-CRYPTO-001
        step("Verify: the detector itself fires on a known-branchful body (anti-vacuity)")
        # If this ever returns 0 the three checks above prove nothing.
        val fake = "\n    if _ed_scalar_bit(scalar, bit_idx) == 1:\n        result = base\n"
        expect(_secret_branch_count(fake)).to_equal(1u64)  # oracle: 1u64 — named expected value from the requirement
        val clean = "\n    result = ed_point_add(result, sel)\n"
        expect(_secret_branch_count(clean)).to_equal(0u64)  # oracle: 0u64 — named expected value from the requirement
