use std.spipe.*
use os.crypto.curve25519_smalllimb.{
    _load3,
    _load4,
    x25519_smalllimb_roundtrip_probe,
    x25519_smalllimb_mask_probe,
    x25519_smalllimb_clamp_probe
}

val U_TV1_PROBE: [u8] = [
    0xe6u8, 0xdbu8, 0x68u8, 0x67u8, 0x58u8, 0x30u8, 0x30u8, 0xdbu8,
    0x35u8, 0x94u8, 0xc1u8, 0xa4u8, 0x24u8, 0xb1u8, 0x5fu8, 0x7cu8,
    0x72u8, 0x66u8, 0x24u8, 0xecu8, 0x26u8, 0xb3u8, 0x35u8, 0x3bu8,
    0x10u8, 0xa9u8, 0x03u8, 0xa6u8, 0xd0u8, 0xabu8, 0x1cu8, 0x4cu8
]

describe "Curve25519 small-limb probes":
    it "loads unsigned little-endian bytes at nonzero offsets":
        val bytes: [u8] = [0xaau8, 0x01u8, 0x23u8, 0x45u8, 0x67u8, 0x89u8]
        expect(_load3(bytes, 1)).to_equal(0x452301u64)
        expect(_load4(bytes, 2)).to_equal(0x89674523u64)

    it "clamps scalar boundary bits and preserves interior bytes":
        val scalar: [u8] = [
            0xffu8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8,
            8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8,
            16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8,
            24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 0xbfu8
        ]
        val clamped = x25519_smalllimb_clamp_probe(scalar)
        expect(clamped.len()).to_equal(32)
        expect(clamped[0]).to_equal(0xf8u8)
        expect(clamped[31]).to_equal(0x7fu8)
        var i: i64 = 1
        while i < 31:
            expect(clamped[i]).to_equal(scalar[i])
            i = i + 1

    it "round-trips a masked arbitrary u-coordinate":
        expect(x25519_smalllimb_roundtrip_probe(U_TV1_PROBE)).to_equal(x25519_smalllimb_mask_probe(U_TV1_PROBE))
