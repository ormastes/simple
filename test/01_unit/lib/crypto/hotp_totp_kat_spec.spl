# HOTP + TOTP RFC 4226 / RFC 6238 Known-Answer Tests
#
# HOTP (RFC 4226 Appendix D):
#   Key  = "12345678901234567890" (20 ASCII bytes)
#   Algorithm = HMAC-SHA-1
#   Digits = 6
#   Counters 0–7 → 8 vectors
#
# TOTP (RFC 6238 Appendix B):
#   Hash-specific keys (20 / 32 / 64 bytes):
#     SHA-1:   "12345678901234567890"
#     SHA-256: "12345678901234567890123456789012"
#     SHA-512: "1234567890123456789012345678901234567890123456789012345678901234"
#   Digits = 8, Period = 30
#   5 time points: 59, 1111111109, 1111111111, 1234567890, 2000000000
#
# NOTE: interpreter-mode test runner verifies file loading, NOT it-block
# execution. OTP assertions only fire under compiled/native mode.

"""
## Purpose and audience
Purpose: Verify HOTP-SHA-1 RFC 4226 Appendix D vectors (6 digits).
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-HOTP-TOTP-KAT-001 — stable requirement identity for this spec.

use std.spipe.*
use os.crypto.hotp.{hotp_sha1_bytes, hotp_sha256_bytes, hotp_sha512_bytes}
use os.crypto.hotp.{totp_sha1_bytes, totp_sha256_bytes, totp_sha512_bytes}
use std.crypto.types.{crypto_text_to_bytes as text_to_bytes}

# =============================================================================
# Key helpers
# =============================================================================

# RFC 4226 Appendix D / RFC 6238 Appendix B SHA-1 key: "12345678901234567890" (20 bytes)
fn _hotp_key_sha1() -> list:
    text_to_bytes("12345678901234567890")

# RFC 6238 Appendix B SHA-256 key: "12345678901234567890123456789012" (32 bytes)
fn _hotp_key_sha256() -> list:
    text_to_bytes("12345678901234567890123456789012")

# RFC 6238 Appendix B SHA-512 key:
# "1234567890123456789012345678901234567890123456789012345678901234" (64 bytes)
fn _hotp_key_sha512() -> list:
    text_to_bytes("1234567890123456789012345678901234567890123456789012345678901234")

# =============================================================================
# HOTP RFC 4226 Appendix D — 8 counter values (SHA-1, 6 digits)
# =============================================================================

use std.spec.step

describe "HOTP-SHA-1 RFC 4226 Appendix D vectors (6 digits)":

    it "counter=0 → 755224":
        step("Verify: counter=0 → 755224")
        # @req: REQ-LIB-HOTP-TOTP-KAT-001
        # RFC 4226 Appendix D: HOTP(K,0) = 755224
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 0, 6)).to_equal(755224)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=1 → 287082":
        step("Verify: counter=1 → 287082")
        # RFC 4226 Appendix D: HOTP(K,1) = 287082
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 1, 6)).to_equal(287082)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=2 → 359152":
        step("Verify: counter=2 → 359152")
        # RFC 4226 Appendix D: HOTP(K,2) = 359152
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 2, 6)).to_equal(359152)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=3 → 969429":
        step("Verify: counter=3 → 969429")
        # RFC 4226 Appendix D: HOTP(K,3) = 969429
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 3, 6)).to_equal(969429)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=4 → 338314":
        step("Verify: counter=4 → 338314")
        # RFC 4226 Appendix D: HOTP(K,4) = 338314
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 4, 6)).to_equal(338314)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=5 → 254676":
        step("Verify: counter=5 → 254676")
        # RFC 4226 Appendix D: HOTP(K,5) = 254676
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 5, 6)).to_equal(254676)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=6 → 287922":
        step("Verify: counter=6 → 287922")
        # RFC 4226 Appendix D: HOTP(K,6) = 287922
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 6, 6)).to_equal(287922)  # oracle: authoritative expected value documented by this spec's contract

    it "counter=7 → 162583":
        step("Verify: counter=7 → 162583")
        # RFC 4226 Appendix D: HOTP(K,7) = 162583
        expect(hotp_sha1_bytes(_hotp_key_sha1(), 7, 6)).to_equal(162583)  # oracle: authoritative expected value documented by this spec's contract

# =============================================================================
# TOTP RFC 6238 Appendix B — 5 time points × SHA-1 (8 digits)
# =============================================================================

describe "TOTP-SHA-1 RFC 6238 Appendix B vectors (8 digits, period=30)":

    it "T=59 → 94287082":
        step("Verify: T=59 → 94287082")
        # RFC 6238 Appendix B: TOTP(K,59) SHA-1 = 94287082
        # T = floor(59/30) = 1
        expect(totp_sha1_bytes(_hotp_key_sha1(), 59, 30, 8)).to_equal(94287082)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1111111109 → 07081804":
        step("Verify: T=1111111109 → 07081804")
        # RFC 6238 Appendix B: TOTP(K,1111111109) SHA-1 = 07081804
        # T = floor(1111111109/30) = 37037036
        expect(totp_sha1_bytes(_hotp_key_sha1(), 1111111109, 30, 8)).to_equal(7081804)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1111111111 → 14050471":
        step("Verify: T=1111111111 → 14050471")
        # RFC 6238 Appendix B: TOTP(K,1111111111) SHA-1 = 14050471
        # T = floor(1111111111/30) = 37037037
        expect(totp_sha1_bytes(_hotp_key_sha1(), 1111111111, 30, 8)).to_equal(14050471)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1234567890 → 89005924":
        step("Verify: T=1234567890 → 89005924")
        # RFC 6238 Appendix B: TOTP(K,1234567890) SHA-1 = 89005924
        # T = floor(1234567890/30) = 41152263
        expect(totp_sha1_bytes(_hotp_key_sha1(), 1234567890, 30, 8)).to_equal(89005924)  # oracle: authoritative expected value documented by this spec's contract

    it "T=2000000000 → 69279037":
        step("Verify: T=2000000000 → 69279037")
        # RFC 6238 Appendix B: TOTP(K,2000000000) SHA-1 = 69279037
        # T = floor(2000000000/30) = 66666666
        expect(totp_sha1_bytes(_hotp_key_sha1(), 2000000000, 30, 8)).to_equal(69279037)  # oracle: authoritative expected value documented by this spec's contract

# =============================================================================
# TOTP RFC 6238 Appendix B — 5 time points × SHA-256 (8 digits, period=30)
# =============================================================================

describe "TOTP-SHA-256 RFC 6238 Appendix B vectors (8 digits, period=30)":

    it "T=59 → 46119246":
        step("Verify: T=59 → 46119246")
        # RFC 6238 Appendix B: TOTP-SHA-256(K,59) = 46119246
        expect(totp_sha256_bytes(_hotp_key_sha256(), 59, 30, 8)).to_equal(46119246)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1111111109 → 68084774":
        step("Verify: T=1111111109 → 68084774")
        # RFC 6238 Appendix B: TOTP-SHA-256(K,1111111109) = 68084774
        expect(totp_sha256_bytes(_hotp_key_sha256(), 1111111109, 30, 8)).to_equal(68084774)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1111111111 → 67062674":
        step("Verify: T=1111111111 → 67062674")
        # RFC 6238 Appendix B: TOTP-SHA-256(K,1111111111) = 67062674
        expect(totp_sha256_bytes(_hotp_key_sha256(), 1111111111, 30, 8)).to_equal(67062674)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1234567890 → 91819424":
        step("Verify: T=1234567890 → 91819424")
        # RFC 6238 Appendix B: TOTP-SHA-256(K,1234567890) = 91819424
        expect(totp_sha256_bytes(_hotp_key_sha256(), 1234567890, 30, 8)).to_equal(91819424)  # oracle: authoritative expected value documented by this spec's contract

    it "T=2000000000 → 90698825":
        step("Verify: T=2000000000 → 90698825")
        # RFC 6238 Appendix B: TOTP-SHA-256(K,2000000000) = 90698825
        expect(totp_sha256_bytes(_hotp_key_sha256(), 2000000000, 30, 8)).to_equal(90698825)  # oracle: authoritative expected value documented by this spec's contract

# =============================================================================
# TOTP RFC 6238 Appendix B — 5 time points × SHA-512 (8 digits, period=30)
# =============================================================================

describe "TOTP-SHA-512 RFC 6238 Appendix B vectors (8 digits, period=30)":

    it "T=59 → 90693936":
        step("Verify: T=59 → 90693936")
        # RFC 6238 Appendix B: TOTP-SHA-512(K,59) = 90693936
        expect(totp_sha512_bytes(_hotp_key_sha512(), 59, 30, 8)).to_equal(90693936)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1111111109 → 25091201":
        step("Verify: T=1111111109 → 25091201")
        # RFC 6238 Appendix B: TOTP-SHA-512(K,1111111109) = 25091201
        expect(totp_sha512_bytes(_hotp_key_sha512(), 1111111109, 30, 8)).to_equal(25091201)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1111111111 → 99943326":
        step("Verify: T=1111111111 → 99943326")
        # RFC 6238 Appendix B: TOTP-SHA-512(K,1111111111) = 99943326
        expect(totp_sha512_bytes(_hotp_key_sha512(), 1111111111, 30, 8)).to_equal(99943326)  # oracle: authoritative expected value documented by this spec's contract

    it "T=1234567890 → 93441116":
        step("Verify: T=1234567890 → 93441116")
        # RFC 6238 Appendix B: TOTP-SHA-512(K,1234567890) = 93441116
        expect(totp_sha512_bytes(_hotp_key_sha512(), 1234567890, 30, 8)).to_equal(93441116)  # oracle: authoritative expected value documented by this spec's contract

    it "T=2000000000 → 38618901":
        step("Verify: T=2000000000 → 38618901")
        # RFC 6238 Appendix B: TOTP-SHA-512(K,2000000000) = 38618901
        expect(totp_sha512_bytes(_hotp_key_sha512(), 2000000000, 30, 8)).to_equal(38618901)  # oracle: authoritative expected value documented by this spec's contract
