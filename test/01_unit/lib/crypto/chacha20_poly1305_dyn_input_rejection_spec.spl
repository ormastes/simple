# AUTHORED_UNRUN: actual dyn ABI rejection tests, no substitute provider.
# Existing byte-slice ABI requires -1 for invalid arguments, before output.
use std.spec.step
use std.spipe.*
use std.common.crypto.chacha20_poly1305_dyn_abi.{simple_dyn_chacha20_poly1305_encrypt_v1}
use std.nogc_sync_mut.sffi.dyn_bytes_abi.{dyn_bytes_abi_pack_lens, DYN_BYTES_ABI_ERR_ARGS}

describe "ChaCha20-Poly1305 dynamic ABI argument rejection":
    it "rejects an empty frame before dereferencing output":
        step("Call the actual component entry with an empty frame and null output")
        val lens = dyn_bytes_abi_pack_lens(0, 16)
        expect(simple_dyn_chacha20_poly1305_encrypt_v1(0, 0, lens)).to_equal(DYN_BYTES_ABI_ERR_ARGS)

    it "rejects a null nonempty input before dereferencing output":
        step("Call the actual component entry with a null 48-byte input")
        val lens = dyn_bytes_abi_pack_lens(48, 16)
        expect(simple_dyn_chacha20_poly1305_encrypt_v1(0, 0, lens)).to_equal(DYN_BYTES_ABI_ERR_ARGS)
