# Runs test/fixtures/devhub/native_os_crypto_kat/main.spl (PR #6862 follow-up)
# as a child process and asserts every NIST SP 800-38D / RFC 7748 known-answer
# check passes. Bug: doc/08_tracking/bug/os_crypto_native_failures_2026_10_31.md
#
# @cover test/fixtures/devhub/native_os_crypto_kat/main.spl
use std.spec.{describe, it, expect}
use std.env.{env_get}
use std.io_runtime.{host_os, getpid}
use std.io.process_ops.{process_run_bounded}
use std.process.run

val FIXTURE = "test/fixtures/devhub/native_os_crypto_kat/main.spl"

fn _simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "":
        return configured
    if host_os() == "windows":
        val (out, _e, code) = process_run_bounded("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", "(Get-Process -Id {getpid()}).Path"], 20000, 65536)
        if code == 0:
            return out.trim()
        return ""
    val (ps_out, _pe, ps_code) = process_run_bounded("ps", ["-o", "comm=", "-p", "{getpid()}"], 2000, 65536)
    if ps_code == 0: ps_out.trim() else: ""

describe "os.crypto known-answer fixture":
    it "passes every AES-GCM and X25519 vector with zero failures":
        val bin = _simple_binary()
        expect(bin != "").to_equal(true)
        val result = run(bin, ["run", FIXTURE])
        expect(result.stdout).to_contain("PASS aes128gcm")
        expect(result.stdout).to_contain("PASS x25519 tv1")
        expect(result.stdout).to_contain("PASS x25519 ecdh shared")
        expect(result.stdout).to_contain("KAT FAILURES 0")
        expect(result.stdout.contains("FAIL ")).to_equal(false)
        expect(result.exit_code).to_equal(0)
