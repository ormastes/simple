# @cover src/lib/common/aes/utilities.spl
use std.spec.*
use std.spec.step
use std.common.aes.utilities.{aes_text_to_bytes, aes_bytes_to_text}

describe "AES plaintext UTF-8 conversion":
    it "should encode non-ASCII plaintext as UTF-8 octets":
        step("Convert an accented letter and a multibyte symbol into AES input bytes")
        expect(aes_text_to_bytes("é✓")).to_equal([195, 169, 226, 156, 147])

    it "should decode a UTF-8 octet sequence into its original plaintext":
        step("Decode the UTF-8 bytes used by stored credential plaintext")
        val encoded: [i64] = [195, 169, 226, 156, 147]
        expect(aes_bytes_to_text(encoded)).to_equal("é✓")

    it "should preserve a complete synthetic non-ASCII credential":
        step("Round-trip the text conversion at the credential cipher boundary")
        val original = "synthetic-mail-héllo-✓"
        val encoded = aes_text_to_bytes(original)
        expect(aes_bytes_to_text(encoded)).to_equal(original)

    it "should reject malformed decrypted UTF-8 rather than change its characters":
        step("Decode a truncated or invalid multibyte sequence")
        expect(aes_bytes_to_text([195, 40])).to_equal("")
        expect(aes_bytes_to_text([226, 156])).to_equal("")

    it "should reject integers outside the octet range":
        step("Reject invalid byte carriers before narrowing their integers")
        expect(aes_bytes_to_text([-1])).to_equal("")
        expect(aes_bytes_to_text([256])).to_equal("")
