# PBKDF2-HMAC-SHA-1 known-answer tests from RFC 6070 section 2.
# @req REQ-SSPEC-LIB
# @manual_section: crypto-pbkdf2-sha1-kat

"""
## Purpose and audience
Purpose: a password-derived key must equal the value every other PBKDF2-HMAC-SHA-1
implementation derives, so data protected elsewhere (SCRAM-SHA-1, older key stores)
opens here. Expected values are the published RFC 6070 vectors, not values computed
by this library.
Audience: crypto reviewers and anyone changing `std.common.crypto.pbkdf2`.

## Not covered
RFC 6070 vector 4 (16,777,216 iterations) is omitted everywhere. Vectors 3, 5 and 6
(4096 iterations each) take minutes per vector on the interpreter and timed the runner
out at 900 s, so they are asserted on the compiled engine instead, in
`sha1_compiled_engine_kat_fixture_spec.spl`.
"""

use std.spec.*
use std.spec.step
use std.common.crypto.pbkdf2.{pbkdf2_sha1_bytes}
use std.common.crypto.types.{bytes_to_hex}
use std.common.text_bytes.{text_to_utf8_bytes}

fn ascii(value: text) -> [i64]:
    var out: [i64] = []
    for b in text_to_utf8_bytes(value):
        out.push(b.to_i64())
    out

describe "PBKDF2-HMAC-SHA-1 derives the RFC 6070 keys":
    it "derives the published 20-byte key after one iteration":
        step("Derive from password 'password', salt 'salt', c=1, dkLen=20")
        val key = pbkdf2_sha1_bytes(ascii("password"), ascii("salt"), 1, 20)
        step("Compare with RFC 6070 test vector 1")
        expect(key.len()).to_equal(20)
        expect(bytes_to_hex(key)).to_equal("0c60c80f961f0e71f3a9b524af6012062fe037a6")

    it "feeds the first block back in on the second iteration":
        step("Derive with c=2, dkLen=20")
        val key = pbkdf2_sha1_bytes(ascii("password"), ascii("salt"), 2, 20)
        step("Compare with RFC 6070 test vector 2")
        expect(bytes_to_hex(key)).to_equal("ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957")
