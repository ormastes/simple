"""
## Purpose and audience
Purpose: Test the `rt_black_box` RUNTIME ENTRY POINT directly, not the
`black_box` wrapper.
Audience: runtime and crypto engineers.

Why this file exists, when `black_box_spec.spl` already passes:

`std.crypto.constant_time.black_box` is
`rt_black_box(value) ?? value` (src/lib/common/crypto/constant_time.spl:22).
The `??` erases the extern's failure mode. If `rt_black_box` were replaced
by a stub returning nil, `?? value` would substitute the original argument
and **every assertion in `black_box_spec.spl` would still pass** — the
existing spec cannot detect that the runtime entry point is broken, only
that the wrapper's fallback works.

`rt_black_box` is a **security-relevant** symbol: it is the optimization
barrier that keeps `ct_eq`'s XOR-accumulate compare, ML-KEM rejection
sampling and Curve25519 conditional swap from being rewritten into an
early-exit branch on `diff != 0`, which would reintroduce the data-dependent
timing those loops exist to remove. It is also **interpreter-only**: it is
registered at `interpreter_extern/mod.rs:680` and implemented at
`interpreter_extern/file_io.rs:899`, with **no** C definition in
`src/runtime/**` and **no** definition in the `simple-runtime` Rust crate.
See doc/08_tracking/test/rt_test_coverage_audit_2026-08-31.md.

This spec calls the extern directly so the nil is observable.

## Discrimination
- B0/B1/B2/B3 are DISCRIMINATING: a nil-returning stub, a constant stub, or
  a zeroing stub all fail, because the returned optional is unwrapped and
  compared against several distinct values.
- B4 is DISCRIMINATING for arity/argument-plumbing: the interpreter body is
  `args.first().cloned().unwrap_or(Value::Nil)`, so a stub that ignored its
  argument would answer the same value for every input; B4 asserts two
  different inputs give two different outputs.
- B5 is EXPLICITLY NOT DISCRIMINATING and is labelled so in place: optimizer
  *opacity* is a property of the generated code, not of any value this or
  any other spec can observe. It is asserted by construction (an external
  call is opaque to Cranelift) and is recorded here only so the claim is not
  silently assumed to be tested.
"""

# @req: REQ-RT-BLACK-BOX-001 — rt_black_box is a total identity on i64.

use std.spec

# Declared exactly as src/lib/common/crypto/constant_time.spl:7 declares it —
# an OPTIONAL return, which is what makes the nil observable here.
extern fn rt_black_box(value: i64) -> i64?

describe "rt_black_box (runtime entry point, called directly)":

    it "B0 returns a present value, not nil":
        step("Verify: rt_black_box(42) is not nil")
        # @req: REQ-RT-BLACK-BOX-001
        # DISCRIMINATING: a nil-returning stub fails here. The `black_box`
        # wrapper's `?? value` would have hidden exactly this.
        val got = rt_black_box(42)
        expect(got != nil).to_equal(true)

    it "B1 is the identity on a positive value":
        step("Verify: rt_black_box(42) == 42")
        # @req: REQ-RT-BLACK-BOX-001
        val got = rt_black_box(42) ?? -1
        expect(got).to_equal(42)

    it "B2 is the identity on zero":
        step("Verify: rt_black_box(0) == 0")
        # DISCRIMINATING against a stub returning nil: the sentinel -1 below
        # is distinguishable from the expected 0, so a nil answer fails.
        val got = rt_black_box(0) ?? -1
        expect(got).to_equal(0)

    it "B3 is the identity on a negative value":
        step("Verify: rt_black_box(-7) == -7")
        val got = rt_black_box(-7) ?? 999
        expect(got).to_equal(-7)

    it "B4 depends on its argument (not a constant)":
        step("Verify: two distinct inputs give two distinct outputs")
        # DISCRIMINATING against any stub that ignores its argument, which
        # B1..B3 individually would not catch if the stub happened to return
        # the value each of them expects.
        val a = rt_black_box(11) ?? 0
        val b = rt_black_box(22) ?? 0
        expect(a).to_equal(11)
        expect(b).to_equal(22)
        expect(a != b).to_equal(true)

    it "B5 preserves the ct_eq accumulator semantics end to end":
        step("Verify: an XOR-accumulate compare still answers correctly")
        # NOT DISCRIMINATING for optimizer opacity — see the header. This
        # asserts only that routing the accumulator through the extern does
        # not change the FUNCTIONAL answer, which is a necessary but not
        # sufficient condition for the barrier doing its job.
        var diff: i64 = 0
        val a = [1, 2, 3, 4]
        val b = [1, 2, 3, 5]
        var i: i64 = 0
        while i < 4:
            diff = diff | (a[i] ^ b[i])
            i = i + 1
        val guarded = rt_black_box(diff) ?? -1
        expect(guarded).to_equal(1)
        expect(guarded == 0).to_equal(false)

    it "B6 NEGATIVE CONTROL: proves B0 discriminates where the wrapper does not":
        step("Verify: a nil-returning stub is invisible through ?? but visible directly")
        # This is the discrimination proof, executed rather than asserted in
        # prose. `stub` stands in for a broken rt_black_box. Routed through
        # the wrapper's `?? value` shape it is INDISTINGUISHABLE from a
        # working barrier (the first two expectations) — which is why
        # black_box_spec.spl cannot detect the failure. Called directly, as
        # B0 does, it is caught (the third expectation).
        val stubbed_through_wrapper = stub_black_box(42) ?? 42
        expect(stubbed_through_wrapper).to_equal(42)   # broken, yet passes
        expect(stub_black_box(0) ?? 0).to_equal(0)     # broken, yet passes
        expect(stub_black_box(42) != nil).to_equal(false)  # B0's shape catches it

# A deliberately broken stand-in for rt_black_box, used only by B6.
fn stub_black_box(value: i64) -> i64?:
    nil
