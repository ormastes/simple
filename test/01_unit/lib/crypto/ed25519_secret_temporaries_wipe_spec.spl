"""
## Purpose and audience
Pins the secret-temporary wipe contract of the std Ed25519 derive and sign path (src/lib/common/crypto/ed25519.spl):
the SHA-512 of the seed (`h`), the clamped scalar (`a`), the reduced scalar, the nonce preimage (`prefix || M`), the
nonce hash and the nonce scalar (`r`), and the SHA-512 workspace that hashed a secret preimage (widened input copy,
state words, block words and digest words) are volatile-wiped before the entry point returns. The caller's seed is
borrowed and never wiped. Bug: doc/08_tracking/bug/host_identity_ed25519_std_temporaries_unwiped_2026-11-19.md.
Written for owners of std crypto and of the orchestrator host identity keys.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable binary when written, 2026-11-20, milestone_0055).
## Compatibility and limitations
The seed is RFC 8032 section 7.1 test 1: published, deliberately public fixture material. Outputs must stay
byte-identical to RFC 8032 (also pinned by ed25519_rfc8032_spec.spl). The run records expose only a count of verified
wipes, never buffer contents. Not wiped (recorded in the bug doc): integer locals and limb arrays inside field, scalar
and point arithmetic, and the round locals of SHA-512 compression.
## Verification guidance and troubleshooting
`wiped` for derive is 7: four SHA-512 workspace buffers for H(seed), then `h`, `a` and the reduced scalar. For sign it
is 13: four for H(seed), four for H(prefix || M), then `h`, `a`, the nonce preimage, the nonce hash and `r`.
A count proves each wipe ran and read back zero; it cannot prove the wipe hit the ONLY copy (a wipe of a fork also
reads back zero). Sole-holder shape is pinned by the source needles of EDWIPE-05 (field moved out and emptied, buffers
pre-sized so no growth copy is freed unzeroed).
The public hash H(R || A || M) and verify are unchanged and wipe nothing.
"""
use std.spec.{step}
use std.io.file_read_text
use std.common.crypto.ed25519.{ed25519_pubkey, pure_ed25519_keypair_from_seed, pure_ed25519_sign, pure_ed25519_verify,
    pure_ed25519_sign_from_seed_v1, _ed25519_pubkey_run, _pure_ed25519_sign_run, _pure_ed25519_sha512_secret,
    _pure_ed25519_sha512_u8}

fn ew_seed() -> [u8]:
    [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

fn ew_public() -> [u8]:
    [215, 90, 152, 1, 130, 177, 10, 183, 213, 75, 254, 211, 201, 100, 7, 58, 14, 225, 114, 243, 218, 166, 35, 37, 175, 2, 26, 104, 247, 7, 81, 26]

fn ew_signature() -> [u8]:
    [229, 86, 67, 0, 195, 96, 172, 114, 144, 134, 226, 204, 128, 110, 130, 138, 132, 135, 127, 30, 184, 229, 217, 116,
        216, 115, 224, 101, 34, 73, 1, 85, 95, 184, 130, 21, 144, 163, 59, 172, 198, 30, 57, 112, 28, 249, 180, 107,
        210, 91, 245, 240, 89, 91, 190, 36, 101, 81, 65, 67, 142, 122, 16, 11]

fn ew_long_input() -> [u8]:
    var out: [u8] = []
    for index in 0..200: out.push((index % 251) as u8)
    out

fn ew_count(source: text, needle: text) -> i64:
    source.split(needle).len() - 1

fn ew_body(source: text, start: text, end: text) -> text:
    val tail = source.substring(source.index_of(start), source.byte_len())
    tail.substring(0, tail.index_of(end))

describe "Ed25519 derive and sign wipe their secret temporaries":
    it "derives the RFC 8032 public key and wipes h, a, the reduced scalar and the H(seed) workspace":
        # @req EDWIPE-01
        val run = _ed25519_pubkey_run(ew_seed())
        expect(run.output).to_equal(ew_public())
        expect(run.wiped).to_equal(7)
        expect(ed25519_pubkey(ew_seed())).to_equal(ew_public())
        expect(pure_ed25519_keypair_from_seed(ew_seed()).1).to_equal(ew_public())

    it "signs the RFC 8032 test 1 message byte-identically and wipes the nonce material":
        # @req EDWIPE-02
        val run = _pure_ed25519_sign_run(ew_seed(), ew_public(), [])
        expect(run.output).to_equal(ew_signature())
        expect(run.wiped).to_equal(13)
        expect(pure_ed25519_sign(ew_seed(), ew_public(), [])).to_equal(ew_signature())
        expect(pure_ed25519_verify(ew_public(), [], ew_signature())).to_equal(true)
        val both = pure_ed25519_sign_from_seed_v1(ew_seed(), [])
        expect(both.public_key).to_equal(ew_public())
        expect(both.signature).to_equal(ew_signature())

    it "never wipes the caller's borrowed seed":
        # @req EDWIPE-03
        var seed = ew_seed()
        val public_key = ed25519_pubkey(seed)
        expect(seed).to_equal(ew_seed())
        val signature = pure_ed25519_sign(seed, public_key, [1, 2, 3])
        expect(seed).to_equal(ew_seed())
        expect(pure_ed25519_verify(public_key, [1, 2, 3], signature)).to_equal(true)

    it "hashes a secret preimage to the same digest as the public bridge and wipes its workspace":
        # @req EDWIPE-04
        val short = _pure_ed25519_sha512_secret(ew_seed())
        expect(short.output).to_equal(_pure_ed25519_sha512_u8(ew_seed()))
        expect(short.wiped).to_equal(4)
        step("a multi-block preimage takes the full-block absorb path")
        val long = _pure_ed25519_sha512_secret(ew_long_input())
        expect(long.output).to_equal(_pure_ed25519_sha512_u8(ew_long_input()))
        expect(long.wiped).to_equal(4)
        step("an empty preimage has no input copy to wipe")
        val empty = _pure_ed25519_sha512_secret([])
        expect(empty.output).to_equal(_pure_ed25519_sha512_u8([]))
        expect(empty.wiped).to_equal(3)

    it "routes only secret preimages through the wiping hash and leaves verify and H(R || A || M) unchanged":
        # @req EDWIPE-05
        val source = file_read_text("src/lib/common/crypto/ed25519.spl")
        expect(ew_count(source, "_pure_ed25519_sha512_u8(seed)")).to_equal(0)
        expect(ew_count(source, "_pure_ed25519_sha512_u8(private_seed)")).to_equal(0)
        expect(ew_count(source, "_pure_ed25519_sha512_secret(seed)")).to_equal(1)
        expect(ew_count(source, "_pure_ed25519_sha512_secret(private_seed)")).to_equal(1)
        expect(ew_count(source, "_pure_ed25519_sha512_secret(prefix_msg)")).to_equal(1)
        expect(ew_count(source, "_pure_ed25519_sha512_modl(k_input)")).to_equal(2)
        step("the reducer wipes its widened copy of the clamped scalar")
        val reducer = ew_body(source, "fn _pure_ed25519_reduce_32_to_scalar(", "# ====")
        expect(ew_count(reducer, "_ed25519_wipe_u8(wide)")).to_equal(1)
        step("the secret scalar buffers are pre-sized, so no growth reallocation frees a partial copy")
        val clamp = ew_body(source, "fn _pure_ed25519_clamp(", "fn _pure_ed25519_reduce_32_to_scalar(")
        expect(ew_count(clamp, "var clamped: [u8] = [0u8; 32]")).to_equal(1)
        expect(ew_count(clamp, ".push(")).to_equal(0)
        val scalar = file_read_text("src/lib/common/crypto/ed25519_scalar.spl")
        val to_bytes = ew_body(scalar, "fn _limbs32_to_bytes(", "fn _sc_sub_L(")
        expect(ew_count(to_bytes, "var result: [u8] = [0u8; byte_count]")).to_equal(1)
        expect(ew_count(to_bytes, ".push(")).to_equal(0)
        step("a digest is moved out of its run record and the field emptied before the local is wiped")
        expect(ew_count(source, "var h = digest.output\n    digest.output = []")).to_equal(2)
        expect(ew_count(source, "var r_hash = nonce_digest.output\n    nonce_digest.output = []")).to_equal(1)
        expect(ew_count(source, "secure_zero_u8_slots(digest.output)")).to_equal(0)
        step("verify keeps the public bridge and gains no wipe")
        val verify = ew_body(source, "fn pure_ed25519_verify(", "fn pure_ed25519_self_test(")
        expect(ew_count(verify, "secure_zero")).to_equal(0)
        expect(ew_count(verify, "_pure_ed25519_sha512_secret(")).to_equal(0)
