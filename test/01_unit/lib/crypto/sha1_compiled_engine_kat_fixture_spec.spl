# Runs test/fixtures/devhub/native_sha1_kat/main.spl as a program and asserts every
# published SHA-1 / HMAC-SHA-1 / PBKDF2-HMAC-SHA-1 vector passes on the compiled engine.
# Bug: doc/08_tracking/bug/jit_corrupts_i64_array_returned_from_sha1_bytes_2026-08-04.md
# @req REQ-SSPEC-LIB
# @cover test/fixtures/devhub/native_sha1_kat/main.spl
# @manual_section: crypto-sha1-compiled-engine

"""
## Purpose and audience
Purpose: a program that hashes with SHA-1 must get the same digest as the spec runner
does. The spec runner interprets; ordinary programs are compiled (`simple run` uses the
JIT, shipped tools are native). SHA-1 used to return tagged words instead of bytes on
the compiled engines while every interpreted spec stayed green.
Audience: crypto reviewers; anyone touching `std.common.crypto.sha1`.

## How to run it against a native binary
Build the fixture with `native-build` and set `SHA1_KAT_NATIVE_BIN` to the executable.
Without it the fixture runs through `<this binary> run`.
"""

use std.spec.{describe, it, expect}
use std.spec.step
use std.env.{env_get}
use std.io_runtime.{host_os, getpid, process_run}
use std.io.process_ops.{process_run_bounded}

val FIXTURE = "test/fixtures/devhub/native_sha1_kat/main.spl"

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "":
        return configured
    if host_os() == "windows":
        val (out, _e, code) = process_run_bounded("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", "(Get-Process -Id {getpid()}).Path"], 20000, 65536)
        if code == 0:
            return out.trim()
        return ""
    val (ps_out, _pe, ps_code) = process_run_bounded("ps", ["-o", "comm=", "-p", "{getpid()}"], 2000, 65536)
    if ps_code == 0: ps_out.trim() else: ""

fn run_fixture() -> (text, text, i64):
    val native_bin = env_get("SHA1_KAT_NATIVE_BIN")
    if native_bin != "":
        return process_run(native_bin, [])
    process_run(simple_binary(), ["run", FIXTURE])

val kat = run_fixture()

describe "SHA-1 family known answers as a compiled program":
    it "hashes the FIPS 180-4 messages to the published digests":
        step("Run the fixture program and read its SHA-1 lines")
        expect(kat.0).to_contain("PASS sha1 abc")
        expect(kat.0).to_contain("PASS sha1 448-bit")

    it "tags and derives keys to the RFC 2202 and RFC 6070 values":
        step("Read the HMAC-SHA-1 and PBKDF2-HMAC-SHA-1 lines")
        expect(kat.0).to_contain("PASS hmac-sha1 rfc2202-2")
        expect(kat.0).to_contain("PASS pbkdf2-sha1 rfc6070-1")
        expect(kat.0).to_contain("PASS pbkdf2-sha1 rfc6070-2")

    it "derives the 4096-iteration, multi-block and embedded-NUL RFC 6070 keys":
        step("Read the lines for RFC 6070 vectors 3, 5 and 6")
        expect(kat.0).to_contain("PASS pbkdf2-sha1 rfc6070-3")
        expect(kat.0).to_contain("PASS pbkdf2-sha1 rfc6070-5")
        expect(kat.0).to_contain("PASS pbkdf2-sha1 rfc6070-6")

    it "reports zero failures and exits successfully":
        step("Read the summary line and the exit code")
        expect(kat.0).to_contain("KAT FAILURES 0")
        expect(kat.0.contains("FAIL ")).to_equal(false)
        expect(kat.2).to_equal(0)
