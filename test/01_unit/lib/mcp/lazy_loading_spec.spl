# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# MCP lazy registry v2 behavior, exercised directly: the registry
# starts empty, metadata makes categories resolvable, and loaders flip
# per-category loaded state. (Rewritten from the removed `mcp_lib` API.)

use std.spec.step
use std.nogc_async_mut.mcp.lazy_registry_v2.{
    init_registry,
    register_handler_metadata,
    get_tool_category,
    is_category_loaded,
    get_registry_stats
}
use std.nogc_async_mut.mcp.category_loaders_v2.{
    load_edit_category,
    is_edit_loaded
}

describe "MCP lazy registry v2 - unit mirror":
    # @manual scenario evidence
    it "starts with an empty registry after init":
        # @req REQ-SSPEC-UNIT
        step("re-init and read stats")
        init_registry()
        expect(get_registry_stats().contains("handlers")).to_equal(true)

    it "answers unknown for tools never registered":
        # @req REQ-SSPEC-UNIT
        step("look up an unregistered tool")
        init_registry()
        expect(get_tool_category("never_registered")).to_equal("unknown")

    it "loads the edit category explicitly and observes its flag":
        # @req REQ-SSPEC-UNIT
        step("call the edit loader, check its loaded flag")
        init_registry()
        load_edit_category()
        expect(is_edit_loaded()).to_equal(true)
        expect(is_category_loaded("edit")).to_equal(true)

    it "resolves a registered tool to its declared category":
        # @req REQ-SSPEC-UNIT
        step("register metadata then query it")
        init_registry()
        register_handler_metadata("my_tool", "my_category")
        expect(get_tool_category("my_tool")).to_equal("my_category")
