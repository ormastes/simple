# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# MCP lazy registry v2 behavior, exercised directly: the registry
# starts empty, metadata makes categories resolvable, and loaders flip
# per-category loaded state. (Rewritten from the removed `mcp_lib` API.)

use std.spec.step
use std.nogc_async_mut.mcp.lazy_registry_v2.{
    init_registry,
    register_handler_metadata,
    get_tool_category,
    is_category_loaded,
    get_registry_stats
}
use std.nogc_async_mut.mcp.category_loaders_v2.{
    load_edit_category,
    is_edit_loaded
}

describe "MCP lazy registry v2 - unit mirror":
    # @manual scenario evidence
    it "starts with an empty registry after init":
        # @req REQ-SSPEC-UNIT
        step("re-init and read stats")
        init_registry()
        expect(get_registry_stats().contains("handlers")).to_equal(true)

    it "answers unknown for tools never registered":
        # @req REQ-SSPEC-UNIT
        step("look up an unregistered tool")
        init_registry()
        expect(get_tool_category("never_registered")).to_equal("unknown")

    it "loads the edit category explicitly and observes its flag":
        # @req REQ-SSPEC-UNIT
        step("call the edit loader, check its loaded flag")
        init_registry()
        load_edit_category()
        expect(is_edit_loaded()).to_equal(true)
        expect(is_category_loaded("edit")).to_equal(true)

    it "resolves a registered tool to its declared category":
        # @req REQ-SSPEC-UNIT
        step("register metadata then query it")
        init_registry()
        register_handler_metadata("my_tool", "my_category")
        expect(get_tool_category("my_tool")).to_equal("my_category")

# --- Merged from the legacy mirror copy (unit:lib/mcp/lazy_loading_spec.spl), test dedup phase B: tests this copy lacked.

describe "MCP lazy loading registry v2 (merged from legacy copy)":
    it "registers handler metadata and resolves its category":
        # @req REQ-SSPEC-UNIT
        step("init, register, look up category")
        init_registry()
        register_handler_metadata("test_tool", "test_category")
        expect(get_tool_category("test_tool")).to_equal("test_category")

    it "tracks category load state and unknown tools":
        # @req REQ-SSPEC-UNIT
        step("mark a category loaded, probe unknown tool")
        init_registry()
        expect(is_category_loaded("test_category")).to_equal(false)
        mark_category_loaded("test_category")
        expect(is_category_loaded("test_category")).to_equal(true)
        expect(get_tool_category("nonexistent_tool")).to_equal("unknown")

    it "lazily loads the fileio category on demand":
        # @req REQ-SSPEC-UNIT
        step("load fileio and observe its loaded flag")
        init_registry()
        load_fileio_category()
        expect(is_fileio_loaded()).to_equal(true)
        expect(is_category_loaded("fileio")).to_equal(true)

    it "loads an arbitrary category by name and reports stats":
        # @req REQ-SSPEC-UNIT
        step("load edit by name, check stats format")
        init_registry()
        load_category("edit")
        expect(is_category_loaded("edit")).to_equal(true)
        val stats = get_registry_stats()
        expect(stats.contains("handlers")).to_equal(true)
