# text_to_bytes_method_missing_on_text_receiver_2026-09-06
#
# `text.to_bytes()` must resolve on a text receiver and return the UTF-8
# bytes of the string. Interpreter lane: supported natively. JIT lane fixed
# in src/compiler_rust/compiler/src/codegen/instr/calls.rs ("bytes" |
# "to_bytes" => rt_string_bytes), matching the interpreter and LLVM lanes;
# pending seed rebuild to activate on `run`.

describe "text.to_bytes receiver method":
    it "returns ASCII bytes":
        val b = "ok".to_bytes()
        expect(b.len()).to_equal(2)
        expect(b[0]).to_equal(111)
        expect(b[1]).to_equal(107)

    it "returns multibyte UTF-8 bytes for non-ASCII text":
        val u = "hé".to_bytes()
        expect(u.len()).to_equal(3)
        expect(u[0]).to_equal(104)
        expect(u[1]).to_equal(195)
        expect(u[2]).to_equal(169)

    it "empty text yields an empty byte array":
        expect("".to_bytes().len()).to_equal(0)

    it "bytes roundtrip back to the original text":
        use std.common.text_bytes.{bytes_to_text}
        val original = "Simple héllo 日本"
        expect(bytes_to_text(original.to_bytes())).to_equal(original)
