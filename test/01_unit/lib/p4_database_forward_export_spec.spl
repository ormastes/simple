use std.spec.*
use std.database.core.{SdnDatabase, StringInterner}
use std.database.test_extended.database_queries.{db_test_info_lookup}

describe "Phase4 database facade lookup export":
    it "forwards the lookup function and preserves empty database semantics":
        val db = SdnDatabase.new("")
        val lookup = db_test_info_lookup(db, StringInterner.empty())
        expect(lookup.suite_file.len()).to_equal(0)
        expect(lookup.suite_name.len()).to_equal(0)
        expect(lookup.timing_mean.len()).to_equal(0)
        expect(lookup.timing_p50.len()).to_equal(0)
        expect(lookup.count_total.len()).to_equal(0)
        expect(lookup.count_passed.len()).to_equal(0)
        expect(lookup.count_failed.len()).to_equal(0)
