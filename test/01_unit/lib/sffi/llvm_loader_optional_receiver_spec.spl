# @req REQ-LLVM-LOADER-OPTIONAL-RECEIVER
# Requires the real LLVM provider selected by the normal loader configuration.
# Missing LLVM is a failure; this regression does not substitute a fake provider.
use std.spec.*
use std.nogc_sync_mut.sffi.llvm_loader.{llvm_available, llvm_lib}
use std.nogc_sync_mut.sffi.llvm_types.{llvm_context_create, llvm_context_dispose}

describe "LLVM loader optional receiver":
    it "returns the live DynLib payload and preserves its lifetime identity":
        expect(llvm_available()).to_be(true)
        val first = llvm_lib()
        expect(first.handle).to_be_greater_than(0)
        expect(first.lifetime_identity).to_be_greater_than(0u64)
        val again = llvm_lib()
        expect(again.handle).to_equal(first.handle)
        expect(again.lifetime_identity).to_equal(first.lifetime_identity)

        val symbol = unsafe(capabilities: [ffi, raw_ptr]):
            first.sym_checked("LLVMContextCreate")
        match symbol:
            case Ok(address): expect(address).to_be_greater_than(0)
            case Err(error): panic(error)

        val context = llvm_context_create()
        expect(context).to_be_greater_than(0)
        llvm_context_dispose(context)
