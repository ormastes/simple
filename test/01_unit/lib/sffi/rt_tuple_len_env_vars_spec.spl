"""
# rt_tuple_len is dispatchable from the interpreter

env_vars_nilable() validates each runtime env pair with rt_tuple_len. The
interpreter extern table lacked rt_tuple_len, so the default `simple test`
lane died with `unknown extern function: rt_tuple_len`.
"""

use std.spec.*
use std.nogc_sync_mut.sffi.system_env_core.{env_vars_nilable}

extern fn rt_env_set(key: text, value: text)

describe "rt_tuple_len via env_vars_nilable":
    it "returns the environment snapshot with a known pair":
        rt_env_set("SIMPLE_RT_TUPLE_LEN_PROBE", "probe-value")
        val vars = env_vars_nilable()
        var found = ""
        for pair in vars ?? []:
            if pair.0 == "SIMPLE_RT_TUPLE_LEN_PROBE":
                found = pair.1
        expect(found).to_equal("probe-value")

    # Native regression (2026-11-22): a raw runtime pair destructured as an
    # inline tuple yielded non-text key/value, so every owned Windows test
    # child got the assignment "=" and `--parallel` refused all admissions.
    # The interpreter was never affected; the native witness is a pin-built
    # probe of this same loop (see the bug record).
    it "destructures every pair into a KEY=VALUE assignment":
        rt_env_set("SIMPLE_RT_TUPLE_LEN_PROBE", "probe-value")
        var count = 0
        var malformed = 0
        var found = ""
        for (key, value) in env_vars_nilable() ?? []:
            val assignment = key + "=" + value
            if key == "" or assignment.len() < 2 or assignment.starts_with("="):
                malformed = malformed + 1
            if assignment.starts_with("SIMPLE_RT_TUPLE_LEN_PROBE="):
                found = assignment
            count = count + 1
        expect(count > 0).to_equal(true)
        expect(malformed).to_equal(0)
        expect(found).to_equal("SIMPLE_RT_TUPLE_LEN_PROBE=probe-value")
