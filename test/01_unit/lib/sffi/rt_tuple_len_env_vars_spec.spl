"""
# rt_tuple_len is dispatchable from the interpreter

env_vars_nilable() validates each runtime env pair with rt_tuple_len. The
interpreter extern table lacked rt_tuple_len, so the default `simple test`
lane died with `unknown extern function: rt_tuple_len`.
"""

use std.spec.*
use std.nogc_sync_mut.sffi.system_env_core.{env_vars_nilable}

extern fn rt_env_set(key: text, value: text)

describe "rt_tuple_len via env_vars_nilable":
    it "returns the environment snapshot with a known pair":
        rt_env_set("SIMPLE_RT_TUPLE_LEN_PROBE", "probe-value")
        val vars = env_vars_nilable()
        var found = ""
        for pair in vars ?? []:
            if pair.0 == "SIMPLE_RT_TUPLE_LEN_PROBE":
                found = pair.1
        expect(found).to_equal("probe-value")
