"""
Regression coverage for canonical/legacy log-level compatibility.

`std.log` owns the backend and uses TRACE=0..OFF=6.  The published
`std.nogc_sync_mut.log` compatibility API uses OFF=0..TRACE=6,
VERBOSE=7, and ALL=10.  Both surfaces must address the same filter and ring
state through explicit level translation at the legacy boundary without
collapsing the two extra legacy thresholds into TRACE.
"""

use std.spec
use std.log as canonical
use std.nogc_sync_mut.log as legacy

fn canonical_levels() -> [i64]:
    [
        canonical.LOG_TRACE,
        canonical.LOG_DEBUG,
        canonical.LOG_INFO,
        canonical.LOG_WARN,
        canonical.LOG_ERROR,
        canonical.LOG_FATAL,
        canonical.LOG_OFF
    ]

fn legacy_levels_for_same_severity() -> [i64]:
    [
        legacy.LOG_TRACE,
        legacy.LOG_DEBUG,
        legacy.LOG_INFO,
        legacy.LOG_WARN,
        legacy.LOG_ERROR,
        legacy.LOG_FATAL,
        legacy.LOG_OFF
    ]

fn all_legacy_levels() -> [i64]:
    [
        legacy.LOG_OFF,
        legacy.LOG_FATAL,
        legacy.LOG_ERROR,
        legacy.LOG_WARN,
        legacy.LOG_INFO,
        legacy.LOG_DEBUG,
        legacy.LOG_TRACE,
        legacy.LOG_VERBOSE,
        legacy.LOG_ALL
    ]

fn canonical_levels_for_all_legacy_levels() -> [i64]:
    [
        canonical.LOG_OFF,
        canonical.LOG_FATAL,
        canonical.LOG_ERROR,
        canonical.LOG_WARN,
        canonical.LOG_INFO,
        canonical.LOG_DEBUG,
        canonical.LOG_TRACE,
        canonical.LOG_TRACE,
        canonical.LOG_TRACE
    ]

describe "log level compatibility translation":
    it "round-trips every threshold through both public surfaces":
        val canonical_values = canonical_levels()
        val legacy_values = legacy_levels_for_same_severity()

        for i in 0..canonical_values.len():
            canonical.log_set_level(canonical_values[i])
            expect(legacy.get_global_level()).to_equal(legacy_values[i])

            legacy.set_level(legacy_values[i])
            expect(canonical.log_get_level()).to_equal(canonical_values[i])

        val all_legacy_values = all_legacy_levels()
        val all_canonical_values = canonical_levels_for_all_legacy_levels()
        for i in 0..all_legacy_values.len():
            legacy.set_level(all_legacy_values[i])
            expect(legacy.get_global_level()).to_equal(all_legacy_values[i])
            expect(canonical.log_get_level()).to_equal(all_canonical_values[i])

        # A canonical write invalidates the exact legacy receipt.  TRACE=0
        # translates back to legacy TRACE=6, never stale VERBOSE/ALL.
        legacy.set_level(legacy.LOG_ALL)
        canonical.log_set_level(canonical.LOG_TRACE)
        expect(legacy.get_global_level()).to_equal(legacy.LOG_TRACE)

    it "round-trips legacy scope thresholds 0..7 and 10 exactly":
        val legacy_values = all_legacy_levels()
        for i in 0..legacy_values.len():
            legacy.set_scope_level("test", legacy_values[i])
            expect(legacy.get_level("test")).to_equal(legacy_values[i])

        canonical.log_set_subsys_level(canonical.SUBSYS_TEST, canonical.LOG_TRACE)
        expect(legacy.get_level("test")).to_equal(legacy.LOG_TRACE)
        legacy.clear_scopes()

    it "preserves arbitrary string scope thresholds and global isolation":
        legacy.clear_scopes()
        legacy.set_level(legacy.LOG_WARN)
        legacy.set_scope_level("foo", legacy.LOG_VERBOSE)

        expect(legacy.get_level("foo")).to_equal(legacy.LOG_VERBOSE)
        expect(legacy.get_level("bar")).to_equal(legacy.LOG_WARN)
        expect(legacy.is_enabled(legacy.LOG_VERBOSE, "foo")).to_equal(true)
        expect(legacy.is_enabled(legacy.LOG_VERBOSE, "bar")).to_equal(false)

        legacy.set_scope_level("foo", legacy.LOG_ALL)
        expect(legacy.get_level("foo")).to_equal(legacy.LOG_ALL)
        expect(legacy.get_level("bar")).to_equal(legacy.LOG_WARN)

        val sink = canonical.ring_backend_new(8)
        val backend_id = canonical.log_register_backend(sink.ops)
        canonical.ring_backend_clear(sink)
        legacy.verbose("foo", "named arbitrary-scope verbose")
        legacy.log(legacy.LOG_ALL, "foo", "generic arbitrary-scope all")
        legacy.verbose("bar", "unrelated scope suppressed")
        expect(canonical.ring_backend_count(sink)).to_equal(2)
        expect(canonical.ring_backend_level_at(sink, 0)).to_equal(canonical.LOG_TRACE)
        expect(canonical.ring_backend_level_at(sink, 1)).to_equal(canonical.LOG_TRACE)
        canonical.log_remove_backend(backend_id)

    it "makes both filtering APIs agree at every threshold and severity":
        val canonical_values = canonical_levels()
        val legacy_values = legacy_levels_for_same_severity()
        legacy.clear_scopes()

        for threshold in 0..canonical_values.len():
            canonical.log_set_level(canonical_values[threshold])
            for severity in 0..6:
                expect(
                    legacy.legacy_compat_is_enabled(legacy_values[severity], "test")
                ).to_equal(
                    canonical.log_is_enabled(canonical_values[severity], "test")
                )

            expect(legacy.legacy_compat_is_enabled(legacy.LOG_OFF, "test")).to_equal(false)
            expect(canonical.log_is_enabled(canonical.LOG_OFF, "test")).to_equal(false)

    it "uses the complete legacy threshold scale including VERBOSE and ALL":
        val thresholds = all_legacy_levels()
        val emissions = all_legacy_levels()
        legacy.clear_scopes()

        for threshold_idx in 0..thresholds.len():
            val threshold = thresholds[threshold_idx]
            legacy.set_level(threshold)
            expect(legacy.get_global_level()).to_equal(threshold)
            for emission_idx in 0..emissions.len():
                val emission = emissions[emission_idx]
                val expected = emission != legacy.LOG_OFF and emission <= threshold
                expect(legacy.is_enabled(emission, "test")).to_equal(expected)

        legacy.set_level(legacy.LOG_TRACE)
        expect(legacy.is_enabled(legacy.LOG_TRACE, "test")).to_equal(true)
        expect(legacy.is_enabled(legacy.LOG_VERBOSE, "test")).to_equal(false)
        expect(legacy.is_enabled(legacy.LOG_ALL, "test")).to_equal(false)

    it "records every generic and named emission at canonical ring levels":
        val canonical_values = canonical_levels()
        val legacy_values = all_legacy_levels()
        val mapped_legacy_values = canonical_levels_for_all_legacy_levels()
        legacy.clear_scopes()
        legacy.set_level(legacy.LOG_ALL)

        val sink = canonical.ring_backend_new(64)
        val backend_id = canonical.log_register_backend(sink.ops)
        canonical.ring_backend_clear(sink)

        for severity in 0..canonical_values.len():
            canonical.log_dispatch_text(canonical_values[severity], canonical.SUBSYS_TEST, "canonical generic")

        # OFF is present in both loops and must never reach the ring.

        canonical.log_trace_subsys(canonical.SUBSYS_TEST, "canonical named trace")
        canonical.log_debug_subsys(canonical.SUBSYS_TEST, "canonical named debug")
        canonical.log_info_subsys(canonical.SUBSYS_TEST, "canonical named info")
        canonical.log_warn_subsys(canonical.SUBSYS_TEST, "canonical named warn")
        canonical.log_error_subsys(canonical.SUBSYS_TEST, "canonical named error")
        canonical.log_fatal(canonical.SUBSYS_TEST, "canonical named fatal")

        for severity in 0..legacy_values.len():
            legacy.legacy_compat_log(legacy_values[severity], "test", "legacy generic")

        legacy.legacy_compat_trace("test", "legacy named trace")
        legacy.legacy_compat_debug("test", "legacy named debug")
        legacy.legacy_compat_info("test", "legacy named info")
        legacy.legacy_compat_warn("test", "legacy named warn")
        legacy.legacy_compat_error("test", "legacy named error")
        legacy.legacy_compat_fatal("test", "legacy named fatal")
        legacy.legacy_compat_verbose("test", "legacy named verbose")

        expect(canonical.ring_backend_count(sink)).to_equal(27)
        for severity in 0..6:
            expect(
                canonical.ring_backend_level_at(sink, severity)
            ).to_equal(canonical_values[severity])
            expect(
                canonical.ring_backend_level_at(sink, 6 + severity)
            ).to_equal(canonical_values[severity])

        # The legacy generic OFF entry is suppressed.  FATAL..ALL occupy the
        # next eight records; VERBOSE and ALL intentionally use TRACE records.
        for severity in 1..legacy_values.len():
            expect(
                canonical.ring_backend_level_at(sink, 11 + severity)
            ).to_equal(mapped_legacy_values[severity])

        expect(canonical.ring_backend_level_at(sink, 20)).to_equal(canonical.LOG_TRACE)
        expect(canonical.ring_backend_level_at(sink, 21)).to_equal(canonical.LOG_DEBUG)
        expect(canonical.ring_backend_level_at(sink, 22)).to_equal(canonical.LOG_INFO)
        expect(canonical.ring_backend_level_at(sink, 23)).to_equal(canonical.LOG_WARN)
        expect(canonical.ring_backend_level_at(sink, 24)).to_equal(canonical.LOG_ERROR)
        expect(canonical.ring_backend_level_at(sink, 25)).to_equal(canonical.LOG_FATAL)
        expect(canonical.ring_backend_level_at(sink, 26)).to_equal(canonical.LOG_TRACE)

        canonical.log_remove_backend(backend_id)

    it "suppresses named and generic verbose at legacy TRACE threshold":
        legacy.clear_scopes()
        legacy.set_level(legacy.LOG_TRACE)

        val sink = canonical.ring_backend_new(16)
        val backend_id = canonical.log_register_backend(sink.ops)
        canonical.ring_backend_clear(sink)

        legacy.trace("test", "trace admitted")
        legacy.verbose("test", "named verbose suppressed")
        legacy.log(legacy.LOG_VERBOSE, "test", "generic verbose suppressed")
        legacy.log(legacy.LOG_ALL, "test", "generic all suppressed")
        expect(canonical.ring_backend_count(sink)).to_equal(1)
        expect(canonical.ring_backend_level_at(sink, 0)).to_equal(canonical.LOG_TRACE)

        canonical.log_remove_backend(backend_id)
