# Candidate executable SSpec; intended destination:
# test/01_unit/lib/hash_text_fnv1a_native_spec.spl
# Runtime evidence UNRUN until the operator admits a rebuilt producer.
use std.spec.*
use std.spec.step
use std.nogc_sync_mut.src.hash.{hash_text_fnv1a}
use std.hash.{rt_hash_text}

describe "pure Simple text hashing keeps bytewise FNV-1a semantics":
    it "preserves signed 64-bit known vectors including empty and overflow":
        step("hash the public function using known FNV-1a byte vectors")
        expect(hash_text_fnv1a("")).to_equal(-3750763034362895579)
        expect(hash_text_fnv1a("a")).to_equal(-5808556873153909620)
        expect(hash_text_fnv1a("hello")).to_equal(-6615550055289275125)
        expect(hash_text_fnv1a("foobar")).to_equal(-8821353812377114648)

    it "hashes embedded zero and UTF-8 octets without truncation":
        step("include zero and non-ASCII bytes in the text input")
        expect(hash_text_fnv1a("a\u{0}b")).to_equal(-1886276961191958862)
        expect(hash_text_fnv1a("é")).to_equal(775207407765167617)

    it "preserves the facade ABI alias":
        step("call the existing facade alias and compare exact values")
        expect(rt_hash_text("hello")).to_equal(-6615550055289275125)
        expect(rt_hash_text("é")).to_equal(hash_text_fnv1a("é"))
