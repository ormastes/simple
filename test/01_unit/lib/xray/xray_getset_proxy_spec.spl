# @cover src/lib/common/trace/trace_edge_select_v1.spl
# @req REQ-XRAY-V1-GETSET-01
"""
# XRay field get/set virtual proxy (V1) -- FAIL-FAST RED

Owner request 2026-11-16: XRay aspect work intercepts field/property get and
set through a virtual get/set proxy that exists ONLY when the XRay aspect is
enabled AND the class carries a get/set pointcut. Off = no proxy symbol, no
wrapper, no indirection, field access path identical to a no-aspect build.

Current state (verified 2026-11-16): the feature does not exist. XRay is
function-granular (entry/exit sleds, `simple.trace/observer-v1.pointcuts`
names functions, `.edges` selects function->function edges). There is no
field get/set pointcut kind, no proxy lowering in HIR/MIR/codegen, and no
xray edge kind for a field access. The rows below are fail-fast RED until it
is implemented; see
doc/08_tracking/bug/xray_field_getset_proxy_missing_2026-11-16.md.
"""
use std.spec.*
use std.common.trace.observer_contract_v1.*
use std.common.trace.trace_edge_select_v1.*

val NOT_IMPLEMENTED = "xray field get/set proxy is not implemented (bug xray_field_getset_proxy_missing_2026-11-16)"

fn is_err(r: Result<TraceEdgeSpecV1, TraceFailureV1>) -> bool:
    match r:
        case Ok(_): false
        case Err(_): true

describe "xray field get/set proxy":
    it "pins today's grammar: a field get/set selector is rejected (no proxy can be selected)":
        step("the only xray selector grammar rejects a field pointcut, fail closed")
        expect(is_err(trace_edge_spec_parse_v1("edge field get=Point.x"))).to_equal(true)
        expect(is_err(trace_edge_spec_parse_v1("edge field set=Point.x"))).to_equal(true)

    it "(a) xray on: get and set on an aspected class route through the proxy and record an xray edge":
        step("needs a get/set pointcut, proxy lowering and a field-access edge kind")
        expect(NOT_IMPLEMENTED).to_equal("")

    it "(b) xray off: lowered output has no proxy symbol and equals the no-aspect build":
        step("needs an observable proxy lowering to diff on vs off vs no-aspect")
        expect(NOT_IMPLEMENTED).to_equal("")

    it "(c) xray on, class without get/set pointcut: no proxy is created":
        step("needs pointcut-scoped proxy emission")
        expect(NOT_IMPLEMENTED).to_equal("")
