# @cover src/lib/nogc_sync_mut/trace/xray_container_v1.spl
# @req REQ-XRAY-V1-API-01
"""
# XRay aspect containers: profile / logging x static / dynamic x on / off / switch

`XrayContainerSwitchV1` routes edges into the active container. Static mode:
the program calls compiled-in hooks. Dynamic mode: edges come from
`XraySpyV1` over a fake compiler-rt leaf; Off unpatches every sled.

One script per run: main(1) -> work(2) -> exit -> work(2) -> exit -> exit,
clock +10 per edge, so main inclusive = 50, exclusive = 30; work 2 calls,
inclusive = exclusive = 20.
"""
use std.spec.*
use std.common.trace.observer_contract_v1.*
use std.common.trace.observer_profile_v1.*
use std.nogc_sync_mut.trace.xray_llvm_adapter_v1.*
use std.nogc_sync_mut.trace.observer_native_channel_v1.*
use std.nogc_sync_mut.trace.xray_spy_v1.*
use std.nogc_sync_mut.trace.xray_container_v1.*

val NAMES: [text] = ["main", "work"]
val SCRIPT_SITES: [i64] = [0, 1, 1, 1, 1, 0]
val SCRIPT_KINDS: [i64] = [0, 0, 1, 0, 1, 1]
val ONE_RUN_LOG: [text] = ["enter main", "enter work", "exit work", "enter work", "exit work", "exit main"]

class FakeLinuxLeaf:
    slots: [i64]
    arena: i64
    generation: u64
    context: u64
    module_instance: u64
    clock: u64

impl XrayLlvmLeafV1 for FakeLinuxLeaf:
    fn sled_kind() -> TraceBackendV1:
        TraceBackendV1.Llvm
    fn max_function_id() -> i64:
        self.slots.len()
    me install(arena: i64, generation: u64, context: u64, module_instance: u64) -> i64:
        self.arena = arena
        self.generation = generation
        self.context = context
        self.module_instance = module_instance
        1
    me patch_function(id: i64) -> i64:
        if id < 1 or id > self.slots.len(): return XRAY_LLVM_STATUS_INVALID_ID_V1
        self.slots[id - 1] = 1
        XRAY_LLVM_STATUS_SUCCESS_V1
    me unpatch_function(id: i64) -> i64:
        if id < 1 or id > self.slots.len(): return XRAY_LLVM_STATUS_INVALID_ID_V1
        self.slots[id - 1] = 0
        XRAY_LLVM_STATUS_SUCCESS_V1
    me close(arena: i64) -> i64:
        unsafe(capabilities: [ffi]): trace_native_channel_close_v1(arena)

impl FakeLinuxLeaf:
    me fire(site: i64, kind: i64):
        if self.slots[site] == 0: return
        self.clock = self.clock + 10u64
        val code: u64 = if kind == 0: 1u64 else: 2u64
        val id = (site + 1) as u64
        unsafe(capabilities: [ffi]):
            trace_native_channel_record_words_v1(self.arena, 1u64 | (96u64 << 16) | (code << 32),
                self.generation, self.module_instance, id | (id << 32), self.context,
                0u64, self.clock, 0u64, 0u64, 0u64, 0u64)

    fn patched() -> i64:
        var n = 0
        for s in self.slots:
            n = n + s
        n

fn config_v1() -> TraceConfigV1:
    TraceConfigV1(instrumentation: TraceInstrumentationV1.Dynamic,
        backend: TraceBackendV1.Llvm, consistency: TraceConsistencyV1.RawEdges,
        patch_mode: TracePatchModeV1.Quiescent, abi_profile: "linux-aarch64-llvm-xray",
        event_mask: 7, buffer_bytes: 98304, max_contexts: 1, max_depth: 128,
        max_resident_generations: 8)

fn selection_v1() -> TraceSelectionV1:
    TraceSelectionV1(manifest_incarnation: 1,
        sites: [TraceSiteV1(module_instance: 1, site_id: 1u32), TraceSiteV1(module_instance: 1, site_id: 2u32)])

# ---- static mode: the "compiled-in" program; returns its real result ----
fn work_static(sw: XrayContainerSwitchV1, clock: [u64], x: i64) -> i64:
    clock[0] = clock[0] + 10u64
    sw.hook_enter(2u32, clock[0])
    val r = x * 2
    clock[0] = clock[0] + 10u64
    sw.hook_exit(2u32, clock[0])
    r

fn main_static(sw: XrayContainerSwitchV1, clock: [u64]) -> i64:
    clock[0] = clock[0] + 10u64
    sw.hook_enter(1u32, clock[0])
    val r = work_static(sw, clock, 3) + work_static(sw, clock, 4)
    clock[0] = clock[0] + 10u64
    sw.hook_exit(1u32, clock[0])
    r

fn main_plain() -> i64:
    3 * 2 + 4 * 2

fn run_dynamic_script(leaf: FakeLinuxLeaf):
    for i in 0..6:
        leaf.fire(SCRIPT_SITES[i], SCRIPT_KINDS[i])

fn new_leaf() -> FakeLinuxLeaf:
    FakeLinuxLeaf(slots: [0, 0], arena: 0, generation: 0u64, context: 0u64, module_instance: 0u64, clock: 0u64)

fn shape(p: TraceProfileV1) -> text:
    var out = "events={p.events} unmatched={p.unmatched_exits} open={p.open_entries}"
    for row in p.functions:
        out = out + " f{row.function_id}:calls={row.calls}:inc={row.inclusive_ns}:exc={row.exclusive_ns}"
    out

val ONE_RUN_SHAPE = "events=6 unmatched=0 open=0 f1:calls=1:inc=50:exc=30 f2:calls=2:inc=20:exc=20"

fn sane(p: TraceProfileV1) -> bool:
    for row in p.functions:
        if row.exclusive_ns > row.inclusive_ns: return false
        if row.calls == 0u64: return false
    true

fn paired(lines: [text]) -> bool:
    var stack: [text] = []
    for line in lines:
        if line.starts_with("enter "): stack.push(line.substring(6))
        else:
            if stack.len() == 0: return false
            if stack[stack.len() - 1] != line.substring(5): return false
            stack.pop()
    stack.len() == 0

describe "XRay containers, static mode":
    it "profile on: counts and ns are exact and sane":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        sw.switch_to(XrayContainerKindV1.Profile)
        val clock: [u64] = [0u64]
        expect(main_static(sw, clock)).to_equal(main_plain())
        expect(shape(sw.profile())).to_equal(ONE_RUN_SHAPE)
        expect(sane(sw.profile())).to_equal(true)

    it "profile off: no events and the program result is identical":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        expect(sw.is_on()).to_equal(false)
        val clock: [u64] = [0u64]
        expect(main_static(sw, clock)).to_equal(main_plain())
        expect(sw.profile_events.len()).to_equal(0)
        expect(sw.log_lines().len()).to_equal(0)

    it "profile switched off mid-run keeps only the on segment":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        sw.switch_to(XrayContainerKindV1.Profile)
        val clock: [u64] = [0u64]
        main_static(sw, clock)
        sw.switch_to(XrayContainerKindV1.Off)
        main_static(sw, clock)
        expect(shape(sw.profile())).to_equal(ONE_RUN_SHAPE)

    it "profile accumulates monotonically over two on runs":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        sw.switch_to(XrayContainerKindV1.Profile)
        val clock: [u64] = [0u64]
        main_static(sw, clock)
        val first = sw.profile()
        main_static(sw, clock)
        val second = sw.profile()
        expect(second.functions[0].calls > first.functions[0].calls).to_equal(true)
        expect(second.functions[0].inclusive_ns >= first.functions[0].inclusive_ns).to_equal(true)
        expect(shape(second)).to_equal("events=12 unmatched=0 open=0 f1:calls=2:inc=100:exc=60 f2:calls=4:inc=40:exc=40")

    it "logging on: entry and exit paired":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        sw.switch_to(XrayContainerKindV1.Logging)
        val clock: [u64] = [0u64]
        main_static(sw, clock)
        expect(sw.log_lines()).to_equal(ONE_RUN_LOG)
        expect(paired(sw.log_lines())).to_equal(true)

    it "logging off: nothing logged":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        val clock: [u64] = [0u64]
        main_static(sw, clock)
        expect(sw.log_lines().len()).to_equal(0)

    it "logging switched on mid-call stays paired":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        val clock: [u64] = [0u64]
        sw.hook_enter(1u32, 10u64)
        sw.switch_to(XrayContainerKindV1.Logging)
        sw.hook_enter(2u32, 20u64)
        sw.hook_exit(2u32, 30u64)
        sw.hook_exit(1u32, 40u64)
        expect(sw.log_lines()).to_equal(["enter work", "exit work"])
        expect(sw.unpaired_exits).to_equal(1)
        expect(paired(sw.log_lines())).to_equal(true)

    it "swap profile -> logging mid-run splits the runs":
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Static, NAMES)
        sw.switch_to(XrayContainerKindV1.Profile)
        val clock: [u64] = [0u64]
        main_static(sw, clock)
        sw.switch_to(XrayContainerKindV1.Logging)
        main_static(sw, clock)
        expect(shape(sw.profile())).to_equal(ONE_RUN_SHAPE)
        expect(sw.log_lines()).to_equal(ONE_RUN_LOG)

describe "XRay containers, dynamic (spy) mode":
    it "profile on: same numbers as static":
        var leaf = new_leaf()
        var spy = XraySpyV1.create(XrayBackendV1.linux(leaf, NAMES), 1u64, 64)
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Dynamic, NAMES)
        expect(sw.apply(spy, XrayContainerKindV1.Profile, config_v1(), selection_v1()).is_ok()).to_equal(true)
        expect(leaf.patched()).to_equal(2)
        run_dynamic_script(leaf)
        sw.pump(spy)
        expect(shape(sw.profile())).to_equal(ONE_RUN_SHAPE)
        expect(sane(sw.profile())).to_equal(true)

    it "off: no sled patched and nothing recorded":
        var leaf = new_leaf()
        var spy = XraySpyV1.create(XrayBackendV1.linux(leaf, NAMES), 1u64, 64)
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Dynamic, NAMES)
        expect(sw.apply(spy, XrayContainerKindV1.Off, config_v1(), selection_v1()).is_ok()).to_equal(true)
        expect(leaf.patched()).to_equal(0)
        run_dynamic_script(leaf)
        expect(sw.pump(spy)).to_equal(0)
        expect(sw.profile_events.len()).to_equal(0)

    it "profile switched off mid-run unpatches and keeps the on segment":
        var leaf = new_leaf()
        var spy = XraySpyV1.create(XrayBackendV1.linux(leaf, NAMES), 1u64, 64)
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Dynamic, NAMES)
        sw.apply(spy, XrayContainerKindV1.Profile, config_v1(), selection_v1())
        run_dynamic_script(leaf)
        expect(sw.apply(spy, XrayContainerKindV1.Off, config_v1(), selection_v1()).is_ok()).to_equal(true)
        expect(leaf.patched()).to_equal(0)
        run_dynamic_script(leaf)
        sw.pump(spy)
        expect(shape(sw.profile())).to_equal(ONE_RUN_SHAPE)

    it "logging on: paired lines by spy site names":
        var leaf = new_leaf()
        var spy = XraySpyV1.create(XrayBackendV1.linux(leaf, NAMES), 1u64, 64)
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Dynamic, NAMES)
        sw.apply(spy, XrayContainerKindV1.Logging, config_v1(), selection_v1())
        run_dynamic_script(leaf)
        sw.pump(spy)
        expect(sw.log_lines()).to_equal(ONE_RUN_LOG)
        expect(paired(sw.log_lines())).to_equal(true)

    it "logging off: nothing logged":
        var leaf = new_leaf()
        var spy = XraySpyV1.create(XrayBackendV1.linux(leaf, NAMES), 1u64, 64)
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Dynamic, NAMES)
        run_dynamic_script(leaf)
        sw.pump(spy)
        expect(sw.log_lines().len()).to_equal(0)

    it "swap profile -> logging while patched, then off, then on again":
        var leaf = new_leaf()
        var spy = XraySpyV1.create(XrayBackendV1.linux(leaf, NAMES), 1u64, 64)
        var sw = XrayContainerSwitchV1.create(XrayContainerModeV1.Dynamic, NAMES)
        sw.apply(spy, XrayContainerKindV1.Profile, config_v1(), selection_v1())
        run_dynamic_script(leaf)
        sw.apply(spy, XrayContainerKindV1.Logging, config_v1(), selection_v1())
        expect(leaf.patched()).to_equal(2)
        run_dynamic_script(leaf)
        sw.apply(spy, XrayContainerKindV1.Off, config_v1(), selection_v1())
        run_dynamic_script(leaf)
        expect(sw.apply(spy, XrayContainerKindV1.Logging, config_v1(), selection_v1()).is_ok()).to_equal(true)
        run_dynamic_script(leaf)
        sw.pump(spy)
        expect(shape(sw.profile())).to_equal(ONE_RUN_SHAPE)
        expect(sw.log_lines()).to_equal(ONE_RUN_LOG + ONE_RUN_LOG)
        expect(paired(sw.log_lines())).to_equal(true)
