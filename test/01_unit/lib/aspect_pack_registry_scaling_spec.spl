"""Focused correctness coverage for the per-loader aspect-pack registry.

The registry is keyed by exact pack path inside each loader. These examples
guard the externally visible semantics while the implementation uses O(1)
average Dict membership, lookup, insertion, and removal.
"""

use std.spec
use std.common.aspect_pack.{ApkModuleSourceV1, ApkCatalogEntryV1,
    apk_build_pack_v1, apk_build_catalog_v1, apk_loader_new,
    apk_loader_register_pack, apk_loader_unregister_pack,
    apk_loader_last_error, apk_load_facet}
use std.common.string_core.{text_to_bytes, bytes_to_text}

fn _registry_pack(body: text) -> [u8]:
    var modules: [ApkModuleSourceV1] = []
    modules.push(ApkModuleSourceV1(module_id: "registry.module",
        aspect_id: "registry", payload: text_to_bytes(body)))
    apk_build_pack_v1(modules).bytes

fn _registry_catalog() -> [u8]:
    var entries: [ApkCatalogEntryV1] = []
    entries.push(ApkCatalogEntryV1(facet_key: "registry/Facet",
        pack_path: "aspect/registry.apk", module_id: "registry.module"))
    apk_build_catalog_v1(entries).bytes

describe "aspect-pack per-loader registry":
    it "rejects a duplicate path with the established exact error":
        val ld = apk_loader_new()
        val pack = _registry_pack("first")
        expect(apk_loader_register_pack(ld, "aspect/registry.apk", pack)).to_equal(true)
        expect(apk_loader_register_pack(ld, "aspect/registry.apk", pack)).to_equal(false)
        expect(apk_loader_last_error(ld)).to_equal("pack already registered: aspect/registry.apk")

    it "allows a path to be registered again after unregister":
        val ld = apk_loader_new()
        expect(apk_loader_register_pack(ld, "aspect/registry.apk", _registry_pack("first"))).to_equal(true)
        expect(apk_loader_unregister_pack(ld, "aspect/registry.apk")).to_equal(true)
        expect(apk_loader_register_pack(ld, "aspect/registry.apk", _registry_pack("second"))).to_equal(true)
        val loaded = apk_load_facet(ld, _registry_catalog(), "registry/Facet")
        expect(loaded.ok).to_equal(true)
        expect(bytes_to_text(loaded.payload)).to_equal("second")

    it "isolates the same path between loader registries":
        val left = apk_loader_new()
        val right = apk_loader_new()
        expect(apk_loader_register_pack(left, "aspect/registry.apk", _registry_pack("left"))).to_equal(true)
        expect(apk_loader_register_pack(right, "aspect/registry.apk", _registry_pack("right"))).to_equal(true)
        val catalog = _registry_catalog()
        val left_loaded = apk_load_facet(left, catalog, "registry/Facet")
        val right_loaded = apk_load_facet(right, catalog, "registry/Facet")
        expect(left_loaded.ok).to_equal(true)
        expect(right_loaded.ok).to_equal(true)
        expect(bytes_to_text(left_loaded.payload)).to_equal("left")
        expect(bytes_to_text(right_loaded.payload)).to_equal("right")

    it "unregistering one loader does not remove another loader's path":
        val left = apk_loader_new()
        val right = apk_loader_new()
        expect(apk_loader_register_pack(left, "aspect/registry.apk", _registry_pack("left"))).to_equal(true)
        expect(apk_loader_register_pack(right, "aspect/registry.apk", _registry_pack("right"))).to_equal(true)
        expect(apk_loader_unregister_pack(left, "aspect/registry.apk")).to_equal(true)
        val catalog = _registry_catalog()
        val missing = apk_load_facet(left, catalog, "registry/Facet")
        expect(missing.ok).to_equal(false)
        expect(missing.error_code).to_equal("APK_PACK_MISSING")
        val retained = apk_load_facet(right, catalog, "registry/Facet")
        expect(retained.ok).to_equal(true)
        expect(bytes_to_text(retained.payload)).to_equal("right")
