# Behavioural twin of native_primitive_to_i64_ufcs_collision_2026-07-24:
# a same-named free function in scope must not steal a primitive receiver's
# intrinsic conversion (`.to_i64()`, `.to_f64()`, `.to_text()`, `.len()`).
# @req REQ-SSPEC-COMPILER

use std.spec.*

fn to_i64(v) -> i64:
    -999

fn to_f64(n: i64) -> f64:
    -999.0

fn to_text(v) -> text:
    "stolen"

fn len(collection) -> i64:
    -999

describe "primitive conversions win over same-named free functions":
    it "i64.to_i64() is the identity, not the free to_i64":
        val x: i64 = 255
        expect(x.to_i64()).to_equal(255)

    it "f64.to_i64() truncates, not the free to_i64":
        val f: f64 = 2.75
        expect(f.to_i64()).to_equal(2)

    it "text.to_i64() parses, not the free to_i64":
        expect("42".to_i64()).to_equal(42)

    it "sibling conversions to_f64 / to_text / len stay primitive":
        val n: i64 = 3
        expect(n.to_f64()).to_equal(3.0)
        expect(n.to_text()).to_equal("3")
        expect("abc".len()).to_equal(3)
