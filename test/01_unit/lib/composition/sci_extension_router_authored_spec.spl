# Authored correctness specification. Intentionally unexecuted in this lane.

use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.nogc_sync_mut.composition.types.{SimpleCompositionImageV1,
    SimpleInterfaceGroupRecordV1, SimpleProviderRecordV1, SimpleBindingRecordV1}
use std.nogc_sync_mut.composition.codec.{decode_composition_image_v1,
    admitted_composition_cli_option_route_section_v1}
use std.nogc_sync_mut.composition.sci_extension_builder.{sci_compile_extension_config_v1}
use std.nogc_sync_mut.composition.sci_extension_router.{sci_route_admitted_extension_token_v1}
use app.simple_core.router.{SIMPLE_CORE_ROUTE_PROVIDER, simple_core_route_v1}

fn _image() -> SimpleCompositionImageV1:
    val group = SimpleInterfaceGroupRecordV1("simple.cli.command.v1", 1, 0, "a" * 64)
    val llvm = SimpleProviderRecordV1("provider.llvm", "llvm.smf", "smf", "b" * 64, [group.group_id], 0)
    val llvm_v2 = SimpleProviderRecordV1("provider.llvm.v2", "llvm-v2.smf", "smf", "c" * 64, [group.group_id], 0)
    val office = SimpleProviderRecordV1("provider.office", "office.smf", "smf", "d" * 64, [group.group_id], 0)
    SimpleCompositionImageV1("simple.composition/1", "normal", [], [group],
        [llvm, llvm_v2, office],
        [SimpleBindingRecordV1("cli.llvm", group.group_id, llvm.provider_id),
         SimpleBindingRecordV1("cli.llvm.v2", group.group_id, llvm_v2.provider_id),
         SimpleBindingRecordV1("cli.office", group.group_id, office.provider_id)],
        [], [], "")

fn _config(provider: text, include_office: bool) -> text:
    var source = "schema: simple.cli_extension/1\nnamespaces:\n  - namespace: llvm\n    provider_id: " + provider + "\n"
    if include_office:
        source = source + "  - namespace: office\n    provider_id: provider.office\n"
    source

describe "SCI extension router cutover identity":
    it "REQ-SCI-EXT-01 routes an admitted section-10 extension":
        val artifact = sci_compile_extension_config_v1(_image(), _config("provider.llvm", false), 41)
        val admitted = decode_composition_image_v1(artifact.bytes)
        expect(admitted.ok).to_equal(true)
        val section = admitted_composition_cli_option_route_section_v1(admitted.image).unwrap()
        val routed = sci_route_admitted_extension_token_v1(section, "--xllvm-pass=gvn")
        expect(routed.ok).to_equal(true)
        expect(routed.provider_id).to_equal("provider.llvm")
        expect(routed.key).to_equal("pass")
        expect(routed.value).to_equal("gvn")
        expect(routed.records_examined).to_equal(1)

    it "REQ-SCI-EXT-02 proves add remove and provider mutations change identities and routes":
        val before_source = _config("provider.llvm", false)
        val before = sci_compile_extension_config_v1(_image(), before_source, 41)
        val added = sci_compile_extension_config_v1(_image(), _config("provider.llvm", true), 41)
        val changed = sci_compile_extension_config_v1(_image(), _config("provider.llvm.v2", false), 41)
        expect(before.config_sha256).to_equal(sha256_text(before_source))
        expect(before.artifact_sha256).to_equal(sha256_u8_hex(before.bytes))
        expect(before.config_sha256 == added.config_sha256).to_equal(false)
        expect(before.artifact_sha256 == added.artifact_sha256).to_equal(false)
        expect(before.artifact_sha256 == changed.artifact_sha256).to_equal(false)
        val admitted = decode_composition_image_v1(changed.bytes)
        val section = admitted_composition_cli_option_route_section_v1(admitted.image).unwrap()
        val routed = sci_route_admitted_extension_token_v1(section, "--xllvm-pass=gvn")
        expect(routed.provider_id).to_equal("provider.llvm.v2")
        val removed = decode_composition_image_v1(before.bytes)
        val removed_section = admitted_composition_cli_option_route_section_v1(removed.image).unwrap()
        expect(sci_route_admitted_extension_token_v1(removed_section, "--xoffice-ribbon").ok).to_equal(false)

    it "REQ-SCI-EXT-03 rejects outer and nested integrity mutations independently":
        val artifact = sci_compile_extension_config_v1(_image(), _config("provider.llvm", false), 41)
        var outer_bad = artifact.bytes
        outer_bad[outer_bad.len() - 1] = ((outer_bad[outer_bad.len() - 1] as i64) ^ 1) as u8
        expect(decode_composition_image_v1(outer_bad).ok).to_equal(false)
        val admitted = decode_composition_image_v1(artifact.bytes)
        var section_bad = admitted_composition_cli_option_route_section_v1(admitted.image).unwrap()
        section_bad[section_bad.len() - 1] = ((section_bad[section_bad.len() - 1] as i64) ^ 1) as u8
        expect(sci_route_admitted_extension_token_v1(section_bad, "--xllvm-pass=gvn").ok).to_equal(false)

    it "REQ-SCI-EXT-04 keeps config identity stable while generation mutates artifact identity":
        val source = _config("provider.llvm", false)
        val first = sci_compile_extension_config_v1(_image(), source, 41)
        val next = sci_compile_extension_config_v1(_image(), source, 42)
        expect(first.config_sha256).to_equal(next.config_sha256)
        expect(first.artifact_sha256 == next.artifact_sha256).to_equal(false)

    it "REQ-SCI-EXT-05 reaches the existing simple-core provider activation lifecycle":
        val artifact = sci_compile_extension_config_v1(_image(), _config("provider.llvm", false), 41)
        val admitted = decode_composition_image_v1(artifact.bytes)
        val route = simple_core_route_v1(["--xllvm-pass=gvn"], admitted, "1.0.0-RC")
        expect(route.kind).to_equal(SIMPLE_CORE_ROUTE_PROVIDER)
        expect(route.activation.provider_id).to_equal("provider.llvm")
        expect(route.activation.provider_artifact_path).to_equal("llvm.smf")
        expect(route.activation.canonical_command).to_equal("llvm")
        expect(route.activation.args).to_equal(["pass", "gvn"])
