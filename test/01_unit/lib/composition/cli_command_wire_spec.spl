use std.spec.{describe, it, expect}
use std.nogc_sync_mut.composition.provider_contract.{SIMPLE_CLI_RUN}
use std.nogc_sync_mut.composition.cli_command_wire.{
    encode_cli_command_request_v1, decode_cli_command_request_v1,
    encode_cli_command_result_bytes_v1, encode_cli_command_result_v1, decode_cli_command_result_v1,
    cli_command_result_lengths_valid_v1, cli_command_result_used_length_v1
}

describe "CLI command canonical wire arenas":
    it "round trips a command and length-prefixed arguments":
        val encoded = encode_cli_command_request_v1(
            SIMPLE_CLI_RUN, "fmt", ["--check", "café.spl"], 4096
        )
        expect(encoded.ok).to_equal(true)
        expect(encoded.bytes.len()).to_be_greater_than(28)
        val decoded = decode_cli_command_request_v1(encoded.bytes)
        expect(decoded.ok).to_equal(true)
        expect(decoded.operation).to_equal(SIMPLE_CLI_RUN)
        expect(decoded.command).to_equal("fmt")
        expect(decoded.args).to_equal(["--check", "café.spl"])
        expect(decoded.output_capacity).to_equal(4096)

    it "rejects noncanonical request offsets and trailing argument bytes":
        val encoded = encode_cli_command_request_v1(SIMPLE_CLI_RUN, "fmt", [], 64)
        var bad_offset = encoded.bytes
        bad_offset[8] = 29
        expect(decode_cli_command_request_v1(bad_offset).diagnostic).to_equal("cli-request-bounds-invalid")
        var trailing = encoded.bytes
        trailing.push(0)
        expect(decode_cli_command_request_v1(trailing).diagnostic).to_equal("cli-request-bounds-invalid")

    it "round trips output and diagnostics in one bounded response arena":
        val encoded = encode_cli_command_result_v1(0, "formatted", "")
        expect(encoded.ok).to_equal(true)
        val decoded = decode_cli_command_result_v1(encoded.bytes)
        expect(decoded.ok).to_equal(true)
        expect(decoded.status).to_equal(0)
        expect(decoded.output).to_equal("formatted")
        expect(decoded.diagnostic_text).to_equal("")

    it "encodes provider-owned bytes without requiring text conversion":
        val encoded = encode_cli_command_result_bytes_v1(0, [111, 107], [])
        expect(encoded.ok).to_equal(true)
        expect(encoded.bytes.len()).to_equal(22)
        val decoded = decode_cli_command_result_v1(encoded.bytes)
        expect(decoded.ok).to_equal(true)
        expect(decoded.output).to_equal("ok")

    it "rejects byte results above the canonical response limit":
        expect(cli_command_result_lengths_valid_v1(1048556, 0)).to_equal(true)
        expect(cli_command_result_lengths_valid_v1(1048557, 0)).to_equal(false)
        expect(cli_command_result_lengths_valid_v1(524288, 524289)).to_equal(false)

    it "rejects response offsets that escape or leave trailing material":
        val encoded = encode_cli_command_result_v1(1, "", "invalid args")
        var escaped = encoded.bytes
        escaped[12] = 255
        expect(decode_cli_command_result_v1(escaped).diagnostic).to_equal("cli-result-bounds-invalid")

    it "finds the canonical result length inside a padded provider buffer":
        val encoded = encode_cli_command_result_v1(0, "ok", "")
        var padded = encoded.bytes
        padded.push(0)
        padded.push(0)
        expect(cli_command_result_used_length_v1(padded)).to_equal(encoded.bytes.len())
        padded[12] = 255
        expect(cli_command_result_used_length_v1(padded)).to_equal(-1)
