"""
## Purpose and audience
Behavioural regression for the credential-store-backed authorization builders
(`credential_store_bearer_authorization`,
`credential_store_aws_sigv4_authorization`). Written for engineers working on
`src/lib/nogc_sync_mut/security/auth/credential_store.spl` and its callers.
## Operator workflow
Run the single file with the seeded runner:
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/lib/security/credential_store_apply_derive_spec.spl`
and read the `SPEC FILE VERDICT` line.
## Compatibility and limitations
Loads credentials into an in-memory store; no environment variable, file or
network is touched. Checks header shape, not a live AWS signature.
## Verification guidance and troubleshooting
Before 2026-09-27 every builder returned "" because it wrote the header to a
captured local inside an `apply` callback; closures capture by value and are
read-only (.claude/rules/language.md:22), so the write was lost. The builders
now return the value through `CredentialStore.apply_derive`. An empty header
here means that regression is back.
"""

use std.spec.*
use std.nogc_sync_mut.security.auth.credential_store.{CredentialStore, credential_store_bearer_authorization, credential_store_aws_sigv4_authorization}
use std.nogc_sync_mut.aws_sigv4.{SigV4Header}

describe "credential store authorization builders":
    it "returns a bearer header for a clean token":
        var store = CredentialStore.new()
        store.load_credential("TOKEN", "abc123")
        expect(credential_store_bearer_authorization(store, "TOKEN")).to_equal("Bearer abc123")

    it "rejects a token containing whitespace":
        var store = CredentialStore.new()
        store.load_credential("TOKEN", "a b")
        expect(credential_store_bearer_authorization(store, "TOKEN")).to_equal("")

    it "builds a SigV4 header scoped to the stored access key":
        var store = CredentialStore.new()
        store.load_credential("AK", "AKIDEXAMPLE")
        store.load_credential("SK", "wJalrXUtnFEMI")
        val headers: [SigV4Header] = [SigV4Header(name: "host", value: "kms.us-east-1.amazonaws.com")]
        val auth = credential_store_aws_sigv4_authorization(store, "AK", "SK", "POST", "/", "", headers, "e3b0", "us-east-1", "kms", "20260927T000000Z")
        expect(auth.starts_with("AWS4-HMAC-SHA256")).to_equal(true)
        expect(auth.contains("Credential=AKIDEXAMPLE/20260927/us-east-1/kms/aws4_request")).to_equal(true)
        expect(auth.contains("wJalrXUtnFEMI")).to_equal(false)

    it "exposes only the derived value through apply_derive":
        var store = CredentialStore.new()
        val handle = store.load_credential("SECRET", "s3cr3t")
        expect(store.apply_derive(handle, fn(v): "len={v.len()}")).to_equal("len=6")
