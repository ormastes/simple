"""
## Purpose and audience
Purpose: Prove that remote security Redis session adapter.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-SECURITY-001 — stable requirement identity for this spec.

use std.security.remote_redis.{remote_security_redis_decode_session, remote_security_redis_encode_session, remote_security_redis_session_ttl_seconds}
use std.security.types.{RemoteSecuritySession}

use std.spec.step

describe "remote security Redis session adapter":
    it "serializes sessions with capabilities and revocation state":
        step("Verify: serializes sessions with capabilities and revocation state")
        # @req: REQ-LIB-SECURITY-001
        val session = RemoteSecuritySession(
            session_id: "redis-session",
            user_id: "user-7",
            capabilities: ["profile.read", "billing.write"],
            expires_at_ms: 9000,
            revoked: false
        )

        val payload = remote_security_redis_encode_session(session)

        expect(payload).to_equal("session|redis-session|user-7|9000|false|profile.read,billing.write")

    it "decodes Redis session payloads":
        step("Verify: decodes Redis session payloads")
        val payload = "session|redis-session|user-7|9000|false|profile.read,billing.write"
        val decoded = remote_security_redis_decode_session(payload)

        expect(decoded == nil).to_equal(false)

    it "preserves decoded user identity":
        step("Verify: preserves decoded user identity")
        val payload = "session|redis-session|user-7|9000|false|profile.read,billing.write"
        val decoded = remote_security_redis_decode_session(payload)
        expect(decoded.unwrap().user_id).to_equal("user-7")

    it "preserves decoded capability lists":
        step("Verify: preserves decoded capability lists")
        val payload = "session|redis-session|user-7|9000|false|profile.read,billing.write"
        val decoded = remote_security_redis_decode_session(payload)
        expect(decoded.unwrap().capabilities[1]).to_equal("billing.write")

    it "uses bounded tombstone ttl for revoked sessions":
        step("Verify: uses bounded tombstone ttl for revoked sessions")
        val session = RemoteSecuritySession(
            session_id: "revoked-redis-session",
            user_id: "user-8",
            capabilities: ["audit.read"],
            expires_at_ms: 9000,
            revoked: true
        )

        expect(remote_security_redis_session_ttl_seconds(session, 1000, 120)).to_equal(120)  # oracle: 120 — named expected value from the requirement
        expect(remote_security_redis_session_ttl_seconds(session, 1000, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "ceil-rounds active session expiry to Redis seconds":
        step("Verify: ceil-rounds active session expiry to Redis seconds")
        val session = RemoteSecuritySession(
            session_id: "active-redis-session",
            user_id: "user-9",
            capabilities: ["audit.read"],
            expires_at_ms: 2501,
            revoked: false
        )

        expect(remote_security_redis_session_ttl_seconds(session, 1000, 120)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(remote_security_redis_session_ttl_seconds(session, 3000, 120)).to_equal(1)  # oracle: 1 — named expected value from the requirement
