extern fn rt_file_read_text(path: text) -> text

describe "nogc_sync_mut http response plain-text helper dedup":
    it "extracts a shared build_plain_text_response helper used by ok/not_found/server_error":
        val source = rt_file_read_text("src/lib/nogc_sync_mut/http/response.spl") ?? ""

        expect(source).to_contain("fn build_plain_text_response(status: i64, body: text) -> text:")
        expect(source).to_contain("return build_plain_text_response(200, body)")
        expect(source).to_contain("return build_plain_text_response(404, \"Not Found\")")
        expect(source).to_contain("return build_plain_text_response(500, \"Internal Server Error\")")
