# parse_multipart_part misidentifies the header/body separator — nogc_sync_mut tier
#
# **Category:** HTTP Correctness
# **Difficulty:** 3/5
# **Status:** Implemented
#
# ## Overview
# `parse_multipart_part` (src/lib/nogc_sync_mut/http/headers.spl) splits the
# part text on "\r\n" and scans for the first empty line to find where headers
# end and the body begins. But a real multipart part, as produced by
# `body.split(delimiter)` in `parse_multipart`, always STARTS with "\r\n" (the
# CRLF that terminates the boundary line itself is left attached to the
# following part). That means `lines[0]` is always "" — the scan finds the
# leading empty string at index 0 immediately, sets `header_end = 0`, and the
# `if header_end == 0: return nil` guard (meant to catch "no separator found")
# incorrectly fires on every single part, header or no. `parse_multipart`
# never gets a single valid part back for a normal, well-formed multipart body.

use std.spec.*
use std.nogc_sync_mut.http.headers.{parse_multipart}

describe "nogc_sync_mut http.headers parse_multipart — header/body separator":
    it "parses a normal single-part multipart body with headers and a body":
        val boundary = "BOUNDARY"
        val body = "--BOUNDARY\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nhello\r\n--BOUNDARY--\r\n"
        val parts = parse_multipart(body, boundary)
        assert_true(parts.length() > 0)
        # The real content part (headers + "hello" body) must actually be
        # among the parsed parts -- a garbage trailing "--" fragment must not
        # be allowed to make the count alone look healthy.
        var found_real_part = false
        var i = 0
        while i < parts.length():
            val part = parts[i]
            val body_text = part[1]
            if body_text.starts_with("hello"):
                found_real_part = true
            i = i + 1
        assert_true(found_real_part)
