use std.spec.{describe, it, expect}
use std.http.h2.h2_preface.{h2_connection_preface_bytes, h2_preface_probe}

describe "incremental h2c preface probe":
    it "keeps every exact incomplete prefix pending":
        val preface = h2_connection_preface_bytes()
        var prefix: [u8] = []
        var i = 0
        while i < 23:
            prefix.push(preface[i])
            expect(h2_preface_probe(prefix)).to_equal(0)
            i = i + 1

    it "accepts exactly 24 bytes and preserves trailing frame bytes":
        var bytes = h2_connection_preface_bytes()
        expect(h2_preface_probe(bytes)).to_equal(1)
        bytes.push(0)
        bytes.push(0)
        expect(h2_preface_probe(bytes)).to_equal(1)

    it "rejects PRICE without mistaking PRI for HTTP/2":
        val price: [u8] = [80, 82, 73, 67, 69, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 13, 10]
        expect(h2_preface_probe(price)).to_equal(-1)

    it "rejects a mismatch at the final preface byte":
        var bad = h2_connection_preface_bytes()
        bad[23] = 11
        expect(h2_preface_probe(bad)).to_equal(-1)
