use std.spec
use lib.nogc_sync_mut.http_server.h2_server.{_text_to_u8}

describe "h2_server text-to-bytes encoding":
    """As an HTTP/2 server author I encode response body text into wire
    bytes; every byte must be the character's real code, never a silently
    parsed 0, or GOAWAY debug data and DATA frames ship as NULs."""

    it "encodes letters and digits to their real byte values":
        # @req: LIB-H2-TEXTU8-001
        # @manual_section: 4.1
        step("encode 'A7' — expect [65, 55], not [0, 7]")
        val out = _text_to_u8("A7")
        expect(out.len()).to_equal(2)
        expect(out[0].to_i64()).to_equal(65)
        expect(out[1].to_i64()).to_equal(55)
