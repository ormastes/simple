# @req: REQ-LIB-LIB-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/auto_coverage_6_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/auto_coverage_6.md
# doc-path: doc/03_plan/sys_test/auto_coverage_6.md
# doc-path: doc/04_architecture/auto_coverage_6.md
# doc-path: doc/05_design/auto_coverage_6.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "for-in accumulates array elements":
        step("Verify: for-in accumulates array elements")
        # @req: REQ-LIB-LIB-001
        var s = 0
        for x in [1, 2, 3]:
            s = s + x
        expect(s).to_equal(6)  # oracle: 1+2+3

    it "chained comparison yields a boolean":
        step("Verify: chained comparison yields a boolean")
        # @req: REQ-LIB-LIB-001
        expect(1 < 2).to_equal(true)
        expect(2 <= 2).to_equal(true)
        expect(3 != 3).to_equal(false)

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-LIB-LIB-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-LIB-LIB-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-LIB-LIB-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10

    it "nil option falls to else arm":
        step("Verify: nil option falls to else arm")
        # @req: REQ-LIB-LIB-001
        val opt = nil
        var chosen = 1
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(-1)  # oracle: nil arm taken
