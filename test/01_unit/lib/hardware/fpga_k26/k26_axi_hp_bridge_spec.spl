# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/hardware/fpga_k26/k26_axi_hp_bridge.spl 0%
"""
# K26 AXI-HP Bridge Specification
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Draft
**Requirements:** REQ-2
**Artifacts:** N/A
## Operator workflow
Run `bin/simple test test/unit/lib/hardware/fpga_k26/k26_axi_hp_bridge_spec.spl` and require the final Results line to report 0 failed.

## Overview

Verifies AC-2: AXI-HP bridge generates correct SystemVerilog for wiring
VexRiscv-SMP AXI4 master to PS S_AXI_HP0 (128-bit burst DDR access).
Tests that the generated SV text contains required module declarations,
port names, and AXI4 signal names.

Covers:
- AC-2 (SOC integration: AXI-HP bridge for DDR access from PL core)
## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

use std.spipe.*
use lib.hardware.fpga_k26.k26_axi_hp_bridge.{generate_axi_hp_bridge_sv}

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step



# ============================================================================
# Helper: generate bridge SV once
# ============================================================================

fn bridge_sv() -> text:
    return generate_axi_hp_bridge_sv()


# ============================================================================
# AC-2: AXI-HP Bridge SystemVerilog Content
# ============================================================================

describe "K26 AXI-HP Bridge SystemVerilog":
    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits

    # @manual scenario evidence
    it "AC-2: generated SV contains module declaration":
        # @req REQ-SSPEC-UNIT
        # @req REQ-2
        step("AC-2: generated SV contains module declaration")
        val sv = bridge_sv()
        expect(sv).to_contain("module")

    it "AC-2: generated SV contains endmodule":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV contains endmodule")
        val sv = bridge_sv()
        expect(sv).to_contain("endmodule")

    it "AC-2: generated SV declares AXI AWADDR port":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV declares AXI AWADDR port")
        val sv = bridge_sv()
        expect(sv).to_contain("AWADDR")

    it "AC-2: generated SV declares AXI WDATA port":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV declares AXI WDATA port")
        val sv = bridge_sv()
        expect(sv).to_contain("WDATA")

    it "AC-2: generated SV declares AXI ARADDR port":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV declares AXI ARADDR port")
        val sv = bridge_sv()
        expect(sv).to_contain("ARADDR")

    it "AC-2: generated SV declares AXI RDATA port":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV declares AXI RDATA port")
        val sv = bridge_sv()
        expect(sv).to_contain("RDATA")

    it "AC-2: generated SV declares AXI AWBURST port":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV declares AXI AWBURST port")
        val sv = bridge_sv()
        expect(sv).to_contain("AWBURST")

    it "AC-2: generated SV references S_AXI_HP0":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV references S_AXI_HP0")
        val sv = bridge_sv()
        expect(sv).to_contain("HP0")

    it "AC-2: generated SV is non-empty":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV is non-empty")
        val sv = bridge_sv()
        val len = sv.length()
        expect(len).to_be_greater_than(0)

    it "AC-2: generated SV contains input/output port direction":
        # @req REQ-SSPEC-UNIT
        step("AC-2: generated SV contains input/output port direction")
        val sv = bridge_sv()
        expect(sv).to_contain("input")
