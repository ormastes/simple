# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Focused state check for the fixed RV64 integer and floating-point banks.
use std.spec.step

use std.hardware.rv64gc_rtl.regfile.{INIT_SP_64, regfile64_create, regfile64_read_one, regfile64_write}
use std.hardware.rv64gc_rtl.fregfile.{fregfile64_create, fregfile64_read, fregfile64_write}

describe "RV64GC register banks":
    it "integer reset keeps x0 and stack pointer":
        step("integer reset keeps x0 and stack pointer")
        val reset = regfile64_create()
        assert_equal(regfile64_read_one(reset, 0), 0)
        assert_equal(regfile64_read_one(reset, 2), INIT_SP_64)

    it "integer bank preserves x0 and write enable":
        step("integer bank preserves x0 and write enable")
        val reset = regfile64_create()
        val x31 = regfile64_write(reset, 31, 0x1234, true)
        val x0 = regfile64_write(x31, 0, 99, true)
        val disabled = regfile64_write(x0, 1, 88, false)
        assert_equal(regfile64_read_one(disabled, 31), 0x1234)
        assert_equal(regfile64_read_one(disabled, 0), 0)
        assert_equal(regfile64_read_one(disabled, 1), 0)

    it "float bank writes all 32 indices and masks addresses":
        step("float bank writes all 32 indices and masks addresses")
        val fp_reset = fregfile64_create()
        val fp31 = fregfile64_write(fp_reset, 31, 0x5566)
        val fp0 = fregfile64_write(fp31, 32, 0x7788)
        assert_equal(fregfile64_read(fp0, 31), 0x5566)
        assert_equal(fregfile64_read(fp0, 0), 0x7788)
        assert_equal(fregfile64_read(fp0, 32), 0x7788)
