# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# Focused protected RV64 core check: staged fetch, enforced PMP CSRs, and MPRV.
use std.spec.step

use std.spec.{describe, it, expect}
use std.hardware.rv64gc_rtl.core_types.{CORE64_FETCH_LOW, CORE64_WFI}
use std.hardware.rv64gc_rtl.core.{core64_init, core64_set_fpu}
use std.hardware.rv64gc_rtl.core_helpers.core64_csr_access
use std.hardware.rv64gc_rtl.protected_core.{core64_init_single_master, core64_cycle}
use std.hardware.rv64gc_rtl.protected_core.{core64_data_privilege, core64_sum_enabled, core64_mxr_enabled}
use std.hardware.rv64gc_rtl.regfile.{regfile64_read, regfile64_write}
use std.hardware.rv64gc_rtl.csr.{MSTATUS_MIE_MASK, MIP_MTIP_MASK, csr64_fs_state, csr64_tick, csr64_retire, FS_INITIAL}
use std.hardware.rv64gc_rtl.mmu_sv39.{mmu64_set_satp, mmu64_tlb_insert}
use std.hardware.rv64gc_rtl.pmp_csr.{pmp64_entries_reset, pmp64_csr_write}
use std.hardware.rv64gc_rtl.fpu.{fcsr_read_csr, fpu_config_disabled, fpu_config_single_only, fregfile64_read}
use std.hardware.rv64gc_rtl.protected_entry.core64_protected_clocked_entry

val RESET_PC: i64 = 0x8000_0000

describe "protected fetch and retire":
    it "two-parcel ADDI commits and emits one ordered RVFI retire":
        step("protected low fetch")
        val low = core64_cycle(core64_init(RESET_PC), true, true, false, 0x0093)
        expect(low.bus_valid and low.bus_addr == RESET_PC).to_equal(true)
        step("two-parcel ADDI commit")
        val high = core64_cycle(low.state, true, true, false, 0x0050)
        expect(high.state.pc == RESET_PC + 4 and
            regfile64_read(high.state.rf, 1, 0).rs1_data == 5).to_equal(true)
        step("protected ADDI emits one ordered RVFI retire")
        expect(not low.rvfi.rvfi_valid and high.rvfi.rvfi_valid and
            not high.rvfi.rvfi_trap and high.rvfi.rvfi_order == 0 and
            high.rvfi.rvfi_pc_rdata == RESET_PC and
            high.rvfi.rvfi_pc_wdata == RESET_PC + 4 and
            high.rvfi.rvfi_rd_addr == 1 and high.rvfi.rvfi_rd_wdata == 5).to_equal(true)

    it "JALR clears target bit zero while preserving the ordinary link value":
        step("JALR clears target bit zero")
        var jalr = core64_init(RESET_PC)
        jalr.rf = regfile64_write(jalr.rf, 1, RESET_PC + 0x11, true)
        val jalr_low = core64_cycle(jalr, true, true, false, 0x8167)
        val jalr_high = core64_cycle(jalr_low.state, true, true, false, 0)
        expect(jalr_high.state.pc == RESET_PC + 0x10 and
            regfile64_read(jalr_high.state.rf, 2, 0).rs1_data == RESET_PC + 4 and
            jalr_high.rvfi.rvfi_pc_wdata == RESET_PC + 0x10).to_equal(true)

    it "clocked source entry calls protected core":
        step("clocked source entry calls protected core")
        val entry_low = core64_protected_clocked_entry(true, true,
            core64_init(RESET_PC), true, true, false, 0x0093)
        expect(entry_low.bus_valid and entry_low.bus_addr == RESET_PC).to_equal(true)

describe "FPU configuration and MISA":
    it "configured FPU controls MISA F/D":
        step("MISA follows the configured FPU: D implies F, single-only omits D")
        val fp_enabled = core64_init(RESET_PC)
        val fp_single = core64_set_fpu(fp_enabled, fpu_config_single_only())
        val fp_disabled = core64_set_fpu(fp_enabled, fpu_config_disabled())
        expect((fp_enabled.csr_m.misa & ((1 << 5) | (1 << 3))) == ((1 << 5) | (1 << 3)) and
            (fp_single.csr_m.misa & ((1 << 5) | (1 << 3))) == (1 << 5) and
            (fp_disabled.csr_m.misa & ((1 << 5) | (1 << 3))) == 0).to_equal(true)

    it "F-only rejects FMV.D.X but preserves FMV.W.X":
        step("F-only rejects FMV.D.X but preserves FMV.W.X")
        var single_move = core64_set_fpu(core64_init(RESET_PC), fpu_config_single_only())
        single_move.rf = regfile64_write(single_move.rf, 1, 0x123, true)
        # Software enables FP (mstatus.FS = Initial) before issuing FP insns.
        single_move.csr_m.mstatus = single_move.csr_m.mstatus | (FS_INITIAL << 13)
        val single_d_low = core64_cycle(single_move, true, true, false, 0x80D3)
        val single_d_high = core64_cycle(single_d_low.state, true, true, false, 0xF200)
        val single_f_low = core64_cycle(single_move, true, true, false, 0x80D3)
        val single_f_high = core64_cycle(single_f_low.state, true, true, false, 0xF000)
        expect(single_d_high.state.csr_m.mcause == 2 and single_d_high.state.csr_m.minstret == 0 and
            single_f_high.state.csr_m.mcause == 0 and single_f_high.state.csr_m.minstret == 1).to_equal(true)

    it "F-only rejects FLD and FSD before a data transaction":
        step("F-only rejects FLD before a data transaction")
        var single_load = core64_set_fpu(core64_init(RESET_PC), fpu_config_single_only())
        single_load.rf = regfile64_write(single_load.rf, 1, 0x2000, true)
        val fld_low = core64_cycle(single_load, true, true, false, 0xB087)
        val fld_high = core64_cycle(fld_low.state, true, true, false, 0)
        expect(fld_high.state.csr_m.mcause == 2 and fld_high.state.csr_m.minstret == 0 and
            fld_high.state.pipeline_phase == 0).to_equal(true)
        step("F-only rejects FSD before a data transaction")
        val fsd_low = core64_cycle(single_load, true, true, false, 0xB027)
        val fsd_high = core64_cycle(fsd_low.state, true, true, false, 0x0010)
        expect(fsd_high.state.csr_m.mcause == 2 and fsd_high.state.csr_m.minstret == 0 and
            fsd_high.state.pipeline_phase == 0).to_equal(true)

describe "CSR counters and SATP":
    it "cycle and retirement counters are independent":
        step("cycle and retirement counters are independent")
        val ticked = csr64_tick(core64_init(RESET_PC).csr_m)
        val retired = csr64_retire(ticked)
        expect(ticked.mcycle == 1 and ticked.minstret == 0 and
            retired.mcycle == 1 and retired.minstret == 1).to_equal(true)

    it "unsupported Sv48 SATP retains Sv39 CSR and MMU":
        step("unsupported Sv48 SATP retains Sv39 CSR and MMU")
        val sv39_satp: i64 = ((8 as i64) << 60) | 0x100
        val satp_sv39 = core64_csr_access(core64_init(RESET_PC), 0x180, sv39_satp, 1)
        var satp_state = core64_init(RESET_PC)
        satp_state.csr_s = satp_sv39.csr_s
        satp_state.mmu = satp_sv39.mmu
        val satp_sv48 = core64_csr_access(satp_state, 0x180,
            ((9 as i64) << 60) | 0x200, 1)
        expect(satp_sv48.csr_s.satp == sv39_satp and satp_sv48.mmu.satp_mode == 8 and
            satp_sv48.mmu.satp_ppn == 0x100).to_equal(true)

    it "reserved pmpcfg1 traps":
        step("RV64-reserved pmpcfg1 must not fall through to legacy CsrExt storage")
        val reserved = core64_csr_access(core64_init(RESET_PC), 0x3A1, 0, 2)
        expect(not reserved.valid).to_equal(true)

describe "MPRV and sstatus aliasing":
    it "MPRV selects MPP=S":
        step("a core CSR write retains MPRV and MPP for staged data accesses")
        val mstatus = core64_csr_access(core64_init(RESET_PC), 0x300,
            (1 << 17) | (1 << 11), 1)
        var mprv = core64_init(RESET_PC)
        mprv.csr_m = mstatus.csr_m
        expect(core64_data_privilege(mprv) == 1).to_equal(true)

    it "sstatus SUM/MXR mirrors to protected data view":
        step("the S-status alias updates the mstatus view used by MPRV data accesses")
        val sstatus = core64_csr_access(core64_init(RESET_PC), 0x100,
            (1 << 18) | (1 << 19), 1)
        var supervisor = core64_init(RESET_PC)
        supervisor.csr_m = sstatus.csr_m
        supervisor.csr_s = sstatus.csr_s
        expect(core64_sum_enabled(supervisor) and core64_mxr_enabled(supervisor)).to_equal(true)

    it "sstatus FS aliases mstatus and SD stays derived":
        step("sstatus.FS is a writable alias of mstatus.FS; SD ignores software writes")
        val sstatus_fp = core64_csr_access(core64_init(RESET_PC), 0x100,
            (2 << 13) | (1 << 63), 1)
        expect(csr64_fs_state(sstatus_fp.csr_m) == 2 and
            ((sstatus_fp.csr_s.sstatus >> 13) & 3) == 2 and
            (sstatus_fp.csr_s.sstatus & (1 << 63)) == 0).to_equal(true)

describe "ECALL and semihosting":
    it "ECALL traps before retire or IRQ":
        step("ECALL is synchronous: it must not retire or be replaced by a pending IRQ")
        var ecall = core64_init(RESET_PC)
        ecall.csr_m.mtvec = 0x100
        ecall.csr_m.mstatus = MSTATUS_MIE_MASK
        ecall.csr_m.mie = MIP_MTIP_MASK
        ecall.csr_m.mip = MIP_MTIP_MASK
        val ecall_low = core64_cycle(ecall, true, true, false, 0x0073)
        val ecall_high = core64_cycle(ecall_low.state, true, true, false, 0)
        expect(ecall_high.state.pc == 0x100 and
            ecall_high.state.csr_m.mcause == 11 and ecall_high.state.csr_m.minstret == 0).to_equal(true)

    it "synchronous ECALL emits one ordered RVFI trap":
        step("synchronous ECALL emits one ordered RVFI trap")
        var ecall2 = core64_init(RESET_PC)
        ecall2.csr_m.mtvec = 0x100
        val ecall2_low = core64_cycle(ecall2, true, true, false, 0x0073)
        val ecall2_high = core64_cycle(ecall2_low.state, true, true, false, 0)
        expect(ecall2_high.rvfi.rvfi_valid and ecall2_high.rvfi.rvfi_trap and
            ecall2_high.rvfi.rvfi_order == 0 and ecall2_high.rvfi.rvfi_insn == 0x00000073 and
            ecall2_high.state.rvfi_order == 1).to_equal(true)

    it "protected semihost EBREAK latches operation and parameter":
        step("only phase-1 semihost EBREAK bypasses the ordinary breakpoint trap")
        var semi = core64_init(RESET_PC)
        semi.rf = regfile64_write(semi.rf, 10, 0x11, true)
        semi.rf = regfile64_write(semi.rf, 11, 0x22, true)
        val semi_entry_low = core64_cycle(semi, true, true, false, 0x1013)
        val semi_entry = core64_cycle(semi_entry_low.state, true, true, false, 0x01F0)
        val semi_break_low = core64_cycle(semi_entry.state, true, true, false, 0x0073)
        val semi_break = core64_cycle(semi_break_low.state, true, true, false, 0x0010)
        expect(semi_break.state.semi_phase == 2 and semi_break.state.semi_suppress and
            semi_break.state.semi_op == 0x11 and semi_break.state.semi_param == 0x22 and
            semi_break.state.csr_m.mcause == 0).to_equal(true)

describe "WFI behavior":
    it "WFI retires once then holds":
        step("WFI retires once, then holds without refetching or inflating minstret")
        var wfi = core64_init(RESET_PC)
        wfi.csr_m.mstatus = MSTATUS_MIE_MASK
        val wfi_low = core64_cycle(wfi, true, true, false, 0x0073)
        val wfi_high = core64_cycle(wfi_low.state, true, true, false, 0x1050)
        val wfi_hold = core64_cycle(wfi_high.state, false, false, false, 0)
        expect(wfi_high.state.pipeline_phase == CORE64_WFI and
            wfi_high.state.pc == RESET_PC + 4 and wfi_hold.bus_valid == false and
            wfi_hold.state.csr_m.minstret == 1).to_equal(true)

    it "WFI wakes on raw local pending state without taking a gated trap":
        step("WFI wakeup observes raw locally enabled pending interrupts")
        var wfi2 = core64_init(RESET_PC)
        wfi2.csr_m.mstatus = MSTATUS_MIE_MASK
        val wfi2_low = core64_cycle(wfi2, true, true, false, 0x0073)
        val wfi2_high = core64_cycle(wfi2_low.state, true, true, false, 0x1050)
        val wfi2_hold = core64_cycle(wfi2_high.state, false, false, false, 0)
        var wfi_raw_pending = wfi2_hold.state
        wfi_raw_pending.csr_m.mstatus = wfi_raw_pending.csr_m.mstatus & (MSTATUS_MIE_MASK ^ -1)
        wfi_raw_pending.csr_m.mie = MIP_MTIP_MASK
        wfi_raw_pending.csr_m.mip = MIP_MTIP_MASK
        val wfi_wake = core64_cycle(wfi_raw_pending, false, false, false, 0)
        expect(wfi_wake.state.pipeline_phase == CORE64_FETCH_LOW and
            not wfi_wake.state.wfi_wait and wfi_wake.state.pc == RESET_PC + 4 and
            wfi_wake.state.csr_m.mcause == 0 and wfi_wake.state.csr_m.minstret == 1 and
            not wfi_wake.rvfi.rvfi_valid).to_equal(true)

describe "SRET and MPRV":
    it "SRET clears MPRV on privilege drop":
        step("SRET executed from M and lowered to U must not leave MPRV armed")
        var sret = core64_init(RESET_PC)
        sret.csr_m.mstatus = 1 << 17
        val sret_low = core64_cycle(sret, true, true, false, 0x0073)
        val sret_high = core64_cycle(sret_low.state, true, true, false, 0x1020)
        expect((sret_high.state.csr_m.mstatus & (1 << 17)) == 0).to_equal(true)

    it "S-mode SRET clears MPRV when returning to U":
        step("S-mode SRET clears MPRV when returning to U")
        var sret_s = core64_init(RESET_PC)
        sret_s.priv_mode = 1
        sret_s.csr_m.mstatus = 1 << 17
        # Open one NAPOT PMP entry (RWX, full range) so the S-mode fetch
        # itself is not denied before the SRET executes.
        var sret_pmp = pmp64_entries_reset()
        sret_pmp = pmp64_csr_write(sret_pmp, 0x3B0, 0x003F_FFFF_FFFF_FFFF).entries
        sret_s.pmp = pmp64_csr_write(sret_pmp, 0x3A0, 0x1F).entries
        val sret_s_low = core64_cycle(sret_s, true, true, false, 0x0073)
        val sret_s_high = core64_cycle(sret_s_low.state, true, true, false, 0x1020)
        expect(sret_s_high.state.priv_mode == 0 and
            (sret_s_high.state.csr_m.mstatus & (1 << 17)) == 0).to_equal(true)

describe "PMP and MMU data faults":
    it "PMP-denied LD suppresses data bus and traps":
        step("MPRV=S makes a machine-fetched LD use S-mode PMP; empty PMP denies the access")
        var denied = core64_init(RESET_PC)
        denied.rf = regfile64_write(denied.rf, 1, 0x2000, true)
        denied.csr_m.mtvec = 0x100
        denied.csr_m.mstatus = (1 << 17) | (1 << 11)
        val denied_low = core64_cycle(denied, true, true, false, 0xB103)
        val denied_high = core64_cycle(denied_low.state, true, true, false, 0)
        val denied_data = core64_cycle(denied_high.state, false, false, false, 0)
        expect(not denied_data.bus_valid and denied_data.state.pc == 0x100 and
            denied_data.state.csr_m.mcause == 5 and denied_data.state.csr_m.mtval == 0x2000 and
            denied_data.state.csr_m.minstret == 0).to_equal(true)

    it "Sv39 invalid PTE raises load page fault":
        step("with PMP open, an invalid Sv39 root PTE reaches the walker")
        val vaddr: i64 = 0x0000_0000_4000_1000
        var paged = core64_init(RESET_PC)
        paged.rf = regfile64_write(paged.rf, 1, vaddr, true)
        paged.csr_m.mtvec = 0x180
        paged.csr_m.mstatus = (1 << 17) | (1 << 11)
        paged.mmu = mmu64_set_satp(paged.mmu, ((8 as i64) << 60) | 0x100)
        var open_pmp = pmp64_entries_reset()
        open_pmp = pmp64_csr_write(open_pmp, 0x3B0, 0x003F_FFFF_FFFF_FFFF).entries
        paged.pmp = pmp64_csr_write(open_pmp, 0x3A0, 0x1F).entries
        val paged_low = core64_cycle(paged, true, true, false, 0xB103)
        val paged_high = core64_cycle(paged_low.state, true, true, false, 0)
        val bad_pte = core64_cycle(paged_high.state, true, true, false, 0)
        expect(bad_pte.bus_valid and bad_pte.bus_is_pte and not bad_pte.bus_write and
            bad_pte.state.pc == 0x180 and bad_pte.state.csr_m.mcause == 13 and
            bad_pte.state.csr_m.mtval == vaddr and bad_pte.state.csr_m.minstret == 0).to_equal(true)

describe "RVFI memory lane":
    it "RVFI byte store shifts mask and data to physical lane":
        step("RVFI subword byte enables and payloads occupy the physical address lane")
        var sb = core64_init(RESET_PC)
        sb.rf = regfile64_write(sb.rf, 1, 0x2000, true)
        sb.rf = regfile64_write(sb.rf, 2, 0x5A, true)
        val sb_low = core64_cycle(sb, true, true, false, 0x81A3)
        val sb_high = core64_cycle(sb_low.state, true, true, false, 0x0020)
        val sb_done = core64_cycle(sb_high.state, true, true, false, 0)
        expect(sb_done.state.pc == RESET_PC + 4 and sb_done.rvfi.rvfi_valid and
            sb_done.rvfi.rvfi_mem_addr == 0x2003 and
            sb_done.rvfi.rvfi_mem_wmask == 0x08 and
            sb_done.rvfi.rvfi_mem_wdata == (0x5A << 24)).to_equal(true)

    it "RVFI byte load shifts mask and data to physical lane":
        step("RVFI byte load shifts mask and data to physical address lane")
        var lb = core64_init(RESET_PC)
        lb.rf = regfile64_write(lb.rf, 1, 0x2000, true)
        val lb_low = core64_cycle(lb, true, true, false, 0x8183)
        val lb_high = core64_cycle(lb_low.state, true, true, false, 0x0050)
        val lb_done = core64_cycle(lb_high.state, true, true, false, 0x7A)
        expect(regfile64_read(lb_done.state.rf, 3, 0).rs1_data == 0x7A and
            lb_done.rvfi.rvfi_valid and lb_done.rvfi.rvfi_mem_addr == 0x2005 and
            lb_done.rvfi.rvfi_mem_rmask == 0x20 and
            lb_done.rvfi.rvfi_mem_rdata == ((0x7A as i64) << 40)).to_equal(true)

describe "LR/SC atomics":
    it "LR.D reserves through an atomic read":
        step("the protected single-master path carries LR.D as an atomic physical transaction")
        var atomic = core64_init_single_master(RESET_PC)
        atomic.rf = regfile64_write(atomic.rf, 1, 0x2000, true)
        atomic.rf = regfile64_write(atomic.rf, 4, 0x66, true)
        val lr_low = core64_cycle(atomic, true, true, false, 0xB12F)
        val lr_high = core64_cycle(lr_low.state, true, true, false, 0x1000)
        val lr_done = core64_cycle(lr_high.state, true, true, false, 0x55)
        expect(lr_done.bus_valid and lr_done.bus_atomic and not lr_done.bus_write and
            lr_done.bus_addr == 0x2000 and lr_done.state.atomics.reservation_valid and
            regfile64_read(lr_done.state.rf, 2, 0).rs1_data == 0x55 and
            lr_done.rvfi.rvfi_valid and lr_done.rvfi.rvfi_mem_addr == 0x2000 and
            lr_done.rvfi.rvfi_mem_rmask == 0xFF and lr_done.rvfi.rvfi_mem_wmask == 0).to_equal(true)

    it "SC.D consumes reservation through an atomic write":
        step("SC.D consumes the reservation through an atomic physical write")
        var atomic2 = core64_init_single_master(RESET_PC)
        atomic2.rf = regfile64_write(atomic2.rf, 1, 0x2000, true)
        atomic2.rf = regfile64_write(atomic2.rf, 4, 0x66, true)
        val sc_low = core64_cycle(atomic2, true, true, false, 0xB12F)
        val sc_high = core64_cycle(sc_low.state, true, true, false, 0x1000)
        val sc_mid = core64_cycle(sc_high.state, true, true, false, 0x55)
        val sc2_low = core64_cycle(sc_mid.state, true, true, false, 0xB1AF)
        val sc2_high = core64_cycle(sc2_low.state, true, true, false, 0x1840)
        val sc_done = core64_cycle(sc2_high.state, true, true, false, 0)
        expect(sc_done.bus_valid and sc_done.bus_atomic and sc_done.bus_write and
            sc_done.bus_addr == 0x2000 and sc_done.bus_wdata == 0x66 and
            not sc_done.state.atomics.reservation_valid and
            regfile64_read(sc_done.state.rf, 3, 0).rs1_data == 0 and
            sc_done.rvfi.rvfi_valid and sc_done.rvfi.rvfi_mem_addr == 0x2000 and
            sc_done.rvfi.rvfi_mem_rmask == 0 and sc_done.rvfi.rvfi_mem_wmask == 0xFF).to_equal(true)

    it "translated LR keeps physical reservation for SC":
        step("translated LR/SC reserves the physical granule even when VA != PA")
        val atomic_va: i64 = 0x0000_0000_4000_1000
        val atomic_pa: i64 = 0x2000
        var translated = core64_init_single_master(RESET_PC)
        translated.csr_m.mstatus = (1 << 17) | (1 << 11)
        translated.rf = regfile64_write(translated.rf, 1, atomic_va, true)
        translated.rf = regfile64_write(translated.rf, 4, 0x77, true)
        translated.mmu = mmu64_set_satp(translated.mmu, (8 as i64) << 60)
        translated.mmu = mmu64_tlb_insert(translated.mmu, atomic_va >> 12,
            atomic_pa >> 12, 0xC7)
        var translated_pmp = pmp64_entries_reset()
        translated_pmp = pmp64_csr_write(translated_pmp, 0x3B0,
            0x003F_FFFF_FFFF_FFFF).entries
        translated.pmp = pmp64_csr_write(translated_pmp, 0x3A0, 0x1F).entries
        val tlr_low = core64_cycle(translated, true, true, false, 0xB12F)
        val tlr_high = core64_cycle(tlr_low.state, true, true, false, 0x1000)
        val tlr_done = core64_cycle(tlr_high.state, true, true, false, 0x44)
        val tsc_low = core64_cycle(tlr_done.state, true, true, false, 0xB1AF)
        val tsc_high = core64_cycle(tsc_low.state, true, true, false, 0x1840)
        val tsc_done = core64_cycle(tsc_high.state, true, true, false, 0)
        expect(atomic_va != atomic_pa and tlr_done.bus_addr == atomic_pa and
            tlr_done.state.atomics.reservation_addr == atomic_pa and
            tsc_done.bus_addr == atomic_pa and tsc_done.bus_write and
            regfile64_read(tsc_done.state.rf, 3, 0).rs1_data == 0).to_equal(true)

describe "FP execution through protected fetch":
    it "protected FMV.D.X preserves FP state and FS":
        step("FMV.D.X writes f1 and dirties FS through protected fetch")
        var fp = core64_init(RESET_PC)
        fp.rf = regfile64_write(fp.rf, 1, 0x123, true)
        fp.rf = regfile64_write(fp.rf, 5, 0x51, true)
        # Software enables FP (mstatus.FS = Initial) before issuing FP insns.
        fp.csr_m.mstatus = fp.csr_m.mstatus | (FS_INITIAL << 13)
        val fmv_low = core64_cycle(fp, true, true, false, 0x80D3)
        val fmv_high = core64_cycle(fmv_low.state, true, true, false, 0xF200)
        expect(fregfile64_read(fmv_high.state.frf, 1) == 0x123 and
            csr64_fs_state(fmv_high.state.csr_m) == 3 and
            ((fmv_high.state.csr_s.sstatus >> 13) & 3) == 3 and
            (fmv_high.state.csr_s.sstatus & (1 << 63)) != 0).to_equal(true)

    it "protected CSRRW preserves fcsr routing":
        step("CSRRW updates the architectural fcsr")
        var fp2 = core64_init(RESET_PC)
        fp2.rf = regfile64_write(fp2.rf, 1, 0x123, true)
        fp2.rf = regfile64_write(fp2.rf, 5, 0x51, true)
        # Software enables FP (mstatus.FS = Initial) before issuing FP insns.
        fp2.csr_m.mstatus = fp2.csr_m.mstatus | (FS_INITIAL << 13)
        val fcsr_low = core64_cycle(fp2, true, true, false, 0x80D3)
        val fcsr_mid = core64_cycle(fcsr_low.state, true, true, false, 0xF200)
        val fcsr2_low = core64_cycle(fcsr_mid.state, true, true, false, 0x9073)
        val fcsr_high = core64_cycle(fcsr2_low.state, true, true, false, 0x0032)
        expect(fcsr_read_csr(fcsr_high.state.fcsr, 3) == 0x51 and
            csr64_fs_state(fcsr_high.state.csr_m) == 3 and
            fcsr_high.state.csr_m.minstret == 2).to_equal(true)
