# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/hardware/fpga_linux/synthesis_wrapper.spl 0%
"""
# Synthesis Wrapper VexRiscv-SMP Specification
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Draft
**Requirements:** REQ-3
**Artifacts:** N/A
## Operator workflow
Run `bin/simple test test/unit/lib/hardware/fpga_linux/synthesis_wrapper_vexriscv_spec.spl` and require the final Results line to report 0 failed.

## Overview

Verifies AC-3: synthesis_wrapper generates Vivado TCL for the K26
bitstream flow — creating the project against the xck26 part, adding
the RV64GC SoC sources, attaching the K26 constraint file, setting the
top module, and running synthesis through bitstream export.

Covers:
- AC-3 (Vivado TCL creates the K26 project with SoC sources, constraints, and synthesis runs)
## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

use std.spec.step

use std.spipe.*
use lib.hardware.fpga_linux.synthesis_wrapper.{generate_vivado_tcl_rv64}

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}

# ============================================================================
# AC-3: RV64GC source directives in the generated TCL
# ============================================================================

describe "Synthesis TCL RTL source directives":
    # @manual scenario evidence
    it "AC-3: TCL contains add_files directive for sources":
        # @req REQ-SSPEC-UNIT
        # @req REQ-3
        step("AC-3: TCL contains add_files directive for sources")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("add_files")

    it "AC-3: TCL contains the rv64gc core source":
        # @req REQ-SSPEC-UNIT
        # @req REQ-3
        step("AC-3: TCL contains the rv64gc core source")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("rv64gc_core.vhd")

    it "AC-3: TCL contains a VHDL source extension reference":
        # @req REQ-SSPEC-UNIT
        # @req REQ-3
        step("AC-3: TCL contains a VHDL source extension reference")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain(".vhd")


# ============================================================================
# AC-3: project setup directives in the generated TCL
# ============================================================================

describe "Synthesis TCL project setup directives":
    it "AC-3: TCL sets soc_top_rv64 as the top module":
        # @req REQ-SSPEC-UNIT
        # @req REQ-3
        step("AC-3: TCL sets soc_top_rv64 as the top module")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("set_property top soc_top_rv64")

    it "AC-3: TCL attaches the K26 constraint file to the constrs fileset":
        # @req REQ-SSPEC-UNIT
        # @req REQ-3
        step("AC-3: TCL attaches the K26 constraint file to the constrs fileset")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("constrs_1")


# ============================================================================
# AC-3: Base TCL generation still correct
# ============================================================================

describe "Synthesis TCL base correctness":
    it "AC-3: TCL contains create_project":
        # @req REQ-SSPEC-UNIT
        step("AC-3: TCL contains create_project")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("create_project")

    it "AC-3: TCL contains K26 part number":
        # @req REQ-SSPEC-UNIT
        step("AC-3: TCL contains K26 part number")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("xck26")

    it "AC-3: TCL contains launch_runs synth_1":
        # @req REQ-SSPEC-UNIT
        step("AC-3: TCL contains launch_runs synth_1")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("synth")

# ============================================================================
# Standard library comprehensive behavior (ported from origin/main)
# ============================================================================

describe "Standard library comprehensive behavior":
    it "text primitives agree on a fixed fixture":
        step("Verify: text primitives agree on a fixed fixture")
        # @req: REQ-LIB-LIB_GENERIC-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.replace("Language", "Runtime")).to_equal("Simple Runtime")  # oracle: substitution applies

    it "collections keep insertion order and value semantics":
        step("Verify: collections keep insertion order and value semantics")
        # @req: REQ-LIB-LIB_GENERIC-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows by one
        expect(original.len()).to_equal(2)  # oracle: the original binding is unmodified

    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits
