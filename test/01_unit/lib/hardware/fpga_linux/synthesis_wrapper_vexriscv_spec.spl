# @cover src/lib/hardware/fpga_linux/synthesis_wrapper.spl 0%
"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/lib/hardware/fpga_linux/synthesis_wrapper_vexriscv_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

use std.spipe.*
use lib.hardware.fpga_linux.synthesis_wrapper.{
    SynthesisProject,
    synthesis_project_default,
    add_verilog_sources,
    enable_axi_hp_port,
    generate_vivado_tcl_rv64
}

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

describe "Standard library comprehensive behavior":
    it "text primitives agree on a fixed fixture":
        step("Verify: text primitives agree on a fixed fixture")
        # @req: REQ-LIB-LIB_GENERIC-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.replace("Language", "Runtime")).to_equal("Simple Runtime")  # oracle: substitution applies

    it "collections keep insertion order and value semantics":
        step("Verify: collections keep insertion order and value semantics")
        # @req: REQ-LIB-LIB_GENERIC-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows by one
        expect(original.len()).to_equal(2)  # oracle: the original binding is unmodified

    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits

fn tcl_with_vexriscv() -> text:
    val proj = make_project_with_vexriscv()
    return generate_vivado_tcl_rv64()


# ============================================================================
# AC-3: add_verilog_sources output
# ============================================================================

describe "SynthesisProject add_verilog_sources":
    it "AC-3: TCL contains add_files directive for .v sources":
        val tcl = tcl_with_vexriscv()
        expect(tcl).to_contain("add_files")

    it "AC-3: TCL contains VexRiscv filename":
        val tcl = tcl_with_vexriscv()
        expect(tcl).to_contain("VexRiscv")

    it "AC-3: TCL contains .v extension reference":
        val tcl = tcl_with_vexriscv()
        expect(tcl).to_contain(".v")


# ============================================================================
# AC-3: enable_axi_hp_port output
# ============================================================================

describe "SynthesisProject enable_axi_hp_port":
    it "AC-3: TCL contains S_AXI_HP0 enable directive":
        val tcl = tcl_with_vexriscv()
        expect(tcl).to_contain("S_AXI_HP0")

    it "AC-3: TCL contains PSU__USE__S_AXI_GP key or HP config":
        val tcl = tcl_with_vexriscv()
        expect(tcl).to_contain("HP")


# ============================================================================
# AC-3: Base TCL generation still correct
# ============================================================================

describe "Synthesis TCL base correctness":
    it "AC-3: TCL contains create_project":
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("create_project")

    it "AC-3: TCL contains K26 part number":
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("xck26")

    it "AC-3: TCL contains launch_runs synth_1":
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("synth")
