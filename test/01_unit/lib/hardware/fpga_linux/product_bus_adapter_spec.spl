use std.spec.*
use lib.hardware.fpga_linux._SocVhdlGen.product_bus.{generate_rv64_product_wb_wrapper_vhdl}

describe "RV64 product-core Wishbone wrapper":
    it "adapts the real product handshake without embedding a parallel CPU":
        val vhdl = generate_rv64_product_wb_wrapper_vhdl()
        expect(vhdl).to_contain("entity work.core64_imac_product_entry")
        expect(vhdl).to_contain("type adapter_state_t is (idle, wishbone, respond)")
        expect(vhdl).to_contain("request_ready_b  <= '1' when adapter_state = idle")
        expect(vhdl).to_contain("response_valid_b <= '1' when adapter_state = respond")
        expect(vhdl).to_contain("wb_sel_o <= std_logic_vector(shift_left(mask, lane))")
        expect(vhdl).to_contain("wb_dat_o <= std_logic_vector(shift_left(unsigned(wdata_q), lane * 8))")
        expect(vhdl).to_contain("response_data_q <= signed(shift_right(unsigned(wb_dat_i), lane * 8))")
        expect(vhdl).to_contain("response_error_q <= to_bit(wb_err_i)")
        expect(vhdl).to_contain("wb_lock_o        <= to_stdulogic(atomic_q)")
        expect(vhdl).to_contain("reset_n => to_bit(not rst)")
        expect(vhdl.contains("architecture cpu")).to_equal(false)
