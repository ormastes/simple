# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-13
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @cover src/lib/hardware/fpga_linux/synthesis_wrapper.spl 0%
# @cover src/lib/hardware/fpga_linux/xdc_gen.spl 0%
# @cover src/lib/hardware/fpga_k26/k26_xdc.spl 0%
"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/lib/hardware/fpga_linux/fpga_synthesis_rv64_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

use std.spec.step

describe "Standard library comprehensive behavior":
    it "text primitives agree on a fixed fixture":
        step("Verify: text primitives agree on a fixed fixture")
        # @req: REQ-LIB-LIB_GENERIC-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.replace("Language", "Runtime")).to_equal("Simple Runtime")  # oracle: substitution applies

describe "K26 XDC Constraints":
    it "AC-4: k26_xdc generates constraint text":
        val xdc = k26_generate_xdc()
        val len = xdc.length()
        expect(len).to_be_greater_than(0)

    it "AC-4: XDC contains clock constraint":
        val xdc = k26_generate_xdc()
        expect(xdc).to_contain("create_clock")

    it "AC-4: XDC contains UART TX pin":
        # @req REQ-SSPEC-LIB
        step("AC-4: XDC contains UART TX pin")
        val xdc = k26_generate_xdc()
        expect(xdc).to_contain("uart_tx")

    it "AC-4: XDC contains UART RX pin":
        # @req REQ-SSPEC-LIB
        step("AC-4: XDC contains UART RX pin")
        val xdc = k26_generate_xdc()
        expect(xdc).to_contain("uart_rx")

    it "AC-4: XDC contains reset pin":
        # @req REQ-SSPEC-LIB
        step("AC-4: XDC contains reset pin")
        val xdc = k26_generate_xdc()
        expect(xdc).to_contain("rst")

    it "AC-4: XDC contains JTAG pin constraint":
        # @req REQ-SSPEC-LIB
        step("AC-4: XDC contains JTAG pin constraint")
        val xdc = k26_generate_xdc()
        expect(xdc).to_contain("jtag")


# ============================================================================
# AC-4: XDC Generation via xdc_gen
# ============================================================================

describe "XDC Generator":
    it "AC-4: xdc_gen produces valid XDC format":
        # @req REQ-SSPEC-LIB
        step("AC-4: xdc_gen produces valid XDC format")
        val xdc = generate_xdc_constraints()
        expect(xdc).to_contain("set_property")

    it "AC-4: xdc_gen includes PACKAGE_PIN assignments":
        # @req REQ-SSPEC-LIB
        step("AC-4: xdc_gen includes PACKAGE_PIN assignments")
        val xdc = generate_xdc_constraints()
        expect(xdc).to_contain("PACKAGE_PIN")

    it "AC-4: xdc_gen includes IOSTANDARD":
        # @req REQ-SSPEC-LIB
        step("AC-4: xdc_gen includes IOSTANDARD")
        val xdc = generate_xdc_constraints()
        expect(xdc).to_contain("IOSTANDARD")


# ============================================================================
# AC-5: Vivado TCL Script Generation (REQ-13)
# ============================================================================

describe "Synthesis Wrapper TCL":
    it "AC-5: synthesis TCL contains create_project":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL contains create_project")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("create_project")

    it "AC-5: synthesis TCL contains add_files for VHDL sources":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL contains add_files for VHDL sources")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("add_files")

    it "AC-5: synthesis TCL sets correct FPGA part for K26":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL sets correct FPGA part for K26")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("xck26")

    it "AC-5: synthesis TCL sets top entity":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL sets top entity")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("set_property top")

    it "AC-5: synthesis TCL launches synthesis run":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL launches synthesis run")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("launch_runs synth_1")

    it "AC-5: synthesis TCL launches implementation run":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL launches implementation run")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("launch_runs impl_1")

    it "AC-5: synthesis TCL generates bitstream":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL generates bitstream")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("write_bitstream")

    it "AC-5: synthesis TCL includes XDC constraint file":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL includes XDC constraint file")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain(".xdc")

    it "AC-5: synthesis TCL includes RV64 core VHDL source":
        # @req REQ-SSPEC-LIB
        step("AC-5: synthesis TCL includes RV64 core VHDL source")
        val tcl = generate_vivado_tcl_rv64()
        expect(tcl).to_contain("rv64gc")
