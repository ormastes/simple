use std.spec.*
use lib.hardware.fpga_linux._SocVhdlGen.peripherals.{generate_wb_interconnect_vhdl_rv64}
use lib.hardware.fpga_linux._SocVhdlGen.top_testbench.{generate_soc_top_vhdl_rv64_external_ddr}

describe "RV64 generated product SoC selection":
    it "selects the compiler-emitted core wrapper and terminates bus errors":
        val top = generate_soc_top_vhdl_rv64_external_ddr()
        val interconnect = generate_wb_interconnect_vhdl_rv64()
        expect(top).to_contain("entity work.rv64gc_core_product_wb")
        expect(top.contains("entity work.rv64gc_core\n")).to_equal(false)
        expect(top).to_contain("ddr_wb_lock_o <= wb_lock")
        expect(top).to_contain("ddr_wb_err_i : in  std_logic")
        expect(top).to_contain("m_ack => wb_ack, m_err => wb_err")
        expect(interconnect).to_contain("m_err   : out std_logic")
        expect(interconnect).to_contain("s4_err  : in  std_logic")
        expect(interconnect).to_contain("sel_bootrom and m_we")
        expect(interconnect).to_contain("not (sel_bootrom or sel_clint or")
