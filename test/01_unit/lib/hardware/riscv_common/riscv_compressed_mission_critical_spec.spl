"""
## Purpose and audience
Purpose: Prove that mission-critical compressed subset boundary.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-HARDWARE-001 — stable requirement identity for this spec.

use std.spec.*
use std.hardware.riscv_common.isa.compressed.zca_seed.{
    COMPRESSED_REASON_NONE, COMPRESSED_REASON_NOT_COMPRESSED,
    COMPRESSED_REASON_RESERVED_ENCODING, COMPRESSED_REASON_RESERVED_ZERO,
    COMPRESSED_REASON_UNSUPPORTED_ZCA_SEED, CompressedCriticalSubsetManifest,
    riscv_zca_mission_critical_expand_hardware
}
use std.hardware.riscv_common.isa.isa_database.{
    riscv_zca_critical_subset_entries, riscv_zca_critical_subset_entry_count,
    riscv_zca_target_rtl_evidence, riscv_zca_target_rtl_evidence_count,
    riscv_zca_critical_subset_has_entry, riscv_zca_integer_entries_for_xlen,
    riscv_zca_target_rtl_has_entry, riscv_zca_target_rtl_has_contract
}
use std.hardware.rv32i_rtl.c_extension.{rv32c_expand_mission_critical}
use std.hardware.rv64gc_rtl.decode.{rvc_expand_mission_critical}
use compiler.common.mission_critical.riscv_zca_contracts.{riscv_zca_strict_contracts, riscv_zca_strict_isa_id, riscv_zca_strict_row_label}

use std.spec.step

describe "mission-critical compressed subset boundary":
    it "refuses to advertise full Zca before the remaining proof obligations":
        step("Verify: refuses to advertise full Zca before the remaining proof obligations")
        # @req: REQ-LIB-HARDWARE-001
        val manifest = CompressedCriticalSubsetManifest.mission_critical_common_zca_v1()
        expect(manifest.subset_id).to_equal("zca-common-integer-v1")
        expect(manifest.extension_name).to_equal("Zca")
        expect(manifest.advertises_extension).to_be(false)
        expect(manifest.legacy_fallback_allowed).to_be(false)
        expect(manifest.exhaustive_classification_required).to_be(true)
        expect(manifest.target_rtl_equivalence_required).to_be(true)
        expect(manifest.exhaustive_classification_verified).to_be(false)
        expect(manifest.target_rtl_equivalence_verified).to_be(false)
        expect(manifest.row_target_evidence_complete).to_be(false)
        expect(manifest.has_complete_row_target_evidence()).to_be(false)
        expect(manifest.verified_entry_count).to_equal(riscv_zca_critical_subset_entry_count())
        expect(manifest.target_rtl_equivalent_entry_count).to_equal(riscv_zca_target_rtl_evidence_count())
        expect(manifest.is_release_claimable()).to_be(false)

    it "uses one declarative table for every critical common-Zca capability":
        step("Verify: uses one declarative table for every critical common-Zca capability")
        val entries = riscv_zca_critical_subset_entries()
        expect(entries.len()).to_equal(25)  # oracle: 25 — named expected value from the requirement
        for entry in entries:
            expect(entry.extension).to_equal("Zca")
            expect(entry.critical_subset_eligible).to_be(true)
            expect(entry.id.starts_with("zca.c.")).to_be(true)

    it "derives target-RTL capability truth from an explicit evidence catalog":
        step("Verify: derives target-RTL capability truth from an explicit evidence catalog")
        val evidence = riscv_zca_target_rtl_evidence()
        expect(evidence.len()).to_equal(25)  # oracle: 25 — named expected value from the requirement
        for entry in evidence:
            expect(entry.id.starts_with("zca.c.")).to_be(true)
            expect(entry.strict_contract != "").to_be(true)
            expect(riscv_zca_critical_subset_has_entry(entry.id)).to_be(true)
            expect(riscv_zca_target_rtl_has_entry(entry.id)).to_be(true)
            if entry.strict_contract != "terminal-decode-cebreak":
                expect(riscv_zca_strict_isa_id(entry.strict_contract)).to_equal(entry.id)
        expect(riscv_zca_target_rtl_has_entry("zca.c.add")).to_be(true)
        expect(riscv_zca_target_rtl_has_entry("zca.c.addi16sp")).to_be(true)
        expect(riscv_zca_target_rtl_has_entry("zca.c.lui")).to_be(true)
        expect(riscv_zca_target_rtl_has_entry("zca.c.j")).to_be(true)
        expect(riscv_zca_target_rtl_has_entry("zca.c.beqz")).to_be(true)
        expect(riscv_zca_target_rtl_has_entry("zca.c.bnez")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_cadd_row_v1")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_caddi16sp_row_v1")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_clui_row_v1")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_cj_predecode_v1")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_cbeqz_predecode_v1")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_cbnez_predecode_v1")).to_be(true)
        expect(riscv_zca_target_rtl_has_contract("__simple_riscv_zca_addi16sp_row_v1")).to_be(true)

    it "uses the same canonical strict contract for lowering and capability evidence":
        step("Verify: uses the same canonical strict contract for lowering and capability evidence")
        val contracts = riscv_zca_strict_contracts()
        expect(contracts.len()).to_be_greater_than(19)
        expect(riscv_zca_strict_row_label("__simple_riscv_zca_cadd_row_v1")).to_equal("C.ADD")
        expect(riscv_zca_strict_isa_id("__simple_riscv_zca_cadd_row_v1")).to_equal("zca.c.add")
        expect(riscv_zca_strict_row_label("__simple_riscv_zca_cbeqz_predecode_v1")).to_equal("C.BEQZ")
        expect(riscv_zca_strict_isa_id("__simple_riscv_zca_cbnez_predecode_v1")).to_equal("zca.c.bnez")
        expect(riscv_zca_strict_row_label("__simple_riscv_zca_addi16sp_row_v1")).to_equal("C.ADDI16SP")
        for contract in contracts:
            expect(contract.isa_id.starts_with("zca.c.")).to_be(true)
            expect(contract.row_label != "").to_be(true)

    it "accepts only verified common rows and never invokes a legacy fallback":
        step("Verify: accepts only verified common rows and never invokes a legacy fallback")
        val ebreak32 = rv32c_expand_mission_critical(0x9002)
        val addi64 = rvc_expand_mission_critical(0x0505)
        val unsupported32 = rv32c_expand_mission_critical(0x2085)
        val unsupported64 = rvc_expand_mission_critical(0x2085)
        expect(ebreak32.illegal).to_be(false)
        expect(ebreak32.instruction).to_equal(0x00100073)
        expect(addi64.legal).to_be(true)
        expect(addi64.insn).to_equal(0x00150513)
        # Q1/funct3=001 is RV32 C.JAL but RV64 C.ADDIW: the critical common
        # subset must reject it rather than use either legacy decoder.
        expect(unsupported32.illegal).to_be(true)
        expect(unsupported64.legal).to_be(false)

    it "preserves distinct hardware failure reasons with no illegal payload":
        step("Verify: preserves distinct hardware failure reasons with no illegal payload")
        val zero = riscv_zca_mission_critical_expand_hardware(0x0000)
        val uncompressed = riscv_zca_mission_critical_expand_hardware(0x0013)
        val reserved = riscv_zca_mission_critical_expand_hardware(0x0004)
        # Q1/funct3=001 is C.JAL on RV32 and C.ADDIW on RV64, so it is
        # deliberately outside this common, text-free boundary.
        val width_divergent = riscv_zca_mission_critical_expand_hardware(0x2085)
        expect(zero.legal).to_be(false)
        expect(zero.canonical_instruction).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(zero.length_bytes).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(zero.reason_code).to_equal(COMPRESSED_REASON_RESERVED_ZERO)
        expect(uncompressed.legal).to_be(false)
        expect(uncompressed.canonical_instruction).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(uncompressed.reason_code).to_equal(COMPRESSED_REASON_NOT_COMPRESSED)
        expect(reserved.legal).to_be(false)
        expect(reserved.canonical_instruction).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(reserved.reason_code).to_equal(COMPRESSED_REASON_RESERVED_ENCODING)
        expect(width_divergent.legal).to_be(false)
        expect(width_divergent.canonical_instruction).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(width_divergent.reason_code).to_equal(COMPRESSED_REASON_UNSUPPORTED_ZCA_SEED)

    it "keeps profile capability claims narrower than RV32 or RV64 decoder support":
        step("Verify: keeps profile capability claims narrower than RV32 or RV64 decoder support")
        val rv32_entries = riscv_zca_integer_entries_for_xlen(32)
        val rv64_entries = riscv_zca_integer_entries_for_xlen(64)
        var rv32_jal = 0
        var rv64_jal = 0
        var rv32_addiw = 0
        var rv64_addiw = 0
        for entry in rv32_entries:
            if entry.id == "zca.c.jal":
                rv32_jal = rv32_jal + 1
            if entry.id == "zca.c.addiw":
                rv32_addiw = rv32_addiw + 1
        for entry in rv64_entries:
            if entry.id == "zca.c.jal":
                rv64_jal = rv64_jal + 1
            if entry.id == "zca.c.addiw":
                rv64_addiw = rv64_addiw + 1
        expect(rv32_jal).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rv64_jal).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(rv32_addiw).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(rv64_addiw).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(riscv_zca_critical_subset_has_entry("zca.c.jal")).to_be(false)
        expect(riscv_zca_critical_subset_has_entry("zca.c.addiw")).to_be(false)
        val manifest = CompressedCriticalSubsetManifest.mission_critical_common_zca_v1()
        expect(manifest.advertises_extension).to_be(false)
        expect(manifest.is_release_claimable()).to_be(false)

    it "passes through an uncompressed RV64 word without pretending it is Zca":
        step("Verify: passes through an uncompressed RV64 word without pretending it is Zca")
        val normal = rvc_expand_mission_critical(0x00100013)
        expect(normal.compressed).to_be(false)
        expect(normal.legal).to_be(true)
        expect(normal.insn).to_equal(0x00100013)

    it "exhaustively classifies every 16-bit parcel deterministically":
        step("Verify: exhaustively classifies every 16-bit parcel deterministically")
        var parcel: u32 = 0
        while parcel < 65536:
            val first = riscv_zca_mission_critical_expand_hardware(parcel)
            val second = riscv_zca_mission_critical_expand_hardware(parcel)
            expect(first.original_parcel).to_equal(parcel)
            expect(first.original_parcel).to_equal(second.original_parcel)
            expect(first.canonical_instruction).to_equal(second.canonical_instruction)
            expect(first.length_bytes).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(first.legal).to_equal(second.legal)
            expect(first.reason_code).to_equal(second.reason_code)
            if first.legal:
                expect(first.canonical_instruction != 0).to_be(true)
                expect(first.reason_code).to_equal(COMPRESSED_REASON_NONE)
            else:
                expect(first.canonical_instruction).to_equal(0)  # oracle: 0 — named expected value from the requirement
            parcel = parcel + 1
