"""
## Purpose and audience
Purpose: Prove that shared RISC-V compressed Zca seed.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-HARDWARE-001 — stable requirement identity for this spec.

use lib.hardware.riscv_common.isa.compressed.zca_seed.{
    COMPRESSED_REASON_RESERVED_ZERO, riscv_compressed_is_parcel,
    riscv_zca_expand_rv32_hardware, riscv_zca_expand_rv64_hardware,
    riscv_zca_seed_expand, riscv_zca_seed_expand_hardware
}
use lib.hardware.riscv_common.isa.isa_database.{
    riscv_zca_integer_entries, riscv_zca_integer_entries_for_xlen
}

use std.spec.step

describe "shared RISC-V compressed Zca seed":
    it "preserves C.EBREAK as a legal two-byte canonical EBREAK":
        step("Verify: preserves C.EBREAK as a legal two-byte canonical EBREAK")
        # @req: REQ-LIB-HARDWARE-001
        val expanded = riscv_zca_seed_expand(0x9002, 32)
        expect(expanded.legal).to_equal(true)
        expect(expanded.length_bytes).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(expanded.canonical_instruction).to_equal(0x00100073)
        expect(expanded.required_extensions).to_equal("Zca")

    it "canonicalizes C.NOP and C.ADDI identically for RV32 and RV64":
        step("Verify: canonicalizes C.NOP and C.ADDI identically for RV32 and RV64")
        val nop32 = riscv_zca_seed_expand(0x0001, 32)
        val addi64 = riscv_zca_seed_expand(0x0505, 64)
        expect(nop32.legal).to_equal(true)
        expect(nop32.canonical_instruction).to_equal(0x00000013)
        expect(addi64.legal).to_equal(true)
        expect(addi64.canonical_instruction).to_equal(0x00150513)

    it "fails closed for zero, non-compressed, and RV64-only parcels on RV32":
        step("Verify: fails closed for zero, non-compressed, and RV64-only parcels on RV32")
        val zero = riscv_zca_seed_expand(0x0000, 32)
        val normal = riscv_zca_seed_expand(0x0013, 32)
        val ld32 = riscv_zca_seed_expand(0x6000, 32)
        expect(zero.legal).to_equal(false)
        expect(zero.illegal_reason).to_equal("reserved_zero_encoding")
        expect(normal.legal).to_equal(false)
        expect(normal.illegal_reason).to_equal("not_compressed_parcel")
        expect(ld32.legal).to_equal(false)
        expect(ld32.illegal_reason).to_equal("rv64_only_form")
        expect(riscv_compressed_is_parcel(0x0001)).to_equal(true)
        expect(riscv_compressed_is_parcel(0x0013)).to_equal(false)

    it "keeps synthesizable adapter state free of text diagnostics":
        step("Verify: keeps synthesizable adapter state free of text diagnostics")
        val hardware = riscv_zca_seed_expand_hardware(0x0000)
        expect(hardware.legal).to_equal(false)
        expect(hardware.reason_code).to_equal(COMPRESSED_REASON_RESERVED_ZERO)
        expect(hardware.length_bytes).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "shares common integer load-store, immediate, and branch rows":
        step("Verify: shares common integer load-store, immediate, and branch rows")
        expect(riscv_zca_seed_expand_hardware(0x0040).canonical_instruction).to_equal(0x00410413)
        expect(riscv_zca_seed_expand_hardware(0x4188).canonical_instruction).to_equal(0x0005A503)
        expect(riscv_zca_seed_expand_hardware(0xC0C0).canonical_instruction).to_equal(0x0084A223)
        expect(riscv_zca_seed_expand_hardware(0x557D).canonical_instruction).to_equal(0xFFF00513)
        expect(riscv_zca_seed_expand_hardware(0x4512).canonical_instruction).to_equal(0x00412503)
        expect(riscv_zca_seed_expand_hardware(0xC22A).canonical_instruction).to_equal(0x00A12223)

    it "shares common arithmetic, register, and indirect-control rows":
        step("Verify: shares common arithmetic, register, and indirect-control rows")
        expect(riscv_zca_seed_expand_hardware(0x6105).canonical_instruction).to_equal(0x02010113)
        expect(riscv_zca_seed_expand_hardware(0x6605).canonical_instruction).to_equal(0x00001637)
        expect(riscv_zca_seed_expand_hardware(0x8005).canonical_instruction).to_equal(0x00145413)
        expect(riscv_zca_seed_expand_hardware(0x8405).canonical_instruction).to_equal(0x40145413)
        expect(riscv_zca_seed_expand_hardware(0x9861).canonical_instruction).to_equal(0xFF847413)
        expect(riscv_zca_seed_expand_hardware(0x8C05).canonical_instruction).to_equal(0x40940433)
        expect(riscv_zca_seed_expand_hardware(0x8C25).canonical_instruction).to_equal(0x00944433)
        expect(riscv_zca_seed_expand_hardware(0x8C45).canonical_instruction).to_equal(0x00946433)
        expect(riscv_zca_seed_expand_hardware(0x8C65).canonical_instruction).to_equal(0x00947433)
        expect(riscv_zca_seed_expand_hardware(0x050E).canonical_instruction).to_equal(0x00351513)
        expect(riscv_zca_seed_expand_hardware(0x8502).canonical_instruction).to_equal(0x00050067)
        expect(riscv_zca_seed_expand_hardware(0x852E).canonical_instruction).to_equal(0x00B00533)
        expect(riscv_zca_seed_expand_hardware(0x9502).canonical_instruction).to_equal(0x000500E7)
        expect(riscv_zca_seed_expand_hardware(0x952E).canonical_instruction).to_equal(0x00B50533)

    it "selects RV32 and RV64 differences by separate fixed-width entrypoints":
        step("Verify: selects RV32 and RV64 differences by separate fixed-width entrypoints")
        val rv32_jal = riscv_zca_expand_rv32_hardware(0x2085)
        val rv64_addiw = riscv_zca_expand_rv64_hardware(0x2085)
        expect(rv32_jal.legal).to_be(true)
        expect(rv32_jal.canonical_instruction & 0x7F).to_equal(0x6F)
        expect(rv64_addiw.legal).to_be(true)
        expect(rv64_addiw.canonical_instruction & 0x7F).to_equal(0x1B)
        # RV32 reserves shamt[5]; the RV64 specialization retains it.
        expect(riscv_zca_expand_rv32_hardware(0x1082).legal).to_be(false)
        expect(riscv_zca_expand_rv64_hardware(0x1082).legal).to_be(true)

    it "keeps the complete implemented integer Zca capability truth in one table":
        step("Verify: keeps the complete implemented integer Zca capability truth in one table")
        val all = riscv_zca_integer_entries()
        val rv32 = riscv_zca_integer_entries_for_xlen(32)
        val rv64 = riscv_zca_integer_entries_for_xlen(64)
        expect(all.len()).to_equal(33)  # oracle: 33 — named expected value from the requirement
        expect(rv32.len()).to_equal(26)  # oracle: 26 — named expected value from the requirement
        expect(rv64.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(riscv_zca_integer_entries_for_xlen(128).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        var rv32_jal_count = 0
        var rv64_word_count = 0
        for entry in all:
            if entry.id == "zca.c.jal" and entry.xlen_scope == "rv32":
                rv32_jal_count = rv32_jal_count + 1
            if entry.semantic_class == "integer-word" and entry.xlen_scope == "rv64":
                rv64_word_count = rv64_word_count + 1
        expect(rv32_jal_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rv64_word_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
