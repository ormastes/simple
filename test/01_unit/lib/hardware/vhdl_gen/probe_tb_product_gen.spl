# Runnable probe for the product-core testbench generator — generates the three
# tb_*.vhd product testbenches, byte-compares each against its on-disk golden,
# and proves determinism by generating each a second time.
#
# False-green guards (a previous probe in this family reported PASS while
# generating nothing): before any comparison this asserts the expected file
# COUNT and that every generated text is non-empty and multi-line. An empty
# string compared against an unreadable golden must never read as PASS.
#
# Run: bin/simple run test/01_unit/lib/hardware/vhdl_gen/probe_tb_product_gen.spl

use std.hardware.vhdl_gen.tb_product_gen.{generate_product_tb, product_tb_paths, generate_tb_rv32_product_sv32_pmp, generate_tb_rv64_product_sv39_pmp, generate_tb_rv64_product_wb_axi}

extern fn rt_file_read_text(path: text) -> text

val EXPECTED_FILES: i64 = 3
val MIN_BYTES: i64 = 500

fn first_diff(a: text, b: text) -> i64:
    var n = a.len()
    if b.len() < n:
        n = b.len()
    var i = 0
    while i < n:
        if a[i] != b[i]:
            return i
        i = i + 1
    if a.len() == b.len():
        return -1
    n

fn window(s: text, at: i64) -> text:
    var lo = at - 100
    if lo < 0:
        lo = 0
    var hi = at + 60
    if hi > s.len():
        hi = s.len()
    s.substring(lo, hi)

fn count_lines(s: text) -> i64:
    s.split("\n").len() - 1

fn check(name: text, ok: bool) -> i64:
    if ok:
        print("PASS " + name)
        return 0
    print("FAIL " + name)
    1

fn check_golden(path: text, generated: text) -> i64:
    val golden = rt_file_read_text(path)
    if golden.len() < MIN_BYTES:
        print("FAIL " + path + " golden unreadable or too small (" + golden.len().to_text() + " bytes)")
        return 1
    if generated == golden:
        print("PASS " + path + " byte-identical (" + generated.len().to_text()
            + " bytes, " + count_lines(generated).to_text() + " lines)")
        return 0
    print("FAIL " + path + " (gen " + generated.len().to_text()
        + " bytes vs golden " + golden.len().to_text() + " bytes)")
    val d = first_diff(generated, golden)
    print("  first difference at byte " + d.to_text())
    print("  GEN    |" + window(generated, d) + "|")
    print("  GOLDEN |" + window(golden, d) + "|")
    1

fn main():
    var fails = 0

    # --- false-green guards, BEFORE any golden comparison ---------------
    val paths = product_tb_paths()
    fails = fails + check("file count == " + EXPECTED_FILES.to_text()
        + " (got " + paths.len().to_text() + ")", paths.len() == EXPECTED_FILES)

    var texts: [text] = []
    var i = 0
    while i < paths.len():
        texts = texts.push(generate_product_tb(paths[i]))
        i = i + 1
    i = 0
    var nonempty = 0
    while i < texts.len():
        val t = texts[i]
        if t.len() >= MIN_BYTES and count_lines(t) > 10:
            nonempty = nonempty + 1
        else:
            print("  generated text " + i.to_text() + " is empty/degenerate ("
                + t.len().to_text() + " bytes, " + count_lines(t).to_text() + " lines)")
        i = i + 1
    fails = fails + check("all " + EXPECTED_FILES.to_text()
        + " generated texts non-empty and multi-line (got " + nonempty.to_text() + ")",
        nonempty == EXPECTED_FILES)

    # The by-path dispatcher and the direct entry points must agree, so a
    # silently-unmatched path cannot pass as an empty string.
    fails = fails + check("dispatch matches direct entry (sv32)",
        texts[0] == generate_tb_rv32_product_sv32_pmp())
    fails = fails + check("dispatch matches direct entry (sv39)",
        texts[1] == generate_tb_rv64_product_sv39_pmp())
    fails = fails + check("dispatch matches direct entry (wb_axi)",
        texts[2] == generate_tb_rv64_product_wb_axi())

    # --- golden byte-comparison -----------------------------------------
    i = 0
    while i < paths.len():
        fails = fails + check_golden(paths[i], texts[i])
        i = i + 1

    # --- determinism: a second generation pass must be byte-identical ----
    i = 0
    var stable = 0
    while i < paths.len():
        if generate_product_tb(paths[i]) == texts[i]:
            stable = stable + 1
        i = i + 1
    fails = fails + check("determinism (regenerate all " + EXPECTED_FILES.to_text() + ")",
        stable == EXPECTED_FILES)

    if fails == 0:
        print("TB_PRODUCT PROBE: ALL PASS")
    else:
        print("TB_PRODUCT PROBE: " + fails.to_text() + " FAILURES")
