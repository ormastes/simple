# Runnable probe mirror of exec_core_gen_spec.spl — prints per-stage PASS/FAIL
# and a final ALL PASS marker. Run: bin/simple run test/01_unit/lib/hardware/vhdl_gen/probe_exec_core_gen.spl

use lib.hardware.riscv_common.xlen.XlenConfig
use lib.hardware.vhdl_gen.exec_core_gen.{generate_exec_core, generate_rv32_exec_core, generate_rv64_exec_core}

extern fn rt_file_read_text(path: text) -> text

fn check(name: text, ok: bool) -> i64:
    if ok:
        print("PASS " + name)
        0
    else:
        print("FAIL " + name)
        1

fn main():
    var fails = 0
    val g32 = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/rv32_exec_core.vhd")
    val g64 = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/rv64_exec_core.vhd")
    val a32 = generate_rv32_exec_core("")
    val a64 = generate_rv64_exec_core("")
    fails = fails + check("rv32 golden byte-match (len " + a32.len().to_text() + " vs " + g32.len().to_text() + ")", a32 == g32)
    fails = fails + check("rv64 golden byte-match (len " + a64.len().to_text() + " vs " + g64.len().to_text() + ")", a64 == g64)
    val b32 = generate_rv32_exec_core("")
    val b64 = generate_rv64_exec_core("")
    fails = fails + check("determinism rv32", a32 == b32)
    fails = fails + check("determinism rv64", a64 == b64)
    val off32 = generate_exec_core(XlenConfig.rv32(), "", false)
    val off64 = generate_exec_core(XlenConfig.rv64(), "", false)
    fails = fails + check("aspect-off drops dbg ports rv32", not off32.contains("dbg_reg_addr"))
    fails = fails + check("aspect-off drops dbg ports rv64", not off64.contains("dbg_reg_addr"))
    fails = fails + check("aspect-on keeps dbg ports", a32.contains("dbg_reg_addr") and a64.contains("dbg_reg_addr"))
    val prefixed = generate_exec_core(XlenConfig.rv32(), "/tmp/fw/", true)
    fails = fails + check("mem prefix applied", prefixed.contains("is \"/tmp/fw/rv32_payload.mem\";"))
    if fails == 0:
        print("EXEC_CORE_GEN PROBE: ALL PASS")
    else:
        print("EXEC_CORE_GEN PROBE: " + fails.to_text() + " FAILURES")
