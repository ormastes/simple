# Runnable probe for the SoC-top generator — byte-compares each generated
# SoC-top RTL file against its golden and proves determinism (two generations
# must be byte-identical).
#
# Run: bin/simple run test/01_unit/lib/hardware/vhdl_gen/probe_soc_top_gen.spl

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.soc_top_gen.{generate_soc_top_board, generate_soc_top_k26_ddr, generate_soc_top_sim, generate_soc_top_tiny_bram}

extern fn rt_file_read_text(path: text) -> text

val RTL_DIR: text = "examples/09_embedded/fpga_riscv/rtl/"

fn first_diff(a: text, b: text) -> text:
    val la = a.split("\n")
    val lb = b.split("\n")
    var n = la.len()
    if lb.len() < n:
        n = lb.len()
    var i = 0
    var out = "line counts " + la.len().to_text() + " gen vs " + lb.len().to_text() + " golden"
    var found = false
    while i < n:
        if not found and la[i] != lb[i]:
            found = true
            out = out + "\n      first diff at line " + (i + 1).to_text()
            out = out + "\n        gen: [" + la[i] + "]"
            out = out + "\n        gld: [" + lb[i] + "]"
        i = i + 1
    out

fn check_file(name: text, made: text) -> i64:
    val golden = rt_file_read_text(RTL_DIR + name)
    if made == golden:
        print("PASS " + name + " (" + made.len().to_text() + " bytes byte-identical)")
        0
    else:
        print("FAIL " + name + " — " + first_diff(made, golden))
        1

fn main():
    var fails = 0
    val b32 = generate_soc_top_board(XlenConfig.rv32())
    val b64 = generate_soc_top_board(XlenConfig.rv64())
    val d32 = generate_soc_top_k26_ddr(XlenConfig.rv32())
    val d64 = generate_soc_top_k26_ddr(XlenConfig.rv64())
    val s32 = generate_soc_top_sim(XlenConfig.rv32())
    val s64 = generate_soc_top_sim(XlenConfig.rv64())
    val t32 = generate_soc_top_tiny_bram()

    fails = fails + check_file("soc_top_rv32.vhd", b32)
    fails = fails + check_file("soc_top_rv64.vhd", b64)
    fails = fails + check_file("soc_top_rv32_k26_ddr.vhd", d32)
    fails = fails + check_file("soc_top_rv64_k26_ddr.vhd", d64)
    fails = fails + check_file("soc_top_rv32_sim.vhd", s32)
    fails = fails + check_file("soc_top_rv64_sim.vhd", s64)
    fails = fails + check_file("soc_top_rv32_tiny_bram.vhd", t32)

    # Determinism: regenerate everything and require byte-equality.
    var det = 0
    if generate_soc_top_board(XlenConfig.rv32()) != b32:
        det = det + 1
    if generate_soc_top_board(XlenConfig.rv64()) != b64:
        det = det + 1
    if generate_soc_top_k26_ddr(XlenConfig.rv32()) != d32:
        det = det + 1
    if generate_soc_top_k26_ddr(XlenConfig.rv64()) != d64:
        det = det + 1
    if generate_soc_top_sim(XlenConfig.rv32()) != s32:
        det = det + 1
    if generate_soc_top_sim(XlenConfig.rv64()) != s64:
        det = det + 1
    if generate_soc_top_tiny_bram() != t32:
        det = det + 1
    if det == 0:
        print("PASS determinism (7/7 files byte-identical on regeneration)")
    else:
        print("FAIL determinism (" + det.to_text() + " files differ on regeneration)")
        fails = fails + det

    if fails == 0:
        print("SOC_TOP_GEN PROBE: ALL PASS")
    else:
        print("SOC_TOP_GEN PROBE: " + fails.to_text() + " FAILURES")
