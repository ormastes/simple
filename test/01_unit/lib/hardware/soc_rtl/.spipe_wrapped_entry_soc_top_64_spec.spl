# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-8
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spipe.*
use std.hardware.soc_rtl.*

val SOC64_TEST_DRAM_SIZE: i64 = 0x1000

fn wb64_make_qemu_virt_regions() -> [WbRegion64]:
    # Helper to construct the standard QEMU virt memory map regions
    # This will be provided by the implementation module
    return wb64_qemu_virt_regions()
fn main():
    # @cover src/lib/hardware/soc_rtl/soc_top_64.spl 0%
    # @cover src/lib/hardware/soc_rtl/ram64.spl 0%
    # @cover src/lib/hardware/soc_rtl/wb64_interconnect.spl 0%
    """
    # RV64GC SoC Top-Level Integration Specification
    
    **Feature IDs:** rv64-fpga-linux-boot
    **Category:** Infrastructure
    **Difficulty:** 4/5
    **Status:** Draft
    **Requirements:** REQ-8, REQ-9
    **Research:** doc/01_research/domain/riscv_fpga_linux.md
    **Artifacts:** N/A
    
    ## Overview
    
    Tests for the RV64GC SoC top-level: memory map address constants
    (QEMU virt profile), wishbone64 interconnect address decode, RAM64
    read/write round-trip, and SoC peripheral integration.
    
    Covers: AC-3 (SOC top-level integrates core + CLINT + PLIC + UART16550
    + RAM + bootrom with correct memory map)
    
    ## Compiled-Mode Notes
    
    Memory map constant checks and RAM64 read/write round-trips are
    interpreter-safe. Full SoC tick simulation (core64_step + peripheral
    updates + interrupt routing) requires compiled mode.
    """


    # ============================================================================
    # AC-3: QEMU Virt Memory Map Constants (REQ-9)
    # ============================================================================

    describe "RV64 SoC Memory Map (QEMU virt)":
        it "AC-3: CLINT range decode answers 0x200_0000":
            # @req REQ-SSPEC-LIB
            # @req REQ-9
            step("AC-3: CLINT range decode answers 0x200_0000")
            expect soc64_in_clint(0x200_0000) == true
            expect soc64_in_clint(0x1000) == false

        it "AC-3: PLIC range decode answers 0xC00_0000":
            # @req REQ-SSPEC-LIB
            # @req REQ-9
            step("AC-3: PLIC range decode answers 0xC00_0000")
            expect soc64_in_plic(0xC00_0000) == true
            expect soc64_in_plic(0x200_0000) == false

        it "AC-3: UART range decode answers 0x1000_0000":
            # @req REQ-SSPEC-LIB
            # @req REQ-9
            step("AC-3: UART range decode answers 0x1000_0000")
            expect soc64_in_uart(0x1000_0000) == true
            expect soc64_in_uart(0xC00_0000) == false

        it "AC-3: DRAM range decode answers 0x8000_0000":
            # @req REQ-SSPEC-LIB
            # @req REQ-9
            step("AC-3: DRAM range decode answers 0x8000_0000")
            val soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            expect soc64_in_ram(soc, 0x8000_0000) == true
            expect soc64_in_ram(soc, 0x1000) == false

        it "AC-3: bootrom fetch at reset vector serves boot ROM data":
            # @req REQ-SSPEC-LIB
            # @req REQ-8
            step("AC-3: bootrom fetch at reset vector serves boot ROM data")
            val soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            val insn = soc64_fetch(soc, 0x1000)
            expect insn != 0


    # ============================================================================
    # AC-3: SoC Top Initialization (REQ-8)
    # ============================================================================

    describe "SocTop64 Initialization":
        it "AC-3: soc_top_64_init creates state with specified DRAM size":
            # @req REQ-SSPEC-LIB
            step("AC-3: soc_top_64_init creates state with specified DRAM size")
            val soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            expect soc.ram.size == SOC64_TEST_DRAM_SIZE

        it "AC-3: soc_top_64_init wires core with QEMU virt reset vector":
            # @req REQ-SSPEC-LIB
            step("AC-3: soc_top_64_init wires core with QEMU virt reset vector")
            val soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            expect soc.core.pc == 0x1000

        it "AC-3: soc_top_64_init starts core in M-mode":
            # @req REQ-SSPEC-LIB
            step("AC-3: soc_top_64_init starts core in M-mode")
            val soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            expect soc.core.priv_mode == 3


    # ============================================================================
    # AC-3: RAM64 Read/Write Round-Trip
    # ============================================================================

    describe "Ram64 Operations":
        it "AC-3: ram64_init allocates memory of specified size":
            # @req REQ-SSPEC-LIB
            step("AC-3: ram64_init allocates memory of specified size")
            val ram = ram64_init(0x1000)
            expect ram.size == 0x1000

        it "AC-3: ram64 byte write and read round-trip":
            # @req REQ-SSPEC-LIB
            step("AC-3: ram64 byte write and read round-trip")
            var ram = ram64_init(0x1000)
            ram = ram64_write(ram, 0, 1, 0xAB)
            val result = ram64_read(ram, 0, 1)
            expect result == 0xAB

        it "AC-3: ram64 halfword write and read round-trip":
            # @req REQ-SSPEC-LIB
            step("AC-3: ram64 halfword write and read round-trip")
            var ram = ram64_init(0x1000)
            ram = ram64_write(ram, 0, 2, 0xABCD)
            val result = ram64_read(ram, 0, 2)
            expect result == 0xABCD

        it "AC-3: ram64 word write and read round-trip":
            # @req REQ-SSPEC-LIB
            step("AC-3: ram64 word write and read round-trip")
            var ram = ram64_init(0x1000)
            ram = ram64_write(ram, 0, 4, 0xDEAD_BEEF)
            val result = ram64_read(ram, 0, 4)
            expect result == 0xDEAD_BEEF

        it "AC-3: ram64 doubleword write and read round-trip":
            # @req REQ-SSPEC-LIB
            step("AC-3: ram64 doubleword write and read round-trip")
            var ram = ram64_init(0x1000)
            ram = ram64_write(ram, 0, 8, 0xDEAD_BEEF_CAFE_BABE)
            val result = ram64_read(ram, 0, 8)
            expect result == 0xDEAD_BEEF_CAFE_BABE

        it "AC-3: ram64_load_binary loads data at offset":
            # @req REQ-SSPEC-LIB
            step("AC-3: ram64_load_binary loads data at offset")
            var ram = ram64_init(0x1000)
            val data = [0x13, 0x00, 0x00, 0x00]
            ram = ram64_load_binary(ram, 0x100, data)
            val result = ram64_read(ram, 0x100, 4)
            expect result == 0x13


    # ============================================================================
    # AC-3: Wishbone64 Interconnect Address Decode (REQ-9)
    # ============================================================================

    describe "Wb64Interconnect Address Decode":
        it "AC-3: wb64_init accepts region list":
            # @req REQ-SSPEC-LIB
            step("AC-3: wb64_init accepts region list")
            val regions = wb64_make_qemu_virt_regions()
            val ic = wb64_init(regions)
            expect ic.region_count > 0

        it "AC-3: wb64_request to DRAM range returns ack":
            # @req REQ-SSPEC-LIB
            step("AC-3: wb64_request to DRAM range returns ack")
            val regions = wb64_make_qemu_virt_regions()
            val ic = wb64_init(regions)
            val resp = wb64_request(ic, 0x8000_0000, 0, false, 0xFF)
            expect resp.ack == true

        it "AC-3: wb64_request to UART range returns ack":
            # @req REQ-SSPEC-LIB
            step("AC-3: wb64_request to UART range returns ack")
            val regions = wb64_make_qemu_virt_regions()
            val ic = wb64_init(regions)
            val resp = wb64_request(ic, 0x1000_0000, 0, false, 0xFF)
            expect resp.ack == true

        it "AC-3: wb64_request to unmapped address returns err":
            # @req REQ-SSPEC-LIB
            step("AC-3: wb64_request to unmapped address returns err")
            val regions = wb64_make_qemu_virt_regions()
            val ic = wb64_init(regions)
            val resp = wb64_request(ic, 0xFFFF_FFFF, 0, false, 0xFF)
            expect resp.err == true


    # ============================================================================
    # AC-3: SoC Tick (compiled mode for full verification)
    # ============================================================================

    describe "SocTop64 Tick":
        it "AC-3: soc_top_64_tick advances the core PC":
            # @req REQ-SSPEC-LIB
            step("AC-3: soc_top_64_tick advances the core PC")
            var soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            val initial_pc = soc.core.pc
            soc = soc_top_64_tick(soc)
            expect soc.core.pc == initial_pc + 4

        it "AC-3: soc_top_64_tick updates clint mtime":
            # @req REQ-SSPEC-LIB
            step("AC-3: soc_top_64_tick updates clint mtime")
            var soc = soc_top_64_init(SOC64_TEST_DRAM_SIZE)
            soc = soc_top_64_tick(soc)
            expect soc.clint.mtime == 1


    # ============================================================================
    # Helper: Build QEMU virt memory map regions
    # ============================================================================
