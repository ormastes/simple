# CUDA Native ProfileTarget — behavioral spec (plan stream P7).
#
# These are REAL calls against the real implementation, not source-text
# assertions: every `it` constructs a CudaNativeProfileTarget and drives it,
# or exercises the plausibility rule directly.
#
# Honesty anchors this spec enforces:
#   * `device_ns` is PROFILE_ABSENT (-1), never 0, on every failure path.
#     0 is a legitimate measurement and would read as "instantaneous device
#     work" -- the exact confusion the tiered contract exists to prevent.
#   * `Native` is claimed ONLY when a real cuEvent measurement was obtainable.
#     No host clock is ever relabeled as device time.
#   * THE CROSS-CHECK: the host window strictly encloses the device window
#     (the host clock is read before cuEventRecord(start) and after
#     cuEventSynchronize(end)), so a sound measurement always satisfies
#     device_ns <= wall_ns + tolerance. The ms/ns mis-scaling that
#     cuEventElapsedTime invites (it returns MILLISECONDS) inflates device_ns
#     by 1e6 and is caught by exactly this rule -- asserted below on both
#     sides, so the rule cannot be vacuously true.
#
# Host-aware: the live-device block runs only where cuEvent timing is really
# obtainable. Where it is not, the target must report Unavailable -- which is
# itself asserted, so "no GPU" cannot silently mean "nothing was checked".

use std.spec.{describe, it, expect}
use std.common.debug.capability.{CapLevel, cap_level_name}
use std.common.debug.profile_target.{PROFILE_ABSENT, profile_has_steps, profile_has_device_time}
use std.common.debug.session_core.{AttachOpts, attach_opts_default}
use std.gc_async_mut.gpu_lane.cuda_native_profile.{CudaNativeProfileTarget, CUDA_NATIVE_TOLERANCE_NS, cuda_native_plausible, cuda_native_events_available}

describe "CudaNativeProfileTarget plausibility rule":
    it "accepts a device window shorter than the enclosing host window":
        expect(cuda_native_plausible(1000, 5000)).to_equal(true)

    it "accepts a device window equal to the host window":
        expect(cuda_native_plausible(5000, 5000)).to_equal(true)

    it "accepts slack up to the tolerance, for unrelated clock oscillators":
        expect(cuda_native_plausible(5000 + CUDA_NATIVE_TOLERANCE_NS, 5000)).to_equal(true)

    it "REJECTS a device window that outlasts the host window beyond tolerance":
        expect(cuda_native_plausible(5000 + CUDA_NATIVE_TOLERANCE_NS + 1, 5000)).to_equal(false)

    it "REJECTS the millisecond/nanosecond mis-scaling of cuEventElapsedTime":
        # cuEventElapsedTime returns MILLISECONDS. Forgetting the ms->ns
        # conversion inflates device_ns by 1e6. A 2ms device window inside a
        # 3ms host window is plausible; the same number left unscaled is not.
        val wall_ns = 3000000
        val device_ns_correct = 2000000
        val device_ns_misscaled = 2000000 * 1000000
        expect(cuda_native_plausible(device_ns_correct, wall_ns)).to_equal(true)
        expect(cuda_native_plausible(device_ns_misscaled, wall_ns)).to_equal(false)

describe "CudaNativeProfileTarget arming":
    it "reports Unavailable when profiling was not armed at attach":
        val t = CudaNativeProfileTarget.disarmed_target()
        expect(cap_level_name(t.profile_level())).to_equal("unavailable")

    it "takes its arming from AttachOpts.profile, not from a later toggle":
        val unarmed = CudaNativeProfileTarget.new(AttachOpts(step_budget: 10, entry_pc: 0, log_cap: 8, profile: false))
        expect(cap_level_name(unarmed.profile_level())).to_equal("unavailable")

describe "CudaNativeProfileTarget honest absence":
    it "an unarmed target reports every quantity absent, never zero":
        var t = CudaNativeProfileTarget.disarmed_target()
        t.profile_begin()
        val r = t.profile_end()
        expect(cap_level_name(r.level)).to_equal("unavailable")
        expect(r.device_ns).to_equal(PROFILE_ABSENT)
        expect(r.wall_ns).to_equal(PROFILE_ABSENT)
        expect(r.steps).to_equal(PROFILE_ABSENT)
        expect(profile_has_device_time(r)).to_equal(false)

    it "an unarmed target's device_ns is -1 and specifically NOT 0":
        var t = CudaNativeProfileTarget.disarmed_target()
        t.profile_begin()
        val r = t.profile_end()
        expect(r.device_ns == 0).to_equal(false)
        expect(r.device_ns).to_equal(PROFILE_ABSENT)

    it "profile_end without a matching profile_begin never fabricates a number":
        var t = CudaNativeProfileTarget.armed_target()
        val r = t.profile_end()
        expect(cap_level_name(r.level)).to_equal("unavailable")
        expect(r.device_ns).to_equal(PROFILE_ABSENT)
        expect(profile_has_device_time(r)).to_equal(false)

    it "never reports steps: cuEvent times a launch, it does not count instructions":
        var t = CudaNativeProfileTarget.armed_target()
        t.profile_begin()
        val r = t.profile_end()
        expect(profile_has_steps(r)).to_equal(false)
        expect(r.steps).to_equal(PROFILE_ABSENT)

describe "CudaNativeProfileTarget live device timing":
    it "claims Native only where real cuEvent timing is obtainable":
        val t = CudaNativeProfileTarget.armed_target()
        val available = cuda_native_events_available()
        if available:
            expect(cap_level_name(t.profile_level())).to_equal("native")
        else:
            # No GPU / no cuEvent: Unavailable is the CORRECT outcome, and is
            # asserted so that a device-less host still checks something.
            expect(cap_level_name(t.profile_level())).to_equal("unavailable")

    it "measures a real device window enclosed by the host window":
        if not cuda_native_events_available():
            # Host-aware skip, with the reason asserted rather than silent.
            expect(cuda_native_events_available()).to_equal(false)
        else:
            var t = CudaNativeProfileTarget.armed_target()
            t.profile_begin()
            val r = t.profile_end()
            expect(cap_level_name(r.level)).to_equal("native")
            # A real measurement: present, non-negative, and NOT the absent
            # sentinel.
            expect(profile_has_device_time(r)).to_equal(true)
            expect(r.device_ns >= 0).to_equal(true)
            expect(r.device_ns == PROFILE_ABSENT).to_equal(false)
            # wall_ns is always measured, so it is the cross-check.
            expect(r.wall_ns >= 0).to_equal(true)
            # THE PLAUSIBILITY ASSERTION: device time must not exceed the
            # enclosing host time beyond measurement noise.
            expect(r.device_ns <= r.wall_ns + CUDA_NATIVE_TOLERANCE_NS).to_equal(true)
            t.release()

    it "reports device_ns and wall_ns from independent clocks, both present":
        if not cuda_native_events_available():
            expect(cuda_native_events_available()).to_equal(false)
        else:
            var t = CudaNativeProfileTarget.armed_target()
            t.profile_begin()
            val r = t.profile_end()
            expect(r.device_ns >= 0).to_equal(true)
            expect(r.wall_ns >= 0).to_equal(true)
            expect(cuda_native_plausible(r.device_ns, r.wall_ns)).to_equal(true)
            t.release()
