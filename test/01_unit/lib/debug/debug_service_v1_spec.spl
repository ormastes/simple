use std.spec.{describe, it, expect}
use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugCapabilityV1, DebugTargetNodeV1, DebugVerificationV1,
    DebugPerturbationV1, DebugRootOperationV1, debug_policy_observe_only_v1,
    debug_wire_v1,
}
use std.common.debug.service_v1.{DebugServiceV1}

fn result_is_ok<T>(result: Result<T, text>) -> bool:
    match result:
        case Ok(_): true
        case Err(_): false

fn option_is_some<T>(value: Option<T>) -> bool:
    match value:
        case Some(_): true
        case None: false

describe "DebugServiceV1":
    it "owns sessions by id and binds their graph to an exact build":
        var service = DebugServiceV1.create()
        val opened = service.open_observe_session("build-sha256:abc")
        expect(result_is_ok(opened)).to_equal(true)
        val session_id = opened!
        val added = service.add_target(
            session_id,
            DebugTargetNodeV1(target_id: "host", parent_target_id: "", kind: "process", label: "host process"),
            DebugCapabilityV1(
                target_id: "host",
                support: CapLevel.Native,
                verification: DebugVerificationV1.FixtureVerified,
                perturbation: DebugPerturbationV1.Passive,
                reason: "fixture",
            ),
        )
        expect(result_is_ok(added)).to_equal(true)
        val graph = service.graph(session_id)
        expect(option_is_some(graph)).to_equal(true)
        expect(graph!.build_id).to_equal("build-sha256:abc")
        expect(graph!.nodes.len()).to_equal(1)
        expect(service.session_count()).to_equal(1)

    it "denies control and mutation under observe-only policy and receipts both actions":
        var service = DebugServiceV1.create()
        val session_id = service.open_session("build-1", debug_policy_observe_only_v1())!
        val control = service.authorize(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, "continue")
        val mutation = service.authorize(session_id, DebugRootOperationV1.Probe, DebugPerturbationV1.Mutating, "write-memory")
        expect(control.allowed).to_equal(false)
        expect(control.reason).to_equal("control denied by policy")
        expect(mutation.allowed).to_equal(false)
        expect(mutation.reason).to_equal("mutation denied by policy")
        expect(service.receipt_count()).to_equal(3)

    it "rejects sessions without exact build identity":
        var service = DebugServiceV1.create()
        val opened = service.open_observe_session("  ")
        expect(result_is_ok(opened)).to_equal(false)
        expect(service.session_count()).to_equal(0)

    it "uses an explicit stable DebugWireV1 version":
        val wire = debug_wire_v1("request-1", "debug-1", "domain", "sql", "explain", "QueryDebugV1", "{}")
        expect(wire.version).to_equal("debug-wire-v1")
        expect(wire.domain).to_equal("sql")
        expect(wire.command).to_equal("explain")
