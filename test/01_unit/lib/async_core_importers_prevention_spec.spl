# Prevention: every module that imports `std.async_core` may only import names
# that async_core actually exports (bug: async_host_missing_async_core_module).
# Guards the class "importer references a name its vocabulary module lacks".

extern fn rt_file_read_text(path: text) -> text?

fn core_src(path: text) -> text:
    rt_file_read_text("src/lib/nogc_async_mut/" + path) ?? ""

fn import_names(src: text) -> [text]:
    var names: [text] = []
    for line in src.split("\n"):
        if line.starts_with("use std.async_core.{"):
            val inner = line.replace("use std.async_core.{", "").replace("}", "")
            for n in inner.split(","):
                names.push(n.trim())
    names

describe "async_core importers prevention":
    it "exports every name any importer asks for":
        val core = core_src("async_core.spl")
        expect(core.len() > 0).to_equal(true)
        val files = ["async_embedded.spl", "async_host.spl", "async_unified.spl",
            "async_host/combinators.spl", "async_host/future.spl", "async_host/handle.spl",
            "async_host/joinset.spl", "async_host/promise.spl", "async_host/runtime.spl",
            "async_host/scheduler.spl", "async_host/unordered.spl"]
        var missing: [text] = []
        var checked = 0
        for f in files:
            val src = core_src(f)
            for name in import_names(src):
                checked = checked + 1
                val declared = core.contains("enum " + name + ":") or core.contains("export use ") and core.contains("{" + name + "}")
                if not declared:
                    missing.push(f + ":" + name)
        expect(checked > 10).to_equal(true)
        expect(missing.len()).to_equal(0)
