# string_char_code_at_o_index_fallback_on_non_ascii_text_2026-08-28
#
# `text.char_code_at(i)` must return the actual Unicode codepoint at
# CHARACTER index i even when multi-byte content sits at or before i (the
# runtime's ASCII-fast-path fallback must not leak byte offsets, O, or -1
# into the result). `text.char_at(i)` must return the actual character.
# Covers 2-byte (é), 3-byte (日), 4-byte (emoji) shapes, positions after
# multi-byte content, and out-of-range behavior.

describe "string char/code-at on non-ASCII text":
    it "char_code_at returns codepoints past a 2-byte codepoint":
        val s = "héllo"
        expect(s.len()).to_equal(6)
        expect(s.char_code_at(0)).to_equal(104)
        expect(s.char_code_at(1)).to_equal(233)
        expect(s.char_code_at(2)).to_equal(108)
        expect(s.char_code_at(3)).to_equal(108)
        expect(s.char_code_at(4)).to_equal(111)

    it "char_code_at returns codepoints for 3-byte CJK text":
        val t = "日本語"
        expect(t.len()).to_equal(9)
        expect(t.char_code_at(0)).to_equal(26085)
        expect(t.char_code_at(1)).to_equal(26412)
        expect(t.char_code_at(2)).to_equal(35486)

    it "char_code_at handles 4-byte emoji and mixed content":
        val e = "a\u{1F600}b"
        expect(e.char_code_at(0)).to_equal(97)
        expect(e.char_code_at(1)).to_equal(128512)
        expect(e.char_code_at(2)).to_equal(98)

    it "char_at returns the actual character, not a byte or fallback":
        val s = "héllo"
        expect(s.char_at(1)).to_equal("é")
        expect("日本語".char_at(0)).to_equal("日")
        expect("日本語".char_at(2)).to_equal("語")

    it "out-of-range and negative indexes return 0, not a byte remnant":
        val s = "héllo"
        expect(s.char_code_at(5)).to_equal(0)
        expect(s.char_code_at(99)).to_equal(0)
        expect(s.char_code_at(-1)).to_equal(0)
