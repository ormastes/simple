# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB

# Regression for doc/08_tracking/bug/noalloc_decorator_unbound_in_seed_interpreter_2026-08-08.md
#
# `@noalloc` used to be treated by the Rust seed interpreter as a Python-style
# runtime decorator: an unrecognised `@X` on a function evaluated the bare
# identifier `X` against the module env. `@noalloc` was not on the skip-list,
# so ANY module carrying it failed at load time under `bin/simple test`
# (`error: semantic: variable noalloc not found`, "no examples executed"),
# even though the identical import worked fine under `bin/simple run`
# (the JIT path never evaluates decorator expressions, so it never saw it).
#
# This spec imports a real stdlib module that carries `@noalloc`
# (`src/lib/nogc_async_mut_noalloc/hash/mod.spl`) by its full path — no
# facade, no `export use` re-export involved — and calls one of its
# functions. If `@noalloc` is ever unwired again, this fails at MODULE LOAD
# (dropped, "no examples executed"), not as an ordinary assertion failure.
#
# No equivalent spec previously existed: the bug's own doc named
# `test/unit/lib/zz_noalloc_direct_probe_spec.spl`, which was never
# committed to the tree (verified 2026-09-06, repo-wide grep).

use std.spec.*
use std.nogc_async_mut_noalloc.hash.{fnv1a_hash_i64}

describe "a module carrying @noalloc loads under bin/simple test":
    it "resolves and calls a function from an @noalloc-annotated module":
        # @req REQ-SSPEC-LIB
        val h = fnv1a_hash_i64(42)
        expect(h != 0).to_be_true()
