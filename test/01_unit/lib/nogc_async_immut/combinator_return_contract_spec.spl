use std.spec
use std.nogc_async_immut.combinators.{pfilter}

fn greater_than_six(x):
    x > 6

describe "immutable combinator return contract":
    it "returns the accumulated array for a named predicate":
        expect(pfilter([5, 6, 7, 8], greater_than_six)).to_equal([7, 8])

    it "returns the accumulated array for an explicit lambda":
        expect(pfilter([5, 6, 7, 8], \x: x > 6)).to_equal([7, 8])

    it "returns the accumulated array for placeholder lambda grammar":
        expect(pfilter([5, 6, 7, 8], _1 > 6)).to_equal([7, 8])
