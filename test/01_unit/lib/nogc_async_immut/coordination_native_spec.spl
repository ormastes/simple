"""
## Purpose and audience
Purpose: Verify nogc_async_immut coordination native behavior.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-COORDINATION-NATIVE-001 — stable requirement identity for this spec.

use std.nogc_async_immut.{
    Atom, Ref, VersionedSnapshot,
    cas_compare_and_set, cas_loop, cas_swap_value
}
use std.nogc_sync_mut.atomic.{MemoryOrdering, atomic_i64_new}

use std.spec.step

describe "nogc_async_immut coordination native behavior":
    it "runs atom compare-and-set and version updates":
        step("Verify: runs atom compare-and-set and version updates")
        # @req: REQ-LIB-COORDINATION-NATIVE-001
        var atom = Atom.new(10)

        expect(atom.version()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(atom.compare_and_set(9, 11)).to_equal(false)
        expect(atom.deref()).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(atom.version()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        expect(atom.compare_and_set(10, 11)).to_equal(true)
        expect(atom.deref()).to_equal(11)  # oracle: authoritative expected value documented by this spec's contract
        expect(atom.version()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        expect(atom.swap(\x: x + 4)).to_equal(15)  # oracle: authoritative expected value documented by this spec's contract
        expect(atom.swap_returning_old(\x: x * 2)).to_equal(15)  # oracle: authoritative expected value documented by this spec's contract
        expect(atom.deref()).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
        expect(atom.version()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "runs validated ref transitions through the atom backend":
        step("Verify: runs validated ref transitions through the atom backend")
        var ref = Ref.new(4, _1 >= 0)

        expect(ref.deref()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
        expect(ref.compare_and_set(4, -1)).to_equal(false)
        expect(ref.deref()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
        expect(ref.compare_and_set(4, 6)).to_equal(true)
        expect(ref.deref()).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

        val rejected = ref.swap_validated(_1 - 100)
        expect(rejected[0]).to_equal(false)
        expect(rejected[1]).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
        expect(ref.deref()).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

        val accepted = ref.swap_validated(_1 + 1)
        expect(accepted[0]).to_equal(true)
        expect(accepted[1]).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract
        expect(ref.deref()).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract

    it "keeps bounded versioned snapshot history":
        step("Verify: keeps bounded versioned snapshot history")
        var snapshot = VersionedSnapshot.with_history("v0", 2)

        snapshot.update("v1")
        snapshot.update("v2")

        expect(snapshot.current()).to_equal("v2")
        expect(snapshot.version()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(snapshot.version_count()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(snapshot.has_version(0)).to_equal(false)
        expect(snapshot.at_version(1)).to_equal("v1")

        val frozen = snapshot.snapshot()
        expect(frozen.get_version()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(frozen.get()).to_equal("v2")

    it "runs exported CAS helpers on no-GC sync atomics":
        step("Verify: runs exported CAS helpers on no-GC sync atomics")
        val atomic = atomic_i64_new(3)

        expect(cas_compare_and_set(atomic, 2, 9)).to_equal(false)
        expect(atomic.load(MemoryOrdering.SeqCst)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(cas_compare_and_set(atomic, 3, 9)).to_equal(true)
        expect(atomic.load(MemoryOrdering.SeqCst)).to_equal(9)  # oracle: authoritative expected value documented by this spec's contract

        expect(cas_loop(atomic, _1 + 1, 3)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(cas_swap_value(atomic, 12)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(atomic.load(MemoryOrdering.SeqCst)).to_equal(12)  # oracle: authoritative expected value documented by this spec's contract
