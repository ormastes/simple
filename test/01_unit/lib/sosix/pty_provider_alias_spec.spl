"""The generic hosted SOSIX PTY facade preserves the selected provider contract.

These calls need no live child or PTY. In particular, a missing capability
alias must fail execution rather than silently skip the layout caller.
"""
use std.spec.*
use std.sosix.pty.{sosix_pty_can_resize, sosix_pty_resize,
    sosix_pty_write_some, sosix_pty_input_pending,
    sosix_pty_cleanup_pending, sosix_pty_exit_code}
use std.sys.pty.{can_resize as provider_can_resize}

describe "hosted SOSIX PTY provider aliases":
    it "reports the selected provider resize capability":
        expect(sosix_pty_can_resize()).to_equal(provider_can_resize())

    it "refuses resize and partial writes on an invalid handle":
        expect(sosix_pty_resize(-1, 24, 80)).to_equal(false)
        expect(sosix_pty_write_some(-1, [65, 0, 255])).to_equal(-1)

    it "preserves errors from input completion and exit queries":
        expect(sosix_pty_input_pending(-1).is_err()).to_equal(true)
        expect(sosix_pty_exit_code(-1).is_err()).to_equal(true)

    it "exposes the provider teardown sweep":
        expect(sosix_pty_cleanup_pending()).to_be_greater_than(-1)
