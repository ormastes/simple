# @req: REQ-LIB-LIB-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/branch_coverage_2_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_2.md
# doc-path: doc/03_plan/sys_test/branch_coverage_2.md
# doc-path: doc/04_architecture/branch_coverage_2.md
# doc-path: doc/05_design/branch_coverage_2.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "match Some binds the payload":
        step("Verify: match Some binds the payload")
        # @req: REQ-LIB-LIB-001
        var r = 0
        match Some(5):
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(5)  # oracle: payload bound

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "for loop over empty range runs zero times":
        step("Verify: for loop over empty range runs zero times")
        # @req: REQ-LIB-LIB-001
        var c = 5
        for i in 2..2:
            c = c + 1
        expect(c).to_equal(5)  # oracle: body never entered

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "nested conditionals evaluate inner guard independently":
        step("Verify: nested conditionals evaluate inner guard independently")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if true:
            if false:
                r = 1
            else:
                r = 2
        expect(r).to_equal(2)  # oracle: outer true, inner false

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken
