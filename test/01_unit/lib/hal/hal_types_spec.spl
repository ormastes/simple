"""
# Typed HAL Capsules Specification

**Feature IDs:** #hw-access-optimization-infra
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Draft
**Plan:** doc/03_plan/sys_test/mcdc_rt_hal_hardening.md
**Artifacts:** N/A

## Purpose and audience

Validates the typed HAL capsule module at src/lib/nogc_sync_mut/hal/ with
MmioAddress, PhysAddress, DmaAddress, IrqLine types and volatile read/write
operations. Uses composition-only design per D-7. Audience: HAL and
baremetal-lane owners.

## Operator workflow

Run
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/lib/hal/hal_types_spec.spl`.
Every scenario must pass up to the first hardware touch; see the NOTE below
on the known macOS SEGV in the MMIO read scenario.

## Behavior

- MmioAddress wraps base + offset + RegisterWidth
- PhysAddress wraps u64 with alignment utilities
- DmaAddress wraps PhysAddress + size, delegates to std.io.dma
- IrqLine wraps u32, IrqConfig holds trigger and priority
- Volatile ops delegate to std.io.volatile_ops

## Compatibility and limitations

The mmio_read scenario issues a real volatile read at 0x40000000; on hosts
without that mapping (macOS) the run aborts there — a documented platform
limitation of exercising physical addresses on a hosted OS.

## Verification guidance and troubleshooting

Rerun the command above on the target hardware (or QEMU board lane) for the
MMIO scenarios; constructor, alignment, IRQ-config, and DMA-contract
scenarios are host-independent and must pass everywhere. A failure in a
constructor scenario is a regression in the typed capsule module.
"""

use std.spec
use std.spec.step
use std.hal.types.{RegisterWidth, MmioAddress, mmio_address}
use std.hal.types.{PhysAddress, phys_address, phys_to_u64, phys_is_aligned, phys_offset}
use std.hal.types.{DmaAddress, dma_address}
use std.hal.types.{IrqTrigger, IrqLine, irq_line, IrqConfig, irq_config}
use std.hal.volatile.{mmio_read_u32, mmio_write_u32, mmio_read_with_barrier}
use std.hal.irq.{irq_enable, irq_is_pending}
use std.hal.dma_contract.{dma_address_alloc}
use std.io.dma.{DmaDir}

# ============================================================================
# AC-5: MmioAddress typed capsule
# ============================================================================

describe "MmioAddress":
    describe "mmio_address constructor":
        it "AC-5: creates MmioAddress with base, offset, and width":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): decoded base and offset fields of the capsule
            step("Construct an MmioAddress at 0x40000000 and decode its fields")
            val addr = mmio_address(0x40000000, 0x10, RegisterWidth.Width32)

            expect(addr.base).to_equal(0x40000000)
            expect(addr.offset).to_equal(0x10)

        it "AC-5: RegisterWidth enum has all four widths":
            # @req REQ-HAL-TYPES-001
            # @capture(bit_table): RegisterWidth member identity check
            step("Name all four register widths and compare Width32 to itself")
            val w8 = RegisterWidth.Width8
            val w16 = RegisterWidth.Width16
            val w32 = RegisterWidth.Width32
            val w64 = RegisterWidth.Width64

            val is_w32 = w32 == RegisterWidth.Width32
            expect(is_w32).to_equal(true)

    describe "mmio_read":
        # NOTE (2026-09-05, pre-existing defect): this scenario SEGVs the run
        # on macOS (exit 139) because mmio_read_u32 issues a real volatile
        # read at 0x40000000, which has no host mapping. The scenario is kept
        # unchanged; it belongs on the board/QEMU lane.
        it "AC-5: mmio_read_u32 returns a u32 value":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): value read from the mapped MMIO register
            step("Read a u32 from the mapped MMIO register at 0x40000000")
            val addr = mmio_address(0x40000000, 0x00, RegisterWidth.Width32)
            val value = mmio_read_u32(addr)

            # Just verify call completes and returns some value
            val is_valid = value >= 0
            expect(is_valid).to_equal(true)

    describe "mmio_write":
        it "AC-5: mmio_write_u32 accepts MmioAddress and value":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): effective address the write targets
            step("Write 0xDEADBEEF through the capsule and decode the target address")
            val addr = mmio_address(0x40000000, 0x04, RegisterWidth.Width32)
            val value = 0xDEADBEEF
            val effective = addr.base + addr.offset

            # Write should not error — just call it
            mmio_write_u32(addr, value)

            expect(effective).to_equal(0x40000004)

    describe "mmio_read_with_barrier":
        it "AC-5: read with barrier returns u64":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): barrier-ordered read value
            step("Read a u64 through the barrier-ordered accessor")
            val addr = mmio_address(0x40000000, 0x00, RegisterWidth.Width64)
            val value = mmio_read_with_barrier(addr)

            val is_valid = value >= 0
            expect(is_valid).to_equal(true)


# ============================================================================
# AC-5: PhysAddress typed capsule
# ============================================================================

describe "PhysAddress":
    describe "phys_address constructor":
        it "AC-5: wraps a u64 address":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): round-trip of the wrapped physical address
            step("Wrap 0x80000000 in a PhysAddress and read it back as u64")
            val addr = phys_address(0x80000000)

            val raw = phys_to_u64(addr)
            expect(raw).to_equal(0x80000000)

    describe "phys_is_aligned":
        it "AC-5: returns true for page-aligned address":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): alignment verdict for a page-aligned address
            step("Check 4 KiB alignment of 0x1000")
            val addr = phys_address(0x1000)
            val aligned = phys_is_aligned(addr, 4096)

            expect(aligned).to_equal(true)

        it "AC-5: returns false for unaligned address":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): alignment verdict for an off-by-one address
            step("Check 4 KiB alignment of 0x1001")
            val addr = phys_address(0x1001)
            val aligned = phys_is_aligned(addr, 4096)

            expect(aligned).to_equal(false)

    describe "phys_offset":
        it "AC-5: adds offset to physical address":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): offset arithmetic on the physical capsule
            step("Add 0x100 to a PhysAddress and read the raw result")
            val addr = phys_address(0x1000)
            val offset_addr = phys_offset(addr, 0x100)

            val raw = phys_to_u64(offset_addr)
            expect(raw).to_equal(0x1100)


# ============================================================================
# AC-5: DmaAddress typed capsule
# ============================================================================

describe "DmaAddress":
    describe "dma_address constructor":
        it "AC-5: wraps PhysAddress and size":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): size field of the DMA capsule
            step("Wrap a physical address and a 4 KiB size in a DmaAddress")
            val phys = phys_address(0x2000)
            val dma = dma_address(phys, 4096)

            expect(dma.size).to_equal(4096)  # oracle: the scenario constructs the DMA region with an explicit 4096-byte size

    describe "dma_address_alloc":
        it "AC-5: allocates a DMA region of given size":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): allocation verdict for a 4 KiB ToDevice region
            step("Allocate a 4 KiB device-direction DMA region")
            val result = dma_address_alloc(4096, DmaDir.ToDevice)

            val is_ok = result.is_ok()
            expect(is_ok).to_equal(true)


# ============================================================================
# AC-5: IrqLine typed capsule
# ============================================================================

describe "IrqLine":
    describe "irq_line constructor":
        it "AC-5: wraps a u32 interrupt number":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): interrupt number decoded from the capsule
            step("Wrap interrupt line 33 and decode its number")
            val line = irq_line(33)

            expect(line.number).to_equal(33)  # oracle: the scenario constructs the line explicitly with interrupt number 33

    describe "irq_config":
        it "AC-5: creates config with line, trigger, and priority":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): priority decoded from the IRQ config
            step("Build an IRQ config for line 33 with priority 5")
            val line = irq_line(33)
            val config = irq_config(line, IrqTrigger.EdgeRising, 5)

            expect(config.priority).to_equal(5)  # oracle: the scenario constructs the config explicitly with priority 5

    describe "IrqTrigger":
        it "AC-5: enum has all four trigger modes":
            # @req REQ-HAL-TYPES-001
            # @capture(bit_table): IrqTrigger member identity check
            step("Name all four trigger modes and compare EdgeRising to itself")
            val lh = IrqTrigger.LevelHigh
            val ll = IrqTrigger.LevelLow
            val er = IrqTrigger.EdgeRising
            val ef = IrqTrigger.EdgeFalling

            val is_edge = er == IrqTrigger.EdgeRising
            expect(is_edge).to_equal(true)

    describe "irq_enable and irq_disable":
        it "AC-5: irq_enable returns a Result":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): enable verdict for a level-high line config
            step("Enable a level-high IRQ config and read the verdict")
            val line = irq_line(33)
            val config = irq_config(line, IrqTrigger.LevelHigh, 1)
            val result = irq_enable(config)

            val is_ok = result.is_ok()
            expect(is_ok).to_equal(true)

        it "AC-5: irq_is_pending returns bool":
            # @req REQ-HAL-TYPES-001
            # @capture(statistics): pending verdict type for line 33
            step("Poll line 33 for a pending interrupt")
            val line = irq_line(33)
            val pending = irq_is_pending(line)

            # Just verify it returns a boolean (either true or false)
            val is_bool = pending == true or pending == false
            expect(is_bool).to_equal(true)
