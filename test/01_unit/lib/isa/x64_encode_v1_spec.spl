# @cover src/lib/common/isa/x64_encode_v1.spl
# @req REQ-XRAY-SHARED-ISA-ENCODE
"""
# Shared x86-64 immediate encoders

The little-endian imm32 writer and the rel32 range check that the XRay
x86-64 trampoline twin, the sled template and the native backend's emit_i32
all repeated. Byte buffers are `[i64]` because that is what the backend and
the trampoline twin emit into.
"""
use std.spec.*
use std.common.isa.x64_encode_v1.*

describe "x86-64 shared immediate encoders":
    it "appends an imm32 little-endian, two's complement for negatives":
        expect(x64_push_imm32_le_v1([0xE8], 272)).to_equal([0xE8, 0x10, 0x01, 0x00, 0x00])
        expect(x64_push_imm32_le_v1([], -1)).to_equal([0xFF, 0xFF, 0xFF, 0xFF])
        expect(x64_push_imm32_le_v1([], -2147483648)).to_equal([0x00, 0x00, 0x00, 0x80])
        expect(x64_push_imm32_le_v1([], 2147483647)).to_equal([0xFF, 0xFF, 0xFF, 0x7F])
        expect(x64_push_imm32_le_v1([], 0xDEADBEEF)).to_equal([0xEF, 0xBE, 0xAD, 0xDE])
        # The backend's emit_i64_bytes feeds `value % 2^32`, which can be negative.
        expect(x64_push_imm32_le_v1([], -4294967295)).to_equal([0x01, 0x00, 0x00, 0x00])

    it "checks a rel32 displacement against the signed 32-bit range":
        expect(x64_rel32_in_range_v1(2147483647)).to_equal(true)
        expect(x64_rel32_in_range_v1(2147483648)).to_equal(false)
        expect(x64_rel32_in_range_v1(-2147483648)).to_equal(true)
        expect(x64_rel32_in_range_v1(-2147483649)).to_equal(false)
        expect(X64_REL32_MAX_FORWARD_V1).to_equal(2147483647)
        expect(X64_REL32_MAX_BACKWARD_V1).to_equal(2147483648)
