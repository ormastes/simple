"""Focused aspect-pack ModuleEntry identity and binding-index integrity.

The canonical identity tuple is, in semantic directory order:
(module_id, aspect_id, module_abi_hash, required_core_public_abi_hash,
 required_core_layout_hash, variant_fingerprint).
Each field and the v1 domain tag use a u64 length frame before SHA-256.
"""

use std.spec
use std.common.aspect_pack.{
    APK_FC_BOUND, APK_FC_UNLOADED,
    ApkModuleSourceV1, ApkCatalogEntryV1,
    _apk_module_identity_v1,
    apk_build_pack_v1, apk_build_catalog_v1,
    apk_loader_new, apk_loader_register_pack,
    apk_load_facet, apk_try_facet, apk_unload_facet_v1,
    apk_facet_state_v1}
use std.common.string_core.{text_to_bytes, bytes_to_text}

val INDEX_PACK_PATH: text = "aspect/index.apk"

fn _identity_index_pack() -> [u8]:
    var modules: [ApkModuleSourceV1] = []
    modules.push(ApkModuleSourceV1(module_id: "index.a", aspect_id: "index",
        payload: text_to_bytes("payload-a")))
    modules.push(ApkModuleSourceV1(module_id: "index.b", aspect_id: "index",
        payload: text_to_bytes("payload-b")))
    modules.push(ApkModuleSourceV1(module_id: "index.c", aspect_id: "index",
        payload: text_to_bytes("payload-c")))
    apk_build_pack_v1(modules).bytes

fn _identity_index_catalog() -> [u8]:
    var entries: [ApkCatalogEntryV1] = []
    entries.push(ApkCatalogEntryV1(facet_key: "index/A",
        pack_path: INDEX_PACK_PATH, module_id: "index.a"))
    entries.push(ApkCatalogEntryV1(facet_key: "index/B",
        pack_path: INDEX_PACK_PATH, module_id: "index.b"))
    entries.push(ApkCatalogEntryV1(facet_key: "index/C",
        pack_path: INDEX_PACK_PATH, module_id: "index.c"))
    apk_build_catalog_v1(entries).bytes

describe "aspect-pack canonical module identity":
    it "length framing separates adversarial field-boundary aliases":
        # A NUL-delimited encoder would give both tuples `a\0b\0c`; the
        # canonical u64 length frames must keep the two field boundaries apart.
        val left = _apk_module_identity_v1(
            "a", "b\0c", "module-abi", "core-abi", "layout", "variant")
        val right = _apk_module_identity_v1(
            "a\0b", "c", "module-abi", "core-abi", "layout", "variant")
        val repeat = _apk_module_identity_v1(
            "a", "b\0c", "module-abi", "core-abi", "layout", "variant")
        expect(left == right).to_equal(false)
        expect(left).to_equal(repeat)
        expect(left.len()).to_equal(64)

describe "aspect-pack loader/key binding index":
    it "repairs every shifted loader index after unloading a middle row":
        val pack = _identity_index_pack()
        val catalog = _identity_index_catalog()
        val left = apk_loader_new()
        val right = apk_loader_new()
        expect(apk_loader_register_pack(left, INDEX_PACK_PATH, pack)).to_equal(true)
        expect(apk_loader_register_pack(right, INDEX_PACK_PATH, pack)).to_equal(true)

        val left_a = apk_load_facet(left, catalog, "index/A")
        val left_b = apk_load_facet(left, catalog, "index/B")
        val left_c = apk_load_facet(left, catalog, "index/C")
        val right_a = apk_load_facet(right, catalog, "index/A")
        expect(left_a.ok and left_b.ok and left_c.ok and right_a.ok).to_equal(true)

        # Global row order is left/A, left/B, left/C, right/A. Removing the
        # middle row shifts both a same-loader row and another loader's row.
        val removed = apk_unload_facet_v1(left, "index/B")
        expect(removed.ok and removed.released).to_equal(true)
        expect(apk_facet_state_v1(left, "index/B")).to_equal(APK_FC_UNLOADED)

        val retained_left_a = apk_try_facet(left, "index/A")
        val shifted_left_c = apk_try_facet(left, "index/C")
        val shifted_right_a = apk_try_facet(right, "index/A")
        expect(retained_left_a.found).to_equal(true)
        expect(shifted_left_c.found).to_equal(true)
        expect(shifted_right_a.found).to_equal(true)
        expect(bytes_to_text(retained_left_a.payload)).to_equal("payload-a")
        expect(bytes_to_text(shifted_left_c.payload)).to_equal("payload-c")
        expect(bytes_to_text(shifted_right_a.payload)).to_equal("payload-a")
        expect(retained_left_a.generation).to_equal(left_a.generation)
        expect(shifted_left_c.generation).to_equal(left_c.generation)
        expect(shifted_right_a.generation).to_equal(right_a.generation)

        val reloaded_b = apk_load_facet(left, catalog, "index/B")
        expect(reloaded_b.ok and reloaded_b.found).to_equal(true)
        expect(reloaded_b.generation > left_b.generation).to_equal(true)
        expect(bytes_to_text(reloaded_b.payload)).to_equal("payload-b")
        expect(apk_facet_state_v1(left, "index/B")).to_equal(APK_FC_BOUND)
