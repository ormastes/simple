# @tag:in-development
# Expected red on a seed predating wrap_async_result (needs seed redeploy, see PR #6839 landing note).
# An `async fn` with no await returns a ready std.async Future (PR #6839
# follow-up). Needs the seed redeploy carrying wrap_async_result to pass on the
# shipped binary.
#
# @cover src/compiler_rust/compiler/src/interpreter_call/core/async_support.rs
use std.spec.{describe, it, expect}
use nogc_async_mut.async.future.{Future}
use nogc_async_mut.async.poll.{Poll, poll_is_ready, poll_unwrap}

async fn _answer() -> i64:
    42

describe "async fn without await":
    it "returns a ready Future whose poll yields the value":
        val f = _answer()
        expect(f.is_ready()).to_equal(true)
        val p = f.poll()
        expect(poll_is_ready(p)).to_equal(true)
        expect(poll_unwrap(p)).to_equal(42)

    it "agrees with Future.from_value":
        val a = _answer()
        val b = Future<i64>.from_value(42)
        expect(a.is_ready()).to_equal(b.is_ready())
        expect(poll_unwrap(a.poll())).to_equal(poll_unwrap(b.poll()))
