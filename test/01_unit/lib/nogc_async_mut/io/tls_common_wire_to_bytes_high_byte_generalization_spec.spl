"""
## Purpose and audience
Generalization spec for the fixed `wire_to_bytes` (see
`doc/08_tracking/bug/wire_to_bytes_returns_empty_2026-07-28.md`, resolved by
commit 3c302ed3f19a). That fix and its bug report only exercised byte values
< 128 (`"h2"` = [104, 50], `encode_u8(2)`, `encode_u16_be(9)`). This spec
probes the SAME `bytes_to_wire` / `wire_to_bytes` pair over the adjacent,
untested part of the domain: byte values 128-255, which are routine in real
TLS wire data (certificate DER bytes, random nonces, key material) and in
this module's own `encode_u24_be`/`encode_u16_be` helpers whenever a length
or value has its high bit set. It reproduces a NEW, currently-open defect
found while writing this generalization: `bytes_to_wire` builds its `text`
result by concatenating one-byte strings from `rt_byte_char`, and Simple's
`text` concatenation re-normalizes raw bytes >= 0x80 as UTF-8 codepoints,
inflating a single raw byte into a multi-byte sequence. `wire_to_bytes` then
walks `len(wire)` (a UTF-8-aware length) and decodes trailing garbage/zero
elements past the real byte count. See
`doc/08_tracking/bug/wire_to_bytes_high_byte_utf8_roundtrip_corruption_2026-09-05.md`
for the full root-cause narrative and lldb/probe evidence.
## Operator workflow
bin/simple test test/01_unit/lib/nogc_async_mut/io/tls_common_wire_to_bytes_high_byte_generalization_spec.spl
(no working `simple test` on this host as of 2026-09-05 — verify with
`.../target/bootstrap/simple run <this spec>`.)
## Compatibility and limitations
Interpreter-mode only on this host (no JIT/native lane exercised).
## Verification guidance and troubleshooting
Expected RED until `bytes_to_wire`/`wire_to_bytes` stop routing through
UTF-8-normalizing `text` concatenation for raw byte values >= 0x80 (or until
`wire_to_bytes` is fixed to decode by UTF-8-aware code unit rather than by
byte position). A GREEN here without a corresponding fix commit is the signal
that the assertions were weakened rather than the defect being fixed —
do not do that; see `.claude/rules/testing.md`.
"""
# Lifecycle: doc/08_tracking/bug/wire_to_bytes_returns_empty_2026-07-28.md ;
# doc/08_tracking/bug/wire_to_bytes_high_byte_utf8_roundtrip_corruption_2026-09-05.md
# @manual_section: primary

use std.spec
use std.nogc_async_mut.io.tls_common.{wire_to_bytes, bytes_to_wire, encode_u24_be}

# @step: Round-trip a single byte value through bytes_to_wire/wire_to_bytes
fn roundtrip_single_byte(value: i64) -> [i64]:
    wire_to_bytes(bytes_to_wire([value]))

describe "wire_to_bytes / bytes_to_wire over the full 0-255 byte range":

    it "round-trips a byte value just under the UTF-8 high-bit boundary (127)":
        # @req REQ-TLS-WIRE-005
        step("Round-trip byte value 127 (still single-byte UTF-8)")
        val bytes = roundtrip_single_byte(127)
        # @capture(exec): decoded byte array
        step("Verify the round trip preserves exactly one byte")
        expect(len(bytes)).to_equal(1)  # oracle: one input byte, one output byte
        expect(bytes[0] == 127).to_equal(true)

    it "round-trips a byte value at the UTF-8 high-bit boundary (128) without length inflation":
        # @req REQ-TLS-WIRE-006
        step("Round-trip byte value 128 (first value needing 2-byte UTF-8 if mis-encoded)")
        val bytes = roundtrip_single_byte(128)
        # @capture(exec): decoded byte array length and first element
        step("Verify the round trip still preserves exactly one byte, not two")
        expect(len(bytes)).to_equal(1)  # oracle: one raw input byte must decode to one byte
        expect(bytes[0] == 128).to_equal(true)

    it "round-trips the maximum byte value (255) without length inflation":
        # @req REQ-TLS-WIRE-007
        step("Round-trip byte value 255")
        val bytes = roundtrip_single_byte(255)
        # @capture(exec): decoded byte array length and first element
        step("Verify the round trip still preserves exactly one byte")
        expect(len(bytes)).to_equal(1)  # oracle: one raw input byte must decode to one byte
        expect(bytes[0] == 255).to_equal(true)

    it "decodes encode_u24_be values whose low byte is >= 128 to exactly 3 bytes":
        # @req REQ-TLS-WIRE-008
        step("Encode 200 (0x0000C8, low byte >= 0x80) as a 24-bit big-endian wire value")
        val decoded = wire_to_bytes(encode_u24_be(200))
        # @capture(exec): decoded 24-bit field
        step("Verify the field decodes to exactly 3 bytes: 0, 0, 200")
        expect(len(decoded)).to_equal(3)  # oracle: a u24 field is always 3 bytes
        expect(decoded[0] == 0).to_equal(true)
        expect(decoded[1] == 0).to_equal(true)
        expect(decoded[2] == 200).to_equal(true)
