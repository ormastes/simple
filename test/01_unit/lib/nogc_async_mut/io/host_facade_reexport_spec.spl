use std.spec.*
use std.nogc_async_mut.io.{
    getpid, time_now_unix_micros, dir_create_all, process_is_running
}

describe "nogc async host I/O facade re-exports":
    it "exposes portable process and clock helpers":
        expect(getpid()).to_be_greater_than(0)
        expect(time_now_unix_micros()).to_be_greater_than(0)

