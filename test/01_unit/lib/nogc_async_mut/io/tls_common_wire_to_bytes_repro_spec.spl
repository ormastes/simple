"""
## Purpose and audience
Reproduction spec for `doc/08_tracking/bug/wire_to_bytes_returns_empty_2026-07-28.md`:
`wire_to_bytes(wire: text) -> [i64]` in
`src/lib/nogc_async_mut/io/tls_common.spl` used to delegate to the generic
`to_bytes`, which returns one-character TEXT elements instead of integers.
The declared `[i64]` return type was a lie: `len()` on the result looked
correct, but every arithmetic/comparison use of an element (as in
`find_alpn_extension_data`, `data[i] == 0`) failed with
"semantic: type mismatch: comparing string with integer". This spec asserts
both the length AND that elements are real integers usable in arithmetic
comparisons — the exact defect the bug reported. Audience: Simple stdlib /
TLS maintainers verifying `wire_to_bytes` after the 2026-08-17 fix
(commit 3c302ed3f19a, "fix(http): three of six 'stale spec' reds were real
defects, one a security bug").
## Operator workflow
bin/simple test test/01_unit/lib/nogc_async_mut/io/tls_common_wire_to_bytes_repro_spec.spl
(on this host, no working `simple test`: verify with
`.../target/bootstrap/simple run <this spec>` per the debug ladder.)
## Compatibility and limitations
Interpreter-mode only on this host (no JIT/native lane exercised).
## Verification guidance and troubleshooting
A RED here means `wire_to_bytes` has regressed back to returning text
elements or an empty array; re-open the linked bug record.
"""
# Lifecycle: doc/08_tracking/bug/wire_to_bytes_returns_empty_2026-07-28.md
# @manual_section: primary

use std.spec
use std.nogc_async_mut.io.tls_common.{wire_to_bytes, bytes_to_wire, encode_u8, encode_u16_be}

# @step: Convert a plain wire string to bytes
fn wire_to_bytes_of(wire: text) -> [i64]:
    wire_to_bytes(wire)

describe "wire_to_bytes text-to-bytes direction":

    it "returns the exact byte count for a plain ASCII wire string":
        # @req REQ-TLS-WIRE-001
        step("Convert the 2-character wire string 'h2' to bytes")
        val bytes = wire_to_bytes_of("h2")
        # @capture(exec): decoded byte array length
        step("Verify the length matches the wire string length")
        expect(len(bytes)).to_equal(2)  # oracle: len("h2") == 2, two ASCII bytes

    it "produces real integer elements usable in arithmetic comparison":
        # @req REQ-TLS-WIRE-002
        step("Convert 'h2' to bytes and read the first element")
        val bytes = wire_to_bytes_of("h2")
        val first = bytes[0]
        step("Compare the element against an integer literal (the exact failure mode in the bug report)")
        # @capture(exec): integer-vs-integer comparison result
        expect(first == 104).to_equal(true)  # oracle: ASCII code of 'h'

    it "round-trips through bytes_to_wire and back for 0..255 values":
        # @req REQ-TLS-WIRE-003
        step("Encode [104, 50] to wire text, then decode it back to bytes")
        val roundtrip = wire_to_bytes_of(bytes_to_wire([104, 50]))
        step("Verify the round-tripped byte array matches the length and first element")
        expect(len(roundtrip)).to_equal(2)
        expect(roundtrip[0] == 104).to_equal(true)

    it "does not return an empty array for encode_u8/encode_u16_be wire text":
        # @req REQ-TLS-WIRE-004
        step("Decode encode_u8(2) and encode_u16_be(9) wire text")
        val one_byte = wire_to_bytes_of(encode_u8(2))
        val two_bytes = wire_to_bytes_of(encode_u16_be(9))
        # @capture(exec): lengths of both decoded arrays
        step("Verify neither collapses to an empty array (the reported symptom)")
        expect(len(one_byte)).to_equal(1)
        expect(len(two_bytes)).to_equal(2)
