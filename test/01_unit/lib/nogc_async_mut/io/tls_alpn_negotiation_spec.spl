use std.spec.{describe, it, assert_equal}
use std.nogc_async_mut.io.tls_common.{bytes_to_wire}
use std.nogc_async_mut.io.tls_handshake.{
    find_alpn_extension_data,
    negotiate_alpn,
    build_alpn_extension_block,
    parse_alpn_extension
}

# ClientHello extensions block offering ALPN "h2".
#   block_len(2) | type=0x0010 | ext_len=5 | list_len=3 | name_len=2 | "h2"
fn ch_extensions_offering_h2() -> [i64]:
    [0, 9, 0, 16, 0, 5, 0, 3, 2, 104, 50]

# Same shape, but offering "spdy/3" — a protocol this server cannot serve.
fn ch_extensions_offering_spdy() -> [i64]:
    [0, 13, 0, 16, 0, 9, 0, 7, 6, 115, 112, 100, 121, 47, 51]

# A single server_name (0x0000) extension — no ALPN present.
fn ch_extensions_without_alpn() -> [i64]:
    [0, 6, 0, 0, 0, 2, 0, 0]

describe "ALPN negotiation wired into the TLS server handshake":
    it "finds the ALPN extension data inside a ClientHello block":
        val data = find_alpn_extension_data(ch_extensions_offering_h2())
        assert_equal(len(data), 5)
        assert_equal(parse_alpn_extension(data), "h2")

    it "reports no ALPN data when the client offered none":
        assert_equal(len(find_alpn_extension_data(ch_extensions_without_alpn())), 0)

    it "reports no ALPN data for a truncated extensions block":
        assert_equal(len(find_alpn_extension_data([0, 40, 0, 16])), 0)

    it "negotiates a protocol the server supports":
        assert_equal(negotiate_alpn(ch_extensions_offering_h2()), "h2")

    it "declines a protocol the server cannot serve":
        assert_equal(negotiate_alpn(ch_extensions_offering_spdy()), "")

    it "negotiates nothing when the client offered no ALPN":
        assert_equal(negotiate_alpn(ch_extensions_without_alpn()), "")

    it "negotiates nothing for an empty extensions block":
        assert_equal(negotiate_alpn([]), "")

describe "ALPN echo in the ServerHello extensions block":
    it "omits the extensions block when nothing was negotiated":
        assert_equal(build_alpn_extension_block(""), "")

    it "emits an 11-byte extensions block for a two-byte protocol":
        assert_equal(len(build_alpn_extension_block("h2")), 11)

    it "emits exactly the RFC 7301 ServerHello bytes for h2":
        assert_equal(
            build_alpn_extension_block("h2"),
            bytes_to_wire([0, 9, 0, 16, 0, 5, 0, 3, 2, 104, 50])
        )

    it "emits exactly the RFC 7301 ServerHello bytes for http/1.1":
        assert_equal(
            build_alpn_extension_block("http/1.1"),
            bytes_to_wire([0, 15, 0, 16, 0, 11, 0, 9, 8, 104, 116, 116, 112, 47, 49, 46, 49])
        )

    it "echoes back a protocol the ClientHello parser can read again":
        assert_equal(parse_alpn_extension([0, 3, 2, 104, 50]), "h2")
