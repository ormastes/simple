"""Socket write completion must represent transferred bytes, not readiness."""

use std.spec
use std.io.driver.{
    io_write_completion_has_progress_v1, io_sendfile_chunk_truncated_v1
}

describe "I/O driver write completion progress":
    it "keeps zero-byte writes pending even when a socket was writable":
        # @req: REQ-IO-WRITE-PROGRESS-001
        expect(io_write_completion_has_progress_v1(0)).to_equal(false)

    it "accepts a positive byte transfer as progress":
        # @req: REQ-IO-WRITE-PROGRESS-001
        expect(io_write_completion_has_progress_v1(1)).to_equal(true)

    it "does not classify terminal negative results as progress":
        # @req: REQ-IO-WRITE-PROGRESS-001
        expect(io_write_completion_has_progress_v1(-1)).to_equal(false)

    it "rejects a truncated sendfile body instead of waiting forever":
        # @req: REQ-IO-WRITE-PROGRESS-002
        expect(io_sendfile_chunk_truncated_v1(12, 0)).to_equal(true)

    it "permits an empty requested sendfile transfer":
        # @req: REQ-IO-WRITE-PROGRESS-002
        expect(io_sendfile_chunk_truncated_v1(0, 0)).to_equal(false)
