# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# AsyncUdpSocket datagram behavior on loopback: bind, send_to/recv_from
# round-trip, and socket state. Futures are eager; recv_from blocks
# until the datagram queued by the earlier send arrives.

use std.spec.step
use std.nogc_async_mut.host_io.net.{AsyncUdpSocket}
use std.async.poll.{Poll}

describe "AsyncUdpSocket loopback":
    # @manual scenario evidence
    it "binds to an ephemeral port and reports its address":
        # @req REQ-SSPEC-LIB
        step("bind 127.0.0.1:0 and read local_addr")
        val sock = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        val addr = sock.local_addr().unwrap()
        expect(addr.contains("127.0.0.1")).to_equal(true)
        expect(sock.is_open()).to_equal(true)
        sock.close()

    it "round-trips a datagram between two bound sockets":
        # @req REQ-SSPEC-LIB
        step("send_to then recv_from a fixed payload")
        val sender = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        val receiver = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        val dest = receiver.local_addr().unwrap()
        # oracle: ASCII "ping" = [112, 105, 110, 103]
        match sender.send_to([112, 105, 110, 103], dest).poll():
            case Poll.Ready(Ok(n)): expect(n).to_equal(4)
            case _: expect(false).to_equal(true)
        var (data, from) = match receiver.recv_from(64).poll():
            case Poll.Ready(Ok(pair)): pair
            case _: panic("recv_from failed")
        expect(data.len()).to_equal(4)
        expect(data[0]).to_equal(112)
        expect(data[3]).to_equal(103)
        expect(from.contains("127.0.0.1")).to_equal(true)
        sender.close()
        receiver.close()

# --- Merged from the legacy mirror copy (unit:lib/nogc_async_mut/io/async_udp_spec.spl), test dedup phase B: tests this copy lacked.

describe "AsyncUdpSocket connected mode (merged from legacy copy)":
    it "connects to a peer and reports open":
        # @req REQ-SSPEC-LIB
        step("bind both ends and connect one to the other")
        val peer = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        val client = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        expect(client.connect(peer.local_addr().unwrap()).is_ok()).to_equal(true)
        expect(client.is_open()).to_equal(true)
        client.close()
        peer.close()

    it "delivers a send to the connected peer with exact bytes":
        # @req REQ-SSPEC-LIB
        step("send three bytes, receive all three")
        val peer = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        val client = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        client.connect(peer.local_addr().unwrap())
        # oracle: ASCII "ok!" = [111, 107, 33]
        match client.send([111, 107, 33]).poll():
            case Poll.Ready(Ok(n)): expect(n).to_equal(3)
            case _: expect(false).to_equal(true)
        var data = match peer.recv_from(16).poll():
            case Poll.Ready(Ok(pair)): pair[0]
            case _: panic("recv failed")
        expect(data.len()).to_equal(3)
        expect(data[2]).to_equal(33)
        client.close()
        peer.close()

    it "close flips is_open to false":
        # @req REQ-SSPEC-LIB
        step("bind, close, observe state")
        val sock = AsyncUdpSocket.bind("127.0.0.1:0").unwrap()
        sock.close()
        expect(sock.is_open()).to_equal(false)
