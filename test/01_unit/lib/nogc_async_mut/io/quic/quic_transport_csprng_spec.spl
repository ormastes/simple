# QUIC transport safety contract: behavioral connection-ID admission.

use std.io.quic.quic_transport.{quic_connection_id_admit}

describe "QUIC connection ID entropy contract":
    it "admits a valid lowercase eight-byte candidate":
        expect quic_connection_id_admit("0102030405060708", []).len() == 8

    it "rejects malformed, uppercase, and all-zero candidates":
        expect quic_connection_id_admit("01020304050607", []).len() == 0
        expect quic_connection_id_admit("010203040506070A", []).len() == 0
        expect quic_connection_id_admit("0000000000000000", []).len() == 0

    it "rejects a candidate whose canonical key is already used":
        val used = ["0102030405060708"]
        expect quic_connection_id_admit("0102030405060708", used).len() == 0
