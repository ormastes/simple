"""IoDriver TCP recv text view: strict UTF-8 with a per-fd carry.

A scalar split across two reads must decode intact; truly invalid bytes give
no text (the raw bytes stay authoritative) instead of a lossy decode.
"""
use std.spec
use std.nogc_async_mut.io.driver.{IoDriver}

describe "IoDriver recv UTF-8 carry":
    it "decodes a scalar split across two reads on one fd":
        val driver = IoDriver.new()
        expect(driver._recv_text(7, [0x61u8, 0xEDu8])).to_equal("a")
        expect(driver._recv_text(9, [0x62u8])).to_equal("b")
        expect(driver._recv_text(7, [0x95u8, 0x9Cu8, 0x0Au8])).to_equal("한\n")

    it "rejects truly invalid bytes and recovers on the next read":
        val driver = IoDriver.new()
        expect(driver._recv_text(7, [0x61u8, 0xFFu8])).to_equal("")
        expect(driver._recv_text(7, [0x62u8])).to_equal("b")
