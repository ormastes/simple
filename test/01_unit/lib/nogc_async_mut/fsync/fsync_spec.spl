# @cover src/lib/nogc_async_mut/fsync/fsync.spl

"""
## Purpose and audience
Purpose: pin the interpreter-mode fsync mutex behavior — lock, unlock,
trylock, and the is_locked diagnostic — at the zero and non-zero futex
addresses the Wine layer exercises, including cross-address independence and
the never-registered default. Each mutation is checked through the module's
own query API rather than locally constructed literals.
Audience: nogc_async_mut maintainers and the Wine-compatibility engineers
who own the fsync (futex-backed) primitives.

## Operator workflow
Run `src/compiler_rust/target/bootstrap/simple run
test/01_unit/lib/nogc_async_mut/fsync/fsync_spec.spl` and confirm every
example passes.

## Compatibility and limitations
Interpreter mode keeps an in-process lock table; no kernel futex syscall is
made, so blocking and cross-process contention are out of scope here.

## Verification guidance and troubleshooting
Every scenario reads `fsync_mutex_is_locked` after the mutation and carries
an inline `# oracle:` comment; a failure means the lock table no longer
tracks the exercised address.
"""

# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# plan doc/03_plan/sspec_modernization_plan.md ;
# architecture doc/04_architecture/sspec_documentization_maintenance.md ;
# design doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @manual_section: fsync mutex primitives

use std.spec
use std.spec.step
use std.nogc_async_mut.fsync.fsync.{
    fsync_mutex_lock,
    fsync_mutex_unlock,
    fsync_mutex_trylock,
    fsync_mutex_is_locked
}

describe "fsync mutex/condvar":
    it "lock and unlock on address 0 complete without error":
        # @req REQ-SSPEC-UNIT-FSYNC-001
        # @capture(bit_table): address 0 locked bit before and after unlock
        step("Verify: lock address 0, read it locked, unlock, read it free")
        val addr: u32 = 0
        fsync_mutex_lock(addr)
        expect(fsync_mutex_is_locked(addr)).to_equal(true)  # oracle: lock registers address 0
        fsync_mutex_unlock(addr)
        expect(fsync_mutex_is_locked(addr)).to_equal(false)  # oracle: unlock releases address 0

    it "lock and unlock on non-zero address complete without error":
        # @req REQ-SSPEC-UNIT-FSYNC-001
        # @capture(bit_table): address 42 locked bit before and after unlock
        step("Verify: lock address 42, read it locked, unlock, read it free")
        val addr: u32 = 42
        fsync_mutex_lock(addr)
        expect(fsync_mutex_is_locked(addr)).to_equal(true)  # oracle: lock registers address 42
        fsync_mutex_unlock(addr)
        expect(fsync_mutex_is_locked(addr)).to_equal(false)  # oracle: unlock releases address 42

    it "multiple lock/unlock pairs on different addresses do not interfere":
        # @req REQ-SSPEC-UNIT-FSYNC-002
        # @capture(bit_table): addresses 1 and 2 held simultaneously, then both free
        step("Verify: hold addresses 1 and 2 together, unlock in reverse order")
        val a: u32 = 1
        val b: u32 = 2
        fsync_mutex_lock(a)
        fsync_mutex_lock(b)
        expect(fsync_mutex_is_locked(a)).to_equal(true)  # oracle: first lock survives the second
        expect(fsync_mutex_is_locked(b)).to_equal(true)  # oracle: second lock is independent
        fsync_mutex_unlock(b)
        expect(fsync_mutex_is_locked(a)).to_equal(true)  # oracle: unlocking b leaves a held
        fsync_mutex_unlock(a)
        expect(fsync_mutex_is_locked(a)).to_equal(false)  # oracle: both addresses end released
        expect(fsync_mutex_is_locked(b)).to_equal(false)  # oracle: both addresses end released

    it "trylock rejects an already-held address":
        # @req REQ-SSPEC-UNIT-FSYNC-002
        # @capture(bit_table): trylock verdicts while address 7 is held and after release
        step("Verify: hold address 7, trylock it, release, trylock again")
        val addr: u32 = 7
        fsync_mutex_lock(addr)
        expect(fsync_mutex_trylock(addr)).to_equal(false)  # oracle: trylock refuses a held lock
        fsync_mutex_unlock(addr)
        expect(fsync_mutex_trylock(addr)).to_equal(true)  # oracle: released address acquires again

    it "querying a never-registered address reports unlocked":
        # @req REQ-SSPEC-UNIT-FSYNC-002
        # @capture(bit_table): is_locked verdict for an address never locked
        step("Verify: query address 99 that no lock ever touched")
        expect(fsync_mutex_is_locked(99)).to_equal(false)  # oracle: unregistered address defaults free
