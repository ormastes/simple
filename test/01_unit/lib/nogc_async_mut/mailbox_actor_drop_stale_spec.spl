use std.spec
use std.nogc_async_mut.mailbox_actor.{PriorityMailbox, MailboxConfig, PRIORITY_MAILBOX_DEFAULT_CAPACITY, SEND_SUCCESS, SEND_QUEUE_FULL}
use std.nogc_async_mut.types.{Capacity}

describe "PriorityMailbox drop_stale off_heap_bytes accounting":

    it "maps the legacy unbounded constructor to a finite default":
        val config = MailboxConfig.unbounded()
        expect(config.capacity.value).to_equal(PRIORITY_MAILBOX_DEFAULT_CAPACITY)
        val mailbox = PriorityMailbox.unbounded()
        expect(mailbox.is_full()).to_equal(false)

    it "normalizes a forged zero capacity before it can admit unbounded work":
        val forged = MailboxConfig(
            capacity: Capacity(value: 0),
            off_heap: true,
            priority_enabled: false,
            high_priority_reserve: Capacity(value: 0)
        )
        val mailbox = PriorityMailbox.new(forged)
        expect(mailbox.config.capacity.value).to_equal(PRIORITY_MAILBOX_DEFAULT_CAPACITY)

    it "does not reserve priority capacity when priority is disabled":
        val mailbox = PriorityMailbox.new(MailboxConfig.default())
        var accepted = 0
        while accepted < PRIORITY_MAILBOX_DEFAULT_CAPACITY:
            val result = mailbox.send_normal(accepted, 1, nil)
            if result == SEND_SUCCESS:
                accepted = accepted + 1
            else:
                # Keep the loop bounded even when a broken admission rule
                # rejects early; the exact accepted count is the oracle.
                break
        expect(accepted).to_equal(PRIORITY_MAILBOX_DEFAULT_CAPACITY)
        expect(mailbox.send_normal(1001, 1, nil)).to_equal(SEND_QUEUE_FULL)

    it "decrements off_heap_bytes when dropping stale messages, like receive() does":
        val mb = PriorityMailbox.new(MailboxConfig.unbounded())
        mb.send_normal(1, 100, 42)
        mb.send_normal(2, 50, 42)
        val before = mb.get_stats()
        expect(before.off_heap_bytes.value).to_equal(150)

        # threshold_ms=0 with age_ms()==0 means is_stale (age > threshold) is false
        # for age 0, so use a negative threshold to force every message to be "stale"
        val dropped = mb.drop_stale(-1)
        expect(dropped).to_equal(2)

        val after = mb.get_stats()
        expect(after.off_heap_bytes.value).to_equal(0)
        expect(after.total_dropped.value).to_equal(2)

    it "decrements off_heap_bytes when select removes a matching message":
        val mb = PriorityMailbox.new(MailboxConfig.unbounded())
        mb.send_normal(1, 100, 42)
        mb.send_normal(2, 50, 7)
        val selected = mb.select_by_sender(42)
        expect(selected.?).to_equal(true)
        val after = mb.get_stats()
        expect(after.current_size.value).to_equal(1)
        expect(after.total_processed.value).to_equal(1)
        expect(after.off_heap_bytes.value).to_equal(50)

    it "releases high-priority occupancy after delivery and stale eviction":
        val mb = PriorityMailbox.new(MailboxConfig.unbounded())
        mb.send_high(1, 100, 42)
        mb.send_high(2, 50, 7)
        expect(mb.get_stats().high_priority_count.value).to_equal(2)
        mb.receive()
        expect(mb.get_stats().high_priority_count.value).to_equal(1)
        mb.drop_stale(-1)
        expect(mb.get_stats().high_priority_count.value).to_equal(0)
