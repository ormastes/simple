use std.spec
use std.nogc_async_mut.mailbox_actor.{PriorityMailbox, MailboxConfig}

describe "PriorityMailbox drop_stale off_heap_bytes accounting":

    it "decrements off_heap_bytes when dropping stale messages, like receive() does":
        val mb = PriorityMailbox.new(MailboxConfig.unbounded())
        mb.send_normal(1, 100, 42)
        mb.send_normal(2, 50, 42)
        val before = mb.get_stats()
        expect(before.off_heap_bytes.value).to_equal(150)

        # threshold_ms=0 with age_ms()==0 means is_stale (age > threshold) is false
        # for age 0, so use a negative threshold to force every message to be "stale"
        val dropped = mb.drop_stale(-1)
        expect(dropped).to_equal(2)

        val after = mb.get_stats()
        expect(after.off_heap_bytes.value).to_equal(0)
