# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use std.nogc_async_mut.game2d.app.config.{GameConfig, WindowConfig, RuntimeConfig}
use std.nogc_async_mut.game2d.app.app.{AppDefaults}


describe "nogc_async_mut game2d app facade":
    # @manual scenario evidence

    it "re-exports app defaults and config records":
        # @req REQ-SSPEC-UNIT
        step("re-exports app defaults and config records")
        val defaults = AppDefaults.new()
        defaults.load()

        val window = WindowConfig.default()
        expect(window.width).to_equal(800)
        expect(window.height).to_equal(600)
        expect(window.vsync).to_equal(true)

        val runtime = RuntimeConfig.default()
        expect(runtime.fixed_step_hz).to_equal(60)
        expect(runtime.deterministic).to_equal(false)

        val config = GameConfig.default()
        expect(config.title).to_equal("Simple Game")
        expect(config.window.width).to_equal(800)
        expect(config.runtime.max_entities).to_equal(1024)
