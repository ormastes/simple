# Purpose: prove focused KPF race tests reject concrete unsafe mutant models.
# @req REQ-KPF-ASYNC-BOUNDED
# @req REQ-KPF-GENERATION-SAFETY
# @cover src/lib/nogc_async_mut/kernel_plugin/testing/race_evidence.spl

use std.spec
use std.spec.step
use std.nogc_async_mut.kernel_plugin.testing.*

describe "KPF race and publication mutation sensitivity":
    it "exposes a late completion overwriting cancellation":
        step("run the terminal-overwrite mutant")
        assert_true(kpf_terminal_overwrite_mutant_exposed_v1())

    it "exposes request validation that omits the slot epoch":
        step("run the epoch-omission mutant against a reused slot")
        assert_true(kpf_epoch_omission_mutant_exposed_v1())

    it "exposes publication that bypasses failed candidate admission":
        step("run the publication-gate mutant with a publishable replacement")
        assert_true(kpf_failed_candidate_gate_mutant_exposed_v1())
        assert_true(kpf_lifecycle_matrix_mutant_exposed_v1())
