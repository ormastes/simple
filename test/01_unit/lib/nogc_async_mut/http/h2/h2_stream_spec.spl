"""
## Purpose and audience
Executable evidence that the RFC 9113 §5 stream state machine and
flow-control accounting in src/lib/nogc_async_mut/http/h2/h2_stream.spl
behave as specified: Idle to Open to HalfClosedLocal to Closed transitions,
RST_STREAM termination, and send-window depletion. Written for the engineers
who own the HTTP/2 h2 stack and for reviewers confirming stream-lifecycle
behavior after a change.
## Operator workflow
Run:
    bin/simple test test/01_unit/lib/nogc_async_mut/http/h2/h2_stream_spec.spl
Every scenario must pass; a failure is a regression in the stream state
machine or window accounting.
## Compatibility and limitations
Covers the per-stream state machine and send-window accounting only. HPACK,
frame serialization, and connection-level state live in sibling modules and
are out of scope. Scenarios call the product API h2_stream_new,
h2_stream_transition, and h2_stream_consume_send_window directly; no stub
state values are asserted.
## Verification guidance and troubleshooting
Each failing scenario names the RFC 9113 section it pins. A transition
failure means h2_stream_transition mis-mapped an event for the source state;
compare against the match table in h2_stream.spl. A window failure means
h2_stream_consume_send_window deducted the wrong amount.
"""
# Lifecycle: doc/01_research/lib/networking/net_http_sendfile_routing.md ;
# doc/03_plan/lib/networking/net_tcp_socket_data_path.md ;
# doc/04_architecture/ui/web/ui_web_http_core_migration.md ;
# doc/05_design/lib/networking/net_http_sendfile_routing.md
# @manual_section: h2-stream-lifecycle

use std.spec
use std.spec.step
use std.http.h2.h2_stream.{h2_stream_new, h2_stream_transition, h2_stream_consume_send_window, h2_stream_is_open, h2_stream_is_closed, H2StreamState, H2StreamEvent}

fn stream_state_name(state: H2StreamState) -> text:
    match state:
        case Idle:
            return "idle"
        case Open:
            return "open"
        case ReservedLocal:
            return "reserved_local"
        case ReservedRemote:
            return "reserved_remote"
        case HalfClosedLocal:
            return "half_closed_local"
        case HalfClosedRemote:
            return "half_closed_remote"
        case Closed:
            return "closed"

describe "H2 stream lifecycle and flow control":
    """
    ## H2Stream state machine (RFC 9113 §5.1) and window accounting (§5.2)

    Real state-machine evidence: every scenario drives the shipped
    h2_stream_new / h2_stream_transition / h2_stream_consume_send_window
    implementations.
    """

    it "starts in idle state":
        # @req REQ-LIB-H2_STREAM-001
        # @capture(protocol_json): initial stream state for a freshly allocated stream
        step("Allocate a new stream with h2_stream_new")
        val stream = h2_stream_new(1, 65535)
        expect(stream_state_name(stream.state)).to_equal("idle")  # oracle: RFC 9113 §5.1 — a new stream begins in Idle
        expect(stream.id).to_equal(1)  # oracle: the stream keeps the id given at allocation
        expect(stream.send_window).to_equal(65535)  # oracle: RFC 9113 §5.2 — the initial window default is 65535

    it "transitions to open on HEADERS send":
        # @req REQ-LIB-H2_STREAM-001
        # @capture(protocol_json): stream state after SendHeaders on an idle stream
        step("Send HEADERS on the idle stream via h2_stream_transition")
        val idle = h2_stream_new(1, 65535)
        val opened = h2_stream_transition(idle, H2StreamEvent.SendHeaders)
        expect(stream_state_name(opened.state)).to_equal("open")  # oracle: RFC 9113 §5.1 — HEADERS on Idle opens the stream
        expect(h2_stream_is_open(opened)).to_equal(true)  # oracle: an Open stream can carry data frames

    it "transitions to half-closed-local on END_STREAM send":
        # @req REQ-LIB-H2_STREAM-001
        # @capture(protocol_json): stream state after SendEndStream on an open stream
        step("Send END_STREAM on the open stream via h2_stream_transition")
        val idle = h2_stream_new(1, 65535)
        val opened = h2_stream_transition(idle, H2StreamEvent.SendHeaders)
        val half_closed = h2_stream_transition(opened, H2StreamEvent.SendEndStream)
        expect(stream_state_name(half_closed.state)).to_equal("half_closed_local")  # oracle: RFC 9113 §5.1 — END_STREAM on Open half-closes local
        expect(h2_stream_is_open(half_closed)).to_equal(true)  # oracle: half-closed-local can still receive

    it "transitions to closed on RST_STREAM":
        # @req REQ-LIB-H2_STREAM-002
        # @capture(protocol_json): stream state after SendRstStream on an open stream
        step("Send RST_STREAM on the open stream via h2_stream_transition")
        val idle = h2_stream_new(1, 65535)
        val opened = h2_stream_transition(idle, H2StreamEvent.SendHeaders)
        val reset = h2_stream_transition(opened, H2StreamEvent.SendRstStream)
        expect(stream_state_name(reset.state)).to_equal("closed")  # oracle: RFC 9113 §5.1 — RST_STREAM terminates any non-idle state
        expect(h2_stream_is_closed(reset)).to_equal(true)  # oracle: the reset stream reports closed

    it "tracks flow control window credits":
        # @req REQ-LIB-H2_STREAM-003
        # @capture(statistics): send window after each DATA send
        step("Consume send window with h2_stream_consume_send_window")
        val stream = h2_stream_new(1, 65535)
        val after_first = h2_stream_consume_send_window(stream, 1000)
        expect(after_first.send_window).to_equal(64535)  # oracle: RFC 9113 §5.2 — sending DATA deducts its size from the window
        val after_second = h2_stream_consume_send_window(after_first, 64535)
        expect(after_second.send_window).to_equal(0)  # oracle: the window depletes to exactly zero

    it "rejects data when flow control window exhausted":
        # @req REQ-LIB-H2_STREAM-003
        # @capture(statistics): exhausted window state and the caller-side admission gate
        step("Attempt to send 512 bytes against a zero window")
        val stream = h2_stream_new(1, 65535)
        val starved = h2_stream_consume_send_window(stream, 65535)
        val data_size = 512
        val can_send = starved.send_window >= data_size
        expect(can_send).to_equal(false)  # oracle: RFC 9113 §5.2 — a sender MUST NOT send DATA when the window is zero
        expect(starved.send_window).to_equal(0)  # oracle: the product window is exactly zero after full depletion
