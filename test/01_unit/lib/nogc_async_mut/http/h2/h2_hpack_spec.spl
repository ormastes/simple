"""
## Purpose and audience
Executable evidence that the RFC 7541 HPACK encoder and decoder in
src/lib/nogc_async_mut/http/h2/h2_hpack.spl preserve HTTP/2 header lists:
indexed static-table fields, literal fields without indexing, and full
encode-decode round trips. Written for the engineers who own the HTTP/2
h2 stack and for reviewers confirming HPACK behavior after a change.
## Operator workflow
Run:
    bin/simple test test/01_unit/lib/nogc_async_mut/http/h2/h2_hpack_spec.spl
Every scenario must pass; a failure is a regression in HPACK encoding or
decoding.
## Compatibility and limitations
Static-table-only HPACK: the dynamic table is deferred by h2_hpack.spl, so
these scenarios never exercise dynamic-table indices or Huffman string
coding. Scenarios call the product API hpack_encode and hpack_decode
directly; no stub values are asserted.
## Verification guidance and troubleshooting
Each failing scenario names the RFC 7541 section it pins; re-read that
section together with hpack_encode/hpack_decode in h2_hpack.spl. A
round-trip failure usually means hpack_decode mis-dispatched on the first
byte pattern; check the §6 dispatch table first.
"""
# Lifecycle: doc/01_research/lib/networking/net_http_sendfile_routing.md ;
# doc/03_plan/lib/networking/net_tcp_socket_data_path.md ;
# doc/04_architecture/ui/web/ui_web_http_core_migration.md ;
# doc/05_design/lib/networking/net_http_sendfile_routing.md
# @manual_section: h2-hpack

use std.spec
use std.spec.step
use std.http.h2.h2_hpack.{hpack_static_table, hpack_encode, hpack_decode, HpackEntry}

describe "HPACK encoder and decoder":
    """
    ## HPACK RFC 7541 — static table encode and decode

    Real encoder/decoder evidence: every scenario drives the shipped
    hpack_encode and hpack_decode implementations over the RFC 7541
    Appendix A static table.
    """

    it "encodes indexed header field from static table":
        # @req REQ-LIB-H2_HPACK-001
        # @capture(protocol_binary): encoded byte block for the static :method GET header
        step("Encode the :method GET header through the RFC 7541 static table")
        val table = hpack_static_table()
        var headers: [HpackEntry] = []
        headers.push(HpackEntry(name: ":method", value: "GET"))
        val encoded = hpack_encode(headers, table)
        expect(encoded.bytes.len()).to_equal(1)  # oracle: §6.1 indexed representation is a single byte for index <= 63
        expect(encoded.bytes[0]).to_equal(0x82)  # oracle: §6.1 — bit7 set plus static index 2 is 1_0000010

    it "decodes indexed header field from static table":
        # @req REQ-LIB-H2_HPACK-001
        # @capture(protocol_json): decoded header pair for indexed byte 0x82
        step("Decode the single indexed byte 0x82 against the static table")
        val table = hpack_static_table()
        val buf: [u8] = [0x82]
        val decoded = hpack_decode(buf, table)
        expect(decoded.headers.len()).to_equal(1)  # oracle: one indexed field decodes to exactly one header pair
        expect(decoded.headers[0].name).to_equal(":method")  # oracle: RFC 7541 Appendix A index 2 is :method
        expect(decoded.headers[0].value).to_equal("GET")  # oracle: RFC 7541 Appendix A index 2 is :method GET
        expect(decoded.bytes_consumed).to_equal(1)  # oracle: the single indexed byte is the whole block

    it "encodes literal header field without indexing":
        # @req REQ-LIB-H2_HPACK-002
        # @capture(protocol_binary): encoded byte block for a custom literal header
        step("Encode a custom header that is absent from the static table")
        val table = hpack_static_table()
        var headers: [HpackEntry] = []
        headers.push(HpackEntry(name: "x-custom-header", value: "custom-value"))
        val encoded = hpack_encode(headers, table)
        expect(encoded.bytes[0]).to_equal(0x00)  # oracle: §6.2.2 literal without indexing with new name starts 0x00
        expect(encoded.bytes[1]).to_equal(15)  # oracle: raw H=0 string literal carries a 7-bit length, name is 15 chars
        expect(encoded.bytes[17]).to_equal(12)  # oracle: value length byte follows 1 prefix + 1 name length + 15 name chars
        expect(encoded.bytes.len()).to_equal(30)  # oracle: 1 + 1 + 15 + 1 + 12 bytes for the full literal block

    it "decodes literal header field without indexing":
        # @req REQ-LIB-H2_HPACK-002
        # @capture(protocol_json): decoded header pair for a literal block
        step("Decode a literal-without-indexing block back into the header pair")
        val table = hpack_static_table()
        var headers: [HpackEntry] = []
        headers.push(HpackEntry(name: "foo", value: "bar"))
        val encoded = hpack_encode(headers, table)
        val decoded = hpack_decode(encoded.bytes, table)
        expect(decoded.headers.len()).to_equal(1)  # oracle: one literal field decodes to exactly one header pair
        expect(decoded.headers[0].name).to_equal("foo")  # oracle: the literal name must survive the block unchanged
        expect(decoded.headers[0].value).to_equal("bar")  # oracle: the literal value must survive the block unchanged

    it "round-trips custom header through encode-decode":
        # @req REQ-LIB-H2_HPACK-003
        # @capture(protocol_json): round-trip header pair and consumed byte count
        step("Round-trip x-request-id through encode and then decode")
        val table = hpack_static_table()
        var headers: [HpackEntry] = []
        headers.push(HpackEntry(name: "x-request-id", value: "abc-123"))
        val encoded = hpack_encode(headers, table)
        val decoded = hpack_decode(encoded.bytes, table)
        expect(decoded.headers[0].name).to_equal("x-request-id")  # oracle: a custom name must survive a full encode-decode cycle
        expect(decoded.headers[0].value).to_equal("abc-123")  # oracle: a custom value must survive a full encode-decode cycle
        expect(decoded.bytes_consumed).to_equal(encoded.bytes.len())  # oracle: the decoder consumes exactly the encoded block
