"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/nogc_async_mut/http/sendfile_routing_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/sendfile_routing_spec.md
# doc-path: doc/03_plan/sys_test/sendfile_routing_spec.md
# doc-path: doc/04_architecture/sendfile_routing_spec.md
# doc-path: doc/05_design/sendfile_routing_spec_oracles.md
# @manual: primary

"""
# Sendfile Routing Specification

**Feature IDs:** FR-NET-0003 (WQ-2)
**Category:** Stdlib / HTTP / Static-File Routing
**Difficulty:** 2/5
**Status:** Active

Validates the sendfile routing module:
- portable-read fallback when sendfile unavailable
- sendfile selected when supported
- zero-copy does NOT route to sendfile when unsupported
- explicit backend label returned for the verification gate
"""

use std.spec.step

use std.spec
use std.spec.step
use std.http.sendfile_routing.{

    SendfileBackend, SendfileCapabilities,
    sendfile_caps, sendfile_caps_portable, sendfile_caps_with_sendfile,
    sendfile_caps_with_zero_copy, sendfile_caps_full,
    detect_sendfile_support, route_sendfile, sendfile_backend_label,
    sendfile_guard_ok
}

describe "Portable-read fallback when sendfile unavailable (WQ-2a)":
    # @manual scenario evidence
    it "portable backend with file body routes to PortableRead":
        # @req REQ-SSPEC-UNIT
        step("portable backend with file body routes to PortableRead")
        val caps = sendfile_caps_portable("poll-socket")
        val backend = route_sendfile(caps, true)
        val label = sendfile_backend_label(backend)
        expect(label).to_equal("portable-read")

    it "portable backend detection returns false":
        # @req REQ-SSPEC-UNIT
        step("portable backend detection returns false")
        val caps = sendfile_caps_portable("poll-socket")
        expect(detect_sendfile_support(caps)).to_equal(false)

    it "portable backend guard passes for PortableRead":
        # @req REQ-SSPEC-UNIT
        step("portable backend guard passes for PortableRead")
        val caps = sendfile_caps_portable("poll-socket")
        val backend = route_sendfile(caps, true)
        expect(sendfile_guard_ok(caps, backend)).to_equal(true)

describe "Sendfile selected when supported (WQ-2b)":
    it "sendfile backend with file body routes to Sendfile":
        # @req REQ-SSPEC-UNIT
        step("sendfile backend with file body routes to Sendfile")
        val caps = sendfile_caps_with_sendfile("io-uring")
        val backend = route_sendfile(caps, true)
        val label = sendfile_backend_label(backend)
        expect(label).to_equal("sendfile")

    it "sendfile backend detection returns true":
        # @req REQ-SSPEC-UNIT
        step("sendfile backend detection returns true")
        val caps = sendfile_caps_with_sendfile("io-uring")
        expect(detect_sendfile_support(caps)).to_equal(true)

    it "full backend with file body routes to Sendfile":
        # @req REQ-SSPEC-UNIT
        step("full backend with file body routes to Sendfile")
        val caps = sendfile_caps_full("io-uring-zc")
        val backend = route_sendfile(caps, true)
        val label = sendfile_backend_label(backend)
        expect(label).to_equal("sendfile")

    it "sendfile guard passes for Sendfile on capable backend":
        # @req REQ-SSPEC-UNIT
        step("sendfile guard passes for Sendfile on capable backend")
        val caps = sendfile_caps_with_sendfile("io-uring")
        val backend = route_sendfile(caps, true)
        expect(sendfile_guard_ok(caps, backend)).to_equal(true)

describe "Zero-copy does NOT route to sendfile when unsupported (WQ-2c)":
    it "zero-copy-only backend with file body routes to PortableRead":
        # @req REQ-SSPEC-UNIT
        step("zero-copy-only backend with file body routes to PortableRead")
        val caps = sendfile_caps_with_zero_copy("dpdk-zc")
        val backend = route_sendfile(caps, true)
        val label = sendfile_backend_label(backend)
        expect(label).to_equal("portable-read")

    it "zero-copy-only backend detection returns false for sendfile":
        # @req REQ-SSPEC-UNIT
        step("zero-copy-only backend detection returns false for sendfile")
        val caps = sendfile_caps_with_zero_copy("dpdk-zc")
        expect(detect_sendfile_support(caps)).to_equal(false)

    it "zero-copy-only guard rejects manually constructed Sendfile":
        # @req REQ-SSPEC-UNIT
        step("zero-copy-only guard rejects manually constructed Sendfile")
        val caps = sendfile_caps_with_zero_copy("dpdk-zc")
        expect(sendfile_guard_ok(caps, SendfileBackend.Sendfile)).to_equal(false)

    it "zero-copy-only guard passes for PortableRead":
        # @req REQ-SSPEC-UNIT
        step("zero-copy-only guard passes for PortableRead")
        val caps = sendfile_caps_with_zero_copy("dpdk-zc")
        expect(sendfile_guard_ok(caps, SendfileBackend.PortableRead)).to_equal(true)

describe "Explicit backend label for verification gate (WQ-2d)":
    it "Sendfile label is sendfile":
        # @req REQ-SSPEC-UNIT
        step("Sendfile label is sendfile")
        expect(sendfile_backend_label(SendfileBackend.Sendfile)).to_equal("sendfile")

    it "PortableRead label is portable-read":
        # @req REQ-SSPEC-UNIT
        step("PortableRead label is portable-read")
        expect(sendfile_backend_label(SendfileBackend.PortableRead)).to_equal("portable-read")

    it "Unsupported label is unsupported":
        # @req REQ-SSPEC-UNIT
        step("Unsupported label is unsupported")
        expect(sendfile_backend_label(SendfileBackend.Unsupported)).to_equal("unsupported")

    it "no-file-body routes to Unsupported":
        # @req REQ-SSPEC-UNIT
        step("no-file-body routes to Unsupported")
        val caps = sendfile_caps_with_sendfile("io-uring")
        val backend = route_sendfile(caps, false)
        val label = sendfile_backend_label(backend)
        expect(label).to_equal("unsupported")

    it "guard passes for Unsupported on any backend":
        # @req REQ-SSPEC-UNIT
        step("guard passes for Unsupported on any backend")
        val caps = sendfile_caps_portable("poll-socket")
        expect(sendfile_guard_ok(caps, SendfileBackend.Unsupported)).to_equal(true)
