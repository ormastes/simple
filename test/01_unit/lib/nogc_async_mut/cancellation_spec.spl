# @Feature G9: Cooperative cancellation tokens
# @Description: Exercises the REAL std.async.cancellation.CancellationToken
# (not a local text-matching stub or an in-spec re-implementation). Prior to
# this spec the type had never been constructed by any test: async_spec.spl
# tested a hand-rolled local `class CancellationToken` stub with an
# unrelated field layout, and async_host_spec.spl only grepped the source
# text of handle.spl/joinset.spl for method signatures. Both masked that
# `CancellationToken.new()` did not exist and that `cancel()` silently
# failed to propagate under `bin/simple test` (see
# doc/08_tracking/bug/interpreter_module_array_stale_read_via_free_fn_helper_2026-07-29.md).

use std.async.cancellation.{CancellationToken, token_new}

describe "CancellationToken (real module, both constructors)":
    it "starts not cancelled":
        val t = CancellationToken.new()
        expect(t.is_cancelled()).to_equal(false)

    it "cancel() flips is_cancelled() on the same token":
        var t = CancellationToken.new()
        expect(t.is_cancelled()).to_equal(false)
        t.cancel()
        expect(t.is_cancelled()).to_equal(true)

    it "token_new() free-function constructor behaves the same as .new()":
        var t = token_new()
        expect(t.is_cancelled()).to_equal(false)
        t.cancel()
        expect(t.is_cancelled()).to_equal(true)

    it "cancelling a parent is observed by an existing child":
        var parent = token_new()
        var child = parent.child()
        expect(child.is_cancelled()).to_equal(false)
        parent.cancel()
        expect(child.is_cancelled()).to_equal(true)

    it "cancelling a child does not cancel its parent":
        var parent = token_new()
        var child = parent.child()
        child.cancel()
        expect(child.is_cancelled()).to_equal(true)
        expect(parent.is_cancelled()).to_equal(false)

    it "cancelling one child does not affect an unrelated sibling":
        var parent = token_new()
        var sib_a = parent.child()
        var sib_b = parent.child()
        sib_a.cancel()
        expect(sib_a.is_cancelled()).to_equal(true)
        expect(sib_b.is_cancelled()).to_equal(false)
        expect(parent.is_cancelled()).to_equal(false)

    # NOTE: a 3rd token allocated after `mid` (whether or not it is
    # `mid`'s own child, or a wholly unrelated token via token_new())
    # makes a *later* `mid.is_cancelled()` call read a stale registry
    # snapshot and wrongly return false, even though the direct
    # parent/child case above (2 tokens total) is correct. Root cause is
    # still open — see
    # doc/08_tracking/bug/cancellation_token_two_level_propagation_stale_after_third_alloc_2026-07-29.md.
    # Intentionally not asserted here: depth-1 propagation is fixed and
    # covered above; depth-2+ is a known, filed limitation, not silently
    # claimed to work.

    it "allocates well past the old fixed 64-slot registry cap":
        # The registry used to be a hardcoded 64-element array with no
        # growth; the 65th token allocated in the process crashed on an
        # out-of-bounds index. Confirms the growable-array fix.
        var i = 0
        var last = token_new()
        while i < 200:
            last = token_new()
            i = i + 1
        expect(last.is_cancelled()).to_equal(false)
        last.cancel()
        expect(last.is_cancelled()).to_equal(true)

    it "guard_future() reflects cancellation state":
        var t = token_new()
        val before = t.guard_future()
        expect(before.is_ready()).to_equal(false)
        t.cancel()
        val after = t.guard_future()
        expect(after.is_ready()).to_equal(true)
