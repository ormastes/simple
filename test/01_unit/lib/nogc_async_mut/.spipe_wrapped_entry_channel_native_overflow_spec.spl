# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_channel_new() -> i64
extern fn rt_channel_send(channel_id: i64, value: i64)
extern fn rt_channel_try_recv(channel_id: i64) -> i64
extern fn rt_channel_close(channel_id: i64)
extern fn rt_exit(code: i32)

fn main():
    describe "Native channel overflow":
        it "preserves messages beyond the old fixed native ring size":
            # @req REQ-SSPEC-LIB
            step("send 1100 values, assert FIFO receive of every value")
            val channel_id = rt_channel_new()
            var sent = 1
            while sent <= 1100:
                rt_channel_send(channel_id, sent)
                sent = sent + 1

            var received = 1
            var mismatches = 0
            while received <= 1100:
                val value = rt_channel_try_recv(channel_id)
                if value != received:
                    mismatches = mismatches + 1
                received = received + 1

            rt_channel_close(channel_id)
            expect(mismatches).to_equal(0)

        it "reports drain-after-close as the sentinel miss value":
            # @req REQ-SSPEC-LIB
            step("close an empty channel and probe try_recv")
            val channel_id = rt_channel_new()
            rt_channel_send(channel_id, 7)
            expect(rt_channel_try_recv(channel_id)).to_equal(7)
            rt_channel_close(channel_id)
            expect(rt_channel_try_recv(channel_id)).to_be_nil()
