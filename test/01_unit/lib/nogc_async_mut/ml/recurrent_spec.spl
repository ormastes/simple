# PyTorch Recurrent Layer Tests
# Feature: ML Recurrent Neural Networks
# Category: ML, Neural Networks
# Status: Complete
#
# Tests for ml.torch.nn recurrent modules including RNN, LSTM, GRU,
# and packed sequence processing.

## Operator workflow
Run `bin/simple test test/unit/lib/nogc_async_mut/ml/recurrent_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

describe "Standard library comprehensive behavior":
    it "text primitives agree on a fixed fixture":
        step("Verify: text primitives agree on a fixed fixture")
        # @req: REQ-LIB-LIB_GENERIC-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.replace("Language", "Runtime")).to_equal("Simple Runtime")  # oracle: substitution applies

    it "collections keep insertion order and value semantics":
        step("Verify: collections keep insertion order and value semantics")
        # @req: REQ-LIB-LIB_GENERIC-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows by one
        expect(original.len()).to_equal(2)  # oracle: the original binding is unmodified

describe "RNN Layers":
    # Tests for recurrent neural network layers (RNN, LSTM, GRU).
    context "RNN":
        it "creates RNN layer":
            val rnn_layer = MockRNN(input_size: 10, hidden_size: 20, num_layers: 1)
            expect rnn_layer.input_size == 10
            expect rnn_layer.hidden_size == 20

    context "LSTM":
        it "creates LSTM layer":
            val lstm_layer = MockLSTM(input_size: 10, hidden_size: 20, num_layers: 1)
            expect lstm_layer.input_size == 10
            expect lstm_layer.hidden_size == 20

    context "GRU":
        it "creates GRU layer":
            val gru_layer = MockGRU(input_size: 10, hidden_size: 20, num_layers: 1)
            expect gru_layer.input_size == 10
            expect gru_layer.hidden_size == 20

    context "sequence processing":
        it "processes sequences with LSTM":
            val lstm = MockLSTM(input_size: 5, hidden_size: 10, num_layers: 1)
            expect lstm.hidden_size == 10

    context "advanced":
        it "handles packed sequences":
            val packed = MockPackedSequence.new(100, 5)
            expect packed.is_packed()
            expect packed.num_sequences == 5
