extern fn rt_file_read_text(path: text) -> text

fn executor_source() -> text:
    rt_file_read_text("src/lib/nogc_async_mut/async/executor.spl") ?? ""

describe "Executor ready queue storage":
    it "uses a consumed-prefix cursor instead of slicing every task":
        val src = executor_source()
        expect(src.contains("ready_head: usize")).to_equal(true)
        expect(src.contains("self.ready_queue[self.ready_head]")).to_equal(true)
        expect(src.contains("self.ready_queue = self.ready_queue[1:]")).to_equal(false)
        expect(src.contains("self.ready_queue = self.ready_queue[self.ready_head:]")).to_equal(true)
        expect(src.contains("self.ready_head * 2")).to_equal(false)
        expect(src.contains("self.ready_queue.len() - self.ready_head")).to_equal(true)
