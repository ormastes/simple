"""
## Purpose and audience
Caret and smux print through the SOSIX console boundary. These scenarios keep
that path working on every hosted platform, including Windows where the
interpreter's descriptors are HANDLEs and 0..2 name the standard streams.
"""
# @manual_section: SOSIX console output
use std.spec.*
use std.sosix.stdio.{sosix_print_raw_checked, sosix_eprint_checked}
use std.nogc_sync_mut.sffi.fs.{io_file_write, io_file_write_all}

describe "SOSIX console output":
    it "writes raw UTF-8 text to standard output":
        # @req REQ-CMUX-009
        step("Print raw Unicode text through the checked console API")
        val written = sosix_print_raw_checked("console-界😀\n")
        expect(written.is_ok()).to_be(true)

    it "writes an error line to standard error":
        # @req REQ-CMUX-009
        step("Print one line through the checked error API")
        val written = sosix_eprint_checked("console-err")
        expect(written.is_ok()).to_be(true)

    it "reaches both standard streams by descriptor number":
        # @req REQ-CMUX-009
        step("Write bytes directly to descriptors 1 and 2")
        val bytes: [u8] = [111u8, 107u8, 10u8]
        expect(io_file_write(1, bytes)).to_equal(3)  # oracle: three bytes were passed
        expect(io_file_write_all(2, bytes)).to_be(true)
