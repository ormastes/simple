use std.spec
use std.nogc_async_mut.sosix.{sosix_env_get_nullable}

describe "SOSIX hosted environment":
    it "preserves a nullable lookup for compiler callers":
        val path = sosix_env_get_nullable("PATH")
        step("Then a present host variable is observable")
        assert_true(path != nil)
        expect((path ?? "").len()).to_be_greater_than(0)
        step("And an absent host variable remains nil")
        expect(sosix_env_get_nullable("SIMPLE_SOSIX_ENV_ABSENT_20260928")).to_be_nil()
