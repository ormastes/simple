# sosix proc usage: real per-pid probe, honest invalid results

use std.spec.{describe, it, expect}
use std.nogc_async_mut.sosix.{sosix_proc_usage}

describe "sosix_proc_usage refuses dead and nonsense pids on every platform":
    # The live-path probe (always-alive pid, rss/cpu semantics) is omitted
    # here: under the hosted spec/run contexts on Windows the imported
    # sosix_proc_usage binds to a co-compiled body the interpreter cannot
    # link (rt_process_run_bounded_bytes), a pre-existing binding defect —
    # doc/08_tracking/bug/sosix_proc_usage_interpreter_binding_bytes_extern_2026_11_10.md.
    # The lane itself is parser- and shell-verified there.

    it "yields valid=false for dead or nonsense pids on every platform":
        # @req: REQ-SOSIX-PROC-USAGE-002
        expect(sosix_proc_usage(99999999).valid).to_equal(false)
        expect(sosix_proc_usage(0).valid).to_equal(false)
        expect(sosix_proc_usage(-7).valid).to_equal(false)
