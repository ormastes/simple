"""SOSIX time leaves stay synchronous and deadline arithmetic never wraps."""

use std.spec.*
use std.nogc_async_mut.sosix.time.{
    sosix_time_monotonic_now_ns, sosix_time_deadline_reached, sosix_time_deadline_after
}

describe "SOSIX time leaves":
    it "reads a monotonic snapshot without an operation":
        # @req REQ-SOSIX-TIME
        step("Take two snapshots in order")
        val first = sosix_time_monotonic_now_ns()
        val second = sosix_time_monotonic_now_ns()
        expect(second >= first).to_be(true)
        expect(first > 0u64).to_be(true)

    it "treats deadline zero as never and saturates instead of wrapping":
        step("A zero deadline is never reached")
        expect(sosix_time_deadline_reached(0u64, 18446744073709551615u64)).to_be(false)
        step("A deadline is reached at and after its instant")
        expect(sosix_time_deadline_reached(100u64, 99u64)).to_be(false)
        expect(sosix_time_deadline_reached(100u64, 100u64)).to_be(true)
        step("A huge timeout saturates at the maximum instant")
        expect(sosix_time_deadline_after(10u64, 20u64)).to_equal(30u64)
        expect(sosix_time_deadline_after(18446744073709551610u64, 100u64)).to_equal(18446744073709551615u64)
