"""The Result-returning `file_read_text_at` stays the one callers get, even when a spec loads the raw SFFI file layer.

`std.spec` loads `std.nogc_sync_mut.sffi.fs`. That module used to define a raw
`file_read_text_at -> text` with the same bare name, and the interpreter bound
calls to it instead of the imported Result version. `match ... case Ok(...)`
then matched nothing and a `-> bool` caller returned nil.
See doc/08_tracking/bug/interpreter_bare_fn_name_collision_file_read_text_at_2026-10-30.md."""

use std.spec.*
use std.nogc_async_mut.io.{file_read_text_at, file_write_text_at, file_remove}
use std.nogc_async_mut.sosix.file_driver.{SosixHostedFileDriver}

fn _read_ok(path: text) -> bool:
    match file_read_text_at(path, 0, 4):
        case Ok(_): true
        case Err(_): false

describe "file_read_text_at under a spec that loads the raw SFFI file layer":
    it "returns Ok for a readable file":
        # @req REQ-SOSIX-FS-HOST-FILE
        val path = "/tmp/simple_read_text_at_collision_spec.txt"
        file_remove(path)
        expect(file_write_text_at(path, 0, "safe")).to_equal(4)
        expect(_read_ok(path)).to_equal(true)
        match file_read_text_at(path, 0, 4):
            case Ok(bytes): expect(bytes).to_equal("safe")
            case Err(error): fail("expected Ok, got Err({error})")
        file_remove(path)

    it "returns Err, not raw text, for a missing file":
        # @req REQ-SOSIX-FS-HOST-FILE
        expect(_read_ok("/tmp/simple_read_text_at_collision_missing.txt")).to_equal(false)

    it "lets the hosted SOSIX driver module load alongside the spec layer":
        # @req REQ-SOSIX-FS-HOST-FILE
        val driver = SosixHostedFileDriver.create()
        expect(driver.services).to_equal(0u64)
