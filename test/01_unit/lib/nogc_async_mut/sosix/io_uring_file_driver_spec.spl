"""Linux C4 acceptance through the SOSIX owner facade.

These examples require the exact provider on Linux. A Linux kernel or runtime
that cannot create io_uring is a hard failure, because selecting the hosted
provider would make the acceptance meaningless.
"""

use std.spec.*
use std.env.platform.{get_temp_dir}
use std.nogc_async_mut.io.{file_remove}
use std.nogc_async_mut.io.{file_write_text_at}
use std.common.contracts.sosix.error_v1.{SOSIX_ERROR_NATIVE}
use std.common.contracts.sosix.wait_v1.{SOSIX_SYNC_WAIT_COMPLETED}
use std.nogc_async_mut.sosix.fs.{SosixHostedFs}
use std.nogc_async_mut.sosix.sync.{sosix_sync_fs_read_at, sosix_sync_fs_write_at}
use std.nogc_async_mut.sosix.file_driver.{SosixLinuxUringFileDriver}
use std.nogc_sync_mut.io_runtime.{platform_name}

fn setup_linux_uring_driver() -> SosixLinuxUringFileDriver:
    if platform_name() != "linux":
        fail("C4 is a Linux-only acceptance")
    val driver = SosixLinuxUringFileDriver.create()
    if not driver.available():
        fail("the exact Linux io_uring backend could not be selected")
    driver

fn require_io_uring_backend(driver: SosixLinuxUringFileDriver):
    expect(driver.backend_name()).to_equal("io_uring")

fn setup_fs() -> SosixHostedFs:
    match SosixHostedFs.create(193u64, 17u64, 2):
        case Ok(fs): fs
        case Err(_):
            fail("SOSIX ring setup failed")
            SosixHostedFs.create(193u64, 17u64, 2).unwrap()

fn scratch_path(name: text) -> text:
    val path = get_temp_dir() + "/sosix_io_uring_" + name + ".txt"
    file_remove(path)
    path

describe "SOSIX Linux io_uring provider":
    it "selects the exact Linux io_uring backend":
        val driver = setup_linux_uring_driver()
        require_io_uring_backend(driver)
        driver.close()

    it "writes and reads positioned bytes through submitted native operations":
        val driver = setup_linux_uring_driver()
        val fs = setup_fs()
        val path = scratch_path("roundtrip")
        val file = driver.open_path(path)
        val source = driver.buffer_from("native uring bytes")
        val written = sosix_sync_fs_write_at(fs, driver, file, source, 3u64, 0u64, 18u64, 0u64)
        expect(written.outcome).to_equal(SOSIX_SYNC_WAIT_COMPLETED)
        expect(written.completion.transferred).to_equal(18u64)
        val sink = driver.buffer_from("")
        val read = sosix_sync_fs_read_at(fs, driver, file, sink, 3u64, 0u64, 18u64, 0u64)
        expect(read.outcome).to_equal(SOSIX_SYNC_WAIT_COMPLETED)
        expect(read.completion.transferred).to_equal(18u64)
        expect(driver.buffer_bytes(sink)).to_equal("native uring bytes")
        driver.close()

    it "preserves partial EOF progress and propagates a native negative errno":
        val driver = setup_linux_uring_driver()
        val fs = setup_fs()
        val path = scratch_path("eof")
        expect(file_write_text_at(path, 0, "abcde")).to_be_greater_than(-1)
        val file = driver.open_path(path)
        val sink = driver.buffer_from("")
        val read = sosix_sync_fs_read_at(fs, driver, file, sink, 3u64, 0u64, 16u64, 0u64)
        expect(read.completion.transferred).to_equal(2u64)
        expect(read.completion.partial_progress).to_equal(true)
        expect(driver.buffer_bytes(sink)).to_equal("de")
        val missing = driver.open_path(path + ".missing")
        val missing_sink = driver.buffer_from("")
        val failed = sosix_sync_fs_read_at(fs, driver, missing, missing_sink, 0u64, 0u64, 4u64, 0u64)
        expect(failed.error.kind).to_equal(SOSIX_ERROR_NATIVE)
        expect(failed.error.native_code).to_be_less_than(0)
        driver.close()

    it "retires a canceled lease exactly once":
        val driver = setup_linux_uring_driver()
        val fs = setup_fs()
        val file = driver.open_path(scratch_path("cancel"))
        val buffer = driver.buffer_from("")
        val submit = fs.read_at(file, buffer, 0u64, 0u64, 4u64, 0u64)
        expect(submit.accepted).to_equal(true)
        val canceled = fs.cancel(submit.operation)
        expect(canceled.accepted).to_equal(true)
        expect(driver.service(fs)).to_equal(true)
        expect(fs.pump()).to_equal(1)
        expect(fs.release(submit.operation).accepted).to_equal(true)
        expect(fs.release(submit.operation).accepted).to_equal(false)
        driver.close()
