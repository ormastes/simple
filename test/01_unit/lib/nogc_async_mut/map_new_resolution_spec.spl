# Purpose and audience: executable specification evidence for the owning engineering team.
# Pins the fix for doc/08_tracking/bug/map_insert_if_absent_missing_and_map_new_resolves_to_dict_2026-07-20.md
# (Map.new -> dict shadowing half): `Map.new()` with the stdlib Map struct imported under its
# own name must construct the struct, not be shadowed into a builtin empty dict.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec
use std.nogc_async_mut.src.map.{Map}

describe "Map.new() resolution with the struct imported as Map":

    it "constructs the Map struct, not a builtin dict":
        # @req REQ-SSPEC-UNIT
        step("construct via Map.new() and exercise struct-only API")
        var m: Map<text, i32> = Map.new()
        expect(m.len()).to_equal(0)
        expect(m.is_empty()).to_equal(true)
        expect(m.insert_if_absent("name", 1)).to_equal(true)
        expect(m.insert_if_absent("name", 2)).to_equal(false)
        expect(m.len()).to_equal(1)
        expect(m.get("name")?).to_equal(1)

    it "exposes the struct's own fields (impossible on a builtin dict receiver)":
        # @req REQ-SSPEC-UNIT
        step("read the size/capacity fields declared on struct Map")
        var m: Map<i64, i64> = Map.new()
        m.insert(7, 70)
        expect(m.size).to_equal(1)
        expect(m.capacity).to_equal(16)

    it "keeps Dict.new() as the builtin empty dict alias":
        # @req REQ-SSPEC-UNIT
        step("builtin alias still available when no struct Dict is in scope")
        var d = Dict.new()
        d.insert("k", 1)
        expect(d.len()).to_equal(1)
