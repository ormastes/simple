# Prevention: game3d enum -> i32 conversions must return the declared discriminant.
# Class: `self as i32` on a payload-free enum returns an address-like garbage value
# under the interpreter, so every to_i32() is an explicit match.
use std.spec.*
use std.nogc_async_mut.game3d.key_codes.*
use std.nogc_async_mut.game3d.event.*
use std.nogc_async_mut.game3d.component.*

describe "game3d enum discriminants":
    it "KeyCode keeps declared values":
        expect(KeyCode.Unknown.to_i32()).to_equal(0)
        expect(KeyCode.Space.to_i32()).to_equal(32)
        expect(KeyCode.A.to_i32()).to_equal(65)
        expect(KeyCode.Z.to_i32()).to_equal(90)

    it "MouseButton keeps declared values":
        expect(MouseButton.Left.to_i32()).to_equal(0)
        expect(MouseButton.Button5.to_i32()).to_equal(4)

    it "GameEventType keeps declared values":
        expect(GameEventType.Custom.to_i32()).to_equal(0)
        expect(GameEventType.TimerExpired.to_i32()).to_equal(9)

    it "ComponentTag values are distinct":
        expect(ComponentTag.Transform.to_i32() != ComponentTag.Render.to_i32()).to_equal(true)
