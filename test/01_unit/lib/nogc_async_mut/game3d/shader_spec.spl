# @platform: wasm
# @category: platform
# Shader Abstraction Tests
# Feature: Game Engine Shader System
# Category: Game Engine, Graphics
# Status: Complete
#
# Mock implementation for testing shader functionality including
# shader compilation, uniforms, and shader program linking.

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

# Mock Shader
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")
class Shader:
    name: text
    source: text
    compiled: bool

1. Run `bin/simple test test/01_unit/lib/nogc_async_mut/game3d/shader_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/shader.md
# doc-path: doc/03_plan/sys_test/shader.md
# doc-path: doc/04_architecture/shader.md
# doc-path: doc/05_design/shader.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-LIB-GAME3D-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-LIB-GAME3D-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-LIB-GAME3D-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-LIB-GAME3D-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-LIB-GAME3D-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

    fn get_uniform_count() -> i64:
        self.uniforms.len()

describe "ShaderSystem":
    # Tests for shader system including compilation, uniforms, and program linking.
    it "creates shaders":
        val vertex = Shader.new("vertex", "vertex_code")
        val fragment = Shader.new("fragment", "fragment_code")
        check(vertex.name == "vertex")
        check(fragment.name == "fragment")

    it "compiles shaders":
        val shader = Shader.new("test", "shader_code")
        shader.compile()
        check(shader.is_compiled() == true)

    it "sets shader uniforms":
        val uniform = ShaderUniform.new("color", "vec4")
        uniform.set_value("1.0, 1.0, 1.0, 1.0")
        check(uniform.get_value() == "1.0, 1.0, 1.0, 1.0")

    it "handles shader programs":
        val vs = Shader.new("vertex", "vs_code")
        val fs = Shader.new("fragment", "fs_code")
        val program = ShaderProgram.new(vs, fs)
        program.link()
        check(program.is_linked() == true)

    it "handles shader includes":
        val vs = Shader.new("vertex", "vs_code")
        val fs = Shader.new("fragment", "fs_code")
        val program = ShaderProgram.new(vs, fs)
        val uniform = ShaderUniform.new("projection", "mat4")
        program.add_uniform(uniform)
        check(program.get_uniform_count() == 1)
