"""QUIC packet AEAD spec — pure-Simple binary AES-128-GCM (RFC 9001 §5.3).

quic_aead_encrypt/decrypt are wired to std.common.crypto.aes_gcm (binary domain)
instead of the hex externs. Uses the RFC 9001 §A.2 Client Initial key + iv with
packet number 2 (nonce = iv XOR pn = ...255e); the ciphertext+tag is cross-checked
against OpenSSL AES-128-GCM, and decrypt round-trips the plaintext.
"""

use std.io.quic.quic_crypto.{quic_aead_encrypt, quic_aead_decrypt, QuicPacketKeys}

fn _keys() -> QuicPacketKeys:
    val key: [u8] = [0x1fu8, 0x36u8, 0x96u8, 0x13u8, 0xddu8, 0x76u8, 0xd5u8, 0x46u8,
                      0x77u8, 0x30u8, 0xefu8, 0xcbu8, 0xe3u8, 0xb1u8, 0xa2u8, 0x2du8]
    val iv: [u8] = [0xfau8, 0x04u8, 0x4bu8, 0x2fu8, 0x42u8, 0xa3u8, 0xfdu8, 0x3bu8, 0x46u8, 0xfbu8, 0x25u8, 0x5cu8]
    val hp: [u8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    QuicPacketKeys(aead_key: key, iv: iv, hp_key: hp)

fn _header() -> [u8]:
    [0xc3u8, 0x00u8, 0x00u8, 0x00u8, 0x01u8, 0x08u8, 0x83u8, 0x94u8,
     0xc8u8, 0xf0u8, 0x3eu8, 0x51u8, 0x57u8, 0x08u8, 0x00u8, 0x00u8,
     0x44u8, 0x9eu8, 0x00u8, 0x00u8, 0x00u8, 0x02u8]

fn _payload() -> [u8]:
    [0x01u8, 0x02u8, 0x03u8, 0x04u8]

val _EXPECT_CT = "d6b38a7873b8d79ee6855b9ddc6d15e663365f87"

fn _enc() -> text:
    quic_aead_encrypt(_keys(), 2, _header(), _payload())

fn _dec() -> text:
    val ct: [u8] = [0xd6u8, 0xb3u8, 0x8au8, 0x78u8, 0x73u8, 0xb8u8, 0xd7u8, 0x9eu8,
                    0xe6u8, 0x85u8, 0x5bu8, 0x9du8, 0xdcu8, 0x6du8, 0x15u8, 0xe6u8,
                    0x63u8, 0x36u8, 0x5fu8, 0x87u8]
    quic_aead_decrypt(_keys(), 2, _header(), ct)

fn _dec_tampered() -> text:
    val ct: [u8] = [0xd7u8, 0xb3u8, 0x8au8, 0x78u8, 0x73u8, 0xb8u8, 0xd7u8, 0x9eu8,
                    0xe6u8, 0x85u8, 0x5bu8, 0x9du8, 0xdcu8, 0x6du8, 0x15u8, 0xe6u8,
                    0x63u8, 0x36u8, 0x5fu8, 0x87u8]
    quic_aead_decrypt(_keys(), 2, _header(), ct)

describe "QUIC packet AEAD — binary AES-128-GCM (RFC 9001 §5.3, §A.2 keys)":

    it "encrypts to the OpenSSL-verified ciphertext+tag":
        expect(_enc()).to_equal(_EXPECT_CT)

    it "decrypts (round-trip) back to the plaintext":
        expect(_dec()).to_equal("01020304")

    it "rejects a tampered ciphertext (auth failure -> empty)":
        expect(_dec_tampered()).to_equal("")
