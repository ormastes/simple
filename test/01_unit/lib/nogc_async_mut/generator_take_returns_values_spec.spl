"""
## Purpose and audience
Purpose: Prove that std.generator take.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

# Reproducing spec for
# doc/08_tracking/bug/generator_take_returns_empty_after_name_collision_fix_2026-08-17.md
#
# RED before the fix:
#   take(generate_range(0, 3), 2) -> []            (len 0, exit 0, no diagnostic)
# because src/lib/common/iterator/reduce.spl's iter_collect was a stub that
# returned a bare `[]`, and transform.spl's iter_take was the identity function.
#
# This runs the REAL public API, unlike the pre-existing generator_spec.spl
# which only grepped the source text for the names and therefore stayed green
# through the entire outage.

use std.generator.{generate_range, generate_repeat, take}

use std.spec.step

describe "std.generator take":
    it "returns the first n values, not an empty array":
        step("Verify: returns the first n values, not an empty array")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val r = take(generate_range(0, 3), 2)

        expect(r.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(r[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(r[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "stops at the end of the range when n exceeds it":
        step("Verify: stops at the end of the range when n exceeds it")
        val r = take(generate_range(0, 3), 10)

        expect(r.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(r[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(r[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(r[2]).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "bounds an infinite generator instead of hanging or yielding nothing":
        step("Verify: bounds an infinite generator instead of hanging or yielding nothing")
        val r = take(generate_repeat(7), 3)

        expect(r.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(r[0]).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(r[2]).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "yields nothing only when nothing was asked for":
        step("Verify: yields nothing only when nothing was asked for")
        val r = take(generate_range(0, 5), 0)

        expect(r.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
