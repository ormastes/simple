use std.ndarray.*

describe "NDArray empty public reductions":
    it "returns neutral values instead of unwrapping errors":
        val empty = array([])
        expect(empty.sum()).to_equal(Float64.new(0.0))
        expect(empty.mean()).to_equal(Float64.new(0.0))
        expect(empty.min()).to_equal(Float64.new(0.0))
        expect(empty.max()).to_equal(Float64.new(0.0))
        expect(empty.argmax()).to_equal(Index.new(0))
        # Bind chain results to vals before further calls on `empty`: a method
        # chain ending in `.len()` (-> Index) pollutes the receiver's inferred
        # type for later method calls in the same example (compiler bug,
        # doc/08_tracking/bug/method_chain_poisons_receiver_type_2026-09-16.md).
        val sums = empty.sum_axis(Axis.new(0))
        val means = empty.mean_axis(Axis.new(0))
        expect(sums.len()).to_equal(Index.new(0))
        expect(means.len()).to_equal(Index.new(0))
        val empty_f32 = array_f32([])
        expect(empty_f32.sum_f32()).to_equal(Float32.new(0.0))
        expect(empty_f32.mean_f32()).to_equal(Float32.new(0.0))
