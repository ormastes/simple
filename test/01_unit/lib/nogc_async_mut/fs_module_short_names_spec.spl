use std.spec.*
use std.fs

# Specs run in the nogc_async_mut family, where `std.fs` resolves to
# nogc_async_mut/fs.spl. The module-alias short names (`fs.exists`,
# `fs.read_text`, ...) used to exist only in the nogc_sync_mut twin, so the
# call fell through to UFCS and died with "expects 1 argument(s), but 2 were
# provided".
describe "std.fs module-alias short names":
    it "fs.exists answers for a present and an absent path":
        expect(fs.exists("test/01_unit/lib/nogc_async_mut/fs_module_short_names_spec.spl")).to_equal(true)
        expect(fs.exists("build/spec_tmp/fs_short_names/definitely_absent.txt")).to_equal(false)

    it "fs.write_text then fs.read_text and fs.read_to_text round-trip":
        val path = "build/spec_tmp/fs_short_names/rt.txt"
        expect(fs.write_text(path, "round trip")).to_equal(true)
        expect(fs.read_text(path)).to_equal("round trip")
        expect(fs.read_to_text(path)).to_equal("round trip")

    it "fs.read_text of a missing file is empty text":
        expect(fs.read_text("build/spec_tmp/fs_short_names/never_written.txt")).to_equal("")
