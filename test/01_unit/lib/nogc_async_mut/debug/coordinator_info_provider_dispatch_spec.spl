use std.spec.*
use std.nogc_async_mut.mcp.session.{SessionManager}
use std.nogc_async_mut.debug.coordinator.{DebugCoordinator}
use std.debug.formats.debug_provider.{DebugInfoProvider}
use std.debug.formats.debug_types.{
    SourceLocation, DebugLineEntry, DebugFunction, DebugVariable,
    DebugCompilationUnit, DebugFormatKind
}

class FixtureDebugInfoProvider:
    static fn create() -> FixtureDebugInfoProvider:
        FixtureDebugInfoProvider()

impl DebugInfoProvider for FixtureDebugInfoProvider:
    fn format_kind() -> DebugFormatKind: DebugFormatKind.Dwarf
    fn addr_to_source(addr: i64) -> SourceLocation?:
        Some(SourceLocation(file: "fixture.spl", line: addr, column: 0))
    fn source_to_addr(file: text, line: i64) -> i64?:
        if file == "fixture.spl": Some(line + 100) else: nil
    fn function_at(addr: i64) -> DebugFunction?: nil
    fn functions_in_range(low: i64, high: i64) -> [DebugFunction]: []
    fn locals_at(addr: i64) -> [DebugVariable]: []
    fn compilation_units() -> [DebugCompilationUnit]: []
    fn line_entries() -> [DebugLineEntry]: []

describe "DebugCoordinator info provider dispatch":
    it "preserves both mapping methods across the optional provider boundary":
        val coordinator = DebugCoordinator.with_session_manager(SessionManager.empty())
        coordinator.register_info_provider(FixtureDebugInfoProvider.create())
        val location = coordinator.resolve_source(41)
        expect(location != nil).to_equal(true)
        expect(location!.file).to_equal("fixture.spl")
        expect(location!.line).to_equal(41)
        expect(coordinator.resolve_addr("fixture.spl", 23)!).to_equal(123)
