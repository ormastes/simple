# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/len_bounded_byte_scanners_non_ascii_2026_11_14.md
# unescape_mi_string bounded its byte scan with raw.len() (code points), so an
# escape after a non-ASCII character was cut off or mis-decoded.

use std.spec.step

use std.nogc_async_mut.debug.remote.protocol.gdb_mi_parser.{GdbMiParser, GdbMiRecord}

describe "GdbMiParser (async) escape decoding after non-ASCII text":
    it "decodes a newline escape that follows a multi-byte character":
        # @req REQ-SSPEC-UNIT
        step("parse a result record whose quoted value is éé, an escaped newline, then X")
        val r = GdbMiParser.parse_line("^done,value=\"éé\\nX\"")
        match r:
            GdbMiRecord.Result(token, cls, data):
                expect(cls).to_equal("done")
                expect(data["value"]).to_equal("éé\nX")
            _:
                expect(false).to_be(true)

    it "decodes an escape that sits past the code-point count":
        # @req REQ-SSPEC-UNIT
        step("unescape a raw MI string whose escape sits past the code-point count")
        expect(GdbMiParser.unescape_mi_string("éé\\\"")).to_equal("éé\"")
