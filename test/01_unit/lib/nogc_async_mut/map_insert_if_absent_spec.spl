# Purpose and audience: executable specification evidence for the owning engineering team.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec
use std.nogc_async_mut.src.hash.*
use std.nogc_async_mut.src.map.{Map}

describe "nogc_async_mut pure Map insert_if_absent":

    """
    Purpose: this manual pins the behavior named "nogc_async_mut pure Map insert_if_absent":
" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    it "inserts missing keys without overwriting existing values":
        # @req REQ-SSPEC-UNIT
        step("inserts missing keys without overwriting existing values")
        var map: Map<text, i32> = Map.new()

        expect(map.insert_if_absent("name", 1)).to_equal(true)
        expect(map.len()).to_equal(1)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        expect(map.get("name")?).to_equal(1)  # oracle: authoritative expected value documented in the plan/bug record this spec pins

        expect(map.insert_if_absent("name", 2)).to_equal(false)
        expect(map.len()).to_equal(1)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        expect(map.get("name")?).to_equal(1)  # oracle: authoritative expected value documented in the plan/bug record this spec pins

        expect(map.insert_if_absent("other", 3)).to_equal(true)
        expect(map.len()).to_equal(2)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        expect(map.get("other")?).to_equal(3)  # oracle: authoritative expected value documented in the plan/bug record this spec pins

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)