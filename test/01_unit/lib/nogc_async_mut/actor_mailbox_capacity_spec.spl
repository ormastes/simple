use std.spec.*
use std.nogc_async_mut.actor.mailbox.{actor_mailbox_effective_capacity, actor_mailbox_can_accept}

describe "ActorMailbox finite-capacity admission":
    it "maps the former unbounded zero sentinel to the policy default":
        expect(actor_mailbox_effective_capacity(0)).to_equal(256)

    it "maps negative capacity to the policy default":
        expect(actor_mailbox_effective_capacity(-4)).to_equal(256)

    it "preserves an explicit finite caller capacity":
        expect(actor_mailbox_effective_capacity(17)).to_equal(17)

    it "admits exactly the bounded pending range":
        expect(actor_mailbox_can_accept(0, 2)).to_equal(true)
        expect(actor_mailbox_can_accept(1, 2)).to_equal(true)
        expect(actor_mailbox_can_accept(2, 2)).to_equal(false)

    it "never treats malformed counters or capacity as unbounded":
        expect(actor_mailbox_can_accept(-1, 2)).to_equal(false)
        expect(actor_mailbox_can_accept(0, 0)).to_equal(false)
