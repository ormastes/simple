"""Actual Rc count/lifetime assertions; requires the RcBox runtime provider.

Arc upgrades remain unqualified until ArcBox has an atomic nonzero-acquire
operation. These tests do not certify native provider availability.
"""

use std.spec.*
use std.nogc_async_mut.rc.{Rc}

describe "Rc weak owner acquisition":
    it "returns an owner that keeps the value alive and releases its count":
        var original = Rc.new(73)
        var weak = original.downgrade()
        var acquired = weak.upgrade_rc().unwrap()
        expect(original.strong_count()).to_equal(2)
        original.drop()
        expect(acquired.strong_count()).to_equal(1)
        expect(acquired.borrow()).to_equal(73)
        acquired.drop()
        expect(weak.strong_count()).to_equal(0)
        expect(weak.upgrade_rc()).to_be_nil()
        weak.drop()

    it "does not retain an unreleaseable count when copying a legacy payload":
        var original = Rc.new(19)
        var weak = original.downgrade()
        expect(weak.upgrade().unwrap()).to_equal(19)
        expect(original.strong_count()).to_equal(1)
        original.drop()
        expect(weak.upgrade()).to_be_nil()
        weak.drop()
