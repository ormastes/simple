# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Concurrent Data Structures Test Suite
#
# Comprehensive tests for lock-free queues, concurrent maps,
# and synchronization primitives (std.concurrent).

use std.concurrent.{mpsc_queue_new, mpmc_queue_with_capacity, concurrent_map_new, atomic_flag_new, once_new, barrier_new}


# ============================================================================
# MpscQueue<T> Tests
# ============================================================================

describe "MpscQueue<T>":
    # @manual scenario evidence
    it "should create empty queue":
        # @req REQ-SSPEC-LIB
        step("should create empty queue")
        var queue = mpsc_queue_new()
        expect queue.is_empty() == true

    it "should start with no items":
        # @req REQ-SSPEC-LIB
        step("should start with no items")
        var queue = mpsc_queue_new()
        expect queue.len() == 0

    it "should push and pop single item":
        # @req REQ-SSPEC-LIB
        step("should push and pop single item")
        var queue = mpsc_queue_new()
        queue.push(42)
        val value = queue.pop()
        expect value == 42

    it "should maintain FIFO order":
        # @req REQ-SSPEC-LIB
        step("should maintain FIFO order")
        var queue = mpsc_queue_new()
        queue.push(1)
        queue.push(2)
        queue.push(3)
        expect queue.pop() == 1
        expect queue.pop() == 2
        expect queue.pop() == 3

    it "should handle multiple push/pop cycles":
        # @req REQ-SSPEC-LIB
        step("should handle multiple push/pop cycles")
        var queue = mpsc_queue_new()
        queue.push(10)
        expect queue.pop() == 10
        queue.push(20)
        expect queue.pop() == 20
        queue.push(30)
        expect queue.pop() == 30

    it "should work with complex types":
        # @req REQ-SSPEC-LIB
        step("should work with complex types")
        var queue = mpsc_queue_new()
        queue.push("hello")
        expect queue.pop() == "hello"

    it "should return None when empty":
        # @req REQ-SSPEC-LIB
        step("should return None when empty")
        var queue = mpsc_queue_new()
        val value = queue.pop()
        expect value == nil

    it "should detect empty state":
        # @req REQ-SSPEC-LIB
        step("should detect empty state")
        var queue = mpsc_queue_new()
        expect queue.is_empty() == true
        queue.push(1)
        expect queue.is_empty() == false

    it "should handle many items":
        # @req REQ-SSPEC-LIB
        step("should handle many items")
        var queue = mpsc_queue_new()
        for i in 0..100:
            queue.push(i)
        expect queue.len() >= 100

# ============================================================================
# MpmcQueue<T> Tests
# ============================================================================

describe "MpmcQueue<T>":
    it "should create queue with capacity":
        # @req REQ-SSPEC-LIB
        step("should create queue with capacity")
        var queue = mpmc_queue_with_capacity(10)
        expect queue.is_empty() == true

    it "should start with length 0":
        # @req REQ-SSPEC-LIB
        step("should start with length 0")
        var queue = mpmc_queue_with_capacity(5)
        expect queue.len() == 0

    it "should push and pop single item":
        # @req REQ-SSPEC-LIB
        step("should push and pop single item")
        var queue = mpmc_queue_with_capacity(5)
        val pushed = queue.push(42)
        expect pushed == true
        val value = queue.pop()
        expect value == 42

    it "should respect capacity limit":
        # @req REQ-SSPEC-LIB
        step("should respect capacity limit")
        var queue = mpmc_queue_with_capacity(2)
        expect queue.push(1) == true
        expect queue.push(2) == true
        expect queue.push(3) == false  # Over capacity

    it "should maintain FIFO order":
        # @req REQ-SSPEC-LIB
        step("should maintain FIFO order")
        var queue = mpmc_queue_with_capacity(10)
        queue.push(1)
        queue.push(2)
        queue.push(3)
        expect queue.pop() == 1
        expect queue.pop() == 2
        expect queue.pop() == 3

    it "should return None when empty":
        # @req REQ-SSPEC-LIB
        step("should return None when empty")
        var queue = mpmc_queue_with_capacity(5)
        expect queue.pop() == nil

    it "should allow reuse after drain":
        # @req REQ-SSPEC-LIB
        step("should allow reuse after drain")
        var queue = mpmc_queue_with_capacity(3)
        queue.push(1)
        queue.push(2)
        queue.pop()
        queue.pop()
        expect queue.push(3) == true

    it "should track length accurately":
        # @req REQ-SSPEC-LIB
        step("should track length accurately")
        var queue = mpmc_queue_with_capacity(10)
        expect queue.len() == 0
        queue.push(1)
        expect queue.len() == 1
        queue.push(2)
        expect queue.len() == 2

# ============================================================================
# ConcurrentMap<K, V> Tests
# ============================================================================

describe "ConcurrentMap<K, V>":
    it "should create empty map":
        # @req REQ-SSPEC-LIB
        step("should create empty map")
        val map = concurrent_map_new()
        expect map.len() == 0

    it "should insert and get value":
        # @req REQ-SSPEC-LIB
        step("should insert and get value")
        val map = concurrent_map_new()
        map.insert("key", 42)
        expect map.get("key") == 42

    it "should return None for missing key":
        # @req REQ-SSPEC-LIB
        step("should return None for missing key")
        val map = concurrent_map_new()
        expect map.get("missing") == nil

    it "should check if key exists":
        # @req REQ-SSPEC-LIB
        step("should check if key exists")
        val map = concurrent_map_new()
        map.insert("exists", 1)
        expect map.has("exists") == true
        expect map.has("missing") == false

    it "should remove values":
        # @req REQ-SSPEC-LIB
        step("should remove values")
        val map = concurrent_map_new()
        map.insert("key", 100)
        val removed = map.remove("key")
        expect removed == 100
        expect map.has("key") == false

    it "should handle multiple keys":
        # @req REQ-SSPEC-LIB
        step("should handle multiple keys")
        val map = concurrent_map_new()
        map.insert("a", 1)
        map.insert("b", 2)
        map.insert("c", 3)
        expect map.len() == 3

    it "should overwrite existing keys":
        # @req REQ-SSPEC-LIB
        step("should overwrite existing keys")
        val map = concurrent_map_new()
        map.insert("key", 1)
        map.insert("key", 2)
        expect map.get("key") == 2

# ============================================================================
# AtomicFlag Tests
# ============================================================================

describe "AtomicFlag":
    it "should create unset flag":
        # @req REQ-SSPEC-LIB
        step("should create unset flag")
        val flag = atomic_flag_new()
        expect flag.is_set() == false

    it "should set flag":
        # @req REQ-SSPEC-LIB
        step("should set flag")
        val flag = atomic_flag_new()
        flag.set()
        expect flag.is_set() == true

    it "should test and set atomically":
        # @req REQ-SSPEC-LIB
        step("should test and set atomically")
        val flag = atomic_flag_new()
        val was_set = flag.test_and_set()
        expect was_set == false
        expect flag.is_set() == true

    it "should clear flag":
        # @req REQ-SSPEC-LIB
        step("should clear flag")
        val flag = atomic_flag_new()
        flag.set()
        flag.clear()
        expect flag.is_set() == false

# ============================================================================
# Once Tests
# ============================================================================

describe "Once":
    it "should create Once":
        # @req REQ-SSPEC-LIB
        step("should create Once")
        val once = once_new()
        expect once.is_completed() == false

    it "should run callback once":
        # @req REQ-SSPEC-LIB
        step("should run callback once")
        val once = once_new()
        var count = 0
        val increment = fn():
            count = count + 1
        once.call_once(increment)
        once.call_once(increment)
        # Note: Due to closure limitations, this test may not verify correctly
        # Just check no crash
        expect once.is_completed() == true

    it "should mark as completed":
        # @req REQ-SSPEC-LIB
        step("should mark as completed")
        val once = once_new()
        once.call_once(fn(): ())
        expect once.is_completed() == true

# ============================================================================
# Barrier Tests
# ============================================================================

describe "Barrier":
    it "should create barrier with count":
        # @req REQ-SSPEC-LIB
        step("should create barrier with count")
        val barrier = barrier_new(2)
        # Just verify creation works
        expect true

    it "should wait for all threads":
        # @req REQ-SSPEC-LIB
        step("should wait for all threads")
        val barrier = barrier_new(1)
        barrier.wait()
        # Single thread case - should complete immediately
        expect true
