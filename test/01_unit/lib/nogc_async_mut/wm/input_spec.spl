"""
## Purpose and audience
Purpose: Prove that WM Input Protocol.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

"""WM Input protocol — keyboard/mouse event FIFO queue per window."""

use std.spec.{describe, it, expect, to_equal, to_be_greater_than, to_contain}
use nogc_async_mut.wm.input.{
    wm_input_queue_new,
    wm_input_push_key,
    wm_input_push_mouse,
    wm_input_push_scroll,
    wm_input_poll,
    wm_input_queue_len,
    WmInputQueue,
    WmKeyEvent,
    WmMouseEvent,
    WmScrollEvent,
    WmInputEntry,
    WmInputPoll
}
use nogc_async_mut.wm.host.{wm_host_2d_reference, wm_host_2d_unavailable}
use std.common.window_protocol.geometry.{Size}

fn _live_host():
    wm_host_2d_reference(Size.wh(1920, 1080), [])

fn _dead_host():
    wm_host_2d_unavailable("test-host", "no backend wired into this unit spec")

use std.spec.step

describe "WM Input Protocol":
    it "starts with an empty queue":
        step("Verify: starts with an empty queue")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val q = wm_input_queue_new()
        expect(wm_input_queue_len(q)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "refuses to poll when the host has no reachable backend, even with events queued":
        step("Verify: refuses to poll when the host has no reachable backend, even with events queued")
        val q = wm_input_queue_new()
        val key = WmKeyEvent(window_id: 1, key_code: 65, scan_code: 30, modifiers: 0, pressed: true)
        val q2 = wm_input_push_key(q, key)
        val p = wm_input_poll(q2, _dead_host())
        expect(p.ok).to_equal(false)
        expect(p.state).to_contain("unavailable:")

    it "pushes a key press event and increments queue length":
        step("Verify: pushes a key press event and increments queue length")
        val q = wm_input_queue_new()
        val key = WmKeyEvent(window_id: 1, key_code: 65, scan_code: 30, modifiers: 0, pressed: true)
        val q2 = wm_input_push_key(q, key)
        expect(wm_input_queue_len(q2)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "pushes a mouse event and increments queue length":
        step("Verify: pushes a mouse event and increments queue length")
        val q = wm_input_queue_new()
        val mouse = WmMouseEvent(window_id: 1, x: 100, y: 200, button: 1, pressed: true)
        val q2 = wm_input_push_mouse(q, mouse)
        expect(wm_input_queue_len(q2)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "polls events in FIFO order":
        step("Verify: polls events in FIFO order")
        val q = wm_input_queue_new()
        val k1 = WmKeyEvent(window_id: 1, key_code: 65, scan_code: 30, modifiers: 0, pressed: true)
        val k2 = WmKeyEvent(window_id: 1, key_code: 66, scan_code: 48, modifiers: 0, pressed: false)
        val q1 = wm_input_push_key(q, k1)
        val q2 = wm_input_push_key(q1, k2)
        val p1 = wm_input_poll(q2, _live_host())
        expect(p1.ok).to_equal(true)
        expect(p1.entry.key_code).to_equal(65)  # oracle: 65 — named expected value from the requirement
        val p2 = wm_input_poll(p1.queue, _live_host())
        expect(p2.entry.key_code).to_equal(66)  # oracle: 66 — named expected value from the requirement
        val p3 = wm_input_poll(p2.queue, _live_host())
        expect(p3.ok).to_equal(false)
        expect(p3.state).to_equal("queue-empty")

    it "records key press and release distinction":
        step("Verify: records key press and release distinction")
        val q = wm_input_queue_new()
        val press = WmKeyEvent(window_id: 2, key_code: 13, scan_code: 28, modifiers: 0, pressed: true)
        val release = WmKeyEvent(window_id: 2, key_code: 13, scan_code: 28, modifiers: 0, pressed: false)
        val q1 = wm_input_push_key(q, press)
        val q2 = wm_input_push_key(q1, release)
        val p1 = wm_input_poll(q2, _live_host())
        expect(p1.entry.pressed).to_equal(true)
        val p2 = wm_input_poll(p1.queue, _live_host())
        expect(p2.entry.pressed).to_equal(false)

    it "records mouse button and position":
        step("Verify: records mouse button and position")
        val q = wm_input_queue_new()
        val mouse = WmMouseEvent(window_id: 3, x: 50, y: 75, button: 3, pressed: true)
        val q2 = wm_input_push_mouse(q, mouse)
        val p = wm_input_poll(q2, _live_host())
        expect(p.ok).to_equal(true)
        expect(p.entry.mouse_x).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(p.entry.mouse_y).to_equal(75)  # oracle: 75 — named expected value from the requirement
        expect(p.entry.button).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "records scroll event with delta":
        step("Verify: records scroll event with delta")
        val q = wm_input_queue_new()
        val scroll = WmScrollEvent(window_id: 1, delta_x: 0, delta_y: 3)
        val q2 = wm_input_push_scroll(q, scroll)
        val p = wm_input_poll(q2, _live_host())
        expect(p.ok).to_equal(true)
        expect(p.entry.delta_y).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "handles mixed key and mouse events in FIFO order":
        step("Verify: handles mixed key and mouse events in FIFO order")
        val q = wm_input_queue_new()
        val key = WmKeyEvent(window_id: 1, key_code: 32, scan_code: 57, modifiers: 0, pressed: true)
        val mouse = WmMouseEvent(window_id: 1, x: 10, y: 20, button: 1, pressed: false)
        val q1 = wm_input_push_key(q, key)
        val q2 = wm_input_push_mouse(q1, mouse)
        val p1 = wm_input_poll(q2, _live_host())
        expect(p1.entry.kind).to_equal("key")
        val p2 = wm_input_poll(p1.queue, _live_host())
        expect(p2.entry.kind).to_equal("mouse")
