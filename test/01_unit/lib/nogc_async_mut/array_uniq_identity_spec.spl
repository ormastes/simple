"""Dynamic distinct values use equality, never display text as identity."""
# @req REQ-004
use std.spec.*
use std.nogc_async_mut.array.array_uniq

describe "dynamic array distinct identity":
    it "retains unequal integer and text values with identical display text":
        val result = array_uniq([1, "1", 1, "1"])
        expect(result.len()).to_equal(2)
        expect(result[0]).to_equal(1)
        expect(result[1]).to_equal("1")

    it "retains unequal boolean and text values with identical display text":
        val result = array_uniq([true, "true", false, "false", true, "false"])
        expect(result.len()).to_equal(4)
        expect(result).to_equal([true, "true", false, "false"])

    it "preserves first occurrence order and repeated equal values":
        expect(array_uniq([3, 1, 3, 2, 1])).to_equal([3, 1, 2])
        expect(array_uniq(["b", "a", "b"])).to_equal(["b", "a"])
        expect(array_uniq([]).len()).to_equal(0)

    it "uses numeric equality for signed zero":
        expect(array_uniq([0.0, -0.0, 0.0]).len()).to_equal(1)
