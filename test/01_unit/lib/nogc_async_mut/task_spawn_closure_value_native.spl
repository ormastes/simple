# Regression: a native closure value handed to rt_pool_submit must run as a
# boxed runtime closure (not be read as a raw [entry, ...] record) and
# rt_pool_join must return the raw i64 result (not re-tagged as v << 3).
use std.nogc_async_mut.thread_pool.{task_spawn}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val h0 = task_spawn(\: 7)
    if h0.join() != 7:
        rt_exit(41)

    val base = 100
    val bump = 23
    val h1 = task_spawn(\: base + bump)
    if h1.join() != 123:
        rt_exit(42)

    val h2 = task_spawn(\: -5)
    if h2.join() != -5:
        rt_exit(43)

    print "PASS task_spawn_closure_value_native"
    0
