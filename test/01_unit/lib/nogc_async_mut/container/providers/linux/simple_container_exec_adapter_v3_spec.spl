# Authored, NOT_RUN. Negative adapter admission only; no native owner is opened.
use std.spec.*
use test.fixtures.container.linux_engine_exec_fixture_v3.*
use test.fixtures.orchestration.simple_container_linux_adapter_fixture_v2.linux_container_adapter_fixture_v2

describe "configured Linux adapter owns exec routing":
    it "refuses scripted owners for both mutation and known-birth observation":
        var adapter = linux_container_adapter_fixture_v2([], [])
        val parent = linux_engine_exec_parent_fixture_v3()
        val installed = linux_engine_exec_installation_fixture_v3()
        val admission = linux_engine_exec_admission_fixture_v3()
        val begun = adapter.exec_begin_v3(parent, installed, admission,
            linux_engine_exec_observation_fixture_v3(), "create")
        expect(begun.error).to_equal("container-exec-scripted-owner-unsupported")
        expect(begun.owner).to_equal(nil)
        val inspected = adapter.exec_inspect_v3(parent, installed, admission)
        expect(inspected.error).to_equal("container-exec-scripted-owner-unsupported")
        expect(inspected.owner).to_equal(nil)

    it "rejects a foreign backend before any installed engine or journal work":
        var adapter = linux_container_adapter_fixture_v2([], [])
        # Deliberately invalid structural fixture. This cannot pass the request
        # guard or become a native factory; no positive runtime claim is made.
        adapter.provider.scripted = false
        var parent = linux_engine_exec_parent_fixture_v3()
        parent.plan.backend = "windows-docker-process"
        val installed = linux_engine_exec_installation_fixture_v3()
        val admission = linux_engine_exec_admission_fixture_v3()
        expect(adapter.exec_begin_v3(parent, installed, admission,
            linux_engine_exec_observation_fixture_v3(), "create").error).to_equal("container-adapter-backend-mismatch")
        expect(adapter.exec_inspect_v3(parent, installed, admission).error).to_equal("container-adapter-backend-mismatch")
