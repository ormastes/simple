# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Bug: doc/08_tracking/bug/len_bounded_byte_scanners_non_ascii_2026_11_14.md
# _engine_json_depth_v1 walked bytes up to source.len() (code points), so a
# non-ASCII value left the closing braces unscanned and valid JSON was refused.

use std.spec.*
use std.nogc_async_mut.container.providers.linux.engine_policy_v1.*

fn _policy_v1() -> LinuxOciEnginePolicyV1:
    LinuxOciEnginePolicyV1(mode: "trusted-local-admin-v1", executable_path: "/usr/bin/podman",
        expected_uid: 1000, expected_graph_root: "/home/test/storage", expected_run_root: "/run/user/1000/storage",
        expected_storage_driver: "overlay")

fn _info_v1(note: text) -> text:
    "{\"host\":{\"note\":\"" + note + "\",\"security\":{\"rootless\":true},\"serviceIsRemote\":false}," +
        "\"store\":{\"graphRoot\":\"/home/test/storage\",\"runRoot\":\"/run/user/1000/storage\"," +
        "\"graphDriverName\":\"overlay\",\"graphOptions\":{}},\"version\":{\"Version\":\"5.0.0\"}" + "}"

describe "Linux OCI engine info JSON depth check on non-ASCII input":
    it "accepts engine info whose host note contains multi-byte characters":
        # @req REQ-SSPEC-UNIT
        step("observe engine info carrying a non-ASCII note")
        match linux_oci_engine_info_observation_v1(_policy_v1(), _info_v1("café ünïcödé"), "a".repeat(64), 1000):
            case Ok(observed): expect(observed.engine_version).to_equal("5.0.0")
            case Err(reason): expect(reason).to_equal("accepted")

    it "accepts the same engine info with an ASCII note (control)":
        # @req REQ-SSPEC-UNIT
        step("observe engine info carrying an ASCII note")
        match linux_oci_engine_info_observation_v1(_policy_v1(), _info_v1("cafe"), "a".repeat(64), 1000):
            case Ok(observed): expect(observed.engine_version).to_equal("5.0.0")
            case Err(reason): expect(reason).to_equal("accepted")
