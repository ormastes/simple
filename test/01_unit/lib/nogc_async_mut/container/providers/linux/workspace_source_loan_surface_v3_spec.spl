# @req REQ-WORKSPACE-SOURCE-LOAN
# AUTHORED/NOT_RUN. Source-boundary regressions, not native ownership tests.
# The forbidden-access fixture separately requires real compiler rejection.
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded

fn workspace_loan_source_v3(relative: text) -> text:
    file_read_regular_no_follow_bounded(relative, 262144).unwrap()

fn workspace_loan_public_functions_v3(source: text) -> [text]:
    var names: [text] = []
    for raw in source.split("\n"):
        val line = raw.trim()
        if line.starts_with("pub fn "):
            val declaration = line.substring(7, line.byte_len())
            names.push(declaration.split("(")[0])
    names

describe "restricted workspace source loan boundary":
    it "exposes exactly the four V2 source operations and genuine-capability factory":
        step("Keep raw source lifecycle and parent authority outside the loan")
        val source = workspace_loan_source_v3("src/lib/nogc_async_mut/container/providers/linux/workspace_source_loan_v3.spl")
        val names = workspace_loan_public_functions_v3(source)
        expect(names.len()).to_equal(5)
        for name in ["agent_invocation_projection_v2", "agent_invocation_program_match_v2", "agent_executable_profile_v2",
                "stage_agent_invocation_v2", "linux_workspace_source_loan_v3"]:
            expect(names.contains(name)).to_equal(true)
        for forbidden in ["pub me ", "pub owner:", "pub source:", "pub reader:", "pub storage:", "pub lease:",
                "-> LinuxWorkspaceSourceOwnerV1", "pub fn close", "pub fn begin_binding", "pub fn retire_native", "pub fn retained_metadata"]:
            expect(source.contains(forbidden)).to_equal(false)

    it "does not expose a raw SourceOwner through the Host V2 state or return":
        step("Carry only the restricted loan through the invocation boundary")
        val leaf = workspace_loan_source_v3("src/lib/nogc_sync_mut/orchestration/host_agent_workspace_execution_v2.spl")
        expect(leaf.contains("source: LinuxWorkspaceSourceLoanV3")).to_equal(true)
        expect(leaf.contains("source: Option<LinuxWorkspaceSourceLoanV3>")).to_equal(true)
        expect(leaf.contains("LinuxWorkspaceSourceOwnerV1")).to_equal(false)
        val shared = workspace_loan_source_v3("src/lib/nogc_sync_mut/orchestration/host_authorized_execution_v2.spl")
        val sections = shared.split("# V2 uses the SAME existing canonical progress registry")
        expect(sections.len()).to_equal(2)
        expect(sections[1].contains("source: Option<LinuxWorkspaceSourceLoanV3>")).to_equal(true)
        expect(sections[1].contains("source: Option<LinuxWorkspaceSourceOwnerV1>")).to_equal(false)

    it "captures the actual stage-returned loan before reading failure or readiness":
        step("Preserve returned loan custody on every stage outcome")
        val source = workspace_loan_source_v3("src/lib/nogc_sync_mut/orchestration/host_agent_workspace_execution_v2.spl")
        val after_stage = source.split("val staged = state.source.stage_agent_invocation_v2(")
        expect(after_stage.len()).to_equal(2)
        val before_outcome = after_stage[1].split("if staged.error")
        expect(before_outcome.len()).to_be_greater_than(1)
        expect(before_outcome[0].contains("state.source = staged.loan")).to_equal(true)
        expect(before_outcome[0].contains("staged.owner")).to_equal(false)

    it "keeps external Host V2 consumers away from raw lifecycle and parent getters":
        step("Use the closed container owner for runtime and retirement")
        val source = workspace_loan_source_v3("src/lib/nogc_sync_mut/orchestration/host_agent_workspace_execution_v2.spl")
        for forbidden in ["state.source.close", "state.source.reader", "state.source.storage", "state.source.lease",
                "state.source.begin_binding", "state.source.retire_native", "state.source.retained_metadata", "state.source.owner"]:
            expect(source.contains(forbidden)).to_equal(false)
