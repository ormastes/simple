# Pure probe translation fixtures. No case launches a live container.
use std.spec.{describe, it, expect, step}
use std.common.contracts.container.host_capability_v1.{
    ContainerHostRequirementV1, CONTAINER_CLIENT_PRIVILEGE_USER_V1,
    CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1, CONTAINER_ISOLATION_NATIVE_V1,
    container_host_admission_reason_v1}
use std.common.contracts.container.runtime_v1.{
    RuntimeProbeV1, RUNTIME_PRIVILEGE_ROOTLESS, RUNTIME_PRIVILEGE_ROOT}
use std.nogc_async_mut.container.providers.linux.oci_runtime_v1.{
    LinuxOciRuntimeProviderV1, OCI_ENGINE_PODMAN}
use std.nogc_async_mut.container.providers.linux.host_capability_v1.{
    linux_rootless_capability_from_probe_v1, linux_rootless_host_capability_v1}

fn rootless_probe() -> RuntimeProbeV1:
    RuntimeProbeV1(provider: "linux-oci-v1", engine: OCI_ENGINE_PODMAN,
        engine_present: true, healthy: true, launch_capable: true,
        privilege: RUNTIME_PRIVILEGE_ROOTLESS, reason: "probe answered")

describe "Linux rootless OCI host capability adapter":
    it "maps a complete live probe observation to the exact Linux route":
        step("inspect host capability")
        val capability = linux_rootless_capability_from_probe_v1(
            rootless_probe(), true, "1000")
        expect(capability.host_os).to_equal("linux")
        expect(capability.guest_os).to_equal("linux")
        expect(capability.provider_id).to_equal("linux-oci-v1:podman")
        expect(capability.isolation_class).to_equal(CONTAINER_ISOLATION_NATIVE_V1)
        expect(capability.client_privilege).to_equal(CONTAINER_CLIENT_PRIVILEGE_USER_V1)
        expect(capability.admin_setup).to_equal(true)
        expect(capability.launch_capable).to_equal(true)
        val requirement = ContainerHostRequirementV1(host_os: "linux",
            guest_os: "linux", isolation_class: CONTAINER_ISOLATION_NATIVE_V1,
            require_unprivileged_client: true)
        expect(container_host_admission_reason_v1(capability, requirement)).to_equal("")

    it "blocks scripted results even when they report launch capability":
        val capability = linux_rootless_capability_from_probe_v1(
            rootless_probe(), false, "1000")
        expect(capability.launch_capable).to_equal(false)
        expect(capability.client_privilege).to_equal(CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1)
        val provider = LinuxOciRuntimeProviderV1.scripted("linux", OCI_ENGINE_PODMAN,
            "/tmp/simple", "boot-1", 1, [])
        expect(linux_rootless_host_capability_v1(provider).reason).to_equal(
            "linux-oci-live-probe-unavailable")

    it "rejects Docker and mismatched probe identity":
        var probe = rootless_probe()
        probe.engine = "docker"
        probe.privilege = RUNTIME_PRIVILEGE_ROOT
        expect(linux_rootless_capability_from_probe_v1(probe, true, "1000").reason).to_equal(
            "linux-rootless-podman-required")
        val provider = LinuxOciRuntimeProviderV1.new("linux", "docker",
            "/tmp/simple", "boot-1", 1, false)
        expect(linux_rootless_host_capability_v1(provider).launch_capable).to_equal(false)
        probe = rootless_probe()
        probe.provider = "another-provider"
        expect(linux_rootless_capability_from_probe_v1(probe, true, "1000").launch_capable).to_equal(false)

    it "blocks live discovery with a state directory that cannot launch":
        val provider = LinuxOciRuntimeProviderV1.new("linux", OCI_ENGINE_PODMAN,
            "", "boot-1", 1)
        expect(linux_rootless_host_capability_v1(provider).reason).to_equal(
            "linux-oci-state-directory-invalid")

    it "preserves rootless prerequisite failures and blocks missing runtime health":
        var probe = rootless_probe()
        probe.launch_capable = false
        probe.reason = "rootless-cgroup-delegation-unavailable"
        val capability = linux_rootless_capability_from_probe_v1(probe, true, "1000")
        expect(capability.launch_capable).to_equal(false)
        expect(capability.reason).to_equal("rootless-cgroup-delegation-unavailable")
        probe = rootless_probe()
        probe.healthy = false
        probe.reason = ""
        expect(linux_rootless_capability_from_probe_v1(probe, true, "1000").reason).to_equal(
            "linux-rootless-launch-unavailable")

    it "rejects root or an unverified caller identity":
        expect(linux_rootless_capability_from_probe_v1(
            rootless_probe(), true, "0").launch_capable).to_equal(false)
        expect(linux_rootless_capability_from_probe_v1(
            rootless_probe(), true, "unknown").reason).to_equal(
            "linux-rootless-user-unavailable")
        expect(linux_rootless_capability_from_probe_v1(
            rootless_probe(), true, "1000x").launch_capable).to_equal(false)
