# AUTHORED_NOT_RUN. milestone_0030 op (ii) route guard (DESIGN 14.6 P2-3): the settled-workspace
# read goes api -> adapter `_fresh` (Err-first) -> fresh owner, with NO fallthrough to
# `self.provider`. Unit level: a non-fresh scripted adapter is refused and the provider executes
# nothing. The genuine `open_fresh_v2` zero-provider-call proof needs a real principal and lives in
# test/03_system/tools/linux_container_read_settled_fresh_v3_spec.spl (env-gated).
# @req REQ-M0030-OP-II-FRESH-ONLY
use std.spec.*
use test.fixtures.orchestration.simple_container_linux_adapter_fixture_v2.*
use test.fixtures.container.simple_container_api_fixture_v2.simple_container_scripted_linux_fixture_v2
use std.nogc_async_mut.container.api_v2.*
use std.common.contracts.container.settled_workspace_read_v3.ContainerSettledWorkspaceBoundsV3

describe "Settled remote-build read never reaches the adapter provider":
    it "refuses a non-fresh adapter through the common API with zero provider calls":
        step("A scripted provider adapter has no fresh owner, so op (ii) must stop at the guard")
        val adapter = linux_container_adapter_fixture_v2([], [1])
        val owner = simple_container_scripted_linux_fixture_v2(linux_container_scope_fixture_v2(), adapter)
        val bounds = ContainerSettledWorkspaceBoundsV3(maximum_bytes: 4096, output_paths: ["bin/app"])
        val refused = simple_container_read_settled_workspace_v3(owner, bounds)
        expect(refused.unwrap_err()).to_equal("linux-workspace-fresh-root-required")
        expect(adapter.provider.executor_call_count()).to_equal(0)
        expect(adapter.provider.scripted_cursor).to_equal(0)

    it "refuses directly on the adapter, again without provider effects":
        val adapter = linux_container_adapter_fixture_v2([], [1])
        val refused = adapter.read_settled_workspace_v3(ContainerSettledWorkspaceBoundsV3(maximum_bytes: 1, output_paths: []))
        expect(refused.unwrap_err()).to_equal("linux-workspace-fresh-root-required")
        expect(adapter.provider.executor_call_count()).to_equal(0)
