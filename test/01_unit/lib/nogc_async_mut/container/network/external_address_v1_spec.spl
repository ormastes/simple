# Pure external-address policy tests (design 11.8). No resolver or socket.
use std.spec.{describe, it, expect}
use std.nogc_async_mut.container.network.external_address_v1.{
    endpoint_external_address_admit_v1, endpoint_external_candidates_admit_v1}

fn _xa_reason(literal: text) -> text:
    val result = endpoint_external_address_admit_v1(literal, false)
    if result.is_ok(): return "ok"
    result.unwrap_err()

describe "endpoint external address policy":
    it "admits public IPv4 and IPv6 literals canonically":
        val v4 = endpoint_external_address_admit_v1("93.184.216.34", false).unwrap()
        expect(v4.family).to_equal(4)
        expect(v4.category).to_equal("public")
        val v6 = endpoint_external_address_admit_v1("2606:2800:220:1::248", false).unwrap()
        expect(v6.family).to_equal(6)
        expect(v6.canonical).to_equal("2606:2800:220:1:0:0:0:248")

    it "rejects loopback, unspecified, link-local, metadata and multicast":
        expect(_xa_reason("127.0.0.1")).to_equal("endpoint-external-loopback")
        expect(_xa_reason("::1")).to_equal("endpoint-external-loopback")
        expect(_xa_reason("0.0.0.0")).to_equal("endpoint-external-unspecified")
        expect(_xa_reason("::")).to_equal("endpoint-external-unspecified")
        expect(_xa_reason("169.254.169.254")).to_equal("endpoint-external-metadata")
        expect(_xa_reason("fd00:ec2::254")).to_equal("endpoint-external-metadata")
        expect(_xa_reason("169.254.1.1")).to_equal("endpoint-external-link-local")
        expect(_xa_reason("fe80::1")).to_equal("endpoint-external-link-local")
        expect(_xa_reason("224.0.0.251")).to_equal("endpoint-external-multicast")
        expect(_xa_reason("ff02::1")).to_equal("endpoint-external-multicast")
        expect(_xa_reason("255.255.255.255")).to_equal("endpoint-external-reserved")

    it "rejects IPv4 embedded in IPv6 and alternate numeric encodings":
        expect(_xa_reason("::ffff:127.0.0.1")).to_equal("endpoint-external-ipv4-mapped-ipv6")
        expect(_xa_reason("::ffff:7f00:1")).to_equal("endpoint-external-ipv4-mapped-ipv6")
        expect(_xa_reason("::ffff:93.184.216.34")).to_equal("endpoint-external-ipv4-mapped-ipv6")
        expect(_xa_reason("::127.0.0.1")).to_equal("endpoint-external-ipv4-compatible-ipv6")
        expect(_xa_reason("64:ff9b::7f00:1")).to_equal("endpoint-external-ipv4-translated-ipv6")
        expect(_xa_reason("2002:7f00:1::1")).to_equal("endpoint-external-ipv4-6to4-ipv6")
        expect(_xa_reason("0177.0.0.1")).to_equal("endpoint-address-noncanonical")
        expect(_xa_reason("2130706433")).to_equal("endpoint-address-noncanonical")
        expect(_xa_reason("0x7f.0.0.1")).to_equal("endpoint-address-noncanonical")
        expect(_xa_reason("fe80::1%en0")).to_equal("endpoint-external-zone-index-rejected")
        expect(_xa_reason("1:2:3:4:5:6:7:8:9")).to_equal("endpoint-external-address-noncanonical")

    it "requires explicit policy for private ranges":
        expect(_xa_reason("10.1.2.3")).to_equal("endpoint-external-private-not-allowed")
        expect(_xa_reason("fd12:3456::1")).to_equal("endpoint-external-private-not-allowed")
        expect(endpoint_external_address_admit_v1("192.168.1.2", true).unwrap().category).to_equal("private")

    it "rejects a whole resolver answer when any candidate is forbidden":
        expect(endpoint_external_candidates_admit_v1(["93.184.216.34", "127.0.0.1"], false).is_err()).to_equal(true)
        expect(endpoint_external_candidates_admit_v1(["93.184.216.34"], false).unwrap().len()).to_equal(1)
        expect(endpoint_external_candidates_admit_v1([], false).is_err()).to_equal(true)
