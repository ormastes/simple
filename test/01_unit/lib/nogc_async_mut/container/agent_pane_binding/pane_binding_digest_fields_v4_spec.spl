# AUTHORED SOURCE-ONLY NOT_RUN. milestone_0022 N4 / milestone_0021 14B: the digest covers every field.
use std.spec.*
use std.common.contracts.container.primary_attach_v1.{HostAgentPaneBindingV4, host_agent_pane_binding_digest_v4}

fn base() -> HostAgentPaneBindingV4:
    HostAgentPaneBindingV4(binding_uid: "binding-a", service_incarnation: "a".repeat(32), session_id: "session-a",
        window_id: "window-a", pane_id: "pane-a", service_epoch: 3)

describe "Host agent pane binding digest":
    it "is stable for the same binding and is 64 hex":
        step("Digest the same value twice")
        val d = host_agent_pane_binding_digest_v4(base()).unwrap()
        expect(d).to_equal(host_agent_pane_binding_digest_v4(base()).unwrap())
        expect(d.len()).to_equal(64)

    it "changes when any single field changes":
        step("Mutate each field in turn and require a different digest")
        val d = host_agent_pane_binding_digest_v4(base()).unwrap()
        var uid = base()
        uid.binding_uid = "binding-b"
        var inc = base()
        inc.service_incarnation = "b".repeat(32)
        var ses = base()
        ses.session_id = "session-b"
        var win = base()
        win.window_id = "window-b"
        var pane = base()
        pane.pane_id = "pane-b"
        var epoch = base()
        epoch.service_epoch = 4
        for changed in [uid, inc, ses, win, pane, epoch]:
            expect(host_agent_pane_binding_digest_v4(changed).unwrap() != d).to_equal(true)

    it "swapping window and pane ids changes the digest":
        step("Fields are keyed, not positional")
        var swapped = base()
        swapped.window_id = "pane-a"
        swapped.pane_id = "window-a"
        expect(host_agent_pane_binding_digest_v4(swapped).unwrap() != host_agent_pane_binding_digest_v4(base()).unwrap()).to_equal(true)
