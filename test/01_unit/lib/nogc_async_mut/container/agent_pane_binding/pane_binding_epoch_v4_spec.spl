# AUTHORED SOURCE-ONLY NOT_RUN. milestone_0022 N4 / milestone_0021 14B+14C: pane binding service_epoch > 0.
use std.spec.*
use std.common.contracts.container.primary_attach_v1.{HostAgentPaneBindingV4, host_agent_pane_binding_validate_v4,
    host_agent_pane_binding_encode_v4}

fn binding_at(epoch: i64) -> HostAgentPaneBindingV4:
    HostAgentPaneBindingV4(binding_uid: "binding-a", service_incarnation: "a".repeat(32), session_id: "session-a",
        window_id: "window-a", pane_id: "pane-a", service_epoch: epoch)

describe "Host agent pane binding epoch":
    it "refuses a negative service epoch in validate and encode":
        step("A negative epoch is never a valid binding and cannot be digested")
        expect(host_agent_pane_binding_validate_v4(binding_at(-1)).unwrap_err()).to_equal("host-agent-pane-binding-epoch-invalid")
        expect(host_agent_pane_binding_encode_v4(binding_at(-1)).unwrap_err()).to_equal("host-agent-pane-binding-epoch-invalid")

    it "refuses epoch zero in validate and encode":
        step("14C: an epoch-0 binding could never adopt nor match a control target, so it is refused before archive")
        expect(host_agent_pane_binding_validate_v4(binding_at(0)).unwrap_err()).to_equal("host-agent-pane-binding-epoch-invalid")
        expect(host_agent_pane_binding_encode_v4(binding_at(0)).unwrap_err()).to_equal("host-agent-pane-binding-epoch-invalid")

    it "admits epoch one and the largest epoch":
        step("The binding rule is > 0, matching adoption and control targets")
        expect(host_agent_pane_binding_validate_v4(binding_at(1)).is_ok()).to_equal(true)
        expect(host_agent_pane_binding_validate_v4(binding_at(9223372036854775807)).is_ok()).to_equal(true)
