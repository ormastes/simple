# AUTHORED SOURCE-ONLY NOT_RUN. milestone_0022 N4 / milestone_0021 14B: live incarnation/epoch comparison.
use std.spec.*
use std.common.contracts.container.primary_attach_v1.{HostAgentPaneBindingV4, host_agent_pane_binding_live_check_v4}

fn base() -> HostAgentPaneBindingV4:
    HostAgentPaneBindingV4(binding_uid: "binding-a", service_incarnation: "a".repeat(32), session_id: "session-a",
        window_id: "window-a", pane_id: "pane-a", service_epoch: 3)

describe "Host agent pane binding live check":
    it "accepts the service's own live incarnation and epoch":
        step("Exact match on both live values")
        expect(host_agent_pane_binding_live_check_v4(base(), "a".repeat(32), 3).is_ok()).to_equal(true)

    it "refuses an older or newer epoch":
        step("A binding issued for another service epoch is stale")
        expect(host_agent_pane_binding_live_check_v4(base(), "a".repeat(32), 4).unwrap_err()).to_equal("attach-binding-mismatch")
        expect(host_agent_pane_binding_live_check_v4(base(), "a".repeat(32), 2).unwrap_err()).to_equal("attach-binding-mismatch")

    it "refuses a different service incarnation":
        step("A restarted service has a new incarnation; the old binding is refused")
        expect(host_agent_pane_binding_live_check_v4(base(), "b".repeat(32), 3).unwrap_err()).to_equal("attach-binding-mismatch")

    it "refuses an invalid binding before comparing":
        step("Validation runs first")
        var bad = base()
        bad.pane_id = ""
        expect(host_agent_pane_binding_live_check_v4(bad, "a".repeat(32), 3).unwrap_err()).to_equal("host-agent-pane-binding-pane-name-invalid")
