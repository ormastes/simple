"""
## Purpose and audience
Purpose: Prove that Monitor stdlib.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

# Monitor spec
#
# Tests for src/lib/monitor.spl

use std.monitor.{
    DownEvent, LinkExitEvent,
    EXIT_NORMAL, EXIT_KILLED, EXIT_CRASHED, EXIT_TIMEOUT,
    monitor, demonitor, link, unlink,
    down_event, link_exit_event, down_is_normal
}

use std.spec.step

describe "Monitor stdlib":
    describe "exit reason constants":
        it "EXIT_NORMAL is defined":
            step("Verify: EXIT_NORMAL is defined")
            # @req: REQ-LIB-NOGC-ASYNC-MUT-001
            expect(EXIT_NORMAL).to_equal("normal")

        it "EXIT_KILLED is defined":
            step("Verify: EXIT_KILLED is defined")
            expect(EXIT_KILLED).to_equal("killed")

        it "EXIT_CRASHED is defined":
            step("Verify: EXIT_CRASHED is defined")
            expect(EXIT_CRASHED).to_equal("crashed")

        it "EXIT_TIMEOUT is defined":
            step("Verify: EXIT_TIMEOUT is defined")
            expect(EXIT_TIMEOUT).to_equal("timeout")

    describe "monitor stub":
        it "returns 0 (stub)":
            step("Verify: returns 0 (stub)")
            val ref = monitor(42)
            expect(ref).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "down_event":
        it "creates DownEvent with fields":
            step("Verify: creates DownEvent with fields")
            val evt = down_event(1, 42, EXIT_NORMAL)
            expect(evt.monitor_ref).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(evt.pid).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(evt.reason).to_equal("normal")

        it "down_is_normal returns true for normal exit":
            step("Verify: down_is_normal returns true for normal exit")
            val evt = down_event(1, 42, EXIT_NORMAL)
            expect(down_is_normal(evt)).to_equal(true)

        it "down_is_normal returns false for crash":
            step("Verify: down_is_normal returns false for crash")
            val evt = down_event(1, 42, EXIT_CRASHED)
            expect(down_is_normal(evt)).to_equal(false)

    describe "link_exit_event":
        it "creates LinkExitEvent with fields":
            step("Verify: creates LinkExitEvent with fields")
            val evt = link_exit_event(99, EXIT_KILLED)
            expect(evt.pid).to_equal(99)  # oracle: 99 — named expected value from the requirement
            expect(evt.reason).to_equal("killed")
