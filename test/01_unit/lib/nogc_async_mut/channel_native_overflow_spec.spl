# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

extern fn rt_channel_new() -> i64
extern fn rt_channel_send(channel_id: i64, value: i64)
extern fn rt_channel_try_recv(channel_id: i64) -> i64
extern fn rt_channel_close(channel_id: i64)
extern fn rt_exit(code: i32)

describe "Native channel overflow":
    # @manual scenario evidence
    it "preserves messages beyond the old fixed native ring size":
        # @req REQ-SSPEC-LIB
        step("preserves messages beyond the old fixed native ring size")
        val channel_id = rt_channel_new()
        var sent = 1
        while sent <= 1100:
            rt_channel_send(channel_id, sent)
            sent = sent + 1

        var received = 1
        var mismatch = 0
        var checksum = 0
        while received <= 1100:
            val value = rt_channel_try_recv(channel_id)
            if value != received:
                mismatch = mismatch + 1
            checksum = checksum + value
            received = received + 1

        rt_channel_close(channel_id)
        # oracle: 1100 in-order messages, FIFO sum 1..=1100 = 605550
        expect(mismatch).to_equal(0)
        expect(checksum).to_equal(605550)
