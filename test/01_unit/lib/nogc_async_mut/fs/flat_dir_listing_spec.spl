# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Regression: nogc_async_mut/fs/flat.spl imported `dir_list` from std.io_runtime
# after that facade renamed it to `dir_list_or_empty`
# (doc/08_tracking/bug/async_fs_flat_stale_dir_list_import_2026-11-14.md).

use std.spec
use std.spec.step
use std.nogc_async_mut.fs.flat.{Dir}
use std.io_runtime.{dir_create_all, dir_remove_all, file_write, getpid}


describe "nogc_async_mut fs flat directory listing":
    # @manual scenario evidence

    it "reports a fresh directory as empty and lists what is written into it":
        # @req REQ-SSPEC-UNIT
        val root = "/tmp/flat_dir_listing_spec_{getpid()}"
        step("create an empty directory")
        dir_create_all(root)
        expect(Dir.is_empty(root)).to_equal(true)
        expect((Dir.read(root) ?? ["unreadable"]).len()).to_equal(0)

        step("write one file into it")
        file_write("{root}/a.txt", "x")
        expect(Dir.is_empty(root)).to_equal(false)
        val entries = Dir.read(root) ?? []
        expect(entries.len()).to_equal(1)
        expect(entries[0]).to_equal("a.txt")

        step("remove the directory")
        dir_remove_all(root)
