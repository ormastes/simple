extern fn rt_file_read_text(path: text) -> text

fn runtime_source() -> text:
    rt_file_read_text("src/lib/nogc_async_mut/async/runtime.spl") ?? ""

describe "Runtime completed-result ownership":
    it "consumes the block_on result instead of retaining it":
        val src = runtime_source()
        expect(src.contains("val result = self.completed[task_id]")).to_equal(true)
        expect(src.contains("self.completed.remove(task_id)")).to_equal(true)
