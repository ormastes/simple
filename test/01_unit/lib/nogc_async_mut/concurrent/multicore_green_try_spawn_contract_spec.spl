use std.spec
use std.concurrent.multicore_green.{MulticoreGreenHandle, multicore_green_try_spawn}

fn try_spawn_contract_value() -> i64: 17

describe "multicore green non-inline submission":
    it "distinguishes a rejected submission from an inline result":
        val rejected = MulticoreGreenHandle(native_handle: 0, inline_done: false, inline_result: 0)
        expect(rejected.used_runtime_pool()).to_equal(false)
        expect(rejected.ran_inline_fallback()).to_equal(false)
        expect(rejected.is_done()).to_equal(false)

    it "preserves inline fallback results for ordinary spawn":
        val fallback = MulticoreGreenHandle(native_handle: 0, inline_done: true, inline_result: 17)
        expect(fallback.used_runtime_pool()).to_equal(false)
        expect(fallback.ran_inline_fallback()).to_equal(true)
        expect(fallback.is_done()).to_equal(true)
        expect(fallback.join()).to_equal(17)

    it "never reports inline fallback when the runtime pool rejects work":
        val handle = multicore_green_try_spawn(try_spawn_contract_value)
        expect(handle.ran_inline_fallback()).to_equal(false)
        if handle.used_runtime_pool():
            expect(handle.join()).to_equal(17)
        else:
            expect(handle.is_done()).to_equal(false)
