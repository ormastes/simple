"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/nogc_async_mut/concurrent/with_lock_facade_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/with_lock_facade_spec.md
# doc-path: doc/03_plan/sys_test/with_lock_facade_spec.md
# doc-path: doc/04_architecture/with_lock_facade_spec.md
# doc-path: doc/05_design/with_lock_facade_spec_oracles.md
# @manual: primary

"""
# Async-tier guard facade spec (SF4)

Proves the nogc_async_mut mutex/rwlock facades re-export the guard-pattern
API. Facade is sync-backed (blocks the carrier thread, no async suspend) —
see doc/08_tracking/bug/async_mutex_blocks_carrier_thread_no_suspend_2026-07-28.md
"""
use std.spec.step

use std.spec.step

use std.spec.*
use std.nogc_async_mut.concurrent.mutex.{mutex_new, mutex_with_lock}
use std.nogc_async_mut.concurrent.rwlock.{rwlock_new, rwlock_with_read, rwlock_with_write}


describe "async-tier facade re-exports the guard API":
    # @manual scenario evidence
    it "mutex with_lock resolves through the facade and guards":
        # @req REQ-SSPEC-LIB
        step("mutex with_lock resolves through the facade and guards")
        val m = mutex_new(1)
        expect(mutex_with_lock(m, \v: v + 1)).to_equal(2)
        expect(mutex_with_lock(m, \v: v)).to_equal(2)

    it "rwlock with_write/with_read resolve through the facade":
        # @req REQ-SSPEC-LIB
        step("rwlock with_write/with_read resolve through the facade")
        val rw = rwlock_new(4)
        expect(rwlock_with_write(rw, \v: v * 2)).to_equal(8)
        expect(rwlock_with_read(rw, \v: v)).to_equal(8)
