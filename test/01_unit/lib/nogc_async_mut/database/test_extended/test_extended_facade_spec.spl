use std.spec
use std.nogc_async_mut.database.test_extended.{CounterRecord, TimingSummary, TestRowId, TestRunCount, TestDurationMs, TestBaselinePresence, TestBaselineGeneration}

describe "nogc_async_mut database test_extended facade":

    it "re-exports database record types":
        val counter = CounterRecord(
            test_id: TestRowId(value: 7), total_runs: TestRunCount(value: 3), passed: TestRunCount(value: 2), failed: TestRunCount(value: 1),
            crashed: TestRunCount(value: 0), timed_out: TestRunCount(value: 0), flaky_count: TestRunCount(value: 0), consecutive_passes: TestRunCount(value: 1)
        )
        val timing = TimingSummary(
            test_id: TestRowId(value: 7), mean: TestDurationMs(value: 10.0), p50: TestDurationMs(value: 9.0), p90: TestDurationMs(value: 12.0), p95: TestDurationMs(value: 13.0),
            p99: TestDurationMs(value: 14.0), iqr: TestDurationMs(value: 2.0), has_baseline: TestBaselinePresence.Present,
            baseline_p50: TestDurationMs(value: 9.0), baseline_updated_at: "now",
            baseline_state: "approved", baseline_generation: TestBaselineGeneration(value: 1),
            baseline_samples: "[]", baseline_cohort_id: "c", provisional_p50: TestDurationMs(value: 9.0),
            last_10_runs: "[]"
        )

        expect(counter.total_runs.value).to_equal(3)
        expect(timing.has_baseline == TestBaselinePresence.Present).to_equal(true)
