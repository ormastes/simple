# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.tui.style.{default_style}
use std.tui.widget.{make_rect}
use std.nogc_async_mut.tui.widgets.text.{ALIGN_CENTER, make_text_widget_aligned, text_render}
use std.nogc_async_mut.tui.widgets.box_widget.{make_box_widget, box_inner_area}
use std.nogc_async_mut.tui.widgets.list.{make_list_widget, list_select, list_selected_item}
use std.nogc_async_mut.tui.widgets.input.{make_input_widget_with_value, input_insert_char, input_delete_back, input_move_home}

describe "nogc_async_mut tui widgets facade":
    # @manual scenario evidence

    it "re-exports text, box, list, and input widget behavior":
        val style = default_style()
        val area = make_rect(0, 0, 10, 3)
        val text_widget = make_text_widget_aligned("hi", style, ALIGN_CENTER)
        expect(text_render(text_widget, area).len()).to_equal(3)
        val box_widget = make_box_widget("T", style)
        expect(box_inner_area(make_rect(0, 0, 10, 4)).width).to_equal(8)
        val selected = list_select(make_list_widget(["a", "b"], style, style), 1)
        expect(list_selected_item(selected)).to_equal("b")
        var input = make_input_widget_with_value("> ", "ab", style)
        input = input_move_home(input)
        input = input_insert_char(input, "x")
        expect(input.value).to_equal("xab")
        input = input_delete_back(input)
        expect(input.value).to_equal("ab")

# Reproduce for
# doc/08_tracking/bug/llm_caret_tui_input_utf8_cursor_counts_bytes_2026-08-25.md:
# `len()` is a UTF-8 BYTE count while `substring` is codepoint-indexed, so the
# widget's cursor arithmetic must be in code points. Before the fix the first
# example observed `expected (���, 9) to equal (¢한😀, 3)`.
describe "input widget cursor arithmetic is codepoint based":

    it "inserts two, three and four byte code points advancing one cell each":
        var input = make_input_widget("", tui_default_style())
        input = input_insert_char(input, "¢")
        input = input_insert_char(input, "한")
        input = input_insert_char(input, "😀")
        expect((input.value, input.cursor_pos)).to_equal(("¢한😀", 3))

    it "deletes backward over a four byte emoji as one unit":
        var input = make_input_widget_with_value("", "a😀b", tui_default_style())
        expect(input.cursor_pos).to_equal(3)
        input = input_move_left(input)
        input = input_delete_back(input)
        expect((input.value, input.cursor_pos)).to_equal(("ab", 1))

    it "moves left across a three byte hangul one code point at a time":
        var input = make_input_widget_with_value("", "한글", tui_default_style())
        expect(input.cursor_pos).to_equal(2)
        input = input_move_left(input)
        expect(input.cursor_pos).to_equal(1)
        input = input_move_left(input)
        expect(input.cursor_pos).to_equal(0)
        input = input_move_left(input)
        expect(input.cursor_pos).to_equal(0)

    it "inserts in the middle of multibyte text without splitting a sequence":
        var input = make_input_widget_with_value("", "¢😀", tui_default_style())
        input = input_move_home(input)
        input = input_move_right(input)
        input = input_insert_char(input, "한")
        expect((input.value, input.cursor_pos)).to_equal(("¢한😀", 2))
        input = input_delete_forward(input)
        expect((input.value, input.cursor_pos)).to_equal(("¢한", 2))
        input = input_move_end(input)
        expect(input.cursor_pos).to_equal(2)

    it "keeps ASCII editing unchanged":
        var input = make_input_widget_with_value("", "ab", tui_default_style())
        expect(input.cursor_pos).to_equal(2)
        input = input_insert_char(input, "c")
        expect((input.value, input.cursor_pos)).to_equal(("abc", 3))
        input = input_move_home(input)
        input = input_delete_forward(input)
        expect((input.value, input.cursor_pos)).to_equal(("bc", 0))
        input = input_move_end(input)
        input = input_delete_back(input)
        expect((input.value, input.cursor_pos)).to_equal(("b", 1))
