use std.test.sspec.{describe, it, expect}
use std.fs.{file_read_text}

describe("Worker H1 registry route contract"):
    it("dispatches synchronous locations through the security-context registry"):
        val source = file_read_text("src/lib/nogc_async_mut/http_server/worker.spl")
        expect(source).to_contain("self.execute_handler_with_remote_security_context(location, request)")
        expect(source).to_contain("direct inline_static_handler bypasses custom registrations")

    it("fails closed for registered async handlers pending scalar-service admission"):
        val source = file_read_text("src/lib/nogc_async_mut/http_server/worker.spl")
        expect(source).to_contain("self.handler_registry.has_async(location.handler_type)")
        expect(source).to_contain("Async handler service unavailable")

    it("applies the same registry and fail-closed policy to H2 streams"):
        val source = file_read_text("src/lib/nogc_async_mut/http_server/worker.spl")
        expect(source).to_contain("Keep HTTP/2 handler selection consistent with H1")
        expect(source).to_contain("resp = self.execute_handler_with_remote_security_context(location, request)")

    it("keeps TLS response state worker-owned"):
        val source = file_read_text("src/lib/nogc_async_mut/http_server/worker.spl")
        expect(source).to_contain("var c = self.connections[fd]")
        expect(source).to_contain("var session_send = self.tls_sessions[fd]")

    it("admits an ALPN-selected H1 socket without repeating accept or TLS"):
        val source = file_read_text("src/lib/nogc_async_mut/http_server/worker.spl")
        expect(source).to_contain("me admit_http1_connection(client_fd: i64, now: i64)")
        expect(source).to_contain("self.admit_http1_connection(fd, now)")
        expect(source).to_contain("a second handshake on this connected socket")

    it("fails closed instead of sending unprotected H2 frames over TLS"):
        val source = file_read_text("src/lib/nogc_async_mut/http_server/worker.spl")
        expect(source).to_contain("H2 frame reads/writes do not yet pass through the TLS record owner")
        expect(source).to_contain("if self.tls_sessions.contains_key(fd):")
        expect(source).to_contain("self.close_tls_pre_admission(fd)")
        expect(source).to_contain("never admitted/count-tracked")
