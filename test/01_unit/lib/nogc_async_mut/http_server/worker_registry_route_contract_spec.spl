use std.spec.{describe, it, expect}
use std.fs.{file_read_text}

# Source-contract scan against the CURRENT worker layout:
#   worker.spl                      facade + async-handler registry extension
#   worker_owner.spl                Worker state, H1 routing, TLS send, ALPN dispatch
#   worker_connection_extensions.spl H2 handling, TLS receive
val WORKER_DIR = "src/lib/nogc_async_mut/http_server/"

fn worker_source(name: text) -> text:
    file_read_text(WORKER_DIR + name)

describe("Worker H1 registry route contract"):
    it("dispatches dynamic locations through the security-context registry"):
        val source = worker_source("worker_owner.spl")
        expect(source).to_contain("if is_dynamic_handler(location.handler_type):")
        expect(source).to_contain("self.execute_handler_with_remote_security_context(location, request)")

    it("fails closed for registered async handlers pending scalar-service admission"):
        val owner = worker_source("worker_owner.spl")
        val facade = worker_source("worker.spl")
        expect(owner).to_contain("self.handler_registry.has_async(location.handler_type)")
        expect(facade).to_contain("Async handler service unavailable")

    it("applies the same registry and fail-closed policy to H2 streams"):
        val source = worker_source("worker_connection_extensions.spl")
        expect(source).to_contain("Keep HTTP/2 handler selection consistent with H1")
        expect(source).to_contain("self.handler_registry.has_async(location.handler_type)")
        expect(source).to_contain("resp = self.execute_handler_with_remote_security_context(location, request)")

    it("keeps TLS response state worker-owned"):
        val source = worker_source("worker_owner.spl")
        expect(source).to_contain("var c = self.connections[fd]")
        expect(source).to_contain("self.submit_tls_send_bytes(fd, c.get_response_bytes_buf())")

    it("dispatches an ALPN-selected connection by negotiated protocol"):
        val source = worker_source("worker_owner.spl")
        expect(source).to_contain("me dispatch_by_alpn(alpn: text, fd: i64, now: i64)")
        expect(source).to_contain("self.dispatch_by_alpn(state.alpn, client_fd, now)")

    it("routes H2 frames over TLS through the TLS record owner"):
        val source = worker_source("worker_connection_extensions.spl")
        expect(source).to_contain("if self.tls_sessions.contains_key(fd):")
        expect(source).to_contain("self.submit_tls_send_bytes(fd, out_bytes)")
