"""
# Async HTTP handler registry boundary specification
"""

use std.spec
use std.http_server.handler.{HandlerRegistry}
use std.http_server.types.{
    HttpRequestData, HttpResponseData, LocationConfig, default_location_config,
    default_response_data
}

var observed_async_job_id = 0

fn accept_async_submission(job_id: i64, completion_channel_id: i64,
                           request: HttpRequestData,
                           location: LocationConfig) -> bool:
    observed_async_job_id = job_id
    request.path == "/render" and location.handler_type == "server-render"

fn synchronous_handler(request: HttpRequestData,
                       location: LocationConfig) -> HttpResponseData:
    default_response_data(200, "OK", "sync:{request.path}")

fn render_request() -> HttpRequestData:
    HttpRequestData(
        method: "GET",
        path: "/render",
        query: "",
        version: "HTTP/1.1",
        headers: [],
        body: "",
        params: {},
        peer_addr: "127.0.0.1"
    )

describe "async HTTP handler registry boundary":
    it "submits typed jobs while preserving synchronous dispatch":
        observed_async_job_id = 0
        var registry = HandlerRegistry.new()
        var async_location = default_location_config()
        async_location.handler_type = "server-render"
        registry.register_async("server-render", accept_async_submission)
        registry.register("sync-app", synchronous_handler)

        expect(registry.has_async("server-render")).to_equal(true)
        expect(registry.has_async("sync-app")).to_equal(false)
        expect(registry.submit_async("server-render", 41, 7, render_request(), async_location)).to_equal(true)
        expect(observed_async_job_id).to_equal(41)

        var sync_location = default_location_config()
        sync_location.handler_type = "sync-app"
        val response = registry.dispatch("sync-app", render_request(), sync_location)
        expect(response.status).to_equal(200)
        expect(response.body).to_equal("sync:/render")

    it "rejects an unregistered async handler without invoking a callback":
        observed_async_job_id = 77
        var registry = HandlerRegistry.new()
        val location = default_location_config()
        expect(registry.submit_async("missing", 99, 7, render_request(), location)).to_equal(false)
        expect(observed_async_job_id).to_equal(77)
