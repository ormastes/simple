# Production incremental HTTP parser lexical regressions.
# @req REQ-LIB-NOGC-ASYNC-MUT-001
# Existing bug: http_request_parser_missing_strict_header_validation_2026-09-16
# Scope: field names and values; Host authority policy remains independently open.

use std.spec.{describe, it, expect}
use std.spec.step
use std.http_server.parser.{HttpRequestParser}
use std.common.encoding.utf8.{char_from_codepoint}

describe "async HTTP header wire grammar":
    it "rejects whitespace before the colon without storing the header":
        step("Validate the original field name before trimming whitespace")
        for name in ["Host ", "Host\t", " Host", "\tHost", " "]:
            var parser = HttpRequestParser.new()
            expect(parser.parse_header_line(name + ": example.test")).to_be(false)
            expect(parser.error_message).to_equal("400 Invalid header name")
            expect(parser.headers.len()).to_equal(0)

    it "rejects separators and non-ASCII field names":
        step("Exercise HTTP separators and a Unicode field name")
        val open_brace_name = "X" + char_from_codepoint(123) + "Name"
        val close_brace_name = "X" + char_from_codepoint(125) + "Name"
        for name in ["X@Name", "X(Name", "X)Name", "X,Name", "X;Name", "X/Name", "X[Name", "X]Name", "X?Name", "X=Name", open_brace_name, close_brace_name, "X\\Name", "X\"Name", "名"]:
            var parser = HttpRequestParser.new()
            expect(parser.parse_header_line(name + ": value")).to_be(false)
            expect(parser.error_message).to_equal("400 Invalid header name")
            expect(parser.headers.len()).to_equal(0)

    it "accepts every token punctuation character in a field name":
        step("Preserve the full HTTP tchar punctuation alphabet")
        var parser = HttpRequestParser.new()
        val name = "X!#$%&'*+-.^_`|~"
        expect(parser.parse_header_line(name + ": value")).to_be(true)
        expect(parser.headers).to_equal([(name, "value")])

    it "rejects every ASCII control and DEL in field names":
        step("Check the complete forbidden ASCII control range in names")
        for code in 0..32:
            var parser = HttpRequestParser.new()
            val name = "X" + char_from_codepoint(code) + "Name"
            expect(parser.parse_header_line(name + ": value")).to_be(false)
            expect(parser.error_message).to_equal("400 Invalid header name")
            expect(parser.headers.len()).to_equal(0)
        var del_parser = HttpRequestParser.new()
        expect(del_parser.parse_header_line("X\x7fName: value")).to_be(false)
        expect(del_parser.error_message).to_equal("400 Invalid header name")

    it "rejects every forbidden ASCII control before trimming field values":
        step("Check controls at both edges and inside the raw field value")
        for code in 0..32:
            if code != 9:
                val control = char_from_codepoint(code)
                for value in [control + "safe", "safe" + control, "safe" + control + "tail"]:
                    var parser = HttpRequestParser.new()
                    expect(parser.parse_header_line("X-Test: " + value)).to_be(false)
                    expect(parser.error_message).to_equal("400 Invalid header value")
                    expect(parser.headers.len()).to_equal(0)
        var del_parser = HttpRequestParser.new()
        expect(del_parser.parse_header_line("X-Test: safe\x7ftail")).to_be(false)
        expect(del_parser.error_message).to_equal("400 Invalid header value")
        expect(del_parser.headers.len()).to_equal(0)

    it "accepts horizontal tabs and Unicode values with ordinary OWS trimming":
        step("Retain legal field values while trimming boundary SP and HTAB")
        var parser = HttpRequestParser.new()
        expect(parser.parse_header_line("X-Test: \t café\t日本語 \t")).to_be(true)
        expect(parser.headers).to_equal([("X-Test", "café\t日本語")])

    it "preserves lexical diagnostics and enters Error on a fragmented feed":
        step("Complete a malformed field name across two input chunks")
        var parser = HttpRequestParser.new()
        expect(parser.feed("GET / HTTP/1.1\r\nX@Na").is_ok()).to_be(true)
        expect(parser.feed("me: value\r\n").is_err()).to_be(true)
        expect(parser.error_message).to_equal("400 Invalid header name")
        expect(parser.is_complete()).to_be(false)
        expect(parser.headers.len()).to_equal(0)
        step("A later valid terminator cannot recover the rejected request")
        expect(parser.feed("\r\n").is_err()).to_be(true)
        expect(parser.is_complete()).to_be(false)

    it "keeps malformed missing-colon and empty-name diagnostics":
        step("Retain the existing framing rejection for absent or empty names")
        for line in ["MissingColon", ": value"]:
            var parser = HttpRequestParser.new()
            expect(parser.parse_header_line(line)).to_be(false)
            expect(parser.error_message).to_equal("400 Malformed header line")
            expect(parser.headers.len()).to_equal(0)
