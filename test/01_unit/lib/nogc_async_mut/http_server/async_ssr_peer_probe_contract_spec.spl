use app.io.mod.{file_read}

fn section_between(source: text, start: text, finish: text) -> text:
    val after_start = source.split(start)
    if after_start.len() < 2:
        return ""
    val before_finish = after_start[1].split(finish)
    if before_finish.len() < 1:
        return ""
    before_finish[0]

describe "HTTP async SSR peer probe contract":
    it "defines all four non-consuming backend states":
        val driver = file_read("src/lib/nogc_async_mut/io/driver.spl")
        val probe = section_between(driver, "enum TcpPeerProbe:", "class IoDriver:")
        expect(probe).to_contain("Alive")
        expect(probe).to_contain("Closed")
        expect(probe).to_contain("DataPending")
        expect(probe).to_contain("Unsupported")
        expect(driver).to_contain("rt_io_tcp_probe_peer(fd)")

    it "keeps SimpleOS unsupported and deadline bounded without reading":
        val shim = file_read("src/os/kernel/net/tcp_shim.spl")
        val probe = section_between(
            shim,
            "fn rt_io_tcp_probe_peer(fd: i64) -> i64:",
            "fn rt_io_tcp_read_line(fd: i64)"
        )
        expect(probe).to_contain("Unsupported=3")
        expect(probe.contains("net_tcp_read(")).to_equal(false)
