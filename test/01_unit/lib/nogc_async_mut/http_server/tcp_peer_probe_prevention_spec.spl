use std.spec
use std.nogc_async_mut.io.driver.{TcpPeerProbe, tcp_peer_probe_from_code}

fn probe_label(p: TcpPeerProbe) -> text:
    match p:
        TcpPeerProbe.Alive: "alive"
        TcpPeerProbe.Closed: "closed"
        TcpPeerProbe.DataPending: "pending"
        TcpPeerProbe.Unsupported: "unsupported"

describe "TCP peer probe code decoding":
    it "maps the four backend codes to distinct states":
        expect(probe_label(tcp_peer_probe_from_code(0))).to_equal("alive")
        expect(probe_label(tcp_peer_probe_from_code(1))).to_equal("closed")
        expect(probe_label(tcp_peer_probe_from_code(2))).to_equal("pending")
        expect(probe_label(tcp_peer_probe_from_code(3))).to_equal("unsupported")

    it "fails closed to Unsupported for unknown or error codes":
        expect(probe_label(tcp_peer_probe_from_code(-1))).to_equal("unsupported")
        expect(probe_label(tcp_peer_probe_from_code(4))).to_equal("unsupported")
        expect(probe_label(tcp_peer_probe_from_code(9999))).to_equal("unsupported")
