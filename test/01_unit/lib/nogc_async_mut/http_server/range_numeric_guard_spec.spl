# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step
use std.nogc_async_mut.http_server.utilities.{parse_range_header, create_content_range}

# Regression guard for the Range header parser.
#
# History: this parser used to coerce bounds with `to_int() ?? 0`, which could
# never fail, so `bytes=abc-def` was silently served as `bytes=0-0`. The
# behavioral oracle below calls parse_range_header directly and pins the
# fail-closed contract: a malformed Range is IGNORED (whole-entity sentinel
# (0, -1), RFC 9110 §14.2), never coerced.
describe "nogc async http server range numeric guard":
    # @manual scenario evidence
    it "parses well-formed byte ranges into explicit bounds":
        # @req REQ-SSPEC-LIB
        step("parse a well-formed bytes range")
        # evidence(protocol_json): tuple results asserted below are the complete typed oracle
        expect(parse_range_header("bytes=10-20")).to_equal((10, 20))
        expect(parse_range_header("bytes=0-0")).to_equal((0, 0))

    it "fails closed on a malformed bound instead of coercing it":
        # @req REQ-SSPEC-LIB
        step("parse malformed ranges and require the whole-entity sentinel")
        # evidence(protocol_json): the (0, -1) whole-entity sentinel is the complete typed oracle
        expect(parse_range_header("bytes=abc-def")).to_equal((0, -1))
        expect(parse_range_header("bytes=5xyz-9q")).to_equal((0, -1))
        expect(parse_range_header("bytes=3-bad")).to_equal((0, -1))

    it "treats an open-ended range as start with the unset end sentinel":
        # @req REQ-SSPEC-LIB
        step("parse a suffix-less range")
        # evidence(protocol_json): the (start, -1) shape asserted below is the complete typed oracle
        expect(parse_range_header("bytes=42-")).to_equal((42, -1))

    it "renders a parsed range as a Content-Range header value":
        # @req REQ-SSPEC-LIB
        step("render a parsed range through create_content_range")
        # evidence(protocol_json): the header text asserted below is the complete typed oracle
        expect(create_content_range(10, 20, 100)).to_contain("10-20")
        expect(create_content_range(10, 20, 100)).to_contain("100")
