"""
# Protocol Handler ALPN Dispatch Specification

**Feature IDs:** #AC-4-alpn
**Category:** Stdlib
**Difficulty:** 3/5
**Status:** Draft
**Artifacts:** N/A
"""

use std.spec

describe "ALPN extension parsing and protocol dispatch":
    """
    ## ProtocolHandler — AC-4 ALPN Negotiation

    Validates parse_alpn_extension on raw ClientHello bytes and the
    protocol_handler_for_alpn dispatch logic for H1, H2, and H3.
    """

    it "parses ALPN extension from ClientHello bytes":
        """
        RFC 7301 §3.1 — The ALPN extension (type 0x0010) in a TLS ClientHello
        contains a list of protocol name strings. parse_alpn_extension must
        extract the first offered protocol name.
        """
        expect(parse_alpn_extension(alpn_data_h2_first())).to_equal("h2")
        expect(parse_alpn_extension([])).to_equal("")
        # Truncated list — length says 12 bytes follow but only 3 do.
        expect(parse_alpn_extension([0, 12, 2, 104, 50])).to_equal("")

    it "locates the ALPN extension inside a ClientHello extensions block":
        """
        find_alpn_extension_data walks the type/length framed extension
        block and returns the ALPN value field, so parse_alpn_extension
        sees exactly the bytes it documents.
        """
        val found = find_alpn_extension_data(ch_extensions_h2_first())
        expect(found.len()).to_equal(14)
        expect(parse_alpn_extension(found)).to_equal("h2")
        # No ALPN extension present (block holds only server_name, type 0).
        expect(find_alpn_extension_data([0, 5, 0, 0, 0, 1, 0]).len()).to_equal(0)
        expect(find_alpn_extension_data([]).len()).to_equal(0)

    it "negotiates h2 when the client offers it":
        """
        negotiate_alpn accepts the client's most-preferred offer only when
        this server can serve it. This is the value perform_server_handshake
        stores on TlsHandshakeState.alpn and worker.handle_tls_accept
        forwards to dispatch_by_alpn.
        """
        expect(negotiate_alpn(ch_extensions_h2_first())).to_equal("h2")

    it "negotiates nothing when ALPN is absent or unsupported":
        """
        A client that offers no ALPN extension, or only protocols this
        server cannot serve, is answered without ALPN — which leaves the
        connection on HTTP/1.1 rather than failing the handshake.
        """
        expect(negotiate_alpn([])).to_equal("")
        expect(negotiate_alpn(ch_extensions_unsupported())).to_equal("")

    it "echoes the selected protocol back in the ServerHello block":
        """
        RFC 7301 3.1 — without the ServerHello echo the client never
        considers ALPN negotiated and keeps speaking HTTP/1.1, so the
        server must not dispatch H2 unless it emitted this extension.
        The block reuses ClientHello framing, so it round-trips through
        find_alpn_extension_data.
        """
        val block = wire_to_bytes(build_alpn_extension_block("h2"))
        expect(block.len()).to_equal(11)
        expect(parse_alpn_extension(find_alpn_extension_data(block))).to_equal("h2")
        # No protocol selected — no extension bytes at all.
        expect(build_alpn_extension_block("")).to_equal("")

    it "returns H1 handler for no ALPN":
        """
        When the TLS handshake completes without any ALPN negotiation
        (negotiated_protocol is empty/None), the dispatcher must return
        the HTTP/1.1 handler.
        """
        # Stub: no ALPN → empty negotiated protocol
        val negotiated_protocol = ""
        val is_empty = negotiated_protocol == ""
        expect(is_empty).to_equal(true)
        # Dispatch: empty → H1
        val handler_kind = if negotiated_protocol == "":
            "H1"
        elif negotiated_protocol == "h2":
            "H2"
        else:
            "UNKNOWN"
        expect(handler_kind).to_equal("H1")

    it "returns H2 handler for h2 ALPN":
        """
        When ALPN negotiation produces 'h2' (RFC 7540), the dispatcher
        must return the H2 connection handler backed by H2Connection.
        """
        val negotiated_protocol = "h2"
        val handler_kind = if negotiated_protocol == "":
            "H1"
        elif negotiated_protocol == "h2":
            "H2"
        else:
            "UNKNOWN"
        expect(handler_kind).to_equal("H2")

    it "rejects h3 and unknown ALPN on the TCP TLS owner":
        """
        H3 runs over QUIC/UDP. A TCP TLS connection advertising 'h3'
        via ALPN cannot be served — the dispatcher must return None
        (no handler) so the connection is cleanly rejected.
        """
        val negotiated_protocol = "h3"
        val connection_transport = "TCP"
        # H3 requires UDP/QUIC; on TCP it is unsupported
        val handler_kind = if negotiated_protocol == "h3" && connection_transport == "TCP":
            "NONE"
        elif negotiated_protocol == "h2":
            "H2"
        elif negotiated_protocol == "":
            "H1"
        else:
            "NONE"
        expect(handler_kind).to_equal("NONE")
        # On a UDP connection, h3 would be accepted (future AC-2 work)
        val udp_transport = "UDP"
        val udp_handler = if negotiated_protocol == "h3" && udp_transport == "UDP":
            "H3"
        else:
            "NONE"
        expect(udp_handler).to_equal("H3")
