"""
## Purpose and audience
Purpose: Prove that async parser — request line limit.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

"""
# Async HTTP Parser — request limits enforced during parsing

## Overview

The async server's incremental parser must enforce the same request limits as
the sync server (shared `std.common.net.http_core` policy), and it must do so
DURING parsing — before buffer growth — so a hostile client cannot exhaust
memory with an endless request line, oversized headers, or an oversized body.

Each limit is proven at the boundary (accepted) and boundary+1 (rejected),
using `HttpRequestParser.with_limits` so the fixtures stay small. The
"endless" cases additionally prove the parser cuts a client off while the
terminator has NOT yet arrived — the memory-exhaustion scenario an
after-the-fact check cannot catch.

## Limit matrix proven here

| Limit | Boundary case | Over-limit case | Streaming case |
|-------|---------------|-----------------|----------------|
| Request line | exact length accepted | +1 byte → 431 | endless line cut off |
| Header line | exact length accepted | +1 byte → 431 | endless header cut off |
| Header count | exact count accepted | +1 header → 431 | — |
| Body (Content-Length) | exact size accepted | declared +1 → 413 pre-buffer | rejected before body bytes |
| Body (chunked) | small body decoded | decoded over limit → 413 | raw accumulation cut off → 413 |
| Fragmented header ingress | 8 KiB / 16 KiB in 64 B chunks | linear `header_copy_bytes` vs O(N^2) | pipelined body + next request |

## Examples

```simple
var p = HttpRequestParser.with_limits(64, 100, 8192, 10485760)
val r = p.feed("GET /" + long_path + " HTTP/1.1\r\n")
# Err(ParseError("431 Request line too long: ...")) once the limit is crossed
```

## Troubleshooting

- `431` in `error_message` — a line/header limit fired during parsing.
- `413` — the declared or decoded body exceeds `max_body`; note the
  rejection happens BEFORE body bytes are buffered.
- `400` — duplicate/invalid Content-Length or Content-Length combined with
  chunked (smuggling ambiguity), decided by the shared core.

**Requirements:** N/A
**Plan:** doc/03_plan/agent_tasks/simple_erp.md
**Design:** N/A
**Research:** doc/01_research/local/simple_enterprise_suite_assessment_2026-08-14.md

Lane: .spipe/simple_enterprise_suite (Wave A, AC-2).
"""

use std.spec.*
use std.http_server.parser.{HttpRequestParser}

# repeat_char builds a string of n copies of ch (no text.repeat builtin).
fn repeat_char(ch: text, n: i32) -> text:
    var out = ""
    var i = 0
    while i < n:
        out = out + ch
        i = i + 1
    out

# feed_ok feeds data and returns true when the parser accepted it (Ok).
fn feed_ok(parser: HttpRequestParser, data: text) -> bool:
    val r = parser.feed(data)
    match r:
        Ok(_): true
        Err(_): false

# feed_in_chunks feeds payload in fixed-size byte fragments and returns total consumed bytes (or -1 on error).
fn feed_in_chunks(parser: HttpRequestParser, payload: text, chunk_bytes: i64) -> i64:
    var total_consumed: i64 = 0
    var pos: i64 = 0
    val total_len = payload.byte_len()
    while pos < total_len:
        var next_pos = pos + chunk_bytes
        if next_pos > total_len:
            next_pos = total_len
        val r = parser.feed(payload.slice(pos, next_pos))
        match r:
            Ok(n):
                total_consumed = total_consumed + n
            Err(_):
                return -1
        pos = next_pos
    total_consumed

# build_multi_header_request constructs a request with `header_count` ~128-byte headers and optional body.
fn build_multi_header_request(path: text, header_count: i32, pad: text, body: text) -> text:
    var lines: [text] = []
    if body.byte_len() > 0:
        lines.push("POST {path} HTTP/1.1\r\n")
    else:
        lines.push("GET {path} HTTP/1.1\r\n")
    lines.push("Host: example.test\r\n")
    var idx = 0
    while idx < header_count:
        lines.push("X-Hdr-{idx}: {pad}\r\n")
        idx = idx + 1
    if body.byte_len() > 0:
        lines.push("Content-Length: {body.byte_len()}\r\n")
    lines.push("\r\n")
    if body.byte_len() > 0:
        lines.push(body)
    lines.join("")

use std.spec.step

describe "async parser — request line limit":
    it "accepts a request line exactly at the limit":
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        step("Open a parser with a 64-byte request-line limit")
        var p = HttpRequestParser.with_limits(64, 100, 8192, 10485760)
        # "GET " + path + " HTTP/1.1" == 4 + 51 + 9 == exactly 64 bytes
        val path = "/" + repeat_char("a", 50)
        val line = "GET " + path + " HTTP/1.1"
        expect(line.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement

        step("Feed the boundary-length request line")
        expect(feed_ok(p, line + "\r\n")).to_be(true)
        expect(p.has_error()).to_be(false)

    it "rejects a request line one byte over the limit with 431":
        var p = HttpRequestParser.with_limits(64, 100, 8192, 10485760)
        val path = "/" + repeat_char("a", 51)
        val line = "GET " + path + " HTTP/1.1"
        expect(line.len()).to_equal(65)  # oracle: 65 — named expected value from the requirement

        step("Feed the over-limit request line")
        expect(feed_ok(p, line + "\r\n")).to_be(false)
        expect(p.has_error()).to_be(true)
        expect(p.error_message.starts_with("431")).to_be(true)

    it "cuts off an endless request line before buffering it all":
        step("Stream request-line bytes with no CRLF terminator")
        var p = HttpRequestParser.with_limits(64, 100, 8192, 10485760)
        expect(feed_ok(p, repeat_char("a", 80))).to_be(false)
        expect(p.error_message.starts_with("431")).to_be(true)

describe "async parser — header line limit":
    it "accepts a header line exactly at the limit":
        var p = HttpRequestParser.with_limits(8192, 100, 32, 10485760)
        step("Feed the request line, then a boundary-length header line")
        expect(feed_ok(p, "GET / HTTP/1.1\r\n")).to_be(true)
        # "X-A: " (5) + 27 = exactly 32 bytes
        val hline = "X-A: " + repeat_char("b", 27)
        expect(hline.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(feed_ok(p, hline + "\r\n")).to_be(true)
        expect(p.has_error()).to_be(false)

    it "rejects a header line one byte over the limit with 431":
        step("Verify: rejects a header line one byte over the limit with 431")
        var p = HttpRequestParser.with_limits(8192, 100, 32, 10485760)
        expect(feed_ok(p, "GET / HTTP/1.1\r\n")).to_be(true)
        val hline = "X-A: " + repeat_char("b", 28)
        expect(hline.len()).to_equal(33)  # oracle: 33 — named expected value from the requirement
        expect(feed_ok(p, hline + "\r\n")).to_be(false)
        expect(p.error_message.starts_with("431")).to_be(true)

    it "cuts off an endless header line before buffering it all":
        var p = HttpRequestParser.with_limits(8192, 100, 32, 10485760)
        expect(feed_ok(p, "GET / HTTP/1.1\r\n")).to_be(true)
        step("Stream header bytes with no CRLF terminator")
        expect(feed_ok(p, repeat_char("c", 40))).to_be(false)
        expect(p.error_message.starts_with("431")).to_be(true)

describe "async parser — header count limit":
    it "accepts exactly the maximum number of headers":
        var p = HttpRequestParser.with_limits(8192, 3, 8192, 10485760)
        step("Feed a request with exactly 3 headers")
        expect(feed_ok(p, "GET / HTTP/1.1\r\nHost: test\r\nA: 1\r\nB: 2\r\n\r\n")).to_be(true)
        expect(p.is_complete()).to_be(true)

    it "rejects one header beyond the maximum with 431":
        var p = HttpRequestParser.with_limits(8192, 3, 8192, 10485760)
        step("Feed a request with 4 headers")
        expect(feed_ok(p, "GET / HTTP/1.1\r\nA: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\n\r\n")).to_be(false)
        expect(p.error_message.starts_with("431")).to_be(true)

describe "async parser — HTTP field-name grammar":
    it "rejects whitespace before the colon and non-token field names":
        var whitespace = HttpRequestParser.new()
        expect(feed_ok(whitespace, "GET / HTTP/1.1\r\nHost : example.test\r\n")).to_be(false)
        expect(whitespace.error_message.starts_with("400")).to_be(true)

        var invalid_char = HttpRequestParser.new()
        expect(feed_ok(invalid_char, "GET / HTTP/1.1\r\nX@Trace: value\r\n")).to_be(false)
        expect(invalid_char.error_message.starts_with("400")).to_be(true)

describe "async parser — body size limit":
    it "accepts a Content-Length body exactly at the limit":
        var p = HttpRequestParser.with_limits(8192, 100, 8192, 16)
        step("POST a body of exactly 16 bytes")
        val body = repeat_char("d", 16)
        expect(feed_ok(p, "POST / HTTP/1.1\r\nHost: test\r\nContent-Length: 16\r\n\r\n" + body)).to_be(true)
        expect(p.is_complete()).to_be(true)
        val req = p.to_request("127.0.0.1")
        expect(req.body.len()).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "rejects a declared body one byte over the limit with 413":
        var p = HttpRequestParser.with_limits(8192, 100, 8192, 16)
        step("Declare Content-Length 17 against a 16-byte limit")
        expect(feed_ok(p, "POST / HTTP/1.1\r\nContent-Length: 17\r\n\r\n")).to_be(false)
        expect(p.error_message.starts_with("413")).to_be(true)

    it "rejects the declared body BEFORE any body bytes arrive":
        var p = HttpRequestParser.with_limits(8192, 100, 8192, 16)
        step("Send only the headers of an oversized POST")
        val accepted = feed_ok(p, "POST / HTTP/1.1\r\nContent-Length: 9999\r\n\r\n")
        expect(accepted).to_be(false)
        step("Verify no body bytes were ever buffered")
        expect(p.body.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "async parser — header policy parity with the shared core":
    it "rejects a missing Host before request dispatch":
        var p = HttpRequestParser.new()
        expect(feed_ok(p, "GET / HTTP/1.1\r\nUser-Agent: test\r\n\r\n")).to_be(false)
        expect(p.is_complete()).to_be(false)
        expect(p.error_message).to_contain("Missing Host")

    it "rejects duplicate and invalid Host authorities before dispatch":
        var duplicate = HttpRequestParser.new()
        expect(feed_ok(duplicate, "GET / HTTP/1.1\r\nHost: a.test\r\nHost: a.test\r\n\r\n")).to_be(false)
        var empty = HttpRequestParser.new()
        expect(feed_ok(empty, "GET / HTTP/1.1\r\nHost:\r\n\r\n")).to_be(false)
        var userinfo = HttpRequestParser.new()
        expect(feed_ok(userinfo, "GET / HTTP/1.1\r\nHost: user@host.test\r\n\r\n")).to_be(false)
        expect(userinfo.is_complete()).to_be(false)

    it "requires absolute-form target and Host authorities to agree":
        var matching = HttpRequestParser.new()
        expect(feed_ok(matching, "GET http://Example.test/a HTTP/1.1\r\nHost: example.TEST\r\n\r\n")).to_be(true)
        expect(matching.is_complete()).to_be(true)
        var mismatch = HttpRequestParser.new()
        expect(feed_ok(mismatch, "GET http://safe.test/a HTTP/1.1\r\nHost: attacker.test\r\n\r\n")).to_be(false)
        expect(mismatch.is_complete()).to_be(false)

    it "keeps HTTP/1.0 optional Host but still validates a present Host":
        var legacy = HttpRequestParser.new()
        expect(feed_ok(legacy, "GET / HTTP/1.0\r\n\r\n")).to_be(true)
        expect(legacy.is_complete()).to_be(true)
        var path_in_host = HttpRequestParser.new()
        expect(feed_ok(path_in_host, "GET / HTTP/1.0\r\nHost: a.test/evil\r\n\r\n")).to_be(false)
        var space_in_host = HttpRequestParser.new()
        expect(feed_ok(space_in_host, "GET / HTTP/1.1\r\nHost: a.test b.test\r\n\r\n")).to_be(false)
        expect(space_in_host.error_message).to_contain("Invalid Host")

    it "accepts well-formed host:port and IPv6 authorities, rejects malformed ones":
        var v6 = HttpRequestParser.new()
        expect(feed_ok(v6, "GET / HTTP/1.1\r\nHost: [::1]:8080\r\n\r\n")).to_be(true)
        var abs_port = HttpRequestParser.new()
        expect(feed_ok(abs_port, "GET http://a.test:8080/x HTTP/1.1\r\nHost: a.test:8080\r\n\r\n")).to_be(true)
        for bad in ["a.test:abc", "a:1:2", "[::1", ":::[]", "a%zz.test", "a.test:"]:
            var p = HttpRequestParser.new()
            expect(feed_ok(p, "GET / HTTP/1.1\r\nHost: " + bad + "\r\n\r\n")).to_be(false)
            expect(p.error_message).to_contain("Invalid Host")
        var empty_abs = HttpRequestParser.new()
        expect(feed_ok(empty_abs, "GET http:///a HTTP/1.1\r\nHost: a.test\r\n\r\n")).to_be(false)
        expect(empty_abs.error_message).to_contain("does not match")
        var unknown_version = HttpRequestParser.new()
        expect(feed_ok(unknown_version, "GET / HTTP/1.2\r\n\r\n")).to_be(false)
        expect(unknown_version.error_message).to_contain("Missing Host")

    it "rejects whitespace before a framing header colon":
        step("Send a Content-Length field with forbidden whitespace before its colon")
        var p = HttpRequestParser.new()
        expect(feed_ok(p, "POST / HTTP/1.1\r\nContent-Length : 4\r\n\r\nWiki")).to_be(false)
        expect(p.error_message.starts_with("400")).to_be(true)

    it "rejects non-token field names before request dispatch":
        step("Send field-name separators forbidden by the shared token grammar")
        var punctuation = HttpRequestParser.new()
        expect(feed_ok(punctuation, "GET / HTTP/1.1\r\nBad(Name: value\r\n\r\n")).to_be(false)
        expect(punctuation.error_message).to_contain("Invalid header name")
        var at_sign = HttpRequestParser.new()
        expect(feed_ok(at_sign, "GET / HTTP/1.1\r\nBad@Name: value\r\n\r\n")).to_be(false)
        expect(at_sign.is_complete()).to_be(false)

    it "rejects forbidden field-value controls before request dispatch":
        step("Send NUL, CTL, and DEL bytes through the incremental parser")
        var nul = HttpRequestParser.new()
        expect(feed_ok(nul, "GET / HTTP/1.1\r\nX-Test: safe\x00smuggled\r\n\r\n")).to_be(false)
        expect(nul.error_message).to_contain("Invalid header value")
        var ctl = HttpRequestParser.new()
        expect(feed_ok(ctl, "GET / HTTP/1.1\r\nX-Test: safe\x01smuggled\r\n\r\n")).to_be(false)
        var del = HttpRequestParser.new()
        expect(feed_ok(del, "GET / HTTP/1.1\r\nX-Test: safe\x7fsmuggled\r\n\r\n")).to_be(false)
        expect(del.is_complete()).to_be(false)

    it "continues to accept horizontal tab in a valid field value":
        var p = HttpRequestParser.new()
        expect(feed_ok(p, "GET / HTTP/1.1\r\nHost: example.test\r\nX-Trace: one\ttwo\r\n\r\n")).to_be(true)
        expect(p.is_complete()).to_be(true)

    it "rejects duplicate Content-Length with 400":
        step("Verify: rejects duplicate Content-Length with 400")
        var p = HttpRequestParser.new()
        expect(feed_ok(p, "POST / HTTP/1.1\r\nContent-Length: 4\r\nContent-Length: 4\r\n\r\n")).to_be(false)
        expect(p.error_message.starts_with("400")).to_be(true)

    it "rejects invalid Content-Length with 400":
        step("Verify: rejects invalid Content-Length with 400")
        var p = HttpRequestParser.new()
        expect(feed_ok(p, "POST / HTTP/1.1\r\nContent-Length: abc\r\n\r\n")).to_be(false)
        expect(p.error_message.starts_with("400")).to_be(true)

    it "rejects Content-Length combined with chunked as smuggling ambiguity":
        var p = HttpRequestParser.new()
        step("Send BOTH Content-Length and Transfer-Encoding: chunked")
        expect(feed_ok(p, "POST / HTTP/1.1\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n")).to_be(false)
        expect(p.error_message.starts_with("400")).to_be(true)

describe "async parser — chunked bodies stay bounded":
    it "decodes a small chunked body normally":
        var p = HttpRequestParser.new()
        step("Send a well-formed 4-byte chunked body")
        expect(feed_ok(p, "POST / HTTP/1.1\r\nHost: test\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n0\r\n\r\n")).to_be(true)
        expect(p.is_complete()).to_be(true)
        val req = p.to_request("127.0.0.1")
        expect(req.body).to_equal("Wiki")

    it "cuts off unbounded chunked accumulation with 413":
        var p = HttpRequestParser.with_limits(8192, 100, 8192, 16)
        expect(feed_ok(p, "POST / HTTP/1.1\r\nHost: test\r\nTransfer-Encoding: chunked\r\n\r\n")).to_be(true)
        step("Stream chunk bytes past the accumulation bound with no terminator")
        # Raw accumulation bound is max_body + max_header_line (16 + 8192).
        expect(feed_ok(p, repeat_char("e", 8300))).to_be(false)
        expect(p.error_message.starts_with("413")).to_be(true)

    it "rejects a decoded chunked body over the limit with 413":
        var p = HttpRequestParser.with_limits(8192, 100, 8192, 4)
        expect(feed_ok(p, "POST / HTTP/1.1\r\nHost: test\r\nTransfer-Encoding: chunked\r\n\r\n")).to_be(true)
        step("Send a well-formed chunked body decoding to 5 bytes against a 4-byte limit")
        expect(feed_ok(p, "5\r\nWikis\r\n0\r\n\r\n")).to_be(false)
        expect(p.error_message.starts_with("413")).to_be(true)

describe "async parser — well-formed requests still parse":
    it "parses a complete GET request end to end":
        var p = HttpRequestParser.new()
        step("Feed a complete request in two fragments")
        expect(feed_ok(p, "GET /hello?x=1 HTTP/1.1\r\nHost: example.com\r\n")).to_be(true)
        expect(feed_ok(p, "\r\n")).to_be(true)
        step("Verify the parsed request fields")
        expect(p.is_complete()).to_be(true)
        val req = p.to_request("127.0.0.1")
        expect(req.method).to_equal("GET")
        expect(req.path).to_equal("/hello")
        expect(req.query).to_equal("x=1")
        expect(req.headers.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "async parser — O(N) 64-byte fragmented header ingress and pipelined body":
    it "keeps header_copy_bytes linear across 8 KiB and 16 KiB 64-byte-fragmented multi-header blocks":
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        step("Build 8 KiB and 16 KiB multi-header requests and stream each in 64-byte chunks")
        val pad = repeat_char("v", 116)
        val req8 = build_multi_header_request("/bench8", 64, pad, "")
        val req16 = build_multi_header_request("/bench16", 128, pad, "")
        expect(req8.byte_len()).to_be_greater_than(8192)
        expect(req16.byte_len()).to_be_greater_than(16384)

        var p8 = HttpRequestParser.with_limits(8192, 512, 16384, 1048576)
        var p16 = HttpRequestParser.with_limits(8192, 512, 16384, 1048576)
        expect(feed_in_chunks(p8, req8, 64)).to_equal(req8.byte_len())
        expect(feed_in_chunks(p16, req16, 64)).to_equal(req16.byte_len())
        expect(p8.is_complete()).to_be(true)
        expect(p16.is_complete()).to_be(true)
        expect(p8.to_request("127.0.0.1").headers.len()).to_equal(65)
        expect(p16.to_request("127.0.0.1").headers.len()).to_equal(129)

        step("Verify header_copy_bytes stays O(N) and doubles (~2x) instead of quadrupling (~4x O(N^2))")
        val copy8 = p8.header_copy_bytes
        val copy16 = p16.header_copy_bytes
        # Pre-fix O(N^2) concat + per-line slice on 256 x 64 B fragments exceeded 1,000,000 bytes.
        val quadratic16 = (256 * 257 * 64) / 2
        expect(copy8).to_be_greater_than(0)
        expect(copy8).to_be_less_than(req8.byte_len() * 3)
        expect(copy16).to_be_less_than(req16.byte_len() * 3)
        expect(copy16 * 10).to_be_less_than( quadratic16 )
        expect(copy16 * 10).to_be_less_than(copy8 * 25)

    it "keeps header_copy_bytes O(N) on 8 KiB and 16 KiB single large headers fed in 64-byte fragments":
        step("Stream single 8 KiB and 16 KiB header lines in 64-byte chunks")
        val big8 = "GET /single8 HTTP/1.1\r\nHost: example.test\r\nX-Blob: " + repeat_char("z", 8192) + "\r\n\r\n"
        val big16 = "GET /single16 HTTP/1.1\r\nHost: example.test\r\nX-Blob: " + repeat_char("z", 16384) + "\r\n\r\n"
        var p8 = HttpRequestParser.with_limits(8192, 128, 32768, 1048576)
        var p16 = HttpRequestParser.with_limits(8192, 128, 32768, 1048576)

        expect(feed_in_chunks(p8, big8, 64)).to_equal(big8.byte_len())
        expect(feed_in_chunks(p16, big16, 64)).to_equal(big16.byte_len())
        expect(p8.is_complete()).to_be(true)
        expect(p16.is_complete()).to_be(true)

        step("Verify partial-line chunks stay queued until newline so header_copy_bytes is ~1x N")
        expect(p8.header_copy_bytes).to_be_less_than(big8.byte_len() * 2)
        expect(p16.header_copy_bytes).to_be_less_than(big16.byte_len() * 2)
        expect(p16.header_copy_bytes * 10).to_be_less_than(p8.header_copy_bytes * 25)

    it "parses 16 KiB 64-byte-fragmented headers with a pipelined Content-Length body and next request":
        step("Stream a 16 KiB-header POST + 320-byte body + pipelined second POST in 64-byte chunks")
        val pad = repeat_char("m", 116)
        val body1 = "START-" + repeat_char("p", 308) + "-FINAL"
        expect(body1.byte_len()).to_equal(320)
        val req1 = build_multi_header_request("/upload", 128, pad, body1)
        val req2 = "POST /pipelined HTTP/1.1\r\nHost: example.test\r\nContent-Length: 12\r\n\r\nsecond-body!"
        val wire = req1 + req2

        var p = HttpRequestParser.with_limits(8192, 512, 16384, 1048576)
        var pos: i64 = 0
        var consumed1: i64 = 0
        val wire_len = wire.byte_len()
        while pos < wire_len and not p.is_complete():
            var next_pos = pos + 64
            if next_pos > wire_len:
                next_pos = wire_len
            val r = p.feed(wire.slice(pos, next_pos))
            match r:
                Ok(n):
                    consumed1 = consumed1 + n
                Err(_):
                    expect(false).to_be(true)
            pos = next_pos

        step("Verify first request headers, body, consumed byte count, and linear header_copy_bytes")
        expect(p.is_complete()).to_be(true)
        expect(consumed1).to_equal(req1.byte_len())
        val parsed1 = p.to_request("127.0.0.1")
        expect(parsed1.method).to_equal("POST")
        expect(parsed1.path).to_equal("/upload")
        expect(parsed1.headers.len()).to_equal(130)
        expect(parsed1.body).to_equal(body1)
        expect(p.header_copy_bytes).to_be_less_than(req1.byte_len() * 3)

        step("Reset and finish streaming the pipelined second request")
        p.reset()
        var consumed2: i64 = 0
        if pos >= wire_len:
            val r0 = p.feed("")
            match r0:
                Ok(n):
                    consumed2 = consumed2 + n
                Err(_):
                    expect(false).to_be(true)
        while pos < wire_len:
            var next_pos = pos + 64
            if next_pos > wire_len:
                next_pos = wire_len
            val r = p.feed(wire.slice(pos, next_pos))
            match r:
                Ok(n):
                    consumed2 = consumed2 + n
                Err(_):
                    expect(false).to_be(true)
            pos = next_pos

        expect(p.is_complete()).to_be(true)
        expect(consumed2).to_equal(req2.byte_len())
        val parsed2 = p.to_request("127.0.0.1")
        expect(parsed2.method).to_equal("POST")
        expect(parsed2.path).to_equal("/pipelined")
        expect(parsed2.body).to_equal("second-body!")

    it "advances buf_pos across 8 KiB and 16 KiB multi-header buffers without per-line re-slicing":
        step("Feed whole 8 KiB and 16 KiB multi-header requests with pipelined bodies")
        val pad = repeat_char("k", 116)
        val body = repeat_char("b", 256)
        val req8 = build_multi_header_request("/cursor8", 64, pad, body)
        val req16 = build_multi_header_request("/cursor16", 128, pad, body)

        var p8 = HttpRequestParser.with_limits(8192, 512, 16384, 1048576)
        var p16 = HttpRequestParser.with_limits(8192, 512, 16384, 1048576)
        expect(feed_ok(p8, req8)).to_be(true)
        expect(feed_ok(p16, req16)).to_be(true)
        expect(p8.is_complete()).to_be(true)
        expect(p16.is_complete()).to_be(true)
        expect(p16.to_request("127.0.0.1").body).to_equal(body)

        step("Verify lazy compaction (>= 4 KiB and >= 50%) keeps header_copy_bytes O(N) vs 128x slice")
        expect(p8.header_copy_bytes).to_be_less_than(req8.byte_len() * 3)
        expect(p16.header_copy_bytes).to_be_less_than(req16.byte_len() * 3)
        expect(p16.header_copy_bytes * 10).to_be_less_than(p8.header_copy_bytes * 26)

