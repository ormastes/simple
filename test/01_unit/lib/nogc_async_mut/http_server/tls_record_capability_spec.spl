"""HTTP worker TLS record capability gate."""

use std.spec
use std.http_server.types.{
    tls_record_path_admits_min_version, tls_record_path_rejection}

describe "HTTP worker TLS record capability":
    it "admits the implemented TLS 1.2 record path":
        expect(tls_record_path_admits_min_version("1.2")).to_equal(true)
        expect(tls_record_path_rejection("1.2")).to_equal("")

    it "fails closed for TLS 1.3 instead of falsely advertising it":
        expect(tls_record_path_admits_min_version("1.3")).to_equal(false)
        val reason = tls_record_path_rejection("1.3")
        expect(reason).to_contain("supports only TLS 1.2")
        expect(reason).to_contain("was not advertised")

    it "fails closed for unknown or malformed version floors":
        expect(tls_record_path_admits_min_version("")).to_equal(false)
        expect(tls_record_path_admits_min_version("1.4")).to_equal(false)
