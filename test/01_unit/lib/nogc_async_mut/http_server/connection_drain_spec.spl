"""Graceful HTTP drain completes accepted responses and closes afterward."""

use std.spec
use std.http_server.connection.{Connection}
use std.http_server.types.{ConnectionState, ConnectionAction, default_response_data}

describe "HTTP connection graceful drain":
    it "serializes a final text response with Connection close":
        var connection = Connection.new(7, "127.0.0.1:1", 100)
        connection.set_response_draining(
            default_response_data(200, "OK", "rendered"))
        expect(connection.state).to_equal(ConnectionState.Draining)
        expect(connection.keepalive).to_equal(false)
        expect(connection.get_response_bytes()).to_contain("Connection: close")
        expect(connection.on_write_complete(101)).to_equal(ConnectionAction.Close)

    it "serializes a final binary response and closes afterward":
        var connection = Connection.new(8, "127.0.0.1:2", 200)
        var response = default_response_data(200, "OK", "")
        response.body_bytes = [137u8, 80u8, 78u8, 71u8]
        connection.set_response_bytes_draining(response)
        expect(connection.state).to_equal(ConnectionState.Draining)
        expect(connection.keepalive).to_equal(false)
        expect(connection.get_response_bytes_buf().len()).to_be_greater_than(4)
        expect(connection.on_write_complete(201)).to_equal(ConnectionAction.Close)
