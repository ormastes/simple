# Canonical async task-state behavior.

use std.async.task.{TaskState}

describe "TaskState terminal state":
    it "accepts only completed and cancelled states":
        expect(TaskState.Completed.is_terminal()).to_equal(true)
        expect(TaskState.Cancelled.is_terminal()).to_equal(true)
        expect(TaskState.Pending.is_terminal()).to_equal(false)
        expect(TaskState.Running.is_terminal()).to_equal(false)
        expect(TaskState.Suspended.is_terminal()).to_equal(false)
