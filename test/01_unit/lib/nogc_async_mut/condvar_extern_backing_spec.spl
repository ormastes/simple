# Prevention for the multithreaded-scheduler failure in async_mutex_suspend_spec:
# every spl_condvar_* extern thread_sffi declares must be backed by the runtime
# (the interpreter refused spl_condvar_create). Drives the real ABI end to end.
extern fn spl_mutex_create() -> i64
extern fn spl_mutex_lock(h: i64) -> bool
extern fn spl_mutex_unlock(h: i64) -> bool
extern fn spl_condvar_create() -> i64
extern fn spl_condvar_wait_timeout(cv: i64, m: i64, timeout_ms: i64) -> bool
extern fn spl_condvar_signal(cv: i64) -> bool
extern fn spl_condvar_broadcast(cv: i64) -> bool
extern fn spl_condvar_destroy(cv: i64)

describe "spl_condvar_* runtime backing":
    it "creates, signals, times out and destroys a condvar":
        val m = spl_mutex_create()
        val cv = spl_condvar_create()
        expect(cv > 0).to_equal(true)
        expect(spl_condvar_signal(cv)).to_equal(true)
        expect(spl_condvar_broadcast(cv)).to_equal(true)
        expect(spl_mutex_lock(m)).to_equal(true)
        expect(spl_condvar_wait_timeout(cv, m, 10)).to_equal(false)
        expect(spl_mutex_unlock(m)).to_equal(true)
        spl_condvar_destroy(cv)
