use std.spec.*
use common.gpu.environment_variant_task_contract_v1.*
use std.nogc_async_mut.gpu.environment_variant_adapter_v1.*
use std.nogc_async_mut.gpu.environment_variant_task_owner_v1.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.provider_generation_v2.*
use std.nogc_sync_mut.composition.environment_variants.artifact_admission_v1.*

fn d(v: u64) -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: v, w1: 0u64, w2: 0u64, w3: 0u64)
fn td(v: u64) -> GpuTaskIdentityV1:
    GpuTaskIdentityV1(w0: v, w1: 0u64, w2: 0u64, w3: 0u64)

fn activation_evidence(variant: u64 = 2u64) -> ProviderActivationEvidenceV2:
    ProviderActivationEvidenceV2(
        provider_identity: d(1u64), variant_identity: d(variant),
        artifact_identity: d(60u64), abi_identity: d(13u64),
        contract_identity: d(14u64), semantic_identity: d(15u64),
        grammar_identity: d(16u64), program_identity: d(4u64),
        plan_identity: d(17u64), environment_identity: d(10u64),
        environment_generation: 11u64, mapped_handle: variant + 100u64,
        callable_binding_identity: d(18u64 + variant),
        activation_authority_identity: d(19u64))

fn host_snapshot() -> EnvironmentSnapshotV1:
    val features = EnvironmentFeatureSetV1(
        architecture: ENV_ARCH_X86_64_V1,
        words: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32))
    EnvironmentSnapshotV1(
        descriptor_size: 232u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        execution_architecture: ENV_ARCH_X86_64_V1, os_id: 1u32,
        abi_id: 1u32, object_format_id: 1u32, endian_id: 1u16,
        pointer_width_bits: 64u16, snapshot_identity: d(10u64),
        snapshot_generation: 11u64, execution_domain_identity: d(20u64),
        hardware_features: features, os_usable_features: features,
        policy_allowed_features: features, vector_state_mode: ENV_VECTOR_FIXED_V1,
        vector_length_bits: 256u32, loader_permission_bits: 1u64,
        allowed_effect_bits: 7u64, numerical_contract_id: 2u32,
        resource_layout_digest: d(5u64),
        gpu_devices: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32))

fn host_device() -> EnvironmentGpuDeviceV1:
    EnvironmentGpuDeviceV1(
        device_identity: d(7u64), api_id: 1u32, api_version: 13u32,
        enabled_feature_words: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32),
        memory_domain_bits: 1u64, max_buffer_bytes: 4096u64,
        max_workgroup_invocations: 256u32, queue_family_count: 2u32)

fn provider(generation: u64) -> GpuHostControlProviderV1:
    GpuHostControlProviderV1(
        provider_identity: d(1u64), variant_identity: d(2u64),
        provider_generation: generation, registry_backend_id: 1u32,
        device_program_identity: d(4u64), resource_layout_digest: d(5u64),
        artifact_digest: d(60u64),
        abi_identity: d(13u64), api_contract_identity: d(14u64),
        allowed_effect_bits: 7u64, numerical_contract_id: 2u32)
fn image() -> GpuDeviceProgramImageV1:
    GpuDeviceProgramImageV1(
        program_identity: d(4u64), image_digest: d(6u64), device_api_id: 1u32,
        minimum_api_version: 12u32, required_feature_bits: 3u64,
        minimum_buffer_bytes: 128u64, minimum_workgroup_invocations: 64u32,
        minimum_queue_family_count: 1u32, resource_layout_digest: d(5u64),
        abi_identity: d(13u64), api_contract_identity: d(14u64),
        required_effect_bits: 1u64, numerical_contract_id: 2u32)
fn device() -> GpuEnabledDeviceAuthorityV1:
    GpuEnabledDeviceAuthorityV1(
        device_identity: d(7u64), registry_generation: 11u64,
        device_api_id: 1u32, enabled_api_version: 13u32,
        enabled_feature_bits: 3u64, maximum_buffer_bytes: 4096u64,
        maximum_workgroup_invocations: 256u32, queue_family_count: 2u32)
fn image_authority() -> GpuDeviceProgramImageAuthorityV1:
    GpuDeviceProgramImageAuthorityV1(
        observed_image_digest: d(6u64), required_trust_policy_digest: d(70u64),
        required_verifier_identity: d(71u64), minimum_verifier_generation: 72u64,
        trust_receipt: ArtifactTrustVerificationReceiptV1(
            descriptor_size: ENV_ARTIFACT_TRUST_RECEIPT_BYTES_V1,
            schema_version: ENV_VARIANT_SCHEMA_V1,
            authentication_status: ENV_ARTIFACT_TRUST_AUTHENTICATED_V1,
            receipt_identity: d(73u64), artifact_digest: d(6u64),
            trust_policy_digest: d(70u64), verifier_identity: d(71u64),
            verifier_generation: 72u64, verification_evidence_digest: d(74u64)))
fn lease(generation: u64, identity: u64 = 8u64,
    lease_generation: u64 = 5u64) -> GpuResourceLeaseV1:
    GpuResourceLeaseV1(
        lease_identity: d(identity), device_identity: d(7u64),
        provider_generation: generation, resource_layout_digest: d(5u64),
        leased_bytes: 256u64, lease_generation: lease_generation)
fn task(generation: u64, invocation: u64 = 21u64,
    lease_generation: u64 = 5u64) -> GpuBoundedTaskV1:
    GpuBoundedTaskV1(
        descriptor_size: GPU_ENVIRONMENT_TASK_DESCRIPTOR_BYTES_V1,
        schema_version: GPU_ENVIRONMENT_TASK_SCHEMA_V1,
        operation_kind: GpuTaskOperationKindV1.FrontendParse,
        fallback_policy: GpuTaskFallbackPolicyV1.AllowCpu,
        invocation_id: invocation, provider_generation: generation,
        lease_generation: lease_generation,
        input_arena: GpuTaskArenaRangeV1(offset: 0u64, length: 128u64),
        output_arena: GpuTaskArenaRangeV1(offset: 128u64, length: 128u64),
        arena_capacity_bytes: 256u64, resource_layout_identity: td(5u64),
        required_effect_bits: 1u64, numerical_contract_id: 2u32,
        cpu_fallback_semantically_allowed: true)

fn setup() -> (ProviderGenerationManagerV2, GpuEnvironmentTaskOwnerV1,
    ProviderGenerationActivationV2, ProviderActivationEvidenceV2,
    GpuEnvironmentAdmittedProviderV1, GpuEnvironmentProviderCallbackOwnerV1,
    GpuEnvironmentProviderCallbackPortV1, GpuEnvironmentProviderPortV1):
    val manager = ProviderGenerationManagerV2.create()
    val evidence = activation_evidence()
    val activation = provider_generation_activate_v2(manager, evidence).unwrap()
    val resources = GpuEnvironmentResourceLeaseOwnerV1.create(
        evidence.callable_binding_identity)
    _ = gpu_environment_resource_lease_issue_v1(resources, device(),
        lease(activation.generation), d(80u64), d(81u64), 256u64).unwrap()
    val owner = GpuEnvironmentTaskOwnerV1.create(
        manager, host_snapshot(), [3u64], [host_device()], resources).unwrap()
    val admitted = gpu_environment_task_provider_admit_v1(
        owner, activation, evidence, provider(activation.generation), image(),
        image_authority(), device()).unwrap()
    val callbacks = GpuEnvironmentProviderCallbackOwnerV1.create()
    val callback_port = gpu_environment_provider_callback_port_register_v1(
        callbacks, evidence.provider_identity, evidence.variant_identity,
        activation.generation, evidence.callable_binding_identity).unwrap()
    val port = gpu_environment_task_provider_port_register_v1(
        owner, admitted, callbacks, callback_port).unwrap()
    (manager, owner, activation, evidence, admitted, callbacks, callback_port, port)

fn retain_completion(owner: GpuEnvironmentTaskOwnerV1,
    callbacks: GpuEnvironmentProviderCallbackOwnerV1,
    callback_port: GpuEnvironmentProviderCallbackPortV1,
    handle: GpuEnvironmentTaskHandleV1,
    provider_port: GpuEnvironmentProviderPortV1,
    submitted: GpuEnvironmentTaskSubmissionReceiptV1,
    terminal: GpuEnvironmentProviderTerminalV1,
    fence: EnvironmentDigest256V1, completion: EnvironmentDigest256V1,
    readback: EnvironmentDigest256V1, readback_bytes: u64,
    lease_generation: u64, committed: bool
) -> Result<GpuEnvironmentRetainedCompletionV1, GpuEnvironmentTaskErrorV1>:
    val callback = gpu_environment_provider_callback_record_v1(
        callbacks, callback_port, submitted, terminal, fence, completion,
        readback, readback_bytes, lease_generation, committed)?
    gpu_environment_task_completion_record_v1(
        owner, handle, provider_port, submitted, callbacks, callback)

describe "GPU environment task owner V1":
    it "pins the exact generation from prepare through retained completion and retirement":
        val values = setup(); val manager = values.0; val owner = values.1
        val activation = values.2; val evidence = values.3
        val admitted = values.4; val callbacks = values.5
        val callback_port = values.6; val port = values.7
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(activation.generation), task(activation.generation)).unwrap()
        expect(provider_generation_exact_pin_count_v2(owner.generation_manager, activation, evidence)).to_equal(Ok(2u64))
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        expect(submitted.state).to_equal(GpuTaskStateV1.Submitted)
        expect(submitted.device_execution_proven).to_equal(false)
        val retained = retain_completion(owner, callbacks, callback_port, handle, port, submitted,
            GpuEnvironmentProviderTerminalV1.Completed, d(30u64), d(31u64),
            d(32u64), 128u64, 5u64, true).unwrap()
        val completed = gpu_environment_task_complete_v1(owner, handle, retained).unwrap()
        expect(completed.state).to_equal(GpuTaskStateV1.Completed)
        expect(completed.readback_bytes).to_equal(128u64)
        expect(completed.device_execution_proven).to_equal(false)
        expect(gpu_environment_task_complete_v1(owner, handle, retained)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.CompletionUnknown))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(Ok(()))
        expect(provider_generation_exact_pin_count_v2(owner.generation_manager, activation, evidence)).to_equal(Ok(1u64))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.TaskUnknown))

    it "rejects forged completion handles and keeps retirement fenced":
        val values = setup(); val owner = values.1; val admitted = values.4; val port = values.7
        val generation = values.2.generation
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(generation), task(generation)).unwrap()
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        val forged = GpuEnvironmentRetainedCompletionV1(
            completion_id: 77u64, owner_identity: owner.owner_identity,
            task_id: handle.task_id, submission_id: submitted.submission_id)
        expect(gpu_environment_task_complete_v1(owner, handle, forged)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.CompletionUnknown))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.TerminalFenceRequired))

    it "consumes exactly one backend callback and releases admission only after drain":
        val values = setup(); val manager = values.0; val owner = values.1
        val activation = values.2; val evidence = values.3; val admitted = values.4
        val callbacks = values.5; val callback_port = values.6; val port = values.7
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(activation.generation), task(activation.generation)).unwrap()
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        val callback = gpu_environment_provider_callback_record_v1(
            callbacks, callback_port, submitted,
            GpuEnvironmentProviderTerminalV1.Completed, d(33u64), d(34u64),
            d(35u64), 128u64, 5u64, true).unwrap()
        expect(gpu_environment_provider_callback_record_v1(
            callbacks, callback_port, submitted,
            GpuEnvironmentProviderTerminalV1.FailedDrained, d(36u64), d(37u64),
            d(0u64), 0u64, 5u64, false)).to_equal(
                Err(GpuEnvironmentTaskErrorV1.InvalidState))
        val retained = gpu_environment_task_completion_record_v1(
            owner, handle, port, submitted, callbacks, callback).unwrap()
        _ = gpu_environment_task_complete_v1(owner, handle, retained).unwrap()
        expect(gpu_environment_task_provider_release_v1(owner, admitted)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.InvalidState))
        _ = gpu_environment_task_retire_v1(owner, handle).unwrap()
        _ = gpu_environment_task_provider_port_close_v1(owner, port).unwrap()
        expect(gpu_environment_task_provider_release_v1(owner, admitted)).to_equal(Ok(()))
        expect(provider_generation_exact_pin_count_v2(
            owner.generation_manager, activation, evidence)).to_equal(Ok(0u64))

    it "retains generation and leases while submitted cancellation waits for a backend fence":
        val values = setup(); val manager = values.0; val owner = values.1
        val activation = values.2; val evidence = values.3
        val admitted = values.4; val callbacks = values.5
        val callback_port = values.6; val port = values.7
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(activation.generation), task(activation.generation)).unwrap()
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        expect(gpu_environment_task_cancel_v1(owner, handle)).to_equal(Ok(GpuTaskStateV1.Cancelled))
        expect(gpu_environment_task_fallback_decision_v1(owner, handle)).to_equal(
            Ok(GpuTaskFallbackDecisionV1.WaitForTerminalFence))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.TerminalFenceRequired))
        expect(provider_generation_exact_pin_count_v2(owner.generation_manager, activation, evidence)).to_equal(Ok(2u64))
        val retained = retain_completion(owner, callbacks, callback_port, handle, port, submitted,
            GpuEnvironmentProviderTerminalV1.CancelledDrained, d(40u64), d(41u64),
            d(0u64), 0u64, 5u64, false).unwrap()
        val completed = gpu_environment_task_complete_v1(owner, handle, retained).unwrap()
        expect(completed.state).to_equal(GpuTaskStateV1.Cancelled)
        expect(gpu_environment_task_fallback_decision_v1(owner, handle)).to_equal(
            Ok(GpuTaskFallbackDecisionV1.UseCpu))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(Ok(()))

    it "rejects submission after resource revocation but permits prepared cleanup":
        val values = setup(); val owner = values.1; val admitted = values.4; val port = values.7
        val generation = values.2.generation
        val extra_lease = lease(generation, 90u64, 91u64)
        val resource = gpu_environment_resource_lease_issue_v1(
            owner.resource_owner, device(), extra_lease, d(92u64), d(93u64), 256u64).unwrap()
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            extra_lease, task(generation, 94u64, 91u64)).unwrap()
        expect(gpu_environment_resource_lease_revoke_v1(
            owner.resource_owner, resource)).to_equal(true)
        expect(gpu_environment_task_submit_v1(owner, handle, port)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.InvalidState))
        expect(gpu_environment_task_cancel_v1(owner, handle)).to_equal(
            Ok(GpuTaskStateV1.Cancelled))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(Ok(()))

    it "never replays CPU work after an uncertain submission":
        val values = setup(); val owner = values.1; val admitted = values.4
        val callbacks = values.5; val callback_port = values.6; val port = values.7
        val generation = values.2.generation
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(generation), task(generation)).unwrap()
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        val uncertain = retain_completion(owner, callbacks, callback_port, handle, port, submitted,
            GpuEnvironmentProviderTerminalV1.Uncertain, d(0u64), d(0u64),
            d(0u64), 0u64, 5u64, false).unwrap()
        expect(gpu_environment_task_complete_v1(owner, handle, uncertain)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.SubmissionUncertain))
        expect(gpu_environment_task_fallback_decision_v1(owner, handle)).to_equal(
            Ok(GpuTaskFallbackDecisionV1.WaitForTerminalFence))
        expect(gpu_environment_task_retire_v1(owner, handle)).to_equal(
            Err(GpuEnvironmentTaskErrorV1.TerminalFenceRequired))

    it "preserves require-requested after a drained provider failure":
        val values = setup(); val owner = values.1; val admitted = values.4
        val callbacks = values.5; val callback_port = values.6; val port = values.7
        val generation = values.2.generation
        var required = task(generation)
        required.fallback_policy = GpuTaskFallbackPolicyV1.RequireRequested
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(generation), required).unwrap()
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        val failed = retain_completion(owner, callbacks, callback_port, handle, port, submitted,
            GpuEnvironmentProviderTerminalV1.FailedDrained, d(50u64), d(51u64),
            d(0u64), 0u64, 5u64, false).unwrap()
        _ = gpu_environment_task_complete_v1(owner, handle, failed).unwrap()
        expect(gpu_environment_task_fallback_decision_v1(owner, handle)).to_equal(
            Ok(GpuTaskFallbackDecisionV1.RequiredProviderUnavailable))

    it "rejects stale provider admission after replacement before prepare":
        val values = setup(); val manager = values.0; val owner = values.1
        val admitted = values.4
        _ = provider_generation_activate_v2(owner.generation_manager, activation_evidence(22u64)).unwrap()
        expect(gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(values.2.generation), task(values.2.generation))).to_equal(
                Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration))

    it "keeps a prepared generation pinned across replacement and provider submission":
        val values = setup(); val owner = values.1; val admitted = values.4; val port = values.7
        val activation = values.2; val evidence = values.3
        val handle = gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(activation.generation), task(activation.generation)).unwrap()
        _ = provider_generation_activate_v2(owner.generation_manager,
            activation_evidence(23u64)).unwrap()
        expect(provider_generation_exact_pin_count_v2(
            owner.generation_manager, activation, evidence)).to_equal(Ok(2u64))
        val submitted = gpu_environment_task_submit_v1(owner, handle, port).unwrap()
        expect(submitted.provider_generation).to_equal(activation.generation)
        expect(submitted.generation_pin_id > 0u64).to_equal(true)
        expect(submitted.native_call_pin_dependency).to_equal(true)

    it "rejects exact image layout effect numerical and enabled-device substitutions":
        val values = setup(); val owner = values.1; val admitted = values.4
        val generation = values.2.generation
        var wrong_image = image(); wrong_image.image_digest = d(99u64)
        expect(gpu_environment_task_prepare_v1(owner, admitted, wrong_image, device(),
            lease(generation), task(generation))).to_equal(
                Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch))
        var wrong_task = task(generation); wrong_task.required_effect_bits = 2u64
        expect(gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(generation), wrong_task)).to_equal(
                Err(GpuEnvironmentTaskErrorV1.TaskContractMismatch))
        var supported_not_enabled = device(); supported_not_enabled.enabled_feature_bits = 7u64
        expect(gpu_environment_task_prepare_v1(owner, admitted, image(), supported_not_enabled,
            lease(generation), task(generation))).to_equal(
                Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch))

    it "does not authorize device rows outside the host snapshot range":
        val manager = ProviderGenerationManagerV2.create()
        val evidence = activation_evidence()
        val activation = provider_generation_activate_v2(manager, evidence).unwrap()
        var zero_devices = host_snapshot()
        zero_devices.gpu_devices = EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)
        val resources = GpuEnvironmentResourceLeaseOwnerV1.create(
            evidence.callable_binding_identity)
        val owner = GpuEnvironmentTaskOwnerV1.create(
            manager, zero_devices, [3u64], [host_device()], resources).unwrap()
        expect(gpu_environment_task_provider_admit_v1(
            owner, activation, evidence, provider(activation.generation), image(),
            image_authority(), device())).to_equal(
                Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch))

    it "rejects duplicate device identities inside the authorized host range":
        val manager = ProviderGenerationManagerV2.create()
        val evidence = activation_evidence()
        val activation = provider_generation_activate_v2(manager, evidence).unwrap()
        var duplicate_host = host_snapshot()
        duplicate_host.gpu_devices = EnvironmentArenaRangeV1(offset: 0u32, count: 2u32)
        val resources = GpuEnvironmentResourceLeaseOwnerV1.create(
            evidence.callable_binding_identity)
        val owner = GpuEnvironmentTaskOwnerV1.create(
            manager, duplicate_host, [3u64], [host_device(), host_device()], resources).unwrap()
        expect(gpu_environment_task_provider_admit_v1(
            owner, activation, evidence, provider(activation.generation), image(),
            image_authority(), device())).to_equal(
                Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch))

    it "bounds in-flight tasks at the exact owner and generation-pin capacity":
        val values = setup(); val owner = values.1; val admitted = values.4
        val generation = values.2.generation
        for i in 0..255:
            val lease_identity = (1000 + i) as u64
            val lease_generation = (2000 + i) as u64
            val task_lease = lease(generation, lease_identity, lease_generation)
            _ = gpu_environment_resource_lease_issue_v1(owner.resource_owner, device(),
                task_lease, d((3000 + i) as u64), d((4000 + i) as u64), 256u64).unwrap()
            expect(gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
                task_lease, task(generation, (i + 1) as u64, lease_generation)).is_ok()).to_equal(true)
        expect(gpu_environment_task_prepare_v1(owner, admitted, image(), device(),
            lease(generation), task(generation, 300u64))).to_equal(
                Err(GpuEnvironmentTaskErrorV1.TaskCapacityExceeded))
