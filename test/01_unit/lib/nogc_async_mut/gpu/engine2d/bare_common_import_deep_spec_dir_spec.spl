"""A spec six directories deep under a tree that mirrors `src/` still resolves bare `common.*` and `std.*` imports.

`test/01_unit/lib/nogc_async_mut/src/` makes its parent look like a project root
to the module resolver. The stdlib fallback used to climb only five levels, so a
spec at this depth could not reach `src/lib` on the run/HIR lane.
See doc/08_tracking/bug/run_lane_bare_common_import_unresolved_deep_spec_dir_2026-10-30.md."""

use std.spec.*
use common.string_core.{str_len, str_concat}

describe "bare common import from a deep spec directory":
    it "resolves common.string_core":
        # @req REQ-MODULE-RESOLUTION-STDLIB
        expect(str_len(str_concat("ab", "c"))).to_equal(3)
