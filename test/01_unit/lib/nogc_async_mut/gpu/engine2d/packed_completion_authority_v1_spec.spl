# @cover src/lib/nogc_async_mut/gpu/engine2d/packed_completion_authority_v1.spl 80%
# @tag: unit, gpu, draw_ir, host_gpu_queue, nogc
"""
## Purpose and audience
Packed DrawIR completion is the seam where a queued GPU epoch either advances on
a backend owner's callback authority or stays a routing-only receipt. This
manual is for the engineers wiring a real Vulkan/CUDA/Metal callback onto the
no-GC runtime queue: it shows what the queue owner checks before it spends an
authority, and every way the join fails closed. Feature IDs:
gpu_scheduler_hardening. Category: Stdlib.
## Operator workflow
bin/simple test test/01_unit/lib/nogc_async_mut/gpu/engine2d/packed_completion_authority_v1_spec.spl
## Compatibility and limitations
Pure queue-side ledger/correlation logic over the process-local bounded runtime
queue; runs on every host with no device attached. The authority records built
here are validator fixtures — a production authority is issued by the backend
owner from its own retained fence/lease record, and this seam never derives one.
Passing evidence through does not make it true: a fixture that satisfies
`engine2d_gpu_device_evidence_qualifies` proves the queue did not substitute
its own evidence, not that a GPU ran.
## Verification guidance and troubleshooting
A RED here means the completion seam changed: authority correlation, single-use
redemption, evidence pass-through, or the retirement state machine. Fix the seam
or its caller, never the spec. Each scenario resets the process-global queue
first.
"""
# Lifecycle: doc/03_plan/agent_tasks/environment_optimized_dynamic_libraries.md ;
# doc/04_architecture/gpu_scheduler_hardening_gpu_resident_rendering.md ; doc/05_design/gpu_scheduler_hardening_gpu_resident_rendering.md
# @manual_section: primary

use std.spec.*
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU,
    draw_ir_batch,
    draw_ir_embedding_config,
    draw_ir_rect
}
use common.ui.draw_ir_v3_ports.{DRAW_IR_V3_CAP_COMPUTE_PASSES}
use common.gpu.engine2d.gpu_epoch.{
    ENGINE2D_GPU_PHASE_COMPLETED,
    ENGINE2D_GPU_PHASE_QUEUED,
    ENGINE2D_GPU_PHASE_RETIRED,
    ENGINE2D_GPU_PHASE_SUBMITTED,
    ENGINE2D_GPU_PROFILE_SCENE_BALANCED,
    Engine2dGpuDeviceEvidence,
    engine2d_gpu_device_evidence_none,
    engine2d_gpu_device_evidence_qualifies
}
use std.nogc_async_mut.gpu.engine2d.draw_ir_runtime_queue.{
    engine2d_draw_ir_epoch_request_from_batch,
    engine2d_draw_ir_runtime_queue_complete_packed,
    engine2d_draw_ir_runtime_queue_complete_packed_with_authority,
    engine2d_draw_ir_runtime_queue_retire_packed,
    engine2d_draw_ir_runtime_queue_submit_packed
}
use std.nogc_async_mut.gpu.engine2d.packed_completion_authority_v1.{
    Engine2dPackedCompletionAuthorityV1,
    engine2d_packed_completion_ledger_new
}
use std.nogc_async_mut.gpu.engine2d.host_gpu_event_queue.{
    engine2d_host_gpu_runtime_queue_with_backend_handle,
    engine2d_host_gpu_runtime_reset
}

val GREEN: u32 = 0xff00ff00u32

fn packed_batch(batch_id: text):
    draw_ir_batch(batch_id, DRAW_IR_BACKEND_GPU, draw_ir_embedding_config("surf1", "win1", 0, 0, 20, 16, 10, 1000, false), [
        draw_ir_rect("body", 2, 3, 6, 5, GREEN)
    ])

fn queued_packed_receipt(batch_id: text):
    engine2d_host_gpu_runtime_reset()
    val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)
    val request = engine2d_draw_ir_epoch_request_from_batch(packed_batch(batch_id), ENGINE2D_GPU_PROFILE_SCENE_BALANCED, queue, 4096u64, 1u64, 2u64, 3u64, 4u64, 5u64)
    engine2d_draw_ir_runtime_queue_submit_packed(request, queue, true, DRAW_IR_V3_CAP_COMPUTE_PASSES)

fn probe_queue():
    engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)

# Fixture evidence only. The field values imitate what a backend owner would
# retain from its own fence and timestamp query; nothing here read a device.
fn fixture_qualifying_evidence() -> Engine2dGpuDeviceEvidence:
    Engine2dGpuDeviceEvidence(
        binary_identity: "fixture-backend-owner",
        device_name: "fixture-device",
        device_type: "integrated_gpu",
        driver_identity: "fixture-driver-1.0",
        host_submit_ns: 1000,
        host_complete_ns: 2000,
        device_timestamp_available: true,
        device_begin_ticks: 10,
        device_end_ticks: 40,
        transfer_bytes: 64,
        negative_control_passed: true
    )

fn fixture_authority(evidence: Engine2dGpuDeviceEvidence) -> Engine2dPackedCompletionAuthorityV1:
    Engine2dPackedCompletionAuthorityV1(
        completion_handle: 11u64,
        owner_identity: 5u64,
        queue_handle: 1,
        backend_handle: 7,
        queue_generation: 1u64,
        operation_generation: 2u64,
        scene_generation: 3u64,
        surface_generation: 4u64,
        arena_generation: 5u64,
        evidence: evidence
    )

describe "no-GC Engine2D packed completion callback authority":
    # @manual scenario evidence

    it "refuses packed completion when the backend owner issued no callback authority":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Queue a packed epoch, then attempt completion with no authority")
        val receipt = queued_packed_receipt("authority-absent")
        expect(receipt.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        val ledger = engine2d_packed_completion_ledger_new()

        val outcome = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(receipt, probe_queue(), ledger, nil)

        expect(outcome.admitted).to_be(false)
        expect(outcome.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        expect(outcome.refusal).to_contain("backend-issued callback authority")
        expect(outcome.ledger.spent.len()).to_equal(0)
        engine2d_host_gpu_runtime_reset()

    it "refuses a callback authority whose handle was not issued by an owner":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Present an authority with a zero completion handle")
        val receipt = queued_packed_receipt("authority-forged")
        val ledger = engine2d_packed_completion_ledger_new()
        var forged = fixture_authority(fixture_qualifying_evidence())
        forged.completion_handle = 0u64

        val outcome = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(receipt, probe_queue(), ledger, forged)

        expect(outcome.admitted).to_be(false)
        expect(outcome.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        expect(outcome.refusal).to_contain("owner-issued")
        expect(outcome.ledger.spent.len()).to_equal(0)
        engine2d_host_gpu_runtime_reset()

    it "refuses a callback authority that does not correlate with this epoch":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Present an authority naming a different operation generation")
        val receipt = queued_packed_receipt("authority-mismatch")
        val ledger = engine2d_packed_completion_ledger_new()
        var mismatched = fixture_authority(fixture_qualifying_evidence())
        mismatched.operation_generation = 99u64

        val outcome = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(receipt, probe_queue(), ledger, mismatched)

        expect(outcome.admitted).to_be(false)
        expect(outcome.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        expect(outcome.refusal).to_contain("correlate")
        expect(outcome.ledger.spent.len()).to_equal(0)
        engine2d_host_gpu_runtime_reset()

    it "advances the epoch on the owner-issued evidence without re-deriving it":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Redeem a correlated authority carrying qualifying owner evidence")
        val receipt = queued_packed_receipt("authority-ok")
        val ledger = engine2d_packed_completion_ledger_new()
        val evidence = fixture_qualifying_evidence()
        expect(engine2d_gpu_device_evidence_qualifies(evidence)).to_be(true)

        val outcome = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(receipt, probe_queue(), ledger, fixture_authority(evidence))

        expect(outcome.admitted).to_be(true)
        expect(outcome.refusal).to_equal("")
        expect(outcome.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_COMPLETED)
        step("The receipt tracks the authority's own evidence, not a queue-built substitute")
        expect(outcome.receipt.device_execution_proven).to_be(true)
        expect(outcome.receipt.routing_evidence_only).to_be(false)
        expect(outcome.ledger.spent.len()).to_equal(1)
        engine2d_host_gpu_runtime_reset()

    it "keeps the completion routing-only when the owner-issued evidence does not qualify":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Redeem a correlated authority whose evidence is host-only")
        val receipt = queued_packed_receipt("authority-unqualified")
        val ledger = engine2d_packed_completion_ledger_new()
        val evidence = engine2d_gpu_device_evidence_none()
        expect(engine2d_gpu_device_evidence_qualifies(evidence)).to_be(false)

        val outcome = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(receipt, probe_queue(), ledger, fixture_authority(evidence))

        expect(outcome.admitted).to_be(true)
        expect(outcome.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_COMPLETED)
        expect(outcome.receipt.device_execution_proven).to_be(false)
        expect(outcome.receipt.routing_evidence_only).to_be(true)
        engine2d_host_gpu_runtime_reset()

    it "refuses a callback authority a second time because redemption is single-use":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Redeem one authority, then present the same handle against a fresh epoch")
        val first = queued_packed_receipt("authority-once")
        val ledger = engine2d_packed_completion_ledger_new()
        val authority = fixture_authority(fixture_qualifying_evidence())
        val spent = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(first, probe_queue(), ledger, authority)
        expect(spent.admitted).to_be(true)

        val second = queued_packed_receipt("authority-replay")
        val replay = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(second, probe_queue(), spent.ledger, authority)

        expect(replay.admitted).to_be(false)
        expect(replay.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        expect(replay.refusal).to_contain("single-use")
        expect(replay.ledger.spent.len()).to_equal(1)
        engine2d_host_gpu_runtime_reset()

    it "spends a validated authority even when the host queue holds no packet for it":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Queue a packed epoch, then drop the runtime queue under it")
        val receipt = queued_packed_receipt("authority-no-packet")
        val ledger = engine2d_packed_completion_ledger_new()
        engine2d_host_gpu_runtime_reset()

        val outcome = engine2d_draw_ir_runtime_queue_complete_packed_with_authority(receipt, probe_queue(), ledger, fixture_authority(fixture_qualifying_evidence()))

        step("One-shot means one presentation, not one success: the handle is burned")
        expect(outcome.admitted).to_be(false)
        expect(outcome.refusal).to_contain("no pending packet")
        expect(outcome.receipt.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        expect(outcome.ledger.spent.len()).to_equal(1)
        engine2d_host_gpu_runtime_reset()

    it "leaves the compatibility completion route routing-only and authority-free":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Complete the same packed epoch through the unchanged compatibility route")
        val receipt = queued_packed_receipt("compat-route")

        val completed = engine2d_draw_ir_runtime_queue_complete_packed(receipt, probe_queue())

        expect(completed.phase).to_equal(ENGINE2D_GPU_PHASE_COMPLETED)
        expect(completed.routing_evidence_only).to_be(true)
        expect(completed.device_execution_proven).to_be(false)
        engine2d_host_gpu_runtime_reset()

    it "retires only a completed packed epoch and treats retirement as terminal":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Retirement refuses a still-queued epoch")
        val receipt = queued_packed_receipt("retire-state-machine")
        val premature = engine2d_draw_ir_runtime_queue_retire_packed(receipt, probe_queue())
        expect(premature.phase).to_equal(ENGINE2D_GPU_PHASE_QUEUED)
        expect(premature.terminal).to_be(false)

        step("A completed epoch retires once, and the retired receipt never moves again")
        val completed = engine2d_draw_ir_runtime_queue_complete_packed(receipt, probe_queue())
        val retired = engine2d_draw_ir_runtime_queue_retire_packed(completed, probe_queue())
        expect(retired.phase).to_equal(ENGINE2D_GPU_PHASE_RETIRED)
        expect(retired.terminal).to_be(true)
        val again = engine2d_draw_ir_runtime_queue_retire_packed(retired, probe_queue())
        expect(again.phase).to_equal(ENGINE2D_GPU_PHASE_RETIRED)
        engine2d_host_gpu_runtime_reset()
