use std.spec
use std.nogc_async_mut.gpu.engine2d.simd_kernels.{engine2d_simd_fill_row_u32}

describe "async-family native row facade":
    it "preserves row width and every color bit":
        val pixels = engine2d_simd_fill_row_u32(5, 0xFEDCBA98u32)
        expect(pixels.len()).to_equal(5)
        for pixel in pixels:
            expect(pixel).to_equal(0xFEDCBA98u32)

    it "returns an empty row for zero width":
        expect(engine2d_simd_fill_row_u32(0, 0xFFFFFFFFu32).len()).to_equal(0)
