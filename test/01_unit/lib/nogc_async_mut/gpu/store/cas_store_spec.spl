"""
## Purpose and audience
Purpose: Prove that CAS store durability and recovery contract.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

use std.spec.*
use std.nogc_async_mut.gpu.store.{
    CasStore,
    CasManifest,
    cas_store_recover
}
use std.common.compute.placement_contracts.handles.{ObjectRef, object_ref}
use std.common.compute.placement_contracts.semantic.{ObjectSetView}
use std.common.compute.placement_contracts.storage.{artifact_id, artifact_id_valid}
use std.common.compute.placement_contracts.semantic.{AnyObject}

fn fixture() -> CasStore:
    CasStore.create("/tmp/simple-gpu-mmu-cas")

fn valid_id() -> text:
    "1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"

fn invalid_id() -> text:
    "1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdeg"

fn sample_object(slot: u32) -> ObjectRef<AnyObject>:
    object_ref(object_slot: slot, generation: 1)

fn sample_set(objects: [ObjectRef<AnyObject>]) -> ObjectSetView:
    ObjectSetView(objects: objects)

use std.spec.step

describe "CAS store durability and recovery contract":
    it "should write immutable blobs and read them back":
        step("Verify: should write immutable blobs and read them back")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val store = fixture()
        val payload = [1, 2, 3, 4, 5]
        val manifest = artifact_id(digest: valid_id(), byte_len: payload.len() as i64)
        val artifact = store.write_bytes(payload, manifest)
        val bytes = store.read_bytes(artifact)
        match bytes:
            case Some(stored):
                val ok = stored.len() == payload.len()
                expect(ok).to_equal(true)
            case nil:
                expect(false).to_equal(true)
        expect(artifact_id_valid(artifact)).to_equal(true)

    it "should checkpoint and recover all bound artifacts":
        step("Verify: should checkpoint and recover all bound artifacts")
        val store = fixture()
        val object_a = sample_object(1)
        val object_b = sample_object(2)
        val root = artifact_id(digest: valid_id(), byte_len: 2)
        store.write_object_bytes(object_a, [10, 20], root)
        store.write_object_bytes(object_b, [30, 40, 50], root)
        val receipt = store.checkpoint(sample_set([object_a, object_b]))
        expect(receipt.ok).to_equal(true)
        expect(receipt.object_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val recovered = cas_store_recover(store, receipt.root)
        expect(recovered.ok).to_equal(true)
        expect(recovered.recovered_objects).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "should fail checkpoint when an object has no artifact binding":
        step("Verify: should fail checkpoint when an object has no artifact binding")
        val store = fixture()
        val unbound = sample_object(7)
        val receipt = store.checkpoint(sample_set([unbound]))
        expect(receipt.ok).to_equal(false)
        expect(receipt.error).to_equal("checkpoint-missing-artifact")

    it "should fail recovery for a corrupt checkpoint manifest":
        step("Verify: should fail recovery for a corrupt checkpoint manifest")
        val store = fixture()
        val manifest = CasManifest(
            root: artifact_id(digest: valid_id(), byte_len: 1),
            object_ids: [artifact_id(digest: invalid_id(), byte_len: 1)],
            byte_count: 1
        )
        store.checkpoints.push(manifest)
        val recovered = cas_store_recover(store, manifest.root)
        expect(recovered.ok).to_equal(false)
        expect(recovered.error).to_equal("checkpoint-corrupt-manifest")

    it "should fail recovery for a missing checkpoint root":
        step("Verify: should fail recovery for a missing checkpoint root")
        val store = fixture()
        val root = artifact_id(digest: valid_id(), byte_len: 1)
        val recovered = cas_store_recover(store, root)
        expect(recovered.ok).to_equal(false)
        expect(recovered.error).to_equal("checkpoint-missing")
