# @req: REQ-LIB-NOGC-ASYNC-MUT-001

use std.spec.*
use std.nogc_async_mut.gpu.placement_backends.{
    make_deterministic_plan,
    StagedPlacementBackend,
    DirectPlacementBackend,
    DeviceInitiatedPlacementBackend
}
use std.nogc_async_mut.gpu.placement_backends.staged_backend.{staged_plan}
use std.nogc_async_mut.io.env_ops.{env_get}
use std.common.compute.placement_contracts.planner.{PlacementBudget, PlacementRequest}
use std.common.compute.placement_contracts.handles.{object_ref}
use std.common.compute.placement_contracts.semantic.{
    AccessPattern,
    ResidencyTierSet,
    DeviceMask,
    StageEpoch,
    CostUnit,
    PersistencePolicy,
    AffinityGroupId
}
use std.common.compute.placement_contracts.backend.{PlacementError}

fn sample_budget() -> PlacementBudget:
    PlacementBudget(
        device_bytes: 1024,
        host_pinned_bytes: 128,
        host_hot_bytes: 256,
        staging_bytes: 320,
        driver_queue_bytes: 64,
        manifest_cache_bytes: 64,
        runtime_base_bytes: 16
    )

fn request(slot: u32, reuse: u32) -> PlacementRequest:
    PlacementRequest(
        object: object_ref(object_slot: slot, generation: 1),
        access: AccessPattern.SequentialRead,
        required_tiers: ResidencyTierSet(tiers: []),
        preferred_tiers: [],
        device_mask: DeviceMask(bits: 0),
        expected_first_use: StageEpoch(value: 0),
        expected_last_use: StageEpoch(value: 1),
        expected_reuse_distance: reuse,
        recompute_cost: CostUnit(value: 100),
        transfer_cost_hint: CostUnit(value: 50),
        persistence: PersistencePolicy.Checkpoint,
        affinity_group: AffinityGroupId(value: slot as u64),
        deadline: nil
    )

use std.spec.step

describe "Placement backend and planner contracts":
    it "should keep planner output deterministic under request reorder":
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        step("Verify: should keep planner output deterministic under request reorder")
        val ordered = [request(2, 12), request(1, 9), request(3, 3)]
        val shuffled = [request(3, 3), request(1, 9), request(2, 12)]
        val plan_a = make_deterministic_plan(ordered, sample_budget())
        val plan_b = make_deterministic_plan(shuffled, sample_budget())
        expect(plan_a.receipt_seed.value).to_equal(plan_b.receipt_seed.value)

    it "should cap staged prefetch bytes by the ring budget":
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        step("Verify: should cap staged prefetch bytes by the ring budget")
        val backend = StagedPlacementBackend.with_budget(256, 1024)
        val prefetch = backend.prefetch(staged_plan(sample_budget()))
        match prefetch:
            case Result.Ok(receipt):
                expect(receipt.bytes_transferred).to_equal(256)  # oracle: 256 — named expected value from the requirement
            case Result.Err(_):
                expect(false).to_equal(true)

    it "should keep direct backend capability explicit and fail closed when unsupported":
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        step("Verify: should keep direct backend capability explicit and fail closed when unsupported")
        val backend = DirectPlacementBackend()
        val preflight = backend.probe().available
        val prefetch = backend.prefetch(staged_plan(sample_budget()))
        if preflight:
            match prefetch:
                case Result.Ok(receipt):
                    expect(receipt.backend).to_equal("direct")
                    expect(receipt.error).to_equal("")
                case Result.Err(_):
                    expect(false).to_equal(true)
        else:
            match prefetch:
                case Result.Ok(_):
                    expect(false).to_equal(true)
                case Result.Err(err):
                    expect(err).to_equal(PlacementError.Unsupported)

    it "should keep device-initiated backend behind an explicit experimental gate":
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        step("Verify: should keep device-initiated backend behind an explicit experimental gate")
        val backend = DeviceInitiatedPlacementBackend()
        expect(backend.probe().available).to_equal(
            env_get("SIMPLE_MMU_DEVICE_INITIATED_BACKEND") == "1"
        )
        val acquired = backend.acquire(staged_plan(sample_budget()))
        match acquired:
            case Result.Ok(_):
                expect(false).to_equal(true)
            case Result.Err(err):
                expect(err).to_equal(PlacementError.Unsupported)
