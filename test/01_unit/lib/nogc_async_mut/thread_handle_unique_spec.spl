# Regression: a top-level class name must be defined in exactly one stdlib
# module, otherwise whole-program native link collides (actor spec failures).
use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "ThreadHandle canonical definition":
    it "is defined once in nogc_sync_mut/concurrent/thread.spl only":
        val sffi = rt_file_read_text("src/lib/nogc_async_mut/thread_sffi.spl") ?? ""
        val canon = rt_file_read_text("src/lib/nogc_sync_mut/concurrent/thread.spl") ?? ""
        expect(sffi.contains("\nclass ThreadHandle:")).to_equal(false)
        expect(canon.contains("\nclass ThreadHandle:")).to_equal(true)
