"""
## Purpose and audience
Purpose: Prove that Thread Pool Task Registry.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

use std.spec.*
use std.nogc_async_mut.thread_pool.{
    TaskHandle,
    next_task_id,
    register_value_task_callback,
    get_value_task_callback,
    mark_task_done,
    task_is_done,
    task_result,
    release_task_registry
}

fn value_41() -> i64:
    41

use std.spec.step

describe "Thread Pool Task Registry":
    it "allocates non-zero task ids":
        step("Verify: allocates non-zero task ids")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val first = next_task_id()
        val second = next_task_id()
        expect(first > 0).to_equal(true)
        expect(second > first).to_equal(true)

    it "registers value callbacks by task id":
        step("Verify: registers value callbacks by task id")
        val task_id = next_task_id()
        register_value_task_callback(task_id, value_41)
        val callback = get_value_task_callback(task_id)
        expect(callback == nil).to_equal(false)
        expect(callback?()).to_equal(41)  # oracle: 41 — named expected value from the requirement

    it "records task completion and result":
        step("Verify: records task completion and result")
        val task_id = next_task_id()
        expect(task_is_done(task_id)).to_equal(false)
        mark_task_done(task_id, 77)
        expect(task_is_done(task_id)).to_equal(true)
        expect(task_result(task_id)).to_equal(77)  # oracle: 77 — named expected value from the requirement

    it "joins an already completed pool task handle":
        step("Verify: joins an already completed pool task handle")
        val task_id = next_task_id()
        mark_task_done(task_id, 123)
        var handle = TaskHandle(task_id: task_id, native_handle: 0, joined: false, cached_result: 0)
        expect(handle.is_done()).to_equal(true)
        expect(handle.id()).to_equal(task_id)
        expect(handle.join()).to_equal(123)  # oracle: 123 — named expected value from the requirement
        expect(handle.join()).to_equal(123)  # oracle: 123 — named expected value from the requirement
        expect(task_is_done(task_id)).to_equal(false)

    it "releases joined callback and result rows":
        step("Verify: releases joined callback and result rows")
        val task_id = next_task_id()
        register_value_task_callback(task_id, value_41)
        mark_task_done(task_id, 41)
        release_task_registry(task_id)
        expect(get_value_task_callback(task_id) == nil).to_equal(true)
        expect(task_is_done(task_id)).to_equal(false)

    it "documents native handle release before registry cleanup":
        step("Verify: documents native handle release before registry cleanup")
        val src = rt_file_read_text("src/lib/nogc_async_mut/thread_pool.spl") ?? ""
        expect(src.contains("so the provider can release its task record")).to_equal(true)
        expect(src.contains("Some(handle): result = handle.join()")).to_equal(true)
