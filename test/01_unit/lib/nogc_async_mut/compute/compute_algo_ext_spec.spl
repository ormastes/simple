"""
## Purpose and audience
Purpose: Prove that compute_algo_ext.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @cover src/lib/nogc_async_mut/compute/compute_algo_ext.spl
use std.spec.*
use std.nogc_async_mut.compute.compute_algo_ext.{compute_min_element, compute_max_element, compute_transform_reduce, compute_unique, compute_lower_bound, compute_binary_search, compute_exclusive_scan}
use std.nogc_async_mut.compute.exec_target.{ComputeDeviceClass, ComputeBackend, EnforceMode, BackendCaps, ExecTarget, resolve_exec_target}

fn less_i64(a: i64, b: i64) -> bool:
    a < b

fn add_i64(a: i64, b: i64) -> i64:
    a + b

fn dbl_i64(a: i64) -> i64:
    a * 2

fn cpu_target() -> ExecTarget:
    resolve_exec_target(ComputeDeviceClass.Cpu, ComputeBackend.NoneBackend, EnforceMode.Suggest, BackendCaps.none())

use std.spec.step

describe "compute_algo_ext":

    it "min_element returns index of minimum":
        step("Verify: min_element returns index of minimum")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val t = cpu_target()
        val data = [5, 2, 8, 1, 9]
        expect(compute_min_element(data, less_i64, t)).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "min_element returns -1 on empty":
        step("Verify: min_element returns -1 on empty")
        val t = cpu_target()
        val data: [i64] = []
        expect(compute_min_element(data, less_i64, t)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "max_element returns index of maximum":
        step("Verify: max_element returns index of maximum")
        val t = cpu_target()
        val data = [5, 2, 8, 1, 9]
        expect(compute_max_element(data, less_i64, t)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "max_element returns -1 on empty":
        step("Verify: max_element returns -1 on empty")
        val t = cpu_target()
        val data: [i64] = []
        expect(compute_max_element(data, less_i64, t)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "transform_reduce doubles then sums":
        step("Verify: transform_reduce doubles then sums")
        val t = cpu_target()
        val data = [1, 2, 3, 4]
        # (2+4+6+8) + init 0 = 20
        expect(compute_transform_reduce(data, dbl_i64, 0, add_i64, t)).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "transform_reduce on empty returns init":
        step("Verify: transform_reduce on empty returns init")
        val t = cpu_target()
        val data: [i64] = []
        expect(compute_transform_reduce(data, dbl_i64, 7, add_i64, t)).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "unique removes consecutive duplicates":
        step("Verify: unique removes consecutive duplicates")
        val t = cpu_target()
        val data = [1, 1, 2, 3, 3, 3, 1]
        val out = compute_unique(data, less_i64, t)
        expect(out.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(out[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(out[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(out[3]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "unique on empty returns empty":
        step("Verify: unique on empty returns empty")
        val t = cpu_target()
        val data: [i64] = []
        val out = compute_unique(data, less_i64, t)
        expect(out.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "lower_bound finds first not-less index":
        step("Verify: lower_bound finds first not-less index")
        val t = cpu_target()
        val data = [1, 3, 5, 7]
        expect(compute_lower_bound(data, 5, less_i64, t)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "lower_bound of missing low key is 0":
        step("Verify: lower_bound of missing low key is 0")
        val t = cpu_target()
        val data = [1, 3, 5, 7]
        expect(compute_lower_bound(data, 0, less_i64, t)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "lower_bound of key above all is len":
        step("Verify: lower_bound of key above all is len")
        val t = cpu_target()
        val data = [1, 3, 5, 7]
        expect(compute_lower_bound(data, 9, less_i64, t)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "binary_search hit":
        step("Verify: binary_search hit")
        val t = cpu_target()
        val data = [1, 3, 5, 7]
        expect(compute_binary_search(data, 5, less_i64, t)).to_equal(true)

    it "binary_search miss":
        step("Verify: binary_search miss")
        val t = cpu_target()
        val data = [1, 3, 5, 7]
        expect(compute_binary_search(data, 4, less_i64, t)).to_equal(false)

    it "binary_search on empty is false":
        step("Verify: binary_search on empty is false")
        val t = cpu_target()
        val data: [i64] = []
        expect(compute_binary_search(data, 1, less_i64, t)).to_equal(false)

    it "exclusive_scan prefixes from init":
        step("Verify: exclusive_scan prefixes from init")
        val t = cpu_target()
        val data = [1, 2, 3, 4]
        val out = compute_exclusive_scan(data, 0, add_i64, t)
        expect(out.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(out[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(out[3]).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "exclusive_scan on empty returns empty":
        step("Verify: exclusive_scan on empty returns empty")
        val t = cpu_target()
        val data: [i64] = []
        val out = compute_exclusive_scan(data, 5, add_i64, t)
        expect(out.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
