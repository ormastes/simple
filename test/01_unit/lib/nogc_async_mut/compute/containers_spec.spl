"""
## Purpose and audience
Purpose: Prove that compute containers.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @cover src/lib/nogc_async_mut/compute/containers.spl
use std.spec.*
use std.nogc_async_mut.compute.containers.{ComputeSpan, FixedArray, InplaceVector}

use std.spec.step

describe "compute containers":

    it "ComputeSpan.of views a whole array":
        step("Verify: ComputeSpan.of views a whole array")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val s = ComputeSpan.of([10, 20, 30, 40])
        expect(s.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(s.get(0)).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(s.get(2)).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(s.first()).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(s.last()).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(s.is_empty()).to_be(false)

    it "ComputeSpan.slice respects start offset":
        step("Verify: ComputeSpan.slice respects start offset")
        val s = ComputeSpan.slice([10, 20, 30, 40, 50], 1, 3)
        expect(s.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(s.get(0)).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(s.last()).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "empty ComputeSpan reports is_empty":
        step("Verify: empty ComputeSpan reports is_empty")
        val empty: [i64] = []
        val s = ComputeSpan.of(empty)
        expect(s.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(s.is_empty()).to_be(true)

    it "FixedArray.filled creates n copies":
        step("Verify: FixedArray.filled creates n copies")
        var a = FixedArray.filled(7, 4)
        expect(a.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(a.get(0)).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(a.get(3)).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "FixedArray.set mutates a slot":
        step("Verify: FixedArray.set mutates a slot")
        var a = FixedArray.filled(0, 3)
        a.set(1, 99)
        expect(a.get(1)).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(a.get(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "InplaceVector pushes up to capacity":
        step("Verify: InplaceVector pushes up to capacity")
        var v = InplaceVector.with_cap(0, 3)
        expect(v.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val a = v.push(10)
        val b = v.push(20)
        expect(a).to_be(true)
        expect(b).to_be(true)
        expect(v.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(v.get(0)).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(v.get(1)).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "InplaceVector push fails when full":
        step("Verify: InplaceVector push fails when full")
        var v = InplaceVector.with_cap(0, 2)
        val a = v.push(1)
        val b = v.push(2)
        val c = v.push(3)
        expect(a).to_be(true)
        expect(b).to_be(true)
        expect(c).to_be(false)
        expect(v.is_full()).to_be(true)
        expect(v.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "InplaceVector clear resets count":
        step("Verify: InplaceVector clear resets count")
        var v = InplaceVector.with_cap(0, 3)
        val _a = v.push(5)
        v.clear()
        expect(v.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(v.is_full()).to_be(false)
