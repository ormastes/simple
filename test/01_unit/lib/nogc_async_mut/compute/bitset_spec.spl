"""
## Purpose and audience
Purpose: Prove that Bitset (libcu++ <bitset> parity).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @cover src/lib/nogc_async_mut/compute/bitset.spl
use std.spec.*
use std.nogc_async_mut.compute.bitset.{Bitset}

use std.spec.step

describe "Bitset (libcu++ <bitset> parity)":

    it "zeros starts empty with the requested size":
        step("Verify: zeros starts empty with the requested size")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val b = Bitset.zeros(100)
        expect(b.size()).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(b.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(b.none()).to_be(true)
        expect(b.any()).to_be(false)

    it "set/test a single bit":
        step("Verify: set/test a single bit")
        var b = Bitset.zeros(10)
        b.set(3)
        expect(b.test(3)).to_be(true)
        expect(b.test(2)).to_be(false)
        expect(b.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(b.any()).to_be(true)

    it "set spans multiple words (>64 bits)":
        step("Verify: set spans multiple words (>64 bits)")
        var b = Bitset.zeros(130)
        b.set(0)
        b.set(63)
        b.set(64)
        b.set(129)
        expect(b.test(0)).to_be(true)
        expect(b.test(63)).to_be(true)
        expect(b.test(64)).to_be(true)
        expect(b.test(129)).to_be(true)
        expect(b.test(65)).to_be(false)
        expect(b.count()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "bit 63 (sign bit) is handled correctly":
        step("Verify: bit 63 (sign bit) is handled correctly")
        var b = Bitset.zeros(64)
        b.set(63)
        expect(b.test(63)).to_be(true)
        expect(b.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "clear_bit removes a set bit":
        step("Verify: clear_bit removes a set bit")
        var b = Bitset.zeros(10)
        b.set(5)
        b.set(7)
        b.clear_bit(5)
        expect(b.test(5)).to_be(false)
        expect(b.test(7)).to_be(true)
        expect(b.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "clear_bit on an unset bit is a no-op":
        step("Verify: clear_bit on an unset bit is a no-op")
        var b = Bitset.zeros(10)
        b.set(2)
        b.clear_bit(4)
        expect(b.test(2)).to_be(true)
        expect(b.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "flip toggles a bit both ways":
        step("Verify: flip toggles a bit both ways")
        var b = Bitset.zeros(10)
        b.flip(6)
        expect(b.test(6)).to_be(true)
        b.flip(6)
        expect(b.test(6)).to_be(false)

    it "set_to sets and clears by flag":
        step("Verify: set_to sets and clears by flag")
        var b = Bitset.zeros(10)
        b.set_to(1, true)
        b.set_to(2, true)
        b.set_to(1, false)
        expect(b.test(1)).to_be(false)
        expect(b.test(2)).to_be(true)

    it "all() is true only when every bit is set":
        step("Verify: all() is true only when every bit is set")
        var b = Bitset.zeros(3)
        b.set(0)
        b.set(1)
        expect(b.all()).to_be(false)
        b.set(2)
        expect(b.all()).to_be(true)
        expect(b.count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
