extern fn rt_file_read_text(path: text) -> text

fn mimalloc_page_source() -> text:
    rt_file_read_text("src/lib/nogc_async_mut/mimalloc_page.spl") ?? ""

describe "mimalloc page free-list storage":
    it "pops the appended tail without copying remaining blocks":
        val src = mimalloc_page_source()
        expect(src.contains("val last = page.free.len() - 1")).to_equal(true)
        expect(src.contains("val new_free = page.free[0:last]")).to_equal(true)
        expect(src.contains("page.free[1:]")).to_equal(false)
