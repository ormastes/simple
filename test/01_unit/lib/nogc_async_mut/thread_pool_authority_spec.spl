extern fn rt_file_read_text(path: text) -> text

fn thread_pool_source() -> text:
    rt_file_read_text("src/lib/nogc_async_mut/thread_pool.spl") ?? ""

describe "ThreadPool pool-id authority":
    it "fails closed instead of falling back to another pool":
        val src = thread_pool_source()
        expect(src.contains("fn get_pool(pool_id: i64) -> ThreadPool?")).to_equal(true)
        expect(src.contains("Some(GLOBAL_POOLS[pool_id])")).to_equal(true)
        expect(src.contains("GLOBAL_POOLS[0]")).to_equal(false)
        # The nil arm (top-level `nil:`, 8-space indent) carries the
        # fail-closed rationale comment before the bare `return`.
        expect(src.contains("nil:\n            # Spawned with stale/forged pool identity: exit without touching\n            # any other pool's queue or task state.\n            return")).to_equal(true)
