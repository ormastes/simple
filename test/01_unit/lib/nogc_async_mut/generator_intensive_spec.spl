# ─── LifecycleGenerator ────────────────────────────────────────
#
# Exposes its own `state: GeneratorState` field so tests can observe the
# real product's four-state cycle directly (Created -> Running -> Suspended
# -> ... -> Completed), rather than inferring state only through the
# yielded value the way the other generators above do.

class LifecycleGenerator:
    state: GeneratorState
    values: [i64]
    idx: i64

    static fn new(values: [i64]) -> LifecycleGenerator:
        return LifecycleGenerator(state: GeneratorState.Created, values: values, idx: 0)

    me next() -> GeneratorState:
        if val GeneratorState.Completed = self.state:
            return self.state
        self.state = GeneratorState.Running
        if self.idx >= self.values.len():
            self.state = GeneratorState.Completed
            return self.state
        var v = self.values[self.idx]
        self.idx = self.idx + 1
        self.state = GeneratorState.Suspended(next_value: v, env: self.idx)
        return self.state

    fn current_state() -> GeneratorState:
        return self.state

describe "Generator Lifecycle (real GeneratorState state machine)":

    it "starts in the Created state before any next() call":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: starts in the Created state before any next() call")
        var lg = LifecycleGenerator.new([10, 20])
        expect(lg.current_state().is_created()).to_equal(true)

    it "moves Created -> Suspended on the first next(), carrying next_value and env":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: moves Created -> Suspended on the first next(), carrying next_value and env")
        var lg = LifecycleGenerator.new([10, 20])
        var state = lg.next()
        expect(state.is_suspended()).to_equal(true)
        expect(state.get_next_value()).to_equal(10)  # oracle: expected value pinned by spec
        expect(state.get_env()).to_equal(1)  # oracle: expected value pinned by spec
        expect(lg.current_state().is_suspended()).to_equal(true)

    it "moves Suspended -> Suspended across repeated resumes, env advancing each time":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: moves Suspended -> Suspended across repeated resumes, env advancing each time")
        var lg = LifecycleGenerator.new([10, 20, 30])
        var s1 = lg.next()
        var s2 = lg.next()
        var s3 = lg.next()
        expect(s1.get_next_value()).to_equal(10)  # oracle: expected value pinned by spec
        expect(s1.get_env()).to_equal(1)  # oracle: expected value pinned by spec
        expect(s2.get_next_value()).to_equal(20)  # oracle: expected value pinned by spec
        expect(s2.get_env()).to_equal(2)  # oracle: expected value pinned by spec
        expect(s3.get_next_value()).to_equal(30)  # oracle: expected value pinned by spec
        expect(s3.get_env()).to_equal(3)  # oracle: expected value pinned by spec

    it "moves Suspended -> Completed once all values are exhausted":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: moves Suspended -> Completed once all values are exhausted")
        var lg = LifecycleGenerator.new([1])
        var s1 = lg.next()
        var s2 = lg.next()
        expect(s1.is_suspended()).to_equal(true)  # oracle: expected value pinned by spec
        expect(s2.is_completed()).to_equal(true)  # oracle: expected value pinned by spec
        expect(lg.current_state().is_completed()).to_equal(true)

    it "stays Completed on further next() calls, never re-entering Created":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: stays Completed on further next() calls, never re-entering Created")
        var lg = LifecycleGenerator.new([])
        var s1 = lg.next()
        var s2 = lg.next()
        var s3 = lg.next()
        expect(s1.is_completed()).to_equal(true)  # oracle: expected value pinned by spec
        expect(s2.is_completed()).to_equal(true)  # oracle: expected value pinned by spec
        expect(s3.is_completed()).to_equal(true)  # oracle: expected value pinned by spec
