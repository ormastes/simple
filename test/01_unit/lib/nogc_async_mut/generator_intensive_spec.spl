describe "GeneratorState":

    it "Suspended state has a next_value and env payload":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: Suspended state has a next_value and env payload")
        var state = GeneratorState.Suspended(next_value: 10, env: 3)
        expect(state.is_suspended()).to_equal(true)
        expect(state.get_next_value()).to_equal(10)  # oracle: expected value pinned by spec
        expect(state.get_env()).to_equal(3)  # oracle: expected value pinned by spec

    it "Completed state has no value":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: Completed state has no value")
        var state = GeneratorState.Completed
        expect(state.is_completed()).to_equal(true)
        expect(state.get_next_value()).to_equal(0)  # oracle: expected value pinned by spec

    it "is_suspended returns false for Completed":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: is_suspended returns false for Completed")
        var state = GeneratorState.Completed
        expect(state.is_suspended()).to_equal(false)

    it "is_completed returns false for Suspended":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: is_completed returns false for Suspended")
        var state = GeneratorState.Suspended(next_value: 5, env: 0)
        expect(state.is_completed()).to_equal(false)

    it "Created state reports is_created and nothing else":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: Created state reports is_created and nothing else")
        var state = GeneratorState.Created
        expect(state.is_created()).to_equal(true)
        expect(state.is_running()).to_equal(false)
        expect(state.is_suspended()).to_equal(false)
        expect(state.is_completed()).to_equal(false)

    it "Running state reports is_running and nothing else":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: Running state reports is_running and nothing else")
        var state = GeneratorState.Running
        expect(state.is_running()).to_equal(true)
        expect(state.is_created()).to_equal(false)
        expect(state.is_suspended()).to_equal(false)
        expect(state.is_completed()).to_equal(false)

