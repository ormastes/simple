"""
# Generator Intensive Tests

**Feature IDs:** #RT-020
**Category:** Runtime
**Difficulty:** 2/5
**Status:** In Progress
**Requirements:** doc/requirement/async_promise_intensive_tests.md

## Overview
Intensive tests for generator patterns: yield/next iteration, stateful generators,
finite and infinite (bounded) generators, and GeneratorState transitions.
"""
# @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001

# ─── GeneratorState ───────────────────────────────────────────
#
# Mirrors the REAL product `GeneratorState` in
# src/app/interpreter/async_runtime/generators.spl:10 (`Created`, `Running`,
# `Suspended(next_value, env)`, `Completed`) rather than the old shadow enum
# (`Yielded`/`Completed` only). The real module cannot be imported directly:
# even after fixing its `gen` reserved-keyword parameter name, it still fails
# to parse (struct-style enum-variant construction, `&T`/`Box<T>` reference
# syntax) under the current grammar — see
# doc/08_tracking/bug/generator_async_runtime_module_fails_to_parse_2026-08-10.md.
# `env` is therefore mirrored here as a placeholder `i64` token (the resume
# counter) rather than the real `Environment` struct.

enum GeneratorState:
    Created
    Suspended(next_value: i64, env: i64)
    Running
    Completed

impl GeneratorState:
    fn is_created() -> bool:
        if val GeneratorState.Created = self:
            return true
        return false

    fn is_suspended() -> bool:
        if val GeneratorState.Suspended(_, _) = self:
            return true
        return false

    fn is_running() -> bool:
        if val GeneratorState.Running = self:
            return true
        return false

    fn is_completed() -> bool:
        if val GeneratorState.Completed = self:
            return true
        return false

    fn get_next_value() -> i64:
        if val GeneratorState.Suspended(v, _e) = self:
            return v
        return 0

    fn get_env() -> i64:
        if val GeneratorState.Suspended(_v, e) = self:
            return e
        return -1

# ─── CountingGenerator ───────────────────────────────────────

class CountingGenerator:
    current: i64
    limit: i64
    done: bool

    static fn new(start: i64, limit: i64) -> CountingGenerator:
        return CountingGenerator(current: start, limit: limit, done: false)

    me next() -> GeneratorState:
        if self.done:
            return GeneratorState.Completed
        self.current = self.current + 1
        if self.current >= self.limit:
            self.done = true
        return GeneratorState.Suspended(next_value: self.current, env: 0)

    fn is_complete() -> bool:
        return self.done

fn collect_counting(cg: CountingGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not cg.is_complete():
        var state = cg.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── Fibonacci Generator ─────────────────────────────────────

class FibGenerator:
    prev: i64
    curr: i64
    remaining: i64

    static fn new(count: i64) -> FibGenerator:
        return FibGenerator(prev: 0, curr: 1, remaining: count)

    me next() -> GeneratorState:
        if self.remaining <= 0:
            return GeneratorState.Completed
        var value = self.curr
        var next_curr = self.prev + self.curr
        self.prev = self.curr
        self.curr = next_curr
        self.remaining = self.remaining - 1
        return GeneratorState.Suspended(next_value: value, env: 0)

    fn is_complete() -> bool:
        return self.remaining <= 0

fn collect_fib(fg: FibGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not fg.is_complete():
        var state = fg.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── RangeGenerator ──────────────────────────────────────────

class RangeGenerator:
    current: i64
    end_val: i64
    done: bool

    static fn new(start: i64, end_val: i64) -> RangeGenerator:
        return RangeGenerator(current: start - 1, end_val: end_val, done: false)

    me next() -> GeneratorState:
        if self.done:
            return GeneratorState.Completed
        self.current = self.current + 1
        if self.current >= self.end_val - 1:
            self.done = true
        return GeneratorState.Suspended(next_value: self.current, env: 0)

    fn is_complete() -> bool:
        return self.done

fn collect_range(rg: RangeGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not rg.is_complete():
        var state = rg.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── SingleValueGenerator ────────────────────────────────────

class SingleValueGenerator:
    val_data: i64
    done: bool

    static fn new(value: i64) -> SingleValueGenerator:
        return SingleValueGenerator(val_data: value, done: false)

    me next() -> GeneratorState:
        if self.done:
            return GeneratorState.Completed
        self.done = true
        return GeneratorState.Suspended(next_value: self.val_data, env: 0)

    fn is_complete() -> bool:
        return self.done

fn collect_single(sg: SingleValueGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not sg.is_complete():
        var state = sg.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── EmptyGenerator ──────────────────────────────────────────

class EmptyGenerator:
    done: bool

    static fn new() -> EmptyGenerator:
        return EmptyGenerator(done: true)

    fn next() -> GeneratorState:
        return GeneratorState.Completed

    fn is_complete() -> bool:
        return true

# ─── StepGenerator ───────────────────────────────────────────

class StepGenerator:
    current: i64
    step: i64
    limit: i64
    done: bool

    static fn new(start: i64, step: i64, limit: i64) -> StepGenerator:
        return StepGenerator(current: start, step: step, limit: limit, done: false)

    me next() -> GeneratorState:
        if self.done:
            return GeneratorState.Completed
        self.current = self.current + self.step
        if self.current >= self.limit:
            self.done = true
        return GeneratorState.Suspended(next_value: self.current, env: 0)

    fn is_complete() -> bool:
        return self.done

fn collect_step(sg: StepGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not sg.is_complete():
        var state = sg.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── DoublingGenerator (replaces TransformGenerator) ─────────

class DoublingGenerator:
    source: CountingGenerator

    static fn new(source: CountingGenerator) -> DoublingGenerator:
        return DoublingGenerator(source: source)

    me next() -> GeneratorState:
        var state = self.source.next()
        if val GeneratorState.Suspended(v, _e) = state:
            return GeneratorState.Suspended(next_value: v * 2, env: 0)
        return GeneratorState.Completed

    fn is_complete() -> bool:
        return self.source.is_complete()

fn collect_doubling(dg: DoublingGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not dg.is_complete():
        var state = dg.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── IdentityGenerator (identity transform) ──────────────────

class IdentityGenerator:
    source: CountingGenerator

    static fn new(source: CountingGenerator) -> IdentityGenerator:
        return IdentityGenerator(source: source)

    me next() -> GeneratorState:
        var state = self.source.next()
        if val GeneratorState.Suspended(v, _e) = state:
            return GeneratorState.Suspended(next_value: v, env: 0)
        return GeneratorState.Completed

    fn is_complete() -> bool:
        return self.source.is_complete()

fn collect_identity(ig: IdentityGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not ig.is_complete():
        var state = ig.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── EvenFilterGenerator (replaces FilterGenerator) ──────────

class EvenFilterGenerator:
    source: CountingGenerator

    static fn new(source: CountingGenerator) -> EvenFilterGenerator:
        return EvenFilterGenerator(source: source)

    me next() -> GeneratorState:
        while not self.source.is_complete():
            var state = self.source.next()
            if val GeneratorState.Suspended(v, _e) = state:
                if v % 2 == 0:
                    return GeneratorState.Suspended(next_value: v, env: 0)
        return GeneratorState.Completed

    fn is_complete() -> bool:
        return self.source.is_complete()

fn collect_even_filter(ef: EvenFilterGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not ef.is_complete():
        var state = ef.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ─── PassAllFilterGenerator (keeps all values) ───────────────

class PassAllFilterGenerator:
    source: CountingGenerator

    static fn new(source: CountingGenerator) -> PassAllFilterGenerator:
        return PassAllFilterGenerator(source: source)

    me next() -> GeneratorState:
        var state = self.source.next()
        if val GeneratorState.Suspended(v, _e) = state:
            return GeneratorState.Suspended(next_value: v, env: 0)
        return GeneratorState.Completed

    fn is_complete() -> bool:
        return self.source.is_complete()

fn collect_pass_all(pf: PassAllFilterGenerator, max_items: i64) -> [i64]:
    var results: [i64] = []
    var count = 0
    while count < max_items and not pf.is_complete():
        var state = pf.next()
        if val GeneratorState.Suspended(v, _e) = state:
            results = results + [v]
        count = count + 1
    return results

# ===========================================================================
# Tests
# ===========================================================================

use std.spec.step
describe "Generator Creation":

    it "creates a generator with initial state":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: creates a generator with initial state")
        var g =CountingGenerator.new(0, 5)
        expect(g.is_complete()).to_equal(false)
        expect(g.done).to_equal(false)

    it "new generator has correct initial current value":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: new generator has correct initial current value")
        var g =CountingGenerator.new(42, 100)
        expect(g.current).to_equal(42)  # oracle: expected value pinned by spec
        expect(g.done).to_equal(false)

describe "Generator Next":

    it "first next yields a value":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: first next yields a value")
        var g =CountingGenerator.new(0, 5)
        var state = g.next()
        expect(state.is_suspended()).to_equal(true)
        expect(state.get_next_value()).to_equal(1)  # oracle: expected value pinned by spec

    it "subsequent nexts yield incremented values":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: subsequent nexts yield incremented values")
        var g =CountingGenerator.new(0, 10)
        var s1 = g.next()
        var s2 = g.next()
        var s3 = g.next()
        expect(s1.get_next_value()).to_equal(1)  # oracle: expected value pinned by spec
        expect(s2.get_next_value()).to_equal(2)  # oracle: expected value pinned by spec
        expect(s3.get_next_value()).to_equal(3)  # oracle: expected value pinned by spec

describe "Counting Generator":

    it "counts from 1 up to N then completes":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: counts from 1 up to N then completes")
        var g =CountingGenerator.new(0, 4)
        var vals = collect_counting(g, 100)
        expect(vals.len()).to_equal(4)  # oracle: expected value pinned by spec
        expect(vals[0]).to_equal(1)  # oracle: expected value pinned by spec
        expect(vals[1]).to_equal(2)  # oracle: expected value pinned by spec
        expect(vals[2]).to_equal(3)  # oracle: expected value pinned by spec
        expect(vals[3]).to_equal(4)  # oracle: expected value pinned by spec

    it "is_complete returns true after exhaustion":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: is_complete returns true after exhaustion")
        var g =CountingGenerator.new(0, 2)
        var v1 = g.next()
        var v2 = g.next()
        expect(g.is_complete()).to_equal(true)

describe "Fibonacci Generator":

    it "yields fibonacci sequence":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: yields fibonacci sequence")
        var fib = FibGenerator.new(7)
        var vals = collect_fib(fib, 100)
        expect(vals.len()).to_equal(7)  # oracle: expected value pinned by spec
        expect(vals[0]).to_equal(1)  # oracle: expected value pinned by spec
        expect(vals[1]).to_equal(1)  # oracle: expected value pinned by spec
        expect(vals[2]).to_equal(2)  # oracle: expected value pinned by spec
        expect(vals[3]).to_equal(3)  # oracle: expected value pinned by spec
        expect(vals[4]).to_equal(5)  # oracle: expected value pinned by spec
        expect(vals[5]).to_equal(8)  # oracle: expected value pinned by spec
        expect(vals[6]).to_equal(13)  # oracle: expected value pinned by spec

    it "fibonacci generator completes after requested count":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: fibonacci generator completes after requested count")
        var fib = FibGenerator.new(3)
        var v1 = fib.next()
        var v2 = fib.next()
        var v3 = fib.next()
        expect(fib.is_complete()).to_equal(true)
        var v4 = fib.next()
        expect(v4.is_completed()).to_equal(true)  # oracle: expected value pinned by spec

