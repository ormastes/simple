describe "Generator After Completion":

    it "next after complete returns Completed":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: next after complete returns Completed")
        var g =SingleValueGenerator.new(7)
        var s1 = g.next()
        var s2 = g.next()
        var s3 = g.next()
        expect(s1.is_suspended()).to_equal(true)  # oracle: expected value pinned by spec
        expect(s2.is_completed()).to_equal(true)  # oracle: expected value pinned by spec
        expect(s3.is_completed()).to_equal(true)  # oracle: expected value pinned by spec

    it "calling next many times after completion is safe":
        # @req: REQ-LIB-NOGC_ASYNC_MUT_GENERATOR_INTEN-001
        step("Verify: calling next many times after completion is safe")
        var g =EmptyGenerator.new()
        var i = 0
        while i < 20:
            var state = g.next()
            expect(state.is_completed()).to_equal(true)
            i = i + 1
        expect(g.is_complete()).to_equal(true)

