# # `std.net.tcp` Live-Path Specification
#
# **Feature IDs:** #NET-TCP-FACADE
# **Category:** Stdlib
# **Difficulty:** 3/5
# **Status:** Implemented
#
# ## Why this spec exists
#
# `std.net.tcp` used to be implemented on top of the `tcp_listener_*` /
# `tcp_stream_*` externs declared in `src/lib/nogc_async_mut/net/sffi.spl`. None
# of those names is registered in
# `src/compiler_rust/common/src/runtime_symbols.rs`, and an unregistered
# `@extern` returns **nil silently** under the JIT — so every call through
# `std.net.tcp` failed with no error and no diagnostic. `std.net.*` resolves to
# the `nogc_async_mut` tier first from every tier, so this was repo-wide.
#
# `net/tcp.spl` is now a facade over `std.nogc_sync_mut.io.tcp`, which is
# fd-based over the registered `rt_io_tcp_*` family.
#
# ## What makes this check POSITIVE (not exit-status theatre)
#
# Verification by exit status is fail-open here: an unresolved `use` is only a
# WARN and still exits 0, so "it still compiles" proves nothing. This spec
# instead asserts on **observable bytes crossing a real kernel socket**:
#
# - it imports from `std.net.tcp` (the facade), NOT from
#   `std.nogc_sync_mut.io.tcp` — so it fails if the facade stops resolving to a
#   live implementation;
# - it binds an ephemeral port and asserts the kernel-assigned `local_addr`;
# - it asserts a byte-exact round trip in BOTH directions.
#
# Under the old dead externs every one of these calls returned nil, so the
# payload assertions could not pass. That is the sabotage argument: the check
# goes red on the defect it was written for.
#
# Contrast: `test/01_unit/lib/nogc_async_mut/io/async_tcp_spec.spl` reports
# `14 passed` but every one of its 14 example bodies is the literal `0` with the
# socket code commented out — it opens no socket and asserts nothing.
#
# ## Syntax
#
# ```simple
# val listener = TcpListener.bind("127.0.0.1:0")?
# val stream = TcpStream.connect(listener.local_addr()?)?
# ```
#
# ## Behavior
#
# - Single-threaded: the client connects BEFORE accept; the OS queues the
#   handshake in the listen backlog, so one thread can drive both ends.
# - `local_addr()` on a `:0` bind reports the kernel-assigned ephemeral port.
# - Payloads are compared byte-exactly, not by length or substring.

use std.spec
use std.net.tcp.{TcpListener, TcpStream}

describe "std.net.tcp facade reaches the live socket path":

    it "binds an ephemeral loopback port and reports the kernel-assigned address":
        val bind_result = TcpListener.bind("127.0.0.1:0")
        var listener = match bind_result:
            Err(e): panic("bind failed: {e.message}")
            Ok(l): l

        val addr_result = listener.local_addr()
        val addr = match addr_result:
            Err(e): panic("local_addr failed: {e.message}")
            Ok(a): a

        # A silent-nil extern could not produce a real loopback address.
        expect(addr.contains("127.0.0.1")).to_equal(true)
        # ":0" means "pick a port"; the kernel must have replaced it.
        expect(addr.contains(":0")).to_equal(false)

        val _ = listener.close()

    it "moves bytes client-to-server byte-exactly":
        val bind_result = TcpListener.bind("127.0.0.1:0")
        var listener = match bind_result:
            Err(e): panic("bind failed: {e.message}")
            Ok(l): l
        val addr = match listener.local_addr():
            Err(e): panic("local_addr failed: {e.message}")
            Ok(a): a

        # Connect before accept — the OS queues it in the backlog.
        var client = match TcpStream.connect(addr):
            Err(e): panic("connect failed: {e.message}")
            Ok(c): c

        # ASCII "Hello"
        val payload: [u8] = [72, 101, 108, 108, 111]
        match client.write_all(payload):
            Err(e): panic("client write_all failed: {e.message}")
            Ok(_): pass
        val _ = client.flush()

        var server = match listener.accept():
            Err(e): panic("accept failed: {e.message}")
            Ok(s): s

        val got = match server.read_exact(5):
            Err(e): panic("server read_exact failed: {e.message}")
            Ok(d): d

        # Absolute oracle: byte-exact, not a length or substring check.
        expect(got).to_equal(payload)

        val _ = server.close()
        val _ = client.close()
        val _ = listener.close()

    it "moves bytes server-to-client byte-exactly":
        val bind_result = TcpListener.bind("127.0.0.1:0")
        var listener = match bind_result:
            Err(e): panic("bind failed: {e.message}")
            Ok(l): l
        val addr = match listener.local_addr():
            Err(e): panic("local_addr failed: {e.message}")
            Ok(a): a

        var client = match TcpStream.connect(addr):
            Err(e): panic("connect failed: {e.message}")
            Ok(c): c

        var server = match listener.accept():
            Err(e): panic("accept failed: {e.message}")
            Ok(s): s

        # ASCII "PONG!"
        val reply: [u8] = [80, 79, 78, 71, 33]
        match server.write_all(reply):
            Err(e): panic("server write_all failed: {e.message}")
            Ok(_): pass
        val _ = server.flush()

        val got = match client.read_exact(5):
            Err(e): panic("client read_exact failed: {e.message}")
            Ok(d): d

        expect(got).to_equal(reply)

        val _ = server.close()
        val _ = client.close()
        val _ = listener.close()

    it "reports the same peer port on both ends of one connection":
        val bind_result = TcpListener.bind("127.0.0.1:0")
        var listener = match bind_result:
            Err(e): panic("bind failed: {e.message}")
            Ok(l): l
        val addr = match listener.local_addr():
            Err(e): panic("local_addr failed: {e.message}")
            Ok(a): a

        var client = match TcpStream.connect(addr):
            Err(e): panic("connect failed: {e.message}")
            Ok(c): c
        var server = match listener.accept():
            Err(e): panic("accept failed: {e.message}")
            Ok(s): s

        # The kernel — not Simple — brokered this pair, so the client's local
        # address must equal the server's view of its peer.
        val client_local = match client.local_addr():
            Err(e): panic("client local_addr failed: {e.message}")
            Ok(a): a
        val server_peer = match server.peer_addr():
            Err(e): panic("server peer_addr failed: {e.message}")
            Ok(a): a

        expect(server_peer).to_equal(client_local)

        val _ = server.close()
        val _ = client.close()
        val _ = listener.close()
