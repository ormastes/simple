# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# @req REQ-2D-001
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.*
use std.skia.entity.geometry.{SkRect, sk_rect_make_xywh}
use std.skia.entity.paint.{SkPaint, sk_paint_new, sk_paint_fill, sk_paint_stroke}
use std.skia.entity.color.{sk_color_argb}
use std.skia.entity.enums.{SkPaintStyle, SkBlendMode, SkColorType, SkAlphaType}
use std.skia.entity.picture.{SkPicture, SkPictureOp, SkPictureOpKind, sk_picture_recorder_new, sk_picture_op_draw_rect, sk_picture_op_draw_rrect, sk_picture_op_draw_paint, sk_picture_op_draw_path, sk_picture_op_draw_image}
use std.skia.entity.image.{sk_image_info_n32_premul, sk_image_info_make, sk_image_make}
use std.skia.entity.path.{sk_path_new}
use std.skia.bridge.engine2d_bridge.{sk_image_to_u32_pixels, skia_picture_engine2d_preflight, skia_render_picture_on_engine2d, skia_render_picture_on_engine2d_reported, skia_render_picture_on_engine2d_strict}


# Record a real skia SkPicture via SkPictureRecorder: an opaque background rect
# covering the whole canvas, then a smaller opaque foreground rect at known
# coords. Replaying through the bridge must paint these pixels via the shared
# Engine2D backend lane.
#
# NB: we record through SkPictureRecorder rather than SkCanvas chaining because
# SkCanvas.draw_rect rebinds (copies) its recorder, dropping recorded ops, and
# SkCanvas.clear() discards its color arg. The recorder path is the genuine
# SkPicture op-recording API.
fn _record_two_rects(w: i32, h: i32, bg: i64, fg: i64) -> SkPicture:
    val full = SkRect(left: 0.0, top: 0.0, right: w.to_f64(), bottom: h.to_f64())
    val rec = sk_picture_recorder_new().begin_recording(full)
    val bg_paint = sk_paint_fill(bg)
    rec.record(sk_picture_op_draw_rect(full, bg_paint.with_anti_alias(false)))
    # Foreground 8x6 rect at (4,3) — interior pixel (8,5) is inside.
    val fg_rect = sk_rect_make_xywh(4.0, 3.0, 8.0, 6.0)
    val fg_paint = sk_paint_fill(fg)
    rec.record(sk_picture_op_draw_rect(fg_rect, fg_paint.with_anti_alias(false)))
    rec.finish_recording()

# Background fill via DrawPaint (whole-canvas) followed by a stroked rect
# outline. Both were previously counted as skipped.
fn _record_paint_and_stroked_rect(w: i32, h: i32, bg: i64, line: i64) -> SkPicture:
    val full = SkRect(left: 0.0, top: 0.0, right: w.to_f64(), bottom: h.to_f64())
    val rec = sk_picture_recorder_new().begin_recording(full)
    rec.record(sk_picture_op_draw_paint(sk_paint_fill(bg)))
    # 10x8 outline at (4,3): edge pixel (4,3) is on the border, (8,6) is interior.
    val stroke_paint = sk_paint_stroke(line, 1.0)
    rec.record(sk_picture_op_draw_rect(sk_rect_make_xywh(4.0, 3.0, 10.0, 8.0), stroke_paint.with_anti_alias(false)))
    rec.finish_recording()

# Background fill, then a filled rounded rect.
fn _record_rrect(w: i32, h: i32, bg: i64, fg: i64) -> SkPicture:
    val full = SkRect(left: 0.0, top: 0.0, right: w.to_f64(), bottom: h.to_f64())
    val rec = sk_picture_recorder_new().begin_recording(full)
    rec.record(sk_picture_op_draw_rect(full, sk_paint_fill(bg)))
    rec.record(sk_picture_op_draw_rrect(sk_rect_make_xywh(4.0, 3.0, 12.0, 10.0), 3.0, 3.0, sk_paint_fill(fg)))
    rec.finish_recording()

# Background fill, then a filled oval. DrawOval is what SkCanvas.draw_oval and
# SkCanvas.draw_circle record.
fn _record_oval(w: i32, h: i32, bg: i64, fg: i64) -> SkPicture:
    val full = SkRect(left: 0.0, top: 0.0, right: w.to_f64(), bottom: h.to_f64())
    val rec = sk_picture_recorder_new().begin_recording(full)
    rec.record(sk_picture_op_draw_rect(full, sk_paint_fill(bg)))
    val oval = sk_rect_make_xywh(4.0, 2.0, 12.0, 10.0)
    rec.record(SkPictureOp(
        kind: SkPictureOpKind.DrawOval, rect: oval, rx: 0.0, ry: 0.0,
        path: None, image: None, paint: sk_paint_fill(fg), x: 0.0, y: 0.0
    ))
    rec.finish_recording()

# A DrawPath op, which still has no Engine2D primitive: it must stay COUNTED,
# never silently dropped.
fn _record_path(w: i32, h: i32, bg: i64) -> SkPicture:
    val full = SkRect(left: 0.0, top: 0.0, right: w.to_f64(), bottom: h.to_f64())
    val rec = sk_picture_recorder_new().begin_recording(full)
    rec.record(sk_picture_op_draw_rect(full, sk_paint_fill(bg)))
    rec.record(sk_picture_op_draw_path(sk_path_new().move_to(1.0, 1.0).line_to(5.0, 5.0), sk_paint_fill(bg)))
    rec.finish_recording()

describe "SkiaEngine2DBridge":
    # @manual scenario evidence

    it "replays skia rect ops onto the shared Engine2D cpu_simd backend lane":
        # @req REQ-SSPEC-LIB
        step("replays skia rect ops onto the shared Engine2D cpu_simd backend lane")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x12, 0x34, 0x56)   # 0xFF123456
        val fg = sk_color_argb(255, 0xEF, 0x44, 0x44)   # 0xFFEF4444
        val pic = _record_two_rects(w, h, bg, fg)
        match skia_render_picture_on_engine2d(pic, w, h, "cpu_simd"):
            Ok(pixels):
                expect(pixels.len()).to_equal(w * h)
                expect(pixels[8 + 5 * w]).to_equal(0xFFEF4444u32)
                expect(pixels[20 + 14 * w]).to_equal(0xFF123456u32)
            Err(_): assert(false)

    it "replays the same picture on the software backend lane":
        # @req REQ-SSPEC-LIB
        step("replays the same picture on the software backend lane")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x12, 0x34, 0x56)
        val fg = sk_color_argb(255, 0xEF, 0x44, 0x44)
        val pic = _record_two_rects(w, h, bg, fg)
        match skia_render_picture_on_engine2d(pic, w, h, "software"):
            Ok(pixels):
                expect(pixels.len()).to_equal(w * h)
                expect(pixels[8 + 5 * w]).to_equal(0xFFEF4444u32)
                expect(pixels[20 + 14 * w]).to_equal(0xFF123456u32)
            Err(_): assert(false)

    it "reports both fill rects as mapped with nothing skipped":
        # @req REQ-SSPEC-LIB
        step("reports both fill rects as mapped with nothing skipped")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x12, 0x34, 0x56)
        val fg = sk_color_argb(255, 0xEF, 0x44, 0x44)
        val pic = _record_two_rects(w, h, bg, fg)
        val result = skia_render_picture_on_engine2d_reported(pic, w, h, "cpu_simd")

        expect(result.report.mapped_rects).to_equal(2)
        expect(result.report.skipped).to_equal(0)
        expect(result.report.complete).to_equal(true)
        expect(result.report.readback_source).to_equal("cpu_mirror")

    it "maps DrawPaint to a whole-canvas fill and a stroked rect to an outline":
        # @req REQ-SSPEC-LIB
        step("maps DrawPaint to a whole-canvas fill and a stroked rect to an outline")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x11, 0x22, 0x33)
        val line = sk_color_argb(255, 0x00, 0xFF, 0x00)
        val result = skia_render_picture_on_engine2d_reported(_record_paint_and_stroked_rect(w, h, bg, line), w, h, "cpu_simd")

        expect(result.pixels.len()).to_equal(w * h)
        # DrawPaint painted the whole canvas, including a corner far from the rect.
        expect(result.pixels[23 + 15 * w]).to_equal(0xFF112233u32)
        # The stroke drew the outline, not a filled block: the top-left corner of
        # the rect is the line colour, the interior is still the background.
        expect(result.pixels[4 + 3 * w]).to_equal(0xFF00FF00u32)
        expect(result.pixels[8 + 6 * w]).to_equal(0xFF112233u32)
        expect(result.report.skipped).to_equal(0)
        expect(result.report.mapped_rects).to_equal(2)
        expect(result.report.lossy).to_equal(1)
        expect(result.report.complete).to_equal(false)
        expect(result.report.reason).to_contain("paint-stroke")

    it "maps DrawRRect onto the rounded-rect primitive":
        # @req REQ-SSPEC-LIB
        step("maps DrawRRect onto the rounded-rect primitive")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x11, 0x22, 0x33)
        val fg = sk_color_argb(255, 0xAB, 0xCD, 0xEF)
        val result = skia_render_picture_on_engine2d_reported(_record_rrect(w, h, bg, fg), w, h, "cpu_simd")

        # Centre of the rounded rect is filled; the clipped corner is not.
        expect(result.pixels[10 + 8 * w]).to_equal(0xFFABCDEFu32)
        expect(result.pixels[4 + 3 * w]).to_equal(0xFF112233u32)
        expect(result.report.skipped).to_equal(0)
        expect(result.report.mapped_rects).to_equal(2)
        expect(result.report.complete).to_equal(false)
        expect(result.report.reason).to_contain("paint-anti-alias")

    it "rejects rounded corners whose coverage ignores disabled antialiasing":
        # @req REQ-SSPEC-LIB
        step("preflight a hard-edged rounded rectangle")
        val bounds = sk_rect_make_xywh(0.0, 0.0, 12.0, 10.0)
        val rec = sk_picture_recorder_new().begin_recording(bounds)
        # NOTE: the paint is passed inline, NOT via `val paint = ...`.
        # A val-bound SkPaint crossing the preflight op chain hits the seed
        # test-runner type-erasure defect ('blend_mode' on Dict); inline
        # arguments are unaffected. See
        # doc/08_tracking/bug/seed_val_bound_class_type_erasure_spec_context_2026-10-03.md
        rec.record(sk_picture_op_draw_rrect(bounds, 3.0, 3.0,
            sk_paint_fill(sk_color_argb(255, 12, 34, 56)).with_anti_alias(false)))
        val pic = rec.finish_recording()
        val report = skia_picture_engine2d_preflight(pic)
        expect(report.complete).to_equal(false)
        expect(report.reason).to_contain("rrect-coverage-anti-alias")
        match skia_render_picture_on_engine2d_strict(pic, 12, 10, "software"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("rrect-coverage-anti-alias")

    it "maps DrawOval onto the filled-ellipse primitive":
        # @req REQ-SSPEC-LIB
        step("maps DrawOval onto the filled-ellipse primitive")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x11, 0x22, 0x33)
        val fg = sk_color_argb(255, 0xFF, 0x00, 0xFF)
        val result = skia_render_picture_on_engine2d_reported(_record_oval(w, h, bg, fg), w, h, "cpu_simd")

        # Centre of the oval is filled; the bounding-box corner is outside it.
        expect(result.pixels[10 + 7 * w]).to_equal(0xFFFF00FFu32)
        expect(result.pixels[4 + 2 * w]).to_equal(0xFF112233u32)
        expect(result.report.skipped).to_equal(0)
        expect(result.report.mapped_ovals).to_equal(1)
        expect(result.report.complete).to_equal(false)

    it "still counts a DrawPath op as skipped rather than dropping it":
        # @req REQ-SSPEC-LIB
        step("still counts a DrawPath op as skipped rather than dropping it")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x11, 0x22, 0x33)
        val result = skia_render_picture_on_engine2d_reported(_record_path(w, h, bg), w, h, "cpu_simd")

        expect(result.report.mapped_rects).to_equal(1)
        expect(result.report.skipped).to_equal(1)
        expect(result.report.complete).to_equal(false)
        expect(result.report.reason).to_contain("op 0: paint-anti-alias")

    it "rejects unsupported ops before strict rendering and names their index":
        # @req REQ-SSPEC-LIB
        step("rejects unsupported ops before strict rendering and names their index")
        val w = 24
        val h = 16
        val bg = sk_color_argb(255, 0x11, 0x22, 0x33)
        val full = sk_rect_make_xywh(0.0, 0.0, w.to_f64(), h.to_f64())
        val rec = sk_picture_recorder_new().begin_recording(full)
        val bg_paint = sk_paint_fill(bg)
        rec.record(sk_picture_op_draw_rect(full, bg_paint.with_anti_alias(false)))
        rec.record(sk_picture_op_draw_path(sk_path_new().move_to(1.0, 1.0).line_to(5.0, 5.0), sk_paint_fill(bg)))
        val pic = rec.finish_recording()
        val preflight = skia_picture_engine2d_preflight(pic)
        expect(preflight.skipped).to_equal(1)
        expect(preflight.complete).to_equal(false)
        expect(preflight.reason).to_contain("op 1: unsupported-op")
        match skia_render_picture_on_engine2d_strict(pic, w, h, "software"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("op 1: unsupported-op")
        match skia_render_picture_on_engine2d(pic, w, h, "software"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("op 1: unsupported-op")

    it "rejects ignored blend and fractional geometry while preview marks loss":
        # @req REQ-SSPEC-LIB
        step("rejects ignored blend and fractional geometry while preview marks loss")
        val bounds = sk_rect_make_xywh(0.0, 0.0, 24.0, 16.0)
        val rec = sk_picture_recorder_new().begin_recording(bounds)
        val red = sk_color_argb(255, 255, 0, 0)
        val paint = sk_paint_fill(red)
        val no_aa = paint.with_anti_alias(false)
        rec.record(sk_picture_op_draw_rect(bounds, no_aa.with_blend_mode(SkBlendMode.Multiply)))
        rec.record(sk_picture_op_draw_rect(sk_rect_make_xywh(1.5, 2.0, 4.0, 3.0), no_aa))
        val pic = rec.finish_recording()
        val preflight = skia_picture_engine2d_preflight(pic)
        expect(preflight.lossy).to_equal(2)
        expect(preflight.complete).to_equal(false)
        expect(preflight.reason).to_contain("op 0: paint-blend-mode")
        val preview = skia_render_picture_on_engine2d_reported(pic, 24, 16, "software")
        expect(preview.report.lossy).to_equal(2)
        expect(preview.report.complete).to_equal(false)
        match skia_render_picture_on_engine2d_strict(pic, 24, 16, "software"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("paint-blend-mode")

    it "rejects image alpha and channel values that direct packing would lose":
        # @req REQ-SSPEC-LIB
        step("rejects image alpha and channel values that direct packing would lose")
        val bounds = sk_rect_make_xywh(0.0, 0.0, 2.0, 2.0)
        val info = sk_image_info_n32_premul(1, 1)
        val rec = sk_picture_recorder_new().begin_recording(bounds)
        rec.record(sk_picture_op_draw_image(sk_image_make(info, [128i64, 255, 0, 0]), 0.0, 0.0, sk_paint_new()))
        val translucent = rec.finish_recording()
        val alpha_report = skia_picture_engine2d_preflight(translucent)
        expect(alpha_report.complete).to_equal(false)
        expect(alpha_report.reason).to_contain("image-alpha")
        match skia_render_picture_on_engine2d_strict(translucent, 2, 2, "software"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("image-alpha")

        val rec2 = sk_picture_recorder_new().begin_recording(bounds)
        rec2.record(sk_picture_op_draw_image(sk_image_make(info, [255i64, 300, 0, 0]), 0.0, 0.0, sk_paint_new()))
        val range_report = skia_picture_engine2d_preflight(rec2.finish_recording())
        expect(range_report.complete).to_equal(false)
        expect(range_report.reason).to_contain("image-channel-range")

    it "rejects malformed and overflow sized image buffers before packing":
        # @req REQ-SSPEC-LIB
        step("rejects malformed and overflow sized image buffers before packing")
        val bounds = sk_rect_make_xywh(0.0, 0.0, 2.0, 2.0)
        val rec = sk_picture_recorder_new().begin_recording(bounds)
        rec.record(sk_picture_op_draw_image(sk_image_make(sk_image_info_n32_premul(2, 2), [255i64, 1, 2, 3]), 0.0, 0.0, sk_paint_new()))
        val malformed = rec.finish_recording()
        expect(skia_picture_engine2d_preflight(malformed).reason).to_contain("image-pixels")
        match skia_render_picture_on_engine2d_strict(malformed, 2, 2, "software"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("image-pixels")

        val huge = sk_image_info_n32_premul(2147483647, 2147483647)
        val rec2 = sk_picture_recorder_new().begin_recording(bounds)
        rec2.record(sk_picture_op_draw_image(sk_image_make(huge, []), 0.0, 0.0, sk_paint_new()))
        expect(skia_picture_engine2d_preflight(rec2.finish_recording()).reason).to_contain("image-pixels")

    it "rejects opaque metadata when image alpha is not opaque":
        # @req REQ-SSPEC-LIB
        step("rejects opaque metadata when image alpha is not opaque")
        val bounds = sk_rect_make_xywh(0.0, 0.0, 1.0, 1.0)
        val info = sk_image_info_make(1, 1, SkColorType.Rgba8888, SkAlphaType.Opaque)
        val rec = sk_picture_recorder_new().begin_recording(bounds)
        rec.record(sk_picture_op_draw_image(sk_image_make(info, [128i64, 20, 30, 40]), 0.0, 0.0, sk_paint_new()))
        expect(skia_picture_engine2d_preflight(rec.finish_recording()).reason).to_contain("image-alpha")

    it "rejects a backend fallback after otherwise exact drawing":
        # @req REQ-SSPEC-LIB
        step("rejects a backend fallback after otherwise exact drawing")
        val pic = _record_two_rects(24, 16, sk_color_argb(255, 1, 2, 3), sk_color_argb(255, 4, 5, 6))
        val preview = skia_render_picture_on_engine2d_reported(pic, 24, 16, "bridge-unknown-backend")
        expect(preview.pixels.len()).to_equal(24 * 16)
        expect(preview.report.complete).to_equal(false)
        expect(preview.report.reason).to_contain("backend-fallback")
        match skia_render_picture_on_engine2d_strict(pic, 24, 16, "bridge-unknown-backend"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("backend-fallback")

    it "packs A,R,G,B channel bytes into u32 pixels exactly (W3 regression)":
        # @req REQ-SSPEC-LIB
        step("packs A,R,G,B channel bytes into u32 pixels exactly")
        # W3 removed the zero-init + overwrite double pass and hoisted the
        # bounds check out of the per-pixel loop. Packing must be unchanged:
        # pixel i takes raw[4i..4i+3] as A,R,G,B into one u32.
        val info = sk_image_info_n32_premul(2, 2)
        val raw: [i64] = [
            255i64, 10, 20, 30,
            128, 40, 50, 60,
            0, 70, 80, 90,
            200, 100, 110, 120
        ]
        val packed = sk_image_to_u32_pixels(sk_image_make(info, raw))
        expect(packed.len()).to_equal(4)
        expect(packed[0]).to_equal(0xFF0A141Eu32)
        expect(packed[1]).to_equal(0x8028323Cu32)
        expect(packed[2]).to_equal(0x0046505Au32)
        expect(packed[3]).to_equal(0xC8646E78u32)

    it "keeps the short-buffer partial result unchanged (W3 regression)":
        # @req REQ-SSPEC-LIB
        step("keeps the short-buffer partial result unchanged")
        # Degenerate path: raw shorter than w*h*4. Pixels past the buffer
        # must pack as 0, exactly as the old guarded loop produced.
        val info = sk_image_info_n32_premul(2, 2)
        val raw: [i64] = [255i64, 1, 2, 3, 9]
        val packed = sk_image_to_u32_pixels(sk_image_make(info, raw))
        expect(packed.len()).to_equal(4)
        expect(packed[0]).to_equal(0xFF010203u32)
        expect(packed[1]).to_equal(0x00000000u32)
        expect(packed[2]).to_equal(0x00000000u32)
        expect(packed[3]).to_equal(0x00000000u32)
