# @cover src/lib/skia/entity/canvas.spl 80%
"""
# Skia Canvas Specification

**Feature IDs:** #SKI-006
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Tests for SkCanvas save/restore state, dimensions, and basic predicates.
Note: draw calls currently return unchanged SkCanvas values, so we only test
the state-management, recording, matrix, and non-drawing methods.
"""

use std.skia.entity.canvas.{SkCanvas, SkCanvasSaveLayerRec, sk_canvas_make, sk_save_layer_rec}
use std.skia.entity.geometry.{SkIRect, SkRect, sk_rect_make_wh, sk_rrect_make}
use std.skia.entity.matrix.{Matrix3x3}
use std.skia.entity.paint.{sk_paint_new, sk_paint_fill}
use std.skia.entity.picture.{SkPictureOpKind}
use std.skia.entity.color.{sk_color_argb}
use std.skia.entity.enums.{SkBlendMode}
use std.skia.entity.font.{sk_font_default}
use std.skia.entity.textblob.{sk_text_blob_make_from_text}
use std.spec.step

describe "SkCanvas construction":
    it "sk_canvas_make sets width and height":
        val c = sk_canvas_make(800, 600)
        expect(c.width).to_equal(800)
        expect(c.height).to_equal(600)

    it "initial save count is 1":
        val c = sk_canvas_make(100, 100)
        expect(c.get_save_count()).to_equal(1)

    it "image_info_width matches construction":
        val c = sk_canvas_make(1920, 1080)
        expect(c.image_info_width()).to_equal(1920)

    it "image_info_height matches construction":
        val c = sk_canvas_make(1920, 1080)
        expect(c.image_info_height()).to_equal(1080)

describe "SkCanvas save/restore":
    it "save increments count":
        val c = sk_canvas_make(100, 100)
        val c2 = c.save()
        expect(c2.get_save_count()).to_equal(2)

    it "save twice increments to 3":
        val c = sk_canvas_make(100, 100)
        val c3 = c.save().save()
        expect(c3.get_save_count()).to_equal(3)

    it "restore decrements count":
        val c = sk_canvas_make(100, 100)
        val c2 = c.save()
        val c3 = c2.restore()
        expect(c3.get_save_count()).to_equal(1)

    it "restore at 1 stays at 1":
        val c = sk_canvas_make(100, 100)
        val c2 = c.restore()
        expect(c2.get_save_count()).to_equal(1)

    it "save_layer increments count":
        val c = sk_canvas_make(100, 100)
        val rec = sk_save_layer_rec(nil, nil)
        val c2 = c.save_layer(rec)
        expect(c2.get_save_count()).to_equal(2)

    it "restore_to_count sets exact count":
        val c = sk_canvas_make(100, 100)
        val c2 = c.save().save().save()
        val c3 = c2.restore_to_count(2)
        expect(c3.get_save_count()).to_equal(2)

    it "restore_to_count clamped at 1":
        val c = sk_canvas_make(100, 100)
        val c2 = c.restore_to_count(0)
        expect(c2.get_save_count()).to_equal(1)

describe "SkCanvas clip bounds":
    it "get_device_clip_bounds returns full canvas":
        val c = sk_canvas_make(640, 480)
        val bounds = c.get_device_clip_bounds()
        expect(bounds.right).to_equal(640)
        expect(bounds.bottom).to_equal(480)
        expect(bounds.left).to_equal(0)
        expect(bounds.top).to_equal(0)

describe "SkCanvasSaveLayerRec":
    it "constructs with nil bounds and nil paint":
        val rec = sk_save_layer_rec(nil, nil)
        expect(rec.bounds).to_equal(nil)
        expect(rec.paint).to_equal(nil)

describe "SkCanvas recording":
    it "begin_recording preserves canvas dimensions and save count":
        val bounds = SkRect(left: 0.0, top: 0.0, right: 100.0, bottom: 100.0)
        val c0 = sk_canvas_make(100, 100)
        val c1 = c0.begin_recording(bounds)
        expect(c1.width).to_equal(100)
        expect(c1.height).to_equal(100)
        expect(c1.get_save_count()).to_equal(1)

    it "draw_rect during recording produces one DrawRect op in the SkPicture":
        # @req: REQ-LIB-SKIA_CANVAS-001
        step("Verify: draw_rect during recording produces one DrawRect op in the SkPicture")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 100.0, bottom: 100.0)
        val c0 = sk_canvas_make(100, 100)
        val c1 = c0.begin_recording(bounds)
        val paint = sk_paint_new()
        val rect = SkRect(left: 10.0, top: 10.0, right: 50.0, bottom: 50.0)
        val c2 = c1.draw_rect(rect, paint)
        val picture = c2.end_recording()
        expect(picture.op_count).to_equal(1)  # oracle: expected value pinned by spec
        expect(picture.ops[0].kind).to_equal(SkPictureOpKind.DrawRect)  # oracle: expected value pinned by spec

describe "SkCanvas matrix ops":
    it "translate matrix exposes tx and ty for canvas transforms":
        val m = Matrix3x3.translate(3.0, 4.0)
        expect(m.tx()).to_equal(3.0)
        expect(m.ty()).to_equal(4.0)
        expect(m.scale_x()).to_equal(1.0)
        expect(m.scale_y()).to_equal(1.0)

    it "set_matrix input preserves translation components":
        val m = Matrix3x3.translate(11.0, 13.0)
        expect(m.tx()).to_equal(11.0)
        expect(m.ty()).to_equal(13.0)
        expect(m.scale_x()).to_equal(1.0)
        expect(m.scale_y()).to_equal(1.0)

    it "local_to_device returns identity matrix":
        val c = sk_canvas_make(100, 100)
        val m = c.local_to_device()
        expect(m.tx()).to_equal(0.0)
        expect(m.ty()).to_equal(0.0)
        expect(m.scale_x()).to_equal(1.0)
        expect(m.scale_y()).to_equal(1.0)

    it "concat without recorder does not crash":
        # @req: REQ-LIB-SKIA_CANVAS-001
        step("Verify: concat without recorder does not crash")
        val c = sk_canvas_make(100, 100)
        val m = Matrix3x3.translate(1.0, 2.0)
        val c2 = c.concat(m)
        expect(c2.width).to_equal(100)  # oracle: expected value pinned by spec

    it "set_matrix with recorder appends a SetMatrix op with correct tx/ty":
        # @req: REQ-LIB-SKIA_CANVAS-001
        step("Verify: set_matrix with recorder appends a SetMatrix op with correct tx/ty")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 100.0, bottom: 100.0)
        val c0 = sk_canvas_make(100, 100)
        val c1 = c0.begin_recording(bounds)
        val m = Matrix3x3.translate(11.0, 13.0)
        val c2 = c1.set_matrix(m)
        val picture = c2.end_recording()
        expect(picture.op_count).to_equal(1)  # oracle: expected value pinned by spec
        expect(picture.ops[0].kind).to_equal(SkPictureOpKind.SetMatrix)  # oracle: expected value pinned by spec
        expect(picture.ops[0].rect.left).to_equal(11.0)  # oracle: expected value pinned by spec
        expect(picture.ops[0].rect.top).to_equal(13.0)  # oracle: expected value pinned by spec

    it "concat with recorder appends a SetMatrix op":
        # @req: REQ-LIB-SKIA_CANVAS-001
        step("Verify: concat with recorder appends a SetMatrix op")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 100.0, bottom: 100.0)
        val c0 = sk_canvas_make(100, 100)
        val c1 = c0.begin_recording(bounds)
        val m = Matrix3x3.translate(3.0, 4.0)
        val c2 = c1.concat(m)
        val picture = c2.end_recording()
        expect(picture.op_count).to_equal(1)  # oracle: expected value pinned by spec
        expect(picture.ops[0].kind).to_equal(SkPictureOpKind.SetMatrix)  # oracle: expected value pinned by spec

describe "SkCanvas CTM, shapes, text, and color ops":
    it "accumulates translate and scale on CTM and restores on restore()":
        step("Verify: CTM accumulates translate/scale and restores on save/restore")
        val c0 = sk_canvas_make(200, 200)
        val c1 = c0.translate(10.0, 20.0).save().scale(2.0, 3.0)
        val m_scaled = c1.local_to_device()
        expect(m_scaled.tx()).to_equal(10.0)
        expect(m_scaled.ty()).to_equal(20.0)
        expect(m_scaled.scale_x()).to_equal(2.0)
        expect(m_scaled.scale_y()).to_equal(3.0)
        val c2 = c1.restore()
        val m_restored = c2.local_to_device()
        expect(m_restored.tx()).to_equal(10.0)
        expect(m_restored.ty()).to_equal(20.0)
        expect(m_restored.scale_x()).to_equal(1.0)
        expect(m_restored.scale_y()).to_equal(1.0)

    it "draw_circle records DrawOval with exact center +/- radius bounds":
        step("Verify: draw_circle records DrawOval bounds")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 120.0, bottom: 120.0)
        val p = sk_paint_fill(sk_color_argb(255, 0xEE, 0x22, 0x44))
        val pic = sk_canvas_make(120, 120).begin_recording(bounds).draw_circle(50.0, 60.0, 15.0, p).end_recording()
        expect(pic.op_count).to_equal(1)
        expect(pic.ops[0].kind).to_equal(SkPictureOpKind.DrawOval)
        expect(pic.ops[0].rect.left).to_equal(35.0)
        expect(pic.ops[0].rect.top).to_equal(45.0)
        expect(pic.ops[0].rect.right).to_equal(65.0)
        expect(pic.ops[0].rect.bottom).to_equal(75.0)

    it "draw_rrect preserves corner radii in DrawRRect op":
        step("Verify: draw_rrect records DrawRRect with rx/ry")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 120.0, bottom: 120.0)
        val rr = sk_rrect_make(SkRect(left: 10.0, top: 12.0, right: 90.0, bottom: 72.0), 8.0, 6.0)
        val p = sk_paint_fill(sk_color_argb(255, 0x22, 0x88, 0xEE))
        val pic = sk_canvas_make(120, 120).begin_recording(bounds).draw_rrect(rr, p).end_recording()
        expect(pic.op_count).to_equal(1)
        expect(pic.ops[0].kind).to_equal(SkPictureOpKind.DrawRRect)
        expect(pic.ops[0].rx).to_equal(8.0)
        expect(pic.ops[0].ry).to_equal(6.0)

    it "draw_text_blob and draw_string record DrawTextBlob ops with positioned bounds":
        step("Verify: draw_text_blob and draw_string record DrawTextBlob ops")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 200.0, bottom: 100.0)
        val font = sk_font_default()
        val blob = sk_text_blob_make_from_text("Hi!", font)
        val p = sk_paint_fill(sk_color_argb(255, 0x11, 0x11, 0x11))
        val pic = sk_canvas_make(200, 100)
            .begin_recording(bounds)
            .draw_text_blob(blob, 15.0, 40.0, p)
            .draw_string("Skia", 25.0, 80.0, font, p)
            .end_recording()
        expect(pic.op_count).to_equal(2)
        expect(pic.ops[0].kind).to_equal(SkPictureOpKind.DrawTextBlob)
        expect(pic.ops[0].rx).to_equal(3.0)
        expect(pic.ops[0].x).to_equal(15.0)
        expect(pic.ops[0].y).to_equal(40.0)
        expect(pic.ops[1].kind).to_equal(SkPictureOpKind.DrawTextBlob)
        expect(pic.ops[1].rx).to_equal(4.0)
        expect(pic.ops[1].x).to_equal(25.0)
        expect(pic.ops[1].y).to_equal(80.0)

    it "clear and draw_color preserve color and blend_mode in full-canvas DrawRect ops":
        step("Verify: clear and draw_color preserve paint color and blend_mode")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 64.0, bottom: 64.0)
        val c1 = sk_color_argb(255, 0x10, 0x20, 0x30)
        val c2 = sk_color_argb(128, 0x40, 0x50, 0x60)
        val pic = sk_canvas_make(64, 64)
            .begin_recording(bounds)
            .clear(c1)
            .draw_color(c2, SkBlendMode.SrcOver)
            .end_recording()
        expect(pic.op_count).to_equal(2)
        expect(pic.ops[0].kind).to_equal(SkPictureOpKind.DrawRect)
        expect(pic.ops[0].paint.color).to_equal(c1)
        expect(pic.ops[0].paint.blend_mode).to_equal(SkBlendMode.Src)
        expect(pic.ops[1].kind).to_equal(SkPictureOpKind.DrawRect)
        expect(pic.ops[1].paint.color).to_equal(c2)
        expect(pic.ops[1].paint.blend_mode).to_equal(SkBlendMode.SrcOver)
